{"task_id": "Mbpp/92", "solution": "def is_undulating(number: int) -> bool:\n    \"\"\"\n    Checks if the given number is undulating.\n    An undulating number is a number where its digits strictly alternate between two distinct digits.\n    \"\"\"\n    if number < 0:\n        number = abs(number) # Handle negative numbers by checking their absolute value\n\n    s_number = str(number)\n    n = len(s_number)\n\n    if n < 2:\n        return False # A number with fewer than two digits cannot be undulating\n\n    digit1 = s_number[0]\n    digit2 = None\n\n    for i in range(1, n):\n        if s_number[i] != digit1:\n            digit2 = s_number[i]\n            break\n\n    if digit2 is None: # All digits are the same (e.g., 111, 222) or n=1\n        return False\n\n    for i in range(n):\n        if i % 2 == 0:\n            if s_number[i] != digit1:\n                return False\n        else:\n            if s_number[i] != digit2:\n                return False\n    return True"}
{"task_id": "Mbpp/95", "solution": "def Find_Min_Length(list_of_lists: list) -> int:\n    \"\"\"Calculates the length of the smallest list within a list of lists.\n    Assumes the input is a non-empty list of lists.\"\"\"\n    min_length = float('inf')\n    for inner_list in list_of_lists:\n        current_length = len(inner_list)\n        if current_length < min_length:\n            min_length = current_length\n    return min_length"}
{"task_id": "Mbpp/92", "solution": "def is_undulating(number: int) -> bool:\n    \"\"\"\n    Checks if a given integer is \"undulating\", meaning its digits alternate between two distinct values.\n    Returns False for negative numbers, single/two-digit numbers, or if alternating digits are not distinct.\n    \"\"\"\n    if number < 0:\n        return False\n\n    s_num = str(number)\n    n = len(s_num)\n\n    if n < 3:\n        return False\n\n    char1 = s_num[0]\n    char2 = s_num[1]\n\n    if char1 == char2:\n        return False\n\n    for i in range(2, n):\n        if i % 2 == 0:  # Even index should match char1\n            if s_num[i] != char1:\n                return False\n        else:  # Odd index should match char2\n            if s_num[i] != char2:\n                return False\n\n    return True"}
{"task_id": "Mbpp/94", "solution": "def index_minimum(data: list[tuple]) -> any:\n    \"\"\"\n    Identifies the tuple with the smallest second value and returns its first element.\n    Tie-breaking selects the first encountered tuple with the minimum second value.\n    \"\"\"\n    min_tuple = data[0]\n\n    for current_tuple in data[1:]:\n        if current_tuple[1] < min_tuple[1]:\n            min_tuple = current_tuple\n\n    return min_tuple[0]"}
{"task_id": "Mbpp/94", "solution": "def index_minimum(list_of_tuples):\n    \"\"\"\n    Finds the first value of the tuple with the smallest second value in a list of tuples.\n    Returns None if the input list is empty.\n    \"\"\"\n    if not list_of_tuples:\n        return None\n\n    # Initialize with the first tuple's values\n    current_min_value = list_of_tuples[0][1]\n    result_tuple_first_value = list_of_tuples[0][0]\n\n    # Iterate through the rest of the tuples to find the minimum\n    for item in list_of_tuples[1:]:\n        if item[1] < current_min_value:\n            current_min_value = item[1]\n            result_tuple_first_value = item[0]\n\n    return result_tuple_first_value"}
{"task_id": "Mbpp/95", "solution": "def Find_Min_Length(list_of_lists: list[list]) -> int:\n    \"\"\"\n    Finds the length of the smallest sub-list in a list of lists.\n    Returns 0 if the input list is empty or contains an empty sub-list.\n    \"\"\"\n    min_length = float('inf')\n\n    for sublist in list_of_lists:\n        min_length = min(min_length, len(sublist))\n\n    return int(min_length) if min_length != float('inf') else 0"}
{"task_id": "Mbpp/96", "solution": "def divisor(n: int) -> int:\n    \"\"\"Calculates the number of positive divisors for a given integer.\n    Handles negative inputs by using their absolute value and returns 0 for an input of 0.\"\"\"\n    if n == 0:\n        return 0\n    if n < 0:\n        n = abs(n)\n\n    count = 0\n    i = 1\n    while i * i <= n:\n        if n % i == 0:\n            if i * i == n:\n                count += 1\n            else:\n                count += 2\n        i += 1\n    return count"}
{"task_id": "Mbpp/96", "solution": "def divisor(n: int) -> int:\n    \"\"\"Calculates the total count of positive divisors for a given positive integer n.\n    It efficiently counts divisors by iterating up to the square root of n.\n    \"\"\"\n    count = 0\n    # Iterate up to the square root of n\n    # Divisors come in pairs (d, n/d).\n    for i in range(1, int(n**0.5) + 1):\n        if n % i == 0:\n            if i * i == n:\n                count += 1\n            else:\n                count += 2\n    return count"}
{"task_id": "Mbpp/97", "solution": "def frequency_lists(input_list_of_lists: list[list[any]]) -> dict[any, int]:\n    \"\"\"Flattens a list of lists and calculates the frequency of each element.\n    Returns a dictionary with elements as keys and their counts as values.\"\"\"\n\n    flattened_list = []\n    for sublist in input_list_of_lists:\n        for item in sublist:\n            flattened_list.append(item)\n\n    frequencies = {}\n    for item in flattened_list:\n        frequencies[item] = frequencies.get(item, 0) + 1\n\n    return frequencies"}
{"task_id": "Mbpp/97", "solution": "from typing import Any\nimport collections\nimport itertools\ndef frequency_lists(list_of_lists: list[list[Any]]) -> dict[Any, int]:\n    \"\"\"\n    Flattens a list of lists and calculates the frequency of each element.\n    Returns a dictionary with elements as keys and their frequencies as values.\n    \"\"\"\n    flattened_list = list(itertools.chain.from_iterable(list_of_lists))\n    frequency_map = collections.Counter(flattened_list)\n    return dict(frequency_map)"}
{"task_id": "Mbpp/99", "solution": "def decimal_to_binary(decimal_number: int) -> str:\n    \"\"\"\n    Converts a non-negative decimal integer to its binary string representation.\n    Ensures no leading zeros, with \"0\" for input 0.\n    \"\"\"\n    if decimal_number == 0:\n        return \"0\"\n\n    binary_string = \"\"\n    while decimal_number > 0:\n        remainder = decimal_number % 2\n        binary_string = str(remainder) + binary_string\n        decimal_number //= 2\n\n    return binary_string"}
{"task_id": "Mbpp/98", "solution": "def multiply_num(numbers):\n    \"\"\"\n    Calculates the product of all numbers in a list and divides it by the count of numbers.\n    Returns 0.0 if the input list is empty to prevent division by zero.\n    \"\"\"\n    count = len(numbers)\n    if count == 0:\n        return 0.0\n\n    product = 1\n    for num in numbers:\n        product *= num\n\n    return product / count"}
{"task_id": "Mbpp/98", "solution": "from typing import Union, List, Tuple\ndef multiply_num(numbers: Union[List[Union[int, float]], Tuple[Union[int, float], ...]]) -> float:\n    \"\"\"Calculates the product of numbers in a list/tuple and divides by its length, handling empty inputs.\n    Returns 0.0 if the input collection is empty, otherwise returns the product divided by length as a float.\n    \"\"\"\n    length = len(numbers)\n\n    if length == 0:\n        return 0.0\n\n    product = 1.0\n    for num in numbers:\n        product *= num\n\n    return product / length"}
