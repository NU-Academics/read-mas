{"task_id": "Mbpp/68", "solution": "def is_Monotonic(array: list) -> bool:\n    \"\"\"\n    Checks if an array is monotonic (either increasing or decreasing).\n    Empty or single-element arrays are considered monotonic.\n    \"\"\"\n    if len(array) <= 1:\n        return True\n\n    is_increasing = True\n    is_decreasing = True\n\n    for i in range(1, len(array)):\n        if array[i] < array[i - 1]:\n            is_increasing = False\n        if array[i] > array[i - 1]:\n            is_decreasing = False\n\n        if not is_increasing and not is_decreasing:\n            return False\n\n    return is_increasing or is_decreasing"}
{"task_id": "Mbpp/69", "solution": "def contains_sublist(main_list: list, sublist: list) -> bool:\n    \"\"\"\n    Checks if a given sublist is present within a main list.\n    An empty sublist is considered a sublist of any list.\n    \"\"\"\n    if not sublist:\n        return True\n\n    n = len(main_list)\n    m = len(sublist)\n\n    for i in range(n - m + 1):\n        if main_list[i:i + m] == sublist:\n            return True\n\n    return False"}
{"task_id": "Mbpp/69", "solution": "def is_sublist(main_list: list, potential_sublist: list) -> bool:\n    \"\"\"Checks if a potential_sublist exists contiguously within main_list.\n    Returns True if found, False otherwise.\"\"\"\n    len_main = len(main_list)\n    len_sub = len(potential_sublist)\n\n    if len_sub == 0:\n        return True\n    if len_sub > len_main:\n        return False\n\n    for i in range(len_main - len_sub + 1):\n        if main_list[i : i + len_sub] == potential_sublist:\n            return True\n\n    return False"}
{"task_id": "Mbpp/70", "solution": "def get_equal(list_of_tuples: list) -> bool:\n    \"\"\"\n    Checks if all tuples in the given list have the same length.\n    Returns True for empty lists or lists with a single tuple.\n    \"\"\"\n    if len(list_of_tuples) <= 1:\n        return True\n\n    reference_length = len(list_of_tuples[0])\n\n    for i in range(1, len(list_of_tuples)):\n        current_tuple = list_of_tuples[i]\n        if len(current_tuple) != reference_length:\n            return False\n\n    return True"}
{"task_id": "Mbpp/68", "solution": "def is_Monotonic(array: list) -> bool:\n    \"\"\"\n    Checks if the given array is monotonic (either non-decreasing or non-increasing).\n    Empty or single-element arrays are considered monotonic.\n    \"\"\"\n    # Handles empty or single-element arrays as monotonic.\n    if len(array) <= 1:\n        return True\n\n    is_increasing = True\n    is_decreasing = True\n\n    # Iterate to check both conditions.\n    for i in range(1, len(array)):\n        if array[i] < array[i-1]:\n            is_increasing = False\n        if array[i] > array[i-1]:\n            is_decreasing = False\n\n    # Return True if either condition is met.\n    return is_increasing or is_decreasing"}
{"task_id": "Mbpp/67", "solution": "def _stirling_second_kind(n: int, k: int) -> int:\n    if k < 0 or k > n:\n        return 0\n    if k == 0 and n == 0:\n        return 1\n    if k == 0:\n        return 0\n    if k == n:\n        return 1\n    if k == 1:\n        return 1\n\n    dp = [[0 for _ in range(k + 1)] for _ in range(n + 1)]\n\n    dp[0][0] = 1\n    for i in range(1, n + 1):\n        dp[i][0] = 0\n        dp[i][1] = 1\n        if i <= k:\n            dp[i][i] = 1\n\n    for i in range(2, n + 1):\n        for j in range(2, min(i + 1, k + 1)):\n            dp[i][j] = dp[i-1][j-1] + j * dp[i-1][j]\n\n    return dp[n][k]\ndef bell_number(n: int) -> int:\n    if n < 0:\n        return 0\n\n    if n == 0:\n        return 1\n    if n == 1:\n        return 1\n    if n == 2:\n        return 2\n\n    bell_n = 0\n    for k in range(n + 1):\n        bell_n += _stirling_second_kind(n, k)\n\n    return bell_n"}
{"task_id": "Mbpp/71", "solution": "def comb_sort(list_of_elements):\n    \"\"\"Sorts a list of elements in-place using the comb sort algorithm.\"\"\"\n    n = len(list_of_elements)\n    gap = n\n    swapped = True\n    shrink_factor = 1.3\n\n    while gap > 1 or swapped:\n        gap = int(gap / shrink_factor)\n        if gap < 1:\n            gap = 1\n\n        swapped = False\n        for i in range(n - gap):\n            if list_of_elements[i] > list_of_elements[i + gap]:\n                list_of_elements[i], list_of_elements[i + gap] = list_of_elements[i + gap], list_of_elements[i]\n                swapped = True"}
{"task_id": "Mbpp/71", "solution": "def comb_sort(list_to_sort):\n    \"\"\"Sorts a list in ascending order using the comb sort algorithm.\"\"\"\n    arr = list_to_sort[:]  # Create a copy of the input list.\n    n = len(arr)\n\n    gap = n\n    shrink_factor = 1.3\n    swapped = True\n\n    while gap > 1 or swapped:\n        if gap > 1:\n            gap = int(gap / shrink_factor)\n            if gap < 1:\n                gap = 1\n\n        swapped = False\n        for i in range(n - gap):\n            if arr[i] > arr[i + gap]:\n                arr[i], arr[i + gap] = arr[i + gap], arr[i]\n                swapped = True\n    return arr"}
