{"task_id": "Mbpp/102", "solution": "def snake_to_camel(input_string: str) -> str:\n    \"\"\"\n    Converts a snake_case string to a CamelCase string using internal helper functions.\n    \"\"\"\n\n    def _split_words(s: str) -> list[str]:\n        \"\"\"\n        Splits a string by underscores, filtering out any empty word segments.\n        \"\"\"\n        return [word for word in s.split('_') if word]\n\n    def _capitalize_word(s: str) -> str:\n        \"\"\"\n        Capitalizes the first letter of a word, returning an empty string if input is empty.\n        \"\"\"\n        if not s:\n            return \"\"\n        return s[0].upper() + s[1:]\n\n    words = _split_words(input_string)\n    camel_words = [_capitalize_word(word) for word in words]\n    return \"\".join(camel_words)"}
{"task_id": "Mbpp/102", "solution": "def snake_to_camel(input_string: str) -> str:\n    \"\"\"Converts a snake_case string to CamelCase.\n    It splits the string by underscores, capitalizes each word, and joins them.\"\"\"\n    words = input_string.split('_')\n    camel_case_words = [word.capitalize() for word in words]\n    return ''.join(camel_case_words)"}
{"task_id": "Mbpp/100", "solution": "def next_smallest_palindrome(input_integer: int) -> int:\n    \"\"\"Calculates the next smallest palindrome strictly greater than the input integer.\n    Handles all-nines inputs and general cases by mirroring and incrementing.\n    \"\"\"\n    s = str(input_integer)\n    n = len(s)\n\n    # Check if the input consists of all 9s (e.g., 9, 99, 999).\n    # For these, the next palindrome is '1' followed by (n-1) zeros and a '1'.\n    all_nines = True\n    for char in s:\n        if char != '9':\n            all_nines = False\n            break\n\n    if all_nines:\n        return int('1' + '0' * (n - 1) + '1')\n\n    # General case: construct a palindrome from the left half of the number.\n    # `half_len` is the length of the left part without the middle digit.\n    half_len = n // 2\n    left = s[0:half_len]\n\n    # `middle` is the single middle digit if `n` is odd, otherwise an empty string.\n    middle = s[half_len] if (n % 2 == 1) else ''\n\n    # Form an initial palindrome candidate by mirroring the `left` part.\n    candidate_p_str = left + middle + left[::-1]\n\n    # If this candidate is already strictly greater than `input_integer`, it's the answer.\n    if int(candidate_p_str) > input_integer:\n        return int(candidate_p_str)\n\n    # If not, increment the \"left side\" of the number (including middle digit if `n` is odd).\n    segment_to_increment_str = left + middle\n    incremented_segment_str = str(int(segment_to_increment_str) + 1)\n\n    # Reconstruct the final palindrome using the `incremented_segment_str`.\n    # `final_left_part` uses the first `half_len` characters of the incremented segment.\n    final_left_part = incremented_segment_str[0:half_len]\n\n    # `final_middle_char` takes the character at `half_len` if `n` is odd.\n    # This correctly handles cases where `incremented_segment_str` might grow (e.g., \"9\" to \"10\").\n    final_middle_char = incremented_segment_str[half_len] if (n % 2 == 1) else ''\n\n    # Combine the parts to form the final palindrome string.\n    final_p_str = final_left_part + final_middle_char + final_left_part[::-1]\n\n    return int(final_p_str)"}
{"task_id": "Mbpp/101", "solution": "from typing import List, Any\nclass EmptyArrayError(Exception):\n    \"\"\"Custom exception raised when the input array is empty.\"\"\"\n    pass\nclass IndexOutOfBoundsError(Exception):\n    \"\"\"Custom exception raised when the index k is out of bounds for the array.\"\"\"\n    pass\ndef kth_element(array: List[Any], k: int) -> Any:\n    \"\"\"\n    Finds and returns the k-th element (1-based index) from a given array.\n    Raises custom exceptions for empty arrays or out-of-bounds k values.\n    \"\"\"\n    if not array:\n        raise EmptyArrayError(\"Input array cannot be empty.\")\n\n    if not (1 <= k <= len(array)):\n        raise IndexOutOfBoundsError(f\"Index k={k} is out of bounds for array of length {len(array)}. k must be between 1 and {len(array)} (inclusive).\")\n\n    return array[k - 1]"}
{"task_id": "Mbpp/100", "solution": "def is_palindrome(n: int) -> bool:\n    \"\"\"Checks if an integer is a palindrome.\n    Returns True if `n` reads the same forwards and backward.\n    \"\"\"\n    if n < 0:\n        return False  # Negative numbers are not considered palindromes.\n    s = str(n)\n    return s == s[::-1]\ndef next_smallest_palindrome(n: int) -> int:\n    \"\"\"Calculates the next smallest palindrome strictly greater than `n`.\n    Returns this palindrome as an integer.\n    \"\"\"\n    current_number = n + 1\n    while True:\n        if is_palindrome(current_number):\n            return current_number\n        current_number += 1"}
{"task_id": "Mbpp/103", "solution": "def eulerian_num(n: int, m: int) -> int:\n    \"\"\"Calculates the Eulerian number a(n, m).\n    It represents the number of permutations of {1, ..., n} with exactly m ascents.\n    \"\"\"\n\n    def combinations(N, K):\n        \"\"\"Calculates binomial coefficient N choose K, C(N, K).\"\"\"\n        if K < 0 or K > N:\n            return 0\n        if K == 0 or K == N:\n            return 1\n        # Optimization: C(N, K) = C(N, N-K)\n        if K > N // 2:\n            K = N - K\n\n        res = 1\n        for i in range(K):\n            res = res * (N - i) // (i + 1)\n        return res\n\n    # Eulerian numbers a(n, m) are non-zero only for 0 <= m < n.\n    # For m outside this range, the value is 0 by definition.\n    if m < 0 or m >= n:\n        return 0\n\n    # Formula for Eulerian number a(n, m):\n    # a(n, m) = sum_{k=0 to m} (-1)^k * C(n+1, k) * (m - k + 1)^n\n    result = 0\n    for k in range(m + 1):\n        term = ((-1)**k) * combinations(n + 1, k) * ((m - k + 1)**n)\n        result += term\n\n    return result"}
