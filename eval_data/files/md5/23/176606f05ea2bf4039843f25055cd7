{"task_id": "Mbpp/440", "solution": "import re\nimport string\nclass PunctuationUtil:\n    \"\"\"Utility to handle punctuation, specifically stripping trailing punctuation.\"\"\"\n    def strip_trailing_punctuation(self, text: str) -> str:\n        \"\"\"Removes trailing punctuation from a given string.\"\"\"\n        while text and text[-1] in string.punctuation:\n            text = text[:-1]\n        return text\nclass InternalAdverbLexicon:\n    \"\"\"Internal utility to determine if a word is an adverb.\"\"\"\n    def __init__(self):\n        # A simple, hardcoded lexicon of common adverbs (case-insensitive check will be applied).\n        self._adverbs = {\n            \"clearly\", \"quickly\", \"slowly\", \"rapidly\", \"gently\", \"loudly\", \"softly\",\n            \"easily\", \"happily\", \"sadly\", \"really\", \"very\", \"always\", \"never\",\n            \"often\", \"sometimes\", \"seldom\", \"early\", \"late\", \"soon\", \"now\",\n            \"then\", \"here\", \"there\", \"everywhere\", \"anywhere\", \"nowhere\",\n            \"today\", \"tomorrow\", \"yesterday\", \"daily\", \"weekly\", \"monthly\",\n            \"annually\", \"well\", \"badly\", \"hard\", \"fast\", \"almost\", \"just\",\n            \"quite\", \"rather\", \"too\", \"enough\", \"indeed\", \"hence\", \"thus\",\n            \"consequently\", \"therefore\", \"finally\", \"first\", \"second\", \"third\",\n            \"forth\", \"further\", \"furthermore\", \"moreover\", \"otherwise\", \"instead\",\n            \"also\", \"too\", \"however\", \"nevertheless\", \"meanwhile\", \"next\",\n            \"below\", \"above\", \"behind\", \"ahead\", \"inside\", \"outside\", \"upstairs\",\n            \"downstairs\", \"homeward\", \"outward\", \"inward\", \"backward\", \"forward\",\n            \"away\", \"around\", \"about\", \"alone\", \"together\", \"apart\", \"alike\",\n            \"aside\", \"already\", \"still\", \"yet\", \"even\", \"only\", \"exactly\",\n            \"merely\", \"practically\", \"virtually\", \"approximately\", \"nearly\",\n            \"scarcely\", \"hardly\", \"barely\", \"somewhat\", \"rather\", \"pretty\",\n            \"quite\", \"actually\", \"evidently\", \"obviously\", \"apparently\",\n            \"certainly\", \"definitely\", \"probably\", \"possibly\", \"perhaps\",\n            \"maybe\", \"truly\", \"sincerely\", \"frankly\", \"honestly\"\n        }\n\n    def is_adverb(self, word: str) -> bool:\n        \"\"\"Checks if the given word (case-insensitively) is in the internal adverb lexicon.\"\"\"\n        return word.lower() in self._adverbs\ndef find_adverb_position(sentence: str) -> tuple:\n    \"\"\"\n    Identifies the first adverb in a sentence and returns its position and the adverb string.\n    Returns (-1, -1, '') if no adverb is found.\n    \"\"\"\n    adverb_finder_instance = InternalAdverbLexicon()\n    punctuation_util_instance = PunctuationUtil()\n\n    found_start_index = -1\n    found_end_index = -1\n    found_adverb_string = ''\n\n    # Use regex to find all word-like sequences (non-whitespace) along with their spans.\n    # This preserves original indices and allows for punctuation handling.\n    for match in re.finditer(r'\\S+', sentence):\n        original_word = match.group(0)\n        word_start_original_idx = match.start()\n\n        cleaned_word = punctuation_util_instance.strip_trailing_punctuation(original_word)\n\n        if adverb_finder_instance.is_adverb(cleaned_word):\n            found_start_index = word_start_original_idx\n            # The end index is the start index plus the length of the cleaned adverb.\n            found_end_index = word_start_original_idx + len(cleaned_word)\n            found_adverb_string = cleaned_word\n            break # Stop after finding the first adverb.\n\n    return (found_start_index, found_end_index, found_adverb_string)"}
{"task_id": "Mbpp/440", "solution": "_PUNCTUATION = set('!\"#$%&\\'()*+,-./:;<=>?@[\\\\]^_`{|}~')\ndef _strip_trailing_punctuation(text: str) -> str:\n    \"\"\"Removes trailing punctuation from a string.\"\"\"\n    while text and text[-1] in _PUNCTUATION:\n        text = text[:-1]\n    return text\ndef _is_adverb(word: str) -> bool:\n    \"\"\"Determines if a given word is an adverb using simple heuristics.\"\"\"\n    word_lower = word.lower()\n    if word_lower.endswith(\"ly\"):\n        return True\n\n    # A small dictionary of common adverbs that do not end in -ly.\n    common_adverbs = {\"very\", \"often\", \"always\", \"never\", \"here\", \"there\", \"now\", \"then\", \"fast\", \"well\", \"soon\", \"late\", \"early\", \"today\", \"tomorrow\", \"yesterday\", \"daily\", \"quickly\", \"slowly\", \"hard\", \"far\", \"back\", \"away\"}\n    return word_lower in common_adverbs\ndef find_adverb_position(sentence_string: str):\n    \"\"\"\n    Finds the first adverb and its positions in a given sentence.\n    Returns (start_index, end_index, cleaned_adverb_string) or None if not found.\n    \"\"\"\n    words_with_indices = []\n    current_word_start = -1\n\n    for i, char in enumerate(sentence_string):\n        if char.isspace():\n            if current_word_start != -1:\n                word_text = sentence_string[current_word_start:i]\n                words_with_indices.append((word_text, current_word_start, i))\n                current_word_start = -1\n        else:\n            if current_word_start == -1:\n                current_word_start = i\n\n    if current_word_start != -1:\n        word_text = sentence_string[current_word_start:]\n        words_with_indices.append((word_text, current_word_start, len(sentence_string)))\n\n    for word_text, start_idx, _ in words_with_indices:\n        cleaned_word = _strip_trailing_punctuation(word_text)\n        if _is_adverb(cleaned_word):\n            # The end_index for the output tuple refers to the end of the cleaned adverb.\n            return (start_idx, start_idx + len(cleaned_word), cleaned_word)\n\n    return None"}
{"task_id": "Mbpp/445", "solution": "def index_multiplication(tuple1, tuple2):\n    \"\"\"\n    Performs element-wise multiplication on two input tuples of tuples.\n    Each inner tuple contains two numbers, and the function returns a new tuple of tuples\n    with the products of corresponding elements.\n    \"\"\"\n    result_inner_tuples = []\n    for inner_tuple_a, inner_tuple_b in zip(tuple1, tuple2):\n        product_first_elements = inner_tuple_a[0] * inner_tuple_b[0]\n        product_second_elements = inner_tuple_a[1] * inner_tuple_b[1]\n        result_inner_tuples.append((product_first_elements, product_second_elements))\n    return tuple(result_inner_tuples)"}
