{"task_id": "Mbpp/555", "solution": "def difference(n: int) -> int:\n    \"\"\"\n    Calculates the difference between the sum of cubes of the first 'n' natural numbers\n    and the sum of the first 'n' natural numbers using nested helper functions.\n    \"\"\"\n\n    def _calculate_sum_of_n_internal(num: int) -> int:\n        \"\"\"Calculates the sum of the first 'num' natural numbers.\"\"\"\n        return num * (num + 1) // 2\n\n    def _calculate_sum_of_cubes_of_n_internal(num: int) -> int:\n        \"\"\"Calculates the sum of the cubes of the first 'num' natural numbers.\"\"\"\n        sum_val = _calculate_sum_of_n_internal(num)\n        return sum_val ** 2\n\n    sum_n = _calculate_sum_of_n_internal(n)\n    sum_cubes_n = _calculate_sum_of_cubes_of_n_internal(n)\n    return sum_cubes_n - sum_n"}
{"task_id": "Mbpp/556", "solution": "def find_Odd_Pair(arr: list[int], n: int) -> int:\n    \"\"\"\n    Counts pairs in arr whose bitwise XOR results in an odd value.\n    An odd XOR result requires one odd and one even number.\n    \"\"\"\n    odd_count = 0\n    even_count = 0\n\n    for number in arr:\n        if number % 2 != 0:  # Check if the number is odd\n            odd_count += 1\n        else:  # The number is even\n            even_count += 1\n\n    # The number of pairs with an odd XOR sum is odd_count * even_count\n    return odd_count * even_count"}
{"task_id": "Mbpp/557", "solution": "def toggle_string(input_string: str) -> str:\n    \"\"\"Toggles the case of all alphabetic characters in an input string.\n    Uppercase characters are converted to lowercase, and lowercase to uppercase, while non-alphabetic characters remain unchanged.\"\"\"\n\n    toggled_chars = []\n    for char in input_string:\n        if 'a' <= char <= 'z':  # Check for lowercase alphabetic\n            toggled_chars.append(chr(ord(char) - 32)) # Convert to uppercase\n        elif 'A' <= char <= 'Z': # Check for uppercase alphabetic\n            toggled_chars.append(chr(ord(char) + 32)) # Convert to lowercase\n        else: # Non-alphabetic character\n            toggled_chars.append(char)\n\n    return \"\".join(toggled_chars)"}
{"task_id": "Mbpp/556", "solution": "def find_Odd_Pair(list_of_integers: list[int], length: int) -> int:\n    \"\"\"\n    Counts pairs of integers in a list whose bitwise XOR value is odd.\n    It iterates through all unique pairs and increments a counter for odd XOR results.\n    \"\"\"\n    odd_xor_pairs_count = 0\n\n    for i in range(length):\n        for j in range(i + 1, length):\n            num1 = list_of_integers[i]\n            num2 = list_of_integers[j]\n            xor_result = num1 ^ num2\n\n            # Check if the XOR result is odd using bitwise AND\n            if xor_result & 1:\n                odd_xor_pairs_count += 1\n\n    return odd_xor_pairs_count"}
{"task_id": "Mbpp/557", "solution": "def toggle_string(input_string: str) -> str:\n    \"\"\"\n    Toggles the case of alphabetic characters in a string, preserving non-alphabetic characters.\n    It returns a new string with the cases flipped.\n    \"\"\"\n    toggled_chars = []\n    for char in input_string:\n        if char.isalpha():\n            if char.islower():\n                toggled_chars.append(char.upper())\n            else:  # char is uppercase\n                toggled_chars.append(char.lower())\n        else:\n            toggled_chars.append(char)\n    return \"\".join(toggled_chars)"}
{"task_id": "Mbpp/558", "solution": "def digit_distance_nums(num1: int, num2: int) -> int:\n    \"\"\"\n    Calculates the sum of per-digit differences between two integers, padding the shorter number with leading zeros.\n    The function converts numbers to strings, pads them to equal length, and sums absolute digit differences.\n    \"\"\"\n    str_num1 = str(num1)\n    str_num2 = str(num2)\n\n    max_len = max(len(str_num1), len(str_num2))\n\n    padded_str_num1 = str_num1.zfill(max_len)\n    padded_str_num2 = str_num2.zfill(max_len)\n\n    total_diff = 0\n    for i in range(max_len):\n        digit1 = int(padded_str_num1[i])\n        digit2 = int(padded_str_num2[i])\n        total_diff += abs(digit1 - digit2)\n\n    return total_diff"}
{"task_id": "Mbpp/558", "solution": "def digit_distance_nums(num1: int, num2: int) -> int:\n    \"\"\"\n    Calculates the sum of the absolute differences of corresponding digits\n    between two integers, treating missing digits as zeros.\n    \"\"\"\n    total_distance = 0\n    while num1 > 0 or num2 > 0:\n        d1 = num1 % 10\n        d2 = num2 % 10\n        total_distance += abs(d1 - d2)\n        num1 //= 10\n        num2 //= 10\n    return total_distance"}
{"task_id": "Mbpp/560", "solution": "def union_elements(tuple1: tuple, tuple2: tuple) -> tuple:\n    \"\"\"Finds the union of elements from two tuples and returns them in sorted order.\"\"\"\n    combined_elements = set(tuple1) | set(tuple2)\n    sorted_elements = sorted(list(combined_elements))\n    return tuple(sorted_elements)"}
{"task_id": "Mbpp/560", "solution": "def union_elements(tuple1: tuple, tuple2: tuple) -> tuple:\n    \"\"\"Computes the union of elements from two tuples and returns them sorted as a tuple.\"\"\"\n    set1 = set(tuple1)\n    set2 = set(tuple2)\n    union_set = set1.union(set2)\n    unsorted_list = list(union_set)\n    sorted_list = sorted(unsorted_list)\n    result_tuple = tuple(sorted_list)\n    return result_tuple"}
{"task_id": "Mbpp/562", "solution": "from typing import List, Any\ndef Find_Max_Length(input_list_of_lists: List[List[Any]]) -> int:\n    \"\"\"Calculates the length of the longest sublist in a list of lists.\n    Returns 0 if the input list is empty or contains only empty sublists.\"\"\"\n    max_length = 0\n    for sublist in input_list_of_lists:\n        sublist_length = len(sublist)\n        if sublist_length > max_length:\n            max_length = sublist_length\n    return max_length"}
{"task_id": "Mbpp/559", "solution": "def max_sub_array_sum(numbers: list) -> float:\n    \"\"\"\n    Finds the sum of the largest contiguous sublist in the given list.\n    Returns the maximum sum of any contiguous sublist.\n    \"\"\"\n    if not numbers:\n        return 0.0\n\n    max_so_far = numbers[0]\n    current_max = numbers[0]\n\n    for i in range(1, len(numbers)):\n        current_max = max(numbers[i], current_max + numbers[i])\n        max_so_far = max(max_so_far, current_max)\n\n    return float(max_so_far)"}
{"task_id": "Mbpp/559", "solution": "def max_sub_array_sum(arr: list[int], n: int) -> int:\n    \"\"\"\n    Calculates the sum of the largest contiguous sublist within a given list.\n    This function implements Kadane's algorithm to efficiently find the maximum sum.\n    \"\"\"\n    # Initialize max_so_far and current_max with the first element of the array.\n    # This correctly handles cases where all numbers are negative or the list has only one element.\n    max_so_far = arr[0]\n    current_max = arr[0]\n\n    # Iterate through the array starting from the second element.\n    for i in range(1, n):\n        # For each element, decide whether to extend the current sublist or start a new one.\n        current_max = max(arr[i], current_max + arr[i])\n\n        # Update the overall maximum sum found so far if the current_max is greater.\n        max_so_far = max(max_so_far, current_max)\n\n    return max_so_far"}
{"task_id": "Mbpp/562", "solution": "def Find_Max_Length(list_of_lists: list[list]) -> int:\n    \"\"\"\n    Determines and returns the maximum length among all sublists within a given list of lists.\n    Returns 0 if the input list is empty or contains only empty sublists.\n    \"\"\"\n    max_length = 0\n    for sublist in list_of_lists:\n        current_sublist_length = len(sublist)\n        if current_sublist_length > max_length:\n            max_length = current_sublist_length\n    return max_length"}
