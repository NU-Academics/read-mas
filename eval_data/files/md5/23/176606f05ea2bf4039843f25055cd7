{"task_id": "Mbpp/753", "solution": "def min_k(tuple_list: list[tuple], k: int) -> list[tuple]:\n    \"\"\"\n    Identifies and returns the k records with the minimum values from a given list of tuples.\n    Tuples are compared based on the second element (numerical value).\n    \"\"\"\n    if not isinstance(k, int):\n        raise ValueError(\"k must be an integer.\")\n    if k < 0:\n        raise ValueError(\"k must be a non-negative integer.\")\n\n    if not tuple_list or k == 0:\n        return []\n\n    # Sort based on the second element of the tuple\n    sorted_list = sorted(tuple_list, key=lambda x: x[1])\n\n    if k >= len(sorted_list):\n        return sorted_list\n\n    return sorted_list[:k]"}
{"task_id": "Mbpp/754", "solution": "def extract_index_list(list1: list, list2: list, list3: list) -> list:\n    \"\"\"Identifies and returns elements common to three input lists at the same index.\"\"\"\n    common_elements_list = []\n    min_length = min(len(list1), len(list2), len(list3))\n\n    for i in range(min_length):\n        element1 = list1[i]\n        element2 = list2[i]\n        element3 = list3[i]\n\n        if element1 == element2 and element2 == element3:\n            common_elements_list.append(element1)\n\n    return common_elements_list"}
{"task_id": "Mbpp/754", "solution": "def extract_index_list(list1: list, list2: list, list3: list) -> list:\n    \"\"\"Finds common elements from three lists at the same index.\n    An element is common if it appears in all three lists under the same index.\n    \"\"\"\n    common_elements = []\n    min_length = min(len(list1), len(list2), len(list3))\n\n    for i in range(min_length):\n        if list1[i] == list2[i] == list3[i]:\n            common_elements.append(list1[i])\n\n    return common_elements"}
{"task_id": "Mbpp/753", "solution": "from typing import List, Tuple\ndef min_k(tuple_list: List[Tuple[str, int]], k: int) -> List[Tuple[str, int]]:\n    \"\"\"\n    Finds the k tuples with the smallest integer values from a list of (string, int) tuples.\n    The returned list is sorted in ascending order by the integer values.\n    \"\"\"\n    # Sort the list of tuples based on the integer value (second element) in ascending order.\n    sorted_list = sorted(tuple_list, key=lambda x: x[1])\n\n    # Select the first 'k' elements from the sorted list using slicing.\n    return sorted_list[:k]"}
{"task_id": "Mbpp/755", "solution": "def second_smallest(numbers: list) -> float | int | None:\n    \"\"\"\n    Identifies and returns the second smallest distinct number from a given list.\n    Returns None if the list has fewer than two distinct elements.\n    \"\"\"\n    if len(numbers) < 2:\n        return None\n\n    distinct_numbers = sorted(list(set(numbers)))\n\n    if len(distinct_numbers) < 2:\n        return None\n    else:\n        return distinct_numbers[1]"}
{"task_id": "Mbpp/748", "solution": "def capital_words_spaces(input_string: str) -> str:\n    \"\"\"Inserts spaces before uppercase letters that follow a lowercase letter.\"\"\"\n    \"\"\"The function builds the modified string character by character.\"\"\"\n\n    if not input_string:\n        return \"\"\n\n    result_chars = [input_string[0]]\n\n    for i in range(1, len(input_string)):\n        current_char = input_string[i]\n        prev_char = input_string[i-1]\n\n        if current_char.isupper() and prev_char.islower():\n            result_chars.append(\" \")\n\n        result_chars.append(current_char)\n\n    return \"\".join(result_chars)"}
{"task_id": "Mbpp/755", "solution": "class SecondSmallestError(ValueError):\n    \"\"\"Exception raised for errors in determining the second smallest number.\"\"\"\n    pass\ndef second_smallest(numbers: list):\n    \"\"\"\n    Finds the second smallest number in a given list of numbers.\n    Raises SecondSmallestError if the list is invalid.\n    \"\"\"\n    if not isinstance(numbers, list):\n        raise SecondSmallestError(\"Input must be a list.\")\n\n    if len(numbers) < 2:\n        raise SecondSmallestError(\"List must contain at least two numbers.\")\n\n    for num in numbers:\n        if not isinstance(num, (int, float)):\n            raise SecondSmallestError(\"List must contain only numeric values.\")\n\n    sorted_numbers = sorted(numbers)\n    return sorted_numbers[1]"}
{"task_id": "Mbpp/758", "solution": "from collections import Counter\nfrom typing import List, Dict, Tuple, Any\ndef unique_sublists(input_list: List[List[Any]]) -> Dict[Tuple[Any, ...], int]:\n    \"\"\"Counts occurrences of sublists, converting each to a tuple. Returns a dictionary of tuple-counts.\"\"\"\n    # Convert all sublists to tuples to make them hashable for counting.\n    tuple_converted_sublists = [tuple(sublist) for sublist in input_list]\n\n    # Use Counter to efficiently count occurrences of each unique tuple.\n    occurrence_counts = Counter(tuple_converted_sublists)\n\n    return occurrence_counts"}
{"task_id": "Mbpp/757", "solution": "def count_reverse_pairs(string_list):\n    \"\"\"Counts unique pairs of reverse strings in a list, handling palindromes and case sensitivity.\n    Decrements counts for processed strings to avoid re-pairing.\"\"\"\n    string_counts = {}\n    for s in string_list:\n        string_counts[s] = string_counts.get(s, 0) + 1\n\n    total_pairs_count = 0\n\n    # Iterate over a copy of keys to avoid issues when modifying string_counts during iteration\n    for s in list(string_counts.keys()):\n        if string_counts.get(s, 0) == 0:\n            continue  # String already processed as part of a pair\n\n        s_reversed = s[::-1]\n\n        if s == s_reversed:  # Palindrome check\n            # A palindrome can form a pair with itself if there are at least two instances\n            if string_counts.get(s, 0) >= 2:\n                total_pairs_count += 1\n                string_counts[s] -= 2\n        else:  # Non-palindrome check\n            # Check if its reverse exists and is available\n            if string_counts.get(s_reversed, 0) > 0:\n                total_pairs_count += 1\n                string_counts[s] -= 1\n                string_counts[s_reversed] -= 1\n\n    return total_pairs_count"}
