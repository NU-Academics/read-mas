betical_order(char)\n                if order % 2 != 0:\n                    count += 1\n        return count\n\n    if _has_whitespace(txt):\n        return txt.split()\n    elif _has_comma(txt):\n        return txt.split(',')\n    else:\n        return _count_odd_ordered_lowercase_letters(txt)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/126": [{"task_id": "HumanEval/126", "solution": "def is_sorted(lst):\n    # An empty or single-element list is considered sorted and has no problematic duplicates.\n    if len(lst) <= 1:\n        return True\n\n    # First, check if the list is sorted in ascending order.\n    for i in range(1, len(lst)):\n        if lst[i] < lst[i-1]:\n            return False\n\n    # Second, check for the duplicate rule: no more than one duplicate of any number.\n    # This means each number can appear at most twice.\n    counts = {}\n    for num in lst:\n        counts[num] = counts.get(num, 0) + 1\n        if counts[num] > 2:  # If a number appears 3 or more times, it violates the rule.\n            return False\n\n    # If both checks pass, the list is sorted and adheres to the duplicate rule.\n    return True", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/128": [{"task_id": "HumanEval/128", "solution": "def _get_sign(number):\n    \"\"\"Determines the sign of a single integer.\"\"\"\n    if number > 0:\n        return 1\n    elif number < 0:\n        return -1\n    else:\n        return 0\ndef _get_magnitude(number):\n    \"\"\"Calculates the magnitude (absolute value) of a single integer.\"\"\"\n    return abs(number)\ndef prod_signs(arr):\n    \"\"\"\n    You are given an array arr of integers and you need to return\n    sum of magnitudes of integers multiplied by product of all signs\n    of each number in the array, represented by 1, -1 or 0.\n    Note: return None for empty arr.\n    \"\"\"\n    if not arr:\n        return None\n\n    product_of_signs = 1\n    sum_of_magnitudes = 0\n\n    for num in arr:\n        sign = _get_sign(num)\n        magnitude = _get_magnitude(num)\n\n        product_of_signs *= sign\n        sum_of_magnitudes += magnitude\n\n    return sum_of_magnitudes * product_of_signs", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/127": [{"task_id": "HumanEval/127", "solution": "def intersection(interval1, interval2):\n    \"\"\"Determine if the length of intersection of two intervals is a prime number.\n    Returns \"YES\" if the length is prime, \"NO\" otherwise or if no intersection.\"\"\"\n\n    def is_prime(number: int) -> bool:\n        \"\"\"Determines if a given integer is a prime number.\"\"\"\n        if number <= 1:\n            return False\n        if number <= 3:\n            return True\n        if number % 2 == 0 or number % 3 == 0:\n            return False\n        i = 5\n        while i * i <= number:\n            if number % i == 0 or number % (i + 2) == 0:\n                return False\n            i += 6\n        return True\n\n    s1, e1 = interval1\n    s2, e2 = interval2\n\n    intersection_start = max(s1, s2)\n    intersection_end = min(e1, e2)\n\n    length = 0\n    if intersection_start <= intersection_end:\n        length = intersection_end - intersection_start + 1\n\n    if is_prime(length):\n        return \"YES\"\n    else:\n        return \"NO\"", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[[-1, 1], [0, 4]]], "plus_fail_tests": [[[10, 20], [15, 25]]]}], "HumanEval/132": [{"task_id": "HumanEval/132", "solution": "def is_nested(string):\n    '''\n    Returns True if there is a subsequence of brackets where at least one bracket is nested,\n    meaning there exist indices i < j < k < l such that string[i]=='[', string[j]=='[', string[k]==']', string[l]==']'.\n    '''\n    # Find the first '[' (index i)\n    first_open_idx = -1\n    for idx, char in enum