 them.\"\"\"\n    def __init__(self, value: int):\n        if not isinstance(value, int):\n            raise TypeError(\"Input 'x' must be an integer.\")\n        self._value = value\n\n    def get_digits(self) -> list[int]:\n        \"\"\"Returns a list of digits of the integer.\"\"\"\n        if self._value == 0:\n            return [0]\n        return [int(d) for d in str(abs(self._value))]\n\n    def count_digits(self) -> int:\n        \"\"\"Returns the number of digits in the integer.\"\"\"\n        if self._value == 0:\n            return 1\n        return len(str(abs(self._value)))\nclass ShiftAmount:\n    \"\"\"Encapsulates the shift amount.\"\"\"\n    def __init__(self, amount: int):\n        if not isinstance(amount, int):\n            raise TypeError(\"Input 'shift' must be an integer.\")\n        self._amount = amount\n\n    def get_amount(self) -> int:\n        \"\"\"Returns the shift amount.\"\"\"\n        return self._amount\nclass ProcessedDigits:\n    \"\"\"Manages the sequence of digits, performing circular shifts, reversals, and converting to string.\"\"\"\n    def __init__(self, digits: list[int]):\n        if not all(isinstance(d, int) and 0 <= d <= 9 for d in digits):\n            raise ValueError(\"Digits must be a list of single-digit integers.\")\n        self._sequence = deque(digits)\n\n    def circular_shift_right(self, shift: int) -> None:\n        \"\"\"Performs a circular right shift on the digits in place.\"\"\"\n        if not isinstance(shift, int) or shift < 0:\n            raise ValueError(\"Shift amount must be a non-negative integer.\")\n        if not self._sequence:\n            return\n        self._sequence.rotate(shift)\n\n    def reverse(self) -> None:\n        \"\"\"Reverses the order of digits in place.\"\"\"\n        self._sequence.reverse()\n\n    def to_string(self) -> str:\n        \"\"\"Converts the list of digits to a string.\"\"\"\n        return \"\".join(map(str, self._sequence))\ndef circular_shift(x, shift):\n    \"\"\"Circular shift the digits of the integer x, shift the digits right by shift\n    and return the result as a string.\n    If shift > number of digits, return digits reversed.\n    >>> circular_shift(12, 1)\n    \"21\"\n    >>> circular_shift(12, 2)\n    \"12\"\n    \"\"\"\n    input_num = InputNumber(x)\n    shift_amount = ShiftAmount(shift)\n\n    digits = input_num.get_digits()\n    num_digits = input_num.count_digits()\n\n    processed_digits = ProcessedDigits(digits)\n\n    if shift_amount.get_amount() > num_digits:\n        processed_digits.reverse()\n    else:\n        processed_digits.circular_shift_right(shift_amount.get_amount())\n\n    return processed_digits.to_string()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/68": [{"task_id": "HumanEval/68", "solution": "def pluck(arr):\n    \"\"\"\n    Finds the smallest even value in the array and its smallest index.\n    Returns [value, index] or [] if no even values are found.\n    \"\"\"\n    smallest_even_value = float('inf')\n    smallest_index = -1\n\n    for index, value in enumerate(arr):\n        if value % 2 == 0:  # Check if the value is even\n            if value < smallest_even_value:\n                smallest_even_value = value\n                smallest_index = index\n            elif value == smallest_even_value and index < smallest_index:\n                # If values are equal, prioritize the smaller index\n                smallest_index = index\n\n    if smallest_index == -1:\n        return []\n    else:\n        return [smallest_even_value, smallest_index]", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/72": [{"task_id": "HumanEval/72", "solution": "def _is_palindrome(q):\n    \"\"\"\n    Determines if a list is a palindrome.\n    \"\"\"\n    return q == q[::-1]\ndef _calculate_sum(q):\n    \"\"\"\n    Calculates the sum of elements in a list.\n    \"\"\"\n    return 