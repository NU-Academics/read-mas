ator, denominator)\n\n        def multiply(self, other: 'Fraction') -> 'Fraction':\n            \"\"\"Multiplies this fraction by another fraction.\"\"\"\n            product_numerator = self._numerator * other._numerator\n            product_denominator = self._denominator * other._denominator\n            return Fraction(product_numerator, product_denominator)\n\n        def is_whole_number(self) -> bool:\n            \"\"\"Checks if the fraction represents a whole number.\"\"\"\n            return self._numerator % self._denominator == 0\n\n    fraction_x = Fraction.from_string(x)\n    fraction_n = Fraction.from_string(n)\n\n    product_fraction = fraction_x.multiply(fraction_n)\n\n    is_whole = product_fraction.is_whole_number()\n\n    return is_whole", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/148": [{"task_id": "HumanEval/148", "solution": "class Planet:\n    \"\"\"Represents a single planet with its name and orbital order.\"\"\"\n    def __init__(self, name: str, order_from_sun: int):\n        self.name = name\n        self.order_from_sun = order_from_sun\nclass SolarSystem:\n    \"\"\"Encapsulates solar system planet data and provides query methods.\"\"\"\n    def __init__(self):\n        self._planets = [\n            Planet(\"Mercury\", 1),\n            Planet(\"Venus\", 2),\n            Planet(\"Earth\", 3),\n            Planet(\"Mars\", 4),\n            Planet(\"Jupiter\", 5),\n            Planet(\"Saturn\", 6),\n            Planet(\"Uranus\", 7),\n            Planet(\"Neptune\", 8),\n        ]\n        self._planet_map = {planet.name: planet for planet in self._planets}\n\n    def get_planet_order(self, planet_name: str) -> int | None:\n        \"\"\"Returns the order_from_sun of a planet, or None if not found.\"\"\"\n        planet = self._planet_map.get(planet_name)\n        return planet.order_from_sun if planet else None\n\n    def get_planets_between(self, planet1_name: str, planet2_na