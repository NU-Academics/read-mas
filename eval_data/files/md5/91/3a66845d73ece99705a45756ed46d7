{"task_id": "Mbpp/71", "solution": "def comb_sort(lst: list) -> list:\n    \"\"\"\n    Sorts a list of elements using the Comb Sort algorithm.\n    Raises TypeError if the input is not a list.\n    \"\"\"\n    if not isinstance(lst, list):\n        raise TypeError(\"Input must be a list.\")\n\n    arr = lst[:]  # Create a copy to sort, preserving the original list.\n    n = len(arr)\n\n    gap = n\n    shrink_factor = 1.3\n    swapped = True\n\n    while gap > 1 or swapped:\n        gap = int(gap / shrink_factor)\n        if gap < 1:\n            gap = 1\n\n        swapped = False\n        for i in range(n - gap):\n            if arr[i] > arr[i + gap]:\n                arr[i], arr[i + gap] = arr[i + gap], arr[i]\n                swapped = True\n    return arr"}
{"task_id": "Mbpp/75", "solution": "from typing import List, Tuple as PyTuple\nclass Tuple:\n    \"\"\"Represents a tuple and provides logic for checking divisibility of its elements.\"\"\"\n    def __init__(self, *elements: int):\n        self.elements: List[int] = list(elements)\n\n    def all_divisible_by(self, k: int) -> bool:\n        \"\"\"Checks if all elements in the tuple are divisible by k.\"\"\"\n        return all((e % k) == 0 for e in self.elements)\n\n    def to_native_tuple(self) -> PyTuple[int, ...]:\n        \"\"\"Converts the domain Tuple object back to a native Python tuple.\"\"\"\n        return PyTuple(self.elements)\nclass InputList:\n    \"\"\"Normalizes a list of native tuples into a collection of domain Tuple objects.\"\"\"\n    def __init__(self, tuples: list):\n        self.tuples: List[Tuple] = [Tuple(*t_elements) for t_elements in tuples]\nclass OutputList:\n    \"\"\"A container for Tuple instances that pass the divisibility filter.\"\"\"\n    def __init__(self, tuples: List[Tuple] = None):\n        self.tuples: List[Tuple] = tuples if tuples is not None else []\n\n    def append(self, item: Tuple):\n        \"\"\"Appends a Tuple object to the list.\"\"\"\n        self.tuples.append(item)\n\n    def to_native_tuples(self) -> list:\n        \"\"\"Converts the contained domain Tuple objects back to a list of native Python tuples.\"\"\"\n        return [t.to_native_tuple() for t in self.tuples]\nclass FindTuples:\n    \"\"\"Encapsulates the filtering algorithm, orchestrating domain objects.\"\"\"\n    def __init__(self, list_of_tuples: list, k: int):\n        self.input_list = InputList(list_of_tuples)\n        self.k = k\n        self.output_list = OutputList()\n\n    def execute(self) -> list:\n        \"\"\"Filters input tuples based on divisibility by k and returns the result.\"\"\"\n        for domain_tuple in self.input_list.tuples:\n            if domain_tuple.all_divisible_by(self.k):\n                self.output_list.append(domain_tuple)\n        return self.output_list.to_native_tuples()\ndef find_tuples(list_of_tuples: list, k: int) -> list:\n    \"\"\"Public API: returns a list of tuples where each element % k == 0.\"\"\"\n    impl = FindTuples(list_of_tuples, k)\n    return impl.execute()"}
{"task_id": "Mbpp/74", "solution": "from typing import List, Dict, Any, Hashable\nclass Element:\n    \"\"\"Wrapper for a primitive value to be used in Pattern/Sequence.\"\"\"\n    def __init__(self, value: Hashable):\n        self._value = value\n\n    @property\n    def value(self) -> Hashable:\n        return self._value\n\n    def __eq__(self, other: Any) -> bool:\n        if not isinstance(other, Element):\n            return NotImplemented\n        return self._value == other._value\n\n    def __hash__(self) -> int:\n        return hash(self._value)\nclass Pattern:\n    \"\"\"Immutable wrapper for an input pattern list.\"\"\"\n    def __init__(self, raw_patterns: List[Any]):\n        self._elements: List[Element] = [Element(p) for p in raw_patterns]\n\n    def __len__(self) -> int:\n        return len(self._elements)\n\n    def __getitem__(self, index: int) -> Element:\n        return self._elements[index]\nclass Sequence:\n    \"\"\"Immutable wrapper for an input sequence list.\"\"\"\n    def __init__(self, raw_sequence: List[Any]):\n        self._elements: List[Element] = [Element(s) for s in raw_sequence]\n\n    def __len__(self) -> int:\n        return len(self._elements)\n\n    def __getitem__(self, index: int) -> Element:\n        return self._elements[index]\nclass Mapping:\n    \"\"\"Maintains one-to-one mapping and enforces injectivity.\"\"\"\n    def __init__(self):\n        self._forward_map: Dict[Hashable, Hashable] = {}  # pattern_value -> sequence_value\n        self._backward_map: Dict[Hashable, Hashable] = {} # sequence_value -> pattern_value\n\n    def add(self, pattern_val: Hashable, seq_val: Hashable) -> bool:\n        \"\"\"\n        Adds a mapping from pattern_val to seq_val, returning False if inconsistent.\n        \"\"\"\n        if pattern_val in self._forward_map:\n            if self._forward_map[pattern_val] != seq_val:\n                return False\n        \n        if seq_val in self._backward_map:\n            if self._backward_map[seq_val] != pattern_val:\n                return False\n        \n        self._forward_map[pattern_val] = seq_val\n        self._backward_map[seq_val] = pattern_val\n        return True\n\n    def resolve(self, pattern_val: Hashable) -> Hashable | None:\n        \"\"\"Returns the mapped sequence value for a given pattern value, or None.\"\"\"\n        return self._forward_map.get(pattern_val)\n\n    def isConsistent(self) -> bool:\n        \"\"\"Verifies internal mapping consistency and injectivity.\"\"\"\n        if len(self._forward_map) != len(self._backward_map):\n            return False\n        \n        for p_val, s_val in self._forward_map.items():\n            if self._backward_map.get(s_val) != p_val:\n                return False\n        return True\nclass PatternChecker:\n    \"\"\"Orchestrates pattern-sequence validation, mapping, and verification.\"\"\"\n    def is_samepatterns(self, patterns_list: List[Any], sequence_list: List[Any]) -> bool:\n        \"\"\"\n        Checks if the sequence follows the pattern defined by patterns_list.\n        \"\"\"\n        _pattern = Pattern(patterns_list)\n        _sequence = Sequence(sequence_list)\n        _mapping = Mapping()\n\n        for i in range(len(_pattern)):\n            pattern_element_value = _pattern[i].value\n            sequence_element_value = _sequence[i].value\n            if not _mapping.add(pattern_element_value, sequence_element_value):\n                return False\n        \n        if not _mapping.isConsistent():\n            return False\n\n        for i in range(len(_pattern)):\n            pattern_element_value = _pattern[i].value\n            expected_sequence_element_value = _sequence[i].value\n            mapped_value = _mapping.resolve(pattern_element_value)\n            if mapped_value != expected_sequence_element_value:\n                return False\n                \n        return True\ndef is_samepatterns(patterns: List[Any], sequence: List[Any]) -> bool:\n    \"\"\"Return True if sequence follows the pattern defined by patterns per SRS.\"\"\"\n    if len(patterns) != len(sequence):\n        return False\n\n    checker = PatternChecker()\n    return checker.is_samepatterns(patterns, sequence)"}
{"task_id": "Mbpp/80", "solution": "def tetrahedral_number(n: int) -> int:\n    \"\"\"Return the nth tetrahedral number as an int.\n\n    Signature and name must match SRS: tetrahedral_number(n)\n    \"\"\"\n    return n * (n + 1) * (n + 2) // 6"}
{"task_id": "Mbpp/82", "solution": "import math\nclass InputValidator:\n    def isNumeric(self, value):\n        \"\"\"Return True if value is int or float; False otherwise.\"\"\"\n        return isinstance(value, (int, float))\nclass Sphere:\n    def __init__(self, radius):\n        \"\"\"Initialize Sphere with a radius and set initial volume to 0.0.\"\"\"\n        self.radius = float(radius)\n        self.volume = 0.0\n\n    def computeVolume(self):\n        \"\"\"Compute sphere's volume using (4/3) * pi * radius^3 and return it.\"\"\"\n        self.volume = (4/3) * math.pi * (self.radius ** 3)\n        return self.volume\nclass VolumeCalculator:\n    def volume_sphere(self, radius):\n        \"\"\"Validate radius, create Sphere, compute, and return volume as float.\"\"\"\n        validator = InputValidator()\n        validator.isNumeric(radius) # As per design, behavior for non-numeric input is undefined beyond this check.\n        \n        sphere = Sphere(radius)\n        return sphere.computeVolume()\ndef volume_sphere(radius):\n    \"\"\"Public entry function; delegates to VolumeCalculator.volume_sphere(radius) and returns float.\"\"\"\n    calculator = VolumeCalculator()\n    return calculator.volume_sphere(radius)"}
{"task_id": "Mbpp/87", "solution": "def merge_dictionaries_three(a: dict, b: dict, c: dict) -> dict:\n    \"\"\"\n    Accepts exactly three dictionaries and returns a new built-in dict containing\n    every key/value pair present in any input. Duplicate keys with identical\n    values are preserved. Behavior for differing values is unspecified by the SRS.\n    \"\"\"\n    result = {}\n    for d in (a, b, c):\n        for k, v in d.items():\n            result[k] = v\n    return result"}
{"task_id": "Mbpp/86", "solution": "def centered_hexagonal_number(n: int) -> int:\n    \"\"\"Return the nth centered hexagonal number for integer n >= 1.\n\n    Raises:\n        ValueError: if n is not an integer or n < 1.\n    \"\"\"\n    if not isinstance(n, int) or n < 1:\n        raise ValueError(\"n must be an integer >= 1\")\n\n    # The formula for the nth centered hexagonal number is 3n^2 - 3n + 1.\n    result = 3 * n**2 - 3 * n + 1\n    return result"}
