{"task_id": "Mbpp/739", "solution": "from typing import Optional\ndef find_Index(n: int) -> int:\n    \"\"\"Public API: returns smallest k such that digits(T_k) == n.\"\"\"\n    if not Validator.is_valid(n):\n        raise ValueError(\"n must be an integer >= 1\")\n    k: int = 1\n    while True:\n        t: int = TriangularNumber.compute(k)\n        if DigitCounter.digits(t) == n:\n            return Result(k).as_int()\n        k += 1\nclass Validator:\n    @staticmethod\n    def is_valid(n: object) -> bool:\n        \"\"\"Validates if n is an integer greater than or equal to 1.\"\"\"\n        return isinstance(n, int) and n >= 1\nclass TriangularNumber:\n    @staticmethod\n    def compute(k: int) -> int:\n        \"\"\"Computes the k-th triangular number.\"\"\"\n        return k * (k + 1) // 2\nclass DigitCounter:\n    @staticmethod\n    def digits(value: int) -> int:\n        \"\"\"Counts the number of decimal digits in a non-negative integer.\"\"\"\n        if value == 0:\n            return 1\n        c = 0\n        v = abs(value)\n        while v:\n            v //= 10\n            c += 1\n        return c\nclass Result:\n    \"\"\"Encapsulates the found index.\"\"\"\n    def __init__(self, index: int) -> None:\n        self.index = index\n    def as_int(self) -> int:\n        \"\"\"Returns the encapsulated index as an integer.\"\"\"\n        return self.index"}
