{"task_id": "Mbpp/268", "solution": "class InputParameter:\n    \"\"\"Encapsulates input parameter n and provides validation logic.\"\"\"\n    def __init__(self, n) -> None:\n        self.n = n\n\n    def validate(self) -> bool:\n        \"\"\"Validates if n is an integer and n >= 1.\"\"\"\n        return isinstance(self.n, int) and self.n >= 1\nclass SequenceFormula:\n    \"\"\"Encapsulates the star number sequence formula and its computation.\"\"\"\n    expression: str = \"6*n*(n-1)+1\"\n\n    def __init__(self) -> None:\n        pass\n\n    def compute(self, n: int) -> int:\n        \"\"\"Computes the nth star number using the formula 6 * n * (n - 1) + 1.\"\"\"\n        return 6 * n * (n - 1) + 1\nclass StarNumberResult:\n    \"\"\"Represents the computed star number result value.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\nclass StarNumberCalculator:\n    \"\"\"Orchestrates computation of star numbers, validating input and applying the formula.\"\"\"\n    def __init__(self) -> None:\n        self._formula = SequenceFormula()\n\n    def find_star_num(self, n: int) -> int:\n        \"\"\"Validates input n and computes the nth star number using the formula.\"\"\"\n        param = InputParameter(n)\n        if not param.validate():\n            raise ValueError(\"n must be integer and n >= 1\")\n        value = self._formula.compute(int(n))\n        result = StarNumberResult(value)\n        return result.value\ndef find_star_num(n) -> int:\n    \"\"\"Public API: validates n and returns the nth star number; raises ValueError on invalid input.\"\"\"\n    calculator = StarNumberCalculator()\n    return calculator.find_star_num(n)"}
{"task_id": "Mbpp/270", "solution": "def sum_even_and_even_index(input_list: list[int]) -> int:\n    \"\"\"Compute and return the sum of elements that are even and located at even indices (zero-based).\n    Returns: int (0 when input_list is empty or no qualifying elements).\n    \"\"\"\n    total_sum = 0\n    for index, value in enumerate(input_list):\n        if index % 2 == 0 and value % 2 == 0:\n            total_sum += value\n    return total_sum"}
{"task_id": "Mbpp/271", "solution": "from typing import List\ndef _generate_even_sequence(n: int) -> List[int]:\n    \"\"\"Generate and return [2, 4, ..., 2*n].\"\"\"\n    return [2 * i for i in range(1, n + 1)]\ndef _sum_powers(seq: List[int], power: int = 5) -> int:\n    \"\"\"Return the sum of each element in seq raised to 'power'.\"\"\"\n    return sum(x ** power for x in seq)\ndef even_Power_Sum(n: int) -> int:\n    \"\"\"Compute the sum of the first n even natural numbers, each raised to the fifth power.\"\"\"\n    even_numbers = _generate_even_sequence(n)\n    return _sum_powers(even_numbers, power=5)"}
{"task_id": "Mbpp/273", "solution": "def substract_elements(first_tuple, second_tuple):\n    \"\"\"Subtracts elements of the second tuple from the first tuple element-wise.\"\"\"\n    _validate_is_tuple(first_tuple, 'first_tuple')\n    _validate_is_tuple(second_tuple, 'second_tuple')\n    _validate_equal_length(first_tuple, second_tuple)\n    _validate_numeric_elements(first_tuple, 'first_tuple')\n    _validate_numeric_elements(second_tuple, 'second_tuple')\n\n    result = []\n    for i in range(len(first_tuple)):\n        result.append(first_tuple[i] - second_tuple[i])\n    return tuple(result)"}
