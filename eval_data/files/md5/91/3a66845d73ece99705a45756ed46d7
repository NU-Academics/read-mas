{"task_id": "Mbpp/478", "solution": "class InputString:\n    def __init__(self, value: str):\n        self.value = value\nclass OutputString:\n    def __init__(self, value: str):\n        self.value = value\nclass LowercaseSubstringDetector:\n    def isLowercase(self, c: str) -> bool:\n        \"\"\"Checks if a character is an ASCII lowercase letter.\"\"\"\n        return 'a' <= c <= 'z'\n\n    def detectContiguousLowercase(self, input_str: str) -> list[str]:\n        \"\"\"Detects and returns contiguous ASCII lowercase substrings.\"\"\"\n        lowercase_substrings = []\n        current_lowercase_sub = []\n        for char in input_str:\n            if self.isLowercase(char):\n                current_lowercase_sub.append(char)\n            else:\n                if current_lowercase_sub:\n                    lowercase_substrings.append(\"\".join(current_lowercase_sub))\n                    current_lowercase_sub = []\n        if current_lowercase_sub:\n            lowercase_substrings.append(\"\".join(current_lowercase_sub))\n        return lowercase_substrings\nclass RemoveLowercaseService:\n    def __init__(self):\n        self._detector = LowercaseSubstringDetector()\n\n    def remove_lowercase(self, input_str_val: str) -> str:\n        \"\"\"Orchestrates detection and removal of lowercase substrings.\"\"\"\n        input_string_obj = InputString(input_str_val)\n        \n        result_chars = []\n        i = 0\n        while i < len(input_string_obj.value):\n            char = input_string_obj.value[i]\n            if self._detector.isLowercase(char):\n                # Skip the entire contiguous lowercase block\n                while i < len(input_string_obj.value) and self._detector.isLowercase(input_string_obj.value[i]):\n                    i += 1\n            else:\n                # Not a lowercase character, keep it\n                result_chars.append(char)\n                i += 1\n        \n        output_str_obj = OutputString(\"\".join(result_chars))\n        return output_str_obj.value\ndef remove_lowercase(input: str) -> str:\n    \"\"\"Removes all contiguous ASCII lowercase substrings from the input string.\"\"\"\n    return RemoveLowercaseService().remove_lowercase(input)"}
{"task_id": "Mbpp/476", "solution": "def _find_min(values: list) -> float | int:\n    \"\"\"Returns the minimum element from a numeric list.\"\"\"\n    return min(values)\ndef _find_max(values: list) -> float | int:\n    \"\"\"Returns the maximum element from a numeric list.\"\"\"\n    return max(values)\ndef big_sum(values: list) -> float | int:\n    \"\"\"\n    Calculates the sum of the largest and smallest value in a list of numbers.\n\n    Parameters:\n        values (list): A list of numeric values (int or float). Must not be empty.\n\n    Returns:\n        int | float: The sum of the smallest and largest values in the list.\n\n    Raises:\n        TypeError: If 'values' is not a list or contains non-numeric elements.\n        ValueError: If 'values' is an empty list.\n    \"\"\"\n    _validate_input(values)\n    _validate_elements_numeric(values)\n\n    if not values:\n        raise ValueError(\"values must not be empty\")\n\n    min_val = _find_min(values)\n    max_val = _find_max(values)\n\n    return min_val + max_val"}
{"task_id": "Mbpp/479", "solution": "def first_Digit(n):\n    \"\"\"\n    Finds the most significant (first) digit of an integer.\n    Returns 0 if the input is 0. Negative integers are treated by magnitude.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an int\")\n    \n    if n == 0:\n        return 0\n    \n    n_abs = abs(n)\n    \n    while n_abs >= 10:\n        n_abs //= 10\n        \n    return n_abs"}
{"task_id": "Mbpp/554", "solution": "def isOdd(value: int) -> bool:\n    \"\"\"Checks if an integer is odd.\"\"\"\n    return value % 2 != 0\ndef Split(input_list: list[int]) -> list[int]:\n    \"\"\"\n    Filters a list of integers, returning only the odd ones while preserving their original order.\n    \"\"\"\n    output: list[int] = []\n    for v in input_list:\n        if isOdd(v):\n            output.append(v)\n    return output"}
{"task_id": "Mbpp/555", "solution": "def difference(n):\n    \"\"\"\n    Calculates the difference between the sum of cubes of the first n natural numbers\n    and the sum of the first n natural numbers using closed-form formulas.\n    \"\"\"\n    sum_natural_numbers = n * (n + 1) // 2\n    sum_cubes_natural_numbers = sum_natural_numbers ** 2\n    return sum_cubes_natural_numbers - sum_natural_numbers"}
{"task_id": "Mbpp/556", "solution": "from typing import List, Tuple\ndef _count_parity(arr: List[int], n: int) -> Tuple[int, int]:\n    \"\"\"\n    Counts the number of odd and even integers in arr[0:n].\n    Assumes inputs are valid as per _validate_inputs.\n    \"\"\"\n    odd_count = 0\n    even_count = 0\n    for i in range(n):\n        if arr[i] % 2 == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n    return odd_count, even_count\ndef find_Odd_Pair(arr: List[int], n: int) -> int:\n    \"\"\"\n    Counts the number of unordered pairs (i, j) with 0 <= i < j < n\n    whose XOR value (arr[i] ^ arr[j]) is odd.\n    \"\"\"\n    _validate_inputs(arr, n)\n    odd_count, even_count = _count_parity(arr, n)\n    # A pair's XOR is odd if one number is odd and the other is even.\n    # The number of such pairs is odd_count * even_count.\n    return odd_count * even_count"}
{"task_id": "Mbpp/557", "solution": "class StringInput:\n    \"\"\"Container for an input string and its length.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n        self.length = len(value)\nclass StringOutput:\n    \"\"\"Container for an output string and its length.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n        self.length = len(value)\nclass Character:\n    \"\"\"Represents a single character and provides case manipulation predicates.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n\n    def isAlphabetic(self) -> bool:\n        \"\"\"Checks if the character is alphabetic.\"\"\"\n        return self.value.isalpha()\n\n    def isUpper(self) -> bool:\n        \"\"\"Checks if the character is uppercase.\"\"\"\n        return self.value.isupper()\n\n    def isLower(self) -> bool:\n        \"\"\"Checks if the character is lowercase.\"\"\"\n        return self.value.islower()\n\n    def toggleCase(self) -> str:\n        \"\"\"Toggles the case of the character if it's alphabetic.\"\"\"\n        if self.isUpper():\n            return self.value.lower()\n        elif self.isLower():\n            return self.value.upper()\n        return self.value\nclass ToggleService:\n    \"\"\"Orchestrates the process of toggling character cases in a string.\"\"\"\n    def toggle_string(self, s: str) -> str:\n        \"\"\"Processes the input string to toggle character cases, preserving non-alphabetic characters.\"\"\"\n        input_model = StringInput(s)\n        result_chars = []\n        for char_val in input_model.value:\n            char_obj = Character(char_val)\n            if char_obj.isAlphabetic():\n                result_chars.append(char_obj.toggleCase())\n            else:\n                result_chars.append(char_val)\n        output_str = \"\".join(result_chars)\n        output_model = StringOutput(output_str)\n        return output_model.value\ndef toggle_string(s: str) -> str:\n    \"\"\"Toggles the case of all alphabetic characters in a string.\"\"\"\n    return ToggleService().toggle_string(s)"}
{"task_id": "Mbpp/562", "solution": "def Find_Max_Length(sublists):\n    \"\"\"Compute the maximum length among the provided sublists and return it as int.\n\n    Parameters:\n    - sublists: an outer sequence (e.g., list, tuple) whose elements are expected to be sequences (support len()).\n\n    Returns:\n    - int: the maximum length among sublists; returns 0 if the outer sequence is empty.\n\n    Exceptions/Errors:\n    - If an element in sublists does not support len(), Python's TypeError will be raised when calling len(element).\n    \"\"\"\n    max_len = 0\n    for element in sublists:\n        length = len(element)\n        if length > max_len:\n            max_len = length\n    return max_len"}
{"task_id": "Mbpp/558", "solution": "class Digit:\n    \"\"\"Value object representing a single decimal digit and its place position.\"\"\"\n    def __init__(self, position: int, value: int):\n        self.position = position # 0 == least significant digit\n        self.value = value\nclass IntegerNumber:\n    \"\"\"Encapsulates an integer input and provides get_digits() returning Digit objects.\"\"\"\n    def __init__(self, value: int):\n        # Design choice: get_digits operates on the absolute value for digit extraction.\n        self.value = abs(value)\n\n    def get_digits(self) -> list[Digit]:\n        \"\"\"Extracts decimal digits, returning a list of Digit objects (LSB first).\"\"\"\n        s = str(self.value)\n        digits = []\n        # Iterate in reverse to get LSB first with position 0\n        for i, char in enumerate(reversed(s)):\n            digits.append(Digit(position=i, value=int(char)))\n        return digits\nclass DigitPair:\n    \"\"\"Pairs two digit values and provides their absolute difference.\"\"\"\n    def __init__(self, digitA: int, digitB: int):\n        self.digitA = digitA\n        self.digitB = digitB\n\n    def abs_diff(self) -> int:\n        \"\"\"Returns the absolute difference between the two paired digits.\"\"\"\n        return abs(self.digitA - self.digitB)\nclass Result:\n    \"\"\"Simple container holding the final integer value.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\nclass DigitDistanceFunction:\n    \"\"\"Orchestrates the computation of the sum of per-digit differences.\"\"\"\n    def digit_distance_nums(self, a: int, b: int) -> int:\n        \"\"\"\n        Computes the sum of per-digit absolute differences between two integers.\n        Digits are aligned by place value (least-significant digits aligned) and shorter operands are zero-padded.\n        \"\"\"\n        int_num_a = IntegerNumber(a)\n        int_num_b = IntegerNumber(b)\n\n        digits_a_list = int_num_a.get_digits()\n        digits_b_list = int_num_b.get_digits()\n\n        # Convert lists of Digit objects to dictionaries for O(1) lookup by position\n        digit_map_a = {d.position: d.value for d in digits_a_list}\n        digit_map_b = {d.position: d.value for d in digits_b_list}\n\n        # Determine the maximum position to iterate through for alignment\n        max_pos_a = max(digit_map_a.keys()) if digit_map_a else -1\n        max_pos_b = max(digit_map_b.keys()) if digit_map_b else -1\n        max_overall_pos = max(max_pos_a, max_pos_b)\n\n        total_diff = 0\n        for pos in range(max_overall_pos + 1):\n            # Retrieve digit values, defaulting to 0 for zero-padding\n            digit_a_val = digit_map_a.get(pos, 0)\n            digit_b_val = digit_map_b.get(pos, 0)\n\n            pair = DigitPair(digit_a_val, digit_b_val)\n            total_diff += pair.abs_diff()\n\n        result = Result(total_diff)\n        return result.value\ndef digit_distance_nums(a: int, b: int) -> int:\n    \"\"\"\n    Finds the sum of the per-digit difference between two integers.\n    Digits are aligned by place value (least-significant digits aligned) and shorter operands are zero-padded.\n    \"\"\"\n    orchestrator = DigitDistanceFunction()\n    return orchestrator.digit_distance_nums(a, b)"}
{"task_id": "Mbpp/559", "solution": "def max_sub_array_sum(arr, n):\n    \"\"\"\n    Finds the sum of the largest contiguous sublist within the first n elements of arr.\n    Returns the largest single element if all considered elements are negative.\n    \"\"\"\n    max_so_far = arr[0]\n    current_max = arr[0]\n\n    for i in range(1, n):\n        current_max = max(arr[i], current_max + arr[i])\n        max_so_far = max(max_so_far, current_max)\n\n    return max_so_far"}
{"task_id": "Mbpp/560", "solution": "def _compute_union(tuple_a, tuple_b):\n    \"\"\"Computes the distinct elements from two tuples and returns them as a list.\"\"\"\n    return list(set(tuple_a) | set(tuple_b))\ndef _sort_elements(elements: list) -> list:\n    \"\"\"Sorts a list of elements in ascending order.\"\"\"\n    return sorted(elements)\ndef union_elements(tuple_a, tuple_b):\n    \"\"\"\n    Finds the union of elements of two given tuples and outputs them in sorted order.\n    \"\"\"\n    distinct_elements = _compute_union(tuple_a, tuple_b)\n    sorted_elements = _sort_elements(distinct_elements)\n    return tuple(sorted_elements)"}
{"task_id": "Mbpp/563", "solution": "from typing import List\nfrom dataclasses import dataclass\nclass Extractor:\n    def extract_values(self, input_str: str) -> List[str]:\n        \"\"\"\n        Public method to extract quoted values from a string.\n        It delegates to _scan_for_quotes and returns a list of strings.\n        \"\"\"\n        input_data = InputString(input_str, len(input_str))\n        quoted_values = self._scan_for_quotes(input_data.raw_text)\n        \n        output_list = OutputList(\n            values=[qv.value for qv in quoted_values],\n            count=len(quoted_values)\n        )\n        return output_list.values\n\n    def _scan_for_quotes(self, raw: str) -> List[QuotedValue]:\n        \"\"\"\n        Scans the raw string for pairs of double quotes and extracts the content.\n        Creates QuotedValue objects for each found value, preserving order.\n        \"\"\"\n        extracted_values: List[QuotedValue] = []\n        i = 0\n        order_index = 0\n        while i < len(raw):\n            if raw[i] == '\"':\n                start_quote_index = i\n                end_quote_index = -1\n                for j in range(i + 1, len(raw)):\n                    if raw[j] == '\"':\n                        end_quote_index = j\n                        break\n                \n                if end_quote_index != -1:\n                    value_content = raw[start_quote_index + 1:end_quote_index]\n                    extracted_values.append(\n                        QuotedValue(\n                            value=value_content,\n                            start_index=start_quote_index,\n                            end_index=end_quote_index,\n                            order_index=order_index\n                        )\n                    )\n                    order_index += 1\n                    i = end_quote_index + 1\n                else:\n                    # Unmatched opening quote, skip to the end\n                    break \n            else:\n                i += 1\n        return extracted_values\ndef extract_values(input_string: str) -> List[str]:\n    \"\"\"\n    Extracts values enclosed in double quotation marks from a string.\n    Delegates the extraction logic to an Extractor instance.\n    \"\"\"\n    extractor = Extractor()\n    return extractor.extract_values(input_string)"}
{"task_id": "Mbpp/564", "solution": "from typing import List, Dict\nclass IntegerList:\n    \"\"\"Represents the input list and provides prefix extraction.\"\"\"\n    def __init__(self, values: List[int]) -> None:\n        self._values = values\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the internal list.\"\"\"\n        return len(self._values)\n\n    def get_prefix(self, n: int) -> List[int]:\n        \"\"\"Returns the first n elements of the list.\"\"\"\n        return self._values[:n]\nclass PairCounter:\n    \"\"\"Encapsulates the algorithm to count unequal unordered pairs.\"\"\"\n    def count_Pairs(self, values: List[int], n: int) -> int:\n        \"\"\"Calculates the number of unequal unordered pairs within the first n elements.\"\"\"\n        integer_list = IntegerList(values)\n        \n        # Adjust n based on the actual length of the list, per design decision (truncation)\n        m = min(n, integer_list.length())\n\n        # If the effective number of elements is less than 2, no pairs can be formed.\n        if m < 2:\n            return 0\n\n        prefix = integer_list.get_prefix(m)\n        \n        freq_map = self._compute_frequencies(prefix)\n        total_pairs = self._compute_total_pairs(m)\n        equal_pairs = self._compute_equal_pairs(freq_map)\n        \n        unequal_pairs = total_pairs - equal_pairs\n        \n        return unequal_pairs\n\n    def _compute_frequencies(self, prefix: List[int]) -> Dict[int, int]:\n        \"\"\"Computes a frequency map for the given list prefix.\"\"\"\n        frequencies = {}\n        for x in prefix:\n            frequencies[x] = frequencies.get(x, 0) + 1\n        return frequencies\n\n    def _compute_total_pairs(self, n_prefix: int) -> int:\n        \"\"\"Computes the total possible pairs for n_prefix elements.\"\"\"\n        if n_prefix < 2:\n            return 0\n        return n_prefix * (n_prefix - 1) // 2\n\n    def _compute_equal_pairs(self, freq_map: Dict[int, int]) -> int:\n        \"\"\"Computes pairs where elements are equal based on frequencies.\"\"\"\n        equal_pairs_count = 0\n        for freq in freq_map.values():\n            if freq >= 2:\n                equal_pairs_count += freq * (freq - 1) // 2\n        return equal_pairs_count\ndef count_Pairs(values: List[int], n: int) -> int:\n    \"\"\"\n    Counts the number of possible unordered pairs where both elements are unequal.\n    It considers the first n elements of the input list.\n    \"\"\"\n    # FR3: Return 0 when n < 2\n    if n < 2:\n        return 0\n\n    # Delegate computation to PairCounter as per design\n    pair_counter = PairCounter()\n    return pair_counter.count_Pairs(values, n)"}
