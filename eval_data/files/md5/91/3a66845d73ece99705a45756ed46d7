{"task_id": "Mbpp/310", "solution": "def string_to_tuple(input: str) -> tuple:\n    \"\"\"\n    Converts a string to a tuple of its non-whitespace characters, preserving order.\n    Raises TypeError if the input is not a string.\n    \"\"\"\n    def validate_input(value):\n        \"\"\"Raises TypeError if input is not a string.\"\"\"\n        if not isinstance(value, str):\n            raise TypeError(\"Input must be a string.\")\n\n    def is_whitespace_char(char: str) -> bool:\n        \"\"\"Returns True if the character is considered whitespace.\"\"\"\n        return char.isspace()\n\n    def filter_spaces(s: str) -> str:\n        \"\"\"Returns a new string with whitespace characters removed.\"\"\"\n        return \"\".join(char for char in s if not is_whitespace_char(char))\n\n    def to_tuple(s: str) -> tuple:\n        \"\"\"Converts a string into a tuple of its characters.\"\"\"\n        return tuple(s)\n\n    validate_input(input)\n    filtered_string = filter_spaces(input)\n    return to_tuple(filtered_string)"}
{"task_id": "Mbpp/308", "solution": "from typing import List, Sequence\nimport numbers\ndef _is_numeric_sequence(seq: Sequence) -> bool:\n    \"\"\"Return True if seq is a sequence and every element is an instance of numbers.Number.\"\"\"\n    if not isinstance(seq, Sequence):\n        return False\n    return all(isinstance(x, numbers.Number) for x in seq)\nclass InputList:\n    def __init__(self, elements: Sequence[numbers.Number]) -> None:\n        self.elements = elements\n\n    def length(self) -> int:\n        return len(self.elements)\nclass ProductPair:\n    def __init__(self, a: numbers.Number, b: numbers.Number) -> None:\n        self.a = a\n        self.b = b\n\n    def product(self) -> numbers.Number:\n        return self.a * self.b\nclass ResultSet:\n    def __init__(self, products: List[numbers.Number] = None) -> None:\n        self.products = products if products is not None else []\n\n    def count(self) -> int:\n        return len(self.products)\n\n    def sorted_desc(self) -> None:\n        \"\"\"Sorts the products list in descending order in-place.\"\"\"\n        self.products.sort(reverse=True)\nclass LargeProductFunction:\n    def __init__(self, list1: Sequence[numbers.Number], list2: Sequence[numbers.Number], k: int) -> None:\n        self.input_list1 = InputList(list1)\n        self.input_list2 = InputList(list2)\n        self.k = k\n\n    def compute(self) -> List[numbers.Number]:\n        \"\"\"Computes pairwise products, sorts, and selects the top k.\"\"\"\n        if self.k <= 0:\n            return []\n\n        result_set = ResultSet()\n        for a in self.input_list1.elements:\n            for b in self.input_list2.elements:\n                product_pair = ProductPair(a, b)\n                product_value = product_pair.product()\n                result_set.products.append(product_value)\n\n        result_set.sorted_desc()\n        return result_set.products[:self.k]\ndef large_product(list1: Sequence[numbers.Number], list2: Sequence[numbers.Number], k: int) -> List[numbers.Number]:\n    \"\"\"\n    Finds the specified number of largest products from two lists, selecting one factor from each.\n    \"\"\"\n    if k <= 0:\n        return []\n\n    if not _is_numeric_sequence(list1) or not _is_numeric_sequence(list2):\n        raise ValueError(\"list1 and list2 must be sequences of numeric values\")\n\n    lpf = LargeProductFunction(list1, list2, k)\n    return lpf.compute()"}
{"task_id": "Mbpp/311", "solution": "from typing import Optional\nclass IntegerValue:\n    \"\"\"Lightweight wrapper for validated input integer.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\nclass BinaryRepresentation:\n    \"\"\"Encapsulates conversion, scanning, mutation, and conversion back to integer.\"\"\"\n    def __init__(self, n: int) -> None:\n        # Binary string without leading zeros; '0' for n==0.\n        if n == 0:\n            self.bits = '0'\n        else:\n            self.bits = bin(n)[2:]\n        self.length = len(self.bits)\n\n    def msb_index(self) -> int:\n        \"\"\"Returns the index of the most significant bit (leftmost = 0).\"\"\"\n        return 0\n\n    def find_left_most_unset_index(self) -> Optional[int]:\n        \"\"\"Scans bits from left to right for the first '0', returning its index or None.\"\"\"\n        for i, bit in enumerate(self.bits):\n            if bit == '0':\n                return i\n        return None\n\n    def set_bit_at(self, index: int) -> None:\n        \"\"\"Sets the bit at the given 0-based-from-left index to '1'.\"\"\"\n        self.bits = self.bits[:index] + '1' + self.bits[index+1:]\n        \n    def extend_with_new_msb(self) -> None:\n        \"\"\"Prefixes '1' to the bits (used when all bits are '1').\"\"\"\n        self.bits = '1' + self.bits\n        self.length += 1\n\n    def to_int(self) -> int:\n        \"\"\"Converts the binary string representation back to an integer.\"\"\"\n        return int(self.bits, 2)\ndef set_left_most_unset_bit(n: int) -> int:\n    \"\"\"Sets the left-most unset bit in the binary representation of n and returns the new integer.\"\"\"\n    iv = IntegerValue(n)\n    br = BinaryRepresentation(iv.value)\n    idx = br.find_left_most_unset_index()\n\n    if idx is None:\n        br.extend_with_new_msb()\n    else:\n        br.set_bit_at(idx)\n\n    result_int = br.to_int()\n    return result_int"}
{"task_id": "Mbpp/389", "solution": "class InputValidator:\n    \"\"\"Provides methods to validate input parameters.\"\"\"\n    @staticmethod\n    def validate_non_negative_integer(n: any) -> bool:\n        \"\"\"Checks if n is a non-negative integer.\"\"\"\n        return isinstance(n, int) and n >= 0\nclass LucasCalculator:\n    \"\"\"Calculates Lucas numbers based on base cases and recurrence.\"\"\"\n    def find_lucas(self, n: int) -> int:\n        \"\"\"\n        Computes the n-th Lucas number iteratively.\n        L0 = 2, L1 = 1, Ln = L_{n-1} + L_{n-2} for n >= 2.\n        \"\"\"\n        if n == 0:\n            return 2\n        elif n == 1:\n            return 1\n        else:\n            a, b = 2, 1  # L0, L1\n            for _ in range(2, n + 1):\n                a, b = b, a + b\n            return b\ndef find_lucas(n: int) -> int:\n    \"\"\"\n    Finds the n'th Lucas number.\n    L0 = 2, L1 = 1, Ln = L_{n-1} + L_{n-2} for n >= 2.\n    \"\"\"\n    if not InputValidator.validate_non_negative_integer(n):\n        raise ValueError(\"Input 'n' must be a non-negative integer.\")\n\n    calculator = LucasCalculator()\n    return calculator.find_lucas(n)"}
{"task_id": "Mbpp/388", "solution": "def highest_Power_of_2(n: int) -> int:\n    \"\"\"\n    Finds the highest power of 2 that is less than or equal to n.\n    Assumes n is a positive integer (n >= 1).\n    \"\"\"\n    power = 1\n    # Repeatedly left-shift 'power' (multiply by 2) until it would exceed 'n'.\n    while (power << 1) <= n:\n        power <<= 1\n    return power"}
