{"task_id": "Mbpp/641", "solution": "class InvalidInputError(Exception):\n    \"\"\"Exception raised for invalid input values.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\nclass InputValidator:\n    \"\"\"Validates input 'n' to ensure it's a positive integer.\"\"\"\n    @staticmethod\n    def validate(n: int) -> None:\n        if not isinstance(n, int):\n            raise InvalidInputError(\"Input must be an integer.\")\n        if n <= 0:\n            raise InvalidInputError(\"Input must be a positive integer (n > 0).\")\nclass NonagonalCalculator:\n    \"\"\"Computes the nth nonagonal number using the specified formula.\"\"\"\n    @staticmethod\n    def compute(n: int) -> int:\n        # Formula for the nth nonagonal number: n * (7 * n - 5) // 2\n        return n * (7 * n - 5) // 2\ndef is_nonagonal(n: int) -> int:\n    \"\"\"\n    Calculates the nth nonagonal number.\n\n    This function validates the input and computes the nonagonal number.\n    \"\"\"\n    InputValidator.validate(n)\n    return NonagonalCalculator.compute(n)"}
{"task_id": "Mbpp/639", "solution": "from typing import List\nclass Name:\n    \"\"\"Encapsulates a name string and provides utility methods for its properties.\"\"\"\n    def __init__(self, value: str) -> None:\n        self.value = value\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the name.\"\"\"\n        return len(self.value)\n\n    def startsWithLowercase(self) -> bool:\n        \"\"\"Checks if the name starts with a lowercase alphabetic character.\"\"\"\n        if not self.value:\n            return False\n        first_char = self.value[0]\n        return 'a' <= first_char <= 'z'\nclass NameList:\n    \"\"\"Manages a collection of Name objects for filtering and aggregation.\"\"\"\n    def __init__(self, names: List[Name]) -> None:\n        self.names = names\n\n    def filterOutLowercaseStart(self) -> List[Name]:\n        \"\"\"Returns a new list of Name instances that do not start with a lowercase letter.\"\"\"\n        return [n for n in self.names if not n.startsWithLowercase()]\n\n    def totalLength(self, filtered: List[Name]) -> int:\n        \"\"\"Calculates the sum of lengths of names in the provided filtered list.\"\"\"\n        return sum(n.length() for n in filtered)\nclass SampleNamFunction:\n    \"\"\"Orchestrates the filtering and summing logic for a list of names.\"\"\"\n    def sample_nam(self, list_of_names: List[str]) -> int:\n        \"\"\"\n        Converts a list of name strings into Name objects, filters them,\n        and sums the lengths of the remaining names.\n        \"\"\"\n        name_objects = [Name(name_str) for name_str in list_of_names]\n        name_list_instance = NameList(name_objects)\n        \n        filtered_names = name_list_instance.filterOutLowercaseStart()\n        total_sum = name_list_instance.totalLength(filtered_names)\n        \n        return total_sum\ndef sample_nam(list_of_names: List[str]) -> int:\n    \"\"\"\n    Sums the length of names from a list after removing those starting with a lowercase letter.\n    \"\"\"\n    return SampleNamFunction().sample_nam(list_of_names)"}
{"task_id": "Mbpp/643", "solution": "PUNCTUATION_CHARS = \".,;:!?()\\\"'\"\nclass Word:\n    \"\"\"Represents a token after trimming punctuation.\"\"\"\n    def __init__(self, text: str):\n        self.text = text\n\n    def isEmpty(self) -> bool:\n        \"\"\"Checks if the word's text is empty.\"\"\"\n        return self.text == \"\"\nclass Tokenizer:\n    \"\"\"Tokenizes raw input strings into Word tokens, stripping punctuation.\"\"\"\n    def tokenize(self, text: str) -> list[Word]:\n        words = []\n        for token_str in text.split():\n            trimmed_token = token_str.strip(PUNCTUATION_CHARS)\n            if trimmed_token:\n                words.append(Word(trimmed_token))\n        return words\nclass Matcher:\n    \"\"\"Checks whether a Word contains an internal 'z'.\"\"\"\n    def hasZInMiddle(self, word: Word) -> bool:\n        \"\"\"\n        Returns True if 'z' in word.text has a character before and after it.\n        Matches lowercase 'z' only.\n        \"\"\"\n        word_text = word.text\n        if len(word_text) < 3:\n            return False\n\n        for i in range(1, len(word_text) - 1):\n            if word_text[i] == 'z':\n                return True\n        return False\ndef text_match_wordz_middle(text: str) -> bool:\n    \"\"\"\n    Checks if the input text contains 'z' with at least one character immediately\n    before and after it, within any trimmed token.\n    \"\"\"\n    tokenizer = Tokenizer()\n    matcher = Matcher()\n\n    words = tokenizer.tokenize(text)\n\n    for word in words:\n        if matcher.hasZInMiddle(word):\n            return True\n    return False"}
{"task_id": "Mbpp/644", "solution": "def reverse_Array_Upto_K(array, k):\n    \"\"\"Return a list where the first k elements of 'array' are reversed.\n\n    Raises:\n        TypeError: if array is not a list or k is not an int\n        ValueError: if k < 0 or k > len(array)\n    \"\"\"\n    if not isinstance(array, list) or not isinstance(k, int):\n        raise TypeError(\"array must be a list and k must be an int\")\n    n = len(array)\n    if k < 0 or k > n:\n        raise ValueError(\"k must be between 0 and len(array)\")\n    if k == 0:\n        return list(array)\n    \n    head = array[:k][::-1]\n    tail = array[k:]\n    return head + tail"}
{"task_id": "Mbpp/720", "solution": "def add_dict_to_tuple(tuple_input, dict_input) -> tuple:\n    \"\"\"Validate input types and return a new tuple containing tuple_input's elements followed by dict_input as one single element.\n\n    Raises:\n        TypeError: if tuple_input is not a tuple or dict_input is not a dict.\n    \"\"\"\n    if not isinstance(tuple_input, tuple):\n        raise TypeError('first argument must be a tuple')\n    if not isinstance(dict_input, dict):\n        raise TypeError('second argument must be a dict')\n    return tuple_input + (dict_input,)"}
{"task_id": "Mbpp/721", "solution": "import dataclasses\nimport typing\nnumber = typing.Union[int, float]\nclass Validator:\n    \"\"\"Validates input matrix properties.\"\"\"\n    def isValid(self, matrix_data: typing.Any) -> bool:\n        \"\"\"Checks if the input is a non-empty square matrix with numeric elements.\"\"\"\n        if not isinstance(matrix_data, list) or not matrix_data:\n            raise ValueError(\"Invalid matrix: Must be a non-empty list of lists.\")\n\n        N = len(matrix_data)\n        for i, row in enumerate(matrix_data):\n            if not isinstance(row, list):\n                raise ValueError(f\"Invalid matrix: Row {i} is not a list.\")\n            if len(row) != N:\n                raise ValueError(f\"Invalid matrix: Row {i} has length {len(row)}, expected {N} for a square matrix.\")\n            for j, element in enumerate(row):\n                if not isinstance(element, (int, float)):\n                    raise ValueError(f\"Invalid matrix: Element at ({i},{j}) is {type(element)}, expected numeric.\")\n        return True\ndef is_valid_matrix(matrix_data: typing.Any) -> bool:\n    \"\"\"Convenience wrapper for Validator.isValid.\"\"\"\n    return Validator().isValid(matrix_data)\nclass PathFinder:\n    \"\"\"Finds all valid right/down paths from top-left to bottom-right.\"\"\"\n    def enumeratePaths(self, matrix_data: typing.List[typing.List[number]]) -> typing.List[Path]:\n        \"\"\"Generates all possible paths from (0,0) to (N-1,N-1) moving only right or down.\"\"\"\n        N = len(matrix_data)\n        all_paths: typing.List[Path] = []\n        \n        def _find_paths_dfs(r: int, c: int, current_path_cells: typing.List[Cell]):\n            # Base case: Reached the bottom-right cell\n            if r == N - 1 and c == N - 1:\n                all_paths.append(Path(list(current_path_cells)))\n                return\n\n            # Move Down\n            if r + 1 < N:\n                cell_down = Cell(r + 1, c, matrix_data[r + 1][c])\n                current_path_cells.append(cell_down)\n                _find_paths_dfs(r + 1, c, current_path_cells)\n                current_path_cells.pop() # Backtrack\n\n            # Move Right\n            if c + 1 < N:\n                cell_right = Cell(r, c + 1, matrix_data[r][c + 1])\n                current_path_cells.append(cell_right)\n                _find_paths_dfs(r, c + 1, current_path_cells)\n                current_path_cells.pop() # Backtrack\n\n        # Start DFS from (0,0) with the initial cell.\n        _find_paths_dfs(0, 0, [Cell(0, 0, matrix_data[0][0])])\n        return all_paths\ndef enumerate_paths(matrix_data: typing.List[typing.List[number]]) -> typing.List[Path]:\n    \"\"\"Convenience wrapper for PathFinder.enumeratePaths.\"\"\"\n    return PathFinder().enumeratePaths(matrix_data)\nclass Calculator:\n    \"\"\"Calculates the maximum average path from a list of paths.\"\"\"\n    def maxAverage(self, paths: typing.List[Path]) -> float:\n        \"\"\"Computes the maximum average path cost from a list of paths.\"\"\"\n        if not paths:\n            raise ValueError(\"No paths provided to calculate maximum average.\")\n        \n        max_avg = -float('inf')\n        for path in paths:\n            max_avg = max(max_avg, path.average())\n        return max_avg\ndef max_average_from_paths(paths: typing.List[Path]) -> float:\n    \"\"\"Convenience wrapper for Calculator.maxAverage.\"\"\"\n    return Calculator().maxAverage(paths)\ndef maxAverageOfPath(matrix: typing.List[typing.List[number]]) -> float:\n    \"\"\"\n    Given a square matrix, finds a path from top-left to bottom-right moving only right or down,\n    that has the maximum average cost.\n    \"\"\"\n    # Validate the input matrix as per design.\n    is_valid_matrix(matrix)\n\n    # Enumerate all possible paths from (0,0) to (N-1,N-1).\n    paths = enumerate_paths(matrix)\n\n    # Calculate the maximum average among all found paths.\n    max_avg = max_average_from_paths(paths)\n\n    return max_avg"}
