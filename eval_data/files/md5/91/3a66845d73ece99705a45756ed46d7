{"task_id": "Mbpp/69", "solution": "def is_sublist(main_list, sub_list) -> bool:\n    \"\"\"Checks if a list contains the given sublist as a contiguous subsequence.\n    Returns True if found, False otherwise.\"\"\"\n    len_main = len(main_list)\n    len_sub = len(sub_list)\n\n    if len_sub > len_main:\n        return False\n\n    if len_sub == 0:\n        return True # An empty sublist is considered present in any list.\n\n    for i in range(len_main - len_sub + 1):\n        if main_list[i : i + len_sub] == sub_list:\n            return True\n            \n    return False"}
{"task_id": "Mbpp/70", "solution": "from typing import List, Tuple, Any\ndef get_equal(tuples: List[Tuple]) -> bool:\n    \"\"\"Return True if all tuples in the provided list have equal length, else False.\n    This includes cases where the list is empty or contains a single tuple.\n    \"\"\"\n    if not tuples:\n        return True\n    it = iter(tuples)\n    try:\n        first_len = len(next(it))\n    except StopIteration:\n        # empty handled above; defensive coding\n        return True\n    for t in it:\n        if len(t) != first_len:\n            return False\n    return True"}
