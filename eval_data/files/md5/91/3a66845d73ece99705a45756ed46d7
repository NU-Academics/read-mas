{"task_id": "Mbpp/98", "solution": "import math\nclass Validator:\n    def validateSequence(self, sequence) -> bool:\n        \"\"\"\n        Validates the sequence type and non-emptiness.\n        Raises TypeError if not list/tuple, ValueError if empty.\n        \"\"\"\n        if not isinstance(sequence, (list, tuple)):\n            raise TypeError(\"Input must be a list or tuple.\")\n        if not sequence:\n            raise ValueError(\"Input sequence cannot be empty.\")\n        self.validateElements(sequence)\n        return True\n\n    def validateElements(self, elements) -> bool:\n        \"\"\"\n        Validates that all elements in the sequence are numeric (int or float).\n        Raises TypeError if any element is non-numeric.\n        \"\"\"\n        for element in elements:\n            if not isinstance(element, (int, float)):\n                raise TypeError(\"All elements in the sequence must be numeric (int or float).\")\n        return True\ndef computeProduct(sequence) -> float:\n    \"\"\"\n    Computes the product of all numeric elements in the sequence.\n    \"\"\"\n    product = 1.0\n    for e in sequence:\n        product *= float(e)\n    return product\ndef divideByLength(product, length) -> float:\n    \"\"\"\n    Divides the given product by the given length.\n    \"\"\"\n    return float(product) / float(length)\ndef multiply_num(sequence) -> float:\n    \"\"\"\n    Multiplies all numbers in a sequence and divides by its length.\n    \"\"\"\n    validator = Validator()\n    validator.validateSequence(sequence)\n\n    product = computeProduct(sequence)\n    result = divideByLength(product, len(sequence))\n    return result"}
{"task_id": "Mbpp/105", "solution": "def count(input_list):\n    \"\"\"Count boolean True values in input_list and return an int.\n\n    Counts only elements that are strictly boolean True (element is True).\n    \"\"\"\n    counter = 0\n    for element in input_list:\n        if element is True:\n            counter += 1\n    return counter"}
{"task_id": "Mbpp/102", "solution": "from typing import List\nclass InputString:\n    def __init__(self, value: str):\n        self.value = value\nclass Word:\n    def __init__(self, text: str, position: int):\n        self.text = text\n        self.position = position\nclass OutputString:\n    def __init__(self, value: str):\n        self.value = value\ndef _split_on_underscore(input_str: str) -> List[str]:\n    \"\"\"Splits the input string on '_' and returns a list of tokens.\"\"\"\n    return input_str.split('_')\ndef _capitalize_first_letter(word: str) -> str:\n    \"\"\"Uppercases the first character of a word and preserves the remaining characters.\"\"\"\n    if not word:\n        return \"\"\n    return word[0].upper() + word[1:]\ndef snake_to_camel(input: str) -> str:\n    \"\"\"\n    Accepts a single string argument and returns the CamelCase (PascalCase) string.\n    Example: snake_to_camel('python_program') -> 'PythonProgram'\n    \"\"\"\n    input_obj = InputString(input)\n    \n    tokens = _split_on_underscore(input_obj.value)\n    \n    word_objects: List[Word] = [Word(text, i) for i, text in enumerate(tokens)]\n    \n    camel_case_words = []\n    for word_obj in word_objects:\n        camel_case_words.append(_capitalize_first_letter(word_obj.text))\n        \n    result_str = \"\".join(camel_case_words)\n    \n    output_obj = OutputString(result_str)\n    \n    return output_obj.value"}
{"task_id": "Mbpp/101", "solution": "def kth_element(array, k):\n    \"\"\"Return the k-th element (1-based) from the provided array/list.\"\"\"\n    # Convert 1-based index k to 0-based index (k-1)\n    return array[k - 1]"}
{"task_id": "Mbpp/99", "solution": "def decimal_to_binary(value: int) -> str:\n    \"\"\"\n    Converts a non-negative decimal integer to its binary equivalent as a string.\n    The string has no leading zeros unless the input is 0, in which case it returns '0'.\n    \"\"\"\n    if value == 0:\n        return '0'\n\n    binary_digits = []\n    current_value = value\n    while current_value > 0:\n        remainder = current_value % 2\n        binary_digits.append(str(remainder))\n        current_value //= 2\n\n    # The digits are collected in reverse order (least significant first).\n    # Reverse the list and join to form the canonical binary string.\n    binary_digits.reverse()\n    return \"\".join(binary_digits)"}
{"task_id": "Mbpp/106", "solution": "def add_lists(list_input, tuple_input):\n    \"\"\"\n    Appends elements from a list to a tuple, returning a new tuple.\n    The order is tuple elements first, then list elements.\n    \"\"\"\n    return tuple_input + tuple(list_input)"}
{"task_id": "Mbpp/100", "solution": "class ValidationError(Exception):\n    def __init__(self, message: str) -> None:\n        self.message = message\ndef isPalindrome(candidate: int) -> bool:\n    \"\"\"Checks if an integer is a palindrome.\"\"\"\n    s = str(candidate)\n    return s == s[::-1]\ndef compute(input: int) -> int:\n    \"\"\"Finds the next smallest palindrome by incrementing and checking.\"\"\"\n    candidate = input + 1\n    while not isPalindrome(candidate):\n        candidate += 1\n    return candidate\ndef next_smallest_palindrome(input) -> int:\n    \"\"\"Finds the next smallest palindrome of a specified integer.\"\"\"\n    if not isinstance(input, int):\n        raise ValidationError(\"input must be an integer\")\n    \n    return compute(input)"}
{"task_id": "Mbpp/104", "solution": "from typing import List\ndef sort_sublists(sequence) -> List[List[str]]:\n    \"\"\"Validate input and return a new list of lists of strings where each inner list is sorted lexicographically.\n\n    Args:\n        sequence: A Python list or tuple whose elements are lists of str.\n\n    Returns:\n        List[List[str]]: a new Python list of sorted sublists.\n\n    Raises:\n        TypeError: If sequence is not a list or tuple.\n        ValueError: If any inner element is not a list or any inner element is not a str.\n    \"\"\"\n    validate_input(sequence)\n    # Build and return a new list of sorted inner lists (preserve outer order).\n    return [sorted(list(inner)) for inner in sequence]"}
{"task_id": "Mbpp/103", "solution": "class EulerianError(Exception):\n    \"\"\"Custom exception for Eulerian number errors.\"\"\"\n    def __init__(self, message: str, code: int):\n        super().__init__(message)\n        self.message = message\n        self.code = code\nclass InputParameters:\n    \"\"\"Data holder for input parameters n and m.\"\"\"\n    def __init__(self, n: int, m: int):\n        self.n = n\n        self.m = m\nclass Validator:\n    \"\"\"Validates InputParameters for Eulerian number computation.\"\"\"\n    def __init__(self):\n        self._error_message = \"\"\n\n    @property\n    def errorMessage(self) -> str:\n        \"\"\"Returns the error message if validation failed.\"\"\"\n        return self._error_message\n\n    def isValid(self, params: InputParameters) -> bool:\n        \"\"\"\n        Checks if the input parameters n and m are valid for Eulerian number computation.\n        Enforces integer types, non-negativity, and 0 <= m < n.\n        \"\"\"\n        n, m = params.n, params.m\n\n        if not isinstance(n, int) or not isinstance(m, int):\n            self._error_message = \"Inputs n and m must be integers.\"\n            return False\n        if n < 0 or m < 0:\n            self._error_message = \"Inputs n and m must be non-negative.\"\n            return False\n        # The design explicitly states to \"enforce 0 <= m < n\".\n        if not (m < n):\n            self._error_message = \"Input m must be less than n (i.e., 0 <= m < n).\"\n            return False\n\n        self._error_message = \"\" # Clear error message if valid\n        return True\nclass EulerianFunction:\n    \"\"\"Computes Eulerian numbers using dynamic programming with memoization.\"\"\"\n    def __init__(self):\n        # Cache to store computed Eulerian numbers A(n, m).\n        self._cache = {}\n\n    def compute(self, n: int, m: int) -> int:\n        \"\"\"\n        Computes the Eulerian number A(n, m) using recurrence and memoization.\n        Assumes inputs n, m are valid (integers, non-negative, and m < n, so n >= 1).\n        \"\"\"\n        # Handle cases where recursive calls might go out of bounds for m\n        if m < 0 or m >= n:\n            return 0\n        \n        if (n, m) in self._cache:\n            return self._cache[(n, m)]\n\n        # Base cases for n >= 1 (as per validator, n cannot be 0 here):\n        if m == 0: # A(n, 0) = 1 for n >= 1\n            result = 1\n        elif m == n - 1: # A(n, n-1) = 1 for n >= 1\n            result = 1\n        else:\n            # Recurrence relation: A(n, m) = (m + 1) * A(n - 1, m) + (n - m) * A(n - 1, m - 1)\n            val1 = self.compute(n - 1, m)\n            val2 = self.compute(n - 1, m - 1)\n            result = (m + 1) * val1 + (n - m) * val2\n\n        self._cache[(n, m)] = result\n        return result\ndef eulerian_num(n, m) -> int:\n    \"\"\"\n    Computes the Eulerian number a(n, m) for given non-negative integers n and m.\n    Validates inputs and raises EulerianError for invalid inputs, otherwise returns the computed integer value.\n    \"\"\"\n    params = InputParameters(n=n, m=m)\n    v = Validator()\n    if not v.isValid(params):\n        raise EulerianError(message=v.errorMessage, code=400)\n    \n    # Input is guaranteed to be n >= 1 and 0 <= m < n after validation.\n    calc = EulerianFunction()\n    result_int = calc.compute(n, m)\n    return result_int"}
