{"task_id": "Mbpp/589", "solution": "from typing import List\nimport math\ndef _compute_integer_roots(start: int, end: int) -> List[int]:\n    \"\"\"Computes perfect squares within the inclusive range [start, end].\"\"\"\n    if end < 0:\n        return []\n\n    # Calculate the smallest integer 'n' whose square is >= start (or 0 if start is negative)\n    n_start = math.ceil(math.sqrt(max(0, start)))\n    # Calculate the largest integer 'n' whose square is <= end\n    n_end = math.floor(math.sqrt(end))\n\n    perfect_squares_list = []\n    for n in range(int(n_start), int(n_end) + 1):\n        square = n * n\n        if start <= square <= end: # Ensure square is within the original range, mainly for edge cases with floor/ceil\n            perfect_squares_list.append(square)\n            \n    return perfect_squares_list\ndef perfect_squares(start: int, end: int) -> List[int]:\n    \"\"\"\n    Finds perfect squares between two given numbers, inclusive.\n    Returns a list of perfect squares in ascending order.\n    \"\"\"\n    _validate_inputs(start, end)\n    return _compute_integer_roots(start, end)"}
{"task_id": "Mbpp/591", "solution": "def swap_List(input_list):\n    \"\"\"Return a Python list; first and last elements swapped when len(input_list) >= 2.\n\n    Parameters:\n      input_list: list -- required\n    Returns:\n      list\n    \"\"\"\n    if len(input_list) < 2:\n        return input_list\n    else:\n        first = input_list[0]\n        middle = input_list[1:-1]\n        last = input_list[-1]\n        return [last] + list(middle) + [first]"}
{"task_id": "Mbpp/592", "solution": "class BinomialCoefficient:\n    \"\"\"Provides static methods for binomial coefficient calculation.\"\"\"\n\n    @staticmethod\n    def _factorial(num: int) -> int:\n        \"\"\"Calculates the factorial of a non-negative integer.\"\"\"\n        res = 1\n        for i in range(1, num + 1):\n            res *= i\n        return res\n\n    @staticmethod\n    def choose(n: int, k: int) -> int:\n        \"\"\"Calculates the binomial coefficient C(n, k).\"\"\"\n        if k < 0 or k > n:\n            return 0\n        if k == 0 or k == n:\n            return 1\n        if k > n // 2:  # Optimization: C(n, k) = C(n, n-k)\n            k = n - k\n\n        numerator = 1\n        for i in range(k):\n            numerator *= (n - i)\n\n        denominator = BinomialCoefficient._factorial(k)\n        \n        # Integer division is guaranteed as binomial coefficients are always integers.\n        return numerator // denominator\nclass SumOfProductFunction:\n    \"\"\"Encapsulates the computation of the sum of products of consecutive binomial coefficients.\"\"\"\n\n    def compute(self, n: int) -> int:\n        \"\"\"Computes S = sum_{k=0}^{n-1} C(n,k) * C(n,k+1).\"\"\"\n        if n == 0:\n            return 0\n        \n        total_sum = 0\n        # The sum runs from k=0 to n-1\n        for k in range(n): \n            term1 = BinomialCoefficient.choose(n, k)\n            term2 = BinomialCoefficient.choose(n, k + 1)\n            total_sum += term1 * term2\n        return total_sum\n    \n    def sumOfProduct(self, n: int) -> int:\n        \"\"\"Alias for compute(n), calculates the sum of products.\"\"\"\n        return self.compute(n)\ndef sum_Of_product(n: int) -> int:\n    \"\"\"\n    Finds the sum of the product of consecutive binomial coefficients.\n    S = sum_{k=0}^{n-1} C(n,k) * C(n,k+1).\n    \"\"\"\n    calculator = SumOfProductFunction()\n    return calculator.compute(n)"}
{"task_id": "Mbpp/593", "solution": "class Octet:\n    \"\"\"Encapsulates an IP octet's raw value and provides normalization.\"\"\"\n    def __init__(self, raw_value: str, position: int):\n        self.raw_value = raw_value\n        self.position = position\n\n    def normalized_value(self) -> str:\n        \"\"\"Removes leading zeros from the octet's raw value, preserving '0' itself.\"\"\"\n        return str(int(self.raw_value))\nclass IPAddress:\n    \"\"\"Represents an IP address, handling parsing into octets.\"\"\"\n    def __init__(self, raw: str):\n        self.raw = raw\n        self.normalized: str = \"\"\n\n    def parse(self) -> list[\"Octet\"]:\n        \"\"\"Splits the raw IP string into four Octet instances.\"\"\"\n        octet_strings = self.raw.split('.')\n        octets = []\n        for i, octet_str in enumerate(octet_strings):\n            octets.append(Octet(octet_str, i))\n        return octets\nclass RemoveZeroIP:\n    \"\"\"Orchestrates the process of parsing, normalizing, and assembling an IP address.\"\"\"\n    def removezero_ip(self, raw: str) -> str:\n        \"\"\"Normalizes an IPv4 address by removing leading zeros from each octet.\"\"\"\n        ip = IPAddress(raw)\n        octet_objects = ip.parse()\n\n        normalized_octet_values = []\n        for octet in octet_objects:\n            normalized_octet_values.append(octet.normalized_value())\n\n        ip.normalized = '.'.join(normalized_octet_values)\n        return ip.normalized\ndef removezero_ip(raw: str) -> str:\n    \"\"\"Removes leading zeroes from an ip address.\"\"\"\n    orchestrator = RemoveZeroIP()\n    return orchestrator.removezero_ip(raw)"}
{"task_id": "Mbpp/590", "solution": "from math import cos, sin\nfrom typing import Tuple\nclass NumericType:\n    \"\"\"Provides numeric type metadata (precision) as a static/documentation artifact.\"\"\"\n    def __init__(self, precision: float = 1e-12) -> None:\n        self.precision = precision\nclass RectangularCoordinate(NumericType):\n    \"\"\"Represents rectangular coordinates (x, y) and provides native complex representation.\"\"\"\n    def __init__(self, x: float, y: float) -> None:\n        super().__init__()\n        self.x = x\n        self.y = y\n\n    @property\n    def value(self) -> complex:\n        \"\"\"Computes and returns the complex representation (x + yj).\"\"\"\n        return complex(self.x, self.y)\ndef _validate_numeric(value) -> float:\n    \"\"\"Return float(value) if value is int or float else raise TypeError.\"\"\"\n    if isinstance(value, (int, float)):\n        return float(value)\n    else:\n        raise TypeError(\"Input must be a numeric type (int or float).\")\ndef polar_rect(r, theta) -> Tuple[Tuple[float, float], complex]:\n    \"\"\"\n    Validate inputs numerically, coerce to float, compute x = r*cos(theta), y = r*sin(theta),\n    and return ((float(r), float(theta)), complex(x, y)).\n    \"\"\"\n    validated_r = _validate_numeric(r)\n    validated_theta = _validate_numeric(theta)\n\n    # Compute rectangular coordinates\n    x = validated_r * cos(validated_theta)\n    y = validated_r * sin(validated_theta)\n\n    # Instantiate RectangularCoordinate to get the complex value\n    rect_coord = RectangularCoordinate(x, y)\n\n    # Return the specified 2-element tuple: ((original r as float, original theta as float), complex value)\n    return ((validated_r, validated_theta), rect_coord.value)"}
{"task_id": "Mbpp/596", "solution": "import sys\ndef validate_input(t) -> bool:\n    \"\"\"Return True if t is a tuple; otherwise raise TypeError(\"tuple_size: input must be a tuple\").\"\"\"\n    if not isinstance(t, tuple):\n        raise TypeError(\"tuple_size: input must be a tuple\")\n    return True\ndef tuple_size(t: tuple) -> int:\n    \"\"\"Return the size in bytes of tuple t equal to sys.getsizeof(t) in the runtime.\"\"\"\n    validate_input(t)\n    size = sys.getsizeof(t)\n    return int(size)"}
{"task_id": "Mbpp/594", "solution": "def diff_even_odd(numbers: list[int]) -> int:\n    \"\"\"\n    Finds the difference of the first even and first odd number in a list.\n    Assumes both an even and an odd number will be present in the list.\n    \"\"\"\n    first_even = None\n    first_odd = None\n\n    for num in numbers:\n        if first_odd is None and num % 2 != 0:\n            first_odd = num\n        \n        if first_even is None and num % 2 == 0:\n            first_even = num\n            \n        # Stop searching once both numbers are found\n        if first_even is not None and first_odd is not None:\n            break\n            \n    return first_even - first_odd"}
{"task_id": "Mbpp/599", "solution": "from dataclasses import dataclass\nfrom typing import Tuple\ndef sum_average(n: int) -> tuple[int, float]:\n    \"\"\"\n    Validate n, compute the sum of 1..n using closed-form formula,\n    compute average as float, and return (sum, average).\n    \"\"\"\n    validate_n(n)\n    total = n * (n + 1) // 2\n    avg = float(total) / n\n    result = CalculationResult(sum=total, average=avg)\n    return result.to_tuple()"}
{"task_id": "Mbpp/598", "solution": "import math\nfrom dataclasses import dataclass\nclass ArmstrongChecker:\n    \"\"\"\n    Encapsulates the algorithm to decide if an integer is an Armstrong number.\n    \"\"\"\n\n    def armstrong_number(self, n: int) -> bool:\n        \"\"\"\n        Orchestrates counting digits, extracting digits, computing power-sum, and comparing with original n.\n        Analyzes the input 'n' by creating a Number object internally.\n        \"\"\"\n        if n == 0:\n            return True # 0 is considered an Armstrong number.\n\n        # Create the Number object as per design relationship: ArmstrongChecker analyzes Number.\n        num_digits = self.count_digits(n)\n        extracted_digits = self.extract_digits(n)\n        number_to_analyze = Number(value=n, num_digits=num_digits, digits=extracted_digits)\n\n        computed_sum = self.compute_power_sum(number_to_analyze.digits, number_to_analyze.num_digits)\n\n        is_armstrong = (computed_sum == number_to_analyze.value)\n        # ArmstrongResult is for diagnostics/logging per design, not directly returned here.\n\n        return is_armstrong\n\n    def count_digits(self, n: int) -> int:\n        \"\"\"\n        Counts decimal digits of abs(n). Defines 0 -> 1 digit.\n        \"\"\"\n        if n == 0:\n            return 1\n        return int(math.log10(abs(n))) + 1\n\n    def extract_digits(self, n: int) -> list[int]:\n        \"\"\"\n        Extracts digits of abs(n) in most-significant-first order.\n        \"\"\"\n        if n == 0:\n            return [0]\n\n        abs_n = abs(n)\n        digits = []\n        while abs_n > 0:\n            digits.append(abs_n % 10)\n            abs_n //= 10\n        return digits[::-1]\n\n    def compute_power_sum(self, digits: list[int], power: int) -> int:\n        \"\"\"\n        Computes the sum of each digit raised to the given power.\n        \"\"\"\n        total_sum = 0\n        for digit in digits:\n            total_sum += digit ** power\n        return total_sum\ndef armstrong_number(n: int) -> bool:\n    \"\"\"\n    Checks whether the given number is an Armstrong number.\n    assert armstrong_number(153)==True\n    \"\"\"\n    # Design decision: Negative integers are treated as non-Armstrong and return False.\n    if n < 0:\n        return False\n\n    # Delegate computation to an instance of ArmstrongChecker.\n    checker = ArmstrongChecker()\n    return checker.armstrong_number(n)"}
{"task_id": "Mbpp/600", "solution": "def is_Even(n) -> bool:\n    \"\"\"Return True if integer n is even, otherwise False.\n\n    Precondition: n is an int (BR7). Behavior for non-integers is unspecified by SRS (BR9).\n    \"\"\"\n    return n % 2 == 0"}
{"task_id": "Mbpp/597", "solution": "def find_kth(arr1, arr2, k):\n    \"\"\"\n    Finds the k-th smallest element from two sorted arrays.\n    k is 1-based, and a ValueError is raised if k is out of bounds.\n    \"\"\"\n    n1 = len(arr1)\n    n2 = len(arr2)\n    total_len = n1 + n2\n\n    if k < 1 or k > total_len:\n        raise ValueError(\"k is out of bounds: k must be between 1 and the total number of elements.\")\n\n    p1 = 0  # Pointer for arr1\n    p2 = 0  # Pointer for arr2\n    result = None\n\n    for _ in range(k):\n        if p1 == n1:  # arr1 is exhausted\n            result = arr2[p2]\n            p2 += 1\n        elif p2 == n2:  # arr2 is exhausted\n            result = arr1[p1]\n            p1 += 1\n        elif arr1[p1] <= arr2[p2]:\n            result = arr1[p1]\n            p1 += 1\n        else:\n            result = arr2[p2]\n            p2 += 1\n            \n    return result"}
{"task_id": "Mbpp/602", "solution": "def first_repeated_char(input: str) -> str:\n    \"\"\"\n    Finds the first repeated character in a given string by scanning left-to-right.\n    Returns an empty string if no character repeats.\n    \"\"\"\n    seen_chars = set()\n    for char in input:\n        if char in seen_chars:\n            return char\n        seen_chars.add(char)\n    return \"\""}
{"task_id": "Mbpp/604", "solution": "import typing\ndef _split_on_space(input: str) -> typing.List[str]:\n    \"\"\"\n    Split the input on exactly the ASCII space character and return tokens.\n    Behavior for consecutive spaces and leading/trailing spaces is left as-is per the SRS.\n    \"\"\"\n    return input.split(' ')\ndef reverse_words(input: str) -> str:\n    \"\"\"\n    Reverse the order of words in `input` using space ' ' as delimiter and return the joined result.\n    \"\"\"\n    tokens = _split_on_space(input)\n    reversed_tokens = tokens[::-1]\n    return ' '.join(reversed_tokens)"}
{"task_id": "Mbpp/605", "solution": "import math\ndef _is_divisible(a: int, b: int) -> bool:\n    \"\"\"Checks if integer a is divisible by integer b.\"\"\"\n    return a % b == 0\nclass PrimeChecker:\n    def prime_num(self, n: int) -> bool:\n        \"\"\"Checks if the given integer n is a prime number.\"\"\"\n        if n < 2:\n            return False\n        if n == 2:\n            return True\n        limit = math.isqrt(n)\n        for d in range(2, limit + 1):\n            if _is_divisible(n, d):\n                return False\n        return True\ndef prime_num(n: int) -> bool:\n    \"\"\"\n    Checks if the given integer is a prime number.\n    Delegates primality check to an internal PrimeChecker.\n    \"\"\"\n    checker = PrimeChecker()\n    return checker.prime_num(n)"}
{"task_id": "Mbpp/603", "solution": "class InputValidator:\n    def validate_integer(self, n) -> None:\n        \"\"\"Raise TypeError if n is not int.\"\"\"\n        if not isinstance(n, int):\n            raise TypeError(\"Input must be an integer.\")\n\n    def is_positive(self, n: int) -> bool:\n        \"\"\"Return True when n >= 1 else False.\"\"\"\n        return n >= 1\nclass ResultList:\n    def __init__(self, values: list[int]):\n        self.values: list[int] = values\n\n    def sort(self) -> None:\n        self.values.sort()\n\n    def to_list(self) -> list[int]:\n        return list(self.values)\nclass LudicNumberService:\n    def get_ludic(self, n: int) -> list[int]:\n        \"\"\"Compute and return ludic numbers up to n.\"\"\"\n        if not InputValidator().is_positive(n):\n            return []\n\n        candidates = self.generate_candidates(n)\n        ludic_numbers = self.apply_ludic_sieve(candidates)\n\n        result_list = ResultList(ludic_numbers)\n        result_list.sort()\n        return result_list.to_list()\n\n    def generate_candidates(self, n: int) -> list[int]:\n        \"\"\"Generate numbers from 1 to n.\"\"\"\n        return list(range(1, n + 1))\n\n    def apply_ludic_sieve(self, candidates: list[int]) -> list[int]:\n        \"\"\"Apply the ludic sieve algorithm.\"\"\"\n        if not candidates:\n            return []\n\n        sieve_candidates = list(candidates) # Make a mutable copy\n        ludic_result = []\n\n        while sieve_candidates:\n            current_ludic = sieve_candidates[0]\n            ludic_result.append(current_ludic)\n\n            if current_ludic == 1:\n                sieve_candidates.pop(0)\n                continue\n\n            # Remove the current ludic number from the list as it's been processed\n            sieve_candidates.pop(0)\n\n            next_sieve_candidates = []\n            skip_count = 0\n            for num in sieve_candidates:\n                if skip_count == current_ludic - 1:\n                    skip_count = 0\n                else:\n                    next_sieve_candidates.append(num)\n                    skip_count += 1\n            sieve_candidates = next_sieve_candidates\n\n        return ludic_result\ndef get_ludic(n):\n    \"\"\"Entry point: validate and compute ludic numbers <= n.\"\"\"\n    InputValidator().validate_integer(n)\n    return LudicNumberService().get_ludic(n)"}
