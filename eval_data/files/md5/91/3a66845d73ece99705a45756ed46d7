{"task_id": "Mbpp/406", "solution": "class Number:\n    def __init__(self, value: int) -> None:\n        self.value = value\nclass ParityResult:\n    def __init__(self, is_odd: bool) -> None:\n        self.is_odd = is_odd\nclass ParityChecker:\n    function_name: str = \"find_Parity\"\n\n    def find_Parity(self, n: int) -> bool:\n        # Evaluates the parity of the number and returns True if odd, False if even.\n        num_obj = Number(n)\n        is_odd_val = (num_obj.value % 2 != 0)\n        result_obj = ParityResult(is_odd=is_odd_val)\n        return result_obj.is_odd\ndef find_Parity(n: int) -> bool:\n    \"\"\"\n    Determines if the parity of a given number is odd.\n    Returns True if the number is odd, False otherwise.\n    \"\"\"\n    checker = ParityChecker()\n    return checker.find_Parity(n)"}
{"task_id": "Mbpp/410", "solution": "def _is_numeric(item) -> bool:\n    \"\"\"Return True if item is of type int or float, False otherwise.\"\"\"\n    return isinstance(item, (int, float))\ndef _filter_numeric_elements(lst: list) -> list:\n    \"\"\"Return a list of elements from lst that are ints or floats.\"\"\"\n    return [item for item in lst if _is_numeric(item)]\ndef min_val(lst: list) -> float | int:\n    \"\"\"Return the smallest numeric (int or float) element in lst, ignoring non-numeric elements.\"\"\"\n    numeric_list = _filter_numeric_elements(lst)\n    if not numeric_list:\n        raise ValueError('no numeric elements')\n    return min(numeric_list)"}
{"task_id": "Mbpp/409", "solution": "from typing import List, Tuple\nclass TuplePair:\n    def __init__(self, a: int, b: int) -> None:\n        self.a = a\n        self.b = b\n    def product(self) -> int:\n        \"\"\"Computes the product of the two integers in the pair.\"\"\"\n        return self.a * self.b\nclass InputList:\n    def __init__(self, pairs: List[TuplePair]) -> None:\n        self.pairs = pairs\n    def is_valid(self) -> bool:\n        \"\"\"Placeholder for validity check; actual validation occurs externally.\"\"\"\n        return True\nclass MinProductCalculator:\n    def __init__(self) -> None:\n        pass\n    def minProduct(self, input_list: InputList) -> int:\n        \"\"\"Calculates the minimum product from a list of TuplePair objects.\"\"\"\n        if not input_list.pairs:\n            raise ValueError(\"no data to compute minimum product\")\n        \n        min_prod = float('inf')\n        for tp in input_list.pairs:\n            current_prod = tp.product()\n            if current_prod < min_prod:\n                min_prod = current_prod\n        return int(min_prod)\nclass ProductResult:\n    def __init__(self, value: int) -> None:\n        self.value = value\ndef min_product_tuple(pairs: List[Tuple[int, int]]) -> int:\n    \"\"\"\n    Finds the minimum product from the pairs of tuples within a given list.\n    Validates input and computes the minimum product using domain objects.\n    \"\"\"\n    _validate_pairs_type(pairs)\n\n    tuple_pairs = []\n    for i, raw_pair in enumerate(pairs):\n        _validate_pair_shape_and_types(raw_pair, i)\n        tuple_pairs.append(TuplePair(raw_pair[0], raw_pair[1]))\n\n    input_list = InputList(tuple_pairs)\n\n    calculator = MinProductCalculator()\n    min_val = calculator.minProduct(input_list)\n\n    result = ProductResult(min_val)\n    return result.value"}
