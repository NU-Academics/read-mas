{"task_id": "Mbpp/793", "solution": "from typing import List, Any\ndef last(array: List[Any], value: Any) -> int:\n    \"\"\"\n    Return the 0-based index of the last occurrence of value in array.\n    Precondition: array is sorted. Returns -1 if value is not found.\n    \"\"\"\n    for i in range(len(array) - 1, -1, -1):\n        if array[i] == value:\n            return i\n    return -1"}
{"task_id": "Mbpp/794", "solution": "def text_starta_endb(text: str) -> bool:\n    \"\"\"\n    Accepts a single parameter `text` (type: str) and returns True iff the\n    first character is lowercase 'a' and the last character is lowercase 'b'.\n    Returns False for any string with length < 2.\n    \"\"\"\n    if len(text) < 2:\n        return False\n    return text[0] == 'a' and text[-1] == 'b'"}
{"task_id": "Mbpp/797", "solution": "from dataclasses import dataclass\nfrom typing import List, Tuple\ndef _normalize_range(l, r) -> Tuple[int, int]:\n    \"\"\"Ensure l is not greater than r for the range.\"\"\"\n    if l > r:\n        raise ValueError(\"l must be <= r\")\n    return (l, r)\ndef _select_odd_naturals(l, r) -> List[int]:\n    \"\"\"Selects odd natural numbers within the given inclusive range.\"\"\"\n    selected_numbers = []\n    for n in range(l, r + 1):\n        if n >= 1 and n % 2 == 1:\n            selected_numbers.append(n)\n    return selected_numbers\ndef _compute_sum(numbers: List[int]) -> int:\n    \"\"\"Computes the sum of a list of integers, returning 0 for an empty list.\"\"\"\n    return sum(numbers)\ndef sum_in_range(l, r) -> int:\n    \"\"\"\n    Calculates the sum of all odd natural numbers within the inclusive range [l, r].\n    \"\"\"\n    _validate_inputs(l, r)\n    l_norm, r_norm = _normalize_range(l, r)\n    \n    odd_naturals = _select_odd_naturals(l_norm, r_norm)\n    \n    total_sum = _compute_sum(odd_naturals)\n    \n    return total_sum"}
{"task_id": "Mbpp/798", "solution": "def _sum(array):\n    \"\"\"Compute arithmetic sum of elements in 'array'.\n\n    Parameters:\n      array: a Python list (or iterable) of numeric elements.\n\n    Returns:\n      number: arithmetic sum of elements (int/float)\n    \"\"\"\n    total = 0\n    for item in array:\n        total += item\n    return total"}
{"task_id": "Mbpp/800", "solution": "def remove_all_spaces(input_string: str) -> str:\n    \"\"\"Removes all whitespace characters from a string.\"\"\"\n    return ''.join(char for char in input_string if not char.isspace())"}
{"task_id": "Mbpp/799", "solution": "def _mask_to_32(value: int) -> int:\n    \"\"\"Return value & 0xFFFFFFFF as int in range 0..4294967295.\"\"\"\n    return value & 0xFFFFFFFF\ndef _normalize_d(d: int) -> int:\n    \"\"\"Return d % 32 (assumes integer d >= 0 as per SRS).\"\"\"\n    return d % 32\ndef _rotate_left_32(masked_value: int, shift: int) -> int:\n    \"\"\"Perform circular left rotation on masked_value by shift (0..31) positions and return masked 32-bit result.\"\"\"\n    if shift == 0:\n        return masked_value\n    else:\n        return ((masked_value << shift) | (masked_value >> (32 - shift))) & 0xFFFFFFFF\ndef left_rotate(value: int, d: int) -> int:\n    \"\"\"Public API per SRS: rotate lower 32 bits of value left by (d mod 32) and return result in 0..4294967295.\"\"\"\n    masked = _mask_to_32(value)\n    shift = _normalize_d(d)\n    if shift == 0:\n        return masked\n    result = _rotate_left_32(masked, shift)\n    return result & 0xFFFFFFFF"}
{"task_id": "Mbpp/801", "solution": "def test_three_equal(a: int, b: int, c: int) -> int:\n    \"\"\"\n    Counts the number of equal integers among three given integers.\n    Returns 3 if all are equal, 2 if exactly two are equal, and 0 if none are equal.\n    \"\"\"\n    if a == b and b == c:\n        return 3\n    elif (a == b and a != c) or \\\n         (a == c and a != b) or \\\n         (b == c and b != a):\n        return 2\n    else:\n        return 0"}
{"task_id": "Mbpp/803", "solution": "import math\nclass PerfectSquareChecker:\n    \"\"\"Stateless service implementing the perfect square algorithm.\"\"\"\n    def is_perfect_square(self, n: int) -> bool:\n        if n < 0:\n            return False\n        \n        m = math.isqrt(n)\n        return m * m == n\ndef is_perfect_square(n):\n    \"\"\"Checks if the given number is a perfect square.\"\"\"\n    checker = PerfectSquareChecker()\n    return checker.is_perfect_square(n)"}
{"task_id": "Mbpp/805", "solution": "def max_sum_list(list_of_lists):\n    \"\"\"\n    Returns the sublist from a list of lists whose sum of elements is the highest.\n    In case of a tie, the first such sublist encountered is returned.\n    \"\"\"\n    if not list_of_lists:\n        return None  # Or [] depending on implicit requirement for empty input without exceptions\n\n    max_sum = float('-inf')\n    max_list = None\n\n    for sublist in list_of_lists:\n        current_sum = sum(sublist)\n        if current_sum > max_sum:\n            max_sum = current_sum\n            max_list = sublist\n\n    return max_list"}
{"task_id": "Mbpp/806", "solution": "def max_run_uppercase(input_string: str) -> int:\n    \"\"\"\n    Finds the maximum run of ASCII uppercase characters in the given string.\n    Returns 0 if no uppercase characters are found or the string is empty.\n    \"\"\"\n    max_run = 0\n    current_run = 0\n    for ch in input_string:\n        if 'A' <= ch <= 'Z':\n            current_run += 1\n            if current_run > max_run:\n                max_run = current_run\n        else:\n            current_run = 0\n    return max_run"}
{"task_id": "Mbpp/804", "solution": "import collections.abc\nfrom typing import List\nclass ValidationError(Exception):\n    \"\"\"\n    Exception raised for invalid input to the is_product_even function.\n    Contains a message detailing the validation failure.\n    \"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\nclass InputList:\n    \"\"\"\n    Encapsulates input validation to ensure it is a list of integers.\n    Raises ValidationError for invalid input types or elements.\n    \"\"\"\n    def __init__(self, numbers):\n        self._numbers = numbers\n\n    def validate(self):\n        \"\"\"\n        Validates that the input is a list and all its elements are integers.\n        Raises ValidationError with specific messages upon failure.\n        \"\"\"\n        if not isinstance(self._numbers, list):\n            raise ValidationError(\"Input must be a list\")\n\n        for element in self._numbers:\n            if not isinstance(element, int):\n                raise ValidationError(\"All elements must be integers\")\nclass Product:\n    \"\"\"\n    Provides methods for product-related operations, specifically checking for even parity.\n    Optimizes by short-circuiting when an even number is encountered.\n    \"\"\"\n    @staticmethod\n    def scan_for_even(numbers: List[int]) -> bool:\n        \"\"\"\n        Checks if the product of numbers is even by scanning for any even number.\n        Returns True if an even number is found, otherwise False.\n        \"\"\"\n        if not numbers:\n            return False # The product of an empty list is 1, which is odd.\n\n        for number in numbers:\n            if number % 2 == 0:\n                return True # Found an even number, the product will be even.\n\n        return False # No even numbers found, the product will be odd.\ndef is_product_even(numbers) -> bool:\n    \"\"\"\n    Checks whether the product of numbers in a list is even or not.\n    Raises ValidationError if the input is not a list or contains non-integer elements.\n    \"\"\"\n    input_list_validator = InputList(numbers)\n    input_list_validator.validate()\n    return Product.scan_for_even(input_list_validator._numbers)"}
{"task_id": "Mbpp/807", "solution": "class Number:\n    \"\"\"Helper class to encapsulate integer value and oddness check.\"\"\"\n    def __init__(self, value: int):\n        self.value: int = value\n\n    def is_odd(self) -> bool:\n        \"\"\"Checks if the number is odd.\"\"\"\n        return self.value % 2 != 0\nclass NumberList:\n    \"\"\"Helper class to manage a list of numbers and find the first odd one.\"\"\"\n    def __init__(self, items: list):\n        self.items: list = items\n\n    def get_first_odd(self) -> int | None:\n        \"\"\"Finds the first odd integer in the list or returns None.\"\"\"\n        for item in self.items:\n            try:\n                # Elements that raise TypeError on Number(item) are treated as non-odd and ignored.\n                num_obj = Number(item)\n                if num_obj.is_odd():\n                    return item\n            except (TypeError, ValueError):\n                continue\n        return None\ndef first_odd(numbers: list) -> int | None:\n    \"\"\"Return the first odd integer from numbers or None if none exists.\"\"\"\n    number_list = NumberList(numbers)\n    return number_list.get_first_odd()"}
{"task_id": "Mbpp/808", "solution": "def check_K(tuple_input: tuple, k) -> bool:\n    \"\"\"Checks if a value k is present in the given tuple.\"\"\"\n    return k in tuple_input"}
{"task_id": "Mbpp/809", "solution": "def check_smaller(tuple1, tuple2):\n    \"\"\"\n    Checks if each element of the second tuple is smaller than its corresponding element in the first tuple.\n    Raises ValueError if tuple lengths do not match.\n    \"\"\"\n    def _validate_length(t1, t2):\n        \"\"\"Raises ValueError if the lengths of the two tuples do not match.\"\"\"\n        if len(t1) != len(t2):\n            raise ValueError(\"tuple length mismatch\")\n\n    def _compare_pair(a, b):\n        \"\"\"Compares two elements, returning True if the second is strictly smaller than the first.\"\"\"\n        return b < a\n\n    _validate_length(tuple1, tuple2)\n\n    for i in range(len(tuple1)):\n        if not _compare_pair(tuple1[i], tuple2[i]):\n            return False\n    return True"}
