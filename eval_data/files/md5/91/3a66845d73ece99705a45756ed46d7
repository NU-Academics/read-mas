{"task_id": "Mbpp/94", "solution": "import typing\ndef index_minimum(tuples: typing.Iterable[typing.Tuple[typing.Any, typing.Any]]) -> typing.Any:\n    \"\"\"\n    Given a list of tuples, returns the first value of the tuple with the smallest second value.\n    It raises ValueError for empty or malformed tuples, and TypeError if second elements are non-comparable.\n    \"\"\"\n    items = list(tuples) # Convert to list for stable tie-breaking and robust validation.\n\n    if not items:\n        raise ValueError(\"Input iterable is empty.\")\n\n    min_item = None\n    min_val = None\n\n    for item in items:\n        # Validate each item adheres to the 'at least two elements' rule (BR2, BR6).\n        # hasattr(item, '__getitem__') ensures it's subscriptable.\n        if not hasattr(item, '__getitem__') or len(item) < 2:\n            raise ValueError(\"tuple must have at least two elements.\")\n\n        current_val = item[1]\n\n        if min_item is None: # Initialize with the first valid item encountered.\n            min_item = item\n            min_val = current_val\n        else:\n            try:\n                # Compare current_val with min_val, ensuring stable tie-breaking (BR3, BR4).\n                if current_val < min_val:\n                    min_val = current_val\n                    min_item = item\n            except TypeError:\n                # Handle non-comparable second elements (BR6).\n                raise TypeError(\"Second elements of tuples are not mutually comparable.\")\n\n    return min_item[0]"}
{"task_id": "Mbpp/96", "solution": "import math\ndef divisor(n: int) -> int:\n    \"\"\"Return the number of positive divisors of n.\n\n    Raises TypeError if n is not an int, ValueError if n is 0.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an int\")\n    if n == 0:\n        raise ValueError(\"number of positive divisors of 0 is undefined\")\n    \n    m = abs(n)\n    count = 0\n    # Iterate up to the integer square root of m\n    for i in range(1, math.isqrt(m) + 1):\n        if m % i == 0:\n            # If i*i == m, i is a single divisor (perfect square case)\n            # Otherwise, i and m/i are a pair of distinct divisors\n            count += 2 if (i * i != m) else 1\n            \n    return int(count)"}
{"task_id": "Mbpp/97", "solution": "class FrequencyCalculator:\n    def flatten(self, list_of_lists: list) -> list:\n        \"\"\"Flattens a list of lists into a single list, preserving order.\"\"\"\n        flattened_list = []\n        for sublist in list_of_lists:\n            for item in sublist:\n                flattened_list.append(item)\n        return flattened_list\n\n    def count(self, elements: list) -> dict:\n        \"\"\"Counts the frequency of each element in a given list.\"\"\"\n        frequencies = {}\n        for element in elements:\n            frequencies[element] = frequencies.get(element, 0) + 1\n        return frequencies\n\n    def frequency_lists(self, list_of_lists: list) -> dict:\n        \"\"\"Orchestrates flattening and counting to determine element frequencies.\"\"\"\n        flattened_list = self.flatten(list_of_lists)\n        frequency_map = self.count(flattened_list)\n        return frequency_map\ndef frequency_lists(list_of_lists: list) -> dict:\n    \"\"\"\n    Finds the frequency of each element in a flattened list of lists,\n    returning the frequencies in a dictionary.\n    \"\"\"\n    calculator = FrequencyCalculator()\n    return calculator.frequency_lists(list_of_lists)"}
{"task_id": "Mbpp/92", "solution": "from typing import List, Set\nclass NumberInput:\n    \"\"\"Validates and normalizes raw input, provides decimal digits representation.\"\"\"\n    def __init__(self, value: int, normalized_value: int, normalized_digits: str) -> None:\n        self.value = value\n        self.normalized_value = normalized_value\n        self.normalized_digits = normalized_digits\n\n    def getDigits(self) -> List[int]:\n        \"\"\"Returns the list of decimal digits for the normalized value.\"\"\"\n        return [int(d) for d in self.normalized_digits]\nclass DigitSequence:\n    \"\"\"Represents an ordered sequence of digits and provides helper methods.\"\"\"\n    def __init__(self, digits: List[int]) -> None:\n        self.digits = digits\n\n    def length(self) -> int:\n        \"\"\"Returns the number of digits in the sequence.\"\"\"\n        return len(self.digits)\n\n    def distinctDigits(self) -> Set[int]:\n        \"\"\"Returns a set of unique digits in the sequence.\"\"\"\n        return set(self.digits)\n\n    def digitAt(self, i: int) -> int:\n        \"\"\"Returns the digit at the specified index.\"\"\"\n        return self.digits[i]\nclass CheckResult:\n    \"\"\"Encapsulates the outcome of an undulating check with a boolean and a reason.\"\"\"\n    def __init__(self, isUndulating: bool, reason: str = \"\") -> None:\n        self.isUndulating = isUndulating\n        self.reason = reason\ndef _normalize_and_build_number_input(value) -> NumberInput:\n    \"\"\"Enforces type validation, normalization, and returns a NumberInput instance.\"\"\"\n    if not isinstance(value, int):\n        raise TypeError(\"Input must be an integer.\")\n    normalized_value = abs(value)\n    normalized_digits = str(normalized_value)\n    return NumberInput(value, normalized_value, normalized_digits)\nclass UndulatingChecker:\n    \"\"\"Executes the undulating check and returns a CheckResult.\"\"\"\n    def isUndulating(self, input: NumberInput) -> CheckResult:\n        \"\"\"Applies business rules to determine if the number is undulating.\"\"\"\n        digit_list = input.getDigits()\n        digit_sequence = DigitSequence(digit_list)\n        \n        if digit_sequence.length() <= 1:\n            return CheckResult(False, \"Numbers with one or fewer digits cannot be undulating.\")\n        \n        distinct_digits = digit_sequence.distinctDigits()\n        \n        if len(distinct_digits) != 2:\n            return CheckResult(False, f\"Number must have exactly two distinct digits, found {len(distinct_digits)}.\")\n        \n        first_digit_in_sequence = digit_sequence.digitAt(0)\n        second_digit_in_sequence = digit_sequence.digitAt(1)\n\n        if first_digit_in_sequence == second_digit_in_sequence:\n            return CheckResult(False, \"First two digits are identical, breaking alternation pattern.\")\n\n        for i in range(digit_sequence.length()):\n            current_digit = digit_sequence.digitAt(i)\n            if i % 2 == 0:\n                if current_digit != first_digit_in_sequence:\n                    return CheckResult(False, f\"Alternation broken at position {i}: expected {first_digit_in_sequence}, got {current_digit}.\")\n            else:\n                if current_digit != second_digit_in_sequence:\n                    return CheckResult(False, f\"Alternation broken at position {i}: expected {second_digit_in_sequence}, got {current_digit}.\")\n            \n        return CheckResult(True)\ndef is_undulating(number) -> bool:\n    \"\"\"Public API per SRS: is_undulating(number) -> bool. Raises TypeError for non-int inputs.\"\"\"\n    number_input = _normalize_and_build_number_input(number)\n    checker = UndulatingChecker()\n    result = checker.isUndulating(number_input)\n    return result.isUndulating"}
