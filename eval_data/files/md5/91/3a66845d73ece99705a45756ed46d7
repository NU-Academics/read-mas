{"task_id": "Mbpp/724", "solution": "class BigIntegerValue:\n    \"\"\"Encapsulates exact integer exponentiation and conversion to decimal string.\"\"\"\n    def __init__(self, base: int, power: int):\n        self.value = base ** power\n\n    def toDecimalString(self) -> str:\n        \"\"\"Returns the decimal string representation of the absolute value.\"\"\"\n        return str(abs(self.value))\nclass DigitExtractor:\n    \"\"\"Provides a digit extraction utility.\"\"\"\n    def extractDigits(self, decimalString: str) -> list:\n        \"\"\"Converts a decimal string into a list of integer digits (0..9).\"\"\"\n        return [int(ch) for ch in decimalString]\ndef power_base_sum(base, power):\n    \"\"\"\n    Calculates the sum of all digits of the base to the specified power.\n    \"\"\"\n    big_int_value = BigIntegerValue(base, power)\n    decimal_string = big_int_value.toDecimalString()\n    \n    digit_extractor = DigitExtractor()\n    digits = digit_extractor.extractDigits(decimal_string)\n    \n    return sum(digits)"}
{"task_id": "Mbpp/723", "solution": "def validateLengths(listA: list, listB: list) -> bool:\n    \"\"\"\n    Validates that two input lists have the same length.\n    Raises ValueError if lengths differ.\n    \"\"\"\n    if len(listA) != len(listB):\n        raise ValueError(\"Input lists must have the same length\")\n    return True\ndef count_same_pair(listA: list, listB: list) -> int:\n    \"\"\"\n    Counts indices where two lists of the same length have equal values.\n    Raises ValueError if input lists have different lengths.\n    \"\"\"\n    validateLengths(listA, listB)\n\n    match_count = 0\n    for i in range(len(listA)):\n        if listA[i] == listB[i]:\n            match_count += 1\n            \n    return match_count"}
{"task_id": "Mbpp/726", "solution": "def multiply_elements(input_tuple):\n    \"\"\"\n    Computes products of adjacent elements in a tuple.\n    Returns a new tuple where the i-th element is t_i * t_{i+1}.\n    \"\"\"\n    products = []\n    for i in range(len(input_tuple) - 1):\n        products.append(input_tuple[i] * input_tuple[i+1])\n    return tuple(products)"}
{"task_id": "Mbpp/728", "solution": "from typing import Sequence, List, Any\nfrom numbers import Number\nNumericList = Sequence[Number]\nResultList = List[Number]\ndef sum_list(a: NumericList, b: NumericList) -> ResultList:\n    \"\"\"\n    Sums two lists element-wise, returning a new list.\n    Raises LengthMismatchException if lists have different lengths.\n    \"\"\"\n    _validate_same_length(a, b)\n\n    result = []\n    for val_a, val_b in zip(a, b):\n        result.append(val_a + val_b)\n\n    return result"}
{"task_id": "Mbpp/730", "solution": "from typing import List, Any\ndef consecutive_duplicates(input_list: List) -> List:\n    \"\"\"\n    Removes consecutive duplicate elements from a list, preserving order.\n    A new list is returned without modifying the input list.\n    \"\"\"\n    if not input_list:\n        return []\n\n    result = [input_list[0]]\n    for item in input_list[1:]:\n        if item != result[-1]:\n            result.append(item)\n    return result"}
{"task_id": "Mbpp/732", "solution": "def replace_specialchar(input: str) -> str:\n    \"\"\"Public API. Accepts a single string input and returns a transformed string per SRS.\"\"\"\n    return ReplaceSpecialChar().replace(input)\nclass ReplaceSpecialChar:\n    def replace(self, input: str) -> str:\n        out_chars = []\n        mapping = { ' ': ':', ',': ':', '.': ':' }\n        for ch in input:\n            out_chars.append(mapping.get(ch, ch))\n        return ''.join(out_chars)"}
{"task_id": "Mbpp/731", "solution": "import math\nclass Cone:\n    \"\"\"Represents a cone with a given radius and height.\"\"\"\n    def __init__(self, r: float, h: float) -> None:\n        self.r = r\n        self.h = h\n\n    def lateralSurface(self) -> float:\n        \"\"\"Computes the lateral surface area of the cone by delegating to a Calculator.\"\"\"\n        calculator = Calculator()\n        return calculator.computeLateralSurface(self)\nclass Calculator:\n    \"\"\"Encapsulates the computation of the lateral surface area for a cone.\"\"\"\n    def __init__(self) -> None:\n        pass\n\n    def computeLateralSurface(self, cone: Cone) -> float:\n        \"\"\"Calculates the lateral surface area using the formula pi * r * sqrt(r^2 + h^2).\"\"\"\n        slant_height = math.sqrt(cone.r**2 + cone.h**2)\n        lateral_surface_area = math.pi * cone.r * slant_height\n        return lateral_surface_area\ndef lateralsurface_cone(r, h):\n    \"\"\"\n    Calculates the lateral surface area of a cone given its radius and height.\n    \"\"\"\n    cone = Cone(float(r), float(h))\n    calculator = Calculator()\n    return calculator.computeLateralSurface(cone)"}
{"task_id": "Mbpp/733", "solution": "from dataclasses import dataclass\nfrom typing import List\nclass Number:\n    \"\"\"Represents a numeric value.\"\"\"\n    def __init__(self, value: float):\n        self.value = value\nclass SortedArray:\n    \"\"\"Thin wrapper for a sorted list of numbers (documenting BR1).\"\"\"\n    def __init__(self, elements: List[float]):\n        self.elements: List[Number] = [Number(e) for e in elements]\n\n    def length(self) -> int:\n        \"\"\"Returns the number of elements in the array.\"\"\"\n        return len(self.elements)\n\n    def get(self, index: int) -> Number:\n        \"\"\"Returns the Number at the given index.\"\"\"\n        return self.elements[index]\ndef find_first_occurrence(arr: SortedArray, target: Number) -> int:\n    \"\"\"\n    Finds the index of the first occurrence of a given number in a sorted array.\n    Returns the zero-based index of the first (leftmost) occurrence, or -1 if not found.\n    \"\"\"\n    low = 0\n    high = arr.length() - 1\n    result = -1\n\n    while low <= high:\n        mid = low + (high - low) // 2\n        mid_val = arr.get(mid).value\n\n        if mid_val == target.value:\n            result = mid  # Found a potential first occurrence\n            high = mid - 1  # Try to find an earlier occurrence in the left half\n        elif mid_val < target.value:\n            low = mid + 1  # Target is in the right half\n        else:  # mid_val > target.value\n            high = mid - 1  # Target is in the left half\n\n    return result"}
{"task_id": "Mbpp/734", "solution": "def sum_Of_Subarray_Prod(list_arg):\n    \"\"\"\n    Finds the sum of products of all possible contiguous sublists of a given list.\n    Handles input validation and calculates products using nested helper functions.\n    \"\"\"\n\n    def _validate_input(lst):\n        \"\"\"Validates that the input is a list of numeric elements.\"\"\"\n        if not isinstance(lst, list):\n            raise TypeError(\"Input must be a list.\")\n        for element in lst:\n            if not isinstance(element, (int, float)):\n                raise TypeError(\"All elements in the list must be numeric (int or float).\")\n\n    def _generate_contiguous_sublists(lst):\n        \"\"\"Generates all contiguous sublists of the input list.\"\"\"\n        n = len(lst)\n        for i in range(n):\n            for j in range(i, n):\n                yield lst[i : j + 1]\n\n    def _product_of_list(sublist):\n        \"\"\"Computes the product of elements in a sublist.\"\"\"\n        if not sublist:\n            return 1\n        product = 1\n        for x in sublist:\n            product *= x\n        return product\n\n    _validate_input(list_arg)\n\n    total_sum = 0\n    for sublist in _generate_contiguous_sublists(list_arg):\n        total_sum += _product_of_list(sublist)\n\n    return total_sum"}
{"task_id": "Mbpp/735", "solution": "def get_msb_index(n: int) -> int:\n    \"\"\"Computes the index of the highest-order '1' bit in n (0-based).\"\"\"\n    # For n > 0, n.bit_length() is the number of bits required to represent n,\n    # and (n.bit_length() - 1) gives the index of the most significant bit.\n    return n.bit_length() - 1\ndef generate_mask(msb_index: int, lsb_index: int) -> int:\n    \"\"\"Generates an integer mask with 1s strictly between msb_index and lsb_index.\"\"\"\n    if msb_index - lsb_index <= 1:\n        return 0  # No bits strictly between MSB and LSB\n    \n    # Calculate the number of bits to set to 1 in the middle\n    count = msb_index - lsb_index - 1\n    # Create a mask with 'count' number of ones, then shift it to the correct position\n    mask = ((1 << count) - 1) << (lsb_index + 1)\n    return mask\ndef toggle_middle_bits(n: int) -> int:\n    \"\"\"\n    Toggles bits of the number except the first (MSB) and the last (LSB) bit.\n    If the number has fewer than 3 bits, it is returned unchanged.\n    \"\"\"\n    bit_length = n.bit_length()\n\n    if bit_length < 3:\n        return n\n\n    # The most significant bit (MSB) is at index (bit_length - 1)\n    msb_index = get_msb_index(n)\n    # The least significant bit (LSB) is always at index 0 for positive numbers\n    lsb_index = 0\n\n    mask = generate_mask(msb_index, lsb_index)\n\n    # XORing with the mask toggles only the bits where the mask has 1s\n    result = n ^ mask\n    return result"}
