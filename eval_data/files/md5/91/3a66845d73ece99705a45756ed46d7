{"task_id": "Mbpp/455", "solution": "from typing import Dict\nclass Month:\n    \"\"\"Immutable data holder for month metadata.\"\"\"\n    def __init__(self, number: int, days: int, has_31_days: bool) -> None:\n        self.number = number\n        self.days = days\n        self.has_31_days = has_31_days\nMONTH_LOOKUP: Dict[int, Month] = {\n    1: Month(1, 31, True),\n    2: Month(2, 28, False),\n    3: Month(3, 31, True),\n    4: Month(4, 30, False),\n    5: Month(5, 31, True),\n    6: Month(6, 30, False),\n    7: Month(7, 31, True),\n    8: Month(8, 31, True),\n    9: Month(9, 30, False),\n    10: Month(10, 31, True),\n    11: Month(11, 30, False),\n    12: Month(12, 31, True),\n}\nclass MonthChecker:\n    \"\"\"Determines whether a month number corresponds to a month with 31 days.\"\"\"\n    def __init__(self, lookup: Dict[int, Month]) -> None:\n        self._lookup = lookup\n\n    def check_monthnumb_number(self, monthNumber: int) -> bool:\n        \"\"\"Checks if the given month number has 31 days.\"\"\"\n        month = self._lookup.get(monthNumber)\n        if month is None:\n            return False\n        return month.has_31_days\n_month_checker_instance = MonthChecker(MONTH_LOOKUP)\ndef check_monthnumb_number(monthNumber: int) -> bool:\n    \"\"\"Checks whether the given month number contains 31 days or not.\"\"\"\n    return _month_checker_instance.check_monthnumb_number(monthNumber)"}
{"task_id": "Mbpp/456", "solution": "def _reverse_string(s):\n    \"\"\"Return character-wise reversal of string s.\"\"\"\n    return s[::-1]\ndef reverse_string_list(input_list):\n    \"\"\"\n    Accepts a single argument input_list (list of str) and returns a new list of str\n    where each element is the character-wise reversal of the corresponding input element.\n    Raises TypeError if input_list is not a list or any element is not a string.\n    \"\"\"\n    _validate_input_list(input_list)\n    _validate_elements_are_strings(input_list)\n    \n    reversed_list = [_reverse_string(s) for s in input_list]\n    \n    return reversed_list"}
{"task_id": "Mbpp/459", "solution": "class InputString:\n    \"\"\"Holds an input string value and its length.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n        self.length = len(value)\nclass OutputString:\n    \"\"\"Holds an output string value and its length.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n        self.length = len(value)\nclass StringProcessor:\n    \"\"\"Provides static methods for character classification and string filtering.\"\"\"\n    @staticmethod\n    def is_upper(c: str) -> bool:\n        \"\"\"Determines if a character is uppercase.\"\"\"\n        return c.isupper()\n\n    @staticmethod\n    def filter_out_uppercase(s: str) -> str:\n        \"\"\"Returns a new string with all uppercase characters removed.\"\"\"\n        return \"\".join([char for char in s if not StringProcessor.is_upper(char)])\ndef remove_uppercase(input: str) -> str:\n    \"\"\"\n    Removes all uppercase characters from the given string.\n    Raises TypeError if the input is not a string.\n    \"\"\"\n    if not isinstance(input, str):\n        raise TypeError(\"Input must be a string.\")\n\n    input_obj = InputString(input)\n    filtered_value = StringProcessor.filter_out_uppercase(input_obj.value)\n    output_obj = OutputString(filtered_value)\n    return output_obj.value"}
{"task_id": "Mbpp/460", "solution": "def Extract(input_list):\n    \"\"\"\n    Extracts the first element from each sublist in a list of sublists.\n    Raises TypeError if input is not a list/tuple, ValueError if any sublist is empty.\n    \"\"\"\n    def _is_list_like(obj):\n        \"\"\"Checks if the object is a list or tuple.\"\"\"\n        return isinstance(obj, (list, tuple))\n\n    def _collect_first_elements(data):\n        \"\"\"Collects first elements, raising ValueError for empty sublists.\"\"\"\n        result = []\n        for sublist in data:\n            if not sublist:\n                raise ValueError(\"Sublist cannot be empty.\")\n            result.append(sublist[0])\n        return result\n\n    if not _is_list_like(input_list):\n        raise TypeError(\"Input must be a list or tuple of sublists.\")\n\n    if not input_list:\n        return []\n\n    return _collect_first_elements(input_list)"}
