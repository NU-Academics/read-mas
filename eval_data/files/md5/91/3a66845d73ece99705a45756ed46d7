{"task_id": "Mbpp/441", "solution": "class InputValidator:\n    \"\"\"Provides input validation utilities for numeric and non-negative values.\"\"\"\n    def isNumeric(self, value) -> bool:\n        return isinstance(value, (int, float))\n\n    def isNonNegative(self, value) -> bool:\n        return value >= 0\nclass SurfaceAreaResult:\n    \"\"\"Value object holding the computed numeric surface area.\"\"\"\n    def __init__(self, value: float):\n        self._value = value\n\n    def getValue(self) -> float:\n        \"\"\"Returns the stored surface area value.\"\"\"\n        return self._value\nclass Cube:\n    \"\"\"Encapsulates cube properties and surface area computation.\"\"\"\n    def __init__(self, sideLength: float):\n        self._sideLength = sideLength\n\n    def computeSurfaceArea(self) -> SurfaceAreaResult:\n        \"\"\"Computes and returns the surface area of the cube as a SurfaceAreaResult object.\"\"\"\n        area = 6 * self._sideLength * self._sideLength\n        return SurfaceAreaResult(area)\ndef surfacearea_cube(sideLength):\n    \"\"\"\n    Validates input, computes surface area (6 * side * side), and returns a numeric value.\n    \"\"\"\n    validator = InputValidator()\n\n    if not validator.isNumeric(sideLength):\n        raise TypeError(\"Side length must be a numeric value (int or float).\")\n    if not validator.isNonNegative(sideLength):\n        raise ValueError(\"Side length cannot be negative.\")\n\n    cube = Cube(float(sideLength))\n    result_obj = cube.computeSurfaceArea()\n    return result_obj.getValue()"}
{"task_id": "Mbpp/446", "solution": "import collections\nfrom typing import Any, Tuple, List, Set\nclass TupleInput:\n    \"\"\"Lightweight wrapper for tuple accessors.\"\"\"\n    def __init__(self, elements: Tuple[Any]) -> None:\n        self._elements = elements\n\n    def length(self) -> int:\n        return len(self._elements)\n\n    def get(self, index: int) -> Any:\n        return self._elements[index]\nclass ListInput:\n    \"\"\"Lightweight wrapper for list normalization.\"\"\"\n    def __init__(self, elements: List[Any]) -> None:\n        self._elements = elements\n\n    def to_unique_collection(self) -> Any: # Can be set or list\n        \"\"\"Returns a unique collection (set if hashable, else a list of unique items).\"\"\"\n        try:\n            return set(self._elements)\n        except TypeError:\n            # Fallback for unhashable elements\n            unique_list = []\n            for item in self._elements:\n                if item not in unique_list:\n                    unique_list.append(item)\n            return unique_list\nclass CountResult:\n    \"\"\"Value object encapsulating integer result.\"\"\"\n    def __init__(self, count: int) -> None:\n        self._count = count\n\n    def as_int(self) -> int:\n        return self._count\nclass OccurrenceCounter:\n    \"\"\"Validates inputs and computes the count.\"\"\"\n    def validate_inputs(self, tuple_input: Tuple[Any], list_input: List[Any]) -> bool:\n        \"\"\"Checks if inputs are a tuple and a list.\"\"\"\n        return isinstance(tuple_input, tuple) and isinstance(list_input, list)\n\n    def count(self, tuple_input: Tuple[Any], list_input: List[Any]) -> int:\n        \"\"\"Counts occurrences of list elements in the tuple.\"\"\"\n        list_wrapper = ListInput(list_input)\n        unique_target_elements = list_wrapper.to_unique_collection()\n\n        count = 0\n        tuple_wrapper = TupleInput(tuple_input)\n        \n        for i in range(tuple_wrapper.length()):\n            elem = tuple_wrapper.get(i)\n            if isinstance(unique_target_elements, set):\n                if elem in unique_target_elements:\n                    count += 1\n            else: # unique_target_elements is a list\n                if any(elem == target for target in unique_target_elements):\n                    count += 1\n        \n        result = CountResult(count)\n        return result.as_int()\ndef count_Occurrence(tuple_input: tuple, list_input: list) -> int:\n    \"\"\"\n    Counts the occurrence of all elements of list in a tuple.\n    Each tuple element is counted at most once.\n    \"\"\"\n    oc = OccurrenceCounter()\n    if not oc.validate_inputs(tuple_input, list_input):\n        raise TypeError(\"count_Occurrence requires (tuple, list) as arguments\")\n    result = oc.count(tuple_input, list_input)\n    return result"}
{"task_id": "Mbpp/445", "solution": "def _multiply_inner_tuples(a_i, b_i):\n    \"\"\"Performs element-wise multiplication of two inner tuples.\"\"\"\n    return tuple(x * y for x, y in zip(a_i, b_i))\ndef index_multiplication(a, b):\n    \"\"\"\n    Performs index-wise multiplication of tuple elements in two given tuples.\n    Inputs are validated for type and shape before computation.\n    \"\"\"\n    _validate_outer_tuples(a, b)\n\n    result_outer_tuple = []\n    for i, (inner_a, inner_b) in enumerate(zip(a, b)):\n        _validate_inner_pair(inner_a, inner_b, i)\n        _validate_elements_are_ints(inner_a, i)\n        _validate_elements_are_ints(inner_b, i)\n\n        multiplied_inner_tuple = _multiply_inner_tuples(inner_a, inner_b)\n        result_outer_tuple.append(multiplied_inner_tuple)\n\n    return tuple(result_outer_tuple)"}
