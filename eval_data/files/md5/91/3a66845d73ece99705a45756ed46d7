{"task_id": "Mbpp/742", "solution": "import math\nclass ValidationError(Exception):\n    \"\"\"Exception raised for invalid input values.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\n\n    def __str__(self):\n        return self.message\nclass NumericInput:\n    \"\"\"Represents a numeric input and provides validation checks.\"\"\"\n    def __init__(self, value):\n        self.value = value\n\n    def isNumeric(self) -> bool:\n        \"\"\"Checks if the input value is an integer or a float.\"\"\"\n        return isinstance(self.value, (int, float))\n\n    def isNonNegative(self) -> bool:\n        \"\"\"Checks if the input value is numeric and non-negative.\"\"\"\n        return self.isNumeric() and self.value >= 0\nclass Tetrahedron:\n    \"\"\"Represents a regular tetrahedron and computes its surface area.\"\"\"\n    def __init__(self, edgeLength: float):\n        self.edgeLength = edgeLength\n\n    def computeSurfaceArea(self) -> float:\n        \"\"\"Calculates the surface area of the tetrahedron using the formula sqrt(3) * edgeLength^2.\"\"\"\n        return math.sqrt(3) * (self.edgeLength ** 2)\ndef area_tetrahedron(length):\n    \"\"\"\n    Calculates the surface area of a regular tetrahedron given its edge length.\n\n    Raises ValidationError for non-numeric or negative input.\n    \"\"\"\n    validator = NumericInput(length)\n\n    if not validator.isNumeric():\n        raise ValidationError(\"non-numeric input\")\n\n    if not validator.isNonNegative():\n        raise ValidationError(\"negative length\")\n\n    tetra = Tetrahedron(float(length))\n    area = tetra.computeSurfaceArea()\n\n    return float(area)"}
{"task_id": "Mbpp/745", "solution": "from typing import List, Iterator\nclass Range:\n    \"\"\"Represents an inclusive integer range and provides iteration.\"\"\"\n    def __init__(self, start: int, end: int) -> None:\n        self.start = start\n        self.end = end\n\n    def is_empty(self) -> bool:\n        \"\"\"Checks if the range is empty (start > end).\"\"\"\n        return self.start > self.end\n\n    def iterate(self) -> Iterator[int]:\n        \"\"\"Iterates over integers in the range.\"\"\"\n        for i in range(self.start, self.end + 1):\n            yield i\nclass Digit:\n    \"\"\"Represents a single decimal digit.\"\"\"\n    def __init__(self, digit: int) -> None:\n        self.digit = digit\n\n    def value(self) -> int:\n        \"\"\"Returns the integer value of the digit.\"\"\"\n        return self.digit\nclass Number:\n    \"\"\"Encapsulates an integer and operations related to its digits.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n        self.digits: List[Digit] = self._extract_digits(value)\n\n    def _extract_digits(self, n: int) -> List[Digit]:\n        \"\"\"Extracts digits from an integer.\"\"\"\n        if n == 0:\n            return [Digit(0)]\n        \n        digits_list: List[Digit] = []\n        temp = abs(n)\n        while temp > 0:\n            digits_list.append(Digit(temp % 10))\n            temp //= 10\n        return digits_list[::-1]\n\n    def get_digits(self) -> List[Digit]:\n        \"\"\"Returns the list of Digit objects.\"\"\"\n        return self.digits\n\n    def hasZero(self) -> bool:\n        \"\"\"Checks if the number contains the digit 0.\"\"\"\n        for digit_obj in self.digits:\n            if digit_obj.value() == 0:\n                return True\n        return False\n\n    def isDivisibleByEachDigit(self) -> bool:\n        \"\"\"Checks if the number is divisible by each of its non-zero digits.\"\"\"\n        # Numbers containing digit 0 are assumed to be excluded before this check.\n        for digit_obj in self.digits:\n            digit_val = digit_obj.value()\n            if self.value % digit_val != 0:\n                return False\n        return True\nclass ResultList:\n    \"\"\"Collects qualifying integers and provides a sorted list.\"\"\"\n    def __init__(self) -> None:\n        self.numbers: List[int] = []\n\n    def append(self, n: int) -> None:\n        \"\"\"Adds an integer to the collection.\"\"\"\n        self.numbers.append(n)\n\n    def to_sorted_list(self) -> List[int]:\n        \"\"\"Returns the collected numbers as a new sorted list.\"\"\"\n        return sorted(self.numbers)\nclass DivisibleByDigitsService:\n    \"\"\"Orchestrates finding numbers divisible by their digits within a range.\"\"\"\n    def divisible_by_digits(self, startnum: int, endnum: int) -> List[int]:\n        \"\"\"Finds numbers in the range [startnum, endnum] divisible by each of their digits.\"\"\"\n        num_range = Range(startnum, endnum)\n        if num_range.is_empty():\n            return []\n\n        result_list = ResultList()\n        for i in num_range.iterate():\n            number = Number(i)\n            if number.hasZero():\n                continue\n            \n            if number.isDivisibleByEachDigit():\n                result_list.append(i)\n                \n        return result_list.to_sorted_list()\ndef divisible_by_digits(startnum: int, endnum: int) -> List[int]:\n    \"\"\"\n    Finds numbers within a given range where every number is divisible by every digit it contains.\n    Numbers containing digit 0 are excluded, and the result is sorted.\n    \"\"\"\n    service = DivisibleByDigitsService()\n    return service.divisible_by_digits(startnum, endnum)"}
