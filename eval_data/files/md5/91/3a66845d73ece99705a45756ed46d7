{"task_id": "Mbpp/470", "solution": "from typing import Iterable, Iterator, List, Union\nclass Tuple:\n    \"\"\"Constructs domain Tuple from iterable of numeric values.\"\"\"\n    _elements: List[Union[float, int]]\n\n    def __init__(self, elements: Iterable[Union[float, int]]):\n        self._elements = list(elements)\n\n    def get_elements(self) -> List[Union[float, int]]:\n        return self._elements\n\n    def __len__(self) -> int:\n        return len(self._elements)\n\n    def __iter__(self) -> Iterator[Union[float, int]]:\n        return iter(self._elements)\nclass ResultTuple:\n    \"\"\"Constructs ResultTuple from iterable of numeric values.\"\"\"\n    _elements: List[Union[float, int]]\n\n    def __init__(self, elements: Iterable[Union[float, int]]):\n        self._elements = list(elements)\n\n    def get_elements(self) -> List[Union[float, int]]:\n        return self._elements\n\n    def to_builtin_tuple(self) -> tuple:\n        return tuple(self._elements)\n\n    def __len__(self) -> int:\n        return len(self._elements)\nclass PairwiseSum:\n    \"\"\"Compute pairwise sums of neighboring elements from a domain.Tuple and return a domain.ResultTuple.\"\"\"\n    def compute(self, input_tuple_domain: \"Tuple\") -> \"ResultTuple\":\n        elements = input_tuple_domain.get_elements()\n        sums = []\n        for i in range(len(elements) - 1):\n            sums.append(elements[i] + elements[i+1])\n        return ResultTuple(sums)\ndef add_pairwise(input_tuple: tuple) -> tuple:\n    \"\"\"Public API. Accepts a Python tuple of numeric values and returns a Python tuple of pairwise sums.\n    Behavior: Wrap input into domain.models.Tuple, call PairwiseSum.compute, convert ResultTuple to built-in tuple and return.\n    \"\"\"\n    domain_tuple = Tuple(input_tuple)\n    pairwise_sum_calculator = PairwiseSum()\n    result_tuple_domain = pairwise_sum_calculator.compute(domain_tuple)\n    return result_tuple_domain.to_builtin_tuple()"}
{"task_id": "Mbpp/463", "solution": "from dataclasses import dataclass\nfrom typing import List, Union, Iterator\ndef max_subarray_product(input_list: List[int]) -> Union[int, float]:\n    \"\"\"Public API: accepts a list of integers and returns numeric max product.\n    Raises ValueError if input_list is empty, or TypeError if any element is not int.\n    \"\"\"\n\n    if not input_list:\n        raise ValueError(\"Input list cannot be empty.\")\n    \n    for element in input_list:\n        if not isinstance(element, int):\n            raise TypeError(\"All elements in the input list must be integers.\")\n\n    current_max = input_list[0]\n    current_min = input_list[0]\n    max_so_far = input_list[0]\n\n    for i in range(1, len(input_list)):\n        v = input_list[i]\n\n        if v == 0:\n            current_max = 0\n            current_min = 0\n            max_so_far = max(max_so_far, 0)\n            continue\n\n        # If v is negative, swap current_max and current_min\n        # This is because multiplying a negative number with current_max (largest positive)\n        # will make it the new minimum, and multiplying with current_min (smallest negative)\n        # will make it the new maximum.\n        if v < 0:\n            current_max, current_min = current_min, current_max\n\n        current_max = max(v, current_max * v)\n        current_min = min(v, current_min * v)\n\n        max_so_far = max(max_so_far, current_max)\n    \n    return max_so_far"}
{"task_id": "Mbpp/462", "solution": "from typing import Any, List\ndef combinations_list(input_list: List[Any]) -> List[List[Any]]:\n    \"\"\"\n    Generates all possible combinations (powerset) of elements from the input list.\n    Combinations are ordered by bitmask ascending; elements within each combination are in reverse input order.\n    \"\"\"\n    n = len(input_list)\n    if n == 0:\n        return [[]]\n\n    result: List[List[Any]] = []\n    total = 1 << n  # Calculates 2^n, the total number of combinations\n\n    for mask in range(total):  # Iterates through masks from 0 to 2^n - 1\n        comb_items: List[Any] = []\n        # Iterate through input elements from last to first to build elements in reverse input order\n        for index in range(n - 1, -1, -1):\n            # Determines the bit position associated with input_list[index].\n            # This mapping associates input_list[0] with bit 0 (LSB), and input_list[n-1] with bit n-1 (MSB).\n            bit_position = index\n            if ((mask >> bit_position) & 1) == 1:  # Check if the corresponding bit in the mask is set\n                comb_items.append(input_list[index])\n        result.append(comb_items)\n    return result"}
{"task_id": "Mbpp/471", "solution": "def _accumulate_product_mod(array, n) -> int:\n    \"\"\"Computes the product of array elements modulo n using iterative reduction.\"\"\"\n    product_mod = 1\n    for element in array:\n        product_mod = (product_mod * (element % n)) % n\n    return product_mod\ndef find_remainder(array, n) -> int:\n    \"\"\"\n    Finds the product of the array elements modulo n.\n    It validates inputs and uses iterative modular reduction to prevent large intermediate values.\n    \"\"\"\n    _validate_inputs(array, n)\n    return _accumulate_product_mod(array, n)"}
{"task_id": "Mbpp/468", "solution": "from typing import List, Tuple, Union\nNumber = Union[int, float]\ndef _product_of_slice(arr: List[Number], start: int, end: int) -> Number:\n    \"\"\"Compute multiplicative product of arr[start] through arr[end] inclusive.\"\"\"\n    product: Number = 1.0\n    for i in range(start, end + 1):\n        product *= arr[i]\n    return product\ndef _detect_increasing_subsequences(arr: List[Number]) -> List[Tuple[int, int]]:\n    \"\"\"\n    Returns a list of inclusive index ranges (start, end) for subsequences.\n    Includes all single-element subsequences and all maximal contiguous strictly increasing subsequences.\n    \"\"\"\n    if not arr:\n        return []\n\n    subsequences = set()\n\n    # Add all single-element subsequences (i, i)\n    for i in range(len(arr)):\n        subsequences.add((i, i))\n\n    # Find and add maximal contiguous strictly increasing subsequences of length > 1\n    start_index = 0\n    for i in range(1, len(arr)):\n        if arr[i] > arr[i-1]:\n            # Subsequence continues\n            pass\n        else:\n            # Subsequence ends at i-1. If it's a multi-element sequence, add it.\n            if start_index < i - 1:\n                subsequences.add((start_index, i - 1))\n            start_index = i\n    \n    # Add the last maximal subsequence if it's a multi-element sequence\n    if start_index < len(arr) - 1:\n        subsequences.add((start_index, len(arr) - 1))\n    \n    return sorted(list(subsequences))\ndef max_product(arr: List[Number]) -> Number:\n    \"\"\"Return maximum product across contiguous strictly increasing subsequences of arr.\"\"\"\n    if not arr:\n        return 0.0\n\n    subsequences = _detect_increasing_subsequences(arr)\n\n    max_prod: Number = float('-inf')\n\n    for start, end in subsequences:\n        current_product = _product_of_slice(arr, start, end)\n        if current_product > max_prod:\n            max_prod = current_product\n    \n    return max_prod"}
{"task_id": "Mbpp/472", "solution": "from typing import List\ndef check_Consecutive(input_list: List[int]) -> bool:\n    \"\"\"\n    Checks if the given list contains consecutive numbers in ascending order.\n    Assumes the input_list is a list of integers.\n    \"\"\"\n    if not input_list:\n        # An empty list is considered vacuously true for consecutiveness.\n        return True\n\n    # For lists with one element, there are no adjacent pairs to check.\n    # The loop range will be empty, making the condition vacuously true.\n    for i in range(len(input_list) - 1):\n        if input_list[i+1] != input_list[i] + 1:\n            return False\n    return True"}
{"task_id": "Mbpp/473", "solution": "from typing import List, Set, Tuple, Union\nclass TuplePair:\n    \"\"\"Represents a 2-element tuple, providing canonicalization and unordered comparison.\"\"\"\n    def __init__(self, a: int, b: int) -> None:\n        self.a = a\n        self.b = b\n\n    def canonicalize(self) -> 'TuplePair':\n        \"\"\"Returns a new TuplePair with elements sorted in ascending order.\"\"\"\n        return TuplePair(min(self.a, self.b), max(self.a, self.b))\n\n    def to_tuple(self) -> Tuple[int, int]:\n        \"\"\"Converts the TuplePair to a built-in tuple.\"\"\"\n        return (self.a, self.b)\n\n    def equals_unordered(self, other: 'TuplePair') -> bool:\n        \"\"\"Checks if two TuplePair objects are equal irrespective of order.\"\"\"\n        return (self.a == other.a and self.b == other.b) or \\\n               (self.a == other.b and self.b == other.a)\nclass TupleList:\n    \"\"\"Manages a list of 2-element tuples and converts them to a set of canonical built-in tuples.\"\"\"\n    def __init__(self, tuples: List[Union[Tuple[int, int], TuplePair]]) -> None:\n        self.pairs: List[TuplePair] = []\n        for item in tuples:\n            if isinstance(item, TuplePair):\n                self.pairs.append(item)\n            else: # Assumed to be Tuple[int,int] based on type hint and design context\n                self.pairs.append(TuplePair(item[0], item[1]))\n\n    def to_canonical_set(self) -> Set[Tuple[int, int]]:\n        \"\"\"Canonicalizes all contained pairs and returns them as a set of built-in tuples.\"\"\"\n        canonical_set: Set[Tuple[int, int]] = set()\n        for pair in self.pairs:\n            canonical_pair = pair.canonicalize()\n            canonical_set.add(canonical_pair.to_tuple())\n        return canonical_set\nclass TupleIntersectionFunction:\n    \"\"\"Provides the core logic for computing the tuple intersection.\"\"\"\n    @staticmethod\n    def tuple_intersection(list_a: List[Union[Tuple[int, int], TuplePair]],\n                           list_b: List[Union[Tuple[int, int], TuplePair]]) -> Set[Tuple[int, int]]:\n        \"\"\"Computes the intersection of two lists of 2-element tuples as a set of canonical tuples.\"\"\"\n        tuple_list_a = TupleList(list_a)\n        tuple_list_b = TupleList(list_b)\n\n        canonical_set_a = tuple_list_a.to_canonical_set()\n        canonical_set_b = tuple_list_b.to_canonical_set()\n\n        return canonical_set_a.intersection(canonical_set_b)\ndef tuple_intersection(list_a: List[Union[Tuple[int, int], TuplePair]],\n                       list_b: List[Union[Tuple[int, int], TuplePair]]) -> Set[Tuple[int, int]]:\n    \"\"\"\n    Finds the tuple intersection of elements in the given tuple list irrespective of their order.\n    Returns a set of canonical 2-element tuples (min, max).\n    \"\"\"\n    return TupleIntersectionFunction.tuple_intersection(list_a, list_b)"}
{"task_id": "Mbpp/474", "solution": "def replace_char(input_string, target_char, replacement_char):\n    \"\"\"\n    Replace every occurrence of target_char in input_string with replacement_char.\n    Validates inputs and returns the modified string, or the original if no target_char found.\n    \"\"\"\n    _validate_inputs(input_string, target_char, replacement_char)\n    if target_char not in input_string:\n        return input_string\n    return input_string.replace(target_char, replacement_char)"}
