{"task_id": "Mbpp/108", "solution": "from typing import List\nclass OutputList:\n    \"\"\"A thin wrapper for the sorted result, used internally before returning a raw list.\"\"\"\n    def __init__(self, elements: List[int]):\n        self._elements = list(elements)\n\n    def length(self) -> int:\n        return len(self._elements)\n\n    def get_elements(self) -> List[int]:\n        return list(self._elements)\nclass MergeSortedListFunction:\n    \"\"\"A stateless orchestrator for validating, combining, and sorting lists.\"\"\"\n    def validate_inputs(self, list1: list, list2: list, list3: list) -> bool:\n        \"\"\"Validates that all inputs are lists and contain only integers.\"\"\"\n        for lst_arg in [list1, list2, list3]:\n            if not isinstance(lst_arg, list):\n                raise ValueError(\"All arguments must be lists.\")\n            for element in lst_arg:\n                if not isinstance(element, int):\n                    raise ValueError(\"All list elements must be integers.\")\n        return True\n\n    def combine(self, list1: List[int], list2: List[int], list3: List[int]) -> List[int]:\n        \"\"\"Combines elements from the three input lists into a single new list.\"\"\"\n        combined_list = list(list1) + list(list2) + list(list3)\n        return combined_list\n\n    def sort(self, items: List[int]) -> List[int]:\n        \"\"\"Sorts a list of integers in ascending order and returns a new sorted list.\"\"\"\n        return sorted(items)\n\n    def merge(self, list1: List[int], list2: List[int], list3: List[int]) -> List[int]:\n        \"\"\"Orchestrates the validation, combining, and sorting process.\"\"\"\n        self.validate_inputs(list1, list2, list3)\n        combined_elements = self.combine(list1, list2, list3)\n        sorted_elements = self.sort(combined_elements)\n        output = OutputList(sorted_elements)\n        return output.get_elements()\ndef merge_sorted_list(list1: List[int], list2: List[int], list3: List[int]) -> List[int]:\n    \"\"\"\n    Merges three lists into a single sorted list.\n    It validates inputs, combines elements, sorts them, and returns a new list.\n    \"\"\"\n    merger = MergeSortedListFunction()\n    return merger.merge(list1, list2, list3)"}
{"task_id": "Mbpp/116", "solution": "from typing import List, Optional, Any, Tuple\nclass TupleInput:\n    \"\"\"Represents the ordered collection of integer elements.\"\"\"\n    def __init__(self, elements: List[int]):\n        self.elements = elements\nclass IntegerElement:\n    \"\"\"Represents a single integer element and provides its decimal string representation.\"\"\"\n    def __init__(self, value: int, position: int):\n        self.value = value\n        self.position = position\n\n    def to_decimal_str(self) -> str:\n        \"\"\"Returns the decimal string representation of the integer value.\"\"\"\n        return str(self.value)\nclass ValidationResult:\n    \"\"\"Provides validation outcome and optional error message.\"\"\"\n    def __init__(self, is_valid: bool, error_message: Optional[str] = None):\n        self.is_valid = is_valid\n        self.error_message = error_message\nclass Validator:\n    \"\"\"Validates raw input according to SRS business rules.\"\"\"\n    def validate_tuple(self, t: Any) -> ValidationResult:\n        \"\"\"Performs validation checks on the input tuple.\"\"\"\n        if not isinstance(t, tuple):\n            return ValidationResult(False, \"Input must be a tuple.\")\n        if not t:\n            return ValidationResult(False, \"Tuple must not be empty.\")\n        for element in t:\n            if not isinstance(element, int):\n                return ValidationResult(False, \"All elements must be integers.\")\n            if element <= 0:\n                return ValidationResult(False, \"All elements must be positive integers.\")\n        return ValidationResult(True)\nclass TupleConverter:\n    \"\"\"Converts a validated TupleInput into a ResultInteger.\"\"\"\n    def tuple_to_int(self, tup: TupleInput) -> int:\n        \"\"\"Converts TupleInput to a single integer by concatenating elements.\"\"\"\n        elements_for_conversion = [\n            IntegerElement(value, i) for i, value in enumerate(tup.elements)\n        ]\n        concatenated_string = self._concatenate(elements_for_conversion)\n        return int(concatenated_string)\n\n    def _concatenate(self, elements: List[IntegerElement]) -> str:\n        \"\"\"Concatenates decimal strings of IntegerElement objects.\"\"\"\n        return \"\".join(element.to_decimal_str() for element in elements)\ndef tuple_to_int(t: Tuple[int, ...]) -> int:\n    \"\"\"Converts a tuple of positive integers into a single integer.\n    Raises TypeError or ValueError on invalid input per design.\n    \"\"\"\n    validator = Validator()\n    validation_result = validator.validate_tuple(t)\n\n    if not validation_result.is_valid:\n        error_message = validation_result.error_message\n        if error_message == \"Input must be a tuple.\" or error_message == \"All elements must be integers.\":\n            raise TypeError(error_message)\n        elif error_message == \"Tuple must not be empty.\" or error_message == \"All elements must be positive integers.\":\n            raise ValueError(error_message)\n        else:\n            raise ValueError(f\"An unexpected validation error occurred: {error_message}\")\n\n    tuple_input = TupleInput(list(t))\n    converter = TupleConverter()\n    result_int = converter.tuple_to_int(tuple_input)\n    return result_int"}
{"task_id": "Mbpp/109", "solution": "class BinaryString:\n    \"\"\"Encapsulates a binary string value and its length.\"\"\"\n    def __init__(self, value: str) -> None:\n        self.value = value\n        self.length = len(value)\n\n    def is_valid(self) -> bool:\n        \"\"\"Checks if the binary string is non-empty and contains only '0' or '1'.\"\"\"\n        return bool(self.value) and all(c in '01' for c in self.value)\n\n    def at(self, index: int) -> str:\n        \"\"\"Returns the character at the specified index.\"\"\"\n        return self.value[index]\nclass Validator:\n    \"\"\"Provides stateless validation logic for binary strings and rotation counts.\"\"\"\n    def validate_binary_string(self, s: str) -> None:\n        \"\"\"Validates that the input string is non-empty and contains only '0' or '1'.\"\"\"\n        if not s:\n            raise ValueError(\"Binary string cannot be empty.\")\n        if not all(c in '01' for c in s):\n            raise ValueError(\"Binary string must contain only '0' or '1'.\")\n\n    def validate_rotations(self, r: int) -> None:\n        \"\"\"Validates that the rotation count is a non-negative integer.\"\"\"\n        if not isinstance(r, int):\n            raise ValueError(\"Rotations must be an integer.\")\n        if r < 0:\n            raise ValueError(\"Rotations cannot be negative.\")\nclass RotationOperation:\n    \"\"\"Performs a single right cyclic rotation on a binary string.\"\"\"\n    def __init__(self, rotation_index: int = 0) -> None:\n        self.rotation_index = rotation_index\n\n    def rotate_right_once(self, b: BinaryString) -> str:\n        \"\"\"Rotates the binary string once to the right (last char to front).\"\"\"\n        if not b.value:\n            return \"\"\n        return b.value[-1] + b.value[:-1]\nclass OddEvaluator:\n    \"\"\"Determines if a rotated binary string represents an odd number.\"\"\"\n    def is_odd(self, rotated_value: str) -> bool:\n        \"\"\"Checks if the least-significant bit (rightmost character) is '1'.\"\"\"\n        if not rotated_value:\n            return False # An empty string cannot be odd.\n        return rotated_value[-1] == '1'\nclass Result:\n    \"\"\"Maintains and provides the count of odd rotations.\"\"\"\n    def __init__(self) -> None:\n        self.odd_count = 0\n\n    def increment(self) -> None:\n        \"\"\"Increments the count of odd rotations.\"\"\"\n        self.odd_count += 1\n\n    def get(self) -> int:\n        \"\"\"Returns the total count of odd rotations.\"\"\"\n        return self.odd_count\ndef odd_Equivalent(binary_string: str, rotations: int) -> int:\n    \"\"\"\n    Finds the number of times a binary string, when rotated, represents an odd number.\n\n    Performs successive right cyclic rotations and counts rotations that result in an odd value.\n    \"\"\"\n    validator = Validator()\n    validator.validate_binary_string(binary_string)\n    validator.validate_rotations(rotations)\n\n    b = BinaryString(binary_string)\n    result = Result()\n    rot_op = RotationOperation()\n    evaluator = OddEvaluator()\n\n    for i in range(1, rotations + 1):\n        rotated_value = rot_op.rotate_right_once(b)\n        b.value = rotated_value  # Update BinaryString object for next rotation\n        b.length = len(rotated_value) # Update length too, though it remains constant here\n        if evaluator.is_odd(rotated_value):\n            result.increment()\n\n    return result.get()"}
{"task_id": "Mbpp/120", "solution": "from dataclasses import dataclass\nfrom typing import List, Union\nclass Validator:\n    @staticmethod\n    def validate_input(input_data: List[tuple]) -> InputList:\n        if not isinstance(input_data, (list, tuple)):\n            raise TypeError(\"input must be a sequence of 2-tuples\")\n\n        if not input_data:\n            raise ValueError(\"input list must not be empty\")\n\n        validated_tuples: List[TuplePair] = []\n        for i, item in enumerate(input_data):\n            if not isinstance(item, (list, tuple)) or len(item) != 2:\n                raise TypeError(f\"Element at index {i} must be a 2-tuple\")\n\n            try:\n                a = float(item[0])\n                b = float(item[1])\n            except (ValueError, TypeError):\n                raise TypeError(f\"Elements in tuple at index {i} must be numeric\")\n\n            validated_tuples.append(TuplePair(a, b))\n\n        return InputList(tuples=validated_tuples)\nclass ProductCalculator:\n    def compute_absolute_product(self, t: TuplePair) -> float:\n        return abs(t.get_product())\n\n    def max_absolute_product(self, input_list: InputList) -> Result:\n        running_max: Union[float, None] = None\n\n        for t in input_list.tuples:\n            val = self.compute_absolute_product(t)\n            if running_max is None or val > running_max:\n                running_max = val\n        \n        # According to design, an empty list would have been caught by Validator,\n        # so running_max will always be a float here.\n        return Result(max_product=running_max if running_max is not None else 0.0)\ndef max_product_tuple(input_list: List[tuple]) -> float:\n    \"\"\"\n    Finds the maximum absolute product between numbers in pairs of tuples within a given list.\n    \"\"\"\n    input_domain = Validator.validate_input(input_list)\n    calculator = ProductCalculator()\n    result = calculator.max_absolute_product(input_domain)\n    return result.max_product"}
{"task_id": "Mbpp/125", "solution": "from dataclasses import dataclass\nfrom typing import Iterator\ndef _compute_difference(sub: Substring) -> int:\n    \"\"\"Returns the difference (zero_count - one_count) for a given Substring.\"\"\"\n    return sub.difference()\ndef find_length(s: str) -> int:\n    \"\"\"\n    Finds the maximum difference between the number of 0s and 1s\n    in any sub-string of the given binary string.\n    \"\"\"\n    # Validate input string contains only '0' or '1' characters.\n    binary_str = BinaryString(s)\n\n    max_diff = float('-inf')\n    found_any_substring = False\n\n    for sub in _generate_substrings(binary_str.value):\n        found_any_substring = True\n        current_diff = _compute_difference(sub)\n        if current_diff > max_diff:\n            max_diff = current_diff\n    \n    # If no substrings were found (i.e., input string was empty),\n    # return 0 as no difference could be computed.\n    if not found_any_substring:\n        return 0\n    \n    return int(max_diff)"}
{"task_id": "Mbpp/124", "solution": "import math\ndef angle_complex(real, imag) -> float:\n    \"\"\"\n    Computes the argument (angle) of a complex number in radians.\n    Coerces inputs to numeric floats, handling complex numbers by their real/imag components.\n    \"\"\"\n    try:\n        if isinstance(real, complex):\n            real_f = real.real\n        else:\n            real_f = float(real)\n    except (ValueError, TypeError):\n        raise TypeError(\"invalid numeric input\")\n\n    try:\n        if isinstance(imag, complex):\n            imag_f = imag.imag\n        else:\n            imag_f = float(imag)\n    except (ValueError, TypeError):\n        raise TypeError(\"invalid numeric input\")\n\n    return math.atan2(imag_f, real_f)"}
