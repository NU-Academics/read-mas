{"task_id": "Mbpp/237", "solution": "from typing import List, Tuple, Dict\ndef _normalize_pair(pair: Tuple[int, int]) -> Tuple[int, int]:\n    \"\"\"Returns a 2-element tuple with elements sorted in ascending order.\"\"\"\n    return (min(pair[0], pair[1]), max(pair[0], pair[1]))\ndef check_occurences(input_list: List[Tuple[int, int]]) -> Dict[Tuple[int, int], int]:\n    \"\"\"\n    Processes a list of 2-element tuples, normalizes them, and returns\n    a dictionary mapping each unique normalized tuple to its occurrence count.\n    \"\"\"\n    counts: Dict[Tuple[int, int], int] = {}\n    for pair in input_list:\n        key = _normalize_pair(pair)\n        counts[key] = counts.get(key, 0) + 1\n    return counts"}
{"task_id": "Mbpp/235", "solution": "def _generate_even_bit_mask(bit_length: int) -> int:\n    \"\"\"Return mask with bits set at zero-based indices 1,3,5,... up to bit_length-1.\"\"\"\n    mask = 0\n    for i in range(1, bit_length, 2):\n        mask |= (1 << i)\n    return mask\ndef even_bit_set_number(n: int) -> int:\n    \"\"\"Return int where even-positioned bits (1-indexed LSB) are set to 1.\"\"\"\n    bit_length = n.bit_length()\n    mask = _generate_even_bit_mask(bit_length)\n    return n | mask"}
{"task_id": "Mbpp/239", "solution": "import functools\nclass Validator:\n    def validatePositiveIntegers(self, m: int, n: int) -> bool:\n        \"\"\"Validates if m and n are positive integers (integers >= 1).\"\"\"\n        return isinstance(m, int) and isinstance(n, int) and m >= 1 and n >= 1\nclass InputParameter:\n    def __init__(self, m: int, n: int):\n        self.m = m\n        self.n = n\n\n    def validate(self) -> None:\n        \"\"\"Validates the stored m and n, raising ValueError if invalid.\"\"\"\n        validator = Validator()\n        if not validator.validatePositiveIntegers(self.m, self.n):\n            raise ValueError(\"m and n must be positive integers.\")\ndef get_total_number_of_sequences(m, n) -> int:\n    \"\"\"\n    Calculates the number of sequences of length n such that each element\n    is a positive integer, less than or equal to m, and greater than or\n    equal to twice the previous element.\n    \"\"\"\n    params = InputParameter(m, n)\n    params.validate()\n    return _count_sequences_from(1, n, m)"}
