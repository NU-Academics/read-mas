{"task_id": "Mbpp/622", "solution": "from typing import List, Union\nclass InputArray:\n    \"\"\"Wrapper over a list with derived properties and validation helpers.\"\"\"\n    def __init__(self, elements: List[Union[int, float]]):\n        self.elements = elements\n        self.length = len(elements)\n\n    def is_sorted(self) -> bool:\n        \"\"\"Checks if the array is sorted in non-decreasing order.\"\"\"\n        for i in range(self.length - 1):\n            if self.elements[i] > self.elements[i+1]:\n                return False\n        return True\nclass Validator:\n    \"\"\"Stateless utility for input validation.\"\"\"\n\n    @staticmethod\n    def validate_length(arr: InputArray, n: int, name: str) -> None:\n        \"\"\"Validates if the array's length matches n.\"\"\"\n        if arr.length != n:\n            raise ValueError(f\"Length mismatch: {name} has length {arr.length}, expected {n}\")\n\n    @staticmethod\n    def validate_sorted(arr: InputArray, name: str) -> None:\n        \"\"\"Validates if the array is sorted in non-decreasing order.\"\"\"\n        if not arr.is_sorted():\n            raise ValueError(f\"Array not sorted: {name} is not in non-decreasing order\")\n\n    @staticmethod\n    def validate_numeric(arr: InputArray, name: str) -> None:\n        \"\"\"Validates if all elements in the array are numeric (int or float).\"\"\"\n        for element in arr.elements:\n            if not isinstance(element, (int, float)):\n                raise ValueError(f\"Non-numeric element found in {name}: {element}\")\nclass MedianFunction:\n    \"\"\"Encapsulates median computation logic.\"\"\"\n\n    @staticmethod\n    def _compute_median_from_validated(arr1: List[Union[int, float]], arr2: List[Union[int, float]], n: int) -> float:\n        \"\"\"\n        Computes the median of two sorted arrays of equal size n.\n        Assumes inputs are already validated for length, sortedness, and numeric types.\n        \"\"\"\n        m1 = 0\n        m2 = 0\n        i = 0  # Pointer for arr1\n        j = 0  # Pointer for arr2\n\n        # The median of 2n elements is the average of the n-th and (n+1)-th smallest elements (1-based).\n        # In 0-based indexing, these are elements at positions n-1 and n.\n        # The loop iterates n+1 times to ensure m1 holds the n-th element and m2 holds the (n+1)-th.\n        for count in range(n + 1):\n            m1 = m2 # m1 always stores the element found in the previous iteration of m2\n\n            # Compare elements from both arrays\n            if i < n and j < n:\n                if arr1[i] <= arr2[j]:\n                    m2 = arr1[i]\n                    i += 1\n                else:\n                    m2 = arr2[j]\n                    j += 1\n            # If one array is exhausted, take from the other\n            elif i < n: # arr2 is exhausted\n                m2 = arr1[i]\n                i += 1\n            elif j < n: # arr1 is exhausted\n                m2 = arr2[j]\n                j += 1\n            # If n > 0, the arrays are guaranteed to have length n, so one of the above branches will always execute.\n\n        return (float(m1) + float(m2)) / 2.0\ndef get_median(arr1: list, arr2: list, n: int) -> float:\n    \"\"\"\n    Finds the median of two sorted lists of the same size n.\n    Validates inputs and computes the median as the average of the n-th and (n+1)-th smallest elements.\n    \"\"\"\n    # Wrap input lists for validation\n    input_arr1 = InputArray(arr1)\n    input_arr2 = InputArray(arr2)\n\n    # Perform all required input validations\n    Validator.validate_length(input_arr1, n, \"arr1\")\n    Validator.validate_length(input_arr2, n, \"arr2\")\n    Validator.validate_sorted(input_arr1, \"arr1\")\n    Validator.validate_sorted(input_arr2, \"arr2\")\n    Validator.validate_numeric(input_arr1, \"arr1\")\n    Validator.validate_numeric(input_arr2, \"arr2\")\n\n    # Delegate to the computation logic using the raw lists (which are validated)\n    median_value = MedianFunction._compute_median_from_validated(arr1, arr2, n)\n\n    return median_value"}
{"task_id": "Mbpp/626", "solution": "def validate(radius):\n    \"\"\"\n    Validate the radius according to SRS rules.\n    Returns:\n      - None when radius < 0 (per FR3)\n      - 0.0 when radius == 0 (per FR4)\n      - float(radius) when radius > 0 (per FR5/FR6)\n    \"\"\"\n    if radius < 0:\n        return None\n    if radius == 0:\n        return 0.0\n    return float(radius)\ndef triangle_area(radius):\n    \"\"\"\n    Public API: compute area of largest triangle inscribed in a semicircle of radius.\n    Behavior:\n      - radius < 0 -> return None\n      - radius == 0 -> return 0.0 (float)\n      - radius > 0 -> return radius * radius (float)\n    \"\"\"\n    v = validate(radius)\n    if v is None:\n        return None\n    if v == 0.0:\n        return 0.0\n    return float(v * v)"}
{"task_id": "Mbpp/629", "solution": "def Split(numbers):\n    \"\"\"\n    Finds even numbers from a list of numbers, preserving their original order.\n    Returns a new list containing only the even numbers.\n    \"\"\"\n    even_numbers = []\n    for number in numbers:\n        if number % 2 == 0:\n            even_numbers.append(number)\n    return even_numbers"}
{"task_id": "Mbpp/630", "solution": "from typing import List, Tuple\nclass Coordinate:\n    \"\"\"Models a single 2D integer coordinate.\"\"\"\n    def __init__(self, x: int, y: int) -> None:\n        self.x = x\n        self.y = y\n\n    def toList(self) -> List[int]:\n        \"\"\"Converts the coordinate to a list [x, y].\"\"\"\n        return [self.x, self.y]\nclass CoordinateList:\n    \"\"\"Holds an ordered list of coordinate pairs.\"\"\"\n    def __init__(self, coordinates: List[List[int]]) -> None:\n        self.coordinates = coordinates\n\n    def asList(self) -> List[List[int]]:\n        \"\"\"Returns the stored list of coordinate pairs.\"\"\"\n        return self.coordinates\nclass CoordinateService:\n    \"\"\"Computes the ordered 3x3 neighborhood of a given coordinate.\"\"\"\n    def get_coordinates(self, coord: Tuple[int, int]) -> List[List[int]]:\n        \"\"\"\n        Calculates the 3x3 neighborhood centered on the given coordinate.\n        The resulting list is ordered by x ascending, then by y ascending.\n        \"\"\"\n        center_x, center_y = coord\n        neighborhood_coords: List[List[int]] = []\n\n        for dx in [-1, 0, 1]:\n            for dy in [-1, 0, 1]:\n                new_x = center_x + dx\n                new_y = center_y + dy\n                coordinate = Coordinate(new_x, new_y)\n                neighborhood_coords.append(coordinate.toList())\n        \n        return CoordinateList(neighborhood_coords).asList()\ndef get_coordinates(coord: Tuple[int, int]) -> List[List[int]]:\n    \"\"\"\n    Extracts all adjacent coordinates of the given coordinate tuple, including itself.\n    The result is an ordered list of 3x3 neighborhood coordinates.\n    \"\"\"\n    service = CoordinateService()\n    return service.get_coordinates(coord)"}
{"task_id": "Mbpp/632", "solution": "from typing import List\ndef move_zero(input_list: List[int]) -> List[int]:\n    \"\"\"Return a list with non-zero integers in original relative order followed by all zeros.\n\n    This function iterates the input list, collects non-zero elements, counts zeros, then constructs and returns a new list.\n    \"\"\"\n    non_zeros = []\n    zero_count = 0\n    for element in input_list:\n        if element != 0:\n            non_zeros.append(element)\n        else:\n            zero_count += 1\n    return non_zeros + [0] * zero_count"}
{"task_id": "Mbpp/631", "solution": "def replace_spaces(input_string: str, mode: str = None) -> str:\n    \"\"\"\n    Replaces spaces with underscores or vice versa in a string.\n    Handles input validation and mode selection for transformation.\n    \"\"\"\n    if input_string is None:\n        raise ValueError(\"input_string must not be None\")\n    if not isinstance(input_string, str):\n        raise TypeError(\"input_string must be of type str\")\n\n    if not input_string:\n        return \"\"\n\n    if mode is None:\n        actual_mode = \"space_to_underscore\"\n    else:\n        actual_mode = mode\n\n    if actual_mode not in {\"space_to_underscore\", \"underscore_to_space\"}:\n        raise ValueError(\"invalid mode\")\n\n    result_chars = []\n    if actual_mode == \"space_to_underscore\":\n        for char in input_string:\n            if char == ' ':\n                result_chars.append('_')\n            else:\n                result_chars.append(char)\n    else:  # actual_mode == \"underscore_to_space\"\n        for char in input_string:\n            if char == '_':\n                result_chars.append(' ')\n            else:\n                result_chars.append(char)\n\n    return \"\".join(result_chars)"}
{"task_id": "Mbpp/633", "solution": "def pair_xor_Sum(values, n):\n    \"\"\"\n    Calculates the sum of XOR of all unique pairs of numbers from the first n elements of the given list.\n    It considers pairs (values[i], values[j]) where i < j.\n    \"\"\"\n    selected_elements = values[0:n]\n    total_xor_sum = 0\n    num_elements = len(selected_elements)\n\n    for i in range(num_elements):\n        for j in range(i + 1, num_elements):\n            total_xor_sum += (selected_elements[i] ^ selected_elements[j])\n\n    return total_xor_sum"}
{"task_id": "Mbpp/635", "solution": "def heap_sort(input_list: list) -> list:\n    \"\"\"\n    Sorts a list in ascending order using the heap sort algorithm.\n    Creates a new list to avoid modifying the input list in-place.\n    \"\"\"\n    arr = list(input_list)\n    n = len(arr)\n\n    def heapify(arr_inner: list, heap_size: int, root_index: int) -> None:\n        \"\"\"Maintains the max-heap property for a subtree rooted at root_index.\"\"\"\n        largest = root_index\n        left_child = 2 * root_index + 1\n        right_child = 2 * root_index + 2\n\n        if left_child < heap_size and arr_inner[left_child] > arr_inner[largest]:\n            largest = left_child\n\n        if right_child < heap_size and arr_inner[right_child] > arr_inner[largest]:\n            largest = right_child\n\n        if largest != root_index:\n            arr_inner[root_index], arr_inner[largest] = arr_inner[largest], arr_inner[root_index]\n            heapify(arr_inner, heap_size, largest)\n\n    # Build a max-heap (rearrange array)\n    # Iterate from the last non-leaf node up to the root.\n    for i in range(n // 2 - 1, -1, -1):\n        heapify(arr, n, i)\n\n    # One by one extract elements from the heap\n    # Loop from the last element down to the second element (index 1).\n    for i in range(n - 1, 0, -1):\n        # Move current root (largest element) to end of array.\n        arr[i], arr[0] = arr[0], arr[i]\n        # Call heapify on the reduced heap.\n        heapify(arr, i, 0)\n\n    return arr"}
