{"task_id": "Mbpp/394", "solution": "def check_distinct(tuple):\n    \"\"\"Return True if all elements in the provided tuple are pairwise unequal (using ==); otherwise return False.\n\n    Parameters:\n    - tuple: tuple -- input tuple to check (as required by FR-1). The function does not modify this object.\n\n    Returns:\n    - bool\n    \"\"\"\n    return len(set(tuple)) == len(tuple)"}
{"task_id": "Mbpp/392", "solution": "class ValidationException(Exception):\n    \"\"\"Exception raised for invalid input values.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\nclass MemoizationCache:\n    \"\"\"Cache for memoizing computed values.\"\"\"\n    def __init__(self):\n        self._cache = {}\n\n    def get(self, n: int) -> int | None:\n        return self._cache.get(n)\n\n    def put(self, n: int, value: int) -> None:\n        self._cache[n] = value\n_cache: MemoizationCache = MemoizationCache()\ndef get_max_sum(n: int) -> int:\n    \"\"\"\n    Compute f(n) = max(get_max_sum(n//2) + get_max_sum(n//3) + get_max_sum(n//4) + get_max_sum(n//5), n).\n    Raises ValidationException for negative n.\n    \"\"\"\n    if n < 0:\n        raise ValidationException(\"n must be non-negative\")\n\n    cached_value = _cache.get(n)\n    if cached_value is not None:\n        return cached_value\n\n    if n == 0 or n == 1:\n        value = n\n    else:\n        sum_of_children = (\n            get_max_sum(n // 2) +\n            get_max_sum(n // 3) +\n            get_max_sum(n // 4) +\n            get_max_sum(n // 5)\n        )\n        value = max(sum_of_children, n)\n\n    _cache.put(n, value)\n    return value"}
{"task_id": "Mbpp/391", "solution": "from typing import List, Any, Dict\nclass ErrorHandler:\n    \"\"\"Centralizes raising ValueError and TypeError with consistent messages.\"\"\"\n    @staticmethod\n    def raise_value_error(msg: str) -> None:\n        raise ValueError(msg)\n\n    @staticmethod\n    def raise_type_error(msg: str) -> None:\n        raise TypeError(msg)\nclass Validator:\n    \"\"\"Validates inputs according to SRS rules using ErrorHandler.\"\"\"\n    @staticmethod\n    def validate_count(lists: List[List]) -> None:\n        if len(lists) < 2:\n            ErrorHandler.raise_value_error(\"At least two lists are required for conversion.\")\n\n    @staticmethod\n    def validate_lengths(lists: List[List]) -> None:\n        if not lists:\n            return # This case should typically be caught by validate_count for insufficient lists\n        first_list_length = len(lists[0])\n        for i, lst in enumerate(lists):\n            if len(lst) != first_list_length:\n                ErrorHandler.raise_value_error(f\"Lists must have equal length. List 0 has {first_list_length} elements, but list {i} has {len(lst)}.\")\n\n    @staticmethod\n    def validate_hashable(keys: List[Any]) -> None:\n        for key in keys:\n            try:\n                hash(key)\n            except TypeError:\n                ErrorHandler.raise_type_error(f\"Unhashable type detected for dictionary key: {type(key).__name__}.\")\nclass NestedDictionaryBuilder:\n    \"\"\"Builds nested dictionary structures per index and produces an ordered list.\"\"\"\n    @staticmethod\n    def build_at_index(lists: List[List], index: int) -> Dict:\n        num_lists = len(lists)\n        \n        # Start with the innermost value, which is from the last list at the given index\n        current_nested_structure: Any = lists[num_lists - 1][index]\n\n        # Iterate backwards from the second to last list up to the first list\n        # to build the nested dictionary structure\n        for i in range(num_lists - 2, -1, -1):\n            key = lists[i][index]\n            current_nested_structure = {key: current_nested_structure}\n        \n        return current_nested_structure\n\n    @staticmethod\n    def build_all(lists: List[List]) -> List[Dict]:\n        result = []\n        # All lists are validated to have the same length by this point\n        if not lists:\n            return []\n        \n        num_elements = len(lists[0])\n        for i in range(num_elements):\n            result.append(NestedDictionaryBuilder.build_at_index(lists, i))\n        return result\ndef convert_list_dictionary(*lists_args: List[Any]) -> List[Dict]:\n    \"\"\"Converts multiple lists into a list of nested dictionaries.\n    Orchestrates validations and builds nested dictionaries according to the design.\n    \"\"\"\n    # Convert positional arguments to a single list of lists for internal processing.\n    lists_for_processing = list(lists_args)\n\n    Validator.validate_count(lists_for_processing)\n    Validator.validate_lengths(lists_for_processing)\n    # Validate hashability of the first list's elements, as these become the top-level keys.\n    Validator.validate_hashable(lists_for_processing[0]) \n    \n    return NestedDictionaryBuilder.build_all(lists_for_processing)"}
{"task_id": "Mbpp/395", "solution": "from typing import Optional\nfrom collections import Counter\ndef first_non_repeating_character(s: str) -> Optional[str]:\n    \"\"\"Return the first non-repeating character in the string `s`, or `None` if no such character exists.\n    Raises `TypeError` if `s` is not a string.\n    \"\"\"\n    if not isinstance(s, str):\n        raise TypeError(\"first_non_repeating_character expects a str\")\n\n    counts = Counter(s)\n\n    for ch in s:\n        if counts[ch] == 1:\n            return ch\n\n    return None"}
{"task_id": "Mbpp/398", "solution": "from typing import List, Iterable\nclass IntegerValue:\n    def __init__(self, value: int) -> None:\n        self.value = value\n\n    def digits(self) -> List[int]:\n        \"\"\"Return decimal digits of abs(self.value) as non-negative digits in MSB->LSB order.\"\"\"\n        abs_value_str = str(abs(self.value))\n        return [int(digit_char) for digit_char in abs_value_str]\nclass IntegerList:\n    def __init__(self, items: Iterable[int]) -> None:\n        self.items: List[int] = list(items)\nclass SumOfDigitsFunction:\n    def sum(self, numbers: List[int]) -> int:\n        \"\"\"Compute and return the sum of decimal digits across provided numbers.\"\"\"\n        overall_total = 0\n        \n        integer_list_obj = IntegerList(numbers)\n\n        for number in integer_list_obj.items:\n            integer_value = IntegerValue(number)\n            digits_of_number = integer_value.digits()\n            overall_total += sum(digits_of_number)\n        \n        return overall_total\ndef sum_of_digits(numbers: List[int]) -> int:\n    \"\"\"Compute sum of decimal digits of each integer in numbers and return total as int.\n    Example: assert sum_of_digits([10,2,56]) == 14\n    \"\"\"\n    return SumOfDigitsFunction().sum(numbers)"}
{"task_id": "Mbpp/397", "solution": "from typing import List\nclass NumericValue:\n    def __init__(self, value):\n        if not isinstance(value, (int, float)):\n            raise TypeError(\"Input must be a numeric value (int or float).\")\n        self.value = float(value)\n\n    def is_numeric(self) -> bool:\n        return isinstance(self.value, (int, float))\n\n    def __lt__(self, other):\n        if not isinstance(other, NumericValue):\n            return NotImplemented\n        return self.value < other.value\n\n    def __eq__(self, other):\n        if not isinstance(other, NumericValue):\n            return NotImplemented\n        return self.value == other.value\n\n    def __repr__(self):\n        return f\"NumericValue({self.value})\"\nclass ArgumentSet:\n    def __init__(self, a: NumericValue, b: NumericValue, c: NumericValue):\n        if not all(isinstance(arg, NumericValue) for arg in [a, b, c]):\n            raise TypeError(\"All arguments must be NumericValue instances.\")\n        self.a = a\n        self.b = b\n        self.c = c\n\n    def to_list(self) -> List[NumericValue]:\n        return [self.a, self.b, self.c]\nclass MedianResult:\n    def __init__(self, value: float):\n        self.value = float(value)\n\n    def as_float(self) -> float:\n        return self.value\n\n    def __eq__(self, other):\n        if isinstance(other, MedianResult):\n            return self.value == other.value\n        elif isinstance(other, (int, float)):\n            return self.value == float(other)\n        return NotImplemented\n\n    def __repr__(self):\n        return f\"MedianResult({self.value})\"\nclass MedianCalculator:\n    @staticmethod\n    def _validate_inputs(a: NumericValue, b: NumericValue, c: NumericValue) -> None:\n        if not all(isinstance(arg, NumericValue) for arg in [a, b, c]):\n            raise TypeError(\"All arguments must be instances of NumericValue.\")\n\n    @staticmethod\n    def _compute_median(values: List[NumericValue]) -> MedianResult:\n        if len(values) != 3:\n            raise ValueError(\"Expected exactly three NumericValue objects.\")\n        sorted_values = sorted(values)\n        median_numeric_value = sorted_values[1]\n        return MedianResult(median_numeric_value.value)\n\n    @staticmethod\n    def median_numbers(a: NumericValue, b: NumericValue, c: NumericValue) -> float:\n        MedianCalculator._validate_inputs(a, b, c)\n\n        arg_set = ArgumentSet(a, b, c)\n        values_list = arg_set.to_list()\n\n        median_result = MedianCalculator._compute_median(values_list)\n\n        return median_result.as_float()\ndef median_numbers(a, b, c) -> float:\n    \"\"\"\n    Calculates the median of three numbers.\n    Converts raw inputs to domain objects and delegates to MedianCalculator.\n    \"\"\"\n    num_a = NumericValue(a)\n    num_b = NumericValue(b)\n    num_c = NumericValue(c)\n\n    result = MedianCalculator.median_numbers(num_a, num_b, num_c)\n\n    return result"}
