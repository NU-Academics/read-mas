{"task_id": "Mbpp/12", "solution": "from typing import List, Tuple\nclass Row:\n    \"\"\"Represents a single row of a matrix, preserving its elements and original index for stable sorting.\"\"\"\n    def __init__(self, elements: List[float], index: int):\n        self.elements: List[float] = elements\n        self.index: int = index\n\n    def sum(self) -> float:\n        \"\"\"Computes the sum of all numeric elements in the row.\"\"\"\n        return sum(self.elements)\nclass SumCalculator:\n    \"\"\"A utility class responsible for computing the sum of a Row's elements.\"\"\"\n    def compute(self, row: Row) -> float:\n        \"\"\"Calculates the sum for a given Row object using its sum() method.\"\"\"\n        return row.sum()\ndef sort_matrix(matrix: List[List[float]]) -> List[List[float]]:\n    \"\"\"\n    Sorts a matrix by the ascending sum of its rows.\n    Employs stable sorting for rows with identical sums, preserving their original relative order.\n    \"\"\"\n    rows_with_indices = []\n    for i, row_elements in enumerate(matrix):\n        rows_with_indices.append(Row(elements=row_elements, index=i))\n\n    sum_calculator = SumCalculator()\n    \n    def sort_key(row: Row) -> Tuple[float, int]:\n        return (sum_calculator.compute(row), row.index)\n\n    sorted_rows = sorted(rows_with_indices, key=sort_key)\n\n    return [row.elements for row in sorted_rows]"}
{"task_id": "Mbpp/56", "solution": "def reverse_digits(n: int) -> int:\n    \"\"\"Reverses the base-10 digits of an integer, dropping leading zeros.\"\"\"\n    return int(str(n)[::-1])\ndef check(n: int) -> bool:\n    \"\"\"Checks if a number is one less than twice its reverse.\"\"\"\n    reversed_n = reverse_digits(n)\n    return n == (2 * reversed_n - 1)"}
