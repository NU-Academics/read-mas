{"task_id": "Mbpp/247", "solution": "import collections\nclass InputString:\n    \"\"\"A wrapper for the input string.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n\n    def length(self) -> int:\n        return len(self.value)\nclass LPSResult:\n    \"\"\"A simple class to hold the length of the longest palindromic subsequence.\"\"\"\n    def __init__(self, length: int):\n        self.length = length\nclass DPTable:\n    \"\"\"Encapsulates the DP algorithm and intermediate state for LPS computation.\"\"\"\n    def __init__(self, size: int):\n        self.size = size\n        self.table = [[0] * size for _ in range(size)]\n\n    def populate(self, input_obj: InputString) -> None:\n        s = input_obj.value\n        n = self.size\n\n        # All characters are palindromic subsequences of length 1\n        for i in range(n):\n            self.table[i][i] = 1\n\n        # Fill the table for lengths from 2 to n\n        for cl in range(2, n + 1):\n            for i in range(n - cl + 1):\n                j = i + cl - 1\n                if s[i] == s[j]:\n                    if cl == 2:\n                        self.table[i][j] = 2\n                    else:\n                        self.table[i][j] = 2 + self.table[i+1][j-1]\n                else:\n                    self.table[i][j] = max(self.table[i][j-1], self.table[i+1][j])\n\n    def get(self, i: int, j: int) -> int:\n        return self.table[i][j]\n\n    def result(self) -> int:\n        return self.table[0][self.size - 1] if self.size > 0 else 0\ndef lps(input: str) -> int:\n    \"\"\"\n    Computes the length of the longest palindromic subsequence using dynamic programming.\n    Handles empty strings by returning 0.\n    \"\"\"\n    s = InputString(input)\n    if s.length() == 0:\n        return 0\n\n    dp = DPTable(s.length())\n    dp.populate(s)\n    return LPSResult(dp.result()).length"}
{"task_id": "Mbpp/252", "solution": "from math import sqrt, atan2\ndef convert(value) -> tuple[float, float]:\n    \"\"\"Convert a numeric value (complex | int | float) to polar coordinates.\n\n    Returns (r, theta) where r = sqrt(re**2 + im**2) and theta = atan2(im, re).\n    \"\"\"\n    if isinstance(value, complex):\n        re = value.real\n        im = value.imag\n    else: # value is int or float\n        re = float(value)\n        im = 0.0\n\n    r = sqrt(re * re + im * im)\n    theta = atan2(im, re)\n\n    return (float(r), float(theta))"}
{"task_id": "Mbpp/255", "solution": "import itertools\nfrom typing import List, Tuple, Any\nclass Validator:\n    \"\"\"Validates inputs according to business rules.\"\"\"\n    def validate_elements(self, elements: Any) -> None:\n        if not isinstance(elements, list):\n            raise TypeError(\"elements must be a list\")\n\n    def validate_n(self, n: Any) -> None:\n        if not isinstance(n, int):\n            raise TypeError(\"n must be an integer\")\n        if n < 0:\n            raise ValueError(\"n cannot be negative\")\nclass CombinationFunction:\n    \"\"\"Generates all length-n combinations with repetition.\"\"\"\n    def __init__(self, elements: List[Any], n: int) -> None:\n        self._elements = elements[:] # Create a copy to avoid mutation\n        self._n = n\n\n    def generate(self) -> List[Tuple[Any, ...]]:\n        if self._n == 0:\n            return [()]\n        if self._n > 0 and not self._elements:\n            return []\n        \n        # itertools.product is equivalent to n-fold Cartesian product\n        # and generates combinations with repetition in lexicographical order.\n        return list(itertools.product(self._elements, repeat=self._n))\ndef combinations_colors(elements: list, n: int) -> List[Tuple]:\n    \"\"\"\n    Generates all combinations (with repetition) of the elements of the list and \n    returns a list with a tuple for each combination.\n    \"\"\"\n    validator = Validator()\n    validator.validate_elements(elements)\n    validator.validate_n(n)\n\n    generator = CombinationFunction(elements, n)\n    return generator.generate()"}
