{"task_id": "Mbpp/778", "solution": "from typing import List, Any\ndef pack_consecutive_duplicates(input: List[Any]) -> List[List[Any]]:\n    \"\"\"Return list of sublists grouping maximal contiguous runs of equal elements.\n    Does not modify the input list.\"\"\"\n    if not input:\n        return []\n\n    packed_list = []\n    current_group = [input[0]]\n\n    for i in range(1, len(input)):\n        if input[i] == current_group[-1]:\n            current_group.append(input[i])\n        else:\n            packed_list.append(current_group)\n            current_group = [input[i]]\n            \n    packed_list.append(current_group)\n    return packed_list"}
{"task_id": "Mbpp/781", "solution": "def count_divisors(n: int) -> bool:\n    \"\"\"\n    Checks if the number of positive divisors of n is even.\n    A helper function counts all positive divisors of n.\n    \"\"\"\n    def _count_positive_divisors(n: int) -> int:\n        \"\"\"\n        Counts the number of positive divisors for a given integer n.\n        Iterates up to sqrt(n) for efficiency, handling perfect squares.\n        \"\"\"\n        count = 0\n        i = 1\n        while i * i <= n:\n            if n % i == 0:\n                if i * i == n:\n                    count += 1\n                else:\n                    count += 2\n            i += 1\n        return count\n\n    total_divisors = _count_positive_divisors(n)\n    return total_divisors % 2 == 0"}
{"task_id": "Mbpp/780", "solution": "from typing import List, Tuple\nclass ResultTuple:\n    \"\"\"Represents a computed sum tuple with the indices of its originating pair.\"\"\"\n    def __init__(self, sum_a: int, sum_b: int, pair_indices: Tuple[int, int]) -> None:\n        self.sum_a = sum_a\n        self.sum_b = sum_b\n        self.pair_indices = pair_indices\nclass CombinationProcessor:\n    \"\"\"Handles the core logic of validating input, generating pairs, summing them, and ordering results.\"\"\"\n    def __init__(self, input_list: List[Tuple[int, int]]) -> None:\n        self._input_list = input_list\n        self._n = len(input_list)\n\n    def validate_input(self) -> None:\n        \"\"\"Validates the input list and its elements.\"\"\"\n        if not isinstance(self._input_list, (list, tuple)):\n            raise TypeError(\"Input must be a list or sequence of tuples.\")\n        \n        for i, item in enumerate(self._input_list):\n            if not isinstance(item, tuple) or len(item) != 2:\n                raise ValueError(f\"Element at index {i} is not a 2-element tuple.\")\n            if not all(isinstance(x, int) for x in item):\n                raise ValueError(f\"Elements inside tuple at index {i} must be integers.\")\n\n    def generate_pairs(self) -> List[Tuple[int, int]]:\n        \"\"\"Generates all unique ordered pairs of indices (i, j) where i < j.\"\"\"\n        pairs = []\n        for i in range(self._n):\n            for j in range(i + 1, self._n):\n                pairs.append((i, j))\n        return pairs\n\n    def sum_pairs(self, pairs: List[Tuple[int, int]]) -> List[ResultTuple]:\n        \"\"\"Computes element-wise sums for the given pairs of indices.\"\"\"\n        results = []\n        for i, j in pairs:\n            val_i_a, val_i_b = self._input_list[i]\n            val_j_a, val_j_b = self._input_list[j]\n            sum_a = val_i_a + val_j_a\n            sum_b = val_i_b + val_j_b\n            results.append(ResultTuple(sum_a, sum_b, (i, j)))\n        return results\n\n    def order_results(self, results: List[ResultTuple]) -> List[Tuple[int, int]]:\n        \"\"\"Converts ResultTuple objects to plain tuples, ensuring lexicographic order.\"\"\"\n        return [(r.sum_a, r.sum_b) for r in results]\nclass FindCombinations:\n    \"\"\"Orchestrates the process of finding combinations of sums from input tuples.\"\"\"\n    def __init__(self, tuples: List[Tuple[int, int]]) -> None:\n        self._input_list = tuples\n\n    def find_combinations(self) -> List[Tuple[int, int]]:\n        \"\"\"Executes the combination-finding pipeline.\"\"\"\n        processor = CombinationProcessor(self._input_list)\n        \n        if processor._n < 2:\n            return []\n\n        processor.validate_input()\n        pairs = processor.generate_pairs()\n        results_objs = processor.sum_pairs(pairs)\n        return processor.order_results(results_objs)\ndef find_combinations(tuples: List[Tuple[int, int]]) -> List[Tuple[int, int]]:\n    \"\"\"Finds combinations of element-wise sums for all unique pairs of 2-element tuples.\"\"\"\n    facade = FindCombinations(tuples)\n    return facade.find_combinations()"}
{"task_id": "Mbpp/782", "solution": "def odd_length_sum(lst):\n    \"\"\"\n    Computes the sum of all odd-length contiguous subarrays of the input list.\n    \"\"\"\n    total_sum = 0\n    n = len(lst)\n\n    # Iterate over all possible start indices\n    for i in range(n):\n        # Iterate over all possible end indices for the current start index\n        for j in range(i, n):\n            # Calculate the length of the current subarray\n            subarray_length = j - i + 1\n            \n            # Check if the subarray length is odd\n            if subarray_length % 2 != 0:\n                # If odd, sum its elements and add to the total\n                for k in range(i, j + 1):\n                    total_sum += lst[k]\n                    \n    return total_sum"}
{"task_id": "Mbpp/784", "solution": "from typing import List, Optional\ndef _find_first_odd(items: List[int]) -> Optional[int]:\n    \"\"\"Return the first odd integer in items or None if none exists.\"\"\"\n    for item in items:\n        if item % 2 != 0:\n            return item\n    return None\ndef _find_first_even(items: List[int]) -> Optional[int]:\n    \"\"\"Return the first even integer in items or None if none exists.\"\"\"\n    for item in items:\n        if item % 2 == 0:\n            return item\n    return None\ndef mul_even_odd(items: List[int]) -> int:\n    \"\"\"Return FirstOdd * FirstEven for the provided list of integers.\n    Raises ValueError if no odd or no even number is present.\n    \"\"\"\n    first_odd = _find_first_odd(items)\n    first_even = _find_first_even(items)\n\n    if first_odd is None or first_even is None:\n        raise ValueError(\"The list must contain at least one odd and one even number.\")\n\n    return first_odd * first_even"}
{"task_id": "Mbpp/786", "solution": "def right_insertion(sorted_list, value) -> int:\n    \"\"\"\n    Locates the right insertion point for a specified value in sorted order using binary search.\n    Returns the index where 'value' can be inserted to maintain sorted order,\n    placing it to the right of any existing equal elements.\n    \"\"\"\n    low = 0\n    high = len(sorted_list)\n\n    while low < high:\n        mid = (low + high) // 2\n        if sorted_list[mid] <= value:\n            low = mid + 1\n        else:\n            high = mid\n    return low"}
{"task_id": "Mbpp/785", "solution": "from typing import List, Tuple\nclass TupleStringParser:\n    \"\"\"\n    Encapsulates the logic for parsing a tuple string into an integer tuple.\n    Handles validation, extraction, tokenization, and integer conversion.\n    \"\"\"\n\n    def _validate_parentheses(self, raw: str) -> bool:\n        \"\"\"\n        Validates if the input string starts and ends with parentheses.\n        Raises ValueError if not.\n        \"\"\"\n        if not (raw.startswith('(') and raw.endswith(')')):\n            raise ValueError(\"input must start with '(' and end with ')'\")\n        return True\n\n    def _extract_inner(self, raw: str) -> str:\n        \"\"\"\n        Extracts the inner content of the tuple string, removing outer parentheses.\n        \"\"\"\n        return raw[1:-1]\n\n    def _tokenize(self, inner: str) -> List[str]:\n        \"\"\"\n        Tokenizes the inner string by commas.\n        \"\"\"\n        return inner.split(',')\n\n    def _parse_token(self, token: str) -> int:\n        \"\"\"\n        Trims a token, validates it's not empty, and converts it to an integer.\n        Raises ValueError if the token is empty or cannot be converted.\n        \"\"\"\n        trimmed_token = token.strip()\n        if not trimmed_token:\n            raise ValueError(\"empty token in input\")\n        try:\n            return int(trimmed_token)\n        except ValueError:\n            raise ValueError(f\"token '{trimmed_token}' is not an integer\")\n\n    def tuple_str_int(self, raw: str) -> Tuple[int, ...]:\n        \"\"\"\n        Converts a parenthesized comma-separated integer string into a tuple of ints.\n        Delegates to internal methods for parsing stages.\n        \"\"\"\n        self._validate_parentheses(raw)\n        inner_content = self._extract_inner(raw)\n        tokens = self._tokenize(inner_content)\n\n        parsed_ints = []\n        for token in tokens:\n            parsed_ints.append(self._parse_token(token))\n\n        return tuple(parsed_ints)\ndef tuple_str_int(raw: str) -> Tuple[int, ...]:\n    \"\"\"\n    Converts a tuple string (e.g., \"(7, 8, 9)\") to an integer tuple.\n    Raises ValueError for malformed input.\n    \"\"\"\n    parser = TupleStringParser()\n    return parser.tuple_str_int(raw)"}
{"task_id": "Mbpp/787", "solution": "class InputString:\n    \"\"\"Represents the caller-supplied string value.\"\"\"\n    def __init__(self, value: str) -> None:\n        self.value: str = value\nclass MatchResult:\n    \"\"\"Represents a boolean matched result.\"\"\"\n    def __init__(self, matched: bool) -> None:\n        self.matched: bool = matched\nclass Pattern:\n    \"\"\"Holds the pattern literal \"abbb\".\"\"\"\n    def __init__(self, value: str = \"abbb\") -> None:\n        self.value: str = value\nclass TextMatcher:\n    \"\"\"Encapsulates pattern and performs contiguous substring detection for 'abbb'.\"\"\"\n    def __init__(self, pattern_value: str = \"abbb\") -> None:\n        self._pattern: Pattern = Pattern(pattern_value)\n\n    def text_match_three(self, text: str) -> bool:\n        \"\"\"Performs contiguous substring search for the internal pattern in the given text.\"\"\"\n        input_string = InputString(text)\n        matched = self._pattern.value in input_string.value\n        return MatchResult(matched).matched\ndef text_match_three(text: str) -> bool:\n    \"\"\"Accepts a single string argument and returns True when substring 'abbb' is found contiguously; otherwise False.\"\"\"\n    matcher = TextMatcher()\n    return matcher.text_match_three(text)"}
