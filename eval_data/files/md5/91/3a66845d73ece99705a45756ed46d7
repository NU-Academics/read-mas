{"task_id": "Mbpp/67", "solution": "class ValidationError(Exception):\n    \"\"\"\n    Exception raised for invalid input to the bell_number function.\n    \"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\ndef bell_number(n: int) -> int:\n    \"\"\"\n    Computes the n-th Bell number, which is the number of ways to partition\n    a set of n elements into non-empty subsets.\n    \"\"\"\n    # Validate input: n must be a non-negative integer.\n    if not isinstance(n, int):\n        raise ValidationError(\"Input 'n' must be an integer.\")\n    if n < 0:\n        raise ValidationError(\"Input 'n' must be a non-negative integer.\")\n\n    # Base cases for Bell numbers\n    if n == 0:\n        return 1\n\n    # Compute Stirling numbers of the second kind S(i, k)\n    # S[i][k] stores S(i, k), the number of ways to partition a set of i elements\n    # into k non-empty subsets.\n    # The table size is (n+1) x (n+1)\n    stirling = [[0] * (n + 1) for _ in range(n + 1)]\n\n    # Base case for Stirling numbers: S(0,0) = 1 (empty set has one partition, the empty partition)\n    stirling[0][0] = 1\n\n    # Fill the Stirling numbers table using the recurrence relation:\n    # S(i, k) = S(i-1, k-1) + k * S(i-1, k)\n    for i in range(1, n + 1):\n        # S(i, 0) is 0 for i > 0 (cannot partition a non-empty set into 0 subsets)\n        stirling[i][0] = 0\n        for k in range(1, i + 1):\n            stirling[i][k] = stirling[i-1][k-1] + k * stirling[i-1][k]\n\n    # The n-th Bell number is the sum of Stirling numbers of the second kind for n:\n    # B_n = sum_{k=0 to n} S(n, k)\n    bell_n = 0\n    for k in range(n + 1):\n        bell_n += stirling[n][k]\n\n    return bell_n"}
{"task_id": "Mbpp/68", "solution": "class MonotonicChecker:\n    \"\"\"Encapsulates logic to check if an array is monotonic.\"\"\"\n\n    def check_non_decreasing(self, array: list) -> bool:\n        \"\"\"Checks if the array is non-decreasing.\"\"\"\n        if len(array) <= 1:\n            return True\n        for i in range(1, len(array)):\n            if array[i] < array[i-1]:\n                return False\n        return True\n\n    def check_non_increasing(self, array: list) -> bool:\n        \"\"\"Checks if the array is non-increasing.\"\"\"\n        if len(array) <= 1:\n            return True\n        for i in range(1, len(array)):\n            if array[i] > array[i-1]:\n                return False\n        return True\n\n    def is_Monotonic(self, array: list) -> bool:\n        \"\"\"Checks if the array is either non-decreasing or non-increasing.\"\"\"\n        return self.check_non_decreasing(array) or self.check_non_increasing(array)\ndef is_Monotonic(array) -> bool:\n    \"\"\"Checks whether the given array is monotonic (non-decreasing or non-increasing).\"\"\"\n    checker = MonotonicChecker()\n    return checker.is_Monotonic(array)"}
