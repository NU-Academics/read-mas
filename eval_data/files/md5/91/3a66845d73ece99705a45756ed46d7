{"task_id": "Mbpp/277", "solution": "from typing import Dict, Any\ndef dict_filter(dictionary: dict, n: int) -> dict:\n    \"\"\"Return a new dict containing only entries from `dictionary` whose values are >= n.\n\n    Filters the dictionary by comparing each value to the threshold `n`.\n    \"\"\"\n    filtered_dict = {}\n    for key, value in dictionary.items():\n        if value >= n:\n            filtered_dict[key] = value\n    return filtered_dict"}
{"task_id": "Mbpp/279", "solution": "class InputValidator:\n    \"\"\"\n    Validates input n to ensure it's a positive integer (n >= 1).\n    \"\"\"\n    def validatePositiveInteger(self, n: int) -> bool:\n        \"\"\"\n        Returns True if n is an integer and n >= 1; otherwise False.\n        \"\"\"\n        return isinstance(n, int) and n >= 1\nclass DecagonalNumberCalculator:\n    \"\"\"\n    Computes the nth decagonal number using the formula 4*n^2 - 3*n.\n    \"\"\"\n    def compute(self, n: int) -> int:\n        \"\"\"\n        Returns integer value computed by 4*n^2 - 3*n.\n        \"\"\"\n        return 4 * n**2 - 3 * n\ndef is_num_decagonal(n: int) -> int:\n    \"\"\"\n    Finds the nth decagonal number.\n    Raises ValueError if n is not an integer >= 1.\n    \"\"\"\n    validator = InputValidator()\n    if not validator.validatePositiveInteger(n):\n        raise ValueError(\"n must be an integer >= 1\")\n    calculator = DecagonalNumberCalculator()\n    return calculator.compute(n)"}
{"task_id": "Mbpp/278", "solution": "def count_first_elements(input_tuple: tuple) -> int:\n    \"\"\"\n    Counts the number of top-level elements that occur before the first top-level element\n    that is itself a tuple in the given input_tuple.\n    \"\"\"\n    for index, element in enumerate(input_tuple):\n        if isinstance(element, tuple):\n            return index\n    return len(input_tuple)"}
{"task_id": "Mbpp/281", "solution": "def all_unique(list_input):\n    \"\"\"Return True if every element in list_input is unique; otherwise return False.\n    The function must not mutate list_input.\n    \"\"\"\n    try:\n        # Fast path for hashable items: compare set length with list length.\n        return len(set(list_input)) == len(list_input)\n    except TypeError:\n        # Fallback for unhashable items: perform pairwise equality comparison.\n        n = len(list_input)\n        for i in range(n):\n            for j in range(i + 1, n):\n                if list_input[i] == list_input[j]:\n                    return False\n        return True"}
