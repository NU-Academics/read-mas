{"task_id": "Mbpp/414", "solution": "def overlapping(seq1, seq2):\n    \"\"\"Return True if any element of seq1 equals any element of seq2 using Python's equality operator (==).\"\"\"\n    for a in seq1:\n        for b in seq2:\n            if a == b:\n                return True\n    return False"}
{"task_id": "Mbpp/418", "solution": "def Find_Max(input_list):\n    \"\"\"\n    Finds the element of a list having the maximum length.\n\n    Returns the first such element if there are ties, or None if the list is empty.\n    Raises TypeError if input is not a list or if an element does not support len().\n    \"\"\"\n    if not isinstance(input_list, list):\n        raise TypeError(f\"Find_Max: input must be a list; got {type(input_list).__name__}\")\n\n    if not input_list:\n        return None\n\n    max_len = -1\n    max_idx = -1\n\n    for i, element in enumerate(input_list):\n        try:\n            current_len = len(element)\n        except TypeError:\n            raise TypeError(f\"Find_Max: element at index {i} does not support len(): {repr(element)}\")\n\n        if current_len > max_len:\n            max_len = current_len\n            max_idx = i\n\n    return input_list[max_idx]"}
{"task_id": "Mbpp/415", "solution": "from src.input_validator import InputValidator\nfrom src.product_finder import ProductFinder\nfrom src.pair_result import PairResult\ndef max_Product(list_of_ints) -> tuple:\n    \"\"\"\n    Finds a pair of integers from a list with the highest product.\n    Performs validation and uses helper classes for computation and result formatting.\n    \"\"\"\n    InputValidator.validate_is_list(list_of_ints)\n    InputValidator.validate_length(list_of_ints)\n    InputValidator.validate_all_integers(list_of_ints)\n\n    a, b = ProductFinder.compute_max_pair(list_of_ints)\n    return PairResult(a, b).as_tuple()"}
{"task_id": "Mbpp/420", "solution": "import builtins\nclass EvenNumberSequence:\n    def generate(self, n: int) -> list[int]:\n        \"\"\"Generates the first n even natural numbers.\"\"\"\n        return [2 * k for k in range(1, n + 1)]\nclass CubeCalculator:\n    def cube(self, x: int) -> int:\n        \"\"\"Computes the cube of a single integer.\"\"\"\n        return x ** 3\nclass SumAggregator:\n    def sum(self, values: list[int]) -> int:\n        \"\"\"Sums a list of integer values.\"\"\"\n        return builtins.sum(values)\ndef cube_Sum(n: int) -> int:\n    \"\"\"\n    Finds the cube sum of the first n even natural numbers.\n    Raises ValueError if n is not a non-negative integer.\n    \"\"\"\n    if not isinstance(n, int) or n < 0:\n        raise ValueError(\"n must be a non-negative integer\")\n\n    if n == 0:\n        return 0\n\n    even_sequence_generator = EvenNumberSequence()\n    even_numbers = even_sequence_generator.generate(n)\n\n    cube_calculator = CubeCalculator()\n    cubed_numbers = [cube_calculator.cube(num) for num in even_numbers]\n\n    sum_aggregator = SumAggregator()\n    total_sum = sum_aggregator.sum(cubed_numbers)\n\n    return total_sum"}
{"task_id": "Mbpp/421", "solution": "def concatenate_tuple(tuple_input, delimiter='-') -> str:\n    \"\"\"Concatenates elements of a tuple into a string using a delimiter.\n    Converts each element to its string representation before joining.\"\"\"\n    if len(tuple_input) == 0:\n        return ''\n    converted = [str(e) for e in tuple_input]\n    return delimiter.join(converted)"}
{"task_id": "Mbpp/419", "solution": "from typing import List\nimport math\ndef _round_half_up(value: float) -> int:\n    \"\"\"Rounds a float value to the nearest integer using the half-up rule (e.g., X.5 rounds up).\"\"\"\n    return int(math.floor(value + 0.5))\ndef round_and_sum(numbers: List[float]) -> int:\n    \"\"\"\n    Rounds every number of a given list using half-up rule, sums them,\n    multiplies by list length, prints the result, and returns it.\n    \"\"\"\n    rounded_numbers = [_round_half_up(num) for num in numbers]\n    total_sum = sum(rounded_numbers)\n    list_length = len(numbers)\n\n    final_result = total_sum * list_length\n\n    print(final_result)\n    return final_result"}
