{"task_id": "Mbpp/19", "solution": "from typing import List\nclass IntegerArray:\n    \"\"\"\n    Lightweight wrapper around a list[int] to represent the SRS IntegerArray\n    domain concept and provide convenience methods.\n    \"\"\"\n    def __init__(self, elements: List[int]) -> None:\n        self.elements = elements\n\n    def length(self) -> int:\n        return len(self.elements)\n\n    def isEmpty(self) -> bool:\n        return self.length() == 0\nclass DuplicateCheckResult:\n    \"\"\"\n    Carrier for the boolean duplicate-check result.\n    \"\"\"\n    def __init__(self, has_duplicates: bool) -> None:\n        self.has_duplicates = has_duplicates\nclass DuplicateChecker:\n    \"\"\"\n    Implements the duplicate-detection algorithm (stateless).\n    \"\"\"\n    def containsDuplicates(self, arr: IntegerArray) -> bool:\n        \"\"\"\n        Return True if arr contains at least one duplicate element; otherwise False.\n        \"\"\"\n        seen = set()\n        for element in arr.elements:\n            if element in seen:\n                return True\n            seen.add(element)\n        return False\n\n    def check(self, arr: IntegerArray) -> DuplicateCheckResult:\n        \"\"\"\n        Run detection and return a DuplicateCheckResult.\n        \"\"\"\n        has_duplicates = self.containsDuplicates(arr)\n        return DuplicateCheckResult(has_duplicates)\ndef test_duplicate(arr: List[int]) -> bool:\n    \"\"\"\n    Find whether a given array of integers contains any duplicate element.\n    \"\"\"\n    integer_array = IntegerArray(arr)\n    checker = DuplicateChecker()\n    return checker.containsDuplicates(integer_array)"}
{"task_id": "Mbpp/20", "solution": "class WoodallCondition:\n    \"\"\"Represents a candidate Woodall number for a given k.\"\"\"\n    def __init__(self, k: int) -> None:\n        self.k = k\n        self.computed_value = k * (2**k) - 1\n\n    def evaluate(self, n: int) -> bool:\n        \"\"\"Checks if the computed value matches n.\"\"\"\n        return self.computed_value == n\nclass Result:\n    \"\"\"Encapsulates the boolean result of a Woodall check.\"\"\"\n    def __init__(self, isWoodall: bool) -> None:\n        self.isWoodall = isWoodall\nclass WoodallChecker:\n    \"\"\"Determines if a number is a Woodall number.\"\"\"\n    def find_k(self, n: int) -> int | None:\n        \"\"\"Searches for an integer k such that n = k * 2^k - 1.\"\"\"\n        k = 1\n        while True:\n            condition = WoodallCondition(k)\n            computed_value = condition.computed_value\n            if computed_value == n:\n                return k\n            if computed_value > n:\n                return None\n            k += 1\n\n    def is_woodall(self, n: int) -> bool:\n        \"\"\"Checks if n is a Woodall number.\"\"\"\n        return self.find_k(n) is not None\ndef is_woodall(n: int) -> bool:\n    \"\"\"Checks if the given number is a Woodall number.\"\"\"\n    checker = WoodallChecker()\n    is_woodall_num = checker.is_woodall(n)\n    \n    # Per design, encapsulate the boolean result in a Result object\n    result_obj = Result(is_woodall_num)\n    return result_obj.isWoodall"}
{"task_id": "Mbpp/14", "solution": "class InputValidator:\n    \"\"\"Provides utility for validating input types.\"\"\"\n    @staticmethod\n    def is_numeric(value) -> bool:\n        \"\"\"Checks if the value is an int or float, but not a bool.\"\"\"\n        return isinstance(value, (int, float)) and not isinstance(value, bool)\nclass TriangularPrism:\n    \"\"\"Represents a triangular prism and calculates its volume.\"\"\"\n    def __init__(self, base: float, triangle_height: float, length: float) -> None:\n        self.base = base\n        self.triangle_height = triangle_height\n        self.length = length\n\n    def calculateVolume(self) -> float:\n        \"\"\"Calculates the volume of the triangular prism.\"\"\"\n        return 0.5 * self.base * self.triangle_height * self.length\nclass VolumeCalculator:\n    \"\"\"Orchestrates validation and volume computation for triangular prisms.\"\"\"\n    def find_Volume(self, base, triangle_height, length):\n        \"\"\"\n        Validates inputs and calculates the volume of a triangular prism.\n        Raises ValueError for non-numeric inputs.\n        \"\"\"\n        if not InputValidator.is_numeric(base):\n            raise ValueError(\"Non-numeric input\")\n        if not InputValidator.is_numeric(triangle_height):\n            raise ValueError(\"Non-numeric input\")\n        if not InputValidator.is_numeric(length):\n            raise ValueError(\"Non-numeric input\")\n\n        prism = TriangularPrism(base, triangle_height, length)\n        volume = prism.calculateVolume()\n        return volume\ndef find_Volume(base, triangle_height, length):\n    \"\"\"\n    Calculates the volume of a triangular prism with given dimensions.\n    Delegates to VolumeCalculator for validation and computation.\n    \"\"\"\n    return VolumeCalculator().find_Volume(base, triangle_height, length)"}
