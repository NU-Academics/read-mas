{"task_id": "Mbpp/245", "solution": "from typing import List\ndef _compute_inc_sums(arr: List[float]) -> List[float]:\n    \"\"\"Computes the maximum sum of an increasing subsequence ending at each index.\"\"\"\n    n = len(arr)\n    if n == 0:\n        return []\n\n    inc_sum = [0.0] * n\n    for i in range(n):\n        inc_sum[i] = arr[i]\n        for j in range(i):\n            if arr[j] < arr[i]:\n                inc_sum[i] = max(inc_sum[i], inc_sum[j] + arr[i])\n    return inc_sum\ndef _compute_dec_sums(arr: List[float]) -> List[float]:\n    \"\"\"Computes the maximum sum of a decreasing subsequence starting at each index.\"\"\"\n    n = len(arr)\n    if n == 0:\n        return []\n\n    dec_sum = [0.0] * n\n    for i in range(n - 1, -1, -1):\n        dec_sum[i] = arr[i]\n        for j in range(n - 1, i, -1):\n            if arr[j] < arr[i]:\n                dec_sum[i] = max(dec_sum[i], dec_sum[j] + arr[i])\n    return dec_sum\ndef max_sum(arr: List[float]) -> float:\n    \"\"\"\n    Finds the maximum sum of a bitonic subsequence for the given array.\n    A sequence is bitonic if it is first increasing and then decreasing.\n    \"\"\"\n    n = len(arr)\n    if n == 0:\n        return 0.0\n    if n == 1:\n        return arr[0]\n\n    inc_sums = _compute_inc_sums(arr)\n    dec_sums = _compute_dec_sums(arr)\n\n    max_overall_sum = 0.0\n    for i in range(n):\n        # The element arr[i] is counted in both inc_sums[i] and dec_sums[i],\n        # so we subtract it once to get the sum of the bitonic subsequence with peak at i.\n        current_bitonic_sum = inc_sums[i] + dec_sums[i] - arr[i]\n        max_overall_sum = max(max_overall_sum, current_bitonic_sum)\n\n    return max_overall_sum"}
{"task_id": "Mbpp/244", "solution": "import math\ndef next_Perfect_Square(n: int) -> int:\n    \"\"\"\n    Finds the smallest perfect square strictly greater than the given number n.\n    It computes floor(sqrt(n)), adds one, and squares the result.\n    \"\"\"\n    # math.isqrt(n) gives floor(sqrt(n))\n    m0 = math.isqrt(n)\n    m = m0 + 1\n    return m * m"}
