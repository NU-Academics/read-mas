{"task_id": "Mbpp/223", "solution": "import bisect\ndef validate_n_equals_length(n: int, array: list) -> bool:\n    \"\"\"Checks if the provided length n matches the actual array length.\"\"\"\n    return n == len(array)\ndef _is_array_sorted(array: list) -> bool:\n    \"\"\"Checks if the array is sorted in non-decreasing order.\"\"\"\n    for i in range(len(array) - 1):\n        if array[i] > array[i+1]:\n            return False\n    return True\ndef countOccurrences(array: list, element: any) -> int:\n    \"\"\"Counts occurrences of element in a sorted array using binary search.\"\"\"\n    first_idx = bisect.bisect_left(array, element)\n    \n    if first_idx == len(array) or array[first_idx] != element:\n        return 0\n        \n    last_idx = bisect.bisect_right(array, element)\n    \n    return last_idx - first_idx\ndef is_majority(array: list, n: int, element: any) -> bool:\n    \"\"\"\n    Checks if an element is the majority element in a sorted array.\n    Raises ValueError if n does not match array length or if the array is not sorted.\n    \"\"\"\n    if not validate_n_equals_length(n, array):\n        raise ValueError(\"Provided length 'n' does not match the actual array length.\")\n    \n    if not _is_array_sorted(array):\n        raise ValueError(\"Input array is not sorted in non-decreasing order.\")\n\n    count = countOccurrences(array, element)\n    \n    return count > n / 2"}
