{"task_id": "Mbpp/274", "solution": "class ValidationError(ValueError):\n    \"\"\"Domain-named validation exception; subclass of ValueError.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\nclass EvenBinomialCoeffSum:\n    \"\"\"Encapsulates application logic for even index binomial coefficient sum.\"\"\"\n\n    def _validate_input(self, n: int) -> None:\n        \"\"\"\n        Validates that n is a positive integer (n > 0); raises ValidationError if invalid.\n        \"\"\"\n        if not isinstance(n, int):\n            raise ValidationError(\"Input 'n' must be an integer.\")\n        if n <= 0:\n            raise ValidationError(\"Input 'n' must be a positive integer (n > 0).\")\n\n    def even_sum(self, n: int) -> int:\n        \"\"\"\n        Computes the sum of even-indexed binomial coefficients for C(n, k) using the closed-form 2**(n-1).\n        This formula is valid for n >= 1.\n        \"\"\"\n        return 2**(n - 1)\n\n    def compute(self, n: int) -> int:\n        \"\"\"\n        Orchestrates validation and computation of the sum; returns result as int.\n        \"\"\"\n        self._validate_input(n)\n        return self.even_sum(n)\ndef even_binomial_Coeff_Sum(n: int) -> int:\n    \"\"\"\n    Takes a positive integer n and finds the sum of even index binomial coefficients.\n    Raises ValidationError if n is not a positive integer.\n    \"\"\"\n    return EvenBinomialCoeffSum().compute(n)"}
