{"task_id": "Mbpp/123", "solution": "def sum_of_proper_divisors(x: int) -> int:\n    \"\"\"Return sum of positive divisors < x (exclude x). For x==1, returns 0.\"\"\"\n    if x == 1:\n        return 0\n    total = 1\n    for i in range(2, int(x**0.5) + 1):\n        if x % i == 0:\n            total += i\n            if i * i != x:\n                total += x // i\n    return total\ndef amicable_numbers_sum(n: int) -> int:\n    \"\"\"Return sum of unique amicable numbers whose values are between 1 and n inclusive.\n    \"\"\"\n    amicable_set = set()\n    divisor_sums_cache = {}\n\n    def get_sum(num: int) -> int:\n        if num in divisor_sums_cache:\n            return divisor_sums_cache[num]\n        s = sum_of_proper_divisors(num)\n        divisor_sums_cache[num] = s\n        return s\n\n    for a in range(1, n + 1):\n        sum_a = get_sum(a)\n        b = sum_a\n        \n        # Check if (a, b) is an amicable pair within the specified range.\n        if a != b and b <= n:\n            sum_b = get_sum(b)\n            if sum_b == a:\n                amicable_set.add(a)\n                amicable_set.add(b)\n                \n    return sum(amicable_set)"}
{"task_id": "Mbpp/126", "solution": "import math\nclass InputNumber:\n    \"\"\"Simple holder for an input integer.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\nclass DivisorSet:\n    \"\"\"Computes and holds the set of positive divisors for a given integer n.\"\"\"\n    def __init__(self, n: int):\n        self.n = n\n        self.divisors = set()\n\n    def compute_divisors(self) -> set[int]:\n        \"\"\"Compute positive divisors for self.n efficiently.\"\"\"\n        if self.n <= 0:\n            # Behavior for non-positive inputs is unspecified; return an empty set.\n            return set()\n        \n        for i in range(1, int(math.sqrt(self.n)) + 1):\n            if self.n % i == 0:\n                self.divisors.add(i)\n                self.divisors.add(self.n // i)\n        return self.divisors\nclass CommonDivisorSet:\n    \"\"\"Computes and holds the intersection of two divisor sets.\"\"\"\n    def __init__(self, a_divisors: set[int], b_divisors: set[int]):\n        self.a_divisors = a_divisors\n        self.b_divisors = b_divisors\n        self.common_divisors = set()\n\n    def intersect(self) -> set[int]:\n        \"\"\"Compute the intersection of the two provided divisor sets.\"\"\"\n        self.common_divisors = self.a_divisors.intersection(self.b_divisors)\n        return self.common_divisors\nclass Result:\n    \"\"\"Simple value object holding the integer sum of common divisors.\"\"\"\n    def __init__(self, value: int):\n        self.sum = value\nclass Function:\n    \"\"\"Orchestrates computation: compute divisors, intersection, and sum.\"\"\"\n    def __init__(self, a: int, b: int):\n        self.a = a\n        self.b = b\n\n    def execute(self) -> int:\n        \"\"\"Execute the full workflow to find the sum of common divisors.\"\"\"\n        input_a = InputNumber(self.a)\n        input_b = InputNumber(self.b)\n\n        div_set_a = DivisorSet(input_a.value)\n        divisors_a = div_set_a.compute_divisors()\n\n        div_set_b = DivisorSet(input_b.value)\n        divisors_b = div_set_b.compute_divisors()\n\n        common_div_set = CommonDivisorSet(divisors_a, divisors_b)\n        common_divisors = common_div_set.intersect()\n\n        total_sum = sum(common_divisors)\n        result = Result(total_sum)\n        return result.sum\ndef sum(a: int, b: int) -> int:\n    \"\"\"\n    Finds the sum of common positive divisors of two given numbers.\n    Note: This function shadows Python's built-in `sum`.\n    \"\"\"\n    # Behavior for non-integer inputs is not specified by SRS, assuming valid types.\n    # Behavior for zero/negative inputs: InputNumber and DivisorSet handle it by returning empty sets of divisors.\n    \n    func_instance = Function(a, b)\n    return func_instance.execute()"}
{"task_id": "Mbpp/128", "solution": "class ResultList:\n    \"\"\"Accumulates filtered tokens and provides the final Python list.\"\"\"\n    def __init__(self):\n        self.words = []\n\n    def append(self, word: str) -> None:\n        \"\"\"Appends a token string to the internal list.\"\"\"\n        self.words.append(word)\n\n    def to_list(self) -> list:\n        \"\"\"Returns the accumulated list of words.\"\"\"\n        return self.words\nclass Word:\n    \"\"\"Minimal representation of a token with ability to report its text and length.\"\"\"\n    def __init__(self, text: str):\n        self.text = text\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the word's text.\"\"\"\n        return len(self.text)\nclass Tokenizer:\n    \"\"\"Converts a string into a list of token strings by splitting on whitespace.\"\"\"\n    def tokenize(self, input: str) -> list:\n        \"\"\"Splits the input string on whitespace and returns a list of tokens.\"\"\"\n        return input.split()\nclass LongWordsFunction:\n    \"\"\"Orchestrates processing to find words longer than n characters.\"\"\"\n    def __init__(self, n: int, words_input):\n        self.n = n\n        self.words_input = words_input\n\n    def execute(self) -> list:\n        \"\"\"Executes the pipeline to filter words and return the result list.\"\"\"\n        result_list = ResultList()\n        \n        if isinstance(self.words_input, str):\n            tokenizer = Tokenizer()\n            tokens = tokenizer.tokenize(self.words_input)\n        else:\n            tokens = self.words_input # Assume it's already an iterable of words\n\n        for token in tokens:\n            word_obj = Word(token)\n            if word_obj.length() > self.n:\n                result_list.append(token)\n        \n        return result_list.to_list()\ndef long_words(n: int, words) -> list:\n    \"\"\"\n    Finds words that are longer than n characters from a given list of words.\n    \n    Delegates to LongWordsFunction for core logic.\n    \"\"\"\n    long_words_func = LongWordsFunction(n, words)\n    return long_words_func.execute()"}
{"task_id": "Mbpp/130", "solution": "from typing import Any, List, Dict\ndef max_occurrences(list_param: List[Any]) -> Any:\n    \"\"\"\n    Finds the item with maximum frequency in a given list.\n    Returns None for an empty list. In case of ties, the first-encountered\n    value in the list is returned.\n    \"\"\"\n    if not list_param:\n        return None\n\n    # Count frequencies of items, dict preserves insertion order (Python 3.7+).\n    freq_map: Dict[Any, int] = {}\n    for item in list_param:\n        freq_map[item] = freq_map.get(item, 0) + 1\n\n    max_value: Any = None\n    max_freq: int = -1\n\n    # Iterate through the frequency map to find the max,\n    # respecting insertion order for tie-breaking.\n    for value, count in freq_map.items():\n        if count > max_freq:\n            max_freq = count\n            max_value = value\n\n    return max_value"}
{"task_id": "Mbpp/129", "solution": "from typing import List\nclass ValidationResult:\n    \"\"\"Container for validation result details.\"\"\"\n    def __init__(self, is_valid: bool, reason: str = \"\"):\n        self.is_valid = is_valid\n        self.reason = reason\nclass Matrix:\n    \"\"\"Matrix domain wrapper with accessor and aggregation helpers.\"\"\"\n    def __init__(self, values: List[List[int]]):\n        self.values = values\n        self.n = len(values) if isinstance(values, list) else 0\n\n    def get_row_sum(self, row_idx: int) -> int:\n        return sum(self.values[row_idx])\n\n    def get_col_sum(self, col_idx: int) -> int:\n        return sum(self.values[i][col_idx] for i in range(self.n))\n\n    def get_main_diagonal_sum(self) -> int:\n        return sum(self.values[i][i] for i in range(self.n))\n\n    def get_secondary_diagonal_sum(self) -> int:\n        return sum(self.values[i][self.n - 1 - i] for i in range(self.n))\nclass MagicSquareChecker:\n    \"\"\"Implements MagicSquareChecker with validation and check methods.\"\"\"\n    def __init__(self):\n        self.magic_constant = 0\n\n    def validate_structure(self, m: Matrix) -> ValidationResult:\n        if not isinstance(m.values, list):\n            return ValidationResult(False, \"Input is not a list.\")\n        if m.n == 0:\n            return ValidationResult(False, \"Matrix is empty.\")\n        if not all(isinstance(row, list) for row in m.values):\n            return ValidationResult(False, \"Matrix rows are not all lists.\")\n        if not all(len(row) == m.n for row in m.values):\n            return ValidationResult(False, \"Matrix is not square (rows have unequal length or not n*n).\")\n        return ValidationResult(True)\n\n    def validate_elements(self, m: Matrix) -> ValidationResult:\n        for row in m.values:\n            for element in row:\n                if not isinstance(element, int):\n                    return ValidationResult(False, \"Matrix contains non-integer elements.\")\n        return ValidationResult(True)\n\n    def compute_magic_constant(self, m: Matrix) -> int:\n        self.magic_constant = m.get_row_sum(0)\n        return self.magic_constant\n\n    def check_rows(self, m: Matrix) -> bool:\n        for i in range(m.n):\n            if m.get_row_sum(i) != self.magic_constant:\n                return False\n        return True\n\n    def check_columns(self, m: Matrix) -> bool:\n        for i in range(m.n):\n            if m.get_col_sum(i) != self.magic_constant:\n                return False\n        return True\n\n    def check_diagonals(self, m: Matrix) -> bool:\n        if m.get_main_diagonal_sum() != self.magic_constant:\n            return False\n        if m.get_secondary_diagonal_sum() != self.magic_constant:\n            return False\n        return True\n\n    def check_unique_1_to_n2(self, m: Matrix) -> bool:\n        n_squared = m.n * m.n\n        seen_numbers = set()\n        for row in m.values:\n            for element in row:\n                if not (1 <= element <= n_squared):\n                    return False\n                if element in seen_numbers:\n                    return False\n                seen_numbers.add(element)\n        return len(seen_numbers) == n_squared\n\n    def is_magic(self, m: Matrix) -> bool:\n        structure_res = self.validate_structure(m)\n        if not structure_res.is_valid:\n            return False\n\n        elements_res = self.validate_elements(m)\n        if not elements_res.is_valid:\n            return False\n\n        self.compute_magic_constant(m)\n\n        if not self.check_rows(m):\n            return False\n        if not self.check_columns(m):\n            return False\n        if not self.check_diagonals(m):\n            return False\n        if not self.check_unique_1_to_n2(m):\n            return False\n\n        return True\ndef magic_square_test(matrix: List[List[int]]) -> bool:\n    \"\"\"\n    Determines whether a given n\u00d7n integer matrix is a \"normal\" magic square.\n    Handles malformed inputs gracefully by returning False.\n    \"\"\"\n    try:\n        m = Matrix(matrix)\n        checker = MagicSquareChecker()\n        return checker.is_magic(m)\n    except Exception:\n        return False"}
{"task_id": "Mbpp/133", "solution": "def sum_negativenum(numbers):\n    \"\"\"Return numeric sum of elements x in numbers where x < 0.\n    Ignores zeros and positive numbers, returning 0 if no negative elements are present.\n    \"\"\"\n    total_sum = 0\n    for num in numbers:\n        if num < 0:\n            total_sum += num\n    return total_sum"}
{"task_id": "Mbpp/135", "solution": "def _compute_formula(n: int) -> int:\n    \"\"\"Calculates the nth hexagonal number using the formula.\"\"\"\n    return n * (2 * n - 1)\ndef hexagonal_num(n: int) -> int:\n    \"\"\"Compute and return the nth hexagonal number.\n\n    This function uses the formula H_n = n * (2*n - 1).\n    \"\"\"\n    return _compute_formula(n)"}
{"task_id": "Mbpp/131", "solution": "class VowelSet:\n    \"\"\"Helper class to encapsulate vowel characters and provide a membership test.\"\"\"\n    vowels: set[str] = {'a','e','i','o','u','A','E','I','O','U'}\n\n    def is_vowel(self, c: str) -> bool:\n        \"\"\"Checks if a given character is a vowel.\"\"\"\n        return c in self.vowels\ndef reverse_vowels(s: str) -> str:\n    \"\"\"Reverses only the vowels of a given string, preserving non-vowel positions.\"\"\"\n    if not isinstance(s, str):\n        raise TypeError(\"Input must be a string.\")\n\n    vowel_checker = VowelSet()\n    s_list = list(s)\n    \n    # Collect all vowels from the string\n    found_vowels = [char for char in s_list if vowel_checker.is_vowel(char)]\n    \n    # Reverse the order of the collected vowels\n    found_vowels.reverse()\n    \n    # Replace vowels in the original string with the reversed vowels\n    vowel_index = 0\n    for i in range(len(s_list)):\n        if vowel_checker.is_vowel(s_list[i]):\n            s_list[i] = found_vowels[vowel_index]\n            vowel_index += 1\n            \n    return \"\".join(s_list)"}
{"task_id": "Mbpp/138", "solution": "def is_Sum_Of_Powers_Of_Two(n: int) -> bool:\n    \"\"\"Return True iff n can be represented as a sum of non-zero powers of two (2^k, k >= 1).\n\n    This is true for all positive even integers, and false otherwise.\n    \"\"\"\n    if not isinstance(n, int):\n        return False\n    if n <= 0:\n        return False\n    if n % 2 != 0:\n        return False\n    return True"}
{"task_id": "Mbpp/132", "solution": "def tup_string(inputTuple):\n    \"\"\"Converts a tuple of strings to a single string, validating input and element types.\n    Raises TypeError for non-tuple input or ValueError for non-string elements.\"\"\"\n    # If input is not a tuple, raise TypeError (BR2).\n    if not isinstance(inputTuple, tuple):\n        raise TypeError(\"Input must be a tuple.\")\n\n    # If any element is not a string, raise ValueError (BR3).\n    for element in inputTuple:\n        if not isinstance(element, str):\n            raise ValueError(\"All elements in the tuple must be strings.\")\n\n    # Concatenate elements in original order and return the result (BR4, BR6).\n    return \"\".join(inputTuple)"}
{"task_id": "Mbpp/137", "solution": "from dataclasses import dataclass\nfrom typing import List, Tuple, Iterable\ndef _count_elements(arr: Iterable[int]) -> Tuple[int, int]:\n    \"\"\"Return (zero_count, non_zero_count) as ints.\"\"\"\n    zero_count = 0\n    non_zero_count = 0\n    for element in arr:\n        if element == 0:\n            zero_count += 1\n        else:\n            non_zero_count += 1\n    return zero_count, non_zero_count\ndef zero_count(arr: Iterable[int]) -> float:\n    \"\"\"Public API: compute ratio of zeros to non-zeros; returns float.\"\"\"\n    validate_input(arr)\n    z, n = _count_elements(arr)\n    stats = CountStats(z, n)\n    return stats.compute_ratio()"}
{"task_id": "Mbpp/139", "solution": "import math\nclass Circle:\n    def __init__(self, radius: float) -> None:\n        \"\"\"Construct a circle with the given numeric radius.\"\"\"\n        self.radius: float = radius\n\n    def circumference(self) -> float:\n        \"\"\"Return circumference computed as 2 * math.pi * radius.\"\"\"\n        return 2.0 * math.pi * self.radius\nclass CircleService:\n    def circle_circumference(self, radius: float) -> float:\n        \"\"\"Compute and return circumference for given radius using Circle domain entity.\"\"\"\n        c = Circle(radius)\n        return float(c.circumference())\ndef circle_circumference(radius: float) -> float:\n    \"\"\"Public API required by SRS. Delegates to CircleService.\"\"\"\n    service = CircleService()\n    return service.circle_circumference(radius)"}
{"task_id": "Mbpp/140", "solution": "from typing import Iterable\ndef extract_singly(input: Iterable[Iterable[int]]) -> set[int]:\n    \"\"\"Accept an iterable of iterables of numbers, flatten one level, deduplicate and return an iterable of unique numbers.\n\n    Parameter:\n      input: an iterable whose elements are iterables of numeric values\n\n    Returns:\n      An iterable (concrete: set) containing unique numeric values found in nested iterables.\n    \"\"\"\n    unique_numbers = set()\n    for nested_iterable in input:\n        for number in nested_iterable:\n            unique_numbers.add(number)\n    return unique_numbers"}
{"task_id": "Mbpp/142", "solution": "from src.comparison_engine import ComparisonEngine\nfrom src.result_counter import ResultCounter\ndef count_samepair(l1: list, l2: list, l3: list) -> int:\n    \"\"\"\n    Counts number of identical items in the same position across three lists.\n    Compares elements using equality (==) up to the length of the shortest list.\n    \"\"\"\n    comparison_engine = ComparisonEngine()\n    result_counter = ResultCounter()\n\n    min_len = min(len(l1), len(l2), len(l3))\n\n    for i in range(min_len):\n        if (comparison_engine.equals(l1[i], l2[i]) and\n            comparison_engine.equals(l2[i], l3[i])):\n            result_counter.increment()\n\n    return result_counter.value()"}
{"task_id": "Mbpp/141", "solution": "from typing import Any\ndef _find_max_index(arr: list, n: int) -> int:\n    \"\"\"\n    Finds index of maximum element among arr[0:n], raising NonComparableElementsException if comparison fails.\n    \"\"\"\n    max_idx = 0\n    for i in range(1, n):\n        _ensure_comparable_pair(arr[max_idx], arr[i])\n        if arr[i] > arr[max_idx]:\n            max_idx = i\n    return max_idx\ndef pancake_sort(items: list) -> list:\n    \"\"\"\n    Sorts a list of elements in ascending order using the pancake sort algorithm.\n    Returns a new list without mutating the input, raising NonComparableElementsException for incomparable elements.\n    \"\"\"\n    arr = list(items)  # Create a shallow copy to avoid mutating the input\n\n    n = len(arr)\n\n    if n <= 1:\n        return arr\n\n    # Perform pancake sort\n    for current_size in range(n, 1, -1):\n        # Find index of the maximum element in arr[0...current_size-1]\n        max_idx = _find_max_index(arr, current_size)\n\n        # If max element is not already at the correct position\n        if max_idx != current_size - 1:\n            # Move the maximum element to the beginning\n            _flip(arr, max_idx + 1)\n\n            # Move the maximum element to its correct position at the end of the current_size range\n            _flip(arr, current_size)\n\n    return arr"}
{"task_id": "Mbpp/145", "solution": "from typing import Sequence, Union\ndef max_Abs_Diff(sequence: Sequence[Union[int, float]]) -> Union[int, float]:\n    \"\"\"Compute the maximum absolute difference between any two numeric elements.\n\n    This function finds the minimum and maximum values in a sequence in a single pass\n    and returns their absolute difference, handling validation errors for empty\n    or non-numeric sequences.\n    \"\"\"\n    iterator = iter(sequence)\n\n    try:\n        first_element = next(iterator)\n    except StopIteration:\n        raise ValueError(\"Input sequence cannot be empty.\")\n\n    if not isinstance(first_element, (int, float)):\n        raise TypeError(\"All elements in the sequence must be numeric (int or float).\")\n\n    min_val = first_element\n    max_val = first_element\n\n    for element in iterator:\n        if not isinstance(element, (int, float)):\n            raise TypeError(\"All elements in the sequence must be numeric (int or float).\")\n        if element < min_val:\n            min_val = element\n        if element > max_val:\n            max_val = element\n\n    return abs(max_val - min_val)"}
{"task_id": "Mbpp/161", "solution": "from typing import List, Any\ndef _is_hashable(obj: Any) -> bool:\n    \"\"\"Checks if an object is hashable.\"\"\"\n    try:\n        hash(obj)\n        return True\n    except TypeError:\n        return False\ndef remove_elements(source: List[Any], removal: List[Any]) -> List[Any]:\n    \"\"\"\n    Returns a new list containing elements from the source list that are not present in the removal list,\n    preserving order and not modifying the input lists.\n    \"\"\"\n    if not removal:\n        return list(source) # Return a shallow copy if no elements to remove\n\n    result = []\n    \n    # Determine if all elements in the removal list are hashable to optimize lookup\n    all_hashable = True\n    for item in removal:\n        if not _is_hashable(item):\n            all_hashable = False\n            break\n\n    if all_hashable:\n        # Optimal path: use a set for O(1) average time complexity lookups\n        removal_set = set(removal)\n        for item in source:\n            if item not in removal_set:\n                result.append(item)\n    else:\n        # Fallback path: iterate through removal list for each source item for correctness\n        for item in source:\n            found_in_removal = False\n            for removal_item in removal:\n                if item == removal_item:\n                    found_in_removal = True\n                    break\n            if not found_in_removal:\n                result.append(item)\n\n    return result"}
{"task_id": "Mbpp/162", "solution": "class SumSeriesFunction:\n    \"\"\"Encapsulates validation and sum computation logic for the series.\"\"\"\n    def sum_series(self, n: int) -> int:\n        \"\"\"Entry method; returns 0 for invalid/<=0 inputs or computed sum otherwise.\"\"\"\n        if not self.validateInput(n):\n            return 0\n        return self.computeSum(n)\n\n    def validateInput(self, n: int) -> bool:\n        \"\"\"Returns True only when n is an integer and n > 0.\"\"\"\n        return isinstance(n, int) and n > 0\n\n    def computeSum(self, n: int) -> int:\n        \"\"\"Computes sum of positive terms (n - 2*i) while term > 0.\"\"\"\n        current_sum = 0\n        i = 0\n        while True:\n            term = n - 2 * i\n            if term <= 0:\n                break\n            current_sum += term\n            i += 1\n        return current_sum\ndef sum_series(n: int) -> int:\n    \"\"\"\n    Calculates the sum (n - 2*i) from i=0 to n // 2, until the term is <= 0.\n    Delegates to an internal implementation for validation and computation.\n    \"\"\"\n    return SumSeriesFunction().sum_series(n)"}
{"task_id": "Mbpp/165", "solution": "class InputString:\n    \"\"\"Encapsulates the raw input string.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the encapsulated string.\"\"\"\n        return len(self.value)\nclass AlphabetMap:\n    \"\"\"Maps uppercase English letters to their 1-based alphabet positions.\"\"\"\n    def __init__(self):\n        self.letterToPosition = {\n            chr(ord('A') + i): i + 1 for i in range(26)\n        }\n\n    def getPosition(self, ch: str) -> int | None:\n        \"\"\"Returns the 1-based alphabet position of a character, case-insensitive.\"\"\"\n        upper_ch = ch.upper()\n        return self.letterToPosition.get(upper_ch)\nclass Character:\n    \"\"\"Represents a single character with its 1-based index in the string.\"\"\"\n    def __init__(self, ch: str, indexInString: int, alphabet_map: AlphabetMap):\n        self.ch = ch\n        self.indexInString = indexInString\n        self._alphabet_map = alphabet_map\n\n    def isAlphabetic(self) -> bool:\n        \"\"\"Checks if the character is an English letter.\"\"\"\n        return self._alphabet_map.getPosition(self.ch) is not None\n\n    def alphabetPosition(self) -> int | None:\n        \"\"\"Returns the 1-based alphabet position of the character.\"\"\"\n        return self._alphabet_map.getPosition(self.ch)\nclass MatchResult:\n    \"\"\"Accumulates the count of matching characters.\"\"\"\n    def __init__(self):\n        self._count = 0\n\n    def increment(self) -> None:\n        \"\"\"Increments the internal count.\"\"\"\n        self._count += 1\n\n    @property\n    def count(self) -> int:\n        \"\"\"Returns the current count.\"\"\"\n        return self._count\nclass Analyzer:\n    \"\"\"Implements the core algorithm for counting character-alphabet-position matches.\"\"\"\n    def __init__(self, alphabet_map: AlphabetMap | None = None):\n        self.alphabet_map = alphabet_map if alphabet_map is not None else AlphabetMap()\n\n    def count_char_position(self, s: str) -> int:\n        \"\"\"Counts characters whose alphabet position equals their 1-based string index.\"\"\"\n        input_string = InputString(value=s)\n        match_result = MatchResult()\n\n        for i in range(1, input_string.length() + 1):\n            ch = s[i - 1]\n            character = Character(ch, indexInString=i, alphabet_map=self.alphabet_map)\n            if self.isMatch(character):\n                match_result.increment()\n\n        return match_result.count\n\n    def isMatch(self, c: Character) -> bool:\n        \"\"\"Determines if a character's alphabet position matches its string index.\"\"\"\n        if not c.isAlphabetic():\n            return False\n        \n        char_pos = c.alphabetPosition()\n        return char_pos == c.indexInString\ndef count_char_position(s: str) -> int:\n    \"\"\"Counts characters whose alphabet position equals their 1-based string index.\"\"\"\n    return Analyzer().count_char_position(s)"}
{"task_id": "Mbpp/160", "solution": "def find_solution(a: int, b: int, n: int) -> tuple[int, int] | None:\n    \"\"\"\n    Finds integer solutions (x, y) for the linear Diophantine equation ax + by = n.\n    Returns (x, y) as a tuple, or None if no integer solution exists.\n    \"\"\"\n    def extended_euclid(a_val: int, b_val: int) -> tuple[int, int, int]:\n        \"\"\"\n        Computes (g, x, y) such that g = gcd(a_val, b_val) and a_val*x + b_val*y = g.\n        This recursive implementation returns a non-negative g.\n        \"\"\"\n        if a_val == 0:\n            return (b_val, 0, 1)\n        else:\n            g, x, y = extended_euclid(b_val % a_val, a_val)\n            return (g, y - (b_val // a_val) * x, x)\n\n    # Handle the special case where both coefficients are zero.\n    if a == 0 and b == 0:\n        return (0, 0) if n == 0 else None\n\n    # Compute gcd(a, b) and Bezout coefficients x0, y0 for a*x0 + b*y0 = g.\n    g, x0, y0 = extended_euclid(a, b)\n\n    # If n is not divisible by g, no integer solution exists.\n    if n % g != 0:\n        return None\n\n    # Scale the Bezout coefficients to find a particular solution for n.\n    k = n // g\n    x_particular = x0 * k\n    y_particular = y0 * k\n\n    # Canonicalize the solution: shift x to be the smallest non-negative integer.\n    # The general solution is (x_p + t * (b/g), y_p - t * (a/g)).\n    step_x = b // g\n    step_y = - (a // g)\n\n    if step_x != 0:\n        # Calculate t to shift x to its smallest non-negative congruent value.\n        # x_shifted will be in the range [0, abs(step_x) - 1].\n        x_shifted = x_particular % abs(step_x)\n        t = (x_shifted - x_particular) // step_x\n\n        x_final = x_particular + t * step_x\n        y_final = y_particular + t * step_y\n    else:\n        # If step_x is zero (implying b is zero), x is uniquely determined.\n        x_final = x_particular\n        y_final = y_particular\n    \n    return (x_final, y_final)"}
{"task_id": "Mbpp/166", "solution": "from typing import List\ndef _choose2(n: int) -> int:\n    \"\"\"Calculates C(n, 2), the number of ways to choose 2 items from n.\"\"\"\n    if n < 2:\n        return 0\n    return n * (n - 1) // 2\ndef find_even_pair(list_of_integers: List[int]) -> int:\n    \"\"\"Counts pairs of integers in a list that XOR to an even number.\"\"\"\n    n = len(list_of_integers)\n    if n < 2:\n        return 0\n\n    even_count = 0\n    odd_count = 0\n\n    for num in list_of_integers:\n        if (num & 1) == 0:  # Check if the number is even\n            even_count += 1\n        else:  # The number is odd\n            odd_count += 1\n\n    # Pairs with even XOR are (Even, Even) or (Odd, Odd)\n    # Count (Even, Even) pairs: C(even_count, 2)\n    # Count (Odd, Odd) pairs: C(odd_count, 2)\n    total_even_xor_pairs = _choose2(even_count) + _choose2(odd_count)\n\n    return total_even_xor_pairs"}
{"task_id": "Mbpp/167", "solution": "def next_power_of_2(n: int) -> int:\n    \"\"\"\n    Compute and return the smallest power of two greater than or equal to n.\n    Must return 1 when n == 0.\n    \"\"\"\n    if n <= 0:\n        return 1\n    \n    # Decrement n to handle cases where n is already a power of 2.\n    # This prepares n for the bit manipulation to find the next power of 2.\n    n -= 1\n    \n    # Set all bits to the right of the most significant bit.\n    # This effectively creates a number with all 1s up to the MSB.\n    n |= n >> 1\n    n |= n >> 2\n    n |= n >> 4\n    n |= n >> 8\n    n |= n >> 16\n    n |= n >> 32 # For 64-bit numbers, this is also included.\n    n |= n >> 64 # Python handles arbitrary precision, but these cover common integer sizes.\n    \n    # Increment the result to get the smallest power of 2.\n    return n + 1"}
{"task_id": "Mbpp/168", "solution": "def frequency(list, number) -> int:\n    \"\"\"Return the count of occurrences of 'number' within 'list'.\n    Precondition: caller supplies a sequence-like 'list' and a comparable 'number'.\n    \"\"\"\n    count = 0\n    for item in list:\n        if item == number:\n            count += 1\n    return count"}
{"task_id": "Mbpp/170", "solution": "def sum_range_list(list, startIndex, endIndex):\n    \"\"\"Compute sum of elements in list from startIndex to endIndex inclusive (0-based indices).\n    Parameter names match SRS. Returns numeric value (int/float).\n    \"\"\"\n    total = 0\n    for i in range(startIndex, endIndex + 1):\n        total += list[i]\n    return total"}
{"task_id": "Mbpp/222", "solution": "def check_type(tuple_input: tuple) -> bool:\n    \"\"\"\n    Checks if all elements in the input tuple have the same data type.\n    An empty tuple or a tuple with a single element is considered to have\n    all elements of the same type.\n    \"\"\"\n    if not tuple_input:\n        return True\n    \n    first_type = type(tuple_input[0])\n    for element in tuple_input[1:]:\n        if type(element) is not first_type:\n            return False\n    return True"}
{"task_id": "Mbpp/171", "solution": "class SideLength:\n    def __init__(self, value):\n        self.value = value\n    def is_numeric(self):\n        return isinstance(self.value, (int, float))\nclass Pentagon:\n    def __init__(self, side_length: SideLength):\n        self.side_length = side_length\n    def get_perimeter(self):\n        return 5 * self.side_length.value\nclass PerimeterCalculator:\n    def perimeter_pentagon(self, side_length):\n        sl = SideLength(side_length)\n        # Validation for numeric input is omitted as per completion constraints.\n        pent = Pentagon(sl)\n        return pent.get_perimeter()\ndef perimeter_pentagon(side_length):\n    \"\"\"\n    Calculates the perimeter of a regular pentagon given its side length.\n    \"\"\"\n    calc = PerimeterCalculator()\n    return calc.perimeter_pentagon(side_length)"}
