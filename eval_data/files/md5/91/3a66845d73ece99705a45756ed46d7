{"task_id": "Mbpp/567", "solution": "class ListInput:\n    \"\"\"Encapsulates an input list and its length.\"\"\"\n    def __init__(self, elements: list) -> None:\n        self.elements = elements\n        self.length = len(elements)\nclass Result:\n    \"\"\"Container for the boolean outcome of a sort check.\"\"\"\n    def __init__(self, is_sorted: bool) -> None:\n        self.is_sorted = is_sorted\nclass Comparator:\n    \"\"\"Stateless utility for comparing two elements using non-decreasing order.\"\"\"\n    def compare(self, a, b) -> bool:\n        return a <= b\nclass SortChecker:\n    \"\"\"Determines if a list is sorted in non-decreasing order.\"\"\"\n    def issort_list(self, input_list: ListInput) -> Result:\n        # Empty and single-element lists are considered sorted.\n        if input_list.length <= 1:\n            return Result(True)\n\n        comparator = Comparator()\n        for i in range(input_list.length - 1):\n            if not comparator.compare(input_list.elements[i], input_list.elements[i+1]):\n                return Result(False)\n        return Result(True)\ndef issort_list(input_list) -> bool:\n    \"\"\"\n    Validate input_list is a list; raise TypeError if not.\n    Return True if input_list is sorted in non-decreasing order (list[i] <= list[i+1] for all i), otherwise False.\n    \"\"\"\n    if not isinstance(input_list, list):\n        raise TypeError(\"Input must be a list.\")\n\n    list_input = ListInput(elements=input_list)\n    checker = SortChecker()\n    result = checker.issort_list(list_input)\n    return result.is_sorted"}
{"task_id": "Mbpp/572", "solution": "from typing import List\ndef two_unique_nums(input: List[int]) -> List[int]:\n    \"\"\"Return a list of integers from 'input' that occur exactly once, preserving original order.\"\"\"\n    frequency_map = {}\n    for num in input:\n        frequency_map[num] = frequency_map.get(num, 0) + 1\n\n    result = []\n    for num in input:\n        if frequency_map[num] == 1:\n            result.append(num)\n            \n    return result"}
{"task_id": "Mbpp/573", "solution": "class NumberList:\n    \"\"\"A container for a list of numbers.\"\"\"\n    def __init__(self, items: list):\n        self.items = items\nclass UniqueNumberSet:\n    \"\"\"Extracts unique numbers from a NumberList.\"\"\"\n    def __init__(self):\n        self.values = set()\n\n    def extract_from_list(self, number_list: NumberList) -> set:\n        \"\"\"Returns a set of unique numbers from the given NumberList.\"\"\"\n        self.values = set(number_list.items)\n        return self.values\nclass ProductResult:\n    \"\"\"A container for a numeric product result.\"\"\"\n    def __init__(self, value: 'number'):\n        self.value = value\nclass UniqueProductFunction:\n    \"\"\"Computes the product of a set of unique numbers.\"\"\"\n    @staticmethod\n    def compute_product_of_set(unique_numbers_set: set) -> 'number':\n        \"\"\"Calculates the product of numbers in a given set.\"\"\"\n        if not unique_numbers_set:\n            return 1 # Multiplicative identity for an empty set\n\n        product = 1\n        for num in unique_numbers_set:\n            product *= num\n        return product\ndef unique_product(numbers: list) -> 'number':\n    \"\"\"\n    Calculates the product of the unique numbers in a given list.\n    Each distinct value is multiplied exactly once.\n    \"\"\"\n    number_list_obj = NumberList(numbers)\n    unique_number_set_extractor = UniqueNumberSet()\n    unique_values = unique_number_set_extractor.extract_from_list(number_list_obj)\n\n    product_value = UniqueProductFunction.compute_product_of_set(unique_values)\n\n    result_obj = ProductResult(product_value)\n    return result_obj.value"}
{"task_id": "Mbpp/576", "solution": "def _search_contiguous_subsequence(list_main, list_sub) -> bool:\n    \"\"\"Implements contiguous subsequence search using a sliding window.\"\"\"\n    len_main = len(list_main)\n    len_sub = len(list_sub)\n\n    for i in range(len_main - len_sub + 1):\n        if list_main[i:i+len_sub] == list_sub:\n            return True\n    return False\ndef is_Sub_Array(list_main, list_sub):\n    \"\"\"\n    Return True if list_sub is a contiguous sublist of list_main, else False.\n    Raises TypeError if inputs are not lists.\n    \"\"\"\n    _validate_inputs(list_main, list_sub)\n\n    if not list_sub:\n        return True\n\n    if len(list_sub) > len(list_main):\n        return False\n\n    return _search_contiguous_subsequence(list_main, list_sub)"}
{"task_id": "Mbpp/577", "solution": "def last_Digit_Factorial(n):\n    \"\"\"\n    Returns the last decimal digit (0..9) of n! or raises TypeError/ValueError.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an int\")\n    if n < 0:\n        raise ValueError(\"n must be non-negative\")\n\n    if n == 0 or n == 1:\n        return 1\n    elif n == 2:\n        return 2\n    elif n == 3:\n        return 6\n    elif n == 4:\n        return 4\n    else:  # n >= 5\n        return 0"}
{"task_id": "Mbpp/578", "solution": "def interleave_lists(list1, list2, list3):\n    \"\"\"\n    Interleave three lists of equal length into a single flat list.\n\n    Raises:\n        LengthMismatchException: if not all three input lists have equal length.\n    \"\"\"\n    _validate_lengths(list1, list2, list3)\n    n = len(list1)\n    result = [None] * (3 * n)\n    for i in range(n):\n        base = 3 * i\n        result[base]   = list1[i]\n        result[base+1] = list2[i]\n        result[base+2] = list3[i]\n    return result"}
{"task_id": "Mbpp/579", "solution": "def find_dissimilar(t1: tuple, t2: tuple) -> tuple:\n    \"\"\"Compute a tuple containing elements that are present in exactly one of the input tuples,\n    preserving ordering rules and ensuring output uniqueness.\n    \"\"\"\n    set_t1 = set(t1)\n    set_t2 = set(t2)\n    result_list = []\n    added_to_result_set = set()\n\n    # Add elements from t1 that are not in t2, preserving order and ensuring uniqueness\n    for item in t1:\n        if item not in set_t2 and item not in added_to_result_set:\n            result_list.append(item)\n            added_to_result_set.add(item)\n\n    # Add elements from t2 that are not in t1, preserving order and ensuring uniqueness\n    for item in t2:\n        if item not in set_t1 and item not in added_to_result_set:\n            result_list.append(item)\n            added_to_result_set.add(item)\n\n    return tuple(result_list)"}
{"task_id": "Mbpp/580", "solution": "def extract_even(input_tuple: tuple) -> tuple:\n    \"\"\"Return a new tuple filtered to contain only even integers (recursively) preserving original order and nesting.\n\n    Args:\n        input_tuple: tuple whose elements are integers or nested tuples of integers\n\n    Returns:\n        tuple: a new tuple with odd integers removed at all nesting levels\n    \"\"\"\n    result = []\n    for element in input_tuple:\n        if isinstance(element, int):\n            if element % 2 == 0:\n                result.append(element)\n        elif isinstance(element, tuple):\n            processed_sub_tuple = extract_even(element)\n            if processed_sub_tuple: # Only add non-empty sub-tuples\n                result.append(processed_sub_tuple)\n    return tuple(result)"}
{"task_id": "Mbpp/583", "solution": "from dataclasses import dataclass\nfrom typing import Any\ndef compute(n: int) -> int:\n    \"\"\"Compute nth Catalan number exactly using DP recurrence.\"\"\"\n    if n == 0:\n        return 1\n    \n    catalan = [0] * (n + 1)\n    catalan[0] = 1\n\n    # Using the recurrence C_i = (C_{i-1} * 2 * (2*i - 1)) / (i + 1)\n    for i in range(1, n + 1):\n        catalan[i] = (catalan[i-1] * (4 * i - 2)) // (i + 1)\n    \n    return catalan[n]\ndef catalan_number(n: int) -> int:\n    \"\"\"Public API. Validate then compute. Raises ValidationError on invalid input.\"\"\"\n    validate(n)\n    return compute(n)"}
{"task_id": "Mbpp/581", "solution": "class NumericParameter:\n    def __init__(self, name: str, value):\n        self.name = name\n        self.value = value\n\n    def is_numeric(self) -> bool:\n        \"\"\"Checks if the parameter value is an integer or a float.\"\"\"\n        return isinstance(self.value, (int, float))\nclass SquarePyramid:\n    def __init__(self, base_edge: float, height: float):\n        self._base_edge = base_edge\n        self._height = height\n        self._surface_area = None\n\n    def compute_surface_area(self) -> float:\n        \"\"\"Calculates the total surface area of the square pyramid.\"\"\"\n        self._surface_area = (self._base_edge ** 2) + 2 * self._base_edge * self._height\n        return self._surface_area\ndef surface_Area(base_edge, height):\n    \"\"\"Compute total surface area of square pyramid: base_edge**2 + 2*base_edge*height.\n\n    Validates inputs and uses a SquarePyramid object for calculation.\n    \"\"\"\n    p_base = NumericParameter(\"base_edge\", base_edge)\n    p_height = NumericParameter(\"height\", height)\n\n    if not (p_base.is_numeric() and p_height.is_numeric()):\n        raise TypeError(\"base_edge and height must be numeric (int or float)\")\n\n    pyramid = SquarePyramid(float(base_edge), float(height))\n    return pyramid.compute_surface_area()"}
{"task_id": "Mbpp/585", "solution": "from typing import List, Dict, Any, Union\nfrom dataclasses import dataclass\nclass Validator:\n    \"\"\"Validates dataset item structure and required fields.\"\"\"\n    def has_required_fields(self, item: Dict[str, Any]) -> bool:\n        \"\"\"Checks if an item dictionary has 'name' and a numeric 'price'.\"\"\"\n        if 'name' not in item or 'price' not in item:\n            return False\n        price = item['price']\n        return isinstance(price, (int, float))\nclass Sorter:\n    \"\"\"Sorts items by price in descending order.\"\"\"\n    def sort_by_price_desc(self, items: List[Dict[str, Any]]) -> List[Dict[str, Any]]:\n        \"\"\"Returns a new list sorted by item['price'] in descending order.\"\"\"\n        return sorted(items, key=lambda x: x['price'], reverse=True)\nclass ExpensiveItemsService:\n    \"\"\"Orchestrates validation, sorting, and selection of top-n expensive items.\"\"\"\n    def __init__(self, validator: Validator = None, sorter: Sorter = None):\n        \"\"\"Initializes the service with optional injected validator and sorter.\"\"\"\n        self._validator = validator if validator is not None else Validator()\n        self._sorter = sorter if sorter is not None else Sorter()\n\n    def validate_item(self, item: Dict[str, Any]) -> bool:\n        \"\"\"Delegates item validation to the Validator.\"\"\"\n        return self._validator.has_required_fields(item)\n\n    def sort_by_price_desc(self, items: List[Dict[str, Any]]) -> List[Dict[str, Any]]:\n        \"\"\"Delegates item sorting to the Sorter.\"\"\"\n        return self._sorter.sort_by_price_desc(items)\n\n    def expensive_items(self, dataset: List[Dict[str, Any]], n: int) -> List[Dict[str, Any]]:\n        \"\"\"Orchestrates the process to find the n most expensive items.\"\"\"\n        validated_items = [item for item in dataset if self.validate_item(item)]\n        sorted_items = self.sort_by_price_desc(validated_items)\n        return sorted_items[:n]\ndef expensive_items(dataset: List[Dict[str, Any]], n: int) -> List[Dict[str, Any]]:\n    \"\"\"Finds the n most expensive items in a given dataset.\"\"\"\n    service = ExpensiveItemsService()\n    return service.expensive_items(dataset, n)"}
