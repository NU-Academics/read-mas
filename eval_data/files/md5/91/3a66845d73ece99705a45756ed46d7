{"task_id": "Mbpp/284", "solution": "def check_element(list, element) -> bool:\n    \"\"\"\n    Return True iff every item in the given iterable equals the provided element.\n    Raises TypeError if the first argument is not an iterable.\n    \"\"\"\n    try:\n        iterator = iter(list)\n    except TypeError:\n        raise TypeError(\"The first argument must be an iterable.\")\n\n    for item in iterator:\n        if item != element:\n            return False\n    return True"}
{"task_id": "Mbpp/283", "solution": "import collections\nfrom typing import List, Dict\nclass IntegerInput:\n    \"\"\"Represents an input integer and provides its decimal digits.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n        self.digit_string = str(abs(value))\n\n    def get_digits(self) -> List[int]:\n        \"\"\"Extracts and returns the absolute decimal digits of the integer as a list of ints.\"\"\"\n        return [int(d) for d in self.digit_string]\nclass FrequencyChecker:\n    \"\"\"Service for checking digit frequency against digit value.\"\"\"\n    def count_frequencies(self, digits: List[int]) -> Dict[int, int]:\n        \"\"\"Counts occurrences of each digit and returns a mapping from digit to count.\"\"\"\n        return collections.Counter(digits)\n\n    def validate(self, n: int) -> bool:\n        \"\"\"Validates if the frequency of each digit in the integer is less than or equal to the digit itself.\"\"\"\n        integer_input = IntegerInput(n)\n        digits = integer_input.get_digits()\n        frequency_map = self.count_frequencies(digits)\n\n        for digit, count in frequency_map.items():\n            if count > digit:\n                return False\n        return True\ndef validate(n: int) -> bool:\n    \"\"\"\n    Checks if the frequency of each digit in the integer is less than or equal to the digit itself.\n    \"\"\"\n    checker = FrequencyChecker()\n    return checker.validate(n)"}
{"task_id": "Mbpp/287", "solution": "from typing import Iterator\ndef square_Sum(n: int) -> int:\n    \"\"\"\n    Calculates the sum of squares of the first n even natural numbers.\n    For n=2, this would be (2*1)^2 + (2*2)^2 = 4 + 16 = 20.\n    \"\"\"\n    total_sum = 0\n    for even_num in _generate_even_numbers(n):\n        total_sum += even_num ** 2\n    return total_sum"}
{"task_id": "Mbpp/285", "solution": "class InputString:\n    \"\"\"Value object for the input string.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the string.\"\"\"\n        return len(self.value)\n\n    def isEmpty(self) -> bool:\n        \"\"\"Checks if the string is empty.\"\"\"\n        return self.length() == 0\nclass MatchPattern:\n    \"\"\"Matches a literal string within another string.\"\"\"\n    def __init__(self, literal: str):\n        self.literal = literal\n\n    def matches(self, s: str) -> bool:\n        \"\"\"Returns True if the literal appears anywhere in s (case-sensitive).\"\"\"\n        return self.literal in s\nclass TextMatcher:\n    \"\"\"Encapsulates logic for matching specific patterns.\"\"\"\n    def __init__(self):\n        self._pattern_two = MatchPattern(\"abb\")\n        self._pattern_three = MatchPattern(\"abbb\")\n\n    def text_match_two_three(self, input: str) -> bool:\n        \"\"\"Checks if the input string contains 'abb' or 'abbb'.\"\"\"\n        input_obj = InputString(input)\n\n        if input_obj.isEmpty():\n            return False\n\n        if self._pattern_two.matches(input_obj.value):\n            return True\n\n        if self._pattern_three.matches(input_obj.value):\n            return True\n\n        return False\ndef text_match_two_three(input: str) -> bool:\n    \"\"\"Public API: returns True if 'abb' or 'abbb' exists anywhere in input (case-sensitive).\"\"\"\n    matcher = TextMatcher()\n    return matcher.text_match_two_three(input)"}
{"task_id": "Mbpp/290", "solution": "def max_length(list_of_lists):\n    \"\"\"Compute and return (n, lst) where n is maximum sublist length and lst is one input sublist of length n.\n\n    Precondition: list_of_lists is a list whose elements are lists (sublists).\n    \"\"\"\n    if not list_of_lists:\n        # Per design, behavior for empty input is unspecified, returning (0, []) as a reasonable default.\n        return (0, [])\n\n    max_len = len(list_of_lists[0])\n    longest_list = list_of_lists[0]\n\n    for sublist in list_of_lists[1:]:\n        current_len = len(sublist)\n        if current_len > max_len:\n            max_len = current_len\n            longest_list = sublist\n    return (max_len, longest_list)"}
