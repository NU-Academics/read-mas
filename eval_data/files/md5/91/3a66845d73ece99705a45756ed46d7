{"task_id": "Mbpp/750", "solution": "def _concatenate(input_list: list, input_tuple: tuple) -> list:\n    \"\"\"Concatenates the elements of the list and tuple into a new list.\"\"\"\n    return list(input_list) + list(input_tuple)\ndef add_tuple(input_list: list, input_tuple: tuple) -> list:\n    \"\"\"\n    Adds elements of a tuple to a list, returning a new list.\n    Validates input types and preserves element order.\n    \"\"\"\n    _validate_inputs(input_list, input_tuple)\n    return _concatenate(input_list, input_tuple)"}
{"task_id": "Mbpp/748", "solution": "class Character:\n    \"\"\"Represents a single character and provides classification predicates.\"\"\"\n    def __init__(self, value: str) -> None:\n        self.value = value\n\n    def is_upper(self) -> bool:\n        \"\"\"Checks if the character is an uppercase letter.\"\"\"\n        return self.value.isupper() and self.value.isalpha()\n\n    def is_lower(self) -> bool:\n        \"\"\"Checks if the character is a lowercase letter.\"\"\"\n        return self.value.islower() and self.value.isalpha()\nclass InsertionRule:\n    \"\"\"Encapsulates the decision logic for inserting a space between adjacent characters.\"\"\"\n    def should_insert(self, prev: Character, curr: Character) -> bool:\n        \"\"\"Returns True if a space should be inserted between prev and curr.\"\"\"\n        return prev is not None and prev.is_lower() and curr.is_upper()\nclass StringInput:\n    \"\"\"Domain holder for the input string.\"\"\"\n    def __init__(self, value: str) -> None:\n        self.value = value\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the input string.\"\"\"\n        return len(self.value)\nclass StringOutput:\n    \"\"\"Domain holder for the output string, built incrementally.\"\"\"\n    def __init__(self) -> None:\n        self._parts = []\n\n    def append(self, char_or_string: str) -> None:\n        \"\"\"Appends a character or string to the output.\"\"\"\n        self._parts.append(char_or_string)\n\n    @property\n    def value(self) -> str:\n        \"\"\"Returns the complete output string.\"\"\"\n        return \"\".join(self._parts)\nclass CapitalWordsSpaces:\n    \"\"\"Performs the transformation to insert spaces between words.\"\"\"\n    def __init__(self, rule: InsertionRule = None) -> None:\n        self._rule = rule if rule is not None else InsertionRule()\n\n    def apply(self, input_str: str) -> str:\n        \"\"\"Applies the space insertion rule to the input string.\"\"\"\n        string_input = StringInput(input_str)\n        string_output = StringOutput()\n\n        if string_input.length() == 0:\n            return \"\"\n\n        # Append the first character without a leading space (BR3)\n        string_output.append(string_input.value[0])\n        prev_char_obj = Character(string_input.value[0])\n\n        for i in range(1, string_input.length()):\n            curr_char = string_input.value[i]\n            curr_char_obj = Character(curr_char)\n\n            if self._rule.should_insert(prev_char_obj, curr_char_obj):\n                string_output.append(' ')\n            string_output.append(curr_char)\n            prev_char_obj = curr_char_obj\n\n        return string_output.value\ndef capital_words_spaces(input: str) -> str:\n    \"\"\"\n    Inserts spaces between words starting with capital letters in a given string.\n    e.g., \"HelloWorld\" becomes \"Hello World\"\n    \"\"\"\n    transformer = CapitalWordsSpaces()\n    return transformer.apply(input)"}
{"task_id": "Mbpp/751", "solution": "def _compare(a, b) -> int:\n    \"\"\"Compares two elements, raising TypeError if they are not comparable.\"\"\"\n    try:\n        if a < b:\n            return -1\n        elif a == b:\n            return 0\n        else: # a > b\n            return 1\n    except TypeError:\n        raise TypeError(f\"Elements are not comparable: {repr(a)} vs {repr(b)}\")\ndef check_min_heap(array) -> bool:\n    \"\"\"\n    Checks if the given array represents a min-heap.\n    Raises ValueError for invalid input, TypeError for non-comparable elements.\n    \"\"\"\n    _validate_input(array)\n\n    n = len(array)\n\n    # Empty or single-element arrays are considered valid min-heaps.\n    if n <= 1:\n        return True\n\n    # Iterate through all parent nodes, from index 0 up to floor((n-2)/2).\n    for i in range((n - 2) // 2 + 1):\n        left_child_idx = 2 * i + 1\n        right_child_idx = 2 * i + 2\n\n        # Check left child if it exists.\n        if left_child_idx < n:\n            # If parent is greater than its left child, it's not a min-heap.\n            if _compare(array[i], array[left_child_idx]) > 0:\n                return False\n\n        # Check right child if it exists.\n        if right_child_idx < n:\n            # If parent is greater than its right child, it's not a min-heap.\n            if _compare(array[i], array[right_child_idx]) > 0:\n                return False\n\n    # If all parent-child conditions are satisfied, it is a min-heap.\n    return True"}
{"task_id": "Mbpp/752", "solution": "def jacobsthal_num(n):\n    \"\"\"\n    Calculates the nth Jacobsthal number using an iterative approach.\n    It follows the recurrence J(n) = J(n-1) + 2*J(n-2) with J(0)=0 and J(1)=1.\n    \"\"\"\n    if n == 0:\n        return 0\n    elif n == 1:\n        return 1\n    \n    j_n_minus_2 = 0  # Represents J(0)\n    j_n_minus_1 = 1  # Represents J(1)\n    \n    for _ in range(2, n + 1):\n        current_j = j_n_minus_1 + 2 * j_n_minus_2\n        j_n_minus_2 = j_n_minus_1\n        j_n_minus_1 = current_j\n        \n    return j_n_minus_1"}
{"task_id": "Mbpp/753", "solution": "import heapq\nfrom typing import List, Tuple, Union, Any\nclass Record:\n    \"\"\"Represents an input item with its name, value, and original index for stable sorting.\"\"\"\n    def __init__(self, name: str, value: Union[int, float], original_index: int):\n        self.name = name\n        self.value = value\n        self.original_index = original_index\nclass Validator:\n    \"\"\"Validates the input records list and k value.\"\"\"\n    def validateRecords(self, records: Any) -> bool:\n        \"\"\"Raises TypeError if records is not a list of 2-element tuples (str, numeric).\"\"\"\n        if not isinstance(records, list):\n            raise TypeError(\"Records must be a list.\")\n        for i, record in enumerate(records):\n            if not isinstance(record, tuple) or len(record) != 2:\n                raise TypeError(f\"Record at index {i} must be a 2-element tuple.\")\n            if not isinstance(record[0], str):\n                raise TypeError(f\"First element of record at index {i} must be a string.\")\n            if not isinstance(record[1], (int, float)):\n                raise TypeError(f\"Second element of record at index {i} must be numeric (int or float).\")\n        return True\n\n    def validateK(self, k: Any) -> bool:\n        \"\"\"Raises TypeError if k is not an integer.\"\"\"\n        if not isinstance(k, int):\n            raise TypeError(\"k must be an integer.\")\n        return True\nclass Selector:\n    \"\"\"Selects the 'm' records with the smallest numeric values.\"\"\"\n    def selectSmallest(self, records: List[Tuple[str, Union[int, float]]], m: int) -> List[Record]:\n        \"\"\"Returns up to m Record instances chosen by smallest numeric value, preserving original input order for ties.\"\"\"\n        if m <= 0:\n            return []\n\n        # Create Record objects with original_index for stable sorting\n        annotated_records = []\n        for i, (name, value) in enumerate(records):\n            annotated_records.append(Record(name, value, i))\n        \n        # Use heapq.nsmallest for efficient selection, key ensures stability for ties.\n        selected_records = heapq.nsmallest(m, annotated_records, key=lambda r: (r.value, r.original_index))\n        return selected_records\nclass Sorter:\n    \"\"\"Sorts a list of Record objects by their numeric value in ascending order.\"\"\"\n    def sortAscending(self, records: List[Record]) -> List[Record]:\n        \"\"\"Returns records sorted by numeric value ascending, preserving original relative order for equal values.\"\"\"\n        # Python's sorted() is stable, preserving original_index order for ties.\n        return sorted(records, key=lambda r: r.value)\nclass MinKFunction:\n    \"\"\"Orchestrates the selection and sorting of minimum k records.\"\"\"\n    def __init__(self, records: List[Tuple[str, Union[int, float]]], k: int):\n        self.records = records\n        self.k = k\n        self.validator = Validator()\n        self.selector = Selector()\n        self.sorter = Sorter()\n\n    def execute(self) -> List[Tuple[str, Union[int, float]]]:\n        \"\"\"Executes the validation, selection, and sorting logic to find minimum k records.\"\"\"\n        self.validator.validateRecords(self.records)\n        self.validator.validateK(self.k)\n\n        if self.k <= 0:\n            return []\n\n        n = len(self.records)\n        m = min(self.k, n)\n\n        selected = self.selector.selectSmallest(self.records, m)\n        sorted_selected = self.sorter.sortAscending(selected)\n        \n        # Format the result back into a list of 2-element tuples\n        result_items = [(r.name, r.value) for r in sorted_selected]\n        return result_items\ndef min_k(records: List[Tuple[str, Union[int, float]]], k: int) -> List[Tuple[str, Union[int, float]]]:\n    \"\"\"\n    Finds minimum k records from a list of 2-element tuples, sorted by their numeric value.\n    Ties in numeric values preserve the original relative order.\n    \"\"\"\n    processor = MinKFunction(records, k)\n    return processor.execute()"}
{"task_id": "Mbpp/757", "solution": "from typing import List, Iterator, Dict\nfrom collections import defaultdict\nclass StringItem:\n    \"\"\"Represents a single input string value and its list index.\"\"\"\n    def __init__(self, value: str, index: int) -> None:\n        if not isinstance(value, str):\n            raise TypeError(\"StringItem value must be a string.\")\n        if not isinstance(index, int):\n            raise TypeError(\"StringItem index must be an integer.\")\n        self.value = value\n        self.index = index\nclass StringList:\n    \"\"\"Represents the ordered collection of StringItem domain objects.\"\"\"\n    def __init__(self, elements: List[StringItem]) -> None:\n        self.elements = elements\n\n    @staticmethod\n    def from_list(list_of_strings: List[str]) -> 'StringList':\n        \"\"\"Factory to create a StringList from a raw list of strings.\"\"\"\n        if not isinstance(list_of_strings, list):\n            raise TypeError(\"Input to from_list must be a list.\")\n        \n        elements: List[StringItem] = []\n        for i, s in enumerate(list_of_strings):\n            if not isinstance(s, str):\n                raise TypeError(f\"List element at index {i} is not a string: {type(s)}\")\n            elements.append(StringItem(s, i))\n        return StringList(elements)\n\n    def __len__(self) -> int:\n        return len(self.elements)\n\n    def __iter__(self) -> Iterator[StringItem]:\n        return iter(self.elements)\nclass ReversePairCounter:\n    \"\"\"Encapsulates counting logic and validation operating on a StringList.\"\"\"\n    def countReversePairs(self, string_list: StringList) -> int:\n        \"\"\"Counts reverse string pairs in a StringList, returning the total count.\"\"\"\n        if not isinstance(string_list, StringList):\n            raise TypeError(\"Input to countReversePairs must be a StringList instance.\")\n        \n        value_to_indices: Dict[str, List[int]] = defaultdict(list)\n        for item in string_list.elements:\n            value_to_indices[item.value].append(item.index)\n\n        count = 0\n        for item_i in string_list.elements:\n            reversed_value = item_i.value[::-1]\n            \n            if reversed_value in value_to_indices:\n                for index_j in value_to_indices[reversed_value]:\n                    if index_j < item_i.index:\n                        count += 1\n        return count\ndef count_reverse_pairs(list_of_strings: List[str]) -> int:\n    \"\"\"Counts pairs of reverse strings in the given list.\"\"\"\n    # The design specifies raising TypeError for non-list or lists with non-string entries.\n    \n    string_list = StringList.from_list(list_of_strings)\n    \n    counter = ReversePairCounter()\n    return counter.countReversePairs(string_list)"}
{"task_id": "Mbpp/755", "solution": "def second_smallest(values: list) -> float | int:\n    \"\"\"Compute and return the second smallest numeric value from 'values', interpreted as the second element in sorted order (duplicates allowed).\n    Preconditions: 'values' is a list of numeric types (int or float) and len(values) >= 2.\n    \"\"\"\n    smallest = float('inf')\n    second = float('inf')\n\n    for v in values:\n        if v <= smallest:\n            second = smallest\n            smallest = v\n        elif v < second:\n            second = v\n            \n    return second"}
{"task_id": "Mbpp/754", "solution": "import typing\ndef extract_index_list(l1: typing.List[typing.Any], l2: typing.List[typing.Any], l3: typing.List[typing.Any]) -> typing.List[typing.Any]:\n    \"\"\"\n    Finds elements that appear at the same index in all three input lists.\n    Returns a list of these common elements, preserving their original order.\n    \"\"\"\n    common_elements = []\n    min_length = min(len(l1), len(l2), len(l3))\n\n    for i in range(min_length):\n        if l1[i] == l2[i] and l2[i] == l3[i]:\n            common_elements.append(l1[i])\n            \n    return common_elements"}
{"task_id": "Mbpp/760", "solution": "def unique_Element(numbers: list) -> bool:\n    \"\"\"Return True iff 'numbers' contains only one distinct element.\n\n    Parameters:\n      numbers: list -- a Python list containing numeric values (ints/floats).\n\n    Returns:\n      bool -- True if the list has only one distinct element; False otherwise.\n    \"\"\"\n    if not numbers:\n        return True\n    return len(set(numbers)) == 1"}
{"task_id": "Mbpp/759", "solution": "import re\nclass DecimalPattern:\n    \"\"\"Encapsulates the regex pattern for a 2-precision decimal number.\"\"\"\n    # Class-level attribute for the regex string, as specified in the design\n    regex = r\"^[0-9]+\\.[0-9]{2}$\"\n    # Class-level attribute for the compiled pattern cache\n    _compiled_pattern = None\n\n    def __init__(self):\n        # Compile the regex pattern only once for efficiency across all instances\n        if DecimalPattern._compiled_pattern is None:\n            DecimalPattern._compiled_pattern = re.compile(DecimalPattern.regex)\n\n    def match(self, value: str) -> bool:\n        \"\"\"Checks if the given string fully matches the decimal pattern.\"\"\"\n        # Use fullmatch to ensure the entire string matches the pattern\n        return DecimalPattern._compiled_pattern.fullmatch(value) is not None\ndef is_decimal(input: str) -> bool:\n    \"\"\"\n    Checks if a given string is a decimal number with a precision of 2.\n    Returns True if the input fully matches the pattern '^[0-9]+\\.[0-9]{2}$', False otherwise.\n    \"\"\"\n    if input is None:\n        return False\n    \n    # The design specifies using a DecimalPattern instance for matching.\n    # Instantiate DecimalPattern; it internally ensures the regex is compiled only once.\n    pattern_checker = DecimalPattern()\n    return pattern_checker.match(input)"}
{"task_id": "Mbpp/762", "solution": "from month_checker import MonthChecker\ndef check_monthnumber_number(monthNumber: int) -> bool:\n    \"\"\"Checks if the given month number has 30 days by delegating to MonthChecker.\"\"\"\n    checker = MonthChecker()\n    return checker.check_monthnumber_number(monthNumber)"}
{"task_id": "Mbpp/758", "solution": "from typing import Any, List, Tuple, Dict\ndef unique_sublists(list_of_lists: List[List[Any]]) -> Dict[Tuple[Any, ...], int]:\n    \"\"\"Counts sublists, converting them to tuples as keys, and returns a dictionary of counts.\n    Example: unique_sublists([[1,3],[5,7],[1,3],[13,15,17],[5,7],[9,11]]) == {(1,3):2, (5,7):2, (13,15,17):1, (9,11):1}\n    \"\"\"\n    counts: Dict[Tuple[Any, ...], int] = {}\n    for sublist in list_of_lists:\n        tuple_key = tuple(sublist)\n        counts[tuple_key] = counts.get(tuple_key, 0) + 1\n    return counts"}
{"task_id": "Mbpp/764", "solution": "def number_ctr(s):\n    \"\"\"\n    Count ASCII digit characters in s.\n\n    Returns:\n      int: number of characters in s that are in '0'..'9'.\n    \"\"\"\n    count = 0\n    for char in s:\n        if '0' <= char <= '9':\n            count += 1\n    return count"}
{"task_id": "Mbpp/763", "solution": "def find_min_diff(arr, n):\n    \"\"\"\n    Finds the minimum difference between any two elements in a given array after validating inputs.\n    It sorts the array and then iterates through adjacent elements to find the minimum difference.\n    \"\"\"\n    def _validate_inputs(arr, n):\n        \"\"\"\n        Validates the input array and its size 'n' based on specified preconditions.\n        Raises ValueError for invalid inputs with specific messages.\n        \"\"\"\n        if not isinstance(n, int):\n            raise ValueError(\"n must be int\")\n        if not hasattr(arr, '__iter__'):\n            raise ValueError(\"arr must be an iterable\")\n        if len(arr) < 2:\n            raise ValueError(\"arr must contain at least two elements\")\n        if n != len(arr):\n            raise ValueError(\"n must equal len(arr)\")\n\n    def _compute_min_diff_from_sorted(sorted_arr):\n        \"\"\"\n        Computes the minimum absolute difference between adjacent elements in a sorted array.\n        Returns 0 if duplicates are present.\n        \"\"\"\n        min_diff = float('inf')\n        for i in range(len(sorted_arr) - 1):\n            current_diff = abs(sorted_arr[i+1] - sorted_arr[i])\n            if current_diff < min_diff:\n                min_diff = current_diff\n            if min_diff == 0: # Optimization: if a duplicate is found, 0 is the minimum possible difference\n                return 0\n        return min_diff\n\n    _validate_inputs(arr, n)\n    sorted_arr = sorted(arr)\n    return _compute_min_diff_from_sorted(sorted_arr)"}
{"task_id": "Mbpp/766", "solution": "from typing import Any, List, Tuple\ndef pair_wise(input_list: List[Any]) -> List[Tuple[Any, Any]]:\n    \"\"\"\n    Returns a list of all pairs of consecutive items in the given list.\n    Each pair is a 2-tuple (input_list[i], input_list[i+1]).\n    \"\"\"\n    validate_input(input_list)\n\n    if len(input_list) < 2:\n        return []\n\n    return [(input_list[i], input_list[i+1]) for i in range(len(input_list) - 1)]"}
{"task_id": "Mbpp/767", "solution": "def get_pairs_count(numbers, target):\n    \"\"\"\n    Count unordered index-pairs (i, j) with i < j where numbers[i] + numbers[j] == target.\n    Duplicates at different indices are distinct.\n    \"\"\"\n    count = 0\n    n = len(numbers)\n    for i in range(n - 1):\n        for j in range(i + 1, n):\n            if numbers[i] + numbers[j] == target:\n                count += 1\n    return count"}
{"task_id": "Mbpp/765", "solution": "from .validator import InputValidator\nfrom .calculator import PoliteNumberCalculator\ndef is_polite(n: int) -> int:\n    \"\"\"\n    Finds the nth polite number.\n    A polite number can be expressed as a sum of two or more consecutive positive integers.\n    \"\"\"\n    validator = InputValidator()\n    validator.validate(n)\n\n    calculator = PoliteNumberCalculator()\n    return calculator.nth_polite(n)"}
{"task_id": "Mbpp/769", "solution": "def _element_in_list_by_equality(elem, lst):\n    \"\"\"Checks if an element is present in a list using equality comparison.\"\"\"\n    for item in lst:\n        if elem == item:\n            return True\n    return False\ndef _apply_result_ordering_policy(filtered_with_indices):\n    \"\"\"Applies a deterministic ordering based on original list1 index parity to filtered elements.\"\"\"\n    even_indexed_elements = []\n    odd_indexed_elements = []\n    for element, original_index in filtered_with_indices:\n        if original_index % 2 == 0:\n            even_indexed_elements.append(element)\n        else:\n            odd_indexed_elements.append(element)\n    return even_indexed_elements + odd_indexed_elements\ndef Diff(list1, list2):\n    \"\"\"\n    Returns a list containing elements from list1 that are not present in list2.\n    Elements are ordered by original index parity: even-indexed elements first, then odd-indexed, preserving relative order.\n    \"\"\"\n    _validate_inputs_are_lists(list1, list2)\n    \n    filtered_with_indices = []\n    for index, element in enumerate(list1):\n        if not _element_in_list_by_equality(element, list2):\n            filtered_with_indices.append((element, index))\n            \n    return _apply_result_ordering_policy(filtered_with_indices)"}
{"task_id": "Mbpp/771", "solution": "class Stack:\n    \"\"\"A simple LIFO stack implementation.\"\"\"\n    def __init__(self) -> None:\n        self._items = []\n\n    def push(self, item) -> None:\n        \"\"\"Adds an item to the top of the stack.\"\"\"\n        self._items.append(item)\n\n    def pop(self):\n        \"\"\"Removes and returns the item from the top of the stack.\"\"\"\n        if not self.is_empty():\n            return self._items.pop()\n        return None\n\n    def peek(self):\n        \"\"\"Returns the item at the top of the stack without removing it.\"\"\"\n        if not self.is_empty():\n            return self._items[-1]\n        return None\n\n    def is_empty(self) -> bool:\n        \"\"\"Checks if the stack is empty.\"\"\"\n        return len(self._items) == 0\nclass Bracket:\n    \"\"\"Represents a bracket character and its matching behavior.\"\"\"\n    OPENING_BRACKETS = {'(', '[', '{'}\n    CLOSING_BRACKETS = {')', ']', '}'}\n    MATCHING_PAIRS = {')': '(', ']': '[', '}': '{'}\n    BRACKET_KIND_MAP = {\n        '(': 'paren', ')': 'paren',\n        '[': 'square', ']': 'square',\n        '{': 'curly', '}': 'curly'\n    }\n\n    def __init__(self, symbol: str) -> None:\n        self.symbol = symbol\n        self.bracket_kind = self.BRACKET_KIND_MAP.get(symbol, 'unknown')\n\n    def matches(self, other: 'Bracket') -> bool:\n        \"\"\"Checks if this (opening) bracket matches the other (closing) bracket.\"\"\"\n        return (self.symbol in self.OPENING_BRACKETS and\n                other.symbol in self.CLOSING_BRACKETS and\n                self.symbol == self.MATCHING_PAIRS.get(other.symbol))\ndef check_expression(expression: str) -> bool:\n    \"\"\"\n    Checks if the given expression has balanced and properly nested bracket characters.\n    It considers '()', '[]', and '{}' for validation, ignoring other characters.\n    \"\"\"\n    stack = Stack()\n    \n    for char in expression:\n        if char in Bracket.OPENING_BRACKETS:\n            stack.push(char)\n        elif char in Bracket.CLOSING_BRACKETS:\n            if stack.is_empty():\n                return False\n            \n            top_char_from_stack = stack.pop()\n            \n            open_bracket = Bracket(top_char_from_stack)\n            close_bracket = Bracket(char)\n            \n            if not open_bracket.matches(close_bracket):\n                return False\n        # Non-bracket characters are ignored as per design notes.\n    \n    return stack.is_empty()"}
{"task_id": "Mbpp/770", "solution": "class InputValidator:\n    def validate(self, n) -> bool:\n        if not isinstance(n, int) or n < 0:\n            raise ValueError(\"n must be a non-negative integer\")\n        return True\nclass OddNumber:\n    @staticmethod\n    def get(k: int) -> int:\n        return 2 * k - 1\nclass SumCalculator:\n    def compute_sum(self, n: int) -> int:\n        total = 0\n        for k in range(1, n + 1):\n            a_k = OddNumber.get(k)\n            total += a_k ** 4\n        return total\ndef odd_num_sum(n: int) -> int:\n    validator = InputValidator()\n    validator.validate(n)  # raises ValueError if invalid\n    if n == 0:\n        return 0\n    calculator = SumCalculator()\n    return calculator.compute_sum(n)"}
{"task_id": "Mbpp/773", "solution": "from typing import Optional, Tuple\ndef occurance_substring(text: str, substring: str) -> Optional[Tuple[str, int, int]]:\n    \"\"\"\n    Find the first occurrence of substring in text.\n    Returns (match, start_index, end_index) or None if not found.\n    \"\"\"\n    start_index = text.find(substring)\n\n    if start_index != -1:\n        end_index = start_index + len(substring)\n        return (substring, start_index, end_index)\n    else:\n        return None"}
{"task_id": "Mbpp/772", "solution": "from typing import List\nimport re\nclass Word:\n    \"\"\"Represents a single word token.\"\"\"\n    def __init__(self, text: str):\n        self.text = text\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the word.\"\"\"\n        return len(self.text)\nclass Tokenizer:\n    \"\"\"Tokenizes an input string into Word objects using one-or-more ASCII spaces as delimiters.\"\"\"\n    def tokenize(self, s: str) -> List[Word]:\n        if not s:\n            return []\n        # Split by one or more ASCII spaces, then filter out any empty strings that result from leading/trailing/multiple spaces.\n        raw_tokens = re.split(r' +', s)\n        words = [Word(token) for token in raw_tokens if token]\n        return words\nclass FilterService:\n    \"\"\"Filters a list of Word objects, removing those with a specific length.\"\"\"\n    def filterByLength(self, words: List[Word], k: int) -> List[Word]:\n        \"\"\"Removes words whose length equals k, preserving the order of remaining words.\"\"\"\n        return [word for word in words if word.length() != k]\nclass Joiner:\n    \"\"\"Joins Word objects into a single space-separated string.\"\"\"\n    def join(self, words: List[Word]) -> str:\n        \"\"\"Concatenates the text of Word objects with single spaces, ensuring no leading/trailing spaces.\"\"\"\n        return ' '.join([word.text for word in words])\nclass RemoveLengthFunction:\n    \"\"\"Orchestrates the tokenization, filtering, and joining process.\"\"\"\n    def __init__(self):\n        self._tokenizer = Tokenizer()\n        self._filter_service = FilterService()\n        self._joiner = Joiner()\n\n    def remove_length(self, s: str, k: int) -> str:\n        \"\"\"Performs the full operation of removing words of a specific length from a string.\"\"\"\n        tokens = self._tokenizer.tokenize(s)\n        filtered_tokens = self._filter_service.filterByLength(tokens, k)\n        result = self._joiner.join(filtered_tokens)\n        return result\ndef remove_length(s: str, k: int) -> str:\n    \"\"\"Removes all words of k length in the given string.\"\"\"\n    orchestrator = RemoveLengthFunction()\n    return orchestrator.remove_length(s, k)"}
{"task_id": "Mbpp/775", "solution": "def odd_position(lst):\n    \"\"\"Return True iff every element at odd indices (1,3,5,...) of lst is an odd integer.\n    For odd-indexed elements, the implementation checks whether the element is an instance of int and value % 2 != 0.\n    \"\"\"\n    for i, value in enumerate(lst):\n        if i % 2 == 1:  # Check only odd indices\n            if not (isinstance(value, int) and value % 2 != 0):\n                return False\n    return True"}
