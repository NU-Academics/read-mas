{"task_id": "Mbpp/286", "solution": "def max_sub_array_sum_repeated(arr, n, k):\n    \"\"\"\n    Finds the largest sum of a contiguous array in the modified array formed by repeating the given array k times.\n    \"\"\"\n\n    # If k is 0, no array is formed, so the maximum sum is 0.\n    if k == 0:\n        return 0\n\n    # Helper function to find the maximum sum of a contiguous subarray using Kadane's algorithm.\n    def _kadane(current_arr):\n        if not current_arr:\n            return 0\n        max_so_far = current_arr[0]\n        current_max = current_arr[0]\n        for x in current_arr[1:]:\n            current_max = max(x, current_max + x)\n            max_so_far = max(max_so_far, current_max)\n        return max_so_far\n\n    # Helper function to find the maximum prefix sum of an array.\n    def _max_prefix(current_arr):\n        if not current_arr:\n            return 0\n        current_sum = 0\n        max_prefix_sum = -float('inf')\n        for x in current_arr:\n            current_sum += x\n            max_prefix_sum = max(max_prefix_sum, current_sum)\n        return max_prefix_sum\n\n    # Helper function to find the maximum suffix sum of an array.\n    def _max_suffix(current_arr):\n        if not current_arr:\n            return 0\n        current_sum = 0\n        max_suffix_sum = -float('inf')\n        for x in reversed(current_arr):\n            current_sum += x\n            max_suffix_sum = max(max_suffix_sum, current_sum)\n        return max_suffix_sum\n\n    # If the array is repeated only once, simply apply Kadane's algorithm.\n    if k == 1:\n        return _kadane(arr)\n\n    # For k >= 2, consider the maximum sum within a single array,\n    # and potential cross-boundary sums using prefixes, suffixes, and total sum.\n    single_kadane = _kadane(arr)\n    max_prefix = _max_prefix(arr)\n    max_suffix = _max_suffix(arr)\n    total_sum = sum(arr)\n\n    # Initialize a candidate sum for segments that cross the boundary of the original array.\n    # This considers the case of two repetitions (max suffix of first + max prefix of second).\n    candidate_cross = max_suffix + max_prefix\n\n    # If the total sum of the array is positive and k is greater than 2,\n    # the intermediate (k-2) full repetitions will contribute to a larger sum.\n    if total_sum > 0 and k > 2:\n        candidate_cross += (k - 2) * total_sum\n\n    # The final result is the maximum of the sum entirely within one original array\n    # and the best sum that potentially spans across multiple repetitions.\n    return max(single_kadane, candidate_cross)"}
{"task_id": "Mbpp/293", "solution": "import math\nfrom typing import Union\ndef otherside_rightangle(a: Union[int, float], b: Union[int, float]) -> float:\n    \"\"\"Compute the hypotenuse of a right-angled triangle with legs a and b.\n\n    Returns: sqrt(a*a + b*b) computed using Python float (IEEE 754 double-precision).\n    \"\"\"\n    val = math.sqrt(float(a) * float(a) + float(b) * float(b))\n    return val"}
{"task_id": "Mbpp/294", "solution": "from typing import Any, Optional, Union\ndef _is_numeric(value: Any) -> bool:\n    \"\"\"Return True if value is int or float (bool excluded).\"\"\"\n    return isinstance(value, (int, float)) and not isinstance(value, bool)\ndef max_val(input_list: list) -> Optional[Union[int, float]]:\n    \"\"\"Return the maximum numeric value (int or float) from input_list or None if no numeric elements are found.\n    This function processes heterogeneous lists and ignores non-numeric elements.\n    \"\"\"\n    current_max: Optional[Union[int, float]] = None\n\n    for element in input_list:\n        if _is_numeric(element):\n            if current_max is None:\n                current_max = element\n            else:\n                if element > current_max:\n                    current_max = element\n    return current_max"}
{"task_id": "Mbpp/296", "solution": "class InversionCounter:\n    def get_Inv_Count(self, arr: list[int]) -> int:\n        \"\"\"Return total inversion count (0 for empty or single-element lists).\"\"\"\n        if len(arr) < 2:\n            return 0\n        _, count = self.countUsingMergeSort(arr)\n        return count\n\n    def countUsingMergeSort(self, arr: list[int]) -> tuple[list[int], int]:\n        \"\"\"Return (sorted_arr, inversion_count) using merge sort counting (strict > comparisons only).\"\"\"\n        n = len(arr)\n        if n <= 1:\n            return arr, 0\n\n        mid = n // 2\n        left_arr, left_inv = self.countUsingMergeSort(arr[:mid])\n        right_arr, right_inv = self.countUsingMergeSort(arr[mid:])\n\n        merged_arr = []\n        inversions = left_inv + right_inv\n        i, j = 0, 0\n        len_left = len(left_arr)\n        len_right = len(right_arr)\n\n        while i < len_left and j < len_right:\n            if left_arr[i] <= right_arr[j]:\n                merged_arr.append(left_arr[i])\n                i += 1\n            else:\n                merged_arr.append(right_arr[j])\n                inversions += (len_left - i)\n                j += 1\n        \n        merged_arr.extend(left_arr[i:])\n        merged_arr.extend(right_arr[j:])\n\n        return merged_arr, inversions\ndef get_Inv_Count(arr: list[int]) -> int:\n    \"\"\"Public API per FR1/BR1: returns inversion count as int\"\"\"\n    if len(arr) < 2:\n        return 0\n    \n    counter = InversionCounter()\n    return counter.get_Inv_Count(arr)"}
{"task_id": "Mbpp/297", "solution": "def flatten_list(input_list: list) -> list:\n    \"\"\"\n    Public API: flatten nested lists into a new Python list.\n    Returns a new list, does not mutate input_list.\n    \"\"\"\n    def _iter_flatten(item):\n        \"\"\"Private generator: yields atomic elements from item recursively.\"\"\"\n        if isinstance(item, list):\n            for sub_item in item:\n                yield from _iter_flatten(sub_item)\n        else:\n            yield item\n\n    return list(_iter_flatten(input_list))"}
{"task_id": "Mbpp/299", "solution": "from dataclasses import dataclass\nfrom typing import List, Tuple, Dict, Union\nclass Aggregator:\n    \"\"\"Handles aggregation of scores and selection of the maximum.\"\"\"\n\n    def aggregate(self, entries: List[Tuple[str, Union[int, float]]]) -> Dict[str, float]:\n        \"\"\"\n        Groups scores by name from input tuples, summing them.\n        Validates input types, raising TypeError for invalid elements.\n        \"\"\"\n        aggregated_scores: Dict[str, float] = {}\n\n        for i, entry_tuple in enumerate(entries):\n            if not isinstance(entry_tuple, tuple) or len(entry_tuple) != 2:\n                raise TypeError(f\"Entry at index {i} must be a (name, score) tuple.\")\n\n            name, score = entry_tuple\n\n            if not isinstance(name, str):\n                raise TypeError(f\"Name in entry at index {i} must be a string, got {type(name).__name__}.\")\n            if not isinstance(score, (int, float)):\n                raise TypeError(f\"Score in entry at index {i} must be an int or float, got {type(score).__name__}.\")\n\n            aggregated_scores[name] = aggregated_scores.get(name, 0.0) + float(score)\n        \n        return aggregated_scores\n\n    def max_aggregate(self, entries: List[Tuple[str, Union[int, float]]]) -> Tuple[str, Union[int, float]]:\n        \"\"\"\n        Calculates the maximum aggregate score from a list of (name, score) tuples.\n        Returns the name and its total score, with tie-breaking based on first appearance.\n        \"\"\"\n        if not entries:\n            raise ValueError(\"entries must be a non-empty list of (name, score) tuples\")\n\n        aggregated_scores = self.aggregate(entries)\n\n        max_name: str = \"\"\n        max_score: float = -float('inf')\n\n        # Iterate through the aggregated_scores.items() to leverage dictionary's\n        # key insertion order for tie-breaking (first-encountered name wins).\n        for name, total_score in aggregated_scores.items():\n            if total_score > max_score:\n                max_score = total_score\n                max_name = name\n            # No explicit tie-breaking needed here, as iterating dict.items()\n            # preserves the order of key insertion, so the first one found\n            # with the maximum value will already be assigned.\n\n        # Preserve numeric type if the maximum score is an integer.\n        if max_score.is_integer():\n            return (max_name, int(max_score))\n        else:\n            return (max_name, max_score)\ndef max_aggregate(entries: List[Tuple[str, Union[int, float]]]) -> Tuple[str, Union[int, float]]:\n    \"\"\"\n    Calculates the maximum aggregate score from a list of (name, score) tuples.\n    It groups scores by name, sums them up, and returns the name with the highest total score.\n    \"\"\"\n    return Aggregator().max_aggregate(entries)"}
{"task_id": "Mbpp/300", "solution": "import math\ndef count_binary_seq(n: int) -> float:\n    \"\"\"\n    Counts binary sequences of length 2n where the sum of the first n bits\n    is equal to the sum of the last n bits.\n    \"\"\"\n    # The count is given by the central binomial coefficient C(2n, n).\n    # The combinatorial calculation is inlined as per the constraint\n    # \"DO NOT call any helper that is not defined inline in your response\".\n    # Input validation for n (non-negative integer) is omitted as per\n    # \"DO NOT add isinstance() checks or raise exceptions for edge cases\".\n    return float(math.comb(2 * n, n))"}
{"task_id": "Mbpp/305", "solution": "from typing import List, Tuple\nclass Word:\n    \"\"\"Represents a token and exposes starts_with_p detection.\"\"\"\n    def __init__(self, text: str) -> None:\n        self.text = text\n\n    def starts_with_p(self) -> bool:\n        \"\"\"Returns True if the first character of text lowercased is 'p'.\"\"\"\n        if not self.text:\n            return False\n        return self.text[0].lower() == 'p'\nclass StringItem:\n    \"\"\"Represents a single input string and provides splitting behavior.\"\"\"\n    def __init__(self, text: str) -> None:\n        self.text = text\n\n    def split(self) -> List['Word']:\n        \"\"\"Splits text on whitespace and returns Word instances in original order.\"\"\"\n        return [Word(t) for t in self.text.split()]\nclass StartWithPFunction:\n    \"\"\"Encapsulates the scanning/tokenization/matching algorithm.\"\"\"\n    def start(self, input_list: List[str]) -> Tuple[str, str]:\n        \"\"\"Collects the first two words starting with 'p' (case-insensitive).\"\"\"\n        found_words: List[str] = []\n        \n        for item_text in input_list:\n            string_item = StringItem(item_text)\n            words = string_item.split()\n            for word in words:\n                if word.starts_with_p():\n                    found_words.append(word.text)\n                    if len(found_words) == 2:\n                        return (found_words[0], found_words[1])\n        \n        # According to the problem's design and assertion,\n        # it is guaranteed that exactly two matching words will be found.\n        # Thus, the code path to this point should not be reached.\n        # However, to satisfy the `Tuple[str, str]` return type for static analysis,\n        # a placeholder return is provided, though practically unreachable for valid inputs.\n        return (\"\", \"\")\ndef start_withp(input_list: List[str]) -> Tuple[str, str]:\n    \"\"\"\n    API entrypoint. Returns two words from a list of words starting with letter 'p'.\n    \"\"\"\n    function_instance = StartWithPFunction()\n    return function_instance.start(input_list)"}
{"task_id": "Mbpp/301", "solution": "def dict_depth(d: dict) -> int:\n    \"\"\"Calculates the maximum depth of nested dictionaries.\n    Depth is 1 + the maximum depth of any dictionary-valued item.\"\"\"\n    max_depth = 0\n    for value in d.values():\n        if isinstance(value, dict):\n            max_depth = max(max_depth, dict_depth(value))\n    return 1 + max_depth"}
{"task_id": "Mbpp/306", "solution": "class ValidationError(Exception):\n    \"\"\"Exception raised for invalid inputs.\"\"\"\n    def __init__(self, message: str, code: int = 1) -> None:\n        self.message = message\n        self.code = code\n        super().__init__(self.message)\nclass Validator:\n    \"\"\"Validates input parameters for the max_sum_increasing_subseq function.\"\"\"\n    def validate(self, arr: list[int], n: int, i: int, k: int) -> None:\n        \"\"\"\n        Validates the input array and indices.\n        Raises ValidationError if any validation rule is violated.\n        \"\"\"\n        if n != len(arr):\n            raise ValidationError(\"Input 'n' must be equal to the length of 'arr'.\")\n        if not (0 <= i < n):\n            raise ValidationError(f\"Index 'i' ({i}) is out of bounds [0, {n-1}].\")\n        if not (0 <= k < n):\n            raise ValidationError(f\"Index 'k' ({k}) is out of bounds [0, {n-1}].\")\n        if k <= i:\n            raise ValidationError(f\"Index 'k' ({k}) must be strictly greater than 'i' ({i}).\")\nclass MaxSumCalculator:\n    \"\"\"Calculates the maximum sum of an increasing subsequence ending at or including arr[k].\"\"\"\n    def compute(self, arr: list[int], n: int, i: int, k: int) -> int:\n        \"\"\"\n        Computes the maximum sum of a strictly increasing subsequence that includes arr[k],\n        with predecessors taken from indices 0..i and strictly less than k.\n        \"\"\"\n        # dp[j] will store the maximum sum of an increasing subsequence ending at arr[j],\n        # considering elements up to index j.\n        dp = [0] * (i + 1)\n\n        # Initialize dp array and compute MSIS for prefixes up to index i\n        for j in range(i + 1):\n            dp[j] = arr[j] # Subsequence with just arr[j]\n            for t in range(j):\n                if arr[t] < arr[j]:\n                    dp[j] = max(dp[j], arr[j] + dp[t])\n\n        # Find candidate sums that include arr[k]\n        # At minimum, the subsequence can just be arr[k] itself\n        candidate_sums = [arr[k]]\n\n        # Consider predecessors from dp array up to index i, with index j < k and arr[j] < arr[k]\n        for j in range(i + 1):\n            if j < k and arr[j] < arr[k]:\n                candidate_sums.append(dp[j] + arr[k])\n\n        return max(candidate_sums)\ndef max_sum_increasing_subseq(arr: list[int], n: int, i: int, k: int) -> int:\n    \"\"\"\n    Finds the maximum sum of an increasing subsequence that includes arr[k],\n    with predecessors chosen from indices 0 to i (inclusive), where each predecessor's index\n    must be strictly less than k.\n    \"\"\"\n    Validator().validate(arr, n, i, k)\n    return MaxSumCalculator().compute(arr, n, i, k)"}
