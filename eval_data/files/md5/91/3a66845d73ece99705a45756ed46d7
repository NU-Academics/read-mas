{"task_id": "Mbpp/607", "solution": "import re\ndef find_literals(text, pattern):\n    \"\"\"Search text for the first (leftmost) regex match of pattern.\n\n    Args:\n      text: str - input text to search (must be str; TypeError if not)\n      pattern: str - regex pattern string to compile and search (must be str; TypeError if not)\n\n    Returns:\n      tuple (matched_substring: str, start_index: int, end_index: int) if a match is found;\n      None if no match is found.\n\n    Raises:\n      TypeError: if text or pattern are not strings.\n    \"\"\"\n    if not isinstance(text, str) or not isinstance(pattern, str):\n        raise TypeError(\"Input 'text' and 'pattern' must be strings.\")\n\n    match = re.search(pattern, text)\n    if match:\n        start, end = match.span()\n        matched_substring = match.group(0)\n        return (matched_substring, start, end)\n    else:\n        return None"}
{"task_id": "Mbpp/608", "solution": "def _compute_bell(n) -> int:\n    \"\"\"Compute and return nth Bell number as int using the Bell triangle.\n    Called only after _validate_input passes.\"\"\"\n    if n == 0:\n        return 1\n\n    # Initialize a 2D list for the Bell triangle\n    # bell[i][j] stores the j-th element of the i-th row (0-indexed)\n    # The nth Bell number will be bell[n][0]\n    bell = [[0] * (n + 1) for _ in range(n + 1)]\n\n    # Base case for B_0\n    bell[0][0] = 1\n\n    for i in range(1, n + 1):\n        # The first element of the current row is the last element of the previous row\n        bell[i][0] = bell[i-1][i-1]\n        for j in range(1, i + 1):\n            # Each subsequent element is the sum of the element to its left\n            # and the element diagonally above-left\n            bell[i][j] = bell[i][j-1] + bell[i-1][j-1]\n            \n    return bell[n][0]\ndef bell_Number(n) -> int:\n    \"\"\"Validate n (non-negative int) and return nth Bell number as int.\n    Raises ValueError if invalid input is provided.\"\"\"\n    _validate_input(n)\n    return _compute_bell(n)"}
{"task_id": "Mbpp/610", "solution": "from typing import Any, List, TypeAlias\nInputList: TypeAlias = List[Any]\nResultList: TypeAlias = List[Any]\nIndex: TypeAlias = int\ndef remove_kth_element(input_list: InputList, k: Index) -> ResultList:\n    \"\"\"\n    Returns a new list with the k'th (1-based) element removed.\n    Raises TypeError if k is not an int, or IndexError if k is out of bounds.\n    \"\"\"\n    if not isinstance(k, int):\n        raise TypeError(\"k must be an integer.\")\n    if not (1 <= k <= len(input_list)):\n        raise IndexError(\"k is out of bounds for the list.\")\n\n    return input_list[: (k - 1) ] + input_list[k:]"}
{"task_id": "Mbpp/611", "solution": "def max_of_nth(matrix, n):\n    \"\"\"\n    Finds the maximum value in the n'th column of a matrix represented as a list of lists.\n    Validates inputs and raises TypeError or ValueError for invalid data or scenarios.\n    \"\"\"\n    if not isinstance(matrix, list):\n        raise TypeError(\"Matrix must be a list.\")\n    for row in matrix:\n        if not isinstance(row, list):\n            raise TypeError(\"Each row in the matrix must be a list.\")\n\n    if not isinstance(n, int):\n        raise TypeError(\"Column index 'n' must be an integer.\")\n    if n < 0:\n        raise TypeError(\"Column index 'n' must be non-negative.\")\n\n    column_values = []\n    for row in matrix:\n        if len(row) > n:  # BR4: Ignore rows shorter than n+1\n            cell = row[n]\n            if not isinstance(cell, (int, float)):\n                # BR5: Raise TypeError for non-numeric cells in the selected column\n                raise TypeError(f\"Cell value '{cell}' at column {n} must be numeric (int or float).\")\n            column_values.append(cell)\n\n    if not column_values:\n        # BR6: Raise ValueError if no numeric values found after filtering\n        raise ValueError(\"No numeric values found in the requested column after filtering.\")\n\n    return max(column_values)"}
{"task_id": "Mbpp/614", "solution": "def cummulative_sum(list_of_tuples):\n    \"\"\"\n    Calculates the cumulative sum of all numeric values in a list of tuples.\n    Raises TypeError if the input is invalid.\n    \"\"\"\n    _validate_input(list_of_tuples)\n\n    total_sum = 0\n    for tpl in list_of_tuples:\n        for num in tpl:\n            total_sum += num\n    return total_sum"}
{"task_id": "Mbpp/612", "solution": "def merge(input_list):\n    \"\"\"Splits a list of 2-element sublists into two lists.\n    Returns a list containing all first elements and all second elements.\"\"\"\n    \n    if not input_list:\n        return [[], []]\n\n    firsts = []\n    seconds = []\n\n    for sublist in input_list:\n        firsts.append(sublist[0])\n        seconds.append(sublist[1])\n\n    return [firsts, seconds]"}
{"task_id": "Mbpp/616", "solution": "def tuple_modulo(first: tuple, second: tuple) -> tuple:\n    \"\"\"Compute element-wise modulo of two tuples.\n\n    Raises ValueError if input tuples have different lengths.\n    \"\"\"\n    if len(first) != len(second):\n        raise ValueError(\"Input tuples must have the same length\")\n    return tuple(a % b for a, b in zip(first, second))"}
{"task_id": "Mbpp/615", "solution": "def _compute_inner_average(inner_tuple: tuple) -> float:\n    \"\"\"Computes the arithmetic mean of a single inner tuple.\"\"\"\n    return sum(inner_tuple) / len(inner_tuple)\ndef average_tuple(input: tuple) -> list[float]:\n    \"\"\"Calculates the average of each inner tuple in a tuple of tuples, returning a list of floats.\"\"\"\n    averages = []\n    for inner_tuple in input:\n        avg = _compute_inner_average(inner_tuple)\n        averages.append(avg)\n    return averages"}
