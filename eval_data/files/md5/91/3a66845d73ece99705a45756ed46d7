{"task_id": "Mbpp/61", "solution": "from typing import Iterator\nfrom dataclasses import dataclass\nclass SubstringCounter:\n    \"\"\"Encapsulates the algorithm for counting substrings with specific properties.\"\"\"\n\n    def count_Substrings(self, s: str) -> int:\n        \"\"\"Orchestrates counting substrings where the sum of digits equals their length.\"\"\"\n        digit_string = DigitString(value=s)\n        if not digit_string.is_valid_digits():\n            raise ValueError(\"Input string contains non-digit characters.\")\n\n        match_count = 0\n        for sub in self._generate_substrings(s):\n            if sub.digit_sum() == sub.length():\n                match_count += 1\n        return match_count\n\n    def _generate_substrings(self, s: str) -> Iterator[Substring]:\n        \"\"\"Generates all contiguous substrings of the input string.\"\"\"\n        n = len(s)\n        for i in range(n):\n            for j in range(i + 1, n + 1):\n                yield Substring(start=i, end=j, value=s[i:j])\ndef count_Substrings(s: str) -> int:\n    \"\"\"\n    Counts the number of substrings in a given string of digits\n    where the sum of digits in the substring equals its length.\n    \"\"\"\n    if not isinstance(s, str):\n        raise TypeError(\"Input must be a string.\")\n    if not s:\n        return 0\n\n    counter = SubstringCounter()\n    return counter.count_Substrings(s)"}
{"task_id": "Mbpp/57", "solution": "class ValidationError(ValueError):\n    \"\"\"Domain-specific exception for validation failures.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\nclass Digit:\n    \"\"\"Represents a single digit (0-9) with validation.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def is_valid(self) -> bool:\n        \"\"\"Checks if the digit is an integer between 0 and 9 inclusive.\"\"\"\n        return isinstance(self.value, int) and 0 <= self.value <= 9\nclass DigitList:\n    \"\"\"Encapsulates a list of digits, providing validation and sorting capabilities.\"\"\"\n    def __init__(self, digits: list):\n        self._raw_digits = digits\n        self._validated_digits = []\n\n    def validate(self) -> None:\n        \"\"\"Validates the input list: non-empty, list of integers 0-9.\"\"\"\n        if not isinstance(self._raw_digits, list):\n            raise ValidationError(\"Input must be a list.\")\n        if not self._raw_digits:\n            raise ValidationError(\"Input list cannot be empty.\")\n\n        for item in self._raw_digits:\n            digit = Digit(item)\n            if not digit.is_valid():\n                raise ValidationError(f\"All elements must be integers between 0 and 9. Found: {item}\")\n            self._validated_digits.append(digit.value)\n\n    def sort_desc(self) -> list:\n        \"\"\"Returns the list of digit values sorted in descending order.\"\"\"\n        return sorted(self._validated_digits, reverse=True)\n\n    def count(self) -> int:\n        \"\"\"Returns the number of digits in the list.\"\"\"\n        return len(self._validated_digits)\n\n    def values(self) -> list:\n        \"\"\"Returns the underlying list of integer digit values.\"\"\"\n        return list(self._validated_digits)\nclass MaxNumberGenerator:\n    \"\"\"Orchestrates validation, sorting, and concatenation of digits.\"\"\"\n    def find_Max_Num(self, digits: list) -> int:\n        \"\"\"\n        Generates the largest integer from a list of digits.\n        Validates input, sorts digits in descending order, and concatenates them.\n        \"\"\"\n        digit_list = DigitList(digits)\n        digit_list.validate()\n\n        sorted_digits = digit_list.sort_desc()\n        return self._concatenate(sorted_digits)\n\n    def _concatenate(self, sorted_digits: list) -> int:\n        \"\"\"Converts a list of integer digits into a single integer.\"\"\"\n        if not sorted_digits:\n            return 0\n        return int(\"\".join(map(str, sorted_digits)))\ndef find_Max_Num(digits) -> int:\n    \"\"\"\n    Finds the largest number that can be formed with the given list of digits.\n    Delegates to MaxNumberGenerator for validation, sorting, and concatenation.\n    \"\"\"\n    generator = MaxNumberGenerator()\n    return generator.find_Max_Num(digits)"}
