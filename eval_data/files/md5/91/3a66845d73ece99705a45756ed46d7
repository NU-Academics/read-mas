{"task_id": "Mbpp/256", "solution": "import math\ndef count_Primes_nums(n: float) -> int:\n    \"\"\"\n    Counts the number of prime numbers strictly less than the given non-negative number n.\n    Raises ValueError if n is negative.\n    \"\"\"\n\n    def _validate_input(val: float) -> int:\n        \"\"\"\n        Validates the input value and returns the floored integer limit.\n        Raises ValueError if the input is negative.\n        \"\"\"\n        if val < 0:\n            raise ValueError(\"n must be non-negative\")\n        return math.floor(val)\n\n    def _count_primes_sieve(limit: int) -> int:\n        \"\"\"\n        Counts prime numbers strictly less than 'limit' using the Sieve of Eratosthenes.\n        Returns 0 if the limit is 2 or less.\n        \"\"\"\n        if limit <= 2:\n            return 0\n\n        is_prime = [True] * limit\n        is_prime[0] = is_prime[1] = False\n\n        p = 2\n        while (p * p < limit):\n            if is_prime[p]:\n                for i in range(p * p, limit, p):\n                    is_prime[i] = False\n            p += 1\n\n        count = 0\n        for i in range(2, limit):\n            if is_prime[i]:\n                count += 1\n        return count\n\n    def _is_prime(k: int) -> bool:\n        \"\"\"\n        Checks if a given integer k is prime using trial division.\n        This helper is present as per design but not used in the primary flow.\n        \"\"\"\n        if k < 2:\n            return False\n        for i in range(2, int(math.sqrt(k)) + 1):\n            if k % i == 0:\n                return False\n        return True\n\n    validated_limit = _validate_input(n)\n    return _count_primes_sieve(validated_limit)"}
{"task_id": "Mbpp/260", "solution": "def _is_prime(k: int) -> bool:\n    \"\"\"Small deterministic primality test used internally.\"\"\"\n    if k <= 1:\n        return False\n    if k == 2:\n        return True\n    if k % 2 == 0:\n        return False\n    i = 3\n    while i * i <= k:\n        if k % i == 0:\n            return False\n        i += 2\n    return True\nclass NSWSequence:\n    \"\"\"Holds NSW sequence terms and extends to requested index.\"\"\"\n    def __init__(self, initial_terms: list[int] | None = None) -> None:\n        self.terms: list[int]\n        if initial_terms is None:\n            # NSW_0 = 1, NSW_1 = 1 based on the recurrence P_n = 2 * P_{n-1} + P_{n-2}\n            self.terms = [1, 1]\n        else:\n            self.terms = initial_terms\n\n    def extend_to_index(self, n: int) -> None:\n        \"\"\"Ensures 'terms' contains at least n terms using the NSW recurrence.\"\"\"\n        # n is 1-based, meaning we need terms up to 0-based index n-1.\n        # So, the length of terms should be at least n.\n        while len(self.terms) < n:\n            k = len(self.terms)\n            next_term = 2 * self.terms[k-1] + self.terms[k-2]\n            self.terms.append(next_term)\nclass NewmanShanksWilliamsGenerator:\n    \"\"\"Generates NSW sequence, tests primality, and returns the prime.\"\"\"\n    def __init__(self) -> None:\n        self._sequence = NSWSequence()\n\n    def generate_sequence_up_to_index(self, n: int) -> list[int]:\n        \"\"\"Generates and returns NSW terms up to index n (1-based).\"\"\"\n        self._sequence.extend_to_index(n)\n        return self._sequence.terms[:n]\n\n    def newman_prime(self, n: int) -> int:\n        \"\"\"Returns the NSW term at 1-based index n, assuming it is prime.\"\"\"\n        # Based on assert newman_prime(3) == 7, n refers to the 1-based index of the NSW term.\n        # The term at 1-based index n is found at 0-based index n-1 in the terms list.\n        self._sequence.extend_to_index(n)\n        target_term = self._sequence.terms[n-1]\n        # The design dictates happy path, so we assume the target term is prime.\n        # The _is_prime check ensures it fulfills the \"prime number\" requirement.\n        if _is_prime(target_term):\n            return target_term\n        # Per design, no error handling for non-prime cases; assume valid 'n' leads to a prime.\n        return target_term\ndef newman_prime(n: int) -> int:\n    \"\"\"Return the nth Newman\u2013Shanks\u2013Williams prime number (1-based index).\"\"\"\n    generator = NewmanShanksWilliamsGenerator()\n    return generator.newman_prime(n)"}
{"task_id": "Mbpp/262", "solution": "def split_two_parts(list, L):\n    \"\"\"Split the given list into two parts where the length of the first part is L.\n    Returns a tuple (first_part, second_part).\n    \"\"\"\n    first_part = list[:L]\n    second_part = list[L:]\n    return (first_part, second_part)"}
{"task_id": "Mbpp/259", "solution": "class ValidationError(Exception):\n    \"\"\"Base exception for validation errors.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\nclass LengthMismatchError(ValidationError):\n    \"\"\"Raised when input tuples have different lengths.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\nclass InvalidElementTypeError(ValidationError):\n    \"\"\"Raised when an element in a tuple is not a 2-tuple of integers.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\ndef is_valid_pair(obj: object) -> bool:\n    \"\"\"Checks if an object is a tuple of length 2 with both elements as integers.\"\"\"\n    return isinstance(obj, tuple) and len(obj) == 2 and \\\n           isinstance(obj[0], int) and isinstance(obj[1], int)\nclass TupleOfPairs:\n    \"\"\"A thin wrapper for a tuple of 2-tuples, validating on init.\"\"\"\n    def __init__(self, pairs: tuple, name: str = 'input') -> None:\n        if not isinstance(pairs, tuple):\n            raise InvalidElementTypeError(f\"{name} must be a tuple, but got {type(pairs).__name__}\")\n        for i, pair in enumerate(pairs):\n            if not is_valid_pair(pair):\n                raise InvalidElementTypeError(f\"{name} contains invalid element at index {i}: {pair} is not a (int, int) tuple.\")\n        self._pairs = pairs\n\n    def length(self) -> int:\n        \"\"\"Returns the number of pairs in the tuple.\"\"\"\n        return len(self._pairs)\n\n    def get(self, index: int) -> tuple:\n        \"\"\"Returns the pair at the specified index.\"\"\"\n        return self._pairs[index]\ndef validate_tuple_of_pairs(obj: object, name: str) -> TupleOfPairs:\n    \"\"\"Validates an object is a tuple of 2-tuples of ints and returns a TupleOfPairs wrapper.\"\"\"\n    return TupleOfPairs(obj, name)\ndef _compute_pair_max(pair_a: tuple, pair_b: tuple) -> tuple:\n    \"\"\"Computes the element-wise maximum of two 2-tuple pairs.\"\"\"\n    return (max(pair_a[0], pair_b[0]), max(pair_a[1], pair_b[1]))\ndef maximize_elements(a, b):\n    \"\"\"\n    Maximizes elements of two input tuples of 2-tuples.\n\n    Returns a new tuple where each element is the element-wise maximum of the corresponding\n    2-tuples from the input.\n    \"\"\"\n    a_tuples = validate_tuple_of_pairs(a, 'a')\n    b_tuples = validate_tuple_of_pairs(b, 'b')\n\n    if a_tuples.length() != b_tuples.length():\n        raise LengthMismatchError(f\"Input tuple lengths differ: len(a)={a_tuples.length()}, len(b)={b_tuples.length()}\")\n\n    result_pairs = []\n    for i in range(a_tuples.length()):\n        pair_a = a_tuples.get(i)\n        pair_b = b_tuples.get(i)\n        result_pairs.append(_compute_pair_max(pair_a, pair_b))\n\n    return tuple(result_pairs)"}
{"task_id": "Mbpp/261", "solution": "from typing import Tuple, Union\ndef division_elements(tuple1: Tuple[Union[int, float], ...], tuple2: Tuple[Union[int, float], ...]) -> Tuple[Union[int, float], ...]:\n    \"\"\"\n    Performs element-wise division of two tuples.\n    It expects inputs to be tuples of equal length containing numeric elements.\n    \"\"\"\n    results = []\n    for i in range(len(tuple1)):\n        results.append(tuple1[i] / tuple2[i])\n    return tuple(results)"}
{"task_id": "Mbpp/266", "solution": "class Cube:\n    \"\"\"Encapsulates cube dimensions and computes lateral surface area.\"\"\"\n    def __init__(self, side_length: float) -> None:\n        self.side_length = side_length\n        self.lateral_surface_area = 0.0\n\n    def compute_lateral_surface(self) -> float:\n        # lateral_surface_area = 4 * side_length * side_length\n        self.lateral_surface_area = 4 * self.side_length * self.side_length\n        return self.lateral_surface_area\nclass LateralSurfaceCalculator:\n    \"\"\"Provides static methods for calculating lateral surface area of geometric shapes.\"\"\"\n    @staticmethod\n    def lateralsurface_cube(side_length: float) -> float:\n        # Computes lateral surface area using the Cube domain class.\n        cube = Cube(side_length)\n        return cube.compute_lateral_surface()\ndef lateralsurface_cube(side_length: float) -> float:\n    \"\"\"\n    Calculates the lateral surface area of a cube.\n    Delegates the computation to the LateralSurfaceCalculator.\n    \"\"\"\n    return LateralSurfaceCalculator.lateralsurface_cube(side_length)"}
{"task_id": "Mbpp/265", "solution": "def list_split(input_list, n):\n    \"\"\"\n    Splits a list into n sublists, taking every nth element for each sublist.\n    Elements are assigned to sublists based on their original index modulo n.\n    \"\"\"\n    if not isinstance(input_list, list):\n        raise TypeError(\"input_list must be a list\")\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n    if n < 1:\n        raise ValueError(\"n must be greater than or equal to 1\")\n\n    sublists = [[] for _ in range(n)]\n\n    for index, element in enumerate(input_list):\n        sublists[index % n].append(element)\n\n    return sublists"}
{"task_id": "Mbpp/264", "solution": "from src.age_calculator import AgeCalculator\ndef dog_age(human_years) -> int:\n    \"\"\"\n    Calculates a dog's age in dog years based on human years.\n    Validates input type and value before delegating calculation.\n    \"\"\"\n    if not isinstance(human_years, (int, float)):\n        raise TypeError(\"human_years must be a numeric type (int or float).\")\n    if human_years < 0:\n        raise ValueError(\"human_years cannot be negative.\")\n\n    calculator = AgeCalculator()\n    return calculator.calculateDogYears(float(human_years))"}
{"task_id": "Mbpp/267", "solution": "class OddNumber:\n    \"\"\"Lightweight domain class representing a single odd natural number.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def square(self) -> int:\n        \"\"\"Computes the square of the odd number.\"\"\"\n        return self.value * self.value\nclass OddNumberSequence:\n    \"\"\"Domain class that generates the first n odd natural numbers.\"\"\"\n    def generate(self, n: int) -> list[int]:\n        \"\"\"Generates a list of the first n odd natural numbers.\"\"\"\n        if n <= 0:\n            return []\n        sequence = []\n        for k in range(1, n + 1):\n            sequence.append(2 * k - 1)\n        return sequence\ndef square_Sum(n: int) -> int:\n    \"\"\"\n    Computes the sum of the squares of the first n odd natural numbers.\n    Returns 0 for n <= 0.\n    \"\"\"\n    if n <= 0:\n        return 0\n\n    odd_sequence_generator = OddNumberSequence()\n    odd_values = odd_sequence_generator.generate(n)\n\n    total_sum = 0\n    for value in odd_values:\n        odd_num_obj = OddNumber(value)\n        total_sum += odd_num_obj.square()\n    \n    return total_sum"}
