{"task_id": "HumanEval/56", "solution": "class BracketValidator:\n    @staticmethod\n    def correct_bracketing(brackets: str) -> bool:\n        \"\"\"\n        Validate that every opening '<' has a corresponding closing '>'.\n        Returns True if the string is correctly bracketed, False otherwise.\n        \"\"\"\n        stack = 0\n        for ch in brackets:\n            if ch == '<':\n                stack += 1\n            elif ch == '>':\n                if stack == 0:\n                    return False\n                stack -= 1\n        return stack == 0\n\ndef correct_bracketing(brackets: str):\n    \"\"\" brackets is a string of \"<\" and \">\".\n    return True if every opening bracket has a corresponding closing bracket.\n    \"\"\"\n    validator = BracketValidator()\n    return validator.correct_bracketing(brackets)"}
{"task_id": "HumanEval/57", "solution": "def monotonic(l: list):\n    \"\"\"Return True is list elements are monotonically increasing or decreasing.\n    >>> monotonic([1, 2, 4, 20])\n    True\n    >>> monotonic([1, 20, 4, 10])\n    False\n    >>> monotonic([4, 1, 0, -10])\n    True\n    \"\"\"\n    if len(l) <= 1:\n        return True\n\n    # Check if the list is strictly increasing\n    strictly_increasing = True\n    for i in range(1, len(l)):\n        if l[i] <= l[i-1]:\n            strictly_increasing = False\n            break\n\n    # Check if the list is strictly decreasing\n    strictly_decreasing = True\n    for i in range(1, len(l)):\n        if l[i] >= l[i-1]:\n            strictly_decreasing = False\n            break\n\n    return strictly_increasing or strictly_decreasing"}
{"task_id": "HumanEval/59", "solution": "def largest_prime_factor(n: int):\n    \"\"\"Return the largest prime factor of n. Assume n > 1 and is not a prime.\n    >>> largest_prime_factor(13195)\n    29\n    >>> largest_prime_factor(2048)\n    2\n    \"\"\"\n    largest = 1\n    \n    # Remove factors of 2 first\n    while n % 2 == 0:\n        largest = 2\n        n //= 2\n    \n    # Check for odd factors from 3 up to sqrt(n)\n    factor = 3\n    while factor * factor <= n:\n        while n % factor == 0:\n            largest = factor\n            n //= factor\n        factor += 2\n    \n    # If n is still greater than 1, it must be a prime number itself,\n    # and it is the largest prime factor.\n    if n > 1:\n        largest = n\n        \n    return largest"}
