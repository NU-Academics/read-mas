{"task_id": "HumanEval/123", "solution": "def get_odd_collatz(n):\n    \"\"\"\n    Given a positive integer n, return a sorted list that has the odd numbers in collatz sequence.\n    \"\"\"\n    odd_numbers = set()\n    current_n = n\n\n    while current_n != 1:\n        if current_n % 2 != 0:\n            odd_numbers.add(current_n)\n            current_n = 3 * current_n + 1\n        else:\n            current_n = current_n // 2\n    \n    # The number 1 is always part of the sequence and is odd.\n    odd_numbers.add(1)\n\n    return sorted(list(odd_numbers))"}
{"task_id": "HumanEval/122", "solution": "from typing import List\n\ndef add_elements(arr: List[int], k: int):\n    \"\"\"\n    Given a non-empty array of integers arr and an integer k, return\n    the sum of the elements with at most two digits from the first k elements of arr.\n    \"\"\"\n    current_sum = 0\n    # Iterate over the first k elements of the array.\n    for i in range(k):\n        element = arr[i]\n        # Check if the absolute value of the element has at most two digits (i.e., between -99 and 99).\n        if -99 <= element <= 99:\n            current_sum += element\n    return current_sum"}
{"task_id": "HumanEval/124", "solution": "def valid_date(date):\n    \"\"\"Validates a date string against specific rules (format, day/month ranges).\"\"\"\n    # 1. The date string is not empty.\n    if not date:\n        return False\n\n    # 4. The date should be in the format: mm-dd-yyyy\n    parts = date.split('-')\n    if len(parts) != 3:\n        return False\n\n    month_str, day_str, year_str = parts\n\n    # Ensure all parts are digits and have correct lengths\n    if not (month_str.isdigit() and day_str.isdigit() and year_str.isdigit()):\n        return False\n    if not (len(month_str) == 2 and len(day_str) == 2 and len(year_str) == 4):\n        return False\n\n    try:\n        month = int(month_str)\n        day = int(day_str)\n        # year is parsed but not used in validation logic as per rules\n        year = int(year_str)\n    except ValueError:\n        # Should ideally be caught by isdigit() and len() checks, but added for robustness\n        return False\n\n    # 3. The months should not be less than 1 or higher than 12.\n    if not (1 <= month <= 12):\n        return False\n\n    # 2. The number of days validation based on month.\n    months_31_days = {1, 3, 5, 7, 8, 10, 12}\n    months_30_days = {4, 6, 9, 11}\n\n    if month in months_31_days:\n        if not (1 <= day <= 31):\n            return False\n    elif month in months_30_days:\n        if not (1 <= day <= 30):\n            return False\n    elif month == 2: # February\n        # Up to 29 days for February, ignoring leap years as per problem statement.\n        if not (1 <= day <= 29):\n            return False\n    else:\n        # This case should theoretically not be reached due to month validation (rule 3),\n        # but serves as a safeguard for unhandled month values.\n        return False\n\n    # If all checks pass, the date is valid.\n    return True"}
{"task_id": "HumanEval/125", "solution": "import re\n\ndef split_words(txt):\n    '''\n    Given a string of words, return a list of words split on whitespace, if no whitespaces exists in the text you\n    should split on commas ',' if no commas exists you should return the number of lower-case letters with odd order in the\n    alphabet, ord('a') = 0, ord('b') = 1, ... ord('z') = 25\n    '''\n    if re.search(r'\\s', txt):\n        return txt.split()\n    elif ',' in txt:\n        return txt.split(',')\n    else:\n        odd_order_count = 0\n        for char in txt:\n            if 'a' <= char <= 'z':\n                order = ord(char) - ord('a')\n                if order % 2 != 0:\n                    odd_order_count += 1\n        return odd_order_count"}
{"task_id": "HumanEval/126", "solution": "import collections\n\ndef is_sorted(lst):\n    '''\n    Given a list of numbers, return whether or not they are sorted\n    in ascending order. If list has more than 1 duplicate of the same\n    number, return False. Assume no negative numbers and only integers.\n    '''\n    if len(lst) <= 1:\n        return True\n\n    counts = collections.defaultdict(int)\n    for i in range(len(lst)):\n        num = lst[i]\n\n        # Check if the list is sorted in ascending order\n        if i > 0 and num < lst[i-1]:\n            return False\n\n        # Count occurrences and check for more than 1 duplicate\n        counts[num] += 1\n        if counts[num] > 2:\n            return False\n\n    return True"}
{"task_id": "HumanEval/127", "solution": "def intersection(interval1, interval2):\n    \"\"\"Calculates the intersection of two intervals and checks if its length is a prime number.\n    Returns \"YES\" if the length is prime, \"NO\" otherwise or if intervals don't intersect.\n    \"\"\"\n\n    def is_prime(n):\n        \"\"\"Checks if a given number is prime, returning True for primes and False otherwise.\"\"\"\n        if n <= 1:\n            return False\n        if n == 2:\n            return True\n        if n % 2 == 0:\n            return False\n        i = 3\n        while i * i <= n:\n            if n % i == 0:\n                return False\n            i += 2\n        return True\n\n    start1, end1 = interval1\n    start2, end2 = interval2\n\n    start_overlap = max(start1, start2)\n    end_overlap = min(end1, end2)\n\n    if start_overlap > end_overlap:\n        return \"NO\"\n\n    length = end_overlap - start_overlap + 1\n\n    if is_prime(length):\n        return \"YES\"\n    else:\n        return \"NO\""}
{"task_id": "HumanEval/128", "solution": "def prod_signs(arr):\n    \"\"\"\n    Calculates sum of magnitudes of integers multiplied by product of all signs.\n    Returns None for an empty array.\n    \"\"\"\n    if not arr:\n        return None\n\n    sum_magnitudes = 0\n    product_of_signs = 1\n\n    for x in arr:\n        sum_magnitudes += abs(x)\n\n        if x > 0:\n            product_of_signs *= 1\n        elif x < 0:\n            product_of_signs *= -1\n        else: # x == 0\n            product_of_signs = 0\n            # If any number is 0, the product of signs becomes 0 and remains 0.\n            # We can break early here for sign product calculation if magnitudes are not affected.\n            # However, summing magnitudes still requires iterating through the whole array.\n            # So, keeping the loop for all elements is simpler.\n\n    return sum_magnitudes * product_of_signs"}
{"task_id": "HumanEval/131", "solution": "def digits(n):\n    \"\"\"Given a positive integer n, return the product of the odd digits.\n    Return 0 if all digits are even.\n    \"\"\"\n    product_of_odds = 1\n    found_odd_digit = False\n\n    # Convert the integer to a string to iterate through its digits\n    for char_digit in str(n):\n        digit = int(char_digit)\n        if digit % 2 != 0:  # Check if the digit is odd\n            product_of_odds *= digit\n            found_odd_digit = True\n\n    if found_odd_digit:\n        return product_of_odds\n    else:\n        return 0"}
{"task_id": "HumanEval/130", "solution": "from typing import List\n\ndef tri(n):\n    \"\"\"Everyone knows Fibonacci sequence, it was studied deeply by mathematicians in \n    the last couple centuries. However, what people don't know is Tribonacci sequence.\n    Tribonacci sequence is defined by the recurrence:\n    tri(1) = 3\n    tri(n) = 1 + n / 2, if n is even.\n    tri(n) =  tri(n - 1) + tri(n - 2) + tri(n + 1), if n is odd.\n    For example:\n    tri(2) = 1 + (2 / 2) = 2\n    tri(4) = 3\n    tri(3) = tri(2) + tri(1) + tri(4)\n           = 2 + 3 + 3 = 8 \n    You are given a non-negative integer number n, you have to a return a list of the \n    first n + 1 numbers of the Tribonacci sequence.\n    Examples:\n    tri(3) = [1, 3, 2, 8]\n    \"\"\"\n\n    memo = {}\n\n    def _compute_tri(k: int) -> int:\n        \"\"\"Computes the k-th Tribonacci number using memoization.\"\"\"\n        if k in memo:\n            return memo[k]\n\n        if k == 0:\n            val = 1\n        elif k == 1:\n            val = 3\n        elif k % 2 == 0:  # Even rule\n            val = 1 + k // 2\n        else:  # Odd rule: tri(k) = tri(k - 1) + tri(k - 2) + tri(k + 1)\n            val = _compute_tri(k - 1) + _compute_tri(k - 2) + _compute_tri(k + 1)\n        \n        memo[k] = val\n        return val\n\n    result_list = []\n    for i in range(n + 1):\n        result_list.append(_compute_tri(i))\n\n    return result_list"}
{"task_id": "HumanEval/133", "solution": "import math\n\ndef sum_squares(lst):\n    \"\"\"You are given a list of numbers.\n    You need to return the sum of squared numbers in the given list,\n    round each element in the list to the upper int(Ceiling) first.\n    Examples:\n    For lst = [1,2,3] the output should be 14\n    For lst = [1,4,9] the output should be 98\n    For lst = [1,3,5,7] the output should be 84\n    For lst = [1.4,4.2,0] the output should be 29\n    For lst = [-2.4,1,1] the output should be 6\n    \"\"\"\n    total_sum = 0\n    for num in lst:\n        rounded_num = math.ceil(num)\n        total_sum += rounded_num * rounded_num\n    return total_sum"}
{"task_id": "HumanEval/129", "solution": "class Cell:\n    \"\"\"Represents a cell in the grid with its value and coordinates.\"\"\"\n    def __init__(self, value, row, col):\n        self.value = value\n        self.row = row\n        self.col = col\n\n    def __repr__(self):\n        return f\"Cell(val={self.value}, r={self.row}, c={self.col})\"\n\n    def __eq__(self, other):\n        # Cells are considered equal if they have the same grid coordinates.\n        return isinstance(other, Cell) and self.row == other.row and self.col == other.col\n\n    def __hash__(self):\n        return hash((self.row, self.col))\n\n\nclass Grid:\n    \"\"\"Manages the grid structure, cell access, and neighbor retrieval.\"\"\"\n    def __init__(self, grid_data):\n        self.rows = len(grid_data)\n        if self.rows == 0:\n            raise ValueError(\"Grid cannot be empty.\")\n        self.cols = len(grid_data[0])\n        if self.cols == 0:\n            raise ValueError(\"Grid rows cannot be empty.\")\n            \n        self.cells = [[None for _ in range(self.cols)] for _ in range(self.rows)]\n        for r in range(self.rows):\n            for c in range(self.cols):\n                self.cells[r][c] = Cell(grid_data[r][c], r, c)\n\n    def validate(self):\n        \"\"\"Validates grid dimensions and value distribution.\"\"\"\n        if self.rows < 2 or self.rows != self.cols:\n            raise ValueError(\"Grid must be a square matrix with N >= 2.\")\n        \n        expected_size = self.rows * self.cols\n        flat_values = []\n        for r in range(self.rows):\n            for c in range(self.cols):\n                flat_values.append(self.cells[r][c].value)\n        \n        # The problem guarantees unique values from 1 to N*N.\n        # This explicit check ensures compliance with the design document.\n        if len(flat_values) != expected_size or sorted(flat_values) != list(range(1, expected_size + 1)):\n             raise ValueError(\"Grid values are not a permutation of [1, N*N].\")\n        \n        return True\n\n    def get_cell(self, r, c):\n        \"\"\"Returns the Cell object at given coordinates, or None if out of bounds.\"\"\"\n        if 0 <= r < self.rows and 0 <= c < self.cols:\n            return self.cells[r][c]\n        return None\n\n    def get_neighbors(self, cell):\n        \"\"\"Returns a list of valid neighboring cells (up, down, left, right).\"\"\"\n        neighbors = []\n        dr = [-1, 1, 0, 0] # Row offsets for Up, Down\n        dc = [0, 0, -1, 1] # Column offsets for Left, Right\n        for i in range(4):\n            nr, nc = cell.row + dr[i], cell.col + dc[i]\n            neighbor_cell = self.get_cell(nr, nc)\n            if neighbor_cell:\n                neighbors.append(neighbor_cell)\n        return neighbors\n\n\nclass Path:\n    \"\"\"Represents a path of cells and provides lexicographical comparison.\"\"\"\n    def __init__(self, cells):\n        self.cells = list(cells) # Store a copy of the list of Cell objects\n        self.length = len(self.cells)\n\n    def to_value_list(self):\n        \"\"\"Converts the path of Cell objects to a list of their values.\"\"\"\n        return [cell.value for cell in self.cells]\n\n    def __lt__(self, other):\n        \"\"\"Compares two paths lexicographically based on cell values.\"\"\"\n        if not isinstance(other, Path):\n            return NotImplemented\n        \n        # Paths being compared for min_path_obj are guaranteed to be of length 'k'.\n        for i in range(self.length):\n            if self.cells[i].value < other.cells[i].value:\n                return True\n            elif self.cells[i].value > other.cells[i].value:\n                return False\n        return False # Paths are equal, or one is a prefix of other (not applicable for k-length paths)\n\n\nclass MinPathSolver:\n    \"\"\"Orchestrates pathfinding, validation, and lexicographical comparison.\"\"\"\n    def __init__(self, grid_data, k):\n        self.grid = Grid(grid_data)\n        self.k = k\n        self.grid.validate() # Validate grid upon solver initialization, as per design\n\n    def find_min_path(self):\n        \"\"\"Finds the lexicographically smallest path of length k in the grid.\"\"\"\n        N = self.grid.rows\n\n        # Handle the special case where k equals 1\n        if self.k == 1:\n            min_val = float('inf')\n            for r in range(N):\n                for c in range(N):\n                    min_val = min(min_val, self.grid.cells[r][c].value)\n            return [min_val]\n\n        min_path_obj = None # Stores the current lexicographically smallest Path object found (of length k)\n\n        current_path_cells_dfs = [] # Mutable list of Cell objects for the current path in DFS\n        \n        def dfs(current_cell):\n            nonlocal min_path_obj\n\n            current_path_cells_dfs.append(current_cell)\n            current_path_len = len(current_path_cells_dfs)\n\n            # Pruning logic: If current path prefix is already lexicographically greater\n            # than the corresponding prefix of the best full path found so far (min_path_obj).\n            if min_path_obj is not None:\n                prune_current_branch = False\n                for i in range(current_path_len):\n                    # We only compare up to the current length of the exploring path.\n                    # min_path_obj is guaranteed to be of length k if not None.\n                    if current_path_cells_dfs[i].value > min_path_obj.cells[i].value:\n                        prune_current_branch = True\n                        break\n                    elif current_path_cells_dfs[i].value < min_path_obj.cells[i].value:\n                        # Current prefix is lexicographically smaller, so it's a potential candidate.\n                        break\n                \n                if prune_current_branch:\n                    current_path_cells_dfs.pop() # Backtrack: remove current_cell before returning\n                    return\n\n            # Base case: A path of length k is formed\n            if current_path_len == self.k:\n                # Create a new Path instance with a copy of cells to avoid mutable list issues\n                current_path_obj = Path(current_path_cells_dfs) \n                if min_path_obj is None or current_path_obj < min_path_obj:\n                    min_path_obj = current_path_obj\n                \n                current_path_cells_dfs.pop() # Backtrack\n                return\n\n            # Explore neighbors of the current cell\n            neighbors = self.grid.get_neighbors(current_cell)\n            # Optimization: Explore neighbors with smaller values first to find minimal path faster.\n            neighbors.sort(key=lambda cell: cell.value) \n            \n            for next_cell in neighbors:\n                dfs(next_cell)\n\n            current_path_cells_dfs.pop() # Backtrack\n\n        # Iterate through all possible starting cells in the grid\n        for r_start in range(N):\n            for c_start in range(N):\n                start_cell = self.grid.get_cell(r_start, c_start)\n                dfs(start_cell)\n        \n        if min_path_obj:\n            return min_path_obj.to_value_list()\n        # According to the problem statement, an answer is guaranteed and unique.\n        return [] # This line should theoretically not be reached.\n\n\ndef minPath(grid, k):\n    \"\"\"\n    Given a grid with N rows and N columns (N >= 2) and a positive integer k, \n    each cell of the grid contains a value. Every integer in the range [1, N * N]\n    inclusive appears exactly once on the cells of the grid.\n\n    You have to find the minimum path of length k in the grid. You can start\n    from any cell, and in each step you can move to any of the neighbor cells,\n    in other words, you can go to cells which share an edge with you current\n    cell.\n    Please note that a path of length k means visiting exactly k cells (not\n    necessarily distinct).\n    You CANNOT go off the grid.\n    A path A (of length k) is considered less than a path B (of length k) if\n    after making the ordered lists of the values on the cells that A and B go\n    through (let's call them lst_A and lst_B), lst_A is lexicographically less\n    than lst_B, in other words, there exist an integer index i (1 <= i <= k)\n    such that lst_A[i] < lst_B[i] and for any j (1 <= j < i) we have\n    lst_A[j] = lst_B[j].\n    It is guaranteed that the answer is unique.\n    Return an ordered list of the values on the cells that the minimum path go through.\n    \"\"\"\n    solver = MinPathSolver(grid, k)\n    return solver.find_min_path()"}
{"task_id": "HumanEval/132", "solution": "def _validate_input(content: str) -> bool:\n    \"\"\"Checks if the string contains only square brackets.\"\"\"\n    for char in content:\n        if char not in '[]':\n            return False\n    return True\n\ndef _is_balanced(subseq: str) -> bool:\n    \"\"\"Checks if a string of brackets is balanced.\"\"\"\n    stack = []\n    for char in subseq:\n        if char == '[':\n            stack.append(char)\n        elif char == ']':\n            if not stack:\n                return False\n            stack.pop()\n    return not stack\n\ndef _has_nested(subseq: str) -> bool:\n    \"\"\"Detects if a balanced subsequence has a nested pair.\"\"\"\n    # A balanced sequence S is considered \"nested\" if S = '[' + X + ']'\n    # where X is a non-empty and balanced sequence itself.\n    if len(subseq) < 4: # Minimal length for `[X]` where X is non-empty and balanced (e.g., '[[]]')\n        return False\n    if subseq[0] == '[' and subseq[-1] == ']':\n        inner_content = subseq[1:-1]\n        return len(inner_content) > 0 and _is_balanced(inner_content)\n    return False\n\ndef is_nested(string):\n    '''\n    Create a function that takes a string as input which contains only square brackets.\n    The function should return True if and only if there is a valid subsequence of brackets \n    where at least one bracket in the subsequence is nested.\n    '''\n    if not _validate_input(string):\n        return False\n\n    n = len(string)\n    # Iterate through all possible contiguous substrings as \"subsequences\" based on design context.\n    for i in range(n):\n        for j in range(i + 1, n + 1):\n            subseq_str = string[i:j]\n            if _is_balanced(subseq_str) and _has_nested(subseq_str):\n                return True\n    \n    return False"}
{"task_id": "HumanEval/134", "solution": "def check_if_last_char_is_a_letter(txt):\n    \"\"\"\n    Return True if the last character of `txt` is an alphabetical character\n    that is either the first character of the string or is preceded by a space.\n    \"\"\"\n    if not txt:\n        return False\n\n    last_char = txt[-1]\n    if not last_char.isalpha():\n        return False\n\n    if len(txt) == 1:\n        return True\n\n    return txt[-2] == ' '"}
{"task_id": "HumanEval/135", "solution": "def can_arrange(arr):\n    \"\"\"Finds the largest index of an element that is not greater than or equal to its predecessor.\n    If no such element exists, it returns -1.\"\"\"\n    # Iterate from the second-to-last element down to the second element.\n    # We compare arr[i] with arr[i-1].\n    for i in range(len(arr) - 1, 0, -1):\n        # If arr[i] is strictly less than arr[i-1], we found the largest such index.\n        if arr[i] < arr[i - 1]:\n            return i\n    # If no such element is found after checking all pairs, return -1.\n    return -1"}
{"task_id": "HumanEval/136", "solution": "def largest_smallest_integers(lst):\n    \"\"\"\n    Finds the largest negative and smallest positive integers in a list.\n    Returns (largest_negative, smallest_positive), with None if a category is empty.\n    \"\"\"\n    largest_negative = None\n    smallest_positive = None\n\n    for num in lst:\n        if num < 0:\n            if largest_negative is None or num > largest_negative:\n                largest_negative = num\n        elif num > 0:\n            if smallest_positive is None or num < smallest_positive:\n                smallest_positive = num\n\n    return (largest_negative, smallest_positive)"}
{"task_id": "HumanEval/139", "solution": "def special_factorial(n):\n    \"\"\"The Brazilian factorial is defined as:\n    brazilian_factorial(n) = n! * (n-1)! * (n-2)! * ... * 1!\n    where n > 0\n\n    For example:\n    >>> special_factorial(4)\n    288\n\n    The function will receive an integer as input and should return the special\n    factorial of this integer.\n    \"\"\"\n    \n    special_product = 1\n    \n    # Iterate from 1 up to n to calculate each factorial i!\n    for i in range(1, n + 1):\n        # Calculate the factorial of the current number i\n        current_factorial = 1\n        for j in range(1, i + 1):\n            current_factorial *= j\n        \n        # Multiply the calculated factorial into the running special product\n        special_product *= current_factorial\n            \n    return special_product"}
{"task_id": "HumanEval/138", "solution": "def is_equal_to_sum_even(n):\n    \"\"\"Determine whether the given integer n can be written as the sum of exactly\n    four positive even numbers.\n    \"\"\"\n    if n < 8:\n        return False\n    if n % 2 != 0:\n        return False\n    return True"}
{"task_id": "HumanEval/141", "solution": "import re\n\ndef file_name_check(file_name):\n    \"\"\"Checks if a file's name is valid based on specific criteria.\n    Returns 'Yes' if valid, 'No' otherwise.\"\"\"\n\n    # Condition 1: Number of digits\n    digit_count = sum(c.isdigit() for c in file_name)\n    if digit_count > 3:\n        return 'No'\n\n    # Condition 2 & 3 & 4: Exactly one dot, non-empty prefix starting with letter, valid suffix\n    parts = file_name.split('.')\n    if len(parts) != 2:  # Must have exactly one dot\n        return 'No'\n\n    prefix = parts[0]\n    suffix = parts[1]\n\n    # Condition 3: Substring before the dot (prefix)\n    if not prefix:  # Should not be empty\n        return 'No'\n    if not prefix[0].isalpha():  # Must start with a letter\n        return 'No'\n\n    # Condition 4: Substring after the dot (suffix)\n    valid_suffixes = ['txt', 'exe', 'dll']\n    if suffix not in valid_suffixes:\n        return 'No'\n\n    return 'Yes'"}
{"task_id": "HumanEval/140", "solution": "def fix_spaces(text):\n    \"\"\"\n    Given a string text, replace all spaces in it with underscores, \n    and if a string has more than 2 consecutive spaces, \n    then replace all consecutive spaces with - \n    \"\"\"\n    result = []\n    i = 0\n    while i < len(text):\n        if text[i] != ' ':\n            result.append(text[i])\n            i += 1\n        else:\n            start = i\n            while i < len(text) and text[i] == ' ':\n                i += 1\n            count = i - start\n            if count > 2:\n                result.append('-')\n            else:\n                result.extend(['_'] * count)\n    return ''.join(result)"}
{"task_id": "HumanEval/142", "solution": "def sum_squares(lst):\n    \"\"\"\n    This function will take a list of integers. For all entries in the list, the function shall square the integer entry if its index is a \n    multiple of 3 and will cube the integer entry if its index is a multiple of 4 and not a multiple of 3. The function will not \n    change the entries in the list whose indexes are not a multiple of 3 or 4. The function shall then return the sum of all entries. \n    \"\"\"\n    total_sum = 0\n    for i, num in enumerate(lst):\n        if i % 3 == 0:\n            total_sum += num * num\n        elif i % 4 == 0:  # and i % 3 != 0 is implicitly handled by the if-elif structure\n            total_sum += num * num * num\n        else:\n            total_sum += num\n    return total_sum"}
{"task_id": "HumanEval/143", "solution": "def words_in_sentence(sentence):\n    \"\"\"\n    Returns a string containing words from the original sentence whose lengths are prime numbers,\n    preserving the original order.\n    \"\"\"\n    def is_prime(n):\n        if n < 2:\n            return False\n        for i in range(2, int(n**0.5) + 1):\n            if n % i == 0:\n                return False\n        return True\n\n    words = sentence.split()\n    prime_length_words = []\n    for word in words:\n        if is_prime(len(word)):\n            prime_length_words.append(word)\n    return \" \".join(prime_length_words)"}
{"task_id": "HumanEval/145", "solution": "from dataclasses import dataclass\nfrom typing import List\n\n@dataclass(frozen=True)\nclass _IntegerElement:\n    \"\"\"Helper dataclass to store an integer's value, digit sum, and original index.\"\"\"\n    value: int\n    digit_sum: int\n    original_index: int\n\ndef _calculate_digit_sum(n: int) -> int:\n    \"\"\"Calculates the sum of the absolute value's digits.\"\"\"\n    return sum(int(d) for d in str(abs(n)))\n\ndef order_by_points(nums: List[int]) -> List[int]:\n    \"\"\"\n    Write a function which sorts the given list of integers\n    in ascending order according to the sum of their digits.\n    Note: if there are several items with similar sum of their digits,\n    order them based on their index in original list.\n\n    For example:\n    >>> order_by_points([1, 11, -1, -11, -12]) == [-1, -11, 1, -12, 11]\n    >>> order_by_points([]) == []\n    \"\"\"\n    if not nums:\n        return []\n\n    elements = [\n        _IntegerElement(value=num, digit_sum=_calculate_digit_sum(num), original_index=i)\n        for i, num in enumerate(nums)\n    ]\n\n    # Sort primarily by digit_sum, then by original_index for stable tie-breaking.\n    sorted_elements = sorted(elements, key=lambda e: (e.digit_sum, e.original_index))\n\n    return [e.value for e in sorted_elements]"}
{"task_id": "HumanEval/144", "solution": "def simplify(x, n):\n    \"\"\"Your task is to implement a function that will simplify the expression\n    x * n. The function returns True if x * n evaluates to a whole number and False\n    otherwise. Both x and n, are string representation of a fraction, and have the following format,\n    <numerator>/<denominator> where both numerator and denominator are positive whole numbers.\n\n    You can assume that x, and n are valid fractions, and do not have zero as denominator.\n\n    simplify(\"1/5\", \"5/1\") = True\n    simplify(\"1/6\", \"2/1\") = False\n    simplify(\"7/10\", \"10/2\") = False\n    \"\"\"\n    # Parse the first fraction string x\n    x_num_str, x_den_str = x.split('/')\n    x_numerator = int(x_num_str)\n    x_denominator = int(x_den_str)\n\n    # Parse the second fraction string n\n    n_num_str, n_den_str = n.split('/')\n    n_numerator = int(n_num_str)\n    n_denominator = int(n_den_str)\n\n    # Multiply the two fractions\n    # The numerator of the product is the product of the numerators\n    product_numerator = x_numerator * n_numerator\n    # The denominator of the product is the product of the denominators\n    product_denominator = x_denominator * n_denominator\n\n    # Check if the product is a whole number\n    # A fraction is a whole number if its numerator is perfectly divisible by its denominator\n    return product_numerator % product_denominator == 0"}
{"task_id": "HumanEval/146", "solution": "def specialFilter(nums):\n    \"\"\"Write a function that takes an array of numbers as input and returns \n    the number of elements in the array that are greater than 10 and both \n    first and last digits of a number are odd (1, 3, 5, 7, 9).\n    For example:\n    specialFilter([15, -73, 14, -15]) => 1 \n    specialFilter([33, -2, -3, 45, 21, 109]) => 2\n    \"\"\"\n    count = 0\n    for num in nums:\n        if num > 10:\n            # Convert the absolute value of the number to a string to easily access digits.\n            s_num = str(abs(num))\n            first_digit = int(s_num[0])\n            last_digit = int(s_num[-1])\n\n            # Check if both first and last digits are odd.\n            if first_digit % 2 != 0 and last_digit % 2 != 0:\n                count += 1\n    return count"}
{"task_id": "HumanEval/148", "solution": "def bf(planet1, planet2):\n    '''\n    Returns a tuple of planets whose orbits are between planet1 and planet2, sorted by proximity to the sun.\n    Returns an empty tuple if planet1 or planet2 are not valid names.\n    '''\n    planets = [\n        \"Mercury\", \"Venus\", \"Earth\", \"Mars\", \"Jupiter\", \"Saturn\", \"Uranus\", \"Neptune\"\n    ]\n\n    if planet1 not in planets or planet2 not in planets:\n        return ()\n\n    index1 = planets.index(planet1)\n    index2 = planets.index(planet2)\n\n    if index1 == index2:\n        return ()\n\n    if index1 < index2:\n        start_index = index1 + 1\n        end_index = index2\n    else:\n        start_index = index2 + 1\n        end_index = index1\n    \n    return tuple(planets[start_index:end_index])"}
{"task_id": "HumanEval/147", "solution": "def get_max_triples(n):\n    \"\"\"\n    Calculates the number of triples (a[i], a[j], a[k]) from a generated array 'a'\n    such that i < j < k and a[i] + a[j] + a[k] is a multiple of 3.\n    \"\"\"\n    if n < 3:\n        return 0\n\n    a = []\n    for i in range(1, n + 1):\n        a.append(i * i - i + 1)\n\n    count = 0\n    # Iterate through all possible unique combinations of three indices (i, j, k)\n    # The indices in the problem description are 1-based, here we use 0-based for list access.\n    # So, original i becomes current_i, original j becomes current_j, original k becomes current_k.\n    # The conditions i < j < k are maintained by loop ranges.\n    for current_i in range(n - 2):\n        for current_j in range(current_i + 1, n - 1):\n            for current_k in range(current_j + 1, n):\n                if (a[current_i] + a[current_j] + a[current_k]) % 3 == 0:\n                    count += 1\n    return count"}
{"task_id": "HumanEval/149", "solution": "class Word:\n    \"\"\"Represents a word with its text and length, supporting comparison for sorting.\"\"\"\n    def __init__(self, text: str):\n        self.text = text\n        self.length = len(text)\n\n    def __lt__(self, other):\n        \"\"\"Compares two Word objects first by length, then alphabetically by text.\"\"\"\n        if self.length != other.length:\n            return self.length < other.length\n        return self.text < other.text\n\n    def __eq__(self, other):\n        \"\"\"Checks if two Word objects are equal based on text and length.\"\"\"\n        if not isinstance(other, Word):\n            return NotImplemented\n        return self.text == other.text and self.length == other.length\n\n    def __repr__(self):\n        return f\"Word('{self.text}')\"\n\nclass WordList:\n    \"\"\"Manages a list of Word objects, providing methods for filtering and sorting.\"\"\"\n    def __init__(self, string_list: list[str]):\n        self.words: list[Word] = [Word(s) for s in string_list]\n\n    def remove_odd_length(self):\n        \"\"\"Removes words from the list that have an odd length.\"\"\"\n        self.words = [word for word in self.words if word.length % 2 == 0]\n\n    def sort_by_length_and_alphabetically(self):\n        \"\"\"Sorts the words list based on length (ascending) then alphabetically (ascending).\"\"\"\n        self.words.sort()\n\n    def get_string_list(self) -> list[str]:\n        \"\"\"Returns the current list of words as a list of strings.\"\"\"\n        return [word.text for word in self.words]\n\ndef sorted_list_sum(lst: list[str]) -> list[str]:\n    \"\"\"Processes a list of strings by removing odd-length words and sorting the remainder.\"\"\"\n    word_list_obj = WordList(lst)\n    word_list_obj.remove_odd_length()\n    word_list_obj.sort_by_length_and_alphabetically()\n    return word_list_obj.get_string_list()"}
{"task_id": "HumanEval/150", "solution": "def x_or_y(n, x, y):\n    \"\"\"A simple program which should return the value of x if n is \n    a prime number and should return the value of y otherwise.\n\n    Examples:\n    for x_or_y(7, 34, 12) == 34\n    for x_or_y(15, 8, 5) == 5\n    \n    \"\"\"\n    if n <= 1:\n        return y\n    if n <= 3:  # 2 and 3 are prime\n        return x\n    if n % 2 == 0 or n % 3 == 0:\n        return y\n    \n    i = 5\n    while i * i <= n:\n        if n % i == 0 or n % (i + 2) == 0:\n            return y\n        i += 6\n    \n    return x"}
{"task_id": "HumanEval/152", "solution": "def compare(game,guess):\n    \"\"\"Compares actual game scores to guessed scores, returning the absolute difference for each match.\n    If a guess is correct, the difference is 0.\"\"\"\n    result = []\n    for i in range(len(game)):\n        if game[i] == guess[i]:\n            result.append(0)\n        else:\n            result.append(abs(game[i] - guess[i]))\n    return result"}
{"task_id": "HumanEval/151", "solution": "```python\ndef double_the_difference(lst):\n    \"\"\"\n    Calculates the sum of squares of odd numbers in a list, ignoring negatives or non-integers.\n    Returns 0 if the list is empty or contains no valid numbers.\n    \"\"\"\n    total_sum = 0\n    for num in lst:\n        if isinstance(num, int) and num > 0 and num % 2 != 0:\n            total_sum += num * num\n    return total_sum\n```"}
{"task_id": "HumanEval/153", "solution": "def Strongest_Extension(class_name, extensions):\n    \"\"\"Finds the strongest extension based on CAP - SM strength and returns it with the class name.\n    If strengths are equal, the extension appearing first in the list is chosen.\"\"\"\n    \n    # Initialize with the first extension as the strongest candidate.\n    # The problem implies that the 'extensions' list will not be empty.\n    strongest_extension_name = extensions[0]\n    \n    cap_count_initial = sum(1 for char in strongest_extension_name if char.isupper())\n    sm_count_initial = sum(1 for char in strongest_extension_name if char.islower())\n    max_strength = cap_count_initial - sm_count_initial\n\n    # Iterate through the rest of the extensions to find the truly strongest one.\n    for i in range(1, len(extensions)):\n        current_ext = extensions[i]\n        \n        cap_count_current = sum(1 for char in current_ext if char.isupper())\n        sm_count_current = sum(1 for char in current_ext if char.islower())\n        current_strength = cap_count_current - sm_count_current\n        \n        # Update if the current extension is strictly stronger.\n        # This naturally handles the tie-breaking rule (first one in list if equal strength).\n        if current_strength > max_strength:\n            max_strength = current_strength\n            strongest_extension_name = current_ext\n            \n    return f\"{class_name}.{strongest_extension_name}\""}
{"task_id": "HumanEval/154", "solution": "def cycpattern_check(a , b):\n    \"\"\"You are given 2 words. You need to return True if the second word or any of its rotations is a substring in the first word\n    cycpattern_check(\"abcd\",\"abd\") => False\n    cycpattern_check(\"hello\",\"ell\") => True\n    cycpattern_check(\"whassup\",\"psus\") => False\n    cycpattern_check(\"abab\",\"baa\") => True\n    cycpattern_check(\"efef\",\"eeff\") => False\n    cycpattern_check(\"himenss\",\"simen\") => True\n\n    \"\"\"\n    # If the second word is empty or longer than the first word, it cannot be a substring.\n    if not b or len(b) > len(a):\n        return False\n\n    len_b = len(b)\n    # Generate all cyclic rotations of 'b'.\n    for i in range(len_b):\n        # A rotation is formed by taking a suffix and prefix of 'b'.\n        rotated_b = b[i:] + b[:i]\n        \n        # Check if the current rotation is a substring of 'a'.\n        if rotated_b in a:\n            return True\n            \n    # If no rotation of 'b' was found in 'a', return False.\n    return False"}
{"task_id": "HumanEval/155", "solution": "def even_odd_count(num):\n    \"\"\"Given an integer. return a tuple that has the number of even and odd digits respectively.\n\n     Example:\n        even_odd_count(-12) ==> (1, 1)\n        even_odd_count(123) ==> (1, 2)\n    \"\"\"\n    even_count = 0\n    odd_count = 0\n    \n    # Take the absolute value to handle negative numbers as per FR2\n    num_str = str(abs(num))\n    \n    for digit_char in num_str:\n        digit = int(digit_char)\n        if digit % 2 == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n            \n    return (even_count, odd_count)"}
{"task_id": "HumanEval/156", "solution": "def int_to_mini_roman(number):\n    \"\"\"\n    Given a positive integer, obtain its roman numeral equivalent as a string,\n    and return it in lowercase.\n    Restrictions: 1 <= num <= 1000\n    \"\"\"\n    roman_map = {\n        1000: 'm', 900: 'cm', 500: 'd', 400: 'cd', 100: 'c',\n        90: 'xc', 50: 'l', 40: 'xl', 10: 'x', 9: 'ix',\n        5: 'v', 4: 'iv', 1: 'i'\n    }\n    \n    result = []\n    # Iterate through the Roman numeral values in descending order.\n    for value, symbol in roman_map.items():\n        while number >= value:\n            result.append(symbol)\n            number -= value\n    \n    return \"\".join(result)"}
{"task_id": "HumanEval/157", "solution": "def right_angle_triangle(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle. Return True if the three\n    sides form a right-angled triangle, False otherwise.\n    '''\n    \n    # Sort the sides to easily identify the hypotenuse (largest side).\n    sides = sorted([a, b, c])\n    x, y, z = sides[0], sides[1], sides[2]\n\n    # Check for triangle inequality: the sum of any two sides must be greater than the third side.\n    if x + y <= z:\n        return False\n    \n    # Apply the Pythagorean theorem (a^2 + b^2 = c^2) with a small tolerance for floating-point comparisons.\n    # The largest side 'z' is assumed to be the hypotenuse.\n    tolerance = 1e-9\n    return abs(x*x + y*y - z*z) < tolerance"}
{"task_id": "HumanEval/159", "solution": "def eat(number, need, remaining):\n    \"\"\"\n    Calculates the total number of carrots eaten and the remaining carrots after a meal.\n    The rabbit eats the lesser of what it needs or what is available.\n    \"\"\"\n    carrots_eaten_from_stock = min(need, remaining)\n    total_eaten_carrots = number + carrots_eaten_from_stock\n    carrots_left = remaining - carrots_eaten_from_stock\n    return [total_eaten_carrots, carrots_left]"}
{"task_id": "HumanEval/158", "solution": "def find_max(words):\n    if not words:\n        return \"\"\n\n    max_unique_count = -1\n    result_word = \"\"\n\n    for word in words:\n        current_unique_count = len(set(word))\n\n        if current_unique_count > max_unique_count:\n            max_unique_count = current_unique_count\n            result_word = word\n        elif current_unique_count == max_unique_count:\n            if word < result_word:\n                result_word = word\n\n    return result_word"}
{"task_id": "HumanEval/160", "solution": "def do_algebra(operator, operand):\n    \"\"\"\n    Given two lists operator, and operand. The first list has basic algebra operations, and \n    the second list is a list of integers. Use the two given lists to build the algebric \n    expression and return the evaluation of this expression.\n    \"\"\"\n    # Construct the initial expression list by interleaving operands and operators.\n    # Example: [2, '+', 3, '*', 4, '-', 5]\n    expression = [operand[0]]\n    for i in range(len(operator)):\n        expression.append(operator[i])\n        expression.append(operand[i+1])\n\n    # Helper function to perform one pass of evaluation for a specific set of operators.\n    # It processes operators with equal precedence from left to right.\n    def _evaluate_pass(current_expr_list, ops_set):\n        new_expr_list = []\n        i = 0\n        while i < len(current_expr_list):\n            # Check if the current element is an operator from the target set\n            if isinstance(current_expr_list[i], str) and current_expr_list[i] in ops_set:\n                left_operand = new_expr_list.pop()  # Get the operand processed so far\n                op = current_expr_list[i]\n                right_operand = current_expr_list[i+1] # Get the next operand\n\n                res = 0\n                if op == '+':\n                    res = left_operand + right_operand\n                elif op == '-':\n                    res = left_operand - right_operand\n                elif op == '*':\n                    res = left_operand * right_operand\n                elif op == '//':\n                    res = left_operand // right_operand\n                elif op == '**':\n                    res = left_operand ** right_operand\n                \n                new_expr_list.append(res) # Add the result back\n                i += 2 # Skip the operator and the right operand\n            else:\n                new_expr_list.append(current_expr_list[i]) # Append operand or unmatched operator\n                i += 1\n        return new_expr_list\n\n    # Evaluation passes based on standard operator precedence:\n    # 1. Exponentiation (**)\n    expression = _evaluate_pass(expression, {'**'})\n    \n    # 2. Multiplication (*) and Floor Division (//)\n    expression = _evaluate_pass(expression, {'*', '//'})\n    \n    # 3. Addition (+) and Subtraction (-)\n    expression = _evaluate_pass(expression, {'+', '-'})\n    \n    # After all passes, the list should contain a single element, which is the final result.\n    return expression[0]"}
{"task_id": "HumanEval/161", "solution": "def solve(s):\n    \"\"\"You are given a string s.\n    if s[i] is a letter, reverse its case from lower to upper or vise versa, \n    otherwise keep it as it is.\n    If the string contains no letters, reverse the string.\n    The function should return the resulted string.\n    Examples\n    solve(\"1234\") = \"4321\"\n    solve(\"ab\") = \"AB\"\n    solve(\"#a@C\") = \"#A@c\"\n    \"\"\"\n    if not s:\n        return \"\"\n\n    has_letter = False\n    for char in s:\n        if char.isalpha():\n            has_letter = True\n            break\n\n    if not has_letter:\n        return s[::-1]\n\n    result_chars = []\n    for char in s:\n        if char.isalpha():\n            result_chars.append(char.swapcase())\n        else:\n            result_chars.append(char)\n            \n    return \"\".join(result_chars)"}
{"task_id": "HumanEval/162", "solution": "import hashlib\n\ndef string_to_md5(text):\n    \"\"\"\n    Given a string 'text', return its md5 hash equivalent string.\n    If 'text' is an empty string, return None.\n    \"\"\"\n    if not text:\n        return None\n    return hashlib.md5(text.encode('utf-8')).hexdigest()"}
{"task_id": "HumanEval/163", "solution": "def generate_integers(a, b):\n    \"\"\"\n    Given two positive integers a and b, return the even digits between a\n    and b, in ascending order.\n\n    For example:\n    generate_integers(2, 8) => [2, 4, 6, 8]\n    generate_integers(8, 2) => [2, 4, 6, 8]\n    generate_integers(10, 14) => []\n    \"\"\"\n    min_val = min(a, b)\n    max_val = max(a, b)\n\n    result = []\n    # The problem asks for \"even digits\". Based on examples, this means\n    # single-digit even numbers (0, 2, 4, 6, 8) that fall within the range [min_val, max_val].\n    for i in range(10): # Check numbers from 0 to 9\n        if min_val <= i <= max_val and i % 2 == 0:\n            result.append(i)\n\n    return result"}
{"task_id": "HumanEval/47", "solution": "```python\ndef median(l: list):\n    \"\"\"Return median of elements in the list l.\n    Sorts the list and finds the middle element(s).\n    \"\"\"\n    sorted_l = sorted(l)\n    n = len(sorted_l)\n    if n % 2 == 1:\n        return sorted_l[n // 2]\n    else:\n        mid1 = sorted_l[n // 2 - 1]\n        mid2 = sorted_l[n // 2]\n        return (mid1 + mid2) / 2.0\n```"}
{"task_id": "HumanEval/137", "solution": "def compare_one(a, b):\n    \"\"\"\n    Compares two numbers (int, float, or string) and returns the larger, preserving its type.\n    Returns None if the numeric values are equal.\n    \"\"\"\n\n    def _parse_to_float(value):\n        \"\"\"Converts an input value to a float for comparison.\"\"\"\n        if isinstance(value, (int, float)):\n            return float(value)\n        elif isinstance(value, str):\n            return float(value.replace(',', '.'))\n        return None # Should not be reached with valid inputs as per design context\n\n    float_a = _parse_to_float(a)\n    float_b = _parse_to_float(b)\n\n    if float_a is None or float_b is None:\n        # This case should ideally not happen if inputs are always valid per design\n        return None\n\n    if float_a > float_b:\n        return a\n    elif float_b > float_a:\n        return b\n    else:\n        return None"}
