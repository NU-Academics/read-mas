{"task_id": "HumanEval/25", "solution": "from typing import List\n\n\ndef factorize(n: int) -> List[int]:\n    \"\"\" Return list of prime factors of given integer in the order from smallest to largest.\n    Each of the factors should be listed number of times corresponding to how many times it appeares in factorization.\n    Input number should be equal to the product of all factors\n    >>> factorize(8)\n    [2, 2, 2]\n    >>> factorize(25)\n    [5, 5]\n    >>> factorize(70)\n    [2, 5, 7]\n    \"\"\"\n    factors = []\n\n    # Handle factor 2\n    while n % 2 == 0:\n        factors.append(2)\n        n //= 2\n    \n    # Handle odd factors\n    d = 3\n    while d * d <= n:\n        while n % d == 0:\n            factors.append(d)\n            n //= d\n        d += 2\n    \n    # If n is still greater than 1, it must be a prime factor itself.\n    if n > 1:\n        factors.append(n)\n        \n    return factors"}
{"task_id": "HumanEval/26", "solution": "from typing import List\nfrom collections import Counter\n\n\ndef remove_duplicates(numbers: List[int]) -> List[int]:\n    \"\"\" From a list of integers, remove all elements that occur more than once.\n    Keep order of elements left the same as in the input.\n    \"\"\"\n    counts = Counter(numbers)\n    result = []\n    for number in numbers:\n        if counts[number] == 1:\n            result.append(number)\n    return result"}
{"task_id": "HumanEval/24", "solution": "class Number:\n    def __init__(self, value: int):\n        if value <= 1:\n            raise ValueError(\"Number must be > 1\")\n        self.value = value\n\n    def largest_divisor(self) -> int:\n        \"\"\"Return the largest divisor of self.value less than self.value.\"\"\"\n        n = self.value\n        for d in range(int(n**0.5), 0, -1):\n            if n % d == 0:\n                return n // d if n // d != n else d\n\ndef largest_divisor(n: int) -> int:\n    \"\"\" For a given number n, find the largest number that divides n evenly, smaller than n\n    >>> largest_divisor(15)\n    5\n    \"\"\"\n    number = Number(n)\n    return number.largest_divisor()"}
{"task_id": "HumanEval/27", "solution": "def flip_case(string: str) -> str:\n    \"\"\" For a given string, flip lowercase characters to uppercase and uppercase to lowercase.\n    \"\"\"\n    flipped_chars = []\n    for char in string:\n        if 'a' <= char <= 'z':  # Check if character is lowercase\n            flipped_chars.append(char.upper())\n        elif 'A' <= char <= 'Z':  # Check if character is uppercase\n            flipped_chars.append(char.lower())\n        else:  # Keep other characters unchanged\n            flipped_chars.append(char)\n    return \"\".join(flipped_chars)"}
{"task_id": "HumanEval/29", "solution": "def filter_by_prefix(strings: List[str], prefix: str) -> List[str]:\n    \"\"\" Filter an input list of strings only for ones that start with a given prefix.\n    \"\"\"\n    return [s for s in strings if s.startswith(prefix)]"}
{"task_id": "HumanEval/30", "solution": "```python\ndef get_positive(l: list):\n    \"\"\"Return only positive numbers in the list.\n    >>> get_positive([-1, 2, -4, 5, 6])\n    [2, 5, 6]\n    >>> get_positive([5, 3, -5, 2, -3, 3, 9, 0, 123, 1, -10])\n    [5, 3, 2, 3, 9, 123, 1]\n    \"\"\"\n    return [x for x in l if x > 0]\n```"}
{"task_id": "HumanEval/31", "solution": "def is_prime(n):\n    \"\"\"Return true if a given number is prime, and false otherwise.\n    This implementation uses trial division up to the square root of n.\n    \"\"\"\n    if n <= 1:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n    i = 3\n    while i * i <= n:\n        if n % i == 0:\n            return False\n        i += 2\n    return True"}
{"task_id": "HumanEval/34", "solution": "def unique(l: list):\n    \"\"\"Return sorted unique elements in a list\n    >>> unique([5, 3, 5, 2, 3, 3, 9, 0, 123])\n    [0, 2, 3, 5, 9, 123]\n    \"\"\"\n    return sorted(set(l))"}
{"task_id": "HumanEval/33", "solution": "def sort_third(l: list):\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the indicies that are not divisible by three, while its values at the indicies that are divisible by three are equal\n    to the values of the corresponding indicies of l, but sorted.\n    >>> sort_third([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_third([5, 6, 3, 4, 8, 9, 2])\n    [2, 6, 3, 4, 8, 9, 5]\n    \"\"\"\n    selected_values = []\n    selected_indices = []\n    \n    # Identify indices divisible by 3 and extract corresponding values.\n    for i in range(len(l)):\n        if i % 3 == 0:\n            selected_values.append(l[i])\n            selected_indices.append(i)\n            \n    # Sort the extracted values.\n    selected_values.sort()\n    \n    # Create a copy of the original list to modify.\n    result = list(l)\n    \n    # Replace elements at the identified indices with the sorted values.\n    for i, original_index in enumerate(selected_indices):\n        result[original_index] = selected_values[i]\n        \n    return result"}
{"task_id": "HumanEval/37", "solution": "def sort_even(l: list):\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the odd indicies, while its values at the even indicies are equal\n    to the values of the even indicies of l, but sorted.\n    >>> sort_even([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_even([5, 6, 3, 4])\n    [3, 6, 5, 4]\n    \"\"\"\n    if not l:\n        return []\n\n    # Extract elements at even indices and sort them.\n    even_indexed_values = [l[i] for i in range(0, len(l), 2)]\n    even_indexed_values.sort()\n\n    # Create a new list, copying odd-indexed values and placing sorted even-indexed values.\n    result = l[:]  # Make a shallow copy to preserve odd indices\n    even_idx_ptr = 0\n    for i in range(0, len(l), 2):\n        result[i] = even_indexed_values[even_idx_ptr]\n        even_idx_ptr += 1\n\n    return result"}
{"task_id": "HumanEval/35", "solution": "class ListContainer:\n    \"\"\"Internal class to encapsulate list and max calculation logic.\"\"\"\n    def __init__(self, elements: list):\n        self.elements = elements\n\n    def getMax(self) -> int:\n        \"\"\"Calculates and returns the maximum element from the stored list.\"\"\"\n        max_val = self.elements[0]\n        for element in self.elements[1:]:\n            if element > max_val:\n                max_val = element\n        return max_val\n\ndef max_element(l: list):\n    \"\"\"Return maximum element in the list.\n    >>> max_element([1, 2, 3])\n    3\n    >>> max_element([5, 3, -5, 2, -3, 3, 9, 0, 123, 1, -10])\n    123\n    \"\"\"\n    if not l:\n        raise ValueError(\"List cannot be empty.\")\n    \n    container = ListContainer(l)\n    return container.getMax()"}
{"task_id": "HumanEval/36", "solution": "def fizz_buzz(n: int) -> int:\n    \"\"\"Return the number of times the digit 7 appears in integers less than n which are divisible by 11 or 13.\"\"\"\n    total_sevens_count = 0\n    for i in range(n):\n        if i % 11 == 0 or i % 13 == 0:\n            total_sevens_count += str(i).count('7')\n    return total_sevens_count"}
{"task_id": "HumanEval/32", "solution": "def find_zero(xs: list):\n    \"\"\" xs are coefficients of a polynomial.\n    find_zero find x such that poly(x) = 0.\n    find_zero returns only only zero point, even if there are many.\n    Moreover, find_zero only takes list xs having even number of coefficients\n    and largest non zero coefficient as it guarantees\n    a solution.\n    >>> round(find_zero([1, 2]), 2) # f(x) = 1 + 2x\n    -0.5\n    >>> round(find_zero([-6, 11, -6, 1]), 2) # (x - 1) * (x - 2) * (x - 3) = -6 + 11x - 6x^2 + x^3\n    1.0\n    \"\"\"\n    # Bisection method for finding a root.\n    # The problem guarantees a solution for polynomials with an even number of coefficients\n    # (which implies an odd degree), ensuring at least one real root exists.\n    # We use a sufficiently wide initial search range to bracket a root.\n    low, high = -1_000_000.0, 1_000_000.0\n    TOLERANCE = 1e-7\n    MAX_ITERATIONS = 100\n\n    f_low = poly(xs, low)\n    f_high = poly(xs, high)\n\n    # Initial check if the bounds are already close to a root.\n    if abs(f_low) < TOLERANCE:\n        return low\n    if abs(f_high) < TOLERANCE:\n        return high\n\n    # The loop continues for a fixed number of iterations to ensure convergence to desired precision.\n    for _ in range(MAX_ITERATIONS):\n        mid = (low + high) / 2.0\n        f_mid = poly(xs, mid)\n\n        # If the midpoint is sufficiently close to zero, it's our root.\n        if abs(f_mid) < TOLERANCE:\n            return mid\n\n        # Determine which half of the interval contains the root by checking sign changes.\n        # Update `f_low` if the root is found in the right half, as `low` changes.\n        if (f_low * f_mid) < 0:  # Root is in the left half [low, mid]\n            high = mid\n        else:  # Root is in the right half [mid, high]\n            low = mid\n            f_low = f_mid  # Update f_low to the value at the new 'low' boundary\n\n    # After the maximum iterations, return the midpoint of the final interval.\n    # This value will be within the desired tolerance.\n    return (low + high) / 2.0"}
{"task_id": "HumanEval/38", "solution": "def decode_cyclic(s: str):\n    \"\"\"\n    takes as input string encoded with encode_cyclic function. Returns decoded string.\n    \"\"\"\n    # split string to groups. Each of length 3.\n    groups = [s[(3 * i):min((3 * i + 3), len(s))] for i in range((len(s) + 2) // 3)]\n    # reverse cycle elements in each group. Unless group has fewer elements than 3.\n    groups = [(group[-1] + group[:-1]) if len(group) == 3 else group for group in groups]\n    return \"\".join(groups)"}
{"task_id": "HumanEval/39", "solution": "import math\n\ndef _is_prime(num: int) -> bool:\n    \"\"\"Checks if a number is prime.\"\"\"\n    if num < 2:\n        return False\n    if num == 2:\n        return True\n    if num % 2 == 0:\n        return False\n    for i in range(3, int(math.sqrt(num)) + 1, 2):\n        if num % i == 0:\n            return False\n    return True\n\ndef _fibonacci_generator():\n    \"\"\"Generates Fibonacci numbers starting from F0=0.\"\"\"\n    a, b = 0, 1\n    yield a\n    yield b\n    while True:\n        a, b = b, a + b\n        yield b\n\ndef prime_fib(n: int):\n    \"\"\"\n    prime_fib returns n-th number that is a Fibonacci number and it's also prime.\n    >>> prime_fib(1)\n    2\n    >>> prime_fib(2)\n    3\n    >>> prime_fib(3)\n    5\n    >>> prime_fib(4)\n    13\n    >>> prime_fib(5)\n    89\n    \"\"\"\n    prime_count = 0\n    fib_gen = _fibonacci_generator()\n\n    while True:\n        fib_num = next(fib_gen)\n        if _is_prime(fib_num):\n            prime_count += 1\n            if prime_count == n:\n                return fib_num"}
