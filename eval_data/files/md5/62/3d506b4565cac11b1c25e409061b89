{"task_id": "HumanEval/80", "solution": "def is_happy(s):\n    \"\"\"Checks if a string is happy. A string is happy if its length is at least 3\n    and every 3 consecutive letters are distinct.\n    \"\"\"\n    if len(s) < 3:\n        return False\n\n    for i in range(len(s) - 2):\n        if len(set([s[i], s[i+1], s[i+2]])) < 3:\n            return False\n            \n    return True"}
{"task_id": "HumanEval/82", "solution": "def prime_length(string):\n    \"\"\"Write a function that takes a string and returns True if the string\n    length is a prime number or False otherwise\n    \"\"\"\n    n = len(string)\n\n    if n <= 1:\n        return False\n    if n <= 3:  # 2 and 3 are prime\n        return True\n    if n % 2 == 0 or n % 3 == 0:\n        return False\n\n    i = 5\n    while i * i <= n:\n        if n % i == 0 or n % (i + 2) == 0:\n            return False\n        i += 6\n    return True"}
{"task_id": "HumanEval/81", "solution": "def numerical_letter_grade(grades):\n    \"\"\"It is the last week of the semester and the teacher has to give the grades\n    to students. The teacher has been making her own algorithm for grading.\n    The only problem is, she has lost the code she used for grading.\n    She has given you a list of GPAs for some students and you have to write \n    a function that can output a list of letter grades using the following table:\n             GPA       |    Letter grade\n              4.0                A+\n            > 3.7                A \n            > 3.3                A- \n            > 3.0                B+\n            > 2.7                B \n            > 2.3                B-\n            > 2.0                C+\n            > 1.7                C\n            > 1.3                C-\n            > 1.0                D+ \n            > 0.7                D \n            > 0.0                D-\n              0.0                E\n    \n\n    Example:\n    grade_equation([4.0, 3, 1.7, 2, 3.5]) ==> ['A+', 'B', 'C-', 'C', 'A-']\n    \"\"\"\n    result = []\n    for gpa in grades:\n        if gpa == 4.0:\n            result.append('A+')\n        elif gpa > 3.7:\n            result.append('A')\n        elif gpa > 3.3:\n            result.append('A-')\n        elif gpa > 3.0:\n            result.append('B+')\n        elif gpa > 2.7:\n            result.append('B')\n        elif gpa > 2.3:\n            result.append('B-')\n        elif gpa > 2.0:\n            result.append('C+')\n        elif gpa > 1.7:\n            result.append('C')\n        elif gpa > 1.3:\n            result.append('C-')\n        elif gpa > 1.0:\n            result.append('D+')\n        elif gpa > 0.7:\n            result.append('D')\n        elif gpa > 0.0:\n            result.append('D-')\n        elif gpa == 0.0:\n            result.append('E')\n    return result"}
{"task_id": "HumanEval/83", "solution": "class Number:\n    \"\"\"Represents an n\u2011digit number with flags indicating whether it starts or ends with 1.\"\"\"\n    def __init__(self, length: int, starts_with_one: bool, ends_with_one: bool):\n        self.length = length\n        self.startsWithOne = starts_with_one\n        self.endsWithOne = ends_with_one\n\n\nclass StartsOneEnds:\n    \"\"\"Provides the counting logic for numbers that start or end with 1.\"\"\"\n    @staticmethod\n    def count(n: int) -> int:\n        if n == 1:\n            return 1\n        # Calculate count of n-digit numbers starting with 1.\n        start_count = 10 ** (n - 1)\n        # Calculate count of n-digit numbers ending with 1.\n        end_count = 9 * (10 ** (n - 2))\n        # Calculate overlap (numbers starting AND ending with 1).\n        overlap = 10 ** (n - 2)\n        return start_count + end_count - overlap\n\n\ndef starts_one_ends(n):\n    \"\"\"\n    Given a positive integer n, return the count of the numbers of n-digit\n    positive integers that start or end with 1.\n    \"\"\"\n    return StartsOneEnds.count(n)"}
{"task_id": "HumanEval/85", "solution": "from typing import List\n\ndef add(lst: List[int]) -> int:\n    \"\"\"Given a non-empty list of integers lst. add the even elements that are at odd indices..\n\n    Raises ValueError if the input list is empty.\n    \"\"\"\n    if not lst:\n        raise ValueError(\"Input list must be non\u2011empty\")\n\n    odd_index_evens = [x for i, x in enumerate(lst) if i % 2 == 1 and x % 2 == 0]\n    return sum(odd_index_evens)"}
{"task_id": "HumanEval/84", "solution": "class InputNumber:\n    def __init__(self, value):\n        self.value = value\n\n    def is_valid(self) -> bool:\n        return isinstance(self.value, int) and 0 <= self.value <= 10000\n\nclass DigitSumCalculator:\n    def calculate(self, value: int) -> int:\n        return sum(int(d) for d in str(value))\n\nclass BinaryConverter:\n    def to_binary(self, number: int) -> str:\n        return bin(number)[2:]\n\nclass OutputString:\n    def __init__(self, value: str):\n        self.value = value\n\ndef solve(N):\n    \"\"\"Return binary string of the sum of decimal digits of N.\"\"\"\n    input_obj = InputNumber(N)\n    if not input_obj.is_valid():\n        raise ValueError(f\"N must be between 0 and 10000, got {N}\")\n\n    sum_calc = DigitSumCalculator()\n    digit_sum = sum_calc.calculate(input_obj.value)\n\n    converter = BinaryConverter()\n    binary_str = converter.to_binary(digit_sum)\n\n    output = OutputString(binary_str)\n    return output.value"}
{"task_id": "HumanEval/86", "solution": "from typing import List\n\ndef anti_shuffle(s: str) -> str:\n    \"\"\"\n    Write a function that takes a string and returns an ordered version of it.\n    Ordered version of string, is a string where all words (separated by space)\n    are replaced by a new word where all the characters arranged in\n    ascending order based on ascii value.\n    Note: You should keep the order of words and blank spaces in the sentence.\n    \"\"\"\n    tokens: List[str] = []\n    current_word: List[str] = []\n\n    for char in s:\n        if char.isspace():\n            if current_word:\n                tokens.append(''.join(current_word))\n                current_word = []\n            tokens.append(char)\n        else:\n            current_word.append(char)\n\n    if current_word:\n        tokens.append(''.join(current_word))\n\n    processed_tokens = []\n    for token in tokens:\n        if token.isspace():\n            processed_tokens.append(token)\n        else:\n            processed_tokens.append(''.join(sorted(token)))\n\n    return ''.join(processed_tokens)"}
{"task_id": "HumanEval/87", "solution": "from typing import List, Tuple\n\ndef get_row(lst: List[List[int]], x: int) -> List[Tuple[int, int]]:\n    \"\"\"\n    Find all occurrences of integer `x` in a jagged list `lst` and return\n    a list of zero\u2011based coordinates sorted by row ascending and column\n    descending.\n    \"\"\"\n    coordinates: List[Tuple[int, int]] = []\n\n    for r, row in enumerate(lst):\n        for c, value in enumerate(row):\n            if value == x:\n                coordinates.append((r, c))\n\n    coordinates.sort(key=lambda t: (t[0], -t[1]))\n    return coordinates"}
{"task_id": "HumanEval/88", "solution": "from typing import List\n\ndef sort_array(array: List[int]) -> List[int]:\n    \"\"\"\n    Returns a sorted copy of the input array, with sort order determined by the parity\n    of the sum of its first and last elements.\n    \"\"\"\n    if len(array) <= 1:\n        return array.copy()\n\n    # Determine if the sum of the first and last elements is odd or even\n    sum_first_last = array[0] + array[-1]\n    is_odd_sum = (sum_first_last % 2 != 0)\n\n    # Create a copy to avoid modifying the original array\n    sorted_copy = array.copy()\n\n    # Sort based on the parity\n    if is_odd_sum:\n        sorted_copy.sort(reverse=False)  # Ascending order\n    else:\n        sorted_copy.sort(reverse=True)   # Descending order\n\n    return sorted_copy"}
{"task_id": "HumanEval/89", "solution": "def encrypt(s):\n    \"\"\"Create a function encrypt that takes a string as an argument and\n    returns a string encrypted with the alphabet being rotated. \n    The alphabet should be rotated in a manner such that the letters \n    shift down by two multiplied to two places.\n    For example:\n    encrypt('hi') returns 'lm'\n    encrypt('asdfghjkl') returns 'ewhjklnop'\n    encrypt('gf') returns 'kj'\n    encrypt('et') returns 'ix'\n    \"\"\"\n    result = []\n    shift_amount = 4  # two multiplied to two places = 2 * 2 = 4\n\n    for char in s:\n        if 'a' <= char <= 'z':\n            # Handle lowercase letters, wrapping around 'z' to 'a'\n            start_ascii = ord('a')\n            shifted_ascii_pos = (ord(char) - start_ascii + shift_amount) % 26\n            result.append(chr(start_ascii + shifted_ascii_pos))\n        elif 'A' <= char <= 'Z':\n            # Handle uppercase letters, wrapping around 'Z' to 'A'\n            start_ascii = ord('A')\n            shifted_ascii_pos = (ord(char) - start_ascii + shift_amount) % 26\n            result.append(chr(start_ascii + shifted_ascii_pos))\n        else:\n            # Non-alphabetic characters remain unchanged\n            result.append(char)\n            \n    return \"\".join(result)"}
{"task_id": "HumanEval/90", "solution": "from typing import List, Optional\n\ndef next_smallest(lst: List[int]) -> Optional[int]:\n    \"\"\"\n    Returns the second smallest distinct element in the list.\n    Returns None if there are fewer than two distinct elements.\n    \"\"\"\n    if not lst:\n        return None\n\n    min_val = None\n    second_min = None\n\n    for num in lst:\n        if min_val is None or num < min_val:\n            # Current num is the new smallest. The old min_val (if not None) becomes second_min.\n            if min_val is not None:\n                second_min = min_val\n            min_val = num\n        elif num != min_val:\n            # Current num is not the smallest, but could be the second smallest.\n            if second_min is None or num < second_min:\n                second_min = num\n\n    return second_min"}
{"task_id": "HumanEval/91", "solution": "def is_bored(S):\n    \"\"\"\n    Counts the number of sentences that start with the word \"I\".\n    Sentences are delimited by '.', '?' or '!'.\n    \"\"\"\n    boredom_count = 0\n    \n    # Replace all sentence delimiters with a unique temporary character.\n    # This prepares the string for splitting into sentence parts.\n    temp_delimiter = '\\0' # A null character is unlikely to be in regular text input\n    s_modified = S.replace('.', temp_delimiter).replace('?', temp_delimiter).replace('!', temp_delimiter)\n    \n    # Split the modified string by the temporary delimiter to get potential sentence fragments.\n    sentence_parts = s_modified.split(temp_delimiter)\n    \n    for part in sentence_parts:\n        # Clean up each part by stripping leading/trailing whitespace.\n        sentence_text = part.strip()\n        \n        # Skip empty strings that might result from splitting (e.g., multiple delimiters \"!!\").\n        if not sentence_text:\n            continue\n        \n        # Extract the first word of the cleaned sentence.\n        # .split() without arguments splits by any whitespace and removes empty strings,\n        # maxsplit=1 ensures we only get the first word and the rest of the sentence.\n        words = sentence_text.split(maxsplit=1)\n        \n        # Check if there's a first word and if it is exactly \"I\".\n        if words and words[0] == \"I\":\n            boredom_count += 1\n            \n    return boredom_count"}
{"task_id": "HumanEval/92", "solution": "def any_int(x, y, z):\n    \"\"\"\n    Returns True if one input equals the sum of the other two and all are integers.\n    Returns False otherwise; raises TypeError if any input is non-numeric.\n    \"\"\"\n    # Validate numeric types\n    if not all(isinstance(v, (int, float)) for v in (x, y, z)):\n        raise TypeError(\"All inputs must be numeric.\")\n    # Ensure all are integers\n    if not all(isinstance(v, int) for v in (x, y, z)):\n        return False\n    # Check sum condition\n    return (x == y + z) or (y == x + z) or (z == x + y)"}
{"task_id": "HumanEval/93", "solution": "def encode(message):\n    \"\"\"\n    Encodes a message by swapping case of all letters and replacing vowels \n    with the letter that appears 2 places ahead in the English alphabet.\n    \"\"\"\n    encoded_chars = []\n    vowels = {'a', 'e', 'i', 'o', 'u'}\n\n    for char in message:\n        if char.isalpha():\n            char_lower = char.lower()\n            if char_lower in vowels:\n                # Replace vowel with letter 2 places ahead and then swap its case\n                replaced_char = chr(ord(char) + 2)\n                encoded_chars.append(replaced_char.swapcase())\n            else:\n                # Not a vowel, just swap case\n                encoded_chars.append(char.swapcase())\n        else:\n            # Not an alphabet character, append as is\n            encoded_chars.append(char)\n            \n    return \"\".join(encoded_chars)"}
{"task_id": "HumanEval/94", "solution": "def skjkasdkd(lst):\n    \"\"\"You are given a list of integers.\n    You need to find the largest prime value and return the sum of its digits.\n    \"\"\"\n\n    def is_prime(n):\n        \"\"\"Checks if a number is prime.\"\"\"\n        if n <= 1:\n            return False\n        if n <= 3:\n            return True\n        if n % 2 == 0 or n % 3 == 0:\n            return False\n        i = 5\n        while i * i <= n:\n            if n % i == 0 or n % (i + 2) == 0:\n                return False\n            i += 6\n        return True\n\n    def sum_digits(n):\n        \"\"\"Calculates the sum of the digits of a number.\"\"\"\n        s = 0\n        while n > 0:\n            s += n % 10\n            n //= 10\n        return s\n\n    largest_prime = 0\n\n    for num in lst:\n        if is_prime(num):\n            if num > largest_prime:\n                largest_prime = num\n    \n    if largest_prime == 0:\n        return 0\n    else:\n        return sum_digits(largest_prime)"}
{"task_id": "HumanEval/95", "solution": "def check_dict_case(dict):\n    \"\"\"\n    Checks if all keys are strings and are uniformly lower case or upper case.\n    Returns False if the dictionary is empty or keys are mixed case.\n    \"\"\"\n    if not dict:\n        return False\n\n    has_lower = False\n    has_upper = False\n\n    for key in dict.keys():\n        if not isinstance(key, str):\n            return False\n        \n        if key.islower():\n            has_lower = True\n        elif key.isupper():\n            has_upper = True\n        else:\n            # Key is neither purely lower nor purely upper (e.g., \"Name\", \"123\")\n            return False\n            \n    # Returns True if exactly one of has_lower or has_upper is true, indicating uniformity.\n    # Returns False if both are true (mixed case across keys) or both are false (should be caught by previous check).\n    return has_lower != has_upper"}
{"task_id": "HumanEval/96", "solution": "def count_up_to(n):\n    \"\"\"Returns a list of prime numbers less than n.\"\"\"\n    if n <= 2:\n        return []\n\n    is_prime = [True] * n\n    is_prime[0] = False\n    is_prime[1] = False\n\n    # Start checking from 2 up to sqrt(n-1)\n    # The loop condition p * p < n is sufficient\n    p = 2\n    while p * p < n:\n        if is_prime[p]:\n            # Mark all multiples of p as not prime\n            for multiple in range(p * p, n, p):\n                is_prime[multiple] = False\n        p += 1\n\n    primes = []\n    # Collect all numbers i for which is_prime[i] is True\n    for i in range(n):\n        if is_prime[i]:\n            primes.append(i)\n\n    return primes"}
{"task_id": "HumanEval/97", "solution": "def multiply(a, b):\n    \"\"\"Complete the function that takes two integers and returns \n    the product of their unit digits.\n    Assume the input is always valid.\n    Examples:\n    multiply(148, 412) should return 16.\n    multiply(19, 28) should return 72.\n    multiply(2020, 1851) should return 0.\n    multiply(14,-15) should return 20.\n    \"\"\"\n    unit_digit_a = abs(a % 10)\n    unit_digit_b = abs(b % 10)\n    return unit_digit_a * unit_digit_b"}
