{"task_id": "HumanEval/61", "solution": "def correct_bracketing(brackets: str):\n    \"\"\" brackets is a string of \"(\" and \")\".\n    return True if every opening bracket has a corresponding closing bracket.\n    \"\"\"\n    balance = 0\n    for char in brackets:\n        if char == '(':\n            balance += 1\n        elif char == ')':\n            balance -= 1\n        if balance < 0:\n            return False\n    return balance == 0"}
{"task_id": "HumanEval/62", "solution": "class Polynomial:\n    def __init__(self, coefficients: list):\n        \"\"\"Initializes a Polynomial with a list of coefficients.\"\"\"\n        self.coefficients = coefficients\n\n    def get_coefficients(self) -> list:\n        \"\"\"Returns the coefficients of the polynomial.\"\"\"\n        return self.coefficients\n\n    def derivative(self) -> 'Polynomial':\n        \"\"\"Computes the derivative of this polynomial using DerivativeCalculator.\"\"\"\n        return DerivativeCalculator.compute(self)\n\nclass DerivativeCalculator:\n    @staticmethod\n    def compute(p: Polynomial) -> Polynomial:\n        \"\"\"Calculates the derivative of a Polynomial object.\"\"\"\n        new_coefficients = []\n        # The derivative of c * x^i is i * c * x^(i-1).\n        # We iterate from the second coefficient (index 1) which corresponds to x^1.\n        for i in range(1, len(p.coefficients)):\n            new_coefficients.append(i * p.coefficients[i])\n        \n        return Polynomial(new_coefficients)\n\ndef derivative(xs: list):\n    \"\"\" xs represent coefficients of a polynomial.\n    xs[0] + xs[1] * x + xs[2] * x^2 + ....\n     Return derivative of this polynomial in the same form.\n    >>> derivative([3, 1, 2, 4, 5])\n    [1, 4, 12, 20]\n    >>> derivative([1, 2, 3])\n    [2, 6]\n    \"\"\"\n    poly = Polynomial(xs)\n    derived_poly = poly.derivative()\n    return derived_poly.get_coefficients()"}
{"task_id": "HumanEval/64", "solution": "def vowels_count(s):\n    \"\"\"Counts the number of vowels in a string, including 'y' when it's at the end.\"\"\"\n    vowel_count = 0\n    standard_vowels = {'a', 'e', 'i', 'o', 'u'}\n    \n    for i, char in enumerate(s):\n        lower_char = char.lower()\n        \n        if lower_char in standard_vowels:\n            vowel_count += 1\n        elif lower_char == 'y' and i == len(s) - 1:\n            vowel_count += 1\n            \n    return vowel_count"}
{"task_id": "HumanEval/63", "solution": "def fibfib(n: int):\n    \"\"\"Computes the n-th FibFib number using an iterative approach.\"\"\"\n    if n == 0:\n        return 0\n    if n == 1:\n        return 0\n    if n == 2:\n        return 1\n\n    # Initialize with base cases: fibfib(0), fibfib(1), fibfib(2)\n    a, b, c = 0, 0, 1\n\n    # Calculate fibfib(i) for i from 3 up to n\n    for _ in range(3, n + 1):\n        next_fib = a + b + c\n        a = b\n        b = c\n        c = next_fib\n    \n    return c"}
{"task_id": "HumanEval/65", "solution": "def circular_shift(x, shift):\n    \"\"\"Circular shift the digits of the integer x, shift the digits right by shift\n    and return the result as a string.\n    If shift > number of digits, return digits reversed.\n    \"\"\"\n    s = str(x)\n    n = len(s)\n\n    if shift > n:\n        # If shift > number of digits, return digits reversed.\n        return s[::-1]\n    elif shift == n or shift == 0:\n        # If shift equals the number of digits or is 0, return the original string.\n        return s\n    else:\n        # Perform a right circular shift for 0 < shift < n.\n        effective_shift = shift % n # Though shift < n, using modulo makes it robust for other interpretations of effective shift\n        return s[n - effective_shift:] + s[:n - effective_shift]"}
{"task_id": "HumanEval/66", "solution": "import dataclasses\nimport typing\n\n\n@dataclasses.dataclass(frozen=True)\nclass InputString:\n    value: str\n\n\n@dataclasses.dataclass(frozen=True)\nclass UppercaseLetter:\n    char: str\n    ascii: int\n\n\n@dataclasses.dataclass(frozen=True)\nclass SumResult:\n    total: int\n\n\ndef digitSum(s: str) -> int:\n    \"\"\"\n    Compute the sum of ASCII codes of all uppercase letters in `s`.\n    Returns 0 if no uppercase letters are found.\n    \"\"\"\n    input_str = InputString(s)\n    total = 0\n    for ch in input_str.value:\n        if 'A' <= ch <= 'Z':\n            total += ord(ch)\n    result = SumResult(total)\n    return result.total"}
{"task_id": "HumanEval/67", "solution": "import re\n\ndef fruit_distribution(s,n):\n    \"\"\"\n    Calculates the number of mango fruits based on the total fruits and a string\n    describing apples and oranges.\n    \"\"\"\n    \n    # Extract apples and oranges using regular expressions\n    apples_match = re.search(r\"(\\d+)\\s*apples\", s)\n    oranges_match = re.search(r\"(\\d+)\\s*oranges\", s)\n    \n    apples = int(apples_match.group(1)) if apples_match else 0\n    oranges = int(oranges_match.group(1)) if oranges_match else 0\n    \n    mangoes = n - apples - oranges\n    return mangoes"}
{"task_id": "HumanEval/68", "solution": "def pluck(arr):\n    \"\"\"\n    Finds the smallest even non-negative integer in an array and its first index.\n    Returns [value, index] or an empty list if no even values are found.\n    \"\"\"\n    min_even_val = None\n    min_even_idx = -1\n\n    for i, num in enumerate(arr):\n        if num % 2 == 0:  # Check if the number is even\n            if min_even_val is None or num < min_even_val:\n                min_even_val = num\n                min_even_idx = i\n    \n    if min_even_val is None:\n        return []\n    else:\n        return [min_even_val, min_even_idx]"}
{"task_id": "HumanEval/69", "solution": "import collections\n\ndef search(lst):\n    '''\n    You are given a non-empty list of positive integers. Return the greatest integer that is greater than \n    zero, and has a frequency greater than or equal to the value of the integer itself. \n    The frequency of an integer is the number of times it appears in the list.\n    If no such a value exist, return -1.\n    Examples:\n        search([4, 1, 2, 2, 3, 1]) == 2\n        search([1, 2, 2, 3, 3, 3, 4, 4, 4]) == 3\n        search([5, 5, 4, 4, 4]) == -1\n    '''\n    frequency_map = {}\n    for num in lst:\n        frequency_map[num] = frequency_map.get(num, 0) + 1\n\n    max_candidate = -1\n\n    for num, freq in frequency_map.items():\n        if freq >= num:\n            if num > max_candidate:\n                max_candidate = num\n\n    return max_candidate"}
{"task_id": "HumanEval/70", "solution": "def strange_sort_list(lst):\n    '''\n    Given list of integers, return list in strange order.\n    Strange sorting, is when you start with the minimum value,\n    then maximum of the remaining integers, then minimum and so on.\n    '''\n    sorted_copy = sorted(lst)\n    result = []\n    \n    left_ptr = 0\n    right_ptr = len(sorted_copy) - 1\n    is_min_turn = True\n    \n    while left_ptr <= right_ptr:\n        if is_min_turn:\n            result.append(sorted_copy[left_ptr])\n            left_ptr += 1\n        else:\n            result.append(sorted_copy[right_ptr])\n            right_ptr -= 1\n        is_min_turn = not is_min_turn\n        \n    return result"}
{"task_id": "HumanEval/71", "solution": "import math\n\ndef triangle_area(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle. Return the area of\n    the triangle rounded to 2 decimal points if the three sides form a valid triangle. \n    Otherwise return -1\n    Three sides make a valid triangle when the sum of any two sides is greater \n    than the third side.\n    '''\n    # Sides must be positive and satisfy the triangle inequality\n    if not (a > 0 and b > 0 and c > 0 and\n            a + b > c and a + c > b and b + c > a):\n        return -1\n    \n    # Calculate the semi-perimeter\n    s = (a + b + c) / 2\n    \n    # Calculate the area using Heron's formula\n    area = math.sqrt(s * (s - a) * (s - b) * (s - c))\n    \n    # Round the area to 2 decimal points\n    return round(area, 2)"}
{"task_id": "HumanEval/72", "solution": "def will_it_fly(q,w):\n    is_balanced = True\n    n = len(q)\n    for i in range(n // 2):\n        if q[i] != q[n - 1 - i]:\n            is_balanced = False\n            break\n\n    total_weight = sum(q)\n\n    return is_balanced and (total_weight <= w)"}
{"task_id": "HumanEval/73", "solution": "def smallest_change(arr):\n    \"\"\"\n    Given an array arr of integers, find the minimum number of elements that\n    need to be changed to make the array palindromic.\n    \"\"\"\n    n = len(arr)\n    if n <= 1:\n        return 0\n\n    changes = 0\n    left = 0\n    right = n - 1\n\n    while left < right:\n        if arr[left] != arr[right]:\n            changes += 1\n        left += 1\n        right -= 1\n\n    return changes"}
{"task_id": "HumanEval/74", "solution": "def total_match(lst1, lst2):\n    \"\"\"\n    Compares two lists of strings based on their total character count and returns the list with fewer characters.\n    If counts are equal, the first list is returned.\n    \"\"\"\n    total_chars_lst1 = sum(len(s) for s in lst1)\n    total_chars_lst2 = sum(len(s) for s in lst2)\n\n    if total_chars_lst1 <= total_chars_lst2:\n        return lst1\n    else:\n        return lst2"}
{"task_id": "HumanEval/75", "solution": "import math\n\ndef _is_prime(n):\n    \"\"\"Checks if a number is prime.\"\"\"\n    if n < 2:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n    for i in range(3, int(math.sqrt(n)) + 1, 2):\n        if n % i == 0:\n            return False\n    return True\n\ndef _prime_factors(n):\n    \"\"\"Returns a list of prime factors for a given number (with multiplicity).\"\"\"\n    factors = []\n    # Count the number of 2s that divide n\n    while n % 2 == 0:\n        factors.append(2)\n        n //= 2\n    # n must be odd at this point, so we can skip even numbers\n    i = 3\n    while i * i <= n:\n        while n % i == 0:\n            factors.append(i)\n            n //= i\n        i += 2\n    # If n is still greater than 1, it must be a prime factor itself\n    if n > 1:\n        factors.append(n)\n    return factors\n\ndef is_multiply_prime(a):\n    \"\"\"Checks if the number is the multiplication of 3 prime numbers.\n    Knowing that (a) is less then 100. \n    \"\"\"\n    factors = _prime_factors(a)\n    return len(factors) == 3"}
{"task_id": "HumanEval/76", "solution": "def is_simple_power(x, n):\n    \"\"\"Checks if x is a simple power of n.\n    This means n**k = x for some integer k.\n    \"\"\"\n    if n == 1:\n        return x == 1\n    if x == 1:\n        return True\n    if x < n:\n        return False\n    \n    current_power = n\n    while current_power < x:\n        current_power *= n\n    \n    return current_power == x"}
{"task_id": "HumanEval/77", "solution": "def iscube(a):\n    '''\n    Checks if an integer is a perfect cube.\n    Uses floating-point cube root and rounds to the nearest integer for verification.\n    '''\n    if a == 0:\n        return True\n\n    abs_a = abs(a)\n    # Calculate the cube root using floating-point math and round to the nearest integer.\n    root = round(pow(abs_a, 1/3))\n\n    # Verify if the cubed root matches the absolute input value.\n    return root * root * root == abs_a"}
{"task_id": "HumanEval/78", "solution": "def hex_key(num):\n    \"\"\"Counts the number of prime hexadecimal digits in a given string.\n    Prime hexadecimal digits are 2, 3, 5, 7, B, D.\n    \"\"\"\n    prime_hex_digits = {'2', '3', '5', '7', 'B', 'D'}\n    count = 0\n    for char_digit in num:\n        if char_digit in prime_hex_digits:\n            count += 1\n    return count"}
