en a list of numbers, return the sum of squares of the numbers\n    in the list that are odd. Ignore numbers that are negative or not integers.\n    '''\n\n    def _is_integer(num):\n        # Checks if a value is an integer or a float representing a whole number.\n        return isinstance(num, int) or (isinstance(num, float) and num.is_integer())\n\n    def _is_positive(num):\n        # Checks if a given number is greater than zero.\n        return num > 0\n\n    def _is_odd(num):\n        # Checks if a given integer (or integer-like float) is odd.\n        return int(num) % 2 != 0\n\n    def _get_square(num):\n        # Calculates the square of a given number, returning an integer.\n        return int(num) * int(num)\n\n    total_sum = 0\n    for x in lst:\n        if _is_integer(x) and _is_positive(x) and _is_odd(x):\n            total_sum += _get_square(x)\n\n    return total_sum", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[[1.0, 3.5, -4.6]]]}, {"task_id": "HumanEval/151", "solution": "class Number:\n    def __init__(self, value):\n        self.value = value\n\n    def is_negative(self):\n        return self.value < 0\n\n    def is_integer(self):\n        return isinstance(self.value, int) or (isinstance(self.value, float) and self.value.is_integer())\nclass Integer(Number):\n    def is_odd(self):\n        return self.value % 2 != 0\nclass OddNumber(Integer):\n    def square(self):\n        return self.value * self.value\ndef double_the_difference(lst):\n    '''\n    Given a list of numbers, return the sum of squares of the numbers\n    in the list that are odd. Ignore numbers that are negative or not integers.\n\n    double_the_difference([1, 3, 2, 0]) == 1 + 9 + 0 + 0 = 10\n    double_the_difference([-1, -2, 0]) == 0\n    double_the_difference([9, -2]) == 81\n    double_the_difference([0]) == 0\n\n    If the input list is empty, return 0.\n    '''\n    total_sum = 0\n    if not lst:\n        return 0\n\n    for item in lst:\n        num_obj = Number(item)\n\n        if num_obj.is_negative():\n            continue\n\n        if not num_obj.is_integer():\n            continue\n\n        int_obj = Integer(item)\n\n        if not int_obj.is_odd():\n            continue\n\n        odd_obj = OddNumber(item)\n        total_sum += odd_obj.square()\n\n    return total_sum", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[[1.0, 3.5, -4.6]]]}], "HumanEval/152": [{"task_id": "HumanEval/152", "solution": "def compare(game,guess):\\", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/152", "solution": "def compare(game,guess):\n    \"\"\"\n    Compares two arrays of scores and guesses of equal length.\n    Returns an array of the same length denoting how far off each guess was.\n    \"\"\"\n    if len(game) != len(guess):\n        raise ValueError(\"Input arrays 'game' and 'guess' must be of equal length.\")\n\n    differences = []\n    for i in range(len(game)):\n        if game[i] == guess[i]:\n            differences.append(0)\n        else:\n            differences.append(abs(game[i] - guess[i]))\n\n    return differences", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/153": [{"task_id": "HumanEval/153", "solution": "def Strongest_Extension(class_name, extensions):\n    \"\"\"You will be given the name of a class (a string) and a list of extensions.\n    The extensions are to be used to load additional classes to the class. The\n    strength of the extension is as follows: Let CAP be the number of the uppercase\n    letters in the extension's name, and let SM be the number of lowercase letters\n    in the extension's name, the strength is given by the fraction CAP - SM.\n    You should find the strongest extension and return a string in this\n    format: ClassName.StrongestExtensionName.\n    If there are two or more extensions with the same strength, you should\n    choose the one that comes first in the list.\n    For example, if you are given \"Slices\" as the class and a list of the\n    extensions: ['SErviNGSliCes', 'Cheese', 'StuFfed'] then you should\n    return 'Slices.SErviNGSliCes' since 'SErviNGSliCes' is the strongest extension\n    (its strength is -1).\n    Example:\n    for Strongest_Extension('my_class', ['AA', 'Be', 'CC']) == 'my_class.AA'\n    \"\"\"\n\n    def _calculate_extension_strength(extension_name: str) -> int:\n        \"\"\"Calculates the strength of an extension name based on its uppercase and lowercase letters.\"\"\"\n        cap_count = 0\n        sm_count = 0\n        for char in extension_name:\n            if char.isupper():\n                cap_count += 1\n            elif char.islower():\n                sm_count += 1\n        return cap_count - sm_count\n\n    strongest_extension_name = extensions[0]\n    max_strength = _calculate_extension_strength(extensions[0])\n\n    for i in range(1, len(extensions)):\n        current_extension = extensions[i]\n        current_strength = _calculate_extension_strength(current_extension)\n\n        # Update strongest extension if current is strictly stronger.\n        # If strengths are equal, the first one encountered (strongest_extension_name) is kept.\n        if current_strength > max_strength:\n            max_strength = current_strength\n            strongest_extension_name = current_extension\n\n    return f\"{class_name}.{strongest_extension_name}\"", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/153", "solution": "def Strongest_Extension(class_name, extensions):\n    \"\"\"\n    Finds the strongest extension based on the difference between uppercase and lowercase letters.\n    Returns the class name concatenated with the strongest extension name.\n    \"\"\"\n\n    def _count_capital_letters(s: str) -> int:\n        \"\"\"Counts t