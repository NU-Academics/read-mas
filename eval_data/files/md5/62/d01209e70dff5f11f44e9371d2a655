:\n                    count += 1\n\n    return count", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/147", "solution": "def _generate_array_a(n):\n    \"\"\"\n    Generates the integer array a of length n where a[idx] = (idx+1)*(idx+1) - (idx+1) + 1.\n    \"\"\"\n    a = []\n    for idx in range(n):\n        i = idx + 1\n        a.append(i * i - i + 1)\n    return a\ndef _is_multiple_of_3(value):\n    \"\"\"\n    Checks if a given integer value is a multiple of 3.\n    \"\"\"\n    return value % 3 == 0\ndef get_max_triples(n):\n    \"\"\"\n    You are given a positive integer n. You have to create an integer array a of length n.\n        For each i (1 \u2264 i \u2264 n), the value of a[i] = i * i - i + 1.\n        Return the number of triples (a[i], a[j], a[k]) of a where i < j < k,\n    and a[i] + a[j] + a[k] is a multiple of 3.\n\n    Example :\n        Input: n = 5\n        Output: 1\n        Explanation:\n        a = [1, 3, 7, 13, 21]\n        The only valid triple is (1, 7, 13).\n    \"\"\"\n    if n < 3: # Not possible to form a triple if n is less than 3\n        return 0\n\n    a = _generate_array_a(n)\n\n    valid_triples_count = 0\n    num_elements = len(a)\n\n    for i in range(num_elements - 2):\n        for j in range(i + 1, num_elements - 1):\n            for k in range(j + 1, num_elements):\n                current_sum = a[i] + a[j] + a[k]\n                if _is_multiple_of_3(current_sum):\n                    valid_triples_count += 1\n\n    return valid_triples_count", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/139": [{"task_id": "HumanEval/139", "solution": "def special_factorial(n):\n    \"\"\"The Brazilian factorial is defined as:\n    brazilian_factorial(n) = n! * (n-1)! * (n-2)! * ... * 1!\n\n    The function receives an integer n and returns its special factorial,\n    raising ValueError if n is not a positive integer.\n    \"\"\"\n    def _factorial(k):\n        \"\"\"Calculates the standard factorial of a non-negative integer k.\"\"\"\n        if k < 0:\n            raise ValueError(\"Input to _factorial must be non-negative\")\n        if k == 0 or k == 1:\n            return 1\n        product = 1\n        for i in range(2, k + 1):\n            product *= i\n        return product\n\n    if n <= 0:\n        raise ValueError(\"Input n must be a positive integer\")\n\n    special_product = 1\n    for i in range(1, n + 1):\n        special_product *= _factorial(i)\n\n    return special_product", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/139", "solution": "def _calculate_factorial(k):\n    \"\"\"Calculates the standard factorial of a non-negative integer k.\"\"\"\n    if k == 0:\n        return 1\n    product = 1\n    for i in range(1, k + 1):\n        product *= i\n    return product\ndef special_factorial(n):\n    \"\"\"The Brazilian factorial is defined as:\n    brazilian_factorial(n) = n! * (n-1)! * (n-2)! * ... * 1!\n    where n > 0\n\n    For example:\n    >>> special_factorial(4)\n    288\n\n    The function will receive an integer as input and should return the special\n    factorial of this integer.\n    \"\"\"\n    brazilian_factorial_result = 1\n    for k in range(n, 0, -1):\n        brazilian_factorial_result *= _calculate_factorial(k)\n    return brazilian_factorial_result", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}]}}