e sorted by decimal value.\n    \"\"\"\n\n    def _count_set_bits(n):\n        # Counts the number of set bits (1s) in the binary representation of n.\n        return bin(n).count('1')\n\n    def _is_non_negative(n):\n        # Checks if an integer is non-negative.\n        return n >= 0\n\n    non_negative_nums = []\n    negative_nums = []\n\n    for num in arr:\n        if _is_non_negative(num):\n            non_negative_nums.append(num)\n        else:\n            negative_nums.append(num)\n\n    # Sort non-negative numbers: primary by bit count, secondary by decimal value.\n    non_negative_nums.sort(key=lambda x: (_count_set_bits(x), x))\n\n    # Sort negative numbers: by decimal value (default list sort is ascending).\n    negative_nums.sort()\n\n    # Combine sorted lists, with negative numbers preceding non-negative numbers.\n    return negative_nums + non_negative_nums", "base_status": "fail", "plus_status": "pass", "base_fail_tests": [[[-2, -3, -4, -5, -6]]], "plus_fail_tests": []}, {"task_id": "HumanEval/116", "solution": "def sort_array(arr):\n    \"\"\"\n    In this Kata, you have to sort an array of non-negative integers according to\n    number of ones in their binary representation in ascending order.\n    For similar number of ones, sort based on decimal value.\n\n    It must be implemented like this:\n    >>> sort_array([1, 5, 2, 3, 4]) == [1, 2, 3, 4, 5]\n    >>> sort_array([-2, -3, -4, -5, -6]) == [-6, -5, -4, -3, -2]\n    >>> sort_array([1, 0, 2, 3, 4]) [0, 1, 2, 3, 4]\n    \"\"\"\n    def custom_sort_key(n):\n        if n < 0:\n            return (0, n, n)  # Group negatives first, sort numerically\n        else:\n            # Group non-negatives second, sort by bit count then by decimal value\n            return (1, bin(n).count('1'), n)\n\n    return sorted(arr, key=custom_sort_key)", "base_status": "fail", "plus_status": "pass", "base_fail_tests": [[[-2, -3, -4, -5, -6]]], "plus_fail_tests": []}], "HumanEval/119": [{"task_id": "HumanEval/11