rn []\n\n    words = _parse_words(s)\n    result = []\n    for word in words:\n        if _count_consonants(word) == n:\n            result.append(word)\n    return result", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/117", "solution": "def select_words(s, n):\n    \"\"\"Given a string s and a natural number n, returns a list of words from s that contain exactly n consonants.\"\"\"\n\n    # Define VOWELS set as specified in design context (constants.py)\n    VOWELS = {'a', 'e', 'i', 'o', 'u'}\n\n    def _is_consonant(char):\n        \"\"\"Determines if a single character is a consonant, case-insensitively.\"\"\"\n        char_lower = char.lower()\n        return char_lower.isalpha() and char_lower not in VOWELS\n\n    def _count_consonants(word):\n        \"\"\"Counts the number of consonants in a given word.\"\"\"\n        count = 0\n        for char in word:\n            if _is_consonant(char):\n                count += 1\n        return count\n\n    def _split_into_words(text):\n        \"\"\"Splits an input string into a list of words, handling multiple spaces.\"\"\"\n        return [word for word in text.split(' ') if word]\n\n    if not s:\n        return []\n\n    result_list = []\n    words = _split_into_words(s)\n    for word in words:\n        if _count_consonants(word) == n:\n            result_list.append(word)\n\n    return result_list", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/118": [{"task_id": "HumanEval/118", "solution": "def get_closest_vowel(word):\n    \"\"\"Finds the closest vowel that stands between two consonants from the right side of the word.\n    Returns an empty string if no qualifying vowel is found.\n    \"\"\"\n    VOWELS = {'a', 'e', 'i', 'o', 'u', 'A', 'E', 'I', 'O', 'U'}\n\n    def _is_vowel(char):\n        return char in VOWELS\n\n    def _is_consonant(char):\n        # Assumes input is a single En