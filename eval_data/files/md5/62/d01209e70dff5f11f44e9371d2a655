ort re\nclass Sentence:\n    \"\"\"\n    Represents a single sentence and provides methods to analyze its content.\n    \"\"\"\n    def __init__(self, text: str):\n        self.text = text\n\n    def starts_with_i(self) -> bool:\n        \"\"\"\n        Checks if the sentence starts with the word \"I\" (case-insensitive).\n        \"\"\"\n        trimmed_text = self.text.strip()\n        if not trimmed_text:\n            return False\n\n        first_word = trimmed_text.split(maxsplit=1)[0]\n        return first_word.lower() == \"i\"\nclass SentenceParser:\n    \"\"\"\n    Handles the logic of splitting a given text into individual sentences.\n    \"\"\"\n    def __init__(self, delimiters: str = \".?!\"):\n        # The pattern splits by any of the delimiter characters.\n        # It's a raw string to handle backslashes correctly in regex.\n        self._delimiters_pattern = r'[' + re.escape(delimiters) + r']'\n\n    def parse(self, text: str) -> list[Sentence]:\n        \"\"\"\n        Splits the input text into a list of Sentence objects.\n        \"\"\"\n        # Split by the delimiters, which removes them from the resulting segments.\n        # Filter out any empty strings that might result from splitting (e.g., if text starts or ends with a delimiter).\n        sentence_texts = [s.strip() for s in re.split(self._delimiters_pattern, text) if s.strip()]\n        return [Sentence(s) for s in sentence_texts]\ndef is_bored(S):\n    \"\"\"\n    Counts the number of \"boredoms\" in a string. A boredom is a sentence that starts with \"I\".\n    Sentences are delimited by '.', '?' or '!'.\n    \"\"\"\n    boredom_count = 0\n    parser = SentenceParser()\n    sentences = parser.parse(S)\n\n    for sentence in sentences:\n        if sentence.starts_with_i():\n            boredom_count += 1\n\n    return boredom_count", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [["I"]]}, {"task_id": "HumanEval/91", "solution": "def is_bored(S):\n    \"\"\"\n    Counts the number of sentences that start with the word \"I\".\n    Sentences are delimited by '.', '?' or '!'.\n    \"\"\"\n    boredom_count = 0\n    # Replace all sentence delimiters with a common one (e.g., '.') for consistent splitting.\n    temp_s = S.replace('?', '.').replace('!', '.')\n\n    # Split the string into potential sentence fragments.\n    sentences = temp_s.split('.')\n\n    for sentence in sentences:\n        # Clean up whitespace for accurate checking.\n        trimmed_sentence = sentence.strip()\n\n        # Check if the sentence starts with \"I \" or is just \"I\".\n        if trimmed_sentence.startswith(\"I \") or trimmed_sentence == \"I\":\n            boredom_count += 1\n\n    return boredom_count", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [["I"]]}], "HumanEval/93": [{"task_id": "HumanEval/93", "solution": "def encode(message):\n    \"\"\"\n    Encodes a message by swapping letter cases and replacing vowels.\n    \"\"\"\n    vowel_map = {\n        'a': 'c', 'e': 'g', 'i': 'k', 'o': 'q', 'u': 'w',\n        'A': 'C', 'E': 'G', 'I': 'K', 'O': 'Q', 'U': 'W'\n    }\n\n    encoded_chars = []\n    for char in message:\n        # First, swap the case of the character\n        swapped_char = char.swapcase()\n\n        # Then, check if the case-swapped character is a vowel and replace if necessary\n        if swapped_char in vowel_map:\n            encoded_chars.append(vowel_map[swapped_char])\n        else:\n            encoded_chars.append(swapped_char)\n\n    return \"\".join(encoded_chars)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/93", "solution": "def encode(message):\n    \"\"\"\n    Encodes a message by swapping case of consonants and replacing vowels\n    with the letter two places ahead in the alphabet, preserving case.\n    \"\"\"\n    VOWELS = \"aeiouAEIOU\"\n    LOWER_ALPHABET = \"abcdefghijklmnopqr