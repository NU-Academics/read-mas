49": [{"task_id": "HumanEval/149", "solution": "def sorted_list_sum(lst):\n    \"\"\"Write a function that accepts a list of strings as a parameter,\n    deletes the strings that have odd lengths from it,\n    and returns the resulted list with a sorted order.\n    \"\"\"\n    even_length_strings = []\n    for s in lst:\n        if len(s) % 2 == 0:\n            even_length_strings.append(s)\n\n    # Sort primarily by length, secondarily by alphabetical order\n    even_length_strings.sort(key=lambda s: (len(s), s))\n\n    return even_length_strings", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/149", "solution": "def sorted_list_sum(lst):\n    \"\"\"Filters a list of strings, removing odd-length words, then sorts the remaining even-length words.\n    Sorting is primarily by length (ascending), then alphabetically (ascending) for words of the same length.\n    \"\"\"\n\n    class String:\n        \"\"\"Encapsulates a string value and its length, providing methods for length checks and comparison.\"\"\"\n        def __init__(self, value: str):\n            self._value = value\n            self._length = len(value)\n\n        def get_value(self) -> str:\n            return self._value\n\n        def get_length(self) -> int:\n            return self._length\n\n        def is_length_odd(self) -> bool:\n            return self._length % 2 != 0\n\n        def __lt__(self, other: 'String') -> bool:\n            if self._length != other._length:\n                return self._length < other._length\n            return self._value < other._value\n\n        def __eq__(self, other: object) -> bool:\n            if not isinstance(other, String):\n                return NotImplemented\n            return self._value == other._value\n\n        def __repr__(self) -> str:\n            return f\"String('{self._value}')\"\n\n    class StringList:\n        \"\"\"Manages a collection of String objects, providing immutable filtering and sorting operations.\"\"\"\n        def __init__(self, string_values: list[str]):\n            self._strings = [String(s) for s in string_values]\n\n        @classmethod\n        def _from_string_objects(cls, string_objects: list['String']) -> 'StringList':\n            \"\"\"Internal constructor to create StringList from existing String objects.\"\"\"\n            instance = cls([])\n            instance._strings = string_objects\n            return instance\n\n        def filter_odd_length_strings(self) -> 'StringList':\n            \"\"\"Returns a new StringList containing only even-length strings.\"\"\"\n            filtered_strings = [s for s in self._strings if not s.is_length_odd()]\n            return StringList._from_string_objects(filtered_strings)\n\n        def sort_strings(self) -> 'StringList':\n            \"\"\"Returns a new StringList sorted by length then alphabetically.\"\"\"\n            sorted_strings = sorted(self._strings)\n            return StringList._from_string_objects(sorted_strings)\n\n        def get_raw_strings(self) -> list[str]:\n            \"\"\"Returns the list of raw string values from the contained String objects.\"\"\"\n            return [s.get_value() for s in self._strings]\n\n        def __repr__(self) -> str:\n            return f\"StringList({[s.get_value() for s in self._strings]})\"\n\n    initial_string_list = StringList(lst)\n    filtered_list = initial_string_list.filter_odd_length_strings()\n    sorted_list = filtered_list.sort_strings()\n    return sorted_list.get_raw_strings()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/150": [{"task_id": "HumanEval/150", "solution": "def x_or_y(n, x, y):\n    \"\"\"A simple program which should return the value of x if n is\n    a prime number and should return the value of y otherwise.\n    \"\"\"\n    import math\n\n    if n <= 1:\n        return y\n    if n == 2:\n        return x\n    if n % 2 ==