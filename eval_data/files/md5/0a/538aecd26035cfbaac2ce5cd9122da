{"task_id": "HumanEval/36", "solution": "```python\ndef fizz_buzz(n: int):\n    \"\"\"Return the number of times the digit 7 appears in integers less than n which are divisible by 11 or 13.\n    >>> fizz_buzz(50)\n    0\n    >>> fizz_buzz(78)\n    2\n    >>> fizz_buzz(79)\n    3\n    \"\"\"\n    total_sevens_count = 0\n    for i in range(1, n):\n        # Check if the number is divisible by 11 or 13.\n        if (i % 11 == 0) or (i % 13 == 0):\n            # Convert the number to a string and count occurrences of '7'.\n            total_sevens_count += str(i).count('7')\n    return total_sevens_count\n```"}
{"task_id": "HumanEval/37", "solution": "```python\ndef sort_even(l: list):\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the odd indicies, while its values at the even indicies are equal\n    to the values of the even indicies of l, but sorted.\n    \"\"\"\n\n    if not l:\n        return []\n\n    # Extract elements at even indices\n    even_elements = [l[i] for i in range(0, len(l), 2)]\n    # Sort these extracted elements\n    even_elements.sort()\n\n    # Create a shallow copy of the original list to store the result\n    result = l[:]\n\n    # Place the sorted even elements back into their even positions in the result list\n    even_idx_counter = 0\n    for i in range(0, len(l), 2):\n        result[i] = even_elements[even_idx_counter]\n        even_idx_counter += 1\n\n    return result\n```"}
{"task_id": "HumanEval/39", "solution": "```python\ndef prime_fib(n: int):\n    \"\"\"\n    prime_fib returns n-th number that is a Fibonacci number and it's also prime.\n    \"\"\"\n    import math\n    from typing import Iterator\n\n    def _is_prime(num: int) -> bool:\n        if num < 2:\n            return False\n        for i in range(2, int(math.sqrt(num)) + 1):\n            if num % i == 0:\n                return False\n        return True\n\n    def _generate_fibonacci() -> Iterator[int]:\n        a, b = 0, 1\n        yield b\n        a, b = b, a + b\n        yield b\n        while True:\n            a, b = b, a + b\n            yield b\n\n    fib_generator = _generate_fibonacci()\n    prime_count = 0\n    for fib_num in fib_generator:\n        if _is_prime(fib_num):\n            prime_count += 1\n            if prime_count == n:\n                return fib_num\n```"}
{"task_id": "HumanEval/38", "solution": "def decode_cyclic(s: str):\n    \"\"\"\n    Decodes a string by reversing the cyclic shift within groups of three characters.\n    \"\"\"\n    # Split string into groups of length 3, as done during encoding.\n    groups = [s[(3 * i):min((3 * i + 3), len(s))] for i in range((len(s) + 2) // 3)]\n\n    # Reverse the cyclic shift for groups of three characters.\n    # If a group 'abc' was encoded to 'bca' (group[1:] + group[0]),\n    # then 'bca' decodes to 'abc' (group[-1] + group[:-1]).\n    decoded_groups = [(group[-1] + group[:-1]) if len(group) == 3 else group for group in groups]\n\n    return \"\".join(decoded_groups)"}
