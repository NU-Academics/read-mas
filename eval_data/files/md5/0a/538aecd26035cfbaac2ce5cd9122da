{"task_id": "HumanEval/73", "solution": "```python\ndef smallest_change(arr):\n    \"\"\"\n    Given an array arr of integers, find the minimum number of elements that\n    need to be changed to make the array palindromic. A palindromic array is an array that\n    is read the same backwards and forwards. In one change, you can change one element to any other element.\n\n    For example:\n    smallest_change([1,2,3,5,4,7,9,6]) == 4\n    smallest_change([1, 2, 3, 4, 3, 2, 2]) == 1\n    smallest_change([1, 2, 3, 2, 1]) == 0\n    \"\"\"\n    changes = 0\n    left = 0\n    right = len(arr) - 1\n\n    while left < right:\n        if arr[left] != arr[right]:\n            changes += 1\n        left += 1\n        right -= 1\n    return changes\n```"}
{"task_id": "HumanEval/74", "solution": "```python\ndef total_match(lst1, lst2):\n    '''\n    Write a function that accepts two lists of strings and returns the list that has\n    total number of chars in the all strings of the list less than the other list.\n\n    if the two lists have the same number of chars, return the first list.\n    '''\n    def _calculate_total_chars(str_list):\n        \"\"\"Calculates the total number of characters across all strings in a list.\"\"\"\n        return sum(len(s) for s in str_list)\n\n    count1 = _calculate_total_chars(lst1)\n    count2 = _calculate_total_chars(lst2)\n\n    if count1 <= count2:\n        return lst1\n    else:\n        return lst2\n```"}
{"task_id": "HumanEval/77", "solution": "```python\ndef iscube(a):\n    '''\n    Checks if an integer `a` is a perfect cube.\n    This handles positive, negative, and zero inputs using floating-point cube root and rounding.\n    '''\n    if a == 0:\n        return True\n\n    # Calculate the absolute cube root and round to the nearest integer.\n    # This approach handles potential floating-point inaccuracies by checking the cubed result.\n    cbrt = round(abs(a)**(1/3))\n\n    if a > 0:\n        return cbrt * cbrt * cbrt == a\n    else: # a < 0\n        return -cbrt * cbrt * cbrt == a\n```"}
{"task_id": "HumanEval/75", "solution": "```python\ndef _is_prime(n: int) -> bool:\n    \"\"\"Checks if a number is prime.\"\"\"\n    if n < 2:\n        return False\n    for i in range(2, int(n**0.5) + 1):\n        if n % i == 0:\n            return False\n    return True\n\ndef _get_primes_up_to(limit: int) -> list[int]:\n    \"\"\"Generates a list of all prime numbers up to and including the limit.\"\"\"\n    primes = []\n    for num in range(2, limit + 1):\n        if _is_prime(num):\n            primes.append(num)\n    return primes\n\ndef is_multiply_prime(a):\n    \"\"\"\n    Write a function that returns true if the given number is the multiplication of 3 prime numbers\n    and false otherwise.\n    Knowing that (a) is less then 100.\n    Example:\n    is_multiply_prime(30) == True\n    30 = 2 * 3 * 5\n    \"\"\"\n    if a < 30:  # The smallest product of 3 distinct primes is 2 * 3 * 5 = 30.\n        return False\n\n    primes = _get_primes_up_to(100) # Generate primes up to 100 as 'a' is less than 100.\n\n    n = len(primes)\n    for i in range(n):\n        p1 = primes[i]\n        if p1 * p1 * p1 > a: # Optimization: if p1 cubed is already greater than 'a', no need to continue.\n            break\n\n        for j in range(i + 1, n): # Ensure distinct primes (p2 > p1).\n            p2 = primes[j]\n            if p1 * p2 * p2 > a: # Optimization: if p1 * p2 * p2 is greater than 'a', no need to continue with current p1, p2.\n                break\n\n            for k in range(j + 1, n): # Ensure distinct primes (p3 > p2).\n                p3 = primes[k]\n                product = p1 * p2 * p3\n\n                if product == a:\n                    return True\n                if product > a: # Optimization: if product exceeds 'a', further products will also exceed.\n                    break # Move to next p2 (j loop).\n    return False\n```"}
{"task_id": "HumanEval/76", "solution": "```python\ndef is_simple_power(x, n):\n    \"\"\"Checks if x is a simple power of n (i.e., n**k = x for some non-negative integer k).\"\"\"\n    if x == 1:\n        return True\n\n    if x == 0:\n        return n == 0\n\n    if n == 0:\n        return False\n\n    if n == 1:\n        return False\n\n    if n < 0:\n        current_power = 1\n        while abs(current_power) < abs(x):\n            current_power *= n\n        return current_power == x\n\n    if x < 0:\n        return False\n\n    current_power = n\n    while current_power < x:\n        current_power *= n\n    return current_power == x\n```"}
