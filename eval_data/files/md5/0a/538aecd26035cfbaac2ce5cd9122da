{"task_id": "HumanEval/139", "solution": "```python\ndef special_factorial(n):\n    \"\"\"Calculates the Brazilian factorial: n! * (n-1)! * ... * 1!.\n    This function computes the product of factorials from 1! up to n!.\n    \"\"\"\n    def _calculate_single_factorial(k):\n        \"\"\"Calculates the factorial of a positive integer k.\"\"\"\n        result = 1\n        for i in range(1, k + 1):\n            result *= i\n        return result\n\n    special_factorial_result = 1\n    for i in range(1, n + 1):\n        single_factorial = _calculate_single_factorial(i)\n        special_factorial_result *= single_factorial\n    return special_factorial_result\n```"}
{"task_id": "HumanEval/137", "solution": "```python\ndef compare_one(a, b):\n    \"\"\"\n    Create a function that takes integers, floats, or strings representing\n    real numbers, and returns the larger variable in its given variable type.\n    Return None if the values are equal.\n    Note: If a real number is represented as a string, the floating point might be . or ,\n    \"\"\"\n    def _convert_to_float(value):\n        \"\"\"Converts an input value to a float for numerical comparison, handling comma decimals.\"\"\"\n        if isinstance(value, (int, float)):\n            return float(value)\n        elif isinstance(value, str):\n            normalized_value = value.replace(',', '.')\n            return float(normalized_value)\n\n    a_numeric = _convert_to_float(a)\n    b_numeric = _convert_to_float(b)\n\n    if a_numeric > b_numeric:\n        return a\n    elif b_numeric > a_numeric:\n        return b\n    else:\n        return None\n```"}
{"task_id": "HumanEval/140", "solution": "```python\ndef fix_spaces(text):\n    \"\"\"\n    Replaces sequences of 3 or more spaces with a hyphen, then replaces single spaces with underscores.\n    \"\"\"\n    import re\n\n    # First, replace sequences of 3 or more consecutive spaces with a single hyphen\n    # This takes precedence as per requirements\n    modified_text = re.sub(r' {3,}', '-', text)\n\n    # Then, replace any remaining single spaces (including those from original two-space sequences) with underscores\n    final_text = modified_text.replace(' ', '_')\n\n    return final_text\n```"}
{"task_id": "HumanEval/141", "solution": "```python\ndef file_name_check(file_name):\n    \"\"\"Create a function which takes a string representing a file's name, and returns\n    'Yes' if the the file's name is valid, and returns 'No' otherwise.\n    A file's name is considered to be valid if and only if all the following conditions\n    are met:\n    - There should not be more than three digits ('0'-'9') in the file's name.\n    - The file's name contains exactly one dot '.'\n    - The substring before the dot should not be empty, and it starts with a letter from\n    the latin alphapet ('a'-'z' and 'A'-'Z').\n    - The substring after the dot should be one of these: ['txt', 'exe', 'dll']\n    Examples:\n    file_name_check(\"example.txt\") # => 'Yes'\n    file_name_check(\"1example.dll\") # => 'No' (the name should start with a latin alphapet letter)\n    \"\"\"\n\n    # Condition 1: There should not be more than three digits\n    digit_count = 0\n    for char in file_name:\n        if '0' <= char <= '9':\n            digit_count += 1\n    if digit_count > 3:\n        return 'No'\n\n    # Condition 2: The file's name contains exactly one dot '.'\n    parts = file_name.split('.')\n    if len(parts) != 2:\n        return 'No'\n\n    prefix = parts[0]\n    suffix = parts[1]\n\n    # Condition 3: The substring before the dot should not be empty, and it starts with a letter\n    if not prefix:\n        return 'No'\n    if not ('a' <= prefix[0] <= 'z' or 'A' <= prefix[0] <= 'Z'):\n        return 'No'\n\n    # Condition 4: The substring after the dot should be one of these: ['txt', 'exe', 'dll']\n    allowed_extensions = ['txt', 'exe', 'dll']\n    if suffix not in allowed_extensions:\n        return 'No'\n\n    return 'Yes'\n```"}
{"task_id": "HumanEval/145", "solution": "```python\ndef order_by_points(nums):\n    \"\"\"\n    Sorts the given list of integers in ascending order according to the sum of their digits.\n    If sums are similar, order them based on their index in original list.\n    \"\"\"\n    def _calculate_sum_of_digits(number: int) -> int:\n        \"\"\"Calculates the sum of the absolute digits of a given integer.\"\"\"\n        s = 0\n        num_abs = abs(number)\n        if num_abs == 0:\n            return 0\n        while num_abs > 0:\n            s += num_abs % 10\n            num_abs //= 10\n        return s\n\n    if not nums:\n        return []\n\n    # Create a list of tuples: (sum_of_digits, original_index, number)\n    # This allows for stable sorting based on original_index for ties.\n    decorated_list = []\n    for i, num in enumerate(nums):\n        digit_sum = _calculate_sum_of_digits(num)\n        decorated_list.append((digit_sum, i, num))\n\n    # Sort the decorated list. Python's sort is stable, so original_index\n    # will naturally break ties if digit_sum is equal.\n    decorated_list.sort()\n\n    # Extract the original numbers in the sorted order\n    return [item[2] for item in decorated_list]\n```"}
{"task_id": "HumanEval/143", "solution": "```python\ndef words_in_sentence(sentence):\n    \"\"\"\n    Filters words from a sentence, keeping only those with prime lengths.\n    Maintains original word order and joins the result with spaces.\n    \"\"\"\n    def is_prime(n):\n        \"\"\"Checks if a given integer n is a prime number.\"\"\"\n        if n <= 1:\n            return False\n        if n == 2:\n            return True\n        if n % 2 == 0:\n            return False\n        i = 3\n        while i * i <= n:\n            if n % i == 0:\n                return False\n            i += 2\n        return True\n\n    words = sentence.split()\n    filtered_words = []\n\n    for word in words:\n        if is_prime(len(word)):\n            filtered_words.append(word)\n\n    return \" \".join(filtered_words)\n```"}
{"task_id": "HumanEval/142", "solution": "```python\ndef sum_squares(lst):\n    \"\"\"\"\n    This function will take a list of integers. For all entries in the list, the function shall square the integer entry if its index is a\n    multiple of 3 and will cube the integer entry if its index is a multiple of 4 and not a multiple of 3. The function will not\n    change the entries in the list whose indexes are not a multiple of 3 or 4. The function shall then return the sum of all entries.\n\n    Examples:\n    For lst = [1,2,3] the output should be 6\n    For lst = []  the output should be 0\n    For lst = [-1,-5,2,-1,-5]  the output should be -126\n    \"\"\"\n    processed_elements = []\n    for i, num in enumerate(lst):\n        if i % 3 == 0:\n            processed_elements.append(num * num)\n        elif i % 4 == 0:\n            processed_elements.append(num * num * num)\n        else:\n            processed_elements.append(num)\n    return sum(processed_elements)\n```"}
{"task_id": "HumanEval/144", "solution": "```python\ndef simplify(x, n):\n    \"\"\"Your task is to implement a function that will simplify the expression\n    x * n. The function returns True if x * n evaluates to a whole number and False\n    otherwise. Both x and n, are string representation of a fraction, and have the following format,\n    <numerator>/<denominator> where both numerator and denominator are positive whole numbers.\n    \"\"\"\n\n    class Fraction:\n        \"\"\"Represents a mathematical fraction with a numerator and a denominator.\"\"\"\n        def __init__(self, numerator: int, denominator: int):\n            self._numerator = numerator\n            self._denominator = denominator\n\n        def get_numerator(self) -> int:\n            return self._numerator\n\n        def get_denominator(self) -> int:\n            return self._denominator\n\n        def __eq__(self, other) -> bool:\n            if not isinstance(other, Fraction):\n                return NotImplemented\n            return self._numerator == other._numerator and self._denominator == other._denominator\n\n        def __repr__(self) -> str:\n            return f\"Fraction({self._numerator}, {self._denominator})\"\n\n    class FractionService:\n        \"\"\"Encapsulates business logic for fraction operations.\"\"\"\n        def parse_fraction(self, fraction_str: str) -> Fraction:\n            parts = fraction_str.split('/')\n            numerator = int(parts[0])\n            denominator = int(parts[1])\n            return Fraction(numerator, denominator)\n\n        def multiply_fractions(self, f1: Fraction, f2: Fraction) -> Fraction:\n            new_numerator = f1.get_numerator() * f2.get_numerator()\n            new_denominator = f1.get_denominator() * f2.get_denominator()\n            return Fraction(new_numerator, new_denominator)\n\n        def is_whole_number(self, f: Fraction) -> bool:\n            return f.get_numerator() % f.get_denominator() == 0\n\n    fraction_service = FractionService()\n\n    fraction_x = fraction_service.parse_fraction(x)\n    fraction_n = fraction_service.parse_fraction(n)\n\n    product_fraction = fraction_service.multiply_fractions(fraction_x, fraction_n)\n\n    return fraction_service.is_whole_number(product_fraction)\n```"}
{"task_id": "HumanEval/149", "solution": "```python\ndef sorted_list_sum(lst):\n    \"\"\"\n    Filters a list of strings to include only those with even lengths,\n    then sorts them first by length (ascending) and then alphabetically (ascending).\n    \"\"\"\n    even_length_strings = [s for s in lst if len(s) % 2 == 0]\n    sorted_list = sorted(even_length_strings, key=lambda s: (len(s), s))\n    return sorted_list\n```"}
{"task_id": "HumanEval/147", "solution": "```python\ndef get_max_triples(n):\n    \"\"\"\n    Calculates the number of triples (a[i], a[j], a[k]) from an array a where i < j < k,\n    and a[i] + a[j] + a[k] is a multiple of 3. The array a is generated such that a[i] = i * i - i + 1.\n    \"\"\"\n    arr = []\n    for i in range(1, n + 1):\n        arr.append(i * i - i + 1)\n\n    count = 0\n    length = len(arr)\n    if length < 3:\n        return 0\n\n    remainders = [0, 0, 0]\n    for x in arr:\n        remainders[x % 3] += 1\n\n    rem0 = remainders[0]\n    rem1 = remainders[1]\n    rem2 = remainders[2]\n\n    # Case 1: (0, 0, 0)\n    count += (rem0 * (rem0 - 1) * (rem0 - 2)) // 6\n    # Case 2: (1, 1, 1)\n    count += (rem1 * (rem1 - 1) * (rem1 - 2)) // 6\n    # Case 3: (2, 2, 2)\n    count += (rem2 * (rem2 - 1) * (rem2 - 2)) // 6\n    # Case 4: (0, 1, 2)\n    count += rem0 * rem1 * rem2\n\n    return count\n```"}
{"task_id": "HumanEval/151", "solution": "```python\ndef double_the_difference(lst):\n    '''\n    Given a list of numbers, return the sum of squares of the numbers\n    in the list that are odd. Ignore numbers that are negative or not integers.\n\n    double_the_difference([1, 3, 2, 0]) == 1 + 9 + 0 + 0 = 10\n    double_the_difference([-1, -2, 0]) == 0\n    double_the_difference([9, -2]) == 81\n    double_the_difference([0]) == 0\n\n    If the input list is empty, return 0.\n    '''\n    total_sum = 0\n    if not lst:\n        return 0\n\n    for num in lst:\n        # Check if it's an integer\n        if isinstance(num, int):\n            # Check if it's positive and odd\n            if num > 0 and num % 2 != 0:\n                total_sum += num * num\n    return total_sum\n```"}
{"task_id": "HumanEval/150", "solution": "```python\nimport math\n\ndef x_or_y(n, x, y):\n    \"\"\"A simple program which should return the value of x if n is\n    a prime number and should return the value of y otherwise.\n    \"\"\"\n    # Primality test\n    if n <= 1:\n        is_prime = False\n    elif n == 2:\n        is_prime = True\n    elif n % 2 == 0:\n        is_prime = False\n    else:\n        is_prime = True\n        for i in range(3, int(math.sqrt(n)) + 1, 2):\n            if n % i == 0:\n                is_prime = False\n                break\n\n    if is_prime:\n        return x\n    else:\n        return y\n```"}
{"task_id": "HumanEval/148", "solution": "def bf(planet1, planet2):\n    '''\n    There are eight planets in our solar system: the closerst to the Sun\n    is Mercury, the next one is Venus, then Earth, Mars, Jupiter, Saturn,\n    Uranus, Neptune.\n    Write a function that takes two planet names as strings planet1 and planet2.\n    The function should return a tuple containing all planets whose orbits are\n    located between the orbit of planet1 and the orbit of planet2, sorted by\n    the proximity to the sun.\n    The function should return an empty tuple if planet1 or planet2\n    are not correct planet names.\n    Examples\n    bf(\"Jupiter\", \"Neptune\") ==> (\"Saturn\", \"Uranus\")\n    bf(\"Earth\", \"Mercury\") ==> (\"Venus\")\n    bf(\"Mercury\", \"Uranus\") ==> (\"Venus\", \"Earth\", \"Mars\", \"Jupiter\", \"Saturn\")\n    '''\n\n    class PlanetOrder:\n        _SOLAR_SYSTEM_PLANETS = (\n            \"Mercury\", \"Venus\", \"Earth\", \"Mars\",\n            \"Jupiter\", \"Saturn\", \"Uranus\", \"Neptune\"\n        )\n\n        def get_planet_index(self, planet_name):\n            try:\n                return self._SOLAR_SYSTEM_PLANETS.index(planet_name)\n            except ValueError:\n                return None\n\n        def get_planet_name_by_index(self, index):\n            if 0 <= index < len(self._SOLAR_SYSTEM_PLANETS):\n                return self._SOLAR_SYSTEM_PLANETS[index]\n            return None\n\n        def get_all_planets(self):\n            return self._SOLAR_SYSTEM_PLANETS\n\n    class PlanetService:\n        def __init__(self, planet_order_instance):\n            self._planet_order = planet_order_instance\n\n        def find_planets_between(self, planet1_name, planet2_name):\n            idx1 = self._planet_order.get_planet_index(planet1_name)\n            idx2 = self._planet_order.get_planet_index(planet2_name)\n\n            if idx1 is None or idx2 is None:\n                return ()\n\n            start_idx = min(idx1, idx2)\n            end_idx = max(idx1, idx2)\n\n            intermediate_planets = self._planet_order.get_all_planets()[start_idx + 1:end_idx]\n\n            return tuple(intermediate_planets)\n\n    planet_order_instance = PlanetOrder()\n    planet_service_instance = PlanetService(planet_order_instance=planet_order_instance)\n\n    return planet_service_instance.find_planets_between(planet1, planet2)"}
{"task_id": "HumanEval/152", "solution": "def compare(game,guess):\n    \"\"\"I think we all remember that feeling when the result of some long-awaited\n    event is finally known. The feelings and thoughts you have at that moment are\n    definitely worth noting down and comparing.\n    Your task is to determine if a person correctly guessed the results of a number of matches.\n    You are given two arrays of scores and guesses of equal length, where each index shows a match.\n    Return an array of the same length denoting how far off each guess was. If they have guessed correctly,\n    the value is 0, and if not, the value is the absolute difference between the guess and the score.\n\n\n    example:\n\n    compare([1,2,3,4,5,1],[1,2,3,4,2,-2]) -> [0,0,0,0,3,3]\n    compare([0,5,0,0,0,4],[4,1,1,0,0,-2]) -> [4,4,1,0,0,6]\n    \"\"\"\n    # Computes the absolute difference for each pair of scores.\n    # Assumes inputs are lists of equal length, as per problem description.\n    return [abs(g - b) for g, b in zip(game, guess)]"}
{"task_id": "HumanEval/153", "solution": "def Strongest_Extension(class_name, extensions):\n    \"\"\"\n    Finds the strongest extension based on the count of uppercase and lowercase letters.\n    The strength is calculated as (uppercase_count - lowercase_count).\n    In case of a tie, the extension that appears first in the list is chosen.\n    \"\"\"\n\n    # Assume extensions list is not empty and contains strings, as per problem constraints.\n    # Initialize with the first extension's strength and name.\n    first_ext_name = extensions[0]\n    cap_first = sum(1 for char in first_ext_name if char.isupper())\n    sm_first = sum(1 for char in first_ext_name if char.islower())\n\n    max_strength = cap_first - sm_first\n    strongest_extension_name = first_ext_name\n\n    # Iterate through the remaining extensions to find the strongest.\n    for i in range(1, len(extensions)):\n        current_ext_name = extensions[i]\n        cap_current = sum(1 for char in current_ext_name if char.isupper())\n        sm_current = sum(1 for char in current_ext_name if char.islower())\n        current_strength = cap_current - sm_current\n\n        # If a stronger extension is found, update the max strength and name.\n        # The tie-breaking rule (choose the first one encountered) is naturally\n        # handled by only updating when current_strength is strictly greater.\n        if current_strength > max_strength:\n            max_strength = current_strength\n            strongest_extension_name = current_ext_name\n\n    return f\"{class_name}.{strongest_extension_name}\""}
{"task_id": "HumanEval/155", "solution": "def even_odd_count(num):\n    \"\"\"Given an integer. return a tuple that has the number of even and odd digits respectively.\n\n     Example:\n        even_odd_count(-12) ==> (1, 1)\n        even_odd_count(123) ==> (1, 2)\n    \"\"\"\n    even_count = 0\n    odd_count = 0\n\n    # Handle zero specifically as per requirements\n    if num == 0:\n        return (1, 0)\n\n    # Convert the absolute value of the number to a string to iterate through digits.\n    # This also handles negative numbers by considering their absolute value.\n    abs_num_str = str(abs(num))\n\n    for digit_char in abs_num_str:\n        digit = int(digit_char)\n        if digit % 2 == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n\n    return (even_count, odd_count)"}
{"task_id": "HumanEval/156", "solution": "def int_to_mini_roman(number):\n    \"\"\"\n    Given a positive integer, obtain its roman numeral equivalent as a string,\n    and return it in lowercase.\n    Restrictions: 1 <= num <= 1000\n    \"\"\"\n    roman_map = [\n        (1000, 'M'), (900, 'CM'), (500, 'D'), (400, 'CD'),\n        (100, 'C'), (90, 'XC'), (50, 'L'), (40, 'XL'),\n        (10, 'X'), (9, 'IX'), (5, 'V'), (4, 'IV'), (1, 'I')\n    ]\n\n    result = []\n\n    for value, symbol in roman_map:\n        while number >= value:\n            result.append(symbol)\n            number -= value\n\n    return \"\".join(result).lower()"}
{"task_id": "HumanEval/154", "solution": "```python\ndef cycpattern_check(a , b):\n    \"\"\"Checks if the second word or any of its rotations is a substring in the first word.\"\"\"\n    # Handle empty string edge cases\n    if not b:\n        # An empty string is a substring of any string (including an empty string).\n        return True\n\n    if not a:\n        # If 'a' is empty and 'b' is not empty, 'b' cannot be a substring.\n        return False\n\n    # Helper function to generate all unique cyclic rotations of a string\n    def _generate_rotations(s: str) -> list[str]:\n        if not s:\n            return []\n\n        rotations = set()\n        n = len(s)\n        for i in range(n):\n            rotated_s = s[i:] + s[:i]\n            rotations.add(rotated_s)\n        return list(rotations)\n\n    # Generate all unique rotations of string b\n    rotations_of_b = _generate_rotations(b)\n\n    # Check if any rotation of b is a substring of a\n    for rotation in rotations_of_b:\n        if rotation in a:\n            return True\n\n    return False\n```"}
{"task_id": "HumanEval/159", "solution": "def eat(number, need, remaining):\n    \"\"\"\n    You're a hungry rabbit, and you already have eaten a certain number of carrots,\n    but now you need to eat more carrots to complete the day's meals.\n    you should return an array of [ total number of eaten carrots after your meals,\n                                    the number of carrots left after your meals ]\n    if there are not enough remaining carrots, you will eat all remaining carrots, but will still be hungry.\n\n    Example:\n    * eat(5, 6, 10) -> [11, 4]\n    * eat(4, 8, 9) -> [12, 1]\n    * eat(1, 10, 10) -> [11, 0]\n    * eat(2, 11, 5) -> [7, 0]\n\n    Variables:\n    @number : integer\n        the number of carrots that you have eaten.\n    @need : integer\n        the number of carrots that you need to eat.\n    @remaining : integer\n        the number of remaining carrots thet exist in stock\n\n    Constrain:\n    * 0 <= number <= 1000\n    * 0 <= need <= 1000\n    * 0 <= remaining <= 1000\n\n    Have fun :)\n    \"\"\"\n    carrots_eaten_from_stock = min(need, remaining)\n    total_carrots_eaten = number + carrots_eaten_from_stock\n    carrots_remaining_in_stock = remaining - carrots_eaten_from_stock\n\n    return [total_carrots_eaten, carrots_remaining_in_stock]"}
{"task_id": "HumanEval/158", "solution": "```python\ndef find_max(words):\n    \"\"\"Returns the word with the maximum number of unique characters.\n    If multiple strings tie, the lexicographically smallest one is returned.\n    \"\"\"\n    if not words:\n        return \"\"\n\n    max_unique_count = -1\n    result_word = \"\"\n\n    for word in words:\n        current_unique_count = len(set(word))\n\n        if current_unique_count > max_unique_count:\n            max_unique_count = current_unique_count\n            result_word = word\n        elif current_unique_count == max_unique_count:\n            if word < result_word:  # Lexicographical tie-breaking\n                result_word = word\n    return result_word\n```"}
{"task_id": "HumanEval/157", "solution": "```python\nimport math\n\ndef right_angle_triangle(a, b, c):\n    \"\"\"\n    Given the lengths of the three sides of a triangle. Return True if the three\n    sides form a right-angled triangle, False otherwise.\n    \"\"\"\n    # Sides must be positive to form a valid triangle.\n    if not (a > 0 and b > 0 and c > 0):\n        return False\n\n    # Calculate the squares of the side lengths.\n    a_squared = a * a\n    b_squared = b * b\n    c_squared = c * c\n\n    # Sort the squared sides to easily check the Pythagorean theorem (shortest_squared + middle_squared == longest_squared).\n    sides_squared = sorted([a_squared, b_squared, c_squared])\n\n    # Use a small relative tolerance for floating-point comparisons to account for precision errors.\n    EPSILON = 1e-9\n\n    # Check if the sum of the squares of the two shorter sides is approximately equal to the square of the longest side.\n    return math.isclose(sides_squared[0] + sides_squared[1], sides_squared[2], rel_tol=EPSILON)\n```"}
{"task_id": "HumanEval/161", "solution": "def solve(s):\n    \"\"\"Reverses the case of letters in a string, keeps non-letters as is.\n    If no letters are found, the entire string is reversed.\n    \"\"\"\n    has_letters = any(c.isalpha() for c in s)\n\n    if not has_letters:\n        return s[::-1]\n\n    result_chars = []\n    for char in s:\n        if char.isalpha():\n            if char.islower():\n                result_chars.append(char.upper())\n            else:\n                result_chars.append(char.lower())\n        else:\n            result_chars.append(char)\n    return \"\".join(result_chars)"}
