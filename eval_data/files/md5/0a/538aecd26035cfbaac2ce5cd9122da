{"task_id": "HumanEval/160", "solution": "```python\nimport operator\n\nclass InvalidExpressionError(Exception):\n    \"\"\"Custom exception for invalid algebraic expressions.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\n\nclass AlgebraEvaluator:\n    \"\"\"\n    Evaluates algebraic expressions given operators and operands, respecting precedence.\n    \"\"\"\n    _OPERATOR_MAP = {\n        '+': operator.add,\n        '-': operator.sub,\n        '*': operator.mul,\n        '//': operator.floordiv,\n        '**': operator.pow\n    }\n    _PRECEDENCE = {\n        '**': 3,\n        '*': 2, '//': 2,\n        '+': 1, '-': 1\n    }\n\n    def evaluate(self, operators: list[str], operands: list[int]) -> int:\n        \"\"\"\n        Evaluates the algebraic expression formed by interleaving operands and operators.\n        Assumes inputs conform to the problem statement's type and structure guarantees.\n        \"\"\"\n        if not operators:\n            return operands[0]\n\n        output_queue = []\n        operator_stack = []\n\n        operand_idx = 0\n        operator_idx = 0\n\n        output_queue.append(operands[operand_idx])\n        operand_idx += 1\n\n        while operator_idx < len(operators):\n            current_op = operators[operator_idx]\n            while (operator_stack and\n                   self._PRECEDENCE.get(current_op, 0) <= self._PRECEDENCE.get(operator_stack[-1], 0)):\n                output_queue.append(operator_stack.pop())\n            operator_stack.append(current_op)\n            output_queue.append(operands[operand_idx])\n            operand_idx += 1\n            operator_idx += 1\n\n        while operator_stack:\n            output_queue.append(operator_stack.pop())\n\n        eval_stack = []\n        for token in output_queue:\n            if isinstance(token, int):\n                eval_stack.append(token)\n            else:\n                if len(eval_stack) < 2:\n                    raise InvalidExpressionError(\"Malformed expression during RPN evaluation.\")\n                operand2 = eval_stack.pop()\n                operand1 = eval_stack.pop()\n                try:\n                    result = self._OPERATOR_MAP[token](operand1, operand2)\n                    eval_stack.append(result)\n                except ZeroDivisionError:\n                    raise InvalidExpressionError(\"Division by zero encountered.\")\n                except Exception as e:\n                    raise InvalidExpressionError(f\"Error during operation '{token}': {e}\")\n\n        if len(eval_stack) != 1:\n            raise InvalidExpressionError(\"Malformed expression: final stack size is not one.\")\n        return eval_stack[0]\n\ndef do_algebra(operator: list, operand: list):\n    \"\"\"\n    Evaluates an algebraic expression formed by interleaving operands and operators.\n    The function constructs the expression respecting standard mathematical precedence.\n    \"\"\"\n    evaluator = AlgebraEvaluator()\n    return evaluator.evaluate(operator, operand)\n```"}
{"task_id": "HumanEval/163", "solution": "class InvalidInputError(ValueError):\n    \"\"\"Custom exception for invalid input parameters.\"\"\"\n    pass\n\ndef generate_integers(a, b):\n    \"\"\"\n    Given two positive integers a and b, return the even digits between a\n    and b, in ascending order.\n\n    For example:\n    generate_integers(2, 8) => [2, 4, 6, 8]\n    generate_integers(8, 2) => [2, 4, 6, 8]\n    generate_integers(10, 14) => []\n    \"\"\"\n    if not isinstance(a, int) or not isinstance(b, int):\n        raise InvalidInputError(\"Inputs 'a' and 'b' must be integers.\")\n    if a <= 0 or b <= 0:\n        raise InvalidInputError(\"Inputs 'a' and 'b' must be positive integers.\")\n\n    min_val = min(a, b)\n    max_val = max(a, b)\n    even_digits = []\n\n    for num in range(min_val, max_val + 1):\n        if 0 <= num <= 9 and num % 2 == 0:\n            even_digits.append(num)\n\n    return even_digits"}
