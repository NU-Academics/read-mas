{"task_id": "Mbpp/607", "solution": "import re\nfrom typing import Optional, Tuple\ndef find_literals(text: str, pattern: str) -> Optional[Tuple[str, int, int]]:\n    \"\"\"Search for the first occurrence of a regex pattern in text.\n\n    Args:\n        text: The string to search within.\n        pattern: The regex pattern to compile and search for.\n\n    Returns:\n        A tuple of (matched substring, start index, end index) if a match is found;\n        otherwise ``None``.\n\n    Raises:\n        TypeError: If ``text`` or ``pattern`` is not a string.\n        ValueError: If the provided regex pattern is invalid.\n    \"\"\"\n    if not isinstance(text, str):\n        raise TypeError(f\"text must be a str, got {type(text).__name__}\")\n    if not isinstance(pattern, str):\n        raise TypeError(f\"pattern must be a str, got {type(pattern).__name__}\")\n\n    try:\n        compiled = re.compile(pattern)\n    except re.error as exc:\n        raise ValueError(f\"Invalid regex pattern: {exc}\") from exc\n\n    match = compiled.search(text)\n    if match is None:\n        return None\n\n    return (match.group(), match.start(), match.end())"}
{"task_id": "Mbpp/608", "solution": "def bell_number(n: int) -> int:\n    \"\"\"\n    Return the n-th Bell number B(n).\n\n    The Bell numbers count the partitions of a set of n elements.\n    This implementation uses the Bell Triangle (Sullivan's triangle)\n    algorithm, which guarantees exact integer results and runs in\n    O(n\u00b2) time and O(n) additional space.\n\n    Parameters\n    ----------\n    n : int\n        The index of the Bell number to compute. Must be a non\u2011negative\n        integer (0 \u2264 n \u2264 50).\n\n    Returns\n    -------\n    int\n        The exact integer Bell number B(n).\n\n    Raises\n    ------\n    TypeError\n        If n is not an integer.\n    ValueError\n        If n is negative.\n\n    Notes\n    -----\n    * Algorithm reference: https://en.wikipedia.org/wiki/Bell_number#Bell_triangle\n    * Complexity: time O(n\u00b2), space O(n).\n\n    Examples\n    --------\n    >>> bell_number(0)\n    1\n    >>> bell_number(1)\n    1\n    >>> bell_number(5)\n    52\n    >>> bell_number(10)\n    115975\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n    if n < 0:\n        raise ValueError(\"n must be non\u2011negative\")\n\n    if n == 0:\n        return 1\n\n    prev_row = [1]  # row 0\n    for i in range(1, n + 1):\n        current_row = [prev_row[-1]]  # first element of new row\n        for j in range(1, i + 1):\n            val = current_row[j - 1] + prev_row[j - 1]\n            current_row.append(val)\n        prev_row = current_row\n\n    return prev_row[0]  # B(n) is first element of the n-th row"}
{"task_id": "Mbpp/610", "solution": "from typing import List, Any\ndef remove_kth_element(items: List[Any], k: int) -> List[Any]:\n    \"\"\"\n    Return a new list with the element at index `k` removed from `items`.\n\n    Parameters\n    ----------\n    items : list\n        The input list from which to remove an element.\n    k : int\n        The 0\u2011based index of the element to remove.\n\n    Returns\n    -------\n    list\n        A new list containing all elements of `items` except the one at index `k`.\n\n    Raises\n    ------\n    TypeError\n        If `items` is not a list or `k` is not an int.\n    IndexError\n        If `k` is out of bounds for `items`.\n\n    Notes\n    -----\n    The function is pure and does not modify the input list.\n    \"\"\"\n    if not isinstance(items, list):\n        raise TypeError(f\"Expected 'items' to be a list, got {type(items).__name__}\")\n    if not isinstance(k, int):\n        raise TypeError(f\"Expected 'k' to be an int, got {type(k).__name__}\")\n\n    if k < 0 or k >= len(items):\n        raise IndexError(f\"Index {k} is out of bounds for list of length {len(items)}\")\n\n    return items[:k] + items[k+1:]"}
{"task_id": "Mbpp/611", "solution": "from typing import List, Optional\ndef max_of_nth(matrix: List[List[int]], n: int) -> int:\n    \"\"\"\n    Return the maximum integer in the nth column of a 2\u2011D list of integers.\n\n    Parameters\n    ----------\n    matrix : List[List[int]]\n        A non\u2011empty two\u2011dimensional list where each inner list represents a row.\n    n : int\n        Zero\u2011based index of the column to examine.\n\n    Returns\n    -------\n    int\n        The maximum value found in column ``n``.\n\n    Raises\n    ------\n    TypeError\n        If ``matrix`` is not a list of lists of integers or ``n`` is not an int.\n    ValueError\n        If ``matrix`` is empty or contains no rows.\n    IndexError\n        If any row is shorter than ``n + 1``.\n    \"\"\"\n    if not isinstance(matrix, list):\n        raise TypeError(\"matrix must be a list of lists of integers.\")\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer.\")\n    if len(matrix) == 0:\n        raise ValueError(\"matrix is empty.\")\n\n    max_val: Optional[int] = None\n    for row_index, row in enumerate(matrix):\n        if not isinstance(row, list):\n            raise TypeError(f\"Row {row_index} is not a list.\")\n        if len(row) <= n:\n            raise IndexError(f\"Column index {n} out of bounds for row {row_index}.\")\n        if not all(isinstance(item, int) for item in row):\n            raise TypeError(f\"Row {row_index} contains non\u2011integer elements.\")\n\n        current_val = row[n]\n        if max_val is None or current_val > max_val:\n            max_val = current_val\n\n    # At this point max_val cannot be None because at least one row exists\n    assert max_val is not None\n    return max_val"}
