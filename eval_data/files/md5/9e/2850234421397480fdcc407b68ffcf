{"task_id": "Mbpp/266", "solution": "def lateralsurface_cube(side_length: float) -> float:\n    \"\"\"\n    Calculate the lateral surface area of a cube.\n\n    Parameters\n    ----------\n    side_length : float\n        The length of one side of the cube. Must be non\u2011negative.\n\n    Returns\n    -------\n    float\n        The lateral surface area of the cube.\n\n    Raises\n    ------\n    ValueError\n        If side_length is negative.\n    \"\"\"\n    if side_length < 0:\n        raise ValueError(\"Side length must be non-negative.\")\n    return 4 * (side_length ** 2)"}
{"task_id": "Mbpp/267", "solution": "def square_Sum(n: int) -> int:\n    \"\"\"Computes the sum of the squares of the first n odd natural numbers.\"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n    if n < 0:\n        raise ValueError(\"n must be non\u2011negative\")\n    # Closed\u2011form formula: n(2n\u20111)(2n+1)/3\n    return n * (2 * n - 1) * (2 * n + 1) // 3"}
{"task_id": "Mbpp/268", "solution": "def find_star_num(n: int) -> int:\n    \"\"\"\n    Compute the nth star number.\n\n    A star number is a centered hexagonal number defined by\n    S_n = 6*n*(n - 1) + 1.\n\n    Parameters\n    ----------\n    n : int\n        The position (1-indexed) of the star number to compute.\n\n    Returns\n    -------\n    int\n        The nth star number.\n\n    Raises\n    ------\n    TypeError\n        If n is not an int.\n    ValueError\n        If n < 1.\n\n    Examples\n    --------\n    >>> find_star_num(1)\n    1\n    >>> find_star_num(2)\n    13\n    >>> find_star_num(3)\n    37\n    \"\"\"\n    _validate_input(n)\n    return 6 * n * (n - 1) + 1"}
{"task_id": "Mbpp/269", "solution": "def ascii_value(char: str) -> int:\n    \"\"\"\n    Return the ASCII integer value of a single character string.\n\n    Parameters\n    ----------\n    char : str\n        A single character string.\n\n    Returns\n    -------\n    int\n        ASCII code of the character.\n\n    Raises\n    ------\n    TypeError\n        If `char` is not a string.\n    ValueError\n        If `char` does not contain exactly one character.\n    \"\"\"\n    if not isinstance(char, str):\n        raise TypeError(\"Input must be a string.\")\n    if len(char) != 1:\n        raise ValueError(\"Input string must contain exactly one character.\")\n    return ord(char)"}
{"task_id": "Mbpp/270", "solution": "def sum_even_and_even_index(numbers):\n    \"\"\"\n    Return the sum of all even integers that are located at even indices in the list `numbers`.\n\n    Parameters\n    ----------\n    numbers : list[int]\n        List of integers.\n\n    Returns\n    -------\n    int\n        Sum of even numbers at even indices; 0 if the list is empty or no such elements exist.\n    \"\"\"\n    total_sum = 0\n    for i, value in enumerate(numbers):\n        if i % 2 == 0 and value % 2 == 0:\n            total_sum += value\n    return total_sum"}
{"task_id": "Mbpp/271", "solution": "def even_Power_Sum(n: int) -> int:\n    \"\"\"\n    Return the sum of the first *n* even natural numbers each raised to the fifth power.\n\n    Parameters\n    ----------\n    n : int\n        Positive integer specifying how many even numbers to include.\n\n    Returns\n    -------\n    int\n        The value of \u03a3_{k=1}^n (2k)^5.\n\n    Raises\n    ------\n    ValueError\n        If *n* is not a positive integer.\n\n    Examples\n    --------\n    >>> even_Power_Sum(1)\n    32\n    >>> even_Power_Sum(2)\n    1056\n    \"\"\"\n    _validate_input(n)\n    total = 0\n    for k in range(1, n + 1):\n        total += _compute_even_fifth(k)\n    return total\ndef _compute_even_fifth(k: int) -> int:\n    \"\"\"Compute (2*k)**5 efficiently.\"\"\"\n    even = 2 * k\n    return even ** 5"}
{"task_id": "Mbpp/272", "solution": "def rear_extract(tuples):\n    \"\"\"Extracts the last element from each tuple in a list.\n\n    Parameters\n    ----------\n    tuples : list[tuple]\n        A list where each element is a tuple with at least one item.\n\n    Returns\n    -------\n    list\n        A list containing the last element of each input tuple, preserving order.\n\n    Raises\n    ------\n    TypeError\n        If `tuples` is not a list, or any element is not a tuple,\n        or any tuple is empty.\n    \"\"\"\n    if not isinstance(tuples, list):\n        raise TypeError(\"`tuples` must be a list of tuples.\")\n    result = []\n    for i, t in enumerate(tuples):\n        if not isinstance(t, tuple):\n            raise TypeError(\"All elements must be tuples.\")\n        if not t:\n            raise TypeError(f\"Tuple at index {i} is empty.\")\n        result.append(t[-1])\n    return result"}
