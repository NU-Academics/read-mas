{"task_id": "Mbpp/477", "solution": "def is_lower(input_str: str) -> str:\n    \"\"\"Convert the provided string to lowercase.\n\n    Parameters\n    ----------\n    input_str : str\n        The string to be converted. Can be an empty string.\n\n    Returns\n    -------\n    str\n        The lowercase version of `input_str`.\n\n    Raises\n    ------\n    TypeError\n        If `input_str` is not a string.\n    ValueError\n        If an internal error occurs during conversion.\n\n    Examples\n    --------\n    >>> is_lower(\"Hello World!\")\n    'hello world!'\n    >>> is_lower(\"\")\n    ''\n\n    Notes\n    -----\n    - Uses Python's built\u2011in `str.lower()` for conversion.\n    - Handles Unicode characters according to the current locale.\n    \"\"\"\n    if not isinstance(input_str, str):\n        raise TypeError(f\"Input must be a string, got {type(input_str).__name__}\")\n    try:\n        return input_str.lower()\n    except Exception as exc:\n        raise ValueError(f\"Lowercase conversion failed: {exc}\") from exc"}
{"task_id": "Mbpp/478", "solution": "import string\nfrom typing import Final\ndef remove_lowercase(text: str) -> str:\n    \"\"\"\n    Return a new string with all ASCII lowercase letters removed.\n\n    Parameters\n    ----------\n    text : str\n        The input string to process.\n\n    Returns\n    -------\n    str\n        A new string with all lowercase ASCII letters removed.\n\n    Examples\n    --------\n    >>> remove_lowercase('Hello, World! 123')\n    'Hllo, Wold! 123'\n    >>> remove_lowercase('Python3.8')\n    'Pthon3.8'\n    >>> remove_lowercase('\u00a1Hola! \u00bfC\u00f3mo est\u00e1s?')\n    '\u00a1Hola! \u00bfC\u00f3mo est\u00e1s?'\n    \"\"\"\n    LOWERCASE_SET: Final[str] = string.ascii_lowercase\n    return \"\".join(ch for ch in text if ch not in LOWERCASE_SET)"}
{"task_id": "Mbpp/479", "solution": "def first_digit(number):\n    \"\"\"Return the first (most significant) decimal digit of an integer.\n\n    Parameters\n    ----------\n    number : int or float\n        Numeric value. Floats are accepted only if they represent an integer\n        (e.g., 123.0). Non\u2011numeric types or non\u2011integer floats raise ValueError.\n\n    Returns\n    -------\n    int\n        The first digit of the absolute value of the integer part of number.\n        For zero, returns 0.\n\n    Raises\n    ------\n    ValueError\n        If input is not numeric or is a non\u2011integer float.\n    \"\"\"\n    # 1. Type validation\n    if not isinstance(number, (int, float)):\n        raise ValueError(\"Input must be an integer or an integer-valued float.\")\n\n    # 2. Convert float to int if it represents an integer\n    if isinstance(number, float):\n        if not number.is_integer():\n            raise ValueError(\"Float input must represent an integer value.\")\n        number = int(number)\n\n    # 3. Handle negative numbers\n    number = abs(number)\n\n    # 4. Zero case\n    if number == 0:\n        return 0\n\n    # 5. Convert to string and extract first character\n    return int(str(number)[0])"}
{"task_id": "Mbpp/554", "solution": "from typing import List\ndef Split(input: List[int]) -> List[int]:\n    \"\"\"\n    Return a list of odd integers from the input list.\n\n    Parameters\n    ----------\n    input : List[int]\n        List of integers to filter.\n\n    Returns\n    -------\n    List[int]\n        List containing only the odd integers, preserving order.\n\n    Raises\n    ------\n    TypeError\n        If input is not a list or contains non\u2011integer elements.\n    \"\"\"\n    if not isinstance(input, list):\n        raise TypeError(\"Input must be a list of integers.\")\n    for elem in input:\n        if not isinstance(elem, int):\n            raise TypeError(\"All elements must be integers.\")\n    return [x for x in input if x % 2 != 0]"}
{"task_id": "Mbpp/555", "solution": "def difference(n: int) -> int:\n    \"\"\"Compute the difference between the sum of cubes and the sum of natural numbers\n    for the first n positive integers.\n\n    Parameters\n    ----------\n    n : int\n        The upper bound of the summation (must be non\u2011negative).\n\n    Returns\n    -------\n    int\n        \u03a3_{i=1}^n i^3  \u2013  \u03a3_{i=1}^n i\n\n    Raises\n    ------\n    ValueError\n        If n is negative.\n    \"\"\"\n    if n < 0:\n        raise ValueError(\"n must be non\u2011negative\")\n    sum_natural = n * (n + 1) // 2\n    sum_cubes = sum_natural ** 2\n    return sum_cubes - sum_natural"}
{"task_id": "Mbpp/556", "solution": "from typing import Iterable, Callable, Optional\ndef find_Odd_Pair(\n    nums: Iterable[int],\n    max_pairs: Optional[int] = None,\n    custom_predicate: Optional[Callable[[int, int], bool]] = None,\n) -> int:\n    \"\"\"\n    Count the number of unordered pairs in ``nums`` whose XOR result is odd.\n\n    Parameters\n    ----------\n    nums : Iterable[int]\n        Sequence of integers to process. It will not be modified.\n    max_pairs : Optional[int], default None\n        If supplied, the function will stop counting after reaching this many\n        qualifying pairs and return the threshold value.\n    custom_predicate : Optional[Callable[[int, int], bool]], default None\n        If provided, this predicate is applied to each unordered pair instead\n        of the default odd\u2011XOR test. The operation is O(n\u00b2) and is only\n        permitted for sequences with length <= 10,000 to avoid excessive\n        runtime.\n\n    Returns\n    -------\n    int\n        Number of qualifying pairs.\n\n    Raises\n    ------\n    TypeError\n        If ``nums`` is not an iterable of integers or if optional parameters are\n        of incorrect type.\n    ValueError\n        If ``custom_predicate`` is used with a large list (len > 10_000).\n    \"\"\"\n    # Input validation\n    if not hasattr(nums, \"__iter__\"):\n        raise TypeError(\"nums must be an iterable of integers\")\n    try:\n        nums = list(nums)  # materialize for length checks and reuse\n    except Exception as exc:\n        raise TypeError(\"nums must be an iterable of integers\") from exc\n\n    for n in nums:\n        if not isinstance(n, int):\n            raise TypeError(\"all elements in nums must be int\")\n\n    if max_pairs is not None and not isinstance(max_pairs, int):\n        raise TypeError(\"max_pairs must be an int or None\")\n    if custom_predicate is not None and not callable(custom_predicate):\n        raise TypeError(\"custom_predicate must be callable or None\")\n\n    # Early return for trivial cases\n    n_len = len(nums)\n    if n_len < 2:\n        return 0\n\n    # If custom_predicate is used, fall back to O(n\u00b2) algorithm\n    if custom_predicate is not None:\n        if n_len > 10_000:\n            raise ValueError(\n                \"custom_predicate with large list (len > 10,000) is not supported\"\n            )\n        count = 0\n        for i in range(n_len):\n            a = nums[i]\n            for j in range(i + 1, n_len):\n                if custom_predicate(a, nums[j]):\n                    count += 1\n                    if max_pairs is not None and count >= max_pairs:\n                        return max_pairs\n        return count\n\n    # Count evens and odds\n    evens = odds = 0\n    for value in nums:\n        if value & 1:\n            odds += 1\n        else:\n            evens += 1\n\n    result = evens * odds\n\n    if max_pairs is not None:\n        result = min(result, max_pairs)\n\n    return result"}
{"task_id": "Mbpp/557", "solution": "def toggle_string(input_str: str) -> str:\n    \"\"\"\n    Toggle the case of all alphabetic characters in the input string.\n\n    Parameters\n    ----------\n    input_str : str\n        The string to toggle.\n\n    Returns\n    -------\n    str\n        A new string with toggled case.\n\n    Examples\n    --------\n    >>> toggle_string('Hello World! 123')\n    'hELLO wORLD! 123'\n    \"\"\"\n    result = []\n    for c in input_str:\n        if c.islower():\n            result.append(c.upper())\n        elif c.isupper():\n            result.append(c.lower())\n        else:\n            result.append(c)\n    return ''.join(result)"}
{"task_id": "Mbpp/558", "solution": "from typing import Tuple\ndef _validate_inputs(a: int, b: int) -> Tuple[int, int]:\n    if not isinstance(a, int) or a < 0:\n        raise ValueError(\"First argument must be a non-negative integer\")\n    if not isinstance(b, int) or b < 0:\n        raise ValueError(\"Second argument must be a non-negative integer\")\n    return a, b\ndef _pad_numbers(a: int, b: int) -> Tuple[str, str]:\n    str_a, str_b = str(a), str(b)\n    max_len = max(len(str_a), len(str_b))\n    return str_a.zfill(max_len), str_b.zfill(max_len)\ndef _compute_difference(str_a: str, str_b: str) -> int:\n    total = 0\n    for da, db in zip(str_a, str_b):\n        total += abs(int(da) - int(db))\n    return total\ndef digit_distance_nums(a: int, b: int) -> int:\n    \"\"\"Compute the sum of absolute per\u2011digit differences between two non\u2011negative integers.\n\n    Parameters\n    ----------\n    a : int\n        First non\u2011negative integer.\n    b : int\n        Second non\u2011negative integer.\n\n    Returns\n    -------\n    int\n        Sum of the absolute differences of corresponding digits after zero\u2011padding.\n\n    Raises\n    ------\n    ValueError\n        If either input is negative or not an integer.\n    \"\"\"\n    a, b = _validate_inputs(a, b)\n    str_a, str_b = _pad_numbers(a, b)\n    return _compute_difference(str_a, str_b)"}
{"task_id": "Mbpp/559", "solution": "import logging\nfrom typing import List\n_logger = logging.getLogger(__name__)\ndef max_sub_array_sum(nums: List[int]) -> int:\n    \"\"\"\n    Compute the maximum sum of any contiguous sub\u2011list within ``nums``.\n\n    Parameters\n    ----------\n    nums : List[int]\n        List of integers representing the input sequence.\n\n    Returns\n    -------\n    int\n        The maximum contiguous sub\u2011array sum. If ``nums`` is empty,\n        returns 0. If all numbers are negative, returns the\n        largest (least negative) number.\n\n    Raises\n    ------\n    TypeError\n        If ``nums`` is not a list or contains non\u2011integer elements.\n    \"\"\"\n    # Input validation\n    if not isinstance(nums, list):\n        raise TypeError(\"Input must be a list of integers.\")\n    for i, val in enumerate(nums):\n        if not isinstance(val, int):\n            raise TypeError(\n                f\"All elements must be integers. \"\n                f\"Element at index {i} is of type {type(val).__name__}.\"\n            )\n\n    # Handle empty list\n    if not nums:\n        _logger.warning(\"Input list is empty; returning 0.\")\n        return 0\n\n    # Kadane's algorithm\n    max_current = max_global = nums[0]\n    for num in nums[1:]:\n        max_current = max(num, max_current + num)\n        if max_current > max_global:\n            max_global = max_current\n    return max_global"}
