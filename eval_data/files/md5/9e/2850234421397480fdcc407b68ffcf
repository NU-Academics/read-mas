{"task_id": "Mbpp/633", "solution": "from typing import List\ndef pair_xor_Sum(nums: List[int], n: int) -> int:\n    \"\"\"\n    Return the sum of XOR of all unordered pairs in `nums`.\n\n    Parameters\n    ----------\n    nums : List[int]\n        List of integers.\n    n : int\n        Length of `nums`. Must equal len(nums).\n\n    Returns\n    -------\n    int\n        Sum of XOR of all unordered pairs.\n\n    Raises\n    ------\n    TypeError\n        If inputs are not of expected types.\n    ValueError\n        If n does not equal len(nums).\n    \"\"\"\n    # Validation Layer\n    if not isinstance(nums, list) or any(not isinstance(x, int) for x in nums):\n        raise TypeError(\"nums must be a list of integers\")\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n    if n != len(nums):\n        raise ValueError(\"n must equal len(nums)\")\n\n    # Bit\u2011wise computation\n    total = 0\n    B = 64  # support up to 64\u2011bit integers\n    for b in range(B):\n        cnt = sum(((num >> b) & 1) for num in nums)\n        total += cnt * (n - cnt) * (1 << b)\n    return total"}
{"task_id": "Mbpp/635", "solution": "from typing import List\nclass _HeapHelper:\n    @staticmethod\n    def build_max_heap(arr: List[int]) -> None:\n        n = len(arr)\n        for i in range(n // 2 - 1, -1, -1):\n            _HeapHelper.heapify(arr, n, i)\n\n    @staticmethod\n    def heapify(arr: List[int], heap_size: int, i: int) -> None:\n        largest = i\n        left = 2 * i + 1\n        right = 2 * i + 2\n\n        if left < heap_size and arr[left] > arr[largest]:\n            largest = left\n        if right < heap_size and arr[right] > arr[largest]:\n            largest = right\n\n        if largest != i:\n            _HeapHelper.swap(arr, i, largest)\n            _HeapHelper.heapify(arr, heap_size, largest)\n\n    @staticmethod\n    def swap(arr: List[int], i: int, j: int) -> None:\n        arr[i], arr[j] = arr[j], arr[i]\ndef heap_sort(data: List[int]) -> List[int]:\n    \"\"\"Sort a list of integers in ascending order using the heap sort algorithm.\n    The original input list is not modified.\n    \"\"\"\n    if not isinstance(data, list):\n        raise TypeError(\"Input must be a list of integers.\")\n\n    for value in data:\n        if not isinstance(value, int):\n            raise TypeError(\"All elements must be integers.\")\n\n    if len(data) <= 1:\n        return data[:]\n\n    arr = data[:]\n    _HeapHelper.build_max_heap(arr)\n\n    for end in range(len(arr) - 1, 0, -1):\n        _HeapHelper.swap(arr, 0, end)\n        _HeapHelper.heapify(arr, end, 0)\n\n    return arr[:]  # Return a copy of the sorted list for clarity"}
