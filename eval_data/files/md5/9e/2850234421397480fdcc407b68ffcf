{"task_id": "Mbpp/726", "solution": "from typing import Tuple, Union\nNumber = Union[int, float]\ndef multiply_elements(values: Tuple[Number, ...]) -> Tuple[Number, ...]:\n    \"\"\"Compute the product of each pair of adjacent elements in a tuple.\n\n    Parameters\n    ----------\n    values : Tuple[Number, ...]\n        A tuple containing numeric values (int or float). The tuple must be immutable.\n\n    Returns\n    -------\n    Tuple[Number, ...]\n        A tuple where each element is the product of adjacent elements from the input.\n        If the input tuple has fewer than two elements, an empty tuple is returned.\n\n    Raises\n    ------\n    TypeError\n        If 'values' is not a tuple or if any element is not an int or float.\n\n    Examples\n    --------\n    >>> multiply_elements((2, 3, 4))\n    (6, 12)\n\n    >>> multiply_elements((5,))\n    ()\n\n    >>> multiply_elements(())\n    ()\n    \"\"\"\n    # Validation\n    if not isinstance(values, tuple):\n        raise TypeError(\"Input must be a tuple of numbers\")\n\n    for idx, v in enumerate(values):\n        if not isinstance(v, (int, float)):\n            raise TypeError(\n                f\"All elements must be int or float; element at index {idx} is {type(v).__name__}\"\n            )\n\n    if len(values) < 2:\n        return ()\n\n    # Computation\n    result = tuple(values[i] * values[i + 1] for i in range(len(values) - 1))\n\n    return result"}
{"task_id": "Mbpp/728", "solution": "from typing import List\ndef sum_list(a: List[int], b: List[int]) -> List[int]:\n    \"\"\"\n    Element\u2011wise summation of two integer lists.\n\n    Parameters\n    ----------\n    a : List[int]\n        First list of integers.\n    b : List[int]\n        Second list of integers.\n\n    Returns\n    -------\n    List[int]\n        A new list where each element is the sum of the corresponding elements\n        of `a` and `b`.\n\n    Raises\n    ------\n    ValueError\n        If the input lists have different lengths.\n    TypeError\n        If any element in the input lists is not an integer.\n\n    Notes\n    -----\n    This function does not modify the input lists and operates in O(n) time\n    with O(n) additional space.\n    \"\"\"\n    if len(a) != len(b):\n        raise ValueError(\"Lists must have the same length\")\n    for x, y in zip(a, b):\n        if not isinstance(x, int) or not isinstance(y, int):\n            raise TypeError(\"All elements must be integers\")\n    return [x + y for x, y in zip(a, b)]"}
{"task_id": "Mbpp/730", "solution": "from typing import List\ndef consecutive_duplicates(nums: List[int]) -> List[int]:\n    result = []\n    prev = object()  # unique sentinel\n    for num in nums:\n        if num != prev:\n            result.append(num)\n            prev = num\n    return result"}
