{"task_id": "Mbpp/597", "solution": "from typing import Sequence, TypeVar, Any\nT = TypeVar(\"T\")\ndef _is_sorted(seq: Sequence[Any]) -> bool:\n    \"\"\"Return True if seq is sorted in non\u2011decreasing order.\"\"\"\n    for i in range(len(seq) - 1):\n        if seq[i] > seq[i + 1]:\n            return False\n    return True\ndef find_kth(A: Sequence[T], B: Sequence[T], k: int) -> T:\n    \"\"\"\n    Return the kth smallest element in the union of two sorted sequences A and B.\n\n    Parameters\n    ----------\n    A : Sequence[T]\n        First sorted sequence (ascending order).\n    B : Sequence[T]\n        Second sorted sequence (ascending order).\n    k : int\n        1\u2011based index of the desired element (1 <= k <= len(A)+len(B)).\n\n    Returns\n    -------\n    T\n        The kth smallest element.\n\n    Raises\n    ------\n    ValueError\n        If inputs are not sorted, empty, or k is out of bounds.\n    \"\"\"\n    len_a, len_b = len(A), len(B)\n\n    # Basic validation\n    if len_a == 0 and len_b == 0:\n        raise ValueError(\"Both sequences are empty.\")\n    if k < 1 or k > len_a + len_b:\n        raise ValueError(f\"k={k} is out of bounds for combined length {len_a + len_b}.\")\n\n    if not _is_sorted(A):\n        raise ValueError(\"Sequence A is not sorted.\")\n    if not _is_sorted(B):\n        raise ValueError(\"Sequence B is not sorted.\")\n\n    # Handle cases where one sequence is empty\n    if len_a == 0:\n        return B[k - 1]\n    if len_b == 0:\n        return A[k - 1]\n\n    # Ensure A is the smaller sequence for binary search efficiency\n    if len_a > len_b:\n        A, B = B, A\n        len_a, len_b = len_b, len_a\n\n    # Binary search boundaries\n    low = max(0, k - len_b)\n    high = min(k, len_a)\n\n    while low <= high:\n        i = (low + high) // 2  # elements taken from A\n        j = k - i              # elements taken from B\n\n        a_left = A[i - 1] if i > 0 else None\n        a_right = A[i] if i < len_a else None\n        b_left = B[j - 1] if j > 0 else None\n        b_right = B[j] if j < len_b else None\n\n        # Check if partition is valid\n        left_ok = (i == 0 or (j == len_b or a_left <= b_right))\n        right_ok = (j == 0 or (i == len_a or b_left <= a_right))\n\n        if left_ok and right_ok:\n            # Compute max of left partition\n            if i == 0:\n                return b_left\n            if j == 0:\n                return a_left\n            return a_left if a_left >= b_left else b_left\n\n        if not left_ok:\n            # Move left pointer\n            high = i - 1\n        else:\n            # Move right pointer\n            low = i + 1\n\n    # If binary search fails (should not happen with valid input), raise error\n    raise ValueError(\"Failed to find kth element due to unexpected input.\")"}
{"task_id": "Mbpp/598", "solution": "def armstrong_number(n: int) -> bool:\n    \"\"\"Determine whether a non\u2011negative integer is an Armstrong number.\n\n    An Armstrong number of order *k* is a number that equals the sum of its\n    digits each raised to the power *k*, where *k* is the number of digits in\n    the number.\n\n    Args:\n        n: A non\u2011negative integer to test.\n\n    Returns:\n        True if ``n`` is an Armstrong number, otherwise False.\n\n    Raises:\n        ValueError: If ``n`` is negative.\n\n    Examples:\n        >>> armstrong_number(0)\n        True\n        >>> armstrong_number(153)\n        True\n        >>> armstrong_number(10)\n        False\n    \"\"\"\n    if n < 0:\n        raise ValueError(\"Input must be a non\u2011negative integer.\")\n    digits_str = str(n)\n    k = len(digits_str)\n    sum_digits = 0\n    for c in digits_str:\n        digit = int(c)\n        sum_digits += digit ** k\n    return sum_digits == n"}
{"task_id": "Mbpp/599", "solution": "from typing import Tuple\ndef sum_average(n: int) -> Tuple[int, float]:\n    \"\"\"\n    Compute the sum and average of the first n natural numbers.\n\n    Parameters\n    ----------\n    n : int\n        The number of terms in the sequence. Must be a positive integer.\n\n    Returns\n    -------\n    Tuple[int, float]\n        A tuple containing:\n        - sum: The integer sum of the first n natural numbers.\n        - average: The floating-point average of the first n natural numbers.\n\n    Raises\n    ------\n    ValueError\n        If n is not a positive integer (n <= 0).\n\n    Examples\n    --------\n    >>> sum_average(5)\n    (15, 3.0)\n\n    >>> sum_average(1)\n    (1, 1.0)\n\n    >>> sum_average(-3)\n    ValueError: n must be a positive integer\n    \"\"\"\n    if n <= 0:\n        raise ValueError(\"n must be a positive integer\")\n    total = n * (n + 1) // 2\n    avg = total / n\n    return total, avg"}
{"task_id": "Mbpp/600", "solution": "def is_Even(n: int) -> bool:\n    \"\"\"Determine whether an integer is even.\n\n    This function checks the parity of the supplied integer and returns\n    ``True`` if the number is even, ``False`` otherwise.\n\n    Args:\n        n (int): The integer to evaluate.\n\n    Returns:\n        bool: ``True`` if ``n`` is even, ``False`` otherwise.\n\n    Raises:\n        TypeError: If ``n`` is not an instance of ``int``.\n\n    Examples:\n        >>> is_Even(4)\n        True\n        >>> is_Even(7)\n        False\n        >>> is_Even(-2)\n        True\n        >>> is_Even(0)\n        True\n\n    Notes:\n        * The function treats negative numbers the same as positive ones with regard\n          to evenness.\n        * Non\u2011integer inputs (e.g., floats, strings) will raise ``TypeError``.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(f\"is_Even expects an integer, got {type(n).__name__}\")\n    return n % 2 == 0"}
