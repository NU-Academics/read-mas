{"task_id": "Mbpp/123", "solution": "import math\nfrom typing import List, Set\ndef compute_sigma(limit: int) -> List[int]:\n    \"\"\"Computes the sum of proper divisors for every integer from 0 to limit.\n    Returns a list where index i holds the sum of proper divisors of i.\n    \"\"\"\n    sigma = [0] * (limit + 1)\n    # For each potential divisor i, add i to multiples j = 2*i, 3*i, ...\n    for i in range(1, limit // 2 + 1):\n        step = i\n        start = i * 2\n        for j in range(start, limit + 1, step):\n            sigma[j] += i\n    return sigma\ndef find_amicables(limit: int, sigma: List[int]) -> Set[int]:\n    \"\"\"Identifies all amicable numbers up to limit using precomputed sigma.\n    Returns a set of amicable numbers.\n    \"\"\"\n    amicables: Set[int] = set()\n    for a in range(1, limit + 1):\n        b = sigma[a]\n        if b > a and b <= limit and sigma[b] == a:\n            amicables.add(a)\n            amicables.add(b)\n    return amicables\ndef amicable_numbers_sum(n: int) -> int:\n    \"\"\"Computes the sum of all amicable numbers less than or equal to n.\n    \n    Parameters\n    ----------\n    n : int\n        Non\u2011negative integer upper bound.\n    \n    Returns\n    -------\n    int\n        Sum of all amicable numbers \u2264 n.\n    \n    Raises\n    ------\n    ValueError\n        If n is negative or not an integer.\n    \"\"\"\n    validate_input(n)\n    if n == 0:\n        return 0\n    sigma = compute_sigma(n)\n    amicables = find_amicables(n, sigma)\n    return sum(amicables)"}
{"task_id": "Mbpp/124", "solution": "import math\ndef angle_complex(z):\n    \"\"\"Return the polar angle (argument) of a complex number in radians.\n\n    Parameters\n    ----------\n    z : complex\n        Complex number whose angle is to be computed.\n\n    Returns\n    -------\n    float\n        Angle in radians in the range (-\u03c0, \u03c0].\n\n    Notes\n    -----\n    The implementation uses math.atan2 for correct quadrant handling and\n    returns NaN if the input is zero.\n    \"\"\"\n    if z.real == 0 and z.imag == 0:\n        return float('nan')\n    return math.atan2(z.imag, z.real)"}
{"task_id": "Mbpp/125", "solution": "def find_length(binary_str: str) -> int:\n    \"\"\"Return the maximum difference between the number of '0's and '1's\n    in any contiguous substring of `binary_str`.\n\n    The function maps each '0' to +1 and each '1' to -1 and then applies\n    Kadane's algorithm to find the maximum subarray sum. If the maximum\n    sum is negative, the function returns 0.\n\n    Parameters\n    ----------\n    binary_str : str\n        A string consisting solely of the characters '0' and '1'.\n        The string may be empty; in that case the function returns 0.\n\n    Returns\n    -------\n    int\n        The maximum difference (#0s - #1s) over any substring,\n        or 0 if all substrings have a negative difference.\n\n    Raises\n    ------\n    ValueError\n        If `binary_str` contains characters other than '0' or '1'.\n\n    Examples\n    --------\n    >>> find_length('001011')\n    3\n    >>> find_length('1111')\n    0\n    >>> find_length('')\n    0\n    \"\"\"\n    if not binary_str:\n        return 0\n\n    for ch in binary_str:\n        if ch not in ('0', '1'):\n            raise ValueError(\"Input must contain only '0' and '1' characters\")\n\n    max_sum = 0\n    current_sum = 0\n    for ch in binary_str:\n        value = 1 if ch == '0' else -1\n        current_sum = value if current_sum < 0 else current_sum + value\n        if current_sum > max_sum:\n            max_sum = current_sum\n\n    return max_sum"}
