{"task_id": "Mbpp/788", "solution": "from collections.abc import Iterable\nfrom typing import Any, Tuple\ndef new_tuple(lst: Iterable[Any], elem: Any) -> Tuple[Any, ...]:\n    \"\"\"\n    Create a new tuple from an iterable and an additional element.\n\n    Parameters\n    ----------\n    lst : Iterable[Any]\n        Iterable of elements to include in the tuple.\n    elem : Any\n        Element to append after the iterable elements.\n\n    Returns\n    -------\n    Tuple[Any, ...]\n        Tuple containing all elements from ``lst`` followed by ``elem``.\n\n    Raises\n    ------\n    TypeError\n        If ``lst`` is not an iterable.\n\n    Examples\n    --------\n    >>> new_tuple(['WEB', 'is'], 'best')\n    ('WEB', 'is', 'best')\n    >>> new_tuple([], 1)\n    (1,)\n    \"\"\"\n    if not isinstance(lst, Iterable):\n        raise TypeError(\"First argument must be an iterable\")\n    return tuple(lst) + (elem,)"}
{"task_id": "Mbpp/790", "solution": "def check_even_index_even_numbers(numbers: list[int] | tuple[int, ...]) -> bool:\n    \"\"\"Returns True if all elements at even indices in 'numbers' are even integers.\n    Raises TypeError if input is not a list/tuple of integers.\n    \"\"\"\n    if not isinstance(numbers, (list, tuple)):\n        raise TypeError(\"input must be a list or tuple\")\n    for value in numbers:\n        if not isinstance(value, int):\n            raise TypeError(\"all elements must be integers\")\n    for i in range(0, len(numbers), 2):\n        if numbers[i] % 2 != 0:\n            return False\n    return True"}
{"task_id": "Mbpp/791", "solution": "def remove_nested(data: tuple) -> tuple:\n    \"\"\"Recursively flatten a tuple that may contain nested tuples.\n\n    Parameters\n    ----------\n    data : tuple\n        The tuple to flatten. May contain nested tuples and other objects.\n\n    Returns\n    -------\n    tuple\n        A new tuple with all nested tuples flattened into a single level.\n        Non-tuple elements are preserved in their original order.\n\n    Raises\n    ------\n    TypeError\n        If `data` is not a tuple.\n    \"\"\"\n    if not isinstance(data, tuple):\n        raise TypeError(\"Input must be a tuple\")\n\n    result = []\n\n    for element in data:\n        if isinstance(element, tuple):\n            result.extend(remove_nested(element))\n        else:\n            result.append(element)\n\n    return tuple(result)"}
{"task_id": "Mbpp/792", "solution": "from collections.abc import Iterable\nfrom typing import Any\ndef count_list(\n    data: Iterable[Any],\n    allow_non_list_inner: bool = False\n) -> int:\n    \"\"\"Count the number of inner lists in the provided iterable.\n\n    Parameters\n    ----------\n    data : Iterable[Any]\n        The outer iterable containing inner elements.\n    allow_non_list_inner : bool, optional\n        If True, non-list elements are counted as one. Defaults to False.\n\n    Returns\n    -------\n    int\n        Number of inner lists (or total items if allow_non_list_inner=True).\n\n    Raises\n    ------\n    TypeError\n        If data is None or not an iterable.\n    \"\"\"\n    if data is None:\n        raise TypeError(\"data cannot be None\")\n    try:\n        iterator = iter(data)\n    except TypeError:\n        raise TypeError(\"data must be an iterable\")\n\n    count = 0\n    for item in iterator:\n        if isinstance(item, list):\n            count += 1\n        elif allow_non_list_inner:\n            count += 1\n    return count"}
