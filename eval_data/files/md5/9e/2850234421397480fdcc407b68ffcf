{"task_id": "Mbpp/806", "solution": "def max_run_uppercase(s: str) -> int:\n    \"\"\"Compute the maximum number of consecutive uppercase alphabetic characters in the input string.\n\n    Parameters\n    ----------\n    s : str\n        The input string to analyze.\n\n    Returns\n    -------\n    int\n        Length of the longest run of consecutive uppercase letters. Returns 0 if there are none.\n    \"\"\"\n    max_len = 0\n    current_len = 0\n    for c in s:\n        if c.isalpha() and c.isupper():\n            current_len += 1\n        else:\n            if current_len > max_len:\n                max_len = current_len\n            current_len = 0\n    if current_len > max_len:\n        max_len = current_len\n    return max_len"}
{"task_id": "Mbpp/807", "solution": "from typing import List, Union, Optional\ndef first_odd(nums: List[Union[int, float]]) -> Optional[int]:\n    \"\"\"\n    Returns the first odd integer in the provided list.\n\n    Parameters:\n        nums: List of numbers (int or float).\n\n    Returns:\n        The first odd integer if found; otherwise None.\n\n    Raises:\n        TypeError: If nums is not a list.\n        ValueError: If any element is non-numeric.\n    \"\"\"\n    if not isinstance(nums, list):\n        raise TypeError(\"Input must be a list\")\n    for n in nums:\n        if not isinstance(n, (int, float)):\n            raise ValueError(\"List must contain numeric values\")\n        if isinstance(n, int) and n % 2 != 0:\n            return n\n    return None"}
{"task_id": "Mbpp/808", "solution": "def check_K(t: tuple[int], k: int) -> bool:\n    \"\"\"Determine whether integer k is present in tuple t.\n\n    Parameters\n    ----------\n    t : tuple[int]\n        A tuple of integers to search.\n    k : int\n        The integer to locate within t.\n\n    Returns\n    -------\n    bool\n        True if k is found in t, False otherwise.\n\n    Examples\n    --------\n    >>> check_K((1, 2, 3), 2)\n    True\n    >>> check_K((1, 2, 3), 4)\n    False\n    \"\"\"\n    if not isinstance(t, tuple):\n        raise TypeError(f\"Expected tuple for 't', got {type(t).__name__}\")\n    if not isinstance(k, int):\n        raise TypeError(f\"Expected int for 'k', got {type(k).__name__}\")\n    for item in t:\n        if not isinstance(item, int):\n            raise TypeError(f\"Expected all elements of 't' to be int, got {type(item).__name__}\")\n        if item == k:\n            return True\n    return False"}
