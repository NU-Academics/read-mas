{"task_id": "Mbpp/588", "solution": "import math\nfrom typing import List, Union, Any\nNumber = Union[int, float, complex]\ndef big_diff(data: List[Number]) -> float:\n    \"\"\"Compute the difference between the largest and smallest numeric values in `data`.\n\n    Parameters\n    ----------\n    data : list\n        List of numeric values (int, float, complex).\n\n    Returns\n    -------\n    float\n        Difference between the maximum and minimum magnitudes.\n\n    Raises\n    ------\n    ValueError\n        If `data` is empty or contains non\u2011finite numbers.\n    TypeError\n        If any element is not numeric.\n    \"\"\"\n    if not data:\n        raise ValueError(\"Input list is empty.\")\n\n    # Helper to compute magnitude and validate finiteness\n    def _magnitude_and_check(val: Any) -> float:\n        if isinstance(val, complex):\n            mag = abs(val)\n        else:\n            # For int and float\n            mag = float(val)\n        if not math.isfinite(mag):\n            raise ValueError(\"Infinite or NaN values are not allowed.\")\n        return mag\n\n    # Validate first element\n    first = data[0]\n    if not isinstance(first, (int, float, complex)):\n        raise TypeError(f\"Element {first!r} is not numeric.\")\n    min_val = max_val = _magnitude_and_check(first)\n\n    for elem in data[1:]:\n        if not isinstance(elem, (int, float, complex)):\n            raise TypeError(f\"Element {elem!r} is not numeric.\")\n        mag = _magnitude_and_check(elem)\n        if mag < min_val:\n            min_val = mag\n        if mag > max_val:\n            max_val = mag\n\n    return max_val - min_val"}
