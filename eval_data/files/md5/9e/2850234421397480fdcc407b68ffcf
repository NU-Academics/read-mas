{"task_id": "Mbpp/784", "solution": "from typing import List\ndef mul_even_odd(nums: List[int]) -> int:\n    \"\"\"Return the product of the first even and first odd numbers in the list.\n    If either is missing, return 0.\n\n    Raises:\n        TypeError: If the input is not a list.\n        ValueError: If any element in the list is not an integer.\n    \"\"\"\n    if not isinstance(nums, list):\n        raise TypeError(\"Input must be a list of integers.\")\n\n    for i, value in enumerate(nums):\n        if not isinstance(value, int):\n            raise ValueError(f\"Element at index {i} is not an integer: {value!r}\")\n\n    first_even = None\n    first_odd = None\n\n    for value in nums:\n        if first_even is None and value % 2 == 0:\n            first_even = value\n        if first_odd is None and value % 2 != 0:\n            first_odd = value\n        if first_even is not None and first_odd is not None:\n            break\n\n    return 0 if first_even is None or first_odd is None else first_even * first_odd"}
{"task_id": "Mbpp/785", "solution": "def tuple_str_int(s: str) -> tuple[int, ...]:\n    \"\"\"\n    Convert a string representation of a tuple of integers into an actual tuple.\n\n    Parameters\n    ----------\n    s : str\n        String representation of the tuple.\n\n    Returns\n    -------\n    tuple[int, ...]\n        Parsed tuple of integers.\n\n    Raises\n    ------\n    TypeError\n        If the argument is not a string.\n    ValueError\n        If the string does not conform to the tuple-of-integers syntax.\n    \"\"\"\n    if not isinstance(s, str):\n        raise TypeError(f\"Expected a string, got {type(s).__name__}\")\n\n    s = s.strip()\n\n    if not (s.startswith(\"(\") and s.endswith(\")\")):\n        raise ValueError(\"Input must start with '(' and end with ')'\")\n\n    inner = s[1:-1].strip()\n\n    if inner == \"\":\n        return ()\n\n    tokens = inner.split(\",\")\n\n    result = []\n\n    for token in tokens:\n        token_stripped = token.strip()\n        if token_stripped == \"\":\n            raise ValueError(\"Empty tuple element detected\")\n        try:\n            value = int(token_stripped)\n        except ValueError:\n            raise ValueError(f\"Invalid integer literal: '{token_stripped}'\")\n        result.append(value)\n\n    return tuple(result)"}
{"task_id": "Mbpp/786", "solution": "def right_insertion(arr: list[int], target: int) -> int:\n    \"\"\"Return the index at which `target` should be inserted into `arr`\n    to preserve sorted order, inserting to the right of equal elements.\n    Raises ValueError if `arr` is not sorted in non\u2011decreasing order.\n    \"\"\"\n    # Validate that arr is a list and all elements are integers\n    if not isinstance(arr, list):\n        raise TypeError(\"Input must be a list.\")\n    for i, x in enumerate(arr):\n        if not isinstance(x, int):\n            raise TypeError(f\"Element at index {i} is not an integer.\")\n\n    # Check that arr is sorted in non\u2011decreasing order\n    for i in range(len(arr) - 1):\n        if arr[i] > arr[i + 1]:\n            raise ValueError(\"Input list is not sorted in non\u2011decreasing order.\")\n\n    # Binary search for right insertion point\n    low, high = 0, len(arr)\n    while low < high:\n        mid = (low + high) // 2\n        if arr[mid] <= target:\n            low = mid + 1\n        else:\n            high = mid\n    return low"}
