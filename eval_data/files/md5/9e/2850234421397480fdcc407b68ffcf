{"task_id": "Mbpp/223", "solution": "from typing import List, TypeVar\nT = TypeVar('T')\ndef is_majority(arr: List[T], n: int, elem: T) -> bool:\n    \"\"\"Determine whether `elem` is the majority element in a sorted array.\"\"\"\n    if n != len(arr):\n        raise ValueError(f\"Length mismatch: n={n} but len(arr)={len(arr)}\")\n\n    first = _first_occurrence(arr, elem)\n    if first == -1:\n        return False\n\n    last = _last_occurrence(arr, elem)\n    count = last - first + 1\n    return count > n // 2\ndef _first_occurrence(arr: List[T], elem: T) -> int:\n    \"\"\"Return index of first occurrence of elem, or -1 if not present.\"\"\"\n    left, right = 0, len(arr) - 1\n    result = -1\n    while left <= right:\n        mid = (left + right) // 2\n        if arr[mid] == elem:\n            result = mid\n            right = mid - 1\n        elif arr[mid] < elem:\n            left = mid + 1\n        else:\n            right = mid - 1\n    return result\ndef _last_occurrence(arr: List[T], elem: T) -> int:\n    \"\"\"Return index of last occurrence of elem, or -1 if not present.\"\"\"\n    left, right = 0, len(arr) - 1\n    result = -1\n    while left <= right:\n        mid = (left + right) // 2\n        if arr[mid] == elem:\n            result = mid\n            left = mid + 1\n        elif arr[mid] < elem:\n            left = mid + 1\n        else:\n            right = mid - 1\n    return result"}
{"task_id": "Mbpp/224", "solution": "def count_Set_Bits(n: int, allow_negative: bool = False, bit_width: int = 32) -> int:\n    \"\"\"Count the number of set bits in integer ``n``.\n\n    Parameters\n    ----------\n    n : int\n        The integer to count set bits.\n    allow_negative : bool, optional\n        If ``True``, negative values are interpreted in two's complement form\n        of ``bit_width`` bits. Default is ``False``.\n    bit_width : int, optional\n        Width of two's complement representation for negative numbers.\n        Ignored if ``allow_negative`` is ``False``. Default is ``32``.\n\n    Returns\n    -------\n    int\n        Number of set bits.\n\n    Raises\n    ------\n    TypeError\n        If ``n`` is not an int or ``allow_negative`` is not a bool.\n    ValueError\n        If ``n`` < 0 and ``allow_negative`` is ``False``, or if\n        ``bit_width`` <= 0.\n    \"\"\"\n    # Input validation\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n    if not isinstance(allow_negative, bool):\n        raise TypeError(\"allow_negative must be a boolean\")\n    if allow_negative:\n        if not isinstance(bit_width, int) or bit_width <= 0:\n            raise ValueError(\"bit_width must be a positive integer\")\n    else:\n        if n < 0:\n            raise ValueError(\"negative input not allowed unless allow_negative=True\")\n\n    # Normalization for negative numbers when allowed\n    if allow_negative and n < 0:\n        mask = (1 << bit_width) - 1\n        n &= mask\n\n    # Kernighan's algorithm\n    count = 0\n    while n:\n        n &= n - 1\n        count += 1\n    return count"}
{"task_id": "Mbpp/226", "solution": "def odd_values_string(s: str) -> str:\n    \"\"\"\n    Return a new string containing only the characters of the input string\n    that have even index values (i.e., indices 0, 2, 4, ...).\n\n    Parameters\n    ----------\n    s : str\n        The input string.\n\n    Returns\n    -------\n    str\n        A string with characters at odd indices removed.\n\n    Examples\n    --------\n    >>> odd_values_string('abcdef')\n    'ace'\n    \"\"\"\n    return s[::2]"}
{"task_id": "Mbpp/227", "solution": "from typing import TypeVar\nT = TypeVar(\"T\")\ndef min_of_three(a: T, b: T, c: T) -> T:\n    \"\"\"\n    Return the minimum of three numeric values.\n\n    Parameters\n    ----------\n    a : T\n        First numeric value.\n    b : T\n        Second numeric value.\n    c : T\n        Third numeric value.\n\n    Returns\n    -------\n    T\n        The smallest of `a`, `b`, and `c`.\n\n    Examples\n    --------\n    >>> min_of_three(10, 5, 7)\n    5\n    >>> min_of_three(3.2, 3.1, 3.3)\n    3.1\n    \"\"\"\n    return min(a, b, c)"}
{"task_id": "Mbpp/230", "solution": "def replace_blank(input_str: str, repl: str) -> str:\n    \"\"\"\n    Replace all ASCII space characters in input_str with repl.\n\n    Parameters\n    ----------\n    input_str : str\n        The string to process.\n    repl : str\n        Replacement character; must be a single character.\n\n    Returns\n    -------\n    str\n        New string with spaces replaced.\n\n    Raises\n    ------\n    TypeError\n        If input_str is not a string or repl is not a single character.\n    \"\"\"\n    if not isinstance(input_str, str):\n        raise TypeError(\"input_str must be a string\")\n    if not isinstance(repl, str) or len(repl) != 1:\n        raise TypeError(\"repl must be a single character string\")\n\n    # Fast path: no spaces\n    if ' ' not in input_str:\n        return input_str\n\n    return input_str.replace(' ', repl)"}
{"task_id": "Mbpp/232", "solution": "import heapq\nfrom typing import List\ndef larg_nnum(lst: List[int], n: int) -> List[int]:\n    \"\"\"Return the n largest integers from ``lst`` in descending order.\n\n    Parameters\n    ----------\n    lst : List[int]\n        Input list of integers. Must not be None.\n    n : int\n        Number of largest elements to return.\n\n    Returns\n    -------\n    List[int]\n        A list containing the n largest integers, sorted in descending order.\n        If ``lst`` is empty and ``n`` is 0, an empty list is returned.\n\n    Raises\n    ------\n    ValueError\n        If ``n`` is <= 0, or if ``n`` is greater than the length of ``lst``.\n    \"\"\"\n    if n <= 0:\n        raise ValueError(\"n must be a positive integer\")\n    if n > len(lst):\n        raise ValueError(f\"n ({n}) cannot exceed list length ({len(lst)})\")\n    if n == 0:\n        return []\n\n    return heapq.nlargest(n, lst)"}
