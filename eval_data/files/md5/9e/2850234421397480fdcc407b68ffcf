{"task_id": "Mbpp/285", "solution": "def contains_a_bb(s: str) -> bool:\n    \"\"\"\n    Return True if the input string contains 'abb' or 'abbb'.\n    Matching is case\u2011sensitive and only lowercase 'a' and 'b' are considered.\n    Raises TypeError if the argument is not a string.\n    \"\"\"\n    if not isinstance(s, str):\n        raise TypeError(\"Input must be a string\")\n\n    n = len(s)\n    i = 0\n    while i < n - 2:\n        if s[i] == 'a':\n            # Check for 'abb'\n            if s[i + 1] == 'b' and s[i + 2] == 'b':\n                return True\n            # Check for 'abbb' if possible\n            if i + 3 < n and s[i + 1] == 'b' and s[i + 2] == 'b' and s[i + 3] == 'b':\n                return True\n        i += 1\n    return False"}
{"task_id": "Mbpp/286", "solution": "from typing import List\ndef max_sub_array_sum_repeated(nums: List[int], k: int, repeat: int) -> int:\n    \"\"\"Compute the maximum sub\u2011array sum of the array `nums` repeated `repeat` times.\n\n    Parameters\n    ----------\n    nums : List[int]\n        The base array of integers. May be empty.\n    k : int\n        Reserved parameter, currently unused.\n    repeat : int\n        Number of times `nums` is concatenated. Must be non\u2011negative.\n\n    Returns\n    -------\n    int\n        The maximum sub\u2011array sum. Returns 0 if `nums` is empty or `repeat` == 0.\n\n    Raises\n    ------\n    ValueError\n        If `repeat` is negative.\n    \"\"\"\n    if repeat < 0:\n        raise ValueError(\"repeat must be non\u2011negative\")\n\n    if not nums or repeat == 0:\n        return 0\n\n    # Kadane's algorithm for single array\n    max_current = max_global = nums[0]\n    for x in nums[1:]:\n        max_current = x if x > max_current + x else max_current + x\n        if max_current > max_global:\n            max_global = max_current\n\n    # Max prefix sum\n    sum_so_far = 0\n    max_prefix = float('-inf')\n    for x in nums:\n        sum_so_far += x\n        if sum_so_far > max_prefix:\n            max_prefix = sum_so_far\n\n    # Max suffix sum\n    sum_so_far = 0\n    max_suffix = float('-inf')\n    for x in reversed(nums):\n        sum_so_far += x\n        if sum_so_far > max_suffix:\n            max_suffix = sum_so_far\n\n    total_sum = sum(nums)\n\n    if repeat == 1:\n        return max_global\n\n    if total_sum <= 0:\n        return max(max_global, max_suffix + max_prefix)\n    else:\n        return max(\n            max_global,\n            max_suffix + max_prefix + (repeat - 2) * total_sum\n        )"}
{"task_id": "Mbpp/287", "solution": "def square_Sum(n: int) -> int:\n    \"\"\"Calculate the sum of squares of the first n even natural numbers.\n\n    Args:\n        n: A positive integer representing the count of even natural numbers.\n\n    Returns:\n        The sum of squares as an integer.\n\n    Raises:\n        ValueError: If n is not a positive integer.\n\n    Examples:\n        >>> square_Sum(3)\n        28\n        >>> assert square_Sum(3) == 28\n    \"\"\"\n    if not isinstance(n, int) or n <= 0:\n        raise ValueError(\"Input must be a positive integer\")\n\n    # Closed\u2011form: 4 * sum_{k=1}^{n} k^2 = 4 * n(n+1)(2n+1)/6\n    return 4 * n * (n + 1) * (2 * n + 1) // 6"}
{"task_id": "Mbpp/290", "solution": "from typing import Any, List, Tuple\ndef max_length(lists: List[List[Any]]) -> Tuple[int, List[Any]]:\n    \"\"\"\n    Return the longest sub-list from a list of sub-lists.\n\n    Parameters\n    ----------\n    lists : list[list[Any]]\n        A non-empty list of sub-lists.\n\n    Returns\n    -------\n    tuple[int, list[Any]]\n        A tuple containing the length of the longest sub-list and the sub-list itself.\n\n    Raises\n    ------\n    ValueError\n        If the input list is empty.\n\n    Examples\n    --------\n    >>> max_length([[0], [1, 3], [5, 7], [9, 11], [13, 15, 17]])\n    (3, [13, 15, 17])\n    \"\"\"\n    if not lists:\n        raise ValueError(\"Input list must contain at least one sub-list.\")\n\n    max_len = 0\n    max_sublist: List[Any] = []\n\n    for sublist in lists:\n        sub_len = len(sublist)\n        if sub_len > max_len:\n            max_len = sub_len\n            max_sublist = sublist\n\n    return max_len, max_sublist"}
{"task_id": "Mbpp/292", "solution": "import math\nfrom decimal import Decimal, ROUND_FLOOR\nfrom fractions import Fraction\nfrom typing import Union\nNUMERIC_TYPES = (int, float, Decimal, Fraction)\ndef find(a: Union[int, float, Decimal, Fraction],\n         b: Union[int, float, Decimal, Fraction]) -> int:\n    \"\"\"Return the floor of a / b.\n\n    Parameters\n    ----------\n    a : int | float | Decimal | Fraction\n        Numerator.\n    b : int | float | Decimal | Fraction\n        Denominator. Must not be zero.\n\n    Returns\n    -------\n    int\n        Floor division result.\n\n    Raises\n    ------\n    ValueError\n        If `b` is zero.\n    TypeError\n        If either `a` or `b` is not a supported numeric type.\n    \"\"\"\n    if not isinstance(a, NUMERIC_TYPES) or not isinstance(b, NUMERIC_TYPES):\n        raise TypeError(\"Inputs must be numeric types.\")\n\n    if b == 0:\n        raise ValueError(\"Denominator cannot be zero.\")\n\n    quotient = a / b\n\n    if isinstance(quotient, Decimal):\n        return int(quotient.to_integral_value(rounding=ROUND_FLOOR))\n    if isinstance(quotient, Fraction):\n        return quotient.numerator // quotient.denominator\n    # Handles int, float (and any other numeric that defaults to float)\n    return math.floor(quotient)"}
{"task_id": "Mbpp/293", "solution": "import math\nfrom typing import Union\ndef otherside_rightangle(a: Union[int, float], b: Union[int, float]) -> float:\n    \"\"\"\n    Compute the length of the third side of a right\u2011angled triangle given the other two sides.\n    \n    The function assumes the triangle follows the Pythagorean theorem:\n        c = sqrt(a\u00b2 + b\u00b2)\n    \n    Parameters\n    ----------\n    a : int | float\n        Length of one leg of the right\u2011angled triangle. Must be non\u2011negative.\n    b : int | float\n        Length of the other leg of the right\u2011angled triangle. Must be non\u2011negative.\n    \n    Returns\n    -------\n    float\n        The length of the hypotenuse.\n    \n    Raises\n    ------\n    ValueError\n        If either input is negative.\n    TypeError\n        If inputs cannot be converted to float.\n    \"\"\"\n    try:\n        a_val = float(a)\n        b_val = float(b)\n    except (TypeError, ValueError) as exc:\n        raise TypeError(\"Both arguments must be numeric values.\") from exc\n\n    if a_val < 0 or b_val < 0:\n        raise ValueError(\"Side lengths must be non\u2011negative.\")\n\n    return math.sqrt(a_val ** 2 + b_val ** 2)"}
{"task_id": "Mbpp/294", "solution": "from typing import List, Any, Union\nfrom numbers import Number\ndef max_val(values: List[Any]) -> Union[int, float, complex]:\n    \"\"\"\n    Return the maximum numeric value from a list of heterogeneous elements.\n\n    The function iterates over `values`, filters out all non\u2011numeric elements,\n    and returns the largest numeric value. Non\u2011numeric elements are ignored.\n    If no numeric values are present, a ``ValueError`` is raised.\n\n    Parameters\n    ----------\n    values : list[Any]\n        A list containing elements of any type. Numeric elements are\n        considered `int`, `float`, `complex`, or any subclass of\n        :class:`numbers.Number`.\n\n    Returns\n    -------\n    Union[int, float, complex]\n        The maximum numeric value found in `values`. The type returned\n        matches the type of the maximum element.\n\n    Raises\n    ------\n    ValueError\n        If the input list contains no numeric values.\n\n    Examples\n    --------\n    >>> max_val([1, 'a', 3.5, None, 2])\n    3.5\n    >>> max_val(['x', True, None])\n    Traceback (most recent call last):\n        ...\n    ValueError: No numeric values found in the input list.\n    \"\"\"\n    max_elem: Union[int, float, complex, None] = None\n    max_comp: Union[int, float, complex, None] = None\n\n    for item in values:\n        if isinstance(item, Number):\n            comp = item.real if isinstance(item, complex) else item\n            if max_comp is None or comp > max_comp:\n                max_comp = comp\n                max_elem = item\n\n    if max_elem is None:\n        raise ValueError(\"No numeric values found in the input list.\")\n    return max_elem"}
{"task_id": "Mbpp/296", "solution": "from typing import List, Tuple\ndef get_Inv_Count(arr: List[int]) -> int:\n    if arr is None:\n        raise ValueError(\"Input array cannot be None.\")\n    for idx, val in enumerate(arr):\n        if not isinstance(val, int):\n            raise TypeError(\n                f\"All elements must be integers. Element at index {idx} \"\n                f\"is of type {type(val).__name__}.\"\n            )\n\n    def merge_sort_count(subarr: List[int]) -> Tuple[List[int], int]:\n        n = len(subarr)\n        if n <= 1:\n            return subarr[:], 0\n        mid = n // 2\n        left, inv_left = merge_sort_count(subarr[:mid])\n        right, inv_right = merge_sort_count(subarr[mid:])\n        merged, cross_inv = merge_and_count(left, right)\n        return merged, inv_left + inv_right + cross_inv\n\n    def merge_and_count(left: List[int], right: List[int]) -> Tuple[List[int], int]:\n        i = j = 0\n        merged = []\n        cross_inv = 0\n        len_left = len(left)\n        while i < len_left and j < len(right):\n            if left[i] <= right[j]:\n                merged.append(left[i])\n                i += 1\n            else:\n                merged.append(right[j])\n                cross_inv += len_left - i\n                j += 1\n        merged.extend(left[i:])\n        merged.extend(right[j:])\n        return merged, cross_inv\n\n    _, total_inv = merge_sort_count(arr)\n    return total_inv"}
{"task_id": "Mbpp/297", "solution": "def flatten_list(data):\n    \"\"\"Recursively flattens a nested list of integers.\n\n    Parameters\n    ----------\n    data : list\n        A list that may contain integers or other lists.\n\n    Returns\n    -------\n    list\n        A new list containing all integers from ``data`` in left-to-right depth-first order.\n\n    Raises\n    ------\n    TypeError\n        If any element in ``data`` is neither an int nor a list.\n    \"\"\"\n    def _flatten(sublist, result):\n        for element in sublist:\n            if isinstance(element, int):\n                result.append(element)\n            elif isinstance(element, list):\n                _flatten(element, result)\n            else:\n                raise TypeError(f\"Unsupported element type: {type(element).__name__}\")\n\n    if not isinstance(data, list):\n        raise TypeError(f\"Input must be a list, got {type(data).__name__}\")\n    flat = []\n    _flatten(data, flat)\n    return flat"}
{"task_id": "Mbpp/299", "solution": "def max_aggregate(records):\n    \"\"\"\n    Return the name with the maximum total score and the total score.\n\n    Parameters\n    ----------\n    records : list[tuple[str, int]]\n        List of (name, score) tuples.\n\n    Returns\n    -------\n    tuple[str, int]\n        (name, total_score) where total_score is the highest aggregate.\n\n    Raises\n    ------\n    ValueError\n        If the input list is empty.\n    TypeError\n        If any record is not a (str, int) tuple.\n    \"\"\"\n    if not records:\n        raise ValueError(\"Input list cannot be empty\")\n\n    score_map = {}\n    for name, score in records:\n        if not isinstance(name, str) or not isinstance(score, int):\n            raise TypeError(\"Each record must be a (str, int) tuple\")\n        score_map[name] = score_map.get(name, 0) + score\n\n    max_name = max(score_map, key=score_map.get)\n    return (max_name, score_map[max_name])"}
