{"task_id": "Mbpp/388", "solution": "def highest_Power_of_2(n: int) -> int:\n    \"\"\"\n    Return the greatest power of 2 less than or equal to ``n``.\n\n    Parameters\n    ----------\n    n : int\n        A positive integer (n >= 1). The function will raise a ValueError\n        if ``n`` is less than 1.\n\n    Returns\n    -------\n    int\n        The largest power of two ``p`` such that ``p <= n``.\n        For example, highest_Power_of_2(10) returns 8.\n\n    Raises\n    ------\n    ValueError\n        If ``n`` is less than 1.\n\n    Notes\n    -----\n    This implementation uses bit manipulation for optimal performance.\n    It works for arbitrarily large integers supported by Python's arbitrary\n    precision arithmetic.\n\n    Examples\n    --------\n    >>> highest_Power_of_2(1)\n    1\n    >>> highest_Power_of_2(2)\n    2\n    >>> highest_Power_of_2(3)\n    2\n    >>> highest_Power_of_2(16)\n    16\n    >>> highest_Power_of_2(17)\n    16\n    \"\"\"\n    if n < 1:\n        raise ValueError(\"n must be a positive integer\")\n    return 1 << (n.bit_length() - 1)"}
{"task_id": "Mbpp/389", "solution": "def find_lucas(n: int) -> int:\n    \"\"\"Return the nth Lucas number using an iterative approach.\n\n    Parameters\n    ----------\n    n : int\n        Non\u2011negative index of the Lucas sequence.\n\n    Returns\n    -------\n    int\n        The nth Lucas number.\n\n    Raises\n    ------\n    ValueError\n        If `n` is negative.\n    OverflowError\n        If the result does not fit in a 64\u2011bit signed integer.\n    \"\"\"\n    if n < 0:\n        raise ValueError(\"n must be non\u2011negative\")\n\n    INT64_MIN = -9223372036854775808\n    INT64_MAX = 9223372036854775807\n\n    if n == 0:\n        return 2\n    if n == 1:\n        return 1\n\n    a, b = 2, 1\n    for _ in range(2, n + 1):\n        a, b = b, a + b\n        if b < INT64_MIN or b > INT64_MAX:\n            raise OverflowError(\"Lucas number exceeds 64\u2011bit signed integer range\")\n    return b"}
{"task_id": "Mbpp/390", "solution": "from typing import List\ndef add_string(strings: List[str], format_str: str) -> List[str]:\n    \"\"\"Apply a format string to each element of a list of strings.\n\n    Parameters\n    ----------\n    strings : List[str]\n        List of strings to format.\n    format_str : str\n        Format string containing exactly one '{}' placeholder.\n\n    Returns\n    -------\n    List[str]\n        New list where each element is formatted as format_str.format(item).\n\n    Raises\n    ------\n    TypeError\n        If any element in `strings` is not a str.\n    ValueError\n        If `format_str` does not contain exactly one '{}' placeholder.\n    \"\"\"\n    if format_str.count('{}') != 1:\n        raise ValueError(\"Format string must contain exactly one '{}' placeholder.\")\n    for item in strings:\n        if not isinstance(item, str):\n            raise TypeError(\"All elements must be strings.\")\n    return [format_str.format(item) for item in strings]"}
{"task_id": "Mbpp/391", "solution": "from collections.abc import Iterable\nfrom typing import Any, Dict, Iterable as IterableType, List, TypeVar\nT = TypeVar(\"T\")\ndef convert_list_dictionary(\n    keys: IterableType[T],\n    values: IterableType[T],\n    extras: IterableType[T],\n    *,\n    key_name: str = \"key\",\n    value_name: str = \"value\",\n    extra_name: str = \"extra\",\n) -> List[Dict[str, Any]]:\n    \"\"\"\n    Transform three parallel iterables into a list of dictionaries.\n\n    Each dictionary contains the mapping\n    ``{key_name: keys[i], value_name: values[i], extra_name: extras[i]}``.\n\n    Parameters\n    ----------\n    keys : Iterable\n        Primary identifiers.\n    values : Iterable\n        Primary values.\n    extras : Iterable\n        Auxiliary data.\n    key_name : str, optional\n        Name of the key field in the resulting dictionaries.\n    value_name : str, optional\n        Name of the value field in the resulting dictionaries.\n    extra_name : str, optional\n        Name of the extra field in the resulting dictionaries.\n\n    Returns\n    -------\n    list[dict[str, Any]]\n        List of dictionaries with the specified field names.\n\n    Raises\n    ------\n    TypeError\n        If any of the arguments is not iterable.\n    ValueError\n        If the iterables do not have the same length.\n    \"\"\"\n    # Verify that all inputs are iterable\n    if not isinstance(keys, Iterable) or not isinstance(values, Iterable) or not isinstance(extras, Iterable):\n        raise TypeError(\"All arguments must be iterable\")\n\n    # Convert to sequences if possible to check length efficiently\n    try:\n        len_keys = len(keys)\n        len_values = len(values)\n        len_extras = len(extras)\n    except TypeError:\n        # One of them is not a sized iterable; fall back to list conversion\n        keys = list(keys)\n        values = list(values)\n        extras = list(extras)\n        len_keys = len(keys)\n        len_values = len(values)\n        len_extras = len(extras)\n\n    if len_keys != len_values or len_keys != len_extras:\n        raise ValueError(\"All lists must have the same length\")\n\n    return [\n        {key_name: k, value_name: v, extra_name: e}\n        for k, v, e in zip(keys, values, extras)\n    ]"}
{"task_id": "Mbpp/392", "solution": "import functools\ndef get_max_sum(n: int) -> int:\n    @functools.lru_cache(maxsize=None)\n    def f(x: int) -> int:\n        if x == 0:\n            return 0\n        # Calculate recursively using integer division\n        return max(x, f(x // 2) + f(x // 3) + f(x // 4) + f(x // 5))\n\n    return f(n)"}
{"task_id": "Mbpp/394", "solution": "from typing import Tuple, Any\ndef check_distinct(items: Tuple[Any, ...]) -> bool:\n    \"\"\"\n    Determine if a tuple contains only unique elements.\n\n    Parameters\n    ----------\n    items : tuple\n        A tuple of hashable items.\n\n    Returns\n    -------\n    bool\n        True if all elements are unique, False otherwise.\n\n    Raises\n    ------\n    TypeError\n        If `items` is not a tuple.\n        If an element is unhashable.\n    \"\"\"\n    if not isinstance(items, tuple):\n        raise TypeError(f\"check_distinct expects a tuple, got {type(items).__name__}\")\n\n    seen = set()\n    for elem in items:\n        if elem in seen:\n            return False\n        try:\n            seen.add(elem)\n        except TypeError as exc:\n            raise TypeError(f\"Unhashable element {elem!r} of type {type(elem).__name__}\") from exc\n    return True"}
{"task_id": "Mbpp/395", "solution": "from collections import Counter\nfrom typing import Optional\ndef first_non_repeating_character(s: str) -> Optional[str]:\n    \"\"\"Return the first non\u2011repeated character in the string `s`.\n\n    Parameters\n    ----------\n    s : str\n        The input string to be processed. Must be a Unicode string.\n\n    Returns\n    -------\n    Optional[str]\n        The first character that appears exactly once in `s`. \n        Returns None if every character repeats or if `s` is empty.\n\n    Raises\n    ------\n    TypeError\n        If the argument `s` is not of type `str`.\n\n    Examples\n    --------\n    >>> first_non_repeating_character(\"abcabc\")\n    None\n    >>> first_non_repeating_character(\"abacabad\")\n    'c'\n    >>> first_non_repeating_character(\"\ud83d\ude00\ud83d\ude03\ud83d\ude00\ud83d\ude04\ud83d\ude03\")\n    '\ud83d\ude04'\n    \"\"\"\n    if not isinstance(s, str):\n        raise TypeError(\"Input must be a string\")\n\n    freq = Counter(s)\n\n    for ch in s:\n        if freq[ch] == 1:\n            return ch\n    return None"}
{"task_id": "Mbpp/397", "solution": "import math\nfrom typing import Union\nNumber = Union[int, float]\ndef median_numbers(a: Number, b: Number, c: Number) -> float:\n    \"\"\"\n    Return the median of three numeric values.\n\n    Parameters\n    ----------\n    a : Number\n        First numeric value.\n    b : Number\n        Second numeric value.\n    c : Number\n        Third numeric value.\n\n    Returns\n    -------\n    float\n        The median value among a, b, and c.\n\n    Notes\n    -----\n    * The function uses a direct comparison strategy rather than sorting to keep the\n      algorithm deterministic and efficient.\n    * It accepts any type that implements the numeric protocol; however, the return type\n      is annotated as ``float`` for consistency.\n    \"\"\"\n    def _to_min(x: Number) -> float:\n        \"\"\"Treat NaN as the smallest possible value.\"\"\"\n        return float(\"-inf\") if isinstance(x, float) and math.isnan(x) else float(x)\n\n    a_min, b_min, c_min = _to_min(a), _to_min(b), _to_min(c)\n\n    if (a_min <= b_min <= c_min) or (c_min <= b_min <= a_min):\n        return float(b)\n    if (b_min <= a_min <= c_min) or (c_min <= a_min <= b_min):\n        return float(a)\n    return float(c)"}
{"task_id": "Mbpp/398", "solution": "from typing import List\ndef sum_of_digits(numbers: List[int]) -> int:\n    \"\"\"\n    Calculate the sum of all digits in a list of integers.\n\n    Parameters\n    ----------\n    numbers : List[int]\n        A list of integer values. Integers may be positive, negative, or zero.\n\n    Returns\n    -------\n    int\n        The total sum of all decimal digits in the input list.\n    \"\"\"\n    if not isinstance(numbers, list):\n        raise TypeError(\"Input must be a list of integers\")\n\n    total_sum = 0\n    for num in numbers:\n        if not isinstance(num, int):\n            raise TypeError(\"All elements must be integers\")\n\n        abs_num = abs(num)\n        if abs_num == 0:\n            continue\n\n        while abs_num > 0:\n            total_sum += abs_num % 10\n            abs_num //= 10\n\n    return total_sum"}
{"task_id": "Mbpp/404", "solution": "def min_of_two(a: float, b: float) -> float:\n    \"\"\"\n    Return the smaller of two numeric values.\n\n    Parameters\n    ----------\n    a : float\n        The first numeric value.\n    b : float\n        The second numeric value.\n\n    Returns\n    -------\n    float\n        The minimum of ``a`` and ``b``.\n\n    Examples\n    --------\n    >>> min_of_two(3, 5)\n    3\n    >>> min_of_two(-1, -10)\n    -10\n    \"\"\"\n    return a if a < b else b"}
{"task_id": "Mbpp/405", "solution": "\"\"\"\ntuple_utils.py\nUtility functions for tuple operations.\n\"\"\"\n\ndef element_exists_in_tuple(target_tuple: tuple, element) -> bool:\n    \"\"\"\n    Checks whether `element` is present in `target_tuple`.\n\n    Parameters:\n        target_tuple (tuple): The tuple to search.\n        element: The value to look for.\n\n    Returns:\n        bool: True if element is found, False otherwise.\n    \"\"\"\n    for item in target_tuple:\n        if item == element:\n            return True\n    return False\n\nif __name__ == \"__main__\":\n    # Test cases using assert statements\n    sample_tuple = (1, 2, 3, 'a', 'b', 'c')\n    assert element_exists_in_tuple(sample_tuple, 2) is True\n    assert element_exists_in_tuple(sample_tuple, 'x') is False\n    print(\"All assertions passed.\")"}
{"task_id": "Mbpp/406", "solution": "def is_odd_parity(n: int) -> bool:\n    \"\"\"Determine if the parity of integer n is odd.\n\n    Parameters:\n        n (int): Integer value (signed 64-bit).\n\n    Returns:\n        bool: True if parity is odd, False otherwise.\n    \"\"\"\n    val = abs(n)\n    parity = False\n    while val:\n        parity ^= True\n        val &= val - 1\n    return parity"}
{"task_id": "Mbpp/409", "solution": "def min_tuple_product(pairs: list[tuple[float | int, float | int]]) -> float:\n    \"\"\"Return the smallest product of two\u2011element numeric tuples in `pairs`.\n\n    Parameters\n    ----------\n    pairs : list[tuple[float | int, float | int]]\n        A list where each element is a 2\u2011tuple containing integers or floats.\n\n    Returns\n    -------\n    float\n        The minimum product computed as x * y for each tuple (x, y).\n\n    Raises\n    ------\n    ValueError\n        If `pairs` is empty.\n    TypeError\n        If any element of `pairs` is not a 2\u2011tuple of numbers.\n    \"\"\"\n    if not pairs:\n        raise ValueError(\"Input list is empty\")\n\n    min_product: float | None = None\n\n    for element in pairs:\n        if not (isinstance(element, tuple) and len(element) == 2):\n            raise TypeError(f\"Invalid element {element!r}: must be a 2\u2011tuple\")\n\n        x, y = element\n\n        if not (isinstance(x, (int, float)) and isinstance(y, (int, float))):\n            raise TypeError(\n                f\"Tuple elements must be int or float, got {type(x).__name__} and {type(y).__name__}\"\n            )\n\n        product = x * y\n\n        if min_product is None or product < min_product:\n            min_product = product\n\n    # min_product is guaranteed to be set because pairs is non-empty\n    return float(min_product) if isinstance(min_product, int) else min_product"}
