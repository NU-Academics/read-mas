{"task_id": "Mbpp/18", "solution": "def remove_dirty_chars(source: str, filter: str) -> str:\n    \"\"\"\n    Remove all characters from `source` that appear in `filter`.\n\n    Parameters\n    ----------\n    source : str\n        The string to cleanse.\n    filter : str\n        The string containing characters to be removed from `source`.\n\n    Returns\n    -------\n    str\n        The cleaned string with all filter characters omitted.\n\n    Raises\n    ------\n    TypeError\n        If either `source` or `filter` is not a string.\n    \"\"\"\n    if not isinstance(source, str):\n        raise TypeError(f\"source must be a str, got {type(source).__name__}\")\n    if not isinstance(filter, str):\n        raise TypeError(f\"filter must be a str, got {type(filter).__name__}\")\n\n    filter_set = set(filter)\n    result_chars = [c for c in source if c not in filter_set]\n    return \"\".join(result_chars)"}
{"task_id": "Mbpp/19", "solution": "from typing import Iterable, TypeVar, Set\nT = TypeVar(\"T\")\ndef test_duplicate(array: Iterable[T]) -> bool:\n    \"\"\"\n    Determine whether the given iterable contains duplicate elements.\n\n    Parameters\n    ----------\n    array : Iterable[T]\n        An iterable of hashable items to examine for duplicates.\n\n    Returns\n    -------\n    bool\n        True if any element appears more than once in the iterable;\n        False otherwise.\n\n    Examples\n    --------\n    >>> test_duplicate([1, 2, 3, 4])\n    False\n    >>> test_duplicate([1, 2, 3, 2])\n    True\n    >>> test_duplicate(('a', 'b', 'c'))\n    False\n    >>> test_duplicate(('a', 'b', 'a'))\n    True\n    \"\"\"\n    seen: Set[T] = set()\n    for item in array:\n        if item in seen:\n            return True\n        seen.add(item)\n    return False"}
{"task_id": "Mbpp/20", "solution": "def is_woodall(num: int) -> bool:\n    \"\"\"\n    Determines whether `num` is a Woodall number (n * 2^n - 1 for some n >= 1).\n\n    Parameters:\n        num (int): The number to test.\n\n    Returns:\n        bool: True if `num` is a Woodall number, False otherwise.\n\n    Raises:\n        ValueError: If `num` is not an integer.\n    \"\"\"\n    if not isinstance(num, int):\n        raise ValueError(\"Input must be an integer.\")\n    if num < 1:\n        return False\n\n    n = 1\n    woodall = n * (1 << n) - 1\n    while woodall < num:\n        n += 1\n        woodall = n * (1 << n) - 1\n    return woodall == num"}
{"task_id": "Mbpp/56", "solution": "def reverse(n: int) -> int:\n    \"\"\"\n    Reverse the decimal digits of a non\u2011negative integer.\n\n    Leading zeros in the reversed representation are discarded automatically\n    by the integer conversion.\n\n    Parameters\n    ----------\n    n : int\n        The integer to reverse. Must be non\u2011negative; negative values are\n        interpreted by the caller (check) as an error condition.\n\n    Returns\n    -------\n    int\n        The integer formed by reversing the decimal digits of `n`.\n\n    Examples\n    --------\n    >>> reverse(123)\n    321\n    >>> reverse(0)\n    0\n    >>> reverse(100)\n    1\n    \"\"\"\n    if n < 0:\n        raise ValueError(\"reverse() expects a non-negative integer\")\n    # String conversion is O(d) in time and space, which satisfies the\n    # performance and memory constraints for this problem.\n    return int(str(n)[::-1])\ndef check(n: int) -> bool:\n    \"\"\"\n    Determine if an integer satisfies the relation n == 2 * reverse(n) - 1.\n\n    Parameters\n    ----------\n    n : int\n        Integer to test. Negative values are considered invalid for the\n        relation and result in False. Non\u2011int inputs raise TypeError.\n\n    Returns\n    -------\n    bool\n        True if the relation holds, False otherwise.\n\n    Raises\n    ------\n    TypeError\n        If the input is not of type int.\n\n    Examples\n    --------\n    >>> check(21)\n    False\n    >>> check(23)\n    False\n    >>> check(0)\n    False\n    >>> check(-5)\n    False\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(f\"check() expected int, got {type(n).__name__}\")\n    if n < 0:\n        return False\n    rev = reverse(n)\n    return n == 2 * rev - 1"}
{"task_id": "Mbpp/57", "solution": "from typing import List\ndef find_Max_Num(digits: List[int]) -> int:\n    \"\"\"\n    Return the largest integer obtainable by arranging the input digits\n    in descending order.\n\n    Parameters\n    ----------\n    digits : List[int]\n        List containing integer digits 0-9.\n\n    Returns\n    -------\n    int\n        Largest integer formed from the digits.  Empty or all\u2011zero lists\n        yield 0.\n\n    Raises\n    ------\n    TypeError\n        If the argument is not a list.\n    ValueError\n        If any element is not an int or not in 0-9.\n    \"\"\"\n    if not isinstance(digits, list):\n        raise TypeError(f\"Input must be a list, got {type(digits).__name__}\")\n\n    for idx, d in enumerate(digits):\n        if not isinstance(d, int):\n            raise ValueError(f\"Element at index {idx} is not an int: {d}\")\n        if d < 0 or d > 9:\n            raise ValueError(f\"Element at index {idx} out of range 0-9: {d}\")\n\n    if not digits or all(d == 0 for d in digits):\n        return 0\n\n    sorted_digits = sorted(digits, reverse=True)\n    num_str = \"\".join(str(d) for d in sorted_digits)\n    return int(num_str)"}
{"task_id": "Mbpp/58", "solution": "def opposite_Signs(a: int, b: int) -> bool:\n    \"\"\"\n    Determine whether two integers have opposite signs.\n\n    Parameters\n    ----------\n    a : int\n        First integer.\n    b : int\n        Second integer.\n\n    Returns\n    -------\n    bool\n        True if one integer is positive and the other is negative,\n        False otherwise.\n\n    Raises\n    ------\n    TypeError\n        If either a or b is not an instance of int.\n    \"\"\"\n    if not isinstance(a, int) or not isinstance(b, int):\n        raise TypeError(\"Both arguments must be integers.\")\n    sign_a = 1 if a > 0 else (-1 if a < 0 else 0)\n    sign_b = 1 if b > 0 else (-1 if b < 0 else 0)\n    return sign_a * sign_b == -1"}
{"task_id": "Mbpp/59", "solution": "import math\nMAX_INT64 = 9223372036854775807\ndef is_octagonal(k: int) -> bool:\n    \"\"\"\n    Returns True if k is an octagonal number, False otherwise.\n    Raises ValueError if k <= 0.\n    Raises OverflowError if intermediate computations overflow a signed 64\u2011bit integer.\n    \"\"\"\n    if k <= 0:\n        raise ValueError(\"k must be a positive integer\")\n    # Compute discriminant D = 4 + 12*k\n    try:\n        D = 4 + 12 * k\n    except OverflowError:\n        raise OverflowError(\"intermediate overflow while computing discriminant\")\n    if D < 0 or D > MAX_INT64:\n        # D must be non\u2011negative and within 64\u2011bit range\n        return False\n    sqrtD = math.isqrt(D)\n    if sqrtD * sqrtD != D:\n        return False\n    if (2 + sqrtD) % 6 != 0:\n        return False\n    n = (2 + sqrtD) // 6\n    return n >= 1"}
{"task_id": "Mbpp/61", "solution": "def count_Substrings(s: str) -> int:\n    \"\"\"Count contiguous substrings of a digit string where\n    the sum of digits equals the substring length.\n\n    Parameters:\n        s (str): A string consisting solely of characters '0'-'9'.\n\n    Returns:\n        int: Number of qualifying substrings.\n\n    Raises:\n        ValueError: If s contains non-digit characters.\n    \"\"\"\n    if not all(c.isdigit() for c in s):\n        raise ValueError(\"Input must contain only digits\")\n\n    pref = 0\n    result = 0\n    cnt_map = {0: 1}  # T_0 = 0\n\n    for k in range(1, len(s) + 1):\n        pref += int(s[k - 1])\n        t_k = pref - (k - 1)\n        result += cnt_map.get(t_k, 0)\n        cnt_map[t_k] = cnt_map.get(t_k, 0) + 1\n\n    return result"}
