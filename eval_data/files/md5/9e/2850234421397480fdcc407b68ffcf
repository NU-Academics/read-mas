{"task_id": "Mbpp/239", "solution": "def get_total_number_of_sequences(n, m):\n    \"\"\"\n    Count strictly increasing sequences of length n of positive integers <= m,\n    where each element is at least twice the previous one.\n\n    Parameters\n    ----------\n    n : int\n        Length of the sequence (n >= 1).\n    m : int\n        Upper bound on the elements (m >= 1).\n\n    Returns\n    -------\n    int\n        Number of valid sequences.\n\n    Raises\n    ------\n    ValueError\n        If n < 1 or m < 1.\n    \"\"\"\n    if n < 1 or m < 1:\n        raise ValueError(\"Both n and m must be positive integers (n >= 1, m >= 1).\")\n\n    # dp[i] holds number of valid sequences of current length ending with value i\n    size = m + 2  # indices 0..m+1; index 0 unused, m+1 is sentinel\n    dp = [0] * size\n    dp_new = [0] * size\n    suffix = [0] * size\n\n    # Base case: length 1, each value from 1..m can start a sequence\n    for i in range(1, m + 1):\n        dp[i] = 1\n\n    # Iterate positions 2..n\n    for _ in range(2, n + 1):\n        # Compute suffix sums of dp\n        suffix[m + 1] = 0  # sentinel\n        for j in range(m, 0, -1):\n            suffix[j] = dp[j] + suffix[j + 1]\n\n        # Update dp_new based on recurrence\n        for i in range(1, m + 1):\n            next_val = 2 * i\n            if next_val <= m:\n                dp_new[i] = suffix[next_val]\n            else:\n                dp_new[i] = 0\n\n        # Prepare for next iteration\n        dp, dp_new = dp_new, dp\n        # Clear dp_new for reuse\n        for i in range(1, m + 1):\n            dp_new[i] = 0\n\n    # Sum all counts for final length\n    total = 0\n    for i in range(1, m + 1):\n        total += dp[i]\n    return total"}
{"task_id": "Mbpp/240", "solution": "from typing import Any, Sequence\nfrom collections.abc import Sequence as ABCSequence\ndef replace_list(first: Sequence[Any], second: Sequence[Any]) -> list[Any]:\n    \"\"\"Replace the last element of `first` with all elements of `second`.\n\n    Parameters\n    ----------\n    first : Sequence[Any]\n        The original sequence whose last element will be replaced.\n    second : Sequence[Any]\n        The sequence whose elements will be inserted in place of the last element.\n\n    Returns\n    -------\n    list[Any]\n        A new list containing the elements of `first` except its last element,\n        followed by the elements of `second`.\n\n    Raises\n    ------\n    TypeError\n        If either `first` or `second` is not a sequence.\n    ValueError\n        If `first` is empty.\n\n    Examples\n    --------\n    >>> replace_list([1, 2, 3], ['a', 'b'])\n    [1, 2, 'a', 'b']\n\n    >>> replace_list(['x'], [1, 2, 3])\n    [1, 2, 3]\n    \"\"\"\n    if not isinstance(first, ABCSequence):\n        raise TypeError(\n            f\"First parameter must be a sequence, got {type(first).__name__}.\"\n        )\n    if not isinstance(second, ABCSequence):\n        raise TypeError(\n            f\"Second parameter must be a sequence, got {type(second).__name__}.\"\n        )\n    if len(first) == 0:\n        raise ValueError(\"First list cannot be empty.\")\n\n    # Construct result without modifying original inputs\n    result = list(first[:-1])  # all elements except the last\n    result.extend(list(second))\n    return result"}
{"task_id": "Mbpp/242", "solution": "from typing import Optional\ndef count_charac(input_str: Optional[str]) -> int:\n    \"\"\"Count the number of characters in a string.\n\n    Parameters\n    ----------\n    input_str : Optional[str]\n        The string to be processed. If None, the function returns 0.\n\n    Returns\n    -------\n    int\n        The number of characters in input_str.\n\n    Raises\n    ------\n    TypeError\n        If input_str is not a str or None.\n\n    Examples\n    --------\n    >>> count_charac(\"hello\")\n    5\n    >>> count_charac(\"\")\n    0\n    >>> count_charac(None)\n    0\n    \"\"\"\n    if input_str is not None and not isinstance(input_str, str):\n        raise TypeError(\"input_str must be a str or None\")\n    if input_str is None:\n        return 0\n    return len(input_str)"}
