{"task_id": "Mbpp/278", "solution": "from typing import Tuple\ndef count_first_elements(input_tuple: Tuple) -> int:\n    \"\"\"\n    Return the number of elements before the first nested tuple in a tuple.\n\n    Parameters\n    ----------\n    input_tuple : tuple\n        The tuple to search. Must contain at least one element.\n\n    Returns\n    -------\n    int\n        Index of the first element that is a tuple. If no nested tuple\n        exists, returns len(input_tuple).\n\n    Raises\n    ------\n    TypeError\n        If *input_tuple* is not a tuple.\n    ValueError\n        If *input_tuple* is empty.\n    \"\"\"\n    if not isinstance(input_tuple, tuple):\n        raise TypeError(f\"input must be a tuple, got {type(input_tuple).__name__}\")\n\n    if len(input_tuple) == 0:\n        raise ValueError(\"input tuple must contain at least one element\")\n\n    for idx, elem in enumerate(input_tuple):\n        if isinstance(elem, tuple):\n            return idx\n    return len(input_tuple)"}
{"task_id": "Mbpp/279", "solution": "def is_num_decagonal(n: int) -> int:\n    \"\"\"Return the nth decagonal number.\n\n    The decagonal numbers form the sequence:\n        1, 10, 27, 52, 85, ...\n\n    The closed\u2011form formula for the nth decagonal number (where n >= 1) is:\n        D(n) = 4*n^2 - 3*n\n\n    Parameters\n    ----------\n    n : int\n        The index of the decagonal number to compute. Must be a positive integer.\n\n    Returns\n    -------\n    int\n        The value of the nth decagonal number.\n\n    Raises\n    ------\n    ValueError\n        If `n` is not an integer or is less than 1.\n\n    Examples\n    --------\n    >>> is_num_decagonal(1)\n    1\n    >>> is_num_decagonal(3)\n    27\n    >>> assert is_num_decagonal(3) == 27\n    \"\"\"\n    if not isinstance(n, int):\n        raise ValueError(f\"Input must be an integer, got {type(n).__name__}\")\n    if n < 1:\n        raise ValueError(f\"Input must be a positive integer (n >= 1), got {n}\")\n    return 4 * n * n - 3 * n"}
{"task_id": "Mbpp/280", "solution": "from typing import Sequence, Tuple, TypeVar\nT = TypeVar(\"T\")\ndef sequential_search(array: Sequence[T], target: T, zero_based: bool = True) -> Tuple[bool, int]:\n    \"\"\"\n    Performs a linear search over ``array`` for ``target``.\n\n    Parameters\n    ----------\n    array : Sequence[T]\n        The sequence to search.\n    target : T\n        The element to locate.\n    zero_based : bool, optional\n        If True, returns zero\u2011based index; if False, returns one\u2011based index.\n\n    Returns\n    -------\n    Tuple[bool, int]\n        ``(found, index)``.  Index is ``-1`` if not found.\n\n    Raises\n    ------\n    TypeError\n        If ``array`` is not a sequence.\n    ValueError\n        If ``zero_based`` is not a boolean.\n    \"\"\"\n    if not isinstance(array, Sequence):\n        raise TypeError(\"array must be a sequence\")\n    if not isinstance(zero_based, bool):\n        raise ValueError(\"zero_based must be a boolean\")\n\n    for idx, element in enumerate(array):\n        try:\n            if element == target:\n                return True, idx if zero_based else idx + 1\n        except Exception:\n            # Element not comparable; treat as non\u2011match and continue\n            continue\n\n    return False, -1"}
{"task_id": "Mbpp/281", "solution": "from typing import Any, List\ndef all_unique(items: List[Any]) -> bool:\n    \"\"\"Determine whether all elements in the provided list are unique.\n\n    Parameters\n    ----------\n    items : List[Any]\n        The list of elements to evaluate. Elements must be hashable.\n\n    Returns\n    -------\n    bool\n        True if all elements are unique, False otherwise.\n\n    Raises\n    ------\n    TypeError\n        If `items` is not a list.\n    TypeError\n        If any element in `items` is unhashable.\n\n    Examples\n    --------\n    >>> all_unique([1, 2, 3])\n    True\n    >>> all_unique([1, 2, 2])\n    False\n    >>> all_unique([])\n    True\n    >>> all_unique([1, [2]])\n    Traceback (most recent call last):\n        ...\n    TypeError: Unhashable element detected at index 1.\n    \"\"\"\n    if not isinstance(items, list):\n        raise TypeError(f\"Input must be a list, got {type(items).__name__}.\")\n\n    seen: set[Any] = set()\n    for index, element in enumerate(items):\n        try:\n            hash(element)\n        except TypeError:\n            raise TypeError(f\"Unhashable element detected at index {index}.\") from None\n        seen.add(element)\n\n    return len(seen) == len(items)"}
{"task_id": "Mbpp/282", "solution": "from typing import Sequence, List, Union\nfrom numbers import Number\ndef sub_list(list1: Sequence[Number], list2: Sequence[Number]) -> List[Number]:\n    \"\"\"\n    Perform element\u2011wise subtraction of two numeric sequences of equal length.\n\n    Parameters\n    ----------\n    list1 : Sequence[Number]\n        First input sequence of numeric values.\n    list2 : Sequence[Number]\n        Second input sequence of numeric values.\n\n    Returns\n    -------\n    List[Number]\n        A new list where each element is the difference of the corresponding\n        elements from ``list1`` and ``list2``.\n\n    Raises\n    ------\n    ValueError\n        If either input is ``None`` or empty, or if the lengths differ.\n    TypeError\n        If any element in either sequence is not an ``int`` or ``float``.\n        The error message will include the index of the first offending element.\n\n    Examples\n    --------\n    >>> sub_list([10, 20, 30], [1, 2, 3])\n    [9, 18, 27]\n\n    >>> sub_list([1.5, 2.5], [0.5, 1.5])\n    [1.0, 1.0]\n    \"\"\"\n    _validate(list1, list2)\n    return _compute(list1, list2)\ndef _compute(list1: Sequence[Number], list2: Sequence[Number]) -> List[Number]:\n    return [a - b for a, b in zip(list1, list2)]"}
{"task_id": "Mbpp/283", "solution": "def validate(number: int) -> bool:\n    \"\"\"\n    Validates that for each digit d in |number|, its frequency is \u2264 d.\n    Zero digit causes immediate failure.\n    \"\"\"\n    num = abs(number)\n    if num == 0:\n        return False\n    freq = [0] * 10\n    while num > 0:\n        d = num % 10\n        if d == 0:\n            return False\n        freq[d] += 1\n        if freq[d] > d:\n            return False\n        num //= 10\n    return True"}
