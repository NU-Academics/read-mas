{"task_id": "Mbpp/732", "solution": "def replace_specialchar(input_str: str) -> str:\n    \"\"\"Replace all spaces, commas, and dots in `input_str` with a colon.\n\n    Parameters\n    ----------\n    input_str : str\n        The original string to sanitize.\n\n    Returns\n    -------\n    str\n        A new string with the specified characters replaced by ':'.\n\n    Raises\n    ------\n    TypeError\n        If `input_str` is not a string.\n    \"\"\"\n    _validate_input(input_str)\n\n    buffer = []\n\n    for ch in input_str:\n        if ch in {\" \", \",\", \".\"}:\n            buffer.append(\":\")\n        else:\n            buffer.append(ch)\n\n    return \"\".join(buffer)"}
{"task_id": "Mbpp/733", "solution": "import typing\nT = typing.TypeVar(\"T\")\ndef find_first_occurrence(arr: typing.List[T], target: T) -> typing.Optional[int]:\n    \"\"\"\n    Find the index of the first occurrence of ``target`` in a sorted list ``arr``.\n\n    The function performs a binary search, achieving O(log\u202fn) time complexity.\n    If ``target`` is not present, ``None`` is returned.\n\n    Parameters\n    ----------\n    arr : list\n        A list sorted in non\u2011decreasing order.\n    target : Any\n        The value to locate in ``arr``. Must support comparison operators.\n\n    Returns\n    -------\n    int or None\n        Zero\u2011based index of the first occurrence of ``target``; ``None`` if not found.\n\n    Raises\n    ------\n    TypeError\n        If ``arr`` is not a list or if ``target`` cannot be compared with elements of ``arr``.\n    \"\"\"\n    if not isinstance(arr, list):\n        raise TypeError(\"arr must be a list\")\n\n    if len(arr) == 0:\n        return None\n\n    # Ensure target is comparable to list elements\n    try:\n        _ = arr[0] == target\n    except Exception as exc:\n        raise TypeError(\"target is not comparable to elements of arr\") from exc\n\n    left, right = 0, len(arr) - 1\n    result = None\n\n    while left <= right:\n        mid = (left + right) // 2\n        mid_val = arr[mid]\n\n        if mid_val == target:\n            result = mid\n            right = mid - 1  # search left half for earlier occurrence\n        elif mid_val < target:\n            left = mid + 1\n        else:\n            right = mid - 1\n\n    return result"}
{"task_id": "Mbpp/734", "solution": "from typing import List, Any\ndef sum_Of_Subarray_Prod(arr: List[int]) -> int:\n    \"\"\"\n    Compute the sum of products of all contiguous subarrays of a list of integers.\n\n    Parameters\n    ----------\n    arr : List[int]\n        The input list of integers.\n\n    Returns\n    -------\n    int\n        Sum of the products of all contiguous subarrays. Returns 0 for an empty list.\n\n    Raises\n    ------\n    TypeError\n        If `arr` is not a list or if any element in `arr` is not an integer.\n\n    Examples\n    --------\n    >>> sum_Of_Subarray_Prod([1, 2, 3])\n    20\n    >>> sum_Of_Subarray_Prod([])\n    0\n    \"\"\"\n    _validate_input(arr)\n\n    if not arr:\n        return 0\n\n    return _compute_dp_and_sum(arr)\ndef _compute_dp_and_sum(arr: List[int]) -> int:\n    prev_dp = 0\n    total_sum = 0\n\n    for x in arr:\n        current_dp = x * (1 + prev_dp)\n        total_sum += current_dp\n        prev_dp = current_dp\n\n    return total_sum"}
{"task_id": "Mbpp/735", "solution": "def toggle_middle_bits(n: int) -> int:\n    \"\"\"\n    Toggle every bit of a non\u2011negative integer except the most and least significant bits.\n\n    Parameters\n    ----------\n    n : int\n        Non\u2011negative integer whose middle bits are to be toggled.\n\n    Returns\n    -------\n    int\n        Integer with all middle bits toggled; the outer bits remain unchanged.\n        Numbers with 0, 1, or 2 bits are returned unchanged.\n\n    Raises\n    ------\n    ValueError\n        If ``n`` is negative.\n\n    Examples\n    --------\n    >>> toggle_middle_bits(5)   # 5 is 0b101\n    1                     # toggled middle bit -> 0b001\n    >>> toggle_middle_bits(10)  # 10 is 0b1010\n    12                    # toggled middle bits -> 0b1100\n    >>> toggle_middle_bits(65533)  # 16\u2011bit example\n    65531\n    \"\"\"\n    if n < 0:\n        raise ValueError(\"n must be non-negative\")\n\n    bit_len = n.bit_length()\n    if bit_len <= 2:\n        return n\n\n    full_mask = (1 << bit_len) - 1\n    outer_mask = (1 << (bit_len - 1)) | 1\n    middle_mask = full_mask ^ outer_mask\n\n    return n ^ middle_mask"}
{"task_id": "Mbpp/736", "solution": "from typing import List, TypeVar\nT = TypeVar('T')\ndef left_insertion(arr: List[T], value: T) -> int:\n    \"\"\"\n    Return the leftmost index at which `value` can be inserted into `arr`\n    to keep `arr` sorted.\n\n    Parameters\n    ----------\n    arr : List[T]\n        A list sorted in non-decreasing order.  `T` must support\n        comparison operators (<, <=, >, >=).\n    value : T\n        The value to insert.\n\n    Returns\n    -------\n    int\n        The insertion index (0\u2011based).  If `value` is greater than all\n        elements, the returned index equals len(arr).\n    \"\"\"\n    low = 0\n    high = len(arr)\n    while low < high:\n        mid = (low + high) // 2\n        if arr[mid] < value:\n            low = mid + 1\n        else:\n            high = mid\n    return low"}
{"task_id": "Mbpp/737", "solution": "import re\n_VOWEL_START_RE = re.compile(r'^[aeiou]', re.IGNORECASE)\ndef check_str(input_str: str) -> bool:\n    \"\"\"Check if the provided string starts with a vowel.\n\n    Args:\n        input_str (str): The string to evaluate.\n\n    Returns:\n        bool: True if the string starts with a vowel, False otherwise.\n\n    Raises:\n        TypeError: If input_str is not a string.\n    \"\"\"\n    if not isinstance(input_str, str):\n        raise TypeError(\"input_str must be a string\")\n    return bool(_VOWEL_START_RE.match(input_str))"}
{"task_id": "Mbpp/739", "solution": "import math\ndef find_Index(n: int) -> int:\n    \"\"\"\n    Return the smallest integer k such that the triangular number T_k = k*(k+1)/2\n    has exactly n decimal digits.\n\n    Parameters\n    ----------\n    n : int\n        Desired number of decimal digits (must be a positive integer).\n\n    Returns\n    -------\n    int\n        The smallest k satisfying the digit requirement.\n\n    Raises\n    ------\n    ValueError\n        If n is not a positive integer.\n    \"\"\"\n    if not isinstance(n, int) or n <= 0:\n        raise ValueError(\"n must be a positive integer\")\n\n    power = 10 ** (n - 1)                 # 10^(n-1)\n    discriminant = 1 + 8 * power          # D = 1 + 8 * 10^(n-1)\n    sqrt_D = math.isqrt(discriminant)     # floor(sqrt(D))\n    if sqrt_D * sqrt_D < discriminant:\n        sqrt_D += 1                       # ceil(sqrt(D))\n\n    num = sqrt_D - 1\n    k_min = (num + 1) // 2                # ceil(num / 2)\n\n    return k_min"}
{"task_id": "Mbpp/740", "solution": "from typing import Any, Dict, Tuple\ndef tuple_to_dict(data: Tuple[Any, ...]) -> Dict[Any, Any]:\n    \"\"\"Convert a tuple of adjacent elements into a dictionary.\n\n    Args:\n        data: A tuple containing an even number of elements. Every two\n              consecutive elements are interpreted as a key/value pair.\n\n    Returns:\n        A dictionary mapping each odd-indexed element (key) to the next\n        element (value). Duplicate keys are allowed; the last occurrence\n        wins.\n\n    Raises:\n        TypeError: If ``data`` is not a tuple.\n        ValueError: If ``data`` has an odd length.\n        TypeError: If any key is unhashable.\n    \"\"\"\n    if not isinstance(data, tuple):\n        raise TypeError(\"Input must be a tuple.\")\n\n    if len(data) % 2 != 0:\n        raise ValueError(\"Tuple length must be even.\")\n\n    result: Dict[Any, Any] = {}\n    for i in range(0, len(data), 2):\n        key = data[i]\n        value = data[i + 1]\n        try:\n            hash(key)\n        except TypeError:\n            raise TypeError(f\"Key at index {i} is unhashable.\") from None\n        result[key] = value\n\n    return result"}
{"task_id": "Mbpp/741", "solution": "from typing import Final\ndef all_Characters_Same(s: str) -> bool:\n    \"\"\"\n    Determine whether all characters in the string are identical.\n\n    Parameters\n    ----------\n    s : str\n        Input string to evaluate.\n\n    Returns\n    -------\n    bool\n        True if the string is empty or all characters are the same; False otherwise.\n\n    Examples\n    --------\n    >>> all_Characters_Same(\"\")\n    True\n    >>> all_Characters_Same(\"aaaa\")\n    True\n    >>> all_Characters_Same(\"aabb\")\n    False\n    \"\"\"\n    if not s:\n        return True\n\n    first_char = s[0]\n    for char in s[1:]:\n        if char != first_char:\n            return False\n    return True"}
{"task_id": "Mbpp/742", "solution": "import math\nfrom typing import Union\ndef area_tetrahedron(edge_length: float) -> float:\n    \"\"\"\n    Compute the surface area of a regular tetrahedron.\n\n    The surface area A of a regular tetrahedron with edge length a is\n    given by:\n        A = sqrt(3) * a**2\n\n    Parameters\n    ----------\n    edge_length : float\n        Length of one edge of the tetrahedron. Must be a positive real number.\n\n    Returns\n    -------\n    float\n        Surface area of the tetrahedron.\n\n    Raises\n    ------\n    TypeError\n        If ``edge_length`` is not a numeric type.\n    ValueError\n        If ``edge_length`` is not a positive number.\n\n    Examples\n    --------\n    >>> area_tetrahedron(1.0)\n    1.7320508075688772\n    >>> area_tetrahedron(2.0)\n    6.928203230275509\n    \"\"\"\n    if not isinstance(edge_length, (int, float)):\n        raise TypeError(\n            f\"edge_length must be a numeric type, got {type(edge_length).__name__}\"\n        )\n    if edge_length <= 0:\n        raise ValueError(\n            f\"edge_length must be positive, got {edge_length!r}\"\n        )\n    return math.sqrt(3) * (edge_length ** 2)"}
{"task_id": "Mbpp/743", "solution": "from collections.abc import Sequence\nfrom typing import TypeVar\nT = TypeVar(\"T\")\ndef rotate_right(seq: Sequence[T], k: int) -> Sequence[T]:\n    \"\"\"\n    Rotates a sequence to the right by *k* positions.\n\n    Parameters\n    ----------\n    seq : Sequence[T]\n        The input sequence to rotate.\n    k : int\n        Number of positions to rotate. Negative values rotate left.\n\n    Returns\n    -------\n    Sequence[T]\n        A new sequence of the same type with elements rotated right.\n\n    Raises\n    ------\n    TypeError\n        If *seq* is not a Sequence or *k* is not an int.\n    ValueError\n        If *seq* is empty.\n    \"\"\"\n    if not isinstance(seq, Sequence):\n        raise TypeError(\"seq must be a Sequence\")\n    if not isinstance(k, int):\n        raise TypeError(\"k must be an int\")\n\n    n = len(seq)\n    if n == 0:\n        raise ValueError(\"Cannot rotate an empty sequence.\")\n\n    k %= n\n    if k == 0:\n        return seq[:]\n\n    right = seq[-k:]\n    left = seq[:-k]\n    rotated = right + left\n\n    if isinstance(seq, tuple):\n        return tuple(rotated)\n    if isinstance(seq, list):\n        return list(rotated)\n\n    try:\n        return type(seq)(rotated)\n    except Exception:\n        return rotated[:]"}
{"task_id": "Mbpp/744", "solution": "from typing import Any\ndef check_none(item: tuple[Any, ...]) -> bool:\n    \"\"\"\n    Detects whether any element in a tuple is the `None` object.\n\n    Parameters\n    ----------\n    item : tuple[Any, ...]\n        The tuple to examine. Must be a tuple; otherwise a `TypeError` is raised.\n\n    Returns\n    -------\n    bool\n        `True` if at least one element of *item* is `None`, otherwise `False`.\n\n    Examples\n    --------\n    >>> check_none((1, 2, None))\n    True\n    >>> check_none((1, 2, 3))\n    False\n    \"\"\"\n    if not isinstance(item, tuple):\n        raise TypeError(f\"Expected a tuple, got {type(item).__name__}\")\n\n    for element in item:\n        if element is None:\n            return True\n    return False"}
{"task_id": "Mbpp/745", "solution": "from typing import List\ndef divisible_by_digits(start: int, end: int) -> List[int]:\n    \"\"\"\n    Return a sorted list of integers in the inclusive range [start, end]\n    such that each integer is divisible by every non\u2011zero digit it contains.\n\n    Parameters\n    ----------\n    start : int\n        Lower bound of the range (must be <= end, non\u2011negative).\n    end : int\n        Upper bound of the range (must be >= start, non\u2011negative).\n\n    Returns\n    -------\n    List[int]\n        Ascending list of qualifying integers.\n\n    Raises\n    ------\n    ValueError\n        If inputs are not integers, start > end, or negative values.\n    \"\"\"\n    if not isinstance(start, int) or not isinstance(end, int):\n        raise ValueError(\"Both start and end must be integers.\")\n    if start < 0 or end < 0:\n        raise ValueError(\"Both start and end must be non-negative.\")\n    if start > end:\n        raise ValueError(\"start must be less than or equal to end.\")\n\n    result: List[int] = []\n\n    for num in range(start, end + 1):\n        temp = num\n        # Special case: 0 has no non\u2011zero digits; treat as valid.\n        if temp == 0:\n            result.append(num)\n            continue\n\n        digits: List[int] = []\n        while temp > 0:\n            digit = temp % 10\n            if digit != 0:\n                digits.append(digit)\n            temp //= 10\n\n        if all(num % d == 0 for d in digits):\n            result.append(num)\n\n    return result"}
{"task_id": "Mbpp/748", "solution": "def capital_words_spaces(input_str: str) -> str:\n    \"\"\"Inserts a single space before each capital letter in an input string,\n    except when the capital letter starts the string.\"\"\"\n    result = []\n    for i, c in enumerate(input_str):\n        if c.isupper() and i > 0:\n            result.append(' ')\n        result.append(c)\n    return ''.join(result)"}
{"task_id": "Mbpp/749", "solution": "import re\nfrom typing import Iterable, List, Callable, Any, Optional\n_NUMERIC_STRING_PATTERN = re.compile(r'^\\s*[+-]?\\d+\\s*$')\ndef _is_valid_numeric_string(value: str) -> bool:\n    \"\"\"Return True if *value* is a valid numeric string according to the specification.\"\"\"\n    return bool(_NUMERIC_STRING_PATTERN.match(value))\ndef _convert_to_int(value: str) -> int:\n    \"\"\"Convert a validated numeric string to an integer.\"\"\"\n    return int(value.strip())\ndef sort_numeric_strings(\n    values: Iterable[str],\n    *,\n    reverse: bool = False,\n    key: Optional[Callable[[int], Any]] = None\n) -> List[int]:\n    \"\"\"Sorts a list of numeric strings numerically.\n\n    Parameters\n    ----------\n    values : Iterable[str]\n        Iterable of numeric string representations.\n    reverse : bool, optional\n        If True, sort in descending order. Default is False.\n    key : Callable[[int], Any], optional\n        Optional key function applied to each integer before sorting.\n\n    Returns\n    -------\n    List[int]\n        New list of sorted integers.\n\n    Raises\n    ------\n    TypeError\n        If `values` is not a list or tuple of strings.\n    ValueError\n        If any element in `values` is not a valid numeric string.\n    \"\"\"\n    if not isinstance(values, (list, tuple)):\n        raise TypeError(f\"Expected list or tuple, got {type(values).__name__}\")\n\n    converted: List[int] = []\n    for idx, item in enumerate(values):\n        if not isinstance(item, str):\n            raise TypeError(f\"Element at index {idx} is not a string: {item!r}\")\n        if not _is_valid_numeric_string(item):\n            raise ValueError(f\"Invalid numeric string at index {idx}: {item!r}\")\n        converted.append(_convert_to_int(item))\n\n    return sorted(converted, reverse=reverse, key=key)"}
{"task_id": "Mbpp/750", "solution": "def add_tuple(lst: list, tup: tuple) -> list:\n    \"\"\"\n    Append elements from the tuple to a new list.\n\n    Parameters:\n        lst (list): The original list.\n        tup (tuple): The tuple whose elements are to be appended.\n\n    Returns:\n        list: New list containing elements of lst followed by elements of tup.\n\n    Raises:\n        TypeError: If lst is not a list or tup is not a tuple.\n    \"\"\"\n    if not isinstance(lst, list):\n        raise TypeError(\"First argument must be a list\")\n    if not isinstance(tup, tuple):\n        raise TypeError(\"Second argument must be a tuple\")\n    result = list(lst)\n    result.extend(tup)\n    return result"}
