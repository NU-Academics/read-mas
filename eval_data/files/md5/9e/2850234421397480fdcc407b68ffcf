{"task_id": "Mbpp/7", "solution": "from typing import Set\ndef find_char_long(input_string: str) -> Set[str]:\n    \"\"\"Return a set of words with length >= 4 from ``input_string``.\n\n    Words are defined as sequences separated by whitespace. Punctuation\n    characters are treated as part of a word, so ``\"test,\"`` has a length\n    of five and will be included.\n    \"\"\"\n    words = input_string.split()\n    return {word for word in words if len(word) >= 4}"}
{"task_id": "Mbpp/8", "solution": "from typing import List\ndef square_nums(numbers: List[int]) -> List[int]:\n    \"\"\"\n    Return a list containing the squares of the input integers.\n\n    Parameters\n    ----------\n    numbers : List[int]\n        A list of integers to be squared.\n\n    Returns\n    -------\n    List[int]\n        A new list where each element is the square of the corresponding\n        element from the input list.\n\n    Examples\n    --------\n    >>> square_nums([1, 2, 3])\n    [1, 4, 9]\n\n    Complexity\n    ----------\n    O(n) time and O(n) space, where n is the length of `numbers`.\n    \"\"\"\n    return [x * x for x in numbers]"}
{"task_id": "Mbpp/9", "solution": "from typing import List\ndef _prefix_function(s: str) -> List[int]:\n    \"\"\"Compute the KMP prefix function for *s*.\n\n    Parameters\n    ----------\n    s : str\n        The input string.\n\n    Returns\n    -------\n    List[int]\n        The prefix function array where the ith element contains the\n        length of the longest proper prefix of ``s[:i+1]`` which is also a suffix.\n    \"\"\"\n    n = len(s)\n    pi: List[int] = [0] * n\n    for i in range(1, n):\n        j = pi[i - 1]\n        while j > 0 and s[i] != s[j]:\n            j = pi[j - 1]\n        if s[i] == s[j]:\n            j += 1\n        pi[i] = j\n    return pi\ndef find_Rotations(s: str) -> int:\n    \"\"\"Return the minimal positive rotation count for *s*.\n\n    The rotation count is the minimal period length of the string; rotating the\n    string by that many positions yields the original string.  For an empty\n    string the function returns 0.\n\n    Parameters\n    ----------\n    s : str\n        The string to analyze.\n\n    Returns\n    -------\n    int\n        The minimal positive rotation count.\n\n    Raises\n    ------\n    ValueError\n        If *s* is not a string.\n    \"\"\"\n    if not isinstance(s, str):\n        raise ValueError(\"Input must be a string\")\n    n = len(s)\n    if n == 0:\n        return 0\n    pi = _prefix_function(s)\n    lps = pi[-1]\n    period = n - lps\n    if n % period != 0:\n        period = n\n    return period"}
{"task_id": "Mbpp/11", "solution": "def _validate_inputs(s, c):\n    if not isinstance(s, str):\n        raise ValueError(\"Input 's' must be of type 'str'.\")\n    if not isinstance(c, str) or len(c) != 1:\n        raise ValueError(\"Input 'c' must be a single character string.\")\n\n\ndef _find_occurrence_indices(s, c):\n    first = s.find(c)\n    if first == -1:\n        return None, None\n    last = s.rfind(c)\n    return first, last\n\n\ndef _build_result_string(s, first, last):\n    if first is None:\n        return s\n    if first == last:\n        return s[:first] + s[first + 1 :]\n    return s[:first] + s[first + 1 : last] + s[last + 1 :]\n\n\ndef remove_first_last_occurrence(s: str, c: str) -> str:\n    \"\"\"\n    Remove the first and last occurrence of character `c` from string `s`.\n\n    Parameters:\n        s (str): The source string.\n        c (str): The character to remove (must be a single character).\n\n    Returns:\n        str: The string after removing the first and last occurrences of `c`.\n\n    Raises:\n        ValueError: If `s` is not a string or `c` is not a single character string.\n    \"\"\"\n    _validate_inputs(s, c)\n    first, last = _find_occurrence_indices(s, c)\n    if first is None:\n        return s\n    return _build_result_string(s, first, last)"}
{"task_id": "Mbpp/12", "solution": "def sort_matrix_by_row_sum(matrix):\n    \"\"\"\n    Sorts the rows of a two-dimensional numeric matrix in ascending order\n    based on the sum of the elements in each row. The function returns a\n    new matrix; the input matrix remains unmodified.\n\n    Parameters\n    ----------\n    matrix : list of list of numbers\n        A rectangular matrix with rows of equal length. Each element\n        must support addition.\n\n    Returns\n    -------\n    list of list of numbers\n        A new matrix with rows sorted in non-decreasing order of their sums.\n    \"\"\"\n    if not matrix:\n        return []\n\n    # Compute row sums\n    row_sums = [sum(row) for row in matrix]\n\n    # Create tuples of (sum, original index, row) for stable sorting\n    tuples = [(row_sums[i], i, matrix[i]) for i in range(len(matrix))]\n\n    # Stable sort by sum, then by original index\n    tuples.sort(key=lambda x: (x[0], x[1]))\n\n    # Assemble new matrix with copied rows to avoid side effects\n    sorted_matrix = [list(row) for (_, _, row) in tuples]\n\n    return sorted_matrix"}
{"task_id": "Mbpp/14", "solution": "from typing import Union\nNumeric = Union[int, float]\ndef find_Volume(base: Numeric, height: Numeric, length: Numeric) -> float:\n    \"\"\"\n    Calculate the volume of a triangular prism.\n\n    Parameters\n    ----------\n    base : Numeric\n        Length of the base of the triangular face (must be > 0).\n    height : Numeric\n        Height of the triangular face (must be > 0).\n    length : Numeric\n        Length of the prism along its axis (must be > 0).\n\n    Returns\n    -------\n    float\n        The volume of the triangular prism.\n\n    Raises\n    ------\n    ValueError\n        If any parameter is not numeric or is <= 0.\n\n    Notes\n    -----\n    Volume formula:\n        V = 0.5 * base * height * length\n\n    Examples\n    --------\n    >>> find_Volume(10, 8, 6)\n    240.0\n    \"\"\"\n    for name, value in ((\"base\", base), (\"height\", height), (\"length\", length)):\n        if not isinstance(value, (int, float)):\n            raise ValueError(f\"{name} must be numeric; got {type(value).__name__}\")\n        if value <= 0:\n            raise ValueError(f\"{name} must be positive; got {value}\")\n\n    volume = 0.5 * float(base) * float(height) * float(length)\n    return volume"}
{"task_id": "Mbpp/16", "solution": "def text_lowercase_underscore(input: str) -> bool:\n    \"\"\"Return True if `input` consists of one or more groups of consecutive\n    lowercase letters (a\u2013z) separated by a single underscore (_), otherwise False.\n\n    Parameters\n    ----------\n    input : str\n        The string to validate.\n\n    Returns\n    -------\n    bool\n        True if the string matches the pattern; False otherwise.\n\n    Raises\n    ------\n    TypeError\n        If `input` is not a string.\n\n    Examples\n    --------\n    >>> text_lowercase_underscore(\"aab_cbbbc\")\n    True\n    >>> text_lowercase_underscore(\"Aab_cbbbc\")\n    False\n    \"\"\"\n    if not isinstance(input, str):\n        raise TypeError(\"input must be a string\")\n\n    if not input:\n        return False\n\n    seen_underscore = False\n    prev_char = None\n\n    for c in input:\n        if c == \"_\":\n            if seen_underscore or prev_char == \"_\":\n                return False\n            seen_underscore = True\n        elif 'a' <= c <= 'z':\n            pass\n        else:\n            return False\n        prev_char = c\n\n    return seen_underscore"}
