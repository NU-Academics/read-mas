{"task_id": "Mbpp/797", "solution": "def sum_in_range(l: int, r: int) -> int:\n    if l > r:\n        raise ValueError(\"l must be less than or equal to r\")\n    if l < 1 or r < 1:\n        raise ValueError(\"l and r must be natural numbers (positive integers)\")\n    first_odd = l if l & 1 else l + 1\n    last_odd = r if r & 1 else r - 1\n    if first_odd > last_odd:\n        return 0\n    n = (last_odd - first_odd) // 2 + 1\n    return n * (first_odd + last_odd) // 2"}
{"task_id": "Mbpp/798", "solution": "from decimal import Decimal\nfrom typing import Iterable, Union\ndef _is_numeric(value: object) -> bool:\n    \"\"\"Return True if value is an int, float, or Decimal.\"\"\"\n    return isinstance(value, (int, float, Decimal))\ndef _sum(arr: Iterable[Union[int, float, Decimal]]) -> Union[int, float, Decimal]:\n    \"\"\"\n    Compute the sum of a numeric iterable.\n\n    Parameters\n    ----------\n    arr : Iterable[Union[int, float, Decimal]]\n        An iterable containing numeric values.\n\n    Returns\n    -------\n    Union[int, float, Decimal]\n        The arithmetic sum of all elements.\n\n    Raises\n    ------\n    TypeError\n        If `arr` is not iterable or contains non\u2011numeric elements.\n    \"\"\"\n    _validate_iterable(arr)\n\n    total: Union[int, float, Decimal] = 0\n    for idx, val in enumerate(arr):\n        if not _is_numeric(val):\n            raise TypeError(\n                f\"Element at index {idx} is not numeric: {val!r}\"\n            )\n        total += val\n\n    return total"}
{"task_id": "Mbpp/799", "solution": "import sys\ndef left_rotate(n: int, d: int) -> int:\n    \"\"\"\n    Rotate a 32\u2011bit unsigned integer `n` left by `d` bits.\n\n    Parameters\n    ----------\n    n : int\n        The integer to rotate; treated as a 32\u2011bit unsigned value.\n    d : int\n        Number of bits to rotate left. Handled modulo 32.\n\n    Returns\n    -------\n    int\n        The 32\u2011bit rotated result, masked to 0xFFFFFFFF.\n    \"\"\"\n    MASK_32 = 0xFFFFFFFF\n    n_masked = n & MASK_32\n    d_mod = d % 32\n    if d_mod == 0:\n        return n_masked\n    rotated = ((n_masked << d_mod) | (n_masked >> (32 - d_mod))) & MASK_32\n    return rotated"}
