{"task_id": "Mbpp/128", "solution": "from typing import Iterable, List\ndef _split_words(text: str) -> Iterable[str]:\n    \"\"\"Yield words from *text* using Unicode whitespace as delimiter.\n\n    ``str.split`` already splits on any Unicode whitespace and collapses\n    consecutive whitespace, so it satisfies the requirement without\n    additional regex.\n    \"\"\"\n    return text.split()\ndef long_words(n: int, text: str | None = None) -> List[str]:\n    \"\"\"Return words from *text* that are longer than *n*.\n\n    Parameters\n    ----------\n    n:\n        Minimum number of characters a word must exceed to be included.\n        Must be an integer greater than or equal to zero.\n    text:\n        A string containing words separated by whitespace.  ``None`` is\n        treated as an empty string.\n\n    Returns\n    -------\n    List[str]\n        List of words that satisfy the length condition, in the order\n        they appear in *text*.\n\n    Raises\n    ------\n    TypeError\n        If *n* is not an integer or *text* is not a string.\n    ValueError\n        If *n* is negative.\n    \"\"\"\n    # Validate ``n``\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n    if n < 0:\n        raise ValueError(\"n must be non\u2011negative\")\n\n    # Treat ``None`` as empty string\n    if text is None:\n        text = \"\"\n\n    if not isinstance(text, str):\n        raise TypeError(\"text must be a string or None\")\n\n    words = _split_words(text)\n    # ``len`` in Python 3 counts Unicode code points, which aligns with the\n    # requirement of measuring word length in Unicode characters.\n    return [w for w in words if len(w) > n]"}
{"task_id": "Mbpp/129", "solution": "from typing import List\ndef _validate_matrix(matrix: List[List[int]]) -> int:\n    \"\"\"\n    Validate that *matrix* is a non\u2011empty square matrix and return its size.\n    \n    Parameters\n    ----------\n    matrix : List[List[int]]\n        The matrix to validate.\n    \n    Returns\n    -------\n    int\n        The size n of the n \u00d7 n matrix.\n    \n    Raises\n    ------\n    TypeError\n        If *matrix* is not a list.\n    ValueError\n        If *matrix* is empty, contains non\u2011list rows, or rows are not all the same length.\n    \"\"\"\n    if not isinstance(matrix, list):\n        raise TypeError(\"Input must be a list of lists.\")\n\n    n = len(matrix)\n    if n == 0:\n        raise ValueError(\"Input must be a non\u2011empty square matrix.\")\n\n    for row in matrix:\n        if not isinstance(row, list):\n            raise ValueError(\"Each row must be a list.\")\n        if len(row) != n:\n            raise ValueError(\"All rows must have the same length.\")\n\n    return n\ndef _row_sum(row: List[int]) -> int:\n    return sum(row)\ndef _column_sum(matrix: List[List[int]], col_index: int) -> int:\n    return sum(row[col_index] for row in matrix)\ndef _main_diagonal_sum(matrix: List[List[int]]) -> int:\n    return sum(matrix[i][i] for i in range(len(matrix)))\ndef _anti_diagonal_sum(matrix: List[List[int]]) -> int:\n    n = len(matrix)\n    return sum(matrix[i][n - 1 - i] for i in range(n))\ndef magic_square_test(matrix: List[List[int]]) -> bool:\n    \"\"\"\n    Determine whether a given matrix is a magic square.\n    \n    A magic square is an n \u00d7 n matrix where the sums of all rows,\n    all columns, and both main diagonals are equal.\n    \n    Parameters\n    ----------\n    matrix : List[List[int]]\n        The matrix to evaluate.\n    \n    Returns\n    -------\n    bool\n        ``True`` if the matrix is a magic square, ``False`` otherwise.\n    \n    Raises\n    ------\n    TypeError\n        If *matrix* is not a list.\n    ValueError\n        If *matrix* is empty, not square, or contains non\u2011list rows.\n    \n    Examples\n    --------\n    >>> magic_square_test([[2, 7, 6], [9, 5, 1], [4, 3, 8]])\n    True\n    >>> magic_square_test([[1, 2], [3, 4]])\n    False\n    \"\"\"\n    n = _validate_matrix(matrix)\n    target = _row_sum(matrix[0])\n\n    # Check rows\n    for row in matrix:\n        if _row_sum(row) != target:\n            return False\n\n    # Check columns\n    for c in range(n):\n        if _column_sum(matrix, c) != target:\n            return False\n\n    # Check diagonals\n    if _main_diagonal_sum(matrix) != target:\n        return False\n    if _anti_diagonal_sum(matrix) != target:\n        return False\n\n    return True"}
{"task_id": "Mbpp/130", "solution": "def max_occurrences(lst):\n    \"\"\"Return the integer that appears most frequently in the input list.\n    In case of a tie, the smallest integer among those with the highest frequency is returned.\n    Raises ValueError for invalid input or an empty list.\n    \"\"\"\n    if not isinstance(lst, list):\n        raise ValueError(\"Input must be a list.\")\n    if not lst:\n        raise ValueError(\"Input list cannot be empty.\")\n    for item in lst:\n        if not isinstance(item, int):\n            raise ValueError(\"All elements must be integers.\")\n    freq = {}\n    for num in lst:\n        freq[num] = freq.get(num, 0) + 1\n    max_freq = -1\n    result = None\n    for num, count in freq.items():\n        if count > max_freq or (count == max_freq and num < result):\n            max_freq = count\n            result = num\n    return result"}
{"task_id": "Mbpp/131", "solution": "def reverse_vowels(s: str) -> str:\n    \"\"\"\n    Reverse only the vowels (a, e, i, o, u \u2013 case insensitive, excluding 'y')\n    in the given string while keeping all other characters in their original positions.\n\n    Parameters:\n        s (str): Input string.\n\n    Returns:\n        str: String with vowels reversed.\n\n    Raises:\n        TypeError: If input is not a string.\n    \"\"\"\n    if not isinstance(s, str):\n        raise TypeError(\"Input must be a string\")\n\n    vowels_set = set(\"aeiouAEIOU\")\n    vowel_positions = []\n    vowels = []\n\n    for idx, ch in enumerate(s):\n        if ch in vowels_set:\n            vowel_positions.append(idx)\n            vowels.append(ch)\n\n    reversed_vowels = iter(vowels[::-1])\n    result_chars = list(s)\n\n    for pos in vowel_positions:\n        result_chars[pos] = next(reversed_vowels)\n\n    return \"\".join(result_chars)"}
