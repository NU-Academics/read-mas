{"task_id": "Mbpp/419", "solution": "from typing import Iterable, List, Union\nNumber = Union[int, float]\ndef round_and_sum(numbers: List[Number]) -> int:\n    \"\"\"\n    Rounds each numeric element in 'numbers' to the nearest integer,\n    sums the rounded values, multiplies the sum by the length of the\n    list, and returns the resulting integer.\n\n    Parameters\n    ----------\n    numbers : List[Number]\n        A list containing numeric (int or float) values.\n\n    Returns\n    -------\n    int\n        The scaled sum of rounded numbers.\n\n    Raises\n    ------\n    TypeError\n        If any element in 'numbers' is not an int or float.\n    \"\"\"\n    _validate_numbers(numbers)\n    return _compute_result(numbers)\ndef _compute_result(numbers: Iterable[Number]) -> int:\n    length = len(numbers)\n    if length == 0:\n        return 0\n    rounded_sum = sum(round(x) for x in numbers)\n    return rounded_sum * length"}
{"task_id": "Mbpp/420", "solution": "def cube_Sum(n: int) -> int:\n    \"\"\"\n    Return the sum of cubes of the first n even natural numbers.\n\n    The closed\u2011form formula:\n        Sum_{k=1}^{n} (2k)^3\n        = 8 * Sum_{k=1}^{n} k^3\n        = 8 * (n(n+1)/2)^2\n        = 2 * (n(n+1))^2\n\n    Parameters\n    ----------\n    n : int\n        Number of even natural numbers to sum. Must be >= 0.\n\n    Returns\n    -------\n    int\n        Sum of cubes of the first n even natural numbers.\n\n    Raises\n    ------\n    ValueError\n        If n is negative or not an integer.\n    \"\"\"\n    if not isinstance(n, int):\n        raise ValueError(f\"n must be an integer, got {type(n).__name__}\")\n    if n < 0:\n        raise ValueError(f\"n must be non\u2011negative, got {n}\")\n\n    return 2 * (n * (n + 1)) ** 2"}
{"task_id": "Mbpp/421", "solution": "def concatenate_tuple(tpl: tuple, delimiter: str = '-') -> str:\n    \"\"\"\n    Concatenate elements of a tuple into a single string separated by the given delimiter.\n    \n    Args:\n        tpl: Tuple containing elements to concatenate.\n        delimiter: String used to separate elements in the result.\n    \n    Returns:\n        A string with all tuple elements joined by the delimiter.\n    \"\"\"\n    return delimiter.join(map(str, tpl))"}
{"task_id": "Mbpp/422", "solution": "def find_Average_Of_Cube(n: int) -> float:\n    \"\"\"\n    Compute the average of cubes of the first n natural numbers.\n\n    Parameters:\n        n (int): Number of natural numbers to include (must be >= 1).\n\n    Returns:\n        float: Average of cubes.\n\n    Raises:\n        TypeError: If n is not an integer.\n        ValueError: If n is not a positive integer.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n    if n < 1:\n        raise ValueError(\"n must be a positive integer\")\n\n    # Sum of the first n cubes: (n(n+1)/2)^2\n    sum_of_cubes = (n * (n + 1) // 2) ** 2\n    average = sum_of_cubes / n\n    return float(average)"}
{"task_id": "Mbpp/424", "solution": "from typing import Tuple, List, Any\ndef extract_rear(items: Tuple[str, ...]) -> List[str]:\n    \"\"\"Return a list of the last characters of each string in the input tuple.\n\n    Parameters\n    ----------\n    items : Tuple[str, ...]\n        Tuple containing zero or more strings; None values are ignored.\n\n    Returns\n    -------\n    List[str]\n        List where each element is the last character of the corresponding string.\n        Empty strings contribute an empty string.\n\n    Raises\n    ------\n    TypeError\n        If the input is not a tuple or contains non-string, non-None items.\n\n    Examples\n    --------\n    >>> extract_rear((\"hello\", \"world\", \"\"))\n    ['o', 'd', '']\n    >>> extract_rear((\"foo\", None, \"bar\", \"\"))\n    ['o', 'r', '']\n    \"\"\"\n    _validate(items)\n    result: List[str] = []\n    for item in items:\n        if item is None:\n            continue\n        last_char = item[-1] if item else \"\"\n        result.append(last_char)\n    return result"}
