{"task_id": "Mbpp/458", "solution": "def rectangle_area(width: float | int, height: float | int) -> float:\n    \"\"\"\n    Calculate the area of a rectangle.\n\n    Parameters\n    ----------\n    width : float | int\n        The horizontal dimension of the rectangle.\n    height : float | int\n        The vertical dimension of the rectangle.\n\n    Returns\n    -------\n    float\n        The computed area (width * height).\n\n    Raises\n    ------\n    TypeError\n        If width or height is not an int or float.\n    ValueError\n        If width <= 0 or height <= 0.\n\n    Examples\n    --------\n    >>> rectangle_area(3, 4)\n    12.0\n    >>> rectangle_area(2.5, 4)\n    10.0\n    \"\"\"\n    # Validate type of width\n    if not isinstance(width, (int, float)) or isinstance(width, bool):\n        raise TypeError(\n            f\"width must be int or float, got {type(width).__name__}\"\n        )\n    # Validate type of height\n    if not isinstance(height, (int, float)) or isinstance(height, bool):\n        raise TypeError(\n            f\"height must be int or float, got {type(height).__name__}\"\n        )\n    # Validate value of width\n    if width <= 0:\n        raise ValueError(f\"width must be > 0, got {width}\")\n    # Validate value of height\n    if height <= 0:\n        raise ValueError(f\"height must be > 0, got {height}\")\n\n    return float(width * height)"}
{"task_id": "Mbpp/459", "solution": "def remove_uppercase(input_str: str) -> str:\n    \"\"\"Remove all uppercase alphabetic characters from a string.\n\n    Parameters\n    ----------\n    input_str : str\n        The string from which to remove uppercase letters.\n\n    Returns\n    -------\n    str\n        A new string containing only the characters from `input_str` that are\n        not uppercase alphabetic letters.\n\n    Raises\n    ------\n    TypeError\n        If `input_str` is not an instance of `str`.\n\n    Notes\n    -----\n    - The function does **not** modify the original string.\n    - Non\u2011alphabetic characters, as well as lowercase alphabetic characters,\n      are preserved.\n    - The implementation is case\u2011insensitive for non\u2011alphabetic Unicode\n      characters; only characters where `c.isupper()` returns True and\n      `c.isalpha()` is True are removed.\n\n    Examples\n    --------\n    >>> remove_uppercase(\\\"Hello World!\\\")\n    'ello orld!'\n    >>> remove_uppercase(\\\"\\\")\n\n    ''  \n    >>> remove_uppercase(\\\"123ABCdef\\\")\n    '123def'\n    \"\"\"\n    if not isinstance(input_str, str):\n        raise TypeError(f\"input_str must be a string, got {type(input_str).__name__}\")\n\n    result_chars = []\n    for c in input_str:\n        if c.isalpha() and c.isupper():\n            continue\n        result_chars.append(c)\n\n    return \"\".join(result_chars)"}
{"task_id": "Mbpp/460", "solution": "from typing import List, Any\ndef Extract(data: List[List[Any]]) -> List[Any]:\n    \"\"\"Extract the first element from each sublist.\n\n    Parameters\n    ----------\n    data : List[List[Any]]\n        A list containing sublists. Each sublist must be non\u2011empty.\n\n    Returns\n    -------\n    List[Any]\n        List of the first elements from each sublist, preserving order.\n\n    Raises\n    ------\n    TypeError\n        If `data` is not a list of lists.\n    ValueError\n        If any sublist in `data` is empty.\n\n    Examples\n    --------\n    >>> Extract([[1, 2], [3, 4], [5, 6]])\n    [1, 3, 5]\n    >>> Extract([])\n    []\n    \"\"\"\n    if not isinstance(data, list):\n        raise TypeError(\"Input must be a list of lists.\")\n\n    result: List[Any] = []\n\n    for idx, sub in enumerate(data):\n        if not isinstance(sub, list):\n            raise TypeError(\"Input must be a list of lists.\")\n        if len(sub) == 0:\n            raise ValueError(f\"Sublist at index {idx} is empty.\")\n        result.append(sub[0])\n\n    return result"}
{"task_id": "Mbpp/462", "solution": "from typing import List, Tuple, TypeVar\nT = TypeVar('T')\ndef combinations_list(seq: List[T], include_empty: bool = True) -> List[Tuple[T, ...]]:\n    \"\"\"Generate all order\u2011preserving combinations (subsequences) of the input list.\n\n    Parameters\n    ----------\n    seq : List[T]\n        The input list of hashable elements.\n    include_empty : bool, optional\n        Whether to include the empty subsequence. Defaults to True.\n\n    Returns\n    -------\n    List[Tuple[T, ...]]\n        A list of tuples, each representing a subsequence of ``seq``.\n\n    Raises\n    ------\n    TypeError\n        If ``seq`` is not a list or contains unhashable elements.\n    \"\"\"\n    if not isinstance(seq, list):\n        raise TypeError(f\"Expected seq to be a list, got {type(seq).__name__}\")\n\n    for idx, item in enumerate(seq):\n        try:\n            hash(item)\n        except TypeError as exc:\n            raise TypeError(\n                f\"Element at index {idx} of type {type(item).__name__} is not hashable.\"\n            ) from exc\n\n    result: List[Tuple[T, ...]] = []\n\n    def dfs(index: int, current: Tuple[T, ...]) -> None:\n        if index == len(seq):\n            result.append(current)\n            return\n        dfs(index + 1, current)\n        dfs(index + 1, current + (seq[index],))\n\n    dfs(0, ())\n\n    if not include_empty:\n        result = [sub for sub in result if sub]\n\n    return result"}
{"task_id": "Mbpp/463", "solution": "from typing import List\ndef max_subarray_product(nums: List[int]) -> int:\n    \"\"\"\n    Calculate the maximum product of any contiguous sub\u2011array.\n\n    The function implements an enhanced version of Kadane's algorithm that\n    keeps track of both the maximum and minimum products ending at each\n    position to correctly handle negative numbers.\n\n    Args:\n        nums: A non\u2011empty list of integers.\n\n    Returns:\n        The maximum product obtainable from any contiguous sub\u2011array of\n        `nums`.\n\n    Raises:\n        ValueError: If `nums` is empty.\n\n    Examples:\n        >>> max_subarray_product([2, -5, -2, -4, 3])\n        20\n        >>> max_subarray_product([-1, 2, -3, 4])\n        24\n    \"\"\"\n    if not nums:\n        raise ValueError(\"nums must be a non-empty list of integers\")\n\n    max_prod = min_prod = result = nums[0]\n\n    for num in nums[1:]:\n        if num < 0:\n            max_prod, min_prod = min_prod, max_prod\n\n        max_prod = max(num, max_prod * num)\n        min_prod = min(num, min_prod * num)\n\n        result = max(result, max_prod)\n\n    return result"}
{"task_id": "Mbpp/465", "solution": "import logging\nfrom collections.abc import Mapping\nfrom typing import Any, MutableMapping\nlogger = logging.getLogger(__name__)\ndef _is_empty(value: Any, deep: bool) -> bool:\n    \"\"\"Return True if *value* is considered empty according to the specification.\n\n    Parameters\n    ----------\n    value : Any\n        Value to test.\n    deep : bool\n        If True, nested mappings are evaluated recursively.\n\n    Returns\n    -------\n    bool\n        ``True`` if *value* is empty, else ``False``.\n    \"\"\"\n    if value is None:\n        return True\n\n    if isinstance(value, (str, bytes)) and len(value) == 0:\n        return True\n\n    if hasattr(value, \"__len__\") and len(value) == 0:\n        return True\n\n    if isinstance(value, Mapping) and deep:\n        # Recursively check nested mapping; an empty mapping returns True\n        return not bool(drop_empty(value, inplace=False, deep=True))\n\n    return False\ndef drop_empty(\n    data: Mapping[Any, Any],\n    *,\n    inplace: bool = False,\n    deep: bool = False,\n) -> Mapping[Any, Any]:\n    \"\"\"Return a new mapping with keys that have empty values removed.\n\n    Parameters\n    ----------\n    data : Mapping[Any, Any]\n        Mapping to process. Must be a :class:`collections.abc.Mapping`.\n    inplace : bool, optional\n        If ``True``, the original mapping is mutated and returned. Default is\n        ``False``.\n    deep : bool, optional\n        If ``True``, nested mappings are processed recursively. Default is\n        ``False``.\n\n    Returns\n    -------\n    Mapping[Any, Any]\n        Mapping containing only keys whose values are non\u2011empty. If\n        ``inplace`` is ``True``, this is the same object as ``data``.\n\n    Raises\n    ------\n    TypeError\n        If ``data`` is not a mapping or if ``inplace``/``deep`` are not\n        booleans.\n    \"\"\"\n    if not isinstance(data, Mapping):\n        raise TypeError(\"drop_empty expects a mapping\")\n    if not isinstance(inplace, bool):\n        raise TypeError(\"inplace flag must be a boolean\")\n    if not isinstance(deep, bool):\n        raise TypeError(\"deep flag must be a boolean\")\n\n    def process_value(val: Any) -> Any:\n        if deep and isinstance(val, Mapping):\n            return drop_empty(val, inplace=inplace, deep=True)\n        return val\n\n    if inplace:\n        keys_to_remove = []\n        for key, value in list(data.items()):\n            processed = process_value(value)\n            if _is_empty(processed, deep):\n                keys_to_remove.append(key)\n            else:\n                if processed is not value:\n                    data[key] = processed\n        for key in keys_to_remove:\n            logger.debug(\"Removing empty key %r\", key)\n            del data[key]\n        return data\n\n    result: MutableMapping[Any, Any] = {}\n    for key, value in data.items():\n        processed = process_value(value)\n        if not _is_empty(processed, deep):\n            result[key] = processed\n    return result"}
{"task_id": "Mbpp/468", "solution": "from typing import List\ndef max_product(nums: List[int]) -> int:\n    if not nums:\n        return 0\n\n    uniq = sorted(set(nums))\n    idx_map = {v: i for i, v in enumerate(uniq)}\n    m = len(uniq)\n\n    class SegTree:\n        __slots__ = (\"n\", \"data\")\n\n        def __init__(self, size: int):\n            n = 1\n            while n < size:\n                n <<= 1\n            self.n = n\n            self.data = [float(\"-inf\")] * (2 * n)\n\n        def update(self, idx: int, val: int) -> None:\n            i = idx + self.n\n            if val > self.data[i]:\n                self.data[i] = val\n                i >>= 1\n                while i:\n                    left = self.data[2 * i]\n                    right = self.data[2 * i + 1]\n                    self.data[i] = left if left >= right else right\n                    i >>= 1\n\n        def query(self, l: int, r: int) -> int:\n            if l > r:\n                return float(\"-inf\")\n            l += self.n\n            r += self.n\n            res = float(\"-inf\")\n            while l <= r:\n                if l & 1:\n                    if self.data[l] > res:\n                        res = self.data[l]\n                    l += 1\n                if not (r & 1):\n                    if self.data[r] > res:\n                        res = self.data[r]\n                    r -= 1\n                l >>= 1\n                r >>= 1\n            return res\n\n    seg = SegTree(m)\n    global_max = float(\"-inf\")\n    neg_inf = float(\"-inf\")\n\n    for x in nums:\n        idx = idx_map[x]\n        best_prev = seg.query(0, idx - 1)\n        single = x\n        extend = x * best_prev if best_prev != neg_inf else neg_inf\n        cur = single if single >= extend else extend\n        seg.update(idx, cur)\n        if cur > global_max:\n            global_max = cur\n\n    return int(global_max)"}
{"task_id": "Mbpp/470", "solution": "from typing import Tuple, Union\nNumber = Union[int, float]\ndef add_pairwise(data: Tuple[Number, ...]) -> Tuple[float, ...]:\n    \"\"\"\n    Return a tuple containing the sum of each adjacent pair in `data`.\n\n    Parameters\n    ----------\n    data : tuple[int | float, ...]\n        Input tuple of numeric values.\n\n    Returns\n    -------\n    tuple[float, ...]\n        Tuple of pairwise sums. The last element is omitted if length is odd.\n\n    Raises\n    ------\n    TypeError\n        If `data` is not a tuple or contains non-numeric elements.\n    \"\"\"\n    if not isinstance(data, tuple):\n        raise TypeError(\"Input must be a tuple\")\n    if not all(isinstance(x, (int, float)) for x in data):\n        raise TypeError(\"All elements must be int or float\")\n\n    result = [data[i] + data[i + 1] for i in range(len(data) - 1)]\n    return tuple(result)"}
{"task_id": "Mbpp/471", "solution": "from typing import List\ndef find_remainder(numbers: List[int], n: int) -> int:\n    \"\"\"\n    Compute the product of a list of integers modulo n.\n\n    Parameters\n    ----------\n    numbers : List[int]\n        List of integers (positive, negative, or zero). May be empty.\n    n : int\n        Modulus value. Must be non\u2011zero.\n\n    Returns\n    -------\n    int\n        Remainder of the product of all integers in 'numbers' modulo 'n'.\n\n    Raises\n    ------\n    ValueError\n        If n is zero.\n    TypeError\n        If any element in 'numbers' is not an integer.\n\n    Notes\n    -----\n    The function uses iterative modulo reduction to keep intermediate\n    results bounded, which is essential for handling large products\n    without overflow. The modulo operation follows Python's semantics,\n    which returns a non\u2011negative remainder when n is positive.\n    \"\"\"\n    if n == 0:\n        raise ValueError(\"Modulus 'n' must be non-zero.\")\n    result = 1\n    for num in numbers:\n        if not isinstance(num, int):\n            raise TypeError(f\"All elements in 'numbers' must be integers, got {type(num).__name__}.\")\n        result = (result * num) % n\n    return result"}
{"task_id": "Mbpp/472", "solution": "from typing import List\ndef check_Consecutive(data: List[int]) -> bool:\n    \"\"\"\n    Determine if the provided list contains a sequence of consecutive integers in ascending order.\n\n    Parameters\n    ----------\n    data : List[int]\n        The list of integers to evaluate.\n\n    Returns\n    -------\n    bool\n        True if the list is empty, contains a single element, or every adjacent pair satisfies\n        data[i] + 1 == data[i + 1]. Otherwise, False.\n\n    Examples\n    --------\n    >>> check_Consecutive([])\n    True\n    >>> check_Consecutive([42])\n    True\n    >>> check_Consecutive([1, 2, 3, 4])\n    True\n    >>> check_Consecutive([1, 3, 4])\n    False\n    \"\"\"\n    if len(data) <= 1:\n        return True\n    for i in range(len(data) - 1):\n        if data[i] + 1 != data[i + 1]:\n            return False\n    return True"}
{"task_id": "Mbpp/473", "solution": "from typing import Iterable, Set, Tuple, Any\ndef tuple_intersection(\n    iterable_a: Iterable[Tuple[Any, ...]],\n    iterable_b: Iterable[Tuple[Any, ...]]\n) -> Set[Tuple[Any, ...]]:\n    \"\"\"\n    Return the intersection of two iterables of tuples.\n    Each tuple is treated as an unordered pair; internal sorting\n    ensures canonical representation. The result is a set of sorted tuples.\n\n    Parameters\n    ----------\n    iterable_a : Iterable[Tuple[Any, ...]]\n        First collection of tuples.\n    iterable_b : Iterable[Tuple[Any, ...]]\n        Second collection of tuples.\n\n    Returns\n    -------\n    Set[Tuple[Any, ...]]\n        Set of sorted tuples present in both inputs.\n\n    Raises\n    ------\n    TypeError\n        If inputs are not iterable or elements are unhashable.\n    ValueError\n        If any tuple has fewer than two elements.\n    \"\"\"\n    def normalize(t: Tuple[Any, ...]) -> Tuple[Any, ...]:\n        if len(t) < 2:\n            raise ValueError(f\"Tuple {t!r} must contain at least two elements.\")\n        for e in t:\n            hash(e)  # may raise TypeError\n        return tuple(sorted(t))\n\n    try:\n        iter(iterable_a)\n        iter(iterable_b)\n    except TypeError:\n        raise TypeError(\"Both arguments must be iterable.\")\n\n    set_a: Set[Tuple[Any, ...]] = set()\n    for t in iterable_a:\n        set_a.add(normalize(t))\n\n    result: Set[Tuple[Any, ...]] = set()\n    for t in iterable_b:\n        canonical = normalize(t)\n        if canonical in set_a:\n            result.add(canonical)\n\n    return result"}
{"task_id": "Mbpp/474", "solution": "def replace_char(s: str, old: str, new: str) -> str:\n    \"\"\"\n    Replaces all occurrences of a specified substring in the input string with another substring.\n\n    Parameters:\n        s (str): The original string.\n        old (str): The substring to replace. Must be non-empty.\n        new (str): The replacement substring. Can be empty to delete occurrences.\n\n    Returns:\n        str: A new string with all instances of 'old' replaced by 'new'.\n\n    Raises:\n        ValueError: If 'old' is an empty string.\n    \"\"\"\n    if old == \"\":\n        raise ValueError(\"The 'old' substring must not be empty.\")\n    # If old and new are identical or s is empty, return s unchanged.\n    if s == \"\" or old == new:\n        return s\n    # If old is not found, return s unchanged.\n    if old not in s:\n        return s\n    # Perform replacement\n    return s.replace(old, new)"}
