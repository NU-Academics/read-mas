{"task_id": "Mbpp/96", "solution": "def divisor(n: int) -> int:\n    if n == 0:\n        return 0\n    n_abs = abs(n)\n    count = 1\n    exp = 0\n    while n_abs % 2 == 0:\n        n_abs //= 2\n        exp += 1\n    count *= (exp + 1)\n    p = 3\n    while p * p <= n_abs:\n        exp = 0\n        while n_abs % p == 0:\n            n_abs //= p\n            exp += 1\n        count *= (exp + 1)\n        p += 2\n    if n_abs > 1:\n        count *= 2\n    return count"}
{"task_id": "Mbpp/97", "solution": "from collections import Counter\nfrom typing import Any, Dict, List, TypeVar, Hashable\nT = TypeVar('T', bound=Hashable)\ndef frequency_lists(data: List[List[T]]) -> Dict[T, int]:\n    \"\"\"Compute the frequency of each element across a list of sub\u2011lists.\n\n    Parameters\n    ----------\n    data : List[List[T]]\n        A list where each element is itself a list of hashable items.\n\n    Returns\n    -------\n    Dict[T, int]\n        A dictionary mapping each distinct element to the total number of\n        times it appears in all sub\u2011lists.\n\n    Raises\n    ------\n    ValueError\n        If any element of the outer list is not a list.\n    \"\"\"\n    _validate_input(data)\n    counter = Counter()\n    for sublist in data:\n        counter.update(sublist)\n    return dict(counter)"}
{"task_id": "Mbpp/98", "solution": "from typing import Iterable\ndef multiply_num(numbers: Iterable[float]) -> float:\n    \"\"\"Multiply all numbers in *numbers* together and divide the result by the\n    count of elements.\n\n    Parameters\n    ----------\n    numbers : Iterable[float]\n        An iterable containing numeric values (integers or floats).\n\n    Returns\n    -------\n    float\n        The product of all values divided by the number of values.\n\n    Raises\n    ------\n    ZeroDivisionError\n        If *numbers* is empty.\n\n    Examples\n    --------\n    >>> multiply_num((8, 2, 3, -1, 7))\n    -67.2\n    \"\"\"\n    product = 1.0\n    count = 0\n\n    for n in numbers:\n        product *= float(n)\n        count += 1\n\n    if count == 0:\n        raise ZeroDivisionError(\"Cannot compute product of an empty iterable.\")\n\n    return product / count"}
{"task_id": "Mbpp/99", "solution": "def decimal_to_binary(n: int) -> str:\n    \"\"\"Convert a non\u2011negative integer to its binary string representation.\n\n    Parameters\n    ----------\n    n : int\n        Decimal integer to convert; must be >= 0.\n\n    Returns\n    -------\n    str\n        Binary representation of `n` without leading zeros.\n\n    Raises\n    ------\n    ValueError\n        If `n` is negative.\n    TypeError\n        If `n` is not an integer.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"Input must be an integer.\")\n    if n < 0:\n        raise ValueError(\"Input must be a non\u2011negative integer.\")\n\n    if n == 0:\n        return \"0\"\n\n    bits = []\n    while n:\n        bits.append(str(n % 2))\n        n //= 2\n    bits.reverse()\n    return \"\".join(bits)"}
{"task_id": "Mbpp/100", "solution": "from typing import Union\ndef next_smallest_palindrome(number: Union[int, str]) -> int:\n    # Input validation\n    if isinstance(number, int):\n        if number < 0:\n            raise ValueError(\"Input must be non-negative.\")\n        s = str(number)\n    else:\n        if not isinstance(number, str) or not number.isdigit():\n            raise ValueError(\"Input must be numeric.\")\n        if int(number) < 0:\n            raise ValueError(\"Input must be non-negative.\")\n        s = number.lstrip('0') or '0'\n\n    # All\u2011nines shortcut\n    if set(s) == {'9'}:\n        return int('1' + ('0' * (len(s) - 1)) + '1')\n\n    digits = list(s)\n    n = len(digits)\n    mid = n // 2\n\n    def mirror():\n        for i in range(mid):\n            digits[n - 1 - i] = digits[i]\n\n    mirror()\n    mirrored = int(''.join(digits))\n    original = int(s)\n    if mirrored > original:\n        return mirrored\n\n    carry = 1\n    if n % 2 == 1:  # odd length\n        i = mid\n        while i >= 0 and carry:\n            new_digit = int(digits[i]) + carry\n            carry = new_digit // 10\n            digits[i] = str(new_digit % 10)\n            i -= 1\n    else:  # even length\n        i = mid - 1\n        while i >= 0 and carry:\n            new_digit = int(digits[i]) + carry\n            carry = new_digit // 10\n            digits[i] = str(new_digit % 10)\n            i -= 1\n\n    if carry:\n        digits = ['1'] + digits + ['1']\n        n += 2\n\n    mirror()\n    return int(''.join(digits))"}
{"task_id": "Mbpp/101", "solution": "class KthElementError(Exception):\n    \"\"\"Base exception for Kth Element Finder.\"\"\"\n    def __init__(self, code: int, message: str):\n        self.code = code\n        super().__init__(f\"[{code}] {message}\")\n\n\nclass InvalidArrayException(KthElementError):\n    def __init__(self):\n        super().__init__(1001, \"Input is not a valid array or is null.\")\n\n\nclass InvalidKTypeException(KthElementError):\n    def __init__(self):\n        super().__init__(1002, \"k must be an integer.\")\n\n\nclass InvalidKValueException(KthElementError):\n    def __init__(self):\n        super().__init__(1003, \"k must be \u2265 1.\")\n\n\nclass OutOfBoundsException(KthElementError):\n    def __init__(self):\n        super().__init__(1004, \"k exceeds array length.\")\n\n\nclass InputValidator:\n    @staticmethod\n    def validate(array, k):\n        if array is None or not hasattr(array, \"__len__\") or not hasattr(array, \"__getitem__\"):\n            raise InvalidArrayException()\n        if not isinstance(k, int):\n            raise InvalidKTypeException()\n        if k < 1:\n            raise InvalidKValueException()\n\n\nclass RetrievalStrategy:\n    def retrieve(self, array, k):\n        raise NotImplementedError\n\n\nclass DefaultRetrievalStrategy(RetrievalStrategy):\n    def retrieve(self, array, k):\n        if k > len(array):\n            raise OutOfBoundsException()\n        return array[k - 1]\n\n\nclass ErrorHandler:\n    @staticmethod\n    def handle(exception: KthElementError):\n        # Logging can be added here in a real system.\n        raise exception\n\n\ndef find_kth_element(array, k):\n    \"\"\"\n    Returns the k-th element (1-based) from the provided array-like sequence.\n    Raises descriptive exceptions on invalid input or out-of-bounds access.\n    \"\"\"\n    try:\n        InputValidator.validate(array, k)\n        strategy = DefaultRetrievalStrategy()\n        return strategy.retrieve(array, k)\n    except KthElementError as e:\n        ErrorHandler.handle(e)"}
