{"task_id": "Mbpp/301", "solution": "from collections.abc import Mapping\nfrom typing import Any\ndef dict_depth(d: Mapping[Any, Any]) -> int:\n    if not isinstance(d, Mapping):\n        raise TypeError(\"Input must be a mapping (e.g., dict).\")\n    max_depth = 1\n    stack: list[tuple[Mapping[Any, Any], int]] = [(d, 1)]\n    visited = set()\n    while stack:\n        current, depth = stack.pop()\n        if depth > max_depth:\n            max_depth = depth\n        current_id = id(current)\n        if current_id in visited:\n            continue\n        visited.add(current_id)\n        for value in current.values():\n            if isinstance(value, Mapping):\n                stack.append((value, depth + 1))\n    return max_depth"}
{"task_id": "Mbpp/305", "solution": "from typing import List, Tuple\ndef start_withp(strings: List[str]) -> Tuple[str, str]:\n    \"\"\"\n    Return the first two words that start with the letter 'p' (case\u2011insensitive)\n    from a list of strings.\n\n    Parameters\n    ----------\n    strings : List[str]\n        A list containing arbitrary strings to be tokenized.\n\n    Returns\n    -------\n    Tuple[str, str]\n        A tuple containing the first two words found that start with 'p'.\n\n    Raises\n    ------\n    TypeError\n        If ``strings`` is not a list or contains non\u2011string elements.\n    ValueError\n        If fewer than two words starting with 'p' are found.\n    \"\"\"\n    if not isinstance(strings, list):\n        raise TypeError(\n            f\"Expected a list of strings, got {type(strings).__name__}\"\n        )\n    for idx, item in enumerate(strings):\n        if not isinstance(item, str):\n            raise TypeError(\n                f\"Element at index {idx} is not a string: {type(item).__name__}\"\n            )\n\n    results: List[str] = []\n\n    for text in strings:\n        for word in _tokenize(text):\n            if _starts_with_p(word):\n                results.append(word)\n                if len(results) == 2:\n                    return tuple(results)\n    _raise_insufficient_words(len(results))\ndef _tokenize(text: str) -> List[str]:\n    \"\"\"Split a string into words using whitespace.\"\"\"\n    return text.split()\ndef _starts_with_p(word: str) -> bool:\n    \"\"\"Return True if the word starts with 'p' or 'P'.\"\"\"\n    return bool(word) and word[0].lower() == \"p\""}
{"task_id": "Mbpp/306", "solution": "from typing import List\ndef max_sum_increasing_subseq(arr: List[int], n: int, i: int, k: int) -> int:\n    # Input validation\n    if n != len(arr):\n        raise ValueError(\"Length of arr does not match n\")\n    if not (1 <= i < k <= n):\n        raise ValueError(\"Indices must satisfy 1 <= i < k <= n\")\n\n    # Convert to 0\u2011based indices\n    i0 = i - 1\n    k0 = k - 1\n\n    # DP for prefix [0, i0-1]\n    dp: List[int] = [0] * i0\n    for j in range(i0):\n        best = 0\n        for t in range(j):\n            if arr[t] < arr[j] and dp[t] > best:\n                best = dp[t]\n        dp[j] = arr[j] + best\n\n    # Compute answer for k0\n    best_prev = 0\n    found = False\n    for t in range(i0):\n        if arr[t] < arr[k0] and dp[t] > best_prev:\n            best_prev = dp[t]\n            found = True\n\n    return arr[k0] + best_prev if found else arr[k0]"}
{"task_id": "Mbpp/308", "solution": "from heapq import heappush, heappop\nfrom typing import List, Tuple, Set\ndef large_product(list_a: List[int], list_b: List[int], k: int) -> List[int]:\n    \"\"\"\n    Return the k largest products of one element from list_a and one from list_b.\n\n    Parameters\n    ----------\n    list_a : List[int]\n        First list of integers.\n    list_b : List[int]\n        Second list of integers.\n    k : int\n        Number of largest products to return. Must be non\u2011negative.\n\n    Returns\n    -------\n    List[int]\n        List of up to k products sorted in descending order.\n\n    Notes\n    -----\n    * If either input list is empty, or k <= 0, an empty list is returned.\n    * If k exceeds the total number of possible products, all products are returned.\n    * Negative numbers are handled normally.\n    * Duplicate products are retained if they arise from different index pairs.\n    \"\"\"\n    if k <= 0 or not list_a or not list_b:\n        return []\n\n    # Optional runtime type validation\n    if not all(isinstance(x, int) for x in list_a) or not all(isinstance(x, int) for x in list_b):\n        raise TypeError(\"Both input lists must contain only integers.\")\n\n    a = sorted(list_a, reverse=True)\n    b = sorted(list_b, reverse=True)\n\n    heap: List[Tuple[int, int, int]] = []\n    visited: Set[Tuple[int, int]] = set()\n\n    heappush(heap, (-a[0] * b[0], 0, 0))\n    visited.add((0, 0))\n\n    result: List[int] = []\n\n    while heap and len(result) < k:\n        prod_neg, i, j = heappop(heap)\n        result.append(-prod_neg)\n\n        if i + 1 < len(a) and (i + 1, j) not in visited:\n            heappush(heap, (-a[i + 1] * b[j], i + 1, j))\n            visited.add((i + 1, j))\n\n        if j + 1 < len(b) and (i, j + 1) not in visited:\n            heappush(heap, (-a[i] * b[j + 1], i, j + 1))\n            visited.add((i, j + 1))\n\n    return result"}
{"task_id": "Mbpp/309", "solution": "from typing import Union\ndef maximum(a: Union[int, float], b: Union[int, float]) -> Union[int, float]:\n    \"\"\"\n    Return the greater of two numeric values.\n\n    Parameters\n    ----------\n    a : int or float\n        First numeric argument.\n    b : int or float\n        Second numeric argument.\n\n    Returns\n    -------\n    int or float\n        The maximum value between `a` and `b`.\n\n    Raises\n    ------\n    TypeError\n        If either argument is not an int or float.\n    \"\"\"\n    if not isinstance(a, (int, float)):\n        raise TypeError(\n            f\"Argument 'a' must be int or float, got {type(a).__name__}\"\n        )\n    if not isinstance(b, (int, float)):\n        raise TypeError(\n            f\"Argument 'b' must be int or float, got {type(b).__name__}\"\n        )\n    return a if a >= b else b"}
{"task_id": "Mbpp/310", "solution": "from typing import Tuple\ndef string_to_tuple(s: str) -> Tuple[str, ...]:\n    \"\"\"\n    Convert a Unicode string into a tuple of its characters.\n\n    Parameters\n    ----------\n    s : str\n        Input string to be converted.\n\n    Returns\n    -------\n    Tuple[str, ...]\n        Tuple where each element is a single character from the input string.\n\n    Raises\n    ------\n    TypeError\n        If `s` is not a string instance.\n    \"\"\"\n    if not isinstance(s, str):\n        raise TypeError(\"Input must be a string\")\n    return tuple(s)"}
{"task_id": "Mbpp/311", "solution": "def set_left_most_unset_bit(n: int) -> int:\n    \"\"\"Return an integer where the most significant unset bit of n is set to 1.\n    Raises ValueError if n is negative.\"\"\"\n    if n < 0:\n        raise ValueError(\"Input must be non\u2011negative\")\n    if n == 0:\n        return 1  # bit 0\n    msb_pos = n.bit_length() - 1          # position of MSB\n    mask = (1 << (msb_pos + 1)) - 1       # bits 0..msb_pos set\n    complement = mask ^ n\n    if complement == 0:\n        return n  # all bits up to msb_pos are already set\n    leftmost_unset = 1 << (msb_pos - (complement.bit_length() - 1))\n    return n | leftmost_unset"}
