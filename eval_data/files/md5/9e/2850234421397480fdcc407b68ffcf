{"task_id": "Mbpp/245", "solution": "from typing import List\ndef max_sum(nums: List[int]) -> int:\n    \"\"\"\n    Compute the maximum sum of any bitonic subsequence in a list of integers.\n\n    A bitonic subsequence is one that first strictly increases and then\n    strictly decreases, or is strictly increasing/decreasing only.\n    The subsequence must preserve the relative order of the original list.\n\n    Parameters\n    ----------\n    nums : List[int]\n        Sequence of integers. The list may be empty or contain a single\n        element. All elements must be of type int.\n\n    Returns\n    -------\n    int\n        The maximum achievable sum of a bitonic subsequence. If the list is\n        empty, 0 is returned.\n\n    Raises\n    ------\n    ValueError\n        If ``nums`` is not a list or contains non\u2011integer elements.\n\n    Examples\n    --------\n    >>> max_sum([1, 3, 5, 4, 2])\n    13          # 1 + 3 + 5 + 4 = 13\n\n    >>> max_sum([4, 3, 2, 1])\n    10          # 4 + 3 + 2 + 1\n\n    >>> max_sum([1, 2, 3, 2, 1, 4, 5, 3])\n    18          # 1 + 2 + 3 + 2 + 1 + 4 + 5 = 18 (peak at 5)\n    \"\"\"\n    if not isinstance(nums, list):\n        raise ValueError(\"Input must be a list\")\n\n    for x in nums:\n        if not isinstance(x, int):\n            raise ValueError(\"All elements must be integers\")\n\n    n = len(nums)\n    if n == 0:\n        return 0\n\n    inc_sum = nums.copy()\n    dec_sum = nums.copy()\n\n    # Left-to-right DP: maximum sum of increasing subsequence ending at i\n    for i in range(n):\n        for j in range(i):\n            if nums[j] < nums[i]:\n                candidate = inc_sum[j] + nums[i]\n                if candidate > inc_sum[i]:\n                    inc_sum[i] = candidate\n\n    # Right-to-left DP: maximum sum of decreasing subsequence starting at i\n    for i in reversed(range(n)):\n        for j in range(i + 1, n):\n            if nums[j] < nums[i]:\n                candidate = dec_sum[j] + nums[i]\n                if candidate > dec_sum[i]:\n                    dec_sum[i] = candidate\n\n    # Combine the two parts, subtracting nums[i] once to avoid double counting\n    best = max(inc_sum[i] + dec_sum[i] - nums[i] for i in range(n))\n    return best"}
{"task_id": "Mbpp/247", "solution": "def lps(s: str) -> int:\n    \"\"\"Compute the length of the longest palindromic subsequence in the given string.\n\n    Parameters\n    ----------\n    s : str\n        The input string. May contain spaces and any Unicode characters.\n\n    Returns\n    -------\n    int\n        Length of the longest palindromic subsequence. Returns 0 for an empty string.\n\n    Complexity\n    ----------\n    Time: O(n^2)\n    Space: O(n^2)\n\n    Examples\n    --------\n    >>> lps(\"agbdba\")\n    5\n    >>> lps(\"\")\n    0\n    \"\"\"\n    if not isinstance(s, str):\n        raise TypeError(\"Input must be a string\")\n\n    n = len(s)\n    if n == 0:\n        return 0\n\n    dp = [[0] * n for _ in range(n)]\n\n    for i in range(n):\n        dp[i][i] = 1\n\n    for length in range(2, n + 1):\n        for i in range(n - length + 1):\n            j = i + length - 1\n            if s[i] == s[j]:\n                dp[i][j] = dp[i + 1][j - 1] + 2 if i + 1 <= j - 1 else 2\n            else:\n                dp[i][j] = max(dp[i + 1][j], dp[i][j - 1])\n\n    return dp[0][n - 1]"}
{"task_id": "Mbpp/250", "solution": "def count_X(seq: tuple, element) -> int:\n    \"\"\"Count the number of occurrences of `element` in the given tuple `seq`.\n\n    Parameters\n    ----------\n    seq : tuple\n        The tuple in which to search for `element`. Must be an instance of `tuple`.\n    element : Any\n        The value to count within `seq`. Can be of any type that supports equality comparison.\n\n    Returns\n    -------\n    int\n        The count of elements in `seq` that are equal to `element`.\n\n    Raises\n    ------\n    TypeError\n        If `seq` is not a tuple.\n\n    Examples\n    --------\n    >>> count_X((1, 2, 3, 2, 4), 2)\n    2\n    >>> count_X(('a', 'b', 'a', 'c'), 'a')\n    2\n    >>> count_X([], 1)\n    0\n    \"\"\"\n    if not isinstance(seq, tuple):\n        raise TypeError(\"First argument must be a tuple\")\n\n    count = 0\n    for item in seq:\n        if item == element:\n            count += 1\n    return count"}
{"task_id": "Mbpp/251", "solution": "def insert_element(input_list: list, elem) -> list:\n    \"\"\"Insert an element before every item in the input list.\n\n    Parameters\n    ----------\n    input_list : list\n        The list whose elements will be preceded by `elem`.\n    elem :\n        The element to insert before each original element.\n\n    Returns\n    -------\n    list\n        A new list with `elem` inserted before each element of `input_list`.\n\n    Raises\n    ------\n    TypeError\n        If `input_list` is not a list.\n\n    Examples\n    --------\n    >>> insert_element([1, 2, 3], 0)\n    [0, 1, 0, 2, 0, 3]\n    >>> insert_element([], 'x')\n    []\n    \"\"\"\n    if not isinstance(input_list, list):\n        raise TypeError(\"input_list must be of type list\")\n    result = []\n    for item in input_list:\n        result.append(elem)\n        result.append(item)\n    return result"}
{"task_id": "Mbpp/252", "solution": "import argparse\nimport math\nfrom typing import Tuple, Union\n_Number = Union[int, float, complex]\ndef convert(z: _Number, degrees: bool = False) -> Tuple[float, float]:\n    \"\"\"\n    Convert a numeric value to polar coordinates.\n\n    Parameters\n    ----------\n    z : int | float | complex\n        The number to convert.\n    degrees : bool, optional\n        If True, return angle in degrees. Default is False (radians).\n\n    Returns\n    -------\n    tuple(float, float)\n        (magnitude, angle)\n\n    Raises\n    ------\n    TypeError\n        If z cannot be interpreted as a number.\n    \"\"\"\n    _validate_input(z)\n    c = complex(z)\n    r, theta = _compute_polar(c)\n    if degrees:\n        theta = math.degrees(theta)\n    return float(r), float(theta)\ndef _compute_polar(c: complex) -> Tuple[float, float]:\n    r = math.hypot(c.real, c.imag)\n    theta = math.atan2(c.imag, c.real)\n    if r == 0.0:\n        theta = 0.0\n    return r, theta"}
{"task_id": "Mbpp/253", "solution": "def count_integers(data: list) -> int:\n    \"\"\"Count the number of integer elements in the provided list.\n\n    Parameters\n    ----------\n    data : list\n        The list to analyze.\n\n    Returns\n    -------\n    int\n        Number of elements in `data` that are of type `int`.\n\n    Raises\n    ------\n    TypeError\n        If `data` is not a list.\n    \"\"\"\n    if not isinstance(data, list):\n        raise TypeError(\"Input must be a list\")\n    count = 0\n    for item in data:\n        if type(item) is int:\n            count += 1\n    return count"}
{"task_id": "Mbpp/255", "solution": "import collections\nfrom collections.abc import Iterable, Hashable, Iterator\nfrom typing import Hashable as HashableType, List, Tuple\n_RECURSION_THRESHOLD = 10\ndef _validate_inputs(elements: Iterable[HashableType], n: int) -> List[HashableType]:\n    if not isinstance(elements, Iterable):\n        raise ValueError(\"elements must be an iterable\")\n    try:\n        elements_list = list(elements)\n    except Exception as exc:\n        raise ValueError(\"elements must be an iterable\") from exc\n    for e in elements_list:\n        if not isinstance(e, Hashable):\n            raise ValueError(f\"element {e!r} is not hashable\")\n    if not isinstance(n, int) or n < 0:\n        raise ValueError(\"n must be a non\u2011negative integer\")\n    return elements_list\ndef combinations_colors(elements: Iterable[HashableType], n: int) -> List[Tuple[HashableType, ...]]:\n    \"\"\"Generate all n\u2011length combinations of 'elements' with repetition allowed.\n\n    Parameters\n    ----------\n    elements : Iterable[Hashable]\n        The collection of elements to combine. Must contain hashable items.\n    n : int\n        The desired length of each combination. Must be \u2265 0.\n\n    Returns\n    -------\n    List[Tuple[Hashable, ...]]\n        A list of tuples, each of length `n`, sorted lexicographically\n        according to the order of `elements`.\n\n    Raises\n    ------\n    ValueError\n        If `elements` is not iterable of hashable items, or if `n` is negative.\n\n    Examples\n    --------\n    >>> combinations_colors(['red', 'green'], 2)\n    [('red', 'red'), ('red', 'green'), ('green', 'red'), ('green', 'green')]\n    \"\"\"\n    elems = _validate_inputs(elements, n)\n    if n == 0:\n        return [()]\n    if n > _RECURSION_THRESHOLD:\n        return _iterative_combinations(elems, n)\n    return _recursive_combinations(elems, n)\ndef _recursive_combinations(elems: List[HashableType], n: int) -> List[Tuple[HashableType, ...]]:\n    if n == 0:\n        return [()]\n    result: List[Tuple[HashableType, ...]] = []\n    for e in elems:\n        for suffix in _recursive_combinations(elems, n - 1):\n            result.append((e,) + suffix)\n    return result\ndef _iterative_combinations(elems: List[HashableType], n: int) -> List[Tuple[HashableType, ...]]:\n    result: List[Tuple[HashableType, ...]] = []\n    stack: List[Tuple[int, Tuple[HashableType, ...]]] = [(0, ())]\n    while stack:\n        index, current = stack.pop()\n        if len(current) == n:\n            result.append(current)\n            continue\n        for i in range(len(elems) - 1, -1, -1):\n            stack.append((i, current + (elems[i],)))\n    return result"}
{"task_id": "Mbpp/256", "solution": "def count_primes(n: int) -> int:\n    \"\"\"\n    Count prime numbers strictly less than a non\u2011negative integer `n`.\n\n    Parameters\n    ----------\n    n : int\n        Non\u2011negative integer upper bound (exclusive).\n\n    Returns\n    -------\n    int\n        Number of primes p such that 0 <= p < n.\n\n    Raises\n    ------\n    ValueError\n        If `n` is negative or not an integer.\n\n    Examples\n    --------\n    >>> count_primes(10)\n    4\n    >>> count_primes(0)\n    0\n    \"\"\"\n    if not isinstance(n, int):\n        raise ValueError(\"Input must be an integer.\")\n    if n < 0:\n        raise ValueError(\"Input must be non\u2011negative.\")\n    if n <= 2:\n        return 0\n\n    is_prime = [True] * n\n    is_prime[0] = is_prime[1] = False\n    limit = int(n**0.5) + 1\n    for p in range(2, limit):\n        if is_prime[p]:\n            step = p\n            start = p * p\n            is_prime[start:n:step] = [False] * ((n - start - 1) // step + 1)\n\n    return sum(is_prime)"}
{"task_id": "Mbpp/257", "solution": "from typing import Tuple, Union\nNumber = Union[int, float]\ndef swap_numbers(a: Number, b: Number) -> Tuple[Number, Number]:\n    \"\"\"Return a tuple with the second argument first and the first argument second.\n\n    Parameters\n    ----------\n    a : int | float\n        The first number.\n    b : int | float\n        The second number.\n\n    Returns\n    -------\n    Tuple[int | float, int | float]\n        A tuple where the first element is `b` and the second element is `a`.\n\n    Raises\n    ------\n    TypeError\n        If either `a` or `b` is not an int or float.\n    \"\"\"\n    if not isinstance(a, (int, float)):\n        raise TypeError(f\"'a' must be int or float, got {type(a).__name__}\")\n    if not isinstance(b, (int, float)):\n        raise TypeError(f\"'b' must be int or float, got {type(b).__name__}\")\n    return (b, a)"}
{"task_id": "Mbpp/259", "solution": "from typing import Tuple\ndef maximize_elements(\n    first: Tuple[Tuple[int, ...], ...],\n    second: Tuple[Tuple[int, ...], ...]\n) -> Tuple[Tuple[int, ...], ...]:\n    \"\"\"Returns a tuple of tuples where each inner tuple contains the element\u2011wise\n    maximum values from the corresponding inner tuples of ``first`` and ``second``.\n\n    Parameters\n    ----------\n    first : Tuple[Tuple[int, ...], ...]\n        First immutable nested tuple of integers.\n    second : Tuple[Tuple[int, ...], ...]\n        Second immutable nested tuple of integers.\n\n    Returns\n    -------\n    Tuple[Tuple[int, ...], ...]\n        Nested tuple of integers representing the element\u2011wise maximums.\n\n    Raises\n    ------\n    TypeError\n        If either argument is not a tuple of tuples of ints, or if inner\n        elements are not integers.\n    ValueError\n        If the outer tuples have different lengths or any inner tuples have\n        mismatched lengths.\n\n    Examples\n    --------\n    >>> maximize_elements(((1, 4, 3), (2, 5, 1)), ((2, 3, 5), (1, 6, 0)))\n    ((2, 4, 5), (2, 6, 1))\n    \"\"\"\n    # Helper function for validating a nested tuple\n    def _validate(name: str, nested: Tuple[Tuple[int, ...], ...]) -> None:\n        if not isinstance(nested, tuple):\n            raise TypeError(\n                f\"Argument '{name}' must be a tuple of tuples of ints.\"\n            )\n        for i, inner in enumerate(nested):\n            if not isinstance(inner, tuple):\n                raise TypeError(\n                    f\"Argument '{name}' must be a tuple of tuples of ints. \"\n                    f\"Element at index {i} is not a tuple.\"\n                )\n            for j, value in enumerate(inner):\n                if not isinstance(value, int):\n                    raise TypeError(\n                        f\"All elements must be integers. \"\n                        f\"Element at position ({i}, {j}) in argument '{name}' is of type {type(value).__name__}.\"\n                    )\n\n    _validate(\"first\", first)\n    _validate(\"second\", second)\n\n    if len(first) != len(second):\n        raise ValueError(\"Outer tuples must have the same length.\")\n\n    result = []\n    for idx, (inner_first, inner_second) in enumerate(zip(first, second)):\n        if len(inner_first) != len(inner_second):\n            raise ValueError(\n                f\"Inner tuples at index {idx} must have the same length.\"\n            )\n        max_tuple = tuple(max(a, b) for a, b in zip(inner_first, inner_second))\n        result.append(max_tuple)\n\n    return tuple(result)"}
{"task_id": "Mbpp/260", "solution": "import math\nfrom typing import Iterator, List\ndef _is_nsw_prime(p: int) -> bool:\n    \"\"\"\n    Determine whether a prime p is a Newman\u2013Shanks\u2013Williams prime.\n    A prime p is an NSW prime if there exists k >= 1 such that\n    S_k^2 + 5 \u2261 0 (mod p), where S_k follows the recurrence:\n        S_0 = 0, S_1 = 1, S_k = 4*S_{k-1} - S_{k-2}\n    \"\"\"\n    # Special cases\n    if p in (2, 5):\n        return False\n\n    # We compute S_k modulo p and test the condition.\n    # The sequence modulo p is periodic; we limit the search to\n    # a safe upper bound (here 2*p) which is sufficient for small p.\n    max_k = 2 * p\n\n    a_prev, a_curr = 0, 1  # S_0, S_1\n    for _ in range(1, max_k + 1):\n        # Next term S_k\n        a_next = (4 * a_curr - a_prev) % p\n        a_prev, a_curr = a_curr, a_next\n\n        # Test if a_curr^2 + 5 \u2261 0 (mod p)\n        if (a_curr * a_curr + 5) % p == 0:\n            return True\n\n    return False\ndef newman_prime(n: int) -> int:\n    \"\"\"\n    Return the n-th Newman\u2013Shanks\u2013Williams prime (1-indexed).\n\n    Parameters\n    ----------\n    n : int\n        The index (1-indexed) of the desired NSW prime.\n\n    Returns\n    -------\n    int\n        The n-th NSW prime number.\n\n    Raises\n    ------\n    ValueError\n        If n is not a positive integer.\n    RuntimeError\n        If the prime cannot be found within reasonable bounds.\n    \"\"\"\n    if not isinstance(n, int) or n < 1:\n        raise ValueError(\"n must be a positive integer (n >= 1).\")\n\n    count = 0\n    for p in _prime_generator():\n        if _is_nsw_prime(p):\n            count += 1\n            if count == n:\n                return p\n        # Safety guard for extremely large n (should not be needed for typical usage)\n        if count > 10_000_000:\n            raise RuntimeError(\"Prime not found within reasonable bounds.\")"}
{"task_id": "Mbpp/261", "solution": "from typing import Tuple, Union, Optional\nimport logging\nfrom decimal import Decimal\n_Number = Union[int, float, Decimal]\ndef division_elements(\n    numerators: Tuple[_Number, ...],\n    denominators: Tuple[_Number, ...],\n    *,\n    allow_none: bool = False,\n    raise_on_zero: bool = True,\n    logger: Optional[logging.Logger] = None,\n) -> Tuple[Optional[_Number], ...]:\n    \"\"\"\n    Perform element\u2011wise division of two tuples.\n\n    Parameters\n    ----------\n    numerators : Tuple[Union[int, float, Decimal], ...]\n        Tuple of numerator values.\n    denominators : Tuple[Union[int, float, Decimal], ...]\n        Tuple of denominator values.\n    allow_none : bool, default False\n        If True, division by zero yields None instead of raising.\n    raise_on_zero : bool, default True\n        If True, division by zero raises ZeroDivisionError.\n        Ignored if allow_none is True.\n    logger : logging.Logger, optional\n        Logger to record operations and errors.\n\n    Returns\n    -------\n    Tuple[Optional[Union[float, Decimal]], ...]\n        Resulting tuple with division outcomes.\n\n    Raises\n    ------\n    ValueError\n        If input tuples differ in length or contain non\u2011numeric types.\n    ZeroDivisionError\n        If division by zero occurs and raise_on_zero is True.\n    \"\"\"\n    if logger is None:\n        logger = logging.getLogger(__name__)\n\n    # Validation\n    if len(numerators) != len(denominators):\n        raise ValueError(\"Input tuples must be of equal length.\")\n\n    # Type check\n    for idx, (num, den) in enumerate(zip(numerators, denominators)):\n        if not isinstance(num, (int, float, Decimal)):\n            raise ValueError(f\"Numerator at index {idx} is not numeric.\")\n        if not isinstance(den, (int, float, Decimal)):\n            raise ValueError(f\"Denominator at index {idx} is not numeric.\")\n\n    results: list[Optional[_Number]] = []\n\n    for idx, (num, den) in enumerate(zip(numerators, denominators)):\n        if den == 0:\n            if allow_none:\n                results.append(None)\n                logger.warning(f\"Zero denominator at index {idx}. Result set to None.\")\n                continue\n            if raise_on_zero:\n                msg = f\"Division by zero at index {idx}.\"\n                logger.error(msg)\n                raise ZeroDivisionError(msg)\n            # Fallback: treat as None if neither flag is set\n            results.append(None)\n            logger.warning(f\"Zero denominator at index {idx}. Result set to None.\")\n            continue\n\n        # Perform division, preserving Decimal precision if applicable\n        if isinstance(num, Decimal) or isinstance(den, Decimal):\n            num_dec = Decimal(num) if not isinstance(num, Decimal) else num\n            den_dec = Decimal(den) if not isinstance(den, Decimal) else den\n            division = num_dec / den_dec\n        else:\n            division = num / den\n\n        results.append(division)\n        logger.debug(f\"Index {idx}: {num} / {den} = {division}\")\n\n    return tuple(results)"}
{"task_id": "Mbpp/262", "solution": "from typing import Sequence, List, Tuple, TypeVar\nT = TypeVar(\"T\")\ndef split_two_parts(lst: Sequence[T], L: int) -> Tuple[List[T], List[T]]:\n    \"\"\"\n    Splits the input sequence into two parts of specified length.\n\n    Parameters\n    ----------\n    lst : Sequence[T]\n        The sequence to split. Must support indexing and slicing.\n    L : int\n        The maximum length of the first part. Must be a non\u2011negative integer.\n\n    Returns\n    -------\n    Tuple[List[T], List[T]]\n        A tuple containing:\n        - first part: up to L elements from the start of lst.\n        - second part: the remaining elements of lst.\n\n    Raises\n    ------\n    TypeError\n        If lst is not a sequence or L is not an integer.\n    ValueError\n        If L is negative.\n    \"\"\"\n    if not isinstance(lst, Sequence):\n        raise TypeError(\"lst must be a sequence (list or similar)\")\n    if not isinstance(L, int):\n        raise TypeError(\"L must be an integer\")\n    if L < 0:\n        raise ValueError(\"L must be non\u2011negative\")\n\n    part1 = list(lst[:L])\n    part2 = list(lst[L:])\n    return part1, part2"}
{"task_id": "Mbpp/264", "solution": "def dog_age(human_years: int) -> int:\n    \"\"\"\n    Convert human years to dog years.\n\n    The conversion follows a common veterinary guideline:\n        \u2022 The first two human years each equal 10.5 dog years.\n        \u2022 Each additional human year equals 4 dog years.\n\n    Args:\n        human_years: Age of the dog in human years. Must be non\u2011negative.\n\n    Returns:\n        The equivalent age in dog years as an integer.\n\n    Raises:\n        ValueError: If human_years is negative.\n    \"\"\"\n    if human_years < 0:\n        raise ValueError(\"Human years cannot be negative\")\n\n    if human_years <= 2:\n        return int(human_years * 10.5)\n\n    return int(2 * 10.5 + (human_years - 2) * 4)"}
