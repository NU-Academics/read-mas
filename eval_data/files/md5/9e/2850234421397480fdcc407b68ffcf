{"task_id": "Mbpp/757", "solution": "from collections import defaultdict\nfrom typing import List\ndef _reverse_string(s: str) -> str:\n    \"\"\"Return the reverse of the given string `s`. Works with Unicode characters.\"\"\"\n    return s[::-1]\ndef count_reverse_pairs(strings: List[str]) -> int:\n    \"\"\"Count the number of index pairs (i, j) with i < j such that\n    strings[i] == reverse(strings[j]).\n    Parameters\n    ----------\n    strings : List[str]\n        A list of strings to be examined.\n    Returns\n    -------\n    int\n        The number of reverse pairs.\n    Raises\n    ------\n    TypeError\n        If the input is not a list or contains non\u2011string elements.\n    \"\"\"\n    validate_input(strings)\n\n    freq = defaultdict(int)\n    count = 0\n    for s in strings:\n        rev_s = _reverse_string(s)\n        count += freq[rev_s]\n        freq[s] += 1\n    return count"}
{"task_id": "Mbpp/758", "solution": "from typing import List, Dict, Tuple\ndef unique_sublists(seq: List) -> Dict[Tuple, int]:\n    \"\"\"Count all contiguous sublists of a sequence and return their occurrence counts.\"\"\"\n    counts: Dict[Tuple, int] = {}\n    n = len(seq)\n    for i in range(n):\n        current: List = []\n        for j in range(i, n):\n            current.append(seq[j])\n            key = tuple(current)\n            counts[key] = counts.get(key, 0) + 1\n    return counts"}
