{"task_id": "Mbpp/160", "solution": "from typing import Optional, Tuple\ndef extended_gcd(a: int, b: int) -> Tuple[int, int, int]:\n    \"\"\"Return gcd(a, b) and B\u00e9zout coefficients x, y such that a*x + b*y = gcd(a, b).\"\"\"\n    x0, y0, x1, y1 = 1, 0, 0, 1\n    aa, bb = a, b\n    while bb != 0:\n        q, r = divmod(aa, bb)\n        aa, bb = bb, r\n        x0, x1 = x1, x0 - q * x1\n        y0, y1 = y1, y0 - q * y1\n    if aa < 0:\n        aa = -aa\n        x0 = -x0\n        y0 = -y0\n    return aa, x0, y0\ndef find_solution(a: int, b: int, n: int) -> Optional[Tuple[int, int]]:\n    \"\"\"Return one integer solution (x, y) to a*x + b*y = n, or None if impossible.\"\"\"\n    if a == 0 and b == 0:\n        return (0, 0) if n == 0 else None\n    g, x0, y0 = extended_gcd(a, b)\n    if n % g != 0:\n        return None\n    k = n // g\n    return (x0 * k, y0 * k)"}
{"task_id": "Mbpp/161", "solution": "from typing import List, Iterable, TypeVar, Set\nT = TypeVar(\"T\")\ndef remove_elements(source: List[T], reference: Iterable[T]) -> List[T]:\n    \"\"\"\n    Return a new list containing all elements from `source` that are **not**\n    present in `reference`. The relative order of elements is preserved.\n\n    Args:\n        source (List[T]): The list from which elements will be removed.\n        reference (Iterable[T]): Iterable of elements to remove. Elements\n            must be comparable via ``==``.\n\n    Returns:\n        List[T]: New list with the specified elements removed.\n\n    Raises:\n        TypeError: If ``source`` is not a list.\n        TypeError: If an element in ``reference`` is unhashable.\n\n    Examples:\n        >>> remove_elements([1, 2, 3, 4, 5], [2, 4])\n        [1, 3, 5]\n        >>> remove_elements(['a', 'b', 'c'], [])\n        ['a', 'b', 'c']\n        >>> remove_elements([], [1, 2])\n        []\n    \"\"\"\n    if not isinstance(source, list):\n        raise TypeError(\"source must be a list\")\n\n    try:\n        ref_set: Set[T] = set(reference)\n    except TypeError as exc:\n        raise TypeError(\"All elements in reference must be hashable\") from exc\n\n    if not ref_set:\n        return source\n\n    result: List[T] = []\n    for element in source:\n        if element not in ref_set:\n            result.append(element)\n    return result"}
{"task_id": "Mbpp/162", "solution": "def sum_series(n: int) -> int:\n    \"\"\"\n    Compute the sum of the series: n - 2*i for i = 0 .. n//2 inclusive.\n\n    The series consists of integer terms starting at n and decreasing by 2\n    each step until the floor of half of n is reached.\n\n    Parameters\n    ----------\n    n : int\n        A non-negative integer. Must be >= 0.\n\n    Returns\n    -------\n    int\n        The total sum of the series.\n\n    Raises\n    ------\n    TypeError\n        If `n` is not an integer.\n    ValueError\n        If `n` is negative.\n\n    Examples\n    --------\n    >>> sum_series(0)\n    0\n    >>> sum_series(1)\n    1\n    >>> sum_series(5)\n    9   # 5 + 3 + 1\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(f\"n must be an integer, got {type(n).__name__}\")\n    if n < 0:\n        raise ValueError(f\"n must be non\u2011negative, got {n}\")\n\n    half = n // 2\n    return sum(n - 2 * i for i in range(half + 1))"}
{"task_id": "Mbpp/165", "solution": "def count_char_position(text: str) -> int:\n    \"\"\"\n    Counts characters in `text` that are at the same position in the alphabet\n    as their 1\u2011based index within the string, ignoring case and non\u2011alphabetic characters.\n\n    :param text: Input string to analyze.\n    :return: Integer count of matching characters.\n    \"\"\"\n    count = 0\n    position = 1  # 1-based index for alphabetic characters only\n    for ch in text:\n        if ch.isalpha():\n            alpha_pos = ord(ch.lower()) - ord('a') + 1\n            if alpha_pos == position:\n                count += 1\n            position += 1\n    return count"}
{"task_id": "Mbpp/166", "solution": "from typing import List\ndef find_even_pair(nums: List[int]) -> int:\n    \"\"\"Counts unordered pairs of integers in 'nums' whose XOR is even.\n\n    Parameters:\n        nums (List[int]): Input list of integers.\n\n    Returns:\n        int: Number of pairs with even XOR.\n    \"\"\"\n    if nums is None:\n        return 0\n\n    even_count = 0\n    odd_count = 0\n\n    for x in nums:\n        if not isinstance(x, int):\n            raise TypeError(\"All elements must be integers\")\n        if x & 1 == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n\n    even_pairs = even_count * (even_count - 1) // 2\n    odd_pairs = odd_count * (odd_count - 1) // 2\n    return even_pairs + odd_pairs"}
{"task_id": "Mbpp/167", "solution": "def next_power_of_2(n: int) -> int:\n    \"\"\"Return the smallest power of two that is greater than or equal to n.\n\n    Parameters\n    ----------\n    n : int\n        Non\u2011negative integer.\n\n    Returns\n    -------\n    int\n        Smallest power of two `m` such that `m >= n`.\n\n    Raises\n    ------\n    TypeError\n        If n is not an integer.\n    ValueError\n        If n is negative.\n    \"\"\"\n    _validate_input(n)\n\n    if n == 0:\n        return 1\n\n    # Compute the highest power of two less than or equal to n.\n    # n.bit_length() gives the number of bits required to represent n.\n    m = 1 << (n.bit_length() - 1)\n\n    # If n is already a power of two, return it; otherwise, return the next power.\n    return m if m >= n else m << 1"}
