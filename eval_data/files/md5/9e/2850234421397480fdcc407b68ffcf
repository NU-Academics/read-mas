{"task_id": "Mbpp/63", "solution": "from typing import List, Tuple\ndef max_difference(pairs: List[Tuple[int, int]]) -> int:\n    \"\"\"\n    Compute the maximum absolute difference between the two integers in each 2\u2011element tuple of an input list.\n\n    Parameters\n    ----------\n    pairs : List[Tuple[int, int]]\n        A list of tuples, each containing exactly two integers.\n\n    Returns\n    -------\n    int\n        The maximum absolute difference found across all tuples.\n\n    Raises\n    ------\n    ValueError\n        If the input list is empty.\n\n    Examples\n    --------\n    >>> pairs = [(1, 5), (3, -2), (10, 10)]\n    >>> max_difference(pairs)\n    5\n    \"\"\"\n    if not pairs:\n        raise ValueError(\"Input list must not be empty.\")\n\n    max_diff = 0\n    for a, b in pairs:\n        diff = abs(a - b)\n        if diff > max_diff:\n            max_diff = diff\n    return max_diff"}
{"task_id": "Mbpp/64", "solution": "from typing import Iterable, List, Tuple, Union\ndef subject_marks(\n    subjects: Iterable[Tuple[str, Union[int, float]]]\n) -> List[Tuple[str, Union[int, float]]]:\n    \"\"\"Return a list of (subject, score) tuples sorted ascending by score.\n\n    The function is pure: it does not modify the input iterable or any external state.\n    It accepts any iterable of 2\u2011item tuples where the second element is a numeric\n    score (int or float). The result is always a new list.\n\n    Parameters\n    ----------\n    subjects : Iterable[Tuple[str, Union[int, float]]]\n        An iterable of (subject, score) tuples.\n\n    Returns\n    -------\n    List[Tuple[str, Union[int, float]]]\n        A new list sorted by the numeric score in ascending order.\n\n    Raises\n    ------\n    TypeError\n        If an element in the iterable is not a 2\u2011tuple or if the score is not\n        an int or float.\n\n    Examples\n    --------\n    >>> subject_marks([('Math', 90), ('Physics', 85)])\n    [('Physics', 85), ('Math', 90)]\n    \"\"\"\n    validated: List[Tuple[str, Union[int, float]]] = []\n    for item in subjects:\n        if not isinstance(item, tuple) or len(item) != 2:\n            raise TypeError(f\"Each item must be a 2-tuple, got {item!r}\")\n        subject, score = item\n        if not isinstance(score, (int, float)):\n            raise TypeError(f\"Score must be int or float, got {type(score)!r}\")\n        validated.append((subject, score))\n    return sorted(validated, key=lambda x: x[1])"}
{"task_id": "Mbpp/65", "solution": "def recursive_list_sum(data: list) -> int:\n    \"\"\"Return the sum of all integer elements in a nested list.\n\n    Parameters\n    ----------\n    data : list\n        A list that may contain integers, nested lists, or other objects.\n\n    Returns\n    -------\n    int\n        The sum of all integer values found within `data`. Non\u2011integer items\n        are ignored. An empty list or a list containing no integers yields 0.\n\n    Raises\n    ------\n    TypeError\n        If `data` is not a list.\n\n    Examples\n    --------\n    >>> recursive_list_sum([1, [2, 3], [4, [5]]])\n    15\n\n    >>> recursive_list_sum([1, 'a', [2, None, [3, 'x']]])\n    6\n\n    >>> recursive_list_sum([])\n    0\n    \"\"\"\n    if not isinstance(data, list):\n        raise TypeError(\"Input must be a list\")\n\n    def _summation(sublist: list) -> int:\n        total = 0\n        for item in sublist:\n            if isinstance(item, int):\n                total += item\n            elif isinstance(item, list):\n                total += _summation(item)\n            # ignore all other types\n        return total\n\n    return _summation(data)"}
{"task_id": "Mbpp/66", "solution": "from typing import Iterable, Any\ndef pos_count(values: Iterable[Any]) -> int:\n    \"\"\"Count the number of positive integers in the provided iterable.\n\n    Parameters\n    ----------\n    values : Iterable[Any]\n        An iterable containing any type of elements. Elements that are not of type\n        `int` are ignored. The iterable may be a list, tuple, set, generator, etc.\n\n    Returns\n    -------\n    int\n        The count of elements in `values` that are integers greater than zero.\n\n    Raises\n    ------\n    TypeError\n        If `values` is not an instance of `Iterable`.\n\n    Examples\n    --------\n    >>> pos_count([1, -2, 3, 0, 'a', 5.5])\n    2\n    >>> pos_count([])\n    0\n    >>> pos_count([0, -1, -5])\n    0\n    \"\"\"\n    if not isinstance(values, Iterable):\n        raise TypeError(\"pos_count expects an iterable of values\")\n\n    count = 0\n    for item in values:\n        if isinstance(item, int) and item > 0:\n            count += 1\n    return count"}
{"task_id": "Mbpp/67", "solution": "def bell_number(n: int) -> int:\n    \"\"\"\n    Compute the nth Bell number using the Bell triangle dynamic programming approach.\n    Parameters\n    ----------\n    n : int\n        Non\u2011negative integer index of the Bell number to compute.\n    Returns\n    -------\n    int\n        The exact integer value of the nth Bell number.\n    Raises\n    ------\n    ValueError\n        If n is not an integer or is negative.\n    \"\"\"\n    if not isinstance(n, int):\n        raise ValueError(\"n must be an integer\")\n    if n < 0:\n        raise ValueError(\"n must be non\u2011negative\")\n    if n == 0:\n        return 1\n\n    prev_row = [1]  # T[0][0]\n    for i in range(1, n + 1):\n        curr_row = [prev_row[-1]]  # T[i][0] = T[i-1][i-1]\n        for j in range(1, i + 1):\n            val = curr_row[j - 1] + (prev_row[j] if j < len(prev_row) else 0)\n            curr_row.append(val)\n        prev_row = curr_row\n    return prev_row[0]"}
{"task_id": "Mbpp/68", "solution": "def is_Monotonic(arr):\n    \"\"\"\n    Determine if the input array is monotonic.\n\n    Parameters\n    ----------\n    arr : sequence\n        Sequence of comparable elements.\n\n    Returns\n    -------\n    bool\n        True if arr is monotonic, False otherwise.\n\n    Raises\n    ------\n    ValueError\n        If arr is None.\n    \"\"\"\n    if arr is None:\n        raise ValueError(\"Input array cannot be None\")\n\n    if len(arr) <= 1:\n        return True\n\n    increasing = None\n    decreasing = None\n\n    for i in range(1, len(arr)):\n        prev, curr = arr[i - 1], arr[i]\n\n        if curr > prev:\n            if decreasing:\n                return False\n            increasing = True\n        elif curr < prev:\n            if increasing:\n                return False\n            decreasing = True\n\n    return True"}
{"task_id": "Mbpp/69", "solution": "def _build_lps(pattern: list) -> list:\n    \"\"\"Build the longest prefix-suffix (lps) array for KMP.\"\"\"\n    lps = [0] * len(pattern)\n    length = 0\n    i = 1\n    while i < len(pattern):\n        if pattern[i] == pattern[length]:\n            length += 1\n            lps[i] = length\n            i += 1\n        else:\n            if length != 0:\n                length = lps[length - 1]\n            else:\n                lps[i] = 0\n                i += 1\n    return lps\ndef is_sublist(main: list, sub: list) -> bool:\n    \"\"\"Return True if `sub` appears as a contiguous subsequence in `main`.\"\"\"\n    if not sub:\n        return True\n    if len(sub) > len(main):\n        return False\n\n    lps = _build_lps(sub)\n    i = j = 0\n    while i < len(main):\n        if main[i] == sub[j]:\n            i += 1\n            j += 1\n            if j == len(sub):\n                return True\n        else:\n            if j != 0:\n                j = lps[j - 1]\n            else:\n                i += 1\n    return False"}
{"task_id": "Mbpp/70", "solution": "from typing import List, Tuple\ndef get_equal(tuple_list: List[Tuple]) -> bool:\n    \"\"\"Determines if all tuples in a list have equal length.\n\n    Parameters\n    ----------\n    tuple_list : List[Tuple]\n        List containing tuples.\n\n    Returns\n    -------\n    bool\n        True if all tuples have the same length, False otherwise.\n\n    Raises\n    ------\n    TypeError\n        If input is not a list or contains non-tuple elements.\n    \"\"\"\n    if not isinstance(tuple_list, list):\n        raise TypeError(\"Input must be a list\")\n\n    if not tuple_list:\n        return True\n\n    for element in tuple_list:\n        if not isinstance(element, tuple):\n            raise TypeError(\"All elements must be tuples\")\n\n    expected_len = len(tuple_list[0])\n    for t in tuple_list[1:]:\n        if len(t) != expected_len:\n            return False\n\n    return True"}
{"task_id": "Mbpp/71", "solution": "from typing import List, TypeVar\nT = TypeVar(\"T\")\ndef comb_sort(input_list: List[T], *, verbose: bool = False) -> List[T]:\n    \"\"\"Sort a list using the Comb Sort algorithm and return a new sorted list.\n\n    Parameters\n    ----------\n    input_list : List[T]\n        List of comparable elements to sort.\n    verbose : bool, optional\n        If True, prints debug information about each pass and swap.\n        Default is False.\n\n    Returns\n    -------\n    List[T]\n        A new list containing the elements of *input_list* sorted in ascending order.\n    \"\"\"\n    n = len(input_list)\n    if n <= 1:\n        return input_list.copy()\n\n    arr = input_list.copy()\n    gap = n\n    shrink_factor = 1.3\n    swapped = True\n    pass_number = 0\n\n    while gap > 1 or swapped:\n        gap = max(1, int(gap / shrink_factor))\n        swapped = False\n        pass_number += 1\n        if verbose:\n            print(f\"Pass {pass_number}: gap = {gap}\")\n\n        for i in range(n - gap):\n            if arr[i] > arr[i + gap]:\n                arr[i], arr[i + gap] = arr[i + gap], arr[i]\n                swapped = True\n                if verbose:\n                    print(f\"  Swapped indices {i} and {i + gap}\")\n\n    return arr"}
{"task_id": "Mbpp/72", "solution": "def dif_Square(n):\n    if not isinstance(n, int):\n        raise TypeError(\"Input must be an integer\")\n    if n == 0:\n        return True\n    return (n % 4) != 2"}
{"task_id": "Mbpp/74", "solution": "from collections.abc import Iterable\nfrom typing import Iterable as TypingIterable\ndef is_samepatterns(seqA: TypingIterable, seqB: TypingIterable) -> bool:\n    if not (isinstance(seqA, Iterable) and isinstance(seqB, Iterable)):\n        raise TypeError(\"Both inputs must be sequences.\")\n    a = list(seqA)\n    b = list(seqB)\n    if len(a) != len(b):\n        return False\n    map_a = {}\n    map_b = {}\n    for idx, (x, y) in enumerate(zip(a, b)):\n        try:\n            if x not in map_a:\n                map_a[x] = idx\n            if y not in map_b:\n                map_b[y] = idx\n        except TypeError as e:\n            raise ValueError(\"All elements must be hashable.\") from e\n        if map_a[x] != map_b[y]:\n            return False\n    return True"}
{"task_id": "Mbpp/75", "solution": "from typing import List, Tuple\ndef _filter_tuples(tuples: List[Tuple[int, ...]], k: int) -> List[Tuple[int, ...]]:\n    return [t for t in tuples if all(e % k == 0 for e in t)]\ndef find_tuples(tuples: List[Tuple[int, ...]], k: int) -> List[Tuple[int, ...]]:\n    \"\"\"\n    Return a list of tuples where every element is divisible by k.\n\n    Parameters\n    ----------\n    tuples : List[Tuple[int, ...]]\n        Input list of integer tuples.\n    k : int\n        Divisor. Must be non-zero.\n\n    Returns\n    -------\n    List[Tuple[int, ...]]\n        Filtered list preserving original order.\n\n    Raises\n    ------\n    InputValidationError\n        If k is zero or inputs are of incorrect type.\n    \"\"\"\n    _validate_inputs(tuples, k)\n    return _filter_tuples(tuples, k)"}
{"task_id": "Mbpp/77", "solution": "def is_Diff(n: int) -> bool:\n    \"\"\"\n    Determine if an integer is divisible by 11.\n\n    Parameters:\n        n (int): The number to test.\n\n    Returns:\n        bool: True if n is divisible by 11, False otherwise.\n\n    Raises:\n        TypeError: If n is not an integer.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"Input must be an integer.\")\n    return n % 11 == 0"}
{"task_id": "Mbpp/79", "solution": "import logging\nlogger = logging.getLogger(__name__)\ndef word_len(word: str) -> bool:\n    \"\"\"\n    Determine whether the length of a word is odd.\n\n    Parameters\n    ----------\n    word : str\n        The word to evaluate. Must be a non\u2011empty string.\n\n    Returns\n    -------\n    bool\n        True if the length of ``word`` is odd, False otherwise.\n\n    Raises\n    ------\n    ValueError\n        If ``word`` is not a string or is empty.\n    \"\"\"\n    if not isinstance(word, str):\n        raise ValueError(\"Input must be a string.\")\n    if not word:\n        raise ValueError(\"Input string must not be empty.\")\n\n    result = len(word) % 2 == 1\n    logger.info(\"word_len called with '%s' -> %s\", word, result)\n    return result"}
{"task_id": "Mbpp/80", "solution": "def tetrahedral_number(n: int) -> int:\n    \"\"\"\n    Compute the nth tetrahedral number.\n\n    Parameters:\n        n (int): 1-based index of the tetrahedral number. Must be >= 1.\n\n    Returns:\n        int: The nth tetrahedral number.\n\n    Raises:\n        ValueError: If n is not an integer or n < 1.\n\n    Examples:\n        >>> tetrahedral_number(1)\n        1\n        >>> tetrahedral_number(5)\n        35\n    \"\"\"\n    if not isinstance(n, int):\n        raise ValueError(\"n must be an integer\")\n    if n < 1:\n        raise ValueError(\"n must be a positive integer\")\n\n    return n * (n + 1) * (n + 2) // 6"}
{"task_id": "Mbpp/82", "solution": "import math\nfrom typing import Union\ndef volume_sphere(radius: Union[int, float]) -> float:\n    \"\"\"\n    Calculate the volume of a sphere.\n\n    Args:\n        radius: The radius of the sphere. Must be a non\u2011negative number\n                (int or float). The radius is interpreted in the unit\n                of the caller (e.g., meters).\n\n    Returns:\n        The volume of the sphere as a float.\n\n    Raises:\n        TypeError: If `radius` is not an int or float.\n        ValueError: If `radius` is negative, NaN, or infinite.\n\n    Example:\n        >>> volume_sphere(1)\n        4.1887902047863905\n    \"\"\"\n    if not isinstance(radius, (int, float)):\n        raise TypeError(\n            f\"radius must be a numeric type (int or float), got {type(radius).__name__}\"\n        )\n\n    if math.isnan(radius) or not math.isfinite(radius):\n        raise ValueError(\"radius cannot be NaN or infinite\")\n\n    if radius < 0:\n        raise ValueError(f\"radius cannot be negative; received {radius}\")\n\n    volume = (4.0 / 3.0) * math.pi * radius ** 3\n    return float(volume)"}
{"task_id": "Mbpp/84", "solution": "def sequence(n: int) -> int:\n    \"\"\"\n    Compute the n-th term of the Newman\u2013Conway sequence.\n\n    The Newman\u2013Conway sequence is defined by:\n        a(1) = 1, a(2) = 1\n        For n \u2265 3:\n            if n is even: a(n) = a(n-1) + a(n/2)\n            if n is odd : a(n) = a(n-1) - a((n-1)/2)\n\n    Parameters\n    ----------\n    n : int\n        The 1\u2011based index into the Newman\u2013Conway sequence.\n        Must be a positive integer (n \u2265 1).\n\n    Returns\n    -------\n    int\n        The n-th term of the sequence.\n\n    Raises\n    ------\n    ValueError\n        If ``n`` is not an integer or is less than 1.\n\n    Examples\n    --------\n    >>> sequence(1)\n    1\n    >>> sequence(5)\n    1\n    >>> sequence(10)\n    4\n    \"\"\"\n    if not isinstance(n, int):\n        raise ValueError(\"n must be an integer\")\n    if n < 1:\n        raise ValueError(\"n must be \u2265 1\")\n\n    if n == 1 or n == 2:\n        return 1\n\n    seq = [0] * (n + 1)\n    seq[1] = seq[2] = 1\n\n    for i in range(3, n + 1):\n        if i % 2 == 0:\n            seq[i] = seq[i - 1] + seq[i // 2]\n        else:\n            seq[i] = seq[i - 1] - seq[(i - 1) // 2]\n\n    return seq[n]"}
{"task_id": "Mbpp/85", "solution": "import math\ndef surfacearea_sphere(radius: float) -> float:\n    \"\"\"Calculate the surface area of a sphere.\n\n    Parameters\n    ----------\n    radius : float\n        Radius of the sphere. Must be non\u2011negative.\n\n    Returns\n    -------\n    float\n        Surface area of the sphere computed as 4 * \u03c0 * radius^2.\n\n    Raises\n    ------\n    TypeError\n        If radius is not an int or float.\n    ValueError\n        If radius is negative.\n\n    Examples\n    --------\n    >>> surfacearea_sphere(1)\n    12.566370614359172\n    >>> surfacearea_sphere(0)\n    0.0\n    \"\"\"\n    if not isinstance(radius, (int, float)):\n        raise TypeError(\"radius must be a number\")\n    if radius < 0:\n        raise ValueError(\"radius must be non-negative\")\n    return 4 * math.pi * radius ** 2"}
{"task_id": "Mbpp/86", "solution": "def centered_hexagonal_number(n: int) -> int:\n    \"\"\"Return the nth centered hexagonal number.\n\n    Parameters:\n        n (int): Sequence index, must be >= 1.\n\n    Returns:\n        int: The nth centered hexagonal number.\n\n    Example:\n        >>> centered_hexagonal_number(1)\n        1\n        >>> centered_hexagonal_number(3)\n        19\n    \"\"\"\n    if not isinstance(n, int) or n < 1:\n        raise ValueError(\"n must be an integer >= 1\")\n    return 3 * n * (n - 1) + 1"}
{"task_id": "Mbpp/87", "solution": "from typing import Any, Dict, Hashable\ndef merge_dictionaries_three(\n    dict_a: Dict[Hashable, Any],\n    dict_b: Dict[Hashable, Any],\n    dict_c: Dict[Hashable, Any],\n) -> Dict[Hashable, Any]:\n    \"\"\"\n    Merge three dictionaries into a new dictionary.\n\n    The merge follows these rules:\n\n    1. Keys from ``dict_a`` are added first.\n    2. Keys from ``dict_b`` are added next; if a key already exists, its value\n       is overwritten.\n    3. Keys from ``dict_c`` are added last; if a key already exists, its value\n       is overwritten.\n\n    Parameters\n    ----------\n    dict_a, dict_b, dict_c\n        Dictionaries to merge. Keys must be hashable. Values can be of any type.\n\n    Returns\n    -------\n    dict\n        A new dictionary containing all key/value pairs from the three inputs.\n        The order of insertion is preserved: ``dict_a`` keys first,\n        then ``dict_b`` keys, then ``dict_c`` keys.\n\n    Examples\n    --------\n    >>> merge_dictionaries_three({'x': 1}, {'y': 2}, {'x': 3})\n    {'x': 3, 'y': 2}\n\n    Notes\n    -----\n    - The function is pure; it does not modify the input dictionaries.\n    - If any input is not a ``dict`` instance, a ``TypeError`` is raised.\n    \"\"\"\n    if not isinstance(dict_a, dict):\n        raise TypeError(\"dict_a must be a dict\")\n    if not isinstance(dict_b, dict):\n        raise TypeError(\"dict_b must be a dict\")\n    if not isinstance(dict_c, dict):\n        raise TypeError(\"dict_c must be a dict\")\n\n    merged: Dict[Hashable, Any] = dict(dict_a)\n    merged.update(dict_b)\n    merged.update(dict_c)\n    return merged"}
{"task_id": "Mbpp/88", "solution": "import collections\nfrom typing import Dict, Hashable, List\ndef freq_count(elements: List[Hashable]) -> Dict[Hashable, int]:\n    \"\"\"\n    Compute the frequency of each element in a list.\n\n    Parameters\n    ----------\n    elements : List[Hashable]\n        A list of hashable items (e.g., int, str, tuple).\n\n    Returns\n    -------\n    Dict[Hashable, int]\n        Dictionary mapping each unique element to its occurrence count.\n\n    Notes\n    -----\n    - An empty input list returns an empty dictionary.\n    - The function is O(n) in time and O(k) in space.\n    - Uses collections.Counter internally for optimal performance.\n    \"\"\"\n    if not isinstance(elements, list):\n        raise TypeError(\"Expected a list of hashable elements, got %r\" % type(elements).__name__)\n    counter = collections.Counter(elements)\n    return dict(counter)"}
