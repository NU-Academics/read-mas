{"task_id": "Mbpp/133", "solution": "def sum_negativenum(numbers: list) -> float:\n    \"\"\"\n    Return the sum of all negative numeric values in the given list.\n\n    Parameters\n    ----------\n    numbers : list\n        List containing arbitrary elements.\n\n    Returns\n    -------\n    int | float\n        Sum of all elements that are numeric (int or float) and less than zero.\n        Returns 0 if the list is empty or contains no negative numeric values.\n\n    Notes\n    -----\n    Non-numeric entries are ignored. The input list is not modified.\n    \"\"\"\n    total = 0\n    for item in numbers:\n        if isinstance(item, (int, float)) and item < 0:\n            total += item\n    return total"}
{"task_id": "Mbpp/135", "solution": "def hexagonal_num(n: int) -> int:\n    \"\"\"Calculate the nth hexagonal number.\n\n    Parameters\n    ----------\n    n : int\n        The ordinal position (must be a positive integer).\n\n    Returns\n    -------\n    int\n        The nth hexagonal number.\n\n    Raises\n    ------\n    ValueError\n        If n is not a positive integer.\n    \"\"\"\n    if not isinstance(n, int) or n <= 0:\n        raise ValueError(\"n must be a positive integer.\")\n    return n * (2 * n - 1)"}
{"task_id": "Mbpp/137", "solution": "from typing import List\ndef zero_count(nums: List[int]) -> float:\n    \"\"\"\n    Compute the ratio of zero elements to non\u2011zero elements in a list.\n\n    Parameters\n    ----------\n    nums : List[int]\n        List of integers to analyze.\n\n    Returns\n    -------\n    float\n        Ratio of zero elements to non\u2011zero elements.\n\n    Raises\n    ------\n    ValueError\n        If the input list is empty or contains no non\u2011zero elements.\n\n    Examples\n    --------\n    >>> zero_count([0, 1, 0, 2])\n    0.5\n    >>> zero_count([1, 2, 3])\n    0.0\n    \"\"\"\n    if not nums:\n        raise ValueError(\"Input list must not be empty.\")\n\n    zero_cnt = 0\n    non_zero_cnt = 0\n\n    for num in nums:\n        if num == 0:\n            zero_cnt += 1\n        else:\n            non_zero_cnt += 1\n\n    if non_zero_cnt == 0:\n        raise ValueError(\"No non\u2011zero elements present.\")\n\n    return zero_cnt / non_zero_cnt"}
{"task_id": "Mbpp/138", "solution": "import unittest\ndef is_Sum_Of_Powers_Of_Two(n: int) -> bool:\n    \"\"\"\n    Determines if a positive integer can be expressed as a sum of powers of two\n    where each power has an exponent of at least 1 (i.e., 2, 4, 8, ...).\n\n    Parameters\n    ----------\n    n : int\n        The integer to test. Must be an integer greater than 0.\n\n    Returns\n    -------\n    bool\n        True if representable, False otherwise.\n\n    Raises\n    ------\n    TypeError\n        If n is not an integer.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"Input must be an integer\")\n\n    if n <= 0:\n        return False\n\n    return (n & 1) == 0"}
{"task_id": "Mbpp/139", "solution": "import math\ndef circle_circumference(r: float) -> float:\n    \"\"\"\n    Calculate the circumference of a circle given its radius.\n\n    Parameters\n    ----------\n    r : float\n        Radius of the circle. Must be a non\u2011negative number.\n\n    Returns\n    -------\n    float\n        Circumference of the circle.\n\n    Raises\n    ------\n    AssertionError\n        If r is negative or not a numeric type.\n\n    Examples\n    --------\n    >>> circle_circumference(1)\n    6.283185307179586\n    \"\"\"\n    assert isinstance(r, (int, float)), \"Radius must be a numeric type.\"\n    assert r >= 0, \"Radius must be non\u2011negative.\"\n    return 2 * math.pi * r"}
