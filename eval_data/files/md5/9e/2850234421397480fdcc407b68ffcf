{"task_id": "Mbpp/2", "solution": "import collections\nfrom collections.abc import Iterable, Sequence\nfrom typing import Any, Iterable as IterableType, List\ndef _core_algorithm(a: IterableType[Any], b: IterableType[Any]) -> List[Any]:\n    _validate_iterable(a, \"a\")\n    _validate_iterable(b, \"b\")\n\n    try:\n        counter_b = collections.Counter(b)\n        result: List[Any] = []\n        for item in a:\n            if counter_b[item] > 0:\n                result.append(item)\n                counter_b[item] -= 1\n        return result\n    except TypeError:\n        list_b = list(b)\n        result: List[Any] = []\n        for item in a:\n            try:\n                idx = list_b.index(item)\n                result.append(item)\n                list_b.pop(idx)\n            except ValueError:\n                continue\n        return result\ndef similar_elements(a: Iterable[Any], b: Iterable[Any]) -> Sequence[Any]:\n    \"\"\"\n    Return the intersection of two iterables, preserving the order of the first iterable.\n\n    Parameters\n    ----------\n    a : Iterable[Any]\n        First input iterable.\n    b : Iterable[Any]\n        Second input iterable.\n\n    Returns\n    -------\n    Sequence[Any]\n        A list containing elements that appear in both `a` and `b`. The order follows\n        the appearance in `a`. Duplicate elements are included as many times as they\n        appear in both sequences (intersection semantics).\n\n    Raises\n    ------\n    TypeError\n        If either `a` or `b` is not an iterable.\n    \"\"\"\n    return _core_algorithm(a, b)"}
{"task_id": "Mbpp/3", "solution": "import math\ndef is_not_prime(n: int) -> bool:\n    \"\"\"\n    Determine if the integer n is NOT a prime number.\n\n    Parameters:\n        n (int): The number to test.\n\n    Returns:\n        bool: True if n is non\u2011prime, False if n is prime.\n\n    Raises:\n        TypeError: If n is not an integer.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n\n    # Non\u2011prime if n is less than or equal to 1\n    if n <= 1:\n        return True\n\n    # 2 is the only even prime\n    if n == 2:\n        return False\n\n    # Any other even number is composite\n    if n % 2 == 0:\n        return True\n\n    # Check odd divisors up to sqrt(n)\n    limit = math.isqrt(n) + 1\n    for i in range(3, limit, 2):\n        if n % i == 0:\n            return True\n\n    return False"}
{"task_id": "Mbpp/4", "solution": "import heapq\nfrom typing import Iterable, List\ndef heap_queue_largest(data: Iterable[int], n: int) -> List[int]:\n    \"\"\"Return the `n` largest integers from `data` in descending order.\n\n    Parameters\n    ----------\n    data : Iterable[int]\n        An iterable containing integer values.\n    n : int\n        The number of largest values to return. Must be >= 0.\n\n    Returns\n    -------\n    List[int]\n        A list of the `n` largest integers sorted from greatest to least.\n\n    Raises\n    ------\n    TypeError\n        If `data` is not iterable or contains non\u2011int elements.\n    ValueError\n        If `n` is negative.\n\n    Notes\n    -----\n    - If `n` is zero, an empty list is returned.\n    - If `n` exceeds the length of `data`, all elements are returned sorted.\n    - The implementation uses `heapq.nlargest` for optimal performance.\n    \"\"\"\n    if not isinstance(n, int) or n < 0:\n        raise ValueError(\"n must be a non\u2011negative integer\")\n\n    try:\n        seq = list(data)\n    except TypeError:\n        raise TypeError(\"data must be an iterable\")\n\n    for val in seq:\n        if not isinstance(val, int):\n            raise TypeError(\"All elements in data must be integers\")\n\n    if n == 0:\n        return []\n\n    return heapq.nlargest(n, seq)"}
