um is even.\n    \"\"\"\n    if not array:\n        return []\n\n    if len(array) == 1:\n        return list(array)  # Return a copy for single-element array\n\n    first_val = array[0]\n    last_val = array[-1]\n    sum_of_ends = first_val + last_val\n\n    if sum_of_ends % 2 == 1:  # Odd sum, sort ascending\n        return sorted(array)\n    else:  # Even sum, sort descending\n        return sorted(array, reverse=True)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/89": [{"task_id": "HumanEval/89", "solution": "def encrypt(s):\n    \"\"\"Encrypts a string by rotating alphabetical characters by a shift of 4,\n    preserving case, and leaving non-alphabetical characters unchanged.\n    \"\"\"\n    shift = 4\n    encrypted_chars = []\n    for char in s:\n        if 'a' <= char <= 'z':\n            base = ord('a')\n            encrypted_chars.append(chr((ord(char) - base + shift) % 26 + base))\n        elif 'A' <= char <= 'Z':\n            base = ord('A')\n            encrypted_chars.append(chr((ord(char) - base + shift) % 26 + base))\n        else:\n            encrypted_chars.append(char)\n    return ''.join(encrypted_chars)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/89", "solution": "def encrypt(s):\n    \"\"\"Create a function encrypt that takes a string as an argument and\n    returns a string encrypted with the alphabet being rotated by 4 places.\n    \"\"\"\n    shift = 4\n    encrypted_chars = []\n    for char in s:\n        if 'a' <= char <= 'z':\n            start = ord('a')\n            encrypted_char = chr(start + (ord(char) - start + shift) % 26)\n            encrypted_chars.append(encrypted_char)\n        elif 'A' <= char <= 'Z':\n            start = ord('A')\n            encrypted_char = chr(start + (ord(char) - start + shift) % 26)\n            encrypted_chars.append(encrypted_char)\n        else:\n            encrypte