 = max_results\nclass FilterResult:\n    \"\"\"Holds the results of a string filtering operation.\"\"\"\n    def __init__(self, matches: List[str], duration_ms: float) -> None:\n        self.matches = matches\n        self.count = len(matches)\n        self.duration_ms = duration_ms\nclass StringRepository(ABC):\n    \"\"\"Abstract base class for string repositories.\"\"\"\n    @abstractmethod\n    def list_strings(self) -> Iterable[str]:\n        pass\n\n    @abstractmethod\n    def add(self, s: str) -> None:\n        pass\n\n    @abstractmethod\n    def count(self) -> int:\n        pass\nclass InMemoryStringRepository(StringRepository):\n    \"\"\"An in-memory implementation of StringRepository.\"\"\"\n    def __init__(self, items: Optional[List[str]] = None) -> None:\n        self._items = list(items or [])\n\n    def list_strings(self) -> Iterable[str]:\n        for s in self._items:\n            yield s\n\n    def add(self, s: str) -> None:\n        self._items.append(s)\n\n    def count(self) -> int:\n        return len(self._items)\nclass StringFilterService:\n    \"\"\"Provides core business logic for filtering strings.\"\"\"\n    def __init__(self, repository: StringRepository, case_sensitive_default: bool = True, strict_default: bool = True) -> None:\n        self.repository = repository\n        self.case_sensitive_default = case_sensitive_default\n        self.strict_default = strict_default\n\n    def filter(self, criteria: FilterCriteria) -> FilterResult:\n        \"\"\"Filters strings from the repository based on the given criteria.\"\"\"\n        validate_prefix(criteria.prefix)\n        start = time.time()\n        matches: List[str] = []\n        \n        compare_prefix = criteria.prefix\n        if not criteria.case_sensitive:\n            compare_prefix = compare_prefix.lower()\n\n        try:\n            for s in self.repository.list_strings():\n                if not is_string(s):\n                    if criteria.strict:\n                        raise ValidationError(\"Non-string element encountered in list\")\n                    else:\n                        continue\n                \n                candidate_s = s\n                if not criteria.case_sensitive:\n                    candidate_s = candidate_s.lower()\n\n                if candidate_s.startswith(compare_prefix):\n                    matches.append(s)\n                    if criteria.max_results is not None and len(matches) >= criteria.max_results:\n                        break\n        except StringUtilsError:\n            raise\n        except Exception as e:\n            raise ServiceError(f\"An unexpected error occurred during filtering: {e}\") from e\n        \n        duration_ms = (time.time() - start) * 1000.0\n        return FilterResult(matches, duration_ms)\ndef filter_by_prefix(strings: List[str], prefix: str) -> List[str]:\n    \"\"\" Filter an input list of strings only for ones that start with a given prefix.\"\"\"\n    repo = InMemoryStringRepository(strings.copy())\n    svc = StringFilterService(repo)\n    criteria = FilterCriteria(prefix=prefix, case_sensitive=True, strict=True)\n    result = svc.filter(criteria)\n    return result.matches", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[[], "john"]], "plus_fail_tests": [[[], ""]]}], "HumanEval/30": [{"task_id": "HumanEval/30", "solution": "def get_positive(l: list):\n    \"\"\"Return only positive numbers in the list.\n    >>> get_positive([-1, 2, -4, 5, 6])\n    [2, 5, 6]\n    >>> get_positive([5, 3, -5, 2, -3, 3, 9, 0, 123, 1, -10])\n    [5, 3, 2, 3, 9, 123, 1]\n    \"\"\"\n    # Filters the list to include only numbers strictly greater than zero.\n    # Assumes comparable numeric types; non-numeric values would lead to a TypeError.\n    return [x for x in l if x > 0]", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/30", "solution": "def get_positive(l: list):\n    \"\"\"Ret