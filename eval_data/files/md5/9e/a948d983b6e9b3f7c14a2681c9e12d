 operator_stack.append(token)\n\n        while operator_stack:\n            output_queue.append(operator_stack.pop())\n        return output_queue\n\n    # 1. Build the infix token list by interleaving operands and operators.\n    # Operands are converted to strings as they will be processed as tokens.\n    tokens = []\n    for i in range(len(operand)):\n        tokens.append(str(operand[i]))\n        if i < len(operator):\n            tokens.append(operator[i])\n\n    # 2. Convert the infix token list to Reverse Polish Notation (RPN).\n    rpn_tokens = infix_to_rpn(tokens)\n\n    # 3. Evaluate the RPN expression.\n    evaluation_stack = []\n    for token in rpn_tokens:\n        if token in OP_PRECEDENCE:  # It's an operator\n            # Pop right operand first, then left operand\n            operand_right = evaluation_stack.pop()\n            operand_left = evaluation_stack.pop()\n            result = apply_operator(token, operand_left, operand_right)\n            evaluation_stack.append(result)\n        else:  # It's an operand (as a string, convert to int)\n            evaluation_stack.append(int(token))\n\n    return evaluation_stack[0]", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/160", "solution": "class OperatorInfo:\n    def __init__(self, op_str, precedence, associativity, func):\n        self.op_str = op_str\n        self.precedence = precedence\n        self.associativity = associativity\n        self.func = func\nOP_MAP = {\n    '**': OperatorInfo('**', precedence=4, associativity='right', func=lambda a, b: a ** b),\n    '*':  OperatorInfo('*', precedence=3, associativity='left',  func=lambda a, b: a * b),\n    '//': OperatorInfo('//', precedence=3, associativity='left', func=lambda a, b: a // b),\n    '+':  OperatorInfo('+', precedence=2, associativity='left',  func=lambda a, b: a + b),\n    '-':  OperatorInfo('-', precedence=2, associativity='left',  func=lambda a, b: a - b),\n}\nclass Token:\n    def __init__(self, token_type, value):\n        self.type = token_type  # 'NUMBER' or 'OP'\n        self.value = value\nclass ASTNode:\n    pass\nclass ValueNode(ASTNode):\n    def __init__(self, value):\n        self.value = value\nclass BinaryOpNode(ASTNode):\n    def __init__(self, op_str, left, right):\n        self.op_str = op_str\n        self.left = left\n        self.right = right\ndef do_algebra(operator, operand):\n    \"\"\"\n    Given two lists operator, and operand. The first list has basic algebra operations, and \n    the second list is a list of integers. Use the two given lists to build the algebric \n    expression and return the evaluation of this expression.\n    \"\"\"\n\n    # Step 1: Tokenization - Interleave operands and operators into a single token list.\n    tokens = []\n    for i in range(len(operand)):\n        tokens.append(Token('NUMBER', operand[i]))\n        if i < len(operator):\n            tokens.append(Token('OP', operator[i]))\n\n    # Step 2: Shunting-Yard Algorithm - Convert tokens to Reverse Polish Notation (RPN).\n    output_queue = []\n    operator_stack = []\n\n    for token in tokens:\n        if token.type == 'NUMBER':\n            output_queue.append(token)\n        elif token.type == 'OP':\n            op1_info = OP_MAP[token.value]\n            while operator_stack and operator_stack[-1].type == 'OP':\n                op2_info = OP_MAP[operator_stack[-1].value]\n                if (op1_info.associativity == 'left' and op1_info.precedence <= op2_info.precedence) or \\\n                   (op1_info.associativity == 'right' and op1_info.precedence < op2_info.precedence):\n                    output_queue.append(operator_stack.pop())\n                else:\n                    break\n            operator_stack.append(token)\n\n    while operator_stack:\n        output_queue.append(operator_stack.pop())\n\n    rpn_tokens = output_queue\n\n    # Step 3: Build Abstract Syntax Tree (AST) from RPN.\n    ast_stack = []\n    for token in rpn_tokens:\n        if token.type == 'NUMBER':\n            ast_stack.append(ValueNode(token.value))\n        elif token.type == 'OP':\n            right = ast_stack.pop()\n            left = ast_stack.pop()\n            ast_stack.append(BinaryOpNode(token.value, left, right))\n\n    ast_root = ast_stack[0]\n\n    # Step 4: Evaluate the AST recursively.\n    def _evaluate_node(node):\n        if isinstance(node, ValueNode):\n            return node.value\n        elif isinstance(node, BinaryOpNode):\n            left_val = _evaluate_node(node.left)\n            right_val = _evaluate_node(node.right)\n            op_func = OP_MAP[node.op_str].func\n            return op_func(left_val, right_val)\n        return 0 # Should not be reached with valid AST\n\n    return _evaluate_node(ast_root)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/161": [{"task_id": "HumanEval/161", "solution": "def solve(s):\n    \"\"\"Reverses letter case or reverses the string if no letters are present.\"\"\"\n\n    # Inline helper function to check if a character is a letter\n    def _is_letter(ch: str) -> bool:\n        return bool(ch) and ch.isalpha()\n\n    has_letter = False\n    for char_s in s:\n        if _is_letter(char_s):\n            has_letter = True\n            break\n\n    if not has_letter:\n        # If no letters, reverse the entire string\n        return s[::-1]\n    else:\n        # If letters are present, reverse the case of each letter\n        result_chars = []\n        for char_s in s:\n            if _is_letter(char_s):\n                result_chars.append(char_s.swapcase())\n            else:\n                result_chars.append(char_s)\n        return \"\".join(result_chars)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/161", "solution": "def solve(s):\n    \"\"\"\n    Transforms the string: reverses lette