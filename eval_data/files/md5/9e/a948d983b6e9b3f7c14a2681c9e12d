gits = odd_digits\n        self.product = product\n        self.ts = ts\ndef make_digit_result(input: int, odd_digits: List[int], product: int) -> DigitResult:\n    \"\"\"Factory function to create a DigitResult.\"\"\"\n    return DigitResult(\n        id=uuid.uuid4().hex,\n        input=input,\n        odd_digits=odd_digits,\n        product=product,\n        ts=datetime.datetime.utcnow().isoformat(timespec='seconds') + \"Z\"\n    )\nclass DigitProcessor:\n    \"\"\"Computes the product of odd digits from a given integer.\"\"\"\n    def __init__(self, parser: DigitParser) -> None:\n        self._parser = parser\n        # For the standalone `digits` function, persistence and configuration are not required,\n        # adhering to the design's \"no persistence by default in library mode\" assumption.\n\n    def compute_product(self, n: int) -> DigitResult:\n        digits = self._parser.parse_digits(n)\n        odd = [d for d in digits if d % 2 == 1]\n        product = 0 if not odd else reduce(operator.mul, odd, 1)\n        # Persistence logic is intentionally omitted for this core library function.\n        result = make_digit_result(input=n, odd_digits=odd, product=product)\n        return result\ndef digits(n):\n    \"\"\"Given a positive integer n, return the product of the odd digits.\n    Return 0 if all digits are even.\n    For example:\n    digits(1)  == 1\n    digits(4)  == 0\n    digits(235) == 15\n    \"\"\"\n    # Instantiate the parser and processor components for the computation.\n    parser = DigitParser()\n    processor = DigitProcessor(parser=parser)\n\n    # Delegate the core logic to the DigitProcessor and return the product.\n    result = processor.compute_product(n)\n    return result.product", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/129": [{"task_id": "HumanEval/129", "solution": "def minPath(grid, k):\n    \"\"\"\n    Finds the minimum path of length k in the grid.\n    A path is lexicographically minimum if, at each step, the neighbor with the smallest value is chosen.\n    \"\"\"\n    N = len(grid)\n\n    class Cell:\n        \"\"\"Represents a single cell in the grid with its coordinates and value.\"\"\"\n        def __init__(self, r, c, val):\n            self.row = r\n            self.col = c\n            self.value = val\n\n        def neighbors_coords(self, max_row, max_col):\n            \"\"\"Returns a list of valid orthogonal neighbor coordinates in a deterministic order (Up, Left, Right, Down).\"\"\"\n            deltas = [(-1, 0), (0, -1), (0, 1), (1, 0)]  # Up, Left, Right, Down\n            coords = []\n            for dr, dc in deltas:\n                r, c = self.row + dr, self.col + dc\n                if 0 <= r < max_row and 0 <= c < max_col:\n                    coords.append((r, c))\n            return coords\n\n    class Grid:\n        \"\"\"Encapsulates the grid data, providing quick lookup for cells and neighbors.\"\"\"\n        def __init__(self, matrix):\n            self.size = len(matrix)\n            self.cells = {}  # Map (row, col) -> Cell object\n            self.value_map = {}  # Map value -> (row, col)\n\n            for r_idx in range(self.size):\n                for c_idx in range(self.size):\n                    val = matrix[r_idx][c_idx]\n                    cell = Cell(r_idx, c_idx, val)\n                    self.cells[(r_idx, c_idx)] = cell\n                    self.value_map[val] = (r_idx, c_idx)\n\n        def get_cell_by_value(self, value):\n            \"\"\"Retrieves a Cell object by its value.\"\"\"\n            r, c = self.value_map[value]\n            return self.cells[(r, c)]\n\n        def get_cell(self, r, c):\n            \"\"\"Retrieves a Cell object by its coordinates.\"\"\"\n            return self.cells.get((r, c))\n\n        def neighbor_cells(self, cell):\n            \"\"\"Returns a list of neighbor Cell objects for a given cell, in deterministic order.\"\"\"\n            neighbor_coords = cell.neighbors_coords(self.size, self.size)\n            neighbor_list = []\n            for r, c in neighbor_coords:\n                neighbor_list.append(self.get_cell(r, c))\n            return neighbor_list\n\n    # Initialize the Grid object from the input matrix\n    grid_obj = Grid(grid)\n\n    # Start the path from the cell containing value 1 (guaranteed to exist)\n    start_cell = grid_obj.get_cell_by_value(1)\n\n    path_values = []\n    current_cell = start_cell\n\n    # Construct the path of length k\n    for _ in range(k):\n        path_values.append(current_cell.value)\n\n        # If the path has reached length k, stop\n        if _ == k - 1:\n            break\n\n        # Find the next cell by selecting the neighbor with the minimum value\n        neighbors = grid_obj.neighbor_cells(current_cell)\n        \n        # This condition handles cases where a cell might not have neighbors,\n        # though it's not expected for N>=2 grids before k steps.\n        if not neighbors:\n            break \n\n        # Choose the neighbor with the minimum value. `min` handles ties deterministically\n        # based on the order returned by `neighbor_cells` (Up, Left, Right, Down).\n        current_cell = min(neighbors, key=lambda c: c.value)\n\n    return path_values", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/129", "solution": "import collections\nclass MinPathError(Exception):\n    \"\"\"Base exception for minpath_app errors.\"\"\"\n    pass\nclass InvalidInputError(MinPathError):\n    \"\"\"Raised for invalid input parameters.\"\"\"\n    pass\nclass PathNotFoundError(MinPathError):\n    \"\"\"Raised if a path cannot be found (should not happen with valid inputs).\"\"\"\n    pass\nclass Cell:\n    \"\"\"Represents a single cell in the grid with its coordinates and value.\"\"\"\n    def __init__(self, row: int, col: int, value: int) -> None:\n        self.row = row\n        self.col = col\n        self.value = value\n\n    def __repr__(self) -> str:\n        return f\"Cell(r={self.row},c={self.col},v={self.value})\"\n\n    def __eq__(self, other):\n        if not isinstance(other, Cell):\n            return NotImplemented\n        return self.row == other.row and self.col == other.col\n\n    def __hash__(self):\n        return hash((self.row, self.col))\nclass Grid:\n    \"\"\"Encapsulates the N x N grid and provides utility methods.\"\"\"\n    def __init__(self, matrix: list[list[int]]) -> None:\n        if not matrix or not isinstance(matrix, list) or not all(isinstance(row, list) for row in matrix):\n            raise InvalidInputError(\"Grid must be a list of lists.\")\n        \n        self.n = len(matrix)\n        if self.n < 2:\n            raise InvalidInputError(\"Grid dimension N must be at least 2.\")\n        \n        self.cells: list[list[Cell]] = []\n        self.value_to_cell: dict[int, Cell] = {}\n        \n        seen_values = set()\n        expected_total_values = self.n * self.n\n\n        for r_idx, row_list in enumerate(matrix):\n            if len(row_list) != self.n:\n                raise InvalidInputError(\"Grid must be square (N x N).\")\n            \n            current_row_cells = []\n            for c_idx, value in enumerate(row_list):\n                if not isinstance(value, int):\n                    raise InvalidInputError(\"Grid values must be integers.\")\n                if not (1 <= value <= expected_total_values):\n                    raise InvalidInputError(f\"Grid value {value} out of range [1, {expected_total_values}].\")\n                if value in seen_values:\n                    raise InvalidInputError(f\"Duplicate value {value} found in grid.\")\n                \n                cell = Cell(r_idx, c_idx, value)\n                current_row_cells.append(cell)\n                self.value_to_cell[value] = cell\n                seen_values.add(value)\n            self.cells.append(current_row_cells)\n        \n        if len(seen_values) != expected_total_values:\n            raise InvalidInputError(f\"Grid must contain all integers from 1 to {expected_total_values} exactly once.\")\n\n    def get_cell(self, row: int, col: int) -> Cell:\n        \"\"\"Returns the Cell object at specified coordinates.\"\"\"\n        return self.cells[row][col]\n\n    def neighbors(self, cell: Cell) -> list[Cell]:\n        \"\"\"Returns a list of valid 4-neighbor Cell objects for the given cell.\"\"\"\n        neighbor_list = []\n        directions = [(-1, 0), (1, 0), (0, -1), (0, 1)] # Up, Down, Left, Right\n        \n        for dr, dc in directions:\n            nr, nc = cell.row + dr, cell.col + dc\n            if 0 <= nr < self.n and 0 <= nc < self.n:\n                neighbor_list.append(self.cells[nr][nc])\n        return neighbor_list\nclass Path:\n    \"\"\"Represents an ordered sequence of cells forming a path.\"\"\"\n    def __init__(self, cells: list[Cell] = None) -> None:\n        self.cells = list(cells) if cells else []\n\n    def values(self) -> list[int]:\n        \"\"\"Returns the ordered list of integer values in the path.\"\"\"\n        return [cell.value for cell in self.cells]\n\n    def append(self, cell: Cell) -> None:\n        \"\"\"Appends a cell to the end of the path.\"\"\"\n        self.cells.append(cell)\n\n    def copy(self) -> 'Path':\n        \"\"\"Returns a shallow copy of the path.\"\"\"\n        return Path(list(self.cells))\ndef _lex_compare(a: list[int], b: list[int]) -> int:\n    \"\"\"Compares two lists lexicographically, returning -1 if a < b, 0 if a == b, 1 if a > b.\"\"\"\n    if a < b:\n        return -1\n    if a > b:\n        return 1\n    return 0\nclass PathFinderService:\n    \"\"\"Service to compute the lexicographically minimal path of length k.\"\"\"\n    def __init__(self, grid: Grid) -> None:\n        self.grid = grid\n\n    def find_min_path(self, k: int) -> Path:\n        \"\"\"\n        Finds the lexicographically minimal path of length k.\n        Uses dynamic programming with back-pointers for path reconstruction.\n        \"\"\"\n        if not isinstance(k, int) or k < 1:\n            raise InvalidInputError(\"Path length k must be a positive integer.\")\n\n        N = self.grid.n\n        \n        # dp_table[length_idx] is a dict: Cell -> (path_values_list, predecessor_cell)\n        # length_idx=0 for path length 1, length_idx=k-1 for length k.\n        dp_table: list[dict[Cell, tuple[list[int], Cell | None]]] = [{} for _ in range(k)]\n\n        # Placeholder for \"infinity\" path for comparison. Max possible value + 1.\n        infinity_value = N * N + 1\n        infinity_path = [infinity_value] * k \n\n        # Initialize for paths of length 1 (length_idx = 0)\n        for r in range(N):\n            for c in range(N):\n                cell = self.grid.get_cell(r, c)\n                dp_table[0][cell] = ([cell.value], None)\n\n        # Iterate for lengths from 2 to k\n        for t_idx in range(1, k): # t_idx corresponds to path length (t_idx + 1)\n            # Iterate through all possible ending cells for paths of current length\n            for current_cell in self.grid.value_to_cell.values():\n                best_path_values_for_cell = infinity_path\n                best_predecessor_for_cell: Cell | None = None\n                \n                # Consider all neighbors as potential previous cells for a path of length (t_idx)\n                for prev_cell_candidate in self.grid.neighbors(current_cell):\n                    # Check if there is a valid path of length (t_idx) ending at prev_cell_candidate\n                    if prev_cell_candidate in dp_table[t_idx - 1]:\n                        prev_path_values, _ = dp_table[t_idx - 1][prev_cell_candidate]\n                        \n                        # Form the candidate path by appending current_cell's value\n                        candidate_path_values = prev_path_values + [current_cell.value]\n                        \n                        # Compare lexicographically\n                        if _lex_compare(candidate_path_values, best_path_values_for_cell) == -1:\n                            best_path_values_for_cell = candidate_path_values\n                            best_predecessor_for_cell = prev_cell_candidate\n                \n                # If a valid path ending at current_cell was found for this length\n                if best_predecessor_for_cell is not None:\n                    dp_table[t_idx][current_cell] = (best_path_values_for_cell, best_predecessor_for_cell)\n\n        # After filling dp_table, find the overall lexicographically smallest path of length k\n        final_best_path_values = infinity_path\n        final_best_end_cell: Cell | None = None\n\n        for cell in self.grid.value_to_cell.values():\n            # Check if a path of length k (at t_idx = k-1) exists for this cell\n            if cell in dp_table[k-1]:\n                path_values, _ = dp_table[k-1][cell]\n                if _lex_compare(path_values, final_best_path_values) == -1:\n                    final_best_path_values = path_values\n                    final_best_end_cell = cell\n\n        if final_best_end_cell is None:\n            raise PathNotFoundError(f\"Could not find a path of length {k}. This indicates an issue with inputs or algorithm.\")\n\n        # Reconstruct the path using back-pointers from the final best ending cell\n        reconstructed_path_cells: list[Cell] = []\n        current_cell_in_reconstruction = final_best_end_cell\n\n        # Iterate backwards from length k-1 down to 0\n        for t_idx in range(k - 1, -1, -1):\n            if current_cell_in_reconstruction is None:\n                raise PathNotFoundError(\"Error during path reconstruction: missing predecessor.\")\n            \n            reconstructed_path_cells.append(current_cell_in_reconstruction)\n            \n            # Retrieve the predecessor that led to `current_cell_in_reconstruction` at this path length (t_idx + 1)\n            # The second element of the tuple in dp_table[t_idx] is the predecessor cell\n            _, predecessor_for_this_step = dp_table[t_idx][current_cell_in_reconstruction]\n            current_cell_in_reconstruction = predecessor_for_this_step # Move to the predecessor for the next step (shorter path)\n\n        reconstructed_path_cells.reverse() # Reverse to get the path in correct start-to-end order\n        \n        return Path(reconstructed_path_cells)\ndef minPath(grid: list[list[int]], k: int) -> list[int]:\n    \"\"\"\n    Given a grid with N rows and N columns and a positive integer k, \n    find the minimum path of length k in the grid.\n    Returns an ordered list of the values on the cells that the minimum path go through.\n    \"\"\"\n    grid_obj = Grid(grid)\n    path_finder = PathFinderService(grid_obj)\n    path = path_finder.find_min_path(k)\n    return path.values()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/132": [{"task_id": "HumanEval/132", "solution": "def is_nested(string):\n    '''\n    Create a function that takes a string as input which contains only square brackets.\n    The function should return True if and only if there is a valid subsequence of brackets \n    where at least one bracket in the subsequence is nested.\n    '''\n    stack_depth = 0\n    for ch in string:\n        if ch == '[':\n            stack_depth += 1\n        elif ch == ']':\n            if stack_depth > 0:\n                # If a closing bracket matches when stack depth is 2 or more,\n                # it signifies a nested pair in a valid subsequence.\n                if stack_depth >= 2:\n                    return True\n                stack_depth -= 1\n            # Unmatched closing brackets are ignored as per subsequence matching.\n    return False", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [["[]]]]]]][[[[[]"]], "plus_fail_tests": [["[]][[]"]]}, {"task_id": "HumanEval/132", "solution": "def is_nested(string):\n    \"\"\"\n    Checks if there is a valid subsequence of brackets where at least one bracket\n    in the subsequence is nested (maximum nesting depth >= 2).\n    \"\"\"\n    n = len(string)\n    if n < 4:  # Minimum length required for \"[[ ]]\"\n        return False\n\n    # Precompute suffix count of ']' characters: suffix_close[i] stores the count of ']'\n    # characters from index i to the end of the string.\n    suffix_close = [0] * (n + 1)\n    for i in range(n - 1, -1, -1):\n        suffix_close[i] = suffix_close[i + 1] + (1 if string[i] == ']' else 0)\n\n    # Iterate to find two '[' characters followed by at least two ']' characters.\n    # first_open_bracket_idx tracks the index of the first '[' encountered.\n    first_open_bracket_idx = -1\n    for idx, char in enumerate(string):\n        if char == '[':\n            if first_open_bracket_idx == -1:\n                # This is the first '[' we've found\n                first_open_bracket_idx = idx\n            else:\n                # This is the second or subsequent '['. We have at least two '['.\n                # Check if there are at least two ']' characters strictly after this current '['.\n                if suffix_close[idx + 1] >= 2:\n                    return True\n                # If not, the current '[' becomes the new potential 'first_open_bracket_idx'\n                # for finding a subsequent pair.\n                first_open_bracket_idx = idx\n    return False", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [["[][][]"]]}], "HumanEval/133": [{"task_id": "HumanEval/133", "solution": "import math\ndef sum_squares(lst):\n    \"\"\"Calculates the sum of squares of numbers in a list after rounding each to its ceiling.\n    \"\"\"\n    total = 0\n    for num in lst:\n        ceiled_num = math.ceil(num)\n        total += ceiled_num * ceiled_num\n    return total", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/133", "solution": "import math\ndef sum_squares(lst):\n    \"\"\"\n    Calculates the sum of squared numbers after rounding each element up to the nearest integer.\n    \"\"\"\n    total_sum = 0\n    for num in lst:\n        rounded_num = int(math.ceil(num))\n        total_sum += rounded_num * rounded_num\n    return total_sum", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/134": [{"task_id": "HumanEval/134", "solution": "def check_if_last_char_is_a_letter(txt):\n    \"\"\"\n    Checks if the last character of a string is a standalone alphabetical letter.\n    It returns True if the string does not end with a space, and the last\n    space-separated token is a single alphabetical character.\n    \"\"\"\n    if not txt:\n        return False\n\n    # If the string ends with a space, it's considered not to have a letter as the last \"character\" of a word.\n    if txt.endswith(' '):\n        return False\n\n    # Split the string by spaces to get tokens (words).\n    # Filter out any empty strings that result from multiple spaces.\n    tokens = [t for t in txt.split(' ') if t]\n\n    # If there are no tokens after splitting (e.g., input was \"   a\" and then trimmed, but it's handled)\n    # This case should ideally not be hit if `txt` is not empty and not entirely spaces, and `endswith(' ')` is false.\n    if not tokens:\n        return False\n\n    last_token = tokens[-1]\n\n    # Check if the last token is a single alphabetical character.\n    return len(last_token) == 1 and last_token.isalpha()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/134", "solution": "def check_if_last_char_is_a_letter(txt):\n    \"\"\"\n    Checks if the last character of a string is an alphabetical character and is not\n    part of a