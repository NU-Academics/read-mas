val/158", "solution": "def find_max(words):\n    \"\"\"Returns the word with the maximum number of unique characters.\n    If multiple words tie, the lexicographically smallest is returned.\n    \"\"\"\n    if not words:\n        return \"\"\n\n    # Compute unique character count for each word and store as (count, word) tuples.\n    # This inlines the logic from StringUtils.unique_char_count and WordMetric.\n    metrics = []\n    for word in words:\n        unique_char_count = len(set(word))\n        metrics.append((unique_char_count, word))\n\n    # Find the maximum unique character count among all words.\n    max_count = -1\n    if metrics:\n        max_count = max(item[0] for item in metrics)\n\n    # Collect all words that have this maximum unique character count.\n    # These are the candidates for lexicographical tie-breaking.\n    candidates = [word for count, word in metrics if count == max_count]\n\n    # Return the lexicographically smallest word among the candidates.\n    return min(candidates)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/159": [{"task_id": "HumanEval/159", "solution": "def eat(number, need, remaining):\n    \"\"\"\n    Calculates the total eaten carrots and remaining stock after a meal.\n    The rabbit eats the minimum of what it needs and what is available.\n    \"\"\"\n    carrots_eaten_in_this_meal = min(need, remaining)\n    total_eaten_carrots = number + carrots_eaten_in_this_meal\n    carrots_left_in_stock = remaining - carrots_eaten_in_this_meal\n    \n    return [total_eaten_carrots, carrots_left_in_stock]", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/159", "solution": "def eat(number, need, remaining):\n    \"\"\"\n    Calculates the total carrots eaten and remaining after a meal.\n    Applies rules based on whether enough carrots are available.\n    \"\"\"\n    \n    if remaining >= need:\n     