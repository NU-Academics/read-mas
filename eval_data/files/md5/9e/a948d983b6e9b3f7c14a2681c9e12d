ive', 6: 'six', 7: 'seven', 8: 'eight', 9: 'nine'\n    }\n\n    normalized_input = \" \".join(numbers.strip().lower().split())\n    tokens = normalized_input.split()\n\n    if not tokens:\n        return \"\"\n\n    numeric_values = [word_to_value[token] for token in tokens]\n    numeric_values.sort()\n\n    sorted_words = [value_to_word[value] for value in numeric_values]\n    return \" \".join(sorted_words)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/19", "solution": "from typing import List, Dict, Optional\nWORD_TO_INT: Dict[str, int] = {\n    \"zero\": 0, \"one\": 1, \"two\": 2, \"three\": 3, \"four\": 4,\n    \"five\": 5, \"six\": 6, \"seven\": 7, \"eight\": 8, \"nine\": 9,\n}\nclass InvalidTokenError(ValueError):\n    def __init__(self, invalid_tokens: List[str], message: Optional[str] = None) -> None:\n        super().__init__(message or f\"Invalid tokens: {invalid_tokens}\")\n        self.invalid_tokens = invalid_tokens\nclass EmptyInputError(ValueError):\n    def __init__(self, message: Optional[str] = None) -> None:\n        super().__init__(message or \"No tokens provided\")\nclass NumberToken:\n    def __init__(self, text: str, value: int, original_index: int) -> None:\n        self.text = text\n        self.value = value\n        self.original_index = original_index\n    def __repr__(self) -> str:\n        return f\"NumberToken({self.text!r},{self.value},{self.original_index})\"\nclass NumberParser:\n    def __init__(self, word_to_int: Dict[str, int] = None) -> None:\n        self.word_to_int = word_to_int or WORD_TO_INT\n\n    def parse(self, numbers: str) -> List[NumberToken]:\n        if not numbers or not numbers.strip():\n            raise EmptyInputError()\n        tokens = numbers.strip().split()\n        normalized = [t.lower() for t in tokens]\n        invalid = [t for t in normalized if t not in self.word_to_int]\n        if invalid:\n            raise InvalidTokenError(invalid)\n        return [NumberToken(text=t, value=self.word_to_int[t], original_index=i) for i, t in enumerate(normalized)]\nclass NumberSorter:\n    def sort(self, tokens: List[NumberToken]) -> List[NumberToken]:\n        # Stable sort by numeric value, preserving original order for ties\n        return sorted(tokens, key=lambda t: (t.value, t.original_index))\nclass NumberFormatter:\n    def format(self, tokens: List[NumberToken]) -> str:\n        return \" \".join(t.text for t in tokens).strip()\nclass SortNumbersService:\n    def __init__(self, parser: NumberParser = None, sorter: NumberSorter = None,\n                 formatter: NumberFormatter = None) -> None:\n        self.parser = parser or NumberParser()\n        self.sorter = sorter or NumberSorter()\n        self.formatter = formatter or NumberFormatter()\n\n    def sort(self, numbers: str) -> str:\n        tokens = self.parser.parse(numbers)\n        sorted_tokens = self.sorter.sort(tokens)\n        result = self.formatter.format(sorted_tokens)\n        return result\nclass Api:\n    def __init__(self, service: SortNumbersService = None) -> None:\n        self.service = service or SortNumbersService()\n\n    def sort(self, numbers: str) -> str:\n        return self.service.sort(numbers)\n_default_api = Api()\ndef sort_numbers(numbers: str) -> str:\n    \"\"\" Input is a space-delimited string of numberals from 'zero' to 'nine'.\n    Valid choices are 'zero', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight' and 'nine'.\n    Return the string with numbers sorted from smallest to largest\n    >>> sort_numbers('three one five')\n    'one three five'\n    \"\"\"\n    return _default_api.sort(numbers)", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[""]], "plus_fail_tests": [[""]]}], "HumanEval/22": [{"task_id": "HumanEval/22", "solution": "from typing import List, Any\ndef filter_integers(values: List[Any]) -> List[int]:\n    \"\"\" Filter given list of any python values only for integers\n    >>> filter_integers(['a', 3.14, 5])\n    [5]\n    >>> filter_integers([1, 2, 3, 'abc', {}, []])\n    [1, 2, 3]\n    \"\"\"\n\n    class TypeValidator:\n        def __init__(self) -> None:\n            pass\n\n        def is_integer(self, value: Any) -> bool:\n            # Exclude bool which is subclass of int.\n            return type(value) is int\n\n    class FilterService:\n        def __init__(self, validator: TypeValidator) -> None:\n            self._validator = validator\n\n        def filter(self, values: List[Any]) -> List[int]:\n            result: List[int] = []\n            for v in values:\n                if self._validator.is_integer(v):\n                    result.append(v)\n            return result\n\n    _default_service = FilterService(TypeValidator())\n    return _default_service.filter(values)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/22", "solution": "class TypeValidator:\n    \"\"\"Encapsulates logic to determine if a value is an integer, excluding booleans.\"\"\"\n    def is_int(self, value: Any) -> bool:\n        return isinstance(value, int) and not isinstance(value, bool)\nclass IntegerFilter:\n    \"\"\"Service that filters integer values from a list using a validator.\"\"\"\n    def __init__(self, validator: TypeValidator) -> None:\n        self._validator = validator\n\n    def filter(self, values: List[Any]) -> List[int]:\n        \"\"\"Returns a list of integers from the given values.\"\"\"\n        return [v for v in values if self._validator.is_int(v)]\ndef filter_integers(values: List[Any]) -> List[int]:\n    \"\"\" Filter given list of any python values only for integers\n    >>> filter_integers(['a', 3.14, 5])\n    [5]\n    >>> filter_integers([1, 2, 3, 'abc', {}, []])\n    [1, 2, 3]\n    \"\"\"\n    validator = TypeValidator()\n    service = IntegerFilter(validator)\n    return service.filter(values)", "base_status": "fail", "plus_