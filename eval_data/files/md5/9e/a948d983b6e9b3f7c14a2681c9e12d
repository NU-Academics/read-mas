ased on their original index.\n    \"\"\"\n\n    def _calculate_digit_sum(n):\n        \"\"\"Calculates the sum of the absolute value of digits for an integer.\"\"\"\n        return sum(int(digit) for digit in str(abs(n)))\n\n    # Create a list of (digit_sum, original_index, value) tuples\n    # Python's sort is stable, and tuple comparison works lexicographically\n    decorated_nums = [\n        (_calculate_digit_sum(num), index, num)\n        for index, num in enumerate(nums)\n    ]\n\n    # Sort the list based on the digit_sum and then original_index\n    decorated_nums.sort()\n\n    # Extract the original numbers from the sorted list\n    return [num for _, _, num in decorated_nums]", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[[1, 11, -1, -11, -12]]], "plus_fail_tests": [[[-5, -12, 9, 15]]]}, {"task_id": "HumanEval/145", "solution": "def order_by_points(nums):\n    \"\"\"\n    Sorts the given list of integers in ascending order according to the sum of their digits.\n    If sums are equal, original relative index determines order.\n    \"\"\"\n\n    def _compute_digit_sum(n):\n        \"\"\"Calculates the sum of digits for the absolute value of an integer.\"\"\"\n        return sum(int(digit) for digit in str(abs(n)))\n\n    # Create a list of tuples: (digit_sum, original_index, original_value)\n    # This allows sorting by digit_sum first, then by original_index for stability.\n    decorated_list = []\n    for i, num in enumerate(nums):\n        digit_sum = _compute_digit_sum(num)\n        decorated_list.append((digit_sum, i, num))\n\n    # Sort the decorated list. Python's `sort` is stable, and tuple comparison\n    # naturally sorts by the first element, then the second, and so on.\n    decorated_list.sort()\n\n    # Extract the original values from the sorted list\n    return [item[2] for item in decorated_list]", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[[1, 11, -1, -11, -12]]], "plus_fail_tests": [[[-5, -12,