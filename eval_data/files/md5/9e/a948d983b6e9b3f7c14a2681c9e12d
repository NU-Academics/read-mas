nput data.\"))\n            \n        return mangoes\nclass FruitController:\n    \"\"\"Orchestrates parsing and computation for fruit distribution.\"\"\"\n    def __init__(self) -> None:\n        self._parser = FruitParser()\n        self._service = DistributionService()\n\n    def fruit_distribution(self, s: str, n: int) -> int:\n        \"\"\"Parses fruit string and computes mango count.\"\"\"\n        counts = self._parser.parse(s)\n        return self._service.compute_mangoes(n, counts)\ndef fruit_distribution(s,n):\n    \"\"\"\n    In this task, you will be given a string that represents a number of apples and oranges \n    that are distributed in a basket of fruit this basket contains \n    apples, oranges, and mango fruits. Given the string that represents the total number of \n    the oranges and apples and an integer that represent the total number of the fruits \n    in the basket return the number of the mango fruits in the basket.\n    for examble:\n    fruit_distribution(\"5 apples and 6 oranges\", 19) ->19 - 5 - 6 = 8\n    fruit_distribution(\"0 apples and 1 oranges\",3) -> 3 - 0 - 1 = 2\n    fruit_distribution(\"2 apples and 3 oranges\", 100) -> 100 - 2 - 3 = 95\n    fruit_distribution(\"100 apples and 1 oranges\",120) -> 120 - 100 - 1 = 19\n    \"\"\"\n    controller = FruitController()\n    return controller.fruit_distribution(s, n)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/69": [{"task_id": "HumanEval/69", "solution": "import collections\nfrom typing import List, Dict\nclass FrequencyRepository:\n    \"\"\"Computes a frequency map for a given list of integers.\"\"\"\n    def get_frequencies(self, lst: List[int]) -> Dict[int, int]:\n        return dict(collections.Counter(lst))\nclass CounterUtil:\n    \"\"\"Selects the greatest integer satisfying the frequency condition.\"\"\"\n    def select_greatest_valid(self, freq_map: Dict[int, int]) -> int:\n        candidate = -1\n        for 