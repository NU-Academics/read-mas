s always less than end_idx for correct slicing\n    start_idx, end_idx = sorted((idx1, idx2))\n\n    # Slice the list to get planets strictly between the two\n    return tuple(CANONICAL_PLANETS[start_idx + 1:end_idx])", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/148", "solution": "def bf(planet1, planet2):\n    \"\"\"\n    Returns a tuple of planets located between planet1 and planet2, sorted by proximity to the sun.\n    Returns an empty tuple if either planet name is invalid or no planets are in between.\n    \"\"\"\n    PLANETS = (\"Mercury\", \"Venus\", \"Earth\", \"Mars\", \"Jupiter\", \"Saturn\", \"Uranus\", \"Neptune\")\n\n    def normalize_name(name: str) -> str:\n        \"\"\"Trims whitespace and capitalizes the first letter of the planet name.\"\"\"\n        return name.strip().capitalize()\n\n    normalized_planet1 = normalize_name(planet1)\n    normalized_planet2 = normalize_name(planet2)\n\n    if normalized_planet1 not in PLANETS or normalized_planet2 not in PLANETS:\n        return ()\n\n    index1 = PLANETS.index(normalized_planet1)\n    index2 = PLANETS.index(normalized_planet2)\n\n    # Determine the lower and upper bounds for slicing\n    low = min(index1, index2)\n    high = max(index1, index2)\n\n    # Extract planets between the two indices (exclusive of low and high)\n    result_planets = PLANETS[low + 1 : high]\n\n    return tuple(result_planets)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/149": [{"task_id": "HumanEval/149", "solution": "def sorted_list_sum(lst):\n    \"\"\"\n    Deletes strings with odd lengths from the list and returns the remaining\n    strings sorted by length (ascending) and then alphabetically.\n    \"\"\"\n    # Filter out strings with odd lengths\n    even_length_strings = [s for s in lst if len(s) % 2 == 0]\n\n    # Sort the filtered list by length, then alphabetically\n    # The tu