g., 3 or 3.0, but not 3.6).\"\"\"\n    return math.isfinite(x) and x == int(x)\nclass NumbersDTO:\n    def __init__(self, a: int, b: int, c: int) -> None:\n        self.a = a\n        self.b = b\n        self.c = c\n\n    def as_tuple(self) -> tuple[int, int, int]:\n        \"\"\"Returns the numbers as an immutable tuple.\"\"\"\n        return (self.a, self.b, self.c)\nclass InvalidInputError(Exception):\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\nclass AnyIntValidator:\n    def is_integer_like(self, x: float | int) -> bool:\n        \"\"\"Helper to check if a number is integer-like by delegating.\"\"\"\n        return is_integer_like(x)\n\n    def validate_and_cast(self, a: float | int, b: float | int, c: float | int) -> NumbersDTO:\n        \"\"\"Validates inputs are numeric and integer-like, then casts to int for a DTO.\"\"\"\n        for name, val in ((\"a\", a), (\"b\", b), (\"c\", c)):\n            if not isinstance(val, (int, float)):\n                raise InvalidInputError(f\"{name} is not numeric: {val!r}\")\n            if not self.is_integer_like(val):\n                raise InvalidInputError(f\"{name} is not integer-like: {val!r}\")\n        return NumbersDTO(int(a), int(b), int(c))\nclass AnyIntService:\n    def evaluate(self, nums: NumbersDTO) -> bool:\n        \"\"\"Checks if one of the numbers equals the sum of the other two.\"\"\"\n        a, b, c = nums.as_tuple()\n        return (a == b + c) or (b == a + c) or (c == a + b)\nclass AnyIntController:\n    def __init__(self, validator: AnyIntValidator, service: AnyIntService) -> None:\n        self._validator = validator\n        self._service = service\n\n    def compute(self, a: float | int, b: float | int, c: float | int, strict: bool = False) -> bool:\n        \"\"\"Orchestrates validation and core logic, handling strict mode for errors.\"\"\"\n        try:\n            nums = self._validator.validate_and_cast(a, b, c)\n      