           return NumberValue(value, 'int', float(value))\n        if isinstance(value, float):\n            if value != value: # Check for NaN for float inputs\n                raise ParseError(\"NaN not allowed\")\n            return NumberValue(value, 'float', float(value))\n        if isinstance(value, str):\n            s = normalize_decimal_str(value)\n            if not looks_like_float(s):\n                raise ParseError(f\"Invalid numeric string: {value!r}\")\n            numeric = float(s)\n            return NumberValue(value, 'str', numeric)\n        raise ParseError(f\"Unsupported type: {type(value).__name__}\")\nclass CompareService:\n    \"\"\"Provides the core comparison logic using NumberParser and NumberValue.\"\"\"\n    def __init__(self, parser=None):\n        self.parser = parser or NumberParser()\n\n    def compare(self, a, b):\n        na = self.parser.parse(a)\n        nb = self.parser.parse(b)\n        cmp = na.compare_to(nb)\n        if cmp == 0:\n            return None\n        return na.raw if cmp > 0 else nb.raw\n_default_service = CompareService()\ndef compare_one(a, b):\n    \"\"\"\n    Compares two numbers (int, float, or string representations) and returns the larger value, preserving its original type.\n    Returns None if values are equal.\n    \"\"\"\n    return _default_service.compare(a, b)", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [["1,45", "1,"]]}, {"task_id": "HumanEval/137", "solution": "import decimal\ndef compare_one(a, b):\n    \"\"\"\n    Create a function that takes integers, floats, or strings representing\n    real numbers, and returns the larger variable in its given variable type.\n    Return None if the values are equal.\n    \"\"\"\n\n    class ComparisonError(Exception):\n        \"\"\"Custom exception for comparison and parsing errors.\"\"\"\n        pass\n\n    class ValueWrapper:\n        \"\"\"Encapsulates an input value and its canonical numeric representation.\"\"\"\n        def __init__(self, original, numeric, is_string):\n            self.original = original\n            self.numeric = numeric\n            self.is_string = is_string\n\n    class ValueParser:\n        \"\"\"Parses allowed input types into ValueWrapper.\"\"\"\n        DECIMAL_SEPARATORS = ('.', ',')\n\n        def _str_to_decimal(self, s: str) -> decimal.Decimal:\n            s_stripped = s.strip()\n            num_dots = s_stripped.count('.')\n            num_commas = s_stripped.count(',')\n\n            if num_dots > 1 or num_commas > 1 or (num_dots == 1 and num_commas == 1):\n                raise ComparisonError(f\"Ambiguous or multiple decimal separators: {s}\")\n\n            if num_commas == 1:\n                s_normalized = s_stripped.replace(',', '.')\n            else:\n                s_normalized = s_stripped\n            \n            try:\n                return decimal.Decimal(s_normalized)\n            except decimal.InvalidOperation as e:\n                raise ComparisonError(f\"Cannot parse string as number: {s}\") from e\n\n        def parse(self, value):\n            if isinstance(value, int):\n                return ValueWrapper(value, decimal.Decimal(value), False)\n            elif isinstance(value, float):\n                # Convert float to string first for precise Decimal conversion\n                return ValueWrapper(value, decimal.Decimal(str(value)), False)\n            elif isinstance(value, str):\n                d = self._str_to_decimal(value)\n                return ValueWrapper(value, d, True)\n            else:\n                raise ComparisonError(f\"Unsupported type: {type(value).__name__}\")\n\n    class ComparatorService:\n        \"\"\"Compares two inputs using ValueParser and returns the original larger value or None.\"\"\"\n        def __init__(self, parser=None):\n            self._parser = parser or ValueParser()\n\n        def compare(self, a, b):\n            left = self._parser.parse(a)\n            right = self._parser.parse(b)\n\n            if left.numeric == right.numeric:\n                return None\n            return left.original if left.numeric > right.numeric else right.original\n\n    class CompareController:\n        \"\"\"High-level controller that exposes the comparison routine.\"\"\"\n        def __init__(self, service=None):\n            self._service = service or ComparatorService()\n\n        def compare(self, a, b):\n            return self._service.compare(a, b)\n\n    controller = CompareController()\n    return controller.compare(a, b)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/140": [{"task_id": "HumanEval/140", "solution": "def fix_spaces(text):\n    \"\"\"\n    Transforms the input string by replacing spaces according to specific rules.\n    Consecutive spaces (1 or 2) become underscores; more than 2 consecutive spaces become a single hyphen.\n    \"\"\"\n    out_chars = []\n    i = 0\n    n = len(text)\n    while i < n:\n        if text[i] == \" \":\n            j = i\n            while j < n and text[j] == \" \":\n                j += 1\n            run_length = j - i\n            if run_length <= 2:\n                out_chars.append(\"_\" * run_length)\n            else:\n                out_chars.append(\"-\")\n            i = j\n        else:\n            out_chars.append(text[i])\n            i += 1\n    return \"\".join(out_chars)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/140", "solution": "import re\ndef fix_spaces(text):\n    \"\"\"\n    Replaces spaces in text: 1-2 consecutive spaces become underscores, \n    3+ consecutive spaces become a single hyphen.\n    \"\"\"\n    space_run_regex = re.compile(r'( )+')\n\n    def replacer(match):\n        run = match.group(0)\n        if len(run) >= 3:\n            return '-'\n        return '_' * len(run)\n        \n    return space_run_regex.sub(r