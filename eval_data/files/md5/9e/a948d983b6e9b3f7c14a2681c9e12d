> 0 and c > 0):\n        return -1\n\n    # Triangle inequality: sum of any two sides must be strictly greater than the third\n    if not (a + b > c and a + c > b and b + c > a):\n        return -1\n\n    # Calculate semi-perimeter\n    s = (a + b + c) / 2.0\n\n    # Calculate area using Heron's formula\n    area_sq = s * (s - a) * (s - b) * (s - c)\n    \n    # Handle potential floating point inaccuracies where area_sq might be slightly negative\n    if area_sq < 0 and abs(area_sq) < 1e-12:\n        area_sq = 0.0\n    elif area_sq < 0: # Significantly negative, means an invalid triangle\n        return -1\n\n    area = math.sqrt(area_sq)\n\n    # Round the area to 2 decimal places\n    return round(area, 2)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/71", "solution": "import math\ndef triangle_area(a, b, c):\n    # Validate inputs and check if the sides form a valid triangle.\n    try:\n        fa, fb, fc = float(a), float(b), float(c)\n    except (TypeError, ValueError):\n        return -1.0\n\n    if not (fa > 0 and fb > 0 and fc > 0 and \\\n            fa + fb > fc and fa + fc > fb and fb + fc > fa):\n        return -1.0\n\n    # Calculate the area using Heron's formula, handling potential floating point inaccuracies.\n    s = (fa + fb + fc) / 2.0\n    product = s * (s - fa) * (s - fb) * (s - fc)\n    \n    try:\n        area = math.sqrt(max(0.0, product))\n    except ValueError: # math.sqrt raises ValueError for negative input.\n        return -1.0\n\n    return round(area, 2)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/73": [{"task_id": "HumanEval/73", "solution": "def smallest_change(arr):\n    \"\"\"\n    Calculates the minimum number of elements to change to make the array palindromic.\n    This is achieved by counting mismatched elements in symmetric pairs.\n    \"\"\"\n    n = len(arr)\n    mismatches = 0\n    for i in r