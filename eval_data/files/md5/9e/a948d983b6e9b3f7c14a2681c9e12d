s+\", \" \", text)\n            # Remove leading/trailing whitespace\n            return text.strip()\n\n    class SentenceSplitter:\n        # Regex to find sentence delimiters (., ?, !) and capture them\n        _DELIM_PATTERN = re.compile(r'([.!?])')\n\n        def split(self, text: str) -> list[Sentence]:\n            sentences = []\n            last_split_idx = 0\n\n            # Find all delimiters and extract sentences\n            for m in self._DELIM_PATTERN.finditer(text):\n                # The segment includes the delimiter itself\n                segment_raw = text[last_split_idx : m.end()]\n                segment_normalized = segment_raw.strip()\n\n                if segment_normalized: # Only add if it's not just whitespace\n                    sentences.append(Sentence(\n                        raw_text=segment_raw,\n                        normalized_text=segment_normalized,\n                        start_index=last_split_idx\n                    ))\n                last_split_idx = m.end()\n\n            # Handle any remaining text after the last delimiter (or if no delimiters were found)\n            trailing_raw = text[last_split_idx:]\n            trailing_normalized = trailing_raw.strip()\n            if trailing_normalized:\n                sentences.append(Sentence(\n                    raw_text=trailing_raw,\n                    normalized_text=trailing_normalized,\n                    start_index=last_split_idx\n                ))\n            \n            return sentences\n\n    class BoredomAnalyzer:\n        def count_boredoms(self, sentences: list[Sentence], accept_lowercase: bool = False) -> int:\n            count = 0\n            for s in sentences:\n                if self.sentence_starts_with_I(s, accept_lowercase=accept_lowercase):\n                    count += 1\n            return count\n\n        def sentence_starts_with_I(self, sentence: Sentence, accept_lowercase: bool = False) -> bool:\n            token = sentence.first_t