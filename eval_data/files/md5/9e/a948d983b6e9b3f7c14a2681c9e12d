(n: int) -> List[int]:\n    \"\"\" Return list of prime factors of given integer in the order from smallest to largest.\n    Each of the factors should be listed number of times corresponding to how many times it appeares in factorization.\n    Input number should be equal to the product of all factors\n    >>> factorize(8)\n    [2, 2, 2]\n    >>> factorize(25)\n    [5, 5]\n    >>> factorize(70)\n    [2, 5, 7]\n    \"\"\"\n    if n == 1:\n        return []\n\n    factors = []\n\n    # Handle factor 2\n    while n % 2 == 0:\n        factors.append(2)\n        n //= 2\n\n    # Handle odd factors starting from 3 up to sqrt(n)\n    i = 3\n    while i * i <= n:\n        while n % i == 0:\n            factors.append(i)\n            n //= i\n        i += 2\n\n    # If n is still greater than 1, it is the remaining prime factor\n    if n > 1:\n        factors.append(n)\n\n    return factors", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/25", "solution": "import math\nfrom typing import List\ndef factorize(n: int) -> List[int]:\n    \"\"\" Return list of prime factors of given integer in the order from smallest to largest.\n    Each of the factors should be listed number of times corresponding to how many times it appeares in factorization.\n    Input number should be equal to the product of all factors\n    >>> factorize(8)\n    [2, 2, 2]\n    >>> factorize(25)\n    [5, 5]\n    >>> factorize(70)\n    [2, 5, 7]\n    \"\"\"\n    if n <= 1:\n        return []\n\n    factors: List[int] = []\n\n    # Handle factor 2\n    while n % 2 == 0:\n        factors.append(2)\n        n //= 2\n\n    # Trial odd divisors starting from 3\n    f = 3\n    # Optimize by only checking up to sqrt(n)\n    # math.isqrt is used for integer square root, available in Python 3.8+\n    maxf = math.isqrt(n) + 1\n    while f <= maxf and n > 1:\n        while n % f == 0:\n            factors.append(f)\n            n //= f\n            #