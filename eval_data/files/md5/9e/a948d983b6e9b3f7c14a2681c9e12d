Iterable[Any]) -> IntegerAnalysisResult:\n        \"\"\"\n        Analyzes the given data to find the largest negative and smallest positive integers.\n        Non-integer values and zeros are ignored.\n        \"\"\"\n        repo = ListRepository(data)\n        it = repo.iter_ints()\n        return self._process_iterator(it)\n\n    def _process_iterator(self, it: Iterator[int]) -> IntegerAnalysisResult:\n        \"\"\"Internal method to process an iterator of integers.\"\"\"\n        max_neg = None\n        min_pos = None\n        for x in it:\n            if x < 0:\n                if (max_neg is None) or (x > max_neg):\n                    max_neg = x\n            elif x > 0:  # x is positive\n                if (min_pos is None) or (x < min_pos):\n                    min_pos = x\n        return IntegerAnalysisResult(max_neg, min_pos)\ndef largest_smallest_integers(lst: Iterable[Any]) -> Tuple[Optional[int], Optional[int]]:\n    \"\"\"\n    Returns a tuple (a, b), where 'a' is the largest of negative integers,\n    and 'b' is the smallest of positive integers in a list.\n    If there are no negative or positive integers, they are returned as None.\n    \"\"\"\n    svc = IntegerAnalyzerService()\n    result = svc.analyze(lst)\n    return result.to_tuple()", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[[2, 4, 1, 3, 5, 7]]], "plus_fail_tests": [[[9, -4, -6, 5, 0, -2]]]}], "HumanEval/138": [{"task_id": "HumanEval/138", "solution": "def is_equal_to_sum_even(n):\n    \"\"\"Evaluate whether the given number n can be written as the sum of exactly 4 positive even numbers.\"\"\"\n    MIN_SUM_FOR_FOUR_POSITIVE_EVENS = 8  # (2 + 2 + 2 + 2)\n    return n % 2 == 0 and n >= MIN_SUM_FOR_FOUR_POSITIVE_EVENS", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/138", "solution": "def is_equal_to_sum_even(n):\n    \"\"\"Evaluate whether the given number n can be written as the sum of exactly 4 po