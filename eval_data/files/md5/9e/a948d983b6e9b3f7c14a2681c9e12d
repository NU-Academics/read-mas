tees\n    a solution.\n    >>> round(find_zero([1, 2]), 2) # f(x) = 1 + 2x\n    -0.5\n    >>> round(find_zero([-6, 11, -6, 1]), 2) # (x - 1) * (x - 2) * (x - 3) = -6 + 11x - 6x^2 + x^3\n    1.0\n    \"\"\"\n    # Helper to get coefficients of the derivative polynomial\n    def get_derivative_coeffs(coeffs: list) -> list:\n        if len(coeffs) <= 1:\n            return [0.0]\n        return [coeffs[i] * i for i in range(1, len(coeffs))]\n\n    tolerance = 1e-10\n    max_iter = 1000\n    \n    xs_prime = get_derivative_coeffs(xs)\n\n    x_current = 0.1 # Initial guess for Newton-Raphson\n\n    for _ in range(max_iter):\n        y = poly(xs, x_current)\n        y_prime = poly(xs_prime, x_current)\n\n        if abs(y_prime) < 1e-15: # Handle very small derivative to prevent division by zero\n            x_current += 1e-6 # Perturb current guess\n            continue\n        \n        x_next = x_current - y / y_prime\n\n        if abs(x_next - x_current) <= tolerance:\n            return x_next\n        \n        x_current = x_next\n    \n    # If max_iter is reached without convergence, return the last estimate.\n    # The problem statement implies a solution is guaranteed to be found.\n    return x_current", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[[5, 10, -3, 1]]]}, {"task_id": "HumanEval/32", "solution": "import math\ndef poly(xs: list, x: float):\n    \"\"\"\n    Evaluates polynomial with coefficients xs at point x.\n    return xs[0] + xs[1] * x + xs[1] * x^2 + .... xs[n] * x^n\n    \"\"\"\n    return sum([coeff * math.pow(x, i) for i, coeff in enumerate(xs)])\ndef find_zero(xs: list):\n    \"\"\" xs are coefficients of a polynomial.\n    find_zero find x such that poly(x) = 0.\n    find_zero returns only only zero point, even if there are many.\n    Moreover, find_zero only takes list xs having even number of coefficients\n    and largest non zero coefficient as it guarantees\n    a solution.\n    >>> round(find_zero([1, 2]), 2) # f(x) = 1 + 2x\n    -0.5\n    >>> round(find_zero([-6, 11, -6, 1]), 2) # (x - 1) * (x - 2) * (x - 3) = -6 + 11x - 6x^2 + x^3\n    1.0\n    \"\"\"\n    tolerance = 1e-7\n    max_iterations = 100\n\n    # Handle linear polynomials (degree 1) exactly: c0 + c1*x = 0 => x = -c0/c1\n    if len(xs) == 2:\n        return -xs[0] / xs[1]\n\n    # For higher-degree odd polynomials (guaranteed by len(xs) being even),\n    # a real root is guaranteed. We use a bracketing search followed by bisection.\n    # The search proceeds from a negative range to a positive range to find the smallest root first.\n    search_range_start = -100.0\n    search_range_end = 100.0\n    search_steps = 100000  # Number of steps for initial bracketing scan\n\n    prev_x = search_range_start\n    prev_y = poly(xs, prev_x)\n\n    for i in range(1, search_steps + 1):\n        current_x = search_range_start + (search_range_end - search_range_start) * i / search_steps\n        current_y = poly(xs, current_x)\n\n        # Check if a root is found directly at the current sampling point\n        if math.isclose(current_y, 0.0, abs_tol=tolerance):\n            return current_x\n\n        # Check for a sign change, indicating a root is bracketed between prev_x and current_x\n        if prev_y * current_y < 0:\n            # A root is bracketed, perform bisection to refine it\n            a, b = prev_x, current_x\n            for _ in range(max_iterations):\n                mid = (a + b) / 2\n                y_mid = poly(xs, mid)\n\n                if math.isclose(y_mid, 0.0, abs_tol=tolerance):\n                    return mid\n\n                # Update the interval [a, b] based on the sign of y_mid\n                if poly(xs, a) * y_mid < 0:\n                    b = mid\n                else:\n                    a = mid\n                \n                # If the interval becomes small enough, return its midpoint as the converged root\n                if abs(b - a) < tolerance:\n                    return (a + b) / 2\n\n        prev_x, prev_y = current_x, current_y\n    \n    # As the problem guarantees a solution for valid inputs, this point should ideally not be reached.\n    # A robust solution would typically raise an error here, but is disallowed by constraints.\n    # For the given examples and common cases, a root will be found within the defined search parameters.\n    return 0.0  # Fallback return, implies a search failure for complex or out-of-range roots.", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[[5, 10, -3, 1]]]}], "HumanEval/37": [{"task_id": "HumanEval/37", "solution": "def sort_even(l: list):\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the odd indicies, while its values at the even indicies are equal\n    to the values of the even indicies of l, but sorted.\n    >>> sort_even([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_even([5, 6, 3, 4])\n    [3, 6, 5, 4]\n    \"\"\"\n    even_indexed_values = [l[i] for i in range(0, len(l), 2)]\n    sorted_even_values = sorted(even_indexed_values)\n\n    result_list = list(l) # Create a mutable copy of the original list\n    \n    even_idx_ptr = 0\n    for i in range(0, len(l), 2):\n        result_list[i] = sorted_even_values[even_idx_ptr]\n        even_idx_ptr += 1\n        \n    return result_list", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/37", "solution": "def sort_even(l: list):\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the odd indicies, while its values at the even indicies are equal\n    to the values of the even indicies of l, but sorted.\n    \"\"\"\n    if not l:\n        return []\n\n    even_indexed_values = [l[i] for i in range(0, len(l), 2)]\n    sorted_even_values = sorted(even_indexed_values)\n\n    result = [None] * len(l)\n    even_idx_counter = 0\n    