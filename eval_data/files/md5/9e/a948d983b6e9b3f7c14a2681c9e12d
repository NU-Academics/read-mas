 of the word, caching the result.\"\"\"\n            if not self._normalized:\n                self._normalized = self.text.lower()\n            return self._normalized\n\n    def _tokenize(text: str) -> list[_WordModel]:\n        \"\"\"Splits the input string into a list of _WordModel instances.\"\"\"\n        if not text:\n            return []\n        words = text.split()\n        return [_WordModel(w) for w in words]\n\n    _VOWELS = {\"a\", \"e\", \"i\", \"o\", \"u\"}\n\n    def _is_consonant(char: str) -> bool:\n        \"\"\"Checks if a character is a consonant based on the predefined vowels.\"\"\"\n        return char.isalpha() and char not in _VOWELS\n\n    def _count_consonants(word_model: _WordModel) -> int:\n        \"\"\"Counts the number of consonants in a given _WordModel.\"\"\"\n        return sum(1 for char in word_model.normalized() if _is_consonant(char))\n\n    word_models = _tokenize(s)\n    result = []\n    for word_model in word_models:\n        if _count_consonants(word_model) == n:\n            result.append(word_model.text)\n    return result", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/117", "solution": "import re\nfrom typing import List, Set\nclass Tokenizer:\n    \"\"\"Helper class to tokenize an input string into a list of words.\"\"\"\n    WORD_SEPARATOR_REGEX = r\"\\s+\"\n\n    def tokenize(self, s: str) -> List[str]:\n        \"\"\"Splits the string by whitespace and filters out empty tokens.\"\"\"\n        if not s:\n            return []\n        # Strip leading/trailing whitespace, then split by one or more spaces\n        return [tok for tok in re.split(self.WORD_SEPARATOR_REGEX, s.strip()) if tok != \"\"]\nclass ConsonantCounter:\n    \"\"\"Helper class to count consonants in a given word.\"\"\"\n    VOWELS: Set[str] = {\"a\", \"e\", \"i\", \"o\", \"u\"}\n\n    def count(self, word: str) -> int:\n        \"\"\"Counts the number of consonants in a word, treating 'y' as a consonant.\"\"\"\n        cnt = 0\n        for ch in word.lower():\n            if \"a\" <= ch <= \"z\" and ch not in self.VOWELS:\n                cnt += 1\n        return cnt\nclass WordSelectorService:\n    \"\"\"Service to select words from a string that have exactly N consonants.\"\"\"\n    def __init__(self, tokenizer: Tokenizer, counter: ConsonantCounter) -> None:\n        self._tokenizer = tokenizer\n        self._counter = counter\n\n    def select(self, s: str, n: int) -> List[str]:\n        \"\"\"Main logic to find words with exactly N consonants.\"\"\"\n        # According to instructions, for negative 'n' (an edge case),\n        # we should not raise an exception, so we return an empty list.\n        if n < 0:\n            return []\n\n        tokens = self._tokenizer.tokenize(s)\n        result = []\n        for t in tokens:\n            if self._counter.count(t) == n:\n                result.append(t)\n        return result\ndef select_words(s, n):\n    \"\"\"Given a string s and a natural number n, you have been tasked to implement \n    a function that returns a list of all words from string s that contain exactly \n    n consonants, in order these words appear in the string s.\n    If the string s is empty then the function should return an empty list.\n    Note: you may assume the input string contains only letters and spaces.\n    Examples:\n    select_words(\"Mary had a little lamb\", 4) ==> [\"little\"]\n    select_words(\"Mary had a little lamb\", 3) ==> [\"Mary\", \"lamb\"]\n    select_words(\"simple white space\", 2) ==> []\n    select_words(\"Hello world\", 4) ==> [\"world\"]\n    select_words(\"Uncle sam\", 3) ==> [\"Uncle\"]\n    \"\"\"\n    # Instantiate helper components inline as per instructions.\n    tokenizer = Tokenizer()\n    counter = ConsonantCounter()\n\n    service = WordSelectorService(tokenizer, counter)\n    \n    return service.select(s, n)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/118": [{"task_id": "HumanEval/118", "solution": "def get_closest_vowel(word):\n    \"\"\"Finds the closest vowel that stands between two consonants from the right side of the word.\n    Returns an empty string if no such vowel is found.\n    \"\"\"\n    VOWELS = frozenset({'a', 'e', 'i', 'o', 'u', 'A', 'E', 'I', 'O', 'U'})\n\n    def _is_vowel(char):\n        return char in VOWELS\n\n    def _is_consonant(char):\n        # A character is a consonant if it's an alphabet and not a vowel.\n        # 'y' is treated as a consonant.\n        return char.isalpha() and char not in VOWELS\n\n    n = len(word)\n    # Iterate from the second to last character (index n-2) down to the second character (index 1).\n    # This ensures that word[i-1] and word[i+1] are always valid indices,\n    # and excludes the first and last characters as per the rule.\n    for i in range(n - 2, 0, -1):\n        if _is_vowel(word[i]) and _is_consonant(word[i-1]) and _is_consonant(word[i+1]):\n            return word[i]\n\n    return \"\"", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/118", "solution": "def get_closest_vowel(word):\n    \"\"\"Finds the closest vowel from the right side of the word that is surrounded by two consonants,\n    excluding the first and last characters.\n    \"\"\"\n    VOWELS = \"aeiouAEIOU\"\n\n    def is_vowel(char: str) -> bool:\n        return char in VOWELS\n\n    def is_consonant(char: str) -> bool:\n        return char.isalpha() and char not in VOWELS\n\n    # The design context mentions trimming, though problem statement implies letters only.\n    # Following the design context's example code snippet.\n    w = word.strip()\n    n = len(w)\n\n    if n <= 2:\n        return \"\"\n\n    # Iterate from the second-to-last character down to the second character (index 1).\n    # This excludes the first and last characters as per the problem.\n    for i in range(n - 2, 0, -1):\n        char = w[i]\n        if is_vowel(char):\n            left_neighbor = w[i - 1]\n            right_neighbor = w[i + 1]\n\n            if is_consonant(left_neighbor) and is_consonant(right_neighbor):\n                return char\n\n    return \"\"", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/119": [{"task_id": "HumanEval/119", "solution": "def match_parens(lst):\n    '''\n    Checks if concatenating two parenthesis strings in any order results in a balanced string.\n    '''\n    s1, s2 = lst[0], lst[1]\n\n    def _is_balanced(s: str) -> bool:\n        \"\"\"\n        Determines if a string of parentheses is balanced.\n        This runs in O(N) time where N is the length of the string.\n        \"\"\"\n        balance = 0\n        for ch in s:\n            if ch == \"(\":\n                balance += 1\n            else:  # The problem statement implies only '(' and ')' characters\n                balance -= 1\n            if balance < 0:\n                return False  # Unbalanced if closing a non-existent open parenthesis\n        return balance == 0  # Balanced if final count is zero\n\n    # Try concatenating in the first order: s1 + s2\n    if _is_balanced(s1 + s2):\n        return 'Yes'\n\n    # Try concatenating in the second order: s2 + s1\n    if _is_balanced(s2 + s1):\n        return 'Yes'\n\n    # If neither concatenation results in a balanced string\n    return 'No'", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/119", "solution": "def match_parens(lst):\n    \"\"\"\n    Checks if two parenthesis strings can be concatenated in any order to form a balanced string.\n    \"\"\"\n\n    def compute_total_and_min_prefix(s: str) -> tuple[int, int]:\n        \"\"\"\n        Calculates the total balance and the minimum prefix balance of a parenthesis string.\n        \"\"\"\n        balance = 0\n        min_prefix_balance = 0\n        for char in s:\n            if char == '(':\n                balance += 1\n            else:  # char == ')'\n                balance -= 1\n            min_prefix_balance = min(min_prefix_balance, balance)\n        return balance, min_prefix_balance\n\n    def is_good_concatenation(s1: str, s2: str) -> bool:\n        \"\"\"\n        Determines if concatenating s1 then s2 results in a balanced parenthesis string.\n        \"\"\"\n        total1, min_prefix1 = compute_total_and_min_prefix(s1)\n        total2, min_prefix2 = compute_total_and_min_prefix(s2)\n\n        # A string is balanced if its total balance is 0 and no prefix balance drops below 0.\n        # Condition 1: The total balance of the concatenated string must be 0.\n        if total1 + total2 != 0:\n            return False\n\n        # Condition 2: All prefix balances must be non-negative.\n        # a) Minimum prefix balance within s1 must be non-negative.\n        if min_prefix1 < 0:\n            return False\n        # b) Minimum prefix balance within s2 (after s1) must be non-negative.\n        # The balance starts at 'total1' when s2 begins.\n        # So, the absolute minimum during s2's traversal is total1 + min_prefix2.\n        if total1 + min_prefix2 < 0:\n            return False\n\n        return True\n\n    s1_val = lst[0]\n    s2_val = lst[1]\n\n    # Check the first concatenation order: s1 + s2\n    if is_good_concatenation(s1_val, s2_val):\n        return 'Yes'\n\n    # Check the second concatenation order: s2 + s1\n    if is_good_concatenation(s2_val, s1_val):\n        return 'Yes'\n\n    return 'No'", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/120": [{"task_id": "HumanEval/120", "solution": "import heapq\ndef maximum(arr, k):\n    \"\"\"\n    Given an array arr of integers and a positive integer k, return a sorted list \n    of length k with the maximum k numbers in arr.\n    \"\"\"\n    if k == 0:\n        return []\n    \n    # Use heapq.nlargest to efficiently find the k largest elements.\n    # heapq.nlargest returns the elements in descending order.\n    largest_k = heapq.nlargest(k, arr)\n    \n    # Sort the result in ascending order as required by the problem statement.\n    return sorted(largest_k)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/120", "solution": "import heapq\ndef maximum(arr, k):\n    \"\"\"\n    Returns a sorted list of length k with the maximum k numbers in arr.\n    Uses a min-heap of size k for efficient retrieval of top k elements.\n    \"\"\"\n    if k == 0:\n        return []\n    elif k >= len(arr):\n        return sorted(arr)\n    else:\n        # Use a min-heap to keep track of the k largest elements found so far.\n        # Initialize the heap with the first k elements.\n        heap = arr[:k]\n        heapq.heapify(heap)\n\n        # Iterate through the rest of the array.\n        # If an element is larger than the smallest element in the heap (heap[0]),\n        # replace the smallest element with the new element.\n        for x in arr[k:]:\n            if x > heap[0]:\n                heapq.heapreplace(heap, x)\n        \n        # The heap now contains the k largest elements. Sort them before returning.\n        return sorted(heap)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/122": [{"task_id": "HumanEval/122", "solution": "def add_elements(arr, k):\n    \"\"\"\n    Given a non-empty array of integers arr and an integer k, return\n    the sum of the elements with at most two digits from the first k elements of arr.\n    \"\"\"\n\n    def digit_count(n: int) -> int:\n        \"\"\"Returns the number of digits in the absolute value of n.\"\"\"\n        return 1 if n == 0 else len(str(abs(n)))\n\n    def is_at_most_two_digits(n: int) -> bool:\n        \"\"\"Checks if an integer has at most two