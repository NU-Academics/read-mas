      # Miller-Rabin probabilistic primality test for larger numbers\n        # k is the number of rounds (default 5 as per design context)\n        k = 5\n\n        # Find s and d such that num - 1 = 2^s * d, where d is odd\n        d = num - 1\n        s = 0\n        while d % 2 == 0:\n            d //= 2\n            s += 1\n\n        # Witness loop for Miller-Rabin\n        for _ in range(k):\n            a = random.randint(2, num - 2) # Pick random 'a' in [2, num-2]\n            x = pow(a, d, num) # Calculate a^d % num\n\n            if x == 1 or x == num - 1:\n                continue\n\n            for _ in range(s - 1):\n                x = pow(x, 2, num)\n                if x == num - 1:\n                    break\n            else: # If inner loop completes without x becoming num - 1\n                return False # num is composite\n\n        return True # num is probably prime (passed k rounds)\n\n    if is_probable_prime(n):\n        return x\n    else:\n        return y", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/150", "solution": "import collections\nimport random\nfrom abc import ABC, abstractmethod\nclass InvalidInputError(Exception):\n    \"\"\"Custom exception for invalid input parameters.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\ndef parse_int(value: any) -> int:\n    \"\"\"Converts a value to an integer, raising InvalidInputError if conversion fails or it's a non-exact float.\"\"\"\n    if isinstance(value, int):\n        return value\n    if isinstance(value, float):\n        if value.is_integer():\n            return int(value)\n        raise InvalidInputError(f\"Float '{value}' is not an exact integer.\")\n    try:\n        return int(value)\n    except (ValueError, TypeError) as e:\n        raise InvalidInputError(f\"Input '{value}' cannot be parsed as an integer.\")\nclass IPrimeCacheRepository(ABC):\n    \"\"\"Interface for prime number caching.\"\"\"\n    @abstractmethod\n    def get(self, n: int) -> bool | None:\n        pass\n\n    @abstractmethod\n    def set(self, n: int, is_prime: bool) -> None:\n        pass\nclass InMemoryCacheRepository(IPrimeCacheRepository):\n    \"\"\"In-memory LRU cache for primality results.\"\"\"\n    def __init__(self, max_size: int = 1024):\n        self.max_size = max_size\n        self.cache = collections.OrderedDict()\n\n    def get(self, n: int) -> bool | None:\n        val = self.cache.get(n)\n        if val is not None:\n            self.cache.move_to_end(n)\n        return val\n\n    def set(self, n: int, is_prime: bool) -> None:\n        self.cache[n] = is_prime\n        self.cache.move_to_end(n)\n        if len(self.cache) > self.max_size:\n            self.cache.popitem(last=False)\nclass PrimeChecker(ABC):\n    \"\"\"Abstract base class for prime number checking algorithms.\"\"\"\n    @abstractmethod\n    def is_prime(self, n: int) -> bool:\n        pass\nclass MillerRabinChecker(PrimeChecker):\n    \"\"\"Probabilistic primality test using Miller-Rabin algorithm.\"\"\"\n    def __init__(self, rounds: int):\n        self.rounds = rounds\n\n    def _try_composite(self, a: int, d: int, n: int, s: int) -> bool:\n        \"\"\"Witness test for Miller-Rabin algorithm.\"\"\"\n        if pow(a, d, n) == 1:\n            return False\n        for i in range(s):\n            if pow(a, (2**i) * d, n) == n - 1:\n                return False\n        return True\n\n    def is_prime(self, n: int) -> bool:\n        \"\"\"Determines if n is prime using Miller-Rabin.\"\"\"\n        if n < 2: return False\n        if n == 2 or n == 3: return True\n        if n % 2 == 0: return False\n\n        s = 0\n        d = n - 1\n        while d % 2 == 0:\n            d //= 2\n            s += 1\n\n        for _ in range(self.rounds):\n            a = random.randrange(2, n - 1)\n            if self._try_composite(a, d, n, s):\n                return False\n        return True\nclass PrimeService:\n    \"\"\"Orchestrates primality checking, caching, and value selection.\"\"\"\n    def __init__(self, checker: PrimeChecker, cache_repo: IPrimeCacheRepository | None = None) -> None:\n        self.checker = checker\n        self.cache = cache_repo\n\n    def choose_value(self, n: any, x: any, y: any) -> any:\n        \"\"\"Parses n, checks primality (using cache if available), and returns x or y.\"\"\"\n        n_int = parse_int(n)\n\n        cached_result = self._is_prime_cached(n_int)\n        if cached_result is not None:\n            is_p = cached_result\n        else:\n            is_p = self.checker.is_prime(n_int)\n            self._cache_result(n_int, is_p)\n        \n        return x if is_p else y\n\n    def _is_prime_cached(self, n: int) -> bool | None:\n        \"\"\"Retrieves primality result from cache if available.\"\"\"\n        if self.cache:\n            return self.cache.get(n)\n        return None\n\n    def _cache_result(self, n: int, is_prime: bool) -> None:\n        \"\"\"Stores primality result in cache if enabled.\"\"\"\n        if self.cache:\n            self.cache.set(n, is_prime)\ndef _build_default_service() -> PrimeService:\n    \"\"\"Builds a default PrimeService with Miller-Rabin checker and in-memory cache.\"\"\"\n    MR_ROUNDS = 5\n    CACHE_MAX_SIZE = 1024\n\n    checker = MillerRabinChecker(rounds=MR_ROUNDS)\n    cache = InMemoryCacheRepository(max_size=CACHE_MAX_SIZE)\n    return PrimeService(checker=checker, cache_repo=cache)\ndef x_or_y(n, x, y):\n    \"\"\"Returns x if n is prime, y otherwise, using a default prime service.\"\"\"\n    svc = _build_default_service()\n    return svc.choose_value(n, x, y)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/151": [{"task_id": "HumanEval/151", "solution": "def double_the_difference(lst):\n    '''\n    Given a list of numbers, return the sum of squares of the numbers\n    in the list that are odd