{"task_id": "HumanEval/38", "solution": "def decode_cyclic(s: str):\n    \"\"\"\n    takes as input string encoded with encode_cyclic function. Returns decoded string.\n    \"\"\"\n    # split string to groups. Each of length 3.\n    groups = [s[(3 * i):min((3 * i + 3), len(s))] for i in range((len(s) + 2) // 3)]\n    # reverse cycle elements in each group. Unless group has fewer elements than 3.\n    groups = [(group[-1] + group[:-1]) if len(group) == 3 else group for group in groups]\n    return \"\".join(groups)"}
{"task_id": "HumanEval/36", "solution": "def _is_divisible_by_11_or_13(num: int) -> bool:\n    \"\"\"Checks if a number is divisible by 11 or 13.\"\"\"\n    return (num % 11 == 0) or (num % 13 == 0)\n\ndef _count_digit_7(num: int) -> int:\n    \"\"\"Counts the occurrences of the digit '7' in an integer.\"\"\"\n    count = 0\n    s_num = str(abs(num))\n    for digit_char in s_num:\n        if digit_char == '7':\n            count += 1\n    return count\n\ndef fizz_buzz(n: int):\n    \"\"\"Return the number of times the digit 7 appears in integers less than n which are divisible by 11 or 13.\n    >>> fizz_buzz(50)\n    0\n    >>> fizz_buzz(78)\n    2\n    >>> fizz_buzz(79)\n    3\n    \"\"\"\n    total_sevens_count = 0\n    for i in range(1, n):\n        if _is_divisible_by_11_or_13(i):\n            total_sevens_count += _count_digit_7(i)\n    return total_sevens_count"}
{"task_id": "HumanEval/33", "solution": "def sort_third(l: list):\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the indicies that are not divisible by three, while its values at the indicies that are divisible by three are equal\n    to the values of the corresponding indicies of l, but sorted.\n    >>> sort_third([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_third([5, 6, 3, 4, 8, 9, 2])\n    [2, 6, 3, 4, 8, 9, 5]\n    \"\"\"\n    if not l:\n        return []\n\n    l_prime = list(l)\n\n    divisible_indices = []\n    collected_values = []\n\n    for i in range(len(l)):\n        if i % 3 == 0:\n            divisible_indices.append(i)\n            collected_values.append(l[i])\n\n    collected_values.sort()\n\n    for i, index_k in enumerate(divisible_indices):\n        l_prime[index_k] = collected_values[i]\n\n    return l_prime"}
{"task_id": "HumanEval/37", "solution": "def sort_even(l: list):\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the odd indicies, while its values at the even indicies are equal\n    to the values of the even indicies of l, but sorted.\n    >>> sort_even([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_even([5, 6, 3, 4])\n    [3, 6, 5, 4]\n    \"\"\"\n    n = len(l)\n    result_list = [None] * n\n    even_values_collector = []\n\n    for i in range(n):\n        if i % 2 == 0:\n            even_values_collector.append(l[i])\n        else:\n            result_list[i] = l[i]\n\n    even_values_collector.sort()\n\n    even_values_ptr = 0\n    for i in range(n):\n        if i % 2 == 0:\n            result_list[i] = even_values_collector[even_values_ptr]\n            even_values_ptr += 1\n            \n    return result_list"}
{"task_id": "HumanEval/39", "solution": "import math\n\nclass PrimeChecker:\n    \"\"\"Checks if a given number is prime.\"\"\"\n    def isPrime(self, num: int) -> bool:\n        if num <= 1:\n            return False\n        if num <= 3:\n            return True\n        if num % 2 == 0 or num % 3 == 0:\n            return False\n        i = 5\n        while i * i <= num:\n            if num % i == 0 or num % (i + 2) == 0:\n                return False\n            i += 6\n        return True\n\nclass FibonacciSequence:\n    \"\"\"Provides methods to generate Fibonacci numbers and check if a number is Fibonacci.\"\"\"\n    def generate_fibonacci_numbers(self):\n        a, b = 0, 1\n        yield a\n        yield b\n        while True:\n            a, b = b, a + b\n            yield b\n\n    def isFibonacci(self, num: int) -> bool:\n        def _is_perfect_square(k):\n            s = int(math.isqrt(k))\n            return s * s == k\n\n        if num < 0:\n            return False\n        return _is_perfect_square(5 * num * num + 4) or _is_perfect_square(5 * num * num - 4)\n\nclass PrimeFibonacciFinder:\n    \"\"\"Orchestrates finding the n-th number that is both Fibonacci and prime.\"\"\"\n    def findNthPrimeFibonacci(self, n: int) -> int:\n        fib_generator = FibonacciSequence().generate_fibonacci_numbers()\n        prime_checker = PrimeChecker()\n        \n        found_prime_fib_count = 0\n        \n        for fib_num in fib_generator:\n            if fib_num <= 1: # 0 and 1 are not prime.\n                continue\n            \n            if prime_checker.isPrime(fib_num):\n                found_prime_fib_count += 1\n                if found_prime_fib_count == n:\n                    return fib_num\n\ndef prime_fib(n: int):\n    \"\"\"\n    prime_fib returns n-th number that is a Fibonacci number and it's also prime.\n    >>> prime_fib(1)\n    2\n    >>> prime_fib(2)\n    3\n    >>> prime_fib(3)\n    5\n    >>> prime_fib(4)\n    13\n    >>> prime_fib(5)\n    89\n    \"\"\"\n    finder = PrimeFibonacciFinder()\n    return finder.findNthPrimeFibonacci(n)"}
{"task_id": "HumanEval/40", "solution": "def triples_sum_to_zero(l: list):\n    \"\"\"\n    triples_sum_to_zero takes a list of integers as an input.\n    it returns True if there are three distinct elements in the list that\n    sum to zero, and False otherwise.\n    \"\"\"\n    n = len(l)\n    if n < 3:\n        return False\n\n    for i in range(n):\n        for j in range(i + 1, n):\n            for k in range(j + 1, n):\n                if l[i] + l[j] + l[k] == 0:\n                    return True\n    return False"}
