{"task_id": "HumanEval/139", "solution": "def special_factorial(n):\n    \"\"\"The Brazilian factorial is defined as:\n    brazilian_factorial(n) = n! * (n-1)! * (n-2)! * ... * 1!\n    where n > 0\n\n    For example:\n    >>> special_factorial(4)\n    288\n\n    The function will receive an integer as input and should return the special\n    factorial of this integer.\n    \"\"\"\n    def _calculate_factorial(k):\n        \"\"\"Calculates the factorial of a non-negative integer k.\"\"\"\n        if k == 0 or k == 1:\n            return 1\n        res = 1\n        for i in range(2, k + 1):\n            res *= i\n        return res\n\n    special_fact = 1\n    for i in range(1, n + 1):\n        special_fact *= _calculate_factorial(i)\n    return special_fact"}
{"task_id": "HumanEval/142", "solution": "def sum_squares(lst):\n    \"\"\"\"\n    This function will take a list of integers. For all entries in the list, the function shall square the integer entry if its index is a \n    multiple of 3 and will cube the integer entry if its index is a multiple of 4 and not a multiple of 3. The function will not \n    change the entries in the list whose indexes are not a multiple of 3 or 4. The function shall then return the sum of all entries. \n    \n    Examples:\n    For lst = [1,2,3] the output should be 6\n    For lst = []  the output should be 0\n    For lst = [-1,-5,2,-1,-5]  the output should be -126\n    \"\"\"\n    total_sum = 0\n    for i, num in enumerate(lst):\n        if i % 3 == 0:\n            total_sum += num ** 2\n        elif i % 4 == 0:  # This implicitly handles \"not a multiple of 3\"\n            total_sum += num ** 3\n        else:\n            total_sum += num\n    return total_sum"}
{"task_id": "HumanEval/143", "solution": "def words_in_sentence(sentence):\n    \"\"\"\n    You are given a string representing a sentence,\n    the sentence contains some words separated by a space,\n    and you have to return a string that contains the words from the original sentence,\n    whose lengths are prime numbers,\n    the order of the words in the new string should be the same as the original one.\n\n    Example 1:\n        Input: sentence = \"This is a test\"\n        Output: \"is\"\n\n    Example 2:\n        Input: sentence = \"lets go for swimming\"\n        Output: \"go for\"\n\n    Constraints:\n        * 1 <= len(sentence) <= 100\n        * sentence contains only letters\n    \"\"\"\n    def _is_prime(n):\n        \"\"\"Determines if a given integer is a prime number.\"\"\"\n        if n <= 1:\n            return False\n        for i in range(2, int(n**0.5) + 1):\n            if n % i == 0:\n                return False\n        return True\n\n    words = sentence.split(' ')\n    filtered_words = []\n\n    for word in words:\n        if word and _is_prime(len(word)):\n            filtered_words.append(word)\n\n    return ' '.join(filtered_words)"}
{"task_id": "HumanEval/144", "solution": "class InvalidFractionError(ValueError):\n    \"\"\"Custom exception for invalid fraction string formats or values.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n\nclass Fraction:\n    \"\"\"Represents a mathematical fraction with a numerator and a denominator.\"\"\"\n    def __init__(self, numerator: int, denominator: int):\n        self.numerator = numerator\n        self.denominator = denominator\n\nclass FractionParser:\n    \"\"\"Parses a string into a Fraction object, validating format and values.\"\"\"\n    @staticmethod\n    def parse(fraction_string: str) -> 'Fraction':\n        parts = fraction_string.split('/')\n        if len(parts) != 2:\n            raise InvalidFractionError(f\"Invalid fraction format: {fraction_string}. Expected 'numerator/denominator'.\")\n        \n        try:\n            numerator = int(parts[0])\n            denominator = int(parts[1])\n        except ValueError:\n            raise InvalidFractionError(f\"Invalid numerator or denominator value in: {fraction_string}. Must be integers.\")\n        \n        if numerator <= 0 or denominator <= 0:\n            raise InvalidFractionError(f\"Numerator and denominator must be positive whole numbers: {fraction_string}\")\n        \n        return Fraction(numerator, denominator)\n\nclass FractionCalculator:\n    \"\"\"Performs arithmetic operations on Fraction objects.\"\"\"\n    @staticmethod\n    def multiply(f1: 'Fraction', f2: 'Fraction') -> 'Fraction':\n        new_numerator = f1.numerator * f2.numerator\n        new_denominator = f1.denominator * f2.denominator\n        return Fraction(new_numerator, new_denominator)\n\nclass WholeNumberChecker:\n    \"\"\"Determines if a given Fraction object represents a whole number.\"\"\"\n    @staticmethod\n    def is_whole_number(f: 'Fraction') -> bool:\n        return f.numerator % f.denominator == 0\n\ndef simplify(x, n):\n    \"\"\"Your task is to implement a function that will simplify the expression\n    x * n. The function returns True if x * n evaluates to a whole number and False\n    otherwise. Both x and n, are string representation of a fraction, and have the following format,\n    <numerator>/<denominator> where both numerator and denominator are positive whole numbers.\n\n    You can assume that x, and n are valid fractions, and do not have zero as denominator.\n    \"\"\"\n    fraction_x = FractionParser.parse(x)\n    fraction_n = FractionParser.parse(n)\n\n    product_fraction = FractionCalculator.multiply(fraction_x, fraction_n)\n\n    return WholeNumberChecker.is_whole_number(product_fraction)"}
{"task_id": "HumanEval/149", "solution": "def sorted_list_sum(lst):\n    \"\"\"Filters a list of strings to include only even-length strings,\n    then sorts the result by length (ascending) and alphabetically (ascending).\"\"\"\n\n    def _is_odd_length(s):\n        \"\"\"Checks if a string has an odd length.\"\"\"\n        return len(s) % 2 != 0\n\n    filtered_list = [s for s in lst if not _is_odd_length(s)]\n    \n    # Sort primarily by length (ascending), secondarily by alphabetical order (ascending)\n    filtered_list.sort(key=lambda s: (len(s), s))\n    \n    return filtered_list"}
{"task_id": "HumanEval/146", "solution": "def specialFilter(nums):\n    \"\"\"Write a function that takes an array of numbers as input and returns \n    the number of elements in the array that are greater than 10 and both \n    first and last digits of a number are odd (1, 3, 5, 7, 9).\n    For example:\n    specialFilter([15, -73, 14, -15]) => 1 \n    specialFilter([33, -2, -3, 45, 21, 109]) => 2\n    \"\"\"\n\n    def _is_odd(digit):\n        \"\"\"Checks if a given digit is odd.\"\"\"\n        return digit % 2 != 0\n\n    def _get_last_digit(num):\n        \"\"\"Extracts the last digit of a number.\"\"\"\n        return abs(num) % 10\n\n    def _get_first_digit(num):\n        \"\"\"Extracts the first digit of a number.\"\"\"\n        return int(str(abs(num))[0])\n\n    count = 0\n    for num in nums:\n        if num > 10:\n            first_digit = _get_first_digit(num)\n            last_digit = _get_last_digit(num)\n            if _is_odd(first_digit) and _is_odd(last_digit):\n                count += 1\n    return count"}
{"task_id": "HumanEval/145", "solution": "def order_by_points(nums):\n    \"\"\"\n    Sorts a list of integers by the sum of their digits (ascending),\n    then by their original index for ties.\n    \"\"\"\n\n    class IntegerWithMetadata:\n        \"\"\"\n        Encapsulates an integer's value, original index, and the sum of its absolute digits.\n        \"\"\"\n        def __init__(self, value: int, original_index: int):\n            self.value = value\n            self.original_index = original_index\n            self.digit_sum = self._calculate_digit_sum(value)\n\n        def _calculate_digit_sum(self, num: int) -> int:\n            \"\"\"\n            Calculates the sum of the absolute values of digits for a given number.\n            \"\"\"\n            abs_num_str = str(abs(num))\n            total_sum = 0\n            for digit_char in abs_num_str:\n                total_sum += int(digit_char)\n            return total_sum\n\n    if not nums:\n        return []\n\n    metadata_objects = [\n        IntegerWithMetadata(num, i) for i, num in enumerate(nums)\n    ]\n\n    metadata_objects.sort(key=lambda x: (x.digit_sum, x.original_index))\n\n    sorted_nums = [\n        obj.value for obj in metadata_objects\n    ]\n\n    return sorted_nums"}
{"task_id": "HumanEval/150", "solution": "from typing import Any\n\ndef is_prime(n: int) -> bool:\n    \"\"\"\n    Determines if an integer n is a prime number.\n    A prime number is a natural number greater than 1 that has no positive divisors other than 1 and itself.\n    \"\"\"\n    if n <= 1:\n        return False\n    if n <= 3:\n        return True\n    if n % 2 == 0 or n % 3 == 0:\n        return False\n    i = 5\n    while i * i <= n:\n        if n % i == 0 or n % (i + 2) == 0:\n            return False\n        i += 6\n    return True\n\ndef x_or_y(n, x, y):\n    \"\"\"A simple program which should return the value of x if n is \n    a prime number and should return the value of y otherwise.\n\n    Examples:\n    for x_or_y(7, 34, 12) == 34\n    for x_or_y(15, 8, 5) == 5\n    \n    \"\"\"\n    if is_prime(n):\n        return x\n    else:\n        return y"}
{"task_id": "HumanEval/148", "solution": "class Planet:\n    \"\"\"Represents a single planet with its name and orbital order from the Sun.\"\"\"\n    def __init__(self, name: str, order_from_sun: int):\n        self.name = name\n        self.order_from_sun = order_from_sun\n\nclass SolarSystem:\n    \"\"\"Manages solar system planet data and provides query methods.\"\"\"\n    def __init__(self):\n        # Define planets in order from the Sun\n        planet_data = [\n            (\"Mercury\", 1), (\"Venus\", 2), (\"Earth\", 3), (\"Mars\", 4),\n            (\"Jupiter\", 5), (\"Saturn\", 6), (\"Uranus\", 7), (\"Neptune\", 8)\n        ]\n        self._planets = [Planet(name, order) for name, order in planet_data]\n        self._planet_map = {planet.name: planet for planet in self._planets}\n\n    def get_planet_order(self, planet_name: str) -> int | None:\n        \"\"\"Returns the order_from_sun for a given planet_name, or None if not found.\"\"\"\n        planet = self._planet_map.get(planet_name)\n        return planet.order_from_sun if planet else None\n\n    def get_planets_between(self, planet1_name: str, planet2_name: str) -> list[str]:\n        \"\"\"Identifies and returns sorted planet names between two specified planets.\"\"\"\n        order1 = self.get_planet_order(planet1_name)\n        order2 = self.get_planet_order(planet2_name)\n\n        if order1 is None or order2 is None:\n            return []\n\n        # Determine the effective start and end orders for iteration\n        start_order = min(order1, order2)\n        end_order = max(order1, order2)\n\n        result_planets = []\n        for planet in self._planets:\n            if start_order < planet.order_from_sun < end_order:\n                result_planets.append(planet.name)\n        return result_planets\n\n# Create a singleton instance of SolarSystem\n_solar_system = SolarSystem()\n\ndef bf(planet1, planet2):\n    '''\n    There are eight planets in our solar system: the closerst to the Sun \n    is Mercury, the next one is Venus, then Earth, Mars, Jupiter, Saturn, \n    Uranus, Neptune.\n    Write a function that takes two planet names as strings planet1 and planet2. \n    The function should return a tuple containing all planets whose orbits are \n    located between the orbit of planet1 and the orbit of planet2, sorted by \n    the proximity to the sun. \n    The function should return an empty tuple if planet1 or planet2\n    are not correct planet names. \n    Examples\n    bf(\"Jupiter\", \"Neptune\") ==> (\"Saturn\", \"Uranus\")\n    bf(\"Earth\", \"Mercury\") ==> (\"Venus\")\n    bf(\"Mercury\", \"Uranus\") ==> (\"Venus\", \"Earth\", \"Mars\", \"Jupiter\", \"Saturn\")\n    '''\n    \n    planets_between = _solar_system.get_planets_between(planet1, planet2)\n    return tuple(planets_between)"}
{"task_id": "HumanEval/147", "solution": "def _calculate_array_element(i: int) -> int:\n    \"\"\"Computes a[i] = i * i - i + 1.\"\"\"\n    return i * i - i + 1\n\ndef _is_multiple_of_3(s: int) -> bool:\n    \"\"\"Checks if a sum 's' is a multiple of 3.\"\"\"\n    return s % 3 == 0\n\ndef get_max_triples(n):\n    \"\"\"\n    You are given a positive integer n. You have to create an integer array a of length n.\n        For each i (1 \u2264 i \u2264 n), the value of a[i] = i * i - i + 1.\n        Return the number of triples (a[i], a[j], a[k]) of a where i < j < k, \n    and a[i] + a[j] + a[k] is a multiple of 3.\n\n    Example :\n        Input: n = 5\n        Output: 1\n        Explanation: \n        a = [1, 3, 7, 13, 21]\n        The only valid triple is (1, 7, 13).\n    \"\"\"\n    if n < 3:\n        return 0\n\n    # Initialize an array to store the values a[i].\n    # Using 0-indexed list, a_list[idx] stores the value for i = idx + 1.\n    a_list = [0] * n\n    for i in range(1, n + 1):\n        a_list[i-1] = _calculate_array_element(i)\n\n    count = 0\n    # Iterate through all possible combinations of three distinct indices i_idx, j_idx, k_idx\n    # such that i_idx < j_idx < k_idx.\n    for i_idx in range(n - 2):\n        for j_idx in range(i_idx + 1, n - 1):\n            for k_idx in range(j_idx + 1, n):\n                current_sum = a_list[i_idx] + a_list[j_idx] + a_list[k_idx]\n                if _is_multiple_of_3(current_sum):\n                    count += 1\n    return count"}
{"task_id": "HumanEval/151", "solution": "def double_the_difference(lst):\n    '''\n    Given a list of numbers, return the sum of squares of the numbers\n    in the list that are odd. Ignore numbers that are negative or not integers.\n    '''\n    total_sum = 0\n    for num in lst:\n        if isinstance(num, int) and num > 0 and num % 2 != 0:\n            total_sum += num * num\n    return total_sum"}
{"task_id": "HumanEval/152", "solution": "def compare(game,guess):\n    \"\"\"Calculates the absolute difference between actual game scores and guessed scores.\n    Returns 0 if the guess is correct, otherwise the absolute difference.\"\"\"\n    differences = []\n    for i in range(len(game)):\n        game_score = game[i]\n        guess_score = guess[i]\n        if game_score == guess_score:\n            differences.append(0)\n        else:\n            differences.append(abs(game_score - guess_score))\n    return differences"}
{"task_id": "HumanEval/156", "solution": "_ROMAN_MAP = [\n    (1000, 'm'), (900, 'cm'), (500, 'd'), (400, 'cd'),\n    (100, 'c'), (90, 'xc'), (50, 'l'), (40, 'xl'),\n    (10, 'x'), (9, 'ix'), (5, 'v'), (4, 'iv'),\n    (1, 'i')\n]\n\ndef int_to_mini_roman(number):\n    \"\"\"\n    Given a positive integer, obtain its roman numeral equivalent as a string,\n    and return it in lowercase.\n    Restrictions: 1 <= num <= 1000\n\n    Examples:\n    >>> int_to_mini_roman(19) == 'xix'\n    >>> int_to_mini_roman(152) == 'clii'\n    >>> int_to_mini_roman(426) == 'cdxxvi'\n    \"\"\"\n    if not (1 <= number <= 1000):\n        raise ValueError(\"Input number must be between 1 and 1000, inclusive.\")\n\n    result = []\n    for value, numeral in _ROMAN_MAP:\n        while number >= value:\n            result.append(numeral)\n            number -= value\n\n    return \"\".join(result)"}
{"task_id": "HumanEval/157", "solution": "import math\n\ndef right_angle_triangle(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle. Return True if the three\n    sides form a right-angled triangle, False otherwise.\n    A right-angled triangle is a triangle in which one angle is right angle or \n    90 degree.\n    Example:\n    right_angle_triangle(3, 4, 5) == True\n    right_angle_triangle(1, 2, 3) == False\n    '''\n    # Calculate the squares of the side lengths.\n    a_sq = a * a\n    b_sq = b * b\n    c_sq = c * c\n\n    # Check if the Pythagorean theorem holds true for any permutation of sides.\n    # Use math.isclose for robust comparison with floating-point numbers.\n    return math.isclose(a_sq + b_sq, c_sq) or \\\n           math.isclose(a_sq + c_sq, b_sq) or \\\n           math.isclose(b_sq + c_sq, a_sq)"}
{"task_id": "HumanEval/155", "solution": "def even_odd_count(num):\n    \"\"\"Given an integer. return a tuple that has the number of even and odd digits respectively.\n\n     Example:\n        even_odd_count(-12) ==> (1, 1)\n        even_odd_count(123) ==> (1, 2)\n    \"\"\"\n    even_count = 0\n    odd_count = 0\n\n    # Convert the absolute value of the number to a string to iterate through its digits.\n    # This handles negative numbers and extracts digits regardless of sign.\n    num_str = str(abs(num))\n\n    for digit_char in num_str:\n        digit = int(digit_char)\n        if digit % 2 == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n\n    return (even_count, odd_count)"}
{"task_id": "HumanEval/153", "solution": "def Strongest_Extension(class_name, extensions):\n    \"\"\"\n    Finds the strongest extension based on the number of uppercase and lowercase letters,\n    and returns it concatenated with the class name.\n    \"\"\"\n\n    def _calculate_extension_strength(extension_name):\n        \"\"\"Calculates the strength of an extension: CAP - SM.\"\"\"\n        cap_count = sum(1 for char in extension_name if char.isupper())\n        sm_count = sum(1 for char in extension_name if char.islower())\n        return cap_count - sm_count\n\n    max_strength = float('-inf')\n    strongest_extension_name = \"\"\n\n    for extension in extensions:\n        current_strength = _calculate_extension_strength(extension)\n        if current_strength > max_strength:\n            max_strength = current_strength\n            strongest_extension_name = extension\n\n    return f\"{class_name}.{strongest_extension_name}\""}
{"task_id": "HumanEval/154", "solution": "def cycpattern_check(a , b):\n    \"\"\"\n    Checks if the second word or any of its rotations is a substring in the first word.\n    \"\"\"\n    if not b:\n        return True\n    if not a:\n        return False\n\n    len_b = len(b)\n    if len_b > len(a):\n        return False\n\n    for i in range(len_b):\n        rotated_b = b[i:] + b[:i]\n        if rotated_b in a:\n            return True\n    return False"}
{"task_id": "HumanEval/159", "solution": "def eat(number, need, remaining):\n    \"\"\"\n    Calculates the total number of carrots eaten and the number of carrots left based on initial state and need.\n    \"\"\"\n    \n    total_eaten = 0\n    carrots_left = 0\n\n    if remaining >= need:\n        # Sufficient carrots are available\n        total_eaten = number + need\n        carrots_left = remaining - need\n    else:\n        # Not enough carrots, eat all remaining\n        total_eaten = number + remaining\n        carrots_left = 0\n        \n    return [total_eaten, carrots_left]"}
{"task_id": "HumanEval/158", "solution": "def _count_unique_chars(word: str) -> int:\n    \"\"\"Helper function to count the number of unique characters in a given word.\"\"\"\n    return len(set(word))\n\ndef find_max(words: list[str]) -> str:\n    \"\"\"Finds the word with maximum unique characters, using lexicographical order for tie-breaking.\"\"\"\n    if not words:\n        return \"\"\n\n    best_word = words[0]\n    max_unique_count = _count_unique_chars(words[0])\n\n    for word in words[1:]:\n        current_unique_count = _count_unique_chars(word)\n\n        if current_unique_count > max_unique_count:\n            max_unique_count = current_unique_count\n            best_word = word\n        elif current_unique_count == max_unique_count:\n            if word < best_word:\n                best_word = word\n    \n    return best_word"}
{"task_id": "HumanEval/162", "solution": "import hashlib\n\ndef string_to_md5(text):\n    \"\"\"\n    Given a string 'text', return its md5 hash equivalent string.\n    If 'text' is an empty string, return None.\n    \"\"\"\n    if not text:\n        return None\n    \n    md5_hash = hashlib.md5(text.encode('utf-8'))\n    return md5_hash.hexdigest()"}
{"task_id": "HumanEval/161", "solution": "def solve(s):\n    \"\"\"You are given a string s.\n    if s[i] is a letter, reverse its case from lower to upper or vise versa, \n    otherwise keep it as it is.\n    If the string contains no letters, reverse the string.\n    The function should return the resulted string.\n    Examples\n    solve(\"1234\") = \"4321\"\n    solve(\"ab\") = \"AB\"\n    \"#a@C\" = \"#A@c\"\n    \"\"\"\n\n    def _contains_letters(s):\n        \"\"\"Checks if the string contains any alphabetic characters.\"\"\"\n        for char in s:\n            if char.isalpha():\n                return True\n        return False\n\n    def _reverse_string(s):\n        \"\"\"Reverses the entire input string.\"\"\"\n        return s[::-1]\n\n    def _process_case(s):\n        \"\"\"Changes the case of alphabetic characters and retains others.\"\"\"\n        result_chars = []\n        for char in s:\n            if char.isalpha():\n                if char.islower():\n                    result_chars.append(char.upper())\n                else:\n                    result_chars.append(char.lower())\n            else:\n                result_chars.append(char)\n        return \"\".join(result_chars)\n\n    if not _contains_letters(s):\n        return _reverse_string(s)\n    else:\n        return _process_case(s)"}
{"task_id": "HumanEval/160", "solution": "class InputValidationError(Exception):\n    \"\"\"Custom exception for signaling invalid input conditions.\"\"\"\n    pass\n\nclass InputValidator:\n    \"\"\"Validates the input operator and operand lists.\"\"\"\n    def validate(self, operators: list[str], operands: list[int]) -> None:\n        \"\"\"Validates the input operator and operand lists against specified requirements.\"\"\"\n        if len(operators) == 0:\n            raise InputValidationError(\"Operator list must have at least one operator.\")\n        if len(operands) < 2:\n            raise InputValidationError(\"Operand list must have at least two operands.\")\n        if len(operators) != len(operands) - 1:\n            raise InputValidationError(\"Length of operator list must be equal to length of operand list minus one.\")\n        \n        allowed_operators = {'+', '-', '*', '//', '**'}\n        for op in operators:\n            if op not in allowed_operators:\n                raise InputValidationError(f\"Invalid operator '{op}' found. Allowed operators are: {', '.join(allowed_operators)}\")\n\n        for operand in operands:\n            if not isinstance(operand, int) or operand < 0:\n                raise InputValidationError(f\"Operand '{operand}' is not a non-negative integer.\")\n\nclass ExpressionBuilder:\n    \"\"\"Constructs a string representation of the algebraic expression.\"\"\"\n    def build(self, operators: list[str], operands: list[int]) -> str:\n        \"\"\"Builds an algebraic expression string by interleaving operands and operators.\"\"\"\n        expression_parts = []\n        for i in range(len(operators)):\n            expression_parts.append(str(operands[i]))\n            expression_parts.append(operators[i])\n        expression_parts.append(str(operands[-1]))\n        return \" \".join(expression_parts)\n\nclass ExpressionEvaluator:\n    \"\"\"Safely evaluates a given algebraic expression string.\"\"\"\n    def evaluate(self, expression_string: str) -> int:\n        \"\"\"Evaluates an algebraic expression string following standard mathematical precedence.\"\"\"\n        # The design context explicitly justifies using eval() due to internal construction\n        # and validation of the expression string, mitigating typical security risks.\n        return eval(expression_string)\n\ndef do_algebra(operator, operand):\n    \"\"\"\n    Given two lists operator, and operand, this function builds and evaluates an algebraic expression.\n    It returns the integer evaluation of the expression, following standard mathematical precedence.\n    \"\"\"\n    validator = InputValidator()\n    builder = ExpressionBuilder()\n    evaluator = ExpressionEvaluator()\n\n    validator.validate(operator, operand)\n    expression_string = builder.build(operator, operand)\n    result = evaluator.evaluate(expression_string)\n\n    return result"}
{"task_id": "HumanEval/163", "solution": "def generate_integers(a, b):\n    \"\"\"\n    Given two positive integers a and b, return the even digits between a\n    and b, in ascending order.\n    \"\"\"\n    lower_bound = min(a, b)\n    upper_bound = max(a, b)\n\n    EVEN_DIGITS_SET = {0, 2, 4, 6, 8}\n\n    filtered_digits = []\n    for digit in EVEN_DIGITS_SET:\n        if lower_bound <= digit <= upper_bound:\n            filtered_digits.append(digit)\n\n    filtered_digits.sort()\n\n    return filtered_digits"}
{"task_id": "HumanEval/17", "solution": "import re\nfrom typing import List\n\n\ndef parse_music(music_string: str) -> List[int]:\n    \"\"\" Parses a string of musical notes and returns a list of their beat durations. \"\"\"\n    NOTE_BEATS = {\n        'o': 4,\n        'o|': 2,\n        '.|': 1\n    }\n    \n    # Split the music string into individual note tokens\n    # Using regex to find all occurrences of 'o', 'o|', or '.|'\n    notes = re.findall(r'o\\||\\.\\||o', music_string)\n    \n    beat_durations = []\n    for note_symbol in notes:\n        # Map each note symbol to its beat duration using the predefined dictionary\n        beat_durations.append(NOTE_BEATS[note_symbol])\n            \n    return beat_durations"}
