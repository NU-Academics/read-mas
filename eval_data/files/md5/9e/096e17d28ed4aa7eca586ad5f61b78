{"task_id": "HumanEval/44", "solution": "def change_base(x: int, base: int):\n    \"\"\"Change numerical base of input number x to base.\n    return string representation after the conversion.\n    base numbers are less than 10.\n    >>> change_base(8, 3)\n    '22'\n    >>> change_base(8, 2)\n    '1000'\n    >>> change_base(7, 2)\n    '111'\n    \"\"\"\n    if not (1 < base < 10):\n        raise ValueError(\"Base must be between 2 and 9 (inclusive).\")\n\n    if x == 0:\n        return '0'\n\n    result_digits = []\n    while x > 0:\n        remainder = x % base\n        result_digits.append(str(remainder))\n        x //= base\n\n    return ''.join(result_digits[::-1])"}
{"task_id": "HumanEval/43", "solution": "def pairs_sum_to_zero(l):\n    \"\"\"\n    pairs_sum_to_zero takes a list of integers as an input.\n    it returns True if there are two distinct elements in the list that\n    sum to zero, and False otherwise.\n    >>> pairs_sum_to_zero([1, 3, 5, 0])\n    False\n    >>> pairs_sum_to_zero([1, 3, -2, 1])\n    False\n    >>> pairs_sum_to_zero([1, 2, 3, 7])\n    False\n    >>> pairs_sum_to_zero([2, 4, -5, 3, 5, 7])\n    True\n    >>> pairs_sum_to_zero([1])\n    False\n    \"\"\"\n    seen_numbers = set()\n    for num in l:\n        complement = -num\n        if complement in seen_numbers:\n            return True\n        seen_numbers.add(num)\n    return False"}
{"task_id": "HumanEval/45", "solution": "\nclass Triangle:\n    \"\"\"Encapsulates properties and area calculation for a triangle.\"\"\"\n    def __init__(self, side: float, height: float):\n        self.side = side\n        self.height = height\n\n    def calculate_area(self) -> float:\n        \"\"\"Computes and returns the area of the triangle.\"\"\"\n        return 0.5 * self.side * self.height\n\ndef triangle_area(a, h):\n    \"\"\"Given length of a side and high return area for a triangle.\n    >>> triangle_area(5, 3)\n    7.5\n    \"\"\"\n    triangle = Triangle(a, h)\n    return triangle.calculate_area()"}
{"task_id": "HumanEval/46", "solution": "def fib4(n: int):\n    \"\"\"The Fib4 number sequence is a sequence similar to the Fibbonacci sequnece that's defined as follows:\n    fib4(0) -> 0\n    fib4(1) -> 0\n    fib4(2) -> 2\n    fib4(3) -> 0\n    fib4(n) -> fib4(n-1) + fib4(n-2) + fib4(n-3) + fib4(n-4).\n    This function efficiently computes the n-th element of the fib4 number sequence iteratively.\n    \"\"\"\n    if n == 0:\n        return 0\n    if n == 1:\n        return 0\n    if n == 2:\n        return 2\n    if n == 3:\n        return 0\n\n    # Initialize the first four fib4 numbers.\n    # fibs[0] corresponds to fib4(i-4), fibs[1] to fib4(i-3), etc.\n    fibs = [0, 0, 2, 0] # Represents fib4(0), fib4(1), fib4(2), fib4(3)\n\n    for i in range(4, n + 1):\n        # Calculate the next fib4 number using the sum of the previous four.\n        next_fib = fibs[0] + fibs[1] + fibs[2] + fibs[3]\n        \n        # Shift the values to keep only the last four relevant numbers.\n        fibs[0] = fibs[1]\n        fibs[1] = fibs[2]\n        fibs[2] = fibs[3]\n        fibs[3] = next_fib\n    \n    # After the loop, fibs[3] holds fib4(n).\n    return fibs[3]"}
