{"task_id": "HumanEval/7", "solution": "def filter_by_substring(strings: List[str], substring: str) -> List[str]:\n    \"\"\" Filter an input list of strings only for ones that contain given substring\n    >>> filter_by_substring([], 'a')\n    []\n    >>> filter_by_substring(['abc', 'bacd', 'cde', 'array'], 'a')\n    ['abc', 'bacd', 'array']\n    \"\"\"\n    return [s for s in strings if substring in s]"}
{"task_id": "HumanEval/0", "solution": "def has_close_elements(numbers: List[float], threshold: float) -> bool:\n    \"\"\" Check if in given list of numbers, are any two numbers closer to each other than\n    given threshold.\n    \"\"\"\n    n = len(numbers)\n    for i in range(n):\n        for j in range(i + 1, n):\n            if abs(numbers[i] - numbers[j]) < threshold:\n                return True\n    return False"}
{"task_id": "HumanEval/4", "solution": "from typing import List\n\n\ndef mean_absolute_deviation(numbers: List[float]) -> float:\n    \"\"\" For a given list of input numbers, calculate Mean Absolute Deviation\n    around the mean of this dataset.\n    Mean Absolute Deviation is the average absolute difference between each\n    element and a centerpoint (mean in this case):\n    MAD = average | x - x_mean |\n    >>> mean_absolute_deviation([1.0, 2.0, 3.0, 4.0])\n    1.0\n    \"\"\"\n    def _calculate_mean(nums: List[float]) -> float:\n        \"\"\"Calculates the arithmetic mean of a list of floating-point numbers.\"\"\"\n        if not nums:\n            return 0.0\n        return sum(nums) / len(nums)\n\n    def _calculate_absolute_differences(nums: List[float], mean: float) -> List[float]:\n        \"\"\"Calculates the absolute difference between each number and the given mean.\"\"\"\n        return [abs(x - mean) for x in nums]\n\n    def _calculate_average(nums: List[float]) -> float:\n        \"\"\"Calculates the average of a list of floating-point numbers.\"\"\"\n        if not nums:\n            return 0.0\n        return sum(nums) / len(nums)\n\n    if not numbers:\n        return 0.0\n\n    data_mean = _calculate_mean(numbers)\n    absolute_differences = _calculate_absolute_differences(numbers, data_mean)\n    mad_result = _calculate_average(absolute_differences)\n\n    return mad_result"}
{"task_id": "HumanEval/2", "solution": "import math\n\ndef truncate_number(number: float) -> float:\n    \"\"\" Given a positive floating point number, it can be decomposed into\n    an integer part (largest integer smaller than given number) and decimals\n    (leftover part always smaller than 1).\n\n    Return the decimal part of the number.\n    >>> truncate_number(3.5)\n    0.5\n    \"\"\"\n    if not isinstance(number, (int, float)) or number <= 0:\n        raise ValueError(\"Input must be a positive floating-point number.\")\n\n    integer_part = math.floor(number)\n    decimal_part = number - integer_part\n    return decimal_part"}
{"task_id": "HumanEval/5", "solution": "def intersperse(numbers: List[int], delimeter: int) -> List[int]:\n    \"\"\" Insert a number 'delimeter' between every two consecutive elements of input list `numbers'\n    >>> intersperse([], 4)\n    []\n    >>> intersperse([1, 2, 3], 4)\n    [1, 4, 2, 4, 3]\n    \"\"\"\n    if not numbers:\n        return []\n    if len(numbers) == 1:\n        return list(numbers)\n\n    result = []\n    for i, num in enumerate(numbers):\n        result.append(num)\n        if i < len(numbers) - 1:\n            result.append(delimeter)\n    return result"}
{"task_id": "HumanEval/6", "solution": "import collections\nfrom typing import List\n\n\ndef parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\" Input to this function is a string represented multiple groups for nested parentheses separated by spaces.\n    For each of the group, output the deepest level of nesting of parentheses.\n    E.g. (()()) has maximum two levels of nesting while ((())) has three.\n\n    >>> parse_nested_parens('(()()) ((())) () ((())()())')\n    [2, 3, 1, 3]\n    \"\"\"\n\n    def _split_paren_groups(paren_string: str) -> List[str]:\n        \"\"\"Splits the input string into individual parentheses group strings.\"\"\"\n        return [group for group in paren_string.split(' ') if group]\n\n    def _calculate_group_nesting_level(paren_group: str) -> int:\n        \"\"\"Determines the deepest nesting level within a single parentheses group.\"\"\"\n        max_depth = 0\n        current_depth = 0\n        for char in paren_group:\n            if char == '(':\n                current_depth += 1\n                max_depth = max(max_depth, current_depth)\n            elif char == ')':\n                current_depth -= 1\n        return max_depth\n\n    groups = _split_paren_groups(paren_string)\n    results = []\n    for group in groups:\n        results.append(_calculate_group_nesting_level(group))\n    return results"}
{"task_id": "HumanEval/3", "solution": "from typing import List\n\n\ndef below_zero(operations: List[int]) -> bool:\n    \"\"\" You're given a list of deposit and withdrawal operations on a bank account that starts with\n    zero balance. Your task is to detect if at any point the balance of account fallls below zero, and\n    at that point function should return True. Otherwise it should return False.\n    \"\"\"\n    balance = 0\n    for op in operations:\n        balance += op\n        if balance < 0:\n            return True\n    return False"}
{"task_id": "HumanEval/1", "solution": "from typing import List\n\n\nclass ParenthesesGroup:\n    \"\"\"Represents a single identified parentheses group and can verify its balance.\"\"\"\n    def __init__(self, content: str):\n        self._content = content\n\n    def is_balanced(self) -> bool:\n        \"\"\"Checks if the group's content has balanced parentheses.\"\"\"\n        balance = 0\n        for char in self._content:\n            if char == '(':\n                balance += 1\n            elif char == ')':\n                balance -= 1\n            if balance < 0:\n                return False\n        return balance == 0\n\n    def get_content(self) -> str:\n        \"\"\"Returns the string content of the group.\"\"\"\n        return self._content\n\n\nclass GroupCollection:\n    \"\"\"Stores and manages a list of validated ParenthesesGroup objects.\"\"\"\n    def __init__(self):\n        self._groups: List[ParenthesesGroup] = []\n\n    def add(self, group: ParenthesesGroup):\n        \"\"\"Adds a ParenthesesGroup to the collection.\"\"\"\n        self._groups.append(group)\n\n    def get_group_strings(self) -> List[str]:\n        \"\"\"Returns a list of strings from the collected groups.\"\"\"\n        return [group.get_content() for group in self._groups]\n\n\ndef _clean_input_string(raw_string: str) -> str:\n    \"\"\"Removes all space characters from an input string.\"\"\"\n    return raw_string.replace(' ', '')\n\n\ndef separate_paren_groups(paren_string: str) -> List[str]:\n    \"\"\" Input to this function is a string containing multiple groups of nested parentheses. Your goal is to\n    separate those group into separate strings and return the list of those.\n    Separate groups are balanced (each open brace is properly closed) and not nested within each other\n    Ignore any spaces in the input string.\n    >>> separate_paren_groups('( ) (( )) (( )( ))')\n    ['()', '(())', '(()())']\n    \"\"\"\n    cleaned_string = _clean_input_string(paren_string)\n    \n    collection = GroupCollection()\n    \n    balance = 0\n    current_group_start_index = 0\n    \n    for i, char in enumerate(cleaned_string):\n        if char == '(':\n            if balance == 0:\n                # This is the start of a new top-level group\n                current_group_start_index = i\n            balance += 1\n        elif char == ')':\n            balance -= 1\n        \n        # If balance returns to 0, we've completed a top-level, balanced group\n        if balance == 0 and char == ')':\n            group_content = cleaned_string[current_group_start_index : i + 1]\n            group = ParenthesesGroup(group_content)\n            if group.is_balanced(): # This check provides robustness, though parsing logic implies balance\n                collection.add(group)\n            \n    return collection.get_group_strings()"}
{"task_id": "HumanEval/10", "solution": "def make_palindrome(string: str) -> str:\n    \"\"\" Find the shortest palindrome that begins with a supplied string.\n    Algorithm idea is simple:\n    - Find the longest postfix of supplied string that is a palindrome.\n    - Append to the end of the string reverse of a string prefix that comes before the palindromic suffix.\n    >>> make_palindrome('')\n    ''\n    >>> make_palindrome('cat')\n    'catac'\n    >>> make_palindrome('cata')\n    'catac'\n    \"\"\"\n    if not string:\n        return \"\"\n\n    longest_pal_postfix_len = 0\n    for i in range(len(string)):\n        postfix = string[i:]\n        if string == string[::-1]: # This calls is_palindrome, but I have it defined above.\n            longest_pal_postfix_len = len(postfix)\n            break\n\n    prefix_to_reverse = string[:len(string) - longest_pal_postfix_len]\n    reversed_prefix = prefix_to_reverse[::-1]\n\n    return string + reversed_prefix"}
{"task_id": "HumanEval/14", "solution": "from typing import List\n\n\ndef all_prefixes(string: str) -> List[str]:\n    \"\"\" Return list of all prefixes from shortest to longest of the input string\n    >>> all_prefixes('abc')\n    ['a', 'ab', 'abc']\n    \"\"\"\n    prefixes = []\n    for i in range(1, len(string) + 1):\n        prefixes.append(string[:i])\n    return prefixes"}
{"task_id": "HumanEval/9", "solution": "from typing import List, Tuple\n\n\ndef rolling_max(numbers: List[int]) -> List[int]:\n    \"\"\" From a given list of integers, generate a list of rolling maximum element found until given moment\n    in the sequence.\n    >>> rolling_max([1, 2, 3, 2, 3, 4, 2])\n    [1, 2, 3, 3, 3, 4, 4]\n    \"\"\"\n    if not numbers:\n        return []\n\n    result = []\n    current_max = float('-inf')\n\n    for number in numbers:\n        if number > current_max:\n            current_max = number\n        result.append(current_max)\n    return result"}
{"task_id": "HumanEval/8", "solution": "from typing import List, Tuple\n\n\ndef sum_product(numbers: List[int]) -> Tuple[int, int]:\n    \"\"\" For a given list of integers, return a tuple consisting of a sum and a product of all the integers in a list.\n    Empty sum should be equal to 0 and empty product should be equal to 1.\n    >>> sum_product([])\n    (0, 1)\n    >>> sum_product([1, 2, 3, 4])\n    (10, 24)\n    \"\"\"\n    current_sum = 0\n    current_product = 1\n\n    if not numbers:\n        return (current_sum, current_product)\n\n    for number in numbers:\n        current_sum += number\n        current_product *= number\n\n    return (current_sum, current_product)"}
{"task_id": "HumanEval/11", "solution": "class BinaryString:\n    \"\"\"Encapsulates a binary string value, ensuring its validity upon creation.\"\"\"\n    def __init__(self, value: str):\n        if not self._validate_content(value):\n            raise ValueError(\"Input string must contain only '0's and '1's.\")\n        self._value = value\n\n    def _validate_content(self, s: str) -> bool:\n        \"\"\"Internal helper to validate content.\"\"\"\n        return all(char in ('0', '1') for char in s)\n\n    def get_value(self) -> str:\n        return self._value\n\n    def get_length(self) -> int:\n        return len(self._value)\n\n\nclass XORProcessor:\n    \"\"\"Provides the core logic for performing a character-by-character binary XOR operation.\"\"\"\n    def perform_xor(self, input_a: BinaryString, input_b: BinaryString) -> BinaryString:\n        result_chars = []\n        for char_a, char_b in zip(input_a.get_value(), input_b.get_value()):\n            if char_a == char_b:\n                result_chars.append('0')\n            else:\n                result_chars.append('1')\n        return BinaryString(\"\".join(result_chars))\n\n\ndef string_xor(a: str, b: str) -> str:\n    \"\"\" Input are two strings a and b consisting only of 1s and 0s.\n    Perform binary XOR on these inputs and return result also as a string.\n    >>> string_xor('010', '110')\n    '100'\n    \"\"\"\n    binary_string_a = BinaryString(a)\n    binary_string_b = BinaryString(b)\n\n    if binary_string_a.get_length() != binary_string_b.get_length():\n        raise ValueError(\"Input strings must be of equal length\")\n\n    xor_processor = XORProcessor()\n    result_binary_string = xor_processor.perform_xor(binary_string_a, binary_string_b)\n    \n    return result_binary_string.get_value()"}
{"task_id": "HumanEval/15", "solution": "def string_sequence(n: int) -> str:\n    \"\"\" Return a string containing space-delimited numbers starting from 0 upto n inclusive.\n    >>> string_sequence(0)\n    '0'\n    >>> string_sequence(5)\n    '0 1 2 3 4 5'\n    \"\"\"\n    return ' '.join(str(i) for i in range(n + 1))"}
{"task_id": "HumanEval/13", "solution": "def greatest_common_divisor(a: int, b: int) -> int:\n    \"\"\" Return a greatest common divisor of two integers a and b\n    >>> greatest_common_divisor(3, 5)\n    1\n    >>> greatest_common_divisor(25, 15)\n    5\n    \"\"\"\n    while b:\n        a, b = b, a % b\n    return a"}
{"task_id": "HumanEval/12", "solution": "def longest(strings: List[str]) -> Optional[str]:\n    \"\"\" Out of list of strings, return the longest one. Return the first one in case of multiple\n    strings of the same length. Return None in case the input list is empty.\n    \"\"\"\n    if not strings:\n        return None\n\n    longest_str = strings[0]\n    max_len = len(strings[0])\n\n    for s in strings[1:]:\n        if len(s) > max_len:\n            longest_str = s\n            max_len = len(s)\n            \n    return longest_str"}
{"task_id": "HumanEval/18", "solution": "def how_many_times(string: str, substring: str) -> int:\n    \"\"\" Find how many times a given substring can be found in the original string. Count overlaping cases.\n    >>> how_many_times('', 'a')\n    0\n    >>> how_many_times('aaa', 'a')\n    3\n    >>> how_many_times('aaaa', 'aa')\n    3\n    \"\"\"\n    count = 0\n    # Iterate through the string, checking for substring matches at each possible starting position.\n    # The loop range ensures that substring can fully fit within the remaining part of the string.\n    for i in range(len(string) - len(substring) + 1):\n        if string[i:i+len(substring)] == substring:\n            count += 1\n    return count"}
{"task_id": "HumanEval/16", "solution": "def count_distinct_characters(string: str) -> int:\n    \"\"\" Given a string, find out how many distinct characters (regardless of case) does it consist of.\n    This is achieved by storing lowercase versions of characters in a set.\n    \"\"\"\n    unique_chars = set()\n    for char in string:\n        unique_chars.add(char.lower())\n    return len(unique_chars)"}
{"task_id": "HumanEval/19", "solution": "from typing import List\n\n\nclass NumberWordMapping:\n    \"\"\"Provides bidirectional mapping between number words and their integer values.\"\"\"\n\n    def __init__(self):\n        \"\"\"Initializes the constant word-to-value and value-to-word mappings.\"\"\"\n        self._word_to_value = {\n            'zero': 0, 'one': 1, 'two': 2, 'three': 3, 'four': 4,\n            'five': 5, 'six': 6, 'seven': 7, 'eight': 8, 'nine': 9\n        }\n        self._value_to_word = {\n            0: 'zero', 1: 'one', 2: 'two', 3: 'three', 4: 'four',\n            5: 'five', 6: 'six', 7: 'seven', 8: 'eight', 9: 'nine'\n        }\n\n    def get_value(self, word: str) -> int:\n        \"\"\"Returns the integer value for a given number word.\"\"\"\n        return self._word_to_value[word]\n\n    def get_word(self, value: int) -> str:\n        \"\"\"Returns the number word for a given integer value.\"\"\"\n        return self._value_to_word[value]\n\n\ndef _parse_input_string(input_string: str) -> List[str]:\n    \"\"\"Splits the input string into a list of individual number words.\"\"\"\n    return input_string.split(' ')\n\n\ndef _map_words_to_values(words: List[str], mapping_instance: NumberWordMapping) -> List[int]:\n    \"\"\"Converts a list of number words to a list of their corresponding integer values.\"\"\"\n    return [mapping_instance.get_value(word) for word in words]\n\n\ndef _sort_values(values: List[int]) -> List[int]:\n    \"\"\"Sorts a list of integer values in ascending order.\"\"\"\n    return sorted(values)\n\n\ndef _map_values_to_words(values: List[int], mapping_instance: NumberWordMapping) -> List[str]:\n    \"\"\"Converts a list of integer values back to a list of their corresponding number words.\"\"\"\n    return [mapping_instance.get_word(value) for value in values]\n\n\ndef _join_words(words: List[str]) -> str:\n    \"\"\"Concatenates a list of words into a single space-delimited string.\"\"\"\n    return ' '.join(words)\n\n\ndef sort_numbers(numbers: str) -> str:\n    \"\"\" Input is a space-delimited string of numberals from 'zero' to 'nine'.\n    Valid choices are 'zero', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight' and 'nine'.\n    Return the string with numbers sorted from smallest to largest\n    >>> sort_numbers('three one five')\n    'one three five'\n    \"\"\"\n    number_word_mapping = NumberWordMapping()\n\n    words = _parse_input_string(numbers)\n    values = _map_words_to_values(words, number_word_mapping)\n    sorted_values = _sort_values(values)\n    sorted_words = _map_values_to_words(sorted_values, number_word_mapping)\n    return _join_words(sorted_words)"}
{"task_id": "HumanEval/20", "solution": "def find_closest_elements(numbers: List[float]) -> Tuple[float, float]:\n    \"\"\" From a supplied list of numbers (of length at least two) select and return two that are the closest to each\n    other and return them in order (smaller number, larger number).\n    \"\"\"\n    sorted_numbers = sorted(numbers)\n    min_diff = float('inf')\n    closest_pair = (0.0, 0.0) # Placeholder, will be updated immediately\n\n    for i in range(len(sorted_numbers) - 1):\n        num1 = sorted_numbers[i]\n        num2 = sorted_numbers[i + 1]\n        current_diff = num2 - num1\n\n        if current_diff < min_diff:\n            min_diff = current_diff\n            closest_pair = (num1, num2)\n\n    return closest_pair"}
