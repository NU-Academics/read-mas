{"task_id": "HumanEval/2", "solution": "import math\n\ndef truncate_number(number: float) -> float:\n    \"\"\" Given a positive floating point number, it can be decomposed into\n    and integer part (largest integer smaller than given number) and decimals\n    (leftover part always smaller than 1).\n\n    Return the decimal part of the number.\n    >>> truncate_number(3.5)\n    0.5\n    \"\"\"\n    frac = number - math.floor(number)\n    # Adjust for potential floating point inaccuracies near 1.0\n    if abs(frac - 1.0) < 1e-12:\n        return 0.0\n    return frac"}
{"task_id": "HumanEval/0", "solution": "def has_close_elements(numbers: List[float], threshold: float) -> bool:\n    \"\"\" Check if in given list of numbers, are any two numbers closer to each other than\n    given threshold.\n    \"\"\"\n    if len(numbers) < 2:\n        return False\n\n    # Sort the numbers to efficiently check adjacent pairs.\n    # If two numbers are close, they will be adjacent after sorting.\n    sorted_numbers = sorted(numbers)\n\n    # Iterate through adjacent pairs and check their absolute difference.\n    for i in range(len(sorted_numbers) - 1):\n        if abs(sorted_numbers[i+1] - sorted_numbers[i]) < threshold:\n            return True\n    return False"}
{"task_id": "HumanEval/1", "solution": "from typing import List\n\n\ndef separate_paren_groups(paren_string: str) -> List[str]:\n    \"\"\"Separates a string of nested parentheses into a list of balanced top-level group strings, ignoring spaces.\"\"\"\n    result: List[str] = []\n    current_group_chars: List[str] = []\n    balance: int = 0\n\n    for char in paren_string:\n        if char.isspace():\n            continue\n\n        if char == '(':\n            if balance == 0:\n                current_group_chars = []\n            current_group_chars.append(char)\n            balance += 1\n        elif char == ')':\n            if balance > 0:\n                current_group_chars.append(char)\n                balance -= 1\n                if balance == 0:\n                    result.append(\"\".join(current_group_chars))\n        # Other characters are implicitly ignored, as per problem context and \"Do NOT raise exceptions\" constraint.\n    \n    return result"}
{"task_id": "HumanEval/1", "solution": "from typing import List\n\n\nclass ParenSplitterError(Exception):\n    \"\"\"Base exception for parenthesis splitting operations.\"\"\"\n    pass\n\n\nclass InvalidCharacterError(ParenSplitterError):\n    \"\"\"Raised when an invalid character is found in the input string.\"\"\"\n    def __init__(self, char: str, index: int) -> None:\n        super().__init__(f\"Invalid character '{char}' at index {index}\")\n        self.char = char\n        self.index = index\n\n\nclass UnbalancedParenthesesError(ParenSplitterError):\n    \"\"\"Raised when parentheses are unbalanced in the input string.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n\n\nclass Token:\n    \"\"\"Represents a parenthesis character and its original index.\"\"\"\n    def __init__(self, char: str, index: int) -> None:\n        self.char = char\n        self.index = index\n\n\nclass ParenGroup:\n    \"\"\"Represents a balanced group of parentheses with its canonical text.\"\"\"\n    def __init__(self, start_index: int, end_index: int, original: str) -> None:\n        self._start_index = start_index\n        self._end_index = end_index\n        self._text = \"\".join(ch for ch in original[start_index : end_index + 1] if ch != \" \")\n\n    def to_str(self) -> str:\n        \"\"\"Returns the canonical text of the parenthesis group.\"\"\"\n        return self._text\n\n\nclass Tokenizer:\n    \"\"\"Validates and tokenizes the input string into parenthesis tokens.\"\"\"\n    ALLOWED_CHARS = set(\"() \")\n\n    def tokenize(self, s: str) -> List[Token]:\n        tokens: List[Token] = []\n        for i, ch in enumerate(s):\n            if ch == \" \":\n                continue\n            if ch not in self.ALLOWED_CHARS:\n                raise InvalidCharacterError(ch, i)\n            tokens.append(Token(ch, i))\n        return tokens\n\n\nclass GroupFinder:\n    \"\"\"Identifies top-level balanced parenthesis groups from tokens.\"\"\"\n    def find_groups(self, tokens: List[Token], original: str) -> List[ParenGroup]:\n        groups: List[ParenGroup] = []\n        depth = 0\n        group_start_original_index = -1 \n        \n        for token in tokens:\n            if token.char == \"(\":\n                if depth == 0:\n                    group_start_original_index = token.index\n                depth += 1\n            else:  # token.char == \")\"\n                depth -= 1\n                if depth < 0:\n                    raise UnbalancedParenthesesError(\"Extra closing parenthesis\")\n                if depth == 0:  # End of a top-level group\n                    group_end_original_index = token.index\n                    groups.append(ParenGroup(group_start_original_index, group_end_original_index, original))\n                    group_start_original_index = -1  # Reset for the next group\n\n        if depth != 0:\n            raise UnbalancedParenthesesError(\"Unclosed parenthesis\")\n        return groups\n\n\nclass ParserService:\n    \"\"\"Orchestrates tokenization and group finding to separate parenthesis groups.\"\"\"\n    def __init__(self, tokenizer: Tokenizer, finder: GroupFinder) -> None:\n        self.tokenizer = tokenizer\n        self.finder = finder\n\n    def separate(self, paren_string: str) -> List[str]:\n        \"\"\"Separates an input string into a list of balanced parenthesis groups.\"\"\"\n        tokens = self.tokenizer.tokenize(paren_string)\n        groups = self.finder.find_groups(tokens, paren_string)\n        return [g.to_str() for g in groups]\n\n\ndef separate_paren_groups(paren_string: str) -> List[str]:\n    \"\"\" Separates groups of nested parentheses in a string into a list of individual group strings.\n    Each group is balanced and top-level. Spaces are ignored.\n    \"\"\"\n    service = ParserService(Tokenizer(), GroupFinder())\n    return service.separate(paren_string)"}
{"task_id": "HumanEval/2", "solution": "import math\n\ndef truncate_number(number: float) -> float:\n    \"\"\"Given a positive floating point number, return its decimal part. This is the leftover part after removing the largest integer smaller than the number.\"\"\"\n    EPSILON = 1e-12 # Tolerance for floating-point comparisons.\n\n    integer_part = math.floor(number)\n    decimal = number - integer_part\n\n    # Adjust for floating point inaccuracies\n    if decimal < EPSILON:\n        decimal = 0.0\n    # If the decimal part is extremely close to 1.0 due to float arithmetic,\n    # it's considered to be 0.0, implying the number was effectively an integer.\n    if decimal + EPSILON >= 1.0:\n        decimal = 0.0\n\n    return float(decimal)"}
{"task_id": "HumanEval/4", "solution": "def mean_absolute_deviation(numbers: List[float]) -> float:\n    \"\"\" For a given list of input numbers, calculate Mean Absolute Deviation\n    around the mean of this dataset.\n    Mean Absolute Deviation is the average absolute difference between each\n    element and a centerpoint (mean in this case):\n    MAD = average | x - x_mean |\n    >>> mean_absolute_deviation([1.0, 2.0, 3.0, 4.0])\n    1.0\n    \"\"\"\n    if not numbers:\n        # According to design context, this should raise InvalidDataError.\n        # But per prompt, DO NOT add isinstance() checks or raise exceptions.\n        # Assuming valid non-empty list based on design's preconditions.\n        return 0.0 # Or handle as a specific case if not forbidden.\n                   # For MAD, an empty list has no mean, so this is undefined.\n                   # However, the prompt states \"assume valid input\".\n    \n    n = len(numbers)\n    mean = sum(numbers) / n\n    \n    absolute_deviations = [abs(x - mean) for x in numbers]\n    \n    mad = sum(absolute_deviations) / n\n    \n    return mad"}
{"task_id": "HumanEval/4", "solution": "def mean_absolute_deviation(numbers: List[float]) -> float:\n    \"\"\" For a given list of input numbers, calculate Mean Absolute Deviation\n    around the mean of this dataset.\n    Mean Absolute Deviation is the average absolute difference between each\n    element and a centerpoint (mean in this case):\n    MAD = average | x - x_mean |\n    >>> mean_absolute_deviation([1.0, 2.0, 3.0, 4.0])\n    1.0\n    \"\"\"\n    # Calculate the arithmetic mean of the dataset.\n    data_mean = sum(numbers) / len(numbers)\n\n    # Calculate the absolute difference of each number from the mean.\n    absolute_deviations = [abs(number - data_mean) for number in numbers]\n\n    # The Mean Absolute Deviation is the average of these absolute differences.\n    mad = sum(absolute_deviations) / len(absolute_deviations)\n\n    return mad"}
{"task_id": "HumanEval/5", "solution": "def intersperse(numbers: List[int], delimeter: int) -> List[int]:\n    \"\"\" Insert a number 'delimeter' between every two consecutive elements of input list `numbers' \"\"\"\n    n = len(numbers)\n    if n <= 1:\n        return list(numbers)  # Return a copy for consistency/immutability\n\n    # The result list will have 2*n - 1 elements\n    # numbers take n positions, delimeters take n-1 positions\n    out: List[int] = [0] * (2 * n - 1)\n\n    # Place original numbers at even indices (0, 2, 4, ...)\n    out[0::2] = numbers\n\n    # Place delimeters at odd indices (1, 3, 5, ...)\n    out[1::2] = [delimeter] * (n - 1)\n\n    return out"}
{"task_id": "HumanEval/6", "solution": "def parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\"\n    Computes the maximum nesting depth for each group of parentheses in the input string.\n    Groups are separated by spaces.\n    \"\"\"\n    groups = [group for group in paren_string.split(' ') if group]\n    \n    result_depths = []\n    for group in groups:\n        current_depth = 0\n        max_group_depth = 0\n        for char in group:\n            if char == '(':\n                current_depth += 1\n                max_group_depth = max(max_group_depth, current_depth)\n            elif char == ')':\n                current_depth -= 1\n        result_depths.append(max_group_depth)\n        \n    return result_depths"}
{"task_id": "HumanEval/6", "solution": "def parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\" Input to this function is a string represented multiple groups for nested parentheses separated by spaces.\n    For each of the group, output the deepest level of nesting of parentheses.\n    E.g. (()()) has maximum two levels of nesting while ((())) has three.\n    \"\"\"\n    results = []\n    # Split the input string into groups by whitespace, filtering out empty strings.\n    groups = paren_string.split()\n\n    for group in groups:\n        current_depth = 0\n        max_depth = 0\n        for char in group:\n            if char == '(':\n                current_depth += 1\n                if current_depth > max_depth:\n                    max_depth = current_depth\n            elif char == ')':\n                current_depth -= 1\n        results.append(max_depth)\n    return results"}
{"task_id": "HumanEval/7", "solution": "```python\nfrom typing import List\n\n\ndef filter_by_substring(strings: List[str], substring: str) -> List[str]:\n    \"\"\" Filter an input list of strings only for ones that contain given substring\n    >>> filter_by_substring([], 'a')\n    []\n    >>> filter_by_substring(['abc', 'bacd', 'cde', 'array'], 'a')\n    ['abc', 'bacd', 'array']\n    \"\"\"\n    if not substring:\n        return list(strings)\n\n    result = []\n    for s in strings:\n        if substring in s:\n            result.append(s)\n    return result\n```"}
{"task_id": "HumanEval/8", "solution": "def sum_product(numbers: List[int]) -> Tuple[int, int]:\n    \"\"\" For a given list of integers, return a tuple consisting of a sum and a product of all the integers in a list.\n    Empty sum should be equal to 0 and empty product should be equal to 1.\n    \"\"\"\n    current_sum = 0\n    current_product = 1\n\n    for number in numbers:\n        current_sum += number\n        current_product *= number\n\n    return (current_sum, current_product)"}
