{"task_id": "HumanEval/67", "solution": "import re\n\ndef fruit_distribution(s,n):\n    \"\"\"\n    Calculates the number of mango fruits in a basket given a string describing\n    apples and oranges, and the total number of fruits.\n    \"\"\"\n    pattern = r\"(?P<apples>\\d+)\\s*apples?\\s*and\\s*(?P<oranges>\\d+)\\s*oranges?\"\n    match = re.search(pattern, s, re.IGNORECASE)\n\n    if not match:\n        # Based on the problem examples, the input string format is consistent\n        # and parsing is expected to always succeed. No error handling for\n        # unparsable strings is explicitly required by the problem statement\n        # for this direct function implementation.\n        # However, for robustness, if this were a standalone parse, one might\n        # raise an error or return a default. Given the context, we assume a match.\n        # For simplicity and adhering to \"Return ONLY the bare function\",\n        # we'll proceed assuming a match based on the examples.\n        # If no match, a ValueError would be appropriate, but let's assume valid input for completion.\n        # Fallback to 0 apples/oranges if no match? The problem examples imply\n        # it will always match. Let's just raise an error as a safety for unexpected inputs.\n        # The prompt says \"DO NOT add ... raise exceptions for edge cases\"\n        # so I should assume the input 's' will always conform to the pattern.\n        # In this context, if no match, it would be an unexpected input format,\n        # but the examples do not cover it.\n        # Let's extract values assuming a match will always be found as per examples.\n        pass # This path implies an issue, but no exception to be raised as per instructions.\n\n    apples = int(match.group(\"apples\"))\n    oranges = int(match.group(\"oranges\"))\n\n    mangoes = n - apples - oranges\n    return mangoes"}
{"task_id": "HumanEval/68", "solution": "def pluck(arr):\n    \"\"\"\n    Finds the node with the smallest even value. If multiple such nodes exist,\n    returns the one with the smallest index, or an empty list if no even values are found.\n    \"\"\"\n    smallest_even_value = None\n    smallest_even_index = -1\n\n    for i, value in enumerate(arr):\n        if value % 2 == 0:  # Check if the value is even\n            if smallest_even_value is None or \\\n               value < smallest_even_value or \\\n               (value == smallest_even_value and i < smallest_even_index):\n                \n                smallest_even_value = value\n                smallest_even_index = i\n    \n    if smallest_even_value is None:\n        return []\n    else:\n        return [smallest_even_value, smallest_even_index]"}
{"task_id": "HumanEval/67", "solution": "import re\n\ndef fruit_distribution(s, n):\n    \"\"\"\n    Calculates the number of mango fruits in a basket given a string of apples\n    and oranges, and the total number of fruits.\n    \"\"\"\n\n    class ParseError(Exception):\n        \"\"\"Custom exception for parsing failures.\"\"\"\n        def __init__(self, message: str):\n            self.message = message\n            super().__init__(self.message)\n\n    class InvalidInputError(Exception):\n        \"\"\"Custom exception for invalid input values.\"\"\"\n        def __init__(self, message: str):\n            self.message = message\n            super().__init__(self.message)\n\n    class FruitCountDTO:\n        \"\"\"Data Transfer Object for parsed fruit counts.\"\"\"\n        def __init__(self, apples: int, oranges: int) -> None:\n            if apples < 0 or oranges < 0:\n                raise InvalidInputError(\"Counts must be non-negative\")\n            self.apples: int = apples\n            self.oranges: int = oranges\n\n        def total(self) -> int:\n            return self.apples + self.oranges\n\n    class StringUtils:\n        \"\"\"Utility methods for string manipulation.\"\"\"\n        @staticmethod\n        def normalize(text: str) -> str:\n            return re.sub(r\"[^\\w\\s-]\", \" \", text.lower()).strip()\n\n        @staticmethod\n        def extract_integers(text: str) -> list[int]:\n            return [int(x) for x in re.findall(r\"-?\\d+\", text)]\n\n    class FruitStringParser:\n        \"\"\"Parses a string to extract fruit counts.\"\"\"\n        def parse(self, text: str) -> FruitCountDTO:\n            txt = StringUtils.normalize(text)\n            apples = self._find_number_for_word(txt, \"apple\")\n            oranges = self._find_number_for_word(txt, \"orange\")\n\n            if apples is None or oranges is None:\n                # fallback: first two numbers map to apples, oranges\n                nums = StringUtils.extract_integers(txt)\n                if len(nums) >= 2:\n                    apples, oranges = nums[0], nums[1]\n                else:\n                    raise ParseError(\"Could not parse apples and oranges counts\")\n            return FruitCountDTO(int(apples), int(oranges))\n\n        def _find_number_for_word(self, text: str, word: str) -> int | None:\n            m = re.search(r\"(\\d+)\\s+\" + re.escape(word), text)\n            return int(m.group(1)) if m else None\n\n    class FruitDistributionService:\n        \"\"\"Business logic for fruit distribution computation.\"\"\"\n        def validate_inputs(self, total: int, dto: FruitCountDTO) -> None:\n            if total < 0:\n                raise InvalidInputError(\"Total must be >= 0\")\n            # FruitCountDTO's constructor already ensures its internal counts are non-negative.\n\n        def compute_mango(self, total: int, dto: FruitCountDTO) -> int:\n            self.validate_inputs(total, dto)\n            return total - dto.total()\n\n    # Main function logic\n    parser = FruitStringParser()\n    service = FruitDistributionService()\n\n    dto = parser.parse(s)\n    mango_count = service.compute_mango(n, dto)\n    return mango_count"}
{"task_id": "HumanEval/68", "solution": "def pluck(arr):\n    \"\"\"\n    Finds the smallest even-valued node and its smallest index in the array.\n    Returns [value, index] or [] if no even values are found.\n    \"\"\"\n    best_value = None\n    best_index = -1\n\n    for i, v in enumerate(arr):\n        if v % 2 == 0:  # Check if the value is even\n            if best_value is None or v < best_value:\n                best_value = v\n                best_index = i\n\n    if best_value is None:\n        return []\n    else:\n        return [best_value, best_index]"}
{"task_id": "HumanEval/69", "solution": "from collections import Counter\n\ndef search(lst):\n    # Calculate frequency of each number in the list.\n    freq_map = Counter(lst)\n\n    # Collect numbers that satisfy the condition: frequency >= value and value > 0.\n    candidates = []\n    for value, count in freq_map.items():\n        if value > 0 and count >= value:\n            candidates.append(value)\n\n    # Return the greatest valid integer, or -1 if no such integer exists.\n    if candidates:\n        return max(candidates)\n    else:\n        return -1"}
{"task_id": "HumanEval/69", "solution": "def search(lst):\n    \"\"\"\n    Finds the greatest integer whose frequency in the list is greater than or equal to its value.\n    Returns -1 if no such integer exists.\n    \"\"\"\n    freqs = {}\n    for x in lst:\n        freqs[x] = freqs.get(x, 0) + 1\n\n    best_val = -1\n\n    for val, count in freqs.items():\n        # Check if the integer is positive and its frequency meets the condition.\n        if val > 0 and count >= val:\n            # If it's a candidate and greater than the current best, update best_val.\n            if val > best_val:\n                best_val = val\n                \n    return best_val"}
{"task_id": "HumanEval/70", "solution": "def strange_sort_list(lst):\n    \"\"\"\n    Given list of integers, return list in strange order.\n    Strange sorting, is when you start with the minimum value,\n    then maximum of the remaining integers, then minimum and so on.\n    \"\"\"\n    if not lst:\n        return []\n\n    sorted_lst = sorted(lst)\n    result = []\n    left, right = 0, len(sorted_lst) - 1\n    toggle = True\n\n    while left <= right:\n        if toggle:\n            result.append(sorted_lst[left])\n            left += 1\n        else:\n            result.append(sorted_lst[right])\n            right -= 1\n        toggle = not toggle\n    return result"}
{"task_id": "HumanEval/71", "solution": "import math\n\ndef triangle_area(a, b, c):\n    \"\"\"\n    Given the lengths of the three sides of a triangle. Return the area of\n    the triangle rounded to 2 decimal points if the three sides form a valid triangle. \n    Otherwise return -1\n    \"\"\"\n    if not (a > 0 and b > 0 and c > 0):\n        return -1\n    \n    if not ((a + b > c) and (a + c > b) and (b + c > a)):\n        return -1\n\n    s = (a + b + c) / 2\n    \n    # Heron's formula argument might be slightly negative due to floating point inaccuracies\n    # for nearly degenerate triangles (e.g., a+b=c).\n    # We round it to 0 if it's a very small negative number to avoid math domain error.\n    # The design context explicitly mentions returning -1 for numerical errors,\n    # so if the value under sqrt is truly negative (not just precision error close to 0),\n    # it implies an invalid triangle scenario.\n    heron_val = s * (s - a) * (s - b) * (s - c)\n\n    # If heron_val is slightly negative due to floating point precision for valid triangles, treat as 0.\n    # Otherwise, if it's truly negative (e.g., -1e-5), it means an invalid triangle.\n    # The design states to return -1 for numerical errors (like negative under sqrt).\n    if heron_val < 0:\n        return -1\n        \n    area = math.sqrt(heron_val)\n    return round(area, 2)"}
{"task_id": "HumanEval/70", "solution": "def strange_sort_list(lst):\n    '''\n    Given list of integers, return list in strange order.\n    Strange sorting, is when you start with the minimum value,\n    then maximum of the remaining integers, then minimum and so on.\n\n    Examples:\n    strange_sort_list([1, 2, 3, 4]) == [1, 4, 2, 3]\n    strange_sort_list([5, 5, 5, 5]) == [5, 5, 5, 5]\n    strange_sort_list([]) == []\n    '''\n    if not lst:\n        return []\n\n    # Sort the list to easily pick minimum and maximum elements.\n    sorted_lst = sorted(lst)\n    \n    result = []\n    left = 0\n    right = len(sorted_lst) - 1\n    \n    # Alternate appending from the left (min) and right (max) pointers.\n    while left <= right:\n        result.append(sorted_lst[left])\n        left += 1\n        # If elements remain, append the maximum from the right.\n        if left <= right:\n            result.append(sorted_lst[right])\n            right -= 1\n            \n    return result"}
{"task_id": "HumanEval/72", "solution": "def will_it_fly(q,w):\n    \"\"\"\n    Checks if the object q will fly. It flies if balanced (palindromic) and its sum is <= w.\n    \"\"\"\n    is_balanced = q == list(reversed(q))\n    total_weight = sum(q)\n    return is_balanced and (total_weight <= w)"}
{"task_id": "HumanEval/71", "solution": "import math\n\ndef triangle_area(a, b, c):\n    \"\"\"\n    Given the lengths of the three sides of a triangle. Return the area of\n    the triangle rounded to 2 decimal points if the three sides form a valid triangle. \n    Otherwise return -1\n    \"\"\"\n    # Validate if the three sides form a valid triangle\n    # All sides must be positive\n    if not (a > 0 and b > 0 and c > 0):\n        return -1\n    \n    # Triangle inequality theorem: sum of any two sides must be greater than the third side\n    if not (a + b > c and a + c > b and b + c > a):\n        return -1\n\n    # Calculate the semi-perimeter\n    s = (a + b + c) / 2.0\n\n    # Calculate the area using Heron's formula\n    radicand = s * (s - a) * (s - b) * (s - c)\n\n    # Handle potential floating-point inaccuracies where radicand might be slightly negative\n    # For nearly degenerate triangles, treat a very small negative radicand as zero.\n    if radicand < 0 and abs(radicand) < 1e-12:\n        radicand = 0.0\n    elif radicand < 0:\n        # If radicand is still significantly negative, it indicates an invalid geometric configuration\n        # not caught by the initial checks, or a numerical issue. Return -1 as per requirements.\n        return -1\n\n    area = math.sqrt(radicand)\n\n    # Round the area to 2 decimal points\n    return round(area, 2)"}
{"task_id": "HumanEval/72", "solution": "def will_it_fly(q,w):\n    \"\"\"\n    Checks if an object (list q) will fly based on two conditions:\n    1. It is balanced (a palindromic list).\n    2. The sum of its elements is less than or equal to the maximum possible weight w.\n    \"\"\"\n    is_balanced = (q == q[::-1])\n    is_within_weight_limit = (sum(q) <= w)\n    return is_balanced and is_within_weight_limit"}
{"task_id": "HumanEval/73", "solution": "def smallest_change(arr):\n    \"\"\"\n    Finds the minimum number of elements that need to be changed to make the array palindromic.\n    This uses a two-pointer approach, comparing elements from both ends of the array.\n    \"\"\"\n    n = len(arr)\n    left = 0\n    right = n - 1\n    changes = 0\n\n    while left < right:\n        if arr[left] != arr[right]:\n            changes += 1\n        left += 1\n        right -= 1\n    return changes"}
{"task_id": "HumanEval/74", "solution": "def total_match(lst1, lst2):\n    \"\"\"\n    Compares two lists of strings based on their total character count.\n    Returns the list with fewer total characters, or the first list if counts are equal.\n    \"\"\"\n    total_chars_lst1 = sum(len(s) for s in lst1)\n    total_chars_lst2 = sum(len(s) for s in lst2)\n\n    if total_chars_lst1 <= total_chars_lst2:\n        return lst1\n    else:\n        return lst2"}
