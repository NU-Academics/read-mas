{"task_id": "HumanEval/136", "solution": "def largest_smallest_integers(lst):\n    \"\"\"\n    Finds the largest negative integer and smallest positive integer in a list.\n    Returns (largest_negative, smallest_positive), using None if no such integers exist.\n    \"\"\"\n    largest_neg = None\n    smallest_pos = None\n\n    for x in lst:\n        if x < 0:\n            if largest_neg is None or x > largest_neg:\n                largest_neg = x\n        elif x > 0:\n            if smallest_pos is None or x < smallest_pos:\n                smallest_pos = x\n\n    return (largest_neg, smallest_pos)"}
{"task_id": "HumanEval/136", "solution": "def largest_smallest_integers(lst):\n    \"\"\"\n    Finds the largest negative and smallest positive integers in a list.\n    Returns (largest_negative, smallest_positive) or None for missing categories.\n    \"\"\"\n    largest_negative = None\n    smallest_positive = None\n\n    for num in lst:\n        if num < 0:\n            if largest_negative is None or num > largest_negative:\n                largest_negative = num\n        elif num > 0:\n            if smallest_positive is None or num < smallest_positive:\n                smallest_positive = num\n\n    return (largest_negative, smallest_positive)"}
{"task_id": "HumanEval/137", "solution": "FLOAT_TOLERANCE = 1e-9\n\ndef _parse_input_to_numeric_and_original(value):\n    \"\"\"Parses an input value into its numeric (float) representation and preserves its original form.\"\"\"\n    if isinstance(value, (int, float)):\n        return float(value), value\n    elif isinstance(value, str):\n        normalized_s = value.strip().replace(',', '.')\n        numeric_value = float(normalized_s)\n        return numeric_value, value\n    # Per constraints, input types will be int, float, or str and strings will be parseable.\n\ndef compare_one(a, b):\n    \"\"\"\n    Compares two values (int, float, or string representations of real numbers)\n    and returns the larger value in its original type. Returns None if equal.\n    \"\"\"\n    a_numeric, a_original = _parse_input_to_numeric_and_original(a)\n    b_numeric, b_original = _parse_input_to_numeric_and_original(b)\n\n    diff = a_numeric - b_numeric\n\n    if abs(diff) <= FLOAT_TOLERANCE:\n        return None\n    elif diff > 0:\n        return a_original\n    else:\n        return b_original"}
{"task_id": "HumanEval/137", "solution": "class ParsingError(Exception):\n    \"\"\"Custom exception for errors during number parsing.\"\"\"\n    def __init__(self, message: str, original_value: object | None = None) -> None:\n        super().__init__(message)\n        self.message = message\n        self.original_value = original_value\n\nclass NumberValue:\n    \"\"\"Represents a parsed numeric input, preserving its original form.\"\"\"\n    def __init__(self, original: object, original_type: str, normalized_text: str | None, numeric_value: float) -> None:\n        self.original = original\n        self.original_type = original_type\n        self.normalized_text = normalized_text\n        self.numeric_value = numeric_value\n\n    def as_original(self) -> object:\n        \"\"\"Returns the original input value.\"\"\"\n        return self.original\n\ndef normalize_decimal_separator(s: str) -> str:\n    \"\"\"Normalizes string decimal separators from ',' to '.'.\"\"\"\n    s = s.strip()\n    return s.replace(',', '.')\n\ndef is_numeric_string(s: str) -> bool:\n    \"\"\"Checks if a string represents a valid numeric value.\"\"\"\n    if not s:\n        return False\n\n    temp_s = s\n    if temp_s[0] in ('+', '-'):\n        temp_s = temp_s[1:]\n        if not temp_s: # String was just a sign, e.g., \"+\", \"-\"\n            return False\n\n    parts = temp_s.split('.')\n    if len(parts) > 2: # More than one decimal point\n        return False\n    \n    # All parts must be digits\n    for part in parts:\n        if not part.isdigit():\n            return False\n            \n    # String must contain at least one digit\n    return any(c.isdigit() for c in s)\n\nclass NumberParser:\n    \"\"\"Parses various input types into NumberValue objects.\"\"\"\n    def parse(self, value: object) -> NumberValue:\n        if isinstance(value, int):\n            return NumberValue(value, 'int', None, float(value))\n        if isinstance(value, float):\n            return NumberValue(value, 'float', None, float(value))\n        if isinstance(value, str):\n            s = value.strip()\n            normalized = normalize_decimal_separator(s)\n            \n            if not normalized: # Handle cases like \" \" or \",\" after strip/normalize\n                raise ParsingError(f\"Cannot parse empty or invalid string after normalization: '{value}'\", original_value=value)\n\n            if not is_numeric_string(normalized):\n                raise ParsingError(f\"Cannot parse numeric string: '{value}'\", original_value=value)\n            try:\n                numeric = float(normalized)\n            except ValueError:\n                raise ParsingError(f\"Cannot convert string to float: '{value}'\", original_value=value)\n            return NumberValue(value, 'str', s, numeric)\n        raise ParsingError(f\"Unsupported type: {type(value).__name__}\", original_value=value)\n\nclass ComparatorService:\n    \"\"\"Compares two numeric inputs using a NumberParser.\"\"\"\n    def __init__(self, parser: NumberParser) -> None:\n        self._parser = parser\n\n    def compare(self, a_val: object, b_val: object) -> object | None:\n        na = self._parser.parse(a_val)\n        nb = self._parser.parse(b_val)\n        cmp_result = self._compare_values(na, nb)\n        if cmp_result > 0:\n            return na.as_original()\n        if cmp_result < 0:\n            return nb.as_original()\n        return None\n\n    def _compare_values(self, na: NumberValue, nb: NumberValue) -> int:\n        if na.numeric_value > nb.numeric_value:\n            return 1\n        if na.numeric_value < nb.numeric_value:\n            return -1\n        return 0\n\ndef compare_one(a, b):\n    \"\"\"\n    Compares two values (int, float, or string representations of real numbers)\n    and returns the larger input in its original type, or None if equal.\n    \"\"\"\n    parser = NumberParser()\n    service = ComparatorService(parser)\n    return service.compare(a, b)"}
