{"task_id": "HumanEval/9", "solution": "def rolling_max(numbers: List[int]) -> List[int]:\n    \"\"\" From a given list of integers, generate a list of rolling maximum element found until given moment\n    in the sequence.\n    >>> rolling_max([1, 2, 3, 2, 3, 4, 2])\n    [1, 2, 3, 3, 3, 4, 4]\n    \"\"\"\n    result: List[int] = []\n    current_max: int | None = None\n    for x in numbers:\n        if current_max is None or x > current_max:\n            current_max = x\n        result.append(current_max)\n    return result"}
{"task_id": "HumanEval/10", "solution": "```python\ndef make_palindrome(string: str) -> str:\n    \"\"\" Find the shortest palindrome that begins with a supplied string.\n    Algorithm idea is simple:\n    - Find the longest postfix of supplied string that is a palindrome.\n    - Append to the end of the string reverse of a string prefix that comes before the palindromic suffix.\n    >>> make_palindrome('')\n    ''\n    >>> make_palindrome('cat')\n    'catac'\n    >>> make_palindrome('cata')\n    'catac'\n    \"\"\"\n    n = len(string)\n    if n == 0:\n        return \"\"\n\n    for i in range(n):\n        suffix = string[i:]\n        if suffix == suffix[::-1]:\n            prefix_to_reverse = string[:i]\n            return string + prefix_to_reverse[::-1]\n    \n    # This case should ideally be covered by the loop as a single character is always a palindrome.\n    # However, as a fallback, mirror all but the last character.\n    return string + string[:-1][::-1]\n```"}
{"task_id": "HumanEval/11", "solution": "def string_xor(a: str, b: str) -> str:\n    \"\"\" Input are two strings a and b consisting only of 1s and 0s.\n    Perform binary XOR on these inputs and return result also as a string.\n    >>> string_xor('010', '110')\n    '100'\n    \"\"\"\n    return ''.join('1' if char_a != char_b else '0' for char_a, char_b in zip(a, b))"}
{"task_id": "HumanEval/10", "solution": "def is_palindrome(string: str) -> bool:\n    \"\"\" Test if given string is a palindrome \"\"\"\n    return string == string[::-1]\n\n\ndef make_palindrome(string: str) -> str:\n    \"\"\" Find the shortest palindrome that begins with a supplied string.\n    Algorithm idea is simple:\n    - Find the longest postfix of supplied string that is a palindrome.\n    - Append to the end of the string reverse of a string prefix that comes before the palindromic suffix.\n    >>> make_palindrome('')\n    ''\n    >>> make_palindrome('cat')\n    'catac'\n    >>> make_palindrome('cata')\n    'catac'\n    \"\"\"\n    for i in range(len(string)):\n        if is_palindrome(string[i:]):\n            # string[i:] is the longest palindromic suffix.\n            # string[:i] is the prefix that comes before it.\n            # Append the reverse of string[:i] to the original string.\n            return string + string[:i][::-1]\n    \n    # This line should theoretically not be reached for non-empty strings\n    # because the empty string is always a palindrome (string[len(string):] is '').\n    # For an empty input string, the loop for i=0 would find string[0:] == '' as a palindrome.\n    # So it handles the empty string correctly.\n    return string"}
{"task_id": "HumanEval/12", "solution": "def longest(strings: List[str]) -> Optional[str]:\n    \"\"\"Out of list of strings, return the longest one. Return the first one in case of multiple\n    strings of the same length. Return None in case the input list is empty.\n    \"\"\"\n    if not strings:\n        return None\n\n    current_longest = strings[0]\n    max_length = len(current_longest)\n\n    for s in strings[1:]:\n        if len(s) > max_length:\n            current_longest = s\n            max_length = len(s)\n            \n    return current_longest"}
{"task_id": "HumanEval/13", "solution": "def greatest_common_divisor(a: int, b: int) -> int:\n    \"\"\" Return a greatest common divisor of two integers a and b.\n    Uses the Euclidean algorithm.\n    >>> greatest_common_divisor(3, 5)\n    1\n    >>> greatest_common_divisor(25, 15)\n    5\n    \"\"\"\n    a, b = abs(a), abs(b)\n    while b:\n        a, b = b, a % b\n    return a"}
