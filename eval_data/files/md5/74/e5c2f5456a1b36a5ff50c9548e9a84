{"task_id": "HumanEval/31", "solution": "def is_prime(n):\n    \"\"\"Return true if a given number is prime, and false otherwise.\n    >>> is_prime(6)\n    False\n    >>> is_prime(101)\n    True\n    >>> is_prime(11)\n    True\n    >>> is_prime(13441)\n    True\n    >>> is_prime(61)\n    True\n    >>> is_prime(4)\n    False\n    >>> is_prime(1)\n    False\n    \"\"\"\n    if n < 0:\n        raise ValueError(\"n must be a non-negative integer\")\n\n    if n < 2:\n        return False\n    if n in (2, 3):\n        return True\n    if n % 2 == 0:  # Covers all other even numbers greater than 2\n        return False\n\n    # Trial division for small odd factors\n    # This acts as an optimization before Miller-Rabin for larger numbers\n    # and handles primality for numbers within its range directly.\n    limit_trial_division = 1000\n    for i in range(3, min(n, limit_trial_division + 1), 2):\n        if n % i == 0:\n            return False\n    if n <= limit_trial_division:\n        return True\n\n    # Miller-Rabin primality test for larger numbers\n    # Define _miller_rabin inline as per \"DO NOT call any helper that is not defined inline\"\n    def _miller_rabin(num, witnesses):\n        s = 0\n        d = num - 1\n        while d % 2 == 0:\n            d //= 2\n            s += 1\n\n        for a in witnesses:\n            # Skip if witness 'a' is too large for the current 'num' (should not happen with our flow)\n            if a >= num:\n                continue\n\n            x = pow(a, d, num)\n            if x == 1 or x == num - 1:\n                continue\n\n            for _ in range(s - 1):\n                x = pow(x, 2, num)\n                if x == num - 1:\n                    break\n            else:\n                return False\n        return True\n\n    # Deterministic witnesses for numbers up to 2^64 (as per design context)\n    # These witnesses are also sufficient for much larger numbers, ensuring correctness for typical integer sizes.\n    miller_rabin_witnesses = (2, 325, 9375, 28178, 450775, 9780504, 1795265022)\n    return _miller_rabin(n, miller_rabin_witnesses)"}
{"task_id": "HumanEval/31", "solution": "def is_prime(n):\n    \"\"\"Return true if a given number is prime, and false otherwise.\n    >>> is_prime(6)\n    False\n    >>> is_prime(101)\n    True\n    >>> is_prime(11)\n    True\n    >>> is_prime(13441)\n    True\n    >>> is_prime(61)\n    True\n    >>> is_prime(4)\n    False\n    >>> is_prime(1)\n    False\n    \"\"\"\n    if n < 2:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n    \n    # Check for odd divisors from 3 up to the square root of n.\n    i = 3\n    while i * i <= n:\n        if n % i == 0:\n            return False\n        i += 2\n    return True"}
{"task_id": "HumanEval/33", "solution": "def sort_third(l: list):\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the indicies that are not divisible by three, while its values at the indicies that are divisible by three are equal\n    to the values of the corresponding indicies of l, but sorted.\n    >>> sort_third([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_third([5, 6, 3, 4, 8, 9, 2])\n    [2, 6, 3, 4, 8, 9, 5]\n    \"\"\"\n    if not l:\n        return []\n\n    # Extract elements at indices divisible by three\n    third_elements = [l[i] for i in range(len(l)) if i % 3 == 0]\n\n    # Sort these extracted elements\n    third_elements.sort()\n\n    # Create a new list to store the result\n    result = list(l)\n\n    # Reinsert the sorted elements back into their original divisible-by-three positions\n    sorted_idx = 0\n    for i in range(len(l)):\n        if i % 3 == 0:\n            result[i] = third_elements[sorted_idx]\n            sorted_idx += 1\n            \n    return result"}
{"task_id": "HumanEval/32", "solution": "import math\n\n\ndef poly(xs: list, x: float):\n    \"\"\"\n    Evaluates polynomial with coefficients xs at point x.\n    return xs[0] + xs[1] * x + xs[1] * x^2 + .... xs[n] * x^n\n    \"\"\"\n    return sum([coeff * math.pow(x, i) for i, coeff in enumerate(xs)])\n\n\nclass PolynomialError(Exception):\n    pass\nclass ValidationError(PolynomialError):\n    pass\nclass NoRealRootError(PolynomialError):\n    pass\nclass NumericError(PolynomialError):\n    pass\n\n\nclass MathUtils:\n    EPS = 1e-15 # Tolerance for considering a float value as zero\n    \n    @staticmethod\n    def is_finite(val: float) -> bool:\n        \"\"\"Checks if a float value is finite (not infinity or NaN).\"\"\"\n        return not (math.isinf(val) or math.isnan(val))\n\n    @staticmethod\n    def sign(val: float) -> int:\n        \"\"\"Returns the sign of a float, treating values close to zero as zero.\"\"\"\n        if abs(val) < MathUtils.EPS:\n            return 0\n        return 1 if val > 0 else -1\n\n\nclass Validators:\n    @staticmethod\n    def validate_coeffs(xs: list) -> list:\n        \"\"\"Converts coefficients to float and trims trailing zeros.\"\"\"\n        coeffs = [float(x) for x in xs]\n        \n        # Trim trailing zeros, but keep at least one coefficient if all are zero\n        while coeffs and abs(coeffs[-1]) < MathUtils.EPS and len(coeffs) > 1:\n            coeffs.pop()\n        \n        if not coeffs:\n            return [0.0] # Represents the zero polynomial p(x) = 0\n            \n        return coeffs\n\n    @staticmethod\n    def ensure_even_length(xs: list) -> None:\n        \"\"\"Placeholder for precondition check as per design, actual validation omitted due to constraints.\"\"\"\n        pass # The problem statement implies this is a precondition to be met by the caller.\n\n    @staticmethod\n    def ensure_leading_coefficient_nonzero(xs: list) -> None:\n        \"\"\"Placeholder for precondition check as per design, actual validation omitted due to constraints.\"\"\"\n        pass # The problem statement implies this is a precondition to be met by the caller.\n\n\nclass Polynomial:\n    def __init__(self, coeffs: list) -> None:\n        \"\"\"Initializes a Polynomial with a list of coefficients.\"\"\"\n        self._coeffs = coeffs\n\n    @property\n    def coeffs(self) -> list:\n        return self._coeffs\n\n    def degree(self) -> int:\n        \"\"\"Returns the degree of the polynomial.\"\"\"\n        return len(self._coeffs) - 1\n\n    def evaluate(self, x: float) -> float:\n        \"\"\"Evaluates the polynomial at point x using Horner's method.\"\"\"\n        result = 0.0\n        for coeff in reversed(self._coeffs):\n            result = result * x + coeff\n        \n        if not MathUtils.is_finite(result):\n            raise NumericError(\"Non-finite polynomial evaluation result\")\n        return result\n\n\nclass RootFinder:\n    DEFAULT_TOL = 1e-10\n    DEFAULT_MAX_ITER = 1000\n    DEFAULT_MAX_RADIUS = 1e6\n\n    def __init__(self, tol: float = DEFAULT_TOL, max_iter: int = DEFAULT_MAX_ITER, max_radius: float = DEFAULT_MAX_RADIUS) -> None:\n        \"\"\"Initializes the RootFinder with given tolerance, max iterations, and bracketing radius.\"\"\"\n        self._tol = tol\n        self._max_iter = max_iter\n        self._max_radius = max_radius\n\n    def find_root(self, poly: Polynomial) -> float:\n        \"\"\"Finds a real root for the given polynomial using bracketing and bisection.\"\"\"\n        # Check for trivial case: zero polynomial (p(x) = 0)\n        if len(poly.coeffs) == 1 and abs(poly.coeffs[0]) < MathUtils.EPS:\n            return 0.0 # Any x is a root, return 0 as a representative\n\n        a, b = self._bracket_root(poly)\n        \n        # If a root was found exactly during bracketing, or interval is already small\n        if abs(b - a) < self._tol or abs(poly.evaluate(a)) < self._tol:\n            return a\n            \n        return self._bisection(poly, a, b)\n\n    def _bracket_root(self, poly: Polynomial) -> tuple[float, float]:\n        \"\"\"Brackets a root within an interval [a, b] where poly(a) and poly(b) have opposite signs.\"\"\"\n        R = 1.0\n        # Expand the search radius until a sign change is found or max_radius is reached\n        while R <= self._max_radius:\n            a, b = -R, R\n            fa = poly.evaluate(a)\n            fb = poly.evaluate(b)\n            \n            # If a root is found exactly at the boundary points, return it\n            if abs(fa) <= self._tol:\n                return (a, a)\n            if abs(fb) <= self._tol:\n                return (b, b)\n            \n            # If signs are different, a root is bracketed\n            if MathUtils.sign(fa) * MathUtils.sign(fb) < 0:\n                return (a, b)\n            \n            R *= 2.0\n            \n        raise NoRealRootError(f\"Failed to bracket root within max_radius {self._max_radius}\")\n\n    def _bisection(self, poly: Polynomial, a: float, b: float) -> float:\n        \"\"\"Performs bisection method to find a root within the interval [a, b].\"\"\"\n        fa = poly.evaluate(a)\n        \n        # Iteratively narrow the interval\n        for _ in range(self._max_iter):\n            mid = (a + b) / 2.0\n            f_mid = poly.evaluate(mid)\n            \n            # If the midpoint is close enough to zero or the interval is small enough, return it\n            if abs(f_mid) <= self._tol or (b - a) / 2.0 < self._tol:\n                return mid\n            \n            # Narrow the interval based on the sign of f_mid\n            if MathUtils.sign(fa) * MathUtils.sign(f_mid) < 0:\n                b = mid\n            else:\n                a = mid\n                fa = f_mid # Update fa for the new interval's left bound\n                \n        # Return the midpoint of the final interval if max iterations are reached\n        return (a + b) / 2.0\n\n\ndef find_zero(xs: list):\n    \"\"\" xs are coefficients of a polynomial.\n    find_zero find x such that poly(x) = 0.\n    find_zero returns only only zero point, even if there are many.\n    Moreover, find_zero only takes list xs having even number of coefficients\n    and largest non zero coefficient as it guarantees\n    a solution.\n    >>> round(find_zero([1, 2]), 2) # f(x) = 1 + 2x\n    -0.5\n    >>> round(find_zero([-6, 11, -6, 1]), 2) # (x - 1) * (x - 2) * (x - 3) = -6 + 11x - 6x^2 + x^3\n    1.0\n    \"\"\"\n    coeffs = Validators.validate_coeffs(xs)\n    \n    # As per the problem statement's docstring, the input `xs` is assumed\n    # to meet the preconditions (even number of coefficients, non-zero leading coeff).\n    # Explicit validation checks and raising of ValidationError are omitted as per strict\n    # \"Do NOT add isinstance() checks or raise exceptions for edge cases\" constraint.\n    \n    poly_obj = Polynomial(coeffs)\n    \n    # Instantiate RootFinder with default values as no overrides are provided in function signature\n    finder = RootFinder()\n    \n    return finder.find_root(poly_obj)"}
{"task_id": "HumanEval/33", "solution": "def sort_third(l: list):\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the indicies that are not divisible by three, while its values at the indicies that are divisible by three are equal\n    to the values of the corresponding indicies of l, but sorted.\n    >>> sort_third([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_third([5, 6, 3, 4, 8, 9, 2])\n    [2, 6, 3, 4, 8, 9, 5]\n    \"\"\"\n    result = list(l)\n\n    indices_to_sort = []\n    values_to_sort = []\n    for i in range(len(l)):\n        if i % 3 == 0:\n            indices_to_sort.append(i)\n            values_to_sort.append(l[i])\n\n    sorted_values = sorted(values_to_sort)\n\n    for i in range(len(indices_to_sort)):\n        original_index = indices_to_sort[i]\n        result[original_index] = sorted_values[i]\n\n    return result"}
{"task_id": "HumanEval/32", "solution": "import math\n\n\ndef poly(xs: list, x: float):\n    \"\"\"\n    Evaluates polynomial with coefficients xs at point x.\n    return xs[0] + xs[1] * x + xs[1] * x^2 + .... xs[n] * x^n\n    \"\"\"\n    return sum([coeff * math.pow(x, i) for i, coeff in enumerate(xs)])\n\n\ndef _find_bracket(xs: list, search_bound: float, tol: float) -> tuple[float, float]:\n    \"\"\"\n    Searches for an interval [a, b] where the polynomial changes sign,\n    using an exponential search outward from 0.\n    \"\"\"\n    y_at_zero = poly(xs, 0.0)\n    if abs(y_at_zero) < tol:\n        return 0.0, 0.0\n\n    x_prev_pos = 0.0\n    y_prev_pos = y_at_zero\n    x_prev_neg = 0.0\n    y_prev_neg = y_at_zero\n\n    current_search_point = 0.01 # Start with a small step\n\n    while True:\n        x_to_check = min(current_search_point, search_bound)\n\n        # Check positive side\n        x_curr_pos = x_to_check\n        y_curr_pos = poly(xs, x_curr_pos)\n        if y_prev_pos * y_curr_pos <= 0:\n            return x_prev_pos, x_curr_pos\n        x_prev_pos = x_curr_pos\n        y_prev_pos = y_curr_pos\n\n        # Check negative side\n        x_curr_neg = -x_to_check\n        y_curr_neg = poly(xs, x_curr_neg)\n        if y_prev_neg * y_curr_neg <= 0:\n            return x_curr_neg, x_prev_neg\n\n        if current_search_point >= search_bound:\n            break\n        \n        current_search_point *= 2.0\n        # Ensure we check search_bound exactly if the next doubled step would overshoot.\n        if current_search_point > search_bound and x_to_check < search_bound:\n            current_search_point = search_bound\n\n    # If no bracket found within the exponential search range.\n    # For odd-degree polynomials with non-zero leading coefficients,\n    # roots are guaranteed, so we return the boundary as a fallback.\n    return -search_bound, search_bound\n\n\ndef _bisection(xs: list, a: float, b: float, tol: float, max_iter: int) -> float:\n    \"\"\"\n    Applies the bisection method to find a root within the interval [a, b].\n    \"\"\"\n    fa = poly(xs, a)\n    fb = poly(xs, b)\n\n    if abs(fa) < tol: return a\n    if abs(fb) < tol: return b\n\n    # The caller (_find_bracket) guarantees a sign change if successful.\n    # If fa * fb > 0, it indicates an issue with the initial bracket,\n    # but as per instructions, no exception handling is added.\n\n    for _ in range(max_iter):\n        c = (a + b) / 2.0\n        fc = poly(xs, c)\n\n        if abs(fc) < tol or (b - a) / 2.0 < tol:\n            return c\n\n        if fa * fc < 0:\n            b = c\n        else:\n            a = c\n            fa = fc\n\n    return (a + b) / 2.0\n\n\ndef find_zero(xs: list):\n    \"\"\" xs are coefficients of a polynomial.\n    find_zero find x such that poly(x) = 0.\n    find_zero returns only only zero point, even if there are many.\n    Moreover, find_zero only takes list xs having even number of coefficients\n    and largest non zero coefficient as it guarantees\n    a solution.\n    >>> round(find_zero([1, 2]), 2) # f(x) = 1 + 2x\n    -0.5\n    >>> round(find_zero([-6, 11, -6, 1]), 2) # (x - 1) * (x - 2) * (x - 3) = -6 + 11x - 6x^2 + x^3\n    1.0\n    \"\"\"\n    DEFAULT_TOLERANCE = 1e-10\n    DEFAULT_MAX_ITER = 1000\n    DEFAULT_SEARCH_BOUND = 1e6\n\n    a, b = _find_bracket(xs, DEFAULT_SEARCH_BOUND, DEFAULT_TOLERANCE)\n\n    if a == b and abs(a) < DEFAULT_TOLERANCE:\n        return a\n\n    root = _bisection(xs, a, b, DEFAULT_TOLERANCE, DEFAULT_MAX_ITER)\n    \n    return root"}
