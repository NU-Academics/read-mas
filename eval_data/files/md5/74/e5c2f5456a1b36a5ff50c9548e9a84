{"task_id": "HumanEval/44", "solution": "def change_base(x: int, base: int) -> str:\n    \"\"\"Change numerical base of input number x to base.\n    Return string representation after the conversion.\n    Base numbers are less than 10.\n    \"\"\"\n    if x == 0:\n        return \"0\"\n    \n    digits = []\n    n = x\n    while n > 0:\n        digits.append(str(n % base))\n        n //= base\n        \n    return ''.join(reversed(digits))"}
{"task_id": "HumanEval/47", "solution": "def median(l: list):\n    \"\"\"Return median of elements in the list l.\n    >>> median([3, 1, 2, 4, 5])\n    3\n    >>> median([-10, 4, 6, 1000, 10, 20])\n    15.0\n    \"\"\"\n    s = sorted(l)\n    n = len(s)\n    mid = n // 2\n\n    if n % 2 == 1:\n        # Odd length list, return the middle element\n        val = s[mid]\n        # Return as int if it's an exact integer, otherwise float\n        if float(val).is_integer():\n            return int(val)\n        return float(val)\n    else:\n        # Even length list, return the average of the two middle elements\n        left = s[mid - 1]\n        right = s[mid]\n        return (left + right) / 2.0"}
{"task_id": "HumanEval/49", "solution": "def modp(n: int, p: int):\n    \"\"\"Return 2^n modulo p (be aware of numerics).\n    This function computes 2^n modulo p using Python's built-in modular exponentiation\n    for efficiency and correctness with large numbers.\n    \"\"\"\n    return pow(2, n, p)"}
{"task_id": "HumanEval/47", "solution": "def median(l: list):\n    \"\"\"Return median of elements in the list l.\n    >>> median([3, 1, 2, 4, 5])\n    3\n    >>> median([-10, 4, 6, 1000, 10, 20])\n    15.0\n    \"\"\"\n    # Create a sorted copy of the list to find the median.\n    sorted_l = sorted(l)\n    n = len(sorted_l)\n\n    # Calculate median based on whether the list has an odd or even number of elements.\n    if n % 2 == 1:\n        # Odd length: median is the middle element.\n        return sorted_l[n // 2]\n    else:\n        # Even length: median is the average of the two middle elements.\n        mid1_idx = n // 2 - 1\n        mid2_idx = n // 2\n        return (sorted_l[mid1_idx] + sorted_l[mid2_idx]) / 2"}
{"task_id": "HumanEval/49", "solution": "def modp(n: int, p: int):\n    \"\"\"Return 2^n modulo p, using Python's efficient modular exponentiation.\n    This avoids numerical overflow for large n by computing the modulus at each step.\n    \"\"\"\n    return pow(2, n, p)"}
{"task_id": "HumanEval/48", "solution": "import unicodedata\n\ndef is_palindrome(text: str):\n    \"\"\"\n    Checks if given string is a palindrome after normalization.\n    \"\"\"\n    # Apply normalization steps as guided by the design context.\n    \n    # 1. Unicode normalization (NFKC)\n    normalized_text = unicodedata.normalize(\"NFKC\", text)\n    \n    # 2. Casefolding\n    normalized_text = normalized_text.casefold()\n    \n    # 3. Remove punctuation and whitespace characters\n    # Punctuation: categories starting with 'P'\n    # Whitespace: categories starting with 'Z' (space separators)\n    # Also explicitly remove common control whitespace like newline and tab.\n    processed_chars = []\n    for char in normalized_text:\n        char_category = unicodedata.category(char)\n        if not char_category.startswith(\"P\") and \\\n           not (char_category.startswith(\"Z\") or char == '\\n' or char == '\\t'):\n            processed_chars.append(char)\n            \n    normalized_text = \"\".join(processed_chars)\n    \n    # 4. Check if the normalized string is a palindrome\n    return normalized_text == normalized_text[::-1]"}
{"task_id": "HumanEval/48", "solution": "import unicodedata\n\ndef is_palindrome(text: str):\n    \"\"\"\n    Checks if given string is a palindrome\n    >>> is_palindrome('')\n    True\n    >>> is_palindrome('aba')\n    True\n    >>> is_palindrome('aaaaa')\n    True\n    >>> is_palindrome('zbcd')\n    False\n    \"\"\"\n    # Per design, an empty string is considered a palindrome.\n    if not text:\n        return True\n\n    # Normalize the text by applying Unicode NFC, casefolding, and removing non-alphanumeric characters.\n    normalized_text = unicodedata.normalize('NFC', text)\n    normalized_text = normalized_text.casefold()\n    normalized_text = ''.join(char for char in normalized_text if char.isalnum())\n\n    return normalized_text == normalized_text[::-1]"}
