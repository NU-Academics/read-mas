{"task_id": "HumanEval/75", "solution": "def is_multiply_prime(a):\n    \"\"\"Check if a number is the product of exactly three prime numbers.\n    The input `a` is less than 100.\n    \"\"\"\n\n    def _prime_factors(n: int) -> list[int]:\n        \"\"\"Returns a list of prime factors for a given number n.\"\"\"\n        factors: list[int] = []\n        temp = n\n        d = 2\n        while d * d <= temp:\n            while temp % d == 0:\n                factors.append(d)\n                temp //= d\n            d += 1 if d == 2 else 2\n        if temp > 1:\n            factors.append(temp)\n        return factors\n\n    # Handle numbers outside the valid range [2, 99] as specified by the problem constraints\n    # and the design's interpretation of not raising exceptions.\n    if a < 2 or a >= 100:\n        return False\n\n    factors = _prime_factors(a)\n    return len(factors) == 3"}
{"task_id": "HumanEval/75", "solution": "def is_multiply_prime(a):\n    \"\"\"Checks if the given number is the product of exactly three prime numbers, including multiplicity.\"\"\"\n    \n    n = a\n    factors = []\n    if n <= 1:\n        return False  # 0 and 1 are not products of three primes.\n\n    d = 2\n    while d * d <= n:\n        while n % d == 0:\n            factors.append(d)\n            n //= d\n        d += 1 if d == 2 else 2 # Increment by 1 for 2, then by 2 for odd numbers\n    if n > 1:\n        factors.append(n) # If n is still greater than 1, it is a prime factor itself.\n\n    return len(factors) == 3"}
{"task_id": "HumanEval/77", "solution": "def iscube(a):\n    \"\"\"\n    Checks if an integer 'a' is a perfect cube using integer cube root.\n    Avoids floating-point issues by performing binary search for the integer cube root.\n    \"\"\"\n    if a == 0:\n        return True\n\n    sign = -1 if a < 0 else 1\n    abs_a = abs(a)\n\n    # Binary search for the integer cube root of abs_a\n    lo, hi = 0, abs_a\n    # Max possible cube root for a 64-bit int is ~2 * 10^6. abs_a itself is a safe upper bound.\n    # We can optimize hi by using min(abs_a, some_upper_bound_like_2_000_000_if_a_is_larger_than_8e18)\n    # But since Python handles arbitrary large integers, abs_a is a valid upper bound.\n    # An even tighter upper bound is int(abs_a**(1/3)) + 2 but that uses floats.\n    # A safe integer upper bound is max(1, abs_a).\n\n    # A more precise upper bound without floats:\n    # If a number N is a perfect cube of X, then X <= N.\n    # If N = X^3, then X = N^(1/3).\n    # For N >= 1, N^(1/3) <= N.\n    # So the maximum possible integer cube root is N itself (for N=1, root=1).\n    # A tighter upper bound can be derived but for Python's arbitrary integers,\n    # the existing `abs_a` is fine for correctness, though `2 * 10**6` is sufficient for typical 64-bit integers.\n    # Let's stick with `abs_a` for simplicity and correctness across all integer sizes.\n\n    root = 0\n    while lo <= hi:\n        mid = (lo + hi) // 2\n        # Check for potential overflow if mid is very large, though Python handles large ints.\n        # This operation is safe in Python as integers have arbitrary precision.\n        cube = mid * mid * mid \n\n        if cube == abs_a:\n            root = mid\n            break\n        elif cube < abs_a:\n            lo = mid + 1\n            root = mid # Store the largest mid such that mid^3 <= abs_a\n        else: # cube > abs_a\n            hi = mid - 1\n    \n    # After binary search, root holds the integer r such that r^3 <= abs_a and (r+1)^3 > abs_a\n    # This is effectively floor(cbrt(abs_a)).\n    # We need to ensure that root * root * root is exactly abs_a.\n    # If the exact root wasn't found, then root could be `hi` from the loop or the `mid`\n    # before `hi` became `mid - 1`. The `root = mid` assignment in `cube < abs_a`\n    # ensures `root` ends up being `floor(cbrt(abs_a))`.\n    \n    # We re-calculate with the determined root.\n    actual_cube = root * root * root\n\n    return sign * actual_cube == a"}
{"task_id": "HumanEval/76", "solution": "def is_simple_power(x, n):\n    \"\"\"Checks if x is a simple power of n, i.e., x == n**k for some non-negative integer k.\n    Handles edge cases like x=1 and n=1 as specified by examples.\n    \"\"\"\n    if x == 1:\n        return True\n\n    # If n is 1 and x is not 1, x cannot be a power of n (since 1**k is always 1).\n    if n == 1:\n        return False\n\n    current_x = x\n    while current_x > 1:\n        if current_x % n != 0:\n            return False\n        current_x //= n\n    \n    return current_x == 1"}
{"task_id": "HumanEval/76", "solution": "def is_simple_power(x, n):\n    \"\"\"Checks if x is a simple power of n (n**k == x for k >= 0).\n    Handles special cases for n=0, n=1, n=-1 according to specified rules.\n    \"\"\"\n\n    # Rule: x is n**k for k >= 0.\n\n    # Special case: x = 1\n    # 1 is n**0 for any n != 0.\n    if x == 1:\n        # If n is 0, 0**0 is undefined, so 1 is not considered a power of 0.\n        return n != 0\n\n    # From here, x is not 1. If x is a power, k must be >= 1.\n\n    # Special case: n = 1\n    # If n is 1 and x is not 1, then x cannot be 1**k for k >= 1.\n    if n == 1:\n        return False\n\n    # Special case: n = 0\n    # If n is 0 and x is not 1, then x must be 0 for it to be a power (0**k for k >= 1).\n    if n == 0:\n        return x == 0\n\n    # Special case: n = -1\n    # If n is -1 and x is not 1, then x must be -1 for it to be a power ((-1)**k for odd k >= 1).\n    if n == -1:\n        return x == -1\n\n    # General case: |n| > 1.\n    # If x is 0 at this point, it cannot be a power of n for |n| > 1 and k >= 0.\n    if x == 0:\n        return False\n\n    # Use repeated division. If x is a power of n, it must be perfectly divisible by n\n    # repeatedly until it becomes 1.\n    current_x = x\n    while current_x % n == 0:\n        current_x //= n\n\n    # After dividing out all factors of n, current_x should be 1 if x was a simple power of n.\n    return current_x == 1"}
{"task_id": "HumanEval/77", "solution": "def iscube(a):\n    \"\"\"\n    Checks if an integer 'a' is a perfect cube.\n    Uses an integer binary search to find the cube root reliably.\n    \"\"\"\n    sign = -1 if a < 0 else 1\n    v = abs(a)\n\n    # Determine a suitable upper bound for binary search.\n    # For v=0, bit_length() is 0, (0//3)+2 = 2, 1 << 2 = 4. lo=0, hi=4.\n    # For v=1, bit_length() is 1, (1//3)+2 = 2, 1 << 2 = 4. lo=0, hi=4.\n    # This upper bound ensures we cover the true cube root.\n    lo, hi = 0, 1 << ((v.bit_length() // 3) + 2)\n\n    root = 0\n    while lo <= hi:\n        mid = (lo + hi) // 2\n        cube = mid * mid * mid\n        if cube == v:\n            root = mid\n            break\n        if cube < v:\n            lo = mid + 1\n        else:\n            hi = mid - 1\n    else:\n        # If loop finishes without exact match, hi holds the floor of the cube root.\n        root = hi\n\n    # Apply the original sign to the found root\n    actual_root = sign * root\n    return actual_root * actual_root * actual_root == a"}
