{"task_id": "HumanEval/53", "solution": "import re\nimport uuid\nimport datetime\nfrom collections import deque\nfrom typing import Any\n\nclass ValidationError(Exception):\n    \"\"\"Exception raised for invalid input values.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\nclass RepositoryError(Exception):\n    \"\"\"Exception raised for persistence-related issues.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\nclass InputValidator:\n    \"\"\"Validates if a value can be converted to an integer.\"\"\"\n    _INT_RE = re.compile(r'^[+-]?\\d+$')\n    def validate_int(self, value: Any) -> int:\n        if isinstance(value, int):\n            return value\n        if isinstance(value, str) and self._INT_RE.match(value):\n            return int(value)\n        raise ValidationError(f\"Invalid integer value: {value!r}\")\n\nclass CalculationRecord:\n    \"\"\"Represents a record of a performed calculation.\"\"\"\n    def __init__(self, id: str, x: int, y: int, result: int, timestamp: str) -> None:\n        self.id = id\n        self.x = x\n        self.y = y\n        self.result = result\n        self.timestamp = timestamp\n\nclass InMemoryCalculationRepository:\n    \"\"\"An in-memory repository for calculation records.\"\"\"\n    def __init__(self, capacity: int = 1000) -> None:\n        self._capacity = capacity\n        self._buffer: deque[CalculationRecord] = deque(maxlen=capacity)\n\n    def save(self, record: CalculationRecord) -> None:\n        self._buffer.append(record)\n\n    def list_recent(self, limit: int) -> list[CalculationRecord]:\n        return list(self._buffer)[-limit:]\n\nclass AddService:\n    \"\"\"Performs the addition operation and persists records.\"\"\"\n    def __init__(self, repo: InMemoryCalculationRepository, validator: InputValidator):\n        self._repo = repo\n        self._validator = validator\n\n    def add(self, x: Any, y: Any) -> int:\n        x_i = self._validator.validate_int(x)\n        y_i = self._validator.validate_int(y)\n        result = x_i + y_i\n        record = CalculationRecord(str(uuid.uuid4()), x_i, y_i, result, datetime.datetime.utcnow().isoformat())\n        try:\n            self._repo.save(record)\n        except Exception as e:\n            raise RepositoryError(str(e))\n        return result\n\n_default_repo = InMemoryCalculationRepository()\n_default_validator = InputValidator()\n_default_service = AddService(_default_repo, _default_validator)\n\ndef add(x: int, y: int) -> int:\n    \"\"\"Add two numbers x and y\n    >>> add(2, 3)\n    5\n    >>> add(5, 7)\n    12\n    \"\"\"\n    return _default_service.add(x, y)"}
{"task_id": "HumanEval/54", "solution": "\nclass SameCharsError(Exception):\n    \"\"\"Base exception for same_chars operations.\"\"\"\n    def __init__(self, message: str = \"\") -> None:\n        super().__init__(message)\n        self.message = message\n\nclass InvalidInputError(SameCharsError):\n    \"\"\"Exception raised for invalid input parameters.\"\"\"\n    def __init__(self, field: str, message: str = \"\") -> None:\n        self.field = field\n        super().__init__(message or f\"Invalid input for {field}\")\n\nclass ProcessingError(SameCharsError):\n    \"\"\"Exception raised for unexpected errors during processing.\"\"\"\n    pass\n\nclass InputValidator:\n    \"\"\"Validates input parameters.\"\"\"\n    def validate_string(self, name: str, value: object) -> None:\n        if value is None:\n            raise InvalidInputError(field=name, message=f\"{name} is required\")\n        if not isinstance(value, str):\n            raise InvalidInputError(field=name, message=f\"{name} must be a string\")\n\nfrom typing import Set\n\nclass CharSet:\n    \"\"\"Represents a string's unique character set.\"\"\"\n    def __init__(self, chars: Set[str]) -> None:\n        self._chars = set(chars)\n\n    @classmethod\n    def from_string(cls, s: str, normalize: bool = False) -> \"CharSet\":\n        # Input validation for `s` is handled by InputValidator at the service layer.\n        if normalize:\n            import unicodedata\n            s = unicodedata.normalize(\"NFC\", s).casefold()\n        return cls(set(s))\n\n    def chars(self) -> Set[str]:\n        return set(self._chars)\n\n    def equals(self, other: \"CharSet\") -> bool:\n        return self._chars == other._chars\n\nclass SameCharsService:\n    \"\"\"Provides the core business logic for comparing character sets.\"\"\"\n    def __init__(self, validator: InputValidator = None, normalize: bool = False) -> None:\n        self.validator = validator or InputValidator()\n        self.normalize = normalize\n\n    def same_chars(self, s0: str, s1: str) -> bool:\n        self.validator.validate_string(\"s0\", s0)\n        self.validator.validate_string(\"s1\", s1)\n        try:\n            cs0 = CharSet.from_string(s0, normalize=self.normalize)\n            cs1 = CharSet.from_string(s1, normalize=self.normalize)\n            return cs0.equals(cs1)\n        except Exception as exc:\n            raise ProcessingError(message=str(exc))\n\ndef same_chars(s0: str, s1: str):\n    \"\"\"\n    Check if two words have the same characters.\n    \"\"\"\n    service = SameCharsService(normalize=False) # Use default normalization setting (False)\n    return service.same_chars(s0, s1)"}
{"task_id": "HumanEval/55", "solution": "import os\nimport sqlite3\nimport logging\nfrom collections import OrderedDict\nfrom dataclasses import dataclass\nfrom typing import Optional, Any\n\n# Configure a basic logger for error reporting.\nlogger = logging.getLogger(__name__)\nlogging.basicConfig(level=logging.WARNING, format='%(asctime)s - %(levelname)s - %(message)s')\n\n\n# --- Exceptions ---\nclass InvalidInputError(Exception):\n    \"\"\"Raised when input 'n' is invalid.\"\"\"\n\nclass PersistenceError(Exception):\n    \"\"\"Raised when there is an issue with data persistence.\"\"\"\n\n\n# --- Models ---\n@dataclass\nclass FibResult:\n    \"\"\"DTO for returning computed Fibonacci results.\"\"\"\n    n: int\n    value: int\n    from_cache: bool = False\n\n    def to_dict(self) -> dict:\n        return {\"n\": self.n, \"value\": self.value, \"from_cache\": self.from_cache}\n\n\n# --- Utils ---\nclass ValidationUtils:\n    \"\"\"Utility for input validation.\"\"\"\n    @staticmethod\n    def validate_n(n_raw: Any) -> int:\n        try:\n            n = int(n_raw)\n        except (ValueError, TypeError):\n            raise InvalidInputError(f\"n must be an integer, got {n_raw!r}\")\n        if n < 0:\n            raise InvalidInputError(\"n must be non-negative\")\n        return n\n\n\n# --- Configuration ---\n@dataclass\nclass AppConfig:\n    \"\"\"Holds runtime configuration.\"\"\"\n    persistence_enabled: bool\n    sqlite_path: str\n    cache_max_size: int\n    db_sync: bool\n\n    @staticmethod\n    def load_from_env() -> \"AppConfig\":\n        \"\"\"Loads configuration from environment variables.\"\"\"\n        return AppConfig(\n            persistence_enabled = os.getenv(\"FIB_PERSIST\", \"false\").lower() == \"true\",\n            sqlite_path = os.getenv(\"FIB_SQLITE_PATH\", \"./fib_cache.db\"),\n            cache_max_size = int(os.getenv(\"FIB_CACHE_MAX\", \"1000\")),\n            db_sync = os.getenv(\"FIB_DB_SYNC\", \"true\").lower() == \"true\",\n        )\n\n\n# --- DB Migrations (minimal for SQLite) ---\ndef ensure_schema(conn: sqlite3.Connection) -> None:\n    \"\"\"Ensures the fib_cache table exists in the SQLite database.\"\"\"\n    cursor = conn.cursor()\n    cursor.execute(\"\"\"\n        CREATE TABLE IF NOT EXISTS fib_cache (\n            n INTEGER PRIMARY KEY,\n            value TEXT NOT NULL,\n            computed_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP\n        )\n    \"\"\")\n    conn.commit()\n\n\n# --- Repository ---\nclass IFibRepository:\n    \"\"\"Interface for Fibonacci number repository.\"\"\"\n    def get(self, n: int) -> Optional[int]:\n        raise NotImplementedError\n\n    def save(self, n: int, value: int) -> None:\n        raise NotImplementedError\n\n\nclass InMemoryFibRepository(IFibRepository):\n    \"\"\"An LRU-like in-memory cache for Fibonacci numbers.\"\"\"\n    def __init__(self, max_size: int = 1000):\n        self._cache = OrderedDict()\n        self._max_size = max_size\n\n    def get(self, n: int) -> Optional[int]:\n        val = self._cache.get(n)\n        if val is not None:\n            self._cache.move_to_end(n) # Mark as most recently used\n        return val\n\n    def save(self, n: int, value: int) -> None:\n        self._cache[n] = value\n        self._cache.move_to_end(n)\n        if len(self._cache) > self._max_size:\n            self._cache.popitem(last=False) # Remove least recently used\n\n\nclass SqliteFibRepository(IFibRepository):\n    \"\"\"Persistence to SQLite for Fibonacci numbers.\"\"\"\n    def __init__(self, path: str, sync: bool = True):\n        self._path = path\n        self._conn = sqlite3.connect(path)\n        if not sync:\n            self._conn.execute(\"PRAGMA synchronous = OFF\")\n        ensure_schema(self._conn) # Ensure table exists\n\n    def get(self, n: int) -> Optional[int]:\n        try:\n            cursor = self._conn.cursor()\n            cursor.execute(\"SELECT value FROM fib_cache WHERE n = ?\", (n,))\n            row = cursor.fetchone()\n            if row:\n                return int(row[0]) # Convert stored TEXT back to int\n            return None\n        except sqlite3.Error as e:\n            logger.error(f\"SQLite get error for n={n}: {e}\")\n            raise PersistenceError(f\"Failed to retrieve from DB: {e}\") from e\n\n    def save(self, n: int, value: int) -> None:\n        try:\n            cursor = self._conn.cursor()\n            cursor.execute(\n                \"INSERT OR REPLACE INTO fib_cache (n, value) VALUES (?, ?)\",\n                (n, str(value)) # Store large int as TEXT\n            )\n            self._conn.commit()\n        except sqlite3.Error as e:\n            logger.error(f\"SQLite save error for n={n}, value={value}: {e}\")\n            raise PersistenceError(f\"Failed to save to DB: {e}\") from e\n\n    def close(self) -> None:\n        \"\"\"Closes the database connection.\"\"\"\n        self._conn.close()\n\n\nclass CompositeFibRepository(IFibRepository):\n    \"\"\"Orchestrates in-memory and optional SQLite repositories.\"\"\"\n    def __init__(self, memory: InMemoryFibRepository, sqlite: Optional[SqliteFibRepository]):\n        self._memory = memory\n        self._sqlite = sqlite\n\n    def get(self, n: int) -> Optional[int]:\n        val = self._memory.get(n)\n        if val is not None:\n            return val\n        if self._sqlite:\n            try:\n                val = self._sqlite.get(n)\n                if val is not None:\n                    self._memory.save(n, val) # Cache in memory from DB\n                return val\n            except PersistenceError:\n                logger.warning(f\"Could not retrieve n={n} from SQLite, continuing without DB lookup.\")\n        return None\n\n    def save(self, n: int, value: int) -> None:\n        self._memory.save(n, value)\n        if self._sqlite:\n            try:\n                self._sqlite.save(n, value)\n            except PersistenceError:\n                logger.warning(f\"Could not save n={n} to SQLite, continuing with in-memory cache only.\")\n\n\n# --- Service ---\nclass FibonacciService:\n    \"\"\"Core Fibonacci logic and caching orchestration.\"\"\"\n    def __init__(self, repo: IFibRepository):\n        self._repo = repo\n\n    def compute(self, n: int) -> FibResult:\n        n_valid = ValidationUtils.validate_n(n) # Validates input 'n'\n        \n        cached = self._repo.get(n_valid)\n        if cached is not None:\n            return FibResult(n=n_valid, value=cached, from_cache=True)\n        \n        value = self._fast_doubling(n_valid)[0] # F(n) is the first element of the tuple\n        \n        try:\n            self._repo.save(n_valid, value)\n        except Exception as e:\n            logger.error(f\"Failed to save computed Fibonacci number {n_valid} to repository: {e}\")\n            \n        return FibResult(n=n_valid, value=value, from_cache=False)\n\n    def _fast_doubling(self, n: int) -> tuple[int, int]:\n        \"\"\"\n        Computes (F(n), F(n+1)) using the fast doubling method.\n        This method has a time complexity of O(log n).\n        \"\"\"\n        if n == 0:\n            return (0, 1) # Base case: (F(0), F(1))\n        \n        # Recurse for n/2\n        (a, b) = self._fast_doubling(n >> 1) # (F(n/2), F(n/2 + 1))\n        \n        # Calculate F(2k) = F(k) * (2*F(k+1) - F(k))\n        c = a * (2 * b - a)\n        # Calculate F(2k+1) = F(k)^2 + F(k+1)^2\n        d = a * a + b * b\n        \n        if n & 1: # If n is odd (n = 2k + 1)\n            return (d, c + d) # Returns (F(2k+1), F(2k+2))\n        else: # If n is even (n = 2k)\n            return (c, d) # Returns (F(2k), F(2k+1))\n\n\ndef fib(n: int) -> int:\n    \"\"\"Return n-th Fibonacci number.\"\"\"\n    cfg = AppConfig.load_from_env()\n    mem = InMemoryFibRepository(max_size=cfg.cache_max_size)\n    sqlite = SqliteFibRepository(cfg.sqlite_path, sync=cfg.db_sync) if cfg.persistence_enabled else None\n    repo = CompositeFibRepository(memory=mem, sqlite=sqlite)\n    svc = FibonacciService(repo)\n    \n    try:\n        result = svc.compute(n)\n        return result.value\n    finally:\n        if sqlite:\n            sqlite.close() # Ensure SQLite connection is closed"}
{"task_id": "HumanEval/55", "solution": "def fib(n: int):\n    \"\"\"Return n-th Fibonacci number.\n    >>> fib(10)\n    55\n    >>> fib(1)\n    1\n    >>> fib(8)\n    21\n    \"\"\"\n    if n == 0:\n        return 0\n\n    # Implements the fast doubling method for O(log n) complexity.\n    def _fd(k: int) -> tuple[int, int]:\n        if k == 0:\n            return (0, 1)\n\n        a, b = _fd(k >> 1)\n        c = a * ((b << 1) - a)  # F(2k) = F(k) * (2*F(k+1) - F(k))\n        d = a*a + b*b           # F(2k+1) = F(k)^2 + F(k+1)^2\n\n        if k & 1:  # If k is odd, return F(2k+1) and F(2k+2)\n            return (d, c + d)\n        return (c, d)          # If k is even, return F(2k) and F(2k+1)\n\n    return _fd(n)[0]"}
