{"task_id": "HumanEval/42", "solution": "from typing import Any, Optional\nimport json\n\nclass IncrListError(Exception):\n    \"\"\"Base exception for package errors.\"\"\"\n    pass\n\nclass InvalidInputError(IncrListError):\n    \"\"\"Exception for invalid inputs, with structured details.\"\"\"\n    def __init__(self, message: str, details: Optional[dict] = None):\n        super().__init__(message)\n        self.message = message\n        self.details = details or {}\n\n    def __str__(self):\n        if self.details:\n            return f\"{self.message} (Details: {self.details})\"\n        return self.message\n\nclass ListTransformer:\n    \"\"\"Pure transformation logic to increment elements.\"\"\"\n    def transform(self, values: list[int]) -> list[int]:\n        return [v + 1 for v in values]\n\nclass InputValidator:\n    \"\"\"Validates and normalizes various inputs into a list of integers.\"\"\"\n    MAX_LENGTH = 1_000_000\n\n    def validate(self, value: Any) -> list[int]:\n        if value is None:\n            raise InvalidInputError(\"Input is None\")\n        \n        if isinstance(value, (list, tuple)):\n            out = []\n            for i, v in enumerate(value):\n                try:\n                    out.append(int(v))\n                except (ValueError, TypeError) as e:\n                    raise InvalidInputError(f\"Element at {i} not integer\", {\"index\": i, \"value\": v, \"error\": str(e)}) from e\n            if len(out) > self.MAX_LENGTH:\n                raise InvalidInputError(f\"Input too large, exceeds MAX_LENGTH of {self.MAX_LENGTH}\")\n            return out\n        \n        if isinstance(value, str):\n            try:\n                parsed = json.loads(value)\n                if isinstance(parsed, list):\n                    return self.validate(parsed)\n            except json.JSONDecodeError:\n                pass # Fall through to space-separated parsing\n            \n            parts = [p for p in value.strip().split() if p]\n            return self.validate(parts) # Re-validate parts as a list\n        \n        if isinstance(value, bytes):\n            try:\n                return self.validate(value.decode('utf-8'))\n            except UnicodeDecodeError as e:\n                raise InvalidInputError(\"Cannot decode bytes input to string\", {\"error\": str(e)}) from e\n\n        raise InvalidInputError(\"Unsupported input type\", {\"type\": type(value).__name__})\n\nclass IncrementService:\n    \"\"\"Orchestrates validation and transformation for the increment operation.\"\"\"\n    def __init__(self, transformer: ListTransformer, validator: InputValidator) -> None:\n        self._transformer = transformer\n        self._validator = validator\n\n    def increment(self, raw_input: Any) -> list[int]:\n        validated = self._validator.validate(raw_input)\n        return self._transformer.transform(validated)\n\nclass LibraryController:\n    \"\"\"Provides a simple facade for the library-level function.\"\"\"\n    def __init__(self, service: IncrementService) -> None:\n        self._service = service\n\n    def incr_list(self, l: list) -> list[int]:\n        return self._service.increment(l)\n\ndef incr_list(l: list) -> list:\n    \"\"\"Return list with elements incremented by 1.\n    >>> incr_list([1, 2, 3])\n    [2, 3, 4]\n    >>> incr_list([5, 3, 5, 2, 3, 3, 9, 0, 123])\n    [6, 4, 6, 3, 4, 4, 10, 1, 124]\n    \"\"\"\n    validator = InputValidator()\n    transformer = ListTransformer()\n    service = IncrementService(transformer, validator)\n    controller = LibraryController(service)\n    return controller.incr_list(l)"}
{"task_id": "HumanEval/44", "solution": "def change_base(x: int, base: int) -> str:\n    \"\"\"Change numerical base of input number x to base.\n    Returns string representation after the conversion.\n    \"\"\"\n    if x == 0:\n        return \"0\"\n\n    digits = []\n    current_x = x\n    while current_x > 0:\n        digits.append(str(current_x % base))\n        current_x //= base\n    \n    return \"\".join(reversed(digits))"}
{"task_id": "HumanEval/43", "solution": "from collections import Counter\n\ndef pairs_sum_to_zero(l):\n    \"\"\"\n    Checks if there are two distinct elements in the list that sum to zero.\n    \"\"\"\n    counts = Counter(l)\n    for x in counts:\n        if x == 0:\n            if counts[0] > 1:\n                return True\n        else:\n            if -x in counts:\n                return True\n    return False"}
{"task_id": "HumanEval/42", "solution": "class ValidationError(Exception):\n    \"\"\"Exception for input validation failures.\"\"\"\n    def __init__(self, message: str, error_code: str = \"validation_error\") -> None:\n        self.message = message\n        self.error_code = error_code\n        super().__init__(message)\n\n    def __str__(self) -> str:\n        return f\"[{self.error_code}] {self.message}\"\n\nclass IncrementService:\n    \"\"\"Business logic for incrementing a list of integers.\"\"\"\n    def increment(self, items: list[int]) -> list[int]:\n        return [x + 1 for x in items]\n\nclass ListValidator:\n    \"\"\"Validates if input is a list of integers and optionally coerces numeric strings.\"\"\"\n    def __init__(self, allow_string_numeric: bool=False):\n        self.allow_string_numeric = allow_string_numeric\n\n    def validate(self, items: object) -> list[int]:\n        if not isinstance(items, (list, tuple)):\n            raise ValidationError(\"Input must be a list\", \"not_a_list\")\n        result = []\n        for i, el in enumerate(items):\n            if isinstance(el, int):\n                result.append(el)\n            elif self.allow_string_numeric and isinstance(el, str):\n                try:\n                    result.append(int(el))\n                except ValueError:\n                    raise ValidationError(f\"Element at index {i} is not an int\", \"not_int\")\n            else:\n                raise ValidationError(f\"Element at index {i} is not an int\", \"not_int\")\n        return result\n\nclass IncrListFacade:\n    \"\"\"Orchestrates validation and increment operations.\"\"\"\n    def __init__(self, validator: \"ListValidator\", service: \"IncrementService\"):\n        self.validator = validator\n        self.service = service\n\n    def incr_list(self, l: list) -> list:\n        valid = self.validator.validate(l)\n        return self.service.increment(valid)\n\ndef incr_list(l: list) -> list:\n    \"\"\"Return list with elements incremented by 1.\n    >>> incr_list([1, 2, 3])\n    [2, 3, 4]\n    >>> incr_list([5, 3, 5, 2, 3, 3, 9, 0, 123])\n    [6, 4, 6, 3, 4, 4, 10, 1, 124]\n    \"\"\"\n    validator = ListValidator()\n    service = IncrementService()\n    facade = IncrListFacade(validator=validator, service=service)\n    return facade.incr_list(l)"}
