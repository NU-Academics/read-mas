{"task_id": "HumanEval/38", "solution": "def decode_cyclic(s: str):\n    \"\"\"\n    takes as input string encoded with encode_cyclic function. Returns decoded string.\n    \"\"\"\n    # split string to groups of length 3.\n    groups = [s[(3 * i):min((3 * i + 3), len(s))] for i in range((len(s) + 2) // 3)]\n    # cycle elements in each group back (rotate right). Unless group has fewer elements than 3.\n    groups = [(group[-1] + group[:-1]) if len(group) == 3 else group for group in groups]\n    return \"\".join(groups)"}
{"task_id": "HumanEval/40", "solution": "def triples_sum_to_zero(l: list):\n    \"\"\"\n    triples_sum_to_zero takes a list of integers as an input.\n    it returns True if there are three distinct elements in the list that\n    sum to zero, and False otherwise.\n    \"\"\"\n    n = len(l)\n    if n < 3:\n        return False\n\n    sorted_l = sorted(l)\n\n    for i in range(n - 2):\n        # Skip duplicate elements for the first number\n        if i > 0 and sorted_l[i] == sorted_l[i-1]:\n            continue\n\n        left, right = i + 1, n - 1\n        while left < right:\n            current_sum = sorted_l[i] + sorted_l[left] + sorted_l[right]\n\n            if current_sum == 0:\n                return True\n            elif current_sum < 0:\n                left += 1\n            else: # current_sum > 0\n                right -= 1\n                \n    return False"}
{"task_id": "HumanEval/43", "solution": "def pairs_sum_to_zero(l):\n    \"\"\"\n    pairs_sum_to_zero takes a list of integers as an input.\n    it returns True if there are two distinct elements in the list that\n    sum to zero, and False otherwise.\n    >>> pairs_sum_to_zero([1, 3, 5, 0])\n    False\n    >>> pairs_sum_to_zero([1, 3, -2, 1])\n    False\n    >>> pairs_sum_to_zero([1, 2, 3, 7])\n    False\n    >>> pairs_sum_to_zero([2, 4, -5, 3, 5, 7])\n    True\n    >>> pairs_sum_to_zero([1])\n    False\n    \"\"\"\n    seen_numbers = set()\n    for num in l:\n        # Check if the complement (-num) has been seen before.\n        if -num in seen_numbers:\n            return True\n        seen_numbers.add(num)\n    return False"}
{"task_id": "HumanEval/46", "solution": "def fib4(n: int):\n    \"\"\"The Fib4 number sequence is a sequence similar to the Fibbonacci sequnece that's defined as follows:\n    fib4(0) -> 0\n    fib4(1) -> 0\n    fib4(2) -> 2\n    fib4(3) -> 0\n    fib4(n) -> fib4(n-1) + fib4(n-2) + fib4(n-3) + fib4(n-4).\n    Please write a function to efficiently compute the n-th element of the fib4 number sequence. Do not use recursion.\n    >>> fib4(5)\n    4\n    >>> fib4(6)\n    8\n    >>> fib4(7)\n    14\n    \"\"\"\n    if n == 0:\n        return 0\n    elif n == 1:\n        return 0\n    elif n == 2:\n        return 2\n    elif n == 3:\n        return 0\n\n    # Initialize the first four values of the sequence in order: fib4(0), fib4(1), fib4(2), fib4(3)\n    # The variables represent fib4(k-4), fib4(k-3), fib4(k-2), fib4(k-1) in the loop for computing fib4(k)\n    f_n_minus_4, f_n_minus_3, f_n_minus_2, f_n_minus_1 = 0, 0, 2, 0\n\n    # Iteratively compute fib4(n) for n >= 4\n    for _ in range(4, n + 1):\n        current_fib = f_n_minus_1 + f_n_minus_2 + f_n_minus_3 + f_n_minus_4\n        # Shift values for the next iteration\n        f_n_minus_4 = f_n_minus_3\n        f_n_minus_3 = f_n_minus_2\n        f_n_minus_2 = f_n_minus_1\n        f_n_minus_1 = current_fib\n    \n    return f_n_minus_1"}
{"task_id": "HumanEval/46", "solution": "def fib4(n: int):\n    \"\"\"The Fib4 number sequence is a sequence similar to the Fibbonacci sequnece that's defined as follows:\n    fib4(0) -> 0\n    fib4(1) -> 0\n    fib4(2) -> 2\n    fib4(3) -> 0\n    fib4(n) -> fib4(n-1) + fib4(n-2) + fib4(n-3) + fib4(n-4).\n    Please write a function to efficiently compute the n-th element of the fib4 number sequence.  Do not use recursion.\n    >>> fib4(5)\n    4\n    >>> fib4(6)\n    8\n    >>> fib4(7)\n    14\n    \"\"\"\n    if n == 0 or n == 1 or n == 3:\n        return 0\n    if n == 2:\n        return 2\n\n    # Initialize with the base cases: fib4(0), fib4(1), fib4(2), fib4(3)\n    # The variables represent fib4(i-4), fib4(i-3), fib4(i-2), fib4(i-1) respectively.\n    # Initially: fib4_n_minus_4, fib4_n_minus_3, fib4_n_minus_2, fib4_n_minus_1\n    fib4_n_minus_4 = 0  # fib4(0)\n    fib4_n_minus_3 = 0  # fib4(1)\n    fib4_n_minus_2 = 2  # fib4(2)\n    fib4_n_minus_1 = 0  # fib4(3)\n\n    for _ in range(4, n + 1):\n        # Calculate the next fib4 number using the sum of the previous four\n        current_fib4 = fib4_n_minus_1 + fib4_n_minus_2 + fib4_n_minus_3 + fib4_n_minus_4\n        # Shift the window to prepare for the next iteration\n        fib4_n_minus_4 = fib4_n_minus_3\n        fib4_n_minus_3 = fib4_n_minus_2\n        fib4_n_minus_2 = fib4_n_minus_1\n        fib4_n_minus_1 = current_fib4\n\n    return fib4_n_minus_1"}
{"task_id": "HumanEval/34", "solution": "def unique(l: list):\n    \"\"\"Return sorted unique elements in a list.\n    De-duplicates and sorts the elements while preserving their original type.\n    \"\"\"\n    sorted_copy = sorted(list(l)) # Create a sorted shallow copy of the input list.\n    result = []\n    prev = object() # Use a unique sentinel to ensure the first item in a non-empty list is always added.\n\n    for item in sorted_copy:\n        # If the current item is different from the last unique item added, append it.\n        if item != prev:\n            result.append(item)\n        prev = item\n            \n    return result"}
{"task_id": "HumanEval/53", "solution": "def add(x: int, y: int):\n    \"\"\"Add two numbers x and y\n    >>> add(2, 3)\n    5\n    >>> add(5, 7)\n    12\n    \"\"\"\n    return x + y"}
{"task_id": "HumanEval/74", "solution": "def total_match(lst1, lst2):\n    '''\n    Write a function that accepts two lists of strings and returns the list that has \n    total number of chars in the all strings of the list less than the other list.\n\n    if the two lists have the same number of chars, return the first list.\n\n    Examples\n    total_match([], []) \u279e []\n    total_match(['hi', 'admin'], ['hI', 'Hi']) \u279e ['hI', 'Hi']\n    total_match(['hi', 'admin'], ['hi', 'hi', 'admin', 'project']) \u279e ['hi', 'admin']\n    total_match(['hi', 'admin'], ['hI', 'hi', 'hi']) \u279e ['hI', 'hi', 'hi']\n    total_match(['4'], ['1', '2', '3', '4', '5']) \u279e ['4']\n    '''\n    \n    # Calculate the total number of characters for the first list.\n    total_chars_lst1 = sum(len(s) for s in lst1)\n    \n    # Calculate the total number of characters for the second list.\n    total_chars_lst2 = sum(len(s) for s in lst2)\n    \n    # Compare the total character counts and return the appropriate list.\n    # If the first list has fewer or an equal number of characters, return the first list.\n    if total_chars_lst1 <= total_chars_lst2:\n        return lst1\n    else:\n        return lst2"}
{"task_id": "HumanEval/94", "solution": "def skjkasdkd(lst):\n    \"\"\"You are given a list of integers.\n    You need to find the largest prime value and return the sum of its digits.\n    \"\"\"\n    def is_prime(n):\n        \"\"\"Checks if a number is prime.\"\"\"\n        if n <= 1:\n            return False\n        if n == 2:\n            return True\n        if n % 2 == 0:\n            return False\n        i = 3\n        while i * i <= n:\n            if n % i == 0:\n                return False\n            i += 2\n        return True\n\n    def sum_digits(n):\n        \"\"\"Calculates the sum of the digits of a number.\"\"\"\n        return sum(int(digit) for digit in str(abs(n)))\n\n    largest_prime = None\n\n    for num in lst:\n        if is_prime(num):\n            if largest_prime is None or num > largest_prime:\n                largest_prime = num\n\n    if largest_prime is None:\n        return 0\n    else:\n        return sum_digits(largest_prime)"}
{"task_id": "HumanEval/89", "solution": "def encrypt(s):\n    \"\"\"Encrypts a string using a Caesar cipher with a shift of 4, preserving case and non-alphabetic characters.\"\"\"\n    encrypted_chars = []\n    for char in s:\n        if 'a' <= char <= 'z':\n            start = ord('a')\n            encrypted_char = chr((ord(char) - start + 4) % 26 + start)\n        elif 'A' <= char <= 'Z':\n            start = ord('A')\n            encrypted_char = chr((ord(char) - start + 4) % 26 + start)\n        else:\n            encrypted_char = char\n        encrypted_chars.append(encrypted_char)\n    return ''.join(encrypted_chars)"}
{"task_id": "HumanEval/112", "solution": "def reverse_delete(s,c):\n    \"\"\"Task\n    We are given two strings s and c, you have to deleted all the characters in s that are equal to any character in c\n    then check if the result string is palindrome.\n    A string is called palindrome if it reads the same backward as forward.\n    You should return a tuple containing the result string and True/False for the check.\n    Example\n    For s = \"abcde\", c = \"ae\", the result should be ('bcd',False)\n    For s = \"abcdef\", c = \"b\"  the result should be ('acdef',False)\n    For s = \"abcdedcba\", c = \"ab\", the result should be ('cdedc',True)\n    \"\"\"\n    \n    chars_to_remove = set(c)\n    \n    result_chars = []\n    for char_s in s:\n        if char_s not in chars_to_remove:\n            result_chars.append(char_s)\n            \n    filtered_s = \"\".join(result_chars)\n    \n    is_palindrome = filtered_s == filtered_s[::-1]\n    \n    return (filtered_s, is_palindrome)"}
{"task_id": "HumanEval/151", "solution": "def double_the_difference(lst):\n    \"\"\"\n    Given a list of numbers, return the sum of squares of the numbers\n    in the list that are odd. Ignore numbers that are negative or not integers.\n    \"\"\"\n    total = 0\n    for num in lst:\n        # Check if the number is an integer, non-negative, and odd\n        if isinstance(num, int) and num >= 0 and (num % 2) != 0:\n            total += num * num\n    return total"}
