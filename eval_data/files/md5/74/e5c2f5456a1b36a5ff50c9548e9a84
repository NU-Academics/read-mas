{"task_id": "HumanEval/153", "solution": "def Strongest_Extension(class_name, extensions):\n    \"\"\"Finds the strongest extension based on CAP - SM, choosing the first in case of a tie.\n    Returns the result formatted as \"ClassName.StrongestExtensionName\".\n    \"\"\"\n\n    def _count_chars(text: str) -> tuple[int, int]:\n        \"\"\"Counts uppercase and lowercase letters in a given text.\"\"\"\n        cap = sm = 0\n        for ch in text:\n            if ch.isupper():\n                cap += 1\n            elif ch.islower():\n                sm += 1\n        return cap, sm\n\n    class _ExtensionCandidate:\n        \"\"\"Represents an extension with its name, original index, and computed strength.\"\"\"\n        def __init__(self, name: str, index: int):\n            self.name = name\n            self.index = index\n            self._strength = None\n\n        def compute_strength(self):\n            \"\"\"Calculates and stores the strength (CAP - SM) for this extension.\"\"\"\n            cap, sm = _count_chars(self.name)\n            self._strength = cap - sm\n            return self._strength\n\n        @property\n        def strength(self):\n            return self._strength\n\n    candidates = []\n    for idx, ext_name in enumerate(extensions):\n        candidate = _ExtensionCandidate(ext_name, idx)\n        candidate.compute_strength()\n        candidates.append(candidate)\n\n    # Find the strongest candidate: highest strength, then lowest index (first in list)\n    strongest_candidate = max(candidates, key=lambda ex: (ex.strength, -ex.index))\n\n    return f\"{class_name}.{strongest_candidate.name}\""}
{"task_id": "HumanEval/155", "solution": "from dataclasses import dataclass\n\nclass InvalidInputError(ValueError):\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\n@dataclass(frozen=True)\nclass EvenOddCount:\n    even: int\n    odd: int\n\n    def to_tuple(self) -> tuple[int, int]:\n        return (self.even, self.odd)\n\nclass DigitUtils:\n    @staticmethod\n    def digits(num: int):\n        n = abs(num)\n        if n == 0:\n            yield 0\n            return\n        while n:\n            yield n % 10\n            n //= 10\n\n    @staticmethod\n    def is_even(digit: int) -> bool:\n        return (digit % 2) == 0\n\nclass EvenOddService:\n    def __init__(self, utils: DigitUtils):\n        self._utils = utils\n\n    def count_digits(self, num: int) -> EvenOddCount:\n        even = 0\n        odd = 0\n        for d in self._utils.digits(num):\n            if self._utils.is_even(d):\n                even += 1\n            else:\n                odd += 1\n        return EvenOddCount(even=even, odd=odd)\n\nclass InputParser:\n    def parse_int(self, value):\n        if isinstance(value, int):\n            return value\n        if isinstance(value, str):\n            s = value.strip()\n            if s == '':\n                raise InvalidInputError(\"Empty input\")\n            try:\n                return int(s)\n            except ValueError:\n                raise InvalidInputError(f\"Cannot parse '{value}' as int\")\n        raise InvalidInputError(f\"Unsupported type: {type(value)}\")\n\ndef even_odd_count(num):\n    \"\"\"Given an integer. return a tuple that has the number of even and odd digits respectively.\"\"\"\n    parser = InputParser()\n    service = EvenOddService(DigitUtils())\n    parsed_num = parser.parse_int(num)\n    dto = service.count_digits(parsed_num)\n    return dto.to_tuple()"}
{"task_id": "HumanEval/153", "solution": "class ExtensionError(Exception):\n    pass\n\nclass ExtensionListEmptyError(ExtensionError):\n    pass\n\nclass InvalidInputError(ExtensionError):\n    pass\n\ndef is_letter(ch: str) -> bool:\n    \"\"\"Checks if a character is an alphabetic letter.\"\"\"\n    return ch.isalpha()\n\ndef count_case_chars(s: str) -> tuple[int, int]:\n    \"\"\"Counts uppercase and lowercase letters in a string.\"\"\"\n    cap = sum(1 for c in s if c.isalpha() and c.isupper())\n    low = sum(1 for c in s if c.isalpha() and c.islower())\n    return cap, low\n\ndef validate_class_name(name: str) -> None:\n    \"\"\"Per constraint, no validation or raising occurs here.\"\"\"\n    pass\n\nclass Extension:\n    \"\"\"Represents an extension with its name and computed strength.\"\"\"\n    def __init__(self, name: str, strength: int = 0) -> None:\n        self.name = name\n        self.strength = strength\n\n    def compute_strength(self, calculator) -> int:\n        \"\"\"Computes and sets the strength of the extension.\"\"\"\n        self.strength = calculator.strength(self.name)\n        return self.strength\n\nclass StrengthCalculator:\n    \"\"\"Calculates the strength of an extension name.\"\"\"\n    def __init__(self) -> None:\n        pass\n\n    def strength(self, extension_name: str) -> int:\n        \"\"\"Calculates strength as CAP - SM.\"\"\"\n        cap, low = count_case_chars(extension_name)\n        return cap - low\n\nclass ExtensionFactory:\n    \"\"\"Factory for creating Extension objects with computed strength.\"\"\"\n    def __init__(self, calculator: 'StrengthCalculator') -> None:\n        self._calculator = calculator\n\n    def create(self, name: str) -> 'Extension':\n        \"\"\"Creates an Extension instance and computes its strength.\"\"\"\n        ext = Extension(name=name)\n        ext.compute_strength(self._calculator)\n        return ext\n\nclass ExtensionRepository:\n    \"\"\"Provides extension names from a source.\"\"\"\n    def __init__(self, source) -> None:\n        self._source = source\n\n    def load(self) -> list[str]:\n        \"\"\"Loads extension names from the specified source.\"\"\"\n        if self._source is None:\n            return []\n        return list(self._source)\n\nclass ExtensionService:\n    \"\"\"Business logic for finding the strongest extension.\"\"\"\n    def __init__(self, repository: 'ExtensionRepository', factory: 'ExtensionFactory') -> None:\n        self._repository = repository\n        self._factory = factory\n\n    def strongest(self, class_name: str, extensions: list) -> str:\n        \"\"\"Finds the strongest extension and returns formatted string.\"\"\"\n        if not extensions:\n            # If extensions list is empty and no exceptions can be raised per constraint.\n            return f\"{class_name}.\"\n\n        strongest_ext_obj = None\n        max_strength = -float('inf')\n\n        for ext_name in extensions:\n            current_ext_obj = self._factory.create(ext_name)\n            if current_ext_obj.strength > max_strength:\n                max_strength = current_ext_obj.strength\n                strongest_ext_obj = current_ext_obj\n\n        return f\"{class_name}.{strongest_ext_obj.name}\"\n\nclass ExtensionController:\n    \"\"\"Orchestrates service calls and formats output.\"\"\"\n    def __init__(self, service: 'ExtensionService') -> None:\n        self._service = service\n\n    def compute_strongest(self, class_name: str, extensions: list) -> str:\n        \"\"\"Computes the strongest extension and returns formatted string.\"\"\"\n        return self._service.strongest(class_name, extensions)\n\ndef Strongest_Extension(class_name, extensions):\n    \"\"\"\n    Finds the strongest extension based on CAP - SM strength and returns ClassName.StrongestExtensionName.\n    On ties, the first extension in the list is chosen.\n    \"\"\"\n    repo = ExtensionRepository(source=extensions)\n    calc = StrengthCalculator()\n    factory = ExtensionFactory(calculator=calc)\n    service = ExtensionService(repository=repo, factory=factory)\n    controller = ExtensionController(service=service)\n    return controller.compute_strongest(class_name, extensions)"}
{"task_id": "HumanEval/155", "solution": "def even_odd_count(num):\n    \"\"\"Given an integer. return a tuple that has the number of even and odd digits respectively.\n    \"\"\"\n    num_str = str(num)\n    if num_str.startswith('-') or num_str.startswith('+'):\n        num_str = num_str[1:]\n\n    even_count = 0\n    odd_count = 0\n\n    for digit_char in num_str:\n        # Based on DigitUtils snippet, check if char is in \"02468\"\n        if digit_char in \"02468\":\n            even_count += 1\n        else: # Assumes digit_char is a valid digit (0-9) as per validation context\n            odd_count += 1\n\n    return (even_count, odd_count)"}
{"task_id": "HumanEval/156", "solution": "NUMERAL_MAP = [\n    (1000, \"M\"), (900, \"CM\"), (500, \"D\"), (400, \"CD\"),\n    (100, \"C\"), (90, \"XC\"), (50, \"L\"), (40, \"XL\"),\n    (10, \"X\"), (9, \"IX\"), (5, \"V\"), (4, \"IV\"), (1, \"I\"),\n]\n\ndef int_to_mini_roman(number):\n    \"\"\"\n    Given a positive integer, obtain its roman numeral equivalent as a string,\n    and return it in lowercase.\n    Restrictions: 1 <= num <= 1000\n    \"\"\"\n    result = []\n    n = number\n    for value, numeral in NUMERAL_MAP:\n        while n >= value:\n            result.append(numeral)\n            n -= value\n    return \"\".join(result).lower()"}
{"task_id": "HumanEval/156", "solution": "def int_to_mini_roman(number):\n    \"\"\"\n    Given a positive integer, obtain its roman numeral equivalent as a string,\n    and return it in lowercase.\n    Restrictions: 1 <= num <= 1000\n    \"\"\"\n    roman_map = [\n        (1000, \"M\"), (900, \"CM\"), (500, \"D\"), (400, \"CD\"),\n        (100, \"C\"), (90, \"XC\"), (50, \"L\"), (40, \"XL\"),\n        (10, \"X\"), (9, \"IX\"), (5, \"V\"), (4, \"IV\"), (1, \"I\"),\n    ]\n\n    result_parts = []\n    n = number\n    for value, symbol in roman_map:\n        while n >= value:\n            result_parts.append(symbol)\n            n -= value\n    \n    return \"\".join(result_parts).lower()"}
{"task_id": "HumanEval/158", "solution": "def find_max(words):\n    \"\"\"\n    Finds the word with the maximum number of unique characters.\n    If multiple words have the same maximum unique character count,\n    returns the one that comes first in lexicographical order.\n    \"\"\"\n    return min(words, key=lambda word: (-len(set(word)), word))"}
{"task_id": "HumanEval/157", "solution": "def right_angle_triangle(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle. Return True if the three\n    sides form a right-angled triangle, False otherwise.\n    A right-angled triangle is a triangle in which one angle is right angle or \n    90 degree.\n    Example:\n    right_angle_triangle(3, 4, 5) == True\n    right_angle_triangle(1, 2, 3) == False\n    '''\n    # Define a small epsilon for floating-point comparisons to account for precision issues.\n    EPSILON = 1e-9\n\n    # Sort the sides to easily identify the two shorter sides (a, b) and the longest side (c).\n    sides = sorted([a, b, c])\n    s1, s2, s3 = sides[0], sides[1], sides[2]\n\n    # For a right-angled triangle, the Pythagorean theorem states a^2 + b^2 = c^2.\n    # We compare the square of the two shorter sides' sum to the square of the longest side.\n    return abs(s1*s1 + s2*s2 - s3*s3) <= EPSILON"}
{"task_id": "HumanEval/157", "solution": "def right_angle_triangle(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle. Return True if the three\n    sides form a right-angled triangle, False otherwise.\n    A right-angled triangle is a triangle in which one angle is right angle or \n    90 degree.\n    '''\n    \n    DEFAULT_TOLERANCE = 1e-9\n\n    def squared(x):\n        return x * x\n\n    def almost_equal(x, y, tol):\n        return abs(x - y) <= tol * max(1.0, abs(x), abs(y))\n\n    # Convert inputs to float\n    s1, s2, s3 = float(a), float(b), float(c)\n\n    # Validate sides: must be positive\n    if not (s1 > 0 and s2 > 0 and s3 > 0):\n        return False\n\n    # Check triangle inequality\n    # The sum of the lengths of any two sides of a triangle must be greater than the length of the third side.\n    if not (s1 + s2 > s3 and s1 + s3 > s2 and s2 + s3 > s1):\n        return False\n\n    # Sort sides to identify the potential hypotenuse (largest side)\n    sides = sorted([s1, s2, s3])\n    x, y, z = sides[0], sides[1], sides[2] # x, y are legs, z is hypotenuse\n\n    # Apply Pythagorean theorem: a^2 + b^2 = c^2\n    return almost_equal(squared(z), squared(x) + squared(y), DEFAULT_TOLERANCE)"}
{"task_id": "HumanEval/158", "solution": "def find_max(words):\n    \"\"\"\n    Returns the word with the maximum number of unique characters.\n    If multiple strings tie, the lexicographically smallest one is returned.\n    \"\"\"\n    if not words:\n        return \"\"\n\n    max_word = \"\"\n    max_unique_count = -1\n\n    for word in words:\n        current_unique_count = len(set(word))\n\n        if current_unique_count > max_unique_count:\n            max_unique_count = current_unique_count\n            max_word = word\n        elif current_unique_count == max_unique_count:\n            # Tie-breaking: return the lexicographically smallest word\n            if word < max_word:\n                max_word = word\n\n    return max_word"}
