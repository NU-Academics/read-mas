{"task_id": "HumanEval/123", "solution": "def get_odd_collatz(n):\n    \"\"\"\n    Given a positive integer n, return a sorted list that has the odd numbers in collatz sequence.\n    \"\"\"\n    odd_numbers = set()\n    current = n\n\n    while current != 1:\n        if current % 2 != 0:  # current is odd\n            odd_numbers.add(current)\n            current = 3 * current + 1\n        else:  # current is even\n            current = current // 2\n    \n    # The sequence always ends with 1, which is an odd number.\n    odd_numbers.add(1)\n    \n    return sorted(list(odd_numbers))"}
{"task_id": "HumanEval/123", "solution": "def get_odd_collatz(n):\n    \"\"\"\n    Given a positive integer n, return a sorted list that has the odd numbers in collatz sequence.\n    \"\"\"\n    collatz_sequence = []\n    current_num = n\n    \n    while True:\n        collatz_sequence.append(current_num)\n        if current_num == 1:\n            break\n        if current_num % 2 == 0:\n            current_num //= 2\n        else:\n            current_num = 3 * current_num + 1\n            \n    odd_numbers = {num for num in collatz_sequence if num % 2 != 0}\n    \n    return sorted(list(odd_numbers))"}
{"task_id": "HumanEval/124", "solution": "import re\n\ndef valid_date(date):\n    \"\"\"Validates a date string in 'mm-dd-yyyy' format against specific rules.\"\"\"\n\n    # Rule 1: The date string is not empty.\n    if not date:\n        return False\n\n    # Rule 4: The date should be in the format: mm-dd-yyyy\n    # Regex to capture month, day, and year components strictly in mm-dd-yyyy format.\n    # Month (mm) must be two digits, day (dd) can be one or two digits, year (yyyy) must be four digits.\n    date_re = re.compile(r\"^(?P<mm>\\d{2})-(?P<dd>\\d{1,2})-(?P<yyyy>\\d{4})$\")\n    match = date_re.match(date)\n\n    if not match:\n        return False\n\n    # Extract components as strings\n    month_str = match.group('mm')\n    day_str = match.group('dd')\n    # year_str = match.group('yyyy') # year is not validated beyond format, so not strictly needed as int\n\n    # Convert components to integers. If conversion fails (should not if regex is strict), return False.\n    try:\n        month = int(month_str)\n        day = int(day_str)\n        # year = int(year_str) # parsed but not used for further validation rules\n    except ValueError:\n        return False\n\n    # Rule 3: The months should not be less than 1 or higher than 12.\n    if not (1 <= month <= 12):\n        return False\n\n    # Rule 2: Validate day ranges based on the month.\n    months_31_days = {1, 3, 5, 7, 8, 10, 12}\n    months_30_days = {4, 6, 9, 11}\n\n    max_days = 0\n    if month in months_31_days:\n        max_days = 31\n    elif month in months_30_days:\n        max_days = 30\n    elif month == 2:  # February\n        # As per requirement, February allows up to 29 days, without considering leap years.\n        max_days = 29\n    else:\n        # This case should ideally not be reached if month is already validated between 1 and 12,\n        # and all valid months are covered by the above sets.\n        return False\n\n    # Check if the day is within the valid range for the determined month.\n    if not (1 <= day <= max_days):\n        return False\n\n    # All rules satisfied\n    return True"}
{"task_id": "HumanEval/125", "solution": "def split_words(txt):\n    \"\"\"\n    Splits a string of words based on precedence: whitespace, then commas,\n    or counts odd-ordered lowercase letters if no delimiters are found.\n    \"\"\"\n    # 1. Split on whitespace if any exists\n    if any(c.isspace() for c in txt):\n        return [t for t in txt.split() if t]\n\n    # 2. Split on commas if no whitespace but commas exist\n    if ',' in txt:\n        return [t.strip() for t in txt.split(',') if t.strip()]\n\n    # 3. Fallback: count lowercase letters with odd order in the alphabet\n    count = 0\n    for ch in txt:\n        if 'a' <= ch <= 'z':\n            idx = ord(ch) - ord('a')\n            if idx % 2 == 1:\n                count += 1\n    return count"}
{"task_id": "HumanEval/124", "solution": "def valid_date(date):\n    \"\"\"Validates a date string in 'mm-dd-yyyy' format according to specified rules.\"\"\"\n\n    def normalize_input(s: str) -> str:\n        \"\"\"Trims leading/trailing whitespace from the input string.\"\"\"\n        return s.strip()\n\n    def parse_int_or_none(s: str) -> Optional[int]:\n        \"\"\"Parses a string to an integer if it contains only digits, otherwise returns None.\"\"\"\n        if s.isdigit():\n            return int(s)\n        return None\n\n    # Defines the maximum allowed days for each month, with February allowing up to 29.\n    month_max_map = {\n        1: 31, 2: 29, 3: 31, 4: 30, 5: 31, 6: 30,\n        7: 31, 8: 31, 9: 30, 10: 31, 11: 30, 12: 31\n    }\n\n    s = normalize_input(date)\n\n    # Rule 1: The date string is not empty.\n    if not s:\n        return False\n\n    # Rule 4: The date should be in the format: mm-dd-yyyy\n    parts = s.split('-')\n    if len(parts) != 3:\n        return False\n\n    m_s, d_s, y_s = parts\n\n    # Validate year format: must be exactly 4 digits.\n    if len(y_s) != 4 or not y_s.isdigit():\n        return False\n\n    m = parse_int_or_none(m_s)\n    d = parse_int_or_none(d_s)\n    y = parse_int_or_none(y_s)\n\n    # Check if any part failed to parse into an integer (e.g., '0A-11-2000').\n    if m is None or d is None or y is None:\n        return False\n\n    # Rule 3: The months should not be less than 1 or higher than 12.\n    if not (1 <= m <= 12):\n        return False\n\n    # Rule 2: Validate the number of days based on the month.\n    # The month is guaranteed to be within [1,12] due to the previous check.\n    max_d = month_max_map.get(m)\n    if not (1 <= d <= max_d):\n        return False\n\n    return True"}
{"task_id": "HumanEval/126", "solution": "def is_sorted(lst):\n    \"\"\"\n    Given a list of numbers, return whether or not they are sorted\n    in ascending order. If list has more than 1 duplicate of the same\n    number, return False.\n    \"\"\"\n    if not lst:\n        return True\n\n    counts = {}\n    \n    # Initialize with the first element\n    prev = lst[0]\n    counts[prev] = 1\n\n    for i in range(1, len(lst)):\n        current = lst[i]\n\n        # Check for ascending order\n        if current < prev:\n            return False\n\n        # Update count for the current number\n        counts[current] = counts.get(current, 0) + 1\n\n        # Check for duplicate constraint (max 2 occurrences)\n        if counts[current] > 2:\n            return False\n        \n        prev = current\n\n    return True"}
{"task_id": "HumanEval/125", "solution": "def split_words(txt):\n    '''\n    Given a string of words, return a list of words split on whitespace, if no whitespaces exists in the text you\n    should split on commas ',' if no commas exists you should return the number of lower-case letters with odd order in the\n    alphabet, ord('a') = 0, ord('b') = 1, ... ord('z') = 25\n    Examples\n    split_words(\"Hello world!\") \u279e [\"Hello\", \"world!\"]\n    split_words(\"Hello,world!\") \u279e [\"Hello\", \"world!\"]\n    split_words(\"abcdef\") == 3 \n    '''\n    # Check for whitespace: any character in the string is a whitespace character.\n    # The condition `txt.strip() != \"\"` ensures that empty strings or strings containing only whitespace\n    # do not trigger this split, but fall through to the counting logic.\n    has_whitespace = any(char.isspace() for char in txt)\n    if txt.strip() != \"\" and has_whitespace:\n        return txt.split()\n    # Check for commas\n    elif \",\" in txt:\n        # Split by comma, preserving empty strings if ',-,' appears\n        return [part for part in txt.split(\",\")]\n    # No whitespace or commas, count lowercase letters with odd alphabetical order\n    else:\n        odd_order_count = 0\n        for char in txt:\n            if 'a' <= char <= 'z':\n                order = ord(char) - ord('a')\n                if order % 2 == 1:\n                    odd_order_count += 1\n        return odd_order_count"}
{"task_id": "HumanEval/126", "solution": "def is_sorted(lst):\n    '''\n    Given a list of numbers, return whether or not they are sorted\n    in ascending order. If list has more than 1 duplicate of the same\n    number, return False. Assume no negative numbers and only integers.\n    '''\n    if not lst:\n        return True\n\n    counts = {}\n    \n    for i in range(len(lst)):\n        current_val = lst[i]\n\n        # Check duplicate rule\n        counts[current_val] = counts.get(current_val, 0) + 1\n        if counts[current_val] > 2:\n            return False\n\n        # Check ascending order\n        if i > 0:\n            prev_val = lst[i-1]\n            if prev_val > current_val:\n                return False\n\n    return True"}
{"task_id": "HumanEval/127", "solution": "def intersection(interval1, interval2):\n    \"\"\"\n    Calculates the intersection of two intervals and determines if its length is a prime number.\n    Returns \"YES\" if the length is prime, \"NO\" otherwise.\n    \"\"\"\n    \n    def is_prime(n: int) -> bool:\n        \"\"\"Determines if a non-negative integer is a prime number.\"\"\"\n        if n <= 1:\n            return False\n        if n == 2:\n            return True\n        if n % 2 == 0:\n            return False\n        i = 3\n        while i * i <= n:\n            if n % i == 0:\n                return False\n            i += 2\n        return True\n\n    start1, end1 = interval1\n    start2, end2 = interval2\n\n    overlap_start = max(start1, start2)\n    overlap_end = min(end1, end2)\n\n    length = max(0, overlap_end - overlap_start)\n\n    if is_prime(length):\n        return \"YES\"\n    else:\n        return \"NO\""}
{"task_id": "HumanEval/127", "solution": "def intersection(interval1, interval2):\n    \"\"\"\n    Determines if the length of the intersection of two closed intervals is a prime number.\n    Returns \"YES\" if prime, \"NO\" otherwise or if no intersection.\n    \"\"\"\n    def is_prime(n: int) -> bool:\n        \"\"\"\n        Checks if a given non-negative integer is a prime number.\n        \"\"\"\n        if n < 2:\n            return False\n        if n == 2 or n == 3:\n            return True\n        if n % 2 == 0 or n % 3 == 0:\n            return False\n        i = 5\n        while i * i <= n:\n            if n % i == 0 or n % (i + 2) == 0:\n                return False\n            i += 6\n        return True\n\n    start1, end1 = interval1\n    start2, end2 = interval2\n\n    # Calculate the intersection interval\n    overlap_start = max(start1, start2)\n    overlap_end = min(end1, end2)\n\n    # If overlap_end is less than overlap_start, there is no intersection\n    if overlap_end < overlap_start:\n        return \"NO\"\n\n    # Calculate the length of the intersection\n    # The length for (a,b) is b-a based on problem examples\n    length = overlap_end - overlap_start\n\n    # Check if the length is a prime number\n    if is_prime(length):\n        return \"YES\"\n    else:\n        return \"NO\""}
{"task_id": "HumanEval/128", "solution": "from typing import List, Optional\n\ndef prod_signs(arr: List[int]) -> Optional[int]:\n    \"\"\"\n    Calculates the sum of magnitudes of integers multiplied by the product of their signs.\n    Returns None for an empty array, and 0 if any number in the array is zero.\n    \"\"\"\n    if not arr:\n        return None\n\n    def _sign(x: int) -> int:\n        \"\"\"Returns the sign of an integer: -1 for negative, 1 for positive, 0 for zero.\"\"\"\n        if x == 0:\n            return 0\n        return 1 if x > 0 else -1\n\n    sign_product = 1\n    magnitude_sum = 0\n\n    for x in arr:\n        if x == 0:\n            return 0\n        sign_product *= _sign(x)\n        magnitude_sum += abs(x)\n\n    return sign_product * magnitude_sum"}
{"task_id": "HumanEval/128", "solution": "def prod_signs(arr):\n    \"\"\"\n    Calculates sum of magnitudes of integers multiplied by product of all signs.\n    Returns None for an empty array.\n    \"\"\"\n    if not arr:\n        return None\n\n    sign_product = 1\n    magnitude_sum = 0\n\n    # Iterate through the array to determine the product of signs and sum of magnitudes.\n    # The presence of zero makes the overall sign product zero, resulting in a final value of 0.\n    for n in arr:\n        if n == 0:\n            # As per design, if any zero is present, the final result is 0.\n            return 0\n        \n        if n < 0:\n            sign_product *= -1\n        magnitude_sum += abs(n)\n\n    # Multiply the accumulated sign product by the sum of magnitudes.\n    return sign_product * magnitude_sum"}
{"task_id": "HumanEval/129", "solution": "from dataclasses import dataclass\nfrom typing import List, Tuple, Optional, Iterator\n\n@dataclass(frozen=True)\nclass Position:\n    \"\"\"Represents a (row, col) coordinate in the grid.\"\"\"\n    row: int\n    col: int\n\n    def to_tuple(self) -> Tuple[int, int]:\n        return (self.row, self.col)\n\nclass ValidationError(Exception):\n    \"\"\"Custom exception for validation errors.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\nclass GridModel:\n    \"\"\"Represents the game grid, providing validation and accessors.\"\"\"\n    def __init__(self, grid: List[List[int]]) -> None:\n        self.grid = grid\n        self.N = len(grid)\n        self.validate()\n\n    def validate(self) -> None:\n        if self.N < 2:\n            raise ValidationError(\"Grid must be at least 2x2\")\n        if any(len(row) != self.N for row in self.grid):\n            raise ValidationError(\"Grid must be square\")\n\n        expected = set(range(1, self.N * self.N + 1))\n        actual = {v for row in self.grid for v in row}\n        if actual != expected:\n            raise ValidationError(\"Grid values must be permutation of 1..N*N\")\n\n    def get_value(self, pos: Position) -> int:\n        return self.grid[pos.row][pos.col]\n\n    def get_positions(self) -> List[Position]:\n        positions = []\n        for r in range(self.N):\n            for c in range(self.N):\n                positions.append(Position(r, c))\n        return positions\n\nclass GridUtils:\n    \"\"\"Provides utility methods for grid operations like neighbor iteration and bounds checking.\"\"\"\n    def __init__(self, grid_model: GridModel) -> None:\n        self.grid_model = grid_model\n        self.N = grid_model.N\n\n    def in_bounds(self, pos: Position) -> bool:\n        return 0 <= pos.row < self.N and 0 <= pos.col < self.N\n\n    def iter_neighbors(self, pos: Position) -> Iterator[Position]:\n        # Defined order: Up, Left, Right, Down for deterministic processing\n        directions = [(-1, 0), (0, -1), (0, 1), (1, 0)]\n        for dr, dc in directions:\n            neighbor_pos = Position(pos.row + dr, pos.col + dc)\n            if self.in_bounds(neighbor_pos):\n                yield neighbor_pos\n\ndef lex_less(a: List[int], b: List[int]) -> bool:\n    \"\"\"Compares two lists lexicographically.\"\"\"\n    return a < b\n\nclass MemoRepository:\n    \"\"\"An in-memory cache for memoization in the DP algorithm.\"\"\"\n    def __init__(self) -> None:\n        self._store: dict[Tuple[int, int, int], List[int]] = {}\n\n    def get(self, key: Tuple[int, int, int]) -> Optional[List[int]]:\n        return self._store.get(key)\n\n    def set(self, key: Tuple[int, int, int], value: List[int]) -> None:\n        self._store[key] = value\n\nclass PathFinderService:\n    \"\"\"Core service for finding the lexicographically minimum path using dynamic programming.\"\"\"\n    def __init__(self, grid_model: GridModel, repo: MemoRepository) -> None:\n        self.grid_model = grid_model\n        self.repo = repo\n        self.utils = GridUtils(grid_model)\n\n    def find_min_path(self, k: int) -> List[int]:\n        if k < 1:\n            raise ValidationError(\"k must be >= 1\")\n\n        best_path_overall = None\n        for start_pos in self.grid_model.get_positions():\n            path_from_start = self._min_suffix(start_pos, k)\n            if best_path_overall is None or lex_less(path_from_start, best_path_overall):\n                best_path_overall = path_from_start\n        return best_path_overall\n\n    def _min_suffix(self, pos: Position, rem: int) -> List[int]:\n        memo_key = (rem, pos.row, pos.col)\n        cached_result = self.repo.get(memo_key)\n        if cached_result is not None:\n            return cached_result\n\n        current_value = self.grid_model.get_value(pos)\n\n        if rem == 1:\n            result = [current_value]\n            self.repo.set(memo_key, result)\n            return result\n\n        candidate_paths = []\n        for neighbor_pos in self.utils.iter_neighbors(pos):\n            next_suffix = self._min_suffix(neighbor_pos, rem - 1)\n            candidate_paths.append([current_value] + next_suffix)\n\n        best_next_path = self._choose_best(candidate_paths)\n        self.repo.set(memo_key, best_next_path)\n        return best_next_path\n\n    def _choose_best(self, candidates: List[List[int]]) -> List[int]:\n        if not candidates:\n            # This case should not be reached given problem constraints (N>=2, k>=1 and guaranteed unique answer).\n            raise ValueError(\"No candidates to choose from when finding best path.\")\n        \n        best_cand = candidates[0]\n        for i in range(1, len(candidates)):\n            if lex_less(candidates[i], best_cand):\n                best_cand = candidates[i]\n        return best_cand\n\ndef minPath(grid, k):\n    \"\"\"\n    Finds the minimum path of length k in the grid lexicographically.\n    \"\"\"\n    model = GridModel(grid)\n    repo = MemoRepository()\n    service = PathFinderService(model, repo)\n    return service.find_min_path(k)"}
{"task_id": "HumanEval/129", "solution": "```python\ndef minPath(grid, k):\n    \"\"\"\n    Given a grid with N rows and N columns (N >= 2) and a positive integer k, \n    each cell of the grid contains a value. Every integer in the range [1, N * N]\n    inclusive appears exactly once on the cells of the grid.\n\n    You have to find the minimum path of length k in the grid. You can start\n    from any cell, and in each step you can move to any of the neighbor cells,\n    in other words, you can go to cells which share an edge with you current\n    cell.\n    Please note that a path of length k means visiting exactly k cells (not\n    necessarily distinct).\n    You CANNOT go off the grid.\n    A path A (of length k) is considered less than a path B (of length k) if\n    after making the ordered lists of the values on the cells that A and B go\n    through (let's call them lst_A and lst_B), lst_A is lexicographically less\n    than lst_B, in other words, there exist an integer index i (1 <= i <= k)\n    such that lst_A[i] < lst_B[i] and for any j (1 <= j < i) we have\n    lst_A[j] = lst_B[j].\n    It is guaranteed that the answer is unique.\n    Return an ordered list of the values on the cells that the minimum path go through.\n    \"\"\"\n    N = len(grid)\n\n    # Helper function to find valid orthogonal neighbors (r, c)\n    def get_neighbors(r, c):\n        neighbors = []\n        # Possible moves: (dr, dc) for up, down, left, right\n        moves = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n        for dr, dc in moves:\n            nr, nc = r + dr, c + dc\n            # Check if the neighbor is within grid boundaries\n            if 0 <= nr < N and 0 <= nc < N:\n                neighbors.append((nr, nc))\n        return neighbors\n\n    # Pre-compute positions for each value for O(1) lookup.\n    # Since values are unique (1 to N*N exactly once), each value maps to a single (r, c).\n    value_to_pos = {}\n    for r_idx in range(N):\n        for c_idx in range(N):\n            value_to_pos[grid[r_idx][c_idx]] = (r_idx, c_idx)\n\n    path = []\n\n    # The first value in the lexicographically smallest path must be the smallest\n    # possible value in the grid, which is 1 (guaranteed to be present).\n    current_value = 1\n    current_pos = value_to_pos[current_value]\n\n    path.append(current_value)\n\n    # Iteratively build the rest of the path for k-1 more steps\n    for _ in range(k - 1):\n        min_next_neighbor_value = float('inf')\n        \n        # Get coordinates of neighbors from the current position\n        neighbors_coords = get_neighbors(current_pos[0], current_pos[1])\n        \n        # Find the smallest value among all immediate neighbors\n        for nr, nc in neighbors_coords:\n            neighbor_value = grid[nr][nc]\n            if neighbor_value < min_next_neighbor_value:\n                min_next_neighbor_value = neighbor_value\n        \n        # Append this smallest neighbor value to the path\n        path.append(min_next_neighbor_value)\n        \n        # Update current_pos to the unique position of the newly chosen value\n        current_pos = value_to_pos[min_next_neighbor_value]\n\n    return path\n```"}
{"task_id": "HumanEval/130", "solution": "def tri(n):\n    \"\"\"Computes the first n + 1 numbers of the Tribonacci sequence.\n    The sequence is defined by specific rules for even, odd, and base cases.\n    \"\"\"\n    if n < 0:\n        # As per design context, validation should happen before this function.\n        # This function assumes n is a non-negative integer.\n        return []\n\n    sequence = [0] * (n + 1)\n\n    for i in range(n + 1):\n        if i == 1:\n            sequence[1] = 3\n        elif i % 2 == 0:\n            # For even n, tri(n) = 1 + n / 2\n            sequence[i] = 1 + (i // 2)\n        else:\n            # For odd n, tri(n) = tri(n - 1) + tri(n - 2) + tri(n + 1)\n            # tri(n+1) will be an even number, so we can compute it directly.\n            tri_i_plus_1 = 1 + ((i + 1) // 2)\n            sequence[i] = sequence[i - 1] + sequence[i - 2] + tri_i_plus_1\n            \n    return sequence"}
{"task_id": "HumanEval/131", "solution": "def digits(n):\n    \"\"\"Given a positive integer n, return the product of the odd digits.\n    Return 0 if all digits are even.\"\"\"\n    product = 1\n    found_odd_digit = False\n    for char_digit in str(n):\n        digit = int(char_digit)\n        if digit % 2 == 1:\n            product *= digit\n            found_odd_digit = True\n    return product if found_odd_digit else 0"}
{"task_id": "HumanEval/130", "solution": "def tri(n):\n    \"\"\"Everyone knows Fibonacci sequence, it was studied deeply by mathematicians in \n    the last couple centuries. However, what people don't know is Tribonacci sequence.\n    Tribonacci sequence is defined by the recurrence:\n    tri(1) = 3\n    tri(n) = 1 + n / 2, if n is even.\n    tri(n) =  tri(n - 1) + tri(n - 2) + tri(n + 1), if n is odd.\n    For example:\n    tri(2) = 1 + (2 / 2) = 2\n    tri(4) = 3\n    tri(3) = tri(2) + tri(1) + tri(4)\n           = 2 + 3 + 3 = 8 \n    You are given a non-negative integer number n, you have to a return a list of the \n    first n + 1 numbers of the Tribonacci sequence.\n    Examples:\n    tri(3) = [1, 3, 2, 8]\n    \"\"\"\n    # Initialize a list to store the sequence elements from index 0 to n.\n    seq = [0] * (n + 1)\n\n    # Base case for tri(0), assumed to be 1 to match examples and design context.\n    seq[0] = 1\n\n    # Base case for tri(1).\n    if n >= 1:\n        seq[1] = 3\n\n    # Compute sequence elements from index 2 up to n using the recurrence rules.\n    for k in range(2, n + 1):\n        if k % 2 == 0:  # k is even\n            seq[k] = 1 + (k // 2)\n        else:  # k is odd\n            # For an odd k, tri(k+1) is needed. Since k is odd, k+1 is even.\n            # Thus, tri(k+1) can be computed directly using the even rule.\n            tri_kp1 = 1 + ((k + 1) // 2)\n            seq[k] = seq[k - 1] + seq[k - 2] + tri_kp1\n            \n    return seq"}
{"task_id": "HumanEval/132", "solution": "def is_nested(string):\n    \"\"\"\n    Checks if there's a subsequence of the form '[[]]' (two open brackets followed later by two close brackets).\n    This function implements a linear scan for the required pattern.\n    \"\"\"\n    n = len(string)\n    if n < 4:\n        return False\n\n    first_open_idx = -1\n    second_open_idx = -1\n\n    # Find the indices of the first two opening brackets '['\n    for i, char in enumerate(string):\n        if char == '[':\n            if first_open_idx == -1:\n                first_open_idx = i\n            elif second_open_idx == -1:\n                second_open_idx = i\n                break # Found the second opening bracket, stop scanning for opens\n\n    # If we couldn't find two opening brackets, nesting is impossible\n    if second_open_idx == -1:\n        return False\n\n    # Now, find two closing brackets ']' strictly AFTER the second opening bracket's index\n    close_count = 0\n    for i in range(second_open_idx + 1, n):\n        if string[i] == ']':\n            close_count += 1\n            if close_count == 2:\n                return True # Found two closing brackets after the second open\n\n    # No two closing brackets found after the second open\n    return False"}
{"task_id": "HumanEval/134", "solution": "def check_if_last_char_is_a_letter(txt):\n    \"\"\"\n    Checks if the last character of a string is a single alphabetic character\n    not part of a larger word.\n    \"\"\"\n    if not txt:\n        return False\n\n    # Split the string by spaces to get tokens.\n    # A trailing space will result in an empty string as the last token.\n    tokens = txt.split(' ')\n\n    # If there are no tokens, or the last token is an empty string,\n    # it means there's no valid last \"character\" as defined.\n    if not tokens or tokens[-1] == \"\":\n        return False\n\n    last_token = tokens[-1]\n\n    # Check if the last token is exactly one character and that character is alphabetic.\n    return len(last_token) == 1 and last_token.isalpha()"}
