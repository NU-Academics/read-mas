{"task_id": "HumanEval/81", "solution": "def numerical_letter_grade(grades):\n    \"\"\"It is the last week of the semester and the teacher has to give the grades\n    to students. The teacher has been making her own algorithm for grading.\n    The only problem is, she has lost the code she used for grading.\n    She has given you a list of GPAs for some students and you have to write \n    a function that can output a list of letter grades using the following table:\n             GPA       |    Letter grade\n              4.0                A+\n            > 3.7                A \n            > 3.3                A- \n            > 3.0                B+\n            > 2.7                B \n            > 2.3                B-\n            > 2.0                C+\n            > 1.7                C\n            > 1.3                C-\n            > 1.0                D+ \n            > 0.7                D \n            > 0.0                D-\n              0.0                E\n    \n\n    Example:\n    grade_equation([4.0, 3, 1.7, 2, 3.5]) ==> ['A+', 'B', 'C-', 'C', 'A-']\n    \"\"\"\n    letter_grades = []\n    \n    # Define the grading thresholds as specified in the problem and design context.\n    # The thresholds are ordered from highest GPA to lowest.\n    # 'inclusive=True' implies gpa >= min_gpa, 'inclusive=False' implies gpa > min_gpa.\n    THRESHOLDS = [\n        {\"min_gpa\": 4.0, \"letter\": \"A+\", \"inclusive\": True},\n        {\"min_gpa\": 3.7, \"letter\": \"A\", \"inclusive\": False},\n        {\"min_gpa\": 3.3, \"letter\": \"A-\", \"inclusive\": False},\n        {\"min_gpa\": 3.0, \"letter\": \"B+\", \"inclusive\": False},\n        {\"min_gpa\": 2.7, \"letter\": \"B\", \"inclusive\": False},\n        {\"min_gpa\": 2.3, \"letter\": \"B-\", \"inclusive\": False},\n        {\"min_gpa\": 2.0, \"letter\": \"C+\", \"inclusive\": False},\n        {\"min_gpa\": 1.7, \"letter\": \"C\", \"inclusive\": False},\n        {\"min_gpa\": 1.3, \"letter\": \"C-\", \"inclusive\": False},\n        {\"min_gpa\": 1.0, \"letter\": \"D+\", \"inclusive\": False},\n        {\"min_gpa\": 0.7, \"letter\": \"D\", \"inclusive\": False},\n        {\"min_gpa\": 0.0, \"letter\": \"D-\", \"inclusive\": False},\n        {\"min_gpa\": 0.0, \"letter\": \"E\", \"inclusive\": True}\n    ]\n\n    for gpa_input in grades:\n        gpa = float(gpa_input)\n\n        for threshold_data in THRESHOLDS:\n            min_gpa = threshold_data[\"min_gpa\"]\n            letter = threshold_data[\"letter\"]\n            inclusive = threshold_data[\"inclusive\"]\n\n            if inclusive:\n                if gpa >= min_gpa:\n                    letter_grades.append(letter)\n                    break\n            else:\n                if gpa > min_gpa:\n                    letter_grades.append(letter)\n                    break\n            \n    return letter_grades"}
{"task_id": "HumanEval/82", "solution": "def prime_length(string):\n    \"\"\"\n    Checks if the length of the string is a prime number.\n    \"\"\"\n    n = len(string)\n    if n < 2:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n    \n    # Check for odd divisors from 3 up to the square root of n\n    i = 3\n    while i * i <= n:\n        if n % i == 0:\n            return False\n        i += 2\n    return True"}
{"task_id": "HumanEval/80", "solution": "def is_happy(s):\n    \"\"\"\n    Checks if a string is happy: length >= 3 and every 3 consecutive letters are distinct.\n    \"\"\"\n    if len(s) < 3:\n        return False\n\n    def sliding_window(string, n):\n        \"\"\"Helper to yield n-length sliding windows of a string.\"\"\"\n        for i in range(len(string) - n + 1):\n            yield string[i:i+n]\n\n    for w in sliding_window(s, 3):\n        if len(set(w)) != 3:\n            return False\n    return True"}
{"task_id": "HumanEval/82", "solution": "import math\n\ndef prime_length(string):\n    \"\"\"\n    Checks if the length of the string is a prime number.\n    \"\"\"\n    n = len(string)\n\n    if n < 2:\n        return False\n    if n in (2, 3):\n        return True\n    if n % 2 == 0:\n        return False\n    \n    # Check for factors from 3 up to sqrt(n), skipping even numbers\n    r = int(math.sqrt(n))\n    for i in range(3, r + 1, 2):\n        if n % i == 0:\n            return False\n            \n    return True"}
{"task_id": "HumanEval/83", "solution": "def starts_one_ends(n):\n    \"\"\"\n    Given a positive integer n, return the count of the numbers of n-digit\n    positive integers that start or end with 1.\n    \"\"\"\n    if n == 1:\n        return 1\n    # For n >= 2, the formula is 10^(n-1) + 8 * 10^(n-2) which simplifies to 18 * 10^(n-2).\n    return 18 * (10 ** (n - 2))"}
{"task_id": "HumanEval/81", "solution": "def numerical_letter_grade(grades):\n    \"\"\"Converts a list of GPAs to a list of letter grades based on a specific grading table.\"\"\"\n\n    # Define the grading thresholds and exact grade for zero GPA.\n    # These thresholds are used with a strict greater-than (>) comparison.\n    _THRESHOLDS = [\n        (3.7, 'A'),\n        (3.3, 'A-'),\n        (3.0, 'B+'),\n        (2.7, 'B'),\n        (2.3, 'B-'),\n        (2.0, 'C+'),\n        (1.7, 'C'),\n        (1.3, 'C-'),\n        (1.0, 'D+'),\n        (0.7, 'D'),\n        (0.0, 'D-'),\n    ]\n    _EXACT_ZERO_GRADE = 'E'\n\n    class _GradeMapper:\n        \"\"\"Handles the core logic of mapping a single GPA to a letter grade.\"\"\"\n        def __init__(self, thresholds: list[tuple[float, str]], exact_zero_grade: str):\n            self._thresholds = thresholds\n            self._exact_zero_grade = exact_zero_grade\n\n        def map_single(self, gpa: float) -> str:\n            \"\"\"Maps a single GPA to its corresponding letter grade using strict greater-than rules.\"\"\"\n            if gpa == 4.0:\n                return 'A+'\n            if gpa == 0.0:\n                return self._exact_zero_grade\n            \n            for thresh_val, grade_letter in self._thresholds:\n                if gpa > thresh_val:\n                    return grade_letter\n            \n            # This fallback handles any remaining valid GPA values that are not strictly\n            # greater than 0.0 but not exactly 0.0, ensuring a D- grade as the lowest.\n            return 'D-'\n\n    class _GradeService:\n        \"\"\"Orchestrates GPA list processing and delegates single GPA mapping.\"\"\"\n        def __init__(self, mapper_instance: _GradeMapper):\n            self._mapper = mapper_instance\n\n        def map_gpas(self, gpas: list[float]) -> list[str]:\n            \"\"\"Converts each GPA in a list to its respective letter grade.\"\"\"\n            return [self._mapper.map_single(gpa) for gpa in gpas]\n\n    # Instantiate the mapper and service using the defined thresholds.\n    mapper_instance = _GradeMapper(_THRESHOLDS, _EXACT_ZERO_GRADE)\n    service_instance = _GradeService(mapper_instance)\n\n    # Use the service to map all grades from the input list.\n    return service_instance.map_gpas(grades)"}
