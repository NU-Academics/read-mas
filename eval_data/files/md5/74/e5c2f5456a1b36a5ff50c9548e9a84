{"task_id": "HumanEval/150", "solution": "def x_or_y(n, x, y):\n    \"\"\"A simple program which should return the value of x if n is \n    a prime number and should return the value of y otherwise.\n    \"\"\"\n\n    def _trial_division(num: int) -> bool:\n        \"\"\"Performs trial division for factors from 5 up to sqrt(num).\n        Returns False if a factor is found (composite), True otherwise (potentially prime).\n        Assumes num is odd and not divisible by 3.\n        \"\"\"\n        i = 5\n        while i * i <= num:\n            if num % i == 0 or num % (i + 2) == 0:\n                return False\n            i += 6\n        return True\n\n    def _miller_rabin(num: int, bases: list[int]) -> bool:\n        \"\"\"Performs the Miller-Rabin primality test.\n        Assumes num > 3 and is odd.\n        \"\"\"\n        # Find d and s such that num - 1 = d * 2^s, where d is odd\n        d = num - 1\n        s = 0\n        while d % 2 == 0:\n            d //= 2\n            s += 1\n\n        for a in bases:\n            if a >= num: # Base 'a' must be less than 'num' for the test to be valid\n                continue\n\n            x_mr = pow(a, d, num)\n\n            if x_mr == 1 or x_mr == num - 1:\n                continue\n\n            # Check x_mr^(2^r) % num == num - 1 for 0 <= r < s\n            for _ in range(s - 1):\n                x_mr = pow(x_mr, 2, num)\n                if x_mr == num - 1:\n                    break\n            else: # If loop completes, num is composite\n                return False\n        return True # num is very likely prime\n\n    def is_prime(num: int) -> bool:\n        \"\"\"Determines if a number is prime using initial checks, trial division, and Miller-Rabin.\"\"\"\n        if num < 2:\n            return False\n        if num == 2 or num == 3:\n            return True\n        if num % 2 == 0 or num % 3 == 0: # Handles even numbers > 2 and multiples of 3 > 3\n            return False\n\n        # If it passes initial checks, apply trial division for larger prime factors\n        if not _trial_division(num):\n            return False # Found a factor, it's composite\n\n        # If trial division passes, apply deterministic Miller-Rabin\n        # Bases specified by design context for 64-bit integers\n        bases_for_mr = [2, 3, 5, 7, 11, 13]\n        return _miller_rabin(num, bases_for_mr)\n\n    if is_prime(n):\n        return x\n    else:\n        return y"}
{"task_id": "HumanEval/150", "solution": "import math\n\ndef x_or_y(n, x, y):\n    \"\"\"A simple program which should return the value of x if n is \n    a prime number and should return the value of y otherwise.\n    \"\"\"\n    def _is_prime_simple(num: int) -> bool:\n        if num <= 1:\n            return False\n        if num <= 3:\n            return True\n        if num % 2 == 0:\n            return False\n        r = int(math.isqrt(num))\n        i = 3\n        while i <= r:\n            if num % i == 0:\n                return False\n            i += 2\n        return True\n\n    if _is_prime_simple(n):\n        return x\n    else:\n        return y"}
