{"task_id": "HumanEval/140", "solution": "def fix_spaces(text):\n    \"\"\"\n    Replaces spaces with underscores or hyphens based on consecutive count.\n    More than 2 consecutive spaces become a single hyphen, otherwise each space becomes an underscore.\n    \"\"\"\n    out_chars = []\n    i = 0\n    n = len(text)\n    while i < n:\n        if text[i] == \" \":\n            j = i\n            while j < n and text[j] == \" \":\n                j += 1\n            run_len = j - i\n            if run_len > 2:\n                out_chars.append(\"-\")\n            else:\n                out_chars.append(\"_\" * run_len)\n            i = j\n        else:\n            out_chars.append(text[i])\n            i += 1\n    return \"\".join(out_chars)"}
{"task_id": "HumanEval/140", "solution": "def fix_spaces(text):\n    \"\"\"\n    Replaces spaces with underscores or hyphens based on consecutive count.\n    Single or double spaces become underscores; three or more become a single hyphen.\n    \"\"\"\n    out_chars = []\n    i = 0\n    n = len(text)\n    while i < n:\n        if text[i] != ' ':\n            out_chars.append(text[i])\n            i += 1\n            continue\n        \n        j = i\n        while j < n and text[j] == ' ':\n            j += 1\n        \n        run_len = j - i\n        if run_len >= 3:\n            out_chars.append('-')\n        else:\n            out_chars.extend('_' * run_len)\n        \n        i = j\n    return ''.join(out_chars)"}
{"task_id": "HumanEval/139", "solution": "def special_factorial(n):\n    \"\"\"The Brazilian factorial is defined as:\n    brazilian_factorial(n) = n! * (n-1)! * (n-2)! * ... * 1!\n    where n > 0\n\n    For example:\n    >>> special_factorial(4)\n    288\n\n    The function will receive an integer as input and should return the special\n    factorial of this integer.\n    \"\"\"\n    special_fact_result = 1\n    current_factorial = 1\n\n    for k in range(1, n + 1):\n        # Calculate k! iteratively from (k-1)!\n        current_factorial *= k\n        # Multiply the special factorial result by k!\n        special_fact_result *= current_factorial\n\n    return special_fact_result"}
{"task_id": "HumanEval/139", "solution": "def special_factorial(n):\n    \"\"\"The Brazilian factorial is defined as:\n    brazilian_factorial(n) = n! * (n-1)! * (n-2)! * ... * 1!\n    where n > 0\n\n    For example:\n    >>> special_factorial(4)\n    288\n\n    The function will receive an integer as input and should return the special\n    factorial of this integer.\n    \"\"\"\n    # Cache to store computed factorials to avoid redundant calculations.\n    # Initializes with base cases for factorial(0) and factorial(1).\n    factorial_cache = {0: 1, 1: 1}\n\n    def get_factorial(k):\n        \"\"\"Computes factorial k! using memoization.\"\"\"\n        if k in factorial_cache:\n            return factorial_cache[k]\n        \n        # Calculate k! based on (k-1)!\n        current_factorial = get_factorial(k - 1) * k\n        factorial_cache[k] = current_factorial\n        return current_factorial\n\n    brazilian_factorial_result = 1\n    # Calculate BF(n) = n! * (n-1)! * ... * 1! by multiplying factorials incrementally.\n    for i in range(1, n + 1):\n        fact_i = get_factorial(i)\n        brazilian_factorial_result *= fact_i\n\n    return brazilian_factorial_result"}
{"task_id": "HumanEval/141", "solution": "def file_name_check(file_name):\n    \"\"\"Checks if a file's name is valid based on specific rules.\"\"\"\n    \n    # Condition 2: The file's name contains exactly one dot '.'\n    if file_name.count('.') != 1:\n        return 'No'\n\n    prefix, suffix = file_name.split('.', 1)\n\n    # Condition 3a: The substring before the dot should not be empty\n    if not prefix:\n        return 'No'\n\n    # Condition 3b: The substring before the dot starts with a letter\n    first_char_prefix = prefix[0]\n    if not ('a' <= first_char_prefix <= 'z' or 'A' <= first_char_prefix <= 'Z'):\n        return 'No'\n\n    # Condition 1: There should not be more than three digits ('0'-'9')\n    digit_count = 0\n    for char in file_name:\n        if '0' <= char <= '9':\n            digit_count += 1\n    if digit_count > 3:\n        return 'No'\n\n    # Condition 4: The substring after the dot should be one of these: ['txt', 'exe', 'dll']\n    allowed_extensions = ['txt', 'exe', 'dll']\n    if suffix.lower() not in allowed_extensions:\n        return 'No'\n\n    return 'Yes'"}
{"task_id": "HumanEval/141", "solution": "def file_name_check(file_name):\n    \"\"\"Checks if a file's name is valid based on specific rules.\"\"\"\n\n    # Rule 2: The file's name contains exactly one dot '.'\n    if file_name.count('.') != 1:\n        return 'No'\n\n    parts = file_name.split('.')\n    name_part = parts[0]\n    extension_part = parts[1]\n\n    # Rule 3: The substring before the dot should not be empty\n    # and it starts with a letter from the latin alphabet ('a'-'z' and 'A'-'Z').\n    if not name_part or not name_part[0].isalpha():\n        return 'No'\n\n    # Rule 4: The substring after the dot should be one of these: ['txt', 'exe', 'dll']\n    allowed_extensions = ['txt', 'exe', 'dll']\n    if extension_part.lower() not in allowed_extensions:\n        return 'No'\n\n    # Rule 1: There should not be more than three digits ('0'-'9') in the file's name.\n    digit_count = 0\n    for char in file_name:\n        if '0' <= char <= '9': # Equivalent to char.isdigit() for ASCII digits\n            digit_count += 1\n    if digit_count > 3:\n        return 'No'\n\n    # If all conditions are met\n    return 'Yes'"}
{"task_id": "HumanEval/142", "solution": "def sum_squares(lst):\n    \"\"\"\n    Calculates a transformed sum of elements in a list based on their indices.\n    Elements are squared if their index is a multiple of 3, cubed if their index\n    is a multiple of 4 but not 3, and otherwise unchanged before summing.\n    \"\"\"\n    total_sum = 0\n    for index, value in enumerate(lst):\n        if index % 3 == 0:\n            total_sum += value ** 2\n        elif index % 4 == 0:\n            total_sum += value ** 3\n        else:\n            total_sum += value\n    return total_sum"}
{"task_id": "HumanEval/142", "solution": "def sum_squares(lst):\n    \"\"\"\n    This function will take a list of integers. For all entries in the list, the function shall square the integer entry if its index is a \n    multiple of 3 and will cube the integer entry if its index is a multiple of 4 and not a multiple of 3. The function will not \n    change the entries in the list whose indexes are not a multiple of 3 or 4. The function shall then return the sum of all entries. \n    \"\"\"\n    total = 0\n    for i, v in enumerate(lst):\n        transformed_value = v\n        if i % 3 == 0:\n            transformed_value = v * v\n        elif i % 4 == 0:  # This condition implies i % 3 != 0 due to the 'elif'\n            transformed_value = v * v * v\n        # If neither condition is met, transformed_value remains v\n        total += transformed_value\n    return total"}
{"task_id": "HumanEval/143", "solution": "import math\n\ndef words_in_sentence(sentence):\n    \"\"\"\n    Filters words from a sentence, returning only those with prime lengths.\n    \"\"\"\n    def is_prime(n):\n        \"\"\"Checks if a number n is prime.\"\"\"\n        if n < 2:\n            return False\n        if n in (2, 3):\n            return True\n        if n % 2 == 0:\n            return False\n        limit = int(math.sqrt(n))\n        for i in range(3, limit + 1, 2):\n            if n % i == 0:\n                return False\n        return True\n\n    words = sentence.split()\n    prime_length_words = [word for word in words if is_prime(len(word))]\n    return \" \".join(prime_length_words)"}
{"task_id": "HumanEval/143", "solution": "def words_in_sentence(sentence):\n    \"\"\"\n    Filters words from a sentence whose lengths are prime numbers, preserving order.\n    \"\"\"\n    def is_prime(n: int) -> bool:\n        \"\"\"Checks if a number is prime.\"\"\"\n        if n < 2:\n            return False\n        if n % 2 == 0:\n            return n == 2\n        i = 3\n        while i * i <= n:\n            if n % i == 0:\n                return False\n            i += 2\n        return True\n\n    words = sentence.split()\n    prime_length_words = []\n    for word in words:\n        if is_prime(len(word)):\n            prime_length_words.append(word)\n\n    return \" \".join(prime_length_words)"}
{"task_id": "HumanEval/144", "solution": "import math\nimport re\n\ndef simplify(x, n):\n    \"\"\"\n    Checks if the product of two fractions, x and n, is a whole number.\n    Fractions are given as strings \"numerator/denominator\".\n    \"\"\"\n\n    class FractionModel:\n        \"\"\"Represents a fraction and provides arithmetic operations.\"\"\"\n        def __init__(self, numerator: int, denominator: int):\n            self.numerator = numerator\n            self.denominator = denominator\n            self.reduce()\n\n        def reduce(self):\n            common_divisor = math.gcd(self.numerator, self.denominator)\n            self.numerator //= common_divisor\n            self.denominator //= common_divisor\n\n        def multiply(self, other: 'FractionModel') -> 'FractionModel':\n            new_numerator = self.numerator * other.numerator\n            new_denominator = self.denominator * other.denominator\n            return FractionModel(new_numerator, new_denominator)\n\n        def is_whole(self) -> bool:\n            return self.numerator % self.denominator == 0\n\n    FRACTION_RE = r'^\\s*(\\d+)\\s*/\\s*(\\d+)\\s*$'\n\n    def parse_fraction_string(fraction_str: str) -> FractionModel:\n        \"\"\"Parses a fraction string into a FractionModel.\"\"\"\n        match = re.match(FRACTION_RE, fraction_str)\n        # Per problem assumptions, inputs are valid fractions and regex will match.\n        numerator = int(match.group(1))\n        denominator = int(match.group(2))\n        return FractionModel(numerator, denominator)\n\n    fraction_x = parse_fraction_string(x)\n    fraction_n = parse_fraction_string(n)\n\n    product_fraction = fraction_x.multiply(fraction_n)\n\n    return product_fraction.is_whole()"}
{"task_id": "HumanEval/144", "solution": "def simplify(x, n):\n    \"\"\"Checks if the product of two fraction strings is a whole number.\n    Returns True if x * n evaluates to a whole number, False otherwise.\n    \"\"\"\n\n    # Helper function for Greatest Common Divisor\n    def _gcd(a: int, b: int) -> int:\n        a, b = abs(a), abs(b)\n        while b:\n            a, b = b, a % b\n        return a\n\n    # Exception class (not raised due to problem constraints on input validation)\n    class FractionParseError(Exception):\n        pass\n\n    # Represents a fraction and provides operations\n    class FractionModel:\n        def __init__(self, numerator: int, denominator: int) -> None:\n            self.numerator = numerator\n            self.denominator = denominator\n            # normalize() and reduce() are called as per design's __init__ snippet.\n            # `normalize` is a no-op as inputs are guaranteed valid and positive.\n            self.normalize()\n            self.reduce()\n\n        def normalize(self) -> None:\n            # Input fractions are guaranteed to be valid and positive (numerator/denominator > 0).\n            pass\n\n        def multiply(self, other: \"FractionModel\") -> \"FractionModel\":\n            # Returns a new FractionModel, which will automatically reduce itself upon creation.\n            return FractionModel(self.numerator * other.numerator, self.denominator * other.denominator)\n\n        def reduce(self) -> None:\n            # Reduces the fraction in-place using the GCD helper.\n            g = _gcd(self.numerator, self.denominator)\n            self.numerator //= g\n            self.denominator //= g\n\n        def is_whole(self) -> bool:\n            # A fraction is a whole number if its denominator is 1 after reduction.\n            return self.denominator == 1\n\n    # Parses fraction strings into FractionModel objects\n    class FractionParser:\n        def parse(self, fraction_str: str) -> FractionModel:\n            # Inputs are guaranteed to be valid and in \"num/den\" format.\n            parts = fraction_str.split('/')\n            num = int(parts[0])\n            den = int(parts[1])\n            return FractionModel(num, den)\n\n    # Repository for logging, implemented as a no-op as per design.\n    class FractionRepository:\n        def log_check(self, x_str: str, n_str: str, result: bool) -> None:\n            pass\n\n    # Core business logic service\n    class SimplifyService:\n        def __init__(self, parser: FractionParser, repository: FractionRepository) -> None:\n            self.parser = parser\n            self.repository = repository\n\n        def simplify(self, x_str: str, n_str: str) -> bool:\n            # Parse both input fraction strings.\n            f1 = self.parser.parse(x_str)\n            f2 = self.parser.parse(n_str)\n\n            # Multiply the fractions; the product automatically reduces upon creation.\n            product = f1.multiply(f2)\n\n            # Check if the product is a whole number.\n            result = product.is_whole()\n\n            # Log the check result (this is a no-op).\n            self.repository.log_check(x_str, n_str, result)\n            return result\n\n    # Instantiate the necessary components for the service.\n    _parser_instance = FractionParser()\n    _repository_instance = FractionRepository()\n    _service_instance = SimplifyService(_parser_instance, _repository_instance)\n\n    # Execute the simplification logic using the service.\n    return _service_instance.simplify(x, n)"}
{"task_id": "HumanEval/146", "solution": "def specialFilter(nums):\n    \"\"\"\n    Counts elements in the array that are greater than 10 and have both \n    first and last digits odd.\n    \"\"\"\n    count = 0\n    odd_digits = {1, 3, 5, 7, 9}\n\n    for num in nums:\n        if num > 10:\n            # Extract digits by converting to string, ignoring sign\n            abs_num_str = str(abs(num))\n            \n            first_digit = int(abs_num_str[0])\n            last_digit = int(abs_num_str[-1])\n            \n            if first_digit in odd_digits and last_digit in odd_digits:\n                count += 1\n    return count"}
{"task_id": "HumanEval/145", "solution": "def order_by_points(nums):\n    \"\"\"\n    Sorts a list of integers based on the sum of their digits,\n    maintaining original order for ties.\n    \"\"\"\n    def compute_digit_sum(value):\n        \"\"\"Calculates the sum of the absolute value's digits.\"\"\"\n        return sum(int(d) for d in str(abs(value)))\n\n    # Create a list of tuples: (original_value, original_index, digit_sum)\n    # The original_index is used for stable sorting if digit_sums are equal.\n    annotated_nums = []\n    for i, num in enumerate(nums):\n        digit_sum = compute_digit_sum(num)\n        annotated_nums.append((num, i, digit_sum))\n\n    # Sort the annotated list.\n    # The primary key is digit_sum (item[2]), secondary key is original_index (item[1]).\n    # Python's `sorted` is stable, and tuple comparison ensures correct ordering.\n    sorted_annotated_nums = sorted(annotated_nums, key=lambda item: (item[2], item[1]))\n\n    # Extract the original values from the sorted list to form the result.\n    result = [item[0] for item in sorted_annotated_nums]\n\n    return result"}
{"task_id": "HumanEval/146", "solution": "def specialFilter(nums):\n    \"\"\"Counts numbers in an array that are greater than 10 and have odd first and last digits.\"\"\"\n    count = 0\n    ODD_DIGITS = {1, 3, 5, 7, 9}\n\n    def is_odd_digit(d: int) -> bool:\n        \"\"\"Checks if a single digit is odd.\"\"\"\n        return d in ODD_DIGITS\n\n    def first_digit(n: int) -> int:\n        \"\"\"Extracts the first decimal digit of the absolute value of n.\"\"\"\n        n = abs(n)\n        if n == 0:\n            return 0\n        while n >= 10:\n            n //= 10\n        return n\n\n    def last_digit(n: int) -> int:\n        \"\"\"Extracts the last decimal digit of the absolute value of n.\"\"\"\n        return abs(n) % 10\n\n    for num in nums:\n        # Check if the number is strictly greater than 10.\n        # Digits are extracted from the absolute value of the integer representation.\n        if num > 10:\n            # Coerce the number to an integer to ensure consistent digit extraction,\n            # handling cases like 15.0 by converting to 15.\n            num_val = int(num)\n\n            first_d = first_digit(num_val)\n            last_d = last_digit(num_val)\n\n            if is_odd_digit(first_d) and is_odd_digit(last_d):\n                count += 1\n    return count"}
{"task_id": "HumanEval/145", "solution": "def order_by_points(nums):\n    \"\"\"\n    Sorts a list of integers based on the sum of their digits,\n    then by original index for ties, in ascending order.\n    \"\"\"\n\n    def _get_digit_sum(n):\n        \"\"\"Calculates the sum of the absolute digits of an integer.\"\"\"\n        return sum(int(digit) for digit in str(abs(n)))\n\n    # Create a list of tuples: (digit_sum, original_index, value)\n    # This allows sorting by digit_sum, then index for stable tie-breaking.\n    augmented_nums = []\n    for i, num in enumerate(nums):\n        augmented_nums.append((_get_digit_sum(num), i, num))\n\n    # Sort the augmented list. Python's Timsort is stable,\n    # and sorting by a tuple automatically applies the order of elements.\n    augmented_nums.sort()\n\n    # Extract the original values from the sorted list\n    return [num for _, _, num in augmented_nums]"}
{"task_id": "HumanEval/147", "solution": "    \n    def _comb(n, k):\n        \"\"\"Helper function to calculate n choose k.\"\"\"\n        if k < 0 or k > n:\n            return 0\n        if k == 0 or k == n:\n            return 1\n        if k == 1:\n            return n\n        if k == 2:\n            return n * (n - 1) // 2\n        if k == 3:\n            return n * (n - 1) * (n - 2) // 6\n        # For k > 3, we can generalize, but k=3 is the only case needed here.\n        # This implementation covers the specific needs for this problem.\n        return 0 # Should not be reached given problem constraints on k\n\n    # Calculate counts of i values (1 to n) for each remainder modulo 3\n    # cnt_i_mod0: count of i such that i % 3 == 0\n    # cnt_i_mod1: count of i such that i % 3 == 1\n    # cnt_i_mod2: count of i such that i % 3 == 2\n    \n    base = n // 3\n    rem = n % 3\n\n    cnt_i_mod0 = base\n    cnt_i_mod1 = base + (1 if rem >= 1 else 0)\n    cnt_i_mod2 = base + (1 if rem >= 2 else 0)\n\n    # Determine a[i] % 3 pattern:\n    # If i % 3 == 2, then a[i] % 3 == 0\n    # If i % 3 == 0 or i % 3 == 1, then a[i] % 3 == 1\n    \n    # c0: count of a[i] such that a[i] % 3 == 0\n    # c1: count of a[i] such that a[i] % 3 == 1\n    \n    c0 = cnt_i_mod2\n    c1 = cnt_i_mod0 + cnt_i_mod1\n\n    # For a sum (x + y + z) to be a multiple of 3, either all three (x, y, z)\n    # must be 0 (mod 3), or all three must be 1 (mod 3).\n    # This is because a[i] % 3 only takes values 0 or 1.\n    # (0+0+0)%3 = 0\n    # (1+1+1)%3 = 3%3 = 0\n    # Other combinations (e.g., 0+0+1, 0+1+1) are not multiples of 3.\n\n    # Total triples = (combinations of 3 items from c0) + (combinations of 3 items from c1)\n    \n    result = _comb(c0, 3) + _comb(c1, 3)\n    return result"}
{"task_id": "HumanEval/147", "solution": "def get_max_triples(n):\n    \"\"\"\n    Calculates the number of triples (a[i], a[j], a[k]) from the sequence\n    where a[x] = x*x - x + 1, such that i < j < k and a[i] + a[j] + a[k] is a multiple of 3.\n    \"\"\"\n\n    def comb(n_val, k_val):\n        \"\"\"Calculates n choose k, specifically optimized for k=3.\"\"\"\n        if k_val < 0 or n_val < k_val:\n            return 0\n        if k_val == 3:\n            return n_val * (n_val - 1) * (n_val - 2) // 6\n        return 0\n\n    # For a[x] = x*x - x + 1:\n    # It can be observed that a[x] % 3 == 0 if x % 3 == 2\n    # And a[x] % 3 == 1 if x % 3 == 0 or x % 3 == 1\n\n    # Calculate counts of indices i (1-based) where i % 3 gives a specific remainder\n    base = n // 3\n    r = n % 3\n\n    cnt_i_mod1 = base + (1 if r >= 1 else 0) # Count of i where i % 3 == 1\n    cnt_i_mod2 = base + (1 if r >= 2 else 0) # Count of i where i % 3 == 2\n    cnt_i_mod0 = base                        # Count of i where i % 3 == 0\n\n    # Counts of a[i] values based on their remainder modulo 3\n    # cnt_value0: number of a[i] such that a[i] % 3 == 0\n    cnt_value0 = cnt_i_mod2\n    \n    # cnt_value1: number of a[i] such that a[i] % 3 == 1\n    cnt_value1 = cnt_i_mod0 + cnt_i_mod1\n\n    # The sum a[i] + a[j] + a[k] is a multiple of 3 if:\n    # 1. All three a values are 0 (mod 3) (0+0+0 = 0 mod 3)\n    # 2. All three a values are 1 (mod 3) (1+1+1 = 3 = 0 mod 3)\n    # No other combination of 0s and 1s (mod 3) will sum to 0 (mod 3).\n\n    total_triples = comb(cnt_value0, 3) + comb(cnt_value1, 3)\n\n    return total_triples"}
{"task_id": "HumanEval/149", "solution": "def sorted_list_sum(lst):\n    \"\"\"Filters a list of strings to include only even-length strings, then sorts them by length and alphabetically.\"\"\"\n    even_length_strings = [s for s in lst if len(s) % 2 == 0]\n    return sorted(even_length_strings, key=lambda s: (len(s), s))"}
{"task_id": "HumanEval/148", "solution": "from dataclasses import dataclass\nfrom typing import Tuple, List, Dict\n\n@dataclass\nclass PlanetModel:\n    \"\"\"Represents a planet with its name and order from the Sun.\"\"\"\n    name: str\n    order_index: int\n\nCANONICAL_PLANETS: List[PlanetModel] = [\n    PlanetModel(\"Mercury\", 1),\n    PlanetModel(\"Venus\", 2),\n    PlanetModel(\"Earth\", 3),\n    PlanetModel(\"Mars\", 4),\n    PlanetModel(\"Jupiter\", 5),\n    PlanetModel(\"Saturn\", 6),\n    PlanetModel(\"Uranus\", 7),\n    PlanetModel(\"Neptune\", 8),\n]\n\ndef normalize_name(name: str) -> str:\n    \"\"\"Normalizes a planet name for case-insensitive comparison.\"\"\"\n    return name.strip().capitalize()\n\nclass PlanetRepository:\n    \"\"\"Provides access to canonical planet data.\"\"\"\n    def get_all(self) -> List[PlanetModel]:\n        \"\"\"Returns the canonical list of all planets.\"\"\"\n        return list(CANONICAL_PLANETS)\n\nclass PlanetService:\n    \"\"\"Business logic for planet operations.\"\"\"\n    def __init__(self, repo: PlanetRepository) -> None:\n        self._repo = repo\n\n    def planets_between(self, planet1: str, planet2: str, raise_on_invalid: bool = False) -> Tuple[str, ...]:\n        \"\"\"\n        Returns planets whose orbits are strictly between planet1 and planet2.\n        If inputs are invalid, returns an empty tuple by default.\n        \"\"\"\n        planets = self._repo.get_all()\n        \n        # Create a mapping for quick lookup and normalize input names\n        name_to_index: Dict[str, int] = {p.name: p.order_index for p in planets}\n        p1_norm = normalize_name(planet1)\n        p2_norm = normalize_name(planet2)\n\n        # Validate planet names\n        if p1_norm not in name_to_index or p2_norm not in name_to_index:\n            # According to the problem description, return empty tuple for invalid names.\n            return tuple()\n\n        idx1, idx2 = name_to_index[p1_norm], name_to_index[p2_norm]\n\n        # Determine the lower and higher order indices\n        lo, hi = min(idx1, idx2), max(idx1, idx2)\n\n        # Collect planets whose indices are strictly between lo and hi\n        result_planets: List[str] = []\n        for p in planets:\n            if lo < p.order_index < hi:\n                result_planets.append(p.name)\n        \n        return tuple(result_planets)\n\n# Instantiate a default service for the bf function to use\n_default_planet_service = PlanetService(PlanetRepository())\n\ndef bf(planet1, planet2):\n    '''\n    There are eight planets in our solar system: the closerst to the Sun \n    is Mercury, the next one is Venus, then Earth, Mars, Jupiter, Saturn, \n    Uranus, Neptune.\n    Write a function that takes two planet names as strings planet1 and planet2. \n    The function should return a tuple containing all planets whose orbits are \n    located between the orbit of planet1 and the orbit of planet2, sorted by \n    the proximity to the sun. \n    The function should return an empty tuple if planet1 or planet2\n    are not correct planet names. \n    Examples\n    bf(\"Jupiter\", \"Neptune\") ==> (\"Saturn\", \"Uranus\")\n    bf(\"Earth\", \"Mercury\") ==> (\"Venus\")\n    bf(\"Mercury\", \"Uranus\") ==> (\"Venus\", \"Earth\", \"Mars\", \"Jupiter\", \"Saturn\")\n    '''\n    return _default_planet_service.planets_between(planet1, planet2)"}
{"task_id": "HumanEval/148", "solution": "def bf(planet1, planet2):\n    '''\n    There are eight planets in our solar system: the closerst to the Sun \n    is Mercury, the next one is Venus, then Earth, Mars, Jupiter, Saturn, \n    Uranus, Neptune.\n    Write a function that takes two planet names as strings planet1 and planet2. \n    The function should return a tuple containing all planets whose orbits are \n    located between the orbit of planet1 and the orbit of planet2, sorted by \n    the proximity to the sun. \n    The function should return an empty tuple if planet1 or planet2\n    are not correct planet names. \n    Examples\n    bf(\"Jupiter\", \"Neptune\") ==> (\"Saturn\", \"Uranus\")\n    bf(\"Earth\", \"Mercury\") ==> (\"Venus\")\n    bf(\"Mercury\", \"Uranus\") ==> (\"Venus\", \"Earth\", \"Mars\", \"Jupiter\", \"Saturn\")\n    '''\n    # Canonical order of planets from the Sun.\n    CANONICAL_PLANETS = [\n        \"Mercury\", \"Venus\", \"Earth\", \"Mars\",\n        \"Jupiter\", \"Saturn\", \"Uranus\", \"Neptune\"\n    ]\n\n    # Helper function to normalize planet names (strip whitespace and title-case).\n    def normalize_name(name: str) -> str:\n        if not isinstance(name, str):\n            return \"\"\n        return name.strip().title()\n\n    # Helper function to get the 0-based index of a planet in the canonical list.\n    def get_planet_index(planet_name: str) -> int | None:\n        normalized_name = normalize_name(planet_name)\n        try:\n            return CANONICAL_PLANETS.index(normalized_name)\n        except ValueError:\n            return None\n\n    # Get the indices for both input planets.\n    idx1 = get_planet_index(planet1)\n    idx2 = get_planet_index(planet2)\n\n    # If either planet name is invalid or not found, return an empty tuple.\n    if idx1 is None or idx2 is None:\n        return ()\n\n    # If both planets are the same, return an empty tuple as there are no planets \"between\" them.\n    if idx1 == idx2:\n        return ()\n\n    # Determine the start and end indices for slicing, ensuring they are strictly between the two input planets.\n    start_index = min(idx1, idx2) + 1\n    end_index = max(idx1, idx2)\n\n    # Slice the canonical list to get the planets located between the two input planets.\n    between_planets = CANONICAL_PLANETS[start_index:end_index]\n\n    return tuple(between_planets)"}
{"task_id": "HumanEval/149", "solution": "def sorted_list_sum(lst):\n    \"\"\"\n    Deletes strings with odd lengths, then sorts the remaining strings\n    by length (ascending) and alphabetically for words of the same length.\n    \"\"\"\n    \n    # Filter out strings that have odd lengths\n    filtered_list = [s for s in lst if len(s) % 2 == 0]\n    \n    # Sort the filtered list by length, then alphabetically\n    # The key function returns a tuple (length, string). Python's sorted()\n    # will sort by the first element of the tuple, then by the second.\n    sorted_result = sorted(filtered_list, key=lambda s: (len(s), s))\n    \n    return sorted_result"}
