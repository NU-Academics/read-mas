{"task_id": "HumanEval/86", "solution": "from dataclasses import dataclass\nfrom typing import List\n\n@dataclass(frozen=True)\nclass _Token:\n    text: str\n    is_space: bool\n    index: int\n\n_SPACE_CHAR = \" \"\n\ndef _tokenize_string(sentence: str) -> List[_Token]:\n    \"\"\"Splits a sentence into tokens, preserving runs of spaces and words.\"\"\"\n    tokens: List[_Token] = []\n    if sentence == \"\":\n        return [_Token(text=\"\", is_space=False, index=0)]\n\n    buf = []\n    is_space_run = sentence[0] == _SPACE_CHAR\n    idx = 0\n    for ch in sentence:\n        if (ch == _SPACE_CHAR) == is_space_run:\n            buf.append(ch)\n        else:\n            tokens.append(_Token(\"\".join(buf), is_space_run, idx))\n            idx += 1\n            buf = [ch]\n            is_space_run = ch == _SPACE_CHAR\n    tokens.append(_Token(\"\".join(buf), is_space_run, idx))\n    return tokens\n\ndef _sort_chars_by_ascii(s: str) -> str:\n    \"\"\"Sorts characters in a string by their ASCII value.\"\"\"\n    return \"\".join(sorted(s, key=lambda c: ord(c)))\n\ndef _process_token(token: _Token) -> _Token:\n    \"\"\"Sorts characters within a non-space token, preserving space tokens.\"\"\"\n    if token.is_space:\n        return token\n    sorted_text = _sort_chars_by_ascii(token.text)\n    return _Token(sorted_text, False, token.index)\n\ndef anti_shuffle(s):\n    \"\"\"\n    Sorts characters within each word of a string based on ASCII value,\n    preserving word order and blank spaces.\n    \"\"\"\n    tokens = _tokenize_string(s)\n    processed_tokens = [_process_token(t) for t in tokens]\n    return \"\".join(t.text for t in processed_tokens)"}
{"task_id": "HumanEval/87", "solution": "def get_row(lst, x):\n    \"\"\"\n    Finds integer x in the 2D list and returns a list of (row, column) coordinates.\n    Coordinates are sorted by row ascending, then by column descending within each row.\n    \"\"\"\n    occurrences = {}\n    for row_idx, row_data in enumerate(lst):\n        for col_idx, value in enumerate(row_data):\n            if value == x:\n                if row_idx not in occurrences:\n                    occurrences[row_idx] = []\n                occurrences[row_idx].append(col_idx)\n\n    result = []\n    # Sort rows in ascending order\n    for row_idx in sorted(occurrences.keys()):\n        # Sort columns within each row in descending order\n        cols_in_row = sorted(occurrences[row_idx], reverse=True)\n        for col_idx in cols_in_row:\n            result.append((row_idx, col_idx))\n\n    return result"}
{"task_id": "HumanEval/86", "solution": "def anti_shuffle(s):\n    \"\"\"\n    Sorts characters within each word of a string while preserving word order and spaces.\n    \"\"\"\n    if not s:\n        return s\n\n    result_parts = []\n    current_word_chars = []\n    in_word_segment = False\n\n    for char in s:\n        if char == ' ':\n            # If we were accumulating a word, sort it and append\n            if in_word_segment:\n                result_parts.append(''.join(sorted(current_word_chars, key=ord)))\n                current_word_chars = []\n                in_word_segment = False\n            # Always append the space character\n            result_parts.append(char)\n        else:\n            # If transitioning from a space segment, start a new word\n            if not in_word_segment:\n                in_word_segment = True\n            current_word_chars.append(char)\n\n    # After the loop, if there's an unappended word, sort it and append\n    if in_word_segment:\n        result_parts.append(''.join(sorted(current_word_chars, key=ord)))\n\n    return ''.join(result_parts)"}
{"task_id": "HumanEval/88", "solution": "def sort_array(array):\n    \"\"\"\n    Sorts a copy of the given array based on the parity of the sum of its first and last elements.\n    Sorts in ascending order if the sum is odd, descending if the sum is even.\n    \"\"\"\n    if not array:\n        return []\n\n    # Create a copy of the array to avoid modifying the original\n    copied_array = list(array)\n\n    # Determine first and last elements for sum calculation\n    # For a single-element array, the first and last are the same element.\n    first_val = copied_array[0]\n    last_val = copied_array[-1]\n\n    # Calculate the sum and determine its parity\n    elements_sum = first_val + last_val\n    is_sum_odd = (elements_sum % 2 != 0)\n\n    # Sort the copied array based on the sum's parity\n    if is_sum_odd:\n        copied_array.sort(reverse=False)  # Ascending order\n    else:\n        copied_array.sort(reverse=True)   # Descending order\n\n    return copied_array"}
{"task_id": "HumanEval/88", "solution": "def sort_array(array):\n    \"\"\"\n    Sorts a copy of the array based on the parity of the sum of its first and last elements.\n    Sorts ascending if sum is odd, descending if sum is even.\n    \"\"\"\n    n = len(array)\n    if n <= 1:\n        return list(array)  # Return a shallow copy for consistency with the \"don't change\" rule\n\n    first_val = array[0]\n    last_val = array[-1]\n\n    # Decide sort order: ascending if sum is odd, descending if sum is even\n    # (first + last) % 2 == 1  means odd sum -> ascending\n    # (first + last) % 2 == 0  means even sum -> descending\n    is_ascending = ((first_val + last_val) % 2) == 1\n\n    result = list(array)  # Create a shallow copy of the input array\n    result.sort(reverse=not is_ascending)\n    return result"}
{"task_id": "HumanEval/89", "solution": "def encrypt(s):\n    \"\"\"Encrypts a string by rotating ASCII alphabet letters by 4 places.\n    Non-alphabetic characters are preserved.\n    \"\"\"\n    encrypted_chars = []\n    shift = 4  # The alphabet should be rotated by 2 * 2 = 4 places.\n\n    for char_code in s:\n        if 'a' <= char_code <= 'z':\n            # Handle lowercase letters\n            base = ord('a')\n            shifted_char_code = (ord(char_code) - base + shift) % 26 + base\n            encrypted_chars.append(chr(shifted_char_code))\n        elif 'A' <= char_code <= 'Z':\n            # Handle uppercase letters\n            base = ord('A')\n            shifted_char_code = (ord(char_code) - base + shift) % 26 + base\n            encrypted_chars.append(chr(shifted_char_code))\n        else:\n            # Preserve non-alphabetic characters\n            encrypted_chars.append(char_code)\n\n    return \"\".join(encrypted_chars)"}
{"task_id": "HumanEval/87", "solution": "def get_row(lst, x):\n    \"\"\"\n    Finds integer x in the 2D jagged list and returns a list of (row, column) coordinates.\n    Coordinates are sorted by row ascending, then by columns descending within each row.\n    \"\"\"\n    found_coords_by_row = {}\n\n    for r_idx, row in enumerate(lst):\n        for c_idx, val in enumerate(row):\n            if val == x:\n                if r_idx not in found_coords_by_row:\n                    found_coords_by_row[r_idx] = []\n                found_coords_by_row[r_idx].append(c_idx)\n\n    result_coords = []\n    # Sort row indices in ascending order\n    for r_idx in sorted(found_coords_by_row.keys()):\n        # Sort column indices for the current row in descending order\n        sorted_cols = sorted(found_coords_by_row[r_idx], reverse=True)\n        for c_idx in sorted_cols:\n            result_coords.append((r_idx, c_idx))\n\n    return result_coords"}
{"task_id": "HumanEval/90", "solution": "def next_smallest(lst):\n    \"\"\"\n    Finds the 2nd smallest distinct element in a list of integers.\n    Returns None if there is no such element.\n    \"\"\"\n    smallest = None\n    second = None\n\n    for v in lst:\n        if smallest is None or v < smallest:\n            # If current value is smaller than current 'smallest',\n            # the old 'smallest' might become the new 'second'.\n            # This condition prevents 'second' from being set to 'smallest'\n            # if 'smallest' was None (i.e., this is the first element seen)\n            # or if 'v' is the same as 'smallest' (though v < smallest already implies distinctness).\n            # The original design's `if smallest is None or v != smallest` ensures `second` only gets\n            # a distinct value if `smallest` was previously set.\n            if smallest is None or v != smallest:\n                second = smallest\n            smallest = v\n        # If 'v' is not smaller than 'smallest', but is distinct from 'smallest',\n        # it might be the new 'second' smallest.\n        elif v != smallest and (second is None or v < second):\n            second = v\n            \n    return second"}
{"task_id": "HumanEval/92", "solution": "def any_int(x, y, z):\n    \"\"\"\n    Checks if all three numbers are integer-valued and if one equals the sum of the other two.\n    Returns true if both conditions are met, false otherwise.\n    \"\"\"\n    def is_integer_value(val):\n        return isinstance(val, int) or (isinstance(val, float) and val.is_integer())\n\n    if not (is_integer_value(x) and is_integer_value(y) and is_integer_value(z)):\n        return False\n\n    # Ensure integer comparisons by coercing to int if they were float like 5.0\n    x_int = int(x)\n    y_int = int(y)\n    z_int = int(z)\n\n    return (x_int == y_int + z_int) or \\\n           (y_int == x_int + z_int) or \\\n           (z_int == x_int + y_int)"}
{"task_id": "HumanEval/90", "solution": "def next_smallest(lst):\n    \"\"\"\n    Finds the second smallest distinct element in a list of integers.\n    Uses a single-pass O(n) algorithm, tracking the smallest and second smallest values.\n    \"\"\"\n    smallest = None\n    second = None\n    for v in lst:\n        if smallest is None or v < smallest:\n            # Current v is smaller than the current smallest\n            # The old 'smallest' becomes the new 'second'\n            # If the old 'smallest' was None, then 'second' remains None\n            second = smallest\n            smallest = v\n        elif v != smallest and (second is None or v < second):\n            # Current v is not the smallest, but it's smaller than the current second (and distinct from smallest)\n            second = v\n    return second"}
{"task_id": "HumanEval/91", "solution": "import re\n\ndef is_bored(S):\n    \"\"\"\n    Counts the number of sentences that start with the word \"I\".\n    Sentences are delimited by '.', '?' or '!'.\n    \"\"\"\n\n    if not S:\n        return 0\n\n    def _split_into_sentences(text: str) -> list[str]:\n        # Splits the input text into sentences based on '.', '!', '?'.\n        # Handles consecutive delimiters and ignores empty sentence segments.\n        segments = re.split(r'([.!?])', text)\n\n        sentences = []\n        current_sentence_parts = []\n\n        for segment in segments:\n            # Skip empty segments or pure whitespace segments that are not delimiters themselves.\n            if not segment.strip() and segment not in ('.', '!', '?'):\n                continue\n            \n            if segment in ('.', '!', '?'):\n                # Delimiter found, form a sentence from accumulated parts.\n                full_sentence = \"\".join(current_sentence_parts).strip()\n                if full_sentence:  # Add only non-empty sentences.\n                    sentences.append(full_sentence)\n                current_sentence_parts = []  # Reset for the next sentence.\n            else:\n                # Not a delimiter, this segment is part of the current sentence.\n                current_sentence_parts.append(segment)\n                \n        # After the loop, if there are any remaining parts, they form the last sentence.\n        if current_sentence_parts:\n            full_sentence = \"\".join(current_sentence_parts).strip()\n            if full_sentence:\n                sentences.append(full_sentence)\n                \n        return sentences\n\n    def _sentence_starts_with_I(sentence_text: str) -> bool:\n        # Checks if a given sentence starts with the pronoun \"I\" (case-sensitive) or contractions like \"I'm\".\n        \n        # First, strip leading whitespace and common opening punctuation.\n        trimmed = sentence_text.strip()\n        leading_punctuation_pattern = r\"^[\\s\\\"'\u201c\u2018(]+\"\n        trimmed = re.sub(leading_punctuation_pattern, '', trimmed)\n\n        if not trimmed:\n            return False\n\n        # Extract the first word/token after cleaning.\n        first_word = trimmed.split(None, 1)[0]\n        \n        # Clean the first word by stripping common trailing punctuation for direct comparison with \"I\".\n        # This handles cases like \"I.\" or \"I!\" correctly matching \"I\".\n        cleaned_first_word_for_I = first_word.rstrip('.,!?:;') \n        \n        # Check if the cleaned first word is exactly \"I\" (case-sensitive).\n        if cleaned_first_word_for_I == \"I\":\n            return True\n        \n        # Check for contractions starting with \"I'\" or \"I\u2019\" using the original first_word\n        # to preserve the apostrophe.\n        if first_word.startswith(\"I'\") or first_word.startswith(\"I\u2019\"):\n            return True\n            \n        return False\n\n    boredom_count = 0\n    sentences = _split_into_sentences(S)\n    \n    for sentence in sentences:\n        if _sentence_starts_with_I(sentence):\n            boredom_count += 1\n            \n    return boredom_count"}
{"task_id": "HumanEval/91", "solution": "import re\n\ndef is_bored(S):\n    \"\"\"\n    Counts sentences starting with \"I\". Sentences are delimited by '.', '?' or '!'.\n    \"\"\"\n    boredom_count = 0\n\n    # Normalize the entire input string: strip leading/trailing whitespace and collapse\n    # multiple internal spaces into a single space, as per InputNormalizer design.\n    normalized_text = S.strip()\n    normalized_text = re.sub(r'\\s+', ' ', normalized_text)\n\n    # Split the normalized text into potential sentence fragments using '.', '?', '!' as delimiters.\n    sentence_fragments = re.split(r'[.!?]', normalized_text)\n\n    # Process each fragment to identify bored sentences.\n    for fragment in sentence_fragments:\n        # Trim whitespace from the current fragment.\n        trimmed_fragment = fragment.strip()\n\n        # If the trimmed fragment is not empty, check if it starts with \"I\".\n        if trimmed_fragment:\n            # Split the fragment into words. `split()` handles multiple spaces correctly.\n            words = trimmed_fragment.split()\n\n            # Check if the sentence starts with the exact word \"I\" (case-sensitive by default).\n            if words and words[0] == \"I\":\n                boredom_count += 1\n\n    return boredom_count"}
{"task_id": "HumanEval/92", "solution": "import math\n\ndef any_int(x, y, z):\n    '''\n    Checks if one of the numbers is equal to the sum of the other two, and all numbers are integers.\n    Returns true if one of the numbers is equal to the sum of the other two, and all numbers are integers.\n    Returns false in any other cases.\n    '''\n\n    def _is_integer_value(n) -> bool:\n        \"\"\"Helper to determine if a number is an integer or an integer-valued float.\"\"\"\n        if isinstance(n, int):\n            return True\n        if isinstance(n, float):\n            return math.isfinite(n) and n.is_integer()\n        return False\n\n    if not (_is_integer_value(x) and _is_integer_value(y) and _is_integer_value(z)):\n        return False\n\n    ix = int(x)\n    iy = int(y)\n    iz = int(z)\n\n    return (ix == iy + iz) or \\\n           (iy == ix + iz) or \\\n           (iz == ix + iy)"}
{"task_id": "HumanEval/93", "solution": "def encode(message):\n    \"\"\"\n    Encodes a message by swapping case of letters and shifting vowels.\n    Non-letter characters are preserved.\n    \"\"\"\n    _DEFAULT_SHIFT = 2\n    _DEFAULT_VOWELS = {\"a\", \"e\", \"i\", \"o\", \"u\"}\n\n    def _is_vowel(ch: str) -> bool:\n        \"\"\"Checks if a character is a vowel (case-insensitive).\"\"\"\n        return ch.lower() in _DEFAULT_VOWELS\n\n    def _swap_case(ch: str) -> str:\n        \"\"\"Swaps the case of an alphabetic character, otherwise returns it unchanged.\"\"\"\n        if not ch.isalpha():\n            return ch\n        return ch.swapcase()\n\n    def _shift_char(ch: str, shift: int) -> str:\n        \"\"\"Shifts an alphabetic character by 'shift' places, preserving case and wrapping.\"\"\"\n        if not ch.isalpha():\n            return ch\n        \n        base = ord('A') if ch.isupper() else ord('a')\n        offset = ord(ch) - base\n        new_offset = (offset + shift) % 26\n        return chr(base + new_offset)\n\n    def _encode_char(ch: str) -> str:\n        \"\"\"Applies case swap and optional vowel shift to a single character.\"\"\"\n        swapped_char = _swap_case(ch)\n        if swapped_char.isalpha() and _is_vowel(swapped_char):\n            return _shift_char(swapped_char, _DEFAULT_SHIFT)\n        return swapped_char\n\n    return ''.join(_encode_char(char) for char in message)"}
{"task_id": "HumanEval/93", "solution": "def encode(message):\n    \"\"\"\n    Encodes a message by swapping case of all letters and replacing vowels\n    with the letter that appears 2 places ahead in the alphabet.\n    \"\"\"\n    VOWELS_SET = {'A', 'E', 'I', 'O', 'U'}\n    \n    def is_vowel(char_to_check):\n        \"\"\"Checks if a character is a vowel (case-insensitive).\"\"\"\n        return char_to_check.upper() in VOWELS_SET\n\n    def advance_char(char_to_advance, steps=2):\n        \"\"\"Advances an alphabetic character by 'steps', preserving case and wrapping.\"\"\"\n        if 'a' <= char_to_advance <= 'z':\n            start_ord = ord('a')\n            alphabet_len = 26\n        elif 'A' <= char_to_advance <= 'Z':\n            start_ord = ord('A')\n            alphabet_len = 26\n        else:\n            return char_to_advance  # Not an alphabet character, return unchanged\n\n        current_pos = ord(char_to_advance) - start_ord\n        new_pos = (current_pos + steps) % alphabet_len\n        return chr(start_ord + new_pos)\n\n    encoded_chars = []\n    for char in message:\n        swapped_char = char.swapcase()\n        \n        # After swapping case, if the character is an alphabetic vowel, replace it.\n        if swapped_char.isalpha() and is_vowel(swapped_char):\n            final_char = advance_char(swapped_char, 2)\n        else:\n            final_char = swapped_char\n        \n        encoded_chars.append(final_char)\n            \n    return \"\".join(encoded_chars)"}
{"task_id": "HumanEval/94", "solution": "def skjkasdkd(lst):\n    \"\"\"Finds the largest prime number in the list and returns the sum of its digits.\n    Returns 0 if no prime number is found.\n    \"\"\"\n\n    def is_prime(n):\n        \"\"\"Checks if a number is prime.\"\"\"\n        if n < 2:\n            return False\n        if n == 2 or n == 3:\n            return True\n        if n % 2 == 0 or n % 3 == 0:\n            return False\n        i = 5\n        while i * i <= n:\n            if n % i == 0 or n % (i + 2) == 0:\n                return False\n            i += 6\n        return True\n\n    def digit_sum(n):\n        \"\"\"Calculates the sum of the digits of a number.\"\"\"\n        s = 0\n        while n > 0:\n            s += n % 10\n            n //= 10\n        return s\n\n    largest_prime = None\n\n    for num in lst:\n        if is_prime(num):\n            if largest_prime is None or num > largest_prime:\n                largest_prime = num\n\n    if largest_prime is not None:\n        return digit_sum(largest_prime)\n    else:\n        return 0"}
{"task_id": "HumanEval/95", "solution": "def check_dict_case(dict):\n    \"\"\"\n    Checks if all keys in a dictionary are strings and are uniformly either\n    all lower case or all upper case. Returns False if the dictionary is empty.\n    \"\"\"\n    if not dict:\n        return False\n\n    keys = list(dict.keys())\n\n    # First, validate that all keys are strings.\n    for key in keys:\n        if not isinstance(key, str):\n            return False\n\n    # Check if all keys are lowercase.\n    all_lower = True\n    for key in keys:\n        if key != key.lower():\n            all_lower = False\n            break\n\n    if all_lower:\n        return True\n\n    # If not all lowercase, check if all keys are uppercase.\n    all_upper = True\n    for key in keys:\n        if key != key.upper():\n            all_upper = False\n            break\n\n    return all_upper"}
{"task_id": "HumanEval/96", "solution": "def count_up_to(n):\n    \"\"\"Returns an array of prime numbers less than n using the Sieve of Eratosthenes.\"\"\"\n    if n <= 2:\n        return []\n\n    # Initialize a boolean array 'sieve' where sieve[i] is true if i is potentially prime.\n    # Using bytearray for memory efficiency and direct manipulation.\n    sieve = bytearray(b\"\\x01\") * n\n    sieve[0:2] = b\"\\x00\\x00\"  # 0 and 1 are not prime\n\n    # Iterate from 2 up to the square root of n\n    for p in range(2, int(n**0.5) + 1):\n        # If sieve[p] is still true, then p is a prime number\n        if sieve[p]:\n            # Mark all multiples of p (starting from p*p) as not prime\n            # Multiples less than p*p would have already been marked by smaller primes\n            start = p * p\n            step = p\n            # Optimized slicing to set multiples to 0\n            sieve[start:n:step] = b\"\\x00\" * ((n - 1 - start) // step + 1)\n\n    # Collect all numbers for which sieve[i] is true\n    return [i for i, is_prime in enumerate(sieve) if is_prime]"}
