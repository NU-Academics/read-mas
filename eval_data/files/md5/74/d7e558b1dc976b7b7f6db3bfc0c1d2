{"task_id": "HumanEval/112", "solution": "def reverse_delete(s,c):\n    \"\"\"Deletes characters from s present in c, then checks if the resulting string is a palindrome.\"\"\"\n\n    def _delete_chars(source_str, chars_to_remove):\n        \"\"\"Removes all characters from source_str that are present in chars_to_remove.\"\"\"\n        chars_to_delete_set = set(chars_to_remove)\n        result_chars = [char for char in source_str if char not in chars_to_delete_set]\n        return \"\".join(result_chars)\n\n    def _is_palindrome(text):\n        \"\"\"Checks if a string is a palindrome.\"\"\"\n        return text == text[::-1]\n\n    modified_s = _delete_chars(s, c)\n    is_palindrome_result = _is_palindrome(modified_s)\n    return (modified_s, is_palindrome_result)"}
{"task_id": "HumanEval/114", "solution": "def minSubArraySum(nums):\n    \"\"\"\n    Given an array of integers nums, find the minimum sum of any non-empty sub-array\n    of nums.\n    \"\"\"\n    min_so_far = nums[0]\n    current_min = nums[0]\n\n    for i in range(1, len(nums)):\n        current_min = min(nums[i], current_min + nums[i])\n        min_so_far = min(min_so_far, current_min)\n\n    return min_so_far"}
{"task_id": "HumanEval/115", "solution": "import math\n\ndef max_fill(grid, capacity):\n    \"\"\"\n    Calculates the total number of times buckets need to be lowered across all wells.\n    It sums the water in each well and applies ceiling division by capacity.\n    \"\"\"\n    total_lowerings = 0\n    for well_row in grid:\n        water_in_well = sum(well_row)\n        if water_in_well > 0:\n            lowerings_for_well = math.ceil(water_in_well / capacity)\n            total_lowerings += lowerings_for_well\n    return total_lowerings"}
{"task_id": "HumanEval/117", "solution": "```python\ndef select_words(s, n):\n    \"\"\"Given a string s and a natural number n, you have been tasked to implement\n    a function that returns a list of all words from string s that contain exactly\n    n consonants, in order these words appear in the string s.\n    If the string s is empty then the function should return an empty list.\n    Note: you may assume the input string contains only letters and spaces.\n    Examples:\n    select_words(\"Mary had a little lamb\", 4) ==> [\"little\"]\n    select_words(\"Mary had a little lamb\", 3) ==> [\"Mary\", \"lamb\"]\n    select_words(\"simple white space\", 2) ==> []\n    select_words(\"Hello world\", 4) ==> [\"world\"]\n    select_words(\"Uncle sam\", 3) ==> [\"Uncle\"]\n    \"\"\"\n    if not s:\n        return []\n\n    VOWELS_SET = {'a', 'e', 'i', 'o', 'u'}\n\n    def _is_vowel(char: str) -> bool:\n        \"\"\"Checks if a character is a vowel (case-insensitive).\"\"\"\n        return char.lower() in VOWELS_SET\n\n    def _count_consonants(word: str) -> int:\n        \"\"\"Counts the number of consonants in a given word.\"\"\"\n        consonant_count = 0\n        for char in word:\n            if char.isalpha() and not _is_vowel(char):\n                consonant_count += 1\n        return consonant_count\n\n    result_words = []\n    words = s.split()\n\n    for word in words:\n        if _count_consonants(word) == n:\n            result_words.append(word)\n\n    return result_words\n```"}
{"task_id": "HumanEval/116", "solution": "```python\ndef sort_array(arr):\n    \"\"\"\n    Sorts an array of integers based on the number of set bits (primary, ascending)\n    and then by decimal value (secondary, ascending).\n    \"\"\"\n\n    def _count_set_bits_helper(n: int) -> int:\n        \"\"\"Counts set bits in an integer, using its absolute value for negative numbers.\"\"\"\n        if n == 0:\n            return 0\n        abs_n = abs(n)\n        count = 0\n        while abs_n > 0:\n            abs_n &= (abs_n - 1)\n            count += 1\n        return count\n\n    def _get_sort_key_helper(n: int) -> tuple[int, int]:\n        \"\"\"Generates a tuple (set_bit_count, decimal_value) for sorting.\"\"\"\n        set_bit_count = _count_set_bits_helper(n)\n        return (set_bit_count, n)\n\n    return sorted(arr, key=_get_sort_key_helper)\n```"}
{"task_id": "HumanEval/119", "solution": "```python\ndef match_parens(lst):\n    \"\"\"\n    Checks if two parenthesis strings can be concatenated in any order to form a balanced string.\n    \"\"\"\n\n    class ParenthesesChecker:\n        \"\"\"\n        Analyzes a single string of parentheses to determine its balance properties.\n        \"\"\"\n        def analyze_string(self, s: str):\n            open_count = 0\n            close_count = 0\n            balance = 0\n            min_balance = 0\n\n            for char in s:\n                if char == '(':\n                    open_count += 1\n                    balance += 1\n                elif char == ')':\n                    close_count += 1\n                    balance -= 1\n                min_balance = min(min_balance, balance)\n\n            return open_count, close_count, min_balance\n\n    def _check_concatenation(props1, props2) -> bool:\n        \"\"\"\n        Determines if the concatenation of two strings (represented by their properties) is balanced.\n        \"\"\"\n        open_s1, close_s1, min_bal_s1 = props1\n        open_s2, close_s2, min_bal_s2 = props2\n\n        total_open = open_s1 + open_s2\n        total_close = close_s1 + close_s2\n\n        if total_open != total_close:\n            return False\n\n        balance_after_s1 = open_s1 - close_s1\n        min_overall_balance = min(min_bal_s1, balance_after_s1 + min_bal_s2)\n\n        return min_overall_balance >= 0\n\n    s1, s2 = lst[0], lst[1]\n\n    checker = ParenthesesChecker()\n\n    props1 = checker.analyze_string(s1)\n    props2 = checker.analyze_string(s2)\n\n    # Check s1 + s2\n    if _check_concatenation(props1, props2):\n        return 'Yes'\n\n    # Check s2 + s1\n    if _check_concatenation(props2, props1):\n        return 'Yes'\n\n    return 'No'\n```"}
