{"task_id": "HumanEval/139", "solution": "```python\ndef special_factorial(n):\n    \"\"\"The Brazilian factorial is defined as:\n    brazilian_factorial(n) = n! * (n-1)! * (n-2)! * ... * 1!\n    where n > 0\n\n    For example:\n    >>> special_factorial(4)\n    288\n\n    The function will receive an integer as input and should return the special\n    factorial of this integer.\n    \"\"\"\n\n    def _simple_factorial(k):\n        # Calculates the standard factorial of a positive integer k.\n        # This helper assumes k is a positive integer, as per the outer function's loop range.\n        res = 1\n        for x in range(1, k + 1):\n            res *= x\n        return res\n\n    special_fact_result = 1\n    for i in range(1, n + 1):\n        special_fact_result *= _simple_factorial(i)\n    return special_fact_result\n```"}
{"task_id": "HumanEval/141", "solution": "```python\ndef file_name_check(file_name):\n    \"\"\"Checks if a file name is valid based on specific rules.\"\"\"\n\n    # Rule 2: The file's name must contain exactly one dot '.'\n    if file_name.count('.') != 1:\n        return 'No'\n\n    # Split the file name into prefix and extension\n    parts = file_name.split('.', 1)\n    prefix = parts[0]\n    extension = parts[1]\n\n    # Rule 3: The substring before the dot should not be empty, and it starts with a latin alphabet letter.\n    if not prefix or not prefix[0].isalpha():\n        return 'No'\n\n    # Rule 1: There should not be more than three digits ('0'-'9') in the file's name.\n    digit_count = sum(1 for char in file_name if char.isdigit())\n    if digit_count > 3:\n        return 'No'\n\n    # Rule 4: The substring after the dot should be one of these: ['txt', 'exe', 'dll']\n    allowed_extensions = ['txt', 'exe', 'dll']\n    if extension not in allowed_extensions:\n        return 'No'\n\n    # If all conditions are met, the file name is valid\n    return 'Yes'\n```\n"}
{"task_id": "HumanEval/140", "solution": "```python\nimport re\n\ndef fix_spaces(text):\n    \"\"\"\n    Given a string text, replace all spaces in it with underscores,\n    and if a string has more than 2 consecutive spaces,\n    then replace all consecutive spaces with -\n\n    fix_spaces(\"Example\") == \"Example\"\n    fix_spaces(\"Example 1\") == \"Example_1\"\n    fix_spaces(\" Example 2\") == \"_Example_2\"\n    fix_spaces(\" Example   3\") == \"_Example-3\"\n    \"\"\"\n    # First, replace sequences of two or more consecutive spaces with a single hyphen.\n    # This step is crucial to prevent \"   \" from becoming \"_-_\" rather than \"-\".\n    text_with_hyphens = re.sub(r' {2,}', '-', text)\n\n    # Next, replace all remaining single spaces with an underscore.\n    # These are spaces that were not part of a 2+ consecutive sequence.\n    final_text = text_with_hyphens.replace(' ', '_')\n\n    return final_text\n```"}
{"task_id": "HumanEval/143", "solution": "```python\ndef words_in_sentence(sentence):\n    \"\"\"\n    You are given a string representing a sentence,\n    the sentence contains some words separated by a space,\n    and you have to return a string that contains the words from the original sentence,\n    whose lengths are prime numbers,\n    the order of the words in the new string should be the same as the original one.\n\n    Example 1:\n        Input: sentence = \"This is a test\"\n        Output: \"is\"\n\n    Example 2:\n        Input: sentence = \"lets go for swimming\"\n        Output: \"go for\"\n\n    Constraints:\n        * 1 <= len(sentence) <= 100\n        * sentence contains only letters\n    \"\"\"\n    def is_prime(number: int) -> bool:\n        \"\"\"Checks if a given integer is a prime number.\"\"\"\n        if number < 2:\n            return False\n        for i in range(2, int(number**0.5) + 1):\n            if number % i == 0:\n                return False\n        return True\n\n    words = sentence.split(' ')\n    prime_length_words = []\n    for word in words:\n        if is_prime(len(word)):\n            prime_length_words.append(word)\n    return ' '.join(prime_length_words)\n```"}
{"task_id": "HumanEval/144", "solution": "```python\ndef simplify(x, n):\n    \"\"\"Checks if the product of two fractions x and n results in a whole number.\n    Fractions are given as strings \"numerator/denominator\".\n    \"\"\"\n    import math\n\n    class Fraction:\n        def __init__(self, numerator: int, denominator: int):\n            self.numerator = numerator\n            self.denominator = denominator\n\n        def multiply(self, other: 'Fraction') -> 'Fraction':\n            new_numerator = self.numerator * other.numerator\n            new_denominator = self.denominator * other.denominator\n            return Fraction(new_numerator, new_denominator)\n\n        def is_whole_number(self) -> bool:\n            common_divisor = math.gcd(self.numerator, self.denominator)\n            simplified_denominator = self.denominator // common_divisor\n            return simplified_denominator == 1\n\n    class FractionParser:\n        @staticmethod\n        def parse(fraction_str: str) -> Fraction:\n            parts = fraction_str.split('/')\n            numerator = int(parts[0])\n            denominator = int(parts[1])\n            return Fraction(numerator, denominator)\n\n    fraction_x = FractionParser.parse(x)\n    fraction_n = FractionParser.parse(n)\n\n    product_fraction = fraction_x.multiply(fraction_n)\n\n    return product_fraction.is_whole_number()\n```"}
{"task_id": "HumanEval/142", "solution": "```python\ndef sum_squares(lst):\n    \"\"\"\"\n    This function will take a list of integers. For all entries in the list, the function shall square the integer entry if its index is a\n    multiple of 3 and will cube the integer entry if its index is a multiple of 4 and not a multiple of 3. The function will not\n    change the entries in the list whose indexes are not a multiple of 3 or 4. The function shall then return the sum of all entries.\n\n    Examples:\n    For lst = [1,2,3] the output should be 6\n    For lst = []  the output should be 0\n    For lst = [-1,-5,2,-1,-5]  the output should be -126\n    \"\"\"\n    if not lst:\n        return 0\n\n    processed_elements = []\n    for i, item in enumerate(lst):\n        if i % 3 == 0:\n            processed_elements.append(item * item)\n        elif i % 4 == 0:  # This condition implies i % 3 != 0 due to the 'if' statement above.\n            processed_elements.append(item * item * item)\n        else:\n            processed_elements.append(item)\n\n    return sum(processed_elements)\n```"}
{"task_id": "HumanEval/146", "solution": "```python\nODD_DIGITS = {1, 3, 5, 7, 9}\n\ndef _is_greater_than_ten(num):\n    \"\"\"Checks if a number is greater than 10.\"\"\"\n    return num > 10\n\ndef _is_first_digit_odd(num):\n    \"\"\"Checks if the first digit of a number (absolute value) is odd.\"\"\"\n    if num == 0:\n        return False\n    first_digit_str = str(abs(num))[0]\n    return int(first_digit_str) in ODD_DIGITS\n\ndef _is_last_digit_odd(num):\n    \"\"\"Checks if the last digit of a number (absolute value) is odd.\"\"\"\n    if num == 0:\n        return False\n    last_digit_str = str(abs(num))[-1]\n    return int(last_digit_str) in ODD_DIGITS\n\ndef specialFilter(nums):\n    \"\"\"\n    Filters an array of numbers and returns the count of elements that are\n    greater than 10 and have both first and last digits odd.\n    \"\"\"\n    count = 0\n    for num in nums:\n        if (\n            _is_greater_than_ten(num)\n            and _is_first_digit_odd(num)\n            and _is_last_digit_odd(num)\n        ):\n            count += 1\n    return count\n```"}
