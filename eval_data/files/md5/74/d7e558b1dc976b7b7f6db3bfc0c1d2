{"task_id": "HumanEval/13", "solution": "```python\ndef greatest_common_divisor(a: int, b: int) -> int:\n    \"\"\" Return a greatest common divisor of two integers a and b\n    >>> greatest_common_divisor(3, 5)\n    1\n    >>> greatest_common_divisor(25, 15)\n    5\n    \"\"\"\n    a = abs(a)\n    b = abs(b)\n\n    while b:\n        a, b = b, a % b\n    return a\n```"}
{"task_id": "HumanEval/10", "solution": "def make_palindrome(string: str) -> str:\n    \"\"\" Find the shortest palindrome that begins with a supplied string.\n    Algorithm idea is simple:\n    - Find the longest postfix of supplied string that is a palindrome.\n    - Append to the end of the string reverse of a string prefix that comes before the palindromic suffix.\n    >>> make_palindrome('')\n    ''\n    >>> make_palindrome('cat')\n    'catac'\n    >>> make_palindrome('cata')\n    'catac'\n    \"\"\"\n    if not string:\n        return \"\"\n\n    # Iterate 'i' from 0 to len(string) - 1 to find the longest palindromic postfix (string[i:]).\n    # A smaller 'i' corresponds to a longer postfix.\n    for i in range(len(string)):\n        postfix = string[i:]\n        if is_palindrome(postfix):\n            # Once the longest palindromic postfix is found, take the prefix that comes before it.\n            prefix_to_reverse = string[0:i]\n            # Append the reversed prefix to the original string to form the shortest palindrome.\n            return string + prefix_to_reverse[::-1]\n\n    # This line should ideally be unreachable for non-empty strings\n    # because at least the last character (a single character string) is always a palindrome.\n    return string"}
{"task_id": "HumanEval/6", "solution": "def parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\" Input to this function is a string represented multiple groups for nested parentheses separated by spaces.\n    For each of the group, output the deepest level of nesting of parentheses.\n    E.g. (()()) has maximum two levels of nesting while ((())) has three.\n\n    >>> parse_nested_parens('(()()) ((())) () ((())()())')\n    [2, 3, 1, 3]\n    \"\"\"\n    if not isinstance(paren_string, str):\n        raise TypeError(\"Input must be a string.\")\n\n    def _calculate_max_nesting(group_string: str) -> int:\n        \"\"\"Calculates the maximum nesting depth for a single parentheses group.\"\"\"\n        current_level = 0\n        max_level = 0\n        for char in group_string:\n            if char == '(':\n                current_level += 1\n                max_level = max(max_level, current_level)\n            elif char == ')':\n                current_level -= 1\n            else:\n                raise ValueError(f\"Invalid character '{char}' found in group '{group_string}'. Only '(' and ')' are allowed.\")\n\n            # Check for mismatched closing parentheses\n            if current_level < 0:\n                raise ValueError(f\"Mismatched parentheses in group '{group_string}'. Closing parenthesis without matching opening one.\")\n\n        # Check for unclosed opening parentheses at the end\n        if current_level != 0:\n            raise ValueError(f\"Mismatched parentheses in group '{group_string}'. Unclosed opening parentheses.\")\n\n        return max_level\n\n    results = []\n\n    # Split the input string by spaces. Empty strings are filtered out below.\n    groups = paren_string.split(' ')\n\n    # Filter out any empty strings that result from multiple spaces or leading/trailing spaces.\n    valid_groups = [group for group in groups if group]\n\n    for group in valid_groups:\n        results.append(_calculate_max_nesting(group))\n\n    return results"}
{"task_id": "HumanEval/16", "solution": "def count_distinct_characters(string: str) -> int:\n    \"\"\" Given a string, find out how many distinct characters (regardless of case) does it consist of\n    >>> count_distinct_characters('xyzXYZ')\n    3\n    >>> count_distinct_characters('Jerry')\n    4\n    \"\"\"\n    lower_cased_string = string.lower()\n    distinct_chars = set(lower_cased_string)\n    return len(distinct_chars)"}
{"task_id": "HumanEval/11", "solution": "from typing import List\n\n\ndef string_xor(a: str, b: str) -> str:\n    \"\"\" Input are two strings a and b consisting only of 1s and 0s.\n    Perform binary XOR on these inputs and return result also as a string.\n    >>> string_xor('010', '110')\n    '100'\n    \"\"\"\n    result = []\n    for char_a, char_b in zip(a, b):\n        if char_a == char_b:\n            result.append('0')\n        else:\n            result.append('1')\n    return \"\".join(result)"}
