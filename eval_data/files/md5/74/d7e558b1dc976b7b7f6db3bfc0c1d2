{"task_id": "HumanEval/99", "solution": "```python\nimport math\n\ndef closest_integer(value):\n    '''\n    Create a function that takes a value (string) representing a number\n    and returns the closest integer to it. If the number is equidistant\n    from two integers, round it away from zero.\n\n    Examples\n    >>> closest_integer(\"10\")\n    10\n    >>> closest_integer(\"15.3\")\n    15\n\n    Note:\n    Rounding away from zero means that if the given number is equidistant\n    from two integers, the one you should return is the one that is the\n    farthest from zero. For example closest_integer(\"14.5\") should\n    return 15 and closest_integer(\"-14.5\") should return -15.\n    '''\n    try:\n        num = float(value)\n    except ValueError:\n        raise ValueError(f\"Invalid input: '{value}' is not a valid number string.\")\n\n    floor_num = math.floor(num)\n    ceil_num = math.ceil(num)\n\n    dist_to_floor = abs(num - floor_num)\n    dist_to_ceil = abs(num - ceil_num)\n\n    if dist_to_floor < dist_to_ceil:\n        return int(floor_num)\n    elif dist_to_ceil < dist_to_floor:\n        return int(ceil_num)\n    else:  # Equidistant, round away from zero\n        if num >= 0:\n            return int(ceil_num)\n        else:\n            return int(floor_num)\n```"}
{"task_id": "HumanEval/98", "solution": "```python\ndef count_upper(s):\n    \"\"\"\n    Given a string s, count the number of uppercase vowels in even indices.\n\n    For example:\n    count_upper('aBCdEf') returns 1\n    count_upper('abcdefg') returns 0\n    count_upper('dBBE') returns 0\n    \"\"\"\n    count = 0\n    UPPERCASE_VOWELS = {'A', 'E', 'I', 'O', 'U'}\n\n    for i in range(0, len(s), 2):\n        if s[i] in UPPERCASE_VOWELS:\n            count += 1\n\n    return count\n```"}
{"task_id": "HumanEval/103", "solution": "```python\ndef rounded_avg(n, m):\n    \"\"\"Computes the rounded average of integers from n through m and returns its binary string.\n    Returns -1 if n is greater than m.\n    \"\"\"\n    if n > m:\n        return -1\n\n    # Calculate the average of integers from n to m, which is (n + m) / 2.\n    average = (n + m) / 2.0\n\n    # Round the average to the nearest integer using \"round half up\" strategy.\n    rounded_avg_int = int(average + 0.5)\n\n    # Convert the rounded integer to its binary string representation.\n    binary_string = bin(rounded_avg_int)\n\n    return binary_string\n```"}
{"task_id": "HumanEval/104", "solution": "```python\ndef unique_digits(x):\n    \"\"\"Given a list of positive integers x. return a sorted list of all\n    elements that hasn't any even digit.\n\n    Note: Returned list should be sorted in increasing order.\n\n    For example:\n    >>> unique_digits([15, 33, 1422, 1])\n    [1, 15, 33]\n    >>> unique_digits([152, 323, 1422, 10])\n    []\n    \"\"\"\n\n    def has_even_digit_inline(number: int) -> bool:\n        \"\"\"Checks if a positive integer contains any even digit.\"\"\"\n        if number == 0: # 0 is an even digit, though problem states positive integers.\n            return True\n        temp_num = number\n        while temp_num > 0:\n            digit = temp_num % 10\n            if digit % 2 == 0:\n                return True\n            temp_num //= 10\n        return False\n\n    filtered_numbers = []\n    for num in x:\n        if not has_even_digit_inline(num):\n            filtered_numbers.append(num)\n\n    filtered_numbers.sort()\n    return filtered_numbers\n```"}
{"task_id": "HumanEval/107", "solution": "```python\ndef even_odd_palindrome(n):\n    \"\"\"\n    Counts even and odd integer palindromes within the range [1, n].\n    Assumes n is a positive integer within the valid range [1, 1000].\n    \"\"\"\n    even_count = 0\n    odd_count = 0\n\n    for i in range(1, n + 1):\n        # Check if the number is a palindrome\n        s = str(i)\n        if s == s[::-1]:\n            # Check if the palindrome is even or odd\n            if i % 2 == 0:\n                even_count += 1\n            else:\n                odd_count += 1\n\n    return (even_count, odd_count)\n```"}
{"task_id": "HumanEval/105", "solution": "def by_length(arr):\n    \"\"\"\n    Given an array of integers, sort the integers that are between 1 and 9 inclusive,\n    reverse the resulting array, and then replace each digit by its corresponding name from\n    \"One\", \"Two\", \"Three\", \"Four\", \"Five\", \"Six\", \"Seven\", \"Eight\", \"Nine\".\n\n    For example:\n      arr = [2, 1, 1, 4, 5, 8, 2, 3]\n            -> sort arr -> [1, 1, 2, 2, 3, 4, 5, 8]\n            -> reverse arr -> [8, 5, 4, 3, 2, 2, 1, 1]\n      return [\"Eight\", \"Five\", \"Four\", \"Three\", \"Two\", \"Two\", \"One\", \"One\"]\n\n      If the array is empty, return an empty array:\n      arr = []\n      return []\n\n      If the array has any strange number ignore it:\n      arr = [1, -1 , 55]\n            -> sort arr -> [-1, 1, 55]\n            -> reverse arr -> [55, 1, -1]\n      return = ['One']\n    \"\"\"\n\n    DIGIT_WORDS = {\n        1: \"One\", 2: \"Two\", 3: \"Three\", 4: \"Four\", 5: \"Five\",\n        6: \"Six\", 7: \"Seven\", 8: \"Eight\", 9: \"Nine\"\n    }\n\n    # Filter out numbers not between 1 and 9 inclusive, and non-integer types.\n    filtered_digits = [n for n in arr if isinstance(n, int) and 1 <= n <= 9]\n\n    # Sort the filtered digits in descending order.\n    filtered_digits.sort(reverse=True)\n\n    # Replace each digit with its corresponding word.\n    result_words = [DIGIT_WORDS[d] for d in filtered_digits]\n\n    return result_words"}
{"task_id": "HumanEval/106", "solution": "```python\ndef f(n):\n    \"\"\" Implement the function f that takes n as a parameter,\n    and returns a list of size n, such that the value of the element at index i is the factorial of i if i is even\n    or the sum of numbers from 1 to i otherwise.\n    i starts from 1.\n    the factorial of i is the multiplication of the numbers from 1 to i (1 * 2 * ... * i).\n    Example:\n    f(5) == [1, 2, 6, 24, 15]\n    \"\"\"\n\n    def _calculate_factorial(num: int) -> int:\n        \"\"\"Calculates the factorial of a non-negative integer.\"\"\"\n        if num == 0:\n            return 1\n        result = 1\n        for j in range(1, num + 1):\n            result *= j\n        return result\n\n    def _calculate_sum_up_to(num: int) -> int:\n        \"\"\"Calculates the sum of integers from 1 up to num.\"\"\"\n        return (num * (num + 1)) // 2\n\n    result_list = []\n    for i in range(1, n + 1):\n        if i % 2 == 0:  # If i is even, append factorial(i).\n            result_list.append(_calculate_factorial(i))\n        else:  # If i is odd, append sum_up_to(i).\n            result_list.append(_calculate_sum_up_to(i))\n    return result_list\n```"}
{"task_id": "HumanEval/108", "solution": "```python\ndef count_nums(arr):\n    \"\"\"\n    Counts the number of elements in an array whose sum of digits is > 0.\n    If a number is negative, its first signed digit will be negative.\n    \"\"\"\n\n    class DigitSumCalculator:\n        def calculate_sum(self, number: int) -> int:\n            if number == 0:\n                return 0\n\n            s = str(abs(number))\n            digit_sum = 0\n\n            # Handle the first digit's sign for negative numbers\n            if number < 0:\n                digit_sum += -int(s[0])\n                s = s[1:] # Process remaining digits as positive\n\n            for digit_char in s:\n                digit_sum += int(digit_char)\n\n            return digit_sum\n\n    class NumberCounter:\n        def __init__(self, digit_sum_calculator: DigitSumCalculator):\n            self._digit_sum_calculator = digit_sum_calculator\n\n        def count_positive_digit_sum_numbers(self, arr: list[int]) -> int:\n            count = 0\n            for num in arr:\n                sum_of_digits = self._digit_sum_calculator.calculate_sum(num)\n                if sum_of_digits > 0:\n                    count += 1\n            return count\n\n    calculator = DigitSumCalculator()\n    counter = NumberCounter(calculator)\n    return counter.count_positive_digit_sum_numbers(arr)\n```"}
{"task_id": "HumanEval/109", "solution": "```python\ndef move_one_ball(arr):\n    \"\"\"Determines if an array can be sorted in non-decreasing order by\n    performing right shift operations.\"\"\"\n    if not arr:\n        return True\n\n    n = len(arr)\n\n    # Helper function to check if an array is sorted in non-decreasing order\n    def _is_sorted(current_arr):\n        if not current_arr:\n            return True\n        for i in range(len(current_arr) - 1):\n            if current_arr[i] > current_arr[i+1]:\n                return False\n        return True\n\n    if _is_sorted(arr):\n        return True\n\n    current_arr = list(arr) # Create a mutable copy\n\n    # Try all possible right shifts\n    for _ in range(n - 1): # N-1 shifts are sufficient to check all rotations\n        # Perform one right shift: last element moves to the front\n        last_element = current_arr.pop()\n        current_arr.insert(0, last_element)\n\n        if _is_sorted(current_arr):\n            return True\n\n    return False\n```"}
{"task_id": "HumanEval/111", "solution": "```python\ndef histogram(test):\n    \"\"\"Given a string representing a space separated lowercase letters, return a dictionary\n    of the letter with the most repetition and containing the corresponding count.\n    If several letters have the same occurrence, return all of them.\n    \"\"\"\n    if not test:\n        return {}\n\n    letters = test.split()\n    if not letters:\n        return {}\n\n    counts = {}\n    for letter in letters:\n        counts[letter] = counts.get(letter, 0) + 1\n\n    if not counts:\n        return {}\n\n    max_count = max(counts.values())\n\n    result = {letter: count for letter, count in counts.items() if count == max_count}\n    return result\n```"}
