{"task_id": "HumanEval/68", "solution": "def pluck(arr):\n    \"\"\"\n    Finds the smallest even value and its smallest index in an array.\n    Returns [value, index] or [] if no even values or the array is empty.\n    \"\"\"\n    if not arr:\n        return []\n\n    smallest_even_value = None\n    smallest_even_index = None\n\n    for i, value in enumerate(arr):\n        if value % 2 == 0:  # Check if the value is even\n            if smallest_even_value is None or value < smallest_even_value:\n                smallest_even_value = value\n                smallest_even_index = i\n            elif value == smallest_even_value and i < smallest_even_index:\n                # If values are equal, prioritize the smaller index\n                smallest_even_index = i\n\n    if smallest_even_value is not None and smallest_even_index is not None:\n        return [smallest_even_value, smallest_even_index]\n    else:\n        return []"}
{"task_id": "HumanEval/69", "solution": "def search(lst):\n    '''\n    You are given a non-empty list of positive integers. Return the greatest integer that is greater than\n    zero, and has a frequency greater than or equal to the value of the integer itself.\n    The frequency of an integer is the number of times it appears in the list.\n    If no such a value exist, return -1.\n    Examples:\n        search([4, 1, 2, 2, 3, 1]) == 2\n        search([1, 2, 2, 3, 3, 3, 4, 4, 4]) == 3\n        search([5, 5, 4, 4, 4]) == -1\n    '''\n    from collections import Counter\n\n    # Calculate the frequency of each integer in the list.\n    frequencies = Counter(lst)\n\n    candidates = []\n    # Iterate through each unique number and its frequency.\n    for num, freq in frequencies.items():\n        # Add numbers whose frequency is greater than or equal to their value to candidates.\n        if freq >= num:\n            candidates.append(num)\n\n    # If no candidates satisfy the condition, return -1.\n    if not candidates:\n        return -1\n\n    # Otherwise, return the greatest number among the candidates.\n    return max(candidates)"}
{"task_id": "HumanEval/65", "solution": "```python\ndef circular_shift(x, shift):\n    \"\"\"Circular shift the digits of the integer x, shift the digits right by shift\n    and return the result as a string.\n    If shift > number of digits, return digits reversed.\n    >>> circular_shift(12, 1)\n    \"21\"\n    >>> circular_shift(12, 2)\n    \"12\"\n    \"\"\"\n    if not isinstance(x, int):\n        raise TypeError(\"Input 'x' must be an integer.\")\n    if not isinstance(shift, int):\n        raise TypeError(\"Input 'shift' must be an integer.\")\n    if x < 0:\n        raise ValueError(\"Input 'x' must be a non-negative integer for digit operations.\")\n    if shift < 0:\n        raise ValueError(\"Input 'shift' must be a non-negative integer.\")\n\n    s_x = str(x)\n    num_digits = len(s_x)\n\n    # Handle the special case for x = 0 explicitly, as it has one digit \"0\"\n    # and shifting it always results in \"0\".\n    if x == 0:\n        return \"0\"\n\n    if shift > num_digits:\n        # If shift is greater than the number of digits, reverse the digits\n        return s_x[::-1]\n    else:\n        # Perform a circular shift to the right\n        # The actual shift amount is modulo the number of digits\n        actual_shift = shift % num_digits\n        return s_x[-actual_shift:] + s_x[:-actual_shift]\n\n```"}
{"task_id": "HumanEval/70", "solution": "```python\ndef strange_sort_list(lst):\n    '''\n    Given list of integers, return list in strange order.\n    Strange sorting, is when you start with the minimum value,\n    then maximum of the remaining integers, then minimum and so on.\n    '''\n    if not lst:\n        return []\n\n    mutable_list = lst[:]\n    result = []\n    is_min_turn = True\n\n    while mutable_list:\n        if is_min_turn:\n            val = min(mutable_list)\n        else:\n            val = max(mutable_list)\n\n        result.append(val)\n        mutable_list.remove(val)\n        is_min_turn = not is_min_turn\n\n    return result\n```"}
{"task_id": "HumanEval/67", "solution": "import re\nfrom dataclasses import dataclass\n\n@dataclass\nclass FruitCounts:\n    apples: int\n    oranges: int\n\ndef fruit_distribution(s,n):\n    \"\"\"\n    In this task, you will be given a string that represents a number of apples and oranges\n    that are distributed in a basket of fruit this basket contains\n    apples, oranges, and mango fruits. Given the string that represents the total number of\n    the oranges and apples and an integer that represent the total number of the fruits\n    in the basket return the number of the mango fruits in the basket.\n    for examble:\n    fruit_distribution(\"5 apples and 6 oranges\", 19) ->19 - 5 - 6 = 8\n    fruit_distribution(\"0 apples and 1 oranges\",3) -> 3 - 0 - 1 = 2\n    fruit_distribution(\"2 apples and 3 oranges\", 100) -> 100 - 2 - 3 = 95\n    fruit_distribution(\"100 apples and 1 oranges\",120) -> 120 - 100 - 1 = 19\n    \"\"\"\n    match = re.search(r\"(\\d+)\\s*apples\\s*and\\s*(\\d+)\\s*oranges\", s)\n    if not match:\n        raise ValueError(\"Invalid fruit string format. Expected 'X apples and Y oranges'.\")\n\n    apples = int(match.group(1))\n    oranges = int(match.group(2))\n\n    if apples < 0 or oranges < 0:\n        raise ValueError(\"Fruit counts cannot be negative.\")\n\n    fruit_counts = FruitCounts(apples=apples, oranges=oranges)\n\n    total_apples_oranges = fruit_counts.apples + fruit_counts.oranges\n\n    if n < total_apples_oranges:\n        raise ValueError(f\"Total fruits ({n}) cannot be less than the sum of apples and oranges ({total_apples_oranges}).\")\n\n    mangoes = n - total_apples_oranges\n    return mangoes"}
{"task_id": "HumanEval/71", "solution": "import math\n\ndef triangle_area(a, b, c):\n    \"\"\"\n    Given the lengths of the three sides of a triangle. Return the area of\n    the triangle rounded to 2 decimal points if the three sides form a valid triangle.\n    Otherwise return -1\n    Three sides make a valid triangle when the sum of any two sides is greater\n    than the third side.\n    Example:\n    triangle_area(3, 4, 5) == 6.00\n    triangle_area(1, 2, 10) == -1\n    \"\"\"\n    # Check if all side lengths are positive\n    if not (a > 0 and b > 0 and c > 0):\n        return -1\n\n    # Check the triangle inequality theorem\n    if not (a + b > c and a + c > b and b + c > a):\n        return -1\n\n    # Calculate the semi-perimeter\n    s = (a + b + c) / 2\n\n    # Calculate the area using Heron's formula\n    # The term inside the square root must be non-negative. If the triangle inequality\n    # holds strictly (not degenerate), it will be positive. If it's a degenerate\n    # triangle (which we already excluded by strict inequality checks), it would be zero.\n    area_squared = s * (s - a) * (s - b) * (s - c)\n\n    # Ensure area_squared is not negative due to floating point inaccuracies for near-degenerate cases\n    if area_squared < 0:\n        area_squared = 0 # Handle cases where very small negative results occur due to float precision\n\n    area = math.sqrt(area_squared)\n\n    # Round the area to 2 decimal points\n    return round(area, 2)"}
