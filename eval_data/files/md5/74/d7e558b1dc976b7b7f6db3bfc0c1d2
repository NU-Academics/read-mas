{"task_id": "HumanEval/1", "solution": "```python\ndef separate_paren_groups(paren_string: str) -> List[str]:\n    \"\"\" Input to this function is a string containing multiple groups of nested parentheses. Your goal is to\n    separate those group into separate strings and return the list of those.\n    Separate groups are balanced (each open brace is properly closed) and not nested within each other\n    Ignore any spaces in the input string.\n    >>> separate_paren_groups('( ) (( )) (( )( ))')\n    ['()', '(())', '(()())']\n    \"\"\"\n    result: List[str] = []\n    balance: int = 0\n    temp_group_chars: List[str] = []\n\n    for char in paren_string:\n        if char == '(':\n            balance += 1\n            temp_group_chars.append(char)\n        elif char == ')':\n            # Only process ')' if we have an open parenthesis to close within a potential group.\n            if balance > 0:\n                balance -= 1\n                temp_group_chars.append(char)\n                if balance == 0:  # End of a top-level, balanced group\n                    result.append(\"\".join(temp_group_chars))\n                    temp_group_chars = []  # Reset for the next group\n            # If balance is 0 or less, it's an unmatched closing parenthesis or outside any active group, so it's ignored for group formation.\n        elif char.isspace():\n            # Spaces are effectively ignored in the final output, but are included in temp_group_chars if within an active group.\n            pass\n        else:\n            # Other characters are also collected if we're currently inside a group.\n            # They will be filtered out in the final cleaning step.\n            if balance > 0:\n                temp_group_chars.append(char)\n\n    # Final step: Clean up each collected group to ensure only parentheses remain.\n    # This removes spaces and any other non-parenthesis characters as required.\n    final_result: List[str] = []\n    for group_with_noise in result:\n        cleaned_group = \"\".join(c for c in group_with_noise if c in '()')\n        if cleaned_group:  # Only add if it's not an empty string after cleaning (e.g., from a group like \"a b\")\n            final_result.append(cleaned_group)\n\n    return final_result\n```"}
{"task_id": "HumanEval/7", "solution": "```python\nfrom typing import List\n\n\ndef filter_by_substring(strings: List[str], substring: str) -> List[str]:\n    \"\"\" Filter an input list of strings only for ones that contain given substring\n    >>> filter_by_substring([], 'a')\n    []\n    >>> filter_by_substring(['abc', 'bacd', 'cde', 'array'], 'a')\n    ['abc', 'bacd', 'array']\n    \"\"\"\n    if not strings:\n        return []\n    if not substring:\n        return list(strings)\n\n    filtered_list = [s for s in strings if substring in s]\n    return filtered_list\n```"}
{"task_id": "HumanEval/8", "solution": "import math\nfrom typing import List, Tuple\n\n\ndef sum_product(numbers: List[int]) -> Tuple[int, int]:\n    \"\"\" For a given list of integers, return a tuple consisting of a sum and a product of all the integers in a list.\n    Empty sum should be equal to 0 and empty product should be equal to 1.\n    >>> sum_product([])\n    (0, 1)\n    >>> sum_product([1, 2, 3, 4])\n    (10, 24)\n    \"\"\"\n    if not numbers:\n        return (0, 1)\n\n    current_sum = sum(numbers)\n    current_product = math.prod(numbers)\n\n    return (current_sum, current_product)"}
{"task_id": "HumanEval/9", "solution": "```python\nfrom typing import List, Tuple\n\n\ndef rolling_max(numbers: List[int]) -> List[int]:\n    \"\"\" From a given list of integers, generate a list of rolling maximum element found until given moment\n    in the sequence.\n    >>> rolling_max([1, 2, 3, 2, 3, 4, 2])\n    [1, 2, 3, 3, 3, 4, 4]\n    \"\"\"\n    if not numbers:\n        return []\n\n    result = []\n    current_max = float('-inf')\n\n    for number in numbers:\n        if number > current_max:\n            current_max = number\n        result.append(current_max)\n    return result\n```"}
