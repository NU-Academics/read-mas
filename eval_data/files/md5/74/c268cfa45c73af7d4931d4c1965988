{"task_id": "Mbpp/419", "solution": "import math\ndef _round_half_up(number: float) -> int:\n    \"\"\"\n    Rounds a single floating-point number to the nearest integer.\n    Halves round up for positive numbers; negative halves round towards zero.\n    \"\"\"\n    if number >= 0:\n        return math.floor(number + 0.5)\n    else:\n        return math.ceil(number)\ndef round_and_sum(numbers: list[float]) -> int:\n    \"\"\"\n    Rounds every number of a given list according to specific rules,\n    then calculates the total sum of rounded numbers multiplied by the length of the list.\n    \"\"\"\n    if not numbers:\n        return 0\n\n    rounded_numbers = [_round_half_up(num) for num in numbers]\n    sum_of_rounded = sum(rounded_numbers)\n    count_of_numbers = len(numbers)\n    final_product = sum_of_rounded * count_of_numbers\n\n    return final_product"}
