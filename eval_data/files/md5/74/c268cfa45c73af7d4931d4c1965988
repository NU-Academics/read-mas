{"task_id": "Mbpp/427", "solution": "class DateComponents:\n    \"\"\"A simple data structure to hold parsed year, month, and day components.\"\"\"\n    def __init__(self, year: str, month: str, day: str):\n        self.year = year\n        self.month = month\n        self.day = day\nclass DateConverter:\n    \"\"\"Encapsulates the logic for parsing and formatting date strings.\"\"\"\n    def __init__(self):\n        pass\n\n    def _parse_yyyy_mm_dd(self, input_date_string: str) -> DateComponents:\n        \"\"\"Parses a 'yyyy-mm-dd' string into DateComponents.\"\"\"\n        parts = input_date_string.split('-')\n        year, month, day = parts[0], parts[1], parts[2]\n        return DateComponents(year, month, day)\n\n    def _format_dd_mm_yyyy(self, components: DateComponents) -> str:\n        \"\"\"Formats DateComponents into a 'dd-mm-yyyy' string.\"\"\"\n        return f\"{components.day}-{components.month}-{components.year}\"\n\n    def convert(self, input_date_string: str) -> str:\n        \"\"\"Converts a date string from 'yyyy-mm-dd' format to 'dd-mm-yyyy' format.\"\"\"\n        components = self._parse_yyyy_mm_dd(input_date_string)\n        return self._format_dd_mm_yyyy(components)\ndef change_date_format(input_date_string: str) -> str:\n    \"\"\"\n    Converts a date of yyyy-mm-dd format to dd-mm-yyyy format.\n    Assumes valid input adhering to the yyyy-mm-dd format.\n    \"\"\"\n    converter = DateConverter()\n    return converter.convert(input_date_string)"}
