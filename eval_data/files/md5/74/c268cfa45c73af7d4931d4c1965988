{"task_id": "Mbpp/743", "solution": "def rotate_right(input_list: list, rotation_count: int) -> list:\n    \"\"\"\n    Rotates a list to the right by the specified number of items.\n    Returns a new list representing the input_list rotated to the right.\n    \"\"\"\n    if not input_list:\n        return []\n\n    n = len(input_list)\n    effective_rotation_count = rotation_count % n\n\n    rotated_part = input_list[n - effective_rotation_count:]\n    remaining_part = input_list[:n - effective_rotation_count]\n\n    return rotated_part + remaining_part"}
{"task_id": "Mbpp/745", "solution": "class Number:\n    \"\"\"Encapsulates an integer and provides methods to check its properties related to digits and divisibility.\"\"\"\n    def __init__(self, value: int):\n        \"\"\"Initializes a Number object with an integer value.\"\"\"\n        self._value = value\n\n    def get_digits(self) -> list[int]:\n        \"\"\"Extracts and returns the constituent digits of the number.\"\"\"\n        if self._value == 0:\n            return [0]\n        digits = []\n        temp_value = abs(self._value)\n        while temp_value > 0:\n            digits.append(temp_value % 10)\n            temp_value //= 10\n        return digits[::-1]\n\n    def contains_zero_digit(self) -> bool:\n        \"\"\"Checks if the number contains the digit 0.\"\"\"\n        return 0 in self.get_digits()\n\n    def is_divisible_by_all_digits(self) -> bool:\n        \"\"\"Verifies if the number is perfectly divisible by each of its non-zero constituent digits.\"\"\"\n        digits = self.get_digits()\n        for digit in digits:\n            if self._value % digit != 0:\n                return False\n        return True\ndef divisible_by_digits(startnum: int, endnum: int) -> list[int]:\n    \"\"\"\n    Finds numbers within a given range [startnum, endnum] where every number\n    is divisible by every digit it contains, excluding numbers with the digit 0.\n    \"\"\"\n    result_list = []\n    for n in range(startnum, endnum + 1):\n        number_obj = Number(n)\n        if not number_obj.contains_zero_digit():\n            if number_obj.is_divisible_by_all_digits():\n                result_list.append(n)\n    return result_list"}
{"task_id": "Mbpp/748", "solution": "def capital_words_spaces(input_string: str) -> str:\n    \"\"\"\n    Inserts spaces before capital letters in a string, excluding the first character.\n    \"\"\"\n    if not input_string:\n        return \"\"\n\n    result_chars = [input_string[0]]\n    for char in input_string[1:]:\n        if char.isupper():\n            result_chars.append(\" \")\n        result_chars.append(char)\n\n    return \"\".join(result_chars)"}
