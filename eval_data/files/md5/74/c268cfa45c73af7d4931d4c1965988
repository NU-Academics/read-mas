{"task_id": "Mbpp/605", "solution": "def prime_num(number: int) -> bool:\n    \"\"\"\n    Determines if a given integer is a prime number.\n    Numbers less than or equal to 1 are not considered prime.\n    \"\"\"\n    if number <= 1:\n        return False\n    i = 2\n    while i * i <= number:\n        if number % i == 0:\n            return False\n        i += 1\n    return True"}
{"task_id": "Mbpp/607", "solution": "import re\ndef find_literals(target_string: str, regex_pattern: str) -> tuple[str, int, int]:\n    \"\"\"\n    Searches a target string for the first occurrence of a regex pattern.\n    Returns the matching substring, its start index, and its end index.\n    \"\"\"\n    match = re.search(regex_pattern, target_string)\n    if match:\n        return match.group(0), match.start(), match.end()\n    else:\n        return '', -1, -1"}
{"task_id": "Mbpp/612", "solution": "def merge(input_list: list) -> list:\n    \"\"\"\n    Transforms a list of lists, where each sublist has two elements,\n    into a list of two lists where the first list has the first element\n    of each sublist and the second one has the second.\n    \"\"\"\n    first_elements = []\n    second_elements = []\n    for sublist in input_list:\n        first_elements.append(sublist[0])\n        second_elements.append(sublist[1])\n    return [first_elements, second_elements]"}
{"task_id": "Mbpp/608", "solution": "def bell_Number(n: int) -> int:\n    \"\"\"\n    Calculates the nth Bell number using Stirling numbers of the second kind.\n    \"\"\"\n    if n == 0:\n        return 1\n\n    # Initialize a 2D array for Stirling numbers of the second kind S(n, k)\n    # S[i][j] stores S(i, j)\n    stirling = [[0] * (n + 1) for _ in range(n + 1)]\n\n    # Base cases for Stirling numbers\n    stirling[0][0] = 1\n\n    for i in range(1, n + 1):\n        for j in range(1, i + 1):\n            # Recurrence relation: S(n, k) = k * S(n-1, k) + S(n-1, k-1)\n            stirling[i][j] = j * stirling[i - 1][j] + stirling[i - 1][j - 1]\n\n    # Bell number B(n) = sum_{k=0}^{n} S(n, k)\n    bell_n = 0\n    for k in range(n + 1):\n        bell_n += stirling[n][k]\n\n    return bell_n"}
