{"task_id": "Mbpp/592", "solution": "def sum_Of_product(n: int) -> int:\n    \"\"\"\n    Calculates the sum of the product of consecutive binomial coefficients C(n, k) * C(n, k+1).\n    \"\"\"\n\n    def _binomial_coefficient(n: int, k: int) -> int:\n        \"\"\"\n        Calculates the binomial coefficient C(n, k) using an iterative approach.\n        \"\"\"\n        if k < 0 or k > n:\n            return 0\n        if k == 0 or k == n:\n            return 1\n        if k > n // 2:\n            k = n - k\n\n        res = 1\n        for i in range(k):\n            res = res * (n - i) // (i + 1)\n        return res\n\n    total_sum = 0\n    for k in range(n):\n        coeff_k = _binomial_coefficient(n, k)\n        coeff_k_plus_1 = _binomial_coefficient(n, k + 1)\n        total_sum += coeff_k * coeff_k_plus_1\n    return total_sum"}
{"task_id": "Mbpp/589", "solution": "import math\ndef _is_perfect_square(n: int) -> bool:\n    \"\"\"Checks if the input integer n is a perfect square.\"\"\"\n    if n < 0:\n        return False\n    root = math.isqrt(n)\n    return root * root == n\ndef perfect_squares(start_int: int, end_int: int) -> list[int]:\n    \"\"\"Calculates and returns a sorted list of perfect squares between start_int and end_int (inclusive).\"\"\"\n    perfect_squares_list = []\n    for num in range(start_int, end_int + 1):\n        if _is_perfect_square(num):\n            perfect_squares_list.append(num)\n    return perfect_squares_list"}
{"task_id": "Mbpp/593", "solution": "def removezero_ip(ip_address_string: str) -> str:\n    \"\"\"Removes leading zeros from each octet of an IPv4 address string.\"\"\"\n\n    class Octet:\n        \"\"\"Represents a single octet of an IPv4 address, handling leading zero removal.\"\"\"\n        def __init__(self, raw_value: str):\n            self._raw_value = raw_value\n            self._numeric_value = int(raw_value) # Implicitly removes leading zeros\n\n        def get_cleaned_value(self) -> str:\n            \"\"\"Returns the string representation of the octet without leading zeros.\"\"\"\n            return str(self._numeric_value)\n\n    class IPv4Address:\n        \"\"\"Represents an IPv4 address, parsing it into Octet objects and reconstructing the cleaned string.\"\"\"\n        def __init__(self, raw_address_string: str):\n            self._raw_address_string = raw_address_string\n            self._octets = []\n            for octet_string in raw_address_string.split('.'):\n                self._octets.append(Octet(octet_string))\n\n        def reconstruct(self) -> str:\n            \"\"\"Reconstructs the cleaned IPv4 address string from its Octet components.\"\"\"\n            cleaned_octet_values = [octet.get_cleaned_value() for octet in self._octets]\n            return \".\".join(cleaned_octet_values)\n\n    ipv4_address = IPv4Address(ip_address_string)\n    return ipv4_address.reconstruct()"}
