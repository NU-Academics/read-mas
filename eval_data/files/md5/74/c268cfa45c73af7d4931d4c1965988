{"task_id": "Mbpp/635", "solution": "def heap_sort(input_list: list) -> list:\n    \"\"\"\n    Sorts a list of comparable elements in ascending order using the heap sort algorithm.\n    The original input list is not modified.\n    \"\"\"\n    def _heapify(arr: list, n: int, i: int) -> None:\n        \"\"\"Maintains the max-heap property for a subtree rooted at index i.\"\"\"\n        largest = i\n        left = 2 * i + 1\n        right = 2 * i + 2\n\n        if left < n and arr[largest] < arr[left]:\n            largest = left\n\n        if right < n and arr[largest] < arr[right]:\n            largest = right\n\n        if largest != i:\n            arr[i], arr[largest] = arr[largest], arr[i]\n            _heapify(arr, n, largest)\n\n    def _build_max_heap(arr: list) -> None:\n        \"\"\"Builds a max-heap from an unsorted list in-place.\"\"\"\n        n = len(arr)\n        for i in range(n // 2 - 1, -1, -1):\n            _heapify(arr, n, i)\n\n    arr = list(input_list)\n    n = len(arr)\n\n    if n <= 1:\n        return arr\n\n    _build_max_heap(arr)\n\n    for i in range(n - 1, 0, -1):\n        arr[i], arr[0] = arr[0], arr[i]\n        _heapify(arr, i, 0)\n\n    return arr"}
{"task_id": "Mbpp/630", "solution": "def get_coordinates(coordinate_tuple: tuple[int, int]) -> list[list[int]]:\n    \"\"\"\n    Extracts all adjacent coordinates for a given coordinate tuple, including itself.\n    The output list is sorted first by x-coordinate, then by y-coordinate.\n    \"\"\"\n    x, y = coordinate_tuple\n    adjacent_coords = []\n    for dx in range(-1, 2):\n        for dy in range(-1, 2):\n            adjacent_coords.append([x + dx, y + dy])\n    return adjacent_coords"}
{"task_id": "Mbpp/631", "solution": "def replace_spaces(input_string: str) -> str:\n    \"\"\"\n    Replaces whitespaces with underscores, or underscores with whitespaces,\n    based on specific rules.\n    \"\"\"\n    has_whitespace = ' ' in input_string\n    has_underscore = '_' in input_string\n\n    if has_whitespace:\n        return input_string.replace(' ', '_')\n    elif has_underscore and not has_whitespace:\n        return input_string.replace('_', ' ')\n    else:\n        return input_string"}
{"task_id": "Mbpp/160", "solution": "def extended_gcd(a: int, b: int) -> tuple[int, int, int]:\n    \"\"\"\n    Computes the greatest common divisor (GCD) of two integers a and b,\n    and finds integers x and y such that ax + by = gcd(a, b) (Bezout's identity).\n    The GCD returned is always non-negative.\n    \"\"\"\n    if b == 0:\n        # Base case: gcd(a, 0) = |a|. Bezout's coefficients are (sign(a), 0).\n        # Ensures that a*x + b*y = |a| is satisfied.\n        return (abs(a), 1 if a >= 0 else -1, 0)\n    else:\n        # Recursive step using the Extended Euclidean Algorithm.\n        gcd, x1, y1 = extended_gcd(b, a % b)\n        # Recalculate x and y for the current level based on the previous step's coefficients.\n        x = y1\n        y = x1 - (a // b) * y1\n        return (gcd, x, y)\ndef find_solution(a: int, b: int, n: int) -> tuple[int, int] | None:\n    \"\"\"\n    Finds integer solutions (x, y) for the linear Diophantine equation ax + by = n.\n    Returns a tuple (x, y) if a solution exists, or None otherwise.\n    \"\"\"\n    # Handle the special case where both 'a' and 'b' are zero.\n    if a == 0 and b == 0:\n        if n == 0:\n            # If 0*x + 0*y = 0, any (x,y) is a solution. Return (0,0) as a trivial one.\n            return (0, 0)\n        else:\n            # If 0*x + 0*y = n (n != 0), no solution exists.\n            return None\n\n    # Use the extended Euclidean algorithm to find g = gcd(a, b) and Bezout coefficients x_g, y_g\n    # such that a*x_g + b*y_g = g.\n    g, x_g, y_g = extended_gcd(a, b)\n\n    # A solution exists if and only if n is divisible by g (gcd(a, b)).\n    if n % g != 0:\n        return None\n    else:\n        # Calculate the scalar factor to scale Bezout's identity to ax + by = n.\n        k_scale = n // g\n\n        # A particular solution (x_p, y_p) can be found by scaling the Bezout coefficients.\n        x_p = x_g * k_scale\n        y_p = y_g * k_scale\n\n        # The problem assert implies a specific solution is desired (e.g., smallest non-negative x).\n        # We find a canonical solution by adjusting x_p using the general solution form:\n        # x = x_p + t * (b/g)\n        # y = y_p - t * (a/g)\n        # We choose t such that x is in a specific range, e.g., [0, |b/g|-1] if b/g != 0.\n        \n        # If 'b' is zero, 'x' is uniquely determined as n/a (if a!=0), and 'y' can be anything.\n        # Our extended_gcd(a, 0) will yield y_g = 0, so y_p = 0, which is a valid choice.\n        if b != 0:\n            # Calculate the term for shifting x, (b // g). This term can be negative.\n            shift_term_x = b // g\n            \n            # Adjust x to find a specific solution (e.g., smallest non-negative x if shift_term_x > 0).\n            # The modulo operator '%' in Python behaves such that a % n has the same sign as n.\n            # This expression effectively finds x_p + t * (b/g) such that x is in a specific congruence class.\n            x = (x_p % shift_term_x + shift_term_x) % shift_term_x\n            \n            # Once 'x' is determined, 'y' can be uniquely found from the equation.\n            y = (n - a * x) // b\n        else:\n            # If b is 0, then a cannot be 0 (handled at the beginning).\n            # x is uniquely determined as n/a, and y is the particular solution's y.\n            x = x_p\n            y = y_p\n            \n        return (x, y)"}
{"task_id": "Mbpp/638", "solution": "def wind_chill(temperature_celsius: float, wind_velocity_kmh: float) -> int:\n    \"\"\"Calculates the wind chill index using a specific formula and rounds it to the nearest integer.\"\"\"\n    # Ensure wind velocity is at least 0.16 for power calculation, as per common practice for these formulas.\n    # The design context implies valid inputs, so direct application is sufficient.\n    v_power_0_16 = wind_velocity_kmh ** 0.16\n    \n    # Apply the wind chill index formula\n    wci = 13.12 + 0.6215 * temperature_celsius - 11.37 * v_power_0_16 + 0.3965 * temperature_celsius * v_power_0_16\n    \n    # Round the calculated WCI to the nearest integer\n    return round(wci)"}
{"task_id": "Mbpp/735", "solution": "def toggle_middle_bits(number: int) -> int:\n    \"\"\"\n    Toggles bits of the number except the leftmost '1' (MSB) and the rightmost '1' (LSB).\n    If there are no bits strictly between the MSB and LSB, the number remains unchanged.\n    \"\"\"\n    def _to_binary_string(num: int) -> str:\n        \"\"\"Converts an integer to its binary string representation without the '0b' prefix.\"\"\"\n        return bin(num)[2:]\n\n    def _find_msb_lsb_positions(binary_str: str) -> tuple[int, int]:\n        \"\"\"Identifies the string indices of the leftmost '1' (MSB) and rightmost '1' (LSB).\"\"\"\n        msb_index = binary_str.find('1')\n        lsb_index = binary_str.rfind('1')\n        return msb_index, lsb_index\n\n    def _toggle_bits_in_range(binary_str: str, msb_pos: int, lsb_pos: int) -> str:\n        \"\"\"Toggles bits in the binary string strictly between the given MSB and LSB positions.\"\"\"\n        char_list = list(binary_str)\n        for i in range(msb_pos + 1, lsb_pos):\n            char_list[i] = '1' if char_list[i] == '0' else '0'\n        return \"\".join(char_list)\n\n    def _to_decimal(binary_str: str) -> int:\n        \"\"\"Converts a binary string representation back to an integer.\"\"\"\n        return int(binary_str, 2)\n\n    if number == 0:\n        return 0\n\n    binary_str = _to_binary_string(number)\n    msb_pos, lsb_pos = _find_msb_lsb_positions(binary_str)\n\n    # If there are no bits strictly between the MSB (leftmost '1') and LSB (rightmost '1'),\n    # or if the number has only one '1' bit, return the original number.\n    if msb_pos + 1 >= lsb_pos:\n        return number\n    \n    modified_binary_str = _toggle_bits_in_range(binary_str, msb_pos, lsb_pos)\n    return _to_decimal(modified_binary_str)"}
