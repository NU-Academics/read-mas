{"task_id": "Mbpp/129", "solution": "from typing import List\nclass Matrix:\n    \"\"\"Encapsulates a 2D list matrix and provides dimension and element access.\"\"\"\n    def __init__(self, elements: List[List[int]]):\n        self._elements = elements\n        self._row_count = len(elements)\n        self._col_count = len(elements[0]) if elements and elements[0] else 0\n\n    def get_row_count(self) -> int:\n        \"\"\"Returns the number of rows in the matrix.\"\"\"\n        return self._row_count\n\n    def get_column_count(self) -> int:\n        \"\"\"Returns the number of columns in the matrix.\"\"\"\n        return self._col_count\n\n    def get_element(self, row: int, col: int) -> int:\n        \"\"\"Returns the element at the specified row and column.\"\"\"\n        return self._elements[row][col]\n\n    def is_square(self) -> bool:\n        \"\"\"Verifies if the matrix has an equal number of rows and columns.\"\"\"\n        return self._row_count == self._col_count\nclass MagicSquareChecker:\n    \"\"\"Contains business logic to check if a matrix is a magic square.\"\"\"\n    def _calculate_row_sum(self, matrix: Matrix, rowIndex: int) -> int:\n        \"\"\"Calculates the sum of elements in a specific row.\"\"\"\n        row_sum = 0\n        n = matrix.get_column_count()\n        for colIndex in range(n):\n            row_sum += matrix.get_element(rowIndex, colIndex)\n        return row_sum\n\n    def _calculate_column_sum(self, matrix: Matrix, colIndex: int) -> int:\n        \"\"\"Calculates the sum of elements in a specific column.\"\"\"\n        col_sum = 0\n        n = matrix.get_row_count()\n        for rowIndex in range(n):\n            col_sum += matrix.get_element(rowIndex, colIndex)\n        return col_sum\n\n    def _calculate_main_diagonal_sum(self, matrix: Matrix) -> int:\n        \"\"\"Calculates the sum of elements in the main diagonal.\"\"\"\n        diag_sum = 0\n        n = matrix.get_row_count()\n        for i in range(n):\n            diag_sum += matrix.get_element(i, i)\n        return diag_sum\n\n    def _calculate_anti_diagonal_sum(self, matrix: Matrix) -> int:\n        \"\"\"Calculates the sum of elements in the anti-diagonal.\"\"\"\n        anti_diag_sum = 0\n        n = matrix.get_row_count()\n        for i in range(n):\n            anti_diag_sum += matrix.get_element(i, n - 1 - i)\n        return anti_diag_sum\n\n    def _compare_sums(self, sums: List[int]) -> bool:\n        \"\"\"Compares a list of sums to check if all are equal.\"\"\"\n        if not sums:\n            return True\n        first_sum = sums[0]\n        for s in sums:\n            if s != first_sum:\n                return False\n        return True\n\n    def check_magic_square(self, matrix: Matrix) -> bool:\n        \"\"\"Determines if the given matrix is a magic square.\"\"\"\n        all_sums = []\n        n = matrix.get_row_count()\n\n        # Calculate row sums\n        for i in range(n):\n            all_sums.append(self._calculate_row_sum(matrix, i))\n\n        # Calculate column sums\n        for i in range(n):\n            all_sums.append(self._calculate_column_sum(matrix, i))\n\n        # Calculate main diagonal sum\n        all_sums.append(self._calculate_main_diagonal_sum(matrix))\n\n        # Calculate anti-diagonal sum\n        all_sums.append(self._calculate_anti_diagonal_sum(matrix))\n\n        return self._compare_sums(all_sums)\ndef magic_square_test(matrix_data: List[List[int]]) -> bool:\n    \"\"\"\n    Accepts a 2D list representing a matrix and returns True if it is a magic square, False otherwise.\n    This function orchestrates the use of Matrix and MagicSquareChecker.\n    \"\"\"\n    matrix = Matrix(matrix_data)\n\n    if not matrix.is_square():\n        return False\n    \n    # An empty (0x0) matrix is considered square by Matrix.is_square().\n    # Its row and column sums would be 0, and diagonal sums would be 0.\n    # _compare_sums([0, 0, ..., 0]) would return True.\n    # Thus, an empty matrix `[]` would be identified as a magic square by this implementation.\n\n    checker = MagicSquareChecker()\n    return checker.check_magic_square(matrix)"}
{"task_id": "Mbpp/131", "solution": "def reverse_vowels(s: str) -> str:\n    \"\"\"Reverses only the vowels within a given string, preserving non-vowel positions and casing.\"\"\"\n\n    def _is_vowel(char: str) -> bool:\n        \"\"\"Checks if a character is a vowel (a, e, i, o, u, case-insensitive).\"\"\"\n        return char.lower() in 'aeiou'\n\n    char_list = list(s)\n    vowels_found = []\n\n    # First pass: collect all vowels in their original order and case\n    for char in char_list:\n        if _is_vowel(char):\n            vowels_found.append(char)\n\n    # Reverse the collected vowels\n    vowels_found.reverse()\n\n    # Second pass: replace vowels in the original positions with the reversed vowels\n    reversed_vowels_idx = 0\n    for i in range(len(char_list)):\n        if _is_vowel(char_list[i]):\n            char_list[i] = vowels_found[reversed_vowels_idx]\n            reversed_vowels_idx += 1\n\n    return \"\".join(char_list)"}
