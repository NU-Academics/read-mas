{"task_id": "Mbpp/11", "solution": "def remove_Occ(input_string: str, target_char: str) -> str:\n    \"\"\"\n    Removes the first and last occurrences of a given character from a string.\n    If the character is not found, the original string is returned.\n    \"\"\"\n    first_index = input_string.find(target_char)\n    last_index = input_string.rfind(target_char)\n\n    if first_index == -1:\n        return input_string\n\n    if first_index == last_index:\n        return input_string[:first_index] + input_string[first_index + 1:]\n    else:\n        temp_string = input_string[:last_index] + input_string[last_index + 1:]\n        return temp_string[:first_index] + temp_string[first_index + 1:]"}
{"task_id": "Mbpp/8", "solution": "def square_nums(input_list: list) -> list:\n    \"\"\"Calculates the square of each element in the input list.\n    Returns a new list containing the squared values of the input elements.\n    \"\"\"\n    result_list = []\n    for number in input_list:\n        result_list.append(number * number)\n    return result_list"}
{"task_id": "Mbpp/2", "solution": "from typing import Iterable, Set, Any\ndef similar_elements(list1: Iterable[Any], list2: Iterable[Any]) -> Set[Any]:\n    \"\"\"\n    Finds elements common to both input iterables and returns them as a set.\n    Converts inputs to sets and performs an intersection for efficient comparison.\n    \"\"\"\n    set1 = set(list1)\n    set2 = set(list2)\n    return set1.intersection(set2)"}
{"task_id": "Mbpp/9", "solution": "def find_Rotations(input_string: str) -> int:\n    # Iterate through possible rotation counts starting from 1.\n    n = len(input_string)\n    for k in range(1, n + 1):\n        rotated_string = input_string[k:] + input_string[:k]\n        if rotated_string == input_string:\n            return k\n    # This case should ideally not be reached for non-empty strings,\n    # as rotating by n times always returns the original string.\n    return n"}
{"task_id": "Mbpp/7", "solution": "class Word:\n    \"\"\"Encapsulates a word's text and provides length-based filtering, with equality and hash based on its text.\"\"\"\n    def __init__(self, text: str):\n        self._text = text\n        self._length = len(text)\n\n    def isAtLeast(self, min_length: int) -> bool:\n        \"\"\"Checks if the word's length meets the minimum.\"\"\"\n        return self._length >= min_length\n\n    def get_text(self) -> str:\n        \"\"\"Returns the word's text content.\"\"\"\n        return self._text\n\n    def __eq__(self, other) -> bool:\n        \"\"\"Compares Word objects based on their text for equality.\"\"\"\n        if not isinstance(other, Word):\n            return NotImplemented\n        return self._text == other._text\n\n    def __hash__(self) -> int:\n        \"\"\"Provides a hash for Word objects based on their text.\"\"\"\n        return hash(self._text)\nclass WordCollection:\n    \"\"\"Stores and manages a unique collection of Word objects.\"\"\"\n    def __init__(self):\n        self._words: set[Word] = set()\n\n    def addWord(self, word: Word):\n        \"\"\"Adds a Word object to the collection.\"\"\"\n        self._words.add(word)\n\n    def getTextSet(self) -> set[str]:\n        \"\"\"Returns a set of string representations of the collected words.\"\"\"\n        return {word.get_text() for word in self._words}\nclass String:\n    \"\"\"Encapsulates the input text and provides methods for tokenizing it into Word objects.\"\"\"\n    def __init__(self, content: str):\n        self._content = content\n\n    def getWords(self) -> list[Word]:\n        \"\"\"Tokenizes the content into individual words and returns them as a list of Word objects.\"\"\"\n        return [Word(token) for token in self._content.split()]\ndef find_char_long(input_string: str) -> set[str]:\n    \"\"\"\n    Orchestrates the process of identifying, filtering, and collecting words from an input string based on length.\n    This function uses String, Word, and WordCollection classes to perform word processing.\n    \"\"\"\n    string_obj = String(input_string)\n    word_collection = WordCollection()\n\n    all_words = string_obj.getWords()\n    for word in all_words:\n        if word.isAtLeast(4):\n            word_collection.addWord(word)\n\n    return word_collection.getTextSet()"}
{"task_id": "Mbpp/3", "solution": "def is_not_prime(number: int) -> bool:\n    \"\"\"Determines if an integer is a non-prime number.\n\n    Returns True if the number is non-prime, False otherwise (prime or <= 1).\n    \"\"\"\n    if number <= 1:\n        return False\n    if number == 2:\n        return False\n    if number % 2 == 0:\n        return True\n    i = 3\n    while i * i <= number:\n        if number % i == 0:\n            return True\n        i += 2\n    return False"}
{"task_id": "Mbpp/6", "solution": "def differ_At_One_Bit_Pos(num1: int, num2: int) -> bool:\n    \"\"\"\n    Checks if two numbers differ at exactly one bit position.\n    This is true if their XOR result is a power of two.\n    \"\"\"\n    xor_val = num1 ^ num2\n    # A number is a power of two if it's positive and x & (x - 1) is 0.\n    return xor_val > 0 and (xor_val & (xor_val - 1)) == 0"}
