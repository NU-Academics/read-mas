{"task_id": "Mbpp/567", "solution": "def issort_list(input_list: list) -> bool:\n    \"\"\"Checks if the specified list is sorted in ascending order.\n\n    Args:\n        input_list: A list of comparable elements.\n\n    Returns:\n        True if the list is sorted in ascending order, False otherwise.\n    \"\"\"\n    if len(input_list) <= 1:\n        return True\n    \n    for i in range(len(input_list) - 1):\n        if input_list[i] > input_list[i+1]:\n            return False\n            \n    return True"}
{"task_id": "Mbpp/572", "solution": "def two_unique_nums(input_list: list) -> list:\n    \"\"\"\n    Identifies and returns numbers that appear exactly once in a given list,\n    preserving their relative order as they first appeared.\n    \"\"\"\n    from collections import Counter\n\n    if not input_list:\n        return []\n\n    counts = Counter(input_list)\n    unique_elements = []\n    for num in input_list:\n        if counts[num] == 1:\n            unique_elements.append(num)\n    return unique_elements"}
{"task_id": "Mbpp/564", "solution": "def count_Pairs(input_list: list[int], unused_arg: int) -> int:\n    \"\"\"\n    Counts the number of possible unordered pairs where both elements are unequal.\n    The second argument `unused_arg` is present for signature compliance but is not used.\n    \"\"\"\n    count = 0\n    n = len(input_list)\n\n    for i in range(n):\n        for j in range(i + 1, n):\n            if input_list[i] != input_list[j]:\n                count += 1\n    return count"}
{"task_id": "Mbpp/569", "solution": "def sort_sublists(input_list_of_lists: list[list[str]]) -> list[list[str]]:\n    \"\"\"\n    Sorts each sublist of strings within a given list of lists lexicographically in ascending order.\n    The original order of sublists is preserved.\n    \"\"\"\n    return [sorted(sublist) for sublist in input_list_of_lists]"}
{"task_id": "Mbpp/573", "solution": "def unique_product(numbers_list: list) -> (int | float):\n    \"\"\"\n    Calculates the product of unique numbers in a given list.\n    Returns 1 if the list of unique numbers is empty.\n    \"\"\"\n    unique_numbers = set(numbers_list)\n\n    if not unique_numbers:\n        return 1\n\n    product = 1\n    for num in unique_numbers:\n        product *= num\n\n    return product"}
{"task_id": "Mbpp/578", "solution": "class ListLengthMismatchError(Exception):\n    \"\"\"Custom exception for when input lists have different lengths.\"\"\"\n    def __init__(self, message: str):\n        self.message = message\n        super().__init__(self.message)\ndef interleave_lists(list1: list, list2: list, list3: list) -> list:\n    \"\"\"\n    Interleaves three input lists of the same length into a single flat list.\n    Raises ListLengthMismatchError if input lists do not have identical lengths.\n    \"\"\"\n    if not (len(list1) == len(list2) == len(list3)):\n        raise ListLengthMismatchError(\"Input lists must have identical lengths.\")\n\n    result = []\n    for i in range(len(list1)):\n        result.append(list1[i])\n        result.append(list2[i])\n        result.append(list3[i])\n    return result"}
{"task_id": "Mbpp/577", "solution": "def last_Digit_Factorial(n: int) -> int:\n    \"\"\"\n    Calculates the last digit of the factorial of a given non-negative integer.\n    Raises ValueError if n is negative.\n    \"\"\"\n    if n < 0:\n        raise ValueError(\"Input must be a non-negative integer.\")\n    elif n == 0:\n        return 1\n    elif n == 1:\n        return 1\n    elif n == 2:\n        return 2\n    elif n == 3:\n        return 6\n    elif n == 4:\n        return 4\n    else: # n >= 5\n        return 0"}
{"task_id": "Mbpp/579", "solution": "def find_dissimilar(tuple1: tuple, tuple2: tuple) -> tuple:\n    \"\"\"Finds dissimilar elements between two tuples, maintaining relative order.\n    Elements are considered dissimilar if they are present in one tuple but not the other.\n    \"\"\"\n    set1 = set(tuple1)\n    set2 = set(tuple2)\n    result_list = []\n\n    for element in tuple1:\n        if element not in set2:\n            result_list.append(element)\n\n    for element in tuple2:\n        if element not in set1:\n            result_list.append(element)\n\n    return tuple(result_list)"}
{"task_id": "Mbpp/576", "solution": "def is_Sub_Array(main_list: list, sublist_candidate: list) -> bool:\n    \"\"\"\n    Checks if sublist_candidate is a contiguous sublist of main_list.\n    Iterates through main_list, comparing slices with sublist_candidate.\n    \"\"\"\n    n = len(main_list)\n    m = len(sublist_candidate)\n\n    if m == 0:\n        return True  # An empty list is always considered a sublist\n\n    if m > n:\n        return False # Sublist cannot be longer than the main list\n\n    for i in range(n - m + 1):\n        if main_list[i:i + m] == sublist_candidate:\n            return True\n\n    return False"}
{"task_id": "Mbpp/580", "solution": "def extract_even(input_tuple: tuple) -> tuple:\n    \"\"\"\n    Recursively processes a nested tuple, filtering out odd integer elements.\n    Returns a new tuple containing only even integers and recursively processed nested tuples.\n    \"\"\"\n    result_list = []\n    for element in input_tuple:\n        if isinstance(element, int):\n            if element % 2 == 0:\n                result_list.append(element)\n        elif isinstance(element, tuple):\n            processed_nested_tuple = extract_even(element)\n            if processed_nested_tuple:\n                result_list.append(processed_nested_tuple)\n    return tuple(result_list)"}
{"task_id": "Mbpp/581", "solution": "import math\ndef surface_Area(base_edge, height):\n    \"\"\"\n    Calculates the surface area of a square pyramid.\n    This includes the base area and the sum of the areas of the four triangular faces.\n    \"\"\"\n    base_area = base_edge ** 2\n    slant_height = math.sqrt(height**2 + (base_edge / 2)**2)\n    lateral_surface_area = 2 * base_edge * slant_height\n    total_surface_area = base_area + lateral_surface_area\n    return total_surface_area"}
{"task_id": "Mbpp/585", "solution": "def expensive_items(items: list[dict], n: int) -> list[dict]:\n    \"\"\"\n    Finds the n most expensive items from a list of dictionaries, sorted by price in descending order.\n    Each dictionary in 'items' must contain a 'price' key.\n    \"\"\"\n    sorted_items = sorted(items, key=lambda item: item['price'], reverse=True)\n    return sorted_items[:n]"}
{"task_id": "Mbpp/583", "solution": "def catalan_number(n: int) -> int:\n    \"\"\"\n    Calculates the nth Catalan number.\n\n    Args:\n        n (int): The index of the Catalan number to calculate (n >= 0).\n\n    Returns:\n        int: The nth Catalan number.\n\n    Raises:\n        ValueError: If n is negative.\n    \"\"\"\n    if n < 0:\n        raise ValueError(\"Catalan number is not defined for negative n.\")\n    if n == 0:\n        return 1\n\n    def binomial_coefficient(N, K):\n        if K < 0 or K > N:\n            return 0\n        if K == 0 or K == N:\n            return 1\n        if K > N // 2:\n            K = N - K\n\n        res = 1\n        for i in range(K):\n            res = res * (N - i) // (i + 1)\n        return res\n\n    binomial_2n_n = binomial_coefficient(2 * n, n)\n\n    return binomial_2n_n // (n + 1)"}
{"task_id": "Mbpp/586", "solution": "def split_Arr(input_list: list, n: int) -> list:\n    \"\"\"Splits an input list at index n and appends the first part to the end of the second part.\"\"\"\n    first_part = input_list[:n]\n    second_part = input_list[n:]\n    reordered_list = second_part + first_part\n    return reordered_list"}
{"task_id": "Mbpp/588", "solution": "def big_diff(numbers_list):\n    \"\"\"\n    Calculates the difference between the largest and smallest value in a given list of numbers.\n    Returns 0 if the input list is empty.\n    \"\"\"\n    if not numbers_list:\n        return 0\n\n    largest_value = max(numbers_list)\n    smallest_value = min(numbers_list)\n\n    difference = largest_value - smallest_value\n    return difference"}
