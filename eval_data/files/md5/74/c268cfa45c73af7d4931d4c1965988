{"task_id": "Mbpp/300", "solution": "def _combinations(n: int, k: int) -> int:\n    \"\"\"Calculates the binomial coefficient C(n, k).\"\"\"\n    if k < 0 or k > n:\n        return 0\n    if k == 0 or k == n:\n        return 1\n    if k > n // 2:\n        k = n - k\n    \n    result = 1\n    for i in range(k):\n        result = result * (n - i) // (i + 1)\n    return result\ndef count_binary_seq(n: int) -> int:\n    \"\"\"\n    Calculates the count of binary sequences of length 2n where the sum of\n    the first n bits equals the sum of the last n bits.\n    \"\"\"\n    return _combinations(2 * n, n)"}
{"task_id": "Mbpp/299", "solution": "def max_aggregate(entries: list[tuple[str, int]]) -> tuple[str, int]:\n    \"\"\"\n    Calculates the maximum aggregate score from a list of (name, score) tuples.\n    Returns the name with the highest total score and that score, or ('', 0) if the input is empty.\n    \"\"\"\n    aggregated_scores = {}\n    for name, score in entries:\n        aggregated_scores[name] = aggregated_scores.get(name, 0) + score\n\n    if not aggregated_scores:\n        return ('', 0)\n\n    max_name = ''\n    max_score = -1\n\n    for name, total_score in aggregated_scores.items():\n        if total_score > max_score:\n            max_score = total_score\n            max_name = name\n\n    return (max_name, max_score)"}
{"task_id": "Mbpp/297", "solution": "def flatten_list(input_list: list) -> list:\n    \"\"\"\n    Flattens a nested list structure into a single-level list.\n    The function handles lists nested to any depth and does not modify the input list.\n    \"\"\"\n    flattened_result = []\n    for item in input_list:\n        if isinstance(item, list):\n            flattened_result.extend(flatten_list(item))\n        else:\n            flattened_result.append(item)\n    return flattened_result"}
{"task_id": "Mbpp/301", "solution": "def dict_depth(input_dict: dict) -> int:\n    \"\"\"\n    Calculates the maximum nesting depth of a dictionary.\n    The outermost dictionary is depth 1, and each nested dictionary adds 1 to the depth.\n    \"\"\"\n    max_nested_depth = 0\n    for value in input_dict.values():\n        if isinstance(value, dict):\n            max_nested_depth = max(max_nested_depth, dict_depth(value))\n\n    return 1 + max_nested_depth"}
