{"task_id": "Mbpp/639", "solution": "def sample_nam(name_list: list[str]) -> int:\n    \"\"\"\n    Sums the length of names in the list after filtering for names starting with an uppercase letter.\n    Helper functions _is_uppercase_start and _calculate_name_length are used for filtering and length calculation.\n    \"\"\"\n\n    def _is_uppercase_start(name: str) -> bool:\n        \"\"\"Checks if the first character of a name is an uppercase letter.\"\"\"\n        return len(name) > 0 and name[0].isupper()\n\n    def _calculate_name_length(name: str) -> int:\n        \"\"\"Calculates the character length of a given name.\"\"\"\n        return len(name)\n\n    total_length = 0\n    for name in name_list:\n        if _is_uppercase_start(name):\n            total_length += _calculate_name_length(name)\n    return total_length"}
{"task_id": "Mbpp/644", "solution": "def reverse_Array_Upto_K(array: list, k: int) -> list:\n    \"\"\"\n    Reverses the order of elements in a list from the beginning up to a specified position k.\n    This function creates a new list without modifying the original array.\n    \"\"\"\n    modified_array = list(array)  # Create a mutable copy of the array\n\n    left = 0\n    right = k - 1\n    while left < right:\n        modified_array[left], modified_array[right] = modified_array[right], modified_array[left]\n        left += 1\n        right -= 1\n\n    return modified_array"}
