{"task_id": "Mbpp/730", "solution": "def consecutive_duplicates(input_list: list) -> list:\n    \"\"\"\n    Removes consecutive duplicate elements from a list.\n    Returns a new list with consecutive duplicates removed, preserving order.\n    \"\"\"\n    if not input_list:\n        return []\n\n    result = [input_list[0]]\n    for i in range(1, len(input_list)):\n        if input_list[i] != result[-1]:\n            result.append(input_list[i])\n    return result"}
{"task_id": "Mbpp/731", "solution": "import math\ndef lateralsurface_cone(r, h):\n    \"\"\"\n    Calculates the lateral surface area of a cone.\n    Formula: \u03c0 * r * sqrt(r^2 + h^2)\n    \"\"\"\n    slant_height = math.sqrt(r**2 + h**2)\n    lateral_surface_area = math.pi * r * slant_height\n    return lateral_surface_area"}
{"task_id": "Mbpp/733", "solution": "def find_first_occurrence(array: list[int], target: int) -> int:\n    \"\"\"\n    Finds the index of the first occurrence of a target number in a sorted array using binary search.\n    Returns the index or -1 if the target is not found.\n    \"\"\"\n    low = 0\n    high = len(array) - 1\n    first_occurrence_index = -1\n\n    while low <= high:\n        mid = low + (high - low) // 2\n        if array[mid] == target:\n            first_occurrence_index = mid  # Found a potential first occurrence\n            high = mid - 1  # Try to find an even earlier occurrence in the left half\n        elif array[mid] < target:\n            low = mid + 1  # Target must be in the right half\n        else:  # array[mid] > target\n            high = mid - 1  # Target must be in the left half\n\n    return first_occurrence_index"}
{"task_id": "Mbpp/734", "solution": "def sum_Of_Subarray_Prod(input_list: list) -> int:\n    \"\"\"Calculates the sum of products of all possible contiguous sublists of a given list.\n\n    Args:\n        input_list: A list of integers.\n\n    Returns:\n        The total sum of products of all sublists.\n    \"\"\"\n    total_sum_of_products = 0\n    n = len(input_list)\n\n    for i in range(n):\n        current_product = 1\n        for j in range(i, n):\n            current_product *= input_list[j]\n            total_sum_of_products += current_product\n\n    return total_sum_of_products"}
{"task_id": "Mbpp/736", "solution": "def left_insertion(sorted_list: list[int], value: int) -> int:\n    \"\"\"\n    Locates the lowest index for inserting a value into a sorted list while maintaining order.\n    All elements to the left of the returned index will be less than the value.\n    \"\"\"\n    low = 0\n    high = len(sorted_list)\n\n    while low < high:\n        mid = (low + high) // 2\n        if sorted_list[mid] < value:\n            low = mid + 1\n        else:\n            high = mid\n    return low"}
{"task_id": "Mbpp/737", "solution": "import re\ndef check_str(input_string: str) -> bool:\n    \"\"\"\n    Checks if the given string starts with a vowel (case-insensitive) using regex.\n    Returns False for an empty string.\n    \"\"\"\n    if not input_string:\n        return False\n    vowel_pattern = r\"^[aeiou]\"\n    return bool(re.match(vowel_pattern, input_string, re.IGNORECASE))"}
{"task_id": "Mbpp/739", "solution": "def find_Index(n: int) -> int:\n    \"\"\"\n    Finds the index of the smallest triangular number with `n` digits.\n    Iteratively calculates triangular numbers and checks their digit count.\n    \"\"\"\n    def _calculate_triangular_number(k: int) -> int:\n        \"\"\"Calculates the k-th triangular number.\"\"\"\n        return k * (k + 1) // 2\n\n    def _count_digits(number: int) -> int:\n        \"\"\"Counts the number of digits in a given positive integer.\"\"\"\n        if number == 0: # Though triangular numbers are positive for k > 0\n            return 1\n        import math\n        return int(math.floor(math.log10(number))) + 1\n\n    k = 1\n    while True:\n        triangular_number = _calculate_triangular_number(k)\n        current_digits = _count_digits(triangular_number)\n\n        if current_digits == n:\n            return k\n        \n        # Optimization: If current_digits already exceeds n, and we're looking for the *smallest*,\n        # then we've already passed the range. However, this problem implies we're always\n        # increasing towards n, so a simple loop continues.\n        # The loop condition `current_digits < n` is implicitly handled by the `if` and `k++`\n        \n        k += 1"}
{"task_id": "Mbpp/740", "solution": "def tuple_to_dict(input_tuple: tuple) -> dict:\n    \"\"\"\n    Converts a tuple to a key-value dictionary using adjacent elements.\n    If the tuple has an odd number of elements, the last element is ignored.\n    \"\"\"\n    result_dict = {}\n    for i in range(0, len(input_tuple) - 1, 2):\n        key = input_tuple[i]\n        value = input_tuple[i+1]\n        result_dict[key] = value\n    return result_dict"}
