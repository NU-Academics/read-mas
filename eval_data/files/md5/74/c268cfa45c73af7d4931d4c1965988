{"task_id": "Mbpp/283", "solution": "from collections import Counter\nfrom typing import Dict\ndef validate(integer_value: int) -> bool:\n    \"\"\"\n    Checks whether the frequency of each digit in the integer is less than or equal to the digit itself.\n    Returns True if the validation rule is met, False otherwise.\n    \"\"\"\n\n    def _calculate_digit_frequencies(number: int) -> Dict[int, int]:\n        \"\"\"Calculates the frequency of each digit in a non-negative integer.\"\"\"\n        s_number = str(number)\n        frequencies = Counter(int(d) for d in s_number)\n        return dict(frequencies)\n\n    def _check_frequency_rule(frequencies: Dict[int, int]) -> bool:\n        \"\"\"Checks if for every digit 'd', its frequency 'f' satisfies 'f <= d'.\"\"\"\n        for digit, frequency in frequencies.items():\n            if frequency > digit:\n                return False\n        return True\n\n    if integer_value < 0:\n        return False\n\n    digit_frequencies = _calculate_digit_frequencies(integer_value)\n    return _check_frequency_rule(digit_frequencies)"}
{"task_id": "Mbpp/290", "solution": "def max_length(list_of_lists: list[list[Any]]) -> tuple[int, list[Any]]:\n    \"\"\"\n    Finds the list of maximum length in a list of lists.\n    Returns the maximum length and the corresponding sub-list, or (0, []) if the input is empty.\n    \"\"\"\n    if not list_of_lists:\n        return (0, [])\n\n    max_len = 0\n    max_list = []\n\n    for sub_list in list_of_lists:\n        current_len = len(sub_list)\n        if current_len > max_len:\n            max_len = current_len\n            max_list = sub_list\n    return (max_len, max_list)"}
{"task_id": "Mbpp/286", "solution": "def max_sub_array_sum_repeated(array: list[int], k: int) -> int:\n    \"\"\"\n    Finds the largest sum of a contiguous subarray in an array formed by repeating\n    the given array k times.\n    \"\"\"\n\n    # Helper function to find the maximum contiguous subarray sum in a single array using Kadane's algorithm.\n    def _kadane(arr: list[int]) -> int:\n        if not arr:\n            return 0\n        max_so_far = arr[0]\n        current_max = arr[0]\n        for i in range(1, len(arr)):\n            current_max = max(arr[i], current_max + arr[i])\n            max_so_far = max(max_so_far, current_max)\n        return max_so_far\n\n    # Helper function to calculate the total sum of all elements in an array.\n    def _total_sum(arr: list[int]) -> int:\n        return sum(arr)\n\n    # Helper function to find the maximum sum of any prefix subarray of the given array.\n    def _max_prefix_sum(arr: list[int]) -> int:\n        if not arr:\n            return 0\n        max_sum_val = arr[0]\n        current_sum = arr[0]\n        for i in range(1, len(arr)):\n            current_sum += arr[i]\n            max_sum_val = max(max_sum_val, current_sum)\n        return max_sum_val\n\n    # Helper function to find the maximum sum of any suffix subarray of the given array.\n    def _max_suffix_sum(arr: list[int]) -> int:\n        if not arr:\n            return 0\n        max_sum_val = arr[-1]\n        current_sum = arr[-1]\n        for i in range(len(arr) - 2, -1, -1):\n            current_sum += arr[i]\n            max_sum_val = max(max_sum_val, current_sum)\n        return max_sum_val\n\n    if not array:\n        return 0\n\n    max_sum_single_array = _kadane(array)\n\n    if k == 1:\n        return max_sum_single_array\n    else:\n        sum_of_array = _total_sum(array)\n        max_prefix = _max_prefix_sum(array)\n        max_suffix = _max_suffix_sum(array)\n\n        # The maximum sum could be:\n        # 1. Entirely contained within a single instance of the array (handled by max_sum_single_array).\n        # 2. Spanning across the boundary of two concatenated arrays (max_prefix + max_suffix).\n        # 3. Spanning across multiple arrays, including full arrays in the middle (max_prefix + (k-2)*sum_of_array + max_suffix).\n\n        # Initialize with the max sum found within a single array.\n        overall_max_repeated = max_sum_single_array\n\n        # Consider the sum spanning across two arrays (prefix of first, suffix of second).\n        overall_max_repeated = max(overall_max_repeated, max_prefix + max_suffix)\n\n        # If the total sum of the array is positive, it can contribute to a larger sum\n        # by including full arrays in the middle repetitions.\n        if sum_of_array > 0:\n            overall_max_repeated = max(overall_max_repeated, max_prefix + max_suffix + (k - 2) * sum_of_array)\n        \n        return overall_max_repeated"}
