{"task_id": "Mbpp/256", "solution": "def count_Primes_nums(limit: int) -> int:\n    \"\"\"\n    Calculates the number of prime numbers strictly less than the given non-negative number.\n    This function leverages a helper function `_is_prime` to check primality.\n    \"\"\"\n    def _is_prime(num: int) -> bool:\n        \"\"\"Determines if a given integer is a prime number.\"\"\"\n        if num < 2:\n            return False\n        if num == 2:\n            return True\n        if num % 2 == 0:\n            return False\n        i = 3\n        while i * i <= num:\n            if num % i == 0:\n                return False\n            i += 2\n        return True\n\n    if limit < 0:\n        return 0 # Or handle as per specific design, but the requirement implies non-negative, so 0 is a safe default for invalid input if not strictly raising errors.\n    if limit <= 2:\n        return 0\n\n    prime_count = 0\n    for num in range(2, limit):\n        if _is_prime(num):\n            prime_count += 1\n    return prime_count"}
{"task_id": "Mbpp/261", "solution": "def division_elements(tuple1: tuple, tuple2: tuple) -> tuple:\n    \"\"\"\n    Performs element-wise division of two tuples.\n\n    Raises ValueError if tuples have different lengths or if division by zero occurs.\n    \"\"\"\n    if len(tuple1) != len(tuple2):\n        raise ValueError(\"Input tuples must have the same length.\")\n\n    results = []\n    for i in range(len(tuple1)):\n        if tuple2[i] == 0:\n            raise ValueError(f\"Division by zero at index {i}.\")\n        results.append(tuple1[i] / tuple2[i])\n    return tuple(results)"}
{"task_id": "Mbpp/265", "solution": "def list_split(input_list: list, n: int) -> list:\n    \"\"\"Splits a list into 'n' sublists, placing elements from index `i` into sublist `i % n` while preserving relative order.\"\"\"\n    # Initialize n empty sublists\n    output_lists = [[] for _ in range(n)]\n\n    # Distribute elements based on index modulo n\n    for i, element in enumerate(input_list):\n        target_sublist_index = i % n\n        output_lists[target_sublist_index].append(element)\n\n    return output_lists"}
