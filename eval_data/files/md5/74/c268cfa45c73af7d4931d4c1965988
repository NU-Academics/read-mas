{"task_id": "Mbpp/440", "solution": "import string\nimport re\nfrom typing import Optional, Tuple\nclass Adverb:\n    \"\"\"Data structure to hold the identified adverb's text and positions.\"\"\"\n    def __init__(self, text: str, start_position: int, end_position: int):\n        self.text = text\n        self.start_position = start_position\n        self.end_position = end_position\ndef strip_punctuation(word: str) -> str:\n    \"\"\"Removes leading and trailing punctuation from a given string.\"\"\"\n    return word.strip(string.punctuation)\nclass AdverbDetector:\n    \"\"\"Determines if a given word (cleaned text) is an adverb.\"\"\"\n    _COMMON_ADVERBS = {'very', 'well', 'often', 'fast', 'hard', 'early', 'late', 'just', 'too', 'now', 'then', 'here', 'there', 'always', 'never'}\n\n    @staticmethod\n    def is_adverb(word: str) -> bool:\n        \"\"\"Checks if a word is an adverb based on common patterns and a predefined list.\"\"\"\n        word_lower = word.lower()\n        if word_lower.endswith('ly'):\n            return True\n        return word_lower in AdverbDetector._COMMON_ADVERBS\nclass SentenceProcessor:\n    \"\"\"Tokenizes a sentence, cleans words, and finds the first adverb.\"\"\"\n    def process(self, sentence_string: str) -> Optional[Adverb]:\n        \"\"\"Iterates through words, strips punctuation, and checks if it's an adverb.\"\"\"\n        for match in re.finditer(r'\\S+', sentence_string):\n            original_text = match.group(0)\n            original_start_index = match.start()\n\n            cleaned_text = strip_punctuation(original_text)\n\n            if not cleaned_text:\n                continue\n\n            if AdverbDetector.is_adverb(cleaned_text):\n                adverb_end_position = original_start_index + len(cleaned_text)\n                return Adverb(cleaned_text, original_start_index, adverb_end_position)\n\n        return None\ndef find_adverb_position(sentence_string: str) -> Tuple[int, int, str]:\n    \"\"\"\n    Finds the first adverb and its positions in a given sentence.\n    \"\"\"\n    processor = SentenceProcessor()\n    adverb_found = processor.process(sentence_string)\n\n    if adverb_found:\n        return (adverb_found.start_position, adverb_found.end_position, adverb_found.text)\n    else:\n        return (-1, -1, '')"}
