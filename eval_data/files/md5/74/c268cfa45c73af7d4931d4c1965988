{"task_id": "Mbpp/479", "solution": "def first_Digit(number: int) -> int:\n    \"\"\"\n    Finds the first (leftmost) digit of a given integer.\n    Handles positive, negative numbers and zero by returning the absolute value of the first digit.\n    \"\"\"\n    number = abs(number)\n    while number >= 10:\n        number //= 10\n    return number"}
{"task_id": "Mbpp/554", "solution": "def Split(input_list: list[int]) -> list[int]:\n    \"\"\"\n    Filters a list of integers, returning only the odd ones.\n    Preserves the relative order of the odd integers.\n    \"\"\"\n    odd_numbers = []\n    for number in input_list:\n        if number % 2 != 0:\n            odd_numbers.append(number)\n    return odd_numbers"}
{"task_id": "Mbpp/478", "solution": "def remove_lowercase(input_string: str) -> str:\n    \"\"\"Removes all lowercase characters from the input string, returning a new string with only uppercase characters.\"\"\"\n    uppercase_chars = [char for char in input_string if char.isupper()]\n    return \"\".join(uppercase_chars)"}
{"task_id": "Mbpp/555", "solution": "def difference(n: int) -> int:\n    \"\"\"\n    Calculates the difference between the sum of cubes of the first n natural numbers\n    and the sum of the first n natural numbers.\n    \"\"\"\n    if n <= 0:\n        raise ValueError(\"n must be a natural number (positive integer).\")\n\n    sum_natural_numbers = n * (n + 1) // 2\n    sum_cubes = sum_natural_numbers ** 2\n\n    return sum_cubes - sum_natural_numbers"}
{"task_id": "Mbpp/556", "solution": "def find_Odd_Pair(input_list: list[int], list_size: int) -> int:\n    \"\"\"\n    Calculates the number of unique pairs (i, j) from the input list\n    such that list[i] XOR list[j] is an odd number.\n    \"\"\"\n    if not isinstance(input_list, list):\n        raise TypeError(\"input_list must be a list.\")\n    if not isinstance(list_size, int):\n        raise TypeError(\"list_size must be an integer.\")\n    if list_size < 0:\n        raise ValueError(\"list_size cannot be negative.\")\n    if list_size != len(input_list):\n        raise ValueError(\"list_size must match the actual length of input_list.\")\n\n    odd_count = 0\n    even_count = 0\n\n    for x in input_list:\n        if not isinstance(x, int):\n            raise TypeError(\"All elements in input_list must be integers.\")\n        if x % 2 == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n\n    return odd_count * even_count"}
{"task_id": "Mbpp/558", "solution": "def digit_distance_nums(num1: int, num2: int) -> int:\n    \"\"\"Calculates the sum of the per-digit absolute differences between two integers.\"\"\"\n    str_num1 = str(num1)\n    str_num2 = str(num2)\n\n    max_len = max(len(str_num1), len(str_num2))\n\n    padded_num1 = str_num1.zfill(max_len)\n    padded_num2 = str_num2.zfill(max_len)\n\n    total_sum = 0\n    for i in range(max_len):\n        digit1 = int(padded_num1[i])\n        digit2 = int(padded_num2[i])\n        total_sum += abs(digit1 - digit2)\n\n    return total_sum"}
{"task_id": "Mbpp/562", "solution": "from typing import List, Any\ndef Find_Max_Length(input_list: List[List[Any]]) -> int:\n    \"\"\"\n    Calculates the length of the longest sublist within a list of lists.\n\n    Returns 0 if the input_list is empty or contains only empty sublists.\n    \"\"\"\n    if not input_list:\n        return 0\n\n    max_len = 0\n    for sublist in input_list:\n        if len(sublist) > max_len:\n            max_len = len(sublist)\n    return max_len"}
{"task_id": "Mbpp/559", "solution": "def max_sub_array_sum(numbers: list[int], length: int) -> int:\n    \"\"\"\n    Finds the sum of the largest contiguous sublist using Kadane's algorithm.\n    It iterates through the list, tracking the current maximum sum ending at the current position\n    and the overall maximum sum found so far.\n    \"\"\"\n    if not numbers:\n        return 0  # Or handle as per specific requirement for empty lists, assuming non-empty based on problem context\n\n    max_so_far = numbers[0]\n    current_max = numbers[0]\n\n    for i in range(1, length):\n        current_max = max(numbers[i], current_max + numbers[i])\n        max_so_far = max(max_so_far, current_max)\n\n    return max_so_far"}
{"task_id": "Mbpp/557", "solution": "def toggle_string(input_string: str) -> str:\n    \"\"\"\n    Toggles the case of all alphabetic characters in the input string.\n    Non-alphabetic characters remain unchanged.\n    \"\"\"\n    toggled_chars = []\n    for char in input_string:\n        if 'a' <= char <= 'z':\n            toggled_chars.append(char.upper())\n        elif 'A' <= char <= 'Z':\n            toggled_chars.append(char.lower())\n        else:\n            toggled_chars.append(char)\n    return \"\".join(toggled_chars)"}
{"task_id": "Mbpp/560", "solution": "def union_elements(tuple1: tuple, tuple2: tuple) -> tuple:\n    \"\"\"\n    Computes the unique, sorted union of elements from two input tuples.\n    \"\"\"\n    combined_elements = set(tuple1).union(set(tuple2))\n    sorted_unique_elements = sorted(list(combined_elements))\n    return tuple(sorted_unique_elements)"}
{"task_id": "Mbpp/563", "solution": "def extract_values(input_string: str) -> list[str]:\n    \"\"\"\n    Extracts all substrings enclosed within double quotation marks from the input string.\n    Uses regular expressions to find all non-greedy matches between quotes.\n    \"\"\"\n    import re\n    # The regex r'\"(.*?)\"' looks for text enclosed in double quotes.\n    # The parentheses create a capturing group for the content between the quotes.\n    # The '?' makes the match non-greedy, ensuring it stops at the first closing quote.\n    return re.findall(r'\"(.*?)\"', input_string)"}
{"task_id": "Mbpp/566", "solution": "def sum_digits(number: int) -> int:\n    \"\"\"\n    Calculates the sum of the digits of a non-negative integer.\n    Raises ValueError if the input number is negative.\n    \"\"\"\n    if number < 0:\n        raise ValueError(\"Input must be a non-negative integer.\")\n    \n    if number == 0:\n        return 0\n        \n    digit_sum = 0\n    num_str = str(number)\n    for digit_char in num_str:\n        digit_sum += int(digit_char)\n    return digit_sum"}
