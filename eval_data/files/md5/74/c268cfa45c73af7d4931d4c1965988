{"task_id": "Mbpp/749", "solution": "def sort_numeric_strings(numeric_strings: list[str]) -> list[int]:\n    \"\"\"\n    Sorts a given list of strings of numbers numerically in ascending order.\n    Converts strings to integers, sorts them, and returns the sorted integers.\n    \"\"\"\n\n    class NumericString:\n        def __init__(self, value: str):\n            self._value = value\n\n        def to_integer(self) -> int:\n            return int(self._value)\n\n    class IntegerList:\n        def __init__(self):\n            self._elements: list[int] = []\n\n        def add(self, integer: int):\n            self._elements.append(integer)\n\n        def sort_ascending(self):\n            self._elements.sort()\n\n        def get_elements(self) -> list[int]:\n            return list(self._elements)\n\n    integer_list = IntegerList()\n    for s in numeric_strings:\n        numeric_str_obj = NumericString(s)\n        integer_list.add(numeric_str_obj.to_integer())\n\n    integer_list.sort_ascending()\n    return integer_list.get_elements()"}
{"task_id": "Mbpp/751", "solution": "def check_min_heap(array: list) -> bool:\n    \"\"\"\n    Checks if the given array represents a min-heap.\n    Returns True if the array satisfies the min-heap property, False otherwise.\n    \"\"\"\n    n = len(array)\n    if n <= 1:\n        return True\n\n    for i in range(n // 2):\n        left_child_idx = 2 * i + 1\n        right_child_idx = 2 * i + 2\n\n        if left_child_idx < n and array[i] > array[left_child_idx]:\n            return False\n\n        if right_child_idx < n and array[i] > array[right_child_idx]:\n            return False\n    return True"}
{"task_id": "Mbpp/753", "solution": "def min_k(tuple_list: list[tuple[str, int]], k: int) -> list[tuple[str, int]]:\n    \"\"\"\n    Sorts a list of tuples by their integer value and returns the first k elements.\n    If k is larger than the list size, all sorted elements are returned.\n    \"\"\"\n    sorted_list = sorted(tuple_list, key=lambda x: x[1])\n    return sorted_list[:k]"}
{"task_id": "Mbpp/754", "solution": "def extract_index_list(list1: list, list2: list, list3: list) -> list:\n    \"\"\"\n    Finds elements that are common across three lists at the same index.\n    Returns a list of these common elements.\n    \"\"\"\n    common_elements = []\n    min_length = min(len(list1), len(list2), len(list3))\n\n    for i in range(min_length):\n        if list1[i] == list2[i] and list2[i] == list3[i]:\n            common_elements.append(list1[i])\n\n    return common_elements"}
{"task_id": "Mbpp/752", "solution": "def jacobsthal_num(n: int) -> int:\n    \"\"\"\n    Calculates the nth Jacobsthal number using an iterative approach.\n    \"\"\"\n    if n == 0:\n        return 0\n    if n == 1:\n        return 1\n\n    # J(n) = J(n-1) + 2 * J(n-2)\n    a, b = 0, 1 # Represents J(0) and J(1) initially\n    for _ in range(2, n + 1):\n        a, b = b, a + 2 * b\n    return b"}
{"task_id": "Mbpp/759", "solution": "def is_decimal(input_string: str) -> bool:\n    \"\"\"\n    Checks if the given string is a decimal number with a precision of 2.\n    It supports optional signs, one or more digits before the decimal, and exactly two digits after the decimal point if present.\n    \"\"\"\n    import re\n    # Pattern explanation:\n    # ^[+-]?\\d+ matches optional sign, then one or more digits.\n    # (?:\\.\\d{2})? matches an optional non-capturing group for the decimal part with exactly two digits.\n    # $ anchors the match to the end of the string.\n    pattern = r\"^[+-]?\\d+(?:\\.\\d{2})?$\"\n    return bool(re.fullmatch(pattern, input_string))"}
{"task_id": "Mbpp/755", "solution": "def second_smallest(numbers: list) -> int | float:\n    \"\"\"\n    Finds the second smallest unique number in a list of numbers.\n    The function assumes the input list contains at least two unique numbers.\n    \"\"\"\n    unique_numbers = sorted(list(set(numbers)))\n    return unique_numbers[1]"}
{"task_id": "Mbpp/757", "solution": "import collections\ndef _get_reverse_string(s: str) -> str:\n    \"\"\"\n    Returns the case-sensitive reverse of the input string.\n    \"\"\"\n    return s[::-1]\ndef count_reverse_pairs(string_list: list[str]) -> int:\n    \"\"\"\n    Counts unique reverse string pairs in the given list of strings.\n    A pair (s1, s2) is a reverse pair if s1 is the exact case-sensitive reverse of s2, and each string can be part of at most one pair.\n    \"\"\"\n    counts = collections.Counter(string_list)\n    pair_count = 0\n\n    # Iterate over a copy of the unique keys to ensure each string is considered once\n    # as a potential starting point for a pair, avoiding issues with modifying counts\n    # during iteration or re-processing strings already used in a pair.\n    for s in list(counts.keys()):\n        if counts[s] == 0:\n            continue\n\n        reversed_s = _get_reverse_string(s)\n\n        if s == reversed_s: # Palindrome case\n            # To form a pair, we need at least two instances of the palindrome.\n            if counts[s] >= 2:\n                pair_count += 1\n                counts[s] -= 2 # Use up two instances\n        else: # Non-palindrome case (e.g., \"best\" and \"tseb\")\n            # We need 's' and its reverse 'reversed_s' to both be available.\n            if counts[reversed_s] > 0:\n                pair_count += 1\n                counts[s] -= 1          # Use up one instance of 's'\n                counts[reversed_s] -= 1 # Use up one instance of 'reversed_s'\n    \n    return pair_count"}
{"task_id": "Mbpp/758", "solution": "def unique_sublists(input_list):\n    \"\"\"\n    Counts lists within a list, converting each sublist to a tuple and returning\n    a dictionary of tuple occurrences.\n    \"\"\"\n    counts_map = {}\n    for sublist in input_list:\n        # Convert the sublist to an immutable tuple to use as a dictionary key\n        tuple_representation = tuple(sublist)\n        # Increment the count for this tuple, initializing to 1 if not present\n        counts_map[tuple_representation] = counts_map.get(tuple_representation, 0) + 1\n    return counts_map"}
{"task_id": "Mbpp/760", "solution": "def unique_Element(numbers_list: list) -> bool:\n    \"\"\"\n    Checks if a list of numbers contains zero or one distinct element.\n    Returns True if the list is empty or contains only one distinct element, False otherwise.\n    \"\"\"\n    distinct_elements = set(numbers_list)\n    return len(distinct_elements) <= 1"}
{"task_id": "Mbpp/764", "solution": "def number_ctr(input_string: str) -> int:\n    \"\"\"Counts the number of numeric digits (0-9) in the given input string.\n    If the input is not a string, it's treated as an empty string.\"\"\"\n    if not isinstance(input_string, str):\n        input_string = \"\"\n    \n    digit_count = 0\n    for char in input_string:\n        if char.isdigit():\n            digit_count += 1\n    return digit_count"}
{"task_id": "Mbpp/762", "solution": "class Month:\n    \"\"\"Encapsulates a month number and provides the logic to determine if it has 30 days.\"\"\"\n    def __init__(self, month_number: int):\n        self._number = month_number\n\n    def has30Days(self) -> bool:\n        \"\"\"Determines if the month has 30 days.\"\"\"\n        return self._number in [4, 6, 9, 11]\ndef check_monthnumber_number(month_number: int) -> bool:\n    \"\"\"Checks whether the given month number contains 30 days.\"\"\"\n    month = Month(month_number)\n    return month.has30Days()"}
{"task_id": "Mbpp/763", "solution": "from typing import Union, Tuple, List\ndef find_min_diff(collection: Union[List[int], List[float], Tuple[int, ...], Tuple[float, ...]], size: int) -> int:\n    \"\"\"\n    Calculates the minimum absolute difference between any two distinct elements\n    in a given array or tuple. Returns -1 if the collection has fewer than two elements.\n    \"\"\"\n    if size < 2:\n        return -1\n\n    sorted_collection = sorted(collection)\n    min_diff = float('inf')\n\n    for i in range(size - 1):\n        current_diff = abs(sorted_collection[i] - sorted_collection[i+1])\n        if current_diff < min_diff:\n            min_diff = current_diff\n\n    return int(min_diff)"}
{"task_id": "Mbpp/765", "solution": "def find_nth_polite_number(n: int) -> int:\n    \"\"\"\n    Finds the nth polite number.\n    A polite number is a positive integer that is not a power of 2.\n    \"\"\"\n    if n <= 0:\n        # Based on the design context, input validation for n is expected\n        # in the 'main.py' at the application layer.\n        # This function assumes valid 'n' as per the design's internal API.\n        pass\n\n    def is_power_of_two(num: int) -> bool:\n        \"\"\"\n        Checks if a number is a power of two.\n        This is a helper function used internally.\n        \"\"\"\n        if num <= 0:\n            return False\n        return (num & (num - 1)) == 0\n\n    count = 0\n    num = 1\n    while True:\n        if not is_power_of_two(num):\n            count += 1\n            if count == n:\n                return num\n        num += 1"}
{"task_id": "Mbpp/766", "solution": "def pair_wise(input_list: list) -> list[tuple]:\n    \"\"\"\n    Returns a list of all pairs of consecutive items in a given list.\n    Returns an empty list if the input_list has fewer than two elements.\n    \"\"\"\n    if len(input_list) < 2:\n        return []\n\n    result = []\n    for i in range(len(input_list) - 1):\n        result.append((input_list[i], input_list[i+1]))\n    return result"}
{"task_id": "Mbpp/771", "solution": "def check_expression(input_string: str) -> bool:\n    \"\"\"\n    Checks if the given expression string has balanced opening and closing\n    parentheses, square brackets, and curly braces.\n    \"\"\"\n    OPENING_BRACKETS = {'(', '[', '{'}\n    CLOSING_BRACKETS = {')', ']', '}'}\n    BRACKET_PAIRS = {\n        ')': '(',\n        ']': '[',\n        '}': '{'\n    }\n\n    stack = []\n\n    for char in input_string:\n        if char in OPENING_BRACKETS:\n            stack.append(char)\n        elif char in CLOSING_BRACKETS:\n            if not stack:\n                return False\n            last_opening_bracket = stack.pop()\n            if BRACKET_PAIRS[char] != last_opening_bracket:\n                return False\n\n    return not stack"}
{"task_id": "Mbpp/770", "solution": "class NaturalNumber:\n    \"\"\"\n    Represents a natural number and provides methods to check if it's odd and calculate its fourth power.\n    \"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def is_odd(self) -> bool:\n        \"\"\"Checks if the number is odd.\"\"\"\n        return self.value % 2 != 0\n\n    def get_fourth_power(self) -> int:\n        \"\"\"Computes and returns the fourth power of the number.\"\"\"\n        return self.value ** 4\ndef odd_num_sum(n: int) -> int:\n    \"\"\"\n    Calculates the sum of the fourth powers of the first 'n' odd natural numbers.\n    \"\"\"\n    total_sum = 0\n    odd_numbers_found_count = 0\n    current_num = 1\n\n    while odd_numbers_found_count < n:\n        num_obj = NaturalNumber(current_num)\n        if num_obj.is_odd():\n            total_sum += num_obj.get_fourth_power()\n            odd_numbers_found_count += 1\n        current_num += 1\n    return total_sum"}
{"task_id": "Mbpp/767", "solution": "from typing import List, Union\ndef get_pairs_count(numbers: List[Union[int, float]], target_sum: Union[int, float]) -> int:\n    \"\"\"\n    Counts the number of unique pairs (i, j) from the input list, where i < j,\n    such that numbers[i] + numbers[j] equals the provided target sum.\n    \"\"\"\n    pair_count = 0\n    n = len(numbers)\n\n    for i in range(n):\n        for j in range(i + 1, n):\n            if numbers[i] + numbers[j] == target_sum:\n                pair_count += 1\n    return pair_count"}
{"task_id": "Mbpp/769", "solution": "def Diff(list1: list, list2: list) -> list:\n    \"\"\"\n    Calculates the difference between two lists, returning elements present in list1\n    but not in list2, while preserving their original relative order.\n    \"\"\"\n    set_from_list2 = set(list2)\n    result_list = []\n    for element in list1:\n        if element not in set_from_list2:\n            result_list.append(element)\n    return result_list"}
{"task_id": "Mbpp/772", "solution": "def remove_length(text: str, k: int) -> str:\n    \"\"\"Removes all words of a specified length k from an input string, preserving order.\"\"\"\n    words = text.split()\n    retained_words = [word for word in words if len(word) != k]\n    return ' '.join(retained_words)"}
{"task_id": "Mbpp/775", "solution": "def odd_position(input_list: list) -> bool:\n    \"\"\"\n    Checks if every element at an odd 0-based index in the list is an odd number.\n    Returns True if the condition holds for all odd indices, False otherwise.\n    \"\"\"\n    for i in range(len(input_list)):\n        # Check if the current index is odd.\n        if i % 2 != 0:\n            # If the index is odd, check if the number at this index is even.\n            if input_list[i] % 2 == 0:\n                return False\n    return True"}
{"task_id": "Mbpp/773", "solution": "def occurance_substring(main_string: str, substring: str) -> tuple[str, int, int] | None:\n    \"\"\"\n    Finds the first non-overlapping occurrence of a substring within a main string.\n    Returns (matched_substring, start_index, end_index) or None if no match.\n    \"\"\"\n    try:\n        start_index = main_string.index(substring)\n        end_index = start_index + len(substring)\n        return (substring, start_index, end_index)\n    except ValueError:\n        return None"}
{"task_id": "Mbpp/777", "solution": "def find_sum(numbers: list[int]) -> int:\n    \"\"\"Calculates the sum of non-repeated elements in a given list.\n\n    It counts element occurrences, identifies those with a count of 1, and sums them.\n    \"\"\"\n    counts = {}\n    for num in numbers:\n        counts[num] = counts.get(num, 0) + 1\n\n    total_sum = 0\n    for num, count in counts.items():\n        if count == 1:\n            total_sum += num\n            \n    return total_sum"}
{"task_id": "Mbpp/782", "solution": "def odd_length_sum(arr: list[int]) -> int:\n    \"\"\"\n    Calculates the total sum of all odd-length subarrays within the input array.\n    Iterates through all possible subarrays, sums elements of odd-length ones, and aggregates the sums.\n    \"\"\"\n    total_sum = 0\n    n = len(arr)\n\n    # Iterate through all possible starting indices\n    for i in range(n):\n        # Iterate through all possible ending indices from the current start\n        for j in range(i, n):\n            # Extract the current subarray\n            subarray = arr[i : j + 1]\n            \n            # Check if the subarray length is odd\n            if len(subarray) % 2 == 1:\n                # Add the sum of elements of the odd-length subarray to the total\n                total_sum += sum(subarray)\n    \n    return total_sum"}
{"task_id": "Mbpp/778", "solution": "def pack_consecutive_duplicates(input_list: list) -> list:\n    \"\"\"Packs consecutive duplicates of list elements into sublists.\n\n    Groups consecutive identical elements from an input list into sublists.\n    \"\"\"\n    if not input_list:\n        return []\n\n    packed_list = []\n    current_sublist = [input_list[0]]\n\n    for i in range(1, len(input_list)):\n        if input_list[i] == current_sublist[0]:\n            current_sublist.append(input_list[i])\n        else:\n            packed_list.append(current_sublist)\n            current_sublist = [input_list[i]]\n\n    packed_list.append(current_sublist)  # Append the last sublist\n    return packed_list"}
{"task_id": "Mbpp/780", "solution": "def find_combinations(tuple_list: list[tuple[int | float, int | float]]) -> list[tuple[int | float, int | float]]:\n    \"\"\"\n    Finds all unique combinations of two tuples from the given list and returns their element-wise sums.\n    \"\"\"\n    import itertools\n\n    if len(tuple_list) < 2:\n        return []\n\n    result_sums = []\n    for t1, t2 in itertools.combinations(tuple_list, 2):\n        sum_tuple = (t1[0] + t2[0], t1[1] + t2[1])\n        result_sums.append(sum_tuple)\n    return result_sums"}
{"task_id": "Mbpp/781", "solution": "def count_divisors_is_even(n: int) -> bool:\n    \"\"\"\n    Checks if the count of positive divisors for a given positive integer is even.\n\n    Returns True if the count of positive divisors for n is even, False otherwise.\n    \"\"\"\n    count = 0\n    # Iterate up to the square root of n to find divisors efficiently.\n    limit = int(n**0.5)\n\n    for i in range(1, limit + 1):\n        if n % i == 0:\n            if i * i == n:\n                # If i is the square root, it's a single divisor.\n                count += 1\n            else:\n                # i and n/i are two distinct divisors.\n                count += 2\n    \n    return count % 2 == 0"}
{"task_id": "Mbpp/786", "solution": "def right_insertion(sorted_list: list[float | int], value: float | int) -> int:\n    \"\"\"\n    Locates the right insertion point for a specified value in a sorted list.\n    Uses binary search to find the index where 'value' should be inserted.\n    \"\"\"\n    low = 0\n    high = len(sorted_list)\n\n    while low < high:\n        mid = (low + high) // 2\n        if sorted_list[mid] <= value:\n            low = mid + 1\n        else:\n            high = mid\n    return low"}
{"task_id": "Mbpp/784", "solution": "def mul_even_odd(numbers: list[int]) -> int | None:\n    \"\"\"\n    Finds the product of the first even and first odd number in a list.\n    Returns None if either number is not found.\n    \"\"\"\n    first_even = None\n    first_odd = None\n\n    for num in numbers:\n        if first_odd is None and num % 2 != 0:\n            first_odd = num\n        if first_even is None and num % 2 == 0:\n            first_even = num\n        \n        # Optimization: If both are found, no need to continue iterating\n        if first_even is not None and first_odd is not None:\n            break\n            \n    if first_even is not None and first_odd is not None:\n        return first_even * first_odd\n    else:\n        return None"}
{"task_id": "Mbpp/785", "solution": "def tuple_str_int(tuple_string: str) -> tuple[int, ...]:\n    \"\"\"\n    Converts a string representation of a tuple into an actual tuple containing integer elements.\n    It extracts the content, delegates parsing and conversion, and returns an integer tuple.\n    \"\"\"\n    if not tuple_string.startswith('(') or not tuple_string.endswith(')'):\n        # Basic validation for enclosing parentheses, though more robust checks might be needed for real-world scenarios.\n        return ()\n\n    # Extract the inner content, removing leading/trailing parentheses and stripping whitespace.\n    elements_str = tuple_string[1:-1].strip()\n\n    def _parse_and_convert_elements(elements_str: str) -> tuple[int, ...]:\n        \"\"\"\n        Helper function to extract individual string elements from a comma-separated string and convert each to an integer.\n        \"\"\"\n        if not elements_str:\n            return ()\n        \n        # Split by comma, strip whitespace from each part, and convert to int.\n        elements = [int(s.strip()) for s in elements_str.split(',')]\n        return tuple(elements)\n\n    return _parse_and_convert_elements(elements_str)"}
{"task_id": "Mbpp/790", "solution": "def even_position(input_list):\n    \"\"\"\n    Checks if every even index in a list contains an even number.\n    Returns True if the condition holds for all even indices, False otherwise.\n    \"\"\"\n    def _is_even_index(index):\n        \"\"\"Determines if a given integer index is even.\"\"\"\n        return index % 2 == 0\n\n    def _is_even_number(number):\n        \"\"\"Determines if a given integer number is even.\"\"\"\n        return number % 2 == 0\n\n    for i in range(len(input_list)):\n        if _is_even_index(i):\n            if not _is_even_number(input_list[i]):\n                return False\n    return True"}
