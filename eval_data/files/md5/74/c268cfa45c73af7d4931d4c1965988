{"task_id": "Mbpp/724", "solution": "def power_base_sum(base: int, power: int) -> int:\n    \"\"\"\n    Calculates the sum of all digits of the base to the specified power.\n    \"\"\"\n    if base < 0 or power < 0:\n        raise ValueError(\"Base and power must be non-negative integers.\")\n\n    if power == 0:\n        return 1\n    if base == 0:\n        return 0\n\n    large_number = base ** power\n    sum_of_digits = sum(int(digit) for digit in str(large_number))\n\n    return sum_of_digits"}
{"task_id": "Mbpp/721", "solution": "from typing import List\nclass Cell:\n    \"\"\"Represents a single cell within the matrix, holding its coordinates and cost.\"\"\"\n    def __init__(self, row: int, col: int, cost: int):\n        self.row = row\n        self.col = col\n        self.cost = cost\nclass Matrix:\n    \"\"\"Encapsulates the input square matrix data and provides safe access to individual cells.\"\"\"\n    def __init__(self, cells_data: List[List[int]]):\n        self._cells_data = cells_data\n        self._N = len(cells_data)\n\n    def get_cell(self, row: int, col: int) -> Cell:\n        \"\"\"Retrieves a Cell object at the given row and column.\"\"\"\n        return Cell(row, col, self._cells_data[row][col])\n\n    @property\n    def N(self) -> int:\n        \"\"\"Returns the size of the square matrix.\"\"\"\n        return self._N\nclass PathFinder:\n    \"\"\"Orchestrates the process of identifying all valid paths, calculating their average costs, and determining the maximum average among them.\"\"\"\n    def __init__(self):\n        pass\n\n    def find_max_average_path(self, matrix_data: List[List[int]]) -> float:\n        \"\"\"\n        Finds the path with the maximum average cost in a square matrix.\n        A path starts from the top-left cell, moves only right or down,\n        and ends on the bottom-right cell.\n        \"\"\"\n        matrix_obj = Matrix(matrix_data)\n        max_avg_ref = [-float('inf')] # Use a list to pass the maximum average by reference.\n\n        start_cell = matrix_obj.get_cell(0, 0)\n\n        # The recursive helper will accumulate current total cost and number of cells.\n        self._find_paths_recursive(\n            0, 0,  # current_row, current_col\n            start_cell.cost,  # current_total_cost\n            1,  # current_number_of_cells (starting cell itself)\n            matrix_obj,\n            max_avg_ref\n        )\n\n        return max_avg_ref[0]\n\n    def _find_paths_recursive(self, current_row: int, current_col: int,\n                              current_total_cost: int, current_number_of_cells: int,\n                              matrix: Matrix,\n                              max_avg_ref: List[float]) -> None:\n        \"\"\"Recursively explores paths to find the maximum average.\"\"\"\n        # Base case: Reached the bottom-right cell.\n        if current_row == matrix.N - 1 and current_col == matrix.N - 1:\n            current_avg = current_total_cost / current_number_of_cells\n            if current_avg > max_avg_ref[0]:\n                max_avg_ref[0] = current_avg\n            return\n\n        # Explore moving right\n        if current_col + 1 < matrix.N:\n            next_cell = matrix.get_cell(current_row, current_col + 1)\n            self._find_paths_recursive(\n                current_row, current_col + 1,\n                current_total_cost + next_cell.cost,\n                current_number_of_cells + 1,\n                matrix,\n                max_avg_ref\n            )\n\n        # Explore moving down\n        if current_row + 1 < matrix.N:\n            next_cell = matrix.get_cell(current_row + 1, current_col)\n            self._find_paths_recursive(\n                current_row + 1, current_col,\n                current_total_cost + next_cell.cost,\n                current_number_of_cells + 1,\n                matrix,\n                max_avg_ref\n            )\ndef maxAverageOfPath(matrix: List[List[int]]) -> float:\n    \"\"\"\n    Finds the path with the maximum average cost in a square matrix.\n    A path starts from the top-left cell, moves only right or down,\n    and ends on the bottom-right cell.\n    \"\"\"\n    path_finder = PathFinder()\n    return path_finder.find_max_average_path(matrix)"}
{"task_id": "Mbpp/728", "solution": "def sum_list(list_A, list_B):\n    \"\"\"Calculates the element-wise sum of two lists of equal length.\n    Returns a new list containing these sums.\n    \"\"\"\n    result = []\n    for a, b in zip(list_A, list_B):\n        result.append(a + b)\n    return result"}
{"task_id": "Mbpp/723", "solution": "def count_same_pair(list1: list, list2: list) -> int:\n    \"\"\"\n    Counts the number of indices where two input lists have identical values.\n    Raises ValueError if the input lists are not of equal length.\n    \"\"\"\n    if len(list1) != len(list2):\n        raise ValueError(\"Input lists must be of equal length.\")\n\n    count = 0\n    for i in range(len(list1)):\n        if list1[i] == list2[i]:\n            count += 1\n\n    return count"}
{"task_id": "Mbpp/726", "solution": "def multiply_elements(t: tuple) -> tuple:\n    \"\"\"\n    Calculates the product of adjacent elements in a tuple.\n\n    Returns:\n        A new tuple where the i-th element is the product of t[i] and t[i+1].\n    \"\"\"\n    if len(t) < 2:\n        return ()\n    return tuple(t[i] * t[i+1] for i in range(len(t) - 1))"}
