{"task_id": "Mbpp/448", "solution": "_perrin_cache = {0: 3, 1: 0, 2: 2}\ndef _calculate_perrin_number(n: int) -> int:\n    \"\"\"Computes the nth Perrin number using memoization based on P(n) = P(n-2) + P(n-3).\"\"\"\n    if n in _perrin_cache:\n        return _perrin_cache[n]\n\n    result = _calculate_perrin_number(n - 2) + _calculate_perrin_number(n - 3)\n    _perrin_cache[n] = result\n    return result\ndef cal_sum(n: int) -> int:\n    \"\"\"Calculates the sum of Perrin numbers from P(0) up to P(n).\"\"\"\n    total_sum = 0\n    for i in range(n + 1):\n        total_sum += _calculate_perrin_number(i)\n    return total_sum"}
