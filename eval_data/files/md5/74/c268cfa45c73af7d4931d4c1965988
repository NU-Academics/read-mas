{"task_id": "Mbpp/109", "solution": "def odd_Equivalent(binary_string: str, num_rotations: int) -> int:\n    \"\"\"\n    Calculates the number of odd decimal values obtained by rotating a binary string.\n    \"\"\"\n    def _rotate_string(s: str) -> str:\n        \"\"\"Performs a single left rotation on the input string.\"\"\"\n        return s[1:] + s[0]\n\n    def _binary_to_decimal(binary_str: str) -> int:\n        \"\"\"Converts a binary string to its decimal integer equivalent.\"\"\"\n        return int(binary_str, 2)\n\n    def _is_odd(n: int) -> bool:\n        \"\"\"Determines if an integer is odd.\"\"\"\n        return n % 2 != 0\n\n    odd_count = 0\n    current_binary_string = binary_string\n\n    for _ in range(num_rotations):\n        decimal_value = _binary_to_decimal(current_binary_string)\n        if _is_odd(decimal_value):\n            odd_count += 1\n        current_binary_string = _rotate_string(current_binary_string)\n\n    return odd_count"}
{"task_id": "Mbpp/111", "solution": "def common_in_nested_lists(nested_lists: list[list]) -> set:\n    \"\"\"\n    Finds common elements in a given list of nested lists.\n    Returns a set containing elements present in every sub-list.\n    \"\"\"\n    if not nested_lists:\n        return set()\n\n    common_elements = set(nested_lists[0])\n\n    for sub_list in nested_lists[1:]:\n        if not common_elements:\n            break\n        common_elements.intersection_update(set(sub_list))\n\n    return common_elements"}
