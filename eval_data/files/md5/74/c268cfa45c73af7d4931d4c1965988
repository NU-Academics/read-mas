{"task_id": "Mbpp/171", "solution": "def perimeter_pentagon(side_length):\n    \"\"\"\n    Calculates the perimeter of a regular pentagon given its side length.\n    \"\"\"\n    class RegularPentagon:\n        def __init__(self, side_length):\n            self._side_length = side_length\n\n        def calculate_perimeter(self):\n            return self._side_length * 5\n\n    pentagon = RegularPentagon(side_length)\n    return pentagon.calculate_perimeter()"}
{"task_id": "Mbpp/166", "solution": "def find_even_pair(integer_list: list[int]) -> int:\n    \"\"\"\n    Counts the number of pairs of integers in a list that XOR to an even number.\n    The XOR sum of two integers is even if and only if both integers have the same parity.\n    \"\"\"\n    even_count = 0\n    odd_count = 0\n\n    for number in integer_list:\n        if number % 2 == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n\n    # Calculate pairs using the combination formula nC2 = n * (n - 1) // 2\n    even_pairs = even_count * (even_count - 1) // 2\n    odd_pairs = odd_count * (odd_count - 1) // 2\n\n    return even_pairs + odd_pairs"}
{"task_id": "Mbpp/170", "solution": "def sum_range_list(numbers: list[int], start_index: int, end_index: int) -> int:\n    \"\"\"Calculates the sum of numbers in a list within a specified 0-based index range, inclusive.\n    Returns 0 for empty lists, out-of-bounds indices, or an inverted range.\"\"\"\n\n    list_len = len(numbers)\n\n    # Validate inputs: empty list, out-of-bounds indices, or inverted range\n    if not numbers or start_index < 0 or end_index >= list_len or start_index > end_index:\n        return 0\n    \n    # Check if the start_index itself is out of bounds (e.g., list is [1,2], start=2, end=1)\n    if start_index >= list_len or end_index < 0:\n        return 0\n\n    total_sum = 0\n    for i in range(start_index, end_index + 1):\n        total_sum += numbers[i]\n\n    return total_sum"}
{"task_id": "Mbpp/172", "solution": "def count_occurance(input_string: str) -> int:\n    \"\"\"\n    Counts non-overlapping, case-sensitive occurrences of 'std' in input_string.\n    \"\"\"\n    target_substring = 'std'\n    count = 0\n    start_index = 0\n    while True:\n        index = input_string.find(target_substring, start_index)\n        if index == -1:\n            break\n        count += 1\n        start_index = index + len(target_substring)\n    return count"}
