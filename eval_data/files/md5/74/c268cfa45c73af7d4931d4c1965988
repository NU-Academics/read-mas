{"task_id": "Mbpp/162", "solution": "def sum_series(n: int) -> int:\n    \"\"\"Calculates the sum of the series (n - 2*i) for i from 0 to n // 2.\n\n    Args:\n        n (int): The integer argument for the series calculation.\n\n    Returns:\n        int: The calculated sum of the series.\n    \"\"\"\n    total_sum = 0\n    for i in range((n // 2) + 1):\n        term = n - (2 * i)\n        total_sum += term\n    return total_sum"}
{"task_id": "Mbpp/167", "solution": "def next_power_of_2(n: int) -> int:\n    \"\"\"Finds the smallest power of 2 greater than or equal to n.\n    This function handles n=0 by returning 1.\"\"\"\n    power = 1\n    while power < n:\n        power *= 2\n    return power"}
{"task_id": "Mbpp/165", "solution": "def count_char_position(input_string: str) -> int:\n    \"\"\"\n    Counts characters in the input string that occur at the same position in the string\n    as in the English alphabet (case insensitive).\n    \"\"\"\n    count = 0\n    for index, char in enumerate(input_string):\n        lower_char = char.lower()\n        if 'a' <= lower_char <= 'z':\n            alphabetical_position = ord(lower_char) - ord('a') + 1\n            string_position = index + 1\n            if alphabetical_position == string_position:\n                count += 1\n    return count"}
