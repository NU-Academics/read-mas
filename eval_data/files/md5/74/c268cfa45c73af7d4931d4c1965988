{"task_id": "Mbpp/224", "solution": "def count_Set_Bits(number: int) -> int:\n    \"\"\"Counts the number of set bits (1s) in the binary representation of an integer.\n    This implementation uses Brian Kernighan's algorithm and handles negative inputs by taking their absolute value.\n    \"\"\"\n    number = abs(number)\n    count = 0\n    while number > 0:\n        number &= (number - 1)  # Unsets the least significant set bit\n        count += 1\n    return count"}
{"task_id": "Mbpp/223", "solution": "def _find_first_occurrence(array: list[int], n: int, element: int) -> int:\n    \"\"\"Finds the index of the first occurrence of the element using binary search.\n    Returns -1 if the element is not found.\"\"\"\n    low = 0\n    high = n - 1\n    first_index = -1\n\n    while low <= high:\n        mid = low + (high - low) // 2\n        if array[mid] == element:\n            first_index = mid\n            high = mid - 1\n        elif array[mid] < element:\n            low = mid + 1\n        else:\n            high = mid - 1\n    return first_index\ndef _find_last_occurrence(array: list[int], n: int, element: int) -> int:\n    \"\"\"Finds the index of the last occurrence of the element using binary search.\n    Returns -1 if the element is not found.\"\"\"\n    low = 0\n    high = n - 1\n    last_index = -1\n\n    while low <= high:\n        mid = low + (high - low) // 2\n        if array[mid] == element:\n            last_index = mid\n            low = mid + 1\n        elif array[mid] < element:\n            low = mid + 1\n        else:\n            high = mid - 1\n    return last_index\ndef is_majority(array: list[int], n: int, element: int) -> bool:\n    \"\"\"\n    Checks if an element is the majority element in a sorted array.\n    The majority element occurs more than n/2 times.\n    \"\"\"\n    first_index = _find_first_occurrence(array, n, element)\n    if first_index == -1:\n        return False\n\n    last_index = _find_last_occurrence(array, n, element)\n    count = last_index - first_index + 1\n\n    return count > (n / 2)"}
