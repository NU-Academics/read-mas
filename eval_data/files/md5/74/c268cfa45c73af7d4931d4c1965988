{"task_id": "Mbpp/93", "solution": "def power(base: float, exponent: float) -> float:\n    \"\"\"\n    Calculates the value of 'base' raised to the power of 'exponent' based on specified business rules.\n    Raises ValueError for undefined cases like 0^0 or negative/fractional exponents.\n    \"\"\"\n    if exponent == 0:\n        if base == 0:\n            raise ValueError(\"power(0,0) is undefined in current scope\")\n        return 1.0\n\n    if base == 0:\n        # If base is 0, and exponent is positive, the result is 0 (BR4).\n        # Negative exponents for base 0 would be caught by the general exponent check below.\n        if exponent > 0:\n            return 0.0\n\n    # Raise ValueError for exponents outside the current scope (negative or fractional).\n    if exponent < 0 or exponent != int(exponent):\n        raise ValueError(\"Negative or fractional exponents are undefined in current scope\")\n\n    # Perform iterative multiplication for positive integer exponents (BR2).\n    result = 1.0\n    for _ in range(int(exponent)):\n        result *= base\n    return result"}
{"task_id": "Mbpp/92", "solution": "def is_undulating(number: int) -> bool:\n    \"\"\"Checks if the given number is undulating based on digit patterns.\n    An undulating number has alternating digits where d_i != d_{i+1} and d_i == d_{i+2}.\n    \"\"\"\n    s_number = str(number)\n    n = len(s_number)\n\n    if n < 3:\n        # Numbers with fewer than 3 digits cannot satisfy d_i == d_{i+2} unless n=0,1,2 which cannot be undulating.\n        # The design context explicitly states \"Numbers with fewer than two digits are explicitly defined as non-undulating.\"\n        # However, to meet d_i == d_{i+2}, we need at least 3 digits.\n        # For example, 12 is not undulating (no d_i == d_{i+2}). 121 is.\n        # Let's consider the strictest interpretation for the sequence d_i, d_{i+1}, d_{i+2} to be valid.\n        if n < 2: # Per \"Numbers with fewer than two digits are explicitly defined as non-undulating.\"\n            return False\n        # For n=2 (e.g., 12), it satisfies d_i != d_{i+1} but cannot satisfy d_i == d_{i+2}.\n        # So it's not undulating.\n        return False\n\n    for i in range(n - 1):\n        # Condition 1: Adjacent digits must not be equal (d_i != d_{i+1})\n        if s_number[i] == s_number[i+1]:\n            return False\n\n    for i in range(n - 2):\n        # Condition 2: Digits separated by one position must be equal (d_i == d_{i+2})\n        if s_number[i] != s_number[i+2]:\n            return False\n\n    return True"}
{"task_id": "Mbpp/94", "solution": "def index_minimum(list_of_tuples: list[tuple[any, comparable]]) -> any:\n    \"\"\"\n    Returns the first value of the tuple with the smallest second value from a list.\n    Prioritizes the earliest occurrence in case of ties for the smallest second value.\n    \"\"\"\n    if not list_of_tuples:\n        raise ValueError(\"Input list cannot be empty.\")\n\n    # Use Python's min function with a key to find the tuple with the smallest second value.\n    # The min function is stable for ties, returning the first encountered element.\n    min_tuple = min(list_of_tuples, key=lambda item: item[1])\n\n    # Return the first element of the identified tuple.\n    return min_tuple[0]"}
{"task_id": "Mbpp/97", "solution": "def frequency_lists(list_of_lists: list) -> dict:\n    \"\"\"\n    Calculates the frequency of each element in a flattened list of lists.\n\n    Args:\n        list_of_lists: A list where each element is also a list.\n\n    Returns:\n        A dictionary where keys are unique elements and values are their frequencies.\n    \"\"\"\n    flattened_list = []\n    for sublist in list_of_lists:\n        flattened_list.extend(sublist)\n\n    frequency_map = {}\n    for element in flattened_list:\n        frequency_map[element] = frequency_map.get(element, 0) + 1\n\n    return frequency_map"}
{"task_id": "Mbpp/95", "solution": "def Find_Min_Length(input_list_of_lists):\n    # Initialize min_length with the length of the first list.\n    # This assumes input_list_of_lists is not empty and contains at least one list.\n    min_length = len(input_list_of_lists[0])\n\n    for inner_list in input_list_of_lists:\n        current_length = len(inner_list)\n        if current_length < min_length:\n            min_length = current_length\n\n    return min_length"}
{"task_id": "Mbpp/96", "solution": "def divisor(n: int) -> int:\n    \"\"\"\n    Calculates the number of positive divisors for a given integer n.\n    The count includes 1 and the absolute value of n itself if n is non-zero.\n    \"\"\"\n    num = abs(n)\n    if num == 0:\n        return 0  # 0 has no positive divisors in this context.\n\n    div_count = 0\n    # Iterate from 1 up to the square root of num (inclusive)\n    for i in range(1, int(num**0.5) + 1):\n        if num % i == 0:\n            if i * i == num:\n                div_count += 1  # i is the square root, count once\n            else:\n                div_count += 2  # i and num/i are distinct divisors\n\n    return div_count"}
{"task_id": "Mbpp/99", "solution": "def decimal_to_binary(decimal_num: int) -> str:\n    \"\"\"Converts a decimal number to its binary equivalent, represented as a string with no leading zeros.\"\"\"\n    if decimal_num == 0:\n        return '0'\n    return bin(decimal_num)[2:]"}
{"task_id": "Mbpp/98", "solution": "class NumberCollection:\n    \"\"\"Encapsulates a collection of numbers and provides methods for calculation.\"\"\"\n    def __init__(self, numbers: tuple):\n        self._numbers = numbers\n\n    def length(self) -> int:\n        \"\"\"Returns the number of elements in the collection.\"\"\"\n        return len(self._numbers)\n\n    def calculate_product_and_divide_by_length(self) -> float:\n        \"\"\"Calculates the product of all numbers and divides by the collection's length.\"\"\"\n        if not self._numbers:\n            raise ValueError(\"Input collection cannot be empty.\")\n\n        product = 1.0\n        for num in self._numbers:\n            product *= num\n        \n        return product / self.length()\ndef multiply_num(numbers_collection: tuple) -> float:\n    \"\"\"\n    Multiplies all numbers in a list and divides the product by the length of the list.\n    Raises ValueError if the input collection is empty.\n    \"\"\"\n    collection = NumberCollection(numbers_collection)\n    return collection.calculate_product_and_divide_by_length()"}
{"task_id": "Mbpp/100", "solution": "def next_smallest_palindrome(input_integer: int) -> int:\n    \"\"\"\n    Finds the next smallest palindrome strictly greater than the input_integer.\n    It iteratively checks subsequent integers using a helper function until a palindrome is found.\n    \"\"\"\n    def _is_palindrome(num: int) -> bool:\n        \"\"\"\n        Determines if a given integer is a palindrome by converting it to a string and checking its symmetry.\n        \"\"\"\n        s = str(num)\n        return s == s[::-1]\n\n    current_number = input_integer + 1\n    while True:\n        if _is_palindrome(current_number):\n            return current_number\n        current_number += 1"}
