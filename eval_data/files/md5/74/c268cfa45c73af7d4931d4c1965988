{"task_id": "Mbpp/103", "solution": "def eulerian_num(n: int, m: int) -> int:\n    \"\"\"Calculates the Eulerian number a(n, m), which is the number of permutations of {1, ..., n} with exactly m ascents.\"\"\"\n\n    def _binomial_coefficient(n_val: int, k_val: int) -> int:\n        \"\"\"Calculates the binomial coefficient C(n, k).\"\"\"\n        if k_val < 0 or k_val > n_val:\n            return 0\n        if k_val == 0 or k_val == n_val:\n            return 1\n        if k_val > n_val // 2:\n            k_val = n_val - k_val\n\n        res = 1\n        for i in range(k_val):\n            res = res * (n_val - i) // (i + 1)\n        return res\n\n    if m < 0 or m >= n:\n        if n == 0 and m == 0:\n            return 1\n        return 0\n\n    result = 0\n    for k in range(m + 1):\n        term = ((-1)**k) * _binomial_coefficient(n + 1, k) * ((m - k + 1)**n)\n        result += term\n    return result"}
