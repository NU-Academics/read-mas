{"task_id": "Mbpp/259", "solution": "def maximize_elements(\n    tuple1: Tuple[Tuple[int, int], ...],\n    tuple2: Tuple[Tuple[int, int], ...]\n) -> Tuple[Tuple[int, int], ...]:\n    \"\"\"\n    Maximizes elements of two input tuple collections element-wise.\n    It iterates through the input tuples simultaneously, pairing corresponding 2-element inner tuples and maximizing their elements.\n    \"\"\"\n    maximized_pairs = []\n    for (a, b), (x, y) in zip(tuple1, tuple2):\n        maximized_pairs.append((max(a, x), max(b, y)))\n\n    return tuple(maximized_pairs)"}
{"task_id": "Mbpp/260", "solution": "def newman_prime(n: int) -> int:\n    \"\"\"\n    Finds the nth Newman-Shanks-Williams prime number.\n    This function orchestrates the generation and testing of NSW numbers for primality.\n    \"\"\"\n\n    def is_prime(number: int) -> bool:\n        \"\"\"\n        Determines if a given integer is a prime number.\n        This function checks divisibility up to the square root of the number.\n        \"\"\"\n        if number < 2:\n            return False\n        if number == 2 or number == 3:\n            return True\n        if number % 2 == 0 or number % 3 == 0:\n            return False\n        i = 5\n        while i * i <= number:\n            if number % i == 0 or number % (i + 2) == 0:\n                return False\n            i += 6\n        return True\n\n    def calculate_nsw_number(k: int) -> int:\n        \"\"\"\n        Calculates the k-th Newman-Shanks-Williams number.\n        It uses the recurrence relation S_k = 2*S_{k-1} + S_{k-2}.\n        \"\"\"\n        if k == 0:\n            return 1\n        if k == 1:\n            return 1\n        \n        s_prev_prev = 1\n        s_prev = 1\n        \n        for _ in range(2, k + 1):\n            s_current = 2 * s_prev + s_prev_prev\n            s_prev_prev = s_prev\n            s_prev = s_current\n            \n        return s_prev\n\n    if n <= 0:\n        # As per instructions, no exception for edge cases, but NSW primes are typically positive indexed.\n        # For simplicity, if n is non-positive, we return 0, though a real implementation might raise ValueError.\n        return 0 \n\n    prime_count = 0\n    k = 0\n    while True:\n        nsw_num = calculate_nsw_number(k)\n        if is_prime(nsw_num):\n            prime_count += 1\n            if prime_count == n:\n                return nsw_num\n        k += 1"}
