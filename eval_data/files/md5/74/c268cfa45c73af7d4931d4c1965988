{"task_id": "Mbpp/803", "solution": "def is_perfect_square(number: int) -> bool:\n    \"\"\"\n    Checks if the given number is a perfect square.\n    Returns True if it is, False otherwise.\n    \"\"\"\n    if number < 0:\n        return False\n    \n    # math.isqrt returns the integer square root for non-negative numbers.\n    # For example, isqrt(9) is 3, isqrt(10) is 3.\n    # We then check if squaring this integer root yields the original number.\n    import math\n    int_sqrt = math.isqrt(number)\n    return int_sqrt * int_sqrt == number"}
{"task_id": "Mbpp/804", "solution": "def is_product_even(numbers: list) -> bool:\n    \"\"\"\n    Checks if the product of numbers in a list is even.\n    A product is even if at least one factor is an even number.\n    \"\"\"\n    for num in numbers:\n        # Validate input: Ensure all elements are numeric (int or float) as per BR4.\n        if not isinstance(num, (int, float)):\n            raise ValueError(\"Input list must contain only numeric values.\")\n\n        # If any number in the list is even, their product will be even.\n        # This applies to integers (e.g., 2, 4) and even-valued floats (e.g., 2.0, 4.0).\n        # Floats like 2.5 are not considered even as 2.5 % 2 is not zero.\n        if num % 2 == 0:\n            return True\n    \n    # If the loop completes, no even numbers were found in the list.\n    # This implies all numbers were odd, or the list was empty (product is 1).\n    # In both scenarios, the product is odd.\n    return False"}
{"task_id": "Mbpp/806", "solution": "def max_run_uppercase(input_string: str) -> int:\n    \"\"\"\n    Calculates the maximum run of consecutive uppercase English alphabet characters\n    in the given string.\n    \"\"\"\n    max_run = 0\n    current_run = 0\n\n    for char in input_string:\n        if 'A' <= char <= 'Z':\n            current_run += 1\n        else:\n            max_run = max(max_run, current_run)\n            current_run = 0\n\n    max_run = max(max_run, current_run)\n\n    return max_run"}
