{"task_id": "HumanEval/3", "solution": "def below_zero(operations: List[int]) -> bool:\n    \"\"\" You're given a list of deposit and withdrawal operations on a bank account that starts with\n    zero balance. Your task is to detect if at any point the balance of account fallls below zero, and\n    at that point function should return True. Otherwise it should return False.\n    >>> below_zero([1, 2, 3])\n    False\n    >>> below_zero([1, 2, -4, 5])\n    True\n    \"\"\"\n    class AccountBalance:\n        \"\"\"Manages the current account balance and checks if it falls below zero.\"\"\"\n        def __init__(self):\n            self._balance = 0\n\n        def update(self, amount: int) -> None:\n            \"\"\"Adds the given amount to the balance.\"\"\"\n            self._balance += amount\n\n        def is_below_zero(self) -> bool:\n            \"\"\"Returns True if the balance is less than zero, False otherwise.\"\"\"\n            return self._balance < 0\n\n    account = AccountBalance()\n    for operation in operations:\n        account.update(operation)\n        if account.is_below_zero():\n            return True\n    return False"}
{"task_id": "HumanEval/2", "solution": "def truncate_number(number: float) -> float:\n    \"\"\" Given a positive floating point number, it can be decomposed into\n    and integer part (largest integer smaller than given number) and decimals\n    (leftover part always smaller than 1).\n\n    Return the decimal part of the number.\n    >>> truncate_number(3.5)\n    0.5\n    \"\"\"\n    # Compute the decimal part by subtracting the integer part from the number.\n    return number - int(number)"}
{"task_id": "HumanEval/1", "solution": "def separate_paren_groups(paren_string: str) -> List[str]:\n    \"\"\" Separates multiple groups of nested parentheses into individual strings.\n    Each returned group is balanced and not nested within other returned groups.\n    \"\"\"\n\n    def _clean_input_string(input_str: str) -> str:\n        \"\"\"Removes all space characters from the input string.\"\"\"\n        return input_str.replace(' ', '')\n\n    def _find_independent_balanced_groups(cleaned_str: str) -> List[str]:\n        \"\"\"Identifies and extracts all independent, balanced parenthesis groups.\"\"\"\n        groups = []\n        current_group_chars = []\n        balance = 0\n        \n        for char in cleaned_str:\n            if char == '(':\n                balance += 1\n                current_group_chars.append(char)\n            elif char == ')':\n                balance -= 1\n                current_group_chars.append(char)\n            \n            # If balance returns to 0, and we have accumulated characters, it's an independent group\n            if balance == 0 and current_group_chars:\n                groups.append(\"\".join(current_group_chars))\n                current_group_chars = [] # Reset for the next group\n        \n        return groups\n\n    cleaned_string = _clean_input_string(paren_string)\n    extracted_groups = _find_independent_balanced_groups(cleaned_string)\n    return extracted_groups"}
{"task_id": "HumanEval/6", "solution": "def parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\" Input to this function is a string represented multiple groups for nested parentheses separated by spaces.\n    For each of the group, output the deepest level of nesting of parentheses.\n    E.g. (()()) has maximum two levels of nesting while ((())) has three.\n\n    >>> parse_nested_parens('(()()) ((())) () ((())()())')\n    [2, 3, 1, 3]\n    \"\"\"\n    def _calculate_deepest_nesting(group: str) -> int:\n        \"\"\"Calculates the deepest level of nesting for a single parenthesis group.\"\"\"\n        current_depth = 0\n        max_depth = 0\n        for char in group:\n            if char == '(':\n                current_depth += 1\n                max_depth = max(max_depth, current_depth)\n            elif char == ')':\n                current_depth -= 1\n        return max_depth\n\n    def _parse_groups(paren_string: str) -> List[str]:\n        \"\"\"Splits the input paren_string into individual parenthesis groups based on spaces.\"\"\"\n        return paren_string.split(' ')\n\n    groups = _parse_groups(paren_string)\n    nesting_levels = [_calculate_deepest_nesting(group) for group in groups]\n    return nesting_levels"}
{"task_id": "HumanEval/0", "solution": "import math\nfrom typing import List\ndef has_close_elements(numbers: List[float], threshold: float) -> bool:\n    \"\"\" Check if in given list of numbers, are any two numbers closer to each other than\n    given threshold.\n    >>> has_close_elements([1.0, 2.0, 3.0], 0.5)\n    False\n    >>> has_close_elements([1.0, 2.8, 3.0, 4.0, 5.0, 2.0], 0.3)\n    True\n    \"\"\"\n    n = len(numbers)\n    if n < 2:\n        return False\n\n    for i in range(n):\n        for j in range(i + 1, n):\n            if math.fabs(numbers[i] - numbers[j]) < threshold:\n                return True\n    return False"}
{"task_id": "HumanEval/7", "solution": "def filter_by_substring(strings: List[str], substring: str) -> List[str]:\n    \"\"\" Filter an input list of strings only for ones that contain given substring\n    >>> filter_by_substring([], 'a')\n    []\n    >>> filter_by_substring(['abc', 'bacd', 'cde', 'array'], 'a')\n    ['abc', 'bacd', 'array']\n    \"\"\"\n    filtered_strings = []\n    for s in strings:\n        if substring in s:\n            filtered_strings.append(s)\n    return filtered_strings"}
{"task_id": "HumanEval/4", "solution": "def mean_absolute_deviation(numbers: List[float]) -> float:\n    \"\"\" For a given list of input numbers, calculate Mean Absolute Deviation\n    around the mean of this dataset.\n    Mean Absolute Deviation is the average absolute difference between each\n    element and a centerpoint (mean in this case):\n    MAD = average | x - x_mean |\n    >>> mean_absolute_deviation([1.0, 2.0, 3.0, 4.0])\n    1.0\n    \"\"\"\n    def calculate_mean(numbers_list: List[float]) -> float:\n        \"\"\"Calculates the arithmetic mean of a list of numbers.\"\"\"\n        if not numbers_list:\n            return 0.0\n        return sum(numbers_list) / len(numbers_list)\n\n    def calculate_absolute_differences(numbers_list: List[float], mean: float) -> List[float]:\n        \"\"\"Calculates the absolute difference between each number and the given mean.\"\"\"\n        return [abs(x - mean) for x in numbers_list]\n\n    def calculate_average(numbers_list: List[float]) -> float:\n        \"\"\"Calculates the average of a list of numbers.\"\"\"\n        if not numbers_list:\n            return 0.0\n        return sum(numbers_list) / len(numbers_list)\n\n    if not numbers:\n        return 0.0\n\n    mean_value = calculate_mean(numbers)\n    absolute_differences = calculate_absolute_differences(numbers, mean_value)\n    mad_result = calculate_average(absolute_differences)\n    \n    return mad_result"}
{"task_id": "HumanEval/5", "solution": "def intersperse(numbers: List[int], delimeter: int) -> List[int]:\n    \"\"\" Insert a number 'delimeter' between every two consecutive elements of input list `numbers'\n    >>> intersperse([], 4)\n    []\n    >>> intersperse([1, 2, 3], 4)\n    [1, 4, 2, 4, 3]\n    \"\"\"\n    if not numbers or len(numbers) == 1:\n        return numbers\n\n    result = []\n    for i, num in enumerate(numbers):\n        result.append(num)\n        if i < len(numbers) - 1:\n            result.append(delimeter)\n    return result"}
{"task_id": "HumanEval/9", "solution": "def rolling_max(numbers: List[int]) -> List[int]:\n    \"\"\" From a given list of integers, generate a list of rolling maximum element found until given moment\n    in the sequence.\n    >>> rolling_max([1, 2, 3, 2, 3, 4, 2])\n    [1, 2, 3, 3, 3, 4, 4]\n    \"\"\"\n    if not numbers:\n        return []\n\n    result_list = []\n    current_max = numbers[0]\n\n    for number in numbers:\n        if number > current_max:\n            current_max = number\n        result_list.append(current_max)\n\n    return result_list"}
{"task_id": "HumanEval/8", "solution": "def sum_product(numbers: List[int]) -> Tuple[int, int]:\n    \"\"\" For a given list of integers, return a tuple consisting of a sum and a product of all the integers in a list.\n    Empty sum should be equal to 0 and empty product should be equal to 1.\n    >>> sum_product([])\n    (0, 1)\n    >>> sum_product([1, 2, 3, 4])\n    (10, 24)\n    \"\"\"\n    if not numbers:\n        return (0, 1)\n\n    total_sum = 0\n    total_product = 1\n    for num in numbers:\n        total_sum += num\n        total_product *= num\n    return (total_sum, total_product)"}
{"task_id": "HumanEval/13", "solution": "def greatest_common_divisor(a: int, b: int) -> int:\n    \"\"\" Return a greatest common divisor of two integers a and b\n    >>> greatest_common_divisor(3, 5)\n    1\n    >>> greatest_common_divisor(25, 15)\n    5\n    \"\"\"\n    a = abs(a)\n    b = abs(b)\n    while b:\n        a, b = b, a % b\n    return a"}
{"task_id": "HumanEval/12", "solution": "def longest(strings: List[str]) -> Optional[str]:\n    \"\"\" Out of list of strings, return the longest one. Return the first one in case of multiple\n    strings of the same length. Return None in case the input list is empty.\n    \"\"\"\n    if not strings:\n        return None\n\n    current_longest = strings[0]\n    for s in strings[1:]:\n        if len(s) > len(current_longest):\n            current_longest = s\n    return current_longest"}
{"task_id": "HumanEval/11", "solution": "class UnequalLengthStringsError(Exception):\n    \"\"\"Custom exception for input strings of unequal length.\"\"\"\n    pass\ndef _perform_char_xor(char_a: str, char_b: str) -> str:\n    \"\"\"Performs XOR on two single binary characters.\"\"\"\n    if char_a == char_b:\n        return '0'\n    else:\n        return '1'\ndef string_xor(a: str, b: str) -> str:\n    \"\"\" Input are two strings a and b consisting only of 1s and 0s.\n    Perform binary XOR on these inputs and return result also as a string.\n    >>> string_xor('010', '110')\n    '100'\n    \"\"\"\n    _validate_binary_string(a)\n    _validate_binary_string(b)\n\n    if len(a) != len(b):\n        raise UnequalLengthStringsError(\"Input strings must have the same length.\")\n\n    result_chars = []\n    for i in range(len(a)):\n        result_chars.append(_perform_char_xor(a[i], b[i]))\n\n    return \"\".join(result_chars)"}
{"task_id": "HumanEval/15", "solution": "def string_sequence(n: int) -> str:\n    \"\"\" Return a string containing space-delimited numbers starting from 0 upto n inclusive.\n    >>> string_sequence(0)\n    '0'\n    >>> string_sequence(5)\n    '0 1 2 3 4 5'\n    \"\"\"\n    return ' '.join(str(i) for i in range(n + 1))"}
