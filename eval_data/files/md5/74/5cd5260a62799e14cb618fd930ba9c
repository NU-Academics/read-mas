{"task_id": "HumanEval/118", "solution": "def get_closest_vowel(word):\n    \"\"\"You are given a word. Your task is to find the closest vowel that stands between \n    two consonants from the right side of the word (case sensitive).\n    \n    Vowels in the beginning and ending doesn't count. Return empty string if you didn't\n    find any vowel met the above condition. \n\n    You may assume that the given string contains English letter only.\n\n    Example:\n    get_closest_vowel(\"yogurt\") ==> \"u\"\n    get_closest_vowel(\"FULL\") ==> \"U\"\n    get_closest_vowel(\"quick\") ==> \"\"\n    get_closest_vowel(\"ab\") ==> \"\"\n    \"\"\"\n    def _is_vowel(char):\n        return char in \"aeiouAEIOU\"\n\n    def _is_consonant(char):\n        return char.isalpha() and not _is_vowel(char)\n\n    if len(word) < 3:\n        return \"\"\n\n    # Iterate from right to left, excluding the first and last characters\n    # Indices to check are from len(word) - 2 down to 1\n    for i in range(len(word) - 2, 0, -1):\n        char = word[i]\n        if _is_vowel(char):\n            left_char = word[i - 1]\n            right_char = word[i + 1]\n            if _is_consonant(left_char) and _is_consonant(right_char):\n                return char\n    \n    return \"\""}
{"task_id": "HumanEval/119", "solution": "def match_parens(lst):\n    '''\n    Checks if concatenating two strings of parentheses in any order results in a balanced string.\n    Returns 'Yes' if possible, 'No' otherwise.\n    '''\n\n    def _is_balanced(s: str) -> bool:\n        \"\"\"Determines if a given string of parentheses is balanced.\"\"\"\n        balance = 0\n        for char in s:\n            if char == '(':\n                balance += 1\n            else:\n                balance -= 1\n            if balance < 0:\n                return False\n        return balance == 0\n\n    def _validate_input_list(lst_to_validate: list) -> bool:\n        \"\"\"Validates that the input list contains exactly two elements.\"\"\"\n        return len(lst_to_validate) == 2\n\n    def _validate_string_content(s_to_validate: str) -> bool:\n        \"\"\"Validates that a given string contains only '(' or ')' characters.\"\"\"\n        for char in s_to_validate:\n            if char not in '()':\n                return False\n        return True\n\n    if not _validate_input_list(lst):\n        return 'No'\n\n    s1 = lst[0]\n    s2 = lst[1]\n\n    if not _validate_string_content(s1) or not _validate_string_content(s2):\n        return 'No'\n\n    # Try s1 + s2\n    if _is_balanced(s1 + s2):\n        return 'Yes'\n\n    # Try s2 + s1\n    if _is_balanced(s2 + s1):\n        return 'Yes'\n\n    return 'No'"}
{"task_id": "HumanEval/120", "solution": "def maximum(arr, k):\n    \"\"\"\n    Given an array arr of integers and a positive integer k, return a sorted list \n    of length k with the maximum k numbers in arr.\n    \"\"\"\n    # Sort the array in descending order to easily find the k largest elements.\n    sorted_arr_desc = sorted(arr, reverse=True)\n\n    # Take the first k elements, which are the k largest.\n    top_k_elements = sorted_arr_desc[:k]\n\n    # Sort these k elements in ascending order as required for the final output.\n    top_k_elements.sort()\n\n    return top_k_elements"}
{"task_id": "HumanEval/121", "solution": "def solution(lst):\n    \"\"\"Given a non-empty list of integers, return the sum of all of the odd elements that are in even positions.\n\n    Examples\n    solution([5, 8, 7, 1]) ==> 12\n    solution([3, 3, 3, 3, 3]) ==> 9\n    solution([30, 13, 24, 321]) ==>0\n    \"\"\"\n    total_sum = 0\n    for index, value in enumerate(lst):\n        # Add value to sum if it's odd and its 0-indexed position is even.\n        if value % 2 != 0 and index % 2 == 0:\n            total_sum += value\n    return total_sum"}
{"task_id": "HumanEval/116", "solution": "def sort_array(arr):\n    \"\"\"\n    In this Kata, you have to sort an array of non-negative integers according to\n    number of ones in their binary representation in ascending order.\n    For similar number of ones, sort based on decimal value.\n\n    It must be implemented like this:\n    >>> sort_array([1, 5, 2, 3, 4]) == [1, 2, 3, 4, 5]\n    >>> sort_array([-2, -3, -4, -5, -6]) == [-6, -5, -4, -3, -2]\n    >>> sort_array([1, 0, 2, 3, 4]) [0, 1, 2, 3, 4]\n    \"\"\"\n\n    def _count_set_bits(n: int) -> int:\n        \"\"\"Counts the number of set bits (1s) in the binary representation of a non-negative integer.\"\"\"\n        return bin(n).count('1')\n\n    def _get_sort_key(num: int) -> tuple:\n        \"\"\"Generates a custom sort key based on the integer's sign and specified sorting rules.\"\"\"\n        if num < 0:\n            # Negative numbers are sorted purely by their decimal value.\n            # Category 0 ensures they come before non-negative numbers' category (1).\n            return (0, num)\n        else:\n            # Non-negative numbers are sorted by one-count, then by decimal value.\n            # Category 1 ensures they come after negative numbers' category (0).\n            return (1, _count_set_bits(num), num)\n\n    return sorted(arr, key=_get_sort_key)"}
{"task_id": "HumanEval/123", "solution": "def get_odd_collatz(n):\n    \"\"\"\n    Given a positive integer n, return a sorted list that has the odd numbers in collatz sequence.\n    \"\"\"\n    if n == 1:\n        return [1]\n\n    odd_numbers = set()\n    current = n\n    while current != 1:\n        if current % 2 != 0:\n            odd_numbers.add(current)\n        if current % 2 == 0:\n            current //= 2\n        else:\n            current = 3 * current + 1\n    odd_numbers.add(1) # 1 is always part of the sequence and is odd.\n\n    result = list(odd_numbers)\n    result.sort()\n    return result"}
{"task_id": "HumanEval/122", "solution": "def add_elements(arr, k):\n    \"\"\"\n    Given a non-empty array of integers arr and an integer k, return\n    the sum of the elements with at most two digits from the first k elements of arr.\n\n    Example:\n\n        Input: arr = [111,21,3,4000,5,6,7,8,9], k = 4\n        Output: 24 # sum of 21 + 3\n\n    Constraints:\n        1. 1 <= len(arr) <= 100\n        2. 1 <= k <= len(arr)\n    \"\"\"\n\n    class InvalidArgumentError(Exception):\n        \"\"\"Custom exception for signaling invalid input parameters.\"\"\"\n        def __init__(self, message: str):\n            super().__init__(message)\n            self.message = message\n\n    def _validate_inputs(arr_val: list[int], k_val: int) -> None:\n        \"\"\"Validates the input array length and k value against specified constraints.\"\"\"\n        if not (1 <= len(arr_val) <= 100):\n            raise InvalidArgumentError(\"Array length must be between 1 and 100, inclusive.\")\n        if not (1 <= k_val <= len(arr_val)):\n            raise InvalidArgumentError(\"k must be between 1 and the length of the array, inclusive.\")\n\n    def _filter_and_sum_elements(elements: list[int]) -> int:\n        \"\"\"Filters elements by absolute value less than 100 and calculates their sum.\"\"\"\n        current_sum = 0\n        for element in elements:\n            if -99 <= element <= 99: # Elements with at most two digits (e.g., -99 to 99)\n                current_sum += element\n        return current_sum\n\n    _validate_inputs(arr, k)\n\n    first_k_elements = arr[:k]\n\n    result_sum = _filter_and_sum_elements(first_k_elements)\n\n    return result_sum"}
{"task_id": "HumanEval/126", "solution": "def is_sorted(lst):\n    '''\n    Given a list of numbers, return whether or not they are sorted\n    in ascending order. If list has more than 1 duplicate of the same\n    number, return False. Assume no negative numbers and only integers.\n    '''\n    def _check_ascending_order(lst_param):\n        # Checks if the list is sorted in ascending order.\n        for i in range(1, len(lst_param)):\n            if lst_param[i] < lst_param[i-1]:\n                return False\n        return True\n\n    def _check_duplicate_constraint(lst_param):\n        # Checks if any number occurs three or more times.\n        counts = {}\n        for num in lst_param:\n            counts[num] = counts.get(num, 0) + 1\n            if counts[num] >= 3:\n                return False\n        return True\n\n    if not _check_ascending_order(lst):\n        return False\n    \n    if not _check_duplicate_constraint(lst):\n        return False\n        \n    return True"}
{"task_id": "HumanEval/125", "solution": "def split_words(txt):\n    '''\n    Given a string of words, return a list of words split on whitespace, if no whitespaces exists in the text you\n    should split on commas ',' if no commas exists you should return the number of lower-case letters with odd order in the\n    alphabet, ord('a') = 0, ord('b') = 1, ... ord('z') = 25\n    Examples\n    split_words(\"Hello world!\") \u279e [\"Hello\", \"world!\"]\n    split_words(\"Hello,world!\") \u279e [\"Hello\", \"world!\"]\n    split_words(\"abcdef\") == 3 \n    '''\n    \n    _ALPHABET_ORDER_MAP = {chr(ord('a') + i): i for i in range(26)}\n\n    def _has_whitespace(text):\n        \"\"\"Checks if the text contains any whitespace characters.\"\"\"\n        return any(c.isspace() for c in text)\n\n    def _has_comma(text):\n        \"\"\"Checks if the text contains any comma characters.\"\"\"\n        return ',' in text\n\n    def _count_odd_ordered_lowercase_letters(text):\n        \"\"\"Counts lowercase letters with odd alphabetical order.\"\"\"\n        count = 0\n        for char in text:\n            if 'a' <= char <= 'z':\n                order = _ALPHABET_ORDER_MAP[char]\n                if order % 2 != 0:\n                    count += 1\n        return count\n\n    if _has_whitespace(txt):\n        return txt.split()\n    elif _has_comma(txt):\n        return txt.split(',')\n    else:\n        return _count_odd_ordered_lowercase_letters(txt)"}
{"task_id": "HumanEval/124", "solution": "def valid_date(date):\n    \"\"\"You have to write a function which validates a given date string and\n    returns True if the date is valid otherwise False.\n    \"\"\"\n\n    def _is_not_empty(date_string: str) -> bool:\n        \"\"\"Checks if the input date string is not empty.\"\"\"\n        return bool(date_string)\n\n    def _is_valid_format(date_string: str) -> bool:\n        \"\"\"Validates if the date string adheres to 'mm-dd-yyyy' format by checking length and hyphen positions.\"\"\"\n        if len(date_string) != 10:\n            return False\n        if date_string[2] != '-' or date_string[5] != '-':\n            return False\n        return True\n\n    def _parse_date_components(date_string: str) -> tuple[int, int, int] | None:\n        \"\"\"Extracts month, day, and year as integers from a formatted date string.\"\"\"\n        try:\n            month_str = date_string[0:2]\n            day_str = date_string[3:5]\n            year_str = date_string[6:10]\n\n            month = int(month_str)\n            day = int(day_str)\n            year = int(year_str)\n            return (month, day, year)\n        except ValueError:\n            return None\n\n    def _is_valid_month_value(month: int) -> bool:\n        \"\"\"Validates if the month integer is within the range [1, 12].\"\"\"\n        return 1 <= month <= 12\n\n    def _get_max_days_for_month(month: int) -> int:\n        \"\"\"Determines the maximum allowed days for a given month based on rules.\"\"\"\n        if month in {1, 3, 5, 7, 8, 10, 12}:\n            return 31\n        elif month in {4, 6, 9, 11}:\n            return 30\n        elif month == 2:\n            return 29\n        return 0 # Should not be reached if month value is already validated\n\n    def _is_valid_day_value(day: int, month: int) -> bool:\n        \"\"\"Validates if the day integer is within the valid range for the given month.\"\"\"\n        max_days = _get_max_days_for_month(month)\n        return 1 <= day <= max_days\n\n    # Orchestrate the validation steps\n    if not _is_not_empty(date):\n        return False\n\n    if not _is_valid_format(date):\n        return False\n\n    parsed_date = _parse_date_components(date)\n    if parsed_date is None:\n        return False\n\n    month, day, year = parsed_date\n\n    if not _is_valid_month_value(month):\n        return False\n\n    if not _is_valid_day_value(day, month):\n        return False\n\n    return True"}
{"task_id": "HumanEval/127", "solution": "def intersection(interval1, interval2):\n    \"\"\"You are given two intervals,\n    where each interval is a pair of integers. For example, interval = (start, end) = (1, 2).\n    The given intervals are closed which means that the interval (start, end)\n    includes both start and end.\n    For each given interval, it is assumed that its start is less or equal its end.\n    Your task is to determine whether the length of intersection of these two \n    intervals is a prime number.\n    Example, the intersection of the intervals (1, 3), (2, 4) is (2, 3)\n    which its length is 1, which not a prime number.\n    If the length of the intersection is a prime number, return \"YES\",\n    otherwise, return \"NO\".\n    If the two intervals don't intersect, return \"NO\".\n\n\n    [input/output] samples:\n    intersection((1, 2), (2, 3)) ==> \"NO\"\n    intersection((-1, 1), (0, 4)) ==> \"NO\"\n    intersection((-3, -1), (-5, 5)) ==> \"YES\"\n    \"\"\"\n\n    class Interval:\n        \"\"\"Represents a closed integer interval (start, end).\"\"\"\n        def __init__(self, start: int, end: int):\n            self.start = start\n            self.end = end\n\n    def _calculate_intersection_interval(int_obj1: Interval, int_obj2: Interval):\n        \"\"\"Determines the intersection of two Interval objects.\"\"\"\n        intersection_start = max(int_obj1.start, int_obj2.start)\n        intersection_end = min(int_obj1.end, int_obj2.end)\n\n        if intersection_start <= intersection_end:\n            return Interval(intersection_start, intersection_end)\n        else:\n            return None\n\n    def _calculate_length(int_obj: Interval | None) -> int:\n        \"\"\"Calculates the length of an Interval object.\"\"\"\n        if int_obj is None:\n            return 0\n        else:\n            return int_obj.end - int_obj.start + 1\n\n    def _is_prime(number: int) -> bool:\n        \"\"\"Determines if a given integer is a prime number.\"\"\"\n        if number <= 1:\n            return False\n        i = 2\n        while i * i <= number:\n            if number % i == 0:\n                return False\n            i += 1\n        return True\n\n    # Convert input tuples to Interval objects\n    int_obj1 = Interval(interval1[0], interval1[1])\n    int_obj2 = Interval(interval2[0], interval2[1])\n\n    # Determine the intersection interval\n    intersection_result = _calculate_intersection_interval(int_obj1, int_obj2)\n\n    # Calculate the length of the intersection\n    length = _calculate_length(intersection_result)\n\n    # Determine if the length is a prime number\n    if _is_prime(length):\n        return \"YES\"\n    else:\n        return \"NO\""}
{"task_id": "HumanEval/128", "solution": "def prod_signs(arr):\n    \"\"\"\n    You are given an array arr of integers and you need to return\n    sum of magnitudes of integers multiplied by product of all signs\n    of each number in the array, represented by 1, -1 or 0.\n    Note: return None for empty arr.\n\n    Example:\n    >>> prod_signs([1, 2, 2, -4]) == -9\n    >>> prod_signs([0, 1]) == 0\n    >>> prod_signs([]) == None\n    \"\"\"\n    def _get_magnitude(number):\n        \"\"\"Calculates the absolute value (magnitude) of a single integer.\"\"\"\n        return abs(number)\n\n    def _get_sign(number):\n        \"\"\"Determines the sign of a single integer (1, -1, or 0).\"\"\"\n        if number > 0:\n            return 1\n        elif number < 0:\n            return -1\n        else:\n            return 0\n\n    if not arr:\n        return None\n\n    sum_of_magnitudes = 0\n    product_of_signs = 1\n\n    for number in arr:\n        sum_of_magnitudes += _get_magnitude(number)\n        product_of_signs *= _get_sign(number)\n\n    return sum_of_magnitudes * product_of_signs"}
{"task_id": "HumanEval/131", "solution": "def digits(n):\n    \"\"\"Given a positive integer n, return the product of the odd digits.\n    Return 0 if all digits are even.\n    \"\"\"\n    product = 1\n    has_odd_digits = False\n    temp_n = n\n\n    while temp_n > 0:\n        digit = temp_n % 10\n        if digit % 2 != 0:  # Check if digit is odd\n            product *= digit\n            has_odd_digits = True\n        temp_n //= 10\n\n    if not has_odd_digits:\n        return 0\n    else:\n        return product"}
{"task_id": "HumanEval/130", "solution": "def tri(n):\n    \"\"\"Calculates the first n + 1 numbers of the Tribonacci sequence.\n    The sequence is defined by specific recurrence relations for base cases, even, and odd numbers.\n    \"\"\"\n\n    memo = {}\n\n    def _get_tribonacci_number_internal(index):\n        # Return memoized value if already calculated.\n        if index in memo:\n            return memo[index]\n\n        # Only odd numbers > 1 should reach here after pre-population of base cases and evens.\n        # This branch handles the recursive definition for odd numbers.\n        val_n_minus_1 = _get_tribonacci_number_internal(index - 1)\n        val_n_minus_2 = _get_tribonacci_number_internal(index - 2)\n        val_n_plus_1 = _get_tribonacci_number_internal(index + 1)\n        memo[index] = val_n_minus_1 + val_n_minus_2 + val_n_plus_1\n        return memo[index]\n\n    # Initialize base cases: tri(0) = 1 (implied by example), tri(1) = 3.\n    memo[0] = 1\n    if n >= 1:\n        memo[1] = 3\n\n    # Pre-calculate all even terms up to n + 1.\n    # This resolves the forward dependency `tri(n + 1)` for odd `n`.\n    for i in range(2, n + 2): # Iterate up to n+1 inclusive\n        if i % 2 == 0: # If i is an even number\n            memo[i] = 1 + i // 2 # Use integer division as per example\n\n    # Build the final sequence list by fetching or calculating each term from 0 to n.\n    result = []\n    for i in range(n + 1):\n        result.append(_get_tribonacci_number_internal(i))\n\n    return result"}
{"task_id": "HumanEval/134", "solution": "def check_if_last_char_is_a_letter(txt):\n    \"\"\"\n    Checks if the last character of a string is an alphabetical character and is not\n    part of a word (i.e., it's isolated by a preceding space or is the only character).\n    \"\"\"\n    if not txt:\n        return False\n\n    last_char = txt[-1]\n\n    if not last_char.isalpha():\n        return False\n\n    if len(txt) == 1:\n        return True\n\n    # Check the character immediately preceding the last one\n    char_before_last = txt[-2]\n    return char_before_last.isspace()"}
{"task_id": "HumanEval/129", "solution": "def minPath(grid, k):\n    \"\"\"\n    Given a grid with N rows and N columns (N >= 2) and a positive integer k, \n    each cell of the grid contains a value. Every integer in the range [1, N * N]\n    inclusive appears exactly once on the cells of the grid.\n\n    You have to find the minimum path of length k in the grid. You can start\n    from any cell, and in each step you can move to any of the neighbor cells,\n    in other words, you can go to cells which share an edge with you current\n    cell.\n    Please note that a path of length k means visiting exactly k cells (not\n    necessarily distinct).\n    You CANNOT go off the grid.\n    A path A (of length k) is considered less than a path B (of length k) if\n    after making the ordered lists of the values on the cells that A and B go\n    through (let's call them lst_A and lst_B), lst_A is lexicographically less\n    than lst_B, in other words, there exist an integer index i (1 <= i <= k)\n    such that lst_A[i] < lst_B[i] and for any j (1 <= j < i) we have\n    lst_A[j] = lst_B[j].\n    It is guaranteed that the answer is unique.\n    Return an ordered list of the values on the cells that the minimum path go through.\n\n    Examples:\n\n        Input: grid = [ [1,2,3], [4,5,6], [7,8,9]], k = 3\n        Output: [1, 2, 1]\n\n        Input: grid = [ [5,9,3], [4,1,6], [7,8,2]], k = 1\n        Output: [1]\n    \"\"\"\n\n    class Cell:\n        \"\"\"Represents a single cell in the grid with its coordinates and value.\"\"\"\n        def __init__(self, row: int, col: int, value: int):\n            self.row = row\n            self.col = col\n            self.value = value\n\n        def __eq__(self, other):\n            return self.row == other.row and self.col == other.col\n\n        def __hash__(self):\n            return hash((self.row, self.col))\n\n    class Grid:\n        \"\"\"Encapsulates grid data and provides methods for accessing cell objects and finding neighbors.\"\"\"\n        def __init__(self, grid_data: list[list[int]]):\n            N = len(grid_data)\n            self._N = N\n            self._cells = [[None for _ in range(N)] for _ in range(N)]\n            for r in range(N):\n                for c in range(N):\n                    self._cells[r][c] = Cell(r, c, grid_data[r][c])\n\n        def get_N(self) -> int:\n            return self._N\n\n        def get_cell(self, row: int, col: int) -> Cell:\n            return self._cells[row][col]\n\n        def is_valid_coord(self, row: int, col: int) -> bool:\n            return 0 <= row < self._N and 0 <= col < self._N\n\n        def get_neighbors(self, row: int, col: int) -> list[Cell]:\n            neighbors = []\n            directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n            for dr, dc in directions:\n                n_row, n_col = row + dr, col + dc\n                if self.is_valid_coord(n_row, n_col):\n                    neighbors.append(self.get_cell(n_row, n_col))\n            return neighbors\n\n    class Path:\n        \"\"\"Represents an ordered sequence of cells forming a path.\"\"\"\n        def __init__(self, cells: list[Cell]):\n            self._sequence_of_cells = cells\n            self.length = len(cells)\n            self._values_list = [cell.value for cell in cells]\n\n        def get_values_list(self) -> list[int]:\n            return self._values_list\n        \n        # The following methods are part of the design context but not explicitly called\n        # in _find_min_path_dfs due to direct list comparisons for efficiency.\n        def compare_lexicographically(self, other_path: 'Path') -> int:\n            values_self = self._values_list\n            values_other = other_path._values_list\n\n            for i in range(min(self.length, other_path.length)):\n                if values_self[i] < values_other[i]: return -1\n                if values_self[i] > values_other[i]: return 1\n            \n            if self.length < other_path.length: return -1\n            if self.length > other_path.length: return 1\n            return 0\n\n        def get_prefix_values(self, length: int) -> list[int]:\n            return self._values_list[:length]\n\n    def _find_min_path_dfs(\n        current_cell: Cell, \n        current_path_cells: list[Cell], \n        k: int, \n        grid_obj: Grid, \n        min_path_values_wrapper: list[list[int]]\n    ) -> None:\n        \"\"\"Recursively explores paths of length k using Depth-First Search, pruning branches.\"\"\"\n        \n        current_path_len = len(current_path_cells)\n\n        # Pruning optimization: stop if current path prefix is lexicographically greater\n        # than the corresponding prefix of the current minimum path found.\n        if current_path_len > 0:\n            current_path_values_prefix = [c.value for c in current_path_cells]\n            current_best_path_values_prefix = min_path_values_wrapper[0][:current_path_len]\n            \n            if current_path_values_prefix > current_best_path_values_prefix:\n                return\n            \n        # Base case: A path of length k has been formed.\n        if current_path_len == k:\n            current_path_values = [c.value for c in current_path_cells]\n            \n            # Update the minimum path if the current path is lexicographically smaller.\n            if current_path_values < min_path_values_wrapper[0]:\n                min_path_values_wrapper[0] = current_path_values\n            return\n\n        # Recursive step: Explore neighbors.\n        for neighbor in grid_obj.get_neighbors(current_cell.row, current_cell.col):\n            current_path_cells.append(neighbor)\n            _find_min_path_dfs(neighbor, current_path_cells, k, grid_obj, min_path_values_wrapper)\n            current_path_cells.pop() # Backtrack\n\n    N = len(grid)\n    grid_obj = Grid(grid)\n\n    # min_path_values_wrapper holds the current best path found, initialized with \"infinity\" values.\n    min_path_values_wrapper = [[float('inf')] * k]\n\n    # Iterate through each cell as a starting point for DFS.\n    for r in range(N):\n        for c in range(N):\n            start_cell = grid_obj.get_cell(r, c)\n            _find_min_path_dfs(start_cell, [start_cell], k, grid_obj, min_path_values_wrapper)\n            \n            # Optimization for k=1: if the value 1 is found, it's definitively the minimum path.\n            if k == 1 and min_path_values_wrapper[0][0] == 1:\n                return [1]\n\n    return min_path_values_wrapper[0]"}
{"task_id": "HumanEval/132", "solution": "def is_nested(string):\n    \"\"\"\n    Checks if the string contains a subsequence of two opening brackets followed by two closing brackets.\n    This corresponds to finding indices i1 < i2 < i3 < i4 such that s[i1]='[', s[i2]='[', s[i3]=']', s[i4]=']'.\n    \"\"\"\n    state = 0  # Tracks progress: 0=initial, 1=found first '[', 2=found second '[', 3=found first ']', 4=found second ']'\n    \n    for char in string:\n        if char == '[':\n            if state == 0:\n                state = 1\n            elif state == 1:\n                state = 2\n        elif char == ']':\n            if state == 2:\n                state = 3\n            elif state == 3:\n                state = 4\n                return True \n        \n    return False"}
{"task_id": "HumanEval/133", "solution": "def sum_squares(lst):\n    \"\"\"Calculates the sum of squared ceiling numbers from a given list.\n    Each number is first rounded up to the nearest integer, then squared.\n    \"\"\"\n    import math\n\n    total_sum = 0\n    for number in lst:\n        ceiling_value = math.ceil(number)\n        squared_value = ceiling_value * ceiling_value\n        total_sum += squared_value\n    return total_sum"}
{"task_id": "HumanEval/136", "solution": "def largest_smallest_integers(lst):\n    '''\n    Create a function that returns a tuple (a, b), where 'a' is\n    the largest of negative integers, and 'b' is the smallest\n    of positive integers in a list.\n    If there is no negative or positive integers, return them as None.\n\n    Examples:\n    largest_smallest_integers([2, 4, 1, 3, 5, 7]) == (None, 1)\n    largest_smallest_integers([]) == (None, None)\n    largest_smallest_integers([0]) == (None, None)\n    '''\n    largest_neg = None\n    smallest_pos = None\n\n    if not lst:\n        return (None, None)\n\n    for num in lst:\n        if num < 0:\n            if largest_neg is None or num > largest_neg:\n                largest_neg = num\n        elif num > 0:\n            if smallest_pos is None or num < smallest_pos:\n                smallest_pos = num\n\n    return (largest_neg, smallest_pos)"}
{"task_id": "HumanEval/135", "solution": "def can_arrange(arr):\n    \"\"\"Create a function which returns the largest index of an element which\n    is not greater than or equal to the element immediately preceding it. If\n    no such element exists then return -1. The given array will not contain\n    duplicate values.\n    \"\"\"\n    largest_out_of_order_index = -1\n    for i in range(1, len(arr)):\n        if arr[i] < arr[i-1]:\n            largest_out_of_order_index = i\n    return largest_out_of_order_index"}
{"task_id": "HumanEval/138", "solution": "def is_equal_to_sum_even(n):\n    \"\"\"Evaluate whether the given number n can be written as the sum of exactly 4 positive even numbers\n    Example\n    is_equal_to_sum_even(4) == False\n    is_equal_to_sum_even(6) == False\n    is_equal_to_sum_even(8) == True\n    \"\"\"\n    if n < 8:\n        return False\n    if n % 2 != 0:\n        return False\n    return True"}
{"task_id": "HumanEval/137", "solution": "from dataclasses import dataclass\nfrom typing import Any, Optional, Type\ndef _normalize_input(value: Any) -> _ValueInfo:\n    \"\"\"\n    Converts any input (int, float, str) into a _ValueInfo object,\n    handling string-to-float conversion with ',' or '.' decimal separators.\n    \"\"\"\n    original_type = type(value)\n    if isinstance(value, (int, float)):\n        numerical_value = float(value)\n    elif isinstance(value, str):\n        normalized_string = value.replace(',', '.')\n        try:\n            numerical_value = float(normalized_string)\n        except ValueError as e:\n            raise ValueError(f\"Invalid string representation of a real number: '{value}'\") from e\n    else:\n        raise TypeError(f\"Unsupported input type: {original_type}. Expected int, float, or str.\")\n\n    return _ValueInfo(original_value=value, original_type=original_type, numerical_value=numerical_value)\ndef compare_one(a, b):\n    \"\"\"\n    Create a function that takes integers, floats, or strings representing\n    real numbers, and returns the larger variable in its given variable type.\n    Return None if the values are equal.\n    Note: If a real number is represented as a string, the floating point might be . or ,\n\n    compare_one(1, 2.5) \u279e 2.5\n    compare_one(1, \"2,3\") \u279e \"2,3\"\n    compare_one(\"5,1\", \"6\") \u279e \"6\"\n    compare_one(\"1\", 1) \u279e None\n    \"\"\"\n    value_info_a = _normalize_input(a)\n    value_info_b = _normalize_input(b)\n\n    if value_info_a.numerical_value > value_info_b.numerical_value:\n        return value_info_a.original_value\n    elif value_info_b.numerical_value > value_info_a.numerical_value:\n        return value_info_b.original_value\n    else:\n        return None"}
{"task_id": "HumanEval/139", "solution": "def special_factorial(n):\n    \"\"\"Calculates the special factorial of n, defined as n! * (n-1)! * ... * 1!.\n    For example, special_factorial(4) returns 288.\n    \"\"\"\n    special_fact_result = 1\n    current_factorial = 1\n\n    for i in range(1, n + 1):\n        # Calculate i! using the previous factorial (i-1)!\n        current_factorial *= i\n        # Multiply the overall special factorial result by the current i!\n        special_fact_result *= current_factorial\n\n    return special_fact_result"}
{"task_id": "HumanEval/142", "solution": "def sum_squares(lst):\n    \"\"\"\"\n    This function will take a list of integers. For all entries in the list, the function shall square the integer entry if its index is a \n    multiple of 3 and will cube the integer entry if its index is a multiple of 4 and not a multiple of 3. The function will not \n    change the entries in the list whose indexes are not a multiple of 3 or 4. The function shall then return the sum of all entries. \n    \n    Examples:\n    For lst = [1,2,3] the output should be 6\n    For lst = []  the output should be 0\n    For lst = [-1,-5,2,-1,-5]  the output should be -126\n    \"\"\"\n    def _process_single_entry(value: int, index: int) -> int:\n        \"\"\"Applies transformation rules to a single integer based on its index.\"\"\"\n        if index % 3 == 0:\n            return value * value\n        elif index % 4 == 0:\n            return value * value * value\n        else:\n            return value\n\n    total_sum = 0\n    for index, value in enumerate(lst):\n        processed_value = _process_single_entry(value, index)\n        total_sum += processed_value\n    return total_sum"}
{"task_id": "HumanEval/140", "solution": "import re\ndef fix_spaces(text):\n    \"\"\"\n    Given a string text, replace all spaces in it with underscores, \n    and if a string has more than 2 consecutive spaces, \n    then replace all consecutive spaces with - \n    \n    fix_spaces(\"Example\") == \"Example\"\n    fix_spaces(\"Example 1\") == \"Example_1\"\n    fix_spaces(\" Example 2\") == \"_Example_2\"\n    fix_spaces(\" Example   3\") == \"_Example-3\"\n    \"\"\"\n    # Rule 1: Replace sequences of two or more spaces with a single hyphen.\n    # This must be done first to prevent single space replacement from breaking sequences.\n    modified_text = re.sub(r' {2,}', '-', text)\n\n    # Rule 2: Replace single spaces with underscores.\n    # This applies to remaining single spaces after handling consecutive ones.\n    modified_text = modified_text.replace(' ', '_')\n\n    return modified_text"}
{"task_id": "HumanEval/141", "solution": "def file_name_check(file_name):\n    \"\"\"Create a function which takes a string representing a file's name, and returns\n    'Yes' if the the file's name is valid, and returns 'No' otherwise.\n    \"\"\"\n\n    def _count_digits(name: str) -> int:\n        \"\"\"Counts the number of digits in a given string.\"\"\"\n        return sum(1 for char in name if '0' <= char <= '9')\n\n    def _count_dots(name: str) -> int:\n        \"\"\"Counts the number of dots in a given string.\"\"\"\n        return name.count('.')\n\n    def _get_prefix(name: str) -> str:\n        \"\"\"Extracts the substring before the first dot.\"\"\"\n        dot_index = name.find('.')\n        return name[:dot_index] if dot_index != -1 else name\n\n    def _get_extension(name: str) -> str:\n        \"\"\"Extracts the substring after the first dot.\"\"\"\n        dot_index = name.find('.')\n        return name[dot_index + 1:] if dot_index != -1 else ''\n\n    def _is_latin_letter(char: str) -> bool:\n        \"\"\"Checks if a character is a Latin alphabet letter (a-z, A-Z).\"\"\"\n        return 'a' <= char <= 'z' or 'A' <= char <= 'Z'\n\n    def _is_valid_extension(extension: str) -> bool:\n        \"\"\"Checks if an extension is one of the allowed types.\"\"\"\n        ALLOWED_EXTENSIONS = ['txt', 'exe', 'dll']\n        return extension in ALLOWED_EXTENSIONS\n\n    # Check for exactly one dot\n    if _count_dots(file_name) != 1:\n        return 'No'\n\n    prefix = _get_prefix(file_name)\n    extension = _get_extension(file_name)\n\n    # Check prefix not empty\n    if not prefix:\n        return 'No'\n\n    # Check prefix starts with a letter\n    if not _is_latin_letter(prefix[0]):\n        return 'No'\n\n    # Check digit count\n    if _count_digits(file_name) > 3:\n        return 'No'\n\n    # Check extension validity\n    if not _is_valid_extension(extension):\n        return 'No'\n\n    return 'Yes'"}
{"task_id": "HumanEval/144", "solution": "def simplify(x, n):\n    \"\"\"Checks if the product of two fractions, x and n, is a whole number.\"\"\"\n\n    def _gcd(a, b):\n        \"\"\"Calculates the greatest common divisor of two non-negative integers.\"\"\"\n        while b:\n            a, b = b, a % b\n        return a\n\n    class Fraction:\n        \"\"\"Represents a mathematical fraction and provides operations on it.\"\"\"\n        def __init__(self, numerator, denominator):\n            self._numerator = numerator\n            self._denominator = denominator\n            self.simplify()\n\n        @classmethod\n        def from_string(cls, fraction_string):\n            \"\"\"Parses a string \"<numerator>/<denominator>\" into a Fraction object.\"\"\"\n            num_str, den_str = fraction_string.split('/')\n            return cls(int(num_str), int(den_str))\n\n        def simplify(self):\n            \"\"\"Simplifies the fraction by dividing numerator and denominator by their GCD.\"\"\"\n            common_divisor = _gcd(self._numerator, self._denominator)\n            self._numerator //= common_divisor\n            self._denominator //= common_divisor\n\n        def multiply(self, other):\n            \"\"\"Multiplies this fraction by another Fraction object and returns a new, simplified Fraction.\"\"\"\n            new_numerator = self._numerator * other._numerator\n            new_denominator = self._denominator * other._denominator\n            return Fraction(new_numerator, new_denominator)\n\n        def is_whole_number(self):\n            \"\"\"Determines if the fraction represents a whole number (i.e., its simplified denominator is 1).\"\"\"\n            return self._denominator == 1\n\n    fraction_x = Fraction.from_string(x)\n    fraction_n = Fraction.from_string(n)\n\n    product_fraction = fraction_x.multiply(fraction_n)\n\n    return product_fraction.is_whole_number()"}
{"task_id": "HumanEval/145", "solution": "def order_by_points(nums):\n    \"\"\"\n    Sorts the given list of integers in ascending order according to the sum of their digits.\n    If sums are equal, original index is used as a secondary sort key.\n    \"\"\"\n    if not nums:\n        return []\n\n    def _calculate_digit_sum(num: int) -> int:\n        \"\"\"Calculates the sum of digits for a given integer's absolute value.\"\"\"\n        abs_num_str = str(abs(num))\n        digit_sum = 0\n        for digit_char in abs_num_str:\n            digit_sum += int(digit_char)\n        return digit_sum\n\n    class _ItemToSort:\n        \"\"\"Internal data structure to bundle an integer, its digit sum, and original index.\"\"\"\n        def __init__(self, value: int, digit_sum: int, original_index: int):\n            self.value = value\n            self.digit_sum = digit_sum\n            self.original_index = original_index\n\n    items_to_sort = []\n    for index, num in enumerate(nums):\n        digit_sum = _calculate_digit_sum(num)\n        items_to_sort.append(_ItemToSort(num, digit_sum, index))\n\n    sorted_items = sorted(items_to_sort, key=lambda item: (item.digit_sum, item.original_index))\n\n    return [item.value for item in sorted_items]"}
{"task_id": "HumanEval/148", "solution": "def bf(planet1, planet2):\n    PLANET_ORDER = (\n        \"Mercury\", \"Venus\", \"Earth\", \"Mars\", \"Jupiter\",\n        \"Saturn\", \"Uranus\", \"Neptune\"\n    )\n\n    # Validate planet names. Return empty tuple if invalid.\n    if planet1 not in PLANET_ORDER or planet2 not in PLANET_ORDER:\n        return ()\n\n    index1 = PLANET_ORDER.index(planet1)\n    index2 = PLANET_ORDER.index(planet2)\n\n    # Determine the range of indices for planets between planet1 and planet2.\n    # The slicing should always go from the smaller index to the larger one.\n    if index1 < index2:\n        start_index = index1 + 1\n        end_index = index2\n    else:\n        start_index = index2 + 1\n        end_index = index1\n    \n    # Extract the planets within the determined range.\n    between_planets = PLANET_ORDER[start_index:end_index]\n    \n    return tuple(between_planets)"}
{"task_id": "HumanEval/146", "solution": "def specialFilter(nums):\n    \"\"\"Write a function that takes an array of numbers as input and returns \n    the number of elements in the array that are greater than 10 and both \n    first and last digits of a number are odd (1, 3, 5, 7, 9).\n    \"\"\"\n\n    def _is_odd(digit: int) -> bool:\n        \"\"\"Determines if a given digit is odd.\"\"\"\n        return digit % 2 != 0\n\n    def _get_first_digit(num: int) -> int:\n        \"\"\"Extracts the first digit of the absolute value of a number.\"\"\"\n        return int(str(abs(num))[0])\n\n    def _get_last_digit(num: int) -> int:\n        \"\"\"Extracts the last digit of the absolute value of a number.\"\"\"\n        return abs(num) % 10\n\n    def _is_greater_than_ten(num: int) -> bool:\n        \"\"\"Determines if a number is strictly greater than 10.\"\"\"\n        return num > 10\n\n    def _is_first_digit_odd(num: int) -> bool:\n        \"\"\"Determines if the first digit of a number is odd.\"\"\"\n        first_digit = _get_first_digit(num)\n        return _is_odd(first_digit)\n\n    def _is_last_digit_odd(num: int) -> bool:\n        \"\"\"Determines if the last digit of a number is odd.\"\"\"\n        last_digit = _get_last_digit(num)\n        return _is_odd(last_digit)\n\n    def _is_special(num: int) -> bool:\n        \"\"\"Combines all criteria to determine if a number is 'special'.\"\"\"\n        return _is_greater_than_ten(num) and \\\n               _is_first_digit_odd(num) and \\\n               _is_last_digit_odd(num)\n\n    count = 0\n    for num in nums:\n        if _is_special(num):\n            count += 1\n    return count"}
{"task_id": "HumanEval/149", "solution": "def sorted_list_sum(lst):\n    \"\"\"Write a function that accepts a list of strings as a parameter,\n    deletes the strings that have odd lengths from it,\n    and returns the resulted list with a sorted order.\"\"\"\n    filtered_list = []\n    for s in lst:\n        if len(s) % 2 == 0:\n            filtered_list.append(s)\n\n    # Sort by length (ascending), then alphabetically (ascending)\n    filtered_list.sort(key=lambda x: (len(x), x))\n    return filtered_list"}
{"task_id": "HumanEval/147", "solution": "def get_max_triples(n):\n    \"\"\"\n    Counts triples (a[i], a[j], a[k]) where i < j < k and their sum is a multiple of 3.\n    Array a is generated with a[idx] = (idx+1)*(idx+1) - (idx+1) + 1.\n    \"\"\"\n\n    def _generate_array_a(length):\n        \"\"\"Generates array a where a[i] = i*i - i + 1 (1-based index i).\"\"\"\n        arr = []\n        for i_val in range(1, length + 1):\n            arr.append(i_val * i_val - i_val + 1)\n        return arr\n\n    def _is_multiple_of_3(num):\n        \"\"\"Checks if a number is a multiple of 3.\"\"\"\n        return num % 3 == 0\n\n    if n < 3:\n        return 0\n\n    a = _generate_array_a(n)\n    valid_triples_count = 0\n\n    # Iterate through all possible combinations of three distinct indices i_idx < j_idx < k_idx\n    for i_idx in range(n - 2):\n        for j_idx in range(i_idx + 1, n - 1):\n            for k_idx in range(j_idx + 1, n):\n                current_sum = a[i_idx] + a[j_idx] + a[k_idx]\n                if _is_multiple_of_3(current_sum):\n                    valid_triples_count += 1\n\n    return valid_triples_count"}
{"task_id": "HumanEval/150", "solution": "def x_or_y(n, x, y):\n    \"\"\"A simple program which should return the value of x if n is \n    a prime number and should return the value of y otherwise.\n\n    Examples:\n    for x_or_y(7, 34, 12) == 34\n    for x_or_y(15, 8, 5) == 5\n    \n    \"\"\"\n    def is_prime(n):\n        \"\"\"Determines if a given integer n is a prime number.\"\"\"\n        if n <= 1:\n            return False\n        if n <= 3:\n            return True\n        if n % 2 == 0 or n % 3 == 0:\n            return False\n        i = 5\n        while i * i <= n:\n            if n % i == 0 or n % (i + 2) == 0:\n                return False\n            i += 6\n        return True\n\n    if is_prime(n):\n        return x\n    else:\n        return y"}
{"task_id": "HumanEval/151", "solution": "def _is_valid_number(num):\n    \"\"\"Checks if a value is a non-negative integer.\"\"\"\n    # Check if the number is an integer type (int or float that represents an integer)\n    # and if it's non-negative.\n    return isinstance(num, int) and num >= 0\ndef _is_odd(num):\n    \"\"\"Checks if an integer is odd.\"\"\"\n    return num % 2 != 0\ndef _square(num):\n    \"\"\"Calculates the square of a number.\"\"\"\n    return num * num\ndef double_the_difference(lst):\n    \"\"\"\n    Given a list of numbers, return the sum of squares of the numbers\n    in the list that are odd. Ignore numbers that are negative or not integers.\n    \"\"\"\n    total_sum = 0\n    for num in lst:\n        if _is_valid_number(num) and _is_odd(num):\n            total_sum += _square(num)\n    return total_sum"}
{"task_id": "HumanEval/154", "solution": "def cycpattern_check(a , b):\n    \"\"\"Checks if the second word or any of its rotations is a substring in the first word.\"\"\"\n\n    def _generate_cyclic_rotations(s: str) -> list[str]:\n        \"\"\"Generates all cyclic rotations of a given string.\"\"\"\n        if not s:\n            return [\"\"]\n        rotations = []\n        n = len(s)\n        for i in range(n):\n            rotated_s = s[i:] + s[:i]\n            rotations.append(rotated_s)\n        return rotations\n\n    def _is_substring(main_string: str, sub_string: str) -> bool:\n        \"\"\"Determines if a sub_string is present within a main_string.\"\"\"\n        return sub_string in main_string\n\n    if not b:\n        return True # An empty string is always a substring.\n\n    rotations_of_b = _generate_cyclic_rotations(b)\n    for rotation in rotations_of_b:\n        if _is_substring(a, rotation):\n            return True\n    return False"}
{"task_id": "HumanEval/152", "solution": "from typing import List\ndef compare(game: List[int], guess: List[int]) -> List[int]:\n    \"\"\"Compares two arrays of scores and guesses, returning a list of absolute differences for each match.\n    A value of 0 indicates a correct guess, otherwise it's the absolute difference between score and guess.\n    \"\"\"\n    if len(game) != len(guess):\n        raise ValueError(\"Input arrays 'game' and 'guess' must be of equal length.\")\n\n    differences = []\n    for i in range(len(game)):\n        if game[i] == guess[i]:\n            differences.append(0)\n        else:\n            differences.append(abs(game[i] - guess[i]))\n    return differences"}
{"task_id": "HumanEval/153", "solution": "def Strongest_Extension(class_name, extensions):\n    def _calculate_strength(extension_name: str) -> int:\n        \"\"\"Calculates the strength of an extension name based on uppercase and lowercase letter counts.\"\"\"\n        cap_count = sum(1 for char in extension_name if char.isupper())\n        sm_count = sum(1 for char in extension_name if char.islower())\n        return cap_count - sm_count\n\n    if not extensions:\n        return class_name\n\n    strongest_extension_name = \"\"\n    max_strength = -float('inf')\n\n    for extension in extensions:\n        current_strength = _calculate_strength(extension)\n\n        # If current extension is stronger, or if it's the first one, update.\n        # Tie-breaking: choose the one that comes first if strengths are equal.\n        if current_strength > max_strength:\n            max_strength = current_strength\n            strongest_extension_name = extension\n\n    return f\"{class_name}.{strongest_extension_name}\""}
{"task_id": "HumanEval/156", "solution": "def int_to_mini_roman(number):\n    \"\"\"\n    Given a positive integer, obtain its roman numeral equivalent as a string,\n    and return it in lowercase.\n    Restrictions: 1 <= num <= 1000\n    \"\"\"\n    roman_map = [\n        (1000, 'M'), (900, 'CM'), (500, 'D'), (400, 'CD'),\n        (100, 'C'), (90, 'XC'), (50, 'L'), (40, 'XL'),\n        (10, 'X'), (9, 'IX'), (5, 'V'), (4, 'IV'), (1, 'I')\n    ]\n\n    result = []\n    for value, numeral in roman_map:\n        while number >= value:\n            result.append(numeral)\n            number -= value\n    \n    return \"\".join(result).lower()"}
{"task_id": "HumanEval/155", "solution": "def even_odd_count(num):\n    \"\"\"Given an integer. return a tuple that has the number of even and odd digits respectively.\n\n     Example:\n        even_odd_count(-12) ==> (1, 1)\n        even_odd_count(123) ==> (1, 2)\n    \"\"\"\n    even_count = 0\n    odd_count = 0\n    # Convert the absolute value of the number to a string to iterate through digits.\n    for digit_char in str(abs(num)):\n        digit = int(digit_char)\n        if digit % 2 == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n    return (even_count, odd_count)"}
{"task_id": "HumanEval/157", "solution": "import math\ndef right_angle_triangle(a, b, c):\n    \"\"\"\n    Given the lengths of the three sides of a triangle. Return True if the three\n    sides form a right-angled triangle, False otherwise.\n    \"\"\"\n    sides = sorted([a, b, c])\n    return math.isclose(sides[0]**2 + sides[1]**2, sides[2]**2)"}
{"task_id": "HumanEval/158", "solution": "def find_max(words):\n    \"\"\"Write a function that accepts a list of strings.\n    The list contains different words. Return the word with maximum number\n    of unique characters. If multiple strings have maximum number of unique\n    characters, return the one which comes first in lexicographical order.\n    \"\"\"\n    if not words:\n        return \"\"\n\n    max_unique_count = -1\n    result_word = \"\"\n\n    for word in words:\n        unique_chars = set(word)\n        current_unique_count = len(unique_chars)\n\n        if current_unique_count > max_unique_count:\n            max_unique_count = current_unique_count\n            result_word = word\n        elif current_unique_count == max_unique_count:\n            # Tie-breaker: lexicographical order\n            if word < result_word:\n                result_word = word\n    \n    return result_word"}
{"task_id": "HumanEval/160", "solution": "def do_algebra(operator, operand):\n    \"\"\"\n    Constructs and evaluates an algebraic expression from given lists of operators and operands.\n    \"\"\"\n    expression_parts = []\n    # Add the first operand\n    expression_parts.append(str(operand[0]))\n\n    # Interleave operators and subsequent operands\n    for i in range(len(operator)):\n        expression_parts.append(operator[i])\n        expression_parts.append(str(operand[i+1]))\n\n    # Join parts to form the full expression string\n    expression_string = \" \".join(expression_parts)\n\n    # Evaluate the expression string\n    return eval(expression_string)"}
{"task_id": "HumanEval/159", "solution": "def eat(number, need, remaining):\n    \"\"\"\n    Calculates the total number of eaten carrots and the number of carrots left.\n    Returns an array of [total eaten carrots, carrots left].\n    \"\"\"\n    carrots_eaten_in_current_meal = min(need, remaining)\n    total_carrots_eaten = number + carrots_eaten_in_current_meal\n    carrots_left_in_stock = remaining - carrots_eaten_in_current_meal\n    return [total_carrots_eaten, carrots_left_in_stock]"}
{"task_id": "HumanEval/161", "solution": "def solve(s):\n    \"\"\"You are given a string s.\n    if s[i] is a letter, reverse its case from lower to upper or vise versa, \n    otherwise keep it as it is.\n    If the string contains no letters, reverse the string.\n    The function should return the resulted string.\n    Examples\n    solve(\"1234\") = \"4321\"\n    solve(\"ab\") = \"AB\"\n    solve(\"#a@C\") = \"#A@c\"\n    \"\"\"\n\n    def _is_letter(char):\n        \"\"\"Checks if a character is an alphabetic letter.\"\"\"\n        return char.isalpha()\n\n    def _reverse_case(char):\n        \"\"\"Reverses the case of an alphabetic character.\"\"\"\n        return char.swapcase()\n\n    def _contains_letters(string_to_check):\n        \"\"\"Checks if the input string contains any alphabetic letters.\"\"\"\n        for char in string_to_check:\n            if _is_letter(char):\n                return True\n        return False\n\n    if not _contains_letters(s):\n        # If no letters are found, reverse the entire string.\n        return s[::-1]\n    else:\n        # Otherwise, process each character individually.\n        result_chars = []\n        for char in s:\n            if _is_letter(char):\n                result_chars.append(_reverse_case(char))\n            else:\n                result_chars.append(char)\n        return \"\".join(result_chars)"}
{"task_id": "HumanEval/162", "solution": "def string_to_md5(text):\n    \"\"\"\n    Given a string 'text', return its md5 hash equivalent string.\n    If 'text' is an empty string, return None.\n    \"\"\"\n    import hashlib\n\n    if not text:\n        return None\n    \n    # Encode the string to bytes, then compute the MD5 hash.\n    md5_hash = hashlib.md5(text.encode('utf-8'))\n    # Return the hash as a hexadecimal string.\n    return md5_hash.hexdigest()"}
{"task_id": "HumanEval/163", "solution": "def generate_integers(a, b):\n    \"\"\"\n    Given two positive integers a and b, return the even digits between a\n    and b, in ascending order.\n\n    For example:\n    generate_integers(2, 8) => [2, 4, 6, 8]\n    generate_integers(8, 2) => [2, 4, 6, 8]\n    generate_integers(10, 14) => []\n    \"\"\"\n    min_val = min(a, b)\n    max_val = max(a, b)\n\n    even_numbers = []\n    for i in range(min_val, max_val + 1):\n        if i % 2 == 0:\n            even_numbers.append(i)\n\n    return even_numbers"}
{"task_id": "HumanEval/143", "solution": "def words_in_sentence(sentence):\n    \"\"\"\n    Filters words from a sentence, returning only those with prime number lengths.\n    The order of words is preserved, and they are joined by single spaces.\n    \"\"\"\n    def is_prime(n):\n        \"\"\"Checks if an integer n is a prime number.\"\"\"\n        if n < 2:\n            return False\n        for i in range(2, int(n**0.5) + 1):\n            if n % i == 0:\n                return False\n        return True\n\n    prime_length_words = []\n    for word in sentence.split():\n        if is_prime(len(word)):\n            prime_length_words.append(word)\n\n    return \" \".join(prime_length_words)"}
