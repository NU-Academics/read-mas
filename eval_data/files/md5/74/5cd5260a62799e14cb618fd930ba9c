{"task_id": "HumanEval/25", "solution": "def factorize(n: int) -> List[int]:\n    \"\"\" Return list of prime factors of given integer in the order from smallest to largest.\n    Each of the factors should be listed number of times corresponding to how many times it appeares in factorization.\n    \"\"\"\n    factors = []\n    \n    # The design context suggests handling n=0, 1 and negative numbers by factoring abs(n).\n    current_n = abs(n)\n\n    # For numbers less than or equal to 1, there are no prime factors.\n    if current_n <= 1:\n        return factors\n\n    # Divide by 2 until current_n is odd\n    while current_n % 2 == 0:\n        factors.append(2)\n        current_n //= 2\n\n    # Iterate through odd numbers starting from 3\n    d = 3\n    while d * d <= current_n:\n        while current_n % d == 0:\n            factors.append(d)\n            current_n //= d\n        d += 2 # Increment by 2 to check only odd numbers\n    \n    # If current_n is still greater than 1 after the loop, it means current_n itself is a prime factor\n    if current_n > 1:\n        factors.append(current_n)\n        \n    return factors"}
{"task_id": "HumanEval/26", "solution": "def remove_duplicates(numbers: List[int]) -> List[int]:\n    \"\"\" From a list of integers, remove all elements that occur more than once.\n    Keep order of elements left the same as in the input.\n    \"\"\"\n    counts = {}\n    for num in numbers:\n        counts[num] = counts.get(num, 0) + 1\n\n    result = []\n    for num in numbers:\n        if counts[num] == 1:\n            result.append(num)\n            \n    return result"}
{"task_id": "HumanEval/31", "solution": "def is_prime(n):\n    \"\"\"Return true if a given number is prime, and false otherwise.\n    >>> is_prime(6)\n    False\n    >>> is_prime(101)\n    True\n    >>> is_prime(11)\n    True\n    >>> is_prime(13441)\n    True\n    >>> is_prime(61)\n    True\n    >>> is_prime(4)\n    False\n    >>> is_prime(1)\n    False\n    \"\"\"\n    if n <= 1:\n        return False\n    if n <= 3:\n        return True\n    if n % 2 == 0 or n % 3 == 0:\n        return False\n    i = 5\n    while i * i <= n:\n        if n % i == 0 or n % (i + 2) == 0:\n            return False\n        i += 6\n    return True"}
{"task_id": "HumanEval/33", "solution": "def sort_third(l: list):\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the indicies that are not divisible by three, while its values at the indicies that are divisible by three are equal\n    to the values of the corresponding indicies of l, but sorted.\n    >>> sort_third([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_third([5, 6, 3, 4, 8, 9, 2])\n    [2, 6, 3, 4, 8, 9, 5]\n    \"\"\"\n    # Create a mutable copy of the input list to build the result.\n    result_list = l.copy()\n\n    # Collect elements and their original indices that are divisible by three.\n    elements_to_sort = []\n    indices_to_replace = []\n    for i, value in enumerate(l):\n        if i % 3 == 0:\n            elements_to_sort.append(value)\n            indices_to_replace.append(i)\n\n    # Sort the collected elements.\n    elements_to_sort.sort()\n\n    # Place sorted elements back into the result list at their original indices.\n    for i, sorted_value in zip(indices_to_replace, elements_to_sort):\n        result_list[i] = sorted_value\n\n    return result_list"}
{"task_id": "HumanEval/35", "solution": "def max_element(l: list):\n    \"\"\"Return maximum element in the list.\n    >>> max_element([1, 2, 3])\n    3\n    >>> max_element([5, 3, -5, 2, -3, 3, 9, 0, 123, 1, -10])\n    123\n    \"\"\"\n    # Handle the case of an empty list, though per requirements, we assume valid input.\n    # For a non-empty list, initialize max_val with the first element.\n    max_val = l[0]\n    for element in l:\n        if element > max_val:\n            max_val = element\n    return max_val"}
{"task_id": "HumanEval/32", "solution": "def find_zero(xs: list):\n    \"\"\" xs are coefficients of a polynomial.\n    find_zero find x such that poly(x) = 0.\n    find_zero returns only only zero point, even if there are many.\n    Moreover, find_zero only takes list xs having even number of coefficients\n    and largest non zero coefficient as it guarantees\n    a solution.\n    >>> round(find_zero([1, 2]), 2) # f(x) = 1 + 2x\n    -0.5\n    >>> round(find_zero([-6, 11, -6, 1]), 2) # (x - 1) * (x - 2) * (x - 3) = -6 + 11x - 6x^2 + x^3\n    1.0\n    \"\"\"\n    # 1. Input Validation based on design context (FR5, FR6).\n    if not xs:\n        raise ValueError(\"Coefficients list cannot be empty.\")\n    if len(xs) % 2 != 0:\n        raise ValueError(\"Coefficients list must have an even number of coefficients.\")\n    if xs[-1] == 0:\n        raise ValueError(\"Largest coefficient cannot be zero.\")\n\n    # 2. Bisection Method to find a zero point.\n    # Initialize a sufficiently large search interval.\n    # For odd-degree polynomials, roots are guaranteed, so an interval can be found.\n    low = -1000.0\n    high = 1000.0\n    \n    # Expand the search interval if current endpoints don't bracket a root.\n    # This loop ensures poly(low) and poly(high) have opposite signs or one is a root.\n    for _ in range(100): # Limit iterations to prevent potential infinite loop for extreme cases.\n        p_low = poly(xs, low)\n        p_high = poly(xs, high)\n\n        if p_low * p_high <= 0: # Check if a root is bracketed or found at an endpoint.\n            break \n        \n        low *= 2\n        high *= 2\n\n    # Bisection search for the root within the established interval.\n    tolerance = 1e-7 # Precision for determining if poly(x) is close to zero.\n    max_bisection_iterations = 200 # A reasonable number of iterations for desired precision.\n\n    for _ in range(max_bisection_iterations):\n        mid = (low + high) / 2\n        p_mid = poly(xs, mid)\n\n        if abs(p_mid) < tolerance:\n            return mid\n\n        # Determine which half of the interval contains the root.\n        # Re-evaluate poly(xs, low) for comparison, as 'low' might have been updated.\n        if poly(xs, low) * p_mid < 0:\n            high = mid\n        else:\n            low = mid\n\n    # After max_bisection_iterations, return the midpoint of the final interval\n    # as the best approximation of the zero point.\n    return (low + high) / 2"}
{"task_id": "HumanEval/34", "solution": "def unique(l: list):\n    \"\"\"Return sorted unique elements in a list.\"\"\"\n    unique_elements = list(set(l))\n    unique_elements.sort()\n    return unique_elements"}
{"task_id": "HumanEval/36", "solution": "def fizz_buzz(n: int):\n    \"\"\"Return the number of times the digit 7 appears in integers less than n which are divisible by 11 or 13.\n    >>> fizz_buzz(50)\n    0\n    >>> fizz_buzz(78)\n    2\n    >>> fizz_buzz(79)\n    3\n    \"\"\"\n\n    def _generate_integer_range(limit: int) -> list[int]:\n        \"\"\"Generates a list of positive integers strictly less than 'limit'.\"\"\"\n        return list(range(1, limit))\n\n    def _is_divisible_by_11_or_13(num: int) -> bool:\n        \"\"\"Checks if a single number is divisible by 11 or 13.\"\"\"\n        return num % 11 == 0 or num % 13 == 0\n\n    def _filter_divisible_numbers(numbers_list: list[int]) -> list[int]:\n        \"\"\"Filters a list of integers, retaining only those divisible by 11 or 13.\"\"\"\n        return [num for num in numbers_list if _is_divisible_by_11_or_13(num)]\n\n    def _count_sevens_in_number(num: int) -> int:\n        \"\"\"Counts the occurrences of the digit '7' within a single integer.\"\"\"\n        return str(num).count('7')\n\n    def _count_digit_seven_occurrences(numbers_list: list[int]) -> int:\n        \"\"\"Counts the total occurrences of the digit '7' within a list of numbers.\"\"\"\n        total_sevens = 0\n        for num in numbers_list:\n            total_sevens += _count_sevens_in_number(num)\n        return total_sevens\n\n    # Orchestrate the steps\n    integer_range = _generate_integer_range(n)\n    filtered_numbers = _filter_divisible_numbers(integer_range)\n    final_count = _count_digit_seven_occurrences(filtered_numbers)\n\n    return final_count"}
{"task_id": "HumanEval/37", "solution": "def sort_even(l: list):\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the odd indicies, while its values at the even indicies are equal\n    to the values of the even indicies of l, but sorted.\n    >>> sort_even([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_even([5, 6, 3, 4])\n    [3, 6, 5, 4]\n    \"\"\"\n    if len(l) <= 1:\n        return list(l)\n\n    even_elements = [l[i] for i in range(0, len(l), 2)]\n    even_elements.sort()\n\n    result_list = [None] * len(l)\n    sorted_even_idx = 0\n\n    for i in range(len(l)):\n        if i % 2 == 0:\n            result_list[i] = even_elements[sorted_even_idx]\n            sorted_even_idx += 1\n        else:\n            result_list[i] = l[i]\n\n    return result_list"}
{"task_id": "HumanEval/42", "solution": "def incr_list(l: list):\n    \"\"\"Return list with elements incremented by 1.\"\"\"\n    return [x + 1 for x in l]"}
{"task_id": "HumanEval/38", "solution": "def decode_cyclic(s: str):\n    \"\"\"\n    takes as input string encoded with encode_cyclic function. Returns decoded string.\n    \"\"\"\n    # split string to groups. Each of length 3.\n    groups = [s[(3 * i):min((3 * i + 3), len(s))] for i in range((len(s) + 2) // 3)]\n    # reverse cycle elements in each group. Unless group has fewer elements than 3.\n    groups = [(group[-1] + group[:-1]) if len(group) == 3 else group for group in groups]\n    return \"\".join(groups)"}
{"task_id": "HumanEval/39", "solution": "def prime_fib(n: int):\n    \"\"\"\n    prime_fib returns n-th number that is a Fibonacci number and it's also prime.\n    >>> prime_fib(1)\n    2\n    >>> prime_fib(2)\n    3\n    >>> prime_fib(3)\n    5\n    >>> prime_fib(4)\n    13\n    >>> prime_fib(5)\n    89\n    \"\"\"\n    import math\n\n    # Helper function to check if a number is a perfect square.\n    def _is_perfect_square(x: int) -> bool:\n        if x < 0:\n            return False\n        s = int(math.sqrt(x))\n        return s * s == x\n\n    # Helper function to check if a number is a Fibonacci number using the mathematical property.\n    def _is_fibonacci(num: int) -> bool:\n        if num < 0:\n            return False\n        return _is_perfect_square(5 * num * num + 4) or _is_perfect_square(5 * num * num - 4)\n\n    # Helper function to check if a number is prime.\n    def _is_prime(num: int) -> bool:\n        if num <= 1:\n            return False\n        if num <= 3:  # 2 and 3 are prime numbers.\n            return True\n        if num % 2 == 0 or num % 3 == 0:\n            return False\n        i = 5\n        while i * i <= num:\n            if num % i == 0 or num % (i + 2) == 0:\n                return False\n            i += 6\n        return True\n\n    count = 0\n    a, b = 0, 1  # Initialize Fibonacci sequence (F0, F1)\n\n    while True:\n        # Generate the next Fibonacci number.\n        next_fib = a + b\n        a, b = b, next_fib\n\n        # Check if the generated Fibonacci number is also prime.\n        if _is_prime(next_fib) and _is_fibonacci(next_fib):\n            count += 1\n            if count == n:\n                return next_fib"}
{"task_id": "HumanEval/40", "solution": "def triples_sum_to_zero(l: list):\n    \"\"\"\n    Checks if there are three distinct elements in the list that sum to zero.\n    Uses three nested loops to iterate through all unique combinations of three indices.\n    \"\"\"\n    n = len(l)\n    if n < 3:\n        return False\n\n    for i in range(n - 2):\n        for j in range(i + 1, n - 1):\n            for k in range(j + 1, n):\n                if l[i] + l[j] + l[k] == 0:\n                    return True\n    return False"}
{"task_id": "HumanEval/41", "solution": "def car_race_collision(n: int):\n    \"\"\"\n    Calculates the total number of collisions between two sets of n cars\n    moving in opposite directions. Each car from one set collides with every car from the other set.\n    \"\"\"\n    return n * n"}
{"task_id": "HumanEval/43", "solution": "def pairs_sum_to_zero(l):\n    \"\"\"\n    pairs_sum_to_zero takes a list of integers as an input.\n    it returns True if there are two distinct elements in the list that\n    sum to zero, and False otherwise.\n    >>> pairs_sum_to_zero([1, 3, 5, 0])\n    False\n    >>> pairs_sum_to_zero([1, 3, -2, 1])\n    False\n    >>> pairs_sum_to_zero([1, 2, 3, 7])\n    False\n    >>> pairs_sum_to_zero([2, 4, -5, 3, 5, 7])\n    True\n    >>> pairs_sum_to_zero([1])\n    False\n    \"\"\"\n    if len(l) < 2:\n        return False\n\n    seen_numbers = set()\n    for num in l:\n        complement = -num\n        if complement in seen_numbers:\n            return True\n        seen_numbers.add(num)\n    \n    return False"}
{"task_id": "HumanEval/44", "solution": "def change_base(x: int, base: int):\n    \"\"\"Change numerical base of input number x to base.\n    Returns string representation after the conversion.\n    >>> change_base(8, 3)\n    '22'\n    >>> change_base(8, 2)\n    '1000'\n    >>> change_base(7, 2)\n    '111'\n    \"\"\"\n    if x == 0:\n        return \"0\"\n\n    res = \"\"\n    while x > 0:\n        res = str(x % base) + res\n        x //= base\n    return res"}
{"task_id": "HumanEval/45", "solution": "def triangle_area(a, h):\n    \"\"\"Given length of a side and high return area for a triangle.\n    >>> triangle_area(5, 3)\n    7.5\n    \"\"\"\n    return (a * h) / 2"}
{"task_id": "HumanEval/49", "solution": "def modp(n: int, p: int):\n    \"\"\"Return 2^n modulo p (be aware of numerics).\n    >>> modp(3, 5)\n    3\n    >>> modp(1101, 101)\n    2\n    >>> modp(0, 101)\n    1\n    >>> modp(3, 11)\n    8\n    >>> modp(100, 101)\n    1\n    \"\"\"\n    return pow(2, n, p)"}
{"task_id": "HumanEval/46", "solution": "def fib4(n: int):\n    \"\"\"Computes the n-th element of the Fib4 number sequence iteratively.\"\"\"\n    if n == 0:\n        return 0\n    if n == 1:\n        return 0\n    if n == 2:\n        return 2\n    if n == 3:\n        return 0\n\n    # Initialize a list with the base values for n = 0, 1, 2, 3\n    dp = [0, 0, 2, 0]\n\n    # Calculate subsequent values up to n\n    for i in range(4, n + 1):\n        next_fib = dp[i-1] + dp[i-2] + dp[i-3] + dp[i-4]\n        dp.append(next_fib)\n\n    return dp[n]"}
{"task_id": "HumanEval/48", "solution": "def is_palindrome(text: str) -> bool:\n    \"\"\"\n    Checks if given string is a palindrome.\n    >>> is_palindrome('')\n    True\n    >>> is_palindrome('aba')\n    True\n    >>> is_palindrome('aaaaa')\n    True\n    >>> is_palindrome('zbcd')\n    False\n    \"\"\"\n    if not text:\n        return True\n    return text == text[::-1]"}
{"task_id": "HumanEval/47", "solution": "def median(l: list):\n    \"\"\"Return median of elements in the list l.\n    Sorts the list, determines if length is odd or even,\n    calculates the median, and formats it as int or float.\n    \"\"\"\n    sorted_l = sorted(l)\n    n = len(sorted_l)\n\n    if n % 2 == 1:\n        # Odd number of elements, return the middle element\n        result = sorted_l[n // 2]\n    else:\n        # Even number of elements, return the average of the two middle elements\n        mid1 = sorted_l[n // 2 - 1]\n        mid2 = sorted_l[n // 2]\n        result = (mid1 + mid2) / 2.0\n\n    # Convert to int if the result is a whole number, otherwise keep as float\n    if result == int(result):\n        return int(result)\n    else:\n        return float(result)"}
{"task_id": "HumanEval/50", "solution": "def decode_shift(s: str):\n    \"\"\"\n    Decodes a string encoded with the encode_shift function. Reverses the 5-position shift.\n    \"\"\"\n    return \"\".join([chr(((ord(ch) - 5 - ord(\"a\") + 26) % 26) + ord(\"a\")) for ch in s])"}
{"task_id": "HumanEval/51", "solution": "def remove_vowels(text):\n    \"\"\"\n    remove_vowels is a function that takes string and returns string without vowels.\n    >>> remove_vowels('')\n    ''\n    >>> remove_vowels(\"abcdef\\nghijklm\")\n    'bcdf\\nghjklm'\n    >>> remove_vowels('abcdef')\n    'bcdf'\n    >>> remove_vowels('aaaaa')\n    ''\n    >>> remove_vowels('aaBAA')\n    'B'\n    >>> remove_vowels('zbcd')\n    'zbcd'\n    \"\"\"\n    vowels = set('aeiouAEIOU')\n    result_chars = []\n    for char in text:\n        if char not in vowels:\n            result_chars.append(char)\n    return \"\".join(result_chars)"}
{"task_id": "HumanEval/52", "solution": "def below_threshold(l: list, t: int):\n    \"\"\"Return True if all numbers in the list l are below threshold t.\"\"\"\n    for num in l:\n        if num >= t:\n            return False\n    return True"}
{"task_id": "HumanEval/53", "solution": "def add(x: int, y: int):\n    \"\"\"Add two numbers x and y\n    >>> add(2, 3)\n    5\n    >>> add(5, 7)\n    12\n    \"\"\"\n    return x + y"}
{"task_id": "HumanEval/54", "solution": "def _get_unique_characters(s: str) -> set[str]:\n    \"\"\"\n    Determines the unique set of characters from a given string.\n    Assumes case-sensitive comparison.\n    \"\"\"\n    return set(s)\ndef same_chars(s0: str, s1: str) -> bool:\n    \"\"\"\n    Check if two words have the same characters.\n    >>> same_chars('eabcdzzzz', 'dddzzzzzzzddeddabc')\n    True\n    >>> same_chars('abcd', 'dddddddabc')\n    True\n    >>> same_chars('dddddddabc', 'abcd')\n    True\n    >>> same_chars('eabcd', 'dddddddabc')\n    False\n    >>> same_chars('abcd', 'dddddddabce')\n    False\n    >>> same_chars('eabcdzzzz', 'dddzzzzzzzddddabc')\n    False\n    \"\"\"\n    unique_chars_s0 = _get_unique_characters(s0)\n    unique_chars_s1 = _get_unique_characters(s1)\n    return unique_chars_s0 == unique_chars_s1"}
{"task_id": "HumanEval/56", "solution": "def correct_bracketing(brackets: str):\n    \"\"\" brackets is a string of \"<\" and \">\".\n    return True if every opening bracket has a corresponding closing bracket.\n    \"\"\"\n    balance = 0\n    for char in brackets:\n        if char == '<':\n            balance += 1\n        elif char == '>':\n            balance -= 1\n        \n        # If balance ever drops below zero, a closing bracket appeared without a matching opening bracket.\n        if balance < 0:\n            return False\n            \n    # For correct bracketing, the final balance must be zero.\n    return balance == 0"}
{"task_id": "HumanEval/57", "solution": "def monotonic(l: list):\n    \"\"\"Return True is list elements are monotonically increasing or decreasing.\n    >>> monotonic([1, 2, 4, 20])\n    True\n    >>> monotonic([1, 20, 4, 10])\n    False\n    >>> monotonic([4, 1, 0, -10])\n    True\n    \"\"\"\n    def _is_increasing(l: list) -> bool:\n        \"\"\"Determines if a list is monotonically increasing (non-decreasing).\"\"\"\n        if len(l) <= 1:\n            return True\n        for i in range(len(l) - 1):\n            if l[i] > l[i+1]:\n                return False\n        return True\n\n    def _is_decreasing(l: list) -> bool:\n        \"\"\"Determines if a list is monotonically decreasing (non-increasing).\"\"\"\n        if len(l) <= 1:\n            return True\n        for i in range(len(l) - 1):\n            if l[i] < l[i+1]:\n                return False\n        return True\n\n    return _is_increasing(l) or _is_decreasing(l)"}
{"task_id": "HumanEval/58", "solution": "def common(l1: list, l2: list):\n    \"\"\"Return sorted unique common elements for two lists.\"\"\"\n    set1 = set(l1)\n    set2 = set(l2)\n    common_elements = set1.intersection(set2)\n    return sorted(list(common_elements))"}
{"task_id": "HumanEval/55", "solution": "def fib(n: int):\n    \"\"\"Return n-th Fibonacci number. Assumes n is a positive integer.\"\"\"\n    if n == 1 or n == 2:\n        return 1\n    a, b = 1, 1\n    for _ in range(3, n + 1):\n        a, b = b, a + b\n    return b"}
{"task_id": "HumanEval/60", "solution": "def sum_to_n(n: int):\n    \"\"\"sum_to_n is a function that sums numbers from 1 to n.\n    >>> sum_to_n(30)\n    465\n    >>> sum_to_n(100)\n    5050\n    >>> sum_to_n(5)\n    15\n    >>> sum_to_n(10)\n    55\n    >>> sum_to_n(1)\n    1\n    \"\"\"\n    return n * (n + 1) // 2"}
{"task_id": "HumanEval/61", "solution": "def correct_bracketing(brackets: str):\n    \"\"\" brackets is a string of \"(\" and \")\".\n    return True if every opening bracket has a corresponding closing bracket.\n    \"\"\"\n    counter = 0\n    for char in brackets:\n        if char == '(':\n            counter += 1\n        elif char == ')':\n            counter -= 1\n            if counter < 0:\n                return False\n    return counter == 0"}
{"task_id": "HumanEval/59", "solution": "def largest_prime_factor(n: int):\n    \"\"\"Return the largest prime factor of n. Assume n > 1 and is not a prime.\"\"\"\n    largest_factor = 1\n    d = 2\n\n    # Divide by 2 until n is odd\n    while d * d <= n:\n        if n % d == 0:\n            largest_factor = d\n            n //= d\n        else:\n            d += 1\n\n    # If n is still greater than 1, it must be a prime factor itself\n    if n > 1:\n        largest_factor = n\n\n    return largest_factor"}
{"task_id": "HumanEval/64", "solution": "def vowels_count(s):\n    \"\"\"Write a function vowels_count which takes a string representing\n    a word as input and returns the number of vowels in the string.\n    Vowels in this case are 'a', 'e', 'i', 'o', 'u'. Here, 'y' is also a\n    vowel, but only when it is at the end of the given word.\n\n    Example:\n    >>> vowels_count(\"abcde\")\n    2\n    >>> vowels_count(\"ACEDY\")\n    3\n    \"\"\"\n    count = 0\n    s_lower = s.lower()\n    \n    standard_vowels = {'a', 'e', 'i', 'o', 'u'}\n\n    for char in s_lower:\n        if char in standard_vowels:\n            count += 1\n            \n    if s_lower and s_lower[-1] == 'y':\n        count += 1\n        \n    return count"}
{"task_id": "HumanEval/62", "solution": "def derivative(xs: list):\n    \"\"\" xs represent coefficients of a polynomial.\n    xs[0] + xs[1] * x + xs[2] * x^2 + ....\n     Return derivative of this polynomial in the same form.\n    >>> derivative([3, 1, 2, 4, 5])\n    [1, 4, 12, 20]\n    >>> derivative([1, 2, 3])\n    [2, 6]\n    \"\"\"\n    # The derivative of c * x^n is c * n * x^(n-1).\n    # For a polynomial term xs[i] * x^i, its derivative is (xs[i] * i) * x^(i-1).\n    return [xs[i] * i for i in range(1, len(xs))]"}
{"task_id": "HumanEval/63", "solution": "_memo = {}\ndef fibfib(n: int):\n    \"\"\"Computes the n-th element of the fibfib number sequence using memoization for efficiency.\"\"\"\n    if n in _memo:\n        return _memo[n]\n\n    if n == 0:\n        result = 0\n    elif n == 1:\n        result = 0\n    elif n == 2:\n        result = 1\n    else:\n        result = fibfib(n - 1) + fibfib(n - 2) + fibfib(n - 3)\n\n    _memo[n] = result\n    return result"}
{"task_id": "HumanEval/66", "solution": "def digitSum(s):\n    \"\"\"Calculates the sum of the ASCII codes of all uppercase characters in the input string.\n    Returns 0 if the string is empty or contains no uppercase characters.\n    \"\"\"\n    total_sum = 0\n    for char in s:\n        if char.isupper():\n            total_sum += ord(char)\n    return total_sum"}
{"task_id": "HumanEval/65", "solution": "def circular_shift(x, shift):\n    \"\"\"Circular shift the digits of the integer x, shift the digits right by shift\n    and return the result as a string.\n    If shift > number of digits, return digits reversed.\n    \"\"\"\n    s_x = str(x)\n    n = len(s_x)\n\n    if shift > n:\n        return s_x[::-1]\n    else:\n        # Calculate effective shift\n        effective_shift = shift % n\n        # Perform circular right shift\n        return s_x[n - effective_shift:] + s_x[:n - effective_shift]"}
{"task_id": "HumanEval/67", "solution": "import re\ndef fruit_distribution(s,n):\n    \"\"\"\n    Calculates the number of mango fruits in a basket given a string of apple/orange counts and total fruits.\n    Ensures the mango count is non-negative.\n    \"\"\"\n    # Extract apple and orange counts from the input string\n    match = re.search(r\"(\\d+)\\s*apples.*?(\\d+)\\s*oranges\", s, re.IGNORECASE)\n    \n    # Assuming valid input format based on examples and design context\n    apple_count = int(match.group(1))\n    orange_count = int(match.group(2))\n\n    total_known_fruits = apple_count + orange_count\n    mango_count = n - total_known_fruits\n\n    if mango_count < 0:\n        mango_count = 0 \n\n    return mango_count"}
{"task_id": "HumanEval/70", "solution": "def strange_sort_list(lst):\n    '''\n    Given list of integers, return list in strange order.\n    Strange sorting, is when you start with the minimum value,\n    then maximum of the remaining integers, then minimum and so on.\n    '''\n    if not lst:\n        return []\n\n    # Sort the list once to easily pop min (from start) and max (from end).\n    working_list = sorted(lst)\n    result_list = []\n    is_min_turn = True\n\n    while working_list:\n        if is_min_turn:\n            element_to_add = working_list.pop(0)\n        else:\n            element_to_add = working_list.pop()\n        \n        result_list.append(element_to_add)\n        is_min_turn = not is_min_turn\n\n    return result_list"}
{"task_id": "HumanEval/69", "solution": "def search(lst):\n    '''\n    You are given a non-empty list of positive integers. Return the greatest integer that is greater than \n    zero, and has a frequency greater than or equal to the value of the integer itself. \n    The frequency of an integer is the number of times it appears in the list.\n    If no such a value exist, return -1.\n    Examples:\n        search([4, 1, 2, 2, 3, 1]) == 2\n        search([1, 2, 2, 3, 3, 3, 4, 4, 4]) == 3\n        search([5, 5, 4, 4, 4]) == -1\n    '''\n    def _calculate_frequencies(data_list):\n        '''Computes the frequency of each unique integer in the input list.'''\n        frequency_map = {}\n        for x in data_list:\n            frequency_map[x] = frequency_map.get(x, 0) + 1\n        return frequency_map\n\n    def _find_greatest_qualified_integer(frequency_map):\n        '''Finds the largest integer that satisfies the frequency >= value condition.'''\n        greatest_qualified = -1\n        for integer, frequency in frequency_map.items():\n            if frequency >= integer:\n                greatest_qualified = max(greatest_qualified, integer)\n        return greatest_qualified\n\n    frequency_map = _calculate_frequencies(lst)\n    result_integer = _find_greatest_qualified_integer(frequency_map)\n    return result_integer"}
{"task_id": "HumanEval/68", "solution": "def pluck(arr):\n    \"\"\"\n    Finds the smallest even value in the array and its smallest index.\n    Returns [value, index] or an empty list if no even values or the array is empty.\n    \"\"\"\n    if not arr:\n        return []\n\n    smallest_even_value = float('inf')\n    smallest_even_index = -1\n\n    for index, value in enumerate(arr):\n        # Check if the current value is even.\n        if value % 2 == 0:\n            # If this even value is smaller than the current smallest even value, update.\n            if value < smallest_even_value:\n                smallest_even_value = value\n                smallest_even_index = index\n            # If this even value is equal to the current smallest even value,\n            # no update is needed because `smallest_even_index` already holds the index\n            # of the first occurrence of that value, which is the smallest index.\n\n    # If smallest_even_index is still -1, no even values were found in the array.\n    if smallest_even_index == -1:\n        return []\n    else:\n        return [smallest_even_value, smallest_even_index]"}
{"task_id": "HumanEval/71", "solution": "import math\ndef triangle_area(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle. Return the area of\n    the triangle rounded to 2 decimal points if the three sides form a valid triangle. \n    Otherwise return -1\n    Three sides make a valid triangle when the sum of any two sides is greater \n    than the third side.\n    Example:\n    triangle_area(3, 4, 5) == 6.00\n    triangle_area(1, 2, 10) == -1\n    '''\n    # Check if sides are positive and satisfy the triangle inequality theorem.\n    # A triangle is valid if the sum of any two sides is strictly greater than the third side.\n    if not (a > 0 and b > 0 and c > 0 and\n            a + b > c and\n            a + c > b and\n            b + c > a):\n        return -1\n\n    # Calculate the semi-perimeter\n    s = (a + b + c) / 2\n\n    # Calculate the area using Heron's formula\n    area_squared = s * (s - a) * (s - b) * (s - c)\n\n    # Due to floating point inaccuracies, area_squared might be a very small negative number\n    # for valid (possibly degenerate) triangles. Treat such cases as having zero area.\n    if area_squared < 0:\n        raw_area = 0.0\n    else:\n        raw_area = math.sqrt(area_squared)\n\n    # Round the calculated area to 2 decimal points\n    rounded_area = round(raw_area, 2)\n\n    return rounded_area"}
{"task_id": "HumanEval/73", "solution": "def smallest_change(arr):\n    \"\"\"\n    Calculates the minimum number of elements that need to be changed to make the array palindromic.\n    It iterates from both ends of the array, incrementing a counter for each mismatch.\n    \"\"\"\n    changes_count = 0\n    left_ptr = 0\n    right_ptr = len(arr) - 1\n\n    while left_ptr < right_ptr:\n        if arr[left_ptr] != arr[right_ptr]:\n            changes_count += 1\n        left_ptr += 1\n        right_ptr -= 1\n\n    return changes_count"}
{"task_id": "HumanEval/72", "solution": "def will_it_fly(q,w):\n    \"\"\"\n    Checks if object q will fly based on balance (palindromic list) and weight.\n    Returns True if q is balanced and its sum is less than or equal to w, False otherwise.\n    \"\"\"\n    def _is_palindrome(arr):\n        \"\"\"Checks if a list is a palindrome.\"\"\"\n        return arr == arr[::-1]\n\n    def _calculate_sum(arr):\n        \"\"\"Calculates the sum of elements in a list.\"\"\"\n        return sum(arr)\n\n    is_balanced = _is_palindrome(q)\n    if not is_balanced:\n        return False\n\n    total_weight = _calculate_sum(q)\n    return total_weight <= w"}
{"task_id": "HumanEval/74", "solution": "def total_match(lst1, lst2):\n    '''\n    Compares two lists of strings based on their total character count.\n    Returns the list with fewer total characters, or the first list if counts are equal.\n    '''\n    def _calculate_total_character_count(string_list):\n        '''\n        Calculates the total number of characters across all strings in a list.\n        '''\n        total_count = 0\n        for s in string_list:\n            total_count += len(s)\n        return total_count\n\n    count1 = _calculate_total_character_count(lst1)\n    count2 = _calculate_total_character_count(lst2)\n\n    if count1 <= count2:\n        return lst1\n    else:\n        return lst2"}
{"task_id": "HumanEval/77", "solution": "def iscube(a):\n    \"\"\"\n    Determines if an integer 'a' is a perfect cube.\n    Returns True if 'a' is a perfect cube, False otherwise.\n    \"\"\"\n    if a == 0:\n        return True\n\n    # Calculate the integer cube root, handling negative numbers by using the absolute value.\n    abs_a = abs(a)\n\n    # Use binary search to find the integer cube root, avoiding floating point precision issues.\n    # The initial upper bound for the cube root is optimized.\n    low, high = 0, int(abs_a**(1/3)) + 2\n\n    # Adjust high to ensure the search range is valid, especially for small numbers.\n    if abs_a > 1:\n        high = min(high, abs_a)\n    else:\n        high = max(high, 1)\n\n    while low <= high:\n        mid = (low + high) // 2\n        cube = mid * mid * mid\n\n        if cube == abs_a:\n            return True\n        elif cube < abs_a:\n            low = mid + 1\n        else:\n            high = mid - 1\n\n    return False"}
{"task_id": "HumanEval/75", "solution": "def is_multiply_prime(a):\n    \"\"\"Write a function that returns true if the given number is the multiplication of 3 prime numbers\n    and false otherwise.\n    Knowing that (a) is less then 100. \n    Example:\n    is_multiply_prime(30) == True\n    30 = 2 * 3 * 5\n    \"\"\"\n\n    def _is_prime(n):\n        \"\"\"Checks if a given integer n is a prime number.\"\"\"\n        if n < 2:\n            return False\n        i = 2\n        while i * i <= n:\n            if n % i == 0:\n                return False\n            i += 1\n        return True\n\n    def _get_prime_factors(n):\n        \"\"\"Computes and returns a list of all prime factors of a given integer n, including multiplicity.\"\"\"\n        factors = []\n        temp_n = n\n        d = 2\n        # Iterate through potential divisors up to the square root of temp_n.\n        while d * d <= temp_n:\n            # Check if d is prime before attempting to divide, as indicated by the design.\n            if _is_prime(d):\n                while temp_n % d == 0:\n                    factors.append(d)\n                    temp_n //= d\n            d += 1\n        # If temp_n is still greater than 1, it must be the last remaining prime factor.\n        if temp_n > 1:\n            factors.append(temp_n)\n        return factors\n\n    # As per the requirement \"a is less then 100\" and sequence diagram examples,\n    # handle cases where a is 100 or greater, or less than 2 (cannot be product of 3 primes).\n    if a >= 100 or a < 2:\n        return False\n\n    prime_factors = _get_prime_factors(a)\n    return len(prime_factors) == 3"}
{"task_id": "HumanEval/80", "solution": "def _are_three_chars_distinct(c1, c2, c3):\n    \"\"\"Checks if three given characters are all unique.\"\"\"\n    return c1 != c2 and c1 != c3 and c2 != c3\ndef is_happy(s):\n    \"\"\"You are given a string s.\n    Your task is to check if the string is happy or not.\n    A string is happy if its length is at least 3 and every 3 consecutive letters are distinct\n    For example:\n    is_happy(a) => False\n    is_happy(aa) => False\n    is_happy(abcd) => True\n    is_happy(aabb) => False\n    is_happy(adb) => True\n    is_happy(xyy) => False\n    \"\"\"\n    if len(s) < 3:\n        return False\n\n    for i in range(len(s) - 2):\n        if not _are_three_chars_distinct(s[i], s[i+1], s[i+2]):\n            return False\n            \n    return True"}
{"task_id": "HumanEval/76", "solution": "def is_simple_power(x, n):\n    \"\"\"Checks if a number x is a simple power of n (n**k = x for some integer k).\"\"\"\n\n    # Handle special case: n = 1\n    # 1 raised to any integer power is 1. Thus, x must be 1.\n    if n == 1:\n        return x == 1\n\n    # Handle special case: n = -1\n    # -1 raised to an even integer power is 1, and to an odd power is -1.\n    # Thus, x must be 1 or -1.\n    if n == -1:\n        return x == 1 or x == -1\n\n    # Handle special case: n = 0\n    # 0^k = 0 for positive integer k, and 0^0 = 1 (by convention).\n    # Thus, x must be 0 or 1.\n    if n == 0:\n        return x == 0 or x == 1\n\n    # Handle special case: x = 1 (and n is not 0, 1, or -1, already handled above)\n    # Any non-zero base raised to the power of 0 is 1.\n    if x == 1:\n        return True\n\n    # Handle special case: x = 0 (and n is not 0, already handled above)\n    # If n is non-zero, n^k can never be 0.\n    if x == 0:\n        return False\n\n    # For other cases (x != 0, x != 1, n != 0, n != 1, n != -1):\n    # This implies |n| >= 2 and |x| >= 2.\n    # We can repeatedly divide x by n. If it consistently divides down to 1, then it's a power.\n    temp_x = x\n    while temp_x != 0 and temp_x % n == 0:\n        temp_x //= n\n        if temp_x == 1:\n            return True\n\n    # If the loop finishes and temp_x is not 1, it means x was not a simple power of n.\n    return False"}
{"task_id": "HumanEval/78", "solution": "def hex_key(num):\n    \"\"\"Counts the number of prime hexadecimal digits in a given hexadecimal string.\"\"\"\n\n    def _hex_char_to_decimal(char: str) -> int:\n        \"\"\"Converts a single uppercase hexadecimal character to its decimal integer value.\"\"\"\n        return int(char, 16)\n\n    def _is_prime_hex_digit_value(decimal_value: int) -> bool:\n        \"\"\"Determines if a decimal integer value corresponds to a prime hexadecimal digit (2, 3, 5, 7, 11, 13).\"\"\"\n        prime_hex_values = {2, 3, 5, 7, 11, 13}\n        return decimal_value in prime_hex_values\n\n    if not num:\n        return 0\n\n    prime_count = 0\n    for char in num:\n        decimal_val = _hex_char_to_decimal(char)\n        if _is_prime_hex_digit_value(decimal_val):\n            prime_count += 1\n            \n    return prime_count"}
{"task_id": "HumanEval/79", "solution": "def decimal_to_binary(decimal):\n    \"\"\"Converts a decimal number to a binary string, formatted with 'db' prefix and suffix.\"\"\"\n    binary_representation = bin(decimal)[2:]\n    return \"db\" + binary_representation + \"db\""}
{"task_id": "HumanEval/82", "solution": "def prime_length(string):\n    \"\"\"Write a function that takes a string and returns True if the string\n    length is a prime number or False otherwise\n    Examples\n    prime_length('Hello') == True\n    prime_length('abcdcba') == True\n    prime_length('kittens') == True\n    prime_length('orange') == False\n    \"\"\"\n    def is_prime(n):\n        \"\"\"Checks if a given integer is a prime number.\"\"\"\n        if n < 2:\n            return False\n        i = 2\n        while i * i <= n:\n            if n % i == 0:\n                return False\n            i += 1\n        return True\n\n    length = len(string)\n    return is_prime(length)"}
{"task_id": "HumanEval/84", "solution": "def solve(N):\n    \"\"\"Given a positive integer N, return the total sum of its digits in binary.\n    \n    Example\n        For N = 1000, the sum of digits will be 1 the output should be \"1\".\n        For N = 150, the sum of digits will be 6 the output should be \"110\".\n        For N = 147, the sum of digits will be 12 the output should be \"1100\".\n    \n    Variables:\n        @N integer\n             Constraints: 0 \u2264 N \u2264 10000.\n    Output:\n         a string of binary number\n    \"\"\"\n    # Calculate the sum of the decimal digits of N.\n    sum_of_digits = sum(int(digit) for digit in str(N))\n    \n    # Convert the sum to its binary representation and return as a string, removing the \"0b\" prefix.\n    return bin(sum_of_digits)[2:]"}
{"task_id": "HumanEval/81", "solution": "def numerical_letter_grade(grades):\n    \"\"\"Converts a list of numerical GPAs to a list of letter grades based on a predefined scale.\"\"\"\n\n    _GRADES_SCALE = [\n        {\"exact_gpa\": 4.0, \"letter_grade\": \"A+\"},\n        {\"min_gpa\": 3.7, \"max_gpa\": 4.0, \"letter_grade\": \"A\"},\n        {\"min_gpa\": 3.3, \"max_gpa\": 3.7, \"letter_grade\": \"A-\"},\n        {\"min_gpa\": 3.0, \"max_gpa\": 3.3, \"letter_grade\": \"B+\"},\n        {\"min_gpa\": 2.7, \"max_gpa\": 3.0, \"letter_grade\": \"B\"},\n        {\"min_gpa\": 2.3, \"max_gpa\": 2.7, \"letter_grade\": \"B-\"},\n        {\"min_gpa\": 2.0, \"max_gpa\": 2.3, \"letter_grade\": \"C+\"},\n        {\"min_gpa\": 1.7, \"max_gpa\": 2.0, \"letter_grade\": \"C\"},\n        {\"min_gpa\": 1.3, \"max_gpa\": 1.7, \"letter_grade\": \"C-\"},\n        {\"min_gpa\": 1.0, \"max_gpa\": 1.3, \"letter_grade\": \"D+\"},\n        {\"min_gpa\": 0.7, \"max_gpa\": 1.0, \"letter_grade\": \"D\"},\n        {\"min_gpa\": 0.0, \"max_gpa\": 0.7, \"letter_grade\": \"D-\"},\n        {\"exact_gpa\": 0.0, \"letter_grade\": \"E\"}\n    ]\n\n    def convert_gpa_to_letter_grade(gpa: float) -> str:\n        \"\"\"Converts a single numerical GPA to its corresponding letter grade.\"\"\"\n        for rule in _GRADES_SCALE:\n            if \"exact_gpa\" in rule and gpa == rule[\"exact_gpa\"]:\n                return rule[\"letter_grade\"]\n\n        for rule in _GRADES_SCALE:\n            if \"min_gpa\" in rule and \"max_gpa\" in rule:\n                if rule[\"min_gpa\"] < gpa <= rule[\"max_gpa\"]:\n                    return rule[\"letter_grade\"]\n\n        return \"Invalid GPA\"\n\n    return [convert_gpa_to_letter_grade(gpa) for gpa in grades]"}
{"task_id": "HumanEval/86", "solution": "def anti_shuffle(s):\n    \"\"\"\n    Returns an ordered version of the string where words are replaced by new words with characters arranged in ascending ASCII order.\n    The order of words and blank spaces in the sentence must be preserved.\n    \"\"\"\n    import re\n\n    def _sort_word_characters(word):\n        \"\"\"Sorts the characters of a single word based on their ASCII values.\"\"\"\n        return ''.join(sorted(word))\n\n    # Splits the string by spaces, capturing delimiters to preserve them.\n    # Each captured space sequence (one or more spaces) becomes a token.\n    tokens = re.split(r'(\\s+)', s)\n\n    processed_tokens = []\n    for token in tokens:\n        if token.strip() == '':  # Handles space tokens, which have an empty string after stripping.\n            processed_tokens.append(token)\n        else:  # It's a word token\n            processed_tokens.append(_sort_word_characters(token))\n\n    return ''.join(processed_tokens)"}
{"task_id": "HumanEval/83", "solution": "def starts_one_ends(n):\n    \"\"\"\n    Given a positive integer n, return the count of the numbers of n-digit\n    positive integers that start or end with 1.\n    \"\"\"\n    if n == 1:\n        return 1\n    else:\n        # For n > 1, apply inclusion-exclusion principle:\n        # Count = (Starts with 1) + (Ends with 1) - (Starts and ends with 1)\n        # Starts with 1: 10^(n-1) numbers (first digit is 1, remaining n-1 digits can be 0-9)\n        # Ends with 1: 9 * 10^(n-2) numbers (first digit 1-9, n-2 middle digits 0-9, last is 1)\n        # Starts and ends with 1: 10^(n-2) numbers (first is 1, n-2 middle digits 0-9, last is 1)\n        # Total = 10**(n-1) + (9 * 10**(n-2)) - 10**(n-2)\n        # Total = 10**(n-1) + 8 * 10**(n-2)\n        # Total = 10 * 10**(n-2) + 8 * 10**(n-2)\n        # Total = 18 * 10**(n-2)\n        return 18 * (10**(n - 2))"}
{"task_id": "HumanEval/85", "solution": "def add(lst):\n    \"\"\"Given a non-empty list of integers lst. add the even elements that are at odd indices..\n\n    Examples:\n        add([4, 2, 6, 7]) ==> 2\n    \"\"\"\n    current_sum = 0\n    for index, element_value in enumerate(lst):\n        if index % 2 != 0:  # Check if index is odd\n            if element_value % 2 == 0:  # Check if element value is even\n                current_sum += element_value\n    return current_sum"}
{"task_id": "HumanEval/87", "solution": "def get_row(lst, x):\n    \"\"\"\n    Finds occurrences of x in a nested list and returns their (row, column) coordinates.\n    The coordinates are sorted by row ascending, then by column descending.\n    \"\"\"\n    coordinates = []\n    for row_idx, row in enumerate(lst):\n        for col_idx, item in enumerate(row):\n            if item == x:\n                coordinates.append((row_idx, col_idx))\n\n    # Sort primarily by row in ascending order\n    # Sort secondarily by column in descending order\n    coordinates.sort(key=lambda coord: (coord[0], -coord[1]))\n    return coordinates"}
{"task_id": "HumanEval/88", "solution": "def sort_array(array):\n    \"\"\"\n    Given an array of non-negative integers, return a copy of the given array after sorting,\n    you will sort the given array in ascending order if the sum( first index value, last index value) is odd,\n    or sort it in descending order if the sum( first index value, last index value) is even.\n\n    Note:\n    * don't change the given array.\n    \"\"\"\n    if not array:\n        return []\n\n    if len(array) == 1:\n        return array[:]\n\n    first_element = array[0]\n    last_element = array[-1]\n    sum_first_last = first_element + last_element\n\n    array_copy = array[:]\n\n    if sum_first_last % 2 != 0:\n        array_copy.sort()\n    else:\n        array_copy.sort(reverse=True)\n\n    return array_copy"}
{"task_id": "HumanEval/89", "solution": "def encrypt(s):\n    \"\"\"Create a function encrypt that takes a string as an argument and\n    returns a string encrypted with the alphabet being rotated. \n    The alphabet should be rotated in a manner such that the letters \n    shift down by two multiplied to two places.\n    For example:\n    encrypt('hi') returns 'lm'\n    encrypt('asdfghjkl') returns 'ewhjklnop'\n    encrypt('gf') returns 'kj'\n    encrypt('et') returns 'ix'\n    \"\"\"\n    _ALPHABET = \"abcdefghijklmnopqrstuvwxyz\"\n    _SHIFT = 4\n    encrypted_chars = []\n    for char in s:\n        if 'a' <= char <= 'z':\n            original_pos = _ALPHABET.find(char)\n            new_pos = (original_pos + _SHIFT) % len(_ALPHABET)\n            encrypted_chars.append(_ALPHABET[new_pos])\n        else:\n            encrypted_chars.append(char)\n    return \"\".join(encrypted_chars)"}
