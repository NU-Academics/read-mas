ry.\"\"\"\n        return self.counts\n\n    def to_json_serializable(self) -> Dict[str, int]:\n        \"\"\"Converts tuple keys to string representation for JSON serialization.\n        This is useful for consistent output in CLI tools.\"\"\"\n        return {str(k): v for k, v in self.counts.items()}\nclass ListToTupleConverter:\n    def convert(self, sublist: Iterable[Any]) -> Tuple[Any, ...]:\n        \"\"\"Converts an iterable sublist to an immutable tuple.\n        Raises InvalidInputError if the sublist is not iterable or contains unhashable elements.\"\"\"\n        if not is_iterable(sublist) or isinstance(sublist, (str, bytes)):\n            raise InvalidInputError(\"Each sublist must be an iterable (not string or bytes).\")\n        try:\n            return tuple(sublist)\n        except TypeError as e:\n            raise InvalidInputError(f\"Sublist contains unhashable elements: {e}\") from e\n\n    def convert_many(self, sublists: Iterable[Iterable[Any]]) -> Iterator[Tuple[Any, ...]]:\n        \"\"\"Yields converted tuples for each sublist, applying lazy conversion.\n        This improves memory efficiency for large inputs.\"\"\"\n        for s in sublists:\n            yield self.convert(s)\nclass ListCounterService:\n    def __init__(self, converter: Optional[ListToTupleConverter] = None) -> None:\n        self._converter = converter or ListToTupleConverter()\n\n    def count_sublists(self, lists: Iterable[Iterable[Any]]) -> ListCountResult:\n        \"\"\"Converts sublists to tuples and aggregates their counts.\n        Wraps any conversion errors into InvalidInputError.\"\"\"\n        try:\n            items: Iterator[Tuple[Any,...]] = self._converter.convert_many(lists)\n            counts = self._aggregate(items)\n            return ListCountResult(counts)\n        except InvalidInputError:\n            raise\n        except Exception as exc:\n            raise InvalidInputError(f\"Failed to process sublists: {exc}\") from exc\n\n    def _aggregate(self, items: Iterator[Tuple[Any,...]]) -> Dict[Tuple[Any,...], int]:\n        \"\"\"Efficiently aggregates counts for an iterator of tuples.\n        Uses a dictionary to store and increment counts.\"\"\"\n        counts: Dict[Tuple[Any,...], int] = {}\n        for t in items:\n            counts[t] = counts.get(t, 0) + 1\n        return counts\nclass ListCounterController:\n    def __init__(self, service: Optional[ListCounterService] = None) -> None:\n        self._service = service or ListCounterService()\n\n    def unique_sublists(self, lists: Iterable[Iterable[Any]]) -> Dict[Tuple[Any,...], int]:\n        \"\"\"Validates input, calls the service to count unique sublists, and returns a dictionary.\n        This method serves as the public facade for the counting logic.\"\"\"\n        validate_top_level_input(lists)\n        result = self._service.count_sublists(lists)\n        return result.to_dict()\ndef unique_sublists(lists: list[list[Any]]) -> dict[tuple[Any, ...], int]:\n    \"\"\"Counts unique sublists in a list of lists, returning a dictionary of tuple counts.\n    Every sublist is converted to a tuple, and its occurrences are counted.\"\"\"\n    controller = ListCounterController()\n    return controller.unique_sublists(lists)", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[[[1, 3], [5, 7], [1, 3], [13, 15, 17], [5, 7], [9, 11]]]], "plus_fail_tests": [[[]]]}], "Mbpp/757": [{"task_id": "Mbpp/757", "solution": "def count_reverse_pairs(strings: list[str]) -> int:\n    \"\"\"\n    Counts pairs of reverse strings in the given list.\n    Each unique pair of reverse strings is counted once.\n    \"\"\"\n    unmatched_strings = set()\n    pairs_count = 0\n\n    for s in strings:\n        # Assuming case_sensitive=True as per design context default\n        # and no specific normalization is applied to the input strings themselves.\n        current_s = s \n        reversed_s = current_s[::-1]\n\n        # If the reverse of the current string