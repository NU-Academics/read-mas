tore a(i, k) values.\n        # 'k' represents 'm' for a(i, k).\n        for k in range(i):\n            # Apply recurrence: a(n,m) = (n-m)*a(n-1,m-1) + (m+1)*a(n-1,m)\n            # (m+1)*a(n-1,m) term: (k+1)*a(i-1,k)\n            # a(i-1,k) is dp_row[k]. This is valid if k < i-1 (i.e., m < n-1 in previous row).\n            if k < i - 1:\n                next_dp_row[k] += (k + 1) * dp_row[k]\n\n            # (n-m)*a(n-1,m-1) term: (i-k)*a(i-1,k-1)\n            # a(i-1,k-1) is dp_row[k-1]. This is valid if k-1 >= 0 (i.e., m-1 >= 0 in previous row).\n            if k > 0:\n                next_dp_row[k] += (i - k) * dp_row[k - 1]\n        dp_row = next_dp_row  # The calculated row becomes the previous row for the next iteration.\n\n    # After iterating up to 'n', dp_row contains a(n, k) values.\n    return dp_row[m]", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[0, 0]]}], "Mbpp/109": [{"task_id": "Mbpp/109", "solution": "def odd_Equivalent(s: str, k: int) -> int:\n    \"\"\"\n    Counts the number of odd-valued rotations among the first k left-cyclic rotations of a binary string.\n    A rotation is considered odd if its least significant bit (rightmost character) is '1'.\n    \"\"\"\n    n = len(s)\n    if k == 0:\n        return 0\n\n    # Calculate the number of odd rotations in one full cycle of n rotations.\n    odd_in_full_cycle = 0\n    for i in range(n):\n        # Generate the i-th left cyclic rotation\n        rotated_s = s[i:] + s[:i]\n        # Check if the rotated string represents an odd number (last digit is '1')\n        if rotated_s[-1] == '1':\n            odd_in_full_cycle += 1\n\n    # Calculate how many full cycles are covered by k rotations\n    full_cycles = k // n\n    # Calculate the remaining rotations that do not form a full cycle\n    remainder = k % n\n\n    # Calculate the number of odd rotations in the remainder part\n    odd_in_remainder = 0\n    for i in range(remainder):\n        # Generate the i-th left cyclic rotation for the remainder\n        rotated_s = s[i:] + s[:i]\n        if rotated_s[-1] == '1':\n            odd_in_remainder += 1\n\n    # Total count is (full cycles * odd count per cycle) + odd count in remainder\n    return full_cycles * odd_in_full_cycle + odd_in_remainder", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [["10000100110011", 5]]}], "Mbpp/105": [{"task_id": "Mbpp/105", "solution": "def count(items: list) -> int:\n    \"\"\"Counts the number of True boolean values in the given list.\"\"\"\n    return sum(1 for item in items if item is True)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/104": [{"task_id": "Mbpp/104", "solution": "def sort_sublists(sublists):\n    \"\"\"\n    Sorts each sublist of strings in a given list of lists lexicographically.\n    Each sublist is sorted in ascending order, preserving the top-level order.\n    \"\"\"\n    return [sorted(sublist) for sublist in sublists]", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/108": [{"task_id": "Mbpp/108", "solution": "import uuid\nimport datetime\nfrom typing import Sequence, List, Optional, Any\nclass MergeError(Exception):\n    \"\"\"Exception raised for merge operation errors.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\nMAX_LIST_LENGTH: int = 100000\nclass Validator:\n    \"\"\"Validates input lists according to business rules.\"\"\"\n    def validate_lists(self, l1: Sequence[Any], l2: Sequence[Any], l3: Sequence[Any]) -> None:\n        for idx, l in enumerate((l1, l2, l3), start=1):\n            if not hasattr(l, \"__iter__\"):\n                raise MergeError(f\"list{idx} is not iterable\")\n            if len(l) > MAX_LIST_LENGTH:\n                raise MergeError(f\"list{idx} exceeds max length {MAX_LIST_LENGTH}\")\n            for i, item in enumerate(l):\n                if not isinstance(item, int):\n                    raise MergeError(f\"list{idx}[{i}] is not int\")\nclass Sorter:\n    \"\"\"Provides sorting and merging algorithms.\"\"\"\n    def merge_and_sort(self, l1: Sequence[int], l2: Sequence[int], l3: Sequence[int]) -> List[int]:\n        \"\"\"Merges three lists and returns a single sorted list.\"\"\"\n        return sorted(list(l1) + list(l2) + list(l3))\nclass MergeResult:\n    \"\"\"Data transfer object for merge operation results.\"\"\"\n    def __init__(self, result: List[int], record_id: Optional[str] = None) -> None:\n        self.result = result\n        self.record_id = record_id\nclass MergeCacheRepository:\n    \"\"\"In-memory repository for storing merge operation records.\"\"\"\n    def __init__(self):\n        self._store: dict[str, dict[str, Any]] = {}\n\n    def save(self, inputs: List[List[int]], result: List[int]) -> str:\n        \"\"\"Saves a merge record and returns its ID.\"\"\"\n        record_id = str(uuid.uuid4())\n        rec = {\"id\": record_id, \"inputs\": inputs, \"result\": result, \"created_at\": datetime.datetime.utcnow().isoformat()}\n        self._store[record_id] = rec\n        return record_id\n\n    def get(self, record_id: str) -> Optional[dict[str, Any]]:\n        \"\"\"Retrieves a merge record by its ID.\"\"\"\n        return self._store.get(record_id)\n\n    def all(self) -> List[dict[str, Any]]:\n        \"\"\"Returns all stored merge records.\"\"\"\n        return list(self._store.values())\nclass MergeService:\n    \"\"\"Orchestrates validation, sorting, and persistence of merge operations.\"\"\"\n    def __init__(self, repository: MergeCacheRepository, sorter: Sorter, validator: Validator = None):\n        self._repo = repository\n        self._sorter = sorter\n        self._validator = validator or Validator()\n\n    def merge(self, list1: Sequence[int], list2: Sequence[int], list3: Sequence[int]) -> MergeResult:\n        \"\"\"Performs the merge operation including validation and persistence.\"\"\"\n        self._validator.validate_lists(list1, list2, list3)\n        sorted_list = self._sorter.merge_and_sort(list1, list2, list3)\n        record_id = None\n        try:\n            record_id = self._repo.save([list(list1), list(list2), list(list3)], sorted_list)\n        except Exception:\n            # Persistence is best-effort, log the error but do not re-raise\n            pass # In a real app, this would log to a logger\n        return MergeResult(result=sorted_list, record_id=record_id)\nclass MergeController:\n    \"\"\"Handles requests for merging lists and delegates to the service.\"\"\"\n    def __init__(self, service: MergeService):\n        self.service = service\n\n    def handle_merge(self, list1: Sequence[int], list2: Sequence[int], list3: Sequence[int]) -> List[int]:\n        \"\"\"Calls the merge service and returns the sorted list result.\"\"\"\n        result = self.service.merge(list1, list2, list3)\n        return result.result\n_repo = MergeCacheRepository()\n_sorter = Sorter()\n_validator = Validator()\n_service = MergeService(repository=_repo, sorter=_sorter, validator=_validator)\n_controller = MergeController(service=_service)\ndef merge_sorted_list(list1: Sequence[int], list2: Sequence[int], list3: Sequence[int]) -> List[int]:\n    \"\"\"\n    Merges three input lists into a single sorted list, preserving duplicates.\n    Delegates to an internal controller for validation, merging, and persistence.\n    \"\"\"\n    return _controller.handle_merge(list1, list2, list3)", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[[1.5, 2.5, 3.5, 4.5, 5.5], [0.5, 1.5, 2.5, 3.5, 4.5], [-5.5, -4.5, -3.5, -2.5, -1.5]]]}], "Mbpp/113": [{"task_id": "Mbpp/113", "solution": "import re\ndef check_integer(text: str) -> bool:\n    \"\"\"Checks if a string represents an integer, ignoring leading/trailing whitespace.\"\"\"\n    trimmed_text = text.stri