ing operations and measures performance.\"\"\"\n    def __init__(self, sorter: Sorter) -> None:\n        self.sorter = sorter\n\n    def sort(self, values: List[int]) -> SortedResult:\n        start = time.perf_counter()\n        sorted_list = self.sorter.sort(values)\n        duration_ms = (time.perf_counter() - start) * 1000.0\n        result = SortedResult(original=list(values), sorted=sorted_list, duration_ms=duration_ms)\n        return result\ndef shell_sort(values: List[int]) -> List[int]:\n    \"\"\"Sorts a list of integers using the Shell Sort algorithm.\n    It assumes the input is a valid list of integers.\n    \"\"\"\n    sorter = ShellSorter()\n    service = SortService(sorter)\n    result = service.sort(values)\n    return result.sorted", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/429": [{"task_id": "Mbpp/429", "solution": "def and_tuples(a: tuple[int, ...], b: tuple[int, ...]) -> tuple[int, ...]:\n    \"\"\"\n    Computes the element-wise bitwise AND of two input tuples.\n    Assumes inputs are valid tuples of integers and have equal length.\n    \"\"\"\n    return tuple(x & y for x, y in zip(a, b))", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/427": [{"task_id": "Mbpp/427", "solution": "import re\nfrom datetime import datetime\ndef change_date_format(date_str: str) -> str:\n    \"\"\"\n    Converts a date string from 'YYYY-MM-DD' format to 'DD-MM-YYYY' format.\n    Ensures robust validation and consistent error handling using a modular design.\n    \"\"\"\n    class DateFormatError(ValueError):\n        \"\"\"Custom exception for date format or value errors.\"\"\"\n        def __init__(self, message: str):\n            super().__init__(message)\n            self.message = message\n\n        def __str__(self) -> str:\n            return self.message\n\n    class DateInput:\n        \"\"\"Data Transfer Object for validated date components.\"