per().__init__(message)\nclass InputValidator:\n    \"\"\"Validates input parameters for ludic number generation.\"\"\"\n    MIN_N = 1\n\n    def validate_n(self, value: Any) -> int:\n        \"\"\"Coerces input value to an integer and validates its range.\"\"\"\n        try:\n            n = int(value)\n        except (TypeError, ValueError):\n            raise InvalidInputError(f\"n must be an integer, got: {value!r}\")\n        if n < self.MIN_N:\n            return 0 if n < 1 else n\n        return n\nclass LudicRepository:\n    \"\"\"Manages persistent caching of ludic number results in a JSON file.\"\"\"\n    DEFAULT_CACHE_FILE = \"cache/ludic_cache.json\"\n    CACHE_VERSION = 1\n\n    def __init__(self, cache_path: Optional[Path] = None):\n        \"\"\"Initializes the repository with a cache file path.\"\"\"\n        self.cache_path = cache_path or Path(self.DEFAULT_CACHE_FILE)\n        self.cache_path.parent.mkdir(parents=True, exist_ok=True)\n\n    def _read_cache_file(self) -> Dict[str, Any]:\n        \"\"\"Reads the cache file, handling non-existence and corruption.\"\"\"\n        if not self.cache_path.exists():\n            return {\"version\": self.CACHE_VERSION, \"entries\": {}}\n        try:\n            with self.cache_path.open(\"r\", encoding=\"utf-8\") as f:\n                data = json.load(f)\n            if data.get(\"version\") != self.CACHE_VERSION:\n                return {\"version\": self.CACHE_VERSION, \"entries\": {}}\n            return data\n        except json.JSONDecodeError:\n            return {\"version\": self.CACHE_VERSION, \"entries\": {}}\n        except Exception as e:\n            raise CacheError(f\"Error reading cache file: {e}\")\n\n    def _write_cache_file(self, data: Dict[str, Any]) -> None:\n        \"\"\"Writes data to the cache file.\"\"\"\n        try:\n            with self.cache_path.open(\"w\", encoding=\"utf-8\") as f:\n                json.dump(data, f, ensure_ascii=False, indent=2)\n        except Exception as e:\n            raise CacheError(f\"Error writing to cache file: {e}\")\n\n    def load(self, n: int) -> Optional[LudicResult]:\n        \"\"\"Loads a cached LudicResult for the given integer n.\"\"\"\n        try:\n            data = self._read_cache_file()\n            entries = data.get(\"entries\", {})\n            entry = entries.get(str(n))\n            if entry:\n                return LudicResult.from_dict(entry)\n            return None\n        except CacheError:\n            raise\n        except Exception as e:\n            raise CacheError(f\"Failed to load ludic numbers for {n}: {e}\")\n\n    def save(self, result: LudicResult) -> None:\n        \"\"\"Saves a LudicResult to the cache file.\"\"\"\n        try:\n            data = self._read_cache_file()\n            data.setdefault(\"entries\", {})[str(result.n)] = result.to_dict()\n            self._write_cache_file(data)\n        except CacheError:\n            raise\n        except Exception as e:\n            raise CacheError(f\"Failed to save ludic numbers for {result.n}: {e}\")\n    \n    def clear_cache(self) -> None:\n        \"\"\"Removes the cache file from the filesystem.\"\"\"\n        if self.cache_path.exists():\n            try:\n                self.cache_path.unlink()\n            except Exception as e:\n                raise CacheError(f\"Failed to clear cache file: {e}\")\nclass LudicGenerator:\n    \"\"\"Generates ludic numbers using a sieve algorithm and orchestrates caching.\"\"\"\n    def __init__(self, repo: LudicRepository):\n        \"\"\"Initializes the generator with a LudicRepository for caching.\"\"\"\n        self._repo = repo\n\n    def generate(self, n: int, use_cache: bool = True) -> LudicResult:\n        \"\"\"Generates ludic numbers up to n, utilizing the cache if enabled.\"\"\"\n        if n < 1:\n            return LudicResult(n=n, numbers=[], ts=datetime.utcnow().isoformat() + \"Z\")\n        \n        if use_cache:\n            try:\n                cached = s