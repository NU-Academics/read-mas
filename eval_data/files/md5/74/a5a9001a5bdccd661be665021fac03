        self.metadata: Dict = metadata or {}\nclass ListValidator:\n    \"\"\"Validates top-level input and determines if items are list-like.\"\"\"\n    def __init__(self, config: Config = DEFAULT_CONFIG) -> None:\n        self.config = config\n\n    def validate_top_level_is_sequence(self, obj: Any) -> list:\n        \"\"\"Ensures the top-level object is a list or a configurable tuple, returning it as a list.\"\"\"\n        if isinstance(obj, list):\n            return obj\n        if isinstance(obj, tuple) and self.config.treat_tuples_as_lists:\n            return list(obj)\n        raise InvalidInputError(\"Input must be a list or a tuple representing a sequence of items.\")\n\n    def is_list_like(self, item: Any) -> bool:\n        \"\"\"Checks if an item is considered list-like based on configuration.\"\"\"\n        if isinstance(item, list):\n            return True\n        if isinstance(item, tuple) and self.config.treat_tuples_as_lists:\n            return True\n        return False\nclass ListRepository:\n    \"\"\"Normalizes raw input (Python object or JSON string) into a ListCollection.\"\"\"\n    def __init__(self, config: Config = DEFAULT_CONFIG) -> None:\n        self.config = config\n        self.validator = ListValidator(config=config)\n\n    def normalize(self, input_data: Any) -> ListCollection:\n        \"\"\"Converts input data, potentially a JSON string, into a ListCollection.\"\"\"\n        parsed_obj = input_data\n        metadata = {'source_type': type(input_data).__name__}\n\n        if isinstance(input_data, str):\n            try:\n                parsed_obj = json.loads(input_data)\n                metadata['source_type'] = 'json_string'\n            except json.JSONDecodeError as e:\n                raise InvalidInputError(f\"Invalid JSON string provided: {e}\")\n\n        validated_list = self.validator.validate_top_level_is_sequence(parsed_obj)\n        return ListCollection(items=validated_list, metadata=metadata)\nclass ListCounterService:\n    \"\"\"Provides the core logic for counting list-like items.\"\"\"\n    def __init__(self, validator: ListValidator) -> None:\n        self.validator = validator\n\n    def count_sublists(self, collection: ListCollection) -> int:\n        \"\"\"Counts the number of list-like items within the given ListCollection.\"\"\"\n        return sum(1 for item in collection.items if self.validator.is_list_like(item))\nclass ListController:\n    \"\"\"A facade for the public API, orchestrating input normalization and counting.\"\"\"\n    def __init__(self, service: ListCounterService, repository: ListRepository) -> None:\n        self.service = service\n        self.repository = repository\n\n    def count_list(self, input_data: Any) -> int:\n        \"\"\"Processes input data to count list-like elements.\"\"\"\n        collection = self.repository.normalize(input_data)\n        return self.service.count_sublists(collection)\ndef count_list(lists: Any) -> int:\n    \"\"\"\n    Counts the number of lists in a given number of lists.\n    The function uses a layered architecture for input validation and counting.\n    \"\"\"\n    repo = ListRepository(config=DEFAULT_CONFIG)\n    validator = ListValidator(config=DEFAULT_CONFIG)\n    service = ListCounterService(validator=validator)\n    controller = ListController(service=service, repository=repo)\n    return controller.count_list(lists)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/255": [{"task_id": "Mbpp/255", "solution": "import itertools\nfrom typing import List, Tuple, Any\ndef combinations_colors(input_list: List[Any], n: int) -> List[Tuple[Any, ...]]:\n    \"\"\"\n    Generates all combinations (with repetition) of the elements of the list for a given length n.\n    Returns a list with a tuple for each combination.\n    \"\"\"\n    if n == 0:\n        return [()]\n    return list(itertools.product(input_list, repeat=n))", "base_status": "fail", "plus_statu