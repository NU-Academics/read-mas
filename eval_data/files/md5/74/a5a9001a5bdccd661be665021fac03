     self.logger.error(msg)\ndef is_hashable(obj: Any) -> bool:\n    \"\"\"Checks if an object is hashable.\"\"\"\n    try:\n        hash(obj)\n        return True\n    except TypeError:\n        return False\nclass AllUniqueService:\n    \"\"\"Provides the core algorithm to check for uniqueness in a sequence.\"\"\"\n    def __init__(self, logger: LoggerAdapter | None = None) -> None:\n        self.logger = logger or LoggerAdapter()\n\n    def all_unique(self, items: Sequence[Any]) -> bool:\n        \"\"\"Determines if all elements in the sequence are unique, using optimized methods.\"\"\"\n        arr: List[Any] = list(items)\n        self.logger.debug(f\"Checking uniqueness for {len(arr)} items.\")\n        if self._all_hashable(arr):\n            return self._unique_with_set(arr)\n        return self._unique_by_comparison(arr)\n\n    def _all_hashable(self, items: List[Any]) -> bool:\n        \"\"\"Checks if all elements in the list are hashable.\"\"\"\n        return all(is_hashable(x) for x in items)\n\n    def _unique_with_set(self, items: List[Any]) -> bool:\n        \"\"\"Checks for uniqueness using a set (O(n) for hashable items).\"\"\"\n        seen = set()\n        for x in items:\n            if x in seen:\n                self.logger.debug(f\"Duplicate found (hashable): {x!r}\")\n                return False\n            seen.add(x)\n        return True\n\n    def _unique_by_comparison(self, items: List[Any]) -> bool:\n        \"\"\"Checks for uniqueness using pairwise comparison (O(n^2) for unhashable items).\"\"\"\n        n = len(items)\n        for i in range(n):\n            for j in range(i + 1, n):\n                if items[i] == items[j]:\n                    self.logger.debug(f\"Duplicate found (comparison): {items[i]!r} == {items[j]!r}\")\n                    return False\n        return True\ndef all_unique(list: Sequence[Any]) -> bool:\n    \"\"\"\n    Checks if all elements in the given list-like sequence are unique.\n    Uses an optimized 