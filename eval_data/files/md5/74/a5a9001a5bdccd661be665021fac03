):\n            raise InvalidInputError(\"Top-level input must be list/tuple or iterable\", value)\nclass FlattenService:\n    def __init__(self) -> None:\n        self.list_adapter = ListAdapter()\n        self.iter_adapter = IterableAdapter()\n        self.validator = InputValidator()\n\n    def flatten(self, value: Any) -> List[Any]:\n        \"\"\"\n        Flattens a nested list-like structure into a single list.\n        Performs input validation and cycle detection.\n        \"\"\"\n        self.validator.validate(value)\n\n        seen_ids: Set[int] = set()\n        result: List[Any] = []\n        for item in self._iterative_flatten(value, seen_ids):\n            result.append(item)\n        return result\n\n    def _iterative_flatten(self, value: Any, seen_ids: Set[int]) -> Iterator[Any]:\n        stack = [value]\n        while stack:\n            cur = stack.pop()\n\n            is_container_list_like = self.list_adapter.is_list_like(cur)\n            is_container_iterable = self.iter_adapter.is_iterable(cur)\n\n            if is_container_list_like or is_container_iterable:\n                if id(cur) in seen_ids:\n                    raise InvalidInputError(\"Cycle detected\", cur)\n                seen_ids.add(id(cur))\n\n                # Push elements onto the stack in reverse order to maintain left-to-right processing.\n                if is_container_list_like:\n                    for elem in reversed(list(self.list_adapter.to_iter(cur))):\n                        stack.append(elem)\n                else: # Must be is_container_iterable\n                    for elem in reversed(list(self.iter_adapter.to_iter(cur))):\n                        stack.append(elem)\n            else:\n                yield cur\n_service = FlattenService()\ndef flatten_list(value: object) -> list:\n    \"\"\"\n    Flattens a given nested list structure.\n    \"\"\"\n    return _service.flatten(value)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "