ror(\"start and end must be integers\")\n        if not isinstance(req.numbers, (list, tuple)):\n            raise InvalidRangeError(\"numbers must be a list or tuple\")\n        n = len(req.numbers)\n        if n == 0:\n            raise InvalidRangeError(\"numbers must not be empty\")\n        if req.start < 0 or req.end < 0 or req.start > req.end or req.end >= n:\n            raise InvalidRangeError(f\"invalid range: start={req.start}, end={req.end}, len={n}\")\n        for i, v in enumerate(req.numbers):\n            if not isinstance(v, self.ALLOWED_NUMERIC_TYPES):\n                raise InvalidElementError(f\"element at index {i} is not numeric: {v}\")\nclass SumService:\n    def __init__(self, repository: ListRepository) -> None:\n        self._repository = repository\n\n    def sum_range(self, numbers: Sequence[float], start: int, end: int) -> float:\n        # Computes the sum of a sub-list obtained from the repository.\n        sub = self._repository.get_slice(numbers, start, end)\n        total = sum(sub)\n        return float(total)\nclass SumController:\n    def __init__(self, service: SumService, validator: RangeValidator) -> None:\n        self._service = service\n        self._validator = validator\n\n    def handle_request(self, req: RangeRequest) -> SumResult:\n        # Orchestrates validation and sum calculation for a given request.\n        self._validator.validate(req)\n        total = self._service.sum_range(req.numbers, req.start, req.end)\n        return SumResult(total)\ndef sum_range_list(numbers: list, start: int, end: int) -> float:\n    \"\"\"\n    Finds the sum of numbers in a list within a specified inclusive range.\n    \"\"\"\n    req = RangeRequest(numbers=numbers, start=start, end=end)\n    validator = RangeValidator()\n    repository = ListRepository()\n    service = SumService(repository)\n    controller = SumController(service=service, validator=validator)\n    result = controller.handle_request(req)\n    return result.total", 