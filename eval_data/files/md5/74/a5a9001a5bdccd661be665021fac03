lace heap[0].\n            if entry > max_heap_for_k_smallest[0]:\n                heapq.heapreplace(max_heap_for_k_smallest, entry)\n\n    # The heap now contains the k records with the smallest values (or fewer if len(records) < k).\n    # To get the final result sorted correctly by value and then original index:\n    # Sort the heap elements. The key (-x[0], -x[1]) translates to (value, original_index)\n    # in ascending order, providing the desired stable sort.\n    result = [\n        item[2]\n        for item in sorted(max_heap_for_k_smallest, key=lambda x: (-x[0], -x[1]))\n    ]\n\n    return result", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[[["John", 20]], -1]]}], "Mbpp/759": [{"task_id": "Mbpp/759", "solution": "import re\ndef is_decimal(value: str, precision: int = 2, mode: str = \"exact\") -> bool:\n    # Checks if the string represents a decimal number with specified precision and mode.\n    # Returns False if precision is negative or mode is invalid.\n    \n    if precision < 0:\n        return False\n\n    if mode not in (\"exact\", \"max\"):\n        return False\n\n    decimal_sep = \".\" # As per design context, fixed decimal separator\n\n    if precision == 0:\n        # If precision is 0, only whole numbers are considered valid.\n        pattern_str = r'^\\d+$'\n    else:\n        if mode == \"exact\":\n            # Requires exactly `precision` digits after the decimal point.\n            pattern_str = rf'^\\d+{re.escape(decimal_sep)}\\d{{{precision}}}$'\n        else:  # mode == \"max\"\n            # Allows up to `precision` digits after an optional decimal point.\n            pattern_str = rf'^\\d+(?:{re.escape(decimal_sep)}\\d{{1,{precision}}})?$'\n\n    compiled_pattern = re.compile(pattern_str)\n    return bool(compiled_pattern.match(value))", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [["123"]]}], "Mbpp/760": [{"task_id": "Mbpp/760", "solution": 