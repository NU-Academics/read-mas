", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/440": [{"task_id": "Mbpp/440", "solution": "import re\nfrom typing import Any, Dict, List, Optional, Protocol, Tuple\nfrom dataclasses import dataclass\ndef find_adverb_position(sentence: str) -> Tuple[int, int, str]:\n    \"\"\"\n    Finds the first adverb and its positions in a given sentence,\n    returning (start_index, end_index, adverb_text) or (-1, -1, \"\") if not found.\n    \"\"\"\n    if not isinstance(sentence, str):\n        raise TypeError(\"Input 'sentence' must be a string.\")\n\n    # 1. Models: AdverbMatch\n    @dataclass\n    class AdverbMatch:\n        start: int\n        end: int\n        text: str\n\n        def to_tuple(self) -> Tuple[int, int, str]:\n            return (self.start, self.end, self.text)\n\n    # 2. Errors: AdapterInitializationError\n    class AdapterInitializationError(Exception):\n        \"\"\"Raised when an NLP adapter (e.g., spaCy) cannot be initialized.\"\"\"\n        pass\n\n    # 3. Adapters: NLPAdapter Protocol\n    class NLPAdapter(Protocol):\n        def tokenize_and_tag(self, text: str) -> List[Dict[str, Any]]:\n            ...\n\n    # 4. Repositories: AdverbPatternsRepository\n    class AdverbPatternsRepository:\n        DEFAULT_PATTERNS = [r\".*ly$\", r\"^(quick|well|fast)$\"]\n\n        def __init__(self, patterns: Optional[List[str]] = None):\n            self.adverb_regexes: List[re.Pattern] = []\n            if patterns is None:\n                patterns = self.default_patterns()\n            for p in patterns:\n                self.adverb_regexes.append(re.compile(p, re.IGNORECASE))\n\n        def default_patterns(self) -> List[str]:\n            return self.DEFAULT_PATTERNS\n\n        def match_adverb(self, token: str) -> bool:\n            for regex in self.adverb_regexes:\n                if regex.match(token):\n                    return True\n            return False\n\n    # 5. Utils: TextNormalizer\n    class TextNormalizer:\n        def normalize(self, text: str) -> Tuple[str, List[Tuple[int, int]]]:\n            \"\"\"\n            Normalizes text by collapsing multiple internal whitespaces to single spaces.\n            Preserves leading/trailing spaces for accurate index mapping.\n            Returns the normalized string and a character-level index map.\n            `index_map[i]` provides the (original_start, original_end) tuple for\n            the character at `normalized_text[i]`.\n            \"\"\"\n            normalized_chars = []\n            char_original_span_map: List[Tuple[int, int]] = []\n\n            is_previous_char_whitespace = False\n            \n            for i, char in enumerate(text):\n                if char.isspace():\n                    if not is_previous_char_whitespace:\n                        normalized_chars.append(' ')\n                        char_original_span_map.append((i, i + 1)) \n                    is_previous_char_whitespace = True\n                else:\n                    normalized_chars.append(char)\n                    char_original_span_map.append((i, i + 1))\n                    is_previous_char_whitespace = False\n            \n            normalized_text = \"\".join(normalized_chars)\n            return normalized_text, char_original_span_map\n\n        def map_token_span_to_original(self, token_span: Tuple[int, int], index_map: List[Tuple[int, int]]) -> Tuple[int, int]:\n            \"\"\"\n            Maps a token span (start, end) from a normalized string to the original string\n            using a character-level index map.\n            `index_map[i]` is (original_start_char_idx, original_end_char_idx) for `normalized_text[i]`.\n            \"\"\"\n            norm_start, norm_end = token_span\n\n            if not index_map or norm_start < 0 or norm_start >= norm_end or norm_end > len(index_map):\n                return -1, -1\n\n            original_start = index_map[norm_start][0]\n            original_end = index_map[norm_end - 1][1]\n\n            return original_start, original_end\n\n    # 6. Adapters: HeuristicNLPAdapter\n    class HeuristicNLPAdapter:\n        def __init__(self, patterns_repo: AdverbPatternsRepository):\n            self.patterns_repo = patterns_repo\n\n        def tokenize_and_tag(self, text: str) -> List[Dict[str, Any]]:\n            tokens_data = []\n            for match in re.finditer(r\"\\S+\", text):\n                token_text = match.group(0)\n                start = match.start()\n                end = match.end()\n                # Cleaned token for matching (lowercase and stripped punctuation)\n                cleaned_token_text = token_text.strip(\".,!?:;\\\"'\").lower()\n                pos = \"ADV\" if self.patterns_repo.match_adverb(cleaned_token_text) else \"OTHER\"\n                tokens_data.append({\"text\": token_text, \"start\": start, \"end\": end, \"pos\": pos})\n            return tokens_data\n\n    # 7. Adapters: SpacyNLPAdapter\n    class SpacyNLPAdapter:\n        DEFAULT_SPACY_MODEL = \"en_core_web_sm\"\n\n        def __init__(self, model_name: str = DEFAULT_SPACY_MODEL):\n            self.model_name = model_name\n            self.nlp: Optional[Any] = None\n            self._load_model() \n\n        def _load_model(self) -> None:\n            \"\"\"Loads the spaCy model, raising AdapterInitializationError on failure.\"\"\"\n            try:\n                import spacy\n                self.nlp = spacy.load(self.model_name)\n            except ImportError:\n                raise AdapterInitializationError(f\"spaCy library not found. Please install with `pip install spacy`.\")\n            except OSError:\n                raise AdapterInitializationError(f\"spaCy model '{self.model_name}' not found. Run `python -m spacy download {self.model_name}`.\")\n            except Exception as e:\n                raise AdapterInitializationError(f\"Failed to initialize spaCy: {e}\")\n\n        def tokenize_and_tag(self, text: str) -> List[Dict[str, Any]]:\n            \"\"\"Tokenizes text and assigns POS tags using spaCy.\"\"\"\n            if self.nlp is None:\n                raise AdapterInitializationError(\"spaCy model is not loaded (unexpected error after init).\")\n            \n            doc = self.nlp(text)\n            tokens_data = []\n            for token in doc:\n                tokens_data.append({\n                    \"text\": token.text,\n                    \"start\": token.idx,\n                    \"end\": token.idx + len(token.text),\n                    \"pos\": token.pos_\n                })\n            return tokens_data\n\n    # 8. Services: AdverbDetector\n    class AdverbDetector:\n        def __init__(self, adapter: NLPAdapter, patterns_repo: AdverbPatternsRepository, normalizer: TextNormalizer):\n            self.adapter = adapter\n            self.patterns_repo = patterns_repo\n            self.normalizer = normalizer\n\n        def find_first_adverb(self, sentence: str) -> AdverbMatch:\n            \"\"\"\n            Finds the first adverb in the sentence, returning its original span and text.\n            Returns AdverbMatch(-1, -1, \"\") if no adverb is found.\n            \"\"\"\n            normalized_text, index_map = self.normalizer.normalize(sentence)\n            \n            tokens = self.adapter.tokenize_and_tag(normalized_text)\n            \n            for tok in tokens:\n                token_text_raw = tok[\"text\"] \n                token_text_stripped_lower = token_text_raw.strip(\".,!?:;\\\"'\").lower()\n                token_text_stripped_case = token_text_raw.strip(\".,!?:;\\\"'\")\n                \n                is_adverb = False\n                if tok.get(\"pos\") == \"ADV\":\n                    is_adverb = True\n                elif self.patterns_repo.match_adverb(token_text_stripped_lower):\n                    is_adverb = True\n                \n                if is_adverb:\n                    # Map the span of the raw token back to the original string.\n                    orig_start_raw_token, orig_end_raw_token = self.normalizer.map_token_span_to_original(\n                        (tok[\"start\"], tok[\"end\"]), index_map\n                    )\n                    \n                    # Calculate the start and end for the *stripped* version within the original string.\n                    leading_punct_len = 0\n                    for char in token_text_raw:\n                        if char in \".,!?:;\\\"'\": # Characters to consider as leading punctuation\n                            leading_punct_len += 1\n                        else:\n                            break\n                    \n                    original_start_stripped = orig_start_raw_token + leading_punct_len\n                    original_end_stripped = original_start_stripped + len(token_text_stripped_case)\n\n                    return AdverbMatch(original_start_stripped, original_end_stripped, token_text_stripped_case)\n            return AdverbMatch(-1, -1, \"\")\n    \n    # Main function logic (top-level orchestration)\n    patterns_repo = AdverbPatternsRepository()\n    normalizer = TextNormalizer()\n    \n    detector_adapter: NLPAdapter\n    try:\n        # Attempt to use SpacyNLPAdapter first. Its __init__ performs eager loading.\n        detector_adapter = SpacyNLPAdapter() \n    except AdapterInitializationError:\n        # If spaCy or its model fails to initialize, fall back to HeuristicNLPAdapter.\n        detector_adapter = HeuristicNLPAdapter(patterns_repo)\n\n    detector = AdverbDetector(\n        adapter=detector_adapter,\n        patterns_repo=patterns_repo,\n        normalizer=normalizer\n    )\n\n    result_match = detector.find_first_adverb(sentence)\n    return result_match.to_tuple()", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [["flew"]]}], "Mbpp/301": [{"task_id": "Mbpp/301", "solution": "def dict_depth(d: dict) -> int:\n    \"\"\"\n    Calculates the maximum nesting depth of a dictionary.\n    The top-level dictionary itself has a depth of 1.\n    \"\"\"\n    max_current_depth = 1\n\n    for value in d.values():\n        if isinstance(value, dict):\n            # Recursively find the depth of the nested dictionary\n            # and add 1 for the current level.\n            depth_through_child = 1 + dict_depth(value)\n            if depth_through_child > max_current_depth:\n                max_current_depth = depth_through_child\n\n    return max_current_depth", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/451": [{"task_id": "Mbpp/451", "solution": "def remove_whitespaces(text: str) -> str:\n    \"\"\"Removes all whitespace characters from the given string.\"\"\"\n    return ''.join(ch for ch in text if not ch.isspace())", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [["\n\t"]]}], "Mbpp/450": [{"task_id": "Mbpp/450", "solution": "def extract_string(strings, size):\n    \"\"\"\n    Extracts strings of a specified length from a list of strings.\n    Returns a new list containing only strings whose length equals the given size.\n    \"\"\"\n    return [s for s in strings if len(s) == size]", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/453": [{"task_id": "Mbpp/453", "solution": "import math\ndef sumofFactors(n: int) -> int:\n    \"\"\"Calculates the sum of even positive factors of a number.\n    Handles n=0 or negative n by using its absolute value and returning 0 for 0.\"\"\"\n    if n == 0:\n        return 0\n\n    num = abs(n)\n    even_factors = set()\n    \n    # Iterate from 1 up to the square root of num to find factors\n    limit = int(math.isqrt(num))\n    for i in range(1, limit + 1):\n        if num % i == 0:\n            # i is a factor\n            if i % 2 == 0:\n                even_factors.add(i)\n            \n            # num // i is also