(self, result: DigitDistanceResult) -> None:\n        ...\n\n    def list_all(self) -> list[DigitDistanceResult]:\n        ...\nclass DigitDistanceCalculator:\n    \"\"\"Calculates the per-digit differences and their sum between two integers.\"\"\"\n    def __init__(self, repo: Optional[HistoryRepository] = None, max_digits: int = MAX_DIGITS, pad_direction: str = DEFAULT_PAD_DIRECTION):\n        \"\"\"Initializes the calculator with an optional repository and configuration.\"\"\"\n        self._repo = repo\n        self._max_digits = max_digits\n        self._pad_direction = pad_direction\n\n    def compute(self, a: int, b: int) -> DigitDistanceResult:\n        \"\"\"Computes the full DigitDistanceResult for two integers.\"\"\"\n        self._validate_inputs(a, b)\n        da = InputNormalizer.normalize_to_digits(a)\n        db = InputNormalizer.normalize_to_digits(b)\n        da_p, db_p = InputNormalizer.pad_digits(da, db, self._pad_direction)\n        diffs = [abs(x - y) for x, y in zip(da_p, db_p)]\n        \n        timestamp = datetime.datetime.utcnow().isoformat()\n        \n        result = DigitDistanceResult(\n            a=a, b=b, digits_a=da_p, digits_b=db_p,\n            per_digit_diffs=diffs, sum_diff=sum(diffs),\n            pad_direction=self._pad_direction, timestamp=timestamp\n        )\n        if self._repo:\n            self._repo.save(result)\n        return result\n\n    def compute_sum(self, a: int, b: int) -> int:\n        \"\"\"Returns only the sum of per-digit differences for two integers.\"\"\"\n        return self.compute(a, b).sum_diff\n\n    def _validate_inputs(self, a: int, b: int) -> None:\n        \"\"\"Validates that inputs are integers and do not exceed max_digits.\"\"\"\n        if not isinstance(a, int) or not isinstance(b, int):\n            raise InvalidInputError(\"Inputs must be integers\")\n        max_len = max(len(InputNormalizer.normalize_to_digits(a)), len(InputNormalizer.normalize_to_digits(b)))\n        if max_len > s