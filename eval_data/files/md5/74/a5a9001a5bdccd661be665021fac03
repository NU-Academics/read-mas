not None else self.MAX_SUBLISTS\n        self._max_total_elements = max_total_elements if max_total_elements is not None else self.MAX_TOTAL_ELEMENTS\n\n    def ensure_hashable(self, item: Any) -> Any:\n        try:\n            hash(item)\n            return item\n        except TypeError:\n            if isinstance(item, list):\n                return tuple(self.ensure_hashable(x) for x in item)\n            if isinstance(item, dict):\n                return frozenset((self.ensure_hashable(k), self.ensure_hashable(v)) for k, v in item.items())\n            raise InvalidInputError(f\"Unhashable and unconvertible item: {item!r}\")\n\n    def validate_nested_lists(self, lists: Iterable[Iterable[Any]]) -> List[List[Any]]:\n        \"\"\"Validates the input structure and converts elements to hashable types.\"\"\"\n        if not isinstance(lists, Iterable):\n            raise InvalidInputError(\"Input must be an iterable of iterables.\")\n        \n        normalized_lists = []\n        total_elements = 0\n        \n        for i, sub_list_iterable in enumerate(lists):\n            if i >= self._max_sublists:\n                raise InvalidInputError(f\"Input exceeds maximum allowed sub-lists ({self._max_sublists}).\")\n\n            if not isinstance(sub_list_iterable, Iterable):\n                raise InvalidInputError(f\"Sub-list at index {i} is not an iterable.\")\n            \n            normalized_sub_list = []\n            for item in sub_list_iterable:\n                if total_elements >= self._max_total_elements:\n                    raise InvalidInputError(f\"Input exceeds maximum allowed total elements ({self._max_total_elements}).\")\n                normalized_sub_list.append(self.ensure_hashable(item))\n                total_elements += 1\n            normalized_lists.append(normalized_sub_list)\n        \n        return normalized_lists\nclass CommonElementsService:\n    def __init__(self, validator: Validator) -> None:\n        self._validator = validator\n\n    def find_common_elements(self, lists: Iterable[Iterable[Any]]) -> List[Any]:\n        \"\"\"Finds elements common to all nested lists after validating and normalizing input.\"\"\"\n        normalized = self._validator.validate_nested_lists(lists)\n        if not normalized:\n            return []\n        \n        it = iter(normalized)\n        common_elements_set = set(next(it))\n        \n        for sub_list in it:\n            common_elements_set &= set(sub_list)\n            if not common_elements_set:\n                break\n                \n        return list(common_elements_set)\nclass ListRepository:\n    def from_json_file(self, file_path: str) -> NestedListsInput:\n        \"\"\"Loads nested lists from a JSON file.\"\"\"\n        try:\n            with open(file_path, 'r') as f:\n                data = json.load(f)\n            if not isinstance(data, list) or not all(isinstance(x, list) for x in data):\n                raise InvalidInputError(\"JSON file must contain a list of lists.\")\n            return NestedListsInput(data)\n        except FileNotFoundError:\n            raise InvalidInputError(f\"File not found: {file_path}\")\n        except json.JSONDecodeError:\n            raise InvalidInputError(f\"Invalid JSON in file: {file_path}\")\n        except Exception as e:\n            raise InvalidInputError(f\"Error reading JSON file: {e}\")\n\n    def from_inline(self, lists_literal: Any) -> NestedListsInput:\n        \"\"\"Loads nested lists from an inline literal.\"\"\"\n        if not isinstance(lists_literal, list) or not all(isinstance(x, list) for x in lists_literal):\n            raise InvalidInputError(\"Inline literal must be a list of lists.\")\n        return NestedListsInput(lists_literal)\nclass CommonElementsController:\n    def __init__(self, service: CommonElementsService, repo: ListRepository) -> None:\n        self._service = service\n        self._repo = repo\n\n    def common_in_nested_lists(self, lists: Iterable