)", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[true]]}], "Mbpp/247": [{"task_id": "Mbpp/247", "solution": "import re\nimport datetime\nfrom dataclasses import dataclass\nfrom typing import Optional\ndef normalize_string(s: str) -> str:\n    \"\"\"Removes non-alphanumeric characters and converts to lowercase.\"\"\"\n    if not isinstance(s, str):\n        raise TypeError(\"Input must be a string.\")\n    return re.sub(r'[^0-9a-zA-Z]+', '', s).lower()\nclass Config:\n    \"\"\"Configuration for LPS computation.\"\"\"\n    def __init__(self, normalize: bool = True, use_cache: bool = True) -> None:\n        self.normalize_default = normalize\n        self.use_cache_default = use_cache\nclass InMemoryCacheRepository:\n    \"\"\"In-memory cache for LPS results.\"\"\"\n    def __init__(self) -> None:\n        self._cache: dict[str, LPSResult] = {}\n\n    def get(self, key: str) -> Optional[LPSResult]:\n        \"\"\"Retrieves a cached result.\"\"\"\n        return self._cache.get(key)\n\n    def set(self, key: str, value: LPSResult) -> None:\n        \"\"\"Stores a result in the cache.\"\"\"\n        self._cache[key] = value\n\n    def clear(self) -> None:\n        \"\"\"Clears the entire cache.\"\"\"\n        self._cache.clear()\nclass LPSService:\n    \"\"\"Provides the core LPS computation algorithm.\"\"\"\n    def compute_lps(self, s: str) -> int:\n        \"\"\"Computes the length of the LPS for a given string.\"\"\"\n        if not isinstance(s, str):\n            raise TypeError(\"Input must be a string.\")\n        return self.compute_lps_dp(s)\n\n    def compute_lps_dp(self, s: str) -> int:\n        \"\"\"Implements the O(n^2) dynamic programming algorithm for LPS.\"\"\"\n        n = len(s)\n        if n == 0:\n            return 0\n        dp = [[0] * n for _ in range(n)]\n        for i in range(n - 1, -1, -1):\n            dp[i][i] = 1\n            for j in range(i + 1, n):\n                if s[i] == s[j]:\n                    dp[i][j] = dp[i+1][j-1] + 2 if j > i + 1 else 2\n                else:\n                    dp[i][j] = max(dp[i+1][j], dp[i][j-1])\n        return dp[0][n-1]\nclass LPSController:\n    \"\"\"Orchestrates normalization, caching, and algorithm invocation.\"\"\"\n    def __init__(self, service: LPSService, repo: InMemoryCacheRepository | None = None, config: Config | None = None) -> None:\n        self.service = service\n        self.repo = repo\n        self.config = config or Config()\n\n    def lps_result(self, s: str, normalize: bool | None = None, use_cache: bool | None = None) -> LPSResult:\n        \"\"\"Computes the LPS length and returns a detailed result object.\"\"\"\n        if not isinstance(s, str):\n            raise TypeError(\"Input 's' must be a string.\")\n        \n        effective_normalize = self.config.normalize_default if normalize is None else normalize\n        effective_use_cache = self.config.use_cache_default if use_cache is None else use_cache\n\n        normalized_s = normalize_string(s) if effective_normalize else s\n        \n        if effective_use_cache and self.repo:\n            cached = self.repo.get(normalized_s)\n            if cached:\n                return cached\n\n        length = self.service.compute_lps(normalized_s)\n        result = LPSResult(input_str=s, normalized_str=normalized_s, length=length, computed_at=datetime.datetime.utcnow(), algorithm=\"dp\")\n        \n        if effective_use_cache and self.repo:\n            self.repo.set(normalized_s, result)\n        return result\n\n    def lps(self, s: str, normalize: bool | None = None, use_cache: bool | None = None) -> int:\n        \"\"\"Computes and returns the length of the longest palindromic subsequence.\"\"\"\n        return self.lps_result(s, normalize=normalize, use_cache=use_cache).length\n_default_service = LPSService()\n_default_repo = InMemoryCacheRepository()\n_default_config = Config()\n_default_controller = LPSController(service=_default_service, repo=_default_repo, config=_default_config)\ndef lps(s: str, normalize: bool = None, use_cache: bool = None) -> int:\n    \"\"\"\n    Finds the length of the longest palindromic subsequence in the given string.\n    By default, the input string is normalized (alphanumeric only, lowercase) and results are cached.\n    \"\"\"\n    return _default_controller.lps(s, normalize=normalize, use_cache=use_cache)", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/257": [{"task_id": "Mbpp/257", "solution": "def swap_numbers(a, b):\n    \"\"\"Returns a tuple with the second number and then the first number.\"\"\"\n    return (b, a)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/266": [{"task_id": "Mbpp/266", "solution": "def lateralsurface_cube(side: float) -> float:\n    \"\"\"\n    Calculates the lateral surface area of a cube given its side length.\n    The lateral surface area is the area of its four side faces.\n    \"\"\"\n    return 4 * side * side", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/252": [{"task_id": "Mbpp/252", "solution": "import math\ndef convert(z):\n    \"\"\"Converts a complex number, numeric, or sequence input to polar coordinates (radius, angle).\"\"\"\n    \n    real_part = 0.0\n    imag_part = 0.0\n\n    try:\n        # Attempt to coerce the input to a complex number.\n        # This handles int, float, and complex inputs directly.\n        c = complex(z)\n        real_part = c.real\n        imag_part = c.imag\n    except TypeError:\n        # If complex(z) fails (e.g., z is a tuple or list),\n        # treat z as a sequence (real, imag) and attempt to extract and convert elements.\n        # This relies on the input having at least two indexable, float-convertible elements.\n        real_part = float(z[0])\n        imag_part = float(z[1])\n    \n    # Calculate radius (magnitude