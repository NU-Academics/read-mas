e(y, (int, float))):\n            raise PolarRectError(\"x and y must be numeric.\")\n        if math.isnan(x) or math.isinf(x) or math.isnan(y) or math.isinf(y):\n            raise PolarRectError(\"x and y cannot be NaN or infinity.\")\n        self.x = float(x)\n        self.y = float(y)\n\n    def to_complex(self) -> complex:\n        \"\"\"Returns complex(x, y).\"\"\"\n        return complex(self.x, self.y)\n\n    def to_tuple(self) -> tuple[float, float]:\n        \"\"\"Returns (x, y).\"\"\"\n        return (self.x, self.y)\n\n    def __repr__(self) -> str:\n        return f\"Rectangular(x={self.x}, y={self.y})\"\nPI = math.pi\nTWO_PI = 2 * math.pi\ndef _safe_float(value: any) -> float:\n    \"\"\"Coerces value to float or raises PolarRectError.\"\"\"\n    try:\n        f_val = float(value)\n        if math.isnan(f_val) or math.isinf(f_val):\n            raise ValueError(\"Value cannot be NaN or infinity.\")\n        return f_val\n    except (TypeError, ValueError) as e:\n        raise PolarRectError(f\"Invalid numeric input: {value}. Must be a finite number.\") from e\ndef normalize_angle(theta: float, style: str = 'signed') -> float:\n    \"\"\"Normalizes an angle to either (-pi, pi] or [0, 2pi).\"\"\"\n    theta = math.fmod(theta, TWO_PI)\n    if style == 'signed':\n        if theta > PI:\n            theta -= TWO_PI\n        elif theta <= -PI:\n            theta += TWO_PI\n    elif style == 'unsigned':\n        if theta < 0:\n            theta += TWO_PI\n    else:\n        raise PolarRectError(\"Invalid normalization style. Use 'signed' or 'unsigned'.\")\n    return theta\nclass PolarConverter:\n    \"\"\"Encapsulates conversion algorithms and angle normalization.\"\"\"\n    def __init__(self, normalize_to: str = 'signed') -> None:\n        if normalize_to not in ['signed', 'unsigned']:\n            raise PolarRectError(\"normalize_to must be 'signed' or 'unsigned'.\")\n        self._normalize_to = normalize_to\n\n    def polar_to_rectangular(self, r: float, theta: float) -> Rectangular:\n        \"\"\"Converts polar coordinates (r, theta) to rectangular (x, y).\"\"\"\n        r_f = _safe_float(r)\n        theta_f = _safe_float(theta)\n        x = r_f * math.cos(theta_f)\n        y = r_f * math.sin(theta_f)\n        return Rectangular(x, y)\n\n    def rectangular_to_polar(self, x: float, y: float) -> Polar:\n        \"\"\"Converts rectangular coordinates (x, y) to polar (r, theta).\"\"\"\n        x_f = _safe_float(x)\n        y_f = _safe_float(y)\n        r = math.hypot(x_f, y_f)\n        theta = math.atan2(y_f, x_f)\n        normalized_theta = self.normalize_angle(theta)\n        return Polar(r, normalized_theta)\n\n    def normalize_angle(self, theta: float) -> float:\n        \"\"\"Normalizes an angle using the configured style.\"\"\"\n        return normalize_angle(theta, style=self._normalize_to)\nclass PolarController:\n    \"\"\"Provides convenience API, auto-detection and CLI helper.\"\"\"\n    def __init__(self, converter: PolarConverter | None = None) -> None:\n        self.converter = converter if converter is not None else PolarConverter()\n\n    def polar_rect(self, a: float, b: float, input_type: str = 'auto') -> tuple[Polar, complex]:\n        \"\"\"\n        Convenience function to convert between polar and rectangular coordinates,\n        returning both representations.\n        \"\"\"\n        _a = _safe_float(a)\n        _b = _safe_float(b)\n\n        if input_type == 'polar':\n            # a is r, b is theta\n            r, theta = _a, _b\n            rect = self.converter.polar_to_rectangular(r, theta)\n            polar_coords = Polar(r, self.converter.normalize_angle(theta))\n            return (polar_coords, rect.to_complex())\n        elif input_type == 'rectangular':\n            # a is x, b is y\n            x, y = _a, _b\n            polar_coords = self.converter.rectangular_to_polar(x, y)\n            return (polar_coords, complex(x, y))\n        elif input_type == 'auto':\n            #