elf, items: list[str]) -> None:\n            \"\"\"Initializes NumericStringList by stripping whitespace from items.\"\"\"\n            self.items: list[str] = [s.strip() for s in items]\n\n    # --- Inline Configuration Constant ---\n    MAX_INPUT_SIZE = 10000\n\n    # --- Inline Validator Class ---\n    class NumericStringValidator:\n        def __init__(self, max_size: int = MAX_INPUT_SIZE) -> None:\n            \"\"\"Initializes the validator with a maximum allowed list size.\"\"\"\n            self.max_size = max_size\n\n        def validate(self, items: list[str]) -> None:\n            \"\"\"Validates the input list and each item's format.\"\"\"\n            if not isinstance(items, list):\n                raise ValidationError(\"items must be a list\")\n            if len(items) == 0:\n                raise ValidationError(\"input list must not be empty\")\n            if len(items) > self.max_size:\n                raise ValidationError(f\"input list too large; max size is {self.max_size}\")\n            for i, it in enumerate(items):\n                self._validate_item(it, i)\n\n        def _validate_item(self, item: str, index: int) -> None:\n            \"\"\"Checks if a single string item is a valid numeric string.\"\"\"\n            if not isinstance(item, str):\n                raise ValidationError(f\"item at index {index} must be a string\", index)\n            if not item: # Checks for empty string after stripping\n                raise ValidationError(\"empty string element is invalid\", index)\n            \n            # Checks for optional leading sign (+ or -) followed by one or more digits.\n            if not re.fullmatch(r\"^[+-]?\\d+$\", item):\n                raise ValidationError(f\"invalid numeric string '{item}'\", index)\n\n    # --- Inline Parser Class ---\n    class NumericStringParser:\n        def __init__(self) -> None:\n            \"\"\"Initializes the parser.\"\"\"\n            pass\n\n        def parse(self, item: str, index: int) -> int:\n            \"\"\"Attempts to convert a string item to an integer.\"\"\"\n            try:\n                return int(item)\n            except ValueError:\n                raise ParseError(item, index)\n\n    # --- Inline Service Class ---\n    class SortService:\n        def __init__(self, validator: 'NumericStringValidator', parser: 'NumericStringParser') -> None:\n            \"\"\"Initializes the SortService with validator and parser dependencies.\"\"\"\n            self.validator = validator\n            self.parser = parser\n\n        def sort(self, items: list[str]) -> list[int]:\n            \"\"\"Validates, parses, and numerically sorts a list of numeric strings.\"\"\"\n            self.validator.validate(items)\n            parsed = [self.parser.parse(it, idx) for idx, it in enumerate(items)]\n            parsed.sort()\n            return parsed\n\n    # --- Inline Controller Class ---\n    class SortController:\n        def __init__(self, service: 'SortService') -> None:\n            \"\"\"Initializes the SortController with a SortService dependency.\"\"\"\n            self.service = service\n\n        def sort_numeric_strings(self, items: list[str]) -> list[int]:\n            \"\"\"Normalizes input and delegates to the SortService for sorting.\"\"\"\n            dto = NumericStringList(items)\n            return self.service.sort(dto.items)\n\n    # --- Main Function Logic ---\n    # Instantiate dependencies\n    validator = NumericStringValidator()\n    parser = NumericStringParser()\n    service = SortService(validator, parser)\n    controller = SortController(service)\n\n    # Call the controller's main method and return the result\n    return controller.sort_numeric_strings(strings)", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[[]]]}], "Mbpp/752": [{"task_id": "Mbpp/752", "solution": "def jacobsthal_num(n):\n    \"\"\"\n    Calculates the nth Jacobsthal number using an iterative method.\