e InvalidInputError(f\"Sublist at index {idx} is not iterable.\")\n            if len(list(sub)) == 0:\n                raise EmptySublistError(idx, f\"Sublist at index {idx} is empty.\")\nclass ExtractorService:\n    \"\"\"Core business logic for extracting first elements.\"\"\"\n    def __init__(self, validator: ListValidator) -> None:\n        self.validator = validator\n\n    def extract_first_elements(self, request: ExtractRequest) -> ExtractResponse:\n        \"\"\"Validates input and extracts the first element from each sublist.\"\"\"\n        items = request.items\n        self.validator.validate(items)\n        result: List[Any] = []\n        for idx, sub in enumerate(items):\n            try:\n                first = Utils.safe_get_first(sub)\n            except IndexError:\n                raise EmptySublistError(idx, f\"Sublist at index {idx} is empty.\")\n            result.append(first)\n        return ExtractResponse(result)\ndef Extract(items):\n    \"\"\"\n    Public fa\u00e7ade function: Extract(items: List[List[Any]]) -> List[Any]\n    Returns a list containing the first element of each sublist in the input.\n    \"\"\"\n    request = ExtractRequest(items)\n    service = ExtractorService(ListValidator())\n    response = service.extract_first_elements(request)\n    return response.items", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/468": [{"task_id": "Mbpp/468", "solution": "def max_product(arr: list[int]) -> int:\n    \"\"\"\n    Finds the maximum product formed by multiplying numbers of a strictly increasing subsequence.\n    The algorithm uses dynamic programming with O(n^2) time complexity and O(n) space.\n    \"\"\"\n    n = len(arr)\n    if n == 0:\n        return 0\n\n    # dp[i] stores the maximum product of a strictly increasing subsequence ending with arr[i].\n    # Each element arr[i] itself is an increasing subsequence of length 1, so initialize dp[i] = arr[i].\n    dp = list(arr)\