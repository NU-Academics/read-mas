ence can be completed.\n        for x in range(min_val, min(m, max_possible_x) + 1):\n            # Recursively count sequences for the rest of the elements.\n            # The next element must be at least 2*x.\n            total_sequences += _count_from(2 * x, remaining - 1)\n\n        memo[(min_val, remaining)] = total_sequences\n        return total_sequences\n\n    # The first element of the sequence must be a positive integer, so its minimum allowed value is 1.\n    return _count_from(1, n)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/244": [{"task_id": "Mbpp/244", "solution": "import math\ndef next_Perfect_Square(n: int) -> int:\n    \"\"\"\n    Finds the smallest perfect square strictly greater than the given number.\n    Handles negative inputs by returning 0 if it's the next perfect square.\n    \"\"\"\n    if n < 0:\n        # The smallest perfect square is 0. If n is negative, 0 is the smallest\n        # perfect square strictly greater than n.\n        return 0\n    else:\n        # For non-negative n, find its integer square root.\n        # The next perfect square will be the square of (its integer square root + 1).\n        s = math.isqrt(n)\n        return (s + 1) ** 2", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[3.14]]}], "Mbpp/238": [{"task_id": "Mbpp/238", "solution": "def number_of_substrings(s: str) -> int:\n    \"\"\"\n    Counts the number of non-empty substrings of a given string using the formula n*(n+1)/2.\n    \"\"\"\n    n = len(s)\n    return n * (n + 1) // 2", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/250": [{"task_id": "Mbpp/250", "solution": "def count_X(input_tuple: tuple, element: object) -> int:\n    \"\"\"Counts the occurrences of an element in a tuple.\"\"\"\n    count = 0\n    for item in input_tuple:\n        if item == element:\n            count += 1\n    return count", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/253": [{"task_id": "Mbpp/253", "solution": "def count_integer(items):\n    \"\"\"\n    Counts the number of integer elements in a given list, excluding booleans.\n    \"\"\"\n    count = 0\n    for item in items:\n        if isinstance(item, int) and not isinstance(item, bool):\n            count += 1\n    return count", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/245": [{"task_id": "Mbpp/245", "solution": "def max_sum(numbers: list[int]) -> int:\n    \"\"\"\n    Calculates the maximum sum of a bitonic subsequence in the given array.\n    A bitonic subsequence is first increasing and then decreasing.\n    \"\"\"\n    if not numbers:\n        return 0\n\n    n = len(numbers)\n\n    # Calculate LIS (Longest Increasing Subsequence) sum ending at each index\n    lis_sums = [0] * n\n    for i in range(n):\n        lis_sums[i] = numbers[i]\n        for j in range(i):\n            if numbers[j] < numbers[i]:\n                lis_sums[i] = max(lis_sums[i], lis_sums[j] + numbers[i])\n\n    # Calculate LDS (Longest Decreasing Subsequence) sum starting at each index\n    lds_sums = [0] * n\n    for i in range(n - 1, -1, -1):\n        lds_sums[i] = numbers[i]\n        for j in range(n - 1, i, -1):\n            if numbers[j] < numbers[i]:\n                lds_sums[i] = max(lds_sums[i], lds_sums[j] + numbers[i])\n\n    # Combine LIS and LDS sums to find the maximum bitonic subsequence sum.\n    # The peak element numbers[i] is counted in both LIS and LDS sums, so subtract it once.\n    return max(lis_sums[i] + lds_sums[i] - numbers[i] for i in range(n))", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/251": [{"task_id": "Mbpp/251", "solution": "from typing import Any\ndef insert_element(items: list[Any], element: Any) -> list[Any]:\n    \"\"\"Inserts an element before each item in a list, returning a new list.\n    The original list is not modified.\n    \"\"\"\n    result = []\n    for item in items:\n        result.append(element)\n        result.append(item)\n    return result", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/85": [{"task_id": "Mbpp/85", "solution": "import math\nimport json\nimport logging\nfrom pathlib import Path\nfrom datetime import datetime\nfrom typing import Any, Optional\n_logger = logging.getLogger(__name__)\nclass InvalidRadiusError(ValueError):\n    \"\"\"Custom exception for invalid radius inputs.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\nclass ValidationUtils:\n    \"\"\"Utility class for validating sphere radius inputs.\"\"\"\n    @staticmethod\n    def validate_radius(value: Any) -> float:\n        try:\n            r = float(value)\n        except (TypeError, ValueError):\n            raise InvalidRadiusError(f\"Radius must be a number, got: {value!r}\")\n        if not math.isfinite(r):\n            raise InvalidRadiusError(\"Radius must be finite.\")\n        if r < 0:\n            raise InvalidRadiusError(\"Radius must be non-negative.\")\n        return r\nclass SurfaceAreaCalculator:\n    \"\"\"Calculates the surface area of a sphere.\"\"\"\n    def compute_area(self, radius: float) -> float:\n        return 4.0 * math.pi * (radius ** 2)\nDEFAULT_CACHE_DIR = Path(\"~/.cache/sphere_area\").expanduser()\nDEFAULT_CACHE_FILENAME = \"cache.json\"\nclass CacheRepository:\n    \"\"\"Manages a simple JSON file-based cache for sphere surface areas.\"\"\"\n    def __init__(self, cache_path: Optional[Path] = None) -> None:\n        self.cache_path = (cache_path or DEFAULT_CACHE_DIR / DEFAULT_CACHE_FILENAME)\n        self.cache_path.parent.mkdir(parents=True, exist_ok=True)\n        self.data = self._load()\n\n    def get(self, radius_key: str) -> Optional[float]:\n        entry = self.data.get(radius_key)\n        return float(entry.get(\"area\")) if entry and \"area\" in entry else None\n\n    def set(self, radius_key: str, area: float) -> None:\n        self.data[radius_key] = {\"radius\": float(radius_key), \"area\": float(area), \"computed_at\": datetime.utcnow().isoformat() + \"Z\"}\n        self._save(self.data)\n\n    def _load(self) -> dict:\n        \"\"\"Loads cache data from the JSON file.\"\"\"\n        try:\n            if self.cache_path.exists():\n                return json.loads(self.cache_path.read_text())\n        except Exception as e:\n            _logger.warning(\"Failed to load cache from %s: %s\", self.cache_path, e)\n        return {}\n\n    def _save(self, data: dict) -> None:\n        \"\"\"Saves cache data to the JSON file atomically.\"\"\"\n        try:\n            tmp_path = self.cache_path.with_suffix(\".tmp\")\n            tmp_path.write_text(json.dumps(data, indent=2))\n            tmp_path.rename(self.cache_path)\n        except Exception as e:\n            _logger.warning(\"Failed to save cache to %s: %s\", self.cache_path, e)\nclass APIController:\n    \"\"\"Orchestrates validation, computation, and caching for the surface area API.\"\"\"\n    def __init__(self, calculator: SurfaceAreaCalculator, cache: Optional[CacheRepository] = None) -> None:\n        self.calculator = calculator\n        self.cache = cache\n\n    def surfacearea_sphere(self, radius: Any) -> float:\n        \"\"\"Calculates the surface area of a sphere, using cache if available.\"\"\"\n        r = ValidationUtils.validate_radius(radius)\n        key = repr(float(r)) # Use repr for consistent key generation\n\n        if self.cache:\n            cached = self.cache.get(key)\n            if cached is not None:\n                return float(cached) # Ensure float type from cache\n\n        area = self.calculator.compute_area(r)\n\n        if self.cache:\n            try:\n                self.cache.set(key, area)\n            except Exception as e:\n                _logger.warning(\"Failed to update cache for radius %s: %s\", key, e)\n        return area\n_default_calculator = SurfaceAreaCalculator()\n_default_cache = CacheRepository()\n_default_controller = APIController(_default_calculator, _default_cache)\ndef surfacearea_sphere(radius: float) -> float:\n    \"\"\"Calculates the surface area of a sphere given its radius.\"\"\"\n    return _default_controller.surfacearea_sphere(radius)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/106": [{"task_id": "Mbpp/106", "solution": "from typing import Any, Iterable, Tuple, Optional\ndef add_lists(list_items: list, base_tuple: tuple) -> tuple:\n    \"\"\"Appends elements of a list to a tuple, returning a new tuple.\n\n    This function defines all necessary helper classes inline to satisfy\n    the constraint of not calling external helpers.\n    \"\"\"\n\n    class InvalidInputError(Exception):\n        \"\"\"Exception raised for invalid input parameters.\"\"\"\n        def __init__(self, message: str) -> None:\n            super().__init__(message)\n            self.message = message\n\n    class AppendError(Exception):\n        \"\"\"Exception raised for errors during the append operation.\"\"\"\n        def __init__(self, message: str) -> None:\n            super().__init__(message)\n            self.message = message\n\n    class AppendRequest:\n        \"\"\"Data Transfer Object for an append request.\"\"\"\n        def __init__(self, list_items: list[Any], base_tuple: Tuple[Any, ...]) -> None:\n            self.list_items = list_items\n            self.base_tuple = base_tuple\n\n        def validate(self) -> None:\n            \"\"\"Validates that base_tuple is a tuple and list_items is a list.\"\"\"\n            if not isinstance(self.base_tuple, tuple):\n                raise InvalidInputError(\"base_tuple must be a tuple\")\n            if not isinstance(self.list_items, list):\n                raise InvalidInputError(\"list_items must be a list\")\n\n    class ListToTupleAdapter:\n        \"\"\"Adapter for converting iterables to tuples with safeguards.\"\"\"\n        DEFAULT_MAX_LEN = 100_000\n\n        def convert(self, list_items: Iterable[Any]) -> Tuple[Any, ...]:\n            \"\"\"Converts an iterable to a tuple, checking for type and size.\"\"\"\n            try:\n                lst = list(list_items)\n            except TypeError:\n                raise InvalidInputError(\"list_items not iterable\")\n            if len(lst) > self.DEFAULT_MAX_LEN:\n                raise AppendError(\"list_items too large\")\n            return tuple(lst)\n\n        def safe_convert(self, list_items: Any) -> Tuple[Any, ...]:\n            \"\"\"Converts input to a tuple, handling None values gracefully.\"\"\"\n            if list_items is None:\n                return tuple()\n            return self.convert(list_items)\n\n    class TupleRepository:\n        \"\"\"Optional repository for logging append operations.\"\"\"\n        def __init__(self, file_path: str) -> None:\n            self._file_path = file_path\n\n        def log_operation(self, base_tuple: Tuple[Any, ...], list_items: list[Any], result: Tuple[Any, ...]) -> None:\n            \"\"\"Logs an operation (implementation omitted for inline context).\"\"\"\n            pass # Logging is optional and not active when repository=None.\n\n    class AddListService:\n        \"\"\"Core business logic for appending list items to a tuple.\"\"\"\n        def __init__(self, adapter: ListToTupleAdapter, repository: Optional[TupleRepository] = None) -> None:\n            self.adapter = adapter\n            self.repository = repository\n\n        def add(self, request: AppendRequest) -> Tuple[Any, ...]:\n            \"\"\"Executes the append operation, including validation and optional logging.\"\"\"\n            request.validate()\n            converted = self.adapter.safe_convert(request.list_items)\n  