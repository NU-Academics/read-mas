ror: {self.message}\"\nclass TupleUtils:\n    \"\"\"Utility methods for tuple string processing.\"\"\"\n    @staticmethod\n    def tokenize_bracketed_tuple(tuple_str: str) -> list[str]:\n        \"\"\"Removes outer parentheses and splits the string into tokens.\"\"\"\n        inner = tuple_str[1:-1]\n        if inner.strip() == \"\":\n            return []\n        return [token.strip() for token in inner.split(\",\")]\n_INT_RE = re.compile(r'^[+-]?\\d+$')\nclass TupleValidator:\n    \"\"\"Validates the format and content of tuple string tokens.\"\"\"\n    def validate_format(self, tuple_str: str) -> None:\n        \"\"\"Checks if the string starts and ends with parentheses.\"\"\"\n        if not isinstance(tuple_str, str):\n            raise TupleParseError(\"Input must be a string.\")\n        if len(tuple_str) < 2 or not (tuple_str.startswith(\"(\") and tuple_str.endswith(\")\")):\n            raise TupleParseError(\"Tuple string must start with '(' and end with ')'.\")\n\n    def validate_tokens(self, tokens: list[str]) -> None:\n        \"\"\"Ensures all tokens are valid integer representations.\"\"\"\n        for idx, t in enumerate(tokens):\n            if not _INT_RE.match(t):\n                raise TupleParseError(f\"Token '{t}' at position {idx} is not a valid integer.\")\nclass TupleStringParser:\n    \"\"\"Parses a validated tuple string into a tuple of integers.\"\"\"\n    def __init__(self, validator: 'TupleValidator' | None = None):\n        self._validator = validator or TupleValidator()\n\n    def parse(self, tuple_str: str) -> tuple[int, ...]:\n        \"\"\"Main parsing method: validates, tokenizes, converts.\"\"\"\n        self._validator.validate_format(tuple_str)\n        tokens = TupleUtils.tokenize_bracketed_tuple(tuple_str)\n        self._validator.validate_tokens(tokens)\n        try:\n            ints = tuple(self._parse_token(t) for t in tokens)\n        except ValueError as e:\n            raise TupleParseError(f\"Failed to convert token