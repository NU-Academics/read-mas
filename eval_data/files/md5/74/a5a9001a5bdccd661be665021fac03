f isinstance(item, dict):\n                    processed_item = _drop_from_dict(item) # Recurse into nested dict\n                elif isinstance(item, list):\n                    processed_item = _drop_from_list(item) # Recurse into nested list\n            \n            # Add item to cleaned_list only if it's not empty.\n            if not _is_empty(processed_item, combined_drop_values_set):\n                cleaned_list.append(processed_item)\n        return cleaned_list\n\n    # Determine the working dictionary: original if inplace, or a deep copy otherwise.\n    working_data = data if inplace else _deep_copy_dict(data)\n    \n    # Start the recursive cleaning process from the top-level dictionary.\n    return _drop_from_dict(working_data)", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[{"c1": "Red", "c2": "Green", "c3": null}]], "plus_fail_tests": [[{}]]}], "Mbpp/463": [{"task_id": "Mbpp/463", "solution": "def max_subarray_product(arr):\n    \"\"\"\n    Finds the maximum product of any contiguous subarray in the given array.\n    Handles positive, negative, and zero values efficiently.\n    \"\"\"\n    if not arr:\n        return 0\n\n    max_so_far = arr[0]\n    max_ending_here = arr[0]\n    min_ending_here = arr[0]\n\n    for i in range(1, len(arr)):\n        num = arr[i]\n\n        # If current number is negative, swap max_ending_here and min_ending_here\n        # because multiplying by a negative number reverses their roles.\n        if num < 0:\n            max_ending_here, min_ending_here = min_ending_here, max_ending_here\n\n        # Update max_ending_here and min_ending_here for the current number\n        max_ending_here = max(num, max_ending_here * num)\n        min_ending_here = min(num, min_ending_here * num)\n\n        # Update the overall maximum product found so far\n        max_so_far = max(max_so_far, max_ending_here)\n\n    return max_so_far", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fa