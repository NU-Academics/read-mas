tokens, removed_count\n\n    def reconstruct(self, tokens: List[Tuple[str, bool]]) -> str:\n        \"\"\"Reconstructs string from tokens, normalizing spaces after joining.\"\"\"\n        result_str = \"\".join(token for token, _ in tokens)\n        return normalize_spaces(result_str)\nclass RemoveLengthService:\n    \"\"\"Orchestrates word removal by length using WordTokenizer.\"\"\"\n    def __init__(self, tokenizer: Optional['WordTokenizer'] = None) -> None:\n        self.tokenizer = tokenizer if tokenizer is not None else WordTokenizer()\n\n    def remove_by_length(self, text: str, k: int) -> 'RemoveLengthResult':\n        \"\"\"Processes text to remove words of specified length k.\"\"\"\n        tokens = self.tokenizer.tokenize(text)\n        original_word_count = sum(1 for _, is_word in tokens if is_word)\n        filtered_tokens, removed_count = self.tokenizer.filter_by_length(tokens, k)\n        processed_text = self.tokenizer.reconstruct(filtered_tokens)\n        \n        return RemoveLengthResult(\n            original=text,\n            processed=processed_text,\n            removed_count=removed_count,\n            original_word_count=original_word_count\n        )\ndef remove_length(text, k):\n    \"\"\"Removes all words with k length in the given string.\"\"\"\n    svc = RemoveLengthService()\n    return svc.remove_by_length(text, k).processed", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [["This is a test sentence with all words having length of five.", 5]]}], "Mbpp/771": [{"task_id": "Mbpp/771", "solution": "def check_expression(expression: str) -> bool:\n    \"\"\"\n    Checks if the given expression has balanced brackets.\n    Non-bracket characters are ignored.\n    \"\"\"\n    BRACKET_MAP = {')': '(', ']': '[', '}': '{'}\n    OPENING_BRACKETS = set(BRACKET_MAP.values())\n    CLOSING_BRACKETS = set(BRACKET_MAP.keys())\n\n    stack = []\n\n    for char in expression:\n        if char in OPENING_BRACKETS: