None:\n        self._db_path = db_path if db_path is not None else DEFAULT_CACHE_PATH\n        self._conn = None\n        self._initialize_db()\n\n    def _initialize_db(self) -> None:\n        \"\"\"Opens or creates the SQLite DB and ensures the table exists.\"\"\"\n        try:\n            os.makedirs(os.path.dirname(self._db_path), exist_ok=True)\n            self._conn = sqlite3.connect(self._db_path)\n            self._conn.execute(SQLITE_SCHEMA)\n            self._conn.commit()\n        except sqlite3.Error as e:\n            raise CacheError(f\"Failed to initialize cache database at {self._db_path}: {e}\") from e\n\n    def get(self, n: int) -> int | None:\n        \"\"\"Returns cached sum-of-divisors for n, or None if not present.\"\"\"\n        if not self._conn: return None\n        try:\n            cur = self._conn.execute(\"SELECT sum FROM divisor_sums WHERE n = ?\", (n,))\n            row = cur.fetchone()\n            return row[0] if row else None\n        except sqlite3.Error as e:\n            warn(f\"Cache read error for n={n}: {e}\")\n            return None\n\n    def bulk_get(self, start: int, end: int) -> dict[int, int]:\n        \"\"\"Returns mapping of available cached results for the range.\"\"\"\n        if not self._conn: return {}\n        results = {}\n        try:\n            cur = self._conn.execute(\"SELECT n, sum FROM divisor_sums WHERE n BETWEEN ? AND ?\", (start, end))\n            for n, s in cur.fetchall():\n                results[n] = s\n            return results\n        except sqlite3.Error as e:\n            warn(f\"Cache bulk read error for range {start}-{end}: {e}\")\n            return {}\n\n    def set(self, n: int, s: int) -> None:\n        \"\"\"Inserts or replaces cache entry for n.\"\"\"\n        if not self._conn: return\n        try:\n            self._conn.execute(\n                \"INSERT OR REPLACE INTO divisor_sums (n, sum, computed_at) VALUES (?, ?, ?)\",\n                (n, s, datetime.datetime.now())\n 