d.append(converted)\n        return normalized\nclass CumulativeSumService:\n    \"\"\"Computes the cumulative sum and optionally persists the result.\"\"\"\n    def __init__(self, repo: Optional[JSONRepository] = None):\n        self._repo = repo\n\n    def compute(self, items: List[List[Union[float, int]]]) -> CumulativeResult:\n        \"\"\"Calculates the total sum of all numbers in the provided items.\"\"\"\n        total = 0.0\n        for inner in items:\n            for v in inner:\n                total += float(v) # Ensure float addition for intermediate sums\n        \n        total = safe_cast_int_if_possible(total)\n        input_repr = InputRepresentation(items).repr() # Capture the parsed/normalized input\n        result = CumulativeResult(result=total, input_repr=input_repr, timestamp=datetime.utcnow())\n        \n        if self._repo:\n            try:\n                self._repo.append(result.to_dict())\n            except Exception as e:\n                raise RepositoryError(f\"Error persisting result: {e}\")\n        return result\ndef cummulative_sum(input_data: Iterable[Iterable[object]], persist: bool = False, repo_path: Optional[str] = None) -> Union[float, int]:\n    \"\"\"\n    Calculates the cumulative sum of all numbers in a list of tuples.\n    Optionally persists the input and result to a JSON file.\n    \"\"\"\n    parser = TupleListParser()\n    items = parser.parse(input_data)\n    \n    repo = None\n    if persist:\n        repo = JSONRepository(repo_path)\n    \n    service = CumulativeSumService(repo=repo)\n    result = service.compute(items)\n    \n    return result.result", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/623": [{"task_id": "Mbpp/623", "solution": "def nth_nums(numbers, n):\n    \"\"\"Computes the n-th power of each number in the input list.\n    Returns a new list containing the results.\"\"\"\n    results = []\n    for x in numbers:\n        results.append(x