No match for pattern: {pattern}\")\n        return MatchResult(m.group(0), m.start(), m.end())\nclass LiteralSearcher:\n    \"\"\"Performs literal substring searches.\"\"\"\n    def search(self, text: str, literal: str) -> MatchResult:\n        \"\"\"Searches for the first occurrence of a literal string.\"\"\"\n        validate_input(text, literal)\n        idx = text.find(literal)\n        if idx == -1:\n            raise SearchNotFoundError(f\"Literal not found: {literal}\")\n        return MatchResult(literal, idx, idx + len(literal))\nclass SearchFactory:\n    \"\"\"Factory to provide searcher instances based on strategy.\"\"\"\n    def get_searcher(self, strategy: str):\n        \"\"\"Returns a searcher instance for the given strategy.\"\"\"\n        if strategy == \"regex\":\n            return RegexSearcher()\n        if strategy == \"literal\":\n            return LiteralSearcher()\n        raise ValueError(f\"Unknown search strategy: {strategy}\")\nclass TextSearchController:\n    \"\"\"Controller for text search operations.\"\"\"\n    def __init__(self, factory: SearchFactory | None = None):\n        self.factory = factory or SearchFactory()\n\n    def find_pattern(self, text: str, pattern: str) -> Tuple[str, int, int]:\n        \"\"\"Finds a regex pattern in text and returns the match as a tuple.\"\"\"\n        searcher = self.factory.get_searcher(\"regex\")\n        result = searcher.search(text, pattern)\n        return result.as_tuple()\n\n    def find_literals(self, text: str, literal: str) -> Tuple[str, int, int]:\n        \"\"\"Finds a literal string in text and returns the match as a tuple.\"\"\"\n        searcher = self.factory.get_searcher(\"literal\")\n        result = searcher.search(text, literal)\n        return result.as_tuple()\n_default_controller = TextSearchController()\ndef find_literals(text: str, literal: str) -> Tuple[str, int, int]:\n    \"\"\"Search a string for a literal substring and return the matching substring, start, and end 