 = algorithm\n            self._cache = cache\n\n        def get_value(self, idx: int) -> int:\n            key = f\"perrin:{idx}\"\n            cached = self._cache.get(key)\n            if cached is not None:\n                return cached\n            val = self._algorithm.compute(idx)\n            self._cache.set(key, val)\n            return val\n\n        def sum_values(self, idx: int) -> int:\n            total = 0\n            for i in range(0, idx + 1):\n                total += self.get_value(i)\n            return total\n\n    class PerrinController:\n        def __init__(self, service: PerrinService):\n            self._service = service\n\n        def calc_value(self, idx: int) -> int:\n            validate_index(idx)\n            return self._service.get_value(idx)\n\n        def calc_sum(self, idx: int) -> int:\n            validate_index(idx)\n            return self._service.sum_values(idx)\n\n    service = PerrinService(\n        algorithm=IterativePerrinAlgorithm(),\n        cache=InMemoryCacheRepository()\n    )\n    controller = PerrinController(service=service)\n\n    return controller.calc_sum(n)", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[-5]]}], "Mbpp/455": [{"task_id": "Mbpp/455", "solution": "def check_monthnumb_number(month: int) -> bool:\n    \"\"\"Checks if the given month number has 31 days.\"\"\"\n    return month in {1, 3, 5, 7, 8, 10, 12}", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/456": [{"task_id": "Mbpp/456", "solution": "def reverse_string_list(string_list):\n    \"\"\"Reverses each string in a given list of strings.\"\"\"\n    return [s[::-1] for s in string_list]", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/457": [{"task_id": "Mbpp/457", "solution": "def Find_Min(list_: list[list]) -> list:\n    \"\"\"\n    Finds the sublist with the minimum length from a list of lis