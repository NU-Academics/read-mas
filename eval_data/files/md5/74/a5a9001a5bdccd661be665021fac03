def product(self) -> float:\n            return self._a * self._b\n\n    # --- 3. Define Utilities (Validator) ---\n    class Validator:\n        def is_number(self, x: object) -> bool:\n            \"\"\"Checks if an object is a number (int or float) and not a boolean.\"\"\"\n            return isinstance(x, (int, float)) and not isinstance(x, bool)\n\n        def to_number(self, x: object) -> float:\n            \"\"\"Converts an object to a float, raising an error if it's not a valid number.\"\"\"\n            if not self.is_number(x):\n                raise PairValidationError(f\"Invalid numeric value in pair: {x!r}\")\n            return float(x)\n\n        def validate_and_normalize_pair(self, item: object) -> Tuple[float, float]:\n            \"\"\"Validates if an item is a 2-length sequence of numbers and normalizes them to floats.\"\"\"\n            if not hasattr(item, '__len__') or len(item) != 2:\n                raise PairValidationError(f\"Each pair must be a sequence of length 2, but got: {item!r}\")\n            \n            try:\n                a, b = item[0], item[1]\n            except (TypeError, IndexError):\n                raise PairValidationError(f\"Could not access elements of pair as sequence: {item!r}\")\n\n            return self.to_number(a), self.to_number(b)\n\n    # --- 4. Define Repository (IterableRepository) ---\n    class IterableRepository:\n        def to_pairs(self, iterable: Iterable[object], validator: Validator) -> Iterator[Pair]:\n            \"\"\"Converts an iterable of raw items into an iterator of validated Pair objects.\"\"\"\n            if not hasattr(iterable, '__iter__'):\n                raise InvalidInputError(\"Input for min_product_tuple must be an iterable.\")\n            \n            for item in iterable:\n                a, b = validator.validate_and_normalize_pair(item)\n                yield Pair(a, b)\n\n    # --- 5. Define Service (MinProductService) ---\n    class MinProductService:\n        def __