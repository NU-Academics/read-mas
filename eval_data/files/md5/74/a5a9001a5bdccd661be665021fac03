m 'a'.\n    # 'high' is the maximum possible number of elements to take from 'a'.\n    low = max(0, k - len_b)\n    high = min(k, len_a)\n\n    NEG_INF = float(\"-inf\")\n    POS_INF = float(\"inf\")\n\n    while low <= high:\n        i = (low + high) // 2  # Number of elements taken from array 'a'\n        j = k - i              # Number of elements taken from array 'b'\n\n        # Determine the four boundary elements for the current partition.\n        # Use negative/positive infinity for elements that are outside array bounds.\n        left_a = a[i - 1] if i > 0 else NEG_INF\n        right_a = a[i] if i < len_a else POS_INF\n\n        left_b = b[j - 1] if j > 0 else NEG_INF\n        right_b = b[j] if j < len_b else POS_INF\n\n        # Check if the partition is valid: elements on the left are less than or equal to elements on the right.\n        if left_a <= right_b and left_b <= right_a:\n            return max(left_a, left_b)\n        elif left_a > right_b:\n            # Partition is too far right in 'a', reduce 'high'.\n            high = i - 1\n        else:  # left_b > right_a\n            # Partition is too far left in 'a', increase 'low'.\n            low = i + 1", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[[1, 2, 3], [true, true, false], 3]]}], "Mbpp/599": [{"task_id": "Mbpp/599", "solution": "from dataclasses import dataclass\nfrom typing import Any\nclass InvalidInputError(ValueError):\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\n\n    def __str__(self) -> str:\n        return self.message\nMIN_N = 1\nclass InputValidator:\n    def validate_n(self, value: Any) -> int:\n        if isinstance(value, int):\n            if value >= MIN_N:\n                return value\n            raise InvalidInputError(f\"n must be >= {MIN_N}, got {value}\")\n        try:\n            parsed = int(value)\n        except (ValueError, TypeError):\n            raise InvalidInputError(f\"n must be an integer >= {MIN_N}, got {value!r}\")\n        if parsed < MIN_N:\n            raise InvalidInputError(f\"n must be >= {MIN_N}, got {parsed}\")\n        return parsed\nclass SumAverageService:\n    def __init__(self, validator: InputValidator):\n        self._validator = validator\n\n    def sum_average(self, n: int) -> NumberResult:\n        valid_n = self._validator.validate_n(n)\n        total = self._compute_sum(valid_n)\n        avg = self._compute_average(total, valid_n)\n        return NumberResult(total, avg)\n\n    def _compute_sum(self, n: int) -> int:\n        return n * (n + 1) // 2\n\n    def _compute_average(self, total: int, n: int) -> float:\n        return total / n\ndef sum_average(n: int) -> tuple[int, float]:\n    \"\"\"\n    Calculates the sum and average of the first n natural numbers.\n    Raises InvalidInputError if n is not a positive integer.\n    \"\"\"\n    _validator = InputValidator()\n    _service = SumAverageService(_validator)\n    result = _service.sum_average(n)\n    return result.to_tuple()", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/600": [{"task_id": "Mbpp/600", "solution": "def is_Even(number):\n    \"\"\"Checks if the given number is even.\n    Returns True if even, False otherwise.\"\"\"\n    return number % 2 == 0", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/598": [{"task_id": "Mbpp/598", "solution": "def armstrong_number(n: int) -> bool:\n    \"\"\"Checks if a given number is an Armstrong number.\"\"\"\n    if n < 0:\n        return False\n    if n == 0:\n        return True\n\n    # Calculate the number of digits (p)\n    p = len(str(n))\n\n    original_n = n\n    sum_of_powers = 0\n    temp_n = n\n\n    # Extract digits and sum each to the power of p\n    while temp_n > 0:\n        digit = temp_n % 10\n        sum_of_powers += digit ** p\n        temp_n //= 10\n\n    return s