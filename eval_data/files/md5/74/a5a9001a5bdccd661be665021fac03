"\"\n    Checks if a given square matrix is a magic square.\n\n    A magic square is a square matrix where the sum of each row, each column,\n    and both main diagonals is the same. By default, all elements must also be unique.\n    \"\"\"\n    n = len(matrix)\n\n    if n == 0:  # An empty matrix cannot be a magic square.\n        return False\n\n    all_elements = []\n    # Collect all elements and check if the matrix is square\n    for row in matrix:\n        # Check for ragged rows; assumes 'row' is a list\n        if len(row) != n:\n            return False\n        # Collect elements to check uniqueness later\n        for x in row:\n            all_elements.append(x)\n\n    # If duplicates are not allowed, check if all elements are unique\n    if not allow_duplicates:\n        if len(set(all_elements)) != n * n:\n            return False\n\n    # Calculate the target sum from the first row\n    target_sum = sum(matrix[0])\n\n    # Check row sums\n    for i in range(n):\n        if sum(matrix[i]) != target_sum:\n            return False\n\n    # Check column sums\n    for j in range(n):\n        col_sum = 0\n        for i in range(n):\n            col_sum += matrix[i][j]\n        if col_sum != target_sum:\n            return False\n\n    # Check main diagonal sum\n    main_diag_sum = 0\n    for i in range(n):\n        main_diag_sum += matrix[i][i]\n    if main_diag_sum != target_sum:\n        return False\n\n    # Check secondary diagonal sum\n    sec_diag_sum = 0\n    for i in range(n):\n        sec_diag_sum += matrix[i][n - 1 - i]\n    if sec_diag_sum != target_sum:\n        return False\n\n    return True", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[[[7, 7], [7, 7]]]]}], "Mbpp/131": [{"task_id": "Mbpp/131", "solution": "def reverse_vowels(s: str) -> str:\n    \"\"\"Reverses only the vowels in the input string s.\"\"\"\n    VOWELS = frozenset({\"a\", \"e\", \"i\", \"o\", \"u\", \"A\", \"E\", \"I\", \"O\", \"U\"})