n False\n            \n    return True", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/608": [{"task_id": "Mbpp/608", "solution": "def bell_Number(n: int) -> int:\n    \"\"\"\n    Computes the nth Bell number using the Bell triangle algorithm.\n    Assumes n is a non-negative integer.\n    \"\"\"\n    if n == 0:\n        return 1\n\n    bell_triangle = [[1]]\n    for i in range(1, n + 1):\n        row = [bell_triangle[i - 1][-1]]\n        for j in range(1, i + 1):\n            val = row[j - 1] + bell_triangle[i - 1][j - 1]\n            row.append(val)\n        bell_triangle.append(row)\n    \n    return bell_triangle[n][0]", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/611": [{"task_id": "Mbpp/611", "solution": "def max_of_nth(matrix, n):\n    \"\"\"\n    Returns the maximum value found in the n-th column of the given matrix.\n    Assumes a non-empty, rectangular matrix with valid numeric values and column index n.\n    \"\"\"\n    column_values = [row[n] for row in matrix]\n    return max(column_values)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/462": [{"task_id": "Mbpp/462", "solution": "def combinations_list(items: list) -> list:\n    \"\"\"\n    Finds all possible combinations (subsets) of elements from a given list\n    using a bitmask approach to ensure deterministic ordering.\n    \"\"\"\n    n = len(items)\n    result = []\n    for i in range(1 << n):  # Iterate from 0 to 2^n - 1\n        current_combination = []\n        # Construct combination by checking bits from highest index to lowest\n        for j in range(n - 1, -1, -1):\n            if (i >> j) & 1:  # If the j-th bit is set\n                current_combination.append(items[j])\n        result.append(current_combination)\n    return result", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}],