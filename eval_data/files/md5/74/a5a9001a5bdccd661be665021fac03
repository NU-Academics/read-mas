": "Mbpp/622", "solution": "def get_median(a: list[int], b: list[int], n: int) -> float:\n    \"\"\"\n    Finds the median of two sorted lists of the same size using a binary search approach.\n    \"\"\"\n    import math\n\n    def find_kth_element(arr1, arr2, k):\n        m, n_len = len(arr1), len(arr2)\n\n        # Ensure arr1 is the shorter array for binary search efficiency\n        if m > n_len:\n            return find_kth_element(arr2, arr1, k)\n\n        # Binary search for 'i', the number of elements taken from arr1 for the left partition.\n        # 'j' will be k - i, the number of elements taken from arr2.\n        # 'i' can range from max(0, k - n_len) to min(k, m).\n        low = max(0, k - n_len)\n        high = min(k, m)\n\n        while low <= high:\n            i = low + (high - low) // 2\n            j = k - i\n\n            # L1 is the element before the i-th element in arr1 (left part max)\n            # R1 is the i-th element in arr1 (right part min)\n            # Similar for L2, R2 in arr2\n            L1 = arr1[i - 1] if i > 0 else -math.inf\n            R1 = arr1[i] if i < m else math.inf\n            \n            L2 = arr2[j - 1] if j > 0 else -math.inf\n            R2 = arr2[j] if j < n_len else math.inf\n\n            if L1 <= R2 and L2 <= R1:\n                # The partition is correct, the k-th element is the maximum of the left parts.\n                return max(L1, L2)\n            elif L1 > R2:\n                # 'i' is too large; we need to take fewer elements from arr1 (move left in arr1)\n                high = i - 1\n            else: # L2 > R1\n                # 'i' is too small; we need to take more elements from arr1 (move right in arr1)\n                low = i + 1\n        return -1 # Should not be reached in a valid scenario\n\n    # For two sorted lists of size 'n', the combined list has 2*n elements.\n    # The median is the average of the n-th and (n+1)-th smallest elements.\n    # The find_kth_element function returns the k-th smallest element (1-indexed).\n    \n    # Get the n-th smallest element\n    median1 = find_kth_element(a, b, n)\n    # Get the (n+1)-th smallest element\n    median2 = find_kth_element(a, b, n + 1)\n    \n    return (float(median1) + float(median2)) / 2.0", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[[1], [2], 0]]}], "Mbpp/635": [{"task_id": "Mbpp/635", "solution": "def heap_sort(arr: list) -> list:\n    \"\"\"Sorts a list using the heap sort algorithm.\"\"\"\n    # Create a copy of the list to sort, leaving the original list unchanged.\n    numbers = list(arr)\n    n = len(numbers)\n\n    # Helper function to maintain the heap property in a subtree rooted at `i_local`.\n    def _heapify(arr_local, n_local, i_local):\n        largest = i_local\n        left = 2 * i_local + 1\n        right = 2 * i_local + 2\n\n        if left < n_local and arr_local[left] > arr_local[largest]:\n            largest = left\n\n        if right < n_local and arr_local[right] > arr_local[largest]:\n            largest = right\n\n        if largest != i_local:\n            arr_local[i_local], arr_local[largest] = arr_local[largest], arr_local[i_local]\n            _heapify(arr_local, n_local, largest)\n\n    # Build a max-heap from the input array.\n    for i in range(n // 2 - 1, -1, -1):\n        _heapify(numbers, n, i)\n\n    # Extract elements one by one from the heap.\n    for i in range(n - 1, 0, -1):\n        numbers[i], numbers[0] = numbers[0], numbers[i]\n        _heapify(numbers, i, 0)\n\n    return numbers", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/641": [{"task_id": "Mbpp/641", "solution": "def is_nonagonal(n: int) -> int:\n    \"\"\"\n    Calculates the nth nonagonal number using the formula P9(n) = (7*n*n - 5*n) / 2.\n    \"\"\"\n    return (7 * n * n - 5 * n) // 2", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/633": [{"task_id": "Mbpp/633", "solution": "def pair_xor_Sum(numbers, n):\n    \"\"\"\n    Calculates the sum of XOR of all pairs of numbers in the given list.\n    The algorithm computes this sum efficiently by counting set bits at each position.\n    \"\"\"\n    if n < 2:\n        return 0 # Or handle error based on strict interpretation, but design implies valid input\n\n    # Determine the highest bit needed for computation\n    max_val = 0\n    for num in numbers:\n        if abs(num) > max_val:\n            max_val = abs(num)\n            \n    if max_val == 0:\n        max_bit = 0\n    else:\n        max_bit = max_val.bit_length() - 1\n\n    total_xor_sum = 0\n    # Iterate through each bit position\n    for bit_pos in range(max_bit + 1):\n        ones_count = 0\n        # Count how many numbers have the current bit set\n        for num in numbers:\n            if (num >> bit_pos) & 1:\n                ones_count += 1\n        \n        # Calculate the count of numbers with the current bit unset\n        zeros_count = n - ones_count\n        \n        # For each bit, the total sum contributed is (count of ones * count of zeros * (2^bit_pos))\n        total_xor_sum += (ones_count * zeros_count) * (1 << bit_pos)\n        \n    return total_xor_sum", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[[1, 2, 3, 2, 1, 2, 3, 4, 5, 4, 5, 3], 11]]}], "Mbpp/639": [{"task_id": "Mbpp/639", "solution": "def sample_nam(names):\n    \"\"\"\n    Sums the length of names after removing those that start with a lowercase letter.\n    Non-string items are ignored, and empty strings contribute zero length if retained.\n    \"\"\"\n    total_length = 0\n    LOWERCASE_RANGE_START = 'a'\n    LOWERCASE_RANGE_END = 'z'\n\n    for name in names:\n        # Ignore non-string items as per design context (FR1, Rule3).\n        if not isinstance(name, str):\n            continue\n\n        # Handle empty strings as per design context (Rule2).\n  