e tuples.\")\n\n    if len(a) != len(b):\n        raise TupleLengthMismatchError(\"Input tuples must have the same length.\")\n\n    result_elements = []\n    for i in range(len(a)):\n        val_a = a[i]\n        val_b = b[i]\n\n        if not isinstance(val_a, (int, float)):\n            raise InvalidElementError(f\"Element at index {i} in the first tuple is not numeric.\")\n        if not isinstance(val_b, (int, float)):\n            raise InvalidElementError(f\"Element at index {i} in the second tuple is not numeric.\")\n\n        result_elements.append(safe_divide_inline(float(val_a), float(val_b)))\n\n    return tuple(result_elements)", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[[5, 2, 3, 3], [5, 2, 3, 4]]]}], "Mbpp/260": [{"task_id": "Mbpp/260", "solution": "def newman_prime(n: int) -> int:\n    \"\"\"\n    Finds the first Newman\u2013Shanks\u2013Williams prime S(k) where k >= n,\n    following the recurrence S(0)=1, S(1)=1, S(k) = 2*S(k-1) + S(k-2).\n    \"\"\"\n\n    def _is_prime(num: int) -> bool:\n        \"\"\"\n        Determines if a number is prime using trial division for small numbers\n        and a deterministic Miller-Rabin test for larger values.\n        \"\"\"\n        if num < 2:\n            return False\n        if num == 2 or num == 3:\n            return True\n        if num % 2 == 0 or num % 3 == 0:\n            return False\n\n        # Fixed set of bases for Miller-Rabin, sufficient for values in this problem's scope.\n        # This provides a deterministic test for numbers up to a certain range.\n        miller_rabin_bases = [2, 3, 5, 7, 11, 13, 17] \n        \n        d = num - 1\n        s = 0\n        while d % 2 == 0:\n            d //= 2\n            s += 1\n        \n        for a in miller_rabin_bases:\n            if a >= num: # Base 'a' must be less than 'num' for Miller-Rabin\n                break\n            \n            x = pow(a, d, num)\n            if x == 1 or x == num