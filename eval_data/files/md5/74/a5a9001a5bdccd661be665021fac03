.value, \"original_items\": list(self.original_items)}\nclass TypeComparator:\n    def is_numeric(self, value: Any) -> bool:\n        if isinstance(value, (int, float, Decimal)):\n            return True\n        if isinstance(value, str):\n            try:\n                int(value)\n                return True\n            except ValueError:\n                try:\n                    float(value)\n                    return True\n                except ValueError:\n                    return False\n        return False\n\n    def to_numeric(self, value: Any) -> Optional[Number]:\n        if isinstance(value, int):\n            return value\n        if isinstance(value, float):\n            return value\n        if isinstance(value, Decimal):\n            return float(value)\n        if isinstance(value, str):\n            try:\n                i = int(value)\n                return i\n            except ValueError:\n                try:\n                    return float(value)\n                except ValueError:\n                    return None\n        return None\nclass InputNormalizer:\n    def normalize(self, items: Any) -> List[Any]:\n        if items is None:\n            raise InvalidInputError(\"Input cannot be None.\")\n        if isinstance(items, str):\n            return [items]\n        try:\n            if isinstance(items, Iterable):\n                return list(items)\n        except TypeError:\n            pass\n        return [items]\nclass MinFinder:\n    def __init__(self):\n        self._type_comparator = TypeComparator()\n        self._normalizer = InputNormalizer()\n\n    def find_min(self, items: Sequence[Any]) -> ResultDTO:\n        \"\"\"Core algorithm to compute the minimum numeric value from items.\"\"\"\n        normalized = self._normalizer.normalize(items)\n        numeric_vals: List[Number] = []\n        for v in normalized:\n            n = self._type_comparator.to_numeric(v)\n            if n is not None:\n                numeric