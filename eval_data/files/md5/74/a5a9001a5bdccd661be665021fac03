   # If total sum is non-positive or k is 2, the maximum sum will be\n        # found within the first two concatenations.\n        return max_sum_two_copies", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/296": [{"task_id": "Mbpp/296", "solution": "def get_Inv_Count(arr):\n    \"\"\"Counts inversions in an array using a merge-sort based approach.\"\"\"\n\n    def _merge(left, right):\n        \"\"\"Merges two sorted lists and counts inversions between them.\"\"\"\n        i = j = 0\n        merged = []\n        inv_count = 0\n        while i < len(left) and j < len(right):\n            if left[i] <= right[j]:\n                merged.append(left[i])\n                i += 1\n            else:\n                merged.append(right[j])\n                j += 1\n                inv_count += len(left) - i\n        merged.extend(left[i:])\n        merged.extend(right[j:])\n        return merged, inv_count\n\n    def _merge_sort_and_count(arr_segment):\n        \"\"\"Recursively sorts array segments and accumulates inversion counts.\"\"\"\n        n = len(arr_segment)\n        if n <= 1:\n            return arr_segment, 0\n\n        mid = n // 2\n        left_sorted, left_inversions = _merge_sort_and_count(arr_segment[:mid])\n        right_sorted, right_inversions = _merge_sort_and_count(arr_segment[mid:])\n\n        merged_sorted, split_inversions = _merge(left_sorted, right_sorted)\n        return merged_sorted, left_inversions + right_inversions + split_inversions\n\n    # Create a copy of the input array to avoid modifying the original.\n    _, total_inversions = _merge_sort_and_count(list(arr))\n    return total_inversions", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/265": [{"task_id": "Mbpp/265", "solution": "def list_split(items, n):\n    \"\"\"\n    Splits a list into n sublists, where each sublist contains every nth element from the original list.\n    Elements are distributed column-wise into the resulting sublists.\n    \"\"\"\n    result = [[] for _ in range(n)]\n    for idx, item in enumerate(items):\n        result[idx % n].append(item)\n    return result", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/300": [{"task_id": "Mbpp/300", "solution": "import math\ndef count_binary_seq(n: int) -> int:\n    \"\"\"\n    Calculates the number of binary sequences of length 2n such that the sum of the first n bits\n    is the same as the sum of the last n bits. This is combinatorially equivalent to C(2n, n).\n    \"\"\"\n    N = 2 * n\n    K = n\n\n    if hasattr(math, 'comb'):\n        return math.comb(N, K)\n    else:\n        # Fallback for Python versions older than 3.8 without math.comb.\n        # Implements C(N, K) using the multiplicative formula C(N, K) = N! / (K! * (N-K)!).\n        K_eff = min(K, N - K)\n        if K_eff == 0:\n            return 1\n\n        res = 1\n        for i in range(K_eff):\n            res = res * (N - i) // (i + 1)\n        return res", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[50]]}], "Mbpp/294": [{"task_id": "Mbpp/294", "solution": "from typing import Any, Sequence, Union\nfrom decimal import Decimal\ndef max_val(values: Sequence[Any]) -> Union[int, float, Decimal]:\n    \"\"\"\n    Finds the maximum numeric value in a given heterogeneous list.\n    Non-numeric items are ignored, and booleans are not considered numeric.\n    \"\"\"\n    numeric_items = []\n    for item in values:\n        if isinstance(item, (int, float, Decimal)) and not isinstance(item, bool):\n            numeric_items.append(item)\n    return max(numeric_items)", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[["3.14", false, 7.5]]]}], "Mbpp/299": [{"task_id": "Mbpp/299", "solution": "def max_aggregate(records: list[tuple[str, int]]) -> tuple[str, int]:\n    \"\"\"\n    Calculates the maximum aggregate sum from a list of (name, value) tuples.\n    If multiple names have the same maximum sum, the first encountered name\n    in the input list is returned.\n    \"\"\"\n    if not records:\n        return ('', 0)\n\n    # Aggregate sums for each name\n    totals: dict[str, float] = {}\n    for name, value in records:\n        totals[name] = totals.get(name, 0.0) + value\n\n    if not totals: # Should not happen if records is not empty, but as a safeguard\n        return ('', 0)\n\n    # Find the maximum total value\n    max_total = max(totals.values())\n\n    # Find the name corresponding to the max_total,\n    # prioritizing the first encountered name in the original list if there's a tie\n    for name, _ in records:\n        if totals[name] == max_total:\n            return (name, int(max_total)) # Return as int as per example output type hint\n\n    # This part should ideally not be reached if totals is not empty,\n    # but added for completeness/safety, although assert implies valid input always.\n    return ('', 0)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/305": [{"task_id": "Mbpp/305", "solution": "from typing import List, Tuple, Optional\nimport string\nclass InvalidInputError(ValueError):\n    pass\nclass NotEnoughMatchesError(ValueError):\n    pass\nclass WordPair:\n    def __init__(self, first: str, second: str):\n        # Initializes a WordPair with two words.\n        if not first or not second:\n            raise InvalidInputError(\"Words in WordPair cannot be empty\")\n        self.first = first\n        self.second = second\n\n    def to_tuple(self) -> Tuple[str, str]:\n        # Returns the word pair as a tuple.\n        return (self.first, self.second)\nclass Tokenizer:\n    PUNCTUATION_CHARS = '.,;:!?()\"\\'[]{}<>'\n\n    def tokenize(self, line: str) -> List[str]:\n        # Splits a line into words and strips surrounding punctuation from each.\n        raw_tokens = line.split()\n        out = []\n        for t in raw_tokens:\n            stripped = t.strip(self.PUNCTUATION_CHARS)\n            if stripped:\n                out.append(stripped)\n        return out\nclass Validator:\n    def is_word_starting(self, word: str, letter: str) -> bool:\n        # Checks if a word starts with the given letter, ignoring case.\n        if not word or not letter:\n            return False\n        return word[0].lower() == letter.lower()\nclass WordRepository:\n    def __init__(self):\n        # Initializes an in-memory repository for the last WordPair.\n        self._last: Optional[WordPair] = None\n\n    def save(self, pair: WordPair) -> None:\n        # Saves the given WordPair as the last result.\n        self._last = pair\n\n    def get_last(self) -> Optional[WordPair]:\n        # Retrieves the last saved WordPair.\n        return self._last\nclass WordService:\n    def __init__(self, tokenizer: Tokenizer, validator: Validator, repository: Optional[WordRepository] = None):\n        # Initializes the service with tokenizer, validator, and an optional repository.\n        self._tokenizer = tokenizer\n        self._validator = validator\n        self._repo = repository\n\n    def find_two_starting_with(self, lines: List[str], letter: str = \"p\") -> Tuple[str, str]:\n        # Finds the first two words from the input lines that start with the specified letter.\n        if not isinstance(lines, list) or not all(isinstance(l, str) for l in lines):\n            raise InvalidInputError(\"lines must be a list of strings\")\n        \n        candidates: List[str] = self._collect_candidates(lines, letter)\n        \n        if len(candidates) < 2:\n            raise NotEnoughMatchesError(f\"expected 2 matches for letter '{letter}', found {len(candidates)}\")\n        \n        pair = WordPair(candidates[0], candidates[1])\n        if self._repo:\n            self._repo.save(pair)\n        return pair.to_tuple()\n\n    def _collect_cand