ting only of 1s and 0s.\n    Perform binary XOR on these inputs and return result also as a string.\n    >>> string_xor('010', '110')\n    '100'\n    \"\"\"\n    binary_a = BinaryString(a)\n    binary_b = BinaryString(b)\n\n    if binary_a.length() != binary_b.length():\n        raise ValueError(\"Input binary strings must be of equal length.\")\n\n    result_chars = []\n    for i in range(binary_a.length()):\n        char_a = binary_a[i]\n        char_b = binary_b[i]\n        if char_a == char_b:\n            result_chars.append('0')\n        else:\n            result_chars.append('1')\n\n    return \"\".join(result_chars)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/11", "solution": "def string_xor(a: str, b: str) -> str:\n    \"\"\"\n    Performs binary XOR on two binary strings.\n    Raises ValueError for invalid inputs (non-binary characters or mismatched lengths).\n    \"\"\"\n    # Validate NFR1: Check if 'a' and 'b' contain only '0's and '1's.\n    for char_a in a:\n        if char_a not in {'0', '1'}:\n            raise ValueError('Input string contains non-binary characters.')\n    for char_b in b:\n        if char_b not in {'0', '1'}:\n            raise ValueError('Input string contains non-binary characters.')\n\n    # Validate NFR2: Check if 'a' and 'b' have the same length.\n    if len(a) != len(b):\n        raise ValueError('Input strings must have the same length.')\n\n    # Perform FR2: Character-by-character XOR.\n    result_chars = []\n    for char_a, char_b in zip(a, b):\n        # FR4: If characters are different, append '1'.\n        if char_a != char_b:\n            result_chars.append('1')\n        # FR5: If characters are the same, append '0'.\n        else:\n            result_chars.append('0')\n\n    # Return FR3: The resulting binary string.\n    return \"\".join(result_chars)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": [