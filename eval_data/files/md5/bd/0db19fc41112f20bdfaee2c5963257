g with no uppercase characters.\n    \"\"\"\n    total_sum = 0\n    if not s:\n        return 0\n\n    for char in s:\n        # Check if the character is an uppercase ASCII character\n        if 'A' <= char <= 'Z':\n            total_sum += ord(char)\n    return total_sum", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/66", "solution": "def digitSum(s: str) -> int:\n    \"\"\"\n    Calculates the sum of ASCII codes of only the uppercase characters in the input string.\n    Returns 0 if the string is empty or contains no uppercase characters.\n    \"\"\"\n    total_sum = 0\n    for char in s:\n        if char.isupper():\n            total_sum += ord(char)\n    return total_sum", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/68": [{"task_id": "HumanEval/68", "solution": "def pluck(arr):\n    \"\"\"\n    \"Given an array representing a branch of a tree that has non-negative integer nodes\n    your task is to pluck one of the nodes and return it.\n    The plucked node should be the node with the smallest even value.\n    If multiple nodes with the same smallest even value are found return the node that has smallest index.\n\n    The plucked node should be returned in a list, [ smalest_value, its index ],\n    If there are no even values or the given array is empty, return [].\n\n    Example 1:\n        Input: [4,2,3]\n        Output: [2, 1]\n        Explanation: 2 has the smallest even value, and 2 has the smallest index.\n\n    Example 2:\n        Input: [1,2,3]\n        Output: [2, 1]\n        Explanation: 2 has the smallest even value, and 2 has the smallest index.\n\n    Example 3:\n        Input: []\n        Output: []\n\n    Example 4:\n        Input: [5, 0, 3, 0, 4, 2]\n        Output: [0, 1]\n        Explanation: 0 is the smallest value, but  there are two zeros,\n                     so we will choose the first zero, which has the smallest index.\n\n    Constraints:\n        * 1 <= nodes.length <= 10000\n        * 0 <= node.value\n    \"\"\"\n    if not arr:\n        return []\n\n    smallest_even_value = float('inf')\n    smallest_even_index = -1\n\n    for index, value in enumerate(arr):\n        if value % 2 == 0:  # Identify even values\n            if value < smallest_even_value:  # Determine smallest even value\n                smallest_even_value = value\n                smallest_even_index = index\n            elif value == smallest_even_value:  # Prioritize smallest index for duplicates\n                if index < smallest_even_index:\n                    smallest_even_index = index\n\n    if smallest_even_index == -1:  # No even values found\n        return []\n    else:\n        return [smallest_even_value, smallest_even_index]", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/68", "solution": "def pluck(arr):\n    \"\"\"\n    Identifies and extracts the smallest even-valued node from an array.\n    If multiple nodes share the same smallest even value, the one with the lowest index is prioritized.\n    \"\"\"\n    if not arr:\n        return []\n\n    smallest_even_value = float('inf')\n    smallest_even_index = -1\n\n    for i, num in enumerate(arr):\n        if num % 2 == 0:  # Check if the number is even\n            if num < smallest_even_value:\n                smallest_even_value = num\n                smallest_even_index = i\n            # If num == smallest_even_value, we do nothing, preserving the first occurrence (lowest index).\n\n    if smallest_even_index == -1:\n        return []  # No even values were found\n    else:\n        return [smallest_even_value, smallest_even_index]", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/67": [{"task_id": "HumanEval/67", "solution": "import re\ndef fruit_distribution(s,n):\n    \"\"\"\n    Calculates the number of mango fruits given a string describing apples and oranges,\n    and the total number of fruits. It extracts counts from the string and subtracts them from the total.\n    \"\"\"\n\n    # Extract apple and orange counts using a regular expression.\n    match = re.search(r\"(\\d+) apples and (\\d+) oranges\", s)\n\n    # Convert extracted string counts to integers.\n    apples_count = int(match.group(1))\n    oranges_count = int(match.group(2))\n\n    # Calculate the number of mangoes by subtracting known fruits from the total.\n    mangoes_count = n - (apples_count + oranges_count)\n\n    return mangoes_count", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/67", "solution": "import re\ndef fruit_distribution(s: str, n: int) -> int:\n    \"\"\"\n    Extracts apple and orange counts from 's', then calculates and returns\n    the number of mango fruits by subtracting these from 'n'.\n    \"\"\"\n    # Extract the numerical count of apples from the string 's'.\n    apples_match = re.search(r'(\\d+)\\s*apples', s)\n    apples_count = int(apples_match.group(1))\n\n    # Extract the numerical count of oranges from the string 's'.\n    oranges_match = re.search(r'(\\d+)\\s*oranges', s)\n    oranges_count = int(oranges_match.group(1))\n\n    # Calculate the number of mango fruits.\n    mangoes_count = n - (apples_count + oranges_count)\n\n    return mangoes_count", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/69": [{"task_id": "HumanEval/69", "solution": "class IntegerList:\n    \"\"\"\n    Manages a list of integers, calculates their frequencies, and finds specific matching integers.\n    It stores the input integers and a dictionary of their frequencies.\n    \"\"\"\n    def __init__(self, integers: list[int]):\n        self._integers = integers\n        self._frequencies = {}\n        for num in integers:\n            self._frequencies[num]