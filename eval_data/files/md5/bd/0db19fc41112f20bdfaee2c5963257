able items.\n    \"\"\"\n\n    def calculate_sum_of_digits(number: int) -> int:\n        \"\"\"Calculates the sum of the absolute value of digits for a given integer.\"\"\"\n        s = 0\n        for digit in str(abs(number)):\n            s += int(digit)\n        return s\n\n    class SortableInteger:\n        \"\"\"Encapsulates an integer, its digit sum, and original index for custom sorting.\"\"\"\n        def __init__(self, value: int, index: int, sum_digits: int):\n            self.original_value = value\n            self.sum_of_digits = sum_digits\n            self.original_index = index\n\n        def __lt__(self, other: 'SortableInteger') -> bool:\n            \"\"\"Compares SortableInteger objects, prioritizing digit sum then original index.\"\"\"\n            if self.sum_of_digits != other.sum_of_digits:\n                return self.sum_of_digits < other.sum_of_digits\n            return self.original_index < other.original_index\n\n    if not nums:\n        return []\n\n    sortable_items = []\n    for index, value in enumerate(nums):\n        sum_digits = calculate_sum_of_digits(value)\n        sortable_items.append(SortableInteger(value, index, sum_digits))\n\n    sortable_items.sort()\n\n    return [item.original_value for item in sortable_items]", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[[1, 11, -1, -11, -12]]], "plus_fail_tests": [[[-5, -12, 9, 15]]]}, {"task_id": "HumanEval/145", "solution": "class SortableInteger:\n    def __init__(self, value: int, sum_of_digits: int, original_index: int):\n        self.value = value\n        self.sum_of_digits = sum_of_digits\n        self.original_index = original_index\ndef _calculate_sum_of_digits(num: int) -> int:\n    return sum(int(digit) for digit in str(abs(num)))\ndef order_by_points(nums):\n    \"\"\"\n    Sorts a list of integers primarily by the sum of their digits (ascending).\n    Secondary sort key is the original index (ascending) for tie-breaking.\n    \"\"\"\n    if no