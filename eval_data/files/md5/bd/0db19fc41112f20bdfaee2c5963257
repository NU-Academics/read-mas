numerator = self._numerator * other._numerator\n        new_denominator = self._denominator * other._denominator\n        # The Fraction constructor will automatically simplify the product.\n        return Fraction(new_numerator, new_denominator)\n\n    def is_whole_number(self) -> bool:\n        \"\"\"Determines if the fraction represents a whole number.\"\"\"\n        return self._numerator % self._denominator == 0\ndef simplify(x: str, n: str) -> bool:\n    \"\"\"Determines if the product of two fractional string inputs evaluates to a whole number.\"\"\"\n    fraction_x = Fraction.from_string(x)\n    fraction_n = Fraction.from_string(n)\n    product_fraction = fraction_x.multiply(fraction_n)\n    return product_fraction.is_whole_number()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/144", "solution": "def simplify(x, n):\n    \"\"\"Your task is to implement a function that will simplify the expression\n    x * n. The function returns True if x * n evaluates to a whole number and False\n    otherwise.\n    \"\"\"\n    # Input Parsing for x\n    x_parts = x.split('/')\n    x_numerator = int(x_parts[0])\n    x_denominator = int(x_parts[1])\n\n    # Input Parsing for n\n    n_parts = n.split('/')\n    n_numerator = int(n_parts[0])\n    n_denominator = int(n_parts[1])\n\n    # Fraction Multiplication\n    product_numerator = x_numerator * n_numerator\n    product_denominator = x_denominator * n_denominator\n\n    # Whole Number Check\n    return product_numerator % product_denominator == 0", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/148": [{"task_id": "HumanEval/148", "solution": "class Planet:\n    \"\"\"Represents a single planet with its name and orbital order.\"\"\"\n    def __init__(self, name: str, order_from_sun: int):\n        self.name = name\n        self.order_from_sun = order_from_sun\nclass SolarSystem:\n    \"\"\"Manages the authoritative list of planets and provides query methods.\"\"\"\n    def __init__(self):\n        # Initialize with the eight planets in their correct order.\n        planet_data = [\n            (\"Mercury\", 0), (\"Venus\", 1), (\"Earth\", 2), (\"Mars\", 3),\n            (\"Jupiter\", 4), (\"Saturn\", 5), (\"Uranus\", 6), (\"Neptune\", 7)\n        ]\n        self._planets = [Planet(name, order) for name, order in planet_data]\n        self._planet_map = {planet.name: planet for planet in self._planets}\n\n    def get_planet_order(self, planet_name: str) -> int | None:\n        \"\"\"Returns the order of a planet from the Sun, or None if the name is invalid.\"\"\"\n        planet = self._planet_map.get(planet_name)\n        return planet.order_from_sun if planet else None\n\n    def get_planets_between(self, order1: int, order2: int) -> list[str]:\n        \"\"\"Returns a list of planet names whose orbits are between the given orders, sorted.\"\"\"\n        min_order = min(order1, order2)\n        max_order = max(order1, order2)\n\n        result_planets = []\n        for planet in self._planets:\n            if min_order < planet.order_from_sun < max_order:\n                result_planets.append(planet.name)\n        return result_planets\n_solar_system = SolarSystem()\ndef bf(planet1, planet2):\n    \"\"\"\n    Returns a tuple of planets located between planet1 and planet2, sorted by proximity to the Sun.\n    Returns an empty tuple if either input planet name is invalid.\n    \"\"\"\n    order1 = _solar_system.get_planet_order(planet1)\n    order2 = _solar_system.get_planet_order(planet2)\n\n    if order1 is None or order2 is None:\n        return ()\n\n    between_planets = _solar_system.get_planets_between(order1, order2)\n    return tuple(between_planets)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/148", "solution": "def bf(planet1, planet2):\n    \"\"\"\n    Returns planets strictly between planet1 and planet2, sorted by proximity to the sun.\n    Returns an empty tuple if either planet name is invalid.\n    \"\"\"\n    planets_ordered = [\n        \"Mercury\", \"Venus\", \"Earth\", \"Mars\", \"Jupiter\", \"Saturn\", \"Uranus\", \"Neptune\"\n    ]\n\n    if planet1 not in planets_ordered or planet2 not in planets_ordered:\n        return ()\n\n    idx1 = planets_ordered.index(planet1)\n    idx2 = planets_ordered.index(planet2)\n\n    start_idx = min(idx1, idx2) + 1\n    end_idx = max(idx1, idx2)\n\n    intermediate_planets = planets_ordered[start_idx:end_idx]\n\n    return tuple(intermediate_planets)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/129": [{"task_id": "HumanEval/129", "solution": "class Cell:\n    def __init__(self, value, row, col):\n        self.value = value\n        self.row = row\n        self.col = col\n\n    def __eq__(self, other):\n        # Compares cells based on their grid coordinates.\n        return self.row == other.row and self.col == other.col\n\n    def __hash__(self):\n        # Enables Cell objects to be used in hash-based collections.\n        return hash((self.row, self.col))\nclass Path:\n    def __init__(self, values):\n        self.values = values\n        self.length = len(values)\n\n    def __lt__(self, other):\n        # Compares paths lexicographically based on their value sequences.\n        return self.values < other.values\nclass GridValidator:\n    def validate_grid(self, grid):\n        # As per critical requirements, comprehensive validation is skipped.\n        # Assumes grid is N x N and returns N.\n        N = len(grid)\n        return N\nclass KValidator:\n    def validate_k(self, k, N):\n        # As per critical requirements, comprehensive validation is skipped.\n        # Assumes k is a positive integer compatible with N.\n        pass\ndef _get_neighbors(row, col, N):\n    \"\"\"Returns valid adjacent neighbor coordinates (row, col) within the grid.\"\"\"\n    neighbors = []\n    # Defines possible movements: Up, Down, Left, Right.\n    directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n    for dr, dc in directions:\n        nr, nc = row + dr, col + dc\n        if 0 <= nr < N and 0 <= nc < N:\n            neighbors.append((nr, nc))\n    return neighbors\ndef _find_paths_dfs(grid_cells, N, k, current_path_values, r, c, all_paths):\n    \"\"\"Recursively finds all paths of length k starting from (r,c) using DFS.\"\"\"\n    # Base case: if the current path has reached the desired length k, add it.\n    if len(current_path_values) == k:\n        all_paths.append(Path(list(current_path_values)))\n        return\n\n    # Recursive step: explore all valid neighbors to extend the path.\n    for nr, nc in _get_neighbors(r, c, N):\n        _find_paths_dfs(grid_cells, N, k, current_path_values + [grid_cells[nr][nc].value], nr, nc, all_paths)\ndef minPath(grid, k):\n    \"\"\"\n    Finds the lexicographically minimum path of length k in the grid.\n    Starts from any cell and moves to adjacent neighbors.\n    \"\"\"\n    # Initialize validators, which will operate under strict assumptions per critical requirements.\n    grid_validator = GridValidator()\n    k_validator = KValidator()\n\n    N = grid_validator.validate_grid(grid)\n    k_validator.validate_k(k, N)\n\n    # Convert the input grid into a 2D array of Cell objects for easier manipulation.\n    grid_cells = [[Cell(grid[r][c], r, c) for c in range(N)] for r in range(N)]\n\n    all_paths = []\n\n    # Iterate through each cell in the grid to consider it as a potential starting point.\n    for r in range(N):\n        for c in range(N):\n            # Start the Depth-First Search (DFS) from the current cell.\n            # The path begins with the value of the starting cell itself.\n            _find_paths_dfs(grid_cells, N, k, [grid_cells[r][c].value], r, c, all_paths)\n\n    # Find the lexicographically smallest path from all generated paths.\n    # The Path class's __lt__ method handles the comparison.\n    min_path = min(all_paths)\n\n    return min_path.values", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[[[12, 13, 10, 1], [9, 3, 15, 6], [5, 16, 14, 4], [11, 8, 7, 2]], 12]], "plus_fail_tests": [[[[1, 2, 3], [4, 5, 6], [7, 8, 9]], 15]]}, {"task_id": "HumanEval/129", "solution": "def minPath(grid: list[list[int]], k: int) -> list[int]:\n    \"\"\"\n    Finds the lexicographically smallest path of length k in a grid.\n    The path can start from any cell and move to adjacent cells, revisiting cells is allowed.\n    \"\"\"\n\n    class Cell:\n        \"\"\"Represents an individual cell in the grid with coordinates and a value.\"\"\"\n        def __init__(self, row: int, col: int, value: int):\n            self.row = row\n            self.col = col\n            self.value = value\n\n        def getValue(self) -> int:\n            \"\"\"Returns the integer value of the cell.\"\"\"\n            return self.value\n\n        def __eq__(self, other):\n            \"\"\"Compares two cells by their coordinates and value.\"\"\"\n            if not isinstance(other, Cell):\n                return NotImplemented\n            return self.row == other.row and self.col == other.col and self.value == other.value\n\n        def __hash__(self):\n            \"\"\"Returns a hash for the cell, useful for sets/dictionaries.\"\"\"\n            return hash((self.row, self.col, self.value))\n\n    class Grid:\n        \"\"\"Represents the N x N grid, managing Cell objects and neighbors.\"\"\"\n        def __init__(self, grid_data: list[list[int]]):\n            self.N = len(grid_data)\n            self.cells = [[None for _ in range(self.N)] for _ in range(self.N)]\n            for r in range(self.N):\n                for c in range(self.N):\n                    self.cells[r][c] = Cell(r, c, grid_data[r][c])\n\n        def getCell(self, row: int, col: int) -> Cell:\n            \"\"\"Retrieves the Cell object at the given coordinates.\"\"\"\n            return self.cells[row][col]\n\n        def getNeighbors(self, cell: Cell) -> list[Cell]:\n            \"\"\"Returns a list of valid adjacent Cell objects (up, down, left, right).\"\"\"\n            neighbors = []\n            directions = [(-1, 0), (1, 0), (0, -1), (0, 1)] # Up, Down, Left, Right\n            for dr, dc in directions:\n                new_row, new_col = cell.row + dr, cell.col + dc\n                if 0 <= new_row < self.N and 0 <= new_col < self.N:\n                    neighbors.append(self.cells[new_row][new_col])\n            return neighbors\n\n    class Path:\n        \"\"\"Represents a sequence of visited Cell objects with lexicographical comparison.\"\"\"\n        def __init__(self, k: int):\n            self.length = k\n            self.sequence_of_cells: list[Cell] = []\n            self.values: list[int] = []\n\n        def add_cell(self, cell: Cell):\n            \"\"\"Adds a cell to the end of the path.\"\"\"\n            self.sequence_of_cells.append(cell)\n            self.values.append(cell.getValue())\n\n        def get_values(self) -> list[int]:\n            \"\"\"Returns the ordered list of cell values in the path.\"\"\"\n            return self.values\n\n        def __lt__(self, other: 'Path') -> bool:\n            \"\"\"Compares two paths lexicographically based on their cell values.\"\"\"\n            for i in range(len(self.values)):\n                if self.values[i] < other.values[i]:\n                    return True\n                if self.values[i] > other.values[i]:\n                    return False\n            return False # Paths are equal or self is not less than other\n\n    class PathFinderService:\n        \"\"\"Service to find the minimum path using Depth-First Search.\"\"\"\n        def __init__(self, grid: Grid, k: int):\n            self.grid = grid\n            self.k = k\n\n        def find_minimum_path(self) -> list[int]:\n            \"\"\"Initiates DFS from all possible starting cells to find the minimum path.\"\"\"\n            max_possible_value = self.grid.N * self.grid.N\n\n            # Initialize a Path object representing a very large path for comparison.\n            min_path_obj = Path(self.k)\n            # Create a dummy cell with a value larger than any in the grid.\n            dummy_cell = Cell(-1, -1, max_possible_value + 1)\n            for _ in range(self.k):\n                min_path_obj.add_cell(dummy_cell)\n\n            # Use a list to wrap the min_path_obj, allowing it to be updated by reference in DFS.\n            min_path_wrapper = [min_path_obj]\n\n            for r in range(self.grid.N):\n                for c in range(self.grid.N):\n                    start_cell = self.grid.getCell(r, c)\n                    current_path = Path(self.k)\n                    current_path.add_cell(start_cell)\n\n                    self._dfs(start_cell, current_path, 1, min_path_wrapper)\n\n            return min_path_wrapper[0].get_values()\n\n        def _dfs(self, current_cell: Cell, current_path_obj: Path, current_length: int, min_path_wrapper: list[Path]):\n            \"\"\"Recursively explores paths of length k using Depth-First Search.\"\"\"\n            if current_length == self.k:\n                # Compare the current path with the globally minimum path found.\n                if current_path_obj < min_path_wrapper[0]:\n                    # Update the global minimum path with a copy of the current path.\n                    min_path_wrapper[0] = Path(self.k)\n                    for cell in current_path_obj.sequence_of_cells:\n                        min_path_wrapper[0].add_cell(cell)\n                return\n\n            neighbors = self.grid.getNeighbors(current_cell)\n            for neighbor in neighbors:\n                current_path_obj.add_cell(neighbor)\n\n                # Recurse with the extended path.\n                self._dfs(neighbor, current_path_obj, current_length + 1, min_path_wrapper)\n\n                # Backtrack: Remove the last cell to explore other branches.\n                current_path_obj.sequence_of_cells.pop()\n                current_path_obj.values.pop()\n\n    # Instantiate Grid and PathFinderService based on inputs.\n    grid_instance = Grid(grid)\n    path_finder_service = PathFinderService(grid_instance, k)\n\n    # Find and return the minimum path values.\n    result = path_finder_service.find_minimum_path()\n    return result", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[[[12, 13, 10, 1], [9, 3, 15, 6], [5, 16, 14, 4], [11, 8, 7, 2]], 12]], "plus_fail_tests": [[[[1, 2, 3], [4, 5, 6], [7, 8, 9]], 15]]}], "HumanEval/149": [{"task_id": "HumanEval/149", "solution": "def sorted_list_sum(lst):\n    \"\"\"Deletes strings with odd lengths and sorts the remaining list.\n    Sorting is by length (ascending) then alphabetically (ascending).\n    \"\"\"\n    filtered_list = []\n    for item in lst:\n        if len(item) % 2 == 0:\n            filtered_list.append(item)\n\n    filtered_list.sort(key=lambda x: (len(x), x))\n    return filtered_list", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/149", "solution": "def sorted_list_sum(lst):\n    \"\"\"Filters a list of strings to retain only even-length strings,\n    then sorts them by length and alphabetically.\n    \"\"\"\n    even_length_strings = []\n    for s in lst:\n        if len(s) % 2 == 0:\n            even_length_strings.append(s)\n\n    even_length_strings.sort(key=lambda s: (len(s), s))\n    return even_length_strings", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/150": [{"task_id": "HumanEval/150", "solution": "def _is_prime(n):\n    \"\"\"Checks if an integer n is a prime number.\n    Returns True if n is prime, False otherwise.\n    \"\"\"\n    if n < 2:\n        return False\n    if n == 2:\n        return True\n    if