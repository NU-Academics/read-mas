rue.\n        \"\"\"\n        if not self._validate_digit_count():\n            return False\n        if not self._validate_dot_count():\n            return False\n        # The following checks are only relevant if a single dot exists and was validated.\n        if not self._validate_prefix_not_empty():\n            return False\n        if not self._validate_prefix_starts_with_letter():\n            return False\n        if not self._validate_extension_type():\n            return False\n        return True\n\n    def _validate_digit_count(self) -> bool:\n        \"\"\"Checks if the file name contains no more than three digits.\"\"\"\n        return self._digit_count <= 3\n\n    def _validate_dot_count(self) -> bool:\n        \"\"\"Checks if the file name contains exactly one dot.\"\"\"\n        return self._has_one_dot\n\n    def _validate_prefix_not_empty(self) -> bool:\n        \"\"\"Checks if the substring before the dot is not empty.\"\"\"\n        return bool(self._prefix)\n\n    def _validate_prefix_starts_with_letter(self) -> bool:\n        \"\"\"Checks if the substring before the dot starts with a latin letter.\"\"\"\n        return self._starts_with_letter\n\n    def _validate_extension_type(self) -> bool:\n        \"\"\"Checks if the file extension is one of the allowed types.\"\"\"\n        return self._has_valid_extension\ndef file_name_check(file_name: str) -> str:\n    \"\"\"\n    Checks if a given file name string is valid based on predefined rules.\n    Returns 'Yes' for valid names, 'No' otherwise.\n    \"\"\"\n    validator = FileName(file_name)\n    if validator.is_valid():\n        return 'Yes'\n    else:\n        return 'No'", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/142": [{"task_id": "HumanEval/142", "solution": "def sum_squares(lst: list[int]) -> int:\n    \"\"\"\"\n    This function will take a list of integers. For all entries in the list, the function shall square the integer entry if its index is a\n    multiple of 3 and will cube the integer entry if its index is a multiple of 4 and not a multiple of 3. The function will not\n    change the entries in the list whose indexes are not a multiple of 3 or 4. The function shall then return the sum of all entries.\n    \"\"\"\n    if not lst:\n        return 0\n\n    total_sum = 0\n    for index, value in enumerate(lst):\n        transformed_value = value\n        if index % 3 == 0:\n            transformed_value = value * value\n        elif index % 4 == 0: # This condition implicitly means index % 3 != 0 due to the preceding 'if'.\n            transformed_value = value * value * value\n\n        total_sum += transformed_value\n\n    return total_sum", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/142", "solution": "def sum_squares(lst):\n    \"\"\"\n    This function processes a list of integers, applying transformations based on their index, and returns the sum.\n    It squares elements at indices divisible by 3, cubes elements at indices divisible by 4 (but not 3), and sums them.\n    \"\"\"\n    if not lst:\n        return 0\n\n    running_sum = 0\n    for i, element in enumerate(lst):\n        if i % 3 == 0:\n            running_sum += element ** 2\n        elif i % 4 == 0:  # This condition implicitly handles 'and not a multiple of 3' due to the `elif` structure\n            running_sum += element ** 3\n        else:\n            running_sum += element\n    return running_sum", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/143": [{"task_id": "HumanEval/143", "solution": "import math\ndef _is_prime(n: int) -> bool:\n    \"\"\"\n    Checks if an integer is a prime number.\n    Numbers less than or equal to 1 are not prime.\n    \"\"\"\n    if n <= 1:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n    # Check for factors from 3 up to the square root of n, incrementing by 2.\n    for i in range(3, int(math.sqrt(n)) + 1, 2):\n        if n % i == 0:\n            return False\n    return True\ndef words_in_sentence(sentence: str) -> str:\n    \"\"\"\n    Filters words from a sentence, returning those whose lengths are prime numbers.\n    The order of words is preserved and they are joined by spaces.\n    \"\"\"\n    words = sentence.split(' ')\n    filtered_words_list = []\n\n    for word in words:\n        if _is_prime(len(word)):\n            filtered_words_list.append(word)\n\n    return ' '.join(filtered_words_list)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/143", "solution": "import math\ndef is_prime(n: int) -> bool:\n    \"\"\"Checks if a number is prime.\"\"\"\n    if n < 2:\n        return False\n    for i in range(2, int(math.sqrt(n)) + 1):\n        if n % i == 0:\n            return False\n    return True\ndef words_in_sentence(sentence: str) -> str:\n    \"\"\"\n    Filters words from a sentence, keeping only those with prime lengths.\n    Maintains original order and joins with spaces.\n    \"\"\"\n    prime_words = []\n    words = sentence.split()\n\n    for word in words:\n        if is_prime(len(word)):\n            prime_words.append(word)\n\n    return \" \".join(prime_words)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/83": [{"task_id": "HumanEval/83", "solution": "def starts_one_ends(n):\n    \"\"\"\n    Given a positive integer n, return the count of the numbers of n-digit\n    positive integers that start or end with 1.\n    \"\"\"\n    # Count numbers that start with 1 (e.g., for n=3, 100-199).\n    # This is 10^(n-1).\n    count_starts_with_one = 10**(n - 1)\n\n    # Count numbers that end with 1 (e.g., for n=3, 101, 111, ..., 991).\n    # For n=1, it's just 1. For n > 1, the first digit has 9 choices (1-9)\n    