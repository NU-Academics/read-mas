e(len(self._operators)):\n                expression_parts.append(self._operators[i].get_symbol())\n                expression_parts.append(str(self._operands[i+1].get_value()))\n            self._expression_string = \" \".join(expression_parts)\n            return self._expression_string\n\n        def evaluate_expression(self) -> float | int:\n            \"\"\"Evaluates the constructed algebraic expression string.\n            Uses Python's built-in eval() function to handle standard mathematical operator precedence.\n            \"\"\"\n            if self._expression_string is None:\n                self.construct_expression_string()\n            self._result = eval(self._expression_string)\n            return self._result\n\n        def get_expression_string(self) -> str | None:\n            \"\"\"Returns the constructed algebraic expression string.\"\"\"\n            return self._expression_string\n\n        def get_result(self) -> float | int | None:\n            \"\"\"Returns the numerical result of the evaluated expression.\"\"\"\n            return self._result\n\n\n    operand_objects = [Operand(val) for val in operand]\n    operator_objects = [Operator(sym) for sym in operator]\n\n    expression = Expression(operand_objects, operator_objects)\n    expression.construct_expression_string()\n    result = expression.evaluate_expression()\n\n    return result", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/161": [{"task_id": "HumanEval/161", "solution": "def solve(s):\n    \"\"\"You are given a string s.\n    if s[i] is a letter, reverse its case from lower to upper or vise versa,\n    otherwise keep it as it is.\n    If the string contains no letters, reverse the string.\n    The function should return the resulted string.\n    Examples\n    solve(\"1234\") = \"4321\"\n    solve(\"ab\") = \"AB\"\n    solve(\"#a@C\") = \"#A@c\"\n    \"\"\"\n    has_letters = False\n    for char in s:\n        if char