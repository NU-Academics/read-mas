ongest palindromic postfix.\n    prefix_to_reverse = string[:len(string) - len(longest_palindromic_postfix)]\n    reversed_prefix = prefix_to_reverse[::-1]\n\n    return string + reversed_prefix", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/12": [{"task_id": "HumanEval/12", "solution": "from typing import List, Optional\ndef longest(strings: List[str]) -> Optional[str]:\n    \"\"\"Returns the longest string from a list, prioritizing the first encountered if lengths are equal.\n    Returns None for an empty input list.\"\"\"\n    if not strings:\n        return None\n\n    longest_found: Optional[str] = None\n    max_length: int = -1\n\n    for current_string in strings:\n        current_string_length = len(current_string)\n        if current_string_length > max_length:\n            longest_found = current_string\n            max_length = current_string_length\n\n    return longest_found", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/12", "solution": "from typing import List, Optional\ndef longest(strings: List[str]) -> Optional[str]:\n    \"\"\" Out of list of strings, return the longest one. Return the first one in case of multiple\n    strings of the same length. Return None in case the input list is empty.\n    >>> longest([])\n\n    >>> longest(['a', 'b', 'c'])\n    'a'\n    >>> longest(['a', 'bb', 'ccc'])\n    'ccc'\n    \"\"\"\n    if not strings:\n        return None\n\n    longest_found: Optional[str] = None\n    max_length: int = -1\n\n    for s in strings:\n        current_length = len(s)\n        if current_length > max_length:\n            longest_found = s\n            max_length = current_length\n        # Per FR3, if current_length == max_length, no action is taken,\n        # preserving the first encountered string of maximum length.\n\n    return longest_found", "base_status": "pass", "plus_status": "pass", "base_fail_t