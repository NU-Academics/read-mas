{"task_id": "HumanEval/3", "solution": "```python\nfrom typing import List\n\n\ndef below_zero(operations: List[int]) -> bool:\n    \"\"\" You're given a list of deposit and withdrawal operations on a bank account that starts with\n    zero balance. Your task is to detect if at any point the balance of account fallls below zero, and\n    at that point function should return True. Otherwise it should return False.\n    >>> below_zero([1, 2, 3])\n    False\n    >>> below_zero([1, 2, -4, 5])\n    True\n    >>> below_zero([-1, 2, 3])\n    True\n    >>> below_zero([0, 0, 0])\n    False\n    >>> below_zero([])\n    False\n    >>> below_zero([10, -5, -6])\n    True\n    >>> below_zero([10, -5, -4])\n    False\n    \"\"\"\n    balance = 0\n    for op in operations:\n        balance += op\n        if balance < 0:\n            return True\n    return False\n```"}
{"task_id": "HumanEval/4", "solution": "```python\nfrom typing import List\n\n\ndef mean_absolute_deviation(numbers: List[float]) -> float:\n    \"\"\" For a given list of input numbers, calculate Mean Absolute Deviation\n    around the mean of this dataset.\n    Mean Absolute Deviation is the average absolute difference between each\n    element and a centerpoint (mean in this case):\n    MAD = average | x - x_mean |\n    >>> mean_absolute_deviation([1.0, 2.0, 3.0, 4.0])\n    1.0\n    >>> mean_absolute_deviation([10.0, 20.0, 30.0])\n    6.666666666666667\n    >>> mean_absolute_deviation([])\n    0.0\n    >>> mean_absolute_deviation([5.0])\n    0.0\n    \"\"\"\n    if not numbers:\n        return 0.0\n\n    data_mean = sum(numbers) / len(numbers)\n\n    absolute_differences = [abs(x - data_mean) for x in numbers]\n\n    mad = sum(absolute_differences) / len(absolute_differences)\n\n    return mad\n```"}
{"task_id": "HumanEval/5", "solution": "```python\nfrom typing import List\n\n\ndef intersperse(numbers: List[int], delimeter: int) -> List[int]:\n    \"\"\" Insert a number 'delimeter' between every two consecutive elements of input list `numbers'\n    >>> intersperse([], 4)\n    []\n    >>> intersperse([1, 2, 3], 4)\n    [1, 4, 2, 4, 3]\n    >>> intersperse([5], 10)\n    [5]\n    \"\"\"\n    result = []\n    # Iterate through the numbers with their indices\n    for i, num in enumerate(numbers):\n        result.append(num)\n        # If it's not the last element, append the delimeter\n        if i < len(numbers) - 1:\n            result.append(delimeter)\n    return result\n```"}
{"task_id": "HumanEval/6", "solution": "```python\nfrom typing import List\n\n\ndef parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\" Input to this function is a string represented multiple groups for nested parentheses separated by spaces.\n    For each of the group, output the deepest level of nesting of parentheses.\n    E.g. (()()) has maximum two levels of nesting while ((())) has three.\n\n    >>> parse_nested_parens('(()()) ((())) () ((())()())')\n    [2, 3, 1, 3]\n    \"\"\"\n    result = []\n    \n    groups = paren_string.split()\n\n    for group in groups:\n        current_level = 0\n        max_level = 0\n        for char in group:\n            if char == '(':\n                current_level += 1\n                max_level = max(max_level, current_level)\n            elif char == ')':\n                current_level -= 1\n        result.append(max_level)\n        \n    return result\n```"}
{"task_id": "HumanEval/7", "solution": "```python\nfrom typing import List\n\n\ndef filter_by_substring(strings: List[str], substring: str) -> List[str]:\n    \"\"\" Filter an input list of strings only for ones that contain given substring\n    >>> filter_by_substring([], 'a')\n    []\n    >>> filter_by_substring(['abc', 'bacd', 'cde', 'array'], 'a')\n    ['abc', 'bacd', 'array']\n    \"\"\"\n    filtered_strings = []\n    for s in strings:\n        if substring in s:\n            filtered_strings.append(s)\n    return filtered_strings\n```"}
{"task_id": "HumanEval/8", "solution": "```python\nfrom typing import List, Tuple\n\n\ndef sum_product(numbers: List[int]) -> Tuple[int, int]:\n    \"\"\" For a given list of integers, return a tuple consisting of a sum and a product of all the integers in a list.\n    Empty sum should be equal to 0 and empty product should be equal to 1.\n    >>> sum_product([])\n    (0, 1)\n    >>> sum_product([1, 2, 3, 4])\n    (10, 24)\n    \"\"\"\n    current_sum = 0\n    current_product = 1\n\n    for number in numbers:\n        current_sum += number\n        current_product *= number\n\n    return (current_sum, current_product)\n```"}
{"task_id": "HumanEval/9", "solution": "```python\nfrom typing import List, Tuple\n\n\ndef rolling_max(numbers: List[int]) -> List[int]:\n    \"\"\" From a given list of integers, generate a list of rolling maximum element found until given moment\n    in the sequence.\n    >>> rolling_max([1, 2, 3, 2, 3, 4, 2])\n    [1, 2, 3, 3, 3, 4, 4]\n    \"\"\"\n    result_list = []\n    current_max = None\n\n    for num in numbers:\n        if current_max is None or num > current_max:\n            current_max = num\n        result_list.append(current_max)\n\n    return result_list\n```"}
{"task_id": "HumanEval/10", "solution": "```python\nimport re\n\n\ndef _clean_string(text: str) -> str:\n    \"\"\"\n    Helper function to clean a string for palindrome checks.\n    It converts the string to lowercase and removes all non-alphanumeric characters.\n    \"\"\"\n    return re.sub(r'[^a-zA-Z0-9]', '', text).lower()\n\n\ndef is_palindrome(text: str) -> bool:\n    \"\"\"\n    Tests if a given string is a palindrome, ignoring case and non-alphanumeric characters.\n\n    Args:\n        text (str): The string to check.\n\n    Returns:\n        bool: True if the string is a palindrome, False otherwise.\n\n    Examples:\n        >>> is_palindrome(\"Madam\")\n        True\n        >>> is_palindrome(\"A man, a plan, a canal: Panama\")\n        True\n        >>> is_palindrome(\"Hello\")\n        False\n        >>> is_palindrome(\"12321\")\n        True\n    \"\"\"\n    cleaned_text = _clean_string(text)\n    return cleaned_text == cleaned_text[::-1]\n\n\ndef make_palindrome(text: str) -> str:\n    \"\"\"\n    Finds the shortest palindrome that begins with a supplied string.\n\n    This is achieved by identifying the longest suffix of the input string that is\n    itself a palindrome (using the same case-insensitive, alphanumeric-only logic\n    as `is_palindrome`). The portion of the string preceding this longest\n    palindromic suffix is then reversed and appended to the original string\n    to form the shortest possible palindrome.\n\n    Note on prompt phrasing: The prompt's description \"prepending the reverse\n    of the prefix before it\" might be interpreted in a way that conflicts with\n    the requirement \"begins with a supplied string\". This implementation\n    adheres to the common algorithm that produces the shortest palindrome\n    *starting with* the input string, which typically involves appending\n    characters.\n\n    Args:\n        text (str): The string to extend into a palindrome.\n\n    Returns:\n        str: The shortest palindrome that starts with the input string.\n\n    Examples:\n        >>> make_palindrome(\"google\")\n        'googlelgoog'\n        >>> make_palindrome(\"Race\")\n        'RacecaR'\n        >>> make_palindrome(\"abcd\")\n        'abcdcba'\n        >>> make_palindrome(\"madam\")\n        'madam'\n        >>> make_palindrome(\"A man, a plan, a canal: Panama\")\n        'A man, a plan, a canal: Panama'\n        >>> make_palindrome(\"hello\")\n        'hellolleh'\n    \"\"\"\n    if is_palindrome(text):\n        return text\n\n    # Find the longest palindromic suffix.\n    # We iterate from the beginning of the string, considering each substring\n    # from 'text[i:]' as a potential suffix. The first 'i' for which 'text[i:]'\n    # is a palindrome gives us the longest palindromic suffix.\n    # The part of the string before this suffix (`text[:i]`) is the prefix\n    # whose reverse we need to append.\n    \n    prefix_to_reverse = \"\"\n    for i in range(len(text)):\n        suffix = text[i:]\n        if is_palindrome(suffix):\n            prefix_to_reverse = text[:i]\n            break\n    \n    # The shortest palindrome that begins with the original 'text' is formed by\n    # appending the reverse of the identified non-palindromic prefix.\n    return text + prefix_to_reverse[::-1]\n\n# Example Usage\nif __name__ == \"__main__\":\n    print(\"--- is_palindrome examples ---\")\n    print(f\"'Madam': {is_palindrome('Madam')}\")\n    print(f\"'A man, a plan, a canal: Panama': {is_palindrome('A man, a plan, a canal: Panama')}\")\n    print(f\"'Hello': {is_palindrome('Hello')}\")\n    print(f\"'Racecar': {is_palindrome('Racecar')}\")\n    print(f\"'12321': {is_palindrome('12321')}\")\n    print(f\"'Was it a car or a cat I saw?': {is_palindrome('Was it a car or a cat I saw?')}\")\n    print(f\"Empty string: {is_palindrome('')}\")\n\n    print(\"\\n--- make_palindrome examples ---\")\n    print(f\"make_palindrome('google'): '{make_palindrome('google')}'\")\n    print(f\"make_palindrome('Race'): '{make_palindrome('Race')}'\")\n    print(f\"make_palindrome('abcd'): '{make_palindrome('abcd')}'\")\n    print(f\"make_palindrome('madam'): '{make_palindrome('madam')}'\")\n    print(f\"make_palindrome('A man, a plan, a canal: Panama'): '{make_palindrome('A man, a plan, a canal: Panama')}'\")\n    print(f\"make_palindrome('hello'): '{make_palindrome('hello')}'\")\n    print(f\"make_palindrome('Python'): '{make_palindrome('Python')}'\")\n    print(f\"make_palindrome(''): '{make_palindrome('')}'\")\n    print(f\"make_palindrome('level'): '{make_palindrome('level')}'\")\n```"}
