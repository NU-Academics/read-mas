{"task_id": "HumanEval/64", "solution": "```python\nimport unittest\n\ndef vowels_count(s: str) -> int:\n    \"\"\"\n    Counts the number of vowels in a given string s.\n\n    Vowels are defined as 'a', 'e', 'i', 'o', 'u'.\n    'y' is also considered a vowel ONLY if it is the last character of the string s.\n    The function is case-insensitive. Non-alphabetic characters (like spaces,\n    punctuation) are implicitly ignored as they do not match any vowel criteria.\n\n    Args:\n        s: The input string.\n\n    Returns:\n        The total count of vowels in the string based on the given rules.\n    \"\"\"\n    vowel_count = 0\n    standard_vowels = {'a', 'e', 'i', 'o', 'u'}\n    s_lower = s.lower()\n    n = len(s_lower)\n\n    for i, char in enumerate(s_lower):\n        if char in standard_vowels:\n            vowel_count += 1\n        elif char == 'y':\n            # 'y' is a vowel only if it is the last character of the string s\n            if i == n - 1:\n                vowel_count += 1\n    return vowel_count\n\nclass TestVowelsCount(unittest.TestCase):\n\n    def test_empty_string(self):\n        self.assertEqual(vowels_count(\"\"), 0)\n\n    def test_no_vowels(self):\n        # String with no standard vowels and 'y' not at the end.\n        self.assertEqual(vowels_count(\"rhythm\"), 0)\n        self.assertEqual(vowels_count(\"bcdfg\"), 0)\n        self.assertEqual(vowels_count(\"BCDFG\"), 0)\n        self.assertEqual(vowels_count(\"shh\"), 0)\n\n    def test_standard_vowels_only(self):\n        self.assertEqual(vowels_count(\"aeiou\"), 5)\n        self.assertEqual(vowels_count(\"AEIOU\"), 5)\n        self.assertEqual(vowels_count(\"apple\"), 2) # a, e\n        self.assertEqual(vowels_count(\"banana\"), 3) # a, a, a\n\n    def test_y_at_end_of_string(self):\n        self.assertEqual(vowels_count(\"sky\"), 1) # y\n        self.assertEqual(vowels_count(\"Fly\"), 1) # y (case-insensitive)\n        self.assertEqual(vowels_count(\"happy\"), 2) # a, y\n        self.assertEqual(vowels_count(\"mystery\"), 2) # e, y\n        self.assertEqual(vowels_count(\"lovely\"), 3) # o, e, y\n        self.assertEqual(vowels_count(\"aeiouy\"), 6) # a, e, i, o, u, y\n        self.assertEqual(vowels_count(\"y\"), 1) # 'y' is the last character\n        self.assertEqual(vowels_count(\"Y\"), 1) # 'Y' is the last character\n\n    def test_y_in_middle_of_string(self):\n        # 'y' should not be counted if not at the end of the string.\n        self.assertEqual(vowels_count(\"myths\"), 0) # No standard vowels, 'y' not at end\n        self.assertEqual(vowels_count(\"rhythmic\"), 1) # i (first 'y' ignored)\n        self.assertEqual(vowels_count(\"syzygy\"), 1) # Only the last 'y' counts.\n        self.assertEqual(vowels_count(\"gymnastics\"), 2) # a, i ('y' ignored)\n        self.assertEqual(vowels_count(\"yellow\"), 2) # e, o ('y' ignored)\n\n    def test_mixed_case(self):\n        self.assertEqual(vowels_count(\"HeLlO WoRlD\"), 3) # e, o, o\n        self.assertEqual(vowels_count(\"PyThOn PrOgRaMmInG\"), 4) # O, O, A, I\n        self.assertEqual(vowels_count(\"AeiOUy\"), 6) # A, e, i, O, U, y\n\n    def test_with_spaces_and_punctuation(self):\n        self.assertEqual(vowels_count(\"hello, world!\"), 3) # e, o, o\n        self.assertEqual(vowels_count(\"Python's cool.\"), 3) # o, o, o ('y' not at end of string)\n        self.assertEqual(vowels_count(\"How do you do?\"), 5) # o, o, o, u, o\n        self.assertEqual(vowels_count(\"Happy Birthday!\"), 4) # a, y (end of string), i, a\n\n    def test_longer_strings(self):\n        long_string = \"The quick brown fox jumps over the lazy dog.\"\n        # Vowels: e, u, i, o, o, u, o, e, e, a, o -> 11\n        # 'y' in 'lazy' is not counted because '.' is the last character of the string.\n        self.assertEqual(vowels_count(long_string), 11)\n\n        very_long_string = \"Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.\"\n        # No 'y' at the end of this string, so only standard vowels are counted.\n        self.assertEqual(vowels_count(very_long_string), 33)\n\n    def test_multiple_y_with_one_at_end(self):\n        # 'y' in \"happy\" is not at the end of the full string.\n        # 'y' in \"mystery\" IS at the end of the full string.\n        self.assertEqual(vowels_count(\"happy mystery\"), 3) # a, e, y\n\n        # 'y' in \"My\" is not at the end of the full string.\n        # 'y' in \"only\" is not at the end of the full string.\n        # 'y' in \"cry\" IS at the end of the full string.\n        self.assertEqual(vowels_count(\"My only cry\"), 2) # o, y\n\n    def test_complex_string_with_various_y_positions(self):\n        s = \"My rhythm is a mystery.\"\n        # 'M', 'y' (no, not last)\n        # ' '\n        # 'r', 'h', 'y' (no, not last), 't', 'h', 'm'\n        # 'i' (yes)\n        # 's'\n        # ' '\n        # 'a' (yes)\n        # ' '\n        # 'm', 'y' (no, not last), 's', 't', 'e' (yes), 'r', 'y' (yes, is last)\n        # '.'\n        # Total: i, a, e, y = 4\n        self.assertEqual(vowels_count(s), 4)\n\n# To run the tests:\nif __name__ == '__main__':\n    unittest.main(argv=['first-arg-is-ignored'], exit=False)\n```"}
{"task_id": "HumanEval/65", "solution": "```python\ndef circular_shift(x, shift):\n    \"\"\"Circular shift the digits of the integer x, shift the digits right by shift\n    and return the result as a string.\n    If shift > number of digits, return digits reversed.\n    >>> circular_shift(12, 1)\n    \"21\"\n    >>> circular_shift(12, 2)\n    \"12\"\n    \"\"\"\n    s_x = str(x)\n    n = len(s_x)\n\n    if shift > n:\n        return s_x[::-1]\n    else:\n        return s_x[-shift:] + s_x[:-shift]\n```"}
