{"task_id": "HumanEval/31", "solution": "import math\n\ndef is_prime(n):\n    \"\"\"Return true if a given number is prime, and false otherwise.\n    >>> is_prime(6)\n    False\n    >>> is_prime(101)\n    True\n    >>> is_prime(11)\n    True\n    >>> is_prime(13441)\n    True\n    >>> is_prime(61)\n    True\n    >>> is_prime(4)\n    False\n    >>> is_prime(1)\n    False\n    \"\"\"\n    if n <= 1:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n    for i in range(3, int(math.sqrt(n)) + 1, 2):\n        if n % i == 0:\n            return False\n    return True"}
{"task_id": "HumanEval/32", "solution": "```python\nimport math\n\n\ndef poly(xs: list, x: float):\n    \"\"\"\n    Evaluates polynomial with coefficients xs at point x.\n    return xs[0] + xs[1] * x + xs[1] * x^2 + .... xs[n] * x^n\n    \"\"\"\n    return sum([coeff * math.pow(x, i) for i, coeff in enumerate(xs)])\n\n\ndef find_zero(xs: list) -> float:\n    \"\"\"\n    Finds a single root of a polynomial given its coefficients using Brent's Method.\n\n    Args:\n        xs: A list of polynomial coefficients, where xs[i] is the coefficient of x^i.\n            The list will always have an even number of coefficients (odd-degree polynomial),\n            guaranteeing at least one real root.\n\n    Returns:\n        A single zero point (root) of the polynomial.\n\n    Raises:\n        ValueError: If a bracketing interval cannot be found within defined limits\n                    or if Brent's method fails to converge.\n    \"\"\"\n\n    TOLERANCE = 1e-12\n    RELATIVE_TOLERANCE = 1e-12\n    MAX_ITERATIONS = 500\n    INITIAL_SEARCH_HALF_WIDTH = 1.0\n    MAX_SEARCH_HALF_WIDTH = 1e15\n\n    def _find_bracketing_interval(coeffs: list) -> tuple[float, float]:\n        x0 = 0.0\n        fx0 = poly(coeffs, x0)\n\n        if abs(fx0) < TOLERANCE:\n            return x0, x0\n\n        current_half_width = INITIAL_SEARCH_HALF_WIDTH\n        while current_half_width <= MAX_SEARCH_HALF_WIDTH:\n            x_pos = current_half_width\n            x_neg = -current_half_width\n\n            fx_pos = poly(coeffs, x_pos)\n            fx_neg = poly(coeffs, x_neg)\n\n            if abs(fx_pos) < TOLERANCE:\n                return x_pos, x_pos\n            if abs(fx_neg) < TOLERANCE:\n                return x_neg, x_neg\n\n            if fx0 * fx_pos < 0:\n                return x0, x_pos\n            if fx0 * fx_neg < 0:\n                return x_neg, x0\n            if fx_neg * fx_pos < 0:\n                return x_neg, x_pos\n\n            current_half_width *= 2.0\n\n        a_final = -MAX_SEARCH_HALF_WIDTH\n        b_final = MAX_SEARCH_HALF_WIDTH\n        fa_final = poly(coeffs, a_final)\n        fb_final = poly(coeffs, b_final)\n\n        if fa_final * fb_final < 0:\n            return a_final, b_final\n        else:\n            raise ValueError(\"Could not find a bracketing interval for the root within specified limits.\")\n\n\n    def _brentq(coeffs: list, a: float, b: float) -> float:\n        fa = poly(coeffs, a)\n        fb = poly(coeffs, b)\n\n        if abs(fa) < TOLERANCE: return a\n        if abs(fb) < TOLERANCE: return b\n\n        if abs(fa) < abs(fb):\n            a, b = b, a\n            fa, fb = fb, fa\n        \n        c, fc = a, fa\n        d = e = b - a\n\n        for _ in range(MAX_ITERATIONS):\n            if abs(b - a) < TOLERANCE or abs(fb) < RELATIVE_TOLERANCE * abs(b) + TOLERANCE:\n                return b\n\n            s = None\n\n            if fa != fc and fb != fc:\n                term1 = a * fb * fc / ((fa - fb) * (fa - fc))\n                term2 = b * fa * fc / ((fb - fa) * (fb - fc))\n                term3 = c * fa * fb / ((fc - fa) * (fc - fb))\n                s = term1 + term2 + term3\n            else:\n                s = b - fb * (b - a) / (fb - fa)\n\n            accept_s = True\n            if not ((3 * a + b) / 4 < s < (3 * b + a) / 4 if a < b else (3 * b + a) / 4 < s < (3 * a + b) / 4):\n                accept_s = False\n            if abs(s - b) < 0.5 * abs(e):\n                accept_s = False\n            if abs(s - b) < TOLERANCE:\n                 accept_s = False\n\n            if not accept_s:\n                s = (a + b) / 2.0\n\n            fs = poly(coeffs, s)\n\n            e = d\n            d = b - s\n\n            if fa * fs < 0:\n                b, fb = s, fs\n            else:\n                a, fa = s, fs\n            \n            c, fc = b, fb\n\n            if abs(fa) < abs(fb):\n                a, b = b, a\n                fa, fb = fb, fa\n            \n            if abs(fs) < TOLERANCE:\n                return s\n\n        raise ValueError(\"Brent's method failed to converge within MAX_ITERATIONS.\")\n\n\n    a, b = _find_bracketing_interval(xs)\n\n    if a == b:\n        return a\n\n    root = _brentq(xs, a, b)\n    \n    return root\n```"}
{"task_id": "HumanEval/33", "solution": "```python\ndef sort_third(l: list):\\\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the indicies that are not divisible by three, while its values at the indicies that are divisible by three are equal\n    to the values of the corresponding indicies of l, but sorted.\n    >>> sort_third([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_third([5, 6, 3, 4, 8, 9, 2])\n    [2, 6, 3, 4, 8, 9, 5]\n    \"\"\"\n    if not l:\\\n        return []\n\n    values_at_third_indices = []\n    for i, x in enumerate(l):\n        if i % 3 == 0:\n            values_at_third_indices.append(x)\n\n    values_at_third_indices.sort()\n\n    result_list = list(l)\n\n    sorted_values_ptr = 0\n    for i in range(len(l)):\n        if i % 3 == 0:\n            result_list[i] = values_at_third_indices[sorted_values_ptr]\n            sorted_values_ptr += 1\n            \n    return result_list\n```"}
