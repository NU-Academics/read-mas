{"task_id": "Mbpp/720", "solution": "def _build_result_tuple(tupleInput, dictInput) -> tuple:\n    \"\"\"Constructs a new tuple from the input tuple and dictionary.\n    The dictionary is added as the last element.\n    \"\"\"\n    return tupleInput + (dictInput,)\ndef add_dict_to_tuple(tupleInput, dictInput) -> tuple:\n    \"\"\"Adds a dictionary as the last element to an existing tuple.\n    Returns a new tuple without modifying the inputs.\n    \"\"\"\n    _validate_inputs(tupleInput, dictInput)\n    return _build_result_tuple(tupleInput, dictInput)"}
{"task_id": "Mbpp/721", "solution": "import math\ndef maxAverageOfPath(matrix: list[list[float]]) -> float:\n    \"\"\"\n    Computes the maximum average path from top-left to bottom-right in a matrix,\n    moving only right or down.\n    \"\"\"\n    n = len(matrix)\n    if n == 0:\n        return 0.0 # Or raise an error based on broader error handling spec, currently not covered by design for N=0.\n    if n == 1:\n        return float(matrix[0][0])\n\n    # dp[i][j] stores the maximum sum to reach cell (i, j)\n    dp = [[0.0] * n for _ in range(n)]\n\n    # Initialize dp table\n    dp[0][0] = float(matrix[0][0])\n\n    # Initialize first row\n    for j in range(1, n):\n        dp[0][j] = dp[0][j-1] + float(matrix[0][j])\n\n    # Initialize first column\n    for i in range(1, n):\n        dp[i][0] = dp[i-1][0] + float(matrix[i][0])\n\n    # Fill the rest of the dp table\n    for i in range(1, n):\n        for j in range(1, n):\n            dp[i][j] = float(matrix[i][j]) + max(dp[i-1][j], dp[i][j-1])\n\n    # The total number of cells in any valid path is 2*N - 1\n    path_length = 2 * n - 1\n    return dp[n-1][n-1] / path_length"}
{"task_id": "Mbpp/722", "solution": "from typing import Dict, Tuple\ndef filter_data(data: Dict[str, Tuple[float, float]], min_height: float, min_weight: float) -> Dict[str, Tuple[float, float]]:\n    \"\"\"Return a dict of entries where height > min_height AND weight >= min_weight.\"\"\"\n    filtered_students = {}\n    for name, (height, weight) in data.items():\n        if height > min_height and weight >= min_weight:\n            filtered_students[name] = (height, weight)\n    return filtered_students"}
{"task_id": "Mbpp/723", "solution": "def count_same_pair(a: list, b: list) -> int:\n    \"\"\"\n    Counts indices where the lists have the same values.\n    Raises ValueError if input lists have different lengths.\n    \"\"\"\n    if len(a) != len(b):\n        raise ValueError(\"Input lists must have the same length.\")\n\n    count = 0\n    for i in range(len(a)):\n        if a[i] == b[i]:\n            count += 1\n            \n    return count"}
{"task_id": "Mbpp/724", "solution": "def power_base_sum(base: int, power: int) -> int:\n    \"\"\"\n    Calculates the sum of all digits of the base to the specified power.\n    \"\"\"\n\n    def computePower(base: int, power: int) -> int:\n        \"\"\"Computes base raised to power, raising ValueError for negative power.\"\"\"\n        if power < 0:\n            raise ValueError(\"Power must be a non-negative integer.\")\n        return base ** power\n\n    def toDecimalString(value: int) -> str:\n        \"\"\"Converts an integer to its decimal string representation, ignoring the sign.\"\"\"\n        return str(abs(value))\n\n    def computeDigitSum(decimalString: str) -> int:\n        \"\"\"Sums numeric values of characters in a decimal string, validating characters.\"\"\"\n        total_sum = 0\n        for char_digit in decimalString:\n            if not '0' <= char_digit <= '9':\n                raise ValueError(\"Decimal string must contain only '0'-'9' characters.\")\n            total_sum += int(char_digit)\n        return total_sum\n\n    # Orchestrate the helper functions\n    power_result = computePower(base, power)\n    decimal_representation = toDecimalString(power_result)\n    digit_sum = computeDigitSum(decimal_representation)\n    return digit_sum"}
{"task_id": "Mbpp/725", "solution": "import dataclasses\nfrom typing import List, TypeAlias\nResultList: TypeAlias = List[str]\ndef extract_quotation(input_str: str) -> ResultList:\n    \"\"\"\n    Extracts values between quotation marks \" \" from the given string.\n    Only complete pairs of ASCII double quotes are processed, unmatched quotes are ignored.\n    \"\"\"\n    input_obj = InputString(input_str)\n    extracted_values: ResultList = []\n    \n    in_quote = False\n    start_index = -1\n\n    for i in range(input_obj.length):\n        if input_obj.text[i] == '\"':\n            if not in_quote:\n                # Found opening quote\n                start_index = i + 1\n                in_quote = True\n            else:\n                # Found closing quote\n                if start_index != -1: # Ensure there was an opening quote\n                    value = input_obj.text[start_index:i]\n                    # No need to create QuotedSubstring object explicitly here\n                    # as we only need the value for the ResultList.\n                    extracted_values.append(value)\n                in_quote = False\n                start_index = -1 # Reset start_index for the next pair\n\n    return extracted_values"}
{"task_id": "Mbpp/726", "solution": "from typing import Tuple, Union\nNumber = Union[int, float]\ndef multiply_elements(t: Tuple[Number, ...]) -> Tuple[Number, ...]:\n    \"\"\"\n    Computes the product of adjacent elements in a tuple and returns them as a new tuple.\n    Raises ValueError if the input tuple has fewer than two elements.\n    \"\"\"\n    if len(t) < 2:\n        raise ValueError(\"Input tuple must have at least two elements.\")\n\n    products = []\n    for i in range(len(t) - 1):\n        products.append(t[i] * t[i+1])\n    return tuple(products)"}
