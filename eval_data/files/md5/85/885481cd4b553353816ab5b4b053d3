{"task_id": "Mbpp/63", "solution": "from typing import List, Tuple\ndef _abs_diff(pair: Tuple[int, int]) -> int:\n    \"\"\"Return abs(pair[0] - pair[1]); expects validated pair of ints.\"\"\"\n    return abs(pair[0] - pair[1])\ndef _validate_pairs(pairs) -> List[Tuple[int, int]]:\n    \"\"\"\n    Validate input and return a materialized list of valid pairs or raise.\n    Checks for iterable input, non-empty list, 2-element tuples/lists, and integer elements.\n    \"\"\"\n    if not hasattr(pairs, '__iter__'):\n        raise TypeError(\"Input must be an iterable (e.g., list, tuple).\")\n\n    validated_list: List[Tuple[int, int]] = []\n    for i, item in enumerate(pairs):\n        if not (isinstance(item, (tuple, list)) and len(item) == 2):\n            raise TypeError(f\"Element at index {i} must be a 2-element tuple or list.\")\n        if not (isinstance(item[0], int) and isinstance(item[1], int)):\n            raise TypeError(f\"Elements within pair at index {i} must be integers.\")\n        validated_list.append((item[0], item[1]))\n\n    if not validated_list:\n        raise ValueError(\"Input list cannot be empty.\")\n\n    return validated_list\ndef max_difference(pairs: List[Tuple[int, int]]) -> int:\n    \"\"\"\n    Compute the maximum absolute difference among a list of 2-int tuples.\n\n    Args:\n        pairs: List[Tuple[int, int]] -- input list of 2-element integer tuples.\n\n    Returns:\n        int -- maximum abs(a - b) among pairs.\n\n    Raises:\n        TypeError -- when any element is not a 2-tuple of integers (BR4)\n        ValueError -- when the input list is empty (BR5 recommendation)\n    \"\"\"\n    validated_pairs = _validate_pairs(pairs)\n\n    max_diff = _abs_diff(validated_pairs[0])\n\n    for i in range(1, len(validated_pairs)):\n        current_diff = _abs_diff(validated_pairs[i])\n        if current_diff > max_diff:\n            max_diff = current_diff\n\n    return max_diff"}
{"task_id": "Mbpp/67", "solution": "import math\nfrom functools import lru_cache\nclass Validator:\n    \"\"\"Validates input parameters for the Bell number function.\"\"\"\n    def validate(self, n) -> bool:\n        # Per explicit requirement: \"Do NOT add isinstance() checks or raise exceptions for edge cases\"\n        # The design context specified validation, but this requirement overrides it.\n        # Therefore, this method performs no actual validation or error raising.\n        return True\ndef bell_number(n) -> int:\n    \"\"\"\n    Finds the number of ways to partition a set of size n.\n    This function orchestrates validation (skipped as per requirements) and computation.\n    \"\"\"\n    Validator().validate(n)\n    return computeBell(n)"}
{"task_id": "Mbpp/59", "solution": "class InputValidator:\n    \"\"\"Validates if an input is a positive integer (n >= 1).\"\"\"\n    def is_valid_positive_integer(self, n) -> bool:\n        return isinstance(n, int) and n >= 1\nclass OctagonalCalculator:\n    \"\"\"Orchestrates validation and computes octagonal numbers.\"\"\"\n    def __init__(self, validator: InputValidator = None):\n        self._validator = validator or InputValidator()\n\n    def is_octagonal(self, n: int) -> int:\n        \"\"\"Validates input and returns the nth octagonal number.\"\"\"\n        if not self._validator.is_valid_positive_integer(n):\n            raise ValueError(\"n must be an integer >= 1\")\n        return self.compute(n)\n\n    def compute(self, n: int) -> int:\n        \"\"\"Computes the nth octagonal number using integer arithmetic.\"\"\"\n        return n * (3 * n - 2)\n_calculator = OctagonalCalculator()\ndef is_octagonal(n: int) -> int:\n    \"\"\"\n    Computes the nth octagonal number.\n    Raises ValueError if n is not an integer or is less than 1.\n    \"\"\"\n    return _calculator.is_octagonal(n)"}
{"task_id": "Mbpp/61", "solution": "from typing import Iterable, Tuple\ndef sum_digits(sub: str) -> int:\n    \"\"\"\n    Return sum of numeric values of characters in sub.\n    \"\"\"\n    return sum(int(char) for char in sub)\ndef count_Substrings(s: str) -> int:\n    \"\"\"\n    Count the number of substrings with the sum of digits equal to their length.\n    \"\"\"\n    if s == \"\":\n        return 0\n\n    # The design specifies `validate_input` as a helper.\n    # Per constraints, `count_Substrings` itself should not add explicit\n    # error handling or raise exceptions for invalid inputs.\n    # We assume valid digit string input for the core logic.\n\n    count = 0\n    for _, _, substring in enumerate_substrings(s):\n        if sum_digits(substring) == len(substring):\n            count += 1\n    return count"}
{"task_id": "Mbpp/65", "solution": "from typing import List\nclass Element:\n    \"\"\"Abstract base class for elements.\"\"\"\n    def is_integer(self) -> bool:\n        return False\n\n    def as_integer(self) -> int:\n        raise TypeError(\"Not an integer element.\")\n\n    def get_items(self) -> List['Element']:\n        return []\nclass IntegerElement(Element):\n    \"\"\"Represents an integer element with a value.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def is_integer(self) -> bool:\n        return True\n\n    def as_integer(self) -> int:\n        return self.value\nclass ListElement(Element):\n    \"\"\"Represents a list element containing other elements.\"\"\"\n    def __init__(self, items: List[Element]):\n        self.items = items\n\n    def get_items(self) -> List[Element]:\n        return self.items\nclass InputList:\n    \"\"\"Wraps a raw Python list and converts it to an Element tree.\"\"\"\n    def __init__(self, items: list):\n        self._elements = self._convert_to_elements(items)\n\n    def _convert_to_elements(self, raw_list: list) -> List[Element]:\n        \"\"\"Recursively converts a raw Python list to a list of Element objects.\"\"\"\n        elements: List[Element] = []\n        for item in raw_list:\n            if isinstance(item, int):\n                elements.append(IntegerElement(item))\n            elif isinstance(item, list):\n                elements.append(ListElement(self._convert_to_elements(item)))\n            else:\n                raise TypeError(f\"Unsupported element type: {type(item)}\")\n        return elements\n\n    def to_elements(self) -> List[Element]:\n        return self._elements\nclass FlattenOperation:\n    \"\"\"Flattens an Element tree into a list of IntegerElement.\"\"\"\n    def flatten(self, input_list: InputList) -> List[IntegerElement]:\n        \"\"\"Recursively traverses the Element tree, collecting all integer elements.\"\"\"\n        flattened_integers: List[IntegerElement] = []\n        \n        def _recursive_flatten(element_list: List[Element]):\n            for element in element_list:\n                if element.is_integer():\n                    flattened_integers.append(element)\n                else:\n                    _recursive_flatten(element.get_items())\n\n        _recursive_flatten(input_list.to_elements())\n        return flattened_integers\nclass SumOperation:\n    \"\"\"Sums the values of a list of IntegerElement.\"\"\"\n    def sum(self, items: List[IntegerElement]) -> int:\n        \"\"\"Returns the integer sum of the .value fields from a list of IntegerElement.\"\"\"\n        total_sum = 0\n        for item in items:\n            total_sum += item.as_integer()\n        return total_sum\nclass Function:\n    \"\"\"Coordinates FlattenOperation and SumOperation to process an InputList.\"\"\"\n    def __init__(self, name: str):\n        self.name = name\n        self.flatten_op = FlattenOperation()\n        self.sum_op = SumOperation()\n\n    def execute(self, input_list: InputList) -> int:\n        \"\"\"Executes the flattening and summing operations on the input list.\"\"\"\n        flattened_items = self.flatten_op.flatten(input_list)\n        final_sum = self.sum_op.sum(flattened_items)\n        return final_sum\ndef recursive_list_sum(input_list: list) -> int:\n    \"\"\"\n    Flattens a list (potentially nested) and sums all of its integer elements.\n    Assumes the top-level input is a list containing integers and/or nested lists.\n    \"\"\"\n    input_list_domain = InputList(input_list)\n    func = Function(name='recursive_list_sum')\n    return func.execute(input_list_domain)"}
{"task_id": "Mbpp/68", "solution": "def is_non_decreasing(array: list) -> bool:\n    \"\"\"\n    Checks if an array is non-decreasing (each element is less than or equal to the next).\n    Allows equal adjacent elements.\n    \"\"\"\n    for i in range(1, len(array)):\n        if array[i] < array[i-1]:\n            return False\n    return True\ndef is_non_increasing(array: list) -> bool:\n    \"\"\"\n    Checks if an array is non-increasing (each element is greater than or equal to the next).\n    Allows equal adjacent elements.\n    \"\"\"\n    for i in range(1, len(array)):\n        if array[i] > array[i-1]:\n            return False\n    return True\ndef is_Monotonic(array: list) -> bool:\n    \"\"\"\n    Checks if the given array is monotonic, meaning it is either entirely non-increasing\n    or entirely non-decreasing. Input validation ensures it's a list of numbers.\n    \"\"\"\n    if not isinstance(array, list):\n        raise TypeError(\"is_Monotonic requires a list of ints/floats\")\n    for x in array:\n        if not isinstance(x, (int, float)):\n            raise TypeError(\"is_Monotonic requires a list of ints/floats\")\n\n    return is_non_increasing(array) or is_non_decreasing(array)"}
{"task_id": "Mbpp/71", "solution": "def comb_sort(lst: list) -> list:\n    \"\"\"Accepts a Python list and returns a sorted Python list (ascending) containing exactly the same elements.\"\"\"\n    n = len(lst)\n    if n <= 1:\n        return lst[:]  # Return a copy even if list is empty or single element\n\n    arr = lst[:]  # Create a copy to avoid modifying the original list\n    gap = n\n    shrink_factor = 1.3\n    swapped = True\n\n    while gap > 1 or swapped:\n        if gap > 1:\n            gap = int(gap / shrink_factor)\n            if gap < 1: # Ensure gap is at least 1\n                gap = 1\n\n        swapped = False\n        for i in range(n - gap):\n            if arr[i] > arr[i + gap]:\n                arr[i], arr[i + gap] = arr[i + gap], arr[i]\n                swapped = True\n    return arr"}
{"task_id": "Mbpp/69", "solution": "def is_sublist(source_list, sub_list) -> bool:\n    \"\"\"Checks if a sublist exists contiguously within a source list.\n    Returns True if found, False otherwise.\"\"\"\n    len_source = len(source_list)\n    len_sub = len(sub_list)\n\n    if len_sub > len_source:\n        return False\n\n    for i in range(len_source - len_sub + 1):\n        if source_list[i : i + len_sub] == sub_list:\n            return True\n            \n    return False"}
