{"task_id": "Mbpp/420", "solution": "class Number:\n    \"\"\"Encapsulates a single integer value and provides a method to compute its cube.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def cube(self) -> int:\n        \"\"\"Return the cube of the stored value.\"\"\"\n        return self.value ** 3\nclass EvenNumberSequence:\n    \"\"\"Encapsulates generation of the first n even natural numbers.\"\"\"\n    def generate(self, n: int) -> list[Number]:\n        \"\"\"Return a list of Number objects for the first n even natural numbers (2, 4, ...).\"\"\"\n        sequence = []\n        for i in range(1, n + 1):\n            even_number = 2 * i\n            sequence.append(Number(even_number))\n        return sequence\nclass CalculationResult:\n    \"\"\"Encapsulates the calculation result (sum) representation.\"\"\"\n    def __init__(self, sum_value: int):\n        self.sum = sum_value\ndef cube_Sum(n):\n    \"\"\"Validate n and return int sum of cubes of first n even natural numbers. Raises ValueError for invalid n.\"\"\"\n    if not isinstance(n, int) or n <= 0:\n        raise ValueError(\"Input 'n' must be a positive integer.\")\n\n    even_sequence_generator = EvenNumberSequence()\n    even_numbers = even_sequence_generator.generate(n)\n\n    total_sum = 0\n    for num_obj in even_numbers:\n        total_sum += num_obj.cube()\n\n    result = CalculationResult(total_sum)\n    return result.sum"}
{"task_id": "Mbpp/419", "solution": "from typing import List\ndef round_and_sum(numbers: List[float]) -> int:\n    \"\"\"\n    Rounds each number in the list to the nearest integer, sums them,\n    multiplies the sum by the list's length, prints, and returns the result.\n    \"\"\"\n    if not numbers:\n        print(0)\n        return 0\n\n    sum_of_rounded = 0\n    for num in numbers:\n        sum_of_rounded += round(num)\n\n    list_length = len(numbers)\n    final_result = sum_of_rounded * list_length\n\n    print(final_result)\n    return final_result"}
{"task_id": "Mbpp/421", "solution": "def _convert_elements(tuple_input) -> list:\n    \"\"\"Returns a list of str conversions of each element in tuple_input using str().\"\"\"\n    return [str(item) for item in tuple_input]\ndef _join_elements(str_elements, delimiter) -> str:\n    \"\"\"Joins str_elements by delimiter and returns the resulting string.\"\"\"\n    return delimiter.join(str_elements)\ndef concatenate_tuple(tuple_input, delimiter='-') -> str:\n    \"\"\"Public API per SRS: tuple_input must be a tuple. Default delimiter is '-'. Raises TypeError if first arg is not a tuple.\"\"\"\n    _validate_input(tuple_input)\n    str_elements = _convert_elements(tuple_input)\n    return _join_elements(str_elements, delimiter)"}
{"task_id": "Mbpp/422", "solution": "class Parameter:\n    \"\"\"Handles validation of the input parameter 'n'.\"\"\"\n    def __init__(self, n_value):\n        self._n = n_value\n\n    def validate(self):\n        \"\"\"Validates that 'n' is an integer and is greater than or equal to 1.\"\"\"\n        if not isinstance(self._n, int) or self._n < 1:\n            raise ValueError(\"Input 'n' must be an integer greater than or equal to 1.\")\n        return self._n\nclass Computation:\n    \"\"\"Performs the mathematical computation for sum of cubes and average.\"\"\"\n    def computeSumOfCubes(self, n: int) -> int:\n        \"\"\"Calculates the sum of cubes of the first n natural numbers using a closed-form identity.\"\"\"\n        return (n * (n + 1) // 2) ** 2\n\n    def computeAverage(self, n: int, sum_of_cubes: int) -> float:\n        \"\"\"Calculates the average of the sum of cubes.\"\"\"\n        return sum_of_cubes / n\nclass Result:\n    \"\"\"Encapsulates the final computed average.\"\"\"\n    def __init__(self, average: float):\n        self.average = average\n\n    def format(self) -> float:\n        \"\"\"Returns the stored average.\"\"\"\n        return self.average\nclass Function:\n    \"\"\"Orchestrates the validation, computation, and result formatting for finding the average of cubes.\"\"\"\n    def __init__(self, name: str, n: int):\n        self.name = name\n        self.n = n\n        self.result = None\n\n    def computeAverage(self) -> float:\n        \"\"\"Executes the full process to find and return the average of cubes for 'n'.\"\"\"\n        param_validator = Parameter(self.n)\n        validated_n = param_validator.validate()\n\n        calculator = Computation()\n        sum_of_cubes = calculator.computeSumOfCubes(validated_n)\n        average_value = calculator.computeAverage(validated_n, sum_of_cubes)\n\n        final_result = Result(average_value)\n        self.result = final_result.format()\n        return self.result\ndef find_Average