{"task_id": "Mbpp/731", "solution": "import math\ndef lateralsurface_cone(r, h):\n    \"\"\"\n    Calculates the lateral surface area of a cone.\n    Formula: \u03c0 * r * sqrt(r^2 + h^2).\n    \"\"\"\n    slant_height = math.sqrt(r**2 + h**2)\n    lateral_area = math.pi * r * slant_height\n    return lateral_area"}
{"task_id": "Mbpp/730", "solution": "class EqualityOperator:\n    \"\"\"Helper class to encapsulate equality comparison.\"\"\"\n    def equals(self, a, b) -> bool:\n        \"\"\"Compares two elements using the standard Python equality operator.\"\"\"\n        return a == b\nclass ConsecutiveDuplicatesFunction:\n    \"\"\"Encapsulates the algorithm for removing consecutive duplicates.\"\"\"\n    def process(self, input_list: list) -> list:\n        \"\"\"\n        Removes consecutive duplicates from the input list,\n        keeping the first occurrence of each group.\n        \"\"\"\n        output_list = []\n        if not input_list:\n            return output_list\n\n        equality_op = EqualityOperator()\n\n        for element in input_list:\n            if not output_list or not equality_op.equals(output_list[-1], element):\n                output_list.append(element)\n        return output_list\ndef consecutive_duplicates(input_list: list) -> list:\n    \"\"\"\n    Public API to remove consecutive duplicates from a list.\n    Delegates the processing to ConsecutiveDuplicatesFunction.\n    \"\"\"\n    return ConsecutiveDuplicatesFunction().process(input_list)"}
{"task_id": "Mbpp/733", "solution": "def find_first_occurrence(array, target):\n    \"\"\"\n    Find the zero-based index of the first occurrence of target in a sorted array.\n    Returns -1 if the target is not found in the array.\n    \"\"\"\n    low = 0\n    high = len(array) - 1\n    result = -1\n\n    while low <= high:\n        mid = low + (high - low) // 2\n        if array[mid] == target:\n            result = mid  # Potential first occurrence\n            high = mid - 1  # Search in the left half for an earlier occurrence\n        elif array[mid] < target:\n            low = mid + 1\n        else:  # array[mid] > target\n            high = mid - 1\n    return result"}
{"task_id": "Mbpp/734", "solution": "from typing import List, Iterator\nfrom numbers import Number\nfrom functools import reduce\nfrom operator import mul\nclass SumResult:\n    \"\"\"Holds the aggregated sum of products.\"\"\"\n    def __init__(self, value: Number = 0):\n        self.value = value\ndef _compute_product(elements: List[Number]) -> Number:\n    \"\"\"Returns the numeric product of elements in a list.\"\"\"\n    if not elements:\n        return 1\n    return reduce(mul, elements, 1)\ndef _accumulate_sum(products: Iterator[Number]) -> SumResult:\n    \"\"\"Consumes an iterator of numeric products and returns their sum.\"\"\"\n    total_sum: Number = 0\n    for prod in products:\n        total_sum += prod\n    return SumResult(value=total_sum)\ndef sum_Of_Subarray_Prod(numbers: List[Number]) -> Number:\n    \"\"\"\n    Finds the sum of products of all possible non-empty contiguous sublists of a given list.\n    \"\"\"\n    _validate_input(numbers)\n\n    if not numbers:\n        return 0\n\n    products_iter = (_compute_product(sub.elements) for sub in _generate_contiguous_subarrays(numbers))\n    result = _accumulate_sum(products_iter)\n    return result.value"}
