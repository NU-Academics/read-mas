{"task_id": "Mbpp/128", "solution": "from typing import List\nclass Word:\n    \"\"\"Represents a single word with its text and original position.\"\"\"\n    def __init__(self, text: str, position: int) -> None:\n        self.text = text\n        self.position = position\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the word.\"\"\"\n        return len(self.text)\nclass InputString:\n    \"\"\"Encapsulates the raw input string and provides splitting functionality.\"\"\"\n    def __init__(self, raw: str) -> None:\n        self.raw = raw\n\n    def split(self) -> List[Word]:\n        \"\"\"Splits the raw string into a list of Word objects using whitespace.\"\"\"\n        words_text = self.raw.split()\n        return [Word(text, i) for i, text in enumerate(words_text)]\nclass WordList:\n    \"\"\"Manages a collection of Word objects and provides filtering capabilities.\"\"\"\n    def __init__(self, words: List[Word]) -> None:\n        self.words = words\n\n    def filter_length_gt(self, n: int) -> List[Word]:\n        \"\"\"Filters the words, keeping only those whose length is strictly greater than n.\"\"\"\n        return [word for word in self.words if word.length() > n]\n\n    def to_text_list(self) -> List[str]:\n        \"\"\"Converts the list of Word objects into a list of their text strings.\"\"\"\n        return [word.text for word in self.words]\nclass LongWordsFunction:\n    \"\"\"Orchestrates the process of finding long words from an input string.\"\"\"\n    def long_words(self, n: int, s: str) -> List[str]:\n        \"\"\"\n        Finds words longer than n characters from string s.\n        This method orchestrates the splitting and filtering pipeline.\n        \"\"\"\n        input_string = InputString(s)\n        words = input_string.split()\n        word_list = WordList(words)\n        filtered_words = word_list.filter_length_gt(n)\n        return WordList(filtered_words).to_text_list()\ndef long_words(n: int, s: str) -> List[str]:\n    \"\"\"\n    Finds words that are longer than n characters from a given string.\n    This is the public API function that delegates to the LongWordsFunction.\n    \"\"\"\n    return LongWordsFunction().long_words(n, s)"}
