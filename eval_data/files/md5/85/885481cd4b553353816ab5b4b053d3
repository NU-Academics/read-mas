{"task_id": "Mbpp/428", "solution": "from typing import List\nclass ShellSortModule:\n    \"\"\"Encapsulates Shell sort internals: gap sequence generation and gap-based insertion sort.\"\"\"\n\n    def __init__(self):\n        self._arr: List[int] = []\n\n    def generate_gap_sequence(self, n: int) -> List[int]:\n        \"\"\"Generates a descending sequence of gap sizes for Shell sort.\"\"\"\n        gaps: List[int] = []\n        gap = n // 2\n        while gap > 0:\n            gaps.append(gap)\n            gap //= 2\n        return gaps\n\n    def gap_insertion_sort(self, arr: List[int], gap: int) -> None:\n        \"\"\"Performs an in-place gapped insertion sort on the array using the given gap.\"\"\"\n        for i in range(gap, len(arr)):\n            temp = arr[i]\n            j = i\n            while j >= gap and arr[j - gap] > temp:\n                arr[j] = arr[j - gap]\n                j -= gap\n            arr[j] = temp\n\n    def shell_sort(self, input_list: List[int]) -> List[int]:\n        \"\"\"Sorts the internal array using Shell sort and returns the sorted copy.\"\"\"\n        self._arr = input_list.copy()\n        n = len(self._arr)\n\n        gaps = self.generate_gap_sequence(n)\n\n        for gap in gaps:\n            self.gap_insertion_sort(self._arr, gap)\n\n        return self._arr\ndef shell_sort(input_list: List[int]) -> List[int]:\n    \"\"\"Sorts a list of integers using the Shell sort algorithm.\"\"\"\n    if not input_list:\n        return []\n    if len(input_list) == 1:\n        return input_list.copy()\n\n    sorter = ShellSortModule()\n    return sorter.shell_sort(input_list)"}
{"task_id": "Mbpp/435", "solution": "def last_Digit(number):\n    \"\"\"\n    Computes the last digit of the integer part of a given number.\n    Handles negative numbers, float inputs, and raises TypeError for non-numeric inputs (BR2, BR3, BR4, BR5).\n    \"\"\"\n    if not isinstance(number, (int, float)):\n        raise TypeError(\"Input must be a numeric type (int or float).\")\n\n    int_part = int(number)\n    abs_part = abs(int_part)\n    digit = abs_part % 10\n    return digit"}
