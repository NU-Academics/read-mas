{"task_id": "Mbpp/763", "solution": "def find_min_diff(sequence, n):\n    \"\"\"\n    Finds the minimum difference between any two elements among the first n elements in the sequence.\n    Handles n greater than sequence length by capping n to the sequence length.\n    \"\"\"\n    seq_len = len(sequence)\n    \n    # Adjust n if it's greater than the sequence length\n    actual_n = min(n, seq_len)\n\n    # If actual_n is less than 2, it's impossible to find a difference between two distinct elements.\n    # Per instructions, we do not explicitly raise an error here for this edge case.\n    if actual_n < 2:\n        return float('inf')\n\n    # Extract the first 'actual_n' elements and convert to a list for sorting\n    first_n_elements = list(sequence)[:actual_n]\n\n    # Sort the elements to efficiently find minimum difference between adjacent elements\n    sorted_elements = sorted(first_n_elements)\n\n    min_difference = float('inf')\n\n    # Iterate through the sorted list to find the minimum difference between adjacent elements\n    for i in range(len(sorted_elements) - 1):\n        diff = abs(sorted_elements[i+1] - sorted_elements[i])\n        if diff < min_difference:\n            min_difference = diff\n            \n    return min_difference"}
{"task_id": "Mbpp/764", "solution": "def number_ctr(s: str) -> int:\n    \"\"\"\n    Counts the number of ASCII digits ('0'-'9') in the given string.\n    The function iterates through the string and increments a counter for each digit found.\n    \"\"\"\n    count = 0\n    for char in s:\n        if '0' <= char <= '9':\n            count += 1\n    return count"}
{"task_id": "Mbpp/769", "solution": "def Diff(list1, list2):\n    \"\"\"\n    Returns elements from list1 that are not present in list2, preserving their original order.\n    It iterates through list1 and appends items to a result list if they are not found in list2.\n    \"\"\"\n    set2 = set(list2)\n    result = []\n    for item in list1:\n        if item not in set2:\n            result.append(item)\n    return result"}
{"task_id": "Mbpp/770", "solution": "from typing import List\ndef _generate_odds(n: int) -> List[int]:\n    \"\"\"Return list of first n odd natural numbers: [1,3,5,...].\"\"\"\n    return [2 * k - 1 for k in range(1, n + 1)]\ndef _sum_fourth_powers(odds: List[int]) -> int:\n    \"\"\"Return sum(x**4 for x in odds).\"\"\"\n    return sum(x**4 for x in odds)\ndef odd_num_sum(n: int) -> int:\n    \"\"\"\n    Validate n, generate first n odd numbers, compute sum of fourth powers, and return int result.\n    \"\"\"\n    _validate_n(n)\n    odds = _generate_odds(n)\n    return _sum_fourth_powers(odds)"}
{"task_id": "Mbpp/765", "solution": "class ErrorHandler:\n    \"\"\"Handles error raising for invalid inputs.\"\"\"\n    def raiseInvalidInputError(self, message: str) -> None:\n        \"\"\"Raises a ValueError with the given message.\"\"\"\n        raise ValueError(message)\nclass InputValidator:\n    \"\"\"Validates input parameters.\"\"\"\n    def __init__(self):\n        self._error_handler = ErrorHandler()\n\n    def validateN(self, n) -> None:\n        \"\"\"Validates that n is an integer >= 1.\"\"\"\n        if not isinstance(n, int) or n < 1:\n            self._error_handler.raiseInvalidInputError(\"n must be an integer >= 1\")\nclass PoliteNumberCalculator:\n    \"\"\"Calculates the nth polite number.\"\"\"\n    def isPowerOfTwo(self, x: int) -> bool:\n        \"\"\"Checks if a positive integer is an exact power of two.\"\"\"\n        return x > 0 and (x & (x - 1)) == 0\n\n    def nextCandidate(self, current: int) -> int:\n        \"\"\"Returns the next integer candidate.\"\"\"\n        return current + 1\n\n    def getNthPolite(self, n: int) -> int:\n        \"\"\"Finds the nth polite number.\"\"\"\n        candidate = 1\n        polite_count = 0\n        while True:\n            if not self.isPowerOfTwo(candidate):\n                polite_count += 1\n                if polite_count == n:\n                    return candidate\n            candidate = self.nextCandidate(candidate)\ndef is_polite(n: int) -> int:\n    \"\"\"\n    Finds the nth polite number, which is a positive integer not a power of two.\n    \"\"\"\n    validator = InputValidator()\n    validator.validateN(n)\n    calculator = PoliteNumberCalculator()\n    return calculator.getNthPolite(n)"}
{"task_id": "Mbpp/766", "solution": "def pair_wise(input_list: list) -> list:\n    \"\"\"\n    Return a NEW list of 2-tuples containing consecutive items from input_list.\n    Returns an empty list if the input list has fewer than two elements.\n    \"\"\"\n    n = len(input_list)\n    if n < 2:\n        return []\n    result = []\n    for i in range(0, n - 1):\n        result.append((input_list[i], input_list[i+1]))\n    return result"}
{"task_id": "Mbpp/771", "solution": "class Stack:\n    \"\"\"A simple LIFO stack implementation.\"\"\"\n    def __init__(self) -> None:\n        self._items = []\n\n    def push(self, item: str) -> None:\n        self._items.append(item)\n\n    def pop(self) -> str | None:\n        if not self.isEmpty():\n            return self._items.pop()\n        return None\n\n    def isEmpty(self) -> bool:\n        return len(self._items) == 0\nBRACKET_PAIRS = {'(': ')', '[': ']', '{': '}'}\ndef check_expression(expression: str) -> bool:\n    \"\"\"Checks if the given expression has balanced brackets.\"\"\"\n    stack = Stack()\n    for char in expression:\n        if char in BRACKET_PAIRS:  # It's an opening bracket\n            stack.push(char)\n        elif char in BRACKET_PAIRS.values():  # It's a closing bracket\n            if stack.isEmpty():\n                return False\n            opening_bracket = stack.pop()\n            if BRACKET_PAIRS.get(opening_bracket) != char:\n                return False\n    return stack.isEmpty()"}
{"task_id": "Mbpp/767", "solution": "import collections\nclass Validator:\n    @staticmethod\n    def validate_list(seq):\n        \"\"\"Raise TypeError if seq is not list/tuple or contains non-numeric elements.\"\"\"\n        if not isinstance(seq, (list, tuple)):\n            raise TypeError(\"Input 'numbers' must be a list or tuple.\")\n        for item in seq:\n            if not isinstance(item, (int, float)):\n                raise TypeError(\"Elements in 'numbers' must be numeric (int or float).\")\n\n    @staticmethod\n    def validate_number(x):\n        \"\"\"Raise TypeError if x is not numeric (int/float).\"\"\"\n        if not isinstance(x, (int, float)):\n            raise TypeError(\"Input 'target' must be numeric (int or float).\")\ndef get_pairs_count(numbers, target):\n    \"\"\"Validate inputs and return number of unordered index pairs (i<j) where numbers[i] + numbers[j] == target.\n    Raises TypeError for invalid input types.\n    \"\"\"\n    Validator.validate_list(numbers)\n    Validator.validate_number(target)\n\n    n = len(numbers)\n    if n < 2:\n        return 0\n\n    count = 0\n    for i in range(n - 1):\n        for j in range(i + 1, n):\n            if numbers[i] + numbers[j] == target:\n                count += 1\n    return count"}
{"task_id": "Mbpp/772", "solution": "def remove_length(input_string: str, k: int) -> str:\n    \"\"\"\n    Removes all words of length k from the input string.\n    Words are separated by whitespace and rejoined with single spaces.\n    \"\"\"\n    def _tokenize_on_whitespace(s: str) -> list[str]:\n        \"\"\"Splits the input string into a list of words using whitespace as a delimiter.\"\"\"\n        return s.split()\n\n    def _matches_length(word: str, k: int) -> bool:\n        \"\"\"Returns True if the length of the word equals k, False otherwise.\"\"\"\n        return len(word) == k\n\n    def _join_words(words: list[str]) -> str:\n        \"\"\"Joins a list of words into a single string with single spaces, or returns an empty string if the list is empty.\"\"\"\n        return ' '.join(words)\n\n    tokens = _tokenize_on_whitespace(input_string)\n    kept_words = [word for word in tokens if not _matches_length(word, k)]\n    return _join_words(kept_words)"}
{"task_id": "Mbpp/773", "solution": "def occurance_substring(text, substring):\n    \"\"\"\n    Finds the first occurrence and position of the substring within a string.\n    Returns None if there is no match, otherwise returns a tuple with the matched substring,\n    its start index (inclusive), and its end index (exclusive).\n    \"\"\"\n    start_index = text.find(substring)\n    if start_index == -1:\n        return None\n    \n    end_index = start_index + len(substring)\n    return (substring, start_index, end_index)"}
