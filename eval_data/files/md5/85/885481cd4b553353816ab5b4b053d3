{"task_id": "Mbpp/130", "solution": "from typing import Any, List, Dict\nclass FrequencyCounter:\n    \"\"\"Maintains frequency counts for items in-memory.\"\"\"\n    def __init__(self) -> None:\n        self.counts: Dict[Any, int] = {}\n\n    def increment(self, item: Any) -> None:\n        \"\"\"Increments the count for a given item.\"\"\"\n        self.counts[item] = self.counts.get(item, 0) + 1\n\n    def get_counts(self) -> Dict[Any, int]:\n        \"\"\"Returns the dictionary of item counts.\"\"\"\n        return self.counts\n\n    def get_max_count(self) -> int:\n        \"\"\"Returns the maximum frequency count observed. Returns 0 if no items counted.\"\"\"\n        if not self.counts:\n            return 0\n        return max(self.counts.values())\ndef max_occurrences(items: List[Any]) -> Any:\n    \"\"\"Return the item value with maximum frequency from items, applying deterministic tie-breaking.\n    Raises TypeError or ValueError for invalid inputs as specified.\"\"\"\n    _validate_input(items)\n\n    counter = FrequencyCounter()\n    for item in items:\n        counter.increment(item)\n\n    max_count = counter.get_max_count()\n\n    # Iterate the original list to find the first item that matches max_count.\n    # This fulfills the deterministic tie-breaking rule (earliest-occurring item).\n    chosen_item: Any = None\n    for item in items:\n        if counter.get_counts().get(item, 0) == max_count:\n            chosen_item = item\n            break\n\n    return chosen_item"}
{"task_id": "Mbpp/131", "solution": "VOWELS: set[str] = {'a','e','i','o','u','A','E','I','O','U'}\ndef is_vowel(ch: str) -> bool:\n    \"\"\"Return True if ch is a vowel as defined by VOWELS, else False.\"\"\"\n    return ch in VOWELS\ndef reverse_vowels(s: str) -> str:\n    \"\"\"Reverse only vowel characters in s and return new string.\n\n    This function identifies vowels (a,e,i,o,u, case-insensitive, excluding 'y')\n    and reverses their order while preserving non-vowel characters' positions.\n    \"\"\"\n    if not s:\n        return \"\"\n\n    s_list = list(s)\n    vowel_indices = []\n    vowel_chars = []\n\n    for i, char in enumerate(s_list):\n        if is_vowel(char):\n            vowel_indices.append(i)\n            vowel_chars.append(char)\n\n    if len(vowel_chars) <= 1:\n        return s\n\n    reversed_vowels = vowel_chars[::-1]\n\n    for i, idx in enumerate(vowel_indices):\n        s_list[idx] = reversed_vowels[i]\n\n    return \"\".join(s_list)"}
{"task_id": "Mbpp/129", "solution": "from typing import List, Optional\nclass Matrix:\n    \"\"\"Encapsulates the matrix elements and provides operations for sum calculations.\"\"\"\n    def __init__(self, elements: List[List[int]]):\n        self.elements = elements\n        self.n = len(elements) if elements else 0\n\n    def is_square(self) -> bool:\n        \"\"\"Checks if the matrix is square (n x n) and non-empty.\"\"\"\n        if self.n == 0:\n            return False\n        for row in self.elements:\n            if len(row) != self.n:\n                return False\n        return True\n\n    def row_sum(self, i: int) -> int:\n        \"\"\"Calculates the sum of elements in the specified row.\"\"\"\n        return sum(self.elements[i])\n\n    def col_sum(self, j: int) -> int:\n        \"\"\"Calculates the sum of elements in the specified column.\"\"\"\n        col_total = 0\n        for i in range(self.n):\n            col_total += self.elements[i][j]\n        return col_total\n\n    def diag_sum(self, main: bool = True) -> int:\n        \"\"\"Calculates the sum of elements along the main or secondary diagonal.\"\"\"\n        diag_total = 0\n        if main:\n            for i in range(self.n):\n                diag_total += self.elements[i][i]\n        else:\n            for i in range(self.n):\n                diag_total += self.elements[i][self.n - 1 - i]\n        return diag_total\nclass Row:\n    \"\"\"Helper class to get the sum of a specific row in a matrix.\"\"\"\n    def __init__(self, index: int, matrix: Matrix):\n        self.index = index\n        self.matrix = matrix\n\n    def sum(self) -> int:\n        \"\"\"Delegates to Matrix.row_sum to calculate the row sum.\"\"\"\n        return self.matrix.row_sum(self.index)\nclass Column:\n    \"\"\"Helper class to get the sum of a specific column in a matrix.\"\"\"\n    def __init__(self, index: int, matrix: Matrix):\n        self.index = index\n        self.matrix = matrix\n\n    def sum(self) -> int:\n        \"\"\"Delegates to Matrix.col_sum to calculate the column sum.\"\"\"\n        return self.matrix.col_sum(self.index)\nclass Diagonal:\n    \"\"\"Helper class to get the sum of a specific diagonal in a matrix.\"\"\"\n    def __init__(self, main: bool, matrix: Matrix):\n        self.main = main\n        self.matrix = matrix\n\n    def sum(self) -> int:\n        \"\"\"Delegates to Matrix.diag_sum to calculate the diagonal sum.\"\"\"\n        return self.matrix.diag_sum(self.main)\ndef magic_square_test(matrix: List[List[int]]) -> bool:\n    \"\"\"\n    Determines if the given matrix is a magic square.\n    It performs input validation and checks sums of rows, columns, and diagonals.\n    \"\"\"\n    # 1. Input validation for types and basic structure (2D list of ints)\n    if not isinstance(matrix, list) or not matrix:\n        return False\n\n    n = len(matrix)\n    for row_idx in range(n):\n        current_row = matrix[row_idx]\n        if not isinstance(current_row, list):\n            return False\n        if len(current_row) != n: # Pre-check for non-square matrices\n            return False\n        for col_idx in range(n):\n            if not isinstance(current_row[col_idx], int):\n                return False\n\n    # 2. Construct Matrix object\n    m = Matrix(matrix)\n\n    # 3. Verify matrix is square\n    if not m.is_square():\n        return False\n    \n    # 4. Handle 1x1 matrices as a base case: always a magic square.\n    if n == 1:\n        return True\n\n    # 5. Compute the common sum from the first row\n    common_sum = Row(0, m).sum()\n\n    # 6. Check all row sums\n    for i in range(n):\n        if Row(i, m).sum() != common_sum:\n            return False\n\n    # 7. Check all column sums\n    for j in range(n):\n        if Column(j, m).sum() != common_sum:\n            return False\n\n    # 8. Check main diagonal sum\n    if Diagonal(main=True, matrix=m).sum() != common_sum:\n        return False\n\n    # 9. Check secondary diagonal sum\n    if Diagonal(main=False, matrix=m).sum() != common_sum:\n        return False\n    \n    # All checks passed, it's a magic square.\n    return True"}
{"task_id": "Mbpp/135", "solution": "class InputValidator:\n    \"\"\"Validates input for hexagonal number calculation.\"\"\"\n    min_value: int = 1\n    def is_valid(self, n: int) -> bool:\n        \"\"\"Return True if n is an integer and n >= min_value.\"\"\"\n        return isinstance(n, int) and n >= self.min_value\nclass HexagonalNumberCalculator:\n    \"\"\"Calculates the nth hexagonal number after validation.\"\"\"\n    _formula: str = \"2*n*n - n\"\n    def __init__(self, validator: 'InputValidator' | None = None):\n        \"\"\"Initializes the calculator with an optional validator.\"\"\"\n        self._validator = validator if validator is not None else InputValidator()\n\n    def hexagonal_num(self, n: int) -> int:\n        \"\"\"Validate n using InputValidator; if invalid, raise ValueError; else compute 2*n*n - n and return int.\"\"\"\n        if not self._validator.is_valid(n):\n            raise ValueError(\"Input 'n' must be a 1-based positive integer.\")\n        return 2 * n * n - n\ndef hexagonal_num(n: int) -> int:\n    \"\"\"Calculates the nth hexagonal number.\"\"\"\n    calculator = HexagonalNumberCalculator()\n    return calculator.hexagonal_num(n)"}
{"task_id": "Mbpp/133", "solution": "import typing\nNumber = typing.Union[int, float]\ndef sum_negativenum(numbers: typing.List[Number]) -> Number:\n    \"\"\"\n    Calculates the sum of the negative numbers in a list.\n    Returns 0 if no negative numbers are found.\n    \"\"\"\n    total_sum: Number = 0\n    has_float_negative = False\n\n    for num in numbers:\n        if num < 0:\n            total_sum += num\n            if isinstance(num, float):\n                has_float_negative = True\n    \n    # Per design, if all negative inputs are ints and no floats present, return int.\n    # Otherwise, return float. If total_sum is 0, we preserve its type or cast if a float was involved.\n    if has_float_negative:\n        return float(total_sum)\n    else:\n        # If total_sum is 0, and no floats were involved, it should be an int 0.\n        # If total_sum is an integer sum of integers, it remains an int.\n        return int(total_sum)"}
{"task_id": "Mbpp/137", "solution": "class Element:\n    \"\"\"Represents a single integer element for classification.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def isZero(self) -> bool:\n        \"\"\"Checks if the element's value is zero.\"\"\"\n        return self.value == 0\nclass InputArray:\n    \"\"\"Encapsulates an array of integers and provides counting methods.\"\"\"\n    def __init__(self, values: list[int]):\n        self.values = values\n\n    def length(self) -> int:\n        \"\"\"Returns the number of elements in the array.\"\"\"\n        return len(self.values)\n\n    def countZeros(self) -> int:\n        \"\"\"Counts the number of zero elements in the array.\"\"\"\n        zero_count = 0\n        for val in self.values:\n            if Element(val).isZero():\n                zero_count += 1\n        return zero_count\n\n    def countNonZeros(self) -> int:\n        \"\"\"Counts the number of non-zero elements in the array.\"\"\"\n        non_zero_count = 0\n        for val in self.values:\n            if not Element(val).isZero():\n                non_zero_count += 1\n        return non_zero_count\nclass Result:\n    \"\"\"Stores the computed ratio and provides an accessor.\"\"\"\n    def __init__(self, ratio: float):\n        self.ratio = ratio\n\n    def getRatio(self) -> float:\n        \"\"\"Returns the stored ratio.\"\"\"\n        return self.ratio\nclass ErrorHandler:\n    \"\"\"Handles specific error conditions, such as division by zero.\"\"\"\n    def handleZeroNonZeroCount(self) -> float:\n        \"\"\"Returns a predefined float sentinel for division by zero cases.\"\"\"\n        return float('inf')\ndef zero_count(inputArray) -> float:\n    \"\"\"\n    Calculates the ratio of zero elements to non-zero elements in an array.\n    Delegates error handling for zero non-zero count to ErrorHandler.\n    \"\"\"\n    if not isinstance(inputArray, InputArray):\n        inputArray_instance = InputArray(inputArray)\n    else:\n        inputArray_instance = inputArray\n\n    zeros = inputArray_instance.countZeros()\n    nonzeros = inputArray_instance.countNonZeros()\n\n    if nonzeros == 0:\n        return ErrorHandler().handleZeroNonZeroCount()\n    \n    ratio = zeros / nonzeros\n    return Result(ratio).getRatio()"}
