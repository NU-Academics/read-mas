{"task_id": "Mbpp/392", "solution": "from typing import Optional\nclass MemoCache:\n    \"\"\"In-memory memoization cache for computed f(n) values.\"\"\"\n    def __init__(self) -> None:\n        self._store: dict[int, int] = {}\n\n    def get(self, n: int) -> Optional[int]:\n        \"\"\"Retrieves a cached value for n.\"\"\"\n        return self._store.get(n)\n\n    def put(self, n: int, value: int) -> None:\n        \"\"\"Stores a computed value for n.\"\"\"\n        self._store[n] = value\nclass MaxSumService:\n    \"\"\"Domain logic for computing f(n) per recurrence using memoization.\"\"\"\n    def __init__(self, cache: MemoCache) -> None:\n        self._cache = cache\n\n    def get_max_sum(self, n: int) -> int:\n        \"\"\"Computes the maximum sum for n, leveraging the cache.\"\"\"\n        cached_value = self._cache.get(n)\n        if cached_value is not None:\n            return cached_value\n\n        result = self._compute(n)\n        self._cache.put(n, result)\n        return result\n\n    def _compute(self, n: int) -> int:\n        \"\"\"Recursively computes f(n) based on the recurrence relation.\"\"\"\n        # The recurrence is f(n) = max( (f(n/2) + f(n/3) + f(n/4) + f(n/5)), n).\n        # Integer division (floor division) is used as specified.\n        sum_of_parts = (\n            self.get_max_sum(n // 2) +\n            self.get_max_sum(n // 3) +\n            self.get_max_sum(n // 4) +\n            self.get_max_sum(n // 5)\n        )\n        return max(sum_of_parts, n)\n_service: MaxSumService = MaxSumService(MemoCache())\ndef get_max_sum(n: int) -> int:\n    \"\"\"\n    Finds the maximum sum possible by using the given equation f(n) = max( (f(n/2) + f(n/3) + f(n/4) + f(n/5)), n).\n    This function acts as the public API, delegating to an internal service for memoized computation.\n    \"\"\"\n    return _service.get_max_sum(n)"}
