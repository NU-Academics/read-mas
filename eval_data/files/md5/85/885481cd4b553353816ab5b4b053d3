{"task_id": "Mbpp/119", "solution": "import collections\nfrom typing import List\ndef search(values: List[int]) -> int:\n    \"\"\"\n    Finds the element that appears only once in a sorted array where every other element appears twice.\n    Performs input validation and uses a binary search style algorithm.\n    \"\"\"\n    if not isinstance(values, list):\n        raise ValueError(\"Invalid input: values must be a list.\")\n    if not values:\n        raise ValueError(\"Invalid input: list must not be empty.\")\n    if any(not isinstance(x, int) for x in values):\n        raise ValueError(\"Invalid input: all elements must be integers.\")\n\n    # Validate length and sorted order\n    if len(values) % 2 == 0:\n        raise ValueError(\"Invalid input: list must have an odd length.\")\n    \n    if len(values) < 1: # This check is redundant due to the previous 'if not values:' but kept for explicit clarity based on design.\n        raise ValueError(\"Invalid input: list length must be >= 1.\")\n\n    if not all(values[i] <= values[i+1] for i in range(len(values) - 1)):\n        raise ValueError(\"Invalid input: list must be sorted in non-decreasing order.\")\n\n    # Validate element counts\n    counts = collections.Counter(values)\n    unique_elements = [item for item, count in counts.items() if count == 1]\n    if len(unique_elements) != 1:\n        raise ValueError(\"Invalid input: must have exactly one unique element and others paired.\")\n    \n    if not all(counts[item] == 2 for item in counts if counts[item] != 1):\n        raise ValueError(\"Invalid input: all non-unique elements must appear exactly twice.\")\n\n    # Binary search to find the unique element\n    left, right = 0, len(values) - 1\n    while left < right:\n        mid = (left + right) // 2\n        \n        # Ensure mid points to the start of a pair or the unique element\n        # If mid is odd, make it even by decrementing if possible\n        if mid % 2 == 1:\n            mid -= 1\n\n        # Check if the pair values[mid] and values[mid+1] are equal\n        if values[mid] == values[mid + 1]:\n            # If they are equal, the unique element is to the right\n            left = mid + 2\n        else:\n            # If they are not equal, the unique element is at or to the left of mid\n            right = mid\n            \n    return values[left]"}
{"task_id": "Mbpp/116", "solution": "class TupleToIntFunction:\n    def _concat_elements(self, input_tuple: tuple) -> str:\n        \"\"\"Concatenates decimal string representations of tuple elements.\"\"\"\n        return ''.join(str(element) for element in input_tuple)\ndef tuple_to_int(input_tuple: tuple) -> int:\n    \"\"\"Converts a tuple of positive integers into a single integer.\"\"\"\n    # As per the requirements, explicit isinstance() checks and raising exceptions for edge cases\n    # are omitted from this function's direct implementation.\n    # The function proceeds directly with the core conversion logic assuming valid input.\n\n    impl = TupleToIntFunction()\n    concatenated_str = impl._concat_elements(input_tuple)\n    return int(concatenated_str)"}
{"task_id": "Mbpp/123", "solution": "from typing import Dict\nclass AmicableCalculator:\n    def __init__(self) -> None:\n        \"\"\"Initializes the cache for divisor sums.\"\"\"\n        self.divisorSumCache: Dict[int, int] = {}\n\n    def sumProperDivisors(self, m: int) -> int:\n        \"\"\"Computes s(m) as sum of proper divisors of m (divisors < m), caches and returns it.\"\"\"\n        if m <= 1:\n            return 0\n\n        if m in self.divisorSumCache:\n            return self.divisorSumCache[m]\n\n        s = 1  # 1 is always a proper divisor for m > 1\n        limit = int(m**0.5)\n        for i in range(2, limit + 1):\n            if m % i == 0:\n                s += i\n                if i * i != m:\n                    s += m // i\n        \n        self.divisorSumCache[m] = s\n        return s\n\n    def amicable_numbers_sum(self, n: int) -> int:\n        \"\"\"Computes and returns the sum of unique amicable-members x where 1 \u2264 x \u2264 n.\"\"\"\n        amicable_members = set()\n        for a in range(1, n + 1):\n            s_a = self.sumProperDivisors(a)\n            b = s_a\n\n            # Check for amicable pair: a != b and s(b) == a\n            # We only check pairs where b > a to avoid duplicate calculations and ensure a != b.\n            if b > a:\n                s_b = self.sumProperDivisors(b)\n                if s_b == a:\n                    if a <= n:\n                        amicable_members.add(a)\n                    if b <= n: # Add b only if it's also within the specified range\n                        amicable_members.add(b)\n        \n        return sum(amicable_members)\ndef amicable_numbers_sum(n: int) -> int:\n    \"\"\"Calculates the sum of all amicable numbers from 1 to a specified number n.\"\"\"\n    calc = AmicableCalculator()\n    return calc.amicable_numbers_sum(n)"}
{"task_id": "Mbpp/120", "solution": "from typing import Sequence, Tuple\nimport numbers\nclass TuplePair:\n    \"\"\"\n    Represents an input two-element numeric tuple and provides derived product and absolute product accessors.\n    \"\"\"\n    def __init__(self, a: numbers.Number, b: numbers.Number) -> None:\n        self.a = a\n        self.b = b\n\n    def product(self) -> numbers.Number:\n        \"\"\"Returns the product of a and b.\"\"\"\n        return self.a * self.b\n\n    def abs_product(self) -> numbers.Number:\n        \"\"\"Returns the absolute product of a and b.\"\"\"\n        return abs(self.product())\nclass ProductCalculator:\n    \"\"\"\n    Encapsulates computation logic (product, abs product, aggregation).\n    \"\"\"\n    def computeProduct(self, tp: TuplePair) -> numbers.Number:\n        \"\"\"Computes the product of a TuplePair.\"\"\"\n        return tp.product()\n\n    def computeAbsProduct(self, tp: TuplePair) -> numbers.Number:\n        \"\"\"Computes the absolute product of a TuplePair.\"\"\"\n        return tp.abs_product()\n\n    def findMaxAbsProduct(self, pairs: Sequence[TuplePair]) -> numbers.Number:\n        \"\"\"\n        Computes the absolute product for each TuplePair and returns the maximum.\n        Assumes 'pairs' is non-empty.\n        \"\"\"\n        # Initialize with 0 as absolute products are non-negative.\n        max_abs_product = 0 \n        for tp in pairs:\n            current_abs_product = tp.abs_product()\n            if current_abs_product > max_abs_product:\n                max_abs_product = current_abs_product\n        return max_abs_product\ndef max_product_tuple(pairs: Sequence[Tuple[numbers.Number, numbers.Number]]) -> numbers.Number:\n    \"\"\"\n    Finds the maximum absolute product between numbers in pairs of tuples within a given list.\n    Raises ValueError for empty input lists or malformed tuple/non-numeric elements.\n    \"\"\"\n    if not pairs:\n        raise ValueError(\"empty input list\")\n\n    list_of_tuple_pairs = []\n    for item in pairs:\n        if not isinstance(item, tuple) or len(item) != 2:\n            raise ValueError(\"malformed tuple or non-numeric elements\")\n        \n        a, b = item\n        if not isinstance(a, numbers.Number) or not isinstance(b, numbers.Number):\n            raise ValueError(\"malformed tuple or non-numeric elements\")\n        \n        list_of_tuple_pairs.append(TuplePair(a, b))\n\n    product_calculator = ProductCalculator()\n    final_max_abs_product = product_calculator.findMaxAbsProduct(list_of_tuple_pairs)\n\n    return final_max_abs_product"}
{"task_id": "Mbpp/124", "solution": "import math\nfrom typing import Any\nclass ComplexNumber:\n    \"\"\"\n    Normalizes an input value to a Python complex number.\n    Raises TypeError if the input cannot be converted to complex.\n    \"\"\"\n    def __init__(self, value: Any) -> None:\n        try:\n            c_val = complex(value)\n        except (ValueError, TypeError) as e:\n            raise TypeError(f\"Input '{value}' could not be converted to a complex number.\") from e\n        self.raw_value = value\n        self.real: float = c_val.real\n        self.imag: float = c_val.imag\n\n    def to_complex(self) -> complex:\n        \"\"\"Returns the stored value as a Python complex number.\"\"\"\n        return complex(self.real, self.imag)\nclass AngleCalculator:\n    \"\"\"\n    Coordinates conversion, sums complex numbers, and computes the angle using atan2.\n    Returns the angle as a float in radians.\n    \"\"\"\n    def angle_complex(self, a: Any, b: Any) -> float:\n        \"\"\"\n        Full flow to convert inputs, sum them, and compute the angle.\n        \"\"\"\n        sum_c = self._sum_complex(a, b)\n        angle = self._compute_atan2(sum_c.imag, sum_c.real)\n        return angle\n\n    def _sum_complex(self, a: Any, b: Any) -> complex:\n        \"\"\"\n        Converts inputs to complex numbers and returns their sum.\n        \"\"\"\n        complex_a = ComplexNumber(a).to_complex()\n        complex_b = ComplexNumber(b).to_complex()\n        return complex_a + complex_b\n\n    def _compute_atan2(self, imag: float, real: float) -> float:\n        \"\"\"\n        Computes the angle (argument) using math.atan2.\n        \"\"\"\n        return math.atan2(imag, real)\ndef angle_complex(a, b) -> float:\n    \"\"\"\n    Computes the angle of the complex sum of two inputs.\n    Inputs are converted to complex numbers, summed, and their angle is returned in radians.\n    \"\"\"\n    calculator = AngleCalculator()\n    return calculator.angle_complex(a, b)"}
{"task_id": "Mbpp/125", "solution": "class Counter:\n    \"\"\"Stateless utility for counting zeros and ones over an inclusive range.\"\"\"\n    def countZeros(self, s: str, start: int, end: int) -> int:\n        return s[start : end + 1].count('0')\n\n    def countOnes(self, s: str, start: int, end: int) -> int:\n        return s[start : end + 1].count('1')\nclass FindLengthFunction:\n    \"\"\"Orchestrates validation, substring generation, counting, and tracking the maximum difference.\"\"\"\n    def __init__(self) -> None:\n        self._counter = Counter()\n\n    def find_length(self, s: str) -> int:\n        \"\"\"Finds the maximum difference between zeros and ones in any substring.\"\"\"\n        for char in s:\n            if char not in ('0', '1'):\n                raise ValueError(\"Input string must contain only '0' or '1'.\")\n\n        n = len(s)\n        if n == 0:\n            return 0 \n            \n        max_diff = -float('inf')\n\n        for i in range(n):\n            current_zero_count = 0\n            current_one_count = 0\n            for j in range(i, n):\n                if s[j] == '0':\n                    current_zero_count += 1\n                else:\n                    current_one_count += 1\n                \n                max_diff = max(max_diff, current_zero_count - current_one_count)\n        \n        return max_diff if max_diff != -float('inf') else 0\ndef find_length(s: str) -> int:\n    \"\"\"External API required by SRS. Validates input and returns integer result.\"\"\"\n    return FindLengthFunction().find_length(s)"}
{"task_id": "Mbpp/126", "solution": "from typing import List\ndef _positive_divisors(n: int) -> List[int]:\n    \"\"\"\n    Returns a list of all positive divisors of the given integer n.\n    Handles n=0 by returning an empty list, as it has no finite positive divisors.\n    \"\"\"\n    divs = []\n    if n == 0:\n        return divs\n    # Iterate up to abs(n) to find all positive divisors.\n    # We use abs(n) to correctly handle negative inputs, as divisors are positive.\n    for i in range(1, abs(n) + 1):\n        if n % i == 0:\n            divs.append(i)\n    return divs\ndef compute_common_divisors(a: int, b: int) -> List[int]:\n    \"\"\"\n    Computes and returns a list of all positive common divisors for two integers a and b.\n    \"\"\"\n    divisors_a = set(_positive_divisors(a))\n    divisors_b = set(_positive_divisors(b))\n    common_divs = list(divisors_a.intersection(divisors_b))\n    return common_divs\ndef sum_common_divisors(a: int, b: int) -> int:\n    \"\"\"\n    Calculates the sum of all positive common divisors of two integers a and b.\n    \"\"\"\n    common_divs = compute_common_divisors(a, b)\n    return sum(common_divs)\ndef sum(a: int, b: int) -> int:\n    \"\"\"\n    Calculates the sum of all positive common divisors of two given integers a and b.\n    This function serves as the public API entry point.\n    \"\"\"\n    return sum_common_divisors(a, b)"}
