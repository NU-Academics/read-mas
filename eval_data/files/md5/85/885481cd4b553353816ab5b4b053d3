{"task_id": "Mbpp/758", "solution": "from typing import List, Tuple, Dict\ndef toTuple(sublist: list) -> tuple:\n    \"\"\"Convert a sublist (list) to a tuple key (immutable).\"\"\"\n    return tuple(sublist)\ndef unique_sublists(input_list: list) -> dict:\n    \"\"\"Return a dict mapping tuple(sublist) to the number of occurrences in input_list.\"\"\"\n    counts: Dict[Tuple, int] = {}\n    for sublist in input_list:\n        key = toTuple(sublist)\n        counts[key] = counts.get(key, 0) + 1\n    return counts"}
{"task_id": "Mbpp/759", "solution": "import re\nPATTERN = r'^\\d+\\.\\d{2}$'\n_compiled_pattern = re.compile(PATTERN)\nclass DecimalValidator:\n    \"\"\"Encapsulates validation logic and pattern for decimal numbers.\"\"\"\n    @staticmethod\n    def is_decimal(input_string: str) -> bool:\n        \"\"\"Return True iff input_string matches PATTERN '^\\\\d+\\\\.\\\\d{2}$'.\n        Coerces input_string to str before matching.\"\"\"\n        return bool(_compiled_pattern.fullmatch(str(input_string)))\ndef is_decimal(input_string: str) -> bool:\n    \"\"\"Public API that delegates to DecimalValidator.is_decimal.\n    Accepts a single parameter (treated as a string) and returns a boolean.\"\"\"\n    return DecimalValidator.is_decimal(input_string)"}
