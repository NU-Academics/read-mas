{"task_id": "Mbpp/235", "solution": "def even_bit_set_number(n: int) -> int:\n    \"\"\"\n    Sets all even-position bits (1-based indexing) of the input number n to 1.\n    Other bits remain unchanged.\n    \"\"\"\n    # Determine the width for mask generation, covering at least n's bit length or 1 for n=0.\n    width = max(1, n.bit_length())\n\n    mask_val = 0\n    # Generate a mask with 1s at 1-based even positions (0-based odd indices).\n    for i in range(1, width + 1):\n        if i % 2 == 0:  # If 1-based position is even\n            # Set the corresponding 0-based bit (i-1) in the mask\n            mask_val |= (1 << (i - 1))\n\n    # Apply the mask using a bitwise OR operation to set the specified bits.\n    result = n | mask_val\n    return result"}
{"task_id": "Mbpp/237", "solution": "from typing import Any, List, Tuple, Dict\ndef normalize_tuple(t: Tuple[Any, Any]) -> Tuple[Any, Any]:\n    \"\"\"\n    Returns a 2-element tuple with its elements sorted in non-decreasing order.\n    Assumes elements are comparable as checked by validate_input.\n    \"\"\"\n    a, b = t\n    if a <= b:\n        return (a, b)\n    else:\n        return (b, a)\ndef check_occurences(list_of_tuples: 'List[Tuple[Any, Any]]') -> 'Dict[Tuple[Any, Any], int]':\n    \"\"\"\n    Counts occurrences of normalized 2-element tuples in a list.\n    Normalizes tuples by sorting their elements, then maps each normalized tuple to its count.\n    \"\"\"\n    validate_input(list_of_tuples)\n\n    counts: Dict[Tuple[Any, Any], int] = {}\n    for tup in list_of_tuples:\n        normalized = normalize_tuple(tup)\n        counts[normalized] = counts.get(normalized, 0) + 1\n\n    return counts"}
{"task_id": "Mbpp/238", "solution": "class SubstringCounter:\n    \"\"\"\n    Helper class for calculating the number of substrings.\n    Provides methods for formula-based and enumerative counting.\n    \"\"\"\n    def calculate_by_formula(self, n: int) -> int:\n        \"\"\"Calculates the number of non-empty substrings for a string of length n.\"\"\"\n        return n * (n + 1) // 2\n\n    def number_of_substrings(self, input_string: str) -> int:\n        \"\"\"\n        Calculates non-empty substrings for an input string, including type validation.\n        This method mirrors the top-level public function.\n        \"\"\"\n        if not isinstance(input_string, str):\n            raise TypeError('input_string must be a str')\n        return self.calculate_by_formula(len(input_string))\n\n    def enumerate_substrings_and_count(self, input_string: str) -> int:\n        \"\"\"\n        Enumerates all non-empty substrings and returns their count.\n        This method is primarily for verification purposes.\n        \"\"\"\n        n = len(input_string)\n        count = 0\n        for start in range(n):\n            for end in range(start, n):\n                count += 1\n        return count\ndef number_of_substrings(input_string):\n    \"\"\"\n    Counts the number of non-empty substrings of a given string.\n    Raises TypeError if the input is not a string.\n    \"\"\"\n    if not isinstance(input_string, str):\n        raise TypeError('input_string must be a str')\n\n    n = len(input_string)\n    counter = SubstringCounter()\n    return counter.calculate_by_formula(n)"}
