{"task_id": "Mbpp/786", "solution": "from typing import Sequence, Any\ndef _is_sorted(seq: Sequence[Any]) -> bool:\n    \"\"\"Verify seq is non-decreasing; used for precondition validation.\"\"\"\n    for i in range(len(seq) - 1):\n        if seq[i] > seq[i+1]:\n            return False\n    return True\ndef _bisect_right(seq: Sequence[Any], value: Any) -> int:\n    \"\"\"Compute right-insertion index using binary search (O(log n)).\"\"\"\n    low = 0\n    high = len(seq)\n    while low < high:\n        mid = (low + high) // 2\n        if value < seq[mid]:\n            high = mid\n        else:\n            low = mid + 1\n    return low\ndef right_insertion(seq: Sequence[Any], value: Any) -> int:\n    \"\"\"Return the index at which value should be inserted into seq to maintain non-decreasing order, placing value after any equal elements.\"\"\"\n    if not _is_sorted(seq):\n        raise ValueError(\"Sequence is not sorted in non-decreasing order.\")\n    return _bisect_right(seq, value)"}
{"task_id": "Mbpp/791", "solution": "def remove_nested(input: tuple) -> tuple:\n    \"\"\"Validate input and return tuple containing top-level elements that are not tuples.\n\n    Raises:\n        TypeError: if input is not a tuple\n    \"\"\"\n    if not isinstance(input, tuple):\n        raise TypeError(\"input must be a tuple\")\n    result_list = []\n    for e in input:\n        if not isinstance(e, tuple):\n            result_list.append(e)\n    return tuple(result_list)"}
{"task_id": "Mbpp/785", "solution": "from typing import List, Tuple, Iterator\nclass Tokenizer:\n    \"\"\"Stateless utility that splits a normalized input string on commas.\"\"\"\n    def tokenize(self, s: str) -> List[str]:\n        return s.split(',')\nclass Parser:\n    \"\"\"Orchestrates tokenization and conversion from string to list of ints.\"\"\"\n    def __init__(self, tokenizer: Tokenizer | None = None):\n        self.tokenizer = tokenizer if tokenizer is not None else Tokenizer()\n\n    def parse(self, s: str) -> List[int]:\n        # Remove a single outer pair of parentheses if present.\n        trimmed_s = s.strip()\n        content = trimmed_s\n        if trimmed_s.startswith('(') and trimmed_s.endswith(')'):\n            content = trimmed_s[1:-1]\n        \n        # Tokenize the content.\n        raw_tokens = self.tokenizer.tokenize(content)\n\n        int_values = []\n        # Handle the special case of an empty content string, which should yield an empty tuple.\n        if raw_tokens == [''] and not content.strip():\n            return []\n\n        for token in raw_tokens:\n            stripped_token = token.strip()\n            if not stripped_token:\n                # Raises ValueError if any token trims to an empty string.\n                raise ValueError(f\"invalid empty token in tuple string: '{token}'\")\n\n            try:\n                int_values.append(int(stripped_token))\n            except ValueError:\n                # Raises ValueError on conversion errors.\n                raise ValueError(f\"invalid integer token: '{stripped_token}'\")\n        return int_values\ndef tuple_str_int(input: str) -> Tuple[int]:\n    \"\"\"Public API: converts a tuple string to an integer tuple.\"\"\"\n    # Validates input type, raises TypeError for non-str inputs.\n    if not isinstance(input, str):\n        raise TypeError(\"input must be str\")\n\n    parser = Parser()\n    list_of_ints = parser.parse(input)\n    # Converts Parser's list[int] to tuple[int] and returns it.\n    return tuple(list_of_ints)"}
