{"task_id": "Mbpp/735", "solution": "class InputValidator:\n    \"\"\"Validator for input type and non-negativity.\"\"\"\n    def validate_type(self, n) -> None:\n        \"\"\"Validates if the input is an integer.\"\"\"\n        # Validation checks and exception raising are omitted as per explicit requirements.\n        pass\n\n    def validate_non_negative(self, n: int) -> None:\n        \"\"\"Validates if the input is non-negative.\"\"\"\n        # Validation checks and exception raising are omitted as per explicit requirements.\n        pass\nclass BitManipulator:\n    \"\"\"Utility for bit manipulation operations.\"\"\"\n    def minimal_binary_length(self, n: int) -> int:\n        \"\"\"Returns the minimal binary length of an integer.\"\"\"\n        if n == 0:\n            return 1\n        return n.bit_length()\n\n    def msb_position(self, n: int) -> int:\n        \"\"\"Returns the position (0-indexed) of the most significant bit.\"\"\"\n        return self.minimal_binary_length(n) - 1\n\n    def lsb_position(self, n: int) -> int:\n        \"\"\"Returns the position (0-indexed) of the least significant bit.\"\"\"\n        return 0\n\n    def build_toggle_mask(self, length: int) -> int:\n        \"\"\"Builds a mask to toggle middle bits given the total bit length.\"\"\"\n        if length < 3:\n            return 0\n        middle_count = length - 2\n        mask_middle = (1 << middle_count) - 1\n        mask = mask_middle << 1\n        return mask\n\n    def apply_mask(self, n: int, mask: int) -> int:\n        \"\"\"Applies a bitwise XOR mask to a number.\"\"\"\n        return n ^ mask\ndef toggle_middle_bits(n: int) -> int:\n    \"\"\"\n    Toggles bits of the number except the first and the last bit.\n    Returns the number unchanged if its minimal binary representation has less than 3 bits.\n    \"\"\"\n    validator = InputValidator()\n    validator.validate_type(n)\n    validator.validate_non_negative(n)\n\n    manip = BitManipulator()\n    length = manip.minimal_binary_length(n)\n\n    if length < 3:\n        return n\n\n    mask = manip.build_toggle_mask(length)\n    return manip.apply_mask(n, mask)"}
{"task_id": "Mbpp/736", "solution": "def left_insertion(sequence, value) -> int:\n    \"\"\"\n    Return leftmost insertion index for value in ascending sorted sequence.\n\n    Contract (from SRS):\n    - sequence: ascending sorted sequence (list/tuple/array-like) of comparable elements.\n    - value: element comparable with sequence elements.\n    - Returns an integer index i with 0 <= i <= len(sequence) as the leftmost index such that sequence[i] >= value.\n    - Undefined behavior if elements are not comparable with value (FR6).\n    \"\"\"\n    low = 0\n    high = len(sequence)\n\n    while low < high:\n        mid = (low + high) // 2\n        if sequence[mid] < value:\n            low = mid + 1\n        else:\n            high = mid\n    return low"}
