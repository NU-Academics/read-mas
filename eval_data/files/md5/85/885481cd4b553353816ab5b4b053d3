{"task_id": "Mbpp/476", "solution": "from typing import List, Union\ndef validate_input(numbers: list) -> bool:\n    \"\"\"\n    Validate that `numbers` is a list, non-empty, and contains only int/float elements.\n    Raises TypeError or ValueError on invalid input.\n    \"\"\"\n    if not isinstance(numbers, list):\n        raise TypeError(\"numbers must be a list\")\n    if len(numbers) == 0:\n        raise ValueError(\"numbers must contain at least one element\")\n    for elem in numbers:\n        if not isinstance(elem, (int, float)):\n            raise TypeError(\"elements must be int or float\")\n    return True\ndef big_sum(numbers: list) -> Union[int, float]:\n    \"\"\"\n    Compute and return the sum of the smallest and largest numeric elements in `numbers`.\n    It validates inputs and then calculates the sum of min and max elements.\n    \"\"\"\n    validate_input(numbers)\n    return min(numbers) + max(numbers)"}
{"task_id": "Mbpp/473", "solution": "import collections.abc\nfrom typing import Any, Tuple, Set, List\nclass TuplePair:\n    \"\"\"\n    Represents a 2-element pair and provides canonicalization and unordered equality helpers.\n    \"\"\"\n    def __init__(self, a: Any, b: Any) -> None:\n        \"\"\"Initializes with two elements.\"\"\"\n        self.first = a\n        self.second = b\n\n    def canonicalize(self) -> 'TuplePair':\n        \"\"\"\n        Returns a new TuplePair instance with elements in canonical order (min, max).\n        Raises TypeError if elements are not comparable.\n        \"\"\"\n        try:\n            # Determine canonical order. Create a new TuplePair to ensure non-destructive.\n            if self.first > self.second:\n                return TuplePair(self.second, self.first)\n            else:\n                return TuplePair(self.first, self.second)\n        except TypeError as e:\n            # Re-raise to indicate non-comparable elements, as per design notes (BR9).\n            raise TypeError(f\"Elements '{self.first}' and '{self.second}' are not comparable: {e}\")\n\n    def __eq__(self, other: Any) -> bool:\n        \"\"\"Compares two TuplePair objects based on their canonical form.\"\"\"\n        if not isinstance(other, TuplePair):\n            return NotImplemented\n        self_canonical = self.canonicalize()\n        other_canonical = other.canonicalize()\n        return self_canonical.first == other_canonical.first and \\\n               self_canonical.second == other_canonical.second\n\n    def __hash__(self) -> int:\n        \"\"\"Hashes the TuplePair based on its canonical form.\"\"\"\n        canonical = self.canonicalize()\n        return hash((canonical.first, canonical.second))\n\n    def as_tuple(self) -> Tuple[Any, Any]:\n        \"\"\"Returns the current pair as a native tuple.\"\"\"\n        return (self.first, self.second)\ndef _validate_inputs(A: collections.abc.Iterable, B: collections.abc.Iterable) -> bool:\n    \"\"\"\n    Validates if inputs are iterables of 2-element tuples with comparable elements.\n    Raises TypeError or ValueError on invalid inputs. Returns True on success.\n    \"\"\"\n    if not isinstance(A, collections.abc.Iterable) or not isinstance(B, collections.abc.Iterable):\n        raise TypeError(\"Inputs A and B must be iterables.\")\n\n    def _validate_single_iterable_copy(iterable_obj, name):\n        # Create a list copy to ensure full validation without consuming the original iterable\n        # if it's a generator, and to ensure re-iterability for subsequent steps.\n        iterable_copy = list(iterable_obj)\n        for i, item in enumerate(iterable_copy):\n            if not isinstance(item, tuple) or len(item) != 2:\n                raise ValueError(f\"Iterable {name} contains non-2-element tuple at index {i}: {item}\")\n            try:\n                # Attempt canonicalization to check for comparability (BR9)\n                temp_pair = TuplePair(item[0], item[1])\n                temp_pair.canonicalize() # This will raise TypeError if elements not comparable\n            except TypeError as e:\n                raise TypeError(f\"Elements in tuple at index {i} of {name} are not comparable: {item} - {e}\")\n            except Exception as e:\n                raise ValueError(f\"Unexpected error validating tuple at index {i} of {name}: {item} - {e}\")\n\n    _validate_single_iterable_copy(A, \"A\")\n    _validate_single_iterable_copy(B, \"B\")\n    return True\ndef _to_canonical_set(items_iterable: collections.abc.Iterable) -> Set[Tuple[Any, Any]]:\n    \"\"\"\n    Converts an iterable of 2-element tuples to a set of unique canonical native tuples.\n    This also handles implicit canonicalization for unordered pairs.\n    \"\"\"\n    canonical_set: Set[Tuple[Any, Any]] = set()\n    for item in items_iterable:\n        # Assuming item is a native (val1, val2) tuple, as validated by _validate_inputs\n        tp = TuplePair(item[0], item[1])\n        canonical_tp = tp.canonicalize()\n        canonical_set.add(canonical_tp.as_tuple())\n    return canonical_set\ndef tuple_intersection(A: collections.abc.Iterable[Tuple[Any, Any]], B: collections.abc.Iterable[Tuple[Any, Any]]) -> Set[Tuple[Any, Any]]:\n    \"\"\"\n    Finds the tuple intersection of elements in the given tuple lists irrespective of their order.\n    Returns a set of canonical 2-element tuples.\n    \"\"\"\n    # 1. Validate inputs as per design. This will raise errors if inputs are invalid.\n    # _validate_inputs internally makes copies for validation, ensuring original A and B are preserved.\n    _validate_inputs(A, B)\n\n    # 2. Build canonical sets for A and B. These calls will iterate over the original A and B.\n    canonical_set_A = _to_canonical_set(A)\n    canonical_set_B = _to_canonical_set(B)\n\n    # 3. Compute the intersection and return the result as a native Python set.\n    return canonical_set_A.intersection(canonical_set_B)"}
{"task_id": "Mbpp/479", "solution": "from typing import List\nclass Number:\n    def __init__(self, value: int) -> None:\n        \"\"\"Initialize Number with integer value.\"\"\"\n        self.value: int = value\n        self._decimal_representation: str = str(abs(value))\n\n    def to_digits(self) -> List[int]:\n        \"\"\"Return list of digits (left-to-right) as ints.\"\"\"\n        return [int(ch) for ch in self._decimal_representation]\ndef first_Digit(n: int) -> int:\n    \"\"\"Return the most significant decimal digit of integer n.\n    Returns int in range 0..9.\n    \"\"\"\n    number = Number(n)\n    digits = number.to_digits()\n    if not digits:\n        return 0\n    return digits[0]"}
{"task_id": "Mbpp/478", "solution": "def remove_lowercase(s: str) -> str:\n    \"\"\"Removes all contiguous lowercase substrings from the input string.\"\"\"\n    out_chars = []\n    i = 0\n    n = len(s)\n\n    while i < n:\n        if s[i].islower():\n            # Skip all contiguous lowercase characters\n            while i < n and s[i].islower():\n                i += 1\n        else:\n            # Append non-lowercase characters and move to the next\n            out_chars.append(s[i])\n            i += 1\n            \n    return \"\".join(out_chars)"}
{"task_id": "Mbpp/554", "solution": "from typing import List\ndef Split(input_list: List[int]) -> List[int]:\n    \"\"\"\n    Filters a list of integers, returning a new list containing only the odd ones.\n\n    Raises TypeError if the input is not a list or contains non-integer elements.\n    \"\"\"\n    _validate_input(input_list)\n\n    odd_numbers = []\n    for number in input_list:\n        if number % 2 != 0:\n            odd_numbers.append(number)\n    return odd_numbers"}
{"task_id": "Mbpp/555", "solution": "class NaturalNumberSequence:\n    \"\"\"Encapsulates input n and provides validation logic.\"\"\"\n    def __init__(self, n: int) -> None:\n        self._n = n\n\n    @property\n    def n(self) -> int:\n        return self._n\n\n    def validate(self) -> bool:\n        \"\"\"Validates that n is a positive integer (n >= 1).\"\"\"\n        return isinstance(self._n, int) and self._n >= 1\nclass SumCalculator:\n    \"\"\"Provides static methods to compute sum of naturals and cubes.\"\"\"\n    @staticmethod\n    def sum_of_cubes(n: int) -> int:\n        \"\"\"Computes the sum of cubes of the first n natural numbers using a closed-form formula.\"\"\"\n        sum_naturals = n * (n + 1) // 2\n        return sum_naturals ** 2\n\n    @staticmethod\n    def sum_of_naturals(n: int) -> int:\n        \"\"\"Computes the sum of the first n natural numbers using a closed-form formula.\"\"\"\n        return n * (n + 1) // 2\nclass DifferenceFunction:\n    \"\"\"Orchestrates validation and computation to return the integer difference.\"\"\"\n    def difference(self, n: int) -> int:\n        \"\"\"Calculates the difference between the sum of cubes and sum of naturals.\"\"\"\n        sum_cubes = SumCalculator.sum_of_cubes(n)\n        sum_naturals = SumCalculator.sum_of_naturals(n)\n        return sum_cubes - sum_naturals\ndef difference(n: int) -> int:\n    \"\"\"\n    Finds the difference between the sum of cubes of the first n natural numbers\n    and the sum of the first n natural numbers.\n    \"\"\"\n    seq = NaturalNumberSequence(n)\n    if not seq.validate():\n        raise ValueError(\"n must be a positive integer (n >= 1)\")\n    return DifferenceFunction().difference(n)"}
{"task_id": "Mbpp/557", "solution": "def toggle_string(input: str) -> str:\n    \"\"\"Toggles the case of all alphabetic characters in a string.\n    Non-alphabetic characters remain unchanged.\"\"\"\n\n    def _validate_input(input_val) -> None:\n        \"\"\"Raises TypeError if the input is not a string.\"\"\"\n        if not isinstance(input_val, str):\n            raise TypeError(\"Input must be a string.\")\n\n    def _toggle_char(c: str) -> str:\n        \"\"\"Toggles the case of an alphabetic character; returns it unchanged otherwise.\"\"\"\n        if c.isalpha():\n            return c.swapcase()\n        return c\n\n    _validate_input(input)\n\n    toggled_chars = []\n    for char in input:\n        toggled_chars.append(_toggle_char(char))\n    return \"\".join(toggled_chars)"}
{"task_id": "Mbpp/556", "solution": "from typing import List\nclass ValidationException(Exception):\n    \"\"\"Exception type raised when inputs violate preconditions.\"\"\"\n    def __init__(self, message: str) -> None:\n        self.message = message\n        super().__init__(self.message)\nclass InputArray:\n    \"\"\"Wrap provided list of integers; provide length() and firstN(n).\"\"\"\n    def __init__(self, values: List[int]) -> None:\n        self.values = values\n\n    def length(self) -> int:\n        return len(self.values)\n\n    def firstN(self, n: int) -> List[int]:\n        return self.values[:n]\nclass PairCounter:\n    \"\"\"Provides counting operations; primary business logic.\"\"\"\n    def countOddXorPairs(self, values: List[int], n: int) -> int:\n        # XOR of two integers is odd iff their parities differ.\n        # This means result = (#odd_in_first_n) * (#even_in_first_n).\n        odds = self.countOdds(values, n)\n        evens = self.countEvens(values, n)\n        return odds * evens\n\n    def countOdds(self, values: List[int], n: int) -> int:\n        count = 0\n        for i in range(n):\n            if values[i] % 2 != 0:\n                count += 1\n        return count\n\n    def countEvens(self, values: List[int], n: int) -> int:\n        count = 0\n        for i in range(n):\n            if values[i] % 2 == 0:\n                count += 1\n        return count\ndef find_Odd_Pair(arr, n) -> int:\n    \"\"\"Public API: validate arr and n, then return integer count of unordered pairs with odd XOR.\"\"\"\n\n    # Validate n: must be int\n    if not isinstance(n, int):\n        raise ValidationException(\"n must be integer and 0 <= n <= len(arr)\")\n\n    # Validate n against arr length\n    # Instantiate InputArray(arr)\n    input_array_wrapper = InputArray(arr)\n    # Check length()\n    arr_len = input_array_wrapper.length()\n\n    if not (0 <= n <= arr_len):\n        raise ValidationException(\"n must be integer and 0 <= n <= len(arr)\")\n\n    # Get the first n elements\n    values_n = input_array_wrapper.firstN(n)\n\n    # Validate arr elements in arr[0:n]: all must be int.\n    for element in values_n:\n        if not isinstance(element, int):\n            raise ValidationException(\"arr elements must be integers\")\n\n    # Use PairCounter to compute the result.\n    pair_counter = PairCounter()\n    result_int = pair_counter.countOddXorPairs(values_n, n)\n\n    return result_int"}
{"task_id": "Mbpp/558", "solution": "from typing import List, Tuple\ndef _extract_digits(n: int) -> List[int]:\n    \"\"\"Returns digits least-significant-first for abs(n). For n == 0 returns [0].\"\"\"\n    if n == 0:\n        return [0]\n    \n    n_abs = abs(n)\n    digits = []\n    while n_abs > 0:\n        digits.append(n_abs % 10)\n        n_abs //= 10\n    return digits\ndef _align_digits(digits_a: List[int], digits_b: List[int]) -> Tuple[List[int], List[int]]:\n    \"\"\"Pads shorter digits list with zeros on the high-order side to equalize lengths; returns aligned lists.\"\"\"\n    max_len = max(len(digits_a), len(digits_b))\n    \n    aligned_a = digits_a + [0] * (max_len - len(digits_a))\n    aligned_b = digits_b + [0] * (max_len - len(digits_b))\n    \n    return aligned_a, aligned_b\ndef _sum_digit_differences(digits_a: List[int], digits_b: List[int]) -> int:\n    \"\"\"Computes and returns sum(abs(d_a - d_b) for each aligned position).\"\"\"\n    total_diff = 0\n    # Assumes digits_a and digits_b are already aligned and of the same length\n    for d_a, d_b in zip(digits_a, digits_b):\n        total_diff += abs(d_a - d_b)\n    return total_diff\ndef digit_distance_nums(a, b) -> int:\n    \"\"\"\n    Calculates the sum of per-digit absolute differences between two integers.\n    Raises TypeError if either a or b is not an int.\n    Decomposes negative integers by absolute value to extract digit magnitudes.\n    \"\"\"\n    _validate_inputs(a, b)\n    \n    digits_a = _extract_digits(a)\n    digits_b = _extract_digits(b)\n    \n    aligned_a, aligned_b = _align_digits(digits_a, digits_b)\n    \n    return _sum_digit_differences(aligned_a, aligned_b)"}
{"task_id": "Mbpp/560", "solution": "def union_elements(a: tuple, b: tuple) -> tuple:\n    \"\"\"\n    Finds the union of elements from two tuples and returns them in sorted order.\n    Duplicates are removed, and the final result is an immutable tuple.\n    \"\"\"\n    unique_elements = set(a) | set(b)\n    return tuple(sorted(list(unique_elements)))"}
{"task_id": "Mbpp/559", "solution": "from typing import List\ndef _select_prefix(lst: List[int], n: int) -> List[int]:\n    \"\"\"Return lst[0:min(n, len(lst))] per BR2/BR8.\"\"\"\n    return lst[:min(n, len(lst))]\ndef _compute_max_sum(partial_list: List[int]) -> int:\n    \"\"\"\n    Compute maximum contiguous subarray sum (subarray length >= 1).\n    Kadane-like scan adapted to disallow empty subarray.\n    \"\"\"\n    # This implementation assumes partial_list is non-empty, based on the design's\n    # intent to return at least a single element's sum.\n    current_sum = partial_list[0]\n    max_sum = partial_list[0]\n\n    for element in partial_list[1:]:\n        current_sum = max(element, current_sum + element)\n        max_sum = max(max_sum, current_sum)\n    return max_sum\ndef max_sub_array_sum(lst: List[int], n: int) -> int:\n    \"\"\"Public API per FR1: computes maximum contiguous subarray sum over first n elements.\"\"\"\n    _validate_inputs(lst, n)\n    prefix = _select_prefix(lst, n)\n    return _compute_max_sum(prefix)"}
{"task_id": "Mbpp/562", "solution": "def Find_Max_Length(input_list):\n    \"\"\"\n    Finds the length of the longest sublist within a list of sublists.\n    Returns 0 if the input list is empty.\n    \"\"\"\n    max_len = 0\n    for sublist in input_list:\n        current_len = 0\n        try:\n            current_len = len(sublist)\n        except TypeError:\n            # Fallback for iterables without __len__ (e.g., generators)\n            for _ in sublist:\n                current_len += 1\n        \n        if current_len > max_len:\n            max_len = current_len\n            \n    return max_len"}
{"task_id": "Mbpp/563", "solution": "import re\ndef extract_values(input: str) -> list:\n    \"\"\"\n    Extracts values between double quotation marks from a string.\n    Raises TypeError if the input is not a string.\n    \"\"\"\n    if not isinstance(input, str):\n        raise TypeError(\"input must be a str\")\n    \n    # Use regular expression to find all substrings enclosed in double quotes.\n    # The pattern r'\"([^\"]*)\"' matches a double quote, then captures any\n    # characters that are not a double quote (zero or more times),\n    # and then matches a closing double quote.\n    return re.findall(r'\"([^\"]*)\"', input)"}
{"task_id": "Mbpp/565", "solution": "def split(input_string: str) -> list[str]:\n    \"\"\"Return a list of single-character strings from input_string.\n    Raises TypeError if input_string is not an instance of str.\n    \"\"\"\n    if not isinstance(input_string, str):\n        raise TypeError('split: input must be a str')\n    return [c for c in input_string]"}
{"task_id": "Mbpp/566", "solution": "class InputInteger:\n    \"\"\"Represents a non-negative integer input.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\nclass Digit:\n    \"\"\"Represents a single decimal digit.\"\"\"\n    def __init__(self, position: int, value: int) -> None:\n        self.position = position\n        self.value = value\nclass SumResult:\n    \"\"\"Encapsulates the computed sum of digits.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\nclass SumDigitsFunction:\n    \"\"\"Stateless class to compute the sum of digits.\"\"\"\n    def sum_digits(self, n: int) -> int:\n        if n == 0:\n            return 0\n\n        # Create InputInteger object as per design context for domain mapping.\n        _ = InputInteger(n)\n\n        total_sum = 0\n        s_n = str(n)\n\n        # Iterate through digits, creating Digit objects and summing values.\n        for i, char_digit in enumerate(s_n):\n            digit_value = int(char_digit)\n            _ = Digit(position=i, value=digit_value) # Digit object created for domain model.\n            total_sum += digit_value\n        \n        # Encapsulate the result in a SumResult object as per design.\n        result_obj = SumResult(total_sum)\n        return result_obj.value\ndef sum_digits(n: int) -> int:\n    \"\"\"\n    Calculates the sum of the digits of a non-negative integer.\n    This function delegates to a SumDigitsFunction instance for the core logic.\n    \"\"\"\n    function_instance = SumDigitsFunction()\n    return function_instance.sum_digits(n)"}
