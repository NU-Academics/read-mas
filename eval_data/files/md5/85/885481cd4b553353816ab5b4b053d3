{"task_id": "Mbpp/453", "solution": "def sumofFactors(n: int) -> int:\n    \"\"\"Compute and return the sum of even positive divisors of n.\n\n    Returns 0 if no even positive divisors are found.\n    \"\"\"\n    total_sum = 0\n    # Iterate from 1 up to the absolute value of n to find positive divisors.\n    # If n is 0, range(1, 1) is empty, and total_sum remains 0, which is correct.\n    for f in range(1, abs(n) + 1):\n        # Check if f is a divisor of n and f is even.\n        if n % f == 0 and f % 2 == 0:\n            total_sum += f\n    return total_sum"}
{"task_id": "Mbpp/454", "solution": "import re\nclass InputText:\n    \"\"\"Holds the raw input string for a single invocation.\"\"\"\n    def __init__(self, raw_text: str):\n        self.raw_text = raw_text\nclass Word:\n    \"\"\"Represents a token and determines if it contains lowercase 'z'.\"\"\"\n    def __init__(self, token: str):\n        self.token = token\n\n    def contains_z(self) -> bool:\n        \"\"\"Checks if the word token contains the lowercase character 'z'.\"\"\"\n        return 'z' in self.token\nclass TextMatchWordz:\n    \"\"\"Orchestrates tokenization and detection, returning a boolean result.\"\"\"\n    def execute(self, text: InputText) -> bool:\n        \"\"\"Processes the input text to find words containing 'z'.\"\"\"\n        if not text.raw_text:\n            return False\n\n        # Tokenize by splitting on any non-word character and filter out empty strings\n        tokens = [t for t in re.split(r\"[^\\w]+\", text.raw_text) if t]\n\n        for token_str in tokens:\n            word = Word(token_str)\n            if word.contains_z():\n                return True\n        return False\ndef text_match_wordz(input_text: str) -> bool:\n    \"\"\"\n    Checks if any word in the input string contains the lowercase character 'z'.\n    Returns True if at least one such word is found, False otherwise.\n    \"\"\"\n    input_obj = InputText(input_text)\n    orchestrator = TextMatchWordz()\n    return orchestrator.execute(input_obj)"}
