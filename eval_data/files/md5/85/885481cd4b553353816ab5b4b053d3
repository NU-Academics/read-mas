{"task_id": "Mbpp/608", "solution": "from dataclasses import dataclass\nfrom datetime import datetime\nimport logging\nfrom typing import Any\nlogger = logging.getLogger(__name__)\nclass InputValidator:\n    \"\"\"Utility class for validating input parameters.\"\"\"\n    def is_integer(self, value: Any) -> bool:\n        \"\"\"Checks if the given value is an integer.\"\"\"\n        return isinstance(value, int)\n\n    def is_non_negative(self, value: int) -> bool:\n        \"\"\"Checks if the given integer value is non-negative.\"\"\"\n        return value >= 0\nclass BellNumberCalculator:\n    \"\"\"Calculates Bell numbers using the Bell triangle algorithm.\"\"\"\n    def __init__(self, validator: InputValidator, logger: logging.Logger):\n        self._validator = validator\n        self._logger = logger\n\n    def bell_Number(self, n: int) -> int:\n        \"\"\"\n        Validates input and computes the nth Bell number using the Bell triangle.\n        Raises ValueError for invalid input.\n        \"\"\"\n        if not self._validator.is_integer(n):\n            error_msg = f\"Input 'n' must be an integer, but received type {type(n).__name__}.\"\n            error_record = ErrorRecord(code=400, message=error_msg, timestamp=datetime.now())\n            self._logger.error(error_record)\n            raise ValueError(error_msg)\n\n        if not self._validator.is_non_negative(n):\n            error_msg = f\"Input 'n' must be non-negative, but received {n}.\"\n            error_record = ErrorRecord(code=400, message=error_msg, timestamp=datetime.now())\n            self._logger.error(error_record)\n            raise ValueError(error_msg)\n\n        result_value = self._compute_using_bell_triangle(n)\n        bell_result = BellNumberResult(n=n, value=result_value, computed_at=datetime.now())\n        return bell_result.value\n\n    def _compute_using_bell_triangle(self, n: int) -> int:\n        \"\"\"\n        Computes the nth Bell number using the Bell triangle algorithm.\n        The algorithm builds a 2D array where the Bell number B_n is the first element of row n.\n        \"\"\"\n        if n == 0:\n            return 1\n\n        # Initialize a 2D list for the Bell triangle\n        # bell[i][j] represents the number of partitions of a set of size i into j+1 non-empty subsets\n        # For B_n, we need a triangle up to row n\n        bell_triangle = [[0] * (i + 1) for i in range(n + 1)]\n\n        # Base case: B_0 = 1\n        bell_triangle[0][0] = 1\n\n        for i in range(1, n + 1):\n            # The first element of each row is the last element of the previous row\n            bell_triangle[i][0] = bell_triangle[i - 1][i - 1]\n            for j in range(1, i + 1):\n                # Subsequent elements are the sum of the element to their left and the element diagonally up-left\n                bell_triangle[i][j] = bell_triangle[i][j - 1] + bell_triangle[i - 1][j - 1]\n\n        # The nth Bell number is the first element of the nth row (0-indexed)\n        return bell_triangle[n][0]\n\n    # The following methods are defined in the design but marked as optional/alternative;\n    # they are kept as stubs to match the design's component list but are not used by bell_Number(self, n).\n    def _compute_using_dynamic_programming(self, n: int) -> int:\n        \"\"\"Alternative computation method using dynamic programming.\"\"\"\n        raise NotImplementedError(\"Dynamic programming method not implemented.\")\n\n    def _compute_using_stirling(self, n: int) -> int:\n        \"\"\"Alternative computation method using Stirling numbers of the second kind.\"\"\"\n        raise NotImplementedError(\"Stirling-based method not implemented.\")\ndef bell_Number(n: int) -> int:\n    \"\"\"\n    Finds the nth Bell number for a non-negative integer n.\n    Validates input and computes the result using an integer-only algorithm (Bell triangle).\n    \"\"\"\n    # Create instances of dependencies\n    validator = InputValidator()\n    # Use the module-level logger configured at the top\n    calculator = BellNumberCalculator(validator=validator, logger=logger)\n\n    # Delegate the call to the calculator instance\n    return calculator.bell_Number(n)"}
{"task_id": "Mbpp/611", "solution": "import math\ndef max_of_nth(matrix, n):\n    \"\"\"\n    Given a matrix (list of lists), return the maximum value from the n-th column.\n    Raises IndexError if any row is too short, TypeError if a column value is not numeric.\n    \"\"\"\n    if not matrix:\n        raise ValueError(\"Input matrix cannot be empty.\")\n\n    max_val = -math.inf # Initialize with negative infinity for robust max finding\n\n    for row_idx, row in enumerate(matrix):\n        if n >= len(row):\n            raise IndexError(f\"Row {row_idx} does not have an element at column index {n}.\")\n\n        value = row[n]\n        if not isinstance(value, (int, float)):\n            raise TypeError(f\"Value at row {row_idx}, column {n} is not numeric (int or float).\")\n        \n        if value > max_val:\n            max_val = value\n\n    return max_val"}
{"task_id": "Mbpp/614", "solution": "def cummulative_sum(tuples):\n    \"\"\"Accepts a list of tuples of integers and returns the cumulative sum (int).\"\"\"\n    total = 0\n    for tup in tuples:\n        for num in tup:\n            total += num\n    return total"}
{"task_id": "Mbpp/612", "solution": "def merge(pairs):\n    \"\"\"\n    Splits a list of two-element sublists into two separate lists:\n    one containing all first elements and another with all second elements.\n    Raises ValueError if any sublist does not contain exactly two elements.\n    \"\"\"\n    firsts = []\n    seconds = []\n    for sublist in pairs:\n        if len(sublist) != 2:\n            raise ValueError(\"Each sublist must contain exactly two elements.\")\n        firsts.append(sublist[0])\n        seconds.append(sublist[1])\n    return [firsts, seconds]"}
{"task_id": "Mbpp/615", "solution": "from typing import Tuple, List\ndef _compute_average_for_tuple(inner: Tuple[float, ...]) -> float:\n    \"\"\"Return arithmetic mean (float) for non-empty inner; raise ValueError if empty.\"\"\"\n    if not inner:\n        raise ValueError(\"Inner tuple cannot be empty.\")\n    return sum(inner) / len(inner)\ndef average_tuple(input_tuple_of_tuples: Tuple[Tuple[float, ...], ...]) -> List[float]:\n    \"\"\"Public API: Accepts a tuple of tuples (ints/floats allowed) and returns list[float].\n    Raises TypeError or ValueError per SRS business rules.\n    \"\"\"\n    _validate_outer_is_tuple(input_tuple_of_tuples)\n\n    if not input_tuple_of_tuples:\n        return []\n\n    _validate_inner_items_are_tuples(input_tuple_of_tuples)\n\n    result = []\n    for inner_tuple in input_tuple_of_tuples:\n        _validate_elements_are_numeric(inner_tuple)\n        avg = _compute_average_for_tuple(inner_tuple)\n        result.append(avg)\n\n    return result"}
{"task_id": "Mbpp/616", "solution": "def tuple_modulo(dividend_tuple, divisor_tuple) -> tuple:\n    \"\"\"Public API: compute element-wise integer modulo.\n    Raises: TypeError, ValueError, ZeroDivisionError per SRS.\n    \"\"\"\n    _validate_is_tuple(dividend_tuple, 'dividend_tuple')\n    _validate_is_tuple(divisor_tuple, 'divisor_tuple')\n    _validate_same_length(dividend_tuple, divisor_tuple)\n    _validate_integer_elements(dividend_tuple, 'dividend_tuple')\n    _validate_integer_elements(divisor_tuple, 'divisor_tuple')\n    _check_zero_divisors(divisor_tuple)\n\n    return tuple(d % s for d, s in zip(dividend_tuple, divisor_tuple))"}
{"task_id": "Mbpp/619", "solution": "from typing import Tuple\ndef _split_digits_and_chars(s: str) -> Tuple[str, str]:\n    \"\"\"Separates a string into non-digit and digit characters, preserving relative order.\"\"\"\n    non_digits_parts = []\n    digits_parts = []\n    for char in s:\n        if char.isdigit():\n            digits_parts.append(char)\n        else:\n            non_digits_parts.append(char)\n    return \"\".join(non_digits_parts), \"\".join(digits_parts)\ndef move_num(input: str) -> str:\n    \"\"\"Moves all numeric characters to the end of the string, preserving relative order within non-digits and digits.\"\"\"\n    non_digits, digits = _split_digits_and_chars(input)\n    return non_digits + digits"}
{"task_id": "Mbpp/620", "solution": "from typing import List, Optional\nclass Element:\n    \"\"\"Represent a single integer element from the input list with optional position metadata.\"\"\"\n    def __init__(self, value: int, position: int) -> None:\n        self.value = value\n        self.position = position\nclass DivisibilityCheck:\n    \"\"\"Encapsulate divisibility rule (b % a == 0).\"\"\"\n    def divides(self, a: int, b: int) -> bool:\n        \"\"\"Returns True iff b % a == 0, handling a=0 such that 0 divides only 0.\"\"\"\n        if a == 0:\n            return b == 0\n        return b % a == 0\nclass LargestSubsetFunction:\n    \"\"\"Orchestrator implementing algorithm to compute largest divisible subset size.\"\"\"\n    def __init__(self) -> None:\n        self._checker = DivisibilityCheck()\n\n    def largest_subset(self, nums: List[int]) -> int:\n        \"\"\"Computes the size of the largest divisible subset using dynamic programming.\"\"\"\n        if not nums:\n            return 0\n\n        # Create Element objects and sort them by their value.\n        elements = sorted([Element(value, i) for i, value in enumerate(nums)], key=lambda x: x.value)\n\n        # dp[i] stores the size of the largest divisible subset ending with elements[i].\n        dp = [1] * len(elements)\n        max_len = 1 # Initialize with 1, as any single element forms a valid subset.\n\n        for i in range(len(elements)):\n            for j in range(i):\n                # Since elements are sorted (elements[j].value <= elements[i].value),\n                # for the pair to be divisible, elements[j].value must divide elements[i].value.\n                if self._checker.divides(elements[j].value, elements[i].value):\n                    dp[i] = max(dp[i], dp[j] + 1)\n            max_len = max(max_len, dp[i])\n        \n        return max_len\ndef largest_subset(nums: List[int]) -> int:\n    \"\"\"Entry function required by FR1; returns int per SRS.\"\"\"\n    svc = LargestSubsetFunction()\n    return svc.largest_subset(nums)"}
{"task_id": "Mbpp/618", "solution": "class DivisionByZeroError(Exception):\n    \"\"\"Raised when an element in the divisor list is zero.\"\"\"\n    pass\ndef div_list(listA, listB):\n    \"\"\"\n    Divides two lists element-wise, returning a new list of floating-point results.\n    Performs validation for list types, equal length, numeric elements, and division by zero.\n    \"\"\"\n    _validate_is_list(listA, 'listA')\n    _validate_is_list(listB, 'listB')\n    _validate_equal_length(listA, listB)\n    _validate_numeric_elements(listA, 'listA')\n    _validate_numeric_elements(listB, 'listB')\n\n    result = []\n    for i in range(len(listA)):\n        numerator = listA[i]\n        denominator = listB[i]\n\n        if denominator == 0:\n            raise DivisionByZeroError(f\"Division by zero at index {i}.\")\n\n        result.append(numerator / denominator)\n\n    return result"}
{"task_id": "Mbpp/622", "solution": "from dataclasses import dataclass\nclass ValidationError(Exception):\n    \"\"\"Domain error type for validation failures.\"\"\"\n    def __init__(self, message, code=None):\n        super().__init__(message)\n        self.message = message\n        self.code = code\n\n    def __str__(self):\n        return self.message\nclass Validator:\n    \"\"\"Stateless validation routines for input lists.\"\"\"\n    def validate_lengths(self, list1: list, list2: list, n: int):\n        \"\"\"Checks if both lists have the required length n.\"\"\"\n        if len(list1) != n or len(list2) != n:\n            raise ValidationError(f\"Input lists must both be of length {n}.\")\n        if len(list1) != len(list2):\n            raise ValidationError(\"Input lists must have the same length.\")\n\n    def validate_sorted(self, lst: list):\n        \"\"\"Checks if a list is sorted in non-decreasing order.\"\"\"\n        list_input = ListInput(lst)\n        if not list_input.is_sorted():\n            raise ValidationError(f\"List is not sorted in non-decreasing order: {lst}\")\nclass MedianCalculator:\n    \"\"\"Encapsulates the algorithm to compute the median of two equal-length sorted lists.\"\"\"\n    def __init__(self, list1: list, list2: list, n: int):\n        self.list1 = list1\n        self.list2 = list2\n        self.n = n\n\n    def compute(self) -> float:\n        \"\"\"Computes the median of the two sorted lists using a partition-based binary search.\"\"\"\n        return self._compute_median_from_partitions()\n\n    def _compute_median_from_partitions(self) -> float:\n        \"\"\"Implements the core partition-based median computation.\"\"\"\n        list1 = self.list1\n        list2 = self.list2\n        n = self.n\n\n        low, high = 0, n  # Binary search range for partition point in list1\n\n        while low <= high:\n            i = (low + high) // 2  # Partition point for list1 (i elements in left part)\n            j = n - i             # Partition point for list2 (j elements in left part)\n\n            # Determine boundary elements, using -infinity and +infinity for edge cases\n            max_left_1 = list1[i-1] if i > 0 else float('-inf')\n            min_right_1 = list1[i] if i < n else float('inf')\n\n            max_left_2 = list2[j-1] if j > 0 else float('-inf')\n            min_right_2 = list2[j] if j < n else float('inf')\n\n            if max_left_1 <= min_right_2 and max_left_2 <= min_right_1:\n                # Found the correct partition\n                median_elem1 = max(max_left_1, max_left_2)\n                median_elem2 = min(min_right_1, min_right_2)\n                return (median_elem1 + median_elem2) / 2.0\n            elif max_left_1 > min_right_2:\n                # Too many elements taken from list1, need to reduce i\n                high = i - 1\n            else: # max_left_2 > min_right_1\n                # Too few elements taken from list1, need to increase i\n                low = i + 1\n        return 0.0 # Should not be reached for n >= 0 with valid inputs\ndef get_median(list1: list, list2: list, n: int) -> float:\n    \"\"\"Public API that validates inputs and returns median as float or raises ValidationError.\"\"\"\n    validator = Validator()\n    validator.validate_lengths(list1, list2, n)\n    validator.validate_sorted(list1)\n    validator.validate_sorted(list2)\n\n    calc = MedianCalculator(list1, list2, n)\n    result_value = calc.compute()\n    return float(result_value)"}
