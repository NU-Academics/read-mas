{"task_id": "Mbpp/603", "solution": "class Validator:\n    \"\"\"Provides utility methods for input validation.\"\"\"\n    def is_integer(self, value) -> bool:\n        \"\"\"Checks if the given value is an integer.\"\"\"\n        return isinstance(value, int)\n\n    def is_non_negative(self, n: int) -> bool:\n        \"\"\"Checks if the given integer n is non-negative.\"\"\"\n        return n >= 0\nclass LudicList:\n    \"\"\"A container for ludic numbers, ensuring sorted unique output.\"\"\"\n    def __init__(self, values: list[int]):\n        \"\"\"Initializes LudicList with a list of integer values.\"\"\"\n        self.values = values\n\n    def to_sorted_unique(self) -> list[int]:\n        \"\"\"Returns the contained ludic numbers as a sorted, unique list.\"\"\"\n        return sorted(list(set(self.values)))\nclass LudicFunction:\n    \"\"\"Computes ludic numbers using a sieve-like algorithm.\"\"\"\n    def get_ludic(self, n: int) -> list[int]:\n        \"\"\"Orchestrates the generation and filtering of ludic numbers up to n.\"\"\"\n        sequence = self._generate_sequence(n)\n        raw_ludics = self._filter_ludic(sequence, n)\n        \n        ludic_list_obj = LudicList(raw_ludics)\n        return ludic_list_obj.to_sorted_unique()\n\n    def _generate_sequence(self, max_n: int) -> list[int]:\n        \"\"\"Generates an initial sequence of natural numbers from 1 up to max_n.\"\"\"\n        if max_n < 1:\n            return []\n        return list(range(1, max_n + 1))\n\n    def _filter_ludic(self, seq: list[int], max_n: int) -> list[int]:\n        \"\"\"Filters a sequence to find ludic numbers using a sieve method.\"\"\"\n        # max_n parameter is included as per design, though its value is not directly\n        # used in this specific sieve algorithm once the initial sequence `seq` is provided.\n        current_candidates = list(seq)\n        ludic_numbers = []\n\n        while current_candidates:\n            p = current_candidates[0]\n            ludic_numbers.append(p)\n\n            current_candidates.pop(0)\n            \n            if p == 1:\n                continue \n\n            new_candidates = []\n            count = 1 \n            for x in current_candidates:\n                if count % p != 0:\n                    new_candidates.append(x)\n                count += 1\n            current_candidates = new_candidates\n            \n        return ludic_numbers\ndef get_ludic(n: int) -> list:\n    \"\"\"\n    Returns a sorted list of all ludic numbers less than or equal to n.\n    Raises TypeError if n is not an integer. Returns an empty list if n < 1.\n    \"\"\"\n    validator = Validator()\n\n    if not validator.is_integer(n):\n        raise TypeError(\"Input must be an integer.\")\n\n    if n < 1:\n        return []\n\n    ludic_generator = LudicFunction()\n    return ludic_generator.get_ludic(n)"}
{"task_id": "Mbpp/607", "solution": "from dataclasses import dataclass\nimport re\nclass RegexEngine:\n    def search(self, source: SourceString, pattern: RegexPattern) -> MatchResult | None:\n        \"\"\"Interpret pattern.pattern as a regular expression and return the first MatchResult or None if no match.\"\"\"\n        compiled = re.compile(pattern.pattern)\n        m = compiled.search(source.content)\n        if not m:\n            return None\n        substring = source.content[m.start():m.end()]\n        return MatchResult(substring=substring, start_index=m.start(), end_index=m.end())\ndef find_literals(source, pattern):\n    \"\"\"Public API per SRS: find_literals(source, pattern) -> (matching_substring, start_index, end_index).\n    If no match is found, returns None.\n    \"\"\"\n    src_obj = SourceString(content=source)\n    pat_obj = RegexPattern(pattern=pattern)\n    engine = RegexEngine()\n    result = engine.search(src_obj, pat_obj)\n    if result is None:\n        return None\n    assert result.substring == source[result.start_index:result.end_index]\n    return (result.substring, result.start_index, result.end_index)"}
