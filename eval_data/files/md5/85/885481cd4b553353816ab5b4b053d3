{"task_id": "Mbpp/429", "solution": "class ValidationError(Exception):\n    \"\"\"Exception raised for validation errors in tuple operations.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\nclass AndTuplesFunction:\n    \"\"\"Encapsulates validation and elementwise bitwise AND computation for tuples.\"\"\"\n    name: str = \"and_tuples\"\n\n    def validate_element_types(self, input_tuple: tuple[int, ...], input_name: str) -> None:\n        \"\"\"Validates that all elements in the given tuple are integers.\"\"\"\n        for i, element in enumerate(input_tuple):\n            if not isinstance(element, int):\n                raise ValidationError(f\"non-integer element at index {i} in {input_name}: {repr(element)}\")\n\n    def validate_lengths(self, inputA: tuple[int, ...], inputB: tuple[int, ...]) -> None:\n        \"\"\"Validates that both input tuples have the same length.\"\"\"\n        if len(inputA) != len(inputB):\n            raise ValidationError(f\"length mismatch: len(inputA)={len(inputA)} != len(inputB)={len(inputB)}\")\n\n    def execute(self, inputA: tuple[int, ...], inputB: tuple[int, ...]) -> tuple[int, ...]:\n        \"\"\"Performs validation and computes the elementwise bitwise AND of two tuples.\"\"\"\n        self.validate_element_types(inputA, \"inputA\")\n        self.validate_element_types(inputB, \"inputB\")\n        self.validate_lengths(inputA, inputB)\n\n        result = [a & b for a, b in zip(inputA, inputB)]\n        return tuple(result)\ndef and_tuples(inputA: tuple[int, ...], inputB: tuple[int, ...]) -> tuple[int, ...]:\n    \"\"\"\n    Extracts the elementwise bitwise AND from two given tuples.\n\n    This function validates inputs for type, length, and element types, raising ValidationError on failure.\n    \"\"\"\n    impl = AndTuplesFunction()\n    return impl.execute(inputA, inputB)"}
{"task_id": "Mbpp/432", "solution": "class Trapezium:\n    \"\"\"Represents a trapezium with two parallel bases and non-parallel sides.\"\"\"\n    def __init__(self, base1: float, base2: float, nonParallelSide1: float = 0.0, nonParallelSide2: float = 0.0):\n        self.base1 = base1\n        self.base2 = base2\n        self.nonParallelSide1 = nonParallelSide1\n        self.nonParallelSide2 = nonParallelSide2\n\n    def median(self) -> float:\n        \"\"\"Calculates the median length of the trapezium.\"\"\"\n        return (self.base1 + self.base2) / 2\ndef median_trapezium(base1: float, base2: float, param3: float) -> float:\n    \"\"\"Compute median = (base1 + base2) / 2. Accepts but ignores param3 as required by SRS.\"\"\"\n    trapezium = Trapezium(base1, base2)\n    return trapezium.median()"}
