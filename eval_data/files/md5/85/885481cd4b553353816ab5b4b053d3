{"task_id": "Mbpp/754", "solution": "def extract_index_list(l1: list, l2: list, l3: list) -> list:\n    \"\"\"Return list of values v such that for index i (0 <= i < min_len) l1[i] == l2[i] == l3[i].\"\"\"\n    \n    result = []\n    min_len = min(len(l1), len(l2), len(l3))\n\n    for i in range(min_len):\n        if l1[i] == l2[i] == l3[i]:\n            result.append(l1[i])\n            \n    return result"}
{"task_id": "Mbpp/757", "solution": "from typing import List\ndef count_reverse_pairs(list_of_strings: List[str]) -> int:\n    \"\"\"\n    Counts unordered pairs of strings where one string is the exact character-wise\n    reverse of the other. Each unique pair is counted exactly once.\n    \"\"\"\n    if not list_of_strings:\n        return 0\n\n    string_set = set(list_of_strings)\n    pair_count = 0\n    seen_pairs = set()\n\n    for s in string_set:\n        reversed_s = s[::-1]\n        \n        # Ensure 's' is not a palindrome (s != reversed_s) to count distinct pairs\n        # and check if its reverse exists in the set of available strings.\n        if s != reversed_s and reversed_s in string_set:\n            # Create a canonical representation of the unordered pair\n            # using frozenset to ensure uniqueness regardless of order (e.g., {'a', 'b'} == {'b', 'a'})\n            current_pair = frozenset({s, reversed_s})\n            \n            if current_pair not in seen_pairs:\n                pair_count += 1\n                seen_pairs.add(current_pair)\n                \n    return pair_count"}
{"task_id": "Mbpp/755", "solution": "from typing import Sequence, List, Any\ndef _sorted_copy(list_of_numbers: Sequence[float]) -> List[float]:\n    \"\"\"Returns a new list sorted in ascending order, without modifying the original.\"\"\"\n    return sorted(list_of_numbers)\ndef second_smallest(list_of_numbers: Sequence[float]) -> float:\n    \"\"\"Finds the second smallest number in a list after validating input.\n    Raises TypeError for non-numeric elements or ValueError if the list has fewer than two elements.\"\"\"\n    _validate_numeric_list(list_of_numbers)\n    sorted_list = _sorted_copy(list_of_numbers)\n    return sorted_list[1]"}
