{"task_id": "Mbpp/103", "solution": "import functools\nclass Validation:\n    \"\"\"Validate input parameters n and m.\"\"\"\n    def validate(self, n: int, m: int) -> bool:\n        # Per design, returns True if inputs are integers.\n        # Given \"DO NOT add isinstance() checks\", we assume valid types.\n        return True\nclass EulerianCalculator:\n    \"\"\"Encapsulates computation logic for Eulerian numbers.\"\"\"\n\n    @functools.lru_cache(maxsize=None)\n    def computeRecursive(self, n: int, m: int) -> int:\n        \"\"\"\n        Recursively computes a(n,m) using the recurrence relation.\n        Handles base cases for recursive calls: a(0,0)=1, and 0 for invalid m.\n        \"\"\"\n        if m < 0 or m >= n:\n            return 0\n        if n == 0 and m == 0:\n            return 1\n        \n        term1 = (n - m) * self.computeRecursive(n - 1, m - 1)\n        term2 = (m + 1) * self.computeRecursive(n - 1, m)\n        return term1 + term2\n\n    def compute(self, n: int, m: int) -> int:\n        \"\"\"\n        Delegates to recursive computation after initial checks.\n        This method acts as a wrapper for computeRecursive.\n        \"\"\"\n        return self.computeRecursive(n, m)\n\n    def isPure(self) -> bool:\n        \"\"\"Returns True to indicate stateless/pure implementation.\"\"\"\n        return True\ndef eulerian_num(n: int, m: int) -> int:\n    \"\"\"\n    Finds the Eulerian number a(n, m).\n    Validates inputs, applies initial rules, then delegates to EulerianCalculator.\n    \"\"\"\n    validator = Validation()\n    # The design implies a validation check; assuming it passes given \"DO NOT add isinstance() checks\".\n    # if not validator.validate(n, m):\n    #     return 0 # This path is skipped based on implementation constraints.\n\n    if m < 0 or m >= n:\n        return 0\n    \n    if n == 0 and m == 0:\n        return 1\n\n    calculator = EulerianCalculator()\n    return calculator.compute(n, m)"}
{"task_id": "Mbpp/109", "solution": "class Rotation:\n    def __init__(self, index: int, rotated_value: str) -> None:\n        self.index = index\n        self.rotated_value = rotated_value\n\n    def is_odd(self) -> bool:\n        \"\"\"Determines if the rotated string represents an odd number.\"\"\"\n        return bool(self.rotated_value) and self.rotated_value[-1] == '1'\ndef _is_binary_string(s: str) -> bool:\n    \"\"\"Checks if a string contains only '0' and '1' characters.\"\"\"\n    if not isinstance(s, str): # The design implied type checking in validator.\n        return False\n    return all(c in '01' for c in s)\nclass Validator:\n    def validate_binary_string(self, s: str) -> bool:\n        return _is_binary_string(s)\n\n    def validate_rotations(self, r: int) -> bool:\n        \"\"\"Validates if rotations is a non-negative integer.\"\"\"\n        if not isinstance(r, int): # The design implied type checking in validator.\n            return False\n        return r >= 0\nclass RotationEvaluator:\n    def __init__(self, validator: 'Validator' = None) -> None:\n        self.validator = validator if validator is not None else Validator()\n\n    def apply_left_shift(self, s: str) -> str:\n        \"\"\"Performs a single cyclic left shift on a string.\"\"\"\n        if not s:\n            return s\n        return s[1:] + s[0]\n\n    def odd_Equivalent(self, binary_string: str, rotations: int) -> int:\n        \"\"\"\n        Evaluates rotations of a binary string and counts odd values.\n        The original string is included in the rotations.\n        \"\"\"\n        # Note: Per output requirements, this function avoids direct isinstance checks and exceptions.\n        # Validation checks are performed, but on invalid input, it returns 0 instead of raising an error.\n        if not self.validator.validate_binary_string(binary_string):\n            return 0\n        if not self.validator.validate_rotations(rotations):\n            return 0\n\n        odd_count = 0\n        current_string = binary_string\n\n        if not binary_string: # Handle empty string explicitly early\n            return 0\n\n        for i in range(rotations):\n            rotation_instance = Rotation(i, current_string)\n            if rotation_instance.is_odd():\n                odd_count += 1\n            current_string = self.apply_left_shift(current_string)\n\n        return odd_count\ndef odd_Equivalent(binary_string, rotations) -> int:\n    \"\"\"\n    Finds the number of numbers with an odd value when rotating a binary string\n    the given number of times.\n    \"\"\"\n    evaluator = RotationEvaluator()\n    return evaluator.odd_Equivalent(binary_string, rotations)"}
{"task_id": "Mbpp/101", "solution": "from typing import Any, List, Optional\ndef kth_element(array: List[Any], k: int) -> Any:\n    \"\"\"Return the k-th element (1-based) of array.\n    If k is outside the range [1, len(array)], this implementation returns None.\n    \"\"\"\n    n = len(array)\n    if 1 <= k <= n:\n        idx = k - 1\n        return array[idx]\n    return None"}
{"task_id": "Mbpp/113", "solution": "from dataclasses import dataclass\nfrom typing import Optional\nclass CheckIntegerFunction:\n    \"\"\"Stateless validator implementing the domain operation.\"\"\"\n    def __init__(self) -> None:\n        pass\n\n    def check(self, input_str: str) -> ValidationResult:\n        s = input_str.strip()\n\n        if s == \"\":\n            return ValidationResult(is_integer=False, reason=\"empty string\")\n\n        digits_part: str\n        if s[0] in ['+', '-']:\n            if len(s) == 1:\n                return ValidationResult(is_integer=False, reason=\"sign only\")\n            digits_part = s[1:]\n        else:\n            digits_part = s\n\n        if all(c in '0123456789' for c in digits_part):\n            return ValidationResult(is_integer=True, reason=None)\n        else:\n            return ValidationResult(is_integer=False, reason=\"non-digit characters present\")\ndef check_integer(input_str: str) -> bool:\n    \"\"\"Public API: returns True if input_str represents an integer per SRS; else False.\"\"\"\n    validator = CheckIntegerFunction()\n    result = validator.check(input_str)\n    return result.is_integer"}
