{"task_id": "Mbpp/589", "solution": "import math\ndef perfect_squares(start: int, end: int) -> list[int]:\n    \"\"\"\n    Find perfect squares between two given numbers (inclusive).\n    Returns a list of perfect squares n*n such that start <= n*n <= end.\n    \"\"\"\n    # Calculate the lower bound for n (ceil(sqrt(start)))\n    # We must ensure start is not negative before taking sqrt\n    start_n = math.ceil(math.sqrt(max(0, start)))\n\n    # Calculate the upper bound for n (floor(sqrt(end)))\n    # If end is negative, no perfect squares can exist.\n    if end < 0:\n        return []\n    end_n = math.floor(math.sqrt(end))\n\n    # If the lower bound for n is greater than the upper bound, no squares exist in the range.\n    if start_n > end_n:\n        return []\n\n    # Generate the perfect squares by iterating from start_n to end_n (inclusive).\n    return [n * n for n in range(start_n, end_n + 1)]"}
{"task_id": "Mbpp/588", "solution": "from typing import List, Union\nNumber = Union[int, float]\ndef big_diff(values: List[Number]) -> float:\n    \"\"\"Find the difference between the largest and smallest value in a given list.\"\"\"\n    mx = max(values)\n    mn = min(values)\n    diff = mx - mn\n    return diff"}
{"task_id": "Mbpp/591", "solution": "def swap_List(input_list):\n    \"\"\"Accepts a single argument (input_list). Returns a list where first and last elements are swapped per SRS.\n    If input_list has fewer than two elements, return it unchanged.\n    \"\"\"\n    if len(input_list) < 2:\n        return input_list\n    \n    input_list[0], input_list[-1] = input_list[-1], input_list[0]\n    return input_list"}
{"task_id": "Mbpp/590", "solution": "import math\nfrom typing import Tuple\ndef polar_rect(a: float, b: float) -> Tuple[Tuple[float, float], complex]:\n    \"\"\"Interpret inputs as polar coordinates (r, theta) and return ((r_float, theta_float), complex(x,y)).\"\"\"\n    radius = float(a)\n    angle = float(b)\n    x = radius * math.cos(angle)\n    y = radius * math.sin(angle)\n    return ((radius, angle), complex(x, y))"}
{"task_id": "Mbpp/592", "solution": "def sum_Of_product(n):\n    \"\"\"\n    Finds the sum of the product of consecutive binomial coefficients C(n,k) * C(n,k+1).\n    This function implements the calculation for sum_{k=0..n-1} C(n,k) * C(n,k+1).\n    \"\"\"\n\n    class BinomialCoefficient:\n        @staticmethod\n        def compute(n: int, k: int) -> int:\n            \"\"\"\n            Computes the binomial coefficient C(n, k) using an iterative multiplicative formula.\n            Handles cases where k < 0, k > n, or n < 0 according to combinatorial conventions\n            and design specifications.\n            \"\"\"\n            if not isinstance(n, int) or not isinstance(k, int):\n                raise ValueError(\"n and k must be integers\")\n            if n < 0:\n                raise ValueError(\"n must be a non-negative integer for binomial coefficient calculation\")\n            if k < 0 or k > n:\n                return 0\n\n            # Optimize for C(n, k) = C(n, n-k)\n            k_prime = min(k, n - k)\n            \n            result = 1\n            for i in range(1, k_prime + 1):\n                result = result * (n - k_prime + i) // i\n            return result\n\n    def validate_n(n_val) -> None:\n        \"\"\"\n        Validates that n is a non-negative integer.\n        Raises ValueError if validation fails.\n        \"\"\"\n        if not isinstance(n_val, int):\n            raise ValueError(\"n must be an integer\")\n        if n_val < 0:\n            raise ValueError(\"n must be a non-negative integer\")\n\n    validate_n(n)\n\n    if n == 0:\n        return 0\n\n    accumulator = 0\n    for k in range(n):\n        term_k = BinomialCoefficient.compute(n, k)\n        term_k_plus_1 = BinomialCoefficient.compute(n, k + 1)\n        accumulator += term_k * term_k_plus_1\n\n    return accumulator"}
{"task_id": "Mbpp/593", "solution": "from typing import List\nclass Octet:\n    \"\"\"\n    Represents a single IP octet and handles leading zero trimming.\n    \"\"\"\n    def __init__(self, raw: str, position: int):\n        self.raw = raw\n        self.position = position\n        self.normalized: str = \"\"\n\n    def trimLeadingZeros(self) -> str:\n        \"\"\"\n        Removes leading '0's, treating empty results as '0', and preserving single '0'.\n        \"\"\"\n        if self.raw == '0':\n            self.normalized = '0'\n        else:\n            trimmed = self.raw.lstrip('0')\n            self.normalized = '0' if trimmed == '' else trimmed\n        return self.normalized\nclass IPAddress:\n    \"\"\"\n    Represents an IP address, handling parsing into octets and reassembly.\n    \"\"\"\n    def __init__(self, raw: str):\n        self.raw = raw\n        self.octets: List[Octet] = []\n\n    def parse(self) -> List[Octet]:\n        \"\"\"\n        Splits the raw IP string into Octet instances.\n        \"\"\"\n        parts = self.raw.split('.')\n        self.octets = [Octet(raw=part, position=i) for i, part in enumerate(parts)]\n        return self.octets\n\n    def toString(self) -> str:\n        \"\"\"\n        Reassembles the normalized octet values into a dotted string.\n        \"\"\"\n        return '.'.join([octet.normalized for octet in self.octets])\nclass RemoveZeroIPFunction:\n    \"\"\"\n    Implements the IP address trimming algorithm by coordinating domain classes.\n    \"\"\"\n    def removezero_ip(self, input: str) -> str:\n        \"\"\"\n        Processes an IP string to remove leading zeros from its octets.\n        \"\"\"\n        ip_address = IPAddress(raw=input)\n        octets = ip_address.parse()\n\n        for octet in octets:\n            octet.trimLeadingZeros()\n\n        return ip_address.toString()\ndef removezero_ip(input: str) -> str:\n    \"\"\"\n    Public API per SRS: removezero_ip(input: string) -> string.\n    Delegates processing to RemoveZeroIPFunction.\n    \"\"\"\n    service = RemoveZeroIPFunction()\n    return service.removezero_ip(input)"}
