{"task_id": "Mbpp/233", "solution": "import math\ndef lateralsuface_cylinder(height, radius):\n    \"\"\"\n    Calculates the lateral surface area of a cylinder.\n    \"\"\"\n    if not isinstance(height, (int, float)) or isinstance(height, bool):\n        raise TypeError(\"height must be numeric (int or float)\")\n    if not isinstance(radius, (int, float)) or isinstance(radius, bool):\n        raise TypeError(\"radius must be numeric (int or float)\")\n\n    lateral_area = 2 * math.pi * radius * height\n    return float(lateral_area)"}
{"task_id": "Mbpp/232", "solution": "class ErrorHandler:\n    \"\"\"Handles raising TypeErrors with specific messages.\"\"\"\n    def raiseTypeError(self, message: str) -> None:\n        raise TypeError(message)\nclass InputList:\n    \"\"\"Wrapper for the input list, providing elements and length.\"\"\"\n    def __init__(self, elements: list) -> None:\n        self.elements = elements\n    def length(self) -> int:\n        return len(self.elements)\nclass ResultList:\n    \"\"\"Wrapper for the result list, providing elements and length.\"\"\"\n    def __init__(self, elements: list) -> None:\n        self.elements = elements\n    def length(self) -> int:\n        return len(self.elements)\nclass Validator:\n    \"\"\"Validates input types and calls ErrorHandler on invalid inputs.\"\"\"\n    def __init__(self, error_handler: 'ErrorHandler') -> None:\n        self._error_handler = error_handler\n\n    def validateListTypes(self, input_list: list) -> bool:\n        \"\"\"Ensures input_list is a list of integers.\"\"\"\n        if not isinstance(input_list, list):\n            self._error_handler.raiseTypeError('input_list must be a list of integers')\n        for item in input_list:\n            if not isinstance(item, int):\n                self._error_handler.raiseTypeError('input_list must be a list of integers')\n        return True\n\n    def validateN(self, n: int) -> bool:\n        \"\"\"Ensures n is an integer.\"\"\"\n        if not isinstance(n, int):\n            self._error_handler.raiseTypeError('n must be an int')\n        return True\nclass Processor:\n    \"\"\"Computes top-n elements, handling sorting and edge cases.\"\"\"\n    def sortDescending(self, elements: list[int]) -> list[int]:\n        \"\"\"Sorts a list of integers in descending order.\"\"\"\n        return sorted(elements, reverse=True)\n\n    def selectTopN(self, elements: list[int], n: int) -> list[int]:\n        \"\"\"Selects the top N elements from a sorted list, handling edge cases.\"\"\"\n        if n <= 0:\n            return []\n        if n >= len(elements):\n            return elements\n        return elements[:n]\nclass LargNnumFunction:\n    \"\"\"Orchestrates validation and processing to find the n largest numbers.\"\"\"\n    def __init__(self, input_list: list, n: int) -> None:\n        self.inputList = InputList(input_list)\n        self.n = n\n        self._error_handler = ErrorHandler()\n        self._validator = Validator(self._error_handler)\n        self._processor = Processor()\n\n    def validateInputs(self) -> bool:\n        \"\"\"Validates the input list and n using the Validator.\"\"\"\n        self._validator.validateListTypes(self.inputList.elements)\n        self._validator.validateN(self.n)\n        return True\n\n    def computeTopN(self) -> list:\n        \"\"\"Sorts the list and selects the top n elements.\"\"\"\n        sorted_elements = self._processor.sortDescending(self.inputList.elements)\n        return self._processor.selectTopN(sorted_elements, self.n)\n\n    def execute(self) -> list:\n        \"\"\"Executes the main logic: validates inputs, computes top n, and returns result.\"\"\"\n        self.validateInputs()\n        top_n_elements = self.computeTopN()\n        result_list_obj = ResultList(top_n_elements)\n        return result_list_obj.elements\ndef larg_nnum(input_list: list, n: int) -> list:\n    \"\"\"\n    Returns a list containing the n largest items from the input list.\n\n    Delegates to LargNnumFunction for validation and processing.\n    \"\"\"\n    largNnumFunc = LargNnumFunction(input_list, n)\n    return largNnumFunc.execute()"}
