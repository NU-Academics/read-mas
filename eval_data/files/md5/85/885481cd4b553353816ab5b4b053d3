{"task_id": "Mbpp/171", "solution": "class Pentagon:\n    \"\"\"Represents a regular pentagon with a given side length.\"\"\"\n    def __init__(self, side_length: float):\n        self.side_length = side_length\n        self.perimeter = 0.0\n\n    def compute_perimeter(self) -> float:\n        \"\"\"Computes and stores the perimeter of the pentagon.\"\"\"\n        self.perimeter = 5 * self.side_length\n        return self.perimeter\nclass PerimeterCalculator:\n    \"\"\"Encapsulates the calculation of the perimeter for geometric shapes.\"\"\"\n    @staticmethod\n    def perimeter_pentagon(side_length: float) -> float:\n        \"\"\"Calculates the perimeter of a regular pentagon.\"\"\"\n        pentagon = Pentagon(side_length)\n        return pentagon.compute_perimeter()\ndef perimeter_pentagon(side_length: float) -> float:\n    \"\"\"Compute and return the perimeter of a regular pentagon: 5 * side_length.\"\"\"\n    return PerimeterCalculator.perimeter_pentagon(side_length)"}
{"task_id": "Mbpp/224", "solution": "def count_Set_Bits(number: int) -> int:\n    \"\"\"Return the number of set bits (1 bits) in the binary representation of 'number'.\n\n    Args:\n        number (int): Input integer whose set bits are to be counted.\n\n    Returns:\n        int: Count of bits equal to 1.\n    \"\"\"\n    return number.bit_count()"}
{"task_id": "Mbpp/172", "solution": "class InputString:\n    def __init__(self, value: str):\n        self.value = value\nclass OccurrenceResult:\n    def __init__(self, count: int):\n        self.count = count\nclass CountOccuranceFunction:\n    def __init__(self, pattern: str = \"std\"):\n        self.pattern = pattern\n\n    def count(self, input_obj: InputString) -> OccurrenceResult:\n        \"\"\"\n        Counts non-overlapping occurrences of the pattern in the input string.\n        Returns an OccurrenceResult containing the count.\n        \"\"\"\n        if not input_obj.value:\n            return OccurrenceResult(0)\n        \n        count_val = input_obj.value.count(self.pattern)\n        return OccurrenceResult(count_val)\ndef count_occurance(input_str: str) -> int:\n    \"\"\"\n    Counts the number of occurrences of the string 'std' in a given string.\n    The matching is case-sensitive and counts non-overlapping instances.\n    \"\"\"\n    input_obj = InputString(input_str)\n    counter = CountOccuranceFunction(pattern=\"std\")\n    result = counter.count(input_obj)\n    return result.count"}
{"task_id": "Mbpp/222", "solution": "def check_type(input_tuple: tuple) -> bool:\n    \"\"\"\n    Returns True if all elements in the tuple have the same runtime type; otherwise False.\n    Returns True for empty or single-element tuples.\n    \"\"\"\n    if len(input_tuple) <= 1:\n        return True\n\n    first_type = type(input_tuple[0])\n    for element in input_tuple[1:]:\n        if type(element) != first_type:\n            return False\n            \n    return True"}
{"task_id": "Mbpp/226", "solution": "def odd_values_string(input: str) -> str:\n    \"\"\"\n    Removes characters which have odd index values from a given string.\n    Returns a new string with characters from the original string at even indices.\n    \"\"\"\n    if not isinstance(input, str):\n        raise TypeError(\"input must be of type 'str'\")\n    return input[::2]"}
{"task_id": "Mbpp/223", "solution": "from typing import List\nclass Array:\n    \"\"\"Helper class to encapsulate array properties and validation.\"\"\"\n    def __init__(self, elements: List[int]):\n        self.elements = elements\n        self.length = len(elements)\n\n    def isSorted(self) -> bool:\n        \"\"\"Checks if the array is sorted in non-decreasing order.\"\"\"\n        if self.length <= 1:\n            return True\n        for i in range(self.length - 1):\n            if self.elements[i] > self.elements[i+1]:\n                return False\n        return True\nclass MajorityCheck:\n    \"\"\"Provides static methods for finding occurrences and checking majority.\"\"\"\n\n    @staticmethod\n    def findFirstOccurrence(arr: List[int], x: int) -> int:\n        \"\"\"Finds the index of the first occurrence of x using binary search.\"\"\"\n        low, high = 0, len(arr) - 1\n        result = -1\n        while low <= high:\n            mid = low + (high - low) // 2\n            if arr[mid] == x:\n                result = mid\n                high = mid - 1\n            elif arr[mid] < x:\n                low = mid + 1\n            else:\n                high = mid - 1\n        return result\n\n    @staticmethod\n    def findLastOccurrence(arr: List[int], x: int) -> int:\n        \"\"\"Finds the index of the last occurrence of x using binary search.\"\"\"\n        low, high = 0, len(arr) - 1\n        result = -1\n        while low <= high:\n            mid = low + (high - low) // 2\n            if arr[mid] == x:\n                result = mid\n                low = mid + 1\n            elif arr[mid] < x:\n                low = mid + 1\n            else:\n                high = mid - 1\n        return result\n\n    @staticmethod\n    def countOccurrences(arr: List[int], x: int) -> int:\n        \"\"\"Counts occurrences of x in the array.\"\"\"\n        first = MajorityCheck.findFirstOccurrence(arr, x)\n        if first == -1:\n            return 0\n        last = MajorityCheck.findLastOccurrence(arr, x)\n        return last - first + 1\n\n    @staticmethod\n    def is_majority(arr: List[int], n: int, x: int) -> bool:\n        \"\"\"Internal method to determine if x is the majority element after validation.\"\"\"\n        if arr is None or not isinstance(n, int) or n < 0 or n != len(arr):\n            return False\n        \n        if not Array(arr).isSorted():\n            return False\n\n        if n == 0:\n            return False\n\n        count = MajorityCheck.countOccurrences(arr, x)\n        return count > n / 2\ndef is_majority(arr: List[int], n: int, x: int) -> bool:\n    \"\"\"\n    Checks if an element x is the majority element in a sorted array.\n    The function delegates to internal helper methods for validation and computation.\n    \"\"\"\n    return MajorityCheck.is_majority(arr, n, x)"}
{"task_id": "Mbpp/227", "solution": "from typing import Union\ndef _is_numeric(value: any) -> bool:\n    \"\"\"Checks if a value is an integer or a float.\"\"\"\n    return isinstance(value, (int, float))\ndef min_of_three(a: Union[int, float], b: Union[int, float], c: Union[int, float]) -> Union[int, float]:\n    \"\"\"\n    Finds the minimum of three numeric arguments.\n    Raises TypeError if any argument is not numeric.\n    \"\"\"\n    if not _is_numeric(a) or not _is_numeric(b) or not _is_numeric(c):\n        raise TypeError(\"All arguments must be numeric (int or float)\")\n\n    return min(a, b, c)"}
