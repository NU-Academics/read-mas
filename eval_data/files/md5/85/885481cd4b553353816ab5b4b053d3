{"task_id": "Mbpp/284", "solution": "def check_element(input_list, element) -> bool:\n    \"\"\"\n    Returns True if every item in input_list equals element using host language equality (==);\n    returns False if any item differs.\n    \"\"\"\n    return all(item == element for item in input_list)"}
{"task_id": "Mbpp/283", "solution": "import collections\ndef validate(n: int) -> bool:\n    \"\"\"\n    Checks whether the frequency of each digit in the integer n is less than\n    or equal to the digit itself, ignoring the sign of n.\n    \"\"\"\n    s_n = str(abs(n))\n    digit_counts = collections.Counter(int(d) for d in s_n)\n\n    for digit, count in digit_counts.items():\n        if count > digit:\n            return False\n    return True"}
{"task_id": "Mbpp/287", "solution": "def square_Sum(n):\n    \"\"\"\n    Return the sum of squares of the first n even natural numbers.\n    The sum is calculated using the closed-form formula.\n    \"\"\"\n    # The sum of squares of the first n even natural numbers (2, 4, ..., 2n)\n    # is given by the formula S = (2 * n * (n + 1) * (2*n + 1)) / 3.\n    # The result of this formula for any integer n >= 0 will always be an integer.\n    sum_squares = (2 * n * (n + 1) * (2 * n + 1)) // 3\n    return sum_squares"}
{"task_id": "Mbpp/285", "solution": "from typing import Optional, List\nclass MatchResult:\n    \"\"\"Container for match outcome, including boolean matched status, optional matched substring, and match positions.\"\"\"\n    def __init__(self, matched: bool=False, matched_substring: Optional[str]=None, match_positions: Optional[List[int]]=None) -> None:\n        self.matched = matched\n        self.matched_substring = matched_substring\n        self.match_positions = match_positions if match_positions is not None else []\nclass InputString:\n    \"\"\"Lightweight wrapper for the input string, providing length, emptiness, and character access.\"\"\"\n    def __init__(self, value: str) -> None:\n        self._value = value\n\n    def length(self) -> int:\n        return len(self._value)\n\n    def is_empty(self) -> bool:\n        return self.length() == 0\n\n    def char_at(self, pos: int) -> str:\n        return self._value[pos]\nclass MatchPattern:\n    \"\"\"Base class for per-pattern matching behavior at a given position.\"\"\"\n    def __init__(self, pattern: str) -> None:\n        self._pattern = pattern\n\n    def is_match_at(self, pos: int, input_string: InputString) -> bool:\n        pattern_len = len(self._pattern)\n        if pos + pattern_len > input_string.length():\n            return False\n        \n        for i in range(pattern_len):\n            if input_string.char_at(pos + i) != self._pattern[i]:\n                return False\n        return True\nclass MatchPatternTwo(MatchPattern):\n    \"\"\"Concrete pattern \"abb\".\"\"\"\n    def __init__(self) -> None:\n        super().__init__(\"abb\")\nclass MatchPatternThree(MatchPattern):\n    \"\"\"Concrete pattern \"abbb\".\"\"\"\n    def __init__(self) -> None:\n        super().__init__(\"abbb\")\nclass TextMatcher:\n    \"\"\"Encapsulates matching logic for \"abb\" and \"abbb\", input validation, and produces MatchResult.\"\"\"\n    def __init__(self) -> None:\n        self._pattern_two: MatchPatternTwo = MatchPatternTwo()\n        self._pattern_three: MatchPatternThree = MatchPatternThree()\n\n    def text_match_two_three(self, input: str) -> bool:\n        \"\"\"Validates argument type, creates an InputString, and delegates to _search.\"\"\"\n        if not isinstance(input, str):\n            raise TypeError(\"Input must be a string.\")\n        \n        input_string = InputString(input)\n        if input_string.is_empty():\n            return False\n        \n        match_result = self._search(input_string)\n        return match_result.matched\n\n    def _search(self, input_string: InputString) -> MatchResult:\n        \"\"\"Performs a linear scan for 'abb' or 'abbb' patterns.\"\"\"\n        for pos in range(input_string.length()):\n            if self._pattern_two.is_match_at(pos, input_string):\n                return MatchResult(matched=True, matched_substring=\"abb\", match_positions=[pos])\n            if self._pattern_three.is_match_at(pos, input_string):\n                return MatchResult(matched=True, matched_substring=\"abbb\", match_positions=[pos])\n        return MatchResult()\ndef text_match_two_three(input: str) -> bool:\n    \"\"\"Public API (FR1). Validate input type and delegate to TextMatcher. Raises TypeError for non-string input per BR9 preference.\"\"\"\n    matcher = TextMatcher()\n    return matcher.text_match_two_three(input)"}
{"task_id": "Mbpp/290", "solution": "from typing import List, Any, Tuple\ndef max_length(list_of_lists: List[List[Any]]) -> Tuple[int, List[Any]]:\n    \"\"\"Finds the sublist with the maximum length in a list of lists and returns its length and the sublist.\"\"\"\n    max_len = -1\n    max_sublist = None\n    for sub in list_of_lists:\n        l = len(sub)\n        if l > max_len:\n            max_len = l\n            max_sublist = sub\n    return (max_len, max_sublist)"}
