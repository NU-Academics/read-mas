{"task_id": "Mbpp/244", "solution": "import math\nclass PerfectSquareCalculator:\n    \"\"\"\n    Encapsulates algorithm to compute next perfect square and square-check utility.\n    \"\"\"\n    def next_Perfect_Square(self, n: int) -> int:\n        \"\"\"\n        Computes the smallest perfect square strictly greater than n.\n        \"\"\"\n        floor_sqrt = math.isqrt(n)\n        return (floor_sqrt + 1) ** 2\n\n    def _is_square(self, n: int) -> bool:\n        \"\"\"\n        Checks if a given number is a perfect square.\n        \"\"\"\n        if n < 0:\n            return False\n        sqrt_n = math.isqrt(n)\n        return sqrt_n * sqrt_n == n\ndef next_Perfect_Square(n: int) -> int:\n    \"\"\"\n    Returns the smallest perfect square strictly greater than n.\n    Delegates computation to PerfectSquareCalculator.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"Input must be an integer.\")\n\n    calculator = PerfectSquareCalculator()\n    return calculator.next_Perfect_Square(n)"}
{"task_id": "Mbpp/245", "solution": "import collections\nfrom typing import List, Sequence, Union\nclass ArrayInput:\n    \"\"\"Value object for the input array.\"\"\"\n    def __init__(self, elements: List[Union[int, float]]):\n        self.elements = elements\n\n    def length(self) -> int:\n        \"\"\"Returns the number of elements in the array.\"\"\"\n        return len(self.elements)\nclass MaxSumCalculator:\n    \"\"\"Encapsulates algorithm to compute maximum-sum bitonic subsequence.\"\"\"\n\n    def computeLISsum(self, array_input: ArrayInput) -> List[Union[int, float]]:\n        \"\"\"\n        Computes the maximum sum of an increasing subsequence ending at each index.\n        Uses strict monotonicity.\n        \"\"\"\n        n = array_input.length()\n        if n == 0:\n            return []\n\n        lis_sum = [0] * n\n        for i in range(n):\n            lis_sum[i] = array_input.elements[i]\n            for j in range(i):\n                if array_input.elements[j] < array_input.elements[i]:\n                    lis_sum[i] = max(lis_sum[i], array_input.elements[i] + lis_sum[j])\n        return lis_sum\n\n    def computeLDSsum(self, array_input: ArrayInput) -> List[Union[int, float]]:\n        \"\"\"\n        Computes the maximum sum of a decreasing subsequence starting at each index.\n        Uses strict monotonicity.\n        \"\"\"\n        n = array_input.length()\n        if n == 0:\n            return []\n\n        lds_sum = [0] * n\n        for i in range(n - 1, -1, -1):\n            lds_sum[i] = array_input.elements[i]\n            for j in range(n - 1, i, -1):\n                if array_input.elements[j] < array_input.elements[i]:\n                    lds_sum[i] = max(lds_sum[i], array_input.elements[i] + lds_sum[j])\n        return lds_sum\n\n    def max_sum(self, array_input: ArrayInput) -> Union[int, float]:\n        \"\"\"\n        Computes the maximum sum of a bitonic subsequence for the given ArrayInput.\n        Combines LIS and LDS sums, subtracting the peak element to count it once.\n        \"\"\"\n        n = array_input.length()\n        if n == 0:\n            return 0\n\n        lis_sum = self.computeLISsum(array_input)\n        lds_sum = self.computeLDSsum(array_input)\n\n        max_bitonic_sum = float('-inf')\n\n        for i in range(n):\n            current_bitonic_sum = lis_sum[i] + lds_sum[i] - array_input.elements[i]\n            max_bitonic_sum = max(max_bitonic_sum, current_bitonic_sum)\n        \n        return max_bitonic_sum\ndef max_sum(array: Sequence[Union[int, float]]) -> Union[int, float]:\n    \"\"\"\n    Finds the maximum sum of a bitonic subsequence for the given array.\n    A sequence is bitonic if it is first strictly increasing and then strictly decreasing.\n    \"\"\"\n    if not array:\n        return 0\n\n    array_input = ArrayInput(list(array))\n    calculator = MaxSumCalculator()\n    return calculator.max_sum(array_input)"}
{"task_id": "Mbpp/247", "solution": "class LPSFunction:\n    \"\"\"\n    Implements the dynamic programming algorithm to compute the length\n    of the longest palindromic subsequence using the Longest Common Subsequence (LCS)\n    approach between the original string and its reverse.\n    \"\"\"\n    def lps(self, s: str) -> int:\n        n = len(s)\n        if n == 0:\n            return 0\n\n        # s1 is the original string, s2 is its reverse\n        s1 = s\n        s2 = s[::-1]\n\n        # dp[i][j] stores the length of the LCS of s1[:i] and s2[:j]\n        dp = [[0] * (n + 1) for _ in range(n + 1)]\n\n        for i in range(1, n + 1):\n            for j in range(1, n + 1):\n                if s1[i - 1] == s2[j - 1]:\n                    dp[i][j] = 1 + dp[i - 1][j - 1]\n                else:\n                    dp[i][j] = max(dp[i - 1][j], dp[i][j - 1])\n\n        return dp[n][n]\ndef lps(s: str) -> int:\n    \"\"\"\n    Calculates the length of the longest palindromic subsequence in the given string.\n    Delegates the computation to an internal LPSFunction instance.\n    \"\"\"\n    return LPSFunction().lps(s)"}
