{"task_id": "Mbpp/457", "solution": "def _first_min_by_length(sublists: list) -> list:\n    \"\"\"Return first-occurrence sublist with minimal length. Assumes sublists is non-empty and validated.\"\"\"\n    min_length = float('inf')\n    min_sublist = None\n\n    for sublist in sublists:\n        if len(sublist) < min_length:\n            min_length = len(sublist)\n            min_sublist = sublist\n    return min_sublist\ndef Find_Min(sublists: list) -> list:\n    \"\"\"Public API. Validate and return minimal-length sublist. Tie-breaker: first occurrence.\"\"\"\n    _validate_input(sublists)\n    if len(sublists) == 0:\n        raise ValueError(\"Input list must contain at least one sublist (behavior explicit in design).\")\n    return _first_min_by_length(sublists)"}
{"task_id": "Mbpp/458", "solution": "from typing import Union\nclass TypeValidationError(Exception):\n    \"\"\"Exception raised for validation failures based on type.\"\"\"\n    pass\nclass NumericValue:\n    \"\"\"Encapsulates a value and provides a method to check if it's numeric.\"\"\"\n    def __init__(self, value):\n        self._value = value\n\n    def isNumeric(self) -> bool:\n        \"\"\"Returns True if the encapsulated value is an integer or float, False otherwise.\"\"\"\n        return isinstance(self._value, (int, float))\n\n    def value(self) -> Union[int, float]:\n        \"\"\"Returns the encapsulated value.\"\"\"\n        return self._value\nclass Rectangle:\n    \"\"\"Represents a rectangle and provides a method to calculate its area.\"\"\"\n    def __init__(self, width: Union[int, float], height: Union[int, float]):\n        self._width = width\n        self._height = height\n\n    def getArea(self) -> Union[int, float]:\n        \"\"\"Calculates and returns the area of the rectangle.\"\"\"\n        return self._width * self._height\n\n    def width(self) -> Union[int, float]:\n        \"\"\"Returns the width of the rectangle.\"\"\"\n        return self._width\n\n    def height(self) -> Union[int, float]:\n        \"\"\"Returns the height of the rectangle.\"\"\"\n        return self._height\nclass RectangleAreaFunction:\n    \"\"\"Provides the core logic for validating inputs and calculating rectangle area.\"\"\"\n    @classmethod\n    def rectangle_area(cls, width: Union[int, float], height: Union[int, float]) -> Union[int, float]:\n        \"\"\"\n        Validates width and height, then computes the area of a rectangle.\n        Raises TypeValidationError if width or height are not numeric.\n        \"\"\"\n        if not NumericValue(width).isNumeric():\n            raise TypeValidationError(f\"Width must be a numeric value, got {type(width).__name__}.\")\n        if not NumericValue(height).isNumeric():\n            raise TypeValidationError(f\"Height must be a numeric value, got {type(height).__name__}.\")\n\n        rect = Rectangle(width, height)\n        return rect.getArea()\ndef rectangle_area(width: Union[int, float], height: Union[int, float]) -> Union[int, float]:\n    \"\"\"\n    Calculates the area of a rectangle, performing input validation.\n    Delegates to RectangleAreaFunction for core logic and validation.\n    \"\"\"\n    return RectangleAreaFunction.rectangle_area(width, height)"}
