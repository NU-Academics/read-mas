{"task_id": "Mbpp/462", "solution": "def combinations_list(input_list):\n    \"\"\"\n    Finds all possible combinations (subsets) of elements from a given list.\n    Combinations are ordered by bitmask ascending, and elements within each combination\n    are ordered from highest original index to lowest.\n    \"\"\"\n    n = len(input_list)\n    all_combinations = []\n\n    # Iterate through all possible masks from 0 to 2^n - 1\n    for mask in range(1 << n):\n        current_combination = []\n        # Build the current combination by checking bits from n-1 down to 0\n        for i in range(n - 1, -1, -1):\n            # If the i-th bit of the mask is set\n            if (mask >> i) & 1:\n                current_combination.append(input_list[i])\n        all_combinations.append(current_combination)\n\n    return all_combinations"}
{"task_id": "Mbpp/470", "solution": "from typing import Tuple\nclass TupleInput:\n    \"\"\"Encapsulates the provided input tuple.\"\"\"\n    def __init__(self, elements: Tuple[int]):\n        self.elements = elements\n\n    def length(self) -> int:\n        return len(self.elements)\nclass Validator:\n    \"\"\"Validates input type and element types.\"\"\"\n    def validate_type(self, input_data) -> bool:\n        if not isinstance(input_data, tuple):\n            raise TypeError(\"input must be a tuple\")\n        return True\n\n    def validate_elements(self, input_data) -> bool:\n        if any(not isinstance(x, int) for x in input_data):\n            raise ValueError(\"all elements must be int\")\n        return True\nclass PairwiseAdder:\n    \"\"\"Computes pairwise sums for a validated input tuple.\"\"\"\n    def add_pairwise(self, input_data: Tuple[int]) -> Tuple[int]:\n        n = len(input_data)\n        if n < 2:\n            return ()\n        sums = tuple(input_data[i] + input_data[i+1] for i in range(n - 1))\n        return sums\ndef add_pairwise(input_tuple: Tuple[int]) -> Tuple[int]:\n    \"\"\"\n    Finds the pairwise addition of neighboring elements of the given tuple.\n    Raises TypeError or ValueError for invalid input, returns an empty tuple for length < 2.\n    \"\"\"\n    ti = TupleInput(input_tuple)\n    v = Validator()\n    v.validate_type(ti.elements)\n    v.validate_elements(ti.elements)\n    adder = PairwiseAdder()\n    result = adder.add_pairwise(ti.elements)\n    return result"}
{"task_id": "Mbpp/472", "solution": "def check_Consecutive(list_of_integers):\n    \"\"\"\n    Return True if list_of_integers contains consecutive integers, otherwise False.\n    This function assumes the input list is sorted and contains only integers.\n    \"\"\"\n    n = len(list_of_integers)\n    if n <= 1:\n        return True  # An empty list or a list with one element is considered consecutive.\n\n    # Check if the list is sorted, as the problem implies checking consecutiveness\n    # in an existing sequence, not whether elements *can form* a consecutive sequence.\n    # The design context implies sorted input for consecutiveness check.\n    # Sorting is done to simplify the consecutiveness check itself, assuming\n    # the definition of \"consecutive\" refers to the sorted order of elements.\n    list_of_integers.sort()\n\n    for i in range(n - 1):\n        if list_of_integers[i+1] - list_of_integers[i] != 1:\n            return False\n    return True"}
{"task_id": "Mbpp/463", "solution": "from typing import List\ndef max_subarray_product(arr: List[int]) -> int:\n    \"\"\"\n    Finds the maximum product of any contiguous subarray within the given array.\n    This algorithm efficiently handles positive, negative, and zero values.\n    \"\"\"\n    if not arr:\n        # According to design, validateInput would raise ValueError for invalid inputs.\n        # But per instruction \"Do NOT add isinstance() checks or raise exceptions for edge cases\",\n        # returning 0 for an empty array is a common and non-exceptional behavior.\n        return 0\n\n    # Initialize result with the first element. This correctly handles single-element arrays\n    # and provides an initial maximum product for comparison.\n    result = arr[0]\n    # current_max tracks the maximum product of a subarray ending at the current position.\n    current_max = arr[0]\n    # current_min tracks the minimum product of a subarray ending at the current position.\n    # This is important for handling negative numbers: a small negative multiplied by a\n    # new negative can become a large positive.\n    current_min = arr[0]\n\n    # Iterate through the array starting from the second element\n    for i in range(1, len(arr)):\n        num = arr[i]\n\n        # If the current number is negative, it means multiplying with it will\n        # flip the signs. So, current_max will become current_min * num\n        # (which might be a large positive) and current_min will become\n        # current_max * num (which might be a large negative).\n        if num < 0:\n            current_max, current_min = current_min, current_max\n\n        # Update current_max and current_min based on the current number.\n        # The new max/min could either be the number itself (starting a new subarray)\n        # or the product of the number with the previous current_max/min (extending the subarray).\n        current_max = max(num, current_max * num)\n        current_min = min(num, current_min * num)\n\n        # Update the overall maximum product found so far.\n        result = max(result, current_max)\n\n    return result"}
{"task_id": "Mbpp/471", "solution": "def find_remainder(array: list[int], n: int) -> int:\n    \"\"\"\n    Compute product of `array` and return product % n as int.\n    Preconditions: array elements and n are integers per BR-06.\n    \"\"\"\n    product = 1\n    for element in array:\n        product *= element\n    return product % n"}
{"task_id": "Mbpp/468", "solution": "import math\nfrom typing import List, Union\ndef max_product(numbers: List[Union[int, float]]) -> Union[int, float]:\n    \"\"\"\n    Finds the maximum product formed by multiplying numbers of an increasing subsequence.\n    Uses dynamic programming to track the maximum product ending at each position.\n    \"\"\"\n    n = len(numbers)\n    if n == 0:\n        return 0\n\n    # dp[i] stores the maximum product of an increasing subsequence ending at index i.\n    # We use float to handle potential large products and ensure compatibility with float inputs.\n    dp = [0.0] * n \n    \n    # max_overall_product tracks the highest product found across all subsequences.\n    # Initialize with a value that can be overridden by any valid product (positive or negative).\n    max_overall_product = float('-inf')\n\n    for i in range(n):\n        # A single element `numbers[i]` is an increasing subsequence.\n        dp[i] = float(numbers[i])\n\n        # Update max_overall_product with the current single element product\n        max_overall_product = max(max_overall_product, dp[i])\n\n        # Check previous elements to extend increasing subsequences\n        for j in range(i):\n            if numbers[i] > numbers[j]:\n                # If numbers[i] extends an increasing subsequence ending at j,\n                # update dp[i] if a larger product is formed.\n                dp[i] = max(dp[i], dp[j] * numbers[i])\n        \n        # After considering all previous subsequences, update the overall maximum\n        max_overall_product = max(max_overall_product, dp[i])\n    \n    # If the largest product is an integer, return it as an int. Otherwise, return as float.\n    # This ensures consistency with the assert example's integer output.\n    if max_overall_product == int(max_overall_product):\n        return int(max_overall_product)\n    return max_overall_product"}
