{"task_id": "Mbpp/439", "solution": "from typing import List\nfrom dataclasses import dataclass\nclass ValidationError(Exception):\n    \"\"\"Exception type raised on validation failures.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\ndef _validate_input(input_list: object) -> InputList:\n    \"\"\"Ensures input is a list, non-empty, and contains only integers.\"\"\"\n    if not isinstance(input_list, list):\n        raise ValidationError(\"Input must be a list.\")\n    if not input_list:\n        raise ValidationError(\"Input list cannot be empty.\")\n    for element in input_list:\n        if not isinstance(element, int):\n            raise ValidationError(\"All elements in the list must be integers.\")\n    return InputList(elements=input_list, length=len(input_list))\ndef _concatenate(input_list_obj: InputList) -> OutputInteger:\n    \"\"\"Iterates IntegerElement(s), obtains decimal representations, appends strings, and produces OutputInteger.\"\"\"\n    string_parts = []\n    for element_value in input_list_obj.elements:\n        integer_element = IntegerElement(value=element_value)\n        string_parts.append(integer_element.decimal_representation())\n    \n    concatenated_string = \"\".join(string_parts)\n    return OutputInteger(value=int(concatenated_string))\ndef multiple_to_single(input_list: List[int]) -> int:\n    \"\"\"Validate input, concatenate decimal representations preserving digits, return int or raise ValidationError.\"\"\"\n    validated_input = _validate_input(input_list)\n    result_integer = _concatenate(validated_input)\n    return result_integer.value"}
{"task_id": "Mbpp/445", "solution": "def _is_numeric(value):\n    \"\"\"Checks if a value is an integer or float, excluding booleans.\"\"\"\n    return isinstance(value, (int, float)) and not isinstance(value, bool)\ndef _multiply_inner_tuples(inner_a, inner_b, index):\n    \"\"\"Performs element-wise multiplication on two inner tuples, validating numeric types.\"\"\"\n    products = []\n    for inner_idx, (val_a, val_b) in enumerate(zip(inner_a, inner_b)):\n        if not _is_numeric(val_a) or not _is_numeric(val_b):\n            raise TypeError(f\"Non-numeric element found at outer index {index}, inner index {inner_idx}.\")\n        products.append(val_a * val_b)\n    return tuple(products)\ndef index_multiplication(tupleA, tupleB):\n    \"\"\"Compute index-wise multiplication of elements in two tuple-of-tuples and return a tuple-of-tuples.\n\n    Raises:\n        ValueError: if outer or any inner tuple lengths differ.\n        TypeError: if any required multiplication operand is not numeric (int or float) or inputs are not tuples.\n    \"\"\"\n    _ensure_tuple(tupleA, \"tupleA\")\n    _ensure_tuple(tupleB, \"tupleB\")\n    _validate_outer_lengths(tupleA, tupleB)\n\n    result_outer_tuple = []\n    for outer_idx, (inner_a, inner_b) in enumerate(zip(tupleA, tupleB)):\n        _validate_inner_lengths(inner_a, inner_b, outer_idx)\n        \n        inner_result = _multiply_inner_tuples(inner_a, inner_b, outer_idx)\n        result_outer_tuple.append(inner_result)\n        \n    return tuple(result_outer_tuple)"}
{"task_id": "Mbpp/447", "solution": "def cube_nums(input_list):\n    \"\"\"Accepts a single argument named exactly 'input_list' and returns a list with element-wise cubes.\n    Raises TypeError if 'input_list' is not a list or any element is non-numeric.\n    \"\"\"\n    if not isinstance(input_list, list):\n        raise TypeError(\"Input must be a list.\")\n\n    cubed_numbers = []\n    for num in input_list:\n        if not isinstance(num, (int, float, complex)):\n            raise TypeError(\"All elements in the list must be numeric.\")\n        cubed_numbers.append(num ** 3)\n    return cubed_numbers"}
{"task_id": "Mbpp/440", "solution": "import string\nimport re\ndef find_adverb_position(sentence: str) -> (int, int, str):\n    \"\"\"\n    Finds the first adverb and its positions in a given sentence.\n    Returns (start_index, end_index, adverb_text) or (-1, -1, '') if not found.\n    \"\"\"\n    def _strip_punctuation(raw_token: str) -> (str, int, int):\n        # Strips leading and trailing punctuation from a token and calculates deltas.\n        leading_punc_match = re.match(r'^[' + re.escape(string.punctuation) + r']+', raw_token)\n        prefix_delta = leading_punc_match.end() if leading_punc_match else 0\n\n        trailing_punc_match = re.search(r'[' + re.escape(string.punctuation) + r']+$', raw_token)\n        suffix_delta = len(raw_token) - trailing_punc_match.start() if trailing_punc_match else 0\n\n        clean_token = raw_token[prefix_delta : len(raw_token) - suffix_delta]\n        return clean_token, prefix_delta, suffix_delta\n\n    def _is_adverb(clean_token: str) -> bool:\n        # Checks if a cleaned token is an adverb based on 'ly' suffix.\n        return clean_token.lower().endswith('ly')\n\n    tokens_with_offsets = []\n    for match in re.finditer(r'\\S+', sentence):\n        tokens_with_offsets.append({\n            'raw': match.group(0),\n            'raw_start': match.start(0)\n        })\n\n    for token_info in tokens_with_offsets:\n        raw_token = token_info['raw']\n        raw_start = token_info['raw_start']\n\n        clean_token, prefix_delta, _ = _strip_punctuation(raw_token)\n\n        if _is_adverb(clean_token):\n            start_index = raw_start + prefix_delta\n            end_index = start_index + len(clean_token)\n            return (start_index, end_index, clean_token)\n\n    return (-1, -1, '')"}
{"task_id": "Mbpp/446", "solution": "def count_Occurrence(source: tuple, targets: list) -> int:\n    \"\"\"Count occurrences in 'source' equal to any element in 'targets' using Python == semantics.\n    Returns 0 if the source tuple or targets list is empty.\"\"\"\n    if not source or not targets:\n        return 0\n\n    counter = 0\n    for elem in source:\n        if elem in targets:\n            counter += 1\n    return counter"}
{"task_id": "Mbpp/448", "solution": "class PerrinTerm:\n    def __init__(self, index: int, value: int) -> None:\n        self.index = index\n        self.value = value\n\n    def __repr__(self) -> str:\n        return f\"PerrinTerm(index={self.index}, value={self.value})\"\nclass InputParameter:\n    def __init__(self, n: int) -> None:\n        self.n = n\n\n    def is_valid(self) -> bool:\n        # Validates that 'n' is a non-negative integer as per design.\n        return isinstance(self.n, int) and self.n >= 0\nclass PerrinSequence:\n    def __init__(self) -> None:\n        self._terms = []\n\n    def generate(self, n: int) -> list:\n        # Generates Perrin terms up to index 'n' inclusive, storing them in a cache.\n        if n < 0:\n            return []\n\n        while len(self._terms) <= n:\n            k = len(self._terms)\n            if k == 0:\n                value = 3\n            elif k == 1:\n                value = 0\n            elif k == 2:\n                value = 2\n            else:\n                value = self._terms[k-2].value + self._terms[k-3].value\n            self._terms.append(PerrinTerm(k, value))\n        \n        return self._terms[:n+1]\n\n    def getTerm(self, i: int) -> PerrinTerm:\n        # Retrieves a Perrin term by index; assumes it has been generated.\n        if 0 <= i < len(self._terms):\n            return self._terms[i]\n        raise IndexError(\"Term not generated or index out of bounds\")\nclass PerrinCalculator:\n    def __init__(self, sequence: 'PerrinSequence' = None) -> None:\n        self._sequence = sequence if sequence is not None else PerrinSequence()\n\n    def cal_sum(self, n: int) -> int:\n        # Validates input 'n' and calculates the sum of Perrin numbers from P(0) to P(n).\n        param = InputParameter(n)\n        # Adhering to the constraint \"DO NOT add isinstance() checks or raise exceptions\",\n        # we assume 'n' is valid and skip the explicit error handling from the design.\n\n        if n == 0:\n            return 0\n\n        perrin_terms = self._sequence.generate(n)\n\n        current_sum = 0\n        for term in perrin_terms:\n            current_sum += term.value\n        \n        return current_sum\ndef cal_sum(n: int) -> int:\n    \"\"\"Calculates the sum of Perrin numbers from P(0) to P(n) inclusive.\"\"\"\n    calculator = PerrinCalculator()\n    return calculator.cal_sum(n)"}
