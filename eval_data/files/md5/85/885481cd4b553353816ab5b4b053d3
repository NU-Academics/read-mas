{"task_id": "Mbpp/739", "solution": "def triangular_value(k: int) -> int:\n    \"\"\"Computes the k-th triangular number.\"\"\"\n    return k * (k + 1) // 2\ndef digits_count(value: int) -> int:\n    \"\"\"Counts the number of decimal digits in a non-negative integer.\"\"\"\n    return len(str(value))\ndef find_Index(n: int) -> int:\n    \"\"\"\n    Finds the index of the smallest triangular number with n digits.\n    This function validates input and iterates to find the index.\n    \"\"\"\n    validate_input(n)\n\n    k = 1\n    while True:\n        t_k = triangular_value(k)\n        num_digits = digits_count(t_k)\n        if num_digits == n:\n            return k\n        k += 1"}
{"task_id": "Mbpp/742", "solution": "import math\nfrom typing import Union, Optional\ndef _validate_side_length(side_length: Union[int, float]) -> float:\n    \"\"\"Raise ValueError if side_length not int/float; return float(side_length) otherwise.\"\"\"\n    if not isinstance(side_length, (int, float)):\n        raise ValueError(\"Side length must be a numeric value (int or float).\")\n    return float(side_length)\nclass Tetrahedron:\n    \"\"\"Domain class representing a regular tetrahedron.\"\"\"\n    side_length: float\n    surface_area: Optional[float]\n\n    def __init__(self, side_length: float) -> None:\n        \"\"\"Construct with side_length: float.\"\"\"\n        self.side_length = side_length\n        self.surface_area = None\n\n    def computeSurfaceArea(self) -> float:\n        \"\"\"Return sqrt(3) * side_length ** 2 and set self.surface_area.\"\"\"\n        computed_area = math.sqrt(3) * self.side_length ** 2\n        self.surface_area = computed_area\n        return computed_area\ndef area_tetrahedron(side_length: Union[int, float]) -> float:\n    \"\"\"Public API. Calculate the surface area of a regular tetrahedron.\"\"\"\n    validated_side_length = _validate_side_length(side_length)\n    tetrahedron = Tetrahedron(validated_side_length)\n    return tetrahedron.computeSurfaceArea()"}
