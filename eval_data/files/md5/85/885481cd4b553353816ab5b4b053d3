{"task_id": "Mbpp/781", "solution": "import math\nclass DivisorCounter:\n    \"\"\"Helper class to compute the count of positive divisors for an integer.\"\"\"\n    def count_divisors(self, n: int) -> int:\n        \"\"\"\n        Computes the number of positive divisors for a given integer n.\n        Negative inputs are treated as their absolute value.\n        \"\"\"\n        n = abs(n)\n        count = 0\n        limit = math.isqrt(n)\n        for i in range(1, limit + 1):\n            if n % i == 0:\n                if i * i == n:\n                    count += 1\n                else:\n                    count += 2\n        return count\ndef count_divisors(n: int) -> bool:\n    \"\"\"\n    Checks whether the count of positive divisors for n is even.\n    Returns True if the count is even, False otherwise.\n    \"\"\"\n    dc = DivisorCounter()\n    divisor_count = dc.count_divisors(n)\n    return (divisor_count % 2) == 0"}
{"task_id": "Mbpp/782", "solution": "def odd_length_sum(input_list: list) -> int:\n    \"\"\"Calculates the sum of all contiguous subarrays with odd lengths.\"\"\"\n    n = len(input_list)\n    total_sum = 0\n\n    for start in range(n):\n        # Iterate through all possible odd lengths\n        # length starts from 1 and increments by 2 (1, 3, 5, ...)\n        # It must not exceed the remaining length of the list from the current start position\n        for length in range(1, n - start + 1, 2):\n            # Extract the subarray slice\n            # The end index is start + length\n            subarray = input_list[start : start + length]\n            # Add the sum of the current subarray to the total\n            total_sum += sum(subarray)\n\n    return total_sum"}
{"task_id": "Mbpp/777", "solution": "def find_sum(elements: list) -> int:\n    \"\"\"\n    Finds the sum of non-repeated elements in a given list.\n    This function uses frequency counting to identify unique elements and sum them.\n    \"\"\"\n    class FrequencyMap:\n        \"\"\"Manages element frequency counts.\"\"\"\n        def __init__(self):\n            self._map = {}\n\n        def build(self, elements_list: list) -> None:\n            \"\"\"Populates the map with element counts.\"\"\"\n            for element in elements_list:\n                self._map[element] = self._map.get(element, 0) + 1\n\n        def count(self, value) -> int:\n            \"\"\"Returns the occurrence count for a value.\"\"\"\n            return self._map.get(value, 0)\n\n        def items(self) -> list:\n            \"\"\"Returns a list of (value, count) pairs.\"\"\"\n            return list(self._map.items())\n\n    class Result:\n        \"\"\"Holds the computed integer sum.\"\"\"\n        def __init__(self, sum_value: int):\n            self.sum = sum_value\n\n    if not isinstance(elements, list):\n        raise TypeError(\"Input 'elements' must be a list.\")\n\n    freq_map = FrequencyMap()\n    freq_map.build(elements)\n\n    total_sum_value = 0\n    for value, count in freq_map.items():\n        if count == 1:\n            total_sum_value += value\n\n    result_obj = Result(total_sum_value)\n    return result_obj.sum"}
{"task_id": "Mbpp/780", "solution": "from .domain import InputList\ndef find_combinations(input: InputList) -> list[tuple[float, float]]:\n    \"\"\"\n    Finds combinations of element-wise sums from pairs of tuples in the input list.\n    Pairs are enumerated with i < j, preserving order.\n    \"\"\"\n    n = len(input)\n    if n < 2:\n        return []\n\n    results = []\n    for i in range(n - 1):\n        for j in range(i + 1, n):\n            t1 = input.get(i)\n            t2 = input.get(j)\n            sum_a = t1.a + t2.a\n            sum_b = t1.b + t2.b\n            results.append((sum_a, sum_b))\n\n    return results"}
{"task_id": "Mbpp/778", "solution": "import sys\nfrom typing import Any, List\ndef pack_consecutive_duplicates(input: list) -> list:\n    \"\"\"Return a new list of lists where each sublist contains consecutive equal elements from 'input'.\n    Behavior required by design: use == for comparisons, do not mutate 'input', return [] for empty input.\n    \"\"\"\n    if not input:\n        return []\n\n    result: List[List[Any]] = []\n    current_run: List[Any] = []\n\n    for element in input:\n        if not current_run or element == current_run[0]:\n            current_run.append(element)\n        else:\n            result.append(current_run)\n            current_run = [element]\n\n    if current_run:  # Append the last run if it exists\n        result.append(current_run)\n\n    return result"}
{"task_id": "Mbpp/784", "solution": "from typing import List, Iterator\nclass IntegerElement:\n    \"\"\"Wrapper for an integer with parity check methods.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\n    def is_even(self) -> bool:\n        \"\"\"Checks if the integer is even (0 is considered even).\"\"\"\n        return self.value % 2 == 0\n\n    def is_odd(self) -> bool:\n        \"\"\"Checks if the integer is odd.\"\"\"\n        return not self.is_even()\nclass IntegerList:\n    \"\"\"A container for an ordered list of IntegerElement instances.\"\"\"\n    def __init__(self, elements: List[IntegerElement]) -> None:\n        self.elements = elements\n\n    @staticmethod\n    def from_list(values: List[int]) -> 'IntegerList':\n        \"\"\"Constructs an IntegerList from a plain Python list of integers.\"\"\"\n        return IntegerList([IntegerElement(val) for val in values])\n\n    def __iter__(self) -> Iterator[IntegerElement]:\n        \"\"\"Iterates through the elements in left-to-right order.\"\"\"\n        return iter(self.elements)\n\n    def length(self) -> int:\n        \"\"\"Returns the number of elements in the list.\"\"\"\n        return len(self.elements)\nclass MulEvenOdd:\n    \"\"\"Processes an IntegerList to find the product of the first even and odd numbers.\"\"\"\n    def mul_even_odd(self, integer_list: IntegerList) -> int:\n        \"\"\"Scans the list to find the first odd and first even numbers, then returns their product.\"\"\"\n        first_even: int | None = None\n        first_odd: int | None = None\n\n        for element in integer_list:\n            if first_even is None and element.is_even():\n                first_even = element.value\n            if first_odd is None and element.is_odd():\n                first_odd = element.value\n\n            if first_even is not None and first_odd is not None:\n                break\n        \n        # According to the problem description, such numbers will always be found or\n        # default to handling per product logic (e.g., if one isn't found, product with None isn't defined\n        # but problem example suggests lists will contain both)\n        # If no numbers are found, or only one type, the behavior isn't explicitly defined for edge cases\n        # but for given tests, both will be found.\n        if first_even is None or first_odd is None:\n            # For the given problem context, it's assumed both will be found.\n            # If not, a specific default or error handling would be required.\n            # Given the problem's implicit constraints, this path should not be reached by valid inputs.\n            return 0 # Default to 0 product if one is missing, based on typical multiplication behavior with missing factors.\n                     # The example test suggests valid inputs will always have both.\n\n        return first_even * first_odd\ndef mul_even_odd(list_of_integers: List[int]) -> int:\n    \"\"\"\n    Finds the product of the first even and first odd number in a given list.\n    Scans the list left-to-right, treating 0 as an even number.\n    \"\"\"\n    integer_list = IntegerList.from_list(list_of_integers)\n    processor = MulEvenOdd()\n    return processor.mul_even_odd(integer_list)"}
