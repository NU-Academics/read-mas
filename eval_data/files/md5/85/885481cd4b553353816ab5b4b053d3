{"task_id": "Mbpp/92", "solution": "from typing import List, Set\nclass Number:\n    \"\"\"Holds an integer value and provides its decimal digits.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def get_digits(self) -> List[int]:\n        if self.value == 0:\n            return [0]\n        return [int(d) for d in str(self.value)]\nclass DigitSequence:\n    \"\"\"Represents a sequence of decimal digits and provides derived attributes.\"\"\"\n    def __init__(self, digits: List[int]):\n        self.digits = digits\n        self.length = len(digits)\n\n    def distinct_digits(self) -> Set[int]:\n        return set(self.digits)\nclass UndulatingChecker:\n    \"\"\"Encapsulates logic to evaluate whether a number's digit sequence is undulating.\"\"\"\n    def is_undulating(self, n: int) -> bool:\n        if n < 0:\n            n = abs(n)\n        \n        digits = self.extract_digits(n)\n        return self.check_alternation(digits)\n\n    def extract_digits(self, n: int) -> List[int]:\n        \"\"\"Extracts decimal digits from an integer.\"\"\"\n        number = Number(n)\n        return number.get_digits()\n\n    def check_alternation(self, digits: List[int]) -> bool:\n        \"\"\"Checks if a digit sequence alternates between two distinct digits.\"\"\"\n        seq = DigitSequence(digits)\n\n        if seq.length < 3:\n            return False\n\n        # The first two digits must be distinct to establish an 'a,b' pattern.\n        d0 = digits[0]\n        d1 = digits[1]\n        if d0 == d1:\n            return False\n\n        # There must be exactly two distinct digits in the entire sequence.\n        distinct = seq.distinct_digits()\n        if len(distinct) != 2:\n            return False\n\n        # Verify the alternating pattern for the rest of the digits.\n        for i in range(2, seq.length):\n            if i % 2 == 0:  # Even index should match the first digit (d0)\n                if digits[i] != d0:\n                    return False\n            else:  # Odd index should match the second digit (d1)\n                if digits[i] != d1:\n                    return False\n        \n        return True\ndef is_undulating(n: int) -> bool:\n    \"\"\"\n    Checks whether the given number is undulating.\n    An undulating number alternates between two distinct digits for its entire length.\n    \"\"\"\n    checker = UndulatingChecker()\n    return checker.is_undulating(n)"}
{"task_id": "Mbpp/94", "solution": "import collections.abc\ndef index_minimum(items: list) -> object:\n    \"\"\"\n    Given a list of tuples, returns the first value of the tuple with the smallest second value.\n    Raises ValueError for empty input or malformed tuples, TypeError for non-comparable second elements.\n    \"\"\"\n    if not items:\n        raise ValueError(\"Input list cannot be empty.\")\n\n    # Initialize with the first item, validating its structure\n    first_item = items[0]\n    if not (isinstance(first_item, collections.abc.Sequence) and len(first_item) == 2):\n        raise ValueError(f\"Item at index 0 is not a 2-element sequence: {first_item}\")\n    \n    min_first = first_item[0]\n    min_second = first_item[1]\n\n    # Iterate through the rest of the items, starting from the second element\n    for i in range(1, len(items)):\n        item = items[i]\n        \n        # Validate item structure for subsequent items\n        if not (isinstance(item, collections.abc.Sequence) and len(item) == 2):\n            raise ValueError(f\"Item at index {i} is not a 2-element sequence: {item}\")\n        \n        current_first = item[0]\n        current_second = item[1]\n\n        # Compare second elements; TypeError will propagate naturally if values are not comparable.\n        if current_second < min_second:\n            min_second = current_second\n            min_first = current_first\n            \n    return min_first"}
{"task_id": "Mbpp/96", "solution": "def validateInput(n):\n    \"\"\"Validate that n is an int; if not raise TypeError. For n <= 0 normalize by abs(n). Return normalized int.\"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"Input must be an integer.\")\n    return abs(n)\ndef countDivisors(n: int) -> int:\n    \"\"\"Count positive divisors of non-negative integer n and return count as int. For n == 0 returns 0 by convention.\"\"\"\n    if n == 0:\n        return 0\n    \n    count = 0\n    i = 1\n    while i * i <= n:\n        if n % i == 0:\n            if i * i == n:\n                count += 1\n            else:\n                count += 2\n        i += 1\n    return count\ndef divisor(n: int) -> int:\n    \"\"\"Public API: validate input and return number of positive divisors as int.\"\"\"\n    normalized_n = validateInput(n)\n    return countDivisors(normalized_n)"}
{"task_id": "Mbpp/97", "solution": "from typing import Any, Iterable, List, Dict\nclass Counter:\n    \"\"\"A utility class to count frequencies of elements.\"\"\"\n    def __init__(self) -> None:\n        self._counts: Dict[Any, int] = {}\n\n    def increment(self, element: Any) -> None:\n        \"\"\"Increments the count for an element.\"\"\"\n        self._counts[element] = self._counts.get(element, 0) + 1\n\n    def to_dict(self) -> Dict[Any, int]:\n        \"\"\"Returns a copy of the internal counts dictionary.\"\"\"\n        return self._counts.copy()\ndef frequency_lists(list_of_lists: List[List[Any]]) -> Dict[Any, int]:\n    \"\"\"\n    Finds the frequency of each element in a flattened list of lists.\n    Elements must be hashable; unhashable elements will raise TypeError.\n    \"\"\"\n    counter = Counter()\n    for element in _flatten(list_of_lists):\n        counter.increment(element)\n    return counter.to_dict()"}
{"task_id": "Mbpp/100", "solution": "class PalindromeFinder:\n    \"\"\"Encapsulates the algorithm that computes the next smallest palindrome strictly greater than a given integer.\"\"\"\n    def next_smallest_palindrome(self, n: int) -> int:\n        \"\"\"Compute and return smallest palindrome strictly greater than n.\"\"\"\n        current_num = n + 1\n        while True:\n            s = str(current_num)\n            if s == s[::-1]:\n                return current_num\n            current_num += 1\ndef next_smallest_palindrome(n):\n    \"\"\"Public API. Delegates to PalindromeFinder and returns int.\"\"\"\n    finder = PalindromeFinder()\n    return finder.next_smallest_palindrome(n)"}
{"task_id": "Mbpp/99", "solution": "def decimal_to_binary(n: int) -> str:\n    \"\"\"\n    Converts a non-negative decimal integer to its binary equivalent as a string.\n    Returns \"0\" for input 0 and a binary string with no leading zeros for positive integers.\n    \"\"\"\n    if n == 0:\n        return \"0\"\n\n    binary_digits = []\n    while n > 0:\n        binary_digits.append(str(n % 2))\n        n //= 2\n    \n    return \"\".join(binary_digits[::-1])"}
{"task_id": "Mbpp/98", "solution": "import math\nfrom dataclasses import dataclass\nfrom typing import Sequence, Union\nclass InputSequence:\n    \"\"\"\n    Encapsulates the input container and provides length/is_empty inspection and basic validation.\n    \"\"\"\n    def __init__(self, numbers: Sequence) -> None:\n        if not isinstance(numbers, (list, tuple)):\n            raise ValueError(\"Input must be a list or a tuple.\")\n        self.numbers: Sequence[Union[int, float]] = numbers\n\n    def length(self) -> int:\n        return len(self.numbers)\n\n    def is_empty(self) -> bool:\n        return self.length() == 0\nclass Number:\n    \"\"\"\n    Lightweight wrapper for a numeric element, storing its value as a float.\n    Provides checks for integer or float nature of the original value.\n    \"\"\"\n    def __init__(self, value) -> None:\n        if not isinstance(value, (int, float)):\n            raise ValueError(f\"Element '{value}' must be an integer or a float.\")\n        self.value: float = float(value)\n\n    def is_integer(self) -> bool:\n        return self.value.is_integer()\n\n    def is_float(self) -> bool:\n        return not self.value.is_integer() # True if it's a float that is not an integer\ndef multiply_num(sequence: Sequence[Union[int, float]]) -> float:\n    \"\"\"\n    Multiplies all numbers in a list or tuple and divides the product by the sequence's length.\n\n    Args:\n        sequence: A list or tuple containing integer and/or floating-point numeric values.\n\n    Returns:\n        The product of all elements divided by the sequence length, as a float.\n\n    Raises:\n        ValueError: If the input is not a list/tuple, contains non-numeric elements,\n                    or has a length of zero.\n    \"\"\"\n    input_seq = InputSequence(sequence)\n\n    if input_seq.is_empty():\n        raise ValueError(\"Sequence cannot be empty.\")\n\n    current_product: float = 1.0\n    for item in input_seq.numbers:\n        num_obj = Number(item) # This validates each element's type\n        current_product *= num_obj.value\n\n    final_result: float = current_product / input_seq.length()\n\n    # Store results in the dataclass as per design\n    product_result = ProductResult(product=current_product, result=final_result)\n\n    return product_result.result"}
{"task_id": "Mbpp/111", "solution": "from typing import List, Any, Collection\ndef common_in_nested_lists(nestedLists: List[List[Any]]) -> Collection[Any]:\n    \"\"\"Compute elements common to every inner list.\n\n    Args:\n        nestedLists: A list whose elements are lists of values.\n\n    Returns:\n        A collection containing elements present in every inner list.\n    \"\"\"\n    if not nestedLists:\n        return set()\n\n    common_elements = set(nestedLists[0])\n\n    for i in range(1, len(nestedLists)):\n        current_list_set = set(nestedLists[i])\n        common_elements = common_elements.intersection(current_list_set)\n        if not common_elements:  # Optimization: if no common elements found, further intersections will also be empty.\n            break\n\n    return common_elements"}
{"task_id": "Mbpp/102", "solution": "class InputString:\n    \"\"\"Data holder for raw input string.\"\"\"\n    def __init__(self, value: str) -> None:\n        self.value = value\nclass Word:\n    \"\"\"Represents a token and provides capitalization operation.\"\"\"\n    def __init__(self, text: str) -> None:\n        self.text = text\n\n    def capitalize(self) -> str:\n        \"\"\"Returns the token with its first character uppercased.\"\"\"\n        if not self.text:\n            return \"\"\n        return self.text[0].upper() + self.text[1:]\nclass WordTokenizer:\n    \"\"\"Tokenizes an input string into Word instances by splitting on underscores.\"\"\"\n    def tokenize(self, s: str) -> list[Word]:\n        \"\"\"Splits the input string by underscores and creates Word objects.\"\"\"\n        if not s:\n            return []\n        tokens = s.split('_')\n        return [Word(token) for token in tokens]\nclass OutputString:\n    \"\"\"Data holder for the resulting CamelCase string.\"\"\"\n    def __init__(self, value: str) -> None:\n        self.value = value\nclass SnakeToCamelService:\n    \"\"\"Orchestrates the conversion from snake_case to CamelCase.\"\"\"\n    def __init__(self, tokenizer: 'WordTokenizer') -> None:\n        self._tokenizer = tokenizer\n\n    def snake_to_camel(self, input_str_value: str) -> str:\n        \"\"\"Converts a snake_case string to CamelCase.\"\"\"\n        input_string = InputString(input_str_value)\n        words = self._tokenizer.tokenize(input_string.value)\n        \n        capitalized_words = [word.capitalize() for word in words]\n        \n        result_value = \"\".join(capitalized_words)\n        output_string = OutputString(result_value)\n        return output_string.value\ndef snake_to_camel(input: str) -> str:\n    \"\"\"Converts a snake case string to camel case string.\"\"\"\n    tokenizer = WordTokenizer()\n    service = SnakeToCamelService(tokenizer)\n    return service.snake_to_camel(input)"}
{"task_id": "Mbpp/108", "solution": "from typing import List\ndef _collect_elements(*lists: List[int]) -> List[int]:\n    \"\"\"Collects all elements from multiple lists into a new single list.\"\"\"\n    combined_list = []\n    for lst in lists:\n        combined_list.extend(lst)\n    return combined_list\ndef _sort_list(lst: List[int]) -> List[int]:\n    \"\"\"Returns a new list containing elements of the input list sorted non-decreasingly.\"\"\"\n    return sorted(lst)\ndef merge_sorted_list(a: List[int], b: List[int], c: List[int]) -> List[int]:\n    \"\"\"Merges three lists into a single sorted list, preserving duplicates and not mutating inputs.\"\"\"\n    combined_elements = _collect_elements(a, b, c)\n    sorted_elements = _sort_list(combined_elements)\n    return sorted_elements"}
{"task_id": "Mbpp/104", "solution": "from typing import List, Sequence\ndef _sort_sublist(sublist):\n    \"\"\"Return a new list of strings sorted in ascending lexicographic order using Python's default comparison.\"\"\"\n    return sorted(list(sublist))\ndef sort_sublists(sequence):\n    \"\"\"Accepts a sequence of sublists of strings and returns a list of lists with each sublist sorted.\"\"\"\n    _validate_input(sequence)\n\n    sorted_outer_list = []\n    for sublist in sequence:\n        sorted_inner_list = _sort_sublist(sublist)\n        sorted_outer_list.append(sorted_inner_list)\n    \n    return sorted_outer_list"}
