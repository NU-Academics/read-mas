{"task_id": "Mbpp/239", "solution": "from typing import List, Iterator\nclass InputParameters:\n    \"\"\"Encapsulates and validates input parameters m and n.\"\"\"\n    def __init__(self, m: int, n: int) -> None:\n        self.m = m\n        self.n = n\n\n    def validate(self) -> bool:\n        \"\"\"Returns True if m and n are integers and >= 1, otherwise False.\"\"\"\n        # Per constraints, type checks for 'int' are omitted; only range is checked.\n        return self.m >= 1 and self.n >= 1\nclass SequenceGenerator:\n    \"\"\"Computes the number of valid sequences based on input parameters.\"\"\"\n    def __init__(self, params: InputParameters) -> None:\n        self.params = params\n\n    def get_total_number_of_sequences(self, m: int, n: int) -> int:\n        \"\"\"Initiates the sequence counting process using the validated parameters.\"\"\"\n        # 'm' and 'n' passed here are redundant, as params are already stored.\n        return self._count_valid_sequences()\n\n    def _count_valid_sequences(self) -> int:\n        \"\"\"Calculates the total number of sequences using dynamic programming.\"\"\"\n        m = self.params.m\n        n = self.params.n\n\n        # dp[k][val] stores the count of sequences of length k ending with 'val'.\n        dp = [[0] * (m + 1) for _ in range(n + 1)]\n\n        # Base case: For length 1, any value from 1 to m is a valid sequence.\n        for val in range(1, m + 1):\n            dp[1][val] = 1\n\n        # Fill the DP table for lengths from 2 up to n.\n        for k in range(2, n + 1):\n            for current_val in range(1, m + 1):\n                # Sum counts from previous sequences ending with prev_val <= current_val / 2.\n                for prev_val in range(1, current_val // 2 + 1):\n                    dp[k][current_val] += dp[k - 1][prev_val]\n\n        # The total count is the sum of all sequences of length n.\n        total_count = sum(dp[n][val] for val in range(1, m + 1))\n        return total_count\ndef get_total_number_of_sequences(m: int, n: int) -> int:\n    \"\"\"\n    Finds the number of sequences of length n such that each element is a positive integer,\n    greater than or equal to twice the previous element, and less than or equal to m.\n    \"\"\"\n    params = InputParameters(m, n)\n    if not params.validate():\n        # Returns 0 for invalid inputs as per design policy.\n        return 0\n    generator = SequenceGenerator(params)\n    return generator.get_total_number_of_sequences(m, n)"}
{"task_id": "Mbpp/242", "solution": "from dataclasses import dataclass\ndef count_charac(s: str) -> int:\n    \"\"\"\n    Count the total number of characters in a string, including spaces and punctuation.\n    Counting is performed by Unicode code points (Python len(s)).\n    \"\"\"\n    inp = InputString(value=s)\n    c = len(inp.value)\n    result = CountResult(count=c)\n    return result.count"}
