{"task_id": "Mbpp/567", "solution": "def is_ascending(input_list) -> bool:\n    \"\"\"Return True if input_list is sorted ascending according to <= between adjacent elements.\"\"\"\n    n = len(input_list)\n    if n <= 1:\n        return True\n    for i in range(n - 1):\n        try:\n            if input_list[i] > input_list[i + 1]:\n                return False\n        except Exception as e:\n            raise TypeError(\"Elements are not comparable during iteration\") from e\n    return True\ndef issort_list(input_list) -> bool:\n    \"\"\"Check whether the provided list is sorted in ascending order.\n    Raises TypeError if input_list is not a list or elements are not comparable.\n    \"\"\"\n    validate_input(input_list)\n    return is_ascending(input_list)"}
{"task_id": "Mbpp/569", "solution": "def _sort_sublist(sublist):\n    \"\"\"Return a new list with elements of sublist sorted lexicographically using runtime default string comparison.\"\"\"\n    return sorted(sublist)\ndef sort_sublists(list_of_lists):\n    \"\"\"Public API.\n    Parameters:\n      - list_of_lists: a list (outer) whose elements are lists of strings.\n    Returns:\n      - A new list of lists of strings where each inner list is sorted ascending lexicographically.\n    Raises:\n      - TypeError: if input is not a list of lists of strings.\n    \"\"\"\n    _validate_input(list_of_lists)\n    \n    sorted_outer_list = []\n    for sublist in list_of_lists:\n        sorted_sub = _sort_sublist(sublist)\n        sorted_outer_list.append(sorted_sub)\n        \n    return sorted_outer_list"}
{"task_id": "Mbpp/564", "solution": "from typing import List, Dict\ndef count_Pairs(list_of_integers: list[int], n: int) -> int:\n    \"\"\"\n    Counts the number of unordered pairs of unequal elements\n    among the first 'n' elements of the input list.\n    \"\"\"\n    def combinations_2(k: int) -> int:\n        \"\"\"Calculates nC2 (combinations of k items taken 2 at a time).\"\"\"\n        if k < 2:\n            return 0\n        return k * (k - 1) // 2\n\n    # Normalize n: negative n is treated as 0.\n    n = max(0, n)\n\n    # Determine the effective number of elements to consider.\n    effective_n = min(n, len(list_of_integers))\n\n    # If 0 or 1 element, no pairs can be formed.\n    if effective_n <= 1:\n        return 0\n\n    # Select the first effective_n elements.\n    selected_values = list_of_integers[0:effective_n]\n\n    # Build a frequency map for the selected values.\n    freq_map: dict[int, int] = {}\n    for value in selected_values:\n        freq_map[value] = freq_map.get(value, 0) + 1\n\n    # Calculate total possible pairs among effective_n elements.\n    total_pairs = combinations_2(effective_n)\n\n    # Calculate pairs where both elements have the same value.\n    equal_value_pairs = 0\n    for count in freq_map.values():\n        equal_value_pairs += combinations_2(count)\n\n    # The result is total pairs minus pairs with equal values.\n    return total_pairs - equal_value_pairs"}
{"task_id": "Mbpp/572", "solution": "from typing import List, Dict\ndef compute_frequencies(input_list: List[int]) -> Dict[int, int]:\n    \"\"\"Calculates the frequency of each number in the input list.\"\"\"\n    freq_map: Dict[int, int] = {}\n    for num in input_list:\n        freq_map[num] = freq_map.get(num, 0) + 1\n    return freq_map\ndef filter_unique(input_list: List[int], freq_map: Dict[int, int]) -> List[int]:\n    \"\"\"Filters the input list, keeping only numbers that appear exactly once based on the frequency map, preserving order.\"\"\"\n    unique_nums: List[int] = []\n    for num in input_list:\n        if freq_map[num] == 1:\n            unique_nums.append(num)\n    return unique_nums\ndef two_unique_nums(input_list: List[int]) -> List[int]:\n    \"\"\"\n    Removes duplicate numbers from a given list, returning only those that appear exactly once.\n    The order of the unique numbers is preserved from the original input list.\n    \"\"\"\n    freq_map = compute_frequencies(input_list)\n    result = filter_unique(input_list, freq_map)\n    return result"}
{"task_id": "Mbpp/573", "solution": "from numbers import Number\nfrom typing import List\ndef unique_product(numbers: List[Number]) -> Number:\n    \"\"\"Return the product of distinct numeric values in 'numbers'.\n    Returns 1 for an empty input list.\n    \"\"\"\n    unique_values = set(numbers)\n    product = 1\n    for num in unique_values:\n        product *= num\n    return product"}
{"task_id": "Mbpp/577", "solution": "def last_Digit_Factorial(n: int) -> int:\n    \"\"\"Return the last decimal digit (0..9) of n!.\n    Preconditions: n is an integer (behavior for negative or non-integer inputs unspecified).\n    \"\"\"\n    if n == 0:\n        return 1\n    if n >= 10:\n        # For n >= 10, factorials always end in 0 (e.g., 10! includes factors 2 and 5).\n        return 0\n\n    # Calculate the last digit for n from 1 to 9\n    factorial_last_digit = 1\n    for i in range(1, n + 1):\n        factorial_last_digit = (factorial_last_digit * i) % 10\n    return factorial_last_digit"}
{"task_id": "Mbpp/576", "solution": "def is_Sub_Array(haystack: list, needle: list) -> bool:\n    \"\"\"\n    Determine whether 'needle' is a contiguous sublist of 'haystack'.\n    Returns True iff needle occurs as a contiguous subsequence in haystack.\n    \"\"\"\n    if len(needle) > len(haystack):\n        return False\n\n    if not needle:  # An empty list is a sublist of any list\n        return True\n\n    for i in range(len(haystack) - len(needle) + 1):\n        match = True\n        for j in range(len(needle)):\n            if haystack[i + j] != needle[j]:\n                match = False\n                break\n        if match:\n            return True\n\n    return False"}
{"task_id": "Mbpp/579", "solution": "def find_dissimilar(t1, t2):\n    \"\"\"\n    Finds elements that are present in exactly one of the two input tuples, preserving order and uniqueness.\n    \"\"\"\n    set1 = set(t1)\n    set2 = set(t2)\n    result = []\n    seen = set()\n\n    for item in t1:\n        if item not in set2 and item not in seen:\n            result.append(item)\n            seen.add(item)\n\n    for item in t2:\n        if item not in set1 and item not in seen:\n            result.append(item)\n            seen.add(item)\n\n    return tuple(result)"}
{"task_id": "Mbpp/581", "solution": "from math import sqrt\nclass Pyramid:\n    \"\"\"A class to encapsulate square pyramid dimensions and calculations.\"\"\"\n    def __init__(self, a, h):\n        self.a = a\n        self.h = h\n\n    def compute_slant_height(self) -> float:\n        \"\"\"Computes the slant height of the pyramid using its base edge and height.\"\"\"\n        return sqrt((self.a / 2)**2 + self.h**2)\n\n    def compute_surface_area(self) -> float:\n        \"\"\"Computes the total surface area of the pyramid.\"\"\"\n        s = self.compute_slant_height()\n        return self.a**2 + 2 * self.a * s\ndef surface_Area(a, h):\n    \"\"\"\n    Calculates the total surface area of a square pyramid given its base edge and height.\n    \"\"\"\n    pyramid = Pyramid(a, h)\n    area = pyramid.compute_surface_area()\n    return area"}
{"task_id": "Mbpp/578", "solution": "class InvalidInputError(Exception):\n    \"\"\"Domain-specific exception for invalid inputs (type or length).\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\nclass InterleavedList:\n    \"\"\"Wrapper for output elements.\"\"\"\n    def __init__(self, elements: list):\n        self.elements = elements\n\n    def length(self) -> int:\n        return len(self.elements)\nclass Validator:\n    \"\"\"Validates input types and lengths.\"\"\"\n    @staticmethod\n    def validate_types(listA, listB, listC) -> None:\n        \"\"\"Raises InvalidInputError if any input is not a list.\"\"\"\n        if not isinstance(listA, list):\n            raise InvalidInputError(\"Invalid input type for listA: must be a list.\")\n        if not isinstance(listB, list):\n            raise InvalidInputError(\"Invalid input type for listB: must be a list.\")\n        if not isinstance(listC, list):\n            raise InvalidInputError(\"Invalid input type for listC: must be a list.\")\n\n    @staticmethod\n    def validate_lengths(listA, listB, listC) -> int:\n        \"\"\"Returns n if lengths equal, else raises InvalidInputError.\"\"\"\n        lenA = len(listA)\n        lenB = len(listB)\n        lenC = len(listC)\n        if not (lenA == lenB and lenB == lenC):\n            raise InvalidInputError(\"Input lists have unequal lengths.\")\n        return lenA\nclass Interleaver:\n    \"\"\"Performs the interleaving algorithm and produces the result.\"\"\"\n    def __init__(self, listA, listB, listC):\n        self._listA = listA\n        self._listB = listB\n        self._listC = listC\n        self._result = InterleavedList([])\n\n    def interleave_lists(self) -> None:\n        \"\"\"Executes the algorithm, populating the internal result.\"\"\"\n        n = len(self._listA)\n        interleaved_elements = []\n        for i in range(n):\n            interleaved_elements.append(self._listA[i])\n            interleaved_elements.append(self._listB[i])\n            interleaved_elements.append(self._listC[i])\n        self._result = InterleavedList(interleaved_elements)\n\n    def get_result(self) -> list:\n        \"\"\"Returns the interleaved flat list.\"\"\"\n        return self._result.elements\ndef interleave_lists(listA, listB, listC) -> list:\n    \"\"\"\n    Interleaves 3 lists of the same length into a single flat list.\n    Raises InvalidInputError for invalid input types or unequal lengths.\n    \"\"\"\n    Validator.validate_types(listA, listB, listC)\n    Validator.validate_lengths(listA, listB, listC)\n\n    interleaver_instance = Interleaver(listA, listB, listC)\n    interleaver_instance.interleave_lists()\n    return interleaver_instance.get_result()"}
{"task_id": "Mbpp/580", "solution": "def _extract_even_recursive(t: tuple) -> tuple:\n    \"\"\"Module-private recursive helper. Returns a new tuple filtered to keep only even ints and processed nested tuple results.\"\"\"\n    result = []\n    for item in t:\n        if isinstance(item, int):\n            if item % 2 == 0:\n                result.append(item)\n        elif isinstance(item, tuple):\n            processed_nested = _extract_even_recursive(item)\n            # The design states \"Return empty tuples for nested tuples that contain no even integers\" (BR6).\n            # So we always append the processed_nested tuple, even if it's empty.\n            result.append(processed_nested)\n    return tuple(result)\ndef extract_even(input_tuple: tuple) -> tuple:\n    \"\"\"Public API per SRS FR1.\n\n    Preconditions: input_tuple is a tuple containing integers and/or nested tuples (per SRS scope).\n    Returns: new tuple with only even integers at each level (BR3), nested structure preserved (BR4),\n    empty tuples returned where nested results produce no even integers (BR6).\n    \"\"\"\n    return _extract_even_recursive(input_tuple)"}
{"task_id": "Mbpp/583", "solution": "import collections\nclass Validation:\n    \"\"\"\n    Utility for input validation.\n    \"\"\"\n    @staticmethod\n    def is_non_negative_integer(n: object) -> bool:\n        \"\"\"\n        Checks if n is a non-negative integer.\n        \"\"\"\n        return isinstance(n, int) and n >= 0\nclass CatalanNumberCalculator:\n    \"\"\"\n    Computes nth Catalan number using dynamic programming with memoization.\n    \"\"\"\n    def __init__(self):\n        self._memo: dict[int, int] = {0: 1} # C0 = 1\n\n    def catalan_number(self, n: int) -> int:\n        \"\"\"\n        Public method to get the nth Catalan number from the calculator.\n        \"\"\"\n        return self._compute_dp(n)\n\n    def _compute_dp(self, n: int) -> int:\n        \"\"\"\n        Computes the nth Catalan number using dynamic programming.\n        \"\"\"\n        if n in self._memo:\n            return self._memo[n]\n\n        # Cn = sum(Ci * C(n-1-i)) for i from 0 to n-1\n        result = 0\n        for i in range(n):\n            c_i = self._compute_dp(i)\n            c_n_minus_1_minus_i = self._compute_dp(n - 1 - i)\n            result += c_i * c_n_minus_1_minus_i\n\n        self._memo[n] = result\n        return result\ndef catalan_number(n: int) -> int:\n    \"\"\"\n    Returns the nth Catalan number (zero-based).\n    Raises ValueError for invalid input.\n    \"\"\"\n    if not Validation.is_non_negative_integer(n):\n        raise ValueError(\"Input 'n' must be a non-negative integer.\")\n\n    calculator = CatalanNumberCalculator()\n    return calculator.catalan_number(n)"}
{"task_id": "Mbpp/585", "solution": "def expensive_items(items, n):\n    \"\"\"\n    Finds the n most expensive items from a list of items.\n    Items can be dictionaries with a 'price' key or objects with a 'price' attribute.\n    \"\"\"\n    if n == 0:\n        return []\n\n    items_copy = list(items)\n\n    def _price_of(item):\n        if isinstance(item, dict):\n            return float(item['price'])\n        elif hasattr(item, 'price'):\n            return float(item.price)\n        else:\n            raise TypeError(\"item missing numeric 'price' field\")\n\n    sorted_items = sorted(items_copy, key=_price_of, reverse=True)\n\n    return sorted_items[:n]"}
