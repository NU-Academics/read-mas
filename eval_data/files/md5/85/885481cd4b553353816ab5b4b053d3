{"task_id": "Mbpp/749", "solution": "from dataclasses import dataclass\nfrom typing import List\nclass NumericStringSorter:\n    def parse_string(self, s: str) -> int:\n        \"\"\"Parse a single string to signed int.\"\"\"\n        return int(s)\n\n    def sort_integers(self, values: List[int]) -> List[int]:\n        \"\"\"Return ascending numeric sort of values.\"\"\"\n        return sorted(values)\n\n    def sort(self, input_list: List[str]) -> List[int]:\n        \"\"\"High-level orchestration used by sort_numeric_strings.\"\"\"\n        parsed_integers: List[int] = []\n        for s in input_list:\n            input_str_obj = InputString(value=s)\n            parsed_integers.append(input_str_obj.to_integer())\n\n        sorted_values = self.sort_integers(parsed_integers)\n        result_obj = SortResult(values=sorted_values)\n        return result_obj.values\ndef sort_numeric_strings(input_list: List[str]) -> List[int]:\n    \"\"\"Public API entrypoint. Accepts list[str], returns list[int].\"\"\"\n    sorter = NumericStringSorter()\n    return sorter.sort(input_list)"}
