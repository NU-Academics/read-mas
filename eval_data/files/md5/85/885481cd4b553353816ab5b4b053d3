{"task_id": "Mbpp/796", "solution": "from typing import Dict, Union\ndef return_sum(input_dict: Dict[str, Union[int, float]]) -> Union[int, float]:\n    \"\"\"\n    Calculates the sum of all numeric values in the given dictionary.\n    Assumes input_dict values are numeric as per design contract.\n    \"\"\"\n    return sum(input_dict.values())"}
{"task_id": "Mbpp/797", "solution": "class OddNumber:\n    \"\"\"Represent a single integer candidate and provide predicate operations.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\n    def isOdd(self) -> bool:\n        \"\"\"Checks if the number is odd.\"\"\"\n        return self.value % 2 == 1\n\n    def isNatural(self) -> bool:\n        \"\"\"Checks if the number is a natural number (>= 1).\"\"\"\n        return self.value >= 1\n\n    def getValue(self) -> int:\n        \"\"\"Returns the integer value.\"\"\"\n        return self.value\nclass Range:\n    \"\"\"Represent interval [l, r], provide validation and enumeration of candidate integers.\"\"\"\n    def __init__(self, l: int, r: int) -> None:\n        self.l = l\n        self.r = r\n\n    def isValid(self) -> bool:\n        \"\"\"Checks if the range is valid (l <= r).\"\"\"\n        return self.l <= self.r\n\n    def getOddNumbers(self) -> list[int]:\n        \"\"\"Returns a list of odd natural numbers within the range.\"\"\"\n        if not self.isValid():\n            return []\n\n        qualifying_numbers = []\n        # Natural numbers are >= 1. Start iteration from max(1, self.l).\n        # The range function's second argument is exclusive, so +1 for inclusive.\n        for num in range(max(1, self.l), self.r + 1):\n            odd_num_candidate = OddNumber(num)\n            if odd_num_candidate.isNatural() and odd_num_candidate.isOdd():\n                qualifying_numbers.append(odd_num_candidate.getValue())\n        return qualifying_numbers\nclass SumResult:\n    \"\"\"Represent computed sum result.\"\"\"\n    def __init__(self, total: int) -> None:\n        self.total = total\n\n    def getTotal(self) -> int:\n        \"\"\"Returns the total sum.\"\"\"\n        return self.total\ndef sum_in_range(l: int, r: int) -> int:\n    \"\"\"Return sum of odd natural numbers in inclusive range [l, r].\"\"\"\n    current_range = Range(l, r)\n    odd_natural_numbers = current_range.getOddNumbers()\n    total_sum = sum(odd_natural_numbers)\n    result = SumResult(total_sum)\n    return result.getTotal()"}
{"task_id": "Mbpp/794", "solution": "def text_starta_endb(input: str) -> bool:\n    \"\"\"Return True iff input starts with 'a' and ends with 'b' (case-sensitive).\"\"\"\n    if len(input) < 2:\n        return False\n    return input.startswith('a') and input.endswith('b')"}
{"task_id": "Mbpp/799", "solution": "def left_rotate(n: int, d: int) -> int:\n    \"\"\"\n    Rotates the bits of a 32-bit integer `n` to the left by `d` positions.\n    The rotation is circular, and inputs/outputs are treated as 32-bit unsigned.\n    \"\"\"\n    # Mask n to ensure it's a 32-bit unsigned integer.\n    n_masked = n & 0xFFFFFFFF\n\n    # Normalize rotation distance to be within 0-31.\n    effective_d = d % 32\n\n    if effective_d == 0:\n        # If effective_d is 0 (or a multiple of 32), no rotation occurs.\n        rotated_value = n_masked\n    else:\n        # Perform circular left rotation.\n        # (n_masked << effective_d) shifts bits left.\n        # (n_masked >> (32 - effective_d)) brings back the bits that \"fell off\" from the left.\n        rotated_value = ((n_masked << effective_d) | (n_masked >> (32 - effective_d)))\n\n    # Mask the final result to ensure it stays within 32 bits after potential overflow from left shift.\n    return rotated_value & 0xFFFFFFFF"}
{"task_id": "Mbpp/800", "solution": "def remove_all_spaces(input: str) -> str:\n    \"\"\"Return a copy of `input` with all characters c removed where c.isspace() is True.\n\n    Preconditions:\n    - input must be of type str.\n    Postconditions:\n    - return value is of type str and contains no characters where c.isspace() is True.\n    \"\"\"\n    non_space_chars = []\n    for char in input:\n        if not char.isspace():\n            non_space_chars.append(char)\n    return \"\".join(non_space_chars)"}
{"task_id": "Mbpp/801", "solution": "def test_three_equal(a: int, b: int, c: int) -> int:\n    \"\"\"Counts the number of equal integers among the three given inputs.\"\"\"\n    if a == b and b == c:\n        return 3\n    elif a == b or a == c or b == c:\n        return 2\n    else:\n        return 0"}
{"task_id": "Mbpp/803", "solution": "def is_perfect_square(n: int) -> bool:\n    \"\"\"\n    Checks if a given integer is a perfect square using integer binary search.\n    Returns False for negative integers.\n    \"\"\"\n    if n < 0:\n        return False\n    if n == 0:\n        return True\n\n    # Use binary search to find floor(sqrt(n))\n    low, high = 1, n\n    ans = 0 # Stores floor(sqrt(n))\n\n    while low <= high:\n        mid = (low + high) // 2\n        mid_squared = mid * mid\n\n        if mid_squared == n:\n            return True  # Found an exact integer square root\n        elif mid_squared < n:\n            ans = mid  # mid could be floor(sqrt(n)), try larger\n            low = mid + 1\n        else: # mid_squared > n\n            high = mid - 1\n    \n    # After binary search, 'ans' holds floor(sqrt(n)).\n    # Check if squaring 'ans' yields the original number 'n'.\n    return ans * ans == n"}
{"task_id": "Mbpp/805", "solution": "from typing import List\ndef max_sum_list(lists: List[List[float]]) -> List[float]:\n    \"\"\"\n    Returns the sublist from a list of lists whose sum of elements is the highest.\n    If multiple sublists have the same highest sum, the first one encountered is returned.\n    Returns an empty list if the input list is empty.\n    \"\"\"\n    if not lists:\n        return []\n\n    max_current_sum = sum(lists[0])\n    result_list = lists[0]\n\n    for sublist in lists[1:]:\n        current_sum = sum(sublist)\n        if current_sum > max_current_sum:\n            max_current_sum = current_sum\n            result_list = sublist\n\n    return result_list"}
{"task_id": "Mbpp/804", "solution": "from typing import List\ndef is_product_even(input_list: List[int]) -> bool:\n    \"\"\"\n    Checks if the product of numbers in a list is even.\n    Returns True if any number in the list is even or zero, False otherwise.\n    \"\"\"\n    for num in input_list:\n        if num % 2 == 0:\n            return True\n    return False"}
{"task_id": "Mbpp/808", "solution": "def check_K(collection, k) -> bool:\n    \"\"\"Return True if k is present in collection (expected to be a tuple), else False.\n\n    Precondition: caller provides a tuple for collection (per SRS). Uses Python 'in' membership semantics.\n    \"\"\"\n    return k in collection"}
{"task_id": "Mbpp/806", "solution": "def _is_uppercase(ch: str) -> bool:\n    \"\"\"Checks if a character is uppercase using the language's standard classification.\"\"\"\n    return ch.isupper()\ndef max_run_uppercase(input: str) -> int:\n    \"\"\"\n    Finds the maximum run of uppercase characters in the given string.\n    Returns 0 if the string is empty or contains no uppercase characters.\n    \"\"\"\n    max_run = 0\n    current_run = 0\n\n    for char in input:\n        if _is_uppercase(char):\n            current_run += 1\n        else:\n            current_run = 0\n        max_run = max(max_run, current_run)\n\n    return max_run"}
{"task_id": "Mbpp/807", "solution": "from typing import Iterable, Optional\ndef _is_integral_odd(value: float | int) -> bool:\n    \"\"\"\n    Determines if a numeric value is integral and odd.\n    Handles both integers and floats, treating floats as integral only if they have no fractional part.\n    \"\"\"\n    if isinstance(value, float):\n        if not value.is_integer():\n            return False\n    return int(value) % 2 != 0\ndef first_odd(numbers: Iterable[float | int]) -> Optional[int]:\n    \"\"\"\n    Finds the first odd number in a given iterable of numbers.\n    It returns the first odd integer found, or None if no odd integers are present.\n    \"\"\"\n    for num in numbers:\n        if _is_integral_odd(num):\n            return int(num)\n    return None"}
{"task_id": "Mbpp/809", "solution": "from typing import Tuple, Union\ndef check_smaller(tuple_a: Tuple[Union[int, float], ...], tuple_b: Tuple[Union[int, float], ...]) -> bool:\n    \"\"\"\n    Checks if each element of the second tuple is smaller than its corresponding element in the first tuple.\n    Comparison proceeds only up to the length of the shortest tuple.\n    \"\"\"\n    for val_a, val_b in zip(tuple_a, tuple_b):\n        if not (val_b < val_a):\n            return False\n    return True"}
{"task_id": "Mbpp/105", "solution": "from typing import Any\ndef validate_input(items: Any) -> bool:\n    \"\"\"Return True if items is a list (per FR1 precondition).\"\"\"\n    return isinstance(items, list)\ndef count(items: list) -> int:\n    \"\"\"Return number of elements that are bool and True. O(n) time, O(1) extra space.\"\"\"\n    if not validate_input(items):\n        return 0\n\n    true_count = 0\n    for item in items:\n        if type(item) is bool and item is True:\n            true_count += 1\n    return true_count"}
