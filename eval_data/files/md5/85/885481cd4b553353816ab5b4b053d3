{"task_id": "Mbpp/594", "solution": "from typing import List\ndef diff_even_odd(input_list: List[int]) -> int:\n    \"\"\"Validate input_list and return first_even - first_odd as int or raise ValueError with SRS-specified messages.\"\"\"\n    if not isinstance(input_list, list):\n        raise ValueError(\"invalid input: expected list of integers\")\n    if len(input_list) == 0:\n        raise ValueError(\"invalid input: empty list\")\n    for x in input_list:\n        if not isinstance(x, int):\n            raise ValueError(\"invalid input: expected list of integers\")\n\n    first_odd = None\n    first_even = None\n    for val in input_list:\n        if first_odd is None and (val % 2) != 0:\n            first_odd = val\n        if first_even is None and (val % 2) == 0:\n            first_even = val\n        if first_odd is not None and first_even is not None:\n            break\n\n    if first_even is None:\n        raise ValueError(\"no even number found\")\n    if first_odd is None:\n        raise ValueError(\"no odd number found\")\n\n    return first_even - first_odd"}
{"task_id": "Mbpp/598", "solution": "from typing import List\ndef _extract_digits(integer: int) -> List[int]:\n    \"\"\"Extracts decimal digits from an integer.\"\"\"\n    if integer == 0:\n        return [0]\n    return [int(d) for d in str(abs(integer))]\ndef _digit_count(integer: int) -> int:\n    \"\"\"Counts the number of decimal digits in an integer.\"\"\"\n    if integer == 0:\n        return 1\n    return len(str(abs(integer)))\ndef _compute_powered_sum(digits: List[int], count: int) -> int:\n    \"\"\"Computes the sum of each digit raised to the given power.\"\"\"\n    return sum(d ** count for d in digits)\ndef armstrong_number(integer: int) -> bool:\n    \"\"\"\n    Checks if the given number is an Armstrong number.\n    An Armstrong number equals the sum of its digits each raised to the power of the number of digits.\n    \"\"\"\n    _validate_input(integer)\n\n    digits = _extract_digits(integer)\n    n = _digit_count(integer)\n    computed_sum = _compute_powered_sum(digits, n)\n\n    return computed_sum == integer"}
{"task_id": "Mbpp/599", "solution": "from dataclasses import dataclass\nclass Validator:\n    \"\"\"Validates the input n to ensure it's an integer and non-negative.\"\"\"\n    def validate(self, n) -> None:\n        if not isinstance(n, int):\n            raise ValueError('n must be an integer.')\n        if n < 1:\n            raise ValueError('n must be greater than or equal to 1.')\ndef sum_average(n) -> tuple:\n    \"\"\"\n    Computes the sum and average of the first n natural numbers.\n    Validates input n and returns results as a tuple (sum: int, average: float).\n    \"\"\"\n    validator = Validator()\n    validator.validate(n)\n\n    sum_val = n * (n + 1) // 2\n    average_val = sum_val / n\n\n    result = Result(sum=sum_val, average=average_val)\n    return result.as_tuple()"}
{"task_id": "Mbpp/597", "solution": "class InputArray:\n    \"\"\"\n    A lightweight wrapper around a sequence, providing read-only properties.\n    \"\"\"\n    def __init__(self, elements):\n        self.elements = elements\n        self._length = len(elements)\n\n    @property\n    def length(self):\n        return self._length\n\n    @property\n    def is_sorted(self):\n        # As per problem context, input arrays are assumed sorted.\n        return True\n\n    def get_slice(self, start, end):\n        return self.elements[start:end]\nclass KthResult:\n    \"\"\"\n    Data transfer object for a KthFinder result.\n    \"\"\"\n    def __init__(self, value):\n        self.value = value\nclass KthFinder:\n    \"\"\"\n    Encapsulates validation and the k-th element computation logic.\n    \"\"\"\n    @staticmethod\n    def validate_inputs(a_wrapper: InputArray, b_wrapper: InputArray, k: int) -> None:\n        \"\"\"\n        Validates the input parameters, raising IndexError if k is out of bounds.\n        \"\"\"\n        total_len = a_wrapper.length + b_wrapper.length\n        if not (1 <= k <= total_len):\n            raise IndexError(\"k is out of bounds for the given arrays.\")\n\n    @staticmethod\n    def merge_step_logic(a_wrapper: InputArray, b_wrapper: InputArray, k: int):\n        \"\"\"\n        Finds the k-th smallest element using a binary search-like approach.\n        \"\"\"\n        arr1 = a_wrapper.elements\n        arr2 = b_wrapper.elements\n        n1 = a_wrapper.length\n        n2 = b_wrapper.length\n\n        # Ensure arr1 is the shorter array for optimized binary search range.\n        if n1 > n2:\n            arr1, arr2 = arr2, arr1\n            n1, n2 = n2, n1\n\n        # Define search space for 'i' (number of elements from arr1).\n        # i can range from max(0, k-n2) to min(k, n1).\n        low = max(0, k - n2)\n        high = min(k, n1)\n\n        while low <= high:\n            mid1 = (low + high) // 2\n            mid2 = k - mid1\n\n            # Determine the four boundary elements for partitioning.\n            # Use float('-inf') and float('inf') for virtual boundaries.\n            L1 = arr1[mid1 - 1] if mid1 > 0 else float('-inf')\n            R1 = arr1[mid1] if mid1 < n1 else float('inf')\n            L2 = arr2[mid2 - 1] if mid2 > 0 else float('-inf')\n            R2 = arr2[mid2] if mid2 < n2 else float('inf')\n\n            if L1 <= R2 and L2 <= R1:\n                # Correct partition found. The k-th element is the maximum of the left halves.\n                return max(L1, L2)\n            elif L1 > R2:\n                # Too many elements taken from arr1. Adjust high to take fewer from arr1.\n                high = mid1 - 1\n            else: # L2 > R1\n                # Too few elements taken from arr1. Adjust low to take more from arr1.\n                low = mid1 + 1\n        \n        # This line should ideally be unreachable if validate_inputs ensures k is within bounds.\n        return None\n\n    @staticmethod\n    def find_kth(a, b, k):\n        \"\"\"\n        The KthFinder's static method to find the k-th element, orchestrating validation and logic.\n        \"\"\"\n        a_wrapper = InputArray(a)\n        b_wrapper = InputArray(b)\n\n        KthFinder.validate_inputs(a_wrapper, b_wrapper, k)\n\n        result_value = KthFinder.merge_step_logic(a_wrapper, b_wrapper, k)\n        return KthResult(result_value).value\ndef find_kth(a, b, k):\n    \"\"\"\n    Finds the k-th smallest element from two sorted arrays a and b.\n    Delegates validation and computation to KthFinder.\n    \"\"\"\n    return KthFinder.find_kth(a, b, k)"}
