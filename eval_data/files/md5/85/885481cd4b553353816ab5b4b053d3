{"task_id": "Mbpp/91", "solution": "from typing import List, Optional, Iterator\nclass StringElement:\n    \"\"\"Represents a single input string element.\"\"\"\n    def __init__(self, value: str) -> None:\n        self.value = value\nclass StringList:\n    \"\"\"Container for StringElement items.\"\"\"\n    def __init__(self, elements: Optional[List[str]] = None) -> None:\n        self.elements: List[StringElement] = []\n        if elements:\n            self.elements = [StringElement(e) for e in elements]\n\n    def is_empty(self) -> bool:\n        return not self.elements\n\n    def __iter__(self) -> Iterator['StringElement']:\n        return iter(self.elements)\nclass Substring:\n    \"\"\"Wrapper for substring to search.\"\"\"\n    def __init__(self, value: str) -> None:\n        self.value = value\nclass SearchResult:\n    \"\"\"Represents the outcome of a substring search.\"\"\"\n    def __init__(self, found: bool, matching_element: Optional[str] = None) -> None:\n        self.found = found\n        self.matching_element = matching_element\nclass SubstringSearch:\n    \"\"\"Stateless domain helper for element-by-element substring checks.\"\"\"\n    def search(self, string_list: StringList, substring_obj: Substring) -> SearchResult:\n        \"\"\"\n        Performs a search for substring_obj.value within elements of string_list.\n        Returns SearchResult(found=True) on the first match, otherwise SearchResult(found=False).\n        \"\"\"\n        for element_obj in string_list:\n            if substring_obj.value in element_obj.value:\n                return SearchResult(found=True, matching_element=element_obj.value)\n        return SearchResult(found=False, matching_element=None)\ndef find_substring(list_of_strings: List[str], substring: str) -> bool:\n    \"\"\"\n    Checks if a string is present as a substring in a given list of string values.\n    Returns True if found, False otherwise (including for an empty list).\n    \"\"\"\n    s_list = StringList(list_of_strings)\n\n    if s_list.is_empty():\n        return False\n\n    s_sub = Substring(substring)\n    searcher = SubstringSearch()\n    result = searcher.search(s_list, s_sub)\n\n    return result.found"}
{"task_id": "Mbpp/93", "solution": "class PowerFunction:\n    \"\"\"Encapsulates power computation and input validation.\"\"\"\n    def validateInputs(self, a: float, b: float) -> bool:\n        \"\"\"\n        Validates if inputs are numeric and not None, raising ValueError if invalid.\n        Returns True if inputs are valid.\n        \"\"\"\n        if not isinstance(a, (int, float)) or a is None:\n            raise ValueError(\"Input 'a' must be a numeric value.\")\n        if not isinstance(b, (int, float)) or b is None:\n            raise ValueError(\"Input 'b' must be a numeric value.\")\n        return True\n\n    def power(self, a: float, b: float) -> float:\n        \"\"\"\n        Computes a raised to the power b after validating inputs.\n        Returns the result as a float.\n        \"\"\"\n        self.validateInputs(a, b)\n        return float(a ** b)\ndef power(a, b) -> float:\n    \"\"\"\n    Calculates the value of 'a' to the power 'b'.\n    This function delegates the computation to an internal PowerFunction class.\n    \"\"\"\n    power_calculator = PowerFunction()\n    return power_calculator.power(float(a), float(b))"}
