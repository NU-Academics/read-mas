{"task_id": "Mbpp/11", "solution": "def remove_Occ(input_string: str, char: str) -> str:\n    \"\"\"Removes the first and last occurrences of a given character from the string.\"\"\"\n    first_occurrence_index = input_string.find(char)\n    last_occurrence_index = input_string.rfind(char)\n\n    if first_occurrence_index == -1 or last_occurrence_index == -1:\n        # Character not found at all\n        return input_string\n    elif first_occurrence_index == last_occurrence_index:\n        # Character found exactly once\n        return input_string[:first_occurrence_index] + input_string[first_occurrence_index + len(char):]\n    else:\n        # Character found at least twice at different positions\n        return (input_string[:first_occurrence_index] +\n                input_string[first_occurrence_index + len(char):last_occurrence_index] +\n                input_string[last_occurrence_index + len(char):])"}
{"task_id": "Mbpp/6", "solution": "def xor(a: int, b: int) -> int:\n    \"\"\"Computes the bitwise XOR of two integers.\"\"\"\n    return a ^ b\ndef popcount(x: int) -> int:\n    \"\"\"Counts the number of set (1) bits in an integer's binary representation.\"\"\"\n    return x.bit_count()\ndef differ_At_One_Bit_Pos(a: int, b: int) -> bool:\n    \"\"\"\n    Checks if two numbers differ at exactly one bit position.\n    This function assumes valid integer inputs as per the design constraints.\n    \"\"\"\n    xor_value = xor(a, b)\n    difference_count = popcount(xor_value)\n    return difference_count == 1"}
{"task_id": "Mbpp/7", "solution": "from typing import List\nclass ResultCollection:\n    \"\"\"Accumulates qualifying tokens into an internal list.\"\"\"\n    def __init__(self) -> None:\n        self._items: List[str] = []\n    def add(self, token: str) -> None:\n        self._items.append(token)\n    def items(self) -> List[str]:\n        return self._items\nclass Word:\n    \"\"\"Value object wrapper around a token providing a length helper.\"\"\"\n    def __init__(self, text: str) -> None:\n        self.text = text\n    def length(self) -> int:\n        return len(self.text)\nclass Tokenizer:\n    \"\"\"Splits an input string into tokens based on whitespace.\"\"\"\n    @staticmethod\n    def split(input: str) -> List[str]:\n        return input.split()\nclass FindCharLong:\n    \"\"\"Orchestrates tokenization, filtering, and collection of words.\"\"\"\n    def find(self, input: str) -> List[str]:\n        tokens = Tokenizer.split(input)\n        result = ResultCollection()\n        for t in tokens:\n            w = Word(t)\n            if w.length() >= 4:\n                result.add(w.text)\n        return result.items()\ndef find_char_long(input: str) -> List[str]:\n    \"\"\"\n    Finds all words which are at least 4 characters long in a string.\n    \"\"\"\n    return FindCharLong().find(input)"}
{"task_id": "Mbpp/3", "solution": "class IntegerNumber:\n    \"\"\"Simple data-holder representing the integer being evaluated.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value: int = value\nclass PrimeCheckResult:\n    \"\"\"Simple data-holder representing the check result for traceability.\"\"\"\n    def __init__(self, is_not_prime: bool, number_value: int) -> None:\n        self.is_not_prime: bool = is_not_prime\n        self.number_value: int = number_value\nclass PrimeChecker:\n    \"\"\"Encapsulates primality checking algorithm.\"\"\"\n    def _is_prime(self, n: int) -> bool:\n        \"\"\"Internal helper returning True if n is prime, False otherwise.\"\"\"\n        if n <= 1:\n            return False\n        if n == 2:\n            return True\n        if n % 2 == 0:\n            return False\n        i = 3\n        while i * i <= n:\n            if n % i == 0:\n                return False\n            i += 2\n        return True\n\n    def is_not_prime(self, n: int) -> bool:\n        \"\"\"Return True if n is non-prime, False if n is prime.\"\"\"\n        is_prime_val = self._is_prime(n)\n        # For traceability, create PrimeCheckResult, though not directly returned by this public method\n        PrimeCheckResult(not is_prime_val, n) \n        return not is_prime_val\ndef is_not_prime(n: int) -> bool:\n    \"\"\"\n    Public API that accepts an integer n and returns True if n is non-prime,\n    False if n is prime.\n    \"\"\"\n    # Create IntegerNumber(n) for traceability.\n    _ = IntegerNumber(n)\n    \n    # Delegate to PrimeChecker().is_not_prime(n).\n    checker = PrimeChecker()\n    return checker.is_not_prime(n)"}
{"task_id": "Mbpp/9", "solution": "from dataclasses import dataclass\nfrom typing import Optional\nclass RotationCalculator:\n    def find_Rotations(self, s: str) -> int:\n        \"\"\"\n        Computes the minimum positive rotation k (1 <= k <= len(s))\n        such that s rotated by k yields s.\n        \"\"\"\n        n = len(s)\n        for k in range(1, n + 1):\n            rotated = s[k:] + s[:k]\n            if rotated == s:\n                return k\n        return n # Fallback, though for any non-empty string, n rotations always yield the original.\ndef find_Rotations(s: str) -> int:\n    \"\"\"\n    Finds the minimum number of rotations (greater than 0) required to get the same string.\n    Delegates the computation to RotationCalculator.\n    \"\"\"\n    calculator = RotationCalculator()\n    return calculator.find_Rotations(s)"}
{"task_id": "Mbpp/8", "solution": "from typing import List, Iterator, Union\nclass Number:\n    \"\"\"Domain wrapper for a single numeric value and the square operation.\"\"\"\n    def __init__(self, value: Union[int, float]):\n        self.value = value\n\n    def square(self) -> Union[int, float]:\n        \"\"\"Returns the square of the wrapped value.\"\"\"\n        return self.value * self.value\nclass NumberList:\n    \"\"\"Domain wrapper representing an ordered collection of Number instances.\"\"\"\n    def __init__(self, elements: List['Number']):\n        self.elements = elements\n\n    def __iter__(self) -> Iterator['Number']:\n        \"\"\"Allows iteration over the contained Number elements.\"\"\"\n        return iter(self.elements)\n\n    def __len__(self) -> int:\n        \"\"\"Returns the number of elements in the list.\"\"\"\n        return len(self.elements)\nclass ResultList:\n    \"\"\"Domain wrapper representing the ordered output collection of Number instances (squared values).\"\"\"\n    def __init__(self, elements: List['Number']):\n        self.elements = elements\n\n    def to_plain_list(self) -> List[Union[int, float]]:\n        \"\"\"Converts the ResultList to a plain Python list of numeric values.\"\"\"\n        return [number_obj.value for number_obj in self.elements]\nclass SquareNumsFunction:\n    \"\"\"Encapsulates the squaring use case; transforms NumberList -> ResultList.\"\"\"\n    def square_nums(self, numbers: 'NumberList') -> 'ResultList':\n        \"\"\"Transforms a NumberList into a ResultList by squaring each element.\"\"\"\n        squared_numbers_objects = []\n        for num_obj in numbers:\n            squared_value = num_obj.square()\n            squared_numbers_objects.append(Number(squared_value))\n        return ResultList(squared_numbers_objects)\ndef _to_number_list(numbers: List[Union[int, float, Number]]) -> NumberList:\n    \"\"\"Converts a list of primitives or Number instances into a NumberList.\"\"\"\n    number_objects = []\n    for item in numbers:\n        # This check distinguishes between Number objects and primitive types.\n        if isinstance(item, Number):\n            number_objects.append(item)\n        else:\n            number_objects.append(Number(item))\n    return NumberList(number_objects)\ndef _from_result_list(result_list: ResultList) -> List[Union[int, float]]:\n    \"\"\"Converts a ResultList into a plain Python list of numeric values.\"\"\"\n    return result_list.to_plain_list()\ndef square_nums(numbers: List[Union[int, float, Number]]) -> List[Union[int, float]]:\n    \"\"\"\n    Finds squares of individual elements in a list.\n    Accepts a list of numbers (int, float, or Number objects) and returns a list of squared primitives.\n    \"\"\"\n    number_list_obj = _to_number_list(numbers)\n    result_list_obj = SquareNumsFunction().square_nums(number_list_obj)\n    return _from_result_list(result_list_obj)"}
{"task_id": "Mbpp/4", "solution": "import heapq\nfrom typing import List\ndef heap_queue_largest(numbers: List[int], n: int) -> List[int]:\n    \"\"\"\n    Finds the n largest integers from a list of numbers and returns them in descending order.\n    This implementation efficiently uses Python's heapq.nlargest function.\n    \"\"\"\n    if n <= 0:\n        return []\n\n    # heapq.nlargest returns the n largest elements from the iterable,\n    # sorted in descending order. It correctly handles cases where n is\n    # greater than or equal to the length of the list, returning all elements\n    # sorted in descending order.\n    return heapq.nlargest(n, numbers)"}
{"task_id": "Mbpp/2", "solution": "from typing import Any, Iterable, Collection, List, Set\nclass ResultCollection:\n    \"\"\"Collects deduplicated intersection elements and provides a set view.\"\"\"\n    def __init__(self):\n        self.elements: List[Any] = []\n\n    def add(self, element: Any) -> None:\n        \"\"\"Adds an element if it's not already in the collection.\"\"\"\n        if element not in self.elements:\n            self.elements.append(element)\n\n    def as_set(self) -> Set[Any]:\n        \"\"\"Returns a set view of the collected elements.\"\"\"\n        return set(self.elements)\nclass SimilarElementsFunction:\n    \"\"\"Encapsulates validation and computation for finding shared elements.\"\"\"\n    def similar_elements(self, a: Iterable[Any], b: Iterable[Any]) -> Collection[Any]:\n        \"\"\"Validates inputs, computes intersection, and returns the result.\"\"\"\n        self.validate_inputs(a, b)\n        return self.compute_intersection(a, b)\n\n    def validate_inputs(self, a: Iterable[Any], b: Iterable[Any]) -> bool:\n        \"\"\"Ensures inputs are accepted sequence types (list or tuple). Does not raise.\"\"\"\n        # Per design constraints, no explicit isinstance checks are performed here.\n        return True\n\n    def compute_intersection(self, a: Iterable[Any], b: Iterable[Any]) -> Collection[Any]:\n        \"\"\"Computes deduplicated collection of shared elements using equality (==).\"\"\"\n        result_collection = ResultCollection()\n        for element_a in a:\n            if element_a in b:\n                result_collection.add(element_a)\n        return result_collection.elements\ndef similar_elements(a: Iterable[Any], b: Iterable[Any]) -> Collection[Any]:\n    \"\"\"\n    Finds the shared elements from the given two lists.\n    assert set(similar_elements((3, 4, 5, 6),(5, 7, 4, 10))) == set((4, 5))\n    \"\"\"\n    return SimilarElementsFunction().similar_elements(a, b)"}
{"task_id": "Mbpp/17", "solution": "def square_perimeter(side_length):\n    \"\"\"\n    Return the perimeter of a square with the given side length.\n    It accepts integer or floating-point side_length inputs and returns a numeric result.\n    \"\"\"\n    return 4 * side_length"}
{"task_id": "Mbpp/14", "solution": "class TriangularPrism:\n    \"\"\"Encapsulates dimensions of a triangular prism and computes its volume.\"\"\"\n    def __init__(self, base: float, height: float, length: float) -> None:\n        self.base = base\n        self.height = height\n        self.length = length\n\n    def compute_volume(self) -> float:\n        \"\"\"Calculates the volume of the triangular prism.\"\"\"\n        return 0.5 * self.base * self.height * self.length\ndef find_Volume(base, height, length):\n    \"\"\"\n    Finds the volume of a triangular prism.\n    Delegates calculation to the TriangularPrism class.\n    \"\"\"\n    prism = TriangularPrism(base, height, length)\n    return prism.compute_volume()"}
{"task_id": "Mbpp/16", "solution": "import re\nclass InputString:\n    def __init__(self, value: str):\n        \"\"\"Initializes the InputString with a string value.\"\"\"\n        self.value = value\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the encapsulated string.\"\"\"\n        return len(self.value)\nclass Result:\n    def __init__(self, value: bool):\n        \"\"\"Initializes the Result with a boolean value.\"\"\"\n        self.value = value\nclass PatternMatcher:\n    \"\"\"Matches the defined regex pattern in a string.\"\"\"\n    regex: str = \"[a-z]+_[a-z]+\"\n    _compiled: re.Pattern = re.compile(regex)\n\n    def matches(self, s: str) -> bool:\n        \"\"\"Returns True if the pattern is found in string s, False otherwise.\"\"\"\n        return self._compiled.search(s) is not None\nclass TextLowercaseUnderscore:\n    \"\"\"Orchestrates pattern matching for lowercase-underscore sequences.\"\"\"\n    def __init__(self, matcher: PatternMatcher = None):\n        \"\"\"Initializes the orchestrator with an optional PatternMatcher.\"\"\"\n        self._matcher = matcher if matcher is not None else PatternMatcher()\n\n    def execute(self, input_str: str) -> bool:\n        \"\"\"Executes the pattern matching against the input string.\"\"\"\n        input_obj = InputString(input_str)\n        match_found = self._matcher.matches(input_obj.value)\n        return Result(match_found).value\ndef text_lowercase_underscore(input: str) -> bool:\n    \"\"\"\n    Checks if the input string contains sequences of lowercase letters\n    joined with an underscore.\n    \"\"\"\n    orchestrator = TextLowercaseUnderscore()\n    return orchestrator.execute(input)"}
{"task_id": "Mbpp/18", "solution": "def remove_dirty_chars(source: str, mask: str) -> str:\n    \"\"\"\n    Remove every character from `source` that is present in `mask`.\n    \"\"\"\n    mask_set = set(mask)\n    filtered = [ch for ch in source if ch not in mask_set]\n    return ''.join(filtered)"}
{"task_id": "Mbpp/12", "solution": "import collections\nfrom typing import List, Union, Any\nNumber = Union[int, float]\nclass Row:\n    \"\"\"Wraps a list of numeric elements with original position and provides sum computation.\"\"\"\n    def __init__(self, elements: List[Number], position: int) -> None:\n        self.elements = elements\n        self.position = position\n\n    def sum(self) -> Number:\n        \"\"\"Compute and return the numeric sum of elements in the row.\"\"\"\n        return sum(self.elements)\nclass Matrix:\n    \"\"\"Holds an immutable snapshot of input rows (as Row objects).\"\"\"\n    def __init__(self, matrix_rows: List[List[Number]]) -> None:\n        self.rows: List[Row] = []\n        for i, row_elements in enumerate(matrix_rows):\n            self.rows.append(Row(row_elements, i))\n\n    def getRowSums(self) -> List[Number]:\n        \"\"\"Return a list of numeric sums for each Row instance in the same order as self.rows.\"\"\"\n        return [row.sum() for row in self.rows]\nclass SortOperation:\n    \"\"\"Encapsulates sorting orchestration: validation, sum computation, stable ordering and output construction.\"\"\"\n    @staticmethod\n    def sort_matrix(matrix: List[List[Number]]) -> List[List[Number]]:\n        \"\"\"\n        Accepts the input matrix, validates its structure and elements, computes row sums,\n        performs a stable sort, and returns a new sorted matrix.\n        \"\"\"\n        _validate_matrix_shape(matrix)\n\n        if not matrix:\n            return [] # Return an empty matrix if the input is empty\n\n        matrix_obj = Matrix(matrix)\n        rows_for_sorting = matrix_obj.rows\n\n        # Sort Row objects stably based on their sum. In case of equal sums,\n        # the original position ensures stability.\n        sorted_rows = sorted(rows_for_sorting, key=lambda row: (row.sum(), row.position))\n\n        # Reconstruct the sorted matrix as a list-of-lists\n        result_matrix: List[List[Number]] = [row.elements for row in sorted_rows]\n\n        return result_matrix\ndef sort_matrix(matrix: List[List[Number]]) -> List[List[Number]]:\n    \"\"\"\n    Sorts a given matrix in ascending order according to the sum of its rows.\n    Raises TypeError or ValueError for invalid input.\n    \"\"\"\n    return SortOperation.sort_matrix(matrix)"}
{"task_id": "Mbpp/19", "solution": "from typing import List\nclass ValidationError(Exception):\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\nclass IntegerArray:\n    def __init__(self, elements: list) -> None:\n        self._elements = elements\n\n    def elements(self) -> list[int]:\n        return self._elements\n\n    def length(self) -> int:\n        return len(self._elements)\ndef test_duplicate(arr: IntegerArray) -> bool:\n    \"\"\"\n    Checks if an array of integers contains any duplicate element.\n    Validates input type and element types, raising ValidationError on invalid input.\n    \"\"\"\n    if not isinstance(arr, IntegerArray):\n        raise ValidationError(\"Input must be IntegerArray\")\n\n    for element in arr.elements():\n        if not isinstance(element, int):\n            raise ValidationError(\"All elements must be integers\")\n\n    seen = set()\n    for element in arr.elements():\n        if element in seen:\n            return True\n        seen.add(element)\n    return False"}
{"task_id": "Mbpp/20", "solution": "import datetime\nfrom typing import Optional\nclass NumberInput:\n    \"\"\"Validates and wraps a number input.\"\"\"\n    def __init__(self, value: object) -> None:\n        self.value = value\n\n    def is_integer(self) -> bool:\n        return isinstance(self.value, int)\n\n    def is_positive(self) -> bool:\n        return isinstance(self.value, int) and self.value >= 1\nclass WoodallChecker:\n    \"\"\"Determines if a number is a Woodall number and finds its 'n'.\"\"\"\n    def find_n_for(self, number: int) -> int:\n        n = 1\n        while True:\n            # Using integer arithmetic to calculate n * 2^n - 1\n            value = n * (1 << n) - 1\n            if value == number:\n                return n\n            if value > number:\n                return 0  # Not found, and exceeded the target number\n            n += 1\ndef is_woodall(number: int) -> bool:\n    \"\"\"Checks if the given number is a Woodall number.\"\"\"\n    number_input = NumberInput(number)\n    if not number_input.is_integer() or not number_input.is_positive():\n        log_computation(number if isinstance(number, int) else 0, False, None) # Log 0 for non-int input to avoid type error\n        return False\n\n    checker = WoodallChecker()\n    found_n = checker.find_n_for(number)\n\n    if found_n > 0:\n        log_computation(number, True, found_n)\n        return True\n    else:\n        log_computation(number, False, None)\n        return False"}
{"task_id": "Mbpp/56", "solution": "class DigitReverser:\n    \"\"\"Helper class to reverse decimal digits of an integer.\"\"\"\n    @staticmethod\n    def reverse(n: int) -> int:\n        \"\"\"\n        Reverses the decimal digits of an integer, ignoring leading zeros in the reversed value.\n        For negative numbers, the sign is preserved while reversing the absolute value.\n        \"\"\"\n        if n == 0:\n            return 0\n        \n        is_negative = n < 0\n        abs_n_str = str(abs(n))\n        reversed_str = abs_n_str[::-1]\n        reversed_int = int(reversed_str)\n        \n        return -reversed_int if is_negative else reversed_int\ndef check(n: int) -> bool:\n    \"\"\"\n    Checks if a given number is one less than twice its reverse.\n    \"\"\"\n    reversed_n = DigitReverser.reverse(n)\n    return n == (2 * reversed_n) - 1"}
{"task_id": "Mbpp/62", "solution": "def smallest_num(numbers: list) -> float:\n    \"\"\"Validate and return the smallest numeric value from `numbers`.\n\n    Raises ValueError if `numbers` is invalid (not a list, empty, or non-numeric elements).\n    \"\"\"\n    def _validate_numbers(numbers: list) -> None:\n        \"\"\"Raise ValueError if `numbers` violates the input contract.\"\"\"\n        if not isinstance(numbers, list):\n            raise ValueError(\"Input must be a list.\")\n        if not numbers:\n            raise ValueError(\"Input list cannot be empty.\")\n        for x in numbers:\n            if not isinstance(x, (int, float)):\n                raise ValueError(\"All elements in the list must be numeric (int or float).\")\n\n    _validate_numbers(numbers)\n\n    min_val = numbers[0]\n    for num in numbers[1:]:\n        if num < min_val:\n            min_val = num\n    return float(min_val)"}
{"task_id": "Mbpp/57", "solution": "from typing import List\nclass ValidationError(Exception):\n    def __init__(self, message: str):\n        super().__init__(message)\nclass Validator:\n    def validate(self, digits: list) -> None:\n        \"\"\"\n        Validates that all elements in the list are integers between 0 and 9.\n        Raises ValidationError if any element is invalid.\n        \"\"\"\n        for i, digit in enumerate(digits):\n            if not isinstance(digit, int):\n                raise ValidationError(f\"Element at index {i} is not an integer: {digit}\")\n            if not (0 <= digit <= 9):\n                raise ValidationError(f\"Element at index {i} is out of range 0-9: {digit}\")\nclass NumberBuilder:\n    def build_sorted_number(self, digits: list) -> int:\n        \"\"\"\n        Sorts the digits in descending order and forms the largest possible integer.\n        Returns 0 for an empty list of digits.\n        \"\"\"\n        if not digits:\n            return 0\n        \n        sorted_digits = sorted(digits, reverse=True)\n        number_str = \"\".join(str(d) for d in sorted_digits)\n        return int(number_str)\ndef find_Max_Num(digits: List[int]) -> int:\n    \"\"\"\n    Finds the largest number that can be formed with the given list of digits.\n    It validates the input, then sorts and concatenates the digits to form an integer.\n    \"\"\"\n    validator = Validator()\n    validator.validate(digits)\n    builder = NumberBuilder()\n    result_int = builder.build_sorted_number(digits)\n    return result_int"}
