{"task_id": "Mbpp/72", "solution": "class MathRule:\n    \"\"\"Encapsulates the mathematical rule for difference-of-squares representability.\"\"\"\n    def __init__(self) -> None:\n        self.explanation = \"n is representable as a^2 - b^2 iff n % 4 != 2.\"\n\n    def isRepresentable(self, n: int) -> bool:\n        \"\"\"Determines if a number can be represented as the difference of two squares.\"\"\"\n        return n % 4 != 2\nclass DifSquareFunction:\n    \"\"\"Coordinates the application of the difference-of-squares rule.\"\"\"\n    def __init__(self, rule: MathRule | None = None) -> None:\n        self._rule = rule if rule is not None else MathRule()\n\n    def evaluate(self, n) -> bool:\n        \"\"\"Evaluates whether the given number can be represented as the difference of two squares.\"\"\"\n        return self._rule.isRepresentable(n)\ndef dif_Square(n) -> bool:\n    \"\"\"\n    Checks whether the given number can be represented as the difference of two squares.\n    It returns True if representable, False otherwise.\n    \"\"\"\n    dif_square_func = DifSquareFunction()\n    return dif_square_func.evaluate(n)"}
{"task_id": "Mbpp/75", "solution": "from typing import List, Tuple\ndef find_tuples(input_list: List[Tuple[int, ...]], k: int) -> List[Tuple[int, ...]]:\n    \"\"\"Return list of tuples from input_list where every element is divisible by k.\"\"\"\n    result = []\n    for current_tuple in input_list:\n        if all(element % k == 0 for element in current_tuple):\n            result.append(current_tuple)\n    return result"}
{"task_id": "Mbpp/74", "solution": "def is_samepatterns(pattern_seq, value_seq) -> bool:\n    \"\"\"\n    Checks if value_seq follows the sequence given in the patterns array.\n    This means for every pair of indices i,j, pattern_seq[i] == pattern_seq[j] iff value_seq[i] == value_seq[j].\n    \"\"\"\n    n = len(pattern_seq)\n    if n != len(value_seq):\n        return False\n\n    pattern_to_value = {}\n    value_to_pattern = {}\n\n    for i in range(n):\n        p_char = pattern_seq[i]\n        v_char = value_seq[i]\n\n        # Check consistency for pattern elements mapping to value elements\n        if p_char in pattern_to_value:\n            if pattern_to_value[p_char] != v_char:\n                return False\n        else:\n            pattern_to_value[p_char] = v_char\n\n        # Check consistency for value elements mapping to pattern elements (ensures one-to-one mapping)\n        if v_char in value_to_pattern:\n            if value_to_pattern[v_char] != p_char:\n                return False\n        else:\n            value_to_pattern[v_char] = p_char\n\n    return True"}
{"task_id": "Mbpp/77", "solution": "from dataclasses import dataclass\nclass InputValidator:\n    \"\"\"Validates that the provided argument is an integer.\"\"\"\n    def validate_int(self, arg) -> None:\n        \"\"\"Raises TypeError if arg is not an exact integer type.\"\"\"\n        if type(arg) is not int:\n            raise TypeError(\"Input must be an integer.\")\nclass DivisibilityChecker:\n    \"\"\"Computes divisibility by 11 for an integer.\"\"\"\n    def is_Diff(self, n: int) -> bool:\n        \"\"\"Returns True if n is divisible by 11, otherwise False.\"\"\"\n        number_obj = Number(value=n)\n        number_obj.is_divisible_by_11 = (n % 11 == 0)\n        return number_obj.is_divisible_by_11\ndef is_Diff(arg: int) -> bool:\n    \"\"\"Checks if an integer is divisible by 11.\n    Raises TypeError for non-integer inputs.\"\"\"\n    validator = InputValidator()\n    validator.validate_int(arg)\n    checker = DivisibilityChecker()\n    return checker.is_Diff(arg)"}
{"task_id": "Mbpp/80", "solution": "def tetrahedral_number(n: int) -> int:\n    \"\"\"\n    Computes the nth tetrahedral number using the formula T(n) = n*(n+1)*(n+2)/6.\n    The result is always an integer.\n    \"\"\"\n    return (n * (n + 1) * (n + 2)) // 6"}
{"task_id": "Mbpp/82", "solution": "import math\nclass MathConstants:\n    \"\"\"Provides reliable mathematical constants.\"\"\"\n    PI: float = math.pi\nclass Sphere:\n    \"\"\"Domain object representing a sphere with a given radius.\"\"\"\n    def __init__(self, radius: float):\n        self.radius = float(radius)\nclass VolumeResult:\n    \"\"\"Domain object holding the computed volume.\"\"\"\n    def __init__(self, value: float):\n        self.value = float(value)\nclass VolumeCalculator:\n    \"\"\"Encapsulates computation logic for sphere volume.\"\"\"\n    def volume_sphere(self, radius) -> float:\n        sphere = Sphere(radius)\n        pi_val = MathConstants.PI\n        volume_value = (4.0 / 3.0) * pi_val * (sphere.radius ** 3)\n        result = VolumeResult(volume_value)\n        return result.value\ndef volume_sphere(radius) -> float:\n    \"\"\"\n    Computes the volume of a sphere given its radius.\n    Delegates calculation to VolumeCalculator.\n    \"\"\"\n    calculator = VolumeCalculator()\n    return calculator.volume_sphere(radius)"}
{"task_id": "Mbpp/85", "solution": "import math\nclass SurfaceAreaCalculator:\n    \"\"\"A stateless helper class to calculate the surface area of a sphere.\"\"\"\n    @staticmethod\n    def surfacearea_sphere(radius: float) -> float:\n        \"\"\"Calculates the surface area of a sphere using the formula 4 * pi * radius^2.\"\"\"\n        return 4 * math.pi * (radius ** 2)\ndef surfacearea_sphere(radius: float) -> float:\n    \"\"\"\n    Calculates the surface area of a sphere given its radius.\n    This function delegates the calculation to a helper class.\n    \"\"\"\n    return SurfaceAreaCalculator.surfacearea_sphere(radius)"}
