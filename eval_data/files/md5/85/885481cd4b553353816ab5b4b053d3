{"task_id": "Mbpp/748", "solution": "import string\nclass Character:\n    \"\"\"Wrapper for a single character providing case and letter queries.\"\"\"\n    def __init__(self, value: str) -> None:\n        self.value = value\n\n    def is_uppercase(self) -> bool:\n        return self.value.isupper()\n\n    def is_letter(self) -> bool:\n        return self.value.isalpha()\n\n    def is_space(self) -> bool:\n        return self.value.isspace()\n\n    def __str__(self) -> str:\n        return self.value\nclass InputString:\n    \"\"\"Value object representing the input string and metadata.\"\"\"\n    def __init__(self, value: str) -> None:\n        self._value = value\n        self._length = len(value)\n\n    def char_at(self, index: int) -> Character:\n        if 0 <= index < self._length:\n            return Character(self._value[index])\n        raise IndexError(\"Character index out of bounds\")\n\n    def __len__(self) -> int:\n        return self._length\n\n    def __str__(self) -> str:\n        return self._value\nclass OutputString:\n    \"\"\"Buffer to accumulate output characters and present final string.\"\"\"\n    def __init__(self) -> None:\n        self._buffer = []\n\n    def append(self, s: str) -> None:\n        self._buffer.append(s)\n\n    def value(self) -> str:\n        return \"\".join(self._buffer)\n\n    def __len__(self) -> int:\n        return len(self._buffer)\n\n    def last_char(self) -> Character | None:\n        \"\"\"Returns the last character appended to the output buffer, or None if empty.\"\"\"\n        if self._buffer:\n            return Character(self._buffer[-1])\n        return None\nclass CapitalWordsSpacer:\n    \"\"\"Stateless class implementing the algorithm to insert spaces between words.\"\"\"\n    def capital_words_spaces(self, input_str_value: str) -> str:\n        input_string = InputString(input_str_value)\n        output_string = OutputString()\n\n        if len(input_string) == 0:\n            return \"\"\n\n        for i in range(len(input_string)):\n            current_char_obj = input_string.char_at(i)\n\n            # Insert a space if it's not the first character, the current character is an\n            # uppercase letter, and the preceding character in the output is not already a space.\n            if (i > 0 and current_char_obj.is_uppercase() and current_char_obj.is_letter()):\n                last_output_char_obj = output_string.last_char()\n                if last_output_char_obj is not None and not last_output_char_obj.is_space():\n                    output_string.append(' ')\n\n            output_string.append(current_char_obj.value)\n\n        return output_string.value()\ndef capital_words_spaces(input: str) -> str:\n    \"\"\"\n    Inserts spaces between words starting with capital letters in a given string.\n    \"\"\"\n    return CapitalWordsSpacer().capital_words_spaces(input)"}
{"task_id": "Mbpp/745", "solution": "from typing import List\nclass Digit:\n    \"\"\"Represents a single decimal digit.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def isZero(self) -> bool:\n        \"\"\"Checks if the digit is zero.\"\"\"\n        return self.value == 0\nclass Number:\n    \"\"\"Represents an integer and provides digit-based divisibility checks.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def getDigits(self) -> List[Digit]:\n        \"\"\"Extracts decimal digits from the number.\"\"\"\n        digits = []\n        num_str = str(self.value)\n        for char_digit in num_str:\n            digits.append(Digit(int(char_digit)))\n        return digits\n\n    def isDivisibleByDigits(self) -> bool:\n        \"\"\"Checks if the number is divisible by all its non-zero digits.\"\"\"\n        digits = self.getDigits()\n        for digit_obj in digits:\n            if digit_obj.isZero():\n                return False  # Number containing digit 0 is disqualified\n            if self.value % digit_obj.value != 0:\n                return False  # Not divisible by this digit\n        return True # All digits are non-zero and divide the number\nclass ResultList:\n    \"\"\"Collects qualifying integers and sorts them ascending.\"\"\"\n    def __init__(self):\n        self.values: List[int] = []\n\n    def append(self, value: int) -> None:\n        \"\"\"Adds a value to the list.\"\"\"\n        self.values.append(value)\n\n    def sortAscending(self) -> None:\n        \"\"\"Sorts the collected values in ascending order.\"\"\"\n        self.values.sort()\n\n    def to_list(self) -> List[int]:\n        \"\"\"Returns the internal list of values.\"\"\"\n        return self.values\nclass DivisibilityChecker:\n    \"\"\"Orchestrates validation, enumeration, and result collection.\"\"\"\n    def divisible_by_digits(self, startnum: int, endnum: int) -> List[int]:\n        \"\"\"Finds numbers in range where every number is divisible by its digits.\"\"\"\n        # Handle the inverted range rule as per design (returns empty list).\n        if startnum > endnum:\n            return []\n\n        # Proceed directly to evaluation as per constraints on validation.\n        return self._evaluateRange(startnum, endnum)\n\n    def _evaluateRange(self, startnum: int, endnum: int) -> List[int]:\n        \"\"\"Enumerates numbers in the range and checks divisibility.\"\"\"\n        result_list = ResultList()\n        # The range is inclusive [startnum, endnum]\n        for n in range(startnum, endnum + 1):\n            number_obj = Number(n)\n            if number_obj.isDivisibleByDigits():\n                result_list.append(n)\n\n        result_list.sortAscending()\n        return result_list.to_list()\ndef divisible_by_digits(startnum: int, endnum: int) -> List[int]:\n    \"\"\"\n    Finds numbers within a given range from startnum to endnum where\n    every number is divisible by every digit it contains.\n    \"\"\"\n    checker = DivisibilityChecker()\n    return checker.divisible_by_digits(startnum, endnum)"}
{"task_id": "Mbpp/751", "solution": "def check_min_heap(array: list[int]) -> bool:\n    \"\"\"\n    Checks if the given array represents a min-heap according to 0-based indexing.\n    A min-heap requires that each parent node's value is less than or equal to its children's values.\n    \"\"\"\n    n = len(array)\n\n    # Empty or single-element arrays are valid min-heaps.\n    if n <= 1:\n        return True\n\n    # Iterate only through parent nodes, from the first parent (index 0) up to the last parent.\n    # The last parent index is floor((n - 2) / 2).\n    for i in range((n - 2) // 2 + 1):\n        left_child_idx = 2 * i + 1\n        right_child_idx = 2 * i + 2\n\n        # Check if the parent is greater than its left child (if it exists).\n        if left_child_idx < n:\n            if array[i] > array[left_child_idx]:\n                return False\n\n        # Check if the parent is greater than its right child (if it exists).\n        if right_child_idx < n:\n            if array[i] > array[right_child_idx]:\n                return False\n\n    return True"}
{"task_id": "Mbpp/752", "solution": "from typing import int\ndef jacobsthal_num(n: int) -> int:\n    \"\"\"\n    Computes the nth Jacobsthal number using 0-based indexing.\n    Assumes n is a non-negative integer.\n    \"\"\"\n    if n == 0:\n        return 0\n    if n == 1:\n        return 1\n\n    # J(n) = J(n-1) + 2*J(n-2)\n    prev2 = 0  # Represents J(0)\n    prev1 = 1  # Represents J(1)\n    current = 0 # Initialize current for loop\n\n    for _ in range(2, n + 1):\n        current = prev1 + 2 * prev2\n        prev2, prev1 = prev1, current\n        \n    return current"}
