{"task_id": "Mbpp/602", "solution": "from dataclasses import dataclass\nfrom typing import Dict, Optional\nclass RepetitionFinder:\n    \"\"\"Encapsulates the algorithm to find the first repeated character.\"\"\"\n\n    def first_repeated_char(self, input_str_value: str) -> str:\n        \"\"\"\n        Core algorithm returning the character whose second occurrence index is smallest.\n        Returns a single-character string.\n        \"\"\"\n        input_string_obj = InputString(value=input_str_value)\n        repeated_chars_map = self._find_second_indices(input_string_obj)\n\n        if not repeated_chars_map:\n            # Handling for no repeated characters is left unspecified by design.\n            return \"\"\n\n        min_second_index = float('inf')\n        first_repeated_char_value = \"\"\n\n        for char_obj in repeated_chars_map.values():\n            if char_obj.secondIndex < min_second_index:\n                min_second_index = char_obj.secondIndex\n                first_repeated_char_value = char_obj.char\n\n        return first_repeated_char_value\n\n    def _find_second_indices(self, input_str: InputString) -> Dict[str, Character]:\n        \"\"\"Return mapping char -> Character for characters that repeat.\"\"\"\n        first_occurrences: Dict[str, int] = {}\n        repeated_chars: Dict[str, Character] = {}\n\n        for i, char in enumerate(input_str.value):\n            if char in first_occurrences:\n                # This character has been seen before; if it's not yet recorded as repeated, this is its second occurrence.\n                if char not in repeated_chars:\n                    repeated_chars[char] = Character(\n                        char=char,\n                        firstIndex=first_occurrences[char],\n                        secondIndex=i\n                    )\n            else:\n                # This is the first time seeing this character.\n                first_occurrences[char] = i\n        return repeated_chars\ndef first_repeated_char(input_string: str) -> str:\n    \"\"\"\n    Finds the first repeated character in the string based on the smallest second-occurrence index.\n    This module-level function delegates the core logic to the RepetitionFinder class.\n    \"\"\"\n    finder = RepetitionFinder()\n    return finder.first_repeated_char(input_string)"}
{"task_id": "Mbpp/604", "solution": "from dataclasses import dataclass\nfrom typing import List\n_DELIMITER: str = ' '\nclass WordList:\n    def __init__(self, words: List[Word]) -> None:\n        \"\"\"Initializes the WordList with a list of Word objects.\"\"\"\n        self.words = words\n\n    def reverse(self) -> None:\n        \"\"\"Reverses the order of words in the list in-place.\"\"\"\n        self.words.reverse()\n\n    def join(self, delim: str) -> str:\n        \"\"\"Joins the text of the words using the specified delimiter.\"\"\"\n        return delim.join([word.text for word in self.words])\ndef reverse_words(s: str) -> str:\n    \"\"\"\n    Reverses the order of words in a string, using space as a delimiter.\n    It orchestrates string splitting, word reversal, and rejoining.\n    \"\"\"\n    input_string = InputString(value=s)\n    words = input_string.split(_DELIMITER)\n    word_list = WordList(words=words)\n    word_list.reverse()\n    joined_string = word_list.join(_DELIMITER)\n    output_string = OutputString(value=joined_string)\n    return output_string.value"}
{"task_id": "Mbpp/605", "solution": "import math\ndef prime_num(n: int) -> bool:\n    \"\"\"\n    Checks if an integer is a prime number using trial division up to its square root.\n    Handles non-positive numbers and even numbers efficiently.\n    \"\"\"\n    if n <= 1:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n\n    limit = math.isqrt(n)\n    for i in range(3, limit + 1, 2):\n        if n % i == 0:\n            return False\n    return True"}
