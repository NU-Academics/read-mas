{"task_id": "Mbpp/142", "solution": "from typing import Any\nclass ListInput:\n    \"\"\"Wraps an underlying list and provides length and get accessors.\"\"\"\n    def __init__(self, items: list):\n        self.items = items\n\n    def length(self) -> int:\n        return len(self.items)\n\n    def get(self, index: int):\n        return self.items[index]\nclass ComparisonEngine:\n    \"\"\"Encapsulates equality logic using language value-equality semantics.\"\"\"\n    def all_equal(self, a: Any, b: Any, c: Any) -> bool:\n        return (a == b) and (b == c)\nclass CountResult:\n    \"\"\"Maintains a running integer count and provides an increment operation.\"\"\"\n    def __init__(self):\n        self.count = 0\n\n    def increment(self) -> None:\n        self.count += 1\nclass CountSamePair:\n    \"\"\"Orchestrates comparison across three ListInput instances.\"\"\"\n    def __init__(self, comparer: 'ComparisonEngine' = None, result: 'CountResult' = None):\n        self._comparer = comparer if comparer is not None else ComparisonEngine()\n        self._result = result if result is not None else CountResult()\n\n    def execute(self, l1: 'ListInput', l2: 'ListInput', l3: 'ListInput') -> int:\n        min_length = min(l1.length(), l2.length(), l3.length())\n        for i in range(min_length):\n            if self._comparer.all_equal(l1.get(i), l2.get(i), l3.get(i)):\n                self._result.increment()\n        return self._result.count\ndef count_samepair(l1, l2, l3) -> int:\n    \"\"\"\n    Counts items that are identical in the same position across three given lists.\n    Compares elements up to the length of the shortest list using value equality.\n    \"\"\"\n    li1 = ListInput(l1)\n    li2 = ListInput(l2)\n    li3 = ListInput(l3)\n    orchestrator = CountSamePair()\n    return orchestrator.execute(li1, li2, li3)"}
{"task_id": "Mbpp/145", "solution": "def max_Abs_Diff(sequence) -> float:\n    \"\"\"\n    Finds the maximum difference between any two elements in a given array.\n    The function validates input, handles edge cases, and computes min/max in a single pass.\n    \"\"\"\n    def validate(sequence) -> None:\n        \"\"\"\n        Validates the input sequence to ensure it's a list or tuple and all elements are int or float.\n        Raises TypeError for invalid inputs.\n        \"\"\"\n        if not isinstance(sequence, (list, tuple)):\n            raise TypeError(\"sequence must be a list or tuple\")\n        for element in sequence:\n            if not isinstance(element, (int, float)):\n                raise TypeError(\"all elements must be int or float\")\n\n    def compute_min_max(sequence) -> (float, float):\n        \"\"\"\n        Computes the minimum and maximum values in a sequence in a single pass.\n        Assumes the sequence has at least one element and all elements are numeric.\n        \"\"\"\n        min_v = float(sequence[0])\n        max_v = float(sequence[0])\n        for i in range(1, len(sequence)):\n            current_val = float(sequence[i])\n            if current_val < min_v:\n                min_v = current_val\n            if current_val > max_v:\n                max_v = current_val\n        return min_v, max_v\n\n    validate(sequence)\n\n    if len(sequence) < 2:\n        return 0.0\n\n    min_val, max_val = compute_min_max(sequence)\n    return float(abs(max_val - min_val))"}
{"task_id": "Mbpp/160", "solution": "import math\ndef find_solution(a: int, b: int, n: int) -> tuple[int, int] | None:\n    \"\"\"\n    Finds integers x and y satisfying ax + by = n.\n    Returns (x, y) or None if no solution exists.\n    \"\"\"\n    # 1. Validate inputs (simplified from design, assuming type hints handle basic checks,\n    # and not using Validator class explicitly as per no helper call constraint).\n    # The design specifies \"If any of a, b, n are not integer types, function returns None (no exception raised per provided design).\"\n    # However, given \"DO NOT call any helper that is not defined inline in your response\" and\n    # \"No class wrapper\", explicit Validator usage is omitted.\n    # The current problem setting implies that `a`, `b`, and `n` will be of type `int`\n    # when the function is called, otherwise, the return type `None` for non-integer inputs\n    # is a behavior of a separate validator component that is not to be included inline.\n    # We proceed with the assumption that inputs are integers.\n\n    # Helper for extended Euclidean algorithm (inline as per \"no helper that is not defined inline\" constraint)\n    def _extended_gcd(num1: int, num2: int) -> tuple[int, int, int]:\n        \"\"\"\n        Calculates gcd(num1, num2) and coefficients x, y such that num1*x + num2*y = gcd(num1, num2).\n        \"\"\"\n        x0, x1, y0, y1 = 1, 0, 0, 1\n        a_orig, b_orig = num1, num2\n\n        if num1 == 0:\n            return num2, 0, 1 # gcd, x, y (b*1 = b)\n        if num2 == 0:\n            return num1, 1, 0 # gcd, x, y (a*1 = a)\n\n        while num2 != 0:\n            quotient = num1 // num2\n            num1, num2 = num2, num1 % num2\n            x0, x1 = x1, x0 - quotient * x1\n            y0, y1 = y1, y0 - quotient * y1\n        return num1, x0, y0 # (gcd, x, y)\n\n    # 2. Handle zero-coefficient cases\n    if a == 0 and b == 0:\n        return (0, 0) if n == 0 else None\n    elif a == 0:\n        if n % b == 0:\n            return (0, n // b)\n        else:\n            return None\n    elif b == 0:\n        if n % a == 0:\n            return (n // a, 0)\n        else:\n            return None\n\n    # 3. Call extended_gcd(a, b)\n    g, x0, y0 = _extended_gcd(a, b)\n\n    # 4. Check divisibility\n    if n % g != 0:\n        return None\n\n    # 5. Compute scale and final x, y\n    scale = n // g\n    x = x0 * scale\n    y = y0 * scale\n\n    return (x, y)"}
{"task_id": "Mbpp/161", "solution": "def remove_elements(source_list: list, elements_to_remove: list) -> list:\n    \"\"\"Return a list with all elements from source_list that are present in elements_to_remove removed.\n\n    Behavior matches SRS FRs: preserves order, removes all occurrences, returns [] for empty source_list, returns a copy of source_list when elements_to_remove is empty, and uses runtime equality (==) for membership.\n    \"\"\"\n    if not source_list:\n        return []\n\n    if not elements_to_remove:\n        return source_list[:]\n\n    result = []\n    for item_source in source_list:\n        is_to_be_removed = False\n        for item_to_remove in elements_to_remove:\n            if item_source == item_to_remove:\n                is_to_be_removed = True\n                break\n        if not is_to_be_removed:\n            result.append(item_source)\n\n    return result"}
{"task_id": "Mbpp/166", "solution": "def find_even_pair(elements):\n    \"\"\"\n    Counts the number of pairs of integers in a list that xor to an even number.\n    The XOR of two numbers is even if and only if they have the same parity.\n    \"\"\"\n    size = len(elements)\n    if size < 2:\n        return 0\n\n    evens = 0\n    odds = 0\n\n    for v in elements:\n        if v % 2 == 0:\n            evens += 1\n        else:\n            odds += 1\n\n    # C(n, 2) = n * (n - 1) / 2\n    pairs_from_evens = (evens * (evens - 1)) // 2\n    pairs_from_odds = (odds * (odds - 1)) // 2\n\n    return pairs_from_evens + pairs_from_odds"}
{"task_id": "Mbpp/165", "solution": "def count_char_position(s: str) -> int:\n    \"\"\"\n    Counts characters in a string that match their English alphabet position (case-insensitive) at indices 0-25.\n    \"\"\"\n    \n    def _is_alpha(c: str) -> bool:\n        \"\"\"Returns True if the character is an English alphabet letter.\"\"\"\n        return 'a' <= c.lower() <= 'z'\n\n    def _alphabet_letter_at(pos: int) -> str:\n        \"\"\"Returns the lowercase English alphabet letter at the given 0-25 position.\"\"\"\n        return chr(ord('a') + pos)\n\n    def _matches_at(c: str, pos: int) -> bool:\n        \"\"\"Returns True if the character is alphabetic and matches the alphabet letter at its position.\"\"\"\n        return _is_alpha(c) and c.lower() == _alphabet_letter_at(pos)\n\n    upper = min(25, len(s) - 1)\n    count = 0\n\n    # Ensure iteration only happens if upper_bound is valid (e.g., for empty string, upper is -1, range becomes empty)\n    if upper >= 0:\n        for i in range(0, upper + 1):\n            if _matches_at(s[i], i):\n                count += 1\n    \n    return count"}
{"task_id": "Mbpp/162", "solution": "class SummationResult:\n    \"\"\"Encapsulates the integer summation result.\"\"\"\n    def __init__(self):\n        self._value: int = 0\n    def get_value(self) -> int:\n        return self._value\n    def set_value(self, v: int) -> None:\n        self._value = int(v)\nclass SeriesCalculator:\n    \"\"\"Generates series terms and aggregates their sum.\"\"\"\n    def sum_series(self, n: int) -> int:\n        terms = self._compute_terms(n)\n        result = SummationResult()\n        result.set_value(sum(terms))\n        return result.get_value()\n\n    def _compute_terms(self, n: int) -> list[int]:\n        i_max = n // 2\n        terms = []\n        for i in range(0, i_max + 1):\n            term = n - 2 * i\n            if term >= 0:\n                terms.append(term)\n        return terms\nclass InputValidator:\n    \"\"\"Validates input for type and non-negativity.\"\"\"\n    def is_integer(self, value) -> bool:\n        return isinstance(value, int) and not isinstance(value, bool)\n    def is_non_negative(self, n: int) -> bool:\n        return n >= 0\ndef sum_series(n: int) -> int:\n    \"\"\"\n    Calculates the sum of the series (n - 2*i) for i=0 to n//2,\n    including terms down to zero.\n    \"\"\"\n    validator = InputValidator()\n    if not validator.is_integer(n) or not validator.is_non_negative(n):\n        raise ValueError(\"Input must be a non-negative integer\")\n    \n    calc = SeriesCalculator()\n    return calc.sum_series(n)"}
{"task_id": "Mbpp/167", "solution": "from typing import Any\ndef _compute_next_power_of_two(n: int) -> int:\n    \"\"\"Computes the smallest power of 2 greater than or equal to n.\"\"\"\n    if n == 0:\n        return 1\n    \n    power = 1\n    while power < n:\n        power <<= 1\n    return power\ndef next_power_of_2(n: int) -> int:\n    \"\"\"\n    Finds the smallest power of 2 greater than or equal to n.\n    Input must be a non-negative integer.\n    \"\"\"\n    _validate_non_negative_integer(n)\n    return _compute_next_power_of_two(n)"}
