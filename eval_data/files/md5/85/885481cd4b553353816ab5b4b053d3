{"task_id": "Mbpp/300", "solution": "import math\ndef compute_by_binomial(n: int) -> int:\n    \"\"\"Computes the central binomial coefficient C(2n, n) using math.comb.\"\"\"\n    return math.comb(2 * n, n)\ndef count_binary_seq(n: int) -> int:\n    \"\"\"\n    Finds the count of binary sequences of length 2n such that the sum of the\n    first n bits is the same as the sum of the last n bits.\n    \"\"\"\n    validate(n)\n\n    if n == 0:\n        return 1\n\n    return compute_by_binomial(n)"}
{"task_id": "Mbpp/299", "solution": "import collections\nfrom typing import Iterable, Tuple, Union, Dict, List\ndef max_aggregate(items: Iterable[Tuple[str, Union[int, float]]]) -> Tuple[str, Union[int, float]]:\n    \"\"\"\n    Calculates the maximum aggregate from the list of tuples, applying tie-breaking by first occurrence.\n    Raises ValueError for empty or invalid input items.\n    \"\"\"\n    if not isinstance(items, Iterable):\n        raise ValueError(\"Input 'items' must be an iterable.\")\n\n    validated_items: List[Tuple[str, Union[int, float]]] = []\n    # Convert iterable to list and validate items in a single pass to preserve order and catch errors early.\n    for i, item in enumerate(items):\n        if not (isinstance(item, tuple) and len(item) == 2):\n            raise ValueError(f\"Item at index {i} must be a 2-element tuple, got: {item}\")\n        \n        name, value = item\n        if not isinstance(name, str):\n            raise ValueError(f\"Name in item at index {i} must be a string, got: {name}\")\n        if not isinstance(value, (int, float)):\n            raise ValueError(f\"Value in item at index {i} must be an int or float, got: {value}\")\n        \n        validated_items.append((name, value))\n\n    if not validated_items:\n        raise ValueError(\"Input 'items' cannot be empty.\")\n\n    totals: Dict[str, Union[int, float]] = collections.defaultdict(int)\n    first_occurrence_index: Dict[str, int] = {}\n\n    for index, (name, value) in enumerate(validated_items):\n        if name not in first_occurrence_index:\n            first_occurrence_index[name] = index\n        totals[name] += value\n\n    # After aggregation, determine the maximum total and apply tie-breaker.\n    if not totals:\n        # This case should ideally be caught by 'if not validated_items' but provides extra robustness.\n        raise ValueError(\"No aggregates could be calculated from the provided items.\")\n\n    max_total: Union[int, float] = -float('inf')\n    for total_value in totals.values():\n        if total_value > max_total:\n            max_total = total_value\n\n    candidate_names: List[str] = []\n    for name, total_value in totals.items():\n        if total_value == max_total:\n            candidate_names.append(name)\n\n    # Apply tie-breaker: choose the name with the smallest first occurrence index among candidates.\n    winning_name = min(candidate_names, key=lambda n: first_occurrence_index[n])\n    \n    return (winning_name, totals[winning_name])"}
{"task_id": "Mbpp/301", "solution": "def dict_depth(input_dictionary: dict) -> int:\n    \"\"\"Compute maximum nesting depth of dictionaries in input_dictionary.\n    Preconditions: input_dictionary is a dict (caller responsibility).\n    Returns: integer depth (top-level dictionary is depth 1).\n    \"\"\"\n\n    def _compute_depth_for_value(value, current_depth: int) -> int:\n        \"\"\"Return deepest depth reachable from value. Returns 0 if value is not a dict.\"\"\"\n        if not isinstance(value, dict):\n            return 0\n        \n        max_sub_depth = 0\n        for sub_value in value.values():\n            max_sub_depth = max(max_sub_depth, _compute_depth_for_value(sub_value, current_depth + 1))\n        \n        return max(current_depth, max_sub_depth)\n\n    if not input_dictionary:\n        return 1 # An empty dictionary itself counts as depth 1\n\n    max_overall_depth = 1 # Top-level dictionary counts as depth 1\n    for value in input_dictionary.values():\n        max_overall_depth = max(max_overall_depth, _compute_depth_for_value(value, 2))\n    \n    return max_overall_depth"}
{"task_id": "Mbpp/305", "solution": "from typing import List, Tuple\ndef _split_on_whitespace(s: str) -> List[str]:\n    \"\"\"Tokenizes a string using standard Python whitespace splitting.\"\"\"\n    return s.split()\ndef _starts_with_p(word: str) -> bool:\n    \"\"\"Predicate testing if a word starts with 'p' or 'P' (case-insensitive).\"\"\"\n    return bool(word) and word[0].lower() == 'p'\nclass StartWithP:\n    \"\"\"Stateless processor for finding words starting with 'p' or 'P'.\"\"\"\n    def start_withp(self, strings: List[str]) -> Tuple[str, str]:\n        \"\"\"Scans input strings for the first two words starting with 'p' or 'P'.\"\"\"\n        p_words: List[str] = []\n        for s in strings:\n            words = _split_on_whitespace(s)\n            for word in words:\n                if _starts_with_p(word):\n                    p_words.append(word)\n                    if len(p_words) == 2:\n                        return tuple(p_words)\n        # Per design, callers/tests validate precondition that two matches exist.\n        return tuple(p_words)\ndef start_withp(strings: List[str]) -> Tuple[str, str]:\n    \"\"\"\n    Returns two words from a list of strings that start with the letter 'p' or 'P'.\n    \"\"\"\n    processor = StartWithP()\n    return processor.start_withp(strings)"}
{"task_id": "Mbpp/309", "solution": "def maximum(a, b):\n    \"\"\"Return the larger of two numeric inputs a and b. If equal, return either value.\"\"\"\n    return a if a >= b else b"}
{"task_id": "Mbpp/306", "solution": "class IndexBounds:\n    def __init__(self, n: int, i: int, k: int) -> None:\n        self.n = n\n        self.i = i\n        self.k = k\n\n    def validate(self, arr: list[int]) -> None:\n        if self.n != len(arr):\n            raise ValueError(\"n must equal len(arr)\")\n        if not (0 <= self.i < self.n):\n            raise ValueError(\"i out of bounds\")\n        if not (0 <= self.k < self.n):\n            raise ValueError(\"k out of bounds\")\n        if not (self.k > self.i):\n            raise ValueError(\"k must be greater than i\")\nclass SubsequenceComputer:\n    def computeMaxPrefixSums(self, arr: list[int], i: int) -> list[int]:\n        \"\"\"Computes the maximum sum of an increasing subsequence ending at each index j <= i.\"\"\"\n        dp = [arr[j] for j in range(i + 1)]\n        for j in range(i + 1):\n            for m in range(j):\n                if arr[m] < arr[j] and dp[m] + arr[j] > dp[j]:\n                    dp[j] = dp[m] + arr[j]\n        return dp\n\n    def max_sum_increasing_subseq(self, arr: list[int], n: int, i: int, k: int) -> int:\n        \"\"\"Finds the maximum sum of an increasing subsequence from arr[0..i] followed by arr[k].\"\"\"\n        dp = self.computeMaxPrefixSums(arr, i)\n        \n        candidates = []\n        for j in range(i + 1):\n            if arr[j] < arr[k]:\n                candidates.append(dp[j])\n        \n        if not candidates:\n            return arr[k]\n        \n        return max(candidates) + arr[k]\ndef max_sum_increasing_subseq(arr: list[int], n: int, i: int, k: int) -> int:\n    \"\"\"\n    Finds the maximum sum of an increasing subsequence from arr[0..i] ending with arr[k], where k > i.\n    Validates inputs and delegates computation to an internal SubsequenceComputer.\n    \"\"\"\n    IndexBounds(n, i, k).validate(arr)\n    return SubsequenceComputer().max_sum_increasing_subseq(arr, n, i, k)"}
{"task_id": "Mbpp/310", "solution": "def string_to_tuple(s: str) -> tuple:\n    \"\"\"Return a tuple of characters from s after removing spaces, tabs, and newlines.\n\n    Behavior per SRS:\n    - Accept exactly one parameter (s) of type string.\n    - Remove whitespace characters: ' ', '\\\\t', '\\\\n'.\n    - Treat all remaining characters (letters, digits, punctuation, symbols) as tuple elements, preserving order.\n    - If input is empty or contains only the specified whitespace characters, return empty tuple ().\n    \"\"\"\n    return tuple(ch for ch in s if ch not in (' ', '\\t', '\\n'))"}
{"task_id": "Mbpp/308", "solution": "from typing import List, Union\nclass Pair:\n    \"\"\"Models an ordered pair (a, b).\"\"\"\n    def __init__(self, a: Union[int, float], b: Union[int, float]):\n        self.a = a\n        self.b = b\nclass Product:\n    \"\"\"Models a product produced by multiplying a Pair.\"\"\"\n    def __init__(self, value: Union[int, float], source: Pair):\n        self.value = value\n        self.source = source\ndef _is_number(value) -> bool:\n    \"\"\"Checks if a value is an int or float.\"\"\"\n    return isinstance(value, (int, float))\nclass Validator:\n    \"\"\"Validates list inputs for numeric elements and k for integer type.\"\"\"\n    def validateLists(self, list1: List[Union[int, float]], list2: List[Union[int, float]]):\n        if not isinstance(list1, list) or not isinstance(list2, list):\n            raise ValueError(\"Inputs must be lists.\")\n        for item in list1:\n            if not _is_number(item):\n                raise ValueError(f\"List1 contains non-numeric element: {item}\")\n        for item in list2:\n            if not _is_number(item):\n                raise ValueError(f\"List2 contains non-numeric element: {item}\")\n\n    def validateK(self, k: int):\n        if not isinstance(k, int):\n            raise ValueError(\"k must be an integer.\")\ndef compute_pairs(list1: List[Union[int, float]], list2: List[Union[int, float]]) -> List[Pair]:\n    \"\"\"Generates Cartesian product pairs.\"\"\"\n    pairs = []\n    for a in list1:\n        for b in list2:\n            pairs.append(Pair(a, b))\n    return pairs\ndef compute_products(pairs: List[Pair]) -> List[Product]:\n    \"\"\"Computes product for each Pair.\"\"\"\n    products = []\n    for pair in pairs:\n        products.append(Product(pair.a * pair.b, pair))\n    return products\ndef sort_descending(products: List[Product]) -> List[Product]:\n    \"\"\"Sorts products by value descending.\"\"\"\n    return sorted(products, key=lambda p: p.value, reverse=True)\ndef select_top_k(sorted_products: List[Product], k: int) -> List[Union[int, float]]:\n    \"\"\"Returns top k numeric values from sorted products.\"\"\"\n    if k <= 0:\n        return []\n    return [p.value for p in sorted_products[:k]]\ndef large_product(list1: List[Union[int, float]], list2: List[Union[int, float]], k: int) -> List[Union[int, float]]:\n    \"\"\"\n    Finds the specified number of largest products from two given lists,\n    selecting one factor from each list.\n    \"\"\"\n    validator = Validator()\n    validator.validateLists(list1, list2)\n    validator.validateK(k)\n\n    if not list1 or not list2 or k <= 0:\n        return []\n\n    pairs = compute_pairs(list1, list2)\n    products = compute_products(pairs)\n    sorted_products = sort_descending(products)\n    \n    result_values = select_top_k(sorted_products, k)\n    \n    return result_values"}
{"task_id": "Mbpp/388", "solution": "def highest_Power_of_2(n) -> int:\n    \"\"\"Validate n and return largest power of two <= n, or raise ValueError.\"\"\"\n    if not isinstance(n, int):\n        raise ValueError(\"n must be an integer\")\n    if n < 1:\n        raise ValueError(\"n must be >= 1\")\n\n    # For any n >= 1, the highest power of 2 less than or equal to n\n    # is 2 raised to the power of (n's bit length - 1).\n    # For example, if n=10 (binary 1010), its bit length is 4.\n    # The result is 2^(4-1) = 2^3 = 8.\n    # If n=8 (binary 1000), its bit length is 4.\n    # The result is 2^(4-1) = 2^3 = 8.\n    return 1 << (n.bit_length() - 1)"}
{"task_id": "Mbpp/389", "solution": "def find_lucas(n):\n    \"\"\"\n    Computes the n'th Lucas number.\n    Input `n` must be a non-negative integer.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"Input must be an integer.\")\n    if n < 0:\n        raise ValueError(\"Input must be a non-negative integer.\")\n\n    if n == 0:\n        return 2\n    elif n == 1:\n        return 1\n    else:\n        # L0 = 2, L1 = 1\n        a, b = 2, 1\n        # Compute iteratively for n >= 2\n        for _ in range(2, n + 1):\n            a, b = b, a + b\n        return b"}
{"task_id": "Mbpp/312", "solution": "import math\ndef volume_cone(radius: float, height: float) -> float:\n    \"\"\"Compute cone volume V = (1/3) * pi * r^2 * h and return as float.\"\"\"\n    volume = (1/3) * math.pi * (radius ** 2) * height\n    return volume"}
{"task_id": "Mbpp/311", "solution": "def set_left_most_unset_bit(n):\n    \"\"\"Set the most-significant zero bit in integer n and return the result.\n\n    Raises:\n        TypeError: if n is not a Python int.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an int\")\n\n    if n == 0:\n        return 1\n\n    # Find the position of the most significant bit (MSB).\n    # For positive n, n.bit_length() gives the count of bits needed to represent n.\n    # The MSB position is (count - 1).\n    msb_pos = n.bit_length() - 1\n\n    # Iterate from the MSB position downwards to find the most-significant zero bit.\n    for i in range(msb_pos, -1, -1):\n        # Check if the i-th bit is 0.\n        # This is true if `n` bitwise ANDed with `(1 << i)` results in 0.\n        if not (n & (1 << i)):\n            # Found the left-most unset bit, set it to 1 and return.\n            return n | (1 << i)\n\n    # If the loop completes, it means all bits from msb_pos down to 0 are 1.\n    # In this case, extend the number by setting the next higher-order bit.\n    return n | (1 << (msb_pos + 1))"}
{"task_id": "Mbpp/390", "solution": "from typing import Any, List\ndef _format_element(element: Any, format_string: str) -> str:\n    \"\"\"Converts an element to its string representation and applies the format string.\"\"\"\n    return format_string.format(str(element))\ndef add_string(input_list: List[Any], format_string: str) -> List[str]:\n    \"\"\"Return a new list where each element of input_list is formatted into format_string using {0}.\n    Behavior: converts non-strings via str(), preserves order and cardinality, returns [] for empty input_list.\"\"\"\n    return [_format_element(e, format_string) for e in input_list]"}
{"task_id": "Mbpp/391", "solution": "from typing import List, Dict, Any\ndef convert_list_dictionary(keys: List[str], names: List[str], values: List[Any]) -> List[Dict[str, Dict[str, Any]]]:\n    \"\"\"\n    Convert three parallel lists into a list of nested dictionaries.\n\n    Raises:\n        ValueError: If the three input lists are not the same length.\n    \"\"\"\n    if not (len(keys) == len(names) == len(values)):\n        raise ValueError(\"Input lists must be the same length\")\n\n    result = []\n    for i in range(len(keys)):\n        result.append({keys[i]: {names[i]: values[i]}})\n    return result"}
{"task_id": "Mbpp/395", "solution": "from typing import Optional, Dict\ndef _build_frequency_map(s: str) -> Dict[str, int]:\n    \"\"\"Builds a frequency map for characters in the input string.\"\"\"\n    frequency = {}\n    for char in s:\n        frequency[char] = frequency.get(char, 0) + 1\n    return frequency\ndef first_non_repeating_character(s: str) -> Optional[str]:\n    \"\"\"Finds the first non-repeated character in a given string.\"\"\"\n    frequency_map = _build_frequency_map(s)\n    for char in s:\n        if frequency_map[char] == 1:\n            return char\n    return None"}
