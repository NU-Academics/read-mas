{"task_id": "Mbpp/84", "solution": "from dataclasses import dataclass\nfrom typing import List\nclass RecurrenceRule:\n    \"\"\"Defines the Newman\u2013Conway recurrence relation's constants and formula.\"\"\"\n    A1: int = 1\n    A2: int = 1\n    formula: str = \"a(1)=1; a(2)=1; a(n)=a(a(n-1))+a(n-a(n-1))\"\nclass SequenceFunction:\n    \"\"\"Computes terms of the Newman\u2013Conway sequence with caching.\"\"\"\n    def __init__(self) -> None:\n        \"\"\"Initializes the cache with base cases a(1) and a(2).\"\"\"\n        # Cache uses 1-based indexing; index 0 is unused.\n        self._cache: List[int] = [0, RecurrenceRule.A1, RecurrenceRule.A2]\n        self._rule = RecurrenceRule # Store for consistency with design, though constants are class-level\n\n    def sequence(self, n: int) -> int:\n        \"\"\"Returns the nth Newman\u2013Conway term, assuming n is a valid positive integer.\"\"\"\n        # Per prompt's \"DO NOT add isinstance() checks or raise exceptions\",\n        # explicit validation and error handling as per design are omitted here.\n\n        if n < len(self._cache):\n            return self._cache[n]\n        else:\n            # Iteratively compute and cache terms up to n if not already present.\n            self._compute_term(n)\n            return self._cache[n]\n\n    def _compute_term(self, n: int) -> int:\n        \"\"\"Iteratively computes and caches terms up to n to avoid deep recursion.\"\"\"\n        # Base cases a(1) and a(2) are already handled in __init__.\n        # 'i' will start from 3, as len(self._cache) is 3 after initialization.\n        for i in range(len(self._cache), n + 1):\n            # Recurrence for n > 2: a(n) = a(a(n-1)) + a(n-a(n-1))\n            a_n_minus_1_val = self._cache[i - 1]\n            term1 = self._cache[a_n_minus_1_val]\n            term2 = self._cache[i - a_n_minus_1_val]\n            self._cache.append(term1 + term2)\n        return self._cache[n]\n_singleton = SequenceFunction()\ndef sequence(n: int) -> int:\n    \"\"\"Public API: returns the nth Newman\u2013Conway term using a cached computation.\"\"\"\n    # Delegates computation to a module-level SequenceFunction singleton.\n    return _singleton.sequence(n)"}
{"task_id": "Mbpp/86", "solution": "class ValidationError(Exception):\n    def __init__(self, message: str) -> None:\n        self.message = message\n        super().__init__(message)\ndef centered_hexagonal_number(n) -> int:\n    \"\"\"Validate n and return nth centered hexagonal number.\n\n    Raises:\n        ValidationError: if n is not a positive integer (n >= 1)\n    \"\"\"\n    if not isinstance(n, int) or n < 1:\n        raise ValidationError('n must be a positive integer (n >= 1)')\n    result = 3 * n * (n - 1) + 1\n    return int(result)"}
{"task_id": "Mbpp/87", "solution": "from typing import Dict\nclass MergeOperation:\n    \"\"\"\n    Encapsulates the merge algorithm for three dictionaries, resolving key conflicts by precedence.\n    \"\"\"\n    def merge(self, dict1: Dict[str, str], dict2: Dict[str, str], dict3: Dict[str, str]) -> Dict[str, str]:\n        \"\"\"\n        Merges three dictionaries, with precedence dict1 > dict2 > dict3 for duplicate keys.\n        \"\"\"\n        merged = {}\n        for key, value in dict1.items():\n            merged[key] = value\n        for key, value in dict2.items():\n            if key not in merged:\n                merged[key] = value\n        for key, value in dict3.items():\n            if key not in merged:\n                merged[key] = value\n        return merged\ndef merge_dictionaries_three(dict1: Dict[str, str], dict2: Dict[str, str], dict3: Dict[str, str]) -> Dict[str, str]:\n    \"\"\"\n    Merges three dictionaries into a single dictionary, preferring values from earlier dictionaries for duplicate keys.\n    \"\"\"\n    op = MergeOperation()\n    return op.merge(dict1, dict2, dict3)"}
