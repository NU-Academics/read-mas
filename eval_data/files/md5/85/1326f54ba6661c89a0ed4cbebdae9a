{"task_id": "HumanEval/40", "solution": "def triples_sum_to_zero(l: list):\n    \"\"\"\n    triples_sum_to_zero takes a list of integers as an input.\n    it returns True if there are three distinct elements in the list that\n    sum to zero, and False otherwise.\n\n    >>> triples_sum_to_zero([1, 3, 5, 0])\n    False\n    >>> triples_sum_to_zero([1, 3, -2, 1])\n    True\n    >>> triples_sum_to_zero([1, 2, 3, 7])\n    False\n    >>> triples_sum_to_zero([2, 4, -5, 3, 9, 7])\n    True\n    >>> triples_sum_to_zero([1])\n    False\n    \"\"\"\n    n = len(l)\n    if n < 3:\n        return False\n\n    # Sort the list to use the two-pointer technique.\n    sorted_l = sorted(l)\n\n    for i in range(n - 2):\n        # Skip duplicate elements for the first pointer to avoid redundant calculations.\n        if i > 0 and sorted_l[i] == sorted_l[i-1]:\n            continue\n\n        left, right = i + 1, n - 1\n        while left < right:\n            current_sum = sorted_l[i] + sorted_l[left] + sorted_l[right]\n\n            if current_sum == 0:\n                return True\n            elif current_sum < 0:\n                left += 1\n            else: # current_sum > 0\n                right -= 1\n    return False"}
{"task_id": "HumanEval/39", "solution": "def prime_fib(n: int):\n    \"\"\"\n    prime_fib returns n-th number that is a Fibonacci number and it's also prime.\n    >>> prime_fib(1)\n    2\n    >>> prime_fib(2)\n    3\n    >>> prime_fib(3)\n    5\n    >>> prime_fib(4)\n    13\n    >>> prime_fib(5)\n    89\n    \"\"\"\n\n    def is_prime(num: int) -> bool:\n        \"\"\"Checks if a number is prime using trial division.\"\"\"\n        if num < 2:\n            return False\n        if num == 2:\n            return True\n        if num % 2 == 0:\n            return False\n        i = 3\n        while i * i <= num:\n            if num % i == 0:\n                return False\n            i += 2\n        return True\n\n    prime_fib_count = 0\n    prev_prev_fib = 0  # Represents F(k-2)\n    prev_fib = 1       # Represents F(k-1)\n\n    # First, handle the initial Fibonacci numbers (0 and 1)\n    # F_0 = 0\n    current_fib = prev_prev_fib\n    if current_fib > 1 and is_prime(current_fib):\n        prime_fib_count += 1\n        if prime_fib_count == n:\n            return current_fib\n\n    # F_1 = 1\n    current_fib = prev_fib\n    if current_fib > 1 and is_prime(current_fib):\n        prime_fib_count += 1\n        if prime_fib_count == n:\n            return current_fib\n\n    # Generate subsequent Fibonacci numbers starting from F_2\n    while True:\n        next_fib = prev_prev_fib + prev_fib  # Calculate F_k = F(k-2) + F(k-1)\n        prev_prev_fib = prev_fib             # Update F(k-2) to F(k-1)\n        prev_fib = next_fib                  # Update F(k-1) to F_k (which is next_fib)\n        current_fib = next_fib\n\n        if current_fib > 1 and is_prime(current_fib):\n            prime_fib_count += 1\n            if prime_fib_count == n:\n                return current_fib"}
