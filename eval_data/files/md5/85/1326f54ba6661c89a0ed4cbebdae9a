{"task_id": "HumanEval/29", "solution": "from typing import List\n\n\ndef filter_by_prefix(strings: List[str], prefix: str) -> List[str]:\n    \"\"\" Filter an input list of strings only for ones that start with a given prefix.\n    >>> filter_by_prefix([], 'a')\n    []\n    >>> filter_by_prefix(['abc', 'bcd', 'cde', 'array'], 'a')\n    ['abc', 'array']\n    \"\"\"\n    if strings is None:\n        strings = []\n    if prefix is None:\n        prefix = \"\"\n\n    return [s for s in strings if s.startswith(prefix)]"}
{"task_id": "HumanEval/31", "solution": "def is_prime(n):\n    \"\"\"Return true if a given number is prime, and false otherwise.\n    >>> is_prime(6)\n    False\n    >>> is_prime(101)\n    True\n    >>> is_prime(11)\n    True\n    >>> is_prime(13441)\n    True\n    >>> is_prime(61)\n    True\n    >>> is_prime(4)\n    False\n    >>> is_prime(1)\n    False\n    \"\"\"\n    if n <= 1:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n    i = 3\n    while i * i <= n:\n        if n % i == 0:\n            return False\n        i += 2\n    return True"}
{"task_id": "HumanEval/34", "solution": "def unique(l: list):\n    \"\"\"Return sorted unique elements in a list\n    >>> unique([5, 3, 5, 2, 3, 3, 9, 0, 123])\n    [0, 2, 3, 5, 9, 123]\n    \"\"\"\n    # Use a set to efficiently get unique elements, then sort them.\n    return sorted(list(set(l)))"}
{"task_id": "HumanEval/35", "solution": "class EmptyListError(Exception):\n    \"\"\"Custom exception raised when an operation requires a non-empty list but receives an empty one.\"\"\"\n    def __init__(self, message: str = \"Input list cannot be empty.\"):\n        self.message = message\n        super().__init__(self.message)\n\ndef max_element(l: list):\n    \"\"\"Return maximum element in the list.\n    >>> max_element([1, 2, 3])\n    3\n    >>> max_element([5, 3, -5, 2, -3, 3, 9, 0, 123, 1, -10])\n    123\n    \"\"\"\n    if not l:\n        raise EmptyListError(\"Input list cannot be empty.\")\n\n    max_val = l[0]\n    for element in l[1:]:\n        if element > max_val:\n            max_val = element\n    return max_val"}
{"task_id": "HumanEval/33", "solution": "import collections\ndef sort_third(l: list):\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the indicies that are not divisible by three, while its values at the indicies that are divisible by three are equal\n    to the values of the corresponding indicies of l, but sorted.\n    >>> sort_third([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_third([5, 6, 3, 4, 8, 9, 2])\n    [2, 6, 3, 4, 8, 9, 5]\n    \"\"\"\n    if not l:\n        return []\n\n    # Extract elements and their original indices that are divisible by three\n    divisible_elements = []\n    divisible_indices = []\n    for i, item in enumerate(l):\n        if i % 3 == 0:\n            divisible_elements.append(item)\n            divisible_indices.append(i)\n\n    # Sort the extracted elements\n    sorted_divisible_elements = sorted(divisible_elements)\n\n    # Create a new list as a copy of the original\n    result_list = list(l)\n\n    # Place the sorted elements back into their original divisible-by-three indices\n    sorted_elements_iter = iter(sorted_divisible_elements)\n    for idx in divisible_indices:\n        result_list[idx] = next(sorted_elements_iter)\n\n    return result_list"}
{"task_id": "HumanEval/36", "solution": "def fizz_buzz(n: int):\n    \"\"\"Return the number of times the digit 7 appears in integers less than n which are divisible by 11 or 13.\n    >>> fizz_buzz(50)\n    0\n    >>> fizz_buzz(78)\n    2\n    >>> fizz_buzz(79)\n    3\n    \"\"\"\n    total_sevens_count = 0\n    for i in range(1, n):\n        if (i % 11 == 0) or (i % 13 == 0):\n            total_sevens_count += str(i).count('7')\n    return total_sevens_count"}
{"task_id": "HumanEval/32", "solution": "import math\n\n\ndef poly(xs: list, x: float):\n    \"\"\"\n    Evaluates polynomial with coefficients xs at point x.\n    return xs[0] + xs[1] * x + xs[1] * x^2 + .... xs[n] * x^n\n    \"\"\"\n    return sum([coeff * math.pow(x, i) for i, coeff in enumerate(xs)])\n\n\ndef find_zero(xs: list):\n    \"\"\" xs are coefficients of a polynomial.\n    find_zero find x such that poly(x) = 0.\n    find_zero returns only only zero point, even if there are many.\n    Moreover, find_zero only takes list xs having even number of coefficients\n    and largest non zero coefficient as it guarantees\n    a solution.\n    >>> round(find_zero([1, 2]), 2) # f(x) = 1 + 2x\n    -0.5\n    >>> round(find_zero([-6, 11, -6, 1]), 2) # (x - 1) * (x - 2) * (x - 3) = -6 + 11x - 6x^2 + x^3\n    1.0\n    \"\"\"\n    DEFAULT_TOLERANCE = 1e-6\n    MAX_ITERATIONS = 1000\n    _SMALL_DELTA = 1e-7\n\n    if len(xs) % 2 != 0:\n        raise ValueError(\"find_zero only takes polynomials with an even number of coefficients.\")\n    if not xs:\n        raise ValueError(\"Polynomial must have coefficients to find a zero.\")\n\n    def _derivative(coefficients: list, val: float) -> float:\n        \"\"\"Calculates the numerical derivative of the polynomial at point val.\"\"\"\n        f_x_plus_delta = poly(coefficients, val + _SMALL_DELTA)\n        f_x_minus_delta = poly(coefficients, val - _SMALL_DELTA)\n        return (f_x_plus_delta - f_x_minus_delta) / (2 * _SMALL_DELTA)\n\n    initial_guess = 0.0\n    if len(xs) > 1 and xs[1] != 0:\n        initial_guess = -xs[0] / xs[1]\n\n    x = initial_guess\n    for _ in range(MAX_ITERATIONS):\n        f_x = poly(xs, x)\n        df_x = _derivative(xs, x)\n\n        if abs(df_x) < DEFAULT_TOLERANCE * 1e-2:\n            raise RuntimeError(\"Derivative too small, cannot converge to a zero.\")\n\n        next_x = x - (f_x / df_x)\n\n        if abs(next_x - x) < DEFAULT_TOLERANCE:\n            return next_x\n        x = next_x\n    raise RuntimeError(f\"Failed to converge to a zero after {MAX_ITERATIONS} iterations.\")"}
{"task_id": "HumanEval/38", "solution": "def decode_cyclic(s: str):\n    \"\"\"\n    takes as input string encoded with encode_cyclic function. Returns decoded string.\n    \"\"\"\n    # split string to groups. Each of length 3.\n    groups = [s[(3 * i):min((3 * i + 3), len(s))] for i in range((len(s) + 2) // 3)]\n    # reverse cycle elements in each group. Unless group has fewer elements than 3.\n    groups = [(group[-1] + group[:-1]) if len(group) == 3 else group for group in groups]\n    return \"\".join(groups)"}
{"task_id": "HumanEval/37", "solution": "def sort_even(l: list):\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the odd indicies, while its values at the even indicies are equal\n    to the values of the even indicies of l, but sorted.\n    >>> sort_even([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_even([5, 6, 3, 4])\n    [3, 6, 5, 4]\n    \"\"\"\n    if not l:\n        return []\n\n    even_elements = [l[i] for i in range(0, len(l), 2)]\n    even_elements.sort()\n\n    result_list = l[:]\n    even_idx_counter = 0\n    for i in range(0, len(l), 2):\n        result_list[i] = even_elements[even_idx_counter]\n        even_idx_counter += 1\n            \n    return result_list"}
{"task_id": "HumanEval/41", "solution": "def car_race_collision(n: int):\n    \"\"\"\n    Imagine a road that's a perfectly straight infinitely long line.\n    n cars are driving left to right;  simultaneously, a different set of n cars\n    are driving right to left.   The two sets of cars start out being very far from\n    each other.  All cars move in the same speed.  Two cars are said to collide\n    when a car that's moving left to right hits a car that's moving right to left.\n    However, the cars are infinitely sturdy and strong; as a result, they continue moving\n    in their trajectory as if they did not collide.\n\n    This function outputs the number of such collisions.\n    \"\"\"\n    return n * n"}
