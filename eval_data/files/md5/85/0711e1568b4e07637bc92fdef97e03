:\n    \"\"\"Detects contiguous runs of U+0020 in the input string.\"\"\"\n    def detectRuns(self, text: str) -> List[SpaceRun]:\n        runs: List[SpaceRun] = []\n        i = 0\n        while i < len(text):\n            if text[i] == ' ':\n                start_index = i\n                length = 0\n                while i < len(text) and text[i] == ' ':\n                    length += 1\n                    i += 1\n                runs.append(SpaceRun(start_index, length))\n            else:\n                i += 1\n        return runs\nclass FixSpacesFunction:\n    \"\"\"Orchestrates detection and applies replacement rules to produce transformed output.\"\"\"\n    def transform(self, text: str) -> str:\n        detector = SpaceRunDetector()\n        space_runs = detector.detectRuns(text)\n\n        result_chars: List[str] = []\n        text_index = 0\n        run_index = 0\n\n        while text_index < len(text):\n            if run_index < len(space_runs) and text_index == space_runs[run_index].startIndex:\n                # We are at the start of a detected space run\n                current_run = space_runs[run_index]\n                if current_run.length >= 3:\n                    result_chars.append('-')\n                else: # length is 1 or 2\n                    for _ in range(current_run.length):\n                        result_chars.append('_')\n                \n                text_index += current_run.length # Advance past the entire run\n                run_index += 1\n            else:\n                # Not part of a space run, append the character as is\n                result_chars.append(text[text_index])\n                text_index += 1\n        \n        return \"\".join(result_chars)\ndef fix_spaces(text):\n    \"\"\"\n    Given a string text, replace all spaces in it with underscores, \n    and if a string has more than 2 consecutive spaces, \n    then replace all consecutive spaces with - \n    \n    fix_spaces(\"Example\") == \"Example