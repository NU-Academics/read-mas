rue\n    \"\"\"\n    validate_input(l)\n    return bool(is_increasing(l) or is_decreasing(l))", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[[1, 2, 4, 10]]], "plus_fail_tests": [[[10, 9, 8, 7, 6]]]}], "HumanEval/61": [{"task_id": "HumanEval/61", "solution": "class BracketString:\n    \"\"\"Represents the input parentheses string and provides length and character access.\"\"\"\n    def __init__(self, value: str) -> None:\n        self.value = value\n\n    def length(self) -> int:\n        return len(self.value)\n\n    def char_at(self, index: int) -> str:\n        return self.value[index]\nclass StackCounter:\n    \"\"\"Tracks the count of unmatched opening parentheses.\"\"\"\n    def __init__(self) -> None:\n        self.count = 0\n\n    def push(self) -> None:\n        self.count += 1\n\n    def pop(self) -> bool:\n        if self.count > 0:\n            self.count -= 1\n            return True\n        return False # Underflow\n\n    def is_zero(self) -> bool:\n        return self.count == 0\nclass ValidationResult:\n    \"\"\"Holds validation outcome and optional message.\"\"\"\n    def __init__(self, isBalanced: bool, message: str = \"\") -> None:\n        self.isBalanced = isBalanced\n        self.message = message\nclass BracketingAnalyzer:\n    \"\"\"Scans a BracketString using StackCounter and produces a ValidationResult.\"\"\"\n    def __init__(self) -> None:\n        self.scan_index = 0\n\n    def validate(self, brackets: BracketString) -> ValidationResult:\n        stack = StackCounter()\n        for i in range(brackets.length()):\n            self.scan_index = i\n            char = brackets.char_at(i)\n            if char == '(':\n                stack.push()\n            elif char == ')':\n                if not stack.pop():\n                    return ValidationResult(isBalanced=False, message=f\"unmatched closing at idx {i}\")\n        \n        if stack.is_zero():\n            return ValidationResult(isBalanced=True)\n        else:\n            return ValidationResult(isBalanced=False, message=\"unmatched opens remain\")\ndef correct_bracketing(brackets: str):\n    \"\"\" brackets is a string of \"(\" and \")\".\n    return True if every opening bracket has a corresponding closing bracket.\n\n    >>> correct_bracketing(\"(\")\n    False\n    >>> correct_bracketing(\"()\")\n    True\n    >>> correct_bracketing(\"(()())\")\n    True\n    >>> correct_bracketing(\")(()\")\n    False\n    \"\"\"\n    bracket_string = BracketString(brackets)\n    analyzer = BracketingAnalyzer()\n    result = analyzer.validate(bracket_string)\n    return result.isBalanced", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/63": [{"task_id": "HumanEval/63", "solution": "def fibfib(n: int):\n    \"\"\"The FibFib number sequence is a sequence similar to the Fibbonacci sequnece that's defined as follows:\n    fibfib(0) == 0\n    fibfib(1) == 0\n    fibfib(2) == 1\n    fibfib(n) == fibfib(n-1) + fibfib(n-2) + fibfib(n-3).\n    Please write a function to efficiently compute the n-th element of the fibfib number sequence.\n    >>> fibfib(1)\n    0\n    >>> fibfib(5)\n    4\n    >>> fibfib(8)\n    24\n    \"\"\"\n    if n == 0:\n        return 0\n    if n == 1:\n        return 0\n    if n == 2:\n        return 1\n\n    # Initialize rolling variables for fibfib(0), fibfib(1), fibfib(2)\n    a, b, c = 0, 0, 1\n\n    # Iterate from n=3 up to the target n\n    for _ in range(3, n + 1):\n        next_fib = a + b + c\n        # Rotate the values: (a, b, c) becomes (b, c, next_fib)\n        a, b, c = b, c, next_fib\n    \n    return c", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/65": [{"task_id": "HumanEval/65", "solution": "import collections\nfrom typing import List, Optional\nclass ResultString:\n    def __init__(self, value: str) -> None:\n        self.value = value\nclass DigitSequence:\n    def __init__(self, digits: List[str]) -> None:\n        self.digits = digits[:]\n        self.length = len(self.digits)\n\n    def reverse(self) -> 'DigitSequence':\n        return DigitSequence(list(reversed(self.digits)))\n\n    def rotateRight(self, k: int) -> 'DigitSequence':\n        if self.length == 0:\n            return DigitSequence([])\n        k = k % self.length\n        if k == 0:\n            return DigitSequence(self.digits[:])\n        rotated = self.digits[-k:] + self.digits[:-k]\n        return DigitSequence(rotated)\n\n    def to_string(self) -> str:\n        return ''.join(self.digits)\nclass CircularShift:\n    def __init__(self, x: int, shift: int) -> None:\n        self.x = x\n        self.shift = shift\n        self.result = None  # type: Optional[ResultString]\n\n    def execute(self) -> 'ResultString':\n        ds = self.toDigitSequence()\n        transformed = self.applyShift(ds)\n        rs = ResultString(transformed.to_string())\n        self.result = rs\n        return rs\n\n    def toDigitSequence(self) -> 'DigitSequence':\n        digits = list(str(abs(self.x)))\n        return DigitSequence(digits)\n\n    def applyShift(self, ds: 'DigitSequence') -> 'DigitSequence':\n        length = ds.length\n        if self.shift > length:\n            return ds.reverse()\n        if self.shift == length:\n            return ds\n        return ds.rotateRight(self.shift)\ndef circular_shift(x, shift):\n    \"\"\"Circular shift the digits of the integer x, shift the digits right by shift\n    and return the result as a string.\n    If shift > number of digits, return digits reversed.\n    >>> circular_shift(12, 1)\n    \"21\"\n    >>> circular_shift(12, 2)\n    \"12\"\n    \"\"\"\n    cs = CircularShift(x, shift)\n    rs = cs.execute()\n    return rs.value", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/67": [{"task_id": "HumanEval/67", "solution": "import re\nclass InputParser:\n    \"\"\"Extracts numeric tokens for apples and oranges from an input string.\"\"\"\n    def parseApples(self, s: str) -> str:\n        \"\"\"Extracts the numeric token preceding ' apples' from the string.\"\"\"\n        match = re.search(r\"(\\d+)\\s*apples\", s)\n        if match:\n            return match.group(1)\n        return \"0\" # Default if not found, based on examples\n    \n    def parseOranges(self, s: str) -> str:\n        \"\"\"Extracts the numeric token preceding ' oranges' from the string.\"\"\"\n        match = re.search(r\"(\\d+)\\s*oranges\", s)\n        if match:\n            return match.group(1)\n        return \"0\" # Default if not found, based on examples\nclass NumberParser:\n    \"\"\"Parses numeric tokens as base-10 integers.\"\"\"\n    def parseDecimal(self, token: str) -> int:\n        \"\"\"Converts a string token to an integer using base-10 parsing.\"\"\"\n        return int(token)\nclass FruitBasket:\n    \"\"\"Represents a basket of fruits, tracking total, apples, oranges, and mangoes.\"\"\"\n    def __init__(self, totalFruits: int, apples: int = 0, oranges: int = 0):\n        self._totalFruits = totalFruits\n        self._apples = apples\n        self._oranges = oranges\n        self._mangoes = 0\n\n    def set_mangoes(self, mangoes: int) -> None:\n        \"\"\"Sets the number of mangoes in the basket.\"\"\"\n        self._mangoes = mangoes\n\n    def get_mangoes(self) -> int:\n        \"\"\"Returns the number of mangoes in the basket.\"\"\"\n        return self._mangoes\nclass FruitDistributionService:\n    \"\"\"Orchestrates parsing, numerical conversion, and mango fruit calculation.\"\"\"\n    def __init__(self, input_parser: InputParser, number_parser: NumberParser):\n        self._input_parser = input_parser\n        self._number_parser = number_parser\n\n    def computeMangoCount(self, s: str, n: int) -> int:\n        \"\"\"Computes the number of mangoes based on input string and total fruits.\"\"\"\n        apples_token = self._input_parser.parseApples(s)\n        apples = self._number_parser.parseDecimal(apples_token)\n\n        oranges_token = self._input_parser.parseOranges(s)\n        oranges = self._number_parser.parseDecimal(oranges_token)\n\n        basket = FruitBasket(totalFruits=n, apples=apples, oranges=oranges)\n        mangoes = n - apples - oranges\n        basket.set_mangoes(mangoes)\n        \n        return basket.get_mangoes()\ndef fruit_distribution(s,n):\n    \"\"\"\n    In this task, you will be given a string that represents a number of apples and oranges \n    that are distributed in a basket of fruit this basket contains \n    apples, oranges, and mango fruits. Given the string that represents the total number of \n    the oranges and apples and an integer that represent the total number of the fruits \n    in the basket return the number of the mango fruits in the basket.\n    for examble:\n    fruit_distribution(\"5 apples and 6 oranges\", 19) ->19 - 5 - 6 = 8\n    fruit_distribution(\"0 apples and 1 oranges\",3) -> 3 - 0 - 1 = 2\n    fruit_distribution(\"2 apples and 3 oranges\", 100) -> 100 - 2 - 3 = 95\n    fruit_distribution(\"100 apples and 1 oranges\",120) -> 120 - 100 - 1 = 19\n    \"\"\"\n    input_parser = InputParser()\n    number_parser = NumberParser()\n    service = FruitDistributionService(input_parser, number_parser)\n    \n    return service.computeMangoCount(s, n)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/56": [{"task_id": "HumanEval/56", "solution": "from dataclasses import dataclass\nclass BracketValidator:\n    def contains_only_brackets(self, bs: BracketString) -> bool:\n        \"\"\"Checks if the bracket string contains only '<' and '>' characters.\"\"\"\n        for char in bs.value:\n            if char not in {'<', '>'}:\n                return False\n        return True\n\n    def is_balanced(self, bs: BracketString) -> ValidationResult:\n        \"\"\"Scans the bracket string for balanced opening and closing brackets.\"\"\"\n        open_count = 0\n        for char in bs.value:\n            if char == '<':\n                open_count += 1\n            elif char == '>':\n                if open_count == 0:\n                    return ValidationResult(is_valid=False, message=\"Closing before opening\")\n                open_count -= 1\n        \n        if open_count == 0:\n            return ValidationResult(is_valid=True, message=\"Balanced\")\n        else:\n            return ValidationResult(is_valid=False, message=\"Unmatched openings\")\n\n    def validate(self, bs: BracketString) -> ValidationResult:\n        \"\"\"Orchestrates character validation and bracket balancing.\"\"\"\n        if not self.contains_only_brackets(bs):\n            return ValidationResult(is_valid=False, message=\"Invalid characters\")\n        \n        return self.is_balanced(bs)\ndef correct_bracketing(brackets: str) -> bool:\n    \"\"\" brackets is a string of \"<\" and \">\".\n    return True if every opening bracket has a corresponding closing bracket.\n\n    >>> correct_bracketing(\"<\")\n    False\n    >>> correct_bracketing(\"<>\")\n    True\n    >>> correct_bracketing(\"<<><>>\")\n    True\n    >>> correct_bracketing(\"><<>\")\n    False\n    \"\"\"\n    bracket_string = BracketString(value=brackets)\n    validator = BracketValidator()\n    validation_result = validator.validate(bracket_string)\n    return validation_result.is_valid", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/64": [{"task_id": "HumanEval/64", "solution": "def vowels_count(s):\n    \"\"\"Write a function vowels_count which takes a string representing\n    a word as input and returns the number of vowels in the string.\n    Vowels in this case are 'a', 'e', 'i', 'o', 'u'. Here, 'y' is also a\n    vowel, but only when it is at the end of the given word.\n\n    Example:\n    >>> vowels_count(\"abcde\")\n    2\n    >>> vowels_count(\"ACEDY\")\n    3\n    \"\"\"\n    count = 0\n    standard_vowels = {'a', 'e', 'i', 'o', 'u'}\n    n = len(s)\n\n    for i, char in enumerate(s):\n        lower_char = char.lower()\n        if lower_char in standard_vowels:\n            count += 1\n        elif lower_char == 'y' and i == n - 1:\n            # 'y' is counted as a vowel only if it is the last character.\n            count += 1\n            \n    return count", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/66": [{"task_id": "HumanEval/66", "solution": "def digitSum(s):\n    \"\"\"Task\n    Write a function that takes a string as input and returns the sum of the upper characters only'\n    ASCII codes.\n    \"\"\"\n\n    def isUppercase(c):\n        \"\"\"Returns True if c is an ASCII uppercase letter ('A'-'Z'), False otherwise.\"\"\"\n        return 'A' <= c <= 'Z'\n\n    def asciiCode(c):\n        \"\"\"Returns the ASCII (ordinal) value of a character.\"\"\"\n        return ord(c)\n\n    def computeSum(s_local):\n        \"\"\"Iterates through the string, summing ASCII codes of uppercase characters.\"\"\"\n        total_sum = 0\n        for char in s_local:\n            if isUppercase(char):\n                total_sum += asciiCode(char)\n        return total_sum\n\n    return computeSum(s)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/71": [{"task_id": "HumanEval/71", "solution": "import math\nclass Triangle:\n    \"\"\"Represents a triangle with three side lengths.\"\"\"\n    def __init__(self, a, b, c):\n        self.a = a\n        self.b = b\n        self.c = c\n\n    def isValid(self):\n        \"\"\"Checks if the side lengths form a valid triangle using strict inequality.\"\"\"\n        return (self.a + self.b > self.c and\n                self.a + self.c > self.b and\n                self.b + self.c > self.a)\n\n    def semiPerimeter(self):\n        \"\"\"Calculates the semi-perimeter of the triangle.\"\"\"\n        return (self.a + self.b + self.c) / 2\nclass TriangleValidator:\n    \"\"\"Validates if a given triangle is valid.\"\"\"\n    def validate(self, triangle: Triangle):\n        \"\"\"Returns True if the triangle is valid, False otherwise.\"\"\"\n        return triangle.isValid()\nclass AreaCalculator:\n    \"\"\"Calculates the area of a triangle using Heron's formula.\"\"\"\n    def calculateArea(self, triangle: Triangle):\n        \"\"\"Computes the unrounded area of the triangle.\"\"\"\n        s = triangle.semiPerimeter()\n        # Heron's formula\n        area = math.sqrt(s * (s - triangle.a) * (s - triangle.b) * (s - triangle.c))\n        return area\ndef triangle_area(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle. Return the area of\n    the triangle rounded to 2 decimal points if the three sides form a valid triangle. \n    Otherwise return -1\n    Three sides make a valid triangle when the sum of any two sides is greater \n    than the third side.\n    Example:\n    triangle_area(3, 4, 5) == 6.00\n    triangle_area(1, 2, 10) == -1\n    '''\n    t = Triangle(a, b, c)\n    \n    validator = TriangleValidator()\n    if not validator.validate(t):\n        return -1\n        \n    calc = AreaCalculator()\n    area = calc.calculateArea(t)\n    \n    rounded_area = round(area, 2)\n    return rounded_area", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/68": [{"task_id": "HumanEval/68", "solution": "from typing import List\nclass Node:\n    \"\"\"Domain wrapper for a value and its index, with isEven().\"\"\"\n    def __init__(self, value: int, index: int):\n        self.value = value\n        self.index = index\n\n    def isEven(self) -> bool:\n        \"\"\"Checks if the node's value is even.\"\"\"\n        return self.value % 2 == 0\nclass Array:\n    \"\"\"Domain view over raw input arr, creates Node instances.\"\"\"\n    def __init__(self, arr: List[int]):\n        self.nodes: List[Node] = []\n        for i, val in enumerate(arr):\n            self.nodes.append(Node(val, i))\n        self.length = len(self.nodes)\nclass Result:\n    \"\"\"Container for selected value and index, converts to required return format.\"\"\"\n    def __init__(self, value: int, index: int):\n        self.value = value\n        self.index = index\n\n    def to_list(self) -> list:\n        \"\"\"Returns the result as a list [value, index].\"\"\"\n        return [self.value, self.index]\nclass Validator:\n    \"\"\"Validates array type, length, and element properties.\"\"\"\n    def __init__(self, min_length: int = 1, max_length: int = 10000):\n        self.min_length = min_length\n        self.max_length = max_length\n\n    def validate(self, arr) -> bool:\n        \"\"\"Checks if the input array is valid according to defined rules.\"\"\"\n        if not isinstance(arr, list):\n            return False\n        if not (self.min_length <= len(arr) <= self.max_length):\n            return False\n        for item in arr:\n            if not isinstance(item, int) or item < 0:\n                return False\n        return True\ndef pluck(arr):\n    \"\"\"\n    \"Given an array representing a branch of a tree that has non-negative integer nodes\n    your task is to pluck one of the nodes and return it.\n    The plucked node should be the node with the smallest even value.\n    If multiple nodes with the same smallest even value are found return the node that has smallest index.\n\n    The plucked node should be returned in a list, [ smalest_value, its index ],\n    If there are no even values or the given array is empty, return [].\n\n    Example 1:\n        Input: [4,2,3]\n        Output: [2, 1]\n        Explanation: 2 has the smallest even value, and 2 has the smallest index.\n\n    Example 2:\n        Input: [1,2,3]\n        Output: [2, 1]\n        Explanation: 2 has the smallest even value, and 2 has the smallest index. \n\n    Example 3:\n        Input: []\n        Output: []\n    \n    Example 4:\n        Input: [5, 0, 3, 0, 4, 2]\n        Output: [0, 1]\n        Explanation: 0 is the smallest value, but  there are two zeros,\n                     so we will choose the first zero, which has the smallest index.\n\n    Constraints:\n        * 1 <= nodes.length <= 10000\n        * 0 <= node.value\n    \"\"\"\n    validator = Validator(min_length=0) # Configure validator to allow empty arrays as per example 3.\n    \n    if not validator.validate(arr):\n        return []\n\n    smallest_even_value = float('inf')\n    smallest_even_index = -1\n\n    array_obj = Array(arr)\n    for node_obj in array_obj.nodes:\n        if node_obj.isEven():\n            # Update if a smaller even value is found.\n            # If values are equal, the first encountered (smaller index) is implicitly kept.\n            if node_obj.value < smallest_even_value:\n                smallest_even_value = node_obj.value\n                smallest_even_index = node_obj.index\n    \n    if smallest_even_index != -1:\n        result = Result(smallest_even_value, smallest_even_index)\n        return result.to_list()\n    else:\n        return []", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/69": [{"task_id": "HumanEval/69", "solution": "from typing import List, Dict\nfrom collections import Counter\nclass InputList:\n    def __init__(self, values: List[int]):\n        self.values: List[int] = values\n\n    def isValid(self) -> bool:\n        \"\"\"Return True when values is non-empty and all elements are positive integers (>0).\"\"\"\n        if not self.values:\n            return False\n        return all(isinstance(x, int) and x > 0 for x in self.values)\nclass IntegerValue:\n    def __init__(self, value: int, frequency: int):\n        self.value: int = value\n        self.frequency: int = frequency\nclass Result:\n    def __init__(self, value: int):\n        self.value: int = value\n\n    def asInt(self) -> int:\n        return self.value\nclass FrequencyCalculator:\n    def computeFrequencies(self, input_list_obj: InputList) -> Dict[int, int]:\n        \"\"\"Compute frequency map value -> count using value-based grouping.\"\"\"\n        return Counter(input_list_obj.values)\n\n    def findValidValues(self, freq_map: Dict[int, int]) -> List[IntegerValue]:\n        \"\"\"Return List[IntegerValue] for values where freq >= value.\"\"\"\n        valid_values = []\n        for value, frequency in freq_map.items():\n            if frequency >= value:\n                valid_values.append(IntegerValue(value, frequency))\n        return valid_values\n\n    def selectGreatest(self, valid_values: List[IntegerValue]) -> int:\n        \"\"\"Return max IntegerValue.value among validValues or -1 if none.\"\"\"\n        if not valid_values:\n            return -1\n        return max(iv.value for iv in valid_values)\ndef search(lst):\n    '''\n    You are given a non-empty list of positive integers. Return the greatest integer that is greater than \n    zero, and has a frequency greater than or equal to the value of the integer itself. \n    The frequency of an integer is the number of times it appears in the list.\n    If no such a value exist, return -1.\n    Examples:\n        search([4, 1, 2, 2, 3, 1]) == 2\n        search([1, 2, 2, 3, 3, 3, 4, 4, 4]) == 3\n        search([5, 5, 4, 4, 4]) == -1\n    '''\n    input_list = InputList(lst)\n    if not input_list.isValid():\n        raise ValueError(\"Input must be a non-empty list of positive integers. (FR1/BR1/BR2)\")\n\n    fc = FrequencyCalculator()\n    freq_map = fc.computeFrequencies(input_list)\n    valid_values = fc.findValidValues(freq_map)\n    selected = fc.selectGreatest(valid_values)\n    result = Result(selected)\n    return result.asInt()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/75": [{"task_id": "HumanEval/75", "solution": "from typing import List\nclass InputNumber:\n    \"\"\"Encapsulates the integer input value.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def isInteger(self) -> bool:\n        \"\"\"Checks if the encapsulated value is an integer.\"\"\"\n        return isinstance(self.value, int)\nclass Validator:\n    \"\"\"Validates InputNumber against domain constraints (integer and between 1 and 100).\"\"\"\n    domain_limit: int = 100\n\n    def isInDomain(self, input_num: InputNumber) -> bool:\n        \"\"\"Checks if the input number's value is within the specified domain (1 < value < 100).\"\"\"\n        return 1 < input_num.value < self.domain_limit\n\n    def validate(self, input_num: InputNumber) -> bool:\n        \"\"\"Performs full validation for the input number.\"\"\"\n        return input_num.isInteger() and self.isInDomain(input_num)\nclass PrimeChecker:\n    \"\"\"Determines whether a candidate integer is prime.\"\"\"\n    def isPrime(self, n: int) -> bool:\n        \"\"\"Checks if n is a prime number using trial division.\"\"\"\n        if n <= 1:\n            return False\n        if n <= 3:\n            return True\n        if n % 2 == 0 or n % 3 == 0:\n            return False\n        i = 5\n        while i * i <= n:\n            if n % i == 0 or n % (i + 2) == 0:\n                return False\n            i += 6\n        return True\nclass Factorizer:\n    \"\"\"Produces exact prime factorization of an InputNumber.\"\"\"\n    def __init__(self, prime_checker: PrimeChecker):\n        self.prime_checker = prime_checker\n\n    def factorize(self, input_num: InputNumber) -> List[int]:\n        \"\"\"Returns a list of prime factors for the given input number, including multiplicity.\"\"\"\n        factors = []\n        n = input_num.value\n\n        while n % 2 == 0:\n            factors.append(2)\n            n //= 2\n\n        i = 3\n        while i * i <= n:\n            while n % i == 0:\n                factors.append(i)\n                n //= i\n            i += 2\n\n        if n > 2: # If n is a prime number greater than 2 at this point\n            factors.append(n)\n            \n        return factors\nclass Evaluator:\n    \"\"\"Counts prime factors and determines if the count equals 3.\"\"\"\n    required_count: int = 3\n\n    def countPrimeFactors(self, factors: List[int]) -> int:\n        \"\"\"Returns the total count of prime factors, considering multiplicity.\"\"\"\n        return len(factors)\n\n    def isProductOfThreePrimes(self, factors: List[int]) -> bool:\n        \"\"\"Checks if the list of factors contains exactly three prime numbers.\"\"\"\n        return self.countPrimeFactors(factors) == self.required_count\ndef is_multiply_prime(a):\n    \"\"\"Write a function that returns true if the given number is the multiplication of 3 prime numbers\n    and false otherwise.\n    Knowing that (a) is less then 100. \n    Example:\n    is_multiply_prime(30) == True\n    30 = 2 * 3 * 5\n    \"\"\"\n    input_num = InputNumber(a)\n    validator = Validator()\n    \n    # Validate input according to domain constraints (1 < a < 100).\n    if not validator.validate(input_num):\n        return False\n    \n    prime_checker = PrimeChecker()\n    factorizer = Factorizer(prime_checker)\n    \n    factors = factorizer.factorize(input_num)\n    \n    evaluator = Evaluator()\n    \n    # Check if the number of prime factors (with multiplicity) is exactly 3.\n    return evaluator.isProductOfThreePrimes(factors)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/73": [{"task_id": "HumanEval/73", "solution": "import math\ndef smallest_change(arr):\n    \"\"\"\n    Given an array arr of integers, find the minimum number of elements that\n    need to be changed to make the array palindromic.\n    \"\"\"\n    n = len(arr)\n    if n <= 1:\n        return 0\n\n    changes = 0\n    # Iterate from the start to the middle of the array\n    for i in range(math.floor((n - 1) / 2) + 1):\n        # Compare element at index i with element at symmetric index n-1-i\n        if arr[i] != arr[n - 1 - i]:\n            changes += 1\n\n    return changes", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/74": [{"task_id": "HumanEval/74", "solution": "from typing import List\ndef validate_list_of_strings(lst: List) -> bool:\n    \"\"\"Returns True if lst is a list and every element is a string.\"\"\"\n    return isinstance(lst, list) and all(isinstance(s, str) for s in lst)\ndef compute_total(lst: List[str]) -> int:\n    \"\"\"Returns the sum of lengths of all strings in the list.\"\"\"\n    return sum(len(s) for s in lst)\ndef select_result(lst1: List[str], lst2: List[str], total1: int, total2: int) -> List[str]:\n    \"\"\"Returns lst1 if total1 <= total2 (tie-breaker), otherwise returns lst2.\"\"\"\n    if total1 <= total2:\n        return lst1\n    else:\n        return lst2\ndef total_match(lst1: List[str], lst2: List[str]) -> List[str]:\n    \"\"\"\n    Write a function that accepts two lists of strings and returns the list that has \n    total number of chars in the all strings of the list less than the other list.\n\n    if the two lists have the same number of chars, return the first list.\n\n    Examples\n    total_match([], []) \u279e []\n    total_match(['hi', 'admin'], ['hI', 'Hi']) \u279e ['hI', 'Hi']\n    total_match(['hi', 'admin'], ['hi', 'hi', 'admin', 'project']) \u279e ['hi', 'admin']\n    total_match(['hi', 'admin'], ['hI', 'hi', 'hi']) \u279e ['hI', 'hi', 'hi']\n    total_match(['4'], ['1', '2', '3', '4', '5']) \u279e ['4']\n    \"\"\"\n    if not validate_list_of_strings(lst1) or not validate_list_of_strings(lst2):\n        raise TypeError('lst1 and lst2 must be lists of strings')\n    total1 = compute_total(lst1)\n    total2 = compute_total(lst2)\n    return select_result(lst1, lst2, total1, total2)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/77": [{"task_id": "HumanEval/77", "solution": "from typing import Optional\nclass IntegerInput:\n    \"\"\"Holds the input integer value.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\nclass CubeRootCandidate:\n    \"\"\"Represents a candidate integer root n and computes n**3.\"\"\"\n    def __init__(self, n: int) -> None:\n        self.n = n\n\n    def cube(self) -> int:\n        return self.n ** 3\nclass CubeChecker:\n    \"\"\"Searches for an integer n such that n**3 == a.\"\"\"\n    def isCube(self, a: int) -> bool:\n        \"\"\"Determines if the given integer a is a perfect cube.\"\"\"\n        return self.findIntegerRoot(a) is not None\n\n    def findIntegerRoot(self, a: int) -> Optional[int]:\n        \"\"\"Finds the integer cube root of a, if it exists.\"\"\"\n        if a == 0:\n            return 0\n\n        sign = 1 if a > 0 else -1\n        abs_a = abs(a)\n\n        # Compute an approximate integer cube root\n        # Using abs_a**(1/3) can introduce floating point inaccuracies,\n        # so we check neighboring integers.\n        approx_root = round(abs_a ** (1/3))\n\n        # Check the approximate root and its neighbors\n        for n_candidate in range(max(0, approx_root - 2), approx_root + 3):\n            candidate_obj = CubeRootCandidate(n_candidate)\n            if candidate_obj.cube() == abs_a:\n                return n_candidate * sign\n        return None\ndef iscube(a: int) -> bool:\n    \"\"\"\n    Write a function that takes an integer a and returns True\n    if this integer is a cube of some integer number.\n    Note: you may assume the input is always valid.\n    Examples:\n    iscube(1) ==> True\n    iscube(2) ==> False\n    iscube(-1) ==> True\n    iscube(64) ==> True\n    iscube(0) ==> True\n    iscube(180) ==> False\n    \"\"\"\n    input_obj = IntegerInput(a)\n    checker = CubeChecker()\n    return checker.isCube(input_obj.value)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/78": [{"task_id": "HumanEval/78", "solution": "PRIME_HEX_DIGITS = {'2', '3', '5', '7', 'B', 'D'}\ndef _is_prime_hex_digit(ch):\n    \"\"\"Checks if a character is a prime hexadecimal digit.\"\"\"\n    return ch in PRIME_HEX_DIGITS\ndef hex_key(num):\n    \"\"\"Counts the number of hexadecimal digits that are prime.\"\"\"\n    count = 0\n    for char in num:\n        if _is_prime_hex_digit(char):\n            count += 1\n    return count", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/76": [{"task_id": "HumanEval/76", "solution": "def is_simple_power(x, n):\n    \"\"\"Your task is to write a function that returns true if a number x is a simple\n    power of n and false in other cases.\n    x is a simple power of n if n**int=x\n    For example:\n    is_simple_power(1, 4) => true\n    is_simple_power(2, 2) => true\n    is_simple_power(8, 2) => true\n    is_simple_power(3, 2) => false\n    is_simple_power(3, 1) => false\n    is_simple_power(5, 3) => false\n    \"\"\"\n    # We are looking for an integer k >= 0 such that n**k == x.\n    # Inputs x and n are assumed to be integers as per requirements.\n\n    # Case 1: x == 1\n    # n**0 = 1 for any n (including n=0 in Python).\n    if x == 1:\n        return True\n\n    # At this point, x is not 1. We are looking for k >= 1.\n\n    # Case 2: n == 1\n    # If n is 1, then 1**k is always 1. Since x is not 1, no k >= 1 works.\n    if n == 1:\n        return False\n    \n    # Case 3: n == 0\n    # 0**0 = 1 (handled by x == 1).\n    # 0**k = 0 for k >= 1.\n    if n == 0:\n        return x == 0 # If x is 0, 0**1=0 works. Otherwise, no power of 0 (for k>=1) equals x.\n    \n    # Case 4: n == -1\n    # If n is -1, then (-1)**k alternates between -1 (odd k) and 1 (even k).\n    # Since x is not 1 (handled above), the only other possibility is x == -1.\n    if n == -1:\n        return x == -1 # (-1)**1 = -1\n\n    # At this point, n is not 0, 1, or -1. And x is not 1.\n\n    # Case 5: x == 0\n    # If x is 0, and n is not 0, then n**k for k >= 0 will never be 0.\n    if x == 0:\n        return False\n\n    # General case: abs(n) > 1, and x is not 0 or 1.\n    # We search for k >= 1.\n    current_power = n # Represents n**1\n    k = 1 # Starting exponent.\n\n    while True:\n        # Check if current_power equals x\n        if current_power == x:\n            return True\n\n        # Check for conditions where x cannot be a power of n\n        # If n is positive (n > 1)\n        if n > 0: \n            # If x is negative, n**k (for k>=1) is always positive. Cannot equal x.\n            if x < 0:\n                return False\n            # If current_power has exceeded x (and both are positive), further powers will only increase.\n            if current_power > x:\n                return False\n        # If n is negative (n < -1, as n=-1 handled)\n        else: # n < -1\n            # If the magnitude of current_power has exceeded the magnitude of x,\n            # and current_power is not x, then x cannot be a power of n.\n            if abs(current_power) > abs(x):\n                return False\n        \n        # Increment exponent and calculate next power\n        k += 1\n        current_power *= n", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/70": [{"task_id": "HumanEval/70", "solution": "class Element:\n    \"\"\"Wrapper for an integer value and its original index.\"\"\"\n    def __init__(self, value: int, originalIndex: int) -> None:\n        self.value = value\n        self.originalIndex = originalIndex\nclass StrangeSortService:\n    \"\"\"Implements the strange sort algorithm with validation and stable tie-breaking.\"\"\"\n    def _validate_input(self, lst: object) -> None:\n        \"\"\"Validates if the input is a list of integers, raising TypeError otherwise.\"\"\"\n        if not isinstance(lst, list):\n            raise TypeError(\"Input must be a list.\")\n        for item in lst:\n            if not isinstance(item, int):\n                raise TypeError(\"All elements in the list must be integers.\")\n\n    def _build_elements(self, lst: list[int]) -> list[Element]:\n        \"\"\"Constructs Element wrappers from the input list.\"\"\"\n        return [Element(value=lst[i], originalIndex=i) for i in range(len(lst))]\n\n    def _select_next(self, elements: list[Element], select_min: bool) -> int:\n        \"\"\"Finds the index of the next element (min or max) considering tie-breaking.\"\"\"\n        best_idx = 0\n        best_element = elements[0]\n\n        for i in range(1, len(elements)):\n            current_element = elements[i]\n            if select_min:\n                if current_element.value < best_element.value:\n                    best_element = current_element\n                    best_idx = i\n                elif current_element.value == best_element.value and current_element.originalIndex < best_element.originalIndex:\n                    best_element = current_element\n                    best_idx = i\n            else: # select_max\n                if current_element.value > best_element.value:\n                    best_element = current_element\n                    best_idx = i\n                elif current_element.value == best_element.value and current_element.originalIndex < best_element.originalIndex:\n                    best_element = current_element\n                    best_idx = i\n        return best_idx\n\n    def _pop_element_at(self, elements: list[Element], index: int) -> Element:\n        \"\"\"Removes and returns an element at a given index.\"\"\"\n        return elements.pop(index)\n\n    def strange_sort_list(self, lst: list[int]) -> list[int]:\n        \"\"\"Performs the strange sort on the given list of integers.\"\"\"\n        self._validate_input(lst)\n        \n        elements = self._build_elements(lst)\n        output = []\n        select_min = True\n\n        while elements:\n            idx = self._select_next(elements, select_min)\n            e = self._pop_element_at(elements, idx)\n            output.append(e.value)\n            select_min = not select_min\n        \n        return output\ndef strange_sort_list(lst):\n    '''\n    Given list of integers, return list in strange order.\n    Strange sorting, is when you start with the minimum value,\n    then maximum of the remaining integers, then minimum and so on.\n\n    Examples:\n    strange_sort_list([1, 2, 3, 4]) == [1, 4, 2, 3]\n    strange_sort_list([5, 5, 5, 5]) == [5, 5, 5, 5]\n    strange_sort_list([]) == []\n    '''\n    return StrangeSortService().strange_sort_list(lst)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/79": [{"task_id": "HumanEval/79", "solution": "def decimal_to_binary(decimal):\n    \"\"\"Converts a decimal number to its binary string representation, formatted with 'db' prefix and suffix.\"\"\"\n    binary_string = bin(decimal)[2:]  # Convert to binary and remove \"0b\" prefix\n    return \"db\" + binary_string + \"db\"", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/82": [{"task_id": "HumanEval/82", "solution": "from typing import Optional\nclass InputString:\n    \"\"\"Domain entity representing an input string.\"\"\"\n    def __init__(self, value: str):\n        self.value: str = value\n        self.length: int = len(value)\n\n    def getLength(self) -> int:\n        \"\"\"Return the number of characters in the input string.\"\"\"\n        return self.length\nclass LengthCalculator:\n    \"\"\"Compute number of characters for a string.\"\"\"\n    def computeLength(self, s: str) -> int:\n        \"\"\"Return integer length of s (number of characters).\"\"\"\n        return len(s)\nclass PrimeChecker:\n    \"\"\"Determine primality of integers.\"\"\"\n    def isPrime(self, n: int) -> bool:\n        \"\"\"Return True if n is prime, else False.\"\"\"\n        if n < 2:\n            return False\n        if n % 2 == 0:\n            return n == 2\n        i = 3\n        while i * i <= n:\n            if n % i == 0:\n                return False\n            i += 2\n        return True\nclass PrimeLengthFunction:\n    \"\"\"Orchestration class implementing prime_length behavior.\"\"\"\n    def __init__(self, length_calculator: LengthCalculator = None, prime_checker: PrimeChecker = None):\n        self.length_calculator = length_calculator or LengthCalculator()\n        self.prime_checker = prime_checker or PrimeChecker()\n\n    def prime_length(self, string) -> bool:\n        \"\"\"Return True if the length (number of characters) of string is prime, else False.\"\"\"\n        input_obj = InputString(string)\n        length = self.length_calculator.computeLength(input_obj.value)\n        if length < 2:\n            return False\n        return self.prime_checker.isPrime(length)\ndef prime_length(string):\n    \"\"\"Write a function that takes a string and returns True if the string\n    length is a prime number or False otherwise\n    Examples\n    prime_length('Hello') == True\n    prime_length('abcdcba') == True\n    prime_length('kittens') == True\n    prime_length('orange') == False\n    \"\"\"\n    plf = PrimeLengthFunction()\n    return plf.prime_length(string)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/80": [{"task_id": "HumanEval/80", "solution": "def is_happy(s):\n    \"\"\"You are given a string s.\n    Your task is to check if the string is happy or not.\n    A string is happy if its length is at least 3 and every 3 consecutive letters are distinct\n    For example:\n    is_happy(a) => False\n    is_happy(aa) => False\n    is_happy(abcd) => True\n    is_happy(aabb) => False\n    is_happy(adb) => True\n    is_happy(xyy) => False\n    \"\"\"\n    n = len(s)\n    if n < 3:\n        return False\n\n    for i in range(n - 2):\n        # Check if the three consecutive characters are pairwise distinct\n        # This means char1 != char2, char1 != char3, and char2 != char3\n        if s[i] == s[i+1] or s[i] == s[i+2] or s[i+1] == s[i+2]:\n            return False\n            \n    return True", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/72": [{"task_id": "HumanEval/72", "solution": "import collections\nfrom typing import List, Optional\nfrom datetime import datetime\nclass Payload:\n    \"\"\"Represents the object to be assessed for flight.\"\"\"\n    def __init__(self, elements: List[float]) -> None:\n        self.elements = elements\nclass WeightThreshold:\n    \"\"\"Represents the maximum allowable weight for flight.\"\"\"\n    def __init__(self, maxWeight: float) -> None:\n        self.maxWeight = maxWeight\nclass FlightAssessment:\n    \"\"\"Stores the results of a flight assessment for a payload.\"\"\"\n    def __init__(self, payload: Payload, threshold: WeightThreshold) -> None:\n        self.payload = payload\n        self.threshold = threshold\n        self.totalWeight: float = 0.0\n        self.isBalanced: bool = False\n        self.assessedAt: Optional[datetime] = None\n\n    def computeTotalWeight(self) -> float:\n        \"\"\"Computes the sum of elements in the payload.\"\"\"\n        self.totalWeight = sum(self.payload.elements)\n        return self.totalWeight\n\n    def checkBalanced(self) -> bool:\n        \"\"\"Checks if the payload elements form a palindrome.\"\"\"\n        self.isBalanced = self.payload.elements == self.payload.elements[::-1]\n        return self.isBalanced\n\n    def willFly(self) -> bool:\n        \"\"\"Determines if the object will fly based on balance and weight.\"\"\"\n        return self.isBalanced and self.totalWeight <= self.threshold.maxWeight\nclass FlightCheckerSystem:\n    \"\"\"Orchestrates the flight assessment process.\"\"\"\n    def __init__(self) -> None:\n        pass\n\n    def assess(self, payload: Payload, threshold: WeightThreshold) -> FlightAssessment:\n        \"\"\"Performs a flight assessment for a given payload and weight threshold.\"\"\"\n        assessment = FlightAssessment(payload, threshold)\n        assessment.computeTotalWeight()\n        assessment.checkBalanced()\n        assessment.assessedAt = datetime.now()  # Optional timestamp\n        return assessment\ndef will_it_fly(q,w):\n    \"\"\"\n    Checks if an object 'q' will fly given its elements and a maximum weight 'w'.\n    The object flies if it's balanced (palindromic list) and its total weight\n    is less than or equal to 'w'.\n    \"\"\"\n    payload = Payload(elements=q)\n    weight_threshold = WeightThreshold(maxWeight=w)\n    flight_checker = FlightCheckerSystem()\n    assessment = flight_checker.assess(payload, weight_threshold)\n    return assessment.willFly()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/81": [{"task_id": "HumanEval/81", "solution": "class GradeMapping:\n    \"\"\"Encapsulates an interval rule for GPA to letter grade conversion.\"\"\"\n    def __init__(self, min_exclusive: float, max_inclusive: float, grade_code: str):\n        self.min_exclusive = min_exclusive\n        self.max_inclusive = max_inclusive\n        self.grade_code = grade_code\n\n    def matches(self, gpa: float) -> bool:\n        \"\"\"Checks if a GPA falls within this mapping's interval.\"\"\"\n        return gpa > self.min_exclusive and gpa <= self.max_inclusive\n\n    def code(self) -> str:\n        \"\"\"Returns the letter grade code for this mapping.\"\"\"\n        return self.grade_code\nclass GPAValue:\n    \"\"\"A wrapper for a GPA value with minimal validation.\"\"\"\n    def __init__(self, value: float):\n        self.value = value\n\n    def is_valid(self) -> bool:\n        \"\"\"Performs minimal numeric validation for the GPA.\"\"\"\n        # Due to constraints, explicit type/NaN checks are omitted here.\n        return True\nclass LetterGrade:\n    \"\"\"A lightweight wrapper for a letter grade string.\"\"\"\n    def __init__(self, code: str):\n        self.code = code\nclass ConversionRequest:\n    \"\"\"Internal container for input and output lists during conversion.\"\"\"\n    def __init__(self, input_list: list):\n        self.input_list = input_list\n        self.output_list = []\nMAPPINGS = [\n    GradeMapping(3.7, 4.0, 'A'),\n    GradeMapping(3.3, 3.7, 'A-'),\n    GradeMapping(3.0, 3.3, 'B+'),\n    GradeMapping(2.7, 3.0, 'B'),\n    GradeMapping(2.3, 2.7, 'B-'),\n    GradeMapping(2.0, 2.3, 'C+'),\n    GradeMapping(1.7, 2.0, 'C'),\n    GradeMapping(1.3, 1.7, 'C-'),\n    GradeMapping(1.0, 1.3, 'D+'),\n    GradeMapping(0.7, 1.0, 'D'),\n    GradeMapping(0.0, 0.7, 'D-'),\n]\ndef numerical_letter_grade(grades):\n    \"\"\"Converts a list of GPA values to a list of letter grades using defined rules.\"\"\"\n    request = ConversionRequest(grades)\n    \n    for gpa in request.input_list:\n        # GPAValue is created but its is_valid() method is not explicitly acted upon due to constraints.\n        gpa_value = GPAValue(gpa) \n\n        letter = None\n        if gpa == 4.0:\n            letter = 'A+'\n        elif gpa == 0.0:\n            letter = 'E'\n        else:\n            for mapping in MAPPINGS:\n                if mapping.matches(gpa):\n                    letter = mapping.code()\n                    break\n        \n        request.output_list.append(LetterGrade(letter).code)\n        \n    return request.output_list", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/84": [{"task_id": "HumanEval/84", "solution": "class DigitSumCalculator:\n    \"\"\"Computes the sum of decimal digits of a given integer.\"\"\"\n    def computeSum(self, N: int) -> int:\n        \"\"\"Returns the integer digit sum; for N == 0 returns 0.\"\"\"\n        if N == 0:\n            return 0\n        s = 0\n        abs_N = abs(N) # Handle potential negative numbers, though N is positive by constraint\n        while abs_N > 0:\n            s += abs_N % 10\n            abs_N //= 10\n        return s\nclass BinaryFormatter:\n    \"\"\"Converts a non-negative integer to a minimal binary string.\"\"\"\n    def toBinaryString(self, value: int) -> str:\n        \"\"\"Returns minimal binary string (\"0\" for zero; otherwise bits with no leading zeros).\"\"\"\n        if value == 0:\n            return \"0\"\n        return bin(value)[2:]\ndef solve(N):\n    \"\"\"Given a positive integer N, return the total sum of its digits in binary.\n    \n    Example\n        For N = 1000, the sum of digits will be 1 the output should be \"1\".\n        For N = 150, the sum of digits will be 6 the output should be \"110\".\n        For N = 147, the sum of digits will be 12 the output should be \"1100\".\n    \n    Variables:\n        @N integer\n             Constraints: 0 \u2264 N \u2264 10000.\n    Output:\n         a string of binary number\n    \"\"\"\n    digit_sum_calculator = DigitSumCalculator()\n    total_digit_sum = digit_sum_calculator.computeSum(N)\n\n    binary_formatter = BinaryFormatter()\n    binary_representation = binary_formatter.toBinaryString(total_digit_sum)\n    \n    return binary_representation", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/85": [{"task_id": "HumanEval/85", "solution": "from dataclasses import dataclass\nfrom typing import List\ndef filterByOddIndices(lst: List[int]) -> List[Element]:\n    \"\"\"Filters a list to return Elements that are at odd 0-based indices.\"\"\"\n    return [Element(index, value) for index, value in enumerate(lst) if index % 2 == 1]\ndef filterEvenValues(elems: List[Element]) -> List[Element]:\n    \"\"\"Filters a list of Elements to return only those with even valu