   self.total += amount\n\n    def value(self) -> int:\n        \"\"\"Returns the current accumulated total.\"\"\"\n        return self.total\ndef fizz_buzz(n: int):\n    \"\"\"Return the number of times the digit 7 appears in integers less than n which are divisible by 11 or 13.\n    >>> fizz_buzz(50)\n    0\n    >>> fizz_buzz(78)\n    2\n    >>> fizz_buzz(79)\n    3\n    \"\"\"\n    integer_range = IntegerRange(0, n)\n    result_accumulator = Result()\n\n    for k in integer_range:\n        integer_value = IntegerValue(k)\n\n        if integer_value.isDivBy11() or integer_value.isDivBy13():\n            count_of_7s = integer_value.count7()\n            result_accumulator.add(count_of_7s)\n\n    return result_accumulator.value()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/129": [{"task_id": "HumanEval/129", "solution": "import collections\nfrom typing import List, Tuple\nclass Cell:\n    \"\"\"Represents a single cell in the grid and provides neighbor lookup.\"\"\"\n    def __init__(self, row: int, col: int, value: int, grid_ref: 'Grid'):\n        self.row = row\n        self.col = col\n        self.value = value\n        self.grid_ref = grid_ref\n\n    def getNeighbors(self) -> List['Cell']:\n        \"\"\"Returns orthogonal neighbors within grid bounds.\"\"\"\n        neighbors = []\n        directions = [(-1, 0), (1, 0), (0, -1), (0, 1)] # Up, Down, Left, Right\n        N = self.grid_ref.N\n        for dr, dc in directions:\n            nr, nc = self.row + dr, self.col + dc\n            if 0 <= nr < N and 0 <= nc < N:\n                neighbors.append(self.grid_ref.getCell(nr, nc))\n        return neighbors\nclass Grid:\n    \"\"\"Represents the N x N grid; provides cell access.\"\"\"\n    def __init__(self, N: int, cells: List[List['Cell']]):\n        self.N = N\n        self.cells = cells\n\n    def getCell(self, r: int, c: int) -> 'Cell':\n        \"\"\"Returns the Cell at the specified row and column.\"\"\"\n        return self.cells[r][c]\ndef build_grid_from_list(grid_list: List[List[int]]) -> Grid:\n    \"\"\"Constructs a Grid object from a list of lists.\"\"\"\n    N = len(grid_list)\n    grid_obj = Grid(N, []) # Initialize with N and an empty cells list\n\n    cells_2d: List[List[Cell]] = [[None for _ in range(N)] for _ in range(N)]\n    for r in range(N):\n        for c in range(N):\n            value = grid_list[r][c]\n            cells_2d[r][c] = Cell(r, c, value, grid_obj) # Pass the grid_obj reference\n\n    grid_obj.cells = cells_2d # Assign the fully populated cells list\n    return grid_obj\nclass Validator:\n    \"\"\"Validates Grid and k; raises ValueError with clear messages on violations.\"\"\"\n    def validateGrid(self, grid: Grid) -> None:\n        \"\"\"Validates grid dimensions, values, and uniqueness.\"\"\"\n        N = grid.N\n\n        if N < 2:\n            raise ValueError(\"Grid must have at least 2 rows and 2 columns (N >= 2).\")\n        for r in range(N):\n            if len(grid.cells[r]) != N:\n                raise ValueError(\"Grid must be square.\")\n\n        expected_values = set(range(1, N * N + 1))\n        actual_values = set()\n        for r in range(N):\n            for c in range(N):\n                cell_value = grid.getCell(r, c).value\n                if not isinstance(cell_value, int):\n                    raise ValueError(f\"Grid cell at ({r},{c}) contains a non-integer value: {cell_value}.\")\n                if cell_value < 1 or cell_value > N * N:\n                    raise ValueError(f\"Grid cell value {cell_value} at ({r},{c}) is out of range [1, {N*N}].\")\n                if cell_value in actual_values:\n                    raise ValueError(f\"Duplicate value {cell_value} found in grid.\")\n                actual_values.add(cell_value)\n\n        if actual_values != expected_values:\n            raise ValueError(f\"Grid values are not a permutation of 1 to {N*N}.\")\n\n    def validateK(self, k: int) -> None:\n        \"\"\"Validates k (path length).\"\"\"\n        if not isinstance(k, int) or k < 1:\n            raise ValueError(\"Path length k must be a positive integer (k >= 1).\")\nclass Path:\n    \"\"\"Represents an ordered sequence of visited Cell steps.\"\"\"\n    def __init__(self, initial_cell: Cell = None):\n        self.steps: List[Cell] = []\n        if initial_cell:\n            self.steps.append(initial_cell)\n\n    def append(self, cell: Cell) -> None:\n        \"\"\"Appends a cell to the path steps.\"\"\"\n        self.steps.append(cell)\n\n    def values(self) -> List[int]:\n        \"\"\"Returns the ordered list of cell values in the path.\"\"\"\n        return [cell.value for cell in self.steps]\n\n    def length(self) -> int:\n        \"\"\"Returns the current length of the path.\"\"\"\n        return len(self.steps)\nclass PathGenerator:\n    \"\"\"Generates all valid paths of exactly k visited cells (revisits allowed).\"\"\"\n    def generateAllPaths(self, grid: Grid, k: int) -> List[Path]:\n        \"\"\"Generates all paths of length k starting from any cell.\"\"\"\n        all_paths: List[Path] = []\n        N = grid.N\n\n        for r in range(N):\n            for c in range(N):\n                start_cell = grid.getCell(r, c)\n                self._dfs(Path(start_cell), k, all_paths)\n        return all_paths\n\n    def _dfs(self, current_path: Path, target_length: int, all_paths: List[Path]) -> None:\n        \"\"\"Helper for DFS traversal to build paths of target_length.\"\"\"\n        if current_path.length() == target_length:\n            all_paths.append(current_path)\n            return\n\n        if current_path.length() > target_length:\n            return\n\n        last_cell = current_path.steps[-1]\n        for neighbor in last_cell.getNeighbors():\n            new_path = Path()\n            new_path.steps = list(current_path.steps) # Create a new list for steps\n            new_path.append(neighbor)\n            self._dfs(new_path, target_length, all_paths)\nclass Comparator:\n    \"\"\"Performs lexicographic comparison and selects the unique minimum Path.\"\"\"\n    def lexicographicCompare(self, a: List[int], b: List[int]) -> int:\n        \"\"\"Compares two lists lexicographically, returning -1 if a < b, 1 if a > b, 0 if a == b.\"\"\"\n        for i in range(len(a)):\n            if a[i] < b[i]:\n                return -1\n            elif a[i] > b[i]:\n                return 1\n        return 0 # They are equal\n\n    def selectMinimum(self, paths: List[Path]) -> Path:\n        \"\"\"Selects the lexicographically minimum Path from a list.\"\"\"\n        if not paths:\n            raise ValueError(\"Cannot select minimum from an empty list of paths.\")\n\n        min_path = paths[0]\n        min_values = min_path.values()\n\n        for i in range(1, len(paths)):\n            current_path = paths[i]\n            current_values = current_path.values()\n            if self.lexicographicCompare(current_values, min_values) == -1:\n                min_path = current_path\n                min_values = current_values\n        return min_path\nclass Result:\n    \"\"\"Converts the selected Path to the output list format.\"\"\"\n    def __init__(self, path: Path):\n        self.values: List[int] = path.values()\n\n    def toOutput(self) -> List[int]:\n        \"\"\"Returns the stored path values as a plain list.\"\"\"\n        return self.values\ndef minPath(grid: List[List[int]], k: int) -> List[int]:\n    \"\"\"\n    Orchestrates validation, path generation, comparison, and returns output list.\n    \"\"\"\n    g = build_grid_from_list(grid)\n    \n    v = Validator()\n    v.validateGrid(g)\n    v.validateK(k)\n    \n    pg = PathGenerator()\n    paths = pg.generateAllPaths(g, k)\n    \n    comp = Comparator()\n    best_path = comp.selectMinimum(paths)\n    \n    res = Result(best_path)\n    return res.toOutput()", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[[[12, 13