mplify(x, n):\n    \"\"\"Your task is to implement a function that will simplify the expression\n    x * n. The function returns True if x * n evaluates to a whole number and False\n    otherwise. Both x and n, are string representation of a fraction, and have the following format,\n    <numerator>/<denominator> where both numerator and denominator are positive whole numbers.\n\n    You can assume that x, and n are valid fractions, and do not have zero as denominator.\n\n    simplify(\"1/5\", \"5/1\") = True\n    simplify(\"1/6\", \"2/1\") = False\n    simplify(\"7/10\", \"10/2\") = False\n    \"\"\"\n    service = SimplifierService()\n    return service.simplify(x, n)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/142": [{"task_id": "HumanEval/142", "solution": "def sum_squares(lst):\n    \"\"\"\"\n    This function will take a list of integers. For all entries in the list, the function shall square the integer entry if its index is a \n    multiple of 3 and will cube the integer entry if its index is a multiple of 4 and not a multiple of 3. The function will not \n    change the entries in the list whose indexes are not a multiple of 3 or 4. The function shall then return the sum of all entries. \n    \n    Examples:\n    For lst = [1,2,3] the output should be 6\n    For lst = []  the output should be 0\n    For lst = [-1,-5,2,-1,-5]  the output should be -126\n    \"\"\"\n\n    def _transform_value(index, value):\n        \"\"\"Module-private: returns transformed integer per index-based rules.\"\"\"\n        if index % 3 == 0:\n            return value ** 2\n        elif index % 4 == 0:\n            return value ** 3\n        else:\n            return value\n\n    total_sum = 0\n    for index, value in enumerate(lst):\n        transformed_value = _transform_value(index, value)\n        total_sum += transformed_value\n    return total_sum", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/141": [{"task_id": "HumanEval/141", "solution": "def file_name_check(file_name):\n    \"\"\"Create a function which takes a string representing a file's name, and returns\n    'Yes' if the the file's name is valid, and returns 'No' otherwise.\n    \"\"\"\n\n    def _count_digits(name):\n        \"\"\"Counts digits in the given string.\"\"\"\n        return sum(1 for char in name if '0' <= char <= '9')\n\n    def _count_dots(name):\n        \"\"\"Counts '.' characters in the given string.\"\"\"\n        return name.count('.')\n\n    def _split_once_dot(name):\n        \"\"\"Splits the string into prefix and extension at the first dot.\"\"\"\n        parts = name.split('.', 1)\n        return parts[0], parts[1]\n\n    def _is_valid_prefix_start(prefix):\n        \"\"\"Checks if the prefix is non-empty and starts with a latin letter.\"\"\"\n        return len(prefix) > 0 and ('a' <= prefix[0] <= 'z' or 'A' <= prefix[0] <= 'Z')\n\n    def _is_allowed_extension(extension):\n        \"\"\"Checks if the extension is one of 'txt', 'exe', or 'dll'.\"\"\"\n        return extension in ['txt', 'exe', 'dll']\n\n    # --- Orchestration and Aggregation ---\n    digit_count = _count_digits(file_name)\n    if digit_count > 3:\n        return 'No'\n\n    dot_count = _count_dots(file_name)\n    if dot_count != 1:\n        return 'No'\n\n    prefix, extension = _split_once_dot(file_name)\n\n    if not _is_valid_prefix_start(prefix):\n        return 'No'\n\n    if not _is_allowed_extension(extension):\n        return 'No'\n\n    return 'Yes'", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [["\u00e9xample.exe"]]}], "HumanEval/94": [{"task_id": "HumanEval/94", "solution": "from typing import List, Optional\nimport math\nclass InputList:\n    \"\"\"Holds the raw list of integers.\"\"\"\n    def __init__(self, elements: List[int]) -> None:\n        self._elements = elements\n\n    def get_elements(self) -> List[int]:\n        return self._elements\nclass IntegerElement:\n    \"\"\"Holds an integer value and a boolean is_prime flag.\"\"\"\n    def __init__(self, value: int, is_prime: bool) -> None:\n        self._value = value\n        self._is_prime = is_prime\n\n    def get_value(self) -> int:\n        return self._value\n\n    def is_prime_value(self) -> bool:\n        return self._is_prime\nclass PrimeDetector:\n    \"\"\"Deterministic primality checking and conversion of InputList elements.\"\"\"\n    def is_prime(self, n: int) -> bool:\n        \"\"\"Determines if n is a prime number.\"\"\"\n        if n < 2:\n            return False\n        if n == 2:\n            return True\n        if n % 2 == 0:\n            return False\n        for i in range(3, math.isqrt(n) + 1, 2):\n            if n % i == 0:\n                return False\n        return True\n\n    def find_primes(self, input_list: InputList) -> List[IntegerElement]:\n        \"\"\"Creates IntegerElement instances with primality flags.\"\"\"\n        elements_with_primality = []\n        for val in input_list.get_elements():\n            is_p = self.is_prime(val)\n            elements_with_primality.append(IntegerElement(val, is_p))\n        return elements_with_primality\nclass Selector:\n    \"\"\"Selection logic to choose the largest prime value.\"\"\"\n    def select_largest(self, elements: List[IntegerElement]) -> Optional[IntegerElement]:\n        \"\"\"Returns the IntegerElement with the largest prime value, or None.\"\"\"\n        largest_prime_element = None\n        current_max_value = -1 \n\n        for element in elements:\n            if element.is_prime_value():\n                value = element.get_value()\n                if value > current_max_value:\n                    current_max_value = value\n                    largest_prime_element = element\n        return largest_prime_element\nclass DigitSumCalculator:\n    \"\"\"Computes base-10 digit sums for integers.\"\"\"\n    def sum_digits(self, n: int) -> int:\n        \"\"\"Computes the sum of base-10 digits of the absolute value of n.\"\"\"\n        s = 0\n        n_abs = abs(n)\n        if n_abs == 0:\n            return 0\n        while n_abs > 0:\n            s += n_abs % 10\n            n_abs //= 10\n        return s\ndef skjkasdkd(lst: List[int]) -> int:\n    \"\"\"You are given a list of integers.\n    You need to find the largest prime value and return the sum of its digits.\n    \"\"\"\n    input_list = InputList(lst)\n    \n    prime_detector = PrimeDetector()\n    elements_with_primality = prime_detector.find_primes(input_list)\n    \n    selector = Selector()\n    largest_prime_element = selector.select_largest(elements_with_primality)\n    \n    if largest_prime_element is None:\n        return 0\n    \n    digit_sum_calculator = DigitSumCalculator()\n    return digit_sum_calculator.sum_digits(largest_prime_element.get_value())", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/143": [{"task_id": "HumanEval/143", "solution": "def words_in_sentence(sentence):\n    \"\"\"\n    Returns a string containing words from the original sentence\n    whose lengths are prime numbers, preserving their order.\n    \"\"\"\n\n    class ValidationResult:\n        \"\"\"Represents the result of a validation operation.\"\"\"\n        def __init__(self, isValid: bool, errors: list = None):\n            self.isValid = isValid\n            self.errors = errors if errors is not None else []\n\n    class Validator:\n        \"\"\"Validates sentence input according to specified rules.\"\"\"\n        def _is_alpha_and_space(self, s: str) -> bool:\n            return all(c.isalpha() or c == ' ' for c in s)\n\n        def validateSentence(self, s: str) -> ValidationResult:\n            errors = []\n            if not (1 <= len(s) <= 100):\n                errors.append(\"Sentence length must be between 1 and 100 characters.\")\n            if not self._is_alpha_and_space(s):\n                errors.append(\"Sentence must contain only letters and spaces.\")\n            return ValidationResult(not bool(errors), errors)\n\n    class PrimeChecker:\n        \"\"\"Checks if a given integer is a prime number.\"\"\"\n        def isPrime(self, n: int) -> bool:\n            if n <= 1:\n                return False\n            i = 2\n            while i * i <= n:\n                if n % i == 0:\n                    return False\n                i += 1\n            return True\n\n    class Sentence:\n        \"\"\"Represents the input sentence.\"\"\"\n        def __init__(self, content: str):\n            self.content = content\n        def length(self) -> int:\n            return len(self.content)\n\n    class Word:\n        \"\"\"Represents a single word with its text and length.\"\"\"\n        def __init__(self, text: str):\n            self.text = text\n        def length(self) -> int:\n            return len(self.text)\n\n    class Result:\n        \"\"\"Represents the final output string.\"\"\"\n        def __init__(self, text: str):\n            self.text = text\n        def isEmpty(self) -> bool:\n            return not self.text\n\n    # Orchestration logic as per design.\n    # 1. Construct Sentence object.\n    s = Sentence(sentence)\n\n    # 2. Validate the sentence content.\n    validator = Validator()\n    validation_result = validator.validateSentence(s.content)\n    if not validation_result.isValid:\n        raise ValueError('; '.join(validation_result.errors))\n\n    # 3. Split the sentence into words.\n    tokens = s.content.split(' ')\n    words = [Word(t) for t in tokens]\n\n    # 4. Filter words whose lengths are prime numbers.\n    prime_checker = PrimeChecker()\n    selected_words_text = [w.text for w in words if prime_checker.isPrime(w.length())]\n\n    # 5. Assemble and return the result.\n    return ' '.join(selected_words_text) if selected_words_text else ''", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/145": [{"task_id": "HumanEval/145", "solution": "from typing import List\nclass IntegerItem:\n    \"\"\"Represents an integer value along with its original index and computed digit sum.\"\"\"\n    def __init__(self, value: int, index: int) -> None:\n        self.value = value\n        self.index = index\n        self.digitSum: int = 0 # This will be populated externally by DigitSumCalculator\nclass InputList:\n    \"\"\"Handles parsing the input list of integers into IntegerItem objects.\"\"\"\n    def __init__(self, values: List[int]) -> None:\n        self.values = values\n\n    def createIntegerItems(self) -> List[IntegerItem]:\n        \"\"\"Creates a list of IntegerItem objects from the input values.\"\"\"\n        return [IntegerItem(value, index) for index, value in enumerate(self.values)]\nclass DigitSumCalculator:\n    \"\"\"Stateless service for computing the sum of digits of an integer's absolute value.\"\"\"\n    def compute(self, item: IntegerItem) -> int:\n        \"\"\"Calculates the sum of digits for an IntegerItem's value (using its absolute value).\"\"\"\n        num_abs = abs(item.value)\n        s = 0\n        if num_abs == 0:\n            return 0\n        while num_abs > 0:\n            s += num_abs % 10\n            num_abs //= 10\n        return s\nclass Sorter:\n    \"\"\"Stateless service for performing stable sorting of IntegerItem objects.\"\"\"\n    def stableSort(self, items: List[IntegerItem]) -> List[IntegerItem]:\n        \"\"\"Sorts IntegerItem objects primarily by digit sum and secondarily by original index.\"\"\"\n        # Python's sorted() is stable. Sorting by (digitSum, index) explicitly handles tie-breaking.\n        return sorted(items, key=lambda item: (item.digitSum, item.index))\nclass OutputList:\n    \"\"\"Transforms a list of IntegerItem objects back into a list of their integer values.\"\"\"\n    @classmethod\n    def fromIntegerItems(cls, items: List[IntegerItem]) -> List[int]:\n        \"\"\"Extracts the original integer values from a list of IntegerItem objects.\"\"\"\n        return [item.value for item in items]\ndef order_by_points(nums):\n    \"\"\"\n    Write a function which sorts the given list of integers\n    in ascending order according to the sum of their digits.\n    Note: if there are several items with similar sum of their digits,\n    order them based on their index in original list.\n\n    For example:\n    >>> order_by_points([1, 11, -1, -11, -12]) == [-1, -11, 1, -12, 11]\n    >>> order_by_points([]) == []\n    \"\"\"\n    if not nums:\n        return []\n\n    # 1. Parse input into IntegerItem objects with indices\n    input_list_parser = InputList(nums)\n    items = input_list_parser.createIntegerItems()\n\n    # 2. Compute digit sums for all items and store them\n    digit_sum_calculator = DigitSumCalculator()\n    for item in items:\n        item.digitSum = digit_sum_calculator.compute(item)\n\n    # 3. Perform a stable sort by digitSum (and original index for ties)\n    sorter = Sorter()\n    sorted_items = sorter.stableSort(items)\n\n    # 4. Produce output list of values from sorted IntegerItems\n    return OutputList.fromIntegerItems(sorted_items)", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[[1, 11, -1, -11, -12]]], "plus_fail_tests": [[[-5, -12, 9, 15]]]}], "HumanEval/147": [{"task_id": "HumanEval/147", "solution": "def get_max_triples(n):\n    \"\"\"\n    You are given a positive integer n. You have to create an integer array a of length n.\n        For each i (1 \u2264 i \u2264 n), the value of a[i] = i * i - i + 1.\n        Return the number of triples (a[i], a[j], a[k]) of a where i < j < k, \n    and a[i] + a[j] + a[k] is a multiple of 3.\n\n    Example :\n        Input: n = 5\n        Output: 1\n        Explanation: \n        a = [1, 3, 7, 13, 21]\n        The only valid triple is (1, 7, 13).\n    \"\"\"\n\n    if n < 3:\n        return 0\n\n    def combinations3(x):\n        \"\"\"Calculates 'x choose 3', returning 0 if x < 3.\"\"\"\n        if x < 3:\n            return 0\n        return x * (x - 1) * (x - 2) // 6\n\n    # Analyze the residue pattern of a[i] = i*i - i + 1 modulo 3:\n    # If i % 3 == 0, a[i] % 3 = (0*0 - 0 + 1) % 3 = 1\n    # If i % 3 == 1, a[i] % 3 = (1*1 - 1 + 1) % 3 = 1\n    # If i % 3 == 2, a[i] % 3 = (2*2 - 2 + 1) % 3 = (4 - 2 + 1) % 3 = 3 % 3 = 0\n    # This means a[i] % 3 is 0 if i % 3 == 2, and 1 otherwise.\n    # a[i] % 3 will never be 2.\n\n    # c0: count of a[i] values with residue 0 mod 3\n    # c1: count of a[i] values with residue 1 mod 3\n    # c2: count of a[i] values with residue 2 mod 3 (always 0)\n\n    # Count occurrences of i % 3 for i from 1 to n\n    count_i_mod_0 = n // 3\n    count_i_mod_1 = (n + 2) // 3\n    count_i_mod_2 = (n + 1) // 3\n\n    # Map these to counts for a[i] residues\n    c0 = count_i_mod_2 # a[i] % 3 == 0 when i % 3 == 2\n    c1 = count_i_mod_0 + count_i_mod_1 # a[i] % 3 == 1 when i % 3 == 0 or i % 3 == 1\n    c2 = 0 # a[i] % 3 is never 2\n\n    # The sum of three elements a[i] + a[j] + a[k] is a multiple of 3 if their residues sum to a multiple of 3.\n    # Possible residue combinations (r1, r2, r3) where (r1 + r2 + r3) % 3 == 0:\n    # 1. (0, 0, 0): combinations3(c0)\n    # 2. (1, 1, 1): combinations3(c1)\n    # 3. (2, 2, 2): combinations3(c2)\n    # 4. (0, 1, 2): c0 * c1 * c2\n\n    # Since c2 is always 0, terms involving c2 will be 0.\n    # Thus, the total number of triples is combinations3(c0) + combinations3(c1).\n    total_triples = combinations3(c0) + combinations3(c1)\n\n    return total_triples", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/146": [{"task_id": "HumanEval/146", "solution": "from typing import List, Iterator, Set\nclass DigitExtractor:\n    \"\"\"Stateless utilities to extract first and last decimal digits from the absolute integer part of a number.\"\"\"\n    def get_first_digit(self, n: float) -> int:\n        \"\"\"Extracts the most-significant decimal digit from the absolute integer part of n.\"\"\"\n        i = abs(int(n))\n        if i == 0:\n            return 0\n        while i >= 10:\n            i //= 10\n        return i\n\n    def get_last_digit(self, n: float) -> int:\n        \"\"\"Extracts the least-significant decimal digit from the absolute integer part of n.\"\"\"\n        i = abs(int(n))\n        return i % 10\nclass NumberItem:\n    \"\"\"Model a single input element with digit-computation and predicate checks per SRS.\"\"\"\n    raw_value: float\n    abs_value: int\n    first_digit: int\n    last_digit: int\n    _odd_digits: Set[int] = {1, 3, 5, 7, 9}\n\n    def __init__(self, raw_value: float) -> None:\n        self.raw_value = raw_value\n        self.abs_value = 0 # Will be computed\n        self.first_digit = 0 # Will be computed\n        self.last_digit = 0 # Will be computed\n\n    def compute_digits(self, extractor: DigitExtractor) -> None:\n        \"\"\"Sets abs_value, first_digit, and last_digit using the provided DigitExtractor.\"\"\"\n        self.abs_value = abs(int(self.raw_value)) # As specified, abs(int(n)) for digit extraction\n        self.first_digit = extractor.get_first_digit(self.raw_value)\n        self.last_digit = extractor.get_last_digit(self.raw_value)\n\n    def is_greater_than_10(self) -> bool:\n        \"\"\"Returns True iff the raw_value is strictly greater than 10.\"\"\"\n        return self.raw_value > 10\n\n    def matches_filter(self) -> bool:\n        \"\"\"Returns True iff the number is greater than 10 and both its first and last digits are odd.\"\"\"\n        if not self.is_greater_than_10():\n            return False\n        \n        return (self.first_digit in self._odd_digits) and \\\n               (self.last_digit in self._odd_digits)\nclass InputArray:\n    \"\"\"Lightweight wrapper representing the input collection and helpers for iteration.\"\"\"\n    def __init__(self, values: List[float]) -> None:\n        self.values = values\n\n    def __iter__(self) -> Iterator[float]:\n        \"\"\"Provides an iterator over the input values.\"\"\"\n        return iter(self.values)\n\n    def length(self) -> int:\n        \"\"\"Returns the number of elements in the input array.\"\"\"\n        return len(self.values)\nclass Result:\n    \"\"\"Simple container for the counting result.\"\"\"\n    def __init__(self, count: int = 0) -> None:\n        self._count = count\n\n    def increment(self, n: int = 1) -> None:\n        \"\"\"Increments the internal count by n.\"\"\"\n        self._count += n\n\n    def value(self) -> int:\n        \"\"\"Returns the current count.\"\"\"\n        return self._count\ndef specialFilter(nums: List[float]) -> int:\n    \"\"\"\n    Takes an array of numbers as input and returns the number of elements in the array that are\n    greater than 10 and both first and last digits of a number are odd (1, 3, 5, 7, 9).\n    \"\"\"\n    input_array = InputArray(nums)\n    extractor = DigitExtractor()\n    result = Result(0)\n\n    for raw_value in input_array:\n        item = NumberItem(raw_value)\n        item.compute_digits(extractor)\n        if item.matches_filter():\n            result.increment()\n\n    return result.value()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/150": [{"task_id": "HumanEval/150", "solution": "import math\ndef _is_prime(n):\n    \"\"\"Determines if a number is prime.\"\"\"\n    if n < 2:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n    for i in range(3, int(math.sqrt(n)) + 1, 2):\n        if n % i == 0:\n            return False\n    return True\ndef x_or_y(n, x, y):\n    \"\"\"A simple program which should return the value of x if n is \n    a prime number and should return the value of y otherwise.\n    \"\"\"\n    if _is_prime(n):\n        return x\n    else:\n        return y", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/148": [{"task_id": "HumanEval/148", "solution": "import collections\nclass Planet:\n    \"\"\"Represents a planet with its name and order from the Sun.\"\"\"\n    def __init__(self, name: str, orderFromSun: int) -> None:\n        self.name = name\n        self.orderFromSun = orderFromSun\ndef _canonical_planets() -> list[Planet]:\n    \"\"\"Returns a list of all eight planets in canonical order.\"\"\"\n    return [\n        Planet(\"Mercury\", 0),\n        Planet(\"Venus\", 1),\n        Planet(\"Earth\", 2),\n        Planet(\"Mars\", 3),\n        Planet(\"Jupiter\", 4),\n        Planet(\"Saturn\", 5),\n        Planet(\"Uranus\", 6),\n        Planet(\"Neptune\", 7),\n    ]\nclass SolarSystem:\n    \"\"\"Repository for solar system planets, providing lookup and range queries.\"\"\"\n    def __init__(self, planets: list[Planet]) -> None:\n        self.planets = planets\n        self._name_to_index = {planet.name: planet.orderFromSun for planet in planets}\n\n    def get_index(self, name: str) -> int:\n        \"\"\"Returns the orderFromSun index of a planet, or -1 if not found.\"\"\"\n        return self._name_to_index.get(name, -1)\n\n    def get_planets_between(self, idx1: int, idx2: int) -> list[Planet]:\n        \"\"\"Returns planets whose indices are strictly between idx1 and idx2.\"\"\"\n        if idx1 == -1 or idx2 == -1:\n            return []\n        \n        start_idx = min(idx1, idx2)\n        end_idx = max(idx1, idx2)\n        \n        # Strictly between, so start_idx + 1 to end_idx - 1\n        return self.planets[start_idx + 1 : end_idx]\n_default_solar_system_instance = None\ndef get_default_solar_system() -> SolarSystem:\n    \"\"\"Returns a singleton instance of SolarSystem with canonical planets.\"\"\"\n    global _default_solar_system_instance\n    if _default_solar_system_instance is None:\n        _default_solar_system_instance = SolarSystem(_canonical_planets())\n    return _default_solar_system_instance\nclass PlanetValidator:\n    \"\"\"Validates if a given name corresponds to a canonical planet.\"\"\"\n    def __init__(self, solar_system: SolarSystem = None) -> None:\n        self._solar_system = solar_system if solar_system is not None else get_default_solar_system()\n\n    def is_valid(self, name: str) -> bool:\n        \"\"\"Checks if the planet name is valid.\"\"\"\n        return self._solar_system.get_index(name) != -1\nclass PlanetRangeFinder:\n    \"\"\"Finds planets located between two specified planets.\"\"\"\n    def __init__(self, solar_system: SolarSystem = None, validator: PlanetValidator = None) -> None:\n        self._solar_system = solar_system if solar_system is not None else get_default_solar_system()\n        self._validator = validator if validator is not None else PlanetValidator(self._solar_system)\n\n    def get_between(self, name1: str, name2: str) -> tuple:\n        \"\"\"Returns a tuple of planet names between name1 and name2, or an empty tuple.\"\"\"\n        if not self._validator.is_valid(name1) or not self._validator.is_valid(name2):\n            return ()\n\n        idx1 = self._solar_system.get_index(name1)\n        idx2 = self._solar_system.get_index(name2)\n\n        between_planets = self._solar_system.get_planets_between(idx1, idx2)\n        return tuple(p.name for p in between_planets)\ndef bf(planet1, planet2):\n    '''\n    There are eight planets in our solar system: the closerst to the Sun \n    is Mercury, the next one is Venus, then Earth, Mars, Jupiter, Saturn, \n    Uranus, Neptune.\n    Write a function that takes two planet names as strings planet1 and planet2. \n    The function should return a tuple containing all planets whose orbits are \n    located between the orbit of planet1 and the orbit of planet2, sorted by \n    the proximity to the sun. \n    The function should return an empty tuple if planet1 or planet2\n    are not correct planet names. \n    Examples\n    bf(\"Jupiter\", \"Neptune\") ==> (\"Saturn\", \"Uranus\")\n    bf(\"Earth\", \"Mercury\") ==> (\"Venus\")\n    bf(\"Mercury\", \"Uranus\") ==> (\"Venus\", \"Earth\", \"Mars\", \"Jupiter\", \"Saturn\")\n    '''\n    prf = PlanetRangeFinder()\n    return prf.get_between(planet1, planet2)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/151": [{"task_id": "HumanEval/151", "solution": "from typing import List, Any\nclass ListInput:\n    \"\"\"Encapsulates the input list as a container of NumberElement instances.\"\"\"\n    def __init__(self, elements: List[Any]):\n        self.elements = [NumberElement(value) for value in elements]\nclass NumberElement:\n    \"\"\"Represents a single input element and provides deterministic checks.\"\"\"\n    def __init__(self, value: Any):\n        self.value = value\n\n    def is_integer(self) -> bool:\n        \"\"\"Returns True if the value is an integer type or a float with zero fractional part.\"\"\"\n        if isinstance(self.value, int):\n            return True\n        if isinstance(self.value, float):\n            return self.value == int(self.value)\n        return False\n\n    def is_negative(self) -> bool:\n        \"\"\"Returns True if the value is numeric and less than 0.\"\"\"\n        if isinstance(self.value, (int, float)):\n            return self.value < 0\n        return False\n\n    def is_odd(self) -> bool:\n        \"\"\"Returns True if the value is an integer and is odd.\"\"\"\n        if self.is_integer():\n            return int(self.value) % 2 != 0\n        return False\nclass ComputationService:\n    \"\"\"Orchestrates validation, filtering, selection, and computation.\"\"\"\n    def computeSumOfSquares(self, list_input: ListInput) -> int:\n        \"\"\"Orchestrates the filtering and summing steps according to business rules.\"\"\"\n        # validateInput is included per design, though always true in this specific flow.\n        self.validateInput(list_input) \n\n        elements = list_input.elements\n        \n        elements = self.filterNegative(elements)\n        elements = self.filterNonIntegers(elements)\n        elements = self.selectOddIntegers(elements)\n        \n        result_int = self.squareAndSum(elements)\n        return result_int\n\n    def validateInput(self, list_input: ListInput) -> bool:\n        \"\"\"Checks that the provided object is a ListInput instance.\"\"\"\n        # This method is designed to check the type of `list_input`.\n        return isinstance(list_input, ListInput)\n\n    def filterNegative(self, elements: List[NumberElement]) -> List[NumberElement]:\n        \"\"\"Removes elements from the list that are negative.\"\"\"\n        return [e for e in elements if not e.is_negative()]\n\n    def filterNonIntegers(self, elements: List[NumberElement]) -> List[NumberElement]:\n        \"\"\"Removes elements from the list that are not integers.\"\"\"\n        return [e for e in elements if e.is_integer()]\n\n    def selectOddIntegers(self, elements: List[NumberElement]) -> List[NumberElement]:\n        \"\"\"Keeps only the elements from the list that are odd integers.\"\"\"\n        return [e for e in elements if e.is_odd()]\n\n    def squareAndSum(self, elements: List[NumberElement]) -> int:\n        \"\"\"Squares each eligible element's value and returns their sum.\"\"\"\n        total_sum = 0\n        for e in elements:\n            total_sum += int(e.value) ** 2\n        return total_sum\ndef double_the_difference(lst):\n    \"\"\"\n    Given a list of numbers, return the sum of squares of the numbers\n    in the list that are odd. Ignore numbers that are negative or not integers.\n    \"\"\"\n    list_input = ListInput(lst)\n    service = ComputationService()\n    result = service.computeSumOfSquares(list_input)\n    return result", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[[1.0, 3.5, -4.6]]]}], "HumanEval/152": [{"task_id": "HumanEval/152", "solution": "import collections\nfrom typing import List, Sequence, Union, Any\nimport numbers\nclass InputArray:\n    \"\"\"A typed wrapper for input arrays with a name and values.\"\"\"\n    def __init__(self, name: str, values: Sequence[Any]):\n        self.name = name\n        self.values = list(values)\nclass Match:\n    \"\"\"Represents a single match comparison, holding actual and guessed scores.\"\"\"\n    def __init__(self, index: int, actualScore: Union[int, float], guessedScore: Union[int, float]):\n        self.index = index\n        self.actualScore = actualScore\n        self.guessedScore = guessedScore\n\n    def difference(self) -> Union[int, float]:\n        \"\"\"Calculates the difference for this match.\"\"\"\n        if self.actualScore == self.guessedScore:\n            return 0\n        else:\n            return abs(self.actualScore - self.guessedScore)\nclass Comparison:\n    \"\"\"Orchestrates creating Match objects and computing all differences.\"\"\"\n    def __init__(self, game: InputArray, guess: InputArray):\n        self.matches: List[Match] = []\n        for i in range(len(game.values)):\n            self.matches.append(Match(i, game.values[i], guess.values[i]))\n\n    def computeDifferences(self) -> List[Union[int, float]]:\n        \"\"\"Computes and returns a list of differences for all matches.\"\"\"\n        return [m.difference() for m in self.matches]\nclass Validator:\n    \"\"\"Provides methods for validating input arrays.\"\"\"\n    @staticmethod\n    def validateLengths(a: InputArray, b: InputArray) -> bool:\n        \"\"\"Checks if two InputArray instances have equal length.\"\"\"\n        return len(a.values) == len(b.values)\n\n    @staticmethod\n    def validateNumeric(a: InputArray) -> bool:\n        \"\"\"Checks if all elements in an InputArray are numeric.\"\"\"\n        return all(isinstance(x, (int, float)) for x in a.values)\ndef compare(game: Sequence[Union[int, float]], guess: Sequence[Union[int, float]]) -> List[Union[int, float]]:\n    \"\"\"Compares game scores to guesses, returning the absolute difference for each match.\"\"\"\n    gameInput = InputArray('game', list(game))\n    guessInput = InputArray('guess', list(guess))\n\n    if not Validator.validateNumeric(gameInput):\n        raise ValueError('game contains non-numeric elements')\n    if not Validator.validateNumeric(guessInput):\n        raise ValueError('guess contains non-numeric elements')\n    if not Validator.validateLengths(gameInput, guessInput):\n        raise ValueError('game and guess must have equal length')\n\n    comp = Comparison(gameInput, guessInput)\n    return comp.computeDifferences()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/153": [{"task_id": "HumanEval/153", "solution": "from typing import List\nclass Extension:\n    \"\"\"Data model for an extension, holding its name and calculated properties.\"\"\"\n    def __init__(self, name: str):\n        self.name = name\n        self.capCount = 0\n        self.smCount = 0\n        self.strength = 0\nclass LetterCounter:\n    \"\"\"Counts uppercase and lowercase alphabetic characters in a string.\"\"\"\n    def countUpper(self, s: str) -> int:\n        return sum(1 for c in s if c.isalpha() and c.isupper())\n\n    def countLower(self, s: str) -> int:\n        return sum(1 for c in s if c.isalpha() and c.islower())\nclass StrengthCalculator:\n    \"\"\"Computes the strength of an extension as CAP - SM.\"\"\"\n    def __init__(self, letter_counter: LetterCounter = None):\n        self._letter_counter = letter_counter if letter_counter is not None else LetterCounter()\n\n    def computeStrength(self, ext: Extension) -> int:\n        \"\"\"Sets the strength attribute of an Extension object.\"\"\"\n        # Ensure counts are set before computing strength, using the injected letter_counter if needed.\n        if ext.capCount == 0 and ext.smCount == 0 and ext.name:\n            ext.capCount = self._letter_counter.countUpper(ext.name)\n            ext.smCount = self._letter_counter.countLower(ext.name)\n            \n        ext.strength = ext.capCount - ext.smCount\n        return ext.strength\nclass Selector:\n    \"\"\"Selects the strongest extension from a list, applying tie-breaking rules.\"\"\"\n    def selectStrongest(self, exts: List[Extension]) -> Extension:\n        \"\"\"Finds the strongest extension, prioritizing earlier entries in case of a tie.\"\"\"\n        strongest_ext = exts[0]\n        max_strength = strongest_ext.strength\n\n        for current_ext in exts[1:]:\n            if current_ext.strength > max_strength:\n                max_strength = current_ext.strength\n                strongest_ext = current_ext\n        return strongest_ext\ndef format_result(class_name: str, extension: Extension) -> str:\n    \"\"\"Formats the final output string.\"\"\"\n    return f\"{class_name}.{extension.name}\"\ndef Strongest_Extension(class_name, extensions):\n    \"\"\"\n    Finds the strongest extension based on CAP - SM strength and returns it in the specified format.\n    The earliest extension in the list wins ties in strength.\n    \"\"\"\n    letter_counter = LetterCounter()\n    strength_calculator = StrengthCalculator(letter_counter=letter_counter)\n    selector = Selector()\n\n    extension_objects = []\n    for ext_name in extensions:\n        ext = Extension(ext_name)\n        ext.capCount = letter_counter.countUpper(ext.name)\n        ext.smCount = letter_counter.countLower(ext.name)\n        strength_calculator.computeStrength(ext)\n        extension_objects.append(ext)\n    \n    # As per design, assuming `extensions` list is not empty for valid operation.\n    strongest_ext = selector.selectStrongest(extension_objects)\n    \n    return format_result(class_name, strongest_ext)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/149": [{"task_id": "HumanEval/149", "solution": "from typing import List\ndef validate_list(lst: list) -> bool:\n    \"\"\"Validates that the input is a list of strings.\n    Raises ValueError on invalid input.\"\"\"\n    if not isinstance(lst, list):\n        raise ValueError(\"Input must be a list.\")\n    for item in lst:\n        if not isinstance(item, str):\n            raise ValueError(\"All elements in the list must be strings.\")\n    return True\ndef remove_odd_length(items: list) -> list:\n    \"\"\"Removes strings with odd lengths, returning a new list.\"\"\"\n    even_length_items = [item for item in items if len(item) % 2 == 0]\n    return even_length_items\ndef sort_by_length_then_alpha(items: list) -> list:\n    \"\"\"Sorts a list of strings primarily by length, then alphabetically for ties.\"\"\"\n    sorted_items = sorted(items, key=lambda s: (len(s), s))\n    return sorted_items\ndef sorted_list_sum(lst):\n    \"\"\"Write a function that accepts a list of strings as a parameter,\n    deletes the strings that have odd lengths from it,\n    and returns the resulted list with a sorted order,\n    The list is always a list of strings and never an array of numbers,\n    and it may contain duplicates.\n    The order of the list should be ascending by length of each word, and you\n    should return the list sorted by that rule.\n    If two words have the same length, sort the list alphabetically.\n    The function should return a list of strings in sorted order.\n    You may assume that all words will have the same length.\n    For example:\n    assert list_sort([\"aa\", \"a\", \"aaa\"]) => [\"aa\"]\n    assert list_sort([\"ab\", \"a\", \"aaa\", \"cd\"]) => [\"ab\", \"cd\"]\n    \"\"\"\n    validate_list(lst)\n    filtered = remove_odd_length(lst)\n    sorted_result = sort_by_length_then_alpha(filtered)\n    return sorted_result", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/154": [{"task_id": "HumanEval/154", "solution": "from typing import List\nclass StringRotationGenerator:\n    \"\"\"Generates all circular rotations of a given string.\"\"\"\n    def rotations(self, b: str) -> List[str]:\n        \"\"\"Return list of circular rotations of b for k in 0..len(b)-1.\n        When len(b) == 0 returns [].\"\"\"\n        if not b:\n            return []\n        n = len(b)\n        return [b[k:] + b[:k] for k in range(n)]\nclass SubstringMatcher:\n    \"\"\"Checks if a string contains another string as a substring.\"\"\"\n    def contains(self, haystack: str, needle: str) -> bool:\n        \"\"\"Return True if needle is a substring of haystack using Python's native substring semantics.\"\"\"\n        return needle in haystack\ndef cycpattern_check(a , b):\n    \"\"\"You are given 2 words. You need to return True if the second word or any of its rotations is a substring in the first word\"\"\"\n    rgen = StringRotationGenerator()\n    matcher = SubstringMatcher()\n    \n    rotations = rgen.rotations(b)\n    \n    for rot in rotations:\n        if matcher.contains(a, rot):\n            return True\n            \n    return False", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [["", ""]]}], "HumanEval/155": [{"task_id": "HumanEval/155", "solution": "from typing import List, Tuple, Set\nclass IntegerInput:\n    \"\"\"Represents an integer and provides absolute-value and digitization behavior.\"\"\"\n    def __init__(self, num: int):\n        self.num = num\n\n    def get_absolute_value(self) -> int:\n        \"\"\"Returns the absolute value of the number.\"\"\"\n        return abs(self.num)\n\n    def to_digits(self) -> List[\"Digit\"]:\n        \"\"\"Converts the absolute number into a list of Digit objects; handles 0 as a single digit.\"\"\"\n        abs_num = self.get_absolute_value()\n        if abs_num == 0:\n            return [Digit(0, 0)]\n\n        digits_list: List[Digit] = []\n        s_num = str(abs_num)\n        for i, char_digit in enumerate(s_num):\n            digits_list.append(Digit(int(char_digit), i))\n        return digits_list\nclass Digit:\n    \"\"\"Represents a single decimal digit with its value and position.\"\"\"\n    def __init__(self, value: int, position: int):\n        self.value = value\n        self.position = position\n\n    def is_even(self) -> bool:\n        \"\"\"Checks if the digit's value is even.\"\"\"\n        return self.value % 2 == 0\n\n    def is_odd(self) -> bool:\n        \"\"\"Checks if the digit's value is odd.\"\"\"\n        return self.value % 2 != 0\nclass DigitClassifier:\n    \"\"\"Encapsulates parity business rules for digits.\"\"\"\n    def __init__(self):\n        self.__even_digits: Set[int] = {0, 2, 4, 6, 8}\n        self.__odd_digits: Set[int] = {1, 3, 5, 7, 9}\n\n    def is_even(self, d: Digit) -> bool:\n        \"\"\"Determines if a given Digit is even.\"\"\"\n        return d.value in self.__even_digits\n\n    def is_odd(self, d: Digit) -> bool:\n        \"\"\"Determines if a given Digit is odd.\"\"\"\n        return d.value in self.__odd_digits\nclass CountResult:\n    \"\"\"Holds the aggregated counts of even and odd digits.\"\"\"\n    def __init__(self, even_count: int, odd_count: int):\n        self.even_count = even_count\n        self.odd_count = odd_count\nclass EvenOddCounter:\n    \"\"\"Orchestrates the counting of even and odd digits from an integer.\"\"\"\n    def __init__(self):\n        self.classifier = DigitClassifier()\n\n    def compute(self, num: int) -> CountResult:\n        \"\"\"Computes the even and odd digit counts for the given number.\"\"\"\n        integer_input = IntegerInput(num)\n        digits = integer_input.to_digits()\n\n        even_count = 0\n        odd_count = 0\n\n        for digit in digits:\n            if self.classifier.is_even(digit):\n                even_count += 1\n            else:\n                odd_count += 1\n        \n        return CountResult(even_count, odd_count)\ndef even_odd_count(num):\n    \"\"\"Given an integer. return a tuple that has the number of even and odd digits respectively.\n\n     Example:\n        even_odd_count(-12) ==> (1, 1)\n        even_odd_count(123) ==> (1, 2)\n    \"\"\"\n    counter = EvenOddCounter()\n    result = counter.compute(num)\n    return (result.even_count, result.odd_count)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/156": [{"task_id": "HumanEval/156", "solution": "class InputValidator:\n    \"\"\"Validates input type and range according to specified rules.\"\"\"\n    @staticmethod\n    def validate_type(number):\n        \"\"\"Raises TypeError if the number is not an integer.\"\"\"\n        if not isinstance(number, int):\n            raise TypeError(\"Input must be an integer.\")\n\n    @staticmethod\n    def validate_range(number, min_value=1, max_value=1000):\n        \"\"\"Raises ValueError if the number is outside the allowed range.\"\"\"\n        if not (min_value <= number <= max_value):\n            raise ValueError(f\"Input must be between {min_value} and {max_value} inclusive.\")\nclass RomanConverter:\n    \"\"\"Converts an integer to its uppercase Roman numeral equivalent.\"\"\"\n    _mappings = [\n        (1000, 'M'), (900, 'CM'), (500, 'D'), (400, 'CD'),\n        (100, 'C'), (90, 'XC'), (50, 'L'), (40, 'XL'),\n        (10, 'X'), (9, 'IX'), (5, 'V'), (4, 'IV'), (1, 'I')\n    ]\n\n    @staticmethod\n    def convert_to_roman(number: int) -> str:\n        \"\"\"Converts an integer to an uppercase Roman numeral string.\"\"\"\n        roman_numeral = []\n        temp_num = number\n        for value, char in RomanConverter._mappings:\n            while temp_num >= value:\n                roman_numeral.append(char)\n                temp_num -= value\n        return \"\".join(roman_numeral)\nclass RomanNumeral:\n    \"\"\"A value object for Roman numerals, providing a lowercase conversion.\"\"\"\n    def __init__(self, value: str):\n        \"\"\"Initializes with an uppercase Roman numeral string.\"\"\"\n        self.value = value\n\n    def to_lower(self) -> str:\n        \"\"\"Returns the stored Roman numeral string in lowercase.\"\"\"\n        return self.value.lower()\ndef int_to_mini_roman(number):\n    \"\"\"\n    Given a positive integer, obtain its roman numeral equivalent as a string,\n    and return it in lowercase.\n    Restrictions: 1 <= num <= 1000\n\n    Examples:\n    >>> int_to_mini_roman(19) == 'xix'\n    >>> int_to_mini_roman(152) == 'clii'\n    >>> int_to_mini_roman(426) == 'cdxxvi'\n    \"\"\"\n    InputValidator.validate_type(number)\n    InputValidator.validate_range(number)\n    \n    roman_upper = RomanConverter.convert_to_roman(number)\n    roman_obj = RomanNumeral(roman_upper)\n    \n    return roman_obj.to_lower()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/158": [{"task_id": "HumanEval/158", "solution": "from typing import List, Set, Optional\nclass Result:\n    \"\"\"A simple wrapper to hold and expose the selected word.\"\"\"\n    def __init__(self, selected_word: str) -> None:\n        self._selected_word = selected_word\n\n    def get(self) -> str:\n        \"\"\"Returns the selected word.\"\"\"\n        return self._selected_word\nclass UniqueCharCounter:\n    \"\"\"Utility to compute the number of unique characters for a Word or text.\"\"\"\n    def compute_from_text(self, text: str) -> int:\n        \"\"\"Computes the number of unique characters from a string.\"\"\"\n        return len(set(text))\n\n    def compute(self, word: 'Word') -> int:\n        \"\"\"Computes the number of unique characters for a Word object.\"\"\"\n        return self.compute_from_text(word.get_text())\nclass Word:\n    \"\"\"Domain entity for an input word and its computed unique-character properties.\"\"\"\n    def __init__(self, text: str) -> None:\n        self._text = text\n        self._unique_count: Optional[int] = None\n\n    def compute_unique_count(self, counter: 'UniqueCharCounter') -> int:\n        \"\"\"Computes and stores the unique character count using the provided counter.\"\"\"\n        if self._unique_count is None:\n            self._unique_count = counter.compute(self)\n        return self._unique_count\n\n    def get_unique_count(self) -> int:\n        \"\"\"Returns the computed number of unique characters.\"\"\"\n        # Assumes compute_unique_count has been called by FindMaxService prior to this call.\n        return self._unique_count # type: ignore [return-value] # Will be set by orchestration.\n\n    def get_text(self) -> str:\n        \"\"\"Returns the original text of the word.\"\"\"\n        return self._text\nclass TieBreaker:\n    \"\"\"Utility to resolve ties by runtime lexicographic ordering.\"\"\"\n    def choose(self, words: List['Word']) -> 'Word':\n        \"\"\"Selects the lexicographically smallest Word from a list of tied Words.\"\"\"\n        # The design implies `words` will not be empty when this is called by FindMaxService.\n        return min(words, key=lambda w: w.get_text())\nclass FindMaxService:\n    \"\"\"Orchestrates creation of Word entities, unique-character count computation, selection of max, and tie-breaking.\"\"\"\n    def __init__(self, unique_counter: 'UniqueCharCounter' = None, tie_breaker: 'TieBreaker' = None) -> None:\n        self._unique_counter = unique_counter if unique_counter is not None else UniqueCharCounter()\n        self._tie_breaker = tie_breaker if tie_breaker is not None else TieBreaker()\n\n    def find_max(self, words: List[str]) -> str:\n        \"\"\"Processes a list of words to find the one with maximum unique characters, resolving ties lexicographically.\"\"\"\n        if not words:\n            # Behavior for empty input list is unspecified in SRS; returning an empty string.\n            return \"\"\n\n        word_objects: List[Word] = []\n        for text in words:\n            word = Word(text)\n            word.compute_unique_count(self._unique_counter)\n            word_objects.append(word)\n\n        # It's highly unlikely word_objects would be empty if `words` was not, but for robustness.\n        if not word_objects:\n            return \"\"\n\n        max_unique_count = -1\n        for word_obj in word_objects:\n            count = word_obj.get_unique_count()\n            if count > max_unique_count:\n                max_unique_count = count\n\n        tied_words: List[Word] = []\n        for word_obj in word_objects:\n            if word_obj.get_unique_count() == max_unique_count:\n                tied_words.append(word_obj)\n\n        chosen_word = self._tie_breaker.choose(tied_words)\n\n        result = Result(chosen_word.get_text())\n        return result.get()\ndef find_max(words: List[str]) -> str:\n    \"\"\"Write a function that accepts a list of strings.\n    The list contains different words. Return the word with maximum number\n    of unique characters. If multiple strings have maximum number of unique\n    characters, return the one which comes first in lexicographical order.\n    \"\"\"\n    service = FindMaxService()\n    return service.find_max(words)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/159": [{"task_id": "HumanEval/159", "solution": "class InputValidator:\n    \"\"\"Validates input types and ranges.\"\"\"\n    def validate(self, number, need, remaining):\n        for param, name in [(number, \"number\"), (need, \"need\"), (remaining, \"remaining\")]:\n            if not isinstance(param, int):\n                raise TypeError(f\"{name} must be an integer.\")\n            if not (0 <= param <= 1000):\n                raise ValueError(f\"{name} must be between 0 and 1000 inclusive.\")\nclass Rabbit:\n    \"\"\"Represents the rabbit's eaten carrots.\"\"\"\n    def __init__(self, number_eaten: int):\n        self.number_eaten = number_eaten\nclass CarrotStock:\n    \"\"\"Manages the available carrots.\"\"\"\n    def __init__(self, remaining: int):\n        self.remaining = remaining\n\n    def consume(self, amount: int) -> int:\n        \"\"\"Reduces remaining carrots, returning the actual amount consumed.\"\"\"\n        actual_consumed = min(self.remaining, amount)\n        self.remaining -= actual_consumed\n        return actual_consumed\nclass EatAction:\n    \"\"\"Encapsulates the logic for the eating process.\"\"\"\n    def __init__(self, need: int):\n        self.need = need\n\n    def execute(self, rabbit: Rabbit, stock: CarrotStock) -> list[int]:\n        \"\"\"Performs the eating action, updating rabbit and stock states.\"\"\"\n        actual_consumed = stock.consume(self.need)\n        \n        rabbit.number_eaten += actual_consumed\n        \n        return [rabbit.number_eaten, stock.remaining]\ndef eat(number, need, remaining):\n    \"\"\"\n    You're a hungry rabbit, and you already have eaten a certain number of carrots,\n    but now you need to eat more carrots to complete the day's meals.\n    you should return an array of [ total number of eaten carrots after your meals,\n                                    the number of carrots left after your meals ]\n    if there are not enough remaining carrots, you will eat all remaining carrots, but will still be hungry.\n    \n    Example:\n    * eat(5, 6, 10) -> [11, 4]\n    * eat(4, 8, 9) -> [12, 1]\n    * eat(1, 10, 10) -> [11, 0]\n    * eat(2, 11, 5) -> [7, 0]\n    \n    Variables:\n    @number : integer\n        the number of carrots that you have eaten.\n    @need : integer\n        the number of carrots that you need to eat.\n    @remaining : integer\n        the number of remaining carrots thet exist in stock\n    \n    Constrain:\n    * 0 <= number <= 1000\n    * 0 <= need <= 1000\n    * 0 <= remaining <= 1000\n\n    Have fun :)\n    \"\"\"\n    validator = InputValidator()\n    validator.validate(number, need, remaining)\n\n    rabbit = Rabbit(number_eaten=number)\n    stock = CarrotStock(remaining=remaining)\n    action = EatAction(need=need)\n\n    result = action.execute(rabbit, stock)\n    return result", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/160": [{"task_id": "HumanEval/160", "solution": "class Operand:\n    \"\"\"Represents an operand (integer value).\"\"\"\n    def __init__(self, value: int):\n        self.value = value\nclass Operator:\n    \"\"\"Represents an operator (symbol string).\"\"\"\n    def __init__(self, symbol: str):\n        self.symbol = symbol\nclass Expression:\n    \"\"\"Represents the algebraic expression as a list of terms.\"\"\"\n    def __init__(self, terms: list):\n        self.terms = terms\nclass Result:\n    \"\"\"Holds the final integer result of the expression.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\nclass Validator:\n    \"\"\"Validates input lists operator and operand.\"\"\"\n    ALLOWED_OPERATORS = {'+', '-', '*', '//', '**'}\n\n    def validate_length(self, operators: list, operands: list):\n        \"\"\"Validates the lengths of operator and operand lists.\"\"\"\n        if not (len(operators) >= 1 and len(operands) >= 2):\n            raise ValueError(\"Operator list must have at least one operator, and operand list at least two operands.\")\n        if not (len(operators) == len(operands) - 1):\n            raise ValueError(\"The length of operator list must be equal to the length of operand list minus one.\")\n\n    def validate_operators(self, operators: list):\n        \"\"\"Validates that all operators are allowed.\"\"\"\n        for op in operators:\n            if op not in self.ALLOWED_OPERATORS:\n                raise ValueError(f\"Invalid operator '{op}'. Allowed operators are {', '.join(self.ALLOWED_OPERATORS)}.\")\n\n    def validate_operands(self, operands: list):\n        \"\"\"Validates that all operands are non-negative integers.\"\"\"\n        for opnd in operands:\n            if not isinstance(opnd, int) or opnd < 0:\n                raise ValueError(f\"Invalid operand '{opnd}'. Operands must be non-negative integers.\")\ndef build_expression(operators: list, operands: list) -> Expression:\n    \"\"\"Interleaves operands and operators to build an Expression object.\"\"\"\n    terms = []\n    for i in range(len(operands)):\n        terms.append(Operand(operands[i]))\n        if i < len(operators):\n            terms.append(Operator(operators[i]))\n    return Expression(terms)\nclass Evaluator:\n    \"\"\"Evaluates an Expression object considering operator precedence and associativity.\"\"\"\n    def evaluateExpression(self, expression: Expression) -> Result:\n        current_terms = list(expression.terms) # Clone to modify\n\n        # Phase 1: Exponentiation (**) - Right Associative\n        i = len(current_terms) - 1\n        while i >= 0:\n            term = current_terms[i]\n            if isinstance(term, Operator) and term.symbol == '**':\n                left_operand = current_terms[i-1].value\n                right_operand = current_terms[i+1].value\n                result = left_operand ** right_operand\n                current_terms[i-1:i+2] = [Operand(result)]\n                i -= 2 # Adjust index for removed elements and decrement for next iteration\n            i -= 1\n\n        # Phase 2: Multiplication (*), Floor Division (//) - Left Associative\n        i = 0\n        while i < len(current_terms):\n            term = current_terms[i]\n            if isinstance(term, Operator) and term.symbol in ['*', '//']:\n                left_operand = current_terms[i-1].value\n                right_operand = current_terms[i+1].value\n                \n                if term.symbol == '*':\n                    result = left_operand * right_operand\n                elif term.symbol == '//':\n                    if right_operand == 0:\n                        raise ZeroDivisionError(\"division by zero\")\n                    result = left_operand // right_operand\n                \n                current_terms[i-1:i+2] = [Operand(result)]\n                i -= 1 # Adjust index to re-evaluate current position before moving to next\n            i += 1\n\n        # Phase 3: Addition (+), Subtraction (-) - Left Associative\n        i = 0\n        while i < len(current_terms):\n            term = current_terms[i]\n            if isinstance(term, Operator) and term.symbol in ['+', '-']:\n                left_operand = current_terms[i-1].value\n                right_operand = current_terms[i+1].value\n                \n                if term.symbol == '+':\n                    result = left_operand + right_operand\n                elif term.symbol == '-':\n                    result = left_operand - right_operand\n                \n                current_terms[i-1:i+2] = [Operand(result)]\n                i -= 1 # Adjust index to re-evaluate current position before moving to next\n            i += 1\n        \n        # After all operations, only one Operand should remain\n        if len(current_terms) != 1 or not isinstance(current_terms[0], Operand):\n            raise ValueError(\"Expression evaluation failed to produce a single result. This indicates an internal error or invalid expression structure after reduction.\")\n        \n        return Result(current_terms[0].value)\ndef do_algebra(operator, operand):\n    \"\"\"\n    Given two lists operator, and operand. The first list has basic algebra operations, and \n    the second list is a list of integers. Use the two given lists to build the algebric \n    expression and return the evaluation of this expression.\n    \"\"\"\n    validator = Validator()\n    validator.validate_length(operator, operand)\n    validator.validate_operators(operator)\n    validator.validate_operands(operand)\n    \n    expression = build_expression(operator, operand)\n    \n    evaluator = Evaluator()\n    result = evaluator.evaluateExpression(expression)\n    \n    return int(result.value)", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[["-", "+", "**", "**"], [5, 3, 3, 2, 2]]]}], "HumanEval/157": [{"task_id": "HumanEval/157", "solution": "import math\nclass Result:\n    \"\"\"Data carrier for boolean outcome and an optional reason string.\"\"\"\n    def __init__(self, value: bool, reason: str = \"\"):\n        self.value = value\n        self.reason = reason\nclass Calculator:\n    \"\"\"Performs numeric computations for triangle properties.\"\"\"\n    EPSILON: float = 1e-9 # Tolerance for floating-point comparisons.\n\n    def square(self, x: float) -> float:\n        \"\"\"Returns the square of a number.\"\"\"\n        return x * x\n\n    def get_hypotenuse(self, a: float, b: float, c: float) -> tuple[float, float, float]:\n        \"\"\"Identifies the longest side as the hypotenuse and returns it with the other two sides.\"\"\"\n        sides = sorted([a, b, c])\n        h = sides[2]\n        x = sides[0]\n        y = sides[1]\n        return h, x, y\n\n    def compare_squares(self, h: float, x: float, y: float) -> bool:\n        \"\"\"Checks if h^2 is approximately equal to x^2 + y^2 using EPSILON.\"\"\"\n        h_squared = self.square(h)\n        sum_of_squares_other_sides = self.square(x) + self.square(y)\n        return math.isclose(h_squared, sum_of_squares_other_sides, rel_tol=self.EPSILON, abs_tol=self.EPSILON)\nclass Validator:\n    \"\"\"Provides stateless validation checks for triangle sides.\"\"\"\n\n    def validate_numeric(self, a, b, c) -> bool:\n        \"\"\"Checks if all sides are numeric (int or float).\"\"\"\n        return all(isinstance(s, (int, float)) for s in [a, b, c])\n\n    def validate_positive(self, a: float, b: float, c: float) -> bool:\n        \"\"\"Checks if all sides are positive.\"\"\"\n        return all(s > 0 for s in [a, b, c])\n\n    def validate_triangle_inequality(self, a: float, b: float, c: float) -> bool:\n        \"\"\"Checks if the triangle inequality holds for all sides.\"\"\"\n        return (a + b > c) and (a + c > b) and (b + c > a)\nclass Triangle:\n    \"\"\"Encapsulates triangle side lengths and orchestrates validation and computation.\"\"\"\n    def __init__(self, a, b, c):\n        self.a = a\n        self.b = b\n        self.c = c\n        self.is_valid: bool = False\n        self.is_right_angle: bool = False\n        self._validator = Validator()\n        self._calculator = Calculator()\n\n    def validate(self) -> Result:\n        \"\"\"Runs all necessary validation checks for a valid triangle, returning a Result object.\"\"\"\n        if not self._validator.validate_numeric(self.a, self.b, self.c):\n            self.is_valid = False\n            return Result(False, \"Non-numeric side lengths provided.\")\n\n        # If numeric, ensure they are floats for consistent arithmetic in subsequent checks.\n        self.a = float(self.a)\n        self.b = float(self.b)\n        self.c = float(self.c)\n\n        if not self._validator.validate_positive(self.a, self.b, self.c):\n            self.is_valid = False\n            return Result(False, \"Side lengths must be positive.\")\n        if not self._validator.validate_triangle_inequality(self.a, self.b, self.c):\n            self.is_valid = False\n            return Result(False, \"Triangle inequality does not hold.\")\n\n        self.is_valid = True\n        return Result(True, \"Triangle is valid.\")\n\n    def identify_hypotenuse(self) -> tuple[float, float, float]:\n        \"\"\"Identifies the hypotenuse and other two sides using the Calculator.\"\"\"\n        # This method assumes `self.is_valid` is true, so `a, b, c` are floats and positive.\n        return self._calculator.get_hypotenuse(self.a, self.b, self.c)\n\n    def check_pythagorean(self) -> Result:\n        \"\"\"Checks if the triangle satisfies the Pythagorean theorem, returning a Result object.\"\"\"\n        # This method assumes `self.is_valid` is true.\n        h, x, y = self.identify_hypotenuse()\n        is_right = self._calculator.compare_squares(h, x, y)\n        self.is_right_angle = is_right\n        if is_right:\n            return Result(True, \"Triangle is right-angled.\")\n        else:\n            return Result(False, \"Triangle is not right-angled.\")\ndef right_angle_triangle(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle. Return True if the three\n    sides form a right-angled triangle, False otherwise.\n    A right-angled triangle is a triangle in which one angle is right angle or \n    90 degree.\n    Example:\n    right_angle_triangle(3, 4, 5) == True\n    right_angle_triangle(1, 2, 3) == False\n    '''\n    t = Triangle(a, b, c)\n\n    validation_result = t.validate()\n    if not validation_result.value:\n        return False\n\n    pythagorean_result = t.check_pythagorean()\n    return pythagorean_result.value", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/83": [{"task_id": "HumanEval/83", "solution": "class InputParameter:\n    \"\"\"A value object holding the input integer n.\"\"\"\n    def __init__(self, n: int) -> None:\n        self._n = n\n\n    def as_int(self) -> int:\n        \"\"\"Returns the stored integer value.\"\"\"\n        return self._n\nclass Validator:\n    \"\"\"Validates input n based on business rules.\"\"\"\n    @staticmethod\n    def _is_integer(value) -> bool:\n        \"\"\"Checks if a value is an integer.\"\"\"\n        return isinstance(value, int)\n\n    def validate(self, n) -> bool:\n        \"\"\"Returns True if n is an integer >= 1, otherwise False.\"\"\"\n        return self._is_integer(n) and n >= 1\nclass Result:\n    \"\"\"Data holder for computation results.\"\"\"\n    def __init__(self, count: int, formula_used: str = '') -> None:\n        self.count = count\n        self.formula_used = formula_used\nclass Calculator:\n    \"\"\"Computes counts based on n using inclusion-exclusion or closed-form.\"\"\"\n    def count_start_with_1(self, n: int) -> int:\n        \"\"\"Counts n-digit numbers starting with 1.\"\"\"\n        if n == 1:\n            return 1\n        return 10 ** (n - 1)\n\n    def count_end_with_1(self, n: int) -> int:\n        \"\"\"Counts n-digit numbers ending with 1.\"\"\"\n        if n == 1:\n            return 1\n        return 9 * (10 ** (n - 2))\n\n    def count_start_and_end_with_1(self, n: int) -> int:\n        \"\"\"Counts n-digit numbers starting and ending with 1.\"\"\"\n        if n == 1:\n            return 1\n        return 10 ** (n - 2)\n\n    def compute(self, n: int) -> Result:\n        \"\"\"Computes the total count of n-digit numbers starting or ending with 1.\"\"\"\n        if n == 1:\n            return Result(count=1, formula_used='special-case n=1')\n        else:\n            return Result(count=18 * (10 ** (n - 2)), formula_used='18 * 10^(n-2)')\ndef starts_one_ends(n: int) -> int:\n    \"\"\"\n    Given a positive integer n, return the count of the numbers of n-digit\n    positive integers that start or end with 1.\n    \"\"\"\n    ip = InputParameter(n)\n    if not Validator().validate(ip.as_int()):\n        raise ValueError(\"n must be an integer >= 1\")\n    result = Calculator().compute(ip.as_int())\n    return result.count", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/161": [{"task_id": "HumanEval/161", "solution": "def solve(s):\n    \"\"\"\n    You are given a string s.\n    If s[i] is a letter, reverse its case, otherwise keep it as is.\n    If the string contains no letters, reverse the string.\n    \"\"\"\n\n    def _is_letter(c):\n        \"\"\"Checks if a character is an ASCII letter.\"\"\"\n        return ('a' <= c <= 'z') or ('A' <= c <= 'Z')\n\n    def _has_letters(s):\n        \"\"\"Checks if the string contains any ASCII letters.\"\"\"\n        for char in s:\n            if _is_letter(char):\n                return True\n        return False\n\n    def _flip_char(c):\n        \"\"\"Flips the case of a letter or returns the character unchanged.\"\"\"\n        if 'a' <= c <= 'z':\n            return c.upper()\n        elif 'A' <= c <= 'Z':\n            return c.lower()\n        return c\n\n    def _reverse(s):\n        \"\"\"Reverses the input string.\"\"\"\n        return s[::-1]\n\n    if not _has_letters(s):\n        return _reverse(s)\n    else:\n        result_chars = []\n        for char in s:\n            result_chars.append(_flip_char(char))\n        return \"\".join(result_chars)", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [["\u00e4\u00eb\u00ef\u00f6\u00fc"]]}], "HumanEval/162": [{"task_id": "HumanEval/162", "solution": "import hashlib\nfrom typing import Optional\ndef string_to_md5(text: str) -> Optional[str]:\n    \"\"\"\n    Given a string 'text', return its md5 hash equivalent string.\n    If 'text' is an empty string, return None.\n    \"\"\"\n    if text == \"\":\n        return None\n    md5_hash = hashlib.md5(text.encode('utf-8'))\n    return md5_hash.hexdigest()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/163": [{"task_id": "HumanEval/163", "solution": "class InputParameters:\n    \"\"\"Encapsulates raw inputs and provides normalized inclusive range endpoints.\"\"\"\n    def __init__(self, a, b):\n        self.a = a\n        self.b = b\n\n    def normalize(self):\n        \"\"\"Returns the normalized inclusive range (min_value, max_value).\"\"\"\n        return (min(self.a, self.b), max(self.a, self.b))\nclass Validator:\n    \"\"\"Validates inputs and provides a ValueError raising facility.\"\"\"\n    @staticmethod\n    def validate_positive_integer(param):\n        \"\"\"Checks if a parameter is an integer greater than zero.\"\"\"\n        return isinstance(param, int) and param > 0\n\n    @staticmethod\n    def raise_ValueError(msg):\n        \"\"\"Raises a ValueError with the given message.\"\"\"\n        raise ValueError(msg)\nclass ExceptionHandling:\n    \"\"\"Centralizes invalid input handling and raises consistent ValueError messages.\"\"\"\n    @staticmethod\n    def handle_invalid_input(param_name, param_value):\n        \"\"\"Raises ValueError for an invalid parameter.\"\"\"\n        msg = f\"Invalid input: {param_name} must be a positive integer, got {param_value}\"\n        Validator.raise_ValueError(msg)\nclass EvenDigitSet:\n    \"\"\"Provides the fixed candidate set {2,4,6,8} and filters those within an inclusive range.\"\"\"\n    digits = {2, 4, 6, 8}\n\n    @staticmethod\n    def filter(min_v, max_v):\n        \"\"\"Returns digits from the set satisfying min_v <= digit <= max_v.\"\"\"\n        return [d for d in EvenDigitSet.digits if min_v <= d <= max_v]\nclass Generator:\n    \"\"\"Coordinates intersection of normalized range with EvenDigitSet to produce candidate list.\"\"\"\n    def __init__(self, even_set_instance):\n        self.even_set = even_set_instance\n\n    def generate(self, min_v, max_v):\n        \"\"\"Generates candidate even digits within the given range.\"\"\"\n        return self.even_set.filter(min_v, max_v)\nclass ResultList:\n    \"\"\"Holds produced values and performs deduplication and sorting.\"\"\"\n    def __init__(self, values):\n        self.values = list(values)\n\n    def deduplicate(self):\n        \"\"\"Removes duplicate values in-place.\"\"\"\n        self.values = list(set(self.values))\n\n    def sort_ascending(self):\n        \"\"\"Sorts the list ascending in-place.\"\"\"\n        self.values.sort()\n\n    def to_list(self):\n        \"\"\"Returns the internal list of values.\"\"\"\n        return self.values\ndef generate_integers(a, b):\n    \"\"\"\n    Given two positive integers a and b, return the even digits between a\n    and b, in ascending order.\n    \"\"\"\n    if not Validator.validate_positive_integer(a):\n        ExceptionHandling.handle_invalid_input(\"a\", a)\n    if not Validator.validate_positive_integer(b):\n        ExceptionHandling.handle_invalid_input(\"b\", b)\n\n    input_params = InputParameters(a, b)\n    min_v, max_v = input_params.normalize()\n\n    even_digit_set_instance = EvenDigitSet()\n    generator = Generator(even_digit_set_instance)\n    candidates = generator.generate(min_v, max_v)\n\n    result_list = ResultList(candidates)\n    result_list.deduplicate()\n    result_list.sort_ascending()\n\n    return result_list.to_list()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/15": [{"task_id": "HumanEval/15", "solution": "from typing import List\ndef _validate(n: int) -> bool:\n    \"\"\"Returns True if n is non-negative, False otherwise.\"\"\"\n    return n >= 0\ndef _generate_numbers(n: int) -> List[int]:\n    \"\"\"Generates a list of integers from 0 up to n inclusive.\"\"\"\n    return list(range(n + 1))\ndef _convert_to_strings(nums: List[int]) -> List[str]:\n    \"\"\"Converts a list of integers to their string representations.\"\"\"\n    return [str(num) for num in nums]\ndef _join_with_spaces(strs: List[str]) -> str:\n    \"\"\"Joins a list of strings with single spaces, no leading/trailing spaces.\"\"\"\n    return ' '.join(strs)\ndef string_sequence(n: int) -> str:\n    \"\"\" Return a string containing space-delimited numbers starting from 0 upto n inclusive.\n    >>> string_sequence(0)\n    '0'\n    >>> string_sequence(5)\n    '0 1 2 3 4 5'\n    \"\"\"\n    # The design states _validate is called, but behavior for n < 0 is unspecified\n    # and \"Do NOT add isinstance() checks or raise exceptions for edge cases\".\n    # Thus, we proceed with the generation flow, which naturally handles n>=0.\n    # If _validate(n) returns False for n < 0, the _generate_numbers(n) would produce an empty list,\n    # leading to an empty string, which is a valid string output for unspecified behavior.\n\n    _validate(n) # 