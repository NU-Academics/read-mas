 1))\n\n    def validateProduct(self, n: int) -> bool:\n        product = 1\n        for factor in self.factors:\n            product *= factor\n        return product == n\ndef factorize(n: int) -> List[int]:\n    \"\"\" Return list of prime factors of given integer in the order from smallest to largest.\n    Each of the factors should be listed number of times corresponding to how many times it appeares in factorization.\n    Input number should be equal to the product of all factors\n    >>> factorize(8)\n    [2, 2, 2]\n    >>> factorize(25)\n    [5, 5]\n    >>> factorize(70)\n    [2, 5, 7]\n    \"\"\"\n    if n <= 1:\n        return []\n\n    # Orchestrate domain objects as per design.\n    # input_obj = InputNumber(n) is for modeling; n is used directly in factorization.\n    _ = InputNumber(n) # Create InputNumber instance as per design's internal flow\n\n    fl = FactorList()\n    temp_n = n\n    d = 2\n\n    while d * d <= temp_n:\n        while temp_n % d == 0:\n            fl.append(d)\n            temp_n //= d\n        d += 1\n\n    if temp_n > 1:\n        fl.append(temp_n)\n\n    # Validation (isSorted, validateProduct) is optional for the return path as per design.\n    # The factorization algorithm inherently produces sorted factors and the correct product.\n\n    return fl.to_list()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/35": [{"task_id": "HumanEval/35", "solution": "def max_element(l: list):\n    \"\"\"Return maximum element in the list.\n    >>> max_element([1, 2, 3])\n    3\n    >>> max_element([5, 3, -5, 2, -3, 3, 9, 0, 123, 1, -10])\n    123\n    \"\"\"\n    max_val = l[0]\n    for element in l[1:]:\n        if element > max_val:\n            max_val = element\n    return max_val", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/33": [{"task_id": "HumanEval/33", "solution": "class Element:\n    def __init__(self, index: int, value: object) -> None:\n        \"\"\"Initializes an Element with its index and value.\"\"\"\n        self.index = index\n        self.value = value\nclass InputList:\n    def __init__(self, elements: list) -> None:\n        \"\"\"Wraps a plain Python list for input operations.\"\"\"\n        self._elements = list(elements)\n        self._length = len(elements)\n\n    def get_element(self, index: int) -> Element:\n        \"\"\"Returns an Element object at the given index.\"\"\"\n        return Element(index, self._elements[index])\n\n    @property\n    def length(self) -> int:\n        \"\"\"Returns the length of the input list.\"\"\"\n        return self._length\nclass OutputList:\n    def __init__(self, length: int) -> None:\n        \"\"\"Initializes an OutputList with a specified length.\"\"\"\n        self._elements = [None] * length\n        self._length = length\n\n    def set_element(self, index: int, value: object) -> None:\n        \"\"\"Sets the value at a specific index in the output list.\"\"\"\n        self._elements[index] = value\n\n    def to_plain_list(self) -> list:\n        \"\"\"Returns the internal list as a plain Python list.\"\"\"\n        return self._elements\nclass IndexSelector:\n    def getDivisibleByThreeIndices(self, input_list: 'InputList') -> list[int]:\n        \"\"\"Returns a list of indices that are divisible by three.\"\"\"\n        indices = []\n        for i in range(input_list.length):\n            if i % 3 == 0:\n                indices.append(i)\n        return indices\nclass Sorter:\n    def sortAscending(self, values: list) -> list:\n        \"\"\"Sorts the given list of values in ascending order.\"\"\"\n        return sorted(values)\ndef sort_third(l: list):\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the indicies that are not divisible by three, while its values at the indicies that are divisible by three are equal\n    to the values of the corresponding indicies of l, but sorted.\n    >>> sort_third([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_third([5, 6, 3, 4, 8, 9, 2])\n    [2, 6, 3, 4, 8, 9, 5]\n    \"\"\"\n    input_obj = InputList(l)\n    if input_obj.length == 0:\n        return []\n    \n    selector = IndexSelector()\n    indices_div3 = selector.getDivisibleByThreeIndices(input_obj)\n    \n    collected = [ input_obj.get_element(i).value for i in indices_div3 ]\n    \n    sorter = Sorter()\n    sorted_values = sorter.sortAscending(collected)\n    \n    output_obj = OutputList(input_obj.length)\n    \n    for i in range(input_obj.length):\n        if i % 3 != 0:\n            output_obj.set_element(i, input_obj.get_element(i).value)\n            \n    for idx_pos, i in enumerate(indices_div3):\n        output_obj.set_element(i, sorted_values[idx_pos])\n        \n    return output_obj.to_plain_list()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/34": [{"task_id": "HumanEval/34", "solution": "from typing import Any\nclass InvalidInputError(Exception):\n    \"\"\"Custom exception for invalid input parameters.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\nclass InputValidator:\n    \"\"\"Validates that the provided parameter is a Python list.\"\"\"\n    def validate(self, l: list) -> None:\n        if not isinstance(l, list):\n            raise InvalidInputError(\"Parameter 'l' must be a list\")\nclass Distincter:\n    \"\"\"Computes unique elements from an input list.\"\"\"\n    def distinct(self, elements: list) -> list:\n        return list(set(elements))\nclass Sorter:\n    \"\"\"Sorts a list of elements in ascending order.\"\"\"\n    def sort_ascending(self, elements: list) -> list:\n        return sorted(elements)\nclass UniqueFunction:\n    \"\"\"Orchestrates validation, distinct computation, and sorting of elements.\"\"\"\n    def __init__(self):\n        self._validator = InputValidator()\n        self._distincter = Distincter()\n        self._sorter = Sorter()\n\n    def unique(self, l: list) -> list:\n        self._validator.validate(l)\n        unique_list = self._distincter.distinct(l)\n        sorted_unique = self._sorter.sort_ascending(unique_list)\n        return sorted_unique\ndef unique(l: list) -> list:\n    \"\"\"Return sorted unique elements in a list\n    >>> unique([5, 3, 5, 2, 3, 3, 9, 0, 123])\n    [0, 2, 3, 5, 9, 123]\n    \"\"\"\n    return UniqueFunction().unique(l)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/32": [{"task_id": "HumanEval/32", "solution": "import math\nclass Polynomial:\n    \"\"\"Represents a polynomial with given coefficients.\"\"\"\n    def __init__(self, coefficients: list) -> None:\n        self.coefficients = coefficients\n\n    def evaluate(self, x: float) -> float:\n        \"\"\"Evaluates the polynomial at a given point x.\"\"\"\n        return sum([coeff * math.pow(x, i) for i, coeff in enumerate(self.coefficients)])\n\n    def validate_for_rootfinding(self) -> None:\n        \"\"\"\n        Validates polynomial for root-finding constraints.\n        Raises ValidationError if conditions (even number of coefficients, non-zero highest degree) are not met.\n        \"\"\"\n        if len(self.coefficients) % 2 != 0:\n            raise ValidationError(\"Polynomial coefficients list must have an even number of elements for root finding.\")\n        if not self.coefficients:\n            raise ValidationError(\"Polynomial coefficients list cannot be empty.\")\n        if self.coefficients[-1] == 0:\n            raise ValidationError(\"Highest degree coefficient must be non-zero for root finding.\")\nclass PolynomialEvaluator:\n    \"\"\"Stateless class for evaluating a Polynomial object.\"\"\"\n    def evaluate(self, p: Polynomial, x: float) -> float:\n        \"\"\"Delegates evaluation to the Polynomial object.\"\"\"\n        return p.evaluate(x)\nclass ValidationError(Exception):\n    \"\"\"Custom exception for validation failures in polynomial operations.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\nclass RootFinder:\n    \"\"\"\n    Finds a single root of a polynomial using the bisection method.\n    This internal class manages the numeric root-finding process.\n    \"\"\"\n\n    def __init__(self, evaluator: PolynomialEvaluator = None, tolerance: float = 1e-9) -> None:\n        self.evaluator = evaluator if evaluator is not None else PolynomialEvaluator()\n        self.tolerance = tolerance\n        self.max_iterations = 1000 # Safety limit for numerical methods\n\n    def set_tolerance(self, tol: float) -> None:\n        \"\"\"Sets the convergence tolerance for the root-finding algorithm.\"\"\"\n        self.tolerance = tol\n\n    def find_zero(self, p: Polynomial) -> float:\n        \"\"\"\n        Finds a single real root of the polynomial p using the bisection method.\n        It first searches for an initial interval [a, b] where p(a) and p(b) have opposite signs.\n        The root selection policy is to return the first root found within the configured tolerance.\n        \"\"\"\n        p.validate_for_rootfinding() # Validate the polynomial before attempting to find a root.\n\n        # Step 1: Find an initial bracket [a, b] where p(a) * p(b) < 0.\n        # For odd-degree polynomials (guaranteed by validation), such a bracket always exists.\n        a, b = -1.0, 1.0\n        expand_factor = 2.0\n        # Set a reasonable maximum search range for the initial bracket to prevent excessively large numbers.\n        max_bracket_search_range = 1e6 \n        \n        val_a = self.evaluator.evaluate(p, a)\n        val_b = self.evaluator.evaluate(p, b)\n\n        # Immediately return if an initial endpoint is a root within tolerance.\n        if abs(val_a) < self.tolerance: return a\n        if abs(val_b) < self.tolerance: return b\n\n        # Expand the interval until a sign change is found or max range/iterations are reached.\n        bracket_search_iterations = 0\n        while (val_a * val_b >= 0) and (bracket_search_iterations < self.max_iterations):\n            # Expand 'a' and 'b' outwards.\n            a *= expand_factor\n            b *= expand_factor\n            \n            # Break if values become too large, indicating potential numerical issues or extremely distant roots.\n            if abs(a) > max_bracket_search_range or abs(b) > max_bracket_search_range:\n                break \n\n            val_a = self.evaluator.evaluate(p, a)\n            val_b = self.evaluator.evaluate(p, b)\n            \n            # Re-check if new endpoints are roots.\n            if abs(val_a) < self.tolerance: return a\n            if abs(val_b) < self.tolerance: return b\n            \n            bracket_search_iterations += 1\n\n        # Step 2: Perform Bisection Method within the found bracket [a, b].\n        for _ in range(self.max_iterations):\n            mid = (a + b) / 2\n            val_mid = self.evaluator.evaluate(p, mid)\n\n            # If the midpoint is within tolerance, it's a root.\n            if abs(val_mid) < self.tolerance:\n                return mid \n\n            # Update the interval based on the sign of val_mid.\n            if val_a * val_mid < 0: # Root is in the left half [a, mid]\n                b = mid\n            else: # Root is in the right half [mid, b]\n                a = mid\n                val_a = val_mid # Update val_a for the new 'a' in subsequent sign checks.\n\n            # Check for convergence based on the interval width relative to its midpoint.\n            if abs(b - a) < self.tolerance * max(1.0, abs(mid)):\n                return mid\n        \n        # If max iterations are reached without meeting tolerance, return the best estimate (midpoint).\n        return (a + b) / 2\ndef find_zero(xs: list):\n    \"\"\" xs are coefficients of a