, float)):\n            raise InvalidInputError(\"All list elements must be numeric (int or float).\")\n\n    input_list_obj = InputList(l)\n\n    output_elements: List[Element] = []\n    for element_obj in input_list_obj.elements:\n        new_value = element_obj.value + 1\n        output_elements.append(Element(value=new_value, position=element_obj.position))\n\n    output_list_obj = OutputList(output_elements)\n    return output_list_obj.to_primitive_list()", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/43": [{"task_id": "HumanEval/43", "solution": "def pairs_sum_to_zero(l):\n    \"\"\"\n    pairs_sum_to_zero takes a list of integers as an input.\n    it returns True if there are two distinct elements in the list that\n    sum to zero, and False otherwise.\n    >>> pairs_sum_to_zero([1, 3, 5, 0])\n    False\n    >>> pairs_sum_to_zero([1, 3, -2, 1])\n    False\n    >>> pairs_sum_to_zero([1, 2, 3, 7])\n    False\n    >>> pairs_sum_to_zero([2, 4, -5, 3, 5, 7])\n    True\n    >>> pairs_sum_to_zero([1])\n    False\n    \"\"\"\n    if len(l) < 2:\n        return False\n\n    for i in range(len(l)):\n        for j in range(i + 1, len(l)):\n            if l[i] + l[j] == 0:\n                return True\n    return False", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/38": [{"task_id": "HumanEval/38", "solution": "class InputString:\n    def __init__(self, value: str) -> None:\n        self.value = value\n\n    def length(self) -> int:\n        return len(self.value)\n\n    def split_into_groups(self) -> list['Group']:\n        groups = []\n        s_len = len(self.value)\n        for i in range((s_len + 2) // 3):\n            start = 3 * i\n            end = min(3 * i + 3, s_len)\n            group_text = self.value[start:end]\n            groups.append(Group(group_text, i))\n        return groups\nclass Group:\n    def __init__(self, text: str, position: int) -> None:\n        self.text = text\n        self.length = len(text)\n        self.position = position\n\n    def is_full_group(self) -> bool:\n        return self.length == 3\n\n    def rotate_left(self) -> str:\n        if self.is_full_group():\n            return self.text[1:] + self.text[0]\n        else:\n            return self.text\n\n    def rotate_right(self) -> str:\n        if self.is_full_group():\n            return self.text[-1] + self.text[:-1]\n        else:\n            return self.text\nclass Decoder:\n    def __init__(self) -> None:\n        pass\n\n    def decode(self, s: str) -> str:\n        if not s:\n            return \"\"\n        input_str_obj = InputString(s)\n        groups = input_str_obj.split_into_groups()\n        decoded_group_texts = [group.rotate_right() for group in groups]\n        return DecodedString(\"\".join(decoded_group_texts)).value\nclass DecodedString:\n    def __init__(self, value: str) -> None:\n        self.value = value\ndef decode_cyclic(s: str):\n    \"\"\"\n    takes as input string encoded with encode_cyclic function. Returns decoded string.\n    \"\"\"\n    return Decoder().decode(s)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/40": [{"task_id": "HumanEval/40", "solution": "from typing import Optional\nclass InputList:\n    \"\"\"Domain container for provided list; exposes length and element access.\"\"\"\n    def __init__(self, elements: list[int]) -> None:\n        self.elements = elements\n\n    def length(self) -> int:\n        \"\"\"Returns the number of elements in the list.\"\"\"\n        return len(self.elements)\n\n    def __getitem__(self, index: int) -> int:\n        \"\"\"Allows direct indexing to access elements.\"\"\"\n        return self.elements[index]\nclass Triple:\n    \"\"\"Represent a candidate triple of three distinct indices and provide sum computation.\"\"\"\n    def __init__(self, i: int, j: int, k: int, values: InputList) -> None:\n        self.i = i\n        self.j = j\n        self.k = k\n        self.values = values\n\n    def sum(self) -> int:\n        \"\"\"Calculates the sum of the three elements at the triple's indices.\"\"\"\n        return self.values[self.i] + self.values[self.j] + self.values[self.k]\nclass Result:\n    \"\"\"Simple wrapper for the boolean result returned by the service.\"\"\"\n    def __init__(self, value: bool) -> None:\n        self.value = value\n\n    def __bool__(self) -> bool:\n        \"\"\"Enables the Result object to be used in boolean contexts.\"\"\"\n        return self.value\nclass TriplesSumZeroService:\n    \"\"\"Encapsulates validation and triple-finding responsibilities and orchestrates behavior.\"\"\"\n    def validate_length(self, l: list) -> bool:\n        \"\"\"Returns True if the input list has at least three elements, else False.\"\"\"\n        input_list = InputList(l)\n        return input_list.length() >= 3\n\n    def find_zero_sum_triple(self, l: list) -> Optional[tuple[int, int, int]]:\n        \"\"\"Searches for three distinct indices in the list whose elements sum to zero.\"\"\"\n        input_list = InputList(l)\n        n = input_list.length()\n\n        for i in range(n - 2):\n            for j in range(i + 1, n - 1):\n                for k in range(j + 1, n):\n                    triple = Triple(i, j, k, input_list)\n                    if triple.sum() == 0:\n                        return (i, j, k)\n        return None\n\n    def triples_sum_to_zero(self, l: list) -> bool:\n        \"\"\"Orchestrates validation and the search for a zero-sum triple.\"\"\"\n        if not self.validate_length(l):\n            return Result(False).__bool__()\n\n        found_triple = self.find_zero_sum_triple(l)\n        return Result(found_triple is not None).__bool__()\ndef triples_sum_to_zero(l: list):\n    \"\"\"\n    triples_sum_to_zero takes a list of integers as an input.\n    it returns True if there are three distinct elements in