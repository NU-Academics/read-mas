         return False\n        i = 5\n        while i * i <= k:\n            if k % i == 0 or k % (i + 2) == 0:\n                return False\n            i += 6\n        return True\nclass Factor:\n    \"\"\"Represents a factor (divisor) of n.\"\"\"\n    def __init__(self, value: int):\n        self.value: int = value\n\n    def isPrime(self) -> bool:\n        \"\"\"Returns True if the factor's value is prime.\"\"\"\n        k = self.value\n        if k <= 1:\n            return False\n        if k <= 3:\n            return True\n        if k % 2 == 0 or k % 3 == 0:\n            return False\n        i = 5\n        while i * i <= k:\n            if k % i == 0 or k % (i + 2) == 0:\n                return False\n            i += 6\n        return True\nclass PrimeFactorization:\n    \"\"\"Computes prime factors of an InputNumber.\"\"\"\n    def __init__(self, n: InputNumber):\n        self.n: InputNumber = n\n        self.factors: List[Factor] = []\n\n    def factorize(self) -> None:\n        \"\"\"Populates self.factors with Factor instances that are prime factors of n.value.\"\"\"\n        num = self.n.value\n        temp_num = num\n        d = 2\n\n        # Handle factor 2\n        while temp_num % d == 0:\n            self.factors.append(Factor(d))\n            temp_num //= d\n\n        # Handle odd factors starting from 3\n        d = 3\n        while d * d <= temp_num:\n            while temp_num % d == 0:\n                self.factors.append(Factor(d))\n                temp_num //= d\n            d += 2 # Increment by 2 to check only odd numbers\n\n        # If temp_num is still greater than 1, it must be a prime factor itself\n        if temp_num > 1:\n            self.factors.append(Factor(temp_num))\n\n    def largestFactor(self) -> int:\n        \"\"\"Returns the integer value of the largest prime factor.\"\"\"\n        # Precondition (n > 1 and not prime) implies self.factors will not be empty.\n        return max(f.value for f in self.factors)\nclass La