{"task_id": "HumanEval/85", "solution": "def add(lst):\n    \"\"\"Given a non-empty list of integers, sums the even elements that are located at odd indices.\n    Raises `ValueError` if the input list is empty.\n    \"\"\"\n    if not lst:\n        raise ValueError(\"Input list cannot be empty.\")\n\n    total_sum = 0\n    for i in range(1, len(lst), 2):  # Start from index 1 (first odd index), step by 2.\n        element = lst[i]\n        if element % 2 == 0:\n            total_sum += element\n    return total_sum"}
{"task_id": "HumanEval/84", "solution": "def solve(N: int) -> str:\n    \"\"\"Given a positive integer N, return the total sum of its digits in binary.\n    Constraints: 0 <= N <= 10000.\n    \"\"\"\n\n    # Validate input N against the specified range (0 <= N <= 10000).\n    if not isinstance(N, int):\n        raise TypeError(\"Input N must be an integer.\")\n    if not (0 <= N <= 10000):\n        raise ValueError(\"Input N must be between 0 and 10000 inclusive.\")\n\n    # Calculate the sum of decimal digits of N.\n    digit_sum = 0\n    temp_N = N\n    while temp_N > 0:\n        digit_sum += temp_N % 10\n        temp_N //= 10\n\n    # Convert the calculated sum to its binary string representation.\n    if digit_sum == 0:\n        return \"0\"\n    \n    binary_str = \"\"\n    temp_sum = digit_sum\n    while temp_sum > 0:\n        binary_str = (\"1\" if temp_sum % 2 == 1 else \"0\") + binary_str\n        temp_sum //= 2\n    return binary_str"}
