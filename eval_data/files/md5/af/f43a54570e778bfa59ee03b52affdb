{"task_id": "HumanEval/142", "solution": "def sum_squares(lst):\n    \"\"\"\n    Processes a list of integers, applying index-based transformations,\n    and returns the sum of the transformed elements. Raises TypeError for invalid input.\n    \"\"\"\n    if not isinstance(lst, list):\n        raise TypeError(\"Input must be a list.\")\n\n    total_sum = 0\n    for i, val in enumerate(lst):\n        if not isinstance(val, int):\n            raise TypeError(f\"List element at index {i} is not an integer: {val}\")\n\n        transformed_val = val\n        if i % 3 == 0:\n            transformed_val = val ** 2\n        elif i % 4 == 0: # This 'elif' ensures precedence for multiples of 3.\n            transformed_val = val ** 3\n        \n        total_sum += transformed_val\n    \n    return total_sum"}
{"task_id": "HumanEval/144", "solution": "class Fraction:\n    def __init__(self, numerator: int, denominator: int):\n        # Initializes a new Fraction object with given numerator and denominator.\n        if not isinstance(numerator, int) or not isinstance(denominator, int):\n            raise ValueError(\"Numerator and denominator must be integers.\")\n        if denominator <= 0:\n            raise ValueError(\"Denominator must be a positive whole number.\")\n        self._numerator = numerator\n        self._denominator = denominator\n\n    @property\n    def numerator(self) -> int:\n        return self._numerator\n\n    @property\n    def denominator(self) -> int:\n        return self._denominator\n\n    def multiply(self, other: 'Fraction') -> 'Fraction':\n        # Multiplies this fraction by another Fraction object.\n        new_numerator = self.numerator * other.numerator\n        new_denominator = self.denominator * other.denominator\n        return Fraction(new_numerator, new_denominator)\n\n    def is_whole_number(self) -> bool:\n        # Checks if the fraction represents a whole number.\n        return self.numerator % self.denominator == 0\n\n    def __repr__(self) -> str:\n        return f\"Fraction({self.numerator}/{self.denominator})\"\nclass FractionParser:\n    @staticmethod\n    def parse_fraction_string(fraction_str: str) -> Fraction:\n        # Parses a string in \"numerator/denominator\" format into a Fraction object.\n        try:\n            parts = fraction_str.split('/')\n            if len(parts) != 2:\n                raise ValueError(\"Fraction string must be in 'numerator/denominator' format.\")\n            numerator = int(parts[0])\n            denominator = int(parts[1])\n            return Fraction(numerator, denominator)\n        except ValueError as e:\n            # Re-raise ValueError with more context for invalid fraction strings.\n            raise ValueError(f\"Invalid fraction string '{fraction_str}': {e}\")\n        except Exception:\n            # Catch unexpected errors during parsing.\n            raise ValueError(f\"Unexpected error parsing fraction string '{fraction_str}'.\")\nclass FractionService:\n    def simplify(self, x: str, n: str) -> bool:\n        # Parses two fraction strings, multiplies them, and checks if the product is a whole number.\n        fraction_x = FractionParser.parse_fraction_string(x)\n        fraction_n = FractionParser.parse_fraction_string(n)\n\n        product_fraction = fraction_x.multiply(fraction_n)\n\n        return product_fraction.is_whole_number()\ndef simplify(x: str, n: str) -> bool:\n    \"\"\"Your task is to implement a function that will simplify the expression\n    x * n. The function returns True if x * n evaluates to a whole number and False\n    otherwise. Both x and n, are string representation of a fraction, and have the following format,\n    <numerator>/<denominator> where both numerator and denominator are positive whole numbers.\n\n    You can assume that x, and n are valid fractions, and do not have zero as denominator.\n\n    simplify(\"1/5\", \"5/1\") = True\n    simplify(\"1/6\", \"2/1\") = False\n    simplify(\"7/10\", \"10/2\") = False\n    \"\"\"\n    service = FractionService()\n    return service.simplify(x, n)"}
{"task_id": "HumanEval/146", "solution": "def specialFilter(nums):\n    \"\"\"\n    Counts numbers in an array that are greater than 10 and have both \n    their first and last digits as odd.\n    \"\"\"\n    count = 0\n    for num in nums:\n        # Check if the number is strictly greater than 10.\n        if num > 10:\n            abs_num = abs(num)\n            \n            # Extract the first and last digits of the absolute value.\n            first_digit = int(str(abs_num)[0])\n            last_digit = abs_num % 10\n\n            # Check if both first and last digits are odd.\n            if first_digit % 2 != 0 and last_digit % 2 != 0:\n                count += 1\n    return count"}
{"task_id": "HumanEval/144", "solution": "def gcd(a: int, b: int) -> int:\n    \"\"\"Calculates the greatest common divisor (GCD) of two integers using the Euclidean algorithm.\"\"\"\n    while b:\n        a, b = b, a % b\n    return a\nclass Fraction:\n    \"\"\"Represents a mathematical fraction and provides operations for parsing, multiplication, and checking if it's a whole number.\"\"\"\n    def __init__(self, numerator: int, denominator: int):\n        \"\"\"Initializes a Fraction object with a given numerator and denominator, then simplifies it.\"\"\"\n        if denominator == 0:\n            raise ValueError(\"Denominator cannot be zero.\")\n        self._numerator = numerator\n        self._denominator = denominator\n        self._simplify()\n\n    def _simplify(self):\n        \"\"\"Simplifies the fraction by dividing both numerator and denominator by their greatest common divisor.\"\"\"\n        common = gcd(abs(self._numerator), abs(self._denominator))\n        self._numerator //= common\n        self._denominator //= common\n        # Ensure denominator is always positive for canonical representation.\n        if self._denominator < 0:\n            self._numerator *= -1\n            self._denominator *= -1\n\n    @classmethod\n    def from_string(cls, fraction_str: str) -> 'Fraction':\n        \"\"\"Parses a string representation of a fraction (e.g., \"1/5\") into a Fraction object.\"\"\"\n        parts = fraction_str.split('/')\n        numerator = int(parts[0])\n        denominator = int(parts[1])\n        return cls(numerator, denominator)\n\n    def multiply(self, other: 'Fraction') -> 'Fraction':\n        \"\"\"Multiplies this fraction by another Fraction object and returns a new, simplified Fraction.\"\"\"\n        new_numerator = self._numerator * other._numerator\n        new_denominator = self._denominator * other._denominator\n        return Fraction(new_numerator, new_denominator)\n\n    def is_whole_number(self) -> bool:\n        \"\"\"Checks if the fraction represents a whole number (i.e., its denominator is 1 after simplification).\"\"\"\n        return self._denominator == 1\n\n    def __repr__(self) -> str:\n        \"\"\"Provides a string representation of the Fraction object for debugging purposes.\"\"\"\n        return f\"{self._numerator}/{self._denominator}\"\ndef simplify(x: str, n: str) -> bool:\n    \"\"\"\n    Simplifies the expression x * n. Returns True if x * n evaluates to a whole number\n    and False otherwise. Both x and n are string representations of a fraction.\n    \"\"\"\n    fraction_x = Fraction.from_string(x)\n    fraction_n = Fraction.from_string(n)\n    \n    product_fraction = fraction_x.multiply(fraction_n)\n    \n    return product_fraction.is_whole_number()"}
{"task_id": "HumanEval/145", "solution": "def _sum_digits(n: int) -> int:\n    \"\"\"Calculates the sum of the absolute value of digits for an integer.\"\"\"\n    s = 0\n    for digit in str(abs(n)):\n        s += int(digit)\n    return s\ndef order_by_points(nums: list[int]) -> list[int]:\n    \"\"\"\n    Sorts a list of integers by the sum of their digits,\n    using the original index as a tie-breaker.\n    \"\"\"\n    if not nums:\n        return []\n\n    # Create a list of tuples: (sum_of_digits, original_index, value) for sorting.\n    decorated_list = []\n    for i, num in enumerate(nums):\n        decorated_list.append((_sum_digits(num), i, num))\n\n    # Sort the decorated list; Python's Timsort handles tuple comparison lexicographically,\n    # sorting by digit sum then by original index for tie-breaking.\n    decorated_list.sort()\n\n    # Extract the original numbers in the new sorted order.\n    return [item[2] for item in decorated_list]"}
{"task_id": "HumanEval/145", "solution": "class PointedNumber:\n    \"\"\"\n    A data class to hold an integer, its sum of digits, and its original index.\n    Used for custom sorting.\n    \"\"\"\n    def __init__(self, value: int, digit_sum: int, original_index: int):\n        self._value = value\n        self._digit_sum = digit_sum\n        self._original_index = original_index\n\n    def __lt__(self, other: 'PointedNumber') -> bool:\n        \"\"\"\n        Defines the less-than comparison for sorting.\n        Compares first by digit_sum, then by original_index.\n        \"\"\"\n        if self._digit_sum == other._digit_sum:\n            return self._original_index < other._original_index\n        return self._digit_sum < other._digit_sum\n\n    def get_value(self) -> int:\n        \"\"\"Returns the original integer value.\"\"\"\n        return self._value\ndef _sum_digits(num: int) -> int:\n    \"\"\"\n    Calculates the sum of the absolute value of digits for a given integer.\n    \"\"\"\n    s = 0\n    # Use absolute value for digit sum calculation.\n    abs_num = abs(num)\n    if abs_num == 0:\n        return 0\n    while abs_num > 0:\n        s += abs_num % 10\n        abs_num //= 10\n    return s\ndef order_by_points(nums: list[int]) -> list[int]:\n    \"\"\"\n    Sorts the given list of integers in ascending order according to the sum of their digits.\n    If there are several items with similar sum of their digits,\n    order them based on their index in original list.\n    \"\"\"\n    if not nums:\n        return []\n\n    # Create a list of PointedNumber objects for custom sorting.\n    pointed_numbers = []\n    for i, num in enumerate(nums):\n        digit_sum = _sum_digits(num)\n        pointed_numbers.append(PointedNumber(num, digit_sum, i))\n\n    # Sort the list of PointedNumber objects using their custom comparison.\n    pointed_numbers.sort()\n\n    # Extract the original values from the sorted PointedNumber objects.\n    return [pn.get_value() for pn in pointed_numbers]"}
{"task_id": "HumanEval/146", "solution": "def is_odd_digit(digit: int) -> bool:\n    \"\"\"Checks if a given single digit is odd.\"\"\"\n    return digit % 2 != 0\ndef get_first_digit(num: int) -> int:\n    \"\"\"Extracts the first digit of an integer (considering its absolute value).\"\"\"\n    abs_num_str = str(abs(num))\n    return int(abs_num_str[0])\ndef get_last_digit(num: int) -> int:\n    \"\"\"Extracts the last digit of an integer (considering its absolute value).\"\"\"\n    abs_num_str = str(abs(num))\n    return int(abs_num_str[-1])\ndef specialFilter(nums: list[int]) -> int:\n    \"\"\"Counts numbers in a list that are greater than 10 and have both odd first and last digits.\n    Negative numbers use their absolute value for digit extraction.\"\"\"\n    count = 0\n    for num in nums:\n        if num > 10:\n            first_digit = get_first_digit(num)\n            last_digit = get_last_digit(num)\n\n            if is_odd_digit(first_digit) and is_odd_digit(last_digit):\n                count += 1\n    return count"}
{"task_id": "HumanEval/147", "solution": "def get_max_triples(n: int) -> int:\n    \"\"\"\n    Calculates the number of specific integer triples from a generated array.\n    Returns the count of triples (a[i], a[j], a[k]) such that i < j < k and their sum is a multiple of 3.\n    \"\"\"\n    if n < 1:\n        raise ValueError(\"Input n must be a positive integer.\")\n\n    count_rem0 = 0 # Count of elements a[i] such that a[i] % 3 == 0\n    count_rem1 = 0 # Count of elements a[i] such that a[i] % 3 == 1\n\n    # Based on a[i] = i*i - i + 1:\n    # a[i] % 3 is 0 if i % 3 == 2.\n    # a[i] % 3 is 1 if i % 3 == 0 or i % 3 == 1.\n    for i in range(1, n + 1):\n        if i % 3 == 2:\n            count_rem0 += 1\n        else:\n            count_rem1 += 1\n\n    def combinations_3(count: int) -> int:\n        \"\"\"Calculates nC3 (combinations of 3 items from 'count').\"\"\"\n        if count < 3:\n            return 0\n        return (count * (count - 1) * (count - 2)) // 6\n\n    # A sum of three elements (r1 + r2 + r3) is a multiple of 3 if:\n    # (0, 0, 0) or (1, 1, 1) are the remainders modulo 3.\n    total_triples = combinations_3(count_rem0) + combinations_3(count_rem1)\n    \n    return total_triples"}
{"task_id": "HumanEval/147", "solution": "def get_max_triples(n: int) -> int:\n    \"\"\"\n    Calculates the number of triples (a[i], a[j], a[k]) from a generated array 'a'\n    such that i < j < k and a[i] + a[j] + a[k] is a multiple of 3.\n    \"\"\"\n    # Validate input 'n' must be a positive integer.\n    # Raises ValueError for invalid 'n' to ensure robustness.\n    if not isinstance(n, int) or n <= 0:\n        raise ValueError(\"Input 'n' must be a positive integer.\")\n\n    # If n is less than 3, no triples can be formed.\n    if n < 3:\n        return 0\n\n    # Generate array 'a' where a[i] = i*i - i + 1 (1-based i).\n    # This translates to (idx+1)*(idx+1) - (idx+1) + 1 for 0-based idx.\n    arr = [(i * i - i + 1) for i in range(1, n + 1)]\n\n    # Count elements based on their remainder modulo 3 for O(N) complexity.\n    remainder_counts = [0, 0, 0]\n    for x in arr:\n        remainder_counts[x % 3] += 1\n\n    count = 0\n    c0, c1, c2 = remainder_counts[0], remainder_counts[1], remainder_counts[2]\n\n    # Add combinations where all three elements have the same remainder.\n    # For (0,0,0), (1,1,1), (2,2,2) sums are multiples of 3.\n    count += (c0 * (c0 - 1) * (c0 - 2)) // 6\n    count += (c1 * (c1 - 1) * (c1 - 2)) // 6\n    count += (c2 * (c2 - 1) * (c2 - 2)) // 6\n\n    # Add combinations where elements have remainders (0, 1, 2).\n    # Their sum (0+1+2=3) is a multiple of 3.\n    count += c0 * c1 * c2\n\n    return count"}
