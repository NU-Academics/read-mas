{"task_id": "HumanEval/41", "solution": "class CollisionParameters:\n    \"\"\"\n    Represents the input parameters for the car collision calculation.\n    \"\"\"\n    def __init__(self, n: int):\n        if not isinstance(n, int):\n            raise TypeError(\"n must be an integer.\")\n        if n < 0:\n            raise ValueError(\"n cannot be negative.\")\n        self.n = n\nclass CollisionResult:\n    \"\"\"\n    Represents the result of the car collision calculation.\n    \"\"\"\n    def __init__(self, collision_count: int):\n        if not isinstance(collision_count, int):\n            raise TypeError(\"collision_count must be an integer.\")\n        self.collision_count = collision_count\nclass CollisionCalculator:\n    \"\"\"\n    Handles the core logic for calculating car collisions.\n    \"\"\"\n    def calculate_collisions(self, params: CollisionParameters) -> CollisionResult:\n        \"\"\"\n        Calculates the total number of collisions.\n        This includes an explicit check for negative 'n'.\n        \"\"\"\n        # Ensure n is non-negative before calculation.\n        # This check complements validation in CollisionParameters.\n        if params.n < 0:\n            raise ValueError(\"Number of cars (n) cannot be negative.\")\n        \n        total_collisions = params.n * params.n\n        return CollisionResult(total_collisions)\ndef car_race_collision(n: int) -> int:\n    \"\"\"\n    Calculates the number of collisions for n cars moving in opposite directions.\n    Each car from one set collides with every car from the other set.\n    \"\"\"\n    try:\n        params = CollisionParameters(n)\n        calculator = CollisionCalculator()\n        result = calculator.calculate_collisions(params)\n        return result.collision_count\n    except (TypeError, ValueError) as e:\n        raise e # Re-raise validation errors"}
{"task_id": "HumanEval/43", "solution": "def pairs_sum_to_zero(l):\n    \"\"\"\n    pairs_sum_to_zero takes a list of integers as an input.\n    it returns True if there are two distinct elements in the list that\n    sum to zero, and False otherwise.\n    \"\"\"\n    seen_numbers = set()\n    zero_count = 0\n\n    for num in l:\n        if num == 0:\n            zero_count += 1\n            if zero_count >= 2:\n                return True\n        \n        complement = -num\n        # Check if the complement has been seen and is distinct from the current number.\n        if complement in seen_numbers and num != complement:\n            return True\n        \n        seen_numbers.add(num)\n            \n    return False"}
{"task_id": "HumanEval/13", "solution": "def greatest_common_divisor(a: int, b: int) -> int:\n    \"\"\"Return a greatest common divisor of two integers a and b.\n    It uses the Euclidean algorithm and handles zero and negative inputs correctly.\n    \"\"\"\n    if not isinstance(a, int) or not isinstance(b, int):\n        raise TypeError(\"Inputs must be integers.\")\n\n    a = abs(a)\n    b = abs(b)\n\n    while b:\n        a, b = b, a % b\n    return a"}
{"task_id": "HumanEval/44", "solution": "def change_base(x: int, base: int):\n    \"\"\"Change numerical base of input number x to base.\n    Returns string representation after the conversion.\n    \"\"\"\n    if not isinstance(x, int) or x < 0:\n        raise ValueError(\"Input number 'x' must be a non-negative integer.\")\n\n    if not isinstance(base, int) or not (2 <= base <= 9):\n        raise ValueError(\"Base must be an integer between 2 and 9 (inclusive).\")\n\n    if x == 0:\n        return \"0\"\n\n    result_digits = []\n    current_x = x\n    while current_x > 0:\n        remainder = current_x % base\n        result_digits.append(str(remainder))\n        current_x //= base\n\n    return \"\".join(result_digits[::-1])"}
{"task_id": "HumanEval/44", "solution": "def change_base(x: int, base: int):\n    \"\"\"Converts a non-negative integer x (base 10) to its string representation in the specified base.\n    The target base must be an integer between 2 and 9.\n    \"\"\"\n    if not isinstance(x, int) or x < 0:\n        raise ValueError(\"Input number x must be a non-negative integer.\")\n    if not isinstance(base, int) or not (2 <= base <= 9):\n        raise ValueError(\"Base must be an integer between 2 and 9.\")\n\n    if x == 0:\n        return \"0\"\n\n    result = []\n    while x > 0:\n        remainder = x % base\n        result.append(str(remainder))\n        x //= base\n    return \"\".join(result[::-1])"}
{"task_id": "HumanEval/46", "solution": "def fib4(n: int) -> int:\n    \"\"\"Computes the n-th Fib4 number iteratively, using memoization for O(n) efficiency.\n    Raises `ValueError` if `n` is negative.\n    \"\"\"\n    if n < 0:\n        raise ValueError(\"Input 'n' must be a non-negative integer.\")\n\n    if n == 0:\n        return 0\n    if n == 1:\n        return 0\n    if n == 2:\n        return 2\n    if n == 3:\n        return 0\n\n    # Initialize a list to store Fib4 numbers, fib4_sequence[i] will store fib4(i).\n    fib4_sequence = [0] * (n + 1)\n    fib4_sequence[0] = 0\n    fib4_sequence[1] = 0\n    fib4_sequence[2] = 2\n    fib4_sequence[3] = 0\n\n    for i in range(4, n + 1):\n        fib4_sequence[i] = (\n            fib4_sequence[i-1] +\n            fib4_sequence[i-2] +\n            fib4_sequence[i-3] +\n            fib4_sequence[i-4]\n        )\n    return fib4_sequence[n]"}
