{"task_id": "HumanEval/89", "solution": "def encrypt(s: str) -> str:\n    \"\"\"Encrypts a string by rotating its alphabetic characters. Letters shift down by 4 places, wrapping around the alphabet.\"\"\"\n    if not isinstance(s, str):\n        raise TypeError(\"Input must be a string.\")\n\n    SHIFT_AMOUNT = 4\n    encrypted_chars = []\n\n    for char in s:\n        if 'a' <= char <= 'z':\n            base = ord('a')\n            offset = ord(char) - base\n            rotated_offset = (offset + SHIFT_AMOUNT) % 26\n            encrypted_chars.append(chr(base + rotated_offset))\n        elif 'A' <= char <= 'Z':\n            base = ord('A')\n            offset = ord(char) - base\n            rotated_offset = (offset + SHIFT_AMOUNT) % 26\n            encrypted_chars.append(chr(base + rotated_offset))\n        else:\n            encrypted_chars.append(char)\n    \n    return \"\".join(encrypted_chars)"}
{"task_id": "HumanEval/88", "solution": "def sort_array(array):\n    \"\"\"\n    Given an array of non-negative integers, return a copy of the given array after sorting,\n    you will sort the given array in ascending order if the sum( first index value, last index value) is odd,\n    or sort it in descending order if the sum( first index value, last index value) is even.\n    \"\"\"\n    # Validate array type and elements as non-negative integers.\n    if not isinstance(array, list):\n        raise ValueError(\"Input must be a list.\")\n    for item in array:\n        if not isinstance(item, int) or item < 0:\n            raise ValueError(\"All elements in the array must be non-negative integers.\")\n\n    # Handle empty array edge case.\n    if not array:\n        return []\n\n    # Handle single-element array edge case.\n    if len(array) == 1:\n        return array[:] # Return a copy to ensure original is unchanged.\n\n    # Determine sorting order based on the sum of first and last elements.\n    first_element = array[0]\n    last_element = array[-1]\n    sum_of_ends = first_element + last_element\n\n    # If sum is even, sort descending (reverse=True); if odd, sort ascending (reverse=False).\n    sort_in_descending = (sum_of_ends % 2 == 0)\n\n    # Create a copy to avoid modifying the original array, then sort it.\n    sorted_copy = array[:]\n    sorted_copy.sort(reverse=sort_in_descending)\n    return sorted_copy"}
{"task_id": "HumanEval/91", "solution": "import re\nclass SentenceSplitter:\n    \"\"\"Splits text into sentences based on common delimiters.\n    It uses '.', '?', '!' followed by optional whitespace as delimiters.\n    \"\"\"\n    def split_sentences(self, text: str) -> list[str]:\n        \"\"\"Splits the input text into a list of cleaned sentences.\"\"\"\n        sentences = re.split(r'[.?!]\\s*', text)\n        return [s.strip() for s in sentences if s.strip()]\nclass WordChecker:\n    \"\"\"Checks if a sentence starts with the case-sensitive word 'I'.\n    It considers 'I' a word if followed by a space or if it's the entire sentence.\n    \"\"\"\n    def starts_with_i(self, sentence: str) -> bool:\n        \"\"\"Checks if the trimmed sentence's first word is exactly 'I'.\"\"\"\n        trimmed_sentence = sentence.strip()\n        if not trimmed_sentence:\n            return False\n        return trimmed_sentence.startswith(\"I \") or trimmed_sentence == \"I\"\nclass BoredomCounterService:\n    \"\"\"Orchestrates counting sentences starting with 'I'.\n    It uses SentenceSplitter to parse text and WordChecker to evaluate sentences.\n    \"\"\"\n    def __init__(self, sentence_splitter: SentenceSplitter, word_checker: WordChecker):\n        self._sentence_splitter = sentence_splitter\n        self._word_checker = word_checker\n\n    def is_bored(self, text: str) -> int:\n        \"\"\"Counts sentences starting with 'I' in the given text.\"\"\"\n        boredom_count = 0\n        sentences = self._sentence_splitter.split_sentences(text)\n        for sentence in sentences:\n            if self._word_checker.starts_with_i(sentence):\n                boredom_count += 1\n        return boredom_count\n_sentence_splitter_instance = SentenceSplitter()\n_word_checker_instance = WordChecker()\n_boredom_service_instance = BoredomCounterService(_sentence_splitter_instance, _word_checker_instance)\ndef is_bored(S: str) -> int:\n    \"\"\"\n    Counts sentences starting with \"I\" in a given string.\n    Sentences are delimited by '.', '?' or '!'.\n    \"\"\"\n    return _boredom_service_instance.is_bored(S)"}
