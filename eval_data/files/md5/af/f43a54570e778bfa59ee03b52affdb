{"task_id": "HumanEval/36", "solution": "class DigitCounter:\n    def count_digit(self, number: int, digit: int) -> int:\n        \"\"\"Counts how many times a specific digit appears in a number.\"\"\"\n        if number < 0:\n            number = abs(number)\n        return str(number).count(str(digit))\nclass FizzBuzzService:\n    def __init__(self, digit_counter: DigitCounter):\n        self._digit_counter = digit_counter\n\n    def calculate(self, n: int) -> int:\n        \"\"\"\n        Calculates the count of the digit '7' in numbers less than n,\n        which are divisible by 11 or 13.\n        \"\"\"\n        total_sevens_count = 0\n        for i in range(1, n):\n            if i % 11 == 0 or i % 13 == 0:\n                total_sevens_count += self._digit_counter.count_digit(i, 7)\n        return total_sevens_count\ndef fizz_buzz(n: int) -> int:\n    \"\"\"\n    Return the number of times the digit 7 appears in integers less than n\n    which are divisible by 11 or 13.\n    \"\"\"\n    digit_counter = DigitCounter()\n    fizzbuzz_service = FizzBuzzService(digit_counter)\n    return fizzbuzz_service.calculate(n)"}
{"task_id": "HumanEval/11", "solution": "class InvalidBinaryStringError(ValueError):\n    \"\"\"Raised when an input string contains characters other than '0' or '1'.\n    It includes a descriptive message about the error.\n    \"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\nclass MismatchedLengthError(ValueError):\n    \"\"\"Raised when two binary strings have different lengths for XOR operation.\n    It indicates that the lengths of the inputs do not match.\n    \"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\ndef string_xor(a: str, b: str) -> str:\n    \"\"\"\n    Computes the bitwise XOR of two binary strings.\n    Raises InvalidBinaryStringError or MismatchedLengthError for invalid inputs.\n    \"\"\"\n    if not a or not b:\n        raise InvalidBinaryStringError(\"Input strings cannot be empty.\")\n\n    if not all(char in '01' for char in a):\n        raise InvalidBinaryStringError(f\"String 'a' contains non-binary characters: '{a}'\")\n    if not all(char in '01' for char in b):\n        raise InvalidBinaryStringError(f\"String 'b' contains non-binary characters: '{b}'\")\n\n    if len(a) != len(b):\n        raise MismatchedLengthError(f\"Input strings must have the same length. Got {len(a)} and {len(b)}.\")\n\n    result_list = []\n    for i in range(len(a)):\n        bit_a = int(a[i])\n        bit_b = int(b[i])\n        xor_result = bit_a ^ bit_b\n        result_list.append(str(xor_result))\n\n    return \"\".join(result_list)"}
{"task_id": "HumanEval/0", "solution": "from typing import List\ndef has_close_elements(numbers: List[float], threshold: float) -> bool:\n    \"\"\" Check if in given list of numbers, are any two numbers closer to each other than\n    given threshold.\n    >>> has_close_elements([1.0, 2.0, 3.0], 0.5)\n    False\n    >>> has_close_elements([1.0, 2.8, 3.0, 4.0, 5.0, 2.0], 0.3)\n    True\n    \"\"\"\n    _validate_numbers_list(numbers)\n    _validate_threshold(threshold)\n\n    if len(numbers) < 2:\n        return False\n\n    for i in range(len(numbers)):\n        for j in range(i + 1, len(numbers)):\n            if abs(numbers[i] - numbers[j]) < threshold:\n                return True\n    return False"}
{"task_id": "HumanEval/72", "solution": "def will_it_fly(q, w):\n    # Check if the list q is a palindrome by comparing it to its reverse.\n    # This operation has a time complexity of O(N).\n    if q != q[::-1]:\n        return False\n\n    # Calculate the sum of all elements in the list q.\n    # Python's built-in sum() function is efficient, taking O(N) time.\n    list_sum = sum(q)\n\n    # Return True if the sum is within the threshold, False otherwise.\n    return list_sum <= w"}
