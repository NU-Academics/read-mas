{"task_id": "HumanEval/109", "solution": "def move_one_ball(arr: list[int]) -> bool:\n    \"\"\"Determines if an array can be sorted in non-decreasing order by\n    performing right shift operations. Returns True if sortable, False otherwise.\n    \"\"\"\n    if not arr:\n        return True\n\n    n = len(arr)\n    sorted_arr = sorted(arr)\n    current_arr = list(arr) # Create a mutable copy to perform shifts on.\n\n    for _ in range(n): # Iterate up to N times to check all possible shift configurations.\n        if current_arr == sorted_arr:\n            return True\n        # Perform a right shift: move the last element to the front.\n        last_element = current_arr[-1]\n        current_arr = [last_element] + current_arr[:-1]\n\n    return False"}
{"task_id": "HumanEval/110", "solution": "def exchange(lst1, lst2):\n    \"\"\"Determines if lst1 can be transformed into a list of only even numbers\n    by exchanging elements with lst2.\n    \"\"\"\n    # Count odd numbers in lst1 that need to be replaced.\n    odd_count_lst1 = sum(1 for x in lst1 if x % 2 != 0)\n\n    # Count even numbers in lst2 that can be used for replacement.\n    even_count_lst2 = sum(1 for x in lst2 if x % 2 == 0)\n\n    # Return \"YES\" if there are enough even numbers in lst2, otherwise \"NO\".\n    if odd_count_lst1 <= even_count_lst2:\n        return \"YES\"\n    else:\n        return \"NO\""}
{"task_id": "HumanEval/112", "solution": "def reverse_delete(s,c):\n    \"\"\"\n    Deletes characters from 's' that are in 'c' and checks if the result is a palindrome.\n    Returns a tuple containing the filtered string and a boolean indicating if it's a palindrome.\n    \"\"\"\n    if not isinstance(s, str):\n        raise TypeError(\"Parameter 's' must be a string.\")\n    if not isinstance(c, str):\n        raise TypeError(\"Parameter 'c' must be a string.\")\n\n    filtered_s = \"\".join(char for char in s if char not in c)\n    is_palindrome_result = (filtered_s == filtered_s[::-1])\n    \n    return (filtered_s, is_palindrome_result)"}
{"task_id": "HumanEval/114", "solution": "from typing import List\ndef minSubArraySum(nums: List[int]) -> int:\n    \"\"\"\n    Given an array of integers nums, find the minimum sum of any non-empty sub-array\n    of nums.\n    \"\"\"\n    if not nums:\n        raise ValueError(\"Input array cannot be empty.\")\n\n    min_so_far = float('inf')\n    current_min = 0\n\n    for x in nums:\n        current_min += x\n        min_so_far = min(min_so_far, current_min)\n        if current_min > 0:\n            current_min = 0\n            \n    return min_so_far"}
{"task_id": "HumanEval/113", "solution": "def odd_count(lst: list[str]) -> list[str]:\n    \"\"\"Given a list of strings, where each string consists of only digits, return a list.\n    Each element i of the output should be \"the number of odd elements in the\n    string i of the input.\" where all the i's should be replaced by the number\n    of odd digits in the i'th string of the input.\n\n    >>> odd_count(['1234567'])\n    [\"the number of odd elements 4n the str4ng 4 of the 4nput.\"]\n    >>> odd_count(['3',\"11111111\"])\n    [\"the number of odd elements 1n the str1ng 1 of the 1nput.\",\n     \"the number of odd elements 8n the str8ng 8 of the 8nput.\"]\n    \"\"\"\n\n    class StringProcessor:\n        OUTPUT_TEMPLATE = \"the number of odd elements {count}n the str{count}ng {count} of the {count}nput.\"\n\n        def count_odd_digits(self, digit_string: str) -> int:\n            \"\"\"Counts the number of odd digits in a given string. Assumes digit_string contains only digits.\"\"\"\n            odd_count = 0\n            for char_digit in digit_string:\n                if int(char_digit) % 2 != 0:\n                    odd_count += 1\n            return odd_count\n\n        def format_result_string(self, count: int) -> str:\n            \"\"\"Formats the result string using the OUTPUT_TEMPLATE and the provided count.\"\"\"\n            return self.OUTPUT_TEMPLATE.format(count=count)\n\n    class OddCounterService:\n        def __init__(self, string_processor: StringProcessor):\n            \"\"\"Initializes the service with a StringProcessor instance.\"\"\"\n            self.string_processor = string_processor\n\n        def odd_count(self, lst: list[str]) -> list[str]:\n            \"\"\"Processes a list of digit strings to count odd digits and format results.\"\"\"\n            results = []\n            for digit_string in lst:\n                odd_count_value = self.string_processor.count_odd_digits(digit_string)\n                formatted_string = self.string_processor.format_result_string(odd_count_value)\n                results.append(formatted_string)\n            return results\n\n    # Instantiate the helper classes globally as suggested in the design to provide the top-level function\n    _string_processor_instance = StringProcessor()\n    _odd_counter_service_instance = OddCounterService(_string_processor_instance)\n\n    return _odd_counter_service_instance.odd_count(lst)"}
{"task_id": "HumanEval/114", "solution": "def minSubArraySum(nums):\n    \"\"\"\n    Given an array of integers nums, find the minimum sum of any non-empty sub-array\n    of nums.\n    Example\n    minSubArraySum([2, 3, 4, 1, 2, 4]) == 1\n    minSubArraySum([-1, -2, -3]) == -6\n    \"\"\"\n    min_so_far = nums[0]\n    current_min = nums[0]\n\n    for i in range(1, len(nums)):\n        current_min = min(nums[i], current_min + nums[i])\n        min_so_far = min(min_so_far, current_min)\n\n    return min_so_far"}
{"task_id": "HumanEval/115", "solution": "import math\ndef max_fill(grid, capacity):\n    \"\"\"\n    Calculates the total number of times buckets must be lowered to empty wells.\n    Each 1 in the grid represents a unit of water; all buckets have the same capacity.\n    \"\"\"\n    total_operations = 0\n    for well_row in grid:\n        water_units = sum(well_row)  # Calculate total water units in the current well.\n        if water_units > 0:\n            # Calculate operations for this well, rounding up for partial buckets.\n            total_operations += math.ceil(water_units / capacity)\n    return total_operations"}
{"task_id": "HumanEval/113", "solution": "from typing import List\nclass InvalidInputError(ValueError):\n    \"\"\"Custom exception for invalid digit string input.\n    Inherits from ValueError for clarity.\n    \"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\nclass StringUtils:\n    \"\"\"Provides utility methods for string manipulation and validation.\n    Checks if a given string consists entirely of digit characters.\n    \"\"\"\n    @staticmethod\n    def is_digit_string(s: str) -> bool:\n        \"\"\"Checks if a string consists only of digits.\"\"\"\n        return s.isdigit()\nclass OddCounterService:\n    \"\"\"Encapsulates business logic for counting odd digits and formatting output.\n    This service is stateless and provides core computation.\n    \"\"\"\n    def count_odd_digits(self, digit_string: str) -> int:\n        \"\"\"Counts the number of odd digits in a given string.\"\"\"\n        odd_count = 0\n        for char in digit_string:\n            if int(char) % 2 != 0:\n                odd_count += 1\n        return odd_count\n\n    def format_output_string(self, count: int) -> str:\n        \"\"\"Formats the output string using the provided odd digit count.\n        The format adheres strictly to the business rule.\n        \"\"\"\n        # Business rule: \"the number of odd elements <count>n the str<count>ng <count> of the <count>nput.\"\n        return f\"the number of odd elements {count}n the str{count}ng {count} of the {count}nput.\"\nclass OddCounterController:\n    \"\"\"Orchestrates processing, validates input, and delegates to service.\n    Manages the overall flow from input list to formatted output list.\n    \"\"\"\n    def __init__(self, service: OddCounterService):\n        self._service = service\n\n    def process_strings(self, input_list: List[str]) -> List[str]:\n        \"\"\"Processes a list of strings, validating, counting odd digits, and formatting.\n        Raises TypeError for invalid list/element types or InvalidInputError for non-digit strings.\n        \"\"\"\n        if not isinstance(input_list, list):\n            raise TypeError(\"Input must be a list.\")\n\n        results = []\n        for i, s in enumerate(input_list):\n            if not isinstance(s, str):\n                raise TypeError(f\"Element at index {i} is not a string.\")\n\n            if not StringUtils.is_digit_string(s):\n                raise InvalidInputError(f\"String '{s}' at index {i} contains non-digit characters.\")\n\n            odd_count = self._service.count_odd_digits(s)\n            formatted_string = self._service.format_output_string(odd_count)\n            results.append(formatted_string)\n        return results\ndef odd_count(lst: List[str]) -> List[str]:\n    \"\"\"Given a list of strings, where each string consists of only digits, return a list.\n    Each element i of the output should be \"the number of odd elements in the\n    string i of the input.\" where all the i's should be replaced by the number\n    of odd digits in the i'th string of the input.\n\n    >>> odd_count(['1234567'])\n    [\"the number of odd elements 4n the str4ng 4 of the 4nput.\"]\n    >>> odd_count(['3',\"11111111\"])\n    [\"the number of odd elements 1n the str1ng 1 of the 1nput.\",\n     \"the number of odd elements 8n the str8ng 8 of the 8nput.\"]\n    \"\"\"\n    service = OddCounterService()\n    controller = OddCounterController(service=service)\n    return controller.process_strings(input_list=lst)"}
{"task_id": "HumanEval/117", "solution": "def select_words(s, n):\n    \"\"\"Given a string s and a natural number n, return words with exactly n consonants.\n    Returns an empty list if the input string is empty.\n    \"\"\"\n    if not s:\n        return []\n\n    VOWELS = {'a', 'e', 'i', 'o', 'u'}\n\n    def _count_consonants(word):\n        \"\"\"Counts consonants in a word, ignoring non-letters and handling case.\"\"\"\n        consonant_count = 0\n        lower_word = word.lower()\n        for char in lower_word:\n            # Check if character is a letter and not a vowel\n            if 'a' <= char <= 'z' and char not in VOWELS:\n                consonant_count += 1\n        return consonant_count\n\n    words = s.split()\n    result = []\n\n    for word in words:\n        if _count_consonants(word) == n:\n            result.append(word)\n\n    return result"}
{"task_id": "HumanEval/117", "solution": "def select_words(s: str, n: int) -> list[str]:\n    \"\"\"\n    Given a string `s` and a natural number `n`, returns words from `s` with exactly `n` consonants.\n    Handles empty input gracefully by returning an empty list.\n    \"\"\"\n    VOWELS = {'a', 'e', 'i', 'o', 'u'}\n\n    def is_vowel(char: str) -> bool:\n        \"\"\"Checks if a given character is a vowel, case-insensitive.\"\"\"\n        return char.lower() in VOWELS\n\n    def count_consonants(word: str) -> int:\n        \"\"\"Counts the number of consonants in a given word, using the `is_vowel` helper.\"\"\"\n        consonant_count = 0\n        for char in word:\n            if char.isalpha() and not is_vowel(char):\n                consonant_count += 1\n        return consonant_count\n\n    if not s.strip():\n        return []\n\n    words = s.split()\n    result = []\n    for word in words:\n        if count_consonants(word) == n:\n            result.append(word)\n    return result"}
{"task_id": "HumanEval/116", "solution": "class BitCounter:\n    def count_set_bits(self, n: int) -> int:\n        \"\"\"\n        Counts set bits in an integer's binary representation.\n        For negative numbers, bits are counted from their absolute value.\n        \"\"\"\n        if not isinstance(n, int):\n            raise TypeError(\"Input must be an integer.\")\n        \n        count = 0\n        abs_n = abs(n) \n        while abs_n > 0:\n            abs_n &= (abs_n - 1)\n            count += 1\n        return count\nclass ArraySorter:\n    def __init__(self):\n        self._bit_counter = BitCounter()\n\n    def sort(self, arr: list[int]) -> list[int]:\n        \"\"\"\n        Sorts integers by bit count (ascending) then decimal value (ascending).\n        It returns a new list, leaving the original unchanged.\n        \"\"\"\n        if not isinstance(arr, list):\n            raise TypeError(\"Input must be a list.\")\n        if not all(isinstance(x, int) for x in arr):\n            raise TypeError(\"All elements in the list must be integers.\")\n\n        decorated_array = []\n        for x in arr:\n            bit_count = self._bit_counter.count_set_bits(x)\n            decorated_array.append((bit_count, x, x))\n\n        decorated_array.sort()\n\n        return [item[2] for item in decorated_array]\ndef sort_array(arr):\n    \"\"\"\n    In this Kata, you have to sort an array of non-negative integers according to\n    number of ones in their binary representation in ascending order.\n    For similar number of ones, sort based on decimal value.\n\n    It must be implemented like this:\n    >>> sort_array([1, 5, 2, 3, 4]) == [1, 2, 3, 4, 5]\n    >>> sort_array([-2, -3, -4, -5, -6]) == [-6, -5, -4, -3, -2]\n    >>> sort_array([1, 0, 2, 3, 4]) [0, 1, 2, 3, 4]\n    \"\"\"\n    sorter = ArraySorter()\n    return sorter.sort(arr)"}
{"task_id": "HumanEval/118", "solution": "def get_closest_vowel(word: str) -> str:\n    \"\"\"\n    Finds the closest vowel from the right surrounded by consonants, excluding word ends.\n    Returns an empty string if no such vowel is found.\n    \"\"\"\n    VOWELS = \"aeiouAEIOU\"\n\n    def is_vowel(char: str) -> bool:\n        \"\"\"Checks if a character is an English vowel.\"\"\"\n        return char in VOWELS\n\n    def is_consonant(char: str) -> bool:\n        \"\"\"Checks if a character is an English consonant.\"\"\"\n        return char.isalpha() and not is_vowel(char)\n\n    n = len(word)\n    # If the word is too short, no internal character can have two neighbors.\n    if n < 3:\n        return \"\"\n\n    # Iterate from right to left, specifically excluding the first and last characters.\n    # The loop range (n-2 down to 1) ensures valid indices for current_char and its neighbors.\n    for i in range(n - 2, 0, -1):\n        current_char = word[i]\n        \n        # Check if the current character is a vowel.\n        if is_vowel(current_char):\n            left_char = word[i - 1]\n            right_char = word[i + 1]\n            \n            # Verify if both immediate neighbors are consonants.\n            if is_consonant(left_char) and is_consonant(right_char):\n                return current_char # Return the first valid vowel found.\n    \n    # If no such vowel is found after checking all relevant characters, return an empty string.\n    return \"\""}
{"task_id": "HumanEval/120", "solution": "def maximum(arr: list[int], k: int) -> list[int]:\n    \"\"\"\n    Given an array arr of integers and a non-negative integer k, return a sorted list\n    of length k with the maximum k numbers in arr.\n    \"\"\"\n    if k == 0:\n        return []\n\n    sorted_arr = sorted(arr)  # Create a copy to avoid modifying the original array.\n\n    return sorted_arr[len(sorted_arr) - k:]"}
{"task_id": "HumanEval/119", "solution": "def match_parens(lst):\n    '''\n    You are given a list of two strings, both strings consist of open\n    parentheses '(' or close parentheses ')' only.\n    Your job is to check if it is possible to concatenate the two strings in\n    some order, that the resulting string will be good.\n    '''\n    def _is_balanced(s: str) -> bool:\n        \"\"\"Checks if a string of parentheses is balanced.\n        It returns True if all parentheses are balanced, False otherwise.\"\"\"\n        balance_count = 0\n        for char in s:\n            if char == '(':\n                balance_count += 1\n            elif char == ')':\n                balance_count -= 1\n            if balance_count < 0:\n                return False\n        return balance_count == 0\n\n    s1 = lst[0]\n    s2 = lst[1]\n\n    # Check concatenation order s1 + s2 (FR3)\n    combined1 = s1 + s2\n    is_balanced1 = _is_balanced(combined1)\n\n    # Check concatenation order s2 + s1 (FR4)\n    combined2 = s2 + s1\n    is_balanced2 = _is_balanced(combined2)\n\n    # Return 'Yes' if either is balanced, 'No' otherwise (FR5, FR6)\n    if is_balanced1 or is_balanced2:\n        return 'Yes'\n    else:\n        return 'No'"}
{"task_id": "HumanEval/119", "solution": "class ParenthesesValidator:\n    \"\"\"Utility to validate if a single string of parentheses is balanced.\n    It provides a static method to check the balance conditions.\"\"\"\n\n    @staticmethod\n    def is_balanced(s: str) -> bool:\n        \"\"\"Checks if the input string s has balanced parentheses.\n        It ensures counts of open and close parentheses are equal and prefix conditions are met.\"\"\"\n        balance_counter = 0\n        for char in s:\n            if char == '(':\n                balance_counter += 1\n            elif char == ')':\n                balance_counter -= 1\n            if balance_counter < 0:\n                return False\n        return balance_counter == 0\nclass ParenthesesMatcher:\n    \"\"\"Orchestrates checking if two strings can form a balanced string.\n    It leverages ParenthesesValidator to perform balancing checks.\"\"\"\n\n    @staticmethod\n    def match_parens(lst: list[str]) -> str:\n        \"\"\"Checks if concatenating two strings in any order forms a balanced string.\n        It uses a validator to check both possible combinations.\"\"\"\n        s1, s2 = lst[0], lst[1]\n\n        # Try concatenating in the first order: s1 + s2\n        combined_s1 = s1 + s2\n        if ParenthesesValidator.is_balanced(combined_s1):\n            return 'Yes'\n\n        # If not balanced, try the second order: s2 + s1\n        combined_s2 = s2 + s1\n        if ParenthesesValidator.is_balanced(combined_s2):\n            return 'Yes'\n\n        # If neither combination results in a balanced string\n        return 'No'\ndef match_parens(lst: list[str]) -> str:\n    '''\n    You are given a list of two strings, both strings consist of open\n    parentheses '(' or close parentheses ')' only.\n    Your job is to check if it is possible to concatenate the two strings in\n    some order, that the resulting string will be good.\n    A string S is considered to be good if and only if all parentheses in S\n    are balanced. For example: the string '(())()' is good, while the string\n    '())' is not.\n    Return 'Yes' if there's a way to make a good string, and return 'No' otherwise.\n    '''\n    return ParenthesesMatcher.match_parens(lst)"}
