{"task_id": "HumanEval/122", "solution": "def add_elements(arr: list[int], k: int) -> int:\n    \"\"\"\n    Given a non-empty array of integers arr and an integer k, return\n    the sum of the elements with at most two digits from the first k elements of arr.\n    \"\"\"\n    current_sum = 0\n    # Iterate through the first k elements of the array.\n    for i in range(k):\n        element = arr[i]\n        # Include the element in the sum if its absolute value has at most two digits.\n        if -99 <= element <= 99:\n            current_sum += element\n    return current_sum"}
{"task_id": "HumanEval/122", "solution": "def add_elements(arr, k):\n    \"\"\"\n    Given an array of integers arr and an integer k, this function sums elements\n    with at most two digits from the first k elements. It validates inputs for type and range.\n    \"\"\"\n    if not isinstance(arr, list):\n        raise TypeError(\"Input 'arr' must be a list.\")\n    if not isinstance(k, int):\n        raise TypeError(\"Input 'k' must be an integer.\")\n    if not arr:\n        raise ValueError(\"Input 'arr' cannot be empty.\")\n    if not (1 <= k <= len(arr)):\n        raise ValueError(f\"Input 'k' must be between 1 and len(arr) ({len(arr)}), inclusive.\")\n\n    total_sum = 0\n    # Iterate through the first k elements and sum those with at most two digits.\n    for i in range(k):\n        element = arr[i]\n        if not isinstance(element, int):\n            raise TypeError(f\"All elements in 'arr' must be integers, but found {type(element)} at index {i}.\")\n        if abs(element) < 100:\n            total_sum += element\n    return total_sum"}
{"task_id": "HumanEval/121", "solution": "def solution(lst):\n    \"\"\"Given a non-empty list of integers, return the sum of all of the odd elements that are in even positions.\n    Positions are 0-indexed; an even position is 0, 2, 4, etc.\n    \"\"\"\n    if not lst:\n        raise ValueError(\"Input list cannot be empty.\")\n\n    for element in lst:\n        if not isinstance(element, int):\n            raise TypeError(\"All elements in the list must be integers.\")\n\n    total_sum = 0\n    for i, element in enumerate(lst):\n        if i % 2 == 0 and element % 2 != 0:\n            total_sum += element\n    return total_sum"}
{"task_id": "HumanEval/123", "solution": "def get_odd_collatz(n: int) -> list[int]:\n    \"\"\"\n    Given a positive integer n, return a sorted list that has the odd numbers in Collatz sequence.\n    This function validates input and calculates the Collatz sequence to extract odd terms.\n    \"\"\"\n    if not isinstance(n, int) or n <= 0:\n        raise ValueError(\"Input 'n' must be a positive integer.\")\n\n    if n == 1:\n        return [1]\n\n    odd_numbers = set()\n    current_term = n\n\n    while current_term != 1:\n        if current_term % 2 != 0:\n            odd_numbers.add(current_term)\n\n        if current_term % 2 == 0:\n            current_term = current_term // 2\n        else:\n            current_term = 3 * current_term + 1\n    \n    odd_numbers.add(1) # Ensure 1 is always in the set, as it's the sequence's end.\n\n    return sorted(list(odd_numbers))"}
{"task_id": "HumanEval/123", "solution": "def get_odd_collatz(n):\n    \"\"\"\n    Given a positive integer n, return a sorted list of odd numbers in its Collatz sequence.\n    The sequence is generated by `n/2` for even `n`, or `3n+1` for odd `n`, until 1 is reached.\n    \"\"\"\n    if not isinstance(n, int) or n <= 0:\n        raise ValueError(\"Input 'n' must be a positive integer.\")\n\n    if n == 1:\n        return [1]\n\n    odd_numbers = set()\n    current_num = n\n\n    while current_num != 1:\n        if current_num % 2 != 0:\n            odd_numbers.add(current_num)\n\n        if current_num % 2 == 0:\n            current_num //= 2\n        else:\n            current_num = 3 * current_num + 1\n    \n    odd_numbers.add(1) # The sequence always terminates at 1, which is an odd number.\n\n    return sorted(list(odd_numbers))"}
{"task_id": "HumanEval/124", "solution": "import re\ndef valid_date(date):\n    \"\"\"\n    Validates a given date string and returns True if the date is valid otherwise False.\n    The date is valid if all of the following rules are satisfied:\n    1. The date string is not empty.\n    2. The number of days is not less than 1 or higher than 31 days for months 1,3,5,7,8,10,12. And the number of days is not less than 1 or higher than 30 days for months 4,6,9,11. And, the number of days is not less than 1 or higher than 29 for the month 2.\n    3. The months should not be less than 1 or higher than 12.\n    4. The date should be in the format: mm-dd-yyyy\n\n    for example: \n    valid_date('03-11-2000') => True\n\n    valid_date('15-01-2012') => False\n\n    valid_date('04-0-2040') => False\n\n    valid_date('06-04-2020') => True\n\n    valid_date('06/04/2020') => False\n    \"\"\"\n    if not date:\n        return False\n\n    match = re.fullmatch(r'(\\d{2})-(\\d{2})-(\\d{4})', date)\n    if not match:\n        return False\n    \n    try:\n        month = int(match.group(1))\n        day = int(match.group(2))\n        # Year is extracted but not validated beyond format as per requirements.\n        # year = int(match.group(3)) \n    except ValueError:\n        return False\n\n    if not (1 <= month <= 12):\n        return False\n\n    MONTH_DAYS_31 = [1, 3, 5, 7, 8, 10, 12]\n    MONTH_DAYS_30 = [4, 6, 9, 11]\n    MAX_DAYS_FEB = 29\n\n    if not (1 <= day):\n        return False\n\n    if month in MONTH_DAYS_31:\n        if not (day <= 31):\n            return False\n    elif month in MONTH_DAYS_30:\n        if not (day <= 30):\n            return False\n    elif month == 2:\n        if not (day <= MAX_DAYS_FEB):\n            return False\n    else:\n        # This case should not be reached if month is already validated.\n        return False\n\n    return True"}
{"task_id": "HumanEval/124", "solution": "def valid_date(date):\n    \"\"\"\n    Validates a date string against predefined rules: non-empty, mm-dd-yyyy format,\n    and valid month/day ranges (February allows up to 29 days).\n    \"\"\"\n\n    # FR1: Validate that the input date string is not empty.\n    if not date:\n        return False\n\n    # FR2: Validate that the date string adheres to the `mm-dd-yyyy` format.\n    parts = date.split('-')\n    if len(parts) != 3:\n        return False\n    try:\n        month = int(parts[0])\n        day = int(parts[1])\n        year = int(parts[2])\n    except ValueError:\n        return False\n\n    # FR3: Validate that the month component is between 1 and 12, inclusive.\n    if not (1 <= month <= 12):\n        return False\n\n    # FR4: Validate that the day component is within the correct range for the given month.\n    # Based on DAYS_IN_MONTH constant from the design specification.\n    days_in_month_map = {\n        1: 31, 3: 31, 5: 31, 7: 31, 8: 31, 10: 31, 12: 31,\n        4: 30, 6: 30, 9: 30, 11: 30,\n        2: 29  # February, allowing up to 29 days as per requirement (simplified leap year logic).\n    }\n\n    max_days = days_in_month_map.get(month, 0)\n    if not (1 <= day <= max_days):\n        return False\n\n    return True"}
{"task_id": "HumanEval/125", "solution": "def split_words(txt):\n    \"\"\"\n    Processes a string by splitting on whitespace, then commas, or counting odd-ordered lowercase letters.\n    The alphabetical order starts with 'a' = 0.\n    \"\"\"\n    if not isinstance(txt, str):\n        raise TypeError(\"Input must be a string.\")\n\n    if any(c.isspace() for c in txt):\n        return txt.split()\n    elif ',' in txt:\n        return txt.split(',')\n    else:\n        count = 0\n        for char in txt:\n            if 'a' <= char <= 'z': # Check for lowercase letters.\n                # Increment count if alphabetical order (0-indexed from 'a') is odd.\n                if (ord(char) - ord('a')) % 2 != 0:\n                    count += 1\n        return count"}
