{"task_id": "HumanEval/93", "solution": "VOWELS_LOWER = {'a', 'e', 'i', 'o', 'u'}\nVOWELS_UPPER = {'A', 'E', 'I', 'O', 'U'}\nALPHABET_LOWER = \"abcdefghijklmnopqrstuvwxyz\"\nALPHABET_UPPER = \"ABCDEFGHIJKLMNOPQRSTUVWXYZ\"\ndef encode(message):\n    \"\"\"\n    Encodes a message by swapping letter case and shifting vowels.\n    Vowels are replaced by the letter two places ahead in the alphabet, preserving case.\n    \"\"\"\n\n    def _swap_case_char(char: str) -> str:\n        \"\"\"Swaps the case of an alphabetic character, otherwise returns it unchanged.\"\"\"\n        if char.isalpha():\n            return char.swapcase()\n        return char\n\n    def _shift_vowel_char(char: str) -> str:\n        \"\"\"Shifts an English vowel two places ahead in the alphabet, preserving case.\"\"\"\n        if char in VOWELS_LOWER:\n            idx = ALPHABET_LOWER.find(char)\n            return ALPHABET_LOWER[(idx + 2) % 26]\n        elif char in VOWELS_UPPER:\n            idx = ALPHABET_UPPER.find(char)\n            return ALPHABET_UPPER[(idx + 2) % 26]\n        return char\n\n    encoded_chars = []\n    for char in message:\n        # First, apply case swap as per FR1 and FR3.\n        swapped_char = _swap_case_char(char)\n        # Then, apply vowel shift to the character from the previous step as per FR2 and FR3.\n        shifted_char = _shift_vowel_char(swapped_char)\n        encoded_chars.append(shifted_char)\n\n    return \"\".join(encoded_chars)"}
{"task_id": "HumanEval/95", "solution": "def check_dict_case(dict):\n    \"\"\"\n    Checks if all keys in the dictionary are consistently cased (all lowercase or all uppercase strings).\n    Returns False for empty dictionaries, or those with non-string keys or mixed casing.\n    \"\"\"\n    if not dict: # FR1: Check if the dictionary is empty.\n        return False\n\n    is_all_lower = True\n    is_all_upper = True\n\n    for key in dict.keys(): # FR2: Iterate through all keys.\n        if not isinstance(key, str): # FR3: Verify each key is a string.\n            return False\n\n        # FR4 & FR5: Determine if all string keys are exclusively lowercase or uppercase.\n        if not key.islower():\n            is_all_lower = False\n        if not key.isupper():\n            is_all_upper = False\n\n    # FR6 & FR7: Return True if consistency is found, False otherwise.\n    return is_all_lower or is_all_upper"}
