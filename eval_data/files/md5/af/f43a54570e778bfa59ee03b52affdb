{"task_id": "HumanEval/10", "solution": "def is_palindrome(string: str) -> bool:\n    \"\"\"Checks if the given string is a palindrome.\n    It returns True for empty strings.\n    \"\"\"\n    if not isinstance(string, str):\n        raise TypeError(\"Input must be a string.\")\n    return string == string[::-1]\ndef make_palindrome(string: str) -> str:\n    \"\"\"Finds the shortest palindrome that begins with the supplied string.\n    It identifies the longest palindromic suffix and appends the reverse of the remaining prefix.\n    \"\"\"\n    if not isinstance(string, str):\n        raise TypeError(\"Input must be a string.\")\n    if not string:\n        return \"\"\n\n    # Find the smallest index 'k' such that string[k:] is a palindrome.\n    # This 'string[k:]' will be the longest palindromic suffix of the original string.\n    for k in range(len(string)):\n        suffix = string[k:]\n        if is_palindrome(suffix):\n            # 'string[:k]' is the prefix that comes before the longest palindromic suffix.\n            prefix_to_reverse = string[:k]\n            return string + prefix_to_reverse[::-1]\n    \n    # This point should not be reached for non-empty strings because\n    # the last single character of any string is always a palindrome,\n    # and the loop would return when k = len(string) - 1 at the latest."}
{"task_id": "HumanEval/21", "solution": "from typing import List\nclass InvalidInputError(Exception):\n    \"\"\"Custom exception for invalid input to the rescaling function.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\ndef rescale_to_unit(numbers: List[float]) -> List[float]:\n    \"\"\"Applies a linear transformation to a list of numbers, scaling them to the unit range [0, 1].\n    Raises InvalidInputError if the input list has fewer than two elements.\"\"\"\n    if len(numbers) < 2:\n        raise InvalidInputError(\"Input list must have at least two elements for rescaling.\")\n\n    min_val = min(numbers)\n    max_val = max(numbers)\n\n    if min_val == max_val:\n        return [0.0] * len(numbers)\n\n    scale_range = max_val - min_val\n    rescaled_numbers = [(x - min_val) / scale_range for x in numbers]\n    \n    return rescaled_numbers"}
