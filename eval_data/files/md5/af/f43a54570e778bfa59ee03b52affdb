{"task_id": "HumanEval/3", "solution": "from typing import List\ndef below_zero(operations: List[int]) -> bool:\n    \"\"\" You're given a list of deposit and withdrawal operations on a bank account that starts with\n    zero balance. Your task is to detect if at any point the balance of account fallls below zero, and\n    at that point function should return True. Otherwise it should return False.\n    \"\"\"\n    if not isinstance(operations, list):\n        raise TypeError(\"Operations must be a list.\")\n    for op in operations:\n        if not isinstance(op, int):\n            raise TypeError(\"All operations must be integers.\")\n\n    current_balance = 0\n    for operation in operations:\n        current_balance += operation\n        if current_balance < 0:\n            return True\n    return False"}
{"task_id": "HumanEval/4", "solution": "from typing import List\nclass MADError(Exception):\n    \"\"\"Base exception for Mean Absolute Deviation calculator errors.\"\"\"\n    def __init__(self, message: str = \"An error occurred in MAD calculation.\"):\n        self.message = message\n        super().__init__(self.message)\nclass EmptyInputError(MADError):\n    \"\"\"Exception raised when an empty list is provided for calculation.\"\"\"\n    def __init__(self, message: str = \"Input list cannot be empty for MAD calculation.\"):\n        super().__init__(message)\ndef mean_absolute_deviation(numbers: List[float]) -> float:\n    \"\"\" For a given list of input numbers, calculate Mean Absolute Deviation\n    around the mean of this dataset. MAD is the average of absolute differences\n    between each data point and the mean.\n    \"\"\"\n    if not numbers:\n        raise EmptyInputError(\"Input list cannot be empty.\")\n\n    # Calculate the mean of the input numbers.\n    data_mean = sum(numbers) / len(numbers)\n\n    # Calculate the absolute difference between each number and the mean.\n    absolute_differences = [abs(x - data_mean) for x in numbers]\n\n    # Calculate the mean of these absolute differences to get the MAD.\n    mad_value = sum(absolute_differences) / len(absolute_differences)\n    return mad_value"}
{"task_id": "HumanEval/1", "solution": "from typing import List\ndef separate_paren_groups(paren_string: str) -> List[str]:\n    \"\"\"Separates multiple groups of nested parentheses into separate strings, ignoring spaces.\n    Returns a list of these balanced, top-level groups.\n    \"\"\"\n    result: List[str] = []\n    current_group: str = \"\"\n    balance: int = 0\n\n    # Remove all spaces from the input string.\n    cleaned_string = paren_string.replace(\" \", \"\")\n\n    for char in cleaned_string:\n        if char == '(':\n            balance += 1\n            current_group += char\n        elif char == ')':\n            balance -= 1\n            current_group += char\n        else:\n            # Non-parenthesis characters (not spaces) are included in the current group.\n            current_group += char\n\n        if balance == 0 and current_group:\n            result.append(current_group)\n            current_group = \"\"\n        elif balance < 0:\n            # Malformed input detected; reset to find subsequent valid groups.\n            current_group = \"\"\n            balance = 0\n\n    return result"}
{"task_id": "HumanEval/2", "solution": "import math\ndef truncate_number(number: float) -> float:\n    \"\"\" Given a positive floating point number, it can be decomposed into\n    and integer part (largest integer smaller than given number) and decimals\n    (leftover part always smaller than 1).\n\n    Return the decimal part of the number.\n    >>> truncate_number(3.5)\n    0.5\n    \"\"\"\n    integer_part = math.floor(number)\n    decimal_part = number - integer_part\n    return decimal_part"}
{"task_id": "HumanEval/1", "solution": "from typing import List\ndef separate_paren_groups(paren_string: str) -> List[str]:\n    \"\"\"Separates distinct, balanced, and non-nested parenthesis groups from an input string.\n    Spaces are ignored, and a list of identified groups is returned.\n    \"\"\"\n    if not isinstance(paren_string, str):\n        raise TypeError(\"Input must be a string.\")\n\n    cleaned_string = paren_string.replace(\" \", \"\")\n    groups = []\n    current_group_start = 0\n    balance = 0\n\n    for i, char in enumerate(cleaned_string):\n        if char == '(':\n            balance += 1\n        elif char == ')':\n            balance -= 1\n\n        if balance == 0:\n            # A complete, balanced, non-nested group is identified.\n            # Extract this group and prepare for the next potential group.\n            groups.append(cleaned_string[current_group_start : i + 1])\n            current_group_start = i + 1\n        elif balance < 0:\n            # An unmatched closing parenthesis occurred, invalidating the current segment.\n            # Reset balance and start searching for a new group from the next character.\n            current_group_start = i + 1\n            balance = 0\n\n    return groups"}
{"task_id": "HumanEval/9", "solution": "from typing import List, Tuple\ndef rolling_max(numbers: List[int]) -> List[int]:\n    \"\"\"\n    Computes the rolling maximum for the given list of integers.\n    The rolling maximum at any point is the maximum value observed from the beginning up to that point.\n    \"\"\"\n    if not numbers:\n        return []\n\n    rolling_max_list = []\n    current_max = float('-inf')\n\n    for number in numbers:\n        if number > current_max:\n            current_max = number\n        rolling_max_list.append(current_max)\n\n    return rolling_max_list"}
{"task_id": "HumanEval/8", "solution": "from typing import List, Tuple\ndef sum_product(numbers: List[int]) -> Tuple[int, int]:\n    \"\"\" For a given list of integers, return a tuple consisting of a sum and a product.\n    Handles empty lists and validates input type and content.\n    \"\"\"\n    if not isinstance(numbers, list):\n        raise TypeError(\"Input must be a list.\")\n    for item in numbers:\n        if not isinstance(item, int):\n            raise ValueError(\"All elements in the list must be integers.\")\n\n    current_sum = 0\n    current_product = 1\n\n    if not numbers:\n        return (current_sum, current_product)\n\n    for num in numbers:\n        current_sum += num\n        current_product *= num\n\n    return (current_sum, current_product)"}
{"task_id": "HumanEval/12", "solution": "from typing import List, Optional\ndef longest(strings: List[str]) -> Optional[str]:\n    \"\"\"\n    Out of a list of strings, return the longest one.\n    Returns the first one in case of multiple strings of the same length, or None if the list is empty.\n    \"\"\"\n    if not strings:\n        return None\n\n    current_longest = strings[0]\n    max_length = len(strings[0])\n\n    for s in strings:\n        if len(s) > max_length:\n            max_length = len(s)\n            current_longest = s\n    \n    return current_longest"}
{"task_id": "HumanEval/6", "solution": "from typing import List\ndef parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\" Input to this function is a string represented multiple groups for nested parentheses separated by spaces.\n    For each of the group, output the deepest level of nesting of parentheses.\n    E.g. (()()) has maximum two levels of nesting while ((())) has three.\n\n    >>> parse_nested_parens('(()()) ((())) () ((())()())')\n    [2, 3, 1, 3]\n    \"\"\"\n    \n    def _get_max_nesting_depth_for_group(group_string: str) -> int:\n        \"\"\"Calculates the maximum nesting depth for a single parentheses group string.\"\"\"\n        max_depth = 0\n        current_depth = 0\n        for char in group_string:\n            if char == '(':\n                current_depth += 1\n                max_depth = max(max_depth, current_depth)\n            elif char == ')':\n                current_depth = max(0, current_depth - 1)\n        return max_depth\n\n    # Handles empty or space-only input string gracefully.\n    if not paren_string.strip():\n        return []\n\n    # Splits the input string into individual groups.\n    groups = paren_string.split(' ')\n    results = []\n\n    # Calculates max depth for each non-empty group.\n    for group_string in groups:\n        if group_string:\n            results.append(_get_max_nesting_depth_for_group(group_string))\n            \n    return results"}
{"task_id": "HumanEval/11", "solution": "def string_xor(a: str, b: str) -> str:\n    \"\"\"Input are two strings a and b consisting only of 1s and 0s.\n    Perform binary XOR on these inputs and return result also as a string.\n    \"\"\"\n    # Validate that both input strings 'a' and 'b' consist exclusively of '0's and '1's.\n    if not all(char in '01' for char in a):\n        raise ValueError(\"Input string 'a' contains non-binary characters.\")\n    if not all(char in '01' for char in b):\n        raise ValueError(\"Input string 'b' contains non-binary characters.\")\n\n    # Validate that both input strings 'a' and 'b' are of equal length.\n    if len(a) != len(b):\n        raise ValueError(\"Input strings must be of equal length for XOR operation.\")\n\n    # Perform a bitwise XOR operation and collect results.\n    result_bits = []\n    for i in range(len(a)):\n        xor_result = int(a[i]) ^ int(b[i])\n        result_bits.append(str(xor_result))\n\n    # Return the result of the XOR operation as a single string.\n    return \"\".join(result_bits)"}
{"task_id": "HumanEval/12", "solution": "from typing import List, Optional\ndef longest(strings: List[str]) -> Optional[str]:\n    \"\"\" Out of list of strings, return the longest one. Return the first one in case of multiple\n    strings of the same length. Return None in case the input list is empty.\n    \"\"\"\n    if not strings:\n        return None\n\n    longest_str = None\n    max_length = -1\n\n    for s in strings:\n        if len(s) > max_length:\n            max_length = len(s)\n            longest_str = s\n    return longest_str"}
{"task_id": "HumanEval/9", "solution": "from typing import List, Tuple\ndef rolling_max(numbers: List[int]) -> List[int]:\n    \"\"\" From a given list of integers, generate a list of rolling maximum element found until given moment\n    in the sequence.\n    >>> rolling_max([1, 2, 3, 2, 3, 4, 2])\n    [1, 2, 3, 3, 3, 4, 4]\n    \"\"\"\n    class IRollingMaxCalculator:\n        def calculate(self, numbers: List[int]) -> List[int]:\n            raise NotImplementedError\n\n    class RollingMaxCalculator(IRollingMaxCalculator):\n        def calculate(self, numbers: List[int]) -> List[int]:\n            \"\"\"\n            Computes rolling maximums for the input list.\n            Validates input type and elements, then returns the list of rolling maximums.\n            \"\"\"\n            if not isinstance(numbers, list):\n                raise TypeError(\"Input 'numbers' must be a list.\")\n            \n            for i, x in enumerate(numbers):\n                if not isinstance(x, int):\n                    raise ValueError(f\"All elements in 'numbers' must be integers. Found non-integer at index {i}: {x}\")\n\n            if not numbers:\n                return []\n\n            rolling_maximums = []\n            current_max = float('-inf')\n\n            for number in numbers:\n                if number > current_max:\n                    current_max = number\n                rolling_maximums.append(current_max)\n            \n            return rolling_maximums\n\n    class RollingMaxService:\n        def __init__(self, calculator: IRollingMaxCalculator):\n            \"\"\"\n            Initializes the service with a calculator instance.\n            \"\"\"\n            self.calculator = calculator\n\n        def rolling_max(self, numbers: List[int]) -> List[int]:\n            \"\"\"\n            Delegates the rolling maximum calculation to the injected calculator.\n            \"\"\"\n            return self.calculator.calculate(numbers)\n\n    calculator = RollingMaxCalculator()\n    service = RollingMaxService(calculator)\n    return service.rolling_max(numbers)"}
