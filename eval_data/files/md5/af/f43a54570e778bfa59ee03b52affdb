{"task_id": "HumanEval/151", "solution": "def double_the_difference(lst):\n    '''\n    Calculates the sum of squares of odd, positive integers in the given list.\n    Ignores negative numbers, zero, and non-integer types.\n    '''\n    if not isinstance(lst, list):\n        raise TypeError(\"Input must be a list.\")\n\n    total_sum = 0\n    for item in lst:\n        if isinstance(item, int) and item > 0 and item % 2 != 0:\n            total_sum += item * item\n    return total_sum"}
{"task_id": "HumanEval/153", "solution": "class ExtensionInfo:\n    \"\"\"A simple data structure to hold an extension's name and its calculated strength.\"\"\"\n    def __init__(self, name: str, strength: int):\n        self.name = name\n        self.strength = strength\nclass ExtensionStrengthCalculator:\n    \"\"\"Encapsulates the logic for calculating the strength of a single extension string.\"\"\"\n    def calculate(self, extension_name: str) -> int:\n        if not isinstance(extension_name, str):\n            raise TypeError(\"Extension name must be a string.\")\n\n        cap_count = sum(1 for char in extension_name if 'A' <= char <= 'Z')\n        sm_count = sum(1 for char in extension_name if 'a' <= char <= 'z')\n        return cap_count - sm_count\nclass StrongestExtensionFinder:\n    \"\"\"Orchestrates finding the strongest extension from a list, using the ExtensionStrengthCalculator.\"\"\"\n    def __init__(self, calculator: ExtensionStrengthCalculator):\n        self._calculator = calculator\n\n    def find(self, extensions: list[str]) -> str:\n        if not isinstance(extensions, list):\n            raise TypeError(\"Extensions must be a list of strings.\")\n        if not extensions:\n            raise ValueError(\"The list of extensions cannot be empty.\")\n\n        strongest_info: ExtensionInfo | None = None\n\n        for extension_name in extensions:\n            if not isinstance(extension_name, str):\n                raise TypeError(f\"All extension names in the list must be strings. Found: {type(extension_name)}\")\n            \n            current_strength = self._calculator.calculate(extension_name)\n            current_info = ExtensionInfo(extension_name, current_strength)\n\n            if strongest_info is None or current_info.strength > strongest_info.strength:\n                strongest_info = current_info\n            # Tie-breaking: If strengths are equal, the first occurring one is retained by not updating.\n\n        if strongest_info is None:\n            raise RuntimeError(\"Internal error: Strongest extension could not be determined from a non-empty list.\")\n        return strongest_info.name\ndef Strongest_Extension(class_name, extensions):\n    \"\"\"\n    Identifies the strongest extension for a given class name from a list of potential extensions.\n    The strength is calculated as (uppercase letters - lowercase letters), with ties broken by original list order.\n    \"\"\"\n    if not isinstance(class_name, str):\n        raise TypeError(\"Class name must be a string.\")\n\n    calculator = ExtensionStrengthCalculator()\n    finder = StrongestExtensionFinder(calculator)\n\n    strongest_extension_name = finder.find(extensions)\n\n    return f\"{class_name}.{strongest_extension_name}\""}
{"task_id": "HumanEval/154", "solution": "def _generate_rotations(s: str) -> list[str]:\n    \"\"\"Generates all unique cyclic rotations of the input string.\"\"\"\n    if not s:\n        return [\"\"]\n    rotations = set()\n    n = len(s)\n    for i in range(n):\n        rotated_s = s[i:] + s[:i]\n        rotations.add(rotated_s)\n    return list(rotations)\ndef cycpattern_check(a , b):\n    \"\"\"Checks if any rotation of string b is a substring of string a.\"\"\"\n    if not b:\n        return True\n    if not a:\n        return False\n\n    rotations_of_b = _generate_rotations(b)\n    for rotation in rotations_of_b:\n        if rotation in a:\n            return True\n    return False"}
{"task_id": "HumanEval/127", "solution": "def intersection(interval1, interval2):\n    \"\"\"You are given two intervals,\n    where each interval is a pair of integers. For example, interval = (start, end) = (1, 2).\n    The given intervals are closed which means that the interval (start, end)\n    includes both start and end.\n    For each given interval, it is assumed that its start is less or equal its end.\n    Your task is to determine whether the length of intersection of these two \n    intervals is a prime number.\n    Example, the intersection of the intervals (1, 3), (2, 4) is (2, 3)\n    which its length is 1, which not a prime number.\n    If the length of the intersection is a prime number, return \"YES\",\n    otherwise, return \"NO\".\n    If the two intervals don't intersect, return \"NO\".\n\n\n    [input/output] samples:\n    intersection((1, 2), (2, 3)) ==> \"NO\"\n    intersection((-1, 1), (0, 4)) ==> \"NO\"\n    intersection((-3, -1), (-5, 5)) ==> \"YES\"\n    \"\"\"\n    start1, end1 = interval1\n    start2, end2 = interval2\n\n    # Calculate the intersection\n    inter_start = max(start1, start2)\n    inter_end = min(end1, end2)\n\n    # If the intervals do not intersect\n    if inter_start > inter_end:\n        return \"NO\"\n\n    # Calculate the length of the intersection.\n    # Based on the problem example \"(2, 3) which its length is 1\",\n    # the length is calculated as (end - start).\n    length = inter_end - inter_start\n\n    # Check if the length is a prime number\n    n = length\n    if n <= 1:\n        return \"NO\"  # 0 and 1 are not prime numbers\n    if n == 2:\n        return \"YES\"  # 2 is the only even prime number\n    if n % 2 == 0:\n        return \"NO\"  # Other even numbers are not prime\n\n    # Check for divisibility by odd numbers up to the square root of n\n    # Using n**0.5 instead of math.sqrt to avoid importing math module.\n    for i in range(3, int(n**0.5) + 1, 2):\n        if n % i == 0:\n            return \"NO\"  # Found a divisor, so not prime\n            \n    return \"YES\"  # No divisors found, so it is a prime number"}
