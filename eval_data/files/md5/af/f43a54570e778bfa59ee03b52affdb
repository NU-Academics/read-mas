{"task_id": "HumanEval/18", "solution": "def how_many_times(string: str, substring: str) -> int:\n    \"\"\"\n    Find how many times a given substring can be found in the original string.\n    Count overlapping cases.\n    \"\"\"\n    if not substring:\n        return len(string) + 1\n\n    count = 0\n    start_index = 0\n    while True:\n        index = string.find(substring, start_index)\n        if index == -1:\n            break\n        count += 1\n        start_index = index + 1\n    return count"}
{"task_id": "HumanEval/0", "solution": "from typing import List\ndef has_close_elements(numbers: List[float], threshold: float) -> bool:\n    \"\"\" Check if in given list of numbers, are any two numbers closer to each other than\n    given threshold. This implementation uses a sorting approach for efficiency.\n    \"\"\"\n    if threshold < 0:\n        raise ValueError(\"Threshold cannot be negative.\")\n\n    if len(numbers) < 2:\n        return False\n\n    sorted_numbers = sorted(numbers)\n\n    for i in range(len(sorted_numbers) - 1):\n        if abs(sorted_numbers[i+1] - sorted_numbers[i]) < threshold:\n            return True\n    \n    return False"}
{"task_id": "HumanEval/18", "solution": "def how_many_times(string: str, substring: str) -> int:\n    \"\"\" Find how many times a given substring can be found in the original string.\n        Count overlapping cases.\n\n    Args:\n        string: The main string to search within.\n        substring: The substring to count.\n\n    Returns:\n        The number of times the substring appears, including overlaps.\n\n    Examples:\n        >>> how_many_times('', 'a')\n        0\n        >>> how_many_times('aaa', 'a')\n        3\n        >>> how_many_times('aaaa', 'aa')\n        3\n        >>> how_many_times('abcabcabc', 'abc')\n        3\n        >>> how_many_times('banana', 'ana')\n        2\n        >>> how_many_times('test', '')\n        0\n    \"\"\"\n    if not substring:\n        return 0\n    if not string:\n        return 0\n\n    count = 0\n    start_index = 0\n    while True:\n        index = string.find(substring, start_index)\n        if index == -1:\n            break\n        count += 1\n        start_index = index + 1 # Move one character forward to find overlapping occurrences\n    return count"}
{"task_id": "HumanEval/5", "solution": "from typing import List\ndef intersperse(numbers: List[int], delimeter: int) -> List[int]:\n    \"\"\" Insert a number 'delimeter' between every two consecutive elements of input list `numbers'\n    >>> intersperse([], 4)\n    []\n    >>> intersperse([1, 2, 3], 4)\n    [1, 4, 2, 4, 3]\n    \"\"\"\n    if not numbers:\n        return []\n\n    if len(numbers) == 1:\n        return numbers\n\n    result = []\n    for i, num in enumerate(numbers):\n        result.append(num)\n        if i < len(numbers) - 1:\n            result.append(delimeter)\n    return result"}
{"task_id": "HumanEval/69", "solution": "from collections import Counter\ndef search(lst):\n    \"\"\"\n    Finds the greatest integer in a list whose frequency is greater than or equal to its value.\n    Returns -1 if no such integer exists.\n    \"\"\"\n    frequencies = Counter(lst)\n    \n    candidates = []\n    for num, freq in frequencies.items():\n        if freq >= num:\n            candidates.append(num)\n            \n    if not candidates:\n        return -1\n    else:\n        return max(candidates)"}
{"task_id": "HumanEval/70", "solution": "from typing import List\ndef strange_sort_list(lst: List[int]) -> List[int]:\n    '''\n    Given list of integers, return list in strange order.\n    Strange sorting, is when you start with the minimum value,\n    then maximum of the remaining integers, then minimum and so on.\n    '''\n    if not lst:\n        return []\n\n    sorted_list = sorted(lst)\n    result = []\n    left, right = 0, len(sorted_list) - 1\n\n    while left <= right:\n        # Take minimum\n        result.append(sorted_list[left])\n        left += 1\n        if left > right:\n            break\n\n        # Take maximum\n        result.append(sorted_list[right])\n        right -= 1\n    return result"}
