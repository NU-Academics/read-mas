{"task_id": "HumanEval/49", "solution": "def modp(n: int, p: int) -> int:\n    \"\"\"Return 2^n modulo p (be aware of numerics).\n    \n    >>> modp(3, 5)\n    3\n    >>> modp(1101, 101)\n    2\n    >>> modp(0, 101)\n    1\n    >>> modp(3, 11)\n    8\n    >>> modp(100, 101)\n    1\n    \"\"\"\n    if not isinstance(n, int) or n < 0:\n        raise ValueError(\"Exponent 'n' must be a non-negative integer.\")\n    if not isinstance(p, int) or p <= 0:\n        raise ValueError(\"Modulus 'p' must be a positive integer.\")\n\n    return pow(2, n, p)"}
{"task_id": "HumanEval/17", "solution": "from typing import List, Dict\nclass InvalidMusicStringError(Exception):\n    \"\"\"Custom exception for invalid music string input.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\nNOTE_MAPPING: Dict[str, int] = {\n    'o': 4,   # Whole note\n    'o|': 2,  # Half note\n    '.|': 1   # Quarter note\n}\ndef parse_music(music_string: str) -> List[int]:\n    \"\"\"\n    Parses a music string and returns a list of integers corresponding to\n    how many beats each note lasts.\n    \"\"\"\n    if not music_string.strip():\n        return []\n\n    note_symbols = music_string.split()\n    beat_durations: List[int] = []\n\n    for symbol in note_symbols:\n        beats = NOTE_MAPPING.get(symbol)\n        if beats is None:\n            raise InvalidMusicStringError(f\"Unrecognized note symbol: '{symbol}'\")\n        beat_durations.append(beats)\n\n    return beat_durations"}
{"task_id": "HumanEval/47", "solution": "def median(l: list):\n    \"\"\"Return median of elements in the list l.\n    Raises ValueError if the list is empty.\n    \"\"\"\n    if not l:\n        raise ValueError(\"Input list cannot be empty.\")\n\n    sorted_l = sorted(l)\n    n = len(sorted_l)\n\n    if n % 2 == 1:\n        # For odd length, return the middle element.\n        return float(sorted_l[n // 2])\n    else:\n        # For even length, return the average of the two middle elements.\n        mid1 = sorted_l[n // 2 - 1]\n        mid2 = sorted_l[n // 2]\n        return (float(mid1) + float(mid2)) / 2.0"}
{"task_id": "HumanEval/51", "solution": "VOWELS = {'a', 'e', 'i', 'o', 'u', 'A', 'E', 'I', 'O', 'U'}\ndef remove_vowels(text):\n    \"\"\"\n    remove_vowels is a function that takes a string and returns a string without vowels.\n    It removes all lowercase and uppercase English vowels.\n    >>> remove_vowels('')\n    ''\n    >>> remove_vowels(\"abcdef\\nghijklm\")\n    'bcdf\\nghjklm'\n    >>> remove_vowels('abcdef')\n    'bcdf'\n    >>> remove_vowels('aaaaa')\n    ''\n    >>> remove_vowels('aaBAA')\n    'B'\n    >>> remove_vowels('zbcd')\n    'zbcd'\n    \"\"\"\n    if not isinstance(text, str):\n        raise TypeError(\"Input 'text' must be a string.\")\n    \n    return \"\".join([char for char in text if char not in VOWELS])"}
{"task_id": "HumanEval/50", "solution": "def decode_shift(s: str):\n    \"\"\"\n    Decodes a string by shifting each alphabetic character 5 positions backward.\n    Handles alphabet wrapping and preserves non-alphabetic characters.\n    \"\"\"\n    if not isinstance(s, str):\n        raise TypeError(\"Input must be a string.\")\n\n    ALPHABET_SIZE = 26\n    SHIFT_AMOUNT = 5\n\n    decoded_chars = []\n    for char in s:\n        if 'a' <= char <= 'z':\n            start = ord('a')\n            shifted_ord = (ord(char) - start - SHIFT_AMOUNT + ALPHABET_SIZE) % ALPHABET_SIZE + start\n            decoded_chars.append(chr(shifted_ord))\n        elif 'A' <= char <= 'Z':\n            start = ord('A')\n            shifted_ord = (ord(char) - start - SHIFT_AMOUNT + ALPHABET_SIZE) % ALPHABET_SIZE + start\n            decoded_chars.append(chr(shifted_ord))\n        else:\n            decoded_chars.append(char)\n            \n    return \"\".join(decoded_chars)"}
{"task_id": "HumanEval/46", "solution": "class InvalidInputError(ValueError):\n    \"\"\"Custom exception for invalid input to the fib4 function.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\ndef fib4(n: int) -> int:\n    \"\"\"The Fib4 number sequence is a sequence similar to the Fibbonacci sequnece that's defined as follows:\n    fib4(0) -> 0\n    fib4(1) -> 0\n    fib4(2) -> 2\n    fib4(3) -> 0\n    fib4(n) -> fib4(n-1) + fib4(n-2) + fib4(n-3) + fib4(n-4).\n    Please write a function to efficiently compute the n-th element of the fib4 number sequence.  Do not use recursion.\n    >>> fib4(5)\n    4\n    >>> fib4(6)\n    8\n    >>> fib4(7)\n    14\n    \n    Raises:\n        InvalidInputError: If n is a negative integer.\n    \"\"\"\n    if n < 0:\n        raise InvalidInputError(\"Input n must be a non-negative integer.\")\n    if n == 0:\n        return 0\n    if n == 1:\n        return 0\n    if n == 2:\n        return 2\n    if n == 3:\n        return 0\n\n    fib_values = [0, 0, 2, 0] # Represents fib4(0), fib4(1), fib4(2), fib4(3)\n\n    for i in range(4, n + 1):\n        next_fib = (\n            fib_values[i - 1]\n            + fib_values[i - 2]\n            + fib_values[i - 3]\n            + fib_values[i - 4]\n        )\n        fib_values.append(next_fib)\n    \n    return fib_values[n]"}
