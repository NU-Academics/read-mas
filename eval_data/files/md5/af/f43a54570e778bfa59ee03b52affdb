{"task_id": "HumanEval/103", "solution": "def rounded_avg(n, m):\n    \"\"\"\n    Computes the rounded average of integers from n through m (inclusive)\n    and converts that to binary. Returns -1 if n is greater than m.\n    \"\"\"\n    if not isinstance(n, int) or not isinstance(m, int):\n        raise ValueError(\"Inputs n and m must be integers.\")\n    if n <= 0 or m <= 0:\n        raise ValueError(\"Inputs n and m must be positive integers.\")\n\n    if n > m:\n        return -1\n\n    count = m - n + 1\n    # Calculate sum using the arithmetic series formula for efficiency.\n    sum_val = (count * (n + m)) // 2 \n\n    average = sum_val / count\n    rounded_average = round(average)\n\n    return bin(rounded_average)"}
{"task_id": "HumanEval/85", "solution": "def add(lst):\n    \"\"\"Calculates the sum of even elements located at odd indices in the input list.\n    Raises TypeError for invalid input types.\n    \"\"\"\n    # Input validation: check if lst is a list.\n    if not isinstance(lst, list):\n        raise TypeError(\"Input must be a list.\")\n\n    # Input validation: check if all elements are integers.\n    for element in lst:\n        if not isinstance(element, int):\n            raise TypeError(\"All elements in the list must be integers.\")\n\n    # Handle empty list gracefully as per functional requirement.\n    if not lst:\n        return 0\n\n    total_sum = 0\n    for i, num in enumerate(lst):\n        if i % 2 != 0 and num % 2 == 0:  # Check for odd index and even number.\n            total_sum += num\n    return total_sum"}
{"task_id": "HumanEval/81", "solution": "def numerical_letter_grade(grades: List[float]) -> List[str]:\n    \"\"\"Converts a list of GPAs into a list of corresponding letter grades.\n    Handles input validation and uses a predefined grading scale.\n    \"\"\"\n    from dataclasses import dataclass\n    from typing import List\n\n    class InvalidGPAError(ValueError):\n        \"\"\"Custom exception for invalid GPA values.\"\"\"\n        pass\n\n    @dataclass\n    class GradeThreshold:\n        \"\"\"Represents a single entry in the grading scale.\"\"\"\n        gpa: float\n        grade: str\n        inclusive: bool = False\n\n    # The grading scale is defined as a global constant for maintainability and to avoid re-creation.\n    # It is sorted in descending order of GPA for efficient lookup.\n    _GRADING_SCALE: List[GradeThreshold] = sorted(\n        [\n            GradeThreshold(gpa=4.0, grade='A+', inclusive=True),\n            GradeThreshold(gpa=3.7, grade='A'),\n            GradeThreshold(gpa=3.3, grade='A-'),\n            GradeThreshold(gpa=3.0, grade='B+'),\n            GradeThreshold(gpa=2.7, grade='B'),\n            GradeThreshold(gpa=2.3, grade='B-'),\n            GradeThreshold(gpa=2.0, grade='C+'),\n            GradeThreshold(gpa=1.7, grade='C'),\n            GradeThreshold(gpa=1.3, grade='C-'),\n            GradeThreshold(gpa=1.0, grade='D+'),\n            GradeThreshold(gpa=0.7, grade='D'),\n            GradeThreshold(gpa=0.0, grade='D-'),\n            GradeThreshold(gpa=0.0, grade='E', inclusive=True)\n        ],\n        key=lambda x: x.gpa, reverse=True\n    )\n\n    if not isinstance(grades, list):\n        raise TypeError(\"Input 'grades' must be a list.\")\n\n    result_grades: List[str] = []\n    for gpa_input in grades:\n        if not isinstance(gpa_input, (int, float)):\n            raise InvalidGPAError(f\"GPA '{gpa_input}' is not a valid number.\")\n        \n        gpa = float(gpa_input) # Ensure GPA is a float for accurate comparison.\n\n        if gpa < 0.0:\n            raise InvalidGPAError(f\"GPA '{gpa}' cannot be negative.\")\n\n        found_grade = 'E' # Default to 'E' if no match, though the scale is comprehensive.\n        for threshold in _GRADING_SCALE:\n            if threshold.inclusive:\n                if gpa == threshold.gpa:\n                    found_grade = threshold.grade\n                    break\n            else:\n                # Comparison uses '>=' to align with the design's example tests and explicit correction.\n                if gpa >= threshold.gpa: \n                    found_grade = threshold.grade\n                    break\n        result_grades.append(found_grade)\n    return result_grades"}
{"task_id": "HumanEval/104", "solution": "class UniqueDigitsProcessor:\n    \"\"\"Encapsulates logic for identifying numbers with only odd digits and filtering/sorting lists.\"\"\"\n\n    def _has_only_odd_digits(self, number: int) -> bool:\n        \"\"\"Checks if all digits of a given number are odd.\n        It converts the number to a string to iterate through its digits.\n        \"\"\"\n        for digit_char in str(number):\n            if int(digit_char) % 2 == 0:\n                return False\n        return True\n\n    def filter_and_sort(self, numbers: list[int]) -> list[int]:\n        \"\"\"Filters a list to retain only numbers with odd digits, then sorts them.\n        The result is a new list containing the filtered and sorted integers.\n        \"\"\"\n        filtered_numbers = []\n        for num in numbers:\n            if self._has_only_odd_digits(num):\n                filtered_numbers.append(num)\n        \n        # Sorts the list in ascending order as required by FR4.\n        filtered_numbers.sort() \n        return filtered_numbers\ndef unique_digits(x: list[int]) -> list[int]:\n    \"\"\"Given a list of positive integers x, return a sorted list of all \n    elements that have no even digits.\n    This function acts as a facade, utilizing the UniqueDigitsProcessor for core logic.\n    \"\"\"\n    processor = UniqueDigitsProcessor()\n    return processor.filter_and_sort(x)"}
{"task_id": "HumanEval/104", "solution": "class DigitChecker:\n    # Set of even digits for quick lookup.\n    EVEN_DIGITS = {0, 2, 4, 6, 8}\n\n    @staticmethod\n    def has_even_digit(n: int) -> bool:\n        \"\"\"\n        Checks if a given positive integer n contains any even digits.\n        The digit 0 is considered an even digit.\n        \"\"\"\n        if n == 0:\n            return True\n        \n        temp_n = n\n        while temp_n > 0:\n            digit = temp_n % 10\n            if digit in DigitChecker.EVEN_DIGITS:\n                return True\n            temp_n //= 10\n        return False\ndef unique_digits(x):\n    \"\"\"Given a list of positive integers x. return a sorted list of all \n    elements that hasn't any even digit.\n    \"\"\"\n    filtered_list = []\n    for number in x:\n        # Check if the number contains only odd digits using DigitChecker.\n        if not DigitChecker.has_even_digit(number):\n            filtered_list.append(number)\n    \n    # Sort the collected integers in increasing order.\n    filtered_list.sort()\n    return filtered_list"}
{"task_id": "HumanEval/106", "solution": "def f(n):\n    \"\"\"\n    Computes a sequence of numbers based on n.\n    Each element at 1-based index i is i! if i is even, or sum(1..i) if i is odd.\n    \"\"\"\n    def _factorial(i: int) -> int:\n        \"\"\"Calculates the factorial of a non-negative integer i.\n        Returns 1 for i=0, and i! for i > 0.\"\"\"\n        result = 1\n        for k in range(1, i + 1):\n            result *= k\n        return result\n\n    def _sum_up_to(i: int) -> int:\n        \"\"\"Calculates the sum of integers from 1 to i.\n        Uses the arithmetic series formula i*(i+1)/2.\"\"\"\n        return i * (i + 1) // 2\n\n    if not isinstance(n, int):\n        raise TypeError(\"Input n must be an integer.\")\n    if n < 0:\n        raise ValueError(\"Input n cannot be negative.\")\n    if n == 0:\n        return []\n\n    result = []\n    for i in range(1, n + 1):\n        if i % 2 == 0:  # i is even\n            result.append(_factorial(i))\n        else:  # i is odd\n            result.append(_sum_up_to(i))\n            \n    return result"}
{"task_id": "HumanEval/107", "solution": "def even_odd_palindrome(n: int) -> tuple[int, int]:\n    \"\"\"\n    Given a positive integer n, return a tuple that has the number of even and odd\n    integer palindromes that fall within the range(1, n), inclusive.\n    \"\"\"\n    if not isinstance(n, int) or not (1 <= n <= 1000):\n        raise ValueError(\"Input 'n' must be an integer between 1 and 1000 inclusive.\")\n\n    even_count = 0\n    odd_count = 0\n\n    for i in range(1, n + 1):\n        s_i = str(i)\n        if s_i == s_i[::-1]:  # Check if the number is a palindrome\n            if i % 2 == 0:\n                even_count += 1\n            else:\n                odd_count += 1\n\n    return (even_count, odd_count)"}
{"task_id": "HumanEval/105", "solution": "def by_length(arr):\n    \"\"\"\n    Processes an array by filtering valid digits (1-9), sorting them in descending order,\n    and converting them to their English word representations. Returns an empty list if no valid digits are found.\n    \"\"\"\n    digit_words_map = {\n        1: \"One\", 2: \"Two\", 3: \"Three\", 4: \"Four\", 5: \"Five\",\n        6: \"Six\", 7: \"Seven\", 8: \"Eight\", 9: \"Nine\",\n    }\n    \n    # Filter integers between 1 and 9 inclusive.\n    filtered_integers = [num for num in arr if isinstance(num, int) and 1 <= num <= 9]\n\n    # If no valid integers remain, return an empty list.\n    if not filtered_integers:\n        return []\n\n    # Sort the filtered integers in descending order.\n    sorted_and_reversed_integers = sorted(filtered_integers, reverse=True)\n\n    # Convert each integer to its English word equivalent.\n    result_words = [digit_words_map[num] for num in sorted_and_reversed_integers]\n\n    return result_words"}
{"task_id": "HumanEval/105", "solution": "def by_length(arr):\n    \"\"\"\n    Given an array of integers, sorts valid digits (1-9), reverses them, and converts to English words.\n    Ignores non-integers and numbers outside the 1-9 range.\n    \"\"\"\n    DIGIT_NAMES = {\n        1: \"One\", 2: \"Two\", 3: \"Three\", 4: \"Four\", 5: \"Five\",\n        6: \"Six\", 7: \"Seven\", 8: \"Eight\", 9: \"Nine\"\n    }\n\n    filtered_numbers = []\n    for num in arr:\n        if isinstance(num, int) and 1 <= num <= 9:\n            filtered_numbers.append(num)\n\n    if not filtered_numbers:\n        return []\n\n    # Sorts in ascending order then reverses, equivalent to sorting in descending order directly.\n    sorted_reversed_numbers = sorted(filtered_numbers, reverse=True)\n\n    word_representations = [DIGIT_NAMES[num] for num in sorted_reversed_numbers]\n\n    return word_representations"}
{"task_id": "HumanEval/106", "solution": "def _calculate_factorial(i: int) -> int:\n    \"\"\"Calculates the factorial of i.\"\"\"\n    if i < 0:\n        raise ValueError(\"Factorial is not defined for negative numbers.\")\n    if i == 0:\n        return 1\n    result = 1\n    for num in range(1, i + 1):\n        result *= num\n    return result\ndef _calculate_sum(i: int) -> int:\n    \"\"\"Calculates the sum of numbers from 1 to i.\"\"\"\n    if i < 0:\n        raise ValueError(\"Sum is not defined for negative numbers in this context.\")\n    return i * (i + 1) // 2\ndef f(n: int) -> list[int]:\n    \"\"\"\n    Implement the function f that takes n as a parameter,\n    and returns a list of size n, such that the value of the element at index i is the factorial of i if i is even\n    or the sum of numbers from 1 to i otherwise.\n    i starts from 1.\n    the factorial of i is the multiplication of the numbers from 1 to i (1 * 2 * ... * i).\n    Example:\n    f(5) == [1, 2, 6, 24, 15]\n    \"\"\"\n    if n < 0:\n        raise ValueError(\"Input 'n' cannot be negative.\")\n    if n == 0:\n        return []\n\n    result_list: list[int] = []\n    for i in range(1, n + 1): # 1-based index\n        if i % 2 == 0:  # Even index\n            result_list.append(_calculate_factorial(i))\n        else:  # Odd index\n            result_list.append(_calculate_sum(i))\n    return result_list"}
{"task_id": "HumanEval/107", "solution": "def even_odd_palindrome(n):\n    \"\"\"\n    Given a positive integer n, return a tuple (even_count, odd_count)\n    of palindromes within the range [1, n].\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"Input 'n' must be an integer.\")\n    if n < 1:\n        raise ValueError(\"Input 'n' must be a positive integer.\")\n\n    even_count = 0\n    odd_count = 0\n\n    for i in range(1, n + 1):\n        # Check if 'i' is a palindrome by comparing its string representation with its reverse.\n        s_num = str(i)\n        if s_num == s_num[::-1]:\n            # Determine if the identified palindrome is even or odd.\n            if i % 2 == 0:\n                even_count += 1\n            else:\n                odd_count += 1\n\n    return (even_count, odd_count)"}
