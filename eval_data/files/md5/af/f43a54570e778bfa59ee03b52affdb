{"task_id": "HumanEval/93", "solution": "VOWELS = {'a', 'e', 'i', 'o', 'u'}\ndef encode(message: str) -> str:\n    \"\"\"Encodes a message by swapping letter cases and shifting vowels.\n    Vowels are shifted 2 places forward, wrapping around the alphabet.\n    \"\"\"\n    encoded_chars = []\n    for char in message:\n        if not char.isalpha():\n            # Non-alphabetic characters are preserved as-is.\n            encoded_chars.append(char)\n            continue\n\n        lower_char_input = char.lower()\n        \n        # Rule 1: Swap the case of all letters\n        swapped_case_char = char.swapcase()\n\n        # Rule 2: Replace all vowels with the letter that appears 2 places ahead\n        if lower_char_input in VOWELS:\n            # Shift the lowercase vowel by 2, handling wrap-around (e.g., 'y' -> 'a', 'z' -> 'b').\n            shifted_ascii_offset = (ord(lower_char_input) - ord('a') + 2) % 26\n            shifted_lower_char = chr(ord('a') + shifted_ascii_offset)\n            \n            # Apply the case of the swapped_case_char to the shifted vowel.\n            if swapped_case_char.isupper():\n                encoded_chars.append(shifted_lower_char.upper())\n            else:\n                encoded_chars.append(shifted_lower_char.lower())\n        else:\n            # If not a vowel, just apply the case swap.\n            encoded_chars.append(swapped_case_char)\n    \n    return \"\".join(encoded_chars)"}
