{"task_id": "HumanEval/82", "solution": "def prime_length(string):\n    \"\"\"\n    Checks if the length of the input string is a prime number.\n    Raises TypeError if the input is not a string.\n    \"\"\"\n    if not isinstance(string, str):\n        raise TypeError(\"Input must be a string.\")\n\n    length = len(string)\n\n    def _is_prime_helper(n):\n        # A prime number is a natural number greater than 1.\n        if n < 2:\n            return False\n        # Checks for factors from 2 up to the square root of n for efficiency.\n        for i in range(2, int(n**0.5) + 1):\n            if n % i == 0:\n                return False\n        return True\n\n    return _is_prime_helper(length)"}
{"task_id": "HumanEval/84", "solution": "class InvalidInputError(ValueError):\n    \"\"\"Custom exception for invalid input values.\n    This is raised when an input N is outside the specified range.\n    \"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\nclass BinaryConverter:\n    \"\"\"Utility for converting integers to binary strings.\n    It provides a method to get the binary representation of a non-negative integer.\n    \"\"\"\n\n    def int_to_binary_string(self, value: int) -> str:\n        \"\"\"Converts a non-negative integer to its binary string.\n        Handles the special case for 0 and uses Python's built-in bin function.\n        \"\"\"\n        if value < 0:\n            raise ValueError(\"Input value must be non-negative for binary conversion.\")\n        return bin(value)[2:] if value > 0 else \"0\"\nclass DigitSumService:\n    \"\"\"Service for calculating digit sum and converting it to binary.\n    It orchestrates input validation, digit sum calculation, and binary conversion.\n    \"\"\"\n    def __init__(self, binary_converter: BinaryConverter):\n        self._binary_converter = binary_converter\n\n    def _validate_input(self, N: int) -> None:\n        \"\"\"Validates if N is within the allowed constraints (0 <= N <= 10000).\n        Raises InvalidInputError if the input N is out of range.\n        \"\"\"\n        if not (0 <= N <= 10000):\n            raise InvalidInputError(f\"Input N={N} is out of range (0 <= N <= 10000).\")\n\n    def calculate_binary_digit_sum(self, N: int) -> str:\n        \"\"\"Calculates the sum of digits of N and returns its binary string.\n        First validates N, then sums its decimal digits, and finally converts the sum to binary.\n        \"\"\"\n        self._validate_input(N)\n\n        digit_sum = 0\n        for digit_char in str(N):\n            digit_sum += int(digit_char)\n        \n        return self._binary_converter.int_to_binary_string(digit_sum)\ndef solve(N: int) -> str:\n    \"\"\"Given an integer N, calculates the sum of its digits and returns this sum in binary string format.\n    The input N must be within the range 0 <= N <= 10000.\n    \"\"\"\n    binary_converter = BinaryConverter()\n    digit_sum_service = DigitSumService(binary_converter)\n    return digit_sum_service.calculate_binary_digit_sum(N)"}
{"task_id": "HumanEval/83", "solution": "def starts_one_ends(n: int) -> int:\n    \"\"\"\n    Given a positive integer n, return the count of n-digit positive integers\n    that start or end with 1.\n    \"\"\"\n    # Validate input 'n' as a positive integer as per FR1.\n    if not isinstance(n, int) or n <= 0:\n        raise ValueError(\"Input 'n' must be a positive integer.\")\n\n    # Handle the special case for n=1.\n    # The only 1-digit positive integer starting or ending with 1 is '1'.\n    if n == 1:\n        return 1\n\n    # Calculate count of n-digit numbers that start with 1 (FR2).\n    # The first digit is 1. The remaining (n-1) digits can be any from 0-9.\n    count_starts_with_1 = 10**(n - 1)\n\n    # Calculate count of n-digit numbers that end with 1 (FR3).\n    # The last digit is 1. The first digit can be 1-9 (9 choices), and the\n    # remaining (n-2) digits can be 0-9 (10 choices each).\n    count_ends_with_1 = 9 * (10**(n - 2))\n\n    # Calculate count of n-digit numbers that start AND end with 1 (FR4).\n    # The first and last digits are 1. The middle (n-2) digits can be any from 0-9.\n    count_starts_and_ends_with_1 = 10**(n - 2)\n\n    # Apply the Principle of Inclusion-Exclusion to get the total count (FR5).\n    # Total = (Starts with 1) + (Ends with 1) - (Starts and Ends with 1).\n    total_count = count_starts_with_1 + count_ends_with_1 - count_starts_and_ends_with_1\n    return total_count"}
{"task_id": "HumanEval/78", "solution": "def hex_key(num):\n    \"\"\"Counts prime hexadecimal digits in a given string.\n    Identifies digits 2, 3, 5, 7, B (decimal 11), and D (decimal 13).\n    \"\"\"\n    PRIME_HEX_DIGITS = {'2', '3', '5', '7', 'B', 'D'}\n    count = 0\n    for digit in num:\n        if digit in PRIME_HEX_DIGITS:\n            count += 1\n    return count"}
{"task_id": "HumanEval/95", "solution": "def check_dict_case(dict):\n    \"\"\"\n    Given a dictionary, return True if all keys are strings in lower \n    case or all keys are strings in upper case, else return False.\n    Returns False for empty dictionaries or if non-string keys are present.\n    \"\"\"\n    if not dict:\n        return False\n\n    string_keys = [key for key in dict.keys() if isinstance(key, str)]\n\n    # If the number of string keys is less than the total number of keys, non-string keys exist.\n    if len(string_keys) < len(dict):\n        return False\n\n    # Check if all string keys are entirely lowercase or entirely uppercase.\n    all_lower = all(key.islower() for key in string_keys)\n    all_upper = all(key.isupper() for key in string_keys)\n\n    return all_lower or all_upper"}
{"task_id": "HumanEval/91", "solution": "class SentenceSplitter:\n    \"\"\"\n    Splits text into sentences based on defined delimiters.\n    Handles leading/trailing whitespace and empty sentences.\n    \"\"\"\n    SENTENCE_DELIMITERS = ['.', '?', '!']\n\n    def split(self, text: str) -> list[str]:\n        sentences = []\n        current_sentence_chars = []\n        for char in text:\n            current_sentence_chars.append(char)\n            if char in self.SENTENCE_DELIMITERS:\n                sentence = \"\".join(current_sentence_chars).strip()\n                if sentence:  # Avoid adding empty strings\n                    sentences.append(sentence)\n                current_sentence_chars = []\n        \n        # Add any remaining text as a sentence if it's not empty\n        remaining = \"\".join(current_sentence_chars).strip()\n        if remaining:\n            sentences.append(remaining)\n            \n        return sentences\nclass BoredomCounter:\n    \"\"\"\n    Counts sentences that start with the word \"I\" (case-sensitive) within a list of sentences.\n    It takes a SentenceSplitter instance but primarily processes the provided sentences list.\n    \"\"\"\n    def __init__(self, sentence_splitter: SentenceSplitter):\n        self.sentence_splitter = sentence_splitter # Dependency injected but not directly used by count_boredoms\n\n    def count_boredoms(self, sentences: list[str]) -> int:\n        boredom_count = 0\n        for sentence in sentences:\n            cleaned_sentence = sentence.strip()\n            # Check for \"I \" to ensure it's the word \"I\" at the start, or just \"I\" as a full sentence.\n            if cleaned_sentence.startswith(\"I \") or cleaned_sentence == \"I\":\n                boredom_count += 1\n        return boredom_count\ndef is_bored(S: str) -> int:\n    \"\"\"\n    Counts the number of boredoms in a string.\n    A boredom is a sentence that starts with the word \"I\".\n    \"\"\"\n    splitter = SentenceSplitter()\n    sentences = splitter.split(S)\n    counter = BoredomCounter(splitter)\n    return counter.count_boredoms(sentences)"}
{"task_id": "HumanEval/94", "solution": "import math\ndef skjkasdkd(lst):\n    \"\"\"\n    Finds the largest prime number in a list and returns the sum of its digits.\n    Returns 0 if no prime numbers are found in the list.\n    \"\"\"\n\n    def _is_prime(n: int) -> bool:\n        \"\"\"Determines if a given integer n is a prime number.\n        It efficiently checks for divisibility up to the square root of n.\"\"\"\n        if n < 2:\n            return False\n        if n == 2:\n            return True\n        if n % 2 == 0:\n            return False\n        for i in range(3, int(math.sqrt(n)) + 1, 2):\n            if n % i == 0:\n                return False\n        return True\n\n    def _sum_digits(n: int) -> int:\n        \"\"\"Calculates the sum of the digits of a non-negative integer n.\n        It processes the absolute value of n to sum digits correctly.\"\"\"\n        s = 0\n        n_abs = abs(n)\n        while n_abs > 0:\n            s += n_abs % 10\n            n_abs //= 10\n        return s\n\n    largest_prime = None\n    for num in lst:\n        if _is_prime(num):\n            if largest_prime is None or num > largest_prime:\n                largest_prime = num\n    \n    if largest_prime is None:\n        return 0\n    else:\n        return _sum_digits(largest_prime)"}
{"task_id": "HumanEval/96", "solution": "def count_up_to(n):\n    \"\"\"\n    Returns a list of all prime numbers strictly less than n.\n    It includes input validation and handles edge cases.\n    \"\"\"\n    if not isinstance(n, int):\n        raise ValueError(\"Input 'n' must be an integer.\")\n    if n < 0:\n        raise ValueError(\"Input 'n' must be a non-negative integer.\")\n\n    def is_prime(num: int) -> bool:\n        \"\"\"\n        Determines if a given integer is a prime number.\n        It uses trial division up to the square root of the number.\n        \"\"\"\n        if num < 2:\n            return False\n        for i in range(2, int(num**0.5) + 1):\n            if num % i == 0:\n                return False\n        return True\n\n    primes = []\n    for num in range(2, n):\n        if is_prime(num):\n            primes.append(num)\n    return primes"}
