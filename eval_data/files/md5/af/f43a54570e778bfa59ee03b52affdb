{"task_id": "HumanEval/21", "solution": "from typing import List\nclass InvalidInputError(ValueError):\n    \"\"\"Custom exception for invalid input conditions in the rescaler service.\n    It carries a descriptive message about the input error.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\ndef rescale_to_unit(numbers: List[float]) -> List[float]:\n    \"\"\"Applies a linear transformation to a list of numbers, scaling them to the unit interval [0, 1].\n    Raises InvalidInputError if the list is too short or contains identical numbers.\"\"\"\n\n    if len(numbers) < 2:\n        raise InvalidInputError(\"Input list must contain at least two elements for rescaling.\")\n\n    min_val = min(numbers)\n    max_val = max(numbers)\n\n    range_val = max_val - min_val\n    if range_val == 0:\n        raise InvalidInputError(\"All numbers in the input list are identical, rescaling is undefined.\")\n\n    rescaled_numbers = [(x - min_val) / range_val for x in numbers]\n\n    return rescaled_numbers"}
{"task_id": "HumanEval/20", "solution": "from typing import List, Tuple\ndef find_closest_elements(numbers: List[float]) -> Tuple[float, float]:\n    \"\"\" From a supplied list of numbers (of length at least two) select and return two that are the closest to each\n    other and return them in order (smaller number, larger number).\n    \"\"\"\n    if not isinstance(numbers, list):\n        raise TypeError(\"Input must be a list.\")\n    if len(numbers) < 2:\n        raise ValueError(\"Input list must contain at least 2 elements.\")\n\n    # Sort the list to efficiently find closest elements by checking adjacent pairs.\n    sorted_numbers = sorted(numbers)\n\n    min_diff = float('inf')\n    closest_pair: Tuple[float, float] = (0.0, 0.0)\n\n    # Iterate through adjacent elements to find the minimum difference.\n    for i in range(len(sorted_numbers) - 1):\n        diff = abs(sorted_numbers[i+1] - sorted_numbers[i])\n        if diff < min_diff:\n            min_diff = diff\n            closest_pair = (sorted_numbers[i], sorted_numbers[i+1])\n\n    return closest_pair"}
