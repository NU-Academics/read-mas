{"task_id": "HumanEval/57", "solution": "def monotonic(l: list):\n    \"\"\"Return True if list elements are monotonically increasing or decreasing.\n    >>> monotonic([1, 2, 4, 20])\n    True\n    >>> monotonic([1, 20, 4, 10])\n    False\n    >>> monotonic([4, 1, 0, -10])\n    True\n    \"\"\"\n    if len(l) <= 1:\n        return True\n\n    is_increasing = False\n    is_decreasing = False\n\n    # Find first non-equal pair to determine initial trend.\n    i = 0\n    while i < len(l) - 1 and l[i] == l[i+1]:\n        i += 1\n    \n    if i == len(l) - 1: # All elements are the same, considered monotonic.\n        return True\n\n    # Determine initial trend.\n    if l[i] < l[i+1]:\n        is_increasing = True\n    elif l[i] > l[i+1]:\n        is_decreasing = True\n    \n    # Check the rest of the list for trend violations.\n    for j in range(i + 1, len(l) - 1):\n        if is_increasing:\n            if l[j] > l[j+1]: # Violation of non-decreasing trend.\n                return False\n        elif is_decreasing:\n            if l[j] < l[j+1]: # Violation of non-increasing trend.\n                return False\n    \n    return True"}
{"task_id": "HumanEval/62", "solution": "def derivative(xs: list):\n    \"\"\"\n    xs represent coefficients of a polynomial: xs[0] + xs[1] * x + xs[2] * x^2 + .... Returns its derivative.\n    Handles edge cases for constant or empty polynomials by returning an empty list.\n    \"\"\"\n    if not isinstance(xs, list):\n        raise TypeError(\"Input 'xs' must be a list.\")\n    if not all(isinstance(x, (int, float)) for x in xs):\n        raise TypeError(\"All elements in 'xs' must be numeric.\")\n\n    if len(xs) <= 1:\n        return []\n\n    # The derivative of c_i * x^i is i * c_i * x^(i-1)\n    # The new coefficient for x^j is (j+1) * original_coeff_of_x^(j+1)\n    return [(i + 1) * xs[i + 1] for i in range(len(xs) - 1)]"}
