{"task_id": "HumanEval/59", "solution": "def largest_prime_factor(n: int) -> int:\n    \"\"\"Return the largest prime factor of n. Assume n > 1 and is not a prime.\"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"Input 'n' must be an integer.\")\n    if n <= 1:\n        raise ValueError(\"Input 'n' must be greater than 1.\")\n\n    largest_factor = 1\n\n    # Handle factors of 2 by repeatedly dividing n.\n    while n % 2 == 0:\n        largest_factor = 2\n        n //= 2\n\n    # Iterate through odd factors up to sqrt(n).\n    i = 3\n    while i * i <= n:\n        while n % i == 0:\n            largest_factor = i\n            n //= i\n        i += 2\n\n    # If n remains > 2, it is the largest prime factor.\n    if n > 2:\n        largest_factor = n\n\n    return largest_factor"}
{"task_id": "HumanEval/56", "solution": "def correct_bracketing(brackets: str) -> bool:\n    \"\"\" brackets is a string of \"<\" and \">\".\n    return True if every opening bracket has a corresponding closing bracket.\n\n    >>> correct_bracketing(\"<\")\n    False\n    >>> correct_bracketing(\"<>\")\n    True\n    >>> correct_bracketing(\"<<><>>\")\n    True\n    >>> correct_bracketing(\"><<>\")\n    False\n    \"\"\"\n    balance = 0\n    for char in brackets:\n        if char == '<':\n            balance += 1\n        elif char == '>':\n            balance -= 1\n        if balance < 0:\n            return False\n    return balance == 0"}
{"task_id": "HumanEval/60", "solution": "def sum_to_n(n: int) -> int:\n    \"\"\"Calculates the sum of integers from 1 to n. Raises ValueError if n is not a positive integer.\"\"\"\n    if not isinstance(n, int) or n <= 0:\n        raise ValueError(\"Input 'n' must be a positive integer.\")\n    return n * (n + 1) // 2"}
{"task_id": "HumanEval/55", "solution": "from typing import Dict\nclass InvalidInputError(ValueError):\n    \"\"\"Custom exception for invalid input parameters.\"\"\"\n    pass\nclass Utils:\n    @staticmethod\n    def validate_positive_integer(n: int) -> None:\n        \"\"\"Checks if the provided argument `n` is an integer and is strictly greater than zero.\"\"\"\n        if not isinstance(n, int) or n <= 0:\n            raise InvalidInputError(\"Input 'n' must be a positive integer.\")\nclass FibonacciCalculator:\n    def __init__(self):\n        # Base cases for F(1)=1, F(2)=1 based on user's example fib(1)=1.\n        self._memo: Dict[int, int] = {1: 1, 2: 1} \n\n    def calculate(self, n: int) -> int:\n        Utils.validate_positive_integer(n)\n\n        if n in self._memo:\n            return self._memo[n]\n\n        # If n is not 1 or 2, we need to compute it iteratively.\n        # Initialize a and b with F(1) and F(2) to start the iteration from F(3).\n        a, b = 1, 1 \n        \n        # Iterate from the 3rd Fibonacci number up to n.\n        for i in range(3, n + 1):\n            a, b = b, a + b\n            self._memo[i] = b \n            # Store intermediate results in the memoization cache.\n        \n        # After the loop, b holds the nth Fibonacci number.\n        # Ensure the final result is also stored in the cache.\n        self._memo[n] = b \n        return b\n_calculator = FibonacciCalculator()\ndef fib(n: int) -> int:\n    \"\"\"Return n-th Fibonacci number.\n    >>> fib(10)\n    55\n    >>> fib(1)\n    1\n    >>> fib(8)\n    21\n    \"\"\"\n    return _calculator.calculate(n)"}
{"task_id": "HumanEval/60", "solution": "def sum_to_n(n: int) -> int:\n    \"\"\"Calculates the sum of all positive integers from 1 up to n.\n    Uses the arithmetic series formula for O(1) efficiency.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"Parameter 'n' must be an integer.\")\n    if n <= 0:\n        raise ValueError(\"Parameter 'n' must be a positive integer.\")\n\n    return n * (n + 1) // 2"}
{"task_id": "HumanEval/61", "solution": "def correct_bracketing(brackets: str) -> bool:\n    \"\"\" brackets is a string of \"(\" and \")\".\n    Returns True if every opening bracket has a corresponding closing bracket and they are correctly nested.\n    \"\"\"\n    balance = 0\n    for char in brackets:\n        if char == '(':\n            balance += 1\n        elif char == ')':\n            balance -= 1\n        if balance < 0:  # A closing bracket appeared without a matching open one.\n            return False\n    return balance == 0  # True if all brackets are matched, False otherwise."}
{"task_id": "HumanEval/62", "solution": "from typing import List, Union\ndef derivative(xs: list) -> List[Union[int, float]]:\n    \"\"\"\n    Calculates the derivative of a polynomial given its coefficients.\n    xs[0] + xs[1] * x + xs[2] * x^2 + .... Returns derivative in the same form.\n    \"\"\"\n    if not isinstance(xs, list):\n        raise TypeError(\"Input 'xs' must be a list.\")\n    \n    if not all(isinstance(c, (int, float)) for c in xs):\n        raise ValueError(\"All elements in 'xs' must be numeric.\")\n\n    if len(xs) <= 1:\n        return []\n\n    derived_coefficients: List[Union[int, float]] = []\n    for i in range(1, len(xs)):\n        derived_coefficients.append(xs[i] * i)\n    return derived_coefficients"}
