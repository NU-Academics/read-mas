{"task_id": "HumanEval/101", "solution": "def words_string(s):\n    \"\"\"\n    Splits a string of words separated by commas or spaces into a list of words.\n    The input string `s` is processed to extract words.\n    \"\"\"\n    # Replace commas with spaces to unify delimiters.\n    s_cleaned = s.replace(',', ' ')\n    # Split by spaces and filter out any empty strings from multiple delimiters or leading/trailing spaces.\n    words = [word for word in s_cleaned.split(' ') if word]\n    return words"}
{"task_id": "HumanEval/101", "solution": "import re\ndef words_string(s: str) -> list[str]:\n    \"\"\"\n    Splits a string into a list of words using commas or spaces as delimiters.\n    Handles multiple and leading/trailing delimiters gracefully.\n    \"\"\"\n    if not s:\n        return []\n    # Split by one or more commas or spaces, then filter out any empty strings.\n    words = re.split(r'[, ]+', s)\n    return [word for word in words if word]"}
{"task_id": "HumanEval/98", "solution": "UPPERCASE_VOWELS = {'A', 'E', 'I', 'O', 'U'}\ndef count_upper(s: str) -> int:\n    \"\"\"Counts uppercase vowels at even indices within the input string `s`. Returns the total count as an integer.\n    \n    For example:\n    count_upper('aBCdEf') returns 1\n    count_upper('abcdefg') returns 0\n    count_upper('dBBE') returns 0\n    \"\"\"\n    count = 0\n    for i, char in enumerate(s):\n        if i % 2 == 0 and char in UPPERCASE_VOWELS:\n            count += 1\n    return count"}
