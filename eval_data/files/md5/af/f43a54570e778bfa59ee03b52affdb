{"task_id": "HumanEval/19", "solution": "from typing import List, Dict, Optional\nWORD_TO_INT_MAP = {\n    \"zero\": 0,\n    \"one\": 1,\n    \"two\": 2,\n    \"three\": 3,\n    \"four\": 4,\n    \"five\": 5,\n    \"six\": 6,\n    \"seven\": 7,\n    \"eight\": 8,\n    \"nine\": 9,\n}\nINT_TO_WORD_MAP = {\n    0: \"zero\",\n    1: \"one\",\n    2: \"two\",\n    3: \"three\",\n    4: \"four\",\n    5: \"five\",\n    6: \"six\",\n    7: \"seven\",\n    8: \"eight\",\n    9: \"nine\",\n}\nclass NumberWordConverter:\n    \"\"\"Provides bidirectional mapping between number words and integers.\"\"\"\n    def __init__(self):\n        self._word_to_int_map: Dict[str, int] = WORD_TO_INT_MAP\n        self._int_to_word_map: Dict[int, str] = INT_TO_WORD_MAP\n\n    def word_to_int(self, word: str) -> Optional[int]:\n        \"\"\"Converts a number word string to its integer equivalent.\"\"\"\n        return self._word_to_int_map.get(word.lower())\n\n    def int_to_word(self, num: int) -> Optional[str]:\n        \"\"\"Converts an integer to its number word string equivalent.\"\"\"\n        return self._int_to_word_map.get(num)\nclass NumberSorterService:\n    \"\"\"Orchestrates splitting, converting, sorting, and rejoining number words.\"\"\"\n    def __init__(self, converter: NumberWordConverter):\n        self._converter = converter\n\n    def sort_numbers(self, numbers_str: str) -> str:\n        \"\"\"Sorts a space-delimited string of number words numerically.\"\"\"\n        if not numbers_str:\n            return \"\"\n\n        words: List[str] = numbers_str.split(' ')\n        \n        integers: List[int] = []\n        for word in words:\n            num = self._converter.word_to_int(word)\n            if num is not None:\n                integers.append(num)\n        \n        integers.sort()\n        \n        sorted_words: List[str] = []\n        for num in integers:\n            word = self._converter.int_to_word(num)\n            if word is not None:\n                sorted_words.append(word)\n        \n        return ' '.join(sorted_words)\ndef sort_numbers(numbers: str) -> str:\n    \"\"\" Input is a space-delimited string of numberals from 'zero' to 'nine'.\n    Valid choices are 'zero', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight' and 'nine'.\n    Return the string with numbers sorted from smallest to largest\n    >>> sort_numbers('three one five')\n    'one three five'\n    \"\"\"\n    converter = NumberWordConverter()\n    sorter_service = NumberSorterService(converter)\n    return sorter_service.sort_numbers(numbers)"}
{"task_id": "HumanEval/19", "solution": "from typing import List, Dict\nWORD_TO_INT_MAP: Dict[str, int] = {\n    \"zero\": 0,\n    \"one\": 1,\n    \"two\": 2,\n    \"three\": 3,\n    \"four\": 4,\n    \"five\": 5,\n    \"six\": 6,\n    \"seven\": 7,\n    \"eight\": 8,\n    \"nine\": 9\n}\nINT_TO_WORD_MAP: Dict[int, str] = {\n    0: \"zero\",\n    1: \"one\",\n    2: \"two\",\n    3: \"three\",\n    4: \"four\",\n    5: \"five\",\n    6: \"six\",\n    7: \"seven\",\n    8: \"eight\",\n    9: \"nine\"\n}\nclass InvalidNumberWordError(ValueError):\n    \"\"\"Custom exception raised when an invalid number word is encountered.\"\"\"\n    pass\ndef sort_numbers(numbers: str) -> str:\n    \"\"\" Input is a space-delimited string of numberals from 'zero' to 'nine'.\n    Valid choices are 'zero', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight' and 'nine'.\n    Return the string with numbers sorted from smallest to largest\n    >>> sort_numbers('three one five')\n    'one three five'\n    \"\"\"\n    if not numbers.strip():\n        return ''\n\n    words = numbers.split()\n    \n    # Convert words to integers, handling case-insensitivity and invalid words.\n    try:\n        int_numbers = [WORD_TO_INT_MAP[word.lower()] for word in words]\n    except KeyError as e:\n        raise InvalidNumberWordError(f\"'{e.args[0]}' is not a valid number word.\") from e\n\n    # Sort the list of integers in ascending order.\n    int_numbers.sort()\n\n    # Convert sorted integers back to their corresponding number words.\n    sorted_words = [INT_TO_WORD_MAP[num] for num in int_numbers]\n    return ' '.join(sorted_words)"}
{"task_id": "HumanEval/17", "solution": "from typing import List, Dict\nfrom enum import Enum\nclass InvalidMusicStringError(Exception):\n    \"\"\"Custom exception raised for unrecognized or invalid musical note formats.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\nclass NoteType(Enum):\n    \"\"\"Enumeration defining valid musical note types and their beat durations.\"\"\"\n    WHOLE = 4\n    HALF = 2\n    QUARTER = 1\nWHOLE_NOTE_STR: str = \"o\"\nHALF_NOTE_STR: str = \"o|\"\nQUARTER_NOTE_STR: str = \".|\"\nclass MusicParser:\n    \"\"\"Orchestrates parsing of a musical ASCII string into beat durations.\"\"\"\n    _note_map: Dict[str, int]\n\n    def __init__(self):\n        \"\"\"Initializes the MusicParser with a mapping of note strings to beat values.\"\"\"\n        self._note_map = {\n            WHOLE_NOTE_STR: NoteType.WHOLE.value,\n            HALF_NOTE_STR: NoteType.HALF.value,\n            QUARTER_NOTE_STR: NoteType.QUARTER.value,\n        }\n\n    def parse(self, music_string: str) -> List[int]:\n        \"\"\"Parses the input string, tokenizes it, and converts notes to beat durations.\"\"\"\n        if not music_string or music_string.strip() == '':\n            return []\n\n        tokens = music_string.split()\n        beat_durations: List[int] = []\n\n        for token in tokens:\n            beat_value = self._note_map.get(token)\n            if beat_value is None:\n                raise InvalidMusicStringError(f\"Unrecognized note format: '{token}'\")\n            beat_durations.append(beat_value)\n\n        return beat_durations\ndef parse_music(music_string: str) -> List[int]:\n    \"\"\" Input to this function is a string representing musical notes in a special ASCII format.\n    Your task is to parse this string and return list of integers corresponding to how many beats does each\n    not last.\n\n    Here is a legend:\n    'o' - whole note, lasts four beats\n    'o|' - half note, lasts two beats\n    '.|' -