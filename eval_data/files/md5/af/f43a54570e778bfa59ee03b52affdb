{"task_id": "HumanEval/87", "solution": "def get_row(lst: list[list[int]], x: int) -> list[tuple[int, int]]:\n    \"\"\"\n    Finds all occurrences of integer x in a 2D nested list and returns\n    their (row, column) coordinates, sorted by row ascending, then by\n    column descending.\n    \"\"\"\n    coordinates = []\n    # Iterate through the list to find all occurrences of x and record their coordinates.\n    for r_idx, row in enumerate(lst):\n        for c_idx, val in enumerate(row):\n            if val == x:\n                coordinates.append((r_idx, c_idx))\n\n    # Sort the collected coordinates based on the specified criteria.\n    coordinates.sort(key=lambda coord: (coord[0], -coord[1]))\n    return coordinates"}
{"task_id": "HumanEval/86", "solution": "import re\ndef anti_shuffle(s: str) -> str:\n    \"\"\"\n    Returns an ordered version of the string where characters within words are sorted by ASCII value.\n    Preserves the original order of words and space sequences.\n    \"\"\"\n    parts = re.split(r'(\\s+)', s)\n    result_parts = []\n    for part in parts:\n        if not part.strip():  # It's a space sequence (e.g., ' ', '\\t\\n', '   ')\n            result_parts.append(part)\n        else:  # It's a word (sequence of non-space characters)\n            result_parts.append(\"\".join(sorted(part)))\n    return \"\".join(result_parts)"}
{"task_id": "HumanEval/81", "solution": "_GRADING_SCALE_INTERNAL = [\n    (4.0, 'A+'),\n    (3.7, 'A'),\n    (3.3, 'A-'),\n    (3.0, 'B+'),\n    (2.7, 'B'),\n    (2.3, 'B-'),\n    (2.0, 'C+'),\n    (1.7, 'C'),\n    (1.3, 'C-'),\n    (1.0, 'D+'),\n    (0.7, 'D'),\n    (0.0, 'D-'),\n    (-0.1, 'E') # Catches 0.0 and any negative GPAs, implementing BR13 (0.0 -> E) for values <= 0.0\n]\ndef numerical_letter_grade(grades: list[float]) -> list[str]:\n    \"\"\"\n    Converts a list of GPAs to a list of letter grades based on a predefined scale.\n    Raises TypeError if input is not a list or contains non-numeric values.\n    \"\"\"\n    if not isinstance(grades, list):\n        raise TypeError(\"Input 'grades' must be a list.\")\n    \n    result_grades = []\n    for gpa in grades:\n        if not isinstance(gpa, (int, float)):\n            raise TypeError(f\"Each GPA in the list must be a number, got {type(gpa)}.\")\n        \n        # FR2: Convert each GPA to a corresponding letter grade.\n        # Iterates through the scale to find the first matching grade.\n        letter_grade_found = False\n        for threshold, letter_grade in _GRADING_SCALE_INTERNAL:\n            # Handle exact 4.0 as 'A+' as per BR1, before general 'gpa > threshold' rule.\n            if gpa == 4.0 and threshold == 4.0:\n                result_grades.append(letter_grade)\n                letter_grade_found = True\n                break\n            # Apply \"greater than\" logic for other grades.\n            if gpa > threshold:\n                result_grades.append(letter_grade)\n                letter_grade_found = True\n                break\n        \n        # This fallback should ideally not be hit with the current comprehensive scale.\n        if not letter_grade_found:\n            result_grades.append('E')\n\n    return result_grades"}
{"task_id": "HumanEval/86", "solution": "import re\ndef _sort_word_chars(word: str) -> str:\n    \"\"\"Sorts characters in a word alphabetically based on ASCII values.\"\"\"\n    return \"\".join(sorted(word))\ndef anti_shuffle(s: str) -> str:\n    \"\"\"\n    Takes a string `s` and returns a modified string where characters within\n    each word are sorted alphabetically. Word order and blank spaces are preserved.\n    \"\"\"\n    if not s:\n        return s\n\n    # Split the string by spaces, capturing the spaces to preserve their order and quantity.\n    # This results in a list where words and spaces alternate.\n    parts = re.split(r'(\\s+)', s)\n    \n    result_parts = []\n    for part in parts:\n        if part.strip() == \"\":  # This part is a space string.\n            result_parts.append(part)\n        else:  # This part is a word.\n            result_parts.append(_sort_word_chars(part))\n            \n    return \"\".join(result_parts)"}
{"task_id": "HumanEval/88", "solution": "from enum import Enum\nclass InvalidInputError(Exception):\n    \"\"\"Custom exception for signaling invalid input.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\nclass SortOrder(Enum):\n    \"\"\"Defines the possible sorting directions.\"\"\"\n    ASCENDING = 1\n    DESCENDING = 2\nclass ArrayValidator:\n    \"\"\"Validates the input array for non-negative integer elements.\"\"\"\n    @staticmethod\n    def validate(array: list[int]) -> None:\n        if not isinstance(array, list):\n            raise InvalidInputError(\"Input must be a list.\")\n\n        for element in array:\n            if not isinstance(element, int) or element < 0:\n                raise InvalidInputError(\"All elements must be non-negative integers.\")\ndef sort_array(array: list[int]) -> list[int]:\n    \"\"\"\n    Given an array of non-negative integers, return a copy of the given array after sorting,\n    you will sort the given array in ascending order if the sum( first index value, last index value) is odd,\n    or sort it in descending order if the sum( first index value, last index value) is even.\n\n    Note:\n    * don't change the given array.\n\n    Examples:\n    * sort_array([]) => []\n    * sort_array([5]) => [5]\n    * sort_array([2, 4, 3, 0, 1, 5]) => [0, 1, 2, 3, 4, 5]\n    * sort_array([2, 4, 3, 0, 1, 5, 6]) => [6, 5, 4, 3, 2, 1, 0]\n    \"\"\"\n    ArrayValidator.validate(array)\n\n    if not array:\n        return []\n    if len(array) == 1:\n        return list(array)\n\n    first_element = array[0]\n    last_element = array[-1]\n    \n    if (first_element + last_element) % 2 != 0:\n        sort_order = SortOrder.ASCENDING\n    else:\n        sort_order = SortOrder.DESCENDING\n\n    copied_array = list(array)\n    if sort_order == SortOrder.ASCENDING:\n        copied_array.sort()\n    else:\n        copied_array.sort(reverse=True)\n        \n    return copied_array"}
{"task_id": "HumanEval/90", "solution": "def next_smallest(lst):\n    \"\"\"\n    Returns the second smallest distinct element of the list.\n    Returns None if there is no such element.\n    \"\"\"\n    if not lst:\n        return None\n\n    # Convert to a set to get unique elements, then sort them.\n    unique_elements = sorted(list(set(lst)))\n\n    if len(unique_elements) < 2:\n        return None\n    else:\n        return unique_elements[1]"}
