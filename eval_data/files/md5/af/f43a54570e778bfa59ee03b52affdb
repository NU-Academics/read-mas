{"task_id": "HumanEval/8", "solution": "from typing import List, Tuple\ndef sum_product(numbers: List[int]) -> Tuple[int, int]:\n    \"\"\" For a given list of integers, return a tuple consisting of a sum and a product of all the integers in a list.\n    Empty sum should be equal to 0 and empty product should be equal to 1.\n    >>> sum_product([])\n    (0, 1)\n    >>> sum_product([1, 2, 3, 4])\n    (10, 24)\n    \"\"\"\n    if not numbers:\n        return (0, 1)\n\n    current_sum = 0\n    current_product = 1\n\n    for number in numbers:\n        current_sum += number\n        current_product *= number\n\n    return (current_sum, current_product)"}
{"task_id": "HumanEval/39", "solution": "import math\nimport functools\nfrom src.exceptions import InvalidInputError\nfrom src.number_utils import NumberUtils\nfrom src.exceptions import InvalidInputError\nfrom src.prime_fib_calculator import PrimeFibCalculator\nfrom src.number_utils import NumberUtils\nclass InvalidInputError(ValueError):\n    \"\"\"Custom exception for invalid input values.\"\"\"\n    pass\nclass NumberUtils:\n    \"\"\"Provides utility functions for checking number properties.\"\"\"\n\n    @functools.lru_cache(maxsize=None)\n    def is_prime(self, num: int) -> bool:\n        \"\"\"Determines if a given integer is a prime number.\"\"\"\n        if not isinstance(num, int) or num < 2:\n            raise InvalidInputError(\"Input for is_prime must be an integer greater than or equal to 2.\")\n        for i in range(2, int(math.sqrt(num)) + 1):\n            if num % i == 0:\n                return False\n        return True\n\n    @functools.lru_cache(maxsize=None)\n    def is_fibonacci(self, num: int) -> bool:\n        \"\"\"Determines if a given integer is a Fibonacci number.\"\"\"\n        if not isinstance(num, int) or num < 0:\n            raise InvalidInputError(\"Input for is_fibonacci must be a non-negative integer.\")\n        if num == 0:\n            return True\n        # A number is Fibonacci if 5*n^2 + 4 or 5*n^2 - 4 is a perfect square.\n        return self._is_perfect_square(5 * num * num + 4) or self._is_perfect_square(5 * num * num - 4)\n\n    def _is_perfect_square(self, num: int) -> bool:\n        \"\"\"Private helper method to check if a number is a perfect square.\"\"\"\n        if num < 0:\n            return False\n        s = int(math.sqrt(num))\n        return s * s == num\nclass PrimeFibCalculator:\n    \"\"\"Manages the iterative search for the n-th prime Fibonacci number.\"\"\"\n\n    def __init__(self, number_utils: NumberUtils):\n        \"\"\"Constructor for PrimeFibCalculator.\"\"\"\n        self.number_utils = number_utils\n\n    def find_nth_prime_fib(self, n: int) -> int:\n        \"\"\"Finds the n-th number that satisfies both the Fibonacci and prime conditions.\"\"\"\n        if not isinstance(n, int) or n <= 0:\n            raise InvalidInputError(\"Input 'n' must be a positive integer.\")\n\n        count = 0\n        num = 1 # Start checking from 1. 0 is fib but not prime. 1 is fib but not prime. 2 is the first.\n        while True:\n            try:\n                if self.number_utils.is_fibonacci(num):\n                    if self.number_utils.is_prime(num):\n                        count += 1\n                        if count == n:\n                            return num\n            except InvalidInputError:\n                # This catches errors for numbers like 1 from is_prime, effectively skipping them.\n                pass\n            num += 1\ndef prime_fib(n: int) -> int:\n    \"\"\"\n    prime_fib returns n-th number that is a Fibonacci number and it's also prime.\n    >>> prime_fib(1)\n    2\n    >>> prime_fib(2)\n    3\n    >>> prime_fib(3)\n    5\n    >>> prime_fib(4)\n    13\n    >>> prime_fib(5)\n    89\n    \"\"\"\n\n    number_utils = NumberUtils()\n    calculator = PrimeFibCalculator(number_utils)\n    return calculator.find_nth_prime_fib(n)"}
