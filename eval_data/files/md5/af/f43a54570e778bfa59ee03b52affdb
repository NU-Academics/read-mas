{"task_id": "HumanEval/55", "solution": "class InvalidInputError(ValueError):\n    \"\"\"Custom exception for invalid input to Fibonacci calculation.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\ndef fib(n: int) -> int:\n    \"\"\"Return n-th Fibonacci number.\n    Raises InvalidInputError if n is negative or not an integer.\n    \"\"\"\n    if not isinstance(n, int) or n < 0:\n        raise InvalidInputError(\"Input 'n' must be a non-negative integer.\")\n\n    if n == 0:\n        return 0\n    elif n == 1:\n        return 1\n    else:\n        a, b = 0, 1\n        for _ in range(2, n + 1):\n            a, b = b, a + b\n        return b"}
{"task_id": "HumanEval/56", "solution": "def correct_bracketing(brackets: str):\n    \"\"\" brackets is a string of \"<\" and \">\".\n    return True if every opening bracket has a corresponding closing bracket.\n\n    >>> correct_bracketing(\"<\")\n    False\n    >>> correct_bracketing(\"<>\")\n    True\n    >>> correct_bracketing(\"<<><>>\")\n    True\n    >>> correct_bracketing(\"><<>\")\n    False\n    \"\"\"\n    balance_counter = 0\n    for char in brackets:\n        if char == '<':\n            balance_counter += 1\n        elif char == '>':\n            balance_counter -= 1\n        if balance_counter < 0:\n            return False\n    return balance_counter == 0"}
