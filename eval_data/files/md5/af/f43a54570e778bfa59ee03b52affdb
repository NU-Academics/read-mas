{"task_id": "HumanEval/100", "solution": "def make_a_pile(n: int) -> list[int]:\n    \"\"\"\n    Calculates the number of stones for each of n levels, starting with n stones.\n    Subsequent levels always add 2 stones to the previous count, maintaining parity.\n    \"\"\"\n    if n <= 0:\n        raise ValueError(\"n must be a positive integer.\")\n\n    pile = [n]\n    current_stones = n\n    for _ in range(1, n):\n        current_stones += 2\n        pile.append(current_stones)\n    return pile"}
{"task_id": "HumanEval/99", "solution": "import math\ndef closest_integer(value):\n    \"\"\"\n    Returns the closest integer to a string-represented number.\n    Equidistant values (X.5) are rounded away from zero (e.g., 14.5 -> 15, -14.5 -> -15).\\n    \"\"\"\n    try:\n        num = float(value)\n    except ValueError:\n        raise ValueError(f\"Invalid input: '{value}' is not a valid number string.\")\n\n    floor_num = math.floor(num)\n    ceil_num = math.ceil(num)\n\n    # Check if the number is exactly equidistant from two integers (e.g., X.5).\n    # Round away from zero if equidistant.\n    if num - floor_num == 0.5:\n        return int(ceil_num) if num >= 0 else int(floor_num)\n    elif floor_num + 0.5 < num:\n        # If fractional part is greater than 0.5, round up.\n        return int(ceil_num)\n    else:\n        # If fractional part is less than 0.5, round down.\n        return int(floor_num)"}
{"task_id": "HumanEval/100", "solution": "def make_a_pile(n: int) -> list[int]:\n    \"\"\"\n    Calculates the number of stones for `n` levels, starting with `n` stones and adding 2 for each subsequent level.\n    Raises ValueError if `n` is not a positive integer.\n    \"\"\"\n    if not isinstance(n, int) or n <= 0:\n        raise ValueError(\"Input 'n' must be a positive integer.\")\n\n    pile = []\n    current_stones = n\n    for _ in range(n):\n        pile.append(current_stones)\n        current_stones += 2\n    return pile"}
{"task_id": "HumanEval/99", "solution": "import math\ndef closest_integer(value: str) -> int:\n    '''\n    Returns the closest integer to a number string, rounding away from zero if equidistant.\n    Raises ValueError if the input string is not a valid number.\n    '''\n    number = float(value) # Converts the string to a float; raises ValueError on invalid input.\n\n    # If the number is an exact integer, return it directly.\n    if number == int(number):\n        return int(number)\n\n    floor_val = math.floor(number)\n    ceil_val = math.ceil(number)\n\n    # Calculate absolute distances to the floor and ceiling integers.\n    dist_to_floor = abs(number - floor_val)\n    dist_to_ceil = abs(number - ceil_val)\n\n    # Apply the \"round away from zero\" rule for equidistant cases (e.g., X.5).\n    if dist_to_floor == dist_to_ceil:\n        if number > 0:\n            return int(ceil_val) # Positive X.5 rounds up (e.g., 14.5 -> 15).\n        else:\n            return int(floor_val) # Negative X.5 rounds down (e.g., -14.5 -> -15).\n    elif dist_to_floor < dist_to_ceil:\n        return int(floor_val) # Round to the closer floor integer.\n    else:\n        return int(ceil_val) # Round to the closer ceiling integer."}
{"task_id": "HumanEval/96", "solution": "def is_prime(num: int) -> bool:\n    \"\"\"\n    Checks if a given number is prime.\n    Primes are natural numbers greater than 1 with only two divisors: 1 and itself.\n    \"\"\"\n    if num < 2:\n        return False\n    # Iterates from 2 up to the square root of num to find divisors.\n    for i in range(2, int(num**0.5) + 1):\n        if num % i == 0:\n            return False\n    return True\ndef count_up_to(n: int) -> list[int]:\n    \"\"\"\n    Implement a function that takes an non-negative integer and returns an array of the first n\n    integers that are prime numbers and less than n.\n    for example:\n    count_up_to(5) => [2,3]\n    count_up_to(11) => [2,3,5,7]\n    count_up_to(0) => []\n    count_up_to(20) => [2,3,5,7,11,13,17,19]\n    count_up_to(1) => []\n    count_up_to(18) => [2,3,5,7,11,13,17]\n    \"\"\"\n    # Validate input n to be a non-negative integer.\n    if not isinstance(n, int) or n < 0:\n        raise ValueError(\"Input 'n' must be a non-negative integer.\")\n\n    # Handle edge cases where no primes exist below n.\n    if n <= 2:\n        return []\n\n    primes = []\n    # Find all primes in the range [2, n-1] using the is_prime helper.\n    for num in range(2, n):\n        if is_prime(num):\n            primes.append(num)\n            \n    return primes"}
{"task_id": "HumanEval/102", "solution": "def choose_num(x, y):\n    \"\"\"Finds the biggest even integer in the inclusive range [x, y]. Returns -1 if no such number exists.\"\"\"\n    if x > y:\n        return -1\n\n    for num in range(y, x - 1, -1):\n        if num % 2 == 0:\n            return num\n\n    return -1"}
