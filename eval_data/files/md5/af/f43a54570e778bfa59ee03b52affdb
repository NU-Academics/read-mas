{"task_id": "HumanEval/153", "solution": "def Strongest_Extension(class_name, extensions):\n    \"\"\"Identifies the strongest extension based on uppercase minus lowercase letter count.\n    If strengths are equal, the first occurring extension is chosen, and the result is formatted as 'ClassName.StrongestExtensionName'.\n    \"\"\"\n    if not extensions:\n        return class_name\n\n    strongest_extension_name = \"\"\n    max_strength = float('-inf')\n\n    for extension in extensions:\n        uppercase_count = 0\n        lowercase_count = 0\n        for char in extension:\n            if char.isupper():\n                uppercase_count += 1\n            elif char.islower():\n                lowercase_count += 1\n        current_strength = uppercase_count - lowercase_count\n\n        if current_strength > max_strength:\n            max_strength = current_strength\n            strongest_extension_name = extension\n    \n    return f\"{class_name}.{strongest_extension_name}\""}
{"task_id": "HumanEval/154", "solution": "def cycpattern_check(a, b):\n    \"\"\"Checks if b or any of its cyclic rotations is a substring in a.\n    Returns True if a match is found, False otherwise.\"\"\"\n    # Handle edge cases: empty 'b' is always a substring; non-empty 'b' cannot be in empty 'a'.\n    if not b:\n        return True\n    if not a:\n        return False\n\n    # Generate all unique cyclic rotations of string 'b'.\n    rotations_of_b = set()\n    n = len(b)\n    for i in range(n):\n        rotated_b = b[i:] + b[:i]\n        rotations_of_b.add(rotated_b)\n\n    # Check if any generated rotation is a substring of 'a'.\n    for rotation in rotations_of_b:\n        if rotation in a:\n            return True\n            \n    return False"}
{"task_id": "HumanEval/155", "solution": "def even_odd_count(num):\n    \"\"\"Given an integer. return a tuple that has the number of even and odd digits respectively.\n\n     Example:\n        even_odd_count(-12) ==> (1, 1)\n        even_odd_count(123) ==> (1, 2)\n    \"\"\"\n    if not isinstance(num, int):\n        raise TypeError(\"Input must be an integer.\")\n\n    s_num = str(abs(num))\n    even_count = 0\n    odd_count = 0\n\n    for digit_char in s_num:\n        digit = int(digit_char)\n        if digit % 2 == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n    return (even_count, odd_count)"}
{"task_id": "HumanEval/157", "solution": "import math\ndef right_angle_triangle(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle. Return True if the three\n    sides form a right-angled triangle, False otherwise.\n    '''\n    # Validate that inputs are numerical values (FR1).\n    if not all(isinstance(side, (int, float)) for side in [a, b, c]):\n        raise TypeError(\"Side lengths must be numerical values.\")\n\n    # Validate that all side lengths are positive (FR2).\n    if not all(side > 0 for side in [a, b, c]):\n        raise ValueError(\"Side lengths must be positive.\")\n\n    # Validate the triangle inequality theorem (FR3).\n    if not (a + b > c and a + c > b and b + c > a):\n        raise ValueError(\"The given side lengths do not form a valid triangle.\")\n\n    # Determine if the triangle is right-angled using the Pythagorean theorem (FR4, NFR1).\n    EPSILON = 1e-9 # Small constant for floating-point comparisons.\n    sides = sorted([a, b, c])\n    s1, s2, s3 = sides[0], sides[1], sides[2]\n\n    # Check if the square of the longest side equals the sum of the squares of the other two sides.\n    return math.isclose(s1**2 + s2**2, s3**2, rel_tol=EPSILON)"}
{"task_id": "HumanEval/148", "solution": "PLANETS_ORDER = [\n    \"Mercury\", \"Venus\", \"Earth\", \"Mars\",\n    \"Jupiter\", \"Saturn\", \"Uranus\", \"Neptune\"\n]\nPLANET_MAP = {\n    name.lower(): i for i, name in enumerate(PLANETS_ORDER)\n}\nclass PlanetService:\n    def __init__(self):\n        self._planets_order = PLANETS_ORDER\n        self._planet_map = PLANET_MAP\n\n    def find_planets_between(self, planet1_name: str, planet2_name: str) -> tuple[str, ...]:\n        p1_lower = planet1_name.lower()\n        p2_lower = planet2_name.lower()\n\n        if p1_lower not in self._planet_map or p2_lower not in self._planet_map:\n            return ()\n\n        idx1 = self._planet_map[p1_lower]\n        idx2 = self._planet_map[p2_lower]\n\n        start_idx = min(idx1, idx2)\n        end_idx = max(idx1, idx2)\n\n        # Exclude the start and end planets themselves.\n        intermediate_planets = self._planets_order[start_idx + 1:end_idx]\n\n        return tuple(intermediate_planets)\n_planet_service = PlanetService()\ndef bf(planet1, planet2):\n    '''\n    There are eight planets in our solar system: the closerst to the Sun \n    is Mercury, the next one is Venus, then Earth, Mars, Jupiter, Saturn, \n    Uranus, Neptune.\n    Write a function that takes two planet names as strings planet1 and planet2. \n    The function should return a tuple containing all planets whose orbits are \n    located between the orbit of planet1 and the orbit of planet2, sorted by \n    the proximity to the sun. \n    The function should return an empty tuple if planet1 or planet2\n    are not correct planet names. \n    Examples\n    bf(\"Jupiter\", \"Neptune\") ==> (\"Saturn\", \"Uranus\")\n    bf(\"Earth\", \"Mercury\") ==> (\"Venus\")\n    bf(\"Mercury\", \"Uranus\") ==> (\"Venus\", \"Earth\", \"Mars\", \"Jupiter\", \"Saturn\")\n    '''\n    return _planet_service.find_planets_between(planet1, planet2)"}
{"task_id": "HumanEval/158", "solution": "def find_max(words):\n    \"\"\"\n    Finds the word with the maximum number of unique characters from a list of strings.\n    If multiple words share the maximum unique character count, the lexicographically first one is returned.\n    \"\"\"\n    if not words:\n        return \"\"\n\n    max_unique_count = -1\n    best_word = \"\"\n\n    for word in words:\n        current_unique_count = len(set(word))\n\n        if current_unique_count > max_unique_count:\n            max_unique_count = current_unique_count\n            best_word = word\n        elif current_unique_count == max_unique_count:\n            # Tie-breaker: lexicographical order\n            if word < best_word:\n                best_word = word\n        \n    return best_word"}
