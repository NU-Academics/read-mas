": [[[[0, 0, 0], [0, 0, 0], [0, 0, -1]]]]}, {"task_id": "Mbpp/721", "solution": "from typing import List, Tuple\nclass Matrix:\n    \"\"\"Represents the input cost matrix and provides access to cell costs and dimensions.\"\"\"\n    def __init__(self, data: List[List[int]]):\n        self._data = data\n        self._size = len(data)\n\n    def get_cell_cost(self, row: int, col: int) -> int:\n        \"\"\"Returns the cost of the cell at (row, col), assuming valid coordinates.\"\"\"\n        return self._data[row][col]\n\n    def get_size(self) -> int:\n        \"\"\"Returns the size (N) of the square matrix.\"\"\"\n        return self._size\nclass Path:\n    \"\"\"Represents a single path, tracking visited cells, total cost, and cell count.\"\"\"\n    def __init__(self, initial_cell: Tuple[int, int], initial_cost: int):\n        self._cells: List[Tuple[int, int]] = [initial_cell]\n        self._total_cost: int = initial_cost\n        self._num_cells: int = 1\n\n    def clone(self) -> 'Path':\n        \"\"\"Creates a deep copy of the current Path object's state.\"\"\"\n        cloned_path = Path((0,0), 0) # Use dummy values, will be overwritten\n        cloned_path._cells = list(self._cells) # Deep copy the list of tuples\n        cloned_path._total_cost = self._total_cost\n        cloned_path._num_cells = self._num_cells\n        return cloned_path\n\n    def add_cell(self, row: int, col: int, cost: int) -> None:\n        \"\"\"Adds a new cell to the path, updating total cost and cell count.\"\"\"\n        self._cells.append((row, col))\n        self._total_cost += cost\n        self._num_cells += 1\n\n    def get_average(self) -> float:\n        \"\"\"Calculates and returns the average cost of the path.\"\"\"\n        return self._total_cost / self._num_cells\nclass MatrixPathFinder:\n    \"\"\"Orchestrates finding the maximum average path in a matrix.\"\"\"\n    def __init__(self):\n        self._matrix: Matrix = None\n        self._max_average: float = float('-inf')\n\n    def find_max_average_path(self, matrix_data: List[List[int]]) -> float:\n        \"\"\"Public interface to find the maximum average path.\"\"\"\n        # Assumes matrix_data is a valid square matrix of integers as per critical requirements.\n        self._matrix = Matrix(matrix_data)\n        size = self._matrix.get_size()\n\n        initial_cost = self._matrix.get_cell_cost(0, 0)\n        initial_path = Path((0, 0), initial_cost)\n\n        # Initialize max_average with the average of the starting cell.\n        self._max_average = initial_path.get_average()\n\n        self._find_paths_recursive(0, 0, initial_path)\n\n        return self._max_average\n\n    def _find_paths_recursive(self, row: int, col: int, current_path: Path) -> None:\n        \"\"\"Recursive helper to explore paths and update the maximum average.\"\"\"\n        size = self._matrix.get_size()\n\n        # If the bottom-right cell is reached, update max_average if current path is higher.\n        if row == size - 1 and col == size - 1:\n            current_average = current_path.get_average()\n            if current_average > self._max_average:\n                self._max_average = current_average\n            return\n\n        # Explore moving right\n        if col + 1 < size:\n            next_col = col + 1\n            cost = self._matrix.get_cell_cost(row, next_col)\n            new_path_right = current_path.clone()\n            new_path_right.add_cell(row, next_col, cost)\n            self._find_paths_recursive(row, next_col, new_path_right)\n\n        # Explore moving down\n        if row + 1 < size:\n            next_row = row + 1\n            cost = self._matrix.get_cell_cost(next_row, col)\n            new_path_down = current_path.clone()\n            new_path_down.add_cell(next_row, col, cost)\n            self._find_paths_recursive(next_row, col, new_path_down)\ndef maxAverageOfPath(matrix: List[List[int]]) -> float:\n    \"\"\"Calculates the maximum average cost of a path from top-left to bottom-right.\"\"\"\n    finder = MatrixPathFinder()\n    return finder.find_max_average_path(matrix)", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[[[0, 0, 0], [0, 0, 0], [0, 0, -1]]]]}], "Mbpp/723": [{"task_id": "Mbpp/723", "solution": "def count_same_pair(list1: list, list2: list) -> int:\n    \"\"\"\n    Counts the number of indices where elements in two lists are identical.\n    It is assumed that the input lists are of the same length.\n    \"\"\"\n    count = 0\n    for i in range(len(list1)):\n        if list1[i] == list2[i]:\n            count += 1\n    return count", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "Mbpp/723", "solution": "def count_same_pair(list1: list, list2: list) -> int:\n    \"\"\"\n    Counts matching elements at corresponding indices in two lists.\n    Assumes lists are of the same length.\n    \"\"\"\n    count = 0\n    for i in range(len(list1)):\n        if list1[i] == list2[i]:\n            count += 1\n    return count", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/725": [{"task_id": "Mbpp/725", "solution": "import re\ndef extract_quotation(text: str) -> list[str]:\n    \"\"\"\n    Extracts all substrings enclosed in double quotation marks from the input text.\n    It finds non-greedy matches, returning an empty list if no quoted segments are found.\n    \"\"\"\n    return re.findall(r'\"([^\"]*)\"', text)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "Mbpp/725", "solution": "import re\ndef extract_quotation(text: str) -> list[str]:\n    \"\"\"\n    Extracts all substrings enclosed in double quotation marks from the input text.\n\n    Args:\n        text: The input string to parse.\n\n    Returns:\n        A list of strings found between double quotation marks.\n        Returns an empty list if no mat