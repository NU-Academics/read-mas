 3:\n        h = 3 * h + 1\n    while h >= 1:\n        gaps.append(h)\n        h //= 3\n\n    for gap in gaps:\n        # Perform a gapped insertion sort for the current gap.\n        for i in range(gap, n):\n            temp = arr[i]\n            j = i\n            while j >= gap and arr[j - gap] > temp:\n                arr[j] = arr[j - gap]\n                j -= gap\n            arr[j] = temp\n    return arr", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "Mbpp/428", "solution": "def shell_sort(array):\n    \"\"\"\n    Sorts a list of comparable elements in-place using the Shell Sort algorithm.\n    The function returns the sorted array.\n    \"\"\"\n    n = len(array)\n\n    if n <= 1:\n        return array\n\n    # Determine the initial gap sequence using Knuth's formula (h = h * 3 + 1).\n    h = 1\n    while h < n // 3:\n        h = h * 3 + 1\n\n    # Start sorting with the largest gap and decrease it.\n    while h >= 1:\n        # Perform an h-sort (insertion sort with a gap h) for the current gap.\n        for i in range(h, n):\n            temp = array[i]\n            j = i\n            # Shift earlier h-sorted elements up until the correct position for temp is found.\n            while j >= h and array[j - h] > temp:\n                array[j] = array[j - h]\n                j -= h\n            # Put temp in its correct location.\n            array[j] = temp\n        h //= 3  # Reduce the gap for the next pass.\n\n    return array", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/432": [{"task_id": "Mbpp/432", "solution": "def median_trapezium(side1, side2, side3):\n    \"\"\"\n    Calculates the median length of a trapezium given its two parallel sides.\n    This is defined as the arithmetic mean of the lengths of the parallel sides.\n    \"\"\"\n    return (side1 + side2) / 2", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], 