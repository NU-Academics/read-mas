{"task_id": "HumanEval/31", "solution": "class Number:\n    def __init__(self, value):\n        self.value = value\n\n    def is_integer(self) -> bool:\n        \"\"\"Checks if the stored value is an integer.\"\"\"\n        return isinstance(self.value, int)\n\nclass PrimeCheckResult:\n    def __init__(self, is_prime: bool):\n        self.is_prime = is_prime\n\nclass PrimeService:\n    def validate_input(self, n) -> bool:\n        \"\"\"Validates if the input is an integer.\"\"\"\n        num_obj = Number(n)\n        return num_obj.is_integer()\n\n    def check_divisors(self, n: int) -> bool:\n        \"\"\"Performs the primality test by checking for divisors.\"\"\"\n        if n <= 1: # Handled by is_prime for n=1, but defensive here.\n            return False\n        \n        i = 2\n        while i * i <= n:\n            if n % i == 0:\n                return False\n            i += 1\n        return True\n\n    def is_prime(self, n: int) -> bool:\n        \"\"\"Orchestrates validation and primality computation.\"\"\"\n        # Per design, validate_input is called. For this problem, we assume `n` is int\n        # as per docstring examples and signature.\n        self.validate_input(n) \n\n        # Special-case handling for n <= 1 (per design UC-5)\n        if n <= 1:\n            return False\n\n        # Compute primality using the divisor check method\n        is_prime_result = self.check_divisors(n)\n        \n        # Optionally, wrap in PrimeCheckResult, then extract boolean\n        result_obj = PrimeCheckResult(is_prime_result)\n        return result_obj.is_prime\n\n\ndef is_prime(n):\n    \"\"\"Return true if a given number is prime, and false otherwise.\"\"\"\n    # The public API delegates to an instance of PrimeService as per design.\n    service = PrimeService()\n    return service.is_prime(n)"}
{"task_id": "HumanEval/34", "solution": "def unique(l: list):\n    \"\"\"Return sorted unique elements in a list\n    >>> unique([5, 3, 5, 2, 3, 3, 9, 0, 123])\n    [0, 2, 3, 5, 9, 123]\n    \"\"\"\n    # Deduplicate elements by converting the list to a set, then back to a list.\n    unique_elements = list(set(l))\n\n    # Sort the unique elements in ascending order and return the new list.\n    return sorted(unique_elements)"}
{"task_id": "HumanEval/33", "solution": "def sort_third(l: list):\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the indicies that are not divisible by three, while its values at the indicies that are divisible by three are equal\n    to the values of the corresponding indicies of l, but sorted.\n    >>> sort_third([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_third([5, 6, 3, 4, 8, 9, 2])\n    [2, 6, 3, 4, 8, 9, 5]\n    \"\"\"\n    if not isinstance(l, list):\n        raise TypeError(\"input must be a list\")\n\n    # Create a shallow copy of the input list to avoid modifying the original.\n    working_copy = l.copy()\n\n    # Extract values from indices divisible by three.\n    extracted_values = []\n    for i in range(len(l)):\n        if i % 3 == 0:\n            extracted_values.append(l[i])\n\n    # Sort the extracted values.\n    try:\n        sorted_values = sorted(extracted_values)\n    except TypeError:\n        # Propagate TypeError if values are not comparable.\n        raise\n\n    # Reinsert the sorted values back into the working copy at their original indices.\n    sorted_idx_iter = iter(sorted_values)\n    for i in range(len(working_copy)):\n        if i % 3 == 0:\n            working_copy[i] = next(sorted_idx_iter)\n\n    return working_copy"}
{"task_id": "HumanEval/32", "solution": "from typing import List\nimport math\n\n\nclass Validator:\n    \"\"\"\n    Validates types and numeric-ness for inputs.\n    \"\"\"\n    def assert_numeric_list(self, xs: list) -> None:\n        if not isinstance(xs, list):\n            raise TypeError(\"Coefficients (xs) must be a list.\")\n        for i, val in enumerate(xs):\n            if not isinstance(val, (int, float)):\n                raise TypeError(f\"Coefficient at index {i} must be a numeric type (int or float), got {type(val).__name__}.\")\n\n    def assert_numeric(self, x) -> None:\n        if not isinstance(x, (int, float)):\n            raise TypeError(f\"Input x must be a numeric type (int or float), got {type(x).__name__}.\")\n\n\nclass Polynomial:\n    \"\"\"\n    Represents a polynomial with coefficients xs.\n    Provides evaluation and validation methods.\n    \"\"\"\n    def __init__(self, coefficients: List[float]) -> None:\n        # Ensure coefficients are floats for consistent numeric operations\n        self.coefficients = [float(c) for c in coefficients]\n        self.degree = len(self.coefficients) - 1\n        # Leading coefficient is the last element for degree-0 upward ordering\n        self.leading_coefficient = self.coefficients[-1] if self.coefficients else 0.0\n\n    def evaluate(self, x: float) -> float:\n        \"\"\"\n        Computes polynomial value sum_{i=0..n} coefficients[i] * x**i.\n        \"\"\"\n        result = 0.0\n        for i, coeff in enumerate(self.coefficients):\n            result += coeff * math.pow(x, i)\n        return result\n\n    def validate_even_length(self) -> None:\n        \"\"\"\n        Raise ValueError if len(coefficients) % 2 != 0.\n        \"\"\"\n        if len(self.coefficients) % 2 != 0:\n            raise ValueError(\"Polynomial coefficients list (xs) must have an even number of coefficients.\")\n\n    def validate_leading_nonzero(self) -> None:\n        \"\"\"\n        Raise ValueError if leading_coefficient == 0.\n        \"\"\"\n        if not self.coefficients:\n            raise ValueError(\"Polynomial coefficients list (xs) cannot be empty.\")\n        if self.leading_coefficient == 0:\n            # If all coefficients are zero, it's a zero polynomial, which has infinite roots\n            if all(c == 0 for c in self.coefficients):\n                 raise ValueError(\"Polynomial cannot be identically zero when finding a root.\")\n            else:\n                 raise ValueError(\"The highest-degree coefficient (leading coefficient) must be non-zero.\")\n\n\nclass RootFinder:\n    \"\"\"\n    Finds a single numeric root for a given Polynomial instance.\n    \"\"\"\n    def __init__(self, tolerance: float = 1e-9) -> None:\n        self.tolerance = tolerance\n\n    def find_zero(self, p: Polynomial) -> float:\n        \"\"\"\n        Return a single numeric root r such that abs(p.evaluate(r)) <= tolerance.\n        Uses a bisection method after finding an initial bracketing interval.\n        \"\"\"\n        # Check if 0 is a root or very close to it\n        if abs(p.evaluate(0.0)) <= self.tolerance:\n            return 0.0\n\n        # Find an initial bracketing interval [a, b] where p(a) and p(b) have opposite signs\n        a = -1.0\n        b = 1.0\n        max_search_iterations = 100 # Max expansions for bracketing\n        factor = 2.0\n        \n        val_a = p.evaluate(a)\n        val_b = p.evaluate(b)\n\n        # Expand interval until a sign change is found or a root is very close to a boundary\n        for _ in range(max_search_iterations):\n            if abs(val_a) <= self.tolerance:\n                return a\n            if abs(val_b) <= self.tolerance:\n                return b\n            \n            if val_a * val_b < 0:\n                break # Found a bracket\n            \n            # Expand the interval\n            a *= factor\n            b *= factor\n            val_a = p.evaluate(a)\n            val_b = p.evaluate(b)\n            \n            # Safety break for extremely large search range to prevent numerical issues\n            if abs(a) > 1e15 or abs(b) > 1e15:\n                raise ValueError(\"Could not find a suitable bracketing interval for the root within reasonable bounds.\")\n\n        # If after expansion, no bracket was found (should not happen if a solution is guaranteed)\n        if val_a * val_b >= 0:\n            raise ValueError(\"Failed to find an initial bracketing interval for the root.\")\n\n        # Bisection method\n        while (b - a) > self.tolerance:\n            c = (a + b) / 2\n            val_c = p.evaluate(c)\n\n            if abs(val_c) <= self.tolerance:\n                return c\n\n            if val_c * val_a < 0: # Root is in [a, c]\n                b = c\n                val_b = val_c # Update val_b for the new interval\n            else: # Root is in [c, b]\n                a = c\n                val_a = val_c # Update val_a for the new interval\n        \n        return (a + b) / 2\n\n\n# Global validator instance used by module-level functions\n_validator = Validator()\n\n\ndef poly(xs: list, x: float) -> float:\n    \"\"\"\n    Evaluates polynomial with coefficients xs at point x.\n    return xs[0] + xs[1] * x + xs[2] * x^2 + .... xs[n] * x^n\n    \"\"\"\n    _validator.assert_numeric_list(xs)\n    _validator.assert_numeric(x)\n    p = Polynomial(xs)\n    return p.evaluate(x)\n\n\ndef find_zero(xs: list) -> float:\n    \"\"\" xs are coefficients of a polynomial.\n    find_zero find x such that poly(x) = 0.\n    find_zero returns only only zero point, even if there are many.\n    Moreover, find_zero only takes list xs having even number of coefficients\n    and largest non zero coefficient as it guarantees\n    a solution.\n    >>> round(find_zero([1, 2]), 2) # f(x) = 1 + 2x\n    -0.5\n    >>> round(find_zero([-6, 11, -6, 1]), 2) # (x - 1) * (x - 2) * (x - 3) = -6 + 11x - 6x^2 + x^3\n    1.0\n    \"\"\"\n    _validator.assert_numeric_list(xs)\n    p = Polynomial(xs)\n    p.validate_even_length()\n    p.validate_leading_nonzero()\n    \n    root_finder = RootFinder(tolerance=1e-9)\n    return root_finder.find_zero(p)"}
{"task_id": "HumanEval/35", "solution": "def max_element(l: list):\n    \"\"\"Return maximum element in the list.\n    >>> max_element([1, 2, 3])\n    3\n    >>> max_element([5, 3, -5, 2, -3, 3, 9, 0, 123, 1, -10])\n    123\n    \"\"\"\n    if not l:\n        raise ValueError(\"max_element() arg is an empty list\")\n    return max(l)"}
{"task_id": "HumanEval/38", "solution": "def decode_cyclic(s: str):\n    \"\"\"\n    takes as input string encoded with encode_cyclic function. Returns decoded string.\n    \"\"\"\n    # split string to groups. Each of length 3.\n    groups = [s[(3 * i):min((3 * i + 3), len(s))] for i in range((len(s) + 2) // 3)]\n    # reverse cycle elements in each group. Unless group has fewer elements than 3.\n    # For a group 'yzx' that resulted from 'xyz' (xyz -> yzx), to reverse 'yzx' back to 'xyz',\n    # we take the last char 'x' and put it at the beginning of 'yz'.\n    # So, 'yzx' becomes group[2] + group[0:2]\n    groups = [(group[2] + group[0:2]) if len(group) == 3 else group for group in groups]\n    return \"\".join(groups)"}
{"task_id": "HumanEval/36", "solution": "class IntegerValue:\n    \"\"\"A simple container for an integer value.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\nclass DivisibilityRule:\n    \"\"\"Encapsulates the divisibility rule for 11 or 13.\"\"\"\n    def is_divisible_by_11_or_13(self, v: int) -> bool:\n        \"\"\"Returns True if v is divisible by 11 or 13.\"\"\"\n        return v % 11 == 0 or v % 13 == 0\n\nclass NumberSelector:\n    \"\"\"Selects integers less than n that satisfy divisibility rules.\"\"\"\n    def __init__(self, rule: DivisibilityRule):\n        self._rule = rule\n\n    def select(self, n: int) -> list[IntegerValue]:\n        \"\"\"Selects integers x where 0 <= x < n that are divisible by 11 or 13.\"\"\"\n        selected_numbers = []\n        for x in range(n):\n            if self._rule.is_divisible_by_11_or_13(x):\n                selected_numbers.append(IntegerValue(x))\n        return selected_numbers\n\nclass DigitCounter:\n    \"\"\"Counts occurrences of digit '7' in an integer's decimal representation.\"\"\"\n    def count_sevens(self, v: int) -> int:\n        \"\"\"Counts the number of times the digit '7' appears in the decimal representation of v.\"\"\"\n        return str(v).count('7')\n\nclass Aggregator:\n    \"\"\"Aggregates a list of integer counts into a single total.\"\"\"\n    def sum(self, counts: list[int]) -> int:\n        \"\"\"Returns the sum of all counts in the provided list.\"\"\"\n        return sum(counts)\n\ndef fizz_buzz(n: int):\n    \"\"\"Return the number of times the digit 7 appears in integers less than n which are divisible by 11 or 13.\n    >>> fizz_buzz(50)\n    0\n    >>> fizz_buzz(78)\n    2\n    >>> fizz_buzz(79)\n    3\n    \"\"\"\n    rule = DivisibilityRule()\n    selector = NumberSelector(rule)\n    counter = DigitCounter()\n    aggregator = Aggregator()\n\n    selected_values = selector.select(n)\n\n    sevens_counts = []\n    for iv in selected_values:\n        sevens_counts.append(counter.count_sevens(iv.value))\n\n    total_sevens = aggregator.sum(sevens_counts)\n    return total_sevens"}
{"task_id": "HumanEval/37", "solution": "from typing import List, Any\n\nclass InputList:\n    def __init__(self, elements: List[Any]):\n        self.elements = elements\n\nclass OutputList:\n    def __init__(self, elements: List[Any]):\n        self.elements = elements\n\nclass Element:\n    def __init__(self, index: int, value: Any):\n        self.index = index\n        self.value = value\n\nclass IndexSelector:\n    def select_even_indices(self, input_list: InputList) -> list:\n        even_values = []\n        for i in range(len(input_list.elements)):\n            if i % 2 == 0:\n                even_values.append(input_list.elements[i])\n        return even_values\n\n    def select_odd_indices(self, input_list: InputList) -> list:\n        odd_index_value_pairs = []\n        for i in range(len(input_list.elements)):\n            if i % 2 == 1:\n                odd_index_value_pairs.append((i, input_list.elements[i]))\n        return odd_index_value_pairs\n\nclass Sorter:\n    def sort_ascending(self, values: List[Any]) -> List[Any]:\n        return sorted(values)\n\nclass Transformer:\n    def __init__(self, index_selector: IndexSelector = None, sorter: Sorter = None):\n        self.index_selector = index_selector if index_selector is not None else IndexSelector()\n        self.sorter = sorter if sorter is not None else Sorter()\n\n    def transform(self, input_list: InputList) -> OutputList:\n        n = len(input_list.elements)\n        output_elements: List[Any] = [None] * n\n\n        odd_index_value_pairs = self.index_selector.select_odd_indices(input_list)\n        for index, value in odd_index_value_pairs:\n            output_elements[index] = value\n\n        even_values = self.index_selector.select_even_indices(input_list)\n        sorted_even_values = self.sorter.sort_ascending(even_values)\n\n        sorted_even_idx = 0\n        for i in range(n):\n            if i % 2 == 0:\n                output_elements[i] = sorted_even_values[sorted_even_idx]\n                sorted_even_idx += 1\n\n        return OutputList(output_elements)\n\n\ndef sort_even(l: list):\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the odd indicies, while its values at the even indicies are equal\n    to the values of the even indicies of l, but sorted.\n    >>> sort_even([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_even([5, 6, 3, 4])\n    [3, 6, 5, 4]\n    \"\"\"\n    input_list = InputList(l)\n    transformer = Transformer()\n    output_list = transformer.transform(input_list)\n    return output_list.elements"}
{"task_id": "HumanEval/39", "solution": "import math\nfrom typing import List\n\nclass InputValidator:\n    \"\"\"Validates input n is an integer and n >= 1.\"\"\"\n    def validate(self, n: int) -> bool:\n        \"\"\"Returns True if n is an integer and n >= 1; otherwise False.\"\"\"\n        return isinstance(n, int) and n >= 1\n\nclass FibonacciGenerator:\n    \"\"\"Generates Fibonacci numbers in ascending order (1,1,2,3,5,...).\"\"\"\n    def __init__(self):\n        self._a: int = 0\n        self._b: int = 1\n        self._index: int = 0\n\n    def next(self) -> int:\n        \"\"\"Advances and returns the next Fibonacci number in the sequence.\"\"\"\n        fib_value = self._b\n        self._a, self._b = self._b, self._a + self._b\n        self._index += 1\n        return fib_value\n\nclass PrimalityTester:\n    \"\"\"Provides exact primality checking for integer inputs.\"\"\"\n    def is_prime(self, x: int) -> bool:\n        \"\"\"Returns True if x is a prime number; otherwise False.\"\"\"\n        if x <= 1:\n            return False\n        if x <= 3:\n            return True\n        if x % 2 == 0 or x % 3 == 0:\n            return False\n        i = 5\n        while i * i <= x:\n            if x % i == 0 or x % (i + 2) == 0:\n                return False\n            i += 6\n        return True\n\nclass PrimeFibonacciSequence:\n    \"\"\"Accumulates Fibonacci numbers that are prime and provides retrieval.\"\"\"\n    def __init__(self):\n        self.values: List[int] = []\n\n    def add(self, value: int) -> None:\n        \"\"\"Appends a Fibonacci prime value to the sequence.\"\"\"\n        self.values.append(value)\n\n    def get(self, index: int) -> int:\n        \"\"\"Returns the value at the 1-based index; raises IndexError if out of range.\"\"\"\n        if not (1 <= index <= len(self.values)):\n            raise IndexError(\"Prime Fibonacci sequence index out of range.\")\n        return self.values[index - 1]\n\nclass PrimeFibService:\n    \"\"\"Orchestrates finding the n-th Fibonacci number that is also prime.\"\"\"\n    def __init__(self):\n        self._validator: InputValidator = InputValidator()\n        self._generator: FibonacciGenerator = FibonacciGenerator()\n        self._tester: PrimalityTester = PrimalityTester()\n        self._sequence: PrimeFibonacciSequence = PrimeFibonacciSequence()\n\n    def prime_fib(self, n: int) -> int:\n        \"\"\"Returns the n-th Fibonacci prime or raises ValueError/RuntimeError.\"\"\"\n        if not self._validator.validate(n):\n            raise ValueError(\"n must be integer >= 1\")\n\n        while len(self._sequence.values) < n:\n            fib_value = self._generator.next()\n            if self._tester.is_prime(fib_value):\n                self._sequence.add(fib_value)\n        \n        return self._sequence.get(n)\n\ndef prime_fib(n: int):\n    \"\"\"\n    prime_fib returns n-th number that is a Fibonacci number and it's also prime.\n    >>> prime_fib(1)\n    2\n    >>> prime_fib(2)\n    3\n    >>> prime_fib(3)\n    5\n    >>> prime_fib(4)\n    13\n    >>> prime_fib(5)\n    89\n    \"\"\"\n    return PrimeFibService().prime_fib(n)"}
{"task_id": "HumanEval/40", "solution": "def triples_sum_to_zero(l: list):\n    \"\"\"\n    triples_sum_to_zero takes a list of integers as an input.\n    it returns True if there are three distinct elements in the list that\n    sum to zero, and False otherwise.\n    \"\"\"\n\n    def validate(l_input: list) -> bool:\n        \"\"\"Helper to check for minimum length. Assumes input is a list of integers.\"\"\"\n        return len(l_input) >= 3\n\n    def computeTriples(l_input: list) -> bool:\n        \"\"\"Helper to search for three distinct elements summing to zero.\"\"\"\n        n = len(l_input)\n        for i in range(n - 2):\n            for j in range(i + 1, n - 1):\n                for k in range(j + 1, n):\n                    if l_input[i] + l_input[j] + l_input[k] == 0:\n                        return True\n        return False\n\n    if not validate(l):\n        return False\n    \n    return computeTriples(l)"}
{"task_id": "HumanEval/43", "solution": "class Element:\n    \"\"\"Immutable container for a single integer value and its index.\"\"\"\n    def __init__(self, value: int, index: int) -> None:\n        self._value = value\n        self._index = index\n\n    @property\n    def value(self) -> int:\n        return self._value\n\n    @property\n    def index(self) -> int:\n        return self._index\n\nclass InputList:\n    \"\"\"Wrap a Python list of integers as domain InputList exposing element iteration and length.\"\"\"\n    def __init__(self, raw_list: list) -> None:\n        self._elements = [Element(value, i) for i, value in enumerate(raw_list)]\n\n    def length(self) -> int:\n        return len(self._elements)\n\n    def elements(self) -> list[Element]:\n        return self._elements\n\nclass PairsSumToZeroFunction:\n    \"\"\"Implements validation and evaluation algorithm.\"\"\"\n    def evaluate(self, input_list: InputList) -> bool:\n        if input_list.length() < 2:\n            return False\n\n        elements = input_list.elements()\n        n = input_list.length()\n\n        for i in range(n):\n            for j in range(i + 1, n):\n                if elements[i].value + elements[j].value == 0:\n                    return True\n        return False\n\ndef pairs_sum_to_zero(l):\n    \"\"\"\n    pairs_sum_to_zero takes a list of integers as an input.\n    it returns True if there are two distinct elements in the list that\n    sum to zero, and False otherwise.\n    >>> pairs_sum_to_zero([1, 3, 5, 0])\n    False\n    >>> pairs_sum_to_zero([1, 3, -2, 1])\n    False\n    >>> pairs_sum_to_zero([1, 2, 3, 7])\n    False\n    >>> pairs_sum_to_zero([2, 4, -5, 3, 5, 7])\n    True\n    >>> pairs_sum_to_zero([1])\n    False\n    \"\"\"\n    input_list = InputList(l)\n    evaluator = PairsSumToZeroFunction()\n    return evaluator.evaluate(input_list)"}
{"task_id": "HumanEval/41", "solution": "class ValidationError(Exception):\n    \"\"\"Exception raised for invalid input to car_race_collision.\"\"\"\n    def __init__(self, message: str, detail: str = None):\n        super().__init__(message)\n        self.message = message\n        self.detail = detail\n\nclass InputValidator:\n    \"\"\"Validates the input 'n' for the car race collision calculation.\"\"\"\n    def validate(self, n) -> None:\n        \"\"\"Checks if n is an integer and non-negative, raising ValidationError if not.\"\"\"\n        if not isinstance(n, int):\n            raise ValidationError(\"n must be an integer\", f\"Received type {type(n).__name__}\")\n        if n < 0:\n            raise ValidationError(\"n must be non-negative\", f\"Received value {n}\")\n\nclass CollisionCalculator:\n    \"\"\"Calculates the number of collisions based on 'n' cars.\"\"\"\n    def compute(self, n: int) -> int:\n        \"\"\"Computes n * n for the given number of cars 'n'.\"\"\"\n        return n * n\n\ndef car_race_collision(n: int):\n    \"\"\"\n    Imagine a road that's a perfectly straight infinitely long line.\n    n cars are driving left to right;  simultaneously, a different set of n cars\n    are driving right to left.   The two sets of cars start out being very far from\n    each other.  All cars move in the same speed.  Two cars are said to collide\n    when a car that's moving left to right hits a car that's moving right to left.\n    However, the cars are infinitely sturdy and strong; as a result, they continue moving\n    in their trajectory as if they did not collide.\n\n    This function outputs the number of such collisions.\n    \"\"\"\n    validator = InputValidator()\n    validator.validate(n)\n    \n    calculator = CollisionCalculator()\n    return calculator.compute(n)"}
{"task_id": "HumanEval/44", "solution": "from dataclasses import dataclass\n\n@dataclass\nclass Input:\n    \"\"\"Encapsulates input values x and base.\"\"\"\n    x: int\n    base: int\n\n@dataclass\nclass ValidationResult:\n    \"\"\"Represents validation outcome.\"\"\"\n    is_valid: bool\n    message: str = \"\"\n\n@dataclass\nclass ConversionResult:\n    \"\"\"Holds converted string result.\"\"\"\n    value: str\n\nclass Validator:\n    \"\"\"Validates input (integer checks and base < 10).\"\"\"\n    def validateInput(self, input_obj: Input) -> ValidationResult:\n        \"\"\"Checks if the base is allowed (2 <= base < 10).\"\"\"\n        if not self.isBaseAllowed(input_obj.base):\n            return ValidationResult(is_valid=False, message=\"Base must be between 2 and 9 (inclusive).\")\n        return ValidationResult(is_valid=True)\n\n    def isBaseAllowed(self, base: int) -> bool:\n        \"\"\"Returns True if 2 <= base < 10, False otherwise.\"\"\"\n        return 2 <= base < 10\n\nclass BaseConverter:\n    \"\"\"Converts integer x to string representation in given base.\"\"\"\n    def convert(self, x: int, base: int) -> ConversionResult:\n        \"\"\"Performs standard repeated-division conversion.\"\"\"\n        if x == 0:\n            return ConversionResult(value=\"0\")\n\n        is_negative = False\n        if x < 0:\n            is_negative = True\n            x = abs(x)\n\n        result_digits = []\n        while x > 0:\n            remainder = x % base\n            result_digits.append(str(remainder))\n            x //= base\n\n        converted_string = \"\".join(result_digits[::-1])\n        if is_negative:\n            converted_string = \"-\" + converted_string\n        return ConversionResult(value=converted_string)\n\ndef change_base(x: int, base: int):\n    \"\"\"Change numerical base of input number x to base.\n    return string representation after the conversion.\n    base numbers are less than 10.\n    >>> change_base(8, 3)\n    '22'\n    >>> change_base(8, 2)\n    '1000'\n    >>> change_base(7, 2)\n    '111'\n    \"\"\"\n    input_obj = Input(x, base)\n    validator = Validator()\n    validation_result = validator.validateInput(input_obj)\n\n    if not validation_result.is_valid:\n        raise ValueError(validation_result.message)\n\n    converter = BaseConverter()\n    conversion_result = converter.convert(x, base)\n    return conversion_result.value"}
{"task_id": "HumanEval/45", "solution": "def triangle_area(a, h):\n    \"\"\"Given length of a side and high return area for a triangle.\n    >>> triangle_area(5, 3)\n    7.5\n    \"\"\"\n    return (a * h) / 2"}
{"task_id": "HumanEval/42", "solution": "def incr_list(l: list):\n    \"\"\"Return list with elements incremented by 1.\n    >>> incr_list([1, 2, 3])\n    [2, 3, 4]\n    >>> incr_list([5, 3, 5, 2, 3, 3, 9, 0, 123])\n    [6, 4, 6, 3, 4, 4, 10, 1, 124]\n    \"\"\"\n    return [x + 1 for x in l]"}
{"task_id": "HumanEval/46", "solution": "def fib4(n: int):\n    \"\"\"The Fib4 number sequence is a sequence similar to the Fibbonacci sequnece that's defined as follows:\n    fib4(0) -> 0\n    fib4(1) -> 0\n    fib4(2) -> 2\n    fib4(3) -> 0\n    fib4(n) -> fib4(n-1) + fib4(n-2) + fib4(n-3) + fib4(n-4).\n    Please write a function to efficiently compute the n-th element of the fib4 number sequence.  Do not use recursion.\n    >>> fib4(5)\n    4\n    >>> fib4(6)\n    8\n    >>> fib4(7)\n    14\n    \"\"\"\n    if n == 0:\n        return 0\n    if n == 1:\n        return 0\n    if n == 2:\n        return 2\n    if n == 3:\n        return 0\n\n    # Initialize rolling variables for fib4(0), fib4(1), fib4(2), fib4(3)\n    a, b, c, d = 0, 0, 2, 0\n\n    # Iteratively compute fib4(n) for n >= 4\n    for _ in range(4, n + 1):\n        next_fib = a + b + c + d\n        a, b, c, d = b, c, d, next_fib\n    \n    return d"}
{"task_id": "HumanEval/47", "solution": "from typing import Union\n\ndef _sort_non_decreasing(l: list) -> list:\n    \"\"\"Return a sorted copy of l in non-decreasing (ascending) order.\"\"\"\n    return sorted(l)\n\ndef median(l: list) -> Union[int, float]:\n    \"\"\"Return median of elements in the list l.\n    >>> median([3, 1, 2, 4, 5])\n    3\n    >>> median([-10, 4, 6, 1000, 10, 20])\n    15.0\n    \"\"\"\n    sorted_l = _sort_non_decreasing(l)\n    n = len(sorted_l)\n    if n % 2 == 1:\n        return sorted_l[n // 2]\n    else:\n        mid = n // 2\n        return (sorted_l[mid - 1] + sorted_l[mid]) / 2.0"}
{"task_id": "HumanEval/48", "solution": "def is_palindrome(text: str):\n    \"\"\"\n    Checks if given string is a palindrome\n    >>> is_palindrome('')\n    True\n    >>> is_palindrome('aba')\n    True\n    >>> is_palindrome('aaaaa')\n    True\n    >>> is_palindrome('zbcd')\n    False\n    \"\"\"\n    return text == text[::-1]"}
{"task_id": "HumanEval/51", "solution": "from typing import Tuple\n\nclass VowelSet:\n    \"\"\"Helper class to manage the set of vowels and check for membership.\"\"\"\n    def __init__(self) -> None:\n        \"\"\"Initializes the VowelSet with canonical ASCII vowels.\"\"\"\n        self.members: Tuple[str, ...] = ('a','e','i','o','u')\n\n    def contains(self, ch: str) -> bool:\n        \"\"\"Checks if a character is a vowel, case-insensitively.\"\"\"\n        return ch.lower() in self.members\n\nclass Text:\n    \"\"\"Thin wrapper around a string to align with the SRS domain model.\"\"\"\n    def __init__(self, content: str) -> None:\n        \"\"\"Stores the input string content.\"\"\"\n        self.content: str = content\n\ndef remove_vowels(text: str) -> str:\n    \"\"\"\n    remove_vowels is a function that takes string and returns string without vowels.\n    >>> remove_vowels('')\n    ''\n    >>> remove_vowels(\"abcdef\\nghijklm\")\n    'bcdf\\nghjklm'\n    >>> remove_vowels('abcdef')\n    'bcdf'\n    >>> remove_vowels('aaaaa')\n    ''\n    >>> remove_vowels('aaBAA')\n    'B'\n    >>> remove_vowels('zbcd')\n    'zbcd'\n    \"\"\"\n    t = Text(text)\n    vowels = VowelSet()\n    out_chars = []\n    for ch in t.content:\n        if not vowels.contains(ch):\n            out_chars.append(ch)\n    return ''.join(out_chars)"}
{"task_id": "HumanEval/50", "solution": "def decode_shift(s: str):\n    \"\"\"\n    takes as input string encoded with encode_shift function. Returns decoded string.\n    The input must consist solely of lowercase ASCII letters 'a'-'z'. Behavior for other characters is undefined.\n    \"\"\"\n    return \"\".join([chr(((ord(ch) - 5 - ord(\"a\")) % 26) + ord(\"a\")) for ch in s])"}
