{"task_id": "HumanEval/6", "solution": "from typing import List\n\nclass ParenthesisGroup:\n    \"\"\"Represents a single group of parentheses and computes its maximum nesting depth.\"\"\"\n    def __init__(self, text: str) -> None:\n        self.text = text\n        self.max_depth = 0\n\n    def compute_max_depth(self) -> int:\n        \"\"\"Computes the maximum nesting depth for this group.\"\"\"\n        current_depth = 0\n        max_depth = 0\n        for char in self.text:\n            if char == '(':\n                current_depth += 1\n                if current_depth > max_depth:\n                    max_depth = current_depth\n            elif char == ')':\n                current_depth -= 1\n        self.max_depth = max_depth\n        return max_depth\n\nclass DepthResult:\n    \"\"\"Container for the final ordered list of integer depths.\"\"\"\n    def __init__(self, depths: List[int]) -> None:\n        self.depths = depths\n\n    def to_list(self) -> List[int]:\n        \"\"\"Returns the contained list of depths.\"\"\"\n        return self.depths\n\nclass Parser:\n    \"\"\"Handles splitting the input and orchestrating depth computation for each group.\"\"\"\n    def parse(self, paren_string: str) -> List[int]:\n        \"\"\"Splits input, computes max depth per group, and returns ordered depths.\"\"\"\n        tokens = paren_string.split()\n        all_depths: List[int] = []\n        for token in tokens:\n            group = ParenthesisGroup(token)\n            all_depths.append(group.compute_max_depth())\n        \n        result = DepthResult(all_depths)\n        return result.to_list()\n\ndef parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\" Input to this function is a string represented multiple groups for nested parentheses separated by spaces.\n    For each of the group, output the deepest level of nesting of parentheses.\n    E.g. (()()) has maximum two levels of nesting while ((())) has three.\n\n    >>> parse_nested_parens('(()()) ((())) () ((())()())')\n    [2, 3, 1, 3]\n    \"\"\"\n    parser = Parser()\n    return parser.parse(paren_string)"}
{"task_id": "HumanEval/2", "solution": "import math\n\ndef truncate_number(number: float) -> float:\n    \"\"\" Given a positive floating point number, it can be decomposed into\n    and integer part (largest integer smaller than given number) and decimals\n    (leftover part always smaller than 1).\n\n    Return the decimal part of the number.\n    >>> truncate_number(3.5)\n    0.5\n    \"\"\"\n    return number - math.floor(number)"}
{"task_id": "HumanEval/5", "solution": "from typing import List\n\n\ndef validate_input(numbers: List[int], delimeter: int) -> bool:\n    \"\"\"Checks if the input list 'numbers' is not empty.\n    This function indicates validity (not empty) by returning True.\n    \"\"\"\n    return bool(numbers)\n\n\ndef _build_output(numbers: List[int], delimeter: int) -> List[int]:\n    \"\"\"Constructs a new list by inserting the delimeter between elements.\n    This helper avoids modifying the input list and handles non-empty lists.\n    \"\"\"\n    result = []\n    for i, num in enumerate(numbers):\n        result.append(num)\n        if i < len(numbers) - 1:\n            result.append(delimeter)\n    return result\n\n\ndef intersperse(numbers: List[int], delimeter: int) -> List[int]:\n    \"\"\" Insert a number 'delimeter' between every two consecutive elements of input list `numbers'\n    >>> intersperse([], 4)\n    []\n    >>> intersperse([1, 2, 3], 4)\n    [1, 4, 2, 4, 3]\n    \"\"\"\n    if not validate_input(numbers, delimeter):\n        return []\n\n    return _build_output(numbers, delimeter)"}
{"task_id": "HumanEval/7", "solution": "from typing import List\n\n\ndef filter_by_substring(strings: List[str], substring: str) -> List[str]:\n    \"\"\" Filter an input list of strings only for ones that contain given substring\n    >>> filter_by_substring([], 'a')\n    []\n    >>> filter_by_substring(['abc', 'bacd', 'cde', 'array'], 'a')\n    ['abc', 'bacd', 'array']\n    \"\"\"\n    result: List[str] = []\n    for s in strings:\n        if substring in s:\n            result.append(s)\n    return result"}
{"task_id": "HumanEval/3", "solution": "from typing import List\n\n\nclass Account:\n    def __init__(self):\n        self.balance: int = 0\n\n    def reset(self) -> None:\n        self.balance = 0\n\n    def apply_operation(self, value: int) -> None:\n        self.balance += value\n\n    def get_balance(self) -> int:\n        return self.balance\n\n\nclass Operation:\n    def __init__(self, value: int, index: int):\n        self.value: int = value\n        self.index: int = index\n\n\nclass OperationSequence:\n    def __init__(self, operations: List[Operation]):\n        self.operations: List[Operation] = operations\n\n    def length(self) -> int:\n        return len(self.operations)\n\n    def get(self, index: int) -> Operation:\n        return self.operations[index]\n\n    @staticmethod\n    def from_int_list(values: List[int]) -> 'OperationSequence':\n        ops = [Operation(value, i) for i, value in enumerate(values)]\n        return OperationSequence(ops)\n\n\nclass BalanceChecker:\n    @staticmethod\n    def below_zero(operations: List[int]) -> bool:\n        account = Account()\n        operation_sequence = OperationSequence.from_int_list(operations)\n\n        for i in range(operation_sequence.length()):\n            op = operation_sequence.get(i)\n            account.apply_operation(op.value)\n            if account.get_balance() < 0:\n                return True\n        return False\n\n\ndef below_zero(operations: List[int]) -> bool:\n    \"\"\" You're given a list of deposit and withdrawal operations on a bank account that starts with\n    zero balance. Your task is to detect if at any point the balance of account fallls below zero, and\n    at that point function should return True. Otherwise it should be False.\n    >>> below_zero([1, 2, 3])\n    False\n    >>> below_zero([1, 2, -4, 5])\n    True\n    \"\"\"\n    return BalanceChecker.below_zero(operations)"}
{"task_id": "HumanEval/0", "solution": "from typing import List, Iterable\n\n\nclass NumbersList:\n    def __init__(self, values: List[float]):\n        # Stores a reference to the validated list of float values.\n        self._values = values\n\n    def __len__(self) -> int:\n        return len(self._values)\n\n    def __getitem__(self, index: int) -> float:\n        return self._values[index]\n\n\nclass Validator:\n    def _is_float_like(self, value) -> bool:\n        # Internal helper to check if a value is float-like.\n        return isinstance(value, (int, float))\n\n    def validate_threshold(self, threshold: float) -> None:\n        # Validates that the threshold is a float.\n        if not isinstance(threshold, float):\n            raise TypeError(\"Threshold must be a float.\")\n\n    def validate_numbers(self, numbers: Iterable[float]) -> NumbersList:\n        # Validates an iterable of numbers and converts elements to float.\n        if not isinstance(numbers, Iterable):\n            raise TypeError(\"Numbers must be an iterable.\")\n\n        validated_values = []\n        for i, num in enumerate(numbers):\n            if not self._is_float_like(num):\n                raise TypeError(f\"Element at index {i} is not a float-like number.\")\n            validated_values.append(float(num))\n\n        return NumbersList(validated_values)\n\n\nclass Comparator:\n    def absolute_difference(self, a: float, b: float) -> float:\n        # Computes the absolute difference between two floats.\n        return abs(a - b)\n\n    def _pairwise_close_check(self, numbers: NumbersList, threshold: float) -> bool:\n        # Checks for a close pair in the NumbersList using nested loops.\n        n = len(numbers)\n        if n < 2:\n            return False\n\n        for i in range(n):\n            for j in range(i + 1, n):\n                if self.absolute_difference(numbers[i], numbers[j]) < threshold:\n                    return True\n        return False\n\n    def has_close_pair(self, numbers: NumbersList, threshold: float) -> bool:\n        # Delegates to the internal pairwise check.\n        return self._pairwise_close_check(numbers, threshold)\n\n\ndef has_close_elements(numbers: List[float], threshold: float) -> bool:\n    \"\"\" Check if in given list of numbers, are any two numbers closer to each other than\n    given threshold.\n    >>> has_close_elements([1.0, 2.0, 3.0], 0.5)\n    False\n    >>> has_close_elements([1.0, 2.8, 3.0, 4.0, 5.0, 2.0], 0.3)\n    True\n    \"\"\"\n    validator = Validator()\n    validator.validate_threshold(threshold)\n    numbers_list = validator.validate_numbers(numbers)\n    comparator = Comparator()\n    return comparator.has_close_pair(numbers_list, threshold)"}
{"task_id": "HumanEval/1", "solution": "from typing import List\n\n\nclass Preprocessor:\n    @staticmethod\n    def remove_spaces(s: str) -> str:\n        \"\"\"Removes all space characters from the input string.\"\"\"\n        return s.replace(' ', '')\n\nclass Normalizer:\n    @staticmethod\n    def normalize_group(group: str) -> str:\n        \"\"\"Ensures the group string contains only '(' and ')' characters.\"\"\"\n        return \"\".join(c for c in group if c in '()')\n\nclass Parser:\n    def __init__(self):\n        self._current_buffer: List[str] = []\n        self._depth: int = 0\n\n    def separate_paren_groups(self, paren_string: str) -> List[str]:\n        \"\"\"Scans the string and extracts top-level balanced parenthesis groups.\"\"\"\n        output_groups: List[str] = []\n\n        for char in paren_string:\n            if char == '(':\n                self._current_buffer.append(char)\n                self._depth += 1\n            elif char == ')':\n                self._current_buffer.append(char)\n                self._depth -= 1\n\n                if self._depth == 0:  # A top-level group has been closed.\n                    raw_group = \"\".join(self._current_buffer)\n                    normalized_group = Normalizer.normalize_group(raw_group)\n                    output_groups.append(normalized_group)\n                    self._current_buffer = []  # Reset for the next group.\n\n        return output_groups\n\n\ndef separate_paren_groups(paren_string: str) -> List[str]:\n    \"\"\" Input to this function is a string containing multiple groups of nested parentheses. Your goal is to\n    separate those group into separate strings and return the list of those.\n    Separate groups are balanced (each open brace is properly closed) and not nested within each other\n    Ignore any spaces in the input string.\n    >>> separate_paren_groups('( ) (( )) (( )( ))')\n    ['()', '(())', '(()())']\n    \"\"\"\n    cleaned = Preprocessor.remove_spaces(paren_string)\n    return Parser().separate_paren_groups(cleaned)"}
{"task_id": "HumanEval/4", "solution": "from typing import List\n\nclass Dataset:\n    \"\"\"Represents a numerical dataset with its values and size.\"\"\"\n    def __init__(self, numbers: List[float]) -> None:\n        self.numbers = numbers\n        self.size = len(numbers)\n\nclass InputValidator:\n    \"\"\"Provides methods for validating input lists for MAD calculation.\"\"\"\n    def validate_non_empty(self, numbers: List[float]) -> bool:\n        \"\"\"Checks if the list of numbers is not empty.\"\"\"\n        return bool(numbers)\n\n    def validate_numeric(self, numbers: List) -> bool:\n        \"\"\"Checks if all elements in the list are numeric (float or int).\"\"\"\n        for x in numbers:\n            if not isinstance(x, (float, int)):\n                return False\n        return True\n\nclass MADCalculator:\n    \"\"\"Calculates Mean Absolute Deviation (MAD) and its intermediate components.\"\"\"\n    def compute_mean(self, dataset: Dataset) -> float:\n        \"\"\"Computes the arithmetic mean of the dataset.\"\"\"\n        if not dataset.numbers:\n            return 0.0\n        return sum(dataset.numbers) / dataset.size\n\n    def compute_absolute_differences(self, dataset: Dataset, mean: float) -> List[float]:\n        \"\"\"Calculates absolute differences of each number from the given mean.\"\"\"\n        return [abs(x - mean) for x in dataset.numbers]\n\n    def compute_mad(self, dataset: Dataset) -> float:\n        \"\"\"Computes the Mean Absolute Deviation for the dataset.\"\"\"\n        if not dataset.numbers:\n            return 0.0\n        mean = self.compute_mean(dataset)\n        absolute_differences = self.compute_absolute_differences(dataset, mean)\n        # If numbers was not empty, absolute_differences will not be empty either.\n        return sum(absolute_differences) / len(absolute_differences)\n\ndef mean_absolute_deviation(numbers: List[float]) -> float:\n    \"\"\" For a given list of input numbers, calculate Mean Absolute Deviation\n    around the mean of this dataset.\n    Mean Absolute Deviation is the average absolute difference between each\n    element and a centerpoint (mean in this case):\n    MAD = average | x - x_mean |\n    >>> mean_absolute_deviation([1.0, 2.0, 3.0, 4.0])\n    1.0\n    \"\"\"\n    validator = InputValidator()\n    # As per design, validator methods are called, but runtime policy for\n    # invalid inputs (empty or non-numeric) is unspecified and not implemented here\n    # with explicit error handling as per completion instructions.\n    validator.validate_non_empty(numbers)\n    validator.validate_numeric(numbers)\n\n    dataset = Dataset(numbers)\n    calculator = MADCalculator()\n    return calculator.compute_mad(dataset)"}
{"task_id": "HumanEval/8", "solution": "from typing import List, Tuple\n\n\ndef sum_product(numbers: List[int]) -> Tuple[int, int]:\n    \"\"\" For a given list of integers, return a tuple consisting of a sum and a product of all the integers in a list.\n    Empty sum should be equal to 0 and empty product should be equal to 1.\n    >>> sum_product([])\n    (0, 1)\n    >>> sum_product([1, 2, 3, 4])\n    (10, 24)\n    \"\"\"\n    sum_acc = 0\n    prod_acc = 1\n\n    for number in numbers:\n        sum_acc += number\n        prod_acc *= number\n\n    return (sum_acc, prod_acc)"}
{"task_id": "HumanEval/9", "solution": "from typing import List, Tuple\n\n\nclass RollingMaxFunction:\n    @staticmethod\n    def computeRollingMax(numbers: List[int]) -> List[int]:\n        \"\"\"Compute rolling maximum sequence for input numbers.\n        This iterates through the list, updating and appending the current maximum.\"\"\"\n        if not numbers:\n            return []\n\n        output_list = []\n        current_max = float('-inf')  # Initialize with a very small number\n\n        for number in numbers:\n            if number > current_max:\n                current_max = number\n            output_list.append(current_max)\n\n        return output_list\n\n\ndef rolling_max(numbers: List[int]) -> List[int]:\n    \"\"\" From a given list of integers, generate a list of rolling maximum element found until given moment\n    in the sequence.\n    >>> rolling_max([1, 2, 3, 2, 3, 4, 2])\n    [1, 2, 3, 3, 3, 4, 4]\n    \"\"\"\n    return RollingMaxFunction.computeRollingMax(numbers)"}
{"task_id": "HumanEval/12", "solution": "from typing import List, Optional\n\n\ndef longest(strings: List[str]) -> Optional[str]:\n    \"\"\" Out of list of strings, return the longest one. Return the first one in case of multiple\n    strings of the same length. Return None in case the input list is empty.\n    >>> longest([])\n\n    >>> longest(['a', 'b', 'c'])\n    'a'\n    >>> longest(['a', 'bb', 'ccc'])\n    'ccc'\n    \"\"\"\n    if not strings:\n        return None\n\n    longest_str_found = \"\"\n    for s in strings:\n        if len(s) > len(longest_str_found):\n            longest_str_found = s\n    return longest_str_found"}
{"task_id": "HumanEval/11", "solution": "from typing import List\n\n\nclass BinaryString:\n    \"\"\"Encapsulates a binary string and provides validation and length utilities.\"\"\"\n    def __init__(self, value: str) -> None:\n        self.value = value\n\n    def length(self) -> int:\n        return len(self.value)\n\n    def isValid(self) -> bool:\n        return all(c in '01' for c in self.value)\n\n\nclass Validator:\n    \"\"\"Provides stateless validation logic for binary strings.\"\"\"\n    def validateChars(self, bs: BinaryString) -> bool:\n        return bs.isValid()\n\n    def validateLength(self, a: BinaryString, b: BinaryString) -> bool:\n        return a.length() == b.length()\n\n\nclass XORProcessor:\n    \"\"\"Coordinates validation and computes the XOR of two binary strings.\"\"\"\n    def __init__(self, validator: Validator = None) -> None:\n        self._validator = validator if validator is not None else Validator()\n\n    def xor(self, a: BinaryString, b: BinaryString) -> str:\n        # Validate characters on inputs a and b.\n        if not self._validator.validateChars(a):\n            raise ValueError(\"Input string 'a' contains characters other than '0' or '1'.\")\n        if not self._validator.validateChars(b):\n            raise ValueError(\"Input string 'b' contains characters other than '0' or '1'.\")\n        \n        # Validate lengths of inputs a and b.\n        if not self._validator.validateLength(a, b):\n            raise ValueError(\"Input strings 'a' and 'b' must have equal length.\")\n\n        result_chars = []\n        for i in range(a.length()):\n            # Compute XOR for corresponding bits.\n            if a.value[i] != b.value[i]:\n                result_chars.append('1')\n            else:\n                result_chars.append('0')\n        return \"\".join(result_chars)\n\n\ndef string_xor(a: str, b: str) -> str:\n    \"\"\" Input are two strings a and b consisting only of 1s and 0s.\n    Perform binary XOR on these inputs and return result also as a string.\n    >>> string_xor('010', '110')\n    '100'\n    \"\"\"\n    bs_a = BinaryString(a)\n    bs_b = BinaryString(b)\n\n    validator = Validator()\n    xor_processor = XORProcessor(validator)\n    \n    # The XORProcessor handles all validations and raises ValueError on failure.\n    return xor_processor.xor(bs_a, bs_b)"}
{"task_id": "HumanEval/10", "solution": "def _find_longest_palindromic_suffix(string: str) -> int:\n    \"\"\"Finds the starting index of the longest palindromic suffix in the string.\n    Returns the index `i` such that `string[i:]` is the longest palindromic suffix.\n    \"\"\"\n    n = len(string)\n    for i in range(n):\n        if string[i:] == string[i:][::-1]:\n            return i\n    return n\n\n\ndef make_palindrome(string: str) -> str:\n    \"\"\" Find the shortest palindrome that begins with a supplied string.\n    Algorithm idea is simple:\n    - Find the longest postfix of supplied string that is a palindrome.\n    - Append to the end of the string reverse of a string prefix that comes before the palindromic suffix.\n    >>> make_palindrome('')\n    ''\n    >>> make_palindrome('cat')\n    'catac'\n    >>> make_palindrome('cata')\n    'catac'\n    \"\"\"\n    if not string:\n        return ''\n\n    suffix_start_index = _find_longest_palindromic_suffix(string)\n    prefix_to_reverse = string[:suffix_start_index]\n    \n    return string + prefix_to_reverse[::-1]"}
{"task_id": "HumanEval/13", "solution": "def greatest_common_divisor(a: int, b: int) -> int:\n    \"\"\" Return a greatest common divisor of two integers a and b\n    >>> greatest_common_divisor(3, 5)\n    1\n    >>> greatest_common_divisor(25, 15)\n    5\n    \"\"\"\n    while b:\n        a, b = b, a % b\n    return abs(a)"}
{"task_id": "HumanEval/14", "solution": "from typing import List\n\n\ndef all_prefixes(string: str) -> List[str]:\n    \"\"\" Return list of all prefixes from shortest to longest of the input string\n    >>> all_prefixes('abc')\n    ['a', 'ab', 'abc']\n    \"\"\"\n    return [string[:i+1] for i in range(len(string))]"}
{"task_id": "HumanEval/15", "solution": "from typing import List\n\nclass IntegerParameter:\n    \"\"\"Encapsulates an integer value for processing.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\n    def is_valid_non_negative(self) -> bool:\n        \"\"\"Checks if the stored value is non-negative.\"\"\"\n        # Following \"DO NOT add isinstance() checks or raise exceptions\",\n        # we assume 'value' is int and only check its magnitude.\n        return self.value >= 0\n\nclass SequenceString:\n    \"\"\"Formats a list of integers into a single space-delimited string.\"\"\"\n    def __init__(self) -> None:\n        pass # No state is required for formatting.\n\n    def format(self, numbers: List[int]) -> str:\n        \"\"\"Converts a list of integers to their space-delimited string representation.\"\"\"\n        return ' '.join(str(num) for num in numbers)\n\nclass SequenceGenerator:\n    \"\"\"Coordinates generation and formatting of number sequences.\"\"\"\n    def __init__(self) -> None:\n        self._formatter = SequenceString()\n\n    def generate(self, n: int) -> List[int]:\n        \"\"\"Generates a list of integers from 0 up to n inclusive.\"\"\"\n        # range(0, n+1) handles n=0 correctly by producing [0].\n        # If n is negative, it produces an empty list, adhering to \"DO NOT raise exceptions\".\n        return list(range(0, n + 1))\n\n    def string_sequence(self, n: int) -> str:\n        \"\"\"Returns a space-delimited string of numbers from 0 to n.\"\"\"\n        # IntegerParameter is instantiated as per design, but explicit validation\n        # for raising errors is skipped due to the \"DO NOT raise exceptions\" rule.\n        param = IntegerParameter(n) # Kept for structural adherence to design.\n        \n        numbers = self.generate(n)\n        formatted_text = self._formatter.format(numbers)\n        return formatted_text\n\ndef string_sequence(n: int) -> str:\n    \"\"\" Return a string containing space-delimited numbers starting from 0 upto n inclusive.\n    >>> string_sequence(0)\n    '0'\n    >>> string_sequence(5)\n    '0 1 2 3 4 5'\n    \"\"\"\n    generator = SequenceGenerator()\n    return generator.string_sequence(n)"}
{"task_id": "HumanEval/16", "solution": "def count_distinct_characters(string: str) -> int:\n    \"\"\" Given a string, find out how many distinct characters (regardless of case) does it consist of\n    >>> count_distinct_characters('xyzXYZ')\n    3\n    >>> count_distinct_characters('Jerry')\n    4\n    \"\"\"\n    distinct_chars = set()\n    for char in string:\n        distinct_chars.add(char.lower())\n    return len(distinct_chars)"}
{"task_id": "HumanEval/17", "solution": "from typing import List\n\n\ndef parse_music(music_string: str) -> List[int]:\n    \"\"\" Input to this function is a string representing musical notes in a special ASCII format.\n    Your task is to parse this string and return list of integers corresponding to how many beats does each\n    not last.\n\n    Here is a legend:\n    'o' - whole note, lasts four beats\n    'o|' - half note, lasts two beats\n    '.|' - quater note, lasts one beat\n\n    >>> parse_music('o o| .| o| o| .| .| .| .| o o')\n    [4, 2, 1, 2, 2, 1, 1, 1, 1, 4, 4]\n    \"\"\"\n\n    def _tokenize(music_string: str) -> List[str]:\n        \"\"\"Splits the music string into individual note tokens.\"\"\"\n        return music_string.split()\n\n    def _map_token(token: str) -> int:\n        \"\"\"Maps a note token to its corresponding beat duration.\"\"\"\n        # A dictionary lookup efficiently expresses the mapping rules.\n        # Per design and example, input tokens are assumed to be valid keys.\n        beat_map = {'o': 4, 'o|': 2, '.|': 1}\n        return beat_map[token]\n\n    tokens = _tokenize(music_string)\n    beats = []\n    for token in tokens:\n        beat = _map_token(token)\n        beats.append(beat)\n    return beats"}
{"task_id": "HumanEval/18", "solution": "from dataclasses import dataclass\n\n@dataclass\nclass SearchRequest:\n    originalString: str\n    substring: str\n\n@dataclass\nclass SearchResult:\n    count: int\n\nclass HowManyTimesService:\n    \"\"\"Encapsulates the algorithm to count overlapping occurrences of a substring.\"\"\"\n    def how_many_times(self, original_string: str, substring: str) -> int:\n        count = 0\n        n = len(original_string)\n        m = len(substring)\n\n        # Handle early-exit conditions as per design requirements.\n        if n == 0:\n            return 0\n        if m > n:\n            return 0\n\n        # Loop through the original string, checking for substring matches at each position.\n        # This correctly counts overlapping occurrences.\n        for i in range(n - m + 1):\n            if original_string[i : i + m] == substring:\n                count += 1\n        return count\n\ndef how_many_times(string: str, substring: str) -> int:\n    \"\"\" Find how many times a given substring can be found in the original string. Count overlaping cases.\n    >>> how_many_times('', 'a')\n    0\n    >>> how_many_times('aaa', 'a')\n    3\n    >>> how_many_times('aaaa', 'aa')\n    3\n    \"\"\"\n    # The public API delegates the core logic to the HowManyTimesService.\n    service = HowManyTimesService()\n    return service.how_many_times(string, substring)"}
{"task_id": "HumanEval/19", "solution": "from typing import List, Dict\n\n\n# Module-private helper function for InputString\ndef _split_on_spaces(raw: str) -> List[str]:\n    # Splits the raw string by a single space character.\n    # Returns an empty list if the raw string is empty.\n    if not raw:\n        return []\n    return raw.split(' ')\n\n\nclass Token:\n    def __init__(self, word: str, position: int) -> None:\n        self.word = word\n        self.position = position\n\n    def normalize(self) -> str:\n        # Converts the token word to lowercase for consistent processing.\n        return self.word.lower()\n\n\nclass InputString:\n    def __init__(self, raw: str) -> None:\n        self.raw = raw\n\n    def is_empty(self) -> bool:\n        # Checks if the raw input string is empty.\n        return self.raw == ''\n\n    def tokenize(self) -> List[Token]:\n        # Splits the raw string into words and creates Token objects.\n        # Each token includes its original word and position.\n        words = _split_on_spaces(self.raw)\n        tokens = [Token(word, i) for i, word in enumerate(words)]\n        return tokens\n\n\nclass NumberWord:\n    VALUE_MAP: Dict[str, int] = {\n        'zero': 0, 'one': 1, 'two': 2, 'three': 3, 'four': 4,\n        'five': 5, 'six': 6, 'seven': 7, 'eight': 8, 'nine': 9\n    }\n\n    def __init__(self, word: str, value: int) -> None:\n        # Initializes a NumberWord instance.\n        # This constructor might not be directly used by Sorter.\n        self.word = word\n        self.value = value\n\n    @classmethod\n    def word_to_value(cls, word: str) -> int:\n        # Maps a number word to its corresponding integer value.\n        # Raises KeyError if the word is not valid.\n        return cls.VALUE_MAP[word]\n\n    @classmethod\n    def is_valid_word(cls, word: str) -> bool:\n        # Checks if a given word is a valid number word.\n        return word in cls.VALUE_MAP\n\n\nclass Sorter:\n    def __init__(self) -> None:\n        pass # Sorter is stateless and does not require initialization state.\n\n    def sort(self, tokens: List[Token]) -> List[Token]:\n        # Sorts a list of Token objects based on their numeric value.\n        # Uses NumberWord to get the integer value for comparison.\n        def get_sort_key(token: Token) -> int:\n            return NumberWord.word_to_value(token.normalize())\n\n        # Python's Timsort is stable, preserving original order for equal values.\n        return sorted(tokens, key=get_sort_key)\n\n\nclass SortedResult:\n    def __init__(self, output: str) -> None:\n        # Initializes SortedResult with the final formatted string.\n        # This instance field might not be directly used by the classmethod 'format'.\n        self.output = output\n\n    @classmethod\n    def format(cls, tokens: List[Token]) -> str:\n        # Formats a list of sorted tokens into a space-delimited string.\n        # Returns an empty string if the tokens list is empty.\n        if not tokens:\n            return ''\n        normalized_words = [token.normalize() for token in tokens]\n        return ' '.join(normalized_words)\n\n\ndef sort_numbers(numbers: str) -> str:\n    \"\"\" Input is a space-delimited string of numberals from 'zero' to 'nine'.\n    Valid choices are 'zero', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight' and 'nine'.\n    Return the string with numbers sorted from smallest to largest\n    >>> sort_numbers('three one five')\n    'one three five'\n    \"\"\"\n    input_obj = InputString(numbers)\n    if input_obj.is_empty():\n        return ''\n    tokens = input_obj.tokenize()\n    sorter = Sorter()\n    sorted_tokens = sorter.sort(tokens)\n    return SortedResult.format(sorted_tokens)"}
