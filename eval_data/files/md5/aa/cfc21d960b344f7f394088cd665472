S of the inner substring (s[i+1...j-1]).\n                dp[j] = 2 + prev_diag_val\n            else:\n                # If characters don't match, take the maximum of LPS excluding s[i] or excluding s[j].\n                # dp[j] (before update) is dp_table[i+1][j], and dp[j-1] (already updated for current 'i') is dp_table[i][j-1].\n                dp[j] = max(current_dp_j_val, dp[j-1])\n            \n            # Update prev_diag_val for the next iteration of 'j'.\n            prev_diag_val = current_dp_j_val\n            \n    # The final result for the entire string s[0...n-1] is stored in dp[n-1].\n    return dp[n - 1]", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/250": [{"task_id": "Mbpp/250", "solution": "def count_X(t: tuple, e: Any) -> int:\n    \"\"\"\n    Return the number of times element `e` appears in tuple `t`.\n    This uses the built-in tuple.count() method for efficient counting.\n    \"\"\"\n    return t.count(e)", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/252": [{"task_id": "Mbpp/252", "solution": "def convert(c: complex) -> tuple[float, float]:\n    \"\"\"\n    Converts a complex number to its polar coordinates (magnitude, angle).\n    The angle is in radians, in the range [-pi, pi].\n    \"\"\"\n    import math\n\n    magnitude = math.sqrt(c.real**2 + c.imag**2)\n    angle = math.atan2(c.imag, c.real)\n    return (magnitude, angle)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/162": [{"task_id": "Mbpp/162", "solution": "def sum_series(n: int) -> int:\n    \"\"\"Calculates the sum of the series (n - 2*i) for i from 0 to n // 2, until the term is <= 0.\"\"\"\n    current_sum = 0\n    i = 0\n    while True:\n        term = n - 2 * i\n        if term <= 0:\n            break\n        current_sum += term\n        i += 1\n    return current_sum", "base_status": "pass", "plus_status