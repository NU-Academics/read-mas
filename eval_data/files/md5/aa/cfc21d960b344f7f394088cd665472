(\"Human years cannot be negative.\")\n    \n    if humanYears == 0:\n        return 0\n    \n    first_two_years_dog_age = min(humanYears, 2) * 10.5\n    remaining_years_dog_age = max(humanYears - 2, 0) * 4\n    \n    total_dog_age = first_two_years_dog_age + remaining_years_dog_age\n    \n    return int(total_dog_age)", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[true]]}], "Mbpp/260": [{"task_id": "Mbpp/260", "solution": "import threading\nimport math\nimport logging\nlogger = logging.getLogger(__name__)\nclass InvalidInputException(ValueError):\n    \"\"\"Raised when the input 'n' is not a positive integer.\"\"\"\n    pass\nclass Cache:\n    \"\"\"Thread-safe in-memory cache for computed NSW prime numbers.\"\"\"\n    def __init__(self):\n        self._store = {}\n        self._lock = threading.Lock()\n\n    def get(self, n: int) -> int | None:\n        \"\"\"Retrieves a value from the cache by index.\"\"\"\n        with self._lock:\n            value = self._store.get(n)\n            if value is not None:\n                logger.info(f\"Cache hit for n={n}\")\n            else:\n                logger.info(f\"Cache miss for n={n}\")\n            return value\n\n    def set(self, n: int, value: int):\n        \"\"\"Stores a value in the cache at a given index.\"\"\"\n        with self._lock:\n            self._store[n] = value\n            logger.info(f\"Cache set for n={n} with value={value}\")\ndef _is_prime(num: int) -> bool:\n    \"\"\"Checks if a number is prime using trial division.\"\"\"\n    if num < 2:\n        return False\n    if num == 2:\n        return True\n    if num % 2 == 0:\n        return False\n    # Check for factors from 3 up to sqrt(num)\n    for i in range(3, int(math.sqrt(num)) + 1, 2):\n        if num % i == 0:\n            return False\n    return True\nclass PrimeGenerator:\n    \"\"\"Generates Newman\u2013Shanks\u2013Williams (NSW) numbers and checks for primality.\"\"\"\n    def __init__(self, cache: Cache):\n        self._cache = cache\n        # N(0)=1, N(1)=1 are base cases for the recurrence N(k) = 2*N(k-1) + N(k-2).\n        self._nsw_sequence = {0: 1, 1: 1}\n        self._nsw_lock = threading.Lock() # Protects _nsw_sequence\n\n    def _get_nsw_value(self, k: int) -> int:\n        \"\"\"Computes and returns the k-th NSW number N(k) using recurrence.\"\"\"\n        with self._nsw_lock:\n            # Ensure sequence is computed up to k\n            for i in range(len(self._nsw_sequence), k + 1):\n                n_k_minus_1 = self._nsw_sequence[i-1]\n                n_k_minus_2 = self._nsw_sequence[i-2]\n                self._nsw_sequence[i] = 2 * n_k_minus_1 + n_k_minus_2\n            return self._nsw_sequence[k]\n\n    def get_prime(self, n: int) -> int:\n        \"\"\"\n        Calculates the N-th Newman-Shanks-Williams (NSW) number N(n).\n        Returns N(n) if it is prime, otherwise logs an error and returns N(n).\n        Only caches the value if it is prime, as per design.\n        \"\"\"\n        # Check cache first for a previously computed prime N(n)\n        cached_value = self._cache.get(n)\n        if cached_value is not None:\n            return cached_value\n\n        # Compute N(n)\n        nsw_value = self._get_nsw_value(n)\n\n        # Check for primality and cache if prime\n        if _is_prime(nsw_value):\n            self._cache.set(n, nsw_value)\n            logger.info(f\"N({n}) = {nsw_value} is prime and cached.\")\n            return nsw_value\n        else:\n            # If N(n) is not prime, it does not fit the description \"nth NSW prime number\".\n            # As no specific exception is allowed for n > 0 in this case,\n            # N(n) is returned despite not being prime, with an error logged.\n            logger.error(f\"N({n}) = {nsw_value} is not prime. This input 'n' does not correspond to an NSW prime.\")\n            return nsw_value\n_nsw_cache = Cache()\n_nsw_prime_generator = PrimeGenerator(_nsw_cache)\ndef newman_prime(n: int) -> int:\n    \"\"\"\n    Finds the nth Newman\u2013Shanks\u2013Williams prime number.\n    'n' refers to the index 'k' in the NSW sequence N(k).\n    \"\"\"\n    if n <= 0:\n        logger.error(f\"Input 'n' must be a positive integer, but received {n}.\")\n        raise InvalidInputException(\"Input 'n' must be a positive integer.\")\n\n    return _nsw_prime_generator.get_prime(n)", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[0]]}], "Mbpp/257": [{"task_id": "Mbpp/257", "solution": "def swap_numbers(a, b):\n    \"\"\"\n    Swaps the order of two numbers, returning them as a tuple (b, a).\n    \"\"\"\n    return (b, a)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/262": [{"task_id": "Mbpp/262", "solution": "def split_two_parts(input_list: list, L: int) -> tuple[list, list]:\n    \"\"\"\n    Splits the given list into two parts based on the specified length L.\n    Returns the two parts as a tuple (first_part, second_part).\n    \"\"\"\n    first_part = input_list[:L]\n    second_part = input_list[L:]\n    return (first_part, second_part)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/261": [{"task_id": "Mbpp/261", "solution": "def division_elements(tuple1: tuple, tuple2: tuple) -> tuple:\n    \"\"\"\n    Performs element-wise division of two tuples, returning integers if division is exact, otherwise floats.\n    \"\"\"\n    results = []\n    for a, b in zip(tuple1, tuple2):\n        # Perform division. Python's / operator always returns a float.\n        div_result = a / b\n        # Check if the division is exact (i.e., no remainder) to return an integer.\n        # Handle potential float precision issues by checking if remainder is very close to zero.\n        # However, the problem implies simple exact integer division check from example, so a % b == 0 is sufficient.\n        if isin