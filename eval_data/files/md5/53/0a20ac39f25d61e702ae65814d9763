ned English vowels (a, e, i, o, u, A, E, I, O, U).\"\"\"\n    return char in \"aeiouAEIOU\"\ndef _shift_char_two_places_forward(char):\n    \"\"\"Shifts an English alphabetic character two positions forward, maintaining case and not wrapping past 'Z' or 'z'.\"\"\"\n    if 'a' <= char <= 'z':\n        shifted_ord = ord(char) + 2\n        if shifted_ord > ord('z'):\n            return 'z'\n        return chr(shifted_ord)\n    elif 'A' <= char <= 'Z':\n        shifted_ord = ord(char) + 2\n        if shifted_ord > ord('Z'):\n            return 'Z'\n        return chr(shifted_ord)\n    return char\ndef encode(message):\n    \"\"\"\n    Encodes a message by swapping the case of all letters and\n    replacing vowels with the letter 2 places ahead in the alphabet.\n    \"\"\"\n    encoded_chars = []\n    for char in message:\n        if _is_english_alphabetic(char):\n            swapped_char = _swap_case_char(char)\n            if _is_vowel_char(swapped_char):\n                final_char = _shift_char_two_places_forward(swapped_char)\n            else:\n                final_char = swapped_char\n        else:\n            final_char = char\n        encoded_chars.append(final_char)\n    return \"\".join(encoded_chars)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/95": [{"task_id": "HumanEval/95", "solution": "def check_dict_case(dict):\n    \"\"\"\n    Given a dictionary, return True if all keys are strings in lower \n    case or all keys are strings in upper case, else return False.\n    The function should return False is the given dictionary is empty.\n    \"\"\"\n    if not dict:\n        return False\n\n    first_key_case = None # None for not determined, True for lower, False for upper\n\n    for key in dict.keys():\n        if not isinstance(key, str):\n            return False\n\n        if first_key_case is None:\n            if key.islower():\n                first_key_case = True  # Assuming all keys sho