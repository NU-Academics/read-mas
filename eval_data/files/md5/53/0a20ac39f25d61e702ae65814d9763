ful extension\n        return self._extension\n\n    def _starts_with_latin_letter(self, s: str) -> bool:\n        \"\"\"Checks if a string starts with a Latin alphabet letter.\"\"\"\n        if not s:\n            return False\n        return 'a' <= s[0].lower() <= 'z'\n\n    def _is_valid_extension(self, ext: str) -> bool:\n        \"\"\"Checks if the extension is one of the allowed types.\"\"\"\n        return ext in self.ALLOWED_EXTENSIONS\n\n    def validate(self) -> str:\n        \"\"\"Returns 'Yes' if the file name is valid, 'No' otherwise.\"\"\"\n        # BR1: No more than three digits\n        if self._count_digits() > self.MAX_DIGITS:\n            return 'No'\n\n        # BR2: Exactly one dot\n        if self._count_dots() != self.EXACT_DOTS:\n            return 'No'\n\n        prefix = self._get_prefix()\n        extension = self._get_extension()\n\n        # BR3: Prefix not empty\n        if not prefix:\n            return 'No'\n\n        # BR4: Prefix starts with a Latin letter\n        if not self._starts_with_latin_letter(prefix):\n            return 'No'\n\n        # BR5: Valid extension\n        if not self._is_valid_extension(extension):\n            return 'No'\n\n        # BR6: All conditions met\n        return 'Yes'\ndef file_name_check(file_name: str) -> str:\n    \"\"\"Create a function which takes a string representing a file's name, and returns\n    'Yes' if the the file's name is valid, and returns 'No' otherwise.\n    A file's name is considered to be valid if and only if all the following conditions \n    are met:\n    - There should not be more than three digits ('0'-'9') in the file's name.\n    - The file's name contains exactly one dot '.'\n    - The substring before the dot should not be empty, and it starts with a letter from \n    the latin alphapet ('a'-'z' and 'A'-'Z').\n    - The substring after the dot should be one of these: ['txt', 'exe', 'dll']\n    Examples:\n    file_name_check(\"example.txt\") # => 'Yes'\n    file_name_check(\"1example.dll\") # => 'No' (the name should start with a latin alphapet letter)\n    \"\"\"\n    file_obj = FileName(file_name)\n    return file_obj.validate()", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [["\u00e9xample.exe"]]}], "HumanEval/142": [{"task_id": "HumanEval/142", "solution": "def sum_squares(lst):\n    \"\"\"\"\n    This function will take a list of integers. For all entries in the list, the function shall square the integer entry if its index is a \n    multiple of 3 and will cube the integer entry if its index is a multiple of 4 and not a multiple of 3. The function will not \n    change the entries in the list whose indexes are not a multiple of 3 or 4. The function shall then return the sum of all entries. \n    \n    Examples:\n    For lst = [1,2,3] the output should be 6\n    For lst = []  the output should be 0\n    For lst = [-1,-5,2,-1,-5]  the output should be -126\n    \"\"\"\n    total_sum = 0\n    for index, value in enumerate(lst):\n        if index % 3 == 0:\n            # If index is a multiple of 3, square the value.\n            total_sum += value ** 2\n        elif index % 4 == 0: # This condition implies index is not a multiple of 3 due to the prior 'if'.\n            # If index is a multiple of 4 and not a multiple of 3, cube the value.\n            total_sum += value ** 3\n        else:\n            # Otherwise, add the value as is.\n            total_sum += value\n    return total_sum", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/144": [{"task_id": "HumanEval/144", "solution": "import math\nclass Fraction:\n    \"\"\"Represents a mathematical fraction and provides arithmetic operations.\"\"\"\n    def __init__(self, numerator: int, denominator: int):\n        self._numerator = numerator\n        self._denominator = denominator\n        self._simplify()\n\n    @classmethod\n    def from_string(cls, fraction_string: str) -> 'Fraction':\n        \"\"\"Parses a string in '<numerator>/<denominator>' format into a Fraction object.\"\"\"\n        numerator_str, denominator_str = fraction_string.split('/')\n        return cls(int(numerator_str), int(denominator_str))\n\n    def _gcd(self, a: int, b: int) -> int:\n        \"\"\"Calculates the greatest common divisor of two numbers.\"\"\"\n        while b:\n            a, b = b, a % b\n        return a\n\n    def _simplify(self) -> None:\n        \"\"\"Reduces the fraction to its simplest form.\"\"\"\n        common_divisor = self._gcd(self._numerator, self._denominator)\n        self._numerator //= common_divisor\n        self._denominator //= common_divisor\n\n    def multiply(self, other_fraction: 'Fraction') -> 'Fraction':\n        \"\"\"Multiplies this fraction by another Fraction object.\"\"\"\n        new_numerator = self._numerator * other_fraction._numerator\n        new_denominator = self._denominator * other_fraction._denominator\n        return Fraction(new_numerator, new_denominator)\n\n    def is_whole_number(self) -> bool:\n        \"\"\"Determines if the fraction represents a whole number.\"\"\"\n        return self._denominator == 1\ndef simplify(x, n):\n    \"\"\"Your task is to implement a function that will simplify the expression\n    x * n. The function returns True if x * n evaluates to a whole number and False\n    otherwise. Both x and n, are string representation of a fraction, and have the following format,\n    <numerator>/<denominator> where both numerator and denominator are positive whole numbers.\n\n    You can assume that x, and n are valid fractions, and do not have zero as denominator.\n\n    simplify(\"1/5\", \"5/1\") = True\n    simplify(\"1/6\", \"2/1\") = False\n    simplify(\"7/10\", \"10/2\") = False\n    \"\"\"\n    fraction_x = Fraction.from_string(x)\n    fraction_n = Fraction.from_string(n)\n    product_fraction = fraction_x.multiply(fraction_n)\n    return product_fraction.is_whole_number()", "