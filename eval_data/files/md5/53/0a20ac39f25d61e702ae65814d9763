umanEval/94", "solution": "def skjkasdkd(lst):\n    \"\"\"You are given a list of integers.\n    You need to find the largest prime value and return the sum of its digits.\n    \"\"\"\n\n    def is_prime(n):\n        \"\"\"Checks if a number is prime.\"\"\"\n        if n < 2:\n            return False\n        i = 2\n        while i * i <= n:\n            if n % i == 0:\n                return False\n            i += 1\n        return True\n\n    def calculate_sum_of_digits(n):\n        \"\"\"Calculates the sum of the digits of a number.\"\"\"\n        s = 0\n        while n > 0:\n            s += n % 10\n            n //= 10\n        return s\n\n    largest_prime_found = -1\n\n    for num in lst:\n        if is_prime(num):\n            if num > largest_prime_found:\n                largest_prime_found = num\n\n    if largest_prime_found == -1:\n        return 0\n    else:\n        return calculate_sum_of_digits(largest_prime_found)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/130": [{"task_id": "HumanEval/130", "solution": "def tri(n):\n    \"\"\"Calculates the first n + 1 numbers of the Tribonacci sequence.\n    The sequence is defined with specific recurrence relations, including a forward dependency for odd terms.\n    \"\"\"\n    memo = {}\n    sequence = []\n\n    def _get_tribonacci_term(k):\n        \"\"\"Recursively calculates a single Tribonacci term tri(k) using memoization.\"\"\"\n        if k in memo:\n            return memo[k]\n\n        if k == 0:\n            value = 1.0\n        elif k == 1:\n            value = 3.0\n        elif k % 2 == 0:  # k is even and k > 0\n            value = 1.0 + k / 2.0\n        else:  # k is odd and k > 1\n            # This order resolves the forward dependency by ensuring tri(k+1) is computed and memoized.\n            value = _get_tribonacci_term(k - 1) + _get_tribonacci_term(k - 2) + _get_tribonacci_term(k + 1)\n        \n        memo[k] = value\n        return value\n\n    for i in range(n + 1):\n        sequence.append(_get_tribonacci_term(i))\n\n    return sequence", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/129": [{"task_id": "HumanEval/129", "solution": "from typing import List, Optional\nclass Cell:\n    \"\"\"Represents a single cell in the grid with its value and coordinates.\"\"\"\n    def __init__(self, value: int, row: int, col: int):\n        self._value = value\n        self._row = row\n        self._col = col\n\n    def get_value(self) -> int:\n        \"\"\"Returns the cell's value.\"\"\"\n        return self._value\n\n    def get_row(self) -> int:\n        \"\"\"Returns the cell's row coordinate.\"\"\"\n        return self._row\n\n    def get_col(self) -> int:\n        \"\"\"Returns the cell's column coordinate.\"\"\"\n        return self._col\nclass Grid:\n    \"\"\"Manages the 2D grid structure and provides access to cells and their neighbors.\"\"\"\n    def __init__(self, grid_data: List[List[int]]):\n        self._N = len(grid_data)\n        self._cells: List[List[Cell]] = [[\n            Cell(grid_data[r][c], r, c) for c in range(self._N)\n        ] for r in range(self._N)]\n\n    def get_N(self) -> int:\n        \"\"\"Returns the dimension N of the grid.\"\"\"\n        return self._N\n\n    def get_all_cells(self) -> List[Cell]:\n        \"\"\"Returns a flat list of all Cell objects in the grid.\"\"\"\n        all_cells = []\n        for r in range(self._N):\n            for c in range(self._N):\n                all_cells.append(self._cells[r][c])\n        return all_cells\n\n    def get_neighbors(self, cell: Cell) -> List[Cell]:\n        \"\"\"Returns a list of valid adjacent Cell objects for a given cell.\"\"\"\n        neighbors = []\n        row, col = cell.get_row(), cell.get_col()\n        delta_coords = [(-1, 0), (1, 0), (0, -1), (0, 1)] # Up, Down, Left, Right\n\n        for dr, dc in delta_coords:\n            new_row, new_col = row + dr, col + dc\n            if self.is_valid_coord(new_row, new_col):\n                neighbors.append(self._cells[new_row][new_col])\n        return neighbors\n\n    def is_valid_coord(self, row: int, col: int) -> bool:\n        \"\"\"Checks if a given (row, col) coordinate is within grid boundaries.\"\"\"\n        return 0 <= row < self._N and 0 <= col < self._N\nclass Path:\n    \"\"\"Represents an ordered sequence of cells forming a path and provides lexicographical comparison.\"\"\"\n    def __init__(self, initial_cell: Optional[Cell] = None, cells_list: Optional[List[Cell]] = None):\n        if cells_list is not None:\n            self._visited_cells = list(cells_list)\n        elif initial_cell is not None:\n            self._visited_cells = [initial_cell]\n        else:\n            self._visited_cells = []\n\n    def add_cell(self, cell: Cell) -> None:\n        \"\"\"Appends a cell to the path.\"\"\"\n        self._visited_cells.append(cell)\n\n    def remove_last_cell(self) -> None:\n        \"\"\"Removes the last cell added to the path (for backtracking).\"\"\"\n        if self._visited_cells:\n            self._visited_cells.pop()\n\n    def get_values(self) -> List[int]:\n        \"\"\"Returns an ordered list of integer values of cells in the path.\"\"\"\n        return [cell.get_value() for cell in self._visited_cells]\n\n    def get_length(self) -> int:\n        \"\"\"Returns the current length of the path.\"\"\"\n        return len(self._visited_cells)\n\n    def is_lexicographically_less_than(self, other_path: 'Path') -> bool:\n        \"\"\"Compares this path with another path lexicographically.\"\"\"\n        self_values = self.get_values()\n        other_values = other_path.get_values()\n        return self_values < other_values\n\n    def __lt__(self, other: 'Path') -> bool:\n        \"\"\"Enables Python's built-in comparison operators for Path objects.\"\"\"\n        return self.is_lexicographically_less_than(other)\ndef _dfs(current_cell: Cell, current_path: Path, remaining_k: int, grid_obj: Grid, min_path_ref: List[Optional[Path]]) -> None:\n    \"\"\"Recursive helper for depth-first search to build paths and update the minimum path found so far.\"\"\"\n    if remaining_k == 0:\n        if min_path_ref[0] is None or current_path < min_path_ref[0]:\n            min_path_ref[0] = Path(cells_list=current_path._visited_cells)\n        return\n\n    for neighbor_cell in grid_obj.get_neighbors(current_cell):\n        current_path.add_cell(neighbor_cell)\n        _dfs(neighbor_cell, current_path, remaining_k - 1, grid_obj, min_path_ref)\n        current_path.remove_last_cell() # Backtrack\ndef find_minimum_path(grid_obj: Grid, k: int) -> Optional[Path]:\n    \"\"\"Implements the recursive backtracking algorithm to explore all paths and find the lexicographically smallest one.\"\"\"\n    min_path_ref: List[Optional[Path]] = [None]\n\n    for start_cell in grid_obj.get_all_cells():\n        initial_path = Path(initial_cell=start_cell)\n        _dfs(start_cell, initial_path, k - 1, grid_obj, min_path_ref)\n\n    return min_path_ref[0]\ndef minPath(grid: List[List[int]], k: int) -> List[int]:\n    \"\"\"\n    Given a grid with N rows and N columns (N >= 2) and a positive integer k, \n    each cell of the grid contains a value. Every integer in the range [1, N * N]\n    inclusive appears exactly once on the cells of the grid.\n\n    You have to find the minimum path of length k in the grid. You can start\n    from any cell, and in each step you can move to any of the neighbor cells,\n    in other words, you can go to cells which share an edge with you current\n    cell.\n    Please note that a path of length k means visiting exactly k cells (not\n    necessarily distinct).\n    You CANNOT go off the grid.\n    A path A (of length k) is considered less than a path B (of length k) if\n    after making the ordered lists of the values on the cells that A and B go\n    through (let's call them lst_A and lst_B), lst_A is lexicographically less\n    than lst_B, in other words, there exist an integer index i (1 <= i <= k)\n    such that lst_A[i] < lst_B[i] and for any j (1 <= j < i) we have\n    lst_A[j] = lst_B[j].\n    It is guaranteed that the answer is unique.\n    Return an ordered list of the values on the cells that the minimum path go through.\n\n    Examples:\n\n        Input: grid = [ [1,2,3], [4,5,6], [7,8,9]], k = 3\n        Output: [1, 2, 1]\n\n        Input: grid = [ [5,9,3], [4,1,6], [7,8,2]], k = 1\n        Output: [1]\n    \"\"\"\n    grid_obj = Grid(grid)\n    min_path_obj = find_minimum_path(grid_obj, k)\n    \n    if min_path_obj:\n        return min_path_obj.get_values()\n    else:\n        return [] # Should not be reached given problem constraints (answer is unique)", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[[[12, 13, 10, 1], [9, 3, 15, 6], [5, 16, 14, 4], [11, 8, 7, 2]], 12]], "plus_fail_tests": [[[[1, 2, 3], [4, 5, 6], [7, 8, 9]], 15]]}], "HumanEval/139": [{"task_id": "HumanEval/139", "solution": "def _factorial(k):\n    \"\"\"Calculates the standard factorial of a non-negative integer k.\"\"\"\n    if k == 0:\n        return 1\n    res = 1\n    for i in range(1, k + 1):\n        res *= i\n    return res\ndef special_factorial(n):\n    \"\"\"The Brazilian factorial is defined as:\n    brazilian_factorial(n) = n! * (n-1)! * (n-2)! * ... * 1!\n    where n > 0\n\n    For example:\n    >>> special_factorial(4)\n    288\n\n    The function will receive an integer as input and should return the special\n    factorial of this integer.\n    \"\"\"\n    if n <= 0:\n        raise ValueError(\"Input n must be a positive integer (n > 0).\")\n\n    special_fact_result = 1\n    for i in range(1, n + 1):\n        special_fact_result *= _factorial(i)\n\n    return special_fact_result", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/147": [{"task_id": "HumanEval/147", "solution": "import itertools\ndef get_max_triples(n):\n    \"\"\"\n    You are given a positive integer n. You have to create an integer array a of length n.\n        For each i (1 \u2264 i \u2264 n), the value of a[i] = i * i - i + 1.\n        Return the number of triples (a[i], a[j], a[k]) of a where i < j < k, \n    and a[i] + a[j] + a[k] is a multiple of 3.\n    \"\"\"\n    class Element:\n        def __init__(self, index: int, value: int):\n            self.index = index\n            self.value = value\n\n    class Triple:\n        def __init__(self, e1: Element, e2: Element, e3: Element):\n            self.element1 = e1\n            self.element2 = e2\n            self.element3 = e3\n            self.sum = e1.value + e2.value + e3.value\n            self.is_multiple_of_3 = (self.sum % 3 == 0)\n\n    def generate_array_local(n_val: int) -> list:\n        elements = []\n        for i in range(1, n_val + 1):\n            value = i * i - i + 1\n            elements.append(Element(index=i, value=value))\n        return elements\n\n    def find_triples_local(elements_list: list) -> list:\n        triples = []\n        for e1, e2, e3 in itertools.combinations(elements_list, 3):\n            triples.append(Triple(e1, e2, e3))\n        return triples\n\n    elements = generate_array_local(n)\n    triples = find_triples_local(elements)\n\n    valid_triples_count = 0\n    for triple in triples:\n        if triple.is_multiple_of_3:\n            valid_triples_count += 1\n    return valid_triples_count", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}]}}