rn False\n        \n        max_days = self._month.get_max_days()\n        if not self._day.is_valid(max_days):\n            return False\n            \n        return True\nclass DateString:\n    \"\"\"Encapsulates the raw date string and provides methods for basic string validations and parsing.\"\"\"\n    def __init__(self, value: str):\n        self._value = value\n\n    def is_empty(self) -> bool:\n        \"\"\"Checks if the date string is empty.\"\"\"\n        return not self._value\n\n    def matches_format(self, format_regex: str) -> bool:\n        \"\"\"Checks if the string matches the 'mm-dd-yyyy' format.\"\"\"\n        return bool(re.fullmatch(format_regex, self._value))\n\n    def parse_components(self) -> DateComponents:\n        \"\"\"Parses the string into month, day, year components and returns a DateComponents object.\"\"\"\n        parts = self._value.split('-')\n        month = int(parts[0])\n        day = int(parts[1])\n        year = int(parts[2])\n        return DateComponents(month, day, year)\nclass DateValidator:\n    \"\"\"Orchestrates the sequence of validation steps using domain objects.\"\"\"\n    def validate(self, date_string_value: str) -> bool:\n        \"\"\"Performs comprehensive validation on the date string.\"\"\"\n        date_str_obj = DateString(date_string_value)\n\n        if date_str_obj.is_empty():\n            return False\n        \n        DATE_FORMAT_REGEX = r\"^\\d{2}-\\d{2}-\\d{4}$\"\n        if not date_str_obj.matches_format(DATE_FORMAT_REGEX):\n            return False\n        \n        date_components = date_str_obj.parse_components()\n        \n        return date_components.is_valid()\ndef valid_date(date):\n    \"\"\"You have to write a function which validates a given date string and\n    returns True if the date is valid otherwise False.\n    The date is valid if all of the following rules are satisfied:\n    1. The date string is not empty.\n    2. The number of days is not less than 1 or higher than 31 days for months 1,3,5,7,8,10,12. And the number of days is not less than 1 or higher than 30 days for months 4,6,9,11. And, the number of days is not less than 1 or higher than 29 for the month 2.\n    3. The months should not be less than 1 or higher than 12.\n    4. The date should be in the format: mm-dd-yyyy\n\n    for example: \n    valid_date('03-11-2000') => True\n\n    valid_date('15-01-2012') => False\n\n    valid_date('04-0-2040') => False\n\n    valid_date('06-04-2020') => True\n\n    valid_date('06/04/2020') => False\n    \"\"\"\n    validator = DateValidator()\n    return validator.validate(date)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/125": [{"task_id": "HumanEval/125", "solution": "from typing import List, Union\ndef split_words(txt: str) -> Union[List[str], int]:\n    '''\n    Given a string of words, return a list of words split on whitespace, if no whitespaces exists in the text you\n    should split on commas ',' if no commas exists you should return the number of lower-case letters with odd order in the\n    alphabet, ord('a') = 0, ord('b') = 1, ... ord('z') = 25\n    Examples\n    split_words(\"Hello world!\") \u279e [\"Hello\", \"world!\"]\n    split_words(\"Hello,world!\") \u279e [\"Hello\", \"world!\"]\n    split_words(\"abcdef\") == 3\n    '''\n\n    def _has_whitespace(text: str) -> bool:\n        \"\"\"Checks if the string contains any whitespace characters.\"\"\"\n        return any(c.isspace() for c in text)\n\n    def _has_comma(text: str) -> bool:\n        \"\"\"Checks if the string contains any comma characters.\"\"\"\n        return ',' in text\n\n    def _split_by_whitespace(text: str) -> List[str]:\n        \"\"\"Splits the string by whitespace characters.\"\"\"\n        return text.split()\n\n    def _split_by_comma(text: str) -> List[str]:\n        \"\"\"Splits the string by comma characters.\"\"\"\n        return text.split(',')\n\n    def _count_odd_ordered_lowercase_letters(text: str) -> int:\n        \"\"\"Counts lowercase letters with odd 0-indexed alphabetical positions.\"\"\"\n        count = 0\n        for char in text:\n            if 'a' <= char <= 'z':\n                order = ord(char) - ord('a')\n                if order % 2 != 0:\n                    count += 1\n        return count\n\n    if _has_whitespace(txt):\n        return _split_by_whitespace(txt)\n    elif _has_comma(txt):\n        return _split_by_comma(txt)\n    else:\n        return _count_odd_ordered_lowercase_letters(txt)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/126": [{"task_id": "HumanEval/126", "solution": "import collections\ndef is_sorted(lst):\n    '''\n    Given a list of numbers, return whether or not they are sorted\n    in ascending order. If list has more than 1 duplicate of the same\n    number, return False. Assume no negative numbers and only integers.\n    '''\n    # Check if the list is sorted in ascending order.\n    if len(lst) <= 1:\n        return True\n    \n    for i in range(len(lst) - 1):\n        if lst[i] > lst[i+1]:\n            return False\n\n    # Check if any number appears more than twice.\n    counts = collections.Counter(lst)\n    for count in counts.values():\n        if count > 2:\n            return False\n            \n    return True", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/131": [{"task_id": "HumanEval/131", "solution": "def digits(n):\n    \"\"\"Given a positive integer n, return the product of the odd digits.\n    Return 0 if all digits are even.\n    For example:\n    digits(1)  == 1\n    digits(4)  == 0\n    digits(235) == 15\n    \"\"\"\n\n    def _extract_digits_list(number):\n        # Extracts individual digits from a number as a list.\n        return [int(d) for d in str(number)]\n\n    def _is_odd(digit_val):\n        # Checks if a digit is odd.\n        return digit_val % 2 != 0\n\n    def _calculate_product(digit_list):\n        # Calculates the product of a list of integers.\n        product = 1\n        for digit in digit_list:\n            product *= digit\n        return product\n\n    # Extract all digits from n\n    all_digits = _extract_digits_list(n)\n\n    # Filter out odd digits\n    odd_digits = [d for d in all_digits if _is_odd(d)]\n\n    # If no odd digits are found, return 0\n    if not odd_digits:\n        return 0\n    \n    # Calculate and return the product of odd digits\n    return _calculate_product(odd_digits)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/127": [{"task_id": "HumanEval/127", "solution": "import math\ndef intersection(interval1, interval2):\n    \"\"\"Determines whether the length of intersection of two intervals is a prime number.\"\"\"\n\n    def _calculate_intersection_interval(interval1, interval2):\n        \"\"\"Calculates the intersecting interval of two given intervals.\"\"\"\n        start1, end1 = interval1\n        start2, end2 = interval2\n\n        intersect_start = max(start1, start2)\n        intersect_end = min(end1, end2)\n\n        if intersect_start <= intersect_end:\n            return (intersect_start, intersect_end)\n        else:\n            return None\n\n    def _calculate_length(interval):\n        \"\"\"Determines the length of a given closed interval.\"\"\"\n        start, end = interval\n        return end - start + 1\n\n    def _is_prime(number):\n        \"\"\"Checks if a given integer is a prime number.\"\"\"\n        if number <= 1:\n            return False\n        if number == 2:\n            return True\n        if number % 2 == 0:\n            return False\n        \n        i = 3\n        while i * i <= number:\n            if number % i == 0:\n                return False\n            i += 2\n        return True\n\n    intersecting_interval = _calculate_intersection_interval(interval1, interval2)\n\n    if intersecting_interval is None:\n        return \"NO\"\n    else:\n        length = _calculate_length(intersecting_interval)\n        if _is_prime(length):\n            return \"YES\"\n        else:\n            return \"NO\"", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[[-1, 1], [0, 4]]], "plus_fail_tests": [[[10, 20], [15, 25]]]}], "HumanEval/128": [{"task_id": "HumanEval/128", "solution": "def _calculate_sign(number):\n    \"\"\"Returns 1 for positive, -1 for negative, and 0 for zero.\"\"\"\n    if number > 0:\n        return 1\n    elif number < 0:\n        return -1\n    else:\n        return 0\ndef _calculate_magnitude(number):\n    \"\"\"Returns the absolute value of the number.\"\"\"\n    return abs(number)\ndef prod_signs(arr):\n    \"\"\"\n    You are given an array arr of integers and you need to return\n    sum of magnitudes of integers multiplied by product of all signs\n    of each number in the array, represented by 1, -1 or 0.\n    Note: return None for empty arr.\n    \"\"\"\n    if not arr:\n        return None\n\n    sign_product = 1\n    magnitudes_sum = 0\n\n    for number in arr:\n        sign_product *= _calculate_sign(number)\n        magnitudes_sum += _calculate_magnitude(number)\n\n    return sign_product * magnitudes_sum", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/132": [{"task_id": "HumanEval/132", "solution": "def is_nested(string):\n    '''\n    Create a function that takes a string as input which contains only square brackets.\n    The function should return True if and only if there is a valid subsequence of brackets \n    where at least one bracket in the subsequence is nested.\n    '''\n    # The simplest form of a valid nested subsequence with depth > 1 is '[[]]'.\n    # If such a subsequence exists, the function should return True.\n\n    idx1 = -1\n    idx2 = -1\n    idx3 = -1\n    idx4 = -1\n\n    # Find the first '['\n    for i in