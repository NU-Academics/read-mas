{"task_id": "HumanEval/47", "solution": "def median(l: list):\n    \"\"\"Return median of elements in the list l.\n    >>> median([3, 1, 2, 4, 5])\n    3\n    >>> median([-10, 4, 6, 1000, 10, 20])\n    15.0\n    \"\"\"\n    sorted_l = sorted(l)\n    n = len(sorted_l)\n    \n    if n % 2 == 1:\n        # Odd number of elements, return the middle element\n        return sorted_l[n // 2]\n    else:\n        # Even number of elements, return the average of the two middle elements\n        mid1 = sorted_l[n // 2 - 1]\n        mid2 = sorted_l[n // 2]\n        result = (mid1 + mid2) / 2.0\n        # Convert to int if the result is a whole number\n        return int(result) if result == int(result) else result"}
{"task_id": "HumanEval/46", "solution": "def fib4(n: int):\n    \"\"\"Computes the n-th element of the fib4 number sequence iteratively.\n    Handles base cases and then calculates subsequent values by summing the previous four.\n    \"\"\"\n    if n == 0:\n        return 0\n    if n == 1:\n        return 0\n    if n == 2:\n        return 2\n    if n == 3:\n        return 0\n\n    # Initialize the four previous values needed for the calculation:\n    # f_n_minus_4, f_n_minus_3, f_n_minus_2, f_n_minus_1\n    a, b, c, d = 0, 0, 2, 0 # Corresponds to fib4(0), fib4(1), fib4(2), fib4(3)\n\n    for i in range(4, n + 1):\n        next_fib = a + b + c + d\n        # Shift values for the next iteration\n        a = b\n        b = c\n        c = d\n        d = next_fib\n    \n    return d"}
{"task_id": "HumanEval/49", "solution": "def modp(n: int, p: int):\n    \"\"\"Return 2^n modulo p using modular exponentiation by squaring to prevent overflow.\"\"\"\n    result = 1\n    base = 2\n    \n    # Ensure base is within the modulo range from the start\n    base %= p\n\n    while n > 0:\n        # If n is odd, multiply result with base\n        if n % 2 == 1:\n            result = (result * base) % p\n        \n        # Square the base and take modulo\n        base = (base * base) % p\n        \n        # Divide n by 2\n        n //= 2\n        \n    return result"}
