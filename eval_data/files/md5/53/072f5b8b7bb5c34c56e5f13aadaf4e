{"task_id": "HumanEval/39", "solution": "import math\nclass FibonacciSequenceGenerator:\n    \"\"\"Generates Fibonacci numbers iteratively.\"\"\"\n    def __init__(self):\n        self._a = 0\n        self._b = 1\n\n    def generate_next(self) -> int:\n        \"\"\"Calculates and returns the next Fibonacci number in the sequence.\"\"\"\n        next_fib = self._a + self._b\n        self._a = self._b\n        self._b = next_fib\n        return next_fib\nclass PrimalityTest:\n    \"\"\"Provides a method to check if a given integer is prime.\"\"\"\n    def is_prime(self, num: int) -> bool:\n        \"\"\"Checks if num is a prime number.\"\"\"\n        if num < 2:\n            return False\n        if num == 2:\n            return True\n        if num % 2 == 0:\n            return False\n        # Only check odd divisors up to the square root\n        i = 3\n        while i * i <= num:\n            if num % i == 0:\n                return False\n            i += 2\n        return True\nclass PrimeFibonacciFinder:\n    \"\"\"Finds the n-th number that is both a Fibonacci number and a prime number.\"\"\"\n    def __init__(self, fib_generator: FibonacciSequenceGenerator, primality_tester: PrimalityTest):\n        self._fib_generator = fib_generator\n        self._primality_tester = primality_tester\n\n    def find_nth(self, n: int) -> int:\n        \"\"\"Finds and returns the n-th prime Fibonacci number.\"\"\"\n        prime_count = 0\n        while True:\n            fib_num = self._fib_generator.generate_next()\n            if self._primality_tester.is_prime(fib_num):\n                prime_count += 1\n                if prime_count == n:\n                    return fib_num\ndef prime_fib(n: int):\n    \"\"\"\n    prime_fib returns n-th number that is a Fibonacci number and it's also prime.\n    >>> prime_fib(1)\n    2\n    >>> prime_fib(2)\n    3\n    >>> prime_fib(3)\n    5\n    >>> prime_fib(4)\n    13\n    >>> prime_fib(5)\n    89\n    \"\"\"\n    fib_generator = FibonacciSequenceGenerator()\n    primality_tester = PrimalityTest()\n    finder = PrimeFibonacciFinder(fib_generator, primality_tester)\n    return finder.find_nth(n)"}
{"task_id": "HumanEval/36", "solution": "def _is_divisible_by(number: int, divisor: int) -> bool:\n    \"\"\"Checks if a number is perfectly divisible by a given divisor.\"\"\"\n    return number % divisor == 0\ndef _count_digit_occurrences(number: int, digit: int) -> int:\n    \"\"\"Counts the occurrences of a specific digit in the decimal representation of a number.\"\"\"\n    count = 0\n    abs_number = abs(number)\n    if abs_number == 0 and digit == 0:\n        return 1\n    while abs_number > 0:\n        if abs_number % 10 == digit:\n            count += 1\n        abs_number //= 10\n    return count\ndef fizz_buzz(n: int):\n    \"\"\"Return the number of times the digit 7 appears in integers less than n which are divisible by 11 or 13.\n    >>> fizz_buzz(50)\n    0\n    >>> fizz_buzz(78)\n    2\n    >>> fizz_buzz(79)\n    3\n    \"\"\"\n    total_count_of_7s = 0\n\n    for i in range(1, n):\n        if _is_divisible_by(i, 11) or _is_divisible_by(i, 13):\n            total_count_of_7s += _count_digit_occurrences(i, 7)\n\n    return total_count_of_7s"}
{"task_id": "HumanEval/37", "solution": "def sort_even(l: list):\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the odd indicies, while its values at the even indicies are equal\n    to the values of the even indicies of l, but sorted.\n    >>> sort_even([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_even([5, 6, 3, 4])\n    [3, 6, 5, 4]\n    \"\"\"\n    if not l:\n        return []\n\n    even_elements = []\n    for i in range(len(l)):\n        if i % 2 == 0:\n            even_elements.append(l[i])\n    \n    even_elements.sort()\n    \n    result = list(l) # Create a copy of the original list\n    even_idx_counter = 0\n    for i in range(len(result)):\n        if i % 2 == 0:\n            result[i] = even_elements[even_idx_counter]\n            even_idx_counter += 1\n            \n    return result"}
{"task_id": "HumanEval/38", "solution": "def decode_cyclic(s: str):\n    \"\"\"\n    takes as input string encoded with encode_cyclic function. Returns decoded string.\n    \"\"\"\n    # split string to groups. Each of length 3.\n    groups = [s[(3 * i):min((3 * i + 3), len(s))] for i in range((len(s) + 2) // 3)]\n    # reverse cycle elements in each group. Unless group has fewer elements than 3.\n    groups = [(group[-1] + group[:-1]) if len(group) == 3 else group for group in groups]\n    return \"\".join(groups)"}
{"task_id": "HumanEval/40", "solution": "def triples_sum_to_zero(l: list):\n    \"\"\"\n    triples_sum_to_zero takes a list of integers as an input.\n    it returns True if there are three distinct elements in the list that\n    sum to zero, and False otherwise.\n    \"\"\"\n    n = len(l)\n    if n < 3:\n        return False\n\n    # Iterate through all possible combinations of three distinct elements\n    for i in range(n):\n        for j in range(i + 1, n):  # Ensure j > i for distinct elements\n            for k in range(j + 1, n):  # Ensure k > j for distinct elements\n                if l[i] + l[j] + l[k] == 0:\n                    return True\n    return False"}
