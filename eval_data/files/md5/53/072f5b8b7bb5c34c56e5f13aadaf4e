{"task_id": "HumanEval/117", "solution": "def select_words(s, n):\n    \"\"\"Given a string s and a natural number n, you have been tasked to implement \n    a function that returns a list of all words from string s that contain exactly \n    n consonants, in order these words appear in the string s.\n    If the string s is empty then the function should return an empty list.\n    \"\"\"\n    if not s:\n        return []\n\n    VOWELS = \"aeiouAEIOU\"\n\n    def _is_vowel(char):\n        \"\"\"Checks if a character is a vowel (case-insensitive).\"\"\"\n        return char in VOWELS\n\n    def _count_consonants(word):\n        \"\"\"Counts consonants in a word using the _is_vowel helper.\"\"\"\n        count = 0\n        for char in word:\n            if 'a' <= char.lower() <= 'z' and not _is_vowel(char):\n                count += 1\n        return count\n\n    result = []\n    words = s.split()\n    for word in words:\n        if _count_consonants(word) == n:\n            result.append(word)\n\n    return result"}
{"task_id": "HumanEval/120", "solution": "import heapq\ndef maximum(arr, k):\n    \"\"\"\n    Given an array arr of integers and a positive integer k, return a sorted list\n    of length k with the maximum k numbers in arr.\n    \"\"\"\n    if k == 0:\n        return []\n\n    min_heap = []\n    for num in arr:\n        if len(min_heap) < k:\n            heapq.heappush(min_heap, num)\n        elif num > min_heap[0]:\n            heapq.heapreplace(min_heap, num)\n\n    min_heap.sort()\n    return min_heap"}
{"task_id": "HumanEval/116", "solution": "def sort_array(arr):\n    \"\"\"\n    In this Kata, you have to sort an array of non-negative integers according to\n    number of ones in their binary representation in ascending order.\n    For similar number of ones, sort based on decimal value.\n    \"\"\"\n\n    def _count_set_bits(n: int) -> int:\n        \"\"\"Counts the number of set bits (ones) in the binary representation of a non-negative integer.\"\"\"\n        return bin(n).count('1')\n\n    def _is_all_negative(arr: list[int]) -> bool:\n        \"\"\"Determines if all elements in the input array are negative.\"\"\"\n        return all(x < 0 for x in arr)\n\n    if not arr:\n        return []\n\n    if _is_all_negative(arr):\n        # If all elements are negative, sort by decimal value in ascending order.\n        return sorted(arr)\n    else:\n        # Otherwise, sort by number of set bits (of absolute value) then by decimal value.\n        return sorted(arr, key=lambda x: (_count_set_bits(abs(x)), x))"}
{"task_id": "HumanEval/121", "solution": "class IntegerList:\n    \"\"\"Manages the input list, ensuring validity and providing structured access to elements.\"\"\"\n    def __init__(self, raw_list: list):\n        self._elements = []\n        for i, val in enumerate(raw_list):\n            self._elements.append(IntegerElement(val, i))\n\n    def length(self) -> int:\n        return len(self._elements)\n\n    def get_element_at(self, index: int):\n        return self._elements[index]\n\n    def validate_non_empty(self) -> None:\n        if not self._elements:\n            raise ValueError(\"Input list cannot be empty.\")\n\n    def validate_all_integers(self) -> None:\n        for element in self._elements:\n            if not isinstance(element.value, int):\n                raise TypeError(\"All elements in the list must be integers.\")\nclass IntegerElement:\n    \"\"\"Represents an individual integer value along with its 0-indexed position.\"\"\"\n    def __init__(self, value: int, position: int):\n        self.value = value\n        self.position = position\n\n    def is_odd(self) -> bool:\n        return self.value % 2 != 0\n\n    def is_even_position(self) -> bool:\n        return self.position % 2 == 0\nclass CalculatedSum:\n    \"\"\"Aggregates and stores the sum of eligible elements.\"\"\"\n    def __init__(self):\n        self._total = 0\n\n    def add(self, value: int) -> None:\n        self._total += value\n\n    def get_total(self) -> int:\n        return self._total\ndef solution(lst):\n    \"\"\"Given a non-empty list of integers, return the sum of all of the odd elements that are in even positions.\n    \"\"\"\n    integer_list = IntegerList(lst)\n    integer_list.validate_non_empty()\n    integer_list.validate_all_integers()\n\n    calculated_sum = CalculatedSum()\n\n    for i in range(integer_list.length()):\n        element = integer_list.get_element_at(i)\n        if element.is_even_position() and element.is_odd():\n            calculated_sum.add(element.value)\n\n    return calculated_sum.get_total()"}
{"task_id": "HumanEval/125", "solution": "from typing import List, Union\ndef _has_whitespace(text: str) -> bool:\n    \"\"\"Checks if the input string contains any whitespace characters.\"\"\"\n    return any(char.isspace() for char in text)\ndef _has_comma(text: str) -> bool:\n    \"\"\"Checks if the input string contains any comma characters.\"\"\"\n    return ',' in text\ndef _split_by_whitespace(text: str) -> List[str]:\n    \"\"\"Splits the input string into a list of words using whitespace as the delimiter.\"\"\"\n    return text.split()\ndef _split_by_comma(text: str) -> List[str]:\n    \"\"\"Splits the input string into a list of words using commas as the delimiter.\"\"\"\n    return text.split(',')\ndef _is_lowercase(char: str) -> bool:\n    \"\"\"Determines if a given character is a lowercase letter.\"\"\"\n    return 'a' <= char <= 'z'\ndef _get_ordinal_value(char: str) -> int:\n    \"\"\"Calculates the 0-indexed ordinal value of a lowercase letter.\"\"\"\n    return ord(char) - ord('a')\ndef _is_odd_ordinal(ordinal: int) -> bool:\n    \"\"\"Checks if an ordinal value is odd.\"\"\"\n    return ordinal % 2 != 0\ndef _count_odd_ordinal_lowercase_letters(text: str) -> int:\n    \"\"\"Counts lowercase letters with odd 0-indexed ordinal values in the alphabet.\"\"\"\n    count = 0\n    for char in text:\n        if _is_lowercase(char) and _is_odd_ordinal(_get_ordinal_value(char)):\n            count += 1\n    return count\ndef split_words(txt: str) -> Union[List[str], int]:\n    '''\n    Given a string of words, return a list of words split on whitespace, if no whitespaces exists in the text you\n    should split on commas ',' if no commas exists you should return the number of lower-case letters with odd order in the\n    alphabet, ord('a') = 0, ord('b') = 1, ... ord('z') = 25\n    Examples\n    split_words(\"Hello world!\") \u279e [\"Hello\", \"world!\"]\n    split_words(\"Hello,world!\") \u279e [\"Hello\", \"world!\"]\n    split_words(\"abcdef\") == 3 \n    '''\n    if _has_whitespace(txt):\n        return _split_by_whitespace(txt)\n    elif _has_comma(txt):\n        return _split_by_comma(txt)\n    else:\n        return _count_odd_ordinal_lowercase_letters(txt)"}
{"task_id": "HumanEval/127", "solution": "import math\nclass Interval:\n    def __init__(self, start: int, end: int):\n        self.start = start\n        self.end = end\ndef is_prime(n: int) -> bool:\n    \"\"\"\n    Determines if a given integer n is a prime number.\n    \"\"\"\n    if n <= 1:\n        return False\n    if n <= 3:\n        return True\n    if n % 2 == 0 or n % 3 == 0:\n        return False\n    i = 5\n    while i * i <= n:\n        if n % i == 0 or n % (i + 2) == 0:\n            return False\n        i += 6\n    return True\ndef intersection(interval1, interval2):\n    \"\"\"You are given two intervals,\n    where each interval is a pair of integers. For example, interval = (start, end) = (1, 2).\n    The given intervals are closed which means that the interval (start, end)\n    includes both start and end.\n    For each given interval, it is assumed that its start is less or equal its end.\n    Your task is to determine whether the length of intersection of these two \n    intervals is a prime number.\n    Example, the intersection of the intervals (1, 3), (2, 4) is (2, 3)\n    which its length is 1, which not a prime number.\n    If the length of the intersection is a prime number, return \"YES\",\n    otherwise, return \"NO\".\n    If the two intervals don't intersect, return \"NO\".\n\n\n    [input/output] samples:\n    intersection((1, 2), (2, 3)) ==> \"NO\"\n    intersection((-1, 1), (0, 4)) ==> \"NO\"\n    intersection((-3, -1), (-5, 5)) ==> \"YES\"\n    \"\"\"\n    int1_obj = Interval(interval1[0], interval1[1])\n    int2_obj = Interval(interval2[0], interval2[1])\n\n    intersection_start = max(int1_obj.start, int2_obj.start)\n    intersection_end = min(int1_obj.end, int2_obj.end)\n\n    if intersection_start > intersection_end:\n        return \"NO\"\n\n    intersection_length = intersection_end - intersection_start\n\n    is_len_prime = is_prime(intersection_length)\n\n    if is_len_prime:\n        return \"YES\"\n    else:\n        return \"NO\""}
{"task_id": "HumanEval/124", "solution": "def valid_date(date):\n    \"\"\"Validates a given date string according to specific rules and format mm-dd-yyyy.\"\"\"\n    if not date:\n        return False\n\n    parts = date.split('-')\n\n    if len(parts) != 3:\n        return False\n\n    try:\n        month_str, day_str, year_str = parts\n        \n        if not (len(month_str) == 2 and len(day_str) == 2 and len(year_str) == 4):\n            return False\n\n        month = int(month_str)\n        day = int(day_str)\n        year = int(year_str) # year is not explicitly validated beyond format, but parsed\n    except ValueError:\n        return False\n\n    if not (1 <= month <= 12):\n        return False\n\n    # Months with 31 days\n    if month in {1, 3, 5, 7, 8, 10, 12}:\n        if not (1 <= day <= 31):\n            return False\n    # Months with 30 days\n    elif month in {4, 6, 9, 11}:\n        if not (1 <= day <= 30):\n            return False\n    # February\n    elif month == 2:\n        if not (1 <= day <= 29): # No leap year consideration, max 29 as per rule 2\n            return False\n    else:\n        # This case should technically be covered by month validation, but as a safeguard.\n        return False\n\n    return True"}
{"task_id": "HumanEval/126", "solution": "from collections import Counter\ndef _check_ascending_order(lst):\n    \"\"\"\n    Checks if a list is sorted in ascending order (allowing duplicates).\n    Handles empty or single-element lists as sorted.\n    \"\"\"\n    if not lst or len(lst) == 1:\n        return True\n    for i in range(len(lst) - 1):\n        if lst[i] > lst[i+1]:\n            return False\n    return True\ndef _check_excessive_duplicates(lst):\n    \"\"\"\n    Checks if any number in the list occurs three or more times.\n    Uses Counter to efficiently count occurrences.\n    \"\"\"\n    if not lst:\n        return False\n    counts = Counter(lst)\n    for count in counts.values():\n        if count >= 3:\n            return True\n    return False\ndef is_sorted(lst):\n    '''\n    Given a list of numbers, return whether or not they are sorted\n    in ascending order. If list has more than 1 duplicate of the same\n    number, return False. Assume no negative numbers and only integers.\n\n    Examples\n    is_sorted([5]) \u279e True\n    is_sorted([1, 2, 3, 4, 5]) \u279e True\n    is_sorted([1, 3, 2, 4, 5]) \u279e False\n    is_sorted([1, 2, 3, 4, 5, 6]) \u279e True\n    is_sorted([1, 2, 3, 4, 5, 6, 7]) \u279e True\n    is_sorted([1, 3, 2, 4, 5, 6, 7]) \u279e False\n    is_sorted([1, 2, 2, 3, 3, 4]) \u279e True\n    is_sorted([1, 2, 2, 2, 3, 4]) \u279e False\n    '''\n    if not _check_ascending_order(lst):\n        return False\n\n    if _check_excessive_duplicates(lst):\n        return False\n\n    return True"}
{"task_id": "HumanEval/123", "solution": "def get_odd_collatz(n):\n    \"\"\"\n    Given a positive integer n, return a sorted list that has the odd numbers in collatz sequence.\n\n    The Collatz conjecture is a conjecture in mathematics that concerns a sequence defined\n    as follows: start with any positive integer n. Then each term is obtained from the \n    previous term as follows: if the previous term is even, the next term is one half of \n    the previous term. If the previous term is odd, the next term is 3 times the previous\n    term plus 1. The conjecture is that no matter what value of n, the sequence will always reach 1.\n\n    Note: \n        1. Collatz(1) is [1].\n        2. returned list sorted in increasing order.\n\n    For example:\n    get_odd_collatz(5) returns [1, 5] # The collatz sequence for 5 is [5, 16, 8, 4, 2, 1], so the odd numbers are only 1, and 5.\n    \"\"\"\n    def _is_odd(number):\n        return number % 2 != 0\n\n    def _is_even(number):\n        return number % 2 == 0\n\n    def _divide_by_two(number):\n        return number // 2\n\n    def _multiply_by_three_and_add_one(number):\n        return (3 * number) + 1\n\n    def _generate_collatz_sequence(current_n):\n        sequence = [current_n]\n        while current_n != 1:\n            if _is_even(current_n):\n                current_n = _divide_by_two(current_n)\n            else:\n                current_n = _multiply_by_three_and_add_one(current_n)\n            sequence.append(current_n)\n        return sequence\n\n    collatz_sequence = _generate_collatz_sequence(n)\n    odd_numbers = []\n    for num in collatz_sequence:\n        if _is_odd(num):\n            odd_numbers.append(num)\n    odd_numbers.sort()\n    return odd_numbers"}
{"task_id": "HumanEval/128", "solution": "def prod_signs(arr):\n    \"\"\"\n    You are given an array arr of integers and you need to return\n    sum of magnitudes of integers multiplied by product of all signs\n    of each number in the array, represented by 1, -1 or 0.\n    Note: return None for empty arr.\n\n    Example:\n    >>> prod_signs([1, 2, 2, -4]) == -9\n    >>> prod_signs([0, 1]) == 0\n    >>> prod_signs([]) == None\n    \"\"\"\n    if not arr:\n        return None\n\n    def _get_sign(number):\n        \"\"\"Determines the sign of a single integer (1 for positive, -1 for negative, 0 for zero).\"\"\"\n        if number > 0:\n            return 1\n        elif number < 0:\n            return -1\n        else:\n            return 0\n\n    def _get_magnitude(number):\n        \"\"\"Determines the magnitude (absolute value) of a single integer.\"\"\"\n        return abs(number)\n\n    product_of_signs = 1\n    sum_of_magnitudes = 0\n\n    for num in arr:\n        product_of_signs *= _get_sign(num)\n        sum_of_magnitudes += _get_magnitude(num)\n\n    return sum_of_magnitudes * product_of_signs"}
{"task_id": "HumanEval/130", "solution": "def tri(n):\n    \"\"\"Calculates the first n + 1 numbers of the Tribonacci sequence.\n    Uses memoization to handle recursive dependencies efficiently, including forward lookups.\n    \"\"\"\n    # _memo will store calculated values: _memo[index] = value\n    # We need to calculate up to tri(n). If n is odd, tri(n) depends on tri(n+1).\n    # So, _memo needs to be large enough to store up to tri(n+1).\n    # Size n + 2 means indices 0 to n+1.\n    memo = [None] * (n + 2)\n\n    def _get_term(index):\n        # If the term is already calculated, return it from memo.\n        if memo[index] is not None:\n            return memo[index]\n        \n        # Calculate the term value and store it in memo before returning.\n        value = _calculate_term_value(index)\n        memo[index] = value\n        return value\n\n    def _calculate_term_value(index):\n        if index == 0:\n            return 1\n        elif index == 1:\n            return 3\n        elif index % 2 == 0:  # If index is even and greater than 0\n            # Formula for even terms: 1 + index / 2. Use integer division.\n            return 1 + index // 2\n        else:  # If index is odd and greater than 1\n            # Formula for odd terms: tri(index - 1) + tri(index - 2) + tri(index + 1)\n            return _get_term(index - 1) + _get_term(index - 2) + _get_term(index + 1)\n\n    # Collect the first n + 1 terms (from tri(0) to tri(n))\n    result = []\n    for i in range(n + 1):\n        result.append(_get_term(i))\n    \n    return result"}
{"task_id": "HumanEval/135", "solution": "def can_arrange(arr):\n    \"\"\"Create a function which returns the largest index of an element which\n    is not greater than or equal to the element immediately preceding it. If\n    no such element exists then return -1. The given array will not contain\n    duplicate values.\n    \"\"\"\n    largest_idx = -1\n    for i in range(len(arr) - 1, 0, -1):\n        if arr[i] < arr[i-1]:\n            largest_idx = i\n            break\n    return largest_idx"}
{"task_id": "HumanEval/129", "solution": "class Cell:\n    \"\"\"Represents a cell in the grid with its coordinates and value.\"\"\"\n    def __init__(self, row: int, col: int, value: int):\n        self.row = row\n        self.col = col\n        self.value = value\n\n    def get_neighbors_coords(self, grid_N: int) -> list[tuple[int, int]]:\n        \"\"\"Returns a list of (row, col) tuples for valid adjacent neighbors.\"\"\"\n        neighbors = []\n        directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]  # Up, Down, Left, Right\n        for dr, dc in directions:\n            new_row, new_col = self.row + dr, self.col + dc\n            if 0 <= new_row < grid_N and 0 <= new_col < grid_N:\n                neighbors.append((new_row, new_col))\n        return neighbors\nclass Grid:\n    \"\"\"Manages the 2D array of Cell objects.\"\"\"\n    def __init__(self, grid_data: list[list[int]]):\n        self.N = len(grid_data)\n        self.cells: list[list[Cell]] = [[None for _ in range(self.N)] for _ in range(self.N)]\n        for r in range(self.N):\n            for c in range(self.N):\n                self.cells[r][c] = Cell(r, c, grid_data[r][c])\n\n    def get_cell(self, row: int, col: int) -> Cell:\n        \"\"\"Retrieves the Cell object at the specified coordinates.\"\"\"\n        return self.cells[row][col]\nclass Path:\n    \"\"\"Represents an ordered sequence of visited Cell objects.\"\"\"\n    def __init__(self, cells: list[Cell]):\n        self.visited_cells = cells\n        self.values = [cell.value for cell in cells]\n        self.length = len(cells)\n\n    def add_cell(self, cell: Cell) -> 'Path':\n        \"\"\"Returns a new Path object with the given cell appended.\"\"\"\n        return Path(self.visited_cells + [cell])\n\n    def __lt__(self, other: 'Path') -> bool:\n        \"\"\"Implements lexicographical comparison.\"\"\"\n        return self.values < other.values\n\n    def __eq__(self, other: 'Path') -> bool:\n        \"\"\"Checks if two paths are equal based on their values sequence.\"\"\"\n        return self.values == other.values\ndef minPath(grid, k):\n    \"\"\"\n    Given a grid with N rows and N columns (N >= 2) and a positive integer k, \n    each cell of the grid contains a value. Every integer in the range [1, N * N]\n    inclusive appears exactly once on the cells of the grid.\n\n    You have to find the minimum path of length k in the grid. You can start\n    from any cell, and in each step you can move to any of the neighbor cells,\n    in other words, you can go to cells which share an edge with you current\n    cell.\n    Please note that a path of length k means visiting exactly k cells (not\n    necessarily distinct).\n    You CANNOT go off the grid.\n    A path A (of length k) is considered less than a path B (of length k) if\n    after making the ordered lists of the values on the cells that A and B go\n    through (let's call them lst_A and lst_B), lst_A is lexicographically less\n    than lst_B, in other words, there exist an integer index i (1 <= i <= k)\n    such that lst_A[i] < lst_B[i] and for any j (1 <= j < i) we have\n    lst_A[j] = lst_B[j].\n    It is guaranteed that the answer is unique.\n    Return an ordered list of the values on the cells that the minimum path go through.\n\n    Examples:\n\n        Input: grid = [ [1,2,3], [4,5,6], [7,8,9]], k = 3\n        Output: [1, 2, 1]\n\n        Input: grid = [ [5,9,3], [4,1,6], [7,8,2]], k = 1\n        Output: [1]\n    \"\"\"\n    grid_obj = Grid(grid)\n    N = grid_obj.N\n    \n    min_path_values = None\n\n    def dfs_optimized(current_path: Path):\n        nonlocal min_path_values\n\n        # Pruning: If the current path's prefix is already lexicographically greater than\n        # the corresponding prefix of the current best path of length k, stop this branch.\n        if min_path_values is not None and current_path.length <= k:\n            if current_path.values > min_path_values[:current_path.length]:\n                return\n\n        # Base case: A path of length k has been found.\n        if current_path.length == k:\n            if min_path_values is None or current_path.values < min_path_values:\n                min_path_values = current_path.values\n            return\n        \n        # Recursive step: Explore neighbors\n        last_cell = current_path.visited_cells[-1]\n        for next_r, next_c in last_cell.get_neighbors_coords(N):\n            next_cell = grid_obj.get_cell(next_r, next_c)\n            new_path = current_path.add_cell(next_cell)\n            dfs_optimized(new_path)\n\n    # Start DFS from each cell in the grid\n    for r in range(N):\n        for c in range(N):\n            start_cell = grid_obj.get_cell(r, c)\n            initial_path = Path([start_cell])\n            dfs_optimized(initial_path)\n\n    return min_path_values"}
{"task_id": "HumanEval/134", "solution": "class Character:\n    \"\"\"Encapsulates a single character and provides methods to query its properties.\"\"\"\n    def __init__(self, value: str):\n        self._value = value\n\n    def is_alphabetical(self) -> bool:\n        \"\"\"Returns True if the character is an alphabetical letter.\"\"\"\n        return self._value.isalpha()\n\n    def is_space(self) -> bool:\n        \"\"\"Returns True if the character is a space character.\"\"\"\n        return self._value == ' '\nclass Word:\n    \"\"\"Encapsulates a word (a group of characters not separated by space).\"\"\"\n    def __init__(self, text: str):\n        self._text = text\n\n    def get_characters(self) -> list[Character]:\n        \"\"\"Returns a list of Character objects composing the word.\"\"\"\n        return [Character(char) for char in self._text]\nclass String:\n    \"\"\"Encapsulates a string and provides methods for accessing its characters and splitting into words.\"\"\"\n    def __init__(self, text: str):\n        self._text = text\n\n    def get_last_character(self) -> Character | None:\n        \"\"\"Returns a Character object for the last character, or None if the string is empty.\"\"\"\n        if not self._text:\n            return None\n        return Character(self._text[-1])\n\n    def get_character_before_last(self) -> Character | None:\n        \"\"\"Returns a Character object for the character immediately preceding the last, or None if the string has less than two characters.\"\"\"\n        if len(self._text) < 2:\n            return None\n        return Character(self._text[-2])\n\n    def split_into_words(self) -> list[Word]:\n        \"\"\"Splits the string into a list of Word objects.\"\"\"\n        return [Word(word_str) for word_str in self._text.split(' ') if word_str]\ndef check_if_last_char_is_a_letter(txt):\n    \"\"\"\n    Checks if the last character of a string is an isolated alphabetical letter.\n    It returns True if the last character is alphabetical and is preceded by a space, or if it's the only character.\n    \"\"\"\n    if not txt:\n        return False\n\n    s = String(txt)\n    last_char_obj = s.get_last_character()\n\n    if not last_char_obj.is_alphabetical():\n        return False\n\n    if len(txt) == 1:\n        return True\n\n    char_before_last_obj = s.get_character_before_last()\n    if char_before_last_obj and char_before_last_obj.is_space():\n        return True\n    else:\n        return False"}
{"task_id": "HumanEval/131", "solution": "def digits(n):\n    \"\"\"Given a positive integer n, return the product of the odd digits.\n    Return 0 if all digits are even.\n    For example:\n    digits(1)  == 1\n    digits(4)  == 0\n    digits(235) == 15\n    \"\"\"\n    product_of_odd = 1\n    found_odd_digit = False\n    \n    # Iterate through the digits of n\n    while n > 0:\n        last_digit = n % 10\n        if last_digit % 2 != 0:  # Check if the digit is odd\n            product_of_odd *= last_digit\n            found_odd_digit = True\n        n //= 10\n    \n    # If no odd digits were found, return 0\n    if not found_odd_digit:\n        return 0\n    else:\n        return product_of_odd"}
{"task_id": "HumanEval/133", "solution": "import math\nfrom typing import List, Union\ndef _round_up(number: Union[int, float]) -> int:\n    \"\"\"Rounds a single number up to the nearest integer (ceiling).\"\"\"\n    return math.ceil(number)\ndef _square(number: int) -> int:\n    \"\"\"Squares a single integer.\"\"\"\n    return number * number\ndef sum_squares(lst: List[Union[int, float]]) -> int:\n    \"\"\"You are given a list of numbers.\n    You need to return the sum of squared numbers in the given list,\n    round each element in the list to the upper int(Ceiling) first.\n    Examples:\n    For lst = [1,2,3] the output should be 14\n    For lst = [1,4,9] the output should be 98\n    For lst = [1,3,5,7] the output should be 84\n    For lst = [1.4,4.2,0] the output should be 29\n    For lst = [-2.4,1,1] the output should be 6\n    \"\"\"\n    total_sum = 0\n    for num in lst:\n        rounded_num = _round_up(num)\n        squared_num = _square(rounded_num)\n        total_sum += squared_num\n    return total_sum"}
{"task_id": "HumanEval/132", "solution": "def is_nested(string):\n    '''\n    Create a function that takes a string as input which contains only square brackets.\n    The function should return True if and only if there is a valid subsequence of brackets \n    where at least one bracket in the subsequence is nested.\n    '''\n    # To have a valid subsequence with at least one nested bracket,\n    # the string must contain '[[' followed by ']]'.\n    # This ensures a structure like '[[]]' can be formed as a subsequence.\n    first_double_open_idx = string.find('[[')\n    first_double_close_idx = string.find(']]')\n\n    # If both \"[[\" and \"]]\" are found, check if \"[[\" appears before \"]]\".\n    # If so, a nested subsequence like '[[]]' can be constructed.\n    if first_double_open_idx != -1 and first_double_close_idx != -1:\n        return first_double_open_idx < first_double_close_idx\n    return False"}
{"task_id": "HumanEval/136", "solution": "def largest_smallest_integers(lst):\n    '''\n    Create a function that returns a tuple (a, b), where 'a' is\n    the largest of negative integers, and 'b' is the smallest\n    of positive integers in a list.\n    If there is no negative or positive integers, return them as None.\n\n    Examples:\n    largest_smallest_integers([2, 4, 1, 3, 5, 7]) == (None, 1)\n    largest_smallest_integers([]) == (None, None)\n    largest_smallest_integers([0]) == (None, None)\n    '''\n    largest_neg = None\n    smallest_pos = None\n\n    for number in lst:\n        if number < 0:\n            if largest_neg is None or number > largest_neg:\n                largest_neg = number\n        elif number > 0:\n            if smallest_pos is None or number < smallest_pos:\n                smallest_pos = number\n    \n    return (largest_neg, smallest_pos)"}
{"task_id": "HumanEval/137", "solution": "def _parse_value(value):\n    \"\"\"\n    Converts an input value (int, float, or string) to a float and returns its original type.\n    Handles string parsing with ',' or '.' decimal separators.\n    \"\"\"\n    original_type = type(value)\n    if isinstance(value, str):\n        parsed_str = value.replace(',', '.')\n        return float(parsed_str), original_type\n    return float(value), original_type\ndef compare_one(a, b):\n    \"\"\"\n    Compares two real numbers (int, float, or string) and returns the larger one in its original type.\n    Returns None if the values are equal.\n    \"\"\"\n    numeric_a, _ = _parse_value(a)\n    numeric_b, _ = _parse_value(b)\n\n    if numeric_a == numeric_b:\n        return None\n    elif numeric_a > numeric_b:\n        return a\n    else:\n        return b"}
{"task_id": "HumanEval/139", "solution": "def factorial(k):\n    \"\"\"Calculates k! for a non-negative integer k.\"\"\"\n    if k < 0:\n        raise ValueError(\"Factorial is not defined for negative numbers\")\n    if k == 0:\n        return 1\n    res = 1\n    for i in range(1, k + 1):\n        res *= i\n    return res\ndef special_factorial(n):\n    \"\"\"The Brazilian factorial is defined as:\n    brazilian_factorial(n) = n! * (n-1)! * (n-2)! * ... * 1!\n    where n > 0\n\n    For example:\n    >>> special_factorial(4)\n    288\n\n    The function will receive an integer as input and should return the special\n    factorial of this integer.\n    \"\"\"\n    if n <= 0:\n        raise ValueError(\"Input must be greater than 0\")\n\n    product = 1\n    for i in range(n, 0, -1):\n        product *= factorial(i)\n\n    return product"}
{"task_id": "HumanEval/138", "solution": "def is_equal_to_sum_even(n):\n    \"\"\"Evaluate whether the given number n can be written as the sum of exactly 4 positive even numbers.\"\"\"\n    if n % 2 == 0 and n >= 8:\n        return True\n    else:\n        return False"}
{"task_id": "HumanEval/142", "solution": "def sum_squares(lst):\n    \"\"\"\"\n    This function will take a list of integers. For all entries in the list, the function shall square the integer entry if its index is a \n    multiple of 3 and will cube the integer entry if its index is a multiple of 4 and not a multiple of 3. The function will not \n    change the entries in the list whose indexes are not a multiple of 3 or 4. The function shall then return the sum of all entries. \n    \n    Examples:\n    For lst = [1,2,3] the output should be 6\n    For lst = []  the output should be 0\n    For lst = [-1,-5,2,-1,-5]  the output should be -126\n    \"\"\"\n    total_sum = 0\n    for i, val in enumerate(lst):\n        if i % 3 == 0:\n            total_sum += val * val\n        elif i % 4 == 0:  # and i % 3 != 0 is implicitly handled by the 'elif'\n            total_sum += val * val * val\n        else:\n            total_sum += val\n    return total_sum"}
{"task_id": "HumanEval/140", "solution": "import re\ndef fix_spaces(text):\n    \"\"\"\n    Given a string text, replace all spaces in it with underscores, \n    and if a string has more than 2 consecutive spaces, \n    then replace all consecutive spaces with - \n    \"\"\"\n    # First, replace sequences of three or more spaces with a single hyphen.\n    # This ensures that longer sequences are handled first as per design.\n    text = re.sub(r' {3,}', '-', text)\n\n    # Next, replace sequences of exactly two spaces with two underscores.\n    # These are specific two-space sequences not caught by the previous rule.\n    text = re.sub(r' {2}', '__', text)\n\n    # Finally, replace any remaining single spaces with a single underscore.\n    text = re.sub(r' ', '_', text)\n\n    return text"}
{"task_id": "HumanEval/141", "solution": "import re\nclass FileName:\n    \"\"\"Encapsulates a file name string and provides methods to parse and validate its components.\"\"\"\n\n    ALLOWED_EXTENSIONS = {'txt', 'exe', 'dll'}\n\n    def __init__(self, file_name: str):\n        self._name = file_name\n        self._part_before_dot = \"\"\n        self._part_after_dot = \"\"\n        self._digit_count = self._count_digits()\n        self._dot_count = self._count_dots()\n        if self._dot_count == 1:\n            self._split_name()\n\n    def _count_digits(self) -> int:\n        \"\"\"Counts the number of digits in the file name.\"\"\"\n        return sum(1 for char in self._name if char.isdigit())\n\n    def _count_dots(self) -> int:\n        \"\"\"Counts the number of dots in the file name.\"\"\"\n        return self._name.count('.')\n\n    def _split_name(self):\n        \"\"\"Splits the file name into parts before and after the first dot.\"\"\"\n        parts = self._name.split('.', 1)\n        self._part_before_dot = parts[0]\n        self._part_after_dot = parts[1]\n\n    def _is_digit_count_valid(self) -> bool:\n        \"\"\"Checks if the digit count is no more than three (BR1).\"\"\"\n        return self._digit_count <= 3\n\n    def _is_dot_count_valid(self) -> bool:\n        \"\"\"Checks if the dot count is exactly one (BR2).\"\"\"\n        return self._dot_count == 1\n\n    def _is_part_before_dot_not_empty(self) -> bool:\n        \"\"\"Checks if the substring before the dot is not empty (BR3).\"\"\"\n        return bool(self._part_before_dot)\n\n    def _starts_with_latin_letter(self) -> bool:\n        \"\"\"Checks if the substring before the dot starts with a Latin alphabet letter (BR4).\"\"\"\n        if not self._part_before_dot:\n            return False\n        first_char = self._part_before_dot[0]\n        return 'a' <= first_char <= 'z' or 'A' <= first_char <= 'Z'\n\n    def _has_valid_extension(self) -> bool:\n        \"\"\"Checks if the substring after the dot is one of the allowed extensions (BR5).\"\"\"\n        return self._part_after_dot in self.ALLOWED_EXTENSIONS\n\n    def is_valid(self) -> bool:\n        \"\"\"Orchestrates all validation checks and returns the overall validity.\"\"\"\n        # BR2 is checked first as it's foundational for splitting and subsequent checks\n        if not self._is_dot_count_valid():\n            return False\n\n        # Subsequent checks rely on successful splitting\n        if not self._is_part_before_dot_not_empty():\n            return False\n\n        if not self._starts_with_latin_letter():\n            return False\n\n        if not self._has_valid_extension():\n            return False\n\n        # BR1 can be checked independently of splitting logic\n        if not self._is_digit_count_valid():\n            return False\n\n        return True\ndef file_name_check(file_name):\n    \"\"\"Create a function which takes a string representing a file's name, and returns\n    'Yes' if the the file's name is valid, and returns 'No' otherwise.\n    A file's name is considered to be valid if and only if all the following conditions \n    are met:\n    - There should not be more than three digits ('0'-'9') in the file's name.\n    - The file's name contains exactly one dot '.'\n    - The substring before the dot should not be empty, and it starts with a letter from \n    the latin alphapet ('a'-'z' and 'A'-'Z').\n    - The substring after the dot should be one of these: ['txt', 'exe', 'dll']\n    Examples:\n    file_name_check(\"example.txt\") # => 'Yes'\n    file_name_check(\"1example.dll\") # => 'No' (the name should start with a latin alphapet letter)\n    \"\"\"\n    file_obj = FileName(file_name)\n    if file_obj.is_valid():\n        return 'Yes'\n    else:\n        return 'No'"}
{"task_id": "HumanEval/143", "solution": "class PrimeNumberChecker:\n    \"\"\"Utility class for determining if a number is prime.\"\"\"\n    @staticmethod\n    def is_prime(number: int) -> bool:\n        if number < 2:\n            return False\n        for i in range(2, int(number**0.5) + 1):\n            if number % i == 0:\n                return False\n        return True\nclass Word:\n    \"\"\"Represents a single word and provides its length and primality check for its length.\"\"\"\n    def __init__(self, text: str):\n        self._text = text\n        self._length = len(text)\n\n    def get_text(self) -> str:\n        return self._text\n\n    def get_length(self) -> int:\n        return self._length\n\n    def is_length_prime(self) -> bool:\n        return PrimeNumberChecker.is_prime(self._length)\nclass Sentence:\n    \"\"\"Represents a sentence, handles splitting into words, and filtering words by prime length.\"\"\"\n    def __init__(self, text: str):\n        self._text = text\n        self._words = self._split_into_words()\n\n    def _split_into_words(self) -> list[Word]:\n        return [Word(word_text) for word_text in self._text.split(' ')]\n\n    def get_words_with_prime_length(self) -> list[Word]:\n        return [word for word in self._words if word.is_length_prime()]\ndef words_in_sentence(sentence):\n    \"\"\"\n    Returns a string that contains the words from the original sentence,\n    whose lengths are prime numbers, maintaining their original order.\n    \"\"\"\n    sentence_obj = Sentence(sentence)\n    prime_words = sentence_obj.get_words_with_prime_length()\n    return \" \".join([word.get_text() for word in prime_words])"}
{"task_id": "HumanEval/144", "solution": "def _parse_fraction_string(fraction_str: str) -> tuple[int, int]:\n    \"\"\"Parses a fraction string into its numerator and denominator integers.\"\"\"\n    parts = fraction_str.split('/')\n    numerator = int(parts[0])\n    denominator = int(parts[1])\n    return numerator, denominator\nclass Fraction:\n    \"\"\"Represents a fraction with integer numerator and denominator.\"\"\"\n    def __init__(self, fraction_str: str):\n        self.numerator, self.denominator = _parse_fraction_string(fraction_str)\ndef simplify(x, n):\n    \"\"\"Your task is to implement a function that will simplify the expression\n    x * n. The function returns True if x * n evaluates to a whole number and False\n    otherwise. Both x and n, are string representation of a fraction, and have the following format,\n    <numerator>/<denominator> where both numerator and denominator are positive whole numbers.\n\n    You can assume that x, and n are valid fractions, and do not have zero as denominator.\n\n    simplify(\"1/5\", \"5/1\") = True\n    simplify(\"1/6\", \"2/1\") = False\n    simplify(\"7/10\", \"10/2\") = False\n    \"\"\"\n    x_fraction = Fraction(x)\n    n_fraction = Fraction(n)\n\n    product_numerator = x_fraction.numerator * n_fraction.numerator\n    product_denominator = x_fraction.denominator * n_fraction.denominator\n\n    # The product is a whole number if its numerator is perfectly divisible by its denominator.\n    return product_numerator % product_denominator == 0"}
{"task_id": "HumanEval/145", "solution": "def order_by_points(nums):\n    \"\"\"\n    Sorts a list of integers based on the sum of their digits,\n    maintaining original order for ties.\n    \"\"\"\n\n    def _calculate_digit_sum(num: int) -> int:\n        \"\"\"Calculates the sum of the absolute values of the digits for a given integer.\"\"\"\n        return sum(int(digit) for digit in str(abs(num)))\n\n    class _SortableInteger:\n        \"\"\"\n        Encapsulates an integer's value, original index, and digit sum for custom sorting.\n        \"\"\"\n        def __init__(self, value: int, original_index: int):\n            self.value = value\n            self.original_index = original_index\n            self.digit_sum = _calculate_digit_sum(value)\n\n        def __lt__(self, other: '_SortableInteger') -> bool:\n            \"\"\"\n            Defines less-than comparison: first by digit sum, then by original index.\n            \"\"\"\n            if self.digit_sum != other.digit_sum:\n                return self.digit_sum < other.digit_sum\n            return self.original_index < other.original_index\n\n    if not nums:\n        return []\n\n    sortable_items = []\n    for i, num in enumerate(nums):\n        sortable_items.append(_SortableInteger(num, i))\n\n    sortable_items.sort()\n\n    return [item.value for item in sortable_items]"}
{"task_id": "HumanEval/150", "solution": "def x_or_y(n, x, y):\n    \"\"\"A simple program which should return the value of x if n is \n    a prime number and should return the value of y otherwise.\n\n    Examples:\n    for x_or_y(7, 34, 12) == 34\n    for x_or_y(15, 8, 5) == 5\n    \n    \"\"\"\n    def is_prime(n: int) -> bool:\n        \"\"\"Determines if an integer n is a prime number.\"\"\"\n        if n <= 1:\n            return False\n        if n <= 3:\n            return True\n        if n % 2 == 0 or n % 3 == 0:\n            return False\n        i = 5\n        while i * i <= n:\n            if n % i == 0 or n % (i + 2) == 0:\n                return False\n            i += 6\n        return True\n\n    if is_prime(n):\n        return x\n    else:\n        return y"}
{"task_id": "HumanEval/149", "solution": "def sorted_list_sum(lst):\n    \"\"\"Filters out strings with odd lengths and returns the remaining list sorted by length, then alphabetically.\"\"\"\n    even_length_strings = [s for s in lst if len(s) % 2 == 0]\n    return sorted(even_length_strings, key=lambda s: (len(s), s))"}
{"task_id": "HumanEval/146", "solution": "def specialFilter(nums):\n    \"\"\"\n    Counts elements in the array that are greater than 10 and have both\n    first and last digits as odd.\n    \"\"\"\n\n    def _is_odd(digit):\n        \"\"\"Checks if a given digit is odd.\"\"\"\n        return digit % 2 != 0\n\n    def _get_first_digit(num):\n        \"\"\"Extracts the first digit of a number (absolute value).\"\"\"\n        return int(str(abs(num))[0])\n\n    def _get_last_digit(num):\n        \"\"\"Extracts the last digit of a number (absolute value).\"\"\"\n        return abs(num) % 10\n\n    def _is_special_number(num):\n        \"\"\"Determines if a single number meets all 'special number' criteria.\"\"\"\n        if num <= 10:\n            return False\n        \n        first_digit = _get_first_digit(num)\n        last_digit = _get_last_digit(num)\n        \n        return _is_odd(first_digit) and _is_odd(last_digit)\n\n    count = 0\n    for num in nums:\n        if _is_special_number(num):\n            count += 1\n    return count"}
{"task_id": "HumanEval/148", "solution": "class Planet:\n    \"\"\"Represents a single planet with its name and orbital order.\"\"\"\n    def __init__(self, name: str, order_from_sun: int):\n        self.name = name\n        self.order_from_sun = order_from_sun\n\n    def __lt__(self, other) -> bool:\n        \"\"\"Enables comparison for sorting planets by order_from_sun.\"\"\"\n        return self.order_from_sun < other.order_from_sun\nclass SolarSystem:\n    \"\"\"Manages the static list of planets and provides methods to query them.\"\"\"\n    def __init__(self):\n        planets_data = [\n            (\"Mercury\", 1), (\"Venus\", 2), (\"Earth\", 3), (\"Mars\", 4),\n            (\"Jupiter\", 5), (\"Saturn\", 6), (\"Uranus\", 7), (\"Neptune\", 8)\n        ]\n        self._planets_ordered = [Planet(name, order) for name, order in planets_data]\n        self._planets_by_name = {planet.name: planet for planet in self._planets_ordered}\n\n    def get_planet_by_name(self, name: str) -> Planet | None:\n        \"\"\"Retrieves a planet by its name, or None if not found.\"\"\"\n        return self._planets_by_name.get(name)\n\n    def get_planets_between(self, start_order: int, end_order: int) -> list[Planet]:\n        \"\"\"Returns a list of planets strictly between the given orbital orders, sorted by proximity to the Sun.\"\"\"\n        min_order = min(start_order, end_order)\n        max_order = max(start_order, end_order)\n        \n        result = [\n            planet for planet in self._planets_ordered \n            if min_order < planet.order_from_sun < max_order\n        ]\n        return result\n_solar_system_instance = SolarSystem()\ndef bf(planet1, planet2):\n    \"\"\"\n    Returns a tuple of planets whose orbits are located between the orbit of planet1 and planet2,\n    sorted by proximity to the sun, or an empty tuple if names are incorrect.\n    \"\"\"\n    planet1_obj = _solar_system_instance.get_planet_by_name(planet1)\n    planet2_obj = _solar_system_instance.get_planet_by_name(planet2)\n\n    if planet1_obj is None or planet2_obj is None:\n        return ()\n\n    intermediate_planets = _solar_system_instance.get_planets_between(\n        planet1_obj.order_from_sun, planet2_obj.order_from_sun\n    )\n    \n    return tuple(planet.name for planet in intermediate_planets)"}
{"task_id": "HumanEval/151", "solution": "from typing import Any, Union\ndef _is_integer(num: Any) -> bool:\n    \"\"\"Checks if a value is an integer type.\"\"\"\n    return isinstance(num, int)\ndef _is_non_negative(num: Union[int, float]) -> bool:\n    \"\"\"Checks if a numeric value is non-negative.\"\"\"\n    return num >= 0\ndef _is_odd(num: int) -> bool:\n    \"\"\"Checks if an integer value is odd.\"\"\"\n    return num % 2 != 0\ndef double_the_difference(lst):\n    '''\n    Given a list of numbers, return the sum of squares of the numbers\n    in the list that are odd. Ignore numbers that are negative or not integers.\n    '''\n    total_sum_of_squares = 0\n    for item in lst:\n        if _is_integer(item) and _is_non_negative(item) and _is_odd(item):\n            total_sum_of_squares += item * item\n    return total_sum_of_squares"}
{"task_id": "HumanEval/147", "solution": "import math\nfrom typing import List\ndef _calculate_array_element(i: int) -> int:\n    \"\"\"Calculates the value of a[i] = i * i - i + 1.\"\"\"\n    return i * i - i + 1\ndef _is_multiple_of_3(num: int) -> bool:\n    \"\"\"Determines if a number is a multiple of 3.\"\"\"\n    return num % 3 == 0\ndef get_max_triples(n: int) -> int:\n    \"\"\"\n    You are given a positive integer n. You have to create an integer array a of length n.\n        For each i (1 \u2264 i \u2264 n), the value of a[i] = i * i - i + 1.\n        Return the number of triples (a[i], a[j], a[k]) of a where i < j < k, \n    and a[i] + a[j] + a[k] is a multiple of 3.\n    \"\"\"\n    a_values: List[int] = [0] * n\n\n    for i in range(1, n + 1):\n        a_values[i - 1] = _calculate_array_element(i)\n\n    valid_triples_count = 0\n\n    for i in range(n):\n        for j in range(i + 1, n):\n            for k in range(j + 1, n):\n                current_sum = a_values[i] + a_values[j] + a_values[k]\n                if _is_multiple_of_3(current_sum):\n                    valid_triples_count += 1\n\n    return valid_triples_count"}
{"task_id": "HumanEval/152", "solution": "def compare(game,guess):\n    \"\"\"Calculates the absolute differences between corresponding game scores and guesses.\n\n    Returns 0 if scores are equal, otherwise returns the absolute difference.\n    \"\"\"\n    differences = []\n    for i in range(len(game)):\n        if game[i] == guess[i]:\n            differences.append(0)\n        else:\n            differences.append(abs(game[i] - guess[i]))\n    return differences"}
{"task_id": "HumanEval/153", "solution": "def _calculate_extension_strength(extension_name: str) -> int:\n    \"\"\"Calculates the strength of an extension name (CAP - SM).\"\"\"\n    cap_count = 0\n    sm_count = 0\n    for char in extension_name:\n        if char.isupper():\n            cap_count += 1\n        elif char.islower():\n            sm_count += 1\n    return cap_count - sm_count\ndef Strongest_Extension(class_name, extensions):\n    \"\"\"\n    Finds the strongest extension from a list based on character counts\n    and returns a formatted string.\n    \"\"\"\n    # Initialize with the first extension to handle tie-breaking (first in list).\n    strongest_extension_name = extensions[0]\n    max_strength = _calculate_extension_strength(extensions[0])\n\n    # Iterate through the rest of the extensions\n    for i in range(1, len(extensions)):\n        current_extension_name = extensions[i]\n        current_strength = _calculate_extension_strength(current_extension_name)\n\n        # If a stronger extension is found, update the strongest.\n        # If strengths are equal, the current strongest (which came first) is kept.\n        if current_strength > max_strength:\n            max_strength = current_strength\n            strongest_extension_name = current_extension_name\n\n    return f\"{class_name}.{strongest_extension_name}\""}
{"task_id": "HumanEval/155", "solution": "def even_odd_count(num):\n    \"\"\"Given an integer. return a tuple that has the number of even and odd digits respectively.\n\n     Example:\n        even_odd_count(-12) ==> (1, 1)\n        even_odd_count(123) ==> (1, 2)\n    \"\"\"\n    even_count = 0\n    odd_count = 0\n    # Get the absolute value of the number to handle negative inputs.\n    # Convert to string to easily iterate through digits.\n    for digit_char in str(abs(num)):\n        digit = int(digit_char)\n        if digit % 2 == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n    return (even_count, odd_count)"}
{"task_id": "HumanEval/156", "solution": "_ROMAN_MAP_VALUES = [\n    (1000, 'M'), (900, 'CM'), (500, 'D'), (400, 'CD'),\n    (100, 'C'), (90, 'XC'), (50, 'L'), (40, 'XL'),\n    (10, 'X'), (9, 'IX'), (5, 'V'), (4, 'IV'), (1, 'I')\n]\ndef int_to_mini_roman(number):\n    \"\"\"\n    Converts a positive integer (1-1000) to its lowercase Roman numeral equivalent.\n    \"\"\"\n    roman_numeral_string = []\n    \n    for value, symbol in _ROMAN_MAP_VALUES:\n        while number >= value:\n            roman_numeral_string.append(symbol)\n            number -= value\n            \n    return \"\".join(roman_numeral_string).lower()"}
{"task_id": "HumanEval/160", "solution": "class EvaluationError(Exception):\n    \"\"\"Custom exception for expression evaluation failures.\"\"\"\n    pass\ndef _construct_expression_string(operator, operand):\n    \"\"\"Builds the algebraic expression string by interleaving operands and operators.\"\"\"\n    expression_parts = []\n    for i in range(len(operator)):\n        expression_parts.append(str(operand[i]))\n        expression_parts.append(operator[i])\n    expression_parts.append(str(operand[-1]))\n    return \" \".join(expression_parts)\ndef _evaluate_expression(expression_string):\n    \"\"\"Evaluates the constructed expression string using Python's `eval`.\"\"\"\n    try:\n        result = eval(expression_string)\n        return int(result) # Ensure integer result for floor division\n    except ZeroDivisionError:\n        raise EvaluationError(\"Division by zero occurred during expression evaluation.\")\n    except Exception as e:\n        raise EvaluationError(f\"An error occurred during expression evaluation: {e}\")\ndef do_algebra(operator, operand):\n    \"\"\"\n    Given two lists operator, and operand. The first list has basic algebra operations, and \n    the second list is a list of integers. Use the two given lists to build the algebric \n    expression and return the evaluation of this expression.\n    \"\"\"\n    _validate_inputs(operator, operand)\n    expression_string = _construct_expression_string(operator, operand)\n    result = _evaluate_expression(expression_string)\n    return result"}
{"task_id": "HumanEval/157", "solution": "class Triangle:\n    def __init__(self, a: float, b: float, c: float):\n        \"\"\"Initializes the triangle with its three side lengths.\"\"\"\n        self._side_a = a\n        self._side_b = b\n        self._side_c = c\n\n    def is_right_angled(self) -> bool:\n        \"\"\"Determines if the triangle is right-angled using the Pythagorean theorem.\"\"\"\n        # Use a small epsilon for floating-point comparison\n        epsilon = 1e-9\n\n        # Check all three possible hypotenuses\n        if abs(self._side_a**2 + self._side_b**2 - self._side_c**2) < epsilon:\n            return True\n        if abs(self._side_a**2 + self._side_c**2 - self._side_b**2) < epsilon:\n            return True\n        if abs(self._side_b**2 + self._side_c**2 - self._side_a**2) < epsilon:\n            return True\n        return False\ndef right_angle_triangle(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle. Return True if the three\n    sides form a right-angled triangle, False otherwise.\n    A right-angled triangle is a triangle in which one angle is right angle or \n    90 degree.\n    Example:\n    right_angle_triangle(3, 4, 5) == True\n    right_angle_triangle(1, 2, 3) == False\n    '''\n    triangle = Triangle(a, b, c)\n    return triangle.is_right_angled()"}
{"task_id": "HumanEval/154", "solution": "class Word:\n    \"\"\"Encapsulates a string value and provides methods for cyclic rotations and substring checks.\"\"\"\n    def __init__(self, value):\n        self._value = value\n\n    def generate_rotations(self):\n        \"\"\"Generates and returns a list of all unique cyclic rotations of the word's value.\"\"\"\n        if not self._value:\n            return [\"\"]\n\n        rotations = set()\n        n = len(self._value)\n        for i in range(n):\n            rotation = self._value[i:] + self._value[:i]\n            rotations.add(rotation)\n        return list(rotations)\n\n    def is_substring_of(self, target_word_value):\n        \"\"\"Checks if the word's value is a substring of the target_word_value.\"\"\"\n        return self._value in target_word_value\ndef cycpattern_check(a , b):\n    \"\"\"You are given 2 words. You need to return True if the second word or any of its rotations is a substring in the first word\n    cycpattern_check(\"abcd\",\"abd\") => False\n    cycpattern_check(\"hello\",\"ell\") => True\n    cycpattern_check(\"whassup\",\"psus\") => False\n    cycpattern_check(\"abab\",\"baa\") => True\n    cycpattern_check(\"efef\",\"eeff\") => False\n    cycpattern_check(\"himenss\",\"simen\") => True\n\n    \"\"\"\n    word_b = Word(b)\n    rotations_of_b = word_b.generate_rotations()\n\n    for rotation_str in rotations_of_b:\n        if Word(rotation_str).is_substring_of(a):\n            return True\n\n    return False"}
{"task_id": "HumanEval/158", "solution": "def _calculate_unique_char_count(s):\n    \"\"\"Helper function to calculate the number of unique characters in a string.\"\"\"\n    return len(set(s))\nclass StringItem:\n    \"\"\"Represents a string with its calculated unique character count.\n    This class encapsulates the string value and its unique character count,\n    providing methods for retrieval and lexicographical comparison.\n    \"\"\"\n    def __init__(self, value):\n        \"\"\"Initializes a StringItem, calculating its unique character count.\"\"\"\n        self._value = value\n        self._unique_char_count = _calculate_unique_char_count(value)\n\n    def get_value(self):\n        \"\"\"Returns the encapsulated string value.\"\"\"\n        return self._value\n\n    def get_unique_char_count(self):\n        \"\"\"Returns the calculated number of unique characters.\"\"\"\n        return self._unique_char_count\n\n    def __lt__(self, other):\n        \"\"\"Compares this StringItem with another lexicographically.\n        This method is used for tie-breaking when unique character counts are equal.\n        \"\"\"\n        return self._value < other._value\ndef find_max(words):\n    \"\"\"Write a function that accepts a list of strings.\n    The list contains different words. Return the word with maximum number\n    of unique characters. If multiple strings have maximum number of unique\n    characters, return the one which comes first in lexicographical order.\n\n    find_max([\"name\", \"of\", \"string\"]) == \"string\"\n    find_max([\"name\", \"enam\", \"game\"]) == \"enam\"\n    find_max([\"aaaaaaa\", \"bb\" ,\"cc\"]) == \"aaaaaaa\"\n    \"\"\"\n    if not words:\n        return \"\"\n\n    max_unique_count = -1\n    result_string = \"\"\n\n    for word in words:\n        current_item = StringItem(word)\n        current_unique_count = current_item.get_unique_char_count()\n\n        if current_unique_count > max_unique_count:\n            max_unique_count = current_unique_count\n            result_string = current_item.get_value()\n        elif current_unique_count == max_unique_count:\n            # Apply lexicographical tie-breaking by comparing StringItem instances\n            if current_item < StringItem(result_string):\n                result_string = current_item.get_value()\n\n    return result_string"}
{"task_id": "HumanEval/159", "solution": "class CarrotQuantity:\n    def __init__(self, value: int):\n        self._value = value\n\n    def get_value(self) -> int:\n        return self._value\n\n    def add(self, other: 'CarrotQuantity') -> 'CarrotQuantity':\n        return CarrotQuantity(self._value + other.get_value())\n\n    def subtract(self, other: 'CarrotQuantity') -> 'CarrotQuantity':\n        return CarrotQuantity(self._value - other.get_value())\n\n    def is_less_than_or_equal(self, other: 'CarrotQuantity') -> bool:\n        return self._value <= other.get_value()\n\n    def min(self, other: 'CarrotQuantity') -> 'CarrotQuantity':\n        return CarrotQuantity(min(self._value, other.get_value()))\nclass MealOutcome:\n    def __init__(self, total_eaten: CarrotQuantity, carrots_left: CarrotQuantity):\n        self.total_eaten = total_eaten\n        self.carrots_left = carrots_left\n\n    def to_array(self) -> list[int]:\n        return [self.total_eaten.get_value(), self.carrots_left.get_value()]\nclass MealCalculator:\n    def calculate_meal(self, eaten_before: CarrotQuantity, needed: CarrotQuantity, remaining_in_stock: CarrotQuantity) -> MealOutcome:\n        \"\"\"Calculates the meal outcome based on carrots eaten, needed, and remaining.\"\"\"\n        if needed.is_less_than_or_equal(remaining_in_stock):\n            # The rabbit eats all it needs.\n            new_total_eaten = eaten_before.add(needed)\n            new_carrots_left = remaining_in_stock.subtract(needed)\n        else:\n            # The rabbit eats all remaining carrots but is still hungry.\n            new_total_eaten = eaten_before.add(remaining_in_stock)\n            new_carrots_left = CarrotQuantity(0)\n\n        return MealOutcome(new_total_eaten, new_carrots_left)\ndef eat(number, need, remaining):\n    \"\"\"\n    You're a hungry rabbit, and you already have eaten a certain number of carrots,\n    but now you need to eat more carrots to complete the day's meals.\n    you should return an array of [ total number of eaten carrots after your meals,\n                                    the number of carrots left after your meals ]\n    if there are not enough remaining carrots, you will eat all remaining carrots, but will still be hungry.\n    \n    Example:\n    * eat(5, 6, 10) -> [11, 4]\n    * eat(4, 8, 9) -> [12, 1]\n    * eat(1, 10, 10) -> [11, 0]\n    * eat(2, 11, 5) -> [7, 0]\n    \n    Variables:\n    @number : integer\n        the number of carrots that you have eaten.\n    @need : integer\n        the number of carrots that you need to eat.\n    @remaining : integer\n        the number of remaining carrots thet exist in stock\n    \n    Constrain:\n    * 0 <= number <= 1000\n    * 0 <= need <= 1000\n    * 0 <= remaining <= 1000\n\n    Have fun :)\n    \"\"\"\n    # Convert raw inputs to domain objects, assuming valid input based on problem constraints.\n    eaten_before_obj = CarrotQuantity(number)\n    needed_obj = CarrotQuantity(need)\n    remaining_obj = CarrotQuantity(remaining)\n\n    # Perform calculation using the MealCalculator.\n    calculator = MealCalculator()\n    meal_outcome = calculator.calculate_meal(eaten_before_obj, needed_obj, remaining_obj)\n\n    # Format output as an array.\n    return meal_outcome.to_array()"}
{"task_id": "HumanEval/162", "solution": "import hashlib\ndef string_to_md5(text):\n    \"\"\"\n    Given a string 'text', return its md5 hash equivalent string.\n    If 'text' is an empty string, return None.\n    \"\"\"\n    if not text:\n        return None\n    md5_hash = hashlib.md5(text.encode('utf-8'))\n    return md5_hash.hexdigest()"}
{"task_id": "HumanEval/161", "solution": "def solve(s):\n    \"\"\"\n    Reverses case of letters in a string, or reverses the entire string if no letters are present.\n    \"\"\"\n    \n    def _is_letter(char):\n        \"\"\"Checks if a character is an alphabet letter.\"\"\"\n        return 'a' <= char <= 'z' or 'A' <= char <= 'Z'\n\n    def _toggle_case(char):\n        \"\"\"Reverses the case of an alphabet letter.\"\"\"\n        if 'a' <= char <= 'z':\n            return char.upper()\n        elif 'A' <= char <= 'Z':\n            return char.lower()\n        return char # Should not happen if only letters are passed\n\n    transformed_chars = []\n    has_letters = False\n\n    for char in s:\n        if _is_letter(char):\n            has_letters = True\n            transformed_chars.append(_toggle_case(char))\n        else:\n            transformed_chars.append(char)\n\n    if has_letters:\n        return \"\".join(transformed_chars)\n    else:\n        return s[::-1]"}
{"task_id": "HumanEval/163", "solution": "def _is_positive(num: int) -> bool:\n    \"\"\"Checks if a number is positive.\"\"\"\n    return num > 0\ndef _is_single_digit(num: int) -> bool:\n    \"\"\"Checks if a number is a single-digit number (0-9).\"\"\"\n    return 0 <= num <= 9\ndef _is_even(num: int) -> bool:\n    \"\"\"Checks if a number is even.\"\"\"\n    return num % 2 == 0\ndef generate_integers(a, b):\n    \"\"\"\n    Given two positive integers a and b, return the even digits between a\n    and b, in ascending order.\n\n    For example:\n    generate_integers(2, 8) => [2, 4, 6, 8]\n    generate_integers(8, 2) => [2, 4, 6, 8]\n    generate_integers(10, 14) => []\n    \"\"\"\n    # Validate inputs as positive integers\n    if not _is_positive(a) or not _is_positive(b):\n        raise ValueError(\"Inputs must be positive\")\n\n    # Determine the inclusive range\n    min_val = min(a, b)\n    max_val = max(a, b)\n\n    result_list = []\n    # Iterate through numbers in the determined range\n    for i in range(min_val, max_val + 1):\n        # Filter for single-digit even numbers (2, 4, 6, 8)\n        if _is_single_digit(i) and _is_even(i) and i > 0:\n            result_list.append(i)\n\n    # Sort the list in ascending order (redundant as numbers are added in order, but adheres to design)\n    result_list.sort()\n\n    return result_list"}
