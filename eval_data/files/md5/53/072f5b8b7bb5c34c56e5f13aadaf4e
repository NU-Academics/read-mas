{"task_id": "HumanEval/44", "solution": "class NumberToConvert:\n    \"\"\"Represents the integer value to be converted.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\nclass TargetBase:\n    \"\"\"Represents the target base value and validates it against business rules.\"\"\"\n    MIN_BASE = 2\n    MAX_BASE = 9\n\n    def __init__(self, value: int):\n        self.value = value\n\n    def validate_base(self) -> None:\n        \"\"\"Validates if the base is >= 2 and < 10.\"\"\"\n        if not (self.MIN_BASE <= self.value <= self.MAX_BASE):\n            raise ValueError(f\"Base must be an integer between {self.MIN_BASE} and {self.MAX_BASE} (inclusive).\")\n\nclass ConvertedNumber:\n    \"\"\"Holds the string representation of the converted number.\"\"\"\n    def __init__(self, representation: str):\n        self.representation = representation\n\nclass NumberConverter:\n    \"\"\"Performs the core numerical base conversion logic.\"\"\"\n    def convert(self, number: NumberToConvert, base: TargetBase) -> ConvertedNumber:\n        \"\"\"Converts the number to the specified base and returns the ConvertedNumber.\"\"\"\n        if number.value == 0:\n            return ConvertedNumber('0')\n\n        digits = []\n        n = number.value\n        while n > 0:\n            remainder = n % base.value\n            digits.append(str(remainder))\n            n //= base.value\n        return ConvertedNumber(''.join(digits[::-1]))\n\ndef change_base(x: int, base: int):\n    \"\"\"Change numerical base of input number x to base.\n    return string representation after the conversion.\n    base numbers are less than 10.\n    >>> change_base(8, 3)\n    '22'\n    >>> change_base(8, 2)\n    '1000'\n    >>> change_base(7, 2)\n    '111'\n    \"\"\"\n    number_to_convert = NumberToConvert(x)\n    target_base = TargetBase(base)\n    target_base.validate_base()\n    converter = NumberConverter()\n    converted_number = converter.convert(number_to_convert, target_base)"}
