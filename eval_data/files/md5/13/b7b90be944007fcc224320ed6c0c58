 -float('inf')\n    strongest_extension_name = \"\"\n\n    for extension in extensions:\n        current_strength = _calculate_extension_strength(extension)\n        if current_strength > max_strength:\n            max_strength = current_strength\n            strongest_extension_name = extension\n        # Tie-breaking: if current_strength == max_strength, keep the one that came first.\n        # So no action is needed here if they are equal.\n\n    return f\"{class_name}.{strongest_extension_name}\"", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/94": [{"task_id": "HumanEval/94", "solution": "import math\ndef _is_prime(n: int) -> bool:\n    \"\"\"\n    Determines if a given integer n is a prime number.\n    \"\"\"\n    if n <= 1:\n        return False\n    if n <= 3:\n        return True\n    if n % 2 == 0 or n % 3 == 0:\n        return False\n    i = 5\n    while i * i <= n:\n        if n % i == 0 or n % (i + 2) == 0:\n            return False\n        i += 6\n    return True\ndef _sum_digits(n: int) -> int:\n    \"\"\"\n    Calculates the sum of the individual digits of a given integer n.\n    \"\"\"\n    s = 0\n    abs_n = abs(n)\n    while abs_n > 0:\n        s += abs_n % 10\n        abs_n //= 10\n    return s\ndef skjkasdkd(lst):\n    \"\"\"You are given a list of integers.\n    You need to find the largest prime value and return the sum of its digits.\n    \"\"\"\n    primes = []\n    for num in lst:\n        if _is_prime(num):\n            primes.append(num)\n\n    if not primes:\n        return 0\n\n    largest_prime = max(primes)\n    return _sum_digits(largest_prime)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/151": [{"task_id": "HumanEval/151", "solution": "def double_the_difference(lst):\n    '''\n    Given a list of numbers, return the sum of squares of the numbers\n    in the list that are odd. Ignore numbers that are negative or not integers.\n\n    double_the_difference([1, 3, 2, 0]) == 1 + 9 + 0 + 0 = 10\n    double_the_difference([-1, -2, 0]) == 0\n    double_the_difference([9, -2]) == 81\n    double_the_difference([0]) == 0\n\n    If the input list is empty, return 0.\n    '''\n\n    def is_valid_odd_non_negative_integer(num):\n        \"\"\"Checks if the given input is an odd, non-negative integer.\"\"\"\n        if not isinstance(num, (int, float)) or isinstance(num, bool):\n            return False\n        if isinstance(num, float) and not num.is_integer():\n            return False\n\n        num_as_int = int(num)\n\n        if num_as_int < 0:\n            return False\n\n        if num_as_int % 2 == 0:\n            return False\n\n        return True\n\n    def square_number(num):\n        \"\"\"Calculates the square of an integer.\"\"\"\n        return num * num\n\n    if not lst:\n        return 0\n\n    total_sum = 0\n    for item in lst:\n        if is_valid_odd_non_negative_integer(item):\n            total_sum += square_number(int(item))\n\n    return total_sum", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[[1.0, 3.5, -4.6]]]}], "HumanEval/155": [{"task_id": "HumanEval/155", "solution": "def even_odd_count(num):\n    \"\"\"Given an integer. return a tuple that has the number of even and odd digits respectively.\n\n     Example:\n        even_odd_count(-12) ==> (1, 1)\n        even_odd_count(123) ==> (1, 2)\n    \"\"\"\n    even_count = 0\n    odd_count = 0\n\n    # Convert the absolute value of the number to a string to iterate through digits.\n    abs_num_str = str(abs(num))\n\n    for char_digit in abs_num_str:\n        digit = int(char_digit)\n        if digit % 2 == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n\n    return (even_count, odd_count)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/156": [{"task_id": "HumanEval/156", "solution": "def int_to_mini_roman(number):\n    \"\"\"\n    Given a positive integer, obtain its roman numeral equivalent as a string,\n    and return it in lowercase.\n    Restrictions: 1 <= num <= 1000\n    \"\"\"\n    # Define the Roman numeral map with values and symbols in descending order.\n    roman_map = [\n        (1000, 'M'), (900, 'CM'), (500, 'D'), (400, 'CD'),\n        (100, 'C'), (90, 'XC'), (50, 'L'), (40, 'XL'),\n        (10, 'X'), (9, 'IX'), (5, 'V'), (4, 'IV'), (1, 'I')\n    ]\n\n    result = []\n\n    # Iterate through the Roman map, repeatedly subtracting values and appending symbols.\n    for value, symbol in roman_map:\n        while number >= value:\n            result.append(symbol)\n            number -= value\n\n    # Join the symbols to form the Roman numeral string and convert to lowercase.\n    return \"\".join(result).lower()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/154": [{"task_id": "HumanEval/154", "solution": "def cycpattern_check(a , b):\n    \"\"\"You are given 2 words. You need to return True if the second word or any of its rotations is a substring in the first word\n    cycpattern_check(\"abcd\",\"abd\") => False\n    cycpattern_check(\"hello\",\"ell\") => True\n    cycpattern_check(\"whassup\",\"psus\") => False\n    cycpattern_check(\"abab\",\"baa\") => True\n    cycpattern_check(\"efef\",\"eeff\") => False\n    cycpattern_check(\"himenss\",\"simen\") => True\n\n    \"\"\"\n    from typing import List\n\n    # Helper class for string encapsulation as per design\n    class InputString:\n        def __init__(self, value: str):\n            self._value = value\n\n        def get_value(self) -> str:\n            return self._value\n\n        def __len__(self) -> int:\n            return len(self._value)\n\n        def __str__(self) -> str:\n            return self._value\n\n    # Helper class for generating cyclic rotations as per design\n    class CyclicRotationsGenerator:\n        @staticmethod\n        def generate(source: InputString) -> List[str]:\n            s = source.get_value()\n            n = len(s)\n\n            if n == 0:\n                return [\"\"] # An empty string has one \"rotation\": itself\n\n            rotations = []\n            for i in range(n):\n                rotated_s = s[i:] + s[:i]\n                rotations.append(rotated_s)\n            return rotations\n\n    # Main logic for cycpattern_check\n    input_a = InputString(a)\n    input_b = InputString(b)\n\n    # Generate all cyclic rotations of b\n    rotations_of_b = CyclicRotationsGenerator.generate(input_b)\n\n    # Check if any rotation is a substring of a\n    target_string_a = input_a.get_value()\n    for rotation in rotations_of_b:\n        if rotation in target_string_a:\n            return True\n\n    return False", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/157": [{"task_id": "HumanEval/157", "solution": "def right_angle_triangle(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle. Return True if the three\n    sides form a right-angled triangle, False otherwise.\n    '''\n    EPSILON = 1e-9  # A small constant for robust floating-point comparisons.\n\n    # Calculate squares of the sides\n    a_sq = a * a\n    b_sq = b * b\n    c_sq = c * c\n\n    # Check the Pythagorean theorem for all three possible hypotenuses\n    if abs(a_sq + b_sq - c_sq) < EPSILON:\n        return True\n    if abs(a_sq + c_sq - b_sq) < EPSILON:\n        return True\n    if abs(b_sq + c_sq - a_sq) < EPSILON:\n        return True\n\n    return False", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/159": [{"task_id": "HumanEval/159", "solution": "def eat(number, need, remaining):\n    \"\"\"\n    You're a hungry rabbit, and you already have eaten a certain number of carrots,\n    but now you need to eat more carrots to complete the day's meals.\n    you should return an array of [ total number of eaten carrots after your meals,\n                                    the number of carrots left after your meals ]\n    if there are not enough remaining carrots, you will eat all remaining carrots, but will still be hungry.\n    \"\"\"\n    # Determine how many carrots the rabbit actually eats from the stock.\n    # It will eat either what it needs or what is available, whichever is less.\n    carrots_eaten_from_stock = min(need, remaining)\n\n    # Calculate the total number of carrots eaten by adding the current consumption to what was already eaten.\n    total_eaten = number + carrots_eaten_from_stock\n\n    # Calculate the remaining carrots in stock after the meal.\n    carrots_left = remaining - carrots_eaten_from_stock\n\n    # Return the results as an array.\n    return [total_eaten, carrots_left]", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/158": [{"task_id": "HumanEval/158", "solution": "def find_max(words):\n    \"\"\"Returns the word with the maximum number of unique characters.\n    If multiple strings have the maximum, the lexicographically smallest is returned.\n    \"\"\"\n    class Word:\n        \"\"\"Encapsulates a string, its unique character count, and comparison logic.\"\"\"\n        def __init__(self, value: str):\n            self._value = value\n            self._unique_character_count = len(set(value))\n\n        def get_value(self) -> str:\n            \"\"\"Returns the string value of the word.\"\"\"\n            return self._value\n\n        def get_unique_character_count(self) -> int:\n            \"\"\"Returns the cached unique character count.\"\"\"\n            return self._unique_character_count\n\n        def __lt__(self, other: 'Word') -> bool:\n            \"\"\"Compares words for ordering: more unique characters, then lexicographically smaller.\"\"\"\n            if self._unique_character_count != other._unique_character_count:\n                return self._unique_character_count > other._unique_character_count\n            return self._value < other._value\n\n        def __eq__(self, other: 'Word') -> bool:\n            \"\"\"Checks if two words have the same string value.\"\"\"\n            return self._value == other._value\n\n    if not words:\n        return \"\"\n\n    word_objects = [Word(word_str) for word_str in words]\n\n    max_word_obj = None\n\n    for current_word_obj in word_objects:\n        if max_word_obj is None:\n            max_word_obj = current_word_obj\n        else:\n            current_unique = current_word_obj.get_unique_character_count()\n            max_unique = max_word_obj.get_unique_character_count()\n\n            if current_unique > max_unique:\n                max_word_obj = current_word_obj\n            elif current_unique == max_unique:\n                # Tie-breaking: if unique counts are equal, choose the lexicographically smaller word\n                if current_word_obj.get_value() < max_word_obj.get_value():\n                    max_word_obj = current_word_obj\n\n    return max_word_obj.get_value()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/161": [{"task_id": "HumanEval/161", "solution": "def solve(s):\n    \"\"\"Transforms the input string by reversing letter cases or reversing the whole string if it contains no letters.\"\"\"\n    has_letters = False\n    for char in s:\n        if char.isalpha():\n            has_letters = True\n            break\n\n    if not has_letters:\n        return s[::-1]\n    else:\n        result_chars = []\n        for char in s:\n            if char.isalpha():\n                if char.islower():\n                    result_chars.append(char.upper())\n                else:\n                    result_chars.append(char.lower())\n            else:\n                result_chars.append(char)\n        return \"\".join(result_chars)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/160": [{"task_id": "HumanEval/160", "solution": "def do_algebra(operator, operand):\n    \"\"\"\n    Given two lists operator, and operand. The first list has basic algebra operations, and\n    the second list is a list of integers. Use the two given lists to build the algebric\n    expression and return the evaluation of this expression.\n    \"\"\"\n    expression_parts = []\n    expression_parts.append(str(operand[0]))\n\n    for i in range(len(operator)):\n        expression_parts.append(operator[i])\n        expression_parts.append(str(operand[i + 1]))\n\n    expression_string = ' '.join(expression_parts)\n    result = eval(expression_string)\n    return result", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/162": [{"task_id": "HumanEval/162", "solution": "import hashlib\nfrom typing import Optional\ndef string_to_md5(text: str) -> Optional[str]:\n    \"\"\"\n    Given a string 'text', return its md5 hash equivalent string.\n    If 'text' is an empty string, return None.\n    \"\"\"\n    if not text:\n        return None\n    # Encode the string to bytes before hashing and return its hexadecimal digest.\n    md5_hash = hashlib.md5(text.encode('utf-8'))\n    return md5_hash.hexdigest()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/163": [{"task_id": "HumanEval/163", "solution": "def generate_integers(a, b):\n    \"\"\"\n    Given two positive integers a and b, return the even digits between a\n    and b, in ascending order.\n\n    For example:\n    generate_integers(2, 8) => [2, 4, 6, 8]\n    generate_integers(8, 2) => [2, 4, 6, 8]\n    generate_integers(10, 14) => []\n    \"\"\"\n    min_val = min(a, b)\n    max_val = max(a, b)\n\n    # Define the specific even single-digit numbers to consider.\n    even_single_digits = (2, 4, 6, 8)\n\n    result_list = []\n    for digit in even_single_digits:\n        if min_val <= digit <= max_val:\n            result_list.append(digit)\n\n    # Ensure the result is in ascending order, as required.\n    result_list.sort()\n\n    return result_list", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/83": [{"task_id": "HumanEval/83", "solution": "def starts_one_ends(n):\n    \"\"\"\n    Given a positive integer n, return the count of the numbers of n-digit\n    positive integers that start or end with 1.\n    \"\"\"\n    if n == 1:\n        return 1\n    else:\n        # Calculate 10^(n-2). Python's int handles arbitrary precision.\n        power_of_ten = 10**(n - 2)\n        # The total count is 18 * 10^(n-2) for n > 1.\n        count = 18 * power_of_ten\n        return count", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/129": [{"task_id": "HumanEval/129", "solution": "def minPath(grid, k):\n    \"\"\"\n    Finds the lexicographically smallest path of length k in the grid.\n    Returns an ordered list of cell values for the minimum path.\n    \"\"\"\n\n    class InputValidator:\n        \"\"\"Provides static methods to validate the input grid and k.\"\"\"\n\n        @staticmethod\n        def validate_grid(grid_data):\n            N = len(grid_data)\n            if N < 2:\n                raise ValueError(\"Grid N must be greater than or equal to 2.\")\n\n            seen_values = set()\n            expected_values = set(range(1, N * N + 1))\n\n            for r_idx, row in enumerate(grid_data):\n                if len(row) != N:\n                    raise ValueError(\"Grid must be square (N x N).\")\n                for c_idx, val in enumerate(row):\n                    if not isinstance(val, int) or val < 1 or val > N * N:\n                        raise ValueError(f\"Grid cell value {val} at ({r_idx},{c_idx}) is out of range [1, N*N].\")\n                    if val in seen_values:\n                        raise ValueError(f\"Grid value {val} is not unique.\")\n                    seen_values.add(val)\n\n            if seen_values != expected_values:\n                raise ValueError(\"Grid values do not contain all integers from 1 to N*N exactly once.\")\n\n        @staticmethod\n        def validate_k(k_val):\n            if not isinstance(k_val, int) or k_val <= 0:\n                raise ValueError(\"Path length k must be a positive integer.\")\n\n        @staticmethod\n        def validate_all(grid_data, k_val):\n            InputValidator.validate_grid(grid_data)\n            InputValidator.validate_k(k_val)\n\n    class Grid:\n        \"\"\"Encapsulates grid data and provides methods for access and neighbor finding.\"\"\"\n        def __init__(self, grid_data):\n            self._N = len(grid_data)\n            self._grid_values = grid_data\n\n        def get_value(self, r, c):\n            return self._grid_values[r][c]\n\n        def is_valid_coord(self, r, c):\n            return 0 <= r < self._N and 0 <= c < self._N\n\n        def get_neighbors(self, r, c):\n            neighbors = []\n            directions = [(-1, 0), (1, 0), (0, -1), (0, 1)] # Up, Down, Left, Right\n            for dr, dc in directions:\n                nr, nc = r + dr, c + dc\n                if self.is_valid_coord(nr, nc):\n                    neighbors.append((nr, nc))\n            return neighbors\n\n        def get_all_start_cells(self):\n            cells = []\n            for r in range(self._N):\n                for c in range(self._N):\n                    cells.append((r, c))\n            return cells\n\n    class Path:\n        \"\"\"Represents a path as an ordered list of cell values and supports lexicographical comparison.\"\"\"\n        def __init__(self, values):\n            self._cell_values = list(values) # Ensure a copy is stored\n\n        def get_values(self):\n            return self._cell_values\n\n        def __lt__(self, other):\n            return self._cell_values < other._cell_values\n\n        def __eq__(self, other):\n            return self._cell_values == other._cell_values\n\n    class PathFinder:\n        \"\"\"Implements recursive path exploration (DFS) to find the lexicographically smallest path.\"\"\"\n        def __init__(self, grid_obj, k_val):\n            self._grid = grid_obj\n            self._k = k_val\n            self._min_path = None # Stores the current minimum Path object found\n\n        def find_minimum_path(self):\n            for r, c in self._grid.get_all_start_cells():\n                self._explore_paths(r, c, [self._grid.get_value(r, c)])\n            return self._min_path\n\n        def _explore_paths(self, r, c, current_path_values):\n            if len(current_path_values) == self._k:\n                current_path = Path(current_path_values)\n                if self._min_path is None or current_path < self._min_path:\n                    self._min_path = current_path\n                return\n\n            if self._min_path is not None and Path(current_path_values + [float('inf')] * (self._k - len(current_path_values))) > self._min_path:\n                # Optimization: if current prefix already guarantees a larger path, prune\n                return\n\n            for nr, nc in self._grid.get_neighbors(r, c):\n                self._explore_paths(nr, nc, current_path_values + [self._grid.get_value(nr, nc)])\n\n    InputValidator.validate_all(grid, k)\n\n    grid_obj = Grid(grid)\n    path_finder = PathFinder(grid_obj, k)\n    result_path_obj = path_finder.find_minimum_path()\n\n    return result_path_obj.get_values()", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[[[10, 5, 20, 14, 16], [7, 11, 12, 17, 9], [13, 19, 1, 15, 8], [3, 18, 4, 6, 2], [22, 21, 23, 24, 25]], 23]]}], "HumanEval/15": [{"task_id": "HumanEval/15", "solution": "def string_sequence(n: int) -> str:\n    \"\"\" Return a string containing space-delimited numbers starting from 0 upto n inclusive.\n    >>> string_sequence(0)\n    '0'\n    >>> string_sequence(5)\n    '0 1 2 3 4 5'\n    \"\"\"\n    return \" \".join(str(i) for i in range(n + 1))", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/147": [{"task_id": "HumanEval/147", "solution": "def get_max_triples(n):\n    \"\"\"\n    Calculates the number of triples (a[i], a[j], a[k]) from an array 'a' where i < j < k\n    and their sum is a multiple of 3.\n    \"\"\"\n    if n < 3: # Minimum n for a triple is 3\n        return 0\n\n    a = []\n    # Generate the array 'a' using the formula a[i] = i * i - i + 1 (1-based i)\n    # Using 0-based indexing for the list, a[idx] corresponds to i = idx + 1\n    for idx in range(n):\n        i_1_based = idx + 1\n        a.append(i_1_based * i_1_based - i_1_based + 1)\n\n    count = 0\n    length_a = len(a)\n\n    # Iterate through all unique combinations of indices i, j, k such that i < j < k\n    for i in range(length_a):\n        for j in range(i + 1, length_a):\n            for k in range(j + 1, length_a):\n                current_sum = a[i] + a[j] + a[k]\n                # Check if the sum is a multiple of 3\n                if current_sum % 3 == 0:\n                    count += 1\n    return count", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/130": [{"task_id": "HumanEval/130", "solution": "def tri(n):\n    \"\"\"Calculates the first n+1 numbers of the Tribonacci sequence.\n\n    The sequence is defined with tri(0)=1, tri(1)=3, tri(n)=1+n//2 for even n>=2,\n    and tri(n)=tri(n-1)+tri(n-2)+tri(n+1) for odd n>=3.\n    \"\"\"\n    if n < 0:\n        return []\n\n    trib_sequence = [0] * (n + 1)\n\n    if n >= 0:\n        trib_sequence[0] = 1\n    if n >= 1:\n        trib_sequence[1] = 3\n\n    for i in range(2, n + 1):\n        if i % 2 == 0:  # n is even\n            trib_sequence[i] = 1 + i // 2\n        else:  # n is odd\n            # tri(i+1) is needed, and i+1 is always even\n            # tri(i+1) = 1 + (i+1) // 2\n            trib_sequence[i] = trib_sequence[i - 1] + trib_sequence[i - 2] + (1 + (i + 1) // 2)\n\n    return trib_sequence", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/139": [{"task_id": "HumanEval/139", "solution": "def special_factorial(n):\n    \"\"\"The Brazilian factorial is defined as:\n    brazilian_factorial(n) = n! * (n-1)! * (n-2)! * ... * 1!\n    where n > 0\n\n    For example:\n    >>> special_factorial(4)\n    288\n\n    The function will receive an integer as input and should return the special\n    factorial of this integer.\n    \"\"\"\n    def _factorial(k):\n        \"\"\"Calculates the standard factorial of a non-negative integer k.\"\"\"\n        if k == 0:\n            return 1\n        res = 1\n        for i in range(1, k + 1):\n            res *= i\n        return res\n\n    if n <= 0:\n        raise ValueError(\"Input n must be greater than 0.\")\n\n    special_product = 1\n    for i in range(1, n + 1):\n        special_product *= _factorial(i)\n\n    return special_product", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}]}}