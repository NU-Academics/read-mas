f digit '7' in x.\"\"\"\n        count = 0\n        for digit_char in str(x):\n            if digit_char == '7':\n                count += 1\n        return count\n\n    total_sevens_count = 0\n    for i in range(1, n):\n        if _is_divisible_by_11_or_13(i):\n            total_sevens_count += _count_digit_7(i)\n    return total_sevens_count", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/119": [{"task_id": "HumanEval/119", "solution": "class ParenthesisString:\n    '''Encapsulates a parenthesis string and provides methods to calculate its balance properties and determine if it's a 'good' string.'''\n    def __init__(self, content: str):\n        self._content = content\n        self._balance: int = 0\n        self._min_balance: int = 0\n        self._calculate_balance_info()\n\n    def _calculate_balance_info(self):\n        current_balance = 0\n        min_seen_balance = 0\n        for char in self._content:\n            if char == '(':\n                current_balance += 1\n            else: # char == ')'\n                current_balance -= 1\n            min_seen_balance = min(min_seen_balance, current_balance)\n        self._balance = current_balance\n        self._min_balance = min_seen_balance\n\n    def get_balance(self) -> int:\n        return self._balance\n\n    def get_min_balance(self) -> int:\n        return self._min_balance\n\n    def is_good(self) -> bool:\n        return self._balance == 0 and self._min_balance >= 0\nclass StringPair:\n    '''Manages two ParenthesisString objects and determines if their concatenations form a 'good' string.'''\n    def __init__(self, s1: str, s2: str):\n        self._string1 = ParenthesisString(s1)\n        self._string2 = ParenthesisString(s2)\n\n    def _get_concatenation_info(self, first: ParenthesisString, second: ParenthesisString) -> tuple[int, int]:\n        combined_balance = first.get_balance() + second.get_balance()\n        combined_min_balance 