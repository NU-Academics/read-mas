{"task_id": "HumanEval/103", "solution": "```python\nfrom typing import Union\nimport math\n\nclass MathUtils:\n    @staticmethod\n    def calculate_sum_range(n: int, m: int) -> int:\n        \"\"\"Calculates the sum of integers from n to m (inclusive).\n        Uses the arithmetic series formula for efficiency.\n        \"\"\"\n        count = m - n + 1\n        return (count * (n + m)) // 2\n\n    @staticmethod\n    def round_to_nearest_int(value: float) -> int:\n        \"\"\"Rounds a floating-point number to the nearest integer using standard Python rounding.\"\"\"\n        return round(value)\n\n    @staticmethod\n    def to_binary_string(value: int) -> str:\n        \"\"\"Converts an integer to its binary string representation, including the \"0b\" prefix.\"\"\"\n        return bin(value)\n\nclass AverageCalculator:\n    def rounded_avg(self, n: int, m: int) -> Union[str, int]:\n        \"\"\"\n        Computes the rounded average of integers in a range and returns its binary representation.\n        Returns -1 if n is greater than m, indicating an invalid range.\n        \"\"\"\n        if n > m:\n            return -1\n\n        sum_of_range = MathUtils.calculate_sum_range(n, m)\n        count = m - n + 1\n        average_float = sum_of_range / count\n        rounded_int = MathUtils.round_to_nearest_int(average_float)\n        return MathUtils.to_binary_string(rounded_int)\n```"}
{"task_id": "HumanEval/104", "solution": "```python\ndef unique_digits(x):\n    \"\"\"Given a list of positive integers x. return a sorted list of all\n    elements that hasn't any even digit.\n\n    Note: Returned list should be sorted in increasing order.\n\n    For example:\n    >>> unique_digits([15, 33, 1422, 1])\n    [1, 15, 33]\n    >>> unique_digits([152, 323, 1422, 10])\n    []\n    \"\"\"\n    def has_even_digit(number: int) -> bool:\n        \"\"\"Checks if the given number contains any even digit.\"\"\"\n        for digit_char in str(number):\n            digit = int(digit_char)\n            if digit % 2 == 0:\n                return True\n        return False\n\n    filtered_list = []\n    for num in x:\n        if not has_even_digit(num):\n            filtered_list.append(num)\n\n    filtered_list.sort()\n    return filtered_list\n```"}
{"task_id": "HumanEval/103", "solution": "```python\ndef rounded_avg(n, m):\n    \"\"\"You are given two positive integers n and m, and your task is to compute the\n    average of the integers from n through m (including n and m).\n    Round the answer to the nearest integer and convert that to binary.\n    If n is greater than m, return -1.\n    Example:\n    rounded_avg(1, 5) => \"0b11\"\n    rounded_avg(7, 5) => -1\n    rounded_avg(10, 20) => \"0b1111\"\n    rounded_avg(20, 33) => \"0b11010\"\n    \"\"\"\n    if n > m:\n        return -1\n\n    # Calculate the sum of integers from n to m using the arithmetic series formula.\n    # The count of numbers in the range [n, m] is (m - n + 1).\n    # The sum is (count * (first_term + last_term)) // 2.\n    sum_val = (m - n + 1) * (n + m) // 2\n\n    # Calculate the count of integers in the range [n, m].\n    count_val = m - n + 1\n\n    # Compute the average.\n    average = sum_val / count_val\n\n    # Round the average to the nearest integer.\n    # Python's round() function rounds halves to the nearest even integer.\n    rounded_average = round(average)\n\n    # Convert the rounded integer average to its binary string representation.\n    return bin(rounded_average)\n```"}
{"task_id": "HumanEval/104", "solution": "```python\n# src/validators.py\n\nclass DigitValidator:\n    \"\"\"\n    Utility class for validating digits within numbers.\n    It checks for the presence of even digits and validates positive integers.\n    \"\"\"\n    EVEN_DIGITS = {0, 2, 4, 6, 8}\n\n    def has_even_digit(self, number: int) -> bool:\n        \"\"\"\n        Checks if a given integer contains any even digits.\n        It iterates through the number's digits to find an even one.\n        \"\"\"\n        # Assumes 'number' is a positive integer due to upstream validation.\n        for digit_char in str(number):\n            if int(digit_char) in self.EVEN_DIGITS:\n                return True\n        return False\n\n    def is_positive_integer(self, value: any) -> bool:\n        \"\"\"\n        Checks if a given value is an integer and is positive.\n        Returns True if the value meets both criteria, False otherwise.\n        \"\"\"\n        return isinstance(value, int) and value > 0\n\n```\n```python\n# src/unique_digits_filter.py\n\nfrom src.validators import DigitValidator\n\nclass UniqueDigitsFilter:\n    \"\"\"\n    Filters a list of numbers, keeping only those with all odd digits, and sorts them.\n    This class handles the core business logic and input validation.\n    \"\"\"\n    def __init__(self, digit_validator: DigitValidator = None):\n        \"\"\"\n        Initializes the filter with a DigitValidator instance.\n        If none is provided, a default one is created.\n        \"\"\"\n        self._digit_validator = digit_validator if digit_validator is not None else DigitValidator()\n\n    def filter_and_sort(self, numbers: list[int]) -> list[int]:\n        \"\"\"\n        Given a list of positive integers, returns a sorted list of all\n        elements that haven't any even digit.\n        \"\"\"\n        if not isinstance(numbers, list):\n            raise TypeError(\"Input 'numbers' must be a list.\")\n\n        filtered_numbers = []\n        for num in numbers:\n            if not self._digit_validator.is_positive_integer(num):\n                raise ValueError(f\"All elements in the list must be positive integers. Found: {num}\")\n            \n            if not self._digit_validator.has_even_digit(num):\n                filtered_numbers.append(num)\n        \n        return sorted(filtered_numbers)\n\ndef unique_digits(x: list[int]) -> list[int]:\n    \"\"\"\n    Given a list of positive integers x. return a sorted list of all \n    elements that hasn't any even digit.\n\n    Note: Returned list should be sorted in increasing order.\n    \n    For example:\n    >>> unique_digits([15, 33, 1422, 1])\n    [1, 15, 33]\n    >>> unique_digits([152, 323, 1422, 10])\n    []\n    \"\"\"\n    filter_service = UniqueDigitsFilter()\n    return filter_service.filter_and_sort(x)\n\n```\n```toml\n# pyproject.toml\n\n[project]\nname = \"unique-digits-filter\"\nversion = \"0.1.0\"\ndescription = \"A utility to filter a list of positive integers based on the parity of their digits.\"\nauthors = [\n    { name = \"Your Name\", email = \"your.email@example.com\" }, # Placeholder, replace with actual author info\n]\nrequires-python = \">=3.9\"\nreadme = \"README.md\"\nlicense = { text = \"MIT\" }\nclassifiers = [\n    \"Programming Language :: Python :: 3\",\n    \"License :: OSI Approved :: MIT License\",\n    \"Operating System :: OS Independent\",\n]\n\n[build-system]\nrequires = [\"setuptools>=61.0\"]\nbuild-backend = \"setuptools.build_meta\"\n```"}
{"task_id": "HumanEval/105", "solution": "```python\n# src/number_converter/constants.py\n\nDIGIT_WORDS: dict[int, str] = {\n    1: \"One\",\n    2: \"Two\",\n    3: \"Three\",\n    4: \"Four\",\n    5: \"Five\",\n    6: \"Six\",\n    7: \"Seven\",\n    8: \"Eight\",\n    9: \"Nine\",\n}\n```\n```python\n# src/number_converter/services.py\nfrom src.number_converter.constants import DIGIT_WORDS\n\nclass NumberConverterService:\n    @staticmethod\n    def by_length(arr: list[int]) -> list[str]:\n        \"\"\"\n        Transforms an array of integers into an array of corresponding word names.\n        It filters, sorts, reverses, and then maps digits to words.\n        \"\"\"\n        if not arr:\n            return []\n\n        # Filters numbers between 1 and 9 inclusive, ignoring others.\n        filtered_numbers = [num for num in arr if isinstance(num, int) and 1 <= num <= 9]\n\n        # Sorts the valid numbers in ascending order.\n        filtered_numbers.sort()\n\n        # Reverses the sorted list to be in descending order.\n        filtered_numbers.reverse()\n\n        # Replaces each digit with its corresponding word name.\n        result = [DIGIT_WORDS[num] for num in filtered_numbers]\n\n        return result\n```"}
{"task_id": "HumanEval/105", "solution": "DIGIT_TO_WORD_MAP = {\n    1: \"One\",\n    2: \"Two\",\n    3: \"Three\",\n    4: \"Four\",\n    5: \"Five\",\n    6: \"Six\",\n    7: \"Seven\",\n    8: \"Eight\",\n    9: \"Nine\",\n}\n\nclass NumberValidator:\n    def is_valid_digit(self, num: int) -> bool:\n        \"\"\"Checks if an integer is between 1 and 9 inclusive.\"\"\"\n        return 1 <= num <= 9\n\nclass DigitWordService:\n    def __init__(self, digit_to_word_map: dict[int, str]):\n        \"\"\"Initializes the service with a digit-to-word mapping.\"\"\"\n        self._digit_to_word_map = digit_to_word_map\n\n    def convert_to_word(self, digit: int) -> str:\n        \"\"\"Retrieves the English word name for a given digit.\"\"\"\n        return self._digit_to_word_map[digit]\n\nclass ArrayProcessor:\n    def __init__(self, number_validator: NumberValidator, digit_word_service: DigitWordService):\n        \"\"\"Initializes ArrayProcessor with required validator and service.\"\"\"\n        self._number_validator = number_validator\n        self._digit_word_service = digit_word_service\n\n    def by_length(self, arr: list[int]) -> list[str]:\n        \"\"\"\n        Filters an array for digits 1-9, sorts, reverses, and converts to word names.\n        Returns an empty list if no valid digits are found or the input is empty.\n        \"\"\"\n        if not arr:\n            return []\n\n        # FR1: Filter an input array to include only integers between 1 and 9 inclusive.\n        filtered_digits = [\n            num for num in arr if self._number_validator.is_valid_digit(num)\n        ]\n\n        # FR5: Return an empty array if the input array is empty or contains no valid numbers.\n        if not filtered_digits:\n            return []\n\n        # FR2: Sort the filtered integers in ascending order.\n        sorted_digits = sorted(filtered_digits)\n        # FR3: Reverse the sorted array.\n        reversed_digits = sorted_digits[::-1]\n\n        # FR4: Replace each integer with its corresponding English word name.\n        word_names = [self._digit_word_service.convert_to_word(digit) for digit in reversed_digits]\n\n        return word_names\n\ndef by_length(arr: list[int]) -> list[str]:\n    \"\"\"\n    Given an array of integers, sort the integers that are between 1 and 9 inclusive,\n    reverse the resulting array, and then replace each digit by its corresponding name from\n    \"One\", \"Two\", \"Three\", \"Four\", \"Five\", \"Six\", \"Seven\", \"Eight\", \"Nine\".\n\n    For example:\n      arr = [2, 1, 1, 4, 5, 8, 2, 3]\n            -> sort arr -> [1, 1, 2, 2, 3, 4, 5, 8]\n            -> reverse arr -> [8, 5, 4, 3, 2, 2, 1, 1]\n      return [\"Eight\", \"Five\", \"Four\", \"Three\", \"Two\", \"Two\", \"One\", \"One\"]\n\n      If the array is empty, return an empty array:\n      arr = []\n      return []\n\n      If the array has any strange number ignore it:\n      arr = [1, -1 , 55]\n            -> sort arr -> [-1, 1, 55]\n            -> reverse arr -> [55, 1, -1]\n      return = ['One']\n    \"\"\"\n    validator = NumberValidator()\n    converter = DigitWordService(DIGIT_TO_WORD_MAP)\n    processor = ArrayProcessor(validator, converter)\n    return processor.by_length(arr)"}
{"task_id": "HumanEval/106", "solution": "```python\n# src/math_operations/__init__.py\n# This file initializes the math_operations package.\n```\n```python\n# src/math_operations/calculations.py\nclass CalculationsService:\n    \"\"\"Provides core mathematical functions for sequence generation.\n    All methods are static and perform specific calculations as defined.\"\"\"\n\n    @staticmethod\n    def _factorial(i: int) -> int:\n        \"\"\"Calculates the factorial of a non-negative integer.\n        Raises ValueError for negative inputs or TypeError for non-integers.\"\"\"\n        if not isinstance(i, int):\n            raise TypeError(\"Input must be an integer.\")\n        if i < 0:\n            raise ValueError(\"Factorial is not defined for negative numbers.\")\n        if i == 0 or i == 1:\n            return 1\n        res = 1\n        for num in range(2, i + 1):\n            res *= num\n        return res\n\n    @staticmethod\n    def _sum_up_to(i: int) -> int:\n        \"\"\"Calculates the sum of numbers from 1 to a non-negative integer.\n        Raises ValueError for negative inputs or TypeError for non-integers.\"\"\"\n        if not isinstance(i, int):\n            raise TypeError(\"Input must be an integer.\")\n        if i < 0:\n            raise ValueError(\"Sum up to is not defined for negative numbers in this context.\")\n        if i == 0:\n            return 0\n        return i * (i + 1) // 2\n\n    @staticmethod\n    def f(n: int) -> list[int]:\n        \"\"\"Generates a list of n calculated values based on index parity.\n        Even indices get factorial, odd get sum up to; returns an empty list if n <= 0.\"\"\"\n        if not isinstance(n, int):\n            raise TypeError(\"Input 'n' must be an integer.\")\n        if n <= 0:\n            return []\n\n        result = []\n        for i in range(1, n + 1):\n            if i % 2 == 0:  # Even index\n                result.append(CalculationsService._factorial(i))\n            else:  # Odd index\n                result.append(CalculationsService._sum_up_to(i))\n        return result\n\n```\n```python\n# src/main.py\nfrom math_operations.calculations import CalculationsService\n\ndef main():\n    \"\"\"Demonstrates the usage of the f(n) function with various inputs.\n    It prints the results of sample calls and handles expected errors.\"\"\"\n    print(\"--- Results of CalculationsService.f(n) ---\")\n    print(f\"f(5) == {CalculationsService.f(5)}\")\n    print(f\"f(1) == {CalculationsService.f(1)}\")\n    print(f\"f(0) == {CalculationsService.f(0)}\")\n    print(f\"f(10) == {CalculationsService.f(10)}\")\n\n    print(\"\\n--- Error Handling Examples ---\")\n    try:\n        CalculationsService.f(2.5)\n    except TypeError as e:\n        print(f\"Caught expected TypeError for f(2.5): {e}\")\n\n    try:\n        CalculationsService._factorial(-5)\n    except ValueError as e:\n        print(f\"Caught expected ValueError for _factorial(-5): {e}\")\n\n    try:\n        CalculationsService._sum_up_to(\"invalid\")\n    except TypeError as e:\n        print(f\"Caught expected TypeError for _sum_up_to('invalid'): {e}\")\n\n\nif __name__ == \"__main__\":\n    main()\n\n```\n```toml\n# pyproject.toml\n[project]\nname = \"math-operations-utility\"\nversion = \"0.1.0\"\ndescription = \"A utility for generating lists of calculated values based on index rules.\"\nauthors = [{ name = \"Generated Code\", email = \"dev@example.com\" }]\nreadme = \"README.md\"\nrequires-python = \">=3.8\"\nlicense = { text = \"MIT\" }\nkeywords = [\"math\", \"utility\", \"factorial\", \"sum\"]\n\n[build-system]\nrequires = [\"setuptools>=61.0\"]\nbuild-backend = \"setuptools.build_meta\"\n\n```\n```markdown\n# README.md\n# Math Operations Utility\n\nThis project provides a Python utility function `f(n)` that generates a list of calculated values. The calculations depend on the 1-based index `i`: factorial for even indices and sum of numbers up to `i` for odd indices.\n\n## Installation\n\nThis is a self-contained Python package. To install it, navigate to the root directory containing `pyproject.toml` and run:\n\n```bash\npip install .\n```\n\n## Usage\n\nYou can use the `f(n)` function from `CalculationsService` directly in your Python code:\n\n```python\nfrom math_operations.calculations import CalculationsService\n\n# Generate a list for n=5\nresult = CalculationsService.f(5)\nprint(f\"f(5) = {result}\")\n# Expected output: f(5) = [1, 2, 6, 24, 15]\n\n# Generate a list for n=0\nresult_zero = CalculationsService.f(0)\nprint(f\"f(0) = {result_zero}\")\n# Expected output: f(0) = []\n\n# Handling invalid input\ntry:\n    CalculationsService.f(\"invalid\")\nexcept TypeError as e:\n    print(f\"Error: {e}\")\n```\n\nTo see an example of its usage and error handling, you can run the `main.py` script:\n\n```bash\npython src/main.py\n```\n```"}
{"task_id": "HumanEval/106", "solution": "```python\n# src/utils.py\nfrom typing import List\n\nclass MathUtils:\n    \"\"\"Provides fundamental mathematical utility functions.\"\"\"\n\n    def factorial(self, k: int) -> int:\n        \"\"\"Calculates the factorial of a non-negative integer k.\"\"\"\n        if not isinstance(k, int):\n            raise TypeError(\"Input must be an integer.\")\n        if k < 0:\n            raise ValueError(\"Factorial is not defined for negative numbers.\")\n        \n        if k == 0:\n            return 1\n        res = 1\n        for i in range(1, k + 1):\n            res *= i\n        return res\n\n    def sum_up_to(self, k: int) -> int:\n        \"\"\"Calculates the sum of all integers from 1 to k.\"\"\"\n        if not isinstance(k, int):\n            raise TypeError(\"Input must be an integer.\")\n        if k < 0:\n            raise ValueError(\"Sum up to a negative number is not defined in this context.\")\n        \n        return k * (k + 1) // 2\n\n```\n```python\n# src/calculator.py\nfrom typing import List\nfrom src.utils import MathUtils\n\nclass FactorialSumCalculator:\n    \"\"\"Orchestrates list generation based on index parity using MathUtils.\"\"\"\n\n    def __init__(self):\n        \"\"\"Initializes the calculator with a MathUtils instance.\"\"\"\n        self._math_utils = MathUtils()\n\n    def calculate_list(self, n: int) -> List[int]:\n        \"\"\"Generates a list of size n, applying factorial or sum based on index parity.\"\"\"\n        if not isinstance(n, int):\n            raise TypeError(\"Input 'n' must be an integer.\")\n        if n < 0:\n            raise ValueError(\"Input 'n' cannot be negative.\")\n\n        result_list = []\n        for i in range(1, n + 1):  # Indices start from 1\n            if i % 2 == 0:  # Even index\n                result_list.append(self._math_utils.factorial(i))\n            else:  # Odd index\n                result_list.append(self._math_utils.sum_up_to(i))\n        return result_list\n\ndef f(n: int) -> List[int]:\n    \"\"\"Utility function to generate a list based on index parity, mirroring the problem's f(n).\"\"\"\n    calculator = FactorialSumCalculator()\n    return calculator.calculate_list(n)\n\n```"}
