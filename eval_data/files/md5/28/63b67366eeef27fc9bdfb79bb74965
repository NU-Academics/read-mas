{"task_id": "HumanEval/119", "solution": "```python\ndef match_parens(lst):\n    \"\"\"\n    Checks if two given parenthesis strings can be concatenated to form a balanced string.\n    Returns 'Yes' if possible, 'No' otherwise.\n    \"\"\"\n\n    VALID_PAREN_CHARS = \"()\"\n\n    def _validate_input(input_lst):\n        \"\"\"Validates the input list structure and content.\"\"\"\n        if not isinstance(input_lst, list) or len(input_lst) != 2:\n            raise ValueError(\"Input must be a list of exactly two strings.\")\n        for s in input_lst:\n            if not isinstance(s, str):\n                raise ValueError(\"All elements in the list must be strings.\")\n            if not all(char in VALID_PAREN_CHARS for char in s):\n                raise ValueError(f\"String '{s}' contains invalid characters. Only '(' and ')' are allowed.\")\n\n    def _is_balanced(s: str) -> bool:\n        \"\"\"Determines if a string of parentheses is balanced.\"\"\"\n        balance = 0\n        for char in s:\n            if char == '(':\n                balance += 1\n            else:  # char == ')'\n                balance -= 1\n            if balance < 0:\n                return False\n        return balance == 0\n\n    _validate_input(lst)\n\n    s1, s2 = lst[0], lst[1]\n\n    # Check s1 + s2\n    if _is_balanced(s1 + s2):\n        return \"Yes\"\n\n    # Check s2 + s1\n    if _is_balanced(s2 + s1):\n        return \"Yes\"\n\n    return \"No\"\n```"}
{"task_id": "HumanEval/127", "solution": "import math\n\ndef _calculate_intersection_interval(interval1: tuple[int, int], interval2: tuple[int, int]) -> tuple[int, int] | None:\n    \"\"\"Calculates the intersection of two closed intervals.\n    Returns the intersection (start, end) or None if no intersection.\"\"\"\n    start1, end1 = interval1\n    start2, end2 = interval2\n\n    max_start = max(start1, start2)\n    min_end = min(end1, end2)\n\n    if max_start <= min_end:\n        return (max_start, min_end)\n    else:\n        return None\n\ndef _calculate_length(interval: tuple[int, int]) -> int:\n    \"\"\"Calculates the length of a closed interval.\n    The length is determined as end - start + 1.\"\"\"\n    start, end = interval\n    return end - start + 1\n\ndef _is_prime(n: int) -> bool:\n    \"\"\"Checks if a non-negative integer is a prime number.\n    It uses an optimized trial division method.\"\"\"\n    if n <= 1:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n\n    # Check for divisors from 3 up to sqrt(n), incrementing by 2.\n    for i in range(3, math.isqrt(n) + 1, 2):\n        if n % i == 0:\n            return False\n    return True\n\ndef intersection(interval1: tuple[int, int], interval2: tuple[int, int]) -> str:\n    \"\"\"Determines if the length of the intersection of two closed intervals is a prime number.\n    Returns \"YES\" if the length is prime, otherwise \"NO\".\"\"\"\n    intersect_interval = _calculate_intersection_interval(interval1, interval2)\n\n    if intersect_interval is None:\n        return \"NO\"\n    else:\n        length = _calculate_length(intersect_interval)\n        if _is_prime(length):\n            return \"YES\"\n        else:\n            return \"NO\""}
{"task_id": "HumanEval/128", "solution": "```python\ndef prod_signs(arr: list[int]) -> int | None:\n    \"\"\"\n    You are given an array arr of integers and you need to return\n    sum of magnitudes of integers multiplied by product of all signs\n    of each number in the array, represented by 1, -1 or 0.\n    Note: return None for empty arr.\n\n    Example:\n    >>> prod_signs([1, 2, 2, -4]) == -9\n    >>> prod_signs([0, 1]) == 0\n    >>> prod_signs([]) == None\n    \"\"\"\n    if not arr:\n        return None\n\n    def _calculate_sign_product(arr: list[int]) -> int:\n        \"\"\"Calculates the product of signs for all numbers in the array. Returns 0 if any number is zero.\"\"\"\n        sign_product = 1\n        for n in arr:\n            if n == 0:\n                return 0\n            elif n < 0:\n                sign_product *= -1\n        return sign_product\n\n    def _calculate_magnitude_sum(arr: list[int]) -> int:\n        \"\"\"Calculates the sum of magnitudes for all numbers in the array.\"\"\"\n        magnitude_sum = 0\n        for n in arr:\n            magnitude_sum += abs(n)\n        return magnitude_sum\n\n    sign_product = _calculate_sign_product(arr)\n    magnitude_sum = _calculate_magnitude_sum(arr)\n\n    return sign_product * magnitude_sum\n\n```"}
{"task_id": "HumanEval/126", "solution": "```\nsrc/__init__.py\n```python\n# This file marks the src directory as a Python package.\n```\n\n```\nsrc/list_sorter.py\n```python\nfrom src.list_validator_utils import ListValidatorUtils\n\nclass ListSorter:\n    @staticmethod\n    def is_sorted(lst: list[int]) -> bool:\n        \"\"\"\n        Determines if the list is sorted ascending and adheres to duplicate constraints.\n        Returns True if both conditions are met, False otherwise.\n        \"\"\"\n        # Validate input type and elements as per constraints and example.\n        if not isinstance(lst, list) or not all(isinstance(x, int) and x >= 0 for x in lst):\n            return False\n\n        # Check for ascending order (non-decreasing).\n        for i in range(len(lst) - 1):\n            if lst[i] > lst[i+1]:\n                return False\n\n        # Check for duplicate constraint using ListValidatorUtils.\n        if not ListValidatorUtils._check_duplicates(lst):\n            return False\n\n        # All checks passed.\n        return True\n```\n\n```\nsrc/list_validator_utils.py\n```python\nfrom collections import Counter\n\nclass ListValidatorUtils:\n    @staticmethod\n    def _check_duplicates(lst: list[int]) -> bool:\n        \"\"\"\n        Checks if any number in the list appears more than two times.\n        Returns True if no number appears more than two times, False otherwise.\n        \"\"\"\n        counts = Counter(lst)\n        for count in counts.values():\n            if count > 2:\n                return False\n        return True\n```\n\n```\ntests/__init__.py\n```python\n# This file marks the tests directory as a Python package.\n```\n\n```\npyproject.toml\n```toml\n[project]\nname = \"list-validator-utility\"\nversion = \"0.1.0\"\ndescription = \"A utility to validate order and uniqueness constraints of a list of numbers.\"\nauthors = [\n    { name = \"Your Name\", email = \"your.email@example.com\" }\n]\nrequires-python = \">=3.8\"\ndependencies = []\n\n[build-system]\nrequires = [\"setuptools>=61.0\"]\nbuild-backend = \"setuptools.build_meta\"\n```\n\n```\nREADME.md\n```markdown\n# List Validator Utility\n\nThis project provides a Python utility function to validate a list of non-negative integers. It checks if the list is sorted in ascending order and if no number appears more than two times.\n\n## Usage\n\nThe core functionality is provided by the `ListSorter` class.\n\n```python\nfrom src.list_sorter import ListSorter\n\n# Example usage\nlist1 = [1, 2, 3, 4, 5]\nprint(f\"List {list1} is valid: {ListSorter.is_sorted(list1)}\")\n\nlist2 = [1, 2, 2, 3, 4]\nprint(f\"List {list2} is valid: {ListSorter.is_sorted(list2)}\")\n\nlist3 = [1, 3, 2, 4, 5]\nprint(f\"List {list3} is valid: {ListSorter.is_sorted(list3)}\")\n\nlist4 = [1, 2, 2, 2, 3, 4]\nprint(f\"List {list4} is valid: {ListSorter.is_sorted(list4)}\")\n\nlist5 = []\nprint(f\"List {list5} is valid: {ListSorter.is_sorted(list5)}\")\n\nlist6 = [7]\nprint(f\"List {list6} is valid: {ListSorter.is_sorted(list6)}\")\n\nlist7 = [-1, 2, 3]\nprint(f\"List {list7} is valid: {ListSorter.is_sorted(list7)}\")\n\nlist8 = [1, 2.0, 3]\nprint(f\"List {list8} is valid: {ListSorter.is_sorted(list8)}\")\n```\n```"}
{"task_id": "HumanEval/127", "solution": "# src/models/interval.py\nclass Interval:\n    def __init__(self, start: int, end: int):\n        # Initializes an Interval object with start and end values.\n        # Validates that inputs are integers and start is not greater than end.\n        if not isinstance(start, int) or not isinstance(end, int):\n            raise TypeError(\"Interval start and end must be integers.\")\n        if start > end:\n            raise ValueError(\"Interval start cannot be greater than end.\")\n        self.start = start\n        self.end = end\n\n    def __repr__(self) -> str:\n        # Returns a string representation of the Interval object.\n        return f\"Interval({self.start}, {self.end})\"\n\n# src/services/interval_service.py\n\n\nclass IntervalService:\n    def calculate_intersection_length(self, interval1: Interval, interval2: Interval) -> int:\n        # Calculates the length of the intersection of two given Interval objects.\n        # Returns 0 if there is no intersection.\n        max_start = max(interval1.start, interval2.start)\n        min_end = min(interval1.end, interval2.end)\n\n        if max_start > min_end:\n            return 0\n        \n        return min_end - max_start\n\n# src/services/prime_checker.py\nimport math\n\nclass PrimeChecker:\n    def is_prime(self, number: int) -> bool:\n        # Checks if the given integer is a prime number using an optimized trial division method.\n        # Returns True if prime, False otherwise.\n        if number <= 1:\n            return False\n        if number == 2:\n            return True\n        if number % 2 == 0:\n            return False\n        \n        for i in range(3, int(math.sqrt(number)) + 1, 2):\n            if number % i == 0:\n                return False\n        return True\n\n# src/controllers/main_controller.py\nclass MainController:\n    def __init__(self):\n        # Initializes MainController and its service dependencies.\n        self._interval_service = IntervalService()\n        self._prime_checker = PrimeChecker()\n\n    def intersection(self, interval1_tuple: tuple[int, int], interval2_tuple: tuple[int, int]) -> str:\n        # Orchestrates the calculation of intersection length and its primality check.\n        # Returns \"YES\" if the length is prime, \"NO\" otherwise.\n        interval1 = Interval(interval1_tuple[0], interval1_tuple[1])\n        interval2 = Interval(interval2_tuple[0], interval2_tuple[1])\n\n        intersection_length = self._interval_service.calculate_intersection_length(interval1, interval2)\n\n        if intersection_length == 0:\n            return \"NO\"\n\n        if self._prime_checker.is_prime(intersection_length):\n            return \"YES\"\n        else:\n            return \"NO\"\n\n_main_controller_instance = MainController()\n\ndef intersection(interval1: tuple[int, int], interval2: tuple[int, int]) -> str:\n    \"\"\"\n    Determines if the length of the intersection of two intervals is a prime number.\n    It takes two intervals as tuples and returns \"YES\" or \"NO\".\n    \"\"\"\n    return _main_controller_instance.intersection(interval1, interval2)"}
{"task_id": "HumanEval/128", "solution": "```python\n# src/prod_signs/__init__.py\n# Package initialization for prod_signs.\n\n\n# src/prod_signs/utils.py\nclass ArrayUtils:\n    \"\"\"Provides utility methods for extracting sign and magnitude from numbers.\"\"\"\n\n    @staticmethod\n    def get_sign(num: int) -> int:\n        \"\"\"Determines the sign of an integer (1 for positive, -1 for negative, 0 for zero).\"\"\"\n        if num > 0:\n            return 1\n        elif num < 0:\n            return -1\n        else:\n            return 0\n\n    @staticmethod\n    def get_magnitude(num: int) -> int:\n        \"\"\"Determines the absolute value (magnitude) of an integer.\"\"\"\n        return abs(num)\n\n\n# src/prod_signs/calculator.py\nfrom src.prod_signs.utils import ArrayUtils\n\nclass SignCalculator:\n    \"\"\"Orchestrates the calculation of the prod_signs value.\"\"\"\n\n    @staticmethod\n    def prod_signs(arr: list[int]) -> int | None:\n        \"\"\"\n        Calculates the sum of magnitudes multiplied by the product of all signs in the array.\n        Returns None if the input array is empty.\n        \"\"\"\n        if not arr:\n            return None\n\n        product_of_signs = 1\n        sum_of_magnitudes = 0\n\n        for num in arr:\n            product_of_signs *= ArrayUtils.get_sign(num)\n            sum_of_magnitudes += ArrayUtils.get_magnitude(num)\n        \n        return product_of_signs * sum_of_magnitudes\n```\n"}
{"task_id": "HumanEval/131", "solution": "```python\nclass OddDigitProductCalculator:\n    @staticmethod\n    def _is_odd(digit: int) -> bool:\n        \"\"\"Checks if a given digit is odd.\"\"\"\n        return digit % 2 != 0\n\n    @staticmethod\n    def calculate_product(n: int) -> int:\n        \"\"\"\n        Given a non-negative integer n, return the product of its odd digits.\n        Returns 0 if all digits are even or if n is 0.\n        \"\"\"\n        if not isinstance(n, int):\n            raise TypeError(\"Input must be an integer.\")\n        if n < 0:\n            raise ValueError(\"Input must be a non-negative integer.\")\n        if n == 0:\n            return 0\n\n        product = 1\n        has_odd_digit = False\n        temp_n = n\n        while temp_n > 0:\n            digit = temp_n % 10\n            if OddDigitProductCalculator._is_odd(digit):\n                product *= digit\n                has_odd_digit = True\n            temp_n //= 10\n\n        return product if has_odd_digit else 0\n\ndef digits(n: int) -> int:\n    \"\"\"\n    Given a positive integer n, return the product of the odd digits.\n    Return 0 if all digits are even.\n    \"\"\"\n    return OddDigitProductCalculator.calculate_product(n)\n```"}
{"task_id": "HumanEval/130", "solution": "```python\nfrom typing import Dict, List\n\nclass InvalidInputError(Exception):\n    \"\"\"Custom exception for invalid input values.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\n\nclass TribonacciCalculator:\n    \"\"\"Manages Tribonacci sequence calculations, using memoization.\"\"\"\n    def __init__(self):\n        self._memo: Dict[int, int] = {}\n\n    def _calculate_term(self, n: int) -> int:\n        \"\"\"Recursively calculates the n-th Tribonacci term with memoization.\"\"\"\n        if n < 0:\n            raise InvalidInputError(\"Input 'n' must be a non-negative integer.\")\n        \n        if n in self._memo:\n            return self._memo[n]\n\n        if n == 0:\n            result = 1\n        elif n == 1:\n            result = 3\n        elif n % 2 == 0:  # n is even\n            result = 1 + n // 2\n        else:  # n is odd\n            # tri(n) = tri(n - 1) + tri(n - 2) + tri(n + 1)\n            term_n_minus_1 = self._calculate_term(n - 1)\n            term_n_minus_2 = self._calculate_term(n - 2)\n            term_n_plus_1 = self._calculate_term(n + 1)\n            result = term_n_minus_1 + term_n_minus_2 + term_n_plus_1\n        \n        self._memo[n] = result\n        return result\n\n    def calculate_sequence(self, n: int) -> List[int]:\n        \"\"\"Generates the first n+1 Tribonacci numbers.\"\"\"\n        if n < 0:\n            raise InvalidInputError(\"Input 'n' must be a non-negative integer.\")\n            \n        sequence = []\n        for i in range(n + 1):\n            sequence.append(self._calculate_term(i))\n        return sequence\n\ndef tri(n):\n    \"\"\"Everyone knows Fibonacci sequence, it was studied deeply by mathematicians in \n    the last couple centuries. However, what people don't know is Tribonacci sequence.\n    Tribonacci sequence is defined by the recurrence:\n    tri(1) = 3\n    tri(n) = 1 + n / 2, if n is even.\n    tri(n) =  tri(n - 1) + tri(n - 2) + tri(n + 1), if n is odd.\n    For example:\n    tri(2) = 1 + (2 / 2) = 2\n    tri(4) = 3\n    tri(3) = tri(2) + tri(1) + tri(4)\n           = 2 + 3 + 3 = 8 \n    You are given a non-negative integer number n, you have to a return a list of the \n    first n + 1 numbers of the Tribonacci sequence.\n    Examples:\n    tri(3) = [1, 3, 2, 8]\n    \"\"\"\n    calculator = TribonacciCalculator()\n    return calculator.calculate_sequence(n)\n\n```"}
{"task_id": "HumanEval/130", "solution": "from typing import List, Dict\n\nclass InvalidInputError(ValueError):\n    \"\"\"Custom exception for invalid input parameters.\n    It signals that a provided input does not meet the expected criteria.\n    \"\"\"\n    pass\n\ndef tri(n: int) -> List[int]:\n    \"\"\"Everyone knows Fibonacci sequence, it was studied deeply by mathematicians in \n    the last couple centuries. However, what people don't know is Tribonacci sequence.\n    Tribonacci sequence is defined by the recurrence:\n    tri(1) = 3\n    tri(n) = 1 + n / 2, if n is even.\n    tri(n) =  tri(n - 1) + tri(n - 2) + tri(n + 1), if n is odd.\n    For example:\n    tri(2) = 1 + (2 / 2) = 2\n    tri(4) = 3\n    tri(3) = tri(2) + tri(1) + tri(4)\n           = 2 + 3 + 3 = 8 \n    You are given a non-negative integer number n, you have to a return a list of the \n    first n + 1 numbers of the Tribonacci sequence.\n    Examples:\n    tri(3) = [1, 3, 2, 8]\n    \"\"\"\n    if not isinstance(n, int) or n < 0:\n        raise InvalidInputError(\"Input 'n' must be a non-negative integer.\")\n\n    memo: Dict[int, int] = {}\n\n    def _calculate_term(k: int) -> int:\n        \"\"\"Recursively calculates the k-th Tribonacci term, utilizing memoization.\n        This private helper function handles the core recurrence relations and base cases.\n        \"\"\"\n        if k in memo:\n            return memo[k]\n\n        if k == 0:\n            result = 1\n        elif k == 1:\n            result = 3\n        elif k % 2 == 0:  # k is even and k >= 2\n            result = 1 + k // 2\n        else:  # k is odd and k >= 3\n            term_k_minus_1 = _calculate_term(k - 1)\n            term_k_minus_2 = _calculate_term(k - 2)\n            term_k_plus_1 = _calculate_term(k + 1)\n            result = term_k_minus_1 + term_k_minus_2 + term_k_plus_1\n        \n        memo[k] = result\n        return result\n\n    # Ensure all terms up to n are calculated and memoized.\n    # The recursive calls within _calculate_term will handle dependencies,\n    # including tri(n+1) if n is odd, populating the memoization table as needed.\n    for i in range(n + 1):\n        _calculate_term(i)\n    \n    return [memo[i] for i in range(n + 1)]"}
{"task_id": "HumanEval/129", "solution": "```python\n# src/min_path_finder/__init__.py\n# This file can be empty, indicating it's a Python package.\n\n```\n```python\n# src/min_path_finder/models.py\nfrom dataclasses import dataclass\n\n@dataclass(order=True)\nclass Path:\n    \"\"\"Represents a path in the grid.\n    Includes its sequence of values, current position, and length for lexicographical comparison.\n    \"\"\"\n    values: list[int]\n    row: int\n    col: int\n    length: int\n\n```\n```python\n# src/min_path_finder/grid_validator.py\nclass GridValidator:\n    \"\"\"Provides static methods for validating the input grid and k parameters.\n    Ensures grid format and k value meet required specifications.\n    \"\"\"\n    @staticmethod\n    def validate_grid(grid: list[list[int]]) -> int:\n        \"\"\"Validates if the input grid is a valid N x N grid with N >= 2.\"\"\"\n        if not isinstance(grid, list) or not grid:\n            raise ValueError(\"Grid must be a non-empty list of lists.\")\n        N = len(grid)\n        if N < 2:\n            raise ValueError(\"Grid must have at least 2 rows (N >= 2).\")\n        for r_idx, row in enumerate(grid):\n            if not isinstance(row, list) or len(row) != N:\n                raise ValueError(f\"Row {r_idx} is not a list or does not have N columns.\")\n            for val in row:\n                if not isinstance(val, int):\n                    raise ValueError(f\"Grid cell contains non-integer value: {val}.\")\n        return N\n\n    @staticmethod\n    def validate_k(k: int, max_k: int) -> None:\n        \"\"\"Validates if k is a positive integer.\n        The problem allows k to be greater than max_k (N*N) as cells can be revisited.\n        \"\"\"\n        if not isinstance(k, int) or k <= 0:\n            raise ValueError(\"k must be a positive integer.\")\n\n```\n```python\n# src/min_path_finder/utils.py\nclass Utils:\n    \"\"\"Provides static utility methods.\n    Includes calculating valid neighbors for a given cell within the grid.\n    \"\"\"\n    @staticmethod\n    def get_neighbors(row: int, col: int, N: int) -> list[tuple[int, int]]:\n        \"\"\"Returns a list of valid (row, col) coordinates for neighbors of a given cell.\"\"\"\n        neighbors = []\n        moves = [(-1, 0), (1, 0), (0, -1), (0, 1)]  # Up, Down, Left, Right\n\n        for dr, dc in moves:\n            n_row, n_col = row + dr, col + dc\n            if 0 <= n_row < N and 0 <= n_col < N:\n                neighbors.append((n_row, n_col))\n        return neighbors\n\n```\n```python\n# src/min_path_finder/min_path_finder.py\nimport heapq\n# Relative imports for modules within the package\nfrom .models import Path\nfrom .grid_validator import GridValidator\nfrom .utils import Utils\n\nclass PathFinder:\n    \"\"\"Encapsulates the core logic for finding the lexicographically smallest path.\n    It uses a priority queue to efficiently explore paths.\n    \"\"\"\n    def __init__(self, grid: list[list[int]], N: int, k: int) -> None:\n        self._grid = grid\n        self._N = N\n        self._k = k\n        self._priority_queue: list[Path] = [] # heapq uses a list as its underlying heap structure.\n\n    def find_min_path(self) -> list[int]:\n        \"\"\"Executes the pathfinding algorithm to find the minimum path.\"\"\"\n        # Initialize priority queue with all possible starting paths of length 1.\n        for r in range(self._N):\n            for c in range(self._N):\n                initial_path = Path(values=[self._grid[r][c]], row=r, col=c, length=1)\n                heapq.heappush(self._priority_queue, initial_path)\n\n        return self._explore_paths()\n\n    def _explore_paths(self) -> list[int]:\n        \"\"\"Implements the priority queue-based search.\"\"\"\n        while self._priority_queue:\n            current_path = heapq.heappop(self._priority_queue)\n\n            if current_path.length == self._k:\n                return current_path.values\n\n            if current_path.length < self._k:\n                neighbors = Utils.get_neighbors(current_path.row, current_path.col, self._N)\n                for nr, nc in neighbors:\n                    new_values = current_path.values + [self._grid[nr][nc]]\n                    new_path = Path(values=new_values, row=nr, col=nc, length=current_path.length + 1)\n                    heapq.heappush(self._priority_queue, new_path)\n        \n        # This part should ideally not be reached if k is reachable given problem constraints.\n        # It handles scenarios where no path of length k could be found.\n        return []\n\ndef minPath(grid: list[list[int]], k: int) -> list[int]:\n    \"\"\"Finds the lexicographically smallest path of length k in the given grid.\n    This is the main public entry point for the pathfinding functionality.\n    \"\"\"\n    N = GridValidator.validate_grid(grid)\n    GridValidator.validate_k(k, N * N)\n\n    finder = PathFinder(grid, N, k)\n    return finder.find_min_path()\n```"}
{"task_id": "HumanEval/129", "solution": "```python\nimport sys\nimport copy\nimport os\n\n# Create src directory if it doesn't exist\nos.makedirs(\"src\", exist_ok=True)\n\n# Write src/exceptions.py\nwith open(\"src/exceptions.py\", \"w\") as f:\n    f.write(\n        \"\"\"class InvalidGridError(ValueError):\n    \\\"\\\"\\\"Custom exception for invalid grid inputs.\\\"\\\"\\\"\n    def __init__(self, message: str):\n        super().__init__(message)\n\nclass InvalidPathLengthError(ValueError):\n    \\\"\\\"\\\"Custom exception for invalid path length k.\\\"\\\"\\\"\n    def __init__(self, message: str):\n        super().__init__(message)\n\"\"\"\n    )\n\n# Write src/models.py\nwith open(\"src/models.py\", \"w\") as f:\n    f.write(\n        \"\"\"import copy\n\nclass Cell:\n    \\\"\\\"\\\"Represents a single cell in the grid, holding its coordinates and value.\\\"\\\"\\\"\n    def __init__(self, row: int, col: int, value: int):\n        self._row = row\n        self._col = col\n        self._value = value\n\n    def get_row(self) -> int:\n        return self._row\n\n    def get_col(self) -> int:\n        return self._col\n\n    def get_value(self) -> int:\n        return self._value\n\n    def __eq__(self, other: object) -> bool:\n        if not isinstance(other, Cell):\n            return NotImplemented\n        return self._row == other._row and self._col == other._col and self._value == other._value\n\n    def __hash__(self) -> int:\n        return hash((self._row, self._col, self._value))\n\n    def __repr__(self) -> str:\n        return f\\\"Cell(row={self._row}, col={self._col}, value={self._value})\\\"\n\n\nclass Grid:\n    \\\"\\\"\\\"Encapsulates the 2D grid data and provides methods for accessing cells and checking coordinates.\\\"\\\"\\\"\n    def __init__(self, data: list[list[int]]):\n        self._data = data\n        self._N = len(data)\n\n    def get_N(self) -> int:\n        return self._N\n\n    def get_cell(self, row: int, col: int) -> Cell:\n        if not self.is_valid_coord(row, col):\n            raise IndexError(f\\\"Coordinates ({row}, {col}) are out of grid bounds.\\\")\n        return Cell(row, col, self._data[row][col])\n\n    def is_valid_coord(self, row: int, col: int) -> bool:\n        return 0 <= row < self._N and 0 <= col < self._N\n\n\nclass Path:\n    \\\"\\\"\\\"Represents a sequence of visited cells, providing methods for path manipulation and lexicographical comparison.\\\"\\\"\\\"\n    def __init__(self, cells: list[Cell] = None):\n        self._cells = list(cells) if cells is not None else []\n\n    def add_cell(self, cell: Cell):\n        self._cells.append(cell)\n\n    def get_values(self) -> list[int]:\n        return [cell.get_value() for cell in self._cells]\n\n    def get_length(self) -> int:\n        return len(self._cells)\n\n    def get_last_cell(self) -> Cell:\n        if not self._cells:\n            raise IndexError(\\\"Path is empty, cannot get last cell.\\\")\n        return self._cells[-1]\n\n    def is_lexicographically_smaller(self, other: 'Path') -> bool:\n        self_values = self.get_values()\n        other_values = other.get_values()\n        return self_values < other_values\n\n    def __lt__(self, other: 'Path') -> bool:\n        return self.is_lexicographically_smaller(other)\n\n    def __repr__(self) -> str:\n        return f\\\"Path(values={self.get_values()})\\\"\n\n    def __copy__(self) -> 'Path':\n        return Path(copy.copy(self._cells))\n\"\"\"\n    )\n\n# Write src/utils.py\nwith open(\"src/utils.py\", \"w\") as f:\n    f.write(\n        \"\"\"from src.models import Grid, Cell\nfrom src.exceptions import InvalidGridError, InvalidPathLengthError\n\nclass GridValidator:\n    \\\"\\\"\\\"Provides static methods to validate the input grid and path length k.\\\"\\\"\\\"\n    @staticmethod\n    def validate_grid(grid_data: list[list[int]], k: int) -> None:\n        N = GridValidator._validate_dimensions(grid_data)\n        GridValidator._validate_values(grid_data, N)\n        GridValidator._validate_k(k, N)\n\n    @staticmethod\n    def _validate_dimensions(grid_data: list[list[int]]) -> int:\n        if not isinstance(grid_data, list) or not all(isinstance(row, list) for row in grid_data):\n            raise InvalidGridError(\\\"Grid must be a list of lists.\\\")\n        \n        N = len(grid_data)\n        if N < 2:\n            raise InvalidGridError(f\\\"Grid dimension N must be >= 2, but got N={N}.\\\")\n        if not all(len(row) == N for row in grid_data):\n            raise InvalidGridError(\\\"Grid must be square (N x N).\\\")\n        return N\n\n    @staticmethod\n    def _validate_values(grid_data: list[list[int]], N: int) -> None:\n        expected_values = set(range(1, N * N + 1))\n        actual_values = set()\n        for r in range(N):\n            for c in range(N):\n                value = grid_data[r][c]\n                if not isinstance(value, int):\n                    raise InvalidGridError(f\\\"Grid values must be integers, but found '{value}'.\\\")\n                if not (1 <= value <= N * N):\n                    raise InvalidGridError(f\\\"Grid value {value} is out of range [1, {N*N}].\\\")\n                if value in actual_values:\n                    raise InvalidGridError(f\\\"Duplicate value {value} found in grid.\\\")\n                actual_values.add(value)\n        if actual_values != expected_values:\n            raise InvalidGridError(\\\"Grid values must be unique and cover range [1, N*N].\\\")\n\n    @staticmethod\n    def _validate_k(k: int, N: int) -> None:\n        if not isinstance(k, int) or k < 1:\n            raise InvalidPathLengthError(f\\\"Path length k must be a positive integer, but got k={k}.\\\")\n\n\nclass NeighborFinder:\n    \\\"\\\"\\\"Provides a static method to find valid neighboring cells for a given cell in a grid.\\\"\\\"\\\"\n    @staticmethod\n    def get_neighbors(grid: Grid, cell: Cell) -> list[Cell]:\n        neighbors = []\n        moves = [(-1, 0), (1, 0), (0, -1), (0, 1)] # Up, Down, Left, Right\n\n        for dr, dc in moves:\n            new_row, new_col = cell.get_row() + dr, cell.get_col() + dc\n            if grid.is_valid_coord(new_row, new_col):\n                neighbors.append(grid.get_cell(new_row, new_col))\n        return neighbors\n\"\"\"\n    )\n\n# Write src/services.py\nwith open(\"src/services.py\", \"w\") as f:\n    f.write(\n        \"\"\"import sys\nfrom src.models import Grid, Cell, Path\nfrom src.utils import NeighborFinder\n\nclass PathFinderService:\n    \\\"\\\"\\\"Implements the core algorithm to find the lexicographically smallest path of length k.\\\"\\\"\\\"\n    def __init__(self, grid: Grid, k: int):\n        self._grid = grid\n        self._k = k\n        self._min_path_values: list[int] = [sys.maxsize] * k\n        self._visited_cells: set[Cell] = set()\n\n    def find_min_path(self) -> list[int]:\n        N = self._grid.get_N()\n        for r in range(N):\n            for c in range(N):\n                start_cell = self._grid.get_cell(r, c)\n                self._visited_cells.clear() # Reset visited cells for each new starting point.\n                self._dfs(start_cell, Path([start_cell]))\n        return self._min_path_values\n\n    def _dfs(self, current_cell: Cell, current_path: Path):\n        self._visited_cells.add(current_cell)\n\n        if current_path.get_length() == self._k:\n            current_path_values = current_path.get_values()\n            if current_path_values < self._min_path_values:\n                self._min_path_values = current_path_values\n            self._visited_cells.remove(current_cell) # Backtrack: unmark current cell.\n            return\n\n        # Pruning: if current path prefix is already lexicographically greater than or equal\n        # to the known minimum path's prefix, this branch cannot lead to a smaller path.\n        if current_path.get_values() >= self._min_path_values[:current_path.get_length()]:\n             self._visited_cells.remove(current_cell) # Backtrack: unmark current cell.\n             return\n\n        neighbors = NeighborFinder.get_neighbors(self._grid, current_cell)\n        neighbors.sort(key=lambda cell: cell.get_value()) # Explore neighbors by value for lexicographical order.\n\n        for neighbor in neighbors:\n            if neighbor not in self._visited_cells:\n                new_path = current_path.__copy__() # Create a new path for this branch.\n                new_path.add_cell(neighbor)\n                self._dfs(neighbor, new_path)\n        \n        self._visited_cells.remove(current_cell) # Backtrack: unmark current cell after exploring all branches.\n\"\"\"\n    )\n\n# Write src/main.py\nwith open(\"src/main.py\", \"w\") as f:\n    f.write(\n        \"\"\"from src.models import Grid\nfrom src.services import PathFinderService\nfrom src.utils import GridValidator\nfrom src.exceptions import InvalidGridError, InvalidPathLengthError\n\ndef minPath(grid_data: list[list[int]], k: int) -> list[int]:\n    \\\"\\\"\\\"\n    Finds the lexicographically smallest path of length k in the provided grid.\n    Performs input validation and orchestrates the pathfinding process.\n    \\\"\\\"\\\"\n    try:\n        GridValidator.validate_grid(grid_data, k)\n    except (InvalidGridError, InvalidPathLengthError) as e:\n        raise e\n\n    grid = Grid(grid_data)\n    path_finder = PathFinderService(grid, k)\n    return path_finder.find_min_path()\n\"\"\"\n    )\n\n# Write src/__init__.py\nwith open(\"src/__init__.py\", \"w\") as f:\n    f.write(\"\")\n\nprint(\"Generated code in 'src/' directory.\")\n```"}
