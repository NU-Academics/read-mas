{"task_id": "HumanEval/44", "solution": "```python\nclass BaseConverter:\n    MIN_BASE = 2\n    MAX_BASE = 9\n\n    @staticmethod\n    def change_base(x: int, base: int) -> str:\n        \"\"\"Converts integer x from base 10 to target base.\n        Returns the string representation of the converted number.\n        \"\"\"\n        if not isinstance(x, int) or x < 0:\n            raise ValueError(\"Input number 'x' must be a non-negative integer.\")\n        if not isinstance(base, int) or not (BaseConverter.MIN_BASE <= base <= BaseConverter.MAX_BASE):\n            raise ValueError(f\"Base must be an integer between {BaseConverter.MIN_BASE} and {BaseConverter.MAX_BASE} (inclusive).\")\n\n        if x == 0:\n            return \"0\"\n\n        result = []\n        current_x = x\n        while current_x > 0:\n            remainder = current_x % base\n            result.append(str(remainder))\n            current_x //= base\n        \n        return \"\".join(result[::-1])\n\n```"}
{"task_id": "HumanEval/44", "solution": "```python\n# src/base_converter/__init__.py\n\"\"\"\nBase converter package.\nProvides utilities for converting numbers from base 10 to other bases.\n\"\"\"\n\n# src/base_converter/exceptions.py\nclass InvalidBaseError(ValueError):\n    \"\"\"Exception raised for invalid base values.\n    It indicates that the provided base is outside the allowed range or not an integer.\n    \"\"\"\n    def __init__(self, message: str = \"Base must be an integer between 2 and 9.\"):\n        self.message = message\n        super().__init__(self.message)\n\nclass InvalidNumberError(ValueError):\n    \"\"\"Exception raised for invalid input number values.\n    It signifies that the input number is not a non-negative integer.\n    \"\"\"\n    def __init__(self, message: str = \"Number must be a non-negative integer.\"):\n        self.message = message\n        super().__init__(self.message)\n\n# src/base_converter/validation.py\nfrom .exceptions import InvalidBaseError, InvalidNumberError\n\nclass InputValidator:\n    \"\"\"Utility class for validating input parameters for base conversion.\n    It provides static methods to check the validity of numbers and bases.\n    \"\"\"\n\n    @staticmethod\n    def validate_number(x: int) -> None:\n        \"\"\"Validates if x is a non-negative integer.\n        Raises InvalidNumberError if validation fails.\n        \"\"\"\n        if not isinstance(x, int):\n            raise InvalidNumberError(\"Input number must be an integer.\")\n        if x < 0:\n            raise InvalidNumberError(\"Input number must be non-negative.\")\n\n    @staticmethod\n    def validate_base(base: int) -> None:\n        \"\"\"Validates if base is an integer between 2 and 9 (inclusive).\n        Raises InvalidBaseError if validation fails.\n        \"\"\"\n        if not isinstance(base, int):\n            raise InvalidBaseError(\"Base must be an integer.\")\n        if not (2 <= base <= 9):\n            raise InvalidBaseError(\"Base must be between 2 and 9 (inclusive).\")\n\n# src/base_converter/converter.py\nfrom .validation import InputValidator\n\nclass BaseConverter:\n    \"\"\"\n    A class for converting numbers from base 10 to a specified target base.\n    It ensures inputs are valid and performs the conversion recursively.\n    \"\"\"\n    def __init__(self):\n        self._validator = InputValidator()\n\n    def change_base(self, x: int, base: int) -> str:\n        \"\"\"\n        Changes the numerical base of input number x to the specified target base.\n        Returns the string representation after the conversion.\n        \"\"\"\n        self._validator.validate_number(x)\n        self._validator.validate_base(base)\n\n        if x == 0:\n            return \"0\"\n\n        return self._convert_recursive(x, base)\n\n    def _convert_recursive(self, x: int, base: int) -> str:\n        \"\"\"\n        Recursive helper method to perform the actual base conversion.\n        It calculates remainders and quotients to build the new base representation.\n        \"\"\"\n        if x == 0:\n            return \"\"\n        \n        remainder = x % base\n        quotient = x // base\n        \n        return self._convert_recursive(quotient, base) + str(remainder)\n```"}
