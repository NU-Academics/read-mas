{"task_id": "HumanEval/153", "solution": "```python\n# src/strongest_extension/__init__.py\n```\n```python\n# src/strongest_extension/calculator.py\nclass StrongestExtensionCalculator:\n    def calculate_strength(self, extension: str) -> int:\n        \"\"\"Calculates the strength of an extension based on uppercase and lowercase letter counts.\n        Raises TypeError if the input is not a string.\"\"\"\n        if not isinstance(extension, str):\n            raise TypeError(\"Extension must be a string.\")\n        \n        uppercase_count = sum(1 for char in extension if 'A' <= char <= 'Z')\n        lowercase_count = sum(1 for char in extension if 'a' <= char <= 'z')\n        return uppercase_count - lowercase_count\n\n```\n```python\n# src/strongest_extension/finder.py\nfrom .calculator import StrongestExtensionCalculator\n\nclass ExtensionFinder:\n    def __init__(self, calculator: StrongestExtensionCalculator):\n        \"\"\"Initializes the ExtensionFinder with a StrongestExtensionCalculator instance.\"\"\"\n        if not isinstance(calculator, StrongestExtensionCalculator):\n            raise TypeError(\"Calculator must be an instance of StrongestExtensionCalculator.\")\n        self._calculator = calculator\n\n    def find_strongest_extension(self, extensions: list[str]) -> str:\n        \"\"\"Identifies the strongest extension from a list based on calculated strength, handling ties.\n        Returns an empty string if the input list is empty.\"\"\"\n        if not isinstance(extensions, list):\n            raise TypeError(\"Extensions must be a list.\")\n        \n        if not extensions:\n            return \"\"\n\n        strongest_extension = \"\"\n        max_strength = float('-inf')\n\n        for ext in extensions:\n            if not isinstance(ext, str):\n                raise TypeError(\"All extensions in the list must be strings.\")\n            \n            current_strength = self._calculator.calculate_strength(ext)\n            if current_strength > max_strength:\n                max_strength = current_strength\n                strongest_extension = ext\n        return strongest_extension\n\n```\n```python\n# src/strongest_extension/service.py\nfrom .calculator import StrongestExtensionCalculator\nfrom .finder import ExtensionFinder\n\nclass StrongestExtensionService:\n    def __init__(self, calculator: StrongestExtensionCalculator, finder: ExtensionFinder):\n        \"\"\"Initializes the service with calculator and finder instances.\"\"\"\n        if not isinstance(calculator, StrongestExtensionCalculator):\n            raise TypeError(\"Calculator must be an instance of StrongestExtensionCalculator.\")\n        if not isinstance(finder, ExtensionFinder):\n            raise TypeError(\"Finder must be an instance of ExtensionFinder.\")\n        self._calculator = calculator\n        self._finder = finder\n\n    def Strongest_Extension(self, class_name: str, extensions: list[str]) -> str:\n        \"\"\"Finds the strongest extension and combines it with the provided class name.\n        Returns the class name alone if no strongest extension is found.\"\"\"\n        if not isinstance(class_name, str):\n            raise TypeError(\"Class name must be a string.\")\n        \n        strongest_ext = self._finder.find_strongest_extension(extensions)\n        if strongest_ext:\n            return f\"{class_name}.{strongest_ext}\"\n        else:\n            return class_name\n\n```"}
{"task_id": "HumanEval/154", "solution": "```python\ndef _generate_rotations(s: str) -> list[str]:\n    \"\"\"Generates all unique cyclic rotations of a string.\n    It uses a set to ensure uniqueness among rotations.\"\"\"\n    if not s:\n        return [\"\"]\n    rotations = set()\n    n = len(s)\n    for i in range(n):\n        rotated_s = s[i:] + s[:i]\n        rotations.add(rotated_s)\n    return list(rotations)\n\ndef cycpattern_check(a: str, b: str) -> bool:\n    \"\"\"You are given 2 words. You need to return True if the second word or any of its rotations is a substring in the first word\n    cycpattern_check(\"abcd\",\"abd\") => False\n    cycpattern_check(\"hello\",\"ell\") => True\n    cycpattern_check(\"whassup\",\"psus\") => False\n    cycpattern_check(\"abab\",\"baa\") => True\n    cycpattern_check(\"efef\",\"eeff\") => False\n    cycpattern_check(\"himenss\",\"simen\") => True\n    \"\"\"\n    if not b:  # An empty string is a substring of any string.\n        return True\n    if not a:  # If 'a' is empty and 'b' is not, no match can exist.\n        return False\n\n    rotations_of_b = _generate_rotations(b)\n    for rotation in rotations_of_b:\n        if rotation in a:\n            return True\n    return False\n\n```"}
{"task_id": "HumanEval/154", "solution": "```python\nclass CyclicPatternChecker:\n    @staticmethod\n    def cycpattern_check(a: str, b: str) -> bool:\n        \"\"\"\n        Checks if the second word (b) or any of its rotations is a substring in the first word (a).\n        Returns True if a rotation of b is found in a, False otherwise.\n        \"\"\"\n        if not b:\n            return True\n        if not a: # If 'a' is empty, no non-empty 'b' can be a substring.\n            return False\n\n        len_a = len(a)\n        len_b = len(b)\n\n        if len_b > len_a:\n            return False\n\n        for i in range(len_b):\n            rotated_b = b[i:] + b[:i]\n            if rotated_b in a:\n                return True\n        return False\n```"}
{"task_id": "HumanEval/155", "solution": "```python\nclass EvenOddCounter:\n    @staticmethod\n    def count(num: int) -> tuple[int, int]:\n        \"\"\"\n        Counts the number of even and odd digits in an integer.\n        Handles type checking, negative numbers, and the special case of zero.\n        \"\"\"\n        if not isinstance(num, int):\n            raise TypeError(\"Input must be an integer.\")\n\n        even_count = 0\n        odd_count = 0\n        \n        # Use absolute value for digit processing.\n        abs_num = abs(num)\n        \n        # Special handling for the number 0 itself.\n        if abs_num == 0:\n            return (1, 0)\n\n        # Iterate through digits by converting to string.\n        num_str = str(abs_num)\n        for digit_char in num_str:\n            digit = int(digit_char)\n            if digit % 2 == 0:\n                even_count += 1\n            else:\n                odd_count += 1\n                \n        return (even_count, odd_count)\n\ndef even_odd_count(num: int) -> tuple[int, int]:\n    \"\"\"\n    Given an integer, returns a tuple with the count of even and odd digits.\n    This function delegates the core logic to EvenOddCounter.count.\n    \"\"\"\n    return EvenOddCounter.count(num)\n```\n"}
