{"task_id": "HumanEval/17", "solution": "```python\n# src/music_parser/exceptions.py\nclass InvalidMusicStringError(Exception):\n    \"\"\"Custom exception for invalid music string format.\n    Provides a descriptive message about the parsing failure.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\n```\n```python\n# src/music_parser/parser.py\nfrom typing import List\nfrom .exceptions import InvalidMusicStringError\n\nclass MusicParser:\n    \"\"\"Handles the core logic of parsing a musical string into beat durations.\"\"\"\n    _NOTE_BEATS_MAP = {\n        'o': 4,   # Whole note duration\n        'o|': 2,  # Half note duration\n        '.|': 1   # Quarter note duration\n    }\n\n    @staticmethod\n    def parse_music(music_string: str) -> List[int]:\n        \"\"\"\n        Parses a string representing musical notes and returns a list of beat durations.\n        Raises InvalidMusicStringError for unrecognized note tokens.\n        \"\"\"\n        if not music_string.strip():\n            return []\n\n        note_tokens = music_string.split()\n        beat_durations: List[int] = []\n\n        for token in note_tokens:\n            if token in MusicParser._NOTE_BEATS_MAP:\n                beat_durations.append(MusicParser._NOTE_BEATS_MAP[token])\n            else:\n                raise InvalidMusicStringError(f\"Unrecognized note token: '{token}'\")\n        return beat_durations\n\ndef parse_music(music_string: str) -> List[int]:\n    \"\"\"\n    Public entry point to parse a music string.\n    Delegates the parsing to the MusicParser class.\n    \"\"\"\n    return MusicParser.parse_music(music_string)\n```"}
{"task_id": "HumanEval/17", "solution": "```python\n# src/exceptions.py\nclass InvalidNoteError(ValueError):\n    \"\"\"\n    Custom exception for unrecognized musical note formats during parsing.\n    It inherits from ValueError to indicate an issue with the input value.\n    \"\"\"\n    pass\n\n```\n```python\n# src/constants.py\nfrom typing import Dict\n\n# This dictionary maps ASCII note representations to their corresponding beat durations.\n# It serves as a central lookup for note-to-beat conversions.\nNOTE_BEAT_MAP: Dict[str, int] = {\n    'o': 4,   # Whole note, lasts four beats\n    'o|': 2,  # Half note, lasts two beats\n    '.|': 1   # Quarter note, lasts one beat\n}\n\n```\n```python\n# src/music_parser.py\nfrom typing import List\nfrom src.constants import NOTE_BEAT_MAP\nfrom src.exceptions import InvalidNoteError\n\n\nclass MusicParser:\n    \"\"\"\n    Parses a string of ASCII musical notes into a list of beat durations.\n    This class is stateless and provides a single method for parsing.\n    \"\"\"\n\n    def parse_music(self, music_string: str) -> List[int]:\n        \"\"\"\n        Converts an ASCII music string into a list of integer beat durations.\n        It handles multiple notes and various spacing, raising an error for invalid notes.\n        \"\"\"\n        if not music_string.strip():\n            return []\n\n        # Split the string by spaces, which handles multiple spaces gracefully.\n        notes = music_string.split()\n        beat_durations: List[int] = []\n\n        for note in notes:\n            if note in NOTE_BEAT_MAP:\n                beat_durations.append(NOTE_BEAT_MAP[note])\n            else:\n                raise InvalidNoteError(f\"Unrecognized note format: '{note}'\")\n\n        return beat_durations\n\n```"}
