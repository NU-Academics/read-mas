tools>=61.0\"]\nbuild-backend = \"setuptools.build_meta\"\n\"\"\"\n\n# README.md\n\"\"\"\n# Sum Calculator Utility\n\nThis project provides a simple Python utility to calculate the sum of all positive integers from 1 up to a given positive integer `n`.\n\n## Features\n\n-   Calculates sum `1 + 2 + ... + n` efficiently using a direct formula (O(1) time complexity).\n-   Robust input validation ensures `n` is a positive integer.\n-   Provides a clear error (`InvalidInputError`) for invalid inputs.\n\n## Installation\n\nThis utility is designed as a Python module. You can integrate it into your project by copying the `src` directory or by packaging it as a library.\n\n### From Source\n\n1.  Clone the repository or download the `src` directory.\n2.  Place the `src` directory in your project.\n\n## Usage\n\nTo use the `sum_to_n` function, simply import it from the `calculator` module and call it with a positive integer.\n\n```python\nfrom src.calculator import sum_to_n\nfrom src.exceptions import InvalidInputError\n\ntry:\n    result = sum_to_n(10)\n    print(f\"The sum of integers from 1 to 10 is: {result}\") # Output: 55\n\n    result = sum_to_n(100)\n    print(f\"The sum of integers from 1 to 100 is: {result}\") # Output: 5050\n\n    # Example of invalid input\n    sum_to_n(0)\nexcept InvalidInputError as e:\n    print(f\"Error: {e}\") # Output: Error: Input 'n' must be a positive integer.\n\ntry:\n    sum_to_n(\"abc\")\nexcept InvalidInputError as e:\n    print(f\"Error: {e}\") # Output: Error: Input 'n' must be an integer.\n```\n\n## Development\n\nThe project structure is organized as follows:\n\n```\n\u251c\u2500\u2500 src/\n\u2502   \u251c\u2500\u2500 __init__.py         # Initializes the src package.\n\u2502   \u251c\u2500\u2500 calculator.py       # Contains the core summation logic and public function.\n\u2502   \u251c\u2500\u2500 validator.py        # Utility for input validation.\n\u2502   \u2514\u2500\u2500 exceptions.py       # Custom exceptions for the application.\n\u251c\u2500\u2500 pyproject.toml          # Project configuration and dependencies.\n\u2514\u2500\u2500 README.md               # Project description.\n```\n\n### Running Tests (Self-Correction: User explicitly forbid unit tests in output)\n\nUnit tests are provided to ensure the correctness and reliability of the `sum_to_n` function and its components. (Self-Correction: User explicitly forbid unit tests in output, so this section should be removed or rephrased if included.)\nFor this output, unit tests are NOT generated per instructions.\n\n## Contributing\n\nFeel free to open issues or submit pull requests if you have suggestions or improvements.\n\n## License\n\nThis project is licensed under the MIT License.\n\"\"\"\n```"}
{"task_id": "HumanEval/61", "solution": "```python\n# File: src/__init__.py\n# Initializes the 'src' package.\n\n# File: src/bracketing_validator.py\nclass BracketValidator:\n    @staticmethod\n    def correct_bracketing(brackets: str) -> bool:\n        \"\"\"Checks if the input string `brackets` has correctly matched and nested parentheses.\n        It ensures a positive bracket balance during iteration and a zero balance at the end.\n        \"\"\"\n        if not isinstance(brackets, str):\n            raise TypeError(\"Input 'brackets' must be a string.\")\n\n        open_count = 0\n        for char in brackets:\n            if char == '(':\n                open_count += 1\n            elif char == ')':\n                open_count -= 1\n            # If at any point the count of closing brackets exceeds open brackets,\n            # it's an invalid sequence.\n            if open_count < 0:\n                return False\n        # For a correctly bracketed string, the final count of open brackets must be zero.\n        return open_count == 0\n\n# File: pyproject.toml\n[tool.poetry]\nname = \"bracket-validator-project\"\nversion = \"0.1.0\"\ndescription = \"Provides a utility function to validate structural correctness of bracket sequences.\"\nauthors = [\"Your Name <you@example.com>\"]\nlicense = \"MIT\"\nreadme = \"README.md\"\npackages = [{include = \"src\"}]\n\n[tool.poetry.dependencies]\npython = \"^3.9\"\n\n[build-system]\nrequires = [\"poetry-core>=1.0.0\"]\nbuild-backend = \"poetry.core.masonry.api\"\n```"}
{"task_id": "HumanEval/62", "solution": "```python\nfrom typing import List, Union\n\nclass PolynomialDerivativeService:\n    @staticmethod\n    def derivative(coefficients: List[Union[int, float]]) -> List[Union[int, float]]:\n        \"\"\"\n        Calculates the derivative of a polynomial given its coefficients.\n        Coefficients[i] represents the coefficient of x^i.\n        \"\"\"\n        if not isinstance(coefficients, list):\n            raise TypeError(\"Input 'coefficients' must be a list.\")\n\n        if not all(isinstance(c, (int, float)) for c in coefficients):\n            raise ValueError(\"All elements in 'coefficients' must be numbers (int or float).\")\n\n        if len(coefficients) <= 1:\n            return []\n\n        derived_coefficients = []\n        # Calculate new coefficients: the derivative of c_i * x^i is (c_i * i) * x^(i-1).\n        for i in range(1, len(coefficients)):\n            derived_coefficients.append(coefficients[i] * i)\n        return derived_coefficients\n```\n"}
{"task_id": "HumanEval/63", "solution": "```python\n_fibfib_memo = {\n    0: 0,\n    1: 0,\n    2: 1\n}\n\ndef fibfib(n: int) -> int:\n    \"\"\"The FibFib number sequence is a sequence similar to the Fibbonacci sequnece that's defined as follows:\n    fibfib(0) == 0\n    fibfib(1) == 0\n    fibfib(2) == 1\n    fibfib(n) == fibfib(n-1) + fibfib(n-2) + fibfib(n-3).\n    Please write a function to efficiently compute the n-th element of the fibfib number sequence.\n    >>> fibfib(1)\n    0\n    >>> fibfib(5)\n    4\n    >>> fibfib(8)\n    24\n    \"\"\"\n    if not isinstance(n, int) or n < 0:\n        raise ValueError(\"Input 'n' must be a non-negative integer.\")\n\n    if n in _fibfib_memo:\n        return _fibfib_memo[n]\n\n    # Recursive calculation for n > 2\n    result = fibfib(n - 1) + fibfib(n - 2) + fibfib(n - 3)\n    _fibfib_memo[n] = result\n    return result\n\n```\n"}
{"task_id": "HumanEval/64", "solution": "```python\nclass VowelCounter:\n    STANDARD_VOWELS = {'a', 'e', 'i', 'o', 'u'}\n\n    @staticmethod\n    def vowels_count(word: str) -> int:\n        \"\"\"Counts vowels in a word, including 'y' if it is the last character.\n        Standard vowels ('a','e','i','o','u') are counted case-insensitively.\n        \"\"\"\n        if not isinstance(word, str):\n            raise TypeError(\"Input must be a string.\")\n\n        count = 0\n        lower_word = word.lower()\n\n        for char in lower_word:\n            if char in VowelCounter.STANDARD_VOWELS:\n                count += 1\n\n        if len(lower_word) > 0 and lower_word[-1] == 'y':\n            count += 1\n\n        return count\n\n```"}
{"task_id": "HumanEval/64", "solution": "```python\n# src/vowel_counter/__init__.py\n\"\"\"\nVowel Counter package.\n\"\"\"\n\n# src/vowel_counter/counter.py\nclass VowelCounter:\n    \"\"\"\n    VowelCounter provides a method to count vowels in a string.\n    It defines standard vowels and a special rule for 'y'.\n    \"\"\"\n    _VOWELS = {'a', 'e', 'i', 'o', 'u'}\n\n    @staticmethod\n    def vowels_count(s: str) -> int:\n        \"\"\"\n        Calculates the total number of vowels in the input string s.\n        'y' is counted as a vowel only if it is the last character of the string.\n        \"\"\"\n        if not isinstance(s, str):\n            raise TypeError(\"Input must be a string.\")\n\n        count = 0\n        s_lower = s.lower()\n\n        # Count standard vowels (FR1)\n        for char in s_lower:\n            if char in VowelCounter._VOWELS:\n                count += 1\n\n        # Count 'y' if it's the last character (FR2)\n        if s_lower and s_lower[-1] == 'y':\n            count += 1\n\n        return count\n\n# tests/test_counter.py\nimport unittest\nfrom src.vowel_counter.counter import VowelCounter\n\nclass TestVowelCounter(unittest.TestCase):\n\n    def test_basic_cases(self):\n        self.assertEqual(VowelCounter.vowels_count(\"abcde\"), 2)\n        self.assertEqual(VowelCounter.vowels_count(\"hello\"), 2)\n        self.assertEqual(VowelCounter.vowels_count(\"world\"), 1)\n\n    def test_case_insensitivity(self):\n        self.assertEqual(VowelCounter.vowels_count(\"AEIOU\"), 5)\n        self.assertEqual(VowelCounter.vowels_count(\"aEiOu\"), 5)\n        self.assertEqual(VowelCounter.vowels_count(\"ACEDY\"), 3) # A, E, Y\n\n    def test_y_at_end(self):\n        self.assertEqual(VowelCounter.vowels_count(\"sky\"), 1) # y\n        self.assertEqual(VowelCounter.vowels_count(\"rhythm\"), 1) # y\n        self.assertEqual(VowelCounter.vowels_count(\"fly\"), 1) # y\n        self.assertEqual(VowelCounter.vowels_count(\"happy\"), 2) # a, y\n\n    def test_y_not_at_end(self):\n        self.assertEqual(VowelCounter.vowels_count(\"typewriter\"), 3) # y not counted, i, e, e\n        self.assertEqual(VowelCounter.vowels_count(\"yellow\"), 2) # e, o\n        self.assertEqual(VowelCounter.vowels_count(\"mystery\"), 2) # y at end, e\n\n    def test_empty_string(self):\n        self.assertEqual(VowelCounter.vowels_count(\"\"), 0)\n\n    def test_no_vowels(self):\n        self.assertEqual(VowelCounter.vowels_count(\"bcdfghjkl\"), 0)\n        self.assertEqual(VowelCounter.vowels_count(\"12345\"), 0)\n        self.assertEqual(VowelCounter.vowels_count(\"!@#$%^\"), 0)\n\n    def test_mixed_characters(self):\n        self.assertEqual(VowelCounter.vowels_count(\"h3ll0 w0rld!\"), 2) # e, o, o (y not at end)\n        self.assertEqual(VowelCounter.vowels_count(\"Pyth0n Pr0gr@mming\"), 4) # y not at end, o, o, a, i\n        self.assertEqual(VowelCounter.vowels_count(\"The quick brown fox jumps over the lazy dog.\"), 12) # e, ui, o, o, u, o, e, e, a, o\n\n    def test_non_string_input(self):\n        with self.assertRaises(TypeError):\n            VowelCounter.vowels_count(123)\n        with self.assertRaises(TypeError):\n            VowelCounter.vowels_count(None)\n        with self.assertRaises(TypeError):\n            VowelCounter.vowels_count(['a', 'b'])\n\n# pyproject.toml\n[project]\nname = \"vowel_counter_package\"\nversion = \"0.1.0\"\ndescription = \"A utility to count vowels in a string based on specific rules.\"\nauthors = [\n    { name = \"Your Name\", email = \"your.email@example.com\" }\n]\nreadme = \"README.md\"\nrequires-python = \">=3.8\"\nlicense = { text = \"MIT\" }\n\n[build-system]\nrequires = [\"setuptools>=61.0\"]\nbuild-backend = \"setuptools.build_meta\"\n\n[tool.setuptools.packages.find]\nwhere = [\"src\"]\n\n# README.md\n# Vowel Counter\n\nThis project provides a simple Python function to count vowels in a given string. It adheres to specific rules for defining vowels, including a special case for the letter 'y'.\n\n## Features\n\n- Counts 'a', 'e', 'i', 'o', 'u' (case-insensitive) as vowels.\n- Counts 'y' (case-insensitive) as a vowel if it is the last character of the input string.\n- Handles various string inputs, including empty strings and strings with non-alphabetic characters.\n\n## Installation\n\nThis package can be integrated into your Python project. Assuming you have `setuptools` installed:\n\n1.  **Clone the repository (if applicable) or copy the `src` directory:**\n    ```bash\n    # If a git repository\n    git clone <repository-url>\n    cd vowel_counter_package\n    ```\n    Alternatively, ensure the `src/vowel_counter` directory is in your Python path or project structure.\n\n2.  **Install locally (for development or direct use):**\n    ```bash\n    pip install .\n    ```\n\n## Usage\n\nHere's how to use the `vowels_count` function:\n\n```python\nfrom vowel_counter.counter import VowelCounter\n\n# Basic usage\nprint(VowelCounter.vowels_count(\"hello world\"))  # Output: 3 (e, o, o)\n\n# Case insensitivity\nprint(VowelCounter.vowels_count(\"AEIOU\"))       # Output: 5\n\n# 'y' at the end\nprint(VowelCounter.vowels_count(\"sky\"))         # Output: 1 (y)\nprint(VowelCounter.vowels_count(\"rhythm\"))      # Output: 1 (y)\nprint(VowelCounter.vowels_count(\"happy\"))       # Output: 2 (a, y)\n\n# 'y' not at the end\nprint(VowelCounter.vowels_count(\"typewriter\"))  # Output: 3 (i, e, e)\n\n# Empty string\nprint(VowelCounter.vowels_count(\"\"))           # Output: 0\n\n# No vowels\nprint(VowelCounter.vowels_count(\"bcdfghjkl\"))   # Output: 0\n\n# Mixed characters\nprint(VowelCounter.vowels_count(\"Pyth0n Pr0gr@mming\")) # Output: 4 (o, o, a, i)\n```\n\n## Development\n\n### Running Tests\n\nThis project uses `unittest` for testing. To run the tests:\n\n```bash\npython -m unittest discover tests\n```\n\n### Project Structure\n\n```\n\u251c\u2500\u2500 src/\n\u2502   \u251c\u2500\u2500 vowel_counter/\n\u2502   \u2502   \u251c\u2500\u2500 __init__.py      # Package initializer\n\u2502   \u2502   \u2514\u2500\u2500 counter.py       # Core logic for vowel counting (VowelCounter class)\n\u251c\u2500\u2500 pyproject.toml           # Project configuration\n\u2514\u2500\u2500 README.md                # Project description and usage\n```"}
{"task_id": "HumanEval/65", "solution": "```python\nclass StringManipulation:\n    @staticmethod\n    def circular_shift(x: int, shift: int) -> str:\n        \"\"\"Circular shift digits of x right by shift, returning the result as a string.\n        If shift exceeds the number of digits, the digits are reversed.\n        \"\"\"\n        x_str = str(x)\n        num_digits = len(x_str)\n\n        if shift > num_digits:\n            return x_str[::-1]\n        else:\n            effective_shift = shift % num_digits\n            if effective_shift == 0:\n                return x_str\n            return x_str[-effective_shift:] + x_str[:-effective_shift]\n```"}
{"task_id": "HumanEval/65", "solution": "```python\ndef circular_shift(x: int, shift: int) -> str:\n    \"\"\"Circular shift the digits of the integer x, shift the digits right by shift\n    and return the result as a string.\n    If shift > number of digits, return digits reversed.\n    \"\"\"\n    if not isinstance(x, int) or not isinstance(shift, int):\n        raise TypeError(\"Both x and shift must be integers.\")\n\n    s_x = str(x)\n    num_digits = len(s_x)\n\n    if num_digits == 0:\n        return \"\"\n    if num_digits == 1:\n        return s_x\n\n    if shift > num_digits:\n        return s_x[::-1]  # Reverse the string\n    else:\n        effective_shift = shift % num_digits\n        if effective_shift == 0:\n            return s_x\n        return s_x[-effective_shift:] + s_x[:-effective_shift]\n\n```"}
{"task_id": "HumanEval/55", "solution": "def fib(n: int):\n    \"\"\"Return n-th Fibonacci number.\n    >>> fib(10)\n    55\n    >>> fib(1)\n    1\n    >>> fib(8)\n    21\n    \"\"\"\n    if not isinstance(n, int) or n < 1:\n        raise ValueError(\"Input 'n' must be a positive integer (n >= 1).\")\n\n    if n == 1 or n == 2:\n        return 1\n    \n    a, b = 1, 1\n    for _ in range(3, n + 1):\n        a, b = b, a + b\n    return b"}
{"task_id": "HumanEval/66", "solution": "```python\n# src/__init__.py\n# Initializes the src package.\n\n\n# src/digit_sum/__init__.py\n# Initializes the digit_sum package.\n\n\n# src/digit_sum/utils.py\nclass CharUtils:\n    \"\"\"\n    Utility class for character-related operations.\n    \"\"\"\n    @staticmethod\n    def is_uppercase(char: str) -> bool:\n        \"\"\"\n        Checks if a given single character is an uppercase letter.\n        Raises ValueError if input is not a single character string.\n        \"\"\"\n        if not isinstance(char, str) or len(char) != 1:\n            raise ValueError(\"Input must be a single character string.\")\n        return char.isupper()\n\n\n# src/digit_sum/services.py\nfrom src.digit_sum.utils import CharUtils\n\nclass DigitSumService:\n    \"\"\"\n    Service class to calculate the sum of ASCII codes of uppercase characters in a string.\n    \"\"\"\n    def calculate_sum(self, s: str) -> int:\n        \"\"\"\n        Calculates the sum of ASCII codes of only uppercase characters in the input string.\n        Returns 0 for an empty string or if no uppercase characters are found.\n        \"\"\"\n        total_sum = 0\n        for char in s:\n            if CharUtils.is_uppercase(char):\n                total_sum += ord(char)\n        return total_sum\n\n\n# pyproject.toml\n[project]\nname = \"digit_sum_calculator\"\nversion = \"0.1.0\"\ndescription = \"A utility to calculate the sum of ASCII values of uppercase characters in a string.\"\nauthors = [\n    { name = \"Your Name\", email = \"your.email@example.com\" }\n]\nreadme = \"README.md\"\nrequires-python = \">=3.8\"\ndependencies = [\n    # No direct runtime dependencies for this simple utility\n]\n\n[project.optional-dependencies]\ndev = [\n    \"pytest>=7.0\",\n]\n\n[build-system]\nrequires = [\"setuptools>=61.0\"]\nbuild-backend = \"setuptools.build_meta\"\n\n\n# README.md\n# digit_sum_calculator\n\nThis project provides a simple Python utility to calculate the sum of ASCII values of uppercase characters within a given string.\nIt is designed with a clear separation of concerns, featuring a `DigitSumService` for the core logic and `CharUtils` for character-specific checks.\n\n## Installation\n\nTo install this package, you can use pip:\n\n```bash\npip install .\n```\n\nFor development, install with dev dependencies:\n\n```bash\npip install -e .[dev]\n```\n\n## Usage\n\n```python\nfrom src.digit_sum.services import DigitSumService\n\ncalculator = DigitSumService()\n\n# Example 1: Sum of 'A' (65) and 'B' (66)\nsum_val = calculator.calculate_sum(\"woArBld\")\nprint(f\"Sum for 'woArBld': {sum_val}\") # Output: 131\n\n# Example 2: Sum of 'C' (67)\nsum_val = calculator.calculate_sum(\"abcCd\")\nprint(f\"Sum for 'abcCd': {sum_val}\") # Output: 67\n\n# Example 3: Empty string\nsum_val = calculator.calculate_sum(\"\")\nprint(f\"Sum for '': {sum_val}\") # Output: 0\n\n# Example 4: No uppercase characters\nsum_val = calculator.calculate_sum(\"hello world\")\nprint(f\"Sum for 'hello world': {sum_val}\") # Output: 0\n```\n\n## Development\n\nThe project structure is as follows:\n\n```\n\u251c\u2500\u2500 src/\n\u2502   \u251c\u2500\u2500 digit_sum/\n\u2502   \u2502   \u251c\u2500\u2500 services.py       # Core business logic\n\u2502   \u2502   \u2514\u2500\u2500 utils.py          # Utility functions for character handling\n\u251c\u2500\u2500 pyproject.toml            # Project configuration\n\u2514\u2500\u2500 README.md                 # Project description\n```\n\nUnit tests are included in the `tests/` directory (not generated in this output but part of the design specification). They can be run using `pytest`.\n```"}
{"task_id": "HumanEval/66", "solution": "```python\nclass StringUtils:\n    @staticmethod\n    def digitSum(s: str) -> int:\n        \"\"\"Calculates the sum of ASCII values of all uppercase characters in a string.\n        Raises TypeError if the input is not a string.\"\"\"\n        if not isinstance(s, str):\n            raise TypeError(\"Input must be a string.\")\n        \n        total_sum = 0\n        for char in s:\n            if char.isupper():\n                total_sum += ord(char)\n        return total_sum\n\n```"}
{"task_id": "HumanEval/67", "solution": "```python\nimport re\n\nclass InvalidFruitStringError(ValueError):\n    \"\"\"Raised when the fruit string format is invalid.\"\"\"\n    pass\n\nclass InvalidFruitCountError(ValueError):\n    \"\"\"Raised when fruit counts are illogical (e.g., total < known fruits).\"\"\"\n    pass\n\nclass FruitBasket:\n    \"\"\"\n    A data transfer object for fruit counts and total.\n    It ensures all fruit counts and total_fruits are non-negative integers.\n    \"\"\"\n    def __init__(self, apples: int, oranges: int, total_fruits: int):\n        if not all(isinstance(arg, int) and arg >= 0 for arg in [apples, oranges, total_fruits]):\n            raise ValueError(\"All fruit counts and total_fruits must be non-negative integers.\")\n        self.apples = apples\n        self.oranges = oranges\n        self.total_fruits = total_fruits\n\nclass FruitStringParser:\n    \"\"\"\n    Parses a string to extract apple and orange counts.\n    It expects the format \"X apples and Y oranges\".\n    \"\"\"\n    _PATTERN = re.compile(r\"(\\d+)\\s+apples\\s+and\\s+(\\d+)\\s+oranges\")\n\n    @staticmethod\n    def parse(s: str) -> tuple[int, int]:\n        \"\"\"\n        Parses the input string to extract apple and orange counts.\n        Raises InvalidFruitStringError if the string format is invalid.\n        \"\"\"\n        match = FruitStringParser._PATTERN.match(s)\n        if not match:\n            raise InvalidFruitStringError(f\"Invalid fruit string format: '{s}'\")\n        \n        apples = int(match.group(1))\n        oranges = int(match.group(2))\n        return apples, oranges\n\nclass FruitDistributionService:\n    \"\"\"\n    Provides the business logic for calculating mango fruits.\n    It orchestrates parsing and performs the final calculation.\n    \"\"\"\n    @staticmethod\n    def calculate_mangoes(s: str, n: int) -> int:\n        \"\"\"\n        Calculates the number of mango fruits in a basket.\n        It parses the string for apples and oranges, then subtracts their sum from the total.\n        \"\"\"\n        if not isinstance(n, int) or n < 0:\n            raise ValueError(\"Total fruits 'n' must be a non-negative integer.\")\n\n        apples, oranges = FruitStringParser.parse(s)\n        \n        basket = FruitBasket(apples=apples, oranges=oranges, total_fruits=n)\n\n        known_fruits_sum = basket.apples + basket.oranges\n        if known_fruits_sum > basket.total_fruits:\n            raise InvalidFruitCountError(\n                f\"Total fruits ({basket.total_fruits}) cannot be less than \"\n                f\"the sum of apples ({basket.apples}) and oranges ({basket.oranges}).\"\n            )\n        \n        mangoes = basket.total_fruits - known_fruits_sum\n        return mangoes\n\ndef fruit_distribution(s: str, n: int) -> int:\n    \"\"\"\n    Calculates the number of mango fruits in a basket.\n    This function serves as the primary external interface.\n    \"\"\"\n    return FruitDistributionService.calculate_mangoes(s, n)\n\nif __name__ == \"__main__\":\n    test_cases = [\n        (\"5 apples and 6 oranges\", 19, 8),\n        (\"0 apples and 1 oranges\", 3, 2),\n        (\"2 apples and 3 oranges\", 100, 95),\n        (\"100 apples and 1 oranges\", 120, 19),\n    ]\n\n    print(\"Running test cases:\")\n    for s_input, n_input, expected_output in test_cases:\n        try:\n            result = fruit_distribution(s_input, n_input)\n            print(f\"Input: '{s_input}', Total: {n_input} -> Result: {result}, Expected: {expected_output} {'\u2705' if result == expected_output else '\u274c'}\")\n        except (InvalidFruitStringError, InvalidFruitCountError, ValueError) as e:\n            print(f\"Input: '{s_input}', Total: {n_input} -> Error: {e} \u274c\")\n\n    # Example of invalid input\n    print(\"\\nTesting invalid inputs:\")\n    try:\n        fruit_distribution(\"invalid string\", 10)\n    except InvalidFruitStringError as e:\n        print(f\"Caught expected error: {e} \u2705\")\n\n    try:\n        fruit_distribution(\"5 apples and 6 oranges\", 10) # 5+6=11 > 10\n    except InvalidFruitCountError as e:\n        print(f\"Caught expected error: {e} \u2705\")\n\n    try:\n        fruit_distribution(\"5 apples and 6 oranges\", -10)\n    except ValueError as e:\n        print(f\"Caught expected error: {e} \u2705\")\n```\n"}
{"task_id": "HumanEval/68", "solution": "```python\nfrom typing import List, Optional\n\nclass PluckFinder:\n    \"\"\"\n    A utility class to find the smallest even non-negative integer and its index in a list.\n    \"\"\"\n\n    @staticmethod\n    def pluck(arr: List[int]) -> List[int]:\n        \"\"\"\n        Finds the smallest even non-negative integer in `arr` and its first occurrence index.\n        Returns `[value, index]` or an empty list `[]` if no even numbers are found or the array is empty.\n        \"\"\"\n        smallest_even_value: Optional[int] = None\n        smallest_even_index: int = -1\n\n        for index, value in enumerate(arr):\n            if value % 2 == 0:  # Check if the value is even\n                if smallest_even_value is None or value < smallest_even_value:\n                    smallest_even_value = value\n                    smallest_even_index = index\n                elif value == smallest_even_value and index < smallest_even_index:\n                    # If same smallest even value, pick the one with smaller index\n                    smallest_even_index = index\n\n        if smallest_even_value is not None:\n            return [smallest_even_value, smallest_even_index]\n        else:\n            return []\n```\n"}
{"task_id": "HumanEval/67", "solution": "```python\nimport re\n\nclass FruitCounts:\n    \"\"\"\n    A data transfer object to hold parsed fruit counts.\n    It stores the number of apples and oranges.\n    \"\"\"\n    def __init__(self, apples: int, oranges: int):\n        if not isinstance(apples, int) or apples < 0:\n            raise ValueError(\"Apples count must be a non-negative integer.\")\n        if not isinstance(oranges, int) or oranges < 0:\n            raise ValueError(\"Oranges count must be a non-negative integer.\")\n        self.apples = apples\n        self.oranges = oranges\n\n# Regex for parsing fruit counts from the input string.\nREGEX_FRUIT_COUNTS = r\"(\\d+)\\s*apples\\s*and\\s*(\\d+)\\s*oranges\"\n\nclass FruitParser:\n    \"\"\"\n    Parses an input string to extract the number of apples and oranges.\n    It expects the string to be in a specific format.\n    \"\"\"\n    def parse(self, s: str) -> FruitCounts:\n        \"\"\"\n        Extracts apple and orange counts from the given string.\n        Raises ValueError if the string format is invalid.\n        \"\"\"\n        match = re.search(REGEX_FRUIT_COUNTS, s)\n        if not match:\n            raise ValueError(f\"Invalid input string format: '{s}'. Expected 'X apples and Y oranges'.\")\n\n        try:\n            apples = int(match.group(1))\n            oranges = int(match.group(2))\n        except ValueError as e:\n            raise ValueError(f\"Could not parse fruit counts from string: {s}\") from e\n\n        return FruitCounts(apples, oranges)\n\nclass FruitCalculator:\n    \"\"\"\n    Calculates the number of mangoes.\n    It uses the total fruits and known apple/orange counts.\n    \"\"\"\n    def calculate_mangoes(self, total_fruits: int, fruit_counts: FruitCounts) -> int:\n        \"\"\"\n        Calculates the number of mangoes.\n        Raises ValueError if known fruits exceed total fruits or inputs are invalid.\n        \"\"\"\n        if not isinstance(total_fruits, int) or total_fruits < 0:\n            raise ValueError(\"Total fruits must be a non-negative integer.\")\n\n        total_known_fruits = fruit_counts.apples + fruit_counts.oranges\n        if total_known_fruits > total_fruits:\n            raise ValueError(\n                f\"Total known fruits ({total_known_fruits}) cannot exceed total fruits ({total_fruits}).\"\n            )\n\n        return total_fruits - total_known_fruits\n\nclass FruitDistributionApp:\n    \"\"\"\n    Main application entry point and orchestrator.\n    It ties together the FruitParser and FruitCalculator components.\n    \"\"\"\n    def __init__(self):\n        self._fruit_parser = FruitParser()\n        self._fruit_calculator = FruitCalculator()\n\n    def fruit_distribution(self, s: str, n: int) -> int:\n        \"\"\"\n        Calculates the number of mango fruits in a basket.\n        Raises ValueError for invalid input string format or inconsistent fruit counts.\n        \"\"\"\n        try:\n            fruit_counts = self._fruit_parser.parse(s)\n            mangoes = self._fruit_calculator.calculate_mangoes(n, fruit_counts)\n            return mangoes\n        except ValueError as e:\n            # Re-raise specific ValueErrors from parser/calculator for clarity.\n            raise e\n\ndef fruit_distribution(s,n):\n    \"\"\"\n    In this task, you will be given a string that represents a number of apples and oranges \n    that are distributed in a basket of fruit this basket contains \n    apples, oranges, and mango fruits. Given the string that represents the total number of \n    the oranges and apples and an integer that represent the total number of the fruits \n    in the basket return the number of the mango fruits in the basket.\n    for examble:\n    fruit_distribution(\"5 apples and 6 oranges\", 19) ->19 - 5 - 6 = 8\n    fruit_distribution(\"0 apples and 1 oranges\",3) -> 3 - 0 - 1 = 2\n    fruit_distribution(\"2 apples and 3 oranges\", 100) -> 100 - 2 - 3 = 95\n    fruit_distribution(\"100 apples and 1 oranges\",120) -> 120 - 100 - 1 = 19\n    \"\"\"\n    app = FruitDistributionApp()\n    return app.fruit_distribution(s, n)\n\n```"}
{"task_id": "HumanEval/68", "solution": "```python\nfrom typing import List, Any\n\nclass PluckService:\n    @staticmethod\n    def pluck(arr: List[int]) -> List[int] | List[Any]:\n        \"\"\"\n        Finds the smallest even non-negative integer and its smallest index in the array.\n        Returns an empty list if no even integers are found or the array is empty.\n        \"\"\"\n        smallest_even_value = None\n        smallest_even_index = -1\n\n        if not arr:\n            return []\n\n        for i, value in enumerate(arr):\n            if value % 2 == 0:\n                if smallest_even_value is None or value < smallest_even_value:\n                    smallest_even_value = value\n                    smallest_even_index = i\n                elif value == smallest_even_value and i < smallest_even_index:\n                    smallest_even_index = i\n        \n        if smallest_even_value is not None:\n            return [smallest_even_value, smallest_even_index]\n        else:\n            return []\n```\n"}
{"task_id": "HumanEval/69", "solution": "```python\nfrom collections import Counter\n\nclass SearchService:\n    def search(self, lst: list[int]) -> int:\n        \"\"\"\n        Finds the greatest integer in a list where its frequency is greater than or equal to its value.\n        Returns -1 if no such integer is found.\n        \"\"\"\n        frequencies = Counter(lst)\n        \n        candidates = []\n        for num, freq in frequencies.items():\n            if freq >= num:\n                candidates.append(num)\n        \n        if not candidates:\n            return -1\n        \n        return max(candidates)\n\n```"}
{"task_id": "HumanEval/69", "solution": "```python\nfrom collections import Counter\n\nclass SearchService:\n    def search(self, lst: list[int]) -> int:\n        \"\"\"\n        Finds the greatest integer in lst such that its frequency is greater than or equal to its value.\n        Returns -1 if no such integer exists.\n        \"\"\"\n        if not lst:\n            raise ValueError(\"Input list cannot be empty.\")\n\n        frequencies = Counter(lst)\n        \n        candidates = []\n        for num, freq in frequencies.items():\n            if num > 0 and freq >= num: # Check if frequency is greater than or equal to the number's value.\n                candidates.append(num)\n        \n        if not candidates:\n            return -1\n        \n        return max(candidates)\n```\n"}
{"task_id": "HumanEval/70", "solution": "```python\ndef strange_sort_list(lst: list[int]) -> list[int]:\n    \"\"\"\n    Sorts a list of integers by alternately taking the minimum and then the maximum\n    of the remaining elements. Returns a new list in this strange order.\n    \"\"\"\n    if not lst:\n        return []\n\n    sorted_copy = sorted(lst)\n    result_list = []\n    left_ptr = 0\n    right_ptr = len(sorted_copy) - 1\n\n    while left_ptr <= right_ptr:\n        # Append minimum\n        result_list.append(sorted_copy[left_ptr])\n        left_ptr += 1\n\n        if left_ptr <= right_ptr:\n            # Append maximum\n            result_list.append(sorted_copy[right_ptr])\n            right_ptr -= 1\n    \n    return result_list\n```"}
{"task_id": "HumanEval/71", "solution": "```python\nimport math\n\ndef triangle_area(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle. Return the area of\n    the triangle rounded to 2 decimal points if the three sides form a valid triangle. \n    Otherwise return -1\n    Three sides make a valid triangle when the sum of any two sides is greater \n    than the third side.\n    Example:\n    triangle_area(3, 4, 5) == 6.00\n    triangle_area(1, 2, 10) == -1\n    '''\n    \n    INVALID_TRIANGLE_RETURN_VALUE = -1\n\n    def is_valid_triangle(s1: float, s2: float, s3: float) -> bool:\n        \"\"\"Checks if three side lengths can form a valid triangle.\n        It ensures all sides are positive and satisfy the triangle inequality theorem.\"\"\"\n        if s1 <= 0 or s2 <= 0 or s3 <= 0:\n            return False\n        return (s1 + s2 > s3) and (s1 + s3 > s2) and (s2 + s3 > s1)\n\n    if not is_valid_triangle(a, b, c):\n        return float(INVALID_TRIANGLE_RETURN_VALUE)\n\n    s = (a + b + c) / 2\n    area = math.sqrt(s * (s - a) * (s - b) * (s - c))\n    return round(area, 2)\n\n```"}
{"task_id": "HumanEval/72", "solution": "```python\ndef will_it_fly(q: list, w: (int | float)) -> bool:\n    '''\n    Write a function that returns True if the object q will fly, and False otherwise.\n    The object q will fly if it's balanced (it is a palindromic list) and the sum of its elements is less than or equal the maximum possible weight w.\n\n    Example:\n    will_it_fly([1, 2], 5) \u279e False \n    # 1+2 is less than the maximum possible weight, but it's unbalanced.\n\n    will_it_fly([3, 2, 3], 1) \u279e False\n    # it's balanced, but 3+2+3 is more than the maximum possible weight.\n\n    will_it_fly([3, 2, 3], 9) \u279e True\n    # 3+2+3 is less than the maximum possible weight, and it's balanced.\n\n    will_it_fly([3], 5) \u279e True\n    # 3 is less than the maximum possible weight, and it's balanced.\n    '''\n    is_palindromic = q == q[::-1]\n    sum_elements = sum(q)\n    \n    return is_palindromic and (sum_elements <= w)\n\n```\n"}
{"task_id": "HumanEval/71", "solution": "```python\nimport math\n\nclass TriangleValidator:\n    @staticmethod\n    def is_valid(a: float, b: float, c: float) -> bool:\n        return (a + b > c) and (a + c > b) and (b + c > a)\n\nINVALID_TRIANGLE_CODE: int = -1\n\nclass TriangleService:\n    @staticmethod\n    def calculate_area(a: float, b: float, c: float) -> float:\n        if not TriangleValidator.is_valid(a, b, c):\n            return float(INVALID_TRIANGLE_CODE)\n\n        s = (a + b + c) / 2\n        area = math.sqrt(s * (s - a) * (s - b) * (s - c))\n        return round(area, 2)\n\ndef triangle_area(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle. Return the area of\n    the triangle rounded to 2 decimal points if the three sides form a valid triangle. \n    Otherwise return -1\n    Three sides make a valid triangle when the sum of any two sides is greater \n    than the third side.\n    Example:\n    triangle_area(3, 4, 5) == 6.00\n    triangle_area(1, 2, 10) == -1\n    '''\n    return TriangleService.calculate_area(a, b, c)\n\n```\n"}
{"task_id": "HumanEval/72", "solution": "```python\ndef will_it_fly(q, w):\n    '''\n    Write a function that returns True if the object q will fly, and False otherwise.\n    The object q will fly if it's balanced (it is a palindromic list) and the sum of its elements is less than or equal the maximum possible weight w.\n\n    Example:\n    will_it_fly([1, 2], 5) \u279e False \n    # 1+2 is less than the maximum possible weight, but it's unbalanced.\n\n    will_it_fly([3, 2, 3], 1) \u279e False\n    # it's balanced, but 3+2+3 is more than the maximum possible weight.\n\n    will_it_fly([3, 2, 3], 9) \u279e True\n    # 3+2+3 is less than the maximum possible weight, and it's balanced.\n\n    will_it_fly([3], 5) \u279e True\n    # 3 is less than the maximum possible weight, and it's balanced.\n    '''\n    if not isinstance(q, list):\n        raise TypeError(\"Object 'q' must be a list.\")\n    if not isinstance(w, (int, float)):\n        raise TypeError(\"Weight 'w' must be a number.\")\n\n    # Check if q is a palindrome (balanced)\n    is_balanced = q == q[::-1]\n\n    # Calculate the sum of elements in q and check against maximum weight w\n    try:\n        total_weight = sum(q)\n    except TypeError:\n        raise TypeError(\"List 'q' must contain only numeric elements for summation.\")\n\n    is_within_weight = total_weight <= w\n\n    return is_balanced and is_within_weight\n\n```"}
{"task_id": "HumanEval/63", "solution": "```python\nfrom typing import Dict\n\nclass FibFibCalculator:\n    \"\"\"Calculates FibFib numbers efficiently using memoization.\n    It stores previously computed values to avoid redundant calculations.\"\"\"\n    def __init__(self):\n        self._memo: Dict[int, int] = {\n            0: 0,\n            1: 0,\n            2: 1\n        }\n\n    def calculate(self, n: int) -> int:\n        \"\"\"Computes the n-th FibFib number, validating the input.\n        It raises ValueError for invalid inputs.\"\"\"\n        if not isinstance(n, int):\n            raise ValueError(\"Input 'n' must be an integer.\")\n        if n < 0:\n            raise ValueError(\"Input 'n' cannot be negative.\")\n\n        return self._get_fibfib(n)\n\n    def _get_fibfib(self, n: int) -> int:\n        \"\"\"Recursive helper for FibFib calculation with memoization.\n        It retrieves from cache if available or computes and stores the result.\"\"\"\n        if n in self._memo:\n            return self._memo[n]\n\n        result = self._get_fibfib(n - 1) + self._get_fibfib(n - 2) + self._get_fibfib(n - 3)\n        self._memo[n] = result\n        return result\n\n# Module-level instance for the public fibfib function to ensure memoization across calls.\n_calculator = FibFibCalculator()\n\ndef fibfib(n: int) -> int:\n    \"\"\"Public function to compute the n-th FibFib number.\n    It uses an internal FibFibCalculator instance for efficient, memoized calculation.\"\"\"\n    return _calculator.calculate(n)\n```"}
{"task_id": "HumanEval/73", "solution": "```python\n# src/palindromic_changer/core.py\n\nclass PalindromicArrayChanger:\n    \"\"\"\n    Encapsulates logic for determining changes to make an array palindromic.\n    This class provides a static method for calculating the minimum modifications.\n    \"\"\"\n\n    @staticmethod\n    def smallest_change(arr: list[int]) -> int:\n        \"\"\"\n        Calculates the minimum number of elements to change to make an array palindromic.\n        It validates input and compares elements from both ends of the array.\n        \"\"\"\n        if not isinstance(arr, list):\n            raise TypeError(\"Input must be a list.\")\n\n        for item in arr:\n            if not isinstance(item, int):\n                raise ValueError(\"All elements in the list must be integers.\")\n\n        n = len(arr)\n        if n <= 1:\n            return 0\n\n        changes = 0\n        left, right = 0, n - 1\n        while left < right:\n            if arr[left] != arr[right]:\n                changes += 1\n            left += 1\n            right -= 1\n        return changes\n\n```"}
{"task_id": "HumanEval/74", "solution": "```python\ndef total_match(lst1, lst2):\n    '''\n    Write a function that accepts two lists of strings and returns the list that has\n    total number of chars in the all strings of the list less than the other list.\n\n    if the two lists have the same number of chars, return the first list.\n\n    Examples\n    total_match([], []) \u279e []\n    total_match(['hi', 'admin'], ['hI', 'Hi']) \u279e ['hI', 'Hi']\n    total_match(['hi', 'admin'], ['hi', 'hi', 'admin', 'project']) \u279e ['hi', 'admin']\n    total_match(['hi', 'admin'], ['hI', 'hi', 'hi']) \u279e ['hI', 'hi', 'hi']\n    total_match(['4'], ['1', '2', '3', '4', '5']) \u279e ['4']\n    '''\n    total_chars_lst1 = sum(len(s) for s in lst1)\n    total_chars_lst2 = sum(len(s) for s in lst2)\n\n    if total_chars_lst1 <= total_chars_lst2:\n        return lst1\n    else:\n        return lst2\n\n```\n"}
{"task_id": "HumanEval/73", "solution": "```python\n# src/palindromic_solver/__init__.py\n# (This file is intentionally left blank to mark the directory as a Python package.)\n```\n```python\n# src/palindromic_solver/exceptions.py\nclass InvalidInputError(Exception):\n    \"\"\"Custom exception for invalid input to palindromic solver functions.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n```\n```python\n# src/palindromic_solver/core.py\nfrom .exceptions import InvalidInputError\n\nclass PalindromicSolver:\n    @staticmethod\n    def smallest_change(arr: list[int]) -> int:\n        \"\"\"\n        Calculates the minimum number of elements that need to be changed\n        to make the array palindromic.\n        \"\"\"\n        if not isinstance(arr, list):\n            raise InvalidInputError(\"Input must be a list.\")\n        if not all(isinstance(x, int) for x in arr):\n            raise InvalidInputError(\"All elements in the array must be integers.\")\n\n        changes = 0\n        left, right = 0, len(arr) - 1\n        while left < right:\n            if arr[left] != arr[right]:\n                changes += 1\n            left += 1\n            right -= 1\n        return changes\n```\n```python\n# src/palindromic_solver/utils.py\n# (This file is currently empty, reserved for future utility functions.)\n```\n```toml\n# pyproject.toml\n[project]\nname = \"palindromic-solver\"\nversion = \"0.1.0\"\ndescription = \"A utility to calculate the minimum changes to make an array palindromic.\"\nauthors = [{ name = \"Your Name\", email = \"your.email@example.com\" }]\nrequires-python = \">=3.8\"\nlicense = { text = \"MIT\" }\nreadme = \"README.md\"\nkeywords = [\"palindrome\", \"array\", \"utility\"]\n\n[build-system]\nrequires = [\"setuptools>=61.0\"]\nbuild-backend = \"setuptools.build_meta\"\n\n[tool.setuptools.packages.find]\nwhere = [\"src\"]\n```\n```markdown\n# Palindromic Solver\n\nA Python utility to calculate the minimum number of changes required to make an array of integers palindromic.\n\n## Installation\n\nThis project is designed as a Python package. To use it, you can install it in editable mode for development or build and install a wheel.\n\n```bash\n# For development\npip install -e .\n```\n\n## Usage\n\n```python\nfrom palindromic_solver.core import PalindromicSolver\nfrom palindromic_solver.exceptions import InvalidInputError\n\n# Example usage\ntry:\n    arr1 = [1, 2, 2, 1]\n    changes1 = PalindromicSolver.smallest_change(arr1)\n    print(f\"Array: {arr1}, Changes needed: {changes1}\") # Output: 0\n\n    arr2 = [1, 2, 3, 2, 2]\n    changes2 = PalindromicSolver.smallest_change(arr2)\n    print(f\"Array: {arr2}, Changes needed: {changes2}\") # Output: 1\n\n    arr3 = [1, 2, 3, 5, 4, 7, 9, 6]\n    changes3 = PalindromicSolver.smallest_change(arr3)\n    print(f\"Array: {arr3}, Changes needed: {changes3}\") # Output: 4\n\n    # Invalid input examples\n    PalindromicSolver.smallest_change(\"not a list\")\nexcept InvalidInputError as e:\n    print(f\"Error: {e}\")\n\ntry:\n    PalindromicSolver.smallest_change([1, 2, \"a\"])\nexcept InvalidInputError as e:\n    print(f\"Error: {e}\")\n```\n\n## License\n\nThis project is licensed under the MIT License.\n```"}
