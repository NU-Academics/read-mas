{"task_id": "HumanEval/97", "solution": "```python\nclass UnitDigitExtractor:\n    def extract(self, n: int) -> int:\n        \"\"\"Extracts the unit digit of an integer. Handles both positive and negative numbers.\"\"\"\n        if not isinstance(n, int):\n            raise TypeError(\"Input must be an integer.\")\n        return abs(n) % 10\n\nclass CalculatorService:\n    def __init__(self):\n        self._unit_digit_extractor = UnitDigitExtractor()\n\n    def multiply(self, a: int, b: int) -> int:\n        \"\"\"Calculates the product of the unit digits of two integers. Raises TypeError if inputs are not integers.\"\"\"\n        if not isinstance(a, int) or not isinstance(b, int):\n            raise TypeError(\"Both inputs must be integers.\")\n\n        unit_digit_a = self._unit_digit_extractor.extract(a)\n        unit_digit_b = self._unit_digit_extractor.extract(b)\n\n        return unit_digit_a * unit_digit_b\n```"}
{"task_id": "HumanEval/96", "solution": "```python\n# src/prime_calculator/__init__.py\n\"\"\"\nInitializes the prime_calculator package.\n\"\"\"\n```\n```python\n# src/prime_calculator/utils.py\nimport math\n\nclass PrimeUtils:\n    @staticmethod\n    def is_prime(num: int) -> bool:\n        \"\"\"\n        Checks if a given number is a prime number.\n        Raises ValueError for negative input, TypeError for non-integer input.\n        \"\"\"\n        if not isinstance(num, int):\n            raise TypeError(\"Input 'num' must be an integer.\")\n        if num < 0:\n            raise ValueError(\"Input 'num' must be a non-negative integer.\")\n        if num < 2:\n            return False\n        \n        # Check for divisibility from 2 up to the square root of num.\n        # This optimizes the primality test.\n        for i in range(2, int(math.sqrt(num)) + 1):\n            if num % i == 0:\n                return False\n        return True\n```\n```python\n# src/prime_calculator/services.py\nfrom .utils import PrimeUtils\n\nclass PrimeCalculatorService:\n    \"\"\"\n    Service class for calculating prime numbers up to a given limit.\n    It orchestrates primality testing to build a list of primes.\n    \"\"\"\n    def count_up_to(self, n: int) -> list[int]:\n        \"\"\"\n        Computes and returns a list of all prime numbers strictly less than the input 'n'.\n        Raises ValueError for negative input, TypeError for non-integer input.\n        \"\"\"\n        if not isinstance(n, int):\n            raise TypeError(\"Input 'n' must be an integer.\")\n        if n < 0:\n            raise ValueError(\"Input 'n' must be a non-negative integer.\")\n        \n        if n <= 1:\n            return []\n\n        primes = []\n        # Iterate from 2 up to n-1 (exclusive of n) and test each number.\n        for i in range(2, n):\n            if PrimeUtils.is_prime(i):\n                primes.append(i)\n        return primes\n```"}
{"task_id": "HumanEval/87", "solution": "```python\nclass ListFinder:\n    @staticmethod\n    def get_row(lst: list[list[int]], x: int) -> list[tuple[int, int]]:\n        \"\"\"\n        Finds all occurrences of 'x' in a nested list 'lst' and returns their\n        0-indexed (row, column) coordinates.\n        The results are sorted first by row (ascending) then by column (descending).\n        \"\"\"\n        if not isinstance(lst, list):\n            raise TypeError(\"Input 'lst' must be a list.\")\n        if not isinstance(x, int):\n            raise TypeError(\"Input 'x' must be an integer.\")\n\n        found_coordinates: list[tuple[int, int]] = []\n\n        for row_idx, row in enumerate(lst):\n            if not isinstance(row, list):\n                continue # Skips non-list rows.\n            for col_idx, element in enumerate(row):\n                if not isinstance(element, int):\n                    continue # Skips non-integer elements.\n                if element == x:\n                    found_coordinates.append((row_idx, col_idx))\n\n        # Sort by row (ascending) then by column (descending).\n        found_coordinates.sort(key=lambda coord: (coord[0], -coord[1]))\n\n        return found_coordinates\n```"}
{"task_id": "HumanEval/98", "solution": "UPPERCASE_VOWELS = {'A', 'E', 'I', 'O', 'U'}\n\ndef count_upper(s):\n    \"\"\"\n    Given a string s, count the number of uppercase vowels in even indices.\n    \n    For example:\n    count_upper('aBCdEf') returns 1\n    count_upper('abcdefg') returns 0\n    count_upper('dBBE') returns 0\n    \"\"\"\n    if not isinstance(s, str):\n        raise TypeError(\"Input 's' must be a string.\")\n\n    count = 0\n    for i, char in enumerate(s):\n        if i % 2 == 0 and char in UPPERCASE_VOWELS:\n            count += 1\n    return count"}
{"task_id": "HumanEval/99", "solution": "```python\nimport math\n\ndef closest_integer(value: str) -> int:\n    \"\"\"\n    Takes a string representing a number and returns the closest integer.\n    If equidistant, it rounds away from zero.\n    \"\"\"\n    try:\n        num = float(value)\n    except ValueError:\n        raise ValueError(f\"Invalid input: '{value}' is not a valid number.\")\n\n    floor_num = math.floor(num)\n    ceil_num = math.ceil(num)\n\n    if num == floor_num:\n        return int(num)\n\n    dist_to_floor = abs(num - floor_num)\n    dist_to_ceil = abs(num - ceil_num)\n\n    if dist_to_floor == dist_to_ceil:\n        # Equidistant, round away from zero.\n        return int(ceil_num) if num > 0 else int(floor_num)\n    elif dist_to_floor < dist_to_ceil:\n        return int(floor_num)\n    else:\n        return int(ceil_num)\n```"}
{"task_id": "HumanEval/98", "solution": "```python\n# src/string_utils.py\nclass StringUtils:\n    \"\"\"Provides utility methods for string manipulation and analysis.\"\"\"\n    UPPERCASE_VOWELS = {'A', 'E', 'I', 'O', 'U'}\n\n    @staticmethod\n    def count_upper(s: str) -> int:\n        \"\"\"\n        Counts uppercase vowels at even indices in a string.\n        It iterates through the string, checking index parity and character type.\n        \"\"\"\n        count = 0\n        for i, char in enumerate(s):\n            if i % 2 == 0 and char in StringUtils.UPPERCASE_VOWELS:\n                count += 1\n        return count\n```\n```toml\n# pyproject.toml\n[project]\nname = \"string-analyzer\"\nversion = \"0.1.0\"\ndescription = \"A utility for string analysis, including counting uppercase vowels at even indices.\"\nauthors = [{ name = \"Your Name\", email = \"your.email@example.com\" }]\nrequires-python = \">=3.8\"\nlicense = { text = \"MIT\" }\nreadme = \"README.md\"\n\n[build-system]\nrequires = [\"setuptools>=61.0\"]\nbuild-backend = \"setuptools.build_meta\"\n\n[tool.setuptools.packages.find]\nwhere = [\"src\"]\n```\n```markdown\n# string-analyzer\n\nA lightweight Python utility for specific string analysis tasks. This package provides functions for character-based string pattern recognition.\n\n## Features\n\n-   `StringUtils.count_upper(s: str) -> int`: Counts uppercase vowels ('A', 'E', 'I', 'O', 'U') found at even indices (0-based) in a given string.\n\n## Installation\n\nTo use this utility, you can install it after building the package:\n\n```bash\n# From the project root, build the package\npython -m build\n\n# Install the built wheel file\npip install dist/string_analyzer-0.1.0-py3-none-any.whl\n```\nAlternatively, for development, install in editable mode:\n```bash\npip install -e .\n```\n\n## Usage\n\n```python\nfrom string_analyzer.string_utils import StringUtils # Correct import after package installation\n\n# Example usage\nstring1 = \"AEIOU\"\ncount1 = StringUtils.count_upper(string1)\nprint(f\"'{string1}' -> Count: {count1}\") # Expected: 3 ('A', 'I', 'U' at indices 0, 2, 4)\n\nstring2 = \"aBCdEf\"\ncount2 = StringUtils.count_upper(string2)\nprint(f\"'{string2}' -> Count: {count2}\") # Expected: 1 ('E' at index 4)\n\nstring3 = \"HELLO WORLD\"\ncount3 = StringUtils.count_upper(string3)\nprint(f\"'{string3}' -> Count: {count3}\") # Expected: 2 ('O' at index 4, and no other uppercase vowels at even indices)\n```\n\n## Development\n\nTo set up a development environment:\n\n1.  Clone the repository and navigate into the project directory.\n2.  Install in editable mode:\n    ```bash\n    pip install -e .\n    ```\n\n## License\n\nThis project is licensed under the MIT License.\n```"}
{"task_id": "HumanEval/99", "solution": "```python\nimport math\n\ndef closest_integer(value):\n    '''\n    Create a function that takes a value (string) representing a number\n    and returns the closest integer to it. If the number is equidistant\n    from two integers, round it away from zero.\n\n    Examples\n    >>> closest_integer(\"10\")\n    10\n    >>> closest_integer(\"15.3\")\n    15\n\n    Note:\n    Rounding away from zero means that if the given number is equidistant\n    from two integers, the one you should return is the one that is the\n    farthest from zero. For example closest_integer(\"14.5\") should\n    return 15 and closest_integer(\"-14.5\") should return -15.\n    '''\n    num_float = float(value)\n    \n    # Determine the two closest integers\n    floor_val = math.floor(num_float)\n    ceil_val = math.ceil(num_float)\n    \n    # Calculate distances\n    dist_to_floor = abs(num_float - floor_val)\n    dist_to_ceil = abs(num_float - ceil_val)\n    \n    if dist_to_floor == dist_to_ceil: # Equidistant case (e.g., X.5)\n        if num_float >= 0:\n            return int(ceil_val) # Round up for positive .5\n        else:\n            return int(floor_val) # Round down for negative .5 (away from zero)\n    elif dist_to_floor < dist_to_ceil:\n        return int(floor_val)\n    else: # dist_to_ceil < dist_to_floor\n        return int(ceil_val)\n\n```"}
