{"task_id": "HumanEval/96", "solution": "```python\n# src/prime_calculator/__init__.py\n# Package initializer for prime_calculator.\n# This file makes prime_calculator a Python package.\n\n```\n\n```python\n# src/prime_calculator/validators.py\nfrom typing import Any\n\nclass InputValidator:\n    \"\"\"Provides static utility methods for validating various input types and constraints.\"\"\"\n    \n    @staticmethod\n    def validate_integer(value: Any, param_name: str) -> None:\n        \"\"\"Checks if the given value is an integer, raising TypeError if not.\"\"\"\n        if not isinstance(value, int):\n            raise TypeError(f\"Parameter '{param_name}' must be an integer.\")\n\n    @staticmethod\n    def validate_positive_integer(value: int, param_name: str) -> None:\n        \"\"\"Checks if the given value is non-negative, raising ValueError if negative.\"\"\"\n        if value < 0:\n            raise ValueError(f\"Parameter '{param_name}' must be a non-negative integer.\")\n\n```\n\n```python\n# src/prime_calculator/calculator.py\nfrom typing import List\nfrom .validators import InputValidator\n\nclass PrimeCalculator:\n    \"\"\"Manages the core logic for finding prime numbers up to a given limit.\"\"\"\n\n    @staticmethod\n    def count_up_to(n: int) -> List[int]:\n        \"\"\"Calculates all prime numbers strictly less than n.\n        It performs input validation and then delegates to the internal prime generation method.\"\"\"\n        InputValidator.validate_integer(n, \"n\")\n        InputValidator.validate_positive_integer(n, \"n\")\n\n        if n <= 2:\n            return []\n\n        return PrimeCalculator._sieve_of_eratosthenes(n)\n\n    @staticmethod\n    def _sieve_of_eratosthenes(limit: int) -> List[int]:\n        \"\"\"Implements the Sieve of Eratosthenes to efficiently find all prime numbers up to limit.\"\"\"\n        is_prime = [True] * limit\n        is_prime[0] = is_prime[1] = False\n        \n        for p in range(2, int(limit**0.5) + 1):\n            if is_prime[p]:\n                for multiple in range(p * p, limit, p):\n                    is_prime[multiple] = False\n        \n        primes = [i for i, prime in enumerate(is_prime) if prime]\n        return primes\n\n```"}
