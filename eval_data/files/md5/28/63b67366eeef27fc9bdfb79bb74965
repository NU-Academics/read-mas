{"task_id": "HumanEval/46", "solution": "```python\nclass Fib4Calculator:\n    \"\"\"\n    A class to compute the n-th element of the Fib4 number sequence.\n    This implementation uses an iterative approach for efficiency.\n    \"\"\"\n\n    def fib4(self, n: int) -> int:\n        \"\"\"\n        Computes the n-th element of the Fib4 number sequence iteratively.\n        Raises ValueError if 'n' is negative, otherwise returns the correct Fib4 number.\n        \"\"\"\n        if n < 0:\n            raise ValueError(\"Input 'n' must be a non-negative integer.\")\n        elif n == 0:\n            return 0\n        elif n == 1:\n            return 0\n        elif n == 2:\n            return 2\n        elif n == 3:\n            return 0\n        else:\n            # Initialize the four previous fib4 numbers for the iteration.\n            # a=fib4(i-4), b=fib4(i-3), c=fib4(i-2), d=fib4(i-1)\n            a, b, c, d = 0, 0, 2, 0\n\n            for _ in range(4, n + 1):\n                next_fib4 = a + b + c + d\n                a, b, c, d = b, c, d, next_fib4\n            return d\n```\n"}
{"task_id": "HumanEval/38", "solution": "```python\ndef decode_cyclic(s: str):\n    \"\"\"\n    Takes as input string encoded with encode_cyclic function. Returns decoded string.\n    \"\"\"\n    if not isinstance(s, str):\n        raise TypeError(\"Input must be a string.\")\n\n    # split string to groups. Each of length 3.\n    groups = [s[(3 * i):min((3 * i + 3), len(s))] for i in range((len(s) + 2) // 3)]\n    # inverse cycle elements in each group. Unless group has fewer elements than 3.\n    groups = [(group[-1] + group[:-1]) if len(group) == 3 else group for group in groups]\n    return \"\".join(groups)\n\n```"}
{"task_id": "HumanEval/46", "solution": "class InvalidInputError(Exception):\n    \"\"\"Custom exception for invalid input parameters.\"\"\"\n    pass\n\nFIB4_INITIAL_VALUES = {\n    0: 0,\n    1: 0,\n    2: 2,\n    3: 0\n}\n\ndef fib4(n: int) -> int:\n    \"\"\"The Fib4 number sequence is a sequence similar to the Fibbonacci sequnece that's defined as follows:\n    fib4(0) -> 0\n    fib4(1) -> 0\n    fib4(2) -> 2\n    fib4(3) -> 0\n    fib4(n) -> fib4(n-1) + fib4(n-2) + fib4(n-3) + fib4(n-4).\n    Please write a function to efficiently compute the n-th element of the fib4 number sequence.  Do not use recursion.\n    >>> fib4(5)\n    4\n    >>> fib4(6)\n    8\n    >>> fib4(7)\n    14\n    \"\"\"\n    if n < 0:\n        raise InvalidInputError(\"Input 'n' must be a non-negative integer.\")\n\n    if n in FIB4_INITIAL_VALUES:\n        return FIB4_INITIAL_VALUES[n]\n\n    dp_array = [0] * (n + 1)\n\n    dp_array[0] = FIB4_INITIAL_VALUES[0]\n    dp_array[1] = FIB4_INITIAL_VALUES[1]\n    dp_array[2] = FIB4_INITIAL_VALUES[2]\n    dp_array[3] = FIB4_INITIAL_VALUES[3]\n\n    for i in range(4, n + 1):\n        dp_array[i] = dp_array[i-1] + dp_array[i-2] + dp_array[i-3] + dp_array[i-4]\n\n    return dp_array[n]"}
{"task_id": "HumanEval/50", "solution": "```python\nclass ShiftDecoder:\n    SHIFT_AMOUNT = 5\n\n    @staticmethod\n    def encode_shift(s: str) -> str:\n        \"\"\"Encodes a string by shifting each character by SHIFT_AMOUNT positions.\n        Raises ValueError if the input contains non-lowercase English letters.\"\"\"\n        if not s.islower() or not s.isalpha():\n            raise ValueError(\"Input string must contain only lowercase English letters.\")\n        return \"\".join([chr(((ord(ch) + ShiftDecoder.SHIFT_AMOUNT - ord(\"a\")) % 26) + ord(\"a\")) for ch in s])\n\n    @staticmethod\n    def decode_shift(s: str) -> str:\n        \"\"\"Decodes a string that has been shifted by SHIFT_AMOUNT positions.\n        Raises ValueError if the input contains non-lowercase English letters.\"\"\"\n        if not s.islower() or not s.isalpha():\n            raise ValueError(\"Input string must contain only lowercase English letters.\")\n        return \"\".join([chr(((ord(ch) - ShiftDecoder.SHIFT_AMOUNT - ord(\"a\") + 26) % 26) + ord(\"a\")) for ch in s])\n```"}
{"task_id": "HumanEval/57", "solution": "```python\ndef monotonic(l: list) -> bool:\n    \"\"\"Checks if the elements in the input list `l` are monotonically increasing or monotonically decreasing.\n    Returns True if the list is monotonic (increasing or decreasing), False otherwise.\"\"\"\n    if len(l) <= 1:\n        return True\n\n    is_increasing = True\n    is_decreasing = True\n\n    for i in range(len(l) - 1):\n        if l[i] > l[i+1]:\n            is_increasing = False\n        if l[i] < l[i+1]:\n            is_decreasing = False\n\n    return is_increasing or is_decreasing\n```"}
{"task_id": "HumanEval/52", "solution": "```python\n# src/models.py\nfrom typing import List, Union\nfrom pydantic import BaseModel, Field\n\nclass ThresholdCheckRequest(BaseModel):\n    \"\"\"Defines the structure for incoming API requests to check thresholds.\"\"\"\n    numbers: List[Union[int, float]] = Field(..., description=\"List of numbers to check against the threshold.\")\n    threshold: int = Field(..., description=\"The integer threshold.\")\n\nclass ThresholdCheckResponse(BaseModel):\n    \"\"\"Defines the structure for outgoing API responses after checking thresholds.\"\"\"\n    is_below_threshold: bool = Field(..., description=\"True if all numbers are below the threshold, False otherwise.\")\n\n```\n```python\n# src/exceptions.py\nclass InvalidInputError(Exception):\n    \"\"\"Custom exception for signaling invalid input data within the service layer.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\n\n```\n```python\n# src/services.py\nfrom typing import List, Union\nfrom src.exceptions import InvalidInputError\n\nclass ThresholdService:\n    \"\"\"Encapsulates the core business logic for determining if numbers are below a threshold.\"\"\"\n    def check_below_threshold(self, numbers: List[Union[int, float]], threshold: int) -> bool:\n        \"\"\"\n        Return True if all numbers in the list are strictly below threshold.\n        Raises InvalidInputError if `numbers` contains non-numeric elements.\n        \"\"\"\n        # Pydantic handles overall list/int types for top-level request body,\n        # but internal service checks for robustness as per FR1 error handling.\n        if not isinstance(numbers, list):\n            raise InvalidInputError(\"Input 'numbers' must be a list.\")\n        if not isinstance(threshold, int):\n            raise InvalidInputError(\"Input 'threshold' must be an integer.\")\n\n        for num in numbers:\n            if not isinstance(num, (int, float)):\n                raise InvalidInputError(f\"All elements in 'numbers' must be numeric. Found: {type(num).__name__}\")\n            if num >= threshold: # BR1: strictly less than, so >= implies False\n                return False\n        return True # FR4: Returns True for an empty list (vacuously true)\n\n```\n```python\n# src/controllers.py\nfrom fastapi import APIRouter, Depends, HTTPException, status\nfrom src.models import ThresholdCheckRequest, ThresholdCheckResponse\nfrom src.services import ThresholdService\nfrom src.exceptions import InvalidInputError\n\nclass ThresholdController:\n    \"\"\"Acts as the API layer, handling HTTP requests and delegating to the ThresholdService.\"\"\"\n    def __init__(self, service: ThresholdService = Depends()):\n        self.service = service\n        self.router = APIRouter()\n        # Register the endpoint with the router\n        self.router.post(\"/check_threshold\", response_model=ThresholdCheckResponse)(self.check_threshold_endpoint)\n\n    async def check_threshold_endpoint(self, request: ThresholdCheckRequest) -> ThresholdCheckResponse:\n        \"\"\"\n        FastAPI endpoint handler for checking if numbers are below a threshold.\n        Translates service exceptions into appropriate HTTP responses.\n        \"\"\"\n        try:\n            is_below = self.service.check_below_threshold(request.numbers, request.threshold)\n            return ThresholdCheckResponse(is_below_threshold=is_below)\n        except InvalidInputError as e:\n            # FR5: Handle non-numeric elements within the input list\n            raise HTTPException(\n                status_code=status.HTTP_400_BAD_REQUEST,\n                detail=f\"Invalid input: {e.message}\"\n            )\n        # Pydantic handles HTTP 422 for schema validation errors (e.g., threshold not int) automatically.\n\n```\n```python\n# src/main.py\nfrom fastapi import FastAPI\nfrom src.controllers import ThresholdController\nfrom src.services import ThresholdService\n\napp = FastAPI(\n    title=\"Threshold Checker API\",\n    description=\"A simple API to check if a list of numbers is below a given threshold.\",\n    version=\"1.0.0\"\n)\n\n# Initialize service and controller for dependency injection\nthreshold_service = ThresholdService()\nthreshold_controller = ThresholdController(service=threshold_service)\n\n# Include the controller's router in the main app\napp.include_router(threshold_controller.router)\n\n@app.get(\"/\")\nasync def root():\n    \"\"\"Provides a welcome message and directs to API documentation.\"\"\"\n    return {\"message\": \"Welcome to the Threshold Checker API. Use /docs for API documentation.\"}\n```"}
