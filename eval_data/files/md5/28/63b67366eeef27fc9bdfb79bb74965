{"task_id": "HumanEval/117", "solution": "```python\n# src/word_selector/__init__.py\n\"\"\"Word selector package.\"\"\"\n\n# src/word_selector/constants.py\nclass Constants:\n    \"\"\"Defines global constants for the word selector system.\"\"\"\n    VOWELS = {'a', 'e', 'i', 'o', 'u'}\n\n# src/word_selector/utils.py\nfrom .constants import Constants\n\nclass WordUtils:\n    \"\"\"Provides utility methods for character and word analysis.\"\"\"\n\n    @staticmethod\n    def is_vowel(char: str) -> bool:\n        \"\"\"Checks if a given character is a vowel, case-insensitive.\"\"\"\n        return char.lower() in Constants.VOWELS\n\n    @staticmethod\n    def count_consonants(word: str) -> int:\n        \"\"\"Counts consonants in a word, ignoring non-alphabetic characters.\"\"\"\n        consonant_count = 0\n        for char in word:\n            if char.isalpha() and not WordUtils.is_vowel(char):\n                consonant_count += 1\n        return consonant_count\n\n# src/word_selector/selector.py\nfrom .utils import WordUtils\n\nclass WordSelectorService:\n    \"\"\"Implements the core logic for selecting words based on consonant count.\"\"\"\n\n    @staticmethod\n    def select_words(s: str, n: int) -> list[str]:\n        \"\"\"Filters words from a string that contain exactly 'n' consonants.\n        Returns words in their original order, handling empty input string.\"\"\"\n        if not s:\n            return []\n\n        words = s.split()\n        result = []\n        for word in words:\n            if WordUtils.count_consonants(word) == n:\n                result.append(word)\n        return result\n```"}
{"task_id": "HumanEval/118", "solution": "```python\n# src/vowel_finder/utils.py\nclass VowelUtils:\n    \"\"\"Provides utility methods for classifying characters as vowels or consonants.\"\"\"\n    VOWELS = \"aeiouAEIOU\"\n\n    @staticmethod\n    def is_vowel(char: str) -> bool:\n        \"\"\"Checks if a given character is an English vowel (case-insensitive).\"\"\"\n        return char in VowelUtils.VOWELS\n\n    @staticmethod\n    def is_consonant(char: str) -> bool:\n        \"\"\"Checks if a given character is an English consonant (case-insensitive).\"\"\"\n        return char.isalpha() and not VowelUtils.is_vowel(char)\n\n```\n```python\n# src/vowel_finder/finder.py\nfrom .utils import VowelUtils\n\nclass VowelFinder:\n    \"\"\"Finds the closest vowel between two consonants from the right side of a word.\"\"\"\n    @staticmethod\n    def get_closest_vowel(word: str) -> str:\n        \"\"\"Iterates through the word from right to left to find the specified vowel.\"\"\"\n        n = len(word)\n        if n < 3:  # A CVC pattern requires at least three characters.\n            return \"\"\n\n        # Iterate from right to left, excluding the first and last characters.\n        for i in range(n - 2, 0, -1):\n            current_char = word[i]\n            if VowelUtils.is_vowel(current_char):\n                prev_char = word[i - 1]\n                next_char = word[i + 1]\n                if VowelUtils.is_consonant(prev_char) and VowelUtils.is_consonant(next_char):\n                    return current_char\n        return \"\"\n\n```"}
{"task_id": "HumanEval/117", "solution": "```python\n# src/constants.py\nVOWELS_LOWERCASE = {'a', 'e', 'i', 'o', 'u'}\n\n```\n```python\n# src/consonant_counter.py\nfrom src.constants import VOWELS_LOWERCASE\n\nclass ConsonantCounter:\n    def count(self, word: str) -> int:\n        # Validate input word type.\n        if not isinstance(word, str):\n            raise TypeError(\"Input 'word' must be a string.\")\n        \n        consonant_count = 0\n        for char in word:\n            # Check if character is a letter and not a vowel (case-insensitive).\n            if 'a' <= char.lower() <= 'z' and char.lower() not in VOWELS_LOWERCASE:\n                consonant_count += 1\n        return consonant_count\n\n```\n```python\n# src/word_selector_service.py\nfrom src.consonant_counter import ConsonantCounter\n\nclass WordSelectorService:\n    def __init__(self, consonant_counter: ConsonantCounter):\n        # Initialize the service with a ConsonantCounter instance.\n        self.consonant_counter = consonant_counter\n\n    def select_words(self, s: str, n: int) -> list[str]:\n        # Validate input types and n's value.\n        if not isinstance(s, str):\n            raise TypeError(\"Input 's' must be a string.\")\n        if not isinstance(n, int):\n            raise TypeError(\"Input 'n' must be an integer.\")\n        if n < 0:\n            raise ValueError(\"Input 'n' must be a non-negative integer.\")\n\n        # Handle empty input string as per FR4.\n        if not s:\n            return []\n\n        # Split the string into words and filter out empty ones (FR2).\n        words = [word for word in s.split(' ') if word]\n        \n        result = []\n        for word in words:\n            # Count consonants and add word to result if it matches n (FR3, FR5).\n            if self.consonant_counter.count(word) == n:\n                result.append(word)\n        return result\n\n```\n```python\n# src/main.py\nfrom src.consonant_counter import ConsonantCounter\nfrom src.word_selector_service import WordSelectorService\n\n# Initialize dependencies for the public API.\n_consonant_counter = ConsonantCounter()\n_word_selector_service = WordSelectorService(consonant_counter=_consonant_counter)\n\ndef select_words(s: str, n: int) -> list[str]:\n    \"\"\"\n    Given a string s and an integer n, returns a list of words from s\n    that contain exactly n consonants, maintaining original order.\n    \"\"\"\n    return _word_selector_service.select_words(s, n)\n\nif __name__ == \"__main__\":\n    # Demonstrate the select_words function with various examples.\n    print(f\"\\\"Mary had a little lamb\\\", 4 ==> {select_words('Mary had a little lamb', 4)}\")\n    print(f\"\\\"Mary had a little lamb\\\", 3 ==> {select_words('Mary had a little lamb', 3)}\")\n    print(f\"\\\"simple white space\\\", 2 ==> {select_words('simple white space', 2)}\")\n    print(f\"\\\"Hello world\\\", 4 ==> {select_words('Hello world', 4)}\")\n    print(f\"\\\"Uncle sam\\\", 3 ==> {select_words('Uncle sam', 3)}\")\n    print(f\"\\\"\\\", 0 ==> {select_words('', 0)}\")\n    print(f\"\\\"a e i o u\\\", 0 ==> {select_words('a e i o u', 0)}\")\n    print(f\"\\\"rhythm\\\", 6 ==> {select_words('rhythm', 6)}\")\n    print(f\"\\\"Python\\\", 4 ==> {select_words('Python', 4)}\")\n    print(f\"\\\"TEST\\\", 3 ==> {select_words('TEST', 3)}\")\n    print(f\"\\\"Test\\\", 3 ==> {select_words('Test', 3)}\")\n    print(f\"\\\"word with spaces\\\", 3 ==> {select_words('word with spaces', 3)}\")\n    print(f\"\\\"  leading and trailing spaces  \\\", 4 ==> {select_words('  leading and trailing spaces  ', 4)}\")\n    print(f\"\\\"double  spaces\\\", 3 ==> {select_words('double  spaces', 3)}\")\n    print(f\"\\\"no match\\\", 10 ==> {select_words('no match', 10)}\")\n\n    # Example of error handling.\n    try:\n        select_words(123, 3)\n    except TypeError as e:\n        print(f\"Caught expected error: {e}\")\n    try:\n        select_words(\"word\", \"a\")\n    except TypeError as e:\n        print(f\"Caught expected error: {e}\")\n    try:\n        select_words(\"word\", -1)\n    except ValueError as e:\n        print(f\"Caught expected error: {e}\")\n\n```"}
{"task_id": "HumanEval/119", "solution": "```python\nclass InputValidator:\n    @staticmethod\n    def validate_input_strings(lst: list[str]) -> None:\n        \"\"\"Validates if the input is a list of two strings containing only '(' or ')'.\n        Raises ValueError for invalid input.\"\"\"\n        if not isinstance(lst, list) or len(lst) != 2:\n            raise ValueError(\"Input must be a list containing exactly two strings.\")\n        \n        for s in lst:\n            if not isinstance(s, str):\n                raise ValueError(\"All elements in the list must be strings.\")\n            for char in s:\n                if char not in ('(', ')'):\n                    raise ValueError(f\"String '{s}' contains invalid character '{char}'. Only '(' and ')' are allowed.\")\n\nclass MatchParensApp:\n    @staticmethod\n    def _is_balanced(s: str) -> bool:\n        \"\"\"Checks if a given string of parentheses is balanced.\"\"\"\n        balance = 0\n        for char in s:\n            if char == '(':\n                balance += 1\n            else:\n                balance -= 1\n            if balance < 0:\n                return False\n        return balance == 0\n\n    @staticmethod\n    def match_parens(lst: list[str]) -> str:\n        \"\"\"Determines if two strings can be concatenated to form a balanced parentheses string.\"\"\"\n        InputValidator.validate_input_strings(lst)\n\n        s1, s2 = lst[0], lst[1]\n\n        if MatchParensApp._is_balanced(s1 + s2) or MatchParensApp._is_balanced(s2 + s1):\n            return 'Yes'\n        return 'No'\n\ndef match_parens(lst):\n    '''\n    You are given a list of two strings, both strings consist of open\n    parentheses '(' or close parentheses ')' only.\n    Your job is to check if it is possible to concatenate the two strings in\n    some order, that the resulting string will be good.\n    A string S is considered to be good if and only if all parentheses in S\n    are balanced. For example: the string '(())()' is good, while the string\n    '())' is not.\n    Return 'Yes' if there's a way to make a good string, and return 'No' otherwise.\n\n    Examples:\n    match_parens(['()(', ')']) == 'Yes'\n    match_parens([')', ')']) == 'No'\n    '''\n    return MatchParensApp.match_parens(lst)\n```"}
{"task_id": "HumanEval/120", "solution": "```python\nfrom typing import List, Union\n\nclass MaximumFinder:\n    @staticmethod\n    def maximum(arr: List[Union[int, float]], k: int) -> List[Union[int, float]]:\n        \"\"\"\n        Returns a sorted list of length k with the maximum k numbers in arr.\n        Raises ValueError if k is negative.\n        \"\"\"\n        if not isinstance(k, int):\n            raise TypeError(\"k must be an integer.\")\n        if k < 0:\n            raise ValueError(\"k must be a non-negative integer.\")\n        if k == 0:\n            return []\n\n        if not isinstance(arr, list):\n            raise TypeError(\"arr must be a list.\")\n        if not all(isinstance(x, (int, float)) for x in arr):\n            raise TypeError(\"All elements in arr must be numbers (int or float).\")\n\n        sorted_arr = sorted(arr, reverse=True)\n        return sorted_arr[:k]\n```"}
