    return self._planets[start_idx + 1:end_idx]\n```\n\n```python\n# src/planet_finder/main.py\nfrom src.planet_finder.models import PLANET_ORDER\nfrom src.planet_finder.services import PlanetService\n\n_planet_service = PlanetService(PLANET_ORDER)\n\ndef bf(planet1: str, planet2: str) -> tuple[str, ...]:\n    \"\"\"\n    Returns a tuple of planets located between planet1 and planet2, sorted by proximity to the sun.\n    Returns an empty tuple if inputs are invalid or no planets are found between them.\n    \"\"\"\n    return _planet_service.find_planets_between(planet1, planet2)\n\nif __name__ == \"__main__\":\n    print(f\"bf('Jupiter', 'Neptune') ==> {bf('Jupiter', 'Neptune')}\")\n    print(f\"bf('Earth', 'Mercury') ==> {bf('Earth', 'Mercury')}\")\n    print(f\"bf('Mercury', 'Uranus') ==> {bf('Mercury', 'Uranus')}\")\n    print(f\"bf('Pluto', 'Earth') ==> {bf('Pluto', 'Earth')}\")\n    print(f\"bf('Earth', 'Earth') ==> {bf('Earth', 'Earth')}\")\n    print(f\"bf('Venus', 'Earth') ==> {bf('Venus', 'Earth')}\")\n```"}
