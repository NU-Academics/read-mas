{"task_id": "HumanEval/157", "solution": "```python\n# src/triangle_calculator/__init__.py\n# This file can be empty to signify a Python package.\n\n\n# src/triangle_calculator/exceptions.py\nclass InvalidSideError(ValueError):\n    \"\"\"Exception raised for invalid side lengths (e.g., non-positive).\"\"\"\n    pass\n\nclass InvalidTriangleError(ValueError):\n    \"\"\"Exception raised when sides cannot form a valid triangle.\"\"\"\n    pass\n\n\n# src/triangle_calculator/validators.py\nfrom .exceptions import InvalidSideError, InvalidTriangleError\n\nclass TriangleValidator:\n    \"\"\"Provides static methods to validate the properties of triangle sides.\"\"\"\n\n    @staticmethod\n    def validate_sides(a: float, b: float, c: float) -> None:\n        \"\"\"Checks if all three inputs are numbers and are positive.\"\"\"\n        if not all(isinstance(side, (int, float)) for side in [a, b, c]):\n            raise TypeError(\"All side lengths must be numbers.\")\n        if not all(side > 0 for side in [a, b, c]):\n            raise InvalidSideError(\"All side lengths must be positive.\")\n\n    @staticmethod\n    def validate_triangle_inequality(a: float, b: float, c: float) -> None:\n        \"\"\"Checks if the three sides satisfy the triangle inequality theorem.\"\"\"\n        if not (a + b > c and a + c > b and b + c > a):\n            raise InvalidTriangleError(\"The given sides cannot form a valid triangle.\")\n\n\n# src/triangle_calculator/calculators.py\nfrom typing import List\nfrom .validators import TriangleValidator\n\nclass RightAngleCalculator:\n    \"\"\"Determines if three given side lengths form a right-angled triangle.\"\"\"\n    EPSILON: float = 1e-9 # Used for floating-point comparisons to account for precision issues.\n\n    @staticmethod\n    def right_angle_triangle(a: float, b: float, c: float) -> bool:\n        \"\"\"\n        Checks if three side lengths form a right-angled triangle using the Pythagorean theorem.\n        It first validates inputs and triangle inequality.\n        \"\"\"\n        TriangleValidator.validate_sides(a, b, c)\n        TriangleValidator.validate_triangle_inequality(a, b, c)\n\n        sides: List[float] = sorted([a, b, c])\n        side1, side2, longest_side = sides[0], sides[1], sides[2]\n\n        return abs(side1**2 + side2**2 - longest_side**2) < RightAngleCalculator.EPSILON\n```"}
{"task_id": "HumanEval/157", "solution": "```python\n# src/triangle_checker/__init__.py\n\"\"\"\nInitializes the triangle_checker package.\nNo specific constants are exposed at the package level, as EPSILON is an internal attribute of TriangleChecker.\n\"\"\"\n\n# src/triangle_checker/models.py\nimport numbers\n\nclass TriangleSides:\n    \"\"\"\n    A data transfer object (DTO) to encapsulate the three side lengths of a triangle.\n    It validates that inputs are numeric upon instantiation.\n    \"\"\"\n    def __init__(self, a: float, b: float, c: float):\n        # Validate that all inputs are numeric types.\n        if not all(isinstance(side, numbers.Number) for side in [a, b, c]):\n            raise TypeError(\"Side lengths must be numeric.\")\n        self.a = float(a)\n        self.b = float(b)\n        self.c = float(c)\n\n    def get_sides(self) -> tuple[float, float, float]:\n        \"\"\"Returns the three side lengths as a tuple.\"\"\"\n        return self.a, self.b, self.c\n\n\n# src/triangle_checker/checker.py\nimport math\nfrom .models import TriangleSides\n\nclass TriangleChecker:\n    \"\"\"\n    Provides the core business logic to determine if a TriangleSides object represents a right-angled triangle.\n    It handles input validation for positivity and triangle inequality.\n    \"\"\"\n    _EPSILON: float = 1e-9\n\n    def __init__(self):\n        \"\"\"Initializes the TriangleChecker with a default epsilon value for float comparisons.\"\"\"\n        pass\n\n    def _is_valid_triangle(self, a: float, b: float, c: float) -> bool:\n        \"\"\"\n        Internal helper to validate if the three sides can form any valid triangle.\n        Checks for positive lengths and satisfies the triangle inequality theorem.\n        \"\"\"\n        if not (a > 0 and b > 0 and c > 0):\n            raise ValueError(\"Side lengths must be positive.\")\n        # Apply the Triangle Inequality Theorem.\n        if not (a + b > c and a + c > b and b + c > a):\n            return False\n        return True\n\n    def _is_pythagorean_triple(self, s1: float, s2: float, hypotenuse: float) -> bool:\n        \"\"\"\n        Internal helper to check if s1^2 + s2^2 is approximately equal to hypotenuse^2.\n        It uses math.isclose for robust floating-point comparison.\n        \"\"\"\n        return math.isclose(s1**2 + s2**2, hypotenuse**2, rel_tol=self._EPSILON)\n\n    def is_right_angle_triangle(self, sides: TriangleSides) -> bool:\n        \"\"\"\n        Determines if the given TriangleSides form a right-angled triangle.\n        It validates inputs and applies the Pythagorean theorem considering all permutations.\n        \"\"\"\n        a, b, c = sides.get_sides()\n\n        if not self._is_valid_triangle(a, b, c):\n            return False\n\n        # Check all permutations for the hypotenuse using the Pythagorean theorem.\n        if (self._is_pythagorean_triple(a, b, c) or\n                self._is_pythagorean_triple(a, c, b) or\n                self._is_pythagorean_triple(b, c, a)):\n            return True\n        return False\n\ndef right_angle_triangle(a: float, b: float, c: float) -> bool:\n    \"\"\"\n    Given the lengths of the three sides of a triangle, return True if they form a right-angled triangle.\n    This is a convenience function that wraps the TriangleChecker class for direct usage.\n    \"\"\"\n    checker = TriangleChecker()\n    sides = TriangleSides(a, b, c)\n    return checker.is_right_angle_triangle(sides)\n\n\n# pyproject.toml\n\"\"\"\n[project]\nname = \"triangle-checker\"\nversion = \"0.1.0\"\ndescription = \"A utility to determine if three side lengths form a right-angled triangle.\"\nauthors = [{ name = \"Your Name\", email = \"your.email@example.com\" }]\nreadme = \"README.md\"\nrequires-python = \">=3.8\"\n\n[build-system]\nrequires = [\"setuptools>=61.0\"]\nbuild-backend = \"setuptools.build_meta\"\n\"\"\"\n\n# README.md\n\"\"\"\n# Triangle Checker\n\nThis project provides a Python library to determine if three given side lengths can form a right-angled triangle.\nIt includes robust input validation and uses the Pythagorean theorem for accurate checks.\n\n## Installation\n\nTo install the package, navigate to the project root and run:\n\n```bash\npip install .\n```\n\nFor development, you can install it in editable mode:\n\n```bash\npip install -e .\n```\n\n## Usage\n\nYou can use the `right_angle_triangle` function directly or instantiate the `TriangleChecker` class.\n\n### Example 1: Using the convenience function\n\n```python\nfrom src.triangle_checker.checker import right_angle_triangle\n\n# Check a valid right-angled triangle\nis_right = right_angle_triangle(3, 4, 5)\nprint(f\"Is (3, 4, 5) a right-angled triangle? {is_right}\") # Output: True\n\n# Check an invalid triangle (not right-angled)\nis_right = right_angle_triangle(2, 3, 4)\nprint(f\"Is (2, 3, 4) a right-angled triangle? {is_right}\") # Output: False\n\n# Check for non-positive sides (will raise ValueError)\ntry:\n    right_angle_triangle(-3, 4, 5)\nexcept ValueError as e:\n    print(f\"Error: {e}\") # Output: Error: Side lengths must be positive.\n\n# Check for non-numeric inputs (will raise TypeError)\ntry:\n    right_angle_triangle(\"a\", 4, 5)\nexcept TypeError as e:\n    print(f\"Error: {e}\") # Output: Error: Side lengths must be numeric.\n```\n\n### Example 2: Using the TriangleChecker class\n\n```python\nfrom src.triangle_checker.checker import TriangleChecker\nfrom src.triangle_checker.models import TriangleSides\n\nchecker = TriangleChecker()\n\n# Create a TriangleSides object\nsides = TriangleSides(5, 12, 13)\nis_right = checker.is_right_angle_triangle(sides)\nprint(f\"Is (5, 12, 13) a right-angled triangle? {is_right}\") # Output: True\n\n# Check a triangle that violates the triangle inequality\nsides_invalid = TriangleSides(1, 2, 10)\nis_right = checker.is_right_angle_triangle(sides_invalid)\nprint(f\"Is (1, 2, 10) a right-angled triangle? {is_right}\") # Output: False\n```\n\"\"\"\n```"}
{"task_id": "HumanEval/158", "solution": "```python\nfrom typing import List\n\nclass UniqueCharCounter:\n    \"\"\"\n    Provides a utility method to count the number of unique characters within a single string.\n    \"\"\"\n    @staticmethod\n    def count_unique_chars(s: str) -> int:\n        \"\"\"\n        Calculates and returns the number of unique characters in the given string.\n        \"\"\"\n        return len(set(s))\n\ndef find_max(words: List[str]) -> str:\n    \"\"\"Write a function that accepts a list of strings.\n    The list contains different words. Return the word with maximum number\n    of unique characters. If multiple strings have maximum number of unique\n    characters, return the one which comes first in lexicographical order.\n\n    find_max([\"name\", \"of\", \"string\"]) == \"string\"\n    find_max([\"name\", \"enam\", \"game\"]) == \"enam\"\n    find_max([\"aaaaaaa\", \"bb\" ,\"cc\"]) == \"\"aaaaaaa\"\n    \"\"\"\n    if not words:\n        return \"\"\n\n    max_unique_count = -1\n    result_word = \"\"\n\n    for word in words:\n        current_unique_count = UniqueCharCounter.count_unique_chars(word)\n\n        if current_unique_count > max_unique_count:\n            max_unique_count = current_unique_count\n            result_word = word\n        elif current_unique_count == max_unique_count:\n            # Apply lexicographical tie-breaking rule.\n            # The check `result_word == \"\"` is for the very first word in a tie,\n            # ensuring it gets assigned if it's the first with max_unique_count.\n            # Otherwise, use lexicographical comparison.\n            if result_word == \"\" or word < result_word:\n                result_word = word\n    return result_word\n```\n"}
{"task_id": "HumanEval/158", "solution": "```python\n# src/word_analyzer/analyzer.py\nclass WordAnalyzer:\n    @staticmethod\n    def find_max(words: list[str]) -> str:\n        \"\"\"\n        Returns the word with the maximum unique characters, applying lexicographical tie-breaking.\n        Returns an empty string if the input list is empty.\n        \"\"\"\n        if not words:\n            return \"\"\n\n        max_unique_count = -1\n        result_word = \"\"\n\n        for word in words:\n            current_unique_count = len(set(word))\n\n            if current_unique_count > max_unique_count:\n                max_unique_count = current_unique_count\n                result_word = word\n            elif current_unique_count == max_unique_count:\n                # Apply tie-breaking: select lexicographically smaller word.\n                if result_word == \"\" or word < result_word:\n                    result_word = word\n        return result_word\n\n```\n```python\n# src/word_analyzer/__init__.py\n# Initializes the word_analyzer package.\n```"}
{"task_id": "HumanEval/147", "solution": "```python\nfrom collections import Counter\n\nclass TriplesCalculator:\n    \"\"\"\n    Encapsulates logic for generating arrays and efficiently counting valid triples.\n    Uses a cache to store generated arrays for improved performance on repeated calls.\n    \"\"\"\n    def __init__(self):\n        self._array_cache = {}\n\n    def calculate_triples(self, n: int) -> int:\n        \"\"\"\n        Orchestrates array generation and counts triples whose sum is a multiple of 3.\n        Raises ValueError if n is not a positive integer.\n        \"\"\"\n        if not isinstance(n, int) or n <= 0:\n            raise ValueError(\"Input 'n' must be a positive integer.\")\n        \n        if n < 3:\n            return 0 # Not enough elements to form a triple\n\n        arr = self._array_cache.get(n)\n        if arr is None:\n            arr = self._generate_array(n)\n            self._array_cache[n] = arr\n        \n        return self._count_valid_triples(arr)\n\n    def _generate_array(self, n: int) -> list[int]:\n        \"\"\"\n        Generates the array a where a[i] = i * i - i + 1 for i from 1 to n.\n        This operation is O(n).\n        \"\"\"\n        return [i * i - i + 1 for i in range(1, n + 1)]\n\n    def _get_remainder_counts(self, arr: list[int]) -> dict[int, int]:\n        \"\"\"\n        Calculates the frequency of elements based on their remainder when divided by 3.\n        This provides O(n) performance for initial categorization.\n        \"\"\"\n        remainder_counts = Counter(x % 3 for x in arr)\n        return {0: remainder_counts.get(0, 0),\n                1: remainder_counts.get(1, 0),\n                2: remainder_counts.get(2, 0)}\n\n    def _count_valid_triples(self, arr: list[int]) -> int:\n        \"\"\"\n        Counts triples (a[i], a[j], a[k]) with i < j < k such that their sum is a multiple of 3.\n        This method uses modular arithmetic for efficient O(1) counting after initial remainder categorization.\n        \"\"\"\n        counts = self._get_remainder_counts(arr)\n        c0, c1, c2 = counts[0], counts[1], counts[2]\n        \n        total_triples = 0\n        \n        # Case 1: (0, 0, 0) - all elements are multiples of 3 (sum % 3 == 0)\n        total_triples += c0 * (c0 - 1) * (c0 - 2) // 6\n        \n        # Case 2: (1, 1, 1) - all elements have remainder 1 (sum % 3 == 0)\n        total_triples += c1 * (c1 - 1) * (c1 - 2) // 6\n        \n        # Case 3: (2, 2, 2) - all elements have remainder 2 (sum % 3 == 6 % 3 == 0)\n        total_triples += c2 * (c2 - 1) * (c2 - 2) // 6\n        \n        # Case 4: (0, 1, 2) - one of each remainder (sum % 3 == (0+1+2) % 3 == 0)\n        total_triples += c0 * c1 * c2\n        \n        return total_triples\n\nclass TriplesService:\n    \"\"\"\n    Provides the public interface for calculating the number of valid triples.\n    Delegates the core computational logic to an instance of TriplesCalculator.\n    \"\"\"\n    def __init__(self):\n        self._calculator = TriplesCalculator()\n\n    def get_max_triples(self, n: int) -> int:\n        \"\"\"\n        Calculates and returns the count of valid triples for a given positive integer n.\n        Propagates ValueError from TriplesCalculator if n is invalid.\n        \"\"\"\n        return self._calculator.calculate_triples(n)\n\n\n# Instantiate the service globally or pass it if this function is called repeatedly\n_triples_service = TriplesService()\n\ndef get_max_triples(n):\n    \"\"\"\n    You are given a positive integer n. You have to create an integer array a of length n.\n        For each i (1 \u2264 i \u2264 n), the value of a[i] = i * i - i + 1.\n        Return the number of triples (a[i], a[j], a[k]) of a where i < j < k, \n    and a[i] + a[j] + a[k] is a multiple of 3.\n\n    Example :\n        Input: n = 5\n        Output: 1\n        Explanation: \n        a = [1, 3, 7, 13, 21]\n        The only valid triple is (1, 7, 13).\n    \"\"\"\n    return _triples_service.get_max_triples(n)\n\n```"}
{"task_id": "HumanEval/159", "solution": "```python\n# src/rabbit_eats/__init__.py\n# Empty file to mark rabbit_eats as a Python package.\n\n\n```\n\n```python\n# src/rabbit_eats/models.py\nclass CarrotMealResult:\n    \"\"\"Represents the outcome of a rabbit's carrot meal.\n    Stores the total eaten and carrots remaining.\"\"\"\n    def __init__(self, total_eaten: int, carrots_left: int):\n        if not isinstance(total_eaten, int) or not isinstance(carrots_left, int):\n            raise TypeError(\"total_eaten and carrots_left must be integers.\")\n        if total_eaten < 0 or carrots_left < 0:\n            raise ValueError(\"total_eaten and carrots_left cannot be negative.\")\n        self.total_eaten = total_eaten\n        self.carrots_left = carrots_left\n\n    def __repr__(self) -> str:\n        return f\"CarrotMealResult(total_eaten={self.total_eaten}, carrots_left={self.carrots_left})\"\n\n```\n\n```python\n# src/rabbit_eats/services.py\nfrom .models import CarrotMealResult\n\nclass RabbitService:\n    \"\"\"Provides the core business logic for calculating carrot consumption.\"\"\"\n    def calculate_meal(self, number: int, need: int, remaining: int) -> CarrotMealResult:\n        \"\"\"Calculates total carrots eaten and carrots left after a meal.\n        It respects the rabbit's need and available stock.\"\"\"\n        carrots_eaten_in_meal = min(need, remaining)\n        total_eaten = number + carrots_eaten_in_meal\n        carrots_left = remaining - carrots_eaten_in_meal\n        return CarrotMealResult(total_eaten=total_eaten, carrots_left=carrots_left)\n\n```\n\n```python\n# src/rabbit_eats/api.py\nfrom typing import List\nfrom .services import RabbitService\n\nMIN_CARROTS = 0\nMAX_CARROTS = 1000\n\ndef eat(number: int, need: int, remaining: int) -> List[int]:\n    \"\"\"Calculates total carrots eaten by a rabbit and carrots left in stock.\n    It validates inputs and delegates calculation to the RabbitService.\"\"\"\n    _validate_inputs(number, need, remaining)\n    \n    rabbit_service = RabbitService()\n    result = rabbit_service.calculate_meal(number, need, remaining)\n    \n    return [result.total_eaten, result.carrots_left]\n\ndef _validate_inputs(number: int, need: int, remaining: int) -> None:\n    \"\"\"Validates the input parameters for the eat function.\n    Raises ValueError if inputs are not valid integers or outside the specified range.\"\"\"\n    for param_name, value in [(\"number\", number), (\"need\", need), (\"remaining\", remaining)]:\n        if not isinstance(value, int):\n            raise ValueError(f\"Parameter '{param_name}' must be an integer.\")\n        if not (MIN_CARROTS <= value <= MAX_CARROTS):\n            raise ValueError(f\"Parameter '{param_name}' must be between {MIN_CARROTS} and {MAX_CARROTS}.\")\n\n```\n\n```toml\n# pyproject.toml\n[project]\nname = \"rabbit-eats\"\nversion = \"0.1.0\"\nauthors = [\n  { name=\"Your Name\", email=\"your.email@example.com\" },\n]\ndescription = \"A system to calculate carrot consumption for a rabbit.\"\nreadme = \"README.md\"\nrequires-python = \">=3.8\"\nkeywords = [\"rabbit\", \"carrots\", \"stock management\"]\nclassifiers = [\n    \"Programming Language :: Python :: 3\",\n    \"License :: OSI Approved :: MIT License\",\n    \"Operating System :: OS Independent\",\n]\n\n[project.urls]\n\"Homepage\" = \"https://github.com/your-username/rabbit-eats\"\n\"Bug Tracker\" = \"https://github.com/your-username/rabbit-eats/issues\"\n\n[build-system]\nrequires = [\"setuptools>=61.0\"]\nbuild-backend = \"setuptools.build_meta\"\n\n[tool.setuptools.packages.find]\nwhere = [\"src\"] # Search for packages in \"src\"\n\n```\n\n```markdown\n# README.md\n# Rabbit Eats\n\nA Python utility to calculate a rabbit's carrot consumption and remaining stock.\n\n## Overview\n\nThis system helps rabbit owners manage their carrot stock by calculating how many carrots a rabbit has eaten in total and how many are left after a meal. It handles scenarios where the available carrots might be insufficient to meet the rabbit's hunger.\n\n## Installation\n\n```bash\n# Clone the repository\ngit clone https://github.com/your-username/rabbit-eats.git\ncd rabbit-eats\n\n# Install in editable mode\npip install -e .\n```\n\n## Usage\n\nThe system exposes a single function `eat` as its primary interface.\n\n```python\nfrom rabbit_eats.api import eat\n\n# Scenario 1: Rabbit has eaten 10, needs 5, 20 remaining\ntotal_eaten, carrots_left = eat(number=10, need=5, remaining=20)\nprint(f\"Total eaten: {total_eaten}, Carrots left: {carrots_left}\")\n# Expected output: Total eaten: 15, Carrots left: 15\n\n# Scenario 2: Rabbit has eaten 5, needs 10, only 3 remaining\ntotal_eaten, carrots_left = eat(number=5, need=10, remaining=3)\nprint(f\"Total eaten: {total_eaten}, Carrots left: {carrots_left}\")\n# Expected output: Total eaten: 8, Carrots left: 0\n\n# Scenario 3: Invalid input (example: out of range)\ntry:\n    eat(number=10, need=5, remaining=1001)\nexcept ValueError as e:\n    print(f\"Error: {e}\")\n# Expected output: Error: Parameter 'remaining' must be between 0 and 1000.\n```\n\n## Development\n\nThe project is structured into `api`, `services`, and `models` layers for clear separation of concerns.\n\n## Testing\n\n(Note: Unit tests are not included in the generated code as per critical test requirements.)\n\n## License\n\nThis project is licensed under the MIT License.\n```"}
{"task_id": "HumanEval/159", "solution": "def eat(number, need, remaining):\n    \"\"\"\n    You're a hungry rabbit, and you already have eaten a certain number of carrots,\n    but now you need to eat more carrots to complete the day's meals.\n    you should return an array of [ total number of eaten carrots after your meals,\n                                    the number of carrots left after your meals ]\n    if there are not enough remaining carrots, you will eat all remaining carrots, but will still be hungry.\n    \n    Example:\n    * eat(5, 6, 10) -> [11, 4]\n    * eat(4, 8, 9) -> [12, 1]\n    * eat(1, 10, 10) -> [11, 0]\n    * eat(2, 11, 5) -> [7, 0]\n    \n    Variables:\n    @number : integer\n        the number of carrots that you have eaten.\n    @need : integer\n        the number of carrots that you need to eat.\n    @remaining : integer\n        the number of remaining carrots thet exist in stock\n    \n    Constrain:\n    * 0 <= number <= 1000\n    * 0 <= need <= 1000\n    * 0 <= remaining <= 1000\n\n    Have fun :)\n    \"\"\"\n    from dataclasses import dataclass\n\n    @dataclass(frozen=True)\n    class CarrotMealResult:\n        \"\"\"\n        Represents the outcome of a rabbit's meal.\n        It includes total carrots eaten and remaining in stock.\n        \"\"\"\n        total_eaten: int\n        remaining_stock: int\n\n    class InputValidator:\n        \"\"\"\n        Validates input parameters for the carrot eating simulation.\n        It ensures all carrot counts are within specified non-negative bounds.\n        \"\"\"\n        MIN_CARROTS: int = 0\n        MAX_CARROTS: int = 1000\n\n        def validate_carrot_inputs(self, number: int, need: int, remaining: int) -> None:\n            \"\"\"\n            Validates if number, need, and remaining are within [0, 1000].\n            Raises ValueError if any input is out of bounds.\n            \"\"\"\n            if not (self.MIN_CARROTS <= number <= self.MAX_CARROTS):\n                raise ValueError(f\"Number of eaten carrots ({number}) must be between {self.MIN_CARROTS} and {self.MAX_CARROTS}.\")\n            if not (self.MIN_CARROTS <= need <= self.MAX_CARROTS):\n                raise ValueError(f\"Number of carrots needed ({need}) must be between {self.MIN_CARROTS} and {self.MAX_CARROTS}.\")\n            if not (self.MIN_CARROTS <= remaining <= self.MAX_CARROTS):\n                raise ValueError(f\"Number of remaining carrots ({remaining}) must be between {self.MIN_CARROTS} and {self.MAX_CARROTS}.\")\n\n    class CarrotEatingService:\n        \"\"\"\n        Provides business logic for the rabbit's carrot eating simulation.\n        It calculates total eaten carrots and remaining stock based on input.\n        \"\"\"\n        def __init__(self, validator: InputValidator) -> None:\n            self._validator = validator\n\n        def eat(self, number: int, need: int, remaining: int) -> CarrotMealResult:\n            \"\"\"\n            Simulates carrot eating, calculates total eaten and remaining stock.\n            It first validates inputs and then applies business rules.\n            \"\"\"\n            self._validator.validate_carrot_inputs(number, need, remaining)\n\n            carrots_eaten_in_meal: int\n            remaining_after_meal: int\n\n            if need <= remaining:\n                carrots_eaten_in_meal = need\n                remaining_after_meal = remaining - need\n            else: # need > remaining\n                carrots_eaten_in_meal = remaining\n                remaining_after_meal = 0\n\n            total_eaten = number + carrots_eaten_in_meal\n            return CarrotMealResult(total_eaten=total_eaten, remaining_stock=remaining_after_meal)\n\n    validator = InputValidator()\n    service = CarrotEatingService(validator)\n    result = service.eat(number, need, remaining)\n    return [result.total_eaten, result.remaining_stock]\n\n```"}
{"task_id": "HumanEval/160", "solution": "```python\n# src/utils.py\nfrom typing import List\n\nclass InputValidator:\n    \"\"\"\n    Utility class for validating input lists for algebraic expression evaluation.\n    It ensures the provided operators and operands adhere to specified rules.\n    \"\"\"\n    VALID_OPERATORS = {'+', '-', '*', '//', '**'}\n\n    @staticmethod\n    def validate_algebra_inputs(operators: List[str], operands: List[int]) -> None:\n        \"\"\"\n        Validates the operator and operand lists for type, length, and content.\n        Raises ValueError if any validation rule is violated.\n        \"\"\"\n        if not isinstance(operators, list) or not all(isinstance(op, str) for op in operators):\n            raise ValueError(\"Operators must be a list of strings.\")\n        if not isinstance(operands, list) or not all(isinstance(op, int) for op in operands):\n            raise ValueError(\"Operands must be a list of integers.\")\n\n        if not operators:\n            raise ValueError(\"Operator list must contain at least one operator.\")\n        if len(operands) < 2:\n            raise ValueError(\"Operand list must contain at least two operands.\")\n\n        if len(operators) != len(operands) - 1:\n            raise ValueError(f\"Length of operator list ({len(operators)}) must be one less than operand list ({len(operands)}).\")\n\n        for op in operators:\n            if op not in InputValidator.VALID_OPERATORS:\n                raise ValueError(f\"Invalid operator '{op}'. Allowed operators are: {', '.join(InputValidator.VALID_OPERATORS)}\")\n\n        for operand in operands:\n            if operand < 0:\n                raise ValueError(f\"Operand '{operand}' must be a non-negative integer.\")\n\n```\n```python\n# src/expression_evaluator.py\nfrom typing import List\n# Assuming src/utils.py is available for import in the same package context\nfrom src.utils import InputValidator\n\nclass ExpressionEvaluator:\n    \"\"\"\n    Evaluates an algebraic expression from given operators and operands.\n    It constructs the expression string and uses eval() for computation.\n    \"\"\"\n    def __init__(self, operators: List[str], operands: List[int]):\n        \"\"\"\n        Initializes the ExpressionEvaluator with validated operator and operand lists.\n        These lists will be used to form and evaluate an algebraic expression.\n        \"\"\"\n        self._operators = operators\n        self._operands = operands\n\n    def _build_expression_string(self) -> str:\n        \"\"\"\n        Constructs the algebraic expression as a string by interleaving operands and operators.\n        Example: [2, 3, 4, 5], ['+', '*', '-'] -> \"2 + 3 * 4 - 5\".\n        \"\"\"\n        expression_parts = []\n        for i in range(len(self._operands)):\n            expression_parts.append(str(self._operands[i]))\n            if i < len(self._operators):\n                expression_parts.append(self._operators[i])\n        return \" \".join(expression_parts)\n\n    def evaluate(self) -> int:\n        \"\"\"\n        Evaluates the constructed algebraic expression string.\n        It safely uses Python's eval() due to prior strict input validation.\n        \"\"\"\n        expression_string = self._build_expression_string()\n        return eval(expression_string)\n\ndef do_algebra(operator: List[str], operand: List[int]) -> int:\n    \"\"\"\n    Given lists of operators and operands, this function builds and evaluates an algebraic expression.\n    It returns the integer result after performing validation and computation.\n    \"\"\"\n    InputValidator.validate_algebra_inputs(operator, operand)\n    evaluator = ExpressionEvaluator(operator, operand)\n    return evaluator.evaluate()\n\n```"}
