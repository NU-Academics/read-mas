{"task_id": "HumanEval/75", "solution": "```python\ndef is_multiply_prime(a):\n    \"\"\"Write a function that returns true if the given number is the multiplication of 3 prime numbers\n    and false otherwise.\n    Knowing that (a) is less then 100. \n    Example:\n    is_multiply_prime(30) == True\n    30 = 2 * 3 * 5\n    \"\"\"\n    if a < 1:\n        return False\n\n    # Generate primes up to 'a' using a sieve.\n    # Since a < 100, generating primes up to 'a' is efficient enough for each call.\n    # For a = 99, we need primes up to 99.\n    limit = a\n    sieve = [True] * (limit + 1)\n    \n    # 0 and 1 are not prime numbers.\n    if limit >= 0:\n        sieve[0] = False\n    if limit >= 1:\n        sieve[1] = False\n            \n    # Apply the Sieve of Eratosthenes to mark non-primes.\n    for p in range(2, int(limit**0.5) + 1):\n        if sieve[p]:\n            for multiple in range(p * p, limit + 1, p):\n                sieve[multiple] = False\n    \n    primes = [i for i, is_p in enumerate(sieve) if is_p]\n\n    distinct_prime_factors = set()\n    temp_a = a\n\n    # Factorize 'a' by iterating through the list of primes.\n    for p in primes:\n        # Optimization: If p*p*p is already greater than the remaining temp_a,\n        # it's impossible for temp_a to have three distinct prime factors starting from p.\n        # This optimization is valid for checking distinct prime factors.\n        if p * p * p > temp_a and len(distinct_prime_factors) < 3:\n            break\n        \n        if temp_a % p == 0:\n            distinct_prime_factors.add(p)\n            # Remove all occurrences of p from temp_a.\n            while temp_a % p == 0:\n                temp_a //= p\n    \n    # If temp_a is still greater than 1 after dividing by all primes,\n    # the remaining temp_a must be a prime factor itself.\n    if temp_a > 1:\n        distinct_prime_factors.add(temp_a)\n\n    # Check if exactly three distinct prime factors were found.\n    return len(distinct_prime_factors) == 3\n\n```\n"}
{"task_id": "HumanEval/75", "solution": "```python\nfrom typing import List\n\nclass InvalidInputError(ValueError):\n    \"\"\"Custom exception for invalid input values.\n    This inherits from ValueError to signify an issue with the input's value or type.\n    \"\"\"\n    pass\n\nclass PrimeUtils:\n    \"\"\"Utility class for prime number operations, including primality testing and factorization.\"\"\"\n\n    _primes_cache: List[int] = []\n    _max_cached_prime: int = 100  # Cache primes up to 100, aligning with problem constraints.\n    MAX_NUMBER_CHECK: int = 100\n\n    @classmethod\n    def _sieve_of_eratosthenes(cls, limit: int) -> None:\n        \"\"\"Generates primes up to 'limit' using Sieve of Eratosthenes and caches them.\"\"\"\n        if limit <= 1:\n            cls._primes_cache = []\n            return\n\n        is_prime_list = [True] * (limit + 1)\n        is_prime_list[0] = is_prime_list[1] = False\n\n        for p in range(2, int(limit**0.5) + 1):\n            if is_prime_list[p]:\n                for multiple in range(p * p, limit + 1, p):\n                    is_prime_list[multiple] = False\n\n        cls._primes_cache = [p for p, is_p in enumerate(is_prime_list) if is_p]\n        cls._max_cached_prime = limit\n\n    @classmethod\n    def is_prime(cls, n: int) -> bool:\n        \"\"\"Determines if a given integer 'n' is a prime number.\"\"\"\n        if not isinstance(n, int):\n            raise TypeError(\"Input must be an integer.\")\n        if n <= 1:\n            return False\n        \n        # Ensure cache is populated up to n if it hasn't been already.\n        if n > cls._max_cached_prime:\n            cls._sieve_of_eratosthenes(n)\n        elif not cls._primes_cache: # If cache is empty but limit is set, fill it.\n            cls._sieve_of_eratosthenes(cls._max_cached_prime)\n\n        return n in cls._primes_cache\n\n    @classmethod\n    def get_prime_factors(cls, n: int) -> List[int]:\n        \"\"\"Returns a list of prime factors for a given integer, including multiplicity.\"\"\"\n        if not isinstance(n, int):\n            raise TypeError(\"Input must be an integer.\")\n        if n <= 1:\n            return []\n\n        factors = []\n        temp_n = n\n\n        # Ensure primes cache is populated up to sqrt(n) for efficient trial division.\n        # Given n < 100, sqrt(n) < 10.\n        if not cls._primes_cache or int(n**0.5) + 1 > cls._max_cached_prime:\n            cls._sieve_of_eratosthenes(max(cls._max_cached_prime, int(n**0.5) + 1))\n\n        for prime in cls._primes_cache:\n            if prime * prime > temp_n:\n                break\n            while temp_n % prime == 0:\n                factors.append(prime)\n                temp_n //= prime\n        \n        if temp_n > 1: # Remaining temp_n is a prime factor itself.\n            factors.append(temp_n)\n            \n        return factors\n\n# Pre-populate the cache up to MAX_NUMBER_CHECK on module load for efficiency.\nPrimeUtils._sieve_of_eratosthenes(PrimeUtils.MAX_NUMBER_CHECK)\n\n\nclass MultiplyPrimeChecker:\n    \"\"\"Core logic for checking if a number is a product of exactly three prime numbers.\"\"\"\n\n    @staticmethod\n    def is_multiply_prime(a: int) -> bool:\n        \"\"\"\n        Checks if the given number 'a' is the product of exactly three prime numbers.\n        It first validates input, then finds prime factors to count them.\n        \"\"\"\n        if not isinstance(a, int):\n            raise InvalidInputError(\"Input 'a' must be an integer.\")\n        if not (0 < a < 100):\n            raise InvalidInputError(\"Input 'a' must be greater than 0 and less than 100.\")\n\n        prime_factors = PrimeUtils.get_prime_factors(a)\n        return len(prime_factors) == 3\n\ndef is_multiply_prime(a):\n    \"\"\"Write a function that returns true if the given number is the multiplication of 3 prime numbers\n    and false otherwise.\n    Knowing that (a) is less then 100. \n    Example:\n    is_multiply_prime(30) == True\n    30 = 2 * 3 * 5\n    \"\"\"\n    return MultiplyPrimeChecker.is_multiply_prime(a)\n\n```"}
{"task_id": "HumanEval/77", "solution": "def iscube(a: int) -> bool:\n    '''\n    Write a function that takes an integer a and returns True \n    if this ingeger is a cube of some integer number.\n    Note: you may assume the input is always valid.\n    Examples:\n    iscube(1) ==> True\n    iscube(2) ==> False\n    iscube(-1) ==> True\n    iscube(64) ==> True\n    iscube(0) ==> True\n    iscube(180) ==> False\n    '''\n    if a == 0:\n        return True\n\n    sign = 1 if a > 0 else -1\n    abs_a = abs(a)\n\n    # Calculate the cube root using float power, then round to the nearest integer.\n    # This approach ensures accuracy for perfect cubes by comparing the final integer cube.\n    root_candidate = round(abs_a**(1/3))\n\n    # Check if the cube of the candidate, with the original sign, matches 'a'.\n    return sign * (root_candidate**3) == a"}
{"task_id": "HumanEval/76", "solution": "```\nsrc/power_checker/__init__.py\n# This file marks the power_checker directory as a Python package.\n# It can be left empty or include package-level initialization.\n\nsrc/power_checker/checker.py\nimport math\nfrom .exceptions import InvalidInputError\n\nclass PowerChecker:\n    \"\"\"Provides functionality to check if a number x is a simple power of n.\n    This class is stateless and offers a static method for the core logic.\"\"\"\n\n    @staticmethod\n    def is_simple_power(x: int, n: int) -> bool:\n        \"\"\"Checks if a number x is a simple power of n, i.e., n**k = x for some integer k.\n        Handles input validation, special cases, and floating-point precision for log calculations.\"\"\"\n        if not isinstance(x, int) or not isinstance(n, int):\n            raise InvalidInputError(\"Inputs x and n must be integers.\")\n        if x <= 0 or n <= 0:\n            raise InvalidInputError(\"Inputs x and n must be positive integers.\")\n\n        if x == 1: # x = n^0 for any n > 0.\n            return True\n\n        if n == 1: # If n is 1, x must be 1 for n^k = x to hold. We already handled x=1.\n            return False\n\n        # Calculate k = log_n(x) = log(x) / log(n)\n        # We know x > 1 and n > 1 here.\n        try:\n            k = math.log(x) / math.log(n)\n        except ValueError: # This should theoretically not happen with positive x, n\n            return False\n\n        # Check if k is an integer within a small tolerance.\n        # Verify the result by checking if n^round(k) precisely equals x.\n        tolerance = 1e-9\n        if abs(k - round(k)) < tolerance:\n            # Use integer exponentiation for final verification to avoid float inaccuracies.\n            return n**round(k) == x\n        return False\n\nsrc/power_checker/exceptions.py\nclass InvalidInputError(Exception):\n    \"\"\"Custom exception for invalid input parameters.\n    This exception signals that provided arguments do not meet function requirements.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\n\nsrc/py.typed\n\npyproject.toml\n[project]\nname = \"power_checker\"\nversion = \"0.1.0\"\ndescription = \"A utility to check if a number is a simple power of another number.\"\nauthors = [{ name = \"Your Name\", email = \"your.email@example.com\" }]\nreadme = \"README.md\"\nrequires-python = \">=3.8\"\ndependencies = []\n\n[build-system]\nrequires = [\"setuptools>=61.0\"]\nbuild-backend = \"setuptools.build_meta\"\n\n[tool.setuptools.packages.find]\nwhere = [\"src\"]\n\n[tool.setuptools.package-data]\n\"power_checker\" = [\"py.typed\"]\n\nREADME.md\n# Power Checker\n\nA Python utility for efficiently determining if a number `x` is a simple power of another number `n`.\n\n## Installation\n\n```bash\npip install .\n```\n\n## Usage\n\n```python\nfrom power_checker.checker import PowerChecker\nfrom power_checker.exceptions import InvalidInputError\n\ntry:\n    # Check if 8 is a power of 2\n    print(f\"Is 8 a simple power of 2? {PowerChecker.is_simple_power(8, 2)}\") # Expected: True\n    \n    # Check if 9 is a power of 2\n    print(f\"Is 9 a simple power of 2? {PowerChecker.is_simple_power(9, 2)}\") # Expected: False\n\n    # Check edge case: 1 is a power of any positive n (n^0 = 1)\n    print(f\"Is 1 a simple power of 100? {PowerChecker.is_simple_power(1, 100)}\") # Expected: True\n\n    # Check invalid input\n    PowerChecker.is_simple_power(0, 5)\nexcept InvalidInputError as e:\n    print(f\"Error: {e.message}\") # Expected: Error: Inputs x and n must be positive integers.\n\n```\n\n.gitignore\n# Python\n__pycache__/\n*.pyc\n*.pyo\n*.pyd\n.Python\nenv/\nvenv/\n*.egg-info/\n.pytest_cache/\n.coverage\nhtmlcov/\ndist/\nbuild/\n*.whl\n```"}
{"task_id": "HumanEval/76", "solution": "```python\ndef is_simple_power(x: int, n: int) -> bool:\n    \"\"\"Checks if x is a simple power of n (n**k = x for integer k).\n    Raises TypeError if x or n are not integers.\n    \"\"\"\n    if not isinstance(x, int) or not isinstance(n, int):\n        raise TypeError(\"Inputs x and n must be integers.\")\n\n    if n == 0:\n        return x == 0 or x == 1 # Handles 0^0=1 and 0^k=0 for k>0.\n\n    if x == 0:\n        return False # If n is not 0, n**k cannot be 0 for integer k.\n\n    if x == 1:\n        return True # Any n (not 0) to the power of 0 is 1.\n\n    if n == 1:\n        return x == 1 # 1^k is always 1; so x must be 1.\n\n    if n == -1:\n        return x == 1 or x == -1 # (-1)^k is 1 for even k, -1 for odd k.\n\n    if x < 0 and n > 0:\n        return False # A positive base cannot produce a negative result.\n\n    # Iterate powers for general cases, avoiding floating point issues.\n    current_power = n\n    while True:\n        if current_power == x:\n            return True\n        \n        # Stop if magnitude exceeds x, preventing infinite loops or going past x.\n        if abs(current_power) > abs(x):\n            return False\n\n        current_power *= n\n\n```"}
{"task_id": "HumanEval/78", "solution": "```python\n# src/hex_key_counter/__init__.py\n# This file marks the directory as a Python package.\n\n# src/hex_key_counter/constants.py\n# Defines constants used across the package.\nPRIME_HEX_DECIMAL_VALUES = {2, 3, 5, 7, 11, 13}\n\n# src/hex_key_counter/utils.py\n# Provides utility functions for hexadecimal digit conversion and primality checks.\nclass HexDigitConverter:\n    @staticmethod\n    def hex_to_decimal(hex_char: str) -> int:\n        \"\"\"Converts a single hexadecimal character to its decimal equivalent.\n        Assumes valid single hex character input.\"\"\"\n        return int(hex_char, 16)\n\n    @staticmethod\n    def is_prime_hex_value(decimal_value: int, prime_values: set[int]) -> bool:\n        \"\"\"Checks if a decimal value is present in the set of prime hexadecimal values.\n        This provides a quick lookup for primality.\"\"\"\n        return decimal_value in prime_values\n\n# src/hex_key_counter/core.py\n# Contains the core logic for counting prime hexadecimal digits.\nfrom .utils import HexDigitConverter\nfrom .constants import PRIME_HEX_DECIMAL_VALUES\n\nclass HexKeyCounter:\n    def __init__(self, prime_values: set[int] = None):\n        \"\"\"Initializes the HexKeyCounter with a set of prime hexadecimal values.\n        Defaults to predefined prime values if none are provided.\"\"\"\n        self._prime_hex_values = prime_values if prime_values is not None else PRIME_HEX_DECIMAL_VALUES\n\n    def count_primes(self, hex_string: str) -> int:\n        \"\"\"Counts the number of prime hexadecimal digits in the input string.\n        It iterates through each character, converts it to decimal, and checks for primality.\"\"\"\n        count = 0\n        for char in hex_string:\n            decimal_value = HexDigitConverter.hex_to_decimal(char)\n            if HexDigitConverter.is_prime_hex_value(decimal_value, self._prime_hex_values):\n                count += 1\n        return count\n\n# src/hex_key_counter/api.py\n# Defines the public API function for the prime hexadecimal digit counter.\nfrom .core import HexKeyCounter\nfrom .constants import PRIME_HEX_DECIMAL_VALUES\n\ndef hex_key(num: str) -> int:\n    \"\"\"Counts the number of prime hexadecimal digits in a given string.\n    This function serves as the public API entry point.\"\"\"\n    counter = HexKeyCounter(prime_values=PRIME_HEX_DECIMAL_VALUES)\n    return counter.count_primes(num)\n```"}
