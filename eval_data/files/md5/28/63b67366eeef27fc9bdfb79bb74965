{"task_id": "HumanEval/47", "solution": "class EmptyListError(Exception):\n    \"\"\"Raised when the input list is empty.\n    Custom exception for empty input.\"\"\"\n    def __init__(self, message=\"Input list cannot be empty.\"):\n        self.message = message\n        super().__init__(self.message)\n\nclass NonNumericInputError(Exception):\n    \"\"\"Raised when the input list contains non-numeric elements.\n    Custom exception for invalid element types.\"\"\"\n    def __init__(self, message=\"Input list must contain only numeric elements (int or float).\"):\n        self.message = message\n        super().__init__(self.message)\n\ndef median(l: list):\n    \"\"\"Return median of elements in the list l.\n    Handles empty and non-numeric inputs with custom exceptions.\"\"\"\n    if not l:\n        raise EmptyListError()\n\n    for item in l:\n        if not isinstance(item, (int, float)):\n            raise NonNumericInputError()\n\n    sorted_data = sorted(l)\n    n = len(sorted_data)\n\n    if n % 2 == 1:\n        return sorted_data[n // 2]\n    else:\n        mid1 = sorted_data[n // 2 - 1]\n        mid2 = sorted_data[n // 2]\n        return (mid1 + mid2) / 2"}
{"task_id": "HumanEval/47", "solution": "```python\nfrom typing import List, Union\n\nclass MedianCalculator:\n    \"\"\"\n    Provides utility methods for calculating the median of a list of numbers.\n    It encapsulates the core logic for sorting and determining the median.\n    \"\"\"\n\n    @staticmethod\n    def calculate_median(numbers: List[Union[int, float]]) -> Union[int, float]:\n        \"\"\"\n        Return the median of elements in the list of numbers.\n        Raises ValueError if the input list is empty.\n        \"\"\"\n        if not numbers:\n            raise ValueError(\"Input list cannot be empty.\")\n\n        sorted_numbers = sorted(numbers)\n        n = len(sorted_numbers)\n\n        if n % 2 == 1:\n            # For an odd number of elements, return the middle element.\n            return sorted_numbers[n // 2]\n        else:\n            # For an even number of elements, return the average of the two middle elements.\n            mid1 = sorted_numbers[n // 2 - 1]\n            mid2 = sorted_numbers[n // 2]\n            return (mid1 + mid2) / 2\n```"}
{"task_id": "HumanEval/35", "solution": "```python\nfrom typing import List, TypeVar, Union\n\n# Define a type variable for comparable types.\nComparable = TypeVar('Comparable', bound=Union[int, float, str])\n\ndef max_element(l: List[Comparable]) -> Comparable:\n    \"\"\"\n    Finds and returns the maximum element in a list.\n\n    Args:\n        l: A list of comparable elements (e.g., int, float, str).\n\n    Returns:\n        The maximum element in the list.\n\n    Raises:\n        ValueError: If the input list is empty.\n\n    Examples:\n        >>> max_element([1, 5, 2, 8, 3])\n        8\n        >>> max_element([-10, -5, -20])\n        -5\n        >>> max_element([3.14, 2.71, 1.618])\n        3.14\n        >>> max_element(['apple', 'banana', 'cherry'])\n        'cherry'\n        >>> max_element([7])\n        7\n    \"\"\"\n    if not l:\n        raise ValueError(\"Input list cannot be empty\")\n\n    max_val = l[0]\n    for element in l[1:]:\n        if element > max_val:\n            max_val = element\n    return max_val\n```"}
