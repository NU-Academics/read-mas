{"task_id": "HumanEval/35", "solution": "# src/max_finder/exceptions.py\nclass EmptyListError(ValueError):\n    \"\"\"Exception raised for an empty input list.\n    It indicates that a required list parameter was provided but found to be empty.\"\"\"\n    def __init__(self, message=\"Input list cannot be empty.\"):\n        self.message = message\n        super().__init__(self.message)\n\nclass InvalidInputError(TypeError):\n    \"\"\"Exception raised for invalid input type or content.\n    This signifies that the input does not conform to the expected type or contains invalid elements.\"\"\"\n    def __init__(self, message=\"Invalid input: Expected a list of numbers.\"):\n        self.message = message\n        super().__init__(self.message)\n\n# src/max_finder/core.py\nfrom typing import Union\nfrom .exceptions import EmptyListError, InvalidInputError\n\nclass MaxFinder:\n    @staticmethod\n    def max_element(l: list) -> Union[int, float]:\n        \"\"\"Return the maximum numerical element in the list.\n        It validates input type and content, then efficiently finds the largest number.\"\"\"\n        if not isinstance(l, list):\n            raise InvalidInputError(\"Input must be a list.\")\n        if not l:\n            raise EmptyListError(\"Input list cannot be empty.\")\n\n        max_val = None\n        for item in l:\n            if not isinstance(item, (int, float)):\n                raise InvalidInputError(\"List elements must be numbers (int or float).\")\n            if max_val is None or item > max_val:\n                max_val = item\n        return max_val\n\n# src/max_finder/__init__.py\n# This file can be empty or contain package-level initialization.\n# For this design, an empty __init__.py is sufficient to define the package.\n\n# pyproject.toml\n[project]\nname = \"max_finder\"\nversion = \"0.1.0\"\ndescription = \"A utility to find the maximum numerical element in a list.\"\nauthors = [\n    { name = \"Your Name\", email = \"your.email@example.com\" },\n]\nlicense = { text = \"MIT\" }\nreadme = \"README.md\"\nrequires-python = \">=3.8\"\nclassifiers = [\n    \"Programming Language :: Python :: 3\",\n    \"License :: OSI Approved :: MIT License\",\n    \"Operating System :: OS Independent\",\n    \"Development Status :: 3 - Alpha\",\n    \"Intended Audience :: Developers\",\n    \"Topic :: Utilities\",\n]\n\n[build-system]\nrequires = [\"setuptools>=61.0\"]\nbuild-backend = \"setuptools.build_meta\"\n\n# README.md\n# MaxFinder\nA simple Python utility to find the maximum numerical element within a given list.\n\n## Features\n- Finds the largest `int` or `float` in a list.\n- Handles empty lists and invalid input types gracefully with custom exceptions.\n- Designed for O(n) performance.\n\n## Installation\nSince this is a standalone utility, you can directly copy the `src/max_finder` directory into your project, or install it as a local package.\n\n### From source\n1. Clone the repository (if applicable) or copy the `src/max_finder` directory into your project.\n2. Ensure you have Python 3.8+ installed.\n\n## Usage\n\n```python\nfrom max_finder.core import MaxFinder\nfrom max_finder.exceptions import EmptyListError, InvalidInputError\n\n# Example 1: Valid list\ntry:\n    numbers = [1, 5, 2, 8, 3.5, -10]\n    max_val = MaxFinder.max_element(numbers)\n    print(f\"The maximum element in {numbers} is: {max_val}\") # Output: The maximum element in [1, 5, 2, 8, 3.5, -10] is: 8\nexcept (EmptyListError, InvalidInputError) as e:\n    print(f\"Error: {e}\")\n\n# Example 2: Empty list\ntry:\n    empty_numbers = []\n    max_val = MaxFinder.max_element(empty_numbers)\n    print(f\"The maximum element in {empty_numbers} is: {max_val}\")\nexcept (EmptyListError, InvalidInputError) as e:\n    print(f\"Error: {e}\") # Output: Error: Input list cannot be empty.\n\n# Example 3: List with non-numeric elements\ntry:\n    mixed_list = [1, 2, \"three\", 4]\n    max_val = MaxFinder.max_element(mixed_list)\n    print(f\"The 