{"task_id": "HumanEval/111", "solution": "```python\nfrom collections import Counter\n\nclass HistogramService:\n    def calculate_histogram(self, input_string: str) -> dict[str, int]:\n        \"\"\"Orchestrates counting letters and finding the most frequent ones.\"\"\"\n        if not input_string:\n            return {}\n\n        letter_counts = self._count_letters(input_string)\n        return self._find_max_frequency_letters(letter_counts)\n\n    def _count_letters(self, input_string: str) -> dict[str, int]:\n        \"\"\"Counts the occurrences of each individual letter in the input string.\"\"\"\n        letters = input_string.split(' ')\n        return dict(Counter(letters))\n\n    def _find_max_frequency_letters(self, letter_counts: dict[str, int]) -> dict[str, int]:\n        \"\"\"Identifies letters with the maximum frequency from a given count dictionary.\"\"\"\n        if not letter_counts:\n            return {}\n\n        max_count = max(letter_counts.values())\n        result = {letter: count for letter, count in letter_counts.items() if count == max_count}\n        return result\n\ndef histogram(test: str) -> dict[str, int]:\n    \"\"\"Given a string of space-separated lowercase letters, returns a dictionary\n    of the most frequent letter(s) and their corresponding counts.\n    \"\"\"\n    service = HistogramService()\n    return service.calculate_histogram(test)\n```\n"}
