      try:\n            result = eval(expression_string)\n            if not isinstance(result, int):\n                result = int(result)\n            return result\n        except ZeroDivisionError:\n            raise CalculationError(\"Division by zero occurred during expression evaluation.\")\n        except Exception as e:\n            raise CalculationError(f\"An unexpected error occurred during calculation: {e}\")\n```"}
{"task_id": "HumanEval/161", "solution": "```python\nclass StringUtilsSolver:\n    \"\"\"Provides core logic for string manipulation including case reversal and full string reversal.\"\"\"\n\n    @staticmethod\n    def _reverse_case_char(char: str) -> str:\n        \"\"\"Reverses the case of an alphabetic character. Non-alphabetic characters are returned unchanged.\"\"\"\n        if char.isalpha():\n            if char.islower():\n                return char.upper()\n            else:\n                return char.lower()\n        return char\n\n    @staticmethod\n    def _contains_letters(s: str) -> bool:\n        \"\"\"Checks if the string contains any alphabetic characters.\"\"\"\n        return any(char.isalpha() for char in s)\n\n    @staticmethod\n    def solve(s: str) -> str:\n        \"\"\"\n        Processes a string to reverse letter case or reverse the entire string if no letters are present.\n        Raises TypeError if input is not a string.\n        \"\"\"\n        if not isinstance(s, str):\n            raise TypeError(\"Input must be a string.\")\n\n        if not StringUtilsSolver._contains_letters(s):\n            return s[::-1]  # Reverse the entire string\n\n        result_chars = [StringUtilsSolver._reverse_case_char(char) for char in s]\n        return \"\".join(result_chars)\n\ndef solve(s):\n    return StringUtilsSolver.solve(s)\n\n```"}
