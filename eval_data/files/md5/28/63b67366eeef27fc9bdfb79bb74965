{"task_id": "HumanEval/112", "solution": "```python\ndef reverse_delete(s, c):\n    \"\"\"Task\n    We are given two strings s and c, you have to deleted all the characters in s that are equal to any character in c\n    then check if the result string is palindrome.\n    A string is called palindrome if it reads the same backward as forward.\n    You should return a tuple containing the result string and True/False for the check.\n    Example\n    For s = \"abcde\", c = \"ae\", the result should be ('bcd',False)\n    For s = \"abcdef\", c = \"b\"  the result should be ('acdef',False)\n    For s = \"abcdedcba\", c = \"ab\", the result should be ('cdedc',True)\n    \"\"\"\n    if not isinstance(s, str) or not isinstance(c, str):\n        raise TypeError(\"Inputs 's' and 'c' must be strings.\")\n\n    c_set = set(c)\n    filtered_s_chars = []\n    for char in s:\n        if char not in c_set:\n            filtered_s_chars.append(char)\n    filtered_s = \"\".join(filtered_s_chars)\n\n    def is_palindrome(text: str) -> bool:\n        \"\"\"\n        Checks if a given string is a palindrome.\n        It compares the string with its reversed version.\n        \"\"\"\n        return text == text[::-1]\n\n    is_pal = is_palindrome(filtered_s)\n    return (filtered_s, is_pal)\n\n```"}
{"task_id": "HumanEval/114", "solution": "```python\nclass MinSubarraySumSolver:\n    \"\"\"A solver class for finding the minimum sum of any non-empty sub-array.\"\"\"\n\n    @staticmethod\n    def minSubArraySum(nums: list[int]) -> int:\n        \"\"\"\n        Calculates the minimum sum of any non-empty sub-array in nums using Kadane's algorithm variant.\n        The input array 'nums' is guaranteed to be non-empty, but an explicit check is included for robustness.\n        \"\"\"\n        if not nums:\n            raise ValueError(\"Input array 'nums' cannot be empty.\")\n\n        min_ending_here = nums[0]\n        min_so_far = nums[0]\n\n        for i in range(1, len(nums)):\n            num = nums[i]\n            min_ending_here = min(num, min_ending_here + num)\n            min_so_far = min(min_so_far, min_ending_here)\n\n        return min_so_far\n```\n"}
{"task_id": "HumanEval/113", "solution": "```python\n# src/odd_counter/__init__.py\n# This file can be empty to mark 'odd_counter' as a Python package.\n\n```\n\n```python\n# src/odd_counter/utils.py\nclass OddDigitCounter:\n    \"\"\"Provides utility for counting odd digits and defines the output template.\"\"\"\n    ODD_COUNT_TEMPLATE = \"the number of odd elements {count}n the str{count}ng {count} of the {count}nput.\"\n\n    @staticmethod\n    def count_odd_digits(digit_string: str) -> int:\n        \"\"\"Counts the number of odd digits in a given string.\n        Assumes the input string contains only digits.\"\"\"\n        odd_count = 0\n        for char_digit in digit_string:\n            if int(char_digit) % 2 != 0:\n                odd_count += 1\n        return odd_count\n\n```\n\n```python\n# src/odd_counter/services.py\nfrom typing import List\nfrom odd_counter.utils import OddDigitCounter\n\nclass OddCountService:\n    \"\"\"Service to process a list of digit strings and return formatted odd digit counts.\"\"\"\n    def odd_count(self, input_list: List[str]) -> List[str]:\n        \"\"\"Processes a list of digit strings to count odd digits.\n        Returns a list of formatted descriptive strings.\"\"\"\n        results = []\n        for digit_string in input_list:\n            odd_count_val = OddDigitCounter.count_odd_digits(digit_string)\n            formatted_string = OddDigitCounter.ODD_COUNT_TEMPLATE.format(count=odd_count_val)\n            results.append(formatted_string)\n        return results\n\n```"}
{"task_id": "HumanEval/114", "solution": "def minSubArraySum(nums):\n    \"\"\"\n    Given an array of integers nums, find the minimum sum of any non-empty sub-array\n    of nums.\n    Example\n    minSubArraySum([2, 3, 4, 1, 2, 4]) == 1\n    minSubArraySum([-1, -2, -3]) == -6\n    \"\"\"\n    if not nums:\n        raise ValueError(\"Input array cannot be empty.\")\n\n    min_so_far = nums[0]\n    current_min = nums[0]\n\n    for i in range(1, len(nums)):\n        current_min = min(nums[i], current_min + nums[i])\n        min_so_far = min(min_so_far, current_min)\n\n    return min_so_far"}
{"task_id": "HumanEval/115", "solution": "```python\nimport math\n\nclass WellCalculator:\n    \"\"\"\n    A utility class for calculating bucket operations to empty wells.\n    This class provides a static method to compute the total bucket lowering operations.\n    \"\"\"\n    @staticmethod\n    def max_fill(grid: list[list[int]], capacity: int) -> int:\n        \"\"\"\n        Calculates the total number of times buckets need to be lowered to empty all wells.\n        It iterates through each well, sums its water, and applies bucket capacity.\n        \"\"\"\n        total_bucket_operations = 0\n        for well_row in grid:\n            water_in_well = sum(well_row)\n            if water_in_well > 0:\n                # Calculate operations for the current well, rounding up.\n                operations_for_well = math.ceil(water_in_well / capacity)\n                total_bucket_operations += operations_for_well\n        return total_bucket_operations\n```\n"}
{"task_id": "HumanEval/116", "solution": "```python\n# src/utils.py\n# This file defines the BitCounter class for counting set bits.\n\nclass BitCounter:\n    @staticmethod\n    def count_set_bits(n: int) -> int:\n        \"\"\"\n        Counts the number of set bits (1s) in the binary representation of a non-negative integer.\n        It uses Brian Kernighan's algorithm for efficient counting.\n        \"\"\"\n        count = 0\n        while n > 0:\n            n &= (n - 1)\n            count += 1\n        return count\n\n```\n```python\n# src/sorter.py\n# This file contains the main sorting logic, including the BitwiseSorter class and the public sort_array function.\n\nfrom src.utils import BitCounter\n\nclass BitwiseSorter:\n    @staticmethod\n    def _comparison_key(num: int) -> tuple[int, int]:\n        \"\"\"\n        Generates a key for sorting based on set bit count and original number.\n        For negative numbers, set bits are counted from their absolute value as specified.\n        \"\"\"\n        abs_num = abs(num)\n        set_bits = BitCounter.count_set_bits(abs_num)\n        return (set_bits, num)\n\n    @staticmethod\n    def sort_array(arr: list[int]) -> list[int]:\n        \"\"\"\n        Sorts an array of integers by the count of set bits (ascending), then by decimal value (ascending).\n        This method performs input validation for type correctness.\n        \"\"\"\n        if not isinstance(arr, list):\n            raise TypeError(\"Input must be a list.\")\n        \n        for item in arr:\n            if not isinstance(item, int):\n                raise TypeError(\"All elements in the list must be integers.\")\n\n        return sorted(arr, key=BitwiseSorter._comparison_key)\n\n# The public function as specified by the requirements\ndef sort_array(arr: list[int]) -> list[int]:\n    \"\"\"\n    Sorts an array of integers according to the number of ones in their binary representation.\n    The primary sort is by set bit count ascending, and the secondary sort is by decimal value ascending.\n    \"\"\"\n    return BitwiseSorter.sort_array(arr)\n\n```"}
