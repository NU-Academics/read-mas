{"task_id": "HumanEval/83", "solution": "```python\ndef starts_one_ends(n: int) -> int:\n    \"\"\"\n    Counts n-digit positive integers that start or end with 1.\n    Raises ValueError if n is not a positive integer.\n    \"\"\"\n    if not isinstance(n, int) or n <= 0:\n        raise ValueError(\"n must be a positive integer.\")\n\n    if n == 1:\n        # The only 1-digit number is 1, which starts and ends with 1.\n        return 1\n\n    # Calculate counts using the Principle of Inclusion-Exclusion for n > 1.\n    count_starts_with_1 = 10**(n - 1)\n    count_ends_with_1 = 9 * (10**(n - 2))\n    count_starts_and_ends_with_1 = 10**(n - 2)\n\n    total_count = count_starts_with_1 + count_ends_with_1 - count_starts_and_ends_with_1\n    return total_count\n```"}
{"task_id": "HumanEval/81", "solution": "```python\n# src/grade_converter.py\n\nclass GradeConverter:\n    # GRADING_SCALE defines the exclusive lower bound for each grade.\n    # It is ordered from highest GPA threshold to lowest.\n    GRADING_SCALE = [\n        (3.7, 'A'),\n        (3.3, 'A-'),\n        (3.0, 'B+'),\n        (2.7, 'B'),\n        (2.3, 'B-'),\n        (2.0, 'C+'),\n        (1.7, 'C'),\n        (1.3, 'C-'),\n        (1.0, 'D+'),\n        (0.7, 'D'),\n        (0.0, 'D-')\n    ]\n\n    def convert_gpa_to_letter_grade(self, gpa: float) -> str:\n        \"\"\"\n        Converts a single GPA to its corresponding letter grade.\n        Handles specific GPA values first, then uses the GRADING_SCALE for ranges.\n        \"\"\"\n        if gpa == 4.0:\n            return 'A+'\n        if gpa == 0.0:\n            return 'E'\n        \n        for threshold, grade in self.GRADING_SCALE:\n            if gpa > threshold:\n                return grade\n        \n        # Default for values not covered (e.g., negative GPAs).\n        return 'E' \n\n    def numerical_letter_grade(self, grades: list[float]) -> list[str]:\n        \"\"\"\n        Converts a list of GPAs to a list of letter grades.\n        Each GPA is processed individually using convert_gpa_to_letter_grade.\n        \"\"\"\n        return [self.convert_gpa_to_letter_grade(gpa) for gpa in grades]\n```"}
{"task_id": "HumanEval/83", "solution": "```python\n# src/number_counter.py\nclass NumberCounter:\n    @staticmethod\n    def starts_one_ends(n: int) -> int:\n        \"\"\"\n        Calculates the count of n-digit positive integers that start or end with 1.\n        Raises ValueError if n is not a positive integer.\n        \"\"\"\n        if not isinstance(n, int) or n <= 0:\n            raise ValueError(\"Input 'n' must be a positive integer.\")\n\n        if n == 1:\n            # For n=1, only '1' starts or ends with 1.\n            return 1\n        else:\n            # Applies the inclusion-exclusion principle: (starts with 1) + (ends with 1) - (starts AND ends with 1).\n            # This simplifies to 18 * (10**(n - 2)) for n > 1.\n            return 18 * (10**(n - 2))\n\n```\n```python\n# src/__init__.py\n# Initializes the src package.\n\n```\n```toml\n# pyproject.toml\n[project]\nname = \"number-counter\"\nversion = \"0.1.0\"\ndescription = \"A utility to count n-digit numbers starting or ending with 1.\"\nauthors = [\n    { name = \"Your Name\", email = \"your.email@example.com\" }\n]\nreadme = \"README.md\"\nrequires-python = \">=3.8\"\nlicense = { text = \"MIT\" }\nkeywords = [\"math\", \"counting\", \"utility\"]\n\n[build-system]\nrequires = [\"setuptools>=61.0\"]\nbuild-backend = \"setuptools.build_meta\"\n\n[tool.setuptools.packages.find]\nwhere = [\"src\"]\n```"}
{"task_id": "HumanEval/84", "solution": "```python\n# src/__init__.py\n# Initializes the src package\n```\n```python\n# src/utils.py\ndef int_to_binary_string(num: int) -> str:\n    \"\"\"Converts a non-negative integer to its binary string representation. It uses Python's built-in bin() function and removes the '0b' prefix.\"\"\"\n    if num < 0:\n        raise ValueError(\"Input must be a non-negative integer.\")\n    return bin(num)[2:]\n```\n```python\n# src/digit_sum_converter.py\nfrom src import utils\n\nclass DigitSumConverter:\n    \"\"\"Provides methods to calculate the sum of decimal digits of an integer and convert the sum to a binary string.\"\"\"\n    MAX_N: int = 10000\n\n    @classmethod\n    def calculate_digit_sum(cls, n: int) -> int:\n        \"\"\"Calculates the sum of the decimal digits of a given integer n.\"\"\"\n        total_sum = 0\n        for digit_char in str(n):\n            total_sum += int(digit_char)\n        return total_sum\n\n    @classmethod\n    def convert_to_binary_string(cls, num: int) -> str:\n        \"\"\"Converts a non-negative integer num into its binary string representation by delegating to Utils.\"\"\"\n        return utils.int_to_binary_string(num)\n\n    @classmethod\n    def solve(cls, N: int) -> str:\n        \"\"\"The main entry point: validates input N, calculates its digit sum, and converts the sum to a binary string.\"\"\"\n        if not isinstance(N, int) or not (0 <= N <= cls.MAX_N):\n            raise ValueError(f\"Input N must be an integer within the range 0 <= N <= {cls.MAX_N}.\")\n        \n        sum_of_digits = cls.calculate_digit_sum(N)\n        binary_string = cls.convert_to_binary_string(sum_of_digits)\n        return binary_string\n```\n```toml\n# pyproject.toml\n[project]\nname = \"digit_sum_converter_app\"\nversion = \"0.1.0\"\ndescription = \"A utility to calculate the sum of decimal digits of a positive integer and represent it as a binary string.\"\nauthors = [\n    { name = \"Your Name\", email = \"your.email@example.com\" }\n]\nrequires-python = \">=3.9\"\nreadme = \"README.md\"\nlicense = { text = \"MIT\" }\nkeywords = [\"digit sum\", \"binary conversion\", \"utility\"]\n\n[build-system]\nrequires = [\"setuptools>=61.0\"]\nbuild-backend = \"setuptools.build_meta\"\n\n[tool.setuptools]\npackages = [\"src\"]\n```"}
{"task_id": "HumanEval/84", "solution": "```python\n# src/__init__.py\n```\n\n```python\n# src/utils.py\nclass Utils:\n    @staticmethod\n    def decimal_to_binary(decimal_num: int) -> str:\n        if decimal_num == 0:\n            return \"0\"\n        binary_str = \"\"\n        while decimal_num > 0:\n            binary_str = str(decimal_num % 2) + binary_str\n            decimal_num //= 2\n        return binary_str\n```\n\n```python\n# src/digit_sum_calculator.py\nfrom src.utils import Utils\n\nclass DigitSumCalculator:\n    def solve(self, N: int) -> str:\n        \"\"\"Calculates the sum of decimal digits of N and returns it in binary string format.\n        Assumes N is within the valid range (0 <= N <= 10000) as per FR1 error handling.\n        \"\"\"\n        sum_of_digits = 0\n        temp_N = N\n        \n        # Calculate sum of decimal digits. This loop handles N=0 correctly.\n        while temp_N > 0:\n            sum_of_digits += temp_N % 10\n            temp_N //= 10\n        \n        return Utils.decimal_to_binary(sum_of_digits)\n```"}
{"task_id": "HumanEval/85", "solution": "```python\nclass Calculator:\n    def add(self, lst: list[int]) -> int:\n        \"\"\"Calculates the sum of even elements located at odd indices in a list.\n        Raises TypeError for invalid input types or ValueError for an empty list.\"\"\"\n        if not isinstance(lst, list):\n            raise TypeError(\"Input must be a list.\")\n        if not lst:\n            raise ValueError(\"Input list cannot be empty.\")\n\n        total_sum = 0\n        for i, num in enumerate(lst):\n            if not isinstance(num, int):\n                raise TypeError(f\"List elements must be integers, but found {type(num)} at index {i}.\")\n            if i % 2 != 0 and num % 2 == 0:\n                total_sum += num\n        return total_sum\n```"}
{"task_id": "HumanEval/85", "solution": "```python\n# src/__init__.py\n```\n```python\n# src/calculator.py\nclass Calculator:\n    @staticmethod\n    def add(lst: list[int]) -> int:\n        \"\"\"\n        Calculates the sum of even elements at odd indices in a list.\n        Raises ValueError if the list is empty and TypeError for invalid types.\n        \"\"\"\n        if not isinstance(lst, list):\n            raise TypeError(\"Input must be a list.\")\n        if not lst:\n            raise ValueError(\"Input list cannot be empty.\")\n\n        total_sum = 0\n        for i, element in enumerate(lst):\n            if not isinstance(element, int):\n                raise TypeError(f\"List element at index {i} is not an integer: {element}\")\n            # Check if index is odd and element is even, then add to sum.\n            if i % 2 != 0 and element % 2 == 0:\n                total_sum += element\n        return total_sum\n```\n```toml\n# pyproject.toml\n[build-system]\nrequires = [\"setuptools>=61.0\"]\nbuild-backend = \"setuptools.build_meta\"\n\n[project]\nname = \"odd-index-even-sum-calculator\"\nversion = \"0.1.0\"\nauthors = [\n  { name=\"Your Name\", email=\"your.email@example.com\" },\n]\ndescription = \"A utility to sum even elements at odd indices in a list of integers.\"\nreadme = \"README.md\"\nrequires-python = \">=3.8\"\nkeywords = [\"utility\", \"sum\", \"list\", \"even\", \"odd-index\"]\nlicense = { text = \"MIT\" }\nclassifiers = [\n    \"Programming Language :: Python :: 3\",\n    \"License :: OSI Approved :: MIT License\",\n    \"Operating System :: OS Independent\",\n    \"Development Status :: 3 - Alpha\",\n    \"Intended Audience :: Developers\",\n]\n\n[project.urls]\nHomepage = \"https://github.com/yourusername/odd-index-even-sum-calculator\"\nIssues = \"https://github.com/yourusername/odd-index-even-sum-calculator/issues\"\n```\n```markdown\n# README.md\n# Odd Index Even Sum Calculator\n\nThis project provides a Python utility function to calculate the sum of even elements that are located at odd indices within a list of integers.\n\n## Features\n\n- Sums even numbers exclusively at odd list indices.\n- Validates input for list type, non-emptiness, and integer elements.\n\n## Installation\n\n```bash\npip install odd-index-even-sum-calculator\n```\n\n(Note: Replace `odd-index-even-sum-calculator` with the actual package name if published to PyPI, or install directly from source for local use.)\n\n## Usage\n\n```python\nfrom src.calculator import Calculator\n\n# Example usage\nmy_list = [1, 2, 3, 4, 5, 6]\nresult = Calculator.add(my_list)\nprint(f\"The sum of even elements at odd indices is: {result}\") # Expected: 12 (2 + 4 + 6)\n\nmy_list_2 = [4, 2, 6, 7]\nresult_2 = Calculator.add(my_list_2)\nprint(f\"The sum of even elements at odd indices is: {result_2}\") # Expected: 2\n\n# Error handling examples\ntry:\n    Calculator.add([])\nexcept ValueError as e:\n    print(f\"Error: {e}\") # Expected: Input list cannot be empty.\n\ntry:\n    Calculator.add(\"not a list\")\nexcept TypeError as e:\n    print(f\"Error: {e}\") # Expected: Input must be a list.\n\ntry:\n    Calculator.add([1, \"a\", 3])\nexcept TypeError as e:\n    print(f\"Error: {e}\") # Expected: List element at index 1 is not an integer: a\n```\n```\n```python\nimport unittest\nfrom src.calculator import Calculator\n\nclass TestCalculator(unittest.TestCase):\n\n    def test_add_basic(self):\n        self.assertEqual(Calculator.add([4, 2, 6, 7]), 2)\n        self.assertEqual(Calculator.add([1, 2, 3, 4, 5, 6]), 12) # 2 + 4 + 6\n        self.assertEqual(Calculator.add([10, 20, 30, 40, 50]), 60) # 20 + 40\n\n    def test_add_empty_list(self):\n        with self.assertRaises(ValueError):\n            Calculator.add([])\n\n    def test_add_no_even_at_odd_indices(self):\n        self.assertEqual(Calculator.add([1, 3, 5, 7]), 0)\n        self.assertEqual(Calculator.add([2, 4, 6, 8]), 0) # Even numbers but at even indices\n        self.assertEqual(Calculator.add([1, 2, 3, 5]), 2) # Only 2 is at odd index and even\n\n    def test_add_all_even_at_odd_indices(self):\n        self.assertEqual(Calculator.add([1, 2, 1, 4, 1, 6]), 12) # 2 + 4 + 6\n\n    def test_add_single_element(self):\n        self.assertEqual(Calculator.add([10]), 0) # No odd indices\n        self.assertEqual(Calculator.add([5]), 0)\n\n    def test_add_type_errors(self):\n        with self.assertRaises(TypeError):\n            Calculator.add(\"not a list\")\n        with self.assertRaises(TypeError):\n            Calculator.add([1, \"a\", 3])\n        with self.assertRaises(TypeError):\n            Calculator.add([1, 2.5, 3])\n        with self.assertRaises(TypeError):\n            Calculator.add([None])\n\n```"}
{"task_id": "HumanEval/77", "solution": "```python\nimport math\n\ndef iscube(a: int) -> bool:\n    '''\n    Checks if an integer 'a' is a cube of some integer number.\n    Assumes valid integer input.\n    Examples:\n    iscube(1) ==> True\n    iscube(2) ==> False\n    iscube(-1) ==> True\n    iscube(64) ==> True\n    iscube(0) ==> True\n    iscube(180) ==> False\n    '''\n    if a == 0:\n        return True\n\n    # Calculate the integer cube root.\n    # We use abs() to handle negative numbers during the exponentiation,\n    # then adjust the sign of the root.\n    \n    # Calculate the cube root using `** (1/3.0)` and round it to the nearest integer.\n    # This mitigates floating-point inaccuracies.\n    root = round(abs(a)**(1/3.0))\n\n    # Adjust the sign of the root if the original number was negative.\n    # For example, cube root of -8 is -2, but round(abs(-8)**(1/3.0)) would give 2.\n    if a < 0:\n        root = -root\n    \n    # Check if the cube of the (integer) root is equal to the original number.\n    return root * root * root == a\n\n```"}
{"task_id": "HumanEval/86", "solution": "```python\nclass AntiShuffleService:\n    def _sort_word_characters(self, word: str) -> str:\n        \"\"\"\n        Sorts the characters of a single word based on their ASCII values.\n        This uses Python's default sorted function, then joins them into a string.\n        \"\"\"\n        return ''.join(sorted(word))\n\n    def anti_shuffle_logic(self, s: str) -> str:\n        \"\"\"\n        Reorders characters within each word of the input string s.\n        Words are delimited by spaces; their original order and spacing are maintained.\n        \"\"\"\n        words_and_spaces = s.split(' ')\n        shuffled_words = [self._sort_word_characters(word) for word in words_and_spaces]\n        return ' '.join(shuffled_words)\n\ndef anti_shuffle(s):\n    \"\"\"\n    Write a function that takes a string and returns an ordered version of it.\n    Ordered version of string, is a string where all words (separated by space)\n    are replaced by a new word where all the characters arranged in\n    ascending order based on ascii value.\n    Note: You should keep the order of words and blank spaces in the sentence.\n\n    For example:\n    anti_shuffle('Hi') returns 'Hi'\n    anti_shuffle('hello') returns 'ehllo'\n    anti_shuffle('Hello World!!!') returns 'Hello !!!Wdlor'\n    \"\"\"\n    service = AntiShuffleService()\n    return service.anti_shuffle_logic(s)\n```"}
{"task_id": "HumanEval/86", "solution": "```python\n# src/anti_shuffle/__init__.py\n```\n```python\n# src/anti_shuffle/core.py\nfrom typing import List\n\nclass WordSorter:\n    \"\"\"Encapsulates logic for sorting characters within a single word.\"\"\"\n    def sort_chars(self, word: str) -> str:\n        \"\"\"Sorts characters of a word based on ASCII values and returns the new word.\"\"\"\n        return \"\".join(sorted(word))\n\nclass AntiShuffleService:\n    \"\"\"Implements the core logic for the anti_shuffle function.\"\"\"\n    def __init__(self, word_sorter: WordSorter = None):\n        \"\"\"Initializes the service, optionally with a custom WordSorter.\"\"\"\n        self._word_sorter = word_sorter if word_sorter is not None else WordSorter()\n\n    def anti_shuffle(self, s: str) -> str:\n        \"\"\"Splits the input string, sorts characters within each word, and reconstructs the string.\"\"\"\n        if not s:\n            return \"\"\n\n        result_parts: List[str] = []\n        current_word: List[str] = []\n\n        for char in s:\n            if char == ' ':\n                if current_word:\n                    result_parts.append(self._word_sorter.sort_chars(\"\".join(current_word)))\n                    current_word = []\n                result_parts.append(' ')\n            else:\n                current_word.append(char)\n\n        if current_word:\n            result_parts.append(self._word_sorter.sort_chars(\"\".join(current_word)))\n\n        return \"\".join(result_parts)\n\ndef anti_shuffle(s: str) -> str:\n    \"\"\"\n    Takes a string and returns an ordered version of it.\n    This orders characters within each word while preserving word and space order.\n    \"\"\"\n    service = AntiShuffleService()\n    return service.anti_shuffle(s)\n\n```\n```toml\n# pyproject.toml\n[project]\nname = \"anti-shuffle\"\nversion = \"0.1.0\"\ndescription = \"A utility function to reorder characters within words of a given string.\"\nauthors = [{ name = \"Your Name\", email = \"your.email@example.com\" }]\nreadme = \"README.md\"\nrequires-python = \">=3.8\"\nlicense = { text = \"MIT\" }\n\n[build-system]\nrequires = [\"setuptools>=61.0\"]\nbuild-backend = \"setuptools.build_meta\"\n\n```\n```markdown\n<!-- README.md -->\n# Anti-Shuffle Utility\n\nThis project provides a Python utility function to reorder characters within words of a given string. Characters within each word are sorted alphabetically (ASCII-wise), while preserving the original word order and spacing.\n\n## Installation\n\n```bash\n# Assuming you have setuptools installed\npip install .\n```\n\n## Usage\n\n```python\nfrom anti_shuffle.core import anti_shuffle\n\n# Example usage:\ninput_string = \"Hello World!!!\"\noutput_string = anti_shuffle(input_string)\nprint(f\"Original: '{input_string}'\")\nprint(f\"Shuffled: '{output_string}'\") # Expected: 'Hello !!!Wdlor'\n\ninput_string_2 = \"  test   string  \"\noutput_string_2 = anti_shuffle(input_string_2)\nprint(f\"Original: '{input_string_2}'\")\nprint(f\"Shuffled: '{output_string_2}'\") # Expected: '  estt   ginrst  '\n```\n\n## Functionality\n\nThe `anti_shuffle` function takes a string as input and performs the following operations:\n1.  Splits the input string into words and space delimiters.\n2.  For each word, it sorts its characters in ascending order based on their ASCII values.\n3.  Reconstructs the string by rejoining the sorted words and original spaces, maintaining their original sequence.\n```"}
{"task_id": "HumanEval/87", "solution": "```python\nclass CoordinateFinder:\n    def get_row(self, lst: list[list[int]], x: int) -> list[tuple[int, int]]:\n        \"\"\"\n        Finds all occurrences of an integer x in a 2D list and returns their sorted coordinates.\n        Coordinates are sorted primarily by row ascending, then by column descending.\n        \"\"\"\n        if not isinstance(lst, list):\n            raise TypeError(\"Input 'lst' must be a list.\")\n        if not isinstance(x, int):\n            raise TypeError(\"Input 'x' must be an integer.\")\n\n        coordinates = []\n        for r_idx, row in enumerate(lst):\n            if not isinstance(row, list):\n                raise TypeError(f\"Row at index {r_idx} must be a list.\")\n            for c_idx, val in enumerate(row):\n                if not isinstance(val, int):\n                    raise TypeError(f\"Value at ({r_idx}, {c_idx}) must be an integer.\")\n                if val == x:\n                    coordinates.append((r_idx, c_idx))\n\n        # Sort by row ascending, then by column descending.\n        coordinates.sort(key=lambda coord: (coord[0], -coord[1]))\n        return coordinates\n\n```"}
{"task_id": "HumanEval/88", "solution": "def sort_array(array: list[int]) -> list[int]:\n    \"\"\"\n    Sorts a copy of the input array based on the parity of the sum of its first and last elements.\n    Returns a new list, sorted according to the specified rules.\n    \"\"\"\n    if not array:\n        return []\n    if len(array) == 1:\n        return list(array)\n\n    first_element = array[0]\n    last_element = array[-1]\n    elements_sum = first_element + last_element\n\n    if elements_sum % 2 != 0:  # Odd sum, sort ascending\n        return sorted(array)\n    else:  # Even sum, sort descending\n        return sorted(array, reverse=True)\n```"}
{"task_id": "HumanEval/89", "solution": "```python\nLOWERCASE_ALPHABET = \"abcdefghijklmnopqrstuvwxyz\"\nUPPERCASE_ALPHABET = \"ABCDEFGHIJKLMNOPQRSTUVWXYZ\"\nROTATION_SHIFT = 4 # Fixed shift of 4 positions.\n\ndef _rotate_char(char: str, alphabet: str, shift: int) -> str:\n    \"\"\"Rotates a single character within a given alphabet by a specified shift.\"\"\"\n    index = alphabet.find(char)\n    if index == -1: # Character not found in the alphabet, return as is.\n        return char\n    new_index = (index + shift) % len(alphabet)\n    return alphabet[new_index]\n\ndef encrypt(s: str) -> str:\n    \"\"\"\n    Encrypts a string by rotating alphabetic characters by a fixed shift.\n    Non-alphabetic characters remain unchanged, and case is preserved.\n    \"\"\"\n    if not isinstance(s, str):\n        raise TypeError(\"Input must be a string.\")\n\n    encrypted_chars = []\n    for char in s:\n        if char.islower():\n            encrypted_chars.append(_rotate_char(char, LOWERCASE_ALPHABET, ROTATION_SHIFT))\n        elif char.isupper():\n            encrypted_chars.append(_rotate_char(char, UPPERCASE_ALPHABET, ROTATION_SHIFT))\n        else:\n            encrypted_chars.append(char) # Non-alphabetic characters are kept as is.\n    return \"\".join(encrypted_chars)\n```"}
{"task_id": "HumanEval/88", "solution": "```python\nfrom typing import List\n\ndef sort_array(array: List[int]) -> List[int]:\n    \"\"\"\n    Given an array of non-negative integers, return a copy of the given array after sorting,\n    you will sort the given array in ascending order if the sum( first index value, last index value) is odd,\n    or sort it in descending order if the sum( first index value, last index value) is even.\n\n    Note:\n    * don't change the given array.\n\n    Examples:\n    * sort_array([]) => []\n    * sort_array([5]) => [5]\n    * sort_array([2, 4, 3, 0, 1, 5]) => [0, 1, 2, 3, 4, 5]\n    * sort_array([2, 4, 3, 0, 1, 5, 6]) => [6, 5, 4, 3, 2, 1, 0]\n    \"\"\"\n    if not array:\n        return []\n\n    # Create a copy to avoid modifying the original array\n    array_copy = list(array)\n\n    first_element = array_copy[0]\n    last_element = array_copy[-1]\n    sum_elements = first_element + last_element\n\n    if sum_elements % 2 != 0:  # Sum is odd, sort in ascending order\n        array_copy.sort(reverse=False)\n    else:  # Sum is even, sort in descending order\n        array_copy.sort(reverse=True)\n\n    return array_copy\n```"}
{"task_id": "HumanEval/89", "solution": "```python\ndef encrypt(s: str) -> str:\n    \"\"\"Create a function encrypt that takes a string as an argument and\n    returns a string encrypted with the alphabet being rotated. \n    The alphabet should be rotated in a manner such that the letters \n    shift down by two multiplied to two places.\n    For example:\n    encrypt('hi') returns 'lm'\n    encrypt('asdfghjkl') returns 'ewhjklnop'\n    encrypt('gf') returns 'kj'\n    encrypt('et') returns 'ix'\n    \"\"\"\n    SHIFT_AMOUNT = 4\n\n    def is_lower(char: str) -> bool:\n        return 'a' <= char <= 'z'\n\n    def is_upper(char: str) -> bool:\n        return 'A' <= char <= 'Z'\n\n    def shift_char(char: str, shift: int) -> str:\n        if is_lower(char):\n            start = ord('a')\n            return chr(start + (ord(char) - start + shift) % 26)\n        elif is_upper(char):\n            start = ord('A')\n            return chr(start + (ord(char) - start + shift) % 26)\n        return char\n\n    encrypted_chars = []\n    for char in s:\n        if is_lower(char) or is_upper(char):\n            encrypted_chars.append(shift_char(char, SHIFT_AMOUNT))\n        else:\n            encrypted_chars.append(char)\n    return \"\".join(encrypted_chars)\n\n```"}
{"task_id": "HumanEval/90", "solution": "```python\n# src/next_smallest/__init__.py\nfrom .service import next_smallest\n\n# Expose the core function for direct import.\n__all__ = [\"next_smallest\"]\n\n\n# src/next_smallest/service.py\nclass ListProcessor:\n    \"\"\"Utility class for processing lists.\"\"\"\n    @staticmethod\n    def get_unique_sorted_elements(lst: list[int]) -> list[int]:\n        \"\"\"Returns unique elements from the input list, sorted ascending.\"\"\"\n        return sorted(list(set(lst)))\n\nclass NextSmallestService:\n    \"\"\"Service for finding the second smallest unique element in a list.\"\"\"\n    @staticmethod\n    def find_second_smallest(lst: list[int]) -> int | None:\n        \"\"\"\n        Returns the 2nd smallest unique element of the list.\n        Returns None if there is no such element.\n        \"\"\"\n        unique_sorted_list = ListProcessor.get_unique_sorted_elements(lst)\n\n        if len(unique_sorted_list) < 2:\n            return None\n        else:\n            return unique_sorted_list[1]\n\n# Expose the function directly for convenience.\ndef next_smallest(lst: list[int]) -> int | None:\n    \"\"\"\n    Finds the second smallest unique integer in a list.\n    Returns None if the list has fewer than two unique elements.\n    \"\"\"\n    return NextSmallestService.find_second_smallest(lst)\n\n\n# src/main.py\nfrom src.next_smallest.service import next_smallest\n\ndef main() -> None:\n    \"\"\"Demonstrates the usage of the next_smallest function.\"\"\"\n    test_cases = [\n        ([1, 2, 3, 4, 5], \"Expected: 2\"),\n        ([5, 1, 4, 3, 2], \"Expected: 2\"),\n        ([10, 20, 30], \"Expected: 20\"),\n        ([-5, -1, -10, 0], \"Expected: -1\"),\n        ([], \"Expected: None (empty list)\"),\n        ([1], \"Expected: None (single element)\"),\n        ([1, 1], \"Expected: None (all identical)\"),\n        ([5, 5, 5], \"Expected: None (all identical)\"),\n        ([1, 2], \"Expected: 2\"),\n        ([2, 1], \"