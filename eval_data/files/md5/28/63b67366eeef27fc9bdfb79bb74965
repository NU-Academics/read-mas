           return False\n        return True\n\ndef file_name_check(file_name: str) -> str:\n    \"\"\"Public function to validate a file name and return 'Yes' or 'No'.\n    It uses FileNameValidator to perform the checks.\"\"\"\n    validator = FileNameValidator()\n    if validator.is_valid(file_name):\n        return 'Yes'\n    else:\n        return 'No'\n\n```\n```toml\n# pyproject.toml\n[project]\nname = \"file-name-validator\"\nversion = \"0.1.0\"\ndescription = \"A utility for validating file names based on predefined rules.\"\nauthors = [\n    { name = \"Your Name\", email = \"your.email@example.com\" }\n]\nrequires-python = \">=3.8\"\nlicense = { text = \"MIT\" }\nkeywords = [\"file\", \"validation\", \"utility\"]\n\n[build-system]\nrequires = [\"setuptools>=61.0\"]\nbuild-backend = \"setuptools.build_meta\"\n\n```\n```markdown\n# README.md\n# File Name Validator\n\nA Python utility to validate file names against a predefined set of rules. This ensures consistent naming conventions and helps prevent potential system issues.\n\n## Features\n\n- Validates file names for digit count.\n- Checks for exactly one dot.\n- Ensures the prefix is not empty and starts with a letter.\n- Verifies the file extension against a list of allowed types.\n\n## Installation\n\nThis project can be installed using `pip`.\n\n```bash\npip install .\n```\nOr for editable installation:\n```bash\npip install -e .\n```\n\n## Usage\n\nTo validate a file name, simply call the `file_name_check` function:\n\n```python\nfrom src.file_validator import file_name_check\n\n# Valid example\nprint(file_name_check(\"document.txt\"))  # Output: Yes\n\n# Invalid example\nprint(file_name_check(\"1234_report.exe\")) # Output: No\nprint(file_name_check(\"image.jpg\"))     # Output: No\nprint(file_name_check(\".dll\"))          # Output: No\n```\n\n```"}
{"task_id": "HumanEval/143", "solution": "```python\n# src/prime_checker.py\nclass PrimeChecker:\n    \"\"\"\n    Utility class to check if a number is prime.\n    It provides a method to determine primality for an integer.\n    \"\"\"\n    def is_prime(self, number: int) -> bool:\n        \"\"\"\n        Determines if the given number is a prime number.\n        A prime number is a natural number greater than 1 with no positive divisors other than 1 and itself.\n        \"\"\"\n        if number <= 1:\n            return False\n        if number <= 3:  # 2 and 3 are prime\n            return True\n        if number % 2 == 0 or number % 3 == 0:\n            return False\n        i = 5\n        while i * i <= number:\n            if number % i == 0 or number % (i + 2) == 0:\n                return False\n            i += 6\n        return True\n\n```\n```python\n# src/word_filter_service.py\nfrom src.prime_checker import PrimeChecker\n\nclass WordFilterService:\n    \"\"\"\n    Service to filter words from a sentence based on their length being a prime number.\n    It orchestrates word splitting, primality checking, and rejoining.\n    \"\"\"\n    def __init__(self, prime_checker: PrimeChecker):\n        \"\"\"\n        Initializes the WordFilterService with a PrimeChecker instance.\n        This allows for dependency injection and modularity.\n        \"\"\"\n        self._prime_checker = prime_checker\n\n    def words_in_sentence(self, sentence: str) -> str:\n        \"\"\"\n        Filters words from the input sentence whose lengths are prime numbers.\n        The original order of the words is preserved in the output string.\n        \"\"\"\n        words = sentence.split(' ')\n        filtered_words = []\n        for word in words:\n            if not word:  # Skip empty strings resulting from multiple spaces\n                continue\n            if self._prime_checker.is_prime(len(word)):\n                filtered_words.append(word)\n        return ' '.join(filtered_words)\n\n```"}
{"task_id": "HumanEval/141", "solution": "```python\n# src/file_validator/__init__.py\n# This file can be empty to mark the directory as a Python package.\n\n```\n```python\n# src/file_validator/constants.py\nALLOWED_EXTENSIONS = ['txt', 'exe', 'dll']\n\n```\n```python\n# src/file_validator/validator.py\nfrom .constants import ALLOWED_EXTENSIONS\n\nclass FileNameValidator:\n    \"\"\"Provides methods to validate a file name against predefined rules.\n    This class ensures file names adhere to a specific format.\n    \"\"\"\n\n    def _count_digits(self, name: str) -> int:\n        \"\"\"Counts the number of digits in a given string.\n        This helper method aids in digit count validation.\n        \"\"\"\n        return sum(1 for char in name if char.isdigit())\n\n    def _check_dot_count(self, name: str) -> bool:\n        \"\"\"Checks if the string contains exactly one dot.\n        This is crucial for splitting the file name into prefix and extension.\n        \"\"\"\n        return name.count('.') == 1\n\n    def _check_prefix(self, prefix: str) -> bool:\n        \"\"\"Validates the prefix part of the file name.\n        Ensures it is not empty and starts with a Latin alphabet letter.\n        \"\"\"\n        return bool(prefix) and prefix[0].isalpha()\n\n    def _check_extension(self, extension: str) -> bool:\n        \"\"\"Validates the extension part of the file name.\n        Checks if the extension is present in the list of allowed extensions.\n        \"\"\"\n        return extension in ALLOWED_EXTENSIONS\n\n    def file_name_check(self, file_name: str) -> str:\n        \"\"\"The main public method to validate a given file name.\n        It orchestrates calls to private helper methods to apply all validation rules.\n        \"\"\"\n        if not isinstance(file_name, str):\n            return 'No'\n\n        # Rule: Not more than three digits.\n        if self._count_digits(file_name) > 3:\n            return 'No'\n\n        # Rule: Exactly one dot must be present.\n        if not self._check_dot_count(file_name):\n            return 'No'\n        \n        prefix, extension = file_name.split('.', 1)\n\n        # Rule: Prefix must not be empty and must start with a letter.\n        if not self._check_prefix(prefix):\n            return 'No'\n\n        # Rule: Extension must be one of the allowed types.\n        if not self._check_extension(extension):\n            return 'No'\n\n        return 'Yes'\n\ndef file_name_check(file_name: str) -> str:\n    \"\"\"Convenience function to validate a file name directly.\n    It instantiates FileNameValidator and calls its validation method.\n    \"\"\"\n    validator = FileNameValidator()\n    return validator.file_name_check(file_name)\n\n```"}
{"task_id": "HumanEval/142", "solution": "```python\nclass SumProcessor:\n    \"\"\"\n    A utility class for processing a list of integers based on index-specific rules\n    and calculating their sum.\n    \"\"\"\n\n    @staticmethod\n    def sum_squares(lst: list[int]) -> int:\n        \"\"\"\n        Processes a list of integers, applying conditional transformations based on index.\n        Returns the sum of all processed entries.\n        \"\"\"\n        if not lst:\n            return 0\n\n        # Create a mutable copy to avoid modifying the original list.\n        processed_list = list(lst)\n        total_sum = 0\n\n        for i, num in enumerate(processed_list):\n            if i % 3 == 0:\n                processed_list[i] = num * num\n            elif i % 4 == 0:  # Implies i % 3 != 0 due to precedence rule.\n                processed_list[i] = num * num * num\n            # Else, num remains unchanged in processed_list.\n\n            total_sum += processed_list[i]\n\n        return total_sum\n\n```"}
