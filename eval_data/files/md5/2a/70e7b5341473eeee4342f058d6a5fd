{"task_id": "HumanEval/126", "solution": "```python\ndef is_sorted(lst):\n    \"\"\"\n    Checks if a list of non-negative integers is sorted in ascending order\n    and contains no number appearing more than twice.\n    \"\"\"\n    if len(lst) <= 1:\n        return True\n\n    counts = {}\n    for num in lst:\n        counts[num] = counts.get(num, 0) + 1\n        if counts[num] > 2:\n            return False\n\n    for i in range(len(lst) - 1):\n        if lst[i] > lst[i+1]:\n            return False\n\n    return True\n```"}
{"task_id": "HumanEval/126", "solution": "```python\ndef is_sorted(lst):\n    \"\"\"\n    Given a list of non-negative numbers, return whether or not they are sorted\n    in ascending order and if no number appears more than twice.\n    \"\"\"\n    if len(lst) <= 1:\n        return True\n\n    # Check for ascending order\n    for i in range(len(lst) - 1):\n        if lst[i] > lst[i+1]:\n            return False\n\n    # Check for duplicate constraint (no number appears more than twice)\n    counts = {}\n    for x in lst:\n        counts[x] = counts.get(x, 0) + 1\n        if counts[x] > 2:\n            return False\n\n    return True\n```"}
{"task_id": "HumanEval/128", "solution": "```python\ndef prod_signs(arr: list[int]) -> int | None:\n    \"\"\"\n    Calculates the sum of magnitudes multiplied by the product of signs.\n    Returns None for an empty input array.\n    \"\"\"\n    if not arr:\n        return None\n\n    product_of_signs = 1\n    sum_of_magnitudes = 0\n\n    for num in arr:\n        # Determine the sign of the current number.\n        current_sign = 0\n        if num > 0:\n            current_sign = 1\n        elif num < 0:\n            current_sign = -1\n\n        product_of_signs *= current_sign\n        sum_of_magnitudes += abs(num)\n\n    return product_of_signs * sum_of_magnitudes\n```"}
{"task_id": "HumanEval/128", "solution": "```python\ndef prod_signs(arr):\n    \"\"\"\n    Calculates the sum of magnitudes multiplied by the product of signs for an array of integers.\n    Returns None for an empty array, otherwise the calculated integer value.\n    \"\"\"\n    if not arr:\n        return None\n\n    sum_magnitudes = sum(abs(x) for x in arr)\n\n    product_signs = 1\n    for x in arr:\n        # Determine the sign of the current number\n        if x > 0:\n            current_sign = 1\n        elif x < 0:\n            current_sign = -1\n        else:  # x == 0\n            current_sign = 0\n\n        product_signs *= current_sign\n\n        # Optimization: if product_signs becomes 0, further multiplication won't change it.\n        if product_signs == 0:\n            break\n\n    return sum_magnitudes * product_signs\n```"}
{"task_id": "HumanEval/127", "solution": "```python\nimport math\n\ndef intersection(interval1, interval2):\n    \"\"\"Checks if the intersection length of two intervals is a prime number.\n    Returns \"YES\" if prime, \"NO\" otherwise.\"\"\"\n\n    def is_prime(n: int) -> bool:\n        \"\"\"Determines if a non-negative integer is prime.\"\"\"\n        if n <= 1:\n            return False\n        if n == 2:\n            return True\n        if n % 2 == 0:\n            return False\n        for i in range(3, int(math.sqrt(n)) + 1, 2):\n            if n % i == 0:\n                return False\n        return True\n\n    start1, end1 = interval1\n    start2, end2 = interval2\n\n    max_start = max(start1, start2)\n    min_end = min(end1, end2)\n\n    if max_start > min_end:\n        return \"NO\"\n\n    intersection_length = min_end - max_start\n\n    if is_prime(intersection_length):\n        return \"YES\"\n    else:\n        return \"NO\"\n```"}
{"task_id": "HumanEval/127", "solution": "```python\ndef intersection(interval1, interval2):\n    \"\"\"You are given two intervals,\n    where each interval is a pair of integers. For example, interval = (start, end) = (1, 2).\n    The given intervals are closed which means that the interval (start, end)\n    includes both start and end.\n    For each given interval, it is assumed that its start is less or equal its end.\n    Your task is to determine whether the length of intersection of these two\n    intervals is a prime number.\n    Example, the intersection of the intervals (1, 3), (2, 4) is (2, 3)\n    which its length is 1, which not a prime number.\n    If the length of the intersection is a prime number, return \"YES\",\n    otherwise, return \"NO\".\n    If the two intervals don't intersect, return \"NO\".\n\n\n    [input/output] samples:\n    intersection((1, 2), (2, 3)) ==> \"NO\"\n    intersection((-1, 1), (0, 4)) ==> \"NO\"\n    intersection((-3, -1), (-5, 5)) ==> \"YES\"\n    \"\"\"\n\n    class Interval:\n        \"\"\"Represents a closed integer interval (start, end).\"\"\"\n        def __init__(self, start: int, end: int):\n            self.start = start\n            self.end = end\n\n        def get_length(self) -> int:\n            \"\"\"Calculates the length of the interval. Returns 0 if the interval is effectively empty (start > end).\"\"\"\n            if self.start > self.end:\n                return 0\n            return self.end - self.start + 1\n\n    class IntervalService:\n        \"\"\"Encapsulates the core business logic for interval operations and primality testing.\"\"\"\n        def get_intersection_length(self, interval1_obj: Interval, interval2_obj: Interval) -> int:\n            \"\"\"\n            Calculates the length of the intersection of two Interval objects.\n            Returns 0 if there is no intersection.\n            \"\"\"\n            intersection_start = max(interval1_obj.start, interval2_obj.start)\n            intersection_end = min(interval1_obj.end, interval2_obj.end)\n\n            if intersection_start > intersection_end:\n                return 0\n\n            # Create a temporary interval for the intersection to use its get_length method.\n            intersection_interval = Interval(intersection_start, intersection_end)\n            return intersection_interval.get_length()\n\n        def is_prime(self, n: int) -> bool:\n            \"\"\"Determines if a given non-negative integer is a prime number.\"\"\"\n            if n <= 1:\n                return False\n            if n == 2:\n                return True\n            if n % 2 == 0:\n                return False\n            i = 3\n            while i * i <= n:\n                if n % i == 0:\n                    return False\n                i += 2\n            return True\n\n    # Main logic of the intersection function\n    interval_service = IntervalService()\n\n    # Convert input tuples to Interval objects as per design.\n    interval_obj1 = Interval(interval1[0], interval1[1])\n    interval_obj2 = Interval(interval2[0], interval2[1])\n\n    intersection_length = interval_service.get_intersection_length(interval_obj1, interval_obj2)\n\n    # FR5: If no intersection (length 0), return \"NO\".\n    if intersection_length == 0:\n        return \"NO\"\n\n    # FR4: Check if the intersection length is prime and return \"YES\" or \"NO\".\n    if interval_service.is_prime(intersection_length):\n        return \"YES\"\n    else:\n        return \"NO\"\n\n```"}
{"task_id": "HumanEval/130", "solution": "def tri(n):\n    \"\"\"Calculates the first n + 1 numbers of the Tribonacci sequence.\n    The sequence is defined by specific recurrence relations for even and odd indices.\"\"\"\n\n    sequence = [0] * (n + 1)\n\n    # Base cases: tri(0) and tri(1) are defined.\n    # tri(0) is derived from example output, tri(1) is given.\n    sequence[0] = 1\n    if n >= 1:\n        sequence[1] = 3\n\n    # Calculate subsequent terms using the recurrence relations.\n    for k in range(2, n + 1):\n        if k % 2 == 0:  # k is even\n            # tri(k) = 1 + k / 2, using integer division.\n            sequence[k] = 1 + k // 2\n        else:  # k is odd\n            # tri(k) = tri(k - 1) + tri(k - 2) + tri(k + 1)\n            # For odd k, k+1 is even, so tri(k+1) = 1 + (k+1)/2.\n            sequence[k] = sequence[k - 1] + sequence[k - 2] + (1 + (k + 1) // 2)\n\n    return sequence"}
{"task_id": "HumanEval/131", "solution": "def digits(n):\n    \"\"\"Calculates the product of odd digits in a positive integer `n`.\n    Returns 0 if no odd digits are found.\n    \"\"\"\n    product = 1\n    has_odd_digit = False\n\n    for digit_char in str(n):\n        digit = int(digit_char)\n        if digit % 2 != 0:\n            product *= digit\n            has_odd_digit = True\n\n    if not has_odd_digit:\n        return 0\n    return product"}
{"task_id": "HumanEval/129", "solution": "```python\nclass GridUtils:\n    \"\"\"Utility class for grid operations.\"\"\"\n    @staticmethod\n    def get_neighbors(r: int, c: int, N: int) -> list[tuple[int, int]]:\n        \"\"\"Returns valid adjacent neighbor coordinates for a cell (r, c).\"\"\"\n        neighbors = []\n        directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n\n        for dr, dc in directions:\n            nr, nc = r + dr, c + dc\n            if 0 <= nr < N and 0 <= nc < N:\n                neighbors.append((nr, nc))\n        return neighbors\n\nclass Path:\n    \"\"\"Represents a path through the grid with values and coordinates.\"\"\"\n    def __init__(self, values: list[int] = None, coords: list[tuple[int, int]] = None):\n        \"\"\"Initializes a Path object.\"\"\"\n        self.values = values if values is not None else []\n        self.coords = coords if coords is not None else []\n\n    def add_step(self, value: int, r: int, c: int) -> None:\n        \"\"\"Extends the path with a new cell's value and coordinates.\"\"\"\n        self.values.append(value)\n        self.coords.append((r, c))\n\n    def get_values(self) -> list[int]:\n        \"\"\"Returns the list of values in the path.\"\"\"\n        return self.values\n\n    def __lt__(self, other: 'Path') -> bool:\n        \"\"\"Compares two paths lexicographically.\"\"\"\n        # Python's list comparison handles lexicographical comparison directly.\n        return self.values < other.values\n\nclass MinPathFinder:\n    \"\"\"Orchestrates pathfinding to find the lexicographically smallest path.\"\"\"\n    def __init__(self, grid: list[list[int]], k: int):\n        \"\"\"Initializes the MinPathFinder with the grid and path length k.\"\"\"\n        self.grid = grid\n        self.N = len(grid)\n        self.k = k\n        self.min_path_values: list[int] | None = None\n\n    def find_min_path(self) -> list[int]:\n        \"\"\"Iterates through all starting cells and explores paths.\"\"\"\n        for r_start in range(self.N):\n            for c_start in range(self.N):\n                initial_path = Path([self.grid[r_start][c_start]], [(r_start, c_start)])\n                self._explore_paths(r_start, c_start, initial_path)\n        return self.min_path_values\n\n    def _explore_paths(self, r: int, c: int, current_path: Path) -> None:\n        \"\"\"Recursively explores paths of length k from the current cell.\"\"\"\n        # Base case: path length k reached.\n        if len(current_path.values) == self.k:\n            if self.min_path_values is None or current_path.get_values() < self.min_path_values:\n                self.min_path_values = current_path.get_values()\n            return\n\n        # Recursive step: explore neighbors.\n        neighbors = GridUtils.get_neighbors(r, c, self.N)\n        for nr, nc in neighbors:\n            # Create a new Path object for each branch to avoid modifying shared state.\n            next_path = Path(list(current_path.values), list(current_path.coords))\n            next_path.add_step(self.grid[nr][nc], nr, nc)\n            self._explore_paths(nr, nc, next_path)\n\ndef minPath(grid: list[list[int]], k: int) -> list[int]:\n    \"\"\"\n    Finds the lexicographically smallest path of length k in the grid.\n    This function uses helper classes to manage grid operations and path comparisons.\n    \"\"\"\n    finder = MinPathFinder(grid, k)\n    return finder.find_min_path()\n```\n"}
{"task_id": "HumanEval/131", "solution": "```python\ndef digits(n):\n    \"\"\"Given a positive integer n, return the product of its odd digits.\n    Return 0 if no odd digits are found.\"\"\"\n\n    product = 1\n    has_odd_digit = False\n\n    # Convert the integer to a string to iterate through its digits\n    for digit_char in str(n):\n        digit = int(digit_char)\n        # If the digit is odd, multiply it into the product\n        if digit % 2 != 0:\n            product *= digit\n            has_odd_digit = True\n\n    # Return 0 if no odd digits were found, otherwise return the calculated product\n    return product if has_odd_digit else 0\n```"}
