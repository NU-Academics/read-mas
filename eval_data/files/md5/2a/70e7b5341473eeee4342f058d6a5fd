{"task_id": "HumanEval/6", "solution": "```python\nfrom typing import List\n\n\ndef parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\"\n    Parses a string of space-separated groups of parentheses and determines\n    the deepest level of nesting for each group.\n    \"\"\"\n\n    def _calculate_max_nesting_for_group(group_string: str) -> int:\n        \"\"\"\n        Calculates the deepest nesting level for a single parenthesis group string.\n        It tracks the maximum counter value, ignoring characters other than '(' and ')'.\n        \"\"\"\n        current_nesting = 0\n        max_nesting = 0\n        for char in group_string:\n            if char == '(':\n                current_nesting += 1\n                max_nesting = max(max_nesting, current_nesting)\n            elif char == ')':\n                current_nesting -= 1\n        return max_nesting\n\n    if not paren_string.strip():\n        return []\n\n    groups = paren_string.split(' ')\n    nesting_levels = []\n    for group_string in groups:\n        if group_string:  # Only process non-empty group strings\n            nesting_levels.append(_calculate_max_nesting_for_group(group_string))\n    return nesting_levels\n```"}
{"task_id": "HumanEval/9", "solution": "```python\nfrom typing import List\n\n\ndef rolling_max(numbers: List[int]) -> List[int]:\n    \"\"\" From a given list of integers, generate a list of rolling maximum element found until given moment\n    in the sequence.\n    >>> rolling_max([1, 2, 3, 2, 3, 4, 2])\n    [1, 2, 3, 3, 3, 4, 4]\n    \"\"\"\n    rolling_max_list = []\n    current_max = float('-inf')\n\n    for number in numbers:\n        current_max = max(current_max, number)\n        rolling_max_list.append(current_max)\n\n    return rolling_max_list\n```"}
{"task_id": "HumanEval/9", "solution": "from typing import List\n\n\ndef rolling_max(numbers: List[int]) -> List[int]:\n    \"\"\"\n    From a given list of integers, generate a list of rolling maximum element found until given moment\n    in the sequence.\n    \"\"\"\n    if not numbers:\n        return []\n\n    rolling_maxes: List[int] = []\n    current_max: int = numbers[0]\n\n    for num in numbers:\n        if num > current_max:\n            current_max = num\n        rolling_maxes.append(current_max)\n\n    return rolling_maxes"}
{"task_id": "HumanEval/6", "solution": "```python\nfrom typing import List\n\n\ndef parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\" Input to this function is a string represented multiple groups for nested parentheses separated by spaces.\n    For each of the group, output the deepest level of nesting of parentheses.\n    E.g. (()()) has maximum two levels of nesting while ((())) has three.\n\n    >>> parse_nested_parens('(()()) ((())) () ((())()())')\n    [2, 3, 1, 3]\n    \"\"\"\n\n    def _calculate_max_depth_helper(group: str) -> int:\n        \"\"\"Calculates the deepest nesting level for a single group of parentheses.\"\"\"\n        max_depth = 0\n        current_depth = 0\n        for char in group:\n            if char == '(':\n                current_depth += 1\n                max_depth = max(max_depth, current_depth)\n            elif char == ')':\n                current_depth -= 1\n                current_depth = max(0, current_depth) # Prevents current_depth from dropping below zero.\n        return max_depth\n\n    if not paren_string.strip():\n        return []\n\n    groups = paren_string.split(' ')\n    result = []\n    for group in groups:\n        if group: # Filters out empty strings from multiple spaces, ensuring only actual groups are processed.\n            result.append(_calculate_max_depth_helper(group))\n    return result\n```"}
{"task_id": "HumanEval/10", "solution": "```python\ndef is_palindrome(string: str) -> bool:\n    \"\"\"Test if given string is a palindrome.\n    It compares the string with its reverse.\"\"\"\n    return string == string[::-1]\n\n\ndef make_palindrome(string: str) -> str:\n    \"\"\"Finds the shortest palindrome that begins with a supplied string.\n    It identifies the longest palindromic postfix and appends the reversed prefix to the original string.\"\"\"\n    if not string:\n        return \"\"\n\n    # Find the longest postfix of the supplied string that is a palindrome.\n    longest_palindromic_postfix_start_index = len(string)\n    for i in range(len(string)):\n        postfix = string[i:]\n        if is_palindrome(postfix):\n            longest_palindromic_postfix_start_index = i\n            break\n\n    # Append to the end of the string the reverse of the string prefix\n    # that comes before the palindromic suffix.\n    prefix_to_reverse = string[:longest_palindromic_postfix_start_index]\n    reversed_prefix = prefix_to_reverse[::-1]\n    return string + reversed_prefix\n```"}
{"task_id": "HumanEval/12", "solution": "```python\nfrom typing import List, Optional\n\n\ndef longest(strings: List[str]) -> Optional[str]:\n    \"\"\"\n    Finds the longest string in a list, returning the first one if multiple have max length.\n    Returns None if the input list is empty.\n    \"\"\"\n    if not strings:\n        return None\n\n    longest_str: Optional[str] = None\n    max_length: int = -1\n\n    for s in strings:\n        if longest_str is None or len(s) > max_length:\n            longest_str = s\n            max_length = len(s)\n    return longest_str\n```"}
{"task_id": "HumanEval/11", "solution": "```python\nfrom typing import List\n\n\ndef string_xor(a: str, b: str) -> str:\n    \"\"\" Input are two strings a and b consisting only of 1s and 0s.\n    Perform binary XOR on these inputs and return result also as a string.\n    \"\"\"\n    max_len = max(len(a), len(b))\n    padded_a = a.zfill(max_len)\n    padded_b = b.zfill(max_len)\n\n    result_bits = []\n    for i in range(max_len):\n        if padded_a[i] != padded_b[i]:\n            result_bits.append('1')\n        else:\n            result_bits.append('0')\n    return \"\".join(result_bits)\n```"}
{"task_id": "HumanEval/10", "solution": "```python\ndef is_palindrome(string: str) -> bool:\n    \"\"\" Test if given string is a palindrome. \"\"\"\n    return string == string[::-1]\n\n\ndef make_palindrome(string: str) -> str:\n    \"\"\"\n    Find the shortest palindrome that begins with a supplied string.\n    The algorithm finds the longest palindromic postfix and appends the reversed prefix.\n    \"\"\"\n    if not string:\n        return \"\"\n\n    longest_palindromic_postfix_len = 0\n    # Iterate from the beginning to find the longest palindromic postfix.\n    # The first one found will be the longest as we check from string[0:] onwards.\n    for i in range(len(string)):\n        postfix = string[i:]\n        if is_palindrome(postfix):\n            longest_palindromic_postfix_len = len(postfix)\n            break\n\n    # The prefix that comes before the longest palindromic postfix.\n    prefix_to_reverse = string[:len(string) - longest_palindromic_postfix_len]\n    reversed_prefix = prefix_to_reverse[::-1]\n\n    return string + reversed_prefix\n```"}
{"task_id": "HumanEval/11", "solution": "```python\nfrom typing import List\n\n\ndef string_xor(a: str, b: str) -> str:\n    \"\"\" Input are two strings a and b consisting only of 1s and 0s.\n    Perform binary XOR on these inputs and return result also as a string.\n    Raises ValueError: If inputs are not valid binary strings, are empty, or are of different lengths.\n    >>> string_xor('010', '110')\n    '100'\n    \"\"\"\n    if not a:\n        raise ValueError(\"Input string 'a' cannot be empty.\")\n    if not b:\n        raise ValueError(\"Input string 'b' cannot be empty.\")\n\n    if not all(c in '01' for c in a):\n        raise ValueError(\"Input string 'a' must contain only '0's and '1's.\")\n    if not all(c in '01' for c in b):\n        raise ValueError(\"Input string 'b' must contain only '0's and '1's.\")\n\n    if len(a) != len(b):\n        raise ValueError(\"Input strings must be of equal length.\")\n\n    result = []\n    for i in range(len(a)):\n        if a[i] == b[i]:\n            result.append('0')\n        else:\n            result.append('1')\n    return \"\".join(result)\n\n```"}
{"task_id": "HumanEval/12", "solution": "```python\nfrom typing import List, Optional\n\n\ndef longest(strings: List[str]) -> Optional[str]:\n    \"\"\"\n    Out of list of strings, return the longest one. Return the first one in case of multiple\n    strings of the same length. Return None in case the input list is empty.\n    \"\"\"\n    if not strings:\n        return None\n\n    longest_str: Optional[str] = None\n    max_length: int = -1\n\n    for s in strings:\n        if longest_str is None or len(s) > max_length:\n            longest_str = s\n            max_length = len(s)\n    return longest_str\n```"}
{"task_id": "HumanEval/13", "solution": "```python\ndef greatest_common_divisor(a: int, b: int) -> int:\n    \"\"\"\n    Return the greatest common divisor of two integers a and b.\n    It handles zero and negative inputs.\n    \"\"\"\n    a = abs(a)\n    b = abs(b)\n\n    while b:\n        a, b = b, a % b\n    return a\n```"}
{"task_id": "HumanEval/13", "solution": "```python\ndef greatest_common_divisor(a: int, b: int) -> int:\n    \"\"\" Return a greatest common divisor of two integers a and b\n    >>> greatest_common_divisor(3, 5)\n    1\n    >>> greatest_common_divisor(25, 15)\n    5\n    \"\"\"\n    # Convert inputs to their absolute values, as GCD is non-negative.\n    # Apply the Euclidean algorithm for efficient calculation.\n    a = abs(a)\n    b = abs(b)\n\n    while b:\n        a, b = b, a % b\n    return a\n```"}
