{"task_id": "HumanEval/147", "solution": "```python\ndef get_max_triples(n):\n    \"\"\"\n    Calculates the number of triples (a[i], a[j], a[k]) from a generated array\n    whose sum is a multiple of 3.\n    \"\"\"\n\n    def combinations(n_comb, k_comb):\n        \"\"\"Calculates \"n choose k\", returning 0 if k is out of range.\"\"\"\n        if k_comb < 0 or k_comb > n_comb:\n            return 0\n        if k_comb == 0 or k_comb == n_comb:\n            return 1\n        # Optimization for C(n, k) = C(n, n-k)\n        if k_comb > n_comb // 2:\n            k_comb = n_comb - k_comb\n\n        # Specific calculation for k=3, as needed for this problem\n        if k_comb == 3:\n            if n_comb < 3:\n                return 0\n            return (n_comb * (n_comb - 1) * (n_comb - 2)) // 6\n\n        # General case, though not strictly needed for this problem (k is always 3)\n        res = 1\n        for i in range(k_comb):\n            res = res * (n_comb - i) // (i + 1)\n        return res\n\n    # Handle cases where n is too small to form a triple (i < j < k requires at least 3 elements)\n    if n < 3:\n        return 0\n\n    count_mod_0 = 0\n    count_mod_1 = 0\n\n    # Based on a[i] = i*(i-1) + 1, we analyze a[i] % 3:\n    # If i % 3 == 0: a[i] = (3k)(3k-1) + 1  => a[i] % 3 = 1\n    # If i % 3 == 1: a[i] = (3k+1)(3k) + 1  => a[i] % 3 = 1\n    # If i % 3 == 2: a[i] = (3k+2)(3k+1) + 1 = 9k^2 + 9k + 2 + 1 = 9k^2 + 9k + 3 => a[i] % 3 = 0\n    # So, a[i] % 3 is 0 if i % 3 == 2, and 1 otherwise.\n    for i in range(1, n + 1):\n        if i % 3 == 2:\n            count_mod_0 += 1\n        else:  # i % 3 == 0 or i % 3 == 1\n            count_mod_1 += 1\n\n    # Triples sum to a multiple of 3 if:\n    # 1. All three elements have a remainder of 0 when divided by 3 (0 + 0 + 0 = 0)\n    # 2. All three elements have a remainder of 1 when divided by 3 (1 + 1 + 1 = 3)\n    num_triples_mod_0 = combinations(count_mod_0, 3)\n    num_triples_mod_1 = combinations(count_mod_1, 3)\n\n    return num_triples_mod_0 + num_triples_mod_1\n\n```"}
{"task_id": "HumanEval/148", "solution": "```python\nfrom typing import NamedTuple, List, Dict, Tuple, Optional\n\nclass Planet(NamedTuple):\n    \"\"\"A planet with its name and orbital order.\"\"\"\n    name: str\n    order: int\n\nSOLAR_SYSTEM_PLANETS: Tuple[str, ...] = (\n    \"Mercury\", \"Venus\", \"Earth\", \"Mars\", \"Jupiter\", \"Saturn\", \"Uranus\", \"Neptune\"\n)\n\nclass PlanetRepository:\n    \"\"\"Manages access to static solar system planet data.\"\"\"\n    def __init__(self):\n        self._planets: List[Planet] = [\n            Planet(name, order) for order, name in enumerate(SOLAR_SYSTEM_PLANETS)\n        ]\n        self._planet_map: Dict[str, Planet] = {planet.name: planet for planet in self._planets}\n\n    def get_planet_by_name(self, name: str) -> Optional[Planet]:\n        \"\"\"Retrieves a Planet object by its name.\"\"\"\n        return self._planet_map.get(name)\n\n    def get_planets_in_order(self) -> List[Planet]:\n        \"\"\"Returns all Planet objects, sorted by orbital order.\"\"\"\n        return list(self._planets)\n\nclass PlanetService:\n    \"\"\"Provides business logic for planet operations.\"\"\"\n    def __init__(self, planet_repository: PlanetRepository):\n        self._planet_repository = planet_repository\n\n    def get_planets_between(self, planet1_name: str, planet2_name: str) -> Tuple[str, ...]:\n        \"\"\"\n        Finds planets strictly between two given planets, sorted by Sun proximity.\n        Returns an empty tuple for invalid inputs or no planets between.\n        \"\"\"\n        planet1 = self._planet_repository.get_planet_by_name(planet1_name)\n        planet2 = self._planet_repository.get_planet_by_name(planet2_name)\n\n        if not planet1 or not planet2:\n            return ()\n\n        start_order = min(planet1.order, planet2.order)\n        end_order = max(planet1.order, planet2.order)\n\n        if end_order - start_order <= 1:\n            return ()\n\n        all_planets = self._planet_repository.get_planets_in_order()\n        intermediate_planets = [\n            p.name for p in all_planets\n            if start_order < p.order < end_order\n        ]\n        return tuple(intermediate_planets)\n\n_planet_repository_instance = PlanetRepository()\n_planet_service_instance = PlanetService(planet_repository=_planet_repository_instance)\n\ndef bf(planet1, planet2):\n    '''\n    There are eight planets in our solar system: the closerst to the Sun\n    is Mercury, the next one is Venus, then Earth, Mars, Jupiter, Saturn,\n    Uranus, Neptune.\n    Write a function that takes two planet names as strings planet1 and planet2.\n    The function should return a tuple containing all planets whose orbits are\n    located between the orbit of planet1 and the orbit of planet2, sorted by\n    the proximity to the sun.\n    The function should return an empty tuple if planet1 or planet2\n    are not correct planet names.\n    Examples\n    bf(\"Jupiter\", \"Neptune\") ==> (\"Saturn\", \"Uranus\")\n    bf(\"Earth\", \"Mercury\") ==> (\"Venus\")\n    bf(\"Mercury\", \"Uranus\") ==> (\"Venus\", \"Earth\", \"Mars\", \"Jupiter\", \"Saturn\")\n    '''\n    return _planet_service_instance.get_planets_between(planet1, planet2)\n```"}
{"task_id": "HumanEval/150", "solution": "```python\nimport math\n\ndef x_or_y(n, x, y):\n    \"\"\"Returns x if n is a prime number, otherwise returns y. It implements a standard primality test.\"\"\"\n\n    def is_prime_inline(num):\n        if num <= 1:\n            return False\n        if num == 2:\n            return True\n        if num % 2 == 0:\n            return False\n        # Check odd divisors up to the square root of num\n        for i in range(3, int(math.sqrt(num)) + 1, 2):\n            if num % i == 0:\n                return False\n        return True\n\n    if is_prime_inline(n):\n        return x\n    else:\n        return y\n```"}
{"task_id": "HumanEval/150", "solution": "```python\nimport math\n\ndef x_or_y(n, x, y):\n    \"\"\"Returns x if n is a prime number, otherwise returns y.\n    Performs a primality check on n using an optimized trial division method.\n    \"\"\"\n    is_prime_result = False\n\n    if n <= 1:\n        is_prime_result = False\n    elif n == 2:\n        is_prime_result = True\n    elif n % 2 == 0:\n        # All other even numbers greater than 2 are not prime\n        is_prime_result = False\n    else:\n        # Check divisibility by odd numbers up to the square root of n\n        limit = int(math.sqrt(n))\n        is_prime_result = True # Assume prime until a divisor is found\n        for i in range(3, limit + 1, 2):\n            if n % i == 0:\n                is_prime_result = False\n                break\n\n    if is_prime_result:\n        return x\n    else:\n        return y\n```"}
{"task_id": "HumanEval/149", "solution": "```python\nclass StringFilter:\n    \"\"\"Filters lists of strings based on length criteria.\n    It provides a method to retain only strings with even lengths.\"\"\"\n    def filter_odd_length(self, strings: list[str]) -> list[str]:\n        \"\"\"Retains only strings with even lengths from the input list.\n        This method returns a new list without modifying the original.\"\"\"\n        return [s for s in strings if len(s) % 2 == 0]\n\nclass StringSorter:\n    \"\"\"Sorts lists of strings by length and then alphabetically.\n    It provides a method to apply a dual-key sorting logic.\"\"\"\n    def sort_by_length_and_alpha(self, strings: list[str]) -> list[str]:\n        \"\"\"Sorts strings primarily by length in ascending order, then alphabetically for equal lengths.\n        This method returns a new list with the sorted strings.\"\"\"\n        return sorted(strings, key=lambda s: (len(s), s))\n\ndef sorted_list_sum(lst: list[str]) -> list[str]:\n    \"\"\"Processes a list of strings by first removing those with odd lengths, then sorting the remainder.\n    The sorting is done first by string length (ascending), and then alphabetically for strings of the same length.\"\"\"\n    string_filter = StringFilter()\n    string_sorter = StringSorter()\n\n    filtered_list = string_filter.filter_odd_length(lst)\n    result = string_sorter.sort_by_length_and_alpha(filtered_list)\n\n    return result\n```\n"}
