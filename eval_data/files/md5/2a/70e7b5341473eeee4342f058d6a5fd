{"task_id": "HumanEval/62", "solution": "def derivative(xs: list):\n    \"\"\"xs represent coefficients of a polynomial in ascending powers. Returns the coefficients of its derivative in the same form.\"\"\"\n    if not xs or len(xs) == 1:\n        return []\n\n    # For a_i * x^i, the derivative is i * a_i * x^(i-1).\n    # The new list starts from the coefficient of x^0 (originally the x^1 term).\n    return [i * xs[i] for i in range(1, len(xs))]"}
{"task_id": "HumanEval/62", "solution": "```python\ndef derivative(xs: list) -> list:\n    \"\"\"Given a list of coefficients `xs` representing a polynomial `xs[0] + xs[1]*x + ...`, this function returns the coefficients of its derivative. It handles empty and constant polynomials according to mathematical rules.\"\"\"\n    if not xs or len(xs) == 1:\n        return []\n\n    derivative_coefficients = []\n    for i in range(1, len(xs)):\n        derivative_coefficients.append(i * xs[i])\n\n    return derivative_coefficients\n```"}
{"task_id": "HumanEval/63", "solution": "```python\n_fibfib_cache = {}\n\ndef fibfib(n: int) -> int:\n    \"\"\"Computes the n-th FibFib number using memoization.\n    The sequence is defined as fibfib(0)=0, fibfib(1)=0, fibfib(2)=1, and fibfib(n) = fibfib(n-1) + fibfib(n-2) + fibfib(n-3) for n > 2.\n    \"\"\"\n    if n in _fibfib_cache:\n        return _fibfib_cache[n]\n\n    if n == 0:\n        result = 0\n    elif n == 1:\n        result = 0\n    elif n == 2:\n        result = 1\n    else:\n        result = fibfib(n - 1) + fibfib(n - 2) + fibfib(n - 3)\n\n    _fibfib_cache[n] = result\n    return result\n```"}
{"task_id": "HumanEval/64", "solution": "def vowels_count(s):\n    \"\"\"Counts vowels in a string, where 'y' is a vowel only at the end.\n    Vowels are 'a', 'e', 'i', 'o', 'u', case-insensitive.\n    \"\"\"\n    STANDARD_VOWELS = {'a', 'e', 'i', 'o', 'u'}\n\n    if not s:\n        return 0\n\n    normalized_s = s.lower()\n    vowel_count = 0\n\n    for char in normalized_s:\n        if char in STANDARD_VOWELS:\n            vowel_count += 1\n\n    if normalized_s.endswith('y'):\n        vowel_count += 1\n\n    return vowel_count"}
{"task_id": "HumanEval/64", "solution": "```python\ndef vowels_count(s: str) -> int:\n    \"\"\"Counts vowels in a string, where 'a', 'e', 'i', 'o', 'u' are always vowels. 'y' is a vowel only if it is the last character of the word.\"\"\"\n    vowel_count = 0\n    standard_vowels = {'a', 'e', 'i', 'o', 'u'}\n    word_length = len(s)\n\n    for i, char in enumerate(s):\n        lower_char = char.lower()\n        if lower_char in standard_vowels:\n            vowel_count += 1\n        elif lower_char == 'y' and i == word_length - 1:\n            vowel_count += 1\n    return vowel_count\n```"}
{"task_id": "HumanEval/63", "solution": "```python\ndef fibfib(n: int):\n    \"\"\"The FibFib number sequence is a sequence similar to the Fibbonacci sequnece that's defined as follows:\n    fibfib(0) == 0\n    fibfib(1) == 0\n    fibfib(2) == 1\n    fibfib(n) == fibfib(n-1) + fibfib(n-2) + fibfib(n-3).\n    Please write a function to efficiently compute the n-th element of the fibfib number sequence.\n    >>> fibfib(1)\n    0\n    >>> fibfib(5)\n    4\n    >>> fibfib(8)\n    24\n    \"\"\"\n    if n == 0:\n        return 0\n    if n == 1:\n        return 0\n    if n == 2:\n        return 1\n\n    # Use dynamic programming to compute fibfib(n) for n > 2 efficiently.\n    # This avoids recursion depth issues and ensures O(n) time complexity.\n    dp = [0] * (n + 1)\n    dp[0] = 0\n    dp[1] = 0\n    dp[2] = 1\n\n    for i in range(3, n + 1):\n        dp[i] = dp[i - 1] + dp[i - 2] + dp[i - 3]\n\n    return dp[n]\n```"}
