{"task_id": "HumanEval/122", "solution": "```python\ndef add_elements(arr, k):\n    \"\"\"\n    Given a non-empty array of integers arr and an integer k, return\n    the sum of the elements with at most two digits from the first k elements of arr.\n\n    Example:\n\n        Input: arr = [111,21,3,4000,5,6,7,8,9], k = 4\n        Output: 24 # sum of 21 + 3\n\n    Constraints:\n        1. 1 <= len(arr) <= 100\n        2. 1 <= k <= len(arr)\n    \"\"\"\n    total_sum = 0\n    for i in range(k):\n        element = arr[i]\n        if -99 <= element <= 99:  # Checks if the absolute value of the element is at most two digits.\n            total_sum += element\n    return total_sum\n```"}
{"task_id": "HumanEval/123", "solution": "```python\ndef get_odd_collatz(n: int) -> list[int]:\n    \"\"\"\n    Given a positive integer n, return a sorted list that has the odd numbers in collatz sequence.\n    The list will contain unique odd numbers from the sequence, sorted in increasing order.\n    \"\"\"\n    odd_numbers = set()\n    current_num = n\n\n    while current_num != 1:\n        if current_num % 2 != 0:\n            odd_numbers.add(current_num)\n\n        if current_num % 2 == 0:\n            current_num //= 2\n        else:\n            current_num = (3 * current_num) + 1\n\n    odd_numbers.add(1) # The number 1 is always in the sequence and is odd.\n\n    return sorted(list(odd_numbers))\n```"}
{"task_id": "HumanEval/123", "solution": "```python\ndef get_odd_collatz(n):\n    \"\"\"\n    Given a positive integer n, return a sorted list that has the odd numbers in collatz sequence.\n    The Collatz conjecture is a conjecture in mathematics that concerns a sequence defined\n    as follows: start with any positive integer n.\n    \"\"\"\n    if n == 1:\n        return [1]\n\n    odd_numbers_in_sequence = set()\n    current_term = n\n\n    while current_term != 1:\n        if current_term % 2 != 0:\n            odd_numbers_in_sequence.add(current_term)\n\n        if current_term % 2 == 0:\n            current_term = current_term // 2\n        else:\n            current_term = 3 * current_term + 1\n\n    # The sequence always terminates at 1, which is an odd number.\n    odd_numbers_in_sequence.add(1)\n\n    return sorted(list(odd_numbers_in_sequence))\n```"}
{"task_id": "HumanEval/125", "solution": "```python\ndef split_words(txt):\n    \"\"\"\n    Parses a text string: first by whitespace, then by commas, else counts odd-ordered lowercase letters.\n    Handles prioritization of splitting rules as specified.\n    \"\"\"\n    if any(c.isspace() for c in txt):\n        return txt.split()\n    elif ',' in txt:\n        return txt.split(',')\n    else:\n        count = 0\n        for char in txt:\n            if 'a' <= char <= 'z':\n                order = ord(char) - ord('a')\n                if order % 2 != 0:\n                    count += 1\n        return count\n```"}
{"task_id": "HumanEval/124", "solution": "```python\nimport re\n\ndef valid_date(date: str) -> bool:\n    \"\"\"\n    Validates a given date string based on specified rules.\n    Returns True if the date is valid, False otherwise.\n    \"\"\"\n\n    # Constants for date validation rules.\n    DAYS_IN_MONTH_31 = [1, 3, 5, 7, 8, 10, 12]\n    DAYS_IN_MONTH_30 = [4, 6, 9, 11]\n    DAYS_IN_FEBRUARY = 29\n\n    def _is_not_empty(date_string: str) -> bool:\n        \"\"\"Checks if the input date string is not empty.\"\"\"\n        return bool(date_string)\n\n    def _is_correct_format(date_string: str) -> tuple[int, int, int] | None:\n        \"\"\"Parses a date string in 'mm-dd-yyyy' format.\"\"\"\n        match = re.fullmatch(r'(\\d{2})-(\\d{2})-(\\d{4})', date_string)\n        if not match:\n            return None\n        month = int(match.group(1))\n        day = int(match.group(2))\n        year = int(match.group(3))\n        return (month, day, year)\n\n    def _is_valid_month(month_val: int) -> bool:\n        \"\"\"Validates if the month is within the range [1, 12].\"\"\"\n        return 1 <= month_val <= 12\n\n    def _is_valid_day(day_val: int, month_val: int) -> bool:\n        \"\"\"Validates if the day is within the correct range for the given month.\"\"\"\n        if not (1 <= day_val):\n            return False\n\n        if month_val in DAYS_IN_MONTH_31:\n            return day_val <= 31\n        elif month_val in DAYS_IN_MONTH_30:\n            return day_val <= 30\n        elif month_val == 2:\n            return day_val <= DAYS_IN_FEBRUARY\n        else:\n            return False\n\n    if not _is_not_empty(date):\n        return False\n\n    parsed_date = _is_correct_format(date)\n    if parsed_date is None:\n        return False\n\n    month, day, _ = parsed_date\n\n    if not _is_valid_month(month):\n        return False\n\n    if not _is_valid_day(day, month):\n        return False\n\n    return True\n```"}
{"task_id": "HumanEval/125", "solution": "import re\n\ndef split_words(txt: str) -> list[str] | int:\n    \"\"\"\n    Splits text by whitespace or commas, or counts odd-order lowercase letters.\n    The splitting priority is whitespace first, then commas.\n    \"\"\"\n\n    def _count_odd_order_letters(text_to_count: str) -> int:\n        \"\"\"Counts lowercase letters with an odd 0-indexed alphabetical order.\n        For example, 'a' is 0 (even), 'b' is 1 (odd).\"\"\"\n        count = 0\n        for char in text_to_count:\n            if 'a' <= char <= 'z':\n                order = ord(char) - ord('a')\n                if order % 2 != 0:\n                    count += 1\n        return count\n\n    if re.search(r'\\s', txt):\n        return re.split(r'\\s+', txt)\n    elif ',' in txt:\n        return txt.split(',')\n    else:\n        return _count_odd_order_letters(txt)"}
