{"task_id": "HumanEval/109", "solution": "```python\ndef is_sorted(arr):\n    return all(arr[i] <= arr[i+1] for i in range(len(arr) - 1))\n\ndef right_shift(arr):\n    if not arr:\n        return []\n    return [arr[-1]] + arr[:-1]\n\ndef move_one_ball(arr):\n    \"\"\"Determines if an array can be sorted by right shift operations.\n    Returns True if sorted, False otherwise, and True for an empty array.\n    \"\"\"\n    if not arr:\n        return True\n\n    sorted_arr = sorted(arr)\n    current_arr = list(arr) # Create a mutable copy to perform shifts.\n\n    n = len(arr)\n    for _ in range(n): # Iterate through all N possible shifts.\n        if current_arr == sorted_arr:\n            return True\n        current_arr = right_shift(current_arr)\n\n    return False\n```"}
{"task_id": "HumanEval/112", "solution": "```python\ndef reverse_delete(s, c):\n    \"\"\"\n    Deletes characters from s found in c, then checks if the result is a palindrome.\n    Returns the modified string and the palindrome check result.\n    \"\"\"\n\n    def _delete_chars(s: str, chars_to_delete: str) -> str:\n        \"\"\"\n        Deletes all characters from s that are present in chars_to_delete.\n        \"\"\"\n        result_chars = []\n        chars_set = set(chars_to_delete)\n        for char_s in s:\n            if char_s not in chars_set:\n                result_chars.append(char_s)\n        return \"\".join(result_chars)\n\n    def _is_palindrome(s: str) -> bool:\n        \"\"\"\n        Checks if a string is a palindrome.\n        \"\"\"\n        return s == s[::-1]\n\n    modified_s = _delete_chars(s, c)\n    is_palindrome = _is_palindrome(modified_s)\n    return (modified_s, is_palindrome)\n```"}
{"task_id": "HumanEval/112", "solution": "```python\ndef is_palindrome(text: str) -> bool:\n    \"\"\"Checks if a given string is a palindrome.\n    It compares the string with its reversed version.\"\"\"\n    return text == text[::-1]\n\ndef reverse_delete(s: str, c: str) -> tuple[str, bool]:\n    \"\"\"Deletes characters from 's' present in 'c', then checks if the result is a palindrome.\n    Returns the filtered string and a boolean indicating if it's a palindrome.\"\"\"\n    chars_to_delete = set(c)\n    filtered_s_chars = []\n    for char_s in s:\n        if char_s not in chars_to_delete:\n            filtered_s_chars.append(char_s)\n\n    filtered_s = \"\".join(filtered_s_chars)\n\n    is_pal = is_palindrome(filtered_s)\n    return (filtered_s, is_pal)\n```\n"}
{"task_id": "HumanEval/111", "solution": "def histogram(test: str) -> dict[str, int]:\n    \"\"\"Given a string representing space-separated lowercase letters, return a dictionary\n    of the letter with the most repetition and containing the corresponding count.\n    If several letters have the same occurrence, return all of them.\n    \"\"\"\n    if not test:\n        return {}\n\n    letters = test.split()\n\n    # Filter out any empty strings that might result from multiple spaces.\n    actual_letters = [letter for letter in letters if letter]\n\n    if not actual_letters: # Handle cases like \"   \"\n        return {}\n\n    # Manually count letter occurrences.\n    letter_counts = {}\n    for letter in actual_letters:\n        letter_counts[letter] = letter_counts.get(letter, 0) + 1\n\n    # Find the maximum occurrence count.\n    if not letter_counts:\n        return {}\n    max_count = 0\n    for count in letter_counts.values():\n        if count > max_count:\n            max_count = count\n\n    # Filter for letters that have the maximum occurrence count.\n    result = {letter: count for letter, count in letter_counts.items() if count == max_count}\n    return result"}
{"task_id": "HumanEval/111", "solution": "```python\nimport collections\n\ndef histogram(test):\n    \"\"\"Given a string representing space-separated lowercase letters, return a dictionary\n    of the most frequent letters and their counts.\n    If several letters have the same occurrence, return all of them.\n    \"\"\"\n    # Handles empty string or string with only spaces, returning an empty dictionary.\n    if not test.strip():\n        return {}\n\n    # Parses the input string into individual tokens by splitting on spaces and filtering out empty strings.\n    letters = [token for token in test.split(' ') if token]\n\n    # If no valid tokens remain after parsing (e.g., input was only spaces), return an empty dictionary.\n    if not letters:\n        return {}\n\n    # Counts the occurrences of each unique token using collections.Counter.\n    frequencies = collections.Counter(letters)\n\n    # Identifies the maximum frequency among all counted tokens.\n    max_freq = 0\n    if frequencies:\n        max_freq = max(frequencies.values())\n\n    # Constructs and returns a dictionary containing only the tokens that match the maximum frequency.\n    result = {letter: count for letter, count in frequencies.items() if count == max_freq}\n\n    return result\n```"}
