{"task_id": "HumanEval/153", "solution": "def Strongest_Extension(class_name, extensions):\n    \"\"\"Finds the strongest extension based on character casing.\n    Returns the class name combined with the strongest extension name.\n    \"\"\"\n\n    def _calculate_single_extension_strength(extension_name: str) -> int:\n        \"\"\"Calculates the strength of an extension name (CAP - SM).\"\"\"\n        cap_count = sum(1 for char in extension_name if char.isupper())\n        sm_count = sum(1 for char in extension_name if char.islower())\n        return cap_count - sm_count\n\n    if not extensions:\n        # Returns class_name. as per design spec for an empty extensions list.\n        return f\"{class_name}.\"\n\n    max_strength = -float('inf')\n    strongest_extension_name = \"\"\n\n    for extension in extensions:\n        current_strength = _calculate_single_extension_strength(extension)\n        # Ties are handled by only updating if current_strength is strictly greater,\n        # preserving the first encountered strongest extension.\n        if current_strength > max_strength:\n            max_strength = current_strength\n            strongest_extension_name = extension\n\n    return f\"{class_name}.{strongest_extension_name}\""}
{"task_id": "HumanEval/151", "solution": "```python\ndef double_the_difference(lst):\n    '''\n    Given a list of numbers, return the sum of squares of the numbers\n    in the list that are odd. Ignore numbers that are negative or not integers.\n\n    double_the_difference([1, 3, 2, 0]) == 1 + 9 + 0 + 0 = 10\n    double_the_difference([-1, -2, 0]) == 0\n    double_the_difference([9, -2]) == 81\n    double_the_difference([0]) == 0\n\n    If the input list is empty, return 0.\n    '''\n    if not isinstance(lst, list):\n        raise TypeError(\"Input must be a list.\")\n\n    sum_of_squares = 0\n    for item in lst:\n        # Check if the item is an integer, positive, and odd\n        if isinstance(item, int) and item > 0 and item % 2 != 0:\n            sum_of_squares += item * item\n    return sum_of_squares\n```"}
{"task_id": "HumanEval/153", "solution": "def Strongest_Extension(class_name, extensions):\n    \"\"\"Calculates the strength (CAP - SM) for extensions and finds the strongest.\n    If multiple extensions have the same maximum strength, the first occurring is chosen.\n    \"\"\"\n\n    # Assuming extensions is not empty based on critical requirements\n    # \"Trust the caller's inputs and implement the simplest, most direct logic possible.\"\n\n    # Initialize with the first extension's data\n    strongest_extension_name = extensions[0]\n\n    cap_initial = 0\n    sm_initial = 0\n    for char in strongest_extension_name:\n        if 'A' <= char <= 'Z':\n            cap_initial += 1\n        elif 'a' <= char <= 'z':\n            sm_initial += 1\n    max_strength = cap_initial - sm_initial\n\n    # Iterate through the rest of the extensions\n    for i in range(1, len(extensions)):\n        ext_name = extensions[i]\n\n        cap = 0\n        sm = 0\n        for char in ext_name:\n            if 'A' <= char <= 'Z':\n                cap += 1\n            elif 'a' <= char <= 'z':\n                sm += 1\n\n        current_strength = cap - sm\n\n        # If current extension is strictly stronger, update\n        # If strengths are equal, the existing 'strongest_extension_name' (which appeared first) is retained.\n        if current_strength > max_strength:\n            max_strength = current_strength\n            strongest_extension_name = ext_name\n\n    return f\"{class_name}.{strongest_extension_name}\""}
{"task_id": "HumanEval/154", "solution": "```python\ndef cycpattern_check(a, b):\n    \"\"\"\n    Determines if pattern `b` or any of its cyclic rotations exists as a substring within target `a`.\n    Comparison is case-sensitive.\n    \"\"\"\n    if not b:\n        return False\n\n    rotations = []\n    n = len(b)\n    for i in range(n):\n        rotated_s = b[i:] + b[:i]\n        rotations.append(rotated_s)\n\n    for rotation in rotations:\n        if rotation in a:\n            return True\n\n    return False\n```"}
