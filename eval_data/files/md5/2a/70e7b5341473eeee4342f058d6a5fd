{"task_id": "HumanEval/140", "solution": "import re\n\ndef fix_spaces(text):\n    \"\"\"\n    Replaces spaces in a string with underscores or hyphens based on count.\n    Sequences of three or more spaces become a hyphen; single or double spaces become underscores.\n    \"\"\"\n    # First, replace sequences of 3 or more spaces with a single hyphen.\n    # This takes precedence and ensures '   ' becomes '-' directly.\n    processed_text = re.sub(r' {3,}', '-', text)\n\n    # Next, replace any remaining single spaces with an underscore.\n    # This handles original single spaces and converts '  ' into '__'.\n    final_text = processed_text.replace(' ', '_')\n\n    return final_text"}
{"task_id": "HumanEval/139", "solution": "def special_factorial(n):\n    \"\"\"The Brazilian factorial is defined as:\n    brazilian_factorial(n) = n! * (n-1)! * (n-2)! * ... * 1!\n    where n > 0\n\n    For example:\n    >>> special_factorial(4)\n    288\n\n    The function will receive an integer as input and should return the special\n    factorial of this integer.\n    \"\"\"\n\n    if not isinstance(n, int):\n        raise TypeError(\"Input must be an integer.\")\n    if n <= 0:\n        raise ValueError(\"Input must be a positive integer (n > 0).\")\n\n    # Local cache for factorial calculations within this special_factorial call.\n    _memo = {0: 1, 1: 1}\n\n    def calculate_factorial(val):\n        \"\"\"Calculates the factorial of val, using memoization.\"\"\"\n        if val < 0:\n            # This case should ideally not be reached if special_factorial validates n correctly\n            # and only calls calculate_factorial with positive integers.\n            raise ValueError(\"Factorial is not defined for negative numbers.\")\n\n        if val in _memo:\n            return _memo[val]\n\n        result = 1\n        for i in range(2, val + 1):\n            result *= i\n        _memo[val] = result\n        return result\n\n    special_fact_result = 1\n    for i in range(1, n + 1):\n        special_fact_result *= calculate_factorial(i)\n\n    return special_fact_result"}
{"task_id": "HumanEval/140", "solution": "```python\nimport re\n\ndef fix_spaces(text: str) -> str:\n    \"\"\"\n    Replaces single spaces with underscores and two or more consecutive spaces with a single hyphen.\n    This order ensures correct transformation of multiple spaces before single ones.\n    \"\"\"\n    # Replace two or more consecutive spaces with a hyphen\n    processed_text = re.sub(r' {2,}', '-', text)\n    # Replace single spaces with underscores\n    processed_text = processed_text.replace(' ', '_')\n    return processed_text\n```"}
{"task_id": "HumanEval/141", "solution": "```python\ndef file_name_check(file_name):\n    \"\"\"Create a function which takes a string representing a file's name, and returns\n    'Yes' if the the file's name is valid, and returns 'No' otherwise.\n    A file's name is considered to be valid if and only if all the following conditions\n    are met:\n    - There should not be more than three digits ('0'-'9') in the file's name.\n    - The file's name contains exactly one dot '.'\n    - The substring before the dot should not be empty, and it starts with a letter from\n    the latin alphapet ('a'-'z' and 'A'-'Z').\n    - The substring after the dot should be one of these: ['txt', 'exe', 'dll']\n    Examples:\n    file_name_check(\"example.txt\") # => 'Yes'\n    file_name_check(\"1example.dll\") # => 'No' (the name should start with a latin alphapet letter)\n    \"\"\"\n    MAX_DIGITS = 3\n    ALLOWED_EXTENSIONS = ['txt', 'exe', 'dll']\n\n    # Check if the file_name contains more than MAX_DIGITS digits.\n    digit_count = sum(c.isdigit() for c in file_name)\n    if digit_count > MAX_DIGITS:\n        return 'No'\n\n    # Check if the file_name contains exactly one dot.\n    if file_name.count('.') != 1:\n        return 'No'\n\n    # Split the file_name into base name and extension.\n    parts = file_name.split('.')\n    base_name = parts[0]\n    extension = parts[1]\n\n    # Check if the base name is empty.\n    if not base_name:\n        return 'No'\n\n    # Check if the base name starts with a Latin alphabet letter.\n    if not base_name[0].isalpha():\n        return 'No'\n\n    # Check if the extension is one of the allowed extensions.\n    if extension not in ALLOWED_EXTENSIONS:\n        return 'No'\n\n    return 'Yes'\n```"}
{"task_id": "HumanEval/142", "solution": "```python\ndef sum_squares(lst):\n    \"\"\"\"\n    This function will take a list of integers. For all entries in the list, the function shall square the integer entry if its index is a\n    multiple of 3 and will cube the integer entry if its index is a multiple of 4 and not a multiple of 3. The function will not\n    change the entries in the list whose indexes are not a multiple of 3 or 4. The function shall then return the sum of all entries.\n\n    Examples:\n    For lst = [1,2,3] the output should be 6\n    For lst = []  the output should be 0\n    For lst = [-1,-5,2,-1,-5]  the output should be -126\n    \"\"\"\n    total_sum = 0\n    for i, entry in enumerate(lst):\n        transformed_value = entry\n        if i % 3 == 0:\n            transformed_value = entry * entry\n        elif i % 4 == 0:\n            transformed_value = entry * entry * entry\n        total_sum += transformed_value\n    return total_sum\n```"}
{"task_id": "HumanEval/143", "solution": "def words_in_sentence(sentence):\n    \"\"\"\n    Filters words from a sentence, keeping only those with prime lengths.\n    A nested function `is_prime` checks the primality of word lengths.\n    \"\"\"\n    def is_prime(n: int) -> bool:\n        \"\"\"Checks if the input integer n is a prime number.\"\"\"\n        if n < 2:\n            return False\n        for i in range(2, int(n**0.5) + 1):\n            if n % i == 0:\n                return False\n        return True\n\n    words = sentence.split()\n    filtered_words = []\n    for word in words:\n        if is_prime(len(word)):\n            filtered_words.append(word)\n    return \" \".join(filtered_words)"}
{"task_id": "HumanEval/141", "solution": "```python\ndef file_name_check(file_name):\n    \"\"\"\n    Checks if a file's name is valid based on specific conditions.\n    Returns 'Yes' if valid, 'No' otherwise.\n    \"\"\"\n    ALLOWED_EXTENSIONS = ['txt', 'exe', 'dll']\n    MAX_DIGITS = 3\n\n    parts = file_name.split('.')\n    if len(parts) != 2:\n        return 'No'\n\n    prefix = parts[0]\n    suffix = parts[1]\n\n    if not prefix:\n        return 'No'\n\n    if not prefix[0].isalpha():\n        return 'No'\n\n    if suffix not in ALLOWED_EXTENSIONS:\n        return 'No'\n\n    digit_count = sum(1 for char in (prefix + suffix) if char.isdigit())\n    if digit_count > MAX_DIGITS:\n        return 'No'\n\n    return 'Yes'\n```"}
{"task_id": "HumanEval/143", "solution": "```python\ndef words_in_sentence(sentence):\n    \"\"\"\n    Filters words from a sentence, keeping only those with prime lengths.\n    The order of words is preserved.\n    \"\"\"\n\n    def is_prime(number: int) -> bool:\n        \"\"\"\n        Checks if the given number is a prime number.\n        \"\"\"\n        if number < 2:\n            return False\n        for i in range(2, int(number**0.5) + 1):\n            if number % i == 0:\n                return False\n        return True\n\n    words = sentence.split(' ')\n    filtered_words = []\n    for word in words:\n        if is_prime(len(word)):\n            filtered_words.append(word)\n    return ' '.join(filtered_words)\n```"}
{"task_id": "HumanEval/142", "solution": "def sum_squares(lst):\n    \"\"\"Processes a list of integers by squaring elements at indices multiple of 3, cubing elements at indices multiple of 4 (but not 3), and summing the results.\n    Returns 0 for an empty list.\"\"\"\n    if not lst:\n        return 0\n\n    transformed_elements = []\n    for i, value in enumerate(lst):\n        if i % 3 == 0:\n            transformed_elements.append(value * value)\n        elif i % 4 == 0:\n            transformed_elements.append(value * value * value)\n        else:\n            transformed_elements.append(value)\n\n    return sum(transformed_elements)"}
{"task_id": "HumanEval/144", "solution": "```python\nclass Fraction:\n    def __init__(self, numerator, denominator):\n        # Assumed valid integer inputs, denominator is not zero.\n        self.numerator = numerator\n        self.denominator = denominator\n\n    def __mul__(self, other):\n        # Multiplies this fraction by another Fraction object.\n        new_numerator = self.numerator * other.numerator\n        new_denominator = self.denominator * other.denominator\n        return Fraction(new_numerator, new_denominator)\n\n    def is_whole(self):\n        # Determines if the fraction represents a whole number.\n        return self.numerator % self.denominator == 0\n\nclass FractionService:\n    @staticmethod\n    def parse_fraction(fraction_str):\n        # Converts a string representation of a fraction into a Fraction object.\n        parts = fraction_str.split('/')\n        numerator = int(parts[0])\n        denominator = int(parts[1])\n        return Fraction(numerator, denominator)\n\n    @staticmethod\n    def multiply_fractions(f1, f2):\n        # Multiplies two Fraction objects.\n        return f1 * f2\n\n    @staticmethod\n    def is_whole_number(f):\n        # Checks if a given Fraction object represents a whole number.\n        return f.is_whole()\n\ndef simplify(x, n):\n    \"\"\"Checks if the product of two fractions x * n evaluates to a whole number.\n    x and n are string representations of fractions (e.g., '1/5').\n    \"\"\"\n    service = FractionService()\n\n    fraction_x = service.parse_fraction(x)\n    fraction_n = service.parse_fraction(n)\n\n    product_fraction = service.multiply_fractions(fraction_x, fraction_n)\n\n    return service.is_whole_number(product_fraction)\n```"}
{"task_id": "HumanEval/144", "solution": "```python\n# The Fraction class represents a mathematical fraction.\nclass Fraction:\n    def __init__(self, numerator: int, denominator: int) -> None:\n        common_divisor = self._gcd(numerator, denominator)\n        self._numerator = numerator // common_divisor\n        self._denominator = denominator // common_divisor\n\n    @property\n    def numerator(self) -> int:\n        return self._numerator\n\n    @property\n    def denominator(self) -> int:\n        return self._denominator\n\n    def __mul__(self, other: 'Fraction') -> 'Fraction':\n        # Multiplies this fraction by another fraction, returning a new simplified fraction.\n        new_numerator = self.numerator * other.numerator\n        new_denominator = self.denominator * other.denominator\n        return Fraction(new_numerator, new_denominator)\n\n    def is_whole_number(self) -> bool:\n        # Checks if the fraction's denominator is 1, indicating a whole number.\n        return self.denominator == 1\n\n    @staticmethod\n    def _gcd(a: int, b: int) -> int:\n        # Calculates the greatest common divisor using the Euclidean algorithm.\n        while b:\n            a, b = b, a % b\n        return a\n\n# The FractionParser class handles converting string representations to Fraction objects.\nclass FractionParser:\n    @staticmethod\n    def parse_fraction(fraction_str: str) -> Fraction:\n        # Splits the string by '/' and converts parts to integers for Fraction creation.\n        parts = fraction_str.split('/')\n        numerator = int(parts[0])\n        denominator = int(parts[1])\n        return Fraction(numerator, denominator)\n\ndef simplify(x: str, n: str) -> bool:\n    \"\"\"\n    Checks if the product of two fraction strings, x and n, evaluates to a whole number.\n    Both x and n are in \"<numerator>/<denominator>\" format.\n    \"\"\"\n    fraction_x = FractionParser.parse_fraction(x)\n    fraction_n = FractionParser.parse_fraction(n)\n\n    product_fraction = fraction_x * fraction_n\n\n    return product_fraction.is_whole_number()\n```"}
{"task_id": "HumanEval/145", "solution": "```python\ndef order_by_points(nums):\n    \"\"\"\n    Write a function which sorts the given list of integers\n    in ascending order according to the sum of their digits.\n    Note: if there are several items with similar sum of their digits,\n    order them based on their index in original list.\n\n    For example:\n    >>> order_by_points([1, 11, -1, -11, -12]) == [-1, -11, 1, -12, 11]\n    >>> order_by_points([]) == []\n    \"\"\"\n    def calculate_sum(n: int) -> int:\n        \"\"\"\n        Calculates the sum of the absolute digits of an integer.\n        For example, calculate_sum(-12) == 3.\n        \"\"\"\n        s = str(abs(n))\n        digit_sum = 0\n        for digit_char in s:\n            digit_sum += int(digit_char)\n        return digit_sum\n\n    if not nums:\n        return []\n\n    # Create a list of tuples: (sum_of_digits, original_index, original_number)\n    # This allows sorting by sum_of_digits first, then by original_index for tie-breaking.\n    decorated_list = []\n    for index, num in enumerate(nums):\n        digit_sum = calculate_sum(num)\n        decorated_list.append((digit_sum, index, num))\n\n    decorated_list.sort()\n\n    sorted_nums = [item[2] for item in decorated_list]\n\n    return sorted_nums\n```"}
{"task_id": "HumanEval/146", "solution": "```python\ndef specialFilter(nums):\n    \"\"\"\n    Counts numbers in an array that are greater than 10 and have\n    both first and last digits as odd numbers.\n    \"\"\"\n\n    def is_odd(digit):\n        # Checks if a given digit is an odd number.\n        return digit % 2 != 0\n\n    def get_first_digit(num):\n        # Extracts the first digit of a number (absolute value).\n        abs_num_str = str(abs(num))\n        return int(abs_num_str[0])\n\n    def get_last_digit(num):\n        # Extracts the last digit of a number (absolute value).\n        abs_num_str = str(abs(num))\n        return int(abs_num_str[-1])\n\n    def is_greater_than_ten(num):\n        # Checks if a number is strictly greater than 10.\n        return num > 10\n\n    def has_odd_first_and_last_digits(num):\n        # Checks if both the first and last digits of a number are odd.\n        first_digit = get_first_digit(num)\n        last_digit = get_last_digit(num)\n        return is_odd(first_digit) and is_odd(last_digit)\n\n    count = 0\n    for num in nums:\n        if is_greater_than_ten(num) and has_odd_first_and_last_digits(num):\n            count += 1\n    return count\n```"}
{"task_id": "HumanEval/147", "solution": "```python\nimport math\n\ndef get_max_triples(n):\n    \"\"\"\n    Calculates the number of specific integer triples where their sum is a multiple of 3.\n    It processes an array `a` where `a[i] = i*i - i + 1` for `1 <= i <= n`.\n    \"\"\"\n\n    def _calculate_remainder_counts(limit):\n        \"\"\"\n        Counts occurrences of a[x] % 3 for x in the array up to 'limit'.\n        Returns counts for remainder 0 and 1.\n        \"\"\"\n        count0 = 0\n        count1 = 0\n\n        # Based on a[i] = i*i - i + 1:\n        # if i % 3 == 0, then a[i] % 3 == (0 - 0 + 1) % 3 == 1\n        # if i % 3 == 1, then a[i] % 3 == (1 - 1 + 1) % 3 == 1\n        # if i % 3 == 2, then a[i] % 3 == (4 - 2 + 1) % 3 == 0\n        for i_val in range(1, limit + 1):\n            if i_val % 3 == 2:\n                count0 += 1\n            else: # i_val % 3 == 0 or i_val % 3 == 1\n                count1 += 1\n        return count0, count1\n\n    def _calculate_combinations(c0, c1):\n        \"\"\"\n        Calculates total valid triples from counts of elements with remainders 0 and 1.\n        A sum of three elements is a multiple of 3 if their remainders mod 3 are (0,0,0) or (1,1,1).\n        \"\"\"\n        triples_from_0 = 0\n        if c0 >= 3:\n            triples_from_0 = math.comb(c0, 3)\n\n        triples_from_1 = 0\n        if c1 >= 3:\n            triples_from_1 = math.comb(c1, 3)\n\n        return triples_from_0 + triples_from_1\n\n    # No explicit input validation as per critical requirement, trusting 'n' is a positive integer.\n    count0, count1 = _calculate_remainder_counts(n)\n    total_triples = _calculate_combinations(count0, count1)\n    return total_triples\n```"}
{"task_id": "HumanEval/146", "solution": "```python\ndef specialFilter(nums):\n    \"\"\"Write a function that takes an array of numbers as input and returns\n    the number of elements in the array that are greater than 10 and both\n    first and last digits of a number are odd (1, 3, 5, 7, 9).\n    For example:\n    specialFilter([15, -73, 14, -15]) => 1\n    specialFilter([33, -2, -3, 45, 21, 109]) => 2\n    \"\"\"\n\n    def is_odd_digit(digit: int) -> bool:\n        \"\"\"Checks if a given single digit is odd.\"\"\"\n        return digit % 2 != 0\n\n    def get_first_digit(num: int) -> int:\n        \"\"\"Extracts the first digit of an integer (absolute value).\"\"\"\n        abs_num_str = str(abs(num))\n        return int(abs_num_str[0])\n\n    def get_last_digit(num: int) -> int:\n        \"\"\"Extracts the last digit of an integer (absolute value).\"\"\"\n        abs_num_str = str(abs(num))\n        return int(abs_num_str[-1])\n\n    def _check_all_conditions(num: int) -> bool:\n        \"\"\"Helper to check if a single number meets all special filter criteria.\"\"\"\n        if num <= 10:\n            return False\n\n        first_digit = get_first_digit(num)\n        if not is_odd_digit(first_digit):\n            return False\n\n        last_digit = get_last_digit(num)\n        return is_odd_digit(last_digit)\n\n    count = 0\n    for num in nums:\n        if _check_all_conditions(num):\n            count += 1\n    return count\n```"}
