{"task_id": "HumanEval/36", "solution": "```python\ndef fizz_buzz(n: int):\n    \"\"\"Return the number of times the digit 7 appears in integers less than n which are divisible by 11 or 13.\n    >>> fizz_buzz(50)\n    0\n    >>> fizz_buzz(78)\n    2\n    >>> fizz_buzz(79)\n    3\n    \"\"\"\n    total_sevens = 0\n\n    # Helper function to count a specific digit's occurrences in a number.\n    def _count_digit_in_number(number: int, digit_to_count: int) -> int:\n        count = 0\n        num_str = str(number) # Convert to string to iterate over digits.\n        for char in num_str:\n            if int(char) == digit_to_count:\n                count += 1\n        return count\n\n    for i in range(1, n):\n        # Check if the number is divisible by 11 or 13.\n        if (i % 11 == 0) or (i % 13 == 0):\n            total_sevens += _count_digit_in_number(i, 7)\n\n    return total_sevens\n```"}
{"task_id": "HumanEval/32", "solution": "```python\nimport math\n\n\ndef poly(xs: list, x: float):\n    \"\"\"Evaluates polynomial with coefficients xs at point x.\n    Returns xs[0] + xs[1] * x + ... + xs[n] * x^n.\"\"\"\n    return sum([coeff * math.pow(x, i) for i, coeff in enumerate(xs)])\n\n\ndef find_zero(xs: list):\n    \"\"\"Finds a single zero point for a polynomial using the bisection method.\n    It returns only one zero point, even if there are many.\"\"\"\n\n    BISECTION_TOLERANCE: float = 1e-6\n    BISECTION_MAX_ITERATIONS: int = 1000\n    BISECTION_INTERVAL_START: float = -100.0\n    BISECTION_INTERVAL_END: float = 100.0\n\n    a = BISECTION_INTERVAL_START\n    b = BISECTION_INTERVAL_END\n\n    fa = poly(xs, a)\n    fb = poly(xs, b)\n\n    for _ in range(BISECTION_MAX_ITERATIONS):\n        m = (a + b) / 2\n        fm = poly(xs, m)\n\n        if abs(fm) < BISECTION_TOLERANCE:\n            return m\n\n        if fa * fm < 0:\n            b = m\n            fb = fm\n        else:\n            a = m\n            fa = fm\n\n    return (a + b) / 2\n```"}
{"task_id": "HumanEval/37", "solution": "```python\ndef sort_even(l: list):\n    \"\"\"Sorts elements at even indices of a list, preserving odd-indexed elements.\n    Returns a new list with sorted even-indexed values.\n    >>> sort_even([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_even([5, 6, 3, 4])\n    [3, 6, 5, 4]\n    \"\"\"\n    even_elements = []\n    for i in range(0, len(l), 2):\n        even_elements.append(l[i])\n\n    even_elements.sort()\n\n    result = l[:]\n    even_idx = 0\n    for i in range(0, len(l), 2):\n        result[i] = even_elements[even_idx]\n        even_idx += 1\n    return result\n```"}
{"task_id": "HumanEval/37", "solution": "```python\ndef sort_even(l: list):\n    \"\"\"Sorts elements at even indices of a list in ascending order, preserving odd-indexed elements.\n    Returns a new list with the modified even-indexed elements.\"\"\"\n    if not l:\n        return []\n\n    even_elements = [l[i] for i in range(0, len(l), 2)]\n    even_elements.sort()\n\n    result_list = list(l) # Create a mutable copy to preserve odd-indexed elements.\n    even_idx_counter = 0\n    for i in range(0, len(result_list), 2):\n        result_list[i] = even_elements[even_idx_counter]\n        even_idx_counter += 1\n\n    return result_list\n```"}
{"task_id": "HumanEval/38", "solution": "```python\ndef encode_cyclic(s: str) -> str:\n    \"\"\"\n    returns encoded string by cycling groups of three characters.\n    \"\"\"\n    # split string to groups. Each of length 3.\n    groups = [s[(3 * i):min((3 * i + 3), len(s))] for i in range((len(s) + 2) // 3)]\n    # cycle elements in each group. Unless group has fewer elements than 3.\n    groups = [(group[1:] + group[0]) if len(group) == 3 else group for group in groups]\n    return \"\".join(groups)\n\n\ndef decode_cyclic(s: str) -> str:\n    \"\"\"\n    takes as input string encoded with encode_cyclic function. Returns decoded string.\n    \"\"\"\n    # split string to groups. Each of length 3.\n    groups = [s[(3 * i):min((3 * i + 3), len(s))] for i in range((len(s) + 2) // 3)]\n    # reverse cycle elements in each group. Moving the last character to the front.\n    groups = [(group[-1] + group[:-1]) if len(group) == 3 else group for group in groups]\n    return \"\".join(groups)\n```"}
{"task_id": "HumanEval/38", "solution": "```python\ndef decode_cyclic(s: str):\n    \"\"\"\n    Decodes a string by reversing the cyclic shift on groups of three characters.\n    Groups with fewer than three characters are left untouched.\n    \"\"\"\n    decoded_groups = []\n    # Split string into groups of three, processing each for decoding.\n    for i in range(0, len(s), 3):\n        group = s[i : i + 3]\n        if len(group) == 3:\n            # Apply the inverse cyclic shift (e0e1e2 -> e2e0e1)\n            decoded_groups.append(group[2] + group[0] + group[1])\n        else:\n            # Append partial groups as is, per requirement FR4.\n            decoded_groups.append(group)\n\n    return \"\".join(decoded_groups)\n```"}
