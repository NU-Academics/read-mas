{"task_id": "HumanEval/81", "solution": "```python\ndef numerical_letter_grade(grades):\n    \"\"\"Converts a list of numerical GPAs to a list of corresponding letter grades.\n    Handles 'Invalid GPA' for values outside the [0.0, 4.0] range.\n    \"\"\"\n    letter_grades = []\n    for gpa in grades:\n        if gpa == 4.0:\n            letter_grade = \"A+\"\n        elif gpa > 3.7:\n            letter_grade = \"A\"\n        elif gpa > 3.3:\n            letter_grade = \"A-\"\n        elif gpa > 3.0:\n            letter_grade = \"B+\"\n        elif gpa > 2.7:\n            letter_grade = \"B\"\n        elif gpa > 2.3:\n            letter_grade = \"B-\"\n        elif gpa > 2.0:\n            letter_grade = \"C+\"\n        elif gpa > 1.7:\n            letter_grade = \"C\"\n        elif gpa > 1.3:\n            letter_grade = \"C-\"\n        elif gpa > 1.0:\n            letter_grade = \"D+\"\n        elif gpa > 0.7:\n            letter_grade = \"D\"\n        elif gpa > 0.0:\n            letter_grade = \"D-\"\n        elif gpa == 0.0:\n            letter_grade = \"E\"\n        else:\n            letter_grade = \"Invalid GPA\"\n\n        letter_grades.append(letter_grade)\n    return letter_grades\n```"}
{"task_id": "HumanEval/83", "solution": "```python\ndef starts_one_ends(n):\n    \"\"\"\n    Calculates the count of n-digit positive integers that start or end with 1.\n    Applies the principle of inclusion-exclusion.\n    \"\"\"\n    if n == 1:\n        return 1\n\n    # Count numbers that start with 1 (e.g., 1xx for n=3).\n    count_starts_with_1 = 10**(n - 1)\n\n    # Count numbers that end with 1 (e.g., xx1 for n=3).\n    # The first digit can't be zero, so 9 choices for the first digit.\n    count_ends_with_1 = 9 * (10**(n - 2))\n\n    # Count numbers that start and end with 1 (e.g., 1x1 for n=3).\n    count_starts_and_ends_with_1 = 10**(n - 2)\n\n    # Apply the Principle of Inclusion-Exclusion.\n    total_count = count_starts_with_1 + count_ends_with_1 - count_starts_and_ends_with_1\n    return total_count\n```"}
{"task_id": "HumanEval/83", "solution": "```python\ndef starts_one_ends(n: int) -> int:\n    \"\"\"\n    Given a positive integer n, return the count of n-digit positive integers\n    that start or end with 1.\n    \"\"\"\n    if n == 1:\n        return 1\n\n    # Calculate count of n-digit numbers that start with 1.\n    # The first digit is 1, and the remaining n-1 digits can be any of 0-9.\n    starts_with_one = 10**(n - 1)\n\n    # Calculate count of n-digit numbers that end with 1.\n    # The last digit is 1. The first digit can be 1-9 (9 choices), and the n-2 middle digits (if any) can be 0-9.\n    ends_with_one = 9 * (10**(n - 2))\n\n    # Calculate count of n-digit numbers that start AND end with 1.\n    # The first digit is 1, the last digit is 1, and the n-2 middle digits (if any) can be 0-9.\n    starts_and_ends_with_one = 10**(n - 2)\n\n    return starts_with_one + ends_with_one - starts_and_ends_with_one\n```"}
{"task_id": "HumanEval/84", "solution": "```python\ndef sum_digits(num: int) -> int:\n    \"\"\"Calculates the sum of the digits of a non-negative integer.\"\"\"\n    s = 0\n    for digit in str(num):\n        s += int(digit)\n    return s\n\ndef to_binary(num: int) -> str:\n    \"\"\"Converts a non-negative integer to its binary string representation.\"\"\"\n    if num == 0:\n        return '0'\n    return bin(num)[2:]\n\ndef solve(N):\n    \"\"\"Given a positive integer N, return the total sum of its digits in binary.\"\"\"\n    digit_sum = sum_digits(N)\n    binary_representation = to_binary(digit_sum)\n    return binary_representation\n```"}
{"task_id": "HumanEval/84", "solution": "```python\ndef solve(N):\n    \"\"\"Given a positive integer N, return the total sum of its digits in binary.\n\n    Example\n        For N = 1000, the sum of digits will be 1 the output should be \"1\".\n        For N = 150, the sum of digits will be 6 the output should be \"110\".\n        For N = 147, the sum of digits will be 12 the output should be \"1100\".\n\n    Variables:\n        @N integer\n             Constraints: 0 \u2264 N \u2264 10000.\n    Output:\n         a string of binary number\n    \"\"\"\n    MIN_N = 0\n    MAX_N = 10000\n\n    if not isinstance(N, int):\n        raise ValueError(\"Input N must be an integer.\")\n    if not (MIN_N <= N <= MAX_N):\n        raise ValueError(f\"Input N must be between {MIN_N} and {MAX_N} inclusive.\")\n\n    # Calculate the sum of decimal digits of N.\n    digit_sum = 0\n    for digit_char in str(N):\n        digit_sum += int(digit_char)\n\n    # Convert the calculated digit sum into its binary string representation.\n    # The built-in bin() function returns a string prefixed with \"0b\".\n    # We slice the string to remove this prefix.\n    # For digit_sum = 0, bin(0) returns '0b0', so [2:] correctly gives '0'.\n    binary_string = bin(digit_sum)[2:]\n\n    return binary_string\n```"}
{"task_id": "HumanEval/81", "solution": "```python\ndef numerical_letter_grade(grades):\n    \"\"\"Converts a list of numerical GPAs into a corresponding list of letter grades based on a specific grading scale.\n    The function provides letter grades for GPAs ranging from 0.0 (E) to 4.0 (A+), handling values outside this range gracefully.\n    \"\"\"\n    from dataclasses import dataclass\n\n    @dataclass\n    class GPAScaleEntry:\n        gpa_threshold: float\n        letter_grade: str\n        inclusive_lower: bool # True if gpa >= threshold, False if gpa > threshold\n\n    # The grading scale is defined in descending order of GPA thresholds for efficient lookup.\n    GRADING_SCALE = [\n        GPAScaleEntry(gpa_threshold=4.0, letter_grade='A+', inclusive_lower=True),\n        GPAScaleEntry(gpa_threshold=3.7, letter_grade='A', inclusive_lower=False),\n        GPAScaleEntry(gpa_threshold=3.3, letter_grade='A-', inclusive_lower=False),\n        GPAScaleEntry(gpa_threshold=3.0, letter_grade='B+', inclusive_lower=False),\n        GPAScaleEntry(gpa_threshold=2.7, letter_grade='B', inclusive_lower=False),\n        GPAScaleEntry(gpa_threshold=2.3, letter_grade='B-', inclusive_lower=False),\n        GPAScaleEntry(gpa_threshold=2.0, letter_grade='C+', inclusive_lower=False),\n        GPAScaleEntry(gpa_threshold=1.7, letter_grade='C', inclusive_lower=False),\n        GPAScaleEntry(gpa_threshold=1.3, letter_grade='C-', inclusive_lower=False),\n        GPAScaleEntry(gpa_threshold=1.0, letter_grade='D+', inclusive_lower=False),\n        GPAScaleEntry(gpa_threshold=0.7, letter_grade='D', inclusive_lower=False),\n        GPAScaleEntry(gpa_threshold=0.0, letter_grade='D-', inclusive_lower=False),\n        GPAScaleEntry(gpa_threshold=0.0, letter_grade='E', inclusive_lower=True) # Catches exactly 0.0 and anything below\n    ]\n\n    class GradeConverterService:\n        def __init__(self, grading_scale: list[GPAScaleEntry]):\n            # Ensure the grading scale is sorted in descending order of GPA threshold\n            # to correctly apply the \"greater than\" logic.\n            self._grading_scale = sorted(grading_scale, key=lambda x: x.gpa_threshold, reverse=True)\n\n        def convert_gpa_to_letter_grade(self, gpa: float) -> str:\n            for entry in self._grading_scale:\n                if entry.inclusive_lower:\n                    if gpa >= entry.gpa_threshold:\n                        return entry.letter_grade\n                else:\n                    if gpa > entry.gpa_threshold:\n                        return entry.letter_grade\n            # This fallback handles any GPA below the lowest defined threshold.\n            # Given the comprehensive GRADING_SCALE, this path should ideally be rare for typical inputs.\n            return 'E'\n\n    converter = GradeConverterService(GRADING_SCALE)\n    return [converter.convert_gpa_to_letter_grade(gpa) for gpa in grades]\n```"}
{"task_id": "HumanEval/85", "solution": "```python\ndef add(lst):\n    \"\"\"Given a non-empty list of integers lst. add the even elements that are at odd indices..\n\n\n    Examples:\n        add([4, 2, 6, 7]) ==> 2\n    \"\"\"\n    total_sum = 0\n    for i, element in enumerate(lst):\n        if i % 2 != 0 and element % 2 == 0:\n            total_sum += element\n    return total_sum\n```"}
{"task_id": "HumanEval/86", "solution": "```python\nimport re\n\ndef anti_shuffle(s):\n    \"\"\"\n    Sorts characters within each word of a string based on ASCII value.\n    Preserves word order and original spacing in the returned string.\n    \"\"\"\n    parts = re.split(r'(\\s+)', s)\n    processed_parts = []\n    for part in parts:\n        # A part is considered a word if it's not empty and contains non-whitespace characters.\n        if part and not part.isspace():\n            processed_parts.append(\"\".join(sorted(part)))\n        else:\n            # Whitespace delimiters or empty strings from splitting are preserved as is.\n            processed_parts.append(part)\n    return \"\".join(processed_parts)\n```"}
{"task_id": "HumanEval/85", "solution": "```python\ndef add(lst: list[int]) -> int:\n    \"\"\"\n    Given a list of integers, calculates the sum of even elements located at odd indices.\n    Assumes input is a non-empty list of integers as per critical requirements.\n    \"\"\"\n    total_sum = 0\n    for i, element in enumerate(lst):\n        if i % 2 != 0 and element % 2 == 0:\n            total_sum += element\n    return total_sum\n```"}
{"task_id": "HumanEval/88", "solution": "```python\ndef sort_array(array: list[int]) -> list[int]:\n    \"\"\"\n    Given an array of non-negative integers, return a copy of the given array after sorting.\n    Sorts based on the parity of the sum of its first and last elements.\n    \"\"\"\n    if not array or len(array) <= 1:\n        return array[:]\n\n    first_val = array[0]\n    last_val = array[-1]\n    sum_first_last = first_val + last_val\n\n    copied_array = array[:]\n\n    if sum_first_last % 2 != 0:  # Odd sum, sort ascending\n        return sorted(copied_array)\n    else:  # Even sum, sort descending\n        return sorted(copied_array, reverse=True)\n```"}
{"task_id": "HumanEval/86", "solution": "import re\n\ndef anti_shuffle(s):\n    \"\"\"\n    Reorders characters within each word in ascending ASCII order.\n    Preserves original word order and blank spaces.\n    \"\"\"\n\n    def _sort_word_chars(word: str) -> str:\n        \"\"\"Sorts the characters of a single word by ASCII value.\"\"\"\n        return \"\".join(sorted(word))\n\n    # Split the string into words and delimiters (spaces), keeping the delimiters.\n    parts = re.split(r'(\\s+)', s)\n\n    result_parts = []\n    for part in parts:\n        # If the part is composed only of whitespace, append it as is.\n        # Otherwise, it's a word whose characters need to be sorted.\n        if part.strip() == \"\":\n            result_parts.append(part)\n        else:\n            result_parts.append(_sort_word_chars(part))\n\n    return \"\".join(result_parts)"}
{"task_id": "HumanEval/87", "solution": "```python\ndef get_row(lst, x):\n    \"\"\"\n    Finds integer x in the 2D list and returns a list of its (row, column) coordinates.\n    Coordinates are sorted by row ascending, then by column descending.\n    \"\"\"\n    found_coordinates = []\n\n    for r_idx, row_list in enumerate(lst):\n        for c_idx, value in enumerate(row_list):\n            if value == x:\n                found_coordinates.append((r_idx, c_idx))\n\n    # Sort primarily by row in ascending order, secondarily by column in descending order.\n    # Negating the column index makes an ascending sort behave as a descending sort for columns.\n    found_coordinates.sort(key=lambda coord: (coord[0], -coord[1]))\n\n    return found_coordinates\n```"}
{"task_id": "HumanEval/87", "solution": "```python\ndef get_row(lst, x):\n    \"\"\"\n    You are given a 2 dimensional data, as a nested lists,\n    which is similar to matrix, however, unlike matrices,\n    each row may contain a different number of columns.\n    Given lst, and integer x, find integers x in the list,\n    and return list of tuples, [(x1, y1), (x2, y2) ...] such that\n    each tuple is a coordinate - (row, columns), starting with 0.\n    Sort coordinates initially by rows in ascending order.\n    Also, sort coordinates of the row by columns in descending order.\n\n    Examples:\n    get_row([\n      [1,2,3,4,5,6],\n      [1,2,3,4,1,6],\n      [1,2,3,4,5,1]\n    ], 1) == [(0, 0), (1, 4), (1, 0), (2, 5), (2, 0)]\n    get_row([], 1) == []\n    get_row([[], [1], [1, 2, 3]], 3) == [(2, 2)]\n    \"\"\"\n    found_coordinates = []\n    for r_idx, row in enumerate(lst):\n        for c_idx, val in enumerate(row):\n            if val == x:\n                found_coordinates.append((r_idx, c_idx))\n\n    # Sort primarily by row (ascending) and secondarily by column (descending).\n    # Using -c_idx for column achieves descending order with Python's default ascending sort.\n    found_coordinates.sort(key=lambda coord: (coord[0], -coord[1]))\n    return found_coordinates\n```"}
{"task_id": "HumanEval/88", "solution": "```python\ndef sort_array(array):\n    \"\"\"\n    Given an array of non-negative integers, return a copy of the given array after sorting.\n    Sorts the given array in ascending order if the sum of its first and last elements is odd,\n    or in descending order if the sum is even.\n    \"\"\"\n    copied_array = array[:]  # Create a shallow copy to leave the original array unchanged.\n\n    if not copied_array or len(copied_array) == 1:\n        return copied_array\n\n    first_element = copied_array[0]\n    last_element = copied_array[-1]\n    sum_of_elements = first_element + last_element\n\n    if sum_of_elements % 2 != 0:  # If sum is odd, sort ascending.\n        copied_array.sort()\n    else:  # If sum is even, sort descending.\n        copied_array.sort(reverse=True)\n\n    return copied_array\n```"}
{"task_id": "HumanEval/89", "solution": "```python\ndef encrypt(s):\n    \"\"\"Create a function encrypt that takes a string as an argument and\n    returns a string encrypted with the alphabet being rotated.\n    The alphabet should be rotated in a manner such that the letters\n    shift down by two multiplied to two places.\n    \"\"\"\n    ROTATION_SHIFT = 4\n    encrypted_chars = []\n    for char in s:\n        if 'a' <= char <= 'z':\n            start = ord('a')\n            encrypted_chars.append(chr((ord(char) - start + ROTATION_SHIFT) % 26 + start))\n        elif 'A' <= char <= 'Z':\n            start = ord('A')\n            encrypted_chars.append(chr((ord(char) - start + ROTATION_SHIFT) % 26 + start))\n        else:\n            encrypted_chars.append(char)\n    return \"\".join(encrypted_chars)\n```"}
