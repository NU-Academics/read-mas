{"task_id": "HumanEval/96", "solution": "```python\ndef count_up_to(n):\n    \"\"\"Returns a list of all prime numbers strictly less than n.\n    It implements the Sieve of Eratosthenes for efficient prime generation.\n    \"\"\"\n    if n <= 2:\n        return []\n\n    def _sieve_of_eratosthenes(limit: int) -> list[bool]:\n        # Initializes a boolean array marking numbers as potentially prime.\n        # It then iteratively marks multiples of primes as not prime.\n        is_prime = [True] * limit\n        is_prime[0] = is_prime[1] = False\n\n        p = 2\n        while (p * p < limit):\n            if is_prime[p]:\n                for i in range(p * p, limit, p):\n                    is_prime[i] = False\n            p += 1\n        return is_prime\n\n    is_prime_flags = _sieve_of_eratosthenes(n)\n    primes = []\n    for i in range(2, n):\n        if is_prime_flags[i]:\n            primes.append(i)\n    return primes\n```"}
{"task_id": "HumanEval/98", "solution": "```python\ndef count_upper(s):\n    \"\"\"\n    Counts uppercase vowels at even indices in the given string.\n    Vowels are 'A', 'E', 'I', 'O', 'U'.\n    \"\"\"\n    UPPERCASE_VOWELS = {'A', 'E', 'I', 'O', 'U'}\n    count = 0\n    for i in range(0, len(s), 2):\n        if s[i] in UPPERCASE_VOWELS:\n            count += 1\n    return count\n```"}
{"task_id": "HumanEval/95", "solution": "```python\ndef check_dict_case(dict):\n    \"\"\"\n    Given a dictionary, return True if all keys are strings in lower\n    case or all keys are strings in upper case, else return False.\n    The function should return False is the given dictionary is empty.\n    Examples:\n    check_dict_case({\"a\":\"apple\", \"b\":\"banana\"}) should return True.\n    check_dict_case({\"a\":\"apple\", \"A\":\"banana\", \"B\":\"banana\"}) should return False.\n    check_dict_case({\"a\":\"apple\", 8:\"banana\", \"a\":\"apple\"}) should return False.\n    check_dict_case({\"Name\":\"John\", \"Age\":\"36\", \"City\":\"Houston\"}) should return False.\n    check_dict_case({\"STATE\":\"NC\", \"ZIP\":\"12345\" }) should return True.\n    \"\"\"\n    if not dict:\n        return False\n\n    all_lower = True\n    all_upper = True\n\n    for key in dict.keys():\n        if not isinstance(key, str):\n            # If any key is not a string, return False immediately as per requirements\n            return False\n\n        # Check if the current key is not entirely lowercase\n        if not key.islower():\n            all_lower = False\n\n        # Check if the current key is not entirely uppercase\n        if not key.isupper():\n            all_upper = False\n\n    # Return True if all keys are either entirely lowercase or entirely uppercase\n    return all_lower or all_upper\n```"}
{"task_id": "HumanEval/98", "solution": "```python\ndef count_upper(s):\n    \"\"\"\n    Given a string s, count the number of uppercase vowels in even indices.\n\n    For example:\n    count_upper('aBCdEf') returns 1\n    count_upper('abcdefg') returns 0\n    count_upper('dBBE') returns 0\n    \"\"\"\n    count = 0\n    uppercase_vowels = {'A', 'E', 'I', 'O', 'U'}\n    for i, char in enumerate(s):\n        if i % 2 == 0 and char in uppercase_vowels:\n            count += 1\n    return count\n```"}
{"task_id": "HumanEval/96", "solution": "```python\nimport math\n\ndef count_up_to(n):\n    \"\"\"Implement a function that takes an non-negative integer and returns an array of the first n\n    integers that are prime numbers and less than n.\n    for example:\n    count_up_to(5) => [2,3]\n    count_up_to(11) => [2,3,5,7]\n    count_up_to(0) => []\n    count_up_to(20) => [2,3,5,7,11,13,17,19]\n    count_up_to(1) => []\n    count_up_to(18) => [2,3,5,7,11,13,17]\n    \"\"\"\n    class PrimeUtils:\n        @staticmethod\n        def is_prime(num: int) -> bool:\n            if num < 2:\n                return False\n            if num == 2:\n                return True\n            if num % 2 == 0:\n                return False\n            for i in range(3, int(math.sqrt(num)) + 1, 2):\n                if num % i == 0:\n                    return False\n            return True\n\n        @staticmethod\n        def validate_non_negative_integer(n: any) -> int:\n            if not isinstance(n, int):\n                raise ValueError(\"Input must be an integer.\")\n            if n < 0:\n                raise ValueError(\"Input must be a non-negative integer.\")\n            return n\n\n    class PrimeGeneratorService:\n        def __init__(self, prime_utils: PrimeUtils):\n            self._prime_utils = prime_utils\n\n        def generate_primes_less_than(self, n: int) -> list[int]:\n            if n <= 2:\n                return []\n\n            primes = []\n            for i in range(2, n):\n                if self._prime_utils.is_prime(i):\n                    primes.append(i)\n            return primes\n\n    _prime_utils_instance = PrimeUtils()\n    _prime_generator_service_instance = PrimeGeneratorService(_prime_utils_instance)\n\n    validated_n = _prime_utils_instance.validate_non_negative_integer(n)\n    return _prime_generator_service_instance.generate_primes_less_than(validated_n)\n\n```"}
{"task_id": "HumanEval/99", "solution": "```python\nimport math\n\ndef closest_integer(value: str) -> int:\n    \"\"\"\n    Calculates the closest integer to a number string,\n    rounding away from zero for equidistant cases.\n    \"\"\"\n    number = float(value)\n\n    if number == int(number):\n        return int(number)\n\n    floor_val = math.floor(number)\n    ceil_val = math.ceil(number)\n\n    diff_floor = abs(number - floor_val)\n    diff_ceil = abs(number - ceil_val)\n\n    if diff_floor < diff_ceil:\n        return int(floor_val)\n    elif diff_ceil < diff_floor:\n        return int(ceil_val)\n    else:  # Equidistant, .5 case\n        if number > 0:\n            return int(ceil_val)\n        else:\n            return int(floor_val)\n```"}
{"task_id": "HumanEval/100", "solution": "```python\ndef make_a_pile(n):\n    \"\"\"\n    Generates a list representing a pile of stones with n levels.\n    Each subsequent level increments by 2, maintaining the initial parity.\n    \"\"\"\n    pile_levels = [n]\n    current_stones = n\n\n    parity_increment = 2\n\n    for _ in range(1, n):\n        current_stones += parity_increment\n        pile_levels.append(current_stones)\n\n    return pile_levels\n```"}
{"task_id": "HumanEval/99", "solution": "```python\nimport math\n\ndef closest_integer(value):\n    \"\"\"\n    Create a function that takes a value (string) representing a number\n    and returns the closest integer to it. If the number is equidistant\n    from two integers, round it away from zero.\n\n    Examples\n    >>> closest_integer(\"10\")\n    10\n    >>> closest_integer(\"15.3\")\n    15\n    >>> closest_integer(\"14.5\")\n    15\n    >>> closest_integer(\"-14.5\")\n    -15\n    \"\"\"\n    num = float(value)\n\n    if num == 0:\n        return 0\n\n    # Determine the fractional part based on absolute value\n    fractional_part = abs(num) - math.floor(abs(num))\n\n    # Apply \"away from zero\" rule for equidistant values (e.g., X.5)\n    if fractional_part == 0.5:\n        return math.ceil(num) if num > 0 else math.floor(num)\n    else:\n        # For other values, use standard rounding (round half to even in Python's round())\n        # and then convert to integer.\n        return int(round(num))\n```"}
