{"task_id": "HumanEval/91", "solution": "```python\nimport re\n\ndef _starts_with_i(sentence: str) -> bool:\n    \"\"\"Checks if a sentence starts with 'I' (case-insensitive) after stripping whitespace.\"\"\"\n    trimmed_sentence = sentence.strip()\n    if not trimmed_sentence:\n        return False\n    return trimmed_sentence[0].lower() == 'i'\n\nSENTENCE_DELIMITERS = ['.', '?', '!']\n\ndef _split_sentences(text: str) -> list[str]:\n    \"\"\"Splits a string into sentences based on defined delimiters.\n    It handles multiple delimiters and ensures no empty strings are returned.\"\"\"\n    pattern = '|'.join(re.escape(d) for d in SENTENCE_DELIMITERS)\n    temp_sentences = re.split(f'({pattern})', text)\n\n    sentences = []\n    current_sentence_parts = []\n    for part in temp_sentences:\n        if part.strip() in SENTENCE_DELIMITERS:\n            if current_sentence_parts:\n                sentences.append(\"\".join(current_sentence_parts).strip())\n                current_sentence_parts = []\n        elif part.strip():\n            current_sentence_parts.append(part)\n\n    if current_sentence_parts:\n        sentences.append(\"\".join(current_sentence_parts).strip())\n\n    return [s for s in sentences if s]\n\ndef is_bored(S):\n    \"\"\"\n    You'll be given a string of words, and your task is to count the number\n    of boredoms. A boredom is a sentence that starts with the word \"I\".\n    Sentences are delimited by '.', '?' or '!'.\n\n    For example:\n    >>> is_bored(\"Hello world\")\n    0\n    >>> is_bored(\"The sky is blue. The sun is shining. I love this weather\")\n    1\n    \"\"\"\n    count = 0\n    sentences = _split_sentences(S)\n\n    for sentence in sentences:\n        if _starts_with_i(sentence):\n            count += 1\n    return count\n```"}
{"task_id": "HumanEval/92", "solution": "```python\ndef any_int(x, y, z):\n    '''\n    Create a function that takes 3 numbers.\n    Returns true if one of the numbers is equal to the sum of the other two, and all numbers are integers.\n    Returns false in any other cases.\n\n    Examples\n    any_int(5, 2, 7) \u279e True\n\n    any_int(3, 2, 2) \u279e False\n\n    any_int(3, -2, 1) \u279e True\n\n    any_int(3.6, -2.2, 2) \u279e False\n    '''\n    if not (isinstance(x, int) and isinstance(y, int) and isinstance(z, int)):\n        return False\n\n    return (x == y + z or\n            y == x + z or\n            z == x + y)\n```"}
{"task_id": "HumanEval/93", "solution": "```python\nimport string\n\ndef encode(message):\n    \"\"\"\n    Write a function that takes a message, and encodes in such a\n    way that it swaps case of all letters, replaces all vowels in\n    the message with the letter that appears 2 places ahead of that\n    vowel in the english alphabet.\n    Assume only letters.\n\n    Examples:\n    >>> encode('test')\n    'TGST'\n    >>> encode('This is a message')\n    'tHKS KS C MGSSCGG'\n    \"\"\"\n    VOWELS_LOWER = {'a', 'e', 'i', 'o', 'u'}\n    VOWELS_UPPER = {'A', 'E', 'I', 'O', 'U'}\n    ALPHABET_LOWER = string.ascii_lowercase\n    ALPHABET_UPPER = string.ascii_uppercase\n    SHIFT_PLACES = 2\n\n    encoded_chars = []\n    for char in message:\n        if char.isalpha():\n            swapped_char = char.swapcase()\n\n            # Check if the case-swapped character is a vowel (FR2, FR3)\n            is_vowel = (swapped_char in VOWELS_LOWER or swapped_char in VOWELS_UPPER)\n\n            if is_vowel:\n                # Shift the vowel by SHIFT_PLACES, preserving its case (FR2, FR3, BR5)\n                if swapped_char.islower():\n                    alphabet = ALPHABET_LOWER\n                else:\n                    alphabet = ALPHABET_UPPER\n                current_index = alphabet.index(swapped_char)\n                new_index = (current_index + SHIFT_PLACES) % len(alphabet)\n                shifted_char = alphabet[new_index]\n                encoded_chars.append(shifted_char)\n            else:\n                # Append the case-swapped non-vowel letter (FR1)\n                encoded_chars.append(swapped_char)\n        elif char.isspace():\n            # Preserve spaces (FR4)\n            encoded_chars.append(char)\n        else:\n            # Pass through any other characters, as per the design spec's example implementation (FR5).\n            encoded_chars.append(char)\n\n    return \"\".join(encoded_chars)\n```"}
{"task_id": "HumanEval/93", "solution": "def encode(message: str) -> str:\n    \"\"\"Encodes a message by swapping case and shifting vowels.\"\"\"\n\n    ALPHABET = \"abcdefghijklmnopqrstuvwxyz\"\n    VOWELS = \"aeiou\"\n    SHIFT_AMOUNT = 2\n\n    # Inline helper functions to satisfy the \"same code block\" constraint.\n    # These helpers re-implement common string methods using ord/chr to avoid\n    # built-in string utility function calls.\n\n    def _is_upper(char_val: int) -> bool:\n        return ord('A') <= char_val <= ord('Z')\n\n    def _is_lower(char_val: int) -> bool:\n        return ord('a') <= char_val <= ord('z')\n\n    def _to_lower(char_val: int) -> int:\n        if _is_upper(char_val):\n            return char_val + 32\n        return char_val\n\n    def _to_upper(char_val: int) -> int:\n        if _is_lower(char_val):\n            return char_val - 32\n        return char_val\n\n    def _is_vowel_check(char_val: int) -> bool:\n        # Checks if a character (case-insensitive) is a vowel.\n        return chr(_to_lower(char_val)) in VOWELS\n\n    def _swap_case_logic(char_val: int) -> int:\n        # Swaps the case of an alphabetic character. Non-letters are unchanged.\n        if _is_lower(char_val):\n            return _to_upper(char_val)\n        elif _is_upper(char_val):\n            return _to_lower(char_val)\n        return char_val\n\n    def _shift_char_logic(char_val: int, shift: int) -> int:\n        # Shifts an alphabetic character (assumed to be a vowel here)\n        # by a given number of places, preserving case.\n        is_upper_orig = _is_upper(char_val)\n        char_lower_val = _to_lower(char_val)\n        char_lower_str = chr(char_lower_val)\n\n        idx = ALPHABET.find(char_lower_str)\n        # idx will not be -1 as this is only called for identified vowels which are in ALPHABET.\n        new_idx = (idx + shift) % len(ALPHABET)\n        shifted_char_val_lower = ord(ALPHABET[new_idx])\n\n        return _to_upper(shifted_char_val_lower) if is_upper_orig else shifted_char_val_lower\n\n    encoded_chars = []\n    for char in message:\n        char_val = ord(char)\n\n        # FR1: Swap case of all alphabetic characters.\n        swapped_char_val = _swap_case_logic(char_val)\n\n        final_char_val = swapped_char_val # Default: use the case-swapped character\n\n        # FR2: Replace vowels (after case swap) with letter two places ahead.\n        # Check if the character is alphabetic and a vowel (case-insensitive).\n        if (_is_lower(swapped_char_val) or _is_upper(swapped_char_val)) and \\\n           _is_vowel_check(swapped_char_val):\n            final_char_val = _shift_char_logic(swapped_char_val, SHIFT_AMOUNT)\n\n        encoded_chars.append(chr(final_char_val))\n\n    return \"\".join(encoded_chars)"}
{"task_id": "HumanEval/92", "solution": "```python\ndef any_int(x, y, z):\n    '''\n    Create a function that takes 3 numbers.\n    Returns true if one of the numbers is equal to the sum of the other two, and all numbers are integers.\n    Returns false in any other cases.\n\n    Examples\n    any_int(5, 2, 7) \u279e True\n\n    any_int(3, 2, 2) \u279e False\n\n    any_int(3, -2, 1) \u279e True\n\n    any_int(3.6, -2.2, 2) \u279e False\n    '''\n    if not all(isinstance(arg, int) for arg in [x, y, z]):\n        return False\n\n    return (x == y + z) or \\\n           (y == x + z) or \\\n           (z == x + y)\n```"}
{"task_id": "HumanEval/94", "solution": "```python\nimport math\n\ndef _is_prime(n: int) -> bool:\n    \"\"\"Checks if an integer n is a prime number.\n    Numbers less than or equal to 1 are not considered prime.\n    \"\"\"\n    if n <= 1:\n        return False\n    if n <= 3:\n        return True\n    if n % 2 == 0 or n % 3 == 0:\n        return False\n    i = 5\n    while i * i <= n:\n        if n % i == 0 or n % (i + 2) == 0:\n            return False\n        i += 6\n    return True\n\ndef _sum_digits(n: int) -> int:\n    \"\"\"Calculates the sum of the absolute digits of an integer.\n    For example, sum_digits(181) returns 10.\n    \"\"\"\n    s = 0\n    n = abs(n)\n    while n:\n        s += n % 10\n        n //= 10\n    return s\n\ndef skjkasdkd(lst: list[int]) -> int:\n    \"\"\"\n    You are given a list of integers.\n    You need to find the largest prime value and return the sum of its digits.\n    \"\"\"\n    largest_prime = 0\n\n    for num in lst:\n        if _is_prime(num):\n            if num > largest_prime:\n                largest_prime = num\n\n    if largest_prime == 0:\n        return 0\n\n    return _sum_digits(largest_prime)\n```"}
{"task_id": "HumanEval/95", "solution": "def check_dict_case(dict):\n    \"\"\"\n    Given a dictionary, return True if all keys are strings in lower\n    case or all keys are strings in upper case, else return False.\n    The function should return False is the given dictionary is empty.\n    Examples:\n    check_dict_case({\"a\":\"apple\", \"b\":\"banana\"}) should return True.\n    check_dict_case({\"a\":\"apple\", \"A\":\"banana\", \"B\":\"banana\"}) should return False.\n    check_dict_case({\"a\":\"apple\", 8:\"banana\", \"a\":\"apple\"}) should return False.\n    check_dict_case({\"Name\":\"John\", \"Age\":\"36\", \"City\":\"Houston\"}) should return False.\n    check_dict_case({\"STATE\":\"NC\", \"ZIP\":\"12345\" }) should return True.\n    \"\"\"\n    if not dict:\n        return False\n\n    all_lower = True\n    all_upper = True\n\n    for key in dict.keys():\n        if not isinstance(key, str):\n            return False\n\n        if not key.islower():\n            all_lower = False\n\n        if not key.isupper():\n            all_upper = False\n\n    return all_lower or all_upper"}
{"task_id": "HumanEval/94", "solution": "class PrimeUtils:\n    \"\"\"Utility functions for prime number operations.\"\"\"\n    @staticmethod\n    def is_prime(number: int) -> bool:\n        \"\"\"Checks if the given integer is a prime number.\"\"\"\n        if number <= 1:\n            return False\n        if number == 2:\n            return True\n        if number % 2 == 0:\n            return False\n        # Check for divisibility by odd numbers up to the square root of number.\n        i = 3\n        while i * i <= number:\n            if number % i == 0:\n                return False\n            i += 2\n        return True\n\nclass DigitUtils:\n    \"\"\"Utility functions for digit operations.\"\"\"\n    @staticmethod\n    def sum_digits(number: int) -> int:\n        \"\"\"Calculates the sum of the digits of a non-negative integer.\"\"\"\n        digit_sum = 0\n        temp_num = number\n        while temp_num > 0:\n            digit_sum += temp_num % 10\n            temp_num //= 10\n        return digit_sum\n\nclass PrimeService:\n    \"\"\"Business logic for finding largest prime and summing its digits.\"\"\"\n    def __init__(self, prime_utils_instance: PrimeUtils, digit_utils_instance: DigitUtils):\n        \"\"\"Initializes PrimeService with utility dependencies.\"\"\"\n        self.prime_utils = prime_utils_instance\n        self.digit_utils = digit_utils_instance\n\n    def find_largest_prime_and_sum_digits(self, lst: list[int]) -> int:\n        \"\"\"Finds the largest prime in a list and returns the sum of its digits.\"\"\"\n        largest_prime = None\n        for number in lst:\n            if self.prime_utils.is_prime(number):\n                if largest_prime is None or number > largest_prime:\n                    largest_prime = number\n\n        if largest_prime is not None:\n            return self.digit_utils.sum_digits(largest_prime)\n        else:\n            return 0\n\ndef skjkasdkd(lst: list[int]) -> int:\n    \"\"\"\n    You are given a list of integers.\n    You need to find the largest prime value and return the sum of its digits.\n    \"\"\"\n    prime_utils = PrimeUtils()\n    digit_utils = DigitUtils()\n    prime_service = PrimeService(prime_utils, digit_utils)\n    return prime_service.find_largest_prime_and_sum_digits(lst)"}
