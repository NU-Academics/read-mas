{"task_id": "HumanEval/18", "solution": "```python\ndef how_many_times(string: str, substring: str) -> int:\n    \"\"\"Find how many times a given substring can be found in the original string.\n    Count overlapping cases.\n    \"\"\"\n    count = 0\n    if not substring:\n        return len(string) + 1 # As per Python's str.count behavior for empty substring\n\n    for i in range(len(string) - len(substring) + 1):\n        if string[i:i + len(substring)] == substring:\n            count += 1\n    return count\n```"}
{"task_id": "HumanEval/17", "solution": "```python\nfrom typing import List\n\n\nclass InvalidNoteError(ValueError):\n    \"\"\"Custom exception raised when an invalid musical note token is encountered.\"\"\"\n    pass\n\n\n_NOTE_MAP = {\n    'o': 4,   # Whole note\n    'o|': 2,  # Half note\n    '.|': 1   # Quarter note\n}\n\n\ndef parse_music(music_string: str) -> List[int]:\n    \"\"\" Input to this function is a string representing musical notes in a special ASCII format.\n    Your task is to parse this string and return list of integers corresponding to how many beats does each\n    not last.\n\n    Here is a legend:\n    'o' - whole note, lasts four beats\n    'o|' - half note, lasts two beats\n    '.|' - quater note, lasts one beat\n\n    >>> parse_music('o o| .| o| o| .| .| .| .| o o')\n    [4, 2, 1, 2, 2, 1, 1, 1, 1, 4, 4]\n    \"\"\"\n    if not music_string.strip():\n        return []\n\n    note_tokens = music_string.split(' ')\n    beat_durations: List[int] = []\n\n    for token in note_tokens:\n        duration = _NOTE_MAP.get(token)\n        if duration is None:\n            raise InvalidNoteError(f\"Unrecognized note token: '{token}'\")\n        beat_durations.append(duration)\n\n    return beat_durations\n```"}
{"task_id": "HumanEval/17", "solution": "```python\nfrom typing import List\n\n\nclass InvalidNoteError(Exception):\n    \"\"\"Custom exception raised when an invalid musical note pattern is encountered.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n\n\ndef parse_music(music_string: str) -> List[int]:\n    \"\"\" Input to this function is a string representing musical notes in a special ASCII format.\n    Your task is to parse this string and return list of integers corresponding to how many beats does each\n    not last.\n\n    Here is a legend:\n    'o' - whole note, lasts four beats\n    'o|' - half note, lasts two beats\n    '.|' - quater note, lasts one beat\n\n    >>> parse_music('o o| .| o| o| .| .| .| .| o o')\n    [4, 2, 1, 2, 2, 1, 1, 1, 1, 4, 4]\n    \"\"\"\n\n    NOTE_BEATS_MAP = {\n        'o': 4,   # whole note\n        'o|': 2,  # half note\n        '.|': 1   # quarter note\n    }\n\n    if not music_string.strip():\n        return []\n\n    beat_durations: List[int] = []\n    note_tokens = music_string.split()\n\n    for token in note_tokens:\n        if token in NOTE_BEATS_MAP:\n            beat_durations.append(NOTE_BEATS_MAP[token])\n        else:\n            raise InvalidNoteError(f\"Unrecognized musical note pattern: '{token}'\")\n\n    return beat_durations\n```"}
{"task_id": "HumanEval/18", "solution": "```python\ndef how_many_times(string: str, substring: str) -> int:\n    \"\"\"\n    Counts the number of non-overlapping and overlapping occurrences of `substring` within `string`.\n    Iterates through the string, checking for substring matches at each possible starting position.\n    \"\"\"\n    if not substring:\n        return 0\n    count = 0\n    # Iterate through the string, checking for substring at each possible start index\n    for i in range(len(string) - len(substring) + 1):\n        if string[i:i+len(substring)] == substring:\n            count += 1\n    return count\n```"}
{"task_id": "HumanEval/19", "solution": "```python\ndef sort_numbers(numbers: str) -> str:\n    \"\"\"\n    Sorts a space-delimited string of number words (zero to nine) from smallest to largest.\n    Invalid words are ignored, and the output is a space-delimited string.\n    \"\"\"\n    WORD_TO_INT_MAP = {\n        \"zero\": 0, \"one\": 1, \"two\": 2, \"three\": 3, \"four\": 4,\n        \"five\": 5, \"six\": 6, \"seven\": 7, \"eight\": 8, \"nine\": 9\n    }\n    INT_TO_WORD_MAP = {\n        0: \"zero\", 1: \"one\", 2: \"two\", 3: \"three\", 4: \"four\",\n        5: \"five\", 6: \"six\", 7: \"seven\", 8: \"eight\", 9: \"nine\"\n    }\n\n    words = numbers.split()\n\n    # Convert words to integers, filtering out invalid ones\n    integer_list = []\n    for word in words:\n        num = WORD_TO_INT_MAP.get(word.lower())\n        if num is not None:\n            integer_list.append(num)\n\n    integer_list.sort()\n\n    # Convert sorted integers back to words\n    sorted_words = []\n    for num in integer_list:\n        # num is guaranteed to be 0-9 if it came from WORD_TO_INT_MAP\n        sorted_words.append(INT_TO_WORD_MAP[num])\n\n    return \" \".join(sorted_words)\n```"}
{"task_id": "HumanEval/20", "solution": "```python\nfrom typing import List, Tuple\n\n\ndef find_closest_elements(numbers: List[float]) -> Tuple[float, float]:\n    \"\"\" From a supplied list of numbers (of length at least two) select and return two that are the closest to each\n    other and return them in order (smaller number, larger number).\"\"\"\n\n    sorted_numbers = sorted(numbers)\n\n    min_diff = float('inf')\n    closest_pair = (0.0, 0.0)\n\n    for i in range(len(sorted_numbers) - 1):\n        diff = sorted_numbers[i+1] - sorted_numbers[i]\n        if diff < min_diff:\n            min_diff = diff\n            closest_pair = (sorted_numbers[i], sorted_numbers[i+1])\n\n    return closest_pair\n```"}
{"task_id": "HumanEval/21", "solution": "```python\nfrom typing import List\n\n\ndef rescale_to_unit(numbers: List[float]) -> List[float]:\n    \"\"\"Given a list of numbers, this function rescales them to a unit range [0, 1].\n    The smallest number becomes 0 and the largest becomes 1 through a linear transformation.\n    \"\"\"\n    min_val = min(numbers)\n    max_val = max(numbers)\n\n    if max_val == min_val:\n        # Return a list of 0.0s if all numbers are identical to avoid division by zero.\n        return [0.0] * len(numbers)\n    else:\n        # Apply the linear transformation for all other cases.\n        rescaled_numbers = [(x - min_val) / (max_val - min_val) for x in numbers]\n        return rescaled_numbers\n```"}
{"task_id": "HumanEval/21", "solution": "```python\nfrom typing import List\n\n\ndef rescale_to_unit(numbers: List[float]) -> List[float]:\n    \"\"\" Given a list of numbers, applies a linear transformation.\n    The smallest number becomes 0.0 and the largest becomes 1.0.\n    \"\"\"\n    min_val = min(numbers)\n    max_val = max(numbers)\n\n    if max_val == min_val:\n        return [0.0] * len(numbers)\n    else:\n        return [(num - min_val) / (max_val - min_val) for num in numbers]\n```"}
