{"task_id": "HumanEval/0", "solution": "```python\nfrom typing import List\n\n\ndef has_close_elements(numbers: List[float], threshold: float) -> bool:\n    \"\"\" Check if in given list of numbers, are any two numbers closer to each other than\n    given threshold.\n    >>> has_close_elements([1.0, 2.0, 3.0], 0.5)\n    False\n    >>> has_close_elements([1.0, 2.8, 3.0, 4.0, 5.0, 2.0], 0.3)\n    True\n    \"\"\"\n    n = len(numbers)\n\n    # Return False if the list contains fewer than two elements, as no pairs can be formed.\n    if n < 2:\n        return False\n\n    # Iterate through all unique pairs of numbers in the list.\n    for i in range(n):\n        for j in range(i + 1, n):\n            # Calculate the absolute difference between the pair.\n            if abs(numbers[i] - numbers[j]) < threshold:\n                return True  # Return True immediately if any pair meets the condition.\n\n    # If no close elements were found after checking all pairs, return False.\n    return False\n```"}
{"task_id": "HumanEval/0", "solution": "```python\nfrom typing import List\n\n\ndef has_close_elements(numbers: List[float], threshold: float) -> bool:\n    \"\"\" Check if in given list of numbers, are any two numbers closer to each other than\n    given threshold.\n    >>> has_close_elements([1.0, 2.0, 3.0], 0.5)\n    False\n    >>> has_close_elements([1.0, 2.8, 3.0, 4.0, 5.0, 2.0], 0.3)\n    True\n    \"\"\"\n    n = len(numbers)\n    if n < 2:\n        return False\n\n    for i in range(n):\n        for j in range(i + 1, n):\n            if abs(numbers[i] - numbers[j]) < threshold:\n                return True\n    return False\n```"}
{"task_id": "HumanEval/1", "solution": "```python\nfrom typing import List\n\nclass StringCleaner:\n    \"\"\"\n    Utility for string cleaning.\n    Removes all space characters.\n    \"\"\"\n    @staticmethod\n    def remove_spaces(input_string: str) -> str:\n        \"\"\"\n        Removes all space characters from the input string.\n        \"\"\"\n        return input_string.replace(' ', '')\n\nclass ParenSeparator:\n    \"\"\"\n    Separates a string into distinct, balanced, and non-nested parenthesis groups.\n    It preprocesses the string and iteratively finds groups.\n    \"\"\"\n    def separate_groups(self, paren_string: str) -> List[str]:\n        \"\"\"\n        Main method to separate parenthesis groups from the input string.\n        It cleans the input and extracts top-level balanced groups.\n        \"\"\"\n        cleaned_string = StringCleaner.remove_spaces(paren_string)\n\n        result_groups: List[str] = []\n        current_index = 0\n\n        while current_index < len(cleaned_string):\n            group, next_index = self._find_next_group(cleaned_string, current_index)\n            if group:\n                result_groups.append(group)\n                current_index = next_index\n            else:\n                # No more valid groups found from this point.\n                break\n        return result_groups\n\n    def _find_next_group(self, cleaned_string: str, start_index: int) -> tuple[str, int]:\n        \"\"\"\n        Finds the next top-level, balanced parenthesis group.\n        Returns the group string and the index immediately after it, or an empty string and -1.\n        \"\"\"\n        balance = 0\n        group_start = -1\n\n        for i in range(start_index, len(cleaned_string)):\n            char = cleaned_string[i]\n            if char == '(':\n                if balance == 0: # Start of a new top-level group.\n                    group_start = i\n                balance += 1\n            elif char == ')':\n                balance -= 1\n\n            if balance == 0 and group_start != -1: # Found a balanced top-level group.\n                return cleaned_string[group_start : i + 1], i + 1\n\n            if balance < 0: # Malformed sequence, reset and continue search.\n                balance = 0\n                group_start = -1 # Ensure next group starts with '('.\n\n        return \"\", -1 # No valid group found.\n\ndef separate_paren_groups(paren_string: str) -> List[str]:\n    \"\"\" Input to this function is a string containing multiple groups of nested parentheses. Your goal is to\n    separate those group into separate strings and return the list of those.\n    Separate groups are balanced (each open brace is properly closed) and not nested within each other\n    Ignore any spaces in the input string.\n    >>> separate_paren_groups('( ) (( )) (( )( ))')\n    ['()', '(())', '(()())']\n    \"\"\"\n    separator = ParenSeparator()\n    return separator.separate_groups(paren_string)\n```"}
{"task_id": "HumanEval/4", "solution": "```python\nfrom typing import List\n\n\ndef mean_absolute_deviation(numbers: List[float]) -> float:\n    \"\"\" For a given list of input numbers, calculate Mean Absolute Deviation\n    around the mean of this dataset.\n    MAD is the average absolute difference between each element and the mean.\n    \"\"\"\n    n = len(numbers)\n\n    if n == 0:\n        return 0.0\n\n    # Calculate the mean (FR1)\n    mean_value = sum(numbers) / n\n\n    # Calculate absolute differences (FR2)\n    absolute_differences_sum = 0.0\n    for x in numbers:\n        absolute_differences_sum += abs(x - mean_value)\n\n    # Calculate the Mean Absolute Deviation (FR3)\n    mad_value = absolute_differences_sum / n\n\n    return mad_value\n```"}
{"task_id": "HumanEval/5", "solution": "```python\nfrom typing import List\n\n\ndef intersperse(numbers: List[int], delimeter: int) -> List[int]:\n    \"\"\" Insert a number 'delimeter' between every two consecutive elements of input list `numbers`\n    >>> intersperse([], 4)\n    []\n    >>> intersperse([1, 2, 3], 4)\n    [1, 4, 2, 4, 3]\n    \"\"\"\n    if not numbers:\n        return []\n    if len(numbers) == 1:\n        return list(numbers)\n\n    result = []\n    for i, num in enumerate(numbers):\n        result.append(num)\n        if i < len(numbers) - 1:\n            result.append(delimeter)\n    return result\n```"}
{"task_id": "HumanEval/5", "solution": "```python\nfrom typing import List\n\n\ndef intersperse(numbers: List[int], delimiter: int) -> List[int]:\n    \"\"\"\n    Insert a number 'delimiter' between every two consecutive elements of input list `numbers`.\n    An empty input list results in an empty output list.\n    \"\"\"\n    if not numbers:\n        return []\n\n    result = []\n    for i, num in enumerate(numbers):\n        result.append(num)\n        if i < len(numbers) - 1:\n            result.append(delimiter)\n    return result\n```"}
{"task_id": "HumanEval/4", "solution": "```python\nfrom typing import List\n\n\ndef mean_absolute_deviation(numbers: List[float]) -> float:\n    \"\"\" For a given list of input numbers, calculate Mean Absolute Deviation\n    around the mean of this dataset. Returns 0.0 for empty or single-element lists.\n    \"\"\"\n    if not numbers or len(numbers) == 1:\n        return 0.0\n\n    # Calculate the mean of the dataset.\n    dataset_mean = sum(numbers) / len(numbers)\n\n    # Calculate the absolute differences between each number and the mean.\n    absolute_differences = [abs(x - dataset_mean) for x in numbers]\n\n    # Calculate the mean of these absolute differences, which is the MAD.\n    mad = sum(absolute_differences) / len(absolute_differences)\n\n    return mad\n```"}
