{"task_id": "HumanEval/161", "solution": "```python\ndef solve(s):\n    \"\"\"Transforms a string: reverses letter case, or reverses the whole string\n    if no letters are present.\"\"\"\n    transformed_chars = []\n    has_letters = False\n\n    for char in s:\n        if char.isalpha():\n            transformed_chars.append(char.swapcase())\n            has_letters = True\n        else:\n            transformed_chars.append(char)\n\n    result_string = \"\".join(transformed_chars)\n\n    if not has_letters:\n        return result_string[::-1]\n    else:\n        return result_string\n```"}
{"task_id": "HumanEval/160", "solution": "class AlgebraError(Exception):\n    \"\"\"Base exception for algebra_evaluator errors.\"\"\"\n    def __init__(self, message=\"An algebra evaluation error occurred.\"):\n        self.message = message\n        super().__init__(self.message)\n\nclass InvalidOperatorError(AlgebraError):\n    \"\"\"Raised when an invalid operator is encountered.\"\"\"\n    def __init__(self, operator: str):\n        super().__init__(f\"Invalid operator: '{operator}'. Allowed operators are '+', '-', '*', '//', '**'.\")\n\nclass InvalidOperandError(AlgebraError):\n    \"\"\"Raised when an invalid operand is encountered.\"\"\"\n    def __init__(self, operand):\n        super().__init__(f\"Invalid operand: '{operand}'. Operands must be non-negative integers.\")\n\nclass InputLengthMismatchError(AlgebraError):\n    \"\"\"Raised when the length of operators and operands lists do not match expected.\"\"\"\n    def __init__(self, op_len: int, operand_len: int):\n        super().__init__(f\"Length mismatch: operators list has {op_len} elements, but operands list has {operand_len}. Expected len(operators) == len(operands) - 1.\")\n\nclass InsufficientInputError(AlgebraError):\n    \"\"\"Raised when there are not enough operators or operands.\"\"\"\n    def __init__(self, message=\"Insufficient input: operator list must have at least one operator, and operand list at least two operands.\"):\n        super().__init__(message)\n\nclass EvaluationError(AlgebraError):\n    \"\"\"Raised when an error occurs during expression evaluation.\"\"\"\n    def __init__(self, expression: str, original_error: Exception):\n        super().__init__(f\"Error evaluating expression '{expression}': {original_error}\")\n\nclass Utils:\n    ALLOWED_OPERATORS = {'+', '-', '*', '//', '**'}\n\n    @staticmethod\n    def validate_operators(operators: list[str]) -> None:\n        \"\"\"Validates that all operators are allowed strings.\"\"\"\n        for op in operators:\n            if not isinstance(op, str) or op not in Utils.ALLOWED_OPERATORS:\n                raise InvalidOperatorError(op)\n\n    @staticmethod\n    def validate_operands(operands: list[int]) -> None:\n        \"\"\"Validates that all operands are non-negative integers.\"\"\"\n        for operand in operands:\n            if not isinstance(operand, int) or operand < 0:\n                raise InvalidOperandError(operand)\n\n    @staticmethod\n    def validate_input_lengths(operators: list[str], operands: list[int]) -> None:\n        \"\"\"Validates the length constraints of operator and operand lists.\"\"\"\n        op_len = len(operators)\n        operand_len = len(operands)\n\n        if op_len < 1 or operand_len < 2:\n            raise InsufficientInputError()\n\n        if op_len != operand_len - 1:\n            raise InputLengthMismatchError(op_len, operand_len)\n\nclass AlgebraEvaluator:\n    def evaluate(self, operators: list[str], operands: list[int]) -> int:\n        \"\"\"\n        Evaluates an algebraic expression built from operators and operands.\n\n        Args:\n            operators: A list of strings representing basic algebra operations.\n            operands: A list of non-negative integers.\n\n        Returns:\n            The integer result of the evaluated expression.\n\n        Raises:\n            InvalidOperatorError: If an operator is not allowed.\n            InvalidOperandError: If an operand is not a non-negative integer.\n            InputLengthMismatchError: If len(operators) != len(operands) - 1.\n            InsufficientInputError: If operator list has less than 1 or operand list less than 2 elements.\n            EvaluationError: If an error occurs during expression evaluation.\n        \"\"\"\n        Utils.validate_operators(operators)\n        Utils.validate_operands(operands)\n        Utils.validate_input_lengths(operators, operands)\n\n        expression_string = self._build_expression_string(operators, operands)\n\n        try:\n            # Using eval() is acceptable here because the expression string is\n            # constructed from strictly validated and controlled inputs,\n            # mitigating security risks associated with arbitrary code execution.\n            result = eval(expression_string)\n            return int(result) # Ensure integer return for floor division results\n        except Exception as e:\n            raise EvaluationError(expression_string, e)\n\n    def _build_expression_string(self, operators: list[str], operands: list[int]) -> str:\n        \"\"\"\n        Builds the algebraic expression as a string.\n        Example: [2, 3, 4, 5], ['+', '*', '-'] -> \"2 + 3 * 4 - 5\"\n        \"\"\"\n        expression_parts = []\n        for i in range(len(operands)):\n            expression_parts.append(str(operands[i]))\n            if i < len(operators):\n                expression_parts.append(operators[i])\n        return \" \".join(expression_parts)\n\ndef do_algebra(operator: list[str], operand: list[int]) -> int:\n    \"\"\"\n    Given two lists operator, and operand. The first list has basic algebra operations, and\n    the second list is a list of integers. Use the two given lists to build the algebric\n    expression and return the evaluation of this expression.\n\n    The basic algebra operations:\n    Addition ( + )\n    Subtraction ( - )\n    Multiplication ( * )\n    Floor division ( // )\n    Exponentiation ( ** )\n\n    Example:\n    operator['+', '*', '-']\n    array = [2, 3, 4, 5]\n    result = 2 + 3 * 4 - 5\n    => result = 9\n\n    Note:\n        The length of operator list is equal to the length of operand list minus one.\n        Operand is a list of of non-negative integers.\n        Operator list has at least one operator, and operand list has at least two operands.\n\n    \"\"\"\n    evaluator = AlgebraEvaluator()\n    return evaluator.evaluate(operator, operand)"}
{"task_id": "HumanEval/145", "solution": "```python\ndef order_by_points(nums):\n    \"\"\"\n    Sorts a list of integers based on the sum of their digits, then by original index.\n    The sum of digits is calculated from the absolute value of the number.\n    Raises TypeError if input is not a list or contains non-integer elements.\n    \"\"\"\n\n    if not isinstance(nums, list):\n        raise TypeError(\"Input must be a list.\")\n\n    if not all(isinstance(x, int) for x in nums):\n        raise TypeError(\"All elements in the list must be integers.\")\n\n    def _calculate_digit_sum(n: int) -> int:\n        \"\"\"Calculates the sum of the absolute digits of an integer.\"\"\"\n        s = str(abs(n))\n        return sum(int(digit) for digit in s)\n\n    class SortableNumber:\n        \"\"\"\n        Encapsulates an integer's value, original index, and digit sum for custom sorting.\n        Compares first by digit sum, then by original index.\n        \"\"\"\n        def __init__(self, value: int, original_index: int, digit_sum: int):\n            self.value = value\n            self.original_index = original_index\n            self.digit_sum = digit_sum\n\n        def __lt__(self, other: 'SortableNumber') -> bool:\n            if self.digit_sum != other.digit_sum:\n                return self.digit_sum < other.digit_sum\n            return self.original_index < other.original_index\n\n    if not nums:\n        return []\n\n    sortable_items = []\n    for i, num in enumerate(nums):\n        digit_sum = _calculate_digit_sum(num)\n        sortable_items.append(SortableNumber(num, i, digit_sum))\n\n    sorted_sortable_items = sorted(sortable_items)\n\n    result = [item.value for item in sorted_sortable_items]\n\n    return result\n```"}
{"task_id": "HumanEval/161", "solution": "```python\ndef solve(s):\n    \"\"\"Reverses the case of letters in a string; if no letters are present, reverses the entire string.\n    Non-letter characters are preserved during character-by-character processing.\n    \"\"\"\n\n    # Check if the string contains any letters.\n    has_letters = any(char.isalpha() for char in s)\n\n    if not has_letters:\n        # If no letters, reverse the entire string.\n        return s[::-1]\n    else:\n        transformed_chars = []\n        for char in s:\n            # If a character is a letter, reverse its case.\n            if char.isalpha():\n                transformed_chars.append(char.swapcase())\n            else:\n                # Otherwise, keep the character unchanged.\n                transformed_chars.append(char)\n\n        return \"\".join(transformed_chars)\n```"}
{"task_id": "HumanEval/163", "solution": "EVEN_SINGLE_DIGITS = {2, 4, 6, 8}\n\ndef generate_integers(a, b):\n    \"\"\"\n    Given two positive integers a and b, return the even digits between a\n    and b, in ascending order.\n    \"\"\"\n    lower_bound = min(a, b)\n    upper_bound = max(a, b)\n\n    result = []\n    for digit in sorted(EVEN_SINGLE_DIGITS):\n        if lower_bound <= digit <= upper_bound:\n            result.append(digit)\n\n    return result"}
{"task_id": "HumanEval/163", "solution": "def generate_integers(a, b):\n    \"\"\"\n    Given two positive integers a and b, return the even digits between a\n    and b, in ascending order.\n\n    For example:\n    generate_integers(2, 8) => [2, 4, 6, 8]\n    generate_integers(8, 2) => [2, 4, 6, 8]\n    generate_integers(10, 14) => []\n    \"\"\"\n    if not isinstance(a, int):\n        raise ValueError(\"Parameter 'a' must be an integer.\")\n    if not isinstance(b, int):\n        raise ValueError(\"Parameter 'b' must be an integer.\")\n    if a <= 0:\n        raise ValueError(\"Parameter 'a' must be a positive integer.\")\n    if b <= 0:\n        raise ValueError(\"Parameter 'b' must be a positive integer.\")\n\n    start = min(a, b)\n    end = max(a, b)\n\n    even_integers = []\n    for num in range(start, end + 1):\n        if num % 2 == 0:\n            even_integers.append(num)\n\n    return even_integers"}
{"task_id": "HumanEval/160", "solution": "```python\nclass ExpressionBuilder:\n    \"\"\"Builds an algebraic expression string from lists of operators and operands.\"\"\"\n    def build_expression_string(self, operators: list[str], operands: list[int]) -> str:\n        expression_parts = []\n        for i in range(len(operands)):\n            expression_parts.append(str(operands[i]))\n            if i < len(operators):\n                expression_parts.append(operators[i])\n        return \" \".join(expression_parts)\n\nclass AlgebraEvaluator:\n    \"\"\"Orchestrates building and evaluating algebraic expressions.\"\"\"\n    SUPPORTED_OPERATORS = {'+', '-', '*', '//', '**'}\n\n    def __init__(self):\n        self._builder = ExpressionBuilder()\n\n    def evaluate(self, operators: list[str], operands: list[int]) -> int:\n        \"\"\"Evaluates an algebraic expression from operator and operand lists.\"\"\"\n        expression_string = self._builder.build_expression_string(operators, operands)\n\n        # eval() is used for simplicity, trusting caller inputs as per critical requirements.\n        result = eval(expression_string)\n\n        return int(result)\n\ndef do_algebra(operator: list[str], operand: list[int]) -> int:\n    \"\"\"\n    Given two lists, operator and operand, build an algebraic expression\n    and return its evaluated integer result.\n    \"\"\"\n    evaluator = AlgebraEvaluator()\n    return evaluator.evaluate(operator, operand)\n\n```"}
