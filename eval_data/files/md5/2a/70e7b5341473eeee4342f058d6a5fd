{"task_id": "HumanEval/39", "solution": "```python\nimport math\nfrom typing import Iterator\n\ndef is_prime(num: int) -> bool:\n    \"\"\"\n    Checks if a number is prime using trial division.\n    It returns True for prime numbers, False otherwise.\n    \"\"\"\n    if num < 2:\n        return False\n    for i in range(2, int(math.sqrt(num)) + 1):\n        if num % i == 0:\n            return False\n    return True\n\ndef fibonacci_generator() -> Iterator[int]:\n    \"\"\"\n    Generates an infinite sequence of Fibonacci numbers.\n    It starts yielding from 2, which is the first prime Fibonacci.\n    \"\"\"\n    a, b = 0, 1\n    while True:\n        next_fib = a + b\n        if next_fib >= 2:\n            yield next_fib\n        a, b = b, next_fib\n\ndef prime_fib(n: int) -> int:\n    \"\"\"\n    prime_fib returns n-th number that is a Fibonacci number and it's also prime.\n    \"\"\"\n    fib_gen: Iterator[int] = fibonacci_generator()\n    prime_fib_count = 0\n    current_fib = 0\n\n    while prime_fib_count < n:\n        current_fib = next(fib_gen)\n        if is_prime(current_fib):\n            prime_fib_count += 1\n    return current_fib\n```"}
{"task_id": "HumanEval/39", "solution": "```python\ndef prime_fib(n: int) -> int:\n    \"\"\"\n    prime_fib returns n-th number that is a Fibonacci number and it's also prime.\n    >>> prime_fib(1)\n    2\n    >>> prime_fib(2)\n    3\n    >>> prime_fib(3)\n    5\n    >>> prime_fib(4)\n    13\n    >>> prime_fib(5)\n    89\n    \"\"\"\n    def is_prime(num: int) -> bool:\n        \"\"\"Checks if a number is prime using an optimized trial division algorithm.\"\"\"\n        if num < 2:\n            return False\n        if num == 2 or num == 3:\n            return True\n        if num % 2 == 0 or num % 3 == 0:\n            return False\n        i = 5\n        while i * i <= num:\n            if num % i == 0 or num % (i + 2) == 0:\n                return False\n            i += 6\n        return True\n\n    prime_fib_found_count = 0\n    a, b = 0, 1  # Initialize Fibonacci sequence F_0 = 0, F_1 = 1\n\n    while True:\n        # Check current Fibonacci number 'a' for primality\n        if a > 1 and is_prime(a):\n            prime_fib_found_count += 1\n            if prime_fib_found_count == n:\n                return a\n\n        # Generate the next Fibonacci number\n        a, b = b, a + b\n```"}
