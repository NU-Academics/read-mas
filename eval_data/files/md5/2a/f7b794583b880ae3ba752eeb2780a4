{"task_id": "HumanEval/2", "solution": "import math\n\n\ndef truncate_number(number: float) -> float:\n    \"\"\" Given a positive floating point number, it can be decomposed into\n    and integer part (largest integer smaller than given number) and decimals\n    (leftover part always smaller than 1).\n\n    Return the decimal part of the number.\n    >>> truncate_number(3.5)\n    0.5\n    \"\"\"\n    EPSILON = 1e-12\n    floor_val = math.floor(number)\n    frac = number - floor_val\n    # Guard against tiny negatives due to FP\n    if frac < 0 and abs(frac) < EPSILON:\n        frac = 0.0\n    # Ensure upper bound < 1 due to rounding\n    if frac >= 1.0:\n        frac = 0.0\n    return float(frac)"}
{"task_id": "HumanEval/3", "solution": "from typing import List\n\n\ndef below_zero(operations: List[int]) -> bool:\n    \"\"\" You're given a list of deposit and withdrawal operations on a bank account that starts with\n    zero balance. Your task is to detect if at any point the balance of account fallls below zero, and\n    at that point function should return True. Otherwise it should return False.\n    >>> below_zero([1, 2, 3])\n    False\n    >>> below_zero([1, 2, -4, 5])\n    True\n    \"\"\"\n    balance = 0\n    for op in operations:\n        balance += op\n        if balance < 0:\n            return True\n    return False"}
{"task_id": "HumanEval/4", "solution": "from typing import List\n\n\ndef mean_absolute_deviation(numbers: List[float]) -> float:\n    \"\"\" For a given list of input numbers, calculate Mean Absolute Deviation\n    around the mean of this dataset.\n    Mean Absolute Deviation is the average absolute difference between each\n    element and a centerpoint (mean in this case):\n    MAD = average | x - x_mean |\n    >>> mean_absolute_deviation([1.0, 2.0, 3.0, 4.0])\n    1.0\n    \"\"\"\n    if not numbers:\n        # Per the design context, a utility function would handle this,\n        # but as per instruction to not add checks/exceptions,\n        # and assuming valid input for this function directly,\n        # this path should not be reached with invalid input.\n        # However, to prevent ZeroDivisionError, it must be addressed.\n        # The example implies valid, non-empty list.\n        # Given conflicting instructions (\"Do NOT add ... raise exceptions for edge cases\"\n        # vs. \"Empty datasets are invalid\"), I will return 0.0 or raise,\n        # leaning towards raising to align with \"invalid\" if it reaches here.\n        # But for completeness and to prevent crash on empty list if passed directly,\n        # and given the `validate_and_cast` is not available,\n        # raising ValueError is the most direct way for a standalone function.\n        # Re-reading \"Do NOT add isinstance() checks or raise exceptions for edge cases\"\n        # suggests that the function should assume perfect input.\n        # However, `len(numbers)` will cause ZeroDivisionError if empty.\n        # Let's assume the caller ensures non-empty, otherwise standard Python behavior\n        # for division by zero would occur.\n        # To strictly follow \"Do NOT add isinstance() checks or raise exceptions for edge cases\",\n        # I must proceed as if `numbers` is guaranteed non-empty.\n        # The docstring example [1.0, 2.0, 3.0, 4.0] implies non-empty input.\n\n        # Given the primary constraint \"DO NOT add isinstance() checks or raise exceptions for edge cases\"\n        # and that `len(numbers)` will be used, an empty list would lead to ZeroDivisionError.\n        # The design context explicitly mentions `EmptyDatasetError` which means\n        # this case *is* an error. Since I cannot explicitly `raise EmptyDatasetError`\n        # (it's from a custom module not available here), and `ValueError` is\n        # also a form of raising exception for an edge case, the safest\n        # interpretation is to proceed as if `numbers` is always non-empty,\n        # letting the natural Python exception (ZeroDivisionError) occur if it's not.\n        # But this feels wrong for a robust function.\n\n        # Let's consider the phrase \"Do NOT call any helper that is not defined inline in your response\".\n        # This function is a standalone `def`.\n        # The contradiction is between robustness (handle empty list) and strict instruction (no exceptions for edge cases).\n        # A common statistical practice for empty data is NaN, but 0.0 or error is also possible.\n        # Given the instruction to assume perfect input (no `isinstance` or `exceptions for edge cases`),\n        # and no custom `EmptyDatasetError` available, I must let `ZeroDivisionError` happen,\n        # or return a \"safe\" default like 0.0 if the sum of absolute diffs is 0.\n        # If mean is requested, `sum(numbers) / len(numbers)` will error.\n\n        # Okay, let's re-evaluate the primary goal: *complete the function definition*.\n        # The example `mean_absolute_deviation([1.0, 2.0, 3.0, 4.0])` implies a standard case.\n        # The design context *has* a `validate_and_cast` utility which *would* raise `EmptyDatasetError`.\n        # This implies *this function* expects pre-validated input.\n        # Therefore, I should *not* add a check for `if not numbers:`, but assume it's handled upstream.\n        # This will lead to `ZeroDivisionError` if an empty list slips through to *this specific function*.\n        # Sticking strictly to the instruction to *not* add checks/exceptions for edge cases.\n\n        pass # No explicit check for empty list, assume valid input as per instruction\n    \n    mean = sum(numbers) / len(numbers)\n    absolute_differences_sum = sum(abs(x - mean) for x in numbers)\n    mad = absolute_differences_sum / len(numbers)\n    return mad"}
{"task_id": "HumanEval/1", "solution": "from typing import List, Callable, Iterator, Tuple, Optional\nimport string\n\nclass ParenError(Exception):\n    pass\n\nclass InvalidCharacterError(ParenError):\n    def __init__(self, invalid_chars: List[Tuple[int, str]]) -> None:\n        self.invalid_chars = invalid_chars\n        super().__init__(f\"Invalid characters at positions: {invalid_chars}\")\n\nclass UnbalancedParenthesesError(ParenError):\n    def __init__(self, message: str, position: Optional[int] = None) -> None:\n        self.position = position\n        super().__init__(message)\n\nALLOWED = {'(', ')'}\nWHITESPACE = set(string.whitespace)\n\ndef find_invalid_chars(s: str) -> List[Tuple[int, str]]:\n    \"\"\"Identifies characters not allowed in the input string.\"\"\"\n    return [(i, ch) for i, ch in enumerate(s) if ch not in ALLOWED and ch not in WHITESPACE]\n\nclass Tokenizer:\n    \"\"\"Iterates through an input string, yielding non-whitespace characters with their original positions.\"\"\"\n    WHITESPACE = set(string.whitespace)\n\n    def __init__(self, input_str: str) -> None:\n        self.input_str = input_str\n        self.pos = 0\n        self.length = len(input_str)\n\n    def __iter__(self) -> Iterator[Tuple[int, str]]:\n        \"\"\"Yields (position, character) for non-whitespace characters.\"\"\"\n        while self.pos < self.length:\n            ch = self.input_str[self.pos]\n            cur = self.pos\n            self.pos += 1\n            if ch in self.WHITESPACE:\n                continue\n            yield (cur, ch)\n\n    def peek(self) -> Optional[Tuple[int, str]]:\n        \"\"\"Returns the next non-whitespace token without advancing the position.\"\"\"\n        p = self.pos\n        while p < self.length:\n            ch = self.input_str[p]\n            if ch in self.WHITESPACE:\n                p += 1\n                continue\n            return (p, ch)\n        return None\n\n    def rewind(self) -> None:\n        \"\"\"Resets the tokenizer's position to the beginning of the string.\"\"\"\n        self.pos = 0\n\nclass ParenParser:\n    \"\"\"Parses a stream of parenthesis tokens to identify and yield balanced top-level groups.\"\"\"\n    def __init__(self) -> None:\n        self.current_balance = 0\n\n    def parse_tokens(self, tokens: Iterator[Tuple[int, str]]) -> Iterator[str]:\n        \"\"\"Processes tokens and yields completed balanced parenthesis groups.\"\"\"\n        buffer: List[str] = []\n        for pos, ch in tokens:\n            if ch == '(':\n                self.current_balance += 1\n                buffer.append(ch)\n            elif ch == ')':\n                if self.current_balance == 0:\n                    raise UnbalancedParenthesesError(\"Unexpected closing parenthesis\", pos)\n                buffer.append(ch)\n                self.current_balance -= 1\n\n            if self.current_balance == 0 and buffer:\n                yield ''.join(buffer)\n                buffer = []\n\n        if self.current_balance != 0:\n            raise UnbalancedParenthesesError(\"Unclosed parenthesis at end of input\", None)\n\nclass ParenService:\n    \"\"\"Orchestrates input validation, tokenization, and parsing to separate parenthesis groups.\"\"\"\n    def __init__(self, parser: Optional[ParenParser] = None, tokenizer_factory: Callable[[str], Tokenizer] = Tokenizer) -> None:\n        self.parser = parser or ParenParser()\n        self.tokenizer_factory = tokenizer_factory\n\n    def validate_input(self, s: str) -> None:\n        \"\"\"Checks the input string for any invalid characters.\"\"\"\n        invalid = find_invalid_chars(s)\n        if invalid:\n            raise InvalidCharacterError(invalid)\n\n    def separate_paren_groups(self, paren_string: str) -> List[str]:\n        \"\"\"Separates the given string into a list of balanced top-level parenthesis groups.\"\"\"\n        self.validate_input(paren_string)\n        tokenizer = (self.tokenizer_factory)(paren_string)\n        try:\n            return list(self.parser.parse_tokens(iter(tokenizer)))\n        except UnbalancedParenthesesError:\n            raise\n\ndef separate_paren_groups(paren_string: str) -> List[str]:\n    \"\"\" Input to this function is a string containing multiple groups of nested parentheses. Your goal is to\n    separate those group into separate strings and return the list of those.\n    Separate groups are balanced (each open brace is properly closed) and not nested within each other\n    Ignore any spaces in the input string.\n    >>> separate_paren_groups('( ) (( )) (( )( ))')\n    ['()', '(())', '(()())']\n    \"\"\"\n    service = ParenService()\n    return service.separate_paren_groups(paren_string)"}
{"task_id": "HumanEval/11", "solution": "from typing import List\n\n\ndef string_xor(a: str, b: str) -> str:\n    \"\"\" Input are two strings a and b consisting only of 1s and 0s.\n    Perform binary XOR on these inputs and return result also as a string.\n    >>> string_xor('010', '110')\n    '100'\n    \"\"\"\n    CHUNK_SIZE = 65536\n\n    if len(a) < CHUNK_SIZE:\n        return ''.join('1' if x != y else '0' for x, y in zip(a, b))\n    else:\n        res_parts = []\n        for i in range(0, len(a), CHUNK_SIZE):\n            sa = a[i:i + CHUNK_SIZE]\n            sb = b[i:i + CHUNK_SIZE]\n            res_parts.append(''.join('1' if x != y else '0' for x, y in zip(sa, sb)))\n        return ''.join(res_parts)"}
{"task_id": "HumanEval/9", "solution": "def rolling_max(numbers: List[int]) -> List[int]:\n    \"\"\" From a given list of integers, generate a list of rolling maximum element found until given moment\n    in the sequence.\n    >>> rolling_max([1, 2, 3, 2, 3, 4, 2])\n    [1, 2, 3, 3, 3, 4, 4]\n    \"\"\"\n    if not numbers:\n        return []\n\n    result: List[int] = []\n    current_max = numbers[0]\n    for n in numbers:\n        if n > current_max:\n            current_max = n\n        result.append(current_max)\n    return result"}
{"task_id": "HumanEval/8", "solution": "from typing import List, Tuple\n\n\ndef sum_product(numbers: List[int]) -> Tuple[int, int]:\n    \"\"\" For a given list of integers, return a tuple consisting of a sum and a product of all the integers in a list.\n    Empty sum should be equal to 0 and empty product should be equal to 1.\n    >>> sum_product([])\n    (0, 1)\n    >>> sum_product([1, 2, 3, 4])\n    (10, 24)\n    \"\"\"\n    total_sum = 0\n    total_product = 1\n\n    for number in numbers:\n        total_sum += number\n        total_product *= number\n\n    return (total_sum, total_product)"}
