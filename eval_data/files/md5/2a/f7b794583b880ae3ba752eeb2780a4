{"task_id": "HumanEval/19", "solution": "from typing import List, Dict\n\n# Constants\nWORD_TO_INT: Dict[str, int] = {\n    \"zero\": 0, \"one\": 1, \"two\": 2, \"three\": 3, \"four\": 4,\n    \"five\": 5, \"six\": 6, \"seven\": 7, \"eight\": 8, \"nine\": 9\n}\nINT_TO_WORD: Dict[int, str] = {v: k for k, v in WORD_TO_INT.items()}\nVALID_WORDS: List[str] = list(WORD_TO_INT.keys())\n\n# Errors\nclass InvalidWordError(ValueError):\n    def __init__(self, invalid_tokens: List[str]) -> None:\n        self.invalid_tokens = invalid_tokens\n        self.message = f\"Invalid tokens: {', '.join(invalid_tokens)}\"\n        super().__init__(self.message)\n\nclass EmptyInputError(ValueError):\n    def __init__(self, message: str = \"Input is empty\") -> None:\n        self.message = message\n        super().__init__(self.message)\n\n# Models\nclass NumberWordList:\n    def __init__(self, tokens: List[str]) -> None:\n        self.tokens: List[str] = list(tokens)\n\n    def as_list(self) -> List[str]:\n        return list(self.tokens)\n\n# Utilities\ndef normalize_token(token: str) -> str:\n    return token.strip().lower()\n\ndef join_tokens(tokens: List[str]) -> str:\n    return \" \".join(tokens)\n\n# Parser\nclass Parser:\n    def parse(self, input_str: str) -> NumberWordList:\n        if input_str is None:\n            raise EmptyInputError()\n        trimmed = input_str.strip()\n        if not trimmed:\n            raise EmptyInputError()\n        raw_tokens: List[str] = trimmed.split()\n        tokens = [normalize_token(t) for t in raw_tokens]\n        return NumberWordList(tokens)\n\n# Validator\nclass Validator:\n    def validate(self, tokens: List[str]) -> None:\n        invalid = [t for t in tokens if t not in VALID_WORDS]\n        if invalid:\n            raise InvalidWordError(invalid)\n\n# Sorter\nclass Sorter:\n    def sort_words(self, tokens: List[str]) -> List[str]:\n        values = [WORD_TO_INT[t] for t in tokens]\n        values.sort()\n        return [INT_TO_WORD[v] for v in values]\n\n# Service\nclass SortService:\n    def __init__(self, parser: Parser = None, validator: Validator = None, sorter: Sorter = None) -> None:\n        self.parser = parser or Parser()\n        self.validator = validator or Validator()\n        self.sorter = sorter or Sorter()\n\n    def sort_numbers(self, numbers: str) -> str:\n        parsed = self.parser.parse(numbers)\n        tokens = parsed.as_list()\n        self.validator.validate(tokens)\n        sorted_tokens = self.sorter.sort_words(tokens)\n        return join_tokens(sorted_tokens)\n\n\ndef sort_numbers(numbers: str) -> str:\n    \"\"\" Input is a space-delimited string of numberals from 'zero' to 'nine'.\n    Valid choices are 'zero', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight' and 'nine'.\n    Return the string with numbers sorted from smallest to largest\n    >>> sort_numbers('three one five')\n    'one three five'\n    \"\"\"\n    service = SortService()\n    return service.sort_numbers(numbers)"}
