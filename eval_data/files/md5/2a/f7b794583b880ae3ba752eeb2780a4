{"task_id": "HumanEval/12", "solution": "def longest(strings: List[str]) -> Optional[str]:\n    \"\"\" Out of list of strings, return the longest one. Return the first one in case of multiple\n    strings of the same length. Return None in case the input list is empty.\n    >>> longest([])\n\n    >>> longest(['a', 'b', 'c'])\n    'a'\n    >>> longest(['a', 'bb', 'ccc'])\n    'ccc'\n    \"\"\"\n    if not strings:\n        return None\n\n    # Initialize with the first string to handle tie-breaking (return first encountered)\n    longest_string_found = strings[0]\n    max_length = len(strings[0])\n\n    # Iterate through the remaining strings to find a longer one\n    for s in strings[1:]:\n        current_length = len(s)\n        if current_length > max_length:\n            max_length = current_length\n            longest_string_found = s\n            \n    return longest_string_found"}
{"task_id": "HumanEval/10", "solution": "def is_palindrome(string: str) -> bool:\n    \"\"\" Test if given string is a palindrome \"\"\"\n    return string == string[::-1]\n\n\ndef make_palindrome(string: str) -> str:\n    \"\"\" Find the shortest palindrome that begins with a supplied string.\n    Algorithm idea is simple:\n    - Find the longest postfix of supplied string that is a palindrome.\n    - Append to the end of the string reverse of a string prefix that comes before the palindromic suffix.\n    >>> make_palindrome('')\n    ''\n    >>> make_palindrome('cat')\n    'catac'\n    >>> make_palindrome('cata')\n    'catac'\n    \"\"\"\n    if not string:\n        return \"\"\n\n    def _reverse_string(s: str) -> str:\n        \"\"\"Helper to reverse a string.\"\"\"\n        return s[::-1]\n\n    def _kmp_lps_table(pattern: str) -> list[int]:\n        \"\"\"Computes the Longest Proper Prefix which is also Suffix (LPS) array for KMP.\"\"\"\n        lps = [0] * len(pattern)\n        length = 0  # Length of the previous longest prefix suffix\n        i = 1\n        while i < len(pattern):\n            if pattern[i] == pattern[length]:\n                length += 1\n                lps[i] = length\n                i += 1\n            else:\n                if length != 0:\n                    length = lps[length - 1]\n                else:\n                    lps[i] = 0\n                    i += 1\n        return lps\n\n    # KMP-based approach to find the length of the longest palindromic suffix.\n    # We construct a pattern by concatenating reversed(S) + '#' + S.\n    # The last element of the LPS array for this pattern gives the length of the longest\n    # prefix of reversed(S) that is also a suffix of S, which is the length of the longest palindromic suffix of S.\n    \n    reversed_string = _reverse_string(string)\n    pattern = reversed_string + '#' + string\n    lps = _kmp_lps_table(pattern)\n    \n    longest_pal_suffix_len = lps[-1]\n    \n    # The prefix that needs to be reversed and appended is the part of the string\n    # that comes before this longest palindromic suffix.\n    prefix_to_reverse = string[:len(string) - longest_pal_suffix_len]\n    \n    # Construct the shortest palindrome by appending the reversed prefix.\n    return string + _reverse_string(prefix_to_reverse)"}
{"task_id": "HumanEval/18", "solution": "import collections\n\ndef how_many_times(string: str, substring: str) -> int:\n    \"\"\" Find how many times a given substring can be found in the original string. Count overlaping cases.\n    >>> how_many_times('', 'a')\n    0\n    >>> how_many_times('aaa', 'a')\n    3\n    >>> how_many_times('aaaa', 'aa')\n    3\n    \"\"\"\n    if substring == \"\" or string == \"\":\n        return 0\n    \n    m = len(substring)\n    count = 0\n    for i in range(len(string) - m + 1):\n        if string[i:i+m] == substring:\n            count += 1\n    return count"}
