ngth)\n\n\nclass IntervalParser:\n    \"\"\"\n    Converts raw user inputs into domain Interval objects and validates types.\n    \"\"\"\n    def parse_tuple(self, t: Any) -> Interval:\n        \"\"\"\n        Parses a 2-element tuple/list into an Interval object, raising ValidationError on invalid input.\n        \"\"\"\n        if not (isinstance(t, (list, tuple)) and len(t) == 2):\n            raise ValidationError(\"Interval must be a 2-tuple or list.\")\n        try:\n            s, e = int(t[0]), int(t[1])\n        except (ValueError, TypeError):\n            raise ValidationError(\"Interval elements must be integers.\")\n        return Interval(s, e)\n\n    def parse_two_tuples(self, a: Any, b: Any) -> Tuple[Interval, Interval]:\n        \"\"\"\n        Parses two raw inputs into two Interval objects.\n        \"\"\"\n        interval_a = self.parse_tuple(a)\n        interval_b = self.parse_tuple(b)\n        return interval_a, interval_b\n\n\ndef intersection(interval1, interval2):\n    \"\"\"\n    You are given two intervals,\n    where each interval is a pair of integers. For example, interval = (start, end) = (1, 2).\n    The given intervals are closed which means that the interval (start, end)\n    includes both start and end.\n    For each given interval, it is assumed that its start is less or equal its end.\n    Your task is to determine whether the length of intersection of these two \n    intervals is a prime number.\n    Example, the intersection of the intervals (1, 3), (2, 4) is (2, 3)\n    which its length is 1, which not a prime number.\n    If the length of the intersection is a prime number, return \"YES\",\n    otherwise, return \"NO\".\n    If the two intervals don't intersect, return \"NO\".\n    \"\"\"\n    parser = IntervalParser()\n    service = IntervalService()\n\n    a, b = parser.parse_two_tuples(interval1, interval2)\n    is_length_prime = service.intersection_length_is_prime(a, b)\n\n    return \"YES\" if is_length_prime else \"NO\""}
{"task_id": "HumanEval/130", "solution": "def tri(n):\n    \"\"\"Calculates the Tribonacci sequence up to the n-th term.\n\n    This function computes the first n+1 numbers of the Tribonacci sequence\n    based on the given recurrence relations.\n    \"\"\"\n    if n < 0:\n        # The problem statement implies n is a non-negative integer,\n        # but for robustness, a negative n would typically raise an error\n        # or return an empty list based on more specific requirements.\n        # For this context, assuming valid input n >= 0.\n        return []\n\n    # max_idx is the highest index we need to compute internally.\n    # If n is odd, tri(n) depends on tri(n+1), which is even. So we need to compute up to n+1.\n    # If n is even, tri(n) is computed directly by the even-index formula.\n    max_idx = n if n % 2 == 0 else n + 1\n\n    # Initialize the sequence list.\n    # We need max_idx + 1 elements, from index 0 to max_idx.\n    sequence = [0] * (max_idx + 1)\n\n    # Base cases and even indices\n    # tri(0) = 1 (from even formula: 1 + 0/2 = 1)\n    # tri(1) = 3 (given)\n\n    # Set tri(0)\n    sequence[0] = 1\n\n    # Set tri(1) if n >= 1\n    if max_idx >= 1:\n        sequence[1] = 3\n\n    # Compute all even indices using the formula tri(e) = 1 + e / 2\n    # Start from 0, step by 2.\n    for e in range(0, max_idx + 1, 2):\n        sequence[e] = 1 + (e // 2)\n\n    # Compute all odd indices using the recurrence tri(k) = tri(k-1) + tri(k-2) + tri(k+1)\n    # Start from 3, step by 2.\n    # Note: tri(k+1) is an even index and would have already been computed.\n    for k in range(3, max_idx + 1, 2):\n        sequence[k] = sequence[k - 1] + sequence[k - 2] + sequence[k + 1]\n\n    # The function asks for the first n+1 numbers, so slice the result.\n    # If n was odd, we computed up to n+1, so we need to truncate to n.\n    return sequence[:n + 1]"}
{"task_id": "HumanEval/128", "solution": "def prod_signs(arr):\n    \"\"\"\n    Calculates the sum of magnitudes of integers multiplied by the product of their signs.\n    Returns None for an empty array.\n    \"\"\"\n    if not arr:\n        return None\n\n    product_of_signs = 1\n    sum_of_magnitudes = 0\n\n    for x in arr:\n        # Determine the sign of the current number\n        sign_x = 0\n        if x > 0:\n            sign_x = 1\n        elif x < 0:\n            sign_x = -1\n\n        product_of_signs *= sign_x\n        sum_of_magnitudes += abs(x)\n\n        # If any number is zero, the product of signs becomes zero,\n        # making the final result zero regardless of other numbers.\n        if product_of_signs == 0:\n            return 0\n\n    return sum_of_magnitudes * product_of_signs"}
{"task_id": "HumanEval/132", "solution": "def is_nested(string):\n    '''\n    Create a function that takes a string as input which contains only square brackets.\n    The function should return True if and only if there is a valid subsequence of brackets \n    where at least one bracket in the subsequence is nested.\n    '''\n\n    class ValidationError(Exception):\n        def __init__(self, message: str) -> None:\n            super().__init__(message)\n            self.message = message\n\n    class Validator:\n        def validate_bracket_string(self, s: str) -> None:\n            # As per problem description, input is guaranteed to contain only square brackets.\n            # This validation check will therefore always pass for valid inputs under this guarantee.\n            if any(ch not in \"[]\" for ch in s):\n                raise ValidationError(\"Input must contain only '[' and ']' characters.\")\n\n    class BracketScanner:\n        def find_nested_pattern(self, s: str) -> bool:\n            \"\"\"\n            Determines if a string contains a subsequence matching '[[ ]]'.\n            This involves finding four indices i < j < k < l such that s[i]='[', s[j]='[', s[k]=']', s[l]=']'.\n            \"\"\"\n            n = len(s)\n            i = s.find('[')\n            if i == -1:\n                return False\n            j = s.find('[', i + 1)\n            if j == -1:\n                return False\n            k = s.find(']', j + 1)\n            if k == -1:\n                return False\n            l = s.find(']', k + 1)\n            return l != -1\n\n    class NestedService:\n        def __init__(self, validator: Validator, scanner: BracketScanner) -> None:\n            self._validator = validator\n            self._scanner = scanner\n\n        def is_nested(self, s: str) -> bool:\n            # The problem statement guarantees 's' contains only square brackets.\n            # Thus, the validator will not raise a ValidationError for such inputs.\n            self._validator.validate_bracket_string(s)\n            return self._scanner.find_nested_pattern(s)\n\n    # Instantiate the components and execute the check\n    validator = Validator()\n    scanner = BracketScanner()\n    service = NestedService(validator, scanner)\n    return service.is_nested(string)"}
{"task_id": "HumanEval/129", "solution": "class ValidationError(Exception):\n    \"\"\"Indicates invalid input (bad shape, missing numbers).\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\nclass GridError(Exception):\n    \"\"\"Indicates runtime grid inconsistencies.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\nclass Path:\n    \"\"\"Simple value object for the path result.\"\"\"\n    def __init__(self, values: list[int]) -> None:\n        self.values = values\n\n    def append(self, value: int) -> None:\n        self.values.append(value)\n\n    def to_list(self) -> list[int]:\n        return self.values\n\nclass Grid:\n    \"\"\"Stores NxN cells, provides neighbor lookup and mapping from value to position.\"\"\"\n    def __init__(self, cells: list[list[int]]) -> None:\n        if not cells or not isinstance(cells, list):\n            raise ValidationError(\"Grid must be a list of lists.\")\n        \n        self.size = len(cells)\n        if self.size < 2:\n            raise ValidationError(\"Grid must have at least 2 rows (N >= 2).\")\n        \n        for row_idx, row in enumerate(cells):\n            if not isinstance(row, list) or len(row) != self.size:\n                raise ValidationError(f\"Row {row_idx} has incorrect length or is not a list. Grid must be a square matrix.\")\n            for cell_val in row:\n                if not isinstance(cell_val, int):\n                    raise ValidationError(\"All grid cells must contain integers.\")\n\n        self._cells = cells\n        self._value_pos = {}\n        found_values = set()\n        expected_total_values = self.size * self.size\n\n        for r, row in enumerate(cells):\n            for c, val in enumerate(row):\n                if not (1 <= val <= expected_total_values):\n                    raise ValidationError(f\"Grid value {val} at ({r},{c}) out of expected range [1, {expected_total_values}].\")\n                if val in found_values:\n                    raise ValidationError(f\"Duplicate value {val} found in grid.\")\n                self._value_pos[val] = (r, c)\n                found_values.add(val)\n        \n        if len(found_values) != expected_total_values:\n            missing_values = set(range(1, expected_total_values + 1)) - found_values\n            raise ValidationError(f\"Missing values in grid: {sorted(list(missing_values))}.\")\n\n    def get_value(self, r: int, c: int) -> int:\n        \"\"\"Return cell value at (r,c), raising IndexError if out of bounds.\"\"\"\n        if not (0 <= r < self.size and 0 <= c < self.size):\n            raise IndexError(f\"Row {r} or column {c} index out of bounds for grid size {self.size}.\")\n        return self._cells[r][c]\n\n    def get_pos(self, value: int) -> tuple[int, int]:\n        \"\"\"Return (r,c) for value, raising KeyError if value not present.\"\"\"\n        if value not in self._value_pos:\n            raise KeyError(f\"Value {value} not found in grid.\")\n        return self._value_pos[value]\n\n    def neighbors(self, r: int, c: int) -> list[tuple[int, int]]:\n        \"\"\"Return a list of valid orthogonal neighbor positions for cell (r,c).\"\"\"\n        candidates = [(r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)]\n        return [(nr, nc) for nr, nc in candidates if 0 <= nr < self.size and 0 <= nc < self.size]\n\nclass PathFinder:\n    \"\"\"Algorithm to find the lexicographically minimum path by step-wise neighbor minimum selection.\"\"\"\n    def __init__(self, grid: Grid) -> None:\n        self.grid = grid\n\n    def next_min_neighbor(self, r: int, c: int) -> tuple[int, int]:\n        \"\"\"Identifies the neighbor cell with the smallest value from the current position (r,c).\"\"\"\n        neigh = self.grid.neighbors(r, c)\n        if not neigh:\n            raise GridError(f\"No neighbors available for position ({r},{c}).\")\n        \n        best = min(neigh, key=lambda p: self.grid.get_value(p[0], p[1]))\n        return best\n\n    def compute_path(self, start_r: int, start_c: int, k: int) -> Path:\n        \"\"\"Computes a path of length k, starting from (start_r, start_c), by always choosing the minimum value neighbor.\"\"\"\n        if k < 1:\n            raise ValueError(\"k must be a positive integer (k >= 1).\")\n        \n        path = Path([self.grid.get_value(start_r, start_c)])\n        current_r, current_c = start_r, start_c\n\n        for _ in range(k - 1):\n            next_r, next_c = self.next_min_neighbor(current_r, current_c)\n            path.append(self.grid.get_value(next_r, next_c))\n            current_r, current_c = next_r, next_c\n        \n        return path\n\ndef minPath(grid: list[list[int]], k: int) -> list[int]:\n    \"\"\"\n    Given a grid with N rows and N columns (N >= 2) and a positive integer k, \n    each cell of the grid contains a value. Every integer in the range [1, N * N]\n    inclusive appears exactly once on the cells of the grid.\n\n    You have to find the minimum path of length k in the grid. You can start\n    from any cell, and in each step you can move to any of the neighbor cells,\n    in other words, you can go to cells which share an edge with you current\n    cell.\n    Please note that a path of length k means visiting exactly k cells (not\n    necessarily distinct).\n    You CANNOT go off the grid.\n    A path A (of length k) is considered less than a path B (of length k) if\n    after making the ordered lists of the values on the cells that A and B go\n    through (let's call them lst_A and lst_B), lst_A is lexicographically less\n    than lst_B, in other words, there exist an integer index i (1 <= i <= k)\n    such that lst_A[i] < lst_B[i] and for any j (1 <= j < i) we have\n    lst_A[j] = lst_B[j].\n    It is guaranteed that the answer is unique.\n    Return an ordered list of the values on the cells that the minimum path go through.\n\n    Examples:\n\n        Input: grid = [ [1,2,3], [4,5,6], [7,8,9]], k = 3\n        Output: [1, 2, 1]\n\n        Input: grid = [ [5,9,3], [4,1,6], [7,8,2]], k = 1\n        Output: [1]\n    \"\"\"\n    grid_obj = Grid(grid)\n\n    if k < 1:\n        raise ValueError(\"k must be a positive integer (k >= 1).\")\n\n    # The lexicographically smallest path must start with the smallest possible value in the grid.\n    # By problem definition, this value is guaranteed to be 1.\n    start_r, start_c = grid_obj.get_pos(1)\n\n    path_finder = PathFinder(grid_obj)\n    path_obj = path_finder.compute_path(start_r, start_c, k)\n\n    return path_obj.to_list()"}
{"task_id": "HumanEval/131", "solution": "def digits(n):\n    \"\"\"Given a positive integer n, return the product of the odd digits.\n    Return 0 if all digits are even.\n    For example:\n    digits(1)  == 1\n    digits(4)  == 0\n    digits(235) == 15\n    \"\"\"\n    product = 1\n    found_odd = False\n    for char_digit in str(n):\n        digit = int(char_digit)\n        if digit % 2 == 1:\n            product *= digit\n            found_odd = True\n    return product if found_odd else 0"}
{"task_id": "HumanEval/135", "solution": "def can_arrange(arr):\n    \"\"\"\n    Returns the largest index of an element which is not greater than or equal\n    to the element immediately preceding it. If no such element exists then return -1.\n    \"\"\"\n    n = len(arr)\n    if n < 2:\n        return -1\n\n    for i in range(n - 1, 0, -1):\n        if arr[i] < arr[i - 1]:\n            return i\n    return -1"}
{"task_id": "HumanEval/134", "solution": "def check_if_last_char_is_a_letter(txt):\n    \"\"\"\n    Checks if the last character of a string is an alphabetical character and is not part of a word.\n    Newlines are trimmed, but trailing spaces result in False.\n    \"\"\"\n    if not txt:\n        return False\n\n    # Remove trailing newline characters only, not other whitespace like spaces.\n    while txt.endswith(\"\\n\") or txt.endswith(\"\\r\"):\n        txt = txt[:-1]\n\n    # If the string becomes empty after stripping newlines, return False.\n    if txt == \"\":\n        return False\n\n    # A trailing space means the last token is empty, thus not an isolated letter.\n    if txt.endswith(\" \"):\n        return False\n\n    last_char = txt[-1]\n\n    # If the last character is not alphabetical, return False.\n    if not last_char.isalpha():\n        return False\n\n    # If the string has only one character, and it's alphabetical, it's isolated.\n    if len(txt) == 1:\n        return True\n\n    # For multi-character strings, the character before the last one must be a space\n    # for the last character to be considered isolated.\n    return txt[-2] == \" \""}
{"task_id": "HumanEval/133", "solution": "import math\n\ndef sum_squares(lst):\n    \"\"\"You are given a list of numbers.\n    You need to return the sum of squared numbers in the given list,\n    round each element in the list to the upper int(Ceiling) first.\n    Examples:\n    For lst = [1,2,3] the output should be 14\n    For lst = [1,4,9] the output should be 98\n    For lst = [1,3,5,7] the output should be 84\n    For lst = [1.4,4.2,0] the output should be 29\n    For lst = [-2.4,1,1] the output should be 6\n    \"\"\"\n    total_sum_of_squares = 0\n    for number in lst:\n        # Round each number up to the nearest integer (ceiling)\n        ceiled_number = math.ceil(number)\n        # Square the ceiled number and add it to the total sum\n        total_sum_of_squares += ceiled_number * ceiled_number\n    return total_sum_of_squares"}
{"task_id": "HumanEval/138", "solution": "def is_equal_to_sum_even(n):\n    \"\"\"Evaluate whether the given number n can be written as the sum of exactly 4 positive even numbers\n    Example\n    is_equal_to_sum_even(4) == False\n    is_equal_to_sum_even(6) == False\n    is_equal_to_sum_even(8) == True\n    \"\"\"\n    # A number can be written as the sum of exactly 4 positive even numbers\n    # if and only if it is even and greater than or equal to 8.\n    return n % 2 == 0 and n >= 8"}
{"task_id": "HumanEval/136", "solution": "def largest_smallest_integers(lst):\n    '''\n    Create a function that returns a tuple (a, b), where 'a' is\n    the largest of negative integers, and 'b' is the smallest\n    of positive integers in a list.\n    If there is no negative or positive integers, return them as None.\n\n    Examples:\n    largest_smallest_integers([2, 4, 1, 3, 5, 7]) == (None, 1)\n    largest_smallest_integers([]) == (None, None)\n    largest_smallest_integers([0]) == (None, None)\n    '''\n    largest_neg = None\n    smallest_pos = None\n\n    for x in lst:\n        if x < 0:\n            if largest_neg is None or x > largest_neg:\n                largest_neg = x\n        elif x > 0:  # x is positive\n            if smallest_pos is None or x < smallest_pos:\n                smallest_pos = x\n        # Zero (0) is neither positive nor negative and is ignored.\n    \n    return (largest_neg, smallest_pos)"}
{"task_id": "HumanEval/137", "solution": "import re\nfrom typing import Union, Optional, Any, Tuple\n\nclass ValueParseError(Exception):\n    \"\"\"Custom exception for errors during value parsing.\"\"\"\n    def __init__(self, message: str, value: Any = None) -> None:\n        super().__init__(message)\n        self.message = message\n        self.value = value\n\n    def __str__(self) -> str:\n        if self.value is not None:\n            return f\"{self.message}: {self.value!r}\"\n        return self.message\n\nclass ValueWrapper:\n    \"\"\"Wrapper to store original value and its normalized numeric representation.\"\"\"\n    def __init__(self, original: Union[int, float, str], numeric: float) -> None:\n        self.original: Union[int, float, str] = original\n        self.numeric: float = numeric\n\n    def __repr__(self) -> str:\n        return f\"ValueWrapper(original={self.original!r}, numeric={self.numeric})\"\n\nclass NumberParser:\n    \"\"\"Parses various types into ValueWrapper instances.\"\"\"\n    DECIMAL_DOT: str = '.'\n    DECIMAL_COMMA: str = ','\n\n    # Regex pattern for valid float strings after decimal normalization.\n    # It allows an optional sign, followed by either:\n    # 1. one or more digits, optionally followed by a decimal point and zero or more digits (e.g., \"1\", \"1.0\", \"5.\")\n    # 2. a decimal point followed by one or more digits (e.g., \".5\")\n    # This pattern enforces a single logical decimal point and rejects explicit thousands separators.\n    _NUMERIC_STR_PATTERN = re.compile(r\"^[+-]?(\\d+(\\.\\d*)?|\\.\\d+)$\")\n\n    @staticmethod\n    def parse(value: Union[int, float, str]) -> ValueWrapper:\n        \"\"\"\n        Converts an input value (int, float, or str) into a ValueWrapper.\n        Raises ValueParseError for invalid string formats or unsupported types.\n        \"\"\"\n        if isinstance(value, (int, float)):\n            return ValueWrapper(original=value, numeric=float(value))\n        if isinstance(value, str):\n            try:\n                numeric = NumberParser._parse_str(value)\n            except ValueParseError:\n                raise # Re-raise parsing errors\n            return ValueWrapper(original=value, numeric=numeric)\n        raise ValueParseError(f\"Unsupported input type: {type(value).__name__}\", value)\n\n    @staticmethod\n    def _parse_str(s: str) -> float:\n        \"\"\"\n        Internal method to parse a string into a float, handling decimal separators.\n        Enforces rules about single decimal separator and valid numeric format.\n        \"\"\"\n        s_stripped = s.strip()\n        \n        dot_count = s_stripped.count(NumberParser.DECIMAL_DOT)\n        comma_count = s_stripped.count(NumberParser.DECIMAL_COMMA)\n\n        if dot_count > 1 or comma_count > 1:\n            raise ValueParseError(\"Multiple decimal separators found\", s)\n        if dot_count == 1 and comma_count == 1:\n            raise ValueParseError(\"Both dot and comma used as decimal separators\", s)\n\n        normalized_s = s_stripped\n        if comma_count == 1:\n            normalized_s = s_stripped.replace(NumberParser.DECIMAL_COMMA, NumberParser.DECIMAL_DOT)\n\n        if not normalized_s: # Handle empty string after stripping\n            raise ValueParseError(\"Empty string cannot be parsed to a number\", s)\n\n        if not NumberParser._NUMERIC_STR_PATTERN.fullmatch(normalized_s):\n            raise ValueParseError(\"Invalid numeric string format\", s)\n\n        try:\n            return float(normalized_s)\n        except ValueError as e: # Fallback for unexpected float conversion issues\n            raise ValueParseError(f\"Could not convert string to float: {e}\", s)\n\nclass CompareService:\n    \"\"\"Provides business logic for comparing two values.\"\"\"\n    def __init__(self, parser: NumberParser = None):\n        # Allow dependency injection for testing, otherwise use default\n        self._parser = parser or NumberParser()\n\n    def compare(self, a: Union[int, float, str], b: Union[int, float, str]) -> Optional[Union[int, float, str]]:\n        \"\"\"\n        Compares two values (int, float, or string numbers) and returns the larger.\n        Returns None if values are numerically equal.\n        \"\"\"\n        va = self._parser.parse(a)\n        vb = self._parser.parse(b)\n        return self._compare_wrappers(va, vb)\n\n    def _compare_wrappers(self, va: ValueWrapper, vb: ValueWrapper) -> Optional[Union[int, float, str]]:\n        \"\"\"Compares two ValueWrapper instances based on their numeric values.\"\"\"\n        if va.numeric > vb.numeric:\n            return va.original\n        if va.numeric < vb.numeric:\n            return vb.original\n        return None # Values are numerically equal\n\n# Instantiate the service once at the module level as per design\n_compare_service = CompareService()\n\ndef compare_one(a, b):\n    \"\"\"\n    Create a function that takes integers, floats, or strings representing\n    real numbers, and returns the larger variable in its given variable type.\n    Return None if the values are equal.\n    Note: If a real number is represented as a string, the floating point might be . or ,\n\n    compare_one(1, 2.5) \u279e 2.5\n    compare_one(1, \"2,3\") \u279e \"2,3\"\n    compare_one(\"5,1\", \"6\") \u279e \"6\"\n    compare_one(\"1\", 1) \u279e None\n    \"\"\"\n    return _compare_service.compare(a, b)"}
{"task_id": "HumanEval/141", "solution": "def file_name_check(file_name):\n    \"\"\"Create a function which takes a string representing a file's name, and returns\n    'Yes' if the the file's name is valid, and returns 'No' otherwise.\n    A file's name is considered to be valid if and only if all the following conditions \n    are met:\n    - There should not be more than three digits ('0'-'9') in the file's name.\n    - The file's name contains exactly one dot '.'\n    - The substring before the dot should not be empty, and it starts with a letter from \n    the latin alphapet ('a'-'z' and 'A'-'Z').\n    - The substring after the dot should be one of these: ['txt', 'exe', 'dll']\n    Examples:\n    file_name_check(\"example.txt\") # => 'Yes'\n    file_name_check(\"1example.dll\") # => 'No' (the name should start with a latin alphapet letter)\n    \"\"\"\n    # Check for exactly one dot in the file name.\n    if file_name.count('.') != 1:\n        return 'No'\n\n    # Split the file name into prefix and extension.\n    prefix, ext = file_name.rsplit('.', 1)\n\n    # Check if the prefix is not empty.\n    if not prefix:\n        return 'No'\n\n    # Check if the prefix starts with a Latin alphabet letter.\n    first_char_prefix = prefix[0]\n    if not ('a' <= first_char_prefix <= 'z' or 'A' <= first_char_prefix <= 'Z'):\n        return 'No'\n\n    # Check if the extension is one of the allowed types.\n    allowed_extensions = ['txt', 'exe', 'dll']\n    if ext not in allowed_extensions:\n        return 'No'\n\n    # Count digits in the entire file name and ensure it's not more than three.\n    digit_count = sum(1 for char in file_name if '0' <= char <= '9')\n    if digit_count > 3:\n        return 'No'\n\n    # If all conditions pass, the file name is valid.\n    return 'Yes'"}
{"task_id": "HumanEval/139", "solution": "import sqlite3\nimport os\n\nclass InvalidInputError(Exception):\n    \"\"\"Custom exception for invalid input values.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\nclass MathUtils:\n    \"\"\"Provides optimized math routines for factorial calculations.\"\"\"\n    def factorial(self, n: int) -> int:\n        \"\"\"Computes n! using iterative multiplication.\"\"\"\n        if n < 0:\n            raise InvalidInputError(\"n must be non-negative for factorial computation.\")\n        result = 1\n        for i in range(2, n + 1):\n            result *= i\n        return result\n\n    def multiply_range_factorials(self, start: int, end: int) -> int:\n        \"\"\"Computes the product of k! for k in the range [start, end].\"\"\"\n        if start > end:\n            return 1\n        prod = 1\n        for k in range(start, end + 1):\n            prod *= self.factorial(k)\n        return prod\n\nclass FactorialRepository:\n    \"\"\"Manages persistence and retrieval of factorial values in an SQLite database.\"\"\"\n    DEFAULT_DB_PATH = \"./data/factorials.db\"\n\n    def __init__(self, db_path: str = DEFAULT_DB_PATH) -> None:\n        self.db_path = db_path\n        os.makedirs(os.path.dirname(db_path), exist_ok=True)\n        self.conn = sqlite3.connect(self.db_path, check_same_thread=False)\n        self.migrate_schema()\n\n    def migrate_schema(self) -> None:\n        \"\"\"Ensures the factorials table exists in the database.\"\"\"\n        self.conn.execute(\"\"\"\n        CREATE TABLE IF NOT EXISTS factorials (\n            n INTEGER PRIMARY KEY,\n            value TEXT NOT NULL,\n            computed_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP\n        )\n        \"\"\")\n        self.conn.commit()\n\n    def get(self, n: int) -> int | None:\n        \"\"\"Retrieves the factorial of n from the repository.\"\"\"\n        cur = self.conn.execute(\"SELECT value FROM factorials WHERE n = ?\", (n,))\n        row = cur.fetchone()\n        return int(row[0]) if row else None\n\n    def set(self, n: int, value: int) -> None:\n        \"\"\"Stores the factorial of n in the repository.\"\"\"\n        self.conn.execute(\"INSERT OR REPLACE INTO factorials(n, value) VALUES (?, ?)\", (n, str(value)))\n        self.conn.commit()\n\n    def bulk_get(self, max_n: int) -> dict[int, int]:\n        \"\"\"Retrieves all cached factorials up to max_n.\"\"\"\n        cur = self.conn.execute(\"SELECT n, value FROM factorials WHERE n <= ? ORDER BY n ASC\", (max_n,))\n        return {row[0]: int(row[1]) for row in cur.fetchall()}\n\n    def close(self) -> None:\n        \"\"\"Closes the database connection.\"\"\"\n        self.conn.close()\n\nclass SpecialFactorialService:\n    \"\"\"Orchestrates the computation of the special factorial, utilizing caching and math utilities.\"\"\"\n    def __init__(self, repo: FactorialRepository, math: MathUtils) -> None:\n        self.repo = repo\n        self.math = math\n\n    def _validate(self, n: int) -> None:\n        \"\"\"Validates that n is a positive integer.\"\"\"\n        if not isinstance(n, int) or n <= 0:\n            raise InvalidInputError(\"Input 'n' must be a positive integer.\")\n\n    def compute(self, n: int) -> int:\n        \"\"\"Computes the Brazilian factorial for a given positive integer n.\"\"\"\n        self._validate(n)\n\n        cached_factorials = self.repo.bulk_get(n)\n        factorials = {k: v for k, v in cached_factorials.items()}\n\n        highest_cached_n = max(factorials.keys()) if factorials else 0\n\n        current_factorial_value = factorials.get(highest_cached_n, 1) # Value of highest_cached_n! or 1 if nothing cached\n\n        if highest_cached_n == 0:\n            # If nothing is cached, ensure 1! is calculated and stored to start the sequence\n            if 1 not in factorials:\n                factorials[1] = 1\n                self.repo.set(1, 1)\n            highest_cached_n = 1 # Now 1! is available, continue from 2\n\n        # Compute and cache any missing factorials incrementally up to n\n        for k in range(highest_cached_n + 1, n + 1):\n            current_factorial_value *= k\n            factorials[k] = current_factorial_value\n            self.repo.set(k, current_factorial_value)\n\n        # Calculate the special factorial: product of k! for k from 1 to n\n        special_factorial_result = 1\n        for k in range(1, n + 1):\n            special_factorial_result *= factorials[k]\n\n        return special_factorial_result\n\n# Module-level instances for reuse across calls to special_factorial.\n_math_utils = MathUtils()\n_factorial_repo = FactorialRepository()\n_special_factorial_service = SpecialFactorialService(_factorial_repo, _math_utils)\n\ndef special_factorial(n):\n    \"\"\"The Brazilian factorial is defined as:\n    brazilian_factorial(n) = n! * (n-1)! * (n-2)! * ... * 1!\n    where n > 0\n\n    For example:\n    >>> special_factorial(4)\n    288\n\n    The function will receive an integer as input and should return the special\n    factorial of this integer.\n    \"\"\"\n    return _special_factorial_service.compute(n)"}
{"task_id": "HumanEval/140", "solution": "import re\n\ndef fix_spaces(text):\n    \"\"\"\n    Given a string text, replace all spaces in it with underscores, \n    and if a string has more than 2 consecutive spaces, \n    then replace all consecutive spaces with - \n    \"\"\"\n    # First, replace sequences of 3 or more spaces with a single hyphen.\n    text = re.sub(r\" {3,}\", \"-\", text)\n    # Then, replace any remaining single or double spaces with underscores.\n    text = text.replace(\" \", \"_\")\n    return text"}
{"task_id": "HumanEval/142", "solution": "def sum_squares(lst):\n    \"\"\"\"\n    This function will take a list of integers. For all entries in the list, the function shall square the integer entry if its index is a \n    multiple of 3 and will cube the integer entry if its index is a multiple of 4 and not a multiple of 3. The function will not \n    change the entries in the list whose indexes are not a multiple of 3 or 4. The function shall then return the sum of all entries. \n    \n    Examples:\n    For lst = [1,2,3] the output should be 6\n    For lst = []  the output should be 0\n    For lst = [-1,-5,2,-1,-5]  the output should be -126\n    \"\"\"\n    total_sum = 0\n    for i, num in enumerate(lst):\n        if i % 3 == 0:\n            total_sum += num * num\n        elif i % 4 == 0: # This condition implies i % 3 != 0 because of the preceding if-statement.\n            total_sum += num * num * num\n        else:\n            total_sum += num\n    return total_sum"}
{"task_id": "HumanEval/143", "solution": "import math\nfrom typing import List, Optional\n\nclass InvalidSentenceError(Exception):\n    \"\"\"Custom exception for invalid sentence input.\"\"\"\n    def __init__(self, message: str) -> None:\n        self.message = message\n        super().__init__(message)\n\nMAX_SENTENCE_LENGTH: int = 100\n\nclass WordModel:\n    \"\"\"Represents a single word with its text and length.\"\"\"\n    def __init__(self, text: str) -> None:\n        self.text = text\n        self.length = len(text)\n\nclass SentenceModel:\n    \"\"\"Parses a sentence into words without validation as per prompt.\"\"\"\n    def __init__(self, text: str) -> None:\n        self.text = text\n\n    def parse_words(self) -> List[\"WordModel\"]:\n        \"\"\"Splits the sentence text into WordModel objects.\"\"\"\n        tokens = [t for t in self.text.split() if t]\n        return [WordModel(t) for t in tokens]\n\nclass PrimeUtils:\n    \"\"\"Provides utility for checking primality with a cache.\"\"\"\n    def __init__(self) -> None:\n        self._cache: dict[int,bool] = {0: False, 1: False, 2: True, 3: True}\n\n    def is_prime(self, n: int) -> bool:\n        \"\"\"Checks if a number is prime using trial division up to sqrt(n).\"\"\"\n        if n in self._cache:\n            return self._cache[n]\n        if n < 2:\n            res = False\n        elif n % 2 == 0:\n            res = (n == 2)\n        else:\n            limit = int(math.isqrt(n))\n            i = 3\n            res = True\n            while i <= limit:\n                if n % i == 0:\n                    res = False\n                    break\n                i += 2\n        self._cache[n] = res\n        return res\n\nclass WordFilterService:\n    \"\"\"Business logic for filtering words by prime-length and formatting.\"\"\"\n    def __init__(self, prime_utils: Optional[PrimeUtils] = None) -> None:\n        self.prime_utils = prime_utils or PrimeUtils()\n\n    def filter(self, sentence_text: str) -> List[WordModel]:\n        \"\"\"Filters words in a sentence, keeping only those with prime lengths.\"\"\"\n        sentence = SentenceModel(sentence_text)\n        words = sentence.parse_words()\n        return [w for w in words if self.prime_utils.is_prime(w.length)]\n\n    def format_result(self, words: List[WordModel]) -> str:\n        \"\"\"Joins a list of WordModel objects into a space-separated string.\"\"\"\n        return \" \".join(w.text for w in words)\n\ndef words_in_sentence(sentence):\n    \"\"\"\n    You are given a string representing a sentence,\n    the sentence contains some words separated by a space,\n    and you have to return a string that contains the words from the original sentence,\n    whose lengths are prime numbers,\n    the order of the words in the new string should be the same as the original one.\n    \"\"\"\n    service = WordFilterService()\n    words = service.filter(sentence)\n    return service.format_result(words)"}
{"task_id": "HumanEval/144", "solution": "import math\nimport re\nfrom dataclasses import dataclass\n\nclass FractionError(Exception):\n    \"\"\"Base exception for fraction operations.\"\"\"\n    pass\n\nclass FractionParseError(FractionError):\n    \"\"\"Raised when a fraction string cannot be parsed.\"\"\"\n    pass\n\nclass FractionArithmeticError(FractionError):\n    \"\"\"Raised for arithmetic issues with fractions.\"\"\"\n    pass\n\ndef gcd(a: int, b: int) -> int:\n    \"\"\"Returns the greatest common divisor of a and b.\"\"\"\n    return math.gcd(a, b)\n\n@dataclass(frozen=True)\nclass Fraction:\n    numerator: int\n    denominator: int\n\n    def __init__(self, numerator: int, denominator: int) -> None:\n        if denominator == 0:\n            raise FractionArithmeticError(\"Denominator cannot be zero\")\n        object.__setattr__(self, \"numerator\", int(numerator))\n        object.__setattr__(self, \"denominator\", int(denominator))\n\n    def reduce(self) -> \"Fraction\":\n        \"\"\"Returns a new Fraction object reduced to its lowest terms.\"\"\"\n        common_divisor = gcd(abs(self.numerator), abs(self.denominator))\n        return Fraction(self.numerator // common_divisor, self.denominator // common_divisor)\n\n    def multiply(self, other: \"Fraction\") -> \"Fraction\":\n        \"\"\"Returns a new Fraction object representing the product of this fraction and another.\"\"\"\n        return Fraction(self.numerator * other.numerator, self.denominator * other.denominator)\n\n    def is_whole(self) -> bool:\n        \"\"\"Checks if the fraction represents a whole number.\"\"\"\n        return self.numerator % self.denominator == 0\n\n    def to_tuple(self) -> tuple[int, int]:\n        \"\"\"Returns the fraction as a (numerator, denominator) tuple.\"\"\"\n        return self.numerator, self.denominator\n\nFRACTION_RE = re.compile(r\"^\\s*(\\d+)\\s*/\\s*(\\d+)\\s*$\")\n\nclass FractionParser:\n    \"\"\"Parses a string into a Fraction object.\"\"\"\n    def parse(self, s: str) -> Fraction:\n        m = FRACTION_RE.match(s)\n        if not m:\n            raise FractionParseError(f\"Invalid fraction string: {s!r}\")\n        num, den = int(m.group(1)), int(m.group(2))\n        if den == 0:\n            raise FractionParseError(\"Denominator cannot be zero\")\n        return Fraction(num, den)\n\nclass InMemoryCache:\n    \"\"\"Simple in-memory cache for storing computed boolean results.\"\"\"\n    MAX_CACHE_SIZE = 1000\n\n    def __init__(self, max_size: int = MAX_CACHE_SIZE) -> None:\n        self._store: dict[str, bool] = {}\n        self._max_size = max_size\n\n    def get(self, key: str) -> bool | None:\n        \"\"\"Retrieves a value from the cache.\"\"\"\n        return self._store.get(key)\n\n    def set(self, key: str, value: bool) -> None:\n        \"\"\"Sets a value in the cache, managing its size.\"\"\"\n        if len(self._store) >= self._max_size:\n            # Simple FIFO eviction\n            if self._store:\n                del self._store[next(iter(self._store))]\n        self._store[key] = value\n\n    def make_key(self, x: str, n: str) -> str:\n        \"\"\"Generates a canonical key for the cache.\"\"\"\n        # Using a consistent separator for the key\n        return f\"{x}|{n}\"\n\nclass SimplifierService:\n    \"\"\"Orchestrates parsing, multiplication, and checking if a product is a whole number.\"\"\"\n    def __init__(self, parser: FractionParser | None = None, cache: InMemoryCache | None = None) -> None:\n        self._parser = parser or FractionParser()\n        self._cache = cache\n\n    def simplify(self, x: str, n: str) -> bool:\n        \"\"\"Simplifies the product of two fractions and checks if it's a whole number.\"\"\"\n        key = None\n        if self._cache:\n            key = self._cache.make_key(x, n)\n            cached = self._cache.get(key)\n            if cached is not None:\n                return cached\n\n        fx = self._parser.parse(x)\n        fn = self._parser.parse(n)\n\n        product = self._product_fraction(fx, fn).reduce()\n        result = product.is_whole()\n\n        if self._cache and key:\n            self._cache.set(key, result)\n\n        return result\n\n    @staticmethod\n    def _product_fraction(fx: Fraction, fn: Fraction) -> Fraction:\n        \"\"\"Computes the product of two Fraction objects.\"\"\"\n        return fx.multiply(fn)\n\ndef simplify(x, n):\n    \"\"\"Your task is to implement a function that will simplify the expression\n    x * n. The function returns True if x * n evaluates to a whole number and False\n    otherwise. Both x and n, are string representation of a fraction, and have the following format,\n    <numerator>/<denominator> where both numerator and denominator are positive whole numbers.\n    \"\"\"\n    service = SimplifierService(parser=FractionParser(), cache=InMemoryCache())\n    return service.simplify(x, n)"}
{"task_id": "HumanEval/145", "solution": "import math\n\ndef order_by_points(nums):\n    \"\"\"\n    Sorts the given list of integers in ascending order according to the sum of their digits,\n    maintaining original relative order for items with similar digit sums.\n    \"\"\"\n\n    def compute_digit_sum(n: int) -> int:\n        \"\"\"Calculates the sum of the absolute value of the digits of a number.\"\"\"\n        return sum(int(d) for d in str(abs(n)))\n\n    # Create a list of tuples: (digit_sum, original_index, original_number)\n    # This allows sorting by digit_sum first, then by original_index for stability.\n    processed_nums = []\n    for i, num in enumerate(nums):\n        digit_sum = compute_digit_sum(num)\n        processed_nums.append((digit_sum, i, num))\n\n    # Sort the list of tuples based on the first element (digit_sum)\n    # and then the second element (original_index) for stable sorting.\n    processed_nums.sort()\n\n    # Extract the original numbers from the sorted list\n    return [item[2] for item in processed_nums]"}
{"task_id": "HumanEval/148", "solution": "\nORDERED_PLANETS = [\"Mercury\", \"Venus\", \"Earth\", \"Mars\", \"Jupiter\", \"Saturn\", \"Uranus\", \"Neptune\"]\n\ndef bf(planet1, planet2):\n    \"\"\"\n    Returns a tuple of planets whose orbits are between planet1 and planet2,\n    sorted by proximity to the sun. Returns an empty tuple if planet names are invalid.\n    \"\"\"\n    \n    def _get_planet_index(planet_name):\n        \"\"\"Normalize planet name and return its index, or None if invalid.\"\"\"\n        if not isinstance(planet_name, str):\n            return None\n        normalized_name = planet_name.strip().title()\n        try:\n            return ORDERED_PLANETS.index(normalized_name)\n        except ValueError:\n            return None\n\n    index1 = _get_planet_index(planet1)\n    index2 = _get_planet_index(planet2)\n\n    if index1 is None or index2 is None:\n        return ()\n\n    # Determine the slice range, ensuring correct order and exclusivity\n    start = min(index1, index2) + 1\n    end = max(index1, index2)\n    \n    # If planets are adjacent or the same, the range will be empty, returning an empty tuple\n    return tuple(ORDERED_PLANETS[start:end])"}
{"task_id": "HumanEval/146", "solution": "def specialFilter(nums):\n    \"\"\"Write a function that takes an array of numbers as input and returns \n    the number of elements in the array that are greater than 10 and both \n    first and last digits of a number are odd (1, 3, 5, 7, 9).\n    \"\"\"\n\n    def is_odd_digit(d):\n        return d in (1, 3, 5, 7, 9)\n\n    def get_integer_part(n):\n        \"\"\"Returns the integer part of a number, truncating towards zero.\"\"\"\n        return int(n)\n\n    def get_first_digit(n_int):\n        \"\"\"Returns the first digit of the absolute value of an integer.\"\"\"\n        if n_int == 0:\n            return 0\n        return int(str(abs(n_int))[0])\n\n    def get_last_digit(n_int):\n        \"\"\"Returns the last digit of the absolute value of an integer.\"\"\"\n        return abs(n_int) % 10\n\n    count = 0\n    for num in nums:\n        if num > 10:\n            # For digit extraction, consider only the integer part (truncated towards zero)\n            # and ignore the sign for the digits themselves.\n            int_part = get_integer_part(num)\n            \n            # The design context specifies that if number has no integer part (e.g., 0.x),\n            # integer part 0 is used. If original num was > 10, this won't happen for 0.x.\n            # However, for numbers like 10.5, int_part becomes 10.\n            # The rule is: \"both first and last digits of a number are odd\".\n            # If the integer part is 0, its first and last digit is 0, which is not odd.\n            # So, we can safely proceed.\n            \n            first_digit = get_first_digit(int_part)\n            last_digit = get_last_digit(int_part)\n\n            if is_odd_digit(first_digit) and is_odd_digit(last_digit):\n                count += 1\n    return count"}
{"task_id": "HumanEval/149", "solution": "def sorted_list_sum(lst):\n    \"\"\"Filters out strings with odd lengths and returns the remaining strings\n    sorted by length ascending, then alphabetically ascending for equal lengths.\n    \"\"\"\n    even_length_strings = [s for s in lst if len(s) % 2 == 0]\n    even_length_strings.sort(key=lambda s: (len(s), s))\n    return even_length_strings"}
{"task_id": "HumanEval/147", "solution": "def get_max_triples(n):\n    \"\"\"\n    Calculates the number of triples (a[i], a[j], a[k]) from an array a (where a[i] = i*i - i + 1)\n    such that i < j < k and a[i] + a[j] + a[k] is a multiple of 3.\n    \"\"\"\n\n    def count_residue_zero(n_val: int) -> int:\n        \"\"\"Counts numbers i in [1, n_val] where a[i] % 3 == 0 (which occurs when i % 3 == 2).\"\"\"\n        return n_val // 3 + (1 if n_val % 3 >= 2 else 0)\n\n    def combination(n_val: int, k_val: int) -> int:\n        \"\"\"Computes n_val choose k_val, specifically optimized for k_val <= 3.\"\"\"\n        if n_val < k_val:\n            return 0\n        if k_val == 0:\n            return 1\n        if k_val == 1:\n            return n_val\n        if k_val == 2:\n            return n_val * (n_val - 1) // 2\n        if k_val == 3:\n            return n_val * (n_val - 1) * (n_val - 2) // 6\n        return 0\n\n    if n < 3:\n        return 0\n\n    # Count elements a[i] which are 0 mod 3 (when i % 3 == 2)\n    c0 = count_residue_zero(n)\n    # Count elements a[i] which are 1 mod 3 (when i % 3 == 0 or i % 3 == 1)\n    c1 = n - c0\n\n    # A sum a[i] + a[j] + a[k] is a multiple of 3 if all three elements are 0 mod 3\n    # OR all three elements are 1 mod 3.\n    # We sum the combinations for these two cases.\n    result = combination(c0, 3) + combination(c1, 3)\n\n    return result"}
{"task_id": "HumanEval/150", "solution": "import math\n\ndef x_or_y(n, x, y):\n    \"\"\"A simple program which should return the value of x if n is \n    a prime number and should return the value of y otherwise.\n\n    Examples:\n    for x_or_y(7, 34, 12) == 34\n    for x_or_y(15, 8, 5) == 5\n    \n    \"\"\"\n    def is_prime(num: int) -> bool:\n        \"\"\"Determines if a number is prime using trial division.\"\"\"\n        if num <= 1:\n            return False\n        if num <= 3:\n            return True\n        if num % 2 == 0: # Exclude even numbers > 2\n            return False\n        \n        # Check for factors from 3 up to sqrt(num), only odd numbers\n        r = int(math.isqrt(num))\n        i = 3\n        while i <= r:\n            if num % i == 0:\n                return False\n            i += 2\n        return True\n\n    if is_prime(n):\n        return x\n    else:\n        return y"}
{"task_id": "HumanEval/152", "solution": "from typing import List\n\ndef compare(game: List[int], guess: List[int]) -> List[int]:\n    \"\"\"Determines how far off each guess was for a series of matches.\n    Returns an array of the same length where 0 means a correct guess,\n    otherwise it's the absolute difference between the guess and the score.\n    \"\"\"\n    return [0 if g == q else abs(g - q) for g, q in zip(game, guess)]"}
{"task_id": "HumanEval/151", "solution": "def double_the_difference(lst):\n    \"\"\"\n    Given a list of numbers, return the sum of squares of the numbers\n    in the list that are odd. Ignore numbers that are negative or not integers.\n    \"\"\"\n    total = 0\n    for x in lst:\n        val = None\n        if isinstance(x, int):\n            val = x\n        elif isinstance(x, float) and x.is_integer():\n            val = int(x)\n        \n        if val is not None:\n            if val >= 0 and val % 2 != 0:\n                total += val * val\n    return total"}
{"task_id": "HumanEval/153", "solution": "def Strongest_Extension(class_name, extensions):\n    \"\"\"Finds the strongest extension based on CAP - SM strength and returns a formatted string.\n    Ties are broken by choosing the first extension in the input list.\n    \"\"\"\n    strongest_ext_name = None\n    max_strength = float('-inf')\n\n    for ext_name in extensions:\n        cap_count = 0\n        sm_count = 0\n        for char in ext_name:\n            if char.isupper():\n                cap_count += 1\n            elif char.islower():\n                sm_count += 1\n        \n        current_strength = cap_count - sm_count\n        \n        # Update the strongest extension if current is stronger, or if it's the first one.\n        # Tie-breaking (first in list) is implicitly handled by not updating if strength is equal.\n        if strongest_ext_name is None or current_strength > max_strength:\n            max_strength = current_strength\n            strongest_ext_name = ext_name\n\n    if strongest_ext_name is None:\n        # If no extensions were provided, return ClassName.\n        return f\"{class_name}.\"\n    else:\n        return f\"{class_name}.{strongest_ext_name}\""}
{"task_id": "HumanEval/154", "solution": "def cycpattern_check(a , b):\n    \"\"\"Checks if the second word or any of its rotations is a substring in the first word.\"\"\"\n    if not b:\n        return True\n    if len(b) > len(a):\n        return False\n\n    rotations = []\n    seen = set()\n    n = len(b)\n    for i in range(n):\n        rotation = b[i:] + b[:i]\n        if rotation not in seen:\n            seen.add(rotation)\n            rotations.append(rotation)\n\n    for rotation in rotations:\n        if rotation in a:\n            return True\n            \n    return False"}
{"task_id": "HumanEval/158", "solution": "def find_max(words):\n    \"\"\"Write a function that accepts a list of strings.\n    The list contains different words. Return the word with maximum number\n    of unique characters. If multiple strings have maximum number of unique\n    characters, return the one which comes first in lexicographical order.\n    \"\"\"\n    if not words:\n        return \"\"\n\n    max_unique_count = -1\n    result_word = \"\"\n\n    for word in words:\n        current_unique_count = len(set(word))\n        \n        if current_unique_count > max_unique_count:\n            max_unique_count = current_unique_count\n            result_word = word\n        elif current_unique_count == max_unique_count:\n            # Tie-breaking: return the one which comes first in lexicographical order\n            if word < result_word:\n                result_word = word\n                \n    return result_word"}
{"task_id": "HumanEval/156", "solution": "def int_to_mini_roman(number):\n    \"\"\"\n    Given a positive integer, obtain its roman numeral equivalent as a string,\n    and return it in lowercase.\n    Restrictions: 1 <= num <= 1000\n    \"\"\"\n    NUMERAL_MAP = [\n        (1000, \"M\"), (900, \"CM\"), (500, \"D\"), (400, \"CD\"),\n        (100, \"C\"), (90, \"XC\"), (50, \"L\"), (40, \"XL\"),\n        (10, \"X\"), (9, \"IX\"), (5, \"V\"), (4, \"IV\"), (1, \"I\"),\n    ]\n\n    result = []\n    n = number\n    for value, numeral in NUMERAL_MAP:\n        while n >= value:\n            result.append(numeral)\n            n -= value\n    return \"\".join(result).lower()"}
{"task_id": "HumanEval/155", "solution": "from typing import Tuple, Optional, Any\nfrom datetime import datetime\nimport sys\n\nclass AppConfig:\n    \"\"\"Holds application configuration, especially for logging.\"\"\"\n    LOG_ENABLED: bool = False\n    LOG_PATH: str = \"evenodd_logs.jsonl\"\n\n    def __init__(self, log_enabled: bool = False, log_path: str = \"evenodd_logs.jsonl\") -> None:\n        self.LOG_ENABLED = log_enabled\n        self.LOG_PATH = log_path\n\n    @staticmethod\n    def from_env() -> 'AppConfig':\n        \"\"\"Creates an AppConfig instance, disabling logging for inline use.\"\"\"\n        return AppConfig(log_enabled=False)\n\nclass DigitCount:\n    \"\"\"Data transfer object for storing even and odd digit counts.\"\"\"\n    def __init__(self, even: int, odd: int) -> None:\n        self.even = even\n        self.odd = odd\n\n    def to_tuple(self) -> Tuple[int, int]:\n        \"\"\"Converts the counts to a tuple (even, odd).\"\"\"\n        return (self.even, self.odd)\n\n    def to_dict(self) -> dict:\n        \"\"\"Converts the counts to a dictionary.\"\"\"\n        return {\"even\": self.even, \"odd\": self.odd}\n\nclass LogEntry:\n    \"\"\"Represents a log entry for a digit counting operation.\"\"\"\n    def __init__(self, timestamp: str, input_value: str, even: int, odd: int, source: str) -> None:\n        self.timestamp = timestamp\n        self.input_value = input_value\n        self.even = even\n        self.odd = odd\n        self.source = source\n    \n    def to_json_line(self) -> str:\n        \"\"\"Serializes the log entry to a JSON string suitable for JSONL.\"\"\"\n        # A more robust JSON library would be used in a real application.\n        return f'{{\"timestamp\":\"{self.timestamp}\",\"input_value\":\"{self.input_value}\",\"even\":{self.even},\"odd\":{self.odd},\"source\":\"{self.source}\"}}'\n\nclass Validator:\n    \"\"\"Provides utility methods for input validation and digit extraction.\"\"\"\n    MAX_DIGITS = 1_000_000\n\n    @staticmethod\n    def normalize_to_int(value: Any) -> int:\n        \"\"\"Normalizes various input types (int, string) to an integer, raising ValueError for invalid inputs.\"\"\"\n        if isinstance(value, int):\n            return value\n        s = str(value).strip()\n        if s.startswith(\"+\"):\n            s = s[1:]\n        if s.startswith(\"-\"):\n            s_num = s[1:]\n            if not s_num.isdigit():\n                raise ValueError(f\"Invalid integer: {value}\")\n            if len(s_num) > Validator.MAX_DIGITS:\n                raise ValueError(\"Input exceeds maximum digit limit\")\n            return -int(s_num)\n        if not s.isdigit():\n            raise ValueError(f\"Invalid integer: {value}\")\n        if len(s) > Validator.MAX_DIGITS:\n            raise ValueError(\"Input exceeds maximum digit limit\")\n        return int(s)\n\n    @staticmethod\n    def digits_of(n: int) -> list[int]:\n        \"\"\"Extracts the digits of an integer into a list.\"\"\"\n        n = abs(n)\n        if n == 0:\n            return [0]\n        digs = []\n        while n:\n            digs.append(n % 10)\n            n //= 10\n        return digs[::-1]\n\nclass EvenOddService:\n    \"\"\"Contains the core logic for counting even and odd digits.\"\"\"\n    def __init__(self) -> None:\n        pass\n\n    def count_digits(self, num: int) -> DigitCount:\n        \"\"\"Calculates the number of even and odd digits in the given integer.\"\"\"\n        digits = Validator.digits_of(num)\n        even_count = sum(1 for d in digits if d % 2 == 0)\n        odd_count = len(digits) - even_count\n        return DigitCount(even=even_count, odd=odd_count)\n\nclass LogRepository:\n    \"\"\"Handles persistence of log entries to a file.\"\"\"\n    def __init__(self, path: str) -> None:\n        self._path = path\n\n    def save(self, entry: LogEntry) -> None:\n        \"\"\"Appends a log entry to the configured log file, handling IO errors silently.\"\"\"\n        try:\n            line = entry.to_json_line()\n            with open(self._path, \"a\", encoding=\"utf-8\") as f:\n                f.write(line + \"\\n\")\n        except Exception as e:\n            print(f\"LogRepository.save error: {e}\", file=sys.stderr)\n\nclass EvenOddController:\n    \"\"\"Orchestrates the digit counting process, including validation and optional logging.\"\"\"\n    def __init__(self, service: EvenOddService, repo: Optional[LogRepository], config: AppConfig) -> None:\n        self._service = service\n        self._repo = repo\n        self._config = config\n\n    def count(self, num: Any, source: str = \"lib\") -> DigitCount:\n        \"\"\"Processes the request to count even and odd digits, performing validation and logging.\"\"\"\n        normalized = Validator.normalize_to_int(num)\n        result = self._service.count_digits(normalized)\n        \n        # Logging is disabled for this inline implementation to prevent file IO side effects.\n        # If self._config.LOG_ENABLED was True and self._repo was not None,\n        # logging logic as per design context would be here.\n        \n        return result\n\n# Global instances of core components for the public API wrapper.\n_config = AppConfig.from_env() # Defaults to logging disabled\n_service = EvenOddService()\n_repo = LogRepository(_config.LOG_PATH) if _config.LOG_ENABLED else None # _repo will be None because _config.LOG_ENABLED is False\n_controller = EvenOddController(_service, _repo, _config)\n\ndef even_odd_count(num: int) -> Tuple[int, int]:\n    \"\"\"Given an integer. return a tuple that has the number of even and odd digits respectively.\"\"\"\n    result = _controller.count(num, source=\"lib\")\n    return result.to_tuple()"}
{"task_id": "HumanEval/157", "solution": "def right_angle_triangle(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle. Return True if the three\n    sides form a right-angled triangle, False otherwise.\n    A right-angled triangle is a triangle in which one angle is right angle or \n    90 degree.\n    Example:\n    right_angle_triangle(3, 4, 5) == True\n    right_angle_triangle(1, 2, 3) == False\n    '''\n    # Define a tolerance for floating point comparisons as per design context.\n    tolerance = 1e-9\n\n    # Check if all sides are positive.\n    if not (a > 0 and b > 0 and c > 0):\n        return False\n\n    # Check the triangle inequality: the sum of any two sides must be greater than the third side.\n    if not (a + b > c and a + c > b and b + c > a):\n        return False\n\n    # Sort the sides to easily identify the potential hypotenuse (the largest side).\n    sides = sorted([a, b, c])\n    s1, s2, s3 = sides[0], sides[1], sides[2]\n\n    # Apply the Pythagorean theorem: a^2 + b^2 = c^2, comparing with tolerance.\n    lhs = s1**2 + s2**2\n    rhs = s3**2\n    \n    return abs(lhs - rhs) <= tolerance"}
{"task_id": "HumanEval/160", "solution": "import operator\nfrom typing import List\n\nclass InvalidInputError(ValueError):\n    \"\"\"Raised when input lists are invalid.\"\"\"\n    pass\n\nclass EvaluationError(RuntimeError):\n    \"\"\"Raised when an error occurs during expression evaluation.\"\"\"\n    pass\n\nclass Token:\n    \"\"\"Base class for expression tokens.\"\"\"\n    def __init__(self, value):\n        self._value = value\n\n    def get_value(self):\n        return self._value\n\nclass OperandToken(Token):\n    \"\"\"Represents an integer operand.\"\"\"\n    pass\n\nclass OperatorToken(Token):\n    \"\"\"Represents an operator symbol.\"\"\"\n    pass\n\nclass Operator:\n    \"\"\"Encapsulates operator metadata and arithmetic function.\"\"\"\n    def __init__(self, symbol: str, precedence: int, associativity: str, func):\n        self.symbol = symbol\n        self.precedence = precedence\n        self.associativity = associativity\n        self._func = func\n\n    def apply(self, a: int, b: int) -> int:\n        \"\"\"Applies the operator to two operands.\"\"\"\n        try:\n            return self._func(a, b)\n        except ZeroDivisionError as e:\n            raise EvaluationError(\"division by zero\") from e\n\n    _ALL_OPERATORS = {}\n\n    @classmethod\n    def register(cls, symbol: str, precedence: int, associativity: str, func):\n        \"\"\"Registers an operator with its properties.\"\"\"\n        cls._ALL_OPERATORS[symbol] = cls(symbol, precedence, associativity, func)\n\n    @classmethod\n    def get(cls, symbol: str) -> 'Operator':\n        \"\"\"Retrieves an operator by its symbol.\"\"\"\n        try:\n            return cls._ALL_OPERATORS[symbol]\n        except KeyError:\n            raise InvalidInputError(f\"Unknown operator: {symbol}\")\n\nOperator.register(\"+\", 1, \"left\", operator.add)\nOperator.register(\"-\", 1, \"left\", operator.sub)\nOperator.register(\"*\", 2, \"left\", operator.mul)\nOperator.register(\"//\", 2, \"left\", operator.floordiv)\nOperator.register(\"**\", 3, \"right\", operator.pow)\n\nclass Parser:\n    \"\"\"Converts input lists into RPN tokens.\"\"\"\n    def to_rpn(self, operators: List[str], operands: List[int]) -> List[Token]:\n        \"\"\"Validates inputs and converts them to RPN token list using shunting-yard.\"\"\"\n        self._validate_inputs(operators, operands)\n\n        expression_tokens = []\n        for i in range(len(operators)):\n            expression_tokens.append(OperandToken(operands[i]))\n            expression_tokens.append(OperatorToken(operators[i]))\n        expression_tokens.append(OperandToken(operands[-1]))\n\n        return self._shunting_yard(expression_tokens)\n\n    def _validate_inputs(self, operators: List[str], operands: List[int]) -> None:\n        \"\"\"Validates the length and content of the input lists.\"\"\"\n        if not operands:\n            raise InvalidInputError(\"Operand list cannot be empty.\")\n        if len(operators) != len(operands) - 1:\n            raise InvalidInputError(\"Length of operator list must be equal to length of operand list minus one.\")\n        if any(op < 0 for op in operands):\n            raise InvalidInputError(\"All operands must be non-negative integers.\")\n        for op_symbol in operators:\n            try:\n                Operator.get(op_symbol)\n            except InvalidInputError as e:\n                raise InvalidInputError(f\"Invalid operator symbol: {op_symbol}\") from e\n\n    def _shunting_yard(self, tokens: List[Token]) -> List[Token]:\n        \"\"\"Implements the shunting-yard algorithm to convert infix tokens to RPN.\"\"\"\n        output_queue = []\n        operator_stack = []\n\n        for token in tokens:\n            if isinstance(token, OperandToken):\n                output_queue.append(token)\n            elif isinstance(token, OperatorToken):\n                op1 = Operator.get(token.get_value())\n                while operator_stack:\n                    top_op_token = operator_stack[-1]\n                    if not isinstance(top_op_token, OperatorToken):\n                        break \n                    op2 = Operator.get(top_op_token.get_value())\n\n                    if (op1.precedence < op2.precedence) or \\\n                       (op1.precedence == op2.precedence and op1.associativity == \"left\"):\n                        output_queue.append(operator_stack.pop())\n                    else:\n                        break\n                operator_stack.append(token)\n            else:\n                raise InvalidInputError(f\"Unexpected token type during parsing: {type(token)}\")\n\n        while operator_stack:\n            op_token = operator_stack.pop()\n            if not isinstance(op_token, OperatorToken):\n                raise InvalidInputError(f\"Malformed expression: unexpected token in operator stack: {type(op_token)}\")\n            output_queue.append(op_token)\n\n        return output_queue\n\nclass Evaluator:\n    \"\"\"Evaluates a list of RPN tokens.\"\"\"\n    def eval_rpn(self, rpn_tokens: List[Token]) -> int:\n        \"\"\"Evaluates the Reverse Polish Notation (RPN) token list.\"\"\"\n        operand_stack = []\n\n        for token in rpn_tokens:\n            if isinstance(token, OperandToken):\n                operand_stack.append(token.get_value())\n            elif isinstance(token, OperatorToken):\n                if len(operand_stack) < 2:\n                    raise EvaluationError(\"Not enough operands for operator in RPN expression.\")\n                b = operand_stack.pop()\n                a = operand_stack.pop()\n                op = Operator.get(token.get_value())\n                result = op.apply(a, b)\n                operand_stack.append(result)\n            else:\n                raise EvaluationError(f\"Unexpected token type in RPN expression: {type(token)}\")\n\n        if len(operand_stack) != 1:\n            raise EvaluationError(\"Invalid RPN expression: stack did not resolve to a single value.\")\n\n        return operand_stack[0]\n\nclass DoAlgebraService:\n    \"\"\"Orchestrates parsing and evaluation of algebraic expressions.\"\"\"\n    def __init__(self, parser: Parser, evaluator: Evaluator):\n        self._parser = parser\n        self._evaluator = evaluator\n\n    def evaluate(self, operators: List[str], operands: List[int]) -> int:\n        \"\"\"Evaluates an algebraic expression from operator and operand lists.\"\"\"\n        rpn = self._parser.to_rpn(operators, operands)\n        return self._evaluator.eval_rpn(rpn)\n\n_parser_instance = Parser()\n_evaluator_instance = Evaluator()\n_service_instance = DoAlgebraService(_parser_instance, _evaluator_instance)\n\ndef do_algebra(operator: List[str], operand: List[int]) -> int:\n    \"\"\"\n    Given two lists operator, and operand. The first list has basic algebra operations, and \n    the second list is a list of integers. Use the two given lists to build the algebric \n    expression and return the evaluation of this expression.\n    \"\"\"\n    return _service_instance.evaluate(operator, operand)"}
{"task_id": "HumanEval/159", "solution": "def eat(number, need, remaining):\n    \"\"\"\n    Calculates the total carrots eaten and remaining after a rabbit's meal.\n    The rabbit eats as many carrots as needed, up to the remaining stock.\n    \"\"\"\n    carrots_eaten_in_this_meal = min(need, remaining)\n    total_carrots_eaten = number + carrots_eaten_in_this_meal\n    carrots_left_after_meal = remaining - carrots_eaten_in_this_meal\n    \n    return [total_carrots_eaten, carrots_left_after_meal]"}
{"task_id": "HumanEval/161", "solution": "def solve(s):\n    \"\"\"You are given a string s.\n    if s[i] is a letter, reverse its case from lower to upper or vise versa, \n    otherwise keep it as it is.\n    If the string contains no letters, reverse the string.\n    The function should return the resulted string.\n    Examples\n    solve(\"1234\") = \"4321\"\n    solve(\"ab\") = \"AB\"\n    solve(\"#a@C\") = \"#A@c\"\n    \"\"\"\n    \n    has_letters = False\n    for char in s:\n        if char.isalpha():\n            has_letters = True\n            break\n            \n    if not has_letters:\n        return s[::-1]\n    else:\n        transformed_chars = []\n        for char in s:\n            if char.isalpha():\n                transformed_chars.append(char.swapcase())\n            else:\n                transformed_chars.append(char)\n        return \"\".join(transformed_chars)"}
{"task_id": "HumanEval/162", "solution": "import hashlib\nfrom typing import Optional\n\ndef string_to_md5(text: str) -> Optional[str]:\n    \"\"\"\n    Given a string 'text', return its md5 hash equivalent string.\n    If 'text' is an empty string, return None.\n    \"\"\"\n    if not text:\n        return None\n    \n    # Encode the text to UTF-8 bytes to compute the MD5 hash.\n    encoded_text = text.encode('utf-8')\n    \n    # Compute the MD5 hash and return its hexadecimal representation.\n    md5_hash = hashlib.md5(encoded_text).hexdigest()\n    \n    return md5_hash"}
{"task_id": "HumanEval/163", "solution": "import json\nfrom dataclasses import dataclass\nfrom typing import List, Tuple, Any\n\n# Constants (from src/evenints/utils.py)\nEVEN_DIGITS: List[int] = [2, 4, 6, 8]\n\n# Models (from src/evenints/models.py)\n@dataclass\nclass RangeRequest:\n    \"\"\"Represents a validated input range.\"\"\"\n    a: int\n    b: int\n    def as_tuple(self) -> Tuple[int,int]:\n        \"\"\"Returns the range as a (min, max) tuple.\"\"\"\n        return (min(self.a, self.b), max(self.a, self.b))\n\n@dataclass\nclass GenerationResult:\n    \"\"\"Holds the list of generated even integers.\"\"\"\n    values: List[int]\n    def to_list(self) -> List[int]:\n        \"\"\"Returns the result as a raw list.\"\"\"\n        return list(self.values)\n    def to_json(self) -> str:\n        \"\"\"Returns the result as a JSON string.\"\"\"\n        return json.dumps(self.values)\n\n# Validator (from src/evenints/validators.py)\nclass InvalidInputError(Exception):\n    \"\"\"Exception raised for invalid input values during validation.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\n\nclass RangeValidator:\n    \"\"\"Validates and normalizes input integers for integer generation.\"\"\"\n    def validate(self, a: Any, b: Any) -> RangeRequest:\n        \"\"\"Ensures inputs are positive integers and returns a RangeRequest.\"\"\"\n        a_int = self._ensure_int(a, \"a\")\n        b_int = self._ensure_int(b, \"b\")\n        self._ensure_positive(a_int, \"a\")\n        self._ensure_positive(b_int, \"b\")\n        return RangeRequest(a_int, b_int)\n\n    def _ensure_int(self, x: Any, name: str) -> int:\n        \"\"\"Helper to check if a value is an integer.\"\"\"\n        if not isinstance(x, int):\n            raise InvalidInputError(f\"{name} must be an integer\")\n        return x\n\n    def _ensure_positive(self, x: int, name: str) -> None:\n        \"\"\"Helper to check if an integer is positive.\"\"\"\n        if x <= 0:\n            raise InvalidInputError(f\"{name} must be positive\")\n\n# Service (from src/evenints/services.py)\nclass IntegerGeneratorService:\n    \"\"\"Core logic to generate even single-digit integers within a range.\"\"\"\n    def __init__(self, validator: RangeValidator):\n        self._validator = validator\n\n    def generate(self, req: RangeRequest) -> GenerationResult:\n        \"\"\"Selects even digits that fall within the specified range.\"\"\"\n        min_v, max_v = req.as_tuple()\n        selected = [d for d in EVEN_DIGITS if min_v <= d <= max_v]\n        return GenerationResult(selected)\n\n# Default instances for the public API (from src/evenints/__init__.py)\n_default_validator = RangeValidator()\n_default_service = IntegerGeneratorService(_default_validator)\n\ndef generate_integers(a, b):\n    \"\"\"\n    Given two positive integers a and b, return the even digits between a\n    and b, in ascending order.\n\n    For example:\n    generate_integers(2, 8) => [2, 4, 6, 8]\n    generate_integers(8, 2) => [2, 4, 6, 8]\n    generate_integers(10, 14) => []\n    \"\"\"\n    req = _default_validator.validate(a, b)\n    result = _default_service.generate(req)\n    return result.to_list()"}
