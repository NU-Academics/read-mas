{"task_id": "HumanEval/5", "solution": "from typing import List\n\n\ndef intersperse(numbers: List[int], delimeter: int) -> List[int]:\n    \"\"\" Insert a number 'delimeter' between every two consecutive elements of input list `numbers'\n    >>> intersperse([], 4)\n    []\n    >>> intersperse([1, 2, 3], 4)\n    [1, 4, 2, 4, 3]\n    \"\"\"\n    n = len(numbers)\n    if n <= 1:\n        return list(numbers)\n\n    # Allocate a new list with space for numbers and n-1 delimiters\n    # Total length will be n + (n - 1) = 2*n - 1\n    result: List[int] = [0] * (2 * n - 1)\n\n    # Place the original numbers at even indices (0, 2, 4, ...)\n    result[0::2] = numbers\n\n    # Place the delimiter at odd indices (1, 3, 5, ...)\n    # There will be n - 1 delimiters needed\n    result[1::2] = [delimeter] * (n - 1)\n\n    return result"}
{"task_id": "HumanEval/6", "solution": "import collections\nfrom typing import List\n\n\ndef parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\" Input to this function is a string represented multiple groups for nested parentheses separated by spaces.\n    For each of the group, output the deepest level of nesting of parentheses.\n    E.g. (()()) has maximum two levels of nesting while ((())) has three.\n    \"\"\"\n    if not paren_string:\n        return []\n\n    groups = paren_string.split()\n    results = []\n\n    for group in groups:\n        current_depth = 0\n        max_depth = 0\n        # Check for invalid characters - raise an error if found, as per FR1\n        # The design context indicates \"by default the function raises InvalidInputError for any invalid input\".\n        # However, since this is a pure function completion, we assume the input is well-formed\n        # and only contains '(' and ')', as implied by the problem description and example.\n        # No explicit character validation here as per \"Do NOT add isinstance() checks or raise exceptions for edge cases\"\n\n        for char in group:\n            if char == '(':\n                current_depth += 1\n                max_depth = max(max_depth, current_depth)\n            elif char == ')':\n                current_depth -= 1\n                # The design context implies that unbalanced parentheses should raise an error.\n                # However, this specific function's example and direct requirement is to\n                # return a list of integers, not to handle errors explicitly by raising.\n                # We prioritize returning a depth, as per the output type List[int].\n                # If current_depth goes negative, it implies an unbalanced ')' which\n                # would result in an incorrect depth; for this problem's scope,\n                # we assume balanced groups or that the depth calculation should proceed\n                # even with \"negative depth\" counting for simplicity as it's not explicitly stated\n                # how to handle unbalanced groups in the return value (List[int]).\n                # The example does not contain unbalanced groups.\n\n        results.append(max_depth)\n\n    return results"}
{"task_id": "HumanEval/0", "solution": "from typing import List\n\n\ndef has_close_elements(numbers: List[float], threshold: float) -> bool:\n    \"\"\" Check if in given list of numbers, are any two numbers closer to each other than\n    given threshold.\n    >>> has_close_elements([1.0, 2.0, 3.0], 0.5)\n    False\n    >>> has_close_elements([1.0, 2.8, 3.0, 4.0, 5.0, 2.0], 0.3)\n    True\n    \"\"\"\n    if len(numbers) < 2:\n        return False\n\n    sorted_numbers = sorted(numbers)\n\n    for i in range(1, len(sorted_numbers)):\n        if sorted_numbers[i] - sorted_numbers[i-1] < threshold:\n            return True\n            \n    return False"}
