{"task_id": "HumanEval/58", "solution": "def common(l1: list, l2: list):\n    \"\"\"Return sorted unique common elements for two lists.\"\"\"\n    set1 = set(l1)\n    set2 = set(l2)\n    common_set = set1.intersection(set2)\n    result_list = list(common_set)\n    result_list.sort()\n    return result_list"}
{"task_id": "HumanEval/55", "solution": "def fib(n: int):\n    \"\"\"Return n-th Fibonacci number.\n    >>> fib(10)\n    55\n    >>> fib(1)\n    1\n    >>> fib(8)\n    21\n    \"\"\"\n    if n == 0:\n        return 0\n    elif n == 1 or n == 2:\n        return 1\n    else:\n        # Iteratively calculate Fibonacci numbers starting from F(3).\n        # a holds F(k-1), b holds F(k).\n        a, b = 1, 1\n        for _ in range(3, n + 1):\n            a, b = b, a + b\n        return b"}
{"task_id": "HumanEval/57", "solution": "def monotonic(l: list):\n    \"\"\"Return True is list elements are monotonically increasing or decreasing.\"\"\"\n    n = len(l)\n    if n <= 1:\n        return True\n\n    # Check for monotonically increasing\n    is_increasing = True\n    for i in range(n - 1):\n        if l[i] > l[i+1]:\n            is_increasing = False\n            break\n\n    if is_increasing:\n        return True\n\n    # Check for monotonically decreasing\n    is_decreasing = True\n    for i in range(n - 1):\n        if l[i] < l[i+1]:\n            is_decreasing = False\n            break\n\n    return is_decreasing"}
