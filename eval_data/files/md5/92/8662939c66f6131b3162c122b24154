{"task_id": "Mbpp/8", "solution": "from typing import List\n\nIntegerList = List[int]\n\ndef square_nums(input_list: IntegerList) -> IntegerList:\n    \"\"\"Compute squares of each integer in input_list and return a new IntegerList preserving order.\"\"\"\n    return [x * x for x in input_list]"}
{"task_id": "Mbpp/2", "solution": "def similar_elements(seqA, seqB):\n    \"\"\"\n    Finds unique shared elements between two input sequences.\n    Converts inputs to sets, computes their intersection, and returns the result as a list.\n    \"\"\"\n    set_a = set(seqA)\n    set_b = set(seqB)\n    intersection = set_a.intersection(set_b)\n    return list(intersection)"}
{"task_id": "Mbpp/3", "solution": "import math\n\ndef is_not_prime(n: int) -> bool:\n    \"\"\"Identifies if a number is not prime. Returns True if not prime, False if prime.\"\"\"\n    if n < 2:\n        return True\n    \n    limit = math.isqrt(n)\n    for d in range(2, limit + 1):\n        if n % d == 0:\n            return True\n            \n    return False"}
{"task_id": "Mbpp/7", "solution": "from typing import Iterable, List, Set\n\nclass Token:\n    \"\"\"Represents a single whitespace-separated token with its text and length.\"\"\"\n    def __init__(self, text: str):\n        self.text = text\n        self.length = len(text)\n\n    def isLong(self, minLen: int) -> bool:\n        \"\"\"Checks if the token's length is greater than or equal to the minimum length.\"\"\"\n        return self.length >= minLen\n\nclass InputString:\n    \"\"\"Represents the raw input string and provides tokenization functionality.\"\"\"\n    def __init__(self, raw: str):\n        self.raw = raw\n\n    def parseTokens(self) -> List[Token]:\n        \"\"\"Splits the raw string into Token objects based on whitespace.\"\"\"\n        return [Token(word) for word in self.raw.split()]\n\nclass ResultCollection:\n    \"\"\"Holds the selected token strings and provides a convenience method for set conversion.\"\"\"\n    def __init__(self, items: List[str]):\n        self.items = items\n\n    def toSet(self) -> Set[str]:\n        \"\"\"Returns the collection items as a set.\"\"\"\n        return set(self.items)\n\ndef find_char_long(s: str) -> Iterable[str]:\n    \"\"\"\n    Finds all words in a string that are at least 4 characters long.\n    Tokens are split by whitespace, and original casing is preserved.\n    \"\"\"\n    input_string_obj = InputString(s)\n    tokens = input_string_obj.parseTokens()\n    \n    selected_texts = []\n    for token in tokens:\n        if token.isLong(4):\n            selected_texts.append(token.text)\n            \n    result_collection_obj = ResultCollection(selected_texts)\n    return result_collection_obj.items"}
{"task_id": "Mbpp/9", "solution": "from dataclasses import dataclass\nfrom typing import Any\n\n@dataclass\nclass InputString:\n    value: str\n    def length(self) -> int:\n        return len(self.value)\n\n@dataclass\nclass RotationResult:\n    k: int\n\ndef validate_input(s: Any) -> None:\n    \"\"\"Raises TypeError if not a string or ValueError if an empty string.\"\"\"\n    if not isinstance(s, str):\n        raise TypeError(\"Input must be a string.\")\n    if len(s) == 0:\n        raise ValueError(\"Input string cannot be empty.\")\n\ndef rotate_left(s: str, k: int) -> str:\n    \"\"\"Performs a cyclic left shift of string s by k positions.\"\"\"\n    n = len(s)\n    # Ensure k is within bounds for rotation, though for this problem k is 1..n\n    k_eff = k % n\n    return s[k_eff:] + s[:k_eff]\n\ndef find_Rotations(s: str) -> int:\n    \"\"\"\n    Finds the minimum number of rotations (greater than 0) required to get the same string.\n    \"\"\"\n    validate_input(s)\n    n = len(s)\n\n    # For a string of length 1, one rotation always returns the same string.\n    if n == 1:\n        return 1\n\n    # Iterate k from 1 to n (inclusive) to find the minimal positive rotation.\n    for k in range(1, n + 1):\n        rotated_s = rotate_left(s, k)\n        if rotated_s == s:\n            return k"}
{"task_id": "Mbpp/11", "solution": "def remove_Occ(input_str: str, ch: str) -> str:\n    \"\"\"\n    Validate inputs and return input_str with first and last occurrence of ch removed per SRS.\n\n    Raises:\n        ValueError: if ch is not a str of length 1.\n    \"\"\"\n    if not isinstance(input_str, str) or not isinstance(ch, str):\n        # The prompt says \"DO NOT add isinstance() checks or raise exceptions for edge cases\"\n        # but the design context explicitly asks for type validation if ch is not a str.\n        # Given the instruction \"Use the EXACT function name and parameter names from the function stub above\"\n        # and \"DO NOT add isinstance() checks or raise exceptions for edge cases\", I will only\n        # implement the len(ch) validation as it's the specific ValueError mentioned.\n        # Relying on Python's type system or subsequent operations to handle non-string inputs.\n        pass\n\n    if len(ch) != 1:\n        raise ValueError(\"ch must be a single character string.\")\n\n    first_idx = input_str.find(ch)\n\n    if first_idx == -1:\n        return input_str\n\n    last_idx = input_str.rfind(ch)\n\n    if first_idx == last_idx:\n        # Only one occurrence, remove it\n        return input_str[:first_idx] + input_str[first_idx+1:]\n    else:\n        # Remove both first and last occurrences\n        return input_str[:first_idx] + input_str[first_idx+1:last_idx] + input_str[last_idx+1:]"}
{"task_id": "Mbpp/4", "solution": "import heapq\n\ndef validateInput(numbers, n):\n    \"\"\"\n    Validates the input parameters numbers and n.\n    Per design constraints, this function does not raise exceptions or perform detailed type checking.\n    \"\"\"\n    pass\n\ndef selectTopN(numbers, n):\n    \"\"\"\n    Selects the n largest integers from the given list, preserving duplicates and returning them in descending order.\n    It uses the heapq module for efficient selection.\n    \"\"\"\n    return heapq.nlargest(n, numbers)\n\ndef heap_queue_largest(numbers, n):\n    \"\"\"\n    Finds the n largest integers from a given list of numbers, returned in descending order.\n    It orchestrates input validation and selection of the top n elements.\n    \"\"\"\n    validateInput(numbers, n)\n    return selectTopN(numbers, n)"}
{"task_id": "Mbpp/6", "solution": "def compute(a: int, b: int) -> int:\n    \"\"\"\n    Computes the bitwise XOR of two integers.\n    \"\"\"\n    return a ^ b\n\ndef is_single_bit_set(n: int) -> bool:\n    \"\"\"\n    Checks if an integer has exactly one bit set in its binary representation.\n    Returns True if n is a power of two (for n > 0).\n    \"\"\"\n    return n != 0 and (n & (n - 1)) == 0\n\ndef differ_At_One_Bit_Pos(a: int, b: int) -> bool:\n    \"\"\"\n    Checks if two numbers differ at exactly one bit position.\n    \"\"\"\n    xor_result = compute(a, b)\n    return is_single_bit_set(xor_result)"}
{"task_id": "Mbpp/16", "solution": "import re\n\nPATTERN_REGEX = r'^[a-z]+_[a-z]+$'\n\ndef text_lowercase_underscore(input_string: str) -> bool:\n    \"\"\"Return True if input_string matches PATTERN_REGEX, else False. Always returns a bool.\"\"\"\n    match = re.fullmatch(PATTERN_REGEX, input_string)\n    return bool(match)"}
{"task_id": "Mbpp/12", "solution": "from typing import List, Tuple\n\nclass Row:\n    \"\"\"Represents a single row of a matrix, preserving its elements and original index for stable sorting.\"\"\"\n    def __init__(self, elements: List[float], index: int):\n        self.elements: List[float] = elements\n        self.index: int = index\n\n    def sum(self) -> float:\n        \"\"\"Computes the sum of all numeric elements in the row.\"\"\"\n        return sum(self.elements)\n\nclass SumCalculator:\n    \"\"\"A utility class responsible for computing the sum of a Row's elements.\"\"\"\n    def compute(self, row: Row) -> float:\n        \"\"\"Calculates the sum for a given Row object using its sum() method.\"\"\"\n        return row.sum()\n\ndef sort_matrix(matrix: List[List[float]]) -> List[List[float]]:\n    \"\"\"\n    Sorts a matrix by the ascending sum of its rows.\n    Employs stable sorting for rows with identical sums, preserving their original relative order.\n    \"\"\"\n    rows_with_indices = []\n    for i, row_elements in enumerate(matrix):\n        rows_with_indices.append(Row(elements=row_elements, index=i))\n\n    sum_calculator = SumCalculator()\n    \n    def sort_key(row: Row) -> Tuple[float, int]:\n        return (sum_calculator.compute(row), row.index)\n\n    sorted_rows = sorted(rows_with_indices, key=sort_key)\n\n    return [row.elements for row in sorted_rows]"}
{"task_id": "Mbpp/56", "solution": "def reverse_digits(n: int) -> int:\n    \"\"\"Reverses the base-10 digits of an integer, dropping leading zeros.\"\"\"\n    return int(str(n)[::-1])\n\ndef check(n: int) -> bool:\n    \"\"\"Checks if a number is one less than twice its reverse.\"\"\"\n    reversed_n = reverse_digits(n)\n    return n == (2 * reversed_n - 1)"}
{"task_id": "Mbpp/17", "solution": "def _validate_numeric(side_length):\n    \"\"\"\n    Validates if the input side_length is numeric (int or float).\n    Raises TypeError if side_length is not an int or float.\n    \"\"\"\n    if not isinstance(side_length, (int, float)):\n        raise TypeError(\"side_length must be numeric\")\n\ndef square_perimeter(side_length):\n    \"\"\"\n    Calculates the perimeter of a square given its side length.\n    Input is validated to be numeric, then perimeter is computed as 4 * side_length.\n    \"\"\"\n    _validate_numeric(side_length)\n    perimeter = 4 * side_length\n    return perimeter"}
{"task_id": "Mbpp/19", "solution": "from typing import List\n\nclass IntegerArray:\n    \"\"\"\n    Lightweight wrapper around a list[int] to represent the SRS IntegerArray\n    domain concept and provide convenience methods.\n    \"\"\"\n    def __init__(self, elements: List[int]) -> None:\n        self.elements = elements\n\n    def length(self) -> int:\n        return len(self.elements)\n\n    def isEmpty(self) -> bool:\n        return self.length() == 0\n\nclass DuplicateCheckResult:\n    \"\"\"\n    Carrier for the boolean duplicate-check result.\n    \"\"\"\n    def __init__(self, has_duplicates: bool) -> None:\n        self.has_duplicates = has_duplicates\n\nclass DuplicateChecker:\n    \"\"\"\n    Implements the duplicate-detection algorithm (stateless).\n    \"\"\"\n    def containsDuplicates(self, arr: IntegerArray) -> bool:\n        \"\"\"\n        Return True if arr contains at least one duplicate element; otherwise False.\n        \"\"\"\n        seen = set()\n        for element in arr.elements:\n            if element in seen:\n                return True\n            seen.add(element)\n        return False\n\n    def check(self, arr: IntegerArray) -> DuplicateCheckResult:\n        \"\"\"\n        Run detection and return a DuplicateCheckResult.\n        \"\"\"\n        has_duplicates = self.containsDuplicates(arr)\n        return DuplicateCheckResult(has_duplicates)\n\ndef test_duplicate(arr: List[int]) -> bool:\n    \"\"\"\n    Find whether a given array of integers contains any duplicate element.\n    \"\"\"\n    integer_array = IntegerArray(arr)\n    checker = DuplicateChecker()\n    return checker.containsDuplicates(integer_array)"}
{"task_id": "Mbpp/20", "solution": "class IntegerValue:\n    \"\"\"A value object to represent an integer.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\nclass WoodallCondition:\n    \"\"\"Represents a candidate Woodall number for a given k.\"\"\"\n    def __init__(self, k: int) -> None:\n        self.k = k\n        self.computed_value = k * (2**k) - 1\n\n    def evaluate(self, n: int) -> bool:\n        \"\"\"Checks if the computed value matches n.\"\"\"\n        return self.computed_value == n\n\nclass Result:\n    \"\"\"Encapsulates the boolean result of a Woodall check.\"\"\"\n    def __init__(self, isWoodall: bool) -> None:\n        self.isWoodall = isWoodall\n\nclass WoodallChecker:\n    \"\"\"Determines if a number is a Woodall number.\"\"\"\n    def find_k(self, n: int) -> int | None:\n        \"\"\"Searches for an integer k such that n = k * 2^k - 1.\"\"\"\n        k = 1\n        while True:\n            condition = WoodallCondition(k)\n            computed_value = condition.computed_value\n            if computed_value == n:\n                return k\n            if computed_value > n:\n                return None\n            k += 1\n\n    def is_woodall(self, n: int) -> bool:\n        \"\"\"Checks if n is a Woodall number.\"\"\"\n        return self.find_k(n) is not None\n\ndef is_woodall(n: int) -> bool:\n    \"\"\"Checks if the given number is a Woodall number.\"\"\"\n    checker = WoodallChecker()\n    is_woodall_num = checker.is_woodall(n)\n    \n    # Per design, encapsulate the boolean result in a Result object\n    result_obj = Result(is_woodall_num)\n    return result_obj.isWoodall"}
{"task_id": "Mbpp/14", "solution": "class InputValidator:\n    \"\"\"Provides utility for validating input types.\"\"\"\n    @staticmethod\n    def is_numeric(value) -> bool:\n        \"\"\"Checks if the value is an int or float, but not a bool.\"\"\"\n        return isinstance(value, (int, float)) and not isinstance(value, bool)\n\nclass TriangularPrism:\n    \"\"\"Represents a triangular prism and calculates its volume.\"\"\"\n    def __init__(self, base: float, triangle_height: float, length: float) -> None:\n        self.base = base\n        self.triangle_height = triangle_height\n        self.length = length\n\n    def calculateVolume(self) -> float:\n        \"\"\"Calculates the volume of the triangular prism.\"\"\"\n        return 0.5 * self.base * self.triangle_height * self.length\n\nclass VolumeResult:\n    \"\"\"A container for the computed volume result.\"\"\"\n    def __init__(self, value: float) -> None:\n        self.value = value\n\nclass VolumeCalculator:\n    \"\"\"Orchestrates validation and volume computation for triangular prisms.\"\"\"\n    def find_Volume(self, base, triangle_height, length):\n        \"\"\"\n        Validates inputs and calculates the volume of a triangular prism.\n        Raises ValueError for non-numeric inputs.\n        \"\"\"\n        if not InputValidator.is_numeric(base):\n            raise ValueError(\"Non-numeric input\")\n        if not InputValidator.is_numeric(triangle_height):\n            raise ValueError(\"Non-numeric input\")\n        if not InputValidator.is_numeric(length):\n            raise ValueError(\"Non-numeric input\")\n\n        prism = TriangularPrism(base, triangle_height, length)\n        volume = prism.calculateVolume()\n        return volume\n\ndef find_Volume(base, triangle_height, length):\n    \"\"\"\n    Calculates the volume of a triangular prism with given dimensions.\n    Delegates to VolumeCalculator for validation and computation.\n    \"\"\"\n    return VolumeCalculator().find_Volume(base, triangle_height, length)"}
{"task_id": "Mbpp/18", "solution": "def remove_dirty_chars(first: str, second: str) -> str:\n    # Create a set of characters from the second string for efficient lookup.\n    chars_to_remove = set(second)\n    # Build the result string by including characters from 'first' not present in 'chars_to_remove'.\n    return ''.join([char for char in first if char not in chars_to_remove])"}
