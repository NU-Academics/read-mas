{"task_id": "Mbpp/759", "solution": "\"\"\"\nWrite a function to check whether a given string is a decimal number with a precision of 2.\nassert is_decimal('123.11')==True\n\"\"\"\ndef is_decimal(s):\n    \"\"\"Check if string is a decimal number with exactly 2 decimal places.\"\"\"\n    if '.' not in s:\n        return False\n    parts = s.split('.')\n    if len(parts) != 2:\n        return False\n    integer_part, decimal_part = parts\n    if len(decimal_part) != 2:\n        return False\n    if not integer_part or not integer_part.isdigit():\n        return False\n    if not decimal_part.isdigit():\n        return False\n    return True"}
{"task_id": "Mbpp/759", "solution": "\"\"\"\nWrite a function to check whether a given string is a decimal number with a precision of 2.\nassert is_decimal('123.11')==True\n\"\"\"\ndef is_decimal(s):\n    \"\"\"Check if string is a decimal number with exactly 2 decimal places.\"\"\"\n    if '.' not in s:\n        return False\n    parts = s.split('.')\n    if len(parts) != 2:\n        return False\n    integer_part, decimal_part = parts\n    if not integer_part or not decimal_part:\n        return False\n    if len(decimal_part) != 2:\n        return False\n    if integer_part.startswith('-'):\n        integer_part = integer_part[1:]\n    return integer_part.isdigit() and decimal_part.isdigit()"}
