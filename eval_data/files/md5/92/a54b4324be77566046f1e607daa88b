{"task_id": "HumanEval/6", "solution": "from typing import List\n\n\nclass NestingCalculator:\n    \"\"\"Calculates the maximum nesting depth of a parenthesis string.\n    It implements the counting algorithm (increment on '(' and decrement on ')', tracking the maximum).\n    \"\"\"\n    def compute(self, group: 'ParenthesisGroup') -> int:\n        current_depth = 0\n        max_depth_seen = 0\n        for char in group.content:\n            if char == '(':\n                current_depth += 1\n            elif char == ')':\n                current_depth -= 1\n            max_depth_seen = max(max_depth_seen, current_depth)\n        return max_depth_seen\n\n\nclass ParenthesisGroup:\n    \"\"\"A lightweight data holder for a parenthesis group's content, identifier, and computed max_depth.\"\"\"\n    def __init__(self, id: int, content: str) -> None:\n        self.id = id\n        self.content = content\n        self.max_depth = 0\n\n    def compute_max_depth(self, calculator: NestingCalculator) -> int:\n        \"\"\"Delegates depth computation to a NestingCalculator and stores the result.\"\"\"\n        self.max_depth = calculator.compute(self)\n        return self.max_depth\n\n\nclass ResultList:\n    \"\"\"Aggregates integer depths in order and exposes the final List[int].\"\"\"\n    def __init__(self) -> None:\n        self.depths: List[int] = []\n\n    def append(self, depth: int) -> None:\n        self.depths.append(depth)\n\n    def to_list(self) -> List[int]:\n        return self.depths\n\n\nclass Parser:\n    \"\"\"Orchestrates input splitting, group processing, depth calculation, and result aggregation.\"\"\"\n    def __init__(self) -> None:\n        self._calculator = NestingCalculator()\n        self._result = ResultList()\n\n    def _split_on_spaces(self, s: str) -> List[str]:\n        \"\"\"Splits the input string by whitespace, handling multiple spaces and trimming.\"\"\"\n        return s.strip().split()\n\n    def parse(self, paren_string: str) -> List[int]:\n        \"\"\"Parses the input string to compute max nesting depths for each group.\"\"\"\n        groups_str = self._split_on_spaces(paren_string)\n        for i, group_content in enumerate(groups_str):\n            group = ParenthesisGroup(i, group_content)\n            max_depth = group.compute_max_depth(self._calculator)\n            self._result.append(max_depth)\n        return self._result.to_list()\n\n\ndef parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\" Input to this function is a string represented multiple groups for nested parentheses separated by spaces.\n    For each of the group, output the deepest level of nesting of parentheses.\n    E.g. (()()) has maximum two levels of nesting while ((())) has three.\n\n    >>> parse_nested_parens('(()()) ((())) () ((())()())')\n    [2, 3, 1, 3]\n    \"\"\"\n    parser = Parser()\n    return parser.parse(paren_string)"}
{"task_id": "HumanEval/0", "solution": "from typing import List\n\n\ndef has_close_elements(numbers: List[float], threshold: float) -> bool:\n    \"\"\" Check if in given list of numbers, are any two numbers closer to each other than\n    given threshold.\n    >>> has_close_elements([1.0, 2.0, 3.0], 0.5)\n    False\n    >>> has_close_elements([1.0, 2.8, 3.0, 4.0, 5.0, 2.0], 0.3)\n    True\n    \"\"\"\n    if len(numbers) < 2:\n        return False\n\n    # Sort a shallow copy of the list to allow checking only adjacent elements for closeness.\n    sorted_numbers = sorted(numbers)\n\n    # Iterate through adjacent pairs in the sorted list.\n    for i in range(len(sorted_numbers) - 1):\n        if abs(sorted_numbers[i+1] - sorted_numbers[i]) < threshold:\n            return True\n\n    return False"}
{"task_id": "HumanEval/7", "solution": "def filter_by_substring(strings: List[str], substring: str) -> List[str]:\n    \"\"\" Filter an input list of strings only for ones that contain given substring\n    >>> filter_by_substring([], 'a')\n    []\n    >>> filter_by_substring(['abc', 'bacd', 'cde', 'array'], 'a')\n    ['abc', 'bacd', 'array']\n    \"\"\"\n    filtered_strings = []\n    for s in strings:\n        if substring in s:\n            filtered_strings.append(s)\n    return filtered_strings"}
{"task_id": "HumanEval/9", "solution": "from typing import List, Tuple\n\n\nclass RollingMaxService:\n    \"\"\"Encapsulates algorithmic logic to compute rolling maxima.\"\"\"\n    def compute(self, numbers: List[int]) -> List[int]:\n        \"\"\"\n        Computes the rolling maximum for a list of integers.\n        \"\"\"\n        if not numbers:\n            return []\n        maxima: List[int] = []\n        current_max = numbers[0]\n        for x in numbers:\n            if x > current_max:\n                current_max = x\n            maxima.append(current_max)\n        return maxima\n\ndef rolling_max(numbers: List[int]) -> List[int]:\n    \"\"\" From a given list of integers, generate a list of rolling maximum element found until given moment\n    in the sequence.\n    >>> rolling_max([1, 2, 3, 2, 3, 4, 2])\n    [1, 2, 3, 3, 3, 4, 4]\n    \"\"\"\n    service = RollingMaxService()\n    return service.compute(numbers)"}
{"task_id": "HumanEval/4", "solution": "from typing import List\n\n\nclass Dataset:\n    \"\"\"Lightweight container for a list of numbers.\"\"\"\n    def __init__(self, numbers: List[float]) -> None:\n        self.numbers = numbers\n\n\nclass Validator:\n    \"\"\"Validates input numbers list.\"\"\"\n    # Per \"DO NOT add isinstance() checks or raise exceptions for edge cases\" in requirements,\n    # the validation logic specified in the design for this class is omitted.\n    def validate_numbers(self, numbers: List[float]) -> None:\n        pass\n\n\nclass MeanCalculator:\n    \"\"\"Computes the arithmetic mean.\"\"\"\n    def compute_mean(self, numbers: List[float]) -> float:\n        # This will raise ZeroDivisionError if 'numbers' is empty,\n        # as per \"DO NOT add isinstance() checks or raise exceptions for edge cases\".\n        return sum(numbers) / len(numbers)\n\n\nclass MADCalculator:\n    \"\"\"Computes the Mean Absolute Deviation.\"\"\"\n    def compute_mad(self, numbers: List[float], mean: float) -> float:\n        # This will raise ZeroDivisionError if 'numbers' is empty,\n        # as per \"DO NOT add isinstance() checks or raise exceptions for edge cases\".\n        absolute_differences = [abs(x - mean) for x in numbers]\n        return sum(absolute_differences) / len(numbers)\n\n\nclass Result:\n    \"\"\"Holds the computed MAD value.\"\"\"\n    def __init__(self, value: float) -> None:\n        self.value = value\n\n\ndef mean_absolute_deviation(numbers: List[float]) -> float:\n    \"\"\" For a given list of input numbers, calculate Mean Absolute Deviation\n    around the mean of this dataset.\n    Mean Absolute Deviation is the average absolute difference between each\n    element and a centerpoint (mean in this case):\n    MAD = average | x - x_mean |\n    >>> mean_absolute_deviation([1.0, 2.0, 3.0, 4.0])\n    1.0\n    \"\"\"\n    validator = Validator()\n    validator.validate_numbers(numbers)\n\n    mean_calculator = MeanCalculator()\n    mean = mean_calculator.compute_mean(numbers)\n\n    mad_calculator = MADCalculator()\n    mad_value = mad_calculator.compute_mad(numbers, mean)\n\n    result = Result(mad_value)\n    return result.value"}
{"task_id": "HumanEval/3", "solution": "from typing import List, Iterator\n\n\nclass Operation:\n    \"\"\"Represents a single signed integer operation with a sequence index.\"\"\"\n    def __init__(self, amount: int, sequence: int) -> None:\n        self.amount = amount\n        self.sequence = sequence\n\n\nclass OperationList:\n    \"\"\"Adapts a list of integers into a sequence of Operation objects.\"\"\"\n    def __init__(self, raw_ops: List[int]) -> None:\n        self.operations: List[Operation] = []\n        for i, amount in enumerate(raw_ops):\n            self.operations.append(Operation(amount, i))\n\n    def is_empty(self) -> bool:\n        return not self.operations\n\n    def __iter__(self) -> Iterator[Operation]:\n        return iter(self.operations)\n\n    def __len__(self) -> int:\n        return len(self.operations)\n\n\nclass Account:\n    \"\"\"Maintains a running integer balance and detects if it is below zero.\"\"\"\n    def __init__(self) -> None:\n        self._balance: int = 0\n\n    def initialize(self) -> None:\n        self._balance = 0\n\n    def update_balance(self, amount: int) -> None:\n        self._balance += amount\n\n    def is_below_zero(self) -> bool:\n        return self._balance < 0\n\n    def get_balance(self) -> int:\n        return self._balance\n\n\nclass Result:\n    \"\"\"DTO holding a boolean outcome for whether the balance went below zero.\"\"\"\n    def __init__(self, below_zero: bool) -> None:\n        self.below_zero = below_zero\n\n\ndef below_zero(operations: List[int]) -> bool:\n    \"\"\" You're given a list of deposit and withdrawal operations on a bank account that starts with\n    zero balance. Your task is to detect if at any point the balance of account fallls below zero, and\n    at that point function should return True. Otherwise it should return False.\n    >>> below_zero([1, 2, 3])\n    False\n    >>> below_zero([1, 2, -4, 5])\n    True\n    \"\"\"\n    op_list = OperationList(operations)\n    account = Account()\n    account.initialize()\n\n    if op_list.is_empty():\n        return False\n\n    for op in op_list:\n        account.update_balance(op.amount)\n        if account.is_below_zero():\n            return True\n\n    return False"}
{"task_id": "HumanEval/8", "solution": "from typing import List, Tuple\n\n\ndef validate_input(numbers: List[int]) -> bool:\n    \"\"\"Checks if the input is a list of integers.\"\"\"\n    if not isinstance(numbers, list):\n        return False\n    return all(isinstance(x, int) for x in numbers)\n\ndef compute_sum(numbers: List[int]) -> int:\n    \"\"\"Calculates the sum of integers in a list, returning 0 for an empty list.\"\"\"\n    return sum(numbers)\n\ndef compute_product(numbers: List[int]) -> int:\n    \"\"\"Calculates the product of integers in a list, returning 1 for an empty list.\"\"\"\n    product = 1\n    for number in numbers:\n        product *= number\n    return product\n\ndef sum_product(numbers: List[int]) -> Tuple[int, int]:\n    \"\"\" For a given list of integers, return a tuple consisting of a sum and a product of all the integers in a list.\n    Empty sum should be equal to 0 and empty product should be equal to 1.\n    >>> sum_product([])\n    (0, 1)\n    >>> sum_product([1, 2, 3, 4])\n    (10, 24)\n    \"\"\"\n    if not validate_input(numbers):\n        raise TypeError(\"numbers must be a list of integers\")\n    \n    s = compute_sum(numbers)\n    p = compute_product(numbers)\n    \n    return (s, p)"}
{"task_id": "HumanEval/2", "solution": "import math\n\nclass ValidationService:\n    \"\"\"Provides static methods for validating floating-point numbers.\"\"\"\n    @staticmethod\n    def validate_positive_finite(number: float) -> bool:\n        \"\"\"Returns True if the number is positive and finite.\"\"\"\n        return number > 0 and math.isfinite(number)\n\n    @staticmethod\n    def ensure_positive_finite_or_raise(number: float) -> None:\n        \"\"\"Raises ValueError if the number is not positive or not finite.\"\"\"\n        if not ValidationService.validate_positive_finite(number):\n            raise ValueError(\"Input number must be a positive, finite floating-point number.\")\n\nclass FloatingPointNumber:\n    \"\"\"Represents a floating-point number with helper methods.\"\"\"\n    def __init__(self, value: float) -> None:\n        self.value = value\n\n    def is_integer(self) -> bool:\n        \"\"\"Checks if the number represents an exact integer.\"\"\"\n        return self.value == math.floor(self.value)\n\nclass DecimalPart:\n    \"\"\"Represents the computed fractional part of a number.\"\"\"\n    def __init__(self, value: float) -> None:\n        self.value = value\n\ndef truncate_number(number: float) -> float:\n    \"\"\" Given a positive floating point number, it can be decomposed into\n    and integer part (largest integer smaller than given number) and decimals\n    (leftover part always smaller than 1).\n\n    Return the decimal part of the number.\n    >>> truncate_number(3.5)\n    0.5\n    \"\"\"\n    ValidationService.ensure_positive_finite_or_raise(number)\n\n    integer_part = math.floor(number)\n    decimal_value = number - integer_part\n\n    if decimal_value == 0.0:\n        return 0.0\n    else:\n        return decimal_value"}
{"task_id": "HumanEval/1", "solution": "from typing import List\nfrom dataclasses import dataclass\n\n\n@dataclass\nclass InputString:\n    raw: str\n\n\n@dataclass\nclass ParenGroup:\n    content: str\n    startIndex: int\n    endIndex: int\n    nestingDepth: int\n\n\nclass Parser:\n    def separate_paren_groups(self, paren_string: str) -> List[str]:\n        \"\"\"Delegates to helpers to remove spaces and capture groups, then returns list of group content strings.\"\"\"\n        cleaned_input = self._remove_spaces(paren_string)\n        paren_groups = self._scan_and_capture(cleaned_input)\n        return [g.content for g in paren_groups]\n\n    def _remove_spaces(self, input_raw: str) -> InputString:\n        \"\"\"Removes all space characters from the input string.\"\"\"\n        return InputString(raw=input_raw.replace(' ', ''))\n\n    def _scan_and_capture(self, input_string: InputString) -> List[ParenGroup]:\n        \"\"\"Scans the space-stripped string to identify and capture top-level balanced parenthesis groups.\"\"\"\n        depth = 0\n        groups: List[ParenGroup] = []\n        start_idx = -1\n        current_group_max_depth = 0\n\n        for i, char in enumerate(input_string.raw):\n            if char == '(':\n                depth += 1\n                if start_idx == -1:  # Starting a new top-level group\n                    start_idx = i\n                    current_group_max_depth = 1  # Minimum depth for a group is 1\n                else:  # Within an existing group\n                    current_group_max_depth = max(current_group_max_depth, depth)\n            elif char == ')':\n                depth -= 1\n                if depth == 0 and start_idx != -1:  # End of a top-level group\n                    end_idx = i\n                    content = self._capture_substring(input_string.raw, start_idx, end_idx)\n                    groups.append(ParenGroup(content, startIndex=start_idx, endIndex=end_idx, nestingDepth=current_group_max_depth))\n                    start_idx = -1  # Reset for next group\n                    current_group_max_depth = 0  # Reset max depth for next group\n            # Other characters are ignored as per design.\n\n        return groups\n\n    def _capture_substring(self, s: str, start_idx: int, end_idx: int) -> str:\n        \"\"\"Helper to capture a substring from the given start and end indices (inclusive).\"\"\"\n        return s[start_idx : end_idx + 1]\n\n\ndef separate_paren_groups(paren_string: str) -> List[str]:\n    \"\"\" Input to this function is a string containing multiple groups of nested parentheses. Your goal is to\n    separate those group into separate strings and return the list of those.\n    Separate groups are balanced (each open brace is properly closed) and not nested within each other\n    Ignore any spaces in the input string.\n    >>> separate_paren_groups('( ) (( )) (( )( ))')\n    ['()', '(())', '(()())']\n    \"\"\"\n    return Parser().separate_paren_groups(paren_string)"}
{"task_id": "HumanEval/5", "solution": "from typing import List\n\n\ndef intersperse(numbers: List[int], delimeter: int) -> List[int]:\n    \"\"\"\n    Insert a number 'delimeter' between every two consecutive elements of input list `numbers'\n    >>> intersperse([], 4)\n    []\n    >>> intersperse([1, 2, 3], 4)\n    [1, 4, 2, 4, 3]\n    \"\"\"\n    if not isinstance(numbers, list):\n        raise TypeError(\"numbers must be a list of int\")\n    if not isinstance(delimeter, int):\n        raise TypeError(\"delimeter must be an int\")\n    if not all(isinstance(x, int) for x in numbers):\n        raise TypeError(\"all elements of numbers must be int\")\n\n    if not numbers:\n        return []\n    if len(numbers) == 1:\n        return [numbers[0]]\n\n    result = []\n    for i, num in enumerate(numbers):\n        result.append(num)\n        if i < len(numbers) - 1:\n            result.append(delimeter)\n    return result"}
{"task_id": "HumanEval/12", "solution": "from typing import List, Optional\n\n\ndef longest(strings: List[str]) -> Optional[str]:\n    \"\"\" Out of list of strings, return the longest one. Return the first one in case of multiple\n    strings of the same length. Return None in case the input list is empty.\n    >>> longest([])\n\n    >>> longest(['a', 'b', 'c'])\n    'a'\n    >>> longest(['a', 'bb', 'ccc'])\n    'ccc'\n    \"\"\"\n    if not strings:\n        return None\n\n    longest_str: Optional[str] = None\n    max_length = -1\n\n    for s in strings:\n        current_length = len(s)\n        if current_length > max_length:\n            max_length = current_length\n            longest_str = s\n            \n    return longest_str"}
{"task_id": "HumanEval/15", "solution": "from typing import List\n\nclass SequenceGenerator:\n    \"\"\"Generates a sequence of integers from 0 to n.\"\"\"\n    def generate_numbers(self, n: int) -> List[int]:\n        return list(range(n + 1))\n\nclass Formatter:\n    \"\"\"Formats a list of integers into a space-delimited string.\"\"\"\n    delimiter: str = ' '\n\n    def format_numbers(self, nums: List[int]) -> str:\n        return self.delimiter.join(str(x) for x in nums)\n\nclass StringSequenceFunction:\n    \"\"\"Coordinates generation and formatting of a number sequence.\"\"\"\n    deterministic: bool = True\n\n    def string_sequence(self, n: int) -> str:\n        generator = SequenceGenerator()\n        formatter = Formatter()\n\n        numbers = generator.generate_numbers(n)\n        result_string = formatter.format_numbers(numbers)\n        return result_string\n\ndef string_sequence(n: int) -> str:\n    \"\"\" Return a string containing space-delimited numbers starting from 0 upto n inclusive.\n    >>> string_sequence(0)\n    '0'\n    >>> string_sequence(5)\n    '0 1 2 3 4 5'\n    \"\"\"\n    controller = StringSequenceFunction()\n    return controller.string_sequence(n)"}
{"task_id": "HumanEval/13", "solution": "def greatest_common_divisor(a: int, b: int) -> int:\n    \"\"\" Return a greatest common divisor of two integers a and b\n    >>> greatest_common_divisor(3, 5)\n    1\n    >>> greatest_common_divisor(25, 15)\n    5\n    \"\"\"\n    # Use the Euclidean algorithm, ensuring inputs are non-negative for a standard GCD result.\n    a = abs(a)\n    b = abs(b)\n    while b:\n        a, b = b, a % b\n    return a"}
{"task_id": "HumanEval/11", "solution": "from typing import List\n\n\nclass BinaryString:\n    \"\"\"Encapsulates a binary input string and provides validation.\"\"\"\n    def __init__(self, value: str) -> None:\n        self.value = value\n        self.length = len(value)\n\n    def is_binary(self) -> bool:\n        \"\"\"Checks if the string contains only '0' or '1' characters.\"\"\"\n        return all(char in ('0', '1') for char in self.value)\n\n\nclass ResultString:\n    \"\"\"Holds the computed XOR result string and its length.\"\"\"\n    def __init__(self, value: str) -> None:\n        self.value = value\n        self.length = len(value)\n\n\ndef string_xor(a: str, b: str) -> str:\n    \"\"\" Input are two strings a and b consisting only of 1s and 0s.\n    Perform binary XOR on these inputs and return result also as a string.\n    >>> string_xor('010', '110')\n    '100'\n    \"\"\"\n    binary_a = BinaryString(a)\n    binary_b = BinaryString(b)\n\n    if not binary_a.is_binary() or not binary_b.is_binary():\n        raise ValueError(\"Inputs must be binary strings containing only '0' and '1'.\")\n\n    if binary_a.length != binary_b.length:\n        raise ValueError(\"Input strings must have the same length.\")\n\n    result_chars: List[str] = []\n    for i in range(binary_a.length):\n        # Perform XOR: if bits are the same, result is '0'; otherwise, '1'.\n        if binary_a.value[i] == binary_b.value[i]:\n            result_chars.append('0')\n        else:\n            result_chars.append('1')\n\n    result_value = \"\".join(result_chars)\n    # According to design, create a ResultString object, then return its value.\n    _ = ResultString(result_value)\n    return result_value"}
{"task_id": "HumanEval/14", "solution": "from typing import List\n\n\ndef all_prefixes(string: str) -> List[str]:\n    \"\"\" Return list of all prefixes from shortest to longest of the input string.\n    The input must be a string.\n    >>> all_prefixes('abc')\n    ['a', 'ab', 'abc']\n    \"\"\"\n    n = len(string)\n    result = []\n    for k in range(1, n + 1):\n        result.append(string[0:k])\n    return result"}
{"task_id": "HumanEval/10", "solution": "def make_palindrome(string: str) -> str:\n    \"\"\" Find the shortest palindrome that begins with a supplied string.\n    Algorithm idea is simple:\n    - Find the longest postfix of supplied string that is a palindrome.\n    - Append to the end of the string reverse of a string prefix that comes before the palindromic suffix.\n    >>> make_palindrome('')\n    ''\n    >>> make_palindrome('cat')\n    'catac'\n    >>> make_palindrome('cata')\n    'catac'\n    \"\"\"\n    if not string:\n        return \"\"\n\n    for i in range(len(string)):\n        suffix = string[i:]\n        if is_palindrome(suffix):\n            prefix_to_mirror = string[:i]\n            return string + prefix_to_mirror[::-1]"}
{"task_id": "HumanEval/16", "solution": "from typing import Iterable\n\n\ndef _validate_input(string) -> None:\n    \"\"\"Checks if the input is a string and raises TypeError if not.\"\"\"\n    if not isinstance(string, str):\n        raise TypeError(\"input must be str\")\n\n\ndef _case_fold(string: str) -> str:\n    \"\"\"Applies Unicode-aware case folding to the string.\"\"\"\n    return string.casefold()\n\n\ndef _extract_characters(string: str) -> Iterable[str]:\n    \"\"\"Yields each character (codepoint) from the string.\"\"\"\n    yield from string\n\n\ndef _compute_distinct_count(chars: Iterable[str]) -> int:\n    \"\"\"Builds a set of characters and returns its size.\"\"\"\n    return len(set(chars))\n\n\ndef count_distinct_characters(string: str) -> int:\n    \"\"\" Given a string, find out how many distinct characters (regardless of case) does it consist of\n    >>> count_distinct_characters('xyzXYZ')\n    3\n    >>> count_distinct_characters('Jerry')\n    4\n    \"\"\"\n    _validate_input(string)\n    folded = _case_fold(string)\n    chars = _extract_characters(folded)\n    return _compute_distinct_count(chars)"}
{"task_id": "HumanEval/17", "solution": "from typing import List\n\n# Domain Constants\nALLOWED_SYMBOLS = frozenset({'o', 'o|', '.|'})\nNOTE_TYPE_MAP = {'o': 4, 'o|': 2, '.|': 1}\n\ndef tokenize(music_string: str) -> List[str]:\n    \"\"\"Splits the music_string into tokens based on whitespace.\"\"\"\n    return music_string.split()\n\ndef validate_tokens(tokens: List[str]) -> None:\n    \"\"\"Validates if all tokens are allowed, raising ValueError on the first invalid token.\"\"\"\n    for token in tokens:\n        if token not in ALLOWED_SYMBOLS:\n            raise ValueError(f\"Invalid token: '{token}'\")\n\ndef map_token_to_beats(token: str) -> int:\n    \"\"\"Maps a single token to its corresponding beat value.\"\"\"\n    return NOTE_TYPE_MAP[token]\n\ndef map_tokens(tokens: List[str]) -> List[int]:\n    \"\"\"Maps a list of tokens to a list of their corresponding beat values.\"\"\"\n    return [map_token_to_beats(t) for t in tokens]\n\ndef parse_music(music_string: str) -> List[int]:\n    \"\"\" Input to this function is a string representing musical notes in a special ASCII format.\n    Your task is to parse this string and return list of integers corresponding to how many beats does each\n    not last.\n\n    Here is a legend:\n    'o' - whole note, lasts four beats\n    'o|' - half note, lasts two beats\n    '.|' - quater note, lasts one beat\n\n    >>> parse_music('o o| .| o| o| .| .| .| .| o o')\n    [4, 2, 1, 2, 2, 1, 1, 1, 1, 4, 4]\n    \"\"\"\n    tokens = tokenize(music_string)\n    if not tokens:\n        return []\n    validate_tokens(tokens)\n    return map_tokens(tokens)"}
{"task_id": "HumanEval/18", "solution": "from typing import List\n\nclass OCCURRENCE_TRACKER:\n    \"\"\"Tracks the start positions of substring occurrences.\"\"\"\n    def __init__(self) -> None:\n        self.positions: List[int] = []\n    def add(self, position: int) -> None:\n        \"\"\"Adds a new occurrence position.\"\"\"\n        self.positions.append(position)\n    def count(self) -> int:\n        \"\"\"Returns the total number of recorded occurrences.\"\"\"\n        return len(self.positions)\n\ndef how_many_times(string: str, substring: str) -> int:\n    \"\"\" Find how many times a given substring can be found in the original string. Count overlaping cases.\n    >>> how_many_times('', 'a')\n    0\n    >>> how_many_times('aaa', 'a')\n    3\n    >>> how_many_times('aaaa', 'aa')\n    3\n    \"\"\"\n    tracker = OCCURRENCE_TRACKER()\n    # Behavior for an empty substring is unspecified by SRS.\n    if len(substring) == 0:\n        pass \n    # If string is empty and substring non-empty, return 0.\n    if len(string) == 0 and len(substring) > 0:\n        return 0\n    \n    max_start = len(string) - len(substring)\n    if max_start >= 0 and len(substring) > 0:\n        for i in range(0, max_start + 1):\n            if string[i:i+len(substring)] == substring:\n                tracker.add(i)\n    return tracker.count()"}
