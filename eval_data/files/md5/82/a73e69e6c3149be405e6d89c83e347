\n        \"\"\"Returns the matching bracket for the current symbol (e.g., '(' returns ')').\"\"\"\n        if self.symbol == '(':\n            return ')'\n        elif self.symbol == '{':\n            return '}'\n        elif self.symbol == '[':\n            return ']'\n        elif self.symbol == ')':\n            return '('\n        elif self.symbol == '}':\n            return '{'\n        elif self.symbol == ']':\n            return '['\n        return ''\nclass Stack:\n    \"\"\"Provides a simple LIFO stack storing Bracket instances.\"\"\"\n    def __init__(self) -> None:\n        self._items: List[Bracket] = []\n\n    def push(self, b: Bracket) -> None:\n        \"\"\"Pushes a Bracket onto the stack.\"\"\"\n        self._items.append(b)\n\n    def pop(self) -> Bracket:\n        \"\"\"Removes and returns the top Bracket from the stack.\"\"\"\n        if self.is_empty():\n            raise IndexError(\"pop from empty stack\")\n        return self._items.pop()\n\n    def peek(self) -> Bracket:\n        \"\"\"Returns the top Bracket from the stack without removing it.\"\"\"\n        if self.is_empty():\n            raise IndexError(\"peek from empty stack\")\n        return self._items[-1]\n\n    def is_empty(self) -> bool:\n        \"\"\"Checks if the stack is empty.\"\"\"\n        return len(self._items) == 0\n\n    def size(self) -> int:\n        \"\"\"Returns the number of items in the stack.\"\"\"\n        return len(self._items)\nclass Expression:\n    \"\"\"Represents the input expression and provides its length.\"\"\"\n    def __init__(self, value: str) -> None:\n        self.value: str = value\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the expression string.\"\"\"\n        return len(self.value)\nclass ExpressionChecker:\n    \"\"\"Implements the core logic for checking if an expression has balanced brackets.\"\"\"\n    def __init__(self) -> None:\n        self._opening_to_closing: Dict[str, str] = {'(': ')', '{': '}', '[': ']'}\n        self._closing_to_opening: Dict[str, str] = {')': '(', '}': '{', ']': '['}\n        self._all_brackets = set(self._opening_to_closing.keys()).union(\n                               set(self._opening_to_closing.values()))\n\n    def check_expression(self, expression_str: str) -> bool:\n        \"\"\"Checks if the given expression string has balanced brackets.\"\"\"\n        stack = Stack()\n        expression_obj = Expression(expression_str)\n\n        for char_symbol in expression_obj.value:\n            if char_symbol not in self._all_brackets:\n                continue\n\n            bracket = Bracket(char_symbol)\n\n            if bracket.is_opening():\n                stack.push(bracket)\n            else:\n                if stack.is_empty():\n                    return False\n                \n                top_bracket = stack.peek()\n                \n                if top_bracket.matching() == char_symbol:\n                    stack.pop()\n                else:\n                    return False\n        \n        return stack.is_empty()\ndef check_expression(expression: str) -> bool:\n    \"\"\"\n    Checks if the given expression has balanced brackets using a stack-based approach.\n    It delegates the actual checking logic to an ExpressionChecker instance.\n    \"\"\"\n    return ExpressionChecker().check_expression(expression)", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[""]]}], "Mbpp/781": [{"task_id": "Mbpp/781", "solution": "from dataclasses import dataclass\nimport math\ndef count_divisors(n: int) -> bool:\n    \"\"\"Compute number of positive divisors of n and return True if even, else False.\"\"\"\n    count = 0\n    # Iterate from 1 up to the integer square root of n to find divisors efficiently.\n    for i in range(1, math.isqrt(n) + 1):\n        if n % i == 0:\n            if i * i == n:\n                count += 1\n            else:\n                count += 2\n    \n    divisor_count_obj