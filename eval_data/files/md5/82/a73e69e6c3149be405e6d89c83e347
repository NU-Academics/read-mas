nner_str = self._raw[1:-1]\n\n        # Handle cases like \"()\" or \"(   )\" which should result in an empty tuple\n        if not inner_str.strip():\n            return ()\n\n        tokens = self._split_items(inner_str)\n        \n        parsed_integers: List[int] = []\n        for token in tokens:\n            try:\n                parsed_integers.append(self._parse_int(token))\n            except ValueError:\n                # Re-raise with more specific context if the token is invalid\n                raise ValueError(f\"Invalid integer literal '{token.strip()}' found in tuple string.\")\n\n        return tuple(parsed_integers)\n\n    def validate_format(self) -> bool:\n        \"\"\"\n        Checks if the raw string has the basic tuple format (starts with '(' and ends with ')').\n        \"\"\"\n        # Must start with '(' and end with ')'\n        if not (self._raw.startswith('(') and self._raw.endswith(')')):\n            return False\n        # Must be at least \"()\" in length\n        if len(self._raw) < 2:\n            return False\n        return True\n\n    def _split_items(self, raw_inner: str) -> List[str]:\n        \"\"\"\n        Splits the inner string by commas, preserving empty tokens as per design.\n        For example: \"7, 8, 9\" -> [\"7\", \" 8\", \" 9\"]; \"7,,9\" -> [\"7\", \"\", \"9\"].\n        \"\"\"\n        return raw_inner.split(',')\n\n    def _parse_int(self, token: str) -> int:\n        \"\"\"\n        Trims whitespace from a token and attempts to convert it to an integer.\n        Raises ValueError if the token is not a valid integer literal.\n        \"\"\"\n        stripped_token = token.strip()\n        # An empty string after stripping is not a valid integer literal (e.g., from \",,\").\n        if not stripped_token:\n            raise ValueError(\"Empty string is not a valid integer literal.\")\n        return int(stripped_token)\ndef tuple_str_int(raw: str) -> Tuple[int, ...]:\n    \"\"\"\n    Converts a string representation of an integer tuple to a Python tuple of integers.\n    Raises ValueError for invalid input format or non-integer tokens.\n    \"\"\"\n    parser = TupleParser(raw)\n    return parser.tuple_str_int()", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [["((7, 8, 9)"]]}], "Mbpp/784": [{"task_id": "Mbpp/784", "solution": "class InputList:\n    \"\"\"Represents an ordered list of integers with accessor methods.\"\"\"\n    def __init__(self, elements: list[int]) -> None:\n        self.elements = elements\n\n    def getElement(self, index: int) -> int:\n        return self.elements[index]\n\n    def length(self) -> int:\n        return len(self.elements)\nclass IntegerElement:\n    \"\"\"Wraps a single integer value and provides parity checks.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\n    def isEven(self) -> bool:\n        return self.value % 2 == 0\n\n    def isOdd(self) -> bool:\n        return self.value % 2 != 0\nclass MulEvenOddFunction:\n    \"\"\"Encapsulates the algorithm to find the first odd and first even values and compute their product.\"\"\"\n    def mul_even_odd(self, input_list: list[int]) -> int:\n        \"\"\"Finds the product of the first odd and first even numbers in the list.\"\"\"\n        first_odd = self.find_first_odd(input_list)\n        first_even = self.find_first_even(input_list)\n        return Result(first_odd * first_even).value\n\n    def find_first_odd(self, input_list: list[int]) -> int:\n        \"\"\"Identifies the first odd number in input_list by scanning elements from index 0.\"\"\"\n        input_wrapper = InputList(input_list)\n        for i in range(input_wrapper.length()):\n            element = IntegerElement(input_wrapper.getElement(i))\n            if element.isOdd():\n                return element.value\n        raise ValueError(\"No odd number found in the list.\")\n\n    def find_first_even(self, input_list: list[int]) -> int:\n        \"\"\"Identifies the first even number in input_list by scanning elements from index 0.\"\"\"\n        input_wrapper = InputList(input_list)\n        for i in range(input_wrapper.length()):\n            element = IntegerElement(input_wrapper.getElement(i))\n            if element.isEven():\n                return element.value\n        raise ValueError(\"No even number found in the list.\")\nclass Result:\n    \"\"\"Container for the computed integer product.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\ndef mul_even_odd(input_list: list[int]) -> int:\n    \"\"\"\n    Finds the product of the first even and odd number of a given list.\n    \"\"\"\n    calculator = MulEvenOddFunction()\n    return calculator.mul_even_odd(input_list)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/788": [{"task_id": "Mbpp/788", "solution": "def new_tuple(input_list: list, input_string: str) -> tuple:\n    \"\"\"Return a tuple containing elements of input_list in order followed by input_string.\n    Preconditions (per SRS): input_list is a Python list, input_string is a Python str.\n    \"\"\"\n    return tuple(input_list + [input_string])", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/790": [{"task_id": "Mbpp/790", "solution": "def even_position(lst: list[int]) -> bool:\n    \"\"\"Return True if every element at an even index of lst is even (integer % 2 == 0).\"\"\"\n    for i, v in enumerate(lst):\n        if i % 2 == 0:  # Check if the current index is even\n            if v % 2 != 0:  # Check if the value at this even index is odd\n                return False\n    return True", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[[2, 1, 4, 2, 6, 1, 8, 2, 10, 1, 12]]]}], "Mbpp/791": [{"task_id": "Mbpp/791", "solution": "from typing import Any, Tuple\ndef _is_tuple(obj: object) -> bool:\n    \"\"\"Checks if an object's exact type is a tuple.\"\"\"\n    return type(obj) is tuple\ndef remove_nested(input_tuple: tuple) -> tuple:\n    \"\"\"Removes top-level tuple elements from the given tuple.\n    Raises TypeError if the input is not a tuple.\"\"\"\n    if not isinstance(input_tuple, tuple):\n        raise TypeError(\"remove_nested: input must be tuple\")\n    result_list = []\n    for el in input_tuple:\n        if not _is_tuple(el):\n            result_list.append(el)\n    return tuple(result_list)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/745": [{"task_id": "Mbpp/745", "solution": "from typing import List\nclass Digit:\n    \"\"\"Represents a single decimal digit.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\nclass Number:\n    \"\"\"Encapsulates an integer candidate and operations related to its digits.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n        # Extract digits from the absolute value of the number.\n        abs_value_str = str(abs(value))\n        self.digits: List[Digit] = [Digit(int(d_char)) for d_char in abs_value_str]\n\n    def hasZeroDigit(self) -> bool:\n        \"\"\"Returns True if the number contains the digit 0.\"\"\"\n        return any(d.value == 0 for d in self.digits)\n\n    def divisibleByAllDigits(self) -> bool:\n        \"\"\"\n        Checks if the number is divisible by all its non-zero digits.\n        Numbers containing digit 0 are handled by hasZeroDigit, so this method assumes no zeros.\n        \"\"\"\n        for d in self.digits:\n            # Per requirement, only check divisibility by non-zero digits.\n            if d.value == 0:\n                continue\n            if self.value % d.value != 0:\n                return False\n        return True\nclass ResultList:\n    \"\"\"Collects and manages a list of result integers, providing sorting functionality.\"\"\"\n    def __init__(self):\n        self.values: List[int] = []\n\n    def add(self, value: int):\n        \"\"\"Adds an integer to the result list.\"\"\"\n        self.values.append(value)\n\n    def sortAscending(self):\n        \"\"\"Sorts the collected integers in ascending order.\"\"\"\n        self.values.sort()\n\n    def to_list(self) -> List[int]:\n        \"\"\"Returns the collected integers as a Python list.\"\"\"\n        return self.values\nclass DivisibleByDigitsFunction:\n    \"\"\"Implements the core logic for finding numbers divisible by their digits within a range.\"\"\"\n    def divisible_by_digits(self, startnum: int, endnum: int) -> List[int]:\n        result_list = ResultList()\n        # Iterate through the inclusive range.\n        for n in range(startnum, endnum + 1):\n            num = Number(n)\n            # Exclude numbers containing the digit 0.\n            if num.hasZeroDigit():\n                continue\n            # Check if the number is divisible by all its non-zero digits.\n            if num.divisibleByAllDigits():\n                result_list.add(n)\n        \n        result_list.sortAscending()\n        return result_list.to_list()\ndef divisible_by_digits(startnum: int, endnum: int) -> List[int]:\n    \"\"\"\n    Finds numbers within a given range (inclusive) where every number is divisible\n    by every digit it contains, excluding numbers with the digit 0.\n    \"\"\"\n    # Delegates the core logic to an instance of DivisibleByDigitsFunction.\n    core_logic_instance = DivisibleByDigitsFunction()\n    return core_logic_instance.divisible_by_digits(startnum, endnum)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/796": [{"task_id": "Mbpp/796", "solution": "from typing import Dict, Union\ndef return_sum(input: Dict[str, Union[int, float]]) -> Union[int, float]:\n    \"\"\"Compute and return the sum of all numeric values in the input dictionary.\n\n    Preconditions: input is a dict with string keys and numeric values (int or float).\n    Behavior:\n      - Empty dict -> returns 0.\n      - If any value is not int/float -> raise TypeError.\n    \"\"\"\n    for value in input.values():\n        if not isinstance(value, (int, float)):\n            raise TypeError(\"Dictionary values must be int or float.\")\n    \n    return sum(input.values())", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/792": [{"task_id": "Mbpp/792", "solution": "def count_list(arg) -> int:\n    \"\"\"Return the number of top-level elements in arg that are of type list.\n       Raises TypeError if arg is not an iterable.\"\"\"\n    count = 0\n    try:\n        for item in arg:\n            if isinstance(item, list):\n                count += 1\n    except TypeError:\n        raise TypeError(\"Input must be an iterable.\")\n    return count", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/794": [{"task_id": "Mbpp/794", "solution": "def text_starta_endb(input: str) -> bool:\n    \"\"\"\n    Checks if a string starts with 'a' and ends with 'b', case-sensitively.\n    Returns False for strings shorter than 2 characters.\n    \"\"\"\n    if len(input) < 2:\n        return False\n    return input[0] == 'a' and input[-1] == 'b'", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [["xaabbyz1323ababb"]]}], "Mbpp/797": [{"task_id": "Mbpp/797", "solution": "class Range:\n    \"\"\"Encapsulates input bounds and implements lower-bound normalization.\"\"\"\n    def __init__(self, l: int, r: int):\n        self.l = l\n        self.r = r\n\n    def normalized_lower(self) -> int:\n        \"\"\"Returns the lower bound, normalized to be at least 1.\"\"\"\n        return max(self.l, 1)\nclass Number:\n    \"\"\"Represents a single integer value and provides domain predicates.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def is_natural(self) -> bool:\n        \"\"\"Checks if the number is a natural number (>= 1).\"\"\"\n        return self.value >= 1\n\n    def is_odd(self) -> bool:\n        \"\"\"Checks if the number is odd.\"\"\"\n        return self.value % 2 == 1\nclass SumResult:\n    \"\"\"Container for the computed total sum.\"\"\"\n    def __init__(self, total: int):\n        self.total = total\n\n    def as_int(self) -> int:\n        \"\"\"Returns the total sum as an integer.\"\"\"\n        return self.total\ndef sum_in_range(l: int, r: int) -> int:\n    \"\"\"\n    Finds the sum of all odd natural numbers within the inclusive range [l, r].\n    Natural numbers are defined as integers >= 1.\n    \"\"\"\n    _validate_inputs(l, r)\n\n    current_range = Range(l, r)\n    normalized_lower = current_range.normalized_lower()\n    \n    total_sum = 0\n    for n in range(normalized_lower, r + 1):\n        num = Number(n)\n        if num.is_natural() and num.is_odd():\n            total_sum += n\n            \n    result = SumResult(total_sum)\n    return result.as_int()", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[2, 5]], "plus_fail_tests": [[1, 10000]]}], "Mbpp/793": [{"task_id": "Mbpp/793", "solution": "class SortedArray:\n    \"\"\"A wrapper for a list that may be sorted.\"\"\"\n    def __init__(self, elements: list) -> None:\n        self.elements = elements\n\n    def is_sorted(self) -> bool:\n        \"\"\"Checks if the wrapped list is sorted in non-decreasing order.\"\"\"\n        return all(self.elements[i] <= self.elements[i+1] for i in range(len(self.elements) - 1))\nclass BinarySearch:\n    \"\"\"Implements binary search logic to find the last occurrence of a value.\"\"\"\n    def find_last(self, arr: 'SortedArray', value) -> int:\n        \"\"\"\n        Finds the last position of 'value' in a sorted array.\n        Returns the zero-based index of the last occurrence, or -1 if not found.\n        \"\"\"\n        low = 0\n        high = len(arr.elements) - 1\n        result = -1\n\n        while low <= high:\n            mid = low + (high - low) // 2\n            if arr.elements[mid] == value:\n                result = mid  # Found a potential last occurrence\n                low = mid + 1 # Continue searching in the right half for a later occurrence\n            elif arr.elements[mid] < value:\n                low = mid + 1\n            else: # arr.elements[mid] > value\n                high = mid - 1\n        return result\ndef last(array, value) -> int:\n    \"\"\"\n    Finds the last position of an element in a sorted array.\n    Assumes the input array is sorted. Returns -1 if the value is not found.\n    \"\"\"\n    sorted_array_obj = SortedArray(array)\n    searcher = BinarySearch()\n    return searcher.find_last(sorted_array_obj, value)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/798": [{"task_id": "Mbpp/798", "solution": "from typing import Iterable, Union\nNumeric = Union[int, float]\ndef _sum(items: Iterable[Numeric]) -> Numeric:\n    \"\"\"Compute arithmetic sum of numeric elements in items.\n\n    Args:\n        items: An iterable (e.g., list) containing numeric elements.\n\n    Returns:\n        The arithmetic sum of elements, or 0 for empty input.\n    \"\"\"\n    total: Numeric = 0\n    for item in items:\n        total += item\n    return total", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/799": [{"task_id": "Mbpp/799", "solution": "def left_rotate(n: int, d: int) -> int:\n    \"\"\"\n    Performs a 32-bit left circular rotation on the given number.\n    The number is treated as a 32-bit unsigned integer.\n    \"\"\"\n    N_BITS = 32\n    MASK = 0xFFFFFFFF\n\n    # Mask the input number to ensure it's treated as a 32-bit unsigned integer.\n    n_masked = n & MASK\n\n    # Calculate the effective rotation count, ensuring it's within [0, 31].\n    effective_d = d % N_BITS\n\n    if effective_d == 0:\n        # If the effective rotation is 0, the number remains unchanged.\n        return n_masked\n    else:\n        # Perform the left circular rotation.\n        # The left part is shifted 'effective_d' bits to the left.\n        # The right part is shifted 'N_BITS - effective_d' bits to the right\n        # to bring back the bits that wrapped around from the left shift.\n        rotated_val = ((n_masked << effective_d) | (n_masked >> (N_BITS - effective_d)))\n\n        # Mask the final result to ensure it stays within 32 bits.\n        return rotated_val & MASK", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/803": [{"task_id": "Mbpp/803", "solution": "import math\ndef is_perfect_square(n: float) -> bool:\n    \"\"\"\n    Checks if the given number is a perfect square.\n    Handles both integer and float inputs, treating floats as perfect squares\n    only if they are mathematically integer squares (e.g., 4.0).\n    \"\"\"\n    if n < 0:\n        return False\n    \n    root = math.sqrt(n)\n    k = round(root)\n    return k * k == n", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/800": [{"task_id": "Mbpp/800", "solution": "WHITESPACE_CHARS = {' ', '\\t', '\\n', '\\r'}\ndef remove_all_spaces(s: str) -> str:\n    \"\"\"Return a new string equal to s but with all characters in WHITESPACE_CHARS removed.\n\n    Preconditions: caller supplies a str.\n    \"\"\"\n    buffer = []\n    for char in s:\n        if char not in WHITESPACE_CHARS:\n            buffer.append(char)\n    return ''.join(buffer)", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [["python\nprogram"]]}], "Mbpp/801": [{"task_id": "Mbpp/801", "solution": "def validate_integer(input) -> bool:\n    \"\"\"Checks if the input is an integer.\"\"\"\n    return isinstance(input, int)\ndef test_three_equal(a, b, c) -> int:\n    \"\"\"Counts the number of equal values among three given integers.\"\"\"\n    if not (validate_integer(a) and validate_integer(b) and validate_integer(c)):\n        raise TypeError(\"All inputs must be integers\")\n\n    if a == b and b == c:\n        return 3\n    elif a == b or a == c or b == c:\n        return 2\n    else:\n        return 0", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/804": [{"task_id": "Mbpp/804", "solution": "from typing import List, Union\nclass Number:\n    \"\"\"Represents a single numeric value.\"\"\"\n    def __init__(self, value: Union[int, float]):\n        self.value = value\nclass NumberList:\n    \"\"\"Represents a collection of Number instances.\"\"\"\n    def __init__(self, numbers: List[Union[Number, int, float]]):\n        self.numbers: List[Number] = []\n        for n in numbers:\n            if isinstance(n, Number):\n                self.numbers.append(n)\n            else:\n                self.numbers.append(Number(n))\n\n    def length(self) -> int:\n        \"\"\"Returns the number of elements in the list.\"\"\"\n        return len(self.numbers)\n\n    def as_values(self) -> List[Union[int, float]]:\n        \"\"\"Extracts raw numeric values from Number instances.\"\"\"\n        return [n.value for n in self.numbers]\nclass ProductComputation:\n    \"\"\"Computes product and determines parity, encapsulates BR-4/BR-5 logic.\"\"\"\n    def computeProduct(self, numbers: List[Number]) -> float:\n        \"\"\"Computes the product of a list of Number instances.\"\"\"\n        if not numbers:\n            return 1.0\n        product = 1.0\n        for num in numbers:\n            product *= num.value\n        return product\n\n    def isEven(self, value: Union[int, float]) -> bool:\n        \"\"\"Determines if a numeric value is even.\"\"\"\n        # A number is even if it's an integer and divisible by 2.\n        return value == int(value) and int(value) % 2 == 0\n\n    def is_product_even_by_elements(self, numbers: List[Number]) -> bool:\n        \"\"\"Determines if the product of numbers is even by inspecting elements (short-circuiting).\"\"\"\n        # Returns True if any number is even, False otherwise (including empty list product of 1).\n        for num in numbers:\n            if self.isEven(num.value):\n                return True\n        return False\nclass Result:\n    \"\"\"Domain container for the boolean result.\"\"\"\n    def __init__(self, value: bool):\n        self.value = value\ndef is_product_even(numbers: List[Union[int, float]]) -> bool:\n    \"\"\"\n    Checks whether the product of numbers in a list is even or not.\n    \"\"\"\n    number_list = NumberList(numbers)\n    product_computation = ProductComputation()\n    is_even_result = product_computation.is_product_even_by_elements(number_list.numbers)\n    result_obj = Result(is_even_result)\n    return result_obj.value", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/805": [{"task_id": "Mbpp/805", "solution": "from typing import List, Sequence\ndef _compute_sums(list_of_lists: Sequence[Sequence[float]]) -> List[float]:\n    # Computes the arithmetic sum for each inner list, returning a list of sums.\n    return [sum(inner_list) for inner_list in list_of_lists]\ndef _select_max(\n    list_of_lists: Sequence[Sequence[float]], sums: List[float]\n) -> List[float]:\n    # Selects the inner list corresponding to the highest sum, with ties broken by first occurrence.\n    max_sum_value = max(sums)\n    max_index = sums.index(max_sum_value)\n    return list_of_lists[max_index]\ndef max_sum_list(list_of_lists: Sequence[Sequence[float]]) -> List[float]:\n    # Returns the inner list with the highest sum of elements.\n    if not list_of_lists:\n        return []\n\n    sums = _compute_sums(list_of_lists)\n    result_list = _select_max(list_of_lists, sums)\n    return result_list", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/806": [{"task_id": "Mbpp/806", "solution": "def max_run_uppercase(input_string: str) -> int:\n    \"\"\"\n    Finds the maximum run of uppercase ASCII characters in the given string.\n    \"\"\"\n    max_run = 0\n    current_run = 0\n    for char in input_string:\n        if 'A' <= char <= 'Z':\n            current_run += 1\n            if current_run > max_run:\n                max_run = current_run\n        else:\n            current_run = 0\n    return max_run", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [["Aaa"]]}], "Mbpp/807": [{"task_id": "Mbpp/807", "solution": "from typing import Optional, Iterable\ndef first_odd(numbers: Iterable[int]) -> Optional[int]:\n    \"\"\"\n    Return the first odd integer in the provided sequence 'numbers'.\n\n    Returns None if no odd number is found.\n    \"\"\"\n    for x in numbers:\n        if x % 2 != 0:\n            return x\n    return None", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/721": [{"task_id": "Mbpp/721", "solution": "import math\nclass Cell:\n    def __init__(self, row: int, col: int, cost: float):\n        self.row = row\n        self.col = col\n        self.cost = cost\nclass Matrix:\n    def __init__(self, N: int, cells: list[list[float]]):\n        self.N = N\n        self.cells = cells\n\n    def getCell(self, row: int, col: int) -> float:\n        return self.cells[row][col]\nclass Path:\n    def __init__(self, cells: list[Cell]):\n        self.cells = cells\n        self.length = len(cells)\n\n    def totalCost(self) -> float:\n        return sum(cell.cost for cell in self.cells)\n\n    def average(self) -> float:\n        if self.length == 0:\n            return 0.0\n        return self.totalCost() / self.length\nclass Result:\n    def __init__(self, maxAverage: float, bestPath: Path | None):\n        self.maxAverage = maxAverage\n        self.bestPath = bestPath\nclass Validator:\n    def validate(self, matrix_input: list[list[float]]) -> Matrix:\n        if not isinstance(matrix_input, list):\n            raise ValueError(\"Input must be a list of lists.\")\n        \n        if not matrix_input:\n            raise ValueError(\"Input matrix cannot be empty.\")\n        \n        N = len(matrix_input)\n\n        for r, row in enumerate(matrix_input):\n            if not isinstance(row, list) or len(row) != N:\n                raise ValueError(f\"Row {r} is not a list or has incorrect length. Input matrix must be square (N x N).\")\n            for c, cell_value in enumerate(row):\n                if not isinstance(cell_value, (int, float)):\n                    raise ValueError(f\"Matrix cell [{r}][{c}] must contain numeric values.\")\n        \n        return Matrix(N, matrix_input)\nclass PathCalculator:\n    def computeAllPaths(self, matrix: Matrix) -> list[Path]:\n        N = matrix.N\n        all_paths: list[Path] = []\n\n        def backtrack(r: int, c: int, current_path_cells: list[Cell]):\n            current_path_cells.append(Cell(r, c, matrix.getCell(r, c)))\n\n            if r == N - 1 and c == N - 1:\n                # A valid path has 2*N - 1 cells.\n                if len(current_path_cells) == (2 * N - 1):\n                    all_paths.append(Path(list(current_path_cells)))\n            else:\n                if c + 1 < N: # Move Right\n                    backtrack(r, c + 1, current_path_cells)\n                if r + 1 < N: # Move Down\n                    backtrack(r + 1, c, current_path_cells)\n            \n            current_path_cells.pop() # Backtrack\n\n        backtrack(0, 0, [])\n        return all_paths\n\n    def computeAverage(self, path: Path) -> float:\n        return path.average()\n\n    def selectMaxAverage(self, paths: list[Path]) -> Result:\n        max_average = -float('inf')\n        best_path = None\n\n        if not paths:\n            return Result(0.0, None)\n\n        for path in paths:\n            current_average = self.computeAverage(path)\n            if current_average > max_average:\n                max_average = current_average\n                best_path = path\n        \n        return Result(max_average, best_path)\ndef maxAverageOfPath(matrix: list[list[float]]) -> float:\n    \"\"\"\n    Finds the path with the maximum average cost from the top-left to the bottom-right\n    of a square matrix, moving only right or down.\n    \"\"\"\n    validator = Validator()\n    matrix_obj = validator.validate(matrix)\n\n    path_calculator = PathCalculator()\n    all_paths = path_calculator.computeAllPaths(matrix_obj)\n\n    result = path_calculator.selectMaxAverage(all_paths)\n\n    return result.maxAverage", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/808": [{"task_id": "Mbpp/808", "solution": "from typing import Tuple, Any\ndef check_K(t: Tuple[Any, ...], k: Any) -> bool:\n    \"\"\"Return True if k is an element of t, otherwise False.\n\n    This function checks for membership without modifying the input tuple.\n    \"\"\"\n    return k in t", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/780": [{"task_id": "Mbpp/780", "solution": "class TupleItem:\n    def __init__(self, index: int, a: int, b: int) -> None:\n        self.index = index\n        self.a = a\n        self.b = b\nclass TupleList:\n    def __init__(self, items: list[TupleItem]) -> None:\n        self.items = items\n\n    def get_item(self, index: int) -> TupleItem:\n        return self.items[index]\n\n    def __len__(self) -> int:\n        return len(self.items)\nclass SumTuple:\n    def __init__(self, sumA: int, sumB: int) -> None:\n        self.sumA = sumA\n        self.sumB = sumB\n\n    def as_tuple(self) -> tuple[int, int]:\n        return (self.sumA, self.sumB)\ndef _is_int_pair(obj) -> bool:\n    \"\"\"Returns True if obj is a tuple of length 2 and both elements are ints.\"\"\"\n    return