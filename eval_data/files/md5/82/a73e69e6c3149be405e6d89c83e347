y\nclass DivisibilityGraph:\n    \"\"\"Builds a divisibility poset/graph and computes the longest chain via DP.\"\"\"\n    def __init__(self) -> None:\n        self.nodes: List[Number] = []\n        # Adjacency list: adjacency[i] contains a list of indices j such that there's an edge i -> j\n        self.adjacency: Dict[int, List[int]] = {}\n\n    def buildGraph(self, nums: List[int]) -> None:\n        \"\"\"\n        Converts input integers to Number objects, sorts them, and builds\n        the directed graph based on divisibility relations.\n        \"\"\"\n        if not nums:\n            self.nodes = []\n            self.adjacency = {}\n            return\n\n        # Convert input ints to Number(value, original_index) to preserve duplicates (BR-01)\n        self.nodes = [Number(value, i) for i, value in enumerate(nums)]\n\n        # Sort nodes to facilitate DP (BR-05). Key: (is_zero, abs_value).\n        # This order places non-zero values before zeros, and then by absolute magnitude.\n        # Python's sort is stable, preserving original relative order for ties.\n        self.nodes.sort(key=lambda n: (1 if n.value == 0 else 0, abs(n.value)))\n\n        n = len(self.nodes)\n        # Initialize adjacency lists for all nodes\n        for i in range(n):\n            self.adjacency[i] = []\n\n        # Build adjacency list: add directed edge i -> j if nodes[i] divides nodes[j]\n        # and nodes[i] appears earlier in the sorted list than nodes[j].\n        for i in range(n):\n            for j in range(i + 1, n):\n                if DivisibilityRelation.divides(self.nodes[i], self.nodes[j]):\n                    self.adjacency[i].append(j)\n\n    def findLongestChain(self) -> int:\n        \"\"\"\n        Computes the length of the longest divisible chain (longest path) in the graph\n        using dynamic programming (BR-05).\n        \"\"\"\n        if not self.nodes:\n            return 0 # BR-02: Empty input list -> return 0\n\n        n = len(self.nodes)\n        dp = [1] * n  # dp[i] stores the length of the longest chain ending at nodes[i]\n\n        # Iterate through nodes in sorted order\n        for i in range(n):\n            # For each node_i, check all preceding nodes_j\n            for j in range(i):\n                # If there's a directed edge from nodes[j] to nodes[i]\n                if i in self.adjacency[j]:\n                    dp[i] = max(dp[i], dp[j] + 1)\n        \n        # The longest chain in the graph is the maximum value in the dp array\n        return max(dp)\nclass LargestSubsetService:\n    \"\"\"Orchestrates DivisibilityGraph to find the largest divisible subset.\"\"\"\n    def largest_subset(self, nums: List[int]) -> int:\n        \"\"\"\n        Finds the size of the largest subset of numbers where every pair is divisible.\n        \"\"\"\n        graph = DivisibilityGraph()\n        graph.buildGraph(nums)\n        return graph.findLongestChain()\ndef largest_subset(nums: List[int]) -> int:\n    \"\"\"\n    Finds the size of the largest subset of numbers where every pair is divisible.\n    \"\"\"\n    return LargestSubsetService().largest_subset(nums)", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[[9, 3, 12, 7, 16, 3, 11, 8, 4, 13, 13]]]}], "Mbpp/628": [{"task_id": "Mbpp/628", "solution": "class InputString:\n    \"\"\"Represents the input string for processing.\"\"\"\n    def __init__(self, content: str):\n        self.content = content\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the string content.\"\"\"\n        return len(self.content)\nclass OutputString:\n    \"\"\"Represents the output string being built.\"\"\"\n    def __init__(self):\n        self._buffer = []\n\n    @property\n    def content(self) -> str:\n        \"\"\"Returns the accumulated string content.\"\"\"\n        return \"\".join(self._buffer)\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the output string.\"\"\"\n        re