: Set[int]) -> int:\n        \"\"\"Internal recursive helper to determine the depth of a node, with cycle detection.\"\"\"\n        if not isinstance(node, dict):\n            return 0\n\n        node_id = id(node)\n        if node_id in visited:\n            raise ValueError(\"Cycle detected in dictionary graph\")\n\n        visited.add(node_id)\n\n        max_child_depth = 0\n        for value in node.values():\n            child_depth = self._depth_of(value, visited)\n            max_child_depth = max(max_child_depth, child_depth)\n\n        visited.remove(node_id)\n\n        return 1 + max_child_depth\ndef dict_depth(d: dict) -> int:\n    \"\"\"Public API: compute maximum nesting depth of dictionaries in d.\"\"\"\n    if not isinstance(d, dict):\n        raise TypeError(\"dict_depth expects a dict\")\n\n    calculator = DepthCalculator()\n    return calculator.dict_depth(d)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/309": [{"task_id": "Mbpp/309", "solution": "def compare(a, b):\n    \"\"\"Return a if a >= b else return b. Equality returns a.\"\"\"\n    if a >= b:\n        return a\n    else:\n        return b\ndef maximum(a, b):\n    \"\"\"Public API: validate inputs and return the larger numeric value.\"\"\"\n    validateTypes(a, b)\n    return compare(a, b)", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[5, 10]], "plus_fail_tests": [[3.14, 10.65]]}], "Mbpp/306": [{"task_id": "Mbpp/306", "solution": "class Error(Exception):\n    \"\"\"\n    Deterministic error signaling implemented as an Exception subclass with code and message.\n    \"\"\"\n    def __init__(self, code: str, message: str) -> None:\n        super().__init__(message)\n        self.code = code\n        self.message = message\nclass ArrayInput:\n    \"\"\"\n    Stores array and related indices, and validates array length.\n    \"\"\"\n    def __init__(self, arr: list[int], n: int, i: int, k: int) -> None:\n        self.arr = arr\n        self.n = n\n        self.i = i\n        self.k = k\n\n    def validateLengths(self) -> bool:\n        \"\"\"Checks if the provided length n matches the actual length of the array.\"\"\"\n        return self.n == len(self.arr)\nclass IndexValidator:\n    \"\"\"\n    Validates array indices for bounds and ordering.\n    \"\"\"\n    def validateIndices(self, i: int, k: int, n: int) -> None:\n        \"\"\"\n        Validates that indices i and k are within bounds and that k is greater than i.\n        Raises Error if validation fails.\n        \"\"\"\n        if not (0 <= i < n) or not (0 <= k < n):\n            raise Error(\"INVALID_INDEX\", \"index out of range\")\n        if not (k > i):\n            raise Error(\"INVALID_INDEX\", \"k must be > i\")\nclass SubsequenceCalculator:\n    \"\"\"\n    Calculates the maximum sum of an increasing subsequence given prefix constraints and a required last element.\n    \"\"\"\n    def computeMaxSum(self, arr: list[int], i: int, k: int) -> int:\n        \"\"\"\n        Computes the maximum sum of a strictly increasing subsequence ending at arr[k],\n        using zero or more elements from arr[0..i].\n        \"\"\"\n        # Step 1: Compute dp[j] for prefix 0..i\n        dp = [0] * (i + 1)\n        for j in range(i + 1):\n            dp[j] = arr[j] # Initialize with the element itself\n            for t in range(j):\n                if arr[t] < arr[j]:\n                    dp[j] = max(dp[j], dp[t] + arr[j])\n\n        # Step 2: Determine best_prefix_sum\n        best_prefix_sum = 0\n        for j in range(i + 1):\n            if arr[j] < arr[k]:\n                best_prefix_sum = max(best_prefix_sum, dp[j])\n\n        # Step 3: Return best_prefix_sum + arr[k]\n        return best_prefix_sum + arr[k]\ndef max_sum_increasing_subseq(arr, n, i, k):\n    \"\"\"\n    Finds the maximum sum of an increasing subsequence from prefix until ith index\n    and also including a given kth element which is after i.\n    \"\