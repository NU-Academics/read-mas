illResult:\n    \"\"\"\n    Data model for wind chill calculation results.\n    \"\"\"\n    def __init__(self, value: int, raw_value: float, computed_at: datetime = None):\n        self.value = value\n        self.raw_value = raw_value\n        self.computed_at = computed_at if computed_at else datetime.now()\nclass InputValidator:\n    \"\"\"\n    Validates numeric inputs and non-negative velocity.\n    \"\"\"\n    def validateNumeric(self, value) -> bool:\n        \"\"\"Returns True if value is numeric (int or float) and finite.\"\"\"\n        return isinstance(value, (int, float)) and math.isfinite(value)\n\n    def validateNonNegativeVelocity(self, value) -> bool:\n        \"\"\"Returns True if value is numeric and non-negative.\"\"\"\n        return self.validateNumeric(value) and value >= 0\nclass WindChillCalculator:\n    \"\"\"\n    Performs wind chill computation, orchestrates validation, rounding,\n    and handles error logging.\n    \"\"\"\n    def __init__(self):\n        self._validator = InputValidator()\n        self._error_log_entries = []\n\n    def _calculateRaw(self, velocity_kmh: float, temperature_celsius: float) -> float:\n        \"\"\"\n        Computes the raw wind chill using the meteorological formula.\n        \"\"\"\n        v = velocity_kmh\n        T = temperature_celsius\n        # Formula: 13.12 + 0.6215*T - 11.37*v**0.16 + 0.3965*T*v**0.16\n        return 13.12 + 0.6215 * T - 11.37 * (v**0.16) + 0.3965 * T * (v**0.16)\n\n    def compute(self, velocity_kmh, temperature_celsius) -> int:\n        \"\"\"\n        Validates inputs, calculates raw wind chill, rounds it,\n        and logs unexpected errors.\n        \"\"\"\n        if not self._validator.validateNumeric(velocity_kmh):\n            raise TypeError(\"Velocity must be a numeric value.\")\n        if not self._validator.validateNumeric(temperature_celsius):\n            raise TypeError(\"Temperature must be a numeric value.\")\n\n        if not self._validator.validateNonNegativeVelocity(velocity_kmh):\n            raise ValueError(\"Velocity must be a non-negative value.\")\n\n        try:\n            raw_value = self._calculateRaw(float(velocity_kmh), float(temperature_celsius))\n            # The assert example wind_chill(120,35)==40 implies floor for 40.58721,\n            # despite \"rounded to the next integer\" often meaning ceiling or standard rounding.\n            int_value = math.floor(raw_value)\n\n            # Construct WindChillResult as per design, though not returned by compute\n            WindChillResult(value=int_value, raw_value=raw_value, computed_at=datetime.now())\n            return int_value\n        except Exception as e:\n            error_log_entry = ErrorLog(\n                error_type=type(e).__name__,\n                message=str(e),\n                timestamp=datetime.now()\n            )\n            self._error_log_entries.append(error_log_entry)\n            raise\ndef wind_chill(velocity_kmh, temperature_celsius) -> int:\n    \"\"\"\n    Calculates the wind chill index rounded to the next integer given the wind\n    velocity in km/h and a temperature in celsius.\n    \"\"\"\n    calculator = WindChillCalculator()\n    return calculator.compute(velocity_kmh, temperature_celsius)", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[500, -50]]}], "Mbpp/641": [{"task_id": "Mbpp/641", "solution": "def is_nonagonal(n: int) -> int:\n    \"\"\"\n    Calculates the nth nonagonal number using the formula n * (7*n - 5) // 2.\n    Input validation (n must be integer and >= 1) is omitted as per specific instruction.\n    \"\"\"\n    return n * (7 * n - 5) // 2", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/630": [{"task_id": "Mbpp/630", "solution": "from typing import Tuple, List\ndef get_coordinates(coord: Tuple[int, int]) -> List[List[int]]:\n    \"\"\"\n    Extracts all adjacent coordinates (including itself) for a g