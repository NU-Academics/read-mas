 average\n\n    def as_tuple(self) -> tuple[int, float]:\n        return (self.sum, self.average)\ndef sum_average(n):\n    \"\"\"\n    Calculates the sum and average of the first n natural numbers.\n    Raises ValueError for invalid input n.\n    \"\"\"\n    if not InputValidator.validate(n):\n        raise ValueError(f\"Invalid input n: {n}; expected integer >= 1\")\n    \n    s = Calculator.compute_sum(n)\n    a = Calculator.compute_average(s, n)\n    result = ComputationResult(s, a)\n    return result.as_tuple()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/602": [{"task_id": "Mbpp/602", "solution": "from collections import Counter\ndef first_repeated_char(input_string):\n    \"\"\"\n    Returns the earliest character in input_string that repeats later.\n    If no character repeats, returns None; raises TypeError if input_string is not a string.\n    \"\"\"\n    if not isinstance(input_string, str):\n        raise TypeError(\"Input must be a string.\")\n\n    char_counts = Counter(input_string) # Efficiently counts all characters in one pass\n\n    for char in input_string:\n        if char_counts[char] > 1:\n            return char\n\n    return None", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [["abcdefgxhinjklmnopqrstuvwxyz"]]}], "Mbpp/604": [{"task_id": "Mbpp/604", "solution": "from typing import List\nclass InputString:\n    \"\"\"Lightweight holder for the input value for traceability.\"\"\"\n    def __init__(self, value: str) -> None:\n        self.value = value\nclass WordToken:\n    \"\"\"Lightweight token container holding token text and original index for traceability.\"\"\"\n    def __init__(self, value: str, position: int) -> None:\n        self.value = value\n        self.position = position\nclass OutputString:\n    \"\"\"Lightweight container for the final returned string for traceability.\"\"\"\n    def __init__(self, value: str) -> None:\n        self.value = value\ndef reverse_words(input_string: str) -> str:\n    \"\"\"\n    Reverses the order of words in a string, tokenized by spaces.\n    Consecutive, leading, and trailing spaces are collapsed.\n    \"\"\"\n    _ = InputString(value=input_string) # Wrap input for traceability\n\n    raw_tokens = input_string.split(' ')\n    filtered_tokens_str_list = [t for t in raw_tokens if t != '']\n\n    word_token_objects: List[WordToken] = [WordToken(value=word, position=i) for i, word in enumerate(filtered_tokens_str_list)]\n\n    reversed_word_token_objects = list(reversed(word_token_objects))\n\n    reversed_token_values = [wt.value for wt in reversed_word_token_objects]\n    result_string = ' '.join(reversed_token_values)\n\n    output_obj = OutputString(value=result_string) # Wrap output for traceability\n    return output_obj.value", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/605": [{"task_id": "Mbpp/605", "solution": "from dataclasses import dataclass\nimport math\ndef prime_num(n: int) -> bool:\n    \"\"\"Return True if integer n is prime, False otherwise.\"\"\"\n    if n < 2:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n\n    # Check for divisibility from 3 up to sqrt(n) by odd numbers\n    for i in range(3, int(math.sqrt(n)) + 1, 2):\n        if n % i == 0:\n            return False\n    return True", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/606": [{"task_id": "Mbpp/606", "solution": "import math\ndef radian_degree(degrees: float) -> float:\n    \"\"\"Convert degrees to radians.\n\n    Args:\n        degrees (float): angle in degrees (numeric)\n    Returns:\n        float: angle in radians computed as degrees * math.pi / 180\n    \"\"\"\n    return degrees * math.pi / 180", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/608": [{"task_id": "Mbpp/608", "solution": "class _InputValidator:\n    \"\"\"Centralizes input validation logic for n.\"\"\"\n    def is_non_negative_int(self, n) -> bool:\n        \"\"\"Returns True if n is an integer and non-negative.\"\"\"\n        return isinstance(n, int) and n >= 0\n\n    def raise_on_invalid(self, n) -> None:\n        \"\"\"Raises TypeError for non-integers or ValueError for negative integers.\"\"\"\n        if not isinstance(n, int):\n            raise TypeError(\"Input 'n' must be an integer.\")\n        if n < 0:\n            raise ValueError(\"Input 'n' must be a non-negative integer.\")\nclass _BellCalculator:\n    \"\"\"Computes nth Bell number exactly using integer arithmetic via Bell triangle.\"\"\"\n    def bell_Number(self, n: int) -> int:\n        \"\"\"Computes and returns the nth Bell number.\"\"\"\n        if n == 0:\n            return 1\n        \n        triangle = self._compute_bell_triangle(n)\n        # The nth Bell number is the first element of the nth row (0-indexed)\n        return triangle[n][0]\n\n    def _compute_bell_triangle(self, n: int) -> list:\n        \"\"\"Computes Bell triangle rows up to index n.\"\"\"\n        # The Bell triangle is a list of lists.\n        # triangle[i][0] will be the i-th Bell number (B_i).\n        \n        triangle = [[1]] # B0 = 1\n\n        for i in range(1, n + 1):\n            prev_row = triangle[i-1]\n            current_row = [prev_row[-1]] # First element of new row is last of previous row\n            \n            for j in range(1, i + 1):\n                # Subsequent elements sum the element above (prev_row[j-1])\n                # and the element to its left in the current row (current_row[j-1]).\n                current_row.append(prev_row[j-1] + current_row[j-1])\n            triangle.append(current_row)\n        \n        return triangle\ndef bell_Number(n) -> int:\n    \"\"\"\n    Finds the nth Bell number.\n    It validates input and computes the Bell number using the Bell triangle method.\n    \"\"\"\n    validator = _InputValidator()\n    validator.raise_on_invalid(n)\n\n    calculator = _BellCalculator()\n    return calculator.bell_Number(n)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/607": [{"task_id": "Mbpp/607", "solution": "import re\ndef find_literals(input_string: str, pattern: str) -> tuple[str, int, int] | None:\n    \"\"\"\n    Searches an input string for a regex pattern using Python's `re` module.\n    Returns (matched_substring, start_index, end_index) where start_index is zero-based and end_index is exclusive.\n    Returns None when no match is found. Raises re.error for invalid regex patterns.\n    \"\"\"\n    match = re.search(pattern, input_string)\n    if match:\n        return (match.group(0), match.start(0), match.end(0))\n    return None", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/611": [{"task_id": "Mbpp/611", "solution": "from typing import List\nclass Matrix:\n    \"\"\"\n    Wraps a list-of-lists matrix and provides column extraction functionality.\n    \"\"\"\n    def __init__(self, rows: List[List[int]]) -> None:\n        self._rows = rows\n\n    def get_column(self, n: int) -> List[int]:\n        \"\"\"\n        Returns values at the zero-based column index n across rows that have an element at that index.\n        \"\"\"\n        column_values = []\n        for row in self._rows:\n            if len(row) > n:\n                column_values.append(row[n])\n        return column_values\nclass Column:\n    \"\"\"\n    A simple container representing an extracted column with its index and values.\n    \"\"\"\n    def __init__(self, index: int, values: List[int]) -> None:\n        self.index = index\n        self.values = values\ndef max_of_nth(matrix: List[List[int]], n: int) -> int:\n    \"\"\"\n    Computes and returns the maximum integer value in the n-th column of the provided matrix.\n    \"