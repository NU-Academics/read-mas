)\n\n    def _compute_min_max_difference(seq):\n        \"\"\"Computes the difference between the maximum and minimum elements in a single pass.\"\"\"\n        min_val = seq[0]\n        max_val = seq[0]\n        for i in range(1, len(seq)):\n            if seq[i] < min_val:\n                min_val = seq[i]\n            if seq[i] > max_val:\n                max_val = seq[i]\n        return max_val - min_val\n\n    _validate_sequence_type(sequence)\n    _validate_elements_numeric(sequence)\n\n    if len(sequence) < 2:\n        raise ValueError(\"Sequence must contain at least two elements.\")\n\n    return _compute_min_max_difference(sequence)", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[[1]]]}], "Mbpp/139": [{"task_id": "Mbpp/139", "solution": "import math\nPI = math.pi\ndef circle_circumference(radius):\n    \"\"\"Calculates the circumference of a circle using the formula 2 * pi * radius.\n    Returns the result as a float.\"\"\"\n    result = 2 * PI * radius\n    return float(result)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/141": [{"task_id": "Mbpp/141", "solution": "def pancake_sort(lst):\n    \"\"\"\n    Sorts a list of elements in ascending order.\n    Returns a new sorted list.\n    \"\"\"\n    return sorted(lst)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/140": [{"task_id": "Mbpp/140", "solution": "from typing import Iterable, Any\ndef extract_singly(iterable_of_iterables: Iterable[Iterable[Any]]) -> set:\n    \"\"\"\n    Flattens an iterable of iterables into a single set of unique elements.\n    \"\"\"\n    result = set()\n    for inner in iterable_of_iterables:\n        for elem in inner:\n            result.add(elem)\n    return result", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/142": [{"task_id": "Mbpp/142", "solution": "from typing import Any, List\nclass CountSamePairFunction:\n    \"\"\"Encapsulates the algorithm for counting identical items in the same position.\"\"\"\n\n    def execute(self, list1: List[Any], list2: List[Any], list3: List[Any]) -> int:\n        \"\"\"Computes the number of positions where elements are identical across three lists.\"\"\"\n        match_count = 0\n        min_length = self.computeMinLength(list1, list2, list3)\n\n        for i in range(min_length):\n            v1 = list1[i]\n            v2 = list2[i]\n            v3 = list3[i]\n            if self.elementsEqual(v1, v2, v3):\n                match_count += 1\n        return match_count\n\n    def computeMinLength(self, list1: List[Any], list2: List[Any], list3: List[Any]) -> int:\n        \"\"\"Returns the minimum length among the three given lists.\"\"\"\n        return min(len(list1), len(list2), len(list3))\n\n    def elementsEqual(self, e1: Any, e2: Any, e3: Any) -> bool:\n        \"\"\"Returns True if all three elements are equal using language equality semantics.\"\"\"\n        return e1 == e2 and e2 == e3\ndef count_samepair(list1: List[Any], list2: List[Any], list3: List[Any]) -> int:\n    \"\"\"\n    Counts the number of items that are identical in the same position of three given lists.\n    The comparison is based on the minimum length of the three lists.\n    \"\"\"\n    processor = CountSamePairFunction()\n    return processor.execute(list1, list2, list3)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/161": [{"task_id": "Mbpp/161", "solution": "from typing import Iterable, Any, List\ndef remove_elements(source_list: Iterable[Any], remove_list: Iterable[Any]) -> List[Any]:\n    \"\"\"\n    Return a new list containing only elements from source_list that are not present in remove_list.\n    All occurrences of elements appearing in remove_list are removed, preserving relative order.\n    \"\"\"\n    try:\n        # Attempt to create a set for faster O(1) average time complexity membership checks.\n        elements_to_remove_container = set(remove_list)\n    except TypeError:\n        # Fallback to O(N) linear time complexity membership checks if elements are unhashable.\n        elements_to_remove_container = remove_list\n\n    result_list: List[Any] = []\n    for item in source_list:\n        if item not in elements_to_remove_container:\n            result_list.append(item)\n\n    return result_list", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[[94.69906992408676, 5, 5, false, [4.5, [31, -44, 5, 56, 0, 12, 75], true, null], true, 12, 7], []]]}], "Mbpp/162": [{"task_id": "Mbpp/162", "solution": "from dataclasses import dataclass\nfrom typing import List\ndef compute_terms(n: int) -> List[SeriesTerm]:\n    \"\"\"\n    Generates a list of SeriesTerm objects for the given n.\n    Each term is (i, n - 2*i) for i from 0 to n // 2.\n    \"\"\"\n    terms = []\n    for i in range(n // 2 + 1):\n        value = n - 2 * i\n        terms.append(SeriesTerm(i, value))\n    return terms\ndef sum_series(n: int) -> int:\n    \"\"\"\n    Calculates the sum of terms (n - 2*i) for i from 0 to n // 2.\n    It utilizes compute_terms to generate the series terms.\n    \"\"\"\n    terms = compute_terms(n)\n    return sum(term.value for term in terms)", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/160": [{"task_id": "Mbpp/160", "solution": "from typing import Optional, Tuple\ndef gcd(a: int, b: int) -> int:\n    \"\"\"\n    Computes the greatest common divisor of two integers.\n    \"\"\"\n    while b:\n        a, b = b, a % b\n    return abs(a)\ndef extended_gcd(a: int, b: int) -> Tuple[int, int, int]:\n    \"\"\"\n    Computes g, x, y such that ax + by = g = gcd(a, b).\n    \"\"\"\n    r0, r1 = a, b\n    x0, x1 = 1, 0\n    y0, y1 = 0, 1\n\n    while r1 != 0:\n        q = r0 // r1\n        r0, r1 = r1, r0 - q * r1\n        x0, x1 = x1, x0 - q * x1\n        y0, y1 = y1, y0 - q * y1\n    \n    # Ensure g (r0) is non-negative, and adjust coefficients accordingly.\n    if r0 < 0:\n        r0 = -r0\n        x0 = -x0\n        y0 = -y0\n            \n    return (r0, x0, y0)\ndef find_solution(a: int, b: int, n: int) -> Optional[Tuple[int, int]]:\n    \"\"\"\n    Returns integers x and y that satisfy ax + by = n as a tuple,\n    or None if no solution exists.\n    \"\"\"\n    if a == 0 and b == 0:\n        return (0, 0) if n == 0 else None\n\n    common_divisor = gcd(a, b)\n\n    if n % common_divisor != 0:\n        return None  # No integer solution\n\n    # Get a particular solution for ax0_base + by0_base = common_divisor\n    g, x0_base, y0_base = extended_gcd(a, b)\n\n    # Scale the base solution to ax_particular + by_particular = n\n    scale_factor = n // g\n    x_particular = x0_base * scale_factor\n    y_particular = y0_base * scale_factor\n\n    # Adjust the particular solution to a canonical form (e.g., for the example (2,3,7) -> (2,1))\n    # The general solution is (x_particular + k * (b/g), y_particular - k * (a/g))\n    \n    if b != 0:\n        # Calculate b_prime = b / g, which is the coefficient for k in x's equation\n        b_prime = b // g\n        \n        # Calculate the offset 'k' to bring x into a more canonical range\n        # For example, to make x as small non-negative as possible, or matching the desired output\n        k_offset = x_particular // b_prime\n        \n        x_final = x_particular - k_offset * b_prime\n        y_final = y_particular + k_offset * (a // g)\n        \n        return (x_final, y_final)\n    elif a != 0: # This branch covers cases where b == 0 and a != 0\n        # For ax = n, y can be 0 (or any integer). extended_gcd(a,0) returns (abs(a), +/-1, 0)\n        # So x_particular becomes (n/g) * (+/-1) = n/a, and y_particular = 0.\n        # This is already a canonical solution.\n        return (x_particular, y_particular)\n    \n    # This point should theoretically not be reached due to initial (a==0, b==0) check\n    # and subsequent if/elif branches for (b!=0) or (a!=0 and b==0).\n    return None", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[25, 123, 7]]}], "Mbpp/168": [{"task_id": "Mbpp/168", "solution": "def frequency(list, value) -> int:\n    \"\"\"Counts the number of occurrences of a value in a given list.\n    Returns an integer representing the count.\"\"\"\n    return list.count(value)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/166": [{"task_id": "Mbpp/166", "solution": "from typing import List\ndef _comb2(n: int) -> int:\n    \"\"\"Calculates n choose 2, returning 0 if n is less than 2.\"\"\"\n    if n < 2:\n        return 0\n    return n * (n - 1) // 2\ndef find_even_pair(nums: List[int]) -> int:\n    \"\"\"\n    Counts the number of pairs of integers in a list that xor to an even number.\n    This is equivalent to counting pairs of integers with the same parity.\n    \"\"\"\n    if len(nums) < 2:\n        return 0\n\n    evens_count = 0\n    odds_count = 0\n\n    for num in nums:\n        if num % 2 == 0:\n            evens_count += 1\n        else:\n            odds_count += 1\n\n    # Pairs with even XOR are formed by two even numbers or two odd numbers.\n    # Count pairs of even numbers: C(evens_count, 2)\n    # Count pairs of odd numbers: C(odds_count, 2)\n    return _comb2(evens_count) + _comb2(odds_count)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/165": [{"task_id": "Mbpp/165", "solution": "from typing import List, Iterator\nclass InputString:\n    def __init__(self, value: str) -> None:\n        self.value = value\n\n    def length(self) -> int:\n        return len(self.value)\n\n    def iter_positions(self) -> Iterator['CharacterPosition']:\n        \"\"\"Iterates over the input string, yielding CharacterPosition objects 