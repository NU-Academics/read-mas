 "from typing import List, Any\ndef is_majority(arr: List[Any], n: int, x: Any) -> bool:\n    \"\"\"\n    Checks if an element x is the majority element in a sorted array arr of length n.\n    A majority element occurs more than n/2 times.\n    \"\"\"\n\n    class MajorityChecker:\n        \"\"\"\n        Encapsulates the core logic for determining if an element is a majority element.\n        \"\"\"\n\n        def _binary_search_first(self, arr: List[Any], n: int, x: Any) -> int:\n            \"\"\"Finds the index of the first occurrence of x in arr[0...n-1] using binary search.\"\"\"\n            low, high = 0, n - 1\n            result = -1\n            while low <= high:\n                mid = low + (high - low) // 2\n                if arr[mid] == x:\n                    result = mid\n                    high = mid - 1  # Try to find an even earlier occurrence\n                elif arr[mid] < x:\n                    low = mid + 1\n                else:  # arr[mid] > x\n                    high = mid - 1\n            return result\n\n        def _binary_search_last(self, arr: List[Any], n: int, x: Any) -> int:\n            \"\"\"Finds the index of the last occurrence of x in arr[0...n-1] using binary search.\"\"\"\n            low, high = 0, n - 1\n            result = -1\n            while low <= high:\n                mid = low + (high - low) // 2\n                if arr[mid] == x:\n                    result = mid\n                    low = mid + 1  # Try to find an even later occurrence\n                elif arr[mid] < x:\n                    low = mid + 1\n                else:  # arr[mid] > x\n                    high = mid - 1\n            return result\n\n        def _countOccurrences(self, arr: List[Any], n: int, x: Any) -> int:\n            \"\"\"Counts occurrences of x in arr by finding its first and last indices.\"\"\"\n            if n == 0:\n                return 0\n\n            first_idx = self._binary_search_first(arr, n, x)\n            if first_idx == -1:  # Element x is not present in the array\n                return 0\n\n            last_idx = self._binary_search_last(arr, n, x)\n            return last_idx - first_idx + 1\n\n        def is_majority(self, arr: List[Any], n: int, x: Any) -> bool:\n            \"\"\"Determines if x is the majority element in the sorted array arr of length n.\"\"\"\n            if n == 0:\n                return False\n\n            count = self._countOccurrences(arr, n, x)\n            return count > n / 2\n\n    # The module-level function delegates to an instance of MajorityChecker\n    return MajorityChecker().is_majority(arr, n, x)", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[[], 1, 0]]}], "Mbpp/234": [{"task_id": "Mbpp/234", "solution": "def volume_cube(side_length):\n    \"\"\"\n    Calculates the volume of a cube given its side length.\n    \"\"\"\n    return side_length ** 3", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/230": [{"task_id": "Mbpp/230", "solution": "def replace_blank(input_string, character):\n    \"\"\"\n    Replaces all occurrences of a blank space (' ') in the string with the specified character.\n    Returns the modified string.\n    \"\"\"\n    return input_string.replace(' ', character)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/238": [{"task_id": "Mbpp/238", "solution": "def number_of_substrings(s: str) -> int:\n    \"\"\"Return count of all non-empty substrings of s.\"\"\"\n    n = len(s)\n    return n * (n + 1) // 2", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/233": [{"task_id": "Mbpp/233", "solution": "import math\ndef lateralsuface_cylinder(radius, height) -> float:\n    \"\"\"Compute lateral surface area = 2 * math.pi * radius * height.\n\n    Raises TypeError if radius or height are not int/float.\n    \"\"\"\n    if no