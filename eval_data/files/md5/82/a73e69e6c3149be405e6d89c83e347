h, 'comb'):\n            return math.comb(n, k)\n        else:\n            # Fallback for Python versions < 3.8\n            if k == 0 or k == n:\n                return 1\n            if k > n // 2:\n                k = n - k\n            \n            res = 1\n            for i in range(k):\n                res = res * (n - i) // (i + 1)\n            return res\nclass Result:\n    \"\"\"\n    A simple container to hold an integer result.\n    \"\"\"\n    def __init__(self, value: int) -> None:\n        \"\"\"Initializes the Result with the given integer value.\"\"\"\n        self.value = value\ndef even_binomial_Coeff_Sum(n: int) -> int:\n    \"\"\"\n    Calculates the sum of binomial coefficients C(n, k) for even k, where 0 <= k <= n.\n    Validates n to be a positive integer and raises ValueError if invalid.\n    \"\"\"\n    validator = Validator()\n    validator.validate_positive_integer(n)\n\n    bc = BinomialCoefficient()\n    total = 0\n    for k in range(0, n + 1, 2):\n        total += bc.compute(n, k)\n    \n    return Result(total).value", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/280": [{"task_id": "Mbpp/280", "solution": "def sequential_search(array, element) -> tuple[bool, int]:\n    \"\"\"\n    Performs a sequential (linear) search for an element in an array.\n    Returns a tuple (found, index) where 'found' is a boolean and 'index' is the\n    zero-based index of the first occurrence, or -1 if not found.\n    \"\"\"\n    for i in range(len(array)):\n        if array[i] == element:\n            return (True, i)\n    return (False, -1)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/287": [{"task_id": "Mbpp/287", "solution": "def square_Sum(n):\n    \"\"\"\n    Calculates the sum of squares of the first n even natural numbers.\n    \"\"\"\n\n    def validate_input(val):\n        \"\"\"Ensures the input is a non-negative integer, raising erro