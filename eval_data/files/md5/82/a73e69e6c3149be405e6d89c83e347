validation\n            return \"\"\n        return s_val[-1] + s_val[:-1]\n\n    def count_odd_rotations(self, s: str, k: int) -> int:\n        \"\"\"Perform exactly k evaluations and return count.\"\"\"\n        self.validate_inputs(s, k)\n\n        if k == 0:\n            return 0\n\n        odd_count = 0\n        current_s = s # Start with the original string (rotation 0)\n\n        for _ in range(k):\n            # Check if the current rotation is odd\n            if current_s[-1] == '1':\n                odd_count += 1\n            \n            # Prepare the string for the next rotation\n            current_s = self._rotate_string_once(current_s)\n\n        return odd_count\ndef odd_Equivalent(s: str, k: int) -> int:\n    \"\"\"\n    Find the number of numbers with an odd value when rotating a binary string \n    the given number of times.\n    Raises ValueError for invalid inputs (s is empty/non-binary or k is negative/non-integer).\n    \"\"\"\n    calculator = OddEquivalentFunction()\n    return calculator.count_odd_rotations(s, k)", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [["10000100110011", 5]]}], "Mbpp/106": [{"task_id": "Mbpp/106", "solution": "def add_lists(input_list: list, input_tuple: tuple) -> tuple:\n    \"\"\"Validate inputs and return a tuple containing input_tuple elements followed by input_list elements.\"\"\"\n    if not isinstance(input_list, list):\n        raise TypeError(\"first parameter must be a list\")\n    if not isinstance(input_tuple, tuple):\n        raise TypeError(\"second parameter must be a tuple\")\n    return tuple(input_tuple) + tuple(input_list)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/103": [{"task_id": "Mbpp/103", "solution": "import math\nfrom typing import Dict, Optional, Tuple\nclass ValidationError(Exception):\n    \"\"\"\n    Exception raised for invalid input parameters to the Eulerian number function.\n    \"\"\"\n    def __init__(self, message: str) -> None:\n        self.message = message\n        super().__init__(self.message)\nclass Cache:\n    \"\"\"\n    A simple in-memory cache for Eulerian numbers (n, m) -> value.\n    \"\"\"\n    def __init__(self) -> None:\n        self._memo: Dict[Tuple[int, int], int] = {}\n\n    def get(self, n: int, m: int) -> Optional[int]:\n        \"\"\"Retrieves a cached value for (n, m), or None if not found.\"\"\"\n        return self._memo.get((n, m))\n\n    def put(self, n: int, m: int, value: int) -> None:\n        \"\"\"Stores a value for (n, m) in the cache.\"\"\"\n        self._memo[(n, m)] = value\nclass EulerianFunction:\n    \"\"\"\n    Encapsulates validation and computation logic for Eulerian numbers.\n    Uses dynamic programming with optional caching.\n    \"\"\"\n    def __init__(self, cache: Optional[Cache] = None) -> None:\n        self._cache = cache\n\n    def validateInputs(self, n: int, m: int) -> None:\n        \"\"\"\n        Validates if n and m are integers and within valid ranges.\n        Raises ValidationError if inputs are invalid.\n        \"\"\"\n        if not isinstance(n, int):\n            raise ValidationError(f\"Invalid type for n: expected int, got {type(n).__name__}\")\n        if not isinstance(m, int):\n            raise ValidationError(f\"Invalid type for m: expected int, got {type(m).__name__}\")\n\n        if n < 0:\n            raise ValidationError(f\"Invalid value for n: expected n >= 0, got {n}\")\n        if m < 0:\n            raise ValidationError(f\"Invalid value for m: expected m >= 0, got {m}\")\n        if m >= n:\n            raise ValidationError(f\"Invalid value for m: expected m < n, got n={n}, m={m}\")\n\n    def compute(self, n: int, m: int) -> int:\n        \"\"\"\n        Computes the Eulerian number a(n, m) after validating inputs.\n        Uses cache if available.\n        \"\"\"\n        self.validateInputs(n, m)\n\n        if self._cache:\n            cached_value = self._cache.get(n, m)\n            if cached_value is not None:\n                return cached_value\n\n        result = self.computeWithDP(n, m)\n\n        if self._cache:\n            self._cache.put(n, m, result)\n\n        return result\n\n    def computeWithDP(self, n: int, m: int) -> int:\n        \"\"\"\n        Computes the Eulerian number a(n, m) using dynamic programming.\n        Assumes inputs are already validated: n >= 0 and 0 <= m < n.\n        \"\"\"\n        # dp[i][j] stores a(i, j) for i from 0 to n and j from 0 to i-1.\n        # The table size is (n+1) x (n+1) for simpler indexing (j up to n-1).\n        dp = [[0] * (n + 1) for _ in range(n + 1)]\n\n        # Base case: a(i, 0) = 1 for i >= 0.\n        for i in range(n + 1):\n            dp[i][0] = 1\n\n        # Fill the DP table using the recurrence relation.\n        # a(i, j) = (j + 1) * a(i - 1, j) + (i - j) * a(i - 1, j - 1)\n        for i in range(1, n + 1): # For current 'n' from 1 up to the target 'n'\n            for j in range(1, i): # For current 'm' from 1 up to 'i-1'\n                dp[i][j] = (j + 1) * dp[i-1][j] + (i - j) * dp[i-1][j-1]\n        \n        return dp[n][m]\n_global_eulerian_cache = Cache()\ndef eulerian_num(n: int, m: int) -> int:\n    \"\"\"\n    Calculates the Eulerian number A(n, m), representing the number of permutations\n    of {1, ..., n} with m ascents.\n    \"\"\"\n    eulerian_calculator = EulerianFunction(cache=_global_eulerian_cache)\n    return eulerian_calculator.compute(n, m)", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[0, 0]]}], "Mbpp/116": [{"task_id": "Mbpp/116", "solution": "class Element:\n    \"\"\"Represents a single element of the input tuple, validating its type and value.\"\"\"\n    def __init__(self, value: int, position: int) -> None:\n        self.value = value\n        self.position = position\n\n    def is_valid(self) -> bool:\n        \"\"\"Checks if the element is a positive integer.\"\"\"\n        return isinstance(self.value, int) and self.value >= 1\nclass TupleInput:\n    \"\"\"Represents and validates the entire input tuple.\"\"\"\n    def __init__(self, elements: tuple) -> None:\n        self.elements = elements\n\n    def validate(self) -> None:\n        \"\"\"Validates that the input is a tuple of positive integers.\"\"\"\n        if not isinstance(self.elements, tuple):\n            raise TypeError(\"input must be a tuple\")\n        \n        for i, val in enumerate(self.elements):\n            element = Element(val, i)\n            if not element.is_valid():\n                raise ValueError(\"tuple elements must be positive integers\")\nclass ResultInteger:\n    \"\"\"Holds the final concatenated integer value.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\ndef tuple_to_int(input_tuple: tuple) -> int:\n    \"\"\"\n    Converts a tuple of positive integers into a single integer by concatenation.\n    Validates input type and element values, then joins their string representations.\n    \"\"\"\n    ti = TupleInput(input_tuple)\n    ti.validate()\n\n    parts = [str(e) for e in input_tuple]\n    concatenated = ''.join(parts)\n    \n    result = ResultInteger(int(concatenated))\n    return result.value", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/111": [{"task_id": "Mbpp/111", "solution": "import collections\nfrom typing import Any, Set\ndef common_in_nested_lists(iterable_of_sublists: collections.abc.Iterable) -> Set[Any]:\n    \"\"\"Finds common elements in given nested lists using hash-based set operations.\n\n    Elements should be equality-comparable and hashable for optimal performance.\n    \"\"\"\n    if not isinstance(iterable_of_sublists, collections.abc.Iterable):\n        raise TypeError(\"Top-level argument must be an iterable of iterables\")\n\n    sublist_iterator = iter(iterable_of_sublists)\n\n    try:\n        first_sublist = next(s