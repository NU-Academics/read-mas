nt) -> int:\n        \"\"\"Computes the sum of each digit raised to the power of the number of digits.\"\"\"\n        num_obj = Number(n)\n        digit_count = num_obj.digit_count()\n        digits = num_obj.digits()\n\n        total_sum = 0\n        for i, digit_value in enumerate(digits):\n            digit_obj = Digit(i, digit_value, digit_count)\n            total_sum += digit_obj.power_value\n        return total_sum\n\n    def last_computed_sum(self) -> Optional[int]:\n        \"\"\"Accessor for the last computed sum, for inspection/testing.\"\"\"\n        return self._last_computed_sum\ndef armstrong_number(n: int) -> bool:\n    \"\"\"\n    Checks whether the given number is an Armstrong number.\n    An Armstrong number is one whose sum of digits raised to the power of the number of digits equals the number itself.\n    \"\"\"\n    checker = ArmstrongChecker()\n    return checker.armstrong_number(n)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/597": [{"task_id": "Mbpp/597", "solution": "from typing import List\ndef find_kth(arr1: List[int], arr2: List[int], k: int) -> int:\n    \"\"\"\n    Finds the k-th smallest element from two given sorted arrays using a merge-scan algorithm.\n    Assumes inputs are valid: arrays are sorted lists of integers, k is an integer\n    within the valid range [1, len(arr1) + len(arr2)].\n    \"\"\"\n    ptr1 = 0\n    ptr2 = 0\n    current_kth_element = 0\n\n    for count in range(1, k + 1):\n        if ptr1 < len(arr1) and ptr2 < len(arr2):\n            if arr1[ptr1] <= arr2[ptr2]:\n                current_kth_element = arr1[ptr1]\n                ptr1 += 1\n            else:\n                current_kth_element = arr2[ptr2]\n                ptr2 += 1\n        elif ptr1 < len(arr1):\n            current_kth_element = arr1[ptr1]\n            ptr1 += 1\n        else: # ptr2 < len(arr2)\n            current_kth_element = arr2[ptr2]\n            ptr2 += 1\n            \n    re