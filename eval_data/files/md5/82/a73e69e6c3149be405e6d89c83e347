   if not isinstance(n, int):\n        raise TypeError(f\"Exponent 'n' must be an integer, got {type(n).__name__}\")\n\n    number_list_obj = NumberList.from_list(numbers)\n    result_list_obj = ResultList()\n\n    for element in number_list_obj._elements:\n        computed_value = element.power(n)\n        result_list_obj.append(computed_value)\n\n    return result_list_obj.to_list()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/624": [{"task_id": "Mbpp/624", "solution": "def is_upper(input: str) -> str:\n    \"\"\"Return uppercase form of `input` preserving non-alphabetic characters.\n    \"\"\"\n    return ''.join((ch.upper() if ch.isalpha() else ch) for ch in input)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/622": [{"task_id": "Mbpp/622", "solution": "class ValidationError(Exception):\n    def __init__(self, code: str, message: str):\n        self.code = code\n        self.message = message\n        super().__init__(f\"[{code}] {message}\")\nclass SortedList:\n    def __init__(self, elements: list):\n        self.elements = elements\n        self.length = len(elements)\n\n    def is_sorted(self) -> bool:\n        \"\"\"Checks if the list is sorted in non-decreasing order.\"\"\"\n        for i in range(self.length - 1):\n            if self.elements[i] > self.elements[i + 1]:\n                return False\n        return True\nclass Validator:\n    def validate_lengths(self, A: list, B: list, n: int) -> bool:\n        \"\"\"Validates if both lists have the expected length n.\"\"\"\n        if len(A) != n or len(B) != n:\n            raise ValidationError('LENGTH_MISMATCH', f'Input lists must both have length {n}. Found A: {len(A)}, B: {len(B)}.')\n        return True\n\n    def validate_sorted(self, A: list, B: list) -> bool:\n        \"\"\"Validates if both lists are sorted.\"\"\"\n        if not SortedList(A).is_sorted() or not SortedList(B).is_sorted():\n            raise ValidationError('UNSORTED', 'Input lists must be sorted in non-decreasing order.')\n        return True\n\n    def validate_numeric(self, A: list, B: list) -> bool:\n        \"\"\"Validates if all elements in both lists are numeric.\"\"\"\n        if any(not isinstance(x, (int, float)) for x in A + B):\n            raise ValidationError('NON_NUMERIC', 'Input lists must contain only numeric elements.')\n        return True\nclass MedianService:\n    def __init__(self):\n        self.validator = Validator()\n\n    def _merge_or_select_kth(self, A: list, B: list, k: int):\n        \"\"\"Finds the k-th smallest element (1-based index) in the combined sorted lists A and B.\"\"\"\n        len_A, len_B = len(A), len(B)\n        i, j = 0, 0\n        current_val = None\n\n        for count in range(k):\n            if i < len_A and (j >= len_B or A[i] <= B[j]):\n                current_val = A[i]\n                i += 1\n            elif j < len_B and (i >= len_A or B[j] < A[i]):\n                current_val = B[j]\n                j += 1\n        return current_val\n\n    def mergeOrSelectKth(self, A: list, B: list, k: int):\n        \"\"\"Public method to find the k-th smallest element in the merged lists.\"\"\"\n        return self._merge_or_select_kth(A, B, k)\n\n    def get_median(self, A: list, B: list, n: int) -> float:\n        \"\"\"Orchestrates validation and median computation.\"\"\"\n        self.validator.validate_lengths(A, B, n)\n        self.validator.validate_sorted(A, B)\n        self.validator.validate_numeric(A, B)\n\n        val_n = self.mergeOrSelectKth(A, B, n)\n        val_n1 = self.mergeOrSelectKth(A, B, n + 1)\n        \n        median = (val_n + val_n1) / 2.0\n        return float(median)\ndef get_median(A: list, B: list, n: int) -> float:\n    \"\"\"\n    Computes the median of two sorted lists of the same size.\n    Validates inputs and returns the median as a float, or raises ValidationError.\n    \"\"\"\n    service = 