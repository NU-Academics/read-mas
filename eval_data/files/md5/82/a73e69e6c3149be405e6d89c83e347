           # Ensure 'mid' points to the start of a potential pair or the unique element.\n            # If mid is odd, decrement to make it even.\n            if mid % 2 == 1:\n                mid -= 1\n\n            # Check if nums[mid] and nums[mid+1] form a pair.\n            if nums[mid] == nums[mid + 1]:\n                # This is a regular pair, so the unique element is to the right.\n                low = mid + 2\n            else:\n                # nums[mid] is either the unique element or part of a pair\n                # where the unique element is to its left (including mid).\n                high = mid\n        \n        # When low == high, this index points to the single unique element.\n        return nums[low]\ndef search(nums: List[int]) -> int:\n    \"\"\"\n    Finds the element that appears only once in a sorted array where all other elements appear twice.\n    Delegates the core logic to SearchFunction.search.\n    \"\"\"\n    return SearchFunction.search(nums)", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[[]]]}], "Mbpp/127": [{"task_id": "Mbpp/127", "solution": "def multiply_int(a: int, b: int) -> int:\n    \"\"\"Return the integer product of two integer arguments a and b.\n    Business rules enforced (per SRS): accepts exactly two arguments; returns mathematical product as int.\n    \"\"\"\n    return a * b", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/120": [{"task_id": "Mbpp/120", "solution": "class Pair:\n    \"\"\"Represents a validated 2-element numeric pair and computes its raw product.\"\"\"\n    def __init__(self, a: float | int, b: float | int):\n        self.a = a\n        self.b = b\n\n    def get_product(self) -> float | int:\n        \"\"\"Returns the raw product of a and b.\"\"\"\n        return self.a * self.b\nclass PairList:\n    \"\"\"Wraps input iterable of pairs, performs validation, and provides iteration over Pair objects.\"\"\"\n    def __init__(self, list_of_pairs: list):\n        self._list_of_pairs = list_of_pairs\n\n    def validate(self) -> bool:\n        \"\"\"Validates the input list of pairs, raising ValueError or TypeError on failure.\"\"\"\n        if not self._list_of_pairs:\n            raise ValueError(\"Input list cannot be empty.\")\n\n        for i, element in enumerate(self._list_of_pairs):\n            if not isinstance(element, (tuple, list)):\n                raise ValueError(f\"Element at index {i} must be a tuple or list, but got {type(element).__name__}.\")\n            if len(element) != 2:\n                raise ValueError(f\"Element at index {i} must be a 2-element sequence, but got {len(element)} elements: {element}.\")\n            \n            a, b = element\n            if not isinstance(a, (int, float)):\n                raise TypeError(f\"First component of element at index {i} must be numeric, but got {type(a).__name__}: {element}.\")\n            if not isinstance(b, (int, float)):\n                raise TypeError(f\"Second component of element at index {i} must be numeric, but got {type(b).__name__}: {element}.\")\n        return True\n\n    def __iter__(self):\n        \"\"\"Yields Pair instances for each valid (a, b) pair in the list.\"\"\"\n        for a, b in self._list_of_pairs:\n            yield Pair(a, b)\nclass MaxProductCalculator:\n    \"\"\"Computes the maximum absolute product from an iterable of Pair objects using single-pass aggregation.\"\"\"\n    def __init__(self):\n        pass\n\n    def max_product_tuple(self, list_of_pairs: list) -> float | int:\n        \"\"\"Orchestrates iteration over validated pairs, computes absolute product, and returns the maximum numeric value.\"\"\"\n        current_max = float('-inf')\n        all_products_integral = True\n\n        # Assumes list_of_pairs has been validated externally by the public function.\n        # This PairList instance is used solely for its iteration capabilities.\n        pair_list_for_iteration = PairList(list_of_pairs)\n\n        for pair_obj in pair_list_for_iteration:\n            raw_product = pair_obj.get_product()\n            abs_product = abs(raw_product)\n\n            if abs_product > current_max:\n                current_max = abs_product\n\n            # Determine if the final return type should be int or float.\n            # If any product is a non-integral float (e.g., 5.5 but not 5.0),\n            # then all_products_integral becomes False.\n            if all_products_integral and isinstance(raw_product, float) and raw_product % 1.0 != 0.0:\n                all_products_integral = False\n        \n        # Return an integer if all products were effectively integral, otherwise a float.\n        # current_max will not be -inf as PairList.validate ensures non-empty input.\n        if all_products_integral:\n            return int(current_max)\n        else:\n            return float(current_max)\ndef max_product_tuple(list_of_pairs: list) -> float | int:\n    \"\"\"\n    Finds the maximum absolute product between numbers in pairs of tuples within a given list.\n    \"\"\"\n    # 1. Construct PairList and validate input; this step handles all specified input errors.\n    pair_list_validator = PairList(list_of_pairs)\n    pair_list_validator.validate()\n\n    # 2. Delegate the maximum product computation to MaxProductCalculator.\n    calculator = MaxProductCalculator()\n    result = calculator.max_product_tuple(list_of_pairs)\n    \n    return result", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/125": [{"task_id": "Mbpp/125", "solution": "class BinaryString:\n    def __init__(self, value: str) -> None:\n        self.value = value\n\n    def length(self) -> int:\n        return len(self.value)\nclass Validator:\n    def is_valid(self, binary: BinaryString) -> bool:\n        return all(char in ('0', '1') for char in binary.value)\nclass FindLengthFunction:\n    def execute(self, binary: BinaryString) -> int:\n        \"\"\"Applies Kadane's algorithm to find the maximum difference.\"\"\"\n        max_so_far = 0\n        current_max = 0\n\n        for char in binary.value:\n            if char == '0':\n                current_max += 1\n            else: # char == '1'\n                current_max -= 1\n            \n            if current_max < 0:\n                current_max = 0\n            \n            max_so_far = max(max_so_far, current_max)\n        \n        return max_so_far\ndef find_length(binary_string: str) -> int:\n    \"\"\"\n    Finds the maximum difference (#0s - #1s) in any substring of the binary string.\n    Uses a Kadane-like algorithm mapping '0' to +1 and '1' to -1.\n    \"\"\"\n    b = BinaryString(binary_string)\n    validator = Validator()\n    if not validator.is_valid(b):\n        raise ValueError(\"Input must contain only '0' and '1'\")\n    \n    algo = FindLengthFunction()\n    return algo.execute(b)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/126": [{"task_id": "Mbpp/126", "solution": "from math import isqrt\ndef _compute_gcd(x: int, y: int) -> int:\n    \"\"\"Computes the greatest common divisor of two non-negative integers using the Euclidean algorithm.\"\"\"\n    while y:\n        x, y = y, x % y\n    return x\ndef _sum_divisors_of(n: int) -> int:\n    \"\"\"Calculates the sum of positive divisors for a given non-negative integer n.\"\"\"\n    if n == 0:\n        return 0\n    sum_val = 0\n    for i in range(1, isqrt(n) + 1):\n        if n % i == 0:\n            sum_val += i\n            if i * i != n:\n                sum_val += n // i\n    return sum_val\ndef sum(a: int, b: int) -> int:\n    \"\"\"\n    Finds the sum of common divisors of two given numbers.\n    Operates on absolute values of inputs.\n    \"\"\"\n    a_abs = abs(a)\n    b_abs = abs(b)\n\n    if a_abs == 0 and b_abs == 0:\n        return 0\n\n    common_divisor_gcd = _compute_gcd(a_abs, b_abs)\n    return _sum_divisors_of(common_divisor_gcd)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/128": [{"task_id": "Mbpp/128", "solution": "from typing import List, Sequence, Union\ndef _tokenize_words(words: Union[str, Sequence[str]]) -> List[str]:\n    \"\"\"\n    Splits a string into words by whitespace or converts a sequence of words into a list.\n    Preserves the order of words.\n    \"\"\"\n    if isinstance(words, str):\n        return words.split()\n    return list(words)\ndef long_words(n: int, words: Union[str, Sequence[str]]) -> List[str]:\n    \"\"\"\n    Finds words from a given string or sequence of words that are longer than n characters.\n    The order of words is preserved.\n    \"\"\"\n    tokens = _tokenize_words(words)\n    result = []\n    for word in tokens:\n        if len(word) > n:\n            result.append(word)\n    return result", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/132": [{"task_id": "Mbpp/132", "solution": "def tup_string(t: tuple) -> str:\n    \"\"\"Return the concatenation of the elements of tuple t as a string.\n\n    Precondition: t is a tuple of strings (each expected to be a single-character string per SRS).\n    \"\"\"\n    return ''.join(t)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/131": [{"task_id": "Mbpp/131", "solution": "class VowelSet:\n    def __init__(self) -> None:\n        \"\"\"Initializes the set of valid vowels.\"\"\"\n        self.vowels = {'a', 'e', 'i', 'o', 'u', 'A', 'E', 'I', 'O', 'U'}\n\n    def is_vowel(self, ch: str) -> bool:\n        \"\"\"Checks if a given character is a vowel.\"\"\"\n        return ch in self.vowels\nclass ReverseVowelsFunction:\n    def __init__(self, _vowel_set: VowelSet) -> None:\n        \"\"\"Initializes the function with a VowelSet instance.\"\"\"\n        self._vowel_set = _vowel_set\n\n    def execute(self, input: str) -> str:\n        \"\"\"Orchestrates the reversal of vowels in the input string.\"\"\"\n        vowel_positions, extracted_vowels = self._extract_vowel_positions_and_chars(input)\n        \n        reversed_vowels = extracted_vowels[::-1] # Reverse the list of extracted vowels\n\n        return self._place_reversed_vowels(input, vowel_positions, reversed_vowels)\n\n    def _extract_vowel_positions_and_chars(self, s: str) -> (list[int], list[str]):\n        \"\"\"Extracts positions and characters of vowels from the string.\"\"\"\n        positions = []\n        chars = []\n        for i, ch in enumerate(s):\n            if self._vowel_set.is_vowel(ch):\n                positions.append(i)\n                chars.append(ch)\n        return positions, chars\n\n    def _place_reversed_vowels(self, s: str, positions: list[int], reversed_vowels: list[str]) -> str:\n        \"\"\"Constructs a new string with reversed vowels placed at their original positions.\"\"\"\n        s_list = list(s) # Convert string to list for mutable access\n        for i, pos in enumerate(positions):\n            s_list[pos] = reversed_vowels[i]\n        return \"\".join(s_list)\ndef reverse_vowels(input: str) -> str:\n    \"\"\"Reverses only the vowels in the input string.\"\"\"\n    if not isinstance(input, str):\n        raise TypeError(\"Input must be a string.\")\n    if not input:\n        return \"\"\n\n    vowel_set_instance = VowelSet()\n    reverse_vowels_function_instance = ReverseVowelsFunction(_vowel_set=vowel_set_instance)\n    return reverse_vowels_function_instance.execute(input)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/129": [{"task_id": "Mbpp/129", "solution": "class ValidationReport:\n    \"\"\"Collects validation outcome and failure messages.\"\"\"\n    def __init__(self):\n        self.is_magic = False\n        self.failures: list[str] = []\n\n    def add_failure(self, msg: str):\n        \"\"\"Adds a failure message and sets the report to not magic.\"\"\"\n        self.failures.append(msg)\n        self.is_magic = False\n\n    def set_magic(self, value: bool):\n        \"\"\"Sets the magic square status.\"\"\"\n        self.is_magic = value\nclass MagicSquareChecker:\n    \"\"\"Implements the logic to check if a matrix is a magic square.\"\"\"\n\n    def magic_square_test(self, matrix: list[list[int]]) -> bool:\n        \"\"\"Performs a full validation of the matrix and returns True if it's a magic square.\"\"\"\n        report = self.validate(matrix)\n        return report.is_magic\n\n    def validate(self, matrix: list[list[int]]) -> ValidationReport:\n        \"\"\"Performs a series of checks to validate if the matrix is a magic square.\"\"\"\n        report = ValidationReport()\n\n        if not self._check_shape(matrix, report):\n            return report\n\n        n = len(matrix)\n        \n        if not self._check_type_and_range(matrix, n, report):\n            return report\n        \n        if not self._check_uniqueness(matrix, n, report):\n            return report\n            \n        target_sum = self.compute_magic_sum(n)\n        \n        if not self._check_rows(matrix, target_sum, report):\n            return report\n            \n        if not self._check_columns(matrix, target_sum, report):\n            return report\n            \n        if not self._check_diagonals(matrix, target_sum, report):\n            return report\n            \n        report.set_magic(True)\n        return report\n\n    def compute_magic_sum(self, n: int) -> int:\n        \"\"\"Computes the magic sum for an n x n magic square.\"\"\"\n        return n * (n * n + 1) // 2\n\n    def _check_shape(self, values: list[list[int]], report: ValidationReport) -> bool:\n        \"\"\"Checks if the matrix is non-empty and square.\"\"\"\n        if not values:\n            report.add_failure(\"Matrix is empty.\")\n            return False\n        \n        n = len(values)\n        for i, row in enumerate(values):\n            if len(row) != n:\n                report.add_failure(f\"Matrix is not square: row {i} has length {len(row)}, expected {n}.\")\n                return False\n        return True\n\n    def _check_type_and_range(self, values: list[list[int]], n: int, report: ValidationReport) -> bool:\n        \"\"\"Checks if all elements are within the range 1 to n*n.\"\"\"\n        max_val = n * n\n        for r_idx, row in enumerate(values):\n            for c_idx, val in enumerate(row):\n                if not (1 <= val <= max_val):\n                    report.add_failure(f\"Cell ({r_idx},{c_idx}) value {val} is not in range 1..{max_val}.\")\n                    return False\n        return True\n\n    def _check_uniqueness(self, values: list[list[int]], n: int, report: ValidationReport) -> bool:\n        \"\"\"Checks if the matrix contains all integers from 1 to n*n exactly once.\"\"\"\n        seen = set()\n        expected_count = n * n\n        \n        for row in values:\n            for val in row:\n                if val in seen:\n                    report.add_failure(f\"Duplicate value found: {val}.\")\n                    return False\n                seen.add(val)\n        \n        if len(seen) != expected_count:\n            report.add_failure(f\"Not all numbers from 1 to {expected_count} are present exactly once.\")\n            return False\n            \n        return True\n\n    def _check_rows(self, values: list[list[int]], target_sum: int, report: ValidationReport) -> bool:\n        \"\"\"Checks if every row sums to the target sum.\"\"\"\n        for r_idx, row in enumerate(values):\n            if sum(row) != target_sum:\n                report.add_failure(f\"Row {r_idx} sum is {sum(row)}, expected {target_sum}.\")\n                return False\n        return True\n\n    def _check_columns(self, values: list[list[int]], target_sum: int, report: ValidationReport) -> bool:\n        \"\"\"Checks if every column sums to the target sum.\"\"\"\n        n = len(values)\n        for c_idx in range(n):\n            col_sum = 0\n            for r_idx in range(n):\n                col_sum += values[r_idx][c_idx]\n            if col_sum != target_sum:\n                report.add_failure(f\"Column {c_idx} sum is {col_sum}, expected {target_sum}.\")\n                return False\n        return True\n\n    def _check_diagonals(self, values: list[list[int]], target_sum: int, report: ValidationReport) -> bool:\n        \"\"\"Checks if both main diagonals sum to the target sum.\"\"\"\n        n = len(values)\n        diag1_sum = 0\n        diag2_sum = 0\n        \n        for i in range(n):\n            diag1_sum += values[i][i]\n            diag2_sum += values[i][n - 1 - i]\n        \n        if diag1_sum != target_sum:\n            report.add_failure(f\"Main diagonal sum is {diag1_sum}, expected {target_sum}.\")\n            return False\n        \n        if diag2_sum != target_sum:\n            report.add_failure(f\"Anti-diagonal sum is {diag2_sum}, expected {target_sum}.\")\n            return False\n            \n        return True\ndef magic_square_test(matrix: list[list[int]]) -> bool:\n    \"\"\"\n    Calculates whether the given matrix is a magic square.\n    A magic square is a square matrix where the sum of numbers in each row,\n    each column, and both main diagonals is the same.\n    \"\"\"\n    checker = MagicSquareChecker()\n    return checker.magic_square_test(matrix)", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[[[7, 7], [7, 7]]]]}], "Mbpp/130": [{"task_id": "Mbpp/130", "solution": "from typing import Dict, List\nclass FrequencyMap:\n    \"\"\"Helper class to manage item frequencies.\"\"\"\n    def __init__(self):\n        self.map: Dict[int, int] = {}\n\n    def increment(self, value: int) -> None:\n        \"\"\"Increments the count for a given value.\"\"\"\n        self.map[value] = self.ma