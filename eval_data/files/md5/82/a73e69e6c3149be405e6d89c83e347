ble values in ascending order using comb sort.\n        Returns a new sorted list, preserving multiplicity.\n        \"\"\"\n        data = list(inputList)  # Create a mutable copy of the input list\n        self._comb_sort(data)  # Sorts the list in-place\n        return data\n\n    def _comb_sort(self, data: List[Any]) -> None:\n        \"\"\"Internal method implementing the comb sort algorithm.\"\"\"\n        n = len(data)\n        if n <= 1:\n            return\n\n        gap = n\n        swapped = True\n\n        while gap > 1 or swapped:\n            gap = int(gap / self._shrink_factor)\n            if gap < 1:\n                gap = 1\n\n            swapped = False\n            for i in range(n - gap):\n                if data[i] > data[i + gap]:\n                    data[i], data[i + gap] = data[i + gap], data[i]\n                    swapped = True\ndef comb_sort(input_list: List[Any]) -> List[Any]:\n    \"\"\"\n    Sorts a list of elements using the Comb Sort algorithm.\n    It returns a new list with elements sorted in ascending order.\n    \"\"\"\n    sorter = CombSortFunction()\n    return sorter.sort(input_list)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/75": [{"task_id": "Mbpp/75", "solution": "from typing import List, Tuple\nclass FindTuplesService:\n    \"\"\"Service to find tuples where all elements are divisible by k.\"\"\"\n\n    def is_all_elements_divisible(self, t: Tuple[int, ...], k: int) -> bool:\n        \"\"\"Checks if every element in a tuple is divisible by k.\"\"\"\n        for e in t:\n            if e % k != 0:\n                return False\n        return True\n\n    def find_tuples(self, list_of_tuples: List[Tuple[int, ...]], k: int) -> List[Tuple[int, ...]]:\n        \"\"\"Evaluates each tuple and returns a list of tuples where all elements are divisible by k.\"\"\"\n        result = []\n        for t in list_of_tuples:\n            if self.is_all_elements_divisible(t, k):\n                result.append(t)\n        return result\ndef find_tuples(list_of_tuples: List[Tuple[int, ...]], k: int) -> List[Tuple[int, ...]]:\n    \"\"\"\n    Finds tuples from a list where all elements are divisible by k.\n    This function acts as a public API facade, delegating to FindTuplesService.\n    \"\"\"\n    service = FindTuplesService()\n    return service.find_tuples(list_of_tuples, k)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/67": [{"task_id": "Mbpp/67", "solution": "class InputValidator:\n    def validate(self, n: int) -> bool:\n        \"\"\"Raise TypeError if n is not int; raise ValueError if n < 0; return True otherwise.\"\"\"\n        if not isinstance(n, int):\n            raise TypeError(\"n must be an integer\")\n        if n < 0:\n            raise ValueError(\"n must be non-negative\")\n        return True\nclass BellCalculator:\n    def bell_number(self, n: int) -> int:\n        \"\"\"\n        Validate n via InputValidator and compute Bell number B_n.\n        Raises TypeError or ValueError per InputValidator on invalid input.\n        Returns integer B_n on success.\n        \"\"\"\n        validator = InputValidator()\n        validator.validate(n)\n\n        if n == 0:\n            return 1\n\n        # Use dynamic programming to compute Stirling numbers of the second kind S(i, j)\n        # dp[i][j] will store S(i, j)\n        dp = [[0] * (n + 1) for _ in range(n + 1)]\n\n        # Base case: S(0,0) = 1\n        dp[0][0] = 1\n\n        for i in range(1, n + 1):\n            dp[i][0] = 0  # S(i,0) = 0 for i > 0\n            for j in range(1, i + 1):\n                # Recurrence relation: S(i,j) = S(i-1, j-1) + j * S(i-1, j)\n                dp[i][j] = dp[i-1][j-1] + j * dp[i-1][j]\n        \n        # The Bell number B_n is the sum of S(n, j) for j from 0 to n\n        b_n = sum(dp[n][j] for j in range(n + 1))\n        \n        return b_n\ndef bell_number(n: int) -> int:\n    \"\"\"Public API wrapper delegating to BellCalculator.bell_number.\"\"\"\n    return BellCalculator().bell_number(n)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/80": [{"task_id": "Mbpp/80", "solution": "def tetrahedral_number(n: int) -> int:\n    \"\"\"Computes the nth tetrahedral number using the formula T_n = n*(n+1)*(n+2)/6.\"\"\"\n    return (n * (n + 1) * (n + 2)) // 6", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/86": [{"task_id": "Mbpp/86", "solution": "def centered_hexagonal_number(n: int) -> int:\n    \"\"\"Computes the nth centered hexagonal number using the direct formula.\"\"\"\n    return 3 * n * (n - 1) + 1", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/74": [{"task_id": "Mbpp/74", "solution": "from typing import List, Any, Dict, Optional\nclass PatternSequence:\n    def __init__(self, patterns: List[Any]) -> None:\n        \"\"\"Initializes with a list of patterns, raising ValueError if input is not a list.\"\"\"\n        if not isinstance(patterns, list):\n            raise ValueError(\"Patterns must be a list.\")\n        self.patterns = patterns\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the pattern sequence.\"\"\"\n        return len(self.patterns)\n\n    def isEmpty(self) -> bool:\n        \"\"\"Checks if the pattern sequence is empty.\"\"\"\n        return self.length() == 0\nclass ValueSequence:\n    def __init__(self, values: List[Any]) -> None:\n        \"\"\"Initializes with a list of values, raising ValueError if input is not a list.\"\"\"\n        if not isinstance(values, list):\n            raise ValueError(\"Values must be a list.\")\n        self.values = values\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the value sequence.\"\"\"\n        return len(self.values)\n\n    def isEmpty(self) -> bool:\n        \"\"\"Checks if the value sequence is empty.\"\"\"\n        return self.length() == 0\nclass Mapping:\n    def __init__(self) -> None:\n        \"\"\"Initializes bidirectional maps for pattern-value correspondences.\"\"\"\n        self._pattern_to_value: Dict[Any, Any] = {}\n        self._value_to_pattern: Dict[Any, Any] = {}\n\n    def add_mapping(self, pattern_key: Any, value_key: Any) -> bool:\n        \"\"\"\n        Attempts to add a mapping. Returns False if a consistency conflict is detected,\n        enforcing both forward and reverse mapping invariants.\n        \"\"\"\n        if pattern_key in self._pattern_to_value and self._pattern_to_value[pattern_key] != value_key:\n            return False\n        if value_key in self._value_to_pattern and self._value_to_pattern[value_key] != pattern_key:\n            return False\n\n        self._pattern_to_value[pattern_key] = value_key\n        self._value_to_pattern[value_key] = pattern_key\n        return True\n\n    def validateConsistency(self) -> bool:\n        \"\"\"Validates the overall consistency of the mapping.\"\"\"\n        return True\n\n    def get_value(self, pattern_key: Any) -> Optional[Any]:\n        \"\"\"Retrieves the value mapped to a given pattern key.\"\"\"\n        return self._pattern_to_value.get(pattern_key)\n\n    def get_pattern(self, value_key: Any) -> Optional[Any]:\n        \"\"\"Retrieves the pattern mapped to a given value key.\"\"\"\n        return self._value_to_pattern.get(value_key)\nclass PatternMatcher:\n    def is_samepatterns(self, patterns: List[Any], values: List[Any]) -> bool:\n        \"\"\"\n        Checks if the patterns and values lists follow the same pattern sequence.\n        Orchestrates length validation and mapping creation with consistency checks.\n        \"\"\"\n        if not self.validateLengths(patterns, values):\n            return False\n\n        mapping = self.createMapping(patterns, values)\n        if mapping is None:\n            return False\n        \n        # This call provides a final conceptual check, actual consistency enforced by add_mapping.\n        if not mapping.validateConsistency():\n            return False\n\n        return True\n\n    def createMapping(self, patterns: List[Any], values: List[Any]) -> Optional[Mapping]:\n        \"\"\"\n        Builds a Mapping object by iterating through patterns and values.\n        Returns None if any consistency conflict is found during the process.\n        \"\"\"\n        mapper = Mapping()\n        for i in range(len(patterns)):\n            pattern_key = patterns[i]\n            value_key = values[i]\n            if not mapper.add_mapping(pattern_key, value_key):\n                return None\n        return mapper\n\n    def validateLengths(self, patterns: List[Any], values: List[Any]) -> bool:\n        \"\"\"Checks if the lengths of the patterns and values sequences are equal.\"\"\"\n        return len(patterns) == len(values)\n\n    def validateComparableElements(self, sequence: List[Any]) -> bool:\n        \"\"\"Relies on Python's default dict behavior for comparability; no explicit check needed.\"\"\"\n        return True\ndef is_samepatterns(patterns: List[Any], values: List[Any]) -> bool:\n    \"\"\"\n    Checks if a list of values follows the sequence given in the patterns array.\n    Returns False for invalid inputs or if the patterns do not match.\n    \"\"\"\n    try:\n        # Validate input types using domain objects, raising ValueError as specified in design.\n        _ = PatternSequence(patterns)\n        _ = ValueSequence(values)\n\n        matcher = PatternMatcher()\n        return matcher.is_samepatterns(patterns, values)\n    except ValueError:\n        # Catches validation errors for non-list inputs as per design policy.\n        return False\n    except TypeError:\n        # Catches issues like unhashable types if they occur during mapping creation.\n        return False", "base_status": "pass", "plus_status": "fail", "base_fail_tests": []