bsequence starting at index i)\n    lds_sum = [0] * n\n    for i in range(n - 1, -1, -1):\n        lds_sum[i] = arr[i]\n        for j in range(n - 1, i, -1):\n            if arr[j] < arr[i]:  # Strict decreasing comparison\n                lds_sum[i] = max(lds_sum[i], lds_sum[j] + arr[i])\n\n    # Combine LIS and LDS sums to find the maximum bitonic sum.\n    # For a bitonic subsequence with peak arr[i], the sum is LIS_sum[i] + LDS_sum[i] - arr[i]\n    # (arr[i] is counted once as the peak).\n    max_bitonic_sum = float('-inf') # Initialize with negative infinity to handle potentially negative sums\n    for i in range(n):\n        current_bitonic_sum = lis_sum[i] + lds_sum[i] - arr[i]\n        max_bitonic_sum = max(max_bitonic_sum, current_bitonic_sum)\n\n    return max_bitonic_sum", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/250": [{"task_id": "Mbpp/250", "solution": "from typing import Any\ndef count_X(tuple_input: tuple, element: Any) -> int:\n    \"\"\"Count occurrences of an element in a tuple using equality (==).\n    Returns an integer representing the number of times the element appears.\n    \"\"\"\n    counter = 0\n    for item in tuple_input:\n        if item == element:\n            counter += 1\n    return counter", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/251": [{"task_id": "Mbpp/251", "solution": "from typing import List, Any\ndef insert_element(input_list: List[Any], element: Any) -> List[Any]:\n    \"\"\"Return a new list where `element` appears immediately before each item from `input_list` preserving order.\"\"\"\n    result_list = []\n    for item in input_list:\n        result_list.append(element)\n        result_list.append(item)\n    return result_list", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/239": [{"task_id": "Mbpp/239", "solution": "def get_total_number_of_sequences(m: int, n: int) -> int:\n    \"\"\"\n    Finds the number of possible sequences of length n, such that each element is a positive integer\n    and is greater than or equal to twice the previous element but less than or equal to m.\n    \"\"\"\n    if n == 1:\n        return m\n\n    # dp_current[j] stores the number of sequences of current_length ending with j.\n    # prefix_sum_current[j] stores the sum of dp_current[k] for 1 <= k <= j.\n    # We only need the previous row's dp and prefix_sum to calculate the current row,\n    # so we use two arrays to optimize space.\n\n    # Initialize for length = 1: each number from 1 to m can be the first element.\n    prev_dp = [0] * (m + 1)\n    prev_prefix_sum = [0] * (m + 1)\n    \n    for j in range(1, m + 1):\n        prev_dp[j] = 1\n        prev_prefix_sum[j] = prev_prefix_sum[j - 1] + prev_dp[j]\n\n    # Iterate for lengths from 2 to n\n    for _ in range(2, n + 1):\n        current_dp = [0] * (m + 1)\n        current_prefix_sum = [0] * (m + 1)\n        \n        for j in range(1, m + 1):\n            # The previous element (a_k-1) must be <= floor(j / 2).\n            max_prev_val_allowed = j // 2 \n            \n            if max_prev_val_allowed >= 1:\n                # The count of sequences ending with j is the sum of sequences of (current_length-1)\n                # whose last element is <= max_prev_val_allowed. This sum is efficiently retrieved\n                # from the previous prefix sum array.\n                current_dp[j] = prev_prefix_sum[max_prev_val_allowed]\n            # If max_prev_val_allowed < 1 (i.e., j=1), current_dp[j] remains 0 as no previous element is possible.\n        \n        # Calculate prefix sum for the current_length\n        for j in range(1, m + 1):\n            current_prefix_sum[j] = current_prefix_sum[j - 1] + current_dp[j]\n            \n        # Update previous arrays for the next iteration\n        prev_dp = current_dp\n        prev_prefix_sum = current_prefix_sum\n\n    # The total number of sequences of length n is the sum of dp[n][j] for all j from 1 to m,\n    # which is stored in prev_prefix_sum[m] after the loop completes for n.\n    return prev_prefix_sum[m]", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/253": [{"task_id": "Mbpp/253", "solution": "def count_integer(input_list):\n    \"\"\"Return the number of integer elements in input_list.\n\n    Raises:\n        TypeError: if input_list is not a list.\n    \"\"\"\n    if not isinstance(input_list, list):\n        raise TypeError('count_integer expects a list as input')\n    count = 0\n    for element in input_list:\n        if isinstance(element, int):\n            count += 1\n    return count", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/252": [{"task_id": "Mbpp/252", "solution": "import math\ndef computeMagnitude(re, im):\n    \"\"\"Return float magnitude computed as math.hypot(re, im).\"\"\"\n    return math.hypot(re, im)\ndef computeAngle(re, im):\n    \"\"\"Return float angle computed as math.atan2(im, re).\"\"\"\n    return math.atan2(im, re)\ndef convert(z):\n    \"\"\"Accepts z (int | float | complex) and return (r: float, theta: float).\"\"\"\n    try:\n        # Attempt to treat z as a complex number, extracting real and imaginary parts.\n        re = float(z.real)\n        im = float(z.imag)\n    except AttributeError:\n        # If z does not have .real or .imag attributes (e.g., int or float),\n        # treat it as a real number with an imaginary part of zero.\n        re = float(z)\n        im = 0.0\n\n    r = computeMagnitude(re, im)\n    theta = computeAngle(re, im)\n\n    return (float(r), float(theta))", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/256": [{"task_id": "Mbpp/256", "solution": "import math\nfrom dataclasses import dataclass\nclass Prime:\n    \"\"\"Represents an integer candidate and provides isPrime() -> bool.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def isPrime(self) -> bool:\n        \"\"\"Return True if value > 1 and has no divisors other than 1 and itself.\"\"\"\n        if self.value < 2:\n            return False\n        for i in range(2, int(math.sqrt(self.value)) + 1):\n            if self.value % i == 0:\n                return False\n        return True\nclass PrimeCounter:\n    \"\"\"Encapsulates prime-counting algorithm.\"\"\"\n    def count_Primes_nums(self, n: float) -> int:\n        \"\"\"Compute and return number of primes strictly less than n; orchestrates NumberInput and Prime usage.\"\"\"\n        count = 0\n        # Loop integer candidates from 2 to floor(n)-1\n        for k in range(2, int(n)):\n            prime_candidate = Prime(k)\n            if prime_candidate.isPrime():\n                count += 1\n        return count\ndef count_Primes_nums(n: float) -> int:\n    \"\"\"Return int: number of prime integers strictly less than n.\n    Precondition: n is a non-negative number (n >= 0).\n    \"\"\"\n    if n < 2:\n        return 0\n\n    prime_counter = PrimeCounter()\n    return prime_counter.count_Primes_nums(n)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/247": [{"task_id": "Mbpp/247", "solution": "def lps(s: str) -> int:\n    \"\"\"\n    Finds the length of the longest palindromic subsequence in the given string using dynamic programming.\n    \"\"\"\n    n = len(s)\n\n    # Base case: an empty string has an LPS length of 0.\n    if n == 0:\n        return 0\n\n    # dp[i][j] stores the length of the longest palindromic subsequence of the substring s[i...j].\n    dp = [[0] * n for _ in range(n)]\n\n    # All single characters are palindromes of length 1.\n    for i in range(n):\n        dp[i][i] = 1\n\n    # Fill the DP table for substrings of increasing length.\n    for length in range(2, n + 1):\n        for i in range(n - length + 1):\n            j = i + length - 1 # Calculate the end index for the current substring.\n\n            if s[i] == s[j]:\n                # If characters at the ends match, they contribute 2 to the LPS length.\n                # The remaining length comes from the LPS of the inner substring s[i+1...j-1].\n                # If length is 2 (e.g., \"aa\"), the inner substring is empty, so dp[i+1][j-1] would effectively be 0.\n                dp[i][j] = 2 + (dp[i + 1][j - 1] if length > 2 else 0)\n            else:\n                # If characters at the ends do not match, the LPS is the maximum of:\n                # 1. LPS of s[i+1...j] (excluding the character s[i])\n                # 2. LPS of s[i...j-1] (excluding the character s[j])\n                dp[i][j] = max(dp[i + 1][j], dp[i][j - 1])\n\n    # The result for the entire string s[0...n-1] is stored in dp[0][n-1].\n    return dp[0][n - 1]", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/123": [{"task_id": "Mbpp/123", "solution": "import math\nfrom typing import Dict, List, Set\nclass InputValidator:\n    def validate(self, n: int) -> None:\n        \"\"\"Validates that n is an integer greater than or equal to 1.\"\"\"\n        if not isinstance(n, int) or n < 1:\n            raise ValueError(\"n must be an integer >= 1\")\nclass DivisorCalculator:\n    def __init__(self):\n        self._divisor_cache: Dict[int, int] = {}\n\n    def sum_proper_divisors(self, x: int) -> int:\n        \"\"\"Calculates the sum of proper divisors for a given number x, using a cache.\"\"\"\n        if x in self._divisor_cache:\n            return self._divisor_cache[x]\n        \n        if x <= 1:\n            self._divisor_cache[x] = 0\n            return 0\n\n        total_sum = 1 # 1 is always a proper divisor for x > 1\n        limit = math.isqrt(x)\n        for i in range(2, limit + 1):\n            if x % i == 0:\n                total_sum += i\n                if i * i != x:\n                    total_sum += x // i\n        \n        self._divisor_cache[x] = total_sum\n        return total_sum\nclass Number:\n    def __init__(self, value: int, divisor_sum: int, is_amicable: bool):\n        \"\"\"Initializes a Number object with its value, sum of proper divisors, and amicability status.\"\"\"\n        self.value = value\n        self.divisor_sum = divisor_sum\n        self.is_amicable = is_amicable\nclass AmicablePair:\n    def __init__(self, a: Number, b: Number):\n        \"\"\"Initializes an AmicablePair with two Number objects.\"\"\"\n        self.a = a\n        self.b = b\nclass AmicableDetector:\n    def __init__(self, divisor_calculator: DivisorCalculator):\n        \"\"\"Initializes the AmicableDetector with a DivisorCalculator instance.\"\"\"\n        self._divisor_calculator = divisor_calculator\n\n    def is_amicable(self, a: int) -> bool:\n        \"\"\"Checks if a given number 'a' is part of an amicable pair.\"\"\"\n        b = self._divisor_calculator.sum_proper_divisors(a)\n        if b <= 1 or a == b:\n            return False\n        \n        s_b = self._divisor_calculator.sum_proper_divisors(b)\n        return s_b == a\n\n    def find_amicable_pairs_up_to(self, n: int) -> List[AmicablePair]:\n        \"\"\"Finds all amicable pairs where at least one member is less than or equal to n.\"\"\"\n        pairs: List[AmicablePair] = []\n        seen_numbers: Set[int] = set()\n\n        for num_a in range(1, n + 1):\n            if num_a in seen_numbers:\n                continue\n\n            sum_div_a = self._divisor_calculator.sum_proper_divisors(num_a)\n            num_b = sum_div_a\n\n            if num_a == num_b:\n                continue\n            \n            sum_div_b = self._divisor_calculator.sum_proper_divisors(num_b)\n\n            if sum_div_b == num_a:\n                # Found an amicable pair (num_a, num_b)\n                if num_a < num_b: # Ensure deterministic ordering and avoid duplicates\n                    number_a = Number(value=num_a, divisor_sum=sum_div_a, is_amicable=True)\n                    number_b = Number(value=num_b, divisor_sum=sum_div_b, is_amicable=True)\n                    pairs.append(AmicablePair(a=number_a, b=number_b))\n                    seen_numbers.add(num_a)\n                    seen_numbers.add(num_b)\n                elif num_b < num_a: # Mark num_a as seen if its pair was already processed\n                    seen_numbers.add(num_a)\n                    seen_numbers.add(num_b)\n        return pairs\nclass ResultAggregator:\n    def __init__(self, detector: AmicableDetector):\n        \"\"\"Initializes the ResultAggregator with an AmicableDetector instance.\"\"\"\n        self._detector = detector\n\n    def amicable_numbers_sum(self, n: int) -> int:\n        \"\"\"Aggregates and sums unique amicable numbers from 1 to n.\"\"\"\n        pairs = self._detector.find_amicable_pairs_up_to(n)\n        \n        amicable_members: Set[int] = set()\n        for pair in pairs:\n            if 1 <= pair.a.value <= n:\n                amicable_members.add(pair.a.value)\n            if 1 <= pair.b.value <= n:\n                amicable_members.add(pair.b.value)\n                \n        return sum(amicable_members) if amicable_members else 0\ndef amicable_numbers_sum(n: int) -> int:\n    \"\"\"Sums all amicable numbers from 1 to a specified number n.\"\"\"\n    InputValidator().validate(n)\n    \n    divisor_calculator = DivisorCalculator()\n    amicable_detector = AmicableDetector(divisor_calculator)\n    result_aggregator = ResultAggregator(amicable_detector)\n    \n    return result_aggregator.amicable_numbers_sum(n)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/260": [{"task_id": "Mbpp/260", "solution": "from .validator import InputValidator\nfrom .sequence_generator import SequenceGenerator\nfrom .prime_checker import PrimeChecker\nfrom .types import ValidationErr