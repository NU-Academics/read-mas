d": "Mbpp/440", "solution": "class Token:\n    \"\"\"Represents a contiguous non-whitespace substring and its mapping to the original sentence.\"\"\"\n    def __init__(self, start_index: int, end_index: int, raw_text: str):\n        self.start_index = start_index  # Original start index in sentence\n        self.end_index = end_index      # Original end index in sentence (exclusive)\n        self.raw_text = raw_text        # The full raw token text (e.g., \"clearly!!\")\n        self.core_text = \"\"             # The normalized text without surrounding punctuation (e.g., \"clearly\")\n\n    def is_adverb(self) -> bool:\n        \"\"\"Checks if the token's core_text ends with 'ly' (case-insensitive).\"\"\"\n        return self.core_text.lower().endswith('ly')\ndef tokenize(sentence: str) -> list[Token]:\n    \"\"\"Splits the sentence into Token objects based on whitespace, preserving original indices.\"\"\"\n    tokens = []\n    current_pos = 0\n    while current_pos < len(sentence):\n        # Skip leading whitespace\n        while current_pos < len(sentence) and sentence[current_pos].isspace():\n            current_pos += 1\n        \n        if current_pos >= len(sentence):\n            break # Reached end of sentence\n            \n        token_start = current_pos\n        \n        # Find end of current non-whitespace sequence\n        token_end = token_start\n        while token_end < len(sentence) and not sentence[token_end].isspace():\n            token_end += 1\n            \n        raw_text = sentence[token_start:token_end]\n        tokens.append(Token(token_start, token_end, raw_text))\n        current_pos = token_end\n    return tokens\ndef find_adverb_position(sentence: str) -> tuple:\n    \"\"\"\n    Finds the first adverb and its position in a given sentence.\n    An adverb is defined as a token whose normalized core_text (without surrounding punctuation) ends with 'ly'.\n    \"\"\"\n    tokens = tokenize(sentence)\n\n    for token in tokens:\n        strip_surrounding_punctuation(token)\n        if token.is_adverb():\n            return (token.start_index, token.end_index, token.core_text)\n    \n    # Behavior when no adverb is found is unspecified per design; return None.\n    return None", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [["clearly!! we can see the sky"]], "plus_fail_tests": [["heavily and quickly we ran down the steep hill"]]}], "Mbpp/447": [{"task_id": "Mbpp/447", "solution": "def _cube(x):\n    \"\"\"Returns the cube of a number.\"\"\"\n    return x ** 3\ndef cube_nums(input_list: list) -> list:\n    \"\"\"Finds cubes of individual elements in a list.\"\"\"\n    return [_cube(x) for x in input_list]", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/451": [{"task_id": "Mbpp/451", "solution": "def remove_whitespaces(input: str) -> str:\n    \"\"\"Removes all whitespace characters from the given string, preserving the order of non-whitespace characters.\"\"\"\n    return ''.join(char for char in input if not char.isspace())", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [["\n\t"]]}], "Mbpp/450": [{"task_id": "Mbpp/450", "solution": "def extract_string(list_of_strings, size_int):\n    \"\"\"\n    Extracts strings of a specified length from a list, preserving order.\n    Returns a new list containing only the strings whose length exactly matches size_int.\n    \"\"\"\n    return [s for s in list_of_strings if len(s) == size_int]", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/448": [{"task_id": "Mbpp/448", "solution": "class ValidationError(Exception):\n    \"\"\"Custom exception for validation errors.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\nclass InputValidator:\n    \"\"\"Validates input parameters.\"\"\"\n    def validateNonNegativeInteger(self, n: object) -> None:\n        \"\"\"Raises ValidationError if n is not a non-negative integer.\"\"\"\n        if not isinstance(n, int) or n < 0:\n            raise ValidationError(\"n must be a non-negative integer\")\nclass PerrinSequence:\n    \"\"\"Generates and provides Perrin sequence terms.\"\"\"\n    def __init__(self):\n        self.terms: list[int] = []\n\n    def _ensure_generated_up_to(self, maxIndex: int) -> None:\n        \"\"\"Ensures the Perrin sequence is generated up to maxIndex (inclusive).\"\"\"\n        if maxIndex < 0:\n            return\n\n        while len(self.terms) <= maxIndex:\n            current_len = len(self.terms)\n            if current_len == 0:\n                self.terms.append(3)  # P(0)\n            elif current_len == 1:\n                self.terms.append(0)  # P(1)\n            elif current_len == 2:\n                self.terms.append(2)  # P(2)\n            else:\n                # Recurrence P(n) = P(n-2) + P(n-3) for n > 2\n                self.terms.append(self.terms[current_len - 2] + self.terms[current_len - 3])\n\n    def generateUpToIndex(self, maxIndex: int) -> list[int]:\n        \"\"\"Generates and returns Perrin terms from P(0) up to P(maxIndex).\"\"\"\n        self._ensure_generated_up_to(maxIndex)\n        return self.terms[:maxIndex + 1]\n\n    def getTerm(self, i: int) -> int:\n        \"\"\"Returns the i-th Perrin term, generating it if necessary.\"\"\"\n        self._ensure_generated_up_to(i)\n        return self.terms[i]\nclass SumCalculation:\n    \"\"\"Accumulates Perrin sequence terms and computes sums.\"\"\"\n    def __init__(self):\n        self.perrin_sequence_generator = PerrinSequence()\n        self.input_validator = InputValidator()\n\n    def calculateSumByIndex(self, maxIndex: int) -> int:\n        \"\"\"Calculates the sum of Perrin numbers from P(0) to P(maxIndex).\"\"\"\n        self.input_validator.validateNonNegativeInteger(maxIndex)\n        perrin_terms = self.perrin_sequence_generator.generateUpToIndex(maxIndex)\n        return sum(perrin_terms)\n\n    def calculateSumByCount(self, count: int) -> int:\n        \"\"\"Calculates the sum of the first 'count' Perrin numbers.\"\"\"\n        self.input_validator.validateNonNegativeInteger(count)\n        perrin_terms = []\n        if count > 0:\n            perrin_terms = self.perrin_sequence_generator.generateUpToIndex(count - 1)\n        return sum(perrin_terms)\ndef cal_sum(n: int) -> int:\n    \"\"\"Calculates the sum of Perrin numbers from index 0 to n (inclusive).\"\"\"\n    input_validator = InputValidator()\n    sum_calculator = SumCalculation()\n\n    try:\n        input_validator.validateNonNegativeInteger(n)\n        result_sum = sum_calculator.calculateSumByIndex(n)\n        return result_sum\n    except ValidationError as e:\n        raise ValueError(e.message) from e", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[-5]]}], "Mbpp/453": [{"task_id": "Mbpp/453", "solution": "import math\nclass Number:\n    \"\"\"Value object representing an integer with utility predicates.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def isPositive(self) -> bool:\n        \"\"\"Checks if the number is positive.\"\"\"\n        return self.value > 0\n\n    def isEven(self) -> bool:\n        \"\"\"Checks if the number is even.\"\"\"\n        return self.value % 2 == 0\nclass Factor:\n    \"\"\"Value object representing a divisor and its parity.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def isFactorOf(self, number: Number) -> bool:\n        \"\"\"Checks if this factor's value divides the given number.\"\"\"\n        return number.value % self.value == 0\n\n    def isEven(self) -> bool:\n        \"\"\"Checks if the factor's value is even.\"\"\"\n        return self.value % 2 == 0\nclass Result:\n    \"\"\"Wrapper for an integer result (sum of even factors).\"\"\"\n    def __init__(self, value: int):\n        self._value = value\n\n    def value(self) -> int:\n        \"\"\"Returns the wrapped integer value.\"\"\"\n        return self._value\nclass EvenFactorCalculator:\n    \"\"\"Encapsulates logic to find and sum even factors of a number.\"\"\"\n    def sumofFactors(self, n: int) -> int:\n        \"\"\"Calculates the sum of even positive factors for a given integer n.\"\"\"\n        number_obj = Number(n)\n        # Per BR1, factors must be positive. If n is not positive, there are no positive factors.\n        if not number_obj.isPositive():\n            return 0 \n        \n        factors = self.getFactors(number_obj)\n        even_factors = self.filterEven(factors)\n        total_sum = sum(f.value for f in even_factors)\n        return Result(total_sum).value()\n\n    def getFactors(self, number: Number) -> list[Factor]:\n        \"\"\"Finds all positive integer factors of the given number.\"\"\"\n        factors_set = set()\n        # Iterate up to the square root of the number to find pairs of factors.\n        for i in range(1, int(math.sqrt(number.value)) + 1):\n            if number.value % i == 0:\n                factors_set.add(Factor(i))\n                if i * i != number.value:\n                    factors_set.add(Factor(number.value // i))\n        return list(factors_set)\n\n    def filterEven(self, factors: list[Factor]) -> list[Factor]:\n        \"\"\"Filters a list of Factor objects, returning only the even ones.\"\"\"\n        return [f for f in factors if f.isEven()]\ndef sumofFactors(n: int) -> int:\n    \"\"\"\n    Finds the sum of even positive integer factors of a number.\n    \"\"\"\n    calculator = EvenFactorCalculator()\n    return calculator.sumofFactors(n)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/454": [{"task_id": "Mbpp/454", "solution": "import re\nclass Word:\n    def __init__(self, raw: str, letters: str):\n        self.raw = raw\n        self.letters = letters\n\n    def hasZ(self) -> bool:\n        \"\"\"Checks if the word's alphabetic portion contains 'z'.\"\"\"\n        return 'z' in self.letters\nclass Text:\n    def __init__(self, content: str):\n        self.content = content\n\n    def tokenize(self) -> list[Word]:\n        \"\"\"Tokenizes the text into Word objects based on alphabetic sequences.\"\"\"\n        tokens = []\n        matches = re.findall(r\"[A-Za-z]+\", self.content)\n        for match_str in matches:\n            tokens.append(Word(raw=match_str, letters=match_str))\n        return tokens\nclass TextMatchFunction:\n    def run(self, text: str) -> bool:\n        \"\"\"Orchestrates tokenization and matching for the presence of 'z'.\"\"\"\n        text_obj = Text(text)\n        tokens = text_obj.tokenize()\n        for token in tokens:\n            if token.hasZ():\n                return True\n        return False\ndef text_match_wordz(text) -> bool:\n    \"\"\"Matches a word containing 'z' in the input text.\"\"\"\n    return TextMatchFunction().run(text)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/455": [{"task_id": "Mbpp/455", "solution": "MONTHS_WITH_31_DAYS: frozenset[int] = frozenset({1, 3, 5, 7, 8, 10, 12})\ndef check_monthnumb_number(month: int) -> bool:\n    \"\"\"\n    Checks if the given month number corresponds to a month with 31 days.\n    \"\"\"\n    return month in MONTHS_WITH_31_DAYS", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/458": [{"task_id": "Mbpp/458", "solution": "def rectangle_area(width, height) -> float:\n    \"\"\"Calculates the area of a rectangle given its width and height.\"\"\"\n    return width * height", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/456": [{"task_id": "Mbpp/456", "solution": "def reverse_string_list(input_list: list[str]) -> list[str]:\n    \"\"\"Return a list where each element is the character-wise reversal of the corresponding input string.\n\n    Preconditions: input_list is a list of strings (per SRS). Behavior for invalid elements is unspecified.\n    \"\"\"\n    reversed_strings = []\n    for s in input_list:\n        reversed_strings.append(s[::-1])\n    return reversed_strings", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/459": [{"task_id": "Mbpp/459", "solution": "def is_ascii_upper(c: str) -> bool:\n    \"\"\"\n    Checks if a character is an ASCII uppercase letter.\n    Returns True if c is in the range 'A' to 'Z', False otherwise.\n    \"\"\"\n    return 'A' <= c <= 'Z'\ndef remove_uppercase(s: str) -> str:\n    \"\"\"\n    Removes all ASCII uppercase letters from the given string.\n    Preserves the order of all other characters.\n    \"\"\"\n    filtered_chars = []\n    for char in s:\n        if not is_ascii_upper(char):\n            filtered_chars.append(char)\n    return \"\".join(filtered_chars)", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [["ThiS%^%!s&a(mY)TesTStR%i*ng"]]}], "Mbpp/425": [{"task_id": "Mbpp/425", "solution": "def count_element_in_list(list_of_lists, element):\n    \"\"\"\n    Counts the number of sublists containing a particular element.\n    Each matching sublist contributes exactly 1 to the total count.\n    \"\"\"\n    count = 0\n    for sublist in list_of_lists:\n        if element in sublist:\n            count += 1\n    return count", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/463": [{"task_id": "Mbpp/463", "solution": "from typing import List, Optional\nclass ArrayInput:\n    \"\"\"Data holder for input integer array.\"\"\"\n    def __init__(self, elements: List[int]):\n        self.elements = elements\nclass ProductCalculator:\n    \"\"\"Encapsulates the algorithm to find the maximum product subarray.\"\"\"\n    def max_subarray_product(self, input_array: ArrayInput) -> int:\n        \"\"\"\n        Implements the classic linear-time algorithm using running current_max/current_min.\n        Raises ValueError for empty input_array.elements.\n        \"\"\"\n        elements = input_array.elements\n        if not elements:\n            raise ValueError(\"Input array cannot be empty for ProductCalculator.\")\n\n        max_so_far = elements[0]\n        min_so_far = elements[0]\n        overall_max_product = elements[0]\n\n        for i in range(1, len(elements)):\n            num = elements[i]\n\n            # Store max_so_far from previous iteration to use for min_so_far calculation\n            temp_max_val = max_so_far\n\n            max_so_far = max(num, temp_max_val * num, min_so_far * num)\n            min_so_far = min(num, temp_max_val * num, min_so_far * num)\n            \n            overall_max_product = max(overall_max_product, max_so_far)\n\n        return overall_max_product\ndef max_subarray_product(array: List[int]) -> int:\n    \"\"\"\n    Finds the maximum product subarray of the given array.\n    This function validates input and delegates computation to ProductCalculator.\n    \"\"\"\n    if array is None or not array:\n        raise ValueError(\"Input array cannot be None or empty.\")\n\n    array_input = ArrayInput(array)\n    calculator = ProductCalculator()\n    return calculator.max_subarray_product(array_input)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/462": [{"task_id": "Mbpp/462", "solution": "class CombinationGenerator:\n    \"\"\"\n    Generates combinations using the sequential-prefixing algorithm.\n    \"\"\"\n    def __init__(self):\n        pass\n\n    def combinations_list(self, input_list):\n        \"\"\"\n        Creates a shallow copy and delegates generation.\n        \"\"\"\n        elements = list(input_list)\n        return self._generate_prefixing(elements)\n\n    def _generate_prefixing(self, input_list):\n        \"\"\"\n        Implements the sequential-prefixing algorithm to find all combinations.\n        \"\"\"\n        result = [[]]\n        for e in input_list:\n            prefix_list = []\n            for combo in result:\n                new_combo = [e] + list(combo)\n                prefix_list.append(new_combo)\n            result.extend(prefix_list)\n        return result\ndef combinations_list(input_list):\n    \"\"\"\n    Public API. Returns a new list containing all combinations (power set) of input_list\n    in sequential-prefixing order. Does not mutate input_list.\n    \"\"\"\n    _validate_input(input_list)\n    generator = CombinationGenerator()\n    return generator.combinations_list(input_list)", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[["orange", "red", "green", "blue"]]], "plus_fail_tests": [[["a", "b", "c", "d", "e", "f", "g", "h", "i", "j"]]]}], "Mbpp/470": [{"task_id": "Mbpp/470", "solution": "from typing import Tuple, Union\nNumber = Union[int, float]\ndef add_pairwise(input_tuple: Tuple[Number, ...]) -> Tuple[Number, ...]:\n    \"\"\"Compute pairwise sums of neighboring elements.\n    Returns a tuple of numeric sums.\n    \"\"\"\n    sums = []\n    for i in range(len(input_tuple) - 1):\n        sums.append(input_tuple[i] + input_tuple[i+1])\n    return tuple(sums)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/468": [{"task_id": "Mbpp/468", "solution": "from typing import List, Union\nNumber = Union[int, float]\nclass ArrayInput:\n    \"\"\"Encapsulates input numeric sequence.\"\"\"\n    def __init__(self, numbers: List[Number]) -> None:\n        self.numbers = numbers\nclass Element:\n    \"\"\"Represents array element with index and numeric value.\"\"\"\n    def __init__(self, index: int, value: Number) -> None:\n        self.index = index\n        self.value = value\nclass Subsequence:\n    \"\"\"Represents a candidate subsequence and provides validation and product computation.\"\"\"\n    def __init__(self, elements: List[Element]) -> None:\n        self.elements = elements\n\n    def isStrictlyIncreasing(self) -> bool:\n        \"\"\"Verifies each successive value > previous and indices are increasing.\"\"\"\n        if not self.elements:\n            return True\n        \n        prev_value = self.elements[0].value\n        prev_index = self.elements[0].index\n        for i in range(1, len(self.elements)):\n            current_element = self.elements[i]\n            if not (current_element.value > prev_value and current_element.index > prev_index):\n                return False\n            prev_value = current_element.value\n            prev_index = current_element.index\n        return True\n\n    def product(self) -> Number:\n        \"\"\"Returns multiplicative product of elements' values.\"\"\"\n        if not self.elements:\n            return 1 # Multiplicative identity\n        \n        res = 1\n        for element in self.elements:\n            res *= element.value\n        return res\nclass ProductCalculator:\n    \"\"\"Implements core algorithm to compute maximum product across strictly increasing subsequences.\"\"\"\n    def __init__(self) -> None:\n        pass\n\n    def generateSubsequences(self, array_input: ArrayInput) -> List[Subsequence]:\n        \"\"\"\n        Produces candidate Subsequence objects using a dynamic programming approach.\n        Each returned Subsequence represents the maximum product IS ending at a particular index.\n        \"\"\"\n        numbers = array_input.numbers\n        n = len(numbers)\n        \n        if n == 0:\n            return []\n        \n        # dp_products[i] stores the maximum product of an IS ending at numbers[i]\n        dp_products = [0] * n\n        # dp_subsequences[i] stores the actual Subsequence object yielding dp_products[i]\n        dp_subsequences: List[Subsequence] = [Subsequence([]) for _ in range(n)]\n\n        for i in range(n):\n            current_element = Element(i, numbers[i])\n            \n            # Base case: subsequence of length 1 ending at i\n            dp_products[i] = numbers[i]\n            dp_subsequences[i] = Subsequence([current_element])\n\n            for j in range(i):\n                # If numbers[i] can extend the subsequence ending at j\n                if numbers[i] > numbers[j]:\n                    candidate_product = dp_products[j] * numbers[i]\n                    \n                    if candidate_product > dp_products[i]:\n                        dp_products[i] = candidate_product\n                        dp_subsequences[i] = Subsequence(dp_subsequences[j].elements + [current_element])\n        \n        return dp_subsequences\n\n    def computeProduct(self, subsequence: Subsequence) -> Number:\n        \"\"\"Computes multiplicative product using subsequence.product().\"\"\"\n        return subsequence.product()\n\n    def max_product(self, array_input: ArrayInput) -> Number:\n        \"\"\"\n        Computes and returns the maximum product across all strictly increasing subsequences.\n        Delegates to generateSubsequences and then finds the maximum product.\n        \"\"\"\n        candidate_subsequences = self.generateSubsequences(array_input)\n        \n        if not candidate_subsequences:\n            return 0 # If no numbers, no subsequences, max product is 0.\n\n        products = [self.computeProduct(s) for s in candidate_subsequences]\n        \n        return max(products)\ndef max_product(numbers: List[Number]) -> Number:\n    \"\"\"\n    Public API: constructs ArrayInput and delegates to ProductCalculator.max_product.\n    \"\"\"\n    array_input = ArrayInput(numbers)\n    return ProductCalculator().max_product(array_input)", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[[3, 100, 4, 5, 150, 6]]], "plus_fail_tests": [[[2, 3, 3, 4, 5, 3, 6]]]}], "Mbpp/471": [{"task_id": "Mbpp/471", "solution": "def find_remainder(array, n):\n    \"\"\"\n    Calcul