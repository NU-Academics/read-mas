 len(elements)\nclass Validator:\n    \"\"\"Validates input tuple structure and element types.\"\"\"\n    def validate(self, input_tuple: _PyTuple) -> Tuple:\n        if not isinstance(input_tuple, _PyTuple):\n            raise ValueError(\"Input must be a tuple.\")\n        if len(input_tuple) < 2:\n            raise ValueError(\"Input tuple must have at least 2 elements.\")\n        for element in input_tuple:\n            if not isinstance(element, (int, float)):\n                raise ValueError(\"All elements in the tuple must be numbers (int or float).\")\n        return Tuple(input_tuple)\nclass MultiplyElementsFunction:\n    \"\"\"Computes adjacent products from a validated Tuple.\"\"\"\n    def __init__(self, input_tuple: Tuple) -> None:\n        self.input = input_tuple\n        self.output: ResultTuple | None = None\n\n    def execute(self) -> ResultTuple:\n        products = []\n        for i in range(self.input.length - 1):\n            products.append(self.input.elements[i] * self.input.elements[i+1])\n        self.output = ResultTuple(_PyTuple(products))\n        return self.output\ndef multiply_elements(input_tuple: _PyTuple[Number, ...]) -> _PyTuple[Number, ...]:\n    \"\"\"\n    Takes a tuple of numbers and returns a tuple of adjacent products.\n    Each i-th element of the output tuple is t_i * t_{i+1}.\n    \"\"\"\n    validated = Validator().validate(input_tuple)\n    interactor = MultiplyElementsFunction(validated)\n    result_domain = interactor.execute()\n    return result_domain.elements", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[[1, 5, 7, 8, 10]]], "plus_fail_tests": [[[1, 2, 3, 4, 5, 6]]]}], "Mbpp/724": [{"task_id": "Mbpp/724", "solution": "def power_base_sum(base, power) -> int:\n    \"\"\"\n    Calculates the sum of all digits of the base to the specified power.\n    \"\"\"\n    calculated_value = base ** power\n    absolute_value = abs(calculated_value)\n    digit_sum = sum(int(digit) for digit in str(absolute_