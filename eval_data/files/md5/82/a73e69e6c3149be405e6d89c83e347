\"Checks if all elements in the tuple are numeric (int or float).\"\"\"\n        for element in self.elements:\n            if not isinstance(element, (int, float)):\n                return False\n        return True\n\n    def get_element(self, index: int) -> NumericElement:\n        return NumericElement(self.elements[index])\nclass ResultTuple:\n    def __init__(self, elements: tuple) -> None:\n        self.elements = elements\n\n    def length(self) -> int:\n        return len(self.elements)\n\n    def as_tuple(self) -> tuple:\n        return self.elements\nclass DivisionOperation:\n    def __init__(self, left: TupleInput, right: TupleInput) -> None:\n        self.left = left\n        self.right = right\n\n    def validate(self) -> None:\n        \"\"\"\n        Validates input tuples for matching length, numeric elements,\n        and absence of zero in the divisor tuple.\n        \"\"\"\n        if self.left.length() != self.right.length():\n            raise ValidationError(\"Input tuples must have the same length.\")\n\n        if not self.left.is_numeric_elements():\n            raise ValidationError(\"All elements in the left tuple must be numeric (int or float).\")\n        if not self.right.is_numeric_elements():\n            raise ValidationError(\"All elements in the right tuple must be numeric (int or float).\")\n\n        for i in range(self.right.length()):\n            if self.right.get_element(i).as_number() == 0:\n                raise DivisionByZeroError(f\"Division by zero at index {i}.\")\n\n    def compute(self) -> ResultTuple:\n        \"\"\"Performs element-wise division and returns the results in a ResultTuple.\"\"\"\n        results = []\n        for i in range(self.left.length()):\n            left_val = self.left.get_element(i).as_number()\n            right_val = self.right.get_element(i).as_number()\n            results.append(left_val / right_val)\n        return ResultTuple(tuple(results))\ndef division_elements(left_tuple: tuple, right_tuple: tuple) -> tuple:\n    \"\"\"\n    Performs element-wise division operation across two given tuples.\n    Validates inputs and handles division logic using domain objects.\n    \"\"\"\n    left_input = TupleInput(left_tuple)\n    right_input = TupleInput(right_tuple)\n\n    operation = DivisionOperation(left_input, right_input)\n    operation.validate()\n    result_tuple = operation.compute()\n\n    return result_tuple.as_tuple()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/265": [{"task_id": "Mbpp/265", "solution": "from typing import Any, List\nclass InputList:\n    \"\"\"A wrapper for the input list elements.\"\"\"\n    def __init__(self, elements: list) -> None:\n        self.elements: List[Any] = elements\nclass Element:\n    \"\"\"Represents an element with its value and original index.\"\"\"\n    def __init__(self, value: Any, index: int) -> None:\n        self.value: Any = value\n        self.index: int = index\nclass Sublist:\n    \"\"\"Accumulates elements for a specific offset.\"\"\"\n    def __init__(self, offset: int) -> None:\n        self.offset: int = offset\n        self._elements: List[Element] = []\n\n    def append(self, element: Element) -> None:\n        \"\"\"Adds an element to this sublist, preserving order.\"\"\"\n        self._elements.append(element)\n\n    def to_list(self) -> List[Any]:\n        \"\"\"Returns the list of values contained in this sublist.\"\"\"\n        return [e.value for e in self._elements]\nclass OutputList:\n    \"\"\"A container for the resulting sublists.\"\"\"\n    def __init__(self, sublists: List['Sublist']) -> None:\n        self.sublists: List['Sublist'] = sublists\n\n    def to_list_of_lists(self) -> List[List[Any]]:\n        \"\"\"Converts the contained Sublist objects into a plain list of lists.\"\"\"\n        return [sub.to_list() for sub in self.sublists]\nclass ListSplitter:\n    \"\"\"A domain service to perform the list splitting logic