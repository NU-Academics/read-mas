gth() == 0:\n            return output\n\n        output.append(input.get(0))\n        for i in range(1, input.length()):\n            current_element = input.get(i)\n            last_appended_element = output.get(output.length() - 1)\n            if not current_element.equals(last_appended_element):\n                output.append(current_element)\n        return output\ndef consecutive_duplicates(input_list: list) -> list:\n    \"\"\"\n    Removes consecutive duplicates from a list, preserving order and not modifying the input.\n    Returns a new list with unique consecutive elements.\n    \"\"\"\n    input_domain = InputList(input_list)\n    service = ConsecutiveDuplicatesService()\n    output_domain = service.consecutive_duplicates(input_domain)\n\n    result_list = []\n    for i in range(output_domain.length()):\n        result_list.append(output_domain.get(i)._value)\n    return result_list", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/732": [{"task_id": "Mbpp/732", "solution": "_SEPARATORS = (' ', ',', '.')\n_REPLACEMENT = ':'\ndef replace_specialchar(input: str) -> str:\n    \"\"\"\n    Replaces all occurrences of spaces, commas, or dots with a colon.\n    \"\"\"\n    output_chars = []\n    for char in input:\n        if char in _SEPARATORS:\n            output_chars.append(_REPLACEMENT)\n        else:\n            output_chars.append(char)\n    return ''.join(output_chars)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/728": [{"task_id": "Mbpp/728", "solution": "from src.errors import LengthMismatchError\ndef sum_list(a: list, b: list) -> list:\n    \"\"\"\n    Computes the element-wise sum of two lists of numbers.\n    Raises LengthMismatchError for unequal lengths or TypeError for non-numeric elements.\n    \"\"\"\n\n    def _validate_numeric_elements(seq: list, name: str) -> None:\n        \"\"\"Helper to check if all elements in a list are integers or floats.\"\"\"\n        for i, element in enumerate(seq):\n            if not isinstance(element, (int, float)):\n                raise TypeError(f\"Non-numeric element in {name} at index {i}: {element}\")\n\n    def _validate_lengths(list_a: list, list_b: list) -> None:\n        \"\"\"Helper to ensure two lists have identical lengths.\"\"\"\n        if len(list_a) != len(list_b):\n            raise LengthMismatchError(\"Input lists have different lengths\")\n\n    _validate_numeric_elements(a, 'a')\n    _validate_numeric_elements(b, 'b')\n    _validate_lengths(a, b)\n\n    return [a[i] + b[i] for i in range(len(a))]", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/731": [{"task_id": "Mbpp/731", "solution": "import math\nfrom typing import Union\nNumeric = Union[int, float]\nclass MathConstants:\n    PI: float = math.pi\nclass LateralSurfaceCalculator:\n    @staticmethod\n    def _computeSlantHeight(r: Numeric, h: Numeric) -> float:\n        \"\"\"Computes the slant height directly from radius and height.\"\"\"\n        return math.sqrt(float(r) * float(r) + float(h) * float(h))\n\n    @staticmethod\n    def lateralsurface_cone(r: Numeric, h: Numeric) -> float:\n        \"\"\"\n        Calculates the lateral surface area of a cone.\n        It orchestrates the slant height computation and final area calculation.\n        \"\"\"\n        r_f = float(r)\n        h_f = float(h)\n        slant = LateralSurfaceCalculator._computeSlantHeight(r_f, h_f)\n        return float(MathConstants.PI * r_f * slant)\ndef lateralsurface_cone(r, h) -> float:\n    \"\"\"\n    Calculates the lateral surface area of a cone given radius r and height h.\n    The area is computed as pi * r * sqrt(r^2 + h^2).\n    \"\"\"\n    return LateralSurfaceCalculator.lateralsurface_cone(r, h)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/592": [{"task_id": "Mbpp/592", "solution": "import math\nclass BinomialCoefficient:\n    @staticmethod\n    def compute(n: int, k: int) -> int:\n        \"\"\"Return integer C(n,k) if 0 <= k <= n, else 0. Uses math.comb when available.\"\"\"\n        if not (0 <= k <= n):\n            return 0\n        return math.comb(n, k)\nclass SumOfProductFunction:\n    def __init__(self):\n        self._binom = BinomialCoefficient()\n\n    def validate_input(self, n: int) -> None:\n        \"\"\"Raise ValueError if n is not an int or n < 0.\"\"\"\n        if not isinstance(n, int) or n < 0:\n            raise ValueError(\"n must be integer >= 0\")\n\n    def compute(self, n: int) -> int:\n        \"\"\"Return sum_{k=0..n-1} C(n,k) * C(n,k+1) as int.\"\"\"\n        self.validate_input(n)\n        total = 0\n        for k in range(0, n):\n            a = self._binom.compute(n, k)\n            b = self._binom.compute(n, k + 1)\n            total += a * b\n        return total\ndef sum_Of_product(n):\n    \"\"\"Calculates the sum of the product of consecutive binomial coefficients.\"\"\"\n    return SumOfProductFunction().compute(n)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/733": [{"task_id": "Mbpp/733", "solution": "def find_first_occurrence(array, target):\n    \"\"\"\n    Finds the index of the first occurrence of a target number in a sorted array.\n    Uses a modified binary search to ensure the leftmost occurrence is found.\n    \"\"\"\n    low = 0\n    high = len(array) - 1\n    result = -1\n\n    while low <= high:\n        mid = low + (high - low) // 2\n        if array[mid] == target:\n            result = mid\n            high = mid - 1  # Move to the left half to find the first occurrence\n        elif array[mid] < target:\n            low = mid + 1\n        else:  # array[mid] > target\n            high = mid - 1\n    return result", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/734": [{"task_id": "Mbpp/734", "solution": "class InputList:\n    \"\"\"Represents the input list of integers.\"\"\"\n    def __init__(self, elements: list[int]) -> None:\n        self.elements = elements\nclass Subarray:\n    \"\"\"Represents a non-empty contiguous subarray.\"\"\"\n    def __init__(self, start: int, end: int, elements: list[int]) -> None:\n        self.start = start\n        self.end = end\n        self.elements = elements\nclass ProductCalculator:\n    \"\"\"Computes products for subarrays and accumulates their sum.\"\"\"\n    def compute_product(self, sub: 'Subarray') -> int:\n        \"\"\"Returns the product of elements in the given subarray.\"\"\"\n        current_product = 1\n        for x in sub.elements:\n            current_product *= x\n        return current_product\n\n    def sum_of_subarray_products(self, input: 'InputList') -> int:\n        \"\"\"Enumerates all non-empty contiguous subarrays, computes their products, and sums them.\"\"\"\n        total_sum_of_products = 0\n        n = len(input.elements)\n\n        for i in range(n):\n            for j in range(i, n):\n                subarray_elements = input.elements[i : j + 1]\n                subarray_obj = Subarray(i, j, subarray_elements)\n                product = self.compute_product(subarray_obj)\n                total_sum_of_products += product\n        \n        return total_sum_of_products\ndef sum_Of_Subarray_Prod(input_list: list[int]) -> int:\n    \"\"\"\n    Finds the sum of products of all possible sublists (subarrays) of a given list.\n    \"\"\"\n    input_obj = InputList(input_list)\n    calculator = ProductCalculator()\n    return calculator.sum_of_subarray_products(input_obj)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/735": [{"task_id": "Mbpp/735", "solution": "class IntegerInput:\n    \"\"\"Represents and validates an input integer; converts to BinaryRepresentation.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\n    def is_non_negative(self) -> bool:\n        \"\"\"Checks if the input value is non-negative.\"\"\"\n        return self.value >= 0\n\n    def to_binary(self) -> 'BinaryRepresentation':\n        \"\"\"Converts the integer value to its minimal binary string representation.\"\"\"\n        if self.value == 0:\n            return BinaryRepresentation('0')\n        return BinaryRepresentation(bin(self.value)[2:])\nclass BinaryRepresentation:\n    \"\"\"Holds a minimal binary string and provides its length, MSB, and LSB indices.\"\"\"\n    def __init__(self, bits: str) -> None:\n        self.bits = bits\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the binary string.\"\"\"\n        return len(self.bits)\n\n    def msb_index(self) -> int:\n        \"\"\"Returns the index of the most significant bit (left-to-right, 0-indexed).\"\"\"\n        return 0\n\n    def lsb_index(self) -> int:\n        \"\"\"Returns the index of the least significant bit (left-to-right, 0-indexed).\"\"\"\n        return self.length() - 1\n\n    def to_int(self) -> int:\n        \"\"\"Converts the binary string back to an integer.\"\"\"\n        return int(self.bits, 2)\nclass BitMask:\n    \"\"\"Constructs an integer mask with 1-bits at specified positions.\"\"\"\n    def __init__(self, mask_value: int) -> None:\n        self.mask_value = mask_value\n\n    @staticmethod\n    def create_for_middle_bits(msb_index: int, lsb_index: int, length: int) -> 'BitMask':\n        \"\"\"Creates a bitmask with 1s for all strictly middle bit positions.\"\"\"\n        mask_val = 0\n        # Iterate through left-to-right indices of the middle bits\n        for i in range(msb_index + 1, lsb_index):\n            # Map left-to-right index 'i' to right-to-left integer bit position 'p'\n            p = (length - 1 - i)\n            mask_val |= (1 << p)\n        return BitMask(mask_val)\nclass ToggleMiddleBitsFunction:\n    \"\"\"Orchestrates the process of toggling middle bits of a number.\"\"\"\n    @staticmethod\n    def toggle_middle_bits(n: int) -> int:\n        \"\"\"\n        Toggles all bits of a non-negative integer n except its MSB and LSB.\n        Returns n unchanged if its binary representation has fewer than 3 bits.\n        \"\"\"\n        input_obj = IntegerInput(n)\n        binary_rep = input_obj.to_binary()\n        length = binary_rep.length()\n\n        if length < 3:\n            return n\n\n        msb_idx = binary_rep.msb_index()\n        lsb_idx = binary_rep.lsb_index()\n\n        bit_mask_obj = BitMask.create_for_middle_bits(msb_idx, lsb_idx, length)\n        result_value = n ^ bit_mask_obj.mask_value\n        return result_value\ndef toggle_middle_bits(n: int) -> int:\n    \"\"\"\n    Toggles all bits of a non-negative integer n except its MSB and LSB.\n    Delegates to ToggleMiddleBitsFunction for core logic.\n    \"\"\"\n    return ToggleMiddleBitsFunction.toggle_middle_bits(n)", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[true]]}], "Mbpp/603": [{"task_id": "Mbpp/603", "solution": "from typing import List, Any, Optional\nclass IntegerParameter:\n    \"\"\"Encapsulates an integer parameter for validation. Provides methods to check its type and non-negativity.\"\"\"\n    def __init__(self, value: Any):\n        self.value = value\n\n    def is_integer(self) -> bool:\n        \"\"\"Checks if the encapsulated value is an integer.\"\"\"\n        return isinstance(self.value, int)\n\n    def is_non_negative(self) -> bool:\n        \"\"\"Checks if the encapsulated integer value is non-negative.\"\"\"\n        return self.value >= 0\nclass LudicList:\n    \"\"\"Container for ludic numbers, ensuring uniqueness and ascending order. Provides list access.\"\"\"\n    def __init__(self, values: Optional[List[int]] = None):\n        self.values = sorted(list(set(values))) if values else []\n\n    def contains(self, v: int) -> bool:\n        \"\"\"Checks if a value is present in the l