ring for validation and parsing.\n    Validates against the yyyy-mm-dd pattern.\n    \"\"\"\n    _DATE_PATTERN = re.compile(r'^\\d{4}-\\d{2}-\\d{2}$')\n\n    def __init__(self, value: str) -> None:\n        self.value = value\n\n    def parse(self) -> DateParts:\n        \"\"\"\n        Parses the encapsulated date string into DateParts if it matches the yyyy-mm-dd pattern.\n        Raises ValidationError if the pattern does not match.\n        \"\"\"\n        if not self._DATE_PATTERN.match(self.value):\n            raise ValidationError(f\"Date string '{self.value}' does not match 'yyyy-mm-dd' format.\")\n\n        year_str, month_str, day_str = self.value.split('-')\n        year = int(year_str)\n        month = int(month_str)\n        day = int(day_str)\n        return DateParts(year, month, day)\nclass DateFormatter:\n    \"\"\"\n    Orchestrates the conversion of a date string from yyyy-mm-dd to dd-mm-yyyy format.\n    Delegates validation, parsing, and formatting to other domain objects.\n    \"\"\"\n    def change_date_format(self, dateString: str) -> str:\n        \"\"\"\n        Converts a date string from yyyy-mm-dd to dd-mm-yyyy format.\n        It uses DateString for validation and parsing, and DateParts for final formatting.\n        \"\"\"\n        date_string_obj = DateString(dateString)\n        date_parts = date_string_obj.parse()\n        return date_parts.to_ddmmyyyy()\ndef change_date_format(date_string: str) -> str:\n    \"\"\"\n    Converts a date string from 'yyyy-mm-dd' format to 'dd-mm-yyyy' format.\n    Raises ValidationError if the input string does not match the expected pattern.\n    \"\"\"\n    return DateFormatter().change_date_format(date_string)", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [["2021-1-026"]]}], "Mbpp/430": [{"task_id": "Mbpp/430", "solution": "class DirectrixCalculator:\n    \"\"\"Calculates the directrix of a parabola according to system requirements.\"\"\"\n    def comput