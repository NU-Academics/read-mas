{"task_id": "HumanEval/162", "solution": "```python\nimport hashlib\n\ndef string_to_md5(text):\n    \"\"\"\n    Given a string 'text', return its md5 hash equivalent string.\n    If 'text' is an empty string, return None.\n    \"\"\"\n    if not text:\n        return None\n    return hashlib.md5(text.encode('utf-8')).hexdigest()\n```"}
{"task_id": "HumanEval/161", "solution": "```python\ndef solve(s: str) -> str:\n    \"\"\"\n    Transforms a string: reverses case of letters, or reverses whole string if no letters.\n    \"\"\"\n    \n    # Determine if the string contains any English alphabet letters.\n    has_letters = False\n    for char in s:\n        if ('a' <= char <= 'z') or ('A' <= char <= 'Z'):\n            has_letters = True\n            break\n\n    # If no letters are found, reverse the entire string.\n    if not has_letters:\n        return s[::-1]\n\n    # If letters are present, process each character.\n    result_chars = []\n    for char in s:\n        if ('a' <= char <= 'z'):\n            result_chars.append(char.upper())\n        elif ('A' <= char <= 'Z'):\n            result_chars.append(char.lower())\n        else:\n            result_chars.append(char)\n    \n    return \"\".join(result_chars)\n```"}
{"task_id": "HumanEval/146", "solution": "```python\ndef specialFilter(nums):\n    \"\"\"\n    Counts numbers greater than 10 with odd first and last digits.\n    Digits are extracted from the absolute value of the number.\n    \"\"\"\n\n    def _get_first_digit(num_val: int) -> int:\n        \"\"\"Extracts the first digit of a number's absolute value.\"\"\"\n        abs_num = abs(num_val)\n        if abs_num == 0:\n            return 0\n        while abs_num >= 10:\n            abs_num //= 10\n        return abs_num\n\n    def _get_last_digit(num_val: int) -> int:\n        \"\"\"Extracts the last digit of a number's absolute value.\"\"\"\n        return abs(num_val) % 10\n\n    def _is_odd(digit_val: int) -> bool:\n        \"\"\"Checks if a digit is odd.\"\"\"\n        return digit_val % 2 != 0\n\n    count = 0\n    for num in nums:\n        if num > 10:\n            first_digit = _get_first_digit(num)\n            last_digit = _get_last_digit(num)\n            if _is_odd(first_digit) and _is_odd(last_digit):\n                count += 1\n    return count\n```\n"}
{"task_id": "HumanEval/160", "solution": "```python\nclass InvalidInputError(Exception):\n    \"\"\"Custom exception for invalid input to the do_algebra function.\"\"\"\n    pass\n\n# Operator precedence mapping (higher number means higher precedence).\nOPERATOR_PRECEDENCE = {\n    '+': 1, '-': 1,\n    '*': 2, '//': 2,\n    '**': 3\n}\n\ndef _apply_operator(op: str, val1: int, val2: int) -> int:\n    \"\"\"Helper to perform a single binary operation.\"\"\"\n    if op == '+':\n        return val1 + val2\n    elif op == '-':\n        return val1 - val2\n    elif op == '*':\n        return val1 * val2\n    elif op == '//':\n        if val2 == 0:\n            raise InvalidInputError(\"Division by zero is not allowed.\")\n        return val1 // val2\n    elif op == '**':\n        return val1 ** val2\n    else:\n        # This case should be caught by input validation, but included for robustness.\n        raise InvalidInputError(f\"Unknown operator during application: {op}\")\n\ndef do_algebra(operator: list[str], operand: list[int]) -> int:\n    \"\"\"\n    Evaluates an algebraic expression from lists of operators and operands.\n    It follows standard operator precedence and returns the integer result.\n    \"\"\"\n    # Input Validation\n    if not isinstance(operator, list) or not all(isinstance(op, str) for op in operator):\n        raise InvalidInputError(\"Operators must be a list of strings.\")\n    if not isinstance(operand, list) or not all(isinstance(op, int) and op >= 0 for op in operand):\n        raise InvalidInputError(\"Operands must be a list of non-negative integers.\")\n    if len(operator) < 1 or len(operand) < 2:\n        raise InvalidInputError(\"Operator list must have at least one operator, and operand list at least two operands.\")\n    if len(operator) != len(operand) - 1:\n        raise InvalidInputError(\"Length of operators must be one less than operands.\")\n\n    op_stack = []  # Stack for operators\n    val_stack = [] # Stack for values (operands and intermediate results)\n\n    op_idx = 0\n    val_idx = 0\n\n    while op_idx < len(operator):\n        val_stack.append(operand[val_idx]) # Push current operand\n        val_idx += 1\n\n        current_op = operator[op_idx]\n        if current_op not in OPERATOR_PRECEDENCE:\n            raise InvalidInputError(f\"Invalid operator: {current_op}\")\n\n        current_prec = OPERATOR_PRECEDENCE[current_op]\n\n        # Process operators on the stack based on precedence and associativity.\n        # Implements left-associativity for all except '**' which is right-associative.\n        while op_stack:\n            top_op = op_stack[-1]\n            top_prec = OPERATOR_PRECEDENCE[top_op]\n\n            if top_prec > current_prec or (top_prec == current_prec and current_op != '**'):\n                op = op_stack.pop()\n                val2 = val_stack.pop()\n                val1 = val_stack.pop()\n                val_stack.append(_apply_operator(op, val1, val2))\n            else:\n                break \n        \n        op_stack.append(current_op)\n        op_idx += 1\n    \n    val_stack.append(operand[val_idx]) # Push the last operand\n\n    # Process any remaining operators in the stack.\n    while op_stack:\n        op = op_stack.pop()\n        val2 = val_stack.pop()\n        val1 = val_stack.pop()\n        val_stack.append(_apply_operator(op, val1, val2))\n\n    return val_stack[0]\n```"}
{"task_id": "HumanEval/163", "solution": "```python\ndef generate_integers(a, b):\n    \"\"\"\n    Given two positive integers a and b, return the even digits between a\n    and b, in ascending order.\n\n    For example:\n    generate_integers(2, 8) => [2, 4, 6, 8]\n    generate_integers(8, 2) => [2, 4, 6, 8]\n    generate_integers(10, 14) => []\n    \"\"\"\n    # Validate inputs as per FR1 error handling and BR1.\n    if not isinstance(a, int) or not isinstance(b, int):\n        raise ValueError(\"Inputs 'a' and 'b' must be integers.\")\n    if a <= 0 or b <= 0:\n        raise ValueError(\"Inputs 'a' and 'b' must be positive integers.\")\n\n    # Define the set of valid even single-digit numbers for efficient lookup.\n    EVEN_SINGLE_DIGITS = {2, 4, 6, 8}\n\n    min_val = min(a, b)\n    max_val = max(a, b)\n\n    result = []\n    # Iterate through the range, collecting matching numbers.\n    for num in range(min_val, max_val + 1):\n        if num in EVEN_SINGLE_DIGITS:\n            result.append(num)\n\n    return result\n```"}
{"task_id": "HumanEval/163", "solution": "```python\nEVEN_DIGITS = {0, 2, 4, 6, 8}\n\ndef _is_even_digit(num: int) -> bool:\n    \"\"\"Checks if a given integer is an even digit (0, 2, 4, 6, 8).\"\"\"\n    return num in EVEN_DIGITS\n\ndef _validate_inputs(a: int, b: int) -> None:\n    \"\"\"Validates that inputs 'a' and 'b' are positive integers.\"\"\"\n    if not isinstance(a, int) or not isinstance(b, int):\n        raise ValueError(\"Inputs 'a' and 'b' must be integers.\")\n    if a <= 0 or b <= 0:\n        raise ValueError(\"Inputs 'a' and 'b' must be positive integers.\")\n\ndef generate_integers(a, b):\n    \"\"\"\n    Given two positive integers a and b, return the even digits between a\n    and b, in ascending order.\n    \"\"\"\n    _validate_inputs(a, b)\n\n    min_val = min(a, b)\n    max_val = max(a, b)\n    \n    result_set = set()\n    for num in range(min_val, max_val + 1):\n        if _is_even_digit(num):\n            result_set.add(num)\n        \n    return sorted(list(result_set))\n```"}
