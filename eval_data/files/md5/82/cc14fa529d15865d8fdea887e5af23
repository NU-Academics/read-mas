{"task_id": "HumanEval/135", "solution": "```python\ndef can_arrange(arr):\n    \"\"\"Returns the largest index `i` where `arr[i] < arr[i-1]`.\n    If no such element exists (array is sorted or too short), returns -1.\n    \"\"\"\n    n = len(arr)\n    if n <= 1:\n        return -1\n\n    for i in range(n - 1, 0, -1):\n        if arr[i] < arr[i - 1]:\n            return i\n    return -1\n```"}
{"task_id": "HumanEval/134", "solution": "```python\ndef check_if_last_char_is_a_letter(txt: str) -> bool:\n    '''\n    Create a function that returns True if the last character\n    of a given string is an alphabetical character and is not\n    a part of a word, and False otherwise.\n    Note: \"word\" is a group of characters separated by space.\n    '''\n    if not txt:\n        return False\n\n    last_char = txt[-1]\n\n    if not last_char.isalpha():\n        return False\n\n    # Check if it's not part of a word:\n    # 1. It's the only character in the string\n    # 2. It's preceded by a space\n    if len(txt) == 1:\n        return True\n    else:\n        char_before_last = txt[-2]\n        return char_before_last.isspace()\n```"}
{"task_id": "HumanEval/134", "solution": "```python\ndef check_if_last_char_is_a_letter(txt: str) -> bool:\n    \"\"\"\n    Checks if the last character of a string is an isolated alphabetical letter.\n    An isolated letter is one not part of a multi-character word, separated by space.\n    \"\"\"\n    if not txt:\n        return False\n\n    last_char = txt[-1]\n\n    if not last_char.isalpha():\n        return False\n\n    if len(txt) == 1:\n        return True\n\n    char_before_last = txt[-2]\n    return char_before_last == ' '\n```"}
{"task_id": "HumanEval/135", "solution": "```python\ndef can_arrange(arr):\n    \"\"\"Returns the largest index of an element which is not greater than or equal\n    to the element immediately preceding it. Returns -1 if no such element exists.\n    \"\"\"\n    if not arr or len(arr) < 2:\n        return -1\n\n    largest_non_ascending_index = -1\n    for i in range(1, len(arr)):\n        if arr[i] < arr[i-1]:\n            largest_non_ascending_index = i\n    return largest_non_ascending_index\n```"}
{"task_id": "HumanEval/133", "solution": "```python\nimport math\n\ndef sum_squares(lst):\n    \"\"\"Calculates the sum of squared numbers in a list after rounding each to its ceiling.\n    Raises ValueError for invalid input types.\n    \"\"\"\n    if not isinstance(lst, list):\n        raise ValueError(\"Input must be a list.\")\n\n    total_sum = 0\n    for item in lst:\n        if not isinstance(item, (int, float)):\n            raise ValueError(f\"List contains non-numeric element: {item}\")\n        \n        ceiling_value = math.ceil(item)\n        total_sum += ceiling_value * ceiling_value\n    return total_sum\n```"}
{"task_id": "HumanEval/136", "solution": "```python\ndef largest_smallest_integers(lst):\n    \"\"\"\n    Finds the largest negative and smallest positive integers in a list.\n    Returns (largest_negative, smallest_positive), with None if not found.\n    \"\"\"\n    negatives = [x for x in lst if x < 0]\n    positives = [x for x in lst if x > 0]\n\n    largest_negative = max(negatives) if negatives else None\n    smallest_positive = min(positives) if positives else None\n\n    return (largest_negative, smallest_positive)\n```"}
{"task_id": "HumanEval/136", "solution": "```python\ndef largest_smallest_integers(lst: list[int]) -> tuple[int | None, int | None]:\n    \"\"\"\n    Finds the largest negative and smallest positive integers in a list.\n    Returns (largest_negative, smallest_positive), or None if not found.\n    \"\"\"\n    largest_negative = None\n    smallest_positive = None\n\n    for num in lst:\n        if num < 0:\n            if largest_negative is None or num > largest_negative:\n                largest_negative = num\n        elif num > 0:\n            if smallest_positive is None or num < smallest_positive:\n                smallest_positive = num\n\n    return (largest_negative, smallest_positive)\n```"}
