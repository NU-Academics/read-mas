{"task_id": "HumanEval/82", "solution": "def _is_prime(n: int) -> bool:\n    \"\"\"Checks if an integer n is a prime number.\n    It returns True if prime, False otherwise.\"\"\"\n    if n <= 1:\n        return False\n    if n <= 3:\n        return True\n    if n % 2 == 0 or n % 3 == 0:\n        return False\n    i = 5\n    while i * i <= n:\n        if n % i == 0 or n % (i + 2) == 0:\n            return False\n        i += 6\n    return True\n\ndef prime_length(string):\n    \"\"\"Write a function that takes a string and returns True if the string\n    length is a prime number or False otherwise\n    Examples\n    prime_length('Hello') == True\n    prime_length('abcdcba') == True\n    prime_length('kittens') == True\n    prime_length('orange') == False\n    \"\"\"\n    if not isinstance(string, str):\n        raise TypeError(\"Input must be a string.\")\n    \n    length = len(string)\n    return _is_prime(length)"}
{"task_id": "HumanEval/81", "solution": "```python\nfrom typing import List, Tuple\n\nclass InvalidGpaError(ValueError):\n    \"\"\"Custom exception for invalid GPA values.\"\"\"\n    pass\n\nGRADING_SCALE: List[Tuple[float, str]] = [\n    (4.0, \"A+\"),\n    (3.7, \"A\"),\n    (3.3, \"A-\"),\n    (3.0, \"B+\"),\n    (2.7, \"B\"),\n    (2.3, \"B-\"),\n    (2.0, \"C+\"),\n    (1.7, \"C\"),\n    (1.3, \"C-\"),\n    (1.0, \"D+\"),\n    (0.7, \"D\"),\n    (0.000001, \"D-\"), # Small epsilon to ensure 0.0 maps to E\n    (0.0, \"E\")\n]\n\nclass GradeScale:\n    \"\"\"Stores and provides access to the GPA to letter grade mapping.\"\"\"\n    def __init__(self, scale_data: List[Tuple[float, str]]):\n        self._scale_data = sorted(scale_data, key=lambda x: x[0], reverse=True)\n\n    def get_grade(self, gpa: float) -> str:\n        \"\"\"Retrieves the letter grade for a given numerical GPA.\n        Assumes gpa is non-negative.\"\"\"\n        for threshold, grade in self._scale_data:\n            if gpa >= threshold:\n                return grade\n        return \"E\" # Should not be reached if 0.0 is covered.\n\nclass GpaConverter:\n    \"\"\"Converts numerical GPAs to letter grades based on a grading scale.\"\"\"\n    def __init__(self, grade_scale: GradeScale):\n        self._grade_scale = grade_scale\n\n    def convert_single_gpa(self, gpa: float) -> str:\n        \"\"\"Converts a single GPA to its letter grade.\n        Raises InvalidGpaError if GPA is negative or TypeError if not a number.\"\"\"\n        if not isinstance(gpa, (int, float)):\n            raise TypeError(f\"GPA must be a number, got {type(gpa).__name__}\")\n        if gpa < 0.0:\n            raise InvalidGpaError(f\"GPA cannot be negative: {gpa}\")\n        return self._grade_scale.get_grade(gpa)\n\n    def convert_gpa_list(self, grades: List[float]) -> List[str]:\n        \"\"\"Converts a list of numerical GPAs to a list of letter grades.\n        Raises TypeError if input is not a list or contains non-numeric elements.\"\"\"\n        if not isinstance(grades, list):\n            raise TypeError(\"Input 'grades' must be a list.\")\n        \n        converted_grades: List[str] = []\n        for gpa in grades:\n            converted_grades.append(self.convert_single_gpa(gpa))\n        return converted_grades\n\ndef numerical_letter_grade(grades: List[float]) -> List[str]:\n    \"\"\"Converts a list of numerical GPAs into a list of letter grades.\n    It uses a predefined grading scale for the conversion.\"\"\"\n    converter = GpaConverter(GradeScale(GRADING_SCALE))\n    return converter.convert_gpa_list(grades)\n```"}
{"task_id": "HumanEval/82", "solution": "```python\nimport math\n\ndef prime_length(string: str) -> bool:\n    \"\"\"\n    Returns True if the string length is a prime number or False otherwise.\n    Raises TypeError if the input is not a string.\n    \"\"\"\n    def _is_prime(n: int) -> bool:\n        \"\"\"\n        Checks if a given integer is a prime number.\n        Returns True if n is prime, False otherwise.\n        \"\"\"\n        if n < 2:\n            return False\n        for i in range(2, int(math.sqrt(n)) + 1):\n            if n % i == 0:\n                return False\n        return True\n\n    if not isinstance(string, str):\n        raise TypeError(\"Input must be a string.\")\n\n    length = len(string)\n    return _is_prime(length)\n```"}
{"task_id": "HumanEval/84", "solution": "```python\ndef solve(N):\n    \"\"\"Given a positive integer N, return the total sum of its digits in binary.\n    \n    Example\n        For N = 1000, the sum of digits will be 1 the output should be \"1\".\n        For N = 150, the sum of digits will be 6 the output should be \"110\".\n        For N = 147, the sum of digits will be 12 the output should be \"1100\".\n    \n    Variables:\n        @N integer\n             Constraints: 0 \u2264 N \u2264 10000.\n    Output:\n         a string of binary number\n    \"\"\"\n    # Validate input N according to the specified constraints [0, 10000].\n    MIN_N, MAX_N = 0, 10000\n    if not isinstance(N, int):\n        raise ValueError(\"Input N must be an integer.\")\n    if not (MIN_N <= N <= MAX_N):\n        raise ValueError(f\"Input N must be between {MIN_N} and {MAX_N} inclusive.\")\n\n    # Calculate the sum of the decimal digits of N.\n    sum_of_digits = 0\n    temp_N = N \n    while temp_N > 0:\n        sum_of_digits += temp_N % 10\n        temp_N //= 10\n\n    # Convert the calculated sum to its binary string representation.\n    if sum_of_digits == 0:\n        return \"0\"\n    return bin(sum_of_digits)[2:]\n```"}
{"task_id": "HumanEval/83", "solution": "```python\nfrom typing import Any\n\nclass InputValidator:\n    \"\"\"Provides static methods for validating various input parameters.\"\"\"\n    @staticmethod\n    def validate_positive_integer(n: Any) -> None:\n        \"\"\"Checks if the given input 'n' is a positive integer, raising TypeError or ValueError if not.\"\"\"\n        if not isinstance(n, int):\n            raise TypeError(\"Input 'n' must be an integer.\")\n        if n <= 0:\n            raise ValueError(\"Input 'n' must be a positive integer.\")\n\nclass StartsOneEndsCalculator:\n    \"\"\"Encapsulates the mathematical logic for counting n-digit numbers that start or end with 1.\"\"\"\n    def calculate(self, n: int) -> int:\n        \"\"\"Computes the total count of n-digit numbers that start or end with 1 using inclusion-exclusion.\"\"\"\n        if n == 1:\n            return 1\n\n        starts_with_one = self._count_starts_with_one(n)\n        ends_with_one = self._count_ends_with_one(n)\n        starts_and_ends_with_one = self._count_starts_and_ends_with_one(n)\n\n        return starts_with_one + ends_with_one - starts_and_ends_with_one\n\n    def _count_starts_with_one(self, n: int) -> int:\n        \"\"\"Calculates the count of n-digit numbers that start with 1.\"\"\"\n        return 10**(n - 1)\n\n    def _count_ends_with_one(self, n: int) -> int:\n        \"\"\"Calculates the count of n-digit numbers that end with 1.\"\"\"\n        return 9 * (10**(n - 2)) if n > 1 else 1\n\n    def _count_starts_and_ends_with_one(self, n: int) -> int:\n        \"\"\"Calculates the count of n-digit numbers that start AND end with 1.\"\"\"\n        return 10**(n - 2) if n > 1 else 1\n\ndef starts_one_ends(n: int) -> int:\n    \"\"\"\n    Given a positive integer n, return the count of the numbers of n-digit\n    positive integers that start or end with 1.\n    \"\"\"\n    InputValidator.validate_positive_integer(n)\n    calculator = StartsOneEndsCalculator()\n    return calculator.calculate(n)\n```"}
{"task_id": "HumanEval/81", "solution": "```python\nfrom typing import List\n\ndef _convert_single_gpa(gpa: float) -> str:\n    \"\"\"Converts a single GPA to its corresponding letter grade based on the specified scale.\"\"\"\n    if gpa == 4.0:\n        return \"A+\"\n    elif gpa > 3.7:\n        return \"A\"\n    elif gpa > 3.3:\n        return \"A-\"\n    elif gpa > 3.0:\n        return \"B+\"\n    elif gpa > 2.7:\n        return \"B\"\n    elif gpa > 2.3:\n        return \"B-\"\n    elif gpa > 2.0:\n        return \"C+\"\n    elif gpa > 1.7:\n        return \"C\"\n    elif gpa > 1.3:\n        return \"C-\"\n    elif gpa > 1.0:\n        return \"D+\"\n    elif gpa > 0.7:\n        return \"D\"\n    elif gpa > 0.0:\n        return \"D-\"\n    else:  # Covers gpa = 0.0 and any negative values\n        return \"E\"\n\ndef numerical_letter_grade(grades: List[float]) -> List[str]:\n    \"\"\"It is the last week of the semester and the teacher has to give the grades\n    to students. The teacher has been making her own algorithm for grading.\n    The only problem is, she has lost the code she used for grading.\n    She has given you a list of GPAs for some students and you have to write \n    a function that can output a list of letter grades using the following table:\n             GPA       |    Letter grade\n              4.0                A+\n            > 3.7                A \n            > 3.3                A- \n            > 3.0                B+\n            > 2.7                B \n            > 2.3                B-\n            > 2.0                C+\n            > 1.7                C\n            > 1.3                C-\n            > 1.0                D+ \n            > 0.7                D \n            > 0.0                D-\n              0.0                E\n    \n\n    Example:\n    grade_equation([4.0, 3, 1.7, 2, 3.5]) ==> ['A+', 'B', 'C-', 'C', 'A-']\n    \"\"\"\n    return [_convert_single_gpa(gpa) for gpa in grades]\n```"}
{"task_id": "HumanEval/83", "solution": "```python\nclass InputValidator:\n    def validate_positive_integer(self, n: int, param_name: str) -> None:\n        \"\"\"Checks if n is a positive integer. Raises ValueError if validation fails.\"\"\"\n        if not isinstance(n, int):\n            raise ValueError(f\"Parameter '{param_name}' must be an integer.\")\n        if n <= 0:\n            raise ValueError(f\"Parameter '{param_name}' must be a positive integer.\")\n\n\nclass StartsOneEndsCalculator:\n    def __init__(self, validator: InputValidator):\n        \"\"\"Initializes the calculator with an InputValidator instance.\"\"\"\n        self.validator = validator\n\n    def calculate(self, n: int) -> int:\n        \"\"\"Calculates the count of n-digit positive integers that start or end with 1.\"\"\"\n        self.validator.validate_positive_integer(n, \"n\")\n\n        if n == 1:\n            return 1\n\n        # For n > 1, apply the inclusion-exclusion principle for the count.\n        # This formula is 10^(n-1) + 8 * 10^(n-2).\n        return (10**(n - 1)) + (8 * (10**(n - 2)))\n\n\n# Instantiate dependencies at module level as described by the design specification.\n_validator = InputValidator()\n_calculator = StartsOneEndsCalculator(validator=_validator)\n\n\ndef starts_one_ends(n: int) -> int:\n    \"\"\"\n    Given a positive integer n, return the count of the numbers of n-digit\n    positive integers that start or end with 1.\n    \"\"\"\n    return _calculator.calculate(n)\n```"}
{"task_id": "HumanEval/84", "solution": "class InvalidInputError(ValueError):\n    \"\"\"Custom exception for invalid input parameters.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n\nclass Utils:\n    @staticmethod\n    def calculate_digit_sum(N: int) -> int:\n        \"\"\"Calculates the sum of the decimal digits of a given integer N.\"\"\"\n        s = 0\n        for digit in str(N):\n            s += int(digit)\n        return s\n\n    @staticmethod\n    def decimal_to_binary_string(decimal_num: int) -> str:\n        \"\"\"Converts a non-negative decimal integer into its binary string representation.\"\"\"\n        if decimal_num == 0:\n            return \"0\"\n        return bin(decimal_num)[2:]\n\ndef solve(N):\n    \"\"\"Given a positive integer N, return the total sum of its digits in binary.\n    \n    Example\n        For N = 1000, the sum of digits will be 1 the output should be \"1\".\n        For N = 150, the sum of digits will be 6 the output should be \"110\".\n        For N = 147, the sum of digits will be 12 the output should be \"1100\".\n    \n    Variables:\n        @N integer\n             Constraints: 0 \u2264 N \u2264 10000.\n    Output:\n         a string of binary number\n    \"\"\"\n    if not isinstance(N, int):\n        raise InvalidInputError(\"Input N must be an integer.\")\n    if not (0 <= N <= 10000):\n        raise InvalidInputError(\"Input N must be between 0 and 10000, inclusive.\")\n\n    sum_of_digits = Utils.calculate_digit_sum(N)\n    binary_sum_string = Utils.decimal_to_binary_string(sum_of_digits)\n    return binary_sum_string"}
