{"task_id": "HumanEval/95", "solution": "```python\ndef check_dict_case(dict):\n    \"\"\"\n    Checks if all string keys in a dictionary are uniformly cased (all lowercase or all uppercase).\n    Returns False for empty dictionaries or if any key is not a string.\n    \"\"\"\n    if not dict:\n        return False\n\n    all_lower = True\n    all_upper = True\n\n    for key in dict.keys():\n        if not isinstance(key, str):\n            return False\n        \n        # Check if the key is not entirely lowercase\n        if not key.islower():\n            all_lower = False\n        \n        # Check if the key is not entirely uppercase\n        if not key.isupper():\n            all_upper = False\n        \n        # Optimization: if neither all_lower nor all_upper is possible, we can return early.\n        if not all_lower and not all_upper:\n            return False\n            \n    return all_lower or all_upper\n\n```"}
{"task_id": "HumanEval/95", "solution": "```python\ndef check_dict_case(dict):\n    \"\"\"\n    Given a dictionary, return True if all keys are strings in lower\n    case or all keys are strings in upper case, else return False.\n    The function should return False if the given dictionary is empty.\n    \"\"\"\n    if not dict:\n        return False\n\n    keys = list(dict.keys())\n\n    first_string_key_case = None\n    for key in keys:\n        if isinstance(key, str):\n            if key.islower():\n                first_string_key_case = \"lower\"\n                break\n            elif key.isupper():\n                first_string_key_case = \"upper\"\n                break\n            else:\n                return False\n        else:\n            return False\n\n    if first_string_key_case is None:\n        return False\n\n    for key in keys:\n        if isinstance(key, str):\n            if first_string_key_case == \"lower\" and not key.islower():\n                return False\n            if first_string_key_case == \"upper\" and not key.isupper():\n                return False\n            if not key.islower() and not key.isupper():\n                return False\n        else:\n            return False\n\n    return True\n```"}
{"task_id": "HumanEval/96", "solution": "```python\nclass InvalidInputError(ValueError):\n    \"\"\"Custom exception for invalid input parameters.\n    It indicates that the provided input does not meet the expected criteria.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n\ndef _is_prime(num: int) -> bool:\n    \"\"\"Checks if a given integer is a prime number.\n    Returns True if num is prime, False otherwise, efficiently checking up to its square root.\"\"\"\n    if num < 2:\n        return False\n    for i in range(2, int(num**0.5) + 1):\n        if num % i == 0:\n            return False\n    return True\n\ndef count_up_to(n: int) -> list[int]:\n    \"\"\"Implement a function that takes an non-negative integer and returns an array of the first n\n    integers that are prime numbers and less than n.\n    for example:\n    count_up_to(5) => [2,3]\n    count_up_to(11) => [2,3,5,7]\n    count_up_to(0) => []\n    count_up_to(20) => [2,3,5,7,11,13,17,19]\n    count_up_to(1) => []\n    count_up_to(18) => [2,3,5,7,11,13,17]\n    \"\"\"\n    if not isinstance(n, int):\n        raise InvalidInputError(\"Input 'n' must be an integer.\")\n    if n < 0:\n        raise InvalidInputError(\"Input 'n' must be a non-negative integer.\")\n\n    if n <= 2:\n        return []\n\n    primes = []\n    for num in range(2, n):\n        if _is_prime(num):\n            primes.append(num)\n    return primes\n```"}
{"task_id": "HumanEval/96", "solution": "```python\ndef _is_prime(num: int) -> bool:\n    \"\"\"Checks if a number is prime using trial division up to its square root.\n    Numbers less than 2 are not prime.\n    \"\"\"\n    if num < 2:\n        return False\n    for i in range(2, int(num**0.5) + 1):\n        if num % i == 0:\n            return False\n    return True\n\ndef count_up_to(n: int) -> list[int]:\n    \"\"\"Returns a list of prime numbers strictly less than n.\n    Raises ValueError for non-integer or negative inputs.\n    \"\"\"\n    if not isinstance(n, int):\n        raise ValueError(\"Input 'n' must be an integer.\")\n    if n < 0:\n        raise ValueError(\"Input 'n' must be a non-negative integer.\")\n\n    if n <= 2:\n        return []\n\n    primes = []\n    for num in range(2, n):\n        if _is_prime(num):\n            primes.append(num)\n    return primes\n```"}
