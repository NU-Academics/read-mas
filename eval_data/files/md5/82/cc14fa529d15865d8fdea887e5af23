{"task_id": "HumanEval/65", "solution": "```python\ndef circular_shift(x: int, shift: int) -> str:\n    \"\"\"Circular shift the digits of the integer x, shifting them right by `shift`\n    and returning the result as a string. If `shift` is greater than the number of digits, the digits are reversed.\n    \"\"\"\n    s = str(x)\n    num_digits = len(s)\n\n    if num_digits == 0:\n        return \"\"\n\n    if shift > num_digits:\n        return s[::-1]  # Reverse the string if shift exceeds digit count.\n\n    effective_shift = shift % num_digits\n    if effective_shift == 0:\n        return s\n\n    # Perform circular right shift.\n    return s[num_digits - effective_shift:] + s[:num_digits - effective_shift]\n```"}
{"task_id": "HumanEval/67", "solution": "```python\nimport re\nfrom dataclasses import dataclass\n\nclass ParsingError(Exception):\n    \"\"\"Custom exception for errors during string parsing.\"\"\"\n    pass\n\nclass CalculationError(Exception):\n    \"\"\"Custom exception for errors during fruit calculation.\"\"\"\n    pass\n\n@dataclass\nclass FruitCounts:\n    \"\"\"A data transfer object to hold the parsed counts of apples and oranges.\"\"\"\n    apples: int\n    oranges: int\n\nclass FruitStringParser:\n    \"\"\"Extracts the number of apples and oranges from a specifically formatted input string.\"\"\"\n    @staticmethod\n    def parse(s: str) -> FruitCounts:\n        \"\"\"Parses the input string to find integer counts of apples and oranges.\"\"\"\n        match = re.search(r\"(\\d+)\\s*apples\\s*and\\s*(\\d+)\\s*oranges\", s)\n        if not match:\n            raise ParsingError(f\"Invalid fruit string format: '{s}'\")\n        try:\n            apples = int(match.group(1))\n            oranges = int(match.group(2))\n            return FruitCounts(apples=apples, oranges=oranges)\n        except ValueError:\n            raise ParsingError(f\"Could not convert fruit counts to integers in '{s}'\")\n\nclass FruitCalculator:\n    \"\"\"Orchestrates the parsing of fruit counts and performs the final calculation of mangoes.\"\"\"\n    @staticmethod\n    def calculate_mangoes(s: str, total_fruits: int) -> int:\n        \"\"\"Calculates the number of mangoes based on parsed apple/orange counts and total fruits.\"\"\"\n        if not isinstance(total_fruits, int) or total_fruits < 0:\n            raise ValueError(\"Total fruits must be a non-negative integer.\")\n\n        try:\n            fruit_counts = FruitStringParser.parse(s)\n        except ParsingError as e:\n            raise e # Re-raise parsing errors for clarity.\n\n        total_known_fruits = fruit_counts.apples + fruit_counts.oranges\n\n        if total_known_fruits > total_fruits:\n            raise CalculationError(\n                f\"Sum of apples ({fruit_counts.apples}) and oranges ({fruit_counts.oranges}) \"\n                f\"exceeds total fruits ({total_fruits}).\"\n            )\n\n        mangoes = total_fruits - total_known_fruits\n        return mangoes\n\ndef fruit_distribution(s: str, n: int) -> int:\n    \"\"\"\n    Calculates the number of mango fruits in a basket.\n    Given counts of apples and oranges in a string, and the total number of fruits, returns mangoes.\n    \"\"\"\n    return FruitCalculator.calculate_mangoes(s, n)\n```"}
{"task_id": "HumanEval/67", "solution": "```python\nimport re\n\ndef fruit_distribution(s,n):\n    \"\"\"\n    Calculates the number of mangoes in a basket.\n    It extracts apple and orange counts from a string, then subtracts their sum from the total fruits.\n    \"\"\"\n    match = re.search(r\"(\\d+)\\s*apples\\s*and\\s*(\\d+)\\s*oranges\", s)\n    if not match:\n        raise ValueError(\"Input string format is invalid. Expected 'X apples and Y oranges'.\")\n\n    apples_str, oranges_str = match.groups()\n    try:\n        apples = int(apples_str)\n        oranges = int(oranges_str)\n    except ValueError:\n        raise ValueError(\"Could not convert fruit counts to integers.\")\n\n    mangoes = n - (apples + oranges)\n    return mangoes\n```"}
