{"task_id": "HumanEval/114", "solution": "```python\nimport math\n\ndef minSubArraySum(nums: list[int]) -> int:\n    \"\"\"\n    Given an array of integers nums, find the minimum sum of any non-empty sub-array\n    of nums.\n    \"\"\"\n    if not nums:\n        raise ValueError(\"Input array 'nums' cannot be empty for minSubArraySum.\")\n\n    min_so_far = math.inf\n    current_min = 0 \n\n    for num in nums:\n        current_min = min(num, current_min + num)\n        min_so_far = min(min_so_far, current_min)\n\n    return min_so_far\n```"}
{"task_id": "HumanEval/112", "solution": "def reverse_delete(s,c):\n    \"\"\"Task\n    We are given two strings s and c, you have to deleted all the characters in s that are equal to any character in c\n    then check if the result string is palindrome.\n    A string is called palindrome if it reads the same backward as forward.\n    You should return a tuple containing the result string and True/False for the check.\n    Example\n    For s = \"abcde\", c = \"ae\", the result should be ('bcd',False)\n    For s = \"abcdef\", c = \"b\"  the result should be ('acdef',False)\n    For s = \"abcdedcba\", c = \"ab\", the result should be ('cdedc',True)\n    \"\"\"\n    class CharDeleter:\n        \"\"\"A utility class for deleting specified characters from a string.\n        It provides a method to efficiently remove characters using a set for lookup.\"\"\"\n        def delete_chars(self, source_string: str, chars_to_delete: str) -> str:\n            if not isinstance(source_string, str) or not isinstance(chars_to_delete, str):\n                raise TypeError(\"Both source_string and chars_to_delete must be strings.\")\n            \n            # Convert chars_to_delete to a set for O(1) average time complexity lookups.\n            chars_set = set(chars_to_delete)\n            # Use a list comprehension to build the new string efficiently.\n            result_chars = [char for char in source_string if char not in chars_set]\n            return \"\".join(result_chars)\n\n\n    class PalindromeChecker:\n        \"\"\"A utility class for checking if a given string is a palindrome.\n        The check is case-sensitive and whitespace-sensitive.\"\"\"\n        def is_palindrome(self, text: str) -> bool:\n            if not isinstance(text, str):\n                raise TypeError(\"Input text must be a string.\")\n                \n            # A string is a palindrome if it reads the same forwards and backward.\n            return text == text[::-1]\n\n\n    class ReverseDeleteService:\n        \"\"\"Orchestrates character deletion and palindrome checking.\n        It combines functionalities from CharDeleter and PalindromeChecker.\"\"\"\n        def __init__(self, char_deleter: CharDeleter, palindrome_checker: PalindromeChecker):\n            self._char_deleter = char_deleter\n            self._palindrome_checker = palindrome_checker\n\n        def reverse_delete(self, s: str, c: str) -> tuple[str, bool]:\n            \"\"\"First deletes characters from s based on c and then checks if the resulting string is a palindrome.\n            Returns a tuple of the modified string and its palindrome status.\"\"\"\n            deleted_string = self._char_deleter.delete_chars(s, c)\n            is_palindrome = self._palindrome_checker.is_palindrome(deleted_string)\n            return (deleted_string, is_palindrome)\n\n\n    char_deleter = CharDeleter()\n    palindrome_checker = PalindromeChecker()\n    service = ReverseDeleteService(char_deleter, palindrome_checker)\n    return service.reverse_delete(s, c)"}
{"task_id": "HumanEval/114", "solution": "```python\nclass EmptyInputError(Exception):\n    \"\"\"Custom exception raised when an input array is empty.\n    It indicates that a non-empty array was required for the operation.\"\"\"\n    def __init__(self, message: str = \"Input array cannot be empty.\"):\n        super().__init__(message)\n\ndef minSubArraySum(nums: list[int]) -> int:\n    \"\"\"\n    Finds the minimum sum of any non-empty sub-array of nums.\n    This uses an adaptation of Kadane's algorithm for minimum sum.\n    \"\"\"\n    if not nums:\n        raise EmptyInputError(\"Input array cannot be empty.\")\n\n    # Initialize min_so_far and current_min with the first element.\n    min_so_far = nums[0]\n    current_min = nums[0]\n\n    # Iterate through the rest of the array starting from the second element.\n    for i in range(1, len(nums)):\n        current_min = min(nums[i], current_min + nums[i])\n        min_so_far = min(min_so_far, current_min)\n\n    return min_so_far\n```"}
{"task_id": "HumanEval/115", "solution": "```python\nimport math\n\ndef max_fill(grid: list[list[int]], capacity: int) -> int:\n    \"\"\"\n    Calculates the minimum number of bucket operations to empty all wells in a grid.\n    Each well's water is summed, and operations are rounded up based on bucket capacity.\n    \"\"\"\n    if not grid:\n        return 0\n\n    total_bucket_operations = 0\n\n    for well_row in grid:\n        # Calculate the total water in a single well.\n        total_water_in_well = sum(well_row)\n        \n        # Calculate bucket operations for this well.\n        if total_water_in_well == 0:\n            operations_for_well = 0\n        else:\n            operations_for_well = math.ceil(total_water_in_well / capacity)\n        \n        # Sum operations across all wells.\n        total_bucket_operations += operations_for_well\n    \n    return total_bucket_operations\n```"}
{"task_id": "HumanEval/117", "solution": "```python\ndef select_words(s, n):\n    \"\"\"Given a string s and a natural number n, returns a list of words from s\n    that contain exactly n consonants, in order of appearance.\"\"\"\n\n    if not s:\n        return []\n\n    VOWELS = {'a', 'e', 'i', 'o', 'u'}\n\n    def _is_vowel(char: str) -> bool:\n        \"\"\"Checks if a character is a vowel (case-insensitive).\"\"\"\n        return char.lower() in VOWELS\n\n    def _count_consonants(word: str) -> int:\n        \"\"\"Counts the number of consonants in a word.\"\"\"\n        count = 0\n        for char in word:\n            if char.isalpha() and not _is_vowel(char):\n                count += 1\n        return count\n\n    result_words = []\n    words = s.split()\n\n    for word in words:\n        consonant_count = _count_consonants(word)\n        if consonant_count == n:\n            result_words.append(word)\n\n    return result_words\n```\n"}
{"task_id": "HumanEval/116", "solution": "```python\ndef sort_array(arr: list[int]) -> list[int]:\n    \"\"\"\n    Sorts an array of integers by the number of ones in their binary representation\n    (ascending), and then by their decimal value (ascending) if bit counts are equal.\n\n    For negative numbers, the bit count is determined from their absolute value.\n    \"\"\"\n\n    def _count_set_bits(n: int) -> int:\n        \"\"\"Counts set bits in an integer, using its absolute value for negative numbers.\n        This count serves as the primary sorting key.\n        \"\"\"\n        if n < 0:\n            return abs(n).bit_count()\n        return n.bit_count()\n\n    # Sort the array using the custom key: (number of set bits, decimal value).\n    return sorted(arr, key=lambda x: (_count_set_bits(x), x))\n```"}
{"task_id": "HumanEval/115", "solution": "import math\nfrom typing import List\n\nclass Well:\n    \"\"\"Represents a single well with its water units.\"\"\"\n    def __init__(self, water_units: List[int]):\n        self._water_units = water_units\n\n    def get_water_units(self) -> List[int]:\n        \"\"\"Returns the raw list of water units for this well.\"\"\"\n        return self._water_units\n\n    @staticmethod\n    def from_list(well_data: List[int]) -> 'Well':\n        \"\"\"Constructs a Well object from a raw list of integers, validating values.\"\"\"\n        for unit in well_data:\n            if unit not in (0, 1):\n                raise ValueError(\"Well units must be 0 or 1.\")\n        return Well(well_data)\n\nclass Grid:\n    \"\"\"Represents the entire grid of wells.\"\"\"\n    def __init__(self, wells: List[Well]):\n        self._wells = wells\n\n    def get_wells(self) -> List[Well]:\n        \"\"\"Returns the list of Well objects contained in the grid.\"\"\"\n        return self._wells\n\n    @staticmethod\n    def from_list_of_lists(grid_data: List[List[int]]) -> 'Grid':\n        \"\"\"Constructs a Grid object from a raw list of lists of integers.\"\"\"\n        if not isinstance(grid_data, list):\n            raise ValueError(\"Grid data must be a list of lists.\")\n        wells = []\n        for row_data in grid_data:\n            wells.append(Well.from_list(row_data))\n        return Grid(wells)\n\nclass WellService:\n    \"\"\"Encapsulates business logic for calculating water units and bucket lowering operations.\"\"\"\n\n    def calculate_total_water_in_well(self, well: Well) -> int:\n        \"\"\"Calculates the sum of water units in a given Well.\"\"\"\n        return sum(well.get_water_units())\n\n    def calculate_bucket_lowers_for_well(self, water_units: int, capacity: int) -> int:\n        \"\"\"Determines minimum bucket lowers for water_units given capacity, rounding up.\"\"\"\n        if capacity <= 0:\n            raise ValueError(\"Bucket capacity must be greater than 0.\")\n        if water_units == 0:\n            return 0\n        return math.ceil(water_units / capacity)\n\n    def calculate_total_bucket_lowers(self, grid: Grid, capacity: int) -> int:\n        \"\"\"Orchestrates total bucket lowering operations across all wells in the Grid.\"\"\"\n        total_lowers = 0\n        for well in grid.get_wells():\n            water_in_well = self.calculate_total_water_in_well(well)\n            total_lowers += self.calculate_bucket_lowers_for_well(water_in_well, capacity)\n        return total_lowers\n\ndef max_fill(grid: List[List[int]], capacity: int) -> int:\n    \"\"\"\n    Calculates the number of times buckets need to be lowered to empty a grid of wells.\n    It processes a grid of wells and a bucket capacity to find total extraction operations.\n    \"\"\"\n    grid_obj = Grid.from_list_of_lists(grid)\n    service = WellService()\n    return service.calculate_total_bucket_lowers(grid_obj, capacity)"}
{"task_id": "HumanEval/116", "solution": "```python\nclass BitCounter:\n    \"\"\"\n    Utility class for counting set bits in an integer.\n    It uses Brian Kernighan's algorithm for efficiency.\n    \"\"\"\n    def count_set_bits(self, n: int) -> int:\n        \"\"\"\n        Counts '1's in the binary representation of the absolute value of n.\n        This ensures consistent bit counting for both positive and negative integers.\n        \"\"\"\n        count = 0\n        num = abs(n)  # Use absolute value as per BR2.\n        while num > 0:\n            num &= (num - 1)  # Brian Kernighan's algorithm.\n            count += 1\n        return count\n\nclass BinaryOneSorter:\n    \"\"\"\n    Sorts integers primarily by their binary '1's count, then by decimal value.\n    It encapsulates the custom sorting logic defined in the requirements.\n    \"\"\"\n    def __init__(self):\n        \"\"\"Initializes the sorter, creating an internal BitCounter instance.\"\"\"\n        self._bit_counter = BitCounter()\n\n    def _get_sort_key(self, num: int) -> tuple[int, int]:\n        \"\"\"\n        Generates a sorting key for a number as (number_of_ones, decimal_value).\n        The bit count is based on the absolute value, while the decimal value is original.\n        \"\"\"\n        ones_count = self._bit_counter.count_set_bits(num)\n        return (ones_count, num)\n\n    def sort(self, arr: list[int]) -> list[int]:\n        \"\"\"\n        Sorts the input array according to the custom rules.\n        A new sorted list is returned, leaving the original array unchanged.\n        \"\"\"\n        # FR5: Returns a new sorted list; NFR1: O(N log N) using Timsort.\n        return sorted(arr, key=self._get_sort_key)\n\ndef sort_array(arr: list[int]) -> list[int]:\n    \"\"\"\n    In this Kata, you have to sort an array of non-negative integers according to\n    number of ones in their binary representation in ascending order.\n    For similar number of ones, sort based on decimal value.\n\n    It must be implemented like this:\n    >>> sort_array([1, 5, 2, 3, 4]) == [1, 2, 3, 4, 5]\n    >>> sort_array([-2, -3, -4, -5, -6]) == [-6, -5, -4, -3, -2]\n    >>> sort_array([1, 0, 2, 3, 4]) == [0, 1, 2, 3, 4]\n    \"\"\"\n    # FR1: Input validation.\n    if not isinstance(arr, list):\n        raise TypeError(\"Input 'arr' must be a list.\")\n    for item in arr:\n        if not isinstance(item, int):\n            raise ValueError(f\"All elements in 'arr' must be integers, but found {type(item).__name__}.\")\n\n    # FR3, FR4: Sorting logic applied via BinaryOneSorter.\n    sorter = BinaryOneSorter()\n    return sorter.sort(arr)\n```"}
{"task_id": "HumanEval/117", "solution": "```python\ndef select_words(s: str, n: int) -> list[str]:\n    \"\"\"Given a string s and an integer n, returns words from s with exactly n consonants.\n    Words are processed case-insensitively and in their original order.\n    \"\"\"\n    if not s:\n        return []\n\n    VOWELS = {'a', 'e', 'i', 'o', 'u'}\n\n    def _is_vowel(char: str) -> bool:\n        \"\"\"Checks if a character is a vowel, case-insensitively.\"\"\"\n        return char.lower() in VOWELS\n\n    def count_consonants(word: str) -> int:\n        \"\"\"Counts consonants in a word, ignoring non-alphabetic characters.\"\"\"\n        count = 0\n        for char in word:\n            if char.isalpha() and not _is_vowel(char):\n                count += 1\n        return count\n\n    words = s.split()\n    result = []\n\n    for word in words:\n        consonant_count = count_consonants(word)\n        if consonant_count == n:\n            result.append(word)\n\n    return result\n```"}
{"task_id": "HumanEval/118", "solution": "```python\ndef get_closest_vowel(word):\n    \"\"\"Finds the closest vowel surrounded by consonants from the right side of the word (case-sensitive).\n    Vowels at the beginning or end of the word do not count; returns an empty string if no such vowel is found.\n    \"\"\"\n    _VOWELS = {'a', 'e', 'i', 'o', 'u'}\n\n    def _is_vowel(char_to_check: str) -> bool:\n        return char_to_check.lower() in _VOWELS\n\n    def _is_consonant(char_to_check: str) -> bool:\n        # Per constraints, input contains only English letters, so it's a consonant if not a vowel.\n        return not _is_vowel(char_to_check)\n\n    n = len(word)\n    if n < 3:\n        return \"\"\n\n    # Iterate from right to left, excluding the first and last characters (indices n-1 and 0).\n    # The loop considers indices from n-2 down to 1.\n    for i in range(n - 2, 0, -1):\n        current_char = word[i]\n        left_char = word[i - 1]\n        right_char = word[i + 1]\n\n        if (_is_vowel(current_char) and\n                _is_consonant(left_char) and\n                _is_consonant(right_char)):\n            return current_char\n    return \"\"\n```"}
{"task_id": "HumanEval/118", "solution": "```python\ndef get_closest_vowel(word):\n    \"\"\"Finds the closest vowel between two consonants from the right side of the word.\n    Vowels at the beginning and ending positions of the word do not count.\n    \"\"\"\n    VOWELS = \"aeiouAEIOU\"\n\n    def _is_vowel(char: str) -> bool:\n        return char in VOWELS\n\n    def _is_consonant(char: str) -> bool:\n        return char.isalpha() and not _is_vowel(char)\n\n    n = len(word)\n    # A word needs at least 3 characters for an internal vowel to exist.\n    if n < 3:\n        return \"\"\n\n    # Iterate from second-to-last character down to the second character.\n    # This range explicitly excludes characters at index 0 and n-1.\n    for i in range(n - 2, 0, -1):\n        current_char = word[i]\n        left_char = word[i - 1]\n        right_char = word[i + 1]\n\n        # Check if the current character is a vowel surrounded by two consonants.\n        if _is_vowel(current_char) and \\\n           _is_consonant(left_char) and \\\n           _is_consonant(right_char):\n            return current_char\n\n    return \"\"\n```"}
{"task_id": "HumanEval/119", "solution": "```python\ndef _is_balanced(s: str) -> bool:\n    \"\"\"Checks if a given string of parentheses is balanced. It maintains a balance counter, returning False if it ever drops below zero.\"\"\"\n    balance = 0\n    for char in s:\n        if char == '(':\n            balance += 1\n        else:\n            balance -= 1\n        if balance < 0:\n            return False\n    return balance == 0\n\ndef match_parens(lst: list[str]) -> str:\n    \"\"\"Checks if two strings can be concatenated in any order to form a balanced string. It attempts both `s1 + s2` and `s2 + s1`.\"\"\"\n    s1, s2 = lst[0], lst[1]\n\n    # Try s1 + s2\n    if _is_balanced(s1 + s2):\n        return 'Yes'\n\n    # Try s2 + s1\n    if _is_balanced(s2 + s1):\n        return 'Yes'\n\n    return 'No'\n```"}
{"task_id": "HumanEval/120", "solution": "```python\ndef maximum(arr, k):\n    \"\"\"\n    Given an array arr of integers and an integer k, return a sorted list\n    of length k with the maximum k numbers in arr.\n    \"\"\"\n    if not isinstance(arr, list) or not all(isinstance(x, int) for x in arr):\n        raise TypeError(\"Input 'arr' must be a list of integers.\")\n    if not isinstance(k, int) or k < 0 or k > len(arr):\n        raise ValueError(\"Input 'k' must be a non-negative integer, not exceeding the length of 'arr'.\")\n\n    if k == 0:\n        return []\n\n    # Sort the array in descending order, take the first k elements, then sort these k elements in ascending order.\n    return sorted(sorted(arr, reverse=True)[:k])\n```"}
{"task_id": "HumanEval/121", "solution": "```python\ndef solution(lst):\n    \"\"\"Given a non-empty list of integers, return the sum of all of the odd elements that are in even positions.\n    Examples: solution([5, 8, 7, 1]) ==> 12\n    \"\"\"\n    if not isinstance(lst, list):\n        raise ValueError(\"Input must be a list.\")\n    if not lst:\n        raise ValueError(\"Input list cannot be empty.\")\n    if not all(isinstance(x, int) for x in lst):\n        raise ValueError(\"Input list must contain only integers.\")\n\n    total_sum = 0\n    for i, element in enumerate(lst):\n        if i % 2 == 0 and element % 2 != 0:\n            total_sum += element\n    return total_sum\n```"}
{"task_id": "HumanEval/119", "solution": "```python\ndef _is_balanced(s: str) -> bool:\n    \"\"\"\n    Checks if a given string of parentheses is balanced.\n    A string is balanced if all parentheses match and the balance never drops below zero.\n    \"\"\"\n    balance = 0\n    for char in s:\n        if char == '(':\n            balance += 1\n        elif char == ')':\n            balance -= 1\n        if balance < 0:\n            return False\n    return balance == 0\n\ndef match_parens(lst: list[str]) -> str:\n    \"\"\"\n    Determines if two strings in a list can form a balanced parentheses string by concatenation in any order.\n    Returns 'Yes' if possible, 'No' otherwise.\n    \"\"\"\n    s1 = lst[0]\n    s2 = lst[1]\n\n    if _is_balanced(s1 + s2):\n        return 'Yes'\n\n    if _is_balanced(s2 + s1):\n        return 'Yes'\n\n    return 'No'\n\n```"}
