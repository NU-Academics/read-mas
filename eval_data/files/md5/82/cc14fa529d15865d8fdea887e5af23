{"task_id": "HumanEval/105", "solution": "```python\ndef by_length(arr):\n    \"\"\"\n    Transforms an array of integers by filtering numbers between 1 and 9,\n    sorting, reversing, and converting them to English word equivalents.\n    \"\"\"\n    DIGIT_WORDS = {\n        1: \"One\", 2: \"Two\", 3: \"Three\", 4: \"Four\", 5: \"Five\",\n        6: \"Six\", 7: \"Seven\", 8: \"Eight\", 9: \"Nine\"\n    }\n\n    # Filter valid numbers (1-9 inclusive, and actual integers).\n    filtered_numbers = [num for num in arr if isinstance(num, int) and 1 <= num <= 9]\n\n    # Return an empty array if no valid integers are found.\n    if not filtered_numbers:\n        return []\n\n    # Sort the filtered integers in ascending order.\n    sorted_numbers = sorted(filtered_numbers)\n\n    # Reverse the order of the sorted array.\n    reversed_numbers = sorted_numbers[::-1]\n\n    # Replace each integer with its corresponding English word name.\n    word_array = [DIGIT_WORDS[num] for num in reversed_numbers]\n\n    return word_array\n```"}
{"task_id": "HumanEval/106", "solution": "```python\nclass MathOperations:\n    \"\"\"\n    Provides fundamental mathematical operations like factorial and sum of numbers up to k.\n    \"\"\"\n\n    @staticmethod\n    def factorial(k: int) -> int:\n        \"\"\"\n        Calculates the factorial of a non-negative integer k.\n        Raises ValueError if k is negative.\n        \"\"\"\n        if not isinstance(k, int):\n            raise TypeError(\"Input 'k' must be an integer.\")\n        if k < 0:\n            raise ValueError(\"Factorial is not defined for negative numbers.\")\n        \n        if k == 0:\n            return 1\n        \n        result = 1\n        for i in range(1, k + 1):\n            result *= i\n        return result\n\n    @staticmethod\n    def sum_up_to(k: int) -> int:\n        \"\"\"\n        Calculates the sum of all integers from 1 to k.\n        Raises ValueError if k is negative.\n        \"\"\"\n        if not isinstance(k, int):\n            raise TypeError(\"Input 'k' must be an integer.\")\n        if k < 0:\n            raise ValueError(\"Sum up to a negative number is not defined in this context.\")\n        \n        # Uses the arithmetic series formula for efficiency.\n        return k * (k + 1) // 2\n\ndef f(n: int) -> list[int]:\n    \"\"\" Implement the function f that takes n as a parameter,\n    and returns a list of size n, such that the value of the element at index i is the factorial of i if i is even\n    or the sum of numbers from 1 to i otherwise.\n    i starts from 1.\n    the factorial of i is the multiplication of the numbers from 1 to i (1 * 2 * ... * i).\n    Example:\n    f(5) == [1, 2, 6, 24, 15]\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"Input 'n' must be an integer.\")\n\n    if n <= 0:\n        return []\n\n    result_list = []\n    for i in range(1, n + 1):  # i is 1-based, from 1 to n\n        if i % 2 == 0:  # If i is even, calculate factorial\n            calculated_value = MathOperations.factorial(i)\n        else:  # If i is odd, calculate sum of numbers from 1 to i\n            calculated_value = MathOperations.sum_up_to(i)\n        result_list.append(calculated_value)\n\n    return result_list\n```"}
{"task_id": "HumanEval/106", "solution": "```python\n# src/math_utils.py\n\nclass MathUtils:\n    \"\"\"Provides static utility methods for common mathematical calculations.\"\"\"\n\n    @staticmethod\n    def calculate_factorial(num: int) -> int:\n        \"\"\"Computes the factorial of a non-negative integer.\n        Raises ValueError for negative inputs.\"\"\"\n        if num < 0:\n            raise ValueError(\"Factorial is not defined for negative numbers.\")\n        if num == 0:\n            return 1\n        result = 1\n        for i in range(1, num + 1):\n            result *= i\n        return result\n\n    @staticmethod\n    def calculate_sum_up_to(num: int) -> int:\n        \"\"\"Computes the sum of all integers from 1 up to num.\n        Raises ValueError for negative inputs.\"\"\"\n        if num < 0:\n            raise ValueError(\"Sum up to a negative number is not defined in this context.\")\n        # Using the arithmetic series formula: n * (n + 1) / 2\n        return num * (num + 1) // 2\n\n```\n```python\n# src/calculator.py\n\nfrom src.math_utils import MathUtils\n\ndef f(n: int) -> list[int]:\n    \"\"\"Computes a list of n elements based on index parity.\n    Elements are factorial for even indices or sum for odd indices.\"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"Input 'n' must be an integer.\")\n    if n < 0:\n        raise ValueError(\"Input 'n' must be a non-negative integer.\")\n\n    result_list = []\n    for i in range(1, n + 1):  # i is the 1-based index\n        if i % 2 == 0:  # Even index: calculate factorial\n            result_list.append(MathUtils.calculate_factorial(i))\n        else:  # Odd index: calculate sum\n            result_list.append(MathUtils.calculate_sum_up_to(i))\n    return result_list\n```"}
{"task_id": "HumanEval/107", "solution": "```python\n# src/utils.py\nclass PalindromeChecker:\n    def is_palindrome(self, num: int) -> bool:\n        \"\"\"\n        Checks if a number is a palindrome.\n        \"\"\"\n        if num < 0:\n            return False\n        s_num = str(num)\n        return s_num == s_num[::-1]\n\n```\n```python\n# src/palindrome_counter.py\nfrom src.utils import PalindromeChecker\n\nclass PalindromeCounterService:\n    def __init__(self, palindrome_checker: PalindromeChecker):\n        self._palindrome_checker = palindrome_checker\n\n    def count_palindromes(self, n: int) -> tuple[int, int]:\n        \"\"\"\n        Counts even and odd integer palindromes within the range [1, n].\n        \"\"\"\n        even_count = 0\n        odd_count = 0\n        for i in range(1, n + 1):\n            if self._palindrome_checker.is_palindrome(i):\n                if i % 2 == 0:\n                    even_count += 1\n                else:\n                    odd_count += 1\n        return (even_count, odd_count)\n\n```\n```python\n# src/main.py\nfrom src.palindrome_counter import PalindromeCounterService\nfrom src.utils import PalindromeChecker\n\nclass PalindromeFacade:\n    MIN_N = 1\n    MAX_N = 1000\n\n    def __init__(self, counter_service: PalindromeCounterService):\n        self._counter_service = counter_service\n\n    def even_odd_palindrome(self, n: int) -> tuple[int, int]:\n        \"\"\"\n        Validates input n and calls the PalindromeCounterService to get counts.\n        \"\"\"\n        if not isinstance(n, int):\n            raise TypeError(\"Input 'n' must be an integer.\")\n        if not (self.MIN_N <= n <= self.MAX_N):\n            raise ValueError(f\"Input 'n' must be between {self.MIN_N} and {self.MAX_N} inclusive.\")\n\n        return self._counter_service.count_palindromes(n)\n\n# Global instance for direct function call as per design.\n_palindrome_checker_instance = PalindromeChecker()\n_palindrome_counter_service_instance = PalindromeCounterService(_palindrome_checker_instance)\n_palindrome_facade_instance = PalindromeFacade(_palindrome_counter_service_instance)\n\ndef even_odd_palindrome(n: int) -> tuple[int, int]:\n    \"\"\"\n    Given a positive integer n, return a tuple that has the number of even and odd\n    integer palindromes that fall within the range(1, n), inclusive.\n    \"\"\"\n    return _palindrome_facade_instance.even_odd_palindrome(n)\n\n```"}
{"task_id": "HumanEval/108", "solution": "```python\ndef count_nums(arr):\n    \"\"\"\n    Write a function count_nums which takes an array of integers and returns\n    the number of elements which has a sum of digits > 0.\n    If a number is negative, then its first signed digit will be negative:\n    e.g. -123 has signed digits -1, 2, and 3.\n    >>> count_nums([]) == 0\n    >>> count_nums([-1, 11, -11]) == 1\n    >>> count_nums([1, 1, 2]) == 3\n    \"\"\"\n    def _sum_digits(num: int) -> int:\n        \"\"\"\n        Calculates the sum of digits for a number, handling negative numbers\n        where the first digit is negative and subsequent digits are positive.\n        \"\"\"\n        if num == 0:\n            return 0\n        \n        s = str(num)\n        digit_sum = 0\n        \n        if s[0] == '-':\n            digit_sum += int(s[1]) * -1\n            for digit_char in s[2:]:\n                digit_sum += int(digit_char)\n        else:\n            for digit_char in s:\n                digit_sum += int(digit_char)\n        return digit_sum\n\n    count = 0\n    for num in arr:\n        if _sum_digits(num) > 0:\n            count += 1\n    return count\n```"}
{"task_id": "HumanEval/108", "solution": "```python\ndef _calculate_digit_sum(num: int) -> int:\n    \"\"\"Calculates the sum of digits for an integer, handling negative numbers.\"\"\"\n    if num == 0:\n        return 0\n\n    s = str(num)\n    digit_sum = 0\n    if s[0] == '-':\n        # The first digit after '-' is considered negative.\n        digit_sum -= int(s[1])\n        for digit_char in s[2:]:\n            digit_sum += int(digit_char)\n    else:\n        for digit_char in s:\n            digit_sum += int(digit_char)\n    return digit_sum\n\ndef count_nums(arr):\n    \"\"\"\n    Counts numbers in an array whose sum of digits is greater than 0.\n    Handles negative numbers by treating the first digit as negative.\n    \"\"\"\n    if not isinstance(arr, list):\n        raise TypeError(\"Input 'arr' must be a list.\")\n    \n    if not arr:\n        return 0\n\n    count = 0\n    for num in arr:\n        if not isinstance(num, int):\n            raise TypeError(f\"Expected integer in array, got {type(num)}\")\n            \n        current_sum = _calculate_digit_sum(num)\n        if current_sum > 0:\n            count += 1\n            \n    return count\n```"}
{"task_id": "HumanEval/107", "solution": "```python\ndef even_odd_palindrome(n):\n    \"\"\"\n    Given a positive integer n, return a tuple that has the number of even and odd\n    integer palindromes that fall within the range(1, n), inclusive.\n    \"\"\"\n    if not isinstance(n, int):\n        raise ValueError(\"Input 'n' must be an integer.\")\n    if not (1 <= n <= 1000):\n        raise ValueError(\"Input 'n' must be between 1 and 1000 inclusive.\")\n\n    even_count = 0\n    odd_count = 0\n\n    for i in range(1, n + 1):\n        # Convert the number to a string to check for palindrome property.\n        s_num = str(i)\n        if s_num == s_num[::-1]:\n            # Determine if the palindromic number is even or odd.\n            if i % 2 == 0:\n                even_count += 1\n            else:\n                odd_count += 1\n\n    return (even_count, odd_count)\n```"}
