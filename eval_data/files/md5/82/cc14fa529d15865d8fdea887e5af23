{"task_id": "HumanEval/62", "solution": "```python\nfrom typing import List\n\ndef derivative(xs: list) -> list:\n    \"\"\" xs represent coefficients of a polynomial.\n    xs[0] + xs[1] * x + xs[2] * x^2 + ....\\\n     Return derivative of this polynomial in the same form.\n    \"\"\"\n    if not isinstance(xs, list):\n        raise TypeError(\"Input 'xs' must be a list.\")\n    if not all(isinstance(c, (int, float)) for c in xs):\n        raise ValueError(\"All coefficients must be numeric (int or float).\")\n\n    # The derivative of a constant polynomial (e.g., [5]) or an empty list ([])\n    # is 0, represented by an empty list of coefficients.\n    if not xs or len(xs) == 1:\n        return []\n\n    derived_coefficients: List[float] = []\n    for i in range(1, len(xs)):\n        # The derivative of c_i * x^i is i * c_i * x^(i-1)\n        derived_coefficients.append(i * float(xs[i]))\n\n    return derived_coefficients\n```"}
{"task_id": "HumanEval/62", "solution": "```python\nfrom typing import List, Union\n\nclass PolynomialError(Exception):\n    \"\"\"Base exception for polynomial-related errors.\"\"\"\n    pass\n\nclass InvalidPolynomialError(PolynomialError):\n    \"\"\"Exception raised for invalid polynomial input.\"\"\"\n    pass\n\n\nclass Polynomial:\n    def __init__(self, coefficients: List[float]):\n        self._coefficients = [float(c) for c in coefficients]\n\n    def get_coefficients(self) -> List[float]:\n        return self._coefficients\n\n    @classmethod\n    def from_list(cls, coeffs: List[Union[int, float]]) -> 'Polynomial':\n        if not isinstance(coeffs, list):\n            raise InvalidPolynomialError(\"Input must be a list.\")\n        for c in coeffs:\n            if not isinstance(c, (int, float)):\n                raise InvalidPolynomialError(\"All coefficients must be numbers.\")\n        return cls(coeffs)\n\n\nclass PolynomialDerivativeService:\n    def calculate_derivative(self, polynomial: Polynomial) -> Polynomial:\n        coefficients = polynomial.get_coefficients()\n\n        if not coefficients or len(coefficients) == 1:\n            return Polynomial([])\n\n        derived_coefficients: List[float] = []\n        for i in range(1, len(coefficients)):\n            derived_coefficients.append(coefficients[i] * i)\n\n        return Polynomial(derived_coefficients)\n\ndef derivative(xs: list) -> list:\n    \"\"\"\n    xs represent coefficients of a polynomial.\n    Returns the coefficients of the derivative polynomial.\n    \"\"\"\n    service = PolynomialDerivativeService()\n    try:\n        poly = Polynomial.from_list(xs)\n        derived_poly = service.calculate_derivative(poly)\n        return derived_poly.get_coefficients()\n    except InvalidPolynomialError as e:\n        raise ValueError(f\"Invalid input for derivative: {e}\") from e\n```"}
{"task_id": "HumanEval/47", "solution": "```python\nclass InvalidInputError(Exception):\n    \"\"\"Custom exception for invalid input to the median calculator.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\n\nfrom typing import Union, Optional\n\ndef median(l: list) -> Optional[Union[int, float]]:\n    \"\"\"Return median of elements in the list l.\n    >>> median([3, 1, 2, 4, 5])\n    3\n    >>> median([-10, 4, 6, 1000, 10, 20])\n    15.0\n    \"\"\"\n    # Validate input type: ensure it's a list.\n    if not isinstance(l, list):\n        raise InvalidInputError(\"Input must be a list.\")\n    \n    # Handle empty list.\n    if not l:\n        return None\n\n    # Validate elements: ensure all are numeric (int or float).\n    for item in l:\n        if not isinstance(item, (int, float)):\n            raise InvalidInputError(\"List contains non-numeric elements.\")\n\n    # Sort the list to find the median.\n    sorted_l = sorted(l)\n    n = len(sorted_l)\n\n    # Calculate median based on list length.\n    if n % 2 == 1:\n        # Odd number of elements.\n        return sorted_l[n // 2]\n    else:\n        # Even number of elements.\n        mid1 = sorted_l[n // 2 - 1]\n        mid2 = sorted_l[n // 2]\n        return (mid1 + mid2) / 2.0\n```"}
{"task_id": "HumanEval/63", "solution": "_fibfib_memo = {\n    0: 0,\n    1: 0,\n    2: 1\n}\n\ndef fibfib(n: int) -> int:\n    \"\"\"The FibFib number sequence is a sequence similar to the Fibbonacci sequnece that's defined as follows:\n    fibfib(0) == 0\n    fibfib(1) == 0\n    fibfib(2) == 1\n    fibfib(n) == fibfib(n-1) + fibfib(n-2) + fibfib(n-3).\n    Please write a function to efficiently compute the n-th element of the fibfib number sequence.\n    >>> fibfib(1)\n    0\n    >>> fibfib(5)\n    4\n    >>> fibfib(8)\n    24\n    \"\"\"\n    if n < 0:\n        raise ValueError(\"Input 'n' must be a non-negative integer.\")\n\n    if n in _fibfib_memo:\n        return _fibfib_memo[n]\n\n    # Calculate recursively and store in memo\n    result = fibfib(n - 1) + fibfib(n - 2) + fibfib(n - 3)\n    _fibfib_memo[n] = result\n    return result"}
{"task_id": "HumanEval/63", "solution": "```python\nimport functools\n\n@functools.lru_cache(maxsize=None)\ndef fibfib(n: int):\n    \"\"\"The FibFib number sequence is defined as fibfib(0)=0, fibfib(1)=0, fibfib(2)=1, and fibfib(n)=fibfib(n-1)+fibfib(n-2)+fibfib(n-3) for n > 2. This function efficiently computes the n-th element of the sequence.\"\"\"\n    \n    if not isinstance(n, int) or n < 0:\n        raise ValueError(\"Input 'n' must be a non-negative integer.\")\n\n    if n == 0:\n        return 0\n    elif n == 1:\n        return 0\n    elif n == 2:\n        return 1\n    else:\n        return fibfib(n - 1) + fibfib(n - 2) + fibfib(n - 3)\n```"}
{"task_id": "HumanEval/65", "solution": "```python\ndef circular_shift(x, shift):\n    \"\"\"Circular shift the digits of the integer x, shift the digits right by shift\n    and return the result as a string. If shift > number of digits, return digits reversed.\n    >>> circular_shift(12, 1)\n    \"21\"\n    >>> circular_shift(12, 2)\n    \"12\"\n    \"\"\"\n    if not isinstance(x, int) or not isinstance(shift, int):\n        raise TypeError(\"Both x and shift must be integers.\")\n\n    is_negative = x < 0\n    s = str(abs(x))\n    n = len(s)\n\n    if shift > n:\n        shifted_s = s[::-1]\n    else:\n        effective_shift = shift % n\n        shifted_s = s[-effective_shift:] + s[:-effective_shift]\n\n    return \"-\" + shifted_s if is_negative else shifted_s\n```"}
{"task_id": "HumanEval/64", "solution": "def vowels_count(s):\n    \"\"\"Write a function vowels_count which takes a string representing\n    a word as input and returns the number of vowels in the string.\n    Vowels in this case are 'a', 'e', 'i', 'o', 'u'. Here, 'y' is also a\n    vowel, but only when it is at the end of the given word.\n\n    Examples:\n    >>> vowels_count(\"abcde\")\n    2\n    >>> vowels_count(\"ACEDY\")\n    3\n    >>> vowels_count(\"\")\n    0\n    >>> vowels_count(\"rhythm\")\n    0\n    >>> vowels_count(\"aeiou\")\n    5\n    >>> vowels_count(\"Happy\")\n    2\n    >>> vowels_count(\"mystery\")\n    1\n    >>> vowels_count(\"Hello World\")\n    3\n    >>> vowels_count(\"y\")\n    1\n    >>> vowels_count(\"synonymy\")\n    3\n    >>> vowels_count(\"Programming is fun, Python is my favorite language\")\n    15\n    \"\"\"\n    count = 0\n    s_lower = s.lower()\n    n = len(s_lower)\n\n    for i, char in enumerate(s_lower):\n        if char in \"aeiou\":\n            count += 1\n        elif char == 'y' and i == n - 1:\n            count += 1\n    return count"}
