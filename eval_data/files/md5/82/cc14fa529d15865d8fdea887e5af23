{"task_id": "HumanEval/145", "solution": "```python\ndef order_by_points(nums):\n    \"\"\"\n    Write a function which sorts the given list of integers\n    in ascending order according to the sum of their digits.\n    Note: if there are several items with similar sum of their digits,\n    order them based on their index in original list.\n    \"\"\"\n\n    def _sum_digits(n: int) -> int:\n        \"\"\"Calculates the sum of the absolute value of digits for an integer.\"\"\"\n        s = 0\n        n_abs = abs(n)\n        while n_abs > 0:\n            s += n_abs % 10\n            n_abs //= 10\n        return s\n\n    if not nums:\n        return []\n\n    # Create a list of tuples: (digit_sum, original_index, original_value).\n    items_with_metadata = []\n    for i, num in enumerate(nums):\n        digit_sum = _sum_digits(num)\n        items_with_metadata.append((digit_sum, i, num))\n\n    # Sort the list of tuples based on the specified criteria.\n    items_with_metadata.sort()\n\n    # Extract the original values from the sorted items.\n    sorted_nums = [item[2] for item in items_with_metadata]\n\n    return sorted_nums\n```"}
{"task_id": "HumanEval/145", "solution": "```python\ndef order_by_points(nums: list[int]) -> list[int]:\n    \"\"\"\n    Sorts integers by the sum of their absolute digits (ascending),\n    then by original index (descending) for tie-breaking.\n    \"\"\"\n    if not nums:\n        return []\n\n    # Local cache to store previously calculated digit sums for efficiency.\n    digit_sum_cache = {}\n    def calculate_sum_of_absolute_digits(num: int) -> int:\n        if num in digit_sum_cache:\n            return digit_sum_cache[num]\n\n        abs_num = abs(num)\n        s = 0\n        for digit_char in str(abs_num):\n            s += int(digit_char)\n        digit_sum_cache[num] = s\n        return s\n\n    # Create a temporary list of tuples: (digit_sum, -original_index, original_value).\n    # The negative original_index is used to sort by original index in descending order for ties.\n    decorated_list = []\n    for i, num in enumerate(nums):\n        digit_sum = calculate_sum_of_absolute_digits(num)\n        decorated_list.append((digit_sum, -i, num))\n\n    # Sort the decorated list based on the tuple elements.\n    decorated_list.sort()\n\n    # Extract and return the original values in their new sorted order.\n    sorted_nums = [item[2] for item in decorated_list]\n    return sorted_nums\n```"}
{"task_id": "HumanEval/147", "solution": "def get_max_triples(n):\n    \"\"\"\n    You are given a positive integer n. You have to create an integer array a of length n.\n        For each i (1 \u2264 i \u2264 n), the value of a[i] = i * i - i + 1.\n        Return the number of triples (a[i], a[j], a[k]) of a where i < j < k, \n    and a[i] + a[j] + a[k] is a multiple of 3.\n\n    Example :\n        Input: n = 5\n        Output: 1\n        Explanation: \n        a = [1, 3, 7, 13, 21]\n        The only valid triple is (1, 7, 13).\n    \"\"\"\n    # Validate n: must be a positive integer as per FR1 and NFR3.\n    if not isinstance(n, int):\n        raise ValueError(\"Parameter 'n' must be an integer.\")\n    if n < 1:\n        raise ValueError(\"Parameter 'n' must be a positive integer (>= 1).\")\n\n    # Determine counts of a[x] % 3 for 0 and 1 (FR2).\n    # a[x] = x*x - x + 1\n    # Consider x % 3:\n    # If x % 3 == 0: a[x] % 3 = (0*0 - 0 + 1) % 3 = 1\n    # If x % 3 == 1: a[x] % 3 = (1*1 - 1 + 1) % 3 = 1\n    # If x % 3 == 2: a[x] % 3 = (2*2 - 2 + 1) % 3 = (4 - 2 + 1) % 3 = 3 % 3 = 0\n    # So, a[x] % 3 is 0 if x % 3 == 2, and 1 otherwise (for x % 3 == 0 or 1).\n    remainder_counts = {0: 0, 1: 0}\n    for x in range(1, n + 1):\n        if x % 3 == 2:\n            remainder_counts[0] += 1\n        else: # x % 3 == 0 or x % 3 == 1\n            remainder_counts[1] += 1\n\n    # Count valid triples (a[i], a[j], a[k]) such that (a[i] + a[j] + a[k]) % 3 == 0 (FR3).\n    # This occurs if:\n    # 1. All three a[x] % 3 are 0 (sum % 3 = 0 + 0 + 0 = 0).\n    # 2. All three a[x] % 3 are 1 (sum % 3 = 1 + 1 + 1 = 3 % 3 = 0).\n    # Other combinations like (0,1,2) are not possible as a[x]%3 is only 0 or 1.\n    count0 = remainder_counts.get(0, 0)\n    count1 = remainder_counts.get(1, 0)\n\n    total_triples = 0\n    # Case 1: (0, 0, 0) - choose 3 elements from those with remainder 0\n    if count0 >= 3:\n        total_triples += math.comb(count0, 3)\n    # Case 2: (1, 1, 1) - choose 3 elements from those with remainder 1\n    if count1 >= 3:\n        total_triples += math.comb(count1, 3)\n\n    # Return the total count (FR4).\n    return total_triples"}
{"task_id": "HumanEval/147", "solution": "def get_max_triples(n):\n    \"\"\"\n    Counts triples (a[i], a[j], a[k]) from a generated array 'a' such that i < j < k\n    and their sum is a multiple of 3. 'a[i] = i*i - i + 1'.\n    \"\"\"\n    if n < 1:\n        raise ValueError(\"Input n must be a positive integer.\")\n    if n < 3:\n        return 0\n\n    # Counts elements by their remainder modulo 3.\n    # For a[i] = i*(i-1) + 1, a[i] % 3 is either 0 (when i % 3 == 2) or 1 (when i % 3 == 0 or i % 3 == 1).\n    # Thus, only remainders 0 and 1 are possible.\n    counts = {0: 0, 1: 0} \n\n    for i in range(1, n + 1):\n        val = i * i - i + 1\n        counts[val % 3] += 1\n    \n    c0 = counts[0]\n    c1 = counts[1]\n    \n    triple_count = 0\n    \n    # Combinations of three elements whose remainders sum to a multiple of 3:\n    # 1. (0, 0, 0): All three elements have remainder 0.\n    if c0 >= 3:\n        triple_count += (c0 * (c0 - 1) * (c0 - 2)) // 6\n        \n    # 2. (1, 1, 1): All three elements have remainder 1.\n    if c1 >= 3:\n        triple_count += (c1 * (c1 - 1) * (c1 - 2)) // 6\n        \n    # Other combinations like (0, 1, 2) or (2, 2, 2) are not possible as there are no elements with remainder 2.\n    # Combinations like (0, 0, 1) or (0, 1, 1) do not sum to a multiple of 3.\n    return triple_count\n```"}
{"task_id": "HumanEval/148", "solution": "```python\nclass Planet:\n    def __init__(self, name: str, order: int):\n        self._name = name\n        self._order = order\n\n    @property\n    def name(self) -> str:\n        return self._name\n\n    @property\n    def order(self) -> int:\n        return self._order\n\nSOLAR_SYSTEM_PLANETS = [\n    Planet(\"Mercury\", 0),\n    Planet(\"Venus\", 1),\n    Planet(\"Earth\", 2),\n    Planet(\"Mars\", 3),\n    Planet(\"Jupiter\", 4),\n    Planet(\"Saturn\", 5),\n    Planet(\"Uranus\", 6),\n    Planet(\"Neptune\", 7),\n]\n\nclass PlanetService:\n    def __init__(self):\n        # Initializes the service with predefined planets and a lookup map.\n        self._planets = SOLAR_SYSTEM_PLANETS\n        self._planet_map = {planet.name: planet for planet in self._planets}\n\n    def find_planets_between(self, planet1_name: str, planet2_name: str) -> tuple[str, ...]:\n        # Finds planets between two specified planet names.\n        # Returns an empty tuple if any name is invalid or no planets are between.\n        planet1 = self._planet_map.get(planet1_name)\n        planet2 = self._planet_map.get(planet2_name)\n\n        if not planet1 or not planet2:\n            return ()\n\n        start_order = min(planet1.order, planet2.order)\n        end_order = max(planet1.order, planet2.order)\n\n        intermediate_planets = [\n            p.name for p in self._planets\n            if start_order < p.order < end_order\n        ]\n        return tuple(intermediate_planets)\n\n_planet_service = PlanetService()\n\ndef bf(planet1, planet2):\n    '''\n    There are eight planets in our solar system: the closerst to the Sun \n    is Mercury, the next one is Venus, then Earth, Mars, Jupiter, Saturn, \n    Uranus, Neptune.\n    Write a function that takes two planet names as strings planet1 and planet2. \n    The function should return a tuple containing all planets whose orbits are \n    located between the orbit of planet1 and the orbit of planet2, sorted by \n    the proximity to the sun. \n    The function should return an empty tuple if planet1 or planet2\n    are not correct planet names. \n    Examples\n    bf(\"Jupiter\", \"Neptune\") ==> (\"Saturn\", \"Uranus\")\n    bf(\"Earth\", \"Mercury\") ==> (\"Venus\")\n    bf(\"Mercury\", \"Uranus\") ==> (\"Venus\", \"Earth\", \"Mars\", \"Jupiter\", \"Saturn\")\n    '''\n    return _planet_service.find_planets_between(planet1, planet2)\n```"}
{"task_id": "HumanEval/148", "solution": "PLANETS = (\"Mercury\", \"Venus\", \"Earth\", \"Mars\", \"Jupiter\", \"Saturn\", \"Uranus\", \"Neptune\")\n\ndef bf(planet1: str, planet2: str) -> tuple[str, ...]:\n    \"\"\"\n    Returns a tuple of planet names located between the orbits of planet1 and planet2,\n    sorted by proximity to the Sun. Returns an empty tuple if either input planet is invalid.\n    \"\"\"\n    if planet1 not in PLANETS or planet2 not in PLANETS:\n        return ()\n\n    index1 = PLANETS.index(planet1)\n    index2 = PLANETS.index(planet2)\n\n    start_index = min(index1, index2)\n    end_index = max(index1, index2)\n\n    # Slice from start_index + 1 up to end_index (exclusive) to get intermediate planets.\n    return PLANETS[start_index + 1 : end_index]"}
{"task_id": "HumanEval/132", "solution": "```python\ndef is_nested(string: str) -> bool:\n    \"\"\"\n    Checks if a string of square brackets contains a valid nested subsequence.\n    A nested subsequence implies a structure like `[[...]]` within a balanced bracket sequence.\n    \"\"\"\n    open_brackets_count = 0\n    # max_depth_in_valid_segment tracks the maximum depth achieved within any part\n    # of the string that could potentially form a valid bracket sequence.\n    max_depth_in_valid_segment = 0\n\n    for char in string:\n        if char == '[':\n            open_brackets_count += 1\n            max_depth_in_valid_segment = max(max_depth_in_valid_segment, open_brackets_count)\n        elif char == ']':\n            if open_brackets_count > 0:\n                open_brackets_count -= 1\n            else:\n                # This ']' is unmatched. It invalidates any preceding potential nesting\n                # if it were to be part of the *same continuous valid subsequence*.\n                max_depth_in_valid_segment = 0\n                # open_brackets_count is already 0 here, so no need to reset.\n    \n    # After iterating, if there are still open brackets, the sequence is not truly balanced,\n    # and thus cannot contain a \"valid subsequence of brackets\" that is unclosed.\n    # Any max_depth achieved within such an unclosed segment is not considered valid for nesting.\n    if open_brackets_count > 0:\n        return False\n\n    return max_depth_in_valid_segment >= 2\n\n```"}
{"task_id": "HumanEval/149", "solution": "```python\ndef sorted_list_sum(lst):\n    \"\"\"Accepts a list of strings, removes those with odd lengths, and returns the rest sorted.\n    Sorting is by length ascending, then alphabetically ascending for equal-length strings.\n    \"\"\"\n    \n    # Filter out strings with odd lengths.\n    even_length_strings = [s for s in lst if len(s) % 2 == 0]\n\n    # Sort by length, then alphabetically.\n    even_length_strings.sort(key=lambda s: (len(s), s))\n\n    return even_length_strings\n```"}
{"task_id": "HumanEval/149", "solution": "```python\ndef _is_even_length(s: str) -> bool:\n    \"\"\"Checks if the length of a given string is even.\n    This helper function is used by sorted_list_sum for filtering.\n    \"\"\"\n    return len(s) % 2 == 0\n\ndef sorted_list_sum(lst: list[str]) -> list[str]:\n    \"\"\"Accepts a list of strings, deletes strings with odd lengths,\n    and returns the resulted list sorted by length then alphabetically for same-length words.\n    \"\"\"\n    # Filter out strings with odd lengths.\n    filtered_list = [s for s in lst if _is_even_length(s)]\n\n    # Sort the filtered list using length as primary key and string itself as secondary.\n    sorted_result = sorted(filtered_list, key=lambda s: (len(s), s))\n\n    return sorted_result\n```"}
