{"task_id": "HumanEval/154", "solution": "```python\ndef cycpattern_check(a, b):\n    \"\"\"Checks if the second word (b) or any of its rotations is a substring in the first word (a).\n    Generates rotations internally and searches for each.\n    \"\"\"\n\n    def generate_rotations(word):\n        \"\"\"Generates all unique cyclic rotations of a string.\n        Uses a set to ensure uniqueness of rotations.\n        \"\"\"\n        if not word:\n            return []\n        \n        rotations = set()\n        n = len(word)\n        for i in range(n):\n            rotated_word = word[i:] + word[:i]\n            rotations.add(rotated_word)\n        return list(rotations)\n\n    if not b: \n        # An empty pattern is considered a substring of any string.\n        return True\n    \n    if not a:\n        # A non-empty pattern cannot be a substring of an empty source.\n        return False\n\n    rotations = generate_rotations(b)\n    for rotation in rotations:\n        if rotation in a:\n            return True\n            \n    return False\n```"}
{"task_id": "HumanEval/154", "solution": "```python\nclass StringRotator:\n    \"\"\"Utility for generating all unique cyclic rotations of a string.\"\"\"\n    def generate_rotations(self, s: str) -> list[str]:\n        \"\"\"Generates a sorted list of all unique cyclic rotations of the input string.\"\"\"\n        if not s:\n            return [\"\"]\n        rotations = set()\n        n = len(s)\n        for i in range(n):\n            rotated_s = s[i:] + s[:i]\n            rotations.add(rotated_s)\n        return sorted(list(rotations))\n\nclass CycPatternChecker:\n    \"\"\"Orchestrates checking if any rotation of word_b is a substring of word_a.\"\"\"\n    def __init__(self, string_rotator: StringRotator):\n        \"\"\"Initializes the checker with a StringRotator instance for dependency injection.\"\"\"\n        self._string_rotator = string_rotator\n\n    def check(self, word_a: str, word_b: str) -> bool:\n        \"\"\"Determines if word_b or any of its rotations is a substring of word_a.\"\"\"\n        if not word_b: # An empty string is always a substring.\n            return True\n        \n        rotations = self._string_rotator.generate_rotations(word_b)\n        for rotation in rotations:\n            if rotation in word_a:\n                return True\n        return False\n\ndef cycpattern_check(a , b):\n    \"\"\"Checks if the second word or any of its rotations is a substring in the first word.\"\"\"\n    rotator = StringRotator()\n    checker = CycPatternChecker(rotator)\n    return checker.check(a, b)\n```"}
{"task_id": "HumanEval/155", "solution": "```python\ndef even_odd_count(num):\n    \"\"\"Counts even and odd digits in an integer, treating negative numbers by their absolute value.\n    Returns (even_count, odd_count), handling 0 as one even digit.\n    \"\"\"\n    if not isinstance(num, int):\n        raise TypeError(\"Input must be an integer.\")\n\n    even_count = 0\n    odd_count = 0\n\n    # Handle zero as a special case.\n    if num == 0:\n        return (1, 0)\n\n    # Convert to absolute value string to iterate through digits.\n    num_str = str(abs(num))\n\n    for digit_char in num_str:\n        digit = int(digit_char)\n        if digit % 2 == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n\n    return (even_count, odd_count)\n```"}
{"task_id": "HumanEval/146", "solution": "```python\ndef is_odd_digit(digit: int) -> bool:\n    \"\"\"Checks if a single digit is odd.\n    This handles digits from 0 to 9.\n    \"\"\"\n    return digit % 2 != 0\n\ndef get_last_digit(num: int) -> int:\n    \"\"\"Extracts the last digit of a number using its absolute value.\n    This ensures consistent behavior for both positive and negative numbers.\n    \"\"\"\n    return abs(num) % 10\n\ndef get_first_digit(num: int) -> int:\n    \"\"\"Extracts the first digit of a number by repeatedly dividing its absolute value by 10.\n    It returns the first digit, handling zero as a special case.\n    \"\"\"\n    val = abs(num)\n    if val == 0:\n        return 0\n    while val >= 10:\n        val //= 10\n    return val\n\ndef specialFilter(nums: list[int]) -> int:\n    \"\"\"Counts numbers in a list that are greater than 10 and have both odd first and last digits.\n    The function iterates through the input and applies the filtering criteria.\n    \"\"\"\n    count = 0\n    for num in nums:\n        if num > 10:\n            first_digit = get_first_digit(num)\n            last_digit = get_last_digit(num)\n            if is_odd_digit(first_digit) and is_odd_digit(last_digit):\n                count += 1\n    return count\n```"}
{"task_id": "HumanEval/155", "solution": "```python\nclass DigitUtils:\n    def __init__(self):\n        \"\"\"Constructor for DigitUtils.\"\"\"\n        pass\n\n    def is_even(self, digit: int) -> bool:\n        \"\"\"Checks if a single digit is even. Returns True if digit is even, False otherwise.\"\"\"\n        return digit % 2 == 0\n\n    def is_odd(self, digit: int) -> bool:\n        \"\"\"Checks if a single digit is odd. Returns True if digit is odd, False otherwise.\"\"\"\n        return digit % 2 != 0\n\nclass EvenOddCounter:\n    def __init__(self, digit_utils: DigitUtils = None):\n        \"\"\"Initializes the EvenOddCounter, optionally using a provided DigitUtils instance.\n        Creates a default DigitUtils if none is given.\"\"\"\n        self.digit_utils = digit_utils if digit_utils is not None else DigitUtils()\n\n    def count_digits(self, num: int) -> tuple[int, int]:\n        \"\"\"Counts even and odd digits in an integer. Returns a tuple (even_count, odd_count).\"\"\"\n        if num == 0:\n            return (1, 0) # Zero is a single even digit\n\n        even_count = 0\n        odd_count = 0\n        abs_num_str = str(abs(num))\n\n        for char_digit in abs_num_str:\n            digit = int(char_digit)\n            if self.digit_utils.is_even(digit):\n                even_count += 1\n            else:\n                odd_count += 1\n        return (even_count, odd_count)\n\ndef even_odd_count(num: int) -> tuple[int, int]:\n    \"\"\"Given an integer, return a tuple that has the number of even and odd digits respectively.\n\n     Example:\n        even_odd_count(-12) ==> (1, 1)\n        even_odd_count(123) ==> (1, 2)\n    \"\"\"\n    counter = EvenOddCounter()\n    return counter.count_digits(num)\n```"}
{"task_id": "HumanEval/156", "solution": "from typing import List, Tuple\n\nROMAN_MAP: List[Tuple[int, str]] = [\n    (1000, 'M'), (900, 'CM'), (500, 'D'), (400, 'CD'),\n    (100, 'C'), (90, 'XC'), (50, 'L'), (40, 'XL'),\n    (10, 'X'), (9, 'IX'), (5, 'V'), (4, 'IV'), (1, 'I')\n]\n\ndef _convert_to_roman(number: int) -> str:\n    \"\"\"\n    Performs the core Roman numeral conversion logic for a validated integer.\n    It constructs the uppercase Roman numeral string using a greedy algorithm.\n    \"\"\"\n    result = []\n    temp_num = number\n    for value, symbol in ROMAN_MAP:\n        while temp_num >= value:\n            result.append(symbol)\n            temp_num -= value\n    return \"\".join(result)\n\ndef int_to_mini_roman(number):\n    \"\"\"\n    Converts a positive integer (1-1000) into its lowercase Roman numeral equivalent.\n    Raises ValueError for inputs outside the specified range or non-integer types.\n    \"\"\"\n    if not isinstance(number, int) or not (1 <= number <= 1000):\n        raise ValueError(\"Input must be an integer between 1 and 1000.\")\n\n    roman_numeral = _convert_to_roman(number)\n    return roman_numeral.lower()"}
{"task_id": "HumanEval/158", "solution": "```python\ndef _count_unique_chars(word: str) -> int:\n    \"\"\"Helper function to count the number of unique characters in a string.\"\"\"\n    return len(set(word))\n\ndef find_max(words: list[str]) -> str:\n    \"\"\"\n    Accepts a list of strings. It returns the word with the maximum number\n    of unique characters, or the lexicographically smallest in case of a tie.\n    \"\"\"\n    if not words:\n        return \"\"\n\n    max_unique_count = -1\n    result_word = \"\"\n\n    for word in words:\n        current_unique_count = _count_unique_chars(word)\n\n        if current_unique_count > max_unique_count:\n            max_unique_count = current_unique_count\n            result_word = word\n        elif current_unique_count == max_unique_count:\n            # Tie-breaking: lexicographical order is applied.\n            if not result_word or word < result_word:\n                result_word = word\n    \n    return result_word\n```"}
{"task_id": "HumanEval/157", "solution": "```python\nimport math\nfrom typing import Any\n\nclass InputValidator:\n    \"\"\"Handles validation of input side lengths.\"\"\"\n\n    @staticmethod\n    def validate_sides(a: Any, b: Any, c: Any) -> None:\n        \"\"\"Validates that side lengths are numbers and positive.\"\"\"\n        for side in [a, b, c]:\n            if not isinstance(side, (int, float)):\n                raise TypeError(\"Side lengths must be numbers (int or float).\")\n            if side <= 0:\n                raise ValueError(\"Side lengths must be positive numbers.\")\n\n\nclass TriangleService:\n    \"\"\"Implements the core logic for right-angled triangle determination.\"\"\"\n\n    FLOAT_TOLERANCE: float = 1e-9\n\n    @staticmethod\n    def _is_close(val1: float, val2: float) -> bool:\n        \"\"\"Compares two float values with a tolerance.\"\"\"\n        return math.isclose(val1, val2, rel_tol=TriangleService.FLOAT_TOLERANCE)\n\n    @staticmethod\n    def is_right_angled(a: float, b: float, c: float) -> bool:\n        \"\"\"Determines if given sides form a right-angled triangle using sorted squares.\"\"\"\n        sides = sorted([a, b, c])\n        s1, s2, hypotenuse = sides[0], sides[1], sides[2]\n        return TriangleService._is_close(s1**2 + s2**2, hypotenuse**2)\n\n\ndef right_angle_triangle(a, b, c):\n    \"\"\"\n    Given three side lengths, returns True if they form a right-angled triangle, False otherwise.\n    Raises TypeError if inputs are not numbers, or ValueError if not positive.\n    \"\"\"\n    InputValidator.validate_sides(a, b, c)\n    return TriangleService.is_right_angled(a, b, c)\n```"}
{"task_id": "HumanEval/157", "solution": "def right_angle_triangle(a, b, c):\n    \"\"\"\n    Determines if three given side lengths form a right-angled triangle.\n    Raises ValueError if any side is not a positive number.\n    \"\"\"\n    EPSILON = 1e-9 # Small value for floating-point comparisons.\n\n    # Validate side lengths are positive.\n    if not (a > 0 and b > 0 and c > 0):\n        raise ValueError(\"Side lengths must be positive numbers.\")\n\n    # Check if a valid triangle can be formed using the triangle inequality theorem.\n    if not ((a + b > c) and (a + c > b) and (b + c > a)):\n        return False\n\n    # Sort sides to easily identify the potential hypotenuse.\n    sides = sorted([a, b, c])\n\n    # Apply Pythagorean theorem with epsilon for floating-point precision.\n    return abs(sides[0]**2 + sides[1]**2 - sides[2]**2) < EPSILON"}
{"task_id": "HumanEval/158", "solution": "```python\ndef _count_unique_chars(word: str) -> int:\n    \"\"\"\n    Counts the number of unique characters in a given string.\n    \"\"\"\n    return len(set(word))\n\ndef find_max(words: list[str]) -> str:\n    \"\"\"\n    Finds the word with the maximum unique characters, using lexicographical order for ties.\n    Returns an empty string if the input list is empty.\n    \"\"\"\n    if not isinstance(words, list):\n        raise TypeError(\"Input 'words' must be a list.\")\n\n    if not words:\n        return \"\"\n\n    max_unique_count = -1\n    result_word = \"\"\n\n    for word in words:\n        if not isinstance(word, str):\n            raise TypeError(f\"All elements in 'words' must be strings, but found type {type(word).__name__}.\")\n\n        current_unique_count = _count_unique_chars(word)\n\n        if current_unique_count > max_unique_count:\n            max_unique_count = current_unique_count\n            result_word = word\n        elif current_unique_count == max_unique_count:\n            if word < result_word:\n                result_word = word\n    return result_word\n```"}
{"task_id": "HumanEval/159", "solution": "```python\ndef eat(number, need, remaining):\n    \"\"\"\n    Calculates carrot consumption and remaining stock for a rabbit's meal.\n    Returns [total_eaten, remaining_stock] after the meal.\n    \"\"\"\n    MIN_CARROTS = 0\n    MAX_CARROTS = 1000\n\n    for value, name in [(number, \"number\"), (need, \"need\"), (remaining, \"remaining\")]:\n        if not isinstance(value, int):\n            raise ValueError(f\"'{name}' must be an integer.\")\n        if not (MIN_CARROTS <= value <= MAX_CARROTS):\n            raise ValueError(f\"'{name}' must be between {MIN_CARROTS} and {MAX_CARROTS} (inclusive).\")\n\n    eaten_this_meal = min(need, remaining)\n    total_eaten = number + eaten_this_meal\n    remaining_stock = remaining - eaten_this_meal\n\n    return [total_eaten, remaining_stock]\n```"}
{"task_id": "HumanEval/159", "solution": "def eat(number, need, remaining):\n    \"\"\"\n    You're a hungry rabbit, and you already have eaten a certain number of carrots,\n    but now you need to eat more carrots to complete the day's meals.\n    you should return an array of [ total number of eaten carrots after your meals,\n                                    the number of carrots left after your meals ]\n    if there are not enough remaining carrots, you will eat all remaining carrots, but will still be hungry.\n    \n    Example:\n    * eat(5, 6, 10) -> [11, 4]\n    * eat(4, 8, 9) -> [12, 1]\n    * eat(1, 10, 10) -> [11, 0]\n    * eat(2, 11, 5) -> [7, 0]\n    \n    Variables:\n    @number : integer\n        the number of carrots that you have eaten.\n    @need : integer\n        the number of carrots that you need to eat.\n    @remaining : integer\n        the number of remaining carrots thet exist in stock\n    \n    Constrain:\n    * 0 <= number <= 1000\n    * 0 <= need <= 1000\n    * 0 <= remaining <= 1000\n\n    Have fun :)\n    \"\"\"\n    class InvalidInputError(ValueError):\n        \"\"\"\n        Custom exception raised for invalid input parameters.\n        \"\"\"\n        def __init__(self, message: str):\n            super().__init__(message)\n            self.message = message\n\n    MIN_CARROTS: int = 0\n    MAX_CARROTS: int = 1000\n\n    for param_name, value in [(\"number\", number), (\"need\", need), (\"remaining\", remaining)]:\n        if not isinstance(value, int):\n            raise InvalidInputError(f\"'{param_name}' must be an integer.\")\n        if not (MIN_CARROTS <= value <= MAX_CARROTS):\n            raise InvalidInputError(\n                f\"'{param_name}' must be between {MIN_CARROTS} and {MAX_CARROTS} inclusive, but got {value}.\"\n            )\n\n    if remaining >= need:\n        total_eaten = number + need\n        carrots_left = remaining - need\n    else:\n        total_eaten = number + remaining\n        carrots_left = 0\n\n    return [total_eaten, carrots_left]"}
