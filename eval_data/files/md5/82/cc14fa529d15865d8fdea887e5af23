{"task_id": "HumanEval/75", "solution": "```python\n# Helper function to check if a number is prime.\ndef _is_prime(n: int) -> bool:\n    if n < 2:\n        return False\n    for i in range(2, int(n**0.5) + 1):\n        if n % i == 0:\n            return False\n    return True\n\n# Helper function to get all primes up to a given limit.\ndef _get_primes_up_to(limit: int) -> list[int]:\n    primes = []\n    for i in range(2, limit + 1):\n        if _is_prime(i):\n            primes.append(i)\n    return primes\n\ndef is_multiply_prime(a: int) -> bool:\n    \"\"\"Returns True if the given number is the multiplication of 3 prime numbers, False otherwise.\"\"\"\n    \"\"\"Handles input validation for type and range (1 < a < 100).\"\"\"\n    \n    if not isinstance(a, int):\n        raise TypeError(\"Input 'a' must be an integer.\")\n    if not (1 < a < 100):\n        raise ValueError(\"Input 'a' must be greater than 1 and less than 100.\")\n\n    # Primes needed for checking products up to 99.\n    # The largest possible prime factor is 23 (e.g., 2*2*23 = 92).\n    primes_for_check = _get_primes_up_to(25)\n\n    for p1 in primes_for_check:\n        for p2 in primes_for_check:\n            for p3 in primes_for_check:\n                product = p1 * p2 * p3\n                if product == a:\n                    return True\n                if product > a:\n                    # Optimization: If product exceeds 'a', further products with larger p3 will also exceed 'a'.\n                    break\n    return False\n```"}
{"task_id": "HumanEval/77", "solution": "```python\ndef iscube(a: int) -> bool:\n    \"\"\"\n    Checks if an integer `a` is a perfect cube.\n    Handles positive, negative, and zero inputs reliably.\n    \"\"\"\n    if a == 0:\n        return True\n\n    # Calculate the cube root of the absolute value.\n    # Rounding to the nearest integer helps mitigate floating point inaccuracies.\n    root = round(abs(a)**(1/3))\n\n    # Adjust the sign of the root if the original number was negative.\n    if a < 0:\n        root = -root\n\n    # Verify if cubing the integer root yields the original number.\n    return root * root * root == a\n```"}
{"task_id": "HumanEval/75", "solution": "```python\nimport math\nfrom itertools import combinations\n\ndef is_prime(n: int) -> bool:\n    \"\"\"Checks if a number is prime. Returns False for numbers less than 2.\"\"\"\n    if not isinstance(n, int) or n < 2:\n        return False\n    for i in range(2, int(math.sqrt(n)) + 1):\n        if n % i == 0:\n            return False\n    return True\n\ndef generate_primes_up_to(limit: int) -> list[int]:\n    \"\"\"Generates all prime numbers up to a given limit.\"\"\"\n    if not isinstance(limit, int) or limit < 1:\n        raise ValueError(\"Limit must be a positive integer.\")\n    primes = []\n    for num in range(2, limit + 1):\n        if is_prime(num):\n            primes.append(num)\n    return primes\n\ndef is_multiply_prime(a: int) -> bool:\n    \"\"\"Write a function that returns true if the given number is the multiplication of 3 prime numbers\n    and false otherwise.\n    Knowing that (a) is less then 100. \n    Example:\n    is_multiply_prime(30) == True\n    30 = 2 * 3 * 5\n    \"\"\"\n    if not isinstance(a, int):\n        raise ValueError(\"Input 'a' must be an integer.\")\n    if a < 1 or a >= 100:\n        raise ValueError(\"Input 'a' must be an integer between 1 and 99 (inclusive).\")\n\n    # The smallest product of three distinct primes is 2 * 3 * 5 = 30.\n    if a < 30:\n        return False\n\n    primes = generate_primes_up_to(a)\n    \n    for combo in combinations(primes, 3):\n        p1, p2, p3 = combo\n        if p1 * p2 * p3 == a:\n            return True\n    return False\n```"}
{"task_id": "HumanEval/76", "solution": "```python\nclass InvalidInputError(Exception):\n    \"\"\"Custom exception for invalid input parameters.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\n\ndef is_simple_power(x: int, n: int) -> bool:\n    \"\"\"\n    Checks if a number x is a simple power of n (n**k = x for integer k).\n    Handles input validation and specific edge cases as per the design.\n    \"\"\"\n    if not isinstance(x, int) or not isinstance(n, int):\n        raise InvalidInputError(\"Inputs x and n must be integers.\")\n    \n    if x < 1 or n < 1:\n        raise InvalidInputError(\"Inputs x and n must be greater than or equal to 1.\")\n\n    if x == 1:\n        # Any n >= 1 raised to the power of 0 is 1.\n        return True\n    \n    if n == 1 and x > 1:\n        # If n is 1, only 1^k = 1 is possible. If x > 1, it's not a simple power.\n        return False\n\n    # Iteratively divide x by n to check if it's a power, avoiding floating-point issues.\n    temp_x = x\n    while temp_x > 1:\n        if temp_x % n != 0:\n            return False\n        temp_x //= n\n    return temp_x == 1\n```\n"}
