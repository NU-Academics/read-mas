{"task_id": "HumanEval/142", "solution": "```python\ndef sum_squares(lst: list[int]) -> int:\n    \"\"\"\n    Calculates a sum from a list of integers, modifying elements based on their index.\n    Elements at indices divisible by 3 are squared; elements at indices divisible by 4 but not 3 are cubed.\n    \"\"\"\n    if not lst:\n        return 0\n\n    # Create a mutable copy to avoid modifying the original input list.\n    processed_list = list(lst)\n\n    for i, num in enumerate(processed_list):\n        if i % 3 == 0:\n            processed_list[i] = num * num\n        elif i % 4 == 0:  # This 'elif' ensures i is a multiple of 4 AND NOT a multiple of 3.\n            processed_list[i] = num * num * num\n        # Elements with indices not multiples of 3 or 4 remain unchanged.\n\n    return sum(processed_list)\n```"}
{"task_id": "HumanEval/141", "solution": "```python\ndef file_name_check(file_name):\n    \"\"\"Checks if a file name is valid according to specific rules.\n    Returns 'Yes' if valid, 'No' otherwise.\n    \"\"\"\n    \n    # Defines the list of allowed file extensions.\n    ALLOWED_EXTENSIONS = ['txt', 'exe', 'dll']\n\n    # Handles non-string input type.\n    if not isinstance(file_name, str):\n        return 'No'\n\n    # FR3: Check for exactly one dot.\n    if file_name.count('.') != 1:\n        return 'No'\n\n    # Split the file name into prefix and extension.\n    prefix, extension = file_name.split('.', 1)\n\n    # FR2: Count digits in the file name; must not exceed three.\n    digit_count = 0\n    for char in file_name:\n        if '0' <= char <= '9':  # Inline check for digit.\n            digit_count += 1\n    if digit_count > 3:\n        return 'No'\n\n    # FR4: Validate the prefix: not empty and starts with a letter.\n    if not prefix:  # Checks if prefix is empty.\n        return 'No'\n    first_char = prefix[0]\n    # Inline check for latin alphabet letter.\n    if not ('a' <= first_char <= 'z' or 'A' <= first_char <= 'Z'):\n        return 'No'\n\n    # FR5: Validate the extension against allowed list.\n    if extension not in ALLOWED_EXTENSIONS:\n        return 'No'\n\n    # FR6: All conditions are met, the file name is valid.\n    return 'Yes'\n```"}
{"task_id": "HumanEval/144", "solution": "```python\ndef gcd(a: int, b: int) -> int:\n    \"\"\"Calculates the greatest common divisor of two integers using the Euclidean algorithm.\"\"\"\n    while b:\n        a, b = b, a % b\n    return a\n\nclass Fraction:\n    \"\"\"Represents a mathematical fraction with integer numerator and denominator.\"\"\"\n    def __init__(self, numerator: int, denominator: int):\n        if denominator == 0:\n            raise ValueError(\"Denominator cannot be zero.\")\n        self.numerator = numerator\n        self.denominator = denominator\n        self._simplify()\n\n    def __mul__(self, other: 'Fraction') -> 'Fraction':\n        \"\"\"Multiplies this fraction by another Fraction object and returns a new, simplified fraction.\"\"\"\n        new_numerator = self.numerator * other.numerator\n        new_denominator = self.denominator * other.denominator\n        return Fraction(new_numerator, new_denominator)\n\n    def is_whole_number(self) -> bool:\n        \"\"\"Checks if the fraction represents a whole number (i.e., its denominator is 1 after simplification).\"\"\"\n        return self.denominator == 1\n\n    def _simplify(self) -> None:\n        \"\"\"Simplifies the fraction by dividing both numerator and denominator by their greatest common divisor.\"\"\"\n        common_divisor = gcd(self.numerator, self.denominator)\n        # Ensure positive numerator for consistency, though problem implies positive inputs.\n        # However, gcd might return 0 if one input is 0, which is handled by FractionService.\n        # This simplifies the fraction to its lowest terms.\n        self.numerator //= common_divisor\n        self.denominator //= common_divisor\n\n    def __repr__(self) -> str:\n        \"\"\"Returns a string representation of the fraction for debugging.\"\"\"\n        return f\"{self.numerator}/{self.denominator}\"\n\nclass FractionService:\n    \"\"\"Provides high-level operations related to fractions, including parsing strings and orchestrating simplification.\"\"\"\n    def parse_fraction(self, fraction_str: str) -> Fraction:\n        \"\"\"Parses a string in 'numerator/denominator' format into a Fraction object.\"\"\"\n        try:\n            parts = fraction_str.split('/')\n            if len(parts) != 2:\n                raise ValueError(\"Fraction string must be in 'numerator/denominator' format.\")\n            numerator = int(parts[0])\n            denominator = int(parts[1])\n            return Fraction(numerator, denominator)\n        except (ValueError, IndexError) as e:\n            raise ValueError(f\"Invalid fraction string '{fraction_str}': {e}\")\n\n    def simplify(self, x_str: str, n_str: str) -> bool:\n        \"\"\"Parses two fraction strings, multiplies them, and checks if the product is a whole number.\"\"\"\n        fraction_x = self.parse_fraction(x_str)\n        fraction_n = self.parse_fraction(n_str)\n\n        product_fraction = fraction_x * fraction_n\n        return product_fraction.is_whole_number()\n\n_fraction_service = FractionService()\n\ndef simplify(x, n):\n    \"\"\"Checks if the product of two fraction strings, x and n, is a whole number.\n    Returns True if x * n evaluates to a whole number and False otherwise.\n    \"\"\"\n    return _fraction_service.simplify(x, n)\n```"}
{"task_id": "HumanEval/143", "solution": "```python\nclass PrimeChecker:\n    \"\"\"Utility for checking if a number is prime.\"\"\"\n\n    def is_prime(self, n: int) -> bool:\n        \"\"\"Checks if the input integer n is a prime number.\n        A prime number is a natural number greater than 1 that has no positive divisors other than 1 and itself.\n        \"\"\"\n        if n < 2:\n            return False\n        for i in range(2, int(n**0.5) + 1):\n            if n % i == 0:\n                return False\n        return True\n\nclass WordFilterService:\n    \"\"\"Business logic for filtering words based on prime length.\"\"\"\n\n    def __init__(self, prime_checker: PrimeChecker):\n        \"\"\"Initializes the WordFilterService with a PrimeChecker instance.\"\"\"\n        self._prime_checker = prime_checker\n\n    def filter_words_by_prime_length(self, sentence: str) -> str:\n        \"\"\"Filters words from a sentence, keeping those with prime lengths.\n        The order of words is preserved.\n        \"\"\"\n        words = sentence.split()\n        filtered_words = []\n        for word in words:\n            if self._prime_checker.is_prime(len(word)):\n                filtered_words.append(word)\n        return \" \".join(filtered_words)\n\ndef words_in_sentence(sentence: str) -> str:\n    \"\"\"\n    You are given a string representing a sentence,\n    the sentence contains some words separated by a space,\n    and you have to return a string that contains the words from the original sentence,\n    whose lengths are prime numbers,\n    the order of the words in the new string should be the same as the original one.\n\n    Example 1:\n        Input: sentence = \"This is a test\"\n        Output: \"is\"\n\n    Example 2:\n        Input: sentence = \"lets go for swimming\"\n        Output: \"go for\"\n\n    Constraints:\n        * 1 <= len(sentence) <= 100\n        * sentence contains only letters\n    \"\"\"\n    prime_checker = PrimeChecker()\n    word_filter_service = WordFilterService(prime_checker)\n    return word_filter_service.filter_words_by_prime_length(sentence)\n```"}
{"task_id": "HumanEval/143", "solution": "import math\n\nclass PrimeChecker:\n    \"\"\"\n    Determines if an integer is prime, using memoization for performance.\n    Handles small numbers and efficiently checks larger ones.\n    \"\"\"\n    def __init__(self):\n        self._is_prime_memo = {\n            0: False,\n            1: False,\n            2: True,\n            3: True\n        }\n\n    def is_prime(self, n: int) -> bool:\n        \"\"\"\n        Checks if the given integer n is a prime number.\n        Returns True if n is prime, False otherwise.\n        \"\"\"\n        if n in self._is_prime_memo:\n            return self._is_prime_memo[n]\n\n        if n < 2 or n % 2 == 0 or n % 3 == 0:\n            self._is_prime_memo[n] = False\n            return False\n\n        # Check for factors from 5 onwards\n        i = 5\n        while i * i <= n:\n            if n % i == 0 or n % (i + 2) == 0:\n                self._is_prime_memo[n] = False\n                return False\n            i += 6\n\n        self._is_prime_memo[n] = True\n        return True\n\nclass PrimeWordFilterService:\n    \"\"\"\n    Coordinates the process of extracting words with prime lengths from a sentence.\n    Uses a PrimeChecker instance to determine primality of word lengths.\n    \"\"\"\n    def __init__(self, prime_checker: PrimeChecker):\n        self._prime_checker = prime_checker\n\n    def words_in_sentence(self, sentence: str) -> str:\n        \"\"\"\n        Filters words in a sentence, returning only those with prime lengths.\n        The original order of words is preserved.\n        \"\"\"\n        words = self._split_sentence(sentence)\n        filtered_words = self._filter_words_by_prime_length(words)\n        return \" \".join(filtered_words)\n\n    def _split_sentence(self, sentence: str) -> list[str]:\n        \"\"\"\n        Splits the input sentence string into a list of individual words.\n        Uses space as a delimiter and handles multiple spaces gracefully.\n        \"\"\"\n        return sentence.split()\n\n    def _filter_words_by_prime_length(self, words: list[str]) -> list[str]:\n        \"\"\"\n        Iterates through a list of words and returns a new list\n        containing only those words whose lengths are prime.\n        \"\"\"\n        prime_length_words = []\n        for word in words:\n            if self._prime_checker.is_prime(len(word)):\n                prime_length_words.append(word)\n        return prime_length_words\n\ndef words_in_sentence(sentence: str) -> str:\n    \"\"\"\n    Filters words from a sentence, retaining only those whose lengths are prime numbers.\n    The order of the filtered words is preserved from the original sentence.\n    \"\"\"\n    prime_checker = PrimeChecker()\n    filter_service = PrimeWordFilterService(prime_checker)\n    return filter_service.words_in_sentence(sentence)"}
