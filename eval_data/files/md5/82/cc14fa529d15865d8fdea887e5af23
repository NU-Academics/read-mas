{"task_id": "HumanEval/125", "solution": "```python\ndef split_words(txt):\n    \"\"\"\n    Splits text by whitespace, then by commas, or counts odd-ordered lowercase letters.\n    Handles empty strings and strings with only delimiters.\n    \"\"\"\n    if ' ' in txt:\n        return txt.split(' ')\n    elif ',' in txt:\n        return txt.split(',')\n    else:\n        count = 0\n        ALPHABET_OFFSET = ord('a')\n        for char in txt:\n            if 'a' <= char <= 'z':\n                order = ord(char) - ALPHABET_OFFSET\n                if order % 2 != 0:\n                    count += 1\n        return count\n```"}
{"task_id": "HumanEval/126", "solution": "```python\nfrom collections import Counter\n\ndef is_sorted(lst):\n    \"\"\"\n    Verifies if a list of non-negative integers is sorted in ascending order.\n    Also checks that no number appears more than twice.\n    \"\"\"\n    # Handle empty and single-element lists as per FR6.\n    if len(lst) <= 1:\n        return True\n\n    # Check if the list is sorted in ascending order as per FR1.\n    for i in range(len(lst) - 1):\n        if lst[i] > lst[i+1]:\n            return False # Not sorted, as per FR4.\n\n    # Check for valid duplicate counts (max 2 occurrences) as per FR2.\n    counts = Counter(lst)\n    for count in counts.values():\n        if count > 2:\n            return False # Too many duplicates, as per FR5.\n\n    # If both checks pass, the list is valid as per FR3.\n    return True\n```"}
{"task_id": "HumanEval/128", "solution": "```python\nfrom typing import List, Optional\n\ndef prod_signs(arr: List[int]) -> Optional[int]:\n    \"\"\"\n    Calculates the sum of magnitudes of integers multiplied by product of all signs.\n    Returns None for empty arr.\n    \"\"\"\n    if not arr:\n        return None\n\n    sign_product = 1\n    magnitude_sum = 0\n\n    for num in arr:\n        if num == 0:\n            sign_product = 0 # If any number is 0, the product of signs becomes 0.\n        elif num < 0:\n            if sign_product != 0: # Only update if product hasn't already become zero.\n                sign_product *= -1\n        # For positive numbers, the sign is 1, which doesn't change sign_product.\n\n        magnitude_sum += abs(num)\n\n    return sign_product * magnitude_sum\n```"}
{"task_id": "HumanEval/127", "solution": "import math\n\ndef intersection(interval1, interval2):\n    \"\"\"You are given two intervals,\n    where each interval is a pair of integers. For example, interval = (start, end) = (1, 2).\n    The given intervals are closed which means that the interval (start, end)\n    includes both start and end.\n    For each given interval, it is assumed that its start is less or equal its end.\n    Your task is to determine whether the length of intersection of these two \n    intervals is a prime number.\n    Example, the intersection of the intervals (1, 3), (2, 4) is (2, 3)\n    which its length is 1, which not a prime number.\n    If the length of the intersection is a prime number, return \"YES\",\n    otherwise, return \"NO\".\n    If the two intervals don't intersect, return \"NO\".\n\n\n    [input/output] samples:\n    intersection((1, 2), (2, 3)) ==> \"NO\"\n    intersection((-1, 1), (0, 4)) ==> \"NO\"\n    intersection((-3, -1), (-5, 5)) ==> \"YES\"\n    \"\"\"\n    def _is_prime(n: int) -> bool:\n        \"\"\"Checks if the input integer n is a prime number.\"\"\"\n        if n <= 1:\n            return False\n        if n == 2:\n            return True\n        if n % 2 == 0:\n            return False\n\n        for i in range(3, int(math.sqrt(n)) + 1, 2):\n            if n % i == 0:\n                return False\n        return True\n\n    start1, end1 = interval1\n    start2, end2 = interval2\n\n    intersect_start = max(start1, start2)\n    intersect_end = min(end1, end2)\n\n    if intersect_start > intersect_end:\n        return \"NO\"\n\n    length = intersect_end - intersect_start\n\n    if _is_prime(length):\n        return \"YES\"\n    else:\n        return \"NO\""}
{"task_id": "HumanEval/128", "solution": "```python\ndef prod_signs(arr):\n    \"\"\"\n    Calculates the sum of magnitudes multiplied by the product of signs for an array of integers.\n    Returns None for an empty array, otherwise an integer result.\n    \"\"\"\n    if not arr:\n        return None\n\n    # Calculate the sum of absolute values (magnitudes) of all integers.\n    sum_magnitudes = sum(abs(x) for x in arr)\n\n    # Calculate the product of signs for all integers.\n    product_signs = 1\n    for num in arr:\n        # Determine the sign: 1 for positive, -1 for negative, 0 for zero.\n        if num > 0:\n            sign = 1\n        elif num < 0:\n            sign = -1\n        else:\n            sign = 0\n        product_signs *= sign\n\n    # Multiply the sum of magnitudes by the product of signs.\n    return sum_magnitudes * product_signs\n```"}
{"task_id": "HumanEval/131", "solution": "```python\ndef digits(n: int) -> int:\n    \"\"\"Calculates the product of all odd digits in a positive integer `n`.\n    Returns 0 if no odd digits are found, meaning all digits are even.\n    \"\"\"\n    product = 1\n    found_odd_digit = False\n\n    current_n = n\n    while current_n > 0:\n        digit = current_n % 10\n        if digit % 2 != 0:\n            product *= digit\n            found_odd_digit = True\n        current_n //= 10\n\n    if not found_odd_digit:\n        return 0\n    else:\n        return product\n```"}
{"task_id": "HumanEval/130", "solution": "```python\ndef tri(n):\n    \"\"\"Calculates the first n+1 terms of a custom Tribonacci sequence using memoization.\n    Raises ValueError for negative input n.\n    \"\"\"\n    if n < 0:\n        raise ValueError(\"Input 'n' must be a non-negative integer.\")\n\n    _memo = {\n        0: 1,\n        1: 3\n    }\n\n    def _get_term(k):\n        \"\"\"Recursively calculates the k-th Tribonacci term, utilizing memoization.\"\"\"\n        if k in _memo:\n            return _memo[k]\n\n        if k % 2 == 0:  # k is even and k > 1 (base cases 0, 1 are in _memo)\n            result = 1 + k // 2\n        else:  # k is odd and k > 1\n            # For odd k, k+1 is even, so tri(k+1) is calculated using the even rule.\n            term_k_minus_1 = _get_term(k - 1)\n            term_k_minus_2 = _get_term(k - 2)\n            term_k_plus_1_calculated = 1 + (k + 1) // 2\n            result = term_k_minus_1 + term_k_minus_2 + term_k_plus_1_calculated\n\n        _memo[k] = result\n        return result\n\n    sequence = []\n    for k in range(n + 1):\n        sequence.append(_get_term(k))\n    return sequence\n```"}
{"task_id": "HumanEval/131", "solution": "```python\ndef digits(n: int) -> int:\n    \"\"\"Given a positive integer n, return the product of the odd digits.\n    Return 0 if all digits are even.\"\"\"\n    product = 1\n    has_odd_digit = False\n\n    # Convert the integer to its string representation to process each digit.\n    # This approach directly incorporates digit extraction logic.\n    for char_digit in str(n):\n        digit = int(char_digit)\n        if digit % 2 != 0:  # Check if the current digit is odd.\n            product *= digit\n            has_odd_digit = True\n\n    # Return the accumulated product if any odd digits were found, otherwise return 0.\n    return product if has_odd_digit else 0\n```"}
{"task_id": "HumanEval/132", "solution": "```python\ndef is_nested(string):\n    \"\"\"\n    Checks if the string contains a valid subsequence '[[]]'.\n    This pattern signifies at least one nested bracket.\n    \"\"\"\n    state = 0  # Tracks the progress of finding the '[[]]' subsequence.\n    for char in string:\n        if state == 0 and char == '[':\n            state = 1\n        elif state == 1 and char == '[':\n            state = 2\n        elif state == 2 and char == ']':\n            state = 3\n        elif state == 3 and char == ']':\n            return True\n    return False\n```"}
{"task_id": "HumanEval/129", "solution": "```python\nimport math\nfrom typing import List, Tuple\n\n# Type aliases as per design specification.\nGrid = List[List[int]]\nPath = List[int]\n\n# Global constant for directions (right, left, down, up).\nDIRECTIONS: List[Tuple[int, int]] = [(0, 1), (0, -1), (1, 0), (-1, 0)]\n\nclass MinPathSolver:\n    \"\"\"\n    Encapsulates the core logic for finding the lexicographically smallest path\n    of length k in a given grid using Depth-First Search with pruning.\n    \"\"\"\n    def __init__(self, grid: Grid, k: int):\n        self.grid = grid\n        self.N = len(grid)\n        self.k = k\n        # Stores the current lexicographically smallest path found.\n        self.min_path_found: Path = [math.inf] * k \n\n    def _is_valid_move(self, r: int, c: int) -> bool:\n        \"\"\"Checks if a given cell (r, c) is within the grid boundaries.\"\"\"\n        return 0 <= r < self.N and 0 <= c < self.N\n\n    def _dfs_search(self, r: int, c: int, current_path: Path):\n        \"\"\"\n        A recursive Depth-First Search helper function to explore paths.\n        It builds `current_path`, checks for path completion, and applies pruning.\n        \"\"\"\n        current_path.append(self.grid[r][c])\n\n        if len(current_path) == self.k:\n            if current_path < self.min_path_found:\n                # Update with a deep copy if the current path is lexicographically smaller.\n                self.min_path_found = list(current_path) \n            current_path.pop() # Backtrack from this path.\n            return\n\n        # Pruning: If `min_path_found` has been initialized and `current_path`\n        # is already lexicographically greater than or equal to the current best path's prefix,\n        # then this branch cannot lead to a smaller path.\n        if self.min_path_found[0] != math.inf:\n            if current_path >= self.min_path_found[:len(current_path)]:\n                current_path.pop()\n                return\n\n        for dr, dc in DIRECTIONS:\n            nr, nc = r + dr, c + dc\n            if self._is_valid_move(nr, nc):\n                # Recursively explore valid neighbors.\n                self._dfs_search(nr, nc, current_path)\n        \n        current_path.pop() # Backtrack (remove current cell from path).\n\n    def find_min_path(self) -> Path:\n        \"\"\"\n        Initiates the pathfinding process by iterating through all possible\n        starting cells and calling `_dfs_search` for each.\n        \"\"\"\n        for r_start in range(self.N):\n            for c_start in range(self.N):\n                # Start DFS from each cell in the grid.\n                self._dfs_search(r_start, c_start, [])\n        \n        return self.min_path_found\n\ndef minPath(grid: Grid, k: int) -> Path:\n    \"\"\"\n    Given a grid with N rows and N columns and a positive integer k,\n    find the lexicographically smallest path of length k in the grid.\n    \"\"\"\n    solver = MinPathSolver(grid, k)\n    return solver.find_min_path()\n\n```"}
{"task_id": "HumanEval/130", "solution": "```python\ndef tri(n: int) -> list[int]:\n    \"\"\"Calculates the Tribonacci sequence up to index n using custom rules.\n    It returns a list containing the first n+1 numbers of the sequence.\"\"\"\n    \n    if n < 0:\n        raise ValueError(\"Input 'n' must be a non-negative integer.\")\n\n    memo = {} # Stores computed Tribonacci numbers for memoization.\n\n    def _get_tribonacci_number_internal(k: int) -> int:\n        \"\"\"Computes the k-th Tribonacci number, utilizing memoization.\"\"\"\n        if k in memo:\n            return memo[k]\n\n        result: int\n        if k == 0:\n            result = 1\n        elif k == 1:\n            result = 3\n        elif k % 2 == 0:  # k is even\n            result = 1 + k // 2\n        else:  # k is odd\n            term_k_minus_1 = _get_tribonacci_number_internal(k - 1)\n            term_k_minus_2 = _get_tribonacci_number_internal(k - 2)\n            # tri(k+1) where k+1 is even, applying the even rule\n            term_k_plus_1 = 1 + (k + 1) // 2 \n            result = term_k_minus_1 + term_k_minus_2 + term_k_plus_1\n        \n        memo[k] = result\n        return result\n\n    sequence = []\n    for i in range(n + 1):\n        sequence.append(_get_tribonacci_number_internal(i))\n    \n    return sequence\n```"}
