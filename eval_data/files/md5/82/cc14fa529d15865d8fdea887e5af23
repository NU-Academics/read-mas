{"task_id": "HumanEval/94", "solution": "```python\nclass PrimeUtils:\n    @staticmethod\n    def is_prime(n: int) -> bool:\n        \"\"\"Checks if a given integer n is a prime number.\n        A prime number is a natural number greater than 1 that has no positive divisors other than 1 and itself.\n        \"\"\"\n        if n < 2:\n            return False\n        i = 2\n        while i * i <= n:\n            if n % i == 0:\n                return False\n            i += 1\n        return True\n\n    @staticmethod\n    def find_primes(lst: list[int]) -> list[int]:\n        \"\"\"Filters a list of integers, returning only the prime numbers.\n        It uses the is_prime method to check each number.\n        \"\"\"\n        return [n for n in lst if PrimeUtils.is_prime(n)]\n\nclass DigitUtils:\n    @staticmethod\n    def sum_digits(n: int) -> int:\n        \"\"\"Calculates the sum of the absolute value of the digits of an integer n.\n        Converts the number to a string to sum its digits.\n        \"\"\"\n        return sum(int(digit) for digit in str(abs(n)))\n\nclass LargestPrimeDigitSummer:\n    @staticmethod\n    def _validate_input(lst: list[int]) -> None:\n        \"\"\"Internal method to validate the type and content of the input list.\n        Raises TypeError or ValueError for invalid inputs.\n        \"\"\"\n        if not isinstance(lst, list):\n            raise TypeError(\"Input must be a list.\")\n        for item in lst:\n            if not isinstance(item, int):\n                raise ValueError(\"All elements in the list must be integers.\")\n\n    @staticmethod\n    def process(lst: list[int]) -> int:\n        \"\"\"Orchestrates finding the largest prime in a list and summing its digits.\n        Handles input validation and delegates to utility classes.\n        \"\"\"\n        LargestPrimeDigitSummer._validate_input(lst)\n\n        prime_numbers = PrimeUtils.find_primes(lst)\n\n        # If no primes are found, largest_prime is 0.\n        if not prime_numbers:\n            largest_prime = 0\n        else:\n            largest_prime = max(prime_numbers)\n\n        return DigitUtils.sum_digits(largest_prime)\n\ndef skjkasdkd(lst: list[int]) -> int:\n    \"\"\"You are given a list of integers.\n    You need to find the largest prime value and return the sum of its digits.\n    \"\"\"\n    return LargestPrimeDigitSummer.process(lst)\n```"}
{"task_id": "HumanEval/93", "solution": "```python\n# Constants for vowel lookup and alphabet manipulation.\nVOWELS = \"aeiouAEIOU\"\nALPHABET_LOWER = \"abcdefghijklmnopqrstuvwxyz\"\nALPHABET_UPPER = \"ABCDEFGHIJKLMNOPQRSTUVWXYZ\"\n\ndef encode(message: str) -> str:\n    \"\"\"\n    Encodes a message by swapping case of all letters and replacing all vowels\n    with the letter that appears 2 places ahead in the English alphabet.\n    \"\"\"\n    encoded_chars = []\n\n    def _swap_case_char(char: str) -> str:\n        \"\"\"Helper to swap the case of a single alphabetic character.\"\"\"\n        if 'a' <= char <= 'z':\n            return char.upper()\n        elif 'A' <= char <= 'Z':\n            return char.lower()\n        return char\n\n    def _replace_vowel_char(char: str) -> str:\n        \"\"\"Helper to replace a vowel with the letter two places ahead, maintaining case.\"\"\"\n        if char in VOWELS:\n            if 'a' <= char <= 'z':\n                idx = ALPHABET_LOWER.find(char)\n                return ALPHABET_LOWER[(idx + 2) % len(ALPHABET_LOWER)]\n            elif 'A' <= char <= 'Z':\n                idx = ALPHABET_UPPER.find(char)\n                return ALPHABET_UPPER[(idx + 2) % len(ALPHABET_UPPER)]\n        return char\n\n    for char in message:\n        swapped_char = _swap_case_char(char)\n        final_char = _replace_vowel_char(swapped_char)\n        encoded_chars.append(final_char)\n\n    return \"\".join(encoded_chars)\n```\n"}
