{"task_id": "HumanEval/137", "solution": "```python\nfrom typing import Union\n\ndef _parse_numeric_input(value: Union[int, float, str]) -> float:\n    \"\"\"Converts an input value to a float for numerical comparison.\n    It handles string parsing with ',' or '.' as decimal separators.\"\"\"\n    if isinstance(value, (int, float)):\n        return float(value)\n    elif isinstance(value, str):\n        try:\n            return float(value.replace(',', '.'))\n        except ValueError:\n            raise ValueError(f\"Cannot convert string '{value}' to a number.\")\n    else:\n        raise TypeError(f\"Unsupported type for comparison: {type(value)}\")\n\ndef compare_one(a: Union[int, float, str], b: Union[int, float, str]) -> Union[int, float, str, None]:\n    \"\"\"Compares two inputs and returns the larger variable in its original type, or None if equal.\n    String representations of numbers can use '.' or ',' as decimal separators.\"\"\"\n    numeric_a = _parse_numeric_input(a)\n    numeric_b = _parse_numeric_input(b)\n\n    if numeric_a == numeric_b:\n        return None\n    elif numeric_a > numeric_b:\n        return a\n    else:\n        return b\n```"}
{"task_id": "HumanEval/139", "solution": "```python\nimport math\n\ndef special_factorial(n: int) -> int:\n    \"\"\"Calculates the special factorial of a positive integer n.\n    This is n! * (n-1)! * ... * 1!.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"Input must be an integer.\")\n    if n <= 0:\n        raise ValueError(\"Input must be a positive integer.\")\n\n    result = 1\n    for i in range(1, n + 1):\n        result *= math.factorial(i)\n    return result\n```"}
{"task_id": "HumanEval/137", "solution": "```python\nfrom typing import Union\n\ndef compare_one(a, b):\n    \"\"\"\n    Compares two values (int, float, or string representing real numbers)\n    and returns the larger variable in its given variable type, or None if equal.\n    \"\"\"\n\n    def _to_float(value: Union[int, float, str]) -> float:\n        \"\"\"Converts value to float, handling comma as decimal. Raises ValueError for invalid strings.\"\"\"\n        if isinstance(value, str):\n            try:\n                # Replace comma with dot for consistent float conversion\n                normalized_value = value.replace(',', '.')\n                return float(normalized_value)\n            except ValueError:\n                raise ValueError(f\"Cannot convert string '{value}' to a float.\")\n        # Integers and floats can be directly converted to float.\n        return float(value)\n    \n    a_numeric = _to_float(a)\n    b_numeric = _to_float(b)\n\n    if a_numeric > b_numeric:\n        return a\n    elif b_numeric > a_numeric:\n        return b\n    else:  # a_numeric == b_numeric\n        return None\n```"}
{"task_id": "HumanEval/140", "solution": "```python\nimport re\n\ndef fix_spaces(text):\n    \"\"\"\n    Given a string text, replace all spaces in it with underscores, \n    and if a string has more than 2 consecutive spaces, \n    then replace all consecutive spaces with - \n    \n    fix_spaces(\"Example\") == \"Example\"\n    fix_spaces(\"Example 1\") == \"Example_1\"\n    fix_spaces(\" Example 2\") == \"_Example_2\"\n    fix_spaces(\" Example   3\") == \"_Example-3\"\n    \"\"\"\n    if not isinstance(text, str):\n        raise TypeError(\"Input must be a string.\")\n\n    # Replace 3+ consecutive spaces with a hyphen, ensuring precedence.\n    processed_text = re.sub(r' {3,}', '-', text)\n\n    # Replace all remaining single spaces with underscores.\n    processed_text = processed_text.replace(' ', '_')\n\n    return processed_text\n```"}
{"task_id": "HumanEval/139", "solution": "```python\nclass InvalidInputError(Exception):\n    \"\"\"Custom exception for invalid input parameters.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\n\ndef _factorial(k: int) -> int:\n    \"\"\"Calculates the standard factorial of a non-negative integer k.\n    This is a private helper function.\n    \"\"\"\n    if k < 0:\n        # This case is not expected to be hit by special_factorial due to loop range.\n        raise ValueError(\"Factorial is not defined for negative numbers.\")\n    if k == 0:\n        return 1\n    result = 1\n    for i in range(1, k + 1):\n        result *= i\n    return result\n\ndef special_factorial(n):\n    \"\"\"Calculates the special factorial (Brazilian factorial) of n.\n    special_factorial(n) = n! * (n-1)! * (n-2)! * ... * 1! for n > 0.\n    \"\"\"\n    if not isinstance(n, int) or n <= 0:\n        raise InvalidInputError(\"Input n must be a positive integer.\")\n\n    total_product = 1\n    # Iterate from 1 up to n, calculating factorial for each and multiplying.\n    for i in range(1, n + 1):\n        total_product *= _factorial(i)\n    return total_product\n```"}
{"task_id": "HumanEval/140", "solution": "import re\n\ndef fix_spaces(text: str) -> str:\n    \"\"\"\n    Given a string text, replace all spaces in it with underscores,\n    and if a string has more than 2 consecutive spaces,\n    then replace all consecutive spaces with -\n    \"\"\"\n    # First, replace sequences of three or more spaces with a single hyphen.\n    processed_text = re.sub(r' {3,}', '-', text)\n\n    # Then, replace any remaining single spaces (including those from '  ') with underscores.\n    final_text = processed_text.replace(' ', '_')\n\n    return final_text"}
{"task_id": "HumanEval/141", "solution": "```python\nimport string\n\ndef file_name_check(file_name):\n    \"\"\"Create a function which takes a string representing a file's name, and returns\n    'Yes' if the the file's name is valid, and returns 'No' otherwise.\n    This function validates a file name against several naming convention rules.\"\"\"\n\n    MAX_DIGITS_ALLOWED = 3\n    ALLOWED_EXTENSIONS = ['txt', 'exe', 'dll']\n\n    # FR1: Check digit count\n    digit_count = sum(1 for char in file_name if char.isdigit())\n    if digit_count > MAX_DIGITS_ALLOWED:\n        return 'No'\n\n    # FR2: Check for exactly one dot\n    if file_name.count('.') != 1:\n        return 'No'\n\n    # Split the file name into prefix and extension\n    parts = file_name.split('.')\n    prefix = parts[0]\n    extension = parts[1]\n\n    # FR3: Check prefix\n    if not prefix or prefix[0] not in string.ascii_letters:\n        return 'No'\n\n    # FR4: Check extension\n    if extension not in ALLOWED_EXTENSIONS:\n        return 'No'\n\n    # FR5: All conditions met\n    return 'Yes'\n```"}
