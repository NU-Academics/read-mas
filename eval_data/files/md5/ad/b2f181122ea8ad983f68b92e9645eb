{"task_id": "Mbpp/77", "solution": "import re\nimport uuid\nimport datetime\nclass InvalidNumberError(Exception):\n    \"\"\"Custom exception for invalid number input.\"\"\"\n    pass\nclass NumberCheckResult:\n    \"\"\"Represents the result of a divisibility check.\"\"\"\n    def __init__(self, id: uuid.UUID, input_str: str, value: int, divisible: bool, checked_at: datetime.datetime):\n        self.id = id\n        self.input_str = input_str\n        self.value = value\n        self.divisible = divisible\n        self.checked_at = checked_at\n\n    def to_dict(self) -> dict:\n        return {\n            \"id\": str(self.id),\n            \"input_str\": self.input_str,\n            \"value\": self.value,\n            \"divisible\": self.divisible,\n            \"checked_at\": self.checked_at.isoformat()\n        }\nclass ResultRepository:\n    \"\"\"Abstract base class for a repository to store check results.\"\"\"\n    def save(self, result: NumberCheckResult) -> None:\n        raise NotImplementedError\n\n    def list_all(self) -> list[NumberCheckResult]:\n        raise NotImplementedError\nclass InMemoryResultRepository(ResultRepository):\n    \"\"\"An in-memory implementation of the ResultRepository.\"\"\"\n    def __init__(self):\n        self._store: list[NumberCheckResult] = []\n\n    def save(self, result: NumberCheckResult) -> None:\n        self._store.append(result)\n\n    def list_all(self) -> list[NumberCheckResult]:\n        return self._store[:] # Return a shallow copy\nVALID_NUMERIC_PATTERN = re.compile(r'^[+-]?\\d+$')\nclass InputParser:\n    \"\"\"Parses various input types into a validated integer.\"\"\"\n    def parse(self, value) -> int:\n        s = self._normalize_input(value)\n        if not VALID_NUMERIC_PATTERN.match(s):\n            raise InvalidNumberError(f\"Invalid numeric value: {value!r}\")\n        return int(s)\n\n    def _normalize_input(self, value) -> str:\n        if isinstance(value, int):\n            return str(value)\n        if isinstance(value, str):\n            return value.strip()\n        raise InvalidNumberError(\"Unsupported type for numeric parsing; must be int or str.\")\nclass DivisibilityService:\n    \"\"\"Provides the core logic for checking divisibility by 11.\"\"\"\n    def is_divisible_by_11(self, n: int) -> bool:\n        if not isinstance(n, int):\n            raise TypeError(\"n must be an integer.\")\n        numeric_str = str(abs(n))\n        return self.is_divisible_by_11_str(numeric_str)\n\n    def is_divisible_by_11_str(self, numeric_str: str) -> bool:\n        diff = self._alternate_sum_diff(numeric_str)\n        return diff % 11 == 0\n\n    def _alternate_sum_diff(self, numeric_str: str) -> int:\n        # Computes the absolute difference between sums of alternating digits.\n        odd_sum = 0\n        even_sum = 0\n        for idx, ch in enumerate(reversed(numeric_str)):\n            digit = ord(ch) - 48 # Convert char digit to int\n            if (idx % 2) == 0:\n                odd_sum += digit\n            else:\n                even_sum += digit\n        return abs(odd_sum - even_sum)\n_default_repo = InMemoryResultRepository()\n_parser = InputParser()\n_service = DivisibilityService()\ndef is_Diff(value) -> bool:\n    \"\"\"\n    Checks if a number is divisible by 11 using the alternating digit sum difference method.\n    It supports integers and numeric strings, and persists the check result internally.\n    \"\"\"\n    v = _parser.parse(value)\n    res = _service.is_divisible_by_11(v)\n    record = NumberCheckResult(\n        id=uuid.uuid4(),\n        input_str=str(value),\n        value=v,\n        divisible=res,\n        checked_at=datetime.datetime.utcnow()\n    )\n    _default_repo.save(record)\n    return res"}
