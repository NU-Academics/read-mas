{"task_id": "Mbpp/98", "solution": "def multiply_num(nums):\n    \"\"\"\n    Multiplies all numbers in a sequence and divides by its length.\n    Assumes `nums` is a non-empty sequence of numeric values.\n    \"\"\"\n    product = 1.0\n    for num in nums:\n        product *= num\n    return product / len(nums)"}
{"task_id": "Mbpp/96", "solution": "def divisor(n: int) -> int:\n    \"\"\"\n    Calculates the number of positive divisors for a given integer n using prime factorization.\n    \"\"\"\n    def _prime_factors(num: int) -> dict[int, int]:\n        factors = {}\n        d = 2\n        temp = num\n        while d * d <= temp:\n            while temp % d == 0:\n                factors[d] = factors.get(d, 0) + 1\n                temp //= d\n            d += 1\n        if temp > 1:\n            factors[temp] = factors.get(temp, 0) + 1\n        return factors\n\n    def _divisor_count_from_factors(factors: dict[int, int]) -> int:\n        count = 1\n        for exponent in factors.values():\n            count *= (exponent + 1)\n        return count\n\n    # Handle the special case for n=1 as its prime factorization is empty or non-standard,\n    # but it has 1 divisor (itself).\n    if n == 1:\n        return 1\n\n    factors = _prime_factors(n)\n    return _divisor_count_from_factors(factors)"}
