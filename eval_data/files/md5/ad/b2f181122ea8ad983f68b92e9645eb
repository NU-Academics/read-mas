{"task_id": "Mbpp/235", "solution": "def even_bit_set_number(n: int) -> int:\n    \"\"\"\n    Sets all even-positioned bits (1-based index 2, 4, 6, ...) in the given number n.\n    This corresponds to setting bits at zero-based indices 1, 3, 5, etc.\n    \"\"\"\n    b = n.bit_length()\n    mask = 0\n    # Iterate through zero-based odd indices (1, 3, 5, ...) up to the bit length of n.\n    for i in range(1, b, 2):\n        mask |= (1 << i)\n    return n | mask"}
{"task_id": "Mbpp/239", "solution": "def get_total_number_of_sequences(m: int, n: int) -> int:\n    \"\"\"\n    Calculates the number of possible sequences of length n.\n    Each element is a positive integer, greater than or equal to twice the previous element, and less than or equal to m.\n    \"\"\"\n    # dp_prev[x] stores the number of sequences of the current length ending with x.\n    # Initialize for length 1: any number from 1 to m can be the first element.\n    dp_prev = [0] * (m + 1)\n    for x in range(1, m + 1):\n        dp_prev[x] = 1\n\n    # Iterate for lengths from 2 up to n, using rolling arrays to save memory.\n    for length in range(2, n + 1):\n        # Calculate prefix sums of dp_prev for O(1) range sum queries.\n        prefix_sum = [0] * (m + 1)\n        current_cumulative_sum = 0\n        for i in range(1, m + 1):\n            current_cumulative_sum += dp_prev[i]\n            prefix_sum[i] = current_cumulative_sum\n\n        # dp_curr will store the counts for the current length.\n        dp_curr = [0] * (m + 1)\n        for y in range(1, m + 1):\n            # The previous element x must satisfy 1 <= x and x <= y // 2.\n            max_possible_prev_val = y // 2\n            if max_possible_prev_val >= 1:\n                # The count is the sum of dp_prev[x] for x from 1 to max_possible_prev_val.\n                dp_curr[y] = prefix_sum[max_possible_prev_val]\n            # If max_possible_prev_val is 0, no such x exists, so count is 0.\n            else:\n                dp_curr[y] = 0\n        \n        # Move to the next length by updating dp_prev.\n        dp_prev = dp_curr\n    \n    # The total number of sequences of length n is the sum of all counts in dp_prev.\n    return sum(dp_prev)"}
{"task_id": "Mbpp/237", "solution": "def check_occurences(list_of_tuples):\n    \"\"\"\n    Takes a list of tuples and returns a dictionary mapping each unique tuple\n    (normalized by sorting its elements) to the number of times it occurs in the list.\n    \"\"\"\n    counts = {}\n\n    for original_tuple in list_of_tuples:\n        # Unpack the two elements from the tuple.\n        a, b = original_tuple\n\n        # Normalize the tuple by sorting its elements to ensure order-insensitivity.\n        # For example, (3, 1) and (1, 3) both normalize to (1, 3).\n        normalized_tuple = tuple(sorted((a, b)))\n\n        # Increment the count for the normalized tuple.\n        # If the tuple is encountered for the first time, its count starts at 0 before incrementing.\n        counts[normalized_tuple] = counts.get(normalized_tuple, 0) + 1\n\n    return counts"}
