{"task_id": "Mbpp/260", "solution": "import os\nimport json\nimport math\nfrom datetime import datetime\nfrom typing import List, Optional, Any, Dict, Iterator\nclass InvalidParameterError(Exception):\n    \"\"\"Raised when an invalid parameter is provided.\"\"\"\n    pass\nclass ComputationError(Exception):\n    \"\"\"Raised when a computation fails or exceeds limits.\"\"\"\n    pass\nclass NSWNumber:\n    \"\"\"Represents a Newman-Shanks-Williams sequence number.\"\"\"\n    def __init__(self, index: int, value: int):\n        self.index = index\n        self.value = value\n    def __repr__(self) -> str:\n        return f\"NSWNumber(index={self.index}, value={self.value})\"\nclass Config:\n    \"\"\"Central configuration for the NSW prime calculator.\"\"\"\n    DEFAULT_CACHE_PATH: str = os.path.join(os.path.expanduser(\"~\"), \".cache\", \"nswprime\", \"cache.json\")\n    DEFAULT_MAX_INDEX: int = 10000 \n    DEFAULT_CACHE_ENABLED: bool = True\n\n    @staticmethod\n    def get_cache_path() -> str:\n        \"\"\"Returns the configured cache file path.\"\"\"\n        return os.environ.get(\"NSW_CACHE_PATH\", Config.DEFAULT_CACHE_PATH)\n\n    @staticmethod\n    def get_max_index() -> int:\n        \"\"\"Returns the maximum sequence index to search.\"\"\"\n        return int(os.environ.get(\"NSW_MAX_INDEX\", str(Config.DEFAULT_MAX_INDEX)))\ndef ensure_int(x: Any) -> int:\n    \"\"\"Ensures input is an integer, raising an error if not.\"\"\"\n    if not isinstance(x, int):\n        try:\n            x = int(x)\n        except (ValueError, TypeError) as e:\n            raise InvalidParameterError(f\"Expected an integer, but got {type(x).__name__}\") from e\n    return x\ndef pow_mod(a: int, d: int, n: int) -> int:\n    \"\"\"Calculates (a^d) % n efficiently.\"\"\"\n    return pow(a, d, n)\ndef miller_rabin_bases_for_int(n: int) -> List[int]:\n    \"\"\"Provides deterministic Miller-Rabin bases for given integer size. The provided bases cover numbers up to 2^71.\"\"\"\n    return [2, 325, 9375, 28178, 450775, 9780504, 1795265022]\nclass NSWSequenceGenerator:\n    \"\"\"Generates Newman-Shanks-Williams sequence numbers.\"\"\"\n    def __init__(self, start_index: int = 0):\n        if start_index < 0:\n            raise InvalidParameterError(\"start_index must be >= 0\")\n        \n        self._s_n_minus_2 = 1 # Represents S(0)\n        self._s_n_minus_1 = 1 # Represents S(1)\n        self._current_index = 0 # Index of the next NSWNumber to be yielded\n\n        # Advance to start_index by calling __next__ repeatedly\n        for _ in range(start_index):\n            _ = self.__next__()\n    \n    def __iter__(self) -> Iterator['NSWNumber']:\n        \"\"\"Returns the generator itself for iteration.\"\"\"\n        return self\n\n    def __next__(self) -> 'NSWNumber':\n        \"\"\"Generates the next NSW number in the sequence.\"\"\"\n        if self._current_index == 0:\n            val = 1 # S(0) = 1\n        elif self._current_index == 1:\n            val = 1 # S(1) = 1\n        else:\n            # S(k) = 2 * S(k-1) + S(k-2)\n            val = 2 * self._s_n_minus_1 + self._s_n_minus_2\n            self._s_n_minus_2 = self._s_n_minus_1\n            self._s_n_minus_1 = val\n        \n        nsw_num = NSWNumber(self._current_index, val)\n        self._current_index += 1\n        return nsw_num\n\n    def nth(self, index: int) -> 'NSWNumber':\n        \"\"\"Computes the NSW number at the given index using recurrence.\"\"\"\n        if index < 0:\n            raise InvalidParameterError(\"Index must be non-negative.\")\n        if index == 0: return NSWNumber(0, 1)\n        if index == 1: return NSWNumber(1, 1)\n\n        s_0 = 1 # Represents S(k-2)\n        s_1 = 1 # Represents S(k-1)\n        for i in range(2, index + 1):\n            s_current = 2 * s_1 + s_0\n            s_0 = s_1\n            s_1 = s_current\n        return NSWNumber(index, s_1)\nclass PrimeChecker:\n    \"\"\"Provides functionality to check if a number is prime.\"\"\"\n    def __init__(self, deterministic: bool = True):\n        self.deterministic = deterministic\n\n    def _miller_rabin(self, n: int, bases: List[int]) -> bool:\n        \"\"\"Performs the Miller-Rabin primality test.\"\"\"\n        s = 0\n        d = n - 1\n        while d % 2 == 0:\n            d //= 2\n            s += 1\n\n        for a in bases:\n            if a >= n: # Base must be less than n\n                continue \n            x = pow_mod(a, d, n)\n            if x == 1 or x == n - 1:\n                continue\n            \n            for _ in range(s - 1):\n                x = pow_mod(x, 2, n)\n                if x == n - 1:\n                    break\n            else:\n                return False \n        return True\n\n    def is_prime(self, n: int) -> bool:\n        \"\"\"Checks if a given number is prime using Miller-Rabin.\"\"\"\n        if n < 2: return False\n        if n < 4: return True # 2, 3 are prime\n        if n % 2 == 0: return False # Even numbers > 2 are not prime\n        \n        # Small trial division for performance\n        for i in range(3, min(n, 101), 2): \n            if n % i == 0:\n                return False\n        if n < 101 * 101: # If n is less than 101^2 and not divisible by primes up to 100, it's prime\n            return True\n\n        # Use Miller-Rabin for larger numbers\n        bases = miller_rabin_bases_for_int(n) \n        return self._miller_rabin(n, bases)\nclass CacheRepository:\n    \"\"\"Manages persistence of computed NSW numbers and primes to a JSON file.\"\"\"\n    def __init__(self, path: str):\n        self.path = os.path.expanduser(path)\n        self._data: Dict[str, Any] = {\"by_index\": {}, \"primes\": [], \"meta\": {}}\n        self.load()\n\n    def load(self) -> Dict[str, Any]:\n        \"\"\"Loads cached data from the JSON file.\"\"\"\n        try:\n            if os.path.exists(self.path):\n                with open(self.path, 'r') as f:\n                    self._data = json.load(f)\n                    self._data.setdefault(\"by_index\", {})\n                    self._data.setdefault(\"primes\", [])\n                    self._data.setdefault(\"meta\", {})\n        except Exception:\n            # Log the error and continue with an empty cache\n            self._data = {\"by_index\": {}, \"primes\": [], \"meta\": {}}\n        return self._data\n\n    def get_by_index(self, index: int) -> Optional[int]:\n        \"\"\"Retrieves an NSW number value by its index from the cache.\"\"\"\n        return self._data.get(\"by_index\", {}).get(str(index))\n\n    def upsert(self, index: int, value: int) -> None:\n        \"\"\"Adds or updates an NSW prime in the cache and persists it.\"\"\"\n        current_time = datetime.utcnow().isoformat(timespec='seconds') + 'Z'\n        self._data.setdefault(\"by_index\", {})[str(index)] = value\n        \n        # Add to 'primes' list if not already present, maintaining sorted order\n        if not any(entry[\"index\"] == index for entry in self._data.get(\"primes\", [])):\n            self._data.setdefault(\"primes\", []).append({\"index\": index, \"value\": value})\n            self._data[\"primes\"].sort(key=lambda x: x[\"index\"])\n\n        self._data.setdefault(\"meta\", {})[\"updated_at\"] = current_time\n        if \"created_at\" not in self._data[\"meta\"]:\n            self._data[\"meta\"][\"created_at\"] = current_time\n        self._data[\"meta\"].setdefault(\"version\", \"1.0\")\n        self.save()\n\n    def save(self) -> None:\n        \"\"\"Saves the current cache data to the JSON file.\"\"\"\n        try:\n            os.makedirs(os.path.dirname(self.path), exist_ok=True)\n            with open(self.path, 'w') as f:\n                json.dump(self._data, f, indent=2)\n        except Exception:\n            # Log the error; computation can continue without persistence\n            pass\nclass NewmanShanksWilliamsPrimeService:\n    \"\"\"Orchestrates finding the nth Newman-Shanks-Williams prime.\"\"\"\n    def __init__(self, cache: 'CacheRepository', generator: 'NSWSequenceGenerator', checker: 'PrimeChecker'):\n        self.cache = cache\n        self.generator = generator\n        self.checker = checker\n\n    def get_nth_prime(self, n: int, max_index: Optional[int] = None) -> int:\n        \"\"\"Finds the NSW prime number at a specific index n.\"\"\"\n        n = ensure_int(n)\n        if n < 0:\n            raise InvalidParameterError(\"n must be a non-negative integer representing the NSW sequence index.\")\n        \n        # S(0)=1 and S(1)=1 are not primes (primes must be > 1)\n        if n == 0 or n == 1:\n            raise ComputationError(f\"S({n}) = 1 is not a prime number, cannot fulfill newman_prime({n}).\")\n\n        # Check cache for S(n) value\n        cached_value = self.cache.get_by_index(n)\n        if cached_value is not None:\n            if self.checker.is_prime(cached_value):\n                return cached_value\n            else:\n                raise ComputationError(f\"S({n}) = {cached_value} is not prime, cannot fulfill newman_prime({n}).\")\n\n        # Generate S(n) using the `nth` method for direct access\n        nsw_num = self.generator.nth(n)\n\n        # Check for max_index limit\n        max_index_val = Config.get_max_index() if max_index is None else ensure_int(max_index)\n        \n        if nsw_num.index > max_index_val:\n            raise ComputationError(f\"Index {nsw_num.index} exceeds maximum allowed index {max_index_val}.\")\n        \n        if self.checker.is_prime(nsw_num.value):\n            if Config.DEFAULT_CACHE_ENABLED:\n                self.cache.upsert(nsw_num.index, nsw_num.value)\n            return nsw_num.value\n        else:\n            raise ComputationError(f\"S({n}) = {nsw_num.value} is not a Newman-Shanks-Williams prime number.\")\n_default_cache = CacheRepository(Config.get_cache_path())\n_default_generator = NSWSequenceGenerator(start_index=0)\n_default_checker = PrimeChecker(deterministic=True)\n_default_service = NewmanShanksWilliamsPrimeService(_default_cache, _default_generator, _default_checker)\ndef newman_prime(n: int) -> int:\n    \"\"\"\n    Finds the Newman-Shanks-Williams prime number at the given sequence index 'n'.\n    \n    If S(n) is prime, its value is returned. Otherwise, a ComputationError is raised.\n    \"\"\"\n    return _default_service.get_nth_prime(n)"}
