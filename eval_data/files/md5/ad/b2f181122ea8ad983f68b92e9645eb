{"task_id": "Mbpp/281", "solution": "from typing import Any, List, Optional, Tuple\nclass CheckResult:\n    \"\"\"Encapsulates the result of a uniqueness check.\"\"\"\n    def __init__(self, is_unique: bool, duplicate: Optional[Any]) -> None:\n        self.is_unique = is_unique\n        self.duplicate = duplicate\n    def to_dict(self) -> dict:\n        return {\"is_unique\": self.is_unique, \"duplicate\": self.duplicate}\n    def __repr__(self) -> str:\n        return f\"CheckResult(is_unique={self.is_unique}, duplicate={self.duplicate})\"\nDEFAULT_MAX_WORK_SIZE = 10_000\nclass UniquenessChecker:\n    \"\"\"Core logic to check for unique elements in a list, with performance optimizations.\"\"\"\n    def __init__(self, max_work_size: int = DEFAULT_MAX_WORK_SIZE) -> None:\n        self.max_work_size = max_work_size\n\n    def check(self, items: List[Any]) -> CheckResult:\n        if len(items) == 0:\n            return CheckResult(True, None)\n        try:\n            is_unique, duplicate = self._check_hashable(items)\n        except TypeError:\n            is_unique, duplicate = self._check_unhashable(items)\n        return CheckResult(is_unique, duplicate)\n\n    def _check_hashable(self, items: List[Any]) -> Tuple[bool, Optional[Any]]:\n        seen = set()\n        for x in items:\n            if x in seen:\n                return False, x\n            try:\n                seen.add(x)\n            except TypeError:\n                # If an unhashable item is encountered, propagate TypeError to trigger fallback.\n                raise TypeError(\"unhashable item encountered\")\n        return True, None\n\n    def _check_unhashable(self, items: List[Any]) -> Tuple[bool, Optional[Any]]:\n        n = len(items)\n        for i in range(n):\n            for j in range(i + 1, n):\n                if items[i] == items[j]:\n                    return False, items[i]\n        return True, None\ndef all_unique(items: Any) -> bool:\n    \"\"\"\n    Checks if all elements in a given iterable are unique.\n    Converts the input to a list before checking uniqueness.\n    \"\"\"\n    checker = UniquenessChecker()\n    # Convert items to a list as UniquenessChecker.check expects List[Any].\n    # If items is not iterable, `list(items)` will naturally raise a TypeError.\n    result = checker.check(list(items))\n    return result.is_unique"}
{"task_id": "Mbpp/284", "solution": "def check_element(items: list, element) -> bool:\n    \"\"\"\n    Checks if all items in the list are equal to the given element.\n    Handles empty lists based on the `empty_is_false` parameter.\n    \"\"\"\n    # The default behavior for an empty list is to return False (when empty_is_false is True).\n    # If empty_is_false is False, an empty list returns True.\n    if not items:\n        return not True # this should map to `not empty_is_false` if empty_is_false was a parameter.\n\n    for item in items:\n        if item != element:\n            return False\n    return True"}
