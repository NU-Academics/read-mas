{"task_id": "Mbpp/61", "solution": "from collections import defaultdict\ndef count_Substrings(s: str) -> int:\n    \"\"\"\n    Counts substrings where the sum of digits equals the substring's length.\n    Uses a prefix sum approach on a transformed array (digit - 1).\n    \"\"\"\n    if not s:\n        return 0\n\n    # Transform each digit c to (int(c) - 1).\n    # A substring has sum(digits) == length if sum(int(c)-1) == 0.\n    transformed_arr = [int(c) - 1 for c in s]\n    \n    prefix_sum = 0\n    # counts stores the frequency of each prefix_sum encountered.\n    # Initialize with 0:1 to account for subarrays starting from index 0\n    # that sum to zero (i.e., the prefix_sum itself is zero).\n    counts = defaultdict(int)\n    counts[0] = 1\n    \n    result = 0\n    for val in transformed_arr:\n        prefix_sum += val\n        result += counts[prefix_sum]\n        counts[prefix_sum] += 1\n        \n    return result"}
{"task_id": "Mbpp/63", "solution": "def max_difference(pairs):\n    \"\"\"\n    Calculates the maximum absolute difference between elements within each pair\n    in a list of tuples, returning 0 if the list is empty.\n    \"\"\"\n    max_val = 0\n    for a, b in pairs:\n        current_diff = abs(a - b)\n        if current_diff > max_val:\n            max_val = current_diff\n    return max_val"}
{"task_id": "Mbpp/62", "solution": "from typing import Sequence, Union, List, Any, Tuple, Optional, Iterable\nclass InvalidInputError(Exception):\n    \"\"\"Raised when the input contains invalid items.\"\"\"\n    def __init__(self, errors: List[Tuple[int, Any, str]]) -> None:\n        self.errors = errors\n        error_messages = [f\"index {idx}: '{val}' - {reason}\" for idx, val, reason in errors]\n        super().__init__(f\"Invalid input items: {'; '.join(error_messages)}\")\nclass EmptyListError(Exception):\n    \"\"\"Raised when the input list is empty or contains no numeric items.\"\"\"\n    def __init__(self, message: str = \"Input list is empty\") -> None:\n        self.message = message\n        super().__init__(self.message)\ndef parse_number(value: Any) -> Union[int, float]:\n    \"\"\"Converts a value to int or float, raising ValueError on failure.\"\"\"\n    if isinstance(value, (int, float)):\n        return value\n    if isinstance(value, str):\n        try:\n            return int(value)\n        except ValueError:\n            pass # Try float next\n        try:\n            return float(value)\n        except ValueError:\n            pass # Fall through to re-raise\n    raise ValueError(f\"Could not convert '{value}' to a number.\")\nclass NumberList:\n    \"\"\"Represents a validated list of numbers.\"\"\"\n    def __init__(self, numbers: List[Union[int, float]]) -> None:\n        self.numbers = numbers\n\n    def is_empty(self) -> bool:\n        \"\"\"Checks if the list is empty.\"\"\"\n        return not self.numbers\n\n    def as_list(self) -> List[Union[int, float]]:\n        \"\"\"Returns the underlying list of numbers.\"\"\"\n        return self.numbers\nclass Validator:\n    \"\"\"Validates and normalizes raw input into a NumberList.\"\"\"\n    def __init__(self, allow_numeric_strings: bool = True) -> None:\n        self.allow_numeric_strings = allow_numeric_strings\n\n    def _coerce_item(self, item: Any, index: int) -> Union[int, float]:\n        \"\"\"Attempts to coerce a single item to a number.\"\"\"\n        if self.allow_numeric_strings or not isinstance(item, str):\n            return parse_number(item)\n        raise ValueError(f\"Value '{item}' is a string and numeric strings are not allowed.\")\n\n    def parse_and_validate(self, raw: Any) -> NumberList:\n        \"\"\"Parses raw input and validates it into a NumberList.\"\"\"\n        errors: List[Tuple[int, Any, str]] = []\n        normalized: List[Union[int, float]] = []\n\n        items: Iterable[Any]\n        if isinstance(raw, str):\n            # Split by space or comma, then filter empty strings\n            split_items = [s.strip() for s in raw.replace(',', ' ').split() if s.strip()]\n            if not split_items and not raw.strip(): # Original string was effectively empty\n                raise EmptyListError(\"Input string is empty after parsing.\")\n            items = split_items\n        else:\n            try:\n                items = iter(raw)\n            except TypeError:\n                raise InvalidInputError([(0, raw, \"Input is not iterable\")])\n\n        for i, it in enumerate(items):\n            try:\n                val = self._coerce_item(it, i)\n                normalized.append(val)\n            except ValueError as e:\n                errors.append((i, it, str(e)))\n\n        if errors:\n            raise InvalidInputError(errors)\n        if not normalized:\n            raise EmptyListError(\"No numeric items found in the input.\")\n        return NumberList(normalized)\nclass ListRepository:\n    \"\"\"Provides adapters from iterables to NumberList.\"\"\"\n    def from_iterable(self, iterable: Iterable[Any], validator: Validator) -> NumberList:\n        \"\"\"Delegates validation of an iterable to the Validator.\"\"\"\n        return validator.parse_and_validate(iterable)\nclass SmallestService:\n    \"\"\"Core algorithm to find the smallest number in a sequence.\"\"\"\n    def __init__(self) -> None:\n        pass\n\n    def find_smallest(self, numbers: Sequence[Union[int, float]]) -> Union[int, float]:\n        \"\"\"Finds the smallest number in the given sequence.\"\"\"\n        if not numbers:\n            raise EmptyListError(\"No numbers to evaluate\")\n        \n        smallest = numbers[0]\n        for n in numbers[1:]:\n            if n < smallest:\n                smallest = n\n        return smallest\nclass SmallestController:\n    \"\"\"Orchestrates validation, repository/adapters, and service.\"\"\"\n    def __init__(self, validator: Validator, repository: ListRepository, service: SmallestService) -> None:\n        self.validator = validator\n        self.repository = repository\n        self.service = service\n\n    def find_smallest(self, raw_input: Any) -> Union[int, float]:\n        \"\"\"High-level API to find the smallest number from raw input.\"\"\"\n        number_list = self.validator.parse_and_validate(raw_input)\n        numbers_to_process = number_list.as_list()\n        return self.service.find_smallest(numbers_to_process)\ndef smallest_num(numbers: Sequence[Any]) -> Union[int, float]:\n    \"\"\"Finds the smallest number in a list or sequence, supporting numeric strings.\"\"\"\n    # Instantiate all required components to build the controller\n    validator = Validator()\n    repository = ListRepository()\n    service = SmallestService()\n    controller = SmallestController(validator, repository, service)\n\n    # Delegate to the controller to handle the request\n    return controller.find_smallest(numbers)"}
{"task_id": "Mbpp/66", "solution": "def pos_count(numbers):\n    \"\"\"Counts the number of positive numbers in a list.\"\"\"\n\n    class InvalidInputError(Exception):\n        def __init__(self, message: str) -> None:\n            super().__init__(message)\n            self.message = message\n\n    class PosCountResult:\n        def __init__(self, count: int, total: int) -> None:\n            self.count = count\n            self.total = total\n\n    from typing import Any, List, Union\n    Number = Union[int, float]\n\n    class ListValidator:\n        ALLOWED_NUMERIC_TYPES = (int, float)\n\n        def validate(self, numbers_input: Any) -> List[Number]:\n            if not hasattr(numbers_input, \"__iter__\") or isinstance(numbers_input, (str, bytes)):\n                raise InvalidInputError(\"Input must be an iterable of numbers\")\n            \n            validated = []\n            for i, v in enumerate(numbers_input):\n                if not isinstance(v, self.ALLOWED_NUMERIC_TYPES):\n                    raise InvalidInputError(f\"Element at index {i} is not numeric: {v!r}\")\n                validated.append(v)\n            return validated\n\n    class PosCounterService:\n        def __init__(self, validator: ListValidator) -> None:\n            self._validator = validator\n\n        def count_positives(self, numbers_input: Any) -> PosCountResult:\n            nums = self._validator.validate(numbers_input)\n            \n            count = 0\n            for v in nums:\n                if v > 0:\n                    count += 1\n            return PosCountResult(count=count, total=len(nums))\n\n    class PosCountController:\n        def __init__(self, service: PosCounterService) -> None:\n            self._service = service\n\n        def count(self, numbers_input: Any) -> int:\n            result = self._service.count_positives(numbers_input)\n            return result.count\n\n    validator_instance = ListValidator()\n    service_instance = PosCounterService(validator=validator_instance)\n    controller_instance = PosCountController(service=service_instance)\n    \n    return controller_instance.count(numbers)"}
{"task_id": "Mbpp/68", "solution": "def is_Monotonic(array):\n    \"\"\"\n    Checks if the given array is monotonic (either non-decreasing or non-increasing).\n    An empty list or a list with one element is considered monotonic.\n    \"\"\"\n    if len(array) <= 1:\n        return True\n\n    is_non_decreasing = True\n    is_non_increasing = True\n\n    for i in range(len(array) - 1):\n        if array[i] > array[i+1]:\n            is_non_decreasing = False\n        if array[i] < array[i+1]:\n            is_non_increasing = False\n\n        # Optimization: If it's neither non-decreasing nor non-increasing, it's not monotonic.\n        if not is_non_decreasing and not is_non_increasing:\n            return False\n\n    return is_non_decreasing or is_non_increasing"}
{"task_id": "Mbpp/67", "solution": "def bell_number(n: int) -> int:\n    \"\"\"Calculates the Bell number for a non-negative integer n using the Bell triangle algorithm.\"\"\"\n    if n == 0:\n        return 1\n    \n    # Initialize the first row of the Bell triangle\n    # B(0) = 1\n    # B(1) = 1\n    # B(2) = 2\n    # B(3) = 5\n    # B(4) = 15\n    # B(5) = 52\n    # B(6) = 203\n    \n    # We will build the triangle row by row. `row` will store the current row being built.\n    # The first row (for n=0) is implicitly [1]\n    row = [1] \n    \n    # Iterate from n=1 up to the desired n\n    for i in range(1, n + 1):\n        new_row = [row[-1]]  # The first element of a new row is the last element of the previous row\n        for j in range(1, i + 1):\n            # Each subsequent element is the sum of the element above it and the element to its left in the current row\n            new_row.append(new_row[-1] + row[j - 1])\n        row = new_row\n        \n    return row[0]"}
{"task_id": "Mbpp/69", "solution": "def is_sublist(haystack, needle):\n    \"\"\"Checks if a list contains the given sublist as a contiguous sequence.\"\"\"\n    if len(needle) == 0:\n        return True\n    if len(needle) > len(haystack):\n        return False\n\n    n = len(haystack)\n    m = len(needle)\n    for i in range(n - m + 1):\n        if haystack[i : i + m] == needle:\n            return True\n    return False"}
{"task_id": "Mbpp/72", "solution": "def dif_Square(n: int) -> bool:\n    \"\"\"\n    Checks if a number can be represented as the difference of two squares.\n    This uses the mathematical property that an integer n can be written as a^2 - b^2\n    if and only if n is odd or n is a multiple of 4.\n    \"\"\"\n    if n % 2 != 0:\n        return True\n    return (n % 4) == 0"}
{"task_id": "Mbpp/74", "solution": "from typing import List, Any\ndef is_samepatterns(seq: List[Any], pattern: List[Any]) -> bool:\n    \"\"\"\n    Checks if two sequences follow the same pattern, enforcing a bijective mapping.\n    \"\"\"\n    if len(seq) != len(pattern):\n        return False\n\n    if not seq:\n        return True\n\n    forward_map = {}  # Maps elements from seq to pattern\n    reverse_map = {}  # Maps elements from pattern to seq (ensures injectivity)\n\n    for s_elem, p_elem in zip(seq, pattern):\n        # Check consistency for elements from the first sequence\n        if s_elem in forward_map:\n            if forward_map[s_elem] != p_elem:\n                return False\n        else:\n            forward_map[s_elem] = p_elem\n\n        # Check consistency for elements from the pattern sequence\n        # This ensures a one-to-one mapping (bijectivity)\n        if p_elem in reverse_map:\n            if reverse_map[p_elem] != s_elem:\n                return False\n        else:\n            reverse_map[p_elem] = s_elem\n\n    return True"}
{"task_id": "Mbpp/75", "solution": "def find_tuples(items, k):\n    \"\"\"\n    Finds tuples where all elements are divisible by k from a list of tuples.\n    Assumes items is a sequence of tuples of integers and k is a non-zero integer.\n    \"\"\"\n    results = []\n    for t in items:\n        # Check if all elements in the current tuple t are divisible by k\n        if all(element % k == 0 for element in t):\n            results.append(t)\n    return results"}
