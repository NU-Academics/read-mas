{"task_id": "Mbpp/283", "solution": "import collections\ndef validate(integer: int) -> bool:\n    \"\"\"\n    Checks whether the frequency of each digit in the integer is less than or equal to the digit itself.\n    The sign of the integer is ignored for digit counting.\n    \"\"\"\n    s = str(integer)\n    if s.startswith('-'):\n        s = s[1:]\n\n    digit_frequencies = collections.Counter(s)\n\n    for digit_char, frequency in digit_frequencies.items():\n        digit_value = int(digit_char)\n        if frequency > digit_value:\n            return False\n            \n    return True"}
{"task_id": "Mbpp/290", "solution": "from typing import List, Any, Optional, Tuple\ndef max_length(lists: List[List[Any]]) -> Tuple[int, Optional[List[Any]]]:\n    \"\"\"\n    Finds the list with the maximum length in a list of lists.\n    Returns a tuple containing the maximum length and the first list found with that length.\n    \"\"\"\n    max_len = 0\n    result_list = None\n\n    for inner_list in lists:\n        # Convert any list-like sequence (e.g., tuple) to a list for consistent return type\n        # and length calculation.\n        current_list = list(inner_list)\n        current_len = len(current_list)\n\n        if current_len > max_len:\n            max_len = current_len\n            result_list = current_list\n            \n    return max_len, result_list"}
{"task_id": "Mbpp/285", "solution": "import re\nimport abc\nfrom typing import Optional, Tuple, Dict, Any\nclass InvalidInputError(Exception):\n    \"\"\"Raised when an input is invalid.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\nclass PatternNotFoundError(Exception):\n    \"\"\"Raised when a requested pattern is not found.\"\"\"\n    def __init__(self, pattern_name: str):\n        super().__init__(f\"Pattern '{pattern_name}' not found.\")\n        self.pattern_name = pattern_name\nclass MatchMetadata:\n    \"\"\"Stores the start and end indices of a match.\"\"\"\n    def __init__(self, start: int, end: int) -> None:\n        self.start = start\n        self.end = end\nclass MatchResult:\n    \"\"\"Encapsulates the result of a match operation.\"\"\"\n    def __init__(self, matched: bool, metadata: Optional[MatchMetadata] = None) -> None:\n        self.matched = matched\n        self.metadata = metadata\nclass PatternRepository(abc.ABC):\n    \"\"\"Abstract base class for pattern repositories.\"\"\"\n    @abc.abstractmethod\n    def get_pattern(self, name: str) -> str:\n        pass\nDEFAULT_PATTERNS: Dict[str,str] = {\"a_followed_by_two_or_three_b\": r\"ab{2,3}\"}\nclass InMemoryPatternRepository(PatternRepository):\n    \"\"\"Provides regex patterns from an in-memory dictionary.\"\"\"\n    def __init__(self, patterns: Optional[Dict[str,str]] = None) -> None:\n        self._patterns = dict(DEFAULT_PATTERNS)\n        if patterns:\n            self._patterns.update(patterns)\n\n    def get_pattern(self, name: str) -> str:\n        \"\"\"Retrieves a pattern by its name.\"\"\"\n        try:\n            return self._patterns[name]\n        except KeyError:\n            raise PatternNotFoundError(name)\nclass RegexUtils:\n    \"\"\"Utility class for regex operations.\"\"\"\n    def compile(self, pattern: str, flags: int = 0) -> re.Pattern:\n        \"\"\"Compiles a regex pattern.\"\"\"\n        return re.compile(pattern, flags)\n\n    def find_first(self, pattern: str, text: str) -> Optional[Tuple[int,int]]:\n        \"\"\"Finds the first occurrence of a pattern in text.\"\"\"\n        try:\n            p = self.compile(pattern)\n            m = p.search(text)\n            return (m.start(), m.end()) if m else None\n        except re.error as e:\n            raise InvalidInputError(f\"Invalid pattern: {e}\")\nclass TextMatcherService:\n    \"\"\"Handles the core business logic for text matching.\"\"\"\n    def __init__(self, pattern_repo: PatternRepository, regex_utils: RegexUtils, pattern_name: str = \"a_followed_by_two_or_three_b\") -> None:\n        self._pattern_repo = pattern_repo\n        self._regex_utils = regex_utils\n        self._pattern_name = pattern_name\n\n    def matches(self, text: str) -> MatchResult:\n        \"\"\"Checks if the text matches the configured pattern.\"\"\"\n        pattern = self._pattern_repo.get_pattern(self._pattern_name)\n        span = self._regex_utils.find_first(pattern, text)\n        if span:\n            metadata = MatchMetadata(start=span[0], end=span[1])\n            return MatchResult(matched=True, metadata=metadata)\n        return MatchResult(matched=False, metadata=None)\ndef text_match_two_three(text: str) -> bool:\n    \"\"\"\n    Checks whether a string contains the 'a' character followed by two or three 'b' characters.\n    Uses an internal service to perform the regex matching.\n    \"\"\"\n    repo = InMemoryPatternRepository()\n    utils = RegexUtils()\n    service = TextMatcherService(repo, utils)\n    return service.matches(text).matched"}
{"task_id": "Mbpp/286", "solution": "def max_sub_array_sum_repeated(arr: list[int], n: int, k: int) -> int:\n    \"\"\"\n    Finds the largest sum of a contiguous array in the modified array formed by repeating the given array k times.\n    The algorithm handles cases where the total sum is positive or non-positive.\n    \"\"\"\n    \n    # Kadane's algorithm to find the maximum subarray sum in a single array\n    # This also serves as the base case for max_prefix_sum and max_suffix_sum when initializing with array elements\n    max_so_far = arr[0]\n    current_max = arr[0]\n    for x in arr[1:]:\n        current_max = max(x, current_max + x)\n        max_so_far = max(max_so_far, current_max)\n    single_max_subarray_sum = max_so_far\n\n    if k == 1:\n        return single_max_subarray_sum\n\n    # Calculate maximum prefix sum\n    max_prefix_sum = float('-inf')\n    current_sum = 0\n    for x in arr:\n        current_sum += x\n        max_prefix_sum = max(max_prefix_sum, current_sum)\n\n    # Calculate maximum suffix sum\n    max_suffix_sum = float('-inf')\n    current_sum = 0\n    for i in range(len(arr) - 1, -1, -1):\n        current_sum += arr[i]\n        max_suffix_sum = max(max_suffix_sum, current_sum)\n\n    # Calculate total sum of the array\n    total_array_sum = sum(arr)\n\n    # Determine the maximum sum for repeated arrays\n    if total_array_sum > 0:\n        # If total sum is positive, repeating the array multiple times can increase the sum.\n        # The optimal sum involves max suffix from first array, (k-2) full array sums, and max prefix from last array.\n        # This formula handles k=2 correctly as well (k-2=0).\n        repeated_sum_candidate = max_suffix_sum + total_array_sum * (k - 2) + max_prefix_sum\n    else:\n        # If total sum is zero or negative, repeating full arrays won't improve the sum beyond\n        # simply combining the best suffix of one array with the best prefix of the next.\n        repeated_sum_candidate = max_suffix_sum + max_prefix_sum\n\n    # The final answer is the maximum of:\n    # 1. The maximum subarray sum found within a single instance of the array.\n    # 2. The maximum subarray sum found by combining parts of repeated arrays.\n    return max(single_max_subarray_sum, repeated_sum_candidate)"}
