{"task_id": "Mbpp/108", "solution": "from typing import Iterable, List, Any, Optional\ndef flatten(iterables: Iterable[Iterable[Any]]) -> List[Any]:\n    \"\"\"Flattens nested iterables one level.\"\"\"\n    return [item for sublist in iterables for item in sublist]\nclass SortStrategy:\n    \"\"\"Interface for sorting behavior.\"\"\"\n    def key(self, item: Any) -> Any:\n        raise NotImplementedError\nclass DefaultSortStrategy(SortStrategy):\n    \"\"\"Default ascending sort strategy.\"\"\"\n    def key(self, item: Any) -> Any:\n        return item\nclass MergeRequest:\n    \"\"\"Encapsulates three validated lists.\"\"\"\n    def __init__(self, a: Iterable[Any], b: Iterable[Any], c: Iterable[Any]) -> None:\n        self.a: List[Any] = list(a)\n        self.b: List[Any] = list(b)\n        self.c: List[Any] = list(c)\nclass InputValidator:\n    \"\"\"Validates and normalizes inputs.\"\"\"\n    def validate_iterable(self, x: Any) -> List[Any]:\n        # Simplified as per constraints: assumes input is iterable and converts to list.\n        return list(x)\n\n    def validate_three_lists(self, a: Any, b: Any, c: Any) -> MergeRequest:\n        return MergeRequest(self.validate_iterable(a), self.validate_iterable(b), self.validate_iterable(c))\nclass ListMerger:\n    \"\"\"Orchestrates merging and sorting of three lists.\"\"\"\n    def __init__(self, strategy: Optional[SortStrategy]=None) -> None:\n        self.strategy = strategy or DefaultSortStrategy()\n\n    def merge_sorted_list(self, a: Iterable[Any], b: Iterable[Any], c: Iterable[Any]) -> List[Any]:\n        flat = flatten([a, b, c])\n        # Error handling removed as per constraints for simplification.\n        return sorted(flat, key=self.strategy.key)\n_validator = InputValidator()\n_merger = ListMerger()\ndef merge_sorted_list(a: Iterable[Any], b: Iterable[Any], c: Iterable[Any], strategy: Optional[SortStrategy]=None) -> List[Any]:\n    \"\"\"Merges three lists into a single sorted list.\"\"\"\n    req = _validator.validate_three_lists(a, b, c)\n    if strategy is None:\n        return _merger.merge_sorted_list(req.a, req.b, req.c)\n    return ListMerger(strategy).merge_sorted_list(req.a, req.b, req.c)"}
{"task_id": "Mbpp/100", "solution": "def next_smallest_palindrome(n: int) -> int:\n    s = str(n)\n    length = len(s)\n\n    # Handle the special case where the number consists of all '9's (e.g., 9, 99, 999).\n    # The next palindrome will have an increased number of digits.\n    if all(ch == '9' for ch in s):\n        return int('1' + ('0' * (length - 1)) + '1')\n\n    s_arr = list(s)\n    \n    # Determine the midpoint indices for the left and right halves.\n    # left_end_idx: index of the rightmost character of the left half.\n    # right_start_idx: index of the leftmost character of the right half.\n    left_end_idx = (length // 2) - 1\n    right_start_idx = (length + 1) // 2\n\n    # This flag tracks if the original right half of the number is \"smaller\"\n    # than the mirrored left half. This helps determine if simply mirroring\n    # the left half will yield a palindrome greater than 'n'.\n    right_is_smaller = False \n\n    # Compare the left half with the right half of the *original* number.\n    # This comparison guides whether we need to increment the middle digits.\n    i = left_end_idx\n    j = right_start_idx\n    while i >= 0:\n        if s_arr[i] < s_arr[j]:\n            # The left digit is smaller than the corresponding right digit.\n            # This implies that the original right half is \"larger\" than the\n            # mirrored left half, so we need to increment the middle.\n            right_is_smaller = True\n            break\n        elif s_arr[i] > s_arr[j]:\n            # The left digit is larger than the corresponding right digit.\n            # This implies that the original right half is \"smaller\" than the\n            # mirrored left half, so simple mirroring will be sufficient.\n            right_is_smaller = False\n            break\n        # If s_arr[i] == s_arr[j], continue comparing digits outwards from the center.\n        i -= 1\n        j += 1\n    \n    # Step 1: Form a palindrome by mirroring the left half to the right.\n    # This creates a base palindrome that uses the same prefix as 's'.\n    i = left_end_idx\n    j = right_start_idx\n    while i >= 0:\n        s_arr[j] = s_arr[i]\n        i -= 1\n        j += 1\n\n    # Step 2: Decide whether to return this mirrored palindrome or increment the middle.\n    if not right_is_smaller:\n        # If right_is_smaller is False, it means the original right half was\n        # either greater than or equal to the mirrored left half.\n        # In this scenario, simply mirroring the left half (as done above) results\n        # in a palindrome that is still less than or equal to 'n'.\n        # Therefore, we *must* increment the middle part.\n        \n        # Increment the middle digit(s) and propagate any carry.\n        # current_increment_idx points to the rightmost digit of the segment to be incremented.\n        current_increment_idx = (length - 1) // 2\n        carry = 1\n        i = current_increment_idx\n        while i >= 0 and carry > 0:\n            digit = int(s_arr[i]) + carry\n            s_arr[i] = str(digit % 10)\n            carry = digit // 10\n            i -= 1\n\n        if carry > 0:\n            # If a carry remains after incrementing the entire left half,\n            # it means the number of digits must increase (e.g., 98 -> 101).\n            return int('1' + ('0' * (length - 1)) + '1')\n        \n        # After incrementing the middle part, re-mirror the updated left half to the right.\n        i = left_end_idx\n        j = right_start_idx\n        while i >= 0:\n            s_arr[j] = s_arr[i]\n            i -= 1\n            j += 1\n            \n    return int(\"\".join(s_arr))"}
{"task_id": "Mbpp/109", "solution": "def odd_Equivalent(binary_str: str, rotations: int) -> int:\n    \"\"\"\n    Finds the number of times a binary string, when rotated left, represents an odd number.\n    An odd number in binary ends with '1'.\n    \"\"\"\n    n = len(binary_str)\n    if n == 0:\n        return 0\n\n    odd_count = 0\n    num_rotations_to_consider = min(rotations, n)\n\n    for k in range(num_rotations_to_consider):\n        # Perform cyclic left shift for k positions\n        # The design context refers to this as rotator.rotate_left(binary_str, k)\n        rotated_str = binary_str[k:] + binary_str[:k]\n        \n        # Check if the rotated string represents an odd number (last digit is '1')\n        if rotated_str[-1] == '1':\n            odd_count += 1\n            \n    return odd_count"}
{"task_id": "Mbpp/113", "solution": "import re\ndef check_integer(s: str) -> bool:\n    \"\"\"Checks if a string represents an integer, ignoring leading/trailing whitespace.\n    An integer can optionally have a single leading '+' or '-' sign.\"\"\"\n    normalized_s = s.strip()\n\n    if not normalized_s:\n        return False\n\n    # Regex matches an optional sign (+ or -) followed by one or more digits.\n    # The `re.match` function checks only from the beginning of the string.\n    return bool(re.match(r'^[+-]?\\d+$', normalized_s))"}
