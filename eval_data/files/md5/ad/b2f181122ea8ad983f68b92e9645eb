{"task_id": "Mbpp/414", "solution": "def overlapping(list1, list2):\n    \"\"\"\n    Checks if any value in a sequence exists in another sequence.\n    It attempts an efficient hash-based check and falls back to a slower element-wise comparison if items are unhashable.\n    \"\"\"\n    if not list1 or not list2:\n        return False\n\n    # Determine which sequence is smaller to optimize set creation.\n    # We iterate over the larger sequence and check membership in the set of the smaller one.\n    if len(list1) < len(list2):\n        smaller_seq = list1\n        larger_seq = list2\n    else:\n        smaller_seq = list2\n        larger_seq = list1\n\n    try:\n        # Attempt the efficient hash-based approach for hashable elements.\n        smaller_set = set(smaller_seq)\n        for item in larger_seq:\n            if item in smaller_set:\n                return True\n    except TypeError:\n        # Fallback to a less efficient O(N*M) comparison for unhashable elements.\n        # We use the original lists for the fallback to ensure all pairs are compared correctly.\n        for item1 in list1:\n            for item2 in list2:\n                if item1 == item2:\n                    return True\n\n    # No common elements were found between the two sequences.\n    return False"}
{"task_id": "Mbpp/405", "solution": "from typing import Any, List, Optional\nclass TupleQuery:\n    \"\"\"DTO that groups a tuple and an element for transport.\"\"\"\n    def __init__(self, tuple_data: tuple, element: Any) -> None:\n        self.tuple_data = tuple_data\n        self.element = element\nclass ValidatorUtil:\n    \"\"\"Utility for input validation, though checks are skipped per specific requirements.\"\"\"\n    @staticmethod\n    def validate_tuple(value: Any) -> None:\n        \"\"\"This method does not perform validation due to strict problem requirements.\"\"\"\n        pass\n\n    @staticmethod\n    def validate_element(element: Any) -> None:\n        \"\"\"This method does not perform validation due to strict problem requirements.\"\"\"\n        pass\nclass TupleRepository:\n    \"\"\"Provides an abstraction for tuple storage and membership checks.\"\"\"\n    def __init__(self, persistence_path: Optional[str] = None) -> None:\n        self.persistence_path = persistence_path\n        self.store: List[tuple] = []\n\n    def contains(self, t: tuple, element: Any) -> bool:\n        \"\"\"Checks if an element exists within a tuple using Python's 'in' operator.\"\"\"\n        return element in t\nclass TupleService:\n    \"\"\"Encapsulates the business logic for checking element membership in a tuple.\"\"\"\n    def __init__(self, repository: TupleRepository, validator: type) -> None:\n        self.repository = repository\n        self.validator = validator\n\n    def element_exists(self, t: tuple, element: Any) -> bool:\n        \"\"\"Determines if an element is present in the given tuple, omitting explicit validation.\"\"\"\n        # Input validation calls are omitted as per problem requirements.\n        return self.repository.contains(t, element)\nclass TupleController:\n    \"\"\"Provides a public API surface for library consumers to check tuple membership.\"\"\"\n    def __init__(self, service: TupleService) -> None:\n        self.service = service\n\n    def check_tuplex(self, t: tuple, element: Any) -> bool:\n        \"\"\"Delegates the tuple element existence check to the service layer.\"\"\"\n        query = TupleQuery(t, element)\n        return self.service.element_exists(query.tuple_data, query.element)\ndef check_tuplex(t: tuple, element: Any) -> bool:\n    \"\"\"\n    Checks whether an element exists within a tuple.\n    This function initializes a layered architecture internally to perform the check.\n    \"\"\"\n    repo = TupleRepository()\n    service = TupleService(repo, ValidatorUtil)\n    controller = TupleController(service)\n    return controller.check_tuplex(t, element)"}
{"task_id": "Mbpp/410", "solution": "import re\nfrom decimal import Decimal\nfrom typing import Any, Iterable, Tuple, Sequence\nclass InvalidInputError(Exception):\n    \"\"\"Exception raised for invalid or insufficient input data.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\nclass TypeComparator:\n    \"\"\"Decides if an object is numeric and provides its numeric value, optionally parsing strings.\"\"\"\n    SAFE_NUMBER_TYPES = (int, float, Decimal)\n\n    def __init__(self) -> None:\n        # Regex to match simple float patterns without scientific notation, etc.\n        self._float_re = re.compile(r'^[+-]?(?:\\d+)(?:\\.\\d+)?$')\n\n    def is_numeric(self, item: Any) -> bool:\n        \"\"\"Checks if an item is a safe numeric type (int, float, Decimal), excluding booleans.\"\"\"\n        return isinstance(item, self.SAFE_NUMBER_TYPES) and not isinstance(item, bool)\n\n    def to_numeric(self, item: Any, parse_numeric_strings: bool = False) -> Tuple[bool, float | int | None]:\n        \"\"\"Converts an item to a numeric type if possible, or returns (False, None).\"\"\"\n        if self.is_numeric(item):\n            return True, item\n        if parse_numeric_strings and isinstance(item, str):\n            parsed = self._parse_string(item.strip())\n            if parsed is not None:\n                return True, parsed\n        return False, None\n\n    def _parse_string(self, s: str) -> float | int | None:\n        \"\"\"Safely parses a string into an int or float, returning None on failure.\"\"\"\n        if not s: # Empty string is not numeric\n            return None\n        # Try converting to int first if it looks like an integer\n        if s.isdigit() or (s.startswith(('+', '-')) and s[1:].isdigit()):\n            try:\n                return int(s)\n            except ValueError:\n                pass # Fall through to float\n        # Otherwise, try converting to float using a conservative regex\n        if self._float_re.match(s):\n            try:\n                return float(s)\n            except ValueError:\n                pass\n        return None\nclass InputValidator:\n    \"\"\"Validates input sequences for type and size constraints.\"\"\"\n    DEFAULT_MAX_ITEMS = 10_000_000\n\n    def __init__(self, max_items: int = DEFAULT_MAX_ITEMS) -> None:\n        self._max_items = max_items\n\n    def validate_iterable(self, seq: Any) -> None:\n        \"\"\"Checks if the input is an iterable and its size is within limits.\"\"\"\n        if seq is None:\n            raise InvalidInputError(\"Input sequence is None.\")\n        try:\n            iter(seq)\n        except TypeError:\n            raise InvalidInputError(\"Input is not iterable.\")\n        \n        # If length can be cheaply determined (has __len__), check against max_items\n        length_method = getattr(seq, \"__len__\", None)\n        if length_method is not None:\n            try:\n                if len(seq) > self._max_items:\n                    raise InvalidInputError(f\"Input exceeds maximum allowed items ({self._max_items}).\")\n            except TypeError: # Some objects have __len__ but it might raise TypeError (e.g., custom iterators that don't support len)\n                pass # Cannot determine length cheaply, proceed without length check\nclass MinFinderService:\n    \"\"\"Core service to find the minimum numeric value in a heterogeneous iterable.\"\"\"\n    def __init__(self, comparator: TypeComparator, validator: InputValidator) -> None:\n        self._comparator = comparator\n        self._validator = validator\n\n    def find_min(self, seq: Iterable[Any], parse_numeric_strings: bool = False, max_items: int = 10_000_000) -> float | int:\n        \"\"\"Finds the minimum numeric value in the given sequence.\"\"\"\n        # The max_items parameter is passed to validate_iterable during validator init,\n        # but also here to explicitly show it's part of the service's find_min contract\n        # for potential future dynamic validation. For now, we assume validator is configured.\n        self._validator.validate_iterable(seq)\n\n        found = False\n        current_min = None\n\n        for item in seq:\n            is_num, val = self._comparator.to_numeric(item, parse_numeric_strings)\n            if is_num:\n                if not found:\n                    current_min = val\n                    found = True\n                else:\n                    current_min = self._update_min(current_min, val)\n        \n        if not found:\n            raise InvalidInputError(\"No numeric values found in the input sequence.\")\n        \n        return current_min\n\n    def _update_min(self, current_min: float | int, candidate: float | int) -> float | int:\n        \"\"\"Updates the current minimum value if the candidate is smaller.\"\"\"\n        return candidate if candidate < current_min else current_min\ndef min_val(seq: Sequence[Any], parse_numeric_strings: bool = False, max_items: int = 10_000_000) -> float | int:\n    \"\"\"\n    Finds the minimum numeric value in a given heterogeneous list.\n    assert min_val(['Python', 3, 2, 4, 5, 'version'])==2\n    \"\"\"\n    comparator = TypeComparator()\n    validator = InputValidator(max_items=max_items)\n    service = MinFinderService(comparator, validator)\n    return service.find_min(seq, parse_numeric_strings=parse_numeric_strings, max_items=max_items)"}
{"task_id": "Mbpp/413", "solution": "from typing import Any, List, Tuple, Sequence\nclass InvalidInputError(ValueError):\n    \"\"\"Exception raised for invalid input data or parameters.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\nclass InvalidIndexError(IndexError):\n    \"\"\"Exception raised when an index is out of bounds for a specific row.\"\"\"\n    def __init__(self, message: str, index: int = None, row_index: int = None):\n        super().__init__(message)\n        self.message = message\n        self.index = index\n        self.row_index = row_index\nclass ExtractionResult:\n    \"\"\"A data transfer object to hold the results of an extraction.\"\"\"\n    def __init__(self, results: List[Any]):\n        self.results = results\n\n    def to_list(self) -> List[Any]:\n        return self.results\nclass InputValidator:\n    \"\"\"Utility class for validating input data structures and indices.\"\"\"\n    def validate_rows(self, rows: Sequence[Any]) -> Sequence[Tuple[Any, ...]]:\n        if not isinstance(rows, Sequence) or isinstance(rows, str):\n            raise InvalidInputError(\"Input 'data' must be a sequence (e.g., list or tuple), not a string.\")\n        \n        validated_rows = []\n        for i, row in enumerate(rows):\n            if not isinstance(row, Sequence) or isinstance(row, str):\n                raise InvalidInputError(f\"Row {i} must be a sequence (e.g., list or tuple), got {type(row).__name__}.\")\n            validated_rows.append(tuple(row))\n        return tuple(validated_rows) # Return as tuple for immutability and consistency\n\n    def validate_index(self, n: int) -> int:\n        if not isinstance(n, int):\n            raise InvalidInputError(\"Input 'n' must be an integer.\")\n        if n < 0:\n            raise InvalidInputError(\"Input 'n' must be a non-negative integer.\")\n        return n\nclass TupleRepository:\n    \"\"\"Provides an abstraction for accessing a sequence of tuple-like rows.\"\"\"\n    def __init__(self, rows: Sequence[Tuple[Any, ...]]):\n        self._rows = rows\n\n    def get_all(self) -> Sequence[Tuple[Any, ...]]:\n        return self._rows\nclass IndexUtils:\n    \"\"\"Helper functions for safe indexing operations on sequences.\"\"\"\n    @staticmethod\n    def safe_get(row: Sequence[Any], index: int) -> Any:\n        return row[index]\n\n    @staticmethod\n    def has_index(row: Sequence[Any], index: int) -> bool:\n        return len(row) > index\nclass TupleExtractorService:\n    \"\"\"Core business logic for extracting elements from tuples.\"\"\"\n    def __init__(self, repo: TupleRepository):\n        self._repo = repo\n\n    def extract_nth_element(self, n: int, skip_missing: bool = False) -> ExtractionResult:\n        rows = self._repo.get_all()\n        results = []\n        for i, row in enumerate(rows):\n            if IndexUtils.has_index(row, n):\n                results.append(IndexUtils.safe_get(row, n))\n            else:\n                if skip_missing:\n                    continue\n                raise InvalidIndexError(f\"Row {i} is missing element at index {n}.\", index=n, row_index=i)\n        return ExtractionResult(results)\nclass ExtractionController:\n    \"\"\"Orchestrates validation and service calls for extraction operations.\"\"\"\n    def __init__(self, service: TupleExtractorService):\n        self._service = service\n        self._validator = InputValidator()\n\n    def extract(self, data: Sequence[Any], n: int, skip_missing: bool = False) -> List[Any]:\n        # 'data' parameter is expected to be validated and loaded into the service's repository\n        # by the time this method is called (e.g., via the public `extract_nth_element` facade).\n        # This method primarily validates 'n' and delegates to the service.\n        validated_n = self._validator.validate_index(n)\n        \n        result_dto = self._service.extract_nth_element(validated_n, skip_missing)\n        return result_dto.to_list()\ndef extract_nth_element(data: Sequence[Tuple[Any, ...]], n: int, skip_missing: bool=False) -> List[Any]:\n    \"\"\"\n    Extracts the nth element from each tuple in a given list of tuples.\n    This function acts as a facade, orchestrating input validation, data encapsulation,\n    and delegation to the core extraction service.\n    \"\"\"\n    validator = InputValidator()\n    validated_data = validator.validate_rows(data)\n    repo = TupleRepository(validated_data)\n    service = TupleExtractorService(repo)\n    controller = ExtractionController(service)\n    return controller.extract(validated_data, n, skip_missing)"}
{"task_id": "Mbpp/415", "solution": "def max_Product(arr: list[int]) -> tuple[int, int]:\n    \"\"\"Finds a pair of integers from the array with the highest product.\n    Assumes the input list contains at least two integers and all elements are integers.\n    \"\"\"\n    # Initialize variables to keep track of the two largest and two smallest numbers.\n    # Using large/small integer sentinel values to ensure any input number will update them.\n    max1 = max2 = -10**18  # Largest and second largest\n    min1 = min2 = 10**18   # Smallest and second smallest\n\n    for x in arr:\n        # Update the two largest numbers\n        if x >= max1:\n            max2, max1 = max1, x\n        elif x > max2:\n            max2 = x\n\n        # Update the two smallest numbers\n        if x <= min1:\n            min2, min1 = min1, x\n        elif x < min2:\n            min2 = x\n\n    # Calculate the two potential maximum products:\n    # 1. Product of the two largest numbers.\n    # 2. Product of the two smallest (most negative) numbers, which could yield a large positive product.\n    prod1 = max1 * max2\n    prod2 = min1 * min2\n\n    # Compare products and determine the resulting pair.\n    # Pairs are inherently sorted (smaller, larger) by how max1/max2 and min1/min2 are maintained.\n    if prod1 > prod2:\n        return (max2, max1)\n    elif prod2 > prod1:\n        return (min1, min2)\n    else:\n        # Products are equal, apply tie-breaker:\n        # Choose the pair with the numerically smallest first element, then smallest second element.\n        pair1 = (max2, max1)\n        pair2 = (min1, min2)\n        # Lexicographically compare the pairs, which aligns with the tie-breaker rule.\n        return min(pair1, pair2)"}
{"task_id": "Mbpp/418", "solution": "from typing import Sequence, Any\ndef Find_Max(items: Sequence[Sequence[Any]]) -> Sequence[Any]:\n    \"\"\"\n    Finds the element in a list of sequences that has the maximum length.\n    If multiple elements have the same maximum length, the first one encountered is returned.\n    \"\"\"\n    if not items:\n        # Per constraints, no explicit exception raising for empty list.\n        # Python's max() on empty iterable would raise ValueError.\n        # Initializing with items[0] will raise IndexError if items is empty,\n        # which is an implicit error without explicit handling.\n        pass # The problem asserts with non-empty list.\n\n    max_element = items[0]\n    max_length = len(items[0])\n\n    for i in range(1, len(items)):\n        current_element = items[i]\n        current_length = len(current_element)\n\n        if current_length > max_length:\n            max_length = current_length\n            max_element = current_element\n    \n    return max_element"}
{"task_id": "Mbpp/420", "solution": "def cube_Sum(n):\n    \"\"\"\n    Calculates the cube sum of the first n even natural numbers using a closed-form formula.\n    The formula is 2 * n^2 * (n+1)^2.\n    \"\"\"\n    # The sum of cubes of the first n even natural numbers is 2 * n^2 * (n+1)^2.\n    return 2 * (n * n) * ((n + 1) * (n + 1))"}
{"task_id": "Mbpp/419", "solution": "def round_and_sum(numbers: list[float]) -> int:\n    \"\"\"\n    Rounds each number in a list, sums the rounded numbers, and multiplies the sum by the list's length.\n    Returns the final result as an integer.\n    \"\"\"\n    rounded_numbers_sum = 0\n    for num in numbers:\n        rounded_numbers_sum += round(num)\n    \n    list_length = len(numbers)\n    \n    return rounded_numbers_sum * list_length"}
