{"task_id": "Mbpp/473", "solution": "def tuple_intersection(list1: Iterable[Tuple], list2: Iterable[Tuple]) -> Set[Tuple]:\n    \"\"\"\n    Finds the tuple intersection of elements in the given tuple lists\n    irrespective of their order, returning a set of canonical tuples.\n    \"\"\"\n\n    def _normalize_tuple(t: Tuple[Any, Any]) -> Tuple[Any, Any]:\n        # Normalizes a 2-element tuple by sorting its elements for canonical representation.\n        a, b = t[0], t[1]\n        try:\n            return (a, b) if a <= b else (b, a)\n        except TypeError:\n            # Provides a stable fallback order for elements that are not directly comparable.\n            s = sorted([a, b], key=lambda x: (type(x).__name__, str(x)))\n            return (s[0], s[1])\n\n    def _to_canonical_set(it: Iterable[Tuple[Any, Any]]) -> Set[Tuple[Any, Any]]:\n        # Converts an iterable of tuples into a set of uniquely normalized (canonical) tuples.\n        return {_normalize_tuple(item) for item in it}\n\n    canonical_set1 = _to_canonical_set(list1)\n    canonical_set2 = _to_canonical_set(list2)\n\n    return canonical_set1 & canonical_set2"}
{"task_id": "Mbpp/475", "solution": "from typing import Dict, Any, List, Tuple\ndef sort_counter(data: Dict[Any, Any]) -> List[Tuple[Any, float]]:\n    \"\"\"Sorts a dictionary by its values in descending order, then by keys in ascending order for ties.\n    Values are coerced to floats for comparison and output.\"\"\"\n    items_with_float_values = []\n    for k, v in data.items():\n        items_with_float_values.append((k, float(v)))\n\n    # Sort items primarily by value descending, secondarily by key (as string) ascending.\n    sorted_items = sorted(items_with_float_values, key=lambda kv: (-kv[1], str(kv[0])))\n\n    return sorted_items"}
{"task_id": "Mbpp/479", "solution": "def first_Digit(n):\n    \"\"\"Finds the first non-zero digit of a number, or 0 if the number is zero.\"\"\"\n    s = str(n).strip()\n\n    # Remove any leading sign (e.g., '-', '+')\n    if s.startswith('-') or s.startswith('+'):\n        s = s[1:]\n\n    # Remove the decimal point if present, treating all digits equally\n    s = s.replace('.', '')\n\n    # Iterate through the remaining characters to find the first non-zero digit\n    for char_digit in s:\n        if char_digit != '0':\n            return int(char_digit)\n\n    # If no non-zero digit is found (e.g., for \"0\", \"0.0\", \"000\"), return 0\n    return 0"}
