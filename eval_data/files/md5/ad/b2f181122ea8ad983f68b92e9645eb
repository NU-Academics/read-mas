{"task_id": "Mbpp/751", "solution": "def check_min_heap(arr):\n    \"\"\"\n    Checks if the given array represents a min-heap.\n    The min-heap property states that the value of each node must be less than or equal to the value of its children.\n    \"\"\"\n    n = len(arr)\n    # An empty array or a single-element array is considered a valid min-heap.\n    if n <= 1:\n        return True\n\n    # Iterate only through non-leaf nodes\n    for i in range(n // 2):\n        parent_value = arr[i]\n\n        left_child_idx = 2 * i + 1\n        right_child_idx = 2 * i + 2\n\n        # Check left child\n        if left_child_idx < n and parent_value > arr[left_child_idx]:\n            return False\n\n        # Check right child\n        if right_child_idx < n and parent_value > arr[right_child_idx]:\n            return False\n\n    return True"}
{"task_id": "Mbpp/745", "solution": "def divisible_by_digits(startnum, endnum):\n    \"\"\"\n    Finds numbers within a given range where every number is divisible by every non-zero digit it contains.\n    Numbers containing the digit 0 are excluded.\n    \"\"\"\n    result = []\n    for num in range(startnum, endnum + 1):\n        is_self_divisible = True\n        num_str = str(num)\n        for digit_char in num_str:\n            digit = int(digit_char)\n            if digit == 0:\n                is_self_divisible = False\n                break\n            if num % digit != 0:\n                is_self_divisible = False\n                break\n        if is_self_divisible:\n            result.append(num)\n    return result"}
{"task_id": "Mbpp/749", "solution": "def sort_numeric_strings(items: list[str], ignore_invalid: bool=False, as_float: bool=False) -> list:\n    \"\"\"\n    Sorts a list of numeric strings numerically.\n    Converts strings to numbers (int or float) and sorts them in ascending order.\n    \"\"\"\n    parsed_numbers = []\n\n    for i, s in enumerate(items):\n        s_stripped = s.strip()\n        try:\n            if as_float:\n                # If as_float is true, always convert to float.\n                parsed_numbers.append(float(s_stripped))\n            else:\n                # Try converting to int first.\n                try:\n                    parsed_numbers.append(int(s_stripped))\n                except ValueError:\n                    # If int conversion fails, try float.\n                    num = float(s_stripped)\n                    # If the float is an exact integer, store as int (e.g., \"1.0\" becomes 1).\n                    if num.is_integer():\n                        parsed_numbers.append(int(num))\n                    else:\n                        parsed_numbers.append(num)\n        except ValueError:\n            # Handle cases where s_stripped is not a valid int or float.\n            if not ignore_invalid:\n                # Raise ValueError if not ignoring invalid items, as specified in FR1 for parsing errors.\n                raise ValueError(f\"Invalid numeric string: '{s}' at index {i}\")\n            # If ignore_invalid is True, this item is skipped.\n\n    return sorted(parsed_numbers)"}
{"task_id": "Mbpp/748", "solution": "import re\ndef capital_words_spaces(text: str, split_acronyms: bool = True) -> str:\n    \"\"\"\n    Inserts spaces before words starting with capital letters, with an option\n    to control splitting of acronyms (e.g., XMLHTTP).\n    \"\"\"\n    if not text:\n        return \"\"\n\n    # Normalize the input: strip leading/trailing whitespace and collapse multiple\n    # internal spaces into a single space.\n    normalized_text = re.sub(r'\\s+', ' ', text).strip()\n\n    # Pattern to split:\n    # 1. Between a lowercase letter/digit and an uppercase letter (e.g., \"helloWorld\" -> \"hello World\")\n    # 2. Between an uppercase letter and an uppercase letter followed by a lowercase letter\n    #    (e.g., \"XMLHttpRequest\" -> \"XML Http Request\")\n    DEFAULT_PATTERN_SPLIT_ACRONYMS = r'(?<=[a-z0-9])(?=[A-Z])|(?<=[A-Z])(?=[A-Z][a-z])'\n\n    # Pattern to preserve acronyms:\n    # Only splits between a lowercase letter/digit and an uppercase letter\n    # (e.g., \"XMLHTTP\" -> \"XMLHTTP\", but \"helloWorld\" -> \"hello World\")\n    DEFAULT_PATTERN_PRESERVE_ACRONYMS = r'(?<=[a-z0-9])(?=[A-Z])'\n\n    # Choose the appropriate pattern based on the split_acronyms flag\n    pattern = (DEFAULT_PATTERN_SPLIT_ACRONYMS\n               if split_acronyms else DEFAULT_PATTERN_PRESERVE_ACRONYMS)\n\n    # Apply the regex substitution to insert spaces at the determined boundaries\n    result = re.sub(pattern, ' ', normalized_text)\n\n    return result"}
{"task_id": "Mbpp/752", "solution": "from typing import Any, Dict, Optional, Tuple\nfrom datetime import datetime\nclass JacobsthalError(Exception):\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\nclass InvalidInputError(JacobsthalError):\n    def __init__(self, message: str):\n        super().__init__(message)\nclass JacobsthalResult:\n    def __init__(self, n: int, value: int, cached: bool, algorithm: str, computed_at: datetime):\n        self.n = n\n        self.value = value\n        self.cached = cached\n        self.algorithm = algorithm\n        self.computed_at = computed_at\n\n    def to_dict(self) -> Dict[str, Any]:\n        return {\n            \"n\": self.n,\n            \"value\": self.value,\n            \"cached\": self.cached,\n            \"algorithm\": self.algorithm,\n            \"computed_at\": self.computed_at.isoformat()\n        }\nclass Config:\n    DEFAULT_CACHE_PATH: str = \"~/.cache/jacobsthal/cache.json\"\n    DEFAULT_LARGE_N_THRESHOLD: int = 10000\n\n    def __init__(self, cache_path: str, large_n_threshold: int, api_enabled: bool = False, api_host: str = \"0.0.0.0\", api_port: int = 8000):\n        self.cache_path = cache_path\n        self.large_n_threshold = large_n_threshold\n        self.api_enabled = api_enabled\n        self.api_host = api_host\n        self.api_port = api_port\n\n    @staticmethod\n    def from_env() -> 'Config':\n        return Config(\n            cache_path=Config.DEFAULT_CACHE_PATH,\n            large_n_threshold=Config.DEFAULT_LARGE_N_THRESHOLD\n        )\nclass CacheRepository:\n    def __init__(self, path: str):\n        self._cache: Dict[int, int] = {} # In-memory dictionary for simplification\n        self._path = path # Store path to match signature, but not used for file ops\n\n    def get(self, n: int) -> Optional[int]:\n        return self._cache.get(n)\n\n    def set(self, n: int, value: int) -> None:\n        self._cache[n] = value\n\n    def clear(self) -> None:\n        self._cache.clear()\nclass MathUtils:\n    MATRIX_BASE: Tuple[Tuple[int, int], Tuple[int, int]] = ((1, 2), (1, 0))\n\n    @staticmethod\n    def validate_n(n: Any) -> int:\n        if not isinstance(n, int):\n            try:\n                n = int(n)\n            except (ValueError, TypeError):\n                raise InvalidInputError(\"n must be an integer.\")\n        if n < 0:\n            raise InvalidInputError(\"n must be >= 0.\")\n        return n\n\n    @staticmethod\n    def jacobsthal_iterative(n: int) -> int:\n        if n == 0:\n            return 0\n        if n == 1:\n            return 1\n        a, b = 0, 1\n        for _ in range(2, n + 1):\n            a, b = b, b + 2 * a\n        return b\n\n    @staticmethod\n    def _matrix_multiply(A: Tuple[Tuple[int, int], Tuple[int, int]], B: Tuple[Tuple[int, int], Tuple[int, int]]) -> Tuple[Tuple[int, int], Tuple[int, int]]:\n        return (\n            (A[0][0] * B[0][0] + A[0][1] * B[1][0], A[0][0] * B[0][1] + A[0][1] * B[1][1]),\n            (A[1][0] * B[0][0] + A[1][1] * B[1][0], A[1][0] * B[0][1] + A[1][1] * B[1][1])\n        )\n\n    @staticmethod\n    def _matrix_pow(mat: Tuple[Tuple[int, int], Tuple[int, int]], exponent: int) -> Tuple[Tuple[int, int], Tuple[int, int]]:\n        res = ((1, 0), (0, 1)) # Identity matrix\n        base = mat\n        while exponent > 0:\n            if exponent % 2 == 1:\n                res = MathUtils._matrix_multiply(res, base)\n            base = MathUtils._matrix_multiply(base, base)\n            exponent //= 2\n        return res\n\n    @staticmethod\n    def jacobsthal_matrix(n: int) -> int:\n        if n == 0:\n            return 0\n        if n == 1:\n            return 1\n        # Computes J(n) using matrix exponentiation.\n        # J(n) is the (0,0) element of ((1,2),(1,0))^(n-1) when applied to [J(1), J(0)].\n        powered_matrix = MathUtils._matrix_pow(MathUtils.MATRIX_BASE, n - 1)\n        return powered_matrix[0][0]\nclass JacobsthalService:\n    def __init__(self, cache_repo: CacheRepository, config: Config):\n        self.cache = cache_repo\n        self.config = config\n        self.math = MathUtils\n\n    def compute(self, n: int, prefer: Optional[str] = None) -> JacobsthalResult:\n        n_validated = self.math.validate_n(n)\n        \n        cached_value = self.cache.get(n_validated)\n        if cached_value is not None:\n            return JacobsthalResult(n=n_validated, value=cached_value, cached=True, algorithm=\"cache\", computed_at=datetime.utcnow())\n        \n        algorithm_name = self._select_algorithm(n_validated, prefer)\n        value = self._compute_via_algorithm(n_validated, algorithm_name)\n        \n        self.cache.set(n_validated, value)\n        return JacobsthalResult(n=n_validated, value=value, cached=False, algorithm=algorithm_name, computed_at=datetime.utcnow())\n\n    def _select_algorithm(self, n: int, prefer: Optional[str]) -> str:\n        if prefer == \"iterative\":\n            return \"iterative\"\n        if prefer == \"matrix\":\n            return \"matrix\"\n        \n        if n < self.config.large_n_threshold:\n            return \"iterative\"\n        else:\n            return \"matrix\"\n\n    def _compute_via_algorithm(self, n: int, algorithm: str) -> int:\n        if algorithm == \"iterative\":\n            return self.math.jacobsthal_iterative(n)\n        elif algorithm == \"matrix\":\n            return self.math.jacobsthal_matrix(n)\n        else:\n            raise JacobsthalError(f\"Unknown algorithm: {algorithm}\")\n_config = Config.from_env()\n_cache = CacheRepository(_config.cache_path)\n_service = JacobsthalService(_cache, _config)\ndef jacobsthal_num(n: int) -> int:\n    \"\"\"\n    Computes the nth Jacobsthal number using a service with caching and algorithm selection.\n    \"\"\"\n    result = _service.compute(n)\n    return result.value"}
{"task_id": "Mbpp/753", "solution": "import heapq\nfrom typing import List, Tuple, Any\nclass MinKError(Exception):\n    \"\"\"Custom exception for MinK related errors.\"\"\"\n    def __init__(self, message: str) -> None:\n        self.message = message\n    def __str__(self) -> str:\n        return self.message\nclass Record:\n    \"\"\"Represents a record with a name and a numeric value.\"\"\"\n    def __init__(self, name: str, value: float) -> None:\n        self.name: str = name\n        self.value: float = float(value)\n\n    def to_tuple(self) -> Tuple[str, float]:\n        \"\"\"Converts the Record object to a (name, value) tuple.\"\"\"\n        return (self.name, self.value)\n\n    @classmethod\n    def from_tuple(cls, t: Any) -> \"Record\":\n        \"\"\"Creates a Record object from a 2-element tuple or list.\"\"\"\n        if not (isinstance(t, (list, tuple)) and len(t) == 2):\n            raise MinKError(\"Record must be a 2-element tuple or list.\")\n        try:\n            return cls(str(t[0]), float(t[1]))\n        except (ValueError, TypeError) as e:\n            raise MinKError(f\"Invalid record element type: {e}\")\nclass MinKRequest:\n    \"\"\"Request DTO for the MinKService.\"\"\"\n    def __init__(self, records: List[Record], k: int) -> None:\n        self.records: List[Record] = records\n        self.k: int = k\nclass MinKResponse:\n    \"\"\"Response DTO for the MinKService.\"\"\"\n    def __init__(self, results: List[Record]) -> None:\n        self.results: List[Record] = results\n\n    def to_list(self) -> List[Tuple[str, float]]:\n        \"\"\"Converts the list of Record objects to a list of (name, value) tuples.\"\"\"\n        return [r.to_tuple() for r in self.results]\ndef to_record_list(raw_records: Any) -> List[Record]:\n    \"\"\"Converts a raw input (e.g., list of tuples) to a list of Record objects.\"\"\"\n    if not isinstance(raw_records, (list, tuple)):\n        raise MinKError(\"Input records must be a list or tuple.\")\n    return [Record.from_tuple(item) for item in raw_records]\ndef validate_k(k: Any) -> int:\n    \"\"\"Ensures k is a non-negative integer.\"\"\"\n    if not isinstance(k, int) or k < 0:\n        raise MinKError(\"Parameter 'k' must be a non-negative integer.\")\n    return k\nclass HeapAdapter:\n    \"\"\"Provides heap-based operations for finding n-smallest elements.\"\"\"\n    def n_smallest(self, records: List[Record], k: int) -> List[Record]:\n        \"\"\"\n        Returns k smallest records using a heap, sorted by value then name.\n        Assumes k is a non-negative integer.\n        \"\"\"\n        return heapq.nsmallest(k, records, key=lambda r: (r.value, r.name))\nclass MinKService:\n    \"\"\"Core application service for finding minimum k records.\"\"\"\n    def min_k(self, request: MinKRequest, heap_adapter: HeapAdapter = None) -> MinKResponse:\n        \"\"\"\n        Finds the k records with the smallest numeric values.\n        Uses a HeapAdapter for efficient selection.\n        \"\"\"\n        if request.k <= 0:\n            return MinKResponse([])\n\n        adapter = heap_adapter or HeapAdapter()\n        results = adapter.n_smallest(request.records, request.k)\n        return MinKResponse(results)\ndef min_k(records: List[Tuple[str, float]], k: int) -> List[Tuple[str, float]]:\n    \"\"\"\n    Finds the minimum k records from a list of (name, value) tuples.\n    Records are sorted by value ascending, then by name ascending for ties.\n    \"\"\"\n    recs = to_record_list(records)\n    k_validated = validate_k(k)\n    request = MinKRequest(recs, k_validated)\n    service = MinKService()\n    resp = service.min_k(request)\n    return resp.to_list()"}
{"task_id": "Mbpp/757", "solution": "def count_reverse_pairs(strings: List[str]) -> int:\n    \"\"\"Counts pairs of strings where one is the reverse of the other within the given list.\"\"\"\n    freq: dict[str, int] = {}\n    for s in strings:\n        freq[s] = freq.get(s, 0) + 1\n\n    count = 0\n    seen = set() \n    \n    for s, n in list(freq.items()):\n        if s in seen:\n            continue\n        \n        rev = s[::-1]\n        \n        if rev == s: # Palindrome\n            count += n * (n - 1) // 2\n        else:\n            count += n * freq.get(rev, 0)\n        \n        seen.add(s)\n        seen.add(rev)\n    \n    return count"}
{"task_id": "Mbpp/754", "solution": "def extract_index_list(l1, l2, l3):\n    \"\"\"\n    Finds elements that are common across three lists at the same index.\n    Returns a list of such elements.\n    \"\"\"\n    min_len = min(len(l1), len(l2), len(l3))\n    result = []\n    for i in range(min_len):\n        if l1[i] == l2[i] and l2[i] == l3[i]:\n            result.append(l1[i])\n    return result"}
{"task_id": "Mbpp/755", "solution": "import math\ndef second_smallest(numbers: list) -> float:\n    \"\"\"\n    Finds the second smallest distinct number in a list.\n    Returns math.inf if fewer than two distinct numbers are present.\n    \"\"\"\n    min1 = math.inf\n    min2 = math.inf\n\n    for x in numbers:\n        if x < min1:\n            min2 = min1\n            min1 = x\n        elif min1 < x < min2:\n            min2 = x\n            \n    return min2"}
{"task_id": "Mbpp/760", "solution": "def unique_Element(numbers_list):\n    \"\"\"\n    Checks if a list of numbers contains only one distinct element.\n    Returns False for an empty list.\n    \"\"\"\n    it = iter(numbers_list)\n    try:\n        first_element = next(it)\n    except StopIteration:\n        return False  # Empty list contains no distinct element, as per design\n    \n    for element in it:\n        if element != first_element:\n            return False\n            \n    return True"}
{"task_id": "Mbpp/759", "solution": "import re\ndef is_decimal(value: str, precision: int | None = None) -> bool:\n    \"\"\"\n    Checks if a string represents a decimal number with a specified precision.\n    The default precision is 2.\n    \"\"\"\n    DEFAULT_PRECISION = 2\n    \n    if precision is None:\n        precision = DEFAULT_PRECISION\n    \n    trimmed_value = value.strip()\n\n    # Use regex ^[+-]?\\d+(\\.\\d+)?$ to check for fixed-point decimal format.\n    # This rejects scientific notation, commas, and values starting with a dot.\n    if not re.fullmatch(r\"^[+-]?\\d+(\\.\\d+)?$\", trimmed_value):\n        return False\n\n    # Determine the length of the fractional part.\n    if '.' in trimmed_value:\n        dot_index = trimmed_value.rfind('.')\n        frac_len = len(trimmed_value) - dot_index - 1\n    else:\n        frac_len = 0\n\n    return frac_len == precision"}
{"task_id": "Mbpp/763", "solution": "def find_min_diff(arr: tuple, n: int) -> int:\n    \"\"\"\n    Finds the minimum difference between any two elements in the given array.\n    The array is sorted first to efficiently compute differences between adjacent elements.\n    \"\"\"\n    sorted_arr = sorted(arr)\n    min_diff = float('inf')\n\n    for i in range(len(sorted_arr) - 1):\n        diff = sorted_arr[i+1] - sorted_arr[i]\n        if diff < min_diff:\n            min_diff = diff\n            if min_diff == 0:  # Optimization: if difference is 0, it's the smallest possible\n                break\n    \n    return int(min_diff) if isinstance(arr[0], int) and min_diff == int(min_diff) else min_diff"}
{"task_id": "Mbpp/758", "solution": "from typing import Any, List, Dict, Tuple, Iterable, Sequence\nimport collections.abc\nclass InvalidInputError(Exception):\n    \"\"\"Exception raised for invalid input structure or types.\"\"\"\n    pass\nclass CountingError(Exception):\n    \"\"\"Exception raised for errors during the counting process.\"\"\"\n    pass\nclass TupleConverter:\n    \"\"\"Converts list-like structures to tuples, normalizing nested elements.\"\"\"\n    def __init__(self):\n        pass\n\n    def list_to_tuple(self, sublist: Iterable[Any]) -> Tuple[Any, ...]:\n        \"\"\"Converts an iterable to a tuple, recursively normalizing elements.\"\"\"\n        try:\n            return tuple(self._normalize_element(item) for item in sublist)\n        except TypeError as e:\n            raise CountingError(f\"Failed to convert sublist to tuple due to unhashable or invalid element: {e}\") from e\n\n    def _normalize_element(self, el: Any) -> Any:\n        \"\"\"Helper to normalize nested elements for tuple conversion.\"\"\"\n        if isinstance(el, list):\n            return tuple(self._normalize_element(item) for item in el)\n        elif isinstance(el, tuple):\n            return tuple(self._normalize_element(item) for item in el)\n        elif isinstance(el, set):\n            return frozenset(self._normalize_element(item) for item in el)\n        elif isinstance(el, dict):\n            raise CountingError(f\"Dictionary found as an element, which is not hashable and cannot be normalized: {el}\")\n        else:\n            return el\nclass InMemoryRepository:\n    \"\"\"Simple in-memory storage for the last computed counts.\"\"\"\n    def __init__(self):\n        self._storage: Dict[Tuple[Any, ...], int] = {}\n\n    def save_result(self, counts: Dict[Tuple[Any, ...], int]) -> None:\n        \"\"\"Saves the given counts, replacing previous results.\"\"\"\n        self._storage = dict(counts)\n\n    def get_all(self) -> Dict[Tuple[Any, ...], int]:\n        \"\"\"Retrieves the last saved counts.\"\"\"\n        return self._storage\n\n    def clear(self) -> None:\n        \"\"\"Clears the stored results.\"\"\"\n        self._storage = {}\nclass UniqueSublistService:\n    \"\"\"Core counting algorithm and orchestration.\"\"\"\n    def __init__(self, repo: InMemoryRepository = None, converter: TupleConverter = None):\n        self.repo = repo or InMemoryRepository()\n        self.converter = converter or TupleConverter()\n\n    def count_sublists(self, lists: List[List[Any]]) -> Dict[Tuple[Any, ...], int]:\n        \"\"\"Counts occurrences of sublists after converting them to tuples.\"\"\"\n        counts: Dict[Tuple[Any, ...], int] = {}\n        for sub in lists:\n            key = self.converter.list_to_tuple(sub)\n            counts[key] = counts.get(key, 0) + 1\n        self.repo.save_result(counts)\n        return counts\nclass InputValidator:\n    \"\"\"Validates the structure of the input lists.\"\"\"\n    def __init__(self):\n        pass\n\n    def validate(self, lists: Any) -> List[List[Any]]:\n        \"\"\"Validates input is a list of lists and returns a standardized version.\"\"\"\n        if not self._is_iterable(lists):\n            raise InvalidInputError(\"Top-level input must be a list or iterable of sublists.\")\n        \n        validated_top_level = list(lists)\n\n        validated_sublists: List[List[Any]] = []\n        for i, sub in enumerate(validated_top_level):\n            if not self._is_iterable(sub):\n                raise InvalidInputError(f\"Element at index {i} is not list-like: {type(sub).__name__}. Expected iterable, got {sub!r}.\")\n            validated_sublists.append(list(sub))\n        return validated_sublists\n\n    def _is_iterable(self, obj: Any) -> bool:\n        \"\"\"Checks if an object is iterable but not a string or bytes.\"\"\"\n        return isinstance(obj, collections.abc.Iterable) and not isinstance(obj, (str, bytes))\nclass UniqueSublistController:\n    \"\"\"Public controller that validates input and delegates to the service.\"\"\"\n    def __init__(self, validator: InputValidator = None, service: UniqueSublistService = None):\n        self.validator = validator or InputValidator()\n        self.service = service or UniqueSublistService()\n\n    def unique_sublists(self, lists: Any) -> Dict[Tuple[Any, ...], int]:\n        \"\"\"Validates input, counts sublist occurrences, and returns the result.\"\"\"\n        validated_lists = self.validator.validate(lists)\n        return self.service.count_sublists(validated_lists)\ndef unique_sublists(lists: List[List[Any]]) -> Dict[Tuple[Any, ...], int]:\n    \"\"\"\n    Counts occurrences of sublists in a list, converting each to a tuple key.\n    Returns a dictionary mapping unique tuple keys to their counts.\n    \"\"\"\n    _controller = UniqueSublistController()\n    return _controller.unique_sublists(lists)"}
{"task_id": "Mbpp/764", "solution": "def number_ctr(s):\n    \"\"\"Counts the number of ASCII digits (0-9) in a given string.\n\n    Assumes the input 's' is a string.\n    \"\"\"\n    count = 0\n    for char in s:\n        if '0' <= char <= '9':\n            count += 1\n    return count"}
{"task_id": "Mbpp/765", "solution": "def nth_polite(n: int) -> int:\n    \"\"\"Finds the nth polite number. A polite number is a positive integer that is not a power of two.\"\"\"\n\n    # Helper function to check if a number is a power of two.\n    # It assumes n is a positive integer as per problem context.\n    def _is_power_of_two(num: int) -> bool:\n        return (num > 0) and ((num & (num - 1)) == 0)\n\n    found_polite_count = 0\n    current_num = 1\n\n    while True:\n        if not _is_power_of_two(current_num):\n            found_polite_count += 1\n            if found_polite_count == n:\n                return current_num\n        current_num += 1"}
{"task_id": "Mbpp/766", "solution": "def pair_wise(items):\n    \"\"\"\n    Returns a list of all pairs of consecutive items in a given list.\n    \"\"\"\n    n = len(items)\n    if n < 2:\n        return []\n    \n    result = []\n    for i in range(n - 1):\n        result.append((items[i], items[i+1]))\n    return result"}
{"task_id": "Mbpp/767", "solution": "def get_pairs_count(nums, target):\n    \"\"\"\n    Counts the number of unordered pairs in a list whose sum equals a target value.\n    This implementation uses a frequency map for O(n) time complexity.\n    \"\"\"\n    freq = {}\n    count = 0\n    for x in nums:\n        complement = target - x\n        count += freq.get(complement, 0)\n        freq[x] = freq.get(x, 0) + 1\n    return count"}
{"task_id": "Mbpp/762", "solution": "def check_monthnumber_number(month_number):\n    \"\"\"\n    Checks if the given month number has 30 days.\n    Assumes month_number is an integer between 1 and 12.\n    \"\"\"\n    THIRTY_DAY_MONTHS = (4, 6, 9, 11)\n    return month_number in THIRTY_DAY_MONTHS"}
{"task_id": "Mbpp/770", "solution": "def odd_num_sum(n: int) -> int:\n    \"\"\"\n    Calculates the sum of the fourth power of the first n odd natural numbers\n    using a closed-form formula.\n    \"\"\"\n    if n == 0:\n        return 0\n\n    # Calculate sum of k (s1)\n    s1 = n * (n + 1) // 2\n    \n    # Calculate sum of k^2 (s2)\n    s2 = n * (n + 1) * (2 * n + 1) // 6\n    \n    # Calculate sum of k^3 (s3)\n    s3 = s1 * s1\n    \n    # Calculate sum of k^4 (s4)\n    s4 = n * (n + 1) * (2 * n + 1) * (3 * n * n + 3 * n - 1) // 30\n    \n    # Apply the closed-form formula for sum (2k-1)^4\n    return 16 * s4 - 32 * s3 + 24 * s2 - 8 * s1 + n"}
{"task_id": "Mbpp/771", "solution": "from typing import Callable, Optional, Tuple\n_BRACKETS = {')': '(', ']': '[', '}': '{'}\n_OPENING_BRACKETS = set(_BRACKETS.values())\n_CLOSING_BRACKETS = set(_BRACKETS.keys())\ndef _is_opening(ch: str) -> bool:\n    \"\"\"Checks if a character is an opening bracket.\"\"\"\n    return ch in _OPENING_BRACKETS\ndef _is_closing(ch: str) -> bool:\n    \"\"\"Checks if a character is a closing bracket.\"\"\"\n    return ch in _CLOSING_BRACKETS\ndef _matching_pair(opening: str, closing: str) -> bool:\n    \"\"\"Checks if the opening and closing brackets form a valid pair.\"\"\"\n    return _BRACKETS.get(closing) == opening\nclass _Stack:\n    \"\"\"A simple stack implementation.\"\"\"\n    def __init__(self) -> None:\n        self._items: list[Tuple[str, int]] = []\n\n    def push(self, item: Tuple[str, int]) -> None:\n        \"\"\"Pushes an item onto the stack.\"\"\"\n        self._items.append(item)\n\n    def pop(self) -> Tuple[str, int]:\n        \"\"\"Removes and returns the top item from the stack.\"\"\"\n        return self._items.pop()\n\n    def peek(self) -> Optional[Tuple[str, int]]:\n        \"\"\"Returns the top item without removing it, or None if the stack is empty.\"\"\"\n        return self._items[-1] if self._items else None\n\n    def is_empty(self) -> bool:\n        \"\"\"Checks if the stack is empty.\"\"\"\n        return len(self._items) == 0\n\n    def __len__(self) -> int:\n        \"\"\"Returns the number of items in the stack.\"\"\"\n        return len(self._items)\nclass _ExpressionResult:\n    \"\"\"Data transfer object for expression validation results.\"\"\"\n    def __init__(self, success: bool, error_index: Optional[int] = None, message: Optional[str] = None) -> None:\n        self.success = success\n        self.error_index = error_index\n        self.message = message\nclass _ExpressionValidator:\n    \"\"\"Core logic for validating bracket balance in expressions.\"\"\"\n    def __init__(self, stack_factory: Callable[[], _Stack] = _Stack) -> None:\n        self._brackets_map = _BRACKETS\n        self._opening_set = _OPENING_BRACKETS\n        self._closing_set = _CLOSING_BRACKETS\n        self._stack_factory = stack_factory\n\n    def check(self, expression: str, strict: bool = False) -> bool:\n        \"\"\"Performs a quick boolean check for balanced brackets.\"\"\"\n        return self.check_detailed(expression, strict).success\n\n    def check_detailed(self, expression: str, strict: bool = False) -> _ExpressionResult:\n        \"\"\"Performs detailed validation and returns diagnostic information.\"\"\"\n        stack = self._stack_factory()\n\n        if not expression:\n            return _ExpressionResult(True, None, \"Empty expression considered balanced\")\n\n        for i, ch in enumerate(expression):\n            if _is_opening(ch):\n                stack.push((ch, i))\n            elif _is_closing(ch):\n                if stack.is_empty():\n                    return _ExpressionResult(False, i, f\"Unmatched closing '{ch}' at index {i}\")\n                opening_char, _ = stack.peek() # Only need the char for matching\n                if _matching_pair(opening_char, ch):\n                    stack.pop()\n                else:\n                    return _ExpressionResult(False, i, f\"Mismatched closing '{ch}' at index {i}\")\n            else: # Non-bracket character\n                if strict:\n                    return _ExpressionResult(False, i, f\"Invalid character '{ch}' at index {i} in strict mode\")\n                # else: ignore non-brackets\n\n        if not stack.is_empty():\n            opening_char, idx = stack.peek()\n            return _ExpressionResult(False, idx, f\"Unmatched opening '{opening_char}' at index {idx}\")\n        \n        return _ExpressionResult(True, None, \"Balanced\")\n_default_validator = _ExpressionValidator()\ndef check_expression(expression: str, strict: bool = False) -> bool:\n    \"\"\"Checks if the given expression has balanced brackets.\"\"\"\n    return _default_validator.check(expression, strict)"}
{"task_id": "Mbpp/769", "solution": "def Diff(list_a, list_b):\n    \"\"\"\n    Computes the difference between two lists, returning elements from list_a\n    that are not in list_b, while preserving the relative order from list_a.\n    \"\"\"\n    result = []\n\n    # Attempt to use a set for efficient lookups if elements in list_b are hashable.\n    try:\n        b_set = set(list_b)\n        for item_a in list_a:\n            if item_a not in b_set:\n                result.append(item_a)\n    except TypeError:\n        # Fallback to a less efficient O(N*M) comparison for unhashable elements.\n        for item_a in list_a:\n            found_in_b = False\n            for item_b in list_b:\n                if item_a == item_b:\n                    found_in_b = True\n                    break\n            if not found_in_b:\n                result.append(item_a)\n\n    return result"}
{"task_id": "Mbpp/773", "solution": "def occurance_substring(text, pattern):\n    \"\"\"\n    Finds the first occurrence and position of a substring within a string.\n    Returns None if there is no match.\n    \"\"\"\n    idx = text.find(pattern)\n    if idx == -1:\n        return None\n    return (pattern, idx, idx + len(pattern))"}
{"task_id": "Mbpp/772", "solution": "import re\nfrom dataclasses import dataclass\nfrom typing import List, Tuple, Optional\ndef strip_non_alnum_edges(token: str) -> Tuple[str, str, str]:\n    \"\"\"Splits token into leading non-alphanumeric prefix, core alphanumeric substring, and trailing non-alphanumeric suffix.\"\"\"\n    if not token:\n        return '', '', ''\n\n    core_start = 0\n    while core_start < len(token) and not token[core_start].isalnum():\n        core_start += 1\n\n    core_end = len(token)\n    while core_end > core_start and not token[core_end - 1].isalnum():\n        core_end -= 1\n\n    prefix = token[:core_start]\n    core = token[core_start:core_end]\n    suffix = token[core_end:]\n\n    return prefix, core, suffix\ndef normalize_whitespace(text: str) -> str:\n    \"\"\"Collapses multiple whitespace sequences into single spaces and trims leading/trailing spaces.\"\"\"\n    return re.sub(r'\\s+', ' ', text).strip()\nclass StringTokenizer:\n    \"\"\"Converts raw text into a Token list and joins filtered tokens back into a string.\"\"\"\n    _chunk_re = re.compile(r'\\S+|\\s+')\n\n    def tokenize(self, text: str) -> List[Token]:\n        \"\"\"Splits text into tokens including separators.\"\"\"\n        tokens = []\n        for m in self._chunk_re.finditer(text):\n            chunk = m.group(0)\n            if chunk.isspace():\n                tokens.append(Token(raw=chunk, is_word=False, prefix='', core='', suffix=''))\n            else:\n                prefix, core, suffix = strip_non_alnum_edges(chunk)\n                is_word = len(core) > 0\n                tokens.append(Token(raw=chunk, is_word=is_word, prefix=prefix, core=core, suffix=suffix))\n        return tokens\n\n    def filter_tokens(self, tokens: List[Token], k: int) -> List[Token]:\n        \"\"\"Removes tokens whose core_length() equals k and are considered words.\"\"\"\n        kept_tokens = []\n        for token in tokens:\n            if token.is_word and token.core_length() == k:\n                continue\n            kept_tokens.append(token)\n        return kept_tokens\n\n    def join_tokens(self, tokens: List[Token]) -> str:\n        \"\"\"Concatenates the raw strings of the kept tokens.\"\"\"\n        return \"\".join(token.raw for token in tokens)\nclass TextProcessorService:\n    \"\"\"Orchestrates validation, tokenization, filtering, and result production.\"\"\"\n    def __init__(self, tokenizer: Optional[StringTokenizer] = None):\n        \"\"\"Initializes the service with an optional StringTokenizer instance.\"\"\"\n        self._tokenizer = tokenizer or StringTokenizer()\n\n    def remove_words_of_length(self, request: RemoveRequest) -> RemoveResult:\n        \"\"\"Processes the request to remove words of a specific length.\"\"\"\n        tokens = self._tokenizer.tokenize(request.text)\n        kept = self._tokenizer.filter_tokens(tokens, request.k)\n        raw_result = self._tokenizer.join_tokens(kept)\n        normalized = normalize_whitespace(raw_result)\n        return RemoveResult(normalized)\ndef remove_length(text: str, k: int) -> str:\n    \"\"\"Removes all words of length k from the given string, normalizing whitespace.\"\"\"\n    req = RemoveRequest(text=text, k=k)\n    svc = TextProcessorService()\n    result = svc.remove_words_of_length(req)\n    return result.result_text"}
{"task_id": "Mbpp/775", "solution": "def odd_position(lst: list[int]) -> bool:\n    \"\"\"\n    Checks if every odd index in the list contains an odd number.\n    Returns True if all conditions are met or the list is empty, False otherwise.\n    \"\"\"\n    for idx, num in enumerate(lst):\n        if idx % 2 == 1:  # Check if the current index is odd (1, 3, 5, ...)\n            if num % 2 == 0:  # Check if the number at this odd index is even\n                return False\n    return True"}
{"task_id": "Mbpp/777", "solution": "from collections import Counter\ndef find_sum(lst):\n    \"\"\"\n    Finds the sum of elements that appear exactly once in the given list.\n    Elements that appear multiple times are considered repeated and are not included in the sum.\n    \"\"\"\n    counts = Counter(lst)\n    total = 0\n    for item in lst:\n        if counts[item] == 1:\n            total += item\n    return total"}
{"task_id": "Mbpp/778", "solution": "def pack_consecutive_duplicates(lst):\n    \"\"\"\n    Packs consecutive duplicate elements of a list into sublists.\n    This function processes the list in a single pass to achieve O(n) time complexity.\n    \"\"\"\n    result = []\n    for item in lst:\n        if not result or result[-1][0] != item:\n            result.append([item])\n        else:\n            result[-1].append(item)\n    return result"}
{"task_id": "Mbpp/781", "solution": "import math\ndef count_divisors(n: int) -> bool:\n    \"\"\"\n    Checks if the count of positive divisors of n is even.\n    Assumes n is a positive integer (n >= 1).\n    \"\"\"\n    count = 0\n    limit = int(math.isqrt(n))\n    \n    for i in range(1, limit + 1):\n        if n % i == 0:\n            if i * i == n:\n                count += 1\n            else:\n                count += 2\n                \n    return count % 2 == 0"}
{"task_id": "Mbpp/780", "solution": "def find_combinations(list_of_pairs: List[Tuple[int, int]]) -> List[Tuple[int, int]]:\n    \"\"\"\n    Computes element-wise sums for all unordered pairs of 2-tuples from the input list.\n    \"\"\"\n    n = len(list_of_pairs)\n    result: List[Tuple[int, int]] = []\n    for i in range(n - 1):\n        for j in range(i + 1, n):\n            tuple1 = list_of_pairs[i]\n            tuple2 = list_of_pairs[j]\n            sum_tuple = (tuple1[0] + tuple2[0], tuple1[1] + tuple2[1])\n            result.append(sum_tuple)\n    return result"}
{"task_id": "Mbpp/782", "solution": "def odd_length_sum(arr: list[int]) -> int:\n    \"\"\"Calculates the sum of all odd-length subarrays in the given array using an O(n) approach.\"\"\"\n    n = len(arr)\n    total_sum = 0\n    for i, val in enumerate(arr):\n        # Calculate the total number of subarrays this element `val` (at index `i`) is part of.\n        # `i + 1` represents the number of choices for the starting point of a subarray ending at or before `i`.\n        # `n - i` represents the number of choices for the ending point of a subarray starting at or after `i`.\n        total_subarrays_including_val = (i + 1) * (n - i)\n        \n        # The number of odd-length subarrays including `val` is ceil(total_subarrays_including_val / 2).\n        # This can be expressed as (x + 1) // 2 using integer division.\n        odd_length_subarrays_count = (total_subarrays_including_val + 1) // 2\n        \n        total_sum += val * odd_length_subarrays_count\n    return total_sum"}
{"task_id": "Mbpp/784", "solution": "def mul_even_odd(nums: list[int]) -> int:\n    \"\"\"\n    Finds the product of the first even and first odd number in the list.\n    It iterates through the list to identify these numbers.\n    \"\"\"\n    first_odd = None\n    first_even = None\n\n    for num in nums:\n        if first_odd is None and num % 2 != 0:\n            first_odd = num\n        if first_even is None and num % 2 == 0:\n            first_even = num\n        \n        if first_odd is not None and first_even is not None:\n            break\n            \n    return first_odd * first_even"}
{"task_id": "Mbpp/786", "solution": "def right_insertion(seq, value):\n    \"\"\"\n    Locates the right insertion point for a value in a sorted sequence using binary search.\n    This finds the first index i such that all elements up to i-1 are <= value, and all elements from i onwards are > value.\n    \"\"\"\n    lo = 0\n    hi = len(seq)\n    while lo < hi:\n        mid = (lo + hi) // 2\n        if seq[mid] <= value:\n            lo = mid + 1\n        else:\n            hi = mid\n    return lo"}
{"task_id": "Mbpp/785", "solution": "from typing import List, Tuple\nclass TupleParseError(Exception):\n    \"\"\"Base exception for tuple parsing errors.\"\"\"\n    def __init__(self, input_value: str, reason: str):\n        super().__init__(f\"Error parsing '{input_value}': {reason}\")\n        self.input_value = input_value\n        self.reason = reason\nclass InvalidTupleStringError(TupleParseError):\n    \"\"\"Raised when the input string's structure is malformed.\"\"\"\n    pass\ndef parse_int(token: str) -> int:\n    \"\"\"Converts a string token to an integer, stripping whitespace.\"\"\"\n    token = token.strip()\n    if not token:\n        raise ValueError(\"empty token\")\n    if token[0] in \"+-\" and token[1:].isdigit():\n        return int(token)\n    if token.isdigit():\n        return int(token)\n    raise ValueError(f\"invalid integer token: {token!r}\")\nclass TupleStringValidator:\n    \"\"\"Validates the structure of a tuple string and extracts tokens.\"\"\"\n    TOKEN_SEPARATOR = \",\"\n\n    def validate(self, s: str) -> List[str]:\n        s = s.strip()\n        if not (s.startswith(\"(\") and s.endswith(\")\")):\n            raise InvalidTupleStringError(s, \"missing surrounding parentheses\")\n\n        inner = s[1:-1].strip()\n        if inner == \"\":\n            return []\n\n        tokens = [t.strip() for t in inner.split(self.TOKEN_SEPARATOR)]\n        if any(t == \"\" for t in tokens):\n            raise InvalidTupleStringError(s, \"empty token detected (e.g., trailing comma or consecutive commas)\")\n        return tokens\nclass TupleConverter:\n    \"\"\"Converts a list of string tokens into a tuple of integers.\"\"\"\n    def __init__(self, utils_parse_int_func=None):\n        self._parse_int = utils_parse_int_func or parse_int\n\n    def tokens_to_tuple(self, tokens: List[str]) -> Tuple[int, ...]:\n        return tuple(self._parse_int(t) for t in tokens)\nclass TupleConversionService:\n    \"\"\"Orchestrates validation and conversion of a tuple string.\"\"\"\n    def __init__(self, validator: TupleStringValidator, converter: TupleConverter):\n        self._validator = validator\n        self._converter = converter\n\n    def convert(self, tuple_str: str) -> Tuple[int, ...]:\n        tokens = self._validator.validate(tuple_str)\n        return self._converter.tokens_to_tuple(tokens)\ndef tuple_str_int(s: str) -> Tuple[int, ...]:\n    \"\"\"Converts a string representation of an integer tuple to an actual integer tuple.\"\"\"\n    validator = TupleStringValidator()\n    converter = TupleConverter()\n    service = TupleConversionService(validator, converter)\n    return service.convert(s)"}
{"task_id": "Mbpp/787", "solution": "import re\nfrom typing import List, Dict, Pattern as RePattern\nclass TextMatcherError(Exception):\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\nclass PatternNotFoundError(TextMatcherError):\n    def __init__(self, pattern_name: str) -> None:\n        super().__init__(f\"Pattern not found: {pattern_name}\")\n        self.pattern_name = pattern_name\nclass PatternAlreadyExistsError(TextMatcherError):\n    def __init__(self, pattern_name: str) -> None:\n        super().__init__(f\"Pattern already exists: {pattern_name}\")\n        self.pattern_name = pattern_name\nclass Pattern:\n    def __init__(self, name: str, regex: str) -> None:\n        if not name or not regex:\n            raise ValueError(\"name and regex must be non-empty\")\n        self.name: str = name\n        self.regex: str = regex\nclass PatternRepository:\n    def __init__(self) -> None:\n        self._store: Dict[str, Pattern] = {}\n\n    def add(self, pattern: Pattern) -> None:\n        if pattern.name in self._store:\n            raise PatternAlreadyExistsError(pattern.name)\n        self._store[pattern.name] = pattern\n\n    def get(self, name: str) -> Pattern:\n        try:\n            return self._store[name]\n        except KeyError:\n            raise PatternNotFoundError(name)\n            \n    def exists(self, name: str) -> bool:\n        return name in self._store\n\n    def list(self) -> List[Pattern]:\n        return list(self._store.values())\n\n    def remove(self, name: str) -> None:\n        if name not in self._store:\n            raise PatternNotFoundError(name)\n        del self._store[name]\nclass RegexMatcher:\n    def __init__(self) -> None:\n        self._cache: Dict[str, RePattern] = {}\n\n    def compile(self, regex: str) -> RePattern:\n        if regex not in self._cache:\n            self._cache[regex] = re.compile(regex)\n        return self._cache[regex]\n\n    def matches(self, regex: str, text: str) -> bool:\n        pat = self.compile(regex)\n        return bool(pat.search(text))\nclass PatternService:\n    def __init__(self, repo: PatternRepository, matcher: RegexMatcher) -> None:\n        self._repo = repo\n        self._matcher = matcher\n\n    def register_pattern(self, name: str, regex: str) -> None:\n        p = Pattern(name, regex)\n        self._repo.add(p)\n\n    def match_pattern(self, name: str, text: str) -> bool:\n        p = self._repo.get(name)\n        return self._matcher.matches(p.regex, text)\n\n    def match_inline(self, regex: str, text: str) -> bool:\n        return self._matcher.matches(regex, text)\ndef text_match_three(text: str) -> bool:\n    \"\"\"Matches a string that has an 'a' followed by three 'b's.\"\"\"\n    validate_text(text)\n    repo = PatternRepository()\n    matcher = RegexMatcher()\n    service = PatternService(repo, matcher)\n    service.register_pattern(\"text_match_three\", r\"ab{3}\")\n    return service.match_pattern(\"text_match_three\", text)"}
{"task_id": "Mbpp/788", "solution": "def new_tuple(list_of_str: list[str], extra_str: str) -> tuple[str, ...]:\n    \"\"\"\n    Creates a new tuple by combining a list of strings and an additional string.\n    The new tuple contains all elements from the list, followed by the extra string.\n    \"\"\"\n    return tuple(list_of_str) + (extra_str,)"}
{"task_id": "Mbpp/790", "solution": "def even_position(lst):\n    \"\"\"\n    Checks if every number at an even index in the list is an even number.\n    Returns True if all even-indexed numbers are even, False otherwise.\n    \"\"\"\n    for i in range(0, len(lst), 2):\n        if lst[i] % 2 != 0:\n            return False\n    return True"}
{"task_id": "Mbpp/793", "solution": "def last(arr, value):\n    \"\"\"\n    Finds the last (rightmost) position of an element in a sorted array.\n    Returns the 0-based index or -1 if the element is not found.\n    \"\"\"\n    left = 0\n    right = len(arr) - 1\n    result = -1\n\n    while left <= right:\n        mid = (left + right) // 2\n        if arr[mid] == value:\n            result = mid\n            left = mid + 1  # Found value, try to find a further right occurrence\n        elif arr[mid] < value:\n            left = mid + 1\n        else:  # arr[mid] > value\n            right = mid - 1\n    return result"}
{"task_id": "Mbpp/791", "solution": "def remove_nested(data: Tuple[Any, ...], deep: bool = False) -> Tuple[Any, ...]:\n    \"\"\"\n    Removes tuple elements from the given tuple.\n    If deep is True, it recursively removes tuples from nested containers.\n    \"\"\"\n    from typing import Any, Tuple, List, Dict, Set\n\n    if not deep:\n        # Top-level filtering: create a new tuple excluding any direct tuple elements.\n        return tuple(item for item in data if not isinstance(item, tuple))\n    else:\n        # Deep filtering: define a recursive helper function to process nested structures.\n        def _deep_filter(obj: Any) -> Any:\n            # If the object itself is a tuple, it should be removed from its parent container.\n            if isinstance(obj, tuple):\n                return None\n\n            # Recursively process elements of other container types.\n            if isinstance(obj, list):\n                new_list = []\n                for item in obj:\n                    transformed_item = _deep_filter(item)\n                    if transformed_item is not None:  # Filter out removed tuples (represented by None).\n                        new_list.append(transformed_item)\n                return new_list\n            elif isinstance(obj, dict):\n                new_dict = {}\n                for k, v in obj.items():\n                    transformed_value = _deep_filter(v)\n                    if transformed_value is not None:  # Filter out removed tuples (represented by None).\n                        new_dict[k] = transformed_value\n                return new_dict\n            elif isinstance(obj, set):\n                new_set = set()\n                for item in obj:\n                    transformed_item = _deep_filter(item)\n                    if transformed_item is not None:  # Filter out removed tuples (represented by None).\n                        try:\n                            new_set.add(transformed_item)\n                        except TypeError:\n                            # If a transformed item becomes unhashable (e.g., a list or dict), skip it for sets.\n                            pass\n                return new_set\n            else:\n                # Non-container, non-tuple item; return as is.\n                return obj\n\n        processed_elements = []\n        for item in data:\n            transformed_item = _deep_filter(item)\n            # For the top-level tuple, collect all non-removed (non-None) elements.\n            if transformed_item is not None:\n                processed_elements.append(transformed_item)\n        return tuple(processed_elements)"}
{"task_id": "Mbpp/794", "solution": "import re\nfrom typing import Optional, Dict, Any, Pattern\nclass InvalidInputError(Exception):\n    \"\"\"Exception raised for invalid input.\"\"\"\n    def __init__(self, message: str = \"Invalid input\") -> None:\n        super().__init__(message)\nclass PatternNotFoundError(Exception):\n    \"\"\"Exception raised when a requested pattern is not found.\"\"\"\n    def __init__(self, message: str = \"Pattern not found\") -> None:\n        super().__init__(message)\nclass InputValidator:\n    \"\"\"Utility class for validating input.\"\"\"\n    @staticmethod\n    def validate_text(text: Any) -> None:\n        \"\"\"Validates that the input is a non-empty string.\"\"\"\n        if not isinstance(text, str) or len(text) == 0:\n            raise InvalidInputError(\"Input must be a non-empty string.\")\nclass TextMatcher:\n    \"\"\"Performs regex matching using a compiled pattern.\"\"\"\n    def __init__(self, pattern: \"re.Pattern[str]\") -> None:\n        self._pattern = pattern\n\n    def matches(self, text: str) -> bool:\n        \"\"\"Checks if the pattern matches the entire text.\"\"\"\n        return bool(self._pattern.match(text))\nDEFAULT_PATTERNS: Dict[str, str] = {\"start_a_end_b\": r\"^a.*b$\"}\nclass RegexRepository:\n    \"\"\"Manages and caches compiled regex patterns.\"\"\"\n    def __init__(self, patterns: Optional[Dict[str,str]] = None) -> None:\n        self._patterns = dict(DEFAULT_PATTERNS)\n        if patterns:\n            self._patterns.update(patterns)\n        self._compiled_cache: Dict[str, re.Pattern] = {}\n\n    def register_pattern(self, name: str, pattern: str) -> None:\n        \"\"\"Registers or updates a regex pattern by name.\"\"\"\n        self._patterns[name] = pattern\n        if name in self._compiled_cache:\n            del self._compiled_cache[name]\n\n    def get_pattern(self, name: str) -> \"re.Pattern[str]\":\n        \"\"\"Retrieves a compiled regex pattern from the cache or compiles it.\"\"\"\n        if name not in self._patterns:\n            raise PatternNotFoundError(f\"Pattern '{name}' not found\")\n        if name not in self._compiled_cache:\n            self._compiled_cache[name] = re.compile(self._patterns[name])\n        return self._compiled_cache[name]\nclass MatcherService:\n    \"\"\"Orchestrates validation, pattern retrieval, and matching.\"\"\"\n    def __init__(self, repository: RegexRepository) -> None:\n        self.repository = repository\n\n    def matches(self, text: str, pattern_name: str = \"start_a_end_b\") -> bool:\n        \"\"\"Matches text against a specified regex pattern.\"\"\"\n        InputValidator.validate_text(text)\n        pattern = self.repository.get_pattern(pattern_name)\n        matcher = TextMatcher(pattern)\n        return matcher.matches(text)\n_default_repo = RegexRepository()\n_default_service = MatcherService(_default_repo)\ndef text_starta_endb(text: str) -> bool:\n    \"\"\"\n    Checks if a string starts with 'a', is followed by anything, and ends with 'b'.\n    This uses the predefined 'start_a_end_b' regex pattern.\n    \"\"\"\n    return _default_service.matches(text, pattern_name=\"start_a_end_b\")"}
{"task_id": "Mbpp/796", "solution": "from decimal import Decimal\ndef return_sum(d: dict) -> float:\n    \"\"\"\n    Calculates the sum of all numeric values in the given dictionary.\n    Non-numeric values are ignored.\n    \"\"\"\n    total = Decimal(0)\n    for value in d.values():\n        if isinstance(value, int):\n            total += Decimal(value)\n        elif isinstance(value, float):\n            # Convert float to string first to maintain precision with Decimal\n            total += Decimal(str(value))\n        elif isinstance(value, Decimal):\n            total += value\n    return float(total)"}
{"task_id": "Mbpp/792", "solution": "def count_list(number_of_lists):\n    \"\"\"Counts the number of top-level elements that are lists.\n\n    Assumes the input is an iterable containing various elements.\n    \"\"\"\n    count = 0\n    for item in number_of_lists:\n        if isinstance(item, list):\n            count += 1\n    return count"}
