{"task_id": "Mbpp/639", "solution": "class ValidationError(Exception):\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\ndef is_lowercase_start(name: str) -> bool:\n    \"\"\"Checks if a string starts with a lowercase letter.\"\"\"\n    if not name:\n        return False\n    first = name[0]\n    return first.isalpha() and first.islower()\ndef validate_names_input(names) -> list:\n    \"\"\"Validates the input names iterable and converts it to a list.\"\"\"\n    if names is None:\n        raise ValidationError(\"names cannot be None\")\n    try:\n        seq = list(names)\n    except TypeError:\n        raise ValidationError(\"names must be an iterable of strings\")\n    for n in seq:\n        if not isinstance(n, str):\n            raise ValidationError(\"all items must be strings\")\n    return seq\nclass NameFilterService:\n    def __init__(self) -> None:\n        pass\n\n    def filter_names(self, names: list) -> list:\n        \"\"\"Filters out names that start with a lowercase letter, assuming valid input.\"\"\"\n        result = []\n        for n in names:\n            if not is_lowercase_start(n):\n                result.append(n)\n        return result\nclass NameMetricsService:\n    def __init__(self) -> None:\n        pass\n\n    def sum_lengths(self, names: list) -> int:\n        \"\"\"Sums the lengths of all names in the list, assuming valid input.\"\"\"\n        total = 0\n        for n in names:\n            total += len(n)\n        return total\nclass Controller:\n    def __init__(self, filter_service: NameFilterService, metrics_service: NameMetricsService) -> None:\n        self._filter_service = filter_service\n        self._metrics_service = metrics_service\n\n    def sample_nam(self, names: list) -> int:\n        \"\"\"Orchestrates validation, filtering, and metric calculation.\"\"\"\n        names_list = validate_names_input(names)\n        filtered = self._filter_service.filter_names(names_list)\n        return self._metrics_service.sum_lengths(filtered)\ndef sample_nam(names):\n    \"\"\"\n    Sums the length of names after removing those starting with lowercase letters.\n    \"\"\"\n    filter_service = NameFilterService()\n    metrics_service = NameMetricsService()\n    controller = Controller(filter_service, metrics_service)\n    return controller.sample_nam(names)"}
{"task_id": "Mbpp/638", "solution": "def wind_chill(temp_c: float, wind_kmh: float) -> int:\n    \"\"\"\n    Calculates the wind chill index using the standard Canadian/meteorological formula\n    for temperature in Celsius and wind speed in km/h, rounded to the nearest integer.\n    \"\"\"\n    # Formula: WCI = 13.12 + 0.6215*T - 11.37*V^0.16 + 0.3965*T*V^0.16 (T=temp_c, V=wind_kmh).\n    # This implementation adheres to the explicit formula from the design context.\n\n    v16 = wind_kmh ** 0.16\n    raw_wind_chill = 13.12 + (0.6215 * temp_c) - (11.37 * v16) + (0.3965 * temp_c * v16)\n    return int(round(raw_wind_chill))"}
{"task_id": "Mbpp/643", "solution": "def text_match_wordz_middle(text: str) -> bool:\n    \"\"\"\n    Checks if a string contains 'z' in the middle of any word,\n    meaning not at the start or end of the word.\n    \"\"\"\n    import re\n\n    # Use a regex to find all words in the text, handling Unicode and punctuation.\n    # Words are sequences of word characters (\\w includes letters, numbers, and underscore).\n    word_pattern = re.compile(r'\\b\\w+\\b', re.UNICODE | re.IGNORECASE)\n\n    for match in word_pattern.finditer(text):\n        word = match.group(0)\n        # Check if the word contains 'z' at any position other than the first or last character.\n        # Iterate from the second character (index 1) up to the second to last character.\n        for i in range(1, len(word) - 1):\n            if word[i].lower() == 'z':\n                return True\n    return False"}
