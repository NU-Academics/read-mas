{"task_id": "Mbpp/118", "solution": "def string_to_list(text: str, preserve_empty: bool = False) -> list[str]:\n    \"\"\"\n    Converts a string to a list of strings by splitting on the space character.\n    Optionally preserves empty tokens resulting from multiple consecutive spaces.\n    \"\"\"\n    delimiter = ' '\n    tokens = text.split(delimiter)\n\n    if not preserve_empty:\n        tokens = [token for token in tokens if token]\n\n    return tokens"}
{"task_id": "Mbpp/111", "solution": "def common_in_nested_lists(lists: list[list[object]]) -> list[object]:\n    \"\"\"\n    Finds common elements in given nested lists, preserving the order of the first list.\n    Handles both hashable and unhashable elements.\n    \"\"\"\n    if not lists:\n        return []\n\n    first_list = lists[0]\n\n    try:\n        # Attempt set-based intersection for performance if elements are hashable.\n        list_sets = [set(lst) for lst in lists]\n        common_elements_set = set.intersection(*list_sets)\n        # Filter elements from the first list to maintain original order.\n        result = [x for x in first_list if x in common_elements_set]\n        return result\n    except TypeError:\n        # Fallback for lists containing unhashable elements (e.g., dicts, lists).\n        result = []\n        for item_from_first in first_list:\n            # Check if this item is present in all other sub-lists and not already in result.\n            if item_from_first not in result and all(\n                any(item_from_first == other_item for other_item in sublist)\n                for sublist in lists[1:]\n            ):\n                result.append(item_from_first)\n        return result"}
{"task_id": "Mbpp/119", "solution": "def search(nums: list[int]) -> int:\n    \"\"\"Finds the single element in a sorted array where all other elements appear twice.\"\"\"\n    lo, hi = 0, len(nums) - 1\n    while lo < hi:\n        mid = (lo + hi) // 2\n        if mid % 2 == 0:  # If mid is an even index\n            if nums[mid] == nums[mid + 1]:\n                lo = mid + 2\n            else:\n                hi = mid\n        else:  # If mid is an odd index\n            if nums[mid] == nums[mid - 1]:\n                lo = mid + 1\n            else:\n                hi = mid - 1\n    return nums[lo]"}
{"task_id": "Mbpp/120", "solution": "class InvalidInputError(Exception):\n    def __init__(self, message: str, details: any = None) -> None:\n        super().__init__(message)\n        self.message = message\n        self.details = details\nclass Pair:\n    \"\"\"Represents a validated pair of numeric values and provides numeric helpers.\"\"\"\n    def __init__(self, a: float, b: float) -> None:\n        self.a: float = float(a)\n        self.b: float = float(b)\n\n    def product(self) -> float:\n        \"\"\"Returns the product of the two numbers.\"\"\"\n        return self.a * self.b\n\n    def abs_product(self) -> float:\n        \"\"\"Returns the absolute product of the two numbers.\"\"\"\n        return abs(self.product())\n\n    def as_tuple(self) -> tuple[float, float]:\n        \"\"\"Returns the pair as a tuple.\"\"\"\n        return (self.a, self.b)\nclass MaxProductResult:\n    \"\"\"Encapsulates the maximum absolute product value and the pair that produced it.\"\"\"\n    def __init__(self, value: float, pair: Pair) -> None:\n        self.value = value\n        self.pair = pair\nclass InputValidator:\n    \"\"\"Validates and normalizes raw input into a list of Pair objects.\"\"\"\n    def validate(self, raw: any) -> list[Pair]:\n        try:\n            iterator = iter(raw)\n        except TypeError:\n            raise InvalidInputError(\"Input is not iterable\", {\"input\": repr(raw)})\n        pairs = []\n        for i, item in enumerate(iterator):\n            if not (isinstance(item, (list, tuple)) and len(item) == 2):\n                raise InvalidInputError(\"Each item must be a 2-element sequence\", {\"index\": i, \"item\": item})\n            a, b = item\n            try:\n                a_f = float(a); b_f = float(b)\n            except Exception:\n                raise InvalidInputError(\"Elements must be numeric\", {\"index\": i, \"item\": item})\n            pairs.append(Pair(a_f, b_f))\n        return pairs\nclass MaxProductService:\n    \"\"\"Computes the maximum absolute product from a list of Pair objects.\"\"\"\n    def compute_max(self, pairs: list[Pair]) -> MaxProductResult:\n        if not pairs:\n            raise ValueError(\"pairs list is empty\")\n        best = pairs[0]\n        best_val = best.abs_product()\n        for p in pairs[1:]:\n            v = p.abs_product()\n            if v > best_val:\n                best, best_val = p, v\n        return MaxProductResult(value=best_val, pair=best)\nclass MaxProductController:\n    \"\"\"Orchestrates input validation and maximum product computation.\"\"\"\n    def __init__(self, validator: InputValidator, service: MaxProductService) -> None:\n        self._validator = validator\n        self._service = service\n\n    def get_max_product(self, raw_input: any) -> MaxProductResult:\n        \"\"\"Validates input, computes the maximum absolute product, and returns the result.\"\"\"\n        validated_pairs = self._validator.validate(raw_input)\n        result = self._service.compute_max(validated_pairs)\n        return result\ndef max_product_tuple(pairs):\n    \"\"\"\n    Finds the maximum absolute product between numbers in pairs of tuples within a given list.\n    \"\"\"\n    controller = MaxProductController(InputValidator(), MaxProductService())\n    result = controller.get_max_product(pairs)\n    return result.value"}
{"task_id": "Mbpp/123", "solution": "def amicable_numbers_sum(limit: int) -> int:\n    import math\n\n    class CacheRepository:\n        \"\"\"Interface for a cache repository.\"\"\"\n        def get(self, key: int) -> int | None:\n            raise NotImplementedError\n        def set(self, key: int, value: int) -> None:\n            raise NotImplementedError\n\n    class InMemoryCache(CacheRepository):\n        \"\"\"In-memory dictionary-based cache.\"\"\"\n        def __init__(self) -> None:\n            self._store: dict[int, int] = {}\n\n        def get(self, key: int) -> int | None:\n            return self._store.get(key)\n\n        def set(self, key: int, value: int) -> None:\n            self._store[key] = value\n\n    class DivisorUtils:\n        \"\"\"Utility for computing the sum of proper divisors.\"\"\"\n        def __init__(self, cache: CacheRepository | None = None) -> None:\n            self._cache = cache\n\n        def sum_proper_divisors(self, n: int) -> int:\n            cached = self._cache.get(n) if self._cache else None\n            if cached is not None:\n                return cached\n            \n            if n == 1:\n                result = 0\n            else:\n                s = 1 \n                i = 2\n                root = int(math.isqrt(n))\n                while i <= root:\n                    if n % i == 0:\n                        s += i\n                        other = n // i\n                        if other != i:\n                            s += other\n                    i += 1\n                result = s\n            \n            if self._cache:\n                self._cache.set(n, result)\n            return result\n\n    class AmicableCalculator:\n        \"\"\"Orchestrates the detection and summation of amicable numbers.\"\"\"\n        def __init__(self, divisor_utils: DivisorUtils, cache: CacheRepository | None = None) -> None:\n            self.divisor_utils = divisor_utils\n            self.cache = cache \n\n        def _is_amicable(self, a: int) -> bool:\n            \"\"\"Checks if a given number 'a' is part of an amicable pair.\"\"\"\n            b = self.divisor_utils.sum_proper_divisors(a)\n            if b == a:\n                return False\n            return self.divisor_utils.sum_proper_divisors(b) == a\n\n        def amicable_numbers_sum(self, limit: int) -> int:\n            \"\"\"Computes the sum of all amicable numbers up to the specified limit.\"\"\"\n            amicable_set = set()\n            for a in range(2, limit + 1):\n                if self._is_amicable(a):\n                    amicable_set.add(a)\n                    b = self.divisor_utils.sum_proper_divisors(a)\n                    if b <= limit:\n                        amicable_set.add(b)\n            return sum(amicable_set)\n\n    _cache = InMemoryCache()\n    _div_utils = DivisorUtils(cache=_cache)\n    _calculator = AmicableCalculator(divisor_utils=_div_utils, cache=_cache)\n\n    return _calculator.amicable_numbers_sum(limit)"}
{"task_id": "Mbpp/125", "solution": "def find_length(s: str) -> int:\n    \"\"\"\n    Finds the maximum difference between the number of 0s and 1s in any substring.\n    This uses a variant of Kadane's algorithm by mapping '0' to 1 and '1' to -1.\n    \"\"\"\n    max_so_far = 0\n    current_max = 0\n    for char in s:\n        value = 1 if char == '0' else -1\n        current_max = max(value, current_max + value)\n        max_so_far = max(max_so_far, current_max)\n    return max_so_far"}
{"task_id": "Mbpp/128", "solution": "import string\ndef long_words(n: int, text: str) -> list[str]:\n    \"\"\"\n    Finds words that are longer than n characters from a given text.\n    Words are stripped of leading/trailing punctuation before the length check.\n    \"\"\"\n    raw_tokens = text.split()\n    cleaned_words = []\n    for token in raw_tokens:\n        # Remove leading and trailing punctuation from each token.\n        # Internal punctuation (like in \"don't\" or \"well-being\") is preserved.\n        cleaned_token = token.strip(string.punctuation)\n        if cleaned_token:  # Add only if the token is not empty after stripping\n            cleaned_words.append(cleaned_token)\n\n    # Filter the cleaned words, keeping only those strictly longer than n characters.\n    result = [word for word in cleaned_words if len(word) > n]\n    return result"}
{"task_id": "Mbpp/126", "solution": "def sum(a, b):\n    \"\"\"\n    Finds the sum of common divisors of two given numbers.\n    This function uses nested helper functions for GCD and divisor enumeration.\n    \"\"\"\n    import math\n    import builtins\n\n    def _gcd_helper(x: int, y: int) -> int:\n        \"\"\"Computes the greatest common divisor using the Euclidean algorithm.\"\"\"\n        x, y = builtins.abs(x), builtins.abs(y)\n        while y:\n            x, y = y, x % y\n        return x\n\n    def _get_divisors_helper(n: int) -> set[int]:\n        \"\"\"Enumerates all divisors of a non-negative integer.\"\"\"\n        if n <= 0:\n            return set()\n        divs = set()\n        # math.isqrt is efficient for integer square root.\n        limit = builtins.int(math.isqrt(n))\n        for i in builtins.range(1, limit + 1):\n            if n % i == 0:\n                divs.add(i)\n                divs.add(n // i)\n        return divs\n\n    # Treat negative integers by their absolute values, as per design.\n    a_abs, b_abs = builtins.abs(a), builtins.abs(b)\n\n    # If both inputs are zero, return 0 as a pragmatic design choice.\n    if a_abs == 0 and b_abs == 0:\n        return 0\n\n    # Compute the greatest common divisor (GCD) of the absolute values.\n    common_divisor_val = _gcd_helper(a_abs, b_abs)\n\n    # Find all divisors of the calculated GCD.\n    common_divs = _get_divisors_helper(common_divisor_val)\n\n    # Sum all the found common divisors using Python's built-in sum.\n    return builtins.sum(common_divs)"}
{"task_id": "Mbpp/129", "solution": "from typing import List\ndef magic_square_test(matrix: List[List[int]]) -> bool:\n    \"\"\"\n    Checks if a given square matrix is a magic square.\n    A magic square has the same sum for all rows, columns, and both main diagonals.\n    \"\"\"\n    n = len(matrix)\n\n    # Calculate the target magic sum from the first row.\n    magic_sum = sum(matrix[0])\n\n    # Check if all row sums are equal to the magic sum.\n    for row in matrix:\n        if sum(row) != magic_sum:\n            return False\n\n    # Check if all column sums are equal to the magic sum.\n    for j in range(n):\n        col_sum = 0\n        for i in range(n):\n            col_sum += matrix[i][j]\n        if col_sum != magic_sum:\n            return False\n\n    # Check the sum of the main diagonal (top-left to bottom-right).\n    main_diag_sum = 0\n    for i in range(n):\n        main_diag_sum += matrix[i][i]\n    if main_diag_sum != magic_sum:\n        return False\n\n    # Check the sum of the anti-diagonal (top-right to bottom-left).\n    anti_diag_sum = 0\n    for i in range(n):\n        anti_diag_sum += matrix[i][n - 1 - i]\n    if anti_diag_sum != magic_sum:\n        return False\n\n    # If all checks pass, the matrix is a magic square.\n    return True"}
