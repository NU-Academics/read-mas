{"task_id": "Mbpp/88", "solution": "from collections import Counter\nfrom dataclasses import dataclass\nfrom typing import Any, Dict, Sequence, Iterable\nclass FrequencyError(Exception):\n    \"\"\"Custom exception for all domain-level errors.\n    It carries a message describing the error cause.\n    \"\"\"\n    def __init__(self, message: str):\n        self.message = message\n        super().__init__(message)\nclass Validator:\n    \"\"\"Utility class for input validation.\n    It checks for iterable and hashable properties of objects.\n    \"\"\"\n    def is_iterable(self, obj: Any) -> bool:\n        try:\n            iter(obj)\n            return True\n        except TypeError:\n            return False\n\n    def ensure_hashable(self, item: Any) -> None:\n        try:\n            hash(item)\n        except TypeError:\n            raise FrequencyError(f\"Item {repr(item)} is not hashable.\")\nclass FrequencyService:\n    \"\"\"Business logic for counting element frequencies.\n    It validates input and uses collections.Counter for efficient counting.\n    \"\"\"\n    def __init__(self, validator: Validator = None):\n        self._validator = validator or Validator()\n\n    def count(self, seq: Sequence[Any]) -> FrequencyResult:\n        \"\"\"Computes frequency counts for a sequence.\n        Raises FrequencyError for non-iterable input.\n        \"\"\"\n        if not self._validator.is_iterable(seq):\n            raise FrequencyError(\"Provided object is not iterable.\")\n        return self.count_iterable(seq)\n\n    def count_iterable(self, iterable: Iterable[Any]) -> FrequencyResult:\n        \"\"\"Computes frequency counts for any iterable.\n        Raises FrequencyError if any item in the iterable is unhashable.\n        \"\"\"\n        counter = Counter()\n        for item in iterable:\n            try:\n                self._validator.ensure_hashable(item)\n            except FrequencyError as e:\n                raise FrequencyError(f\"Unhashable item in sequence: {e}\") from e\n            counter[item] += 1\n        return FrequencyResult.from_counts(dict(counter))\n_service = FrequencyService()\ndef freq_count(seq: list) -> dict:\n    \"\"\"\n    Calculates the frequency of elements in a list.\n    Returns a dictionary mapping each element to its count.\n    \"\"\"\n    return _service.count(seq).to_dict()"}
{"task_id": "Mbpp/90", "solution": "def len_log(words: list) -> int:\n    \"\"\"\n    Calculates the length of the longest word in a list of words, trimming whitespace.\n    Returns 0 if the input list is empty.\n    \"\"\"\n    if not words:\n        return 0\n    \n    max_length = 0\n    for word in words:\n        stripped_word_length = len(word.strip())\n        if stripped_word_length > max_length:\n            max_length = stripped_word_length\n            \n    return max_length"}
{"task_id": "Mbpp/86", "solution": "import os\nimport json\nimport shutil\nimport logging\nfrom pathlib import Path\nfrom typing import Optional, Any\nimport threading\nfrom datetime import datetime, timezone\nlogger = logging.getLogger(__name__)\ndef centered_hexagonal_number(n: int) -> int:\n    \"\"\"Computes the nth centered hexagonal number, utilizing caching and input validation.\"\"\"\n\n    # --- Exceptions (src/centered_hex/exceptions.py) ---\n    class CenteredHexError(Exception):\n        \"\"\"Base exception for centered hexagonal number calculation.\"\"\"\n        pass\n\n    class InvalidInputError(CenteredHexError):\n        \"\"\"Raised when input is invalid, e.g., non-positive integer.\"\"\"\n        pass\n\n    class CalculationError(CenteredHexError):\n        \"\"\"Raised when a mathematical calculation encounters an issue.\"\"\"\n        pass\n\n    class PersistenceError(CenteredHexError):\n        \"\"\"Raised when a cache persistence operation fails.\"\"\"\n        pass\n\n    # --- Config (src/centered_hex/config.py) ---\n    # Default configuration values for cache path, max cached number, and file permissions.\n    _CACHE_BASE_DIR = Path.home() / \".cache\" / \"centered_hex\"\n    CACHE_PATH: Path = _CACHE_BASE_DIR / \"cache.json\"\n    MAX_CACHE_N: int = 10000\n    CACHE_PERMISSIONS: int = 0o600  # User read/write only\n\n    # --- Utils (src/centered_hex/utils.py) ---\n    class Validator:\n        \"\"\"Utility class for validating various inputs.\"\"\"\n        def validate_positive_int(self, n: Any) -> int:\n            \"\"\"Validates if n is a positive integer (>= 1).\"\"\"\n            try:\n                val = int(n)\n            except (TypeError, ValueError):\n                raise InvalidInputError(f\"Value {n!r} is not an integer\")\n            if val < 1:\n                raise InvalidInputError(\"n must be >= 1\")\n            return val\n\n    def ensure_cache_dir(path: Path) -> None:\n        \"\"\"Ensures the parent directory of the given path exists with proper permissions.\"\"\"\n        try:\n            path.parent.mkdir(parents=True, exist_ok=True)\n            # Ensure permissions are set for the directory (adding execute bit for directories)\n            os.chmod(path.parent, CACHE_PERMISSIONS | 0o100)\n        except OSError as e:\n            raise PersistenceError(f\"Failed to create cache directory {path.parent}: {e}\") from e\n\n    def atomic_write_json(path: Path, data: dict) -> None:\n        \"\"\"Writes JSON data to a file atomically, creating a backup if file exists.\"\"\"\n        ensure_cache_dir(path)\n        temp_path = path.with_suffix(path.suffix + \".tmp\")\n        backup_path = path.with_suffix(path.suffix + \".bak\")\n\n        try:\n            with open(temp_path, \"w\", encoding=\"utf-8\") as f:\n                json.dump(data, f, ensure_ascii=False, indent=2)\n            os.chmod(temp_path, CACHE_PERMISSIONS)  # Set permissions on the temp file\n\n            if path.exists():\n                shutil.copy(path, backup_path)  # Create backup before moving\n            shutil.move(str(temp_path), str(path))  # Atomic replace\n\n        except Exception as e:\n            # Clean up temporary file on error\n            if temp_path.exists():\n                os.remove(temp_path)\n            logger.error(f\"Failed to write cache file {path}: {e}\")\n            raise PersistenceError(f\"Failed to write cache file {path}\") from e\n\n    # --- Models (src/centered_hex/models.py) ---\n    class CenteredHexNumber:\n        \"\"\"Data Transfer Object representing a computed centered hexagonal number.\"\"\"\n        def __init__(self, n: int, value: int, computed_at: datetime) -> None:\n            if n < 1:\n                raise ValueError(\"n must be >= 1\")\n            self.n = n\n            self.value = value\n            self.computed_at = computed_at\n\n        def to_dict(self) -> dict:\n            \"\"\"Serializes the object to a dictionary for JSON storage.\"\"\"\n            return {\n                \"n\": self.n,\n                \"value\": self.value,\n                \"computed_at\": self.computed_at.isoformat(),\n            }\n\n        @staticmethod\n        def from_dict(d: dict) -> \"CenteredHexNumber\":\n            \"\"\"Creates a CenteredHexNumber instance from a dictionary.\"\"\"\n            try:\n                n = d[\"n\"]\n                value = d[\"value\"]\n                # Use fromisoformat which handles 'Z' for UTC\n                computed_at = datetime.fromisoformat(d[\"computed_at\"])\n                return CenteredHexNumber(n, value, computed_at)\n            except (KeyError, ValueError) as e:\n                raise ValueError(f\"Invalid CenteredHexNumber dictionary: {d}\") from e\n\n    # --- Repositories (src/centered_hex/repositories.py) ---\n    class NumberRepository:\n        \"\"\"Manages read/write operations for the centered hexagonal number cache.\"\"\"\n        def __init__(self, cache_path: Path, max_cache_n: int = MAX_CACHE_N) -> None:\n            self._cache_path = cache_path\n            self._max_cache_n = max_cache_n\n            self._lock = threading.Lock()  # Guards concurrent writes to cache file\n            self._cache: Optional[dict[str, CenteredHexNumber]] = None  # In-memory cache\n\n        def _load_cache(self) -> dict[str, CenteredHexNumber]:\n            \"\"\"Loads the cache from the JSON file into memory.\"\"\"\n            if self._cache_path.exists():\n                try:\n                    with open(self._cache_path, \"r\", encoding=\"utf-8\") as f:\n                        raw_cache = json.load(f)\n                    return {k: CenteredHexNumber.from_dict(v) for k, v in raw_cache.items()}\n                except (json.JSONDecodeError, ValueError) as e:\n                    logger.warning(f\"Corrupted cache file {self._cache_path}, recreating: {e}\")\n                    return {}  # Return empty cache on error\n                except OSError as e:\n                    raise PersistenceError(f\"Failed to load cache from {self._cache_path}: {e}\") from e\n            return {}\n\n        def _write_cache(self, cache: dict[str, CenteredHexNumber]) -> None:\n            \"\"\"Writes the in-memory cache to the JSON file using atomic write.\"\"\"\n            serializable_cache = {str(k): v.to_dict() for k, v in cache.items()}\n            atomic_write_json(self._cache_path, serializable_cache)\n\n        def get(self, n: int) -> Optional[int]:\n            \"\"\"Retrieves a cached value for 'n', or None if not found.\"\"\"\n            with self._lock:\n                if self._cache is None:\n                    self._cache = self._load_cache()\n                hex_num = self._cache.get(str(n))\n                return hex_num.value if hex_num else None\n\n        def save(self, n: int, value: int) -> None:\n            \"\"\"Saves a computed value to the cache, respecting max_cache_n.\"\"\"\n            if n > self._max_cache_n:\n                return  # Do not cache if n is too large\n\n            with self._lock:\n                if self._cache is None:\n                    self._cache = self._load_cache()\n\n                self._cache[str(n)] = CenteredHexNumber(n=n, value=value, computed_at=datetime.now(timezone.utc))\n                self._write_cache(self._cache)\n\n    # --- Calculators (src/centered_hex/calculators.py) ---\n    class HexagonalCalculator:\n        \"\"\"Performs the mathematical computation of centered hexagonal numbers.\"\"\"\n        def __init__(self, repository: \"NumberRepository | None\" = None) -> None:\n            self._repository = repository\n\n        def _formula(self, n: int) -> int:\n            \"\"\"The mathematical formula for the nth centered hexagonal number.\"\"\"\n            return 3 * n * (n - 1) + 1\n\n        def compute(self, n: int) -> int:\n            \"\"\"Computes the centered hexagonal number for a given n without caching.\"\"\"\n            try:\n                return self._formula(n)\n            except Exception as exc:\n                raise CalculationError(f\"Failed computing centered hexagonal number for {n}\") from exc\n\n        def compute_with_cache(self, n: int) -> int:\n            \"\"\"Computes the number, first checking and then updating the cache.\"\"\"\n            if self._repository:\n                cached = self._repository.get(n)\n                if cached is not None:\n                    return cached\n            \n            value = self.compute(n)  # Calculate if not in cache\n            \n            if self._repository:\n                try:\n                    self._repository.save(n, value)\n                except PersistenceError:\n                    logger.warning(f\"Failed to save centered hexagonal number {n} to cache. Continuing without caching.\")\n            return value\n\n    # --- App (src/centered_hex/app.py) ---\n    class HexApp:\n        \"\"\"The main application orchestrator, wiring components together.\"\"\"\n        def __init__(self, calculator: HexagonalCalculator, repository: NumberRepository, validator: Validator) -> None:\n            self._calculator = calculator\n            self._repository = repository\n            self._validator = validator\n\n        def compute(self, n: int) -> int:\n            \"\"\"Validates input and computes the centered hexagonal number, using cache.\"\"\"\n            validated_n = self._validator.validate_positive_int(n)\n            return self._calculator.compute_with_cache(validated_n)\n\n        @classmethod\n        def create_default(cls, cache_path: Optional[Path] = None) -> \"HexApp\":\n            \"\"\"Factory method to create a default configured HexApp instance.\"\"\"\n            resolved_cache_path = cache_path if cache_path else CACHE_PATH\n            repository = NumberRepository(resolved_cache_path, MAX_CACHE_N)\n            calculator = HexagonalCalculator(repository)\n            validator = Validator()\n            return cls(calculator, repository, validator)\n\n    # --- Public API implementation (src/centered_hex/__init__.py) ---\n    # This section implements the centered_hexagonal_number function as per design.\n    app = HexApp.create_default()\n    return app.compute(n)"}
