{"task_id": "Mbpp/454", "solution": "import re\nfrom typing import Optional, Any, Dict\nclass MatchResult:\n    \"\"\"DTO for storing match results.\"\"\"\n    def __init__(self, success: bool, word: Optional[str], position: Optional[int]):\n        self._success = success\n        self._word = word\n        self._position = position\n\n    @property\n    def success(self) -> bool:\n        return self._success\n\n    @property\n    def word(self) -> Optional[str]:\n        return self._word\n\n    @property\n    def position(self) -> Optional[int]:\n        return self._position\n\n    def to_dict(self) -> Dict[str, Any]:\n        return {\"success\": self._success, \"word\": self._word, \"position\": self._position}\nclass RegexRepository:\n    \"\"\"Encapsulates regex compilation and searching for words containing 'z'.\"\"\"\n    WORD_REGEX = r\"\\b\\w*z\\w*\\b\"\n\n    def __init__(self, pattern: str = WORD_REGEX):\n        self.pattern_str = pattern\n        self.compiled = re.compile(self.pattern_str, re.IGNORECASE)\n\n    def search(self, text: str) -> Optional[MatchResult]:\n        m = self.compiled.search(text)\n        if not m:\n            return None\n        return MatchResult(True, m.group(0), m.start())\nclass TextMatchService:\n    \"\"\"Provides business logic for checking if text contains a word with 'z'.\"\"\"\n    def __init__(self, repository: RegexRepository):\n        self.repository = repository\n\n    def contains_word_with_z(self, text: str) -> MatchResult:\n        repo_result = self.repository.search(text)\n        if repo_result is None:\n            return MatchResult(False, None, None)\n        return repo_result\ndef text_match_wordz(text: str) -> bool:\n    \"\"\"\n    Checks if the input text contains at least one word that includes the letter 'z' (case-insensitive).\n    \"\"\"\n    service = TextMatchService(RegexRepository())\n    result = service.contains_word_with_z(text)\n    return bool(result.success)"}
{"task_id": "Mbpp/457", "solution": "from typing import List, Any\ndef Find_Min(data: List[List[Any]]) -> List[Any]:\n    \"\"\"\n    Finds the sublist with the minimum length from a list of lists.\n    If multiple sublists have the same minimum length, the first one encountered is returned.\n    \"\"\"\n    min_sublist = data[0]\n    min_length = len(data[0])\n\n    for sublist in data[1:]:\n        current_length = len(sublist)\n        if current_length < min_length:\n            min_length = current_length\n            min_sublist = sublist\n            \n    return min_sublist"}
