{"task_id": "Mbpp/294", "solution": "def max_val(values):\n    \"\"\"\n    Finds the maximum numeric value in a heterogeneous list, ignoring non-numeric items.\n    Returns None if no numeric values are found.\n    \"\"\"\n    current_max = None\n    for item in values:\n        try:\n            numeric_value = float(item)\n        except (ValueError, TypeError):\n            # Item is not directly convertible to float, so it's ignored.\n            continue\n\n        if current_max is None or numeric_value > current_max:\n            current_max = numeric_value\n    return current_max"}
{"task_id": "Mbpp/297", "solution": "def flatten_list(lst: list) -> list:\n    \"\"\"\n    Flattens a given nested list or tuple structure into a single list.\n    It preserves the order of elements and handles arbitrary nesting depth.\n    \"\"\"\n    result = []\n    stack = [iter(lst)]\n    while stack:\n        try:\n            item = next(stack[-1])\n        except StopIteration:\n            stack.pop()\n            continue\n        if isinstance(item, (list, tuple)):\n            stack.append(iter(item))\n        else:\n            result.append(item)\n    return result"}
{"task_id": "Mbpp/299", "solution": "def max_aggregate(records: list[tuple[str, int]]) -> tuple[str, int]:\n    \"\"\"Calculates the name with the highest aggregate value from a list of (name, value) tuples.\n    In case of a tie, the name encountered first in the input list (or its first update) wins.\n    \"\"\"\n    name_aggregates = {}\n    for name, value in records:\n        name_aggregates[name] = name_aggregates.get(name, 0) + value\n\n    if not name_aggregates:\n        # This case is technically an \"edge case\" which the prompt says not to raise for.\n        # However, it's covered by the \"non-empty list\" precondition in the design.\n        # If input is empty, name_aggregates will be empty, leading to ValueError on max().\n        # Assuming valid non-empty input as per design context (FR1 preconditions).\n        # Return sensible default or raise, given constraints, returning (None, 0)\n        # or similar might be an implicit requirement but the problem implies non-empty input.\n        # The prompt says \"Do NOT add isinstance() checks or raise exceptions for edge cases\".\n        # If the input list is truly empty, max() on an empty dict's values will raise ValueError.\n        # Per design context FR1, records is non-empty, so name_aggregates will not be empty.\n        pass\n\n    max_aggregate_value = -float('inf')\n    for value in name_aggregates.values():\n        if value > max_aggregate_value:\n            max_aggregate_value = value\n\n    max_name = None\n    for name, value in name_aggregates.items():\n        if value == max_aggregate_value:\n            max_name = name\n            break  # First-seen tie-breaker\n\n    return (max_name, max_aggregate_value)"}
{"task_id": "Mbpp/301", "solution": "from typing import Any, Optional, Set\nclass DepthError(Exception):\n    \"\"\"Custom exception for depth calculation errors.\"\"\"\n    pass\nclass Validator:\n    \"\"\"Utility class for validating inputs.\"\"\"\n    def is_dict(self, obj: Any) -> bool:\n        \"\"\"Checks if an object is a dictionary.\"\"\"\n        return isinstance(obj, dict)\n\n    def validate_max_depth(self, max_depth: Optional[int]) -> None:\n        \"\"\"Validates the max_depth parameter.\"\"\"\n        if max_depth is not None and (not isinstance(max_depth, int) or max_depth < 0):\n            raise DepthError(\"max_depth must be a non-negative integer or None.\")\nclass DepthCalculator:\n    \"\"\"Core logic for calculating dictionary depth.\"\"\"\n    def __init__(self, validator: Validator, max_default: int) -> None:\n        self._validator = validator\n        self._max_default = max_default\n\n    def compute_depth(self, obj: Any, max_depth: Optional[int] = None) -> int:\n        \"\"\"Computes the maximum nesting depth of a dictionary.\"\"\"\n        self._validator.validate_max_depth(max_depth)\n        if not self._validator.is_dict(obj):\n            return 0\n        \n        effective_max_depth = max_depth if max_depth is not None else self._max_default\n        visited: Set[int] = set()\n        return self._compute_depth_recursive(obj, 1, visited, effective_max_depth)\n\n    def _compute_depth_recursive(self, obj: Any, current_depth: int, visited: Set[int], max_depth: int) -> int:\n        \"\"\"Recursive helper to traverse dictionary and find depth.\"\"\"\n        if current_depth > max_depth:\n            raise DepthError(f\"Exceeded max_depth {max_depth}\")\n\n        oid = id(obj)\n        if oid in visited:\n            raise DepthError(\"Cycle detected in dictionary structure\")\n        visited.add(oid)\n\n        max_found = current_depth\n        for v in obj.values():\n            if self._validator.is_dict(v):\n                depth = self._compute_depth_recursive(v, current_depth + 1, visited, max_depth)\n                if depth > max_found:\n                    max_found = depth\n        \n        visited.remove(oid)\n        return max_found\ndef dict_depth(obj: Any, max_depth: Optional[int] = None) -> int:\n    \"\"\"\n    Calculates the maximum nesting depth of a dictionary.\n    Non-dict objects have depth 0. An empty dict {} has depth 1.\n    \"\"\"\n    validator = Validator()\n    # Default max_depth from design config.py\n    calculator = DepthCalculator(validator, max_default=10000)\n    return calculator.compute_depth(obj, max_depth)"}
{"task_id": "Mbpp/308", "solution": "import heapq\ndef large_product(list_a, list_b, k):\n    \"\"\"\n    Finds the specified number of largest products from two given lists.\n    \"\"\"\n    min_heap = []\n    for x in list_a:\n        for y in list_b:\n            val = x * y\n            if len(min_heap) < k:\n                heapq.heappush(min_heap, val)\n            else:\n                if val > min_heap[0]:\n                    heapq.heapreplace(min_heap, val)\n    return sorted(min_heap, reverse=True)"}
