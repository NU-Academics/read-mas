{"task_id": "Mbpp/573", "solution": "def unique_product(numbers):\n    \"\"\"\n    Calculates the product of the unique numbers in a given list.\n    Returns 1 for an empty list.\n    \"\"\"\n    unique_nums = set(numbers)\n\n    product_accumulator = 1\n    for num in unique_nums:\n        product_accumulator *= num\n    return product_accumulator"}
{"task_id": "Mbpp/576", "solution": "def is_Sub_Array(haystack, needle):\n    \"\"\"\n    Checks if 'needle' is a contiguous sublist of 'haystack'.\n    Returns True if found, False otherwise.\n    \"\"\"\n    if not needle:\n        return True\n    if len(needle) > len(haystack):\n        return False\n\n    for i in range(len(haystack) - len(needle) + 1):\n        if haystack[i:i + len(needle)] == needle:\n            return True\n    return False"}
{"task_id": "Mbpp/578", "solution": "def interleave_lists(a, b, c):\n    \"\"\"\n    Interleaves three lists of the same length into a single flat list.\n    Assumes all input lists are of equal length.\n    \"\"\"\n    n = len(a)\n    result = []\n    for i in range(n):\n        result.append(a[i])\n        result.append(b[i])\n        result.append(c[i])\n    return result"}
{"task_id": "Mbpp/577", "solution": "def last_Digit_Factorial(n):\n    \"\"\"\n    Finds the last digit of the factorial of a given non-negative number.\n    For n >= 5, the last digit of n! is 0.\n    \"\"\"\n    if n >= 5:\n        return 0\n    \n    # Calculate factorial for n < 5 and return its last digit\n    factorial_values = [1, 1, 2, 6, 24] # 0!, 1!, 2!, 3!, 4!\n    return factorial_values[n] % 10"}
{"task_id": "Mbpp/580", "solution": "def extract_even(value: tuple) -> tuple:\n    \"\"\"Removes odd integers from a nested tuple, preserving structure and removing empty resulting tuples.\"\"\"\n\n    def _is_even(n: int) -> bool:\n        \"\"\"Checks if an integer is even.\"\"\"\n        return (n % 2) == 0\n\n    def _process_tuple_recursive(t: tuple) -> tuple:\n        \"\"\"Recursively processes a tuple to extract even numbers.\"\"\"\n        result = []\n        for el in t:\n            if isinstance(el, int):\n                if _is_even(el):\n                    result.append(el)\n            elif isinstance(el, tuple):\n                cleaned_nested = _process_tuple_recursive(el)\n                if cleaned_nested:\n                    result.append(cleaned_nested)\n            # Other types are implicitly skipped as per requirements to avoid extra checks/exceptions.\n        return tuple(result)\n\n    return _process_tuple_recursive(value)"}
{"task_id": "Mbpp/579", "solution": "def find_dissimilar(a, b):\n    \"\"\"\n    Finds elements present in exactly one of the two input tuples,\n    preserving their original order and grouped by source tuple.\n    \"\"\"\n    a_set = set(a)\n    b_set = set(b)\n    \n    out = []\n    seen = set()\n\n    for x in a:\n        if x not in b_set and x not in seen:\n            out.append(x)\n            seen.add(x)\n            \n    for x in b:\n        if x not in a_set and x not in seen:\n            out.append(x)\n            seen.add(x)\n            \n    return tuple(out)"}
