{"task_id": "Mbpp/453", "solution": "import math\ndef sumofFactors(n: int) -> int:\n    \"\"\"Finds the sum of even factors of a number.\n    Returns 0 for non-positive inputs.\n    \"\"\"\n    if n <= 0:\n        return 0\n\n    even_factors = set()\n    root = int(math.isqrt(n))\n\n    for d in range(1, root + 1):\n        if n % d == 0:\n            # Check the current divisor 'd'\n            if d % 2 == 0:\n                even_factors.add(d)\n\n            # Check the complementary divisor 'other'\n            other = n // d\n            if other != d:  # Only consider 'other' if it's distinct from 'd'\n                if other % 2 == 0:\n                    even_factors.add(other)\n\n    return sum(even_factors)"}
{"task_id": "Mbpp/448", "solution": "class PerrinError(Exception):\n    \"\"\"Base exception for Perrin number calculations.\"\"\"\n    pass\nclass InvalidInputError(PerrinError):\n    \"\"\"Raised when an invalid input is provided.\"\"\"\n    pass\nclass Validator:\n    \"\"\"Provides utility methods for validating inputs.\"\"\"\n    @staticmethod\n    def validate_index(value) -> int:\n        \"\"\"Validates if the value is a non-negative integer, raising InvalidInputError if not.\"\"\"\n        try:\n            n = int(value)\n        except (TypeError, ValueError):\n            raise InvalidInputError(f\"Index must be an integer, got {value!r}\")\n        if n < 0:\n            raise InvalidInputError(\"Index must be >= 0\")\n        return n\nclass PerrinModel:\n    \"\"\"Computes individual Perrin numbers based on their recurrence relation.\"\"\"\n    BASE_VALUES = {0: 3, 1: 0, 2: 2}\n\n    def next(self, index: int, cache: dict[int,int]) -> int:\n        \"\"\"Calculates P(index) using previous values from the provided cache or base values.\"\"\"\n        if index < 0:\n            raise InvalidInputError(\"Index must be >= 0\")\n        \n        if index in self.BASE_VALUES:\n            return self.BASE_VALUES[index]\n        \n        if index in cache:\n            return cache[index]\n\n        val_minus_2 = cache.get(index - 2)\n        val_minus_3 = cache.get(index - 3)\n\n        if val_minus_2 is None or val_minus_3 is None:\n            raise PerrinError(f\"Missing required previous Perrin numbers for index {index} in cache.\")\n        \n        return val_minus_2 + val_minus_3\nclass PerrinRepository:\n    \"\"\"Manages an in-memory cache for computed Perrin numbers.\"\"\"\n    def __init__(self):\n        \"\"\"Initializes the repository, seeding it with the base Perrin values.\"\"\"\n        self._store: dict[int,int] = {0:3, 1:0, 2:2}\n\n    def get(self, index: int) -> int | None:\n        \"\"\"Retrieves a Perrin number by its index.\"\"\"\n        return self._store.get(index)\n\n    def set(self, index: int, value: int) -> None:\n        \"\"\"Stores a computed Perrin number for a given index.\"\"\"\n        self._store[index] = value\n\n    def bulk_get_max_index(self) -> int:\n        \"\"\"Returns the highest index currently stored in the repository, or -1 if empty.\"\"\"\n        return max(self._store.keys()) if self._store else -1\n\n    def clear(self) -> None:\n        \"\"\"Clears all stored Perrin numbers from the repository.\"\"\"\n        self._store.clear()\nclass PerrinService:\n    \"\"\"Orchestrates the computation and storage of Perrin numbers and their sums.\"\"\"\n    def __init__(self, repo: PerrinRepository, model: PerrinModel) -> None:\n        \"\"\"Initializes the service with a repository and a model.\"\"\"\n        self._repo = repo\n        self._model = model\n\n    def ensure_up_to(self, n: int) -> None:\n        \"\"\"Ensures that all Perrin numbers from P(0) to P(n) are computed and stored.\"\"\"\n        max_cached = self._repo.bulk_get_max_index()\n        if max_cached >= n:\n            return\n        \n        cache = {i: self._repo.get(i) for i in range(0, max_cached + 1)} if max_cached >= 0 else {}\n        \n        for idx in range(max_cached + 1, n + 1):\n            val = self._model.next(idx, cache)\n            cache[idx] = val\n            self._repo.set(idx, val)\n\n    def value_at(self, n: int) -> int:\n        \"\"\"Retrieves the Perrin number at a specific index n, computing it if necessary.\"\"\"\n        self.ensure_up_to(n)\n        val = self._repo.get(n)\n        if val is None:\n            raise PerrinError(f\"Perrin number for index {n} not found after computation.\")\n        return val\n\n    def sum_up_to(self, n: int) -> int:\n        \"\"\"Calculates the sum of Perrin numbers from P(0) up to P(n), inclusive.\"\"\"\n        self.ensure_up_to(n)\n        total = 0\n        for i in range(0, n + 1):\n            v = self._repo.get(i)\n            if v is None:\n                raise PerrinError(f\"Perrin number P({i}) unexpectedly missing from repository during summation.\")\n            total += v\n        return total\nclass PerrinController:\n    \"\"\"Acts as the public API layer, handling input validation and delegating to the service.\"\"\"\n    def __init__(self, service: PerrinService) -> None:\n        \"\"\"Initializes the controller with a PerrinService instance.\"\"\"\n        self._service = service\n\n    def cal_sum(self, n: int) -> int:\n        \"\"\"Validates the input 'n' and returns the sum of Perrin numbers up to 'n'.\"\"\"\n        n_valid = Validator.validate_index(n)\n        return self._service.sum_up_to(n_valid)\n_repo = PerrinRepository()\n_model = PerrinModel()\n_service = PerrinService(_repo, _model)\n_controller = PerrinController(_service)\ndef cal_sum(n):\n    \"\"\"Calculates the sum of Perrin numbers from P(0) to P(n) inclusive.\"\"\"\n    return _controller.cal_sum(n)"}
