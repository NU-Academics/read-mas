{"task_id": "Mbpp/145", "solution": "def max_Abs_Diff(arr):\n    \"\"\"\n    Finds the maximum difference between any two elements in a given array.\n    Assumes the array contains numeric elements and is not empty.\n    \"\"\"\n    if not arr:\n        # Based on design context assumption 3, an empty sequence is invalid.\n        # However, per strict instruction \"DO NOT add isinstance() checks or raise exceptions for edge cases\",\n        # this explicit check and potential ValueError raise is technically an exception for an edge case.\n        # Given the provided assert, a non-empty list is expected.\n        # Standard Python built-in min/max functions already handle this by raising ValueError.\n        pass\n\n    minimum = min(arr)\n    maximum = max(arr)\n    return maximum - minimum"}
{"task_id": "Mbpp/161", "solution": "from typing import Sequence, TypeVar, List\nT = TypeVar(\"T\")\ndef remove_elements(source: Sequence[T], to_remove: Sequence[T]) -> List[T]:\n    \"\"\"\n    Removes all elements from the source list that are present in the to_remove list.\n    Preserves the original order of the remaining elements.\n    \"\"\"\n    if not to_remove:\n        return list(source)\n\n    try:\n        to_remove_set = set(to_remove)\n        return [item for item in source if item not in to_remove_set]\n    except TypeError:\n        result = []\n        for s_item in source:\n            found_in_remove = False\n            for r_item in to_remove:\n                if s_item == r_item:\n                    found_in_remove = True\n                    break\n            if not found_in_remove:\n                result.append(s_item)\n        return result"}
{"task_id": "Mbpp/165", "solution": "def count_char_position(s: str) -> int:\n    \"\"\"\n    Counts characters in a string that occur at the same position as in the English alphabet (case insensitive).\n    Positions are 1-based; non-letters occupy positions but do not match.\n    \"\"\"\n    match_count = 0\n    for position, char in enumerate(s, start=1):\n        lower_char = char.lower()\n        if 'a' <= lower_char <= 'z':\n            alphabet_index = ord(lower_char) - ord('a') + 1\n            if alphabet_index == position:\n                match_count += 1\n    return match_count"}
{"task_id": "Mbpp/162", "solution": "def sum_series(n: int) -> int:\n    \"\"\"Calculates the sum of the series (n - 2*i) from i=0 to n // 2.\"\"\"\n    # The series is an arithmetic progression: n, n-2, n-4, ..., until the term is non-negative.\n    # The number of terms in this series is (n // 2) + 1.\n    num_terms = n // 2 + 1\n    \n    # The first term is n.\n    # The last term is n - 2 * (num_terms - 1).\n    first_term = n\n    last_term = n - 2 * (num_terms - 1)\n    \n    # The sum of an arithmetic progression is (number of terms) * (first term + last term) / 2.\n    # Using integer division // 2 to ensure integer result as per requirement.\n    total_sum = num_terms * (first_term + last_term) // 2\n    \n    return total_sum"}
{"task_id": "Mbpp/141", "solution": "def pancake_sort(elements: list) -> list:\n    \"\"\"Sorts a list of elements using the pancake sort algorithm in ascending order.\"\"\"\n    arr = list(elements)  # Create a copy to avoid mutating the original list\n    n = len(arr)\n\n    def _flip(arr_to_flip: list, k: int) -> None:\n        \"\"\"Reverses the prefix of the array up to index k-1.\"\"\"\n        start = 0\n        end = k - 1\n        while start < end:\n            arr_to_flip[start], arr_to_flip[end] = arr_to_flip[end], arr_to_flip[start]\n            start += 1\n            end -= 1\n\n    def _find_max_index(arr_to_search: list, size: int) -> int:\n        \"\"\"Finds the index of the maximum element in a given prefix of the array.\"\"\"\n        max_idx = 0\n        for i in range(1, size):\n            if arr_to_search[i] > arr_to_search[max_idx]:\n                max_idx = i\n        return max_idx\n\n    for curr_size in range(n, 1, -1):\n        # Find the index of the maximum element in the current unsorted sub-array arr[0...curr_size-1]\n        max_idx = _find_max_index(arr, curr_size)\n\n        # If the maximum element is not already at its correct position\n        if max_idx != curr_size - 1:\n            # Move the maximum element to the beginning of the sub-array\n            if max_idx != 0:\n                _flip(arr, max_idx + 1)\n            \n            # Move the maximum element from the beginning to its correct position\n            _flip(arr, curr_size)\n            \n    return arr"}
{"task_id": "Mbpp/166", "solution": "def find_even_pair(numbers: list[int]) -> int:\n    \"\"\"\n    Counts pairs of integers in a list whose bitwise XOR results in an even number.\n    Two numbers XOR to an even number if and only if they have the same parity.\n    \"\"\"\n    n_even = 0\n    n_odd = 0\n    for num in numbers:\n        if (num & 1) == 0:  # Check if number is even\n            n_even += 1\n        else:\n            n_odd += 1\n\n    # Calculate combinations of even numbers (nC2) and odd numbers (nC2)\n    # nC2 = n * (n - 1) // 2\n    pairs_from_evens = n_even * (n_even - 1) // 2\n    pairs_from_odds = n_odd * (n_odd - 1) // 2\n\n    return pairs_from_evens + pairs_from_odds"}
{"task_id": "Mbpp/160", "solution": "def find_solution(a: int, b: int, n: int) -> tuple[int, int] | None:\n    \"\"\"\n    Returns integers x and y that satisfy ax + by = n as a tuple,\n    or None if no solution exists.\n    \"\"\"\n\n    def _extended_gcd(val_a: int, val_b: int) -> tuple[int, int, int]:\n        \"\"\"\n        Computes (g, x, y) such that val_a*x + val_b*y = g, where g is gcd(val_a, val_b).\n        \"\"\"\n        old_r, r = abs(val_a), abs(val_b)\n        old_s, s = 1, 0\n        old_t, t = 0, 1\n        while r != 0:\n            q = old_r // r\n            old_r, r = r, old_r - q * r\n            old_s, s = s, old_s - q * s\n            old_t, t = t, old_t - q * t\n        g = old_r\n        # Adjust signs of Bezout coefficients if original inputs were negative\n        if val_a < 0:\n            old_s = -old_s\n        if val_b < 0:\n            old_t = -old_t\n        return g, old_s, old_t\n\n    # Handle the degenerate case where both coefficients are zero\n    if a == 0 and b == 0:\n        if n == 0:\n            return (0, 0)\n        return None\n\n    # Compute GCD and Bezout coefficients using the extended Euclidean algorithm\n    g, x0, y0 = _extended_gcd(a, b)\n\n    # Check if a solution exists (n must be divisible by gcd(a,b))\n    if n % g != 0:\n        return None\n\n    # Calculate a particular solution\n    scale = n // g\n    x_particular = x0 * scale\n    y_particular = y0 * scale\n\n    # Normalize the solution to a canonical form, typically by adjusting x to a specific range.\n    # This ensures a consistent output for the infinite solutions.\n    if b != 0:\n        # The step size for x is b/g. We adjust x_particular by multiples of step_x.\n        step_x = b // g\n        x_final = x_particular % step_x\n        # Recalculate y based on the normalized x\n        y_final = (n - a * x_final) // b\n    elif a != 0: # If b is 0, but a is not (already handled a=b=0 above)\n        # In this case, ax = n, so x is fixed, and y can be any integer.\n        # Our particular solution gives y_particular = 0, which is canonical.\n        x_final = x_particular\n        y_final = y_particular\n    else: # This branch should theoretically be unreachable due to initial a=b=0 check.\n        return None\n\n    return (x_final, y_final)"}
