{"task_id": "Mbpp/465", "solution": "from typing import Any, Dict\ndef drop_empty(data: Dict[str, Any], remove_none: bool = True,\n               remove_empty_strings: bool = True, remove_empty_containers: bool = True,\n               strip_strings: bool = False, recursive: bool = True) -> Dict[str, Any]:\n    \"\"\"\n    Drops empty items from a dictionary, optionally recursively, based on provided flags.\n    Returns a new dictionary without mutating the original.\n    \"\"\"\n    def _is_empty_value(value: Any) -> bool:\n        \"\"\"Determines if a value is considered empty based on the current cleaning flags.\"\"\"\n        if value is None and remove_none:\n            return True\n        if isinstance(value, str) and remove_empty_strings:\n            return (value == \"\") or (strip_strings and value.strip() == \"\")\n        if remove_empty_containers and isinstance(value, (list, tuple, set, dict)):\n            return len(value) == 0\n        return False\n\n    result: Dict[str, Any] = {}\n    for k, v in data.items():\n        if _is_empty_value(v):\n            continue\n        if recursive and isinstance(v, dict):\n            cleaned_nested = drop_empty(v, remove_none, remove_empty_strings, remove_empty_containers, strip_strings, recursive)\n            if not (remove_empty_containers and len(cleaned_nested) == 0):\n                result[k] = cleaned_nested\n        else:\n            result[k] = v\n    return result"}
{"task_id": "Mbpp/463", "solution": "def max_subarray_product(nums: list) -> int:\n    \"\"\"\n    Finds the maximum product of a contiguous subarray in the given list of integers.\n    The list is assumed to be non-empty and contain only integers.\n    \"\"\"\n    max_prod = nums[0]\n    min_prod = nums[0]\n    result = nums[0]\n\n    for i in range(1, len(nums)):\n        val = nums[i]\n\n        # If current number is negative, swap max_prod and min_prod\n        # because multiplying by a negative will flip their roles\n        if val < 0:\n            max_prod, min_prod = min_prod, max_prod\n\n        # Maximum product ending at current position i\n        # Could be current number itself or (max product ending at i-1) * current number\n        max_prod = max(val, max_prod * val)\n\n        # Minimum product ending at current position i\n        # Could be current number itself or (min product ending at i-1) * current number\n        min_prod = min(val, min_prod * val)\n\n        # Overall maximum product found so far\n        result = max(result, max_prod)\n\n    return result"}
{"task_id": "Mbpp/468", "solution": "def max_product(arr):\n    \"\"\"\n    Finds the maximum product formed by multiplying numbers of an increasing subsequence of that array.\n    Uses dynamic programming to compute the max product for each subsequence ending at an index.\n    \"\"\"\n    n = len(arr)\n    if n == 0:\n        return 1.0  # As per original problem, empty array would yield product 1 if allowed. However, the design context specified InvalidInputError for empty array, so this might need adjustment depending on final decision. Sticking to the prompt, not the design context for this specific detail.\n\n    dp = [float(x) for x in arr]  # dp[i] = max product of increasing subsequence ending at index i\n    \n    # Initialize max_product to the largest single element, or 1 if all elements are negative and we need to handle an empty subsequence case (not applicable here).\n    # Since we must select an increasing subsequence, at least one element is chosen.\n    # Initialize with the largest single element for correct comparison, as negative products can be smaller.\n    max_val = float('-inf')\n    \n    # Track the overall maximum product\n    overall_max_product = float('-inf')\n\n    # Handle the case of all negative numbers. The design context does not explicitly say\n    # to return the largest single element if all products are negative, but this is a common interpretation.\n    # For a strictly increasing subsequence, if all numbers are negative, the \"maximum\" product\n    # could be the product of a single element (the largest negative number closest to zero)\n    # or a sequence that results in a positive number if possible (e.g., [-3, -2, -1] -> (-3)*(-2)*(-1) = -6).\n    # However, standard LIS product often means finding the largest positive product.\n    # Given the example, we seek the largest positive product. If all products are negative,\n    # the largest product among them (closest to 0) would be the max.\n    \n    # Initial pass for single-element subsequences\n    for i in range(n):\n        if dp[i] > overall_max_product:\n            overall_max_product = dp[i]\n\n    for i in range(n):\n        for j in range(i):\n            if arr[j] < arr[i]:\n                # Calculate candidate product: dp[j] * arr[i]\n                candidate = dp[j] * arr[i]\n                \n                # Check for overflow before comparison\n                if abs(candidate) == float('inf') and abs(dp[j]) != float('inf') and abs(arr[i]) != float('inf'):\n                    # Overflow occurred, use inf for candidate if it becomes positive inf\n                    # or negative inf if it results in that.\n                    # Since we are maximizing product, positive inf is good, negative inf is bad.\n                    # For safety, we can just let Python handle float overflow to inf/-inf.\n                    pass # Python floats handle overflow by becoming inf/-inf\n\n                if candidate > dp[i]:\n                    dp[i] = candidate\n        \n        # Update the overall maximum product\n        if dp[i] > overall_max_product:\n            overall_max_product = dp[i]\n            \n    # If all numbers are negative and the largest single number is the max product\n    # (e.g., arr = [-5, -2, -3] -> max is -2), the current overall_max_product will capture this.\n    # If the array has elements like [2, -1, 3], increasing subsequence could be [2, 3] product 6.\n    # If the array has elements like [-3, -2], the max product will be -2 (single element).\n\n    return overall_max_product"}
{"task_id": "Mbpp/471", "solution": "def find_remainder(arr, n):\n    \"\"\"\n    Computes the product of array elements modulo n using modular arithmetic.\n    Handles empty arrays by returning 1 % n and performs operations iteratively.\n    \"\"\"\n    product = 1 % n\n    for x in arr:\n        product = (product * (x % n)) % n\n    return product"}
{"task_id": "Mbpp/470", "solution": "def add_pairwise(input_tuple):\n    \"\"\"\n    Computes the pairwise sum of neighboring elements in a tuple.\n    Assumes valid input: a tuple of numbers with at least two elements.\n    \"\"\"\n    return tuple(input_tuple[i] + input_tuple[i + 1] for i in range(len(input_tuple) - 1))"}
{"task_id": "Mbpp/472", "solution": "def check_Consecutive(items: list[int]) -> bool:\n    \"\"\"\n    Checks if the given list contains consecutive numbers in an order-insensitive manner.\n    Assumes input is a list of integers, handling empty and single-element lists as specific cases.\n    \"\"\"\n    if not items:\n        return False\n    if len(items) == 1:\n        return True\n\n    unique_items = set(items)\n\n    # Duplicates mean it's not consecutive.\n    if len(unique_items) != len(items):\n        return False\n\n    # Check if the range (max - min) equals the number of elements minus one.\n    min_val = min(unique_items)\n    max_val = max(unique_items)\n\n    return (max_val - min_val) == (len(items) - 1)"}
{"task_id": "Mbpp/474", "solution": "def replace_char(s: str, old: str, new: str) -> str:\n    \"\"\"Replaces occurrences of a single character in a string with another.\n\n    This function serves as a public API wrapper, delegating to the core service.\n    \"\"\"\n    # ReplaceRequest and ReplaceCharService are assumed to be available in the current scope\n    # as per the design's __init__.py structure where this function is defined.\n    request = ReplaceRequest(s=s, old=old, new=new)\n    svc = ReplaceCharService()  # The design indicates default instantiation without a repository\n    response = svc.replace(request)\n    return response.result"}
