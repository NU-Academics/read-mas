{"task_id": "Mbpp/305", "solution": "import re\ndef start_withp(lines: list[str]) -> tuple[str, str]:\n    \"\"\"\n    Returns the first two words from a list of strings that start with 'p' (case-insensitive).\n    Raises ValueError if fewer than two such words are found.\n    \"\"\"\n    LEADING_TRAILING_PUNCT_REGEX = r\"^[^\\w]+|[^\\w]+$\"\n\n    def normalize_word_inline(word: str) -> str:\n        \"\"\"Trims leading/trailing punctuation and converts the word to lowercase.\"\"\"\n        return re.sub(LEADING_TRAILING_PUNCT_REGEX, \"\", word).lower()\n\n    matches: list[str] = []\n    for line in lines:\n        for token in line.split():\n            if normalize_word_inline(token).startswith(\"p\"):\n                matches.append(token)\n                if len(matches) == 2:\n                    return (matches[0], matches[1])\n\n    raise ValueError(\"Fewer than 2 words starting with 'p' found\")"}
{"task_id": "Mbpp/311", "solution": "def set_left_most_unset_bit(n: int) -> int:\n    \"\"\"\n    Sets the left-most unset bit in a non-negative integer.\n    If all bits up to the most significant bit are set, the next higher bit is set.\n    \"\"\"\n    if n == 0:\n        return 1\n\n    # Find the position of the most significant bit (0-indexed).\n    msb = n.bit_length() - 1\n\n    # Iterate from the MSB down to 0 to find the first unset bit.\n    for pos in range(msb, -1, -1):\n        # Check if the bit at 'pos' is unset.\n        if not ((n >> pos) & 1):\n            # If unset, set this bit and return the modified number.\n            return n | (1 << pos)\n    \n    # If all bits from MSB down to 0 are already set (e.g., n=7 -> 111),\n    # set the bit immediately to the left of the current MSB.\n    return n | (1 << (msb + 1))"}
