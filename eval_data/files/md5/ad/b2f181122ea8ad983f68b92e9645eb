{"task_id": "Mbpp/610", "solution": "from typing import Any, List\ndef remove_kth_element(lst: List[Any], k: int) -> List[Any]:\n    \"\"\"\n    Returns a new list with the k'th element removed, without mutating the original list.\n    Assumes k is a valid 0-based index.\n    \"\"\"\n    return lst[:k] + lst[k+1:]"}
{"task_id": "Mbpp/612", "solution": "def merge(list_of_lists):\n    \"\"\"\n    Splits a list of 2-element sublists into two lists: one for first elements and one for second elements.\n    \"\"\"\n    first_elements = []\n    second_elements = []\n    for sublist in list_of_lists:\n        first_elements.append(sublist[0])\n        second_elements.append(sublist[1])\n    return [first_elements, second_elements]"}
{"task_id": "Mbpp/611", "solution": "def max_of_nth(matrix: list[list[int | float]], n: int) -> float:\n    \"\"\"\n    Returns the maximum value found in the specified n-th column of the matrix.\n    The function assumes valid input where the matrix is non-empty and `n` is a valid column index for all rows.\n    \"\"\"\n    # Iterate through the n-th column of each row and find the maximum value.\n    # The result is cast to float to align with the design's numeric type normalization.\n    return float(max(row[n] for row in matrix))"}
{"task_id": "Mbpp/608", "solution": "def bell_Number(n: int) -> int:\n    \"\"\"Calculates the nth Bell number using the Bell triangle method with caching.\n    The Bell numbers are computed by building an internal triangle row by row and caching results.\"\"\"\n\n    # Initialize cache as a function attribute, ensuring it persists across calls.\n    if not hasattr(bell_Number, 'cache'):\n        bell_Number.cache = {0: 1} # Base case B(0) = 1\n\n    # Check if 'n' is already computed and cached.\n    if n in bell_Number.cache:\n        return bell_Number.cache[n]\n\n    # Internal helper function to compute the Bell number from scratch for a given 'val_n'.\n    # This logic is directly from the provided design context snippet for `bell_triangle`.\n    def _compute_bell_number_from_scratch(val_n: int) -> int:\n        if val_n == 0:\n            return 1\n        \n        # The triangle is a list of lists, where `triangle[i]` represents the i-th row.\n        # `triangle[0]` starts with the single element `1` (which is A_0,0).\n        triangle = [[1]]\n\n        # Iterate to build rows from 1 up to `val_n`.\n        # `i` represents the current row index.\n        for i in range(1, val_n + 1):\n            # The first element of the current row (A_i,0) is the last element\n            # of the previous row (A_{i-1, i-1}).\n            row = [triangle[i-1][-1]]\n            \n            # Compute the subsequent elements in the current row (A_i,j) using the recurrence relation:\n            # A_i,j = A_i,j-1 + A_{i-1, j-1}\n            # `j` represents the column index within the current row.\n            for j in range(1, i + 1):\n                val = row[j-1] + triangle[i-1][j-1]\n                row.append(val)\n            \n            # Add the newly computed row to the triangle.\n            triangle.append(row)\n        \n        # The Bell number B(val_n) is the first element of the `val_n`-th row (A_val_n,0).\n        return triangle[val_n][0]\n\n    # Compute the Bell number for 'n' since it's not in the cache.\n    bell_val = _compute_bell_number_from_scratch(n)\n    \n    # Cache the computed result for future requests.\n    bell_Number.cache[n] = bell_val\n    \n    return bell_val"}
{"task_id": "Mbpp/616", "solution": "def tuple_modulo(dividends: tuple, divisors: tuple) -> tuple:\n    \"\"\"Performs element-wise modulo on two tuples of the same length.\n\n    Assumes inputs are valid tuples of numbers and divisors are non-zero.\n    \"\"\"\n    return tuple(dvd % dvs for dvd, dvs in zip(dividends, divisors))"}
{"task_id": "Mbpp/614", "solution": "import json\nimport ast\nclass ValidationError(Exception):\n    \"\"\"Custom exception for validation problems with input.\"\"\"\n    def __init__(self, message):\n        super().__init__(message)\n        self.message = message\nclass TupleListModel:\n    \"\"\"Domain model representing nested sequence input.\"\"\"\n    def __init__(self, raw):\n        self.raw = raw\n\n    def as_sequences(self):\n        \"\"\"Returns the raw input as a sequence of sequences.\"\"\"\n        return self.raw\nclass Validators:\n    \"\"\"Provides validation and flattening utilities for sequences.\"\"\"\n    def is_sequence(self, obj):\n        \"\"\"Checks if an object is a list or tuple, excluding strings/bytes.\"\"\"\n        return isinstance(obj, (list, tuple))\n\n    def flatten(self, obj):\n        \"\"\"Recursively flattens a nested sequence, yielding integer leaf values.\"\"\"\n        if self.is_sequence(obj):\n            for item in obj:\n                yield from self.flatten(item)\n        else:\n            if not isinstance(obj, int):\n                raise ValidationError(f\"Leaf value not int: {obj!r}\")\n            yield obj\nclass CumulativeSumService:\n    \"\"\"Orchestrates validation and computes the cumulative sum.\"\"\"\n    def __init__(self, validators):\n        self.validators = validators\n\n    def compute(self, model):\n        \"\"\"Computes the sum of all integers within the provided model's raw data.\"\"\"\n        total = 0\n        for n in self.validators.flatten(model.as_sequences()):\n            total += n\n        return total\nclass InputRepository:\n    \"\"\"Parses various inputs into a TupleListModel.\"\"\"\n    def __init__(self):\n        pass\n\n    def parse_from_string(self, s):\n        \"\"\"Attempts to parse a string as JSON or Python literal into a TupleListModel.\"\"\"\n        s = s.strip()\n        try:\n            obj = json.loads(s)\n        except Exception:\n            try:\n                obj = ast.literal_eval(s)\n            except Exception as e:\n                raise ValidationError(\"Unable to parse input string\") from e\n        return self.parse_from_object(obj)\n\n    def parse_from_object(self, obj):\n        \"\"\"Wraps an already-parsed sequence object into a TupleListModel.\"\"\"\n        if not isinstance(obj, (list, tuple)):\n            raise ValidationError(\"Input must be a sequence\")\n        return TupleListModel(obj)\ndef cummulative_sum(data):\n    \"\"\"\n    Calculates the cumulative sum of all integer values in a nested sequence.\n    Input `data` should be a sequence of sequences containing integers.\n    \"\"\"\n    repo = InputRepository()\n    model = repo.parse_from_object(data)\n    service = CumulativeSumService(Validators())\n    return service.compute(model)"}
{"task_id": "Mbpp/619", "solution": "def move_num(s: str) -> str:\n    \"\"\"\n    Moves all digit characters to the end of the string, preserving\n    the relative order of non-digit characters and digits.\n    \"\"\"\n    non_digits = []\n    digits = []\n    for char in s:\n        if '0' <= char <= '9':  # Check for ASCII digits\n            digits.append(char)\n        else:\n            non_digits.append(char)\n    return \"\".join(non_digits) + \"\".join(digits)"}
