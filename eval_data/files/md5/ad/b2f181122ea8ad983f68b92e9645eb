{"task_id": "Mbpp/3", "solution": "def is_not_prime(n):\n    \"\"\"\n    Identifies if a number is not prime. Returns True for non-prime, False for prime.\n    Assumes `n` is an integer; handles numbers less than 2 as non-prime.\n    \"\"\"\n    if n < 2:\n        return True\n\n    if n == 2 or n == 3:\n        return False\n\n    if n % 2 == 0 or n % 3 == 0:\n        return True\n\n    i = 5\n    limit = int(n**0.5)\n    while i <= limit:\n        if n % i == 0 or n % (i + 2) == 0:\n            return True\n        i += 6\n\n    return False"}
{"task_id": "Mbpp/9", "solution": "def find_Rotations(s: str) -> int:\n    \"\"\"\n    Finds the minimum number of rotations (greater than 0) required to get the same string.\n    Uses the KMP prefix function (LPS array) to determine the minimal period of the string.\n    \"\"\"\n    n = len(s)\n    \n    # KMP prefix function (LPS array) computation\n    lps = [0] * n\n    length = 0  # Length of the longest proper prefix that is also a suffix\n    i = 1\n    while i < n:\n        if s[i] == s[length]:\n            length += 1\n            lps[i] = length\n            i += 1\n        else:\n            if length != 0:\n                length = lps[length - 1]\n            else:\n                lps[i] = 0\n                i += 1\n\n    # Calculate minimal period based on LPS array\n    # The length of the smallest repeating unit (period) is n - lps[n-1].\n    # If the string length n is perfectly divisible by this period, then it's the minimal rotation.\n    # Otherwise, the string itself is the smallest repeating unit, so n rotations are needed.\n    \n    # For n=0, lps[-1] would be an error. The design context assumes n >= 1.\n    # The problem implies n >= 1 due to \"rotations (greater than 0)\".\n    # If n is 0, the behavior for this problem is undefined, but assuming n >= 1 based on context.\n    \n    # Get the last value of the LPS array.\n    # If n=0, lps list is empty; this scenario is excluded by the problem's implicit constraints.\n    last_lps_val = lps[n - 1]\n    \n    potential_period = n - last_lps_val\n\n    # If n is divisible by potential_period, then potential_period is the answer.\n    # Otherwise, the entire string is the period, meaning n rotations.\n    if n % potential_period == 0:\n        return potential_period\n    else:\n        return n"}
{"task_id": "Mbpp/7", "solution": "import re\ndef find_char_long(text: str) -> list[str]:\n    \"\"\"\n    Finds all words which are at least 4 characters long in a string.\n    Words are sequences of letters and numbers; punctuation and whitespace are separators.\n    \"\"\"\n    text = text or \"\"\n    \n    # Split the text by sequences of one or more non-word characters (punctuation, whitespace).\n    # re.UNICODE ensures correct handling of Unicode word characters.\n    tokens = re.split(r'\\W+', text, flags=re.UNICODE)\n    \n    # Filter for non-empty tokens and check if their length is at least 4.\n    result = [token for token in tokens if token and len(token) >= 4]\n    \n    return result"}
