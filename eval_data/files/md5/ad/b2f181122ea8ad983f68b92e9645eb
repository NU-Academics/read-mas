{"task_id": "Mbpp/590", "solution": "import math\nfrom typing import Tuple\nclass _ConverterService:\n    \"\"\"Provides methods for converting between coordinate systems.\"\"\"\n\n    def _polar_from_cartesian(self, x: float, y: float) -> Tuple[float, float]:\n        \"\"\"Computes polar coordinates (r, theta) from Cartesian (x, y).\"\"\"\n        _validate_numeric(x, y)\n        r = math.hypot(x, y)\n        theta = math.atan2(y, x)\n        return (r, theta)\n\n    def polar_rect(self, x: float, y: float) -> Tuple[Tuple[float, float], complex]:\n        \"\"\"Converts Cartesian (x,y) to polar (r,theta) and a complex rectangular value.\"\"\"\n        _validate_numeric(x, y)\n        polar_coords = self._polar_from_cartesian(x, y)\n        rect_complex = complex(float(x), float(y))\n        return (polar_coords, rect_complex)\n_service = _ConverterService()\ndef polar_rect(x: float, y: float) -> Tuple[Tuple[float, float], complex]:\n    \"\"\"Converts Cartesian coordinates (x, y) to polar (r, theta) and complex rectangular form.\"\"\"\n    return _service.polar_rect(x, y)"}
{"task_id": "Mbpp/589", "solution": "import math\ndef perfect_squares(start: int, end: int) -> list[int]:\n    \"\"\"\n    Finds perfect squares within a given inclusive range [start, end].\n    Assumes start <= end and only considers non-negative roots.\n    \"\"\"\n    squares = []\n    \n    # Determine the smallest non-negative integer 'n' whose square might be in the range.\n    # If 'start' is negative, the smallest square considered is 0 (from n=0).\n    lower_n = math.isqrt(max(0, start))\n    \n    # Determine the largest non-negative integer 'n' whose square might be in the range.\n    upper_n = math.isqrt(end)\n\n    for n in range(lower_n, upper_n + 1):\n        square = n * n\n        if start <= square <= end:\n            squares.append(square)\n            \n    return squares"}
{"task_id": "Mbpp/591", "solution": "def swap_List(lst):\n    \"\"\"Interchanges the first and last elements in a list, returning a new list.\"\"\"\n    if len(lst) < 2:\n        return list(lst)\n    \n    out_list = list(lst)\n    out_list[0], out_list[-1] = out_list[-1], out_list[0]\n    return out_list"}
{"task_id": "Mbpp/592", "solution": "import math\ndef sum_Of_product(n):\n    \"\"\"\n    Finds the sum of the product of consecutive binomial coefficients using the identity C(2n, n-1).\n    \"\"\"\n    if n == 0:\n        return 0\n    return math.comb(2 * n, n - 1)"}
{"task_id": "Mbpp/594", "solution": "def diff_even_odd(numbers: list[int]) -> int:\n    \"\"\"\n    Calculates the difference between the first even and first odd number in a list.\n    Assumes the list contains at least one even and one odd integer.\n    \"\"\"\n    first_even = None\n    first_odd = None\n\n    for num in numbers:\n        if first_odd is None and num % 2 != 0:\n            first_odd = num\n        if first_even is None and num % 2 == 0:\n            first_even = num\n        if first_even is not None and first_odd is not None:\n            break\n\n    return first_even - first_odd"}
