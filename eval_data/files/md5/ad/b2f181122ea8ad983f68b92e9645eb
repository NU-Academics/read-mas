{"task_id": "Mbpp/615", "solution": "def average_tuple(value: tuple[tuple[float | int, ...], ...]) -> list[float]:\n    \"\"\"\n    Calculates the average value for each inner tuple in a tuple of tuples.\n    Assumes valid input where inner tuples are non-empty and contain numbers.\n    \"\"\"\n    averages = []\n    for inner_tuple in value:\n        # The design context implies that inner tuples are guaranteed non-empty\n        # due to validation requirements, but the prompt's constraints\n        # (\"DO NOT add isinstance() checks or raise exceptions for edge cases\")\n        # mean we directly compute without checking for empty inner tuples here.\n        if inner_tuple: # This check is added for basic robustness, not explicit validation/exception.\n            averages.append(sum(inner_tuple) / len(inner_tuple))\n        else:\n            # If an empty inner tuple is encountered, and we are not to raise,\n            # we need a sensible default or to ignore it. Given the assert implies all\n            # inner tuples are processed and yield an average, an empty inner tuple\n            # would typically be an error. However, strictly adhering to \"DO NOT add ... raise exceptions\"\n            # and assuming valid input for the assert, this branch might not be hit.\n            # A common mathematical approach for an average of an empty set might be NaN or error.\n            # For this problem's implied happy path, we assume inner_tuple is never empty.\n            pass # Or handle as a specific value if required, e.g., float('nan') or 0.0\n\n    return averages"}
{"task_id": "Mbpp/629", "solution": "def Split(nums):\n    \"\"\"\n    Finds even numbers from a list of numbers.\n    Preserves the order of even numbers from the input list.\n    \"\"\"\n    def is_even(value: int) -> bool:\n        \"\"\"Checks if a given integer is even.\"\"\"\n        return value % 2 == 0\n\n    even_numbers = []\n    for num in nums:\n        if is_even(num):\n            even_numbers.append(num)\n    return even_numbers"}
{"task_id": "Mbpp/618", "solution": "def div_list(a, b):\n    \"\"\"\n    Divides two lists element-wise, returning a new list of floats.\n    Assumes inputs are lists of numbers of equal length.\n    \"\"\"\n    result = []\n    for x, y in zip(a, b):\n        result.append(float(x) / float(y))\n    return result"}
{"task_id": "Mbpp/622", "solution": "def get_median(list1, list2, n):\n    \"\"\"\n    Finds the median of two sorted lists of the same size using a divide-and-conquer approach.\n    Assumes n >= 1 and len(list1) == len(list2) == n, and both lists are sorted.\n    \"\"\"\n\n    def _median_of_array(arr, start, end):\n        \"\"\"Calculates the median of a single sorted sub-array defined by start and end indices.\"\"\"\n        length = end - start + 1\n        if length % 2 == 1:\n            return float(arr[start + length // 2])\n        else:\n            return (float(arr[start + length // 2 - 1]) + float(arr[start + length // 2])) / 2.0\n\n    def _median_recursive(a, b, start_a, end_a, start_b, end_b):\n        \"\"\"Recursively finds the median of two sorted sub-arrays.\"\"\"\n        size = end_a - start_a + 1\n\n        if size == 1:\n            return (float(a[start_a]) + float(b[start_b])) / 2.0\n        \n        if size == 2:\n            return (max(float(a[start_a]), float(b[start_b])) + min(float(a[end_a]), float(b[end_b]))) / 2.0\n\n        m1 = _median_of_array(a, start_a, end_a)\n        m2 = _median_of_array(b, start_b, end_b)\n\n        if m1 == m2:\n            return m1\n\n        if m1 < m2:\n            # Median must be in the right half of 'a' and left half of 'b'.\n            new_start_a = start_a + size // 2\n            new_end_b = start_b + (size - 1) // 2\n            return _median_recursive(a, b, new_start_a, end_a, start_b, new_end_b)\n        else:\n            # Median must be in the left half of 'a' and right half of 'b'.\n            new_end_a = start_a + (size - 1) // 2\n            new_start_b = start_b + size // 2\n            return _median_recursive(a, b, start_a, new_end_a, new_start_b, end_b)\n\n    return _median_recursive(list1, list2, 0, n - 1, 0, n - 1)"}
{"task_id": "Mbpp/626", "solution": "from typing import Any, Optional\ndef to_float(value: Any) -> Optional[float]:\n    \"\"\"Attempts to convert a value to a float, returning None on failure.\"\"\"\n    try:\n        return float(value)\n    except (ValueError, TypeError):\n        return None\nclass RadiusValidator:\n    \"\"\"Validates and parses radius inputs.\"\"\"\n    def parse_to_float(self, value: Any) -> Optional[float]:\n        return to_float(value)\n\n    def validate(self, radius: Any) -> bool:\n        r = self.parse_to_float(radius)\n        if r is None:\n            return False\n        return r >= 0.0\nclass TriangleCalculator:\n    \"\"\"Calculates the maximum area of a triangle inscribed in a semicircle.\"\"\"\n    COMPUTATION_TOLERANCE: float = 1e-12\n\n    def max_area(self, radius: float) -> float:\n        \"\"\"Computes the maximum area (R^2) for a given non-negative radius.\"\"\"\n        if radius < 0.0:\n            raise ValueError(\"radius must be non-negative\")\n        return radius * radius\nclass TriangleAreaService:\n    \"\"\"Orchestrates validation and calculation for triangle area.\"\"\"\n    def __init__(self, validator: RadiusValidator, calculator: TriangleCalculator):\n        self._validator = validator\n        self._calculator = calculator\n\n    def compute(self, radius: Any) -> Optional[float]:\n        \"\"\"Validates radius, computes max area if valid, returns None otherwise.\"\"\"\n        parsed = self._validator.parse_to_float(radius)\n        if parsed is None or parsed < 0:\n            return None\n        try:\n            return float(self._calculator.max_area(parsed))\n        except ValueError:\n            return None\nclass TriangleController:\n    \"\"\"Provides an API wrapper for triangle area computation.\"\"\"\n    def __init__(self, service: TriangleAreaService):\n        self._service = service\n\n    def compute(self, radius: Any) -> Optional[float]:\n        \"\"\"Delegates radius computation to the service layer.\"\"\"\n        return self._service.compute(radius)\n_controller = TriangleController(TriangleAreaService(RadiusValidator(), TriangleCalculator()))\ndef triangle_area(radius: Any) -> Optional[float]:\n    \"\"\"\n    Finds the area of the largest triangle that can be inscribed in a semicircle with a given radius.\n    Returns None if the radius is negative or cannot be parsed as a non-negative number.\n    \"\"\"\n    return _controller.compute(radius)"}
{"task_id": "Mbpp/620", "solution": "def largest_subset(numbers: Iterable[int]) -> int:\n    \"\"\"\n    Finds the size of the largest subset of a list of numbers so that every pair is divisible.\n    \"\"\"\n    if not numbers:\n        return 0\n\n    # Convert to list and sort by absolute value. This simplifies the DP check\n    # as we only need to check if arr[j] divides arr[i] where abs(arr[j]) <= abs(arr[i]).\n    arr = sorted(list(numbers), key=abs)\n    n = len(arr)\n\n    # lengths[i] stores the length of the longest divisible subset ending with arr[i]\n    lengths = [1] * n\n\n    # Dynamic programming to build the longest divisible chain\n    for i in range(n):\n        # Iterate through previous elements to find potential divisors\n        for j in range(i):\n            divisor, multiple = arr[j], arr[i]\n\n            # Check if 'divisor' divides 'multiple'.\n            # Handle division by zero: a non-zero number can divide 0 (0 % x == 0),\n            # but 0 cannot divide any non-zero number.\n            if divisor != 0 and multiple % divisor == 0:\n                if lengths[j] + 1 > lengths[i]:\n                    lengths[i] = lengths[j] + 1\n\n    # The largest subset size is the maximum value found in the lengths array\n    return max(lengths)"}
{"task_id": "Mbpp/630", "solution": "def get_coordinates(coord: tuple[int, int]) -> list[list[int]]:\n    \"\"\"\n    Extracts all adjacent coordinates of the given coordinate tuple, including the coordinate itself.\n    The result is ordered row-major from top-left (x-1, y-1) to bottom-right (x+1, y+1).\n    \"\"\"\n\n    class Coordinate:\n        def __init__(self, x: int, y: int) -> None:\n            self._x = x\n            self._y = y\n\n        def x(self) -> int:\n            return self._x\n\n        def y(self) -> int:\n            return self._y\n\n        def to_list(self) -> list[int]:\n            return [self._x, self._y]\n\n        def to_tuple(self) -> tuple[int, int]:\n            return (self._x, self._y)\n\n        def __eq__(self, other: object) -> bool:\n            if not isinstance(other, Coordinate):\n                return NotImplemented\n            return self._x == other.x() and self._y == other.y()\n\n        def __hash__(self) -> int:\n            return hash((self._x, self._y))\n\n        @classmethod\n        def from_tuple(cls, t: tuple[int, int]) -> \"Coordinate\":\n            return cls(t[0], t[1])\n\n    class AdjacencyService:\n        def __init__(self, cache=None) -> None:\n            # The public API function does not pass a cache, so this will be None.\n            self._cache = cache\n\n        def get_adjacent(self, coord: Coordinate, include_center: bool = True) -> list[list[int]]:\n            # Since cache is not provided by the API function, we directly compute.\n            grid = self._compute_grid(coord, radius=1, include_center=include_center)\n            return grid\n\n        def _compute_grid(self, coord: Coordinate, radius: int = 1, include_center: bool = True) -> list[list[int]]:\n            \"\"\"\n            Computes the grid of adjacent coordinates, including the center by default.\n            The grid is ordered row-major from top-left (x-radius, y-radius) to bottom-right (x+radius, y+radius).\n            \"\"\"\n            grid = []\n            center_x = coord.x()\n            center_y = coord.y()\n\n            # Iterate through dx values for rows (changes in x-coordinate)\n            for dx in range(-radius, radius + 1):\n                # Iterate through dy values for columns (changes in y-coordinate)\n                for dy in range(-radius, radius + 1):\n                    current_x = center_x + dx\n                    current_y = center_y + dy\n                    # The public API always calls with include_center=True, so no conditional check is needed.\n                    grid.append([current_x, current_y])\n            return grid\n\n    # Create a Coordinate object from the input tuple.\n    c = Coordinate.from_tuple(coord)\n    # Instantiate the AdjacencyService without a cache.\n    service = AdjacencyService()\n    # Get the adjacent coordinates, ensuring the center is included as per requirements.\n    return service.get_adjacent(c, include_center=True)"}
