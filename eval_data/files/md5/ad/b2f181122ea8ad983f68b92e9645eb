{"task_id": "Mbpp/124", "solution": "import math\ndef angle_complex(value):\n    \"\"\"\n    Computes the angle (argument) of a complex number in radians.\n    Parses various input types (complex, tuple, list, int, float, str).\n    \"\"\"\n    real_part: float\n    imag_part: float\n\n    if isinstance(value, complex):\n        real_part = value.real\n        imag_part = value.imag\n    elif isinstance(value, (list, tuple)) and len(value) == 2:\n        real_part = float(value[0])\n        imag_part = float(value[1])\n    elif isinstance(value, (int, float)):\n        real_part = float(value)\n        imag_part = 0.0\n    elif isinstance(value, str):\n        if ',' in value:\n            parts = value.split(',')\n            real_part = float(parts[0].strip())\n            imag_part = float(parts[1].strip())\n        else:\n            c_val = complex(value)\n            real_part = c_val.real\n            imag_part = c_val.imag\n    else:\n        # Attempt direct float conversion; Python will raise TypeError/ValueError for unsupported types.\n        real_part = float(value)\n        imag_part = 0.0\n            \n    return math.atan2(imag_part, real_part)"}
{"task_id": "Mbpp/133", "solution": "def sum_negativenum(numbers):\n    \"\"\"\n    Calculates the sum of negative numbers in a given list of numbers.\n    It iterates through the list, adding numbers strictly less than zero to a running total.\n    \"\"\"\n    total_negative = 0.0\n    for num in numbers:\n        if num < 0:\n            total_negative += num\n    return total_negative"}
{"task_id": "Mbpp/131", "solution": "def reverse_vowels(s: str) -> str:\n    \"\"\"Reverses only the vowels in a given string, where 'y' is not considered a vowel.\"\"\"\n    chars = list(s)\n    vowels_set = \"aeiouAEIOU\"\n    i, j = 0, len(chars) - 1\n\n    while i < j:\n        # Move pointer i forward until a vowel is found\n        while i < j and chars[i] not in vowels_set:\n            i += 1\n        # Move pointer j backward until a vowel is found\n        while i < j and chars[j] not in vowels_set:\n            j -= 1\n\n        # If both pointers found vowels and haven't crossed, swap them\n        if i < j:\n            chars[i], chars[j] = chars[j], chars[i]\n            i += 1\n            j -= 1\n            \n    return \"\".join(chars)"}
{"task_id": "Mbpp/130", "solution": "def max_occurrences(items: list) -> object:\n    \"\"\"Finds the item with the maximum frequency in a list, using first-seen as a tie-breaker.\n    Assumes the input list is not empty and contains hashable elements.\"\"\"\n    counts = {}\n    # Count frequencies of each item\n    for item in items:\n        counts[item] = counts.get(item, 0) + 1\n\n    # Find the maximum frequency count\n    max_count = max(counts.values())\n\n    # Identify all items that have this maximum frequency\n    candidates = {item for item, count in counts.items() if count == max_count}\n\n    # Apply the \"first-seen\" tie-breaker by iterating through the original list\n    for item in items:\n        if item in candidates:\n            return item"}
