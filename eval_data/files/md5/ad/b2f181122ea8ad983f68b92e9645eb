{"task_id": "Mbpp/392", "solution": "_max_sum_memo = {}\ndef get_max_sum(n: int) -> int:\n    \"\"\"\n    Calculates the maximum sum for f(n) = max((f(n/2) + f(n/3) + f(n/4) + f(n/5)), n).\n    All divisions are integer divisions (floor division).\n    \"\"\"\n    if n <= 1:\n        return n\n\n    if n in _max_sum_memo:\n        return _max_sum_memo[n]\n\n    # Recursively calculate the sum of the divided parts\n    sum_of_parts = (\n        get_max_sum(n // 2) +\n        get_max_sum(n // 3) +\n        get_max_sum(n // 4) +\n        get_max_sum(n // 5)\n    )\n\n    # The result is the maximum of the sum of parts or n itself\n    result = max(sum_of_parts, n)\n\n    # Store the computed result in the memoization cache before returning\n    _max_sum_memo[n] = result\n    return result"}
{"task_id": "Mbpp/391", "solution": "from typing import Sequence, List, Dict, Any, Hashable\nclass ListNestedDictError(Exception):\n    \"\"\"Base exception for list_nested_dict operations.\"\"\"\n    pass\nclass InvalidInputError(ListNestedDictError):\n    \"\"\"Raised when input lists or their elements are invalid.\"\"\"\n    pass\nclass InputLengthMismatchError(ListNestedDictError):\n    \"\"\"Raised when input lists do not have consistent lengths.\"\"\"\n    pass\nclass DuplicateKeyError(ListNestedDictError):\n    \"\"\"Raised when a duplicate top-level key is encountered in strict mode.\"\"\"\n    pass\nclass ListInputDTO:\n    \"\"\"Data Transfer Object for validated input lists.\"\"\"\n    def __init__(self, lists: List[List[Any]]) -> None:\n        self.lists = lists\n        self.length = len(lists[0]) if lists and lists[0] is not None else 0\nclass Validator:\n    \"\"\"Validates input lists for consistency and correctness.\"\"\"\n    def _ensure_sequence(self, seq: Any, name: str = \"Input\") -> None:\n        \"\"\"Ensures the given input is a sequence type but not a string.\"\"\"\n        if not isinstance(seq, Sequence) or isinstance(seq, str):\n            raise InvalidInputError(f\"{name} must be a sequence (e.g., list, tuple), not a string or non-sequence type.\")\n\n    def ensure_hashable(self, value: Any) -> None:\n        \"\"\"Ensures a value is hashable, suitable for use as a dictionary key.\"\"\"\n        try:\n            hash(value)\n        except TypeError:\n            raise InvalidInputError(f\"Top-level keys must be hashable, but got unhashable type: {type(value).__name__} with value {value!r}\")\n\n    def validate_lists(self, lists: Sequence[Sequence[Any]]) -> ListInputDTO:\n        \"\"\"\n        Validates the provided lists to ensure they meet conversion requirements.\n        Checks for minimum number of lists, equal lengths, and hashable top-level keys.\n        \"\"\"\n        self._ensure_sequence(lists, \"Input 'lists' collection\")\n        if len(lists) < 2:\n            raise InvalidInputError(\"At least two lists are required for conversion.\")\n\n        processed_lists = []\n        first_list_len = -1\n\n        for i, lst in enumerate(lists):\n            self._ensure_sequence(lst, f\"List at index {i}\")\n            \n            if first_list_len == -1:\n                first_list_len = len(lst)\n            elif len(lst) != first_list_len:\n                raise InputLengthMismatchError(\n                    f\"All input lists must have the same length. List at index {i} has length \"\n                    f\"{len(lst)}, but previous lists have length {first_list_len}.\"\n                )\n            processed_lists.append(list(lst))\n\n        if not processed_lists: # Should be caught by len(lists) < 2, but defensive\n            return ListInputDTO([])\n        \n        # Validate hashability of the elements in the first list (which become top-level keys)\n        for item in processed_lists[0]:\n            self.ensure_hashable(item)\n\n        return ListInputDTO(processed_lists)\nclass Converter:\n    \"\"\"Performs the conversion of validated lists into nested dictionaries.\"\"\"\n    def _build_nested(self, values: List[Any]) -> Any:\n        \"\"\"Recursively builds a nested dictionary structure from a list of values.\"\"\"\n        if not values:\n            return None # Should not occur with proper list slice\n        if len(values) == 1:\n            return values[0]\n        \n        head, *tail = values\n        return {head: self._build_nested(tail)}\n\n    def convert(self, lists: List[List[Any]], strict: bool = False) -> List[Dict[Any, Any]]:\n        \"\"\"\n        Converts a list of parallel lists into a list of nested dictionaries.\n        Assumes the input 'lists' are already validated (same length, first list hashable).\n        \"\"\"\n        if not lists or not lists[0]: # Handle cases where validation might pass empty list of lists (edge)\n            return []\n        \n        num_rows = len(lists[0])\n        rows = []\n        seen_keys = set()\n        \n        for i in range(num_rows):\n            top_level_key = lists[0][i]\n            \n            if strict and top_level_key in seen_keys:\n                raise DuplicateKeyError(f\"Duplicate top-level key found: {top_level_key!r}. Strict mode disallows this.\")\n            \n            seen_keys.add(top_level_key)\n            \n            # Extract values for the current row for nesting (from the second list onwards)\n            row_values_for_nesting = [lst[i] for lst in lists[1:]]\n            \n            # Build the nested dictionary for this row\n            nested_value = self._build_nested(row_values_for_nesting)\n            \n            rows.append({top_level_key: nested_value})\n        \n        return rows\ndef convert_list_dictionary(*lists: Sequence[Any], strict: bool = False) -> List[Dict[Any, Any]]:\n    \"\"\"\n    Converts multiple parallel lists into a list of nested dictionaries.\n    The first list provides top-level keys, subsequent lists provide values for nesting.\n    \"\"\"\n    validator = Validator()\n    dto = validator.validate_lists(lists)\n    converter = Converter()\n    return converter.convert(dto.lists, strict=strict)"}
{"task_id": "Mbpp/390", "solution": "import uuid\nimport json\nimport logging\nimport string\nfrom collections import deque\nfrom datetime import datetime\nfrom dataclasses import dataclass\nfrom typing import List, Any, Iterable, Optional\nclass FormatError(Exception):\n    def __init__(self, message: str):\n        self.message = message\n        super().__init__(message)\ndef safe_str(value: Any) -> str:\n    \"\"\"Converts a value to string, handling None safely.\"\"\"\n    return str(value)\nclass FormatValidator:\n    def validate(self, fmt: str) -> bool:\n        \"\"\"Validates if the format string is suitable for single positional argument formatting.\"\"\"\n        if not isinstance(fmt, str) or not fmt:\n            raise FormatError(\"format must be a non-empty string\")\n        if not self._contains_placeholder(fmt):\n            raise FormatError(\"format string must contain at least one suitable positional placeholder ({0} or {}).\")\n        return True\n\n    def _contains_placeholder(self, fmt: str) -> bool:\n        \"\"\"Checks if the format string contains only suitable positional placeholders ({} or {0}).\"\"\"\n        found_placeholder = False\n        formatter = string.Formatter()\n        try:\n            for literal_text, field_name, format_spec, conversion in formatter.parse(fmt):\n                if field_name is not None:\n                    if field_name == '' or field_name == '0':\n                        found_placeholder = True\n                    else:\n                        return False # Reject named fields or other indices.\n            return found_placeholder\n        except ValueError:\n            return False # Malformed format string is considered invalid.\nclass HistoryRecord:\n    def __init__(self, id: str, timestamp: str, input_preview: List[str], format_string: str, result_count: int):\n        self.id = id\n        self.timestamp = timestamp\n        self.input_preview = input_preview\n        self.format_string = format_string\n        self.result_count = result_count\nclass FileAdapter:\n    def write(self, path: str, data: Any) -> None:\n        \"\"\"Writes data to a JSON file, logging any I/O errors.\"\"\"\n        try:\n            with open(path, 'w', encoding='utf-8') as f:\n                json.dump(data, f, indent=2)\n        except IOError as e:\n            logging.error(f\"Failed to write to file {path}: {e}\")\n\n    def read(self, path: str) -> Any:\n        \"\"\"Reads data from a JSON file, returning None on errors or not found.\"\"\"\n        try:\n            with open(path, 'r', encoding='utf-8') as f:\n                return json.load(f)\n        except (FileNotFoundError, IOError, json.JSONDecodeError) as e:\n            logging.error(f\"Failed to read or decode JSON from file {path}: {e}\")\n            return None\nclass FormatHistoryRepository:\n    \"\"\"Stores a limited number of format operation records, with optional JSON file persistence.\"\"\"\n    def __init__(self, max_records: int = 100, file_path: Optional[str] = None):\n        self.max_records = max_records\n        self.records: deque[HistoryRecord] = deque(maxlen=max_records)\n        self.file_path = file_path\n        self._file_adapter = FileAdapter()\n        if self.file_path:\n            self._load_from_file()\n\n    def add(self, record: HistoryRecord) -> None:\n        \"\"\"Adds a new history record and manages maximum record count, persisting if configured.\"\"\"\n        self.records.append(record)\n        if self.file_path:\n            self._persist_to_file()\n\n    def list(self, limit: int = 10) -> List[HistoryRecord]:\n        \"\"\"Returns the most recent history records, up to the specified limit.\"\"\"\n        return list(self.records)[-limit:]\n\n    def _persist_to_file(self) -> None:\n        \"\"\"Persists current history records to the configured JSON file.\"\"\"\n        if self.file_path:\n            serializable_records = []\n            for record in self.records:\n                serializable_records.append({\n                    \"id\": record.id,\n                    \"timestamp\": record.timestamp,\n                    \"input_preview\": record.input_preview,\n                    \"format_string\": record.format_string,\n                    \"result_count\": record.result_count,\n                })\n            self._file_adapter.write(self.file_path, serializable_records)\n\n    def _load_from_file(self) -> None:\n        \"\"\"Loads history records from the configured JSON file into memory.\"\"\"\n        if self.file_path:\n            data = self._file_adapter.read(self.file_path)\n            if data is not None and isinstance(data, list):\n                for item in data:\n                    try:\n                        record = HistoryRecord(\n                            id=item['id'],\n                            timestamp=item['timestamp'],\n                            input_preview=item['input_preview'],\n                            format_string=item['format_string'],\n                            result_count=item['result_count']\n                        )\n                        self.records.append(record)\n                    except KeyError as e:\n                        logging.warning(f\"Malformed history record in {self.file_path}: missing key {e}.\")\nDEFAULT_CONFIG = AppConfig(max_history=100, persist_file=None)\nclass FormatterService:\n    \"\"\"Core business logic for formatting lists and recording history.\"\"\"\n    def __init__(self, repo: FormatHistoryRepository, validator: FormatValidator, config: AppConfig):\n        self.repo = repo\n        self.validator = validator\n        self.config = config\n\n    def format_list(self, values: Iterable[Any], fmt: str) -> List[str]:\n        \"\"\"Applies a format string to each element in a list and records the operation.\"\"\"\n        self.validator.validate(fmt) # This will raise FormatError if format is invalid.\n\n        try:\n            _ = iter(values) # Check if iterable.\n        except TypeError:\n            raise TypeError(\"values must be an iterable\")\n\n        results: List[str] = [self._format_item(v, fmt) for v in values]\n\n        record = HistoryRecord(\n            id=str(uuid.uuid4()),\n            timestamp=datetime.utcnow().isoformat() + \"Z\",\n            input_preview=[safe_str(x) for x in list(values)[:10]], # Truncate and convert to str for preview.\n            format_string=fmt,\n            result_count=len(results),\n        )\n        try:\n            self.repo.add(record)\n        except Exception:\n            logging.exception(\"Failed to persist history record.\")\n        return results\n\n    def _format_item(self, item: Any, fmt: str) -> str:\n        \"\"\"Formats a single item using the given format string.\"\"\"\n        return fmt.format(item)\n_repo = FormatHistoryRepository(max_records=DEFAULT_CONFIG.max_history, file_path=DEFAULT_CONFIG.persist_file)\n_validator = FormatValidator()\n_service = FormatterService(_repo, _validator, DEFAULT_CONFIG)\ndef add_string(values, fmt):\n    \"\"\"Applies a format string to all elements in a list using the configured service.\"\"\"\n    return _service.format_list(values, fmt)"}
{"task_id": "Mbpp/395", "solution": "import collections\nfrom typing import Optional\ndef first_non_repeating_character(s: str, case_sensitive: bool = False, ignore_whitespace: bool = True) -> Optional[str]:\n    \"\"\"\n    Finds the first non-repeated character in a given string.\n\n    The search can be configured to be case-sensitive or ignore whitespace.\n    \"\"\"\n    \n    # Normalize the input string based on parameters\n    normalized_s = s\n    if not case_sensitive:\n        normalized_s = normalized_s.casefold()\n    if ignore_whitespace:\n        normalized_s = \"\".join(ch for ch in normalized_s if not ch.isspace())\n\n    # Count character occurrences in the normalized string\n    counts = collections.Counter(normalized_s)\n\n    # Iterate through the normalized string to find the first character with a count of 1\n    for char in normalized_s:\n        if counts[char] == 1:\n            return char\n\n    # If no non-repeating character is found, return None\n    return None"}
{"task_id": "Mbpp/398", "solution": "def sum_of_digits(numbers):\n    \"\"\"\n    Computes the sum of digits for each number in a list and returns the total sum.\n    Handles negative numbers by summing digits of their absolute value.\n    \"\"\"\n    total_overall_sum = 0\n    for num_item in numbers:\n        # Convert to integer and take absolute value for digit summing\n        current_num_abs = abs(int(num_item))\n\n        current_num_digit_sum = 0\n        if current_num_abs == 0:\n            current_num_digit_sum = 0\n        else:\n            temp_num = current_num_abs\n            while temp_num > 0:\n                current_num_digit_sum += temp_num % 10\n                temp_num //= 10\n        \n        total_overall_sum += current_num_digit_sum\n    return total_overall_sum"}
{"task_id": "Mbpp/394", "solution": "def check_distinct(values: tuple) -> bool:\n    \"\"\"Checks if the given tuple contains no duplicate elements.\"\"\"\n    try:\n        # Fast path for hashable elements using a set\n        return len(set(values)) == len(values)\n    except TypeError:\n        # Fallback for unhashable elements using pairwise comparisons\n        n = len(values)\n        for i in range(n):\n            for j in range(i + 1, n):\n                if values[i] == values[j]:\n                    return False\n        return True"}
{"task_id": "Mbpp/397", "solution": "def median_numbers(a, b, c) -> float:\n    \"\"\"Calculates the median of three numbers.\n\n    Converts inputs to float, sorts them, and returns the middle value.\n    \"\"\"\n    numbers = sorted((float(a), float(b), float(c)))\n    return numbers[1]"}
