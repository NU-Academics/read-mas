{"task_id": "Mbpp/585", "solution": "import heapq\nfrom typing import Iterable, Mapping, List, Any, Optional, Dict\nimport collections.abc\nimport abc\ndef expensive_items(items: Iterable[Mapping], n: int) -> List[Mapping]:\n    class InvalidInputError(Exception):\n        \"\"\"Raised for invalid overall function inputs.\"\"\"\n        pass\n\n    class ItemParseError(Exception):\n        \"\"\"Raised when an individual item cannot be parsed or validated.\"\"\"\n        pass\n\n    def parse_n(n_raw: Any) -> int:\n        \"\"\"Coerces and validates n (must be an int >= 0).\"\"\"\n        if not isinstance(n_raw, int):\n            try:\n                n_val = int(n_raw)\n            except (ValueError, TypeError) as e:\n                raise InvalidInputError(f\"Input 'n' must be an integer, got {type(n_raw).__name__}.\") from e\n        else:\n            n_val = n_raw\n\n        if n_val < 0:\n            raise InvalidInputError(\"Input 'n' cannot be negative.\")\n        return n_val\n\n    def ensure_price_numeric(price_raw: Any) -> float:\n        \"\"\"Converts numeric-like values to float; raises ItemParseError if not numeric.\"\"\"\n        try:\n            return float(price_raw)\n        except (ValueError, TypeError) as e:\n            raise ItemParseError(f\"Item price must be a number, got {price_raw!r}.\") from e\n\n    def validate_items(items_raw: Iterable[Mapping]) -> List[Mapping]:\n        \"\"\"Ensures items is an iterable and converts it to a list.\"\"\"\n        if not isinstance(items_raw, collections.abc.Iterable):\n            raise InvalidInputError(\"Input 'items' must be an iterable.\")\n        return list(items_raw)\n\n    class Item:\n        \"\"\"Domain model representation of an item with name and price.\"\"\"\n        def __init__(self, name: str, price: float) -> None:\n            self.name: str = name\n            self.price: float = price\n\n        def to_mapping(self) -> Dict[str, Any]:\n            \"\"\"Returns the item's attributes as a dictionary.\"\"\"\n            return {\"name\": self.name, \"price\": self.price}\n\n    class ItemDTO:\n        \"\"\"Data Transfer Object for safe parsing/normalization of raw mappings to Item.\"\"\"\n        name: str\n        price: float\n\n        @staticmethod\n        def from_mapping(raw: Mapping) -> \"ItemDTO\":\n            \"\"\"Parses and validates raw item mapping to create an ItemDTO.\"\"\"\n            if not isinstance(raw, collections.abc.Mapping):\n                 raise ItemParseError(f\"Each item must be a mapping (e.g., dict), got {type(raw).__name__}.\")\n\n            if \"name\" not in raw:\n                raise ItemParseError(\"Item missing 'name' field.\")\n            name = str(raw[\"name\"])\n\n            if \"price\" not in raw:\n                raise ItemParseError(\"Item missing 'price' field.\")\n            price = ensure_price_numeric(raw[\"price\"])\n\n            dto = ItemDTO()\n            dto.name = name\n            dto.price = price\n            return dto\n\n        def to_item(self) -> Item:\n            \"\"\"Converts the DTO to a domain Item model.\"\"\"\n            return Item(self.name, self.price)\n\n    class ItemRepository(abc.ABC):\n        \"\"\"Abstract base class for item data access.\"\"\"\n        @abc.abstractmethod\n        def get_all(self) -> List[Item]:\n            \"\"\"Fetches all items from the repository.\"\"\"\n            pass\n\n    class ExpensiveItemService:\n        \"\"\"Core business logic for selecting top-n items efficiently.\"\"\"\n        def __init__(self, repository: Optional[ItemRepository] = None) -> None:\n            self._repository = repository\n\n        def top_n(self, items_input: Optional[Iterable[Mapping]], n_raw: Any) -> List[Mapping]:\n            \"\"\"Entry point to find the n most expensive items.\"\"\"\n            n_val = parse_n(n_raw)\n\n            raw_items = list(items_input) if items_input is not None else (self._repository.get_all() if self._repository else [])\n            validated_items_raw_list = validate_items(raw_items)\n            parsed_items = [ItemDTO.from_mapping(r).to_item() for r in validated_items_raw_list]\n\n            selected_items = self._select_top_n(parsed_items, n_val)\n            return [item.to_mapping() for item in selected_items]\n\n        def _select_top_n(self, items_list: List[Item], n: int) -> List[Item]:\n            \"\"\"Efficiently selects top-n items by price.\"\"\"\n            if n == 0:\n                return []\n            if n >= len(items_list):\n                return sorted(items_list, key=lambda it: it.price, reverse=True)\n            return heapq.nlargest(n, items_list, key=lambda it: it.price)\n\n    class ExpensiveItemController:\n        \"\"\"Facade for callers, delegating to the ExpensiveItemService.\"\"\"\n        def __init__(self, service: ExpensiveItemService) -> None:\n            self._service = service\n\n        def get_top_items(self, items_input: Iterable[Mapping], n_raw: int) -> List[Mapping]:\n            \"\"\"Retrieves the top N most expensive items using the service.\"\"\"\n            return self._service.top_n(items_input, n_raw)\n\n    service = ExpensiveItemService()\n    controller = ExpensiveItemController(service)\n    return controller.get_top_items(items, n)"}
{"task_id": "Mbpp/586", "solution": "def split_Arr(lst, n):\n    \"\"\"\n    Splits a list at the nth element and adds the first part to the end.\n    Handles negative n and n larger than list length by using modulo arithmetic.\n    \"\"\"\n    if not lst:\n        return []\n    \n    length = len(lst)\n    # Use modulo to handle n being negative or larger than the list length.\n    # Python's % operator handles negative numbers correctly for this use case.\n    split_index = n % length\n    \n    return lst[split_index:] + lst[:split_index]"}
