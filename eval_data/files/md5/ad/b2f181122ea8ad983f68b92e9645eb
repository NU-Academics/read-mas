{"task_id": "Mbpp/559", "solution": "def max_sub_array_sum(nums, length):\n    \"\"\"\n    Finds the maximum sum of a contiguous sublist using Kadane's algorithm.\n    Assumes the input list 'nums' is not empty.\n    \"\"\"\n    max_so_far = nums[0]\n    current_max = nums[0]\n\n    for i in range(1, length):\n        current_max = max(nums[i], current_max + nums[i])\n        max_so_far = max(max_so_far, current_max)\n\n    return max_so_far"}
{"task_id": "Mbpp/562", "solution": "def Find_Max_Length(sublists):\n    \"\"\"\n    Finds the length of the longest sublist within a list of sublists.\n    Assumes sublists are iterable and support the len() operation.\n    \"\"\"\n    max_length = 0\n    for sublist in sublists:\n        current_length = len(sublist)\n        if current_length > max_length:\n            max_length = current_length\n    return max_length"}
{"task_id": "Mbpp/563", "solution": "import re\nimport json\nfrom abc import ABC, abstractmethod\nfrom typing import List, Optional, Any\nclass ExtractionError(Exception):\n    \"\"\"Base exception for extraction errors.\"\"\"\n    pass\nclass ExtractionResult:\n    \"\"\"Container for extraction results.\"\"\"\n    def __init__(self, items: List[str]) -> None:\n        self.items: List[str] = list(items)\n        self.count: int = len(self.items)\n\n    def to_list(self) -> List[str]:\n        \"\"\"Returns a copy of the extracted items.\"\"\"\n        return self.items.copy()\n\n    def to_json(self) -> str:\n        \"\"\"Returns JSON string representation of the items.\"\"\"\n        return json.dumps(self.items)\nclass QuoteTokenizer:\n    \"\"\"Helper for unescaping quoted strings.\"\"\"\n    def unescape(self, s: str) -> str:\n        \"\"\"Unescapes backslash sequences in a string.\"\"\"\n        # This decodes common backslash escapes (e.g., \\\" to \" or \\\\ to \\)\n        return bytes(s, \"utf-8\").decode(\"unicode_escape\")\nclass ParserStrategy(ABC):\n    \"\"\"Abstract base class for parsing strategies.\"\"\"\n    @abstractmethod\n    def parse(self, input: str) -> List[str]:\n        \"\"\"Parses the input string and returns a list of extracted values.\"\"\"\n        pass\nDEFAULT_QUOTE_PATTERN = r'\"((?:\\\\.|[^\"\\\\])*)\"'\nclass RegexStrategy(ParserStrategy):\n    \"\"\"A parsing strategy that uses regular expressions.\"\"\"\n    def __init__(self, pattern: Optional[str] = None) -> None:\n        self.pattern = pattern or DEFAULT_QUOTE_PATTERN\n        self._compiled = re.compile(self.pattern)\n        self._tokenizer = QuoteTokenizer()\n\n    def parse(self, input: str) -> List[str]:\n        \"\"\"Finds all matches of quoted values, unescapes them, and returns a list.\"\"\"\n        matches = self._compiled.findall(input)\n        return [self._tokenizer.unescape(m) for m in matches]\nclass ValueExtractor:\n    \"\"\"Service for extracting values from a string using a parsing strategy.\"\"\"\n    def __init__(self, strategy: Optional[ParserStrategy] = None) -> None:\n        self.strategy = strategy or RegexStrategy()\n\n    def parse(self, input: str) -> ExtractionResult:\n        \"\"\"Validates input, calls the strategy to parse, and wraps results.\"\"\"\n        # Per user instruction: \"DO NOT add isinstance() checks or raise exceptions for edge cases\"\n        # The design context requested _validate_input, but this constraint overrides it.\n        try:\n            items = self.strategy.parse(input)\n        except Exception as e:\n            raise ExtractionError(\"Parsing failed\") from e\n        return ExtractionResult(items)\ndef extract_values(input: str) -> List[str]:\n    \"\"\"\n    Extracts values between quotation marks from a string.\n    This is a convenience wrapper around ValueExtractor.\n    \"\"\"\n    extractor = ValueExtractor()\n    return extractor.parse(input).to_list()"}
