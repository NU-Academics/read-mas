{"task_id": "Mbpp/731", "solution": "import math\ndef lateralsurface_cone(r: float, h: float) -> float:\n    \"\"\"\n    Calculates the lateral surface area of a cone given its radius and height.\n    The lateral surface area is pi * r * l, where l is the slant height.\n    \"\"\"\n    slant_height = math.hypot(r, h)  # l = sqrt(r^2 + h^2)\n    area = math.pi * r * slant_height\n    return area"}
{"task_id": "Mbpp/723", "solution": "def count_same_pair(a, b) -> int:\n    \"\"\"\n    Counts the number of indices where values in two sequences are identical.\n    Assumes inputs 'a' and 'b' are sequences of the same length.\n    \"\"\"\n    count = 0\n    for val_a, val_b in zip(a, b):\n        if val_a == val_b:\n            count += 1\n    return count"}
{"task_id": "Mbpp/730", "solution": "def consecutive_duplicates(input_list: Sequence[Any]) -> List[Any]:\n    \"\"\"Removes consecutive duplicate elements from a list, preserving original order.\"\"\"\n    out: List[Any] = []\n    prev_set = False\n    prev = None\n    for x in input_list:\n        if not prev_set or x != prev:\n            out.append(x)\n            prev = x\n            prev_set = True\n    return out"}
{"task_id": "Mbpp/728", "solution": "def sum_list(a, b):\n    \"\"\"\n    Computes the element-wise sum of two lists.\n    Assumes inputs are lists of numbers with the same length.\n    \"\"\"\n    return [x + y for x, y in zip(a, b)]"}
{"task_id": "Mbpp/733", "solution": "def find_first_occurrence(arr: list[int], target: int) -> int:\n    \"\"\"\n    Finds the index of the first occurrence of a given number in a sorted array using binary search.\n    Returns -1 if the target is not found.\n    \"\"\"\n    left = 0\n    right = len(arr) - 1\n    result = -1\n\n    while left <= right:\n        mid = (left + right) // 2\n        if arr[mid] == target:\n            result = mid\n            right = mid - 1  # Try to find an earlier occurrence in the left half\n        elif arr[mid] < target:\n            left = mid + 1\n        else:  # arr[mid] > target\n            right = mid - 1\n    return result"}
{"task_id": "Mbpp/732", "solution": "def replace_specialchar(s: str) -> str:\n    \"\"\"\n    Replaces all occurrences of spaces, commas, or dots with a colon in the input string.\n    Uses str.maketrans and str.translate for efficient character replacement.\n    \"\"\"\n    chars_to_replace = \" ,.\"\n    replacement_char = \":\"\n    translation_table = str.maketrans(chars_to_replace, replacement_char * len(chars_to_replace))\n    return s.translate(translation_table)"}
{"task_id": "Mbpp/735", "solution": "def toggle_middle_bits(n: int) -> int:\n    # Determine the MSB and LSB indices and build a toggle mask for bits between them.\n    # If there are no middle bits (n < 4 or msb_idx - lsb_idx <= 1), return n unchanged.\n    if n <= 3:  # No middle bits for numbers 0, 1, 2, 3 (e.g., 0b00, 0b01, 0b10, 0b11)\n        return n\n\n    # Calculate MSB index (0-based from LSB)\n    # n.bit_length() gives the number of bits required to represent n, so MSB index is length - 1.\n    msb_idx = n.bit_length() - 1\n\n    # Calculate LSB index (0-based from LSB)\n    # (n & -n) isolates the LSB. bit_length() on this result gives 1 for bit 0, 2 for bit 1 etc.\n    # so we subtract 1 to get the 0-based index.\n    lsb_idx = (n & -n).bit_length() - 1\n\n    # If MSB and LSB are adjacent or the same, there are no middle bits.\n    if msb_idx - lsb_idx <= 1:\n        return n\n\n    # Build the toggle mask: create a sequence of '1's for the middle bits positions.\n    # The number of middle bits is msb_idx - lsb_idx - 1.\n    width = msb_idx - lsb_idx - 1\n    # Create a mask of 'width' ones: (1 << width) - 1\n    # Shift this mask to align with the middle bit positions (starting at lsb_idx + 1).\n    mask = ((1 << width) - 1) << (lsb_idx + 1)\n\n    # XOR n with the mask to toggle the middle bits.\n    return n ^ mask"}
{"task_id": "Mbpp/734", "solution": "def sum_Of_Subarray_Prod(nums: list) -> int:\n    \"\"\"Calculates the sum of products of all contiguous sublists of a given list.\"\"\"\n    total_sum = 0\n    n = len(nums)\n\n    for start in range(n):\n        current_product = 1\n        for end in range(start, n):\n            current_product *= nums[end]\n            total_sum += current_product\n    \n    return total_sum"}
{"task_id": "Mbpp/736", "solution": "def left_insertion(seq, value, key=None):\n    \"\"\"\n    Locates the left insertion point for a specified value in a sorted sequence.\n    This function implements the bisect_left algorithm.\n    \"\"\"\n    target_value = key(value) if key else value\n    lo = 0\n    hi = len(seq)\n\n    while lo < hi:\n        mid = (lo + hi) // 2\n        seq_mid_val = key(seq[mid]) if key else seq[mid]\n\n        if seq_mid_val < target_value:\n            lo = mid + 1\n        else:\n            hi = mid\n    return lo"}
{"task_id": "Mbpp/737", "solution": "import re\ndef check_str(s: str) -> bool:\n    \"\"\"\n    Checks if the given string starts with a vowel using a regular expression.\n    The check is case-insensitive and considers 'a', 'e', 'i', 'o', 'u' as vowels.\n    \"\"\"\n    vowel_pattern = r'^[aeiou]'\n    match = re.match(vowel_pattern, s, flags=re.IGNORECASE)\n    return bool(match)"}
{"task_id": "Mbpp/725", "solution": "import re\nfrom abc import ABC, abstractmethod\nfrom datetime import datetime, timezone\nfrom pathlib import Path\nimport json\nclass InvalidInputError(ValueError):\n    \"\"\"Raised when the input is invalid.\"\"\"\n    pass\nclass RepositoryError(IOError):\n    \"\"\"Raised when persistence operations fail.\"\"\"\n    pass\nclass Utils:\n    \"\"\"Utility functions and small helpers.\"\"\"\n\n    @staticmethod\n    def validate_input(text: str) -> None:\n        \"\"\"Validates that the input is a string.\"\"\"\n        if not isinstance(text, str):\n            raise InvalidInputError(\"Input must be a string.\")\n\n    @staticmethod\n    def unescape(value: str) -> str:\n        \"\"\"Returns the value with escaped sequences processed (e.g., \\\\\" -> \" and \\\\\\\\ -> \\\\).\"\"\"\n        value = value.replace('\\\\\"', '\"')\n        value = value.replace('\\\\\\\\', '\\\\')\n        return value\n\n    @staticmethod\n    def now_iso8601() -> str:\n        \"\"\"Returns the current UTC time in ISO8601 format.\"\"\"\n        return datetime.now(timezone.utc).isoformat(timespec='microseconds').replace('+00:00', 'Z')\nclass QuotedResult:\n    \"\"\"DTO for extraction results and JSON serialization.\"\"\"\n\n    def __init__(self, source: str, values: list[str], extracted_at: str) -> None:\n        if not isinstance(source, str):\n            raise ValueError(\"Source must be a string.\")\n        if not isinstance(values, list) or not all(isinstance(v, str) for v in values):\n            raise ValueError(\"Values must be a list of strings.\")\n\n        self.source = source\n        self.values = values\n        self.count = len(values)\n        self.extracted_at = extracted_at\n\n    def to_dict(self) -> dict:\n        \"\"\"Serializes the QuotedResult object to a JSON-compatible dictionary.\"\"\"\n        return {\n            \"schema_version\": \"1.0\",\n            \"source\": self.source,\n            \"values\": self.values,\n            \"count\": self.count,\n            \"extracted_at\": self.extracted_at,\n        }\n\n    @classmethod\n    def from_dict(cls, d: dict):\n        \"\"\"Creates a QuotedResult object from a dictionary.\"\"\"\n        if not all(k in d for k in [\"source\", \"values\", \"extracted_at\"]):\n            raise ValueError(\"Missing required fields in dictionary for QuotedResult.\")\n        return cls(source=d[\"source\"], values=d[\"values\"], extracted_at=d[\"extracted_at\"])\nclass ExtractionStrategy(ABC):\n    \"\"\"Abstract interface for extraction algorithms.\"\"\"\n\n    @abstractmethod\n    def extract(self, text: str) -> list[str]:\n        \"\"\"Abstract method to extract quoted substrings from the given text.\"\"\"\n        pass\nclass RegexExtractionStrategy(ExtractionStrategy):\n    \"\"\"Extracts quoted values using a compiled regex that handles escaped quotes.\"\"\"\n\n    def __init__(self, pattern: str = r'\"((?:\\\\.|[^\"\\\\])*)\"') -> None:\n        self.pattern = pattern\n        self._compiled = re.compile(self.pattern)\n\n    def extract(self, text: str) -> list[str]:\n        \"\"\"Extracts quoted substrings from the text using regex.\"\"\"\n        Utils.validate_input(text)\n        matches = [Utils.unescape(m.group(1)) for m in self._compiled.finditer(text)]\n        return matches\nclass FileRepository:\n    \"\"\"Persists QuotedResult to disk as JSON using atomic replace.\"\"\"\n\n    def __init__(self, directory: str = \".\") -> None:\n        self.directory = Path(directory)\n        self.directory.mkdir(parents=True, exist_ok=True)\n\n    def save(self, result: QuotedResult, path: Path | None = None) -> Path:\n        \"\"\"Saves a QuotedResult object to a JSON file.\"\"\"\n        if path is None:\n            filename = f\"extraction_result_{Utils.now_iso8601().replace(':', '-').replace('.', '-')}.json\"\n            path = self.directory / filename\n        \n        try:\n            data = json.dumps(result.to_dict(), indent=2)\n            self._atomic_write(path, data)\n            return path\n        except Exception as e:\n            raise RepositoryError(f\"Failed to save result to {path}: {e}\") from e\n\n    def _atomic_write(self, path: Path, data: str) -> None:\n        \"\"\"Writes data to a file atomically using a temporary file.\"\"\"\n        temp_path = path.with_suffix(f\".{path.suffix}.tmp-{Utils.now_iso8601().replace(':', '').replace('.', '')}\")\n        try:\n            temp_path.write_text(data, encoding=\"utf-8\")\n            temp_path.rename(path)\n        except Exception as e:\n            if temp_path.exists():\n                temp_path.unlink()\n            raise RepositoryError(f\"Atomic write failed for {path}: {e}\") from e\nclass ExtractorService:\n    \"\"\"Orchestrates extraction and optional persistence.\"\"\"\n\n    def __init__(self, strategy: ExtractionStrategy, repository: FileRepository | None = None) -> None:\n        self.strategy = strategy\n        self.repository = repository\n\n    def extract(self, text: str, persist: bool = False, path: str | None = None) -> list[str]:\n        \"\"\"Extracts quoted substrings from the text and optionally persists them.\"\"\"\n        Utils.validate_input(text)\n        values = self.strategy.extract(text)\n        if persist:\n            result = self.extract_as_result(text)\n            if not self.repository:\n                raise RepositoryError(\"No repository configured for persistence.\")\n            saved_path = self.repository.save(result, Path(path) if path else None)\n        return values\n\n    def extract_as_result(self, text: str) -> QuotedResult:\n        \"\"\"Extracts quoted substrings and returns them as a QuotedResult object.\"\"\"\n        values = self.strategy.extract(text)\n        return QuotedResult(source=text, values=values, extracted_at=Utils.now_iso8601())\ndef extract_quotation(text: str) -> list[str]:\n    \"\"\"\n    Extracts values between double quotation marks \" \" from the given string.\n    \"\"\"\n    service = ExtractorService(strategy=RegexExtractionStrategy(), repository=None)\n    return service.extract(text, persist=False)"}
{"task_id": "Mbpp/739", "solution": "import math\ndef find_Index(n: int) -> int:\n    \"\"\"\n    Finds the index of the smallest triangular number with n digits.\n    This uses integer arithmetic to avoid floating-point precision issues for large n.\n    \"\"\"\n    # Smallest number with n digits is 10^(n-1)\n    lower_bound_value = 10**(n - 1)\n\n    # The k-th triangular number is T_k = k * (k + 1) / 2\n    # We want T_k >= lower_bound_value\n    # k * (k + 1) / 2 >= 10^(n-1)\n    # k^2 + k - 2 * 10^(n-1) >= 0\n    # Solving for k using the quadratic formula k = (-1 + sqrt(1 - 4 * 1 * (-2 * 10^(n-1)))) / 2\n    # k = (-1 + sqrt(1 + 8 * 10^(n-1))) / 2\n\n    discriminant = 1 + 8 * lower_bound_value\n    \n    # Calculate integer square root. math.isqrt returns floor(sqrt(x)).\n    # We need ceil((-1 + sqrt(discriminant))/2)\n    s = math.isqrt(discriminant)\n\n    # If s*s is less than the discriminant, it means s is floor(sqrt(discriminant)),\n    # so we need to add 1 to effectively get ceil(sqrt(discriminant)) for the formula.\n    # However, k = ceil((s-1)/2) for the exact formula. The design document's approach of s+=1 then s//2\n    # is a specific way to handle the ceil. Let's follow it.\n    if s * s < discriminant:\n        s += 1\n    \n    k_candidate = s // 2\n\n    # Helper function to compute triangular number\n    def triangular_number(idx: int) -> int:\n        return idx * (idx + 1) // 2\n\n    # Adjust k_candidate with safety loops to ensure it's the minimal index.\n    # The initial calculation might be slightly off due to integer root ceiling/floor interactions.\n    while triangular_number(k_candidate) < lower_bound_value:\n        k_candidate += 1\n    \n    # Ensure k_candidate is the smallest possible index.\n    # If k_candidate - 1 also satisfies the condition, then k_candidate is too high.\n    while k_candidate > 1 and triangular_number(k_candidate - 1) >= lower_bound_value:\n        k_candidate -= 1\n\n    return k_candidate"}
{"task_id": "Mbpp/740", "solution": "def tuple_to_dict(input_tuple):\n    \"\"\"\n    Converts a tuple to a key-value dictionary using adjacent elements.\n    Later occurrences of duplicate keys will overwrite earlier ones.\n    \"\"\"\n    result = {}\n    for i in range(0, len(input_tuple), 2):\n        key = input_tuple[i]\n        val = input_tuple[i + 1]\n        result[key] = val\n    return result"}
{"task_id": "Mbpp/741", "solution": "def all_Characters_Same(s: str) -> bool:\n    \"\"\"Checks if all characters in a string are identical.\n    Returns True for empty strings, and False if any character differs.\"\"\"\n    if len(s) == 0:\n        return True\n    first_char = s[0]\n    for char in s:\n        if char != first_char:\n            return False\n    return True"}
{"task_id": "Mbpp/743", "solution": "def rotate_right(lst, k):\n    \"\"\"Rotates a list to the right by k positions.\"\"\"\n    n = len(lst)\n    if n == 0:\n        return []\n    \n    # Calculate the effective shift. Python's % operator handles negative k correctly\n    # such that the result is always non-negative for a positive n.\n    k_eff = k % n\n    \n    return lst[-k_eff:] + lst[:-k_eff]"}
