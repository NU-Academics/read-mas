{"task_id": "Mbpp/91", "solution": "from typing import List, Optional, Iterator\nclass SubstringQuery:\n    \"\"\"\n    Data Transfer Object for substring search queries.\n    Holds the list of strings, the target substring, and case sensitivity flag.\n    \"\"\"\n    def __init__(self, values: List[str], substring: str, case_sensitive: bool = True) -> None:\n        self.values = values\n        self.substring = substring\n        self.case_sensitive = case_sensitive\nclass SubstringResult:\n    \"\"\"\n    Data Transfer Object for substring search results.\n    Indicates if the substring was found and, optionally, the first matched string.\n    \"\"\"\n    def __init__(self, found: bool, matched_value: Optional[str] = None) -> None:\n        self.found = found\n        self.matched_value = matched_value\nclass StringRepository:\n    \"\"\"\n    Manages access to a collection of string values.\n    Provides methods to iterate through the stored strings.\n    \"\"\"\n    def __init__(self, values: List[str]) -> None:\n        # Assumes values is already a list of strings as per type hint and prompt constraints.\n        self._values = values\n\n    def iterate_values(self) -> Iterator[str]:\n        \"\"\"Yields each string value from the collection.\"\"\"\n        for v in self._values:\n            yield v\nclass SubstringService:\n    \"\"\"\n    Core business logic for finding a substring within a collection of strings.\n    Uses a StringRepository to access values and performs the matching.\n    \"\"\"\n    def __init__(self, repo: StringRepository) -> None:\n        self._repo = repo\n\n    def find(self, query: SubstringQuery) -> SubstringResult:\n        \"\"\"\n        Executes the substring search based on the provided query.\n        Returns a SubstringResult indicating if the substring was found.\n        \"\"\"\n        substring = query.substring\n        for v in self._repo.iterate_values():\n            if self._match(v, substring, query.case_sensitive):\n                return SubstringResult(True, matched_value=v)\n        return SubstringResult(False, None)\n\n    def _match(self, value: str, substring: str, case_sensitive: bool) -> bool:\n        \"\"\"Performs the actual substring matching with respect to case sensitivity.\"\"\"\n        if not case_sensitive:\n            return substring.lower() in value.lower()\n        return substring in value\ndef find_substring(values, substring):\n    \"\"\"\n    Checks if a string is present as a substring in a given list of string values.\n    The search is case-sensitive as per default design.\n    \"\"\"\n    repo = StringRepository(values)\n    service = SubstringService(repo)\n    query = SubstringQuery(values, substring, case_sensitive=True)\n\n    result = service.find(query)\n    return result.found"}
{"task_id": "Mbpp/92", "solution": "def is_undulating(n):\n    \"\"\"\n    Checks if a number is undulating (digits alternate between two distinct digits, minimum length 3).\n    The sign of the number is ignored.\n    \"\"\"\n    s = str(abs(n))\n    digits = [int(d) for d in s]\n\n    if len(digits) < 3: # Default minimum length is 3 according to design.\n        return False\n\n    first_digit = digits[0]\n    second_digit = digits[1]\n\n    if first_digit == second_digit: # The two alternating digits must be distinct.\n        return False\n\n    for i in range(len(digits)):\n        if i % 2 == 0:  # Even indices should match the first digit\n            if digits[i] != first_digit:\n                return False\n        else:  # Odd indices should match the second digit\n            if digits[i] != second_digit:\n                return False\n\n    return True"}
