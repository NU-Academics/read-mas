{"task_id": "Mbpp/19", "solution": "from collections.abc import Sequence\ndef test_duplicate(values: Sequence[int]) -> bool:\n    \"\"\"\n    Checks if a sequence of integers contains any duplicate elements.\n    Raises DuplicateCheckError for invalid input types.\n    \"\"\"\n    class DuplicateCheckError(Exception):\n        def __init__(self, message: str) -> None:\n            super().__init__(message)\n            self.message = message\n\n    class Validators:\n        @staticmethod\n        def validate_integer_sequence(values_to_validate: Sequence[int]) -> None:\n            if not hasattr(values_to_validate, \"__iter__\"):\n                raise DuplicateCheckError(\"Input must be iterable\")\n            for i, v in enumerate(values_to_validate):\n                if not isinstance(v, int):\n                    raise DuplicateCheckError(f\"Element at index {i} is not an int: {v!r}\")\n\n    import abc\n    class SeenRepository(abc.ABC):\n        @abc.abstractmethod\n        def add(self, value: int) -> None:\n            pass\n\n        @abc.abstractmethod\n        def contains(self, value: int) -> bool:\n            pass\n\n        @abc.abstractmethod\n        def reset(self) -> None:\n            pass\n\n    class InMemorySeenRepository(SeenRepository):\n        def __init__(self) -> None:\n            self._set: set[int] = set()\n\n        def add(self, value: int) -> None:\n            self._set.add(value)\n\n        def contains(self, value: int) -> bool:\n            return value in self._set\n\n        def reset(self) -> None:\n            self._set.clear()\n\n    class DuplicateService:\n        def __init__(self, repo: SeenRepository) -> None:\n            self._repo = repo\n\n        def has_duplicate(self, values_to_check: list[int]) -> bool:\n            self._repo.reset()\n            for v in values_to_check:\n                if self._repo.contains(v):\n                    return True\n                self._repo.add(v)\n            return False\n\n    Validators.validate_integer_sequence(values)\n    svc = DuplicateService(InMemorySeenRepository())\n    return svc.has_duplicate(list(values))"}
