{"task_id": "Mbpp/644", "solution": "def reverse_Array_Upto_K(arr, k):\n    \"\"\"\n    Reverses the first 'k' elements of an array and returns a new array.\n    The original array remains unchanged.\n    \"\"\"\n    # Create a copy of the input array to avoid modifying the original.\n    temp_arr = list(arr)\n    \n    # Reverse the prefix of length 'k'.\n    # This creates a new list for the reversed prefix.\n    reversed_prefix = temp_arr[:k][::-1]\n    \n    # Concatenate the reversed prefix with the rest of the array.\n    # The remainder of the array starts from index 'k'.\n    return reversed_prefix + temp_arr[k:]"}
{"task_id": "Mbpp/722", "solution": "def filter_data(data: dict[str, tuple[float, float]], min_height: float, min_weight: float) -> dict[str, tuple[float, float]]:\n    \"\"\"\n    Filters a dictionary of students, returning those whose height and weight meet the minimum thresholds.\n    Thresholds for height and weight are inclusive (>=).\n    \"\"\"\n    filtered_students = {}\n    for student_name, (height, weight) in data.items():\n        if height >= min_height and weight >= min_weight:\n            filtered_students[student_name] = (height, weight)\n    return filtered_students"}
{"task_id": "Mbpp/724", "solution": "def power_base_sum(base, power):\n    \"\"\"\n    Calculates the sum of all digits of the base to the specified power.\n    \"\"\"\n    result = base ** power\n    s = str(abs(result))\n    digit_sum = sum(int(digit_char) for digit_char in s)\n    return digit_sum"}
{"task_id": "Mbpp/721", "solution": "def maxAverageOfPath(matrix: list[list[int]]) -> float:\n    \"\"\"\n    Computes the maximum average cost of a path from the top-left to the bottom-right\n    cell of a square matrix, moving only right or down.\n    \"\"\"\n    n = len(matrix)\n    \n    # dp[i][j] stores the maximum sum to reach cell (i, j)\n    dp = [[0.0] * n for _ in range(n)]\n\n    # Base case: top-left cell\n    dp[0][0] = float(matrix[0][0])\n\n    # Fill the first row (only moving right)\n    for j in range(1, n):\n        dp[0][j] = dp[0][j-1] + float(matrix[0][j])\n\n    # Fill the first column (only moving down)\n    for i in range(1, n):\n        dp[i][0] = dp[i-1][0] + float(matrix[i][0])\n\n    # Fill the rest of the dp table\n    for i in range(1, n):\n        for j in range(1, n):\n            # To reach (i, j), we must come from (i-1, j) or (i, j-1)\n            # Choose the path that yields the maximum sum\n            dp[i][j] = max(dp[i-1][j], dp[i][j-1]) + float(matrix[i][j])\n\n    # The maximum total sum for any path is at the bottom-right cell\n    max_total_sum = dp[n-1][n-1]\n\n    # Every path from (0,0) to (n-1,n-1) moving only right or down visits exactly 2*n - 1 cells\n    num_cells_in_path = 2 * n - 1\n\n    # Calculate the maximum average\n    max_average = max_total_sum / num_cells_in_path\n\n    return max_average"}
