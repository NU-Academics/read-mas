{"task_id": "Mbpp/799", "solution": "def left_rotate(n: int, d: int) -> int:\n    \"\"\"\n    Rotates the bits of a 32-bit number `n` left by `d` positions.\n\n    The number `n` is treated as a 32-bit unsigned integer, and the shift amount `d` is\n    normalized to be within the 32-bit width.\n    \"\"\"\n    WIDTH = 32\n    MASK = 0xFFFFFFFF\n\n    # Ensure n is treated as a 32-bit unsigned integer by masking it.\n    n = n & MASK\n\n    # Normalize the shift amount d to be within the range [0, WIDTH-1].\n    d = d % WIDTH\n\n    # Perform the left rotation.\n    # The left part shifts bits to the left, with bits falling off the MSB end.\n    # The right part brings the \"fallen off\" bits back to the LSB end.\n    # The final mask ensures the result remains within 32 bits.\n    result = ((n << d) | (n >> (WIDTH - d))) & MASK\n    return result"}
{"task_id": "Mbpp/797", "solution": "class InvalidInputError(Exception):\n    \"\"\"Raised when input types or values are invalid.\"\"\"\n    pass\nclass InvalidRangeError(Exception):\n    \"\"\"Raised when the specified range is invalid (e.g., l > r).\"\"\"\n    pass\nclass PersistenceError(Exception):\n    \"\"\"Raised when an error occurs during data persistence.\"\"\"\n    pass\nclass Range:\n    \"\"\"Represents an inclusive integer range [l, r].\"\"\"\n    def __init__(self, l: int, r: int) -> None:\n        self.l = l\n        self.r = r\n\n    def normalize_for_natural(self) -> \"Range\":\n        \"\"\"Returns a new Range with the lower bound adjusted to be at least 1.\"\"\"\n        return Range(max(self.l, 1), self.r)\nclass RangeValidator:\n    \"\"\"Validates raw inputs and constructs a Range domain object.\"\"\"\n    def validate(self, l: object, r: object) -> Range:\n        \"\"\"\n        Validates the inputs l and r, ensuring they are integers and l <= r.\n        Raises InvalidInputError or InvalidRangeError on validation failure.\n        \"\"\"\n        try:\n            l_int = int(l)\n            r_int = int(r)\n        except (ValueError, TypeError) as e:\n            raise InvalidInputError(f\"Inputs must be integers: {e}\")\n\n        if l_int > r_int:\n            raise InvalidRangeError(f\"Invalid range: l ({l_int}) cannot be greater than r ({r_int})\")\n\n        return Range(l_int, r_int)\ndef sum_of_odds_inclusive(a: int, b: int) -> int:\n    \"\"\"\n    Calculates the sum of all odd integers in the inclusive range [a, b].\n    Uses an arithmetic progression formula for O(1) performance.\n    \"\"\"\n    if a % 2 == 0:\n        a += 1\n    if b % 2 == 0:\n        b -= 1\n\n    if a > b:\n        return 0\n\n    n = ((b - a) // 2) + 1\n    return n * (a + b) // 2\ndef now_iso8601() -> str:\n    \"\"\"Returns the current UTC time in ISO 8601 format.\"\"\"\n    import datetime\n    return datetime.datetime.now(datetime.timezone.utc).isoformat(timespec='seconds').replace('+00:00', 'Z')\nclass SumResultDTO:\n    \"\"\"Data Transfer Object for persisting sum results.\"\"\"\n    def __init__(self, id: str, l: int, r: int, sum: int, timestamp: str) -> None:\n        self.id = id\n        self.l = l\n        self.r = r\n        self.sum = sum\n        self.timestamp = timestamp\n\n    def to_dict(self) -> dict:\n        \"\"\"Converts the DTO to a dictionary.\"\"\"\n        return {\n            \"id\": self.id,\n            \"l\": self.l,\n            \"r\": self.r,\n            \"sum\": self.sum,\n            \"timestamp\": self.timestamp,\n        }\n\n    @classmethod\n    def from_values(cls, l: int, r: int, sum: int) -> \"SumResultDTO\":\n        \"\"\"Creates a SumResultDTO with a new UUID and current timestamp.\"\"\"\n        import uuid\n        return cls(str(uuid.uuid4()), l, r, sum, now_iso8601())\nclass SumRepositoryInterface:\n    \"\"\"Interface for sum result persistence.\"\"\"\n    def persist(self, record: dict) -> None:\n        raise NotImplementedError\n\n    def read_all(self) -> list:\n        raise NotImplementedError\nclass JsonSumRepository(SumRepositoryInterface):\n    \"\"\"JSON file-based repository for sum results.\"\"\"\n    def __init__(self, path: str) -> None:\n        import os\n        import json\n        self._path = path\n        self._ensure_file_exists()\n\n    def _ensure_file_exists(self) -> None:\n        \"\"\"Ensures the JSON file exists and contains an empty list if new.\"\"\"\n        import os\n        import json\n        if not os.path.exists(self._path):\n            try:\n                os.makedirs(os.path.dirname(self._path) or '.', exist_ok=True)\n                with open(self._path, 'w', encoding='utf-8') as f:\n                    json.dump([], f)\n            except IOError as e:\n                raise PersistenceError(f\"Failed to create persistence file {self._path}: {e}\")\n\n    def persist(self, record: dict) -> None:\n        \"\"\"Appends the record to the JSON array in the file using an atomic write pattern.\"\"\"\n        import os\n        import json\n        import shutil\n        try:\n            temp_path = self._path + \".tmp\"\n            \n            with open(self._path, 'r', encoding='utf-8') as f:\n                data = json.load(f)\n            \n            data.append(record)\n\n            with open(temp_path, 'w', encoding='utf-8') as f:\n                json.dump(data, f, indent=2)\n            \n            shutil.move(temp_path, self._path)\n        except (IOError, json.JSONDecodeError) as e:\n            raise PersistenceError(f\"Failed to persist record to {self._path}: {e}\")\n\n    def read_all(self) -> list:\n        \"\"\"Reads all records from the JSON file.\"\"\"\n        import json\n        try:\n            with open(self._path, 'r', encoding='utf-8') as f:\n                return json.load(f)\n        except (IOError, json.JSONDecodeError) as e:\n            raise PersistenceError(f\"Failed to read records from {self._path}: {e}\")\nDEFAULT_PERSIST_PATH = \"results.json\"\nclass OddSumService:\n    \"\"\"Provides business logic to compute sum of odd natural numbers and orchestrate persistence.\"\"\"\n    def __init__(self, repository: SumRepositoryInterface) -> None:\n        self._repo = repository\n\n    def sum(self, range: Range) -> int:\n        \"\"\"\n        Computes the sum of odd natural numbers within the given range,\n        persists the result, and returns the sum.\n        \"\"\"\n        normalized_range = range.normalize_for_natural()\n\n        if normalized_range.l > normalized_range.r:\n            result = 0\n        else:\n            result = sum_of_odds_inclusive(normalized_range.l, normalized_range.r)\n        \n        dto = SumResultDTO.from_values(range.l, range.r, result)\n        self._repo.persist(dto.to_dict())\n        \n        return result\ndef sum_in_range(l: int, r: int) -> int:\n    \"\"\"\n    Finds the sum of all odd natural numbers within the inclusive range l and r.\n    This function validates inputs, computes the sum, and persists the result.\n    \"\"\"\n    rng = RangeValidator().validate(l, r)\n    repo = JsonSumRepository(DEFAULT_PERSIST_PATH)\n    svc = OddSumService(repo)\n    return svc.sum(rng)"}
{"task_id": "Mbpp/800", "solution": "def remove_all_spaces(text):\n    \"\"\"Removes all whitespace characters from the input string.\n    Whitespace is determined by str.isspace().\n    \"\"\"\n    return ''.join(char for char in text if not char.isspace())"}
{"task_id": "Mbpp/801", "solution": "from .models.number_triplet import NumberTriplet\nfrom .services.equality_service import EqualityService\ndef test_three_equal(a: int, b: int, c: int) -> int:\n    \"\"\"\n    Counts the number of equal integers among three given inputs.\n    Uses NumberTriplet for input validation and EqualityService for the core logic.\n    \"\"\"\n    triplet = NumberTriplet(a, b, c)  # Validates inputs during construction\n    service = EqualityService()\n    return service.count_equals(triplet)"}
{"task_id": "Mbpp/804", "solution": "def is_product_even(numbers):\n    \"\"\"\n    Checks if the product of numbers in a list is even.\n    The product is even if at least one number in the list is even.\n    \"\"\"\n    for number in numbers:\n        if number % 2 == 0:\n            return True\n    return False"}
{"task_id": "Mbpp/805", "solution": "def max_sum_list(lists):\n    \"\"\"\n    Returns the sub-list from a list of lists whose sum of elements is the highest.\n    If multiple sub-lists have the same highest sum, the first one encountered is returned.\n    \"\"\"\n    max_sum = float('-inf')  # Initialize with negative infinity to handle lists with negative numbers\n    max_list = None\n\n    for sublist in lists:\n        current_sum = sum(sublist)\n        if current_sum > max_sum:\n            max_sum = current_sum\n            max_list = sublist\n            \n    return max_list"}
{"task_id": "Mbpp/803", "solution": "def is_perfect_square(n):\n    \"\"\"\n    Checks if a given number is a perfect square using integer square root.\n    Assumes n is an int and non-negative, as per design context (validation handled upstream).\n    \"\"\"\n    if n < 0:\n        return False\n    \n    # Using integer binary search for square root\n    lo, hi = 0, n\n    while lo <= hi:\n        mid = (lo + hi) // 2\n        sq = mid * mid\n        if sq == n:\n            return True\n        if sq < n:\n            lo = mid + 1\n        else:\n            hi = mid - 1\n            \n    return False"}
{"task_id": "Mbpp/806", "solution": "def max_run_uppercase(s: str) -> int:\n    \"\"\"\n    Calculates the maximum contiguous run of uppercase characters in the given string.\n    \"\"\"\n    max_run = 0\n    current_run = 0\n    for char in s:\n        if char.isalpha() and char.isupper():\n            current_run += 1\n            if current_run > max_run:\n                max_run = current_run\n        else:\n            current_run = 0\n    return max_run"}
