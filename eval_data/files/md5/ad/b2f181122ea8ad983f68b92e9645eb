{"task_id": "Mbpp/56", "solution": "def reverse_int(n: int) -> int:\n    \"\"\"Reverses the digits of the absolute value of n.\"\"\"\n    s = str(abs(n))\n    return int(s[::-1]) if s else 0\ndef check(n: int) -> bool:\n    \"\"\"\n    Checks if a given number `n` is one less than twice its reverse.\n    The reverse operation considers the absolute value of `n`.\n    \"\"\"\n    reversed_n = reverse_int(n)\n    return n == (2 * reversed_n - 1)"}
{"task_id": "Mbpp/59", "solution": "def nth_octagonal(n: int) -> int:\n    \"\"\"Calculates the nth octagonal number using the formula O(n) = n * (3n - 2).\"\"\"\n    return n * (3 * n - 2)"}
{"task_id": "Mbpp/57", "solution": "def find_Max_Num(digits):\n    \"\"\"\n    Finds the largest number that can be formed from a list of digits.\n    The digits are sorted in descending order and then concatenated to form the maximum integer.\n    \"\"\"\n    sorted_digits = sorted(digits, reverse=True)\n    if not sorted_digits:\n        return 0\n    return int(''.join(str(d) for d in sorted_digits))"}
{"task_id": "Mbpp/65", "solution": "def recursive_list_sum(list_input):\n    \"\"\"Flattens a list and sums all numeric elements recursively.\n    Non-numeric or boolean elements are silently ignored.\n    \"\"\"\n    total_sum = 0\n    for element in list_input:\n        if isinstance(element, list):\n            total_sum += recursive_list_sum(element)\n        elif isinstance(element, (int, float)) and not isinstance(element, bool):\n            total_sum += element\n    return total_sum"}
