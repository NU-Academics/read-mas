{"task_id": "HumanEval/30", "solution": "def get_positive(l: list):\n    \"\"\"Return only positive numbers in the list.\n    >>> get_positive([-1, 2, -4, 5, 6])\n    [2, 5, 6]\n    >>> get_positive([5, 3, -5, 2, -3, 3, 9, 0, 123, 1, -10])\n    [5, 3, 2, 3, 9, 123, 1]\n    \"\"\"\n    positive_numbers = []\n    for number in l:\n        if number > 0:\n            positive_numbers.append(number)\n    return positive_numbers"}
{"task_id": "HumanEval/29", "solution": "from typing import List\ndef filter_by_prefix(strings: List[str], prefix: str) -> List[str]:\n    \"\"\" Filter an input list of strings only for ones that start with a given prefix.\n    >>> filter_by_prefix([], 'a')\n    []\n    >>> filter_by_prefix(['abc', 'bcd', 'cde', 'array'], 'a')\n    ['abc', 'array']\n    \"\"\"\n    filtered_strings = []\n    for s in strings:\n        if s.startswith(prefix):\n            filtered_strings.append(s)\n    return filtered_strings"}
{"task_id": "HumanEval/31", "solution": "from math import isqrt\ndef is_prime(n):\n    \"\"\"Return true if a given number is prime, and false otherwise.\n    >>> is_prime(6)\n    False\n    >>> is_prime(101)\n    True\n    >>> is_prime(11)\n    True\n    >>> is_prime(13441)\n    True\n    >>> is_prime(61)\n    True\n    >>> is_prime(4)\n    False\n    >>> is_prime(1)\n    False\n    \"\"\"\n    if n <= 1:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n    \n    # Check for divisors from 3 up to sqrt(n)\n    # math.isqrt returns the integer part of the square root\n    # We only need to check odd divisors.\n    for i in range(3, isqrt(n) + 1, 2):\n        if n % i == 0:\n            return False\n            \n    return True"}
{"task_id": "HumanEval/34", "solution": "def unique(l: list) -> list:\n    \"\"\"Return sorted unique elements in a list\n    >>> unique([5, 3, 5, 2, 3, 3, 9, 0, 123])\n    [0, 2, 3, 5, 9, 123]\n    \"\"\"\n    # Convert to a set to remove duplicates, then convert back to a list.\n    unique_elements = list(set(l))\n    # Sort the list of unique elements in ascending order.\n    unique_elements.sort()\n    return unique_elements"}
{"task_id": "HumanEval/33", "solution": "class ListInput:\n    \"\"\"Wrapper for the input list, providing length and element access.\"\"\"\n    def __init__(self, elements: list):\n        self.elements = elements\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the wrapped list.\"\"\"\n        return len(self.elements)\n\n    def get(self, index: int):\n        \"\"\"Returns the element at the specified index.\"\"\"\n        return self.elements[index]\nclass IndexSelector:\n    \"\"\"Computes zero-based indices divisible by three.\"\"\"\n    def get_divisible_by_three_indices(self, input_list: ListInput) -> list[int]:\n        \"\"\"Returns a list of indices where the index is divisible by three.\"\"\"\n        indices = []\n        for i in range(input_list.length()):\n            if i % 3 == 0:\n                indices.append(i)\n        return indices\nclass ValueExtractor:\n    \"\"\"Extracts values from a ListInput at specified indices.\"\"\"\n    def extract(self, input_list: ListInput, indices: list[int]) -> list:\n        \"\"\"Extracts and returns values from the input list at the given indices.\"\"\"\n        return [input_list.get(i) for i in indices]\nclass Sorter:\n    \"\"\"Sorts a list of values in ascending order.\"\"\"\n    def sort_ascending(self, values: list) -> list:\n        \"\"\"Returns a new list with the input values sorted in ascending order.\"\"\"\n        return sorted(values)\nclass ResultBuilder:\n    \"\"\"Builds the output list by combining original non-divisible elements with sorted divisible ones.\"\"\"\n    def build(self, input_list: ListInput, indices: list[int], sorted_values: list) -> list:\n        \"\"\"Constructs the final list by replacing values at specified indices with sorted values.\"\"\"\n        # Create a new list as a shallow copy of the input_list's elements.\n        result_list = list(input_list.elements)\n        \n        # Replace elements at the identified indices with the corresponding sorted values.\n        for i in range(len(indices)):\n            original_idx = indices[i]\n            result_list[original_idx] = sorted_values[i]\n            \n        return result_list\ndef sort_third(l: list):\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the indicies that are not divisible by three, while its values at the indicies that are divisible by three are equal\n    to the values of the corresponding indicies of l, but sorted.\n    >>> sort_third([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_third([5, 6, 3, 4, 8, 9, 2])\n    [2, 6, 3, 4, 8, 9, 5]\n    \"\"\"\n    li = ListInput(l)\n    indices = IndexSelector().get_divisible_by_three_indices(li)\n    values = ValueExtractor().extract(li, indices)\n    sorted_values = Sorter().sort_ascending(values)\n    result = ResultBuilder().build(li, indices, sorted_values)\n    return result"}
{"task_id": "HumanEval/35", "solution": "def max_element(l: list):\n    \"\"\"Return maximum element in the list.\n    >>> max_element([1, 2, 3])\n    3\n    >>> max_element([5, 3, -5, 2, -3, 3, 9, 0, 123, 1, -10])\n    123\n    \"\"\"\n    return max(l)"}
{"task_id": "HumanEval/32", "solution": "import math\ndef poly(xs: list, x: float):\n    \"\"\"\n    Evaluates polynomial with coefficients xs at point x.\n    return xs[0] + xs[1] * x + xs[1] * x^2 + .... xs[n] * x^n\n    \"\"\"\n    return sum([coeff * math.pow(x, i) for i, coeff in enumerate(xs)])\ndef find_zero(xs: list):\n    \"\"\" xs are coefficients of a polynomial.\n    find_zero find x such that poly(x) = 0.\n    find_zero returns only only zero point, even if there are many.\n    Moreover, find_zero only takes list xs having even number of coefficients\n    and largest non zero coefficient as it guarantees\n    a solution.\n    >>> round(find_zero([1, 2]), 2) # f(x) = 1 + 2x\n    -0.5\n    >>> round(find_zero([-6, 11, -6, 1]), 2) # (x - 1) * (x - 2) * (x - 3) = -6 + 11x - 6x^2 + x^3\n    1.0\n    \"\"\"\n    if not xs:\n        raise ValueError(\"Coefficient list cannot be empty.\")\n    if len(xs) % 2 != 0:\n        raise ValueError(\"The number of coefficients must be even (odd degree polynomial).\")\n    if xs[-1] == 0:\n        raise ValueError(\"The leading coefficient cannot be zero.\")\n\n    search_range_start = -100.0\n    search_range_end = 100.0\n    step_size = 0.01\n    tolerance = 1e-7\n    bisection_max_iter = 100\n\n    # Iterate to find the first interval with a sign change (approximating smallest root)\n    x_prev = search_range_start\n    f_prev = poly(xs, x_prev)\n\n    if abs(f_prev) < tolerance:\n        return x_prev\n\n    current_x = search_range_start + step_size\n    while current_x <= search_range_end:\n        f_current = poly(xs, current_x)\n\n        if abs(f_current) < tolerance:\n            return current_x\n\n        if f_prev * f_current < 0:\n            # A root is found in [x_prev, current_x], refine it with bisection\n            low = x_prev\n            high = current_x\n            for _ in range(bisection_max_iter):\n                mid = (low + high) / 2\n                f_mid = poly(xs, mid)\n                if abs(f_mid) < tolerance:\n                    return mid\n                if poly(xs, low) * f_mid < 0:\n                    high = mid\n                else:\n                    low = mid\n            return (low + high) / 2 # Return midpoint of final interval\n\n        x_prev = current_x\n        f_prev = f_current\n        current_x += step_size\n\n    # Fallback: If no root found by scanning (should not happen given problem constraints for odd-degree poly)\n    # Perform bisection over the entire range to guarantee finding *a* root.\n    low_fallback = search_range_start\n    high_fallback = search_range_end\n\n    if abs(poly(xs, low_fallback)) < tolerance:\n        return low_fallback\n    if abs(poly(xs, high_fallback)) < tolerance:\n        return high_fallback\n\n    for _ in range(bisection_max_iter):\n        mid = (low_fallback + high_fallback) / 2\n        f_mid = poly(xs, mid)\n        if abs(f_mid) < tolerance:\n            return mid\n        if poly(xs, low_fallback) * f_mid < 0:\n            high_fallback = mid\n        else:\n            low_fallback = mid\n    \n    return (low_fallback + high_fallback) / 2"}
{"task_id": "HumanEval/36", "solution": "from typing import List\nfrom dataclasses import dataclass\nclass IntegerRange:\n    \"\"\"Encapsulate enumeration of integers from 0 up to (but not including) end/exclusive.\"\"\"\n    def __init__(self, end: int, start: int = 0) -> None:\n        self.start = start\n        self.end = end\n\n    def enumerate(self) -> List[int]:\n        \"\"\"Return a list of integers from start to end-1.\"\"\"\n        if self.end <= self.start:\n            return []\n        return list(range(self.start, self.end))\nclass DivisibilityChecker:\n    \"\"\"Encapsulate the selection predicate for divisibility by 11 or 13.\"\"\"\n    def is_divisible(self, m: int) -> bool:\n        \"\"\"Return True if m is divisible by 11 or 13, else False.\"\"\"\n        return (m % 11 == 0) or (m % 13 == 0)\nclass DigitCounter:\n    \"\"\"Encapsulate counting occurrences of a decimal digit in an integer's base-10 representation.\"\"\"\n    def count_digit(self, m: int, digit: str) -> int:\n        \"\"\"Count occurrences of the specified digit in the base-10 representation of m.\"\"\"\n        return str(abs(m)).count(digit)\ndef fizz_buzz(n: int):\n    \"\"\"Return the number of times the digit 7 appears in integers less than n which are divisible by 11 or 13.\"\"\"\n    result = Result()\n    integer_range = IntegerRange(end=n)\n    divisibility_checker = DivisibilityChecker()\n    digit_counter = DigitCounter()\n\n    for m in integer_range.enumerate():\n        if divisibility_checker.is_divisible(m):\n            result.total_count += digit_counter.count_digit(m, '7')\n\n    return result.total_count"}
{"task_id": "HumanEval/37", "solution": "from typing import List, Any, Optional, Dict\nclass Element:\n    \"\"\"Represents a value at a specific index with parity helper.\"\"\"\n    def __init__(self, index: int, value: Any) -> None:\n        self.index = index\n        self.value = value\n\n    def isEven(self) -> bool:\n        \"\"\"Checks if the element's index is even.\"\"\"\n        return self.index % 2 == 0\nclass InputList:\n    \"\"\"Encapsulates an input list and provides accessors.\"\"\"\n    def __init__(self, elements: list) -> None:\n        self.elements = elements\n        self.length = len(elements)\n\n    def get(self, index: int) -> Any:\n        return self.elements[index]\n\n    def __len__(self) -> int:\n        return self.length\nclass OutputList:\n    \"\"\"Encapsulates an output list for construction and return.\"\"\"\n    def __init__(self, length: int) -> None:\n        self.elements = [None] * length\n        self.length = length\n\n    def set(self, index: int, value: Any) -> None:\n        self.elements[index] = value\n\n    def get(self, index: int) -> Any:\n        return self.elements[index]\n\n    def to_list(self) -> list:\n        \"\"\"Converts the internal elements to a native Python list.\"\"\"\n        return list(self.elements)\n\n    def __len__(self) -> int:\n        return self.length\nclass EvenIndexCollection:\n    \"\"\"Collects Elements from even indices and provides sorting.\"\"\"\n    def __init__(self, elements: Optional[List[Element]] = None) -> None:\n        self.elements = elements if elements is not None else []\n\n    def add(self, element: Element) -> None:\n        self.elements.append(element)\n\n    def sortAscending(self) -> None:\n        \"\"\"Sorts contained elements by their value in ascending order.\"\"\"\n        self.elements.sort(key=lambda e: e.value)\n\n    def values(self) -> List[Any]:\n        return [e.value for e in self.elements]\nclass OddIndexCollection:\n    \"\"\"Collects Elements from odd indices and provides read access.\"\"\"\n    def __init__(self, elements: Optional[List[Element]] = None) -> None:\n        self.elements = elements if elements is not None else []\n\n    def add(self, element: Element) -> None:\n        self.elements.append(element)\n\n    def values_by_index(self) -> Dict[int, Any]:\n        \"\"\"Returns a dictionary mapping odd indices to their values.\"\"\"\n        return {e.index: e.value for e in self.elements}\nclass SortOperation:\n    \"\"\"Handles extraction, sorting of even elements, and merging into an OutputList.\"\"\"\n    def extractEvenIndices(self, input_list: InputList) -> EvenIndexCollection:\n        \"\"\"Builds an EvenIndexCollection from the input_list's even indices.\"\"\"\n        evens = EvenIndexCollection()\n        for i in range(input_list.length):\n            element = Element(i, input_list.get(i))\n            if element.isEven():\n                evens.add(element)\n        return evens\n\n    def extractOddIndices(self, input_list: InputList) -> OddIndexCollection:\n        \"\"\"Builds an OddIndexCollection from the input_list's odd indices.\"\"\"\n        odds = OddIndexCollection()\n        for i in range(input_list.length):\n            element = Element(i, input_list.get(i))\n            if not element.isEven():\n                odds.add(element)\n        return odds\n\n    def sortEvenIndices(self, evens: EvenIndexCollection) -> EvenIndexCollection:\n        \"\"\"Sorts the elements within the given EvenIndexCollection.\"\"\"\n        evens.sortAscending()\n        return evens\n\n    def merge(self, evens: EvenIndexCollection, odds: OddIndexCollection, length: int) -> OutputList:\n        \"\"\"Merges sorted even-indexed values and original odd-indexed values into a new OutputList.\"\"\"\n        output_list = OutputList(length)\n\n        # Place odd elements first\n        for index, value in odds.values_by_index().items():\n            output_list.set(index, value)\n\n        # Place sorted even elements in their respective even indices\n        sorted_even_values = evens.values()\n        even_value_idx = 0\n        for i in range(length):\n            if i % 2 == 0:  # If current index is even\n                if even_value_idx < len(sorted_even_values):\n                    output_list.set(i, sorted_even_values[even_value_idx])\n                    even_value_idx += 1\n        return output_list\ndef sort_even(l: list):\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the odd indicies, while its values at the even indicies are equal\n    to the values of the even indicies of l, but sorted.\n    >>> sort_even([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_even([5, 6, 3, 4])\n    [3, 6, 5, 4]\n    \"\"\"\n    input_list = InputList(l)\n    sort_op = SortOperation()\n\n    even_elements = sort_op.extractEvenIndices(input_list)\n    odd_elements = sort_op.extractOddIndices(input_list)\n\n    sorted_even_elements = sort_op.sortEvenIndices(even_elements)\n\n    output_list = sort_op.merge(sorted_even_elements, odd_elements, len(input_list))\n\n    return output_list.to_list()"}
{"task_id": "HumanEval/38", "solution": "def decode_cyclic(s: str):\n    \"\"\"\n    takes as input string encoded with encode_cyclic function. Returns decoded string.\n    \"\"\"\n    # split string to groups. Each of length 3.\n    groups = [s[(3 * i):min((3 * i + 3), len(s))] for i in range((len(s) + 2) // 3)]\n    # cycle elements in each group back (right rotation). Unless group has fewer elements than 3.\n    groups = [(group[-1] + group[:-1]) if len(group) == 3 else group for group in groups]\n    return \"\".join(groups)"}
{"task_id": "HumanEval/40", "solution": "def triples_sum_to_zero(l: list):\n    \"\"\"\n    triples_sum_to_zero takes a list of integers as an input.\n    it returns True if there are three distinct elements in the list that\n    sum to zero, and False otherwise.\n\n    >>> triples_sum_to_zero([1, 3, 5, 0])\n    False\n    >>> triples_sum_to_zero([1, 3, -2, 1])\n    True\n    >>> triples_sum_to_zero([1, 2, 3, 7])\n    False\n    >>> triples_sum_to_zero([2, 4, -5, 3, 9, 7])\n    True\n    >>> triples_sum_to_zero([1])\n    False\n    \"\"\"\n    n = len(l)\n    if n < 3:\n        return False\n\n    # Iterate through all unique combinations of three distinct indices i, j, k.\n    for i in range(n):\n        for j in range(i + 1, n): # Ensure j is distinct from i.\n            for k in range(j + 1, n): # Ensure k is distinct from i and j.\n                if l[i] + l[j] + l[k] == 0:\n                    return True\n    return False"}
