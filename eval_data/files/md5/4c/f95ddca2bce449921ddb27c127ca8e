{"task_id": "HumanEval/4", "solution": "from typing import List\nfrom dataclasses import dataclass\nclass MeanCalculator:\n    def compute_mean(self, numbers: List[float]) -> float:\n        return sum(numbers) / len(numbers)\nclass AbsoluteDeviationCalculator:\n    def compute_deviations(self, numbers: List[float], mean: float) -> List[float]:\n        return [abs(x - mean) for x in numbers]\nclass Aggregator:\n    def average(self, values: List[float]) -> float:\n        return sum(values) / len(values)\ndef mean_absolute_deviation(numbers: List[float]) -> float:\n    \"\"\" For a given list of input numbers, calculate Mean Absolute Deviation\n    around the mean of this dataset.\n    Mean Absolute Deviation is the average absolute difference between each\n    element and a centerpoint (mean in this case):\n    MAD = average | x - x_mean |\n    >>> mean_absolute_deviation([1.0, 2.0, 3.0, 4.0])\n    1.0\n    \"\"\"\n    ds = Dataset(numbers)\n    mean = MeanCalculator().compute_mean(ds.numbers)\n    deviations = AbsoluteDeviationCalculator().compute_deviations(ds.numbers, mean)\n    mad = Aggregator().average(deviations)\n    return float(mad)"}
{"task_id": "HumanEval/0", "solution": "from typing import List\ndef has_close_elements(numbers: List[float], threshold: float) -> bool:\n    \"\"\" Check if in given list of numbers, are any two numbers closer to each other than\n    given threshold.\n    >>> has_close_elements([1.0, 2.0, 3.0], 0.5)\n    False\n    >>> has_close_elements([1.0, 2.8, 3.0, 4.0, 5.0, 2.0], 0.3)\n    True\n    \"\"\"\n    n = len(numbers)\n    if n < 2:\n        return False\n\n    for i in range(n):\n        for j in range(i + 1, n):\n            if abs(numbers[i] - numbers[j]) < threshold:\n                return True\n    return False"}
{"task_id": "HumanEval/2", "solution": "from math import floor\ndef truncate_number(number: float) -> float:\n    \"\"\" Given a positive floating point number, it can be decomposed into\n    and integer part (largest integer smaller than given number) and decimals\n    (leftover part always smaller than 1).\n\n    Return the decimal part of the number.\n    >>> truncate_number(3.5)\n    0.5\n    \"\"\"\n    integer_part = floor(number)\n    return number - integer_part"}
{"task_id": "HumanEval/7", "solution": "from typing import List\ndef filter_by_substring(strings: List[str], substring: str) -> List[str]:\n    \"\"\" Filter an input list of strings only for ones that contain given substring\n    >>> filter_by_substring([], 'a')\n    []\n    >>> filter_by_substring(['abc', 'bacd', 'cde', 'array'], 'a')\n    ['abc', 'bacd', 'array']\n    \"\"\"\n    result: List[str] = []\n    for item in strings:\n        if substring in item:\n            result.append(item)\n    return result"}
{"task_id": "HumanEval/5", "solution": "from typing import List\ndef intersperse(numbers: List[int], delimeter: int) -> List[int]:\n    \"\"\" Insert a number 'delimeter' between every two consecutive elements of input list `numbers'\n    >>> intersperse([], 4)\n    []\n    >>> intersperse([1, 2, 3], 4)\n    [1, 4, 2, 4, 3]\n    \"\"\"\n    if not numbers:\n        return []\n\n    if len(numbers) == 1:\n        return numbers\n\n    result = []\n    for i, num in enumerate(numbers):\n        result.append(num)\n        if i < len(numbers) - 1:\n            result.append(delimeter)\n            \n    return result"}
{"task_id": "HumanEval/3", "solution": "from typing import List\ndef below_zero(operations: List[int]) -> bool:\n    \"\"\" You're given a list of deposit and withdrawal operations on a bank account that starts with\n    zero balance. Your task is to detect if at any point the balance of account fallls below zero, and\n    at that point function should return True. Otherwise it should return False.\n    >>> below_zero([1, 2, 3])\n    False\n    >>> below_zero([1, 2, -4, 5])\n    True\n    \"\"\"\n    running_balance = 0\n    for element in operations:\n        if not isinstance(element, int):\n            raise TypeError(\"All operations must be integers.\")\n        running_balance += element\n        if running_balance < 0:\n            return True\n    return False"}
{"task_id": "HumanEval/1", "solution": "from typing import List\nfrom dataclasses import dataclass\nclass ValidationError(Exception):\n    \"\"\"Exception type to signal invalid/unbalanced input with an informative message.\"\"\"\n    def __init__(self, message: str) -> None:\n        self.message = message\n        super().__init__(self.message)\nclass Parser:\n    \"\"\"\n    Performs whitespace stripping, tokenization into top-level tokens,\n    validation of balance, and construction of ParenthesisGroup records.\n    \"\"\"\n    def is_balanced(self, s: str) -> bool:\n        \"\"\"Checks if a string containing only parentheses is balanced.\"\"\"\n        balance = 0\n        for char in s:\n            if char == '(':\n                balance += 1\n            elif char == ')':\n                balance -= 1\n            if balance < 0:\n                return False\n        return balance == 0\n\n    def validate(self, s: str) -> None:\n        \"\"\"Validates if the given string (stripped) contains only parentheses and is balanced.\"\"\"\n        for char in s:\n            if char not in '()':\n                raise ValidationError(f\"Invalid character '{char}' found in parentheses string after stripping spaces.\")\n        if not self.is_balanced(s):\n            raise ValidationError(\"Input string contains unbalanced parentheses.\")\n\n    def tokenize(self, s: str) -> List[str]:\n        \"\"\"\n        Tokenizes the given string (assumed to be stripped and validated)\n        into a list of top-level balanced parenthesis groups.\n        \"\"\"\n        groups: List[str] = []\n        balance_count = 0\n        current_group_start_index = 0\n\n        for i, char in enumerate(s):\n            if char == '(':\n                balance_count += 1\n            elif char == ')':\n                balance_count -= 1\n\n            # If the overall string `s` passed `validate`, balance_count should not drop below 0.\n            # This check is defensive programming.\n            if balance_count < 0:\n                raise ValidationError(\"Internal error: Unbalanced parentheses during tokenization (too many closing parentheses).\")\n\n            if balance_count == 0 and i >= current_group_start_index:\n                # Found a top-level balanced group\n                group_content = s[current_group_start_index : i + 1]\n                \n                # Calculate max depth for ParenthesisGroup object as per design model\n                current_depth_in_group = 0\n                max_depth = 0\n                for char_in_group in group_content:\n                    if char_in_group == '(':\n                        current_depth_in_group += 1\n                        max_depth = max(max_depth, current_depth_in_group)\n                    elif char_in_group == ')':\n                        current_depth_in_group -= 1\n                \n                # Create ParenthesisGroup as per design, even if only content is returned in the end.\n                ParenthesisGroup(content=group_content, depth=max_depth, index=current_group_start_index)\n                \n                groups.append(group_content)\n                current_group_start_index = i + 1\n\n        # If the overall string `s` passed `validate`, balance_count should be 0 here.\n        # This check is defensive programming.\n        if balance_count != 0:\n            raise ValidationError(\"Internal error: Unbalanced parentheses during tokenization (unmatched opening parentheses).\")\n\n        return groups\n\n    def separate_paren_groups(self, paren_string: str) -> List[str]:\n        \"\"\"\n        Strips whitespace, validates, and extracts top-level balanced\n        parenthesis groups from the input string.\n        \"\"\"\n        # Create ParenString object as per design, though its direct utility is limited for this function.\n        _ = ParenString(value=paren_string) \n\n        stripped_s = paren_string.replace(\" \", \"\")\n\n        if not stripped_s:\n            return []\n\n        # Validate the entire stripped string before attempting to tokenize.\n        self.validate(stripped_s)\n        \n        # Tokenize the validated string into top-level balanced groups.\n        return self.tokenize(stripped_s)\ndef separate_paren_groups(paren_string: str) -> List[str]:\n    \"\"\"\n    Input to this function is a string containing multiple groups of nested parentheses. Your goal is to\n    separate those group into separate strings and return the list of those.\n    Separate groups are balanced (each open brace is properly closed) and not nested within each other\n    Ignore any spaces in the input string.\n    >>> separate_paren_groups('( ) (( )) (( )( ))')\n    ['()', '(())', '(()())']\n    \"\"\"\n    parser = Parser()\n    return parser.separate_paren_groups(paren_string)"}
{"task_id": "HumanEval/6", "solution": "from typing import List\nclass InvalidCharacterError(Exception):\n    \"\"\"Raised when a group contains characters other than '(' or ')'. \"\"\"\n    pass\nclass UnbalancedParenthesesError(Exception):\n    \"\"\"Raised when a group's parentheses are not balanced.\"\"\"\n    pass\nclass ErrorHandler:\n    \"\"\"Handles raising deterministic, typed errors.\"\"\"\n    @staticmethod\n    def raiseInvalidCharacters(group_index: int) -> None:\n        \"\"\"Raises InvalidCharacterError for a given group index.\"\"\"\n        raise InvalidCharacterError(f\"Group at index {group_index} contains invalid characters.\")\n\n    @staticmethod\n    def raiseUnbalancedParentheses(group_index: int) -> None:\n        \"\"\"Raises UnbalancedParenthesesError for a given group index.\"\"\"\n        raise UnbalancedParenthesesError(f\"Group at index {group_index} has unbalanced parentheses.\")\nclass Output:\n    \"\"\"Aggregates computed depths in original group order.\"\"\"\n    def __init__(self):\n        self.depths: List[int] = []\n\n    def append(self, depth: int) -> None:\n        \"\"\"Appends a depth value to the list.\"\"\"\n        self.depths.append(depth)\n\n    def get(self) -> List[int]:\n        \"\"\"Returns the aggregated list of depths.\"\"\"\n        return self.depths\nclass DepthCalculator:\n    \"\"\"Computes the maximum nesting depth for a valid, balanced group.\"\"\"\n    def __init__(self):\n        pass\n\n    def compute(self, group: 'Group') -> int:\n        \"\"\"Computes maximum nesting depth, '()' -> 1.\"\"\"\n        max_depth = 0\n        current_depth = 0\n        for char in group.text:\n            if char == '(':\n                current_depth += 1\n                max_depth = max(max_depth, current_depth)\n            elif char == ')':\n                current_depth -= 1\n        return max_depth\nclass Group:\n    \"\"\"Represents a single group of parentheses for validation and depth computation.\"\"\"\n    def __init__(self, text: str, index: int):\n        self.text = text\n        self.index = index\n        self._depth_calculator = DepthCalculator()\n\n    def validate(self) -> None:\n        \"\"\"Checks for valid characters and raises InvalidCharacterError if found.\"\"\"\n        for char in self.text:\n            if char not in '()':\n                ErrorHandler.raiseInvalidCharacters(self.index)\n\n    def is_balanced(self) -> None:\n        \"\"\"Checks for balanced parentheses and raises UnbalancedParenthesesError if not.\"\"\"\n        balance = 0\n        for char in self.text:\n            if char == '(':\n                balance += 1\n            elif char == ')':\n                balance -= 1\n            if balance < 0:\n                ErrorHandler.raiseUnbalancedParentheses(self.index)\n        if balance != 0:\n            ErrorHandler.raiseUnbalancedParentheses(self.index)\n\n    def compute_depth(self) -> int:\n        \"\"\"If empty text returns 0; otherwise delegates to DepthCalculator.\"\"\"\n        if not self.text:\n            return 0\n        return self._depth_calculator.compute(self)\nclass InputString:\n    \"\"\"Holds raw input and produces trimmed/split groups.\"\"\"\n    def __init__(self, raw: str):\n        self.raw = raw\n\n    def parse(self) -> List[str]:\n        \"\"\"Trims and splits raw input into groups, preserving empty strings from multiple spaces.\"\"\"\n        return self.raw.strip().split(' ')\nclass Parser:\n    \"\"\"Orchestrates splitting, per-group validation, depth computation, and aggregation.\"\"\"\n    def __init__(self):\n        self._output = Output()\n\n    def parse_input(self, raw: str) -> List[int]:\n        \"\"\"Parses the input string, validates groups, computes depths, and returns results.\"\"\"\n        input_string_obj = InputString(raw)\n        group_texts = input_string_obj.parse()\n\n        for i, group_text in enumerate(group_texts):\n            group = Group(group_text, i)\n            group.validate()\n            group.is_balanced()\n            depth = group.compute_depth()\n            self._output.append(depth)\n\n        return self._output.get()\ndef parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\" Input to this function is a string represented multiple groups for nested parentheses separated by spaces.\n    For each of the group, output the deepest level of nesting of parentheses.\n    E.g. (()()) has maximum two levels of nesting while ((())) has three.\n\n    >>> parse_nested_parens('(()()) ((())) () ((())()())')\n    [2, 3, 1, 3]\n    \"\"\"\n    if not paren_string.strip():\n        return []\n\n    parser = Parser()\n    return parser.parse_input(paren_string)"}
{"task_id": "HumanEval/12", "solution": "from typing import List, Optional\ndef longest(strings: List[str]) -> Optional[str]:\n    \"\"\" Out of list of strings, return the longest one. Return the first one in case of multiple\n    strings of the same length. Return None in case the input list is empty.\n    >>> longest([])\n\n    >>> longest(['a', 'b', 'c'])\n    'a'\n    >>> longest(['a', 'bb', 'ccc'])\n    'ccc'\n    \"\"\"\n    if not strings:\n        return None\n\n    best_index = 0\n    best_len = len(strings[0])\n\n    for i in range(1, len(strings)):\n        current_len = len(strings[i])\n        if current_len > best_len:\n            best_len = current_len\n            best_index = i\n        # If current_len == best_len, we do nothing to preserve the first occurrence.\n\n    return strings[best_index]"}
{"task_id": "HumanEval/9", "solution": "from typing import List, Tuple\ndef validate_input(numbers) -> bool:\n    \"\"\"Validate that numbers is a list and each element is an int.\n    Returns True if valid. Raises TypeError when validation fails.\n    \"\"\"\n    if not isinstance(numbers, list):\n        raise TypeError(\"Input 'numbers' must be a list.\")\n    for i, num in enumerate(numbers):\n        if not isinstance(num, int):\n            raise TypeError(f\"List element at index {i} is not an integer: {num}\")\n    return True\ndef compute(numbers: List[int]) -> List[int]:\n    \"\"\"Compute and return a list of rolling maxima for numbers.\"\"\"\n    if not numbers:\n        return []\n\n    rolling_maxima = []\n    current_max = -float('inf')\n\n    for number in numbers:\n        current_max = max(current_max, number)\n        rolling_maxima.append(current_max)\n\n    return rolling_maxima\ndef rolling_max(numbers: List[int]) -> List[int]:\n    \"\"\" From a given list of integers, generate a list of rolling maximum element found until given moment\n    in the sequence.\n    >>> rolling_max([1, 2, 3, 2, 3, 4, 2])\n    [1, 2, 3, 3, 3, 4, 4]\n    \"\"\"\n    validate_input(numbers)\n    return compute(numbers)"}
{"task_id": "HumanEval/8", "solution": "def sum_product(numbers: List[int]) -> Tuple[int, int]:\n    \"\"\" For a given list of integers, return a tuple consisting of a sum and a product of all the integers in a list.\n    Empty sum should be equal to 0 and empty product should be equal to 1.\n    >>> sum_product([])\n    (0, 1)\n    >>> sum_product([1, 2, 3, 4])\n    (10, 24)\n    \"\"\"\n    total_sum = 0\n    total_product = 1\n    for num in numbers:\n        total_sum += num\n        total_product *= num\n    return total_sum, total_product"}
{"task_id": "HumanEval/14", "solution": "from typing import List\ndef all_prefixes(string: str) -> List[str]:\n    \"\"\" Return list of all prefixes from shortest to longest of the input string\n    >>> all_prefixes('abc')\n    ['a', 'ab', 'abc']\n    \"\"\"\n    prefixes = []\n    # Iterate from 1 up to the length of the string to capture all prefixes.\n    for i in range(1, len(string) + 1):\n        prefixes.append(string[:i])\n    return prefixes"}
{"task_id": "HumanEval/13", "solution": "def greatest_common_divisor(a: int, b: int) -> int:\n    \"\"\" Return a greatest common divisor of two integers a and b\n    >>> greatest_common_divisor(3, 5)\n    1\n    >>> greatest_common_divisor(25, 15)\n    5\n    \"\"\"\n    while b:\n        a, b = b, a % b\n    return abs(a)"}
{"task_id": "HumanEval/15", "solution": "def build_sequence(n: int) -> list[int]:\n    \"\"\"Builds a sequence of integers from 0 to n inclusive.\"\"\"\n    return list(range(n + 1))\ndef format_sequence(seq: list[int]) -> str:\n    \"\"\"Formats a list of integers into a space-delimited string.\"\"\"\n    return ' '.join(str(x) for x in seq)\ndef string_sequence(n: int) -> str:\n    \"\"\" Return a string containing space-delimited numbers starting from 0 upto n inclusive.\n    >>> string_sequence(0)\n    '0'\n    >>> string_sequence(5)\n    '0 1 2 3 4 5'\n    \"\"\"\n    # Validation for n being an integer and non-negative is omitted\n    # as per explicit instruction \"Do NOT add isinstance() checks or raise exceptions for edge cases\".\n    # If n is negative, build_sequence will produce an empty list, resulting in an empty string.\n    # If n is not an integer, range(n + 1) will raise a TypeError (a built-in exception).\n    \n    seq = build_sequence(n)\n    return format_sequence(seq)"}
{"task_id": "HumanEval/11", "solution": "from typing import List\nclass BinaryString:\n    \"\"\"Represents a binary string value and provides helpers.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the binary string.\"\"\"\n        return len(self.value)\n\n    def is_valid_chars(self) -> bool:\n        \"\"\"Checks if the string contains only '0' and '1' characters.\"\"\"\n        return all(char in ('0', '1') for char in self.value)\nclass Validator:\n    \"\"\"Encapsulates validation logic for binary characters and equal-length business rules.\"\"\"\n    def validate_chars(self, value: str) -> bool:\n        \"\"\"Validates if the input string contains only '0' and '1' characters.\"\"\"\n        binary_str = BinaryString(value)\n        return binary_str.is_valid_chars()\n\n    def validate_length(self, a: str, b: str) -> bool:\n        \"\"\"Validates if the two input strings have equal length.\"\"\"\n        return len(a) == len(b)\nclass XOROperation:\n    \"\"\"Performs the bitwise XOR operation on two validated binary strings.\"\"\"\n    def perform(self, a: str, b: str) -> str:\n        \"\"\"Performs character-wise XOR on two binary strings.\"\"\"\n        result_chars = []\n        for char_a, char_b in zip(a, b):\n            if char_a == char_b:\n                result_chars.append('0')\n            else:\n                result_chars.append('1')\n        return \"\".join(result_chars)\ndef string_xor(a: str, b: str) -> str:\n    \"\"\" Input are two strings a and b consisting only of 1s and 0s.\n    Perform binary XOR on these inputs and return result also as a string.\n    >>> string_xor('010', '110')\n    '100'\n    \"\"\"\n    validator = Validator()\n    if not validator.validate_chars(a) or not validator.validate_chars(b):\n        raise ValueError(\"Input contains non-binary characters.\")\n\n    if not validator.validate_length(a, b):\n        raise ValueError(\"Input strings have differing lengths.\")\n\n    xor_operation = XOROperation()\n    result = xor_operation.perform(a, b)\n    return result"}
{"task_id": "HumanEval/10", "solution": "def make_palindrome(string: str) -> str:\n    \"\"\" Find the shortest palindrome that begins with a supplied string.\n    Algorithm idea is simple:\n    - Find the longest postfix of supplied string that is a palindrome.\n    - Append to the end of the string reverse of a string prefix that comes before the palindromic suffix.\n    >>> make_palindrome('')\n    ''\n    >>> make_palindrome('cat')\n    'catac'\n    >>> make_palindrome('cata')\n    'catac'\n    \"\"\"\n    for i in range(len(string) + 1):\n        # Current suffix candidate is string[i:]\n        # The part of the string before this suffix is string[:i]\n        if is_palindrome(string[i:]):\n            # Found the longest palindromic suffix starting at index i\n            # Append the reverse of the prefix before this suffix to the original string\n            prefix_to_reverse = string[:i]\n            reversed_prefix = prefix_to_reverse[::-1]\n            return string + reversed_prefix"}
{"task_id": "HumanEval/17", "solution": "def parse_music(music_string: str) -> List[int]:\n    \"\"\" Input to this function is a string representing musical notes in a special ASCII format.\n    Your task is to parse this string and return list of integers corresponding to how many beats does each\n    not last.\n    \"\"\"\n    note_mappings = {\n        'o': 4,    # whole note\n        'o|': 2,   # half note\n        '.|': 1    # quarter note\n    }\n\n    tokens = music_string.split()\n    result_beats = []\n\n    for token in tokens:\n        # The design specifies that lookup may raise KeyError for unknown tokens,\n        # and no extra error handling is mandated.\n        result_beats.append(note_mappings[token])\n\n    return result_beats"}
{"task_id": "HumanEval/16", "solution": "def count_distinct_characters(string: str) -> int:\n    \"\"\" Given a string, find out how many distinct characters (regardless of case) does it consist of\n    >>> count_distinct_characters('xyzXYZ')\n    3\n    >>> count_distinct_characters('Jerry')\n    4\n    \"\"\"\n    normalized_string = string.casefold()\n    distinct_chars = set()\n    for char in normalized_string:\n        distinct_chars.add(char)\n    return len(distinct_chars)"}
{"task_id": "HumanEval/18", "solution": "def how_many_times(string: str, substring: str) -> int:\n    \"\"\" Find how many times a given substring can be found in the original string. Count overlaping cases.\n    >>> how_many_times('', 'a')\n    0\n    >>> how_many_times('aaa', 'a')\n    3\n    >>> how_many_times('aaaa', 'aa')\n    3\n    \"\"\"\n    count = 0\n    len_string = len(string)\n    len_substring = len(substring)\n\n    # If the substring is empty, the behavior is not defined by the SRS/design.\n    # The current sliding window approach will count len(string) + 1 occurrences.\n    # The loop should run as long as there's enough space for the substring.\n    # The last possible start index is len_string - len_substring.\n    for i in range(len_string - len_substring + 1):\n        if string[i : i + len_substring] == substring:\n            count += 1\n    return count"}
