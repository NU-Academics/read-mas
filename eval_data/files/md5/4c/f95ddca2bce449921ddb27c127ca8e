{"task_id": "HumanEval/44", "solution": "def _convert_positive(x: int, base: int) -> str:\n    \"\"\"Convert a positive integer x to its string representation in the given base.\"\"\"\n    digits = []\n    while x > 0:\n        remainder = x % base\n        digits.append(str(remainder))\n        x //= base\n    return \"\".join(digits[::-1])\ndef change_base(x: int, base: int):\n    \"\"\"Change numerical base of input number x to base.\n    return string representation after the conversion.\n    base numbers are less than 10.\n    >>> change_base(8, 3)\n    '22'\n    >>> change_base(8, 2)\n    '1000'\n    >>> change_base(7, 2)\n    '111'\n    \"\"\"\n    _validate_base(base)\n\n    is_negative = False\n    if x < 0:\n        is_negative = True\n        x = abs(x)\n\n    if x == 0:\n        return '0'\n    \n    converted_digits = _convert_positive(x, base)\n\n    if is_negative:\n        return '-' + converted_digits\n    else:\n        return converted_digits"}
{"task_id": "HumanEval/46", "solution": "class InvalidInputError(Exception):\n    \"\"\"Exception raised for invalid input to the fib4 function.\"\"\"\n    pass\nclass Fib4Calculator:\n    \"\"\"Calculates Fib4 numbers efficiently.\"\"\"\n    \n    def compute(self, n: int) -> int:\n        \"\"\"Computes the n-th Fib4 number, handling base cases and delegating to iterative computation.\"\"\"\n        base = self.getBaseCase(n)\n        if base is not None:\n            return base\n        return self.computeIterative(n)\n\n    def getBaseCase(self, n: int) -> int | None:\n        \"\"\"Returns the Fib4 base case value for n, or None if not a base case.\"\"\"\n        if n == 0 or n == 1 or n == 3:\n            return 0\n        if n == 2:\n            return 2\n        return None\n\n    def computeIterative(self, n: int) -> int:\n        \"\"\"Computes the n-th Fib4 number iteratively for n >= 4 using a sliding window.\"\"\"\n        # Initialize the sliding window with fib4(0), fib4(1), fib4(2), fib4(3) respectively.\n        # The variables a, b, c, d will hold fib4(i-4), fib4(i-3), fib4(i-2), fib4(i-1) in each step.\n        a, b, c, d = 0, 0, 2, 0 \n\n        # Iterate from the 4th element up to n, updating the window.\n        for _ in range(4, n + 1):\n            nxt = a + b + c + d\n            a, b, c, d = b, c, d, nxt\n        return d\ndef fib4(n: int):\n    \"\"\"The Fib4 number sequence is a sequence similar to the Fibbonacci sequnece that's defined as follows:\n    fib4(0) -> 0\n    fib4(1) -> 0\n    fib4(2) -> 2\n    fib4(3) -> 0\n    fib4(n) -> fib4(n-1) + fib4(n-2) + fib4(n-3) + fib4(n-4).\n    Please write a function to efficiently compute the n-th element of the fib4 number sequence.  Do not use recursion.\n    >>> fib4(5)\n    4\n    >>> fib4(6)\n    8\n    >>> fib4(7)\n    14\n    \"\"\"\n    # Validate input: n must be a non-negative integer.\n    if not isinstance(n, int) or n < 0:\n        raise InvalidInputError(\"n must be a non-negative integer\")\n    \n    calc = Fib4Calculator()\n    return calc.compute(n)"}
{"task_id": "HumanEval/48", "solution": "def is_palindrome(text: str):\n    \"\"\"\n    Checks if given string is a palindrome\n    >>> is_palindrome('')\n    True\n    >>> is_palindrome('aba')\n    True\n    >>> is_palindrome('aaaaa')\n    True\n    >>> is_palindrome('zbcd')\n    False\n    \"\"\"\n    return text == text[::-1]"}
{"task_id": "HumanEval/47", "solution": "from typing import Union\ndef sortNonDecreasing(l: list) -> list:\n    return sorted(l)\ndef median(l: list) -> Union[int, float]:\n    \"\"\"Return median of elements in the list l.\n    >>> median([3, 1, 2, 4, 5])\n    3\n    >>> median([-10, 4, 6, 1000, 10, 20])\n    15.0\n    \"\"\"\n    validate(l)\n    sorted_list = sortNonDecreasing(l)\n    n = len(sorted_list)\n\n    if n % 2 == 1:\n        return sorted_list[n // 2]\n    else:\n        mid1 = sorted_list[n // 2 - 1]\n        mid2 = sorted_list[n // 2]\n        return (mid1 + mid2) / 2.0"}
