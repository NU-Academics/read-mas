{"task_id": "HumanEval/26", "solution": "from typing import List\n\n\ndef remove_duplicates(numbers: List[int]) -> List[int]:\n    \"\"\" From a list of integers, remove all elements that occur more than once.\n    Keep order of elements left the same as in the input.\n    \"\"\"\n    counts = {}\n    for num in numbers:\n        counts[num] = counts.get(num, 0) + 1\n\n    result = []\n    for num in numbers:\n        if counts[num] == 1:\n            result.append(num)\n            \n    return result"}
{"task_id": "HumanEval/24", "solution": "import math\n\ndef _validate_input(n: int) -> None:\n    \"\"\"Validates if the input n is a positive integer greater than 1.\n    Raises ValueError if validation fails.\"\"\"\n    if not isinstance(n, int):\n        raise ValueError(\"Input n must be an integer.\")\n    if n <= 1:\n        raise ValueError(\"Input n must be a positive integer greater than 1.\")\n\ndef _get_divisors(n: int) -> list[int]:\n    \"\"\"Determines all positive integers d that divide n evenly.\"\"\"\n    divs = set()\n    for i in range(1, int(math.sqrt(n)) + 1):\n        if n % i == 0:\n            divs.add(i)\n            if i * i != n:\n                divs.add(n // i)\n    return sorted(list(divs))\n\ndef _filter_proper_divisors(n: int, divisors: list[int]) -> list[int]:\n    \"\"\"Filters a list of divisors to retain only those strictly less than n.\"\"\"\n    return [d for d in divisors if d < n]\n\ndef largest_divisor(n: int) -> int:\n    \"\"\" For a given number n, find the largest number that divides n evenly, smaller than n\n    >>> largest_divisor(15)\n    5\n    \"\"\"\n    _validate_input(n)\n    all_divisors = _get_divisors(n)\n    proper_divisors = _filter_proper_divisors(n, all_divisors)\n\n    if not proper_divisors:\n        # For n > 1, 1 is always a proper divisor. This case should only be reached if n=1 (which is validated out).\n        # As a safeguard, if the list is empty, return 1 (relevant for prime numbers where the only proper divisor is 1).\n        return 1\n\n    return max(proper_divisors)"}
{"task_id": "HumanEval/27", "solution": "def flip_case(string: str) -> str:\n    \"\"\" For a given string, flip lowercase characters to uppercase and uppercase to lowercase.\n    >>> flip_case('Hello')\n    'hELLO'\n    \"\"\"\n    processed_chars = []\n    for char in string:\n        if char.islower():\n            processed_chars.append(char.upper())\n        elif char.isupper():\n            processed_chars.append(char.lower())\n        else:\n            processed_chars.append(char)\n    return \"\".join(processed_chars)"}
{"task_id": "HumanEval/29", "solution": "def filter_by_prefix(strings: List[str], prefix: str) -> List[str]:\n    \"\"\" Filter an input list of strings only for ones that start with a given prefix.\n    >>> filter_by_prefix([], 'a')\n    []\n    >>> filter_by_prefix(['abc', 'bcd', 'cde', 'array'], 'a')\n    ['abc', 'array']\n    \"\"\"\n    filtered_strings = []\n    for s in strings:\n        if s.startswith(prefix):\n            filtered_strings.append(s)\n    return filtered_strings"}
{"task_id": "HumanEval/25", "solution": "from typing import List\n\n\ndef factorize(n: int) -> List[int]:\n    \"\"\" Return list of prime factors of given integer in the order from smallest to largest.\n    Each of the factors should be listed number of times corresponding to how many times it appeares in factorization.\n    Input number should be equal to the product of all factors\n    >>> factorize(8)\n    [2, 2, 2]\n    >>> factorize(25)\n    [5, 5]\n    >>> factorize(70)\n    [2, 5, 7]\n    \"\"\"\n    if n < 1:\n        return []\n\n    factors = []\n    d = 2\n    temp_n = n\n\n    while d * d <= temp_n:\n        while temp_n % d == 0:\n            factors.append(d)\n            temp_n //= d\n        d += 1\n\n    if temp_n > 1:\n        factors.append(temp_n)\n\n    return factors"}
{"task_id": "HumanEval/30", "solution": "def get_positive(l: list):\n    \"\"\"Return only positive numbers in the list.\"\"\"\n    return [num for num in l if num > 0]"}
{"task_id": "HumanEval/31", "solution": "import math\n\ndef is_prime(n):\n    \"\"\"Return true if a given number is prime, and false otherwise.\n    \"\"\"\n    if n <= 1:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n\n    for i in range(3, math.isqrt(n) + 1, 2):\n        if n % i == 0:\n            return False\n    return True"}
{"task_id": "HumanEval/33", "solution": "def sort_third(l: list):\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the indicies that are not divisible by three, while its values at the indicies that are divisible by three are equal\n    to the values of the corresponding indicies of l, but sorted.\n    >>> sort_third([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_third([5, 6, 3, 4, 8, 9, 2])\n    [2, 6, 3, 4, 8, 9, 5]\n    \"\"\"\n    if not l:\n        return []\n\n    # Create a shallow copy of the input list to store the result\n    result = list(l)\n    \n    # Extract values at indices divisible by three\n    third_elements = []\n    for i in range(len(l)):\n        if i % 3 == 0:\n            third_elements.append(l[i])\n            \n    # Sort these extracted values\n    third_elements.sort()\n    \n    # Place the sorted values back into the result list at their original positions\n    sorted_idx = 0\n    for i in range(len(l)):\n        if i % 3 == 0:\n            result[i] = third_elements[sorted_idx]\n            sorted_idx += 1\n            \n    return result"}
{"task_id": "HumanEval/34", "solution": "def unique(l: list):\n    \"\"\"Return sorted unique elements in a list\n    >>> unique([5, 3, 5, 2, 3, 3, 9, 0, 123])\n    [0, 2, 3, 5, 9, 123]\n    \"\"\"\n    # Convert to a set for uniqueness, then back to a list, and finally sort it.\n    return sorted(list(set(l)))"}
{"task_id": "HumanEval/32", "solution": "def find_zero(xs: list):\n    \"\"\" xs are coefficients of a polynomial.\n    find_zero find x such that poly(x) = 0.\n    find_zero returns only only zero point, even if there are many.\n    Moreover, find_zero only takes list xs having even number of coefficients\n    and largest non zero coefficient as it guarantees\n    a solution.\n    >>> round(find_zero([1, 2]), 2) # f(x) = 1 + 2x\n    -0.5\n    >>> round(find_zero([-6, 11, -6, 1]), 2) # (x - 1) * (x - 2) * (x - 3) = -6 + 11x - 6x^2 + x^3\n    1.0\n    \"\"\"\n    if len(xs) % 2 != 0:\n        raise ValueError(\"find_zero requires an even number of coefficients (odd degree polynomial).\")\n    if not xs or xs[-1] == 0:\n        raise ValueError(\"find_zero requires the largest non-zero coefficient to be present.\")\n\n    low = -100.0\n    high = 100.0\n    tolerance = 1e-6\n    max_iterations = 1000\n\n    f_low = poly(xs, low)\n\n    for _ in range(max_iterations):\n        mid = (low + high) / 2.0\n        f_mid = poly(xs, mid)\n\n        if abs(f_mid) < tolerance:\n            return mid\n\n        # Determine which half contains the root\n        if f_low * f_mid < 0:\n            high = mid\n        else:\n            low = mid\n            f_low = f_mid # Update f_low to maintain the sign of poly(xs, low)\n\n    # Return the midpoint of the last interval as the best approximation\n    return (low + high) / 2.0"}
{"task_id": "HumanEval/35", "solution": "def max_element(l: list):\n    \"\"\"Return maximum element in the list.\n    >>> max_element([1, 2, 3])\n    3\n    >>> max_element([5, 3, -5, 2, -3, 3, 9, 0, 123, 1, -10])\n    123\n    \"\"\"\n    current_max = l[0]\n    for item in l[1:]:\n        if item > current_max:\n            current_max = item\n    return current_max"}
{"task_id": "HumanEval/37", "solution": "def sort_even(l: list):\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the odd indicies, while its values at the even indicies are equal\n    to the values of the even indicies of l, but sorted.\n    >>> sort_even([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_even([5, 6, 3, 4])\n    [3, 6, 5, 4]\n    \"\"\"\n    result_list = list(l) # Create a mutable copy of the input list.\n\n    # Extract elements from even indices and sort them.\n    even_values = []\n    for i in range(len(l)):\n        if i % 2 == 0:\n            even_values.append(l[i])\n    even_values.sort()\n\n    # Place the sorted even values back into the even indices of the result list.\n    even_values_ptr = 0\n    for i in range(len(result_list)):\n        if i % 2 == 0:\n            result_list[i] = even_values[even_values_ptr]\n            even_values_ptr += 1\n            \n    return result_list"}
