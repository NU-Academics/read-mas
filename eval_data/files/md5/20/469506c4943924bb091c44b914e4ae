{"task_id": "HumanEval/96", "solution": "import math\ndef count_up_to(n):\n    \"\"\"Implement a function that takes an non-negative integer and returns an array of the first n\n    integers that are prime numbers and less than n.\n    for example:\n    count_up_to(5) => [2,3]\n    count_up_to(11) => [2,3,5,7]\n    count_up_to(0) => []\n    count_up_to(20) => [2,3,5,7,11,13,17,19]\n    count_up_to(1) => []\n    count_up_to(18) => [2,3,5,7,11,13,17]\n    \"\"\"\n\n    def is_prime(num):\n        \"\"\"Checks if a number is prime using trial division.\"\"\"\n        if num < 2:\n            return False\n        # Iterate up to the square root of num for efficiency.\n        for i in range(2, int(math.sqrt(num)) + 1):\n            if num % i == 0:\n                return False\n        return True\n\n    if n <= 2:\n        return []\n\n    primes = []\n    for num in range(2, n):\n        if is_prime(num):\n            primes.append(num)\n    return primes"}
{"task_id": "HumanEval/96", "solution": "def is_prime(num: int) -> bool:\n    \"\"\"Checks if a number is prime using trial division.\"\"\"\n    if num < 2:\n        return False\n    for i in range(2, int(num**0.5) + 1):\n        if num % i == 0:\n            return False\n    return True\ndef count_up_to(n: int) -> list[int]:\n    \"\"\"Returns a list of all prime numbers strictly less than n.\"\"\"\n    if n <= 2:\n        return []\n\n    primes = []\n    for i in range(2, n):\n        if is_prime(i):\n            primes.append(i)\n    return primes"}
