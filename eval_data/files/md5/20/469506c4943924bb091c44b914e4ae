{"task_id": "HumanEval/38", "solution": "def decode_cyclic(s: str) -> str:\n    \"\"\"\n    Decodes a string cyclically encoded in groups of three characters.\n    Reverses the left cyclic shift for 3-char groups.\n    \"\"\"\n    GROUP_SIZE = 3\n\n    decoded_parts = []\n    for i in range(0, len(s), GROUP_SIZE):\n        group = s[i : i + GROUP_SIZE]\n\n        # Apply the reverse cyclic shift if the group has exactly GROUP_SIZE characters.\n        if len(group) == GROUP_SIZE:\n            decoded_parts.append(group[-1] + group[:-1])\n        else:\n            decoded_parts.append(group)\n\n    return \"\".join(decoded_parts)"}
{"task_id": "HumanEval/39", "solution": "import math\ndef prime_fib(n: int) -> int:\n    \"\"\"\n    prime_fib returns the n-th number that is both a Fibonacci number and a prime number.\n    It identifies prime numbers and generates Fibonacci numbers sequentially.\n    \"\"\"\n\n    def is_prime(num: int) -> bool:\n        \"\"\"Checks if a given number is prime using trial division.\"\"\"\n        if num < 2:\n            return False\n        if num == 2:\n            return True\n        if num % 2 == 0:\n            return False\n        # Iterate only odd divisors up to the square root of num.\n        for i in range(3, int(math.sqrt(num)) + 1, 2):\n            if num % i == 0:\n                return False\n        return True\n\n    a, b = 0, 1\n    prime_fib_count = 0\n\n    while True:\n        current_fib = a\n        # Update Fibonacci sequence for the next iteration.\n        a, b = b, a + b\n\n        # Numbers less than or equal to 1 are not considered prime.\n        if current_fib <= 1:\n            continue\n\n        if is_prime(current_fib):\n            prime_fib_count += 1\n            if prime_fib_count == n:\n                return current_fib"}
{"task_id": "HumanEval/32", "solution": "def find_zero(xs: list):\n    \"\"\" xs are coefficients of a polynomial.\n    find_zero find x such that poly(x) = 0.\n    find_zero returns only only zero point, even if there are many.\n    Moreover, find_zero only takes list xs having even number of coefficients\n    and largest non zero coefficient as it guarantees\n    a solution.\n    >>> round(find_zero([1, 2]), 2) # f(x) = 1 + 2x\n    -0.5\n    >>> round(find_zero([-6, 11, -6, 1]), 2) # (x - 1) * (x - 2) * (x - 3) = -6 + 11x - 6x^2 + x^3\n    1.0\n    \"\"\"\n    # Hardcoded default parameters as per design specification and problem constraints.\n    # The 'find_zero' function signature from the original problem statement does not include these as parameters.\n    tolerance: float = 1e-6\n    max_iterations: int = 1000\n    search_range_lower: float = -100.0\n    search_range_upper: float = 100.0\n    search_step: float = 1.0\n\n    # FR1 Error Handling: `xs` cannot be empty.\n    if not xs:\n        raise ValueError(\"Polynomial coefficients list 'xs' cannot be empty.\")\n\n    def _find_initial_interval_local(\n        coeffs: list,\n        search_bounds: tuple[float, float],\n        step: float\n    ) -> tuple[float, float]:\n        \"\"\"\n        Searches for an interval [a, b] within search_bounds where poly(coeffs, a) and poly(coeffs, b) have opposite signs.\n        Raises RuntimeError if no suitable interval is found within the specified bounds.\n        \"\"\"\n        lower_bound, upper_bound = search_bounds\n\n        x1 = lower_bound\n        # Iterate through segments within the search range.\n        while x1 <= upper_bound:\n            # Determine the end of the current segment, capping it at upper_bound.\n            x2 = x1 + step\n            if x2 > upper_bound:\n                x2 = upper_bound\n\n            y1 = poly(coeffs, x1)\n            y2 = poly(coeffs, x2)\n\n            # Check if endpoints are already roots within tolerance\n            if abs(y1) < tolerance:\n                return x1, x1 # Return a trivial interval around the root\n            if abs(y2) < tolerance:\n                return x2, x2 # Return a trivial interval around the root\n\n            # Check for a sign change. math.copysign handles zero values correctly for bisection.\n            if math.copysign(1, y1) != math.copysign(1, y2):\n                return x1, x2\n\n            # If x1 reached upper_bound in the previous step and no sign change, break.\n            if x1 == upper_bound:\n                break\n\n            x1 = x2 # Move to the start of the next segment.\n            # Defensive check for floating point precision: ensure x1 does not overshoot upper_bound.\n            if x1 > upper_bound and x2 <= upper_bound:\n                x1 = upper_bound\n\n        # FR4 Error Handling: Raise RuntimeError if no suitable interval is found.\n        raise RuntimeError(f\"Could not find an initial interval to bracket a root within {search_bounds}. Try increasing the search range.\")\n\n\n    def _bisection_method_local(\n        coeffs: list,\n        a: float,\n        b: float,\n        tol: float,\n        max_iter: int\n    ) -> float:\n        \"\"\"\n        Implements the bisection method to find a root within [a, b].\n        Assumes poly(coeffs, a) and poly(coeffs, b) have opposite signs or a==b is a root.\n        Raises RuntimeError if max_iterations reached without convergence.\n        \"\"\"\n        y_a = poly(coeffs, a)\n        y_b = poly(coeffs, b)\n\n        # Handle trivial interval where 'a' or 'b' is already a root, or a==b.\n        if abs(y_a) < tol:\n            return a\n        if abs(y_b) < tol:\n            return b\n        # Ensure the interval [a, b] truly brackets a root by checking for opposite signs.\n        # This is a critical precondition for the bisection method.\n        if math.copysign(1, y_a) == math.copysign(1, y_b):\n            raise RuntimeError(\"Bisection method requires function values with opposite signs at interval endpoints.\")\n\n        for _ in range(max_iter):\n            mid = (a + b) / 2\n            y_mid = poly(coeffs, mid)\n\n            # If the midpoint value is close enough to zero, it's a root.\n            if abs(y_mid) < tol:\n                return mid\n\n            # If the interval itself is small enough, the midpoint is a good approximation.\n            if abs(b - a) < tol:\n                return mid\n\n            # Adjust the interval: if y_mid has same sign as y_a, root is in [mid, b], else in [a, mid].\n            if math.copysign(1, y_a) != math.copysign(1, y_mid):\n                b = mid\n                y_b = y_mid # Update y_b for the new interval\n            else:\n                a = mid\n                y_a = y_mid # Update y_a for the new interval\n\n        # FR5 Error Handling: Raise RuntimeError if max_iterations reached without satisfying tolerance.\n        raise RuntimeError(f\"Bisection method failed to converge within {max_iter} iterations. Current best approximation: {(a + b) / 2}\")\n\n    # Main logic for find_zero function.\n    # Step 1: Find an initial bracketing interval [a_initial, b_initial].\n    # This call implements FR4, including its error handling for not finding an interval.\n    a_initial, b_initial = _find_initial_interval_local(xs, (search_range_lower, search_range_upper), search_step)\n\n    # Step 2: Apply the bisection method to find the root within the identified interval.\n    # This call implements FR3 and FR5, including its error handling for non-convergence.\n    return _bisection_method_local(xs, a_initial, b_initial, tolerance, max_iterations)"}
