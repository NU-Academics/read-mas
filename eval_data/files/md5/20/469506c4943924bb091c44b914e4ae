{"task_id": "HumanEval/91", "solution": "def is_bored(S):\n    \"\"\"Counts sentences starting with 'I' in a text.\n    Sentences are delimited by '.', '?', or '!'.\n    \"\"\"\n    boredom_count = 0\n\n    if not S:\n        return 0\n\n    # Logic to split text into sentences (from SentenceParser)\n    SENTENCE_DELIMITERS = ['.', '?', '!']\n    temp_text = S\n    for delimiter in SENTENCE_DELIMITERS:\n        temp_text = temp_text.replace(delimiter, delimiter + \"|SPLIT|\")\n\n    sentences = [s.strip() for s in temp_text.split(\"|SPLIT|\") if s.strip()]\n\n    # Logic to check each sentence for \"boredom\" (from BoredomCounter)\n    for sentence in sentences:\n        stripped_sentence = sentence.strip()\n        if stripped_sentence:\n            # Check if the first word of the sentence is \"I\" (case-insensitive)\n            first_word = stripped_sentence.split(maxsplit=1)[0].lower()\n            if first_word == 'i':\n                boredom_count += 1\n\n    return boredom_count"}
{"task_id": "HumanEval/91", "solution": "import re\ndef is_bored(S: str) -> int:\n    \"\"\"Counts sentences starting with the word \"I\". Sentences are delimited by '.', '?' or '!'.\n    The check for \"I\" is case-insensitive and only counts standalone \"I\".\n    \"\"\"\n\n    # Define sentence delimiters as per specification.\n    SENTENCE_DELIMITERS = ['.', '?', '!']\n\n    processed_text = S\n    # Replace each delimiter with itself followed by a unique end-of-sentence marker.\n    for delimiter in SENTENCE_DELIMITERS:\n        processed_text = processed_text.replace(delimiter, delimiter + \"|SENTENCE_END|\")\n\n    # Split the string by the unique marker to get raw sentence segments.\n    raw_sentences = processed_text.split(\"|SENTENCE_END|\")\n\n    sentences = []\n    # Process each raw segment: strip whitespace and only include non-empty segments.\n    for s in raw_sentences:\n        stripped_s = s.strip()\n        if stripped_s:\n            sentences.append(stripped_s)\n\n    boredom_count = 0\n    # Iterate through identified sentences to count \"boredoms\".\n    for sentence in sentences:\n        # Use regex to check if a sentence starts with \"I\" as a whole word, case-insensitively.\n        if re.match(r\"^I\\b\", sentence, re.IGNORECASE):\n            boredom_count += 1\n\n    return boredom_count"}
{"task_id": "HumanEval/92", "solution": "def any_int(x, y, z):\n    '''\n    Create a function that takes 3 numbers.\n    Returns true if one of the numbers is equal to the sum of the other two, and all numbers are integers.\n    Returns false in any other cases.\n\n    Examples\n    any_int(5, 2, 7) \u279e True\n\n    any_int(3, 2, 2) \u279e False\n\n    any_int(3, -2, 1) \u279e True\n\n    any_int(3.6, -2.2, 2) \u279e False\n\n\n\n    '''\n    if not all(isinstance(arg, int) for arg in [x, y, z]):\n        return False\n\n    return (x == y + z) or (y == x + z) or (z == x + y)"}
{"task_id": "HumanEval/68", "solution": "def pluck(arr: list[int]) -> list[int]:\n    \"\"\"\n    Finds the smallest even-valued node and its index in an array.\n    Prioritizes the smallest index if multiple nodes share the smallest even value.\n    \"\"\"\n    smallest_even_value = float('inf')\n    smallest_even_index = -1\n\n    for index, value in enumerate(arr):\n        if value % 2 == 0:\n            if value < smallest_even_value:\n                smallest_even_value = value\n                smallest_even_index = index\n            elif value == smallest_even_value and index < smallest_even_index:\n                smallest_even_index = index\n\n    if smallest_even_index != -1:\n        return [smallest_even_value, smallest_even_index]\n    else:\n        return []"}
{"task_id": "HumanEval/69", "solution": "from collections import Counter\ndef search(lst):\n    \"\"\"\n    Finds the greatest integer in the list where its frequency is greater than or equal to its value.\n    Returns -1 if no such integer exists.\n    \"\"\"\n    frequencies = Counter(lst)\n\n    candidates = []\n    for num, freq in frequencies.items():\n        if freq >= num:\n            candidates.append(num)\n\n    if not candidates:\n        return -1\n    else:\n        return max(candidates)"}
{"task_id": "HumanEval/67", "solution": "import re\ndef fruit_distribution(s, n):\n    \"\"\"\n    Calculates the number of mango fruits based on apple, orange, and total counts.\n    It extracts apple and orange counts from the input string `s`.\n    \"\"\"\n    apples_match = re.search(r'(\\d+)\\s*apples', s, re.IGNORECASE)\n    apples = int(apples_match.group(1))\n\n    oranges_match = re.search(r'(\\d+)\\s*oranges', s, re.IGNORECASE)\n    oranges = int(oranges_match.group(1))\n\n    mangoes = n - (apples + oranges)\n    return mangoes"}
{"task_id": "HumanEval/93", "solution": "def encode(message):\n    \"\"\"Encodes a message by swapping letter case and shifting vowels.\"\"\"\n    VOWELS = {'a', 'e', 'i', 'o', 'u'}\n    ALPHABET_LOWER = 'abcdefghijklmnopqrstuvwxyz'\n\n    encoded_chars = []\n    for char in message:\n        if char.isalpha():\n            processed_char_before_final_swap = char\n\n            is_original_upper = char.isupper()\n            char_lower = char.lower()\n\n            if char_lower in VOWELS:\n                index = ALPHABET_LOWER.find(char_lower)\n                shifted_index = (index + 2) % len(ALPHABET_LOWER)\n                shifted_char_lower = ALPHABET_LOWER[shifted_index]\n\n                processed_char_before_final_swap = shifted_char_lower.upper() if is_original_upper else shifted_char_lower\n\n            encoded_chars.append(processed_char_before_final_swap.swapcase())\n        else:\n            encoded_chars.append(char)\n\n    return \"\".join(encoded_chars)"}
{"task_id": "HumanEval/94", "solution": "def skjkasdkd(lst: list[int]) -> int:\n    \"\"\"You are given a list of integers.\n    You need to find the largest prime value and return the sum of its digits.\"\"\"\n\n    def is_prime(n: int) -> bool:\n        # Determines if a given integer n is a prime number.\n        if n <= 1:\n            return False\n        i = 2\n        while i * i <= n:\n            if n % i == 0:\n                return False\n            i += 1\n        return True\n\n    def sum_digits(n: int) -> int:\n        # Calculates the sum of the absolute value of the digits of a given integer n.\n        s = 0\n        num_str = str(abs(n))\n        for digit_char in num_str:\n            s += int(digit_char)\n        return s\n\n    largest_prime = -1  # Initialize with a sentinel value, as primes are positive.\n\n    for number in lst:\n        if is_prime(number):\n            if number > largest_prime:\n                largest_prime = number\n\n    if largest_prime != -1:  # If a prime number was found.\n        return sum_digits(largest_prime)\n    else:\n        return 0  # Return 0 if no prime numbers are found in the list."}
{"task_id": "HumanEval/93", "solution": "_VOWELS = {'a', 'e', 'i', 'o', 'u'}\ndef _is_vowel(char: str) -> bool:\n    \"\"\"Checks if a character is an English vowel (case-insensitive).\"\"\"\n    return char.lower() in _VOWELS\ndef _shift_char_by_two(char: str) -> str:\n    \"\"\"Shifts an English letter two positions forward in the alphabet, preserving case.\"\"\"\n    offset = ord('a') if char.islower() else ord('A')\n    shifted_ord = (ord(char) - offset + 2) % 26 + offset\n    return chr(shifted_ord)\ndef _swap_char_case(char: str) -> str:\n    \"\"\"Swaps the case of an English letter.\"\"\"\n    return char.swapcase()\ndef encode(message):\n    \"\"\"\n    Encodes a message by swapping letter cases and shifting vowels.\n    Non-letter characters are preserved in their original position.\n    \"\"\"\n    encoded_chars = []\n    for char in message:\n        if char.isalpha():\n            if _is_vowel(char):\n                # Vowel: shift by 2, then swap case\n                shifted_char = _shift_char_by_two(char)\n                final_char = _swap_char_case(shifted_char)\n            else:\n                # Consonant: just swap case\n                final_char = _swap_char_case(char)\n        else:\n            # Non-letter: keep as is\n            final_char = char\n        encoded_chars.append(final_char)\n    return \"\".join(encoded_chars)"}
