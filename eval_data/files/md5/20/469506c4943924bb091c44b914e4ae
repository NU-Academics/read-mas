{"task_id": "HumanEval/87", "solution": "def get_row(lst, x):\n    \"\"\"\n    Finds occurrences of integer x in a 2D nested list and returns their\n    (row, column) coordinates, sorted by row ascending, then column descending.\n    \"\"\"\n    coordinates = []\n    for r_idx, row in enumerate(lst):\n        for c_idx, val in enumerate(row):\n            if val == x:\n                coordinates.append((r_idx, c_idx))\n\n    coordinates.sort(key=lambda coord: (coord[0], -coord[1]))\n    return coordinates"}
{"task_id": "HumanEval/86", "solution": "def anti_shuffle(s):\n    \"\"\"\n    Transforms a string by sorting characters within each word based on ASCII values.\n    The original order of words and spaces, including leading/trailing/multiple spaces, is preserved.\n    \"\"\"\n    parts = []\n    current_part = []\n    for char in s:\n        if char == ' ':\n            if current_part:\n                parts.append(\"\".join(sorted(current_part)))\n                current_part = []\n            parts.append(' ')\n        else:\n            current_part.append(char)\n\n    if current_part:\n        parts.append(\"\".join(sorted(current_part)))\n\n    return \"\".join(parts)"}
{"task_id": "HumanEval/87", "solution": "def get_row(lst: list[list[int]], x: int) -> list[tuple[int, int]]:\n    \"\"\"\n    Finds all occurrences of an integer x in a 2D nested list.\n    Returns sorted (row, column) coordinates, primarily by row ascending, then by column descending.\n    \"\"\"\n    coordinates = []\n    for r_idx, row in enumerate(lst):\n        for c_idx, val in enumerate(row):\n            if val == x:\n                coordinates.append((r_idx, c_idx))\n\n    coordinates.sort(key=lambda coord: (coord[0], -coord[1]))\n    return coordinates"}
{"task_id": "HumanEval/64", "solution": "def vowels_count(s):\n    \"\"\"Write a function vowels_count which takes a string representing\n    a word as input and returns the number of vowels in the string.\n    Vowels in this case are 'a', 'e', 'i', 'o', 'u'. Here, 'y' is also a\n    vowel, but only when it is at the end of the given word.\n\n    Example:\n    >>> vowels_count(\"abcde\")\n    2\n    >>> vowels_count(\"ACEDY\")\n    3\n    >>> vowels_count(\"\")\n    0\n    >>> vowels_count(\"rhythm\")\n    1\n    >>> vowels_count(\"shh\")\n    0\n    >>> vowels_count(\"aeiou\")\n    5\n    >>> vowels_count(\"beautiful\")\n    5\n    >>> vowels_count(\"education\")\n    5\n    >>> vowels_count(\"AEioU\")\n    5\n    >>> vowels_count(\"PyThOn\")\n    1\n    >>> vowels_count(\"ApPlE\")\n    2\n    >>> vowels_count(\"sky\")\n    1\n    >>> vowels_count(\"fly\")\n    1\n    >>> vowels_count(\"try\")\n    1\n    >>> vowels_count(\"happy\")\n    2\n    >>> vowels_count(\"mythical\")\n    2\n    >>> vowels_count(\"system\")\n    2\n    >>> vowels_count(\"yearly\")\n    3\n    >>> vowels_count(\"gymnastics\")\n    3\n    >>> vowels_count(\"syzygy\")\n    3\n    >>> vowels_count(\"cryptography\")\n    4\n    >>> vowels_count(\"h3ll0_w0rld!\")\n    2\n    >>> vowels_count(\"a1e2i3o4u5\")\n    5\n    >>> vowels_count(\"!@#$%^&*()\")\n    0\n    >>> vowels_count(\"supercalifragilisticexpialidocious\")\n    16\n    >>> import pytest\n    >>> with pytest.raises(TypeError): vowels_count(123)\n    >>> with pytest.raises(TypeError): vowels_count(None)\n    >>> with pytest.raises(TypeError): vowels_count(['a', 'e'])\n    \"\"\"\n    if not isinstance(s, str):\n        raise TypeError(\"Input must be a string.\")\n\n    vowels = \"aeiou\"\n    count = 0\n    s_lower = s.lower()\n\n    for i, char in enumerate(s_lower):\n        if char in vowels:\n            count += 1\n        elif char == 'y' and i == len(s_lower) - 1:\n            count += 1\n    return count"}
{"task_id": "HumanEval/86", "solution": "def anti_shuffle(s):\n    \"\"\"\n    Takes a string and returns an ordered version of it.\n    Ordered version of string, is a string where all words (separated by space)\n    are replaced by a new word where all the characters arranged in\n    ascending order based on ascii value.\n    Note: You should keep the order of words and blank spaces in the sentence.\n    \"\"\"\n    parts = []\n    current_part = []\n    is_space = False\n\n    for char in s:\n        if char.isspace():\n            if not is_space and current_part:\n                parts.append(\"\".join(current_part))\n                current_part = []\n            current_part.append(char)\n            is_space = True\n        else:\n            if is_space and current_part:\n                parts.append(\"\".join(current_part))\n                current_part = []\n            current_part.append(char)\n            is_space = False\n\n    if current_part:\n        parts.append(\"\".join(current_part))\n\n    result_parts = []\n    for part in parts:\n        if part.isspace():\n            result_parts.append(part)\n        else:\n            result_parts.append(\"\".join(sorted(part)))\n\n    return \"\".join(result_parts)"}
{"task_id": "HumanEval/88", "solution": "def sort_array(array):\n    \"\"\"\n    Given an array of non-negative integers, return a copy of the given array after sorting.\n    The array is sorted ascending if the sum of its first and last elements is odd, otherwise descending.\n    \"\"\"\n    if not array:\n        return []\n    if len(array) == 1:\n        return list(array) # Return a copy for single-element arrays.\n\n    first_element = array[0]\n    last_element = array[len(array) - 1]\n    sum_first_last = first_element + last_element\n\n    if sum_first_last % 2 != 0:  # Odd sum, sort ascending\n        return sorted(array)\n    else:  # Even sum, sort descending\n        return sorted(array, reverse=True)"}
{"task_id": "HumanEval/88", "solution": "def sort_array(array):\n    \"\"\"\n    Sorts a copy of the array based on the parity of the sum of its first and last elements.\n    The array is sorted ascending if the sum is odd, descending if even, without modifying the original array.\n    \"\"\"\n    if not array:\n        return []\n    if len(array) == 1:\n        return array[:]\n\n    first_val = array[0]\n    last_val = array[-1]\n    sum_vals = first_val + last_val\n\n    if sum_vals % 2 != 0:  # Odd sum, sort ascending\n        return sorted(array)\n    else:  # Even sum, sort descending\n        return sorted(array, reverse=True)"}
{"task_id": "HumanEval/89", "solution": "def encrypt(s):\n    \"\"\"Create a function encrypt that takes a string as an argument and\n    returns a string encrypted with the alphabet being rotated.\n    \"\"\"\n    SHIFT_AMOUNT = 4\n    encrypted_chars = []\n    for char in s:\n        if 'a' <= char <= 'z':\n            base = ord('a')\n            shifted_char_code = base + (ord(char) - base + SHIFT_AMOUNT) % 26\n            encrypted_chars.append(chr(shifted_char_code))\n        elif 'A' <= char <= 'Z':\n            base = ord('A')\n            shifted_char_code = base + (ord(char) - base + SHIFT_AMOUNT) % 26\n            encrypted_chars.append(chr(shifted_char_code))\n        else:\n            encrypted_chars.append(char)\n    return \"\".join(encrypted_chars)"}
{"task_id": "HumanEval/89", "solution": "def encrypt(s):\n    \"\"\"Encrypts a string by rotating lowercase English letters by a fixed shift.\n    Other characters remain unchanged.\n    \"\"\"\n    ALPHABET = \"abcdefghijklmnopqrstuvwxyz\"\n    SHIFT_VALUE = 4  # The alphabet rotation shift value is fixed at 4.\n\n    encrypted_chars = []\n    for char in s:\n        if 'a' <= char <= 'z':\n            start_index = ALPHABET.index(char)\n            new_index = (start_index + SHIFT_VALUE) % len(ALPHABET)\n            encrypted_chars.append(ALPHABET[new_index])\n        else:\n            encrypted_chars.append(char)\n    return \"\".join(encrypted_chars)"}
{"task_id": "HumanEval/90", "solution": "from typing import List, Optional\ndef next_smallest(lst: List[int]) -> Optional[int]:\n    \"\"\"\n    Returns the 2nd smallest distinct element of the list.\n    Returns None if there is no such element.\n    \"\"\"\n    if not lst:\n        return None\n\n    # Convert to a set to get distinct elements, then back to a sorted list.\n    distinct_elements = sorted(list(set(lst)))\n\n    # Return None if there are fewer than two distinct elements.\n    if len(distinct_elements) < 2:\n        return None\n    else:\n        return distinct_elements[1]"}
