{"task_id": "HumanEval/62", "solution": "def derivative(xs: list):\n    \"\"\" xs represent coefficients of a polynomial.\n    xs[0] + xs[1] * x + xs[2] * x^2 + ....\n     Return derivative of this polynomial in the same form.\n    >>> derivative([3, 1, 2, 4, 5])\n    [1, 4, 12, 20]\n    >>> derivative([1, 2, 3])\n    [2, 6]\n    \"\"\"\n    if len(xs) <= 1:\n        return []\n\n    derived_coefficients = []\n    for i in range(1, len(xs)):\n        derived_coefficients.append(i * xs[i])\n    return derived_coefficients"}
{"task_id": "HumanEval/62", "solution": "def derivative(xs: list):\n    \"\"\" xs represent coefficients of a polynomial.\n    xs[0] + xs[1] * x + xs[2] * x^2 + ....\n     Return derivative of this polynomial in the same form.\n    >>> derivative([3, 1, 2, 4, 5])\n    [1, 4, 12, 20]\n    >>> derivative([1, 2, 3])\n    [2, 6]\n    \"\"\"\n    return [coeff * i for i, coeff in enumerate(xs[1:], start=1)]"}
{"task_id": "HumanEval/64", "solution": "def vowels_count(s):\n    \"\"\"Counts vowels in a string, with 'y' counting only at the end.\n    Vowels are 'a', 'e', 'i', 'o', 'u', case-insensitive.\n    \"\"\"\n    standard_vowels = {'a', 'e', 'i', 'o', 'u'}\n    count = 0\n    word_length = len(s)\n\n    for i, char in enumerate(s):\n        lower_char = char.lower()\n        if lower_char in standard_vowels:\n            count += 1\n        elif lower_char == 'y' and i == word_length - 1:\n            count += 1\n    return count"}
{"task_id": "HumanEval/63", "solution": "_fibfib_memo = {\n    0: 0,\n    1: 0,\n    2: 1\n}\ndef fibfib(n: int) -> int:\n    \"\"\"Computes the n-th FibFib number using memoization.\n    It returns the value defined by fibfib(0)=0, fibfib(1)=0, fibfib(2)=1, and fibfib(n) = fibfib(n-1) + fibfib(n-2) + fibfib(n-3) for n > 2.\n    \"\"\"\n    if n in _fibfib_memo:\n        return _fibfib_memo[n]\n\n    result = fibfib(n - 1) + fibfib(n - 2) + fibfib(n - 3)\n    _fibfib_memo[n] = result\n    return result"}
{"task_id": "HumanEval/66", "solution": "def digitSum(s):\n    \"\"\"Calculates the sum of ASCII values of all uppercase characters in the input string.\n    Iterates through the string, checks if each character is uppercase, and adds its ordinal value to a running sum.\n    \"\"\"\n    total_sum = 0\n    for char in s:\n        if char.isupper():\n            total_sum += ord(char)\n    return total_sum"}
{"task_id": "HumanEval/63", "solution": "def fibfib(n: int, _cache={0: 0, 1: 0, 2: 1}) -> int:\n    \"\"\"Computes the n-th element of the FibFib number sequence efficiently using memoization.\n    It returns the value based on the definition fibfib(n) = fibfib(n-1) + fibfib(n-2) + fibfib(n-3).\n    \"\"\"\n    if n in _cache:\n        return _cache[n]\n\n    result = fibfib(n - 1, _cache) + fibfib(n - 2, _cache) + fibfib(n - 3, _cache)\n    _cache[n] = result\n    return result"}
{"task_id": "HumanEval/65", "solution": "def circular_shift(x, shift):\n    \"\"\"Circular shift the digits of the integer x, shift the digits right by shift\n    and return the result as a string.\n    If shift > number of digits, return digits reversed.\n    \"\"\"\n\n    # Helper function to convert int to list of digit strings.\n    def _int_to_digits(num: int) -> list[str]:\n        return list(str(num))\n\n    # Helper function to perform right circular shift.\n    def _perform_shift(digits_list: list[str], shift_amount: int) -> list[str]:\n        n = len(digits_list)\n        effective_shift = shift_amount % n\n        return digits_list[-effective_shift:] + digits_list[:-effective_shift]\n\n    # Helper function to reverse digits.\n    def _reverse_digits(digits_list: list[str]) -> list[str]:\n        return digits_list[::-1]\n\n    digits = _int_to_digits(x)\n    num_digits = len(digits)\n\n    if shift > num_digits:\n        shifted_digits = _reverse_digits(digits)\n    else:\n        shifted_digits = _perform_shift(digits, shift)\n\n    return \"\".join(shifted_digits)"}
{"task_id": "HumanEval/65", "solution": "def circular_shift(x, shift):\n    \"\"\"Circular shift the digits of integer x right by shift and return as a string.\n    If shift exceeds the number of digits, the digits are reversed.\n    \"\"\"\n    x_str = str(x)\n    n = len(x_str)\n\n    if shift > n:\n        return x_str[::-1]\n    else:\n        effective_shift = shift % n\n        if effective_shift == 0:\n            return x_str\n        return x_str[-effective_shift:] + x_str[:-effective_shift]"}
