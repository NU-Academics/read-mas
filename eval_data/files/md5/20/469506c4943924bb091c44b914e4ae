{"task_id": "HumanEval/116", "solution": "def sort_array(arr):\n    \"\"\"\n    In this Kata, you have to sort an array of non-negative integers according to\n    number of ones in their binary representation in ascending order.\n    For similar number of ones, sort based on decimal value.\n\n    It must be implemented like this:\n    >>> sort_array([1, 5, 2, 3, 4]) == [1, 2, 3, 4, 5]\n    >>> sort_array([-2, -3, -4, -5, -6]) == [-6, -5, -4, -3, -2]\n    >>> sort_array([1, 0, 2, 3, 4]) [0, 1, 2, 3, 4]\n    \"\"\"\n\n    def _count_set_bits(n: int) -> int:\n        \"\"\"\n        Counts the number of '1's in the binary representation of a non-negative integer.\n        \"\"\"\n        count = 0\n        while n > 0:\n            n &= (n - 1)  # Brian Kernighan's algorithm\n            count += 1\n        return count\n\n    if not isinstance(arr, list):\n        raise TypeError(\"Input must be a list.\")\n\n    for item in arr:\n        if not isinstance(item, int):\n            raise TypeError(\"All elements in the array must be integers.\")\n        if item < 0:\n            raise ValueError(\"All elements in the array must be non-negative integers for sorting by ones count.\")\n\n    # Create a list of tuples: (ones_count, original_number)\n    # Python's default sort for tuples handles primary and secondary keys automatically.\n    decorated_list = []\n    for num in arr:\n        ones_count = _count_set_bits(num)\n        decorated_list.append((ones_count, num))\n\n    decorated_list.sort()\n\n    # Extract the original numbers from the sorted tuples\n    sorted_arr = [num for _, num in decorated_list]\n    return sorted_arr"}
{"task_id": "HumanEval/123", "solution": "def get_odd_collatz(n):\n    \"\"\"\n    Given a positive integer n, return a sorted list that has the odd numbers in collatz sequence.\n    The sequence is generated until it reaches 1, and only unique odd numbers are returned.\n    \"\"\"\n    if n == 1:\n        return [1]\n\n    sequence = [n]\n    current = n\n    while current != 1:\n        if current % 2 == 0:\n            current //= 2\n        else:\n            current = 3 * current + 1\n        sequence.append(current)\n\n    odd_numbers = set()\n    for num in sequence:\n        if num % 2 != 0:\n            odd_numbers.add(num)\n\n    return sorted(list(odd_numbers))"}
{"task_id": "HumanEval/124", "solution": "def valid_date(date):\n    \"\"\"\n    Validates a date string in 'mm-dd-yyyy' format according to specific rules.\n    Returns True for a valid date, False otherwise.\n    \"\"\"\n    # FR2: The date string shall not be empty.\n    if not date:\n        return False\n\n    # FR7: The date shall be in the format: mm-dd-yyyy.\n    # Parse the date string into month, day, year components.\n    try:\n        parts = date.split('-')\n        if len(parts) != 3:\n            return False\n\n        month = int(parts[0])\n        day = int(parts[1])\n        year = int(parts[2]) # Year is not further validated per requirements.\n\n    except (ValueError, IndexError):\n        # Handles cases like 'abc', '01-XX-2000', '01-01', or non-integer parts.\n        return False\n\n    # FR6: The month shall be between 1 and 12 (inclusive).\n    if not (1 <= month <= 12):\n        return False\n\n    # FR3, FR4, FR5: Validate days based on month.\n    # Define days in each month according to rules.\n    days_in_month = {\n        1: 31, 3: 31, 5: 31, 7: 31, 8: 31, 10: 31, 12: 31,\n        4: 30, 6: 30, 9: 30, 11: 30,\n        2: 29 # February has a fixed maximum of 29 days, as per requirement.\n    }\n\n    # Retrieve maximum allowed days for the current month.\n    # This lookup is safe as 'month' is already validated to be between 1 and 12.\n    max_days = days_in_month[month]\n\n    # Check if the day is within the valid range for the specific month.\n    if not (1 <= day <= max_days):\n        return False\n\n    # FR8: All validation rules passed.\n    return True"}
{"task_id": "HumanEval/126", "solution": "def is_sorted(lst):\n    \"\"\"Checks if a list is sorted ascending and has at most one duplicate of any number.\n    Assumes non-negative integers as input.\"\"\"\n\n    if not lst:\n        return True\n\n    # Check for ascending order\n    for i in range(len(lst) - 1):\n        if lst[i] > lst[i+1]:\n            return False\n\n    # Check for duplicate count constraint\n    counts = {}\n    for num in lst:\n        counts[num] = counts.get(num, 0) + 1\n        if counts[num] > 2:\n            return False\n\n    return True"}
{"task_id": "HumanEval/125", "solution": "def split_words(txt):\n    '''\n    Splits a string by whitespace, then by commas, or counts specific letters.\n    Counts lowercase letters with odd 0-indexed alphabetical order if no delimiters.\n    '''\n    if any(c.isspace() for c in txt):\n        return txt.split()\n    elif ',' in txt:\n        return txt.split(',')\n    else:\n        count = 0\n        for char in txt:\n            if 'a' <= char <= 'z':\n                if (ord(char) - ord('a')) % 2 != 0:\n                    count += 1\n        return count"}
{"task_id": "HumanEval/126", "solution": "from collections import Counter\ndef is_sorted(lst):\n    '''\n    Given a list of numbers, return whether or not they are sorted\n    in ascending order. If list has more than 1 duplicate of the same\n    number, return False. Assume no negative numbers and only integers.\n\n    Examples\n    is_sorted([5]) \u279e True\n    is_sorted([1, 2, 3, 4, 5]) \u279e True\n    is_sorted([1, 3, 2, 4, 5]) \u279e False\n    is_sorted([1, 2, 3, 4, 5, 6]) \u279e True\n    is_sorted([1, 2, 3, 4, 5, 6, 7]) \u279e True\n    is_sorted([1, 3, 2, 4, 5, 6, 7]) \u279e False\n    is_sorted([1, 2, 2, 3, 3, 4]) \u279e True\n    is_sorted([1, 2, 2, 2, 3, 4]) \u279e False\n    '''\n    # Input validation: check if it's a list of non-negative integers\n    if not isinstance(lst, list):\n        return False\n    for num in lst:\n        if not isinstance(num, int) or num < 0:\n            return False\n\n    # Check if the list is sorted in ascending order.\n    # An empty or single-element list is considered sorted.\n    for i in range(len(lst) - 1):\n        if lst[i] > lst[i+1]:\n            return False\n\n    # Check if any number appears more than twice (i.e., 3 or more occurrences).\n    # \"more than 1 duplicate of the same number\" means count > 2.\n    counts = Counter(lst)\n    for count in counts.values():\n        if count > 2:\n            return False\n\n    return True"}
{"task_id": "HumanEval/123", "solution": "def get_odd_collatz(n):\n    \"\"\"\n    Given a positive integer n, return a sorted list that has the odd numbers in its Collatz sequence.\n    The sequence is generated until 1 is reached, and the resulting list contains unique odd numbers.\n    \"\"\"\n\n    odd_numbers_set = set()\n    current_num = n\n\n    while True:\n        if current_num % 2 != 0:\n            odd_numbers_set.add(current_num)\n\n        if current_num == 1:\n            break\n\n        if current_num % 2 == 0:\n            current_num //= 2\n        else:\n            current_num = 3 * current_num + 1\n\n    return sorted(list(odd_numbers_set))"}
{"task_id": "HumanEval/125", "solution": "def split_words(txt):\n    \"\"\"\n    Splits text by whitespace, then by comma if no whitespace,\n    otherwise counts odd-ordered lowercase letters.\n    \"\"\"\n    # Check for whitespace characters (including space, tab, newline, carriage return, form feed, vertical tab)\n    if any(ws_char in txt for ws_char in ' \\t\\n\\r\\f\\v'):\n        # Split by any whitespace. Python's str.split() handles multiple spaces and empty strings appropriately.\n        return txt.split()\n\n    elif ',' in txt:\n        # If no whitespace, split by comma.\n        # Filter out empty strings that may result from consecutive or leading/trailing commas\n        # to align with the \"no words\" requirement for delimiter-only inputs.\n        return [word for word in txt.split(',') if word]\n\n    else:\n        # If neither whitespace nor comma, count lowercase letters with odd alphabetical order.\n        count = 0\n        alphabet_offset = ord('a')\n        for char in txt:\n            # Check if character is a lowercase letter\n            if 'a' <= char <= 'z':\n                # Calculate alphabetical order (0-indexed: 'a'=0, 'b'=1, ...)\n                order = ord(char) - alphabet_offset\n                if order % 2 != 0:  # Check if the order is odd\n                    count += 1\n        return count"}
{"task_id": "HumanEval/128", "solution": "def prod_signs(arr):\n    \"\"\"\n    Computes the sum of magnitudes of integers multiplied by the product of their signs.\n    Returns None for an empty array as per requirements.\n    \"\"\"\n    if not arr:\n        return None\n\n    product_of_signs = 1\n    sum_of_magnitudes = 0\n\n    for num in arr:\n        sign = 0\n        if num > 0:\n            sign = 1\n        elif num < 0:\n            sign = -1\n\n        product_of_signs *= sign\n        sum_of_magnitudes += abs(num)\n\n    return product_of_signs * sum_of_magnitudes"}
{"task_id": "HumanEval/124", "solution": "import re\ndef valid_date(date: str) -> bool:\n    \"\"\"You have to write a function which validates a given date string and\n    returns True if the date is valid otherwise False.\n    The date is valid if all of the following rules are satisfied:\n    1. The date string is not empty.\n    2. The number of days is not less than 1 or higher than 31 days for months 1,3,5,7,8,10,12. And the number of days is not less than 1 or higher than 30 days for months 4,6,9,11. And, the number of days is not less than 1 or higher than 29 for the month 2.\n    3. The months should not be less than 1 or higher than 12.\n    4. The date should be in the format: mm-dd-yyyy\n    \"\"\"\n\n    # FR1: The system shall validate that the input date string is not empty.\n    if not date or not date.strip():\n        return False\n\n    # Helper function to determine if a year is a leap year.\n    def _is_leap_year(year: int) -> bool:\n        \"\"\"Checks if a given year is a leap year based on standard rules.\"\"\"\n        return (year % 4 == 0 and year % 100 != 0) or (year % 400 == 0)\n\n    # FR2: The system shall validate that the date string adheres to the \"mm-dd-yyyy\" format.\n    # This regex also implicitly validates month (01-12), day (01-31), and year (4 digits).\n    _DATE_FORMAT_REGEX = re.compile(r\"^(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])-\\\\d{4}$\")\n    if not _DATE_FORMAT_REGEX.match(date):\n        return False\n\n    # Parse components (regex ensures they are numerical and correctly formatted)\n    month_str, day_str, year_str = date.split('-')\n    month = int(month_str)\n    day = int(day_str)\n    year = int(year_str)\n\n    # FR3: The system shall validate that the month component is between 1 and 12 (inclusive).\n    # This is partially covered by the regex, but an explicit check ensures full compliance.\n    if not (1 <= month <= 12):\n        return False\n\n    # Define standard maximum days for each month.\n    _DAYS_IN_MONTH = {\n        1: 31, 3: 31, 5: 31, 7: 31, 8: 31, 10: 31, 12: 31,\n        4: 30, 6: 30, 9: 30, 11: 30,\n        2: 29  # Default max for February, adjusted for non-leap years\n    }\n\n    # FR4: The system shall validate that the day component is within the valid range.\n    max_days = _DAYS_IN_MONTH[month] # Month is guaranteed 1-12 due to prior checks\n\n    if month == 2:  # Adjust max days for February based on leap year\n        if not _is_leap_year(year):\n            max_days = 28 # February has 28 days in a common year\n\n    if not (1 <= day <= max_days):\n        return False\n\n    return True"}
{"task_id": "HumanEval/127", "solution": "import math\ndef intersection(interval1, interval2):\n    \"\"\"You are given two intervals,\n    where each interval is a pair of integers. For example, interval = (start, end) = (1, 2).\n    The given intervals are closed which means that the interval (start, end)\n    includes both start and end.\n    For each given interval, it is assumed that its start is less or equal its end.\n    Your task is to determine whether the length of intersection of these two\n    intervals is a prime number.\n    Example, the intersection of the intervals (1, 3), (2, 4) is (2, 3)\n    which its length is 1, which not a prime number.\n    If the length of the intersection is a prime number, return \"YES\",\n    otherwise, return \"NO\".\n    If the two intervals don't intersect, return \"NO\".\n\n\n    [input/output] samples:\n    intersection((1, 2), (2, 3)) ==> \"NO\"\n    intersection((-1, 1), (0, 4)) ==> \"NO\"\n    intersection((-3, -1), (-5, 5)) ==> \"YES\"\n    \"\"\"\n\n    def is_prime(number: int) -> bool:\n        \"\"\"Checks if a given integer is a prime number.\"\"\"\n        if number <= 1:\n            return False\n        if number == 2:\n            return True\n        if number % 2 == 0:\n            return False\n\n        for i in range(3, int(math.sqrt(number)) + 1, 2):\n            if number % i == 0:\n                return False\n        return True\n\n    # Calculate intersection\n    start1, end1 = interval1\n    start2, end2 = interval2\n\n    max_start = max(start1, start2)\n    min_end = min(end1, end2)\n\n    length = 0\n    if max_start <= min_end:\n        length = min_end - max_start\n    else:\n        # No intersection, length is 0, which is not prime.\n        # This case is already covered by is_prime(0) returning False.\n        pass\n\n    if is_prime(length):\n        return \"YES\"\n    else:\n        return \"NO\""}
{"task_id": "HumanEval/127", "solution": "def intersection(interval1, interval2):\n    \"\"\"You are given two intervals,\n    where each interval is a pair of integers.\n    Determine whether the length of the intersection of these two\n    intervals is a prime number.\n    \"\"\"\n    import math\n\n    def is_prime(n: int) -> bool:\n        \"\"\"Checks if a non-negative integer is a prime number.\"\"\"\n        if n <= 1:\n            return False\n        if n == 2:\n            return True\n        if n % 2 == 0:\n            return False\n        # Check divisibility by odd numbers up to the square root of n.\n        for i in range(3, int(math.sqrt(n)) + 1, 2):\n            if n % i == 0:\n                return False\n        return True\n\n    start1, end1 = interval1\n    start2, end2 = interval2\n\n    max_start = max(start1, start2)\n    min_end = min(end1, end2)\n\n    if max_start <= min_end:\n        # Intersection exists, calculate its length.\n        intersection_length = min_end - max_start\n        if is_prime(intersection_length):\n            return \"YES\"\n        else:\n            return \"NO\"\n    else:\n        # No intersection.\n        return \"NO\""}
{"task_id": "HumanEval/128", "solution": "def _get_sign(n: int) -> int:\n    \"\"\"\n    Determines the sign of an integer. Returns 1 for positive, -1 for negative, 0 for zero.\n    \"\"\"\n    if n > 0:\n        return 1\n    elif n < 0:\n        return -1\n    else:\n        return 0\ndef _get_magnitude(n: int) -> int:\n    \"\"\"\n    Calculates the absolute magnitude of an integer.\n    \"\"\"\n    return abs(n)\ndef prod_signs(arr: list[int]) -> int | None:\n    \"\"\"\n    Calculates the sum of magnitudes of integers multiplied by the product of their signs.\n    Returns None for an empty array.\n    \"\"\"\n    if not arr:\n        return None\n\n    sum_magnitudes = 0\n    product_signs = 1\n\n    for num in arr:\n        sum_magnitudes += _get_magnitude(num)\n        product_signs *= _get_sign(num)\n\n    return sum_magnitudes * product_signs"}
{"task_id": "HumanEval/131", "solution": "def digits(n):\n    \"\"\"Given a positive integer n, return the product of its odd digits.\n    Return 0 if n contains no odd digits.\n    \"\"\"\n    product = 1\n    has_odd_digit = False\n\n    for digit_char in str(n):\n        digit = int(digit_char)\n        if digit % 2 != 0:\n            product *= digit\n            has_odd_digit = True\n\n    return product if has_odd_digit else 0"}
{"task_id": "HumanEval/129", "solution": "import heapq\nclass Cell:\n    \"\"\"Represents a single cell in the grid with its coordinates and value.\"\"\"\n    def __init__(self, row: int, col: int, value: int):\n        self.row = row\n        self.col = col\n        self.value = value\n\n    def get_coords(self) -> tuple[int, int]:\n        \"\"\"Returns the (row, col) tuple of the cell.\"\"\"\n        return (self.row, self.col)\n\n    def __repr__(self):\n        return f\"Cell({self.row},{self.col},{self.value})\"\nclass Path:\n    \"\"\"Represents a sequence of visited cell values and the last cell.\"\"\"\n    def __init__(self, values: list[int], last_cell: Cell):\n        self.values = values\n        self.last_cell = last_cell\n        self.length = len(values)\n\n    def __lt__(self, other: 'Path') -> bool:\n        \"\"\"Implements lexicographical comparison for Path objects.\"\"\"\n        return self.values < other.values\n\n    def extend(self, next_cell: Cell) -> 'Path':\n        \"\"\"Returns a new Path object by appending the next cell's value.\"\"\"\n        new_values = self.values + [next_cell.value]\n        return Path(new_values, next_cell)\n\n    def __repr__(self):\n        return f\"Path(values={self.values}, last_cell={self.last_cell})\"\nclass Grid:\n    \"\"\"Encapsulates the grid data and provides access methods.\"\"\"\n    def __init__(self, grid_data: list[list[int]]):\n        self._data = grid_data\n        self._rows = len(grid_data)\n        self._cols = len(grid_data[0])\n\n    def get_cell(self, row: int, col: int) -> Cell:\n        \"\"\"Returns a Cell object for the given coordinates.\"\"\"\n        return Cell(row, col, self._data[row][col])\n\n    def get_rows(self) -> int:\n        \"\"\"Returns the number of rows in the grid.\"\"\"\n        return self._rows\n\n    def get_cols(self) -> int:\n        \"\"\"Returns the number of columns in the grid.\"\"\"\n        return self._cols\ndef get_neighbors(grid_rows: int, grid_cols: int, cell: Cell) -> list[tuple[int, int]]:\n    \"\"\"Determines all valid adjacent (up, down, left, right) cell coordinates.\"\"\"\n    neighbors = []\n    directions = [(0, 1), (0, -1), (1, 0), (-1, 0)] # Right, Left, Down, Up\n\n    for dr, dc in directions:\n        new_row, new_col = cell.row + dr, cell.col + dc\n        if 0 <= new_row < grid_rows and 0 <= new_col < grid_cols:\n            neighbors.append((new_row, new_col))\n    return neighbors\nclass PathFinderService:\n    \"\"\"Implements the core algorithm to find the lexicographically smallest path.\"\"\"\n    def find_min_path(self, grid_data: list[list[int]], k: int) -> list[int]:\n        grid = Grid(grid_data)\n        pq: list[Path] = [] # Min-heap for paths, prioritized by lexicographical order.\n\n        # Initialize the priority queue with all possible starting cells as paths of length 1.\n        for r in range(grid.get_rows()):\n            for c in range(grid.get_cols()):\n                start_cell = grid.get_cell(r, c)\n                heapq.heappush(pq, Path([start_cell.value], start_cell))\n\n        while pq:\n            current_path = heapq.heappop(pq)\n\n            # If the current path has reached the desired length k, it's the smallest.\n            if current_path.length == k:\n                return current_path.values\n\n            # Otherwise, extend the path to its neighbors.\n            for next_r, next_c in get_neighbors(grid.get_rows(), grid.get_cols(), current_path.last_cell):\n                next_cell = grid.get_cell(next_r, next_c)\n                new_path = current_path.extend(next_cell)\n                heapq.heappush(pq, new_path)\n\n        # This point should not be reached based on problem guarantees of a unique solution.\n        return []\ndef minPath(grid: list[list[int]], k: int) -> list[int]:\n    \"\"\"\n    Finds the lexicographically smallest path of length k in the grid.\n    Returns an ordered list of cell values for the minimum path.\n    \"\"\"\n    service = PathFinderService()\n    return service.find_min_path(grid, k)"}
{"task_id": "HumanEval/130", "solution": "def tri(n):\n    \"\"\"\n    Calculates the Tribonacci sequence up to the given non-negative integer n.\n    Returns a list of the first n + 1 Tribonacci numbers.\n    \"\"\"\n    memo = {}\n\n    def _get_tribonacci_number_internal(k: int) -> int:\n        \"\"\"\n        Helper to get a single Tribonacci number, using memoization.\n        \"\"\"\n        if k in memo:\n            return memo[k]\n\n        if k == 0:\n            result = 1\n        elif k == 1:\n            result = 3\n        elif k % 2 == 0:  # k is even\n            result = 1 + k // 2\n        else:  # k is odd\n            # tri(k) = tri(k - 1) + tri(k - 2) + tri(k + 1)\n            # For odd k, k+1 is even, so tri(k+1) = 1 + (k+1)/2\n            result = _get_tribonacci_number_internal(k - 1) + \\\n                     _get_tribonacci_number_internal(k - 2) + \\\n                     (1 + (k + 1) // 2)\n\n        memo[k] = result\n        return result\n\n    sequence = []\n    for i in range(n + 1):\n        sequence.append(_get_tribonacci_number_internal(i))\n\n    return sequence"}
{"task_id": "HumanEval/131", "solution": "def digits(n: int) -> int:\n    \"\"\"\n    Given a positive integer n, return the product of its odd digits.\n    Return 0 if all digits are even.\n    \"\"\"\n    product = 1\n    has_odd_digit = False\n\n    for digit_char in str(n):\n        digit = int(digit_char)\n        if digit % 2 != 0:\n            product *= digit\n            has_odd_digit = True\n\n    return product if has_odd_digit else 0"}
{"task_id": "HumanEval/132", "solution": "def is_nested(string):\n    \"\"\"\n    Create a function that takes a string as input which contains only square brackets.\n    The function should return True if and only if there is a valid subsequence of brackets where at least one bracket in the subsequence is nested.\n    \"\"\"\n    open_brackets = 0\n    for char in string:\n        if char == '[':\n            open_brackets += 1\n        elif char == ']':\n            open_brackets -= 1\n\n        # If at any point the count of open brackets exceeds one, it means nesting is present.\n        if open_brackets > 1:\n            return True\n\n    return False"}
{"task_id": "HumanEval/130", "solution": "def tri(n):\n    \"\"\"Everyone knows Fibonacci sequence, it was studied deeply by mathematicians in\n    the last couple centuries. However, what people don't know is Tribonacci sequence.\n    Tribonacci sequence is defined by the recurrence:\n    tri(1) = 3\n    tri(n) = 1 + n / 2, if n is even.\n    tri(n) =  tri(n - 1) + tri(n - 2) + tri(n + 1), if n is odd.\n    For example:\n    tri(2) = 1 + (2 / 2) = 2\n    tri(4) = 3\n    tri(3) = tri(2) + tri(1) + tri(4)\n           = 2 + 3 + 3 = 8\n    You are given a non-negative integer number n, you have to a return a list of the\n    first n + 1 numbers of the Tribonacci sequence.\n    Examples:\n    tri(3) = [1, 3, 2, 8]\n    \"\"\"\n    # Initialize trib_sequence of size n + 2 to accommodate tri(n+1) for odd k calculation.\n    trib_sequence = [0] * (n + 2)\n\n    # Initialize base cases: tri(0) and tri(1).\n    trib_sequence[0] = 1\n    trib_sequence[1] = 3\n\n    # First Pass: Calculate even terms tri(k) for k > 0 up to n+1.\n    for k in range(2, n + 2):\n        if k % 2 == 0:  # k is even\n            trib_sequence[k] = 1 + k // 2\n\n    # Second Pass: Calculate odd terms tri(k) for k > 1 up to n.\n    for k in range(2, n + 1):\n        if k % 2 != 0:  # k is odd\n            # tri(k) = tri(k - 1) + tri(k - 2) + tri(k + 1)\n            trib_sequence[k] = trib_sequence[k - 1] + trib_sequence[k - 2] + trib_sequence[k + 1]\n\n    # Return the first n + 1 numbers of the sequence.\n    return trib_sequence[0 : n + 1]"}
{"task_id": "HumanEval/133", "solution": "import math\ndef sum_squares(lst):\n    \"\"\"Calculates the sum of squares for numbers in a list after ceiling rounding.\n    Each number is first rounded up to the nearest integer before squaring.\n    \"\"\"\n    total_sum = 0\n    for num in lst:\n        rounded_num = math.ceil(num)\n        total_sum += rounded_num * rounded_num\n    return total_sum"}
{"task_id": "HumanEval/134", "solution": "def check_if_last_char_is_a_letter(txt):\n    \"\"\"\n    Checks if the last character of a given string is an alphabetical character\n    and is not part of a word. A \"word\" is a group of characters separated by space.\n    \"\"\"\n    if not txt:\n        return False\n\n    last_char = txt[-1]\n\n    if not last_char.isalpha():\n        return False\n\n    # Check if it's not part of a word: it's the only character or preceded by a space.\n    # Otherwise, it's part of a word.\n    if len(txt) == 1:\n        return True\n    elif txt[-2] == ' ':\n        return True\n    else:\n        return False"}
{"task_id": "HumanEval/133", "solution": "import math\ndef sum_squares(lst):\n    \"\"\"You are given a list of numbers.\n    You need to return the sum of squared numbers in the given list,\n    round each element in the list to the upper int(Ceiling) first.\n    \"\"\"\n    squared_ceil_sum = 0\n    for item in lst:\n        ceiled_value = math.ceil(item)\n        squared_ceil_sum += ceiled_value * ceiled_value\n    return int(squared_ceil_sum)"}
{"task_id": "HumanEval/132", "solution": "def is_nested(string):\n    \"\"\"\n    Checks if the input string contains a subsequence `[ [ ] ]` where the inner `[ ]` is a contiguous substring.\n    Returns True if such a pattern is found, False otherwise.\n    \"\"\"\n    n = len(string)\n\n    outer_open_idx = -1\n    for i in range(n):\n        if string[i] == '[':\n            outer_open_idx = i\n            break\n\n    if outer_open_idx == -1:\n        return False\n\n    for j in range(outer_open_idx + 1, n - 1):\n        if string[j] == '[' and string[j+1] == ']':\n            inner_close_idx = j + 1\n\n            for k in range(inner_close_idx + 1, n):\n                if string[k] == ']':\n                    return True\n\n    return False"}
{"task_id": "HumanEval/134", "solution": "def check_if_last_char_is_a_letter(txt):\n    \"\"\"\n    Checks if the last character of a string is an alphabetical character and is not part of a word.\n    A 'word' is a group of characters separated by space.\n    \"\"\"\n    if not txt:\n        return False\n\n    last_char = txt[-1]\n\n    if not last_char.isalpha():\n        return False\n\n    if len(txt) == 1:\n        return False\n\n    char_before_last = txt[-2]\n    return char_before_last == ' '"}
{"task_id": "HumanEval/136", "solution": "def largest_smallest_integers(lst):\n    '''\n    Create a function that returns a tuple (a, b), where 'a' is\n    the largest of negative integers, and 'b' is the smallest\n    of positive integers in a list.\n    If there is no negative or positive integers, return them as None.\n    '''\n    largest_negative = None\n    smallest_positive = None\n\n    for num in lst:\n        if num < 0:\n            if largest_negative is None or num > largest_negative:\n                largest_negative = num\n        elif num > 0: # num is positive\n            if smallest_positive is None or num < smallest_positive:\n                smallest_positive = num\n\n    return (largest_negative, smallest_positive)"}
{"task_id": "HumanEval/129", "solution": "import heapq\nfrom typing import List, Tuple, Dict\nclass Grid:\n    \"\"\"Manages grid data, providing safe access to cell values and identifying valid neighbors.\"\"\"\n    ADJACENT_MOVES = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n\n    def __init__(self, grid_data: List[List[int]]):\n        self._grid_data = grid_data\n        self._N = len(grid_data)\n\n    def get_value(self, row: int, col: int) -> int:\n        \"\"\"Returns the integer value at the specified grid coordinates.\"\"\"\n        return self._grid_data[row][col]\n\n    def is_valid_coord(self, row: int, col: int) -> bool:\n        \"\"\"Checks if the given coordinates are within the grid boundaries.\"\"\"\n        return 0 <= row < self._N and 0 <= col < self._N\n\n    def get_neighbors(self, row: int, col: int) -> List[Tuple[int, int]]:\n        \"\"\"Returns a list of valid (in-grid) adjacent neighbor coordinates.\"\"\"\n        neighbors = []\n        for dr, dc in self.ADJACENT_MOVES:\n            n_row, n_col = row + dr, col + dc\n            if self.is_valid_coord(n_row, n_col):\n                neighbors.append((n_row, n_col))\n        return neighbors\nclass Path:\n    \"\"\"Represents a path through the grid, including values, endpoint, and comparison.\"\"\"\n    def __init__(self, values: List[int], last_pos: Tuple[int, int]):\n        self.values = values\n        self.last_pos = last_pos\n\n    def get_length(self) -> int:\n        \"\"\"Returns the current length of the path.\"\"\"\n        return len(self.values)\n\n    def get_last_row(self) -> int:\n        \"\"\"Returns the row of the last cell in the path.\"\"\"\n        return self.last_pos[0]\n\n    def get_last_col(self) -> int:\n        \"\"\"Returns the column of the last cell in the path.\"\"\"\n        return self.last_pos[1]\n\n    def extend(self, new_value: int, new_pos: Tuple[int, int]) -> 'Path':\n        \"\"\"Creates a new Path by extending the current path with a new cell.\"\"\"\n        return Path(self.values + [new_value], new_pos)\n\n    def __lt__(self, other: 'Path') -> bool:\n        \"\"\"Enables lexicographical comparison between two Path objects.\"\"\"\n        return self.values < other.values\n\n    def __eq__(self, other: 'Path') -> bool:\n        \"\"\"Enables equality comparison between two Path objects.\"\"\"\n        return self.values == other.values\nclass PathFinderService:\n    \"\"\"Implements the core algorithm to find the lexicographically smallest path.\"\"\"\n    def __init__(self, grid: Grid, k: int):\n        self._grid = grid\n        self._k = k\n        self._min_paths_at_cell_length: Dict[int, Dict[Tuple[int, int], List[int]]] = {}\n\n    def find_min_path(self) -> List[int]:\n        \"\"\"Executes the BFS-like algorithm with a priority queue to find the minimum path.\"\"\"\n        priority_queue: List[Path] = []\n        N = self._grid._N\n\n        # Initializes the priority queue with paths starting from every cell.\n        for r in range(N):\n            for c in range(N):\n                initial_value = self._grid.get_value(r, c)\n                initial_path = Path([initial_value], (r, c))\n                heapq.heappush(priority_queue, initial_path)\n                # Records the initial path in the state tracking dictionary.\n                self._min_paths_at_cell_length.setdefault(1, {})[(r, c)] = initial_path.values\n\n        overall_min_path: List[int] = []\n\n        while priority_queue:\n            current_path = heapq.heappop(priority_queue)\n            current_length = current_path.get_length()\n            current_pos = current_path.last_pos\n            current_values = current_path.values\n\n            # Prunes the path if a lexicographically smaller or equal path to this state was already processed.\n            if current_length in self._min_paths_at_cell_length and \\\n               current_pos in self._min_paths_at_cell_length[current_length] and \\\n               current_values > self._min_paths_at_cell_length[current_length][current_pos]:\n                continue\n\n            # Updates the state tracking with the current path if it's the best found so far.\n            self._min_paths_at_cell_length.setdefault(current_length, {})[current_pos] = current_values\n\n            if current_length == self._k:\n                # If the path reaches length `k`, update the overall minimum if this path is smaller.\n                if not overall_min_path or current_values < overall_min_path:\n                    overall_min_path = current_values\n                continue # Paths of target length `k` are not extended.\n\n            if current_length < self._k:\n                # Extends the current path to valid neighbors if shorter than `k`.\n                for next_r, next_c in self._grid.get_neighbors(current_path.get_last_row(), current_path.get_last_col()):\n                    next_value = self._grid.get_value(next_r, next_c)\n                    new_path = current_path.extend(next_value, (next_r, next_c))\n\n                    new_path_length = new_path.get_length()\n                    new_path_pos = new_path.last_pos\n                    new_path_values = new_path.values\n\n                    # Adds a new path to the queue if it improves upon or establishes a new state.\n                    if new_path_length not in self._min_paths_at_cell_length or \\\n                       new_path_pos not in self._min_paths_at_cell_length[new_path_length] or \\\n                       new_path_values < self._min_paths_at_cell_length[new_path_length][new_path_pos]:\n                        heapq.heappush(priority_queue, new_path)\n\n        return overall_min_path\ndef minPath(grid: List[List[int]], k: int) -> List[int]:\n    \"\"\"\n    Finds the lexicographically smallest path of length k in the given grid.\n    This function orchestrates the pathfinding process using Grid and PathFinderService.\n    \"\"\"\n    grid_instance = Grid(grid)\n    path_finder = PathFinderService(grid_instance, k)\n    return path_finder.find_min_path()"}
{"task_id": "HumanEval/135", "solution": "def can_arrange(arr):\n    \"\"\"\n    Returns the largest index i such that arr[i] < arr[i-1].\n    If no such index exists, returns -1.\n    \"\"\"\n    if len(arr) < 2:\n        return -1\n\n    for i in range(len(arr) - 1, 0, -1):\n        if arr[i] < arr[i-1]:\n            return i\n    return -1"}
