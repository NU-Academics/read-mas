{"task_id": "HumanEval/104", "solution": "def unique_digits(x):\n    \"\"\"Given a list of positive integers x. return a sorted list of all\n    elements that hasn't any even digit.\n\n    Note: Returned list should be sorted in increasing order.\n    \"\"\"\n\n    def _has_even_digit(n: int) -> bool:\n        \"\"\"Checks if a positive integer n contains any even digits (0, 2, 4, 6, 8).\"\"\"\n        temp_n = n\n        while temp_n > 0:\n            digit = temp_n % 10\n            if digit % 2 == 0:\n                return True\n            temp_n //= 10\n        return False\n\n    filtered_list = []\n    for number in x:\n        if not _has_even_digit(number):\n            filtered_list.append(number)\n\n    filtered_list.sort()\n    return filtered_list"}
{"task_id": "HumanEval/103", "solution": "def rounded_avg(n: int, m: int) -> Union[str, int]:\n    \"\"\"Computes the rounded average of integers in a range and converts it to binary.\n    Returns -1 if n is greater than m.\"\"\"\n\n    if n > m:\n        return -1\n\n    # Calculate count of numbers and their sum using the arithmetic series formula.\n    count = m - n + 1\n    total_sum = (count * (n + m)) // 2\n\n    # Compute the floating-point average.\n    average_float = total_sum / count\n\n    # Round the average to the nearest integer (Python's round() rounds half to even).\n    rounded_int = round(average_float)\n\n    # Convert the rounded integer to its binary string representation.\n    return bin(rounded_int)"}
{"task_id": "HumanEval/105", "solution": "def by_length(arr):\n    \"\"\"\n    Given an array of integers, sorts the integers between 1 and 9 inclusive,\n    reverses the resulting array, and converts each digit to its word representation.\n    \"\"\"\n    digit_words = {\n        1: \"One\", 2: \"Two\", 3: \"Three\", 4: \"Four\", 5: \"Five\",\n        6: \"Six\", 7: \"Seven\", 8: \"Eight\", 9: \"Nine\"\n    }\n\n    if not arr:\n        return []\n\n    # Filter digits that are between 1 and 9 inclusive.\n    # Non-comparable types in 'arr' will cause a TypeError, as per \"Trust the caller's inputs\".\n    filtered_digits = []\n    for num in arr:\n        if 1 <= num <= 9:\n            filtered_digits.append(num)\n\n    if not filtered_digits:\n        return []\n\n    # Sort the filtered digits in ascending order.\n    filtered_digits.sort()\n\n    # Reverse the sorted array to get descending order.\n    reversed_digits = filtered_digits[::-1]\n\n    # Replace each digit with its corresponding word.\n    result_words = [digit_words[digit] for digit in reversed_digits]\n\n    return result_words"}
{"task_id": "HumanEval/104", "solution": "def unique_digits(x: list[int]) -> list[int]:\n    \"\"\"Given a list of positive integers x, return a sorted list of elements\n    that do not contain any even digits. The returned list will be sorted in increasing order.\n    \"\"\"\n\n    def _has_even_digit(number: int) -> bool:\n        \"\"\"Checks if a positive integer contains any even digits.\"\"\"\n        # This function trusts that 'number' is a positive integer.\n        temp_num = number\n        while temp_num > 0:\n            digit = temp_num % 10\n            if digit % 2 == 0:\n                return True\n            temp_num //= 10\n        return False\n\n    filtered_numbers = []\n    for num in x:\n        if not _has_even_digit(num):\n            filtered_numbers.append(num)\n\n    return sorted(filtered_numbers)"}
{"task_id": "HumanEval/102", "solution": "def choose_num(x, y):\n    \"\"\"\n    Returns the biggest even integer in the range [x, y] inclusive.\n    Returns -1 if no such number exists, assuming x and y are positive integers.\n    \"\"\"\n    if x > y:\n        return -1\n\n    # Iterate from y downwards to x to find the largest even number efficiently.\n    for num in range(y, x - 1, -1):\n        if num % 2 == 0:\n            return num\n\n    return -1"}
{"task_id": "HumanEval/103", "solution": "def rounded_avg(n, m):\n    \"\"\"\n    Computes the average of integers from n through m, rounds it, and converts to binary.\n    Returns -1 if n > m.\n    \"\"\"\n    if n > m:\n        return -1\n\n    count = m - n + 1\n    total_sum = (count * (n + m)) // 2\n\n    average = total_sum / count\n    rounded_average = round(average)\n\n    return bin(rounded_average)"}
{"task_id": "HumanEval/106", "solution": "def f(n):\n    \"\"\" Implement the function f that takes n as a parameter,\n    and returns a list of size n, such that the value of the element at index i is the factorial of i if i is even\n    or the sum of numbers from 1 to i otherwise.\n    i starts from 1.\n    the factorial of i is the multiplication of the numbers from 1 to i (1 * 2 * ... * i).\n    Example:\n    f(5) == [1, 2, 6, 24, 15]\n    \"\"\"\n\n    def calculate_factorial(num: int) -> int:\n        \"\"\"Calculates the factorial of a non-negative integer.\"\"\"\n        # 'num' is guaranteed to be a positive integer from the calling loop in f(n)\n        if num == 0:\n            return 1\n\n        result = 1\n        for i_val in range(1, num + 1):\n            result *= i_val\n        return result\n\n    def calculate_sum_up_to(num: int) -> int:\n        \"\"\"Calculates the sum of integers from 1 up to a non-negative integer.\"\"\"\n        # 'num' is guaranteed to be a positive integer from the calling loop in f(n)\n        return (num * (num + 1)) // 2\n\n    if not isinstance(n, int):\n        raise TypeError(\"Input 'n' must be an integer.\")\n    if n < 0:\n        raise ValueError(\"Input 'n' cannot be negative.\")\n\n    if n == 0:\n        return []\n\n    result_list = []\n    for i in range(1, n + 1):\n        if i % 2 == 0:  # Even index i\n            result_list.append(calculate_factorial(i))\n        else:  # Odd index i\n            result_list.append(calculate_sum_up_to(i))\n    return result_list"}
{"task_id": "HumanEval/106", "solution": "def _factorial(k: int) -> int:\n    \"\"\"Calculates the factorial of k. Assumes k is a non-negative integer.\"\"\"\n    if k == 0:\n        return 1\n    result = 1\n    for i in range(1, k + 1):\n        result *= i\n    return result\ndef _sum_up_to(k: int) -> int:\n    \"\"\"Calculates the sum of numbers from 1 to k. Assumes k is a non-negative integer.\"\"\"\n    return k * (k + 1) // 2\ndef f(n: int) -> list[int]:\n    \"\"\"\n    Implement the function f that takes n as a parameter, and returns a list of size n.\n    For even indices i (1-based), calculate factorial(i); for odd indices i, calculate sum(1 to i).\n    \"\"\"\n    result_list = []\n    for i in range(1, n + 1):\n        if i % 2 == 0:  # Even index (1-based)\n            result_list.append(_factorial(i))\n        else:  # Odd index (1-based)\n            result_list.append(_sum_up_to(i))\n    return result_list"}
{"task_id": "HumanEval/107", "solution": "def even_odd_palindrome(n: int) -> tuple[int, int]:\n    \"\"\"\n    Counts even and odd integer palindromes within the range [1, n] inclusive.\n    Returns a tuple with (even_count, odd_count).\n    \"\"\"\n\n    def _is_palindrome(num: int) -> bool:\n        \"\"\"\n        Checks if a positive integer is a palindrome.\n        It converts the number to a string and compares it to its reverse.\n        \"\"\"\n        s = str(num)\n        return s == s[::-1]\n\n    even_count = 0\n    odd_count = 0\n\n    for i in range(1, n + 1):\n        if _is_palindrome(i):\n            if i % 2 == 0:\n                even_count += 1\n            else:\n                odd_count += 1\n\n    return (even_count, odd_count)"}
{"task_id": "HumanEval/105", "solution": "def by_length(arr):\n    \"\"\"\n    Given an array of integers, sort the integers that are between 1 and 9 inclusive,\n    reverse the resulting array, and then replace each digit by its corresponding name from\n    \"One\", \"Two\", \"Three\", \"Four\", \"Five\", \"Six\", \"Seven\", \"Eight\", \"Nine\".\n    \"\"\"\n    DIGIT_WORDS = {\n        1: \"One\", 2: \"Two\", 3: \"Three\", 4: \"Four\", 5: \"Five\",\n        6: \"Six\", 7: \"Seven\", 8: \"Eight\", 9: \"Nine\"\n    }\n\n    # Filter to include only integers between 1 and 9 inclusive.\n    # Assumes elements in 'arr' are numbers based on \"Given an array of integers\" and\n    # the critical requirement not to use isinstance().\n    filtered_nums = [num for num in arr if 1 <= num <= 9]\n\n    # Sort the filtered integers in ascending order.\n    filtered_nums.sort()\n\n    # Reverse the sorted array of integers.\n    reversed_nums = filtered_nums[::-1]\n\n    # Replace each integer with its English word representation.\n    word_representations = [DIGIT_WORDS[num] for num in reversed_nums]\n\n    return word_representations"}
{"task_id": "HumanEval/108", "solution": "def count_nums(arr):\n    \"\"\"\n    Counts elements in an array where the sum of digits is greater than 0.\n    Negative numbers have their first digit counted as negative.\n    \"\"\"\n    count = 0\n    for num in arr:\n        digit_sum = 0\n        if num == 0:\n            digit_sum = 0\n        else:\n            s = str(abs(num))\n            if num < 0:\n                digit_sum += -int(s[0])\n                for digit_char in s[1:]:\n                    digit_sum += int(digit_char)\n            else:\n                for digit_char in s:\n                    digit_sum += int(digit_char)\n\n        if digit_sum > 0:\n            count += 1\n\n    return count"}
{"task_id": "HumanEval/107", "solution": "def even_odd_palindrome(n: int) -> tuple[int, int]:\n    \"\"\"\n    Counts even and odd integer palindromes within the range [1, n].\n    Returns a tuple (even_count, odd_count) for the given positive integer n.\n    \"\"\"\n\n    def _is_palindrome(num: int) -> bool:\n        \"\"\"\n        Checks if an integer is a palindrome by comparing its string representation.\n        Returns True if the number reads the same forwards and backwards.\n        \"\"\"\n        s_num = str(num)\n        return s_num == s_num[::-1]\n\n    even_count = 0\n    odd_count = 0\n\n    for i in range(1, n + 1):\n        if _is_palindrome(i):\n            if i % 2 == 0:\n                even_count += 1\n            else:\n                odd_count += 1\n\n    return (even_count, odd_count)"}
{"task_id": "HumanEval/109", "solution": "def move_one_ball(arr: list[int]) -> bool:\n    \"\"\"Determines if an array can be sorted in non-decreasing order by performing right shift operations.\"\"\"\n\n    def is_sorted_local(current_arr: list[int]) -> bool:\n        \"\"\"Checks if the given array is sorted in non-decreasing order.\"\"\"\n        if not current_arr:\n            return True\n        for j in range(len(current_arr) - 1):\n            if current_arr[j] > current_arr[j+1]:\n                return False\n        return True\n\n    n = len(arr)\n    if n == 0:\n        return True\n\n    for i in range(n):\n        shifted_arr = arr[i:] + arr[:i]\n        if is_sorted_local(shifted_arr):\n            return True\n    return False"}
{"task_id": "HumanEval/108", "solution": "def count_nums(arr: list[int]) -> int:\n    \"\"\"\n    Counts the number of elements in an array of integers where the sum of digits > 0.\n    If a number is negative, its first signed digit will be negative.\n    \"\"\"\n\n    class DigitExtractor:\n        @staticmethod\n        def extract_signed_digits(num: int) -> list[int]:\n            \"\"\"Extracts signed digits from an integer, making the first digit negative if the number is negative.\"\"\"\n            if num == 0:\n                return [0]\n\n            digits = []\n            is_negative = num < 0\n            abs_num = abs(num)\n\n            while abs_num > 0:\n                digits.append(abs_num % 10)\n                abs_num //= 10\n\n            digits.reverse()\n\n            if is_negative and digits:\n                digits[0] = -digits[0]\n\n            return digits\n\n    class DigitSumService:\n        def calculate_sum(self, num: int) -> int:\n            \"\"\"Calculates the sum of signed digits for a given integer.\"\"\"\n            digits = DigitExtractor.extract_signed_digits(num)\n            return sum(digits)\n\n    # Initialize DigitSumService as per the design\n    digit_sum_service = DigitSumService()\n\n    count = 0\n    for num in arr:\n        digit_sum = digit_sum_service.calculate_sum(num)\n        if digit_sum > 0:\n            count += 1\n    return count"}
{"task_id": "HumanEval/110", "solution": "def exchange(lst1: list[int], lst2: list[int]) -> str:\n    \"\"\"Determines if lst1 can be made all even by exchanging elements with lst2.\n    Returns \"YES\" if possible, \"NO\" otherwise.\"\"\"\n    odd_count_lst1 = sum(1 for x in lst1 if x % 2 != 0)\n    even_count_lst2 = sum(1 for x in lst2 if x % 2 == 0)\n\n    if odd_count_lst1 <= even_count_lst2:\n        return \"YES\"\n    else:\n        return \"NO\""}
{"task_id": "HumanEval/111", "solution": "def histogram(test):\n    \"\"\"Given a string of space-separated lowercase letters, find the most frequent ones.\n    Returns a dictionary of these letters and their counts, including all ties.\"\"\"\n    if not test:\n        return {}\n\n    letters = [char for char in test.split(' ') if char]\n\n    if not letters:\n        return {}\n\n    letter_counts = {}\n    for letter in letters:\n        letter_counts[letter] = letter_counts.get(letter, 0) + 1\n\n    max_frequency = max(letter_counts.values())\n\n    result = {}\n    for letter, count in letter_counts.items():\n        if count == max_frequency:\n            result[letter] = count\n\n    return result"}
{"task_id": "HumanEval/112", "solution": "def reverse_delete(s, c):\n    \"\"\"\n    Deletes characters from string 's' that are present in string 'c',\n    then checks if the resulting string is a palindrome.\n    \"\"\"\n\n    def _filter_string_internal(input_s, chars_to_remove_str):\n        # Filters characters from input_s not present in chars_to_remove_str.\n        chars_set = set(chars_to_remove_str)\n        filtered_chars = [char for char in input_s if char not in chars_set]\n        return \"\".join(filtered_chars)\n\n    def _is_palindrome_internal(input_s):\n        # Checks if the given string is a palindrome.\n        return input_s == input_s[::-1]\n\n    filtered_s = _filter_string_internal(s, c)\n    is_pal = _is_palindrome_internal(filtered_s)\n    return (filtered_s, is_pal)"}
{"task_id": "HumanEval/109", "solution": "def move_one_ball(arr):\n    \"\"\"We have an array 'arr' of N integers arr[1], arr[2], ..., arr[N].The\n    numbers in the array will be randomly ordered. Your task is to determine if\n    it is possible to get an array sorted in non-decreasing order by performing\n    the following operation on the given array:\n        You are allowed to perform right shift operation any number of times.\n\n    One right shift operation means shifting all elements of the array by one\n    position in the right direction. The last element of the array will be moved to\n    the starting position in the array i.e. 0th index.\n\n    If it is possible to obtain the sorted array by performing the above operation\n    then return True else return False.\n    If the given array is empty then return True.\n\n    Note: The given list is guaranteed to have unique elements.\n\n    For Example:\n\n    move_one_ball([3, 4, 5, 1, 2])==>True\n    Explanation: By performin 2 right shift operations, non-decreasing order can\n                 be achieved for the given array.\n    move_one_ball([3, 5, 4, 1, 2])==>False\n    Explanation:It is not possible to get non-decreasing order for the given\n                array by performing any number of right shift operations.\n\n    \"\"\"\n\n    def _is_sorted(current_arr):\n        # Checks if the given array is sorted in non-decreasing order.\n        if len(current_arr) <= 1:\n            return True\n        for i in range(len(current_arr) - 1):\n            if current_arr[i] > current_arr[i+1]:\n                return False\n        return True\n\n    def _perform_right_shift(current_arr):\n        # Performs a single right shift operation on the array.\n        if not current_arr:\n            return []\n        return [current_arr[-1]] + current_arr[:-1]\n\n    n = len(arr)\n    if n <= 1:\n        return True\n\n    current_arr_state = list(arr)\n\n    for _ in range(n):\n        if _is_sorted(current_arr_state):\n            return True\n        current_arr_state = _perform_right_shift(current_arr_state)\n\n    return False"}
{"task_id": "HumanEval/110", "solution": "def exchange(lst1, lst2):\n    \"\"\"Determines if lst1 can be made entirely of even numbers by exchanging elements with lst2.\n    It counts odds in lst1 and evens in lst2, then compares.\n    \"\"\"\n    odds_in_lst1 = 0\n    for num in lst1:\n        if num % 2 != 0:\n            odds_in_lst1 += 1\n\n    evens_in_lst2 = 0\n    for num in lst2:\n        if num % 2 == 0:\n            evens_in_lst2 += 1\n\n    if odds_in_lst1 <= evens_in_lst2:\n        return \"YES\"\n    else:\n        return \"NO\""}
{"task_id": "HumanEval/111", "solution": "import collections\ndef histogram(test):\n    \"\"\"Analyzes a string of space-separated lowercase letters to find the most frequent ones.\n    Returns a dictionary of letters with their highest frequency counts, or an empty dictionary if no letters are found.\"\"\"\n\n    if not test:\n        return {}\n\n    # Parse the input string into individual lowercase letters, ignoring non-lowercase or non-single-character tokens.\n    letters = [char for char in test.split(' ') if char.islower() and len(char) == 1]\n\n    if not letters:\n        return {}\n\n    # Count the occurrences of each unique letter.\n    frequencies = dict(collections.Counter(letters))\n\n    # Identify the maximum occurrence count among all letters.\n    max_frequency = max(frequencies.values())\n\n    # Filter to return only letters that match the maximum occurrence count.\n    return {letter: count for letter, count in frequencies.items() if count == max_frequency}"}
{"task_id": "HumanEval/112", "solution": "def reverse_delete(s, c):\n    \"\"\"\n    Deletes all characters in s that are equal to any character in c.\n    Then checks if the result string is a palindrome.\n    \"\"\"\n    filtered_s = \"\".join([char for char in s if char not in c])\n    is_palindrome = filtered_s == filtered_s[::-1]\n    return (filtered_s, is_palindrome)"}
{"task_id": "HumanEval/113", "solution": "def odd_count(lst):\n    \"\"\"Given a list of digit-only strings, return a list of formatted strings.\n    Each output string describes the count of odd digits in the corresponding input string.\n    \"\"\"\n    results = []\n    for s in lst:\n        odd_digits_count = 0\n        for char_digit in s:\n            if int(char_digit) % 2 != 0:\n                odd_digits_count += 1\n\n        # Format the output string according to the specified pattern\n        formatted_string = (\n            f\"the number of odd elements {odd_digits_count}n the str{odd_digits_count}ng \"\n            f\"{odd_digits_count} of the {odd_digits_count}nput.\"\n        )\n        results.append(formatted_string)\n    return results"}
{"task_id": "HumanEval/113", "solution": "def odd_count(lst):\n    \"\"\"\n    Analyzes digit strings in a list to count odd digits and formats the results.\n    Each output string embeds the count into a predefined template.\n    \"\"\"\n    results = []\n    odd_digits_set = {'1', '3', '5', '7', '9'}\n    output_template = \"the number of odd elements {count}n the str{count}ng {count} of the {count}nput.\"\n\n    for s in lst:\n        current_odd_count = 0\n        for char_digit in s:\n            if char_digit in odd_digits_set:\n                current_odd_count += 1\n\n        formatted_string = output_template.format(count=current_odd_count)\n        results.append(formatted_string)\n\n    return results"}
{"task_id": "HumanEval/114", "solution": "def minSubArraySum(nums):\n    \"\"\"\n    Finds the minimum sum of any non-empty sub-array in the given list of integers.\n    Example:\n    minSubArraySum([2, 3, 4, 1, 2, 4]) == 1\n    minSubArraySum([-1, -2, -3]) == -6\n    \"\"\"\n    min_ending_here = nums[0]\n    overall_min = nums[0]\n\n    for i in range(1, len(nums)):\n        # Determine the minimum sum ending at the current element.\n        min_ending_here = min(nums[i], min_ending_here + nums[i])\n        # Update the overall minimum sum found across all sub-arrays.\n        overall_min = min(overall_min, min_ending_here)\n\n    return overall_min"}
{"task_id": "HumanEval/115", "solution": "def max_fill(grid, capacity):\n    \"\"\"\n    Calculates the number of times buckets need to be lowered to empty wells.\n    \"\"\"\n    total_water_units = 0\n    for row in grid:\n        total_water_units += sum(row)\n\n    if total_water_units == 0:\n        return 0\n\n    # Calculate ceiling division for total operations using integer arithmetic.\n    total_operations = (total_water_units + capacity - 1) // capacity\n    return total_operations"}
{"task_id": "HumanEval/115", "solution": "def max_fill(grid, capacity):\n    \"\"\"\n    Calculates the total number of bucket operations needed to empty all wells.\n    Each 1 in the grid represents one unit of water; all buckets have the same capacity.\n    \"\"\"\n    total_operations = 0\n    for well in grid:\n        water_in_well = sum(well)\n        # Calculate ceil(water_in_well / capacity) using integer arithmetic.\n        # The formula (numerator + denominator - 1) // denominator works for non-negative numerator and positive denominator.\n        operations_for_well = (water_in_well + capacity - 1) // capacity\n        total_operations += operations_for_well\n    return total_operations"}
{"task_id": "HumanEval/117", "solution": "def select_words(s, n):\n    \"\"\"\n    Filters words from a string s, returning those with exactly n consonants.\n    Consonants are non-vowel letters (a, e, i, o, u), case-insensitive.\n    \"\"\"\n    if not s:\n        return []\n\n    VOWELS = {'a', 'e', 'i', 'o', 'u'}\n    result = []\n\n    words = s.split()\n\n    for word in words:\n        consonant_count = 0\n        for char in word:\n            lower_char = char.lower()\n            if 'a' <= lower_char <= 'z' and lower_char not in VOWELS:\n                consonant_count += 1\n\n        if consonant_count == n:\n            result.append(word)\n\n    return result"}
{"task_id": "HumanEval/117", "solution": "def select_words(s, n):\n    \"\"\"Given a string s and a natural number n, this function returns a list of words from s\n    that contain exactly n consonants, preserving their original order.\n    \"\"\"\n    if not s:\n        return []\n\n    # Define VOWELS directly within the function scope.\n    VOWELS = {'a', 'e', 'i', 'o', 'u'}\n\n    def is_consonant(char: str) -> bool:\n        \"\"\"Determines if a character is a consonant, based on the VOWELS set.\"\"\"\n        char_lower = char.lower()\n        return 'a' <= char_lower <= 'z' and char_lower not in VOWELS\n\n    def count_consonants(word: str) -> int:\n        \"\"\"Counts the number of consonants in a given word using the inline is_consonant helper.\"\"\"\n        count = 0\n        for char in word:\n            if is_consonant(char):\n                count += 1\n        return count\n\n    words = s.split()\n    result = []\n    for word in words:\n        if count_consonants(word) == n:\n            result.append(word)\n    return result"}
{"task_id": "HumanEval/114", "solution": "def minSubArraySum(nums):\n    \"\"\"\n    Given an array of integers nums, find the minimum sum of any non-empty sub-array.\n    This implementation uses a variant of Kadane's algorithm.\n    \"\"\"\n    min_so_far = nums[0]\n    current_min = nums[0]\n\n    for i in range(1, len(nums)):\n        current_min = min(nums[i], current_min + nums[i])\n        min_so_far = min(min_so_far, current_min)\n\n    return min_so_far"}
{"task_id": "HumanEval/118", "solution": "def get_closest_vowel(word):\n    \"\"\"\n    Finds the closest vowel that stands between two consonants from the right side of the word.\n    Vowels in the beginning and ending do not count.\n    \"\"\"\n    VOWELS = \"aeiouAEIOU\"\n\n    def _is_vowel(char: str) -> bool:\n        \"\"\"Checks if a character is a vowel.\"\"\"\n        return char in VOWELS\n\n    def _is_consonant(char: str) -> bool:\n        \"\"\"Checks if a character is a consonant.\"\"\"\n        return char.isalpha() and not _is_vowel(char)\n\n    n = len(word)\n    if n < 3:  # A vowel needs at least one consonant on each side.\n        return \"\"\n\n    # Iterate from right to left, ensuring valid indices for surrounding characters.\n    # The loop range (n - 2, 0, -1) starts from the second-to-last character's index\n    # and ends at the second character's index (index 1).\n    for i in range(n - 2, 0, -1):\n        current_char = word[i]\n        left_char = word[i - 1]\n        right_char = word[i + 1]\n\n        if _is_vowel(current_char) and _is_consonant(left_char) and _is_consonant(right_char):\n            return current_char  # Return the vowel, preserving its original case.\n\n    return \"\"  # Return empty string if no such vowel is found."}
{"task_id": "HumanEval/119", "solution": "def is_balanced(s: str) -> bool:\n    \"\"\"Checks if the input string `s` has balanced parentheses.\n    It uses a counter to track balance and returns True if balanced, False otherwise.\n    \"\"\"\n    count = 0\n    for char in s:\n        if char == '(':\n            count += 1\n        elif char == ')':\n            count -= 1\n        if count < 0:\n            return False\n    return count == 0\ndef match_parens(lst: list[str]) -> str:\n    \"\"\"\n    You are given a list of two strings, both strings consist of open\n    parentheses '(' or close parentheses ')' only.\n    Your job is to check if it is possible to concatenate the two strings in\n    some order, that the resulting string will be good.\n    A string S is considered to be good if and only if all parentheses in S\n    are balanced. For example: the string '(())()' is good, while the string\n    '())' is not.\n    Return 'Yes' if there's a way to make a good string, and return 'No' otherwise.\n    \"\"\"\n    s1, s2 = lst[0], lst[1]\n\n    # Try s1 + s2\n    combined_s1 = s1 + s2\n    if is_balanced(combined_s1):\n        return 'Yes'\n\n    # Try s2 + s1\n    combined_s2 = s2 + s1\n    if is_balanced(combined_s2):\n        return 'Yes'\n\n    return 'No'"}
{"task_id": "HumanEval/119", "solution": "class ParenthesesChecker:\n    \"\"\"Utility to check if a single string of parentheses is balanced.\n    It maintains a balance counter while iterating through the string.\"\"\"\n    def is_balanced(self, s: str) -> bool:\n        balance = 0\n        for char in s:\n            if char == '(':\n                balance += 1\n            elif char == ')':\n                balance -= 1\n            if balance < 0:\n                return False\n        return balance == 0\nclass MatchParensService:\n    \"\"\"Service to orchestrate checking concatenations of two strings.\n    It uses ParenthesesChecker to determine balance.\"\"\"\n    def __init__(self):\n        self._parentheses_checker = ParenthesesChecker()\n\n    def check_concatenations(self, s1: str, s2: str) -> str:\n        # Check s1 + s2\n        if self._parentheses_checker.is_balanced(s1 + s2):\n            return 'Yes'\n\n        # Check s2 + s1\n        if self._parentheses_checker.is_balanced(s2 + s1):\n            return 'Yes'\n\n        return 'No'\ndef match_parens(lst: list[str]) -> str:\n    \"\"\"\n    You are given a list of two strings, both strings consist of open\n    parentheses '(' or close parentheses ')' only.\n    Your job is to check if it is possible to concatenate the two strings in\n    some order, that the resulting string will be good.\n    A string S is considered to be good if and only if all parentheses in S\n    are balanced. For example: the string '(())()' is good, while the string\n    '())' is not.\n    Return 'Yes' if there's a way to make a good string, and return 'No' otherwise.\n\n    Examples:\n    match_parens(['()(', ')']) == 'Yes'\n    match_parens([')', ')']) == 'No'\n    \"\"\"\n    s1, s2 = lst[0], lst[1]\n\n    service = MatchParensService()\n    return service.check_concatenations(s1, s2)"}
{"task_id": "HumanEval/116", "solution": "def sort_array(arr):\n    \"\"\"\n    Sorts an array of integers primarily by the count of set bits and secondarily by decimal value.\n    Non-negative integers are sorted by bit count; negative integers are sorted by decimal value only.\n    \"\"\"\n\n    def _count_set_bits(n: int) -> int:\n        # Implements Brian Kernighan's algorithm to count set bits for non-negative integers.\n        count = 0\n        while n > 0:\n            n &= (n - 1)\n            count += 1\n        return count\n\n    def custom_sort_key(num: int):\n        # Generates a sorting key based on the number's sign.\n        # Negative numbers are grouped by a -1 'bit count' for decimal sort; non-negative by actual bit count.\n        if num < 0:\n            return (-1, num)\n        else:\n            return (_count_set_bits(num), num)\n\n    return sorted(arr, key=custom_sort_key)"}
{"task_id": "HumanEval/118", "solution": "def get_closest_vowel(word):\n    \"\"\"Finds the closest vowel that stands between two consonants from the right side of the word.\n    Returns an empty string if no such vowel is found.\n    \"\"\"\n    VOWELS_LOWER = \"aeiou\"\n\n    def is_vowel(char: str) -> bool:\n        # Checks if a character is an English vowel (case-insensitive).\n        return char.lower() in VOWELS_LOWER\n\n    def is_consonant(char: str) -> bool:\n        # Checks if a character is an English consonant (case-insensitive).\n        return char.isalpha() and not is_vowel(char)\n\n    n = len(word)\n    # A word needs at least 3 characters for a vowel to be between two consonants.\n    if n < 3:\n        return \"\"\n\n    # Iterate from right to left, excluding the first and last characters (indices 0 and n-1).\n    # The valid range for the vowel's index `i` is from `n-2` down to `1`.\n    for i in range(n - 2, 0, -1):\n        current_char = word[i]\n        prev_char = word[i - 1]\n        next_char = word[i + 1]\n\n        # Check if current_char is a vowel and surrounded by two consonants.\n        if (is_vowel(current_char) and\n                is_consonant(prev_char) and\n                is_consonant(next_char)):\n            return current_char\n\n    return \"\""}
{"task_id": "HumanEval/121", "solution": "def solution(lst):\n    \"\"\"Given a non-empty list of integers, return the sum of all of the odd elements that are in even positions.\n    \"\"\"\n    total_sum = 0\n    for i, element in enumerate(lst):\n        # Check if the position (index) is even and the element itself is odd.\n        if i % 2 == 0 and element % 2 != 0:\n            total_sum += element\n    return total_sum"}
{"task_id": "HumanEval/120", "solution": "def maximum(arr, k):\n    \"\"\"\n    Given an array arr of integers and a non-negative integer k, return a sorted list\n    of length k with the maximum k numbers in arr.\n    \"\"\"\n    if k == 0:\n        return []\n\n    # Create a sorted copy of the array in descending order.\n    # This identifies the largest elements efficiently.\n    sorted_arr_desc = sorted(arr, reverse=True)\n\n    # Extract the top k elements from the descendingly sorted list.\n    top_k_elements = sorted_arr_desc[:k]\n\n    # Sort these k elements in ascending order as required by the specification.\n    top_k_elements.sort()\n\n    return top_k_elements"}
{"task_id": "HumanEval/121", "solution": "def solution(lst):\n    \"\"\"Given a non-empty list of integers, return the sum of all of the odd elements\n    that are in even positions.\n\n\n    Examples\n    solution([5, 8, 7, 1]) ==> 12\n    solution([3, 3, 3, 3, 3]) ==> 9\n    solution([30, 13, 24, 321]) ==>0\n    \"\"\"\n    total_sum = 0\n    for i, num in enumerate(lst):\n        # Check if the position (index) is even and the element is odd\n        if i % 2 == 0 and num % 2 != 0:\n            total_sum += num\n    return total_sum"}
{"task_id": "HumanEval/120", "solution": "import heapq\ndef maximum(arr, k):\n    \"\"\"\n    Given an array arr of integers and a positive integer k, return a sorted list\n    of length k with the maximum k numbers in arr.\n\n    Example 1:\n\n        Input: arr = [-3, -4, 5], k = 3\n        Output: [-4, -3, 5]\n\n    Example 2:\n\n        Input: arr = [4, -4, 4], k = 2\n        Output: [4, 4]\n\n    Example 3:\n\n        Input: arr = [-3, 2, 1, 2, -1, -2, 1], k = 1\n        Output: [2]\n\n    Note:\n        1. The length of the array will be in the range of [1, 1000].\n        2. The elements in the array will be in the range of [-1000, 1000].\n        3. 0 <= k <= len(arr)\n    \"\"\"\n    if k == 0:\n        return []\n\n    min_heap = []\n\n    for num in arr:\n        if len(min_heap) < k:\n            heapq.heappush(min_heap, num)\n        elif num > min_heap[0]:\n            heapq.heapreplace(min_heap, num)\n\n    return sorted(min_heap)"}
{"task_id": "HumanEval/122", "solution": "def add_elements(arr, k):\n    \"\"\"\n    Given a non-empty array of integers arr and an integer k, return\n    the sum of the elements with at most two digits from the first k elements of arr.\n    \"\"\"\n    current_sum = 0\n    for i in range(k):\n        element = arr[i]\n        if abs(element) <= 99:\n            current_sum += element\n    return current_sum"}
