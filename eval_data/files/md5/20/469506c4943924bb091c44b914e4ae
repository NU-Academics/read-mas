{"task_id": "HumanEval/137", "solution": "def compare_one(a, b):\n    \"\"\"\n    Compares two values and returns the larger in its original type, or None if equal.\n    Handles integers, floats, and strings representing real numbers with ',' or '.' decimals.\n    \"\"\"\n    def _to_numeric_internal(value):\n        # Converts a value to float for comparison, handling string decimal separators.\n        # This processes int, float, and string representations correctly.\n        return float(str(value).replace(',', '.'))\n\n    numeric_a = _to_numeric_internal(a)\n    numeric_b = _to_numeric_internal(b)\n\n    if numeric_a > numeric_b:\n        return a\n    elif numeric_b > numeric_a:\n        return b\n    else:\n        return None"}
{"task_id": "HumanEval/136", "solution": "from typing import List, Optional, Tuple\nclass Result:\n    \"\"\"\n    A data transfer object to hold the largest negative and smallest positive integers.\n    \"\"\"\n    def __init__(self, largest_negative: Optional[int], smallest_positive: Optional[int]):\n        self.largest_negative = largest_negative\n        self.smallest_positive = smallest_positive\nclass IntegerFinder:\n    \"\"\"\n    Encapsulates the logic for finding the largest negative and smallest positive integers.\n    \"\"\"\n    def find(self, lst: List[int]) -> Result:\n        largest_neg: Optional[int] = None\n        smallest_pos: Optional[int] = None\n\n        for num in lst:\n            if num < 0:\n                if largest_neg is None or num > largest_neg:\n                    largest_neg = num\n            elif num > 0:\n                if smallest_pos is None or num < smallest_pos:\n                    smallest_pos = num\n\n        return Result(largest_neg, smallest_pos)\ndef largest_smallest_integers(lst: List[int]) -> Tuple[Optional[int], Optional[int]]:\n    \"\"\"\n    Create a function that returns a tuple (a, b), where 'a' is\n    the largest of negative integers, and 'b' is the smallest\n    of positive integers in a list. If there is no negative or positive integers, return them as None.\n    \"\"\"\n    finder = IntegerFinder()\n    result = finder.find(lst)\n    return (result.largest_negative, result.smallest_positive)"}
{"task_id": "HumanEval/135", "solution": "def can_arrange(arr):\n    \"\"\"\n    Finds the largest index i where arr[i] is less than arr[i-1].\n    Returns -1 if no such index exists or the list has fewer than two elements.\n    \"\"\"\n    if len(arr) < 2:\n        return -1\n\n    # Iterate from the second-to-last element down to the second element (index 1)\n    for i in range(len(arr) - 1, 0, -1):\n        if arr[i] < arr[i-1]:\n            return i\n    return -1"}
{"task_id": "HumanEval/137", "solution": "def compare_one(a, b):\n    \"\"\"\n    Compares two values (int, float, or string representing a real number) and returns the numerically larger variable in its original type.\n    Returns None if the values are numerically equal.\n    \"\"\"\n    # Convert both values to float, handling string representations with comma or dot decimal separators.\n    # This relies on Python's built-in str() and float() to handle type conversion.\n    float_a = float(str(a).replace(',', '.'))\n    float_b = float(str(b).replace(',', '.'))\n\n    if float_a > float_b:\n        return a\n    elif float_b > float_a:\n        return b\n    else:\n        return None"}
{"task_id": "HumanEval/139", "solution": "def special_factorial(n):\n    \"\"\"Calculates the special factorial of a positive integer n.\n    This function computes n! * (n-1)! * ... * 1!.\n    \"\"\"\n    def factorial(k):\n        \"\"\"Calculates the factorial of a non-negative integer k.\"\"\"\n        if k == 0:\n            return 1\n        res = 1\n        for i in range(1, k + 1):\n            res *= i\n        return res\n\n    result = 1\n    for i in range(1, n + 1):\n        result *= factorial(i)\n    return result"}
{"task_id": "HumanEval/139", "solution": "def special_factorial(n):\n    \"\"\"The Brazilian factorial is defined as:\n    brazilian_factorial(n) = n! * (n-1)! * (n-2)! * ... * 1!\n    where n > 0\n\n    For example:\n    >>> special_factorial(4)\n    288\n\n    The function will receive an integer as input and should return the special\n    factorial of this integer.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"Input must be an integer for special_factorial.\")\n    if n <= 0:\n        raise ValueError(\"Input must be a positive integer for special_factorial.\")\n\n    def factorial(k):\n        \"\"\"Calculates the standard factorial of a non-negative integer k.\"\"\"\n        # No need for isinstance(k, int) and k < 0 checks here\n        # because 'k' will always be a positive integer from the loop range\n        # of special_factorial (1 to n).\n        # Also, the special_factorial already validates 'n' is a positive integer.\n        res = 1\n        for i in range(1, k + 1):\n            res *= i\n        return res\n\n    special_fact_result = 1\n    for i in range(1, n + 1):\n        special_fact_result *= factorial(i)\n    return special_fact_result"}
{"task_id": "HumanEval/138", "solution": "def is_equal_to_sum_even(n):\n    \"\"\"\n    Evaluates if n can be written as the sum of exactly 4 positive even numbers.\n    The sum of four positive even numbers must be even and at least 8 (2+2+2+2).\n    \"\"\"\n    if n % 2 != 0:\n        return False\n\n    if n < 8:\n        return False\n\n    return True"}
{"task_id": "HumanEval/140", "solution": "import re\ndef fix_spaces(text: str) -> str:\n    \"\"\"\n    Replaces spaces in the input string with underscores or hyphens based on the number of consecutive spaces.\n    Sequences of three or more spaces become a hyphen, exactly two become two underscores, and single spaces become an underscore.\n    \"\"\"\n    # Replace 3 or more consecutive spaces with a hyphen\n    text = re.sub(r' {3,}', '-', text)\n    # Replace exactly two consecutive spaces with two underscores\n    text = re.sub(r' {2}', '__', text)\n    # Replace single spaces with an underscore\n    text = re.sub(r' ', '_', text)\n    return text"}
{"task_id": "HumanEval/140", "solution": "import re\ndef fix_spaces(text):\n    \"\"\"\n    Given a string text, replace all spaces in it with underscores,\n    and if a string has more than 2 consecutive spaces,\n    then replace all consecutive spaces with -\n\n    fix_spaces(\"Example\") == \"Example\"\n    fix_spaces(\"Example 1\") == \"Example_1\"\n    fix_spaces(\" Example 2\") == \"_Example_2\"\n    fix_spaces(\" Example   3\") == \"_Example-3\"\n    \"\"\"\n    # First, replace sequences of three or more spaces with a single hyphen.\n    # This prioritizes handling longer space sequences before single spaces.\n    fixed_text = re.sub(r' {3,}', '-', text)\n\n    # Then, replace any remaining single spaces with underscores.\n    # This also handles sequences of exactly two spaces (e.g., \"  \" -> \"__\").\n    fixed_text = fixed_text.replace(' ', '_')\n\n    return fixed_text"}
{"task_id": "HumanEval/141", "solution": "def file_name_check(file_name):\n    \"\"\"Checks if a file name is valid based on specific rules.\n    Returns 'Yes' for valid names, 'No' otherwise.\"\"\"\n\n    ALLOWED_EXTENSIONS = ['txt', 'exe', 'dll']\n\n    # Rule: Not more than three digits ('0'-'9') in the file's name.\n    digit_count = sum(1 for char in file_name if '0' <= char <= '9')\n    if digit_count > 3:\n        return 'No'\n\n    # Rule: The file's name contains exactly one dot '.'\n    if file_name.count('.') != 1:\n        return 'No'\n\n    # Split the file name into prefix and suffix\n    parts = file_name.split('.', 1)\n    prefix = parts[0]\n    suffix = parts[1]\n\n    # Rule: The substring before the dot should not be empty.\n    if not prefix:\n        return 'No'\n\n    # Rule: The substring before the dot should start with a letter.\n    if not prefix[0].isalpha():\n        return 'No'\n\n    # Rule: The substring after the dot should be one of the allowed extensions.\n    if suffix not in ALLOWED_EXTENSIONS:\n        return 'No'\n\n    # If all validation conditions are met, the file name is valid.\n    return 'Yes'"}
{"task_id": "HumanEval/141", "solution": "def file_name_check(file_name):\n    \"\"\"Checks if a file name is valid based on specific criteria.\n    Returns 'Yes' if valid, 'No' otherwise.\"\"\"\n\n    # Rule: There should not be more than three digits ('0'-'9')\n    digit_count = 0\n    for char in file_name:\n        if char.isdigit():\n            digit_count += 1\n    if digit_count > 3:\n        return 'No'\n\n    # Rule: The file's name contains exactly one dot '.'\n    if file_name.count('.') != 1:\n        return 'No'\n\n    # Split the file name into prefix and extension\n    parts = file_name.split('.', 1)\n    prefix = parts[0]\n    extension = parts[1]\n\n    # Rule: The substring before the dot should not be empty\n    if not prefix:\n        return 'No'\n\n    # Rule: The substring before the dot starts with a letter from the latin alphabet\n    if not prefix[0].isalpha():\n        return 'No'\n\n    # Rule: The substring after the dot should be one of these: ['txt', 'exe', 'dll']\n    allowed_extensions = ['txt', 'exe', 'dll']\n    if extension not in allowed_extensions:\n        return 'No'\n\n    # If all conditions are met\n    return 'Yes'"}
{"task_id": "HumanEval/142", "solution": "def sum_squares(lst):\n    \"\"\"\n    Calculates a sum from a list of integers, applying index-dependent transformations.\n    Squares elements at indices that are multiples of 3, cubes elements at indices that are multiples of 4 (but not 3), and leaves others unchanged.\n    \"\"\"\n    if not lst:\n        return 0\n\n    transformed_sum = 0\n    for i, x in enumerate(lst):\n        if i % 3 == 0:\n            transformed_sum += x * x\n        elif i % 4 == 0:\n            transformed_sum += x * x * x\n        else:\n            transformed_sum += x\n    return transformed_sum"}
{"task_id": "HumanEval/143", "solution": "def words_in_sentence(sentence):\n    \"\"\"\n    Filters words from a sentence whose lengths are prime numbers.\n    Preserves the original order of words.\n    \"\"\"\n\n    def is_prime(number: int) -> bool:\n        if number <= 1:\n            return False\n        if number <= 3:\n            return True\n        if number % 2 == 0 or number % 3 == 0:\n            return False\n        i = 5\n        while i * i <= number:\n            if number % i == 0 or number % (i + 2) == 0:\n                return False\n            i += 6\n        return True\n\n    if not sentence:\n        return \"\"\n\n    words = sentence.split(' ')\n    filtered_words = []\n\n    for word in words:\n        if is_prime(len(word)):\n            filtered_words.append(word)\n\n    return \" \".join(filtered_words)"}
{"task_id": "HumanEval/143", "solution": "def words_in_sentence(sentence):\n    \"\"\"\n    Filters words from a sentence, returning only those whose lengths are prime numbers.\n    The order of words is maintained.\n    \"\"\"\n\n    def _is_prime(n: int) -> bool:\n        \"\"\"\n        Checks if an integer is a prime number.\n        Returns True if prime, False otherwise.\n        \"\"\"\n        if n < 2:\n            return False\n        for i in range(2, int(n**0.5) + 1):\n            if n % i == 0:\n                return False\n        return True\n\n    words = sentence.split()\n    filtered_words = []\n    for word in words:\n        if _is_prime(len(word)):\n            filtered_words.append(word)\n    return \" \".join(filtered_words)"}
{"task_id": "HumanEval/142", "solution": "def sum_squares(lst):\n    \"\"\"\n    Calculates a specific sum of integers from a list based on index transformations.\n    Entries are squared if their index is a multiple of 3, cubed if a multiple of 4 (but not 3).\n    \"\"\"\n    if not lst:\n        return 0\n\n    transformed_elements = []\n    for index, value in enumerate(lst):\n        if index % 3 == 0:\n            # Square the value if index is a multiple of 3.\n            transformed_elements.append(value * value)\n        elif index % 4 == 0:\n            # Cube the value if index is a multiple of 4 and not a multiple of 3.\n            transformed_elements.append(value * value * value)\n        else:\n            # Keep the value unchanged for other indices.\n            transformed_elements.append(value)\n\n    return sum(transformed_elements)"}
{"task_id": "HumanEval/144", "solution": "class Fraction:\n    def __init__(self, numerator: int, denominator: int):\n        self.numerator = numerator\n        self.denominator = denominator\n\n    def multiply(self, other: 'Fraction') -> 'Fraction':\n        \"\"\"Multiplies this fraction by another fraction and returns the product.\"\"\"\n        new_numerator = self.numerator * other.numerator\n        new_denominator = self.denominator * other.denominator\n        return Fraction(new_numerator, new_denominator)\n\n    def is_whole_number(self) -> bool:\n        \"\"\"Checks if the fraction represents a whole number.\"\"\"\n        return self.numerator % self.denominator == 0\n\n    def __repr__(self) -> str:\n        return f\"Fraction({self.numerator}/{self.denominator})\"\nclass FractionParser:\n    @staticmethod\n    def parse_fraction(fraction_str: str) -> Fraction:\n        \"\"\"Parses a fraction string into a Fraction object.\"\"\"\n        parts = fraction_str.split('/')\n        numerator = int(parts[0])\n        denominator = int(parts[1])\n        return Fraction(numerator, denominator)\nclass FractionService:\n    def simplify(self, x_str: str, n_str: str) -> bool:\n        \"\"\"Orchestrates parsing, multiplication, and whole number check for two fraction strings.\"\"\"\n        frac_x = FractionParser.parse_fraction(x_str)\n        frac_n = FractionParser.parse_fraction(n_str)\n\n        product_frac = frac_x.multiply(frac_n)\n\n        return product_frac.is_whole_number()\ndef simplify(x: str, n: str) -> bool:\n    \"\"\"Determines if the product of two fraction strings is a whole number.\"\"\"\n    service = FractionService()\n    return service.simplify(x, n)"}
{"task_id": "HumanEval/145", "solution": "def _sum_digits(n: int) -> int:\n    \"\"\"\n    Calculates the sum of the absolute digits of an integer.\n    For example: _sum_digits(-12) == 3\n    \"\"\"\n    s = 0\n    n = abs(n)\n    while n > 0:\n        s += n % 10\n        n //= 10\n    return s\ndef order_by_points(nums: list[int]) -> list[int]:\n    \"\"\"\n    Sorts the given list of integers in ascending order according to the sum of their digits.\n    Note: if there are several items with similar sum of their digits,\n    order them based on their index in original list.\n    \"\"\"\n    if not nums:\n        return []\n\n    decorated_list = []\n    for i, num in enumerate(nums):\n        decorated_list.append((_sum_digits(num), i, num))\n\n    decorated_list.sort()\n\n    return [item[2] for item in decorated_list]"}
{"task_id": "HumanEval/144", "solution": "class Fraction:\n    def __init__(self, numerator, denominator):\n        # Initializes a fraction with given numerator and denominator.\n        # Assumes valid integer inputs and non-zero denominator.\n        self._numerator = numerator\n        self._denominator = denominator\n\n    @property\n    def numerator(self):\n        return self._numerator\n\n    @property\n    def denominator(self):\n        return self._denominator\n\n    @staticmethod\n    def from_string(fraction_str):\n        # Parses a string into a Fraction object.\n        # Assumes fraction_str is in \"numerator/denominator\" format with valid integers.\n        parts = fraction_str.split('/')\n        numerator = int(parts[0])\n        denominator = int(parts[1])\n        return Fraction(numerator, denominator)\n\n    def multiply(self, other):\n        # Multiplies this fraction by another fraction.\n        # Returns a new Fraction object representing the product.\n        new_numerator = self.numerator * other.numerator\n        new_denominator = self.denominator * other.denominator\n        return Fraction(new_numerator, new_denominator)\n\n    def is_whole_number(self):\n        # Checks if the fraction represents a whole number.\n        # Returns True if numerator is perfectly divisible by denominator.\n        return self.numerator % self.denominator == 0\n\n    def __repr__(self):\n        return f\"Fraction({self.numerator}/{self.denominator})\"\ndef simplify(x, n):\n    # Parses two fraction strings, multiplies them, and checks if the product is a whole number.\n    # Assumes valid fraction string inputs as specified.\n    x_fraction = Fraction.from_string(x)\n    n_fraction = Fraction.from_string(n)\n\n    product_fraction = x_fraction.multiply(n_fraction)\n\n    return product_fraction.is_whole_number()"}
{"task_id": "HumanEval/145", "solution": "def order_by_points(nums):\n    \"\"\"\n    Sorts a list of integers by the sum of their digits, using original index for tie-breaking.\n    \"\"\"\n\n    def _sum_digits(n: int) -> int:\n        \"\"\"Calculates the sum of the absolute values of the digits of an integer.\"\"\"\n        s = 0\n        n_abs = abs(n)\n        while n_abs > 0:\n            s += n_abs % 10\n            n_abs //= 10\n        return s\n\n    decorated_list = []\n    for i, num in enumerate(nums):\n        digit_sum = _sum_digits(num)\n        decorated_list.append((digit_sum, i, num))\n\n    decorated_list.sort()\n\n    return [item[2] for item in decorated_list]"}
{"task_id": "HumanEval/146", "solution": "ODD_DIGITS = {1, 3, 5, 7, 9}\ndef _is_odd(digit: int) -> bool:\n    \"\"\"Checks if a given digit is odd.\"\"\"\n    return digit in ODD_DIGITS\ndef _get_first_digit(num: int) -> int:\n    \"\"\"Extracts the first digit of a number (absolute value).\"\"\"\n    abs_num = abs(num)\n    if abs_num == 0:\n        return 0\n    while abs_num >= 10:\n        abs_num //= 10\n    return abs_num\ndef _get_last_digit(num: int) -> int:\n    \"\"\"Extracts the last digit of a number (absolute value).\"\"\"\n    return abs(num) % 10\ndef specialFilter(nums: list[int]) -> int:\n    \"\"\"\n    Counts numbers greater than 10 where both first and last digits are odd.\n    Applies filtering logic to an array of integers.\n    \"\"\"\n    count = 0\n    for num in nums:\n        # Check if the number is strictly greater than 10\n        if num > 10:\n            first_digit = _get_first_digit(num)\n            last_digit = _get_last_digit(num)\n\n            # Check if both first and last digits are odd\n            if _is_odd(first_digit) and _is_odd(last_digit):\n                count += 1\n    return count"}
{"task_id": "HumanEval/147", "solution": "def get_max_triples(n):\n    \"\"\"\n    Calculates the number of triples (a[i], a[j], a[k]) from the array `a`\n    such that their sum is a multiple of 3, for 1 <= i < j < k <= n.\n    \"\"\"\n    remainder_counts = [0, 0, 0] # Stores counts for remainders 0, 1, 2\n\n    for i in range(1, n + 1):\n        # Calculate a[i] = i*i - i + 1\n        element = i * i - i + 1\n        remainder_counts[element % 3] += 1\n\n    count0 = remainder_counts[0]\n    count1 = remainder_counts[1]\n    count2 = remainder_counts[2]\n\n    total_triples = 0\n\n    # Combinations where all three elements have remainder 0\n    if count0 >= 3:\n        total_triples += (count0 * (count0 - 1) * (count0 - 2)) // 6\n\n    # Combinations where all three elements have remainder 1\n    if count1 >= 3:\n        total_triples += (count1 * (count1 - 1) * (count1 - 2)) // 6\n\n    # Combinations where all three elements have remainder 2\n    if count2 >= 3:\n        total_triples += (count2 * (count2 - 1) * (count2 - 2)) // 6\n\n    # Combinations where elements have remainders 0, 1, and 2\n    total_triples += count0 * count1 * count2\n\n    return total_triples"}
{"task_id": "HumanEval/147", "solution": "def get_max_triples(n: int) -> int:\n    \"\"\"\n    Counts triples (a[i], a[j], a[k]) from a generated array such that i < j < k and their sum is a multiple of 3.\n    The array element a[i] is defined as i * i - i + 1.\n    \"\"\"\n    if n < 3:\n        return 0\n\n    # Counts of numbers in the array whose value modulo 3 is 0, 1, or 2.\n    # a[i] = i*i - i + 1\n    # Observe the pattern of a[i] % 3 based on i % 3:\n    # If i % 3 == 0: a[i] % 3 = (0*0 - 0 + 1) % 3 = 1\n    # If i % 3 == 1: a[i] % 3 = (1*1 - 1 + 1) % 3 = 1\n    # If i % 3 == 2: a[i] % 3 = (2*2 - 2 + 1) % 3 = 3 % 3 = 0\n    # So, a[i] % 3 is 0 if i % 3 == 2, and 1 otherwise.\n    counts = [0, 0, 0]  # counts[0] for remainder 0, counts[1] for remainder 1, counts[2] for remainder 2\n\n    for i in range(1, n + 1):\n        if i % 3 == 2:\n            counts[0] += 1  # a[i] % 3 == 0\n        else:\n            counts[1] += 1  # a[i] % 3 == 1\n\n    count0 = counts[0]\n    count1 = counts[1]\n    count2 = counts[2]\n\n    total_triples = 0\n\n    # Case 1: (0, 0, 0) - sum is multiple of 3\n    # Number of ways to choose 3 items from count0 items\n    if count0 >= 3:\n        total_triples += (count0 * (count0 - 1) * (count0 - 2)) // 6\n\n    # Case 2: (1, 1, 1) - sum is multiple of 3\n    # Number of ways to choose 3 items from count1 items\n    if count1 >= 3:\n        total_triples += (count1 * (count1 - 1) * (count1 - 2)) // 6\n\n    # Case 3: (2, 2, 2) - sum is multiple of 3\n    # Number of ways to choose 3 items from count2 items\n    if count2 >= 3:\n        total_triples += (count2 * (count2 - 1) * (count2 - 2)) // 6\n\n    # Case 4: (0, 1, 2) - sum is multiple of 3\n    # Number of ways to choose 1 item from each group\n    total_triples += count0 * count1 * count2\n\n    return total_triples"}
{"task_id": "HumanEval/148", "solution": "def bf(planet1, planet2):\n    \"\"\"\n    Returns a tuple of planets whose orbits are between planet1 and planet2, sorted by proximity to the sun.\n    Returns an empty tuple if planet1 or planet2 are not correct planet names.\n    \"\"\"\n    SOLAR_SYSTEM_PLANETS = [\n        \"Mercury\", \"Venus\", \"Earth\", \"Mars\",\n        \"Jupiter\", \"Saturn\", \"Uranus\", \"Neptune\"\n    ]\n\n    idx1 = None\n    try:\n        idx1 = SOLAR_SYSTEM_PLANETS.index(planet1)\n    except ValueError:\n        pass\n\n    idx2 = None\n    try:\n        idx2 = SOLAR_SYSTEM_PLANETS.index(planet2)\n    except ValueError:\n        pass\n\n    if idx1 is None or idx2 is None:\n        return ()\n\n    start_idx = min(idx1, idx2)\n    end_idx = max(idx1, idx2)\n\n    if end_idx - start_idx <= 1:\n        return ()\n\n    return tuple(SOLAR_SYSTEM_PLANETS[start_idx + 1:end_idx])"}
{"task_id": "HumanEval/149", "solution": "def sorted_list_sum(lst):\n    \"\"\"Filters strings by even length, then sorts them by length and alphabetically.\"\"\"\n    # Filter out strings with odd lengths based on FR2.\n    even_length_strings = [s for s in lst if len(s) % 2 == 0]\n\n    # Sort the remaining strings primarily by length (ascending) and secondarily alphabetically (ascending)\n    # This addresses FR3 and FR4 using a tuple as the sort key.\n    sorted_list = sorted(even_length_strings, key=lambda s: (len(s), s))\n\n    return sorted_list"}
{"task_id": "HumanEval/148", "solution": "def bf(planet1, planet2):\n    \"\"\"\n    Identifies planets located between two specified planets, sorted by proximity to the Sun.\n    Returns an empty tuple if planet names are invalid or no planets are between.\n    \"\"\"\n    PLANET_ORDER = [\n        \"Mercury\", \"Venus\", \"Earth\", \"Mars\", \"Jupiter\", \"Saturn\", \"Uranus\", \"Neptune\"\n    ]\n\n    if planet1 not in PLANET_ORDER or planet2 not in PLANET_ORDER:\n        return ()\n\n    idx1 = PLANET_ORDER.index(planet1)\n    idx2 = PLANET_ORDER.index(planet2)\n\n    start_idx = min(idx1, idx2)\n    end_idx = max(idx1, idx2)\n\n    intermediate_planets = PLANET_ORDER[start_idx + 1:end_idx]\n\n    return tuple(intermediate_planets)"}
{"task_id": "HumanEval/149", "solution": "def sorted_list_sum(lst):\n    \"\"\"Filters a list of strings by removing odd-length strings, then sorts\n    the remaining by length and alphabetically for ties.\"\"\"\n    even_length_strings = [s for s in lst if len(s) % 2 == 0]\n    sorted_list = sorted(even_length_strings, key=lambda s: (len(s), s))\n    return sorted_list"}
{"task_id": "HumanEval/150", "solution": "import math\ndef is_prime(n):\n    \"\"\"Checks if an integer n is a prime number.\n    Assumes n is an integer; no explicit type checking or error handling is performed within this helper.\n    \"\"\"\n    if n < 2:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n    # Check for odd divisors from 3 up to sqrt(n)\n    for i in range(3, int(math.sqrt(n)) + 1, 2):\n        if n % i == 0:\n            return False\n    return True\ndef x_or_y(n, x, y):\n    \"\"\"A simple program which should return the value of x if n is\n    a prime number and should return the value of y otherwise.\n\n    Examples:\n    for x_or_y(7, 34, 12) == 34\n    for x_or_y(15, 8, 5) == 5\n\n    \"\"\"\n    if is_prime(n):\n        return x\n    else:\n        return y"}
{"task_id": "HumanEval/146", "solution": "def specialFilter(nums):\n    \"\"\"Counts numbers greater than 10 where their first (absolute) and last digits are both odd.\n    Handles integers and floats, interpreting digits as per the problem's rules.\n    \"\"\"\n\n    def _get_first_digit(number):\n        \"\"\"Extracts the first digit of a number (absolute value), considering the integer part for floats.\"\"\"\n        s_num = str(abs(number))\n        if '.' in s_num:\n            s_num = s_num.split('.')[0]\n        return int(s_num[0])\n\n    def _get_last_digit(number):\n        \"\"\"Extracts the last digit of a number. For floats, uses the fractional part if present, otherwise the integer part.\"\"\"\n        s_num = str(number)\n        if '.' in s_num:\n            parts = s_num.split('.')\n            fractional_part = parts[1]\n            if fractional_part:\n                return int(fractional_part[-1])\n            else:\n                # Handle cases like '10.' where there's no explicit fractional part after the dot\n                # Fallback to the last digit of the integer part\n                return int(parts[0][-1])\n        return int(s_num[-1])\n\n    count = 0\n    for number in nums:\n        is_greater_than_ten = number > 10\n\n        first_digit = _get_first_digit(number)\n        is_first_digit_odd = first_digit in {1, 3, 5, 7, 9}\n\n        last_digit = _get_last_digit(number)\n        is_last_digit_odd = last_digit in {1, 3, 5, 7, 9}\n\n        if is_greater_than_ten and is_first_digit_odd and is_last_digit_odd:\n            count += 1\n\n    return count"}
{"task_id": "HumanEval/151", "solution": "def double_the_difference(lst):\n    '''\n    Given a list of numbers, return the sum of squares of the numbers\n    in the list that are odd. Ignore numbers that are negative or not integers.\n    '''\n    total_sum_of_squares = 0\n    for num in lst:\n        # Check if the number is an integer, positive, and odd.\n        if isinstance(num, int) and num > 0 and num % 2 != 0:\n            total_sum_of_squares += num * num\n    return total_sum_of_squares"}
{"task_id": "HumanEval/152", "solution": "def compare(game, guess):\n    \"\"\"Calculates the absolute difference between actual game scores and guessed scores.\n    Returns an array of these differences.\n    \"\"\"\n    differences = []\n    for i in range(len(game)):\n        differences.append(abs(game[i] - guess[i]))\n    return differences"}
{"task_id": "HumanEval/153", "solution": "class Extension:\n    \"\"\"Represents an extension with a name and its calculated strength.\"\"\"\n    def __init__(self, name: str, strength: int):\n        self._name = name\n        self._strength = strength\n\n    def get_name(self) -> str:\n        \"\"\"Returns the name of the extension.\"\"\"\n        return self._name\n\n    def get_strength(self) -> int:\n        \"\"\"Returns the strength of the extension.\"\"\"\n        return self._strength\nclass ExtensionStrengthCalculator:\n    \"\"\"Calculates the strength of an extension name based on character cases.\"\"\"\n    def calculate_strength(self, extension_name: str) -> int:\n        \"\"\"Calculates strength as (uppercase count - lowercase count).\"\"\"\n        cap_count = sum(1 for char in extension_name if 'A' <= char <= 'Z')\n        sm_count = sum(1 for char in extension_name if 'a' <= char <= 'z')\n        return cap_count - sm_count\nclass StrongestExtensionService:\n    \"\"\"Manages finding the strongest extension from a list.\"\"\"\n    def __init__(self, strength_calculator: ExtensionStrengthCalculator):\n        self._strength_calculator = strength_calculator\n\n    def find_strongest_extension(self, class_name: str, extensions: list[str]) -> str:\n        \"\"\"Finds the extension with the highest strength and formats the output.\"\"\"\n        strongest_extension_name = \"\"\n        max_strength = float('-inf')\n\n        for ext_name in extensions:\n            current_strength = self._strength_calculator.calculate_strength(ext_name)\n            _ = Extension(ext_name, current_strength) # Creates an Extension object as per design\n\n            if current_strength > max_strength:\n                max_strength = current_strength\n                strongest_extension_name = ext_name\n\n        return f\"{class_name}.{strongest_extension_name}\"\ndef Strongest_Extension(class_name: str, extensions: list[str]) -> str:\n    \"\"\"\n    Finds the strongest extension and returns it in ClassName.StrongestExtensionName format.\n    Strength is (uppercase count - lowercase count); first in list wins ties.\n    \"\"\"\n    calculator = ExtensionStrengthCalculator()\n    service = StrongestExtensionService(calculator)\n    return service.find_strongest_extension(class_name, extensions)"}
{"task_id": "HumanEval/151", "solution": "def double_the_difference(lst):\n    \"\"\"\n    Calculates the sum of squares of odd, positive integers from a list.\n    Non-integer, non-positive, and even numbers are ignored.\n    \"\"\"\n    total_sum_of_squares = 0\n    for item in lst:\n        # Check if the item is an integer.\n        if isinstance(item, int):\n            # Check if the integer is positive.\n            if item > 0:\n                # Check if the positive integer is odd.\n                if item % 2 != 0:\n                    # Square the number and add it to the total sum.\n                    total_sum_of_squares += item * item\n    return total_sum_of_squares"}
{"task_id": "HumanEval/152", "solution": "def compare(game, guess):\n    \"\"\"Compares actual game scores with user guesses. Returns a list of differences,\n    where 0 means a correct guess and the absolute difference otherwise.\"\"\"\n    differences = []\n    for i in range(len(game)):\n        if game[i] == guess[i]:\n            differences.append(0)\n        else:\n            differences.append(abs(game[i] - guess[i]))\n    return differences"}
{"task_id": "HumanEval/150", "solution": "import math\ndef x_or_y(n, x, y):\n    \"\"\"\n    Returns x if n is a prime number, and y otherwise.\n    Assumes n is an integer as per the problem statement.\n    \"\"\"\n\n    # Determine if n is prime based on FR1 and BR1\n    if n <= 1:\n        is_n_prime = False\n    elif n == 2:\n        is_n_prime = True\n    elif n % 2 == 0:\n        is_n_prime = False\n    else:\n        is_n_prime = True\n        # Iterate from 3 up to the square root of n, incrementing by 2\n        for i in range(3, int(math.sqrt(n)) + 1, 2):\n            if n % i == 0:\n                is_n_prime = False\n                break\n\n    # Return x or y based on the primality check result (FR2 and FR3)\n    if is_n_prime:\n        return x\n    else:\n        return y"}
{"task_id": "HumanEval/153", "solution": "class Extension:\n    def __init__(self, name: str, strength: int):\n        self.name = name\n        self.strength = strength\n\n    def get_name(self) -> str:\n        return self.name\n\n    def get_strength(self) -> int:\n        return self.strength\nclass ExtensionUtils:\n    @staticmethod\n    def calculate_strength(extension_name: str) -> int:\n        cap_count = sum(1 for char in extension_name if 'A' <= char <= 'Z')\n        sm_count = sum(1 for char in extension_name if 'a' <= char <= 'z')\n        return cap_count - sm_count\nclass ExtensionService:\n    @staticmethod\n    def find_strongest_extension(class_name: str, extensions: list[str]) -> str:\n        strongest_extension_obj = None\n        max_strength = -float('inf')\n\n        for ext_name in extensions:\n            current_strength = ExtensionUtils.calculate_strength(ext_name)\n            current_extension_obj = Extension(ext_name, current_strength)\n\n            if current_extension_obj.get_strength() > max_strength:\n                max_strength = current_extension_obj.get_strength()\n                strongest_extension_obj = current_extension_obj\n            # Tie-breaking: if strength is equal, the first one encountered (strongest_extension_obj) is kept.\n\n        return f\"{class_name}.{strongest_extension_obj.get_name()}\"\ndef Strongest_Extension(class_name: str, extensions: list[str]) -> str:\n    \"\"\"\n    Finds the strongest extension for a given class name, combining them into a formatted string.\n    Strength is calculated as (uppercase letters - lowercase letters), with ties broken by first occurrence.\n    \"\"\"\n    return ExtensionService.find_strongest_extension(class_name, extensions)"}
{"task_id": "HumanEval/155", "solution": "def even_odd_count(num: int) -> tuple[int, int]:\n    \"\"\"Given an integer, return a tuple that has the number of even and odd digits respectively.\n\n     Example:\n        even_odd_count(-12) ==> (1, 1)\n        even_odd_count(123) ==> (1, 2)\n    \"\"\"\n    even_count = 0\n    odd_count = 0\n\n    if num == 0:\n        return (1, 0)\n\n    num_str = str(abs(num))\n\n    for digit_char in num_str:\n        digit = int(digit_char)\n        if digit % 2 == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n    return (even_count, odd_count)"}
{"task_id": "HumanEval/154", "solution": "def cycpattern_check(a , b):\n    \"\"\"Checks if the second word or any of its rotations is a substring in the first word.\"\"\"\n\n    def _generate_rotations(s: str) -> list[str]:\n        \"\"\"Generates all unique cyclic rotations of a string.\"\"\"\n        if not s:\n            return [\"\"]\n        rotations = set()\n        n = len(s)\n        for i in range(n):\n            rotated_s = s[i:] + s[:i]\n            rotations.add(rotated_s)\n        return list(rotations)\n\n    if not b:\n        return True\n    if not a:\n        return False\n\n    rotations_of_b = _generate_rotations(b)\n\n    for rotation in rotations_of_b:\n        if rotation in a:\n            return True\n    return False"}
{"task_id": "HumanEval/154", "solution": "from typing import Generator\nclass StringRotator:\n    \"\"\"Utility for generating cyclic rotations of a string.\"\"\"\n\n    @staticmethod\n    def generate_rotations(s: str) -> Generator[str]:\n        \"\"\"Yields each unique cyclic rotation of the input string s.\"\"\"\n        if not s:\n            yield \"\"\n            return\n        n = len(s)\n        for i in range(n):\n            yield s[i:] + s[:i]\ndef cycpattern_check(a, b):\n    \"\"\"\n    Checks if any rotation of string b is a substring of string a.\n    Returns True if a match is found, False otherwise.\n    \"\"\"\n    # Business rule: An empty string b is always a substring of any string a.\n    if not b:\n        return True\n    # Business rule: If a is empty and b is not, no match is possible.\n    if not a:\n        return False\n\n    # Optimization: If b is longer than a, no rotation of b can be a substring of a.\n    if len(b) > len(a):\n        return False\n\n    for rotation in StringRotator.generate_rotations(b):\n        if rotation in a:\n            return True\n    return False"}
{"task_id": "HumanEval/155", "solution": "def even_odd_count(num):\n    \"\"\"\n    Counts the total number of even and odd digits in an integer.\n    The sign of the number is ignored.\n    \"\"\"\n    even_count = 0\n    odd_count = 0\n\n    # Ignore the sign of the number\n    abs_num = abs(num)\n\n    # Handle the special case of 0\n    if abs_num == 0:\n        return (1, 0) # 0 is an even digit\n\n    # Convert the number to a string to iterate through digits\n    num_str = str(abs_num)\n\n    for digit_char in num_str:\n        digit = int(digit_char)\n        if digit % 2 == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n\n    return (even_count, odd_count)"}
{"task_id": "HumanEval/156", "solution": "_ROMAN_MAP = {\n    1000: 'm', 900: 'cm', 500: 'd', 400: 'cd', 100: 'c',\n    90: 'xc', 50: 'l', 40: 'xl', 10: 'x', 9: 'ix',\n    5: 'v', 4: 'iv', 1: 'i'\n}\ndef int_to_mini_roman(number):\n    \"\"\"\n    Given a positive integer, obtain its roman numeral equivalent as a string,\n    and return it in lowercase.\n    Restrictions: 1 <= num <= 1000\n\n    Examples:\n    >>> int_to_mini_roman(19) == 'xix'\n    >>> int_to_mini_roman(152) == 'clii'\n    >>> int_to_mini_roman(426) == 'cdxxvi'\n    \"\"\"\n    if not (1 <= number <= 1000):\n        raise ValueError(\"Input number must be between 1 and 1000.\")\n\n    roman_numeral = []\n    # Iterates through Roman numeral values from largest to smallest.\n    for value, symbol in _ROMAN_MAP.items():\n        while number >= value:\n            roman_numeral.append(symbol)\n            number -= value\n    return \"\".join(roman_numeral)"}
{"task_id": "HumanEval/156", "solution": "ROMAN_MAP = [\n    (1000, 'm'), (900, 'cm'), (500, 'd'), (400, 'cd'),\n    (100, 'c'), (90, 'xc'), (50, 'l'), (40, 'xl'),\n    (10, 'x'), (9, 'ix'), (5, 'v'), (4, 'iv'),\n    (1, 'i')\n]\ndef int_to_mini_roman(number):\n    \"\"\"\n    Given a positive integer, obtain its roman numeral equivalent as a string,\n    and return it in lowercase.\n    Restrictions: 1 <= num <= 1000\n\n    Examples:\n    >>> int_to_mini_roman(19) == 'xix'\n    >>> int_to_mini_roman(152) == 'clii'\n    >>> int_to_mini_roman(426) == 'cdxxvi'\n    \"\"\"\n    if not (1 <= number <= 1000):\n        raise ValueError(\"Number out of range (1-1000)\")\n\n    result = []\n    temp_num = number\n    for value, symbol in ROMAN_MAP:\n        while temp_num >= value:\n            result.append(symbol)\n            temp_num -= value\n    return \"\".join(result)"}
{"task_id": "HumanEval/157", "solution": "import math\nEPSILON = 1e-9\ndef right_angle_triangle(a, b, c):\n    \"\"\"\n    Given the lengths of the three sides of a triangle. Return True if the three\n    sides form a right-angled triangle, False otherwise.\n    A right-angled triangle is a triangle in which one angle is right angle or\n    90 degree.\n    \"\"\"\n    if not (a > 0 and b > 0 and c > 0):\n        return False\n\n    sides_sq = sorted([a**2, b**2, c**2])\n\n    # Check if the sum of the squares of the two shorter sides equals the square of the longest side\n    return math.isclose(sides_sq[0] + sides_sq[1], sides_sq[2], rel_tol=EPSILON)"}
{"task_id": "HumanEval/158", "solution": "def find_max(words):\n    \"\"\"\n    Returns the word with the maximum number of unique characters.\n    In case of ties, the lexicographically first word is returned.\n    \"\"\"\n    if not words:\n        return \"\"\n\n    best_word = \"\"\n    max_unique_count = -1\n\n    for word in words:\n        current_unique_count = len(set(word))\n\n        if current_unique_count > max_unique_count:\n            max_unique_count = current_unique_count\n            best_word = word\n        elif current_unique_count == max_unique_count:\n            if word < best_word:\n                best_word = word\n    return best_word"}
{"task_id": "HumanEval/159", "solution": "def eat(number, need, remaining):\n    \"\"\"\n    Calculates the total carrots eaten and carrots left after a rabbit's meal.\n    If not enough carrots remain, the rabbit eats all available.\n    \"\"\"\n    actual_eaten_this_meal = min(need, remaining)\n    total_eaten = number + actual_eaten_this_meal\n    carrots_left = remaining - actual_eaten_this_meal\n    return [total_eaten, carrots_left]"}
{"task_id": "HumanEval/158", "solution": "def find_max(words):\n    \"\"\"\n    Finds the word with the maximum number of unique characters from a list.\n    If multiple words tie, the lexicographically first word is returned.\n    \"\"\"\n\n    def _count_unique_chars(word):\n        \"\"\"Counts the number of unique characters in a given string.\"\"\"\n        return len(set(word))\n\n    if not words:\n        return \"\"\n\n    word_data = []\n    for word in words:\n        unique_count = _count_unique_chars(word)\n        word_data.append((unique_count, word))\n\n    # Sort by unique_count (descending) then by word (lexicographical ascending)\n    word_data.sort(key=lambda x: (-x[0], x[1]))\n\n    return word_data[0][1]"}
{"task_id": "HumanEval/159", "solution": "def eat(number, need, remaining):\n    \"\"\"\n    Calculates the outcome of a rabbit's meal, determining total eaten carrots and remaining stock.\n    The rabbit eats the minimum of its need or the available remaining carrots.\n    \"\"\"\n    carrots_the_rabbit_eats = min(need, remaining)\n    total_carrots_eaten = number + carrots_the_rabbit_eats\n    carrots_left_in_stock = remaining - carrots_the_rabbit_eats\n\n    return [total_carrots_eaten, carrots_left_in_stock]"}
{"task_id": "HumanEval/157", "solution": "import math\ndef right_angle_triangle(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle. Return True if the three\n    sides form a right-angled triangle, False otherwise.\n    A right-angled triangle is a triangle in which one angle is right angle or\n    90 degree.\n    Example:\n    right_angle_triangle(3, 4, 5) == True\n    right_angle_triangle(1, 2, 3) == False\n    '''\n    class InvalidSideLengthError(ValueError):\n        \"\"\"Custom exception raised when triangle side lengths are invalid.\"\"\"\n        pass\n\n    MIN_SIDE_LENGTH = 0.0\n    FLOATING_POINT_TOLERANCE = 1e-9\n\n    # Validate sides\n    for side in [a, b, c]:\n        if not isinstance(side, (int, float)):\n            raise InvalidSideLengthError(f\"Side length '{side}' must be a number.\")\n        if side <= MIN_SIDE_LENGTH:\n            raise InvalidSideLengthError(f\"Side length '{side}' must be positive.\")\n\n    # Sort the sides to easily identify the two shorter sides and the longest side.\n    sides = sorted([a, b, c])\n\n    # Apply the Pythagorean theorem: smallest_side^2 + middle_side^2 = longest_side^2\n    # Use a tolerance for floating-point comparison.\n    return math.isclose(sides[0]**2 + sides[1]**2, sides[2]**2, rel_tol=FLOATING_POINT_TOLERANCE)"}
{"task_id": "HumanEval/161", "solution": "def solve(s):\n    \"\"\"You are given a string s.\n    if s[i] is a letter, reverse its case from lower to upper or vise versa,\n    otherwise keep it as it is.\n    If the string contains no letters, reverse the string.\n    The function should return the resulted string.\n    Examples\n    solve(\"1234\") = \"4321\"\n    solve(\"ab\") = \"AB\"\n    solve(\"#a@C\") = \"#A@c\"\n    \"\"\"\n    has_letters = False\n    for char in s:\n        if char.isalpha():\n            has_letters = True\n            break\n\n    if has_letters:\n        result_chars = []\n        for char in s:\n            result_chars.append(char.swapcase())\n        return \"\".join(result_chars)\n    else:\n        return s[::-1]"}
{"task_id": "HumanEval/162", "solution": "import hashlib\nfrom typing import Optional\ndef string_to_md5(text: str) -> Optional[str]:\n    \"\"\"\n    Given a string 'text', return its md5 hash equivalent string.\n    If 'text' is an empty string, return None.\n\n    >>> string_to_md5('Hello world') == '3e25960a79dbc69b674cd4ec67a72c62'\n    \"\"\"\n    if not text:\n        return None\n\n    md5_hash = hashlib.md5(text.encode('utf-8')).hexdigest()\n    return md5_hash"}
{"task_id": "HumanEval/160", "solution": "def do_algebra(operator, operand):\n    \"\"\"\n    Given two lists, `operator` and `operand`, this function builds an algebraic expression and returns its evaluated integer result.\n    It performs basic arithmetic operations respecting standard operator precedence.\n    \"\"\"\n    expression_parts = [str(operand[0])]\n\n    for i in range(len(operator)):\n        expression_parts.append(operator[i])\n        expression_parts.append(str(operand[i+1]))\n\n    expression_string = \" \".join(expression_parts)\n\n    # Evaluate the constructed expression string.\n    # Per critical requirements, input validation and custom error handling are omitted.\n    result = eval(expression_string)\n\n    # Ensure the final result is an integer as per the specification.\n    return int(result)"}
{"task_id": "HumanEval/160", "solution": "def do_algebra(operator, operand):\n    \"\"\"\n    Given two lists operator, and operand. The first list has basic algebra operations, and\n    the second list is a list of integers. Use the two given lists to build the algebric\n    expression and return the evaluation of this expression.\n\n    The basic algebra operations:\n    Addition ( + )\n    Subtraction ( - )\n    Multiplication ( * )\n    Floor division ( // )\n    Exponentiation ( ** )\n\n    Example:\n    operator['+', '*', '-']\n    array = [2, 3, 4, 5]\n    result = 2 + 3 * 4 - 5\n    => result = 9\n\n    Note:\n        The length of operator list is equal to the length of operand list minus one.\n        Operand is a list of of non-negative integers.\n        Operator list has at least one operator, and operand list has at least two operands.\n\n    \"\"\"\n\n    class InvalidInputError(Exception):\n        \"\"\"Custom exception for invalid input to the algebra evaluator.\"\"\"\n        def __init__(self, message: str):\n            super().__init__(message)\n            self.message = message\n\n    def _get_precedence(op: str) -> int:\n        \"\"\"Returns the precedence level of an operator.\"\"\"\n        if op == '**':\n            return 3\n        elif op in ('*', '//'):\n            return 2\n        elif op in ('+', '-'):\n            return 1\n        return 0 # Should not happen with valid inputs as checked by validation\n\n    def _apply_operation(op: str, val1: int, val2: int) -> int:\n        \"\"\"Applies the given operation to two values.\"\"\"\n        if op == '+':\n            return val1 + val2\n        elif op == '-':\n            return val1 - val2\n        elif op == '*':\n            return val1 * val2\n        elif op == '//':\n            if val2 == 0:\n                raise ZeroDivisionError(\"Floor division by zero is not allowed.\")\n            return val1 // val2\n        elif op == '**':\n            return val1 ** val2\n        # This branch should not be reachable due to validation\n        raise ValueError(f\"Unknown operator: {op}\")\n\n    # --- Input Validation ---\n    if not operator and not operand:\n        raise InvalidInputError(\"Operator and operand lists cannot be empty.\")\n    if not operator and len(operand) >= 2:\n        raise InvalidInputError(\"Operator list cannot be empty if operands are present for algebraic expression.\")\n    if not operand and len(operator) >= 1:\n        raise InvalidInputError(\"Operand list cannot be empty if operators are present for algebraic expression.\")\n\n    if len(operand) < 2:\n        raise InvalidInputError(\"Operand list must contain at least two operands.\")\n    if len(operator) != len(operand) - 1:\n        raise InvalidInputError(\"Length of operator list must be one less than operand list.\")\n\n    valid_operators = {'+', '-', '*', '//', '**'}\n    for op in operator:\n        if not isinstance(op, str) or op not in valid_operators:\n            raise InvalidInputError(f\"Invalid operator found: '{op}'. Must be one of {valid_operators}.\")\n\n    for opd in operand:\n        if not isinstance(opd, int) or opd < 0:\n            raise InvalidInputError(f\"Invalid operand found: '{opd}'. Must be a non-negative integer.\")\n    # --- End Input Validation ---\n\n    # Tokenize the expression by interleaving operands and operators.\n    tokens = []\n    for i in range(len(operator)):\n        tokens.append(operand[i])\n        tokens.append(operator[i])\n    tokens.append(operand[-1])\n\n    values = []  # Stack for operands\n    ops = []     # Stack for operators\n\n    for token in tokens:\n        if isinstance(token, int):\n            values.append(token)\n        else:  # It's an operator string\n            while ops and _get_precedence(ops[-1]) >= _get_precedence(token):\n                if len(values) < 2: # Should not happen with valid tokenization\n                    raise InvalidInputError(\"Malformed expression: not enough operands for operator.\")\n                val2 = values.pop()\n                val1 = values.pop()\n                op_from_stack = ops.pop()\n                values.append(_apply_operation(op_from_stack, val1, val2))\n            ops.append(token)\n\n    # Apply any remaining operators in the ops stack to the values stack.\n    while ops:\n        if len(values) < 2: # Should not happen with valid tokenization\n            raise InvalidInputError(\"Malformed expression: not enough operands for remaining operator.\")\n        val2 = values.pop()\n        val1 = values.pop()\n        op_from_stack = ops.pop()\n        values.append(_apply_operation(op_from_stack, val1, val2))\n\n    if len(values) != 1: # Should be exactly one result remaining\n        raise InvalidInputError(\"Malformed expression: unable to resolve to a single value.\")\n\n    return values[0]"}
{"task_id": "HumanEval/161", "solution": "def solve(s):\n    \"\"\"\n    Transforms the input string s based on specific character-level and string-level rules.\n    If the string contains no letters, reverses the entire string.\n    \"\"\"\n\n    # Determine if the string s contains any letters.\n    contains_letters = False\n    for char in s:\n        if char.isalpha():\n            contains_letters = True\n            break\n\n    if not contains_letters:\n        # If no letters are found, reverse the entire string.\n        return s[::-1]\n    else:\n        # If letters are present, iterate and reverse case for letters.\n        transformed_chars = []\n        for char in s:\n            if char.islower():\n                transformed_chars.append(char.upper())\n            elif char.isupper():\n                transformed_chars.append(char.lower())\n            else:\n                transformed_chars.append(char)\n        return \"\".join(transformed_chars)"}
