{"task_id": "HumanEval/8", "solution": "from typing import List, Tuple\ndef sum_product(numbers: List[int]) -> Tuple[int, int]:\n    \"\"\" For a given list of integers, return a tuple consisting of a sum and a product of all the integers in a list.\n    Empty sum should be equal to 0 and empty product should be equal to 1.\n    >>> sum_product([])\n    (0, 1)\n    >>> sum_product([1, 2, 3, 4])\n    (10, 24)\n    \"\"\"\n    total_sum = 0\n    total_product = 1\n\n    if not numbers:\n        return (total_sum, total_product)\n\n    for number in numbers:\n        total_sum += number\n        total_product *= number\n\n    return (total_sum, total_product)"}
{"task_id": "HumanEval/8", "solution": "from typing import List, Tuple\ndef sum_product(numbers: List[int]) -> Tuple[int, int]:\n    \"\"\"Calculates the sum and product of a list of integers.\n    Empty list results in sum 0 and product 1.\"\"\"\n    sum_val = 0\n    product_val = 1\n    for number in numbers:\n        sum_val += number\n        product_val *= number\n    return (sum_val, product_val)"}
{"task_id": "HumanEval/9", "solution": "from typing import List\ndef rolling_max(numbers: List[int]) -> List[int]:\n    \"\"\"From a given list of integers, generate a list of rolling maximum elements\n    found until the given moment in the sequence.\n    >>> rolling_max([1, 2, 3, 2, 3, 4, 2])\n    [1, 2, 3, 3, 3, 4, 4]\n    \"\"\"\n    if not numbers:\n        return []\n\n    rolling_max_list: List[int] = []\n    current_max: int = float('-inf')  # Initialize with negative infinity to handle all integer ranges.\n\n    for number in numbers:\n        if number > current_max:\n            current_max = number\n        rolling_max_list.append(current_max)\n    return rolling_max_list"}
{"task_id": "HumanEval/9", "solution": "from typing import List\ndef rolling_max(numbers: List[int]) -> List[int]:\n    \"\"\" From a given list of integers, generate a list of rolling maximum element found until given moment\n    in the sequence.\n    >>> rolling_max([1, 2, 3, 2, 3, 4, 2])\n    [1, 2, 3, 3, 3, 4, 4]\n    \"\"\"\n    if not numbers:\n        return []\n\n    rolling_max_list = []\n    max_so_far = float('-inf')\n\n    for number in numbers:\n        max_so_far = max(max_so_far, number)\n        rolling_max_list.append(max_so_far)\n\n    return rolling_max_list"}
{"task_id": "HumanEval/10", "solution": "def is_palindrome(string: str) -> bool:\n    \"\"\" Test if given string is a palindrome \"\"\"\n    return string == string[::-1]\ndef make_palindrome(string: str) -> str:\n    \"\"\" Find the shortest palindrome that begins with a supplied string.\n    Algorithm idea is simple:\n    - Find the longest postfix of supplied string that is a palindrome.\n    - Append to the end of the string reverse of a string prefix that comes before the palindromic suffix.\n    >>> make_palindrome('')\n    ''\n    >>> make_palindrome('cat')\n    'catac'\n    >>> make_palindrome('cata')\n    'catac'\n    \"\"\"\n    if is_palindrome(string):\n        return string\n\n    longest_palindromic_suffix_len = 0\n    # Iterate from the longest possible suffix (the string itself) down to an empty string.\n    # The loop variable 'i' marks the start of the suffix.\n    # The first 'i' for which string[i:] is a palindrome will give the longest such suffix.\n    for i in range(len(string)):\n        suffix = string[i:]\n        if is_palindrome(suffix):\n            longest_palindromic_suffix_len = len(suffix)\n            break\n\n    # Identify the prefix that comes before the longest palindromic suffix.\n    prefix_to_reverse = string[:-longest_palindromic_suffix_len]\n    # Reverse this prefix.\n    reversed_prefix = prefix_to_reverse[::-1]\n\n    # Append the reversed prefix to the original string to form the shortest palindrome.\n    return string + reversed_prefix"}
{"task_id": "HumanEval/13", "solution": "def greatest_common_divisor(a: int, b: int) -> int:\n    \"\"\"Return the greatest common divisor of two integers a and b using the Euclidean algorithm.\n    Handles zero and negative inputs correctly.\n    \"\"\"\n    a = abs(a)\n    b = abs(b)\n\n    while b:\n        a, b = b, a % b\n    return a"}
{"task_id": "HumanEval/12", "solution": "from typing import List, Optional\ndef longest(strings: List[str]) -> Optional[str]:\n    \"\"\"Out of list of strings, return the longest one.\n    Returns the first one in case of multiple strings of the same length.\n    \"\"\"\n    if not strings:\n        return None\n\n    longest_str: Optional[str] = None\n    max_length: int = -1\n\n    for s in strings:\n        if len(s) > max_length:\n            max_length = len(s)\n            longest_str = s\n\n    return longest_str"}
{"task_id": "HumanEval/12", "solution": "from typing import List, Optional\ndef longest(strings: List[str]) -> Optional[str]:\n    \"\"\"Out of a list of strings, return the longest one.\n    If multiple strings have the same maximum length, return the first one encountered; return None if the input list is empty.\n    \"\"\"\n    if not strings:\n        return None\n\n    longest_so_far: Optional[str] = None\n    max_length: int = -1\n\n    for s in strings:\n        # Trusting caller's input: 's' is assumed to be a string.\n        # Python will raise TypeError if len() is called on a non-string.\n        current_length = len(s)\n        if current_length > max_length:\n            max_length = current_length\n            longest_so_far = s\n\n    return longest_so_far"}
{"task_id": "HumanEval/10", "solution": "def is_palindrome(string: str) -> bool:\n    \"\"\" Test if given string is a palindrome \"\"\"\n    return string == string[::-1]\ndef make_palindrome(string: str) -> str:\n    \"\"\" Find the shortest palindrome that begins with a supplied string.\n    Algorithm idea is simple:\n    - Find the longest postfix of supplied string that is a palindrome.\n    - Append to the end of the string reverse of a string prefix that comes before the palindromic suffix.\n    >>> make_palindrome('')\n    ''\n    >>> make_palindrome('cat')\n    'catac'\n    >>> make_palindrome('cata')\n    'catac'\n    \"\"\"\n    if not string:\n        return \"\"\n\n    # Iterate 'k' from 0 up to len(string) - 1.\n    # 'k' represents the starting index of the suffix `string[k:]`.\n    # A smaller 'k' means a longer suffix. We want the longest palindromic suffix.\n    for k in range(len(string)):\n        suffix = string[k:]\n        if is_palindrome(suffix):\n            # 'string[:k]' is the prefix that comes before the longest palindromic suffix.\n            prefix_to_reverse = string[:k]\n            return string + prefix_to_reverse[::-1]\n\n    # This point should theoretically not be reached for non-empty strings\n    # because a single character (the last character) or the empty string (if k = len(string))\n    # is always a palindrome, ensuring the loop finds a palindromic suffix."}
