{"task_id": "HumanEval/67", "solution": "def fruit_distribution(s,n):\n    \"\"\"\n    Calculates the number of mango fruits in a basket. It parses apple and orange counts from a string\n    and subtracts them from the total fruit count.\n    \"\"\"\n    parts = s.split(\" apples and \")\n    apples_str = parts[0]\n    oranges_str = parts[1].split(\" oranges\")[0]\n\n    apples = int(apples_str)\n    oranges = int(oranges_str)\n\n    return n - apples - oranges"}
{"task_id": "HumanEval/68", "solution": "def pluck(arr):\n    \"\"\"\n    Finds the smallest even non-negative integer and its index in the array.\n    Prioritizes smallest index if multiple nodes share the same smallest even value.\n    \"\"\"\n    smallest_even_value = float('inf')\n    smallest_even_index = -1\n\n    for index, value in enumerate(arr):\n        if value % 2 == 0:\n            if value < smallest_even_value:\n                smallest_even_value = value\n                smallest_even_index = index\n            elif value == smallest_even_value and index < smallest_even_index:\n                smallest_even_index = index\n\n    if smallest_even_index != -1:\n        return [smallest_even_value, smallest_even_index]\n    else:\n        return []"}
{"task_id": "HumanEval/69", "solution": "from collections import Counter\ndef search(lst: list[int]) -> int:\n    \"\"\"\n    Finds the greatest positive integer in a list whose frequency is greater than or equal to its value.\n    Returns -1 if no such integer exists.\n    \"\"\"\n    frequencies = Counter(lst)\n\n    candidates = []\n    for num, freq in frequencies.items():\n        if num > 0 and freq >= num:\n            candidates.append(num)\n\n    if not candidates:\n        return -1\n\n    return max(candidates)"}
{"task_id": "HumanEval/70", "solution": "def strange_sort_list(lst):\n    \"\"\"\n    Sorts a list of integers in a 'strange' order: alternating between the minimum and maximum of the remaining elements.\n    Starts by taking the overall minimum, then the maximum of what's left, and so on.\n    \"\"\"\n    if not lst:\n        return []\n\n    working_list = sorted(lst)\n    result = []\n    is_min_turn = True\n\n    while working_list:\n        if is_min_turn:\n            result.append(working_list.pop(0))\n        else:\n            result.append(working_list.pop())\n        is_min_turn = not is_min_turn\n\n    return result"}
{"task_id": "HumanEval/70", "solution": "def strange_sort_list(lst: list[int]) -> list[int]:\n    \"\"\"\n    Sorts a list of integers in a strange order: min, then max of remaining, then min, and so on.\n    Handles empty lists gracefully.\n    \"\"\"\n    if not lst:\n        return []\n\n    # Create a sorted copy to easily extract min (from start) and max (from end).\n    mutable_list = sorted(lst)\n    result_list = []\n\n    while mutable_list:\n        # Append the current minimum element.\n        result_list.append(mutable_list.pop(0))\n        if not mutable_list:  # Check if list became empty after popping the minimum.\n            break\n        # Append the current maximum element.\n        result_list.append(mutable_list.pop())\n    return result_list"}
{"task_id": "HumanEval/71", "solution": "import math\ndef triangle_area(a: float, b: float, c: float) -> float:\n    \"\"\"\n    Calculates the area of a triangle given its three side lengths.\n    Returns -1.0 if the sides do not form a valid triangle.\n    \"\"\"\n    if a <= 0 or b <= 0 or c <= 0:\n        return -1.0\n\n    if not ((a + b > c) and (a + c > b) and (b + c > a)):\n        return -1.0\n\n    s = (a + b + c) / 2\n    area_squared = s * (s - a) * (s - b) * (s - c)\n\n    # Robustness: Clamp area_squared to 0 to prevent math domain errors from tiny negative floats.\n    if area_squared < 0:\n        area_squared = 0\n\n    area = math.sqrt(area_squared)\n    return round(area, 2)"}
{"task_id": "HumanEval/71", "solution": "import math\nclass TriangleValidator:\n    \"\"\"\n    Validates if three side lengths can form a valid triangle.\n    Checks for positive side lengths and the triangle inequality theorem.\n    \"\"\"\n    def is_valid(self, a: float, b: float, c: float) -> bool:\n        if not (a > 0 and b > 0 and c > 0):\n            return False\n        return (a + b > c) and \\\n               (a + c > b) and \\\n               (b + c > a)\nclass TriangleCalculator:\n    \"\"\"\n    Calculates the area of a triangle using Heron's formula.\n    Assumes valid triangle inputs.\n    \"\"\"\n    def calculate_herons_area(self, a: float, b: float, c: float) -> float:\n        s = (a + b + c) / 2\n        area_squared = s * (s - a) * (s - b) * (s - c)\n        if area_squared < 0: # Handle potential floating point inaccuracies for near-degenerate triangles\n            return 0.0\n        return math.sqrt(area_squared)\nclass TriangleAreaService:\n    \"\"\"\n    Orchestrates triangle validation and area calculation.\n    Handles rounding and invalid triangle conditions.\n    \"\"\"\n    def __init__(self, validator: TriangleValidator, calculator: TriangleCalculator):\n        self.validator = validator\n        self.calculator = calculator\n\n    def get_area(self, a: float, b: float, c: float) -> float:\n        if not self.validator.is_valid(a, b, c):\n            return -1.0 # Return as float for consistency\n\n        raw_area = self.calculator.calculate_herons_area(a, b, c)\n        return round(raw_area, 2)\ndef triangle_area(a: float, b: float, c: float) -> float:\n    \"\"\"\n    Given the lengths of the three sides of a triangle, returns its area rounded to 2 decimal points.\n    Returns -1.0 if the sides do not form a valid triangle.\n    \"\"\"\n    validator = TriangleValidator()\n    calculator = TriangleCalculator()\n    service = TriangleAreaService(validator, calculator)\n    return service.get_area(a, b, c)"}
{"task_id": "HumanEval/72", "solution": "def will_it_fly(q, w):\n    \"\"\"\n    Checks if a list 'q' is a palindrome and its sum is less than or equal to 'w'.\n    Returns True if both conditions are met, False otherwise.\n    \"\"\"\n    is_palindromic = (q == q[::-1])\n    total_sum = sum(q)\n    sum_is_ok = (total_sum <= w)\n    return is_palindromic and sum_is_ok"}
{"task_id": "HumanEval/72", "solution": "def will_it_fly(q,w):\n    \"\"\"\n    Determines if an object `q` will fly.\n    An object flies if it's a palindromic list and its sum is less than or equal to `w`.\n    \"\"\"\n    is_balanced = q == q[::-1]\n    total_sum = sum(q)\n    return is_balanced and total_sum <= w"}
{"task_id": "HumanEval/73", "solution": "def smallest_change(arr):\n    \"\"\"\n    Calculates the minimum changes to make an array palindromic.\n    One change can modify any element to any other.\n    \"\"\"\n    n = len(arr)\n    if n <= 1:\n        return 0\n\n    changes = 0\n    left = 0\n    right = n - 1\n\n    while left < right:\n        if arr[left] != arr[right]:\n            changes += 1\n        left += 1\n        right -= 1\n    return changes"}
{"task_id": "HumanEval/73", "solution": "def smallest_change(arr):\n    \"\"\"\n    Calculates the minimum number of elements to change to make the array palindromic.\n    An array is palindromic if it reads the same forwards and backwards.\n    \"\"\"\n    left = 0\n    right = len(arr) - 1\n    changes = 0\n\n    while left < right:\n        if arr[left] != arr[right]:\n            changes += 1\n        left += 1\n        right -= 1\n    return changes"}
