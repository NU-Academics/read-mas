{"task_id": "HumanEval/0", "solution": "def has_close_elements(numbers: List[float], threshold: float) -> bool:\n    \"\"\" Check if in given list of numbers, are any two numbers closer to each other than\n    given threshold.\n    >>> has_close_elements([1.0, 2.0, 3.0], 0.5)\n    False\n    >>> has_close_elements([1.0, 2.8, 3.0, 4.0, 5.0, 2.0], 0.3)\n    True\n    \"\"\"\n    if len(numbers) < 2:\n        return False\n\n    s = sorted(numbers)\n    for i in range(len(s) - 1):\n        if abs(s[i+1] - s[i]) < threshold:\n            return True\n            \n    return False"}
{"task_id": "HumanEval/1", "solution": "def separate_paren_groups(paren_string: str) -> List[str]:\n    \"\"\" Input to this function is a string containing multiple groups of nested parentheses. Your goal is to\n    separate those group into separate strings and return the list of those.\n    Separate groups are balanced (each open brace is properly closed) and not nested within each other\n    Ignore any spaces in the input string.\n    >>> separate_paren_groups('( ) (( )) (( )( ))')\n    ['()', '(())', '(()())']\n    \"\"\"\n    cleaned_chars = []\n    for char in paren_string:\n        if char == '(' or char == ')':\n            cleaned_chars.append(char)\n\n    result_groups = []\n    current_group_chars = []\n    balance = 0\n\n    for char in cleaned_chars:\n        current_group_chars.append(char)\n        if char == '(':\n            balance += 1\n        elif char == ')':\n            balance -= 1\n\n        if balance == 0:\n            result_groups.append(\"\".join(current_group_chars))\n            current_group_chars = []\n\n    return result_groups"}
{"task_id": "HumanEval/5", "solution": "def intersperse(numbers: List[int], delimeter: int) -> List[int]:\n    \"\"\" Insert a number 'delimeter' between every two consecutive elements of input list `numbers'\n    >>> intersperse([], 4)\n    []\n    >>> intersperse([1, 2, 3], 4)\n    [1, 4, 2, 4, 3]\n    \"\"\"\n    n = len(numbers)\n    if n == 0:\n        return []\n\n    result: List[int] = []\n    for i, num in enumerate(numbers):\n        result.append(num)\n        if i < n - 1:\n            result.append(delimeter)\n    return result"}
{"task_id": "HumanEval/3", "solution": "def below_zero(operations: List[int]) -> bool:\n    \"\"\"Detects if a bank account balance, starting at zero, ever falls below zero.\n    Returns True if the balance goes negative at any point, False otherwise.\n    \"\"\"\n    balance = 0\n    for op in operations:\n        balance += op\n        if balance < 0:\n            return True\n    return False"}
{"task_id": "HumanEval/2", "solution": "import math\n\ndef truncate_number(number: float) -> float:\n    \"\"\" Given a positive floating point number, it can be decomposed into\n    and integer part (largest integer smaller than given number) and decimals\n    (leftover part always smaller than 1).\n\n    Return the decimal part of the number.\n    >>> truncate_number(3.5)\n    0.5\n    \"\"\"\n    integer_part = math.floor(number)\n    decimal_part = number - integer_part\n    # Round the decimal part to mitigate floating-point representation noise.\n    return round(decimal_part, 15)"}
{"task_id": "HumanEval/7", "solution": "```python\ndef filter_by_substring(strings: List[str], substring: str) -> List[str]:\n    \"\"\" Filter an input list of strings only for ones that contain given substring\n    >>> filter_by_substring([], 'a')\n    []\n    >>> filter_by_substring(['abc', 'bacd', 'cde', 'array'], 'a')\n    ['abc', 'bacd', 'array']\n    \"\"\"\n    if not substring:\n        return strings\n    \n    return [s for s in strings if substring in s]\n```"}
{"task_id": "HumanEval/6", "solution": "from typing import List\nimport re\nimport datetime\n\nclass InvalidParenthesisError(Exception):\n    \"\"\"Custom exception for invalid parenthesis groups.\n    It stores details about the group and its index.\n    \"\"\"\n    def __init__(self, group: str | None = None, group_index: int | None = None, message: str = \"\"):\n        self.group = group\n        self.group_index = group_index\n        self.message = message\n        super().__init__(message)\n\ndef _current_iso_timestamp() -> str:\n    \"\"\"Generates the current UTC time in ISO8601 format.\"\"\"\n    return datetime.datetime.now(datetime.timezone.utc).isoformat(timespec='seconds') + 'Z'\n\nclass _Tokenizer:\n    \"\"\"Splits input string into groups based on whitespace.\"\"\"\n    WHITESPACE_REGEX = r\"\\s+\"\n\n    def split_groups(self, input_str: str) -> List[str]:\n        return [g for g in re.split(self.WHITESPACE_REGEX, input_str.strip()) if g]\n\nclass _Validator:\n    \"\"\"Validates characters and balance of a parenthesis group.\"\"\"\n    def validate(self, group: str) -> None:\n        for char in group:\n            if char not in \"()\":\n                raise InvalidParenthesisError(group=group, message=f\"Invalid character '{char}' found.\")\n        if not self.is_balanced(group):\n            raise InvalidParenthesisError(group=group, message=\"Unbalanced parentheses\")\n\n    def is_balanced(self, group: str) -> bool:\n        depth = 0\n        for c in group:\n            if c == \"(\":\n                depth += 1\n            elif c == \")\":\n                depth -= 1\n            if depth < 0:\n                return False\n        return depth == 0\n\nclass _Parser:\n    \"\"\"Computes the maximum nesting depth for a single parenthesis group.\"\"\"\n    def compute_max_depth(self, group: str) -> int:\n        max_depth = 0\n        depth = 0\n        for i, ch in enumerate(group):\n            if ch == \"(\":\n                depth += 1\n                if depth > max_depth:\n                    max_depth = depth\n            elif ch == \")\":\n                depth -= 1\n                if depth < 0:\n                    raise InvalidParenthesisError(group=group, group_index=i, message=f\"Unmatched ')' at index {i}\")\n        if depth != 0:\n            raise InvalidParenthesisError(group=group, message=\"Unmatched '('\")\n        return max_depth\n\nclass _ParseResult:\n    \"\"\"Data transfer object for parsing results.\"\"\"\n    def __init__(self, input: str, groups: List[str], depths: List[int], timestamp: str):\n        self.input = input\n        self.groups = groups\n        self.depths = depths\n        self.timestamp = timestamp\n\nclass _ParserService:\n    \"\"\"Orchestrates tokenization, validation, and parsing of parenthesis groups.\"\"\"\n    def __init__(self, validator: _Validator, parser: _Parser, tokenizer: _Tokenizer):\n        self.validator = validator\n        self.parser = parser\n        self.tokenizer = tokenizer\n\n    def parse(self, input_str: str, fail_fast: bool = True) -> _ParseResult:\n        groups = self.tokenizer.split_groups(input_str)\n        depths = []\n        for idx, group in enumerate(groups):\n            try:\n                self.validator.validate(group)\n                depth = self.parser.compute_max_depth(group)\n                depths.append(depth)\n            except InvalidParenthesisError as e:\n                if fail_fast:\n                    if e.group_index is None:\n                        e.group_index = idx\n                    raise e\n                depths.append(-1)\n\n        result = _ParseResult(input=input_str, groups=groups, depths=depths, timestamp=_current_iso_timestamp())\n        return result\n\ndef parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\" Input to this function is a string represented multiple groups for nested parentheses separated by spaces.\n    For each of the group, output the deepest level of nesting of parentheses.\n    \"\"\"\n    validator = _Validator()\n    parser = _Parser()\n    tokenizer = _Tokenizer()\n    service = _ParserService(validator=validator, parser=parser, tokenizer=tokenizer)\n    result = service.parse(paren_string, fail_fast=True)\n    return result.depths"}
{"task_id": "HumanEval/4", "solution": "def mean_absolute_deviation(numbers: List[float]) -> float:\n    \"\"\" For a given list of input numbers, calculate Mean Absolute Deviation\n    around the mean of this dataset.\n    Mean Absolute Deviation is the average absolute difference between each\n    element and a centerpoint (mean in this case):\n    MAD = average | x - x_mean |\n    >>> mean_absolute_deviation([1.0, 2.0, 3.0, 4.0])\n    1.0\n    \"\"\"\n    if not numbers:\n        raise ValueError(\"mean_absolute_deviation requires at least one number\")\n\n    def _mean(nums: List[float]) -> float:\n        total = 0.0\n        for x in nums:\n            total += x\n        return total / len(nums)\n\n    mu = _mean(numbers)\n    total_dev = 0.0\n    for x in numbers:\n        total_dev += abs(x - mu)\n    return total_dev / len(numbers)"}
{"task_id": "HumanEval/8", "solution": "def sum_product(numbers: List[int]) -> Tuple[int, int]:\n    \"\"\" For a given list of integers, return a tuple consisting of a sum and a product of all the integers in a list.\n    Empty sum should be equal to 0 and empty product should be equal to 1.\n    >>> sum_product([])\n    (0, 1)\n    >>> sum_product([1, 2, 3, 4])\n    (10, 24)\n    \"\"\"\n    current_sum = sum(numbers)\n\n    current_product = 1\n    for number in numbers:\n        current_product *= number\n\n    return (current_sum, current_product)"}
{"task_id": "HumanEval/9", "solution": "def rolling_max(numbers: List[int]) -> List[int]:\n    \"\"\" From a given list of integers, generate a list of rolling maximum element found until given moment\n    in the sequence.\n    >>> rolling_max([1, 2, 3, 2, 3, 4, 2])\n    [1, 2, 3, 3, 3, 4, 4]\n    \"\"\"\n    if not numbers:\n        return []\n\n    result: List[int] = []\n    current_max = None\n\n    for x in numbers:\n        if current_max is None or x > current_max:\n            current_max = x\n        result.append(current_max)\n\n    return result"}
{"task_id": "HumanEval/11", "solution": "class InvalidBitStringError(Exception):\n    \"\"\"Custom exception for invalid binary string inputs.\"\"\"\n    pass\n\ndef string_xor(a: str, b: str) -> str:\n    \"\"\" Input are two strings a and b consisting only of 1s and 0s.\n    Perform binary XOR on these inputs and return result also as a string.\n    >>> string_xor('010', '110')\n    '100'\n    \"\"\"\n    valid_chars = {'0', '1'}\n\n    if not a or any(ch not in valid_chars for ch in a):\n        raise InvalidBitStringError(\"Bitstring must be non-empty and contain only '0' and '1'\")\n    if not b or any(ch not in valid_chars for ch in b):\n        raise InvalidBitStringError(\"Bitstring must be non-empty and contain only '0' and '1'\")\n\n    if len(a) != len(b):\n        raise InvalidBitStringError(\"Bitstrings must be of equal length\")\n\n    result_bits = ['1' if char_a != char_b else '0' for char_a, char_b in zip(a, b)]\n    return \"\".join(result_bits)"}
{"task_id": "HumanEval/14", "solution": "def all_prefixes(string: str) -> List[str]:\n    \"\"\" Return list of all prefixes from shortest to longest of the input string\n    >>> all_prefixes('abc')\n    ['a', 'ab', 'abc']\n    \"\"\"\n    return [string[:i] for i in range(1, len(string) + 1)]"}
{"task_id": "HumanEval/10", "solution": "def make_palindrome(string: str) -> str:\n    \"\"\" Find the shortest palindrome that begins with a supplied string.\n    Algorithm idea is simple:\n    - Find the longest postfix of supplied string that is a palindrome.\n    - Append to the end of the string reverse of a string prefix that comes before the palindromic suffix.\n    >>> make_palindrome('')\n    ''\n    >>> make_palindrome('cat')\n    'catac'\n    >>> make_palindrome('cata')\n    'catac'\n    \"\"\"\n    n = len(string)\n    if n <= 1:\n        return string\n\n    # Find the smallest index `i` such that string[i:] is a palindrome.\n    # This `string[i:]` will be the longest palindromic suffix.\n    for i in range(n):\n        suffix = string[i:]\n        if suffix == suffix[::-1]:\n            # The prefix that comes before this palindromic suffix is string[:i].\n            # Append the reverse of this prefix to the original string.\n            return string + string[:i][::-1]"}
{"task_id": "HumanEval/12", "solution": "def longest(strings: List[str]) -> Optional[str]:\n    \"\"\" Out of list of strings, return the longest one. Return the first one in case of multiple\n    strings of the same length. Return None in case the input list is empty.\n    \"\"\"\n    longest_string: Optional[str] = None\n    max_len = -1\n    for s in strings:\n        if len(s) > max_len:\n            longest_string = s\n            max_len = len(s)\n    return longest_string"}
