{"task_id": "HumanEval/44", "solution": "class InvalidBaseError(ValueError):\n    pass\n\nclass InvalidNumberError(ValueError):\n    pass\n\nimport datetime\n\ndef validate_base(base: int) -> None:\n    \"\"\"Validates if the base is within the allowed range [2, 9].\"\"\"\n    if not (2 <= base <= 9):\n        raise InvalidBaseError(\"Base must be an integer between 2 and 9, inclusive.\")\n\ndef validate_number(x: int) -> None:\n    \"\"\"Validates if the number is a non-negative integer.\"\"\"\n    if x < 0:\n        raise InvalidNumberError(\"Number must be a non-negative integer.\")\n\ndef timestamp_now() -> str:\n    \"\"\"Returns the current UTC timestamp in ISO8601 format.\"\"\"\n    return datetime.datetime.now(datetime.timezone.utc).isoformat(timespec='milliseconds').replace('+00:00', 'Z')\n\nclass ConversionResult:\n    \"\"\"Data transfer object for conversion results.\"\"\"\n    def __init__(self, x: int, base: int, result: str, timestamp: str) -> None:\n        self.x = x\n        self.base = base\n        self.result = result\n        self.timestamp = timestamp\n\nclass BaseConverterService:\n    \"\"\"Handles the core logic for converting numbers between bases.\"\"\"\n\n    def __init__(self, history_repo=None) -> None:\n        self.history_repo = history_repo\n\n    def _int_to_base_digits(self, x: int, base: int) -> str:\n        \"\"\"Converts a non-negative integer to its string representation in a given base.\"\"\"\n        if x == 0:\n            return \"0\"\n        digits = []\n        while x > 0:\n            x, rem = divmod(x, base)\n            digits.append(str(rem))\n        return \"\".join(reversed(digits))\n\n    def convert(self, x: int, base: int, persist: bool = True) -> ConversionResult:\n        \"\"\"Performs the base conversion and returns a ConversionResult object.\"\"\"\n        validate_number(x)\n        validate_base(base)\n        \n        result_str = self._int_to_base_digits(x, base)\n        timestamp = timestamp_now()\n        \n        conversion_result = ConversionResult(x, base, result_str, timestamp)\n        \n        if persist and self.history_repo:\n            # The change_base convenience function calls with persist=False.\n            # Actual persistence logic is not included here as it's not directly needed for change_base's result.\n            pass\n            \n        return conversion_result\n\ndef change_base(x: int, base: int) -> str:\n    \"\"\"Change numerical base of input number x to base, returning its string representation.\n    Base numbers are less than 10.\"\"\"\n    svc = BaseConverterService()\n    return svc.convert(x, base, persist=False).result"}
{"task_id": "HumanEval/46", "solution": "def fib4(n: int):\n    \"\"\"Computes the n-th Fib4 number iteratively.\n    The sequence is defined by fib4(0)=0, fib4(1)=0, fib4(2)=2, fib4(3)=0, and fib4(n) = fib4(n-1) + fib4(n-2) + fib4(n-3) + fib4(n-4) for n >= 4.\n    \"\"\"\n    if n == 0:\n        return 0\n    if n == 1:\n        return 0\n    if n == 2:\n        return 2\n    if n == 3:\n        return 0\n\n    # Initialize the last four values: fib4(0), fib4(1), fib4(2), fib4(3)\n    a, b, c, d = 0, 0, 2, 0\n\n    for _ in range(4, n + 1):\n        next_fib = d + c + b + a\n        # Shift the window: a becomes b, b becomes c, c becomes d, d becomes next_fib\n        a, b, c, d = b, c, d, next_fib\n    \n    return d"}
{"task_id": "HumanEval/47", "solution": "def median(l: list):\n    \"\"\"Return median of elements in the list l.\n    >>> median([3, 1, 2, 4, 5])\n    3\n    >>> median([-10, 4, 6, 1000, 10, 20])\n    15.0\n    \"\"\"\n    # Sort a copy of the list to find the median.\n    # Assume the input list is non-empty and contains only numeric values.\n    sorted_l = sorted(l)\n    n = len(sorted_l)\n\n    if n % 2 == 1:\n        # For an odd number of elements, the median is the middle element.\n        return sorted_l[n // 2]\n    else:\n        # For an even number of elements, the median is the average of the two middle elements.\n        mid1 = sorted_l[n // 2 - 1]\n        mid2 = sorted_l[n // 2]\n        return (mid1 + mid2) / 2.0"}
{"task_id": "HumanEval/48", "solution": "def is_palindrome(text: str):\n    \"\"\"\n    Checks if given string is a palindrome\n    >>> is_palindrome('')\n    True\n    >>> is_palindrome('aba')\n    True\n    >>> is_palindrome('aaaaa')\n    True\n    >>> is_palindrome('zbcd')\n    False\n    \"\"\"\n    # Normalize the text by converting to lowercase and keeping only alphanumeric characters.\n    normalized_text = \"\".join(char for char in text.lower() if char.isalnum())\n    # Check if the normalized text is equal to its reverse.\n    return normalized_text == normalized_text[::-1]"}
