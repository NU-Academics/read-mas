{"task_id": "HumanEval/25", "solution": "def factorize(n: int) -> List[int]:\n    \"\"\" Return list of prime factors of given integer in the order from smallest to largest.\n    Each of the factors should be listed number of times corresponding to how many times it appeares in factorization.\n    Input number should be equal to the product of all factors\n    >>> factorize(8)\n    [2, 2, 2]\n    >>> factorize(25)\n    [5, 5]\n    >>> factorize(70)\n    [2, 5, 7]\n    \"\"\"\n    if n <= 1:\n        return []\n\n    factors: List[int] = []\n    d = 2\n    temp_n = n\n\n    # Divide by 2\n    while temp_n % d == 0:\n        factors.append(d)\n        temp_n //= d\n\n    # Divide by odd numbers\n    d = 3\n    while d * d <= temp_n:\n        while temp_n % d == 0:\n            factors.append(d)\n            temp_n //= d\n        d += 2\n\n    # If temp_n is still greater than 1, it must be a prime factor itself\n    if temp_n > 1:\n        factors.append(temp_n)\n\n    return factors"}
{"task_id": "HumanEval/29", "solution": "def filter_by_prefix(strings: List[str], prefix: str) -> List[str]:\n    \"\"\" Filter an input list of strings only for ones that start with a given prefix.\n    >>> filter_by_prefix([], 'a')\n    []\n    >>> filter_by_prefix(['abc', 'bcd', 'cde', 'array'], 'a')\n    ['abc', 'array']\n    \"\"\"\n    filtered_strings = []\n    for s in strings:\n        if s.startswith(prefix):\n            filtered_strings.append(s)\n    return filtered_strings"}
{"task_id": "HumanEval/31", "solution": "def is_prime(n):\n    \"\"\"Return true if a given number is prime, and false otherwise.\n    >>> is_prime(6)\n    False\n    >>> is_prime(101)\n    True\n    >>> is_prime(11)\n    True\n    >>> is_prime(13441)\n    True\n    >>> is_prime(61)\n    True\n    >>> is_prime(4)\n    False\n    >>> is_prime(1)\n    False\n    \"\"\"\n    if n < 2:\n        return False\n    if n == 2 or n == 3:\n        return True\n    if n % 2 == 0 or n % 3 == 0:\n        return False\n\n    i = 5\n    while i * i <= n:\n        if n % i == 0 or n % (i + 2) == 0:\n            return False\n        i += 6\n    return True"}
{"task_id": "HumanEval/30", "solution": "def get_positive(l: list):\n    \"\"\"Return only positive numbers in the list.\n    >>> get_positive([-1, 2, -4, 5, 6])\n    [2, 5, 6]\n    >>> get_positive([5, 3, -5, 2, -3, 3, 9, 0, 123, 1, -10])\n    [5, 3, 2, 3, 9, 123, 1]\n    \"\"\"\n    positive_numbers = []\n    for item in l:\n        try:\n            # Check if the item is already an int or float to preserve its original type.\n            if isinstance(item, (int, float)):\n                num = item\n            # If the item is a string, attempt conversion to a number.\n            elif isinstance(item, str):\n                try:\n                    num = int(item)  # Try converting to int first to preserve integer type.\n                except ValueError:\n                    num = float(item)  # If int conversion fails, try float.\n            else:\n                # Skip items that are not int, float, or string.\n                continue\n\n            # If the number is strictly positive, add it to the result list.\n            if num > 0:\n                positive_numbers.append(num)\n        except (ValueError, TypeError):\n            # If conversion to a number fails (e.g., non-numeric string, unsupported type),\n            # or if any other type error occurs, simply skip the item.\n            continue\n    return positive_numbers"}
{"task_id": "HumanEval/34", "solution": "def unique(l: list) -> list:\n    \"\"\"Return sorted unique elements in a list\n    >>> unique([5, 3, 5, 2, 3, 3, 9, 0, 123])\n    [0, 2, 3, 5, 9, 123]\n    \"\"\"\n    # This implementation assumes UniqueService, ListValidator, SetDeduplicator,\n    # and TimsortSorter classes are defined and accessible in the execution environment\n    # as per the provided design context's architecture for the `api.py` module.\n    service = UniqueService(ListValidator(), SetDeduplicator(), TimsortSorter())\n    return service.unique(l)"}
{"task_id": "HumanEval/33", "solution": "def sort_third(l: list):\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the indicies that are not divisible by three, while its values at the indicies that are divisible by three are equal\n    to the values of the corresponding indicies of l, but sorted.\n    >>> sort_third([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_third([5, 6, 3, 4, 8, 9, 2])\n    [2, 6, 3, 4, 8, 9, 5]\n    \"\"\"\n    result = list(l)\n    \n    # Collect values and their original indices that are divisible by three\n    indices_to_sort = []\n    values_to_sort = []\n    for i in range(len(l)):\n        if i % 3 == 0:\n            indices_to_sort.append(i)\n            values_to_sort.append(l[i])\n            \n    # Sort the collected values\n    sorted_values = sorted(values_to_sort)\n    \n    # Reinsert the sorted values back into the result list at their original indices\n    for i in range(len(indices_to_sort)):\n        result[indices_to_sort[i]] = sorted_values[i]\n        \n    return result"}
{"task_id": "HumanEval/32", "solution": "def find_zero(xs: list):\n    \"\"\" xs are coefficients of a polynomial.\n    find_zero find x such that poly(x) = 0.\n    find_zero returns only only zero point, even if there are many.\n    Moreover, find_zero only takes list xs having even number of coefficients\n    and largest non zero coefficient as it guarantees\n    a solution.\n    >>> round(find_zero([1, 2]), 2) # f(x) = 1 + 2x\n    -0.5\n    >>> round(find_zero([-6, 11, -6, 1]), 2) # (x - 1) * (x - 2) * (x - 3) = -6 + 11x - 6x^2 + x^3\n    1.0\n    \"\"\"\n    # Normalize coefficients by removing trailing zeros to get the true degree.\n    coeffs = list(map(float, xs))\n    while len(coeffs) > 1 and abs(coeffs[-1]) < 1e-12:\n        coeffs.pop()\n\n    DEFAULT_TOLERANCE = 1e-10\n    DEFAULT_MAX_ITER = 1000\n\n    def _bracket_root(polynomial_coeffs: list, start: float = 1.0, max_expand: int = 100) -> tuple[float, float]:\n        \"\"\"Find an interval [a,b] where the polynomial changes sign using an expanding search.\"\"\"\n        a, b = -start, start\n        for _ in range(max_expand):\n            fa = poly(polynomial_coeffs, a)\n            fb = poly(polynomial_coeffs, b)\n\n            if fa == 0.0: return (a, a)\n            if fb == 0.0: return (b, b)\n\n            if math.copysign(1.0, fa) != math.copysign(1.0, fb):\n                return (a, b)\n            \n            a *= 2\n            b *= 2\n        return (a / 2, b / 2)\n\n    def _bisection(polynomial_coeffs: list, a: float, b: float, tol: float, max_iter: int) -> float:\n        \"\"\"Perform bisection to find a root within the interval [a,b].\"\"\"\n        fa = poly(polynomial_coeffs, a)\n        fb = poly(polynomial_coeffs, b)\n\n        if abs(fa) < tol: return a\n        if abs(fb) < tol: return b\n\n        for _ in range(max_iter):\n            mid = (a + b) / 2.0\n            fm = poly(polynomial_coeffs, mid)\n\n            if abs(fm) <= tol or abs(b - a) / 2.0 < tol:\n                return mid\n\n            if math.copysign(1.0, fa) != math.copysign(1.0, fm):\n                b = mid\n                fb = fm\n            else:\n                a = mid\n                fa = fm\n        \n        return (a + b) / 2.0\n\n    bracket_a, bracket_b = _bracket_root(coeffs, start=1.0, max_expand=100)\n    root = _bisection(coeffs, bracket_a, bracket_b, DEFAULT_TOLERANCE, DEFAULT_MAX_ITER)\n\n    return root"}
{"task_id": "HumanEval/35", "solution": "class MaxUtilError(Exception):\n    def __init__(self, message=\"\"):\n        self.message = message\n        super().__init__(message)\n\nclass EmptyListError(MaxUtilError):\n    def __init__(self, message=\"List is empty\"):\n        super().__init__(message)\n\nclass NonComparableElementsError(MaxUtilError):\n    def __init__(self, message=\"Elements not comparable\", offending_pairs=None):\n        self.offending_pairs = offending_pairs or []\n        super().__init__(message)\n\nclass InvalidElementTypeError(MaxUtilError):\n    def __init__(self, message=\"Invalid element types\", invalid_types=None):\n        self.invalid_types = invalid_types or []\n        super().__init__(message)\n\nclass ResultDTO:\n    def __init__(self, element, index):\n        self.element = element\n        self.index = index\n    def to_dict(self):\n        return {\"element\": self.element, \"index\": self.index}\n\nclass Comparer:\n    def safe_gt(self, a, b):\n        \"\"\"Compares two elements; raises NonComparableElementsError if comparison fails.\"\"\"\n        try:\n            return a > b\n        except Exception as e:\n            raise NonComparableElementsError(\"Failed comparing elements\", offending_pairs=[(a,b)]) from e\n\nclass ListValidator:\n    def __init__(self, allowed_types=None):\n        self.allowed_types = allowed_types\n\n    def validate_and_prepare(self, lst):\n        \"\"\"Validates and prepares the input for maximum element finding.\"\"\"\n        if lst is None:\n            raise InvalidElementTypeError(\"Input is None\")\n        if not isinstance(lst, list):\n            try:\n                lst = list(lst)\n            except TypeError:\n                raise InvalidElementTypeError(\"Input not iterable or cannot be converted to list\")\n        if len(lst) == 0:\n            raise EmptyListError(\"List is empty\")\n        if self.allowed_types:\n            bad = [type(x) for x in lst if not isinstance(x, tuple(self.allowed_types))]\n            if bad:\n                raise InvalidElementTypeError(\"Disallowed element types\", invalid_types=bad)\n        return lst\n\nclass MaxElementService:\n    def __init__(self, validator, comparer):\n        self._validator = validator\n        self._comparer = comparer\n\n    def find_max(self, lst: list):\n        \"\"\"Determines the maximum element in the provided list.\"\"\"\n        items = self._validator.validate_and_prepare(lst)\n        current_max_element = items[0]\n        \n        for candidate_element in items[1:]:\n            if self._comparer.safe_gt(candidate_element, current_max_element):\n                current_max_element = candidate_element\n        return current_max_element\n\ndef max_element(l: list):\n    \"\"\"Return maximum element in the list.\n    >>> max_element([1, 2, 3])\n    3\n    >>> max_element([5, 3, -5, 2, -3, 3, 9, 0, 123, 1, -10])\n    123\n    \"\"\"\n    validator = ListValidator()\n    comparer = Comparer()\n    svc = MaxElementService(validator, comparer)\n    return svc.find_max(l)"}
{"task_id": "HumanEval/37", "solution": "def sort_even(l: list):\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the odd indicies, while its values at the even indicies are equal\n    to the values of the even indicies of l, but sorted.\n    >>> sort_even([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_even([5, 6, 3, 4])\n    [3, 6, 5, 4]\n    \"\"\"\n    result = list(l)\n    \n    even_indexed_values = []\n    for i in range(0, len(l), 2):\n        even_indexed_values.append(l[i])\n        \n    even_indexed_values.sort()\n    \n    current_sorted_index = 0\n    for i in range(0, len(l), 2):\n        result[i] = even_indexed_values[current_sorted_index]\n        current_sorted_index += 1\n        \n    return result"}
{"task_id": "HumanEval/36", "solution": "from typing import Any, Iterator\n\ndef fizz_buzz(n: int) -> int:\n    \"\"\"Return the number of times the digit 7 appears in integers less than n which are divisible by 11 or 13.\n    >>> fizz_buzz(50)\n    0\n    >>> fizz_buzz(78)\n    2\n    >>> fizz_buzz(79)\n    2\n    \"\"\"\n\n    # Define custom exceptions as per design context.\n    class FizzBuzzError(ValueError):\n        \"\"\"Base exception for FizzBuzz operations.\"\"\"\n        pass\n\n    class InvalidInputError(FizzBuzzError):\n        \"\"\"Raised when input validation fails.\"\"\"\n        pass\n\n    # Define configuration constants as per design context.\n    class AppConfig:\n        MAX_N: int = 10_000_000\n        DIGIT: str = \"7\"\n\n    # Define InputValidator as per design context.\n    class InputValidator:\n        \"\"\"Utility for validating input values.\"\"\"\n        @staticmethod\n        def validate_non_negative_int(value: Any) -> int:\n            \"\"\"Ensure value can be converted to int and is within bounds.\"\"\"\n            try:\n                validated_val = int(value)\n            except (TypeError, ValueError):\n                raise InvalidInputError(f\"Value {value!r} is not an integer.\")\n            if validated_val < 0:\n                raise InvalidInputError(\"n must be >= 0.\")\n            if validated_val > AppConfig.MAX_N:\n                raise InvalidInputError(f\"n is too large; max allowed is {AppConfig.MAX_N}.\")\n            return validated_val\n\n    # Define FizzBuzzService as per design context.\n    class FizzBuzzService:\n        \"\"\"Core logic for counting digit occurrences.\"\"\"\n        def __init__(self, digit: str = AppConfig.DIGIT):\n            self._digit = digit\n\n        def count_sevens(self, limit: int) -> int:\n            \"\"\"Count digit occurrences for qualifying values up to limit.\"\"\"\n            total = 0\n            for x in self._iter_qualifying_values(limit):\n                total += str(x).count(self._digit)\n            return total\n\n        def _iter_qualifying_values(self, limit: int) -> Iterator[int]:\n            \"\"\"Yield integers in [0, limit) divisible by 11 or 13.\"\"\"\n            for x in range(0, limit):\n                if x % 11 == 0 or x % 13 == 0:\n                    yield x\n\n    # Main logic of the fizz_buzz function, using the inline-defined helpers.\n    validated_n = InputValidator.validate_non_negative_int(n)\n    svc = FizzBuzzService()\n    return svc.count_sevens(validated_n)"}
{"task_id": "HumanEval/38", "solution": "def decode_cyclic(s: str):\n    \"\"\"\n    takes as input string encoded with encode_cyclic function. Returns decoded string.\n    \"\"\"\n    # split string to groups. Each of length 3.\n    groups = [s[(3 * i):min((3 * i + 3), len(s))] for i in range((len(s) + 2) // 3)]\n    # cycle elements in each group to reverse encoding. Unless group has fewer elements than 3.\n    groups = [(group[-1] + group[:-1]) if len(group) == 3 else group for group in groups]\n    return \"\".join(groups)"}
{"task_id": "HumanEval/39", "solution": "import collections\nimport math\n\nclass PrimeFibError(Exception):\n    pass\nclass InvalidInputError(PrimeFibError):\n    pass\nclass NotFoundError(PrimeFibError):\n    pass\nclass CacheError(PrimeFibError):\n    pass\n\nclass PrimeFibResult:\n    \"\"\"DTO for a Fibonacci prime result, holding its index and value.\"\"\"\n    def __init__(self, index: int, value: int) -> None:\n        self.index = index\n        self.value = value\n\n    def to_dict(self) -> dict:\n        \"\"\"Converts the result to a dictionary.\"\"\"\n        return {\"index\": self.index, \"value\": self.value}\n\nclass PrimeChecker:\n    \"\"\"Provides utilities for primality testing.\"\"\"\n    _WITNESSES = [2, 3, 5, 7, 11, 13]\n    _SMALL_PRIMES = [2, 3, 5, 7, 11, 13, 17, 19]\n\n    def is_prime(self, n: int) -> bool:\n        \"\"\"Determines if a given integer n is prime.\"\"\"\n        if n < 2:\n            return False\n        if n in self._SMALL_PRIMES:\n            return True\n        if any(n % p == 0 for p in self._SMALL_PRIMES):\n            return False\n        return self._miller_rabin(n, self._WITNESSES)\n\n    def _miller_rabin(self, n: int, witnesses: list[int]) -> bool:\n        \"\"\"Performs rounds of the Miller-Rabin primality test.\"\"\"\n        s = 0\n        d = n - 1\n        while d % 2 == 0:\n            d //= 2\n            s += 1\n\n        for a in witnesses:\n            if a >= n:\n                continue\n\n            x = pow(a, d, n)\n            if x == 1 or x == n - 1:\n                continue\n\n            for _ in range(s - 1):\n                x = pow(x, 2, n)\n                if x == n - 1:\n                    break\n            else:\n                return False\n        return True\n\nclass FibonacciRepository:\n    \"\"\"Manages the generation of Fibonacci numbers.\"\"\"\n    def fibonacci_generator(self):\n        \"\"\"Yields successive (index, value) tuples of Fibonacci numbers, starting with (1, 1).\"\"\"\n        a, b = 1, 1\n        index = 1\n        while True:\n            yield index, a\n            a, b = b, a + b\n            index += 1\n\nclass CacheRepository:\n    \"\"\"Abstract base class for caching Fibonacci prime results.\"\"\"\n    def get(self, key: str) -> PrimeFibResult | None:\n        \"\"\"Retrieves a PrimeFibResult from the cache.\"\"\"\n        raise NotImplementedError\n    def set(self, key: str, value: PrimeFibResult) -> None:\n        \"\"\"Stores a PrimeFibResult in the cache.\"\"\"\n        raise NotImplementedError\n    def clear(self):\n        \"\"\"Clears all entries from the cache.\"\"\"\n        raise NotImplementedError\n\nclass MemoryCache(CacheRepository):\n    \"\"\"In-memory LRU cache for PrimeFibResult objects.\"\"\"\n    def __init__(self, max_size: int = 1000):\n        self._store = collections.OrderedDict()\n        self._max_size = max_size\n\n    def get(self, key: str) -> PrimeFibResult | None:\n        \"\"\"Retrieves a PrimeFibResult from the cache.\"\"\"\n        if key in self._store:\n            value = self._store.pop(key)\n            self._store[key] = value\n            return value\n        return None\n\n    def set(self, key: str, value: PrimeFibResult) -> None:\n        \"\"\"Stores a PrimeFibResult in the cache.\"\"\"\n        if key in self._store:\n            self._store.pop(key)\n        self._store[key] = value\n        if len(self._store) > self._max_size:\n            self._store.popitem(last=False)\n\n    def clear(self):\n        \"\"\"Clears all entries from the cache.\"\"\"\n        self._store.clear()\n\nclass PrimeFibonacciService:\n    \"\"\"Orchestrates the search for the n-th Fibonacci prime with optional caching.\"\"\"\n    def __init__(self, prime_checker: PrimeChecker, fib_repo: FibonacciRepository, cache: CacheRepository | None = None):\n        self.prime_checker = prime_checker\n        self.fib_repo = fib_repo\n        self.cache = cache\n\n    def _cache_key_for_n(self, n: int) -> str:\n        \"\"\"Generates a cache key for the n-th prime Fibonacci number.\"\"\"\n        return f\"n:{n}\"\n\n    def find_nth_prime_fib(self, n: int) -> PrimeFibResult:\n        \"\"\"Finds the n-th Fibonacci number that is also prime.\"\"\"\n        # Input validation (e.g., n < 1) is omitted per user instructions to avoid\n        # adding isinstance checks or raising exceptions for edge cases in this generated code block.\n        # It's assumed 'n' is a valid positive integer (int >= 1).\n\n        if self.cache:\n            try:\n                cached_result = self.cache.get(self._cache_key_for_n(n))\n                if cached_result:\n                    return cached_result\n            except Exception:\n                pass # Cache errors are suppressed and computation continues without caching.\n\n        prime_count = 0\n        for fib_index, fib_value in self.fib_repo.fibonacci_generator():\n            if self.prime_checker.is_prime(fib_value):\n                prime_count += 1\n                if prime_count == n:\n                    result = PrimeFibResult(index=fib_index, value=fib_value)\n                    if self.cache:\n                        try:\n                            self.cache.set(self._cache_key_for_n(n), result)\n                        except Exception:\n                            pass # Cache errors are suppressed and computation continues without caching.\n                    return result\n\n_default_service = PrimeFibonacciService(PrimeChecker(), FibonacciRepository(), MemoryCache())\n\ndef prime_fib(n: int):\n    \"\"\"\n    prime_fib returns n-th number that is a Fibonacci number and it's also prime.\n    >>> prime_fib(1)\n    2\n    >>> prime_fib(2)\n    3\n    >>> prime_fib(3)\n    5\n    >>> prime_fib(4)\n    13\n    >>> prime_fib(5)\n    89\n    \"\"\"\n    return _default_service.find_nth_prime_fib(n).value"}
{"task_id": "HumanEval/40", "solution": "def triples_sum_to_zero(l: list):\n    \"\"\"\n    Checks if there are three distinct elements in the list that sum to zero.\n    Uses a sorting and two-pointer approach for O(n^2) complexity.\n    \"\"\"\n    if len(l) < 3:\n        return False\n\n    nums = sorted(l)\n    n = len(nums)\n\n    for i in range(n - 2):\n        # Optimization: Skip duplicate elements for 'i' to avoid duplicate triplets\n        if i > 0 and nums[i] == nums[i-1]:\n            continue\n\n        left, right = i + 1, n - 1\n        while left < right:\n            current_sum = nums[i] + nums[left] + nums[right]\n\n            if current_sum == 0:\n                return True\n            elif current_sum < 0:\n                left += 1\n            else: # current_sum > 0\n                right -= 1\n    \n    return False"}
