{"task_id": "HumanEval/58", "solution": "def common(l1: list, l2: list):\n    \"\"\"Return sorted unique common elements for two lists.\"\"\"\n    from typing import Iterable, List, Any\n\n    class ValidationError(Exception):\n        \"\"\"Raised for invalid input data.\"\"\"\n        pass\n\n    class ListProcessingError(Exception):\n        \"\"\"Raised for errors during list processing.\"\"\"\n        pass\n\n    def is_iterable(obj: Any) -> bool:\n        \"\"\"Checks if an object is iterable.\"\"\"\n        try:\n            iter(obj)\n            return True\n        except TypeError:\n            return False\n\n    def is_hashable(obj: Any) -> bool:\n        \"\"\"Checks if an object is hashable.\"\"\"\n        try:\n            hash(obj)\n            return True\n        except TypeError:\n            return False\n\n    def normalize_list(l_input: Iterable[Any]) -> List[Any]:\n        \"\"\"Converts an iterable to a list.\"\"\"\n        return list(l_input)\n\n    def safe_sort(seq: Iterable[Any]) -> List[Any]:\n        \"\"\"Sorts a sequence, raising ListProcessingError on TypeError.\"\"\"\n        s = list(seq)\n        try:\n            s.sort()\n            return s\n        except TypeError as e:\n            raise ListProcessingError(\"Cannot sort elements: \" + str(e))\n\n    class CommonCalculator:\n        \"\"\"Implements algorithms for finding common elements.\"\"\"\n        @staticmethod\n        def common(l1_calc: Iterable[Any], l2_calc: Iterable[Any]) -> List[Any]:\n            \"\"\"Chooses between hashable and fallback intersection.\"\"\"\n            a = list(l1_calc)\n            b = list(l2_calc)\n            try:\n                if all(is_hashable(x) for x in a) and all(is_hashable(x) for x in b):\n                    res = CommonCalculator._hashable_intersection(a, b)\n                else:\n                    res = CommonCalculator._fallback_intersection(a, b)\n                return safe_sort(res)\n            except TypeError as e:\n                raise ListProcessingError(\"Elements cannot be compared: \" + str(e))\n\n        @staticmethod\n        def _hashable_intersection(l1_calc: Iterable[Any], l2_calc: Iterable[Any]) -> List[Any]:\n            \"\"\"Computes intersection using sets for hashable elements.\"\"\"\n            return list(set(l1_calc).intersection(set(l2_calc)))\n\n        @staticmethod\n        def _fallback_intersection(l1_calc: Iterable[Any], l2_calc: Iterable[Any]) -> List[Any]:\n            \"\"\"Computes intersection using nested loops for unhashable elements.\"\"\"\n            seen = []\n            for x in l1_calc:\n                for y in l2_calc:\n                    if x == y and x not in seen:\n                        seen.append(x)\n            return seen\n\n    class ListService:\n        \"\"\"Orchestrates common element finding with validation.\"\"\"\n        def __init__(self, calculator: CommonCalculator = None):\n            self.calculator = calculator or CommonCalculator()\n\n        def find_common(self, l1_svc: Iterable, l2_svc: Iterable) -> List:\n            \"\"\"Prepares inputs and delegates to CommonCalculator.\"\"\"\n            if not is_iterable(l1_svc) or not is_iterable(l2_svc):\n                raise ValidationError(\"Both inputs must be iterable\")\n            a = normalize_list(l1_svc)\n            b = normalize_list(l2_svc)\n            return self.calculator.common(a, b)\n\n    svc = ListService()\n    return svc.find_common(l1, l2)"}
{"task_id": "HumanEval/62", "solution": "def derivative(xs: list):\n    \"\"\" xs represent coefficients of a polynomial.\n    xs[0] + xs[1] * x + xs[2] * x^2 + ....\n     Return derivative of this polynomial in the same form.\n    >>> derivative([3, 1, 2, 4, 5])\n    [1, 4, 12, 20]\n    >>> derivative([1, 2, 3])\n    [2, 6]\n    \"\"\"\n    n = len(xs)\n    if n <= 1:\n        return []\n    # The derivative of c_i * x^i is i * c_i * x^(i-1).\n    # The new coefficient at index j corresponds to x^j.\n    # So, for x^j, its coefficient is (j+1) * original_coeff[j+1].\n    return [ (i + 1) * xs[i + 1] for i in range(n - 1) ]"}
{"task_id": "HumanEval/60", "solution": "def sum_to_n(n: int):\n    \"\"\"sum_to_n is a function that sums numbers from 1 to n.\n    >>> sum_to_n(30)\n    465\n    >>> sum_to_n(100)\n    5050\n    >>> sum_to_n(5)\n    15\n    >>> sum_to_n(10)\n    55\n    >>> sum_to_n(1)\n    1\n    \"\"\"\n    return n * (n + 1) // 2"}
{"task_id": "HumanEval/65", "solution": "def circular_shift(x, shift):\n    \"\"\"Circular shift the digits of the integer x, shift the digits right by shift\n    and return the result as a string.\n    If shift > number of digits, return digits reversed.\n    \"\"\"\n    s = str(x)\n    n = len(s)\n\n    if shift > n:\n        return s[::-1]\n    else:\n        # Perform circular right shift\n        # The effective shift value is shift % n\n        # This handles cases where shift == n (which results in shift % n == 0, no actual shift)\n        # and cases where 0 <= shift < n.\n        effective_shift = shift % n\n        return s[-effective_shift:] + s[:-effective_shift]"}
{"task_id": "HumanEval/64", "solution": "def vowels_count(s):\n    \"\"\"Counts the number of vowels in a string, including 'y' if it is the last alphabetic character.\"\"\"\n    vowel_count = 0\n    base_vowels = \"aeiou\"\n\n    # Convert the string to lowercase and strip whitespace for consistent counting.\n    processed_s = s.strip().lower()\n\n    for char in processed_s:\n        if char in base_vowels:\n            vowel_count += 1\n\n    # Check for 'y' as a vowel if it's the last alphabetic character.\n    # This involves trimming trailing non-alphabetic characters before checking the last letter.\n    y_check_s_temp = s.strip().lower()\n    while y_check_s_temp and not y_check_s_temp[-1].isalpha():\n        y_check_s_temp = y_check_s_temp[:-1]\n\n    if y_check_s_temp and y_check_s_temp[-1] == 'y':\n        vowel_count += 1\n\n    return vowel_count"}
{"task_id": "HumanEval/63", "solution": "def fibfib(n: int):\n    \"\"\"The FibFib number sequence is a sequence similar to the Fibbonacci sequnece that's defined as follows:\n    fibfib(0) == 0\n    fibfib(1) == 0\n    fibfib(2) == 1\n    fibfib(n) == fibfib(n-1) + fibfib(n-2) + fibfib(n-3).\n    Please write a function to efficiently compute the n-th element of the fibfib number sequence.\n    >>> fibfib(1)\n    0\n    >>> fibfib(5)\n    4\n    >>> fibfib(8)\n    24\n    \"\"\"\n    if n == 0:\n        return 0\n    if n == 1:\n        return 0\n    if n == 2:\n        return 1\n\n    # Define Matrix3x3 class and its methods for matrix exponentiation.\n    class Matrix3x3:\n        def __init__(self, m: tuple[tuple[int, int, int], tuple[int, int, int], tuple[int, int, int]]):\n            self.m = m\n\n        @staticmethod\n        def identity() -> 'Matrix3x3':\n            \"\"\"Returns a 3x3 identity matrix.\"\"\"\n            return Matrix3x3(((1, 0, 0), (0, 1, 0), (0, 0, 1)))\n\n        def multiply(self, other: 'Matrix3x3') -> 'Matrix3x3':\n            \"\"\"Multiplies this matrix by another 3x3 matrix.\"\"\"\n            a = self.m\n            b = other.m\n            result_m = []\n            for i in range(3):\n                row = []\n                for j in range(3):\n                    val = a[i][0] * b[0][j] + a[i][1] * b[1][j] + a[i][2] * b[2][j]\n                    row.append(val)\n                result_m.append(tuple(row))\n            return Matrix3x3(tuple(result_m))\n\n        def pow(self, exp: int) -> 'Matrix3x3':\n            \"\"\"Raises the matrix to the power of exp using binary exponentiation.\"\"\"\n            result = Matrix3x3.identity()\n            base = self\n            e = exp\n            while e > 0:\n                if e % 2 == 1:\n                    result = result.multiply(base)\n                base = base.multiply(base)\n                e //= 2\n            return result\n\n    # The transformation matrix for the FibFib sequence.\n    T = Matrix3x3(((1, 1, 1), (1, 0, 0), (0, 1, 0)))\n\n    # Compute T^(n-2). This works for n >= 2 because if n=2, exp=0, T.pow(0) is identity.\n    power_matrix = T.pow(n - 2)\n\n    # The n-th FibFib number is the top-left element of T^(n-2)\n    # when multiplied by the initial vector [fibfib(2), fibfib(1), fibfib(0)] = [1, 0, 0].\n    return power_matrix.m[0][0]"}
{"task_id": "HumanEval/66", "solution": "def digitSum(s):\n    \"\"\"Returns the sum of the ASCII codes of only the uppercase characters (A-Z) in the input string.\"\"\"\n    total_sum = 0\n    for char in s:\n        if 'A' <= char <= 'Z':\n            total_sum += ord(char)\n    return total_sum"}
{"task_id": "HumanEval/67", "solution": "```python\nimport re\n\ndef fruit_distribution(s,n):\n    \"\"\"\n    Calculates the number of mango fruits given a string of apples and oranges and total fruits.\n    \"\"\"\n    text = s.lower()\n    \n    # Find apples\n    apples_match = re.search(r\"(\\d+)\\s+(apple|apples)\", text)\n    apples = int(apples_match.group(1)) if apples_match else 0\n    \n    # Find oranges\n    oranges_match = re.search(r\"(\\d+)\\s+(orange|oranges)\", text)\n    oranges = int(oranges_match.group(1)) if oranges_match else 0\n    \n    return n - apples - oranges\n```"}
{"task_id": "HumanEval/73", "solution": "def smallest_change(arr):\n    \"\"\"\n    Given an array arr of integers, find the minimum number of elements that\n    need to be changed to make the array palindromic. A palindromic array is an array that\n    is read the same backwards and forwards. In one change, you can change one element to any other element.\n    \"\"\"\n    n = len(arr)\n    count = 0\n    for i in range(n // 2):\n        if arr[i] != arr[n - 1 - i]:\n            count += 1\n    return count"}
{"task_id": "HumanEval/68", "solution": "def pluck(arr):\n    \"\"\"\n    Finds the smallest even value and its smallest index in an array.\n    Returns [value, index] or [] if no even values are found or the array is empty.\n    \"\"\"\n    smallest_even_value = None\n    smallest_even_index = -1\n\n    for i, value in enumerate(arr):\n        if value % 2 == 0:  # Check if the value is even\n            if smallest_even_value is None or value < smallest_even_value:\n                smallest_even_value = value\n                smallest_even_index = i\n            # If value == smallest_even_value, we don't update because\n            # we want the smallest index, which is naturally preserved\n            # by iterating from left to right and only updating for strictly smaller values.\n\n    if smallest_even_value is not None:\n        return [smallest_even_value, smallest_even_index]\n    else:\n        return []"}
{"task_id": "HumanEval/69", "solution": "from collections import Counter\n\ndef search(lst):\n    '''\n    You are given a non-empty list of positive integers. Return the greatest integer that is greater than \n    zero, and has a frequency greater than or equal to the value of the integer itself. \n    The frequency of an integer is the number of times it appears in the list.\n    If no such a value exist, return -1.\n    Examples:\n        search([4, 1, 2, 2, 3, 1]) == 2\n        search([1, 2, 2, 3, 3, 3, 4, 4, 4]) == 3\n        search([5, 5, 4, 4, 4]) == -1\n    '''\n    frequencies = Counter(lst)\n    candidates = []\n    for value, count in frequencies.items():\n        if count >= value:\n            candidates.append(value)\n\n    if candidates:\n        return max(candidates)\n    else:\n        return -1"}
{"task_id": "HumanEval/74", "solution": "def total_match(lst1, lst2):\n    '''\n    Write a function that accepts two lists of strings and returns the list that has \n    total number of chars in the all strings of the list less than the other list.\n\n    if the two lists have the same number of chars, return the first list.\n    '''\n    total_chars_lst1 = sum(len(s) for s in lst1)\n    total_chars_lst2 = sum(len(s) for s in lst2)\n\n    if total_chars_lst1 <= total_chars_lst2:\n        return lst1\n    else:\n        return lst2"}
{"task_id": "HumanEval/70", "solution": "def strange_sort_list(lst):\n    '''\n    Given list of integers, return list in strange order.\n    Strange sorting, is when you start with the minimum value,\n    then maximum of the remaining integers, then minimum and so on.\n\n    Examples:\n    strange_sort_list([1, 2, 3, 4]) == [1, 4, 2, 3]\n    strange_sort_list([5, 5, 5, 5]) == [5, 5, 5, 5]\n    strange_sort_list([]) == []\n    '''\n    if not lst:\n        return []\n\n    arr = sorted(lst)\n    result = []\n    left, right = 0, len(arr) - 1\n    take_min = True\n\n    while left <= right:\n        if take_min:\n            result.append(arr[left])\n            left += 1\n        else:\n            result.append(arr[right])\n            right -= 1\n        take_min = not take_min\n        \n    return result"}
