{"task_id": "HumanEval/71", "solution": "import math\n\ndef triangle_area(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle. Return the area of\n    the triangle rounded to 2 decimal points if the three sides form a valid triangle. \n    Otherwise return -1\n    Three sides make a valid triangle when the sum of any two sides is greater \n    than the third side.\n    Example:\n    triangle_area(3, 4, 5) == 6.00\n    triangle_area(1, 2, 10) == -1\n    '''\n    # Check if all sides are positive\n    if not (a > 0 and b > 0 and c > 0):\n        return -1\n\n    # Check triangle inequality theorem: sum of any two sides must be strictly greater than the third\n    # Use a small epsilon for robust floating-point comparison as per design context\n    VALIDATION_EPSILON = 1e-12\n    if not (a + b > c + VALIDATION_EPSILON and\n            a + c > b + VALIDATION_EPSILON and\n            b + c > a + VALIDATION_EPSILON):\n        return -1\n\n    # Calculate semi-perimeter\n    s = (a + b + c) / 2\n\n    # Calculate area using Heron's formula\n    term = s * (s - a) * (s - b) * (s - c)\n\n    # Handle numerical instability: if term is slightly negative due to floating-point errors, clamp to zero.\n    # The design context specifies a tolerance of 1e-9 for this.\n    NUMERICAL_STABILITY_TOLERANCE = 1e-9\n    if term < 0 and term > -NUMERICAL_STABILITY_TOLERANCE:\n        term = 0.0\n    elif term < 0:\n        # If term is significantly negative, it indicates an underlying calculation error or severely invalid triangle.\n        return -1\n\n    area = math.sqrt(term)\n\n    # Round to 2 decimal places as required\n    return round(area, 2)"}
{"task_id": "HumanEval/75", "solution": "def is_multiply_prime(a):\n    \"\"\"Checks if the given number is the multiplication of 3 prime numbers.\n    Knowing that (a) is less than 100, meaning `a` is in the range [2, 99].\n    \"\"\"\n    # Constants\n    MAX_N: int = 99\n    MIN_N: int = 2\n\n    # Exception class (defined but not raised within this specific function's logic\n    # due to the problem statement guaranteeing valid input for 'a')\n    class InvalidInputError(Exception):\n        def __init__(self, message: str) -> None:\n            super().__init__(message)\n            self.message = message\n\n    # Utility functions\n    from typing import List, Tuple\n\n    def sieve_primes_upto(n: int) -> List[int]:\n        \"\"\"Generates a list of prime numbers up to n using the Sieve of Eratosthenes.\"\"\"\n        if n < 2:\n            return []\n        sieve = [True] * (n + 1)\n        sieve[0] = sieve[1] = False\n        for p in range(2, int(n**0.5) + 1):\n            if sieve[p]:\n                for multiple in range(p * p, n + 1, p):\n                    sieve[multiple] = False\n        return [i for i, is_prime in enumerate(sieve) if is_prime]\n\n    def divide_if_divisible(n: int, p: int) -> Tuple[int, int]:\n        \"\"\"Counts how many times a prime p divides n and returns the updated n.\"\"\"\n        count = 0\n        while n % p == 0:\n            n //= p\n            count += 1\n        return count, n\n\n    # Model class for factorization results\n    class FactorizationResult:\n        def __init__(self, primes: List[int]) -> None:\n            \"\"\"Stores prime factors and their product.\"\"\"\n            self.primes: List[int] = list(primes)\n            prod = 1\n            for p in self.primes:\n                prod *= p\n            self.product: int = prod\n\n        def count(self) -> int:\n            \"\"\"Returns the total number of prime factors, including multiplicity.\"\"\"\n            return len(self.primes)\n\n    # Repository for prime numbers\n    class PrimeRepository:\n        def __init__(self, max_n: int) -> None:\n            \"\"\"Initializes by precomputing primes up to max_n.\"\"\"\n            self._primes: List[int] = sieve_primes_upto(max_n)\n            self._prime_set = set(self._primes)\n\n        def get_primes(self) -> List[int]:\n            \"\"\"Returns a copy of the precomputed prime list.\"\"\"\n            return list(self._primes)\n\n        def is_prime(self, n: int) -> bool:\n            \"\"\"Checks if a number is prime using the precomputed set.\"\"\"\n            return n in self._prime_set\n\n    # Service for primality tests and factorization\n    class PrimeService:\n        def __init__(self, repo: PrimeRepository) -> None:\n            \"\"\"Depends on a PrimeRepository for prime data.\"\"\"\n            self.repo = repo\n\n        def factorize(self, n: int) -> FactorizationResult:\n            \"\"\"Factors a given number into its prime factors.\"\"\"\n            remaining = n\n            factors: List[int] = []\n            for p in self.repo.get_primes():\n                if p * p > remaining:\n                    break\n                count, remaining = divide_if_divisible(remaining, p)\n                factors.extend([p] * count)\n            if remaining > 1: # If remaining is greater than 1, it must be a prime factor itself.\n                factors.append(remaining)\n            return FactorizationResult(factors)\n\n    # Service for checking if a number is a product of three primes\n    class MultiplyPrimeService:\n        def __init__(self, prime_service: PrimeService) -> None:\n            \"\"\"Depends on a PrimeService for factorization.\"\"\"\n            self.prime_service = prime_service\n\n        def is_multiply_prime(self, n: int) -> bool:\n            \"\"\"Determines if a number is the product of exactly three prime factors.\"\"\"\n            fact = self.prime_service.factorize(n)\n            return fact.count() == 3\n\n    # Instantiate the services and execute the check\n    prime_repo = PrimeRepository(max_n=MAX_N)\n    prime_service = PrimeService(repo=prime_repo)\n    multiply_service = MultiplyPrimeService(prime_service=prime_service)\n\n    return multiply_service.is_multiply_prime(a)"}
{"task_id": "HumanEval/77", "solution": "def iscube(a):\n    \"\"\"\n    Checks if an integer 'a' is a cube of some integer number.\n    It uses integer binary search to find the cube root.\n    \"\"\"\n\n    def _integer_cuberoot(n):\n        # Helper to find the floor of the integer cube root for non-negative n.\n        if n < 2:\n            return n\n        \n        # Binary search for the cube root.\n        # The upper bound is chosen to be sufficiently large.\n        lo, hi = 0, 1 << ((n.bit_length() + 2) // 3 + 1)\n        while lo + 1 < hi:\n            mid = (lo + hi) // 2\n            c = mid * mid * mid\n            if c == n:\n                return mid\n            if c < n:\n                lo = mid\n            else:\n                hi = mid\n        return lo\n\n    if a == 0:\n        return True\n\n    # Calculate the integer cube root of the absolute value.\n    abs_a = abs(a)\n    root = _integer_cuberoot(abs_a)\n\n    # Verify if the cube of the root matches the absolute value.\n    return root * root * root == abs_a"}
{"task_id": "HumanEval/76", "solution": "def is_simple_power(x, n):\n    \"\"\"Checks if a number x is a simple power of n (n**k=x for k>=0).\"\"\"\n\n    # If x is 1, it's always a power (n**0 = 1).\n    if x == 1:\n        return True\n\n    # Handle x=0. It's a power of n only if n=0 (0**k=0 for k>=1).\n    if x == 0:\n        return n == 0\n\n    # Handle special bases n=0, 1, -1 when x is not 0 or 1.\n    # If n is 0 or 1, and x is not 0 or 1, it cannot be a power.\n    if n == 0 or n == 1:\n        return False\n    # If n is -1, and x is not 0 or 1, it must be -1.\n    if n == -1:\n        return x == -1\n\n    # Optimization: a positive base (n > 1) cannot result in a negative x.\n    if n > 0 and x < 0:\n        return False\n\n    # General case: Use iterative division to check if x can be reduced to 1 by dividing by n.\n    current_val = x\n    while current_val % n == 0:\n        current_val //= n\n        if current_val == 1:\n            return True\n    \n    return False"}
