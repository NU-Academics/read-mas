{"task_id": "HumanEval/57", "solution": "def monotonic(l: list):\n    \"\"\"Return True is list elements are monotonically increasing or decreasing.\n    >>> monotonic([1, 2, 4, 20])\n    True\n    >>> monotonic([1, 20, 4, 10])\n    False\n    >>> monotonic([4, 1, 0, -10])\n    True\n    \"\"\"\n    n = len(l)\n    if n <= 1:\n        return True\n\n    is_increasing = True\n    is_decreasing = True\n\n    for i in range(1, n):\n        # Check for non-decreasing property\n        if l[i-1] > l[i]:\n            is_increasing = False\n        # Check for non-increasing property\n        if l[i-1] < l[i]:\n            is_decreasing = False\n\n        # If neither property holds, it's not monotonic, so we can exit early.\n        if not is_increasing and not is_decreasing:\n            return False\n\n    return is_increasing or is_decreasing"}
{"task_id": "HumanEval/56", "solution": "def correct_bracketing(brackets: str):\n    \"\"\" brackets is a string of \"<\" and \">\".\n    return True if every opening bracket has a corresponding closing bracket.\n    \"\"\"\n    depth = 0\n    for char in brackets:\n        if char == \"<\":\n            depth += 1\n        elif char == \">\":\n            if depth == 0:\n                return False  # Unmatched closing bracket\n            depth -= 1\n    return depth == 0"}
{"task_id": "HumanEval/59", "solution": "def largest_prime_factor(n: int):\n    \"\"\"Return the largest prime factor of n. Assume n > 1 and is not a prime.\n    >>> largest_prime_factor(13195)\n    29\n    >>> largest_prime_factor(2048)\n    2\n    \"\"\"\n    import math\n\n    last_factor = 1\n\n    # Remove factors of 2.\n    while n % 2 == 0:\n        last_factor = 2\n        n //= 2\n\n    f = 3\n    # Trial divide by odd numbers up to the square root of n.\n    while f * f <= n:\n        if n % f == 0:\n            last_factor = f\n            n //= f\n            continue\n        f += 2\n\n    # If n is still greater than 1, it must be the largest prime factor.\n    if n > 1:\n        last_factor = n\n\n    return last_factor"}
