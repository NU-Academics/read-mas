{"task_id": "Mbpp/639", "solution": "\"\"\"\nWrite a function to sum the length of the names of a given list of names after removing the names that start with a lowercase letter.\nassert sample_nam(['sally', 'Dylan', 'rebecca', 'Diana', 'Joanne', 'keith'])==16\n\"\"\"\ndef sample_nam(names):\n    \"\"\"Sum the length of names that start with uppercase letters.\"\"\"\n    total = 0\n    for name in names:\n        if name and name[0].isupper():\n            total += len(name)\n    return total"}
{"task_id": "Mbpp/643", "solution": "\"\"\"\nWrite a function that checks if a strings contains 'z', except at the start and end of the word.\nassert text_match_wordz_middle(\"pythonzabc.\")==True\n\"\"\"\ndef text_match_wordz_middle(text):\n    \"\"\"Check if string contains 'z' except at start and end of words.\"\"\"\n    words = text.split()\n    for word in words:\n        clean_word = ''.join(c for c in word if c.isalpha())\n        if len(clean_word) > 2:\n            middle = clean_word[1:-1]\n            if 'z' in middle:\n                return True\n    return False"}
{"task_id": "Mbpp/643", "solution": "\"\"\"\nWrite a function that checks if a strings contains 'z', except at the start and end of the word.\nassert text_match_wordz_middle(\"pythonzabc.\")==True\n\"\"\"\ndef text_match_wordz_middle(text):\n    \"\"\"Check if string contains 'z' in the middle of words (not at start/end).\"\"\"\n    words = text.split()\n    for word in words:\n        clean_word = ''.join(char for char in word if char.isalpha())\n        if len(clean_word) > 2 and 'z' in clean_word[1:-1]:\n            return True\n    return False"}
