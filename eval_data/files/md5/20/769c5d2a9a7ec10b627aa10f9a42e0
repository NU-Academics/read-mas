{"task_id": "Mbpp/576", "solution": "\"\"\"\nWrite a python function to check whether a list is sublist of another or not.\nassert is_Sub_Array([1,4,3,5],[1,2]) == False\n\"\"\"\ndef is_Sub_Array(main_list, sub_list):\n    \"\"\"Check if sub_list is a sublist of main_list.\"\"\"\n    if not sub_list:\n        return True\n    \n    for i in range(len(main_list) - len(sub_list) + 1):\n        if main_list[i:i + len(sub_list)] == sub_list:\n            return True\n    \n    return False"}
{"task_id": "Mbpp/577", "solution": "\"\"\"\nWrite a python function to find the last digit in factorial of a given number.\nassert last_Digit_Factorial(4) == 4\n\"\"\"\ndef last_Digit_Factorial(n):\n    \"\"\"Returns the last digit of n factorial.\"\"\"\n    if n < 2:\n        return 1\n    if n >= 5:\n        return 0\n    \n    factorial = 1\n    for i in range(1, n + 1):\n        factorial *= i\n    \n    return factorial % 10"}
{"task_id": "Mbpp/576", "solution": "\"\"\"\nWrite a python function to check whether a list is sublist of another or not.\nassert is_Sub_Array([1,4,3,5],[1,2]) == False\n\"\"\"\ndef is_Sub_Array(main_list, sub_list):\n    \"\"\"Check if sub_list is a contiguous sublist of main_list.\"\"\"\n    if len(sub_list) == 0:\n        return True\n    if len(sub_list) > len(main_list):\n        return False\n    \n    for i in range(len(main_list) - len(sub_list) + 1):\n        if main_list[i:i + len(sub_list)] == sub_list:\n            return True\n    return False"}
{"task_id": "Mbpp/577", "solution": "\"\"\"\nWrite a python function to find the last digit in factorial of a given number.\nassert last_Digit_Factorial(4) == 4\n\"\"\"\ndef last_Digit_Factorial(n):\n    \"\"\"Find the last digit of n! by tracking only the last digit through multiplication.\"\"\"\n    if n >= 5:\n        return 0\n    \n    last_digit = 1\n    for i in range(1, n + 1):\n        last_digit = (last_digit * i) % 10\n    \n    return last_digit"}
{"task_id": "Mbpp/578", "solution": "\"\"\"\nWrite a function to interleave 3 lists of the same length into a single flat list.\nassert interleave_lists([1,2,3,4,5,6,7],[10,20,30,40,50,60,70],[100,200,300,400,500,600,700])==[1, 10, 100, 2, 20, 200, 3, 30, 300, 4, 40, 400, 5, 50, 500, 6, 60, 600, 7, 70, 700]\n\"\"\"\n```python\ndef interleave_lists(list1, list2, list3):\n    \"\"\"Interleave elements from 3 lists of equal length into a single flat list.\"\"\"\n    result = []\n    for i in range(len(list1)):\n        result.extend([list1[i], list2[i], list3[i]])\n    return result\n```"}
{"task_id": "Mbpp/579", "solution": "\"\"\"\nWrite a function to find the dissimilar elements in the given two tuples.\nassert find_dissimilar((3, 4, 5, 6), (5, 7, 4, 10)) == (3, 6, 7, 10)\n\"\"\"\ndef find_dissimilar(tuple1, tuple2):\n    \"\"\"Find elements that are in one tuple but not in both.\"\"\"\n    set1, set2 = set(tuple1), set(tuple2)\n    dissimilar = (set1 - set2) | (set2 - set1)\n    return tuple(sorted(dissimilar))"}
{"task_id": "Mbpp/578", "solution": "\"\"\"\nWrite a function to interleave 3 lists of the same length into a single flat list.\nassert interleave_lists([1,2,3,4,5,6,7],[10,20,30,40,50,60,70],[100,200,300,400,500,600,700])==[1, 10, 100, 2, 20, 200, 3, 30, 300, 4, 40, 400, 5, 50, 500, 6, 60, 600, 7, 70, 700]\n\"\"\"\n```python\ndef interleave_lists(list1, list2, list3):\n    \"\"\"Interleaves 3 lists of the same length into a single flat list.\"\"\"\n    result = []\n    for i in range(len(list1)):\n        result.extend([list1[i], list2[i], list3[i]])\n    return result\n```"}
{"task_id": "Mbpp/579", "solution": "\"\"\"\nWrite a function to find the dissimilar elements in the given two tuples.\nassert find_dissimilar((3, 4, 5, 6), (5, 7, 4, 10)) == (3, 6, 7, 10)\n\"\"\"\ndef find_dissimilar(tuple1, tuple2):\n    \"\"\"Find elements that are in one tuple but not in both.\"\"\"\n    set1, set2 = set(tuple1), set(tuple2)\n    dissimilar = (set1 - set2) | (set2 - set1)\n    return tuple(sorted(dissimilar))"}
{"task_id": "Mbpp/580", "solution": "\"\"\"\nWrite a function to remove uneven elements in the nested mixed tuple.\nassert extract_even((4, 5, (7, 6, (2, 4)), 6, 8)) == (4, (6, (2, 4)), 6, 8)\n\"\"\"\n```python\ndef extract_even(nested_tuple):\n    \"\"\"Remove odd elements from nested mixed tuple, preserving structure.\"\"\"\n    result = []\n    for item in nested_tuple:\n        if isinstance(item, tuple):\n            filtered_nested = extract_even(item)\n            if filtered_nested:\n                result.append(filtered_nested)\n        elif item % 2 == 0:\n            result.append(item)\n    return tuple(result)\n```"}
{"task_id": "Mbpp/581", "solution": "\"\"\"\nWrite a python function to find the surface area of a square pyramid with a given base edge and height.\nassert surface_Area(3,4) == 33\n\"\"\"\n```python\ndef surface_Area(base_edge, height):\n    \"\"\"Calculate surface area of square pyramid given base edge and height.\"\"\"\n    base_area = base_edge ** 2\n    slant_height = (height ** 2 + (base_edge / 2) ** 2) ** 0.5\n    triangular_face_area = 0.5 * base_edge * slant_height\n    return base_area + 4 * triangular_face_area\n```"}
{"task_id": "Mbpp/581", "solution": "\"\"\"\nWrite a python function to find the surface area of a square pyramid with a given base edge and height.\nassert surface_Area(3,4) == 33\n\"\"\"\ndef surface_Area(base_edge, height):\n    \"\"\"Calculate the surface area of a square pyramid given base edge and height.\"\"\"\n    base_area = base_edge * base_edge\n    slant_height = (height * height + (base_edge / 2) * (base_edge / 2)) ** 0.5\n    triangular_faces_area = 4 * (0.5 * base_edge * slant_height)\n    return base_area + triangular_faces_area"}
