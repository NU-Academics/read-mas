{"task_id": "HumanEval/116", "solution": "```python\ndef sort_array(arr: list[int]) -> list[int]:\n    \"\"\"\n    In this Kata, you have to sort an array of non-negative integers according to\n    number of ones in their binary representation in ascending order.\n    For similar number of ones, sort based on decimal value.\n\n    It must be implemented like this:\n    >>> sort_array([1, 5, 2, 3, 4]) == [1, 2, 3, 4, 5]\n    >>> sort_array([-2, -3, -4, -5, -6]) == [-6, -5, -4, -3, -2]\n    >>> sort_array([1, 0, 2, 3, 4]) [0, 1, 2, 3, 4]\n    \"\"\"\n\n    class BitCounter:\n        @staticmethod\n        def count_set_bits(n: int) -> int:\n            \"\"\"Counts the number of '1's in the binary representation of a non-negative integer.\"\"\"\n            count = 0\n            while n > 0:\n                n &= (n - 1)\n                count += 1\n            return count\n\n    class IntegerSorter:\n        def __init__(self, bit_counter: BitCounter):\n            self.bit_counter = bit_counter\n\n        def _custom_key(self, num: int) -> tuple[int, int, int]:\n            \"\"\"Generates a sort key tuple for an integer based on the custom rules.\"\"\"\n            if num < 0:\n                # Group 0: Negative numbers, primary key is decimal value (ascending).\n                return (0, num, 0)\n            else:\n                # Group 1: Non-negative numbers, primary key is bit count, secondary is decimal value (ascending).\n                bit_count = self.bit_counter.count_set_bits(num)\n                return (1, bit_count, num)\n\n        def sort(self, arr_to_sort: list[int]) -> list[int]:\n            \"\"\"Sorts an array of integers using the custom key.\"\"\"\n            return sorted(arr_to_sort, key=self._custom_key)\n\n    sorter = IntegerSorter(BitCounter())\n    return sorter.sort(arr)\n```"}
{"task_id": "HumanEval/122", "solution": "```python\ndef add_elements(arr, k):\n    \"\"\"\n    Given a non-empty array of integers arr and an integer k, return\n    the sum of the elements with at most two digits from the first k elements of arr.\n    \"\"\"\n    total_sum = 0\n    for i in range(k):\n        element = arr[i]\n        # An element has \"at most two digits\" if its absolute value is <= 99.\n        if -99 <= element <= 99:\n            total_sum += element\n    return total_sum\n```"}
{"task_id": "HumanEval/123", "solution": "```python\ndef get_odd_collatz(n):\n    \"\"\"\n    Given a positive integer n, return a sorted list that has the odd numbers in collatz sequence.\n    The list is sorted in increasing order.\n    \"\"\"\n    if n == 1:\n        return [1]\n\n    sequence_set = set()\n    current_num = n\n    while current_num != 1:\n        sequence_set.add(current_num)\n        if current_num % 2 == 0:\n            current_num //= 2\n        else:\n            current_num = 3 * current_num + 1\n    sequence_set.add(1)\n\n    odd_numbers = [num for num in sequence_set if num % 2 != 0]\n    odd_numbers.sort()\n    return odd_numbers\n```"}
{"task_id": "HumanEval/120", "solution": "def maximum(arr, k):\n    \"\"\"\n    Given an array arr of integers and a positive integer k, return a sorted list\n    of length k with the maximum k numbers in arr.\n    \"\"\"\n    import heapq\n\n    if k == 0:\n        return []\n\n    # Use a min-heap to keep track of the k largest elements seen so far.\n    # The smallest element in the heap (root) is the k-th largest.\n    min_heap = []\n    for num in arr:\n        if len(min_heap) < k:\n            heapq.heappush(min_heap, num)\n        elif num > min_heap[0]:\n            heapq.heapreplace(min_heap, num)\n\n    # The heap now contains the k largest elements. Sort them for the final output.\n    return sorted(min_heap)"}
{"task_id": "HumanEval/124", "solution": "```python\ndef valid_date(date):\n    \"\"\"Validates a given date string based on specified rules.\"\"\"\n    if not date:\n        return False\n\n    parts = date.split('-')\n    if len(parts) != 3:\n        return False\n\n    try:\n        month = int(parts[0])\n        day = int(parts[1])\n        # year = int(parts[2]) # Year is not validated beyond being an integer\n    except ValueError:\n        return False\n\n    if not (1 <= month <= 12):\n        return False\n\n    days_in_month = {\n        1: 31, 3: 31, 5: 31, 7: 31, 8: 31, 10: 31, 12: 31,\n        4: 30, 6: 30, 9: 30, 11: 30,\n        2: 29\n    }\n\n    max_days = days_in_month.get(month)\n    if max_days is None: # Should not happen if month is already validated\n        return False\n\n    if not (1 <= day <= max_days):\n        return False\n\n    return True\n```"}
{"task_id": "HumanEval/125", "solution": "```python\ndef split_words(txt):\n    '''\n    Given a string of words, return a list of words split on whitespace, if no whitespaces exists in the text you\n    should split on commas ',', if no commas exists you should return the number of lower-case letters with odd order in the\n    alphabet, ord('a') = 0, ord('b') = 1, ... ord('z') = 25\n    Examples\n    split_words(\"Hello world!\") \u279e [\"Hello\", \"world!\"]\n    split_words(\"Hello,world!\") \u279e [\"Hello\", \"world!\"]\n    split_words(\"abcdef\") == 3\n    '''\n    if any(c.isspace() for c in txt):\n        return txt.split()\n\n    if ',' in txt:\n        return txt.split(',')\n\n    count = 0\n    for char in txt:\n        if 'a' <= char <= 'z':\n            order = ord(char) - ord('a')\n            if order % 2 != 0:\n                count += 1\n    return count\n```\n"}
{"task_id": "HumanEval/128", "solution": "```python\ndef prod_signs(arr):\n    \"\"\"\n    You are given an array arr of integers and you need to return\n    sum of magnitudes of integers multiplied by product of all signs\n    of each number in the array, represented by 1, -1 or 0.\n    Note: return None for empty arr.\n    \"\"\"\n    if not arr:\n        return None\n\n    product_of_signs = 1\n    sum_of_magnitudes = 0\n\n    for num in arr:\n        # Determine the sign\n        if num > 0:\n            current_sign = 1\n        elif num < 0:\n            current_sign = -1\n        else:\n            current_sign = 0\n\n        # Determine the magnitude\n        current_magnitude = abs(num)\n\n        product_of_signs *= current_sign\n        sum_of_magnitudes += current_magnitude\n\n        # Early exit if the product of signs becomes 0\n        if product_of_signs == 0:\n            break\n\n    return sum_of_magnitudes * product_of_signs\n```"}
{"task_id": "HumanEval/126", "solution": "```python\ndef is_sorted(lst):\n    '''\n    Given a list of numbers, return whether or not they are sorted\n    in ascending order. If list has more than 1 duplicate of the same\n    number, return False. Assume no negative numbers and only integers.\n    '''\n    # Check for ascending order\n    if len(lst) > 1:\n        for i in range(len(lst) - 1):\n            if lst[i] > lst[i+1]:\n                return False\n\n    # Check for valid duplicates: at most one duplicate of any number (i.e., count <= 2)\n    counts = {}\n    for item in lst:\n        counts[item] = counts.get(item, 0) + 1\n\n    for count in counts.values():\n        if count > 2:  # If any number appears more than twice\n            return False\n\n    return True\n```"}
{"task_id": "HumanEval/131", "solution": "def digits(n):\n    \"\"\"Given a positive integer n, return the product of the odd digits.\n    Return 0 if all digits are even.\"\"\"\n    product = 1\n    has_odd_digit = False\n\n    # Convert n to string to iterate through digits\n    for digit_char in str(n):\n        digit = int(digit_char)\n        if digit % 2 != 0:  # Check if digit is odd\n            product *= digit\n            has_odd_digit = True\n\n    return product if has_odd_digit else 0"}
{"task_id": "HumanEval/130", "solution": "```python\ndef tri(n):\n    \"\"\"Calculates the first n+1 numbers of the Tribonacci sequence.\n    This function uses memoization to efficiently compute terms.\"\"\"\n    if n < 0:\n        raise ValueError(\"Input 'n' must be a non-negative integer.\")\n\n    memo = {}\n\n    def _get_tribonacci_term(k):\n        \"\"\"Recursively calculates a single Tribonacci term tri(k) with memoization.\"\"\"\n        if k in memo:\n            return memo[k]\n\n        if k == 0:\n            result = 1\n        elif k == 1:\n            result = 3\n        elif k % 2 == 0:  # n is even\n            result = 1 + k // 2\n        else:  # n is odd\n            result = (\n                _get_tribonacci_term(k - 1)\n                + _get_tribonacci_term(k - 2)\n                + _get_tribonacci_term(k + 1)\n            )\n\n        memo[k] = result\n        return result\n\n    sequence = []\n    for i in range(n + 1):\n        sequence.append(_get_tribonacci_term(i))\n\n    return sequence\n```"}
{"task_id": "HumanEval/129", "solution": "def minPath(grid, k):\n    N = len(grid)\n\n    def get_neighbors(row, col, N):\n        \"\"\"\n        Returns a list of potential neighbor coordinates (up, down, left, right).\n        Does not check if these neighbors are within grid boundaries.\n        \"\"\"\n        neighbors = []\n        neighbors.append((row - 1, col))\n        neighbors.append((row + 1, col))\n        neighbors.append((row, col - 1))\n        neighbors.append((row, col + 1))\n        return neighbors\n\n    class Cell:\n        def __init__(self, row, col, value):\n            self._row = row\n            self._col = col\n            self._value = value\n\n        def get_row(self):\n            return self._row\n\n        def get_col(self):\n            return self._col\n\n        def get_value(self):\n            return self._value\n\n        def __eq__(self, other):\n            if not isinstance(other, Cell):\n                return NotImplemented\n            return self._row == other._row and self._col == other._col and self._value == other._value\n\n        def __hash__(self):\n            return hash((self._row, self._col, self._value))\n\n    class Grid:\n        def __init__(self, data, N):\n            self._data = data\n            self._N = N\n\n        def get_value(self, row, col):\n            return self._data[row][col]\n\n        def is_valid_coordinate(self, row, col):\n            return 0 <= row < self._N and 0 <= col < self._N\n\n        def get_N(self):\n            return self._N\n\n    class PathFinderService:\n        def __init__(self, grid_obj, k_val):\n            self.grid = grid_obj\n            self.k = k_val\n            self.N = grid_obj.get_N()\n            # Initialize min_path_values with a path guaranteed to be larger than any valid path.\n            self.min_path_values = [self.N * self.N + 1] * self.k\n\n        def find_min_path(self):\n            for r in range(self.N):\n                for c in range(self.N):\n                    current_value = self.grid.get_value(r, c)\n                    self.dfs([current_value], r, c, 1)\n            return self.min_path_values\n\n        def dfs(self, current_path, current_row, current_col, depth):\n            if depth == self.k:\n                if self.is_lexicographically_smaller(current_path, self.min_path_values):\n                    self.min_path_values = list(current_path)\n                return\n\n            # Pruning: If the current path prefix is already lexicographically greater than or equal to\n            # the corresponding prefix of the current minimum path, then this branch cannot lead to a better path.\n            if not self.is_lexicographically_smaller(current_path, self.min_path_values[:depth]):\n                return\n\n            for next_row, next_col in get_neighbors(current_row, current_col, self.N):\n                if self.grid.is_valid_coordinate(next_row, next_col):\n                    next_value = self.grid.get_value(next_row, next_col)\n                    self.dfs(current_path + [next_value], next_row, next_col, depth + 1)\n\n        def is_lexicographically_smaller(self, path_a, path_b):\n            for i in range(min(len(path_a), len(path_b))):\n                if path_a[i] < path_b[i]:\n                    return True\n                if path_a[i] > path_b[i]:\n                    return False\n            # If one path is a prefix of another, the shorter one is lexicographically smaller.\n            return len(path_a) < len(path_b)\n\n    grid_obj = Grid(grid, N)\n    path_finder = PathFinderService(grid_obj, k)\n    return path_finder.find_min_path()"}
{"task_id": "HumanEval/127", "solution": "```python\ndef intersection(interval1, interval2):\n    \"\"\"You are given two intervals,\n    where each interval is a pair of integers. For example, interval = (start, end) = (1, 2).\n    The given intervals are closed which means that the interval (start, end)\n    includes both start and end.\n    For each given interval, it is assumed that its start is less or equal its end.\n    Your task is to determine whether the length of intersection of these two\n    intervals is a prime number.\n    Example, the intersection of the intervals (1, 3), (2, 4) is (2, 3)\n    which its length is 1, which not a prime number.\n    If the length of the intersection is a prime number, return \"YES\",\n    otherwise, return \"NO\".\n    If the two intervals don't intersect, return \"NO\".\n\n\n    [input/output] samples:\n    intersection((1, 2), (2, 3)) ==> \"NO\"\n    intersection((-1, 1), (0, 4)) ==> \"NO\"\n    intersection((-3, -1), (-5, 5)) ==> \"YES\"\n    \"\"\"\n    import math\n\n    def is_prime(n: int) -> bool:\n        \"\"\"Checks if the given integer n is a prime number.\"\"\"\n        if n <= 1:\n            return False\n        if n == 2:\n            return True\n        if n % 2 == 0:\n            return False\n        # Check for factors from 3 up to sqrt(n), only odd numbers\n        for i in range(3, int(math.sqrt(n)) + 1, 2):\n            if n % i == 0:\n                return False\n        return True\n\n    start1, end1 = interval1\n    start2, end2 = interval2\n\n    # Calculate the start and end of the intersection\n    intersection_start = max(start1, start2)\n    intersection_end = min(end1, end2)\n\n    # Determine the length of the intersection\n    if intersection_start > intersection_end:\n        intersection_length = 0  # No intersection\n    else:\n        intersection_length = intersection_end - intersection_start + 1\n\n    # Check if the intersection length is a prime number\n    if is_prime(intersection_length):\n        return \"YES\"\n    else:\n        return \"NO\"\n```"}
{"task_id": "HumanEval/134", "solution": "```python\ndef check_if_last_char_is_a_letter(txt):\n    '''\n    Create a function that returns True if the last character\n    of a given string is an alphabetical character and is not\n    a part of a word, and False otherwise.\n    Note: \"word\" is a group of characters separated by space.\n    '''\n    if not txt:\n        return False\n\n    last_char = txt[-1]\n\n    if not last_char.isalpha():\n        return False\n\n    # Check if it's an isolated letter: it's the only character or preceded by a space.\n    if len(txt) == 1:\n        return True\n    elif txt[-2] == ' ':\n        return True\n    else:\n        return False\n```"}
{"task_id": "HumanEval/133", "solution": "```python\nimport math\n\ndef sum_squares(lst):\n    \"\"\"You are given a list of numbers.\n    You need to return the sum of squared numbers in the given list,\n    round each element in the list to the upper int(Ceiling) first.\n    Examples:\n    For lst = [1,2,3] the output should be 14\n    For lst = [1,4,9] the output should be 98\n    For lst = [1,3,5,7] the output should be 84\n    For lst = [1.4,4.2,0] the output should be 29\n    For lst = [-2.4,1,1] the output should be 6\n    \"\"\"\n    total_sum_of_squares = 0\n    for number in lst:\n        rounded_number = math.ceil(number)\n        total_sum_of_squares += rounded_number ** 2\n    return total_sum_of_squares\n```"}
{"task_id": "HumanEval/135", "solution": "```python\ndef can_arrange(arr):\n    \"\"\"Returns the largest index of an element which is not greater than or equal\n    to the element immediately preceding it. Returns -1 if no such element exists.\n    \"\"\"\n    if len(arr) < 2:\n        return -1\n\n    for i in range(len(arr) - 1, 0, -1):\n        if arr[i] < arr[i-1]:\n            return i\n    return -1\n```"}
{"task_id": "HumanEval/132", "solution": "def is_nested(string):\n    \"\"\"\n    Checks if the string contains a valid nested bracket subsequence.\n    A nested subsequence is defined as [A] where A is a non-empty, valid bracket sequence.\n    \"\"\"\n    def _is_valid(sub_s: str) -> bool:\n        \"\"\"\n        Helper to check if a given string of brackets forms a valid bracket sequence.\n        \"\"\"\n        stack = []\n        for char in sub_s:\n            if char == '[':\n                stack.append(char)\n            elif char == ']':\n                if not stack:\n                    return False\n                stack.pop()\n        return not stack\n\n    n = len(string)\n    for i in range(n):\n        if string[i] == '[':\n            for j in range(i + 1, n):\n                if string[j] == ']':\n                    # Potential outer pair (string[i] and string[j])\n                    current_sub = string[i : j + 1]\n                    if _is_valid(current_sub):\n                        # Check if the inner content is a non-empty valid bracket sequence\n                        inner_content = string[i + 1 : j]\n                        if inner_content and _is_valid(inner_content):\n                            return True\n    return False"}
{"task_id": "HumanEval/136", "solution": "```python\ndef largest_smallest_integers(lst):\n    '''\n    Create a function that returns a tuple (a, b), where 'a' is\n    the largest of negative integers, and 'b' is the smallest\n    of positive integers in a list.\n    If there is no negative or positive integers, return them as None.\n    '''\n    negative_integers = [n for n in lst if n < 0]\n    positive_integers = [n for n in lst if n > 0]\n\n    largest_negative = max(negative_integers) if negative_integers else None\n    smallest_positive = min(positive_integers) if positive_integers else None\n\n    return largest_negative, smallest_positive\n```"}
