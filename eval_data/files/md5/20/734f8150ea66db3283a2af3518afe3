{"task_id": "HumanEval/139", "solution": "```python\ndef special_factorial(n):\n    \"\"\"The Brazilian factorial is defined as:\n    brazilian_factorial(n) = n! * (n-1)! * (n-2)! * ... * 1!\n    where n > 0\n\n    For example:\n    >>> special_factorial(4)\n    288\n\n    The function will receive an integer as input and should return the special\n    factorial of this integer.\n    \"\"\"\n    def factorial(k):\n        # This helper function calculates the standard factorial of k.\n        # It assumes k is a non-negative integer.\n        if k == 0:\n            return 1\n\n        result = 1\n        for i in range(1, k + 1):\n            result *= i\n        return result\n\n    special_factorial_result = 1\n    for i in range(1, n + 1):\n        special_factorial_result *= factorial(i)\n    return special_factorial_result\n```"}
{"task_id": "HumanEval/140", "solution": "import re\n\ndef fix_spaces(text):\n    \"\"\"\n    Given a string text, replace all spaces in it with underscores,\n    and if a string has more than 2 consecutive spaces,\n    then replace all consecutive spaces with -\n    \"\"\"\n    # First, replace sequences of three or more spaces with a single hyphen.\n    processed_text = re.sub(r' {3,}', '-', text)\n\n    # Then, replace any remaining single spaces with underscores.\n    processed_text = processed_text.replace(' ', '_')\n\n    return processed_text"}
{"task_id": "HumanEval/142", "solution": "def sum_squares(lst):\n    \"\"\"\"\n    This function will take a list of integers. For all entries in the list, the function shall square the integer entry if its index is a\n    multiple of 3 and will cube the integer entry if its index is a multiple of 4 and not a multiple of 3. The function will not\n    change the entries in the list whose indexes are not a multiple of 3 or 4. The function shall then return the sum of all entries.\n\n    Examples:\n    For lst = [1,2,3] the output should be 6\n    For lst = []  the output should be 0\n    For lst = [-1,-5,2,-1,-5]  the output should be -126\n    \"\"\"\n    if not lst:\n        return 0\n\n    transformed_elements = []\n    for i, entry in enumerate(lst):\n        if i % 3 == 0:\n            transformed_elements.append(entry * entry)\n        elif i % 4 == 0:  # This implicitly means i % 3 != 0 due to the 'if' condition\n            transformed_elements.append(entry * entry * entry)\n        else:\n            transformed_elements.append(entry)\n\n    return sum(transformed_elements)"}
{"task_id": "HumanEval/143", "solution": "```python\ndef words_in_sentence(sentence):\n    \"\"\"\n    Filters words from a sentence, returning only those whose lengths are prime numbers.\n    The order of words is preserved.\n    \"\"\"\n\n    def is_prime(n):\n        if n < 2:\n            return False\n        i = 2\n        while i * i <= n:\n            if n % i == 0:\n                return False\n            i += 1\n        return True\n\n    words = sentence.split(' ')\n    filtered_words = []\n    for word in words:\n        if is_prime(len(word)):\n            filtered_words.append(word)\n\n    return ' '.join(filtered_words)\n```"}
{"task_id": "HumanEval/141", "solution": "import re\n\ndef file_name_check(file_name):\n    \"\"\"Checks if a file's name is valid based on predefined conditions.\"\"\"\n\n    class Constants:\n        MAX_DIGITS: int = 3\n        ALLOWED_EXTENSIONS: list[str] = [\"txt\", \"exe\", \"dll\"]\n        VALID_PREFIX_START_PATTERN: str = r\"^[a-zA-Z]\"\n        VALID_DIGIT_COUNT_PATTERN: str = r\"\\d\"\n\n    class FileNameValidator:\n        def __init__(self) -> None:\n            self._max_digits = Constants.MAX_DIGITS\n            self._allowed_extensions = Constants.ALLOWED_EXTENSIONS\n            self._valid_prefix_start_pattern = re.compile(Constants.VALID_PREFIX_START_PATTERN)\n            self._valid_digit_count_pattern = re.compile(Constants.VALID_DIGIT_COUNT_PATTERN)\n\n        def is_valid(self, file_name: str) -> bool:\n            if not self._check_digit_count(file_name):\n                return False\n\n            dot_parts = file_name.split('.')\n            if len(dot_parts) != 2:\n                return False\n\n            prefix, suffix = dot_parts[0], dot_parts[1]\n\n            if not self._check_prefix(prefix):\n                return False\n\n            if not self._check_suffix(suffix):\n                return False\n\n            return True\n\n        def _check_digit_count(self, file_name: str) -> bool:\n            digit_count = len(self._valid_digit_count_pattern.findall(file_name))\n            return digit_count <= self._max_digits\n\n        def _check_prefix(self, prefix: str) -> bool:\n            return bool(prefix) and bool(self._valid_prefix_start_pattern.match(prefix))\n\n        def _check_suffix(self, suffix: str) -> bool:\n            return suffix in self._allowed_extensions\n\n    _validator = FileNameValidator()\n    if _validator.is_valid(file_name):\n        return 'Yes'\n    return 'No'"}
{"task_id": "HumanEval/144", "solution": "```python\ndef simplify(x, n):\n    \"\"\"Your task is to implement a function that will simplify the expression\n    x * n. The function returns True if x * n evaluates to a whole number and False\n    otherwise. Both x and n, are string representation of a fraction, and have the following format,\n    <numerator>/<denominator> where both numerator and denominator are positive whole numbers.\n\n    You can assume that x, and n are valid fractions, and do not have zero as denominator.\n\n    simplify(\"1/5\", \"5/1\") = True\n    simplify(\"1/6\", \"2/1\") = False\n    simplify(\"7/10\", \"10/2\") = False\n    \"\"\"\n    import math\n\n    class Fraction:\n        \"\"\"Represents a mathematical fraction and provides arithmetic and simplification methods.\"\"\"\n        def __init__(self, numerator: int, denominator: int):\n            self.numerator = numerator\n            self.denominator = denominator\n\n        def multiply(self, other: 'Fraction') -> 'Fraction':\n            \"\"\"Multiplies this fraction by another fraction.\"\"\"\n            new_numerator = self.numerator * other.numerator\n            new_denominator = self.denominator * other.denominator\n            return Fraction(new_numerator, new_denominator)\n\n        def simplify(self) -> 'Fraction':\n            \"\"\"Returns a new Fraction object representing this fraction in its simplest form.\"\"\"\n            common_divisor = math.gcd(self.numerator, self.denominator)\n            return Fraction(self.numerator // common_divisor, self.denominator // common_divisor)\n\n        def is_whole_number(self) -> bool:\n            \"\"\"Checks if the fraction, when simplified, represents a whole number.\"\"\"\n            simplified_fraction = self.simplify()\n            return simplified_fraction.denominator == 1\n\n    def parse_fraction(fraction_str: str) -> Fraction:\n        \"\"\"Parses a string representation of a fraction into a Fraction object.\"\"\"\n        parts = fraction_str.split('/')\n        numerator = int(parts[0])\n        denominator = int(parts[1])\n        return Fraction(numerator, denominator)\n\n    fraction_x = parse_fraction(x)\n    fraction_n = parse_fraction(n)\n\n    product_fraction = fraction_x.multiply(fraction_n)\n    return product_fraction.is_whole_number()\n\n```"}
{"task_id": "HumanEval/146", "solution": "```python\ndef specialFilter(nums):\n    \"\"\"\n    Filters numbers from an array that are greater than 10 and have both\n    first and last digits odd, then returns the count of such numbers.\n    \"\"\"\n\n    def is_odd(digit):\n        \"\"\"Checks if a given single digit is odd.\"\"\"\n        return digit % 2 != 0\n\n    def get_first_digit(num):\n        \"\"\"Extracts the first digit of an integer (absolute value).\"\"\"\n        abs_num = abs(num)\n        if abs_num == 0:\n            return 0\n        while abs_num >= 10:\n            abs_num //= 10\n        return abs_num\n\n    def get_last_digit(num):\n        \"\"\"Extracts the last digit of an integer (absolute value).\"\"\"\n        return abs(num) % 10\n\n    count = 0\n    for num in nums:\n        if num > 10:\n            first_digit = get_first_digit(num)\n            last_digit = get_last_digit(num)\n            if is_odd(first_digit) and is_odd(last_digit):\n                count += 1\n    return count\n```\n"}
{"task_id": "HumanEval/148", "solution": "def bf(planet1, planet2):\n    PLANET_ORDER = [\n        \"Mercury\", \"Venus\", \"Earth\", \"Mars\", \"Jupiter\", \"Saturn\", \"Uranus\", \"Neptune\"\n    ]\n\n    if planet1 not in PLANET_ORDER or planet2 not in PLANET_ORDER:\n        return ()\n\n    idx1 = PLANET_ORDER.index(planet1)\n    idx2 = PLANET_ORDER.index(planet2)\n\n    start_idx = min(idx1, idx2)\n    end_idx = max(idx1, idx2)\n\n    # Slice the list to get planets strictly between the two\n    intermediate_planets = PLANET_ORDER[start_idx + 1:end_idx]\n    return tuple(intermediate_planets)"}
{"task_id": "HumanEval/149", "solution": "```python\ndef sorted_list_sum(lst):\n    \"\"\"Filters a list of strings, keeping only those with even lengths,\n    then sorts them by length (ascending) and alphabetically (ascending)\n    for strings of the same length.\"\"\"\n    even_length_strings = [s for s in lst if len(s) % 2 == 0]\n    sorted_strings = sorted(even_length_strings, key=lambda s: (len(s), s))\n    return sorted_strings\n```"}
{"task_id": "HumanEval/150", "solution": "```python\ndef x_or_y(n, x, y):\n    \"\"\"Returns x if n is a prime number, otherwise returns y.\"\"\"\n    import math\n\n    def is_prime(num):\n        if num <= 1:\n            return False\n        if num == 2:\n            return True\n        if num % 2 == 0: # Optimized check for even numbers greater than 2.\n            return False\n        # Iterate for odd divisors up to the square root of num.\n        for i in range(3, int(math.sqrt(num)) + 1, 2):\n            if num % i == 0:\n                return False\n        return True\n\n    if is_prime(n):\n        return x\n    else:\n        return y\n```"}
{"task_id": "HumanEval/147", "solution": "import math\n\ndef get_max_triples(n):\n    \"\"\"\n    Counts the number of a[i] values with remainder 0 or 1 modulo 3.\n    Then calculates combinations for (0,0,0) and (1,1,1) remainder sums.\n    \"\"\"\n\n    count_mod_0 = 0\n    count_mod_1 = 0\n\n    for i in range(1, n + 1):\n        # a[i] = i*i - i + 1\n        # If i % 3 == 0 or i % 3 == 1, then a[i] % 3 == 1.\n        # If i % 3 == 2, then a[i] % 3 == 0.\n        if i % 3 == 2:\n            count_mod_0 += 1\n        else:\n            count_mod_1 += 1\n\n    total_triples = 0\n\n    # Triples (a[i], a[j], a[k]) sum to a multiple of 3 if their remainders (mod 3) sum to 0 (mod 3).\n    # Since a[x] % 3 can only be 0 or 1, the only valid combinations of remainders are (0,0,0) and (1,1,1).\n    total_triples += math.comb(count_mod_0, 3) # Combinations of three elements with remainder 0\n    total_triples += math.comb(count_mod_1, 3) # Combinations of three elements with remainder 1\n\n    return total_triples"}
{"task_id": "HumanEval/151", "solution": "```python\ndef double_the_difference(lst):\n    '''\n    Given a list of numbers, return the sum of squares of the numbers\n    in the list that are odd. Ignore numbers that are negative or not integers.\n    '''\n    total_sum = 0\n    for n in lst:\n        if isinstance(n, int) and n > 0:\n            if n % 2 != 0:\n                total_sum += n * n\n    return total_sum\n```"}
{"task_id": "HumanEval/152", "solution": "```python\ndef compare(game,guess):\n    \"\"\"Calculates the absolute difference between game scores and guesses.\n    Returns 0 for correct guesses, otherwise the absolute difference.\"\"\"\n\n    differences = []\n    for actual_score, guessed_score in zip(game, guess):\n        if actual_score == guessed_score:\n            differences.append(0)\n        else:\n            differences.append(abs(actual_score - guessed_score))\n    return differences\n```"}
{"task_id": "HumanEval/154", "solution": "```python\ndef cycpattern_check(a , b):\n    \"\"\"You are given 2 words. You need to return True if the second word or any of its rotations is a substring in the first word\n    cycpattern_check(\"abcd\",\"abd\") => False\n    cycpattern_check(\"hello\",\"ell\") => True\n    cycpattern_check(\"whassup\",\"psus\") => False\n    cycpattern_check(\"abab\",\"baa\") => True\n    cycpattern_check(\"efef\",\"eeff\") => False\n    cycpattern_check(\"himenss\",\"simen\") => True\n\n    \"\"\"\n    if not b:\n        return True\n    if not a:\n        return False\n\n    def _generate_rotations(s: str) -> list[str]:\n        \"\"\"Generates all unique cyclic rotations of a string.\"\"\"\n        if not s:\n            return [\"\"]\n        rotations = set()\n        for i in range(len(s)):\n            rotated_s = s[i:] + s[:i]\n            rotations.add(rotated_s)\n        return list(rotations)\n\n    rotations_of_b = _generate_rotations(b)\n\n    for rotation in rotations_of_b:\n        if rotation in a:\n            return True\n    return False\n```\n"}
{"task_id": "HumanEval/155", "solution": "```python\ndef even_odd_count(num):\n    \"\"\"Given an integer. return a tuple that has the number of even and odd digits respectively.\n\n     Example:\n        even_odd_count(-12) ==> (1, 1)\n        even_odd_count(123) ==> (1, 2)\n    \"\"\"\n    even_count = 0\n    odd_count = 0\n\n    if num == 0:\n        return (1, 0)\n\n    abs_num_str = str(abs(num))\n\n    for digit_char in abs_num_str:\n        digit = int(digit_char)\n        if digit % 2 == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n\n    return (even_count, odd_count)\n```"}
{"task_id": "HumanEval/145", "solution": "```python\nfrom typing import List\nfrom dataclasses import dataclass, field\n\ndef order_by_points(nums: List[int]) -> List[int]:\n    \"\"\"\n    Sorts the given list of integers in ascending order according to the sum of their digits.\n    If several items have similar sum of their digits, order them based on their index in original list.\n    \"\"\"\n\n    def _calculate_digit_sum(num: int) -> int:\n        \"\"\"Calculates the sum of the absolute values of digits for a given number.\"\"\"\n        return sum(int(digit) for digit in str(abs(num)))\n\n    @dataclass(order=True)\n    class DigitSumNumber:\n        \"\"\"Helper data class for sorting, encapsulating value, digit sum, and original index.\"\"\"\n        value: int = field(compare=False) # Original number, not used for comparison\n        digit_sum: int\n        original_index: int\n\n    decorated_numbers = []\n    for i, num in enumerate(nums):\n        digit_sum_val = _calculate_digit_sum(num)\n        decorated_numbers.append(DigitSumNumber(value=num, digit_sum=digit_sum_val, original_index=i))\n\n    decorated_numbers.sort()\n\n    return [dn.value for dn in decorated_numbers]\n```"}
{"task_id": "HumanEval/157", "solution": "```python\ndef right_angle_triangle(a, b, c):\n    \"\"\"\n    Given the lengths of the three sides of a triangle, return True if they form a right-angled triangle.\n    It uses the Pythagorean theorem with a small epsilon for floating-point comparison.\n    \"\"\"\n    EPSILON = 1e-9\n\n    sides = sorted([a, b, c])\n    s1, s2, hypotenuse = sides[0], sides[1], sides[2]\n\n    # Apply Pythagorean theorem: s1^2 + s2^2 = hypotenuse^2\n    return abs(s1**2 + s2**2 - hypotenuse**2) < EPSILON\n```"}
{"task_id": "HumanEval/156", "solution": "```python\nclass InvalidRomanInputError(ValueError):\n    \"\"\"Custom exception for invalid input to Roman numeral conversion.\"\"\"\n    pass\n\ndef int_to_mini_roman(number):\n    \"\"\"\n    Given a positive integer, obtain its roman numeral equivalent as a string,\n    and return it in lowercase.\n    Restrictions: 1 <= num <= 1000\n\n    Examples:\n    >>> int_to_mini_roman(19) == 'xix'\n    >>> int_to_mini_roman(152) == 'clii'\n    >>> int_to_mini_roman(426) == 'cdxxvi'\n    \"\"\"\n    if not isinstance(number, int):\n        raise TypeError(\"Input must be an integer.\")\n\n    MIN_NUMBER = 1\n    MAX_NUMBER = 1000\n    if not (MIN_NUMBER <= number <= MAX_NUMBER):\n        raise InvalidRomanInputError(\n            f\"Input number must be between {MIN_NUMBER} and {MAX_NUMBER}.\"\n        )\n\n    roman_map = [\n        (1000, 'm'), (900, 'cm'), (500, 'd'), (400, 'cd'),\n        (100, 'c'), (90, 'xc'), (50, 'l'), (40, 'xl'),\n        (10, 'x'), (9, 'ix'), (5, 'v'), (4, 'iv'), (1, 'i')\n    ]\n\n    roman_numeral = []\n    temp_num = number\n    for value, symbol in roman_map:\n        while temp_num >= value:\n            roman_numeral.append(symbol)\n            temp_num -= value\n\n    return \"\".join(roman_numeral)\n```"}
{"task_id": "HumanEval/153", "solution": "def Strongest_Extension(class_name, extensions):\n    \"\"\"Finds the strongest extension for a given class, based on (uppercase - lowercase) letter count.\n    Returns the class name combined with the strongest extension, or just the class name if no extensions.\"\"\"\n    class Extension:\n        \"\"\"Represents an extension with its name and calculated strength.\"\"\"\n        def __init__(self, name: str, strength: int):\n            self._name = name\n            self._strength = strength\n\n        def get_name(self) -> str:\n            return self._name\n\n        def get_strength(self) -> int:\n            return self._strength\n\n    class CharacterCounter:\n        \"\"\"Provides utility methods for counting uppercase and lowercase characters.\"\"\"\n        def count_uppercase(self, text: str) -> int:\n            return sum(1 for char in text if char.isupper())\n\n        def count_lowercase(self, text: str) -> int:\n            return sum(1 for char in text if char.islower())\n\n    class ExtensionAnalyzerService:\n        \"\"\"Encapsulates business logic for calculating strengths and finding the strongest extension.\"\"\"\n        def __init__(self, character_counter: CharacterCounter):\n            self._character_counter = character_counter\n\n        def calculate_strength(self, extension_name: str) -> int:\n            cap = self._character_counter.count_uppercase(extension_name)\n            sm = self._character_counter.count_lowercase(extension_name)\n            return cap - sm\n\n        def find_strongest_extension(self, extensions: list[str]) -> str | None:\n            strongest_ext_name: str | None = None\n            max_strength: int = -float('inf')\n\n            for ext_name in extensions:\n                current_strength = self.calculate_strength(ext_name)\n\n                # Update if current_strength is strictly greater, handling tie-breaking for first occurrence.\n                if current_strength > max_strength:\n                    max_strength = current_strength\n                    strongest_ext_name = ext_name\n\n            return strongest_ext_name\n\n        def format_output(self, class_name: str, strongest_extension_name: str | None) -> str:\n            if strongest_extension_name is None:\n                return class_name\n            return f\"{class_name}.{strongest_extension_name}\"\n\n    character_counter = CharacterCounter()\n    analyzer_service = ExtensionAnalyzerService(character_counter)\n\n    strongest_ext_name = analyzer_service.find_strongest_extension(extensions)\n\n    return analyzer_service.format_output(class_name, strongest_ext_name)"}
{"task_id": "HumanEval/158", "solution": "```python\ndef find_max(words):\n    \"\"\"Write a function that accepts a list of strings.\n    The list contains different words. Return the word with maximum number\n    of unique characters. If multiple strings have maximum number of unique\n    characters, return the one which comes first in lexicographical order.\n    \"\"\"\n    if not words:\n        return None\n\n    max_unique_count = -1\n    result_word = None\n\n    for word in words:\n        current_unique_count = len(set(word))\n\n        if current_unique_count > max_unique_count:\n            max_unique_count = current_unique_count\n            result_word = word\n        elif current_unique_count == max_unique_count:\n            # Tie-breaking: lexicographical order\n            if result_word is None or word < result_word:\n                result_word = word\n    return result_word\n```"}
{"task_id": "HumanEval/159", "solution": "```python\ndef eat(number, need, remaining):\n    \"\"\"\n    Calculates the total carrots eaten and the number of carrots left after a rabbit's meal.\n    The rabbit eats as many as needed, or all remaining if stock is insufficient.\n    \"\"\"\n\n    if need <= remaining:\n        carrots_eaten_now = need\n        carrots_left = remaining - need\n    else:\n        carrots_eaten_now = remaining\n        carrots_left = 0\n\n    total_eaten = number + carrots_eaten_now\n\n    return [total_eaten, carrots_left]\n```"}
{"task_id": "HumanEval/162", "solution": "```python\ndef string_to_md5(text):\n    \"\"\"\n    Given a string 'text', return its md5 hash equivalent string.\n    If 'text' is an empty string, return None.\n\n    >>> string_to_md5('Hello world') == '3e25960a79dbc69b674cd4ec67a72c62'\n    \"\"\"\n    import hashlib\n\n    if not text:\n        return None\n    return hashlib.md5(text.encode('utf-8')).hexdigest()\n```"}
{"task_id": "HumanEval/161", "solution": "def solve(s):\n    \"\"\"You are given a string s.\n    if s[i] is a letter, reverse its case from lower to upper or vise versa,\n    otherwise keep it as it is.\n    If the string contains no letters, reverse the string.\n    The function should return the resulted string.\n    Examples\n    solve(\"1234\") = \"4321\"\n    solve(\"ab\") = \"AB\"\n    solve(\"#a@C\") = \"#A@c\"\n    \"\"\"\n\n    # Check if the string contains any letters\n    contains_letters = False\n    for char in s:\n        if char.isalpha():\n            contains_letters = True\n            break\n\n    # If no letters, reverse the entire string\n    if not contains_letters:\n        return s[::-1]\n\n    # If letters exist, process character by character\n    result_chars = []\n    for char in s:\n        if char.isalpha():\n            # Reverse case if it's a letter\n            result_chars.append(char.swapcase())\n        else:\n            # Keep non-letters as they are\n            result_chars.append(char)\n\n    return \"\".join(result_chars)"}
{"task_id": "HumanEval/160", "solution": "```python\nclass InvalidInputError(Exception):\n    \"\"\"Custom exception for invalid input parameters.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\n\nclass EvaluationError(Exception):\n    \"\"\"Custom exception for errors during expression evaluation.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\n\nclass AlgebraEvaluator:\n    SUPPORTED_OPERATORS = {'+', '-', '*', '//', '**'}\n\n    def do_algebra(self, operator: list[str], operand: list[int]) -> int:\n        self._validate_inputs(operator, operand)\n        expression_string = self._build_expression_string(operator, operand)\n        return self._evaluate_expression(expression_string)\n\n    def _validate_inputs(self, operator: list[str], operand: list[int]) -> None:\n        if not isinstance(operator, list) or not all(isinstance(op, str) for op in operator):\n            raise InvalidInputError(\"Operator list must contain only strings.\")\n        if not isinstance(operand, list) or not all(isinstance(op, int) and op >= 0 for op in operand):\n            raise InvalidInputError(\"Operand list must contain only non-negative integers.\")\n\n        if len(operator) != len(operand) - 1:\n            raise InvalidInputError(\"Length of operator list must be equal to length of operand list minus one.\")\n        if len(operator) < 1:\n            raise InvalidInputError(\"Operator list must have at least one operator.\")\n        if len(operand) < 2:\n            raise InvalidInputError(\"Operand list must have at least two operands.\")\n\n        for op in operator:\n            if op not in self.SUPPORTED_OPERATORS:\n                raise InvalidInputError(f\"Unsupported operator found: '{op}'. Supported operators are {self.SUPPORTED_OPERATORS}.\")\n\n    def _build_expression_string(self, operator: list[str], operand: list[int]) -> str:\n        expression_parts = []\n        for i in range(len(operand)):\n            expression_parts.append(str(operand[i]))\n            if i < len(operator):\n                expression_parts.append(operator[i])\n        return \" \".join(expression_parts)\n\n    def _evaluate_expression(self, expression_string: str) -> int:\n        try:\n            # Using eval() is acceptable here because the expression string is\n            # constructed internally from validated, primitive components.\n            result = eval(expression_string)\n            if not isinstance(result, int):\n                # Ensure the result is an integer, e.g., for float division results\n                return int(result)\n            return result\n        except (SyntaxError, TypeError, ZeroDivisionError, OverflowError) as e:\n            raise EvaluationError(f\"Error evaluating expression '{expression_string}': {e}\") from e\n\ndef do_algebra(operator: list[str], operand: list[int]) -> int:\n    \"\"\"\n    Given two lists operator, and operand. The first list has basic algebra operations, and\n    the second list is a list of integers. Use the two given lists to build the algebric\n    expression and return the evaluation of this expression.\n\n    The basic algebra operations:\n    Addition ( + )\n    Subtraction ( - )\n    Multiplication ( * )\n    Floor division ( // )\n    Exponentiation ( ** )\n\n    Example:\n    operator['+', '*', '-']\n    array = [2, 3, 4, 5]\n    result = 2 + 3 * 4 - 5\n    => result = 9\n\n    Note:\n        The length of operator list is equal to the length of operand list minus one.\n        Operand is a list of of non-negative integers.\n        Operator list has at least one operator, and operand list has at least two operands.\n\n    \"\"\"\n    evaluator = AlgebraEvaluator()\n    return evaluator.do_algebra(operator, operand)\n```"}
{"task_id": "HumanEval/163", "solution": "def generate_integers(a, b):\n    \"\"\"\n    Given two positive integers a and b, return the even digits between a\n    and b, in ascending order.\n    \"\"\"\n    start_range = min(a, b)\n    end_range = max(a, b)\n\n    # According to the examples, \"even digits\" refers to the single-digit\n    # even numbers: 2, 4, 6, 8.\n    # Example (10, 14) => [] confirms that multi-digit even numbers like 10, 12, 14 are not included.\n    even_digits = [2, 4, 6, 8]\n\n    result = []\n    for digit in even_digits:\n        if start_range <= digit <= end_range:\n            result.append(digit)\n\n    return result"}
