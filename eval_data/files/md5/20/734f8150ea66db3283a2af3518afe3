{"task_id": "HumanEval/40", "solution": "```python\ndef triples_sum_to_zero(l: list):\n    \"\"\"\n    triples_sum_to_zero takes a list of integers as an input.\n    it returns True if there are three distinct elements in the list that\n    sum to zero, and False otherwise.\n    \"\"\"\n    n = len(l)\n    if n < 3:\n        return False\n\n    # Iterate through all unique combinations of three distinct indices (i, j, k)\n    # such that i < j < k, ensuring distinct elements by index.\n    for i in range(n):\n        for j in range(i + 1, n):\n            for k in range(j + 1, n):\n                if l[i] + l[j] + l[k] == 0:\n                    return True\n    return False\n```"}
{"task_id": "HumanEval/36", "solution": "```python\ndef fizz_buzz(n: int):\n    \"\"\"Return the number of times the digit 7 appears in integers less than n which are divisible by 11 or 13.\n    >>> fizz_buzz(50)\n    0\n    >>> fizz_buzz(78)\n    2\n    >>> fizz_buzz(79)\n    3\n    \"\"\"\n    total_sevens = 0\n    for i in range(1, n):\n        if (i % 11 == 0) or (i % 13 == 0):\n            total_sevens += str(i).count('7')\n    return total_sevens\n```"}
{"task_id": "HumanEval/38", "solution": "```python\ndef decode_cyclic(s: str):\n    \"\"\"\n    takes as input string encoded with encode_cyclic function. Returns decoded string.\n    \"\"\"\n    # split string to groups. Each of length 3.\n    groups = [s[(3 * i):min((3 * i + 3), len(s))] for i in range((len(s) + 2) // 3)]\n    # cycle elements in each group backwards. Unless group has fewer elements than 3.\n    groups = [(group[2] + group[0] + group[1]) if len(group) == 3 else group for group in groups]\n    return \"\".join(groups)\n```"}
{"task_id": "HumanEval/39", "solution": "```python\ndef prime_fib(n: int):\n    \"\"\"\n    prime_fib returns n-th number that is a Fibonacci number and it's also prime.\n    >>> prime_fib(1)\n    2\n    >>> prime_fib(2)\n    3\n    >>> prime_fib(3)\n    5\n    >>> prime_fib(4)\n    13\n    >>> prime_fib(5)\n    89\n    \"\"\"\n\n    def is_prime(num: int) -> bool:\n        \"\"\"Checks if a given number is prime.\"\"\"\n        if num <= 1:\n            return False\n        if num <= 3:\n            return True\n        if num % 2 == 0 or num % 3 == 0:\n            return False\n        i = 5\n        while i * i <= num:\n            if num % i == 0 or num % (i + 2) == 0:\n                return False\n            i += 6\n        return True\n\n    def fib_generator():\n        \"\"\"Generates an infinite sequence of Fibonacci numbers, starting from 2.\"\"\"\n        a, b = 1, 2  # Represents F(k-1) and F(k) to start sequence from 2.\n        yield b  # Yield 2 (F_3 in 0-indexed sequence, F_2 if 1-indexed and starting F_1=1, F_2=1).\n        while True:\n            next_fib = a + b\n            a = b\n            b = next_fib\n            yield next_fib\n\n    prime_fib_count = 0\n    for fib_num in fib_generator():\n        if is_prime(fib_num):\n            prime_fib_count += 1\n            if prime_fib_count == n:\n                return fib_num\n```"}
{"task_id": "HumanEval/32", "solution": "```python\nimport math\nfrom typing import List, Callable\nfrom abc import ABC, abstractmethod\n\n\ndef poly(xs: list, x: float):\n    \"\"\"\n    Evaluates polynomial with coefficients xs at point x.\n    return xs[0] + xs[1] * x + xs[1] * x^2 + .... xs[n] * x^n\n    \"\"\"\n    return sum([coeff * math.pow(x, i) for i, coeff in enumerate(xs)])\n\n\n# Constants for numerical methods and search\nDEFAULT_TOLERANCE = 1e-6\nDEFAULT_MAX_ITERATIONS = 100\nINITIAL_SEARCH_RANGE_MIN = -1.0\nINITIAL_SEARCH_RANGE_MAX = 1.0\nEXPANSION_FACTOR = 10.0\nMAX_SEARCH_ATTEMPTS = 10\n\n\nclass NumericalMethodStrategy(ABC):\n    \"\"\"\n    Abstract base class defining the interface for numerical root-finding methods.\n    \"\"\"\n    @abstractmethod\n    def solve(self, func: Callable[[float], float], a: float, b: float, tol: float, max_iter: int) -> float:\n        \"\"\"\n        Finds a root of the given function `func` within the interval `[a, b]`\n        to a specified `tol`erance or `max_iter`ations.\n        \"\"\"\n        pass\n\n\nclass BisectionMethod(NumericalMethodStrategy):\n    \"\"\"\n    Implements the Bisection Method for finding roots of a function.\n    Requires that func(a) and func(b) have opposite signs for convergence.\n    \"\"\"\n    def solve(self, func: Callable[[float], float], a: float, b: float, tol: float, max_iter: int) -> float:\n        fa = func(a)\n        fb = func(b)\n\n        # The Bisection Method fundamentally requires the function to have opposite signs\n        # at the interval endpoints to guarantee a root exists within that interval.\n        if fa * fb > 0:\n            raise ValueError(\"Bisection method requires function to have opposite signs at interval endpoints.\")\n\n        # Check if either endpoint is already a root within tolerance\n        if abs(fa) < tol:\n            return a\n        if abs(fb) < tol:\n            return b\n\n        for _ in range(max_iter):\n            mid = (a + b) / 2\n            f_mid = func(mid)\n\n            # Check for convergence\n            if abs(f_mid) < tol or (b - a) / 2 < tol:\n                return mid\n\n            # Update the interval based on the sign of f_mid\n            if f_mid * fa < 0:  # Root is in [a, mid]\n                b = mid\n                fb = f_mid  # Update fb for consistency\n            else:  # Root is in [mid, b]\n                a = mid\n                fa = f_mid  # Update fa for consistency\n\n        # If max_iter is reached, return the midpoint of the final interval as the best approximation\n        return (a + b) / 2\n\n\ndef find_zero(xs: list):\n    \"\"\" xs are coefficients of a polynomial.\n    find_zero find x such that poly(x) = 0.\n    find_zero returns only only zero point, even if there are many.\n    Moreover, find_zero only takes list xs having even number of coefficients\n    and largest non zero coefficient as it guarantees\n    a solution.\n    >>> round(find_zero([1, 2]), 2) # f(x) = 1 + 2x\n    -0.5\n    >>> round(find_zero([-6, 11, -6, 1]), 2) # (x - 1) * (x - 2) * (x - 3) = -6 + 11x - 6x^2 + x^3\n    1.0\n    \"\"\"\n    if not isinstance(xs, list) or not all(isinstance(c, (int, float)) for c in xs):\n        raise TypeError(\"Coefficients must be a list of numbers.\")\n    if not xs:\n        raise ValueError(\"Coefficients list cannot be empty.\")\n\n    # Create a callable function for polynomial evaluation using the globally available 'poly'\n    poly_func: Callable[[float], float] = lambda x_val: poly(xs, x_val)\n\n    bisection_solver = BisectionMethod()\n\n    # Initialize the search interval\n    a = INITIAL_SEARCH_RANGE_MIN\n    b = INITIAL_SEARCH_RANGE_MAX\n\n    for attempt in range(MAX_SEARCH_ATTEMPTS):\n        # Check if either endpoint of the current interval is already a root\n        if abs(poly_func(a)) < DEFAULT_TOLERANCE:\n            return a\n        if abs(poly_func(b)) < DEFAULT_TOLERANCE:\n            return b\n\n        try:\n            # Attempt to solve using BisectionMethod if a bracketing interval is found\n            # The BisectionMethod itself will check for opposite signs (fa * fb < 0)\n            return bisection_solver.solve(poly_func, a, b, DEFAULT_TOLERANCE, DEFAULT_MAX_ITERATIONS)\n        except ValueError:\n            # If BisectionMethod raises a ValueError, it means the current interval [a, b]\n            # does not bracket a root (i.e., poly_func(a) * poly_func(b) >= 0).\n            # We expand the search interval and try again.\n            a *= EXPANSION_FACTOR\n            b *= EXPANSION_FACTOR\n\n            # Ensure 'a' remains less than 'b' after expansion, especially if values become negative.\n            if a > b:\n                a, b = b, a\n\n    # Fallback: If after all attempts, no bracketing interval is found or bisection failed,\n    # which is an unexpected scenario given the problem's guarantee of a solution for odd-degree polynomials.\n    # As a last resort, attempt to run bisection one more time with the final expanded interval.\n    # If it still raises a ValueError, return the midpoint of the last interval as a best approximation.\n    try:\n        # Before the final solve, re-check for exact roots at the boundaries of the final expanded interval.\n        if abs(poly_func(a)) < DEFAULT_TOLERANCE:\n            return a\n        if abs(poly_func(b)) < DEFAULT_TOLERANCE:\n            return b\n\n        # If still no exact root at boundaries, and if a bracketing interval is finally found, solve.\n        if poly_func(a) * poly_func(b) < 0:\n            return bisection_solver.solve(poly_func, a, b, DEFAULT_TOLERANCE, DEFAULT_MAX_ITERATIONS)\n        else:\n            # If no bracketing interval even after final expansion, and no exact root at endpoints,\n            # return the midpoint of the final interval as a last-resort approximation.\n            return (a + b) / 2\n    except ValueError:\n        # If BisectionMethod still raises ValueError, return the midpoint of the final interval.\n        return (a + b) / 2\n\n```"}
