{"task_id": "HumanEval/8", "solution": "```python\ndef sum_product(numbers: List[int]) -> Tuple[int, int]:\n    \"\"\" For a given list of integers, return a tuple consisting of a sum and a product of all the integers in a list.\n    Empty sum should be equal to 0 and empty product should be equal to 1.\n    >>> sum_product([])\n    (0, 1)\n    >>> sum_product([1, 2, 3, 4])\n    (10, 24)\n    \"\"\"\n    if not numbers:\n        return (0, 1)\n\n    current_sum = 0\n    current_product = 1\n\n    for number in numbers:\n        current_sum += number\n        current_product *= number\n\n    return (current_sum, current_product)\n```"}
{"task_id": "HumanEval/6", "solution": "```python\nfrom typing import List\n\n\ndef parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\" Input to this function is a string represented multiple groups for nested parentheses separated by spaces.\n    For each of the group, output the deepest level of nesting of parentheses.\n    \"\"\"\n\n    # Simulate ParenthesesParser.parse_groups\n    # Split by spaces and filter out any empty strings that might result\n    # from multiple spaces or leading/trailing spaces.\n    group_strings = [group.strip() for group in paren_string.split(' ') if group.strip()]\n\n    depths = []\n    for group_string in group_strings:\n        current_depth = 0\n        max_depth = 0\n        # Simulate DepthCalculator.calculate_max_depth\n        for char in group_string:\n            if char == '(':\n                current_depth += 1\n                max_depth = max(max_depth, current_depth)\n            elif char == ')':\n                # Decrement only if current_depth is positive to avoid negative depth.\n                if current_depth > 0:\n                    current_depth -= 1\n        depths.append(max_depth)\n\n    return depths\n```"}
{"task_id": "HumanEval/9", "solution": "```python\ndef rolling_max(numbers: List[int]) -> List[int]:\n    \"\"\" From a given list of integers, generate a list of rolling maximum element found until given moment\n    in the sequence.\n    >>> rolling_max([1, 2, 3, 2, 3, 4, 2])\n    [1, 2, 3, 3, 3, 4, 4]\n    \"\"\"\n    if not numbers:\n        return []\n\n    rolling_max_list: List[int] = []\n    # Initialize current_max to negative infinity to handle lists with negative numbers correctly.\n    current_max = float('-inf')\n\n    for number in numbers:\n        current_max = max(current_max, number)\n        rolling_max_list.append(int(current_max))\n    return rolling_max_list\n```"}
{"task_id": "HumanEval/11", "solution": "```python\ndef string_xor(a: str, b: str) -> str:\n    \"\"\" Input are two strings a and b consisting only of 1s and 0s.\n    Perform binary XOR on these inputs and return result also as a string.\n    \"\"\"\n    if not all(c in '01' for c in a) or not all(c in '01' for c in b):\n        raise ValueError(\"Input strings must contain only '0's and '1's.\")\n\n    max_len = max(len(a), len(b))\n    a_padded = a.zfill(max_len)\n    b_padded = b.zfill(max_len)\n\n    result_list = []\n    for i in range(max_len):\n        if a_padded[i] == b_padded[i]:\n            result_list.append('0')\n        else:\n            result_list.append('1')\n    return \"\".join(result_list)\n```"}
{"task_id": "HumanEval/10", "solution": "def make_palindrome(string: str) -> str:\n    \"\"\" Find the shortest palindrome that begins with a supplied string.\n    Algorithm idea is simple:\n    - Find the longest postfix of supplied string that is a palindrome.\n    - Append to the end of the string reverse of a string prefix that comes before the palindromic suffix.\n    >>> make_palindrome('')\n    ''\n    >>> make_palindrome('cat')\n    'catac'\n    >>> make_palindrome('cata')\n    'catac'\n    \"\"\"\n    n = len(string)\n    if n == 0:\n        return \"\"\n\n    # Find the smallest index 'i' such that string[i:] is a palindrome.\n    # This identifies the longest palindromic suffix.\n    prefix_end_index = 0\n    for i in range(n):\n        suffix = string[i:]\n        if is_palindrome(suffix):\n            prefix_end_index = i\n            break\n\n    # The prefix before the longest palindromic suffix needs to be reversed.\n    prefix_to_reverse = string[:prefix_end_index]\n    reversed_prefix = prefix_to_reverse[::-1]\n\n    # Concatenate the original string with the reversed prefix to form the shortest palindrome.\n    return string + reversed_prefix"}
{"task_id": "HumanEval/12", "solution": "```python\nfrom typing import List, Optional\n\n\ndef longest(strings: List[str]) -> Optional[str]:\n    \"\"\" Out of list of strings, return the longest one. Return the first one in case of multiple\n    strings of the same length. Return None in case the input list is empty.\n    >>> longest([])\n\n    >>> longest(['a', 'b', 'c'])\n    'a'\n    >>> longest(['a', 'bb', 'ccc'])\n    'ccc'\n    \"\"\"\n    if not strings:\n        return None\n\n    longest_str: Optional[str] = None\n    max_length: int = -1\n\n    for s in strings:\n        if longest_str is None or len(s) > max_length:\n            longest_str = s\n            max_length = len(s)\n    return longest_str\n```"}
