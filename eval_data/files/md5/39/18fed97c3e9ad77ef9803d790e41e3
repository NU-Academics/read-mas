{"task_id": "Mbpp/68", "solution": "def is_Monotonic(array: list) -> bool:\n    \"\"\"Checks if the given array is monotonic (increasing or decreasing).\"\"\"\n    if len(array) <= 1:\n        return True\n\n    is_increasing = True\n    is_decreasing = True\n\n    for i in range(len(array) - 1):\n        if array[i] > array[i+1]:\n            is_increasing = False\n        if array[i] < array[i+1]:\n            is_decreasing = False\n        \n        if not is_increasing and not is_decreasing:\n            return False\n\n    return is_increasing or is_decreasing"}
{"task_id": "Mbpp/72", "solution": "def dif_Square(number: int) -> bool:\n    \"\"\"\n    Checks if the given number can be represented as the difference of two squares.\n    An integer N can be represented as the difference of two squares if N is odd or a multiple of 4.\n    \"\"\"\n    if number % 2 != 0:\n        return True\n    elif number % 4 == 0:\n        return True\n    else:\n        return False"}
{"task_id": "Mbpp/67", "solution": "def bell_number(n: int) -> int:\n    \"\"\"Calculates the Bell number B_n, representing the number of partitions of a set with n elements.\n    It uses a dynamic programming approach based on Aitken's array.\"\"\"\n    if n == 0:\n        return 1\n\n    bell_triangle = [[0 for _ in range(n + 1)] for _ in range(n + 1)]\n    bell_triangle[0][0] = 1\n\n    for i in range(1, n + 1):\n        bell_triangle[i][0] = bell_triangle[i - 1][i - 1]\n        for j in range(1, i + 1):\n            bell_triangle[i][j] = bell_triangle[i - 1][j - 1] + bell_triangle[i][j - 1]\n\n    return bell_triangle[n][0]"}
{"task_id": "Mbpp/69", "solution": "def is_sublist(main_list: list, sub_list: list) -> bool:\n    \"\"\"\n    Checks if 'sub_list' is a contiguous sublist of 'main_list'.\n\n    Args:\n        main_list: The primary list to be searched.\n        sub_list: The list whose contiguous presence is to be checked.\n\n    Returns:\n        True if sub_list is a contiguous sublist of main_list, False otherwise.\n    \"\"\"\n    n = len(main_list)\n    m = len(sub_list)\n\n    if m == 0:\n        return True  # An empty list is always considered a sublist.\n    if m > n:\n        return False # A sublist cannot be longer than the main list.\n\n    for i in range(n - m + 1):\n        if main_list[i:i + m] == sub_list:\n            return True\n            \n    return False"}
{"task_id": "Mbpp/70", "solution": "def get_equal(tuple_list: list[tuple]) -> bool:\n    \"\"\"\n    Determines if all tuples in the given list have equal length.\n    Returns True for an empty list or a list with a single tuple.\n    \"\"\"\n    if not tuple_list or len(tuple_list) == 1:\n        return True\n\n    reference_length = len(tuple_list[0])\n\n    for i in range(1, len(tuple_list)):\n        if len(tuple_list[i]) != reference_length:\n            return False\n\n    return True"}
{"task_id": "Mbpp/71", "solution": "def comb_sort(elements: list) -> list:\n    \"\"\"Sorts a list of elements in ascending order using the Comb Sort algorithm.\n\n    Args:\n        elements: A list of comparable elements.\n\n    Returns:\n        A new list containing the elements sorted in ascending order.\n    \"\"\"\n    n = len(elements)\n    gap = n\n    shrink_factor = 1.3\n    sorted_flag = False\n\n    result_list = list(elements)\n\n    while not sorted_flag:\n        gap = int(gap / shrink_factor)\n        if gap <= 1:\n            gap = 1\n            sorted_flag = True\n\n        i = 0\n        while i + gap < n:\n            if result_list[i] > result_list[i + gap]:\n                result_list[i], result_list[i + gap] = result_list[i + gap], result_list[i]\n                sorted_flag = False\n            i += 1\n    return result_list"}
{"task_id": "Mbpp/74", "solution": "from typing import List\n\ndef is_samepatterns(arr1: List[str], arr2: List[str]) -> bool:\n    \"\"\"\n    Checks if two lists of strings follow the same sequence pattern.\n    This means there is a one-to-one mapping between elements of arr1 and arr2.\n    \"\"\"\n    if len(arr1) != len(arr2):\n        return False\n\n    map1_to_2 = {} # Maps elements from arr1 to arr2\n    map2_to_1 = {} # Maps elements from arr2 to arr1\n\n    for i in range(len(arr1)):\n        elem1 = arr1[i]\n        elem2 = arr2[i]\n\n        # Check consistency for map1_to_2 (arr1 -> arr2)\n        if elem1 in map1_to_2:\n            if map1_to_2[elem1] != elem2:\n                return False\n        else:\n            map1_to_2[elem1] = elem2\n\n        # Check consistency for map2_to_1 (arr2 -> arr1)\n        if elem2 in map2_to_1:\n            if map2_to_1[elem2] != elem1:\n                return False\n        else:\n            map2_to_1[elem2] = elem1\n\n    return True"}
{"task_id": "Mbpp/75", "solution": "def find_tuples(list_of_tuples: list[tuple[int, ...]], k: int) -> list[tuple[int, ...]]:\n    \"\"\"\n    Filters a list of tuples, returning only those where all elements are divisible by k.\n    Assumes k is a non-zero integer.\n    \"\"\"\n    filtered_list = []\n    for current_tuple in list_of_tuples:\n        all_elements_divisible = True\n        for element in current_tuple:\n            if element % k != 0:\n                all_elements_divisible = False\n                break\n        if all_elements_divisible:\n            filtered_list.append(current_tuple)\n    return filtered_list"}
{"task_id": "Mbpp/77", "solution": "def is_Diff(number: int) -> bool:\n    \"\"\"\n    Checks if a number is divisible by 11 by calculating the alternating sum of its digits.\n    The sum is computed by adding digits at even positions and subtracting digits at odd positions (from left).\n    \"\"\"\n    s = str(number)\n    alternating_sum = 0\n    for i, digit_char in enumerate(s):\n        digit = int(digit_char)\n        if i % 2 == 0:  # Digits at even indices (0, 2, ...) are added\n            alternating_sum += digit\n        else:           # Digits at odd indices (1, 3, ...) are subtracted\n            alternating_sum -= digit\n            \n    return alternating_sum % 11 == 0"}
{"task_id": "Mbpp/84", "solution": "def sequence(n: int) -> int:\n    \"\"\"\n    Calculates the nth number of the Newman-Conway sequence using dynamic programming.\n    P(1)=1, P(2)=1, and P(n) = P(P(n-1)) + P(n-P(n-1)) for n > 2.\n    \"\"\"\n    if n == 1 or n == 2:\n        return 1\n\n    # Using a list for memoization (dynamic programming)\n    # The list is 1-indexed for easier mapping to sequence numbers\n    sequence_values = [0] * (n + 1)\n    sequence_values[1] = 1\n    sequence_values[2] = 1\n\n    for i in range(3, n + 1):\n        sequence_values[i] = sequence_values[sequence_values[i-1]] + sequence_values[i - sequence_values[i-1]]\n    \n    return sequence_values[n]"}
