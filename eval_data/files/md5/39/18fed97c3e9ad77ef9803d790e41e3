{"task_id": "Mbpp/61", "solution": "import re\n\ndef count_Substrings(input_string: str) -> int:\n    def _validate_input_string(input_string: str) -> None:\n        \"\"\"Validates that the input string consists solely of digits.\"\"\"\n        if not isinstance(input_string, str):\n            raise TypeError(\"Input must be a string.\")\n        if not re.fullmatch(r'\\d*', input_string):\n            raise ValueError(\"Input string must contain only digits.\")\n\n    def _calculate_substring_properties(sub: str) -> tuple[int, int, bool]:\n        \"\"\"Calculates sum of digits, length, and validity for a substring.\"\"\"\n        length = len(sub)\n        if not sub:\n            return 0, 0, False\n        sum_of_digits = sum(int(digit) for digit in sub)\n        is_valid = (sum_of_digits == length)\n        return sum_of_digits, length, is_valid\n\n    _validate_input_string(input_string)\n\n    total_count = 0\n    n = len(input_string)\n\n    for i in range(n):\n        for j in range(i, n):\n            substring = input_string[i : j + 1]\n            _, _, is_valid = _calculate_substring_properties(substring)\n            if is_valid:\n                total_count += 1\n\n    return total_count"}
{"task_id": "Mbpp/63", "solution": "def max_difference(tuple_list: list[tuple[int | float, int | float]]) -> int | float:\n    \"\"\"Calculates the maximum absolute difference between elements in a list of tuples.\n\n    Args:\n        tuple_list: A list of tuples, where each tuple contains exactly two numerical elements.\n\n    Returns:\n        The maximum absolute difference found among all tuples.\n    \"\"\"\n    max_diff_value = 0\n    for a, b in tuple_list:\n        current_diff = abs(a - b)\n        if current_diff > max_diff_value:\n            max_diff_value = current_diff\n    return max_diff_value"}
