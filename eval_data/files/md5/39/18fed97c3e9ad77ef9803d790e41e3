{"task_id": "Mbpp/581", "solution": "import math\n\ndef surface_Area(base_edge: float, height: float) -> float:\n    # Calculate the slant height using the Pythagorean theorem.\n    slant_height = math.sqrt((base_edge / 2)**2 + height**2)\n    # Calculate the total surface area as the sum of the base area and the lateral surface area.\n    total_surface_area = (base_edge**2) + (2 * base_edge * slant_height)\n    return total_surface_area"}
{"task_id": "Mbpp/583", "solution": "import math\n\ndef catalan_number(n: int) -> int:\n    \"\"\"\n    Calculates the nth Catalan number using the formula C_n = (1 / (n + 1)) * (2n choose n).\n    This implementation uses math.comb for efficient calculation of binomial coefficients.\n    \"\"\"\n    if n < 0:\n        return 0  # Catalan numbers are defined for non-negative integers.\n    return math.comb(2 * n, n) // (n + 1)"}
{"task_id": "Mbpp/585", "solution": "def expensive_items(items: list[dict], n: int) -> list[dict]:\n    \"\"\"\n    Finds the n most expensive items in a given dataset.\n    Returns a list of dictionaries, representing the n most expensive items,\n    sorted by price in descending order.\n    \"\"\"\n    if not items or n <= 0:\n        return []\n\n    sorted_items = sorted(items, key=lambda item: item.get('price', 0), reverse=True)\n\n    return sorted_items[:n]"}
{"task_id": "Mbpp/586", "solution": "def split_Arr(input_list: list, n: int) -> list:\n    \"\"\"\n    Splits a list at the nth element and adds the first part to the end.\n\n    Args:\n        input_list: The list to be split and reordered.\n        n: The index at which to split the list (exclusive for the first part).\n           Must be a non-negative integer.\n\n    Returns:\n        The reordered list.\n\n    Raises:\n        ValueError: If n is negative.\n    \"\"\"\n    if n < 0:\n        raise ValueError(\"Split point 'n' must be a non-negative integer.\")\n\n    first_part = input_list[0:n]\n    second_part = input_list[n:]\n\n    return second_part + first_part"}
{"task_id": "Mbpp/589", "solution": "import math\n\ndef perfect_squares(lowerBound: int, upperBound: int) -> list[int]:\n    # Calculate the square roots of the bounds to determine the range of integers to square.\n    # Iterate through these integers and collect their squares that fall within the given range.\n    if lowerBound > upperBound:\n        return []\n\n    perfect_squares_list = []\n    \n    start_sqrt = math.ceil(math.sqrt(max(0, lowerBound)))\n    end_sqrt = math.floor(math.sqrt(upperBound))\n\n    for i in range(int(start_sqrt), int(end_sqrt) + 1):\n        square = i * i\n        if lowerBound <= square <= upperBound:\n            perfect_squares_list.append(square)\n            \n    return perfect_squares_list"}
{"task_id": "Mbpp/588", "solution": "def _find_largest_value(numbers: list) -> float:\n    \"\"\"Identifies the largest value in a given list of numbers.\"\"\"\n    return max(numbers)\n\ndef _find_smallest_value(numbers: list) -> float:\n    \"\"\"Identifies the smallest value in a given list of numbers.\"\"\"\n    return min(numbers)\n\ndef big_diff(input_list: list) -> float:\n    \"\"\"Calculates the difference between the largest and smallest value in a list.\"\"\"\n    largest_value = _find_largest_value(input_list)\n    smallest_value = _find_smallest_value(input_list)\n    return float(largest_value - smallest_value)"}
