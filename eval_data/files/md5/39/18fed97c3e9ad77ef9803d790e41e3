{"task_id": "Mbpp/765", "solution": "def is_polite(n: int) -> int:\n    \"\"\"\n    Finds the nth polite number.\n    A polite number is a positive integer that can be expressed as the sum of two or more consecutive positive integers.\n    \"\"\"\n    def _is_polite_helper(num: int) -> bool:\n        \"\"\"\n        Checks if a given number is a polite number.\n        A polite number is a positive integer that is not a power of 2.\n        \"\"\"\n        if num <= 0:\n            return False\n        # A number is polite if it's not a power of 2.\n        return (num & (num - 1)) != 0\n\n    polite_numbers_found = 0\n    current_number = 1\n    while True:\n        if _is_polite_helper(current_number):\n            polite_numbers_found += 1\n            if polite_numbers_found == n:\n                return current_number\n        current_number += 1"}
{"task_id": "Mbpp/764", "solution": "def number_ctr(input_string: str) -> int:\n    \"\"\"Counts the number of digit characters in the given string.\n\n    Returns the total count of digit characters (0-9).\n    \"\"\"\n    count = 0\n    for char in input_string:\n        if '0' <= char <= '9':  # Check if the character is a digit\n            count += 1\n    return count"}
{"task_id": "Mbpp/763", "solution": "def find_min_diff(array: tuple[int, ...] | list[int], size: int) -> int:\n    \"\"\"\n    Finds the minimum absolute difference between any two elements in the given array.\n    Raises ValueError if the input array contains fewer than two elements.\n    \"\"\"\n    if size < 2:\n        raise ValueError(\"Array must contain at least two elements.\")\n\n    sorted_array = sorted(array)\n    min_diff = float('inf')\n\n    for i in range(size - 1):\n        # The design context sequence diagram indicates a nested loop\n        # that could be optimized since the array is sorted.\n        # We only need to compare adjacent elements after sorting.\n        current_diff = sorted_array[i+1] - sorted_array[i]\n        min_diff = min(min_diff, current_diff)\n\n    return int(min_diff)"}
{"task_id": "Mbpp/769", "solution": "def Diff(list_a, list_b):\n    \"\"\"\n    Calculates the difference between two lists.\n    Returns a new list containing elements from list_a not present in list_b, preserving order.\n    \"\"\"\n    set_b = set(list_b)\n    result = []\n    for item in list_a:\n        if item not in set_b:\n            result.append(item)\n    return result"}
{"task_id": "Mbpp/770", "solution": "def odd_num_sum(n: int) -> int:\n    \"\"\"\n    Calculates the sum of the fourth power of the first n odd natural numbers.\n    \"\"\"\n    current_sum = 0\n    for i in range(1, n + 1):\n        odd_num = (2 * i - 1)\n        fourth_power = odd_num ** 4\n        current_sum += fourth_power\n    return current_sum"}
{"task_id": "Mbpp/766", "solution": "def pair_wise(input_list: list) -> list[tuple]:\n    \"\"\"Generates a list of all pairs of consecutive items in a given list.\n    Returns an empty list if the input list has fewer than two elements.\n    \"\"\"\n    if len(input_list) < 2:\n        return []\n\n    result = []\n    for i in range(len(input_list) - 1):\n        result.append((input_list[i], input_list[i+1]))\n    return result"}
{"task_id": "Mbpp/767", "solution": "def get_pairs_count(numbers: list[int], target_sum: int) -> int:\n    \"\"\"Counts pairs of numbers in a list that sum to a target value.\n    It uses a frequency map to efficiently count pairs.\n    \"\"\"\n    pair_count = 0\n    frequency_map = {}\n\n    for number in numbers:\n        complement = target_sum - number\n        if complement in frequency_map:\n            pair_count += frequency_map[complement]\n\n        frequency_map[number] = frequency_map.get(number, 0) + 1\n            \n    return pair_count"}
{"task_id": "Mbpp/772", "solution": "def remove_length(input_string: str, k: int) -> str:\n    \"\"\"\n    Removes all words of a specified length k from an input string.\n    Words are separated by spaces.\n    \"\"\"\n    words = input_string.split()\n    filtered_words = [word for word in words if len(word) != k]\n    return ' '.join(filtered_words)"}
{"task_id": "Mbpp/771", "solution": "OPENING_DELIMITERS = {\n    '(': ')',\n    '[': ']',\n    '{': '}'\n}\nCLOSING_DELIMITERS = set(OPENING_DELIMITERS.values())\n\ndef check_expression(expression_string: str) -> bool:\n    \"\"\"\n    Determines if the given expression string has balanced opening and closing delimiters.\n    Uses a stack to track opening delimiters and match them with closing ones.\n    \"\"\"\n    stack = []\n\n    for char in expression_string:\n        if char in OPENING_DELIMITERS:\n            stack.append(char)\n        elif char in CLOSING_DELIMITERS:\n            if not stack:\n                return False\n\n            last_opening = stack.pop()\n            if OPENING_DELIMITERS[last_opening] != char:\n                return False\n\n    return not stack"}
{"task_id": "Mbpp/773", "solution": "from typing import Optional, Tuple\n\ndef occurance_substring(main_string: str, sub_string: str) -> Optional[Tuple[str, int, int]]:\n    \"\"\"\n    Finds the first occurrence and position of a substring within a main string.\n    Returns None if the substring is not found.\n    \"\"\"\n    start_index = main_string.find(sub_string)\n    if start_index != -1:\n        end_index = start_index + len(sub_string)\n        return (sub_string, start_index, end_index)\n    else:\n        return None"}
{"task_id": "Mbpp/775", "solution": "def odd_position(numbers: list[int]) -> bool:\n    \"\"\"\n    Checks if every odd-indexed element in the list is an odd number.\n    Returns True if the condition holds for all odd indices, False otherwise.\n    \"\"\"\n    for i in range(len(numbers)):\n        if i % 2 != 0:  # Check if the index itself is odd\n            if numbers[i] % 2 == 0:  # Check if the number at this odd index is even\n                return False\n    return True"}
{"task_id": "Mbpp/777", "solution": "import collections\n\ndef find_sum(input_list):\n    # Count the frequency of each element in the list.\n    counts = collections.Counter(input_list)\n    total_sum = 0\n    # Sum elements that appear exactly once.\n    for element, count in counts.items():\n        if count == 1:\n            total_sum += element\n    return total_sum"}
{"task_id": "Mbpp/781", "solution": "import math\n\ndef count_divisors(number: int) -> bool:\n    \"\"\"Calculates the number of divisors for a given integer and returns True if the count is even, False otherwise.\"\"\"\n    divisor_count = 0\n    for i in range(1, int(math.sqrt(number)) + 1):\n        if number % i == 0:\n            if i * i == number:\n                divisor_count += 1\n            else:\n                divisor_count += 2\n    return divisor_count % 2 == 0"}
{"task_id": "Mbpp/780", "solution": "import itertools\nfrom typing import List, Tuple, Union\n\ndef find_combinations(tuple_list: List[Tuple[Union[int, float], Union[int, float]]]) -> List[Tuple[Union[int, float], Union[int, float]]]:\n    \"\"\"\n    Finds all unique pairwise combinations of sums with tuples in the given tuple list.\n    Calculates the element-wise sum for each unique pair of input tuples.\n    \"\"\"\n    results = []\n    for t1, t2 in itertools.combinations(tuple_list, 2):\n        sum_tuple = (t1[0] + t2[0], t1[1] + t2[1])\n        results.append(sum_tuple)\n    return results"}
{"task_id": "Mbpp/785", "solution": "def tuple_str_int(input_string: str) -> tuple[int, ...]:\n    \"\"\"Converts a string representing a tuple of numbers into a tuple of integers.\n\n    Args:\n        input_string: The string to convert, e.g., \"(7, 8, 9)\".\n\n    Returns:\n        A tuple of integers, e.g., (7, 8, 9).\n    \"\"\"\n    # 1. Strip outer parentheses.\n    # 2. Split by comma, strip whitespace, and convert each part to int.\n    cleaned_string = input_string.strip('()')\n    if not cleaned_string:  # Handle empty tuple string \"()\"\n        return ()\n    \n    parts = [int(s.strip()) for s in cleaned_string.split(',')]\n    return tuple(parts)"}
{"task_id": "Mbpp/784", "solution": "def _is_even(number: int) -> bool:\n    \"\"\"Checks if an integer is even.\"\"\"\n    return number % 2 == 0\n\ndef _is_odd(number: int) -> bool:\n    \"\"\"Checks if an integer is odd.\"\"\"\n    return number % 2 != 0\n\ndef mul_even_odd(numbers: list[int]) -> int | None:\n    \"\"\"\n    Finds the product of the first even and first odd number in a list.\n    Returns None if either an even or an odd number is not found.\n    \"\"\"\n    first_even: int | None = None\n    first_odd: int | None = None\n\n    for num in numbers:\n        if first_even is None and _is_even(num):\n            first_even = num\n        if first_odd is None and _is_odd(num):\n            first_odd = num\n        if first_even is not None and first_odd is not None:\n            break\n\n    if first_even is not None and first_odd is not None:\n        return first_even * first_odd\n    else:\n        return None"}
{"task_id": "Mbpp/778", "solution": "def pack_consecutive_duplicates(input_list: list) -> list:\n    \"\"\"\n    Packs consecutive duplicates of a given list elements into sublists.\n\n    Args:\n        input_list: A list of elements of any comparable type.\n\n    Returns:\n        A list of sublists, where each sublist contains consecutive duplicate\n        elements from the input list, or a single element if not duplicated.\n    \"\"\"\n    if not input_list:\n        return []\n\n    result = []\n    i = 0\n    n = len(input_list)\n\n    while i < n:\n        current_element = input_list[i]\n        current_sublist = [current_element]\n        j = i + 1\n        while j < n and input_list[j] == current_element:\n            current_sublist.append(input_list[j])\n            j += 1\n        result.append(current_sublist)\n        i = j\n    \n    return result"}
{"task_id": "Mbpp/782", "solution": "def odd_length_sum(arr: list[int]) -> int:\n    \"\"\"Calculates the total sum of all odd length subarrays within a given input array.\"\"\"\n    total_sum = 0\n    n = len(arr)\n\n    for i in range(n):  # Start index\n        for j in range(i, n):  # End index\n            subarray = arr[i : j + 1]\n            if len(subarray) % 2 == 1:\n                total_sum += sum(subarray)\n    return total_sum"}
{"task_id": "Mbpp/786", "solution": "def right_insertion(sorted_list, value):\n    \"\"\"\n    Locates the right insertion point for a specified value in a sorted list.\n    This ensures the value is inserted after any existing equal elements.\n    \"\"\"\n    low = 0\n    high = len(sorted_list)\n\n    while low < high:\n        mid = low + (high - low) // 2\n        if sorted_list[mid] <= value:\n            low = mid + 1\n        else:\n            high = mid\n    return low"}
