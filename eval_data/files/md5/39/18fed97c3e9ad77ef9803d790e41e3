{"task_id": "Mbpp/92", "solution": "def is_undulating(number: int) -> bool:\n    \"\"\"\n    Checks if the given number is undulating. An undulating number consists of digits that strictly\n    alternate between two distinct values.\n    \"\"\"\n    s_number = str(number)\n    n = len(s_number)\n\n    if n < 2:\n        return False\n\n    digit1 = s_number[0]\n    digit2 = s_number[1]\n\n    if digit1 == digit2:\n        return False\n\n    for i in range(2, n):\n        if i % 2 == 0:\n            if s_number[i] != digit1:\n                return False\n        else:\n            if s_number[i] != digit2:\n                return False\n\n    return True"}
{"task_id": "Mbpp/96", "solution": "def divisor(number: int) -> int:\n    \"\"\"\n    Calculates the number of positive divisors for a given integer.\n    It iterates up to the square root of the number to find divisor pairs.\n    \"\"\"\n    count = 0\n    i = 1\n    while i * i <= number:\n        if number % i == 0:\n            if i * i == number:\n                count += 1\n            else:\n                count += 2\n        i += 1\n    return count"}
{"task_id": "Mbpp/100", "solution": "def next_smallest_palindrome(n: int) -> int:\n    \"\"\"\n    Finds the smallest palindrome strictly greater than the input integer n.\n    \"\"\"\n    def is_palindrome(num: int) -> bool:\n        \"\"\"Determines if a given integer is a palindrome.\"\"\"\n        s = str(num)\n        return s == s[::-1]\n\n    num = n + 1\n    while True:\n        if is_palindrome(num):\n            return num\n        num += 1"}
{"task_id": "Mbpp/94", "solution": "def index_minimum(list_of_tuples: list[tuple]) -> any:\n    \"\"\"\n    Returns the first value of the tuple with the smallest second value.\n    Returns None if the input list is empty.\n    \"\"\"\n    if not list_of_tuples:\n        return None\n\n    min_second_value = float('inf')\n    result_first_value = None\n\n    for first_val, second_val, *rest in list_of_tuples:\n        if second_val < min_second_value:\n            min_second_value = second_val\n            result_first_value = first_val\n\n    return result_first_value"}
{"task_id": "Mbpp/98", "solution": "def multiply_num(numbers):\n    \"\"\"\n    Multiplies all numbers in a list and divides the product by the list's length.\n    Handles an empty list by returning 0.0 to avoid division by zero.\n    \"\"\"\n    if not numbers:\n        return 0.0\n\n    product = 1.0\n    for num in numbers:\n        product *= num\n\n    return product / len(numbers)"}
{"task_id": "Mbpp/97", "solution": "from typing import List, Any, Dict\nimport collections\n\ndef frequency_lists(input_list: List[List[Any]]) -> Dict[Any, int]:\n    \"\"\"\n    Flattens a list of lists and calculates the frequency of each element.\n    Returns a dictionary where keys are unique elements and values are their counts.\n    \"\"\"\n    flattened_list = []\n    for sublist in input_list:\n        for item in sublist:\n            flattened_list.append(item)\n\n    return dict(collections.Counter(flattened_list))"}
