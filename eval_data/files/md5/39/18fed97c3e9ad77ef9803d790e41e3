{"task_id": "Mbpp/448", "solution": "_perrin_cache = {0: 3, 1: 0, 2: 2}\n\ndef _perrin(n: int) -> int:\n    \"\"\"Calculates the Nth Perrin number using memoization.\"\"\"\n    if n in _perrin_cache:\n        return _perrin_cache[n]\n    \n    # Perrin number definition: P(n) = P(n-2) + P(n-3) for n > 2\n    _perrin_cache[n] = _perrin(n - 2) + _perrin(n - 3)\n    return _perrin_cache[n]\n\ndef cal_sum(input_integer: int) -> int:\n    \"\"\"Calculates the sum of Perrin numbers from P(0) up to P(input_integer).\"\"\"\n    total_sum = 0\n    for i in range(input_integer + 1):\n        total_sum += _perrin(i)\n    return total_sum"}
{"task_id": "Mbpp/450", "solution": "def extract_string(string_list: list[str], desired_length: int) -> list[str]:\n    \"\"\"\n    Extracts strings of a specified length from a given list of string values.\n    Returns a new list containing only the strings from the input list whose length is precisely equal to desired_length.\n    \"\"\"\n    result_list = []\n    for string_val in string_list:\n        if len(string_val) == desired_length:\n            result_list.append(string_val)\n    return result_list"}
{"task_id": "Mbpp/453", "solution": "def sumofFactors(number: int) -> int:\n    \"\"\"\n    Calculates the sum of all even factors for the given integer `number`.\n    It iterates from 1 up to the number, checking for factors that are even.\n    \"\"\"\n    if number == 0:\n        return 0\n    \n    total_sum = 0\n    # Iterate from 1 up to the absolute value of the number (inclusive)\n    # to find all factors.\n    for i in range(1, abs(number) + 1):\n        # Check if 'i' is a factor of the number and if 'i' is even.\n        if number % i == 0 and i % 2 == 0:\n            total_sum += i\n    return total_sum"}
