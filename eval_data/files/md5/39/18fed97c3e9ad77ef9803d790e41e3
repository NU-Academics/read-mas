{"task_id": "Mbpp/389", "solution": "def find_lucas(n: int) -> int:\n    \"\"\"Calculates the n'th Lucas number.\n\n    Args:\n        n: The non-negative integer index of the Lucas number to find.\n\n    Returns:\n        The n'th Lucas number.\n\n    Raises:\n        ValueError: If n is a negative integer.\n    \"\"\"\n    if n < 0:\n        raise ValueError(\"Input 'n' must be a non-negative integer.\")\n    if n == 0:\n        return 2\n    if n == 1:\n        return 1\n\n    a, b = 2, 1\n    for _ in range(2, n + 1):\n        a, b = b, a + b\n    return b"}
{"task_id": "Mbpp/392", "solution": "_memo = {}\n\ndef get_max_sum(n: int) -> int:\n    \"\"\"\n    Calculates the maximum sum for a given non-negative integer n using a recursive formula with memoization.\n    The formula is f(n) = max( (f(n/2) + f(n/3) + f(n/4) + f(n/5)), n).\n    \"\"\"\n    if n in _memo:\n        return _memo[n]\n\n    if n == 0:\n        result = 0\n    else:\n        sum_of_parts = (\n            get_max_sum(n // 2) +\n            get_max_sum(n // 3) +\n            get_max_sum(n // 4) +\n            get_max_sum(n // 5)\n        )\n        result = max(sum_of_parts, n)\n\n    _memo[n] = result\n    return result"}
{"task_id": "Mbpp/391", "solution": "def convert_list_dictionary(ids: list[str], names: list[str], scores: list[int]) -> list[dict[str, dict[str, int]]]:\n    \"\"\"\n    Converts three parallel lists (identifiers, names, scores) into a list of nested dictionaries.\n    Each resulting dictionary has the form {'identifier': {'name': score}}.\n    \"\"\"\n    if not (len(ids) == len(names) == len(scores)):\n        raise ValueError(\"Input lists must have the same length.\")\n\n    result = []\n    for i in range(len(ids)):\n        inner_dict = {names[i]: scores[i]}\n        outer_dict = {ids[i]: inner_dict}\n        result.append(outer_dict)\n    return result"}
{"task_id": "Mbpp/398", "solution": "def _calculate_sum_of_single_number_digits(number: int) -> int:\n    \"\"\"Computes the sum of individual digits for a given non-negative integer.\"\"\"\n    digit_sum = 0\n    for digit_char in str(number):\n        digit_sum += int(digit_char)\n    return digit_sum\n\ndef sum_of_digits(numbers: list[int]) -> int:\n    \"\"\"Computes the total sum of digits for all numbers in a given list of non-negative integers.\"\"\"\n    total_sum_of_all_digits = 0\n    for number in numbers:\n        total_sum_of_all_digits += _calculate_sum_of_single_number_digits(number)\n    return total_sum_of_all_digits"}
{"task_id": "Mbpp/395", "solution": "def first_non_repeating_character(input_string: str) -> str | None:\n    \"\"\"Finds the first non-repeated character in a string.\n\n    Uses a frequency map to count characters and then iterates to find the first with a count of 1.\n    \"\"\"\n    char_counts = {}\n    for char in input_string:\n        char_counts[char] = char_counts.get(char, 0) + 1\n\n    for char in input_string:\n        if char_counts[char] == 1:\n            return char\n\n    return None"}
