{"task_id": "Mbpp/726", "solution": "def multiply_elements(input_tuple: tuple) -> tuple:\n    \"\"\"Calculates the product of adjacent elements in a tuple of numbers.\n    Returns an empty tuple if the input tuple has less than 2 elements.\"\"\"\n    if len(input_tuple) < 2:\n        return ()\n\n    result_list = []\n    for i in range(len(input_tuple) - 1):\n        result_list.append(input_tuple[i] * input_tuple[i+1])\n\n    return tuple(result_list)"}
{"task_id": "Mbpp/722", "solution": "def filter_data(\n    student_data: dict[str, tuple[float, float]],\n    min_height: float,\n    min_weight: float\n) -> dict[str, tuple[float, float]]:\n    \"\"\"\n    Filters a dictionary of student data based on minimum height and weight criteria.\n    Returns a new dictionary with students meeting both criteria.\n    \"\"\"\n    filtered_students = {}\n    for name, (height, weight) in student_data.items():\n        if height >= min_height and weight >= min_weight:\n            filtered_students[name] = (height, weight)\n    return filtered_students"}
{"task_id": "Mbpp/724", "solution": "def power_base_sum(base: int, power: int) -> int:\n    \"\"\"\n    Calculates the sum of the digits of 'base' raised to 'power'.\n    The function handles potentially very large numbers and sums their digits.\n    \"\"\"\n    result = base ** power\n    sum_of_digits = 0\n    for digit_char in str(result):\n        sum_of_digits += int(digit_char)\n    return sum_of_digits"}
{"task_id": "Mbpp/731", "solution": "import math\n\ndef lateralsurface_cone(r: float, h: float) -> float:\n    \"\"\"\n    Calculates the lateral surface area of a cone.\n    Args: r (float): The radius of the cone's base. h (float): The height of the cone.\n    \"\"\"\n    if r <= 0 or h <= 0:\n        raise ValueError(\"Radius and height must be positive numbers.\")\n\n    slant_height = math.sqrt(r**2 + h**2)\n    lateral_area = math.pi * r * slant_height\n    return lateral_area"}
{"task_id": "Mbpp/721", "solution": "from typing import List\n\nclass Cell:\n    \"\"\"Represents a cell in the matrix with its coordinates and cost.\"\"\"\n    def __init__(self, row: int, col: int, cost: float):\n        self.row = row\n        self.col = col\n        self.cost = cost\n\nclass Path:\n    \"\"\"Encapsulates a path's sequence of cells and its calculated metrics.\"\"\"\n    def __init__(self, sequence_of_cells: List[Cell]):\n        self.sequence_of_cells = list(sequence_of_cells)\n        self.total_cost: float = 0.0\n        self.number_of_cells: int = 0\n        self.average_cost: float = 0.0\n        self.calculate_metrics()\n\n    def calculate_metrics(self):\n        \"\"\"Calculates total cost, number of cells, and average cost for the path.\"\"\"\n        self.total_cost = sum(cell.cost for cell in self.sequence_of_cells)\n        self.number_of_cells = len(self.sequence_of_cells)\n        if self.number_of_cells > 0:\n            self.average_cost = self.total_cost / self.number_of_cells\n        else:\n            self.average_cost = 0.0\n\nclass Matrix:\n    \"\"\"Represents the N*N cost matrix and provides access to its cells.\"\"\"\n    def __init__(self, raw_matrix: List[List[float]]):\n        self.N = len(raw_matrix)\n        self.cells: List[List[Cell]] = []\n        for r in range(self.N):\n            row_cells = []\n            for c in range(self.N):\n                row_cells.append(Cell(r, c, float(raw_matrix[r][c])))\n            self.cells.append(row_cells)\n\n    def get_cell(self, row: int, col: int) -> Cell:\n        \"\"\"Returns the Cell object at the given row and column.\"\"\"\n        return self.cells[row][col]\n\ndef _dfs_find_paths(matrix: Matrix, r: int, c: int, current_path_cells: List[Cell], all_paths: List[Path]) -> None:\n    \"\"\"Recursively explores paths using Depth-First Search to find all valid paths.\"\"\"\n    current_path_cells.append(matrix.get_cell(r, c))\n\n    if r == matrix.N - 1 and c == matrix.N - 1:\n        path_obj = Path(current_path_cells)\n        all_paths.append(path_obj)\n    else:\n        if c + 1 < matrix.N:\n            _dfs_find_paths(matrix, r, c + 1, current_path_cells, all_paths)\n        if r + 1 < matrix.N:\n            _dfs_find_paths(matrix, r + 1, c, current_path_cells, all_paths)\n    \n    current_path_cells.pop()\n\ndef find_all_paths_and_metrics(matrix: Matrix) -> List[Path]:\n    \"\"\"Initiates DFS to identify all valid paths and calculates their metrics.\"\"\"\n    all_paths: List[Path] = []\n    _dfs_find_paths(matrix, 0, 0, [], all_paths)\n    return all_paths\n\ndef calculate_max_average_path(paths: List[Path]) -> float:\n    \"\"\"Determines the maximum average among a list of Path objects.\"\"\"\n    if not paths:\n        return 0.0\n    \n    max_avg = -float('inf')\n    for path in paths:\n        if path.average_cost > max_avg:\n            max_avg = path.average_cost\n    return max_avg\n\ndef maxAverageOfPath(matrix_data: List[List[int]]) -> float:\n    \"\"\"\n    Given a square matrix, finds a path from top-left to bottom-right (moving only right or down)\n    with the maximum average cost.\n    \"\"\"\n    matrix_obj = Matrix(matrix_data)\n    all_paths = find_all_paths_and_metrics(matrix_obj)\n    max_avg = calculate_max_average_path(all_paths)\n    \n    return max_avg"}
{"task_id": "Mbpp/730", "solution": "def consecutive_duplicates(input_list: list) -> list:\n    \"\"\"Removes consecutive duplicate elements from a list.\n\n    Args:\n        input_list: The list from which to remove consecutive duplicates.\n\n    Returns:\n        A new list with consecutive duplicates removed.\n    \"\"\"\n    if not input_list:\n        return []\n\n    result_list = [input_list[0]]\n    for item in input_list[1:]:\n        if item != result_list[-1]:\n            result_list.append(item)\n    return result_list"}
