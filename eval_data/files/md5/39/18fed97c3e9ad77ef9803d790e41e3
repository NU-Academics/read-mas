{"task_id": "Mbpp/260", "solution": "import random\n\n_nsw_cache = {0: 1, 1: 1}\n\ndef _power_mod(base: int, exp: int, mod: int) -> int:\n    \"\"\"Computes (base^exp) % mod efficiently using modular exponentiation.\"\"\"\n    res = 1\n    base %= mod\n    while exp > 0:\n        if exp % 2 == 1:\n            res = (res * base) % mod\n        base = (base * base) % mod\n        exp //= 2\n    return res\n\ndef _miller_rabin_test(d: int, n: int) -> bool:\n    \"\"\"Performs one round of the Miller-Rabin primality test.\"\"\"\n    a = random.randint(2, n - 2)\n    x = _power_mod(a, d, n)\n\n    if x == 1 or x == n - 1:\n        return True\n\n    while d != n - 1:\n        x = (x * x) % n\n        d *= 2\n        if x == 1:\n            return False\n        if x == n - 1:\n            return True\n    return False\n\ndef is_prime(num: int) -> bool:\n    \"\"\"Determines if a given number is prime using trial division for small numbers and Miller-Rabin for larger numbers.\"\"\"\n    if num <= 1:\n        return False\n    if num <= 3:\n        return True\n    if num % 2 == 0 or num % 3 == 0:\n        return False\n\n    # For numbers up to 1000, trial division is efficient enough.\n    if num < 1000:\n        i = 5\n        while i * i <= num:\n            if num % i == 0 or num % (i + 2) == 0:\n                return False\n            i += 6\n        return True\n\n    # Miller-Rabin test for larger numbers.\n    # Find r such that num = 2^r * d + 1 where d is odd.\n    d = num - 1\n    while d % 2 == 0:\n        d //= 2\n\n    # Number of iterations for Miller-Rabin to achieve sufficient certainty.\n    iterations = 5 \n    for _ in range(iterations):\n        if not _miller_rabin_test(d, num):\n            return False\n    return True\n\ndef _calculate_nsw_number(k: int) -> int:\n    \"\"\"Calculates the k-th Newman-Shanks-Williams number S_k, using memoization.\"\"\"\n    if k < 0:\n        return 0 # NSW numbers are defined for non-negative integers.\n    \n    if k in _nsw_cache:\n        return _nsw_cache[k]\n\n    # Calculate and cache numbers up to k iteratively.\n    for i in range(2, k + 1):\n        if i not in _nsw_cache:\n            _nsw_cache[i] = 2 * _nsw_cache[i - 1] + _nsw_cache[i - 2]\n    return _nsw_cache[k]\n\ndef newman_prime(n: int) -> int | None:\n    \"\"\"Finds the Newman-Shanks-Williams number S_n and returns it if it is prime, otherwise None.\"\"\"\n    nsw_number = _calculate_nsw_number(n)\n    if is_prime(nsw_number):\n        return nsw_number\n    return None"}
