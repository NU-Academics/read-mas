{"task_id": "Mbpp/605", "solution": "def prime_num(number: int) -> bool:\n    \"\"\"\n    Checks if the given integer is a prime number.\n    A prime number is a natural number greater than 1 that has no positive divisors other than 1 and itself.\n    \"\"\"\n    if number <= 1:\n        return False\n    if number == 2:\n        return True\n    if number % 2 == 0:\n        return False\n    \n    # Check for factors from 3 up to the square root of number, only odd numbers\n    i = 3\n    while i * i <= number:\n        if number % i == 0:\n            return False\n        i += 2\n    return True"}
{"task_id": "Mbpp/603", "solution": "def get_ludic(n: int) -> list[int]:\n    \"\"\"\n    Calculates and returns a list of all Ludic numbers less than or equal to n.\n    It uses a sieving process where numbers are progressively removed.\n    \"\"\"\n    if n <= 0:\n        return []\n\n    candidates = list(range(1, n + 1))\n    ludic_numbers = []\n\n    while candidates:\n        p = candidates[0]\n        ludic_numbers.append(p)\n        \n        # Remove the current Ludic number 'p' from the candidates list\n        candidates.pop(0)\n\n        # For Ludic numbers greater than 1, remove every p-th element from the remaining candidates\n        if p > 1:\n            new_candidates = []\n            for i in range(len(candidates)):\n                # If the element is not the p-th element (1-indexed position), keep it\n                if (i + 1) % p != 0:\n                    new_candidates.append(candidates[i])\n            candidates = new_candidates\n\n    return ludic_numbers"}
{"task_id": "Mbpp/607", "solution": "import re\n\ndef find_literals(target_string: str, regex_pattern: str) -> tuple[str | None, int, int]:\n    \"\"\"\n    Searches a target string for the first occurrence of a regex pattern.\n    Returns the matched substring, its start index, and its exclusive end index.\n    \"\"\"\n    match = re.search(regex_pattern, target_string)\n    if match:\n        return match.group(0), match.start(), match.end()\n    else:\n        return None, -1, -1"}
{"task_id": "Mbpp/608", "solution": "def bell_Number(n: int) -> int:\n    \"\"\"\n    Calculates the nth Bell number using dynamic programming with Stirling numbers of the second kind.\n    Assumes n is a non-negative integer.\n    \"\"\"\n    if n == 0:\n        return 1\n\n    # S[i][j] will store the Stirling number of the second kind S(i, j).\n    # S(i, j) is the number of ways to partition a set of i elements into j non-empty subsets.\n    S = [[0] * (n + 1) for _ in range(n + 1)]\n\n    # Base case: S(0, 0) = 1 (One way to partition an empty set into zero subsets).\n    S[0][0] = 1\n\n    # Fill the S table using the recurrence relation: S(i, j) = S(i-1, j-1) + j * S(i-1, j).\n    for i in range(1, n + 1):\n        for j in range(1, i + 1):\n            S[i][j] = S[i-1][j-1] + j * S[i-1][j]\n\n    # The nth Bell number B_n is the sum of S(n, k) for k from 0 to n.\n    bell_n = 0\n    for k in range(n + 1):\n        bell_n += S[n][k]\n\n    return bell_n"}
{"task_id": "Mbpp/614", "solution": "def cummulative_sum(data: list[tuple]) -> float:\n    \"\"\"\n    Calculates the cumulative sum of all numeric values found within a list of tuples.\n    Non-numeric values within tuples are ignored.\n    \"\"\"\n    total_sum = 0.0\n    for tpl in data:\n        for item in tpl:\n            if isinstance(item, (int, float)):\n                total_sum += item\n    return total_sum"}
{"task_id": "Mbpp/610", "solution": "def remove_kth_element(input_list, k):\n    \"\"\"\n    Returns a new list with the k-th (1-indexed) element removed from the input list.\n    The original list remains unchanged.\n    \"\"\"\n    # Adjust k to be 0-indexed for list slicing\n    index_to_remove = k - 1\n    \n    # Create a new list by concatenating slices before and after the element to remove\n    return input_list[:index_to_remove] + input_list[index_to_remove + 1:]"}
