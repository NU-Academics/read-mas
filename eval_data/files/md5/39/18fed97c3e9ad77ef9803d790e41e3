{"task_id": "Mbpp/803", "solution": "import math\n\ndef is_perfect_square(number: int) -> bool:\n    \"\"\"\n    Checks if the given number is a perfect square.\n    Negative numbers are not considered perfect squares.\n    \"\"\"\n    if number < 0:\n        return False\n    if number == 0:\n        return True\n    \n    # Calculate the integer square root\n    root = int(math.sqrt(number))\n    # Check if the square of the root equals the original number\n    return root * root == number"}
{"task_id": "Mbpp/799", "solution": "```python\ndef left_rotate(number: int, d: int) -> int:\n    \"\"\"\n    Rotates the bits of a 32-bit integer to the left by d positions.\n    Bits shifted off the most significant end wrap around to the least significant end.\n    \"\"\"\n    \n    # Define the bit length for a 32-bit number\n    BITS = 32\n    \n    # Ensure d is within the range [0, BITS-1]\n    # A rotation by BITS is equivalent to no rotation.\n    d_effective = d % BITS\n    \n    # Perform the left shift and wrap around the bits\n    # (number << d_effective) shifts bits left.\n    # The (number >> (BITS - d_effective)) part brings the overflowed bits to the right end.\n    rotated_number = (number << d_effective) | (number >> (BITS - d_effective))\n    \n    # Mask the result to ensure it remains a 32-bit number\n    # This truncates any bits beyond the 32nd position.\n    return rotated_number & 0xFFFFFFFF\n```"}
{"task_id": "Mbpp/800", "solution": "def remove_all_spaces(input_string: str) -> str:\n    \"\"\"Removes all whitespace characters from the input string.\n\n    This function iterates through the input string and constructs a new string\n    containing only non-whitespace characters, preserving their original order.\n    \"\"\"\n    if not isinstance(input_string, str):\n        raise TypeError(\"Input must be a string.\")\n    return ''.join(char for char in input_string if not char.isspace())"}
{"task_id": "Mbpp/805", "solution": "from typing import List\n\nclass InnerList:\n    \"\"\"Represents a list of numeric elements and provides its sum.\"\"\"\n    def __init__(self, elements: List[int]):\n        self.elements = elements\n        self._sum = sum(elements)\n\n    def get_elements(self) -> List[int]:\n        \"\"\"Returns the raw list of elements.\"\"\"\n        return self.elements\n\n    def get_sum(self) -> int:\n        \"\"\"Returns the calculated sum of elements.\"\"\"\n        return self._sum\n\nclass InputListCollection:\n    \"\"\"Manages a collection of InnerList objects and identifies the one with the maximum sum.\"\"\"\n    def __init__(self, raw_list_of_lists: List[List[int]]):\n        self.inner_lists: List[InnerList] = [InnerList(raw_list) for raw_list in raw_list_of_lists]\n\n    def get_inner_list_with_max_sum(self) -> InnerList:\n        \"\"\"Iterates through inner_lists to find and return the InnerList with the highest sum.\"\"\"\n        return max(self.inner_lists, key=lambda inner_list: inner_list.get_sum())\n\ndef max_sum_list(list_of_lists: List[List[int]]) -> List[int]:\n    \"\"\"\n    Returns the list in a list of lists whose sum of elements is the highest.\n    \"\"\"\n    collection = InputListCollection(list_of_lists)\n    max_inner_list = collection.get_inner_list_with_max_sum()\n    return max_inner_list.get_elements()"}
{"task_id": "Mbpp/804", "solution": "def is_product_even(numbers: list) -> bool:\n    \"\"\"\n    Checks if the product of numbers in a list is an even integer.\n    Returns True if the product is an even integer, False otherwise.\n    \"\"\"\n    product = 1\n    for num in numbers:\n        product *= num\n\n    # Check if the product is an integer\n    if product.is_integer():\n        # Convert to an integer to perform modulo operation reliably\n        int_product = int(product)\n        # Check if the integer product is even\n        return int_product % 2 == 0\n    else:\n        # A non-integer product cannot be \"even\"\n        return False"}
{"task_id": "Mbpp/806", "solution": "def max_run_uppercase(input_string: str) -> int:\n    \"\"\"\n    Calculates the maximum length of consecutive uppercase characters in the given string.\n\n    Returns the maximum length of a consecutive uppercase character run, or 0 if none exist.\n    \"\"\"\n    current_run_length = 0\n    max_run_length = 0\n    for char in input_string:\n        if char.isupper():\n            current_run_length += 1\n        else:\n            max_run_length = max(max_run_length, current_run_length)\n            current_run_length = 0\n    return max(max_run_length, current_run_length)"}
