{"task_id": "Mbpp/440", "solution": "import re\n\ndef find_adverb_position(sentence: str) -> tuple[int, int, str]:\n    \"\"\"\n    Finds the first adverb and its positions in a given sentence.\n    Returns (start_index, end_index, adverb_string) or (-1, -1, \"\") if not found.\n    \"\"\"\n\n    def _is_adverb(word: str) -> bool:\n        \"\"\"Determines if a given word is an adverb, primarily by checking for an '-ly' ending.\"\"\"\n        # This is a simplified check. A real-world scenario would use a dictionary or NLP library.\n        if len(word) > 2 and word.endswith('ly'):\n            # Exclude words like \"apply\", \"fly\" that end in -ly but are not adverbs\n            # This is a basic heuristic and might not catch all exceptions or false positives.\n            if word not in [\"apply\", \"reply\", \"ply\", \"fly\", \"multiply\", \"supply\", \"early\", \"only\", \"holy\"]:\n                return True\n        # Basic common adverbs not ending in -ly\n        common_adverbs = {\"very\", \"well\", \"fast\", \"soon\", \"often\", \"always\", \"never\", \"here\", \"there\", \"now\", \"then\", \"today\", \"yesterday\", \"tomorrow\"}\n        return word.lower() in common_adverbs\n\n    def _strip_punctuation(word_with_punct: str, original_start_index: int) -> tuple[str, int, int]:\n        \"\"\"Removes leading/trailing punctuation and adjusts start/end indices.\"\"\"\n        start_offset = 0\n        end_offset = 0\n\n        # Find leading punctuation\n        for i, char in enumerate(word_with_punct):\n            if not char.isalpha():\n                start_offset += 1\n            else:\n                break\n        \n        # Find trailing punctuation\n        for i in range(len(word_with_punct) - 1, -1, -1):\n            if not word_with_punct[i].isalpha():\n                end_offset += 1\n            else:\n                break\n        \n        cleaned_word = word_with_punct[start_offset : len(word_with_punct) - end_offset]\n        \n        new_start_index = original_start_index + start_offset\n        new_end_index = original_start_index + len(word_with_punct) - end_offset\n        \n        return cleaned_word, new_start_index, new_end_index\n\n    current_index = 0\n    words = re.split(r'(\\s+)', sentence) # Split by spaces, keeping delimiters\n\n    for word_token in words:\n        if not word_token.strip(): # Skip empty strings or just whitespace\n            current_index += len(word_token)\n            continue\n        \n        # Calculate original span of the word_token before stripping\n        original_word_start = current_index\n        original_word_end = current_index + len(word_token)\n\n        cleaned_word, actual_start_index, actual_end_index = _strip_punctuation(word_token, original_word_start)\n\n        if cleaned_word and _is_adverb(cleaned_word):\n            return (actual_start_index, actual_end_index, cleaned_word)\n        \n        current_index = original_word_end\n            \n    return (-1, -1, \"\")"}
