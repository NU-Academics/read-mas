{"task_id": "Mbpp/612", "solution": "def merge(input_list: list) -> list:\n    \"\"\"\n    Transforms a list of two-element sublists into a list of two lists.\n    The first returned list contains all first elements from the input sublists,\n    and the second contains all second elements.\n    \"\"\"\n    first_elements = []\n    second_elements = []\n\n    for sublist in input_list:\n        first_elements.append(sublist[0])\n        second_elements.append(sublist[1])\n\n    return [first_elements, second_elements]"}
{"task_id": "Mbpp/611", "solution": "from typing import List\n\ndef max_of_nth(matrix: List[List[int]], n: int) -> int:\n    \"\"\"\n    Finds the maximum value in the specified column of a matrix.\n    Iterates through each row, extracting the element at the given column index to find the maximum.\n    \"\"\"\n    max_val = float('-inf')\n    for row in matrix:\n        current_val = row[n]\n        if current_val > max_val:\n            max_val = current_val\n    return int(max_val)"}
{"task_id": "Mbpp/615", "solution": "def average_tuple(data: tuple[tuple[int | float, ...], ...]) -> list[float]:\n    \"\"\"Calculates the average value for each inner tuple in a tuple of tuples.\n    Returns a list of these averages as floats.\"\"\"\n    averages = []\n    for inner_tuple in data:\n        if inner_tuple:  # Avoid division by zero for empty tuples\n            current_average = sum(inner_tuple) / len(inner_tuple)\n            averages.append(current_average)\n        else:\n            averages.append(0.0) # or handle as per specific requirement for empty tuples; 0.0 is a reasonable default.\n    return averages"}
{"task_id": "Mbpp/619", "solution": "def move_num(input_string: str) -> str:\n    \"\"\"\n    Separates numeric and non-numeric characters in a string, placing all numbers at the end.\n    The relative order within non-numeric and numeric groups is preserved.\n    \"\"\"\n    non_numeric_chars = []\n    numeric_chars = []\n    for char in input_string:\n        if char.isdigit():\n            numeric_chars.append(char)\n        else:\n            non_numeric_chars.append(char)\n    return \"\".join(non_numeric_chars) + \"\".join(numeric_chars)"}
{"task_id": "Mbpp/618", "solution": "def div_list(list1: list[float | int], list2: list[float | int]) -> list[float]:\n    \"\"\"\n    Performs element-wise division of two lists element-wise.\n    Raises ValueError if lists have different lengths.\n    \"\"\"\n    if len(list1) != len(list2):\n        raise ValueError(\"Lists must have same length\")\n\n    result_list = []\n    for i in range(len(list1)):\n        numerator = float(list1[i])\n        divisor = float(list2[i])\n\n        if divisor == 0:\n            if numerator > 0:\n                result_list.append(float('inf'))\n            elif numerator < 0:\n                result_list.append(float('-inf'))\n            else: # numerator is 0\n                result_list.append(float('nan'))\n        else:\n            result_list.append(numerator / divisor)\n    \n    return result_list"}
{"task_id": "Mbpp/620", "solution": "def largest_subset(numbers: list[int]) -> int:\n    \"\"\"\n    Finds the size of the largest subset of a list of numbers\n    so that every pair in the subset is divisible.\n    \"\"\"\n    if not numbers:\n        return 0\n\n    # Sort the input list to facilitate efficient divisibility checks.\n    numbers.sort()\n    n = len(numbers)\n\n    # dp[i] will store the size of the largest divisible subset ending with numbers[i].\n    dp = [1] * n\n\n    for i in range(n):\n        for j in range(i):\n            # Check if numbers[i] is divisible by numbers[j] (since numbers is sorted).\n            if numbers[i] % numbers[j] == 0:\n                dp[i] = max(dp[i], dp[j] + 1)\n\n    return max(dp)"}
{"task_id": "Mbpp/622", "solution": "def get_median(list1: list[int], list2: list[int], size: int) -> float:\n    \"\"\"\n    Calculates the median of two sorted lists of the same size.\n    The median is the average of the (size-1)-th and size-th elements (0-indexed) of the merged sorted list.\n    \"\"\"\n    i = 0 # Pointer for list1\n    j = 0 # Pointer for list2\n\n    m1 = -1 # To store the (size-1)-th element\n    m2 = -1 # To store the size-th element\n\n    # Iterate to find the (size)-th and (size+1)-th elements of the combined list\n    # which correspond to indices (size-1) and (size) in a 0-indexed array.\n    for count in range(size + 1):\n        if i == size: # list1 exhausted\n            m1 = m2\n            m2 = list2[j]\n            j += 1\n        elif j == size: # list2 exhausted\n            m1 = m2\n            m2 = list1[i]\n            i += 1\n        elif list1[i] <= list2[j]:\n            m1 = m2\n            m2 = list1[i]\n            i += 1\n        else: # list2[j] is smaller\n            m1 = m2\n            m2 = list2[j]\n            j += 1\n\n    return float(m1 + m2) / 2.0"}
