{"task_id": "Mbpp/247", "solution": "def lps(s: str) -> int:\n    n = len(s)\n    \n    if n == 0:\n        return 0\n\n    # dp[i][j] stores the length of the longest palindromic subsequence of substring s[i...j]\n    dp = [[0] * n for _ in range(n)]\n\n    # Base case: A single character is a palindrome of length 1\n    for i in range(n):\n        dp[i][i] = 1\n\n    # Fill the DP table for substrings of length L from 2 to n\n    for L in range(2, n + 1):\n        for i in range(n - L + 1):\n            j = i + L - 1 # End index of the current substring s[i...j]\n\n            if s[i] == s[j]:\n                # If the outer characters match, they contribute 2 to the LPS length,\n                # plus the LPS of the inner substring s[i+1...j-1].\n                # If L is 2 (e.g., \"aa\"), s[i+1...j-1] is an empty string, whose LPS length is 0 (handled by dp[i+1][i] being 0).\n                dp[i][j] = 2 + dp[i+1][j-1]\n            else:\n                # If outer characters don't match, the LPS is either\n                # the LPS of s[i+1...j] (excluding s[i]) or\n                # the LPS of s[i...j-1] (excluding s[j]). Take the maximum.\n                dp[i][j] = max(dp[i+1][j], dp[i][j-1])\n                \n    return dp[0][n-1]"}
{"task_id": "Mbpp/255", "solution": "import itertools\n\ndef combinations_colors(elements: list, n: int) -> list[tuple]:\n    \"\"\"\n    Generates all combinations with repetition of elements from the input list\n    for a specified length n.\n    \"\"\"\n    if n < 0:\n        return []\n    if not elements and n > 0:\n        return []\n    if not elements and n == 0:\n        return [()]\n\n    return [tuple(combo) for combo in itertools.combinations_with_replacement(elements, n)]"}
{"task_id": "Mbpp/252", "solution": "import math\n\ndef convert(z: complex) -> tuple[float, float]:\n    \"\"\"\n    Converts a complex number to its polar coordinates (magnitude, angle).\n\n    Args:\n        z: The complex number to convert.\n\n    Returns:\n        A tuple (magnitude, angle) representing the polar coordinates.\n    \"\"\"\n    real_part = z.real\n    imaginary_part = z.imag\n\n    magnitude = math.sqrt(real_part**2 + imaginary_part**2)\n    angle = math.atan2(imaginary_part, real_part)\n\n    return (magnitude, angle)"}
