{"task_id": "Mbpp/734", "solution": "def sum_Of_Subarray_Prod(input_list: list) -> int:\n    \"\"\"\n    Calculates the sum of products of all possible contiguous sublists of a given list.\n    Iterates through all possible sublists, computes their product, and sums them up.\n    \"\"\"\n    total_sum = 0\n    n = len(input_list)\n\n    for i in range(n):\n        current_product = 1\n        for j in range(i, n):\n            current_product *= input_list[j]\n            total_sum += current_product\n            \n    return total_sum"}
{"task_id": "Mbpp/733", "solution": "from typing import List, Union\n\ndef find_first_occurrence(array: List[Union[int, float]], target_number: Union[int, float]) -> int:\n    \"\"\"\n    Finds the index of the first occurrence of a target number in a sorted array using binary search.\n    Returns the index if found, otherwise -1.\n    \"\"\"\n    low = 0\n    high = len(array) - 1\n    result = -1\n\n    while low <= high:\n        mid = (low + high) // 2\n        if array[mid] == target_number:\n            result = mid\n            high = mid - 1  # Try to find an earlier occurrence in the left half\n        elif array[mid] < target_number:\n            low = mid + 1\n        else: # array[mid] > target_number\n            high = mid - 1\n            \n    return result"}
{"task_id": "Mbpp/735", "solution": "def toggle_middle_bits(number: int) -> int:\n    \"\"\"\n    Toggles all bits of the input number except the most significant bit\n    and the least significant bit.\n    \"\"\"\n    # If the number has 0, 1, or 2 bits, there are no middle bits to toggle.\n    if number.bit_length() <= 2:\n        return number\n\n    msb_pos = number.bit_length() - 1\n\n    # Construct a mask for middle bits, excluding the MSB and LSB.\n    full_mask_up_to_msb = (1 << (msb_pos + 1)) - 1\n    msb_mask = (1 << msb_pos)\n    lsb_mask = 1\n\n    middle_bits_mask = full_mask_up_to_msb ^ msb_mask ^ lsb_mask\n\n    # XOR the number with the middle bits mask to toggle them.\n    return number ^ middle_bits_mask"}
{"task_id": "Mbpp/736", "solution": "def left_insertion(sorted_list: list, value: object) -> int:\n    \"\"\"\n    Locates the left insertion point for a specified value in a sorted list.\n    This is the index of the first possible insertion point if the value is already present.\n    \"\"\"\n    low = 0\n    high = len(sorted_list)\n\n    while low < high:\n        mid = (low + high) // 2\n        if sorted_list[mid] < value:\n            low = mid + 1\n        else:\n            high = mid\n    return low"}
{"task_id": "Mbpp/740", "solution": "def tuple_to_dict(input_tuple: tuple) -> dict:\n    \"\"\"\n    Converts a tuple to a dictionary using adjacent elements as key-value pairs.\n    The element at an even index becomes a key, and the element at the subsequent\n    odd index becomes its value.\n    \"\"\"\n    result = {}\n    for i in range(0, len(input_tuple) - 1, 2):\n        key = input_tuple[i]\n        value = input_tuple[i+1]\n        result[key] = value\n    return result"}
