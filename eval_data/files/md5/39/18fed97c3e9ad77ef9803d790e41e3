{"task_id": "Mbpp/11", "solution": "def remove_Occ(input_string, char_to_remove):\n    \"\"\"\n    Removes the first and last occurrence of a given character from the string.\n    Handles cases where the character is not present or present only once.\n    \"\"\"\n    first_idx = input_string.find(char_to_remove)\n    \n    # If the character is not found, return the original string\n    if first_idx == -1:\n        return input_string\n\n    last_idx = input_string.rfind(char_to_remove)\n\n    # If the character is found only once (first_idx == last_idx)\n    if first_idx == last_idx:\n        return input_string[:first_idx] + input_string[first_idx+1:]\n    \n    # Character found multiple times, remove first and last occurrences\n    # Build the string by skipping characters at first_idx and last_idx\n    return input_string[:first_idx] + input_string[first_idx+1:last_idx] + input_string[last_idx+1:]"}
{"task_id": "Mbpp/6", "solution": "def differ_At_One_Bit_Pos(num1: int, num2: int) -> bool:\n    \"\"\"\n    Checks if two numbers differ at exactly one bit position.\n    This is determined by performing a bitwise XOR and counting the set bits in the result.\n    \"\"\"\n    xor_result = num1 ^ num2\n    return xor_result.bit_count() == 1"}
{"task_id": "Mbpp/8", "solution": "from typing import List\n\nclass Number:\n    \"\"\"Encapsulates a single numeric value and provides its square.\"\"\"\n    def __init__(self, value: float):\n        self._value = value\n\n    def square(self) -> float:\n        \"\"\"Computes and returns the square of the stored value.\"\"\"\n        return self._value * self._value\n\n    def get_value(self) -> float:\n        \"\"\"Returns the original numeric value.\"\"\"\n        return self._value\n\nclass NumberList:\n    \"\"\"Manages a collection of Number objects and orchestrates their squaring.\"\"\"\n    def __init__(self, input_list: List[float]):\n        self._numbers: List[Number] = []\n        for item in input_list:\n            self.add_number(Number(item))\n\n    def add_number(self, num: Number):\n        \"\"\"Adds a single Number object to the internal list.\"\"\"\n        self._numbers.append(num)\n\n    def get_squared_numbers(self) -> List[float]:\n        \"\"\"Iterates through Number objects, squares each, and returns a new list of squared values.\"\"\"\n        squared_values = []\n        for num_obj in self._numbers:\n            squared_values.append(num_obj.square())\n        return squared_values\n\ndef square_nums(input_list: List[float]) -> List[float]:\n    \"\"\"\n    Finds squares of individual elements in a list.\n\n    This function acts as the public entry point, orchestrating the creation of a NumberList and retrieving squared results.\n    \"\"\"\n    number_list_instance = NumberList(input_list)\n    return number_list_instance.get_squared_numbers()"}
{"task_id": "Mbpp/7", "solution": "import re\n\ndef _clean_word(word: str) -> str:\n    \"\"\"Removes leading/trailing non-alphanumeric characters from a word.\"\"\"\n    return re.sub(r'^\\W+|\\W+$', '', word)\n\ndef find_char_long(text: str) -> set[str]:\n    \"\"\"Finds all words at least 4 characters long in a given string.\"\"\"\n    filtered_words = set()\n    for token in text.split():\n        cleaned_word = _clean_word(token)\n        if len(cleaned_word) >= 4:\n            filtered_words.add(cleaned_word)\n    return filtered_words"}
{"task_id": "Mbpp/2", "solution": "def similar_elements(collection1: 'Iterable[Any]', collection2: 'Iterable[Any]') -> 'set[Any]':\n    \"\"\"Finds shared elements between two input collections using set intersection.\"\"\"\n    set1 = set(collection1)\n    set2 = set(collection2)\n    return set1.intersection(set2)"}
{"task_id": "Mbpp/4", "solution": "import heapq\n\ndef heap_queue_largest(numbers: list[int], n: int) -> list[int]:\n    \"\"\"\n    Finds the n largest integers from a list of numbers and returns them in descending order.\n    Uses a min-heap to efficiently track the n largest elements.\n    \"\"\"\n    if not isinstance(n, int) or n <= 0:\n        raise ValueError(\"n must be a positive integer.\")\n\n    if n >= len(numbers):\n        # If n is greater than or equal to the list size, return all numbers sorted descending.\n        return sorted(numbers, reverse=True)\n\n    # Use a min-heap to find the n largest elements\n    # heapq.nsmallest is not used directly because it would require another sort for descending order\n    # after getting the n largest. Building the heap explicitly and sorting at the end is clearer\n    # given the design context.\n    min_heap = []\n    for num in numbers:\n        if len(min_heap) < n:\n            heapq.heappush(min_heap, num)\n        elif num > min_heap[0]:\n            heapq.heapreplace(min_heap, num)\n\n    # The heap now contains the n largest elements. Sort them in descending order.\n    return sorted(min_heap, reverse=True)"}
{"task_id": "Mbpp/9", "solution": "def find_Rotations(input_string: str) -> int:\n    \"\"\"\n    Calculates the minimum number of rotations (greater than 0) required\n    to get the same string.\n    \"\"\"\n    if not input_string:\n        return 0\n    n = len(input_string)\n    for k in range(1, n + 1):\n        if n % k == 0:  # k must be a divisor of n for a perfect repetition\n            prefix = input_string[:k]\n            if prefix * (n // k) == input_string:\n                return k\n    return n"}
{"task_id": "Mbpp/3", "solution": "def is_not_prime(number: int) -> bool:\n    \"\"\"\n    Determines if a given integer is a non-prime number.\n    Returns True if the number is non-prime, False if it is prime.\n    \"\"\"\n    if number <= 1:\n        return True\n    if number == 2:\n        return False\n    if number % 2 == 0:\n        return True\n    \n    i = 3\n    while i * i <= number:\n        if number % i == 0:\n            return True\n        i += 2\n            \n    return False"}
{"task_id": "Mbpp/12", "solution": "from typing import List, Union\n\nclass Row:\n    \"\"\"Encapsulates a single row of numerical elements and provides its sum.\"\"\"\n    def __init__(self, elements: List[Union[int, float]]):\n        self._elements = list(elements)\n        self._sum = sum(elements)\n\n    def get_elements(self) -> List[Union[int, float]]:\n        \"\"\"Returns the elements of the row.\"\"\"\n        return self._elements\n\n    def get_sum(self) -> Union[int, float]:\n        \"\"\"Returns the cached sum of the row's elements.\"\"\"\n        return self._sum\n\n    def __lt__(self, other: 'Row') -> bool:\n        \"\"\"Enables comparison of two Row objects based on their sums for sorting.\"\"\"\n        return self._sum < other._sum\n\nclass Matrix:\n    \"\"\"Manages a collection of Row objects and provides the functionality to sort them by their sums.\"\"\"\n    def __init__(self, data: List[List[Union[int, float]]]):\n        self._rows: List[Row] = [Row(row_data) for row_data in data]\n\n    def sort_by_row_sum(self) -> None:\n        \"\"\"Sorts the internal list of Row objects in ascending order based on their sums.\"\"\"\n        self._rows.sort()\n\n    def to_list(self) -> List[List[Union[int, float]]]:\n        \"\"\"Converts the Matrix object back into a standard list of lists representation.\"\"\"\n        return [row.get_elements() for row in self._rows]\n\ndef sort_matrix(matrix_data: List[List[Union[int, float]]]) -> List[List[Union[int, float]]]:\n    \"\"\"Sorts a given matrix in ascending order according to the sum of its rows.\"\"\"\n    matrix_obj = Matrix(matrix_data)\n    matrix_obj.sort_by_row_sum()\n    return matrix_obj.to_list()"}
