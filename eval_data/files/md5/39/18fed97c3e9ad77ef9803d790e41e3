{"task_id": "Mbpp/166", "solution": "class IntegerPair:\n    \"\"\"Represents an immutable pair of two distinct integers.\"\"\"\n    def __init__(self, a: int, b: int):\n        # Ensures canonical representation for equality and hashing\n        self._first = min(a, b)\n        self._second = max(a, b)\n\n    def get_xor_result(self) -> int:\n        \"\"\"Computes and returns the bitwise XOR of the pair's elements.\"\"\"\n        return self._first ^ self._second\n\n    def __eq__(self, other) -> bool:\n        if not isinstance(other, IntegerPair):\n            return NotImplemented\n        return self._first == other._first and self._second == other._second\n\n    def __hash__(self) -> int:\n        return hash((self._first, self._second))\n\ndef _is_even(number: int) -> bool:\n    \"\"\"Determines if a given integer is an even number.\"\"\"\n    return number % 2 == 0\n\ndef _generate_unique_pairs(numbers: list[int]) -> list[IntegerPair]:\n    \"\"\"Generates all unique pairs of distinct integers from an input list based on their positions.\"\"\"\n    unique_pairs = []\n    n = len(numbers)\n    for i in range(n):\n        for j in range(i + 1, n):\n            unique_pairs.append(IntegerPair(numbers[i], numbers[j]))\n    return unique_pairs\n\ndef find_even_pair(numbers: list[int]) -> int:\n    \"\"\"\n    Counts the number of pairs of integers in a list that xor to an even number.\n    \"\"\"\n    all_pairs = _generate_unique_pairs(numbers)\n    even_pair_count = 0\n    for pair in all_pairs:\n        xor_result = pair.get_xor_result()\n        if _is_even(xor_result):\n            even_pair_count += 1\n    return even_pair_count"}
{"task_id": "Mbpp/224", "solution": "def count_Set_Bits(number: int) -> int:\n    \"\"\"\n    Counts the number of set bits (1s) in the binary representation of a given integer.\n    Uses Brian Kernighan's algorithm for efficiency.\n    \"\"\"\n    count = 0\n    while number > 0:\n        number &= (number - 1)  # Clear the least significant set bit\n        count += 1\n    return count"}
{"task_id": "Mbpp/170", "solution": "def _validate_indices(number_list: list[float | int], start_index: int, end_index: int) -> None:\n    \"\"\"\n    Validates the start and end indices against the number_list bounds.\n    Raises ValueError if indices are out of bounds or for an invalid empty list range.\n    \"\"\"\n    n = len(number_list)\n    if n > 0:\n        if not (0 <= start_index < n):\n            raise ValueError(f\"Start index {start_index} is out of bounds for list of size {n}.\")\n        if not (0 <= end_index < n):\n            raise ValueError(f\"End index {end_index} is out of bounds for list of size {n}.\")\n    elif start_index != 0 or end_index != -1: # For empty list, only (0, -1) is a valid \"empty\" range without error\n        raise ValueError(\"Cannot specify non-empty range for an empty list.\")\n\ndef sum_range_list(number_list: list[float | int], start_index: int, end_index: int) -> float | int:\n    \"\"\"\n    Calculates the sum of numbers in a list within a range specified by two indices (inclusive).\n    Raises ValueError if indices are out of bounds for the given list.\n    \"\"\"\n    if not number_list:\n        if start_index == 0 and (end_index == -1 or end_index == 0):\n            return 0\n        _validate_indices(number_list, start_index, end_index) # Will raise ValueError for invalid ranges on empty list\n\n    _validate_indices(number_list, start_index, end_index)\n\n    if start_index > end_index:\n        return 0\n\n    current_sum = 0\n    for i in range(start_index, end_index + 1):\n        current_sum += number_list[i]\n    return current_sum"}
{"task_id": "Mbpp/222", "solution": "def check_type(input_tuple: tuple) -> bool:\n    \"\"\"\n    Checks if all elements in the input tuple have the same data type.\n    Handles empty tuples and single-element tuples by returning True.\n    \"\"\"\n    if len(input_tuple) <= 1:\n        return True\n\n    first_type = type(input_tuple[0])\n    for element in input_tuple[1:]:\n        if type(element) != first_type:\n            return False\n    return True"}
{"task_id": "Mbpp/223", "solution": "def _find_first_occurrence(arr: list[int], n: int, target: int) -> int:\n    \"\"\"Finds the index of the first occurrence of a target element in a sorted array using binary search.\"\"\"\n    low, high = 0, n - 1\n    result = -1\n    while low <= high:\n        mid = low + (high - low) // 2\n        if arr[mid] == target:\n            result = mid\n            high = mid - 1\n        elif arr[mid] < target:\n            low = mid + 1\n        else:\n            high = mid - 1\n    return result\n\ndef _find_last_occurrence(arr: list[int], n: int, target: int) -> int:\n    \"\"\"Finds the index of the last occurrence of a target element in a sorted array using binary search.\"\"\"\n    low, high = 0, n - 1\n    result = -1\n    while low <= high:\n        mid = low + (high - low) // 2\n        if arr[mid] == target:\n            result = mid\n            low = mid + 1\n        elif arr[mid] < target:\n            low = mid + 1\n        else:\n            high = mid - 1\n    return result\n\ndef is_majority(array: list[int], n: int, element: int) -> bool:\n    \"\"\"\n    Checks if an element is the majority element in a sorted array.\n    A majority element occurs more than n/2 times.\n    \"\"\"\n    first_idx = _find_first_occurrence(array, n, element)\n\n    if first_idx == -1:\n        return False\n\n    last_idx = _find_last_occurrence(array, n, element)\n    \n    count = last_idx - first_idx + 1\n    return count > n / 2"}
