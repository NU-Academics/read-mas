{"task_id": "Mbpp/130", "solution": "from typing import Any, List\nimport collections\n\ndef max_occurrences(input_list: List[Any]) -> Any:\n    \"\"\"\n    Finds the item with the maximum frequency in a given list.\n    Returns the element with the maximum frequency or None if the input list is empty.\n    \"\"\"\n    if not input_list:\n        return None\n\n    # Use collections.Counter to efficiently count item frequencies.\n    counts = collections.Counter(input_list)\n\n    # most_common(1) returns a list of the n most common elements and their counts.\n    # We want the single most common, so we take the first item of this list.\n    # The result is a list like [(item, count)].\n    most_common_items = counts.most_common(1)\n\n    # Extract the item itself from the (item, count) tuple.\n    if most_common_items:\n        return most_common_items[0][0]\n    return None # Should not be reached if input_list is not empty."}
{"task_id": "Mbpp/131", "solution": "def _is_vowel(char: str) -> bool:\n    \"\"\"\n    Checks if a character is a vowel (a, e, i, o, u, case-insensitive), explicitly excluding 'y'.\n    \"\"\"\n    return char.lower() in 'aeiou'\n\ndef reverse_vowels(s: str) -> str:\n    \"\"\"\n    Reverses only the vowels in the input string s, preserving the positions of non-vowel characters.\n    Vowels are 'a', 'e', 'i', 'o', 'u', case-insensitive. 'y' is not considered a vowel.\n    \"\"\"\n    char_list = list(s)\n    vowel_indices = []\n    vowels_found = []\n\n    for i, char in enumerate(char_list):\n        if _is_vowel(char):\n            vowel_indices.append(i)\n            vowels_found.append(char)\n\n    vowels_found.reverse()\n\n    for i, original_index in enumerate(vowel_indices):\n        char_list[original_index] = vowels_found[i]\n\n    return \"\".join(char_list)"}
{"task_id": "Mbpp/137", "solution": "def zero_count(arr: list[int]) -> float:\n    \"\"\"\n    Calculates the ratio of zero elements to non-zero elements in an array of integers.\n\n    Returns 0.0 if the array is empty or contains no non-zero elements.\n    \"\"\"\n    zero_count_val = 0\n    non_zero_count_val = 0\n\n    for x in arr:\n        if x == 0:\n            zero_count_val += 1\n        else:\n            non_zero_count_val += 1\n\n    if non_zero_count_val == 0:\n        return 0.0\n    else:\n        return float(zero_count_val) / non_zero_count_val"}
{"task_id": "Mbpp/133", "solution": "def sum_negativenum(numbers: list) -> (int | float):\n    \"\"\"\n    Calculates the sum of all negative numbers in a given list.\n\n    Args:\n        numbers: A list of numerical values (int or float).\n\n    Returns:\n        The sum of negative numbers. Returns 0 if no negative numbers\n        are found or the list is empty.\n    \"\"\"\n    total_sum = 0\n    for number in numbers:\n        if number < 0:\n            total_sum += number\n    return total_sum"}
{"task_id": "Mbpp/139", "solution": "import math\n\ndef circle_circumference(radius: float) -> float:\n    \"\"\"\n    Calculates the circumference of a circle given its radius.\n    Raises TypeError or ValueError for invalid input.\n    \"\"\"\n    if not isinstance(radius, (int, float)):\n        raise TypeError(\"Radius must be a numerical value (int or float).\")\n    if radius < 0:\n        raise ValueError(\"Radius cannot be negative.\")\n    \n    return 2 * math.pi * radius"}
{"task_id": "Mbpp/161", "solution": "def remove_elements(primary_list: list, secondary_list: list) -> list:\n    \"\"\"\n    Removes all elements from primary_list that are present in secondary_list.\n    Returns a new list with the filtered elements, leaving original lists unchanged.\n    \"\"\"\n    elements_to_remove = set(secondary_list)\n    resultant_list = []\n    for element in primary_list:\n        if element not in elements_to_remove:\n            resultant_list.append(element)\n    return resultant_list"}
{"task_id": "Mbpp/140", "solution": "def extract_singly(input_list: list[tuple[int | float, ...]]) -> set[int | float]:\n    \"\"\"\n    Flattens a list of tuples into a set of unique numbers.\n    Each number from the input tuples is added to the result set.\n    \"\"\"\n    result_set = set()\n    for tpl in input_list:\n        for num in tpl:\n            result_set.add(num)\n    return result_set"}
{"task_id": "Mbpp/141", "solution": "def pancake_sort(input_list: list[float | int]) -> list[float | int]:\n    \"\"\"Sorts a list of numbers in ascending order using the Pancake Sort algorithm.\"\"\"\n    # Create a mutable copy of the input list to perform in-place sorting operations.\n    arr = list(input_list)\n    n = len(arr)\n\n    # Iterate from the end of the list down to the second element.\n    # In each iteration, the largest unsorted element is moved to its correct position.\n    for i in range(n - 1, 0, -1):\n        # Find the index of the maximum element in the current unsorted sublist arr[0...i].\n        max_idx = arr.index(max(arr[:i+1]))\n\n        # If the maximum element is not already at its correct sorted position (index i).\n        if max_idx != i:\n            # First flip: Bring the maximum element to the beginning of the list.\n            arr[:max_idx + 1] = arr[:max_idx + 1][::-1]\n\n            # Second flip: Bring the maximum element from the beginning to its correct position (index i).\n            arr[:i + 1] = arr[:i + 1][::-1]\n    return arr"}
{"task_id": "Mbpp/162", "solution": "def sum_series(n: int) -> int:\n    \"\"\"Calculates the sum of the series (n - 2*i) for i from 0 to n // 2.\n    The series terms are n, n-2, n-4, ..., until the term becomes less than or equal to 0.\n    \"\"\"\n    total_sum = 0\n    # Iterate from i=0 up to n // 2 (inclusive)\n    for i in range(n // 2 + 1):\n        term = n - 2 * i\n        total_sum += term\n    return total_sum"}
{"task_id": "Mbpp/145", "solution": "def max_Abs_Diff(arr: tuple) -> int:\n    \"\"\"\n    Calculates the maximum difference between any two elements in a given array.\n    This is defined as the difference between the maximum and minimum elements.\n    \"\"\"\n    if not arr or len(arr) < 2:\n        return 0\n    return max(arr) - min(arr)"}
{"task_id": "Mbpp/142", "solution": "def count_samepair(list1: list, list2: list, list3: list) -> int:\n    \"\"\"\n    Counts the number of positions where elements are identical in three given lists.\n\n    Args:\n        list1: The first input list.\n        list2: The second input list.\n        list3: The third input list.\n\n    Returns:\n        The total count of identical elements at the same position.\n    \"\"\"\n    count = 0\n    min_length = min(len(list1), len(list2), len(list3))\n\n    for i in range(min_length):\n        if list1[i] == list2[i] == list3[i]:\n            count += 1\n    return count"}
{"task_id": "Mbpp/160", "solution": "from typing import Optional, Tuple\n\ndef find_solution(a: int, b: int, n: int) -> Optional[Tuple[int, int]]:\n    # Handle the special case where both a and b are zero.\n    # If n is also zero, any (x,y) is a solution; (0,0) is a valid choice. Otherwise, no solution.\n    if a == 0 and b == 0:\n        return (0, 0) if n == 0 else None\n\n    # Helper function for Extended Euclidean Algorithm.\n    # Finds g = gcd(a_val, b_val) and x_coeff, y_coeff such that a_val * x_coeff + b_val * y_coeff = g.\n    def _extended_gcd(a_val: int, b_val: int) -> Tuple[int, int, int]:\n        if b_val == 0:\n            return (a_val, 1, 0)\n        else:\n            g, x_prime, y_prime = _extended_gcd(b_val, a_val % b_val)\n            x_coeff = y_prime\n            y_coeff = x_prime - (a_val // b_val) * y_prime\n            return (g, x_coeff, y_coeff)\n\n    # Calculate gcd and coefficients for abs(a) and abs(b).\n    g, x_coeff_abs, y_coeff_abs = _extended_gcd(abs(a), abs(b))\n\n    # If n is not divisible by g, no integer solution exists.\n    if n % g != 0:\n        return None\n\n    # Scale the coefficients to find a particular solution for a*x + b*y = n.\n    factor = n // g\n\n    # Adjust x and y coefficients based on the original signs of a and b for the equation a*x + b*y = g.\n    x_g_orig = x_coeff_abs if a >= 0 else -x_coeff_abs\n    y_g_orig = y_coeff_abs if b >= 0 else -y_coeff_abs\n\n    # Calculate a particular solution (x_p, y_p).\n    x_p = x_g_orig * factor\n    y_p = y_g_orig * factor\n\n    # Determine the final solution (x_final, y_final) with appropriate handling for a=0 or b=0, and normalization.\n    if b == 0:\n        # If b is 0, then a*x = n. x is uniquely determined, y can be anything (we return 0 for y).\n        x_final = n // a\n        y_final = y_p # which is 0\n    elif a == 0:\n        # If a is 0, then b*y = n. y is uniquely determined, x can be anything (we return 0 for x).\n        x_final = x_p # which is 0\n        y_final = n // b\n    else:\n        # Both a and b are non-zero. Normalize x to the smallest non-negative value.\n        b_over_g_abs = abs(b // g)\n        x_final = (x_p % b_over_g_abs + b_over_g_abs) % b_over_g_abs\n        y_final = (n - a * x_final) // b # Calculate the corresponding y.\n\n    return (x_final, y_final)"}
{"task_id": "Mbpp/167", "solution": "def next_power_of_2(n: int) -> int:\n    if n <= 1:\n        return 1\n    n -= 1\n    n |= n >> 1\n    n |= n >> 2\n    n |= n >> 4\n    n |= n >> 8\n    n |= n >> 16\n    n |= n >> 32 # Covers up to 2^64-1 for typical systems\n    return n + 1"}
{"task_id": "Mbpp/165", "solution": "def _get_alphabet_position(char: str) -> int | None:\n    \"\"\"\n    Determines the 0-indexed position of an English alphabet character.\n    Returns None if the character is not an English alphabet letter.\n    \"\"\"\n    if 'a' <= char <= 'z':\n        return ord(char) - ord('a')\n    return None\n\ndef count_char_position(input_string: str) -> int:\n    \"\"\"\n    Counts characters in a string whose 0-indexed position matches their\n    0-indexed English alphabet position (case-insensitive).\n    \"\"\"\n    count = 0\n    for index, char in enumerate(input_string):\n        char_lower = char.lower()\n        alphabet_pos = _get_alphabet_position(char_lower)\n\n        if alphabet_pos is not None and index == alphabet_pos:\n            count += 1\n    return count"}
