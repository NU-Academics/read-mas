{"task_id": "Mbpp/597", "solution": "def find_kth(arr1: list[int], arr2: list[int], k: int) -> int:\n    \"\"\"Finds the k-th smallest element from two given sorted arrays using a two-pointer merge approach.\n    It iterates through both arrays simultaneously, counting elements until the k-th is found.\"\"\"\n    \n    p1, p2 = 0, 0\n    count = 0 \n\n    while p1 < len(arr1) and p2 < len(arr2):\n        count += 1\n        if arr1[p1] < arr2[p2]:\n            if count == k:\n                return arr1[p1]\n            p1 += 1\n        else:\n            if count == k:\n                return arr2[p2]\n            p2 += 1\n    \n    while p1 < len(arr1):\n        count += 1\n        if count == k:\n            return arr1[p1]\n        p1 += 1\n    \n    while p2 < len(arr2):\n        count += 1\n        if count == k:\n            return arr2[p2]\n        p2 += 1"}
{"task_id": "Mbpp/590", "solution": "import math\n\ndef polar_rect(r: float, theta: float) -> tuple[float, float]:\n    \"\"\"\n    Converts polar coordinates (r, theta) to rectangular coordinates (x, y).\n    Raises ValueError if r is negative.\n    \"\"\"\n    if r < 0:\n        raise ValueError(\"Radius 'r' must be non-negative.\")\n    x = r * math.cos(theta)\n    y = r * math.sin(theta)\n    return (x, y)"}
{"task_id": "Mbpp/592", "solution": "import math\n\ndef sum_Of_product(n: int) -> int:\n    \"\"\"\n    Calculates the sum of the product of consecutive binomial coefficients C(n, k) * C(n, k+1)\n    for k ranging from 0 to n-1.\n    \"\"\"\n    total_sum = 0\n    for k in range(n):\n        coeff_k = math.comb(n, k)\n        coeff_k_plus_1 = math.comb(n, k + 1)\n        total_sum += coeff_k * coeff_k_plus_1\n    return total_sum"}
{"task_id": "Mbpp/594", "solution": "def is_even(number: int) -> bool:\n    \"\"\"Checks if a number is even.\"\"\"\n    return number % 2 == 0\n\ndef is_odd(number: int) -> bool:\n    \"\"\"Checks if a number is odd.\"\"\"\n    return number % 2 != 0\n\ndef find_first_even(numbers: list[int]) -> int:\n    \"\"\"Finds the first even number in a list. Assumes an even number will always be found.\"\"\"\n    for num in numbers:\n        if is_even(num):\n            return num\n    # This line should be unreachable based on the problem's implicit assumption that\n    # valid inputs always contain both an even and an odd number, given the\n    # constraint to not raise exceptions for edge cases.\n    return 0 \n\ndef find_first_odd(numbers: list[int]) -> int:\n    \"\"\"Finds the first odd number in a list. Assumes an odd number will always be found.\"\"\"\n    for num in numbers:\n        if is_odd(num):\n            return num\n    # This line should be unreachable based on the problem's implicit assumption that\n    # valid inputs always contain both an even and an odd number, given the\n    # constraint to not raise exceptions for edge cases.\n    return 0 \n\ndef diff_even_odd(numbers: list[int]) -> int:\n    \"\"\"\n    Calculates the absolute difference between the first even and first odd number in the list.\n    Assumes the input list contains at least one even and one odd number.\n    \"\"\"\n    first_even = find_first_even(numbers)\n    first_odd = find_first_odd(numbers)\n    \n    return abs(first_even - first_odd)"}
{"task_id": "Mbpp/598", "solution": "def armstrong_number(n: int) -> bool:\n    \"\"\"\n    Checks if a given integer `n` is an Armstrong number.\n    An Armstrong number is one whose sum of digits raised to the power of the number of digits equals the number itself.\n    \"\"\"\n    if n < 0:  # Armstrong numbers are typically defined for positive integers\n        return False\n\n    original_num = n\n    digit_count = 0\n    temp_num = n\n    if temp_num == 0:\n        digit_count = 1\n    else:\n        while temp_num > 0:\n            temp_num //= 10\n            digit_count += 1\n\n    sum_of_powers = 0\n    temp_num = n\n    while temp_num > 0:\n        digit = temp_num % 10\n        sum_of_powers += digit ** digit_count\n        temp_num //= 10\n\n    return sum_of_powers == original_num"}
{"task_id": "Mbpp/602", "solution": "from typing import Optional\n\ndef first_repeated_char(input_string: str) -> Optional[str]:\n    \"\"\"\n    Finds the first character that repeats in the given string.\n    Returns the first repeated character as a string of length 1, or None if no character repeats.\n    \"\"\"\n    seen_chars = set()\n    for char in input_string:\n        if char in seen_chars:\n            return char\n        seen_chars.add(char)\n    return None"}
