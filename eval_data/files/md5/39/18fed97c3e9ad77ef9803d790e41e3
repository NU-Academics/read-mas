{"task_id": "Mbpp/555", "solution": "def difference(n: int) -> int:\n    \"\"\"\n    Calculates the difference between the sum of cubes of the first n natural numbers\n    and the sum of the first n natural numbers.\n    \"\"\"\n    sum_of_n_natural_numbers = n * (n + 1) // 2\n    sum_of_cubes_of_n_natural_numbers = sum_of_n_natural_numbers ** 2\n    result = sum_of_cubes_of_n_natural_numbers - sum_of_n_natural_numbers\n    return result"}
{"task_id": "Mbpp/557", "solution": "def toggle_string(input_string: str) -> str:\n    \"\"\"Toggles the case of all alphabetic characters in a string.\n    Uppercase characters become lowercase, and lowercase become uppercase; other characters remain unchanged.\n    \"\"\"\n    toggled_chars = []\n    for char in input_string:\n        if char.isupper():\n            toggled_chars.append(char.lower())\n        elif char.islower():\n            toggled_chars.append(char.upper())\n        else:\n            toggled_chars.append(char)\n    return \"\".join(toggled_chars)"}
{"task_id": "Mbpp/559", "solution": "def max_sub_array_sum(numbers: list) -> int:\n    \"\"\"\n    Calculates the sum of the largest contiguous sublist in the given list.\n    Handles empty lists (returns 0) and lists of all negative numbers (returns the largest single negative).\n    \"\"\"\n    if not numbers:\n        return 0\n\n    max_so_far = numbers[0]\n    current_max = numbers[0]\n\n    for i in range(1, len(numbers)):\n        current_max = max(numbers[i], current_max + numbers[i])\n        max_so_far = max(max_so_far, current_max)\n\n    return max_so_far"}
