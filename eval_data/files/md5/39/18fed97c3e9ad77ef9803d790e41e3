{"task_id": "Mbpp/56", "solution": "def _reverse_number(n: int) -> int:\n    \"\"\"Calculates the integer reverse of a given number, preserving its sign.\"\"\"\n    if n == 0:\n        return 0\n    sign = -1 if n < 0 else 1\n    abs_n = abs(n)\n    reversed_abs_n = int(str(abs_n)[::-1])\n    return sign * reversed_abs_n\n\ndef check(number: int) -> bool:\n    \"\"\"Checks if a given number is one less than twice its reverse.\"\"\"\n    reversed_number = _reverse_number(number)\n    return number == (2 * reversed_number) - 1"}
