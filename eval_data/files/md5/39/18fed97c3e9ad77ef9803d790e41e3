{"task_id": "Mbpp/129", "solution": "from typing import List\n\ndef magic_square_test(matrix: List[List[int]]) -> bool:\n    \"\"\"\n    Determines if the input matrix is a magic square by orchestrating sum calculations and comparisons.\n    It checks if the matrix is square and if all row, column, and diagonal sums are equal.\n    \"\"\"\n    n = len(matrix)\n\n    # A magic square must have at least one element and be square.\n    if n == 0:\n        return False\n    for row in matrix:\n        if len(row) != n:\n            return False\n\n    def _calculate_row_sums(matrix_local: List[List[int]]) -> List[int]:\n        \"\"\"Calculates the sum of elements for each row of the matrix.\"\"\"\n        return [sum(row) for row in matrix_local]\n\n    def _calculate_col_sums(matrix_local: List[List[int]]) -> List[int]:\n        \"\"\"Calculates the sum of elements for each column of the matrix.\"\"\"\n        n_local = len(matrix_local)\n        col_sums = [0] * n_local\n        for r_idx in range(n_local):\n            for c_idx in range(n_local):\n                col_sums[c_idx] += matrix_local[r_idx][c_idx]\n        return col_sums\n\n    def _calculate_main_diagonal_sum(matrix_local: List[List[int]]) -> int:\n        \"\"\"Calculates the sum of elements along the main diagonal.\"\"\"\n        n_local = len(matrix_local)\n        main_diag_sum = 0\n        for i in range(n_local):\n            main_diag_sum += matrix_local[i][i]\n        return main_diag_sum\n\n    def _calculate_anti_diagonal_sum(matrix_local: List[List[int]]) -> int:\n        \"\"\"Calculates the sum of elements along the anti-diagonal.\"\"\"\n        n_local = len(matrix_local)\n        anti_diag_sum = 0\n        for i in range(n_local):\n            anti_diag_sum += matrix_local[i][n_local - 1 - i]\n        return anti_diag_sum\n\n    def _all_sums_equal(sums: List[int]) -> bool:\n        \"\"\"Determines if all provided sums in a list are equal.\"\"\"\n        if not sums:\n            return True # Vacuously true for an empty list of sums, though not expected here.\n        first_sum = sums[0]\n        for s in sums:\n            if s != first_sum:\n                return False\n        return True\n\n    # Calculate all required sums\n    row_sums = _calculate_row_sums(matrix)\n    col_sums = _calculate_col_sums(matrix)\n    main_diag_sum = _calculate_main_diagonal_sum(matrix)\n    anti_diag_sum = _calculate_anti_diagonal_sum(matrix)\n\n    # Collect all sums into a single list for comparison\n    all_sums = []\n    all_sums.extend(row_sums)\n    all_sums.extend(col_sums)\n    all_sums.append(main_diag_sum)\n    all_sums.append(anti_diag_sum)\n\n    # Check if all collected sums are equal\n    return _all_sums_equal(all_sums)"}
