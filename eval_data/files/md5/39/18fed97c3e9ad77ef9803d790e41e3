{"task_id": "Mbpp/751", "solution": "def check_min_heap(arr: list) -> bool:\n    \"\"\"Checks if the given array represents a min heap.\"\"\"\n    n = len(arr)\n    if n <= 1:\n        return True\n\n    # Iterate through all parent nodes\n    # The last parent node is at index n // 2 - 1\n    for i in range(n // 2):\n        left_child_idx = 2 * i + 1\n        right_child_idx = 2 * i + 2\n\n        # Check left child\n        if left_child_idx < n and arr[i] > arr[left_child_idx]:\n            return False\n\n        # Check right child\n        if right_child_idx < n and arr[i] > arr[right_child_idx]:\n            return False\n\n    return True"}
{"task_id": "Mbpp/749", "solution": "def sort_numeric_strings(input_list: list[str]) -> list[int | float]:\n    \"\"\"\n    Converts a list of numeric strings to numbers and sorts them numerically in ascending order.\n    Assumes all input strings are valid numerical representations.\n    \"\"\"\n    numeric_list = [int(s) if s.lstrip('-').isdigit() else float(s) for s in input_list]\n    numeric_list.sort()\n    return numeric_list"}
{"task_id": "Mbpp/745", "solution": "def _get_digits(number: int) -> list[int]:\n    \"\"\"\n    Identifies the individual digits of a number.\n    Returns digits in their original order.\n    \"\"\"\n    if number == 0:\n        return [0]\n    digits = []\n    temp_num = abs(number)\n    while temp_num > 0:\n        digits.append(temp_num % 10)\n        temp_num //= 10\n    return digits[::-1]\n\ndef _contains_zero(digits: list[int]) -> bool:\n    \"\"\"\n    Checks if a list of digits contains the digit '0'.\n    \"\"\"\n    return 0 in digits\n\ndef _is_divisible_by_all_digits(number: int, digits: list[int]) -> bool:\n    \"\"\"\n    Determines if a number is divisible by each of its non-zero digits.\n    Precondition: digits list does not contain 0.\n    \"\"\"\n    for digit in digits:\n        if number % digit != 0:\n            return False\n    return True\n\ndef divisible_by_digits(startnum: int, endnum: int) -> list[int]:\n    \"\"\"\n    Finds numbers within a range where every number is divisible by every digit it contains (excluding 0).\n    Returns a list of numbers satisfying the criteria, in ascending order.\n    \"\"\"\n    result_list = []\n    for number in range(startnum, endnum + 1):\n        digits = _get_digits(number)\n\n        if _contains_zero(digits):\n            continue\n\n        if _is_divisible_by_all_digits(number, digits):\n            result_list.append(number)\n\n    return result_list"}
{"task_id": "Mbpp/748", "solution": "def capital_words_spaces(input_string: str) -> str:\n    \"\"\"Inserts spaces before capital letters in a string, excluding the first character.\"\"\"\n    if not input_string:\n        return \"\"\n    if len(input_string) == 1:\n        return input_string\n\n    result_string = input_string[0]\n    for char in input_string[1:]:\n        if char.isupper():\n            result_string += ' ' + char\n        else:\n            result_string += char\n    return result_string"}
{"task_id": "Mbpp/753", "solution": "def min_k(data: list[tuple], k: int) -> list[tuple]:\n    \"\"\"\n    Finds the minimum k records from a list of tuples, sorted by their second element.\n    It returns k elements, or fewer if the list has less than k elements.\n    \"\"\"\n    sorted_data = sorted(data, key=lambda x: x[1])\n    return sorted_data[:k]"}
