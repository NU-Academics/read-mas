{"task_id": "Mbpp/392", "solution": "def get_max_sum(n):\n    memo = {}\n    \n    def helper(num):\n        if num in memo:\n            return memo[num]\n        \n        if num <= 0:\n            return 0\n        \n        recursive_sum = helper(num // 2) + helper(num // 3) + helper(num // 4) + helper(num // 5)\n        result = max(recursive_sum, num)\n        memo[num] = result\n        return result\n    \n    return helper(n)"}
{"task_id": "Mbpp/392", "solution": "def get_max_sum(n):\n    memo = {}\n    \n    def helper(num):\n        if num in memo:\n            return memo[num]\n        \n        if num == 0:\n            return 0\n        \n        # Calculate f(n/2) + f(n/3) + f(n/4) + f(n/5)\n        sum_parts = helper(num // 2) + helper(num // 3) + helper(num // 4) + helper(num // 5)\n        \n        # Return max of sum_parts and num itself\n        result = max(sum_parts, num)\n        memo[num] = result\n        return result\n    \n    return helper(n)"}
