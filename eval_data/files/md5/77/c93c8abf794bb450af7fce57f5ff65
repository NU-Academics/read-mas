{"task_id": "HumanEval/95", "solution": "```python\ndef check_dict_case(dict):\n    \"\"\"\n    Given a dictionary, return True if all keys are strings in lower\n    case or all keys are strings in upper case, else return False.\n    The function should return False is the given dictionary is empty.\n    \"\"\"\n    if not dict:\n        return False\n\n    keys = list(dict.keys())\n\n    # Check if all keys are strings first\n    for key in keys:\n        if not isinstance(key, str):\n            return False\n\n    # Determine if all keys are lowercase\n    all_lower = True\n    for key in keys:\n        if not key.islower():\n            all_lower = False\n            break\n\n    if all_lower:\n        return True\n\n    # Determine if all keys are uppercase\n    all_upper = True\n    for key in keys:\n        if not key.isupper():\n            all_upper = False\n            break\n\n    return all_upper\n```"}
{"task_id": "HumanEval/93", "solution": "def encode(message):\n    \"\"\"\n    Write a function that takes a message, and encodes in such a\n    way that it vibrates case of all letters, replaces all vowels in\n    the message with the letter that appears 2 places ahead of that\n    vowel in the english alphabet.\n    Assume only letters.\n\n    Examples:\n    >>> encode('test')\n    'TGST'\n    >>> encode('This is a message')\n    'tHKS KS C MGSSCGG'\n    \"\"\"\n\n    def _is_english_letter(char: str) -> bool:\n        \"\"\"Checks if a character is an English alphabet letter (a-z, A-Z).\"\"\"\n        return 'a' <= char.lower() <= 'z'\n\n    def _swap_case(char: str) -> str:\n        \"\"\"Swaps the case of an English alphabet letter.\"\"\"\n        return char.swapcase()\n\n    def _is_vowel(char: str) -> bool:\n        \"\"\"Checks if a character is an English vowel (case-insensitive).\"\"\"\n        return char.lower() in 'aeiou'\n\n    def _replace_vowel_two_ahead(char: str) -> str:\n        \"\"\"\n        Replaces a vowel with the letter two places ahead in the English alphabet,\n        maintaining original case and handling wrap-around (e.g., 'Y'->'A').\n        \"\"\"\n        is_upper = char.isupper()\n        lower_char = char.lower()\n\n        char_code = ord(lower_char)\n        new_char_code = char_code + 2\n\n        if new_char_code > ord('z'):\n            new_char_code = ord('a') + (new_char_code - ord('z') - 1)\n\n        result_char = chr(new_char_code)\n\n        if is_upper:\n            return result_char.upper()\n        return result_char\n\n    encoded_chars = []\n    for char in message:\n        if _is_english_letter(char):\n            swapped_char = _swap_case(char)\n            if _is_vowel(swapped_char):\n                final_char = _replace_vowel_two_ahead(swapped_char)\n            else:\n                final_char = swapped_char\n        else:\n            final_char = char\n        encoded_chars.append(final_char)\n\n    return \"\".join(encoded_chars)```"}
{"task_id": "HumanEval/94", "solution": "def skjkasdkd(lst):\n    \"\"\"You are given a list of integers.\n    You need to find the largest prime value and return the sum of its digits.\n    \"\"\"\n    def is_prime(number):\n        \"\"\"Checks if a number is prime.\"\"\"\n        if number <= 1:\n            return False\n        if number == 2:\n            return True\n        if number % 2 == 0:\n            return False\n        i = 3\n        while i * i <= number:\n            if number % i == 0:\n                return False\n            i += 2\n        return True\n\n    def get_sum_of_digits(number):\n        \"\"\"Calculates the sum of the absolute value of the digits of a number.\"\"\"\n        s = 0\n        number = abs(number)\n        while number > 0:\n            s += number % 10\n            number //= 10\n        return s\n\n    largest_prime = -1\n    for num in lst:\n        if is_prime(num):\n            if num > largest_prime:\n                largest_prime = num\n\n    if largest_prime == -1:\n        return 0\n    else:\n        return get_sum_of_digits(largest_prime)"}
