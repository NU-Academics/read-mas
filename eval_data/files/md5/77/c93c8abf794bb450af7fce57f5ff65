{"task_id": "HumanEval/39", "solution": "```python\ndef prime_fib(n: int):\n    \"\"\"\n    prime_fib returns n-th number that is a Fibonacci number and it's also prime.\n    >>> prime_fib(1)\n    2\n    >>> prime_fib(2)\n    3\n    >>> prime_fib(3)\n    5\n    >>> prime_fib(4)\n    13\n    >>> prime_fib(5)\n    89\n    \"\"\"\n\n    def _int_sqrt(num: int) -> int:\n        \"\"\"Calculates the integer square root of a non-negative number.\"\"\"\n        if num < 0:\n            return 0\n        if num == 0:\n            return 0\n        x = num\n        y = (x + 1) // 2\n        while y < x:\n            x = y\n            y = (x + num // x) // 2\n        return x\n\n    class FibonacciSequence:\n        \"\"\"Generates Fibonacci numbers sequentially.\"\"\"\n        def __init__(self):\n            self._a = 0\n            self._b = 1\n\n        def generate_next(self) -> int:\n            \"\"\"Returns the next Fibonacci number in the sequence.\"\"\"\n            current_fib = self._a\n            self._a, self._b = self._b, self._a + self._b\n            return current_fib\n\n    class PrimeChecker:\n        \"\"\"Determines if a given number is a prime number.\"\"\"\n        def is_prime(self, num: int) -> bool:\n            \"\"\"Checks if num is prime.\"\"\"\n            if num < 2:\n                return False\n            if num == 2:\n                return True\n            if num % 2 == 0:\n                return False\n            for i in range(3, _int_sqrt(num) + 1, 2):\n                if num % i == 0:\n                    return False\n            return True\n\n    class PrimeFibonacciCalculator:\n        \"\"\"Orchestrates finding the n-th number that is both a Fibonacci number and a prime number.\"\"\"\n        def __init__(self, fib_sequence: FibonacciSequence, prime_checker: PrimeChecker):\n            self._fib_sequence = fib_sequence\n            self._prime_checker = prime_checker\n\n        def calculate_nth_prime_fib(self, n: int) -> int:\n            \"\"\"Calculates and returns the n-th prime Fibonacci number.\"\"\"\n            prime_fib_count = 0\n            while True:\n                fib_num = self._fib_sequence.generate_next()\n\n                if fib_num <= 1:\n                    continue\n\n                if self._prime_checker.is_prime(fib_num):\n                    prime_fib_count += 1\n                    if prime_fib_count == n:\n                        return fib_num\n\n    fib_seq_instance = FibonacciSequence()\n    prime_checker_instance = PrimeChecker()\n    calculator = PrimeFibonacciCalculator(fib_seq_instance, prime_checker_instance)\n\n    return calculator.calculate_nth_prime_fib(n)\n\n```"}
