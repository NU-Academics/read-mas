{"task_id": "HumanEval/139", "solution": "```python\ndef special_factorial(n):\n    \"\"\"The Brazilian factorial is defined as:\n    brazilian_factorial(n) = n! * (n-1)! * (n-2)! * ... * 1!\n    where n > 0\n\n    For example:\n    >>> special_factorial(4)\n    288\n\n    The function will receive an integer as input and should return the special\n    factorial of this integer.\n    \"\"\"\n    if n <= 0:\n        raise ValueError(\"Input n must be greater than 0.\")\n\n    def _factorial(k):\n        \"\"\"Calculates the standard factorial of an integer k.\"\"\"\n        res = 1\n        for i in range(1, k + 1):\n            res *= i\n        return res\n\n    total_product = 1\n    for i in range(1, n + 1):\n        total_product *= _factorial(i)\n    return total_product\n```"}
{"task_id": "HumanEval/140", "solution": "```python\nimport re\n\ndef fix_spaces(text):\n    \"\"\"\n    Given a string text, replace all spaces in it with underscores,\n    and if a string has more than 2 consecutive spaces,\n    then replace all consecutive spaces with -\n    \"\"\"\n    # First, replace sequences of three or more spaces with a hyphen.\n    modified_text = re.sub(r' {3,}', '-', text)\n\n    # Then, replace any remaining single spaces (or pairs of spaces) with underscores.\n    # This handles the case of \"  \" -> \"__\" and \" \" -> \"_\"\n    final_text = modified_text.replace(' ', '_')\n\n    return final_text\n```"}
{"task_id": "HumanEval/141", "solution": "```python\nclass FileName:\n    \"\"\"Encapsulates a file name string, parses its components, and provides methods for validation.\"\"\"\n    def __init__(self, name: str):\n        self._name = name\n        parts = name.rsplit('.', 1)\n        if len(parts) == 2:\n            self._base_name = parts[0]\n            self._extension = parts[1]\n        else: # No dot\n            self._base_name = parts[0]\n            self._extension = \"\"\n\n    def _validate_digit_count(self) -> bool:\n        \"\"\"Checks if the file name contains no more than three digits.\"\"\"\n        digit_count = sum(1 for char in self._name if '0' <= char <= '9')\n        return digit_count <= 3\n\n    def _validate_single_dot(self) -> bool:\n        \"\"\"Checks if the file name contains exactly one dot.\"\"\"\n        return self._name.count('.') == 1\n\n    def _validate_base_name_not_empty(self) -> bool:\n        \"\"\"Checks if the substring before the dot is not empty.\"\"\"\n        return bool(self._base_name)\n\n    def _validate_base_name_starts_with_letter(self) -> bool:\n        \"\"\"Checks if the substring before the dot starts with a latin alphabet letter.\"\"\"\n        return self._base_name and self._base_name[0].isalpha()\n\n    def _validate_extension_type(self) -> bool:\n        \"\"\"Checks if the extension is one of 'txt', 'exe', or 'dll'.\"\"\"\n        return self._extension in ['txt', 'exe', 'dll']\n\n    def is_valid(self) -> str:\n        \"\"\"Orchestrates all validation rules and returns 'Yes' if all pass, 'No' otherwise.\"\"\"\n        if not self._validate_digit_count():\n            return 'No'\n        if not self._validate_single_dot():\n            return 'No'\n        if not self._validate_base_name_not_empty():\n            return 'No'\n        if not self._validate_base_name_starts_with_letter():\n            return 'No'\n        if not self._validate_extension_type():\n            return 'No'\n        return 'Yes'\n\ndef file_name_check(file_name):\n    \"\"\"Create a function which takes a string representing a file's name, and returns\n    'Yes' if the the file's name is valid, and returns 'No' otherwise.\n    A file's name is considered to be valid if and only if all the following conditions\n    are met:\n    - There should not be more than three digits ('0'-'9') in the file's name.\n    - The file's name contains exactly one dot '.'\n    - The substring before the dot should not be empty, and it starts with a letter from\n    the latin alphapet ('a'-'z' and 'A'-'Z').\n    - The substring after the dot should be one of these: ['txt', 'exe', 'dll']\n    Examples:\n    file_name_check(\"example.txt\") # => 'Yes'\n    file_name_check(\"1example.dll\") # => 'No' (the name should start with a latin alphapet letter)\n    \"\"\"\n    file_validator = FileName(file_name)\n    return file_validator.is_valid()\n```"}
{"task_id": "HumanEval/142", "solution": "def sum_squares(lst):\n    \"\"\"\"\n    This function will take a list of integers. For all entries in the list, the function shall square the integer entry if its index is a\n    multiple of 3 and will cube the integer entry if its index is a multiple of 4 and not a multiple of 3. The function will not\n    change the entries in the list whose indexes are not a multiple of 3 or 4. The function shall then return the sum of all entries.\n\n    Examples:\n    For lst = [1,2,3] the output should be 6\n    For lst = []  the output should be 0\n    For lst = [-1,-5,2,-1,-5]  the output should be -126\n    \"\"\"\n    total_sum = 0\n    for i, num in enumerate(lst):\n        if i % 3 == 0:\n            total_sum += num ** 2\n        elif i % 4 == 0: # This condition implies i % 3 != 0 due to the 'elif'\n            total_sum += num ** 3\n        else:\n            total_sum += num\n    return total_sum"}
{"task_id": "HumanEval/143", "solution": "def words_in_sentence(sentence):\n    \"\"\"Filters words from a sentence, returning only those with prime lengths.\"\"\"\n\n    def _is_prime(number):\n        \"\"\"Checks if a number is prime.\"\"\"\n        if number < 2:\n            return False\n        i = 2\n        while i * i <= number:\n            if number % i == 0:\n                return False\n            i += 1\n        return True\n\n    # No need for _validate_sentence because constraints are handled by problem statement.\n\n    words = sentence.split()\n    prime_length_words = []\n    for word in words:\n        if _is_prime(len(word)):\n            prime_length_words.append(word)\n\n    return \" \".join(prime_length_words)"}
{"task_id": "HumanEval/144", "solution": "class Fraction:\n    \"\"\"Represents a fraction with a numerator and a denominator.\"\"\"\n    def __init__(self, numerator: int, denominator: int):\n        self.numerator = numerator\n        self.denominator = denominator\n\n    @classmethod\n    def from_string(cls, fraction_str: str) -> 'Fraction':\n        \"\"\"Parses a string 'num/den' into a Fraction object.\"\"\"\n        num_str, den_str = fraction_str.split('/')\n        return cls(int(num_str), int(den_str))\n\n    def multiply(self, other: 'Fraction') -> 'Fraction':\n        \"\"\"Multiplies this fraction by another fraction and returns a new Fraction.\"\"\"\n        new_numerator = self.numerator * other.numerator\n        new_denominator = self.denominator * other.denominator\n        return Fraction(new_numerator, new_denominator)\n\n    def is_whole_number(self) -> bool:\n        \"\"\"Checks if the fraction represents a whole number.\"\"\"\n        return self.numerator % self.denominator == 0\n\ndef simplify(x, n):\n    \"\"\"\n    Simplifies the expression x * n. Returns True if x * n evaluates to a whole number,\n    and False otherwise. Both x and n are string representations of fractions.\n    \"\"\"\n    frac_x = Fraction.from_string(x)\n    frac_n = Fraction.from_string(n)\n    product_fraction = frac_x.multiply(frac_n)\n    return product_fraction.is_whole_number()"}
{"task_id": "HumanEval/145", "solution": "```python\ndef order_by_points(nums):\n    \"\"\"\n    Sorts the given list of integers in ascending order based on the sum of their digits,\n    and then by their original index for tie-breaking.\n    \"\"\"\n\n    class _SortableInteger:\n        \"\"\"\n        Helper class to encapsulate an integer's value, sum of its digits,\n        and its original index for custom sorting.\n        \"\"\"\n        def __init__(self, value: int, original_index: int):\n            self._value = value\n            self._sum_of_digits = _calculate_sum_of_digits(value)\n            self._original_index = original_index\n\n        def __lt__(self, other: '_SortableInteger') -> bool:\n            \"\"\"\n            Compares two _SortableInteger objects for sorting.\n            Primary key is sum_of_digits (ascending), secondary key is original_index (ascending).\n            \"\"\"\n            if self._sum_of_digits != other._sum_of_digits:\n                return self._sum_of_digits < other._sum_of_digits\n            return self._original_index < other._original_index\n\n        def get_value(self) -> int:\n            \"\"\"Returns the original integer value.\"\"\"\n            return self._value\n\n    def _calculate_sum_of_digits(number: int) -> int:\n        \"\"\"\n        Calculates the sum of the absolute values of an integer's digits.\n        \"\"\"\n        s = str(abs(number))\n        return sum(int(digit) for digit in s)\n\n    if not nums:\n        return []\n\n    # Create a list of _SortableInteger objects, preserving original indices\n    sortable_items = [\n        _SortableInteger(num, i) for i, num in enumerate(nums)\n    ]\n\n    # Sort the list using the custom __lt__ method of _SortableInteger\n    sortable_items.sort()\n\n    # Extract the original integer values from the sorted _SortableInteger objects\n    return [item.get_value() for item in sortable_items]\n```"}
{"task_id": "HumanEval/146", "solution": "```python\ndef specialFilter(nums):\n    \"\"\"\n    Filters an array of numbers and returns the count of elements that are\n    greater than 10 and have both first and last digits (of their absolute value) as odd.\n    \"\"\"\n\n    def _is_greater_than_ten(num: int) -> bool:\n        \"\"\"Checks if a number is strictly greater than 10.\"\"\"\n        return num > 10\n\n    def _get_first_digit(num: int) -> int:\n        \"\"\"Extracts the first digit from the absolute string representation of a number.\"\"\"\n        abs_str_num = str(abs(num))\n        return int(abs_str_num[0])\n\n    def _get_last_digit(num: int) -> int:\n        \"\"\"Extracts the last digit from the absolute string representation of a number.\"\"\"\n        abs_str_num = str(abs(num))\n        return int(abs_str_num[-1])\n\n    def _is_odd(digit: int) -> bool:\n        \"\"\"Checks if a given digit is odd.\"\"\"\n        return digit % 2 != 0\n\n    count = 0\n    for num in nums:\n        if _is_greater_than_ten(num) and \\\n           _is_odd(_get_first_digit(num)) and \\\n           _is_odd(_get_last_digit(num)):\n            count += 1\n    return count\n```"}
{"task_id": "HumanEval/148", "solution": "```python\ndef bf(planet1, planet2):\n    '''\n    Returns a tuple of planets whose orbits are between planet1 and planet2,\n    sorted by proximity to the sun. Returns an empty tuple for invalid planet names.\n    '''\n    class Planet:\n        def __init__(self, name: str, orbital_order: int):\n            self.name = name\n            self.orbital_order = orbital_order\n\n        def __lt__(self, other: 'Planet') -> bool:\n            return self.orbital_order < other.orbital_order\n\n    class SolarSystem:\n        _instance = None\n        _planets_data = []\n        _planet_names_to_order = {}\n\n        def __new__(cls):\n            if cls._instance is None:\n                cls._instance = super(SolarSystem, cls).__new__(cls)\n                cls._initialize_data()\n            return cls._instance\n\n        @classmethod\n        def _initialize_data(cls):\n            if not cls._planets_data: # Initialize only once\n                planet_names = [\n                    \"Mercury\", \"Venus\", \"Earth\", \"Mars\",\n                    \"Jupiter\", \"Saturn\", \"Uranus\", \"Neptune\"\n                ]\n                for i, name in enumerate(planet_names):\n                    planet = Planet(name, i)\n                    cls._planets_data.append(planet)\n                    cls._planet_names_to_order[name] = i\n\n        def get_planet_order(self, planet_name: str) -> int:\n            return self._planet_names_to_order.get(planet_name, -1) # Use -1 for invalid\n\n        def is_valid_planet(self, planet_name: str) -> bool:\n            return planet_name in self._planet_names_to_order\n\n        def get_planets_between(self, order1: int, order2: int) -> tuple[str, ...]:\n            min_order = min(order1, order2)\n            max_order = max(order1, order2)\n\n            between_planets = []\n            for planet in self._planets_data:\n                if min_order < planet.orbital_order < max_order:\n                    between_planets.append(planet.name)\n\n            return tuple(between_planets)\n\n    solar_system = SolarSystem()\n\n    if not solar_system.is_valid_planet(planet1) or not solar_system.is_valid_planet(planet2):\n        return ()\n\n    order1 = solar_system.get_planet_order(planet1)\n    order2 = solar_system.get_planet_order(planet2)\n\n    return solar_system.get_planets_between(order1, order2)\n```"}
{"task_id": "HumanEval/149", "solution": "def sorted_list_sum(lst):\n    \"\"\"Filters strings by even length and then sorts them.\n    Strings with odd lengths are removed, and the remaining are sorted by length, then alphabetically.\n    \"\"\"\n    even_length_strings = [s for s in lst if len(s) % 2 == 0]\n    # Sort primarily by length, secondarily by alphabetical order.\n    return sorted(even_length_strings, key=lambda s: (len(s), s))"}
{"task_id": "HumanEval/147", "solution": "```python\ndef _generate_array_a(n: int) -> list[int]:\n    \"\"\"Creates array a where a[i] = i * i - i + 1 for i from 1 to n.\"\"\"\n    arr_a = [0] * n\n    for i in range(1, n + 1):\n        arr_a[i - 1] = i * i - i + 1\n    return arr_a\n\ndef _count_valid_triples(arr_a: list[int]) -> int:\n    \"\"\"Counts triples (a[i], a[j], a[k]) from arr_a with i < j < k whose sum is a multiple of 3.\"\"\"\n    n = len(arr_a)\n    count = 0\n    for i in range(n):\n        for j in range(i + 1, n):\n            for k in range(j + 1, n):\n                current_sum = arr_a[i] + arr_a[j] + arr_a[k]\n                if current_sum % 3 == 0:\n                    count += 1\n    return count\n\ndef get_max_triples(n):\n    \"\"\"\n    You are given a positive integer n. You have to create an integer array a of length n.\n        For each i (1 \u2264 i \u2264 n), the value of a[i] = i * i - i + 1.\n        Return the number of triples (a[i], a[j], a[k]) of a where i < j < k,\n    and a[i] + a[j] + a[k] is a multiple of 3.\n\n    Example :\n        Input: n = 5\n        Output: 1\n        Explanation:\n        a = [1, 3, 7, 13, 21]\n        The only valid triple is (1, 7, 13).\n    \"\"\"\n    # Create and populate array 'a' based on the given formula.\n    arr_a = _generate_array_a(n)\n\n    # Count the valid triples whose sum is a multiple of 3.\n    count = _count_valid_triples(arr_a)\n\n    return count\n```"}
{"task_id": "HumanEval/150", "solution": "```python\ndef x_or_y(n, x, y):\n    \"\"\"A simple program which should return the value of x if n is\n    a prime number and should return the value of y otherwise.\n\n    Examples:\n    for x_or_y(7, 34, 12) == 34\n    for x_or_y(15, 8, 5) == 5\n\n    \"\"\"\n    def _is_prime(n: int) -> bool:\n        \"\"\"Determines if a given integer n is a prime number.\"\"\"\n        if n <= 1:\n            return False\n        if n <= 3:\n            return True\n        if n % 2 == 0 or n % 3 == 0:\n            return False\n        i = 5\n        while i * i <= n:\n            if n % i == 0 or n % (i + 2) == 0:\n                return False\n            i += 6\n        return True\n\n    if _is_prime(n):\n        return x\n    else:\n        return y\n```"}
{"task_id": "HumanEval/152", "solution": "```python\ndef compare(game,guess):\n    \"\"\"I think we all remember that feeling when the result of some long-awaited\n    event is finally known. The feelings and thoughts you have at that moment are\n    definitely worth noting down and comparing.\n    Your task is to determine if a person correctly guessed the results of a number of matches.\n    You are given two arrays of scores and guesses of equal length, where each index shows a match.\n    Return an array of the same length denoting how far off each guess was. If they have guessed correctly,\n    the value is 0, and if not, the value is the absolute difference between the guess and the score.\n\n\n    example:\n\n    compare([1,2,3,4,5,1],[1,2,3,4,2,-2]) -> [0,0,0,0,3,3]\n    compare([0,5,0,0,0,4],[4,1,1,0,0,-2]) -> [4,4,1,0,0,6]\n    \"\"\"\n    result = []\n    for game_score, guess_score in zip(game, guess):\\\n        if game_score == guess_score:\\\n            result.append(0)\\\n        else:\\\n            result.append(abs(game_score - guess_score))\\\n    return result\n```"}
{"task_id": "HumanEval/151", "solution": "```python\ndef double_the_difference(lst):\n    '''\n    Given a list of numbers, return the sum of squares of the numbers\n    in the list that are odd. Ignore numbers that are negative or not integers.\n\n    double_the_difference([1, 3, 2, 0]) == 1 + 9 + 0 + 0 = 10\n    double_the_difference([-1, -2, 0]) == 0\n    double_the_difference([9, -2]) == 81\n    double_the_difference([0]) == 0\n\n    If the input list is empty, return 0.\n    '''\n    total_sum = 0\n    if not lst:\n        return 0\n\n    for element in lst:\n        if not isinstance(element, int):\n            continue\n\n        if element < 0:\n            continue\n\n        if element % 2 != 0:\n            square = element * element\n            total_sum += square\n\n    return total_sum\n```"}
{"task_id": "HumanEval/153", "solution": "```python\ndef _calculate_strength(extension_name: str) -> int:\n    \"\"\"Calculates the strength of an extension name.\n    Strength is CAP - SM, where CAP is uppercase count and SM is lowercase count.\n    \"\"\"\n    CAP = 0\n    SM = 0\n    for char in extension_name:\n        if char.isupper():\n            CAP += 1\n        elif char.islower():\n            SM += 1\n    return CAP - SM\n\ndef Strongest_Extension(class_name, extensions):\n    \"\"\"Finds the strongest extension based on CAP - SM strength and returns it in ClassName.StrongestExtensionName format.\n    The first extension with the maximum strength is chosen in case of a tie.\n    \"\"\"\n    max_strength = -float('inf')\n    strongest_extension_name = \"\"\n\n    for extension in extensions:\n        current_strength = _calculate_strength(extension)\n        if current_strength > max_strength:\n            max_strength = current_strength\n            strongest_extension_name = extension\n\n    return f\"{class_name}.{strongest_extension_name}\"\n```"}
{"task_id": "HumanEval/155", "solution": "```python\nclass _Digit:\n    def __init__(self, value: int):\n        self._value = value\n\n    def is_even(self) -> bool:\n        return self._value % 2 == 0\n\n    def is_odd(self) -> bool:\n        return self._value % 2 != 0\n\nclass EvenOddCountResult:\n    def __init__(self, even_count: int, odd_count: int):\n        self.even_count = even_count\n        self.odd_count = odd_count\n\n    def to_tuple(self) -> tuple[int, int]:\n        return (self.even_count, self.odd_count)\n\ndef even_odd_count(num):\n    \"\"\"Given an integer. return a tuple that has the number of even and odd digits respectively.\n\n     Example:\n        even_odd_count(-12) ==> (1, 1)\n        even_odd_count(123) ==> (1, 2)\n    \"\"\"\n    even_count = 0\n    odd_count = 0\n\n    abs_num_str = str(abs(num))\n\n    for digit_char in abs_num_str:\n        digit_value = int(digit_char)\n        digit_obj = _Digit(digit_value)\n\n        if digit_obj.is_even():\n            even_count += 1\n        else:\n            odd_count += 1\n\n    result = EvenOddCountResult(even_count, odd_count)\n    return result.to_tuple()\n```"}
{"task_id": "HumanEval/154", "solution": "```python\ndef cycpattern_check(a , b):\n    \"\"\"You are given 2 words. You need to return True if the second word or any of its rotations is a substring in the first word\n    cycpattern_check(\"abcd\",\"abd\") => False\n    cycpattern_check(\"hello\",\"ell\") => True\n    cycpattern_check(\"whassup\",\"psus\") => False\n    cycpattern_check(\"abab\",\"baa\") => True\n    cycpattern_check(\"efef\",\"eeff\") => False\n    cycpattern_check(\"himenss\",\"simen\") => True\n\n    \"\"\"\n    # If b is an empty string, it is considered a substring of any string.\n    if not b:\n        return True\n\n    n = len(b)\n    # Generate all cyclic rotations of b and check if any is a substring of a.\n    # The original string b is included as one of its own rotations.\n    for i in range(n):\n        rotation = b[i:] + b[:i]\n        # Check if the current rotation exists as a substring in a.\n        if rotation in a:\n            return True\n\n    # If no rotation of b was found as a substring in a, return False.\n    return False\n```"}
{"task_id": "HumanEval/156", "solution": "def int_to_mini_roman(number):\n    \"\"\"\n    Given a positive integer, obtain its roman numeral equivalent as a string,\n    and return it in lowercase.\n    Restrictions: 1 <= num <= 1000\n    \"\"\"\n    if not (1 <= number <= 1000):\n        raise ValueError(\"Input number must be between 1 and 1000, inclusive.\")\n\n    _ROMAN_MAP = [\n        (1000, 'M'), (900, 'CM'), (500, 'D'), (400, 'CD'),\n        (100, 'C'), (90, 'XC'), (50, 'L'), (40, 'XL'),\n        (10, 'X'), (9, 'IX'), (5, 'V'), (4, 'IV'),\n        (1, 'I')\n    ]\n\n    roman_numeral_parts = []\n    temp_num = number\n\n    for value, symbol in _ROMAN_MAP:\n        while temp_num >= value:\n            roman_numeral_parts.append(symbol)\n            temp_num -= value\n\n    return \"\".join(roman_numeral_parts).lower()"}
{"task_id": "HumanEval/158", "solution": "```python\ndef find_max(words):\n    \"\"\"Write a function that accepts a list of strings.\n    The list contains different words. Return the word with maximum number\n    of unique characters. If multiple strings have maximum number of unique\n    characters, return the one which comes first in lexicographical order.\n    \"\"\"\n    def _calculate_unique_char_count(word: str) -> int:\n        \"\"\"Calculates the number of unique characters in a given string.\"\"\"\n        return len(set(word))\n\n    if not words:\n        return \"\"\n\n    max_unique_count = -1\n    result_word = \"\"\n\n    for word in words:\n        current_unique_count = _calculate_unique_char_count(word)\n\n        if current_unique_count > max_unique_count:\n            max_unique_count = current_unique_count\n            result_word = word\n        elif current_unique_count == max_unique_count:\n            if result_word == \"\" or word < result_word:\n                result_word = word\n\n    return result_word\n```"}
{"task_id": "HumanEval/157", "solution": "```python\nimport math\n\n_EPSILON = 1e-9\n\nclass Triangle:\n    \"\"\"\n    Represents a triangle with three side lengths.\n    It encapsulates properties and determines if it's right-angled.\n    \"\"\"\n    def __init__(self, a: float, b: float, c: float):\n        \"\"\"Initializes a Triangle object with three side lengths, validating inputs.\"\"\"\n        if not all(isinstance(side, (int, float)) and side > 0 for side in [a, b, c]):\n            raise ValueError(\"Side lengths must be positive numerical values.\")\n        # No explicit check for triangle inequality is performed.\n\n        self._side_a = float(a)\n        self._side_b = float(b)\n        self._side_c = float(c)\n\n    def is_right_angled(self) -> bool:\n        \"\"\"Determines if the triangle is right-angled using the Pythagorean theorem and floating-point comparison.\"\"\"\n        sides = sorted([self._side_a, self._side_b, self._side_c])\n        a_sq = sides[0] ** 2\n        b_sq = sides[1] ** 2\n        c_sq = sides[2] ** 2\n\n        # Compares sums of squares using a small epsilon for floating-point accuracy.\n        return math.isclose(a_sq + b_sq, c_sq, rel_tol=_EPSILON, abs_tol=_EPSILON)\n\ndef right_angle_triangle(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle. Return True if the three\n    sides form a right-angled triangle, False otherwise.\n    A right-angled triangle is a triangle in which one angle is right angle or\n    90 degree.\n    Example:\n    right_angle_triangle(3, 4, 5) == True\n    right_angle_triangle(1, 2, 3) == False\n    '''\n    # This function acts as an application service, delegating core logic to a Triangle object.\n    triangle = Triangle(a, b, c)\n    return triangle.is_right_angled()\n```"}
{"task_id": "HumanEval/160", "solution": "```python\nclass AlgebraicExpressionBuilder:\n    \"\"\"Helper class to build the algebraic expression string from operators and operands.\"\"\"\n    def __init__(self, operators, operands):\n        self._operators = operators\n        self._operands = operands\n\n    def build_expression_string(self):\n        \"\"\"Constructs the expression string by interleaving operands and operators.\"\"\"\n        expression_parts = []\n        for i in range(len(self._operators)):\n            expression_parts.append(str(self._operands[i]))\n            expression_parts.append(self._operators[i])\n        expression_parts.append(str(self._operands[-1]))\n        return \"\".join(expression_parts)\n\ndef do_algebra(operator, operand):\n    \"\"\"\n    Given two lists operator, and operand. The first list has basic algebra operations, and\n    the second list is a list of integers. Use the two given lists to build the algebric\n    expression and return the evaluation of this expression.\n    \"\"\"\n    builder = AlgebraicExpressionBuilder(operator, operand)\n    expression_string = builder.build_expression_string()\n    return eval(expression_string)\n```"}
{"task_id": "HumanEval/161", "solution": "```python\ndef solve(s):\n    \"\"\"Reverses case of letters if present, otherwise reverses the string.\"\"\"\n    has_letters = False\n    for char in s:\n        if char.isalpha():\n            has_letters = True\n            break\n\n    if has_letters:\n        result_chars = []\n        for char in s:\n            if char.isalpha():\n                result_chars.append(char.swapcase())\n            else:\n                result_chars.append(char)\n        return \"\".join(result_chars)\n    else:\n        return s[::-1]\n```"}
{"task_id": "HumanEval/159", "solution": "```python\ndef eat(number, need, remaining):\n    \"\"\"\n    Calculates total carrots eaten and remaining carrots after a rabbit's meal.\n    The rabbit eats as many carrots as needed, up to the remaining stock.\n    \"\"\"\n    carrots_eaten_this_meal = min(need, remaining)\n    total_eaten_carrots = number + carrots_eaten_this_meal\n    carrots_left_after_meal = remaining - carrots_eaten_this_meal\n\n    return [total_eaten_carrots, carrots_left_after_meal]\n```"}
{"task_id": "HumanEval/162", "solution": "import hashlib\n\ndef string_to_md5(text):\n    \"\"\"\n    Given a string 'text', return its md5 hash equivalent string.\n    If 'text' is an empty string, return None.\n\n    >>> string_to_md5('Hello world') == '3e25960a79dbc69b674cd4ec67a72c62'\n    \"\"\"\n    if not text:\n        return None\n\n    # Encode the string to bytes before hashing, commonly using 'utf-8'.\n    md5_hash = hashlib.md5(text.encode('utf-8'))\n    return md5_hash.hexdigest()"}
{"task_id": "HumanEval/163", "solution": "```python\ndef generate_integers(a, b):\n    \"\"\"\n    Given two positive integers a and b, return the even digits between a\n    and b, in ascending order.\n    \"\"\"\n    start = min(a, b)\n    end = max(a, b)\n    result = []\n\n    for num in range(start, end + 1):\n        # Check if num is single-digit (0-9) and even.\n        if 0 <= num <= 9 and num % 2 == 0:\n            result.append(num)\n\n    return result\n```"}
