{"task_id": "HumanEval/1", "solution": "```python\nfrom typing import List\n\ndef _clean_string(s: str) -> str:\n    \"\"\"Removes all space characters from an input string.\"\"\"\n    return s.replace(\" \", \"\")\n\ndef separate_paren_groups(paren_string: str) -> List[str]:\n    \"\"\" Separates groups of balanced, non-nested parentheses from a string.\n    Ignores spaces and returns a list of these separated groups.\n    \"\"\"\n    cleaned_string = _clean_string(paren_string)\n\n    result = []\n    current_group = []\n    balance_counter = 0\n\n    for char in cleaned_string:\n        current_group.append(char)\n        if char == '(':\n            balance_counter += 1\n        elif char == ')':\n            balance_counter -= 1\n\n        # If balance_counter is 0, the current_group is a complete, top-level group\n        if balance_counter == 0:\n            result.append(\"\".join(current_group))\n            current_group = [] # Reset for the next group\n\n    return result\n```"}
{"task_id": "HumanEval/7", "solution": "```python\nfrom typing import List\n\n\ndef filter_by_substring(strings: List[str], substring: str) -> List[str]:\n    \"\"\" Filter an input list of strings only for ones that contain given substring\n    >>> filter_by_substring([], 'a')\n    []\n    >>> filter_by_substring(['abc', 'bacd', 'cde', 'array'], 'a')\n    ['abc', 'bacd', 'array']\n    \"\"\"\n    return [s for s in strings if substring in s]\n```"}
{"task_id": "HumanEval/8", "solution": "```python\ndef sum_product(numbers: List[int]) -> Tuple[int, int]:\n    \"\"\" For a given list of integers, return a tuple consisting of a sum and a product of all the integers in a list.\n    Empty sum should be equal to 0 and empty product should be equal to 1.\n    \"\"\"\n    current_sum = 0\n    current_product = 1\n    for num in numbers:\n        current_sum += num\n        current_product *= num\n    return (current_sum, current_product)\n```"}
{"task_id": "HumanEval/6", "solution": "```python\nfrom typing import List\n\n\ndef parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\" Input to this function is a string represented multiple groups for nested parentheses separated by spaces.\n    For each of the group, output the deepest level of nesting of parentheses.\n    E.g. (()()) has maximum two levels of nesting while ((())) has three.\n\n    >>> parse_nested_parens('(()()) ((())) () ((())()())')\n    [2, 3, 1, 3]\n    \"\"\"\n    def _calculate_nesting_level(group_string: str) -> int:\n        \"\"\"Calculates the deepest level of nesting for a single parentheses group.\"\"\"\n        current_level = 0\n        max_level = 0\n        for char in group_string:\n            if char == '(':\n                current_level += 1\n                max_level = max(max_level, current_level)\n            elif char == ')':\n                current_level -= 1\n        return max_level\n\n    def _parse_groups(input_string: str) -> List[str]:\n        \"\"\"Splits the input string into individual parentheses groups by spaces.\"\"\"\n        return input_string.split(' ')\n\n    groups = _parse_groups(paren_string)\n    nesting_levels = []\n    for group in groups:\n        if group: # Ensure empty strings from multiple spaces are not processed\n            nesting_levels.append(_calculate_nesting_level(group))\n    return nesting_levels\n```"}
{"task_id": "HumanEval/10", "solution": "```python\ndef is_palindrome(string: str) -> bool:\n    \"\"\" Test if given string is a palindrome \"\"\"\n    return string == string[::-1]\n\n\ndef make_palindrome(string: str) -> str:\n    \"\"\" Find the shortest palindrome that begins with a supplied string.\n    Algorithm idea is simple:\n    - Find the longest postfix of supplied string that is a palindrome.\n    - Append to the end of the string reverse of a string prefix that comes before the palindromic suffix.\n    \"\"\"\n    if is_palindrome(string):\n        return string\n\n    for i in range(len(string)):\n        suffix = string[i:]\n        if is_palindrome(suffix):\n            prefix_to_reverse = string[:i]\n            return string + prefix_to_reverse[::-1]\n\n    # This case should theoretically not be reached for non-empty strings\n    # as single characters are palindromes, meaning `is_palindrome(string[len(string)-1:])`\n    # would always be true for the last character.\n    # For an empty string, it returns \"\" + \"\" = \"\" correctly.\n    return string\n```"}
{"task_id": "HumanEval/9", "solution": "```python\ndef rolling_max(numbers: List[int]) -> List[int]:\n    \"\"\" From a given list of integers, generate a list of rolling maximum element found until given moment\n    in the sequence.\n    >>> rolling_max([1, 2, 3, 2, 3, 4, 2])\n    [1, 2, 3, 3, 3, 4, 4]\n    \"\"\"\n    if not numbers:\n        return []\n\n    result_list = []\n    current_max = float('-inf')\n\n    for number in numbers:\n        current_max = max(current_max, number)\n        result_list.append(current_max)\n\n    return result_list\n```"}
{"task_id": "HumanEval/11", "solution": "```python\ndef string_xor(a: str, b: str) -> str:\n    \"\"\" Input are two strings a and b consisting only of 1s and 0s.\n    Perform binary XOR on these inputs and return result also as a string.\n    >>> string_xor('010', '110')\n    '100'\n    \"\"\"\n\n    class InvalidBinaryStringError(Exception):\n        \"\"\"Custom exception raised when an input string contains non-binary characters.\"\"\"\n        def __init__(self, message: str):\n            super().__init__(message)\n            self.message = message\n\n    class BinaryString:\n        \"\"\"Encapsulates a binary string value, providing validation and character access.\"\"\"\n        def __init__(self, value: str):\n            self._value = value\n            if not self._is_valid():\n                raise InvalidBinaryStringError(f\"Invalid binary string: '{value}'. Contains characters other than '0' or '1'.\")\n\n        def _is_valid(self) -> bool:\n            \"\"\"Checks if the string consists only of '0's and '1's.\"\"\"\n            return all(char in ('0', '1') for char in self._value)\n\n        def get_value(self) -> str:\n            \"\"\"Returns the encapsulated binary string.\"\"\"\n            return self._value\n\n        def __len__(self) -> int:\n            \"\"\"Returns the length of the binary string.\"\"\"\n            return len(self._value)\n\n        def __getitem__(self, index: int) -> str:\n            \"\"\"Allows character access by index.\"\"\"\n            return self._value[index]\n\n    class XORProcessor:\n        \"\"\"Performs character-by-character binary XOR operation on two BinaryString objects.\"\"\"\n        def perform_xor(self, a_bs: BinaryString, b_bs: BinaryString) -> BinaryString:\n            \"\"\"Computes the XOR of two BinaryString inputs, assuming they are of equal length.\"\"\"\n            result_chars = []\n            for i in range(len(a_bs)):\n                char_a = a_bs[i]\n                char_b = b_bs[i]\n                if char_a == char_b:\n                    result_chars.append('0')\n                else:\n                    result_chars.append('1')\n            return BinaryString(\"\".join(result_chars))\n\n    binary_a = BinaryString(a)\n    binary_b = BinaryString(b)\n\n    # For differing lengths, an IndexError will occur naturally during iteration if inputs are not equal length,\n    # adhering to the constraint of not adding explicit exception handling for \"edge cases\".\n\n    xor_processor = XORProcessor()\n    result_binary_string = xor_processor.perform_xor(binary_a, binary_b)\n\n    return result_binary_string.get_value()\n```"}
{"task_id": "HumanEval/12", "solution": "```python\nfrom typing import List, Optional\n\n\ndef longest(strings: List[str]) -> Optional[str]:\n    \"\"\" Out of list of strings, return the longest one. Return the first one in case of multiple\n    strings of the same length. Return None in case the input list is empty.\n    >>> longest([])\n\n    >>> longest(['a', 'b', 'c'])\n    'a'\n    >>> longest(['a', 'bb', 'ccc'])\n    'ccc'\n    \"\"\"\n    if not strings:\n        return None\n\n    longest_so_far = strings[0]\n\n    for current_string in strings[1:]:\n        if len(current_string) > len(longest_so_far):\n            longest_so_far = current_string\n\n    return longest_so_far\n```"}
{"task_id": "HumanEval/13", "solution": "def greatest_common_divisor(a: int, b: int) -> int:\n    \"\"\" Return a greatest common divisor of two integers a and b using the Euclidean algorithm. \"\"\"\n    # Take absolute values to handle negative inputs correctly, as GCD is conventionally non-negative.\n    a = abs(a)\n    b = abs(b)\n\n    while b != 0:\n        a, b = b, a % b\n    return a"}
{"task_id": "HumanEval/14", "solution": "```python\ndef all_prefixes(string: str) -> List[str]:\n    \"\"\" Return list of all prefixes from shortest to longest of the input string\n    >>> all_prefixes('abc')\n    ['a', 'ab', 'abc']\n    \"\"\"\n    if not string:\n        return []\n\n    prefixes = []\n    for i in range(1, len(string) + 1):\n        prefixes.append(string[:i])\n    return prefixes\n```"}
{"task_id": "HumanEval/16", "solution": "```python\ndef count_distinct_characters(string: str) -> int:\n    \"\"\" Given a string, find out how many distinct characters (regardless of case) does it consist of\n    >>> count_distinct_characters('xyzXYZ')\n    3\n    >>> count_distinct_characters('Jerry')\n    4\n    \"\"\"\n    normalized_string = string.lower()\n    distinct_chars = set()\n    for char in normalized_string:\n        distinct_chars.add(char)\n    return len(distinct_chars)\n```"}
