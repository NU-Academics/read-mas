{"task_id": "HumanEval/56", "solution": "```python\ndef correct_bracketing(brackets: str):\n    \"\"\" brackets is a string of \"<\" and \">\".\n    return True if every opening bracket has a corresponding closing bracket.\n\n    >>> correct_bracketing(\"<\")\n    False\n    >>> correct_bracketing(\"<>\")\n    True\n    >>> correct_bracketing(\"<<><>>\")\n    True\n    >>> correct_bracketing(\"><<>\")\n    False\n    \"\"\"\n    balance = 0\n    for char in brackets:\n        if char == '<':\n            balance += 1\n        elif char == '>':\n            balance -= 1\n\n        if balance < 0:\n            return False  # Closing bracket without a corresponding opening bracket\n\n    return balance == 0  # True if all brackets are balanced, False otherwise\n```"}
{"task_id": "HumanEval/57", "solution": "```python\ndef _is_increasing(l: list) -> bool:\n    \"\"\"Helper function to check if a list is monotonically increasing.\"\"\"\n    for i in range(len(l) - 1):\n        if l[i] > l[i+1]:\n            return False\n    return True\n\ndef _is_decreasing(l: list) -> bool:\n    \"\"\"Helper function to check if a list is monotonically decreasing.\"\"\"\n    for i in range(len(l) - 1):\n        if l[i] < l[i+1]:\n            return False\n    return True\n\ndef monotonic(l: list):\n    \"\"\"Return True is list elements are monotonically increasing or decreasing.\n    >>> monotonic([1, 2, 4, 20])\n    True\n    >>> monotonic([1, 20, 4, 10])\n    False\n    >>> monotonic([4, 1, 0, -10])\n    True\n    \"\"\"\n    if len(l) <= 1:\n        return True\n\n    is_inc = _is_increasing(l)\n    is_dec = _is_decreasing(l)\n\n    return is_inc or is_dec\n```"}
{"task_id": "HumanEval/58", "solution": "```python\ndef common(l1: list, l2: list):\n    \"\"\"Return sorted unique common elements for two lists.\n    >>> common([1, 4, 3, 34, 653, 2, 5], [5, 7, 1, 5, 9, 653, 121])\n    [1, 5, 653]\n    >>> common([5, 3, 2, 8], [3, 2])\n    [2, 3]\n\n    \"\"\"\n    set1 = set(l1)\n    set2 = set(l2)\n    common_elements_set = set1.intersection(set2)\n    result_list = list(common_elements_set)\n    result_list.sort()\n    return result_list\n```"}
{"task_id": "HumanEval/60", "solution": "def sum_to_n(n: int):\n    \"\"\"sum_to_n is a function that sums numbers from 1 to n.\n    >>> sum_to_n(30)\n    465\n    >>> sum_to_n(100)\n    5050\n    >>> sum_to_n(5)\n    15\n    >>> sum_to_n(10)\n    55\n    >>> sum_to_n(1)\n    1\n    \"\"\"\n    if n >= 1:\n        return n * (n + 1) // 2\n    else:\n        # According to design, for n < 1, sum numbers from n up to 0.\n        return sum(range(n, 1))"}
{"task_id": "HumanEval/59", "solution": "```python\ndef largest_prime_factor(n: int):\\\n    \"\"\"Return the largest prime factor of n. Assume n > 1 and is not a prime.\n    >>> largest_prime_factor(13195)\n    29\n    >>> largest_prime_factor(2048)\n    2\n    \"\"\"\n    largest_factor = 1\n    i = 2\n    while i * i <= n:\\\n        if n % i == 0:\\\n            largest_factor = i\n            while n % i == 0:\\\n                n //= i\n        i += 1\n    if n > 1: # If n is still greater than 1, it must be a prime factor itself\n        largest_factor = n\n    return largest_factor\n```"}
{"task_id": "HumanEval/61", "solution": "```python\ndef correct_bracketing(brackets: str):\n    \"\"\" brackets is a string of \"(\" and \")\".\n    return True if every opening bracket has a corresponding closing bracket.\n    \"\"\"\n    balance = 0\n    for char in brackets:\n        if char == '(':\n            balance += 1\n        elif char == ')':\n            balance -= 1\n\n        if balance < 0:\n            return False\n\n    return balance == 0\n```"}
{"task_id": "HumanEval/62", "solution": "def derivative(xs: list):\n    \"\"\" xs represent coefficients of a polynomial.\n    xs[0] + xs[1] * x + xs[2] * x^2 + ....\\\n     Return derivative of this polynomial in the same form.\n    >>> derivative([3, 1, 2, 4, 5])\n    [1, 4, 12, 20]\n    >>> derivative([1, 2, 3])\n    [2, 6]\n    \"\"\"\n    if not xs or len(xs) == 1:\n        return []\n\n    derived_coefficients = []\n    # The derivative of c * x^n is c * n * x^(n-1).\n    # Iterate from the x^1 term (index 1) onwards.\n    for i in range(1, len(xs)):\n        derived_coefficients.append(xs[i] * i)\n    return derived_coefficients"}
