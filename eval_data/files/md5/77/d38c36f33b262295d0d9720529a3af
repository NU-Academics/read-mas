{"task_id": "HumanEval/40", "solution": "def triples_sum_to_zero(l: list):\n    \"\"\"\n    triples_sum_to_zero takes a list of integers as an input.\n    it returns True if there are three distinct elements in the list that\n    sum to zero, and False otherwise.\n    \"\"\"\n    n = len(l)\n\n    if n < 3:\n        return False\n\n    # Iterate through all combinations of three distinct elements (by index)\n    for i in range(n - 2):\n        for j in range(i + 1, n - 1):\n            for k in range(j + 1, n):\n                if l[i] + l[j] + l[k] == 0:\n                    return True\n\n    return False"}
{"task_id": "HumanEval/42", "solution": "def incr_list(l: list):\n    \"\"\"Return list with elements incremented by 1.\"\"\"\n    return [item + 1 for item in l]"}
{"task_id": "HumanEval/43", "solution": "def pairs_sum_to_zero(l):\n    \"\"\"\n    pairs_sum_to_zero takes a list of integers as an input.\n    it returns True if there are two distinct elements in the list that\n    sum to zero, and False otherwise.\n    >>> pairs_sum_to_zero([1, 3, 5, 0])\n    False\n    >>> pairs_sum_to_zero([1, 3, -2, 1])\n    False\n    >>> pairs_sum_to_zero([1, 2, 3, 7])\n    False\n    >>> pairs_sum_to_zero([2, 4, -5, 3, 5, 7])\n    True\n    >>> pairs_sum_to_zero([1])\n    False\n    \"\"\"\n    if len(l) < 2:\n        return False\n\n    seen_numbers = set()\n    for num in l:\n        target = -num\n        if target in seen_numbers:\n            return True\n        seen_numbers.add(num)\n    return False"}
{"task_id": "HumanEval/44", "solution": "def change_base(x: int, base: int):\n    \"\"\"Change numerical base of input number x to base.\n    return string representation after the conversion.\n    base numbers are less than 10.\n    >>> change_base(8, 3)\n    '22'\n    >>> change_base(8, 2)\n    '1000'\n    >>> change_base(7, 2)\n    '111'\n    \"\"\"\n    if x == 0:\n        return \"0\"\n\n    result = []\n    is_negative = False\n    if x < 0:\n        is_negative = True\n        x = abs(x)\n\n    while x > 0:\n        remainder = x % base\n        result.append(str(remainder))\n        x //= base\n\n    if is_negative:\n        result.append(\"-\")\n\n    return \"\".join(result[::-1])"}
{"task_id": "HumanEval/45", "solution": "from typing import Any\n\ndef _validate_input(value: Any, name: str) -> float:\n    \"\"\"Validates if a value is a non-negative number and returns it as a float.\n    Raises ValueError if validation fails.\n    \"\"\"\n    try:\n        num_value = float(value)\n    except (ValueError, TypeError):\n        raise ValueError(f\"Input for {name} must be a numerical value.\")\n    if num_value < 0:\n        raise ValueError(f\"Input for {name} must be non-negative.\")\n    return num_value\n\ndef triangle_area(a, h):\n    \"\"\"Given length of a side and high return area for a triangle.\n    Raises ValueError if inputs are not numerical or non-negative.\n    >>> triangle_area(5, 3)\n    7.5\n    \"\"\"\n    side_length = _validate_input(a, \"side length\")\n    height = _validate_input(h, \"height\")\n\n    return (side_length * height) / 2"}
{"task_id": "HumanEval/47", "solution": "import math\n\ndef median(l: list):\n    \"\"\"Return median of elements in the list l.\"\"\"\n    sorted_l = sorted(l)\n    n = len(sorted_l)\n\n    if n % 2 == 1:\n        # Odd length list, return the middle element\n        median_value = sorted_l[n // 2]\n    else:\n        # Even length list, return the average of the two middle elements\n        mid1 = sorted_l[n // 2 - 1]\n        mid2 = sorted_l[n // 2]\n        median_value = (mid1 + mid2) / 2.0\n\n    # Format the result based on whether it's a whole number\n    if median_value == int(median_value):\n        return int(median_value)\n    else:\n        return float(median_value)"}
{"task_id": "HumanEval/46", "solution": "def fib4(n: int):\n    \"\"\"The Fib4 number sequence is a sequence similar to the Fibbonacci sequnece that's defined as follows:\n    fib4(0) -> 0\n    fib4(1) -> 0\n    fib4(2) -> 2\n    fib4(3) -> 0\n    fib4(n) -> fib4(n-1) + fib4(n-2) + fib4(n-3) + fib4(n-4).\n    This function efficiently computes the n-th element of the fib4 number sequence iteratively.\n    \"\"\"\n    if n == 0:\n        return 0\n    elif n == 1:\n        return 0\n    elif n == 2:\n        return 2\n    elif n == 3:\n        return 0\n\n    # Initialize with the base values: fib4(0), fib4(1), fib4(2), fib4(3)\n    a, b, c, d = 0, 0, 2, 0\n\n    # Iterate from n=4 up to the desired n\n    for _ in range(4, n + 1):\n        next_fib4 = a + b + c + d\n        a = b\n        b = c\n        c = d\n        d = next_fib4\n    return d"}
{"task_id": "HumanEval/48", "solution": "def is_palindrome(text: str):\n    \"\"\"\n    Checks if given string is a palindrome\n    >>> is_palindrome('')\n    True\n    >>> is_palindrome('aba')\n    True\n    >>> is_palindrome('aaaaa')\n    True\n    >>> is_palindrome('zbcd')\n    False\n    \"\"\"\n    return text == text[::-1]"}
{"task_id": "HumanEval/49", "solution": "def modp(n: int, p: int):\n    \"\"\"Return 2^n modulo p (be aware of numerics).\n    >>> modp(3, 5)\n    3\n    >>> modp(1101, 101)\n    2\n    >>> modp(0, 101)\n    1\n    >>> modp(3, 11)\n    8\n    >>> modp(100, 101)\n    1\n    \"\"\"\n    if p == 1:\n        return 0\n    res = 1\n    base = 2 % p # Base is 2\n    n_copy = n\n\n    while n_copy > 0:\n        # If n_copy is odd, multiply base with result\n        if n_copy % 2 == 1:\n            res = (res * base) % p\n\n        # n_copy must be even now\n        base = (base * base) % p\n        n_copy //= 2\n\n    return res"}
