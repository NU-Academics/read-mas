{"task_id": "Mbpp/131", "solution": "def reverse_vowels(s: str) -> str:\n    \"\"\"\n    Reverses only the vowels in a given string. 'y' is not considered a vowel.\n    Non-vowel characters remain in their original positions.\n    \"\"\"\n    VOWELS = frozenset({\"a\", \"e\", \"i\", \"o\", \"u\"})\n\n    chars = list(s)\n    left, right = 0, len(chars) - 1\n\n    while left < right:\n        # Move the left pointer until a vowel is found\n        while left < right and chars[left].lower() not in VOWELS:\n            left += 1\n\n        # Move the right pointer until a vowel is found\n        while left < right and chars[right].lower() not in VOWELS:\n            right -= 1\n\n        # If both pointers are valid and point to vowels, swap them\n        if left < right:\n            chars[left], chars[right] = chars[right], chars[left]\n            left += 1\n            right -= 1\n\n    return \"\".join(chars)"}
{"task_id": "Mbpp/130", "solution": "def max_occurrences(items):\n    \"\"\"\n    Finds the item with the maximum frequency in a given list.\n    If multiple items have the same maximum frequency, the one appearing first in the list is returned.\n    \"\"\"\n    counts = {}\n    for item in items:\n        counts[item] = counts.get(item, 0) + 1\n\n    # If the list is empty, max(counts.values()) will raise ValueError,\n    # adhering to the constraint of not adding explicit checks or raises for edge cases.\n    max_count = max(counts.values())\n\n    candidates = [item for item, count in counts.items() if count == max_count]\n\n    # Return the first candidate found in the original list, based on the tie-breaker rule.\n    for item in items:\n        if item in candidates:\n            return item"}
