{"task_id": "Mbpp/290", "solution": "def max_length(lists: list) -> tuple:\n    \"\"\"\n    Finds the list of maximum length in a list of lists.\n    Returns a tuple containing the maximum length and the first list found with that length.\n    \"\"\"\n    if not isinstance(lists, (list, tuple)):\n        raise ValueError(\"Input 'lists' must be a list or tuple.\")\n    if not lists:\n        raise ValueError(\"Input 'lists' cannot be empty.\")\n\n    max_len = -1\n    list_with_max_len = None\n\n    for sublist in lists:\n        if not isinstance(sublist, (list, tuple)):\n            raise ValueError(f\"All elements in 'lists' must be lists or tuples, found type {type(sublist)}.\")\n\n        current_len = len(sublist)\n        if current_len > max_len:\n            max_len = current_len\n            list_with_max_len = sublist\n\n    return (max_len, list_with_max_len)"}
{"task_id": "Mbpp/283", "solution": "def validate(number: int) -> bool:\n    \"\"\"\n    Checks if the frequency of each digit in the integer is less than or equal to the digit itself.\n    The check applies to the absolute value of the number.\n    \"\"\"\n    n = abs(int(number))\n\n    # Frequency buckets for digits 0-9\n    counts = [0] * 10\n\n    # Count digits\n    if n == 0:\n        counts[0] = 1\n    else:\n        while n > 0:\n            d = n % 10\n            counts[d] += 1\n            n //= 10\n\n    # Validate: for every digit present, frequency must be <= digit value\n    for digit, freq in enumerate(counts):\n        if freq > digit:\n            return False\n\n    return True"}
{"task_id": "Mbpp/287", "solution": "def square_Sum(n: int) -> int:\n    \"\"\"\n    Computes the sum of squares of the first n even natural numbers using a mathematical formula.\n    This function expects 'n' to be a non-negative integer.\n    \"\"\"\n    # The formula is 4 * sum_{k=1..n} k^2 = 4 * n*(n+1)*(2n+1)/6\n    # Integer division // is used to ensure an integer result.\n    return 4 * n * (n + 1) * (2 * n + 1) // 6"}
{"task_id": "Mbpp/292", "solution": "import math\nfrom typing import Union\ndef find(dividend: float | int, divisor: float | int) -> int:\n    \"\"\"\n    Computes the quotient of two numbers, rounded down to the nearest integer.\n    Raises TypeError for non-numeric inputs and ZeroDivisionError for division by zero.\n    \"\"\"\n\n    def _validate_numeric(value: object, name: str) -> None:\n        if isinstance(value, bool) or not isinstance(value, (int, float)):\n            raise TypeError(f\"{name} must be an int or float, but got {type(value).__name__}\")\n\n    _validate_numeric(dividend, \"dividend\")\n    _validate_numeric(divisor, \"divisor\")\n\n    if divisor == 0:\n        raise ZeroDivisionError(\"division by zero\")\n\n    return int(math.floor(dividend / divisor))"}
{"task_id": "Mbpp/286", "solution": "def max_sub_array_sum_repeated(arr: list[int], n: int, k: int) -> int:\n    \"\"\"\n    Finds the largest sum of a contiguous subarray in an array formed by repeating the given array k times.\n    Uses Kadane's algorithm and prefix/suffix sums for O(n) time complexity.\n    \"\"\"\n\n    def _kadane_max_subarray(current_arr: list[int]) -> int:\n        \"\"\"\n        Calculates the maximum contiguous subarray sum using Kadane's algorithm.\n        Handles arrays with all negative numbers by returning the largest element.\n        \"\"\"\n        if not current_arr:\n            return 0  # Should not happen with valid inputs based on design\n\n        max_ending_here = current_arr[0]\n        max_so_far = current_arr[0]\n\n        for x in current_arr[1:]:\n            max_ending_here = max(x, max_ending_here + x)\n            max_so_far = max(max_so_far, max_ending_here)\n        return max_so_far\n\n    def _max_prefix_sum(current_arr: list[int]) -> int:\n        \"\"\"\n        Calculates the maximum prefix sum for a given array.\n        \"\"\"\n        if not current_arr:\n            return 0  # Should not happen with valid inputs based on design\n\n        current_sum = 0\n        max_p_sum = float('-inf')\n        for x in current_arr:\n            current_sum += x\n            max_p_sum = max(max_p_sum, current_sum)\n        return max_p_sum\n\n    def _max_suffix_sum(current_arr: list[int]) -> int:\n        \"\"\"\n        Calculates the maximum suffix sum for a given array.\n        \"\"\"\n        if not current_arr:\n            return 0  # Should not happen with valid inputs based on design\n\n        current_sum = 0\n        max_s_sum = float('-inf')\n        for x in reversed(current_arr):\n            current_sum += x\n            max_s_sum = max(max_s_sum, current_sum)\n        return max_s_sum\n\n    # Basic validation per design assumptions\n    if not isinstance(k, int) or k < 1:\n        raise ValueError(\"k must be an integer >= 1\")\n    if not isinstance(n, int) or n != len(arr):\n        raise ValueError(\"n must be an integer equal to len(arr)\")\n    if not arr:\n        return 0\n\n    if k == 1:\n        return _kadane_max_subarray(arr)\n    elif k == 2:\n        return _kadane_max_subarray(arr + arr)\n    else:  # k > 2\n        total_sum = sum(arr)\n\n        # This covers cases where the max subarray is entirely within the first two repetitions\n        max_sum_in_two_arrays = _kadane_max_subarray(arr + arr)\n\n        # Calculate prefix and suffix sums for combining across multiple repetitions\n        max_p = _max_prefix_sum(arr)\n        max_s = _max_suffix_sum(arr)\n\n        # The sum from the middle (k-2) full repetitions, only contributing if total_sum is positive\n        middle_block_sum = max(0, total_sum) * (k - 2)\n\n        # This covers cases where the max subarray spans from a suffix of the first array,\n        # through all middle (k-2) arrays, to a prefix of the last array.\n        max_across_repeats = max_s + middle_block_sum + max_p\n\n        return max(max_sum_in_two_arrays, max_across_repeats)"}
{"task_id": "Mbpp/296", "solution": "def get_Inv_Count(arr):\n    \"\"\"Counts inversions in an array using a merge sort based approach.\n    An inversion is a pair (i, j) such that i < j and arr[i] > arr[j].\n    \"\"\"\n\n    def _merge_sort_and_count(current_arr):\n        n = len(current_arr)\n        if n <= 1:\n            return current_arr, 0\n\n        mid = n // 2\n        left_half = current_arr[:mid]\n        right_half = current_arr[mid:]\n\n        sorted_left, left_inversions = _merge_sort_and_count(left_half)\n        sorted_right, right_inversions = _merge_sort_and_count(right_half)\n\n        merged_array = []\n        split_inversions = 0\n        i, j = 0, 0\n\n        while i < len(sorted_left) and j < len(sorted_right):\n            if sorted_left[i] <= sorted_right[j]:\n                merged_array.append(sorted_left[i])\n                i += 1\n            else:\n                merged_array.append(sorted_right[j])\n                split_inversions += (len(sorted_left) - i)\n                j += 1\n\n        merged_array.extend(sorted_left[i:])\n        merged_array.extend(sorted_right[j:])\n\n        total_inversions = left_inversions + right_inversions + split_inversions\n        return merged_array, total_inversions\n\n    _, total_inversions = _merge_sort_and_count(list(arr))\n\n    return total_inversions"}
{"task_id": "Mbpp/293", "solution": "def otherside_rightangle(a: float, b: float, assume: str = None, precision: int = None) -> float:\n    import math\n    from dataclasses import dataclass\n    from typing import Optional\n\n    class TriangleError(Exception):\n        \"\"\"Custom exception for triangle-related errors.\"\"\"\n        def __init__(self, message: str) -> None:\n            self.message = message\n            super().__init__(message)\n\n    class Validators:\n        \"\"\"Utility class for input validation.\"\"\"\n        def validate_positive(self, value: float, name: str = \"\") -> None:\n            if not isinstance(value, (int, float)):\n                raise TriangleError(f\"{name} must be numeric\")\n            if value <= 0:\n                raise TriangleError(f\"{name} must be > 0\")\n\n        def validate_assume(self, assume: Optional[str]) -> None:\n            if assume is None:\n                return\n            if assume not in (\"legs\", \"hypotenuse\"):\n                raise TriangleError(\"assume must be 'legs' or 'hypotenuse'\")\n\n    class MathUtils:\n        \"\"\"Utility class for pure mathematical operations.\"\"\"\n        EPSILON: float = 1e-12\n\n        @staticmethod\n        def hypot(a_val: float, b_val: float) -> float:\n            return math.hypot(a_val, b_val)\n\n        @staticmethod\n        def other_leg(hypotenuse: float, leg: float) -> float:\n            diff = hypotenuse*hypotenuse - leg*leg\n            if diff < -MathUtils.EPSILON:\n                raise TriangleError(\"Resulting square root argument is negative due to invalid side lengths (hypotenuse <= leg).\")\n            return math.sqrt(max(0.0, diff))\n\n    @dataclass\n    class SideLengths:\n        \"\"\"DTO for holding two side lengths.\"\"\"\n        a: float\n        b: float\n\n    class TriangleService:\n        \"\"\"Core business logic for computing missing triangle sides.\"\"\"\n        def __init__(self, validator: Validators = None, math_utils: MathUtils = None):\n            self.validator = validator or Validators()\n            self.math_utils = math_utils or MathUtils()\n\n        def compute_missing_side(self, sides: SideLengths, assume: Optional[str] = None, precision: Optional[int] = None) -> float:\n            side_a, side_b = float(sides.a), float(sides.b)\n            self.validator.validate_assume(assume)\n            self.validator.validate_positive(side_a, \"a\")\n            self.validator.validate_positive(side_b, \"b\")\n\n            if assume == 'legs':\n                result = self.math_utils.hypot(side_a, side_b)\n            elif assume == 'hypotenuse':\n                hyp, leg = (side_a, side_b) if side_a >= side_b else (side_b, side_a)\n                if hyp <= leg:\n                    raise TriangleError(\"Hypotenuse must be strictly larger than the leg.\")\n                result = self.math_utils.other_leg(hyp, leg)\n            else:\n                # Heuristic: Larger side treated as hypotenuse; if valid result > EPSILON, use it, else compute hypotenuse.\n                larger, smaller = (side_a, side_b) if side_a >= side_b else (side_b, side_a)\n                try:\n                    candidate = self.math_utils.other_leg(larger, smaller)\n                    if candidate > MathUtils.EPSILON:\n                        result = candidate\n                    else:\n                        result = self.math_utils.hypot(side_a, side_b)\n                except TriangleError:\n                    result = self.math_utils.hypot(side_a, side_b)\n\n            if precision is not None:\n                return round(result, precision)\n            return result\n\n    svc = TriangleService()\n    sides = SideLengths(a, b)\n    return svc.compute_missing_side(sides, assume=assume, precision=precision)"}
{"task_id": "Mbpp/294", "solution": "from typing import Any, Sequence, Union, Optional\ndef max_val(values: Sequence[Any], parse_strings: bool = False) -> Union[int, float]:\n    \"\"\"\n    Finds the maximum numeric value in a heterogeneous list, optionally parsing numeric strings.\n    Non-numeric items are ignored unless they can be parsed as strings.\n    \"\"\"\n\n    class NoNumericValuesError(Exception):\n        \"\"\"Raised when no numeric values are found in the input sequence.\"\"\"\n        def __init__(self, message: str):\n            super().__init__(message)\n\n    # Configuration constant for supported numeric types.\n    SUPPORTED_NUMERIC_TYPES = (int, float)\n\n    def _is_numeric(obj: Any) -> bool:\n        \"\"\"Checks if an object is an instance of a supported numeric type.\"\"\"\n        return isinstance(obj, SUPPORTED_NUMERIC_TYPES)\n\n    def _parse_numeric_string(s: str) -> Optional[Union[int, float]]:\n        \"\"\"Attempts to parse a string into an int or float.\"\"\"\n        s = s.strip()\n        try:\n            # Check for float specific characters before trying int\n            if \".\" in s or \"e\" in s.lower():\n                return float(s)\n            return int(s)\n        except ValueError:\n            return None\n\n    def _safe_numeric_value(obj: Any, parse_strings_flag: bool) -> Optional[Union[int, float]]:\n        \"\"\"Returns the numeric value of an object if it's numeric, or can be parsed from a string.\"\"\"\n        if _is_numeric(obj):\n            return obj\n        if parse_strings_flag and isinstance(obj, str):\n            return _parse_numeric_string(obj)\n        return None\n\n    max_value_found = None\n    for item in values:\n        num = _safe_numeric_value(item, parse_strings_flag=parse_strings)\n        if num is None:\n            continue\n        if max_value_found is None or num > max_value_found:\n            max_value_found = num\n\n    if max_value_found is None:\n        raise NoNumericValuesError(\"No numeric values found in the input.\")\n\n    return max_value_found"}
{"task_id": "Mbpp/297", "solution": "def flatten_list(input_list: Any, max_depth: Optional[int] = None, algorithm: str = 'iterative') -> List[Any]:\n    \"\"\"Flattens a nested list structure into a single flat list, preserving element order.\n    Supports both iterative (default) and recursive flattening algorithms.\n    \"\"\"\n    from collections.abc import Iterable\n    from typing import Any, Iterator, Optional, List\n\n    class FlattenError(Exception):\n        \"\"\"Base exception for flattening operations.\"\"\"\n        pass\n\n    class InvalidInputError(FlattenError):\n        \"\"\"Exception raised for invalid input data.\"\"\"\n        pass\n\n    ATOMIC_TYPES = (str, bytes, bytearray)\n\n    def is_iterable_but_not_str(value: Any) -> bool:\n        \"\"\"Checks if a value is iterable but not a string, bytes, or bytearray.\"\"\"\n        return isinstance(value, Iterable) and not isinstance(value, ATOMIC_TYPES)\n\n    # Input validation: top-level input must be a list or tuple.\n    if not isinstance(input_list, (list, tuple)):\n        raise InvalidInputError(\"Top-level input must be a list or tuple.\")\n\n    def _flatten_iterative(input_list_to_flatten: Any, max_depth_iter: Optional[int]) -> List[Any]:\n        \"\"\"Performs iterative flattening using a stack, respecting max_depth.\"\"\"\n        result: List[Any] = []\n        stack = [(iter(input_list_to_flatten), 0)]  # (iterator, current_depth)\n        while stack:\n            iterator, depth = stack[-1]\n            try:\n                item = next(iterator)\n            except StopIteration:\n                stack.pop()\n                continue\n\n            if max_depth_iter is not None and depth >= max_depth_iter:\n                # If current depth is at or beyond max_depth, append item as is\n                result.append(item)\n            elif is_iterable_but_not_str(item):\n                # If it's a flattenable iterable, push it onto the stack\n                stack.append((iter(item), depth + 1))\n            else:\n                # Otherwise, it's an atomic element, append to result\n                result.append(item)\n        return result\n\n    def _flatten_recursive(item: Any, current_depth: int, max_depth_rec: Optional[int], out_list_rec: List[Any]) -> None:\n        \"\"\"Recursively flattens an item, appending atomic elements to the result list.\"\"\"\n        if max_depth_rec is not None and current_depth > max_depth_rec:\n            out_list_rec.append(item)\n            return\n\n        if is_iterable_but_not_str(item):\n            for sub_item in item:\n                _flatten_recursive(sub_item, current_depth + 1, max_depth_rec, out_list_rec)\n        else:\n            out_list_rec.append(item)\n\n    if algorithm == 'iterative':\n        return _flatten_iterative(input_list, max_depth)\n    elif algorithm == 'recursive':\n        out: List[Any] = []\n        try:\n            _flatten_recursive(input_list, 0, max_depth, out)\n        except RecursionError as e:\n            raise FlattenError(\"Recursion depth exceeded; consider using the 'iterative' algorithm.\") from e\n        return out\n    else:\n        raise FlattenError(f\"Unknown flattening algorithm '{algorithm}'. Must be 'iterative' or 'recursive'.\")"}
{"task_id": "Mbpp/300", "solution": "import math\nclass InvalidNError(ValueError):\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\nclass MathUtils:\n    @staticmethod\n    def comb(n: int, k: int) -> int:\n        \"\"\"\n        Calculates the binomial coefficient C(n, k).\n        Uses math.comb if available, otherwise a multiplicative method.\n        \"\"\"\n        if hasattr(math, \"comb\"):\n            return math.comb(n, k)\n        return MathUtils._multiplicative_comb(n, k)\n\n    @staticmethod\n    def _multiplicative_comb(n: int, k: int) -> int:\n        if k < 0 or k > n:\n            return 0\n        k = min(k, n - k)\n        result = 1\n        for i in range(1, k + 1):\n            result = result * (n - (k - i)) // i\n        return result\ndef validate_n(n: any) -> int:\n    \"\"\"\n    Validates if n is an integer >= 0.\n    Raises InvalidNError otherwise.\n    \"\"\"\n    if not isinstance(n, int):\n        raise InvalidNError(\"n must be an integer\")\n    if n < 0:\n        raise InvalidNError(\"n must be >= 0\")\n    return n\nclass BinomialService:\n    def __init__(self):\n        self._cache = {} # type: dict[int, int]\n\n    def compute_central(self, n: int) -> int:\n        \"\"\"\n        Computes the central binomial coefficient C(2n, n).\n        Uses a simple in-memory cache.\n        \"\"\"\n        if n in self._cache:\n            return self._cache[n]\n        val = self._compute_binomial(2 * n, n)\n        if len(self._cache) < 1000: # Simple cache policy to limit size\n            self._cache[n] = val\n        return val\n\n    def _compute_binomial(self, upper: int, lower: int) -> int:\n        return MathUtils.comb(upper, lower)\nclass SequenceCounter:\n    def __init__(self, bin_service: BinomialService = None):\n        self._bin_service = bin_service or BinomialService()\n\n    def count(self, n: int) -> int:\n        \"\"\"\n        Validates n and computes the count of binary sequences.\n        Delegates to BinomialService for the central binomial coefficient.\n        \"\"\"\n        validate_n(n)\n        return self._bin_service.compute_central(n)\ndef count_binary_seq(n: int) -> int:\n    \"\"\"\n    Counts binary sequences of length 2n where sum of first n bits equals sum of last n bits.\n    This is equivalent to the central binomial coefficient C(2n, n).\n    \"\"\"\n    seq_counter = SequenceCounter()\n    return seq_counter.count(n)"}
{"task_id": "Mbpp/299", "solution": "def max_aggregate(items):\n    \"\"\"\n    Calculate the name with the maximum aggregate sum from an iterable of (name, value) tuples.\n\n    Returns a tuple (name, total). Raises ValueError/TypeError on invalid input or empty iterable.\n    \"\"\"\n    from math import isfinite\n\n    totals = {}\n    max_name = None\n    max_total = 0\n    any_item = False\n\n    for item in items:\n        any_item = True\n        if not isinstance(item, (tuple, list)) or len(item) != 2:\n            raise TypeError(f\"Each item must be a 2-tuple/list (name, value), got: {item!r}\")\n\n        name, value = item\n\n        if not isinstance(name, str):\n            raise TypeError(f\"Name must be a string, got: {type(name).__name__}: {name!r}\")\n        name = name.strip()\n\n        # Validate and convert value to int\n        if isinstance(value, bool):\n            raise TypeError(f\"Value must be an integer (not bool), got: {value!r}\")\n        if isinstance(value, int):\n            iv = value\n        elif isinstance(value, float):\n            if not isfinite(value):\n                raise ValueError(f\"Value must be a finite number, got: {value!r}\")\n            if not value.is_integer():\n                raise ValueError(f\"Float value must be integral to convert to int without loss, got: {value!r}\")\n            iv = int(value)\n        else:\n            # try converting other types (e.g., Decimal, str of integer)\n            try:\n                iv = int(value)\n            except Exception:\n                raise TypeError(f\"Value must be int-like, got: {value!r}\")\n\n        totals[name] = totals.get(name, 0) + iv\n        cur_total = totals[name]\n\n        # update max if this name now has a strictly greater total\n        if (max_name is None) or (cur_total > max_total):\n            max_name = name\n            max_total = cur_total\n        # on tie (cur_total == max_total) do not update to preserve first-encountered winner\n\n    if not any_item:\n        raise ValueError(\"No items to aggregate\")\n\n    return (max_name, max_total)"}
{"task_id": "Mbpp/305", "solution": "import re\nclass NotEnoughWordsError(Exception):\n    \"\"\"Raised when fewer than the required number of matching words are found.\"\"\"\n    def __init__(self, message: str) -> None:\n        self.message = message\n        super().__init__(self.message)\n_WORD_RE = re.compile(r\"\\b[\\w']+\\b\")\n_TARGET_CHAR = 'p'\n_MIN_MATCH = 2\ndef start_withp(words: list[str]) -> tuple[str, str]:\n    \"\"\"\n    Finds the first two words starting with 'p' (case-insensitive) from a list of strings.\n    \"\"\"\n    matched_words = []\n\n    # Helper function encapsulating StringCleaner.clean logic, defined inline.\n    def _clean_word(word_token: str) -> str:\n        # Strips leading/trailing punctuation and whitespace.\n        return word_token.strip(\" \\t\\n\\r\\\"'.,;:!?()[]{}-\")\n\n    # Helper function encapsulating StringCleaner.starts_with_target logic, defined inline.\n    def _starts_with_target_char(cleaned_word: str, target: str) -> bool:\n        # Checks if the cleaned word starts with the target character (case-insensitive).\n        return bool(cleaned_word) and cleaned_word[0].casefold() == target.casefold()\n\n    # Process each string in the input list.\n    for line_string in words:\n        # Tokenize the string into raw words using the pre-compiled regex.\n        tokens = _WORD_RE.findall(line_string)\n\n        # Iterate through each token to find matches.\n        for original_word_token in tokens:\n            cleaned_token = _clean_word(original_word_token)\n            if _starts_with_target_char(cleaned_token, _TARGET_CHAR):\n                matched_words.append(original_word_token)\n                # If two matches are found, return immediately.\n                if len(matched_words) == _MIN_MATCH:\n                    return tuple(matched_words)\n\n    # If the loop completes and fewer than two words were found, raise an error.\n    if len(matched_words) < _MIN_MATCH:\n        raise NotEnoughWordsError(f\"Found {len(matched_words)} word(s) starting with '{_TARGET_CHAR}', but {_MIN_MATCH} are required.\")\n\n    # This line should ideally be unreachable if _MIN_MATCH is 2 and the error is raised correctly,\n    # but serves as a safety return for type consistency.\n    return tuple(matched_words)"}
{"task_id": "Mbpp/301", "solution": "def dict_depth(d):\n    \"\"\"\n    Return the maximum nesting depth of dictionaries in d.\n    - Empty dict has depth 1.\n    - Non-dict top-level returns 0.\n    - Containers (list/tuple/set) are traversed for dicts but do not increase depth themselves.\n    \"\"\"\n    from collections.abc import Mapping\n\n    def _helper(node):\n        if isinstance(node, Mapping):\n            if not node:\n                return 1\n            max_child = 0\n            for v in node.values():\n                child_depth = _helper(v)\n                if child_depth > max_child:\n                    max_child = child_depth\n            return max_child + 1\n        if isinstance(node, (list, tuple, set)):\n            max_child = 0\n            for item in node:\n                child_depth = _helper(item)\n                if child_depth > max_child:\n                    max_child = child_depth\n            return max_child\n        return 0\n\n    return _helper(d)"}
{"task_id": "Mbpp/308", "solution": "import heapq\ndef large_product(a, b, k):\n    \"\"\"\n    Finds the specified number of largest products from two given lists,\n    selecting one factor from each list.\n    \"\"\"\n    if not isinstance(k, int) or k <= 0:\n        raise ValueError(\"k must be a positive integer\")\n    if not a or not b:\n        return []\n\n    # Create a generator for all possible products from lists a and b.\n    product_generator = (x * y for x in a for y in b)\n\n    # Use heapq.nlargest to efficiently find the k largest products.\n    return heapq.nlargest(k, product_generator)"}
{"task_id": "Mbpp/309", "solution": "def maximum(a, b):\n    \"\"\"Finds the maximum of two numbers. Returns the first argument if values are equal.\"\"\"\n    return a if a >= b else b"}
{"task_id": "Mbpp/306", "solution": "from typing import List\ndef max_sum_increasing_subseq(arr: List[int], n: int, i: int, k: int) -> int:\n    \"\"\"\n    Finds the maximum sum of an increasing subsequence from arr[0...i]\n    that also includes arr[k], where k > i.\n    \"\"\"\n\n    # Helper function to compute the maximum sum of an increasing subsequence\n    # ending at each index in a given array (prefix).\n    def _compute_prefix_dp(current_prefix: List[int]) -> List[int]:\n        m = len(current_prefix)\n        dp = [0] * m\n        for j in range(m):\n            dp[j] = current_prefix[j]  # Initialize with the element itself\n            for t in range(j):\n                # If current_prefix[t] can precede current_prefix[j] in an increasing subsequence\n                if current_prefix[t] < current_prefix[j]:\n                    # Update dp[j] if forming a new subsequence with current_prefix[j] on top of dp[t] yields a larger sum\n                    dp[j] = max(dp[j], dp[t] + current_prefix[j])\n        return dp\n\n    # The prompt explicitly states:\n    # \"DO NOT add isinstance() checks or raise exceptions for edge cases\".\n    # Therefore, we assume inputs are valid according to the preconditions:\n    # arr is a list of integers, 0 <= i < n, 0 <= k < n, k > i, n == len(arr).\n\n    # 1. Extract the prefix array up to index i (inclusive)\n    prefix_arr = arr[0 : i + 1]\n\n    # 2. Compute the DP array for this prefix\n    # dp_sums[j] will store the maximum sum of an increasing subsequence\n    # ending at prefix_arr[j].\n    dp_sums = _compute_prefix_dp(prefix_arr)\n\n    # 3. Determine the value of arr[k] that must be included in the final subsequence.\n    kth_element = arr[k]\n\n    # 4. Find the maximum sum from dp_sums that can precede arr[k].\n    # This means finding max(dp_sums[j]) such that prefix_arr[j] < kth_element.\n    # Initialize with 0 to allow for an empty prefix subsequence (as per business rule BR3).\n    max_prefix_sum_before_k = 0\n\n    # Iterate through the dp_sums array, which corresponds to elements in prefix_arr\n    for j_idx in range(len(prefix_arr)):\n        # Only consider prefix elements that are strictly less than arr[k]\n        if prefix_arr[j_idx] < kth_element:\n            max_prefix_sum_before_k = max(max_prefix_sum_before_k, dp_sums[j_idx])\n\n    # 5. The total maximum sum is the best prefix sum found plus arr[k].\n    # If no prefix element was smaller than arr[k], max_prefix_sum_before_k remains 0,\n    # correctly resulting in total_max_sum = arr[k] (empty prefix subsequence + arr[k]).\n    total_max_sum = max_prefix_sum_before_k + kth_element\n\n    return total_max_sum"}
{"task_id": "Mbpp/310", "solution": "def string_to_tuple(text):\n    \"\"\"Converts a given input to a tuple of its characters. Non-string inputs are coerced to a string first.\"\"\"\n    return tuple(str(text))"}
{"task_id": "Mbpp/311", "solution": "def set_left_most_unset_bit(n: int) -> int:\n    \"\"\"\n    Sets the left-most (most significant) unset bit in a non-negative integer.\n    If all bits are set, sets the next higher bit.\n    \"\"\"\n    if not isinstance(n, int) or n < 0:\n        raise ValueError(\"n must be a non-negative integer\")\n\n    if n == 0:\n        return 1\n\n    # Find the position of the most significant set bit\n    msb_pos = n.bit_length() - 1\n\n    # Iterate from MSB position down to 0 to find the first unset bit\n    for pos in range(msb_pos, -1, -1):\n        if not ((n >> pos) & 1):\n            return n | (1 << pos)\n\n    # If all bits from MSB down to 0 are set, set the next higher bit\n    return n | (1 << (msb_pos + 1))"}
{"task_id": "Mbpp/388", "solution": "def highest_Power_of_2(n: int) -> int:\n    \"\"\"Return the largest power of two less than or equal to n.\n    Returns 0 if n is 0.\n    \"\"\"\n    if n == 0:\n        return 0\n    return 1 << (n.bit_length() - 1)"}
