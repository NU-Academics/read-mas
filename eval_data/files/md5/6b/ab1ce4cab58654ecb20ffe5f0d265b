{"task_id": "Mbpp/797", "solution": "def sum_in_range(l: int, r: int) -> int:\n    \"\"\"\n    Computes the sum of all odd natural numbers in the inclusive integer range [l, r].\n    Delegates to an internal architecture for validation and calculation.\n    \"\"\"\n\n    # Custom exceptions for validation\n    class SumRangeError(Exception):\n        def __init__(self, message: str = \"\") -> None:\n            self.message = message\n            super().__init__(message)\n\n    class InvalidInputError(SumRangeError):\n        def __init__(self, message: str = \"\") -> None:\n            super().__init__(message)\n\n    class InvalidRangeError(SumRangeError):\n        def __init__(self, message: str = \"\") -> None:\n            super().__init__(message)\n\n    # Domain model for input range; encapsulates and validates input.\n    class RangeRequest:\n        def __init__(self, l_val: int, r_val: int) -> None:\n            self.l = l_val\n            self.r = r_val\n\n        def validate(self) -> None:\n            # Validates that l and r are integers, non-negative, and l <= r.\n            if not isinstance(self.l, int) or not isinstance(self.r, int):\n                raise InvalidInputError(\"Bounds must be integers\")\n            if self.l < 0 or self.r < 0:\n                raise InvalidInputError(\"Bounds must be non-negative\")\n            if self.l > self.r:\n                raise InvalidRangeError(\"Left bound must be <= right bound\")\n\n    # Abstraction for caching query results; currently an in-memory no-op default.\n    class SumRepository:\n        def __init__(self) -> None:\n            self._cache: dict[tuple[int, int], int] = {}\n\n        def get_cached(self, key: tuple[int, int]) -> int | None:\n            return self._cache.get(key)\n\n        def store_query(self, key: tuple[int, int], value: int) -> None:\n            self._cache[key] = value\n\n    # Business logic and fast computation algorithm using O(1) arithmetic.\n    class SumService:\n        def __init__(self, repository: \"SumRepository | None\" = None) -> None:\n            self._repo = repository\n\n        def _sum_odds_up_to(self, n: int) -> int:\n            # Helper to compute sum of odd numbers up to n. Returns 0 if n is less than 1.\n            if n < 1:\n                return 0\n            k = (n + 1) // 2\n            return k * k\n\n        def sum_range(self, req: RangeRequest) -> int:\n            # Computes the sum of odd numbers in the inclusive range; uses cache if available.\n            key = (req.l, req.r)\n            if self._repo:\n                cached = self._repo.get_cached(key)\n                if cached is not None:\n                    return cached\n\n            sum_r = self._sum_odds_up_to(req.r)\n            sum_lm1 = self._sum_odds_up_to(req.l - 1)\n            result = sum_r - sum_lm1\n\n            if self._repo:\n                self._repo.store_query(key, result)\n            return result\n\n    # Orchestration layer: provides a simple fa\u00e7ade for callers.\n    class SumController:\n        def __init__(self, service: SumService) -> None:\n            self._service = service\n\n        def compute(self, l_val: int, r_val: int) -> int:\n            # Validates inputs via RangeRequest, then calls the service to compute the sum.\n            req = RangeRequest(l_val, r_val)\n            req.validate()\n            return self._service.sum_range(req)\n\n    # Instantiate the components and perform the computation.\n    repo = SumRepository()\n    service = SumService(repository=repo)\n    controller = SumController(service=service)\n    return controller.compute(l, r)"}
{"task_id": "Mbpp/799", "solution": "def left_rotate(value: int, d: int) -> int:\n    \"\"\"\n    Rotates the bits of a 32-bit integer left by d positions.\n    The number is treated as an unsigned 32-bit integer.\n    \"\"\"\n    BIT_WIDTH = 32\n    BIT_MASK = 0xFFFFFFFF\n\n    # Mask the value to ensure it's treated as a 32-bit unsigned integer.\n    masked_value = value & BIT_MASK\n\n    # Normalize the shift amount to be within [0, BIT_WIDTH - 1].\n    s = d % BIT_WIDTH\n\n    if s == 0:\n        return masked_value\n    else:\n        # Perform the left rotation:\n        # 1. Shift left by 's' bits.\n        # 2. Shift right by 'BIT_WIDTH - s' bits to bring the \"overflowed\" bits from the left.\n        # 3. Combine the two parts with a bitwise OR.\n        # 4. Mask the final result to ensure it fits within 32 bits.\n        result = ((masked_value << s) | (masked_value >> (BIT_WIDTH - s))) & BIT_MASK\n        return result"}
{"task_id": "Mbpp/801", "solution": "def test_three_equal(a, b, c):\n    # Counts the number of equal numbers among three given integers.\n    if a == b == c:\n        return 3\n    elif a == b or a == c or b == c:\n        return 2\n    else:\n        return 0"}
{"task_id": "Mbpp/803", "solution": "def is_perfect_square(num):\n    \"\"\"\n    Checks if a given number is a perfect square.\n    Returns True if num is a non-negative integer that is a perfect square, otherwise False.\n    \"\"\"\n    # Validate type: allow ints only (following the original simple requirement)\n    if not isinstance(num, int):\n        raise TypeError(\"num must be an int\")\n    if num < 0:\n        return False\n    # Fast path for small values\n    if num in (0, 1):\n        return True\n    # Use integer square root via math.isqrt for correctness and performance\n    import math\n    s = math.isqrt(num)\n    return s * s == num"}
{"task_id": "Mbpp/804", "solution": "def is_product_even(numbers: list) -> bool:\n    \"\"\"\n    Checks if the product of numbers in a list is even.\n    Returns True if any number is even, False otherwise (including an empty list).\n    \"\"\"\n    for n in numbers:\n        if n % 2 == 0:\n            return True\n    return False"}
{"task_id": "Mbpp/808", "solution": "def check_K(data, K):\n    \"\"\"\n    Checks if the integer K is present in the given tuple data.\n\n    Args:\n        data (tuple): A tuple of integers.\n        K (int): The integer to search for.\n\n    Returns:\n        bool: True if K is in data, False otherwise.\n\n    Note:\n        This function performs a direct membership test. It does not perform\n        strict type validation and assumes the caller provides a tuple of ints.\n    \"\"\"\n    return K in data"}
{"task_id": "Mbpp/806", "solution": "def max_run_uppercase(s: str) -> int:\n    \"\"\"\n    Return the length of the longest contiguous run of uppercase characters in s.\n\n    Raises:\n        TypeError: if s is not a str.\n    \"\"\"\n    if not isinstance(s, str):\n        raise TypeError(\"s must be a str\")\n\n    max_run = 0\n    cur = 0\n    for ch in s:\n        if ch.isupper():\n            cur += 1\n            if cur > max_run:\n                max_run = cur\n        else:\n            cur = 0\n    return max_run"}
{"task_id": "Mbpp/805", "solution": "def max_sum_list(list_of_lists):\n    \"\"\"\n    Returns the sub-list from a list of lists whose sum of elements is the highest.\n    In case of a tie, the first sub-list encountered with the maximum sum is returned.\n    \"\"\"\n    best_list = None\n    best_sum = None\n\n    for sublist in list_of_lists:\n        current_sum = sum(sublist)\n        if best_sum is None or current_sum > best_sum:\n            best_sum = current_sum\n            best_list = sublist\n\n    return best_list"}
{"task_id": "Mbpp/807", "solution": "def _is_integer_value(n: Number) -> bool:\n    \"\"\"Checks if a number is an integer or a float with an integer value.\"\"\"\n    return isinstance(n, int) or (isinstance(n, float) and n.is_integer())\nclass NumberList:\n    \"\"\"Represents and encapsulates a normalized list of integer values.\"\"\"\n    def __init__(self, numbers: list[int]) -> None:\n        self._numbers = list(numbers)\n\n    def __iter__(self) -> Iterator[int]:\n        return iter(self._numbers)\n\n    def __len__(self) -> int:\n        return len(self._numbers)\n\n    def to_list(self) -> list[int]:\n        \"\"\"Returns a shallow copy of the stored numbers.\"\"\"\n        return list(self._numbers)\nclass InputValidator:\n    \"\"\"Validates input types and normalizes numeric values to integers.\"\"\"\n    def validate_and_normalize(self, numbers: Iterable[Any]) -> list[int]:\n        \"\"\"Ensures input is iterable, checks numeric types, coerces integer-valued floats to int.\"\"\"\n        if not hasattr(numbers, '__iter__'):\n            raise InvalidInputError(\"Input must be iterable\")\n\n        normalized: list[int] = []\n        for idx, v in enumerate(numbers):\n            if isinstance(v, int):\n                normalized.append(v)\n            elif isinstance(v, float) and _is_integer_value(v):\n                normalized.append(int(v))\n            else:\n                raise InvalidInputError(f\"Invalid item at index {idx}: {v!r}. Expected integer or integer-valued float.\")\n        return normalized\nclass LastResultRepository:\n    \"\"\"File-based persistence for the last computed result.\"\"\"\n    DEFAULT_FILENAME = \"last_first_odd.json\"\n\n    def __init__(self, path: str) -> None:\n        \"\"\"Initializes the repository with a path; resolves to default filename if path is a directory.\"\"\"\n        if os.path.isdir(path):\n            self.path = os.path.join(path, self.DEFAULT_FILENAME)\n        else:\n            self.path = path\n\n    def save_result(self, input_list: list[int], result: int, timestamp: float) -> None:\n        \"\"\"Writes JSON with input list, result, and timestamp to the configured file.\"\"\"\n        data = {\n            \"timestamp\": timestamp,\n            \"input\": input_list,\n            \"result\": result\n        }\n        try:\n            with open(self.path, 'w', encoding='utf-8') as f:\n                json.dump(data, f, indent=2)\n        except (IOError, OSError, TypeError) as e:\n            raise PersistenceError(f\"Failed to save result to {self.path}: {e}\") from e\n\n    def load_last(self) -> Optional[dict]:\n        \"\"\"Loads the last result from the JSON file or returns None if the file is missing.\"\"\"\n        if not os.path.exists(self.path):\n            return None\n        try:\n            with open(self.path, 'r', encoding='utf-8') as f:\n                return json.load(f)\n        except (IOError, OSError) as e:\n            raise PersistenceError(f\"Failed to load result from {self.path}: {e}\") from e\n        except json.JSONDecodeError as e:\n            raise PersistenceError(f\"Malformed JSON in {self.path}: {e}\") from e\nclass FirstOddFinderService:\n    \"\"\"Encapsulates the algorithm to find the first odd integer in a list.\"\"\"\n    def __init__(self, validator: InputValidator, repository: Optional[LastResultRepository] = None, persist: bool = False) -> None:\n        self.validator = validator\n        self.repository = repository\n        self.persist = persist\n\n    def _is_odd(self, n: int) -> bool:\n        \"\"\"Returns True if the given integer is odd.\"\"\"\n        return n % 2 != 0\n\n    def find_first_odd(self, numbers: Iterable[Number]) -> int:\n        \"\"\"Validates inputs, iterates numbers, and returns the first odd integer found.\"\"\"\n        ints = self.validator.validate_and_normalize(numbers)\n        nl = NumberList(ints)\n\n        for n in nl:\n            if self._is_odd(n):\n                result = int(n)\n                if self.persist and self.repository is not None:\n                    try:\n                        self.repository.save_result(nl.to_list(), result, time.time())\n                    except PersistenceError:\n                        # Log the error but do not prevent returning the result.\n                        # In a real app, this would use a logger.\n                        pass\n                return result\n        raise FirstOddNotFoundError(\"No odd number found in the provided list.\")\ndef first_odd(numbers: Iterable[Number]) -> int:\n    \"\"\"\n    Finds and returns the first odd number from a list of numbers.\n    Supports integers and integer-valued floats.\n    \"\"\"\n    validator = InputValidator()\n    service = FirstOddFinderService(validator=validator, repository=None, persist=False)\n    return service.find_first_odd(numbers)"}
{"task_id": "Mbpp/809", "solution": "def check_smaller(a, b):\n    \"\"\"\n    Return True iff for every index i, b[i] < a[i].\n\n    Accepts sequence-like inputs (e.g., tuple or list). Raises TypeError if inputs\n    are not sequence-like or elements are not comparable, and ValueError if lengths differ.\n    \"\"\"\n    # Ensure a and b are sequence-like with length\n    if not (hasattr(a, \"__len__\") and hasattr(b, \"__len__\")):\n        raise TypeError(\"a and b must be sequences (e.g., tuple or list)\")\n    if len(a) != len(b):\n        raise ValueError(\"a and b must have the same length\")\n\n    for i, (ai, bi) in enumerate(zip(a, b)):\n        try:\n            if not (bi < ai):\n                return False\n        except TypeError:\n            raise TypeError(f\"elements at index {i} are not comparable: {bi!r} and {ai!r}\")\n    return True"}
