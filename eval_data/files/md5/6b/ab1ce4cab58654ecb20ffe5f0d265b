{"task_id": "Mbpp/554", "solution": "from typing import Any, List\nclass InvalidInputError(Exception):\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\ndef _is_int(value: Any) -> bool:\n    \"\"\"Helper to check if a value is an integer and not a boolean.\"\"\"\n    return isinstance(value, int) and not isinstance(value, bool)\n_MAX_INPUT_LENGTH: int = 1000000\ndef Split(numbers: Any) -> List[int]:\n    \"\"\"\n    Filters an iterable of numbers, returning only the odd integers.\n    Performs input validation as specified in the design context.\n    \"\"\"\n    if numbers is None:\n        raise InvalidInputError(\"Input is required\")\n\n    try:\n        iterator = list(numbers)\n    except TypeError:\n        raise InvalidInputError(\"Input must be an iterable of integers\")\n\n    if len(iterator) > _MAX_INPUT_LENGTH:\n        raise InvalidInputError(\"Input too large\")\n\n    validated_numbers = []\n    for i, v in enumerate(iterator):\n        if not _is_int(v):\n            raise InvalidInputError(f\"Element at index {i} is not an integer: {v!r}\")\n        validated_numbers.append(v)\n\n    return [n for n in validated_numbers if n % 2 != 0]"}
{"task_id": "Mbpp/477", "solution": "def is_lower(text: str) -> str:\n    \"\"\"\n    Converts the input string to its lowercase equivalent.\n    Raises ValueError if input is not a string or None.\n    \"\"\"\n    if text is None or not isinstance(text, str):\n        raise ValueError(\"text must be a str\")\n    return text.lower()"}
{"task_id": "Mbpp/479", "solution": "def first_Digit(num):\n    \"\"\"\n    Finds the first (most significant) digit of a given number.\n    Handles integers (positive/negative). For non-integer inputs, raises TypeError.\n    \"\"\"\n    if not isinstance(num, int):\n        # allow booleans? bool is subclass of int; treat as int\n        if isinstance(num, bool):\n            num = int(num)\n        else:\n            raise TypeError(\"first_Digit expects an int\")\n    s = str(abs(num))\n    for char in s:\n        if '0' <= char <= '9':\n            return int(char)"}
{"task_id": "Mbpp/556", "solution": "def find_Odd_Pair(arr, n):\n    \"\"\"\n    Counts the number of unordered pairs in 'arr' whose XOR value is odd.\n    A pair's XOR is odd if one number is odd and the other is even.\n    \"\"\"\n    odd_count = 0\n    even_count = 0\n\n    for num in arr:\n        if num & 1:\n            odd_count += 1\n        else:\n            even_count += 1\n\n    return odd_count * even_count"}
{"task_id": "Mbpp/558", "solution": "def digit_distance_nums(a: int, b: int) -> int:\n    \"\"\"\n    Calculates the sum of per-digit absolute differences between two integers.\n    Digits are aligned from the least significant digit (right-aligned) after converting to absolute values.\n    \"\"\"\n\n    def _digits_of(n: int) -> list[int]:\n        # Returns a list of digits for a non-negative integer, least-significant-first.\n        if n == 0:\n            return [0]\n        return [int(ch) for ch in reversed(str(n))]\n\n    def _pad_digits(da: list[int], db: list[int]) -> tuple[list[int], list[int]]:\n        # Pads the shorter digit list with zeros to match the length of the longer list.\n        maxlen = max(len(da), len(db))\n        return (da + [0] * (maxlen - len(da)), db + [0] * (maxlen - len(db)))\n\n    # Use absolute values of the input integers for digit extraction\n    abs_a = abs(a)\n    abs_b = abs(b)\n\n    # Get digit lists, ordered least-significant-digit first\n    digits_a = _digits_of(abs_a)\n    digits_b = _digits_of(abs_b)\n\n    # Pad the digit lists to ensure they are the same length for iteration\n    padded_digits_a, padded_digits_b = _pad_digits(digits_a, digits_b)\n\n    # Calculate the sum of absolute differences between corresponding digits\n    total_distance = sum(abs(x - y) for x, y in zip(padded_digits_a, padded_digits_b))\n\n    return total_distance"}
{"task_id": "Mbpp/559", "solution": "def max_sub_array_sum(arr: list, n: int) -> int:\n    \"\"\"Finds the sum of the largest contiguous sublist using Kadane's algorithm.\n    It assumes the input list 'arr' is not empty and 'n' equals its length.\"\"\"\n    if not isinstance(arr, list):\n        raise TypeError(\"arr must be a list\")\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an int\")\n    if n != len(arr):\n        raise ValueError(\"n must equal len(arr)\")\n    if n == 0:\n        raise ValueError(\"arr must not be empty\")\n\n    max_so_far = arr[0]\n    current_max = arr[0]\n\n    for i in range(1, n):\n        current_max = arr[i] if arr[i] > current_max + arr[i] else current_max + arr[i]\n        max_so_far = current_max if current_max > max_so_far else max_so_far\n\n    return max_so_far"}
{"task_id": "Mbpp/562", "solution": "from typing import List, Any\ndef Find_Max_Length(lists: List[List[Any]]) -> int:\n    \"\"\"\n    Finds the length of the longest sublist in a list of lists.\n    Returns 0 if the input list is empty.\n    \"\"\"\n    max_length = 0\n    for sublist in lists:\n        max_length = max(max_length, len(sublist))\n    return max_length"}
