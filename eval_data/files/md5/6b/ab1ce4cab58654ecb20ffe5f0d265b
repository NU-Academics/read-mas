{"task_id": "Mbpp/111", "solution": "def common_in_nested_lists(lists):\n    \"\"\"\n    Return the elements common to all nested lists in `lists`.\n\n    Args:\n        lists (list[list|tuple]): A list of lists/tuples containing hashable elements.\n\n    Returns:\n        list: A deterministic list of elements present in every nested list. Sorted when elements are comparable.\n\n    Raises:\n        TypeError: If the top-level input is not a list or if any nested item is not a list/tuple,\n                   or if elements are unhashable.\n    \"\"\"\n    if not isinstance(lists, list):\n        raise TypeError(\"Input must be a list of lists/tuples\")\n\n    if len(lists) == 0:\n        return []\n\n    # Validate and initialize result set from the first nested list\n    first = lists[0]\n    if not isinstance(first, (list, tuple)):\n        raise TypeError(\"Each element of the top-level list must be a list or tuple\")\n\n    try:\n        result_set = set(first)\n    except TypeError as e:\n        raise TypeError(\"Elements must be hashable\") from e\n\n    # Intersect with each subsequent nested list\n    for idx, sub in enumerate(lists[1:], start=1):\n        if not isinstance(sub, (list, tuple)):\n            raise TypeError(f\"Each element of the top-level list must be a list or tuple (index {idx})\")\n        try:\n            result_set &= set(sub)\n        except TypeError as e:\n            raise TypeError(\"Elements must be hashable\") from e\n        if not result_set:\n            return []\n\n    # Return a deterministic ordering: try sorted, otherwise fallback to list()\n    try:\n        return sorted(result_set)\n    except TypeError:\n        return list(result_set)"}
{"task_id": "Mbpp/113", "solution": "def check_integer(s: str) -> bool:\n    \"\"\"Checks if a string represents an integer, trimming whitespace.\n    Allows optional sign and digits only, no fractional parts or exponents.\n    \"\"\"\n    import re\n    # Define the regex pattern for integers: optional sign, then one or more digits.\n    _DIGIT_REGEX = re.compile(r\"^[+-]?\\d+$\")\n\n    s = s.strip()\n    if not s:\n        return False\n\n    if _DIGIT_REGEX.match(s):\n        try:\n            # Attempt to convert to an integer to ensure it's a valid integer representation.\n            int(s)\n            return True\n        except ValueError:\n            # This case should ideally not be reached if the regex is correct for int,\n            # but is included for defensive programming as per design context.\n            return False\n    return False"}
{"task_id": "Mbpp/116", "solution": "def tuple_to_int(nums):\n    \"\"\"\n    Convert a tuple of positive integers into a single integer by concatenating\n    their decimal representations.\n\n    Example:\n        tuple_to_int((1, 2, 3)) -> 123\n\n    Raises:\n        TypeError: if nums is not a tuple or any element is not an int.\n        ValueError: if any element is not a positive integer (> 0).\n    \"\"\"\n    if not isinstance(nums, tuple):\n        raise TypeError(\"nums must be a tuple of positive integers\")\n\n    if not nums:\n        return 0\n\n    parts = []\n    for i, v in enumerate(nums):\n        if isinstance(v, bool) or not isinstance(v, int):\n            raise TypeError(f\"element at index {i} is not an int: {v!r}\")\n        if v <= 0:\n            raise ValueError(f\"element at index {i} is not positive: {v}\")\n        parts.append(str(v))\n\n    return int(\"\".join(parts))"}
