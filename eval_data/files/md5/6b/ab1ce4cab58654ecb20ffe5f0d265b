{"task_id": "Mbpp/577", "solution": "import math\ndef last_Digit_Factorial(n: int) -> int:\n    \"\"\"Calculates the last digit of n! (factorial of n).\n    For n >= 5, the last digit is always 0.\"\"\"\n    if n >= 5:\n        return 0\n    # Compute factorial for small n and return its last digit.\n    factorial_n = math.factorial(n)\n    return factorial_n % 10"}
{"task_id": "Mbpp/572", "solution": "def two_unique_nums(*lists):\n    \"\"\"\n    Removes duplicate numbers from a given number of lists, returning only numbers\n    that appear exactly once, preserving their first-occurrence order.\n    \"\"\"\n    from collections import Counter\n\n    flat = []\n    for sublist in lists:\n        flat.extend(sublist)\n\n    counts = Counter(flat)\n    result = []\n    seen = set()\n\n    for item in flat:\n        if item in seen:\n            continue\n        seen.add(item)\n\n        if counts[item] == 1:\n            result.append(item)\n\n    return result"}
{"task_id": "Mbpp/573", "solution": "def unique_product(numbers):\n    \"\"\"\n    Calculates the product of the unique numbers in a given list.\n    Handles various numeric types and string representations, and returns 1 for empty inputs.\n    \"\"\"\n    from dataclasses import dataclass\n    from typing import Sequence, Any, List, Union\n\n    # Define Number type alias for convenience\n    Number = Union[int, float]\n\n    # 1. Define custom exceptions\n    class UniqueProductError(Exception):\n        \"\"\"Base exception for unique product operations.\"\"\"\n        def __init__(self, message: str):\n            self.message = message\n            super().__init__(message)\n\n    class InvalidInputError(UniqueProductError):\n        \"\"\"Exception raised for invalid input values.\"\"\"\n        def __init__(self, message: str, invalid_value: Any):\n            self.invalid_value = invalid_value\n            super().__init__(message)\n\n    # 2. Define ProductResult dataclass\n    @dataclass\n    class ProductResult:\n        \"\"\"Dataclass to encapsulate the computed product and unique count.\"\"\"\n        result: Number\n        unique_count: int\n\n        def as_dict(self) -> dict:\n            \"\"\"Returns a serializable dictionary representation.\"\"\"\n            return {\"result\": self.result, \"unique_count\": self.unique_count}\n\n    # 3. Define MathUtils class\n    class MathUtils:\n        \"\"\"Utility class for mathematical operations.\"\"\"\n        EPSILON = 1e-12\n\n        def multiply_list(self, values: Sequence[Number]) -> Number:\n            \"\"\"Multiplies all numbers in a sequence, returning 1 for an empty sequence.\"\"\"\n            if not values:\n                return 1\n\n            result: Number = 1\n            int_only = True\n\n            for v in values:\n                if not isinstance(v, int):\n                    int_only = False\n                result = self._safe_multiply(result, v)\n\n            # Convert to int if all inputs were int and result is float-equivalent to int\n            if int_only and isinstance(result, float) and abs(result - int(result)) < self.EPSILON:\n                return int(result)\n\n            return result\n\n        def _safe_multiply(self, a: Number, b: Number) -> Number:\n            \"\"\"Multiplies two numbers, preserving int type if both are int.\"\"\"\n            # Python's default multiplication already handles this behavior correctly\n            return a * b\n\n    # 4. Define InputValidator class\n    class InputValidator:\n        \"\"\"Validates and coerces input sequence elements to numeric types.\"\"\"\n        ALLOWED_TYPES = (int, float)\n\n        def validate_and_coerce(self, numbers_input: Sequence[Any]) -> List[Number]:\n            \"\"\"Validates and coerces a sequence of values into a list of numbers.\"\"\"\n            if numbers_input is None:\n                raise InvalidInputError(\"Input must be a sequence\", None)\n            out: List[Number] = []\n            for v in numbers_input:\n                if isinstance(v, self.ALLOWED_TYPES):\n                    out.append(v)\n                    continue\n                if isinstance(v, str):\n                    try:\n                        # Prefer int if no decimal, otherwise float\n                        if '.' in v:\n                            out.append(float(v))\n                        else:\n                            out.append(int(v))\n                        continue\n                    except ValueError:\n                        raise InvalidInputError(f\"Cannot parse '{v}' as number\", v)\n                raise InvalidInputError(f\"Unsupported value type: {type(v)}\", v)\n            return out\n\n    # 5. Define UniqueProductService class\n    class UniqueProductService:\n        \"\"\"Business logic for computing the product of unique numbers.\"\"\"\n        def __init__(self, validator: InputValidator = None, math_utils: MathUtils = None):\n            \"\"\"Initializes the service with optional validator and math utilities.\"\"\"\n            self.validator = validator or InputValidator()\n            self.math_utils = math_utils or MathUtils()\n\n        def compute(self, numbers_to_process: Sequence[Any]) -> ProductResult:\n            \"\"\"Computes the product of unique numeric values from the input sequence.\"\"\"\n            numeric_values = self.validator.validate_and_coerce(numbers_to_process)\n            unique_values = set(numeric_values)\n\n            # Sorting for deterministic behavior, though not strictly required for product\n            sorted_unique_values = sorted(list(unique_values))\n\n            product = self.math_utils.multiply_list(sorted_unique_values)\n            return ProductResult(product, len(unique_values))\n\n    # 6. Define UniqueProductController class\n    class UniqueProductController:\n        \"\"\"Controller to provide a clean programmatic API for unique product computation.\"\"\"\n        def __init__(self, service: UniqueProductService = None):\n            \"\"\"Initializes the controller with an optional UniqueProductService.\"\"\"\n            self.service = service or UniqueProductService()\n\n        def compute(self, numbers_to_compute: Sequence[Any]) -> Number:\n            \"\"\"Computes the unique product and returns the primitive numeric result.\"\"\"\n            result_obj = self.service.compute(numbers_to_compute)\n            return result_obj.result\n\n    # Instantiate the controller with its dependencies\n    controller = UniqueProductController(\n        service=UniqueProductService(\n            validator=InputValidator(),\n            math_utils=MathUtils()\n        )\n    )\n    # Delegate the actual computation to the controller\n    return controller.compute(numbers)"}
{"task_id": "Mbpp/579", "solution": "def find_dissimilar(a: tuple, b: tuple) -> tuple:\n    \"\"\"Finds elements present in exactly one of the two tuples, preserving order.\"\"\"\n    a_set = set(a)\n    b_set = set(b)\n    seen = set()\n    result = []\n\n    for x in a:\n        if x not in b_set and x not in seen:\n            result.append(x)\n            seen.add(x)\n\n    for x in b:\n        if x not in a_set and x not in seen:\n            result.append(x)\n            seen.add(x)\n\n    return tuple(result)"}
{"task_id": "Mbpp/578", "solution": "from typing import Sequence, List, TypeVar, Any\nT = TypeVar(\"T\")\ndef interleave_lists(list1: Sequence[T], list2: Sequence[T], list3: Sequence[T]) -> List[T]:\n    \"\"\"\n    Interleaves three lists of the same length into a single flat list.\n    Validates inputs for iterability and equal length before interleaving.\n    \"\"\"\n\n    class ValidationError(Exception):\n        \"\"\"Custom exception for validation failures.\"\"\"\n        pass\n\n    class InterleaveError(Exception):\n        \"\"\"Custom exception for unexpected errors during interleaving.\"\"\"\n        pass\n\n    class ListValidator:\n        \"\"\"Utility class for validating list inputs.\"\"\"\n        def validate_iterable(self, obj: Any, name: str) -> None:\n            if obj is None:\n                raise ValidationError(f\"{name} is None; expected an indexable sequence\")\n            try:\n                # Check for len() support\n                _ = len(obj)\n                # Check for __getitem__ support on first element if not empty\n                _ = obj[0] if len(obj) > 0 else None\n            except Exception:\n                raise ValidationError(f\"{name} must be an indexable sequence (support len() and __getitem__)\")\n\n        def validate_equal_length(self, list1: Sequence[Any], list2: Sequence[Any], list3: Sequence[Any]) -> None:\n            if not (len(list1) == len(list2) == len(list3)):\n                raise ValidationError(\"All three lists must have the same length\")\n\n    class InterleaverService:\n        \"\"\"Service class that implements the core interleaving algorithm.\"\"\"\n        def interleave(self, list1: Sequence[T], list2: Sequence[T], list3: Sequence[T]) -> List[T]:\n            n = len(list1)\n            result: List[T] = []\n            for i in range(n):\n                result.append(list1[i])\n                result.append(list2[i])\n                result.append(list3[i])\n            return result\n\n    class InterleaveController:\n        \"\"\"Controller/facade that orchestrates validation and interleaving.\"\"\"\n        def __init__(self, validator: ListValidator, service: InterleaverService) -> None:\n            self.validator = validator\n            self.service = service\n\n        def interleave_lists(self, list1: Sequence[T], list2: Sequence[T], list3: Sequence[T]) -> List[T]:\n            self.validator.validate_iterable(list1, \"list1\")\n            self.validator.validate_iterable(list2, \"list2\")\n            self.validator.validate_iterable(list3, \"list3\")\n            self.validator.validate_equal_length(list1, list2, list3)\n            try:\n                return self.service.interleave(list1, list2, list3)\n            except Exception as e:\n                # Wrap unexpected exceptions for a consistent error contract\n                raise InterleaveError(f\"Unexpected error during interleave: {e}\") from e\n\n    # Instantiate the controller with its dependencies\n    controller = InterleaveController(ListValidator(), InterleaverService())\n\n    # Call the controller's interleave_lists method to execute the logic\n    return controller.interleave_lists(list1, list2, list3)"}
{"task_id": "Mbpp/576", "solution": "def is_Sub_Array(haystack, needle):\n    \"\"\"\n    Return True if `needle` is a contiguous sublist of `haystack`, else False.\n\n    Args:\n        haystack (list): The list to search within.\n        needle (list): The sublist pattern to find.\n\n    Raises:\n        TypeError: If either argument is not a list.\n    \"\"\"\n    if not isinstance(haystack, list) or not isinstance(needle, list):\n        raise TypeError(\"haystack and needle must be lists\")\n\n    # Business rule: empty needle is considered a sublist of any haystack\n    if len(needle) == 0:\n        return True\n\n    # If needle longer than haystack, cannot be a sublist\n    if len(needle) > len(haystack):\n        return False\n\n    # Compute LPS (longest proper prefix which is also suffix) array for needle\n    lps = [0] * len(needle)\n    length = 0  # length of the previous longest prefix suffix\n    i = 1\n    while i < len(needle):\n        if needle[i] == needle[length]:\n            length += 1\n            lps[i] = length\n            i += 1\n        else:\n            if length != 0:\n                length = lps[length - 1]\n            else:\n                lps[i] = 0\n                i += 1\n\n    # KMP search\n    i = j = 0  # i -> index for haystack, j -> index for needle\n    while i < len(haystack):\n        if haystack[i] == needle[j]:\n            i += 1\n            j += 1\n            if j == len(needle):\n                return True\n        else:\n            if j != 0:\n                j = lps[j - 1]\n            else:\n                i += 1\n\n    return False"}
{"task_id": "Mbpp/580", "solution": "def extract_even(nested):\n    \"\"\"Recursively removes all odd integers from a nested tuple, preserving structure.\"\"\"\n    if not isinstance(nested, tuple):\n        raise TypeError(\"Input must be a tuple\")\n\n    result = []\n    for item in nested:\n        if isinstance(item, int) and not isinstance(item, bool):\n            if item % 2 == 0:\n                result.append(item)\n        elif isinstance(item, tuple):\n            # Recursively process the sub-tuple\n            processed_sub_tuple = extract_even(item)\n            result.append(processed_sub_tuple)\n        else:\n            raise TypeError(f\"Unsupported element type: {type(item).__name__}\")\n    return tuple(result)"}
{"task_id": "Mbpp/583", "solution": "def catalan_number(n: int) -> int:\n    \"\"\"\n    Computes the nth Catalan number using the dynamic programming recurrence relation.\n    This iterative approach efficiently calculates C_n for moderate values of n.\n    \"\"\"\n    if n == 0:\n        return 1\n\n    # Initialize a list to store Catalan numbers.\n    # catalan[i] will store the i-th Catalan number.\n    catalan = [0] * (n + 1)\n    catalan[0] = 1\n\n    # Compute Catalan numbers iteratively using the recurrence relation:\n    # C_i = C_{i-1} * (2 * (2*i - 1)) // (i + 1)\n    for i in range(1, n + 1):\n        catalan[i] = (catalan[i-1] * (2 * (2*i - 1))) // (i + 1)\n\n    return catalan[n]"}
{"task_id": "Mbpp/581", "solution": "def surface_Area(base_edge, height):\n    \"\"\"\n    Calculates the total surface area of a square pyramid.\n    The 'height' parameter is interpreted as the slant height of the pyramid.\n    \"\"\"\n    base_area = base_edge ** 2\n    lateral_area = 2 * base_edge * height\n    return base_area + lateral_area"}
{"task_id": "Mbpp/586", "solution": "def split_Arr(arr: list, n: int) -> list:\n    \"\"\"\n    Splits a list at the nth element and adds the first part to the end.\n\n    Examples:\n        >>> split_Arr([12,10,5,6,52,36], 2)\n        [5, 6, 52, 36, 12, 10]\n\n    Behavior:\n    - If arr is empty, returns [].\n    - n may be negative, zero, or larger than len(arr); it's normalized with modulo.\n    - The original list is not modified.\n    \"\"\"\n    if not isinstance(arr, list):\n        raise TypeError(\"arr must be a list\")\n    if not arr:\n        return []\n\n    if not isinstance(n, int):\n        # allow integer-valued floats (e.g., 2.0)\n        if isinstance(n, float) and n.is_integer():\n            n = int(n)\n        else:\n            raise TypeError(\"n must be an integer\")\n\n    length = len(arr)\n    # Normalize n into [0, length)\n    normalized_n = n % length\n\n    return arr[normalized_n:] + arr[:normalized_n]"}
