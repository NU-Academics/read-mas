{"task_id": "Mbpp/87", "solution": "def merge_dictionaries_three(d1: dict[str, str], d2: dict[str, str], d3: dict[str, str]) -> dict[str, str]:\n    \"\"\"\n    Merges three dictionaries into a single dictionary, preserving the first-seen value\n    for keys that appear in multiple inputs (left precedence).\n    \"\"\"\n    merged_dict = {}\n\n    # Add all items from the first dictionary, which has the highest precedence.\n    for key, value in d1.items():\n        merged_dict[key] = value\n\n    # Add items from the second dictionary only if the key is not already present.\n    for key, value in d2.items():\n        if key not in merged_dict:\n            merged_dict[key] = value\n\n    # Add items from the third dictionary only if the key is not already present.\n    for key, value in d3.items():\n        if key not in merged_dict:\n            merged_dict[key] = value\n\n    return merged_dict"}
{"task_id": "Mbpp/84", "solution": "def sequence(n: int, use_cache: bool = True, cache_path: str | None = None) -> int:\n    \"\"\"\n    Computes the nth term of the Newman-Conway sequence, optionally using a cache.\n    This function initializes the necessary caching and service components.\n    \"\"\"\n    from pathlib import Path\n    from .services import SequenceService\n    from .adapters import FileCacheAdapter\n    from .cache import InMemoryCache\n\n    if use_cache:\n        # If cache_path is None, FileCacheAdapter will use its default path.\n        cache = FileCacheAdapter(Path(cache_path) if cache_path else None)\n    else:\n        cache = InMemoryCache()\n\n    svc = SequenceService(cache_repo=cache)\n    return svc.compute_term(n)"}
{"task_id": "Mbpp/86", "solution": "def centered_hexagonal_number(n: int) -> int:\n    \"\"\"Calculates the nth centered hexagonal number using the formula H(n) = 3*n*(n-1) + 1.\"\"\"\n    return 3 * n * (n - 1) + 1"}
{"task_id": "Mbpp/89", "solution": "import math\ndef closest_num(n):\n    \"\"\"\n    Finds the largest integer strictly less than the given number n.\n    For integer n, it returns n-1; for non-integer n, it returns floor(n).\n    \"\"\"\n    floor_n = math.floor(n)\n    if floor_n < n:\n        return int(floor_n)\n    else:\n        # This branch is taken when n is an integer or a float representing an exact integer (e.g., 11.0)\n        return int(floor_n - 1)"}
{"task_id": "Mbpp/88", "solution": "import collections.abc\nclass InvalidInputError(Exception):\n    \"\"\"Custom exception for invalid input encountered during frequency counting.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\ndef is_iterable(obj: object) -> bool:\n    \"\"\"Checks if an object is iterable but specifically excludes string and bytes types.\"\"\"\n    return isinstance(obj, collections.abc.Iterable) and not isinstance(obj, (str, bytes))\ndef is_hashable(obj: object) -> bool:\n    \"\"\"Checks if an object is hashable.\"\"\"\n    try:\n        hash(obj)\n        return True\n    except TypeError:\n        return False\nclass FrequencyResult:\n    \"\"\"Data model to encapsulate frequency counts and total item count.\"\"\"\n    def __init__(self, counts: dict):\n        self.counts = counts\n        self.total = sum(counts.values())\n\n    def to_dict(self) -> dict:\n        \"\"\"Returns the raw counts dictionary.\"\"\"\n        return self.counts\nclass FrequencyService:\n    \"\"\"Core business logic for computing frequency counts.\"\"\"\n    def __init__(self, repository=None):\n        self._repository = repository\n\n    def _validate_and_normalize(self, items: collections.abc.Iterable) -> list:\n        \"\"\"Validates input iterable and its elements for hashability.\"\"\"\n        if not is_iterable(items):\n            raise InvalidInputError(\"Input must be an iterable (e.g., list, tuple), not a string or bytes.\")\n\n        concrete_items = list(items) # Convert to a concrete list to ensure multiple passes are safe.\n        for item in concrete_items:\n            if not is_hashable(item):\n                raise InvalidInputError(f\"Unhashable item encountered: {item!r}. All items must be hashable.\")\n        return concrete_items\n\n    def count_frequencies(self, items: collections.abc.Iterable) -> FrequencyResult:\n        \"\"\"\n        Calculates the frequency of each item in the provided iterable.\n        Includes input validation and returns a FrequencyResult object.\n        \"\"\"\n        validated_items = self._validate_and_normalize(items)\n\n        counts = {}\n        for item in validated_items:\n            counts[item] = counts.get(item, 0) + 1\n\n        result = FrequencyResult(counts)\n        if self._repository:\n            # Placeholder for potential future persistence via a repository.\n            pass\n        return result\nclass FrequencyController:\n    \"\"\"API layer that orchestrates frequency counting using the FrequencyService.\"\"\"\n    def __init__(self, service: FrequencyService = None):\n        self._service = service if service is not None else FrequencyService()\n\n    def freq_count(self, items: collections.abc.Iterable) -> dict:\n        \"\"\"\n        Delegates to FrequencyService to count item frequencies and returns a plain dictionary.\n        Propagates InvalidInputError from the service layer.\n        \"\"\"\n        result = self._service.count_frequencies(items)\n        return result.to_dict()\n_default_controller = FrequencyController()\ndef freq_count(items: collections.abc.Iterable) -> dict:\n    \"\"\"\n    Counts the frequency of each element in a given list, returning the results as a dictionary.\n    This function acts as a convenience wrapper for the underlying frequency counting logic.\n    \"\"\"\n    return _default_controller.freq_count(items)"}
