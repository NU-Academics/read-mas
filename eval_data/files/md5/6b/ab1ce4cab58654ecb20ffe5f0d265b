{"task_id": "Mbpp/12", "solution": "def sort_matrix(matrix: list[list[float]]) -> list[list[float]]:\n    \"\"\"\n    Sorts a matrix (list of lists) by the ascending sum of its rows.\n    Rows with equal sums retain their original relative order.\n    \"\"\"\n    # Pair each row with its sum and original index to enable stable sorting.\n    # Each item in `indexed_rows` is a tuple: (row_sum, original_index, row_reference).\n    indexed_rows = []\n    for i, row in enumerate(matrix):\n        row_sum = sum(row)\n        indexed_rows.append((row_sum, i, row))\n\n    # Perform a stable sort based on the row sum (the first element of the tuple).\n    indexed_rows.sort(key=lambda item: item[0])\n\n    # Extract the rows in their sorted order, creating a new shallow copy for each row.\n    sorted_result = []\n    for _, _, row in indexed_rows:\n        sorted_result.append(list(row))\n\n    return sorted_result"}
{"task_id": "Mbpp/18", "solution": "def remove_dirty_chars(s, dirty):\n    \"\"\"\n    Removes characters from the first string that are present in the second string.\n    The order of the remaining characters in the first string is preserved.\n    \"\"\"\n    dirty_chars = set(dirty)\n    result_chars = []\n    for char_s in s:\n        if char_s not in dirty_chars:\n            result_chars.append(char_s)\n    return \"\".join(result_chars)"}
{"task_id": "Mbpp/19", "solution": "def test_duplicate(arr):\n    \"\"\"\n    Checks if the given array of integers contains any duplicate element.\n    Uses a set to efficiently track seen elements for O(n) time complexity.\n    \"\"\"\n    seen_elements = set()\n    for element in arr:\n        if element in seen_elements:\n            return True\n        seen_elements.add(element)\n    return False"}
{"task_id": "Mbpp/20", "solution": "def is_woodall(n: int) -> bool:\n    \"\"\"\n    Checks if a given number is a Woodall number.\n    A Woodall number is of the form k * 2^k - 1 for some integer k >= 1.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n    if n < 1:  # Woodall numbers are positive for k >= 1\n        return False\n\n    k = 1\n    while True:\n        candidate = k * (1 << k) - 1\n        if candidate == n:\n            return True\n        if candidate > n:\n            return False\n        k += 1"}
