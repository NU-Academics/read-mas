{"task_id": "Mbpp/463", "solution": "from typing import Sequence, Any\nclass InvalidInputError(Exception):\n    \"\"\"Custom exception for invalid input array.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\nclass MathUtils:\n    \"\"\"Provides utility methods for numeric checks and conversions.\"\"\"\n    def is_int_like(self, value: Any) -> bool:\n        \"\"\"Checks if a value can be safely converted to an integer.\"\"\"\n        return isinstance(value, int) or (\n            isinstance(value, float) and value.is_integer() and\n            not float('inf') == abs(value) and not float('nan') == value\n        )\n\n    def to_int(self, value: Any) -> int:\n        \"\"\"Converts a value to an integer if it's int-like.\"\"\"\n        if isinstance(value, float):\n            return int(value)\n        return value\nclass InputArrayDTO:\n    \"\"\"Data Transfer Object for validated input array values.\"\"\"\n    def __init__(self, values: Sequence[int]) -> None:\n        self.values = list(values)\nclass ResultDTO:\n    \"\"\"Data Transfer Object for the maximum product subarray result.\"\"\"\n    def __init__(self, max_product: int, start_index: int, end_index: int) -> None:\n        self.max_product = max_product\n        self.start_index = start_index\n        self.end_index = end_index\nclass ArrayValidator:\n    \"\"\"Validates raw input array and converts it to InputArrayDTO.\"\"\"\n    def __init__(self, math_utils: MathUtils) -> None:\n        self._math_utils = math_utils\n\n    def validate(self, raw: Sequence[Any]) -> InputArrayDTO:\n        \"\"\"Validates the raw input sequence and returns an InputArrayDTO.\"\"\"\n        if not isinstance(raw, (list, tuple)):\n            raise InvalidInputError(\"Input must be an iterable (list or tuple).\")\n        if not raw:\n            raise InvalidInputError(\"Input array cannot be empty.\")\n\n        processed_values: list[int] = []\n        for i, item in enumerate(raw):\n            if not self._math_utils.is_int_like(item):\n                raise InvalidInputError(f\"Element at index {i} is not an integer or int-like float: {item}\")\n            processed_values.append(self._math_utils.to_int(item))\n\n        return InputArrayDTO(processed_values)\nclass MaxProductService:\n    \"\"\"Service containing the core algorithm for maximum product subarray.\"\"\"\n    def compute(self, input_dto: InputArrayDTO) -> ResultDTO:\n        \"\"\"Computes the maximum product subarray from a validated input DTO.\"\"\"\n        return self._compute_core(input_dto.values)\n\n    def _compute_core(self, values: list[int]) -> ResultDTO:\n        \"\"\"Internal method to compute max product subarray using Kadane's-like algorithm.\"\"\"\n        # Precondition: 'values' is guaranteed to be a non-empty list of integers by ArrayValidator.\n\n        max_so_far = values[0]\n        min_so_far = values[0]\n        overall_max = values[0]\n\n        for i in range(1, len(values)):\n            curr = values[i]\n\n            # If current number is negative, swap max_so_far and min_so_far\n            # because multiplying by a negative number reverses the order of max/min.\n            if curr < 0:\n                max_so_far, min_so_far = min_so_far, max_so_far\n\n            # Current number can be a new start for either max or min product,\n            # or extend the previous max/min product subarray.\n            max_so_far = max(curr, max_so_far * curr)\n            min_so_far = min(curr, min_so_far * curr)\n\n            # Update overall maximum product found so far.\n            overall_max = max(overall_max, max_so_far)\n\n        # The problem statement only requires the product, not actual indices.\n        # Dummy indices (0, 0) are used as the ResultDTO structure requires them.\n        return ResultDTO(overall_max, 0, 0)\nclass MaxProductAPI:\n    \"\"\"API adapter for the maximum product subarray computation.\"\"\"\n    def __init__(self, validator: ArrayValidator, service: MaxProductService) -> None:\n        self._validator = validator\n        self._service = service\n\n    def max_subarray_product(self, array: Sequence[Any]) -> int:\n        \"\"\"\n        Finds the maximum product of any contiguous subarray in the given array.\n        The input array can contain integers or int-like floats.\n        \"\"\"\n        input_dto = self._validator.validate(array)\n        result_dto = self._service.compute(input_dto)\n        return result_dto.max_product\ndef max_subarray_product(array: Sequence[Any]) -> int:\n    \"\"\"\n    Finds the maximum product of any contiguous subarray in the given array.\n    This function acts as the public entry point, orchestrating validation and computation.\n    \"\"\"\n    # Instantiate dependencies as per the layered architecture defined in the design context.\n    math_utils = MathUtils()\n    array_validator = ArrayValidator(math_utils)\n    max_product_service = MaxProductService()\n\n    # Instantiate the API adapter and call its method to perform the operation.\n    api = MaxProductAPI(array_validator, max_product_service)\n    return api.max_subarray_product(array)"}
{"task_id": "Mbpp/465", "solution": "from typing import Dict, Any\ndef drop_empty(data: Dict[str, Any]) -> Dict[str, Any]:\n    \"\"\"\n    Removes items from the dictionary where the value is considered empty.\n    Empty values include None, empty strings, whitespace-only strings, and empty collections.\n    \"\"\"\n    cleaned_data = {}\n    for key, value in data.items():\n        is_empty_value = False\n        if value is None:\n            is_empty_value = True\n        elif isinstance(value, str):\n            if value == \"\" or value.strip() == \"\":\n                is_empty_value = True\n        elif isinstance(value, (list, tuple, set, dict)):\n            if len(value) == 0:\n                is_empty_value = True\n\n        if not is_empty_value:\n            cleaned_data[key] = value\n    return cleaned_data"}
{"task_id": "Mbpp/462", "solution": "def combinations_list(elements):\n    \"\"\"\n    Finds all possible combinations (subsets) of the elements of a given list.\n    The combinations are generated by iterating through bitmasks and constructing\n    subsets with elements ordered by descending original index.\n    \"\"\"\n    elements_list = list(elements)  # Ensure input is a list for consistent indexing.\n    n = len(elements_list)\n    all_combinations = []\n\n    # Iterate through all possible bitmasks from 0 to 2^n - 1\n    for mask in range(1 << n):\n        current_combination = []\n        # For each mask, build the subset by checking bits from n-1 down to 0\n        for j in range(n - 1, -1, -1):\n            if (mask >> j) & 1:  # Check if the j-th bit is set\n                current_combination.append(elements_list[j])\n        all_combinations.append(current_combination)\n\n    return all_combinations"}
{"task_id": "Mbpp/471", "solution": "def find_remainder(arr, n):\n    \"\"\"\n    Computes the product of all elements in the array modulo n.\n\n    Args:\n        arr: iterable of integers\n        n: modulus (int > 0)\n\n    Returns:\n        int: (product of arr) % n\n    \"\"\"\n    if not isinstance(n, int) or n <= 0:\n        raise ValueError(\"modulus n must be a positive integer\")\n    product = 1 % n\n    for x in arr:\n        if not isinstance(x, int):\n            raise TypeError(\"array elements must be integers\")\n        product = (product * (x % n)) % n\n        if product == 0:\n            return 0\n    return product"}
{"task_id": "Mbpp/470", "solution": "def add_pairwise(t):\n    \"\"\"\n    Return a tuple of pairwise sums of neighboring elements from the given tuple/list.\n\n    Example:\n        add_pairwise((1, 5, 7, 8, 10)) -> (6, 12, 15, 18)\n    \"\"\"\n    if not isinstance(t, (tuple, list)):\n        raise TypeError(\"Input must be a tuple or list of numbers\")\n    if len(t) < 2:\n        return ()\n    result = []\n    for i in range(len(t) - 1):\n        a, b = t[i], t[i + 1]\n        if not isinstance(a, (int, float)) or not isinstance(b, (int, float)):\n            raise TypeError(\"All elements must be int or float\")\n        result.append(a + b)\n    return tuple(result)"}
{"task_id": "Mbpp/468", "solution": "def max_product(sequence: list) -> float:\n    \"\"\"\n    Finds the maximum product formed by multiplying numbers of a strictly\n    increasing contiguous subsequence (i.e., contiguous subarray where each\n    next element is greater than the previous).\n    Returns 0.0 for an empty sequence.\n    \"\"\"\n    import math\n\n    if not sequence:\n        return 0.0\n\n    # Work with floats for consistent behavior\n    arr = [float(x) for x in sequence]\n    n = len(arr)\n    overall_max = -math.inf\n\n    start = 0\n    # Iterate through array and split into maximal strictly increasing contiguous runs\n    for i in range(1, n + 1):\n        if i < n and arr[i] > arr[i - 1]:\n            continue\n        # process run arr[start:i] (end exclusive)\n        run_start, run_end = start, i\n        if run_start < run_end:\n            # Compute maximum product subarray within this run using the standard\n            # max-product-subarray DP (tracks max and min ending here).\n            max_ending = arr[run_start]\n            min_ending = arr[run_start]\n            max_run = arr[run_start]\n            for x in arr[run_start + 1 : run_end]:\n                if x < 0:\n                    max_ending, min_ending = min_ending, max_ending\n                max_ending = max(x, max_ending * x)\n                min_ending = min(x, min_ending * x)\n                if max_ending > max_run:\n                    max_run = max_ending\n            if max_run > overall_max:\n                overall_max = max_run\n        start = i\n\n    # If for some reason overall_max stayed -inf (shouldn't for non-empty list), return 0.0\n    if overall_max == -math.inf:\n        return 0.0\n    return float(overall_max)"}
{"task_id": "Mbpp/473", "solution": "from typing import Iterable, Set, Tuple, Any\nclass InvalidTupleError(ValueError):\n    \"\"\"Exception raised for invalid tuple inputs or elements.\"\"\"\n    pass\nclass TupleNormalizer:\n    \"\"\"Normalizes tuples to a canonical form by sorting elements.\"\"\"\n    def normalize(self, t: Tuple[Any, ...]) -> Tuple[Any, ...]:\n        if not isinstance(t, tuple):\n            raise InvalidTupleError(\"Item is not a tuple\")\n        for el in t:\n            try:\n                hash(el)\n            except TypeError as exc:\n                raise InvalidTupleError(f\"Unhashable element: {el!r}\") from exc\n        if len(t) <= 1:\n            return t\n        try:\n            sorted_elems = tuple(sorted(t))\n        except TypeError as exc:\n            raise InvalidTupleError(\"Tuple elements are not comparable for sorting\") from exc\n        return sorted_elems\nclass TupleRepository:\n    \"\"\"Converts an iterable of tuples into a set of normalized tuples.\"\"\"\n    def __init__(self, normalizer: TupleNormalizer):\n        self._normalizer = normalizer\n\n    def to_normalized_set(self, iterable: Iterable[Tuple[Any, ...]]) -> Set[Tuple[Any, ...]]:\n        result = set()\n        if iterable is None:\n            return result\n        for item in iterable:\n            norm = self._normalizer.normalize(item)\n            result.add(norm)\n        return result\nclass TupleService:\n    \"\"\"Orchestrates tuple normalization and set operations for intersection.\"\"\"\n    def __init__(self, repository: TupleRepository, normalizer: TupleNormalizer):\n        self._repo = repository\n        self._normalizer = normalizer\n\n    def intersection(self, iter_a: Iterable[Tuple[Any, ...]], iter_b: Iterable[Tuple[Any, ...]]) -> Set[Tuple[Any, ...]]:\n        set_a = self._repo.to_normalized_set(iter_a)\n        set_b = self._repo.to_normalized_set(iter_b)\n        return set_a & set_b\nclass TupleController:\n    \"\"\"Exposes the public API for tuple intersection.\"\"\"\n    def __init__(self, service: TupleService):\n        self._service = service\n\n    def tuple_intersection(self, iter_a: Iterable[Tuple[Any, ...]], iter_b: Iterable[Tuple[Any, ...]]) -> Set[Tuple[Any, ...]]:\n        # Per explicit prompt instruction: \"DO NOT add isinstance() checks or raise exceptions for edge cases\"\n        # The design's recommendation for Iterable validation is skipped here.\n        return self._service.intersection(iter_a, iter_b)\ndef tuple_intersection(iter_a: Iterable[Tuple[Any, ...]], iter_b: Iterable[Tuple[Any, ...]]) -> Set[Tuple[Any, ...]]:\n    \"\"\"\n    Finds the intersection of elements in two tuple lists, ignoring element order within tuples.\n    \"\"\"\n    normalizer = TupleNormalizer()\n    repo = TupleRepository(normalizer)\n    service = TupleService(repo, normalizer)\n    controller = TupleController(service)\n    return controller.tuple_intersection(iter_a, iter_b)"}
{"task_id": "Mbpp/472", "solution": "from typing import List\ndef check_Consecutive(numbers: List[int]) -> bool:\n    \"\"\"\n    Checks if the given list contains consecutive numbers, ignoring order.\n    Duplicates are not allowed for a sequence to be considered consecutive.\n    \"\"\"\n    if not numbers:\n        return False\n    if len(numbers) == 1:\n        return True\n\n    nums_set = set(numbers)\n\n    # If the set's size differs from the original list's size, duplicates were present,\n    # which are not allowed for a consecutive sequence by default.\n    if len(nums_set) != len(numbers):\n        return False\n\n    min_val = min(nums_set)\n    max_val = max(nums_set)\n\n    # For a sequence of N unique consecutive integers, max_val - min_val + 1 must equal N.\n    return (max_val - min_val + 1) == len(nums_set)"}
