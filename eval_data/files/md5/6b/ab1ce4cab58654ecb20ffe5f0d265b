{"task_id": "Mbpp/566", "solution": "def sum_digits(n: int) -> int:\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n    if n < 0:\n        raise ValueError(\"n must be non-negative\")\n    total = 0\n    while n:\n        total += n % 10\n        n //= 10\n    return total"}
{"task_id": "Mbpp/563", "solution": "import re\nfrom typing import List\ndef extract_values(text: str, strategy: str = 'regex', persist: bool = False) -> List[str]:\n    \"\"\"\n    Extracts values enclosed in quotation marks from a string using a specified strategy.\n    Supports 'regex' and 'split' strategies for parsing quoted tokens.\n    \"\"\"\n\n    def _strip_surrounding_quotes(token: str) -> str:\n        \"\"\"Removes matching surrounding single or double quotes from a string.\"\"\"\n        if len(token) >= 2 and (\n            (token.startswith('\"') and token.endswith('\"')) or\n            (token.startswith(\"'\") and token.endswith(\"'\"))\n        ):\n            return token[1:-1]\n        return token\n\n    def _unescape_quotes(token: str) -> str:\n        \"\"\"Unescapes common escaped characters within a string, like \\\" and \\' and \\\\.\"\"\"\n        token = token.replace('\\\\\\\\', '\\\\')  # Unescape literal backslashes first\n        token = token.replace('\\\\\"', '\"')\n        token = token.replace(\"\\\\'\", \"'\")\n        return token\n\n    results: List[str] = []\n\n    if strategy == 'regex':\n        # This regex matches content inside single or double quotes,\n        # accounting for escaped quotes within the string itself.\n        DEFAULT_REGEX_PATTERN = r'([\\\"\\\\\\'])(?:(?=(\\\\\\\\?))\\\\2.)*?\\\\1'\n        pattern = re.compile(DEFAULT_REGEX_PATTERN)\n\n        matches = [m.group(0) for m in pattern.finditer(text)]\n        results = [_unescape_quotes(_strip_surrounding_quotes(m)) for m in matches]\n\n    elif strategy == 'split':\n        # A simpler strategy that splits by commas and then cleans individual segments.\n        segments = text.split(',')\n        for segment in segments:\n            trimmed_segment = segment.strip()\n            # Only consider segments that are clearly quoted values after trimming\n            if (trimmed_segment.startswith('\"') and trimmed_segment.endswith('\"')) or \\\n               (trimmed_segment.startswith(\"'\") and trimmed_segment.endswith(\"'\")):\n                cleaned_value = _unescape_quotes(_strip_surrounding_quotes(trimmed_segment))\n                results.append(cleaned_value)\n\n    # The 'persist' parameter is ignored here (no side-effects in this helper function).\n\n    return results"}
