{"task_id": "Mbpp/74", "solution": "def is_samepatterns(values, pattern):\n    \"\"\"\n    Return True if `values` follows the same pattern as `pattern`.\n    Example:\n        is_samepatterns([\"red\", \"green\", \"green\"], [\"a\", \"b\", \"b\"]) -> True\n    Behavior:\n    - Both arguments should be non-string iterables (lists/tuples/etc.).\n    - A bijective (one-to-one) mapping must exist between elements of `values`\n      and elements of `pattern`.\n    \"\"\"\n    # Basic validation\n    if isinstance(values, str) or isinstance(pattern, str):\n        raise TypeError(\"String inputs are not accepted; provide list/tuple-like sequences.\")\n    try:\n        vals = list(values)\n        pats = list(pattern)\n    except TypeError:\n        raise TypeError(\"Both values and pattern must be iterable (e.g., list or tuple).\")\n\n    if len(vals) != len(pats):\n        return False\n    if len(vals) == 0:\n        return True\n\n    def _key(x):\n        # Return a hashable representation for x:\n        # - If x is hashable, use it directly (wrapped to avoid accidental collisions\n        #   with stringified forms).\n        # - Otherwise fall back to repr(x).\n        try:\n            hash(x)\n            return (\"__H__\", x)\n        except TypeError:\n            return (\"__S__\", repr(x))\n\n    v2t = {}\n    t2v = {}\n    for v, t in zip(vals, pats):\n        kv = _key(v)\n        kt = _key(t)\n        if kv in v2t:\n            if v2t[kv] != kt:\n                return False\n        else:\n            v2t[kv] = kt\n        if kt in t2v:\n            if t2v[kt] != kv:\n                return False\n        else:\n            t2v[kt] = kv\n    return True"}
{"task_id": "Mbpp/77", "solution": "def is_Diff(n):\n    \"\"\"\n    Checks if a number is divisible by 11 using the alternating sum of digits rule.\n    \"\"\"\n    # Accept ints and strings that represent integers\n    if isinstance(n, str):\n        s = n.strip()\n        if s.startswith(('+', '-')):\n            s = s[1:]\n        # Remove commas if present\n        s = s.replace(',', '')\n        if not s.isdigit():\n            raise ValueError(\"Input string must represent an integer\")\n        s = str(int(s))  # normalize (removes leading zeros)\n    elif isinstance(n, int):\n        s = str(abs(n))\n    else:\n        raise TypeError(\"Input must be int or str representing an integer\")\n\n    # Work with absolute value digits\n    if s == '':\n        raise ValueError(\"Invalid input\")\n\n    total = 0\n    sign = 1  # start with + for leftmost digit\n    for ch in s:\n        total += sign * (ord(ch) - ord('0'))\n        sign *= -1\n\n    return total % 11 == 0"}
