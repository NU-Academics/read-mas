{"task_id": "Mbpp/126", "solution": "def sum(a, b):\n    \"\"\"\n    Calculates the sum of common divisors of two given numbers.\n    The function handles negative inputs by using their absolute values\n    and returns 0 if the greatest common divisor is 0.\n    \"\"\"\n    import math\n    import builtins  # To explicitly call the built-in sum function\n\n    # Helper function to validate and normalize inputs to absolute integers.\n    def _validate_and_normalize(val_a, val_b):\n        # Converts inputs to integers and returns their absolute values.\n        # Assumes inputs are convertible to integers as per design context.\n        return abs(int(val_a)), abs(int(val_b))\n\n    # Helper function to compute the greatest common divisor (GCD).\n    def _gcd(val_a, val_b):\n        # Uses the math.gcd function and returns the absolute GCD.\n        return abs(math.gcd(val_a, val_b))\n\n    # Helper function to efficiently enumerate all positive divisors of a number.\n    def _enumerate_divisors(n: int) -> list[int]:\n        \"\"\"\n        Enumerates all positive divisors of n efficiently up to sqrt(n).\n        Returns a sorted list of divisors. If n <= 0, returns an empty list.\n        \"\"\"\n        if n <= 0:\n            return []\n        small_divisors = []\n        large_divisors = []\n        # Iterate from 1 up to the square root of n\n        root = int(math.isqrt(n))\n        for i in range(1, root + 1):\n            if n % i == 0:\n                small_divisors.append(i)\n                j = n // i\n                if j != i:  # Avoid adding the same divisor twice for perfect squares\n                    large_divisors.append(j)\n        # Combine and sort the divisors\n        return small_divisors + large_divisors[::-1]\n\n    # --- Main logic of the sum function ---\n\n    # 1. Validate and normalize the inputs to their absolute integer values.\n    a_norm, b_norm = _validate_and_normalize(a, b)\n\n    # 2. Compute the Greatest Common Divisor (GCD) of the normalized numbers.\n    common_divisor_gcd = _gcd(a_norm, b_norm)\n\n    # 3. Handle the special case where GCD is 0.\n    # As per business rules, the sum of common divisors for gcd(0,0) is 0.\n    if common_divisor_gcd == 0:\n        return 0\n\n    # 4. Enumerate all positive divisors of the GCD. These are the common divisors.\n    divisors_of_gcd = _enumerate_divisors(common_divisor_gcd)\n\n    # 5. Calculate the sum of these common divisors using the built-in sum function.\n    return builtins.sum(divisors_of_gcd)"}
{"task_id": "Mbpp/128", "solution": "def long_words(n, text):\n    \"\"\"\n    Finds words from a text that are longer than n characters.\n    The function splits the text by spaces and filters words based on length.\n    \"\"\"\n    words = text.split()\n    return [word for word in words if len(word) > n]"}
{"task_id": "Mbpp/123", "solution": "def amicable_numbers_sum(n: int) -> int:\n    \"\"\"\n    Sums all amicable numbers up to a specified number n.\n    An amicable pair (a, b) consists of two distinct positive integers where the sum of the proper divisors of a is b\n    and the sum of the proper divisors of b is a.\n    \"\"\"\n    from typing import Dict, List, Optional, Tuple, Set\n\n    class AmicablePair:\n        \"\"\"Represents an amicable pair of numbers.\"\"\"\n        def __init__(self, a: int, b: int):\n            self.a = a\n            self.b = b\n\n        def to_tuple(self) -> Tuple[int, int]:\n            \"\"\"Returns a sorted tuple representation of the pair for uniqueness checks.\"\"\"\n            return (min(self.a, self.b), max(self.a, self.b))\n\n    class CacheRepository:\n        \"\"\"Stores and retrieves sums of proper divisors in-memory.\"\"\"\n        def __init__(self, file_path: Optional[str] = None) -> None:\n            self._store: Dict[int, int] = {}\n            self._file_path = file_path\n\n        def get(self, n: int) -> Optional[int]:\n            \"\"\"Retrieves the sum of proper divisors for n from the cache.\"\"\"\n            return self._store.get(n)\n\n        def set(self, n: int, sumdiv: int) -> None:\n            \"\"\"Stores the sum of proper divisors for n in the cache.\"\"\"\n            self._store[n] = sumdiv\n\n        def bulk_get(self, range_end: int) -> Dict[int, int]:\n            \"\"\"Returns a dictionary of cached sums for numbers up to range_end.\"\"\"\n            return {k: v for k, v in self._store.items() if k <= range_end}\n\n        def save_to_file(self) -> None:\n            \"\"\"Saves the cache to a file; not utilized in this specific problem context.\"\"\"\n            pass\n\n        def load_from_file(self) -> None:\n            \"\"\"Loads cache from a file; not utilized in this specific problem context.\"\"\"\n            pass\n\n    class DivisorService:\n        \"\"\"Computes and caches sums of proper divisors.\"\"\"\n        def __init__(self, cache: CacheRepository) -> None:\n            self._cache = cache\n\n        def sum_proper_divisors(self, n: int) -> int:\n            \"\"\"Computes the sum of proper divisors for n, using cache if available.\"\"\"\n            cached = self._cache.get(n)\n            if cached is not None:\n                return cached\n\n            if n <= 1:\n                self._cache.set(n, 0)\n                return 0\n\n            total = 1\n            i = 2\n            while i * i <= n:\n                if n % i == 0:\n                    total += i\n                    j = n // i\n                    if j != i:\n                        total += j\n                i += 1\n\n            self._cache.set(n, total)\n            return total\n\n        def precompute_up_to(self, limit: int) -> None:\n            \"\"\"Precomputes sums of proper divisors for all numbers up to limit using a sieve-like method.\"\"\"\n            sums: List[int] = [0] * (limit + 1)\n\n            for i in range(1, limit // 2 + 1):\n                for j in range(2 * i, limit + 1, i):\n                    sums[j] += i\n\n            for k in range(2, limit + 1):\n                self._cache.set(k, sums[k])\n\n    class AmicableService:\n        \"\"\"Detects amicable pairs and calculates their sum.\"\"\"\n        def __init__(self, divisor_service: DivisorService) -> None:\n            self._divisor_service = divisor_service\n\n        def find_amicable_pairs_up_to(self, n: int) -> List[AmicablePair]:\n            \"\"\"Finds all amicable pairs (a, b) where a and b are both <= n.\"\"\"\n            self._divisor_service.precompute_up_to(n)\n\n            seen_pairs: Set[Tuple[int, int]] = set()\n            amicable_pairs: List[AmicablePair] = []\n\n            for a in range(2, n + 1):\n                b = self._divisor_service.sum_proper_divisors(a)\n\n                if b != a and 1 < b <= n:\n                    sum_div_b = self._divisor_service.sum_proper_divisors(b)\n\n                    if sum_div_b == a:\n                        pair = AmicablePair(a, b)\n                        sorted_pair_tuple = pair.to_tuple()\n                        if sorted_pair_tuple not in seen_pairs:\n                            seen_pairs.add(sorted_pair_tuple)\n                            amicable_pairs.append(pair)\n            return amicable_pairs\n\n        def amicable_numbers_sum(self, n: int) -> int:\n            \"\"\"Calculates the sum of all unique amicable numbers found up to n.\"\"\"\n            # Assumes n is an integer >= 2 as per problem context.\n            pairs = self.find_amicable_pairs_up_to(n)\n\n            unique_amicable_numbers: Set[int] = set()\n            for pair in pairs:\n                unique_amicable_numbers.add(pair.a)\n                unique_amicable_numbers.add(pair.b)\n\n            return sum(unique_amicable_numbers)\n\n    # Instantiate the services and execute the main logic\n    cache = CacheRepository()\n    divisor_service = DivisorService(cache)\n    amicable_service = AmicableService(divisor_service)\n\n    return amicable_service.amicable_numbers_sum(n)"}
