{"task_id": "Mbpp/227", "solution": "class InvalidInputError(ValueError):\n    \"\"\"Custom exception for invalid input values.\"\"\"\n    pass\nclass MinCalculator:\n    \"\"\"Calculates the minimum of three float numbers.\"\"\"\n    def compute(self, a: float, b: float, c: float) -> float:\n        return min(a, b, c)\nclass InputValidator:\n    \"\"\"Validates and converts inputs to numeric floats.\"\"\"\n    def validate_and_convert(self, value: object) -> float:\n        try:\n            if isinstance(value, (int, float)):\n                return float(value)\n            return float(str(value))\n        except (ValueError, TypeError):\n            raise InvalidInputError(f\"Cannot convert {value!r} to a number\")\n\n    def validate_three(self, a: object, b: object, c: object) -> tuple[float, float, float]:\n        \"\"\"Validates and converts three inputs to floats.\"\"\"\n        val_a = self.validate_and_convert(a)\n        val_b = self.validate_and_convert(b)\n        val_c = self.validate_and_convert(c)\n        return val_a, val_b, val_c\nclass MinService:\n    \"\"\"Orchestrates input validation and minimum calculation using components.\"\"\"\n    def __init__(self, validator: 'InputValidator' = None, calculator: 'MinCalculator' = None) -> None:\n        self.validator = validator or InputValidator()\n        self.calculator = calculator or MinCalculator()\n\n    def min_of_three(self, a: object, b: object, c: object) -> float:\n        \"\"\"Validates and computes the minimum of three numbers.\"\"\"\n        a_f, b_f, c_f = self.validator.validate_three(a, b, c)\n        return self.calculator.compute(a_f, b_f, c_f)\ndef min_of_three(a: object, b: object, c: object) -> float:\n    \"\"\"Finds the minimum of three numbers, validating inputs.\"\"\"\n    svc = MinService()\n    return svc.min_of_three(a, b, c)"}
