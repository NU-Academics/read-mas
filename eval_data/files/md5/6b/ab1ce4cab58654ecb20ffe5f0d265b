{"task_id": "Mbpp/603", "solution": "def get_ludic(n: int) -> list[int]:\n    \"\"\"\n    Computes all ludic numbers less than or equal to a given integer n using a sieve-like algorithm.\n    \"\"\"\n    if n < 1:\n        return []\n\n    ludic_numbers = [1]\n    if n == 1:\n        return ludic_numbers\n\n    # Initialize a list of candidate numbers starting from 2 up to n.\n    candidates = list(range(2, n + 1))\n\n    # The sieve process continues as long as there are numbers in the candidates list.\n    while candidates:\n        # The first number in the current candidates list is the next ludic number.\n        p = candidates.pop(0)\n        ludic_numbers.append(p)\n\n        # Now, remove every p-th element from the *remaining* candidates list.\n        # We build a new list of candidates to avoid expensive shifting operations\n        # from in-place deletion in the middle of a list.\n        next_candidates = []\n        count = 0\n        for x in candidates:\n            count += 1\n            if count % p != 0:\n                next_candidates.append(x)\n        candidates = next_candidates\n\n    return ludic_numbers"}
{"task_id": "Mbpp/605", "solution": "def prime_num(n: int) -> bool:\n    \"\"\"\n    Checks if the given integer is a prime number using an optimized algorithm.\n    \"\"\"\n    # Validate type and reject booleans which are subclasses of int\n    if not isinstance(n, int) or isinstance(n, bool):\n        raise TypeError(\"Input must be an integer (bool not allowed).\")\n\n    if n < 2:\n        return False\n    if n in (2, 3):\n        return True\n    if n % 2 == 0 or n % 3 == 0:\n        return False\n\n    i = 5\n    while i * i <= n:\n        if n % i == 0 or n % (i + 2) == 0:\n            return False\n        i += 6\n    return True"}
{"task_id": "Mbpp/607", "solution": "import re\nfrom typing import Tuple\nfrom dataclasses import dataclass\nclass TextSearchError(Exception):\n    \"\"\"Base exception for text search operations.\"\"\"\n    pass\nclass InvalidPatternError(TextSearchError):\n    \"\"\"Raised when a regex pattern is invalid.\"\"\"\n    pass\nclass NoMatchFoundError(TextSearchError):\n    \"\"\"Raised when no match is found for the given pattern.\"\"\"\n    pass\nclass RegexAdapter:\n    \"\"\"Encapsulates regex compilation and searching using the 're' module.\"\"\"\n    DEFAULT_FLAGS: int = 0\n\n    def compile(self, pattern: str) -> re.Pattern[str]:\n        \"\"\"Compiles a regex pattern, raising InvalidPatternError on failure.\"\"\"\n        try:\n            return re.compile(pattern, self.DEFAULT_FLAGS)\n        except re.error as e:\n            raise InvalidPatternError(f\"Invalid regex pattern: {e}\") from e\n\n    def search(self, compiled_pattern: re.Pattern[str], text: str) -> MatchResult | None:\n        \"\"\"Searches text for a compiled pattern, returning MatchResult or None.\"\"\"\n        m = compiled_pattern.search(text)\n        if not m:\n            return None\n        return MatchResult(match=m.group(0), start=m.start(), end=m.end())\n\n    def compile_and_search(self, text: str, pattern: str) -> MatchResult:\n        \"\"\"Compiles a pattern and searches text, raising NoMatchFoundError if no match.\"\"\"\n        cp = self.compile(pattern)\n        result = self.search(cp, text)\n        if result is None:\n            raise NoMatchFoundError(f\"No match for pattern: {pattern}\")\n        return result\nclass SearchService:\n    \"\"\"Provides the core business logic for searching text with regex patterns.\"\"\"\n    def __init__(self, adapter: RegexAdapter | None = None) -> None:\n        \"\"\"Initializes the service with a RegexAdapter.\"\"\"\n        self.adapter = adapter or RegexAdapter()\n\n    def find_literals(self, text: str, pattern: str) -> MatchResult:\n        \"\"\"Finds the first literal match in text for a pattern.\"\"\"\n        # Input validation (e.g., utils.validate_text) is omitted as per instructions.\n        return self.adapter.compile_and_search(text, pattern)\n_service = SearchService(adapter=RegexAdapter())\ndef find_literals(text, pattern):\n    \"\"\"\n    Searches a string for a regex pattern and returns the matching substring,\n    its start index, and its end index.\n    \"\"\"\n    result = _service.find_literals(text, pattern)\n    return result.to_tuple()"}
{"task_id": "Mbpp/608", "solution": "def bell_Number(n: int) -> int:\n    \"\"\"\n    Calculates the nth Bell number using the Bell triangle algorithm.\n    The Bell number B(n) represents the number of partitions of a set with n elements.\n    \"\"\"\n    if n == 0:\n        return 1\n\n    # Initialize the Bell triangle with the first row, which contains B(0,0) = 1.\n    # 'triangle' will store the values of the previous row in the Bell triangle.\n    triangle = [1]\n\n    # Iterate from i = 1 up to n to compute each subsequent row of the Bell triangle.\n    # Each 'i' corresponds to the index of the Bell number B(i) whose values are being generated.\n    for i in range(1, n + 1):\n        # The first element of the new row (B(i,0)) is equal to the last element\n        # of the previous row (B(i-1, i-1)).\n        new_row = [triangle[-1]]\n\n        # Compute the remaining elements of the new row using the recurrence relation:\n        # B(i,j) = B(i, j-1) + B(i-1, j-1).\n        # In this context, new_row[-1] is B(i, j-1), and triangle[j-1] is B(i-1, j-1).\n        for j in range(1, i + 1):\n            new_row.append(new_row[-1] + triangle[j - 1])\n\n        # Update 'triangle' to be the newly computed row, which becomes the previous row\n        # for the next iteration.\n        triangle = new_row\n\n    # The nth Bell number B(n) is the first element of the last computed row (triangle[0]).\n    return triangle[0]"}
{"task_id": "Mbpp/610", "solution": "def remove_kth_element(lst, k):\n    \"\"\"\n    Returns a new list with the k'th element removed (1-based index).\n    The original list is not modified.\n    \"\"\"\n    # Convert 1-based index k to 0-based index\n    idx = k - 1\n    # Create a new list by concatenating slices before and after the removed element\n    return lst[:idx] + lst[idx + 1:]"}
{"task_id": "Mbpp/612", "solution": "def merge(items: list) -> list:\n    \"\"\"\n    Separates a list of 2-element sublists into two lists:\n    one for the first elements and one for the second.\n    \"\"\"\n    firsts = []\n    seconds = []\n    for sublist in items:\n        firsts.append(sublist[0])\n        seconds.append(sublist[1])\n    return [firsts, seconds]"}
{"task_id": "Mbpp/611", "solution": "def max_of_nth(matrix, n):\n    \"\"\"\n    Returns the maximum value found in the n'th column of a matrix.\n    \"\"\"\n    matrix_iterator = iter(matrix)\n\n    # Initialize current_max from the first row; StopIteration if matrix is empty.\n    first_row = next(matrix_iterator)\n    current_max = first_row[n]  # IndexError if n out of bounds for the first row.\n\n    # Iterate remaining rows and update current_max.\n    for row in matrix_iterator:\n        candidate = row[n]  # IndexError if n out of bounds for this row.\n        if candidate > current_max:  # TypeError if values are incomparable.\n            current_max = candidate\n\n    return current_max"}
{"task_id": "Mbpp/614", "solution": "def cummulative_sum(tuple_list):\n    \"\"\"Calculates the cumulative sum of all numbers in a list of tuples.\n    It iterates through the nested structure and sums numeric values.\"\"\"\n    return sum(item for sublist in tuple_list for item in sublist)"}
{"task_id": "Mbpp/615", "solution": "def average_tuple(rows: tuple[tuple[int | float, ...], ...]) -> list[float]:\n    \"\"\"Calculates the column-wise average of numeric values in a tuple of tuples.\"\"\"\n    num_rows = len(rows)\n    if num_rows == 0:\n        return []\n    num_cols = len(rows[0])\n\n    column_sums = [0.0] * num_cols\n\n    for row_tuple in rows:\n        for i, value in enumerate(row_tuple):\n            column_sums[i] += float(value)\n\n    averages = [s / num_rows for s in column_sums]\n\n    return averages"}
{"task_id": "Mbpp/618", "solution": "def div_list(a, b):\n    \"\"\"\n    Divides two lists element-wise, returning a list of floats.\n    Assumes lists are of equal length and contain numeric values.\n    \"\"\"\n    results = []\n    for x, y in zip(a, b):\n        results.append(float(x) / float(y))\n    return results"}
{"task_id": "Mbpp/616", "solution": "from typing import Tuple\ndef tuple_modulo(a: Tuple[int, ...], b: Tuple[int, ...]) -> Tuple[int, ...]:\n    \"\"\"\n    Performs element-wise modulo operation between two tuples of integers.\n    Assumes inputs are valid: tuples of equal length containing only integers, with no zero divisors.\n    \"\"\"\n    return tuple(x % y for x, y in zip(a, b))"}
{"task_id": "Mbpp/619", "solution": "def move_num(s: str) -> str:\n    \"\"\"\n    Moves all numeric characters to the end of the given string, preserving relative order.\n    \"\"\"\n    non_digits = []\n    digits = []\n    for char in s:\n        if '0' <= char <= '9':\n            digits.append(char)\n        else:\n            non_digits.append(char)\n    return \"\".join(non_digits) + \"\".join(digits)"}
{"task_id": "Mbpp/620", "solution": "def largest_subset(nums):\n    \"\"\"\n    Return the size of the largest subset of nums such that for every pair (a, b)\n    in the subset either a % b == 0 or b % a == 0.\n    \"\"\"\n    if not isinstance(nums, list):\n        raise TypeError(\"nums must be a list of integers\")\n    if not nums:\n        return 0\n    for x in nums:\n        if not isinstance(x, int):\n            raise TypeError(\"all elements of nums must be integers\")\n\n    nums_sorted = sorted(nums)\n    n = len(nums_sorted)\n    dp = [1] * n  # dp[i] = length of largest divisible subset ending at i\n    best = 1\n\n    for i in range(n):\n        ai = nums_sorted[i]\n        for j in range(i):\n            bj = nums_sorted[j]\n            # handle division by zero: consider divisible only when both are zero\n            if bj == 0:\n                divisible = (ai == 0)\n            else:\n                divisible = (ai % bj == 0)\n            if divisible and dp[j] + 1 > dp[i]:\n                dp[i] = dp[j] + 1\n        if dp[i] > best:\n            best = dp[i]\n\n    return best"}
{"task_id": "Mbpp/622", "solution": "def get_median(arr1, arr2, n):\n    \"\"\"\n    Finds the median of two sorted lists of the same size using a divide-and-conquer approach.\n    Assumes lists are sorted, non-empty, and of equal length `n`.\n    \"\"\"\n\n    def median_of_two(a, b):\n        return (float(a) + float(b)) / 2.0\n\n    def median_of_three(a, b, c):\n        s = sorted([a, b, c])\n        return float(s[1])\n\n    def median_of_four(a, b, c, d):\n        s = sorted([a, b, c, d])\n        return (float(s[1]) + float(s[2])) / 2.0\n\n    def _find_median_recursive(ar1_full, ar2_full, i1, i2, k):\n        # k is the current effective length of the subproblems (initially n)\n        # i1, i2 are the starting indices for the current subproblems in ar1_full and ar2_full\n\n        if k == 0:\n            return -1.0  # Should not be reached with valid n > 0 from initial call.\n\n        if k == 1:\n            return median_of_two(ar1_full[i1], ar2_full[i2])\n\n        if k == 2:\n            return median_of_four(ar1_full[i1], ar1_full[i1 + 1], ar2_full[i2], ar2_full[i2 + 1])\n\n        # General recursive case: reduce problem size by half\n        mid_idx_offset = (k - 1) // 2\n\n        m1 = ar1_full[i1 + mid_idx_offset]\n        m2 = ar2_full[i2 + mid_idx_offset]\n\n        if m1 == m2:\n            return float(m1)\n\n        elements_to_discard = k // 2\n\n        if m1 < m2:\n            # Median must be in the right part of ar1_full's current segment\n            # and the left part of ar2_full's current segment.\n            return _find_median_recursive(ar1_full, ar2_full, i1 + elements_to_discard, i2, k - elements_to_discard)\n        else:  # m1 > m2\n            # Median must be in the left part of ar1_full's current segment\n            # and the right part of ar2_full's current segment.\n            return _find_median_recursive(ar1_full, ar2_full, i1, i2 + elements_to_discard, k - elements_to_discard)\n\n    # Initial call to the recursive function with full arrays and initial length n\n    return _find_median_recursive(arr1, arr2, 0, 0, n)"}
