{"task_id": "Mbpp/64", "solution": "def subject_marks(items):\n    \"\"\"\n    Sorts a list of tuples based on the second value of each tuple in ascending order.\n    Assumes input is a list of 2-element sequences, where the second element is numeric.\n    \"\"\"\n    from dataclasses import dataclass\n    from typing import List\n\n    class InvalidInputError(ValueError):\n        pass\n\n    @dataclass(frozen=True)\n    class SubjectMark:\n        subject: str\n        score: float\n\n        def to_tuple(self) -> tuple[str, float]:\n            return (self.subject, self.score)\n\n    class TupleAdapter:\n        def to_model(self, item: tuple) -> 'SubjectMark':\n            subject, score = item\n            return SubjectMark(str(subject), float(score))\n\n        def to_tuple(self, model: 'SubjectMark') -> tuple:\n            return model.to_tuple()\n\n    class SortService:\n        def sort(self, items_to_sort: List['SubjectMark']) -> List['SubjectMark']:\n            return sorted(items_to_sort, key=lambda m: m.score)\n\n    class Validator:\n        def validate_input(self, input_items) -> None:\n            if not isinstance(input_items, list):\n                raise InvalidInputError(\"Input must be a list of 2-element tuples.\")\n            for idx, it in enumerate(input_items):\n                if not (isinstance(it, (list, tuple)) and len(it) == 2):\n                    raise InvalidInputError(f\"Item at index {idx} must be a 2-element tuple.\")\n                if not isinstance(it[0], str):\n                    raise InvalidInputError(f\"Item at index {idx} first element must be a string.\")\n                if not isinstance(it[1], (int, float)):\n                    raise InvalidInputError(f\"Item at index {idx} second element must be numeric.\")\n\n    validator = Validator()\n    adapter = TupleAdapter()\n    sort_service = SortService()\n\n    validator.validate_input(items)\n    models = [adapter.to_model(it) for it in items]\n    sorted_models = sort_service.sort(models)\n    return [adapter.to_tuple(m) for m in sorted_models]"}
{"task_id": "Mbpp/65", "solution": "MAX_RECURSION_DEPTH_DEFAULT = 1000\nIGNORE_NON_NUMERIC_DEFAULT = False\nclass InvalidElementError(ValueError):\n    \"\"\"Raised when an invalid non-numeric element is encountered.\"\"\"\n    def __init__(self, element, message=None):\n        self.element = element\n        super().__init__(message or f\"Element {element!r} is not numeric and ignore_non_numeric is False.\")\nclass MaxDepthExceededError(RuntimeError):\n    \"\"\"Raised when the maximum recursion depth is exceeded during flattening.\"\"\"\n    def __init__(self, depth, message=None):\n        self.depth = depth\n        super().__init__(message or f\"Maximum depth {depth} exceeded during list flattening.\")\nclass SumResult:\n    \"\"\"Data transfer object for the sum and flattened list.\"\"\"\n    def __init__(self, total: float, flattened: list):\n        self.total = total\n        self.flattened = flattened\n        self.count = len(flattened)\ndef is_numeric(value) -> bool:\n    \"\"\"Checks if a value is an int or float, excluding boolean values.\"\"\"\n    return isinstance(value, (int, float)) and not isinstance(value, bool)\ndef numeric_cast(value) -> float:\n    \"\"\"Casts a numeric value to float; raises InvalidElementError if not numeric.\"\"\"\n    if is_numeric(value):\n        return float(value)\n    raise InvalidElementError(value, f\"Element {value!r} is not numeric and cannot be cast.\")\nclass ListFlattener:\n    \"\"\"Flattens a nested list-like structure into an iterator of its elements.\"\"\"\n    def flatten(self, iterable, max_depth: int = MAX_RECURSION_DEPTH_DEFAULT):\n        \"\"\"Yields non-list elements from nested lists in depth-first order.\"\"\"\n        stack = [(iterable, 0)]\n        while stack:\n            current, depth = stack.pop()\n            if depth > max_depth:\n                raise MaxDepthExceededError(depth, f\"Max depth {max_depth} exceeded while flattening.\")\n\n            if isinstance(current, (list, tuple)):\n                # Push elements onto the stack in reverse order to maintain original order when popped\n                for item in reversed(current):\n                    stack.append((item, depth + 1))\n            else:\n                yield current\nclass RecursiveListSummationService:\n    \"\"\"Orchestrates flattening and numeric accumulation of list elements.\"\"\"\n    def __init__(self, flattener: ListFlattener | None = None):\n        self._flattener = flattener or ListFlattener()\n\n    def sum(self, list_input, ignore_non_numeric: bool = False, max_depth: int = MAX_RECURSION_DEPTH_DEFAULT) -> SumResult:\n        \"\"\"Flattens a list and sums its numeric elements, respecting ignore_non_numeric and max_depth.\"\"\"\n        flattened_values = []\n        total = 0.0\n        for elem in self._flattener.flatten(list_input, max_depth=max_depth):\n            if is_numeric(elem):\n                val = numeric_cast(elem)\n                flattened_values.append(val)\n                total += val\n            else:\n                if ignore_non_numeric:\n                    continue\n                raise InvalidElementError(elem, \"Non-numeric element encountered and not ignored.\")\n        return SumResult(total=total, flattened=flattened_values)\ndef recursive_list_sum(list_input, ignore_non_numeric: bool = IGNORE_NON_NUMERIC_DEFAULT, max_depth: int | None = None) -> float:\n    \"\"\"Flattens a list and sums all of its numeric elements recursively.\"\"\"\n    service = RecursiveListSummationService()\n    if max_depth is None:\n        max_depth = MAX_RECURSION_DEPTH_DEFAULT\n    result = service.sum(list_input, ignore_non_numeric=ignore_non_numeric, max_depth=max_depth)\n    return result.total"}
{"task_id": "Mbpp/68", "solution": "def is_Monotonic(sequence):\n    \"\"\"\n    Checks if the given sequence is monotonic (either non-decreasing or non-increasing).\n    Empty or single-element sequences are considered monotonic.\n    \"\"\"\n\n    def _is_non_decreasing(arr):\n        \"\"\"Checks if the array is non-decreasing (each element is less than or equal to the next).\"\"\"\n        for i in range(len(arr) - 1):\n            if arr[i] > arr[i + 1]:\n                return False\n        return True\n\n    def _is_non_increasing(arr):\n        \"\"\"Checks if the array is non-increasing (each element is greater than or equal to the next).\"\"\"\n        for i in range(len(arr) - 1):\n            if arr[i] < arr[i + 1]:\n                return False\n        return True\n\n    if len(sequence) <= 1:\n        return True\n\n    return _is_non_decreasing(sequence) or _is_non_increasing(sequence)"}
{"task_id": "Mbpp/71", "solution": "from typing import Sequence, Callable, Optional, TypeVar, List, Any\nT = TypeVar(\"T\")\ndef comb_sort(items: Sequence[T], key: Optional[Callable[[T], Any]] = None, reverse: bool = False) -> List[T]:\n    \"\"\"Sorts a list of elements using the comb sort algorithm.\n    It returns a new sorted list without modifying the original input.\n    \"\"\"\n    seq = list(items)\n    n = len(seq)\n    if n < 2:\n        return seq\n\n    gap_shrink_factor = 1.3\n\n    def _next_gap(current_gap: int) -> int:\n        \"\"\"Computes the next gap size for comb sort, ensuring it's at least 1.\"\"\"\n        current_gap = int(current_gap / gap_shrink_factor)\n        return max(1, current_gap)\n\n    def _compare(item_a: T, item_b: T, compare_key: Optional[Callable[[T], Any]], is_reverse: bool) -> bool:\n        \"\"\"Compares two items based on the key and direction, returning True if item_a should come after item_b.\"\"\"\n        val_a = compare_key(item_a) if compare_key else item_a\n        val_b = compare_key(item_b) if compare_key else item_b\n        if is_reverse:\n            return val_a < val_b\n        else:\n            return val_a > val_b\n\n    gap = n\n    swapped = True\n    while gap > 1 or swapped:\n        gap = _next_gap(gap)\n        swapped = False\n        for i in range(n - gap):\n            if _compare(seq[i], seq[i + gap], key, reverse):\n                seq[i], seq[i + gap] = seq[i + gap], seq[i]\n                swapped = True\n    return seq"}
{"task_id": "Mbpp/69", "solution": "def is_sublist(main_list: list, sub_list: list) -> bool:\n    \"\"\"Checks if a list contains the given sublist contiguously.\"\"\"\n    if not sub_list:\n        return True\n\n    if len(sub_list) > len(main_list):\n        return False\n\n    for i in range(len(main_list) - len(sub_list) + 1):\n        if main_list[i : i + len(sub_list)] == sub_list:\n            return True\n\n    return False"}
{"task_id": "Mbpp/67", "solution": "import json\nfrom pathlib import Path\nfrom typing import Optional, Dict\nclass MathUtils:\n    \"\"\"Utility class for mathematical computations.\"\"\"\n    @staticmethod\n    def bell_via_triangle(n: int) -> int:\n        \"\"\"\n        Computes the Bell number B(n) using the Bell triangle method.\n        The Bell number B(n) counts the number of partitions of a set with n elements.\n        \"\"\"\n        if n == 0:\n            return 1\n        bell = [1]\n        for i in range(1, n + 1):\n            row = [bell[-1]]\n            for j in range(1, i + 1):\n                row.append(row[-1] + (bell[j - 1] if j - 1 < len(bell) else 0))\n            bell = row\n        return bell[0]\nclass InMemoryCacheRepository:\n    \"\"\"In-memory cache for Bell numbers.\"\"\"\n    def __init__(self, initial_cache: Optional[Dict[int, int]] = None) -> None:\n        self._store: Dict[int, int] = initial_cache if initial_cache is not None else {}\n\n    def get(self, n: int) -> Optional[int]:\n        \"\"\"Retrieves a Bell number from the cache.\"\"\"\n        return self._store.get(n)\n\n    def set(self, n: int, value: int) -> None:\n        \"\"\"Stores a Bell number in the cache.\"\"\"\n        self._store[n] = value\n\n    def items(self) -> Dict[int, int]:\n        \"\"\"Returns a copy of all items in the cache.\"\"\"\n        return self._store.copy()\nclass BellService:\n    \"\"\"Service to compute Bell numbers, utilizing a cache repository.\"\"\"\n    def __init__(self, repository: InMemoryCacheRepository) -> None:\n        self.repository = repository\n\n    def compute_bell(self, n: int) -> int:\n        \"\"\"\n        Computes the Bell number for n, checking the cache first.\n        If not in cache, it computes using MathUtils and stores the result.\n        \"\"\"\n        val = self.repository.get(n)\n        if val is not None:\n            return val\n        val = MathUtils.bell_via_triangle(n)\n        self.repository.set(n, val)\n        return val\nclass BellResult:\n    \"\"\"Data model to hold the result of a Bell number computation.\"\"\"\n    def __init__(self, n: int, value: int, from_cache: bool) -> None:\n        self.n = n\n        self.value = value\n        self.from_cache = from_cache\nclass FileCacheAdapter:\n    \"\"\"Adapter for persisting and loading cache data from a JSON file.\"\"\"\n    def __init__(self, path: str) -> None:\n        self._path = Path(path)\n\n    def load(self) -> Dict[int, int]:\n        \"\"\"Loads cache data from the specified JSON file.\"\"\"\n        if not self._path.exists():\n            return {}\n        try:\n            raw_cache = json.loads(self._path.read_text(encoding='utf-8'))\n            cache_data = raw_cache.get(\"cache\", raw_cache) # Handle potential versioned cache\n            loaded_cache = {int(k): v for k, v in cache_data.items() if isinstance(k, str) and k.isdigit() and isinstance(v, int)}\n            return loaded_cache\n        except Exception: # Catch broader exception as per constraints\n            return {}\n\n    def save(self, cache: Dict[int, int]) -> None:\n        \"\"\"Saves cache data to the specified JSON file.\"\"\"\n        serializable_cache = {str(k): v for k, v in cache.items()}\n        try:\n            self._path.write_text(json.dumps(serializable_cache, indent=2), encoding='utf-8')\n        except Exception: # Catch broader exception as per constraints\n            pass\nclass BellController:\n    \"\"\"Orchestrates Bell number computation, validation, and caching.\"\"\"\n    def __init__(self, repository: Optional[InMemoryCacheRepository] = None, file_adapter: Optional[FileCacheAdapter] = None) -> None:\n        self.repository = repository or InMemoryCacheRepository()\n        self.file_adapter = file_adapter\n        self.service = BellService(self.repository)\n\n    def compute(self, n: int) -> BellResult:\n        \"\"\"Computes Bell number without persistent caching.\"\"\"\n        cached_val = self.repository.get(n)\n        if cached_val is not None:\n            return BellResult(n, cached_val, True)\n        else:\n            value = self.service.compute_bell(n)\n            return BellResult(n, value, False)\n\n    def compute_with_persistent_cache(self, n: int, cache_file: str) -> BellResult:\n        \"\"\"Computes Bell number, loading from and saving to a persistent cache file.\"\"\"\n        local_file_adapter = self.file_adapter if self.file_adapter is not None else FileCacheAdapter(cache_file)\n\n        initial_cache = local_file_adapter.load()\n        persistent_repository = InMemoryCacheRepository(initial_cache)\n        persistent_service = BellService(persistent_repository)\n\n        cached_val = persistent_repository.get(n)\n        if cached_val is not None:\n            result_value = cached_val\n            from_cache = True\n        else:\n            result_value = persistent_service.compute_bell(n)\n            from_cache = False\n\n        local_file_adapter.save(persistent_repository.items())\n        return BellResult(n, result_value, from_cache)\nclass BellAPI:\n    \"\"\"Public API facade for Bell number computations.\"\"\"\n    def __init__(self, controller: Optional['BellController'] = None) -> None:\n        self.controller = controller or BellController(repository=InMemoryCacheRepository())\n\n    def bell_number(self, n: int, cache_file: Optional[str] = None) -> int:\n        \"\"\"\n        Computes the Bell number for a given integer n.\n        Supports optional file-based persistent caching.\n        \"\"\"\n        if cache_file:\n            adapter = FileCacheAdapter(cache_file)\n            controller_for_persistent_call = BellController(file_adapter=adapter)\n            result = controller_for_persistent_call.compute_with_persistent_cache(n, cache_file)\n        else:\n            result = self.controller.compute(n)\n        return result.value\n_bell_api_instance = BellAPI()\ndef bell_number(n: int, cache_file: Optional[str] = None) -> int:\n    \"\"\"\n    Computes the Bell number B(n), which is the number of partitions of a set of n elements.\n    Supports optional file-based persistent caching.\n    \"\"\"\n    return _bell_api_instance.bell_number(n, cache_file=cache_file)"}
{"task_id": "Mbpp/70", "solution": "from typing import Sequence, Any\ndef get_equal(items: Sequence[Sequence[Any]]) -> bool:\n    \"\"\"\n    Checks if all sequences in a collection have the same length.\n    Returns True if the collection is empty or all sequences have equal length, False otherwise.\n    \"\"\"\n    if not items:\n        return True\n\n    reference_length = len(items[0])\n    for item in items:\n        if len(item) != reference_length:\n            return False\n    return True"}
