{"task_id": "Mbpp/129", "solution": "from typing import List, Any, Optional\nclass Matrix:\n    \"\"\"Represents a 2D integer matrix and provides utility methods.\"\"\"\n    def __init__(self, grid: List[List[int]]) -> None:\n        # A shallow copy to avoid external mutation, assuming `grid` is already valid structure.\n        self._grid = [list(row) for row in grid]\n\n    def size(self) -> int:\n        \"\"\"Returns the dimension n for an n x n matrix.\"\"\"\n        return len(self._grid)\n\n    def is_square(self) -> bool:\n        \"\"\"Checks if the matrix is square.\"\"\"\n        n = self.size()\n        return all(len(row) == n for row in self._grid)\n\n    def flatten(self) -> List[int]:\n        \"\"\"Returns all elements in a single list.\"\"\"\n        return [v for row in self._grid for v in row]\n\n    def row_sum(self, i: int) -> int:\n        \"\"\"Computes the sum of elements in row i.\"\"\"\n        return sum(self._grid[i])\n\n    def col_sum(self, j: int) -> int:\n        \"\"\"Computes the sum of elements in column j.\"\"\"\n        return sum(row[j] for row in self._grid)\n\n    def diag_sum(self, primary: bool = True) -> int:\n        \"\"\"Computes the sum of elements in the primary or secondary diagonal.\"\"\"\n        n = self.size()\n        if primary:\n            return sum(self._grid[i][i] for i in range(n))\n        else:\n            return sum(self._grid[i][n-1-i] for i in range(n))\nclass StructureValidator:\n    \"\"\"Validates raw input structure and returns a Matrix. (Simplified due to constraints)\"\"\"\n    def validate(self, raw_matrix: Any) -> Matrix:\n        # Due to \"Do NOT add isinstance() checks or raise exceptions for edge cases\" constraint,\n        # we assume raw_matrix is already a valid List[List[int]] representing a square matrix.\n        return Matrix(raw_matrix)\nclass SequenceValidator:\n    \"\"\"Validates if the matrix contains consecutive integers 1..n^2 exactly once.\"\"\"\n    def validate_consecutive(self, matrix: Matrix) -> bool:\n        \"\"\"Checks if matrix elements form a consecutive sequence from 1 to n*n.\"\"\"\n        n_squared = matrix.size() ** 2\n        expected_set = set(range(1, n_squared + 1))\n        actual_elements = matrix.flatten()\n        return len(actual_elements) == n_squared and set(actual_elements) == expected_set\nclass SimpleLogger:\n    \"\"\"A minimal logger, whose log method is a no-op due to output constraints.\"\"\"\n    def __init__(self, log_file: Optional[str] = None) -> None:\n        self._log_file = log_file\n\n    def log(self, msg: str) -> None:\n        pass # No actual logging to stdout or file as per constraints.\nclass MagicSquareService:\n    \"\"\"Core service to determine if a matrix is a magic square.\"\"\"\n    def __init__(self, structure_validator: StructureValidator, sequence_validator: SequenceValidator, logger: Optional[SimpleLogger] = None) -> None:\n        self._structure_validator = structure_validator\n        self._sequence_validator = sequence_validator\n        self._logger = logger\n\n    def is_magic(self, raw_matrix: Any, skip_unique_check: bool = False) -> bool:\n        \"\"\"Determines if the given matrix is a magic square based on sums and optional uniqueness.\"\"\"\n        matrix = self._structure_validator.validate(raw_matrix)\n        n = matrix.size()\n\n        if n == 0:\n            return False\n\n        if not skip_unique_check:\n            if not self._sequence_validator.validate_consecutive(matrix):\n                return False\n\n        return self._check_sums(matrix)\n\n    def _check_sums(self, matrix: Matrix) -> bool:\n        \"\"\"Internal method to verify all row, column, and diagonal sums are equal.\"\"\"\n        n = matrix.size()\n\n        if n == 1:\n            return True\n\n        ref_sum = matrix.row_sum(0)\n\n        for i in range(n):\n            if matrix.row_sum(i) != ref_sum:\n                return False\n\n        for j in range(n):\n            if matrix.col_sum(j) != ref_sum:\n                return False\n\n        if matrix.diag_sum(primary=True) != ref_sum:\n            return False\n\n        if matrix.diag_sum(primary=False) != ref_sum:\n            return False\n\n        return True\ndef magic_square_test(matrix: List[List[int]], skip_unique_check: bool = False) -> bool:\n    \"\"\"\n    Calculates whether the input matrix is a magic square.\n    Assumes matrix is a valid square matrix of integers.\n    \"\"\"\n    structure_validator = StructureValidator()\n    sequence_validator = SequenceValidator()\n    logger = SimpleLogger() # Logger is instantiated but performs no logging due to constraints.\n    service = MagicSquareService(structure_validator, sequence_validator, logger)\n    return service.is_magic(matrix, skip_unique_check=skip_unique_check)"}
