{"task_id": "Mbpp/223", "solution": "def is_majority(arr: list[int], n: int, x: int) -> bool:\n    \"\"\"\n    Checks if an element x is the majority element in a sorted array.\n    Majority means occurs more than n/2 times.\n\n    Args:\n        arr: Sorted list of comparable elements.\n        n: Length of the array (must equal len(arr)).\n        x: Element to check.\n\n    Returns:\n        True if x is the majority element, False otherwise.\n    \"\"\"\n    if not isinstance(arr, list):\n        raise TypeError(\"arr must be a list\")\n    if n != len(arr):\n        raise ValueError(\"n must equal len(arr)\")\n\n    # Binary search to find the first occurrence of x\n    low = 0\n    high = n - 1\n    first_idx = -1\n\n    while low <= high:\n        mid = (low + high) // 2\n        if arr[mid] == x:\n            first_idx = mid\n            high = mid - 1  # Look for an earlier occurrence\n        elif arr[mid] < x:\n            low = mid + 1\n        else:  # arr[mid] > x\n            high = mid - 1\n\n    # If x is not found, it cannot be the majority element\n    if first_idx == -1:\n        return False\n\n    # Check if the element at index first_idx + n // 2 is also x\n    majority_threshold_idx = first_idx + n // 2\n\n    return majority_threshold_idx < n and arr[majority_threshold_idx] == x"}
{"task_id": "Mbpp/232", "solution": "def larg_nnum(items, n):\n    \"\"\"\n    Returns a list containing the n largest items from the input list.\n    The items are sorted in descending order before selecting the top n.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n    if n <= 0:\n        return []\n    if not isinstance(items, (list, tuple)):\n        raise TypeError(\"items must be a list or tuple\")\n\n    # For efficiency when n is much smaller than len(items), use heapq.nlargest.\n    try:\n        from heapq import nlargest\n        return list(nlargest(n, items))\n    except Exception:\n        # Fallback to sorting if heapq fails for some reason\n        return sorted(items, reverse=True)[:n]"}
{"task_id": "Mbpp/224", "solution": "def count_Set_Bits(n: int) -> int:\n    \"\"\"\n    Counts the number of set bits (1s) in a non-negative integer using optimized built-in methods.\n    It prioritizes int.bit_count() for modern Python and falls back to bin().count('1').\n\n    Note: This function expects an int. It will raise TypeError for non-int inputs\n    and ValueError for negative integers.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"input must be an int\")\n    if n < 0:\n        raise ValueError(\"negative integers not supported\")\n\n    # Use the optimized int.bit_count() if available (Python 3.8+ provides it in many versions)\n    bit_count_method = getattr(int, \"bit_count\", None)\n    if callable(bit_count_method):\n        return n.bit_count()\n    # Fallback: use binary representation count\n    return bin(n).count(\"1\")"}
