{"task_id": "Mbpp/139", "solution": "def circle_circumference(radius):\n    \"\"\"\n    Calculates the circumference of a circle given its radius.\n    \"\"\"\n    import math\n\n    # Validate input\n    if not isinstance(radius, (int, float)):\n        raise ValueError(\"radius must be a number\")\n    if radius < 0:\n        raise ValueError(\"radius must be non-negative\")\n\n    return 2 * math.pi * float(radius)"}
{"task_id": "Mbpp/137", "solution": "def zero_count(arr):\n    \"\"\"\n    Return the ratio of zero elements to non-zero elements in the input array.\n\n    Raises:\n        TypeError: if arr is not a list/tuple or contains non-integer elements.\n        ValueError: if arr is empty or there are no non-zero elements (division by zero).\n    \"\"\"\n    if not isinstance(arr, (list, tuple)):\n        raise TypeError(\"arr must be a list or tuple of integers\")\n\n    if len(arr) == 0:\n        raise ValueError(\"input array must not be empty\")\n\n    zero_count = 0\n    for v in arr:\n        if not isinstance(v, int):\n            raise TypeError(\"all elements must be integers\")\n        if v == 0:\n            zero_count += 1\n\n    non_zero_count = len(arr) - zero_count\n    if non_zero_count == 0:\n        raise ValueError(\"no non-zero elements; ratio undefined\")\n\n    return zero_count / non_zero_count"}
{"task_id": "Mbpp/140", "solution": "def extract_singly(sequences):\n    \"\"\"\n    Flattens a list of lists into a single list of unique numbers, preserving first-occurrence order.\n    \"\"\"\n    seen = set()\n    result = []\n    for inner_list in sequences:\n        for number in inner_list:\n            if number not in seen:\n                seen.add(number)\n                result.append(number)\n    return result"}
{"task_id": "Mbpp/141", "solution": "def pancake_sort(elements: list) -> list:\n    \"\"\"\n    Sorts a list of elements using the pancake sort algorithm.\n    Returns a new list containing the sorted elements.\n    \"\"\"\n    arr = list(elements)\n    n = len(arr)\n\n    def _flip(arr_to_flip: list, k: int) -> None:\n        \"\"\"Reverses the first 'k' elements of the given list in place.\"\"\"\n        arr_to_flip[:k] = arr_to_flip[:k][::-1]\n\n    for curr_size in range(n, 1, -1):\n        max_idx = 0\n        for i in range(1, curr_size):\n            if arr[i] > arr[max_idx]:\n                max_idx = i\n\n        if max_idx != curr_size - 1:\n            _flip(arr, max_idx + 1)\n            _flip(arr, curr_size)\n    return arr"}
{"task_id": "Mbpp/145", "solution": "def max_Abs_Diff(array):\n    \"\"\"\n    Finds the maximum difference between any two elements in a given array.\n    This is calculated as the difference between the maximum and minimum elements.\n    \"\"\"\n    max_val = max(array)\n    min_val = min(array)\n    return max_val - min_val"}
{"task_id": "Mbpp/142", "solution": "def count_samepair(listA, listB, listC):\n    \"\"\"\n    Counts the number of positions where items are identical across three lists.\n    Compares items up to the minimum length of the three lists, handling comparison errors gracefully.\n    \"\"\"\n    count = 0\n    min_len = min(len(listA), len(listB), len(listC))\n\n    for i in range(min_len):\n        try:\n            # Check if all three items at the current position are identical.\n            if listA[i] == listB[i] == listC[i]:\n                count += 1\n        except Exception:\n            # If comparison raises an error, treat items as non-equal and continue.\n            pass\n    return count"}
{"task_id": "Mbpp/138", "solution": "def is_Sum_Of_Powers_Of_Two(n: int) -> bool:\n    \"\"\"\n    Checks if a given number can be represented as a sum of non-zero powers of 2 (i.e., 2^k for k >= 1).\n    This implies that the number must be >= 2 and its binary representation must not have the 2^0 bit set.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"Input must be an integer\")\n    # Numbers less than or equal to 1 cannot be represented as sums of 2^k where k >= 1.\n    if n <= 1:\n        return False\n    # If the least-significant bit is 0, all set bits correspond to powers 2^k with k >= 1.\n    return (n & 1) == 0"}
{"task_id": "Mbpp/162", "solution": "def closed_form_sum(n: int) -> int:\n    \"\"\"Computes the sum series S(n) = n + (n-2) + (n-4) ... for n >= 0.\"\"\"\n    k = n // 2\n    last_term = n - 2 * k\n    num_terms = k + 1\n    return (num_terms * (n + last_term)) // 2"}
{"task_id": "Mbpp/161", "solution": "def remove_elements(source: list, to_remove):\n    \"\"\"\n    Removes all elements from the source list that are present in the to_remove iterable.\n    Returns a new list, preserving the order of elements from the original source.\n    \"\"\"\n    from typing import Iterable, Any\n\n    # Helper classes for lookup strategies, defined inline to meet the \"inline helper\" constraint.\n    class ListRepository:\n        \"\"\"Abstract base class for item lookup.\"\"\"\n        def contains(self, item: Any) -> bool:\n            raise NotImplementedError\n        def size(self) -> int:\n            raise NotImplementedError\n\n    class SetLookup(ListRepository):\n        \"\"\"Optimized lookup using a set for hashable items.\"\"\"\n        def __init__(self, items: Iterable[Any]) -> None:\n            self._set = set(items)\n        def contains(self, item: Any) -> bool:\n            return item in self._set\n        def size(self) -> int:\n            return len(self._set)\n\n    class ListLookup(ListRepository):\n        \"\"\"Fallback lookup using a list, for unhashable items or small lists.\"\"\"\n        def __init__(self, items: Iterable[Any]) -> None:\n            self._list = list(items)\n        def contains(self, item: Any) -> bool:\n            return item in self._list\n        def size(self) -> int:\n            return len(self._list)\n\n    # The service orchestrates the removal logic.\n    class RemoverService:\n        \"\"\"Business logic for removing elements, choosing lookup strategy.\"\"\"\n        def __init__(self, use_set_lookup: bool = True) -> None:\n            self._use_set_lookup = use_set_lookup\n\n        def remove_raw(self, source_list: list[Any], to_remove_iterable: Iterable[Any]) -> list[Any]:\n            \"\"\"Performs the element removal based on chosen lookup strategy.\"\"\"\n            repo = None\n            if self._use_set_lookup:\n                try:\n                    repo = SetLookup(to_remove_iterable)\n                except TypeError:\n                    # Fallback to ListLookup if items in to_remove_iterable are unhashable\n                    repo = ListLookup(to_remove_iterable)\n            else:\n                repo = ListLookup(to_remove_iterable)\n\n            result = []\n            for item in source_list:\n                if not repo.contains(item):\n                    result.append(item)\n            return result\n\n    # Instantiate the service and call its raw removal method.\n    svc = RemoverService()\n    return svc.remove_raw(source, to_remove)"}
{"task_id": "Mbpp/160", "solution": "def find_solution(a: int, b: int, n: int) -> tuple[int, int] | None:\n    \"\"\"\n    Finds integer solutions (x, y) for the linear Diophantine equation ax + by = n.\n    Returns a canonical (x, y) tuple or None if no solution exists.\n    \"\"\"\n\n    def _extended_gcd(num1: int, num2: int) -> tuple[int, int, int]:\n        \"\"\"Calculates (g, x, y) such that num1*x + num2*y = g = gcd(num1, num2) using the iterative extended Euclidean algorithm.\"\"\"\n        r0, r1 = num1, num2\n        x0, y0 = 1, 0\n        x1, y1 = 0, 1\n\n        while r1 != 0:\n            q = r0 // r1\n            r0, r1 = r1, r0 - q * r1\n            x0, x1 = x1, x0 - q * x1\n            y0, y1 = y1, y0 - q * y1\n        return r0, x0, y0\n\n    def _canonicalize(orig_a: int, orig_b: int, common_divisor: int, x_part: int, y_part: int) -> tuple[int, int]:\n        \"\"\"Adjusts a particular solution (x_part, y_part) to its canonical form.\"\"\"\n        if orig_b != 0:\n            mod_val = orig_b // common_divisor\n            period_x = abs(mod_val)\n\n            x_can = x_part % period_x\n            t = (x_can - x_part) // mod_val\n            y_can = y_part - (orig_a // common_divisor) * t\n            return x_can, y_can\n        else: # orig_b == 0\n            # If b is 0, the equation is a*x = n. x_can is n // a, and y_can is 0.\n            return n // orig_a, 0\n\n    # Handle the case where both a and b are zero\n    if a == 0 and b == 0:\n        return (0, 0) if n == 0 else None\n\n    # Calculate gcd(|a|, |b|) and initial Bezout coefficients\n    # g = gcd(|a|, |b|), x_g, y_g such that |a|*x_g + |b|*y_g = g\n    g, x_g, y_g = _extended_gcd(abs(a), abs(b))\n\n    # If n is not divisible by g, no integer solution exists\n    if n % g != 0:\n        return None\n\n    # Scale the Bezout coefficients to get a particular solution for n\n    factor = n // g\n\n    # Adjust x_g and y_g based on the original signs of a and b\n    # If a is negative, the x coefficient changes sign\n    # If b is negative, the y coefficient changes sign\n    if a < 0:\n        x_g = -x_g\n    if b < 0:\n        y_g = -y_g\n\n    # Particular solution for ax + by = n\n    x0 = x_g * factor\n    y0 = y_g * factor\n\n    # Canonicalize the particular solution (x0, y0)\n    x_can, y_can = _canonicalize(a, b, g, x0, y0)\n\n    return x_can, y_can"}
{"task_id": "Mbpp/165", "solution": "def count_char_position(s: str) -> int:\n    \"\"\"\n    Counts characters in a string that match their 1-based English alphabet position.\n    The comparison is case-insensitive, and non-alphabetic characters are ignored for matching.\n    \"\"\"\n    count = 0\n    for idx, char_in_s in enumerate(s):\n        lower_char = char_in_s.lower()\n        if 'a' <= lower_char <= 'z':\n            alphabet_pos = ord(lower_char) - ord('a') + 1\n            if alphabet_pos == idx + 1:\n                count += 1\n    return count"}
{"task_id": "Mbpp/167", "solution": "def next_power_of_2(n: int) -> int:\n    \"\"\"\n    Finds the smallest power of 2 greater than or equal to n.\n    Handles n=0 and n=1 by returning 1.\n    \"\"\"\n    if n <= 1:\n        return 1\n\n    v = n - 1\n\n    # Propagate the most significant bit to the right to fill all lower bits with 1s.\n    # Works for Python's arbitrary-precision ints by increasing shift exponentially.\n    shift = 1\n    while True:\n        new_v = v | (v >> shift)\n        if new_v == v:\n            break\n        v = new_v\n        shift <<= 1\n\n    # v becomes (2^k - 1); adding 1 yields 2^k which is the desired result.\n    return v + 1"}
{"task_id": "Mbpp/166", "solution": "def find_even_pair(numbers):\n    \"\"\"\n    Counts the number of unordered pairs of integers in a list whose XOR result is an even number.\n    This relies on the property that a XOR b is even iff a and b have the same parity.\n    \"\"\"\n    even_count = 0\n    odd_count = 0\n\n    for num in numbers:\n        if num % 2 == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n\n    even_pairs = (even_count * (even_count - 1)) // 2\n    odd_pairs = (odd_count * (odd_count - 1)) // 2\n\n    return even_pairs + odd_pairs"}
