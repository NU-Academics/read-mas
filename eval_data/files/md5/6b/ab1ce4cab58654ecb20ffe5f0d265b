{"task_id": "Mbpp/638", "solution": "def wind_chill(velocity_kmh: float, temperature_c: float) -> int:\n    \"\"\"\n    Calculate the wind chill index (Canadian formula) and return it rounded to the nearest integer.\n    Ties (.5) are rounded away from zero.\n    \"\"\"\n    v_pow = velocity_kmh ** 0.16\n    raw_value = 13.12 + 0.6215 * temperature_c - 11.37 * v_pow + 0.3965 * temperature_c * v_pow\n\n    if raw_value >= 0:\n        return int(raw_value + 0.5)\n    else:\n        return int(raw_value - 0.5)"}
{"task_id": "Mbpp/641", "solution": "def is_nonagonal(n: int) -> int:\n    \"\"\"\n    Computes the nth nonagonal number using the closed-form formula.\n    Assumes n is a positive integer.\n    \"\"\"\n    # The closed-form formula for the nth nonagonal number is N(n) = (7n^2 - 5n) / 2\n    return (7 * n * n - 5 * n) // 2"}
{"task_id": "Mbpp/644", "solution": "def reverse_Array_Upto_K(arr, k):\n    \"\"\"\n    Reverses the elements of an array up to a given position k.\n    The function returns a new list and does not modify the original array.\n    \"\"\"\n    lst = list(arr)\n    effective_k = min(k, len(lst))\n    return lst[:effective_k][::-1] + lst[effective_k:]"}
