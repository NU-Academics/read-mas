{"task_id": "Mbpp/724", "solution": "def power_base_sum(base, power):\n    \"\"\"\n    Calculates the sum of all digits of the base to the specified power.\n    This function handles large numbers using Python's arbitrary-precision integers.\n    \"\"\"\n    result = base ** power\n    # Convert the number to its absolute string representation to sum its digits.\n    digit_sum = sum(int(digit) for digit in str(abs(result)))\n    return digit_sum"}
{"task_id": "Mbpp/725", "solution": "def extract_quotation(text: str) -> list[str]:\n    \"\"\"\n    Extracts values between double quotation marks from the given string.\n    Handles escaped double quotes within segments.\n    \"\"\"\n    class QuoteSegment:\n        def __init__(self, value: str, start: int, end: int):\n            self.value = value\n            self.start = start\n            self.end = end\n\n    ESCAPE_CHAR = \"\\\\\"\n    QUOTE_CHAR = \"\\\"\"\n\n    segments = []\n    in_quote = False\n    buf = []\n    start_idx = 0\n    i = 0\n    while i < len(text):\n        ch = text[i]\n        if in_quote:\n            # Check for escaped quote inside the segment\n            if ch == ESCAPE_CHAR and i + 1 < len(text) and text[i+1] == QUOTE_CHAR:\n                buf.append(QUOTE_CHAR)\n                i += 2  # Consume both backslash and quote\n                continue\n            # Check for closing quote\n            if ch == QUOTE_CHAR:\n                segments.append(QuoteSegment(\"\".join(buf), start_idx, i))\n                buf = []\n                in_quote = False\n            else:\n                buf.append(ch)\n        else: # Not currently inside a quote\n            # Check for opening quote\n            if ch == QUOTE_CHAR:\n                in_quote = True\n                start_idx = i + 1 # Value starts after the opening quote\n            # Other characters are skipped when not in a quote\n        i += 1\n\n    # Per design context and problem constraints, no exception is raised for unbalanced quotes.\n    # Any content in 'buf' at the end if 'in_quote' is True is simply discarded.\n\n    return [seg.value for seg in segments]"}
{"task_id": "Mbpp/726", "solution": "def multiply_elements(values: tuple) -> tuple:\n    \"\"\"\n    Computes a tuple of products of adjacent elements from the input tuple.\n\n    For an input tuple (t_1, ..., t_{N+1}), returns a tuple of length N\n    where the i-th element is t_i * t_{i+1}.\n    \"\"\"\n    results = []\n    for i in range(len(values) - 1):\n        results.append(values[i] * values[i+1])\n    return tuple(results)"}
{"task_id": "Mbpp/732", "solution": "def replace_specialchar(text: str) -> str:\n    \"\"\"\n    Replaces spaces, commas, and dots in a string with colons.\n    This is a convenience function that initializes the entire service stack.\n    \"\"\"\n    from .controller import ReplaceController\n    from .service import ReplaceService\n    from .mapper import CharMapper\n    from .validator import InputValidator\n    from .adapters.logger_adapter import LoggerAdapter\n\n    controller = ReplaceController(\n        service=ReplaceService(mapper=CharMapper(), logger=LoggerAdapter()),\n        validator=InputValidator(),\n        logger=LoggerAdapter(),\n    )\n    return controller.handle_replace(text)"}
{"task_id": "Mbpp/731", "solution": "import math\ndef lateralsurface_cone(r, h):\n    \"\"\"\n    Calculates the lateral surface area of a cone.\n    Formula: pi * r * sqrt(r^2 + h^2)\n    \"\"\"\n    slant_height = math.hypot(r, h)\n    lateral_area = math.pi * r * slant_height\n    return lateral_area"}
{"task_id": "Mbpp/730", "solution": "from typing import Sequence, List, TypeVar, Any\nT = TypeVar(\"T\")\ndef consecutive_duplicates(input_list: Sequence[T]) -> List[T]:\n    \"\"\"\n    Removes consecutive duplicate elements from a list, preserving order.\n    Non-consecutive duplicates are not removed.\n    \"\"\"\n    result: List[T] = []\n    prev_item_set = False\n    prev_item: Any = None\n\n    for item in input_list:\n        if not prev_item_set or item != prev_item:\n            result.append(item)\n            prev_item = item\n            prev_item_set = True\n    return result"}
{"task_id": "Mbpp/734", "solution": "def sum_Of_Subarray_Prod(lst):\n    \"\"\"\n    Calculates the sum of products of all possible contiguous sublists.\n    Example: [1,2,3] -> subarrays: [1],[2],[3],[1,2],[2,3],[1,2,3]\n             products: 1,2,3,2,6,6 => sum = 20\n    \"\"\"\n    total_sum_of_products = 0\n    # prev_products stores the products of all contiguous subarrays ending at the previous element.\n    prev_products = []\n\n    for x in lst:\n        # For the current element x, new_products will contain:\n        # 1. x itself (as a single-element subarray product)\n        # 2. Products of (x * each product from prev_products)\n        new_products = [x] + [p * x for p in prev_products]\n        total_sum_of_products += sum(new_products)\n        prev_products = new_products\n\n    return total_sum_of_products"}
{"task_id": "Mbpp/735", "solution": "def toggle_middle_bits(n: int) -> int:\n    \"\"\"Toggles the middle bits of a non-negative integer, preserving the MSB and LSB.\"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"Input must be an integer\")\n    if n < 0:\n        raise ValueError(\"Input must be non-negative\")\n\n    L = n.bit_length()\n\n    if L < 3:\n        return n\n\n    # Mask with 1s in positions 0..L-1\n    all_ones_mask = (1 << L) - 1\n    # Clear MSB (bit L-1) and LSB (bit 0) to get middle bits mask\n    middle_mask = all_ones_mask & ~(1 << (L - 1)) & ~1\n\n    return n ^ middle_mask"}
{"task_id": "Mbpp/733", "solution": "def find_first_occurrence(values: list[int], target: int) -> int:\n    \"\"\"\n    Return the index of the first (leftmost) occurrence of target in a sorted list `values`.\n    If target is not present, return -1.\n    \"\"\"\n    if values is None:\n        return -1\n    left, right = 0, len(values) - 1\n    result = -1\n    while left <= right:\n        mid = (left + right) // 2\n        if values[mid] == target:\n            result = mid\n            right = mid - 1\n        elif values[mid] < target:\n            left = mid + 1\n        else:\n            right = mid - 1\n    return result"}
{"task_id": "Mbpp/736", "solution": "def left_insertion(values, value):\n    \"\"\"\n    Locate the left insertion point for a specified value in sorted order using binary search.\n    This corresponds to Python's `bisect_left` behavior.\n    \"\"\"\n    lo = 0\n    hi = len(values)\n    while lo < hi:\n        mid = (lo + hi) // 2\n        if values[mid] < value:\n            lo = mid + 1\n        else:\n            hi = mid\n    return lo"}
{"task_id": "Mbpp/739", "solution": "from math import isqrt\ndef find_Index(n: int) -> int:\n    \"\"\"\n    Finds the index k of the smallest triangular number with n digits.\n    \"\"\"\n    if not isinstance(n, int) or n < 1:\n        raise ValueError(\"n must be an integer >= 1\")\n\n    threshold = 10 ** (n - 1)\n    discriminant = 1 + 8 * threshold\n\n    r = isqrt(discriminant)\n    sqrt_ceil_value = r if r * r == discriminant else r + 1\n\n    numerator = sqrt_ceil_value - 1\n    denominator = 2\n    k = (numerator + denominator - 1) // denominator\n\n    return k"}
{"task_id": "Mbpp/737", "solution": "import re\ndef check_str(s: str) -> bool:\n    \"\"\"\n    Checks if the given string starts with a vowel (case-insensitive) using regex.\n    Returns False for an empty string.\n    \"\"\"\n    if not s:\n        return False\n    # Regex pattern to match 'a', 'e', 'i', 'o', 'u' at the beginning of the string, case-insensitive.\n    pattern = r'^[aeiouAEIOU]'\n    return bool(re.match(pattern, s))"}
{"task_id": "Mbpp/741", "solution": "def all_Characters_Same(text: str) -> bool:\n    \"\"\"\n    Checks if all characters in a string are identical.\n    Returns True if the string is non-empty and all characters are the same, otherwise False.\n    \"\"\"\n    if not text:\n        return False\n    return len(set(text)) == 1"}
{"task_id": "Mbpp/742", "solution": "def area_tetrahedron(side: float) -> float:\n    \"\"\"\n    Calculates the surface area of a regular tetrahedron given its side length.\n    \"\"\"\n    SQRT3 = 1.7320508075688772  # Precomputed square root of 3 for precision\n    return SQRT3 * (side ** 2)"}
{"task_id": "Mbpp/740", "solution": "def tuple_to_dict(input_tuple):\n    \"\"\"Converts a tuple of adjacent elements into a key-value dictionary.\n    Keys are taken from even indices, and values from odd indices.\"\"\"\n    it = iter(input_tuple)\n    return dict(zip(it, it))"}
{"task_id": "Mbpp/743", "solution": "def rotate_right(lst: list, k: int) -> list:\n    \"\"\"\n    Rotates a list to the right by k positions.\n    Handles empty lists, k > len(lst), and negative k (left rotation).\n    \"\"\"\n    n = len(lst)\n    if n == 0:\n        return []\n\n    k_norm = k % n\n\n    if k_norm == 0:\n        return lst.copy()\n\n    return lst[-k_norm:] + lst[:-k_norm]"}
