{"task_id": "Mbpp/597", "solution": "from typing import Sequence, Type, List, Optional\ndef find_kth(arr1: Sequence[int], arr2: Sequence[int], k: int) -> int:\n    \"\"\"\n    Finds the k-th smallest element from two sorted arrays.\n    Validates inputs and uses a recursive divide-and-conquer algorithm.\n    \"\"\"\n\n    class InvalidInputError(Exception):\n        \"\"\"Exception raised for invalid input to the find_kth function.\"\"\"\n        def __init__(self, message: str) -> None:\n            super().__init__(message)\n            self.message = message\n\n    class ArrayRepository:\n        \"\"\"A wrapper for a sequence to provide read-only access and slicing.\"\"\"\n        def __init__(self, arr: Sequence[int]) -> None:\n            self._arr = list(arr)\n\n        def len(self) -> int:\n            \"\"\"Returns the number of elements in the repository.\"\"\"\n            return len(self._arr)\n\n        def get(self, idx: int) -> int:\n            \"\"\"Returns the element at the given 0-based index.\"\"\"\n            return self._arr[idx]\n\n        def slice(self, start: int, end: int) -> \"ArrayRepository\":\n            \"\"\"Returns a new ArrayRepository representing a sub-slice.\"\"\"\n            return ArrayRepository(self._arr[start:end])\n\n    def _validate_sorted(arr: Sequence[int]) -> bool:\n        \"\"\"Checks if an array is sorted in non-decreasing order.\"\"\"\n        for i in range(len(arr) - 1):\n            if arr[i] > arr[i+1]:\n                return False\n        return True\n\n    def _validate_k(k: int, total_elements: int) -> None:\n        \"\"\"Validates if k is within the valid range [1, total_elements].\"\"\"\n        if not (1 <= k <= total_elements):\n            raise InvalidInputError(\n                f\"k (which is {k}) must be between 1 and the total number of elements \"\n                f\"({total_elements}) inclusive.\"\n            )\n\n    class FinderService:\n        \"\"\"Implements the core algorithm to find the k-th element.\"\"\"\n        def __init__(self, repo_cls: Type[ArrayRepository] = ArrayRepository) -> None:\n            self._repo_cls = repo_cls\n\n        def find_kth(self, arr1: Sequence[int], arr2: Sequence[int], k: int) -> int:\n            \"\"\"Finds the k-th smallest element across two sorted arrays.\"\"\"\n            if not _validate_sorted(arr1) or not _validate_sorted(arr2):\n                raise InvalidInputError(\"Input arrays must be sorted non-decreasingly.\")\n\n            total_elements = len(arr1) + len(arr2)\n            _validate_k(k, total_elements)\n\n            a = self._repo_cls(arr1)\n            b = self._repo_cls(arr2)\n            return self._find_kth_recursive(a, b, k)\n\n        def _find_kth_recursive(self, a: ArrayRepository, b: ArrayRepository, k: int) -> int:\n            \"\"\"Recursive helper to find the k-th element using a divide-and-conquer strategy.\"\"\"\n            # Ensure 'a' is always the shorter or equal length array\n            if a.len() > b.len():\n                return self._find_kth_recursive(b, a, k)\n\n            # Base cases\n            if a.len() == 0:\n                return b.get(k - 1)\n            if k == 1:\n                return min(a.get(0), b.get(0))\n\n            # Determine partition points for recursion\n            i = min(k // 2, a.len())\n            j = k - i\n\n            # Compare elements at the partition points\n            val_a = a.get(i - 1)\n            val_b = b.get(j - 1)\n\n            if val_a < val_b:\n                # Discard the first 'i' elements from 'a' and reduce k\n                return self._find_kth_recursive(a.slice(i, a.len()), b, k - i)\n            elif val_a > val_b:\n                # Discard the first 'j' elements from 'b' and reduce k\n                return self._find_kth_recursive(a, b.slice(j, b.len()), k - j)\n            else: # val_a == val_b\n                # If elements at partition points are equal, it is the k-th element.\n                return val_a\n\n    service = FinderService()\n    return service.find_kth(arr1, arr2, k)"}
{"task_id": "Mbpp/598", "solution": "class InvalidInputError(Exception):\n    def __init__(self, message: str) -> None:\n        self.message = message\n        super().__init__(message)\nclass NumberDTO:\n    def __init__(self, value: int) -> None:\n        self.value = value\nclass Validator:\n    MIN_VALUE = 0\n    MAX_DIGITS = 1000\n\n    def validate(self, value: 'Any') -> NumberDTO:\n        \"\"\"\n        Validates input to ensure it's a non-negative integer within digit limits.\n        Raises InvalidInputError for invalid types, negative numbers, or excessive digits.\n        \"\"\"\n        num: int\n        try:\n            if isinstance(value, int):\n                num = value\n            elif isinstance(value, str):\n                s = value.strip()\n                if not s:\n                    raise InvalidInputError(\"Empty string is not a valid integer\")\n                num = int(s, 10)\n            else:\n                raise InvalidInputError(\"Input must be an integer or string representing an integer\")\n        except ValueError:\n            raise InvalidInputError(f\"Invalid integer input: {value!r}\")\n\n        if num < self.MIN_VALUE:\n            raise InvalidInputError(\"Negative numbers are not allowed\")\n\n        if len(str(num)) > self.MAX_DIGITS:\n            raise InvalidInputError(\"Number has too many digits\")\n\n        return NumberDTO(num)\nclass ArmstrongCalculator:\n    def calculate(self, n: int) -> int:\n        \"\"\"\n        Computes the sum of each digit raised to the power of the number of digits.\n        Handles the special case for n=0 correctly.\n        \"\"\"\n        if n == 0:\n            return 0\n\n        temp = n\n        d = 0\n        while temp > 0:\n            d += 1\n            temp //= 10\n\n        total = 0\n        temp = n\n        while temp > 0:\n            digit = temp % 10\n            total += pow(digit, d)\n            temp //= 10\n        return total\nclass ArmstrongService:\n    def __init__(self, validator: Validator = None, calculator: ArmstrongCalculator = None) -> None:\n        self._validator = validator if validator is not None else Validator()\n        self._calculator = calculator if calculator is not None else ArmstrongCalculator()\n\n    def is_armstrong(self, value: 'Any') -> bool:\n        \"\"\"\n        Orchestrates validation and calculation to determine if a number is Armstrong.\n        Accepts any type and relies on the validator for input processing.\n        \"\"\"\n        dto = self._validator.validate(value)\n        computed = self._calculator.calculate(dto.value)\n        return computed == dto.value\ndef armstrong_number(n: int) -> bool:\n    \"\"\"\n    Checks if a given number is an Armstrong number.\n    Raises InvalidInputError for invalid input such as negative numbers.\n    \"\"\"\n    svc = ArmstrongService()\n    return svc.is_armstrong(n)"}
{"task_id": "Mbpp/600", "solution": "class EvenCheckerError(Exception):\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\nclass InvalidTypeError(EvenCheckerError):\n    def __init__(self, message: str):\n        super().__init__(message)\nclass NumberModel:\n    def __init__(self, value: int) -> None:\n        # Defensive check, normalize_to_int should ensure int before calling this.\n        if not isinstance(value, int):\n            raise ValueError(\"NumberModel requires an int\")\n        self._value: int = value\n\n    def get_value(self) -> int:\n        return self._value\nclass Validator:\n    def is_integer_like(self, value: object) -> bool:\n        if isinstance(value, int):\n            return True\n        if isinstance(value, float):\n            return value.is_integer()\n        if isinstance(value, str):\n            s = value.strip()\n            if s.startswith(('+', '-')):\n                s = s[1:]\n            return s.isdigit()\n        return False\n\n    def normalize_to_int(self, value: object) -> int:\n        if isinstance(value, int):\n            return value\n        if isinstance(value, float):\n            if value.is_integer():\n                return int(value)\n            raise InvalidTypeError(f\"Float {value} is not integral\")\n        if isinstance(value, str):\n            try:\n                s = value.strip()\n                return int(s)\n            except ValueError:\n                raise InvalidTypeError(f\"String '{value}' is not an integer\")\n        raise InvalidTypeError(f\"Unsupported type: {type(value)}\")\nclass ParityService:\n    def __init__(self, validator: Validator) -> None:\n        self._validator = validator\n\n    def is_even(self, value: object) -> bool:\n        n = self._validator.normalize_to_int(value)\n        number = NumberModel(n)\n        return self._compute_parity(number.get_value())\n\n    def _compute_parity(self, n: int) -> bool:\n        return (n & 1) == 0\nclass EvenController:\n    def __init__(self, service: ParityService) -> None:\n        self._service = service\n\n    def is_even(self, value: object) -> bool:\n        return self._service.is_even(value)\n_validator = Validator()\n_service = ParityService(_validator)\n_controller = EvenController(_service)\ndef is_Even(number: object) -> bool:\n    \"\"\"Checks if the given number is even. Handles integers, integral floats, and numeric strings.\"\"\"\n    return _controller.is_even(number)"}
{"task_id": "Mbpp/602", "solution": "from typing import Optional\ndef first_repeated_char(s: str) -> Optional[str]:\n    \"\"\"\n    Finds the first repeated character in a string.\n    Returns the character as a single-character string, or None if no character repeats.\n    \"\"\"\n    if not isinstance(s, str):\n        raise TypeError(\"Input must be a string\")\n    seen: set[str] = set()\n    for ch in s:\n        if ch in seen:\n            return ch\n        seen.add(ch)\n    return None"}
{"task_id": "Mbpp/604", "solution": "def reverse_words(s: str) -> str:\n    \"\"\"\n    Reverses the order of words in a space-separated string, normalizing whitespace.\n    Multiple whitespace characters (spaces, tabs, newlines) are collapsed to a single space,\n    and leading/trailing whitespace is removed.\n    \"\"\"\n    import re\n\n    if not isinstance(s, str):\n        raise TypeError(\"Input must be a string\")\n\n    normalized_s = re.sub(r'\\s+', ' ', s).strip()\n    if not normalized_s:\n        return \"\"\n\n    words = normalized_s.split(\" \")\n    reversed_words = list(reversed(words))\n    return \" \".join(reversed_words)"}
