{"task_id": "Mbpp/120", "solution": "import math\nfrom typing import Iterable, Union, Any\nNumber = Union[int, float]\nclass InvalidInputError(Exception):\n    \"\"\"Raised when input format or types are invalid.\"\"\"\n    def __init__(self, message: str) -> None:\n        self.message = message\n        super().__init__(self.message)\nclass EmptyInputError(Exception):\n    \"\"\"Raised when an expected input list is empty.\"\"\"\n    def __init__(self, message: str) -> None:\n        self.message = message\n        super().__init__(self.message)\nclass TuplePair:\n    \"\"\"Represents a validated pair of numeric values and provides product computations.\"\"\"\n    def __init__(self, a: float, b: float) -> None:\n        self.a: float = float(a)\n        self.b: float = float(b)\n\n    def product(self) -> float:\n        \"\"\"Returns the product of the two numbers.\"\"\"\n        return self.a * self.b\n\n    def abs_product(self) -> float:\n        \"\"\"Returns the absolute product of the two numbers.\"\"\"\n        return abs(self.product())\nclass Validator:\n    \"\"\"Validates raw iterable of items to ensure they are 2-element sequences with numeric entries.\"\"\"\n    @staticmethod\n    def is_number(x: Any) -> bool:\n        \"\"\"Checks if an item is a number (int or float) but not boolean.\"\"\"\n        return isinstance(x, (int, float)) and not isinstance(x, bool)\n\n    def validate_and_build(self, pairs: Iterable[Any]) -> list[TuplePair]:\n        \"\"\"Iterates over input, validates each element, and builds a list of TuplePair objects.\"\"\"\n        result = []\n        for idx, elem in enumerate(pairs):\n            if not isinstance(elem, (list, tuple)) or len(elem) != 2:\n                raise InvalidInputError(f\"Element at index {idx} is not a 2-length sequence: {elem!r}\")\n            a, b = elem\n            if not self.is_number(a):\n                raise InvalidInputError(f\"Element at index {idx} first item is not numeric: {a!r}\")\n            if not self.is_number(b):\n                raise InvalidInputError(f\"Element at index {idx} second item is not numeric: {b!r}\")\n            result.append(TuplePair(float(a), float(b)))\n        return result\nclass MaxProductService:\n    \"\"\"Computes the maximum absolute product across validated TuplePair objects.\"\"\"\n    def __init__(self) -> None:\n        pass\n\n    def compute_max_product(self, pairs: Iterable[TuplePair]) -> float:\n        \"\"\"Iterates through pairs, computes the absolute product for each, and returns the maximum.\"\"\"\n        iterator = iter(pairs)\n        try:\n            first = next(iterator)\n        except StopIteration:\n            raise EmptyInputError(\"No pairs provided\")\n\n        max_val = first.abs_product()\n        for p in iterator:\n            v = p.abs_product()\n            if v > max_val:\n                max_val = v\n        return max_val\nclass InputAdapter:\n    \"\"\"Normalizes raw inputs into List[TuplePair].\n    This inline implementation only supports direct iterable input.\"\"\"\n    def normalize(self, raw: Any) -> list[TuplePair]:\n        \"\"\"Accepts an iterable of pairs and validates them.\n        String inputs (JSON or file paths) are not supported due to constraints.\"\"\"\n        if isinstance(raw, str):\n            raise InvalidInputError(\"String input (JSON/file path) is not supported in this inline implementation.\")\n\n        validator = Validator()\n        return validator.validate_and_build(raw)\n\n    def from_json_string(self, json_str: str) -> list[TuplePair]:\n        raise NotImplementedError(\"from_json_string not implemented due to external module constraint.\")\n\n    def from_file(self, path: str) -> list[TuplePair]:\n        raise NotImplementedError(\"from_file not implemented due to external module constraint.\")\ndef max_product_tuple(pairs: Iterable[tuple]) -> Number:\n    \"\"\"\n    Finds the maximum absolute product between numbers in pairs of tuples within a given list.\n    Raises InvalidInputError or EmptyInputError for malformed or empty inputs.\n    \"\"\"\n    adapter = InputAdapter()\n    validated_pairs = adapter.normalize(pairs)\n    service = MaxProductService()\n    return service.compute_max_product(validated_pairs)"}
