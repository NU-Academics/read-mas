{"task_id": "Mbpp/237", "solution": "from collections import Counter\nfrom typing import Iterable, Tuple, Any, Dict, Iterator\nclass InvalidInputError(Exception):\n    \"\"\"Exception raised for invalid input data during canonicalization.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\nclass TupleCanonicalizer:\n    \"\"\"Provides methods to canonicalize tuple-like iterables by sorting their elements.\"\"\"\n    def canonicalize(self, t: Iterable[Any]) -> Tuple[Any, ...]:\n        \"\"\"Converts an iterable to a sorted tuple (canonical form).\"\"\"\n        try:\n            elems = tuple(t)\n            return tuple(sorted(elems))\n        except TypeError as ex:\n            raise InvalidInputError(f\"Cannot canonicalize input '{t}': elements are not comparable or input is not a valid iterable. Details: {ex}\") from ex\n        except Exception as ex:\n            raise InvalidInputError(f\"An unexpected error occurred during canonicalization of '{t}': {ex}\") from ex\n\n    def canonicalize_many(self, inputs: Iterable[Iterable[Any]]) -> Iterator[Tuple[Any, ...]]:\n        \"\"\"Yields canonical tuples for an iterable of tuple-like inputs.\"\"\"\n        for item in inputs:\n            yield self.canonicalize(item)\nclass OccurrenceCounterService:\n    \"\"\"Counts occurrences of canonicalized tuples using a TupleCanonicalizer.\"\"\"\n    def __init__(self, canonicalizer: TupleCanonicalizer = None) -> None:\n        \"\"\"Initializes the service with an optional canonicalizer, defaulting to a new one.\"\"\"\n        self._canonicalizer = canonicalizer or TupleCanonicalizer()\n\n    def count(self, inputs: Iterable[Iterable[Any]]) -> Dict[Tuple[Any, ...], int]:\n        \"\"\"Counts occurrences of unique canonicalized tuples from the provided inputs.\"\"\"\n        counter = Counter()\n        for canonical_tuple in self._canonicalizer.canonicalize_many(inputs):\n            counter[canonical_tuple] += 1\n        return dict(counter)\ndef check_occurences(inputs: Iterable[Tuple[Any, ...]]) -> Dict[Tuple[Any, ...], int]:\n    \"\"\"\n    Takes a list of tuples and returns a dictionary mapping each unique canonical tuple\n    to the number of times it occurs, treating permutations as the same.\n    \"\"\"\n    service = OccurrenceCounterService()\n    return service.count(inputs)"}
