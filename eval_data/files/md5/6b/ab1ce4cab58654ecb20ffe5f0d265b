{"task_id": "Mbpp/247", "solution": "import unicodedata\nfrom typing import List\ndef lps(text: str, normalize: bool = True, max_len: int = 100000) -> int:\n    \"\"\"\n    Finds the length of the longest palindromic subsequence in the given string.\n    This implementation uses dynamic programming with O(N) space complexity.\n    \"\"\"\n\n    def _normalize_string_inline(s: str) -> str:\n        \"\"\"Strips non-alphanumeric characters and lowercases the input string.\"\"\"\n        return \"\".join(ch.lower() for ch in s if unicodedata.category(ch)[0] in (\"L\", \"N\"))\n\n    def _lps_dp_core_inline(chars: List[str]) -> int:\n        \"\"\"\n        Computes the length of the LPS for a list of characters using dynamic programming.\n        It uses O(N) memory by only keeping track of the previous row.\n        \"\"\"\n        n = len(chars)\n        if n == 0:\n            return 0\n\n        # prev array stores dp[i+1][j] values from the previous iteration of i\n        prev = [0] * n\n\n        # Iterate `i` from n-1 down to 0\n        for i in reversed(range(n)):\n            # cur array stores dp[i][j] values for the current iteration of i\n            cur = [0] * n\n            cur[i] = 1 # A single character forms a palindrome of length 1\n\n            # Iterate `j` from i+1 up to n-1\n            for j in range(i + 1, n):\n                if chars[i] == chars[j]:\n                    # If characters match, add 2 (for chars[i] and chars[j])\n                    # plus the LPS of the substring between them (dp[i+1][j-1])\n                    cur[j] = 2 + prev[j - 1]\n                else:\n                    # If characters don't match, take the maximum of:\n                    # 1. LPS of substring excluding chars[i] (dp[i+1][j]) -> prev[j]\n                    # 2. LPS of substring excluding chars[j] (dp[i][j-1]) -> cur[j-1]\n                    cur[j] = max(prev[j], cur[j - 1])\n            prev = cur # Move current row to previous for the next iteration of i\n\n        return prev[n - 1] # The final result is dp[0][n-1]\n\n    # Apply normalization if requested\n    processed_text = _normalize_string_inline(text) if normalize else text\n\n    # Convert the processed string into a list of characters\n    chars = list(processed_text)\n\n    # Handle empty string after processing\n    if not chars:\n        return 0\n\n    # Per design context, max_len is for validation.\n    # Per prompt constraints, \"Do NOT add isinstance() checks or raise exceptions for edge cases\".\n    # Therefore, we proceed with computation regardless of `text` length relative to `max_len`.\n\n    return _lps_dp_core_inline(chars)"}
{"task_id": "Mbpp/245", "solution": "def max_sum(arr: list[int]) -> int:\n    \"\"\"\n    Finds the maximum sum of a bitonic subsequence for the given array.\n    A sequence is bitonic if it is first strictly increasing and then strictly decreasing.\n    \"\"\"\n    n = len(arr)\n    if n == 0:\n        # Per design context, input length >= 1, so this case should be prevented by validation.\n        # However, if it were possible, an empty array would have a sum of 0.\n        return 0\n\n    # Calculate max sum of increasing subsequence ending at each index\n    inc_sums = list(arr)\n    for i in range(1, n):\n        for j in range(i):\n            if arr[j] < arr[i]:\n                inc_sums[i] = max(inc_sums[i], inc_sums[j] + arr[i])\n\n    # Calculate max sum of decreasing subsequence starting at each index\n    dec_sums = list(arr)\n    for i in range(n - 2, -1, -1):  # Iterate from second to last element backwards\n        for j in range(n - 1, i, -1):  # Iterate from last element down to i+1\n            if arr[j] < arr[i]:\n                dec_sums[i] = max(dec_sums[i], dec_sums[j] + arr[i])\n\n    # Combine increasing and decreasing sums to find the maximum bitonic sum\n    # Subtract arr[i] because it's counted twice (once in inc_sums[i] and once in dec_sums[i])\n    max_overall_sum = float('-inf')\n    for i in range(n):\n        max_overall_sum = max(max_overall_sum, inc_sums[i] + dec_sums[i] - arr[i])\n\n    return max_overall_sum"}
{"task_id": "Mbpp/253", "solution": "def count_integer(elements):\n    \"\"\"\n    Counts the number of integer elements in a list, excluding booleans.\n    \"\"\"\n    count = 0\n    for item in elements:\n        # Check if the item is an integer and not a boolean\n        if isinstance(item, int) and not isinstance(item, bool):\n            count += 1\n    return count"}
{"task_id": "Mbpp/255", "solution": "def combinations_colors(input_list: list, n: int) -> list[tuple]:\n    \"\"\"\n    Generates all combinations with repetition of elements from the input_list of a specified length n.\n    Returns a list of tuples, where each tuple represents a combination.\n    \"\"\"\n    import itertools\n\n    if n == 0:\n        return [()]\n\n    return [tuple(p) for p in itertools.product(input_list, repeat=n)]"}
{"task_id": "Mbpp/256", "solution": "def count_Primes_nums(n):\n    \"\"\"\n    Counts the number of prime numbers less than a given non-negative number n\n    using the Sieve of Eratosthenes algorithm.\n    \"\"\"\n    n = int(n)\n\n    if n <= 2:\n        return 0\n\n    # Initialize a boolean array 'is_prime' where is_prime[i] is True if i is potentially prime.\n    is_prime = [True] * n\n    is_prime[0] = is_prime[1] = False  # 0 and 1 are not prime numbers.\n\n    # Iterate from p = 2 up to sqrt(n).\n    # Any composite number n has a prime factor less than or equal to sqrt(n).\n    for p in range(2, int(n**0.5) + 1):\n        # If p is prime, mark all its multiples as non-prime.\n        if is_prime[p]:\n            for multiple in range(p * p, n, p):\n                is_prime[multiple] = False\n\n    # Count the number of primes (True values in is_prime) from index 2 onwards.\n    count = 0\n    for i in range(2, n):\n        if is_prime[i]:\n            count += 1\n\n    return count"}
