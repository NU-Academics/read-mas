{"task_id": "Mbpp/99", "solution": "def decimal_to_binary(n: int) -> str:\n    \"\"\"Converts a non-negative decimal integer to its binary string representation.\"\"\"\n    if n == 0:\n        return \"0\"\n\n    bits = []\n    while n > 0:\n        bits.append(\"1\" if (n & 1) else \"0\")\n        n >>= 1\n    return \"\".join(reversed(bits))"}
{"task_id": "Mbpp/98", "solution": "import math\nfrom typing import Sequence, Any, List\nclass InvalidInputError(ValueError):\n    \"\"\"Raised when input sequence contains non-numeric elements or is invalid.\"\"\"\n    pass\nclass EmptySequenceError(ValueError):\n    \"\"\"Raised when input sequence is empty.\"\"\"\n    pass\nclass InputValidator:\n    \"\"\"Validates and normalizes input sequences.\"\"\"\n    def validate_sequence(self, seq: Sequence[Any]) -> List[float]:\n        \"\"\"Validates sequence and converts elements to float.\"\"\"\n        if seq is None:\n            raise InvalidInputError(\"Sequence is None\")\n        try:\n            length = len(seq)\n        except TypeError:\n            raise InvalidInputError(\"Provided object is not a sized sequence\")\n        if length == 0:\n            raise EmptySequenceError(\"Sequence must not be empty\")\n        result = []\n        for i, v in enumerate(seq):\n            if not isinstance(v, (int, float)):\n                raise InvalidInputError(f\"Element at index {i} is not numeric: {v!r}\")\n            result.append(float(v))\n        return result\nclass MathUtils:\n    \"\"\"Provides low-level numeric routines.\"\"\"\n    DEFAULT_EPS: float = 1e-12\n\n    @staticmethod\n    def product(values: Sequence[float]) -> float:\n        \"\"\"Computes the product of values, falling back to iterative multiplication.\"\"\"\n        try:\n            return math.prod(values)\n        except AttributeError:\n            prod = 1.0\n            for v in values:\n                prod *= v\n            return prod\nclass MathService:\n    \"\"\"Core algorithm to compute product and divide by length.\"\"\"\n    def multiply_and_divide(self, values: Sequence[float]) -> float:\n        \"\"\"Computes the product of numbers and divides by the count of numbers.\"\"\"\n        if len(values) == 0:\n            raise EmptySequenceError(\"Cannot compute on empty sequence\")\n        product_result = MathUtils.product(values)\n        return product_result / float(len(values))\nclass MultiplyController:\n    \"\"\"Public API surface; orchestrates validation and service calls.\"\"\"\n    def __init__(self, validator: InputValidator = None, service: MathService = None) -> None:\n        self.validator = validator or InputValidator()\n        self.service = service or MathService()\n\n    def multiply_num(self, seq: Sequence[float|int]) -> float:\n        \"\"\"Validates input sequence and computes the product divided by its length.\"\"\"\n        validated = self.validator.validate_sequence(seq)\n        return self.service.multiply_and_divide(validated)\n_default_controller = MultiplyController()\ndef multiply_num(seq: Sequence[float|int]) -> float:\n    \"\"\"Multiplies all numbers in a list and divides by its length.\"\"\"\n    return _default_controller.multiply_num(seq)"}
{"task_id": "Mbpp/100", "solution": "def next_smallest_palindrome(n: int) -> int:\n    \"\"\"\n    Finds the next smallest palindrome of a specified integer, returned as an integer.\n    The palindrome must be strictly greater than the input integer.\n    \"\"\"\n\n    # Handle negative integers: the smallest non-negative palindrome is 0.\n    if n < 0:\n        return 0\n\n    # Helper function to mirror the left half of a string to create a palindrome.\n    def _mirror_left_to_right(s: str) -> str:\n        l = len(s)\n        left_half = s[:l // 2]\n        if l % 2 == 0:\n            return left_half + left_half[::-1]\n        else:\n            middle_char = s[l // 2]\n            return left_half + middle_char + left_half[::-1]\n\n    # Helper function to increment the \"middle\" part of a number represented as a string.\n    def _add_one_to_middle(s: str) -> str:\n        l = len(s)\n        # Calculate the length of the left part (including the middle digit for odd lengths)\n        half_len_to_inc = (l + 1) // 2\n\n        # Extract this prefix part (e.g., \"123\" from \"12345\", \"12\" from \"1234\")\n        prefix_to_inc = s[:half_len_to_inc]\n\n        # Increment the integer value of this prefix\n        incremented_prefix_val = int(prefix_to_inc) + 1\n        incremented_prefix_str = str(incremented_prefix_val)\n\n        # Handle the case where incrementing the prefix increases its digit length\n        # (e.g., \"9\" -> \"10\", \"99\" -> \"100\"). This means the resulting palindrome\n        # will have one more digit than the original number, always of the form 10...01.\n        if len(incremented_prefix_str) > half_len_to_inc:\n            return '1' + '0' * (l - 1) + '1'\n\n        # If length did not increase, construct the new string part for mirroring.\n        # It's the incremented prefix followed by zeros to match the original string's\n        # structure, ensuring `_mirror_left_to_right` can operate correctly.\n        return incremented_prefix_str + '0' * (l - len(incremented_prefix_str))\n\n\n    s = str(n)\n\n    # Special case: If the number consists of all 9s (e.g., 9, 99, 999),\n    # the next palindrome will be of the form 10...01.\n    if all(c == '9' for c in s):\n        return int('1' + '0' * (len(s) - 1) + '1')\n\n    # Step 1: Create a candidate palindrome by mirroring the left half of `s`.\n    # For example, \"12345\" -> \"12321\", \"1234\" -> \"1221\".\n    candidate_str = _mirror_left_to_right(s)\n    candidate_int = int(candidate_str)\n\n    # Step 2: If this candidate is strictly greater than `n`, it is the answer.\n    # E.g., n=123, candidate=121 (not > 123), so we need to increment.\n    # E.g., n=120, candidate=121 (is > 120), so 121 is the answer.\n    if candidate_int > n:\n        return candidate_int\n\n    # Step 3: If the candidate is not greater than `n` (i.e., it's equal or smaller),\n    # we need to increment the \"middle\" part of `s` and then form a new palindrome.\n    # This guarantees the next strictly greater palindrome.\n    s2 = _add_one_to_middle(s)\n    return int(_mirror_left_to_right(s2))"}
{"task_id": "Mbpp/101", "solution": "from typing import Sequence\ndef kth_element(array: list[int], k: int) -> int:\n    \"\"\"\n    Finds the k-th element in the given array using 1-based indexing.\n    This function acts as a facade, delegating to internal components for validation and business logic.\n    \"\"\"\n    class InvalidInputError(Exception):\n        \"\"\"Custom exception for invalid input types or formats.\"\"\"\n        def __init__(self, message: str) -> None:\n            super().__init__(message)\n\n    class OutOfBoundsError(Exception):\n        \"\"\"Custom exception for k values outside array bounds.\"\"\"\n        def __init__(self, message: str) -> None:\n            super().__init__(message)\n\n    class RepositoryError(Exception):\n        \"\"\"Custom exception for issues related to data repository operations.\"\"\"\n        def __init__(self, message: str) -> None:\n            super().__init__(message)\n\n    class KthRequest:\n        \"\"\"Data Transfer Object for a Kth element request.\"\"\"\n        def __init__(self, array: Sequence[int], k: int) -> None:\n            self.array = array\n            self.k = k\n\n    class KthResponse:\n        \"\"\"Data Transfer Object for a Kth element response.\"\"\"\n        def __init__(self, value: int) -> None:\n            self.value = value\n\n    class InputValidator:\n        \"\"\"Validates array and k inputs against predefined rules.\"\"\"\n        def validate(self, array: Sequence[int], k: int) -> None:\n            if not hasattr(array, '__iter__') or isinstance(array, (str, bytes)):\n                raise InvalidInputError(\"array must be an iterable of integers\")\n            if not isinstance(k, int):\n                raise InvalidInputError(\"k must be an integer\")\n\n            length = len(array)\n            if k < 1 or k > length:\n                raise OutOfBoundsError(f\"k={k} out of bounds for array of length {length}\")\n\n    class KthElementService:\n        \"\"\"Implements the core business logic to find the k-th element.\"\"\"\n        def __init__(self, repository=None) -> None:\n            self._repository = repository\n\n        def find_kth(self, array: Sequence[int], k: int) -> int:\n            \"\"\"Calculates and returns the k-th element from the array using 1-based indexing.\"\"\"\n            return array[k - 1]\n\n    class KthController:\n        \"\"\"Facade for programmatic usage, orchestrating validation and service calls.\"\"\"\n        def __init__(self, validator: InputValidator, service: KthElementService) -> None:\n            self._validator = validator\n            self._service = service\n\n        def handle_find_kth(self, request: KthRequest) -> KthResponse:\n            \"\"\"Validates the request, retrieves the element, and returns a response.\"\"\"\n            self._validator.validate(request.array, request.k)\n            value = self._service.find_kth(request.array, request.k)\n            return KthResponse(value)\n\n    # Initialize the components as per the design's __init__.py snippet\n    _validator_instance = InputValidator()\n    _service_instance = KthElementService()\n    _controller_instance = KthController(_validator_instance, _service_instance)\n\n    # Create request, handle with controller, and return the result\n    req = KthRequest(array, k)\n    resp = _controller_instance.handle_find_kth(req)\n    return resp.value"}
{"task_id": "Mbpp/102", "solution": "def snake_to_camel(s: str) -> str:\n    \"\"\"Converts a snake_case string to CamelCase (PascalCase).\"\"\"\n    if not s:\n        return \"\"\n\n    s = s.strip()\n    if not s:\n        return \"\"\n\n    parts = s.split(\"_\")\n    filtered_parts = [p for p in parts if p]\n\n    if not filtered_parts:\n        return \"\"\n\n    transformed_parts = []\n    for part in filtered_parts:\n        transformed_parts.append(part[0].upper() + part[1:].lower())\n\n    return \"\".join(transformed_parts)"}
{"task_id": "Mbpp/105", "solution": "def count(values):\n    \"\"\"Counts the number of True boolean values in a given iterable.\"\"\"\n    def is_bool(obj: object) -> bool:\n        \"\"\"Checks if an object is an exact boolean type.\"\"\"\n        return type(obj) is bool\n\n    class CountService:\n        def count_bools(self, values):\n            total_count = 0\n            for v in values:\n                if is_bool(v) and v is True:\n                    total_count += 1\n            return total_count\n\n    class CountController:\n        def __init__(self):\n            self._service = CountService()\n\n        def count(self, values):\n            return self._service.count_bools(values)\n\n    controller = CountController()\n    return controller.count(values)"}
