{"task_id": "Mbpp/629", "solution": "def Split(numbers: list) -> list:\n    \"\"\"\n    Return a list containing the even integers from `numbers` in their original order.\n\n    Raises:\n        TypeError: if `numbers` is not a list/tuple or any element is not an int.\n    \"\"\"\n    if not isinstance(numbers, (list, tuple)):\n        raise TypeError(\"numbers must be a list or tuple\")\n\n    result: list = []\n    for idx, value in enumerate(numbers):\n        if not isinstance(value, int):\n            raise TypeError(f\"All elements must be int; element at index {idx} is {type(value).__name__}\")\n        if value % 2 == 0:\n            result.append(value)\n    return result"}
{"task_id": "Mbpp/630", "solution": "from typing import Tuple, Optional, List\nclass Coordinate:\n    \"\"\"Represents a 2D integer coordinate.\"\"\"\n    def __init__(self, x: int, y: int) -> None:\n        self.x = x\n        self.y = y\n\n    def to_list(self) -> List[int]:\n        \"\"\"Returns the coordinate as a list [x, y].\"\"\"\n        return [self.x, self.y]\nclass CoordinateService:\n    \"\"\"Service for computing adjacent coordinates within a grid.\"\"\"\n    OFFSETS: List[int] = [-1, 0, 1]\n\n    def _apply_bounds(self, coords: List[Coordinate], bounds: Tuple[int, int, int, int]) -> List[Coordinate]:\n        \"\"\"Filters a list of coordinates to keep only those within the given bounds.\"\"\"\n        min_x, max_x, min_y, max_y = bounds\n        filtered_coords = []\n        for c in coords:\n            if min_x <= c.x <= max_x and min_y <= c.y <= max_y:\n                filtered_coords.append(c)\n        return filtered_coords\n\n    def get_neighbors(self, coord: Coordinate, bounds: Optional[Tuple[int, int, int, int]] = None) -> List[List[int]]:\n        \"\"\"\n        Computes the 3x3 neighborhood of a coordinate, optionally applying grid bounds.\n        Results are returned in row-major order.\n        \"\"\"\n        results: List[Coordinate] = []\n        for dx in self.OFFSETS:\n            for dy in self.OFFSETS:\n                c = Coordinate(coord.x + dx, coord.y + dy)\n                results.append(c)\n\n        if bounds:\n            results = self._apply_bounds(results, bounds)\n\n        return [c.to_list() for c in results]\ndef get_coordinates(coord: Tuple[int, int], bounds: Optional[Tuple[int, int, int, int]] = None) -> List[List[int]]:\n    \"\"\"\n    Extracts all adjacent coordinates of the given coordinate tuple, including itself.\n    Optionally applies bounding box constraints.\n    \"\"\"\n    x, y = coord[0], coord[1]\n    coord_obj = Coordinate(x, y)\n\n    service = CoordinateService()\n    return service.get_neighbors(coord_obj, bounds=bounds)"}
{"task_id": "Mbpp/632", "solution": "def move_zero(lst):\n    \"\"\"\n    Moves all zeroes in the given list to the end, preserving the order of non-zero elements.\n    Returns a new list with the zeroes moved.\n    \"\"\"\n    non_zero = []\n    zero_count = 0\n    for v in lst:\n        if v == 0:\n            zero_count += 1\n        else:\n            non_zero.append(v)\n    return non_zero + [0] * zero_count"}
{"task_id": "Mbpp/635", "solution": "from typing import Any\ndef heap_sort(list_: list[Any]) -> list[Any]:\n    \"\"\"Sorts a list using the heap sort algorithm.\"\"\"\n\n    class Heap:\n        \"\"\"A helper class for performing heap operations.\"\"\"\n        def __init__(self, arr: list[Any]) -> None:\n            self.arr = arr\n            self.size = len(arr)\n\n        def _left_child(self, i: int) -> int:\n            return 2 * i + 1\n\n        def _right_child(self, i: int) -> int:\n            return 2 * i + 2\n\n        def sift_down(self, start: int, end: int) -> None:\n            \"\"\"Maintains the max-heap property within a sub-array.\"\"\"\n            root = start\n            while True:\n                child = self._left_child(root)\n                if child > end:\n                    break\n                # Find the larger child\n                if child + 1 <= end and self.arr[child] < self.arr[child + 1]:\n                    child += 1\n                # If root is smaller than largest child, swap them\n                if self.arr[root] < self.arr[child]:\n                    self.arr[root], self.arr[child] = self.arr[child], self.arr[root]\n                    root = child\n                else:\n                    break\n\n        def build_max_heap(self) -> None:\n            \"\"\"Transforms the array into a max-heap.\"\"\"\n            # Start from the last non-leaf node and go up to the root\n            start = (self.size - 1 - 1) // 2\n            while start >= 0:\n                self.sift_down(start, self.size - 1)\n                start -= 1\n\n        def heap_sort_inplace(self) -> list[Any]:\n            \"\"\"Sorts the internal array in-place using heap sort.\"\"\"\n            self.build_max_heap()\n            end = self.size - 1\n            while end > 0:\n                # Move current root to end\n                self.arr[0], self.arr[end] = self.arr[end], self.arr[0]\n                # Reduce the heap size and sift down the new root\n                end -= 1\n                self.sift_down(0, end)\n            return self.arr\n\n    copy_list = list(list_)\n    return Heap(copy_list).heap_sort_inplace()"}
{"task_id": "Mbpp/633", "solution": "def pair_xor_Sum(nums, n):\n    \"\"\"\n    Finds the sum of XOR of all pairs of numbers in the given list.\n    The algorithm iterates through bits and sums contributions from pairs where bits differ.\n    \"\"\"\n    actual_n = len(nums)\n\n    if actual_n < 2:\n        return 0\n\n    total_xor_sum = 0\n    # Use a default bit width of 32 for normalization, as per design context.\n    bit_width = 32\n\n    # Helper function to normalize an integer to its unsigned representation\n    # within the specified bit_width (two's complement for negative numbers).\n    def _normalize_to_unsigned(value: int) -> int:\n        mask = (1 << bit_width) - 1\n        return value & mask\n\n    for bit_pos in range(bit_width):\n        ones_count = 0\n        for num in nums:\n            # Normalize each number to its unsigned value before checking the bit.\n            unsigned_num = _normalize_to_unsigned(num)\n            if (unsigned_num >> bit_pos) & 1:\n                ones_count += 1\n\n        zeros_count = actual_n - ones_count\n        # Each pair with differing bits at `bit_pos` contributes 2^`bit_pos` to the total XOR sum.\n        total_xor_sum += ones_count * zeros_count * (1 << bit_pos)\n\n    return total_xor_sum"}
{"task_id": "Mbpp/639", "solution": "def sample_nam(names: list[str]) -> int:\n    \"\"\"\n    Sums the length of names after removing those starting with a lowercase letter.\n    Names that are empty or start with a lowercase letter are excluded from the sum.\n    \"\"\"\n    total_length = 0\n    for name in names:\n        # Check if the name is not empty and its first character is not lowercase.\n        # Empty strings are skipped, and names starting with uppercase, digits, or symbols are included.\n        if name and not name[0].islower():\n            total_length += len(name)\n    return total_length"}
