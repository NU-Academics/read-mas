{"task_id": "Mbpp/391", "solution": "from typing import Any, Sequence, List, Dict\ndef convert_list_dictionary(*lists: Sequence[Any]) -> List[Dict[Any, Any]]:\n    \"\"\"\n    Converts multiple parallel lists into a list of nested dictionaries.\n    The first list provides outermost keys, and the last list provides leaf values.\n    \"\"\"\n    if not lists:\n        return []\n\n    # Basic validation: at least two lists and equal non-zero lengths\n    if len(lists) < 2:\n        raise ValueError(\"At least two lists are required.\")\n    lengths = [len(lst) for lst in lists]\n    if any(l is None for l in lengths):\n        raise ValueError(\"All inputs must be sequences.\")\n    if any(l == 0 for l in lengths):\n        raise ValueError(\"Lists must not be empty.\")\n    if len(set(lengths)) != 1:\n        raise ValueError(\"All lists must have the same length.\")\n\n    num_lists = len(lists)\n    list_length = lengths[0]\n\n    result: List[Dict[Any, Any]] = []\n    for i in range(list_length):\n        current_nested: Any = lists[-1][i]  # leaf value\n        # build nested dict from the end towards the first list\n        for j in range(num_lists - 2, -1, -1):\n            key = lists[j][i]\n            current_nested = {key: current_nested}\n        result.append(current_nested)\n\n    return result"}
{"task_id": "Mbpp/389", "solution": "from typing import Optional\nclass LucasRepository:\n    \"\"\"\n    Manages caching of computed Lucas numbers.\n    Initializes with base cases L0=2 and L1=1.\n    \"\"\"\n    def __init__(self) -> None:\n        self._cache: dict[int, int] = {0: 2, 1: 1}\n\n    def get(self, n: int) -> Optional[int]:\n        \"\"\"Retrieves a Lucas number from the cache.\"\"\"\n        return self._cache.get(n)\n\n    def set(self, n: int, value: int) -> None:\n        \"\"\"Stores a computed Lucas number in the cache.\"\"\"\n        self._cache[n] = value\nclass LucasService:\n    \"\"\"\n    Provides the core logic for computing Lucas numbers, utilizing a repository for caching.\n    \"\"\"\n    def __init__(self, repo: LucasRepository) -> None:\n        self.repo = repo\n\n    def compute(self, n: int) -> int:\n        \"\"\"\n        Computes the n'th Lucas number, checking the cache first.\n        If not cached, it computes iteratively and stores the result.\n        \"\"\"\n        cached = self.repo.get(n)\n        if cached is not None:\n            return cached\n\n        value = self._compute_iterative(n)\n        self.repo.set(n, value)\n        return value\n\n    def _compute_iterative(self, n: int) -> int:\n        \"\"\"\n        Computes the n'th Lucas number iteratively.\n        Assumes n is a non-negative integer.\n        \"\"\"\n        if n == 0:\n            return 2\n        if n == 1:\n            return 1\n\n        a, b = 2, 1  # L0, L1\n        for _ in range(2, n + 1):\n            a, b = b, a + b  # Update a to L_{i-1} and b to L_i\n        return b\nclass LucasController:\n    \"\"\"\n    Acts as the public API entry point, delegating computation to the LucasService.\n    \"\"\"\n    def __init__(self, service: LucasService) -> None:\n        self.service = service\n\n    def find_lucas(self, n: int) -> int:\n        \"\"\"\n        Finds the n'th Lucas number.\n        It is assumed that n is a non-negative integer.\n        \"\"\"\n        return self.service.compute(n)\n_repo = LucasRepository()\n_service = LucasService(_repo)\n_controller = LucasController(_service)\ndef find_lucas(n: int) -> int:\n    \"\"\"\n    Finds the n'th Lucas number using a cached, iterative approach.\n    The Lucas sequence starts L0 = 2, L1 = 1, and L_n = L_{n-1} + L_{n-2} for n >= 2.\n    \"\"\"\n    return _controller.find_lucas(n)"}
{"task_id": "Mbpp/390", "solution": "from typing import Any, List, Callable\nfrom collections.abc import Iterable\nclass ValidationError(Exception):\n    \"\"\"Exception raised for invalid input parameters.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\nclass FormatError(Exception):\n    \"\"\"Exception raised when applying a format string to an element fails.\"\"\"\n    def __init__(self, message: str, index: int=None, value: Any=None) -> None:\n        super().__init__(message)\n        self.message = message\n        self.index = index\n        self.value = value\nclass FormatRequest:\n    \"\"\"Data transfer object for a formatting request.\"\"\"\n    def __init__(self, items: List[Any], fmt: str) -> None:\n        self.items: List[Any] = items\n        self.fmt: str = fmt\nclass FormatResult:\n    \"\"\"Data transfer object for the result of a formatting operation.\"\"\"\n    def __init__(self, results: List[str]) -> None:\n        self.results: List[str] = results\ndef safe_format(template: str, value: Any) -> str:\n    \"\"\"Applies the format template to a value, catching common formatting errors.\"\"\"\n    try:\n        return template.format(value)\n    except (IndexError, KeyError, ValueError, TypeError) as e:\n        raise FormatError(str(e), index=None, value=value)\nclass ListValidator:\n    \"\"\"Validates the input request for the list formatter.\"\"\"\n    def validate(self, request: FormatRequest) -> None:\n        \"\"\"Ensures the format string is non-empty and items is an iterable.\"\"\"\n        if request is None:\n            raise ValidationError(\"Request is None\")\n        if not isinstance(request.fmt, str) or request.fmt.strip() == \"\":\n            raise ValidationError(\"Format string must be a non-empty string\")\n        if not isinstance(request.items, Iterable):\n            raise ValidationError(\"items must be an iterable (e.g., list)\")\nclass FormatterService:\n    \"\"\"Core business logic to format list elements using a formatter.\"\"\"\n    def __init__(self, formatter: Callable[[str, object], str] = None) -> None:\n        self._formatter = formatter or safe_format\n\n    def format(self, request: FormatRequest) -> FormatResult:\n        \"\"\"Iterates through the items, applies the format, and collects results.\"\"\"\n        results = []\n        for idx, val in enumerate(request.items):\n            try:\n                # _format_one just calls self._formatter, but the design specified it.\n                # In this flattened context, it's essentially self._formatter directly.\n                results.append(self._formatter(request.fmt, val))\n            except FormatError as fe:\n                # Enrich and re-raise with index/value from the current element.\n                raise FormatError(fe.message, index=idx, value=val) from fe\n        return FormatResult(results)\nclass FormatterController:\n    \"\"\"Public API controller that orchestrates validation and formatting services.\"\"\"\n    def __init__(self, validator: ListValidator = None, service: FormatterService = None) -> None:\n        self._validator = validator or ListValidator()\n        self._service = service or FormatterService()\n\n    def add_string(self, items: list, fmt: str) -> list[str]:\n        \"\"\"Validates inputs and applies the format string to all elements in the list.\"\"\"\n        request = FormatRequest(items, fmt)\n        self._validator.validate(request)\n        result = self._service.format(request)\n        return result.results\n_default_controller = FormatterController()\ndef add_string(items: list, format_str: str) -> list[str]:\n    \"\"\"Applies a given format string to all elements in a list.\n    Returns a new list of strings where each element is formatted by the provided template.\n    \"\"\"\n    return _default_controller.add_string(items, format_str)"}
{"task_id": "Mbpp/394", "solution": "def check_distinct(tup: tuple) -> bool:\n    \"\"\"\n    Return True if the given tuple contains no duplicate elements, False otherwise.\n\n    Raises:\n        TypeError: if the provided argument is not a tuple.\n    \"\"\"\n    if not isinstance(tup, tuple):\n        raise TypeError(\"input must be a tuple\")\n\n    seen = set()             # stores hashable items we've seen\n    unhashables = []         # stores unhashable items we've seen\n\n    for item in tup:\n        try:\n            # Fast path for hashable items\n            if item in seen:\n                return False\n            seen.add(item)\n        except TypeError:\n            # item is unhashable: compare against all previously seen items\n            # Check equality with hashable items\n            for h in seen:\n                if item == h:\n                    return False\n            # Check equality with previous unhashable items\n            for u in unhashables:\n                if item == u:\n                    return False\n            unhashables.append(item)\n\n    return True"}
{"task_id": "Mbpp/392", "solution": "def get_max_sum(n: int) -> int:\n    \"\"\"\n    Computes the maximum sum for a given integer n using memoization.\n    The function applies the rule f(n) = max( (f(n/2) + f(n/3) + f(n/4) + f(n/5)), n).\n    \"\"\"\n    memo = {}\n\n    def _compute(k: int) -> int:\n        if k == 0:\n            return 0\n        if k in memo:\n            return memo[k]\n\n        sum_parts = (\n            _compute(k // 2)\n            + _compute(k // 3)\n            + _compute(k // 4)\n            + _compute(k // 5)\n        )\n        result = max(k, sum_parts)\n        memo[k] = result\n        return result\n\n    return _compute(n)"}
{"task_id": "Mbpp/395", "solution": "def first_non_repeating_character(s):\n    \"\"\"\n    Return the first non-repeated character in the string `s`, or None if none exists.\n    Raises TypeError if `s` is not a str.\n    \"\"\"\n    if not isinstance(s, str):\n        raise TypeError(f\"Expected str, got {type(s).__name__}\")\n\n    counts = {}\n    for ch in s:\n        counts[ch] = counts.get(ch, 0) + 1\n\n    for ch in s:\n        if counts.get(ch, 0) == 1:\n            return ch\n\n    return None"}
{"task_id": "Mbpp/397", "solution": "def median_numbers(a, b, c) -> float:\n    \"\"\"\n    Finds the median of three numbers using direct comparison.\n    Assumes inputs are numeric and comparable.\n    \"\"\"\n    if (a <= b <= c) or (c <= b <= a):\n        return float(b)\n    if (b <= a <= c) or (c <= a <= b):\n        return float(a)\n    return float(c)"}
