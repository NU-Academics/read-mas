{"task_id": "Mbpp/643", "solution": "import re\ndef text_match_wordz_middle(text: str) -> bool:\n    \"\"\"\n    Checks if the input text contains any word with 'z' (case-insensitive)\n    strictly in the middle (not at the start or end).\n    \"\"\"\n    # Tokenize the text into words using a regular expression that matches\n    # sequences of Unicode word characters (letters, digits, underscore).\n    word_pattern = r\"\\b\\w+\\b\"\n    compiled_pattern = re.compile(word_pattern, flags=re.UNICODE)\n    words = compiled_pattern.findall(text)\n\n    # For each extracted word, check if it contains a 'z' in the middle.\n    for word in words:\n        # Words shorter than 3 characters cannot have a middle 'z'.\n        if len(word) < 3:\n            continue\n\n        # Convert the word to lowercase for case-insensitive comparison.\n        word_lower = word.lower()\n\n        # Check characters from the second position (index 1) up to, but not including,\n        # the last position (index len-1) for the character 'z'.\n        if 'z' in word_lower[1:-1]:\n            return True  # A qualifying 'z' was found in this word.\n\n    # If no word with a middle 'z' was found after checking all words.\n    return False"}
{"task_id": "Mbpp/721", "solution": "def maxAverageOfPath(grid: list[list[float]]) -> float:\n    \"\"\"\n    Computes the maximum average cost over all valid paths from top-left to bottom-right.\n    A path only moves right or down, and its length is fixed at (2*N - 1) cells.\n    \"\"\"\n    n = len(grid)\n\n    # dp[i][j] will store the maximum sum of costs to reach cell (i, j)\n    dp = [[0.0] * n for _ in range(n)]\n\n    # Initialize the top-left cell\n    dp[0][0] = grid[0][0]\n\n    # Fill the first row (only moves right are possible)\n    for j in range(1, n):\n        dp[0][j] = dp[0][j-1] + grid[0][j]\n\n    # Fill the first column (only moves down are possible)\n    for i in range(1, n):\n        dp[i][0] = dp[i-1][0] + grid[i][0]\n\n    # Fill the rest of the DP table\n    for i in range(1, n):\n        for j in range(1, n):\n            # To reach (i, j), we must come from (i-1, j) or (i, j-1).\n            # We choose the path that yields the maximum sum up to this cell.\n            dp[i][j] = max(dp[i-1][j], dp[i][j-1]) + grid[i][j]\n\n    # The maximum sum path ends at the bottom-right cell\n    max_total_cost = dp[n-1][n-1]\n\n    # The number of cells visited in any path from top-left to bottom-right\n    # in an N x N grid is always (2*N - 1).\n    path_length = (2 * n) - 1\n\n    # Calculate the maximum average\n    return max_total_cost / path_length"}
{"task_id": "Mbpp/722", "solution": "import abc\nfrom dataclasses import dataclass\nfrom typing import Dict, Tuple, Any\nclass StudentRepository(abc.ABC):\n    \"\"\"Abstract base class for a student repository.\"\"\"\n    @abc.abstractmethod\n    def get_all(self) -> Dict[str, Student]:\n        \"\"\"Returns a dictionary of all students.\"\"\"\n        pass\nclass InMemoryStudentRepository(StudentRepository):\n    \"\"\"An in-memory implementation of the StudentRepository.\"\"\"\n    def __init__(self, data: Dict[str, Tuple[float, float]]) -> None:\n        # Assumes data is pre-validated by the API layer, converting directly to Student objects.\n        self._students: Dict[str, Student] = {\n            name: Student(name, float(height), float(weight))\n            for name, (height, weight) in data.items()\n        }\n\n    def get_all(self) -> Dict[str, Student]:\n        \"\"\"Returns a shallow copy of the internal student mapping.\"\"\"\n        return self._students.copy()\nclass StudentFilterService:\n    \"\"\"Business logic for filtering students based on criteria.\"\"\"\n    def __init__(self, repo: StudentRepository) -> None:\n        self._repo = repo\n\n    def filter_by_criteria(self, criteria: FilterCriteria) -> Dict[str, Student]:\n        \"\"\"Filters students from the repository based on height and weight criteria.\"\"\"\n        all_students = self._repo.get_all()\n        filtered: Dict[str, Student] = {}\n        for name, student in all_students.items():\n            if student.height >= criteria.min_height and student.weight >= criteria.min_weight:\n                filtered[name] = student\n        return filtered\ndef filter_data(students: Dict[str, Tuple[float, float]], min_height: float, min_weight: float) -> Dict[str, Tuple[float, float]]:\n    \"\"\"Filters a dictionary of students by minimum height and weight thresholds.\n    This function validates inputs, processes students, and returns filtered data.\"\"\"\n    validate_students_input(students, min_height, min_weight)\n    repo = InMemoryStudentRepository(students)\n    service = StudentFilterService(repo)\n    criteria = FilterCriteria(min_height, min_weight)\n    result = service.filter_by_criteria(criteria)\n    return {name: student.to_tuple() for name, student in result.items()}"}
