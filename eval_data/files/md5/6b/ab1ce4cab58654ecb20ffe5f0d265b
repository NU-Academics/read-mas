{"task_id": "Mbpp/409", "solution": "def min_product_tuple(pairs):\n    \"\"\"\n    Calculates the minimum product from a list of 2-element tuples.\n    Raises:\n      - TypeError if pairs is not iterable.\n      - ValueError if pairs is empty or any item is not a 2-element iterable of integers.\n    \"\"\"\n    if not isinstance(pairs, (list, tuple)):\n        raise TypeError(\"pairs must be a list or tuple of 2-element tuples/lists\")\n\n    if len(pairs) == 0:\n        raise ValueError(\"pairs must be a non-empty list or tuple\")\n\n    min_prod = None\n    for idx, item in enumerate(pairs):\n        if not isinstance(item, (list, tuple)) or len(item) != 2:\n            raise ValueError(f\"each item must be a 2-element tuple/list (error at index {idx})\")\n        a, b = item\n        # validate numeric types (allow ints and integral floats)\n        if isinstance(a, float):\n            if not a.is_integer():\n                raise ValueError(f\"pair element at index {idx}[0] is not an integer-compatible value: {a!r}\")\n            a = int(a)\n        elif not isinstance(a, int):\n            try:\n                a = int(a)\n            except Exception:\n                raise ValueError(f\"pair element at index {idx}[0] is not integer-convertible: {a!r}\")\n\n        if isinstance(b, float):\n            if not b.is_integer():\n                raise ValueError(f\"pair element at index {idx}[1] is not an integer-compatible value: {b!r}\")\n            b = int(b)\n        elif not isinstance(b, int):\n            try:\n                b = int(b)\n            except Exception:\n                raise ValueError(f\"pair element at index {idx}[1] is not integer-convertible: {b!r}\")\n\n        prod = a * b\n        if min_prod is None or prod < min_prod:\n            min_prod = prod\n\n    return min_prod"}
{"task_id": "Mbpp/406", "solution": "def find_Parity(n: int) -> bool:\n    \"\"\"\n    Determines if the parity of a given integer `n` is odd.\n    Returns True if `n` is odd, False otherwise.\n    \"\"\"\n\n    class Number:\n        \"\"\"Domain model for an integer value.\"\"\"\n        def __init__(self, value: int) -> None:\n            self.value = value\n\n        def __repr__(self) -> str:\n            return f\"Number({self.value})\"\n\n\n    class ParityResult:\n        \"\"\"Domain model for the result of a parity check.\"\"\"\n        def __init__(self, is_odd: bool) -> None:\n            self.is_odd = is_odd\n\n        def __repr__(self) -> str:\n            return f\"ParityResult(is_odd={self.is_odd})\"\n\n\n    class ParityService:\n        \"\"\"Business logic for parity computation.\"\"\"\n        def is_odd(self, number: Number) -> ParityResult:\n            is_odd_val = self.compute(number.value)\n            return ParityResult(is_odd_val)\n\n        @staticmethod\n        def compute(n_val: int) -> bool:\n            \"\"\"Determines if an integer is odd using a bitwise operation.\"\"\"\n            return (n_val & 1) != 0\n\n\n    class ParityAPI:\n        \"\"\"API wrapper for parity calculations.\"\"\"\n        def __init__(self, service: ParityService = None) -> None:\n            self.service = service or ParityService()\n\n        def find_parity(self, n_api: int) -> bool:\n            \"\"\"Determines parity of an integer, assuming valid int input.\"\"\"\n            number = Number(n_api)\n            result = self.service.is_odd(number)\n            return result.is_odd\n\n    return ParityAPI().find_parity(n)"}
{"task_id": "Mbpp/412", "solution": "def remove_odd(numbers: list[int]) -> list[int]:\n    \"\"\"Removes odd numbers from a list, returning a new list with only even numbers.\"\"\"\n    return [n for n in numbers if (n % 2) == 0]"}
{"task_id": "Mbpp/410", "solution": "import math\nfrom typing import Any, Iterable, Iterator, Optional, Union\nclass InvalidInputError(ValueError):\n    \"\"\"Exception raised for invalid input to the min_val function.\"\"\"\n    pass\nclass NoNumericItemsError(ValueError):\n    \"\"\"Exception raised when no numeric items are found in the input.\"\"\"\n    pass\nclass Config:\n    \"\"\"Central configuration for the minfinder package.\"\"\"\n    DEFAULT_ALLOW_NESTED: bool = False\n    IGNORE_NAN: bool = True\n    ALLOW_BOOL_AS_NUMBER: bool = False\nclass InputValidator:\n    \"\"\"Validates the input iterable.\"\"\"\n    def validate_iterable(self, items: Any) -> Iterable:\n        \"\"\"Ensures the input is an iterable and not a string.\"\"\"\n        if not isinstance(items, Iterable):\n            raise InvalidInputError(\"Input must be an iterable.\")\n        if isinstance(items, str):\n            raise InvalidInputError(\"Input cannot be a string directly; wrap single strings in a list if intended as item.\")\n        return items\nclass TypeCoercer:\n    \"\"\"Attempts to convert values to numbers.\"\"\"\n    def coerce_to_number(self, value: Any) -> Optional[Union[int, float]]:\n        \"\"\"Converts a value to int or float if possible, otherwise returns None.\"\"\"\n        if isinstance(value, bool):\n            # Booleans are explicitly not considered numeric by default\n            return None\n        if isinstance(value, (int, float)):\n            return value\n        if isinstance(value, str):\n            s = value.strip()\n            if s.lower() == \"nan\":\n                return float(\"nan\")\n            try:\n                # Prioritize float if it contains a decimal or exponent, else try int\n                if '.' in s or 'e' in s.lower():\n                    return float(s)\n                return int(s)\n            except ValueError:\n                # If int conversion fails, try float as a fallback\n                try:\n                    return float(s)\n                except ValueError:\n                    return None\n        return None\n\n    def is_nan(self, value: Union[int, float]) -> bool:\n        \"\"\"Checks if a numeric value is NaN.\"\"\"\n        return isinstance(value, float) and math.isnan(value)\nclass ListRepository:\n    \"\"\"Provides an iterator over the input items, with optional flattening.\"\"\"\n    def read_items(self, items: Iterable, allow_nested: bool = False) -> Iterator[Any]:\n        \"\"\"Yields items from the iterable, optionally flattening one level of nested iterables.\"\"\"\n        if allow_nested:\n            for item in items:\n                # Flatten one level for list, tuple, set, but not strings\n                if isinstance(item, (list, tuple, set)) and not isinstance(item, str):\n                    yield from item\n                else:\n                    yield item\n        else:\n            yield from items\nclass MinFinderService:\n    \"\"\"Core logic to find the minimum numeric value.\"\"\"\n    def __init__(self, repo: 'ListRepository', validator: 'InputValidator', coercer: 'TypeCoercer', config_module: Any) -> None:\n        \"\"\"Initializes the service with injected dependencies.\"\"\"\n        self.repo = repo\n        self.validator = validator\n        self.coercer = coercer\n        self.config = config_module\n\n    def find_min(self, items: Iterable, allow_nested: bool = False) -> Union[int, float]:\n        \"\"\"Finds the minimum numeric value in the given iterable.\"\"\"\n        validated_items = self.validator.validate_iterable(items)\n        current_min: Optional[Union[int, float]] = None\n\n        for item in self.repo.read_items(validated_items, allow_nested=allow_nested):\n            n = self.coercer.coerce_to_number(item)\n            if n is None:\n                continue\n            if self.config.IGNORE_NAN and self.coercer.is_nan(n):\n                continue\n\n            if current_min is None or n < current_min:\n                current_min = n\n\n        if current_min is None:\n            raise NoNumericItemsError(\"No numeric items found\")\n\n        # Preserve int type if the minimum float value is an exact integer\n        if isinstance(current_min, float) and current_min.is_integer():\n            return int(current_min)\n        return current_min\ndef min_val(items: Iterable, *, allow_nested: bool = Config.DEFAULT_ALLOW_NESTED) -> Union[int, float]:\n    \"\"\"\n    Finds the minimum numeric value in a heterogeneous list.\n    Non-numeric items and NaNs are ignored.\n    \"\"\"\n    repo = ListRepository()\n    validator = InputValidator()\n    coercer = TypeCoercer()\n    service = MinFinderService(repo, validator, coercer, Config) # Pass Config class as module-like object\n    return service.find_min(items, allow_nested=allow_nested)"}
{"task_id": "Mbpp/413", "solution": "class InvalidInputError(Exception):\n    \"\"\"Raised when the input list or its elements are invalid.\"\"\"\n    pass\nclass InvalidIndexError(Exception):\n    \"\"\"Raised when an index is out of bounds for an element in strict mode.\"\"\"\n    pass\ndef extract_nth_element(tuple_list, n, *, strict=True):\n    \"\"\"Extracts the nth element from each tuple in a list of tuples, applying strictness for missing indices.\"\"\"\n\n    result = []\n    for i, item in enumerate(tuple_list):\n        try:\n            result.append(item[n])\n        except IndexError:\n            if strict:\n                raise InvalidIndexError(f\"Tuple at index {i} has no element at index {n}.\")\n        except TypeError:\n            # This handles cases where 'item' is not indexable or 'n' is not a valid index type.\n            if strict:\n                raise InvalidInputError(f\"Element at index {i} is not correctly indexable with integer {n}.\")\n    return result"}
{"task_id": "Mbpp/418", "solution": "def Find_Max(items):\n    \"\"\"\n    Return the element from the iterable `items` that has the maximum length.\n    Tie-breaker: first encountered element with the maximum length is returned.\n\n    Raises:\n        TypeError: if `items` is not iterable or an element does not support len().\n        ValueError: if `items` is empty.\n    \"\"\"\n    try:\n        iterator = iter(items)\n    except TypeError:\n        raise TypeError(\"Find_Max() expected an iterable\")\n\n    max_item = None\n    max_len = -1\n    found = False\n\n    for elem in iterator:\n        try:\n            l = len(elem)\n        except TypeError:\n            raise TypeError(\"elements of the iterable must have a length (support len())\")\n        if not found or l > max_len:\n            max_item = elem\n            max_len = l\n            found = True\n\n    if not found:\n        raise ValueError(\"Find_Max() arg is an empty iterable\")\n\n    return max_item"}
{"task_id": "Mbpp/415", "solution": "def max_Product(nums):\n    nums_list = list(nums)\n    if len(nums_list) < 2:\n        raise ValueError(\"Need at least two integers\")\n\n    for x in nums_list:\n        if not isinstance(x, int):\n            raise ValueError(\"All items must be integers\")\n\n    # Initialize using first two elements to avoid sentinel values\n    a0, a1 = nums_list[0], nums_list[1]\n    if a0 >= a1:\n        max1, max2 = a0, a1\n    else:\n        max1, max2 = a1, a0\n\n    if a0 <= a1:\n        min1, min2 = a0, a1\n    else:\n        min1, min2 = a1, a0\n\n    for x in nums_list[2:]:\n        # update maxes\n        if x > max1:\n            max2 = max1\n            max1 = x\n        elif x > max2:\n            max2 = x\n\n        # update mins\n        if x < min1:\n            min2 = min1\n            min1 = x\n        elif x < min2:\n            min2 = x\n\n    candidate1 = (min(max1, max2), max(max1, max2))  # pair from two largest\n    candidate2 = (min(min1, min2), max(min1, min2))  # pair from two smallest\n\n    prod_max = max1 * max2\n    prod_min = min1 * min2\n\n    if prod_max > prod_min:\n        return candidate1\n    if prod_min > prod_max:\n        return candidate2\n\n    # tie-breaker: prefer larger max element, then larger min element\n    if candidate1[1] > candidate2[1]:\n        return candidate1\n    if candidate2[1] > candidate1[1]:\n        return candidate2\n    return candidate1 if candidate1[0] >= candidate2[0] else candidate2"}
{"task_id": "Mbpp/414", "solution": "from typing import Iterable, Any, Optional\nclass OverlapError(Exception):\n    def __init__(self, message: str, cause: Optional[Exception] = None) -> None:\n        super().__init__(message)\n        self.cause = cause\nclass SetAdapter:\n    def detect(self, a: Iterable[Any], b: Iterable[Any]) -> Optional[bool]:\n        try:\n            la = list(a)\n            lb = list(b)\n        except TypeError as e:\n            # Not iterable\n            raise OverlapError(\"One of the inputs is not iterable\", e)\n\n        # choose smaller to build set\n        if len(la) <= len(lb):\n            small, big = la, lb\n        else:\n            small, big = lb, la\n\n        try:\n            s = set(small)\n        except TypeError:\n            # unhashable elements present\n            return None\n\n        for item in big:\n            if item in s:\n                return True\n        return False\nclass ScannerAdapter:\n    def detect(self, a: Iterable[Any], b: Iterable[Any]) -> bool:\n        try:\n            la = list(a)\n            lb = list(b)\n        except TypeError as e:\n            raise OverlapError(\"One of the inputs is not iterable\", e)\n\n        for x in la:\n            for y in lb:\n                if x == y:\n                    return True\n        return False\nclass OverlapService:\n    def __init__(\n        self,\n        set_adapter: Optional[SetAdapter] = None,\n        scanner_adapter: Optional[ScannerAdapter] = None,\n    ) -> None:\n        self.set_adapter = set_adapter or SetAdapter()\n        self.scanner_adapter = scanner_adapter or ScannerAdapter()\n\n    def detect_overlap(self, a: Iterable[Any], b: Iterable[Any]) -> bool:\n        # Validate iterability by attempting to obtain an iterator\n        try:\n            iter(a)\n            iter(b)\n        except TypeError as e:\n            raise OverlapError(\"Both inputs must be iterable\", e)\n\n        # Try fast path\n        result = self.set_adapter.detect(a, b)\n        if result is not None:\n            return result\n        # Fallback scanner\n        return self.scanner_adapter.detect(a, b)\n_service = OverlapService()\ndef overlapping(a, b):\n    \"\"\"\n    Checks if two sequences share any common value.\n    Example:\n        overlapping([1,2,3,4,5], [6,7,8,9]) -> False\n    \"\"\"\n    return _service.detect_overlap(a, b)"}
{"task_id": "Mbpp/420", "solution": "def cube_Sum(n):\n    \"\"\"\n    Calculates the cube sum of the first n even natural numbers using a closed-form formula.\n    The formula used is 2 * n^2 * (n+1)^2.\n\n    Example:\n        cube_Sum(2) -> (2^3 + 4^3) = 8 + 64 = 72\n    \"\"\"\n    return 2 * n * n * (n + 1) * (n + 1)"}
{"task_id": "Mbpp/419", "solution": "def round_and_sum(numbers: list[float]) -> int:\n    \"\"\"\n    Rounds each number in a list, sums the rounded values, and multiplies by the list's length.\n    Uses Python's built-in round() for rounding semantics.\n    \"\"\"\n    total_rounded_sum = 0\n    for num in numbers:\n        total_rounded_sum += round(num)\n\n    list_length = len(numbers)\n\n    return int(total_rounded_sum * list_length)"}
