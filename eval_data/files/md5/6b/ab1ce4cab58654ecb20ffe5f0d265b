{"task_id": "Mbpp/7", "solution": "def find_char_long(text):\n    \"\"\"\n    Finds all words in a string that are at least 4 characters long.\n    Words are tokenized by word boundaries; original casing is preserved.\n    \"\"\"\n    import re\n    if not isinstance(text, str):\n        raise TypeError(\"text must be a str\")\n    # \\b\\w+\\b matches word tokens (letters, digits, underscore). This treats \"don't\" as two tokens (don, t).\n    # If preserving contractions as single tokens is desired, the pattern can be adjusted.\n    words = re.findall(r'\\b\\w+\\b', text)\n    return {word for word in words if len(word) >= 4}"}
{"task_id": "Mbpp/4", "solution": "def heap_queue_largest(numbers: list, n: int) -> list:\n    \"\"\"\n    Finds the n largest integers from a list and returns them in descending order.\n    It uses a min-heap of capacity n to efficiently track the largest elements.\n    \"\"\"\n    if n <= 0:\n        return []\n\n    import heapq\n\n    # Initialize a min-heap to store the 'n' largest elements encountered so far.\n    min_heap = []\n\n    for num in numbers:\n        if len(min_heap) < n:\n            # If the heap has fewer than 'n' elements, simply add the current number.\n            heapq.heappush(min_heap, num)\n        elif num > min_heap[0]:\n            # If the heap is full and the current number is greater than the smallest in heap,\n            # replace the smallest with the current number.\n            heapq.heapreplace(min_heap, num)\n\n    # The min_heap now contains the n largest elements.\n    # Sort them in descending order to meet the requirement.\n    return sorted(min_heap, reverse=True)"}
{"task_id": "Mbpp/8", "solution": "from typing import List, Iterable, Any, Optional, Iterator, Dict\ndef square_nums(numbers: Iterable[float | int]) -> List[float | int]:\n    \"\"\"\n    Finds squares of individual elements in a list using an internal architecture.\n    Orchestrates validation and computation services to produce squared numbers.\n    \"\"\"\n\n    class ValidationError(Exception):\n        \"\"\"Custom exception for validation errors.\"\"\"\n        def __init__(self, message: str) -> None:\n            self.message = message\n            super().__init__(message)\n\n    class NumberList:\n        \"\"\"Encapsulates a list of numbers for domain representation.\"\"\"\n        def __init__(self, numbers: List[float | int]) -> None:\n            self._numbers = list(numbers) # Defensive copy\n\n        def __len__(self) -> int:\n            return len(self._numbers)\n\n        def __iter__(self) -> Iterator[float | int]:\n            return iter(self._numbers)\n\n        @property\n        def numbers(self) -> List[float | int]:\n            return self._numbers\n\n    class SquareResult:\n        \"\"\"Holds the input NumberList and its computed squares.\"\"\"\n        def __init__(self, input_list: NumberList, squares: List[float | int]) -> None:\n            self.input = input_list\n            self.squares = squares\n\n        def to_dict(self) -> Dict[str, Any]:\n            return {\n                \"input\": self.input.numbers,\n                \"squares\": self.squares\n            }\n\n    class Validator:\n        \"\"\"Validates inputs to ensure they are iterables of supported number types.\"\"\"\n        SUPPORTED_NUMBER_TYPES = (int, float)\n\n        def validate_iterable_of_numbers(self, value: Any) -> List[float | int]:\n            \"\"\"Ensures the value is an iterable containing only numbers.\"\"\"\n            if value is None:\n                raise ValidationError(\"Input is None\")\n            try:\n                items = list(value)\n            except TypeError:\n                raise ValidationError(\"Input is not iterable\")\n            for i, el in enumerate(items):\n                if not isinstance(el, self.SUPPORTED_NUMBER_TYPES):\n                    raise ValidationError(f\"Element at index {i} is not a number: {el!r}\")\n            return items\n\n    class SquareService:\n        \"\"\"Performs the core business logic of squaring numbers.\"\"\"\n        def compute(self, numbers: List[float | int]) -> List[float | int]:\n            \"\"\"Returns a new list with each number squared.\"\"\"\n            return [x * x for x in numbers]\n\n    class SquareController:\n        \"\"\"Orchestrates input validation, computation, and result packaging.\"\"\"\n        def __init__(self, service: SquareService, validator: Validator, repository: Optional[Any]=None) -> None:\n            self._service = service\n            self._validator = validator\n            self._repository = repository\n\n        def compute_and_return(self, numbers_input: Iterable[float | int]) -> SquareResult:\n            \"\"\"Validates input, computes squares, and returns a SquareResult object.\"\"\"\n            validated_list_raw = self._validator.validate_iterable_of_numbers(numbers_input)\n            input_number_list = NumberList(validated_list_raw)\n            squares_list = self._service.compute(input_number_list.numbers)\n            result = SquareResult(input_number_list, squares_list)\n            return result\n\n    validator = Validator()\n    service = SquareService()\n    controller = SquareController(service=service, validator=validator)\n\n    result = controller.compute_and_return(numbers)\n    return result.squares"}
{"task_id": "Mbpp/3", "solution": "_SMALL_PRIMES = (2, 3, 5, 7, 11, 13)\ndef _is_prime(n: int) -> bool:\n    \"\"\"Checks if a number is prime using an optimized trial division algorithm.\"\"\"\n    if n <= 1:\n        return False\n    if n in _SMALL_PRIMES:\n        return True\n    if n % 2 == 0 or n % 3 == 0:\n        return False\n    i = 5\n    while i * i <= n:\n        if n % i == 0 or n % (i + 2) == 0:\n            return False\n        i += 6\n    return True\ndef is_not_prime(n: int) -> bool:\n    \"\"\"Identifies non-prime numbers, returning True for non-primes and False for primes.\"\"\"\n    return not _is_prime(n)"}
{"task_id": "Mbpp/6", "solution": "def differ_At_One_Bit_Pos(a: int, b: int) -> bool:\n    \"\"\"\n    Checks if two integers differ at exactly one bit position.\n    This is true if their XOR result is a power of two (and not zero).\n    \"\"\"\n    xor_result = a ^ b\n    # A number is a power of two if it's greater than 0 and (n & (n - 1)) is 0.\n    abs_xor_result = abs(xor_result)\n    return abs_xor_result > 0 and (abs_xor_result & (abs_xor_result - 1)) == 0"}
{"task_id": "Mbpp/2", "solution": "def similar_elements(seq1: Iterable[Any], seq2: Iterable[Any]) -> Tuple[Any, ...]:\n    \"\"\"Finds the shared elements between two iterables, returning them as a unique tuple.\"\"\"\n\n    # Define custom exceptions\n    class InvalidInputError(ValueError):\n        pass\n\n    class SimilarityError(RuntimeError):\n        pass\n\n    def is_iterable(obj: Any) -> bool:\n        \"\"\"Checks if an object is iterable but not a string.\"\"\"\n        return hasattr(obj, '__iter__') and not isinstance(obj, str)\n\n    def normalize_iterable(obj: Any) -> Iterable[Any]:\n        \"\"\"Ensures the input is a valid iterable or raises InvalidInputError.\"\"\"\n        if not is_iterable(obj):\n            raise InvalidInputError(f\"Input '{obj}' is not an iterable.\")\n        return obj\n\n    def fallback_intersection(left: Iterable[Any], right: Iterable[Any]) -> Set[Any]:\n        \"\"\"Computes intersection for potentially unhashable elements using equality checks.\"\"\"\n        result_list: List[Any] = []\n        right_list = list(right)\n\n        for item_l in left:\n            item_found_in_right = False\n            for item_r in right_list:\n                if item_l == item_r:\n                    item_found_in_right = True\n                    break\n\n            if item_found_in_right:\n                item_already_in_result = False\n                for existing_item in result_list:\n                    if item_l == existing_item:\n                        item_already_in_result = True\n                        break\n                if not item_already_in_result:\n                    result_list.append(item_l)\n\n        return set(result_list)\n\n    class SetAdapter:\n        \"\"\"Provides a static method for set-based intersection.\"\"\"\n        @staticmethod\n        def compute_with_sets(left: Iterable[Any], right: Iterable[Any]) -> Set[Any]:\n            \"\"\"Converts iterables to sets and returns their intersection. May raise TypeError.\"\"\"\n            return set(left) & set(right)\n\n    class SimilarityService:\n        \"\"\"Encapsulates the business logic for finding shared elements.\"\"\"\n        def find_shared(self, seq1: Iterable[Any], seq2: Iterable[Any]) -> Set[Any]:\n            left_norm = normalize_iterable(seq1)\n            right_norm = normalize_iterable(seq2)\n\n            try:\n                return SetAdapter.compute_with_sets(left_norm, right_norm)\n            except TypeError:\n                return fallback_intersection(left_norm, right_norm)\n\n    if seq1 is None or seq2 is None:\n        raise InvalidInputError(\"seq1 and seq2 must be non-null iterables\")\n\n    service = SimilarityService()\n    result_set = service.find_shared(seq1, seq2)\n    return tuple(result_set)"}
{"task_id": "Mbpp/9", "solution": "def find_Rotations(s: str) -> int:\n    \"\"\"\n    Find the minimum positive number of left-rotations required to obtain the same string.\n    Uses the KMP prefix-function to compute the minimal period in O(n) time.\n\n    Raises:\n        TypeError: if s is not a str.\n        ValueError: if s is an empty string.\n    \"\"\"\n    if not isinstance(s, str):\n        raise TypeError(\"s must be a str\")\n    n = len(s)\n    if n == 0:\n        raise ValueError(\"s must be a non-empty string\")\n\n    # KMP prefix function (pi array)\n    pi = [0] * n\n    for i in range(1, n):\n        j = pi[i - 1]\n        while j > 0 and s[i] != s[j]:\n            j = pi[j - 1]\n        if s[i] == s[j]:\n            j += 1\n        pi[i] = j\n\n    p = n - pi[-1]\n    return p if n % p == 0 else n"}
{"task_id": "Mbpp/14", "solution": "def find_Volume(base, triangle_height, prism_length):\n    \"\"\"\n    Calculates the volume of a triangular prism.\n\n    The volume is the area of the triangular base (0.5 * base * triangle_height)\n    multiplied by the prism's length.\n    \"\"\"\n    area_base = 0.5 * base * triangle_height\n    volume = area_base * prism_length\n    return volume"}
{"task_id": "Mbpp/11", "solution": "def remove_Occ(s, ch):\n    \"\"\"\n    Removes the first and last occurrence of a given character from the string.\n    If the character occurs only once, that single occurrence is removed.\n    \"\"\"\n    first_idx = s.find(ch)\n    if first_idx == -1:\n        return s\n\n    last_idx = s.rfind(ch)\n\n    if first_idx == last_idx:\n        # Only one occurrence, remove it\n        return s[:first_idx] + s[first_idx+1:]\n    else:\n        # Remove both first and last occurrences\n        return s[:first_idx] + s[first_idx+1:last_idx] + s[last_idx+1:]"}
