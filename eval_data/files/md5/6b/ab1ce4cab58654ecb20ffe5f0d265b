{"task_id": "Mbpp/92", "solution": "def is_undulating(number: int | str) -> bool:\n    \"\"\"\n    Checks if a number is undulating, meaning its digits alternate between two distinct digits.\n    Minimum length for an undulating number is 3 digits.\n    \"\"\"\n    s = str(number).strip()\n\n    if not s:\n        return False\n\n    if s[0] in \"+-\":\n        s = s[1:]\n\n    if not s.isdigit():\n        return False\n\n    digits = s\n    MIN_LENGTH = 3\n\n    if len(digits) < MIN_LENGTH:\n        return False\n\n    if digits[0] == digits[1]:\n        return False\n\n    a, b = digits[0], digits[1]\n    for i, ch in enumerate(digits):\n        expected = a if (i % 2) == 0 else b\n        if ch != expected:\n            return False\n\n    return True"}
{"task_id": "Mbpp/93", "solution": "def power(a, b):\n    \"\"\"\n    Calculates the value of 'a' raised to the power 'b' using exponentiation by squaring.\n    Supports integer exponents, including zero and negative values.\n    \"\"\"\n    if b == 0:\n        return 1.0\n\n    is_negative_exponent = b < 0\n    abs_b = -b if is_negative_exponent else b\n\n    result = 1.0\n    current_base = float(a)\n    exponent_val = abs_b\n\n    while exponent_val > 0:\n        if exponent_val & 1:  # If exponent_val is odd\n            result *= current_base\n        current_base *= current_base\n        exponent_val >>= 1  # exponent_val = exponent_val // 2\n\n    if is_negative_exponent:\n        return 1.0 / result\n    else:\n        return result"}
{"task_id": "Mbpp/94", "solution": "from typing import Any, Iterable, Sequence, Optional, Callable, Iterator\nclass TupleMinError(Exception):\n    \"\"\"Base exception for tuple_min operations.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\nclass EmptyInputError(TupleMinError):\n    \"\"\"Raised when the input sequence is empty.\"\"\"\n    def __init__(self, message: str = \"No items provided.\") -> None:\n        super().__init__(message)\nclass InvalidInputError(TupleMinError):\n    \"\"\"Raised when input items are malformed or not comparable.\"\"\"\n    def __init__(self, message: str = \"Invalid input item.\") -> None:\n        super().__init__(message)\nclass TupleItem:\n    \"\"\"Represents a tuple (first, second) with typed accessors.\"\"\"\n    def __init__(self, first: Any, second: float) -> None:\n        try:\n            self._second = float(second)\n        except (ValueError, TypeError) as e:\n            raise InvalidInputError(f\"Second value must be numeric: {e}\")\n        self._first = first\n\n    @classmethod\n    def from_iterable(cls, iterable: Iterable) -> \"TupleItem\":\n        \"\"\"Creates a TupleItem from a length-2 iterable.\"\"\"\n        seq = list(iterable)\n        if len(seq) != 2:\n            raise InvalidInputError(f\"Each item must be length 2, but got length {len(seq)}.\")\n        return cls(seq[0], seq[1])\n\n    @property\n    def first(self) -> Any:\n        return self._first\n\n    @property\n    def second(self) -> float:\n        return self._second\nclass TupleRepository:\n    \"\"\"Adapts a raw sequence input to an iterator of TupleItem objects.\"\"\"\n    def __init__(self, source: Sequence[Iterable]) -> None:\n        self._source = source\n\n    def get_items(self) -> Iterator[TupleItem]:\n        \"\"\"Yields TupleItem objects from the source sequence.\"\"\"\n        if not self._source:\n            raise EmptyInputError(\"Input sequence is empty.\")\n\n        for item_iterable in self._source:\n            yield TupleItem.from_iterable(item_iterable)\nclass MinFinderService:\n    \"\"\"Implements the core algorithm to find the first value associated with the minimum second value.\"\"\"\n    def __init__(self) -> None:\n        pass\n\n    def find_min_first_value(self, items: Iterable[TupleItem]) -> Any:\n        \"\"\"Finds the first value of the TupleItem with the smallest second value.\"\"\"\n        min_item: Optional[TupleItem] = None\n        found = False\n        for item in items:\n            found = True\n            if min_item is None or item.second < min_item.second:\n                min_item = item\n        if not found or min_item is None:\n            raise EmptyInputError(\"No items provided or input iterable was empty.\")\n        return min_item.first\nclass TupleController:\n    \"\"\"Provides the public API and integrates repository and service logic.\"\"\"\n    def __init__(self, repository_factory: Callable[[Sequence], TupleRepository] = TupleRepository) -> None:\n        self._repo_factory = repository_factory\n        self._service = MinFinderService()\n\n    def index_minimum_raw(self, items: Sequence[Iterable]) -> Any:\n        \"\"\"Processes raw input to find the first value with the minimum second value.\"\"\"\n        repo = self._repo_factory(items)\n        return self._service.find_min_first_value(repo.get_items())\ndef index_minimum(items: Sequence[Iterable]) -> Any:\n    \"\"\"\n    Given a list of tuples, returns the first value of the tuple with the smallest second value.\n    \"\"\"\n    controller = TupleController()\n    return controller.index_minimum_raw(items)"}
{"task_id": "Mbpp/95", "solution": "def Find_Min_Length(lists: list) -> int:\n    \"\"\"\n    Finds the length of the smallest list within a list of lists.\n\n    Args:\n        lists: A non-empty list of iterables (lists, tuples, etc.).\n\n    Returns:\n        The minimum length (int) among the inner iterables.\n\n    Raises:\n        ValueError: If `lists` is empty.\n        TypeError: If an element of `lists` is not an iterable with a len().\n    \"\"\"\n    if not isinstance(lists, (list, tuple)):\n        raise TypeError(\"Input must be a list or tuple of iterables.\")\n\n    if len(lists) == 0:\n        raise ValueError(\"The outer list must contain at least one inner iterable.\")\n\n    min_len = None\n    for i, sub in enumerate(lists):\n        try:\n            l = len(sub)\n        except TypeError:\n            raise TypeError(f\"Element at index {i} is not sized/iterable.\")\n        if min_len is None or l < min_len:\n            min_len = l\n\n    # min_len will be set because we checked outer list is non-empty\n    return min_len"}
{"task_id": "Mbpp/96", "solution": "def divisor(n: int) -> int:\n    \"\"\"\n    Calculates the number of positive divisors for a given integer.\n    It considers the absolute value of n for calculation.\n    \"\"\"\n\n    def _prime_factorization(num: int) -> dict[int, int]:\n        \"\"\"\n        Computes the prime factorization of a positive integer.\n        Returns a dictionary mapping each prime factor to its exponent.\n        \"\"\"\n        factors: dict[int, int] = {}\n        from math import isqrt\n\n        # Factor out 2s\n        while num % 2 == 0:\n            factors[2] = factors.get(2, 0) + 1\n            num //= 2\n\n        # Factor out odd primes\n        f = 3\n        # We only need to check factors up to the square root of the remaining number\n        limit = isqrt(num)\n        while f <= limit and num > 1:\n            while num % f == 0:\n                factors[f] = factors.get(f, 0) + 1\n                num //= f\n                limit = isqrt(num)  # Recalculate limit as num decreases\n            f += 2\n\n        # If num is still greater than 1, it must be a prime itself\n        if num > 1:\n            factors[num] = factors.get(num, 0) + 1\n        return factors\n\n    n = abs(n)\n\n    if n == 1:\n        return 1\n\n    factors = _prime_factorization(n)\n\n    num_divs = 1\n    for exponent in factors.values():\n        num_divs *= (exponent + 1)\n\n    return num_divs"}
