{"task_id": "Mbpp/56", "solution": "def check(number: int) -> bool:\n    \"\"\"\n    Checks if a given number is one less than twice its reverse.\n    The reverse operation preserves the sign and drops leading zeros.\n    \"\"\"\n    sign = -1 if number < 0 else 1\n    abs_num_str = str(abs(number))\n    reversed_abs_num_str = abs_num_str[::-1]\n\n    # Convert back to integer; int() handles leading zeros gracefully\n    reversed_num = sign * int(reversed_abs_num_str)\n\n    computed_rhs = 2 * reversed_num - 1\n    return number == computed_rhs"}
{"task_id": "Mbpp/57", "solution": "def find_Max_Num(digits):\n    \"\"\"\n    Arrange a list of digits to form the largest possible number.\n\n    Accepts integers 0-9 or single-character digit strings.\n    Raises TypeError for non-iterable input and ValueError for invalid digit items or empty input.\n    \"\"\"\n    # Validate iterable (but disallow str/bytes as the whole input)\n    if not hasattr(digits, \"__iter__\") or isinstance(digits, (str, bytes)):\n        raise TypeError(\"digits must be an iterable of single-digit ints or digit strings\")\n\n    normalized = []\n    for i, v in enumerate(digits):\n        if isinstance(v, int):\n            if 0 <= v <= 9:\n                normalized.append(v)\n            else:\n                raise ValueError(f\"item at index {i} ({v}) is not a single digit 0-9\")\n        elif isinstance(v, str) and len(v) == 1 and v.isdigit():\n            normalized.append(int(v))\n        else:\n            raise ValueError(f\"item at index {i} ({v}) is not a single digit\")\n\n    if not normalized:\n        raise ValueError(\"input digit list is empty\")\n\n    # Sort digits descending and build integer\n    normalized.sort(reverse=True)\n    return int(\"\".join(map(str, normalized)))"}
{"task_id": "Mbpp/61", "solution": "def count_Substrings(s):\n    \"\"\"\n    Counts the number of substrings where the sum of digits equals their length.\n    Uses a prefix sum approach with a hashmap for O(n) time complexity.\n    \"\"\"\n    from collections import defaultdict\n\n    if not s:\n        return 0\n\n    # Convert string of digits to a list of integers\n    # ord(ch) - 48 is generally faster than int(ch) for single characters\n    digits = [ord(ch) - ord('0') for ch in s]\n\n    # freq stores the frequency of (prefix_sum - index) values encountered so far.\n    # The condition \"sum of digits == length\" for a substring s[j...i] can be rewritten:\n    # (prefix_sum[i] - prefix_sum[j-1]) == (i - (j-1))\n    # prefix_sum[i] - i == prefix_sum[j-1] - (j-1)\n    # We maintain 1-based indexing for prefix sum and length for this transformation.\n    # `pref` is the 1-based prefix sum (sum up to current character, inclusive).\n    # `i` is the 1-based index of the current character.\n    # An empty prefix (before any characters) has sum 0 and length 0, so (0 - 0) = 0.\n    # Initialize freq[0] = 1 to account for substrings starting from the beginning.\n    freq = defaultdict(int)\n    pref = 0\n    freq[0] = 1\n    res = 0\n\n    for i, d in enumerate(digits, 1):\n        pref += d\n        key = pref - i\n        res += freq[key]\n        freq[key] += 1\n\n    return res"}
