{"task_id": "Mbpp/585", "solution": "def expensive_items(items_input, n: int):\n    \"\"\"\n    Finds the n most expensive items from a list of item dictionaries.\n    Assumes each item dictionary has 'name' (string) and 'price' (numeric) keys.\n    \"\"\"\n    from dataclasses import dataclass, field\n    from typing import Any, Dict, List\n    import heapq\n\n    @dataclass\n    class Item:\n        name: str\n        price: float\n        meta: Dict[str, Any] = field(default_factory=dict)\n        _original_index: int = 0\n\n        def to_dict(self) -> Dict[str, Any]:\n            \"\"\"Converts the Item object back into its original dictionary structure.\"\"\"\n            d = {\"name\": self.name, \"price\": self.price}\n            if self.meta:\n                d.update(self.meta)\n            return d\n\n    normalized_items: List[Item] = []\n    for idx, item_dict in enumerate(items_input):\n        # Assumes item_dict contains 'name' and 'price' and 'price' is numeric due to constraints.\n        name = item_dict['name']\n        price = item_dict['price']\n\n        meta = {k: v for k, v in item_dict.items() if k not in ['name', 'price']}\n\n        normalized_items.append(Item(name=name, price=float(price), meta=meta, _original_index=idx))\n\n    # Use a combined key for sorting: primary by price (descending), secondary by original index (ascending) for stability.\n    sort_key = lambda i: (i.price, -i._original_index)\n\n    if n >= len(normalized_items):\n        # If n is greater than or equal to the total number of items, sort all items.\n        top_items = sorted(normalized_items, key=sort_key, reverse=True)\n    else:\n        # Use heapq.nlargest for efficient retrieval of the top n items.\n        top_items = heapq.nlargest(n, normalized_items, key=sort_key)\n\n    return [item.to_dict() for item in top_items]"}
{"task_id": "Mbpp/588", "solution": "def big_diff(values):\n    \"\"\"\n    Finds the difference between the largest and smallest numeric value in a given list.\n    Raises BigDiffError for empty input or non-numeric elements.\n    \"\"\"\n\n    class BigDiffError(Exception):\n        \"\"\"Domain-specific exception for big_diff errors.\"\"\"\n        def __init__(self, code: str, message: str) -> None:\n            self.code = code\n            self.message = message\n            super().__init__(f\"{code}: {message}\")\n\n        def __str__(self) -> str:\n            return f\"{self.code}: {self.message}\"\n\n    def _coerce_numeric(elem: object) -> float:\n        \"\"\"Attempts to convert an element to a float, raising BigDiffError on failure.\"\"\"\n        try:\n            if isinstance(elem, (int, float)):\n                return float(elem)\n            if isinstance(elem, str):\n                return float(elem)\n            raise ValueError()\n        except Exception:\n            raise BigDiffError(\"invalid_element\", f\"Invalid element: {elem}\")\n\n    def _parse_values_from_tokens(tokens: list[str]) -> list[float]:\n        \"\"\"Parses string tokens into a list of floats, handling common separators.\"\"\"\n        out: list[float] = []\n        for token in tokens:\n            for part in token.replace(\",\", \" \").split():\n                if part: # Ensure part is not empty after splitting\n                    out.append(_coerce_numeric(part))\n        return out\n\n    # Validate and coerce input values\n    numbers: list[float] = []\n    if isinstance(values, str):\n        numbers = _parse_values_from_tokens([values])\n    else:\n        # Assuming values is an iterable (list, tuple, generator, etc.)\n        # If it's a non-string iterable of mixed types (e.g., [1, \"2\", 3.0]),\n        # each element is coerced individually.\n        for e in values:\n            numbers.append(_coerce_numeric(e))\n\n    # Check for empty list after coercion\n    if not numbers:\n        raise BigDiffError(\"empty_input\", \"Input list is empty\")\n\n    # Calculate min and max in a single pass\n    it = iter(numbers)\n    # Guaranteed to have at least one element due to the check above\n    first = next(it)\n    current_min = current_max = first\n\n    for v in it:\n        if v < current_min:\n            current_min = v\n        if v > current_max:\n            current_max = v\n\n    # Compute the difference as a float, then truncate to int\n    diff = current_max - current_min\n    return int(diff)"}
{"task_id": "Mbpp/591", "solution": "def swap_List(lst):\n    \"\"\"Interchanges the first and last elements in a list, returning a new list.\"\"\"\n    new_list = list(lst)\n    if len(new_list) >= 2:\n        new_list[0], new_list[-1] = new_list[-1], new_list[0]\n    return new_list"}
{"task_id": "Mbpp/593", "solution": "def removezero_ip(ip: str) -> str:\n    \"\"\"Removes leading zeros from each octet of an IPv4 address string.\"\"\"\n\n    # Define a simple ValidationError class inline\n    class ValidationError(Exception):\n        def __init__(self, message: str) -> None:\n            self.message = message\n            super().__init__(message)\n        def __str__(self) -> str:\n            return self.message\n\n    MAX_OCTET = 255\n    MIN_OCTET = 0\n    OCTET_COUNT = 4\n\n    if not isinstance(ip, str):\n        raise ValidationError(\"input must be a string\")\n\n    s = ip.strip()\n    if not s:\n        raise ValidationError(\"empty input string\")\n\n    parts = s.split('.')\n    if len(parts) != OCTET_COUNT:\n        raise ValidationError(\"must contain 4 octets separated by '.'\")\n\n    normalized_octets = []\n    for idx, octet_text in enumerate(parts, start=1):\n        if octet_text == '':\n            raise ValidationError(f\"octet #{idx} empty\")\n        # Check if all characters are digits\n        if not octet_text.isdigit():\n            raise ValidationError(f\"octet #{idx} not numeric\")\n        val = int(octet_text)\n        if val < MIN_OCTET or val > MAX_OCTET:\n            raise ValidationError(f\"octet #{idx} out of range\")\n        normalized_octets.append(str(val))\n    return '.'.join(normalized_octets)"}
{"task_id": "Mbpp/592", "solution": "def sum_Of_product(n: int) -> int:\n    \"\"\"\n    Calculates the sum of the product of consecutive binomial coefficients using the identity:\n    sum_{k=0}^{n-1} C(n,k) * C(n,k+1) == C(2n, n-1)\n\n    Parameters:\n    - n: integer >= 1\n\n    Returns:\n    - integer value of the sum\n\n    Raises:\n    - ValueError if n is not an integer >= 1\n    \"\"\"\n    if not isinstance(n, int):\n        raise ValueError(\"n must be an integer\")\n    if n < 1:\n        raise ValueError(\"n must be >= 1\")\n\n    def _comb(N: int, K: int) -> int:\n        \"\"\"\n        Computes the binomial coefficient C(N, K) using a multiplicative method.\n        Returns 0 if K < 0 or K > N.\n        \"\"\"\n        if K < 0 or K > N:\n            return 0\n        if K == 0 or K == N:\n            return 1\n        K = min(K, N - K)\n        result = 1\n        for i in range(1, K + 1):\n            result = result * (N - K + i) // i\n        return result\n\n    return _comb(2 * n, n - 1)"}
{"task_id": "Mbpp/590", "solution": "import math\nfrom typing import Tuple\ndef polar_rect(a: float, b: float, input_type: str = 'polar') -> Tuple[Tuple[float,float], complex]:\n    \"\"\"\n    Converts coordinates between polar and rectangular forms.\n    Returns ((r, theta), complex(x, y)) based on the input_type.\n    \"\"\"\n\n    def _normalize_angle(angle: float) -> float:\n        \"\"\"Normalizes an angle to the range (-pi, pi].\"\"\"\n        return (angle + math.pi) % (2 * math.pi) - math.pi\n\n    if input_type not in {'polar', 'rect'}:\n        raise ValueError(\"input_type must be 'polar' or 'rect'\")\n\n    polar_coords: Tuple[float, float]\n    rectangular_coords: complex\n\n    if input_type == 'polar':\n        r_input, theta_input = a, b\n\n        if r_input < 0:\n            r_effective = -r_input\n            theta_effective = theta_input + math.pi\n        else:\n            r_effective = r_input\n            theta_effective = theta_input\n\n        normalized_theta = _normalize_angle(theta_effective)\n\n        x = r_effective * math.cos(normalized_theta)\n        y = r_effective * math.sin(normalized_theta)\n\n        polar_coords = (r_effective, normalized_theta)\n        rectangular_coords = complex(x, y)\n\n    elif input_type == 'rect':\n        x_input, y_input = a, b\n\n        r = math.hypot(x_input, y_input)\n        raw_theta = math.atan2(y_input, x_input)\n\n        normalized_theta = _normalize_angle(raw_theta)\n\n        polar_coords = (r, normalized_theta)\n        rectangular_coords = complex(x_input, y_input)\n\n    return (polar_coords, rectangular_coords)"}
{"task_id": "Mbpp/589", "solution": "def perfect_squares(start: int, end: int) -> List[int]:\n    import math\n    import json\n    import os\n    import time\n    from typing import List, Optional, Dict, Any\n\n    class RangeModel:\n        \"\"\"DTO for a validated integer range.\"\"\"\n        def __init__(self, start_val: int, end_val: int) -> None:\n            self.start: int = start_val\n            self.end: int = end_val\n\n        def as_key(self) -> str:\n            \"\"\"Returns a string key representation of the range.\"\"\"\n            return f\"{self.start}:{self.end}\"\n\n    class ValidationError(Exception):\n        \"\"\"Exception raised for invalid input values.\"\"\"\n        def __init__(self, message: str) -> None:\n            super().__init__(message)\n            self.message = message\n\n    class ServiceError(Exception):\n        \"\"\"Exception raised for internal service errors.\"\"\"\n        def __init__(self, message: str) -> None:\n            super().__init__(message)\n            self.message = message\n\n    class InputValidator:\n        \"\"\"Validates and normalizes raw start/end values into a RangeModel.\"\"\"\n        def validate(self, start_input: object, end_input: object) -> RangeModel:\n            \"\"\"Converts inputs to integers and ensures start <= end.\"\"\"\n            s = self._to_int(start_input)\n            e = self._to_int(end_input)\n            if s > e:\n                raise ValidationError(f\"start ({s}) must be <= end ({e})\")\n            return RangeModel(s, e)\n\n        def _to_int(self, value: object) -> int:\n            \"\"\"Converts a single input to an integer, raising ValidationError if invalid.\"\"\"\n            try:\n                if isinstance(value, float) and not value.is_integer():\n                    raise ValidationError(\"float must be integer-valued\")\n                return int(value)\n            except Exception as exc:\n                raise ValidationError(f\"Invalid integer value: {value}\") from exc\n\n    class MathUtils:\n        \"\"\"Provides static methods for integer math operations.\"\"\"\n        @staticmethod\n        def isqrt(n: int) -> int:\n            \"\"\"Returns the integer floor of the square root of n.\"\"\"\n            if n < 0:\n                raise ValueError(\"isqrt() argument must be non-negative\")\n            return math.isqrt(n)\n\n        @staticmethod\n        def is_perfect_square(n: int) -> bool:\n            \"\"\"Checks if n is a perfect square.\"\"\"\n            if n < 0:\n                return False\n            r = MathUtils.isqrt(n)\n            return r * r == n\n\n        @staticmethod\n        def squares_between(start_range: int, end_range: int) -> List[int]:\n            \"\"\"Generates perfect squares within the given inclusive range.\"\"\"\n            if end_range < start_range:\n                return []\n            a = math.ceil(math.sqrt(max(start_range, 0)))\n            b = math.floor(math.sqrt(max(end_range, 0)))\n            if b < a:\n                return []\n            return [i * i for i in range(int(a), int(b) + 1)]\n\n    class CacheRepository:\n        \"\"\"Manages a JSON file-based cache for perfect square results.\"\"\"\n        DEFAULT_CACHE_PATH = os.path.expanduser(\"~/.cache/perfect_squares/cache.json\")\n\n        def __init__(self, path: str = None, max_entries: int = 1000) -> None:\n            self._path = path or CacheRepository.DEFAULT_CACHE_PATH\n            self._max_entries = max_entries\n            self._cache: Dict[str, Dict[str, Any]] = {}\n            self._loaded = False\n\n        def get(self, key: str) -> Optional[List[int]]:\n            \"\"\"Retrieves cached values for a given key, or None if not found or on error.\"\"\"\n            try:\n                if not self._loaded:\n                    self._load()\n                entry = self._cache.get(key)\n                if entry and \"values\" in entry:\n                    return entry[\"values\"]\n                return None\n            except Exception:\n                return None\n\n        def set(self, key: str, values: List[int]) -> None:\n            \"\"\"Sets values for a key in the cache and persists it to disk, applying LRU eviction.\"\"\"\n            try:\n                if not self._loaded:\n                    self._load()\n                self._cache[key] = {\"values\": values, \"ts\": time.time()}\n                if len(self._cache) > self._max_entries:\n                    oldest_key = min(self._cache, key=lambda k: self._cache[k][\"ts\"])\n                    del self._cache[oldest_key]\n                self._persist()\n            except Exception:\n                pass\n\n        def _load(self) -> None:\n            \"\"\"Loads the cache from the configured JSON file.\"\"\"\n            cache_dir = os.path.dirname(self._path)\n            if cache_dir:\n                os.makedirs(cache_dir, exist_ok=True)\n\n            if not os.path.exists(self._path):\n                self._cache = {}\n                self._loaded = True\n                return\n\n            try:\n                with open(self._path, \"r\", encoding=\"utf-8\") as f:\n                    raw = json.load(f)\n                entries_from_file = raw.get(\"entries\", {})\n                self._cache = {k: v for k, v in entries_from_file.items()\n                               if isinstance(v, dict) and \"values\" in v and \"ts\" in v}\n                self._loaded = True\n            except (json.JSONDecodeError, IOError, OSError):\n                self._cache = {}\n                self._loaded = True\n\n        def _persist(self) -> None:\n            \"\"\"Persists the current cache state to disk atomically.\"\"\"\n            temp_path = self._path + \".tmp\"\n            try:\n                to_write = {\"entries\": self._cache}\n                with open(temp_path, \"w\", encoding=\"utf-8\") as f:\n                    json.dump(to_write, f)\n                os.replace(temp_path, self._path)\n            except (IOError, OSError, TypeError):\n                pass\n\n    class PerfectSquareService:\n        \"\"\"Core application logic for finding perfect squares, with optional caching.\"\"\"\n        def __init__(self, cache_repo: Optional[CacheRepository] = None, cache_enabled: bool = True) -> None:\n            self._cache_repo = cache_repo\n            self._cache_enabled = cache_enabled and cache_repo is not None\n\n        def find(self, start_svc: int, end_svc: int) -> List[int]:\n            \"\"\"Finds perfect squares within the given range, using cache if enabled.\"\"\"\n            r = RangeModel(start_svc, end_svc)\n            key = r.as_key()\n            try:\n                if self._cache_enabled:\n                    cached = self._cache_repo.get(key)\n                    if cached is not None:\n                        return cached\n                result = self._compute_range(r)\n                if self._cache_enabled:\n                    self._cache_repo.set(key, result)\n                return result\n            except Exception as exc:\n                raise ServiceError(str(exc)) from exc\n\n        def _compute_range(self, r: RangeModel) -> List[int]:\n            \"\"\"Computes perfect squares for a given RangeModel using MathUtils.\"\"\"\n            return MathUtils.squares_between(r.start, r.end)\n\n    # Validate the input range using the InputValidator.\n    validator = InputValidator()\n    validated_range = validator.validate(start, end)\n\n    # Initialize the PerfectSquareService with a CacheRepository for caching.\n    service = PerfectSquareService(cache_repo=CacheRepository(), cache_enabled=True)\n\n    # Use the service to find perfect squares for the validated range.\n    return service.find(validated_range.start, validated_range.end)"}
{"task_id": "Mbpp/594", "solution": "def diff_even_odd(numbers: list[int]) -> int:\n    \"\"\"Finds the difference of the first even and first odd number in a list.\"\"\"\n    first_even = None\n    first_odd = None\n\n    for num in numbers:\n        if first_odd is None and num % 2 != 0:\n            first_odd = num\n        if first_even is None and num % 2 == 0:\n            first_even = num\n\n        if first_even is not None and first_odd is not None:\n            break\n\n    return first_even - first_odd"}
