{"task_id": "Mbpp/450", "solution": "from typing import List, Sequence\ndef extract_string(values: Sequence[str], length: int, trim: bool = False) -> List[str]:\n    \"\"\"\n    Extracts strings of a specified length from a list of strings.\n\n    Optionally trims whitespace from strings before checking their length.\n    \"\"\"\n    if not isinstance(length, int) or length < 0:\n        raise ValueError(\"length must be a non-negative integer\")\n    if values is None:\n        raise ValueError(\"values must be an iterable of strings\")\n    matching_strings = []\n    for idx, s in enumerate(values):\n        if not isinstance(s, str):\n            raise TypeError(f\"element at index {idx} is not a str: {s!r}\")\n        current_string = s.strip() if trim else s\n        if len(current_string) == length:\n            matching_strings.append(current_string)\n    return matching_strings"}
{"task_id": "Mbpp/446", "solution": "def count_Occurrence(source, targets):\n    # Create a frequency map of the elements in the source tuple.\n    freq_map = {}\n    for item in source:\n        freq_map[item] = freq_map.get(item, 0) + 1\n\n    # Sum the occurrences of target elements using the frequency map.\n    total_occurrences = 0\n    for target_item in targets:\n        total_occurrences += freq_map.get(target_item, 0)\n\n    return total_occurrences"}
{"task_id": "Mbpp/440", "solution": "def find_adverb_position(sentence: str):\n    \"\"\"\n    Find the first adverb in `sentence` and return a tuple (start, end, token),\n    where start is inclusive and end is exclusive index into the original string,\n    and token is the lowercased adverb text. If no adverb is found, return\n    (None, None, None).\n\n    Example:\n        find_adverb_position(\"clearly!! we can see the sky\") == (0, 7, \"clearly\")\n    \"\"\"\n    if not isinstance(sentence, str):\n        raise TypeError(\"sentence must be a str\")\n\n    import re\n\n    # Minimal seed list of common adverbs and exceptions for -ly heuristic.\n    adverb_set = {\n        \"clearly\", \"very\", \"quite\", \"extremely\", \"recently\", \"quickly\", \"slowly\",\n        \"happily\", \"sadly\", \"barely\", \"simply\", \"mostly\", \"actually\", \"really\"\n    }\n    deny_ly = {\"family\", \"supply\", \"apply\", \"rally\", \"sally\"}  # words ending with 'ly' that are not adverbs\n\n    # Match contiguous alphabetic words (allow simple contractions)\n    token_re = re.compile(r\"[A-Za-z]+(?:'[A-Za-z]+)?\")\n\n    for m in token_re.finditer(sentence):\n        word = m.group(0)\n        norm = word.lower()\n        if norm in adverb_set or (norm.endswith(\"ly\") and norm not in deny_ly):\n            return (m.start(), m.end(), norm)\n\n    return (None, None, None)"}
{"task_id": "Mbpp/448", "solution": "def cal_sum(n: int) -> int:\n    \"\"\"Calculates the sum of Perrin numbers from P(0) to P(n) inclusive.\n    The sequence starts P(0)=3, P(1)=0, P(2)=2, and P(k) = P(k-2) + P(k-3) for k >= 3.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n    if n < 0:\n        raise ValueError(\"n must be >= 0\")\n\n    if n == 0:\n        return 3\n    if n == 1:\n        return 3  # P(0) + P(1) = 3 + 0\n    if n == 2:\n        return 5  # P(0) + P(1) + P(2) = 3 + 0 + 2\n\n    perrin_numbers = [3, 0, 2]\n    # Initialize a, b, c to store P(i-3), P(i-2), P(i-1) respectively.\n    a, b, c = 3, 0, 2\n\n    for i in range(3, n + 1):\n        # Calculate P(i) using the recurrence relation P(k) = P(k-2) + P(k-3)\n        current_perrin = b + a\n        perrin_numbers.append(current_perrin)\n        # Update the sliding window for the next iteration: a becomes b, b becomes c, c becomes current_perrin\n        a, b, c = b, c, current_perrin\n\n    return sum(perrin_numbers)"}
{"task_id": "Mbpp/451", "solution": "def remove_whitespaces(s: str) -> str:\n    \"\"\"Removes all whitespace characters from the input string.\n    This implementation iterates through the string and joins non-whitespace characters.\"\"\"\n    return \"\".join(ch for ch in s if not ch.isspace())"}
{"task_id": "Mbpp/454", "solution": "def text_match_wordz(text: str) -> bool:\n    \"\"\"\n    Detects if the input text contains at least one word with the character 'z' (case-insensitive).\n    Words are sequences of letters, digits, or underscores.\n    \"\"\"\n    import re\n\n    # Normalize input: treat None as an empty string, coerce non-string inputs to string.\n    if text is None:\n        normalized_text = \"\"\n    else:\n        normalized_text = str(text)\n\n    # Define the regex pattern for a word containing 'z' or 'Z'.\n    # \\b matches word boundaries, \\w* matches zero or more word characters.\n    Z_WORD_PATTERN = r\"\\b\\w*z\\w*\\b\"\n\n    # Search for the pattern in the normalized text, ignoring case for 'z'.\n    # Returns a match object if found, None otherwise. bool() converts this to True/False.\n    return bool(re.search(Z_WORD_PATTERN, normalized_text, re.IGNORECASE))"}
{"task_id": "Mbpp/453", "solution": "import math\ndef sumofFactors(n: int) -> int:\n    \"\"\"Calculates the sum of even factors of a given number.\n    Returns 0 for non-positive inputs as per business rules.\"\"\"\n    if n <= 0:\n        return 0\n\n    target_n = abs(n)\n    even_factors = set()\n    limit = int(math.isqrt(target_n))\n\n    for d in range(1, limit + 1):\n        if target_n % d == 0:\n            if d % 2 == 0:\n                even_factors.add(d)\n\n            complement_d = target_n // d\n            if complement_d != d and complement_d % 2 == 0:\n                even_factors.add(complement_d)\n\n    return sum(even_factors)"}
