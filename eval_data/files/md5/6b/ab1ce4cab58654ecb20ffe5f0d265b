{"task_id": "Mbpp/476", "solution": "from typing import Any, List, Optional, Tuple, Union, Dict\nNumber = Union[int, float]\nclass BigSumError(Exception):\n    \"\"\"Domain-specific error type used across the package.\"\"\"\n    def __init__(self, message: str) -> None:\n        self.message = message\n        super().__init__(message)\nclass Validator:\n    \"\"\"Validates array content and item types.\"\"\"\n    def is_numeric(self, value: Any) -> bool:\n        return isinstance(value, (int, float)) and not isinstance(value, bool)\n\n    def validate_array(self, values: List[Any]) -> List[Number]:\n        if not isinstance(values, list):\n            raise BigSumError(\"input must be a list\")\n        if len(values) == 0:\n            raise BigSumError(\"empty array\")\n        out = []\n        for i, v in enumerate(values):\n            if self.is_numeric(v):\n                out.append(v)\n            else:\n                raise BigSumError(f\"invalid item type at index {i}: {type(v).__name__}\")\n        return out\nclass ArrayRepository:\n    \"\"\"Optional persistence/audit of arrays used for computation.\"\"\"\n    def __init__(self, storage_path: Optional[str] = None) -> None:\n        self._store: List[List[Number]] = []\n        self.storage_path = storage_path\n\n    def save(self, values: List[Number]) -> None:\n        self._store.append(values)\n        # File persistence logic omitted as per design constraints (no external helpers)\n        # and noted as non-fatal if it were to fail.\n\n    def all(self) -> List[List[Number]]:\n        return list(self._store)\nclass SumResult:\n    \"\"\"Stores the min, max, and total sum of an array.\"\"\"\n    def __init__(self, min_value: Number, max_value: Number, total: Number) -> None:\n        self.min_value = min_value\n        self.max_value = max_value\n        self.total = total\n\n    def to_dict(self) -> Dict[str, Number]:\n        return {\"min_value\": self.min_value, \"max_value\": self.max_value, \"total\": self.total}\nclass BigSumService:\n    \"\"\"Core algorithm to compute min + max in O(n).\"\"\"\n    def __init__(self, repository: Optional[ArrayRepository] = None, validator: Optional[Validator] = None) -> None:\n        self.repository = repository or ArrayRepository()\n        self.validator = validator or Validator()\n\n    def compute(self, values: List[Any]) -> SumResult:\n        numeric = self.validator.validate_array(values)\n        min_v, max_v = self.compute_single_pass(numeric)\n        try:\n            self.repository.save(numeric)\n        except Exception:\n            # Repository failures are caught and ignored as per design.\n            pass\n        return SumResult(min_v, max_v, min_v + max_v)\n\n    def compute_single_pass(self, values: List[Number]) -> Tuple[Number, Number]:\n        it = iter(values)\n        try:\n            first = next(it)\n        except StopIteration:\n            raise BigSumError(\"empty array\") # Should ideally be caught by validate_array beforehand.\n        min_v = max_v = first\n        for v in it:\n            if v < min_v:\n                min_v = v\n            if v > max_v:\n                max_v = v\n        return min_v, max_v\ndef big_sum(values: List[Any]) -> Number:\n    \"\"\"\n    Computes the sum of the largest and smallest numeric value in a given array.\n    Delegates to BigSumService for core logic and validation.\n    \"\"\"\n    svc = BigSumService()\n    return svc.compute(values).total"}
{"task_id": "Mbpp/555", "solution": "def difference(n: int) -> int:\n    \"\"\"\n    Computes the difference between the sum of cubes of the first n natural numbers\n    and the sum of the first n natural numbers using closed-form formulas.\n    \"\"\"\n    sum_n = n * (n + 1) // 2\n    sum_cubes = sum_n ** 2\n    return sum_cubes - sum_n"}
