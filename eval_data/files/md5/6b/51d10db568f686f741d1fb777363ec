{"task_id": "HumanEval/25", "solution": "from typing import List\nimport random\n\ndef factorize(n: int) -> List[int]:\n    \"\"\" Return list of prime factors of given integer, sorted ascending with multiplicities. \"\"\"\n\n    # Helper functions, defined inline as per critical requirements.\n    def _gcd(a: int, b: int) -> int:\n        \"\"\" Computes the greatest common divisor using the Euclidean algorithm. \"\"\"\n        while b:\n            a, b = b, a % b\n        return a\n\n    def _modular_pow(base: int, exp: int, mod: int) -> int:\n        \"\"\" Computes (base^exp) % mod efficiently using binary exponentiation. \"\"\"\n        res = 1\n        base %= mod\n        while exp > 0:\n            if exp % 2 == 1:\n                res = (res * base) % mod\n            base = (base * base) % mod\n            exp //= 2\n        return res\n\n    def _is_probable_prime(num: int, k: int = 5) -> bool:\n        \"\"\" Performs a Miller-Rabin probabilistic primality test. \"\"\"\n        if num == 2 or num == 3: return True\n        if num < 2 or num % 2 == 0: return False\n        \n        # Write num as (2^s) * d + 1\n        s = 0\n        d = num - 1\n        while d % 2 == 0:\n            d //= 2\n            s += 1\n        \n        # Witness loop\n        for _ in range(k):\n            a = random.randint(2, num - 2)\n            x = _modular_pow(a, d, num)\n            if x == 1 or x == num - 1:\n                continue\n            for _ in range(s - 1):\n                x = _modular_pow(x, 2, num)\n                if x == num - 1:\n                    break\n            else: # Loop completed without x == num - 1\n                return False # num is composite\n        return True # num is a probable prime\n\n    def _pollard_rho_factor_single(num: int, rng_seed: int = None, retries: int = 5) -> int:\n        \"\"\" Finds a non-trivial factor of num using Pollard's Rho algorithm. \"\"\"\n        if _is_probable_prime(num):\n            return num # If prime, return itself\n        if num % 2 == 0:\n            return 2 # Handle even numbers, although trial division should catch this\n\n        for _ in range(retries):\n            if rng_seed is not None:\n                random.seed(rng_seed) # Seed for deterministic testing if provided\n            \n            x = random.randint(2, num - 1)\n            y = x\n            c = random.randint(1, num - 1)\n            d = 1 # GCD\n\n            # f(x) = (x^2 + c) % num\n            while d == 1:\n                x = (_modular_pow(x, 2, num) + c) % num\n                y = (_modular_pow(y, 2, num) + c) % num\n                y = (_modular_pow(y, 2, num) + c) % num\n                d = _gcd(abs(x - y), num)\n\n            if d != num and d != 1:\n                return d # Found a non-trivial factor\n        \n        # If no factor found after retries, return the number itself.\n        # This deviates from design's error handling due to critical requirements forbidding exceptions.\n        return num\n\n    # Main factorization logic starts here\n    factors: List[int] = []\n\n    if n == 1:\n        return []\n\n    # Limit for trial division, derived from design specification.\n    DEFAULT_MAX_PRIME_FOR_TRIAL = 100_000 \n\n    def _extract_small_factors(num_to_factor: int) -> tuple[int, List[int]]:\n        \"\"\" Extracts small factors up to a predefined limit using trial division. \"\"\"\n        extracted_factors = []\n        # Divide by 2\n        while num_to_factor % 2 == 0:\n            extracted_factors.append(2)\n            num_to_factor //= 2\n        \n        # Divide by odd numbers\n        d = 3\n        while d <= DEFAULT_MAX_PRIME_FOR_TRIAL and d * d <= num_to_factor:\n            while num_to_factor % d == 0:\n                extracted_factors.append(d)\n                num_to_factor //= d\n            d += 2\n        return num_to_factor, extracted_factors\n\n    remaining_n, small_factors = _extract_small_factors(n)\n    factors.extend(small_factors)\n\n    # Use a stack to manage cofactors for recursive Pollard's Rho factorization.\n    cofactor_stack = [remaining_n]\n    \n    while cofactor_stack:\n        current_cofactor = cofactor_stack.pop()\n\n        if current_cofactor == 1:\n            continue\n        if _is_probable_prime(current_cofactor):\n            factors.append(current_cofactor)\n            continue\n        \n        # Attempt to find a factor using Pollard's Rho\n        factor_found = _pollard_rho_factor_single(current_cofactor)\n        \n        if factor_found == current_cofactor:\n            # Pollard-Rho could not find a factor, treating it as irreducible here.\n            factors.append(current_cofactor)\n        else:\n            # Push the found factor and the remaining cofactor back onto the stack\n            cofactor_stack.append(factor_found)\n            cofactor_stack.append(current_cofactor // factor_found)\n            \n    factors.sort() # Ensure the final list of factors is sorted ascending\n\n    return factors"}
{"task_id": "HumanEval/27", "solution": "```python\ndef flip_case(string: str) -> str:\n    \"\"\"For a given string, flip lowercase characters to uppercase and uppercase to lowercase.\n    Non-alphabetic characters remain unchanged.\n    \"\"\"\n    result_chars: list[str] = []\n    for ch in string:\n        if ch.isupper():\n            result_chars.append(ch.lower())\n        elif ch.islower():\n            result_chars.append(ch.upper())\n        else:\n            result_chars.append(ch)\n    return \"\".join(result_chars)\n```"}
