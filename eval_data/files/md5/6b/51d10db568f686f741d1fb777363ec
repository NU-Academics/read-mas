{"task_id": "HumanEval/64", "solution": "import unicodedata\n\ndef vowels_count(s):\n    \"\"\"Counts vowels in a string, including 'y' at the word's end.\n    Vowels are 'a', 'e', 'i', 'o', 'u' (case-insensitive) based on NFC normalization.\n    \"\"\"\n    normalized_word = unicodedata.normalize('NFC', s).strip()\n    count = 0\n    vowels_set = frozenset({'a', 'e', 'i', 'o', 'u'})\n\n    for char in normalized_word:\n        if char.lower() in vowels_set:\n            count += 1\n\n    # Check for 'y' as a vowel if it is the final alphabetic character\n    # after trimming trailing punctuation and whitespace.\n    stripped_for_y_check = normalized_word\n    i = len(stripped_for_y_check) - 1\n    while i >= 0 and not stripped_for_y_check[i].isalpha():\n        i -= 1\n    \n    final_alphabetic_segment = stripped_for_y_check[:i+1]\n\n    if final_alphabetic_segment and final_alphabetic_segment[-1].lower() == 'y':\n        # 'y' is not in the primary vowels_set, so it would not have been counted already.\n        count += 1\n\n    return count"}
{"task_id": "HumanEval/65", "solution": "def circular_shift(x, shift):\n    \"\"\"Circular shift the digits of the integer x, shift the digits right by shift\n    and return the result as a string. If shift > number of digits, return digits reversed.\n    \"\"\"\n    # Preserve sign and get absolute digits string.\n    is_negative = x < 0\n    abs_x_digits = str(abs(x))\n\n    # Handle the special case of 0 to ensure '0' is treated as a single digit.\n    if abs_x_digits == \"\":\n        abs_x_digits = \"0\"\n\n    num_digits = len(abs_x_digits)\n\n    # Apply business rules as per specification.\n    if shift == num_digits:\n        # If shift equals the number of digits, return the original order.\n        result_digits = abs_x_digits\n    elif shift > num_digits:\n        # If shift is greater than the number of digits, return digits reversed.\n        result_digits = abs_x_digits[::-1]\n    else:\n        # Otherwise, perform a standard circular right shift.\n        k = shift\n        result_digits = abs_x_digits[-k:] + abs_x_digits[:-k]\n\n    # Reconstruct the string with the original sign.\n    if is_negative:\n        return \"-\" + result_digits\n    else:\n        return result_digits"}
{"task_id": "HumanEval/65", "solution": "def circular_shift(x, shift):\n    \"\"\"Circular shift the digits of the integer x, shift the digits right by shift\n    and return the result as a string. If shift > number of digits, return digits reversed.\n    \"\"\"\n    digits = str(x)\n    n = len(digits)\n\n    if shift > n:\n        return digits[::-1]\n\n    k = shift % n\n    if k == 0:\n        return digits\n\n    return digits[-k:] + digits[:-k]"}
