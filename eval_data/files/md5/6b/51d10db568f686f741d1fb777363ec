{"task_id": "HumanEval/86", "solution": "def anti_shuffle(s):\n    \"\"\"\n    Write a function that takes a string and returns an ordered version of it.\n    Ordered version of string, is a string where all words (separated by space)\n    are replaced by a new word where all the characters arranged in\n    ascending order based on ascii value.\n    Note: You should keep the order of words and blank spaces in the sentence.\n    \"\"\"\n    if not s:\n        return \"\"\n\n    SPACE_CHAR = \" \"\n    tokens = []\n    \n    buf = []\n    in_space = (s[0] == SPACE_CHAR)\n\n    for ch in s:\n        is_current_char_space = (ch == SPACE_CHAR)\n        if is_current_char_space == in_space:\n            buf.append(ch)\n        else:\n            tokens.append(((\"\".join(buf), in_space)))\n            buf = [ch]\n            in_space = is_current_char_space\n    \n    if buf:\n        tokens.append((\"\".join(buf), in_space))\n\n    result_parts = []\n    for token_str, is_space in tokens:\n        if is_space:\n            result_parts.append(token_str)\n        else:\n            result_parts.append(\"\".join(sorted(token_str)))\n            \n    return \"\".join(result_parts)"}
{"task_id": "HumanEval/86", "solution": "```python\ndef anti_shuffle(s):\n    \"\"\"\n    Returns an ordered version of the string where words are replaced by a new word\n    with characters arranged in ascending ASCII order, preserving word and space positions.\n    \"\"\"\n    parts = []\n    current_word_chars = []\n    \n    for char in s:\n        if char == ' ':\n            # If a word was being built, sort its characters and add it to the parts.\n            if current_word_chars:\n                parts.append(\"\".join(sorted(current_word_chars, key=ord)))\n                current_word_chars = []\n            # Add the space itself, preserving its position.\n            parts.append(' ')\n        else:\n            # Accumulate characters for the current word.\n            current_word_chars.append(char)\n            \n    # After the loop, process any remaining characters that form the last word.\n    if current_word_chars:\n        parts.append(\"\".join(sorted(current_word_chars, key=ord)))\n        \n    return \"\".join(parts)\n```"}
{"task_id": "HumanEval/87", "solution": "def get_row(lst, x):\n    \"\"\"\n    Finds occurrences of integer x in a jagged 2D list and returns coordinates.\n    Coordinates are sorted by row ascending, then by column descending within each row.\n    \"\"\"\n    matches = []\n    for row_idx, row in enumerate(lst):\n        for col_idx, val in enumerate(row):\n            if val == x:\n                matches.append((row_idx, col_idx))\n\n    # Sort coordinates: primary by row ascending, secondary by column descending.\n    # We use -col_idx for descending column sort with a standard ascending key.\n    matches.sort(key=lambda coord: (coord[0], -coord[1]))\n\n    return matches"}
{"task_id": "HumanEval/87", "solution": "def get_row(lst, x):\n    \"\"\"\n    Finds integer x in a jagged list, returning zero-based (row, column) coordinates.\n    Results are sorted by row ascending, then by column descending.\n    \"\"\"\n    final_results = []\n    for r_idx, row in enumerate(lst):\n        # Collect column indices for matches in the current row.\n        cols_in_row = []\n        for c_idx, item in enumerate(row):\n            if item == x:\n                cols_in_row.append(c_idx)\n\n        # Append coordinates for this row to final_results in descending column order.\n        for col_idx in reversed(cols_in_row):\n            final_results.append((r_idx, col_idx))\n\n    return final_results"}
{"task_id": "HumanEval/88", "solution": "def sort_array(array):\n    \"\"\"\n    Sorts a copy of the given array based on the parity of the sum of its first and last elements.\n    If the sum is odd, it sorts in ascending order; if even, it sorts in descending order.\n    \"\"\"\n    if not array:\n        return []\n\n    # Determine sorting order based on the sum of the first and last elements\n    first_element = array[0]\n    last_element = array[-1]\n    is_sum_odd = (first_element + last_element) % 2 == 1\n\n    # Return a sorted copy of the array without mutating the original\n    if is_sum_odd:\n        return sorted(array)\n    else:\n        return sorted(array, reverse=True)"}
{"task_id": "HumanEval/88", "solution": "def sort_array(array):\n    \"\"\"\n    Given an array of non-negative integers, return a copy of the given array after sorting,\n    you will sort the given array in ascending order if the sum( first index value, last index value) is odd,\n    or sort it in descending order if the sum( first index value, last index value) is even.\n\n    Note:\n    * don't change the given array.\n\n    Examples:\n    * sort_array([]) => []\n    * sort_array([5]) => [5]\n    * sort_array([2, 4, 3, 0, 1, 5]) => [0, 1, 2, 3, 4, 5]\n    * sort_array([2, 4, 3, 0, 1, 5, 6]) => [6, 5, 4, 3, 2, 1, 0]\n    \"\"\"\n\n    if not array:\n        return []\n\n    if len(array) == 1:\n        return list(array) # Return a copy as per requirement\n\n    first_val = array[0]\n    last_val = array[-1]\n    \n    s = first_val + last_val\n    is_odd_sum = (s % 2 != 0)\n\n    result = list(array) # Create a copy to avoid mutating the input array\n\n    if is_odd_sum:\n        result.sort(reverse=False) # Ascending sort\n    else:\n        result.sort(reverse=True) # Descending sort\n\n    return result"}
{"task_id": "HumanEval/89", "solution": "def encrypt(s):\n    \"\"\"Encrypts a string by rotating alphabetic characters forward by 4 positions. Non-alphabetic characters remain unchanged, and case is preserved.\"\"\"\n    SHIFT = 4\n    encrypted_chars = []\n    for ch in s:\n        if 'a' <= ch <= 'z':\n            encrypted_chars.append(chr((ord(ch) - ord('a') + SHIFT) % 26 + ord('a')))\n        elif 'A' <= ch <= 'Z':\n            encrypted_chars.append(chr((ord(ch) - ord('A') + SHIFT) % 26 + ord('A')))\n        else:\n            encrypted_chars.append(ch)\n    return ''.join(encrypted_chars)"}
{"task_id": "HumanEval/90", "solution": "```python\ndef next_smallest(lst):\n    \"\"\"\n    Returns the 2nd smallest distinct element from a list of integers.\n    Returns None if there are fewer than two distinct elements.\n    \"\"\"\n    min1 = float('inf')  # Smallest distinct element found so far\n    min2 = float('inf')  # Second smallest distinct element found so far\n\n    for value in lst:\n        if value < min1:\n            min2 = min1  # The old smallest becomes the new second smallest\n            min1 = value  # This value is the new smallest\n        elif value > min1 and value < min2:\n            min2 = value  # This value is a new second smallest, distinct from min1\n\n    if min2 == float('inf'):\n        return None\n    else:\n        return min2\n```"}
{"task_id": "HumanEval/89", "solution": "```python\n# src/rotcipher/__init__.py\n\"\"\"\nrotcipher package exports: encrypt function, EncryptionService, RotCipher, and RotationConfig.\n\"\"\"\n\nfrom .config import RotationConfig\nfrom .cipher import RotCipher\nfrom .services import EncryptionService\n\n# Convenience function for quick usage without explicitly instantiating classes\ndef encrypt(text: str) -> str:\n    \"\"\"\n    Encrypts a string using the default RotationConfig (shift of 4).\n\n    :param text: The input string to encrypt.\n    :return: The encrypted string.\n    :raises TypeError: If the input is not a string.\n    \"\"\"\n    svc = EncryptionService(RotCipher(RotationConfig.DEFAULT_SHIFT))\n    return svc.encrypt(text)\n\n# Expose key components for direct import\n__all__ = [\n    \"encrypt\",\n    \"EncryptionService\",\n    \"RotCipher\",\n    \"RotationConfig\",\n]\n\n```python\n# src/rotcipher/config.py\n\"\"\"\nConfiguration values for the rotation cipher, including the default shift amount.\n\"\"\"\n\nclass RotationConfig:\n    \"\"\"\n    Configuration class for defining rotation cipher parameters.\n    \"\"\"\n    DEFAULT_SHIFT: int = 4\n\n    def __init__(self, default_shift: int = DEFAULT_SHIFT) -> None:\n        \"\"\"\n        Initializes the RotationConfig with a specified default shift.\n\n        :param default_shift: The integer value for the rotational shift.\n        :raises ValueError: If default_shift is not an integer or is negative.\n        \"\"\"\n        if not isinstance(default_shift, int):\n            raise ValueError(\"default_shift must be an integer.\")\n        if default_shift < 0:\n            raise ValueError(\"default_shift cannot be negative.\")\n        self.default_shift = default_shift\n\n```python\n# src/rotcipher/models.py\n\"\"\"\nData Transfer Objects (DTOs) for explicit request and response contracts.\n\"\"\"\n\nclass EncryptRequest:\n    \"\"\"\n    Represents an encryption request containing the text to be encrypted.\n    \"\"\"\n    def __init__(self, text: str) -> None:\n        \"\"\"\n        Initializes an EncryptRequest with the given text.\n\n        :param text: The string to be encrypted.\n        \"\"\"\n        if not isinstance(text, str):\n            raise TypeError(\"EncryptRequest text must be a string.\")\n        self.text: str = text\n\nclass EncryptResponse:\n    \"\"\"\n    Represents an encryption response containing the result of the encryption.\n    \"\"\"\n    def __init__(self, result: str) -> None:\n        \"\"\"\n        Initializes an EncryptResponse with the encryption result.\n\n        :param result: The encrypted string.\n        \"\"\"\n        if not isinstance(result, str):\n            raise TypeError(\"EncryptResponse result must be a string.\")\n        self.result: str = result\n\n```python\n# src/rotcipher/utils/validators.py\n\"\"\"\nUtility functions for input validation.\n\"\"\"\n\ndef validate_text(text: str) -> None:\n    \"\"\"\n    Validates that the input is a string.\n\n    :param text: The input to validate.\n    :raises TypeError: If the input is not a string.\n    \"\"\"\n    if not isinstance(text, str):\n        raise TypeError(f\"Expected a string, but got {type(text).__name__}.\")\n\n```python\n# src/rotcipher/cipher.py\n\"\"\"\nCore implementation of the rotation cipher algorithm.\n\"\"\"\n\nfrom .utils.validators import validate_text\n\nclass RotCipher:\n    \"\"\"\n    Implements a rotation cipher for lowercase alphabetic characters.\n    Non-alphabetic characters are preserved.\n    \"\"\"\n    LOWER_A: int = ord('a')\n    LOWER_Z: int = ord('z')\n    ALPHABET_SIZE: int = 26\n\n    def __init__(self, shift: int = 4) -> None:\n        \"\"\"\n        Initializes the RotCipher with a specific shift amount.\n\n        :param shift: The integer amount to rotate characters by.\n                      Shift is normalized to be within [0, 25].\n        :raises ValueError: If shift is not an integer.\n        \"\"\"\n        if not isinstance(shift, int):\n            raise ValueError(\"shift must be an integer.\")\n        self.shift: int = shift % self.ALPHABET_SIZE\n\n    def encrypt(self, text: str) -> str:\n        \"\"\"\n        Encrypts the input string by rotating lowercase alphabetic characters.\n\n        :param text: The string to encrypt.\n        :return: The encrypted string.\n        :raises TypeError: If the input text is not a string.\n        \"\"\"\n        validate_text(text)\n        return ''.join(self._shift_char(ch) for ch in text)\n\n    def _shift_char(self, ch: str) -> str:\n        \"\"\"\n        Helper method to shift a single character.\n\n        :param ch: The character to shift.\n        :return: The shifted character, or original if not a lowercase letter.\n        \"\"\"\n        if 'a' <= ch <= 'z':\n            return chr(self.LOWER_A + (ord(ch) - self.LOWER_A + self.shift) % self.ALPHABET_SIZE)\n        return ch\n\n```python\n# src/rotcipher/services.py\n\"\"\"\nApplication-level service for orchestrating encryption operations.\n\"\"\"\n\nimport logging\nfrom .cipher import RotCipher\nfrom .config import RotationConfig\n\nlogger = logging.getLogger(__name__)\n\nclass EncryptionService:\n    \"\"\"\n    Provides an application-level interface for encryption.\n    Delegates the core encryption logic to a RotCipher instance.\n    \"\"\"\n    def __init__(self, cipher: RotCipher = None) -> None:\n        \"\"\"\n        Initializes the EncryptionService with an optional RotCipher instance.\n\n        If no cipher is provided, a default RotCipher with DEFAULT_SHIFT is created.\n        \"\"\"\n        self._cipher: RotCipher = cipher or RotCipher(RotationConfig.DEFAULT_SHIFT)\n\n    def encrypt(self, text: str) -> str:\n        \"\"\"\n        Encrypts the given text using the configured RotCipher.\n\n        :param text: The string to encrypt.\n        :return: The encrypted string.\n        :raises TypeError: If the input text is not a string (propagated from RotCipher).\n        :raises RuntimeError: For unexpected exceptions during encryption.\n        \"\"\"\n        try:\n            return self._cipher.encrypt(text)\n        except (TypeError, ValueError):\n            # Propagate expected validation errors directly\n            raise\n        except Exception as e:\n            # Catch unexpected errors, log, and re-raise as RuntimeError\n            logger.exception(f\"An unexpected error occurred during encryption: {e}\")\n            raise RuntimeError(\"An internal error occurred during encryption.\") from e\n\n```python\n# src/rotcipher/controllers.py\n\"\"\"\nCLI controller responsible for parsing arguments, invoking the service, and handling output.\n\"\"\"\n\nimport sys\nimport argparse\nfrom typing import Sequence, Optional\n\nfrom .services import EncryptionService\nfrom .cipher import RotCipher\nfrom .config import RotationConfig\nfrom .models import EncryptRequest, EncryptResponse\n\nclass CLIController:\n    \"\"\"\n    Handles command-line interface interactions for the rotcipher application.\n    Parses arguments, calls the EncryptionService, and prints results.\n    \"\"\"\n    def __init__(self, service: Optional[EncryptionService] = None) -> None:\n        \"\"\"\n        Initializes the CLIController with an optional EncryptionService.\n\n        If no service is provided, a default EncryptionService is created.\n        \"\"\"\n        self._service: EncryptionService = service or EncryptionService(RotCipher(RotationConfig.DEFAULT_SHIFT))\n\n    def _print_help(self) -> None:\n        \"\"\"Prints the usage instructions to stderr.\"\"\"\n        help_message = (\n            \"Usage: rotcipher-cli <text_to_encrypt>\\n\"\n            \"       rotcipher-cli -\\n\\n\"\n            \"Encrypts lowercase alphabetic characters by rotating the alphabet by 4 positions.\\n\"\n            \"  <text_to_encrypt> : The string to encrypt.\\n\"\n            \"  -                 : Read text from standard input (stdin).\\n\"\n            \"Example:\\n\"\n            \"  rotcipher-cli 'hello world'  # Outputs 'lipps asvph'\\n\"\n            \"  echo 'test' | rotcipher-cli - # Outputs 'xiwx'\\n\"\n        )\n        print(help_message, file=sys.stderr)\n\n    def run_cli(self, argv: Sequence[str]) -> int:\n        \"\"\"\n        Executes the CLI logic based on the provided arguments.\n\n        :param argv: A sequence of command-line arguments (e.g., sys.argv[1:]).\n        :return: An exit code (0 for success, non-zero for failure).\n        \"\"\"\n        parser = argparse.ArgumentParser(\n            description=\"Encrypts text using a rotation cipher.\",\n            add_help=False  # Custom help handling\n        )\n        parser.add_argument(\n            'text_input',\n            nargs='?', # 0 or 1 argument\n            help=\"Text to encrypt. Use '-' to read from stdin.\"\n        )\n        parser.add_argument(\n            '-h', '--help', action='store_true',\n            help=\"Show this help message and exit.\"\n        )\n\n        args = parser.parse_args(argv)\n\n        if args.help or not argv:\n            self._print_help()\n            return 2 # Usage error\n\n        input_text = \"\"\n        if args.text_input == '-':\n            try:\n                input_text = sys.stdin.read().strip()\n            except Exception as e:\n                print(f\"Error reading from stdin: {e}\", file=sys.stderr)\n                return 1\n        elif args.text_input:\n            input_text = args.text_input\n        else:\n            self._print_help()\n            return 2 # No input provided, implicitly trigger help/usage\n\n        try:\n            request = EncryptRequest(input_text)\n            encrypted_text = self._service.encrypt(request.text)\n            response = EncryptResponse(encrypted_text)\n            print(response.result)\n            return 0\n        except TypeError as e:\n            print(f\"Error: Invalid input type - {e}\", file=sys.stderr)\n            return 1\n        except ValueError as e:\n            print(f\"Error: Invalid configuration - {e}\", file=sys.stderr)\n            return 1\n        except RuntimeError as e:\n            print(f\"Error: Internal application error - {e}\", file=sys.stderr)\n            return 1\n        except Exception as e:\n            print(f\"An unexpected error occurred: {e}\", file=sys.stderr)\n            return 1\n\n```python\n# src/rotcipher/cli.py\n\"\"\"\nEntry point for the rotcipher command-line interface.\n\"\"\"\n\nimport sys\nfrom typing import Optional, Sequence\n\n# Set up basic logging for the CLI, in case of unexpected errors from services\nimport logging\nlogging.basicConfig(level=logging.ERROR, format='%(asctime)s - %(levelname)s - %(message)s')\n\nfrom .controllers import CLIController\nfrom .services import EncryptionService\nfrom .cipher import RotCipher\nfrom .config import RotationConfig\n\ndef main(argv: Optional[Sequence[str]] = None) -> int:\n    \"\"\"\n    Main function for the rotcipher CLI entry point.\n\n    :param argv: Optional list of arguments, defaults to sys.argv[1:].\n    :return: An exit code (0 for success, non-zero for failure).\n    \"\"\"\n    _argv = argv if argv is not None else sys.argv[1:]\n\n    # Initialize dependencies\n    rot_config = RotationConfig(RotationConfig.DEFAULT_SHIFT)\n    rot_cipher = RotCipher(rot_config.default_shift)\n    encryption_service = EncryptionService(rot_cipher)\n    cli_controller = CLIController(encryption_service)\n\n    return cli_controller.run_cli(_argv)\n\nif __name__ == \"__main__\":\n    # This block is typically for direct execution of the script,\n    # but the console_scripts entry point handles it for installed packages.\n    # Raising SystemExit ensures the correct exit code is propagated.\n    raise SystemExit(main())\n\n```python\n# tests/test_cipher.py\nimport pytest\nfrom rotcipher.cipher import RotCipher\nfrom rotcipher.utils.validators import validate_text\n\ndef test_encrypt_basic():\n    \"\"\"Tests basic encryption with a shift of 4.\"\"\"\n    c = RotCipher(4)\n    assert c.encrypt(\"hi\") == \"lm\"\n    assert c.encrypt(\"asdfghjkl\") == \"ewhjklnop\"\n    assert c.encrypt(\"gf\") == \"kj\"\n    assert c.encrypt(\"et\") == \"ix\"\n\ndef test_encrypt_wraparound():\n    \"\"\"Tests that characters wrap around the alphabet correctly.\"\"\"\n    c = RotCipher(4)\n    assert c.encrypt(\"xyz\") == \"bcd\"\n    assert c.encrypt(\"zw\") == \"db\"\n    assert c.encrypt(\"a\") == \"e\"\n    assert c.encrypt(\"z\") == \"d\"\n\ndef test_encrypt_nonalpha_preserved():\n    \"\"\"Tests that non-lowercase alphabetic characters are preserved.\"\"\"\n    c = RotCipher(4)\n    assert c.encrypt(\"a-c 1!\") == \"e-c 1!\"\n    assert c.encrypt(\"Hello World! 123\") == \"Hello World! 123\" # Uppercase, space, punctuation, digits\n    assert c.encrypt(\"!@#$%^&*()_+\") == \"!@#$%^&*()_+\"\n    assert c.encrypt(\"\") == \"\"\n    assert c.encrypt(\" \") == \" \"\n\ndef test_encrypt_zero_shift():\n    \"\"\"Tests encryption with a zero shift, should return the original string.\"\"\"\n    c = RotCipher(0)\n    assert c.encrypt(\"abc\") == \"abc\"\n    assert c.encrypt(\"test\") == \"test\"\n\ndef test_encrypt_large_shift():\n    \"\"\"Tests encryption with a large shift, demonstrating modulo arithmetic.\"\"\"\n    c = RotCipher(30) # 30 % 26 = 4\n    assert c.encrypt(\"hi\") == \"lm\"\n    assert c.encrypt(\"xyz\") == \"bcd\"\n\ndef test_encrypt_invalid_input_type():\n    \"\"\"Ensures TypeError is raised for non-string input.\"\"\"\n    c = RotCipher(4)\n    with pytest.raises(TypeError) as excinfo:\n        c.encrypt(123)\n    assert \"Expected a string\" in str(excinfo.value)\n\n    with pytest.raises(TypeError) as excinfo:\n        c.encrypt(None)\n    assert \"Expected a string\" in str(excinfo.value)\n\n    with pytest.raises(TypeError) as excinfo:\n        c.encrypt(['a', 'b'])\n    assert \"Expected a string\" in str(excinfo.value)\n\ndef test_rotcipher_invalid_shift_type():\n    \"\"\"Ensures ValueError is raised if shift is not an integer during initialization.\"\"\"\n    with pytest.raises(ValueError) as excinfo:\n        RotCipher(\"4\")\n    assert \"shift must be an integer.\" in str(excinfo.value)\n\n    with pytest.raises(ValueError) as excinfo:\n        RotCipher(4.0)\n    assert \"shift must be an integer.\" in str(excinfo.value)\n\ndef test_validate_text_function():\n    \"\"\"Tests the standalone validate_text utility.\"\"\"\n    validate_text(\"valid string\") # Should not raise\n    with pytest.raises(TypeError):\n        validate_text(123)\n    with pytest.raises(TypeError):\n        validate_text(None)\n\n```python\n# tests/test_services.py\nimport pytest\nimport sys\nfrom io import StringIO\nfrom unittest.mock import Mock, patch\n\nfrom rotcipher.services import EncryptionService\nfrom rotcipher.cipher import RotCipher\nfrom rotcipher.config import RotationConfig\nfrom rotcipher.controllers import CLIController\n\n# --- Tests for EncryptionService ---\n\ndef test_service_encrypt_delegates_to_cipher():\n    \"\"\"Ensures EncryptionService.encrypt correctly calls RotCipher.encrypt.\"\"\"\n    mock_cipher = Mock(spec=RotCipher)\n    mock_cipher.encrypt.return_value = \"mocked_result\"\n\n    service = EncryptionService(cipher=mock_cipher)\n    result = service.encrypt(\"test_input\")\n\n    mock_cipher.encrypt.assert_called_once_with(\"test_input\")\n    assert result == \"mocked_result\"\n\ndef test_service_encrypt_uses_default_cipher():\n    \"\"\"Tests that EncryptionService creates a default RotCipher if none is provided.\"\"\"\n    service = EncryptionService()\n    # To check if it uses a default cipher, we can ensure it encrypts correctly\n    # with the default shift (4).\n    assert isinstance(service._cipher, RotCipher)\n    assert service._cipher.shift == RotationConfig.DEFAULT_SHIFT\n    assert service.encrypt(\"test\") == \"xiwx\"\n\ndef test_service_encrypt_propagates_type_error():\n    \"\"\"Ensures EncryptionService propagates TypeError from RotCipher.\"\"\"\n    mock_cipher = Mock(spec=RotCipher)\n    mock_cipher.encrypt.side_effect = TypeError(\"Mocked TypeError\")\n\n    service = EncryptionService(cipher=mock_cipher)\n    with pytest.raises(TypeError, match=\"Mocked TypeError\"):\n        service.encrypt(123) # Pass non-string to trigger error\n\ndef test_service_encrypt_handles_unexpected_exceptions():\n    \"\"\"Ensures EncryptionService wraps unexpected exceptions in RuntimeError.\"\"\"\n    mock_cipher = Mock(spec=RotCipher)\n    mock_cipher.encrypt.side_effect = Exception(\"An unexpected problem\")\n\n    service = EncryptionService(cipher=mock_cipher)\n    with pytest.raises(RuntimeError, match=\"An internal error occurred during encryption.\"):\n        service.encrypt(\"some_text\")\n\n\n# --- Tests for CLIController (Integration/Behavioral) ---\n\n@pytest.fixture\ndef cli_controller_with_mock_service():\n    \"\"\"Fixture to provide a CLIController with a mocked EncryptionService.\"\"\"\n    mock_service = Mock(spec=EncryptionService)\n    mock_service.encrypt.return_value = \"mocked_encrypted_output\"\n    controller = CLIController(service=mock_service)\n    return controller, mock_service\n\ndef test_cli_integration_basic_argument(capsys, cli_controller_with_mock_service):\n    \"\"\"Tests CLI with a direct text argument.\"\"\"\n    controller, mock_service = cli_controller_with_mock_service\n    argv = [\"hello\"]\n    exit_code = controller.run_cli(argv)\n\n    captured = capsys.readouterr()\n    assert exit_code == 0\n    assert captured.out.strip() == \"mocked_encrypted_output\"\n    assert captured.err == \"\"\n    mock_service.encrypt.assert_called_once_with(\"hello\")\n\ndef test_cli_integration_stdin_argument(capsys, cli_controller_with_mock_service, monkeypatch):\n    \"\"\"Tests CLI with stdin input.\"\"\"\n    controller, mock_service = cli_controller_with_mock_service\n    monkeypatch.setattr(sys, 'stdin', StringIO('test input from stdin'))\n    argv = [\"-\"]\n    exit_code = controller.run_cli(argv)\n\n    captured = capsys.readouterr()\n    assert exit_code == 0\n    assert captured.out.strip() == \"mocked_encrypted_output\"\n    assert captured.err == \"\"\n    mock_service.encrypt.assert_called_once_with(\"test input from stdin\")\n\ndef test_cli_integration_no_arguments_shows_help(capsys, cli_controller_with_mock_service):\n    \"\"\"Tests CLI behavior when no arguments are provided.\"\"\"\n    controller, _ = cli_controller_with_mock_service\n    argv = []\n    exit_code = controller.run_cli(argv)\n\n    captured = capsys.readouterr()\n    assert exit_code == 2 # Usage error\n    assert \"Usage: rotcipher-cli\" in captured.err\n    assert captured.out == \"\"\n\ndef test_cli_integration_help_flag(capsys, cli_controller_with_mock_service):\n    \"\"\"Tests CLI behavior with the --help flag.\"\"\"\n    controller, _ = cli_controller_with_mock_service\n    argv = [\"--help\"]\n    exit_code = controller.run_cli(argv)\n\n    captured = capsys.readouterr()\n    assert exit_code == 2\n    assert \"Usage: rotcipher-cli\" in captured.err\n    assert captured.out == \"\"\n\ndef test_cli_integration_type_error(capsys, cli_controller_with_mock_service):\n    \"\"\"Tests CLI handles TypeError from the service.\"\"\"\n    controller, mock_service = cli_controller_with_mock_service\n    # Configure mock service to raise TypeError for any input\n    mock_service.encrypt.side_effect = TypeError(\"Input must be a string\")\n\n    argv = [\"123\"] # This input is a string, but the mock service will still raise TypeError for demonstration\n    exit_code = controller.run_cli(argv)\n\n    captured = capsys.readouterr()\n    assert exit_code == 1\n    assert \"Error: Invalid input type - Input must be a string\" in captured.err\n    assert captured.out == \"\"\n    mock_service.encrypt.assert_called_once() # Ensure it was called\n\ndef test_cli_integration_runtime_error(capsys, cli_controller_with_mock_service):\n    \"\"\"Tests CLI handles RuntimeError from the service.\"\"\"\n    controller, mock_service = cli_controller_with_mock_service\n    mock_service.encrypt.side_effect = RuntimeError(\"An internal error occurred during encryption.\")\n\n    argv = [\"valid_input\"]\n    exit_code = controller.run_cli(argv)\n\n    captured = capsys.readouterr()\n    assert exit_code == 1\n    assert \"Error: Internal application error - An internal error occurred during encryption.\" in captured.err\n    assert captured.out == \"\"\n\ndef test_cli_integration_unhandled_exception(capsys, cli_controller_with_mock_service):\n    \"\"\"Tests CLI handles any other unexpected Exception.\"\"\"\n    controller, mock_service = cli_controller_with_mock_service\n    mock_service.encrypt.side_effect = Exception(\"Totally unexpected!\")\n\n    argv = [\"some_text\"]\n    exit_code = controller.run_cli(argv)\n\n    captured = capsys.readouterr()\n    assert exit_code == 1\n    assert \"An unexpected error occurred: Totally unexpected!\" in captured.err\n    assert captured.out == \"\"\n\n# Test cli.py entry point (full stack integration)\ndef test_cli_main_function_direct_call(capsys, monkeypatch):\n    \"\"\"Tests the main entry point function in cli.py with a direct argument.\"\"\"\n    from rotcipher.cli import main\n\n    monkeypatch.setattr(sys, 'argv', ['rotcipher-cli', 'abcd'])\n    exit_code = main()\n    captured = capsys.readouterr()\n    assert exit_code == 0\n    assert captured.out.strip() == \"efgh\"\n    assert captured.err == \"\"\n\ndef test_cli_main_function_stdin_call(capsys, monkeypatch):\n    \"\"\"Tests the main entry point function in cli.py with stdin input.\"\"\"\n    from rotcipher.cli import main\n\n    monkeypatch.setattr(sys, 'argv', ['rotcipher-cli', '-'])\n    monkeypatch.setattr(sys, 'stdin', StringIO('xyz'))\n    exit_code = main()\n    captured = capsys.readouterr()\n    assert exit_code == 0\n    assert captured.out.strip() == \"bcd\"\n    assert captured.err == \"\"\n\ndef test_cli_main_function_no_args(capsys, monkeypatch):\n    \"\"\"Tests the main entry point function in cli.py with no arguments.\"\"\"\n    from rotcipher.cli import main\n\n    monkeypatch.setattr(sys, 'argv', ['rotcipher-cli'])\n    exit_code = main()\n    captured = capsys.readouterr()\n    assert exit_code == 2\n    assert \"Usage: rotcipher-cli\" in captured.err\n\ndef test_cli_main_function_invalid_shift_config(capsys, monkeypatch):\n    \"\"\"Tests CLI main function with an invalid rotation config.\"\"\"\n    # This scenario is a bit harder to test via cli.main()\n    # as the RotCipher is instantiated with a fixed DEFAULT_SHIFT.\n    # To simulate, we'd need to mock RotCipher's constructor or the config.\n    # A more direct test for RotCipher's constructor already exists in test_cipher.py.\n    # For CLI integration, if an external factor or a future config change made\n    # the default shift invalid, it would likely fail at RotCipher instantiation.\n    # This specific test case might be more relevant for unit testing RotCipher/RotationConfig.\n    pass\n\n```toml\n# pyproject.toml\n[build-system]\nrequires = [\"setuptools>=61.0\"]\nbuild-backend = \"setuptools.build_meta\"\n\n[project]\nname = \"rotcipher-py\"\nversion = \"0.1.0\"\nauthors = [\n    { name=\"Your Name\", email=\"your.email@example.com\" },\n]\ndescription = \"A simple Python library for rotating alphabetic strings by a fixed amount.\"\nreadme = \"README.md\"\nrequires-python = \">=3.9\"\nkeywords = [\"cipher\", \"encryption\", \"rotation\", \"cli\", \"library\"]\nclassifiers = [\n    \"Programming Language :: Python :: 3\",\n    \"Programming Language :: Python :: 3.9\",\n    \"Programming Language :: Python :: 3.10\",\n    \"Programming Language :: Python :: 3.11\",\n    \"Programming Language :: Python :: 3.12\",\n    \"License :: OSI Approved :: MIT License\",\n    \"Operating System :: OS Independent\",\n    \"Development Status :: 3 - Alpha\",\n    \"Intended Audience :: Developers\",\n    \"Topic :: Security :: Cryptography\",\n    \"Topic :: Software Development :: Libraries :: Python Modules\",\n]\n\n[project.urls]\nHomepage = \"https://github.com/yourusername/rotcipher-py\"\n\"Bug Tracker\" = \"https://github.com/yourusername/rotcipher-py/issues\"\n\n[project.scripts]\nrotcipher-cli = \"rotcipher.cli:main\"\n\n[project.optional-dependencies]\ndev = [\n    \"pytest>=7.0\",\n    \"coverage>=6.0\",\n    \"flake8>=6.0\",\n    \"black>=23.0\",\n]\n\n```markdown\n# RotCipher-py\n\nA simple Python library and CLI tool for encrypting lowercase alphabetic strings by rotating the alphabet by a fixed amount.\n\n## 1. Overview\n\n`rotcipher-py` provides a reusable Python library and a command-line interface (CLI) to encrypt text using a rotation cipher (also known as a Caesar cipher). Only lowercase English alphabetic characters (`a` through `z`) are shifted, while all other characters (uppercase, numbers, symbols, spaces) are preserved. The default rotation amount is 4 positions.\n\n## 2. Features\n\n- **Library API**: Easily integrate encryption functionality into your Python applications.\n- **CLI Tool**: Quick encryption from your terminal.\n- **Modular Design**: Built with testability and extensibility in mind.\n- **Python 3.9+ Support**: Compatible with modern Python environments.\n\n## 3. Installation\n\nYou can install `rotcipher-py` using `pip`:\n\n```bash\npip install rotcipher-py\n```\n\nIf you want to install from source for development:\n\n```bash\ngit clone https://github.com/yourusername/rotcipher-py.git\ncd rotcipher-py\npip install .\npip install -e \".[dev]\" # for development dependencies like pytest\n```\n\n## 4. Usage\n\n### Command-Line Interface (CLI)\n\nThe package provides a `rotcipher-cli` command.\n\n**Encrypt a string directly:**\n\n```bash\nrotcipher-cli \"hello world\"\n# Output: lipps asvph\n```\n\n**Encrypt text from standard input (stdin):**\n\n```bash\necho \"test input\" | rotcipher-cli -\n# Output: xiwx mrpyx\n```\n\n**Get help:**\n\n```bash\nrotcipher-cli --help\n# Or simply\nrotcipher-cli\n```\n\n### Python Library\n\nYou can use the `rotcipher` library directly in your Python code.\n\n**Convenience function:**\n\n```python\nfrom rotcipher import encrypt\n\ntext_to_encrypt = \"python is fun\"\nencrypted_text = encrypt(text_to_encrypt)\nprint(encrypted_text)\n# Output: pyxlmr mw jyr\n```\n\n**Class-based API:**\n\nFor more control, dependency injection, or custom configurations, you can use the `EncryptionService` and `RotCipher` classes.\n\n```python\nfrom rotcipher import EncryptionService, RotCipher, RotationConfig\n\n# Use default configuration (shift = 4)\nservice = EncryptionService()\nprint(service.encrypt(\"hello\"))\n# Output: lipps\n\n# Create a custom cipher with a different shift (e.g., shift by 1)\ncustom_cipher = RotCipher(shift=1)\ncustom_service = EncryptionService(cipher=custom_cipher)\nprint(custom_service.encrypt(\"abc\"))\n# Output: bcd\n\n# Use RotationConfig for centralizing shift value\nconfig = RotationConfig(default_shift=5)\nconfigured_cipher = RotCipher(config.default_shift)\nconfigured_service = EncryptionService(cipher=configured_cipher)\nprint(configured_service.encrypt(\"apple\"))\n# Output: fuuqj\n```\n\n## 5. Development\n\nTo run tests and lint checks:\n\n```bash\npytest\nflake8 src/\nblack src/ --check\n```\n\nTo build the distributable package:\n\n```bash\npython -m build\n```\n\n## 6. License\n\nThis project is licensed under the MIT License - see the LICENSE file for details.\n```\n```\n# requirements.txt\npytest>=7.0\n```"}
{"task_id": "HumanEval/90", "solution": "def next_smallest(lst):\n    \"\"\"\n    Returns the 2nd smallest unique element of the list.\n    Returns None if there is no such element.\n    \"\"\"\n    min1 = None\n    min2 = None\n\n    for v in lst:\n        if min1 is None or v < min1:\n            if min1 is None or v != min1:\n                min2 = min1\n            min1 = v\n        elif v != min1 and (min2 is None or v < min2):\n            min2 = v\n            \n    return min2"}
{"task_id": "HumanEval/91", "solution": "```python\nimport re\n\ndef _get_first_token(sentence_text: str) -> str:\n    \"\"\"Extracts the first word from a sentence, stripping common surrounding punctuation.\"\"\"\n    parts = sentence_text.strip().split(maxsplit=1)\n    if not parts:\n        return \"\"\n    # Strip common punctuation from the first token as per design specification.\n    token = parts[0].strip(\".,;:\\\"'()[]\")\n    return token\n\ndef is_bored(S):\n    \"\"\"\n    Counts the number of \"boredoms\" in a string, where a boredom is a sentence\n    that starts with the word \"I\". Sentences are delimited by '.', '?' or '!'.\n    \"\"\"\n    boredom_count = 0\n    # Split text into potential sentences using regular expressions.\n    # This includes handling multiple delimiters and potential empty strings from splitting.\n    sentences_raw = re.split(r'[.!?]', S)\n\n    for sentence_text_raw in sentences_raw:\n        # Clean up whitespace for each extracted sentence fragment.\n        sentence_text = sentence_text_raw.strip()\n        \n        # Skip empty strings resulting from splitting or trimming.\n        if not sentence_text:\n            continue\n        \n        # Determine the first significant word of the sentence.\n        first_word = _get_first_token(sentence_text)\n        \n        # Increment count if the first word is exactly \"I\" (case-sensitive).\n        if first_word == \"I\":\n            boredom_count += 1\n            \n    return boredom_count\n```"}
{"task_id": "HumanEval/92", "solution": "```python\ndef any_int(x, y, z):\n    '''\n    Create a function that takes 3 numbers.\n    Returns true if one of the numbers is equal to the sum of the other two, and all numbers are integers.\n    '''\n    \n    # Check if all three numbers are numerically equivalent to integers.\n    if not (x == int(x) and y == int(y) and z == int(z)):\n        return False\n    \n    # After confirming all values are integers, check if one equals the sum of the other two.\n    return (x == y + z) or \\\n           (y == x + z) or \\\n           (z == x + y)\n```"}
{"task_id": "HumanEval/91", "solution": "import re\n\ndef is_bored(S):\n    \"\"\"Counts sentences starting with \"I\" in a given text.\n    Sentences are delimited by '.', '?' or '!' and \"I\" is case-insensitive.\n    \"\"\"\n    boredom_count = 0\n    # Split text into sentences using '.', '?', or '!' as delimiters.\n    # The regex `[.?!]+` handles sequences of delimiters as a single separator.\n    sentences = re.split(r\"[.?!]+\", S)\n\n    for sentence in sentences:\n        trimmed_sentence = sentence.strip()\n        if not trimmed_sentence:\n            continue\n\n        # Strip leading punctuation/quotes/whitespace from the sentence.\n        # This removes characters like spaces, double/single quotes, parentheses,\n        # and square brackets as specified in the design.\n        cleaned_sentence = re.sub(r'^[\\s\"\\'(\\[]+', '', trimmed_sentence)\n\n        if not cleaned_sentence:\n            continue\n\n        # Extract the first whitespace-delimited token.\n        # Using maxsplit=1 makes it efficient as we only need the first word.\n        first_word = cleaned_sentence.split(maxsplit=1)[0]\n\n        # Check if the first token is \"I\" exactly, case-insensitively.\n        # This ensures contractions like \"I'm\" are not counted.\n        if first_word.lower() == \"i\":\n            boredom_count += 1\n\n    return boredom_count"}
{"task_id": "HumanEval/93", "solution": "def encode(message):\n    \"\"\"\n    Encodes a message by swapping case and shifting vowels two places forward.\n    Assumes message contains only letters and spaces.\n    \"\"\"\n    VOWELS = {'a', 'e', 'i', 'o', 'u'}\n    SHIFT_OFFSET = 2\n\n    def _shift_letter(char: str, offset: int) -> str:\n        \"\"\"Shifts an English letter by a given offset, preserving case and wrapping alphabetically.\"\"\"\n        base = ord('A') if char.isupper() else ord('a')\n        shifted_ord = (ord(char) - base + offset) % 26 + base\n        return chr(shifted_ord)\n\n    # First pass: Case Swap\n    case_swapped_chars = []\n    for char in message:\n        if char.isalpha():\n            case_swapped_chars.append(char.swapcase())\n        else:  # Presumed to be a space, per problem description and examples\n            case_swapped_chars.append(char)\n    swapped_text = \"\".join(case_swapped_chars)\n\n    # Second pass: Vowel Shift\n    final_encoded_chars = []\n    for char in swapped_text:\n        if char.isalpha() and char.lower() in VOWELS:\n            final_encoded_chars.append(_shift_letter(char, SHIFT_OFFSET))\n        else:\n            final_encoded_chars.append(char)\n\n    return \"\".join(final_encoded_chars)"}
{"task_id": "HumanEval/92", "solution": "```python\n# src/anyint_app/__init__.py\nimport sys\nimport os\nfrom typing import Any, List, Optional\n\n# Lazily import internal components to avoid circular dependencies during initial package load\n# and to make the top-level API cleaner.\n# These will be initialized within the any_int function or cli.main.\n\n__version__ = \"0.1.0\"\n\ndef any_int(a: Any, b: Any, c: Any) -> bool:\n    \"\"\"\n    Evaluates if one number equals the sum of the other two, and all are strict integers.\n    This is the public library entry point.\n    \"\"\"\n    # Import components locally to avoid exposing them and manage dependencies for the API call\n    from anyint_app.config import Config\n    from anyint_app.repository import ResultRepository\n    from anyint_app.services import AnyIntService\n    from anyint_app.controllers import AnyIntController\n\n    # For the direct library call, we don't need persistence by default,\n    # but the service itself might depend on a validator.\n    # We can create minimal instances for the library API.\n    # The AnyIntController.evaluate_and_persist handles full logging.\n    # The pure service evaluate method is used here for simplicity.\n    service = AnyIntService()\n    return service.evaluate(a, b, c)\n\n```\n```python\n# src/anyint_app/config.py\nimport os\n\nDEFAULT_LOG_PATH = \"./logs/results.jsonl\"\n\nclass Config:\n    \"\"\"\n    Configuration container for application settings, such as log file path.\n    \"\"\"\n    def __init__(self, log_path: str = DEFAULT_LOG_PATH) -> None:\n        self.log_path = log_path\n\n    def ensure_log_dir(self) -> None:\n        \"\"\"\n        Ensures the parent directory for the log file exists.\n        \"\"\"\n        log_dir = os.path.dirname(self.log_path)\n        if log_dir and not os.path.exists(log_dir):\n            os.makedirs(log_dir, exist_ok=True)\n\n```\n```python\n# src/anyint_app/dto.py\nimport json\nfrom typing import Any, Dict\n\nclass NumbersDTO:\n    \"\"\"\n    Data Transfer Object for three integer numbers.\n    \"\"\"\n    def __init__(self, a: int, b: int, c: int) -> None:\n        self.a = a\n        self.b = b\n        self.c = c\n\n    @classmethod\n    def from_any(cls, a: Any, b: Any, c: Any) -> 'NumbersDTO':\n        \"\"\"\n        Creates NumbersDTO from any types, strictly checking for int.\n        Raises ValueError if any input is not a strict integer.\n        \"\"\"\n        # This explicit check is needed as per spec, even though InputValidator does similar.\n        # DTO itself provides a strong typing boundary for its constructor.\n        if not (isinstance(a, int) and not isinstance(a, bool) and\n                isinstance(b, int) and not isinstance(b, bool) and\n                isinstance(c, int) and not isinstance(c, bool)):\n            raise ValueError(\"All inputs must be strict integers for NumbersDTO.\")\n        return cls(a, b, c)\n\n    def to_dict(self) -> Dict[str, int]:\n        \"\"\"Converts the DTO to a dictionary.\"\"\"\n        return {\"a\": self.a, \"b\": self.b, \"c\": self.c}\n\n\nclass ResultDTO:\n    \"\"\"\n    Data Transfer Object for an evaluation result including timestamp, inputs, and outcome.\n    \"\"\"\n    def __init__(self, timestamp: str, numbers: NumbersDTO, result: bool) -> None:\n        self.timestamp = timestamp\n        self.numbers = numbers\n        self.result = result\n\n    def to_json_line(self) -> str:\n        \"\"\"\n        Serializes the ResultDTO to a JSON string suitable for JSON Lines format.\n        \"\"\"\n        data = {\n            \"timestamp\": self.timestamp,\n            \"numbers\": self.numbers.to_dict(),\n            \"result\": self.result\n        }\n        return json.dumps(data)\n\n```\n```python\n# src/anyint_app/validators.py\nfrom typing import Any\nfrom anyint_app.dto import NumbersDTO\n\nclass ValidationError(Exception):\n    \"\"\"\n    Custom exception for input validation failures.\n    \"\"\"\n    pass\n\nclass InputValidator:\n    \"\"\"\n    Validates inputs based on the strict integer requirement.\n    \"\"\"\n    def are_integers(self, a: Any, b: Any, c: Any) -> bool:\n        \"\"\"\n        Checks if all three inputs are strict integers (not floats or booleans).\n        \"\"\"\n        def is_strict_int(x: Any) -> bool:\n            return isinstance(x, int) and not isinstance(x, bool)\n        return is_strict_int(a) and is_strict_int(b) and is_strict_int(c)\n\n    def ensure_integers_or_raise(self, a: Any, b: Any, c: Any) -> NumbersDTO:\n        \"\"\"\n        Ensures inputs are strict integers or raises a ValidationError.\n        \"\"\"\n        if not self.are_integers(a, b, c):\n            raise ValidationError(\"All inputs must be strict integers (bool is not accepted).\")\n        return NumbersDTO(a=a, b=b, c=c)\n\n```\n```python\n# src/anyint_app/utils.py\nimport datetime\nfrom typing import Optional\n\ndef parse_int_safe(val: str) -> Optional[int]:\n    \"\"\"\n    Safely attempts to parse a string to an integer, returning None on failure.\n    \"\"\"\n    try:\n        # Check if the string represents a float before int conversion\n        if '.' in val:\n            float_val = float(val)\n            # If it's a float with a decimal part, it's not a strict integer\n            if float_val != int(float_val):\n                return None\n            # If it's like \"3.0\", still consider it not a strict int from string for CLI\n            if float_val == int(float_val) and len(val) > len(str(int(float_val))) and '.' in val:\n                return None\n        return int(val)\n    except (ValueError, TypeError):\n        return None\n\ndef now_iso() -> str:\n    \"\"\"\n    Returns the current UTC time in ISO 8601 format.\n    \"\"\"\n    return datetime.datetime.now(datetime.timezone.utc).isoformat(timespec='seconds').replace('+00:00', 'Z')\n\n```\n```python\n# src/anyint_app/services.py\nfrom typing import Any, Optional\nfrom anyint_app.validators import InputValidator\n\nclass AnyIntService:\n    \"\"\"\n    Core business logic service to evaluate the sum relation.\n    \"\"\"\n    def __init__(self, validator: Optional[InputValidator] = None) -> None:\n        self._validator = validator or InputValidator()\n\n    def evaluate(self, a: Any, b: Any, c: Any) -> bool:\n        \"\"\"\n        Evaluates if one value equals the sum of the other two, after validation.\n        Returns False for non-integer inputs, aligning with library behavior.\n        \"\"\"\n        if not self._validator.are_integers(a, b, c):\n            return False\n        # Cast to int is safe here because validator ensured they are strict ints.\n        return self._check_sum(int(a), int(b), int(c))\n\n    def _check_sum(self, a: int, b: int, c: int) -> bool:\n        \"\"\"\n        Checks if one integer equals the sum of the other two.\n        Assumes inputs are already validated as integers.\n        \"\"\"\n        return a == b + c or b == a + c or c == a + b\n\n```\n```python\n# src/anyint_app/repository.py\nimport json\nimport os\nfrom typing import List\nfrom anyint_app.dto import ResultDTO, NumbersDTO\n\nclass ResultRepository:\n    \"\"\"\n    Manages persistence of evaluation results to a JSON Lines file.\n    \"\"\"\n    def __init__(self, log_path: str) -> None:\n        self.log_path = log_path\n\n    def append_result(self, result: ResultDTO) -> None:\n        \"\"\"\n        Appends a ResultDTO to the log file as a JSON line.\n        Ensures parent directory exists before writing.\n        \"\"\"\n        log_dir = os.path.dirname(self.log_path)\n        if log_dir and not os.path.exists(log_dir):\n            os.makedirs(log_dir, exist_ok=True) # Ensure dir exists\n\n        with open(self.log_path, 'a', encoding='utf-8') as f:\n            f.write(result.to_json_line() + '\\n')\n\n    def read_all(self) -> List[ResultDTO]:\n        \"\"\"\n        Reads all ResultDTOs from the log file.\n        Returns an empty list if the file does not exist or is empty.\n        \"\"\"\n        results = []\n        if not os.path.exists(self.log_path):\n            return results\n\n        with open(self.log_path, 'r', encoding='utf-8') as f:\n            for line in f:\n                try:\n                    data = json.loads(line)\n                    numbers = NumbersDTO(\n                        a=data['numbers']['a'],\n                        b=data['numbers']['b'],\n                        c=data['numbers']['c']\n                    )\n                    result_dto = ResultDTO(\n                        timestamp=data['timestamp'],\n                        numbers=numbers,\n                        result=data['result']\n                    )\n                    results.append(result_dto)\n                except (json.JSONDecodeError, KeyError, ValueError) as e:\n                    # Log error if a line is malformed but continue parsing\n                    print(f\"Warning: Could not parse log line: {line.strip()}. Error: {e}\", file=sys.stderr)\n        return results\n\n```\n```python\n# src/anyint_app/controllers.py\nimport sys\nfrom typing import Any, List\nfrom anyint_app.services import AnyIntService\nfrom anyint_app.repository import ResultRepository\nfrom anyint_app.dto import ResultDTO\nfrom anyint_app.validators import ValidationError, InputValidator\nfrom anyint_app.utils import now_iso, parse_int_safe\n\nclass AnyIntController:\n    \"\"\"\n    Orchestrates validation, business logic execution, and persistence.\n    \"\"\"\n    def __init__(self, service: AnyIntService, repository: ResultRepository) -> None:\n        self.service = service\n        self.repository = repository\n        self._validator = InputValidator() # Controller uses validator for strict checks\n\n    def evaluate_and_persist(self, a: Any, b: Any, c: Any) -> bool:\n        \"\"\"\n        Validates inputs strictly, computes the result, persists it, and returns the boolean outcome.\n        Raises ValidationError for invalid input types.\n        \"\"\"\n        # Strictly validate and convert to NumbersDTO, raising ValidationError on failure.\n        # This is where the CLI's strict error handling for malformed input occurs.\n        numbers_dto = self._validator.ensure_integers_or_raise(a, b, c)\n\n        # Compute the result using the service's core logic\n        # We can pass the already validated int values.\n        result_bool = self.service._check_sum(numbers_dto.a, numbers_dto.b, numbers_dto.c)\n\n        # Create ResultDTO and persist it\n        result_dto = ResultDTO(\n            timestamp=now_iso(),\n            numbers=numbers_dto,\n            result=result_bool\n        )\n        try:\n            self.repository.append_result(result_dto)\n        except IOError as e:\n            print(f\"Warning: Failed to log evaluation result to {self.repository.log_path}. Error: {e}\", file=sys.stderr)\n\n        return result_bool\n\n\nclass CLIController:\n    \"\"\"\n    Handles command-line argument parsing, error reporting, and orchestrates the AnyIntController.\n    \"\"\"\n    def __init__(self, controller: AnyIntController) -> None:\n        self.controller = controller\n\n    def run_from_argv(self, argv: List[str]) -> int:\n        \"\"\"\n        Parses command-line arguments, executes the evaluation, and prints the result.\n        Returns an exit code (0 for success, non-zero for errors).\n        \"\"\"\n        if len(argv) != 3:\n            print(\"Usage: anyint <number1> <number2> <number3>\", file=sys.stderr)\n            return 2  # Incorrect usage exit code\n\n        raw_inputs = argv[0:3]\n        parsed_inputs = [parse_int_safe(arg) for arg in raw_inputs]\n\n        # Check if any parsing failed\n        if any(x is None for x in parsed_inputs):\n            print(\"Error: All inputs must be valid integers.\", file=sys.stderr)\n            print(\"Usage: anyint <number1> <number2> <number3>\", file=sys.stderr)\n            return 2 # Malformed argument exit code\n\n        try:\n            # Type hinting suggests parsed_inputs are Optional[int], but we've checked for None\n            result = self.controller.evaluate_and_persist(\n                parsed_inputs[0], parsed_inputs[1], parsed_inputs[2]\n            )\n            print(str(result))\n            return 0  # Success\n        except ValidationError as e:\n            # This shouldn't be reached if parse_int_safe and ensure_integers_or_raise are consistent.\n            # But it serves as a robust fallback for type validation.\n            print(f\"Error: {e}\", file=sys.stderr)\n            return 1 # Internal validation error\n        except Exception as e:\n            print(f\"An unexpected error occurred: {e}\", file=sys.stderr)\n            return 1 # General error\n\n```\n```python\n# src/anyint_app/cli.py\nimport sys\nfrom typing import List, Optional\n\ndef main(argv: Optional[List[str]] = None) -> int:\n    \"\"\"\n    Main entry point for the CLI application.\n    Initializes components and runs the CLI controller.\n    \"\"\"\n    # Import locally to avoid side effects on module import\n    from anyint_app.config import Config\n    from anyint_app.repository import ResultRepository\n    from anyint_app.services import AnyIntService\n    from anyint_app.controllers import AnyIntController, CLIController\n\n    # Use sys.argv if no arguments are provided (typical CLI behavior)\n    argv = argv if argv is not None else sys.argv[1:]\n\n    # Configure and initialize dependencies\n    cfg = Config()\n    cfg.ensure_log_dir() # Ensure log directory exists\n    \n    repository = ResultRepository(cfg.log_path)\n    service = AnyIntService()\n    controller = AnyIntController(service, repository)\n    cli_controller = CLIController(controller)\n\n    # Run the CLI logic\n    return cli_controller.run_from_argv(argv)\n\nif __name__ == '__main__':\n    sys.exit(main())\n\n```"}
{"task_id": "HumanEval/93", "solution": "```python\ndef encode(message):\n    \"\"\"\n    Encodes a message by swapping letter case, then shifting vowels by two places ahead in the alphabet, preserving non-letters.\n    Vowel replacement occurs after case swap, and wraps around the alphabet (e.g., Y->A if vowel).\n    \"\"\"\n    transformed_chars = []\n    vowels = {'A', 'E', 'I', 'O', 'U', 'a', 'e', 'i', 'o', 'u'}\n\n    for char in message:\n        if not char.isalpha():\n            transformed_chars.append(char)\n            continue\n\n        swapped_char = char.swapcase()\n\n        if swapped_char in vowels:\n            base = ord('A') if swapped_char.isupper() else ord('a')\n            current_index = ord(swapped_char) - base\n            new_index = (current_index + 2) % 26\n            shifted_char = chr(base + new_index)\n            transformed_chars.append(shifted_char)\n        else:\n            transformed_chars.append(swapped_char)\n\n    return ''.join(transformed_chars)\n```"}
{"task_id": "HumanEval/94", "solution": "def skjkasdkd(lst):\n    \"\"\"You are given a list of integers.\n    You need to find the largest prime value and return the sum of its digits.\n    \"\"\"\n\n    def is_prime(n: int) -> bool:\n        \"\"\"Checks if a number is prime using an optimized trial division method.\"\"\"\n        if n < 2:\n            return False\n        if n == 2 or n == 3:\n            return True\n        if n % 2 == 0 or n % 3 == 0:\n            return False\n        i = 5\n        while i * i <= n:\n            if n % i == 0 or n % (i + 2) == 0:\n                return False\n            i += 6\n        return True\n\n    def sum_digits(n: int) -> int:\n        \"\"\"Calculates the sum of the decimal digits of the absolute value of an integer.\"\"\"\n        return sum(int(digit) for digit in str(abs(n)))\n\n    largest_prime = None\n\n    for num in lst:\n        if num >= 2 and is_prime(num):\n            if largest_prime is None or num > largest_prime:\n                largest_prime = num\n\n    return sum_digits(largest_prime)"}
{"task_id": "HumanEval/94", "solution": "def skjkasdkd(lst):\n    \"\"\"Finds the largest prime in a list and returns the sum of its digits.\n    Uses Miller-Rabin for primality testing, suitable for large numbers.\n    \"\"\"\n\n    def _is_prime(n: int) -> bool:\n        \"\"\"Performs primality test using basic checks and deterministic Miller-Rabin for larger integers.\n        Bases are chosen for deterministic results up to 64-bit unsigned integers.\n        \"\"\"\n        if n < 2:\n            return False\n        if n == 2 or n == 3:\n            return True\n        if n % 2 == 0 or n % 3 == 0:\n            return False\n\n        # Miller-Rabin for numbers >= 5\n        # Bases for deterministic test up to 3,317,044,064,679,887,385 (covers all 64-bit unsigned integers)\n        # For N larger than this, it acts as a strong probabilistic primality test with fixed bases.\n        bases = (2, 325, 9375, 28178, 450775, 9780504, 1795265022)\n\n        def _power(base, exp, mod):\n            \"\"\"Calculates (base^exp) % mod using modular exponentiation.\"\"\"\n            res = 1\n            base %= mod\n            while exp > 0:\n                if exp % 2 == 1:\n                    res = (res * base) % mod\n                base = (base * base) % mod\n                exp //= 2\n            return res\n\n        def _miller_rabin_test_round(d, n, a):\n            \"\"\"Performs a single round of Miller-Rabin primality test for a given base 'a'.\"\"\"\n            x = _power(a, d, n)\n            if x == 1 or x == n - 1:\n                return True\n            while d != n - 1:\n                x = (x * x) % n\n                d *= 2\n                if x == 1:\n                    return False\n                if x == n - 1:\n                    return True\n            return False\n\n        # Factor n-1 as d * 2^r where d is odd\n        d = n - 1\n        while d % 2 == 0:\n            d //= 2\n\n        for a in bases:\n            if not _miller_rabin_test_round(d, n, a):\n                return False\n        return True\n\n    def _sum_digits(num: int) -> int:\n        \"\"\"Calculates the sum of digits of an integer, using its absolute value.\"\"\"\n        return sum(int(d) for d in str(abs(num)))\n\n    max_prime = None\n\n    for number in lst:\n        if _is_prime(number):\n            if max_prime is None or number > max_prime:\n                max_prime = number\n\n    if max_prime is None:\n        return 0\n    else:\n        return _sum_digits(max_prime)"}
{"task_id": "HumanEval/95", "solution": "```python\ndef check_dict_case(dict):\n    \"\"\"\n    Given a dictionary, return True if all keys are strings in lower\n    case or all keys are strings in upper case, else return False.\n    The function should return False is the given dictionary is empty.\n    \"\"\"\n    if not dict:\n        return False\n\n    all_lowercase = True\n    for key in dict.keys():\n        # Adhering to critical requirements: trust caller's input, no isinstance, no error handling.\n        # Non-string keys, if provided, will cause an AttributeError during .lower().\n        if key != key.lower():\n            all_lowercase = False\n            break\n\n    if all_lowercase:\n        return True\n\n    all_uppercase = True\n    for key in dict.keys():\n        # Adhering to critical requirements: trust caller's input, no isinstance, no error handling.\n        # Non-string keys, if provided, will cause an AttributeError during .upper().\n        if key != key.upper():\n            all_uppercase = False\n            break\n\n    if all_uppercase:\n        return True\n\n    return False\n```"}
{"task_id": "HumanEval/95", "solution": "def check_dict_case(dict):\n    \"\"\"\n    Checks if all dictionary keys are strings, and either all lowercase or all uppercase.\n    Returns False if the dictionary is empty or contains non-string/mixed-case keys.\n    \"\"\"\n    if not dict:\n        return False\n\n    keys = list(dict.keys())\n\n    # First, ensure all keys are strings to avoid AttributeErrors.\n    for key in keys:\n        if not isinstance(key, str):\n            return False\n\n    # Check if all keys are entirely lowercase.\n    all_keys_are_lower = True\n    for key in keys:\n        if key != key.lower():\n            all_keys_are_lower = False\n            break\n\n    if all_keys_are_lower:\n        return True\n\n    # If not all lowercase, check if all keys are entirely uppercase.\n    all_keys_are_upper = True\n    for key in keys:\n        if key != key.upper():\n            all_keys_are_upper = False\n            break\n\n    return all_keys_are_upper"}
{"task_id": "HumanEval/96", "solution": "import math\nfrom typing import List\n\ndef count_up_to(n: int) -> List[int]:\n    \"\"\"Returns all prime integers strictly less than n.\n    Implements the Sieve of Eratosthenes algorithm.\"\"\"\n\n    if n <= 2:\n        return []\n\n    sieve = bytearray(b\"\\x01\") * n\n    sieve[0:2] = b\"\\x00\\x00\" # 0 and 1 are not prime\n\n    for p in range(2, int(n**0.5) + 1):\n        if sieve[p]:\n            start_index = p * p\n            if start_index < n:\n                # Mark multiples of p as not prime, starting from p*p.\n                # The length calculation for the bytearray of zeros ensures correct slicing.\n                sieve[start_index:n:p] = b\"\\x00\" * ((n - 1 - start_index) // p + 1)\n\n    primes_list = [i for i, is_prime_flag in enumerate(sieve) if is_prime_flag]\n\n    return primes_list"}
