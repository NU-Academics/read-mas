{"task_id": "HumanEval/42", "solution": "```python\n# root/src/list_incrementer/__init__.py\n# Package init; exports public API\nfrom .services import IncrementService\nfrom .utils import Validator\nfrom .repository import MetricsRepository\nfrom .adapters import JsonAdapter\nfrom .controllers import CLIController, APIController\nfrom .api_app import APIApp\nfrom .cli_app import CLIApp\nfrom .config import MAX_LIST_SIZE, METRICS_PATH, API_KEY, PORT\nfrom .exceptions import ValidationError, IncrementError\nfrom .models import ListInput, ListOutput, MetricsRecord\n\n# This __init__.py does not expose a top-level `incr_list` function directly as in the initial prompt,\n# because the full design specification integrates it into `IncrementService`.\n# Consumers would typically instantiate and use `IncrementService` or the `CLIApp`/`APIApp`.\n\n# For example, to use the core logic directly (if desired outside of service context):\n# def incr_list(l: list[int]) -> list[int]:\n#     \"\"\"Return list with elements incremented by 1.\"\"\"\n#     return [x + 1 for x in l]\n#\n# But per the full design, this is a method of IncrementService.\n\n```\n\n```python\n# root/src/list_incrementer/models.py\n# Data models and DTOs using pydantic for validation and serialization.\nfrom pydantic import BaseModel, Field, ValidationError as PydanticValidationError\nfrom typing import List, Literal, Optional\n\nclass ListInput(BaseModel):\n    \"\"\"Input DTO for lists of integers.\"\"\"\n    values: List[int] = Field(..., description=\"List of integers to increment\")\n\n    @classmethod\n    def validate_values(cls, values: List) -> 'ListInput':\n        \"\"\"Convenience constructor that validates shape via pydantic.\"\"\"\n        try:\n            return cls(values=values)\n        except PydanticValidationError as e:\n            raise ValueError(f\"Invalid input format: {e}\") # Convert for consistency if needed\n\nclass ListOutput(BaseModel):\n    \"\"\"Output DTO for incremented lists of integers.\"\"\"\n    values: List[int] = Field(..., description=\"List of incremented integers\")\n\nclass MetricsRecord(BaseModel):\n    \"\"\"Record schema for basic usage metrics.\"\"\"\n    usage_count: int = Field(0, description=\"Number of times the feature was used.\")\n    last_run_iso: Optional[str] = Field(None, description=\"ISO8601 timestamp of the last run.\")\n\nclass HealthCheck(BaseModel):\n    \"\"\"Simple health check response model.\"\"\"\n    status: Literal[\"ok\", \"error\"]\n    message: Optional[str] = None\n```\n\n```python\n# root/src/list_incrementer/exceptions.py\n# Domain-specific exceptions for the list incrementer.\nclass ValidationError(ValueError):\n    \"\"\"Raised when input fails validation rules.\"\"\"\n    def __init__(self, message: str) -> None:\n        self.message = message\n        super().__init__(self.message)\n\nclass IncrementError(Exception):\n    \"\"\"Raised for unexpected internal errors during processing.\"\"\"\n    def __init__(self, message: str = \"An unexpected error occurred during increment operation.\") -> None:\n        self.message = message\n        super().__init__(self.message)\n```\n\n```python\n# root/src/list_incrementer/utils.py\n# Helpers and input validation logic for the list incrementer.\nfrom typing import List, Any, Union\nfrom .exceptions import ValidationError\n\nclass Validator:\n    \"\"\"Provides methods for validating lists and their elements.\"\"\"\n    MAX_LIST_SIZE: int = 10000 # Default maximum list size.\n\n    def __init__(self, max_size: Union[int, None] = None) -> None:\n        \"\"\"Initialize validator with a custom max list size or use default.\"\"\"\n        self._max_size = max_size if max_size is not None else self.MAX_LIST_SIZE\n\n    def validate_list(self, values: Any) -> List[int]:\n        \"\"\"Validates that the input is a list of integers within size limits.\"\"\"\n        if not isinstance(values, list):\n            raise ValidationError(\"Input must be a list.\")\n        \n        if len(values) > self._max_size:\n            raise ValidationError(f\"List size exceeds maximum allowed of {self._max_size}.\")\n        \n        validated_list: List[int] = []\n        for idx, val in enumerate(values):\n            validated_list.append(self._validate_element(idx, val))\n        \n        return validated_list\n\n    def _validate_element(self, idx: int, val: Any) -> int:\n        \"\"\"Validates a single element, ensuring it's a non-boolean integer.\"\"\"\n        if isinstance(val, bool) or not isinstance(val, int):\n            raise ValidationError(f\"Element at index {idx} is not an integer: {val!r}.\")\n        # Python ints have arbitrary precision, so \"safe range\" is always true for them.\n        return val\n```\n\n```python\n# root/src/list_incrementer/repository.py\n# Persistence layer for metrics, handling JSON file operations.\nimport json\nimport logging\nimport os\nimport pathlib\nfrom datetime import datetime, timezone\nfrom typing import Dict\nfrom .models import MetricsRecord\n\nlogger = logging.getLogger(__name__)\n\nclass MetricsRepository:\n    \"\"\"Manages persistence of usage metrics to a local JSON file.\"\"\"\n    def __init__(self, path: pathlib.Path) -> None:\n        \"\"\"Initialize repository with the path to the metrics file.\"\"\"\n        self._path = path\n        self._path.parent.mkdir(parents=True, exist_ok=True) # Ensure data directory exists.\n\n    def load(self) -> Dict[str, MetricsRecord]:\n        \"\"\"Loads metrics from the file, returning default records if file is missing.\"\"\"\n        if not self._path.exists():\n            return {\n                \"cli\": MetricsRecord(usage_count=0, last_run_iso=None),\n                \"api\": MetricsRecord(usage_count=0, last_run_iso=None)\n            }\n        try:\n            with open(self._path, 'r', encoding='utf-8') as f:\n                data = json.load(f)\n                # Ensure all keys exist and convert to MetricsRecord objects\n                loaded_metrics: Dict[str, MetricsRecord] = {}\n                for role_key in [\"cli\", \"api\"]:\n                    role_data = data.get(role_key, {})\n                    loaded_metrics[role_key] = MetricsRecord(\n                        usage_count=role_data.get(\"usage_count\", 0),\n                        last_run_iso=role_data.get(\"last_run_iso\", None)\n                    )\n                return loaded_metrics\n        except (json.JSONDecodeError, FileNotFoundError, IOError) as e:\n            logger.error(f\"Failed to load metrics from {self._path}: {e}\")\n            # Return defaults on error to prevent crashing, consistent with best-effort.\n            return {\n                \"cli\": MetricsRecord(usage_count=0, last_run_iso=None),\n                \"api\": MetricsRecord(usage_count=0, last_run_iso=None)\n            }\n\n    def save(self, metrics_data: Dict[str, MetricsRecord]) -> None:\n        \"\"\"Saves the current state of metrics to the file atomically.\"\"\"\n        temp_path = self._path.with_suffix('.json.tmp')\n        try:\n            # Convert MetricsRecord to dictionary before saving\n            serializable_data = {\n                role: record.model_dump() for role, record in metrics_data.items()\n            }\n            with open(temp_path, 'w', encoding='utf-8') as f:\n                json.dump(serializable_data, f, indent=2)\n            os.replace(temp_path, self._path) # Atomic replacement\n        except IOError as e:\n            logger.error(f\"Failed to save metrics to {self._path}: {e}\")\n        finally:\n            if temp_path.exists():\n                os.remove(temp_path)\n\n    def update_usage(self, role: str) -> None:\n        \"\"\"Increments usage count and updates timestamp for a specific role.\"\"\"\n        metrics = self.load()\n        if role not in metrics:\n            logger.warning(f\"Attempted to update metrics for unknown role: {role}. Initializing default.\")\n            metrics[role] = MetricsRecord(usage_count=0, last_run_iso=None)\n            \n        record = metrics[role]\n        record.usage_count += 1\n        record.last_run_iso = datetime.now(timezone.utc).isoformat()\n        self.save(metrics)\n```\n\n```python\n# root/src/list_incrementer/adapters.py\n# JSON serialization/deserialization helpers for CLI and tests.\nimport json\nfrom typing import List, Any\nfrom .exceptions import ValidationError\n\nclass JsonAdapter:\n    \"\"\"Handles JSON encoding and decoding for lists of integers.\"\"\"\n    def dumps(self, values: List[int]) -> str:\n        \"\"\"Converts a list of integers into a compact JSON string.\"\"\"\n        return json.dumps(values)\n\n    def loads(self, json_text: str) -> List[Any]:\n        \"\"\"Parses a JSON string into a Python list.\"\"\"\n        try:\n            data = json.loads(json_text)\n            if not isinstance(data, list):\n                raise ValidationError(\"JSON input must be a list.\")\n            return data\n        except json.JSONDecodeError as e:\n            raise ValidationError(f\"Invalid JSON format: {e}\")\n```\n\n```python\n# root/src/list_incrementer/services.py\n# Core business logic for incrementing lists and orchestrating metrics.\nimport logging\nfrom typing import List, Any\nfrom .utils import Validator\nfrom .repository import MetricsRepository\nfrom .exceptions import ValidationError, IncrementError\n\nlogger = logging.getLogger(__name__)\n\nclass IncrementService:\n    \"\"\"Encapsulates the core logic for incrementing list elements and usage recording.\"\"\"\n    def __init__(self, validator: Validator, repository: MetricsRepository) -> None:\n        \"\"\"Initialize the service with injected validator and metrics repository.\"\"\"\n        self._validator = validator\n        self._repo = repository\n\n    def incr_list(self, values: List[int]) -> List[int]:\n        \"\"\"Pure function to return a new list with each element incremented by 1.\"\"\"\n        return [x + 1 for x in values]\n\n    def process_and_record(self, values: Any, role: str) -> List[int]:\n        \"\"\"Validates raw input, increments elements, and records usage metrics.\"\"\"\n        try:\n            validated_values = self._validator.validate_list(values)\n            result = self.incr_list(validated_values)\n            try:\n                self._repo.update_usage(role) # Update metrics, best effort.\n            except Exception:\n                logger.exception(f\"Failed to persist metrics for role '{role}'. Processing continued.\")\n            return result\n        except ValidationError:\n            raise # Re-raise validation errors directly for callers to handle.\n        except Exception as e:\n            logger.exception(f\"An unexpected error occurred during processing: {e}\")\n            raise IncrementError(\"Internal server error during list increment operation.\") from e\n```\n\n```python\n# root/src/list_incrementer/controllers.py\n# CLI and API controllers adapting external I/O to service calls.\nimport logging\nfrom typing import Dict, Any\nfrom .services import IncrementService\nfrom .adapters import JsonAdapter\nfrom .exceptions import ValidationError, IncrementError\nfrom .models import ListOutput\n\nlogger = logging.getLogger(__name__)\n\nclass CLIController:\n    \"\"\"Handles command-line interface interactions for list incrementation.\"\"\"\n    def __init__(self, service: IncrementService, adapter: JsonAdapter) -> None:\n        \"\"\"Initialize CLI controller with the increment service and JSON adapter.\"\"\"\n        self._service = service\n        self._adapter = adapter\n\n    def run(self, input_text: str) -> str:\n        \"\"\"Processes CLI input, increments list, and returns JSON output string.\"\"\"\n        try:\n            values_from_json = self._adapter.loads(input_text)\n            result_list = self._service.process_and_record(values_from_json, role=\"cli\")\n            return self._adapter.dumps(result_list)\n        except ValidationError as e:\n            logger.error(f\"CLI Input validation error: {e.message}\")\n            raise # CLIApp will catch and handle exit code 2.\n        except IncrementError as e:\n            logger.error(f\"CLI Processing error: {e.message}\")\n            raise # CLIApp will catch and handle exit code 1.\n        except Exception as e:\n            logger.exception(\"An unexpected error occurred in CLI controller.\")\n            raise IncrementError(f\"CLI unexpected error: {e}\") # CLIApp will catch and handle exit code 1.\n\nclass APIController:\n    \"\"\"Handles HTTP API requests for list incrementation.\"\"\"\n    def __init__(self, service: IncrementService) -> None:\n        \"\"\"Initialize API controller with the increment service.\"\"\"\n        self._service = service\n\n    def post_increment(self, payload: Dict[str, Any]) -> Dict[str, Any]:\n        \"\"\"Processes an HTTP POST request to increment a list.\"\"\"\n        # FastAPI's pydantic model for ListInput already handles top-level validation\n        # but the service's validate_list ensures specific business rules (e.g., max_size, element types).\n        values = payload.get(\"values\")\n        if values is None:\n            raise ValidationError(\"Missing 'values' key in request payload.\")\n        \n        result_list = self._service.process_and_record(values, role=\"api\")\n        return ListOutput(values=result_list).model_dump() # Return pydantic model dump.\n```\n\n```python\n# root/src/list_incrementer/api_app.py\n# FastAPI application instance, endpoint definitions, and authentication.\nimport logging\nfrom typing import Optional\nfrom fastapi import FastAPI, Header, HTTPException, status\nfrom fastapi.responses import JSONResponse\nfrom .controllers import APIController\nfrom .exceptions import ValidationError, IncrementError\nfrom .models import ListInput, ListOutput, HealthCheck\n\nlogger = logging.getLogger(__name__)\n\nclass APIApp:\n    \"\"\"Configures and provides the FastAPI application instance.\"\"\"\n    def __init__(self, controller: APIController, api_key: Optional[str] = None) -> None:\n        \"\"\"Initialize with API controller and optional API key for authentication.\"\"\"\n        self._controller = controller\n        self._api_key = api_key\n\n    def create_app(self) -> FastAPI:\n        \"\"\"Creates and configures the FastAPI application.\"\"\"\n        app = FastAPI(\n            title=\"List Incrementer Service\",\n            description=\"A simple service to increment each integer element of a list by 1.\",\n            version=\"1.0.0\"\n        )\n\n        # Health check endpoint\n        @app.get(\"/health\", response_model=HealthCheck)\n        async def health_check():\n            \"\"\"Health check endpoint.\"\"\"\n            return HealthCheck(status=\"ok\", message=\"Service is running.\")\n\n        @app.post(\"/increment\", response_model=ListOutput, status_code=status.HTTP_200_OK)\n        async def increment_endpoint(\n            list_input: ListInput, # Pydantic model handles initial JSON validation\n            x_api_key: Optional[str] = Header(None)\n        ):\n            \"\"\"\n            Increments each integer element of a given list by 1.\n            Requires an X-API-Key header if API_KEY is configured.\n            \"\"\"\n            if self._api_key: # If API_KEY is configured, enforce it.\n                if not x_api_key or x_api_key != self._api_key:\n                    logger.warning(\"Unauthorized access attempt to /increment.\")\n                    raise HTTPException(\n                        status_code=status.HTTP_401_UNAUTHORIZED,\n                        detail=\"Unauthorized: Missing or invalid X-API-Key.\"\n                    )\n            \n            try:\n                # The controller expects a dict payload, extract from ListInput model\n                response_data = self._controller.post_increment(list_input.model_dump())\n                return response_data\n            except ValidationError as e:\n                logger.warning(f\"Bad request: {e.message}\")\n                raise HTTPException(status_code=status.HTTP_400_BAD_REQUEST, detail=e.message)\n            except IncrementError as e:\n                logger.error(f\"Internal server error: {e.message}\")\n                raise HTTPException(status_code=status.HTTP_500_INTERNAL_SERVER_ERROR, detail=e.message)\n            except Exception as e:\n                logger.exception(\"Unhandled exception in /increment endpoint.\")\n                raise HTTPException(status_code=status.HTTP_500_INTERNAL_SERVER_ERROR, detail=\"An unexpected internal error occurred.\")\n\n        return app\n\n# Placeholder for application setup; this will be called by uvicorn\n# Example: `uvicorn src.list_incrementer.api_app:app_instance.create_app()`\n# Or, if you want `app` directly for simpler uvicorn launch:\n# app = APIApp(controller=APIController(...), api_key=config.API_KEY).create_app()\n# The recommended way is to provide a function to uvicorn, which will be called on startup.\n# See below in cli_app for full app construction.\n```\n\n```python\n# root/src/list_incrementer/cli_app.py\n# CLI entry point wrapper for console use.\nimport argparse\nimport logging\nimport sys\nimport os\nimport pathlib\nfrom .controllers import CLIController\nfrom .services import IncrementService\nfrom .utils import Validator\nfrom .repository import MetricsRepository\nfrom .adapters import JsonAdapter\nfrom .exceptions import ValidationError, IncrementError\nfrom .config import MAX_LIST_SIZE, METRICS_PATH, API_KEY, PORT # Import config just to show dependency\n\nlogger = logging.getLogger(__name__)\n\n# Basic logging configuration for CLI\nlogging.basicConfig(level=logging.INFO, format='%(asctime)s - %(levelname)s - %(message)s')\n\nclass CLIApp:\n    \"\"\"Main application class for the command-line interface.\"\"\"\n    def __init__(self, controller: CLIController) -> None:\n        \"\"\"Initialize CLI app with its controller.\"\"\"\n        self._controller = controller\n\n    def main(self, argv: list[str]) -> int:\n        \"\"\"Parses arguments, executes the CLI command, and handles exit codes.\"\"\"\n        parser = argparse.ArgumentParser(\n            description=\"Increment each integer element of a list by 1 via CLI.\"\n        )\n        parser.add_argument(\n            \"-i\", \"--input\",\n            type=str,\n            help=\"JSON array string of integers (e.g., '[1,2,3]')\",\n            required=False\n        )\n\n        args = parser.parse_args(argv[1:]) # Parse argv excluding the script name.\n\n        input_text: str\n        if args.input:\n            input_text = args.input\n        else:\n            # Read from stdin if no --input provided.\n            # This is an enhancement not explicitly in spec, but common for CLI tools.\n            logger.info(\"No --input provided, reading from stdin. Press Ctrl+D (or Ctrl+Z on Windows) when done.\")\n            input_text = sys.stdin.read().strip()\n            if not input_text:\n                sys.stderr.write(\"Error: No input provided via --input or stdin.\\n\")\n                return 2 # Consistent with validation error exit code.\n\n        try:\n            result_json = self._controller.run(input_text)\n            sys.stdout.write(result_json + \"\\n\")\n            return 0\n        except ValidationError as e:\n            sys.stderr.write(f\"Error: Invalid input: {e.message}\\n\")\n            return 2 # Exit code for validation errors.\n        except IncrementError as e:\n            sys.stderr.write(f\"Error: Processing failed: {e.message}\\n\")\n            return 1 # Exit code for unexpected errors.\n        except Exception as e:\n            sys.stderr.write(f\"An unexpected error occurred: {e}\\n\")\n            logger.exception(\"Unhandled exception in CLIApp.main\")\n            return 1 # Generic error.\n\n# Entry point for the console script.\ndef run_cli():\n    \"\"\"Constructs dependencies and runs the CLI application.\"\"\"\n    # Ensure data directory exists before initializing MetricsRepository\n    pathlib.Path(METRICS_PATH).parent.mkdir(parents=True, exist_ok=True)\n    \n    validator = Validator(max_size=MAX_LIST_SIZE)\n    repository = MetricsRepository(path=METRICS_PATH)\n    service = IncrementService(validator=validator, repository=repository)\n    adapter = JsonAdapter()\n    controller = CLIController(service=service, adapter=adapter)\n    app = CLIApp(controller=controller)\n    sys.exit(app.main(sys.argv))\n\n# This part would typically be used in pyproject.toml as `console_scripts` entry.\n# [project.scripts]\n# list-increment = \"list_incrementer.cli_app:run_cli\"\n```\n\n```python\n# root/src/list_incrementer/config.py\n# Configuration constants and environment variable loading.\nimport os\nimport pathlib\n\n# Environment variables are loaded, with defaults provided.\nMAX_LIST_SIZE: int = int(os.getenv(\"MAX_LIST_SIZE\", \"10000\"))\n# Path for metrics file. Using pathlib.Path for better OS compatibility.\nMETRICS_PATH: pathlib.Path = pathlib.Path(os.getenv(\"METRICS_PATH\", \"./data/metrics.json\"))\nAPI_KEY: str | None = os.getenv(\"API_KEY\", None) # Optional API key for HTTP endpoint.\nPORT: int = int(os.getenv(\"PORT\", \"8000\")) # Port for the HTTP server.\n\n# You can add more configuration here as needed, e.g., logging settings.\n```\n\n```python\n# root/pyproject.toml\n[project]\nname = \"list-incrementer\"\nversion = \"0.1.0\"\ndescription = \"A service to increment each integer element of a list by 1.\"\nauthors = [\"Your Name <your.email@example.com>\"]\ndependencies = [\n    \"fastapi>=0.111.0\",\n    \"uvicorn>=0.30.1\",\n    \"pydantic>=2.7.4\",\n    \"pydantic-settings>=2.2.1\", # For future config if needed, not strictly in spec.\n]\nreadme = \"README.md\"\nrequires-python = \">=3.9\"\nlicense = { text = \"MIT\" }\n\n[project.scripts]\nlist-increment = \"list_incrementer.cli_app:run_cli\"\n\n[project.optional-dependencies]\ndev = [\n    \"pytest>=8.2.2\",\n    \"httpx>=0.27.0\", # For TestClient in FastAPI\n    \"ruff>=0.4.8\", # Linter\n]\n\n[build-system]\nrequires = [\"setuptools>=61.0\"]\nbuild-backend = \"setuptools.build_meta\"\n\n# Configuration for ruff linter (optional, but good practice)\n[tool.ruff]\nline-length = 120\ntarget-version = \"py39\"\n\n[tool.ruff.lint]\nselect = [\"E\", \"F\", \"W\", \"I\"] # Error, Flake8, Warnings, Isort\n\n[tool.pytest.ini_options]\npythonpath = [\"src\"]\n```\n\n```markdown\n<!-- root/README.md -->\n# List Incrementer Service\n\nThis project provides a reliable, testable library and a small service to increment each integer element of a list by 1. It exposes this capability via a simple Command-Line Interface (CLI) and an HTTP API.\n\n## Features\n\n- **Core Library**: A Python function to increment list elements.\n- **CLI Tool**: `list-increment` to process JSON lists from input and print incremented JSON lists.\n- **HTTP API**: A FastAPI endpoint (`POST /increment`) for programmatic use.\n- **Input Validation**: Ensures valid list and integer inputs, and enforces size limits.\n- **Usage Metrics**: Records basic usage counts and last run timestamps for both CLI and API.\n- **Automated Tests**: Unit and integration tests to ensure correctness and robustness.\n- **Optional API Key**: Security for the HTTP endpoint via `X-API-Key` header.\n\n## Installation\n\n1.  **Clone the repository**:\n    ```bash\n    git clone https://github.com/your-username/list-incrementer.git\n    cd list-incrementer\n    ```\n\n2.  **Create and activate a virtual environment**:\n    ```bash\n    python -m venv .venv\n    source .venv/bin/activate  # On Windows: .venv\\Scripts\\activate\n    ```\n\n3.  **Install dependencies**:\n    ```bash\n    pip install -e .\n    ```\n    This installs the package and its dependencies, including `fastapi`, `uvicorn`, `pydantic`.\n\n## Usage\n\n### Configuration\n\nThe service can be configured using environment variables. Create a `.env` file at the root of the project (or set them directly in your shell environment). See `.env.example` for reference.\n\n-   `MAX_LIST_SIZE`: Maximum allowed length of input lists (default: 10000).\n-   `METRICS_PATH`: Path to the JSON file for metrics persistence (default: `./data/metrics.json`).\n-   `API_KEY`: An optional secret key for the HTTP API (if set, the `X-API-Key` header is required).\n-   `PORT`: The port for the HTTP API server (default: 8000).\n\nExample `.env` file:\n```env\nMAX_LIST_SIZE=5000\nMETRICS_PATH=./data/custom_metrics.json\nAPI_KEY=my_secret_api_key_123\nPORT=8080\n```\n\n### CLI Application\n\nRun the CLI tool using the `list-increment` command.\n\n```bash\n# Increment a list provided as a JSON string\nlist-increment --input '[1, 2, 3]'\n# Expected output: [2, 3, 4]\n\n# Example with a longer list\nlist-increment --input '[10, 20, 30, 40, 50]'\n# Expected output: [11, 21, 31, 41, 51]\n\n# Invalid input (non-integer)\nlist-increment --input '[1, \"two\", 3]'\n# Expected error on stderr and exit code 2\n\n# Input from stdin\necho '[100, 200]' | list-increment\n# Expected output: [101, 201]\n```\n\n### HTTP API Service\n\n1.  **Start the API server**:\n    ```bash\n    uvicorn src.list_incrementer.api_app:run_api --reload --port ${PORT:-8000}\n    ```\n    Replace `${PORT:-8000}` with your desired port or ensure `PORT` is set in your environment or `.env` file.\n    The `run_api` function in `src/list_incrementer/api_app.py` is the entry point. It handles dependency injection for the API app.\n\n2.  **Interact with the API**:\n    Use `curl` or any HTTP client to send POST requests to `/increment`.\n\n    **Example (no API key configured):**\n    ```bash\n    curl -X POST http://localhost:8000/increment \\\n         -H \"Content-Type: application/json\" \\\n         -d '{\"values\": [1, 2, 3]}'\n    # Expected output: {\"values\":[2,3,4]}\n    ```\n\n    **Example (with API key configured via `API_KEY` env var):**\n    First, ensure `API_KEY` is set in your `.env` or environment (e.g., `API_KEY=my_secret_key`).\n    ```bash\n    curl -X POST http://localhost:8000/increment \\\n         -H \"Content-Type: application/json\" \\\n         -H \"X-API-Key: my_secret_key\" \\\n         -d '{\"values\": [10, 20, 30]}'\n    # Expected output: {\"values\":[11,21,31]}\n\n    # Attempt without API key (or wrong key) will result in 401 Unauthorized\n    curl -X POST http://localhost:8000/increment \\\n         -H \"Content-Type: application/json\" \\\n         -d '{\"values\": [1, 2, 3]}'\n    # Expected output: {\"detail\":\"Unauthorized: Missing or invalid X-API-Key.\"} (status 401)\n    ```\n\n    **Validation error example:**\n    ```bash\n    curl -X POST http://localhost:8000/increment \\\n         -H \"Content-Type: application/json\" \\\n         -d '{\"values\": [1, \"two\", 3]}'\n    # Expected output: {\"detail\":\"Element at index 1 is not an integer: 'two'.\"} (status 400)\n    ```\n\n    **Health Check:**\n    ```bash\n    curl http://localhost:8000/health\n    # Expected output: {\"status\":\"ok\",\"message\":\"Service is running.\"}\n    ```\n\n### Metrics\n\nMetrics are persisted to a JSON file (default: `./data/metrics.json`). This file will be created automatically upon the first successful CLI or API call.\n\nExample `metrics.json` content:\n```json\n{\n  \"cli\": {\n    \"usage_count\": 5,\n    \"last_run_iso\": \"2023-10-27T10:00:00.123456+00:00\"\n  },\n  \"api\": {\n    \"usage_count\": 12,\n    \"last_run_iso\": \"2023-10-27T10:05:30.987654+00:00\"\n  }\n}\n```\n\n## Development and Testing\n\n### Running Tests\n\n```bash\n# Make sure dev dependencies are installed\npip install -e \".[dev]\"\n\n# Run all tests\npytest\n\n# To run specific test files or tests:\npytest tests/test_services.py\npytest tests/test_api.py -k test_api_post_increment_success\n```\n\n### Project Structure\n\n```\n.\n\u251c\u2500\u2500 src/\n\u2502   \u2514\u2500\u2500 list_incrementer/\n\u2502       \u251c\u2500\u2500 __init__.py         # Package initialization\n\u2502       \u251c\u2500\u2500 models.py           # Pydantic data models (ListInput, ListOutput, MetricsRecord)\n\u2502       \u251c\u2500\u2500 exceptions.py       # Custom exception classes (ValidationError, IncrementError)\n\u2502       \u251c\u2500\u2500 utils.py            # Input validation logic (Validator)\n\u2502       \u251c\u2500\u2500 repository.py       # Metrics persistence (MetricsRepository)\n\u2502       \u251c\u2500\u2500 adapters.py         # JSON serialization/deserialization (JsonAdapter)\n\u2502       \u251c\u2500\u2500 services.py         # Core business logic (IncrementService)\n\u2502       \u251c\u2500\u2500 controllers.py      # CLI and API request handling (CLIController, APIController)\n\u2502       \u251c\u2500\u2500 api_app.py          # FastAPI application setup and routes\n\u2502       \u251c\u2500\u2500 cli_app.py          # CLI entry point and argument parsing\n\u2502       \u2514\u2500\u2500 config.py           # Configuration loading from environment\n\u251c\u2500\u2500 data/                       # Directory for metrics.json (created at runtime)\n\u251c\u2500\u2500 tests/                      # Unit and integration tests\n\u251c\u2500\u2500 pyproject.toml              # Project metadata and dependencies\n\u251c\u2500\u2500 README.md                   # This file\n\u2514\u2500\u2500 .env.example                # Example environment variables\n```\n\n---\n**Note:** The above code is generated based on the provided software design specification. For the `api_app.py`, the `run_api` function is added to facilitate simple `uvicorn` startup with dependency injection, as commonly done in FastAPI applications. This acts as the entry point when `uvicorn src.list_incrementer.api_app:run_api` is called.\n\n```python\n# Part of root/src/list_incrementer/api_app.py (app construction for uvicorn)\n\n# Moved dependency construction out of the class method for uvicorn entry point.\n# This makes it easier to manage dependencies when FastAPI is initialized by an external runner.\n\n# Add this at the end of root/src/list_incrementer/api_app.py\nfrom .config import MAX_LIST_SIZE, METRICS_PATH, API_KEY, PORT\nfrom .repository import MetricsRepository\nfrom .utils import Validator\nfrom .services import IncrementService\n\ndef run_api() -> FastAPI:\n    \"\"\"Constructs dependencies and returns the FastAPI application instance.\"\"\"\n    # Ensure data directory exists before initializing MetricsRepository\n    pathlib.Path(METRICS_PATH).parent.mkdir(parents=True, exist_ok=True)\n    \n    # Initialize dependencies\n    validator = Validator(max_size=MAX_LIST_SIZE)\n    repository = MetricsRepository(path=METRICS_PATH)\n    service = IncrementService(validator=validator, repository=repository)\n    controller = APIController(service=service)\n    \n    # Create the APIApp instance and return its configured FastAPI app\n    app_instance = APIApp(controller=controller, api_key=API_KEY)\n    return app_instance.create_app()\n\n# This `run_api` function is the actual callable that uvicorn will execute,\n# e.g., `uvicorn src.list_incrementer.api_app:run_api --reload`\n```\n```\n```"}
{"task_id": "HumanEval/43", "solution": "def pairs_sum_to_zero(l):\n    \"\"\"\n    pairs_sum_to_zero takes a list of integers as an input.\n    it returns True if there are two distinct elements in the list that\n    sum to zero, and False otherwise.\n    >>> pairs_sum_to_zero([1, 3, 5, 0])\n    False\n    >>> pairs_sum_to_zero([1, 3, -2, 1])\n    False\n    >>> pairs_sum_to_zero([1, 2, 3, 7])\n    False\n    >>> pairs_sum_to_zero([2, 4, -5, 3, 5, 7])\n    True\n    >>> pairs_sum_to_zero([1])\n    False\n    \"\"\"\n    seen = set()\n    zero_count = 0\n    for num in l:\n        if num == 0:\n            zero_count += 1\n        # Check if the complement (-num) has been seen to form a zero sum.\n        # This covers cases with two distinct non-zero numbers.\n        if -num in seen:\n            return True\n        seen.add(num)\n    \n    # After iterating, check if there are at least two zeros.\n    # This specifically handles the case where 0 + 0 = 0.\n    return zero_count >= 2"}
