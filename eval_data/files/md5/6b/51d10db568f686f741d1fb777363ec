{"task_id": "HumanEval/33", "solution": "```\nsrc/sort_third_app/exceptions.py\n```python\nclass InvalidInputError(ValueError):\n    \"\"\"Raised when the input to a function is not of the expected type or shape.\"\"\"\n\nclass InvalidElementError(TypeError):\n    \"\"\"Raised when elements at target indices are not mutually comparable.\"\"\"\n\nclass PersistenceError(Exception):\n    \"\"\"Raised when an operation on the history repository fails.\"\"\"\n\n```\n\nsrc/sort_third_app/models.py\n```python\nfrom typing import List, Any, Optional\n\nclass ListInput:\n    \"\"\"Represents an input list for transformation.\"\"\"\n    def __init__(self, data: List[Any]):\n        self.data = data\n\n    def validate(self) -> None:\n        \"\"\"Ensures that the data attribute is a list.\"\"\"\n        from .exceptions import InvalidInputError\n        if not isinstance(self.data, list):\n            raise InvalidInputError(\"Input data must be a Python list.\")\n\nclass ListOutput:\n    \"\"\"Represents the transformed output list.\"\"\"\n    def __init__(self, result: List[Any]):\n        self.result = result\n\nclass HistoryRecord:\n    \"\"\"Represents a single invocation record for persistence.\"\"\"\n    def __init__(self, id: Optional[int], timestamp_iso: str, input_json: str, output_json: str):\n        self.id = id\n        self.timestamp_iso = timestamp_iso\n        self.input_json = input_json\n        self.output_json = output_json\n\n```\n\nsrc/sort_third_app/utils.py\n```python\nimport json\nfrom typing import Any, List\nimport re\n\ndef is_valid_list(obj: Any) -> bool:\n    \"\"\"Checks if the given object is a Python list.\"\"\"\n    return isinstance(obj, list)\n\ndef to_json_serializable(obj: Any) -> Any:\n    \"\"\"Ensures an object is JSON-serializable, falling back to its string representation.\"\"\"\n    return str(obj)\n\ndef parse_list_from_string(s: str) -> List[Any]:\n    \"\"\"Parses a comma-separated string into a list, attempting to convert elements to numbers.\"\"\"\n    elements = s.split(',')\n    parsed_list = []\n    for el in elements:\n        stripped_el = el.strip()\n        if not stripped_el:\n            continue\n        try:\n            if re.fullmatch(r\"^-?\\d+$\", stripped_el):\n                parsed_list.append(int(stripped_el))\n            elif re.fullmatch(r\"^-?\\d+\\.\\d*$\", stripped_el):\n                parsed_list.append(float(stripped_el))\n            else:\n                parsed_list.append(stripped_el)\n        except ValueError:\n            parsed_list.append(stripped_el)\n    return parsed_list\n\n```\n\nsrc/sort_third_app/config.py\n```python\nfrom dataclasses import dataclass\nfrom typing import Optional\nimport os\n\n@dataclass(frozen=True)\nclass Config:\n    \"\"\"Central configuration for the application.\"\"\"\n    db_path: str\n    enable_persistence: bool\n    api_key: Optional[str]\n    debug: bool\n\n    @classmethod\n    def from_env(cls) -> \"Config\":\n        \"\"\"Builds a Config instance from environment variables.\"\"\"\n        db_path = os.getenv(\"SORT_THIRD_DB_PATH\", DEFAULT_DB_PATH)\n        enable_persistence = os.getenv(\"SORT_THIRD_ENABLE_PERSISTENCE\", \"false\").lower() == \"true\"\n        api_key = os.getenv(\"SORT_THIRD_API_KEY\")\n        debug = os.getenv(\"SORT_THIRD_DEBUG\", \"false\").lower() == \"true\"\n        return cls(db_path, enable_persistence, api_key, debug)\n\nDEFAULT_DB_PATH = \"sort_third_history.db\"\nDEFAULT_ENABLE_PERSISTENCE = False\n\n```\n\nsrc/sort_third_app/algorithm.py\n```python\nfrom typing import List, Tuple, Any\nfrom .exceptions import InvalidInputError, InvalidElementError\nfrom .utils import is_valid_list\n\nclass SortThirdAlgorithm:\n    \"\"\"Implements the core logic for sorting elements at indices divisible by three.\"\"\"\n\n    def sort(self, l: List[Any]) -> List[Any]:\n        \"\"\"Returns a new list with elements at 0, 3, 6,... indices sorted.\"\"\"\n        if not is_valid_list(l):\n            raise InvalidInputError(\"Input to sort_third must be a list.\")\n\n        indices, values = self._extract_indices(l)\n\n        try:\n            sorted_values = sorted(values)\n        except TypeError as e:\n            raise InvalidElementError(\"Elements at target indices are not mutually comparable.\") from e\n\n        out = list(l)\n        for original_idx, sorted_val in zip(indices, sorted_values):\n            out[original_idx] = sorted_val\n        return out\n\n    def _extract_indices(self, l: List[Any]) -> Tuple[List[int], List[Any]]:\n        \"\"\"Extracts indices divisible by three and their corresponding values from the list.\"\"\"\n        indices = [i for i in range(len(l)) if i % 3 == 0]\n        values = [l[i] for i in indices]\n        return indices, values\n\n```\n\nsrc/sort_third_app/repository.py\n```python\nimport sqlite3\nfrom typing import Optional\nfrom .models import HistoryRecord\nfrom .exceptions import PersistenceError\nimport logging\n\nlogger = logging.getLogger(__name__)\n\nclass HistoryRepository:\n    \"\"\"Handles persistence and retrieval of HistoryRecord objects to/from SQLite.\"\"\"\n    HISTORY_TABLE_SCHEMA = \"\"\"\n        CREATE TABLE IF NOT EXISTS history (\n            id INTEGER PRIMARY KEY AUTOINCREMENT,\n            timestamp_iso TEXT NOT NULL,\n            input_json TEXT NOT NULL,\n            output_json TEXT NOT NULL\n        );\n        CREATE INDEX IF NOT EXISTS idx_history_timestamp ON history(timestamp_iso);\n    \"\"\"\n\n    def __init__(self, db_path: str):\n        \"\"\"Initializes the repository with the path to the SQLite database file.\"\"\"\n        self._db_path = db_path\n        self.init_db()\n\n    def _get_connection(self):\n        \"\"\"Returns a connection to the SQLite database.\"\"\"\n        return sqlite3.connect(self._db_path)\n\n    def init_db(self) -> None:\n        \"\"\"Initializes the database schema if it does not already exist.\"\"\"\n        try:\n            with self._get_connection() as conn:\n                conn.executescript(self.HISTORY_TABLE_SCHEMA)\n            logger.info(f\"SQLite database initialized at {self._db_path}\")\n        except sqlite3.Error as e:\n            logger.error(f\"Failed to initialize database at {self._db_path}: {e}\")\n            raise PersistenceError(f\"Database initialization failed: {e}\") from e\n\n    def save(self, record: HistoryRecord) -> int:\n        \"\"\"Saves a HistoryRecord to the database and returns its new ID.\"\"\"\n        try:\n            with self._get_connection() as conn:\n                cursor = conn.cursor()\n                cursor.execute(\n                    \"INSERT INTO history (timestamp_iso, input_json, output_json) VALUES (?, ?, ?)\",\n                    (record.timestamp_iso, record.input_json, record.output_json)\n                )\n                conn.commit()\n                return cursor.lastrowid\n        except sqlite3.Error as e:\n            logger.error(f\"Failed to save history record: {e}\")\n            raise PersistenceError(f\"Failed to save record: {e}\") from e\n\n    def get(self, record_id: int) -> Optional[HistoryRecord]:\n        \"\"\"Retrieves a HistoryRecord by its ID.\"\"\"\n        try:\n            with self._get_connection() as conn:\n                cursor = conn.cursor()\n                cursor.execute(\"SELECT id, timestamp_iso, input_json, output_json FROM history WHERE id = ?\", (record_id,))\n                row = cursor.fetchone()\n                if row:\n                    return HistoryRecord(id=row[0], timestamp_iso=row[1], input_json=row[2], output_json=row[3])\n                return None\n        except sqlite3.Error as e:\n            logger.error(f\"Failed to retrieve history record with ID {record_id}: {e}\")\n            raise PersistenceError(f\"Failed to retrieve record: {e}\") from e\n\n```\n\nsrc/sort_third_app/service.py\n```python\nfrom typing import List, Any, Optional\nimport datetime\nimport json\nimport logging\n\nfrom .algorithm import SortThirdAlgorithm\nfrom .repository import HistoryRepository\nfrom .config import Config\nfrom .models import HistoryRecord, ListInput\nfrom .exceptions import InvalidInputError, InvalidElementError, PersistenceError\nfrom .utils import to_json_serializable\n\nlogger = logging.getLogger(__name__)\n\nclass SortThirdService:\n    \"\"\"Orchestrates the sorting algorithm and optional history persistence.\"\"\"\n\n    def __init__(self, algorithm: SortThirdAlgorithm, repository: Optional[HistoryRepository], config: Config):\n        \"\"\"Initializes the service with algorithm, repository, and configuration.\"\"\"\n        self._algorithm = algorithm\n        self._repository = repository\n        self._config = config\n\n    def sort(self, l: List[Any]) -> List[Any]:\n        \"\"\"Performs the sort operation without recording history.\"\"\"\n        list_input = ListInput(l)\n        list_input.validate()\n        return self._algorithm.sort(l)\n\n    def sort_and_record(self, l: List[Any]) -> List[Any]:\n        \"\"\"Performs the sort operation and optionally records the invocation history.\"\"\"\n        result = self.sort(l)\n\n        if self._config.enable_persistence and self._repository:\n            try:\n                record = HistoryRecord(\n                    id=None,\n                    timestamp_iso=datetime.datetime.utcnow().isoformat(),\n                    input_json=json.dumps(l, default=to_json_serializable),\n                    output_json=json.dumps(result, default=to_json_serializable),\n                )\n                self._repository.save(record)\n                logger.debug(f\"Invocation recorded for input: {l}\")\n            except PersistenceError as e:\n                logger.error(f\"Persistence failed for input {l}: {e}\")\n                if self._config.debug:\n                    raise\n            except Exception as e:\n                logger.error(f\"Unexpected error during persistence for input {l}: {e}\")\n                if self._config.debug:\n                    raise\n        return result\n\n```\n\nsrc/sort_third_app/controllers.py\n```python\nimport json\nimport argparse\nimport sys\nfrom typing import List, Dict, Any, Optional\n\nfrom .service import SortThirdService\nfrom .config import Config\nfrom .exceptions import InvalidInputError, InvalidElementError\nfrom .utils import parse_list_from_string, to_json_serializable\nimport logging\n\nlogger = logging.getLogger(__name__)\n\ntry:\n    from fastapi import FastAPI, HTTPException, status, Header, Depends\n    from pydantic import BaseModel\n    class SortRequest(BaseModel):\n        list: List[Any]\nexcept ImportError:\n    FastAPI = HTTPException = status = Header = Depends = None\n    BaseModel = object\n    logger.warning(\"FastAPI and Pydantic not found. HTTP API functionality will be unavailable.\")\n\n\nclass CLIController:\n    \"\"\"Handles command-line interface interactions for the sort-third application.\"\"\"\n\n    def __init__(self, service: SortThirdService, config: Config):\n        \"\"\"Initializes the CLI controller with a service and configuration.\"\"\"\n        self._service = service\n        self._config = config\n\n    def run_from_args(self, argv: List[str]) -> int:\n        \"\"\"Parses command-line arguments and executes the sort operation.\"\"\"\n        parser = argparse.ArgumentParser(\n            description=\"Sort elements at indices divisible by three in a list.\"\n        )\n        parser.add_argument(\n            \"--input\",\n            type=str,\n            help=\"Comma-separated list (e.g., '1,2,3,4,5'). Cannot be used with --file.\",\n        )\n        parser.add_argument(\n            \"--file\",\n            type=str,\n            help=\"Path to a file containing a JSON list or CSV lines. Cannot be used with --input.\",\n        )\n        parser.add_argument(\n            \"--json-output\",\n            action=\"store_true\",\n            help=\"Output raw JSON (default is pretty-printed JSON).\",\n        )\n\n        args = parser.parse_args(argv[1:])\n\n        if (args.input and args.file) or (not args.input and not args.file):\n            print(\"Error: Exactly one of --input or --file must be provided.\", file=sys.stderr)\n            return 1\n\n        input_list: List[Any] = []\n        if args.input:\n            try:\n                input_list = parse_list_from_string(args.input)\n            except Exception as e:\n                print(f\"Error parsing --input string: {e}\", file=sys.stderr)\n                return 1\n        elif args.file:\n            try:\n                with open(args.file, 'r') as f:\n                    content = f.read().strip()\n                    if content.startswith('['):\n                        input_list = json.loads(content)\n                    else:\n                        first_line = content.splitlines()[0] if content else \"\"\n                        input_list = parse_list_from_string(first_line)\n            except FileNotFoundError:\n                print(f\"Error: File not found at '{args.file}'\", file=sys.stderr)\n                return 1\n            except json.JSONDecodeError:\n                print(f\"Error: Invalid JSON in file '{args.file}'\", file=sys.stderr)\n                return 1\n            except Exception as e:\n                print(f\"Error reading or parsing file '{args.file}': {e}\", file=sys.stderr)\n                return 1\n\n        try:\n            result = self._service.sort_and_record(input_list)\n            if args.json_output:\n                print(json.dumps({\"result\": result}, default=to_json_serializable))\n            else:\n                print(json.dumps({\"result\": result}, indent=2, default=to_json_serializable))\n            return 0\n        except InvalidInputError as e:\n            print(f\"Error: Invalid input: {e}\", file=sys.stderr)\n            logger.error(f\"CLI InvalidInputError: {e}\")\n            return 1\n        except InvalidElementError as e:\n            print(f\"Error: Incomparable elements found at target indices: {e}\", file=sys.stderr)\n            logger.error(f\"CLI InvalidElementError: {e}\")\n            return 1\n        except Exception as e:\n            print(f\"An unexpected error occurred: {e}\", file=sys.stderr)\n            logger.exception(\"An unexpected error occurred during CLI execution.\")\n            return 1\n\n\nclass APIController:\n    \"\"\"Handles HTTP API interactions for the sort-third application using FastAPI.\"\"\"\n\n    def __init__(self, service: SortThirdService, config: Config):\n        \"\"\"Initializes the API controller with a service and configuration.\"\"\"\n        if FastAPI is None:\n            raise RuntimeError(\"FastAPI is not installed. HTTP API cannot be initialized.\")\n        self._service = service\n        self._config = config\n\n    def _verify_api_key(self, x_api_key: Optional[str] = Header(None)):\n        \"\"\"Dependency for API key authentication.\"\"\"\n        if self._config.api_key:\n            if not x_api_key or x_api_key != self._config.api_key:\n                raise HTTPException(status_code=status.HTTP_401_UNAUTHORIZED, detail=\"Unauthorized\")\n        return x_api_key\n\n    def post_sort(self, request: SortRequest, api_key_verified: Optional[str] = Depends(_verify_api_key)) -> Dict[str, Any]:\n        \"\"\"Handles POST requests to /sort, performs sorting, and returns the result.\"\"\"\n        data = request.list\n        try:\n            result = self._service.sort_and_record(data)\n            return {\"result\": result}\n        except InvalidInputError as e:\n            raise HTTPException(status_code=status.HTTP_400_BAD_REQUEST, detail=f\"Invalid input: {e}\")\n        except InvalidElementError as e:\n            raise HTTPException(status_code=status.HTTP_400_BAD_REQUEST, detail=f\"Incomparable elements: {e}\")\n        except Exception as e:\n            logger.exception(\"API post_sort encountered an unexpected error.\")\n            raise HTTPException(status_code=status.HTTP_500_INTERNAL_SERVER_ERROR, detail=f\"An internal error occurred: {e}\")\n\n    def register_routes(self, app: FastAPI) -> None:\n        \"\"\"Registers the /sort route with the FastAPI application.\"\"\"\n        app.post(\"/sort\", response_model=Dict[str, Any])(self.post_sort)\n\n```\n\nsrc/sort_third_app/api.py\n```python\nimport logging\nfrom contextlib import asynccontextmanager\n\ntry:\n    from fastapi import FastAPI\n    from fastapi.middleware.cors import CORSMiddleware\nexcept ImportError:\n    FastAPI = None\n    CORSMiddleware = None\n    logging.warning(\"FastAPI not found. HTTP API cannot be created.\")\n\nfrom .config import Config\nfrom .service import SortThirdService\nfrom .controllers import APIController\nfrom .repository import HistoryRepository\n\nlogger = logging.getLogger(__name__)\n\n@asynccontextmanager\nasync def lifespan(app: FastAPI):\n    \"\"\"Handles startup and shutdown events for the FastAPI application.\"\"\"\n    config: Config = app.state.config\n    if config.enable_persistence and app.state.repository:\n        try:\n            app.state.repository.init_db()\n            logger.info(f\"Database initialized at {config.db_path}.\")\n        except Exception as e:\n            logger.error(f\"Failed to initialize database during startup: {e}\")\n            # In production, might raise SystemExit here to prevent app from starting\n    logger.info(\"FastAPI application startup complete.\")\n    yield\n    logger.info(\"FastAPI application shutdown complete.\")\n\n\ndef create_app(config: Config, service: SortThirdService) -> FastAPI:\n    \"\"\"Factory function to create and configure the FastAPI application.\"\"\"\n    if FastAPI is None:\n        raise RuntimeError(\"FastAPI is not installed. Cannot create HTTP API.\")\n\n    app = FastAPI(\n        title=\"Sort Third Service\",\n        description=\"API to transform lists by sorting elements at indices divisible by three.\",\n        version=\"0.1.0\",\n        lifespan=lifespan\n    )\n\n    app.state.config = config\n    app.state.service = service\n    app.state.repository = service._repository\n\n    if config.debug:\n        app.add_middleware(\n            CORSMiddleware,\n            allow_origins=[\"*\"],\n            allow_credentials=True,\n            allow_methods=[\"*\"],\n            allow_headers=[\"*\"],\n        )\n        logger.info(\"CORS middleware enabled for debug mode.\")\n\n    api_controller = APIController(service, config)\n    api_controller.register_routes(app)\n\n    return app\n\n```\n\nsrc/sort_third_app/cli.py\n```python\nimport sys\nimport logging\nfrom typing import Optional, List\n\nfrom .config import Config\nfrom .algorithm import SortThirdAlgorithm\nfrom .repository import HistoryRepository\nfrom .service import SortThirdService\nfrom .controllers import CLIController\n\nlogger = logging.getLogger(__name__)\n\nclass CLIEntry:\n    \"\"\"Entry point for the command-line interface.\"\"\"\n\n    @staticmethod\n    def main(argv: Optional[List[str]] = None) -> int:\n        \"\"\"Main function to bootstrap the CLI application.\"\"\"\n        if argv is None:\n            argv = sys.argv\n\n        logging.basicConfig(level=logging.INFO, stream=sys.stderr,\n                            format='%(asctime)s - %(name)s - %(levelname)s - %(message)s')\n\n        config = Config.from_env()\n        if config.debug:\n            logging.getLogger().setLevel(logging.DEBUG)\n            logger.debug(\"Debug mode enabled.\")\n\n        algorithm = SortThirdAlgorithm()\n\n        repository = None\n        if config.enable_persistence:\n            try:\n                repository = HistoryRepository(db_path=config.db_path)\n            except Exception as e:\n                logger.error(f\"Failed to initialize history repository: {e}\")\n                if config.debug:\n        