on\nclass AppConfig:\n    \"\"\"Configuration class for application settings, suchs as the output format.\n    It holds simple runtime parameters like output_format and debug status.\n    \"\"\"\n    def __init__(self, output_format: str = \"json\", debug: bool = False) -> None:\n        self.output_format = output_format\n        self.debug = debug\n\n```\n\n---\n\n### `src/rollingmax/validator.py`\n\n```python\nfrom typing import Any, List\nfrom .exceptions import InvalidInputError\n\nclass InputValidator:\n    \"\"\"Validates input values to ensure they conform to expected types and structures.\n    It strictly checks if the input is a list and all its elements are integers.\n    \"\"\"\n    def validate(self, numbers: Any) -> None:\n        \"\"\"Checks if input is a list of integers, raising InvalidInputError if not.\"\"\"\n        if not isinstance(numbers, list):\n            raise InvalidInputError(\"Input must be a list of integers\", numbers)\n        for i, v in enumerate(numbers):\n            if not isinstance(v, int):\n                raise InvalidInputError(f\"All elements must be int (at index {i})\", v)\n\n```\n\n---\n\n### `src/rollingmax/service.py`\n\n```python\nfrom typing import List, Optional\n\nclass RollingMaxService:\n    \"\"\"Provides the core algorithm for computing the rolling maximum of an integer sequence.\n    This implementation guarantees O(n) time complexity and O(1) auxiliary space.\n    \"\"\"\n    def __init__(self) -> None:\n        self._current_max: Optional[int] = None\n\n    def compute(self, numbers: List[int]) -> List[int]:\n        \"\"\"Computes the rolling maximum for the given list of integers.\"\"\"\n        result: List[int] = []\n        self._current_max = None  # Reset for each computation call to maintain statelessness\n        for x in numbers:\n            if self._current_max is None or x > self._current_max:\n                self._current_max = x\n            result.append(self._current_max)\n        return result\n\n```\n\n---\n\n### `src/rollingmax/controllers.py`\n\n```python\nimport sys\nimport json\nfrom typing import List, Optional\n\nfrom .dto import RollingMaxRequest, RollingMaxResponse\nfrom .exceptions import InvalidInputError\nfrom .validator import InputValidator\nfrom .service import RollingMaxService\nfrom .config import AppConfig\n\nclass CLIController:\n    \"\"\"Orchestrates CLI operations: parsing, validation, computation, and output formatting.\n    It takes validator, service, and config dependencies via its constructor.\n    \"\"\"\n    def __init__(self, validator: InputValidator, service: RollingMaxService, config: AppConfig) -> None:\n        self.validator = validator\n        self.service = service\n        self.config = config\n\n    def run(self, argv: List[str]) -> int:\n        \"\"\"Executes the CLI logic, handling input, computation, and error reporting.\"\"\"\n        try:\n            req = self._parse_args(argv)\n            self.validator.validate(req.numbers)\n            res_list = self.service.compute(req.numbers)\n            resp = RollingMaxResponse(res_list)\n            print(self._format_response(resp))\n            return 0\n        except InvalidInputError as e:\n            print(f\"Error: {e}\", file=sys.stderr)\n            return 2\n        except Exception as e:\n            print(f\"An unexpected error occurred: {e}\", file=sys.stderr)\n            return 1\n\n    def _parse_args(self, argv: List[str]) -> RollingMaxRequest:\n        \"\"\"Parses command-line arguments or stdin to extract a list of integers.\n        It supports whitespace-separated or comma-separated integer strings.\n        \"\"\"\n        input_str: Optional[str] = None\n\n        if argv:\n            input_str = ' '.join(argv)\n        elif not sys.stdin.isatty():  # Check if input is piped\n            input_str = self._read_stdin()\n        \n        if input_str is None or not input_str.strip():\n            return RollingMaxRequest([])  # Empty input leads to empty list\n\n        # Attempt to parse as whitespace-separated, then comma-separated\n        try:\n            numbers_str = input_str.split()\n            parsed_numbers = [int(s) for s in numbers_str if s]\n        except ValueError:\n            # If whitespace split fails, try comma-separated\n            try:\n                numbers_str = input_str.replace(\" \", \"\").split(',')\n                parsed_numbers = [int(s) for s in numbers_str if s]\n            except ValueError:\n                raise InvalidInputError(\"Input numbers must be space- or comma-separated integers.\", input_str)\n        \n        return RollingMaxRequest(parsed_numbers)\n\n    def _read_stdin(self) -> str:\n        \"\"\"Reads all available input from stdin.\"\"\"\n        return sys.stdin.read().strip()\n\n    def _format_response(self, response: RollingMaxResponse) -> str:\n        \"\"\"Formats the RollingMaxResponse into a string based on the configured output format.\"\"\"\n        if self.config.output_format == 'json':\n            return json.dumps(response.result)\n        else:  # 'plain' format\n            return ' '.join(map(str, response.result))\n\n```\n\n---\n\n### `src/rollingmax/__init__.py`\n\n```python\nfrom typing import List\n\nfrom .service import RollingMaxService\nfrom .validator import InputValidator\nfrom .exceptions import InvalidInputError\n\n# Define package exports as per design\n__all__ = [\"rolling_max\", \"RollingMaxService\", \"InvalidInputError\"]\n\ndef rolling_max(numbers: List[int]) -> List[int]:\n    \"\"\"Computes the rolling maximum of a list of integers.\n    This function validates input and uses the core service for computation.\n    \"\"\"\n    validator = InputValidator()\n    validator.validate(numbers)\n    service = RollingMaxService()\n    return service.compute(numbers)\n\n```\n\n---\n\n### `src/rollingmax/__main__.py`\n\n```python\nimport sys\nfrom typing import List\n\nfrom .controllers import CLIController\nfrom .validator import InputValidator\nfrom .service import RollingMaxService\nfrom .config import AppConfig\n\nCLI_USAGE = \"\"\"Usage: python -m rollingmax [numbers...]\n       echo \"1 2 3\" | python -m rollingmax\n       echo \"1,2,3\" | python -m rollingmax\n\nComputes the rolling maximum of a sequence of integers.\nInput can be space-separated or comma-separated numbers provided as arguments or via stdin.\nOutput is a JSON array by default.\n\"\"\"\n\ndef main(argv: List[str]) -> int:\n    \"\"\"Main function for the CLI entrypoint.\n    It parses command-line arguments and orchestrates the rolling max computation.\n    \"\"\"\n    if \"--help\" in argv or \"-h\" in argv:\n        print(CLI_USAGE)\n        return 0\n\n    # Instantiate dependencies for the CLIController\n    validator = InputValidator()\n    service = RollingMaxService()\n    config = AppConfig(output_format=\"json\")  # Default output format for CLI\n\n    controller = CLIController(validator, service, config)\n    return controller.run(argv)\n\nif __name__ == \"__main__\":\n    sys.exit(main(sys.argv[1:]))\n\n```\n\n---\n\n### `pyproject.toml`\n\n```toml\n[project]\nname = \"rollingmax\"\nversion = \"0.1.0\"\ndescription = \"A Python library and CLI for computing rolling maximum of an integer sequence.\"\nauthors = [{ name = \"Your Name\", email = \"your.email@example.com\" }] # Update with actual author info\nrequires-python = \">=3.9\"\nlicense = { text = \"MIT\" }\nreadme = \"README.md\"\nkeywords = [\"rolling-max\", \"cumulative-max\", \"sequence\", \"utility\"]\nclassifiers = [\n    \"Programming Language :: Python :: 3\",\n    \"Programming Language :: Python :: 3.9\",\n    \"Programming Language :: Python :: 3.10\",\n    \"Programming Language :: Python :: 3.11\",\n    \"Programming Language :: Python :: 3.12\",\n    \"License :: OSI Approved :: MIT License\",\n    \"Operating System :: OS Independent\",\n    \"Development Status :: 3 - Alpha\",\n    \"Intended Audience :: Developers\",\n    \"Topic :: Software Development :: Libraries :: Python Modules\",\n    \"Topic :: Utilities\",\n]\n\n[project.urls]\nHomepage = \"https://github.com/yourusername/rollingmax\" # Update with actual repository URL\n\"Bug Tracker\" = \"https://github.com/yourusername/rollingmax/issues\" # Update with actual bug tracker URL\n\n[project.scripts]\nrollingmax = \"rollingmax.__main__:main\" # Optional entry point for direct execution\n\n# Configuration for Setuptools to find packages in src/\n[tool.setuptools]\npackages = [\"rollingmax\"]\n\n[tool.setuptools.package-dir]\nrollingmax = \"src/rollingmax\"\n\n# Development dependencies for testing\n[project.optional-dependencies]\ndev = [\"pytest>=7.0\"]\n\n# Build system requirements (using setuptools)\n[build-system]\nrequires = [\"setuptools>=61.0\", \"wheel\"]\nbuild-backend = \"setuptools.build_meta\"\n\n# --- Optional Poetry configuration (if using Poetry instead of setuptools) ---\n# [tool.poetry]\n# name = \"rollingmax\"\n# version = \"0.1.0\"\n# description = \"A Python library and CLI for computing rolling maximum of an integer sequence.\"\n# authors = [\"Your Name <your.email@example.com>\"]\n# license = \"MIT\"\n# readme = \"README.md\"\n# packages = [{ include = \"rollingmax\", from = \"src\" }]\n# keywords = [\"rolling-max\", \"cumulative-max\", \"sequence\", \"utility\"]\n# classifiers = [\n#     \"Programming Language :: Python :: 3\",\n#     \"Programming Language :: Python :: 3.9\",\n#     \"Programming Language :: 3.10\",\n#     \"Programming Language :: 3.11\",\n#     \"Programming Language :: 3.12\",\n#     \"License :: OSI Approved :: MIT License\",\n#     \"Operating System :: OS Independent\",\n#     \"Development Status :: 3 - Alpha\",\n#     \"Intended Audience :: Developers\",\n#     \"Topic :: Software Development :: Libraries :: Python Modules\",\n#     \"Topic :: Utilities\",\n# ]\n\n# [tool.poetry.dependencies]\n# python = \">=3.9\"\n\n# [tool.poetry.dev-dependencies]\n# pytest = \">=7.0\"\n\n# [build-system]\n# requires = [\"poetry-core>=1.0.0\"]\n# build-backend = \"poetry.core.masonry.api\"\n```\n\n---\n\n### `README.md`\n\n```markdown\n# rollingmax\n\nA Python library and command-line interface (CLI) to compute the rolling maximum of an integer sequence.\nThis project provides a robust, testable, and dependency-light solution for calculating cumulative maxima.\n\n## Features\n\n- **Library Function**: `rolling_max(numbers: List[int]) -> List[int]` for use in your Python applications.\n- **Command-Line Interface**: Process integer sequences directly from the terminal.\n- **Robust Input Validation**: Ensures correct data types and formats, raising `InvalidInputError` for problematic inputs.\n- **Efficiency**: Core algorithm is O(n) time and O(1) auxiliary space, suitable for large datasets.\n- **Dependency-Light**: Uses only Python's standard library for core functionality.\n\n## Installation\n\nYou can install `rollingmax` using pip:\n\n```bash\npip install rollingmax\n```\n\nFor local development, including test dependencies:\n\n```bash\ngit clone https://github.com/yourusername/rollingmax.git # Replace with your repository URL\ncd rollingmax\npip install -e \".[dev]\"\n```\n\n## Usage\n\n### As a Library\n\nImport and use the `rolling_max` function in your Python code:\n\n```python\nfrom rollingmax import rolling_max, InvalidInputError\nfrom typing import List\n\n# Example usage\nnumbers: List[int] = [1, 2, 3, 2, 3, 4, 2]\nresult: List[int] = rolling_max(numbers)\nprint(f\"Rolling max of {numbers} is: {result}\")\n# Expected output: Rolling max of [1, 2, 3, 2, 3, 4, 2] is: [1, 2, 3, 3, 3, 4, 4]\n\n# Handling empty input\nprint(f\"Rolling max of [] is: {rolling_max([])}\")\n# Expected output: Rolling max of [] is: []\n\n# Handling negative values and duplicates\nnumbers_neg: List[int] = [-5, -2, -8, 0, -1, 3]\nprint(f\"Rolling max of {numbers_neg} is: {rolling_max(numbers_neg)}\")\n# Expected output: Rolling max of [-5, -2, -8, 0, -1, 3] is: [-5, -2, -2, 0, 0, 3]\n\n# Handling invalid input\ntry:\n    rolling_max([1, \"two\", 3]) # type: ignore\nexcept InvalidInputError as e:\n    print(f\"Caught an error: {e}\")\n    # Expected output: Caught an error: All elements must be int (at index 1): 'two'\n\ntry:\n    rolling_max(\"not a list\") # type: ignore\nexcept InvalidInputError as e:\n    print(f\"Caught an error: {e}\")\n    # Expected output: Caught an error: Input must be a list of integers: 'not a list'\n```\n\n### As a Command-Line Tool\n\nYou can run the CLI using `python -m rollingmax` followed by numbers. Output is a JSON array by default.\n\n**Input via command-line arguments (space-separated):**\n\n```bash\npython -m rollingmax 1 2 3 2 3 4 2\n# Output: [1, 2, 3, 3, 3, 4, 4]\n```\n\n**Input via command-line arguments (comma-separated, in quotes to treat as single argument):**\n\n```bash\npython -m rollingmax \"1,2,3,2,3,4,2\"\n# Output: [1, 2, 3, 3, 3, 4, 4]\n```\n\n**Input via stdin (pipe, space-separated):**\n\n```bash\necho \"1 2 3 2 3 4 2\" | python -m rollingmax\n# Output: [1, 2, 3, 3, 3, 4, 4]\n```\n\n**Input via stdin (pipe, comma-separated):**\n\n```bash\necho \"1,2,3,2,3,4,2\" | python -m rollingmax\n# Output: [1, 2, 3, 3, 3, 4, 4]\n```\n\n**Empty input:**\n\n```bash\npython -m rollingmax\n# Output: []\n```\n\n```bash\necho \"\" | python -m rollingmax\n# Output: []\n```\n\n**Invalid input handling (errors are printed to stderr, exit code is non-zero):**\n\n```bash\npython -m rollingmax 1 2 abc 4\n# Output (to stderr): Error: All elements must be int (at index 0): 'abc'\n```\n\n```bash\necho \"1,2,three\" | python -m rollingmax\n# Output (to stderr): Error: All elements must be int (at index 2): 'three'\n```\n\n## Development\n\n### Running Tests\n\nTo run the unit and integration tests (after installing `pytest` via `pip install -e \".[dev]\"`):\n\n```bash\npytest\n```\n\n## License\n\nThis project is licensed under the MIT License - see the [LICENSE](LICENSE) file for details.\n```\n