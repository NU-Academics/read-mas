\n### Command-Line Interface (CLI)\n\n```bash\n# Basic usage\npython -m max_element 1 5 2 9 3\n# Output: 9\n\n# With string values\npython -m max_element apple banana cherry\n# Output: cherry\n\n# From stdin\necho -e \"10\\n5\\n20\\n3\" | python -m max_element\n# Output: 20\n\n# Error: empty input\npython -m max_element\n# Output: Error: Iterable is empty\n# Exit code: 3\n\n# Error: incomparable types\npython -m max_element 1 a\n# Output: Error: Elements '1' and 'a' are not mutually comparable.\n# Exit code: 2\n```\n\n\n# src/max_element/__init__.py\n\"\"\"Package exports and top-level convenience function.\"\"\"\n\nfrom typing import Iterable, Callable, Optional, TypeVar\n\nfrom .max_finder import MaxFinder\nfrom .exceptions import EmptyCollectionError, InvalidElementError\nfrom .validators import Validators # Export Validators as well for dependency injection options in tests/advanced usage\n\n__version__ = \"0.1.0\"\n\nT = TypeVar(\"T\")\nK = TypeVar(\"K\")\n\ndef max_element(iterable: Iterable[T], *, key: Optional[Callable[[T], K]] = None) -> T:\n    \"\"\"Return maximum element in the iterable.\n    This is a top-level convenience function delegating to MaxFinder.\n    \"\"\"\n    return MaxFinder().find_max(iterable, key=key)\n\n\n# src/max_element/exceptions.py\n\"\"\"Domain-specific exceptions for max_element utility.\"\"\"\n\nclass EmptyCollectionError(Exception):\n    \"\"\"Raised when an operation is performed on an empty collection.\"\"\"\n    def __init__(self, message: Optional[str] = None) -> None:\n        super().__init__(message or \"Collection cannot be empty.\")\n        self.message = message or \"Collection cannot be empty.\"\n\nclass InvalidElementError(Exception):\n    \"\"\"Raised when an element in the collection is invalid or not comparable.\"\"\"\n    def __init__(self, message: Optional[str] = None) -> None:\n        super().__init__(message or \"One or more elements are invalid.\")\n        self.message = message or \"One or more elements are invalid.\"\n\n\n# src/max_element/validators.py\n\"\"\"Input validation and comparability checks.\"\"\"\n\nfrom typing import Any, Iterable, Iterator, TypeVar\nfrom .exceptions import EmptyCollectionError, InvalidElementError\n\nT = TypeVar(\"T\")\n\nclass Validators:\n    \"\"\"Provides methods for validating collections and their elements.\"\"\"\n    def __init__(self) -> None:\n        \"\"\"Initializes the Validators instance.\"\"\"\n        pass\n\n    def validate_non_empty(self, it: Iterator[T]) -> T:\n        \"\"\"Ensures the iterator yields at least one element and returns it.\n        Raises EmptyCollectionError if the iterator is empty.\n        \"\"\"\n        try:\n            first_element = next(it)\n            return first_element\n        except StopIteration:\n            raise EmptyCollectionError(\"Iterable is empty\")\n\n    def is_comparable(self, a: Any, b: Any) -> bool:\n        \"\"\"Attempts to safely compare two items and returns if they are mutually comparable.\n        This avoids raising exceptions for common mixed-type comparisons.\n        \"\"\"\n        try:\n            # Try comparison in both directions to be safe\n            _ = a < b\n            _ = a > b\n            return True\n        except TypeError:\n            return False\n\n    def validate_items_comparable(self, sample: Any, item: Any) -> None:\n        \"\"\"Validates that sample and item are comparable.\n        Raises InvalidElementError if they are not mutually comparable.\n        \"\"\"\n        if not self.is_comparable(sample, item):\n            raise InvalidElementError(f\"Elements '{sample}' and '{item}' are not mutually comparable.\")\n\n\n# src/max_element/max_finder.py\n\"\"\"Core logic for finding the maximum element in a collection.\"\"\"\n\nfrom typing import Iterable, Callable, Optional, TypeVar\nfrom .validators import Validators\nfrom .exceptions import EmptyCollectionError, InvalidElementError\n\nT = TypeVar(\"T\")\nK = TypeVar(\"K\")\n\nclass MaxFinder:\n    \"\"\"Implements the algorithm to find the maximum element in an iterable.\"\"\"\n    def __init__(self, validators: Optional[Validators] = None) -> None:\n        \"\"\"Initializes MaxFinder, optionally injecting a Validators instance.\"\"\"\n        self._validators = validators or Validators()\n\n    def find_max(self, iterable: Iterable[T], *, key: Optional[Callable[[T], K]] = None) -> T:\n        \"\"\"Finds the maximum element in the iterable based on the key function.\n        Raises EmptyCollectionError or InvalidElementError for invalid inputs.\n        \"\"\"\n        it = iter(iterable)\n        \n        # Validate non-empty and get the first element\n        candidate = self._validators.validate_non_empty(it)\n\n        try:\n            best_key_val = key(candidate) if key else candidate\n        except Exception as e:\n            raise InvalidElementError(f\"Key function failed on initial element '{candidate}': {e}\") from e\n\n        best = candidate\n        best_key = best_key_val\n\n        for item in it:\n            try:\n                item_key_val = key(item) if key else item\n            except Exception as e:\n                raise InvalidElementError(f\"Key function failed on an element '{item}': {e}\") from e\n\n            # Validate comparability of keys before comparison\n            self._validators.validate_items_comparable(best_key, item_key_val)\n\n            # Perform the comparison\n            if item_key_val > best_key:\n                best, best_key = item, item_key_val\n        return best\n\n\n# src/max_element/utils.py\n\"\"\"Helper utilities for type coercion.\"\"\"\n\nfrom typing import Union\n\ndef coerce_value(s: str) -> Union[int, float, str]:\n    \"\"\"Attempts to convert a string to int, then float, else returns the original string.\n    This simple heuristic is for CLI argument parsing.\n    \"\"\"\n    try:\n        return int(s)\n    except ValueError:\n        try:\n            return float(s)\n        except ValueError:\n            return s\n\n\n# src/max_element/cli.py\n\"\"\"Command-line interface for the max_element utility.\"\"\"\n\nimport argparse\nimport sys\nfrom typing import List, Optional\n\nfrom .max_finder import MaxFinder\nfrom .utils import coerce_value\nfrom .exceptions import EmptyCollectionError, InvalidElementError\n\nclass CLI:\n    \"\"\"Handles command-line argument parsing and execution of MaxFinder.\"\"\"\n    def __init__(self, finder: Optional[MaxFinder] = None) -> None:\n        \"\"\"Initializes the CLI, optionally injecting a MaxFinder instance.\"\"\"\n        self._finder = finder or MaxFinder()\n\n    def parse_args(self, argv: Optional[List[str]] = None) -> argparse.Namespace:\n        \"\"\"Parses command-line arguments and returns an argparse Namespace.\"\"\"\n        parser = argparse.ArgumentParser(\n            prog=\"max_element\",\n            description=\"Find the maximum element from a list of values.\"\n        )\n        parser.add_argument(\n            \"values\",\n            nargs=\"*\",\n            help=\"Values to compute maximum from. If none provided, reads from stdin.\"\n        )\n        # Note: The design mentioned an optional --key flag but specified it's not supported beyond a code hook for forward compatibility.\n        # We omit explicit --key parsing for now as per design spec detail for simplicity,\n        # focusing on the primary value input.\n        return parser.parse_args(argv)\n\n    def run(self, argv: Optional[List[str]] = None) -> int:\n        \"\"\"Entry point for the CLI, handling argument parsing, execution, and error codes.\"\"\"\n        ns = self.parse_args(argv)\n        input_values = ns.values\n\n        # Read from stdin if no values provided via arguments and stdin is not a TTY\n        if not input_values and not sys.stdin.isatty():\n            input_values = [line.strip() for line in sys.stdin if line.strip()]\n\n        coerced_values = [coerce_value(v