{"task_id": "HumanEval/10", "solution": "def is_palindrome(string: str) -> bool:\n    \"\"\" Test if given string is a palindrome \"\"\"\n    return string == string[::-1]\n\n\ndef make_palindrome(string: str) -> str:\n    \"\"\" Find the shortest palindrome that begins with a supplied string.\n    It appends the reversed prefix before the longest palindromic suffix.\n    \"\"\"\n    if not string:\n        return \"\"\n    n = len(string)\n    for i in range(n):\n        suffix = string[i:]\n        if suffix == suffix[::-1]:\n            prefix = string[:i]\n            return string + prefix[::-1]"}
{"task_id": "HumanEval/11", "solution": "```python\ndef string_xor(a: str, b: str) -> str:\n    \"\"\" Input are two strings a and b consisting only of 1s and 0s.\n    Perform binary XOR on these inputs and return result also as a string.\n    >>> string_xor('010', '110')\n    '100'\n    \"\"\"\n    max_len = max(len(a), len(b))\n    padded_a = a.rjust(max_len, '0')\n    padded_b = b.rjust(max_len, '0')\n\n    result_chars = []\n    for char_a, char_b in zip(padded_a, padded_b):\n        result_chars.append('1' if char_a != char_b else '0')\n        \n    return \"\".join(result_chars)\n```"}
{"task_id": "HumanEval/11", "solution": "```python\ndef string_xor(a: str, b: str) -> str:\n    \"\"\"Performs bitwise XOR on two binary strings.\n    Assumes inputs are valid binary strings, matching in length as per example.\"\"\"\n    result = []\n    for bit_a, bit_b in zip(a, b):\n        if bit_a == bit_b:\n            result.append('0')\n        else:\n            result.append('1')\n    return ''.join(result)\n```"}
{"task_id": "HumanEval/10", "solution": "def is_palindrome(string: str) -> bool:\n    \"\"\" Test if given string is a palindrome. \"\"\"\n    return string == string[::-1]\n\ndef make_palindrome(string: str) -> str:\n    \"\"\" Find the shortest palindrome that begins with a supplied string. \"\"\"\n    n = len(string)\n    if n == 0:\n        return \"\"\n\n    # Find the longest suffix of the input string that is a palindrome.\n    # Iterate from i=0 to n-1. string[i:] is a suffix.\n    # The first string[i:] that is a palindrome will be the longest palindromic suffix.\n    longest_pal_suffix_start_index = 0\n    for i in range(n):\n        if is_palindrome(string[i:]):\n            longest_pal_suffix_start_index = i\n            break\n    \n    # The prefix before this longest palindromic suffix is string[:longest_pal_suffix_start_index].\n    # Append the reverse of this prefix to the original string.\n    prefix_to_reverse = string[:longest_pal_suffix_start_index]\n    return string + prefix_to_reverse[::-1]"}
{"task_id": "HumanEval/12", "solution": "```python\nfrom typing import List, Optional\n\n\ndef longest(strings: List[str]) -> Optional[str]:\n    \"\"\"Out of list of strings, return the longest one. Return the first one in case of multiple\n    strings of the same length. Return None in case the input list is empty.\"\"\"\n    if not strings:\n        return None\n\n    current_longest = strings[0]\n    for s in strings:\n        if len(s) > len(current_longest):\n            current_longest = s\n    return current_longest\n```"}
{"task_id": "HumanEval/12", "solution": "```python\nfrom typing import List, Optional\n\n\ndef longest(strings: List[str]) -> Optional[str]:\n    \"\"\"Returns the longest string from a list, or None if the list is empty. On ties, the first occurrence is returned.\"\"\"\n    best = None\n    best_len = -1\n    for s in strings:\n        current_len = len(s)\n        if current_len > best_len:\n            best = s\n            best_len = current_len\n    return best\n```"}
{"task_id": "HumanEval/13", "solution": "def greatest_common_divisor(a: int, b: int) -> int:\n    \"\"\" Return a greatest common divisor of two integers a and b.\n    This uses the Euclidean algorithm, ensuring a non-negative result.\n    \"\"\"\n    a = abs(a)\n    b = abs(b)\n    while b:\n        a, b = b, a % b\n    return a"}
{"task_id": "HumanEval/13", "solution": "```python\n# src/gcd_app/__init__.py\n\"\"\"GCD Application Package\"\"\"\nfrom .services.gcd_service import GCDService\nfrom .controllers.cli import CLIController\nfrom .controllers.api import APIController\nfrom .exceptions import InvalidInputError, ComputationError\n\n__version__ = \"0.1.0\"\n__all__ = [\"GCDService\", \"CLIController\", \"APIController\", \"InvalidInputError\", \"ComputationError\"]\n\n# Re-export key components for convenient access\n```\n\n```python\n# src/gcd_app/config.py\n\"\"\"Centralized configuration for the GCD application.\"\"\"\n\nMAX_INPUT_BITS: int = 10000\n\"\"\"Maximum allowed bit length for integer inputs to prevent DoS.\"\"\"\n\nDEFAULT_LOG_LEVEL: str = \"INFO\"\n\"\"\"Default logging level for the application.\"\"\"\n```\n\n```python\n# src/gcd_app/exceptions.py\n\"\"\"Custom exceptions for the GCD application.\"\"\"\n\nclass InvalidInputError(ValueError):\n    \"\"\"\n    Exception raised for invalid user inputs (e.g., non-integer, too large).\n    \"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n\nclass ComputationError(RuntimeError):\n    \"\"\"\n    Exception raised for unexpected failures during GCD computation.\n    \"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n```\n\n```python\n# src/gcd_app/logging_config.py\n\"\"\"Logging setup for the GCD application.\"\"\"\nimport logging\nfrom typing import Optional\nfrom . import config\n\ndef configure_logging(level: Optional[str] = None) -> None:\n    \"\"\"\n    Configures basic logging for the application.\n    Args:\n        level: Optional string log level (e.g., \"INFO\", \"DEBUG\").\n               Defaults to config.DEFAULT_LOG_LEVEL.\n    \"\"\"\n    log_level = level or config.DEFAULT_LOG_LEVEL\n    logging.basicConfig(level=log_level.upper(),\n                        format='%(asctime)s - %(name)s - %(levelname)s - %(message)s')\n```\n\n```python\n# src/gcd_app/models/dto.py\n\"\"\"Data Transfer Objects (DTOs) for GCD requests and responses.\"\"\"\nfrom typing import Any, Dict\nfrom ..utils.validators import Validators\n\nclass GCDRequest:\n    \"\"\"\n    DTO for GCD calculation requests, holding two integer inputs.\n    \"\"\"\n    def __init__(self, a: int, b: int) -> None:\n        self.a = a\n        self.b = b\n\n    @classmethod\n    def from_dict(cls, data: Dict[str, Any]) -> \"GCDRequest\":\n        \"\"\"\n        Creates a GCDRequest instance from a dictionary, validating inputs.\n        \"\"\"\n        a_val = data.get(\"a\")\n        b_val = data.get(\"b\")\n        a = Validators.parse_int(a_val, \"a\")\n        b = Validators.parse_int(b_val, \"b\")\n        return cls(a=a, b=b)\n\nclass GCDResponse:\n    \"\"\"\n    DTO for GCD calculation responses, holding the computed GCD.\n    \"\"\"\n    def __init__(self, gcd: int) -> None:\n        self.gcd = gcd\n\n    def to_dict(self) -> Dict[str, int]:\n        \"\"\"\n        Converts the GCDResponse instance to a dictionary.\n        \"\"\"\n        return {\"gcd\": self.gcd}\n```\n\n```python\n# src/gcd_app/utils/validators.py\n\"\"\"Utility class for input validation and parsing.\"\"\"\nfrom typing import Any\nfrom ..exceptions import InvalidInputError\nimport math\n\nclass Validators:\n    \"\"\"\n    Provides static methods for validating and parsing various input types.\n    \"\"\"\n    @staticmethod\n    def parse_int(value: Any, param_name: str = \"value\") -> int:\n        \"\"\"\n        Parses an input value into an integer, raising InvalidInputError on failure.\n        Accepts integers, numeric strings (including hex/octal), and integral floats.\n        \"\"\"\n        if isinstance(value, int):\n            return value\n        if isinstance(value, str):\n            try:\n                # int(value, 0) handles hex/octal strings like \"0x10\" or \"0o10\"\n                return int(value, 0)\n            except ValueError:\n                raise InvalidInputError(\n                    f\"Parameter '{param_name}' must be an integer string or number, got '{value}'\"\n                )\n        if isinstance(value, float):\n            if value.is_integer():\n                return int(value)\n            raise InvalidInputError(\n                f\"Parameter '{param_name}' must be an integer, not a non-integral float '{value}'\"\n            )\n        raise InvalidInputError(\n            f\"Parameter '{param_name}' must be an integer, got type {type(value).__name__}\"\n        )\n\n    @staticmethod\n    def check_bit_length(value: int, max_bits: int) -> None:\n        \"\"\"\n        Checks if the absolute value of an integer exceeds a maximum bit length.\n        Raises InvalidInputError if the limit is exceeded.\n        \"\"\"\n        if value < 0:\n            value = abs(value)\n        \n        # log2(0) is undefined, handle 0 explicitly as it has 0 bit length\n        if value == 0:\n            return\n\n        # An integer N requires floor(log2(N)) + 1 bits to represent.\n        # Python's int.bit_length() returns the number of bits required to represent\n        # an integer in binary, excluding the sign and leading zeros.\n        # e.g., (0).bit_length() is 0, (1).bit_length() is 1, (2).bit_length() is 2\n        # For non-negative numbers, this is equivalent to floor(log2(N))+1 if N > 0.\n        if value.bit_length() > max_bits:\n            raise InvalidInputError(\n                f\"Input value exceeds maximum allowed bit length of {max_bits}. \"\n                f\"Current bit length: {value.bit_length()}\"\n            )\n\n```\n\n```python\n# src/gcd_app/services/gcd_service.py\n\"\"\"Core business logic for GCD computation.\"\"\"\nfrom ..exceptions import InvalidInputError, ComputationError\nfrom ..config import MAX_INPUT_BITS\nfrom ..utils.validators import Validators\n\nclass GCDService:\n    \"\"\"\n    Provides the core functionality for computing the Greatest Common Divisor.\n    \"\"\"\n    def __init__(self, max_bits: int = MAX_INPUT_BITS) -> None:\n        \"\"\"\n        Initializes the GCDService with a maximum allowed bit length for inputs.\n        Args:\n            max_bits: The maximum bit length for integer inputs.\n        \"\"\"\n        self._max_bits = max_bits\n\n    def compute(self, a: int, b: int) -> int:\n        \"\"\"\n        Computes the greatest common divisor of two integers using the Euclidean algorithm.\n        Handles normalization (absolute values), special cases like (0,0), and input validation.\n        Args:\n            a: The first integer.\n            b: The second integer.\n        Returns:\n            The non-negative greatest common divisor of a and b.\n        Raises:\n            InvalidInputError: If inputs are invalid (e.g., too large).\n            ComputationError: If an unexpected error occurs during calculation.\n        \"\"\"\n        if not isinstance(a, int) or not isinstance(b, int):\n            # This check is mostly for internal consistency after validation,\n            # as Validators.parse_int should ensure int type.\n            raise ComputationError(\"Internal error: Inputs must be integers.\")\n\n        # Handle max bit length before further processing\n        Validators.check_bit_length(a, self._max_bits)\n        Validators.check_bit_length(b, self._max_bits)\n        \n        # Business rule: GCD is always non-negative; negative inputs treated by absolute value.\n        a_abs = abs(a)\n        b_abs = abs(b)\n\n        # Business rule: gcd(0, 0) = 0\n        if a_abs == 0 and b_abs == 0:\n            return 0\n        \n        try:\n            return self._euclidean(a_abs, b_abs)\n        except Exception as exc:\n            raise ComputationError(f\"GCD algorithm failed unexpectedly: {exc}\") from exc\n\n    def _euclidean(self, a: int, b: int) -> int:\n        \"\"\"\n        Private method implementing the iterative Euclidean algorithm.\n        Assumes a and b are non-negative.\n        \"\"\"\n        while b:\n            a, b = b, a % b\n        return a\n```\n\n```python\n# src/gcd_app/controllers/cli.py\n\"\"\"Command Line Interface (CLI) controller for the GCD application.\"\"\"\nimport sys\nimport argparse\nimport logging\nfrom typing import List, Optional\n\nfrom ..services.gcd_service import GCDService\nfrom ..exceptions import InvalidInputError, ComputationError\nfrom ..utils.validators import Validators\nfrom ..logging_config import configure_logging\n\nlogger = logging.getLogger(__name__)\n\nclass CLIController:\n    \"\"\"\n    Manages command-line argument parsing and interaction for GCD computation.\n    \"\"\"\n    def __init__(self, gcd_service: GCDService) -> None:\n        \"\"\"\n        Initializes the CLIController with a GCDService instance.\n        \"\"\"\n        self._gcd_service = gcd_service\n        self._parser = self._create_parser()\n\n    def _create_parser(self) -> argparse.ArgumentParser:\n        \"\"\"\n        Creates and configures the argument parser for the CLI.\n        \"\"\"\n        parser = argparse.ArgumentParser(\n            description=\"Compute the Greatest Common Divisor (GCD) of two integers.\",\n            epilog=\"Example: gcd-app 25 15\"\n        )\n        parser.add_argument(\n            \"a\", type=str, help=\"The first integer (can be negative, zero, or large).\"\n        )\n        parser.add_argument(\n            \"b\", type=str, help=\"The second integer (can be negative, zero, or large).\"\n        )\n        parser.add_argument(\n            \"--log-level\",\n            dest=\"log_level\",\n            default=None,\n            help=\"Set the logging level (e.g., DEBUG, INFO, WARNING, ERROR).\"\n        )\n        return parser\n\n    def run(self, argv: List[str]) -> int:\n        \"\"\"\n        Executes the CLI application with the given arguments.\n        Parses arguments, computes GCD, prints result, and returns an exit code.\n        Args:\n            argv: A list of command-line arguments (e.g., sys.argv[1:]).\n        Returns:\n            0 on success, non-zero on error.\n        \"\"\"\n        try:\n            args = self._parser.parse_args(argv)\n            configure_logging(args.log_level)\n            \n            logger.debug(f\"CLI arguments received: a='{args.a}', b='{args.b}'\")\n\n            a_val = Validators.parse_int(args.a, \"a\")\n            b_val = Validators.parse_int(args.b, \"b\")\n\n            result = self._gcd_service.compute(a_val, b_val)\n            print(result)\n            logger.info(f\"GCD({args.a}, {args.b}) = {result}\")\n            return 0\n        except InvalidInputError as e:\n            logger.error(f\"Invalid input: {e}\")\n            print(f\"Error: {e}\", file=sys.stderr)\n            return 2  # Common exit code for invalid arguments\n        except ComputationError as e:\n            logger.error(f\"Computation error: {e}\")\n            print(f\"Error: {e}\", file=sys.stderr)\n            return 3  # Custom exit code for computation failure\n        except Exception as e:\n            logger.critical(f\"An unexpected error occurred: {e}\", exc_info=True)\n            print(f\"An unexpected error occurred: {e}\", file=sys.stderr)\n            return 1  # Generic error\n```\n\n```python\n# src/gcd_app/controllers/api.py\n\"\"\"HTTP API controller for the GCD application using FastAPI.\"\"\"\nfrom fastapi import FastAPI, HTTPException, Request, Query\nfrom fastapi.responses import JSONResponse\nfrom pydantic import BaseModel\nimport logging\nfrom typing import Optional\n\nfrom ..services.gcd_service import GCDService\nfrom ..exceptions import InvalidInputError, ComputationError\nfrom ..utils.validators import Validators\nfrom ..logging_config import configure_logging\nfrom ..config import DEFAULT_LOG_LEVEL\n\nlogger = logging.getLogger(__name__)\n\n# Configure logging at module level, will be called once on import\nconfigure_logging(DEFAULT_LOG_LEVEL)\n\nclass GCDRequestPayload(BaseModel):\n    \"\"\"Pydantic model for validating POST request body.\"\"\"\n    a: str  # Use string to allow validator to handle various formats\n    b: str\n\nclass APIController:\n    \"\"\"\n    Manages the creation and routing for the FastAPI application.\n    \"\"\"\n    def __init__(self, gcd_service: GCDService) -> None:\n        \"\"\"\n        Initializes the APIController with a GCDService instance.\n        \"\"\"\n        self._gcd_service = gcd_service\n\n    def create_app(self) -> FastAPI:\n        \"\"\"\n        Creates and configures the FastAPI application with GCD endpoints.\n        \"\"\"\n        app = FastAPI(\n            title=\"GCD Service\",\n            description=\"A simple service to compute the Greatest Common Divisor of two integers.\",\n            version=\"0.1.0\"\n        )\n\n        @app.exception_handler(InvalidInputError)\n        async def invalid_input_exception_handler(request: Request, exc: InvalidInputError):\n            logger.warning(f\"Invalid input received: {exc.args[0]}\")\n            return JSONResponse(\n                status_code=400,\n                content={\"error\": str(exc)},\n            )\n\n        @app.exception_handler(ComputationError)\n        async def computation_exception_handler(request: Request, exc: ComputationError):\n            logger.error(f\"Computation error: {exc.args[0]}\", exc_info=True)\n            return JSONResponse(\n                status_code=500,\n                content={\"error\": \"An internal computation error occurred.\"},\n            )\n\n        @app.exception_handler(Exception)\n        async def generic_exception_handler(request: Request, exc: Exception):\n            logger.critical(f\"An unhandled error occurred: {exc}\", exc_info=True)\n            return JSONResponse(\n                status_code=500,\n                content={\"error\": \"An unexpected server error occurred.\"},\n            )\n\n        @app.get(\"/gcd\", summary=\"Compute GCD via GET request\")\n        async def get_gcd(\n            a: str = Query(..., description=\"The first integer.\"),\n            b: str = Query(..., description=\"The second integer.\")\n        ):\n            \"\"\"\n            Computes the GCD of two integers provided as query parameters.\n            \"\"\"\n            logger.debug(f\"GET /gcd request: a='{a}', b='{b}'\")\n            a_val = Validators.parse_int(a, \"a\")\n            b_val = Validators.parse_int(b, \"b\")\n            gcd = self._gcd_service.compute(a_val, b_val)\n            logger.info(f\"Computed GCD({a},{b}) = {gcd}\")\n            return {\"gcd\": gcd}\n\n        @app.post(\"/gcd\", summary=\"Compute GCD via POST request\")\n        async def post_gcd(payload: GCDRequestPayload):\n            \"\"\"\n            Computes the GCD of two integers provided in the request body.\n            \"\"\"\n            logger.debug(f\"POST /gcd request: payload={payload.dict()}\")\n            a_val = Validators.parse_int(payload.a, \"a\")\n            b_val = Validators.parse_int(payload.b, \"b\")\n            gcd = self._gcd_service.compute(a_val, b_val)\n            logger.info(f\"Computed GCD({payload.a},{payload.b}) = {gcd}\")\n            return {\"gcd\": gcd}\n        \n        return app\n\n# This global instance is for uvicorn to pick up, e.g., `uvicorn gcd_app.controllers.api:app`\n# It's also good practice for explicit app creation.\n_gcd_service_instance = GCDService()\napp = APIController(gcd_service=_gcd_service_instance).create_app()\n```\n\n```python\n# src/gcd_app/__main__.py\n\"\"\"\nCLI entrypoint for the GCD application.\nAllows running the GCD computation directly from the terminal.\n\"\"\"\nimport sys\nimport logging\nfrom typing import List\n\nfrom .services.gcd_service import GCDService\nfrom .controllers.cli import CLIController\nfrom .config import MAX_INPUT_BITS, DEFAULT_LOG_LEVEL\nfrom .logging_config import configure_logging\n\nlogger = logging.getLogger(__name__)\n\ndef main(argv: Optional[List[str]] = None) -> int:\n    \"\"\"\n    Main function for the CLI entrypoint.\n    Initializes the GCDService and CLIController, then runs the CLI.\n    Args:\n        argv: List of command-line arguments, defaults to sys.argv[1:].\n    Returns:\n        An integer exit code (0 for success, non-zero for errors).\n    \"\"\"\n    configure_logging(DEFAULT_LOG_LEVEL) # Initial logging setup for main\n    logger.debug(\"CLI main function started.\")\n\n    if argv is None:\n        argv = sys.argv[1:]\n\n    try:\n        gcd_service = GCDService(max_bits=MAX_INPUT_BITS)\n        cli_controller = CLIController(gcd_service=gcd_service)\n        exit_code = cli_controller.run(argv)\n        logger.debug(f\"CLI finished with exit code {exit_code}\")\n        return exit_code\n    except Exception as e:\n        logger.critical(f\"Unhandled error in main execution: {e}\", exc_info=True)\n        print(f\"An unhandled error occurred: {e}\", file=sys.stderr)\n        return 1\n\nif __name__ == \"__main__\":\n    sys.exit(main())\n```\n\n```toml\n# pyproject.toml\n[tool.poetry]\nname = \"gcd-app\"\nversion = \"0.1.0\"\ndescription = \"A Python application to compute the Greatest Common Divisor (GCD).\"\nauthors = [\"Your Name <your.email@example.com>\"]\nreadme = \"README.md\"\npackages = [{include = \"gcd_app\", from = \"src\"}]\n\n[tool.poetry.dependencies]\npython = \">=3.9,<4.0\"\nfastapi = {version = \"^0.111.0\", optional = true}\nuvicorn = {version = \"^0.30.1\", optional = true}\npydantic = {version = \"^2.0\", optional = true} # Required by FastAPI\n\n[tool.poetry.group.dev.dependencies]\npytest = \"^8.2.2\"\npytest-cov = \"^5.0.0\"\nflake8 = \"^7.1.0\"\nmypy = \"^1.10.0\"\nhttpx = \"^0.27.0\" # For testing FastAPI client\n\n[tool.poetry.scripts]\ngcd-app = \"gcd_app.__main__:main\"\n\n[tool.poetry.extras]\napi = [\"fastapi\", \"uvicorn\", \"pydantic\"]\n\n[build-system]\nrequires = [\"poetry-core\"]\nbuild-backend = \"poetry.core.masonry.api\"\n\n[tool.pytest.ini_options]\nminversion = \"6.0\"\naddopts = \"-ra -q\"\ntestpaths = [\n    \"tests\",\n]\n\n[tool.mypy]\npython_version = \"3.9\"\nignore_missing_imports = true\npretty = true\nshow_error_codes = true\n```\n\n```text\n# requirements.txt\n# This file is for minimal installs, typically generated from pyproject.toml\n#\n# For core library and CLI:\n# No direct external dependencies.\n#\n# For optional API functionality:\nfastapi>=0.111.0\nuvicorn>=0.30.1\npydantic>=2.0.0\n#\n# For development/testing:\n# pytest>=8.2.2\n# pytest-cov>=5.0.0\n# flake8>=7.1.0\n# mypy>=1.10.0\n# httpx>=0.27.0\n```\n\n```ini\n# tox.ini\n[tox]\nenv_list = py39,py310,py311,lint,type\nmin_version = 4.0\n\n[testenv]\ndescription = Run pytest against installed package\npackage = skip\ndeps =\n    pytest\n    pytest-cov\ncommands =\n    pytest --cov=gcd_app --cov-report=term-missing {posargs:tests}\n\n[testenv:py39]\nbase_python = python3.9\n\n[testenv:py310]\nbase_python = python3.10\n\n[testenv:py311]\nbase_python = python3.11\n\n[testenv:lint]\ndescription = Check code style with flake8\nbase_python = python3.9\nskip_install = True\ndeps =\n    flake8\ncommands =\n    flake8 src tests\n\n[testenv:type]\ndescription = Check type hints with mypy\nbase_python = python3.9\ndeps =\n    mypy\n    fastapi # mypy needs to see these for API module\n    uvicorn\n    pydantic\n    httpx\ncommands =\n    mypy src\n```\n\n```yaml\n# .github/workflows/ci.yml\nname: Python CI\n\non:\n  push:\n    branches: [ \"main\" ]\n  pull_request:\n    branches: [ \"main\" ]\n\njobs:\n  build:\n    runs-on: ubuntu-latest\n    strategy:\n      matrix:\n        python-version: [\"3.9\", \"3.10\", \"3.11\"]\n\n    steps:\n    - uses: actions/checkout@v4\n    - name: Set up Python ${{ matrix.python-version }}\n      uses: actions/setup-python@v5\n      with:\n        python-version: ${{ matrix.python-version }}\n        cache: 'poetry'\n    - name: Install dependencies\n      run: |\n        pip install poetry\n        poetry install --with dev --all-extras\n    - name: Run tests with pytest\n      run: |\n        poetry run pytest --cov=src/gcd_app --cov-report=xml\n    - name: Upload coverage reports\n      uses: codecov/codecov-action@v4\n      with:\n        token: ${{ secrets.CODECOV_TOKEN }}\n        slug: your-org/gcd-app # Replace with your GitHub organization/repo\n        file: ./coverage.xml\n        fail_ci_if_error: true\n    - name: Check code style with flake8\n      run: |\n        poetry run flake8 src tests\n    - name: Check type hints with mypy\n      run: |\n        poetry run mypy src\n```\n\n```markdown\n# README.md\n# GCD App\n\nA Python application to compute the Greatest Common Divisor (GCD) of two integers, exposed as a reusable library, a command-line interface (CLI), and an optional HTTP API.\n\n## Features\n\n- **Core Library**: A Python function to compute GCD using the Euclidean algorithm.\n- **CLI**: Compute GCD directly from your terminal.\n- **HTTP API (Optional)**: A FastAPI-based service to compute GCD via `GET` and `POST` requests.\n- **Robust Input Handling**: Supports negative numbers, zero, and large integers up to a configurable bit length.\n- **Comprehensive Testing**: Includes unit and integration tests.\n- **Configurable**: Max input bit length and logging levels can be adjusted.\n\n## Installation\n\n### Using Poetry (Recommended)\n\n```bash\n# Clone the repository\ngit clone https://github.com/your-org/gcd-app.git # Replace with your repo\ncd gcd-app\n\n# Install core dependencies (for library and CLI)\npoetry install\n\n# To enable the optional HTTP API dependencies\npoetry install --extras api\n```\n\n### Using pip and requirements.txt\n\n```bash\n# Clone the repository\ngit clone https://github.com/your-org/gcd-app.git\ncd gcd-app\n\n# Install core dependencies (for library and CLI)\npip install -e .\n\n# To install dependencies for the optional HTTP API:\npip install -e .[api]\n```\n\n## Usage\n\n### 1. As a Python Library\n\nYou can import and use the `GCDService` directly in your Python projects.\n\n```python\nfrom gcd_app import GCDService, InvalidInputError, ComputationError\n\n# Initialize the service (can optionally pass max_bits)\ngcd_calculator = GCDService()\n\ntry:\n    result = gcd_calculator.compute(25, 15)\n    print(f\"GCD(25, 15) = {result}\") # Output: 5\n\n    result_neg = gcd_calculator.compute(-6, 9)\n    print(f\"GCD(-6, 9) = {result_neg}\") # Output: 3\n\n    result_zero = gcd_calculator.compute(0, 0)\n    print(f\"GCD(0, 0) = {result_zero}\") # Output: 0\n\n    # Example of invalid input\n    # gcd_calculator.compute(\"abc\", 10) # This would raise InvalidInputError\n\nexcept InvalidInputError as e:\n    print(f\"Input Error: {e}\")\nexcept ComputationError as e:\n    print(f\"Computation Error: {e}\")\n```\n\n### 2. Command-Line Interface (CLI)\n\nThe package installs a `gcd-app` command-line entry point.\n\n```bash\n# Basic usage\ngcd-app 25 15\n# Output: 5\n\ngcd-app -6 9\n# Output: 3\n\ngcd-app 0 0\n# Output: 0\n\n# With invalid input\ngcd-app hello world\n# Output: Error: Parameter 'a' must be an integer string or number, got 'hello'\n\n# With log level\ngcd-app 100 20 --log-level DEBUG\n# Output: 20\n# (and debug logs will be printed to stderr)\n```\n\n### 3. HTTP API (Optional)\n\nIf you installed with `--extras api` or `.[api]`, you can run the HTTP API using Uvicorn.\n\n```bash\n# Run the API server\nuvicorn gcd_app.controllers.api:app --host 0.0.0.0 --port 8000 --reload\n```\n\nOnce the server is running, you can access the API:\n\n#### GET /gcd\n\n```bash\n# Example using curl\ncurl \"http://localhost:8000/gcd?a=25&b=15\"\n# Response: {\"gcd\":5}\n\ncurl \"http://localhost:8000/gcd?a=-6&b=9\"\n# Response: {\"gcd\":3}\n\ncurl \"http://localhost:8000/gcd?a=invalid&b=10\"\n# Response: {\"detail\":\"Parameter 'a' must be an integer string or number, got 'invalid'\"}\n```\n\n#### POST /gcd\n\n```bash\n# Example using curl\ncurl -X POST -H \"Content-Type: application/json\" -d '{\"a\": 25, \"b\": 15}' http://localhost:8000/gcd\n# Response: {\"gcd\":5}\n\ncurl -X POST -H \"Content-Type: application/json\" -d '{\"a\": \"0x1A\", \"b\": 10}' http://localhost:8000/gcd\n# Response: {\"gcd\":2}\n\ncurl -X POST -H \"Content-Type: application/json\" -d '{\"a\": 100, \"b\": \"bad\"}' http://localhost:8000/gcd\n# Response: {\"detail\":\"Parameter 'b' must be an integer string or number, got 'bad'\"}\n```\n\n## Development and Testing\n\n### Running Tests\n\n```bash\n# Install dev dependencies if not already done\npoetry install --with dev --all-extras\n\n# Run all tests\npoetry run pytest\n\n# Run tests with coverage report\npoetry run pytest --cov=src/gcd_app --cov-report=term-missing\n\n# Run linting\npoetry run flake8 src tests\n\n# Run type checking\npoetry run mypy src\n```\n\n### CI/CD\n\nThe project includes a GitHub Actions workflow (`.github/workflows/ci.yml`) to automatically run tests, linting, and type checks on pushes and pull requests.\n\n## Configuration\n\nYou can configure the maximum allowed bit length for integer inputs (default 10,000 bits) and the default logging level by modifying `src/gcd_app/config.py`.\n\n## License\n\nThis project is licensed under the MIT License - see the `LICENSE` file for details (if applicable).\n```\n\n```python\n# tests/test_gcd_service.py\nimport pytest\nfrom gcd_app.services.gcd_service import GCDService\nfrom gcd_app.exceptions import InvalidInputError, ComputationError\nfrom gcd_app.config import MAX_INPUT_BITS\n\n# Use a default service instance for most tests, or create new ones for specific max_bits\n_svc = GCDService()\n\n@pytest.mark.parametrize(\"a,b,expected\", [\n    (3, 5, 1),\n    (25, 15, 5),\n    (100, 20, 20),\n    (7, 0, 7),\n    (0, 7, 7),\n    (0, 0, 0), # Business rule: gcd(0,0) = 0\n    (-6, 9, 3), # Negative inputs handled by abs\n    (6, -9, 3),\n    (-6, -9, 3),\n    (1, 1, 1),\n    (12345, 54321, 3),\n    (999999999, 1000000000, 1), # Large numbers\n])\ndef test_gcd_compute_correctness(a, b, expected):\n    \"\"\"Test GCDService.compute for various valid integer inputs.\"\"\"\n    assert _svc.compute(a, b) == expected\n\ndef test_gcd_large_number_within_limits():\n    \"\"\"Test with numbers close to MAX_INPUT_BITS but within limits.\"\"\"\n    # A number with MAX_INPUT_BITS - 1 bits\n    a = (1 << (MAX_INPUT_BITS - 1)) - 1\n    b = (1 << (MAX_INPUT_BITS - 2)) - 1\n    assert _svc.compute(a, b) == _svc._euclidean(a, b) # Should compute without error\n\ndef test_gcd_exceeds_max_bit_length_raises_error():\n    \"\"\"Test that inputs exceeding MAX_INPUT_BITS raise InvalidInputError.\"\"\"\n    too_large_a = 1 << MAX_INPUT_BITS # This number has MAX_INPUT_BITS + 1 bits\n    normal_b = 100\n\n    with pytest.raises(InvalidInputError, match=\"Input value exceeds maximum allowed bit length\"):\n        _svc.compute(too_large_a, normal_b)\n\n    with pytest.raises(InvalidInputError, match=\"Input value exceeds maximum allowed bit length\"):\n        _svc.compute(normal_b, too_large_a)\n    \n    # Test with custom max_bits\n    custom_svc = GCDService(max_bits=100)\n    with pytest.raises(InvalidInputError, match=\"Input value exceeds maximum allowed bit length\"):\n        custom_svc.compute(1 << 101, 10)\n\n\ndef test_gcd_computation_error_not_expected():\n    \"\"\"Test that a ComputationError is not raised for valid inputs.\"\"\"\n    # This test primarily ensures no unexpected internal errors occur\n    # The _euclidean method is robust, so we expect no ComputationError for ints.\n    # We mainly test that the wrapper compute() doesn't raise it.\n    assert _svc.compute(10, 20) == 10\n    assert _svc.compute(1, 0) == 1\n    assert _svc.compute(0, 1) == 1\n\ndef test_gcd_with_max_int_values():\n    \"\"\"Test with Python's arbitrary precision integers.\"\"\"\n    # These should pass as long as bit length is respected.\n    max_python_int = sys.maxsize # This is typically 2^63 - 1 or 2^31 - 1\n    a = max_python_int\n    b = max_python_int - 1\n    assert _svc.compute(a, b) == 1 # GCD of consecutive numbers is 1\n\n    a_large = 2**200 - 1\n    b_large = 2**100 - 1\n    if a_large.bit_length() <= MAX_INPUT_BITS and b_large.bit_length() <= MAX_INPUT_BITS:\n        # A large Mersenne prime like number and a smaller one. GCD should be 1 or the smaller.\n        assert _svc.compute(a_large, b_large) == 1 # since 2^200-1 = (2^100-1)(2^100+1)+2^100-1\n\n# Test the _euclidean private method directly for non-negative inputs\n@pytest.mark.parametrize(\"a,b,expected\", [\n    (3, 5, 1),\n    (25, 15, 5),\n    (100, 20, 20),\n    (7, 0, 7),\n    (0, 7, 7),\n    (0, 0, 0),\n    (1, 1, 1),\n    (12345, 54321, 3),\n])\ndef test_euclidean_algorithm(a, b, expected):\n    \"\"\"Test the internal _euclidean method with non-negative inputs.\"\"\"\n    assert _svc._euclidean(a, b) == expected\n```\n\n```python\n# tests/test_cli.py\nimport pytest\nimport sys\nfrom unittest.mock import patch\nfrom io import StringIO\n\nfrom gcd_app.__main__ import main\nfrom gcd_app.config import MAX_INPUT_BITS\nfrom gcd_app.exceptions import InvalidInputError\n\n# Mock GCDService for isolated CLI testing\nclass MockGCDService:\n    def __init__(self, max_bits: int = MAX_INPUT_BITS):\n        self._max_bits = max_bits\n\n    def compute(self, a: int, b: int) -> int:\n        # Simulate validation for bit length\n        from gcd_app.utils.validators import Validators\n        Validators.check_bit_length(a, self._max_bits)\n        Validators.check_bit_length(b, self._max_bits)\n        # Simple GCD for mock - or return a fixed value\n        # For simplicity in mock, let's just return a fixed value or actual simple gcd\n        if a == 0 and b == 0:\n            return 0\n        a_abs = abs(a)\n        b_abs = abs(b)\n        while b_abs:\n            a_abs, b_abs = b_abs, a_abs % b_abs\n        return a_abs\n\n@pytest.fixture\ndef mock_gcd_service():\n    \"\"\"Fixture to provide a mocked GCDService.\"\"\"\n    return MockGCDService()\n\n@pytest.fixture\ndef cli_controller_with_mock_svc(mock_gcd_service):\n    \"\"\"Fixture to provide a CLIController with mocked GCDService.\"\"\"\n    from gcd_app.controllers.cli import CLIController\n    return CLIController(gcd_service=mock_gcd_service)\n\n@pytest.mark.parametrize(\"args, expected_output, expected_exit_code\", [\n    ([\"25\", \"15\"], \"5\\n\", 0),\n    ([\"-6\", \"9\"], \"3\\n\", 0),\n    ([\"0\", \"0\"], \"0\\n\", 0),\n    ([\"12345678901234567890\", \"98765432109876543210\"], \"9876543210\\n\", 0), # large numbers\n])\ndef test_cli_success(cli_controller_with_mock_svc, args, expected_output, expected_exit_code):\n    \"\"\"Test successful CLI execution with valid inputs.\"\"\"\n    with patch('sys.stdout', new=StringIO()) as mock_stdout:\n        exit_code = cli_controller_with_mock_svc.run(args)\n        assert exit_code == expected_exit_code\n        assert mock_stdout.getvalue() == expected_output\n\n@pytest.mark.parametrize(\"args, expected_error_msg, expected_exit_code\", [\n    ([], \"Error: Usage: gcd-app <a> <b>\\n\", 2), # Not enough arguments\n    ([\"10\"], \"Error: Usage: gcd-app <a> <b>\\n\", 2), # Not enough arguments\n    ([\"abc\", \"15\"], \"Error: Parameter 'a' must be an integer string or number, got 'abc'\\n\", 2), # Non-integer input\n    ([\"25\", \"def\"], \"Error: Parameter 'b' must be an integer string or number, got 'def'\\n\", 2), # Non-integer input\n    ([\"1.5\", \"15\"], \"Error: Parameter 'a' must be an integer, not a non-integral float '1.5'\\n\", 2), # Float input\n])\ndef test_cli_invalid_input_errors(cli_controller_with_mock_svc, args, expected_error_msg, expected_exit_code):\n    \"\"\"Test CLI error handling for invalid user inputs.\"\"\"\n    with patch('sys.stdout', new=StringIO()) as mock_stdout:\n        with patch('sys.stderr', new=StringIO()) as mock_stderr:\n            exit_code = cli_controller_with_mock_svc.run(args)\n            