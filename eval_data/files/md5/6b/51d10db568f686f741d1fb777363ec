{"task_id": "HumanEval/59", "solution": "def largest_prime_factor(n: int):\n    \"\"\"Return the largest prime factor of n. Assume n > 1 and is not a prime.\n    The algorithm efficiently finds factors by trial division up to sqrt(n).\n    \"\"\"\n    max_prime_factor = 1\n\n    # Handle factor 2\n    if n % 2 == 0:\n        max_prime_factor = 2\n        while n % 2 == 0:\n            n //= 2\n\n    # Handle odd factors from 3 up to sqrt(n)\n    i = 3\n    while i * i <= n:\n        if n % i == 0:\n            max_prime_factor = i\n            while n % i == 0:\n                n //= i\n        i += 2\n\n    # If n is still greater than 1, it must be a prime factor itself,\n    # and it must be the largest prime factor remaining.\n    if n > 1:\n        max_prime_factor = n\n\n    return max_prime_factor"}
{"task_id": "HumanEval/60", "solution": "```python\n# pyproject.toml\n# This file is for build configuration and dependencies.\n# The content below is a minimal valid pyproject.toml for a Poetry project.\n\n# --- pyproject.toml start ---\n[tool.poetry]\nname = \"sum-app\"\nversion = \"0.1.0\"\ndescription = \"Library and CLI to compute sum of integers 1 to n with optional persistence.\"\nauthors = [\"Your Name <you@example.com>\"]\nreadme = \"README.md\"\npackages = [{include = \"sum_app\", from = \"src\"}]\n\n[tool.poetry.dependencies]\npython = \"^3.9\"\nfastapi = \"^0.111.0\"\nuvicorn = {extras = [\"standard\"], version = \"^0.30.1\"}\nclick = \"^8.1.7\"\npydantic = \"^2.7.3\" # For FastAPI models\n\n[tool.poetry.group.dev.dependencies]\npytest = \"^8.2.2\"\n\n[build-system]\nrequires = [\"poetry-core\"]\nbuild-backend = \"poetry.core.masonry.api\"\n\n[tool.poetry.scripts]\nsum-to-n = \"sum_app.cli:cli\"\napi-server = \"sum_app.api:main\"\n# --- pyproject.toml end ---\n\n\n# src/sum_app/__init__.py\n# Package initialization file.\n\n# --- src/sum_app/__init__.py start ---\n\"\"\"\nsum_app: A library, CLI, and HTTP API to compute the sum of integers from 1 to n.\n\"\"\"\n\nfrom .services import SumService\nfrom .controllers import SumController\nfrom .validators import InputValidator\nfrom .repository import SQLiteSumRepository, InMemorySumRepository\nfrom .config import Config\n\n# Expose core functionality directly for library users\ndef sum_to_n(n: int) -> int:\n    \"\"\"\n    Computes the sum of integers from 1 to n.\n    This is a convenience wrapper for the core SumService.\n    \"\"\"\n    # Use default dependencies for a simple library call\n    validator = InputValidator()\n    n_validated = validator.validate_n(n)\n    service = SumService(repository=None) # No persistence by default for this simple call\n    return service.sum_to_n(n_validated)\n\n# Define custom exceptions\nclass ValidationError(ValueError):\n    \"\"\"Custom exception for input validation errors.\"\"\"\n    pass\n\nclass RepositoryError(Exception):\n    \"\"\"Custom exception for repository (database) errors.\"\"\"\n    pass\n# --- src/sum_app/__init__.py end ---\n\n\n# src/sum_app/config.py\n# Central configuration values and defaults.\n\n# --- src/sum_app/config.py start ---\nimport os\nfrom typing import Optional\n\nclass Config:\n    \"\"\"\n    Configuration class for the sum application.\n    Defaults can be overridden via environment variables.\n    \"\"\"\n    DB_PATH: str = \"./data/sum_history.db\"\n    PERSIST_DEFAULT: bool = False\n    API_HOST: str = \"127.0.0.1\"\n    API_PORT: int = 8000\n    API_KEY: Optional[str] = None # Optional API key for auth\n\n    @classmethod\n    def from_env(cls) -> \"Config\":\n        \"\"\"\n        Creates a Config instance, reading values from environment variables.\n        Environment variables use SUM_APP_ prefix, e.g., SUM_APP_DB_PATH.\n        \"\"\"\n        config = cls()\n        config.DB_PATH = os.getenv(\"SUM_APP_DB_PATH\", config.DB_PATH)\n        \n        persist_env = os.getenv(\"SUM_APP_PERSIST\")\n        if persist_env is not None:\n            config.PERSIST_DEFAULT = persist_env.lower() in ('true', '1', 'yes')\n        \n        config.API_HOST = os.getenv(\"SUM_APP_API_HOST\", config.API_HOST)\n        \n        api_port_env = os.getenv(\"SUM_APP_API_PORT\")\n        if api_port_env is not None:\n            try:\n                config.API_PORT = int(api_port_env)\n            except ValueError:\n                raise ValueError(f\"Invalid value for SUM_APP_API_PORT: {api_port_env}\")\n        \n        config.API_KEY = os.getenv(\"SUM_APP_API_KEY\", config.API_KEY)\n        return config\n# --- src/sum_app/config.py end ---\n\n\n# src/sum_app/models.py\n# Data Transfer Objects (DTOs) and domain models.\n\n# --- src/sum_app/models.py start ---\nfrom datetime import datetime\nfrom typing import Optional\n\n# Using Pydantic for validation/serialization in API, but keeping simple for core models\nfrom pydantic import BaseModel, Field\n\nclass SumRequest(BaseModel):\n    \"\"\"\n    Represents a request to compute a sum.\n    Used for HTTP API request body.\n    \"\"\"\n    n: int = Field(..., description=\"The upper limit for the sum (n >= 1).\")\n    persist: bool = Field(False, description=\"Whether to persist the computation history.\")\n\nclass SumResult(BaseModel):\n    \"\"\"\n    Represents the result of a sum computation.\n    Includes input, output, timestamp, and optional persistence ID.\n    \"\"\"\n    id: Optional[int] = Field(None, description=\"Unique ID if persisted.\")\n    n: int = Field(..., description=\"The input value for the sum.\")\n    result: int = Field(..., description=\"The computed sum.\")\n    computed_at: datetime = Field(..., description=\"Timestamp of computation in UTC.\")\n# --- src/sum_app/models.py end ---\n\n\n# src/sum_app/validators.py\n# Input validation utilities.\n\n# --- src/sum_app/validators.py start ---\nfrom typing import Any\nfrom . import ValidationError\n\nclass InputValidator:\n    \"\"\"\n    Validates and normalizes input values.\n    Ensures 'n' meets the positive integer requirement.\n    \"\"\"\n    def validate_n(self, n: Any) -> int:\n        \"\"\"\n        Validates if n is a positive integer or can be converted to one.\n        Raises ValidationError if input is invalid.\n        \"\"\"\n        try:\n            val = int(n)\n        except (TypeError, ValueError) as e:\n            raise ValidationError(f\"Input 'n' must be an integer: {n}\") from e\n        \n        self.ensure_positive(val)\n        return val\n\n    def ensure_positive(self, n: int) -> None:\n        \"\"\"\n        Checks if the integer n is positive (>= 1).\n        Raises ValidationError if n < 1.\n        \"\"\"\n        if n < 1:\n            raise ValidationError(f\"Input 'n' must be a positive integer (n >= 1), but got {n}.\")\n# --- src/sum_app/validators.py end ---\n\n\n# src/sum_app/utils.py\n# Utility helpers for timestamps and data formatting.\n\n# --- src/sum_app/utils.py start ---\nfrom datetime import datetime, timezone\nfrom typing import Any, Dict\nfrom .models import SumResult\n\ndef now_utc() -> datetime:\n    \"\"\"\n    Returns the current UTC datetime with timezone information.\n    Useful for consistent timestamping.\n    \"\"\"\n    return datetime.now(timezone.utc)\n\ndef format_result(sum_result: SumResult) -> Dict[str, Any]:\n    \"\"\"\n    Formats a SumResult object into a dictionary suitable for JSON response.\n    Includes ISO 8601 formatting for datetime.\n    \"\"\"\n    return {\n        \"n\": sum_result.n,\n        \"result\": sum_result.result,\n        \"id\": sum_result.id,\n        \"computed_at\": sum_result.computed_at.isoformat()\n    }\n# --- src/sum_app/utils.py end ---\n\n\n# src/sum_app/repository.py\n# Repository interface and SQLite/In-memory implementations.\n\n# --- src/sum_app/repository.py start ---\nimport sqlite3\nimport logging\nfrom abc import ABC, abstractmethod\nfrom datetime import datetime\nfrom typing import Dict, List, Optional\nfrom .models import SumResult\nfrom . import RepositoryError # Custom exception\n\nlogger = logging.getLogger(__name__)\n\nclass ISumRepository(ABC):\n    \"\"\"\n    Abstract base class defining the interface for a sum computation repository.\n    This allows for interchangeable persistence implementations.\n    \"\"\"\n    @abstractmethod\n    def save_computation(self, n: int, result: int, computed_at: datetime) -> int:\n        \"\"\"Saves a computation result and returns its ID.\"\"\"\n        pass\n\n    @abstractmethod\n    def get_computation(self, id: int) -> Optional[SumResult]:\n        \"\"\"Retrieves a computation by its ID.\"\"\"\n        pass\n\n    @abstractmethod\n    def list_recent(self, limit: int = 100) -> List[SumResult]:\n        \"\"\"Lists recent computations.\"\"\"\n        pass\n\nclass SQLiteSumRepository(ISumRepository):\n    \"\"\"\n    SQLite implementation of ISumRepository.\n    Persists computation history to a local SQLite database file.\n    \"\"\"\n    def __init__(self, db_path: str):\n        self._db_path = db_path\n        self.initialize()\n\n    def _connect(self) -> sqlite3.Connection:\n        \"\"\"Establishes a connection to the SQLite database.\"\"\"\n        return sqlite3.connect(self._db_path)\n\n    def initialize(self) -> None:\n        \"\"\"\n        Initializes the database schema by creating the computations table if it doesn't exist.\n        Also creates necessary indexes.\n        \"\"\"\n        try:\n            with self._connect() as conn:\n                cursor = conn.cursor()\n                cursor.execute(\"\"\"\n                    CREATE TABLE IF NOT EXISTS computations (\n                        id INTEGER PRIMARY KEY AUTOINCREMENT,\n                        n INTEGER NOT NULL,\n                        result INTEGER NOT NULL,\n                        computed_at TEXT NOT NULL\n                    )\n                \"\"\")\n                cursor.execute(\"CREATE INDEX IF NOT EXISTS idx_computations_n ON computations(n)\")\n                cursor.execute(\"CREATE INDEX IF NOT EXISTS idx_computations_computed_at ON computations(computed_at)\")\n                conn.commit()\n            logger.info(f\"SQLite database initialized at {self._db_path}\")\n        except sqlite3.Error as e:\n            logger.error(f\"Error initializing SQLite database at {self._db_path}: {e}\")\n            raise RepositoryError(f\"DB initialization failed: {e}\") from e\n\n    def save_computation(self, n: int, result: int, computed_at: datetime) -> int:\n        \"\"\"\n        Saves a computation record to the SQLite database.\n        Returns the ID of the newly inserted record.\n        \"\"\"\n        try:\n            with self._connect() as conn:\n                cursor = conn.cursor()\n                cursor.execute(\n                    \"INSERT INTO computations (n, result, computed_at) VALUES (?, ?, ?)\",\n                    (n, result, computed_at.isoformat())\n                )\n                conn.commit()\n                return cursor.lastrowid\n        except sqlite3.Error as e:\n            logger.error(f\"Error saving computation (n={n}, result={result}) to DB: {e}\")\n            raise RepositoryError(f\"Failed to save computation: {e}\") from e\n\n    def get_computation(self, id: int) -> Optional[SumResult]:\n        \"\"\"\n        Retrieves a computation record by its ID from the SQLite database.\n        Returns SumResult object or None if not found.\n        \"\"\"\n        try:\n            with self._connect() as conn:\n                cursor = conn.cursor()\n                cursor.execute(\"SELECT id, n, result, computed_at FROM computations WHERE id = ?\", (id,))\n                row = cursor.fetchone()\n                if row:\n                    return SumResult(\n                        id=row[0],\n                        n=row[1],\n                        result=row[2],\n                        computed_at=datetime.fromisoformat(row[3])\n                    )\n                return None\n        except sqlite3.Error as e:\n            logger.error(f\"Error retrieving computation with id={id} from DB: {e}\")\n            raise RepositoryError(f\"Failed to retrieve computation: {e}\") from e\n\n    def list_recent(self, limit: int = 100) -> List[SumResult]:\n        \"\"\"\n        Lists recent computation records from the SQLite database, ordered by computed_at descending.\n        \"\"\"\n        try:\n            with self._connect() as conn:\n                cursor = conn.cursor()\n                cursor.execute(\n                    \"SELECT id, n, result, computed_at FROM computations ORDER BY computed_at DESC LIMIT ?\",\n                    (limit,)\n                )\n                rows = cursor.fetchall()\n                return [\n                    SumResult(\n                        id=row[0],\n                        n=row[1],\n                        result=row[2],\n                        computed_at=datetime.fromisoformat(row[3])\n                    ) for row in rows\n                ]\n        except sqlite3.Error as e:\n            logger.error(f\"Error listing recent computations from DB: {e}\")\n            raise RepositoryError(f\"Failed to list computations: {e}\") from e\n\nclass InMemorySumRepository(ISumRepository):\n    \"\"\"\n    An in-memory implementation of ISumRepository, primarily for testing purposes.\n    Data is not persisted beyond the object's lifecycle.\n    \"\"\"\n    def __init__(self):\n        self._store: Dict[int, SumResult] = {}\n        self._next_id = 1\n\n    def save_computation(self, n: int, result: int, computed_at: datetime) -> int:\n        \"\"\"\n        Saves a computation to the in-memory store.\n        Assigns and returns a unique ID.\n        \"\"\"\n        new_id = self._next_id\n        self._next_id += 1\n        self._store[new_id] = SumResult(id=new_id, n=n, result=result, computed_at=computed_at)\n        return new_id\n\n    def get_computation(self, id: int) -> Optional[SumResult]:\n        \"\"\"Retrieves a computation from the in-memory store by ID.\"\"\"\n        return self._store.get(id)\n\n    def list_recent(self, limit: int = 100) -> List[SumResult]:\n        \"\"\"Lists recent computations from the in-memory store, ordered by ID descending.\"\"\"\n        # Sort by ID to simulate 'recent' for in-memory, as computed_at might not be distinct enough\n        sorted_results = sorted(self._store.values(), key=lambda x: x.id, reverse=True)\n        return sorted_results[:limit]\n# --- src/sum_app/repository.py end ---\n\n\n# src/sum_app/services.py\n# Core computation logic and orchestration with the repository.\n\n# --- src/sum_app/services.py start ---\nimport logging\nfrom datetime import datetime\nfrom typing import Optional\nfrom .models import SumResult\nfrom .repository import ISumRepository\nfrom .utils import now_utc\n\nlogger = logging.getLogger(__name__)\n\nclass SumService:\n    \"\"\"\n    Provides the core business logic for computing sums and managing persistence.\n    It depends on an ISumRepository for data storage.\n    \"\"\"\n    def __init__(self, repository: Optional[ISumRepository] = None):\n        \"\"\"Initializes the SumService with an optional repository.\"\"\"\n        self._repository = repository\n\n    def sum_to_n(self, n: int) -> int:\n        \"\"\"\n        Computes the sum of integers from 1 to n using an O(1) arithmetic formula.\n        Assumes n is a valid positive integer; validation is handled by InputValidator.\n        \"\"\"\n        # Formula: n * (n + 1) / 2\n        # Use integer division // to ensure integer result for Python big ints\n        return n * (n + 1) // 2\n\n    def compute_and_persist(self, n: int, persist: bool = False) -> SumResult:\n        \"\"\"\n        Computes the sum for 'n', creates a SumResult object, and optionally\n        persists it via the injected repository.\n        \"\"\"\n        result = self.sum_to_n(n)\n        computed_at = now_utc()\n        \n        sum_result = SumResult(n=n, result=result, computed_at=computed_at)\n        \n        if persist and self._repository:\n            try:\n                # Attempt to save, but don't prevent returning the result if persistence fails\n                sum_result.id = self._repository.save_computation(n, result, computed_at)\n                logger.info(f\"Computation for n={n} persisted with ID={sum_result.id}\")\n            except Exception as e:\n                logger.error(f\"Failed to persist computation for n={n}: {e}\", exc_info=True)\n                # Ensure id is None if persistence failed\n                sum_result.id = None \n        \n        return sum_result\n# --- src/sum_app/services.py end ---\n\n\n# src/sum_app/controllers.py\n# Application controllers, orchestrating validation, service invocation, and response.\n\n# --- src/sum_app/controllers.py start ---\nfrom typing import Any\nfrom .services import SumService\nfrom .validators import InputValidator\nfrom .models import SumResult\n\nclass SumController:\n    \"\"\"\n    Orchestrates input validation, calls the core service for computation,\n    and handles optional persistence. It's the main entry point for requests.\n    \"\"\"\n    def __init__(self, service: SumService, validator: InputValidator):\n        \"\"\"Initializes the controller with a SumService and an InputValidator.\"\"\"\n        self._service = service\n        self._validator = validator\n\n    def compute(self, n_raw: Any, persist: bool = False) -> SumResult:\n        \"\"\"\n        Validates the input 'n', computes the sum, and optionally persists the result.\n        Returns a SumResult object. Raises ValidationError for invalid input.\n        \"\"\"\n        n = self._validator.validate_n(n_raw)\n        return self._service.compute_and_persist(n, persist)\n\n    def get_history(self, limit: int = 100) -> list[SumResult]:\n        \"\"\"\n        Retrieves a list of recent computation history records.\n        Returns an empty list if no repository is configured or if an error occurs.\n        \"\"\"\n        if self._service._repository: # Accessing protected member for simplicity in a small app\n            return self._service._repository.list_recent(limit)\n        return []\n# --- src/sum_app/controllers.py end ---\n\n\n# src/sum_app/cli.py\n# Command Line Interface (CLI) entrypoint using Click.\n\n# --- src/sum_app/cli.py start ---\nimport sys\nimport logging\nimport click\nfrom .config import Config\nfrom .validators import InputValidator\nfrom .repository import SQLiteSumRepository\nfrom .services import SumService\nfrom .controllers import SumController\nfrom . import ValidationError, RepositoryError # Custom exceptions\n\n# Configure basic logging for CLI\nlogging.basicConfig(level=logging.INFO, format='%(asctime)s - %(levelname)s - %(message)s')\n\n@click.group()\n@click.version_option()\ndef cli():\n    \"\"\"\n    sum-to-n: A CLI tool to compute the sum of integers from 1 to N.\n    Provides commands to compute and view history.\n    \"\"\"\n    pass\n\n@cli.command()\n@click.argument(\"n\", type=str) # Accept as string to allow custom validation\n@click.option(\"--persist/--no-persist\", default=None, help=\"Enable or disable persistence. Overrides default config.\")\ndef compute(n: str, persist: bool | None):\n    \"\"\"\n    Computes the sum of integers from 1 to N.\n    Optionally persists the result to a database.\n    \"\"\"\n    config = Config.from_env()\n\n    # Determine persistence setting\n    actual_persist = config.PERSIST_DEFAULT if persist is None else persist\n\n    repo = None\n    if actual_persist:\n        try:\n            repo = SQLiteSumRepository(config.DB_PATH)\n        except RepositoryError as e:\n            click.echo(f\"Error initializing database for persistence: {e}\", err=True)\n            click.echo(\"Proceeding without persistence.\", err=True)\n            actual_persist = False # Disable persistence if DB init fails\n\n    service = SumService(repository=repo)\n    controller = SumController(service, InputValidator())\n\n    try:\n        sr = controller.compute(n, actual_persist)\n        click.echo(f\"Sum 1..{sr.n} = {sr.result}\")\n        if sr.id is not None:\n            click.echo(f\"Result persisted with ID: {sr.id}\")\n        sys.exit(0)\n    except ValidationError as e:\n        click.echo(f\"Error: {e}\", err=True)\n        sys.exit(1)\n    except Exception as e:\n        logging.error(f\"An unexpected error occurred during computation: {e}\", exc_info=True)\n        click.echo(f\"An unexpected error occurred: {e}\", err=True)\n        sys.exit(2)\n\n@cli.command()\n@click.option(\"--limit\", default=10, type=int, help=\"Number of recent computations to list.\")\ndef history(limit: int):\n    \"\"\"\n    Lists recent computation history.\n    Requires persistence to be configured.\n    \"\"\"\n    config = Config.from_env()\n    \n    repo = None\n    try:\n        repo = SQLiteSumRepository(config.DB_PATH)\n    except RepositoryError as e:\n        click.echo(f\"Error initializing database: {e}\", err=True)\n        click.echo(\"Cannot retrieve history without a functional database.\", err=True)\n        sys.exit(1)\n\n    service = SumService(repository=repo)\n    controller = SumController(service, InputValidator()) # Validator not strictly needed for history, but part of controller setup\n    \n    try:\n        records = controller.get_history(limit)\n        if not records:\n            click.echo(\"No computation history found.\")\n            sys.exit(0)\n        \n        click.echo(f\"Recent {len(records)} computations:\")\n        for record in records:\n            click.echo(f\"  ID: {record.id}, N: {record.n}, Result: {record.result}, Computed At: {record.computed_at.isoformat()}\")\n        sys.exit(0)\n    except Exception as e:\n        logging.error(f\"An unexpected error occurred while fetching history: {e}\", exc_info=True)\n        click.echo(f\"An unexpected error occurred: {e}\", err=True)\n        sys.exit(2)\n\n\n# Main entry point for the CLI, to be used by pyproject.toml\ndef main():\n    cli()\n\nif __name__ == \"__main__\":\n    main()\n# --- src/sum_app/cli.py end ---\n\n\n# src/sum_app/api.py\n# FastAPI application and endpoints for the HTTP API.\n\n# --- src/sum_app/api.py start ---\nimport logging\nfrom typing import Dict, Any, Optional\nfrom fastapi import FastAPI, HTTPException, Request, Depends, status\nfrom fastapi.security import APIKeyHeader\nimport uvicorn\nfrom .config import Config\nfrom .validators import InputValidator\nfrom .repository import SQLiteSumRepository\nfrom .services import SumService\nfrom .controllers import SumController\nfrom .models import SumRequest, SumResult\nfrom .utils import format_result\nfrom . import ValidationError, RepositoryError # Custom exceptions\n\n# Configure basic logging for API\nlogging.basicConfig(level=logging.INFO, format='%(asctime)s - %(levelname)s - %(message)s')\nlogger = logging.getLogger(__name__)\n\n# Global instances (or use FastAPI's dependency injection for proper lifecycle management)\n_config = Config.from_env()\n_repository: Optional[SQLiteSumRepository] = None\nif _config.PERSIST_DEFAULT or os.getenv(\"SUM_APP_API_PERSIST\", \"false\").lower() in ('true', '1', 'yes'):\n    try:\n        _repository = SQLiteSumRepository(_config.DB_PATH)\n        logger.info(f\"API persistence enabled. DB Path: {_config.DB_PATH}\")\n    except RepositoryError as e:\n        logger.error(f\"Failed to initialize SQLite repository for API: {e}. Persistence will be disabled.\", exc_info=True)\n        _repository = None\n_service = SumService(repository=_repository)\n_controller = SumController(service=_service, validator=InputValidator())\n\n# API Key security setup\napi_key_header = APIKeyHeader(name=\"X-API-KEY\", auto_error=False)\n\nasync def get_api_key(api_key: str = Depends(api_key_header)):\n    \"\"\"Dependency to validate API key if configured.\"\"\"\n    if _config.API_KEY:\n        if api_key is None or api_key != _config.API_KEY:\n            raise HTTPException(\n                status_code=status.HTTP_401_UNAUTHORIZED,\n                detail=\"Invalid or missing API Key\"\n            )\n    return api_key # Return key even if not configured to allow flow\n\ndef create_api(controller: SumController) -> FastAPI:\n    \"\"\"\n    Creates and configures a FastAPI application instance.\n    Sets up endpoints and error handling.\n    \"\"\"\n    app = FastAPI(\n        title=\"Sum to N API\",\n        description=\"HTTP API for computing the sum of integers from 1 to N.\",\n        version=\"0.1.0\"\n    )\n\n    @app.post(\"/sum\", response_model=SumResult, status_code=status.HTTP_200_OK)\n    async def post_sum(\n        request_data: SumRequest,\n        # Only apply auth if API_KEY is configured\n        api_key: Optional[str] = Depends(get_api_key) \n    ) -> Dict[str, Any]:\n        \"\"\"\n        Computes the sum of integers from 1 to N and returns the result.\n        Optionally persists the computation history.\n        \"\"\"\n        try:\n            # Determine persistence: request_data.persist overrides config.PERSIST_DEFAULT\n            # If request_data.persist is true, persistence is explicitly requested.\n            # If request_data.persist is false or not provided, it defaults to config.PERSIST_DEFAULT\n            actual_persist = request_data.persist if request_data.persist is not None else _config.PERSIST_DEFAULT\n            \n            # Ensure persistence is actually possible if requested\n            if actual_persist and _controller._service._repository is None:\n                logger.warning(\"Persistence requested but repository is not available. Result will not be saved.\")\n                actual_persist = False\n\n            sum_result = controller.compute(request_data.n, actual_persist)\n            return format_result(sum_result)\n        except ValidationError as e:\n            raise HTTPException(status_code=status.HTTP_400_BAD_REQUEST, detail=str(e))\n        except Exception as e:\n            logger.exception(f\"Unhandled error during /sum for n={request_data.n}\")\n            raise HTTPException(status_code=status.HTTP_500_INTERNAL_SERVER_ERROR, detail=\"Internal server error\")\n\n    @app.get(\"/history\", response_model=List[SumResult], status_code=status.HTTP_200_OK)\n    async def get_history(\n        limit: int = 100,\n        api_key: Optional[str] = Depends(get_api_key) # Apply auth\n    ) -> List[Dict[str, Any]]:\n        \"\"\"\n        Retrieves a list of recent computation history.\n        Requires persistence to be enabled.\n        \"\"\"\n        if controller._service._repository is None:\n            raise HTTPException(status_code=status.HTTP_400_BAD_REQUEST, detail=\"Persistence not enabled for history lookup.\")\n        \n        try:\n            records = controller.get_history(limit)\n            return [format_result(rec) for rec in records]\n        except RepositoryError as e:\n            logger.error(f\"Error fetching history: {e}\", exc_info=True)\n            raise HTTPException(status_code=status.HTTP_500_INTERNAL_SERVER_ERROR, detail=\"Could not retrieve history from database.\")\n        except Exception as e:\n            logger.exception(\"Unhandled error during /history\")\n            raise HTTPException(status_code=status.HTTP_500_INTERNAL_SERVER_ERROR, detail=\"Internal server error.\")\n\n    return app\n\n# Create the FastAPI app instance using the global controller\napp = create_api(_controller)\n\ndef main():\n    \"\"\"Entry point for running the API server using Uvicorn.\"\"\"\n    logger.info(f\"Starting API server on http://{_config.API_HOST}:{_config.API_PORT}\")\n    if _config.API_KEY:\n        logger.info(\"API Key authentication is ENABLED.\")\n    else:\n        logger.warning(\"API Key authentication is DISABLED. API is publicly accessible.\")\n    \n    uvicorn.run(app, host=_config.API_HOST, port=_config.API_PORT)\n\nif __name__ == \"__main__\":\n    main()\n# --- src/sum_app/api.py end ---\n\n\n# README.md\n# Basic README for project setup and usage.\n\n# --- README.md start ---\n# Sum App\n\nA Python library, Command Line Interface (CLI), and HTTP API to compute the sum of integers from 1 to N, with optional persistence of computation history.\n\n## Features\n\n- **Library**: `sum_app.sum_to_n(n)` function for programmatic use.\n- **CLI**: `sum-to-n compute <n>` for command-line calculations and `sum-to-n history` to view past computations.\n- **HTTP API**: `POST /sum` endpoint to compute, `GET /history` to retrieve history.\n- **Persistence**: Stores computation history in an SQLite database.\n- **Error Handling**: Robust input validation and graceful error management.\n\n## Installation\n\nThis project uses `poetry` for dependency management.\n\n1.  **Clone the repository:**\n    ```bash\n    git clone https://github.com/your-username/sum-app.git\n    cd sum-app\n    ```\n2.  **Install dependencies:**\n    ```bash\n    poetry install\n    ```\n    This will set up a virtual environment and install `fastapi`, `uvicorn`, `click`, and `pydantic`.\n\n## Usage\n\n### Library\n\nYou can import `sum_to_n` directly into your Python projects:\n\n```python\nfrom sum_app import sum_to_n\n\nresult = sum_to_n(100)\nprint(f\"Sum 1..100 = {result}\") # Output: Sum 1..100 = 5050\n```\n\nFor more advanced usage (e.g., with persistence), you can directly interact with the `SumController` and `SumService`.\n\n### Command Line Interface (CLI)\n\nThe CLI tool `sum-to-n` is available after installation.\n\n-   **Compute a sum:**\n    ```bash\n    poetry run sum-to-n compute 10\n    # Output: Sum 1..10 = 55\n    ```\n\n-   **Compute and persist the result:**\n    ```bash\n    poetry run sum-to-n compute 20 --persist\n    # Output: Sum 1..20 = 210\n    #         Result persisted with ID: 1 (or similar ID)\n    ```\n\n-   **View computation history:**\n    ```bash\n    poetry run sum-to-n history --limit 5\n    # Output: Recent 2 computations:\n    #           ID: 1, N: 20, Result: 210, Computed At: 2023-10-27T10:00:00.000000+00:00\n    #           ID: 2, N: 15, Result: 120, Computed At: 2023-10-27T10:05:00.000000+00:00\n    ```\n    (Note: history requires `--persist` to have been used previously, or persistence to be enabled by default via `SUM_APP_PERSIST=true` environment variable).\n\n### HTTP API\n\nThe API server can be started using Uvicorn.\n\n```bash\npoetry run api-server\n# Output: INFO:     Uvicorn running on http://127.0.0.1:8000 (Press CTRL+C to quit)\n```\n\nOnce running, you can access the API at `http://127.0.0.1:8000`.\n\n-   **Compute a sum (POST /sum):**\n    ```bash\n    curl -X POST \"http://127.0.0.1:8000/sum\" \\\n         -H \"Content-Type: application/json\" \\\n         -d '{\"n\": 5}'\n    # Expected JSON Output: {\"n\":5,\"result\":15,\"id\":null,\"computed_at\":\"...\"}\n    ```\n\n-   **Compute and persist (POST /sum with persist flag):**\n    ```bash\n    curl -X POST \"http://127.0.0.1:8000/sum\" \\\n         -H \"Content-Type: application/json\" \\\n         -d '{\"n\": 10, \"persist\": true}'\n    # Expected JSON Output: {\"n\":10,\"result\":55,\"id\":1,\"computed_at\":\"...\"}\n    ```\n\n-   **Retrieve history (GET /history):**\n    ```bash\n    curl \"http://127.0.0.1:8000/history?limit=2\"\n    # Expected JSON Output: [{\"n\":10,\"result\":55,\"id\":1,\"computed_at\":\"...\"}, ...]\n    ```\n\n## Configuration\n\nConfiguration can be managed via environment variables:\n\n-   `SUM_APP_DB_PATH`: Path to the SQLite database file (default: `./data/sum_history.db`).\n-   `SUM_APP_PERSIST`: Set to `true` or `1` to enable persistence by default (default: `false`).\n-   `SUM_APP_API_HOST`: Host for the API server (default: `127.0.0.1`).\n-   `SUM_APP_API_PORT`: Port for the API server (default: `8000`).\n-   `SUM_APP_API_KEY`: If set, enables basic API Key authentication for the HTTP API.\n\nExample with environment variables:\n```bash\nSUM_APP_DB_PATH=./my_custom_history.db SUM_APP_PERSIST=true poetry run sum-to-n compute 100\n```\n\n## Project Structure\n\n```\n.\n\u251c\u2500\u2500 pyproject.toml\n\u251c\u2500\u2500 README.md\n\u251c\u2500\u2500 src/\n\u2502   \u2514\u2500\u2500 sum_app/\n\u2502       \u251c\u2500\u2500 __init__.py\n\u2502       \u251c\u2500\u2500 config.py\n\u2502       \u251c\u2500\u2500 models.py\n\u2502       \u251c\u2500\u2500 validators.py\n\u2502       \u251c\u2500\u2500 services.py\n\u2502       \u251c\u2500\u2500 repository.py\n\u2502       \u251c\u2500\u2500 controllers.py\n\u2502       \u251c\u2500\u2500 cli.py\n\u2502       \u251c\u2500\u2500 api.py\n\u2502       \u2514\u2500\u2500 utils.py\n\u2514\u2500\u2500 tests/\n    \u251c\u2500\u2500 __init__.py\n    \u251c\