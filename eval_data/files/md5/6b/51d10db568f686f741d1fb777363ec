{"task_id": "HumanEval/15", "solution": "def string_sequence(n: int) -> str:\n    \"\"\" Return a string containing space-delimited numbers starting from 0 upto n inclusive.\n    >>> string_sequence(0)\n    '0'\n    >>> string_sequence(5)\n    '0 1 2 3 4 5'\n    \"\"\"\n    return \" \".join(map(str, range(n + 1)))"}
{"task_id": "HumanEval/16", "solution": "import unicodedata\n\ndef count_distinct_characters(string: str) -> int:\n    \"\"\" Given a string, find out how many distinct characters (regardless of case) does it consist of.\n    It normalizes the string, applies casefolding, and counts the unique characters.\n    \"\"\"\n    normalized_text = unicodedata.normalize(\"NFC\", string).casefold().strip()\n    return len(set(normalized_text))"}
{"task_id": "HumanEval/17", "solution": "```python\n# pyproject.toml\n#\n# Project metadata, dependencies, and entry points.\n# Following poetry-style metadata as suggested.\n[project]\nname = \"asciimusic\"\nversion = \"0.1.0\"\ndescription = \"A small Python library for parsing ASCII musical note strings.\"\nauthors = [\"Your Name <you@example.com>\"]\nreadme = \"README.md\"\nrequires-python = \">=3.8\"\nlicense = { text = \"MIT\" }\nkeywords = [\"music\", \"ascii\", \"parser\", \"beats\"]\nclassifiers = [\n    \"Development Status :: 3 - Alpha\",\n    \"Intended Audience :: Developers\",\n    \"License :: OSI Approved :: MIT License\",\n    \"Programming Language :: Python :: 3\",\n    \"Programming Language :: Python :: 3.8\",\n    \"Programming Language :: Python :: 3.9\",\n    \"Programming Language :: Python :: 3.10\",\n    \"Programming Language :: Python :: 3.11\",\n    \"Programming Language :: Python :: 3.12\",\n]\n\n[project.scripts]\nasciimusic = \"asciimusic.cli:main\"\n\n[build-system]\nrequires = [\"setuptools>=61.0\"]\nbuild-backend = \"setuptools.build_meta\"\n\n\n# src/asciimusic/__init__.py\n\"\"\"Package exports: parse_music function.\"\"\"\n\nfrom .controllers import parse_music\n\n__all__ = [\"parse_music\"]\n\n\n# src/asciimusic/models.py\n\"\"\"Domain model for notes, including NoteType enum and Note dataclass.\"\"\"\n\nfrom dataclasses import dataclass\nfrom enum import Enum\n\n\nclass NoteType(Enum):\n    \"\"\"Represents the type of a musical note and its associated token.\"\"\"\n    WHOLE = \"o\"\n    HALF = \"o|\"\n    QUARTER = \".|\"\n\n    def duration(self) -> int:\n        \"\"\"Returns the beat duration for this NoteType.\"\"\"\n        return DEFAULT_DURATIONS[self]\n\n\n@dataclass\nclass Note:\n    \"\"\"Represents a parsed musical note with its token, type, and duration.\"\"\"\n    token: str\n    type: NoteType\n    duration: int\n\n    def __post_init__(self) -> None:\n        \"\"\"Ensures duration matches type's default duration or validates if provided.\"\"\"\n        if self.duration != self.type.duration():\n            raise ValueError(f\"Note duration {self.duration} does not match \"\n                             f\"NoteType {self.type.name} duration {self.type.duration()}\")\n\n\n# Default durations for each NoteType.\nDEFAULT_DURATIONS = {\n    NoteType.WHOLE: 4,\n    NoteType.HALF: 2,\n    NoteType.QUARTER: 1,\n}\n\n\n# src/asciimusic/exceptions.py\n\"\"\"Custom error types for parsing operations.\"\"\"\n\nclass ParseError(ValueError):\n    \"\"\"Exception raised for errors during music string parsing.\"\"\"\n    def __init__(self, token: str, position: int, message: str = None) -> None:\n        self.token = token\n        self.position = position\n        self.message = message or \"Unknown token encountered.\"\n        super().__init__(self.__str__())\n\n    def __str__(self) -> str:\n        \"\"\"Returns a user-friendly string representation of the error.\"\"\"\n        return f\"Parse error at token '{self.token}' (position {self.position}): {self.message}\"\n\n\n# src/asciimusic/factory.py\n\"\"\"NoteFactory maps tokens to Note objects, providing extensibility.\"\"\"\n\nfrom typing import Dict\n\nfrom .models import Note, NoteType, DEFAULT_DURATIONS\nfrom .exceptions import ParseError\n\n\nclass NoteFactory:\n    \"\"\"Factory for creating Note objects from string tokens.\"\"\"\n\n    # Default mapping of string tokens to NoteType enums.\n    DEFAULT_TOKEN_MAP: Dict[str, NoteType] = {\n        NoteType.WHOLE.value: NoteType.WHOLE,\n        NoteType.HALF.value: NoteType.HALF,\n        NoteType.QUARTER.value: NoteType.QUARTER,\n    }\n\n    def __init__(self, token_map: Dict[str, NoteType] = None) -> None:\n        \"\"\"Initializes the factory with a token map.\"\"\"\n        self.token_map = token_map if token_map is not None else self.DEFAULT_TOKEN_MAP.copy()\n\n    def create(self, token: str, position: int = -1) -> Note:\n        \"\"\"Creates a Note object from a given token.\"\"\"\n        note_type = self.token_map.get(token)\n        if note_type is None:\n            raise ParseError(token=token, position=position, message=\"Unknown musical token.\")\n        return Note(token=token, type=note_type, duration=note_type.duration())\n\n    def register(self, token: str, note_type: NoteType) -> None:\n        \"\"\"Registers a new token or overrides an existing mapping.\"\"\"\n        self.token_map[token] = note_type\n\n\n# src/asciimusic/utils.py\n\"\"\"Helper functions for tokenization and token normalization.\"\"\"\n\nfrom typing import List\n\nfrom .factory import NoteFactory\n\n\ndef tokenize(music_string: str) -> List[str]:\n    \"\"\"Splits a music string into a list of individual tokens.\"\"\"\n    return [token for token in music_string.split() if token]\n\n\ndef normalize_token(token: str) -> str:\n    \"\"\"Provides a place for future token normalization logic.\"\"\"\n    return token\n\n\ndef is_valid_token(token: str, factory: NoteFactory) -> bool:\n    \"\"\"Checks if a token is known by the NoteFactory.\"\"\"\n    return token in factory.token_map\n\n\n# src/asciimusic/parser.py\n\"\"\"Core parser logic for converting music strings into beat durations.\"\"\"\n\nfrom typing import List\n\nfrom .factory import NoteFactory\nfrom .utils import tokenize\nfrom .exceptions import ParseError\n\n\nclass MusicParser:\n    \"\"\"Parses a musical notation string into a list of beat durations.\"\"\"\n\n    def __init__(self, factory: NoteFactory = None) -> None:\n        \"\"\"Initializes the parser with an optional NoteFactory.\"\"\"\n        self._factory = factory if factory is not None else NoteFactory()\n\n    def parse(self, music_string: str) -> List[int]:\n        \"\"\"Parses the input music string into a list of integer beat durations.\"\"\"\n        tokens = tokenize(music_string)\n        beats: List[int] = []\n        for i, token_str in enumerate(tokens):\n            try:\n                note = self._factory.create(token_str, position=i + 1)\n                beats.append(note.duration)\n            except ParseError as e:\n                # Re-raise ParseError, adding context if needed (already handled by factory)\n                raise e\n        return beats\n\n\n# src/asciimusic/controllers.py\n\"\"\"Public API wrapper for library consumers.\"\"\"\n\nfrom typing import List\n\nfrom .parser import MusicParser\nfrom .factory import NoteFactory\n\n\ndef parse_music(music_string: str) -> List[int]:\n    \"\"\"Parses a simple ASCII musical-note string into a list of beat durations.\n\n    This function serves as the primary public API for the asciimusic library.\n    \"\"\"\n    parser = MusicParser(factory=NoteFactory())\n    return parser.parse(music_string)\n\n\n# src/asciimusic/cli.py\n\"\"\"Command-line interface for the asciimusic library.\"\"\"\n\nimport argparse\nimport json\nimport sys\nfrom typing import List\n\nfrom .controllers import parse_music\nfrom .exceptions import ParseError\n\n\ndef _build_parser() -> argparse.ArgumentParser:\n    \"\"\"Builds and returns the argument parser for the CLI.\"\"\"\n    parser = argparse.ArgumentParser(\n        prog=\"asciimusic\",\n        description=\"Parse simple ASCII musical note strings into beat durations.\"\n    )\n    subparsers = parser.add_subparsers(dest=\"command\", help=\"Available commands\")\n\n    parse_parser = subparsers.add_parser(\n        \"parse\",\n        help=\"Parses a music string and prints beat durations as JSON.\"\n    )\n    parse_parser.add_argument(\n        \"music_string\",\n        type=str,\n        help=\"The ASCII music string to parse (e.g., 'o o| .| o').\"\n    )\n    return parser\n\n\ndef main(argv: List[str] = None) -> int:\n    \"\"\"Main entry point for the command-line interface.\"\"\"\n    if argv is None:\n        argv = sys.argv[1:]\n\n    parser = _build_parser()\n    args = parser.parse_args(argv)\n\n    if args.command == \"parse\":\n        try:\n            result = parse_music(args.music_string)\n            print(json.dumps(result))\n            return 0\n        except ParseError as e:\n            print(f\"Error: {e}\", file=sys.stderr)\n            return 2\n        except Exception as e:\n            print(f\"An unexpected error occurred: {e}\", file=sys.stderr)\n            return 1\n    else:\n        parser.print_help(sys.stderr)\n        return 1\n\n```"}
{"task_id": "HumanEval/17", "solution": "from typing import List\n\n\ndef parse_music(music_string: str) -> List[int]:\n    \"\"\" Input to this function is a string representing musical notes in a special ASCII format.\n    Your task is to parse this string and return list of integers corresponding to how many beats does each\n    not last.\n\n    Here is a legend:\n    'o' - whole note, lasts four beats\n    'o|' - half note, lasts two beats\n    '.|' - quater note, lasts one beat\n\n    >>> parse_music('o o| .| o| o| .| .| .| .| o o')\n    [4, 2, 1, 2, 2, 1, 1, 1, 1, 4, 4]\n    \"\"\"\n    # Define the mapping from music tokens to their beat values.\n    token_beat_map = {\n        'o': 4,\n        'o|': 2,\n        '.|': 1\n    }\n    \n    # Split the input string into individual tokens using whitespace as a delimiter.\n    tokens = music_string.split()\n    \n    # Create a list of beat counts by looking up each token's value in the map.\n    beats = [token_beat_map[token] for token in tokens]\n    \n    return beats"}
{"task_id": "HumanEval/18", "solution": "```python\ndef how_many_times(string: str, substring: str) -> int:\n    \"\"\" Find how many times a given substring can be found in the original string. Count overlaping cases.\n    >>> how_many_times('', 'a')\n    0\n    >>> how_many_times('aaa', 'a')\n    3\n    >>> how_many_times('aaaa', 'aa')\n    3\n    \"\"\"\n\n    # Helper function for KMP to build the Longest Proper Prefix which is also Suffix array (LPS).\n    # This array helps the KMP algorithm to efficiently skip characters during pattern matching.\n    def _build_lps(pattern: str) -> list[int]:\n        m = len(pattern)\n        lps = [0] * m\n        length = 0  # Length of the previous longest prefix suffix\n        i = 1\n        while i < m:\n            if pattern[i] == pattern[length]:\n                length += 1\n                lps[i] = length\n                i += 1\n            else:\n                if length != 0:\n                    length = lps[length - 1]\n                else:\n                    lps[i] = 0\n                    i += 1\n        return lps\n\n    n = len(string)\n    m = len(substring)\n\n    # According to design, substring must be non-empty. Trusting caller's inputs,\n    # assume m >= 1. Handle cases where substring is longer than string.\n    if m > n:\n        return 0\n\n    lps = _build_lps(substring)\n\n    count = 0\n    i = 0  # Pointer for string\n    j = 0  # Pointer for substring\n\n    while i < n:\n        if substring[j] == string[i]:\n            i += 1\n            j += 1\n\n        if j == m:  # A match is found\n            count += 1\n            # Move back in pattern using LPS array to find overlapping matches.\n            j = lps[j - 1]\n        elif i < n and substring[j] != string[i]:\n            # Mismatch after j matches, use LPS array to shift pattern.\n            if j != 0:\n                j = lps[j - 1]\n            else:\n                i += 1  # No previous match, move to next character in string.\n    return count\n```"}
{"task_id": "HumanEval/18", "solution": "```python\n# pyproject.toml\n[tool.poetry]\nname = \"substring-counter\"\nversion = \"0.1.0\"\ndescription = \"A reliable library, CLI, and HTTP API to count substring occurrences.\"\nauthors = [\"Your Name <you@example.com>\"]\nlicense = \"MIT\"\nreadme = \"README.md\"\npackages = [{include = \"substring_counter\", from = \"src\"}]\n\n[tool.poetry.dependencies]\npython = \">=3.8.1,<4.0\"\nfastapi = {version = \"^0.111.0\", optional = true}\nuvicorn = {version = \"^0.30.1\", optional = true}\npydantic = \"^2.7.4\"\npydantic-settings = \"^2.3.3\"\n\n[tool.poetry.group.dev.dependencies]\npytest = \"^8.2.2\"\nblack = \"^24.4.2\"\nflake8 = \"^7.1.0\"\nisort = \"^5.13.2\"\n\n[tool.poetry.extras]\nhttp = [\"fastapi\", \"uvicorn\"]\n\n[tool.poetry.scripts]\nsubstring-counter = \"substring_counter.cli:main\"\n\n[build-system]\nrequires = [\"poetry-core\"]\nbuild-backend = \"poetry.core.masonry.api\"\n```\n\n```python\n# requirements.txt\nfastapi~=0.111.0\nuvicorn~=0.30.1\npydantic~=2.7.4\npydantic-settings~=2.3.3\n```\n\n```python\n# README.md\n# Substring Counter\n\nThis project provides a robust library, command-line interface (CLI), and an optional HTTP API to count how many times a substring appears in a given string, including overlapping occurrences. It also persists all queries for auditing and debugging purposes using a local SQLite database.\n\n## Features\n\n- **Library Function**: `how_many_times(string, substring)` for direct integration.\n- **CLI Tool**: `substring-counter` to get counts from command-line arguments or stdin.\n- **HTTP API**: A `POST /count` endpoint for easy integration with other systems.\n- **Persistence**: All queries (inputs and results) are stored in an SQLite database.\n- **Automated Tests**: Comprehensive unit and integration tests.\n\n## Installation\n\n1. **Clone the repository**:\n   ```bash\n   git clone https://github.com/your-org/substring-counter.git\n   cd substring-counter\n   ```\n\n2. **Install dependencies using Poetry**:\n   ```bash\n   poetry install\n   ```\n   To include HTTP server dependencies:\n   ```bash\n   poetry install --extras http\n   ```\n\n## Usage\n\n### 1. Library\n\nYou can import and use the `CounterService` directly in your Python applications.\n\n```python\nfrom substring_counter.repository import StringRepository\nfrom substring_counter.service import CounterService\nfrom substring_counter.config import DB_PATH\n\n# Initialize repository and service\nrepo = StringRepository(DB_PATH)\nrepo.initialize() # Ensure DB table is created\nservice = CounterService(repo)\n\n# Get a simple count (without persistence)\ncount = service.count(\"banana\", \"ana\")\nprint(f\"Count (non-persisted): {count}\") # Output: 2\n\n# Get a count and persist the query\nresult = service.validate_and_count(\"aaaaa\", \"aa\", persist=True)\nprint(f\"Count (persisted, ID: {result.id}): {result.count}\") # Output: 4\n```\n\n### 2. Command Line Interface (CLI)\n\nThe CLI tool allows you to run queries directly from your terminal.\n\n**Using arguments:**\n\n```bash\npoetry run substring-counter --string \"aaaa\" --substring \"aa\"\n# Output: Count: 3, Record ID: 1\n```\n\n**Using stdin (for the main string):**\n\n```bash\necho \"ababa\" | poetry run substring-counter --substring \"aba\" --stdin\n# Output: Count: 2, Record ID: 2\n```\n\n**Disable persistence:**\n\n```bash\npoetry run substring-counter --string \"testtest\" --substring \"test\" --no-persist\n# Output: Count: 2\n```\n\n### 3. HTTP API\n\nTo run the HTTP server, you need to install it with the `http` extra: `poetry install --extras http`.\n\nThen, start the server using Uvicorn:\n\n```bash\npoetry run uvicorn substring_counter.controllers_http:create_app --factory --host 127.0.0.1 --port 8000\n```\n\nOnce the server is running, you can send POST requests to `/count`.\n\n**Example using `curl`:**\n\n```bash\ncurl -X POST http://127.0.0.1:8000/count \\\n     -H \"Content-Type: application/json\" \\\n     -d '{\"string\": \"programming\", \"substring\": \"g\"}'\n# Expected Output: {\"count\":2,\"id\":3}\n```\n\n## Development\n\n### Running Tests\n\n```bash\npoetry run pytest tests/\n```\n\n### Project Structure\n\n```\n.\n\u251c\u2500\u2500 src/\n\u2502   \u2514\u2500\u2500 substring_counter/\n\u2502       \u251c\u2500\u2500 __init__.py\n\u2502       \u251c\u2500\u2500 config.py\n\u2502       \u251c\u2500\u2500 controllers_cli.py\n\u2502       \u251c\u2500\u2500 controllers_http.py\n\u2502       \u251c\u2500\u2500 dto.py\n\u2502       \u251c\u2500\u2500 errors.py\n\u2502       \u251c\u2500\u2500 repository.py\n\u2502       \u251c\u2500\u2500 service.py\n\u2502       \u2514\u2500\u2500 utils.py\n\u251c\u2500\u2500 scripts/\n\u2502   \u2514\u2500\u2500 cli.py              # Main CLI entrypoint\n\u251c\u2500\u2500 tests/\n\u2502   \u251c\u2500\u2500 test_cli.py\n\u2502   \u251c\u2500\u2500 test_repository.py\n\u2502   \u2514\u2500\u2500 test_service.py\n\u251c\u2500\u2500 data/\n\u2502   \u2514\u2500\u2500 README.md           # Directory for SQLite DB file\n\u251c\u2500\u2500 pyproject.toml          # Project metadata and dependencies\n\u251c\u2500\u2500 requirements.txt        # Explicit runtime dependencies\n\u2514\u2500\u2500 README.md\n```\n```\n\n```python\n# data/README.md\nThis directory is intended to store the SQLite database file (`substr_counter.db`)\nused by the substring counter application.\n\nIt is typically excluded from version control (`.gitignore`) as it contains\nruntime data. The application will create this directory and the database file\nif they do not exist.\n```\n\n```python\n# src/substring_counter/__init__.py\n\"\"\"\nSubstring Counter package for counting overlapping substring occurrences.\n\"\"\"\n\n__version__ = \"0.1.0\"\n\n# Expose key components for easier import\nfrom .service import CounterService\nfrom .repository import StringRepository\nfrom .errors import InvalidInputError, RepositoryError\nfrom .dto import QueryRequest, QueryResult\nfrom .utils import find_overlapping, validate_inputs\n```\n\n```python\n# src/substring_counter/config.py\n\"\"\"\nCentralized configuration values for the substring counter application.\n\"\"\"\n\nfrom pathlib import Path\nimport os\n\n# Database configuration\nDB_DIR = os.getenv(\"SUBSTR_COUNTER_DB_DIR\", \"./data\")\nPath(DB_DIR).mkdir(parents=True, exist_ok=True)\nDB_PATH: str = os.path.join(DB_DIR, \"substr_counter.db\")\n\n# HTTP API server configuration\nAPP_HOST: str = os.getenv(\"SUBSTR_COUNTER_APP_HOST\", \"127.0.0.1\")\nAPP_PORT: int = int(os.getenv(\"SUBSTR_COUNTER_APP_PORT\", 8000))\n```\n\n```python\n# src/substring_counter/errors.py\n\"\"\"\nCustom exception types for the substring counter application.\n\"\"\"\n\nclass InvalidInputError(ValueError):\n    \"\"\"Exception raised for invalid input parameters.\"\"\"\n    pass\n\nclass RepositoryError(Exception):\n    \"\"\"Exception raised for errors during database operations.\"\"\"\n    pass\n```\n\n```python\n# src/substring_counter/dto.py\n\"\"\"\nData Transfer Objects (DTOs) for request and response payloads.\n\"\"\"\n\nfrom pydantic import BaseModel, Field\nfrom typing import Optional\n\nclass QueryRequest(BaseModel):\n    \"\"\"Represents a request for counting a substring.\"\"\"\n    string: str = Field(..., description=\"The main string to search within.\")\n    substring: str = Field(..., description=\"The substring to count occurrences of.\")\n\n    def to_dict(self) -> dict:\n        \"\"\"Converts the DTO to a dictionary.\"\"\"\n        return self.model_dump()\n\nclass QueryResult(BaseModel):\n    \"\"\"Represents the result of a substring count query.\"\"\"\n    id: Optional[int] = Field(None, description=\"The ID of the persisted query record, if applicable.\")\n    count: int = Field(..., description=\"The number of times the substring was found.\")\n\n    def to_dict(self) -> dict:\n        \"\"\"Converts the DTO to a dictionary.\"\"\"\n        return self.model_dump()\n```\n\n```python\n# src/substring_counter/utils.py\n\"\"\"\nUtility functions for input validation and the core counting algorithm.\n\"\"\"\n\nfrom typing import NoReturn\nfrom .errors import InvalidInputError\n\ndef validate_inputs(input_string: str, substring: str) -> None:\n    \"\"\"\n    Validates the input string and substring.\n    Raises InvalidInputError if inputs are not valid.\n    \"\"\"\n    if not isinstance(input_string, str) or not isinstance(substring, str):\n        raise InvalidInputError(\"Both input_string and substring must be str\")\n    if substring == \"\":\n        raise InvalidInputError(\"substring must be non-empty\")\n\ndef find_overlapping(input_string: str, substring: str) -> int:\n    \"\"\"\n    Counts overlapping occurrences of a substring in a string.\n    Uses a simple sliding window algorithm, O(n*m) worst-case.\n    \"\"\"\n    if len(substring) > len(input_string):\n        return 0\n    if not substring: # Defensive check, though validate_inputs should prevent this\n        return 0\n\n    count = 0\n    sub_len = len(substring)\n    for i in range(len(input_string) - sub_len + 1):\n        if input_string[i:i + sub_len] == substring:\n            count += 1\n    return count\n```\n\n```python\n# src/substring_counter/repository.py\n\"\"\"\nRepository layer for persisting query records to an SQLite database.\n\"\"\"\n\nimport sqlite3\nfrom pathlib import Path\nfrom typing import Optional, Dict, Any\nfrom .errors import RepositoryError\n\nCREATE_TABLE_SQL = \"\"\"\nCREATE TABLE IF NOT EXISTS queries (\n  id INTEGER PRIMARY KEY AUTOINCREMENT,\n  input_string TEXT NOT NULL,\n  substring TEXT NOT NULL,\n  count INTEGER NOT NULL,\n  created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP\n);\n\"\"\"\n\nclass StringRepository:\n    \"\"\"\n    Manages persistence of query records to an SQLite database.\n    Provides methods for initializing the database and saving/retrieving queries.\n    \"\"\"\n    def __init__(self, db_path: str) -> None:\n        self._db_path = db_path\n        # Ensure the directory for the database exists\n        Path(self._db_path).parent.mkdir(parents=True, exist_ok=True)\n\n    def _connect(self) -> sqlite3.Connection:\n        \"\"\"Establishes a connection to the SQLite database.\"\"\"\n        return sqlite3.connect(self._db_path)\n\n    def initialize(self) -> None:\n        \"\"\"\n        Initializes the database by creating the 'queries' table if it doesn't exist.\n        \"\"\"\n        conn = None\n        try:\n            conn = self._connect()\n            conn.execute(CREATE_TABLE_SQL)\n            # Add index for created_at as per spec\n            conn.execute(\"CREATE INDEX IF NOT EXISTS idx_queries_created_at ON queries(created_at);\")\n            conn.commit()\n        except sqlite3.Error as e:\n            raise RepositoryError(f\"Failed to initialize database: {e}\") from e\n        finally:\n            if conn:\n                conn.close()\n\n    def save_query(self, input_string: str, substring: str, count: int) -> int:\n        \"\"\"\n        Inserts a new query record into the database.\n        Returns the ID of the newly inserted record.\n        \"\"\"\n        conn = None\n        try:\n            conn = self._connect()\n            cur = conn.cursor()\n            cur.execute(\"INSERT INTO queries (input_string, substring, count) VALUES (?, ?, ?)\",\n                        (input_string, substring, count))\n            conn.commit()\n            if cur.lastrowid is None:\n                raise RepositoryError(\"Failed to retrieve last inserted row ID.\")\n            return cur.lastrowid\n        except sqlite3.Error as e:\n            raise RepositoryError(f\"Failed to save query: {e}\") from e\n        finally:\n            if conn:\n                conn.close()\n\n    def get_query(self, query_id: int) -> Optional[Dict[str, Any]]:\n        \"\"\"\n        Retrieves a query record by its ID.\n        Returns a dictionary representing the record or None if not found.\n        \"\"\"\n        conn = None\n        try:\n            conn = self._connect()\n            conn.row_factory = sqlite3.Row # Allows accessing columns by name\n            cur = conn.cursor()\n            cur.execute(\"SELECT id, input_string, substring, count, created_at FROM queries WHERE id = ?\", (query_id,))\n            row = cur.fetchone()\n            if row:\n                return dict(row)\n            return None\n        except sqlite3.Error as e:\n            raise RepositoryError(f\"Failed to retrieve query: {e}\") from e\n        finally:\n            if conn:\n                conn.close()\n```\n\n```python\n# src/substring_counter/service.py\n\"\"\"\nService layer encapsulating the core business logic for counting and persistence.\n\"\"\"\n\nfrom typing import Optional\nfrom .repository import StringRepository\nfrom .dto import QueryResult\nfrom .utils import validate_inputs, find_overlapping\nfrom .errors import InvalidInputError, RepositoryError\n\nclass CounterService:\n    \"\"\"\n    Provides the main business logic for counting substring occurrences\n    and orchestrating persistence.\n    \"\"\"\n    def __init__(self, repository: StringRepository) -> None:\n        self._repository = repository\n\n    def count(self, input_string: str, substring: str) -> int:\n        \"\"\"\n        Validates inputs and returns the count of overlapping substring occurrences.\n        Does not persist the query.\n        \"\"\"\n        validate_inputs(input_string, substring)\n        return find_overlapping(input_string, substring)\n\n    def validate_and_count(self, input_string: str, substring: str, persist: bool = True) -> QueryResult:\n        \"\"\"\n        Validates inputs, computes the count, and optionally persists the query.\n        Returns a QueryResult DTO with the count and optionally a record ID.\n        \"\"\"\n        count = self.count(input_string, substring)\n        record_id: Optional[int] = None\n        if persist:\n            try:\n                record_id = self._repository.save_query(input_string, substring, count)\n            except Exception as e:\n                # Wrap underlying DB errors in a custom RepositoryError\n                raise RepositoryError(\"Failed saving query record to database.\") from e\n        return QueryResult(id=record_id, count=count)\n```\n\n```python\n# src/substring_counter/controllers_cli.py\n\"\"\"\nCLI controller responsible for parsing command-line arguments and invoking the service.\n\"\"\"\n\nimport argparse\nimport sys\nfrom typing import List, TextIO, Optional\nfrom .service import CounterService\nfrom .errors import InvalidInputError, RepositoryError\n\nclass CLIController:\n    \"\"\"\n    Handles command-line interface interactions, including argument parsing,\n    service invocation, and result display.\n    \"\"\"\n    def __init__(self, service: CounterService) -> None:\n        self._service = service\n\n    def _get_parser(self) -> argparse.ArgumentParser:\n        \"\"\"Configures and returns the argument parser.\"\"\"\n        parser = argparse.ArgumentParser(\n            prog=\"substring-counter\",\n            description=\"Count overlapping occurrences of a substring in a string.\",\n            formatter_class=argparse.RawTextHelpFormatter\n        )\n        parser.add_argument(\n            \"-s\", \"--string\",\n            type=str,\n            help=\"The main string to search within. Can be '-' to read from stdin, or omitted with --stdin.\"\n        )\n        parser.add_argument(\n            \"-sub\", \"--substring\",\n            type=str,\n            required=True,\n            help=\"The substring to count occurrences of.\"\n        )\n        parser.add_argument(\n            \"--stdin\",\n            action=\"store_true\",\n            help=\"Read the main string from standard input.\"\n        )\n        parser.add_argument(\n            \"--no-persist\",\n            action=\"store_true\",\n            help=\"Do not persist the query to the database.\"\n        )\n        return parser\n\n    def run(self, args: List[str]) -> int:\n        \"\"\"\n        Executes the CLI command based on provided arguments.\n        Returns an exit code (0 for success, non-zero for errors).\n        \"\"\"\n        parser = self._get_parser()\n        parsed_args = parser.parse_args(args)\n\n        input_string: Optional[str] = parsed_args.string\n        substring: str = parsed_args.substring\n        persist: bool = not parsed_args.no_persist\n\n        if parsed_args.stdin:\n            if parsed_args.string is not None and parsed_args.string != '-':\n                print(\"Error: Cannot use --string with --stdin unless --string is '-'\", file=sys.stderr)\n                return 2\n            try:\n                input_string = sys.stdin.read().strip()\n            except Exception as e:\n                print(f\"Error reading from stdin: {e}\", file=sys.stderr)\n                return 1\n        elif input_string == '-':\n            try:\n                input_string = sys.stdin.read().strip()\n            except Exception as e:\n                print(f\"Error reading from stdin: {e}\", file=sys.stderr)\n                return 1\n        elif input_string is None:\n            print(\"Error: --string or --stdin must be provided.\", file=sys.stderr)\n            parser.print_help(sys.stderr)\n            return 2\n        \n        if not input_string: # Handle empty string from stdin or explicit empty string\n            input_string = \"\"\n\n        try:\n            result = self._service.validate_and_count(input_string, substring, persist)\n            if persist:\n                print(f\"Count: {result.count}, Record ID: {result.id}\")\n            else:\n                print(f\"Count: {result.count}\")\n            return 0\n        except InvalidInputError as e:\n            print(f\"Error: {e}\", file=sys.stderr)\n            return 2  # Invalid arguments/input\n        except RepositoryError as e:\n            print(f\"Database error: {e}\", file=sys.stderr)\n            return 1  # Runtime error\n        except Exception as e:\n            print(f\"An unexpected error occurred: {e}\", file=sys.stderr)\n            return 1  # Generic runtime error\n```\n\n```python\n# src/substring_counter/controllers_http.py\n\"\"\"\nHTTP controller (FastAPI app factory) exposing the /count endpoint.\n\"\"\"\n\nfrom fastapi import FastAPI, HTTPException, status\nfrom fastapi.responses import JSONResponse\nfrom pydantic import BaseModel\nfrom .service import CounterService\nfrom .dto import QueryRequest, QueryResult\nfrom .errors import InvalidInputError, RepositoryError\n\ndef create_app(service: CounterService) -> FastAPI:\n    \"\"\"\n    Factory function to create and configure a FastAPI application instance.\n    Dependencies (like CounterService) are injected here.\n    \"\"\"\n    app = FastAPI(\n        title=\"Substring Counter API\",\n        description=\"API to count overlapping substring occurrences and persist queries.\",\n        version=\"0.1.0\"\n    )\n\n    @app.post(\"/count\", response_model=QueryResult, status_code=status.HTTP_200_OK)\n    async def count_substring(request: QueryRequest) -> QueryResult:\n        \"\"\"\n        Counts overlapping occurrences of a substring and persists the query.\n        Accepts string and substring in JSON body.\n        Returns the count and the ID of the persisted record.\n        \"\"\"\n        try:\n            result = service.validate_and_count(request.string, request.substring, persist=True)\n            return result\n        except InvalidInputError as e:\n            raise HTTPException(\n                status_code=status.HTTP_400_BAD_REQUEST,\n                detail=f\"Invalid input: {e}\"\n            ) from e\n        except RepositoryError as e:\n            raise HTTPException(\n                status_code=status.HTTP_500_INTERNAL_SERVER_ERROR,\n                detail=f\"Internal error saving query: {e}\"\n            ) from e\n        except Exception as e:\n            raise HTTPException(\n                status_code=status.HTTP_500_INTERNAL_SERVER_ERROR,\n                detail=f\"An unexpected server error occurred: {e}\"\n            ) from e\n\n    return app\n```\n\n```python\n# scripts/cli.py\n\"\"\"\nMain entry point script for the Substring Counter CLI application.\n\"\"\"\n\nimport sys\nfrom substring_counter.repository import StringRepository\nfrom substring_counter.service import CounterService\nfrom substring_counter.controllers_cli import CLIController\nfrom substring_counter.config import DB_PATH\n\ndef main(argv=None):\n    \"\"\"\n    Initializes the application components and runs the CLI controller.\n    \"\"\"\n    argv = argv or sys.argv[1:]\n\n    # Initialize repository\n    repo = StringRepository(DB_PATH)\n    repo.initialize() # Ensure DB schema is set up\n\n    # Initialize service with repository\n    service = CounterService(repo)\n\n    # Initialize CLI controller with service\n    controller = CLIController(service)\n\n    # Run the CLI command and return its exit code\n    return controller.run(argv)\n\nif __name__ == \"__main__\":\n    sys.exit(main())\n```\n\n```python\n# tests/test_service.py\n\"\"\"\nUnit tests for the CounterService class.\n\"\"\"\n\nimport pytest\nfrom unittest.mock import Mock\nfrom src.substring_counter.service import CounterService\nfrom src.substring_counter.repository import StringRepository\nfrom src.substring_counter.errors import InvalidInputError, RepositoryError\nfrom src.substring_counter.dto import QueryResult\n\nclass TestCounterService:\n    @pytest.fixture\n    def mock_repository(self) -> Mock:\n        \"\"\"Provides a mock StringRepository instance.\"\"\"\n        repo = Mock(spec=StringRepository)\n        repo.save_query.return_value = 1  # Default ID for successful save\n        return repo\n\n    @pytest.fixture\n    def service(self, mock_repository: Mock) -> CounterService:\n        \"\"\"Provides a CounterService instance with a mocked repository.\"\"\"\n        return CounterService(mock_repository)\n\n    # Test cases for count() method (without persistence)\n    @pytest.mark.parametrize(\n        \"input_string, substring, expected_count\",\n        [\n            (\"\", \"a\", 0),\n            (\"aaa\", \"a\", 3),\n            (\"aaaa\", \"aa\", 3),\n            (\"banana\", \"ana\", 2),\n            (\"mississippi\", \"iss\", 2),\n            (\"abc\", \"d\", 0),\n            (\"abc\", \"abcd\", 0),  # substring longer than string\n            (\"testtesttest\", \"test\", 3),\n            (\"topcoder\", \"topcoder\", 1),\n            (\"zzza\", \"zzza\", 1),\n            (\"zzza\", \"zz\", 2),\n        ]\n    )\n    def test_count_success(self, service: CounterService, input_string: str, substring: str, expected_count: int):\n        \"\"\"Test count method with valid inputs and expected counts.\"\"\"\n        actual_count = service.count(input_string, substring)\n        assert actual_count == expected_count\n\n    @pytest.mark.parametrize(\n        \"input_string, substring, error_message\",\n        [\n            (\"test\", \"\", \"substring must be non-empty\"),\n            (123, \"a\", \"Both input_string and substring must be str\"),\n            (\"a\", 123, \"Both input_string and substring must be str\"),\n            (None, \"a\", \"Both input_string and substring must be str\"),\n            (\"a\", None, \"Both input_string and substring must be str\"),\n        ]\n    )\n    def test_count_invalid_inputs(self, service: CounterService, input_string, substring, error_message):\n        \"\"\"Test count method raises InvalidInputError for invalid inputs.\"\"\"\n        with pytest.raises(InvalidInputError) as exc_info:\n            service.count(input_string, substring)\n        assert str(exc_info.value) == error_message\n\n    # Test cases for validate_and_count() method (with persistence)\n    def test_validate_and_count_persists(self, service: CounterService, mock_repository: Mock):\n        \"\"\"Test validate_and_count successfully persists and returns QueryResult.\"\"\"\n        input_str = \"ababa\"\n        sub_str = \"aba\"\n        expected_count = 2\n        expected_id = 1\n\n        result = service.validate_and_count(input_str, sub_str, persist=True)\n\n        mock_repository.save_query.assert_called_once_with(input_str, sub_str, expected_count)\n        assert result.count == expected_count\n        assert result.id == expected_id\n\n    def test_validate_and_count_no_persist(self, service: CounterService, mock_repository: Mock):\n        \"\"\"Test validate_and_count does not persist when persist=False.\"\"\"\n        input_str = \"test\"\n        sub_str = \"es\"\n        expected_count = 1\n\n        result = service.validate_and_count(input_str, sub_str, persist=False)\n\n        mock_repository.save_query.assert_not_called()\n        assert result.count == expected_count\n        assert result.id is None # ID should be None if not persisted\n\n    def test_validate_and_count_repository_error(self, service: CounterService, mock_repository: Mock):\n        \"\"\"Test validate_and_count raises RepositoryError on DB save failure.\"\"\"\n        mock_repository.save_query.side_effect = Exception(\"DB connection failed\")\n\n        with pytest.raises(RepositoryError, match=\"Failed saving query record to database.\"):\n            service.validate_and_count(\"test\", \"t\", persist=True)\n        mock_repository.save_query.assert_called_once()\n\n    def test_validate_and_count_invalid_input_error(self, service: CounterService, mock_repository: Mock):\n        \"\"\"Test validate_and_count propagates InvalidInputError.\"\"\"\n        with pytest.raises(InvalidInputError):\n            service.validate_and_count(\"test\", \"\", persist=True)\n        mock_repository.save_query.assert_not_called() # Should not