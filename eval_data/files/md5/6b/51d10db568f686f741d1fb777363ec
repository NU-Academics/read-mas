{"task_id": "HumanEval/58", "solution": "```python\n# pyproject.toml\n# This file defines project metadata, dependencies, and build configuration.\n\n[build-system]\nrequires = [\"setuptools>=61.0\"]\nbuild-backend = \"setuptools.build_meta\"\n\n[project]\nname = \"common-elements-lib\"\nversion = \"0.1.0\"\ndescription = \"A Python library to compute sorted unique common elements between two lists.\"\nreadme = \"README.md\"\nauthors = [{ name = \"Your Name\", email = \"your.email@example.com\" }]\nlicense = { text = \"MIT\" }\nrequires-python = \">=3.8\"\nkeywords = [\"common\", \"elements\", \"list\", \"intersection\", \"utility\"]\nclassifiers = [\n    \"Programming Language :: Python :: 3\",\n    \"License :: OSI Approved :: MIT License\",\n    \"Operating System :: OS Independent\",\n]\n\n[project.optional-dependencies]\napi = [\"Flask>=2.0\"] # Optional dependency for the HTTP API\ndev = [\"pytest>=7.0\", \"flake8>=4.0\", \"black>=22.0\"] # Development dependencies\n\n[project.scripts]\ncommon-elements = \"common_elements.cli_controller:main\" # CLI entry point\n\n[tool.setuptools.packages.find]\nwhere = [\"src\"] # Tell setuptools to look for packages in the 'src' directory\n\n```\n\n```python\n# src/common_elements/exceptions.py\nfrom typing import Any\n\nclass CommonError(Exception):\n    \"\"\"Base exception for the common_elements library, providing a custom message.\"\"\"\n    def __init__(self, message: str):\n        self.message = message\n        super().__init__(self.message)\n\nclass CommonInputError(CommonError):\n    \"\"\"Raised for invalid user inputs, such as bad types or unhashable elements.\"\"\"\n    pass\n\n```\n\n```python\n# src/common_elements/validator.py\nfrom typing import Sequence, Any, List\nfrom .exceptions import CommonInputError\n\nclass Validator:\n    \"\"\"Centralizes validation rules for input sequences and their elements.\"\"\"\n\n    def validate_list(self, seq: Any, name: str = \"list\") -> List[Any]:\n        \"\"\"Ensures the input is an iterable (but not a string) and converts it to a list.\"\"\"\n        if isinstance(seq, str):\n            raise CommonInputError(f\"{name} must be an iterable (list/tuple/set), not a string directly.\")\n        try:\n            return list(seq)\n        except TypeError:\n            raise CommonInputError(f\"{name} must be an iterable (list/tuple/set).\")\n\n    def ensure_hashable_elements(self, seq: Sequence[Any], name: str = \"list\") -> None:\n        \"\"\"Checks if all elements in the sequence are hashable, suitable for set operations.\"\"\"\n        for i, el in enumerate(seq):\n            try:\n                hash(el)\n            except TypeError:\n                raise CommonInputError(f\"Element at index {i} of {name} is unhashable: {el!r}\")\n\n```\n\n```python\n# src/common_elements/models_listpair.py\nfrom typing import Any, List\nfrom .validator import Validator\n\nclass ListPair:\n    \"\"\"A Data Transfer Object (DTO) for conveniently holding a pair of lists.\"\"\"\n\n    def __init__(self, list1: List[Any], list2: List[Any]):\n        self.list1 = list1\n        self.list2 = list2\n\n    @classmethod\n    def from_args(cls, list1_arg: Any, list2_arg: Any) -> \"ListPair\":\n        \"\"\"Creates a ListPair instance by validating and normalizing raw input arguments.\"\"\"\n        validator = Validator()\n        l1 = validator.validate_list(list1_arg, \"list1\")\n        l2 = validator.validate_list(list2_arg, \"list2\")\n        return cls(l1, l2)\n\n```\n\n```python\n# src/common_elements/models_result.py\nfrom typing import Any, List\n\nclass CommonResult:\n    \"\"\"A Data Transfer Object (DTO) to encapsulate the computation result.\"\"\"\n\n    def __init__(self, result: List[Any]):\n        self.result = result\n\n    def to_json(self) -> dict:\n        \"\"\"Converts the result into a dictionary suitable for JSON serialization.\"\"\"\n        return {\"result\": self.result}\n\n```\n\n```python\n# src/common_elements/utils.py\nimport json\nfrom typing import Any, List\nfrom .exceptions import CommonInputError\n\ndef parse_list_arg(s: str) -> List[Any]:\n    \"\"\"Parses a string into a list, supporting comma-separated values or JSON array format.\"\"\"\n    s = s.strip()\n    if s.startswith(\"[\") and s.endswith(\"]\"):\n        try:\n            arr = json.loads(s)\n            if not isinstance(arr, list):\n                raise CommonInputError(\"JSON array argument must represent a list.\")\n            return arr\n        except json.JSONDecodeError:\n            raise CommonInputError(\"Invalid JSON array provided as argument.\")\n    if not s:\n        return [] # Handle empty string for CSV-like input\n    return [item.strip() for item in s.split(\",\")]\n\ndef to_json(obj: Any) -> str:\n    \"\"\"Serializes an object to a formatted JSON string, ensuring consistent output.\"\"\"\n    return json.dumps(obj, sort_keys=True, indent=2)\n\n```\n\n```python\n# src/common_elements/common_service.py\nfrom typing import Sequence, Any, List, Set\nfrom .validator import Validator\nfrom .exceptions import CommonInputError\n\nclass CommonService:\n    \"\"\"Provides the core algorithm to compute unique, sorted common elements between two lists.\"\"\"\n\n    def __init__(self):\n        self._validator = Validator()\n\n    def common(self, list1: Sequence[Any], list2: Sequence[Any]) -> List[Any]:\n        \"\"\"Validates inputs, computes the intersection, and returns a sorted list of unique common elements.\"\"\"\n        l1 = self._validator.validate_list(list1, \"list1\")\n        l2 = self._validator.validate_list(list2, \"list2\")\n\n        self._validator.ensure_hashable_elements(l1, \"list1\")\n        self._validator.ensure_hashable_elements(l2, \"list2\")\n\n        s1, s2 = set(l1), set(l2)\n        result_set = self._compute_intersection(s1, s2)\n\n        try:\n            return sorted(list(result_set))\n        except TypeError as e:\n            raise CommonInputError(\"Elements cannot be compared for sorting (e.g., mixed incomparable types): \" + str(e))\n\n    def _compute_intersection(self, set1: Set[Any], set2: Set[Any]) -> Set[Any]:\n        \"\"\"Performs an efficient set intersection between two given sets.\"\"\"\n        return set1 & set2\n\n```\n\n```python\n# src/common_elements/__init__.py\nfrom typing import Sequence, Any, List\nfrom .common_service import CommonService\n\n__version__ = \"0.1.0\"\n\n_service_instance = CommonService()\n\ndef common(l1: Sequence[Any], l2: Sequence[Any]) -> List[Any]:\n    \"\"\"Return sorted unique common elements for two lists.\n    This is a convenience function that uses the CommonService.\n    \"\"\"\n    return _service_instance.common(l1, l2)\n\n# Expose CommonService directly for more advanced or direct usage\n__all__ = [\"common\", \"CommonService\"]\n```\n\n```python\n# src/common_elements/cli_controller.py\nimport sys\nimport argparse\nfrom typing import List as PyList, Any\nfrom .common_service import CommonService\nfrom .models_listpair import ListPair\nfrom .models_result import CommonResult\nfrom .exceptions import CommonInputError, CommonError\nfrom .utils import parse_list_arg, to_json\n\nclass CLIController:\n    \"\"\"Manages command-line interface interactions: argument parsing, service calls, and output formatting.\"\"\"\n    DEFAULT_FORMAT = \"json\"\n\n    def __init__(self):\n        self._common_service = CommonService()\n\n    def run(self, argv: PyList[str]) -> int:\n        \"\"\"The main entry point for CLI execution, handling argument parsing and result display.\"\"\"\n        parser = argparse.ArgumentParser(\n            description=\"Compute sorted unique common elements between two lists.\"\n        )\n        parser.add_argument(\n            \"--list1\",\n            required=True,\n            help=\"The first list, provided as comma-separated values or a JSON array (e.g., '1,2,3' or '[1,2,3]').\"\n        )\n        parser.add_argument(\n            \"--list2\",\n            required=True,\n            help=\"The second list, provided as comma-separated values or a JSON array (e.g., '3,4,5' or '[3,4,5]').\"\n        )\n        parser.add_argument(\n            \"--format\",\n            default=self.DEFAULT_FORMAT,\n            choices=[\"json\", \"csv\"],\n            help=\"Specifies the desired output format (default: json).\"\n        )\n\n        args = parser.parse_args(argv)\n\n        try:\n            parsed_list1 = parse_list_arg(args.list1)\n            parsed_list2 = parse_list_arg(args.list2)\n            \n            # ListPair is used for structure, validation done by parse_list_arg and CommonService\n            list_pair = ListPair(parsed_list1, parsed_list2) \n            \n            result_list = self._common_service.common(list_pair.list1, list_pair.list2)\n            common_result = CommonResult(result_list)\n\n            output = self._format_output(common_result, args.format)\n            print(output)\n            return 0\n        except CommonInputError as e:\n            print(f\"Error: {e.message}\", file=sys.stderr)\n            return 2 # Consistent with argparse exit codes for bad arguments\n        except CommonError as e:\n            print(f\"An application error occurred: {e.message}\", file=sys.stderr)\n            return 1\n        except Exception as e:\n            print(f\"An unexpected error occurred: {e}\", file=sys.stderr)\n            return 1\n\n    def _format_output(self, result_dto: CommonResult, fmt: str) -> str:\n        \"\"\"Formats the CommonResult DTO into a string according to the specified format.\"\"\"\n        if fmt == \"json\":\n            return to_json(result_dto.to_json())\n        elif fmt == \"csv\":\n            return \",\".join(map(str, result_dto.result))\n        else:\n            raise ValueError(f\"Unsupported format: {fmt}\") # Should not happen due to argparse choices\n\ndef main():\n    \"\"\"CLI entry point function for common-elements console script.\"\"\"\n    controller = CLIController()\n    sys.exit(controller.run(sys.argv[1:]))\n\n```\n\n```python\n# src/common_elements/api_controller.py\nfrom typing import Any, Dict\nimport os\nimport sys\n\n# Conditional import for Flask as it's an optional dependency.\n# Dummy classes are defined if Flask is not installed to allow the module to be imported.\ntry:\n    from flask import Flask, request, jsonify, Response\nexcept ImportError:\n    class Flask:\n        def __init__(self, *args, **kwargs):\n            raise RuntimeError(\"Flask is not installed. Install with 'pip install \\\"common_elements[api]\\\"'.\")\n        def route(self, rule: str, **options: Any):\n            def decorator(f):\n                return f\n            return decorator\n    \n    class Request:\n        json: Any = None\n    \n    class Jsonify:\n        def __call__(self, *args: Any, **kwargs: Any) -> Response:\n            return Response(status=500, response=\"Flask not installed.\")\n\n    class Response:\n        def __init__(self, *args: Any, **kwargs: Any):\n            pass\n\n    request = Request()\n    jsonify = Jsonify()\n    \n    print(\"Warning: Flask not found. HTTP API functionality is disabled.\", file=sys.stderr)\n\n\nfrom .common_service import CommonService\nfrom .models_listpair import ListPair\nfrom .models_result import CommonResult\nfrom .exceptions import CommonInputError, CommonError\n\nclass APIController:\n    \"\"\"Manages the Flask application, exposing the /common endpoint for HTTP requests.\"\"\"\n\n    def __init__(self):\n        self._common_service = CommonService()\n\n    def create_app(self) -> \"Flask\":\n        \"\"\"Factory method to create and configure a Flask application instance.\"\"\"\n        app = Flask(__name__)\n        app.json_sort_keys = False # For more predictable JSON output\n\n        @app.route(\"/common\", methods=[\"POST\"])\n        def common_endpoint():\n            return self._handle_common_request(request.json)\n\n        return app\n\n    def _handle_common_request(self, request_json: Dict[str, Any]) -> Response:\n        \"\"\"Processes incoming POST requests to /common, validating input and returning results.\"\"\"\n        if request_json is None:\n            return jsonify({\"error\": \"Request body must be JSON.\"}), 400\n        \n        try:\n            list1_data = request_json.get(\"list1\")\n            list2_data = request_json.get(\"list2\")\n\n            if list1_data is None or list2_data is None:\n                raise CommonInputError(\"Missing 'list1' or 'list2' in JSON payload.\")\n            \n            # ListPair.from_args handles initial validation and normalization to list types\n            list_pair = ListPair.from_args(list1_data, list2_data)\n\n            result_list = self._common_service.common(list_pair.list1, list_pair.list2)\n            common_result = CommonResult(result_list)\n            \n            return jsonify(common_result.to_json()), 200\n\n        except CommonInputError as e:\n            return jsonify({\"error\": e.message}), 400\n        except CommonError as e:\n            print(f\"API Internal Error: {e.message}\", file=sys.stderr)\n            return jsonify({\"error\": \"An internal application error occurred.\"}), 500\n        except Exception as e:\n            print(f\"API Unexpected Error: {e}\", file=sys.stderr)\n            return jsonify({\"error\": \"An unexpected server error occurred.\"}), 500\n\n```"}
{"task_id": "HumanEval/59", "solution": "```python\ndef largest_prime_factor(n: int) -> int:\n    \"\"\"Return the largest prime factor of n.\n    Assumes n > 1 and computes its largest prime factor using trial division.\n    \"\"\"\n    largest_factor = 1\n\n    # Divide out factors of 2\n    while n % 2 == 0:\n        largest_factor = 2\n        n //= 2\n\n    # Check for odd factors from 3 up to sqrt(n)\n    i = 3\n    while i * i <= n:\n        while n % i == 0:\n            largest_factor = i\n            n //= i\n        i += 2 # Increment by 2 to check only odd numbers\n\n    # If n is still greater than 1, it means the remaining n is prime\n    if n > 1:\n        largest_factor = n\n\n    return largest_factor\n```"}
