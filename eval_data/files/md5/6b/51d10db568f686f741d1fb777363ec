 = [\"banana\", \"apple\", \"orange\", \"banana\"]\nresult_reverse = service.unique(words, reverse=True)\nprint(f\"Unique and sorted (reverse): {result_reverse}\")\n# Output: Unique and sorted (reverse): ['orange', 'banana', 'apple']\n\n# Usage with a key function for custom sorting (e.g., sort by length)\ncomplex_words = [\"apple\", \"grape\", \"banana\", \"kiwi\", \"apple\"]\nresult_by_length = service.unique(complex_words, key=len)\nprint(f\"Unique and sorted by length: {result_by_length}\")\n# Output: Unique and sorted by length: ['kiwi', 'apple', 'grape', 'banana']\n\n# Handling errors (e.g., non-list input)\ntry:\n    service.unique(None)\nexcept Exception as e:\n    print(f\"Error: {e}\")\n# Output: Error: Input must be a list (Error Code: 100)\n```\n\n## CLI Usage\nThe `listutils-unique` command-line tool allows you to process lists from the terminal.\n\n```bash\n# Process items provided as arguments\nlistutils-unique 5 3 5 2 3 3 9 0 123\n# Output:\n# 0\n# 2\n# 3\n# 5\n# 9\n# 123\n\n# Output in JSON format\nlistutils-unique --json 5 3 5 2 3 3 9 0 123\n# Output: [0, 2, 3, 5, 9, 123]\n\n# Process items from stdin\necho \"banana\\napple\\norange\\nbanana\" | listutils-unique\n# Output:\n# apple\n# banana\n# orange\n\n# Reverse sort order\nlistutils-unique --reverse banana apple orange banana\n# Output:\n# orange\n# banana\n# apple\n\n# Handling errors via CLI\necho \"1\\n2\\nNone\" | listutils-unique\n# Output to stderr: Error: None elements not allowed (Error Code: 100)\n# Exit code will be non-zero (100 in this case).\n```\n```\n\n```python\n# LICENSE\n# This is a simple MIT License file.\n\nMIT License\n\nCopyright (c) 2023 Your Name\n\nPermission is hereby granted, free of charge, to any person obtaining a copy\nof this software and associated documentation files (the \"Software\"), to deal\nin the Software without restriction, including without limitation the rights\nto use, copy, modify, merge, publish, distribute, sublicense, and/or sell\ncopies of the Software, and to permit persons to whom the Software is\nfurnished to do so, subject to the following conditions:\n\nThe above copyright notice and this permission notice shall be included in all\ncopies or substantial portions of the Software.\n\nTHE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR\nIMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,\nFITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE\nAUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER\nLIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,\nOUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE\nSOFTWARE.\n```\n\n```python\n# src/listutils/__init__.py\n# This file defines package exports and a version constant.\n\n__version__ = \"0.1.0\"\n\nfrom .unique_service import UniqueService\nfrom .validators import InputValidator\nfrom .errors import ListUtilsError, InputValidationError, SortingError\nfrom .cli import CLI\nfrom .repository import InMemoryRepository\nfrom .types import ListResult\n```\n\n```python\n# src/listutils/errors.py\n# This file defines custom exception types for listutils, with error codes.\n\nclass ListUtilsError(Exception):\n    \"\"\"Base exception for listutils errors.\"\"\"\n    def __init__(self, message: str, error_code: int = 1) -> None:\n        super().__init__(message)\n        self.message = message\n        self.error_code = error_code\n\n    def __str__(self) -> str:\n        return f\"{self.message} (Error Code: {self.error_code})\"\n\nclass InputValidationError(ListUtilsError):\n    \"\"\"Exception raised for invalid input to the utility functions.\"\"\"\n    def __init__(self, message: str, error_code: int = 100) -> None:\n        super().__init__(message, error_code)\n\nclass SortingError(ListUtilsError):\n    \"\"\"Exception raised when elements cannot be sorted or compared.\"\"\"\n    def __init__(self, message: str, error_code: int = 200) -> None:\n        super().__init__(message, error_code)\n\n# Constants for error codes\nERR_INVALID_INPUT = 100\nERR_SORTING = 200\n```\n\n```python\n# src/listutils/types.py\n# This file defines small Data Transfer Objects (DTOs).\n\nfrom dataclasses import dataclass\nfrom typing import Any, List\n\n@dataclass\nclass ListResult:\n    \"\"\"A dataclass to hold the processed list items and original count.\"\"\"\n    items: List[Any]\n    original_count: int\n```\n\n```python\n# src/listutils/repository.py\n# This file provides a simple in-memory caching repository.\n\nfrom typing import Any, Dict, Optional, List\n\n# Constants for the repository\nMAX_CACHE_ITEMS = 1000\n\nclass InMemoryRepository:\n    \"\"\"A simple in-memory key-value store for caching results.\"\"\"\n    def __init__(self) -> None:\n        self._store_map: Dict[str, List[Any]] = {}\n\n    def store(self, key: str, value: List[Any]) -> None:\n        \"\"\"Stores a list value associated with a string key.\"\"\"\n        if len(self._store_map) >= MAX_CACHE_ITEMS:\n            # Simple eviction: clear oldest or just clear all\n            self.clear()\n        self._store_map[key] = value\n\n    def get(self, key: str) -> Optional[List[Any]]:\n        \"\"\"Retrieves a list value by its string key, or None if not found.\"\"\"\n        return self._store_map.get(key)\n\n    def clear(self) -> None:\n        \"\"\"Clears all items from the cache.\"\"\"\n        self._store_map.clear()\n```\n\n```python\n# src/listutils/validators.py\n# This file provides input validation functionality for the list utility.\n\nfrom typing import Any, Callable, List, Optional\nfrom .errors import InputValidationError, SortingError, ERR_INVALID_INPUT, ERR_SORTING\n\n# Constants for the validator\nDEFAULT_ALLOW_NONE_ELEMENTS = False\n\nclass InputValidator:\n    \"\"\"Validates input lists and their elements for type and comparability.\"\"\"\n    def __init__(self, allow_none_elements: bool = DEFAULT_ALLOW_NONE_ELEMENTS) -> None:\n        self._allow_none_elements = allow_none_elements\n\n    def validate_list(self, l: list) -> None:\n        \"\"\"Validates that the input is a list and optionally contains no None elements.\"\"\"\n        if not isinstance(l, list):\n            raise InputValidationError(\"Input must be a list\", error_code=ERR_INVALID_INPUT)\n        if not self._allow_none_elements and any(x is None for x in l):\n            raise InputValidationError(\"None elements not allowed\", error_code=ERR_INVALID_INPUT)\n\n    def check_comparable(self, items: List[Any], key: Optional[Callable[[Any], Any]]=None) -> None:\n        \"\"\"Checks if a sample of items is comparable for sorting.\"\"\"\n        if not items:\n            return\n\n        # Take a small sample to avoid iterating large lists unnecessarily.\n        # The design allows for a pragmatic sample check.\n        sample = items[:min(len(items), 10)]\n        try:\n            sorted(sample, key=key)\n        except Exception as e:\n            raise SortingError(\"Elements are not comparable for sorting\", error_code=ERR_SORTING) from e\n```\n\n```python\n# src/listutils/unique_service.py\n# This file contains the core logic for computing sorted unique lists.\n\nimport hashlib\nimport json\nfrom typing import Any, Callable, List, Optional\nfrom .validators import InputValidator\nfrom .repository import InMemoryRepository\nfrom .errors import InputValidationError, SortingError, ERR_SORTING\n\n# Constants for the service\nDEFAULT_KEY = None\n\nclass UniqueService:\n    \"\"\"Orchestrates validation, deduplication, sorting, and optional caching.\"\"\"\n    def __init__(self, validator: InputValidator, repo: Optional[InMemoryRepository]=None) -> None:\n        self._validator = validator\n        self._repo = repo\n\n    def unique(self, l: list, key: Optional[Callable[[Any], Any]] = DEFAULT_KEY, reverse: bool = False) -> list:\n        \"\"\"Returns a new list containing unique values from `l` in ascending order.\"\"\"\n        self._validator.validate_list(l)\n        self._validator.check_comparable(l, key)\n\n        cache_key = None\n        if self._repo:\n            try:\n                # Create a serializable representation for the cache key.\n                # Use repr for non-basic types in the list to attempt serialization.\n                serializable_l_items = []\n                for item in l:\n                    if isinstance(item, (int, float, str, bool, type(None))):\n                        serializable_l_items.append(item)\n                    else:\n                        serializable_l_items.append(repr(item))\n\n                key_repr = None\n                if key:\n                    # Attempt to get a stable representation for callable keys.\n                    if hasattr(key, '__qualname__'):\n                        key_repr = key.__qualname__\n                    elif hasattr(key, '__name__'):\n                        key_repr = key.__name__\n                    else:\n                        key_repr = repr(key) # Fallback to repr for other callables\n\n                cache_obj = {'l': serializable_l_items, 'key': key_repr, 'reverse': reverse}\n                cache_key = hashlib.sha256(json.dumps(cache_obj, sort_keys=True).encode('utf-8')).hexdigest()\n                \n                cached_result = self._repo.get(cache_key)\n                if cached_result is not None:\n                    return cached_result\n            except Exception:\n                # If cache key generation or repository interaction fails, proceed without caching.\n                cache_key = None \n\n        # Deduplication logic\n        deduplicated_list: List[Any] = []\n        try:\n            # Attempt set-based deduplication (preserves first occurrence order)\n            seen = set()\n            for x in l:\n                if x not in seen:\n                    seen.add(x)\n                    deduplicated_list.append(x)\n        except TypeError:\n            # Fallback for unhashable items: sort to group, then deduplicate by adjacent equality.\n            # This sorting is purely for deduplication, not the final order.\n            try:\n                # Use the provided key for this intermediate sort to ensure consistent grouping\n                # This helps in deduplicating objects where __eq__ is defined but not __hash__.\n                temp_sorted_for_dedupe = sorted(l, key=key)\n                if temp_sorted_for_dedupe:\n                    deduplicated_list.append(temp_sorted_for_dedupe[0])\n                    for i in range(1, len(temp_sorted_for_dedupe)):\n                        if temp_sorted_for_dedupe[i] != temp_sorted_for_dedupe[i-1]:\n                            deduplicated_list.append(temp_sorted_for_dedupe[i])\n            except Exception as e:\n                raise SortingError(\n                    \"Elements cannot be sorted for deduplication (unhashable/uncomparable)\",\n                    error_code=ERR_SORTING\n                ) from e\n\n        # Final sorting of the deduplicated list\n        try:\n            final_result = sorted(deduplicated_list, key=key, reverse=reverse)\n        except Exception as e:\n            raise SortingError(\"Sorting failed on deduplicated list\", error_code=ERR_SORTING) from e\n\n        if self._repo and cache_key is not None:\n            self._repo.store(cache_key, final_result)\n\n        return final_result\n```\n\n```python\n# src/listutils/cli.py\n# This file handles CLI parsing, I/O, and bridges to UniqueService.\n\nimport argparse\nimport json\nimport sys\nfrom typing import List, Any\n\nfrom .unique_service import UniqueService\nfrom .validators import InputValidator\nfrom .repository import InMemoryRepository\nfrom .errors import ListUtilsError\n\n# Constants for the CLI\nDEFAULT_OUTPUT_JSON = False\n\nclass CLI:\n    \"\"\"Command-Line Interface for the listutils unique functionality.\"\"\"\n    def __init__(self, service: UniqueService) -> None:\n        self._service = service\n\n    def parse_args(self, argv: List[str]) -> argparse.Namespace:\n        \"\"\"Parses command-line arguments for the unique utility.\"\"\"\n        parser = argparse.ArgumentParser(\n            prog=\"listutils-unique\",\n            description=\"Returns sorted unique elements from a list.\"\n        )\n        parser.add_argument(\n            \"--json\",\n            action=\"store_true\",\n            default=DEFAULT_OUTPUT_JSON,\n            help=\"Output result as a JSON array.\"\n        )\n        parser.add_argument(\n            \"--reverse\",\n            action=\"store_true\",\n            help=\"Sort in descending order.\"\n        )\n        parser.add_argument(\n            \"items\",\n            nargs=\"*\",\n            help=\"Items to process. If empty, reads from stdin (newline-separated).\"\n        )\n        return parser.parse_args(argv)\n\n    def _parse_input_items(self, items_str: List[str]) -> List[Any]:\n        \"\"\"Converts string inputs to int/float if possible, otherwise keeps as string.\"\"\"\n        parsed_items = []\n        for s in items_str:\n            try:\n                parsed_items.append(int(s))\n            except ValueError:\n                try:\n                    parsed_items.append(float(s))\n                except ValueError:\n                    parsed_items.append(s) # Fallback to string\n        return parsed_items\n\n    def run(self, argv: List[str]) -> int:\n        \"\"\"Executes the CLI command, returning an exit code.\"\"\"\n        args = self.parse_args(argv)\n\n        input_raw_strings: List[str]\n        if args.items:\n            input_raw_strings = args.items\n        else:\n            # Read from stdin if no items provided as arguments\n            input_raw_strings = [line.strip() for line in sys.stdin if line.strip()]\n        \n        parsed_items = self._parse_input_items(input_raw_strings)\n\n        try:\n            result = self._service.unique(parsed_items, reverse=args.reverse)\n            if args.json:\n                print(json.dumps(result))\n            else:\n                for item in result:\n                    print(item)\n            return 0 # Success exit code\n        except ListUtilsError as e:\n            print(f\"Error: {e}\", file=sys.stderr)\n            return e.error_code or 1 # Non-zero exit code for errors\n        except Exception as e:\n            print(f\"An unexpected error occurred: {e}\", file=sys.stderr)\n            return 1 # Generic error code for unexpected issues\n\ndef main(argv: Optional[List[str]] = None) -> int:\n    \"\"\"Main entry point for the CLI script.\"\"\"\n    if argv is None:\n        argv = sys.argv[1:] # Exclude script name\n    \n    validator = InputValidator()\n    repository = InMemoryRepository() # Repository for optional caching\n    service = UniqueService(validator, repository)\n    cli = CLI(service)\n    return cli.run(argv)\n\nif __name__ == \"__main__\":\n    sys.exit(main())\n```\n\n```python\n# src/listutils/client.py\n# This file provides an example programmatic client for the UniqueService.\n\nfrom typing import List, Any\nfrom .unique_service import UniqueService\n\nclass UserClient:\n    \"\"\"An example client demonstrating programmatic usage of UniqueService.\"\"\"\n    def __init__(self, service: UniqueService) -> None:\n        self._service = service\n\n    def call_unique(self, l: List[Any]) -> List[Any]:\n        \"\"\"Calls the unique service with a list and returns the result.\"\"\"\n        return self._service.unique(l)\n```"}
