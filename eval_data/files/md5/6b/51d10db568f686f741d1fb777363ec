r_service = CalculatorService(repo=repository, validator=validator)\n        return self._calculator_service\n\n    def create_cli_controller(self) -> CLIController:\n        \"\"\"Creates and returns the CLIController.\"\"\"\n        if self._cli_controller is None:\n            service = self.create_service()\n            self._cli_controller = CLIController(service=service)\n        return self._cli_controller\n\n    def create_api_controller(self) -> APIController:\n        \"\"\"Creates and returns the APIController.\"\"\"\n        if self._api_controller is None:\n            service = self.create_service()\n            self._api_controller = APIController(service=service)\n        return self._api_controller\n\n    def run_cli(self, argv: List[str]) -> int:\n        \"\"\"Runs the CLI application and returns the exit code.\"\"\"\n        cli_controller = self.create_cli_controller()\n        return cli_controller.run_add(argv)\n\n    def get_asgi_app(self) -> FastAPI:\n        \"\"\"Returns the FastAPI application instance.\"\"\"\n        app = FastAPI(\n            title=\"SimpleCalc API\",\n            description=\"A minimal REST API for arithmetic operations with history persistence.\",\n            version=\"0.1.0\"\n        )\n        api_controller = self.create_api_controller()\n        app.include_router(api_controller.router())\n        return app\n\ndef cli_entrypoint():\n    \"\"\"Entry point for the command-line interface.\"\"\"\n    config = AppConfig.from_env()\n    app = App(config)\n    try:\n        exit_code = app.run_cli(sys.argv[1:])\n        sys.exit(exit_code)\n    except SimpleCalcError as e:\n        print(f\"Application error: {e}\", file=sys.stderr)\n        sys.exit(1)\n    except Exception as e:\n        print(f\"An unexpected error occurred during CLI execution: {e}\", file=sys.stderr)\n        sys.exit(1)\n\n# This function is used by uvicorn to serve the API\ndef get_asgi_app():\n    \"\"\"Factory function to get the ASGI application for Uvicorn.\"\"\"\n    config = AppConfig.from_env()\n    app_instance = App(config)\n    return app_instance.get_asgi_app()\n\nif __name__ == \"__main__\":\n    cli_entrypoint()\n\n```\n```python\n# tests/test_add.py\nimport pytest\nimport doctest\nfrom simplecalc.add import AddModule\n\ndef test_add_module_add():\n    \"\"\"Test AddModule.add with basic positive integers.\"\"\"\n    assert AddModule.add(2, 3) == 5\n    assert AddModule.add(5, 7) == 12\n\ndef test_add_module_add_negative_numbers():\n    \"\"\"Test AddModule.add with negative integers.\"\"\"\n    assert AddModule.add(-2, 3) == 1\n    assert AddModule.add(-5, -7) == -12\n    assert AddModule.add(10, -5) == 5\n\ndef test_add_module_add_zero():\n    \"\"\"Test AddModule.add with zero.\"\"\"\n    assert AddModule.add(0, 5) == 5\n    assert AddModule.add(-5, 0) == -5\n    assert AddModule.add(0, 0) == 0\n\ndef test_add_module_doctests():\n    \"\"\"Run doctests defined in the AddModule.\"\"\"\n    results = doctest.testmod(AddModule, report=False)\n    assert results.failed == 0, f\"{results.failed} doctest(s) failed.\"\n\n```\n```python\n# tests/test_services.py\nimport pytest\nfrom unittest.mock import MagicMock\nfrom simplecalc.services import CalculatorService\nfrom simplecalc.repositories import InMemoryHistoryRepository\nfrom simplecalc.validators import InputValidator\nfrom simplecalc.exceptions import ValidationError, ServiceError, RepositoryError\nfrom simplecalc.models import OperationResult, HistoryEntry\n\n@pytest.fixture\ndef in_memory_repo():\n    \"\"\"Provides a fresh InMemoryHistoryRepository for tests.\"\"\"\n    return InMemoryHistoryRepository()\n\n@pytest.fixture\ndef input_validator():\n    \"\"\"Provides an InputValidator instance.\"\"\"\n    return InputValidator()\n\n@pytest.fixture\ndef calculator_service(in_memory_repo, input_validator):\n    \"\"\"Provides a CalculatorService instance with an in-memory repo.\"\"\"\n    return CalculatorService(repo=in_memory_repo, validator=input_validator)\n\ndef test_calculator_service_add_success(calculator_service, in_memory_repo):\n    \"\"\"Test successful addition and persistence.\"\"\"\n    x, y = 10, 20\n    result_dto = calculator_service.add(x, y)\n\n    assert isinstance(result_dto, OperationResult)\n    assert result_dto.result == 30\n    assert result_dto.entry_id is not None\n    assert result_dto.entry_id > 0\n\n    # Verify history entry in repository\n    persisted_entry = in_memory_repo.get_by_id(result_dto.entry_id)\n    assert persisted_entry is not None\n    assert persisted_entry.operation == \"add\"\n    assert persisted_entry.x == x\n    assert persisted_entry.y == y\n    assert persisted_entry.result == 30\n\ndef test_calculator_service_add_invalid_input(calculator_service):\n    \"\"\"Test add with non-integer inputs raises ValidationError.\"\"\"\n    with pytest.raises(ValidationError, match=\"cannot be converted to integer\"):\n        calculator_service.add(\"abc\", 5)\n\n    with pytest.raises(ValidationError, match=\"cannot be converted to integer\"):\n        calculator_service.add(5, \"def\")\n\n    with pytest.raises(ValidationError, match=\"cannot be None\"):\n        calculator_service.add(None, 5)\n\n    with pytest.raises(ValidationError, match=\"cannot be None\"):\n        calculator_service.add(5, None)\n\ndef test_calculator_service_add_repository_error(input_validator):\n    \"\"\"Test that CalculatorService wraps RepositoryError in ServiceError.\"\"\"\n    mock_repo = MagicMock(spec=InMemoryHistoryRepository)\n    mock_repo.persist.side_effect = RepositoryError(\"DB connection lost\")\n\n    service = CalculatorService(repo=mock_repo, validator=input_validator)\n\n    with pytest.raises(ServiceError, match=\"Failed to persist operation history.\"):\n        service.add(1, 2)\n    mock_repo.persist.assert_called_once()\n\ndef test_calculator_service_add_zero_inputs(calculator_service):\n    \"\"\"Test addition with zero inputs.\"\"\"\n    result_dto = calculator_service.add(0, 0)\n    assert result_dto.result == 0\n    assert result_dto.entry_id is not None\n    persisted_entry = calculator_service._repo.get_by_id(result_dto.entry_id)\n    assert persisted_entry.x == 0\n    assert persisted_entry.y == 0\n    assert persisted_entry.result == 0\n\n```\n```python\n# tests/test_sqlite_adapter.py\nimport pytest\nimport sqlite3\nimport os\nfrom datetime import datetime, timedelta\nfrom simplecalc.sqlite_adapter import SqliteHistoryRepository, DEFAULT_DB_PATH, TABLE_NAME\nfrom simplecalc.models import HistoryEntry\nfrom simplecalc.exceptions import RepositoryError\n\n@pytest.fixture\ndef temp_db_path(tmp_path):\n    \"\"\"Provides a temporary SQLite database path.\"\"\"\n    db_file = tmp_path / \"test_history.db\"\n    return str(db_file)\n\n@pytest.fixture\ndef sqlite_repo(temp_db_path):\n    \"\"\"Provides a SqliteHistoryRepository instance with a temporary DB.\"\"\"\n    repo = SqliteHistoryRepository(db_path=temp_db_path)\n    yield repo\n    # Clean up (connection closed implicitly by fixture scope, file removed by tmp_path)\n    if os.path.exists(temp_db_path):\n        os.remove(temp_db_path)\n\ndef test_sqlite_repo_init_creates_schema(temp_db_path):\n    \"\"\"Test that schema is created on initialization.\"\"\"\n    assert not os.path.exists(temp_db_path)\n    repo = SqliteHistoryRepository(db_path=temp_db_path)\n    assert os.path.exists(temp_db_path)\n\n    # Verify table existence\n    conn = sqlite3.connect(temp_db_path)\n    cursor = conn.cursor()\n    cursor.execute(f\"SELECT name FROM sqlite_master WHERE type='table' AND name='{TABLE_NAME}';\")\n    assert cursor.fetchone() is not None\n    conn.close()\n\ndef test_sqlite_repo_persist_and_get_by_id(sqlite_repo):\n    \"\"\"Test persisting an entry and retrieving it by ID.\"\"\"\n    entry = HistoryEntry(id=None, operation=\"add\", x=1, y=2, result=3)\n    entry_id = sqlite_repo.persist(entry)\n\n    assert isinstance(entry_id, int)\n    assert entry_id > 0\n\n    retrieved_entry = sqlite_repo.get_by_id(entry_id)\n    assert retrieved_entry is not None\n    assert retrieved_entry.id == entry_id\n    assert retrieved_entry.operation == \"add\"\n    assert retrieved_entry.x == 1\n    assert retrieved_entry.y == 2\n    assert retrieved_entry.result == 3\n    assert isinstance(retrieved_entry.timestamp, datetime)\n    assert datetime.utcnow() - retrieved_entry.timestamp < timedelta(seconds=5) # Recently added\n\ndef test_sqlite_repo_get_by_id_not_found(sqlite_repo):\n    \"\"\"Test retrieving a non-existent ID.\"\"\"\n    assert sqlite_repo.get_by_id(9999) is None\n\ndef test_sqlite_repo_recent(sqlite_repo):\n    \"\"\"Test retrieving recent entries.\"\"\"\n    # Add multiple entries with different timestamps (simulate over time)\n    entry1 = HistoryEntry(id=None, operation=\"add\", x=10, y=20, result=30)\n    sqlite_repo.persist(entry1)\n    \n    # Wait a bit to ensure distinct timestamps for ordering\n    import time\n    time.sleep(0.01) \n\n    entry2 = HistoryEntry(id=None, operation=\"add\", x=1, y=1, result=2)\n    sqlite_repo.persist(entry2)\n    \n    time.sleep(0.01)\n\n    entry3 = HistoryEntry(id=None, operation=\"sub\", x=5, y=2, result=3)\n    sqlite_repo.persist(entry3)\n\n    recent_entries = sqlite_repo.recent(2)\n    assert len(recent_entries) == 2\n    assert recent_entries[0].result == 3 # Most recent (entry3)\n    assert recent_entries[1].result == 2 # Second most recent (entry2)\n\n    all_entries = sqlite_repo.recent(5)\n    assert len(all_entries) == 3\n    assert all_entries[0].result == 3\n    assert all_entries[1].result == 2\n    assert all_entries[2].result == 30\n\ndef test_sqlite_repo_persist_error_handling(sqlite_repo, monkeypatch):\n    \"\"\"Test that repository errors are raised for DB failures.\"\"\"\n    # Simulate a DB error during insert\n    def mock_execute(*args, **kwargs):\n        raise sqlite3.Error(\"Mock DB error\")\n\n    with monkeypatch.context() as m:\n        m.setattr(sqlite_repo._get_connection().cursor(), 'execute', mock_execute)\n        entry = HistoryEntry(id=None, operation=\"add\", x=1, y=2, result=3)\n        with pytest.raises(RepositoryError, match=\"Failed to persist history entry\"):\n            sqlite_repo.persist(entry)\n\n```\n```yaml\n# .github/workflows/ci.yml\nname: CI/CD Pipeline\n\non:\n  push:\n    branches: [ main ]\n  pull_request:\n    branches: [ main ]\n\njobs:\n  build-and-test:\n    runs-on: ubuntu-latest\n\n    steps:\n    - uses: actions/checkout@v4\n\n    - name: Set up Python\n      uses: actions/setup-python@v5\n      with:\n        python-version: '3.9' # Or 3.10, 3.11, etc.\n        cache: 'poetry'\n\n    - name: Install Poetry\n      run: pip install poetry\n\n    - name: Install dependencies\n      run: poetry install --no-root\n\n    - name: Run Mypy (type checking)\n      run: poetry run mypy src/simplecalc\n\n    - name: Run tests with pytest\n      run: poetry run pytest --doctest-modules src/simplecalc\n\n    # Optional: Add linting (black, isort)\n    - name: Check code format with Black\n      run: poetry run black --check src/simplecalc\n\n    - name: Check import order with Isort\n      run: poetry run isort --check-only src/simplecalc\n\n```"}
{"task_id": "HumanEval/55", "solution": "To implement the software design specification, I will create the necessary Python files and their contents under `src/fib_app/`, `tests/`, and the root directory as detailed in the design document.\n\nDue to the length and number of files, I'll provide each file's content sequentially.\n\n```python\n# src/fib_app/config.py\n\"\"\"Configuration constants for the Fibonacci application.\"\"\"\n\nDEFAULT_ALGORITHM: str = \"matrix\"\nCACHE_MAX_SIZE: int = 1000\nHTTP_HOST: str = \"127.0.0.1\"\nHTTP_PORT: int = 8000\nMAX_N_FOR_SAFE_ITERATIVE: int = 100000 # Example threshold, can be tuned.\n```\n\n```python\n# src/fib_app/models.py\n\"\"\"Data Transfer Objects (DTOs) for Fibonacci results.\"\"\"\n\nfrom typing import Any\n\nclass FibonacciResult:\n    \"\"\"Represents the result of a Fibonacci computation with metadata.\"\"\"\n    def __init__(self, n: int, value: int, algorithm: str, duration_ms: float) -> None:\n        self.n = n\n        self.value = value\n        self.algorithm = algorithm\n        self.duration_ms = duration_ms\n\n    def to_dict(self) -> dict[str, Any]:\n        \"\"\"Returns a serializable dictionary representation of the result.\"\"\"\n        return {\n            \"n\": self.n,\n            \"value\": str(self.value), # Serialize large ints as strings\n            \"algorithm\": self.algorithm,\n            \"duration_ms\": self.duration_ms,\n        }\n```\n\n```python\n# src/fib_app/exceptions.py\n\"\"\"Custom exceptions for the Fibonacci application.\"\"\"\n\nclass FibonacciError(Exception):\n    \"\"\"Base exception for Fibonacci-related errors, with an associated code.\"\"\"\n    def __init__(self, message: str, code: int = 400) -> None:\n        super().__init__(message)\n        self.message = message\n        self.code = code\n\n    def __str__(self) -> str:\n        \"\"\"Returns the string representation of the exception.\"\"\"\n        return f\"FibonacciError (Code: {self.code}): {self.message}\"\n```\n\n```python\n# src/fib_app/utils.py\n\"\"\"Utility functions for the Fibonacci application.\"\"\"\n\nimport time\nfrom typing import Any\nfrom .exceptions import FibonacciError\n\ndef validate_n(n: Any) -> int:\n    \"\"\"Validates if n is an integer >= 1, raising FibonacciError if not.\"\"\"\n    if not isinstance(n, int):\n        raise FibonacciError(f\"Input 'n' must be an integer, got {type(n).__name__}\", code=400)\n    if n < 1:\n        raise FibonacciError(f\"Input 'n' must be >= 1, got {n}\", code=400)\n    return n\n\ndef time_ms() -> float:\n    \"\"\"Returns the current time in milliseconds using a high-resolution timer.\"\"\"\n    return time.perf_counter() * 1000\n```\n\n```python\n# src/fib_app/logging_config.py\n\"\"\"Logging configuration for the Fibonacci application.\"\"\"\n\nimport logging\nimport sys\n\ndef configure_logging(level: str = \"INFO\") -> None:\n    \"\"\"Configures the root logger with a console handler and specified level.\"\"\"\n    logging.basicConfig(\n        level=getattr(logging, level.upper(), logging.INFO),\n        format='%(asctime)s - %(name)s - %(levelname)s - %(message)s',\n        stream=sys.stdout\n    )\n```\n\n```python\n# src/fib_app/algorithms/base.py\n\"\"\"Base interface for Fibonacci number algorithms.\"\"\"\n\nfrom abc import ABC, abstractmethod\n\nclass FibonacciAlgorithm(ABC):\n    \"\"\"Abstract base class for Fibonacci number computation algorithms.\"\"\"\n    name: str\n\n    @abstractmethod\n    def compute(self, n: int) -> int:\n        \"\"\"Computes the n-th Fibonacci number. Assumes n is validated >= 1.\"\"\"\n        pass\n```\n\n```python\n# src/fib_app/algorithms/iterative.py\n\"\"\"Iterative algorithm for computing Fibonacci numbers.\"\"\"\n\nfrom .base import FibonacciAlgorithm\n\nclass IterativeAlgorithm(FibonacciAlgorithm):\n    \"\"\"An O(n) iterative algorithm for Fibonacci numbers.\"\"\"\n    name = \"iterative\"\n\n    def compute(self, n: int) -> int:\n        \"\"\"Computes the n-th Fibonacci number iteratively.\"\"\"\n        if n <= 2:\n            return 1\n        a, b = 1, 1\n        for _ in range(3, n + 1):\n            a, b = b, a + b\n        return b\n```\n\n```python\n# src/fib_app/algorithms/recursive_memo.py\n\"\"\"Recursive algorithm with memoization for Fibonacci numbers.\"\"\"\n\nfrom functools import lru_cache\nfrom .base import FibonacciAlgorithm\n\nclass RecursiveMemoAlgorithm(FibonacciAlgorithm):\n    \"\"\"A recursive algorithm for Fibonacci numbers using memoization.\"\"\"\n    name = \"memo\"\n\n    @lru_cache(maxsize=None) # Cache results of fib_recursive calls\n    def _fib_recursive(self, n: int) -> int:\n        \"\"\"Internal recursive helper for fibonacci computation.\"\"\"\n        if n <= 2:\n            return 1\n        return self._fib_recursive(n - 1) + self._fib_recursive(n - 2)\n\n    def compute(self, n: int) -> int:\n        \"\"\"Computes the n-th Fibonacci number using a memoized recursive approach.\"\"\"\n        return self._fib_recursive(n)\n```\n\n```python\n# src/fib_app/algorithms/matrix.py\n\"\"\"Matrix exponentiation algorithm for computing Fibonacci numbers.\"\"\"\n\nfrom .base import FibonacciAlgorithm\n\nclass MatrixExponentiationAlgorithm(FibonacciAlgorithm):\n    \"\"\"An O(log n) algorithm for Fibonacci numbers using matrix exponentiation.\"\"\"\n    name = \"matrix\"\n\n    def _matrix_multiply(self, A, B):\n        \"\"\"Helper to multiply two 2x2 matrices.\"\"\"\n        return (\n            (A[0][0]*B[0][0] + A[0][1]*B[1][0], A[0][0]*B[0][1] + A[0][1]*B[1][1]),\n            (A[1][0]*B[0][0] + A[1][1]*B[1][0], A[1][0]*B[0][1] + A[1][1]*B[1][1]),\n        )\n\n    def _matrix_power(self, matrix, power):\n        \"\"\"Helper to compute matrix to a given power using binary exponentiation.\"\"\"\n        result = ((1, 0), (0, 1)) # Identity matrix\n        base = matrix\n        while power > 0:\n            if power % 2 == 1:\n                result = self._matrix_multiply(result, base)\n            base = self._matrix_multiply(base, base)\n            power //= 2\n        return result\n\n    def compute(self, n: int) -> int:\n        \"\"\"Computes the n-th Fibonacci number using the matrix exponentiation method.\"\"\"\n        if n <= 2:\n            return 1\n        # The Fibonacci Q-matrix: ((1, 1), (1, 0))\n        # F_n is the top-left element of ((1, 1), (1, 0))^(n-1)\n        q_matrix = ((1, 1), (1, 0))\n        result_matrix = self._matrix_power(q_matrix, n - 1)\n        return result_matrix[0][0]\n```\n\n```python\n# src/fib_app/repository/base.py\n\"\"\"Base interface for cache repositories.\"\"\"\n\nfrom typing import Optional, Protocol\n\nclass CacheRepository(Protocol):\n    \"\"\"Protocol defining the interface for a cache repository.\"\"\"\n    def get(self, n: int) -> Optional[int]:\n        \"\"\"Retrieves a cached value for 'n', or None if not found.\"\"\"\n        ...\n\n    def set(self, n: int, value: int) -> None:\n        \"\"\"Stores a value in the cache for 'n'.\"\"\"\n        ...\n```\n\n```python\n# src/fib_app/repository/in_memory.py\n\"\"\"In-memory LRU cache repository implementation.\"\"\"\n\nfrom collections import OrderedDict\nfrom typing import Optional\nfrom .base import CacheRepository\n\nclass InMemoryCacheRepository(CacheRepository):\n    \"\"\"An in-memory LRU (Least Recently Used) cache repository.\"\"\"\n    def __init__(self, max_size: int = 1000) -> None:\n        self._store: OrderedDict[int, int] = OrderedDict()\n        self._max_size = max_size\n\n    def get(self, n: int) -> Optional[int]:\n        \"\"\"Retrieves a cached value for 'n', moving it to the front of LRU.\"\"\"\n        if n in self._store:\n            self._store.move_to_end(n)\n            return self._store[n]\n        return None\n\n    def set(self, n: int, value: int) -> None:\n        \"\"\"Stores a value in the cache, managing LRU eviction.\"\"\"\n        if n in self._store:\n            self._store.move_to_end(n)\n        self._store[n] = value\n        if len(self._store) > self._max_size:\n            self._store.popitem(last=False) # Remove LRU item\n```\n\n```python\n# src/fib_app/repository/redis_adapter.py\n\"\"\"Redis cache repository adapter (stub).\"\"\"\n\nfrom typing import Any, Optional\nfrom .base import CacheRepository\n\nclass RedisCacheRepository(CacheRepository):\n    \"\"\"A Redis-backed cache repository (stub implementation).\"\"\"\n    def __init__(self, client: Any) -> None:\n        self._client = client # Assume client is a redis.Redis instance\n\n    def get(self, n: int) -> Optional[int]:\n        \"\"\"Retrieves a cached value from Redis.\"\"\"\n        try:\n            value_str = self._client.get(f\"fib:{n}\")\n            if value_str:\n                return int(value_str)\n        except Exception as e:\n            # Log error, consider fallback or specific exception handling\n            pass\n        return None\n\n    def set(self, n: int, value: int) -> None:\n        \"\"\"Stores a value in Redis.\"\"\"\n        try:\n            self._client.set(f\"fib:{n}\", str(value))\n        except Exception as e:\n            # Log error, consider specific exception handling\n            pass\n```\n\n```python\n# src/fib_app/service.py\n\"\"\"Core Fibonacci computation service.\"\"\"\n\nimport logging\nfrom typing import Dict, Optional\nfrom .config import DEFAULT_ALGORITHM\nfrom .models import FibonacciResult\nfrom .exceptions import FibonacciError\nfrom .utils import validate_n, time_ms\nfrom .algorithms.base import FibonacciAlgorithm\nfrom .repository.base import CacheRepository\n\nlogger = logging.getLogger(__name__)\n\nclass FibonacciService:\n    \"\"\"Orchestrates Fibonacci number computation with validation, caching, and algorithm selection.\"\"\"\n    def __init__(self, repo: CacheRepository, algorithms: Dict[str, FibonacciAlgorithm], default_algorithm: str = DEFAULT_ALGORITHM) -> None:\n        self._repo = repo\n        self._algorithms = algorithms\n        self._default_algorithm = default_algorithm\n        logger.info(f\"FibonacciService initialized with default algorithm: {self._default_algorithm}\")\n        logger.info(f\"Available algorithms: {', '.join(self._algorithms.keys())}\")\n\n    def register_algorithm(self, name: str, algorithm: FibonacciAlgorithm) -> None:\n        \"\"\"Registers a new algorithm with the service.\"\"\"\n        self._algorithms[name] = algorithm\n        logger.info(f\"Algorithm '{name}' registered.\")\n\n    def compute(self, n: int, algorithm: Optional[str] = None) -> FibonacciResult:\n        \"\"\"Computes the n-th Fibonacci number, utilizing cache and selected algorithm.\"\"\"\n        n = validate_n(n) # FR1: Validate input\n        alg_name = algorithm or self._default_algorithm\n        \n        if alg_name not in self._algorithms:\n            raise FibonacciError(f\"Unknown algorithm: '{alg_name}'. Available: {', '.join(self._algorithms.keys())}\", code=400)\n\n        # FR1: Consult cache\n        try:\n            cached_value = self._repo.get(n)\n            if cached_value is not None:\n                logger.debug(f\"Cache hit for fib({n}) using {alg_name}\")\n                return FibonacciResult(n=n, value=cached_value, algorithm=alg_name, duration_ms=0.0)\n        except Exception as e:\n            logger.error(f\"Cache repository error for fib({n}): {e}\", exc_info=True)\n            # Decide on fallback or re-raise\n            raise FibonacciError(\"Internal cache error\", code=500) from e\n\n        logger.debug(f\"Cache miss for fib({n}), computing with {alg_name}\")\n        start_time = time_ms()\n        try:\n            value = self._algorithms[alg_name].compute(n)\n        except Exception as e:\n            logger.error(f\"Algorithm '{alg_name}' failed for fib({n}): {e}\", exc_info=True)\n            raise FibonacciError(f\"Computation error using algorithm '{alg_name}'\", code=500) from e\n        \n        end_time = time_ms()\n        duration_ms = end_time - start_time\n\n        # FR1: Store result in cache\n        try:\n            self._repo.set(n, value)\n        except Exception as e:\n            logger.warning(f\"Failed to store fib({n}) in cache: {e}\", exc_info=True)\n            # Do not re-raise, computation was successful\n\n        logger.info(f\"Computed fib({n}) = {value} using {alg_name} in {duration_ms:.2f}ms\")\n        return FibonacciResult(n=n, value=value, algorithm=alg_name, duration_ms=duration_ms)\n```\n\n```python\n# src/fib_app/controllers/cli.py\n\"\"\"CLI controller for the Fibonacci application.\"\"\"\n\nimport argparse\nimport sys\nimport logging\nfrom typing import List\n\nfrom ..service import FibonacciService\nfrom ..exceptions import FibonacciError\nfrom ..models import FibonacciResult\nfrom ..config import DEFAULT_ALGORITHM\nfrom ..logging_config import configure_logging\n\nlogger = logging.getLogger(__name__)\n\n# This will be initialized by the __init__.py upon package import.\n# Using a placeholder for now, actual instance creation is in __init__.py or app factory.\ndefault_service: Optional[FibonacciService] = None\n\ndef run_cli(argv: List[str]) -> int:\n    \"\"\"Entry point for the command-line interface.\"\"\"\n    configure_logging(\"INFO\")\n    \n    if default_service is None:\n        logger.error(\"FibonacciService not initialized for CLI.\")\n        print(\"Error: Fibonacci service not available. Exiting.\", file=sys.stderr)\n        return 1\n\n    parser = argparse.ArgumentParser(\n        prog=\"fib-cli\",\n        description=\"Compute Fibonacci numbers using different algorithms and caching.\"\n    )\n    subparsers = parser.add_subparsers(dest=\"command\", help=\"Available commands\")\n\n    # 'compute' command\n    compute_parser = subparsers.add_parser(\n        \"compute\",\n        help=\"Compute the n-th Fibonacci number.\"\n    )\n    compute_parser.add_argument(\n        \"n\",\n        type=int,\n        help=\"The 1-based index of the Fibonacci number to compute (n >= 1).\"\n    )\n    compute_parser.add_argument(\n        \"--algorithm\",\n        type=str,\n        default=DEFAULT_ALGORITHM,\n        choices=list(default_service._algorithms.keys()) if default_service else [], # Dynamically get choices\n        help=f\"Algorithm to use (default: {DEFAULT_ALGORITHM}).\"\n    )\n\n    args = parser.parse_args(argv)\n\n    if args.command == \"compute\":\n        try:\n            result: FibonacciResult = default_service.compute(args.n, args.algorithm)\n            print(f\"fib({result.n}) = {result.value} (algorithm={result.algorithm} duration={result.duration_ms:.2f}ms)\")\n            return 0\n        except FibonacciError as e:\n            logger.error(f\"CLI error: {e.message}\", exc_info=True)\n            print(f\"Error: {e.message}\", file=sys.stderr)\n            return e.code # Using error code for CLI exit status\n        except Exception as e:\n            logger.critical(f\"An unexpected CLI error occurred: {e}\", exc_info=True)\n            print(f\"An unexpected error occurred: {e}\", file=sys.stderr)\n            return 1 # General unexpected error\n    else:\n        parser.print_help(sys.stderr)\n        return 2 # Invalid command or missing arguments\n```\n\n```python\n# src/fib_app/controllers/http.py\n\"\"\"HTTP controller for the Fibonacci application using FastAPI.\"\"\"\n\nimport logging\nfrom typing import Optional\nfrom fastapi import FastAPI, HTTPException, Query\nfrom fastapi.responses import JSONResponse\n\nfrom ..service import FibonacciService\nfrom ..exceptions import FibonacciError\nfrom ..models import FibonacciResult\nfrom ..config import DEFAULT_ALGORITHM\n\nlogger = logging.getLogger(__name__)\n\ndef create_app(service: FibonacciService) -> FastAPI:\n    \"\"\"Creates and configures a FastAPI application for Fibonacci computations.\"\"\"\n    app = FastAPI(\n        title=\"Fibonacci API\",\n        description=\"A service to compute n-th Fibonacci numbers with various algorithms.\",\n        version=\"0.1.0\"\n    )\n\n    @app.get(\n        \"/fib\",\n        response_model=None, # Explicitly no response model for dynamic JSONResponse\n        summary=\"Compute n-th Fibonacci number\",\n        response_description=\"The computed Fibonacci number and metadata.\"\n    )\n    async def get_fib(\n        n: int = Query(..., description=\"The 1-based index of the Fibonacci number to compute (n >= 1).\", ge=1),\n        algorithm: Optional[str] = Query(None, description=f\"Algorithm to use (default: '{DEFAULT_ALGORITHM}'). Available: {', '.join(service._algorithms.keys())}\")\n    ) -> JSONResponse:\n        \"\"\"\n        Computes the n-th Fibonacci number using a specified or default algorithm.\n        Results are cached to improve performance for repeated requests.\n        \"\"\"\n        try:\n            result: FibonacciResult = service.compute(n, algorithm)\n            return JSONResponse(content=result.to_dict(), status_code=200)\n        except FibonacciError as e:\n            logger.warning(f\"HTTP request error: {e.message} for n={n}, alg={algorithm}\")\n            raise HTTPException(status_code=e.code, detail={\"error\": e.message})\n        except Exception as e:\n            logger.exception(f\"An unexpected server error occurred for n={n}, alg={algorithm}\")\n            raise HTTPException(status_code=500, detail={\"error\": \"Internal Server Error\"})\n    \n    return app\n```\n\n```python\n# src/fib_app/__init__.py\n\"\"\"Fibonacci application package. Exposes the public API and initializes components.\"\"\"\n\nimport logging\n\nfrom .config import DEFAULT_ALGORITHM, CACHE_MAX_SIZE\nfrom .exceptions import FibonacciError\nfrom .models import FibonacciResult\nfrom .algorithms.iterative import IterativeAlgorithm\nfrom .algorithms.recursive_memo import RecursiveMemoAlgorithm\nfrom .algorithms.matrix import MatrixExponentiationAlgorithm\nfrom .repository.in_memory import InMemoryCacheRepository\n# from .repository.redis_adapter import RedisCacheRepository # Uncomment to use Redis\nfrom .service import FibonacciService\nfrom .logging_config import configure_logging\nfrom .controllers import cli as cli_controller\nfrom .controllers import http as http_controller\n\n# Configure logging early\nconfigure_logging(\"INFO\")\nlogger = logging.getLogger(__name__)\n\n# Initialize repositories\nin_memory_repo = InMemoryCacheRepository(max_size=CACHE_MAX_SIZE)\n# Example of Redis repo (requires redis-py and a running Redis server)\n# try:\n#     import redis\n#     redis_client = redis.Redis(host='localhost', port=6379, db=0)\n#     redis_client.ping() # Test connection\n#     cache_repo = RedisCacheRepository(redis_client)\n#     logger.info(\"Using Redis cache repository.\")\n# except Exception:\n#     logger.warning(\"Could not connect to Redis, falling back to in-memory cache.\", exc_info=True)\ncache_repo = in_memory_repo # Default to in-memory\n\n# Initialize algorithms\nalgorithms = {\n    IterativeAlgorithm.name: IterativeAlgorithm(),\n    RecursiveMemoAlgorithm.name: RecursiveMemoAlgorithm(),\n    MatrixExponentiationAlgorithm.name: MatrixExponentiationAlgorithm(),\n}\n\n# Initialize the FibonacciService\nfib_service = FibonacciService(\n    repo=cache_repo,\n    algorithms=algorithms,\n    default_algorithm=DEFAULT_ALGORITHM\n)\n\n# Export public API from the package\n__all__ = [\"FibonacciService\", \"FibonacciError\", \"FibonacciResult\"]\n\n# Make the service available to controllers (especially CLI)\ncli_controller.default_service = fib_service\n\ndef get_http_app():\n    \"\"\"Returns the FastAPI application instance.\"\"\"\n    return http_controller.create_app(fib_service)\n\n# You can run the HTTP server directly for development\n# import uvicorn\n# if __name__ == \"__main__\":\n#     app = get_http_app()\n#     uvicorn.run(app, host=\"0.0.0.0\", port=8000)\n```\n\n```toml\n# pyproject.toml\n[tool.poetry]\nname = \"fib-app\"\nversion = \"0.1.0\"\ndescription = \"A reusable library and service to compute Fibonacci numbers.\"\nauthors = [\"Your Name <you@example.com>\"]\nreadme = \"README.md\"\npackages = [{include = \"fib_app\", from = \"src\"}]\n\n[tool.poetry.dependencies]\npython = \">=3.9,<4.0\"\nfastapi = \"^0.111.0\"\nuvicorn = {extras = [\"standard\"], version = \"^0.30.1\"}\n# redis = {version = \"^5.0.1\", optional = true} # Uncomment if using Redis\n\n[tool.poetry.group.dev.dependencies]\npytest = \"^8.2.1\"\nhttpx = \"^0.27.0\"\nflake8 = \"^7.1.0\"\nmypy = \"^1.10.0\"\n\n[build-system]\nrequires = [\"poetry-core\"]\nbuild-backend = \"poetry.core.masonry.api\"\n\n[tool.poetry.scripts]\nfib-cli = \"fib_app.controllers.cli:run_cli\"\n```\n\n```yaml\n# .github/workflows/ci.yml\nname: CI/CD Pipeline\n\non:\n  push:\n    branches: [ main ]\n  pull_request:\n    branches: [ main ]\n\njobs:\n  build:\n    runs-on: ubuntu-latest\n    strategy:\n      matrix:\n        python-version: [\"3.9\", \"3.10\", \"3.11\"]\n\n    steps:\n    - uses: actions/checkout@v4\n\n    - name: Set up Python ${{ matrix.python-version }}\n      uses: actions/setup-python@v5\n      with:\n        python-version: ${{ matrix.python-version }}\n        cache: 'poetry'\n\n    - name: Install dependencies\n      run: |\n        pip install poetry\n        poetry install --no-root --with dev # Install dev dependencies for testing\n        # If redis is optional and needs to be installed for tests:\n        # poetry install --no-root --with dev -E redis\n\n    - name: Run linting (flake8)\n      run: |\n        poetry run flake8 src/fib_app\n\n    - name: Run type checks (mypy)\n      run: |\n        poetry run mypy src/fib_app\n\n    - name: Run tests (pytest)\n      run: |\n        poetry run pytest tests/\n```\n\n```dockerfile\n# Dockerfile\n# Use a Python slim image for a smaller footprint\nFROM python:3.11-slim-bookworm\n\n# Set working directory\nWORKDIR /app\n\n# Copy pyproject.toml and poetry.lock to cache dependencies\nCOPY pyproject.toml poetry.lock ./\n\n# Install poetry\nRUN pip install poetry\n\n# Install dependencies\n# --no-dev: do not install development dependencies\n# --no-root: do not install the current package (will be installed later)\nRUN poetry install --no-dev --no-root --sync\n\n# Copy the rest of the application code\nCOPY src ./src\n\n# Expose the port FastAPI will run on\nEXPOSE 8000\n\n# Command to run the application using uvicorn\n# The command starts the HTTP server using the get_http_app factory\nCMD [\"uvicorn\", \"fib_app:get_http_app\", \"--host\", \"0.0.0.0\", \"--port\", \"8000\"]\n```\n\n```markdown\n# README.md\n# Fibonacci Number Calculator\n\nThis project provides a robust, reusable library and services for computing the n-th Fibonacci number. It supports multiple algorithms, caching, and offers both programmatic (Python API) and operational (CLI and HTTP API) interfaces.\n\n## Features\n\n-   **Multiple Algorithms**: Choose between iterative, recursive (memoized), and matrix exponentiation methods.\n-   **Caching**: Results are cached to avoid redundant computations.\n-   **Programmatic API**: A Python service for easy integration into other applications.\n-   **Command-Line Interface (CLI)**: A simple tool to compute Fibonacci numbers from your terminal.\n-   **HTTP API**: A lightweight REST endpoint for automated requests.\n-   **Maintainable & Testable**: Designed with SOLID principles, includes comprehensive tests.\n\n## Installation\n\n### Using Poetry (Recommended)\n\n1.  **Clone the repository**:\n    ```bash\n    git clone https://github.com/yourusername/fibonacci-app.git\n    cd fibonacci-app\n    ```\n2.  **Install Poetry**:\n    If you don't have Poetry installed, follow the instructions on their official website: [Poetry Installation](https://python-poetry.org/docs/#installation).\n3.  **Install dependencies**:\n    ```bash\n    poetry install --with dev\n    ```\n\n### Using pip (Basic)\n\n1.  **Clone the repository**:\n    ```bash\n    git clone https://github.com/yourusername/fibonacci-app.git\n    cd fibonacci-app\n    ```\n2.  **Install dependencies**:\n    ```bash\n    pip install -e .[dev] # For production: pip install -e .\n    ```\n\n## Usage\n\n### Python API\n\nYou can import and use the `FibonacciService` directly in your Python code:\n\n```python\nfrom fib_app import fib_service, FibonacciError, FibonacciResult\n\ntry:\n    # Compute using the default algorithm (matrix)\n    result: FibonacciResult = fib_service.compute(10)\n    print(f\"Fib(10) = {result.value} using {result.algorithm} in {result.duration_ms:.2f}ms\")\n\n    # Compute using a specific algorithm\n    result_iterative = fib_service.compute(20, algorithm=\"iterative\")\n    print(f\"Fib(20) = {result_iterative.value} using {result_iterative.algorithm} in {result_iterative.duration_ms:.2f}ms\")\n\n    # Trigger cache hit\n    cached_result = fib_service.compute(10)\n    print(f\"Cached Fib(10) = {cached_result.value} (duration: {cached_result.duration_ms:.2f}ms)\")\n\nexcept FibonacciError as e:\n    print(f\"An error occurred: {e.message}\")\n\n```\n\n### Command-Line Interface (CLI)\n\nUse the `fib-cli` command to compute Fibonacci numbers from your terminal:\n\n```bash\n# Compute fib(10) using the default algorithm (matrix)\nfib-cli compute 10\n\n# Compute fib(20) using the iterative algorithm\nfib-cli compute 20 --algorithm iterative\n\n# Compute fib(8) using the memoized recursive algorithm\nfib-cli compute 8 --algorithm memo\n\n# Get help\nfib-cli --help\nfib-cli compute --help\n```\n\n### HTTP API\n\nThe HTTP API is powered by FastAPI.\n\n1.  **Start the HTTP server**:\n    ```bash\n    # Using Poetry\n    poetry run uvicorn fib_app:get_http_app --host 0.0.0.0 --port 8000\n\n    # Using pip\n    uvicorn fib_app:get_http_app --host 0.0.0.0 --port 8000\n    ```\n2.  **Access the API**:\n    Once the server is running (typically on `http://127.0.0.1:8000` or `http://localhost:8000`), you can use tools like `curl` or your web browser.\n\n    -   **Compute fib(10) (default algorithm)**:\n        ```bash\n        curl \"http://localhost:8000/fib?n=10\"\n        # Expected output: {\"n\":10,\"value\":\"55\",\"algorithm\":\"matrix\",\"duration_ms\":...}\n        ```\n    -   **Compute fib(20) using the iterative algorithm**:\n        ```bash\n        curl \"http://localhost:8000/fib?n=20&algorithm=iterative\"\n        ```\n    -   **Invalid input**:\n        ```bash\n        curl \"http://localhost:8000/fib?n=0\"\n        # Expected output: {\"detail\":{\"error\":\"Input 'n' must be >= 1, got 0\"}}\n        ```\n    -   **Access API documentation**:\n        Open your browser to `http://localhost:8000/docs` for the interactive OpenAPI (Swagger UI) documentation.\n\n## Development and Testing\n\n### Running Tests\n\nTo run the unit and integration tests:\n\n```bash\npoetry run pytest tests/\n```\n\n### Linting and Type Checking\n\n```bash\npoetry run flake8 src/fib_app\npoetry run mypy src/fib_app\n```\n\n## Deployment with Docker\n\nYou can containerize the HTTP API service using Docker:\n\n1.  **Build the Docker image**:\n    ```bash\n    docker build -t fibonacci-api .\n    ```\n2.  **Run the Docker container**:\n    ```bash\n    docker run -p 8000:8000 fibonacci-api\n    ```\n    The API will then be accessible on `http://localhost:8000`.\n\n## Configuration\n\nConfiguration values are defined in `src/fib_app/config.py`. Key settings include:\n\n-   `DEFAULT_ALGORITHM`: The algorithm used when not explicitly specified.\n-   `CACHE_MAX_SIZE`: Maximum number of entries in the in-memory LRU cache.\n-   `HTTP_HOST`, `HTTP_PORT`: For the FastAPI server.\n\nFor production deployments, consider overriding these via environment variables if using a framework like FastAPI that supports it, or by modifying the `config.py` as part of your build process.\n```"}
