{"task_id": "HumanEval/14", "solution": "```python\n# src/prefixes_app/__init__.py\n# Package exports and convenience function\nfrom .prefix_service import PrefixService\nfrom .exceptions import InvalidInputError\n\n__version__ = \"0.1.0\"\n\ndef all_prefixes(string: str) -> list:\n    \"\"\"Convenience function to get all prefixes of a string.\"\"\"\n    return PrefixService().all_prefixes(string)\n\n```\n```python\n# src/prefixes_app/prefix_service.py\n# Business logic: PrefixService.all_prefixes(string: str) -> List[str]\nfrom typing import List\nfrom .validators import StringValidator\nfrom .models import PrefixResult\nfrom .exceptions import InvalidInputError\n\nclass PrefixService:\n    \"\"\"Service to compute prefixes of a string.\"\"\"\n    def all_prefixes(self, string: str) -> List[str]:\n        \"\"\"Return a list of prefixes from shortest to longest.\"\"\"\n        StringValidator.validate_non_empty_str(string)\n        # list comprehension: prefixes from 1 to len(string)\n        return [string[:i] for i in range(1, len(string) + 1)]\n\n    def all_prefixes_with_result(self, string: str) -> PrefixResult:\n        \"\"\"Same as all_prefixes but returns a PrefixResult object.\"\"\"\n        prefixes = self.all_prefixes(string)\n        return PrefixResult(original=string, prefixes=prefixes)\n\n```\n```python\n# src/prefixes_app/validators.py\n# Validation logic: StringValidator.validate_non_empty_str(value: Any) -> None\nfrom typing import Any\nfrom .exceptions import InvalidInputError\n\nclass StringValidator:\n    \"\"\"Input validation utilities.\"\"\"\n    @staticmethod\n    def validate_non_empty_str(value: Any) -> None:\n        \"\"\"Ensure value is a str and not empty.\"\"\"\n        if not isinstance(value, str):\n            raise InvalidInputError(\"Value must be a str\")\n        if value == \"\":\n            raise InvalidInputError(\"Empty string is not allowed\")\n\n```\n```python\n# src/prefixes_app/models.py\n# Data models: PrefixResult(prefixes: List[str], original: str)\nfrom typing import List, Dict, Any\nfrom dataclasses import dataclass\n\n@dataclass\nclass PrefixResult:\n    \"\"\"Data container for prefix computation results.\"\"\"\n    original: str\n    prefixes: List[str]\n\n    def count(self) -> int:\n        \"\"\"Returns the number of prefixes.\"\"\"\n        return len(self.prefixes)\n\n    def to_dict(self) -> Dict[str, Any]:\n        \"\"\"Returns a serializable dictionary representation.\"\"\"\n        return {\"original\": self.original, \"prefixes\": self.prefixes}\n\n```\n```python\n# src/prefixes_app/exceptions.py\n# Custom exceptions: InvalidInputError(message: str)\nclass InvalidInputError(ValueError):\n    \"\"\"Custom exception for invalid input.\"\"\"\n    def __init__(self, message: str):\n        self.message = message\n        super().__init__(message)\n\n    def __str__(self) -> str:\n        \"\"\"Returns the error message.\"\"\"\n        return self.message\n\n```\n```python\n# src/prefixes_app/repository.py\n# Optional persistence: PrefixRepository.save_to_json(result: PrefixResult, path: str) -> None, load_from_json(path: str) -> PrefixResult\nimport json\nfrom typing import Dict\nfrom .models import PrefixResult\nfrom .exceptions import InvalidInputError\n\nclass PrefixRepository:\n    \"\"\"Optional file-based persistence for PrefixResult objects.\"\"\"\n    def save_to_json(self, result: PrefixResult, path: str) -> None:\n        \"\"\"Serialize PrefixResult to JSON and write to file.\"\"\"\n        with open(path, \"w\", encoding=\"utf-8\") as f:\n            json.dump(result.to_dict(), f, ensure_ascii=False, indent=2)\n\n    def load_from_json(self, path: str) -> PrefixResult:\n        \"\"\"Read JSON file, validate shape, and return PrefixResult.\"\"\"\n        try:\n            with open(path, \"r\", encoding=\"utf-8\") as f:\n                data: Dict = json.load(f)\n        except FileNotFoundError:\n            raise InvalidInputError(f\"File not found: {path}\")\n        except json.JSONDecodeError:\n            raise InvalidInputError(f\"Invalid JSON format in file: {path}\")\n\n        if not isinstance(data, dict) or \"original\" not in data or \"prefixes\" not in data:\n            raise InvalidInputError(\"Invalid saved prefix result format: missing 'original' or 'prefixes' keys.\")\n        if not isinstance(data[\"original\"], str) or not isinstance(data[\"prefixes\"], list):\n            raise InvalidInputError(\"Invalid saved prefix result format: 'original' or 'prefixes' have wrong types.\")\n\n        return PrefixResult(original=data[\"original\"], prefixes=list(data[\"prefixes\"]))\n\n```\n```python\n# src/prefixes_app/cli.py\n# CLI adapter: PrefixCLI(service: PrefixService, out: TextIO, err: TextIO).run(argv: List[str]) -> int\nimport sys\nimport argparse\nfrom typing import List, TextIO\nfrom .prefix_service import PrefixService\nfrom .exceptions import InvalidInputError\n\nclass PrefixCLI:\n    \"\"\"CLI adapter for the prefix generation utility.\"\"\"\n    def __init__(self, service: PrefixService = None, out: TextIO = None, err: TextIO = None):\n        self.service = service or PrefixService()\n        self.out = out or sys.stdout\n        self.err = err or sys.stderr\n\n    def run(self, argv: List[str]) -> int:\n        \"\"\"Entry point for the CLI, parses args and handles I/O.\"\"\"\n        parser = argparse.ArgumentParser(\n            description=\"Compute all prefixes of a given string.\",\n            prog=\"prefixes-app\"\n        )\n        parser.add_argument(\n            \"string\",\n            type=str,\n            help=\"The input string to compute prefixes for.\"\n        )\n\n        try:\n            # parse_args expects sys.argv[1:] by default, so we pass argv directly\n            args = parser.parse_args(argv)\n            \n            prefixes = self.service.all_prefixes(args.string)\n            self._print_prefixes(prefixes)\n            return 0\n        except InvalidInputError as e:\n            print(f\"Error: {e}\", file=self.err)\n            return 2\n        except Exception as e:\n            print(f\"Unexpected error: {e}\", file=self.err)\n            return 1\n\n    def _print_prefixes(self, prefixes: List[str]) -> None:\n        \"\"\"Prints each prefix to the output stream, one per line.\"\"\"\n        for p in prefixes:\n            print(p, file=self.out)\n\ndef main():\n    \"\"\"Main function for the prefixes-app CLI entry point.\"\"\"\n    cli = PrefixCLI()\n    sys.exit(cli.run(sys.argv[1:]))\n\n```\n```python\n# pyproject.toml\n# Build metadata, entry points\n[project]\nname = \"prefixes_app\"\nversion = \"0.1.0\"\ndescription = \"A utility to compute all prefixes of a given string.\"\nauthors = [{ name = \"Your Name\", email = \"your.email@example.com\" }]\nreadme = \"README.md\"\nrequires-python = \">=3.8\"\nlicense = { text = \"MIT\" }\nkeywords = [\"prefixes\", \"string\", \"utility\", \"cli\"]\nclassifiers = [\n    \"Development Status :: 3 - Alpha\",\n    \"Intended Audience :: Developers\",\n    \"License :: OSI Approved :: MIT License\",\n    \"Programming Language :: Python :: 3\",\n    \"Programming Language :: Python :: 3.8\",\n    \"Programming Language :: Python :: 3.9\",\n    \"Programming Language :: Python :: 3.10\",\n    \"Programming Language :: Python :: 3.11\",\n    \"Programming Language :: Python :: 3.12\",\n    \"Operating System :: OS Independent\",\n]\ndependencies = []\n\n[project.scripts]\nprefixes-app = \"prefixes_app.cli:main\"\n\n[project.urls]\nHomepage = \"https://github.com/your-org/prefixes-app\"\nDocumentation = \"https://github.com/your-org/prefixes-app#readme\"\nRepository = \"https://github.com/your-org/prefixes-app\"\n\"Bug Tracker\" = \"https://github.com/your-org/prefixes-app/issues\"\n\n[tool.setuptools.packages.find]\nwhere = [\"src\"]\n\n[build-system]\nrequires = [\"setuptools>=61.0\"]\nbuild-backend = \"setuptools.build_meta\"\n\n[tool.pytest.ini_options]\nmin_version = \"6.0\"\naddopts = \"--strict-markers --import-mode=importlib\"\ntestpaths = \"tests\"\n\n```\n```python\n# requirements.txt\n# Dev dependencies (pytest)\npytest>=6.0\n```\n```python\n# README.md\n# Usage and examples\n# prefixes_app\n\nA small, well-tested Python utility to compute all prefixes of a given string (shortest to longest).\nIt provides both a library API and a command-line interface (CLI) for quick usage.\n\n## Features\n\n-   **Library API**: Easily integrate prefix generation into your Python applications.\n-   **CLI Tool**: Use `prefixes-app` directly from your shell.\n-   **Input Validation**: Fails fast with clear error messages for invalid inputs.\n-   **Test Coverage**: Includes unit tests for core logic and CLI behavior.\n-   **Packaging**: Pip-installable package with `pyproject.toml`.\n\n## Installation\n\nYou can install `prefixes_app` using pip:\n\n```bash\npip install prefixes_app\n```\n\nAlternatively, if you want to install from source for development:\n\n```bash\ngit clone https://github.com/your-org/prefixes-app.git\ncd prefixes-app\npip install .\n# For development dependencies\npip install -r requirements.txt\n```\n\n## Usage\n\n### Library API\n\nYou can import and use the `all_prefixes` function in your Python code:\n\n```python\nfrom prefixes_app import all_prefixes, InvalidInputError\nfrom prefixes_app.prefix_service import PrefixService, PrefixResult\nfrom prefixes_app.repository import PrefixRepository\n\n# Using the top-level convenience function\ntry:\n    my_string = \"hello\"\n    prefixes = all_prefixes(my_string)\n    print(f\"Prefixes of '{my_string}': {prefixes}\")\n    # Expected output: Prefixes of 'hello': ['h', 'he', 'hel', 'hell', 'hello']\n\n    invalid_string = \"\"\n    all_prefixes(invalid_string) # This will raise InvalidInputError\nexcept InvalidInputError as e:\n    print(f\"Caught an error: {e}\")\n\n# Using the PrefixService directly\nservice = PrefixService()\nresult: PrefixResult = service.all_prefixes_with_result(\"world\")\nprint(f\"Original: {result.original}, Count: {result.count()}, Prefixes: {result.prefixes}\")\n\n# Using the PrefixRepository (optional persistence)\nrepo = PrefixRepository()\ntry:\n    repo.save_to_json(result, \"world_prefixes.json\")\n    print(\"Prefixes saved to world_prefixes.json\")\n\n    loaded_result = repo.load_from_json(\"world_prefixes.json\")\n    print(f\"Loaded prefixes for '{loaded_result.original}': {loaded_result.prefixes}\")\nexcept InvalidInputError as e:\n    print(f\"Repository error: {e}\")\nexcept Exception as e:\n    print(f\"An unexpected error occurred with repository: {e}\")\n\n```\n\n### Command-Line Interface (CLI)\n\nThe `prefixes-app` command is available after installation.\n\n```bash\n# Get prefixes for a string\nprefixes-app \"example\"\n# Output:\n# e\n# ex\n# exa\n# exam\n# examp\n# exampl\n# example\n\n# Handles empty string input (invalid)\nprefixes-app \"\"\n# Output to stderr:\n# Error: Empty string is not allowed\n# Exits with code 2\n\n# Handles missing argument\nprefixes-app\n# Output to stderr:\n# usage: prefixes-app [-h] string\n# prefixes-app: error: the following arguments are required: string\n# Exits with code 2\n```\n\n## Development\n\n### Setup\n\n```bash\ngit clone https://github.com/your-org/prefixes-app.git\ncd prefixes-app\npython -m venv .venv\nsource .venv/bin/activate\npip install -e . # Install in editable mode\npip install -r requirements.txt # Install dev dependencies like pytest\n```\n\n### Running Tests\n\n```bash\npytest\n```\n\n## Contributing\n\nContributions are welcome! Please open an issue or submit a pull request.\n\n## License\n\nThis project is licensed under the MIT License - see the LICENSE file for details.\n```\n```yaml\n# .github/workflows/ci.yml\n# CI: runs tests on push/PR\nname: CI\n\non:\n  push:\n    branches:\n      - main\n      - develop\n    paths:\n      - 'src/**'\n      - 'tests/**'\n      - 'pyproject.toml'\n      - 'requirements.txt'\n      - '.github/workflows/ci.yml'\n  pull_request:\n    branches:\n      - main\n      - develop\n    paths:\n      - 'src/**'\n      - 'tests/**'\n      - 'pyproject.toml'\n      - 'requirements.txt'\n      - '.github/workflows/ci.yml'\n\njobs:\n  build:\n    runs-on: ubuntu-latest\n    strategy:\n      matrix:\n        python-version: [\"3.8\", \"3.9\", \"3.10\", \"3.11\", \"3.12\"]\n\n    steps:\n    - uses: actions/checkout@v4\n\n    - name: Set up Python ${{ matrix.python-version }}\n      uses: actions/setup-python@v5\n      with:\n        python-version: ${{ matrix.python-version }}\n\n    - name: Install dependencies\n      run: |\n        python -m pip install --upgrade pip\n        pip install -e .\n        pip install -r requirements.txt\n\n    - name: Run tests with pytest\n      run: |\n        pytest\n```"}
