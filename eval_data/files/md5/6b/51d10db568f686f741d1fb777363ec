{"task_id": "HumanEval/44", "solution": "def change_base(x: int, base: int):\n    \"\"\"Change numerical base of input number x to base, returning its string representation.\n    The target base must be an integer less than 10.\n    >>> change_base(8, 3)\n    '22'\n    >>> change_base(8, 2)\n    '1000'\n    >>> change_base(7, 2)\n    '111'\n    \"\"\"\n    if x == 0:\n        return \"0\"\n    \n    digits = []\n    n = x\n    while n > 0:\n        digits.append(str(n % base))\n        n //= base\n        \n    return \"\".join(reversed(digits))"}
{"task_id": "HumanEval/44", "solution": "def change_base(x: int, base: int) -> str:\n    \"\"\"Change numerical base of input number x to base.\n    Returns string representation after the conversion.\n    \"\"\"\n    if x == 0:\n        return \"0\"\n\n    digits_chars = \"012345678\"\n    converted_digits = []\n    while x > 0:\n        remainder = x % base\n        converted_digits.append(digits_chars[remainder])\n        x //= base\n\n    return \"\".join(reversed(converted_digits))"}
