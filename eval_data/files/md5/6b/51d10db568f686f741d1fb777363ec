tion handling of unexpected exceptions.\"\"\"\n    class EvilService:\n        def compute(self, a, b):\n            raise ValueError(\"Something went terribly wrong internally!\")\n\n    with patch('gcd_app.services.gcd_service.GCDService', return_value=EvilService()):\n        with patch('sys.stdout', new=StringIO()) as mock_stdout:\n            with patch('sys.stderr', new=StringIO()) as mock_stderr:\n                exit_code = main([\"10\", \"20\"])\n                assert exit_code == 1 # Generic error\n                assert \"An unhandled error occurred\" in mock_stderr.getvalue()\n                assert \"Something went terribly wrong internally!\" in mock_stderr.getvalue()\n```\n\n```python\n# tests/test_api.py\nimport pytest\nfrom fastapi.testclient import TestClient\nfrom unittest.mock import patch, MagicMock\n\nfrom gcd_app.controllers.api import APIController\nfrom gcd_app.services.gcd_service import GCDService\nfrom gcd_app.exceptions import InvalidInputError, ComputationError\nfrom gcd_app.config import MAX_INPUT_BITS\n\n# Fixture for a GCDService instance\n@pytest.fixture\ndef gcd_service_instance():\n    return GCDService(max_bits=MAX_INPUT_BITS)\n\n# Fixture for the FastAPI TestClient\n@pytest.fixture\ndef client(gcd_service_instance):\n    api_controller = APIController(gcd_service=gcd_service_instance)\n    app = api_controller.create_app()\n    return TestClient(app)\n\n# Test cases for GET /gcd\n@pytest.mark.parametrize(\"a,b,expected_gcd\", [\n    (\"25\", \"15\", 5),\n    (\"-6\", \"9\", 3),\n    (\"0\", \"0\", 0),\n    (\"1\", \"1\", 1),\n    (\"0\", \"100\", 100),\n    (\"0x1A\", \"0x0A\", 2), # Hex inputs\n])\ndef test_get_gcd_success(client, a, b, expected_gcd):\n    \"\"\"Test successful GET /gcd requests with various valid inputs.\"\"\"\n    response = client.get(f\"/gcd?a={a}&b={b}\")\n    assert response.status_code == 200\n    assert response.json() == {\"gcd\": expected_gcd}\n\n# Test cases for POST /gcd\n@pytest.mark.parametrize(\