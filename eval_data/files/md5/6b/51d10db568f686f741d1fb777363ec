{"task_id": "HumanEval/74", "solution": "```python\ndef total_match(lst1, lst2):\n    '''\n    Write a function that accepts two lists of strings and returns the list that has\n    total number of chars in the all strings of the list less than the other list.\n    if the two lists have the same number of chars, return the first list.\n    '''\n    sum_lst1 = sum(len(s) for s in lst1)\n    sum_lst2 = sum(len(s) for s in lst2)\n\n    if sum_lst1 <= sum_lst2:\n        return lst1\n    else:\n        return lst2\n```"}
{"task_id": "HumanEval/75", "solution": "def _prime_factors(n: int) -> list[int]:\n    \"\"\"Finds all prime factors of a number, including multiplicity.\n    Assumes n >= 2.\n    \"\"\"\n    factors = []\n    d = 2\n    temp_n = n\n    while d * d <= temp_n:\n        while temp_n % d == 0:\n            factors.append(d)\n            temp_n //= d\n        d += 1 if d == 2 else 2\n    if temp_n > 1:\n        factors.append(temp_n)\n    return factors\n\ndef is_multiply_prime(a):\n    \"\"\"Checks if a number is the product of exactly three prime numbers (with multiplicity).\n    Assumes `a` is an integer where 2 <= `a` < 100.\n    \"\"\"\n    factors = _prime_factors(a)\n    return len(factors) == 3"}
{"task_id": "HumanEval/75", "solution": "def _factorize(n):\n    \"\"\"Finds all prime factors of a number.\n    Uses trial division to decompose the number into its prime components.\n    \"\"\"\n    factors = []\n    d = 2\n    temp_n = n\n    while d * d <= temp_n:\n        while temp_n % d == 0:\n            factors.append(d)\n            temp_n //= d\n        d += 1\n    if temp_n > 1:\n        factors.append(temp_n)\n    return factors\n\ndef is_multiply_prime(a):\n    \"\"\"Checks if a number is the product of exactly three prime numbers.\n    Primes may repeat, and 'a' is assumed to be an integer less than 100.\n    \"\"\"\n    factors = _factorize(a)\n    return len(factors) == 3"}
{"task_id": "HumanEval/76", "solution": "def is_simple_power(x, n):\n    \"\"\"Checks if x is a simple power of n (x == n**k for integer k >= 0).\"\"\"\n    # Handle the base case: 1 is n**0 for any valid n (typically n >= 1).\n    if x == 1:\n        return True\n    \n    # If n is 1, then 1**k is always 1. Since x is not 1 at this point,\n    # it cannot be a power of 1.\n    if n == 1:\n        return False\n    \n    # For x > 1 and n > 1, repeatedly divide x by n.\n    # If x is a power of n, it should eventually reduce to 1 by exact divisions.\n    current_x = x\n    while current_x > 1:\n        if current_x % n != 0:\n            return False  # Not an exact divisor\n        current_x //= n\n            \n    # If the loop completes, current_x must be 1, meaning x was an exact power of n.\n    return True"}
{"task_id": "HumanEval/77", "solution": "def iscube(a):\n    '''\n    Checks if an integer is a perfect cube using float approximation and neighbor checks.\n    Assumes valid integer input as per critical requirements.\n    '''\n    if a == 0:\n        return True\n\n    abs_a = abs(a)\n\n    # Calculate the approximate integer cube root using floating-point math.\n    # This is O(1) arithmetic operation.\n    root_candidate = round(abs_a ** (1/3))\n\n    # Check candidates for the true integer cube root to account for floating-point inaccuracies.\n    # The true integer cube root must be one of these near the float approximation.\n    for n in range(int(root_candidate) - 1, int(root_candidate) + 2):\n        if n < 0:\n            continue\n        if n * n * n == abs_a:\n            return True\n\n    return False"}
{"task_id": "HumanEval/76", "solution": "def is_simple_power(x, n):\n    \"\"\"Checks if x is an exact integer power of n.\n    Returns True if n**k == x for some non-negative integer k, False otherwise.\"\"\"\n\n    # Handle special cases for x and n.\n    # 1. If x is 1: Any base to the power of 0 is 1.\n    if x == 1:\n        return True\n\n    # 2. If n is 0 (and x is not 1): 0 to any positive power is 0.\n    if n == 0:\n        return x == 0\n\n    # 3. If n is 1 (and x is not 1): 1 to any power is 1.\n    if n == 1:\n        return False\n\n    # 4. If n is -1 (and x is not 1): (-1)^k is 1 or -1. Since x is not 1, x must be -1.\n    if n == -1:\n        return x == -1\n\n    # 5. If x is 0 (and not handled above, so n is not 0, 1, -1): No integer power of n (n!=0) can be 0.\n    if x == 0:\n        return False\n\n    # General case: x != 0, 1 and n != 0, 1, -1.\n    # Repeatedly divide x by n. If it's a simple power, x will eventually become 1.\n    if x % n != 0:\n        return False\n\n    current_x = x\n    while current_x % n == 0:\n        current_x //= n\n    \n    # If x was a simple power of n, current_x should be 1 after all divisions.\n    return current_x == 1"}
{"task_id": "HumanEval/77", "solution": "def iscube(a):\n    \"\"\"\n    Checks if an integer `a` is a perfect cube.\n    Returns True if `a = k^3` for some integer `k`, otherwise False.\n    \"\"\"\n\n    # Determine if the number is negative and work with its absolute value for the root calculation.\n    is_negative = False\n    if a < 0:\n        is_negative = True\n        n = -a\n    else:\n        n = a\n\n    # Perform binary search to find the integer cube root of `n` (which is abs(a)).\n    # The search range is from 0 up to `n` itself (or 1 if `n` is 0).\n    lo, hi = 0, max(1, n)\n    while lo <= hi:\n        mid = (lo + hi) // 2\n        cube = mid * mid * mid\n        if cube == n:\n            # If an exact integer cube root `mid` is found for `n`.\n            # Determine the final root value based on the original sign of `a`.\n            root_val = mid if not is_negative else -mid\n            # Verify the cube of this root against the original number `a`.\n            return root_val * root_val * root_val == a\n        if cube < n:\n            lo = mid + 1\n        else:\n            hi = mid - 1\n    \n    # If the binary search completes without finding an exact `mid` such that `mid^3 == n`,\n    # then `hi` will hold the floor of the cube root of `n`.\n    # Determine the final root value based on the original sign of `a`.\n    root_val = hi if not is_negative else -hi\n    # Verify if the cube of this `root_val` (floor or ceiling depending on precision)\n    # equals the original number `a`. This handles cases where `a` is not a perfect cube.\n    return root_val * root_val * root_val == a"}
