 test_initialize_twice_no_error(self, repository: StringRepository):\n        \"\"\"Test that calling initialize() multiple times does not raise an error.\"\"\"\n        # Already initialized by fixture\n        repository.initialize() # Should not fail\n        # No assert needed, passing implies no exception\n\n    def test_save_query_success(self, repository: StringRepository):\n        \"\"\"Test that save_query successfully inserts a record and returns an ID.\"\"\"\n        input_str = \"test string\"\n        substring = \"test\"\n        count = 1\n        record_id = repository.save_query(input_str, substring, count)\n\n        assert isinstance(record_id, int)\n        assert record_id > 0\n\n        # Verify the record was inserted\n        conn = sqlite3.connect(repository._db_path)\n        conn.row_factory = sqlite3.Row\n        cursor = conn.cursor()\n        cursor.execute(\"SELECT * FROM queries WHERE id = ?\", (record_id,))\n        record = cursor.fetchone()\n        conn.close()\n\n        assert record is not None\n        assert record[\"id\"] == record_id\n        assert record[\"input_string\"] == input_str\n        assert record[\"substring\"] == substring\n        assert record[\"count\"] == count\n        assert record[\"created_at\"] is not None\n\n    def test_save_query_raises_repository_error_on_db_failure(self, db_path: str, monkeypatch):\n        \"\"\"Test that save_query raises RepositoryError on underlying DB failure.\"\"\"\n        repo = StringRepository(db_path)\n        # Mock sqlite3.connect to raise an error\n        def mock_connect(*args, **kwargs):\n            raise sqlite3.Error(\"Mock DB error\")\n        monkeypatch.setattr(sqlite3, 'connect', mock_connect)\n\n        with pytest.raises(RepositoryError, match=\"Failed to save query\"):\n            repo.save_query(\"a\", \"b\", 0)\n\n    def test_get_query_success(self, repository: StringRepository):\n        \"\"\"Test that get_query retrieves an existing record.\"\"\"\n        input_str = \"apple pie\"\n        substring = \"p\"\n        count = 2\n        record_id = repository.save_query(input_str, substring, count)\n\n        retrieved_record = repository.get_query(record_id)\n\n        assert retrieved_record is not None\n        assert retrieved_record[\"id\"] == record_id\n        assert retrieved_record[\"input_string\"] == input_str\n        assert retrieved_record[\"substring\"] == substring\n        assert retrieved_record[\"count\"] == count\n        assert \"created_at\" in retrieved_record\n\n    def test_get_query_not_found(self, repository: StringRepository):\n        \"\"\"Test that get_query returns None for a non-existent ID.\"\"\"\n        retrieved_record = repository.get_query(9999) # Assuming 9999 does not exist\n        assert retrieved_record is None\n\n    def test_get_query_raises_repository_error_on_db_failure(self, db_path: str, monkeypatch):\n        \"\"\"Test that get_query raises RepositoryError on underlying DB failure.\"\"\"\n        repo = StringRepository(db_path)\n        # Mock sqlite3.connect to raise an error\n        def mock_connect(*args, **kwargs):\n            raise sqlite3.Error(\"Mock DB error\")\n        monkeypatch.setattr(sqlite3, 'connect', mock_connect)\n\n        with pytest.raises(RepositoryError, match=\"Failed to retrieve query\"):\n            repo.get_query(1)\n```\n\n```python\n# tests/test_cli.py\n\"\"\"\nIntegration tests for the CLI controller and script entry point.\n\"\"\"\n\nimport pytest\nimport sys\nfrom unittest.mock import patch, MagicMock\nfrom io import StringIO\nfrom pathlib import Path\nfrom src.substring_counter.controllers_cli import CLIController\nfrom src.substring_counter.service import CounterService\nfrom src.substring_counter.repository import StringRepository\nfrom src.substring_counter.errors import InvalidInputError, RepositoryError\nfrom src.substring_counter.dto import QueryResult\nfrom scripts.cli import main as cli_main # Import the actual main function\n\n@pytest.fixture\ndef mock_service() -> MagicMock:\n    \"\"\"Provides a mock CounterService instance.\"\"\"\n    service = MagicMock(spec=CounterService)\n    # Default return value for successful count and persist\n    service.validate_and_count.return_value = QueryResult(id=1, count=3)\n    service.count.return_value = 3 # For non-persisted calls if used\n    return service\n\n@pytest.fixture\ndef cli_controller(mock_service: MagicMock) -> CLIController:\n    \"\"\"Provides a CLIController instance with a mocked service.\"\"\"\n    return CLIController(mock_service)\n\nclass TestCLIController:\n    def test_run_success_args(self, cli_controller: CLIController, mock_service: MagicMock, capsys):\n        \"\"\"Test CLI with string and substring arguments (persisted).\"\"\"\n        args = [\"--string\", \"aaaa\", \"--substring\", \"aa\"]\n        exit_code = cli_controller.run(args)\n\n        assert exit_code == 0\n        mock_service.validate_and_count.assert_called_once_with(\"aaaa\", \"aa\", persist=True)\n        captured = capsys.readouterr()\n        assert \"Count: 3, Record ID: 1\" in captured.out\n        assert not captured.err\n\n    def test_run_success_args_no_persist(self, cli_controller: CLIController, mock_service: MagicMock, capsys):\n        \"\"\"Test CLI with string and substring arguments (non-persisted).\"\"\"\n        mock_service.validate_and_count.return_value = QueryResult(id=None, count=3) # ID is None if not persisted\n        args = [\"--string\", \"aaaa\", \"--substring\", \"aa\", \"--no-persist\"]\n        exit_code = cli_controller.run(args)\n\n        assert exit_code == 0\n        mock_service.validate_and_count.assert_called_once_with(\"aaaa\", \"aa\", persist=False)\n        captured = capsys.readouterr()\n        assert \"Count: 3\" in captured.out\n        assert \"Record ID\" not in captured.out\n        assert not captured.err\n\n    def test_run_success_stdin(self, cli_controller: CLIController, mock_service: MagicMock, capsys, monkeypatch):\n        \"\"\"Test CLI reading string from stdin.\"\"\"\n        mock_service.validate_and_count.return_value = QueryResult(id=2, count=2)\n        mock_stdin = StringIO(\"banana\")\n        monkeypatch.setattr(sys, 'stdin', mock_stdin)\n\n        args = [\"--substring\", \"ana\", \"--stdin\"]\n        exit_code = cli_controller.run(args)\n\n        assert exit_code == 0\n        mock_service.validate_and_count.assert_called_once_with(\"banana\", \"ana\", persist=True)\n        captured = capsys.readouterr()\n        assert \"Count: 2, Record ID: 2\" in captured.out\n        assert not captured.err\n\n    def test_run_success_stdin_hyphen(self, cli_controller: CLIController, mock_service: MagicMock, capsys, monkeypatch):\n        \"\"\"Test CLI reading string from stdin using '-' argument.\"\"\"\n        mock_service.validate_and_count.return_value = QueryResult(id=3, count=2)\n        mock_stdin = StringIO(\"banana\")\n        monkeypatch.setattr(sys, 'stdin', mock_stdin)\n\n        args = [\"--string\", \"-\", \"--substring\", \"ana\"]\n        exit_code = cli_controller.run(args)\n\n        assert exit_code == 0\n        mock_service.validate_and_count.assert_called_once_with(\"banana\", \"ana\", persist=True)\n        captured = capsys.readouterr()\n        assert \"Count: 2, Record ID: 3\" in captured.out\n        assert not captured.err\n\n    def test_run_invalid_input_error(self, cli_controller: CLIController, mock_service: MagicMock, capsys):\n        \"\"\"Test CLI handles InvalidInputError from service.\"\"\"\n        mock_service.validate_and_count.side_effect = InvalidInputError(\"substring must be non-empty\")\n        args = [\"--string\", \"test\", \"--substring\", \"\"]\n        exit_code = cli_controller.run(args)\n\n        assert exit_code == 2\n        captured = capsys.readouterr()\n        assert \"Error: substring must be non-empty\" in captured.err\n        assert not captured.out\n\n    def test_run_repository_error(self, cli_controller: CLIController, mock_service: MagicMock, capsys):\n        \"\"\"Test CLI handles RepositoryError from service.\"\"\"\n        mock_service.validate_and_count.side_effect = RepositoryError(\"Failed saving query record\")\n        args = [\"--string\", \"test\", \"--substring\", \"t\"]\n        exit_code = cli_controller.run(args)\n\n        assert exit_code == 1\n        captured = capsys.readouterr()\n        assert \"Database error: Failed saving query record\" in captured.err\n        assert not captured.out\n\n    def test_run_missing_string_arg(self, cli_controller: CLIController, capsys):\n        \"\"\"Test CLI exits with error if --string/--stdin is missing.\"\"\"\n        args = [\"--substring\", \"a\"]\n        exit_code = cli_controller.run(args)\n\n        assert exit_code == 2\n        captured = capsys.readouterr()\n        assert \"Error: --string or --stdin must be provided.\" in captured.err\n        assert \"usage: substring-counter\" in captured.err # Argparse help message\n        assert not captured.out\n\n    def test_run_string_and_stdin_conflict(self, cli_controller: CLIController, capsys):\n        \"\"\"Test CLI exits with error if --string and --stdin are used incorrectly.\"\"\"\n        args = [\"--string\", \"some\", \"--substring\", \"a\", \"--stdin\"]\n        exit_code = cli_controller.run(args)\n\n        assert exit_code == 2\n        captured = capsys.readouterr()\n        assert \"Error: Cannot use --string with --stdin unless --string is '-'\" in captured.err\n        assert not captured.out\n\nclass TestCLIMainFunction:\n    \"\"\"Tests for the main entry point function in scripts/cli.py.\"\"\"\n\n    @pytest.fixture\n    def mock_repo_init(self, monkeypatch):\n        \"\"\"Mocks repository initialization.\"\"\"\n        mock_repo = MagicMock(spec=StringRepository)\n        mock_repo.initialize.return_value = None\n        monkeypatch.setattr('scripts.cli.StringRepository', MagicMock(return_value=mock_repo))\n        return mock_repo\n\n    @pytest.fixture\n    def mock_service_cli(self, monkeypatch):\n        \"\"\"Mocks the service for cli_main tests.\"\"\"\n        mock_service = MagicMock(spec=CounterService)\n        mock_service.validate_and_count.return_value = QueryResult(id=1, count=3)\n        monkeypatch.setattr('scripts.cli.CounterService', MagicMock(return_value=mock_service))\n        return mock_service\n\n    @pytest.fixture\n    def mock_cli_controller(self, monkeypatch):\n        \"\"\"Mocks the CLIController for cli_main tests.\"\"\"\n        mock_controller_instance = MagicMock(spec=CLIController)\n        mock_controller_instance.run.return_value = 0 # Default success\n        monkeypatch.setattr('scripts.cli.CLIController', MagicMock(return_value=mock_controller_instance))\n        return mock_controller_instance\n\n    def test_cli_main_success(self, mock_repo_init, mock_service_cli, mock_cli_controller):\n        \"\"\"Test that the main function correctly orchestrates components and returns exit code 0.\"\"\"\n        with patch.object(sys, 'argv', ['substring-counter', '--string', 'test', '--substring', 't']):\n            exit_code = cli_main()\n\n        mock_repo_init.initialize.assert_called_once()\n        mock_cli_controller.run.assert_called_once_with(['--string', 'test', '--substring', 't'])\n        assert exit_code == 0\n\n    def test_cli_main_failure(self, mock_repo_init, mock_service_cli, mock_cli_controller):\n        \"\"\"Test that the main function propagates CLIController's non-zero exit code.\"\"\"\n        mock_cli_controller.run.return_value = 2 # Simulate argparse error\n\n        with patch.object(sys, 'argv', ['substring-counter', '--substring', 't']): # Missing --string\n            exit_code = cli_main()\n\n        assert exit_code == 2\n        mock_cli_controller.run.assert_called_once_with(['--substring', 't'])\n\n    def test_cli_main_repo_init_failure(self, monkeypatch, capsys):\n        \"\"\"Test main function handles repository initialization failure.\"\"\"\n        mock_repo_class = MagicMock(spec=StringRepository)\n        mock_repo_instance = mock_repo_class.return_value\n        mock_repo_instance.initialize.side_effect = RepositoryError(\"DB init failed\")\n        monkeypatch.setattr('scripts.cli.StringRepository', mock_repo_class)\n\n        # We need to mock sys.exit for cli_main to return instead of exit\n        with patch.object(sys, 'exit') as mock_sys_exit:\n            cli_main(argv=['--string', 'test', '--substring', 't'])\n\n            mock_sys_exit.assert_called_once_with(1)\n            captured = capsys.readouterr()\n            assert \"Database error: DB init failed\" in captured.err\n\n```"}
{"task_id": "HumanEval/19", "solution": "```python\nfrom typing import List, Dict, Tuple\n\n\ndef sort_numbers(numbers: str) -> str:\n    \"\"\" Input is a space-delimited string of numberals from 'zero' to 'nine'.\n    Return the string with numbers sorted from smallest to largest.\n    \"\"\"\n\n    # Shared configuration constants for numeral words and their mappings.\n    _WORD_TO_INT: Dict[str, int] = {\n        \"zero\": 0, \"one\": 1, \"two\": 2, \"three\": 3, \"four\": 4,\n        \"five\": 5, \"six\": 6, \"seven\": 7, \"eight\": 8, \"nine\": 9\n    }\n    _INT_TO_WORD: Dict[int, str] = {\n        0: \"zero\", 1: \"one\", 2: \"two\", 3: \"three\", 4: \"four\",\n        5: \"five\", 6: \"six\", 7: \"seven\", 8: \"eight\", 9: \"nine\"\n    }\n\n    # Custom exceptions to signal specific error conditions.\n    class _NumSortError(Exception):\n        \"\"\"Base exception for operations within this sorting context.\"\"\"\n        def __init__(self, message: str) -> None:\n            self.message = message\n            super().__init__(self.message)\n\n    class _InvalidTokenError(_NumSortError):\n        \"\"\"Raised when one or more input tokens are not recognized as valid numeral words.\"\"\"\n        def __init__(self, invalid_tokens: List[str]) -> None:\n            self.invalid_tokens = invalid_tokens\n            super().__init__(f\"Invalid tokens found: {', '.join(invalid_tokens)}\")\n\n    # Helper function for token normalization.\n    def _normalize_token(token: str) -> str:\n        \"\"\"Normalizes a string token by stripping whitespace and converting to lowercase.\"\"\"\n        return token.strip().lower()\n\n    # Helper function to validate and separate tokens into valid and invalid lists.\n    def _validate_tokens(tokens_list: List[str]) -> Tuple[List[str], List[str]]:\n        \"\"\"Processes a list of input tokens, returning a tuple of valid normalized tokens and original invalid tokens.\"\"\"\n        valid_normalized_tokens: List[str] = []\n        invalid_original_tokens: List[str] = []\n        for token in tokens_list:\n            normalized_token = _normalize_token(token)\n            if normalized_token in _WORD_TO_INT:\n                valid_normalized_tokens.append(normalized_token)\n            else:\n                invalid_original_tokens.append(token)\n        return valid_normalized_tokens, invalid_original_tokens\n\n    # Main logic: trim input, handle empty, split, validate, map, sort, map back, and join.\n    trimmed_input = numbers.strip()\n    if not trimmed_input:\n        return \"\"\n\n    input_tokens = trimmed_input.split()\n\n    valid_tokens, invalid_tokens = _validate_tokens(input_tokens)\n\n    if invalid_tokens:\n        raise _InvalidTokenError(invalid_tokens)\n\n    # Convert valid word tokens to integers, sort them, then convert back to words.\n    numeric_values = [_WORD_TO_INT[token] for token in valid_tokens]\n    numeric_values.sort()\n    sorted_words = [_INT_TO_WORD[value] for value in numeric_values]\n\n    return \" \".join(sorted_words)\n```"}
{"task_id": "HumanEval/19", "solution": "```python\n# src/numwords_sorter/exceptions.py\nclass InvalidInputError(Exception):\n    \"\"\"Raised when the input string itself is invalid (e.g., empty or all whitespace).\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\n\nclass InvalidTokenError(Exception):\n    \"\"\"Raised when an unrecognized word token is encountered.\"\"\"\n    def __init__(self, token: str):\n        super().__init__(f\"Invalid token found: '{token}'\")\n        self.token = token\n\nclass InternalSortError(Exception):\n    \"\"\"Raised for unexpected errors during the sorting process.\"\"\"\n    def __init__(self, inner: Exception):\n        super().__init__(f\"An internal error occurred during sorting: {inner}\")\n        self.inner = inner\n\n\n# src/numwords_sorter/models.py\nfrom typing import List, Dict\n\nclass WordNumberMapper:\n    \"\"\"Provides canonical mapping between number words and their integer values.\"\"\"\n\n    WORD_TO_INT: Dict[str, int] = {\n        \"zero\": 0, \"one\": 1, \"two\": 2, \"three\": 3, \"four\": 4,\n        \"five\": 5, \"six\": 6, \"seven\": 7, \"eight\": 8, \"nine\": 9\n    }\n    INT_TO_WORD: Dict[int, str] = {\n        0: \"zero\", 1: \"one\", 2: \"two\", 3: \"three\", 4: \"four\",\n        5: \"five\", 6: \"six\", 7: \"seven\", 8: \"eight\", 9: \"nine\"\n    }\n\n    def map_word_to_int(self, word: str) -> int:\n        \"\"\"Converts a word token to its integer value (0-9), case-insensitive.\"\"\"\n        word_l = word.strip().lower()\n        if word_l not in self.WORD_TO_INT:\n            raise InvalidTokenError(word)\n        return self.WORD_TO_INT[word_l]\n\n    def map_int_to_word(self, value: int) -> str:\n        \"\"\"Converts an integer (0-9) to its canonical word token.\"\"\"\n        if not (0 <= value <= 9):\n            raise ValueError(f\"Value '{value}' is out of supported range (0-9).\")\n        return self.INT_TO_WORD[value]\n\n    def supported_words(self) -> List[str]:\n        \"\"\"Returns a sorted list of all supported lower-case word tokens.\"\"\"\n        return sorted(list(self.WORD_TO_INT.keys()))\n\n\n# src/numwords_sorter/utils/validator.py\nfrom typing import List\n\nclass InputValidator:\n    \"\"\"Validates and tokenizes input strings.\"\"\"\n\n    def validate_input_string(self, s: str) -> None:\n        \"\"\"Ensures the input string is not empty or composed solely of whitespace.\"\"\"\n        if s is None or not isinstance(s, str) or not s.strip():\n            raise InvalidInputError(\"Input must be a non-empty string of number words.\")\n\n    def tokenize(self, s: str) -> List[str]:\n        \"\"\"Splits the input string by whitespace, returning lower-cased tokens.\"\"\"\n        # Split by any whitespace and filter out empty strings\n        return [token.lower() for token in s.split() if token]\n\n\n# src/numwords_sorter/services.py\nfrom typing import List\nfrom numwords_sorter.models import WordNumberMapper\nfrom numwords_sorter.utils.validator import InputValidator\nfrom numwords_sorter.exceptions import InvalidInputError, InvalidTokenError, InternalSortError\n\nclass SortService:\n    \"\"\"Provides the core business logic for parsing, sorting, and converting number words.\"\"\"\n\n    MAX_TOKENS = 10000\n\n    def __init__(self, mapper: WordNumberMapper = None, validator: InputValidator = None):\n        \"\"\"Initializes SortService with optional dependency injection for mapper and validator.\"\"\"\n        self._mapper = mapper if mapper is not None else WordNumberMapper()\n        self._validator = validator if validator is not None else InputValidator()\n\n    def parse_to_ints(self, numbers: str) -> List[int]:\n        \"\"\"Validates the input string and converts word tokens to a list of integers.\"\"\"\n        self._validator.validate_input_string(numbers)\n        tokens = self._validator.tokenize(numbers)\n\n        if len(tokens) > self.MAX_TOKENS:\n            raise InvalidInputError(f\"Input exceeds maximum allowed tokens ({self.MAX_TOKENS}).\")\n\n        ints = []\n        for token in tokens:\n            ints.append(self._mapper.map_word_to_int(token))\n        return ints\n\n    def ints_to_words(self, values: List[int]) -> List[str]:\n        \"\"\"Converts a list of integers back to a list of canonical word tokens.\"\"\"\n        words = []\n        for value in values:\n            try:\n                words.append(self._mapper.map_int_to_word(value))\n            except Exception as e:\n                raise InternalSortError(e) from e\n        return words\n\n    def sort_numbers(self, numbers: str) -> str:\n        \"\"\"Parses a space-delimited string of number words, sorts them numerically, and returns the sorted string.\"\"\"\n        try:\n            ints = self.parse_to_ints(numbers)\n            ints_sorted = sorted(ints)  # Stable sort for identical numbers\n            words = self.ints_to_words(ints_sorted)\n            return \" \".join(words)\n        except (InvalidInputError, InvalidTokenError):\n            raise\n        except Exception as e:\n            raise InternalSortError(e) from e\n\n\n# src/numwords_sorter/__init__.py\nfrom numwords_sorter.services import SortService\nfrom numwords_sorter.exceptions import InvalidInputError, InvalidTokenError, InternalSortError\n\n_sort_service = SortService()\n\ndef sort_numbers(numbers: str) -> str:\n    \"\"\"\n    Accepts a space-delimited string of English number words (\"zero\" .. \"nine\")\n    and returns them sorted from smallest to largest.\n    \"\"\"\n    return _sort_service.sort_numbers(numbers)\n\n\n# src/numwords_sorter/controllers/cli.py\nimport sys\nfrom typing import List\nimport argparse\nfrom numwords_sorter.services import SortService\nfrom numwords_sorter.exceptions import InvalidInputError, InvalidTokenError, InternalSortError\n\nclass CLIController:\n    \"\"\"Manages command-line interactions for sorting number words.\"\"\"\n\n    def __init__(self, service: SortService = None):\n        \"\"\"Initializes the CLIController with an optional SortService instance.\"\"\"\n        self._service = service if service is not None else SortService()\n\n    def run(self, args: List[str]) -> int:\n        \"\"\"Parses CLI arguments, calls the sorting service, and prints the result or error.\"\"\"\n        parser = argparse.ArgumentParser(\n            prog=\"numwords-sorter\",\n            description=\"Sorts a space-delimited string of number words (zero-nine).\"\n        )\n        parser.add_argument(\n            \"numbers\",\n            nargs=\"*\",\n            help=\"Space-delimited string of number words (e.g., 'three one five').\"\n        )\n        parser.add_argument(\n            \"-n\", \"--input-string\",\n            dest=\"input_string\",\n            help=\"Alternatively provide the input string using a flag.\"\n        )\n\n        parsed_args = parser.parse_args(args)\n\n        input_str = None\n        if parsed_args.input_string:\n            input_str = parsed_args.input_string\n        elif parsed_args.numbers:\n            input_str = \" \".join(parsed_args.numbers)\n        elif not sys.stdin.isatty():\n            input_str = sys.stdin.read().strip()\n\n        if not input_str:\n            print(\"Error: No input provided. Use positional arguments, --input-string, or pipe from stdin.\", file=sys.stderr)\n            parser.print_help(sys.stderr)\n            return 2\n\n        try:\n            sorted_numbers = self._service.sort_numbers(input_str)\n            print(sorted_numbers)\n            return 0\n        except (InvalidInputError, InvalidTokenError) as e:\n            print(f\"Error: {e.message if isinstance(e, InvalidInputError) else str(e)}\", file=sys.stderr)\n            return 1\n        except Exception as e:\n            print(f\"An unexpected error occurred: {e}\", file=sys.stderr)\n            return 2\n\n\n# src/numwords_sorter/__main__.py\nimport sys\nfrom numwords_sorter.controllers.cli import CLIController\n\ndef main():\n    \"\"\"Entry point for the CLI when run as a module or installed script.\"\"\"\n    controller = CLIController()\n    sys.exit(controller.run(sys.argv[1:]))\n\nif __name__ == \"__main__\":\n    main()\n\n\n# src/numwords_sorter/controllers/http.py\nfrom fastapi import FastAPI, HTTPException, Request, status\nfrom pydantic import BaseModel\nfrom typing import Dict, Any\n\nfrom numwords_sorter.services import SortService\nfrom numwords_sorter.exceptions import InvalidInputError, InvalidTokenError, InternalSortError\n\nclass SortRequest(BaseModel):\n    numbers: str\n\nclass SortResponse(BaseModel):\n    sorted: str\n\nclass ErrorResponse(BaseModel):\n    error: str\n\nclass HTTPController:\n    \"\"\"Provides a FastAPI application for sorting number words via HTTP.\"\"\"\n\n    def __init__(self, service: SortService = None):\n        \"\"\"Initializes the HTTPController, setting up the FastAPI app and endpoints.\"\"\"\n        self._service = service if service is not None else SortService()\n        self.app = self.create_app()\n\n    def create_app(self) -> FastAPI:\n        \"\"\"Creates and configures the FastAPI application instance.\"\"\"\n        app = FastAPI(\n            title=\"Number Word Sorter API\",\n            description=\"API to sort space-delimited English number words (zero-nine).\",\n            version=\"1.0.0\"\n        )\n\n        # Dependency injection for the endpoint handler\n        @app.post(\n            \"/sort\",\n            response_model=SortResponse,\n            summary=\"Sort number words\",\n            description=\"Accepts a space-delimited string of number words and returns them sorted.\",\n            responses={\n                status.HTTP_200_OK: {\"model\": SortResponse},\n                status.HTTP_400_BAD_REQUEST: {\"model\": ErrorResponse, \"description\": \"Invalid Input\"},\n                status.HTTP_500_INTERNAL_SERVER_ERROR: {\"model\": ErrorResponse, \"description\": \"Internal Server Error\"},\n            }\n        )\n        async def post_sort_endpoint(request_data: SortRequest) -> SortResponse:\n            return self.post_sort(request_data.dict())\n\n        return app\n\n    def post_sort(self, payload: Dict[str, Any]) -> SortResponse:\n        \"\"\"Handles the POST /sort request, processes input, and returns a sorted response.\"\"\"\n        numbers = payload.get(\"numbers\")\n        if not isinstance(numbers, str):\n            raise HTTPException(\n                status_code=status.HTTP_400_BAD_REQUEST,\n                detail={\"error\": \"Input JSON must contain a 'numbers' field with a string value.\"}\n            )\n\n        try:\n            sorted_str = self._service.sort_numbers(numbers)\n            return SortResponse(sorted=sorted_str)\n        except (InvalidInputError, InvalidTokenError) as e:\n            raise HTTPException(\n                status_code=status.HTTP_400_BAD_REQUEST,\n                detail={\"error\": e.message if isinstance(e, InvalidInputError) else str(e)}\n            ) from e\n        except InternalSortError as e:\n            raise HTTPException(\n                status_code=status.HTTP_500_INTERNAL_SERVER_ERROR,\n                detail={\"error\": \"An internal server error occurred during sorting.\"}\n            ) from e\n        except Exception as e:\n            raise HTTPException(\n                status_code=status.HTTP_500_INTERNAL_SERVER_ERROR,\n                detail={\"error\": f\"An unexpected error occurred: {str(e)}\"}\n            ) from e\n\n# Instantiate the controller and expose its app for uvicorn\napp = HTTPController().app\n\n\n# src/numwords_sorter/clients.py\nimport requests\nfrom numwords_sorter import sort_numbers\n\nclass ExternalClient:\n    \"\"\"A small convenience client for demonstrating library and HTTP service usage.\"\"\"\n\n    def call_sort_via_library(self, numbers: str) -> str:\n        \"\"\"Calls the local library function directly.\"\"\"\n        return sort_numbers(numbers)\n\n    def call_sort_via_http(self, base_url: str, numbers: str) -> str:\n        \"\"\"Calls the HTTP POST /sort endpoint and returns the sorted string.\"\"\"\n        url = f\"{base_url.rstrip('/')}/sort\"\n        payload = {\"numbers\": numbers}\n        try:\n            response = requests.post(url, json=payload)\n            response.raise_for_status()  # Raise an exception for HTTP errors (4xx or 5xx)\n            result = response.json()\n            if \"sorted\" in result:\n                return result[\"sorted\"]\n            elif \"error\" in result:\n                raise ValueError(f\"Server returned error: {result['error']}\")\n            else:\n                raise ValueError(f\"Unexpected response format: {result}\")\n        except requests.exceptions.RequestException as e:\n            raise RuntimeError(f\"HTTP request failed: {e}\") from e\n\n\n# pyproject.toml\n# Note: This is a placeholder. You'd typically generate this with poetry init or similar.\n\"\"\"\n[tool.poetry]\nname = \"numwords-sorter\"\nversion = \"0.1.0\"\ndescription = \"Utility to sort English number words.\"\nauthors = [\"Your Name <your.email@example.com>\"]\nreadme = \"README.md\"\npackages = [{include = \"numwords_sorter\", from = \"src\"}]\n\n[tool.poetry.dependencies]\npython = \">=3.9,<4.0\"\nfastapi = { version = \"^0.111.0\", optional = true }\nuvicorn = { version = \"^0.30.1\", extras = [\"standard\"], optional = true }\nrequests = \"^2.32.3\" # For ExternalClient only\n\n[tool.poetry.group.dev.dependencies]\npytest = \"^8.2.2\"\n\n[tool.poetry.extras]\nhttp = [\"fastapi\", \"uvicorn\"]\n\n[tool.poetry.scripts]\nnumwords-sorter = \"numwords_sorter.__main__:main\"\n\n[build-system]\nrequires = [\"poetry-core\"]\nbuild-backend = \"poetry.core.masonry.api\"\n\"\"\"\n\n# README.md\n\"\"\"\n# Number Word Sorter\n\nA Python utility to sort space-delimited English number words (zero to nine).\nIt provides a reusable library function, a command-line interface (CLI), and a lightweight HTTP endpoint.\n\n## Features\n\n- **Library API**: `numwords_sorter.sort_numbers(numbers: str) -> str`\n- **CLI**: `python -m numwords_sorter \"five one three\"` or `numwords-sorter \"seven two\"`\n- **HTTP Endpoint**: `POST /sort` with JSON input `{\"numbers\": \"...\"}`\n\n## Installation\n\n### Using Poetry (Recommended)\n\n```bash\npoetry new numwords-sorter-project\ncd numwords-sorter-project\n# Copy src/numwords_sorter, pyproject.toml, requirements.txt, README.md, tests/\n# ... into the new project structure\npoetry install\npoetry install --with http # If you need the HTTP server\n```\n\n### Using pip\n\n```bash\n# From the project root where pyproject.toml is located\npip install .\npip install \".[http]\" # If you need the HTTP server\n```\n\n## Usage\n\n### Library\n\n```python\nfrom numwords_sorter import sort_numbers\n\nsorted_string = sort_numbers(\"three one five\")\nprint(sorted_string) # Output: one three five\n\ntry:\n    sort_numbers(\"one two apple\")\nexcept Exception as e:\n    print(f\"Error: {e}\") # Output: Error: Invalid token found: 'apple'\n```\n\n### Command Line Interface (CLI)\n\n```bash\n# Using python -m\npython -m numwords_sorter \"three one five\"\n# Output: one three five\n\npython -m numwords_sorter -n \"nine zero four\"\n# Output: zero four nine\n\necho \"six two eight\" | python -m numwords_sorter\n# Output: two six eight\n\n# Using the installed entry point (after `pip install .` or `poetry install`)\nnumwords-sorter \"seven one four\"\n# Output: one four seven\n\nnumwords-sorter \"one two twenty\"\n# Output: Error: Invalid token found: 'twenty'\n# Exit code: 1\n```\n\n### HTTP Server\n\nTo run the HTTP server, you need to install the `http` extra:\n`pip install \".[http]\"` or `poetry install --with http`\n\n```bash\nuvicorn numwords_sorter.controllers.http:app --host 0.0.0.0 --port 8000\n```\n\nThen you can make 