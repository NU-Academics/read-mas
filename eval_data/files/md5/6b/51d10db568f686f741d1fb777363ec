(\"/sort\", json={\"list\": [5, 6, 3, 4, 8, 9, 2]}, headers={\"X-API-Key\": \"any_key\"})\n        assert response.status_code == 200\n        assert response.json() == {\"result\": [2, 6, 3, 4, 8, 9, 5]}\n\n    def test_repository_init_on_startup(self, app_config_with_persistence, mock_algorithm, mock_repository):\n        \"\"\"Verify repository init_db is called during app startup.\"\"\"\n        service = SortThirdService(algorithm=mock_algorithm, repository=mock_repository, config=app_config_with_persistence)\n        \n        with patch('sort_third_app.api.logger') as api_logger_mock:\n            with TestClient(create_app(app_config_with_persistence, service)):\n                pass\n            mock_repository.init_db.assert_called_once()\n            api_logger_mock.info.assert_any_call(f\"Database initialized at {app_config_with_persistence.db_path}.\")\n\n    def test_repository_init_on_startup_failure(self, app_config_with_persistence, mock_algorithm):\n        \"\"\"Verify startup failure is logged if DB init fails.\"\"\"\n        mock_repo_for_startup = Mock(spec=HistoryRepository)\n        mock_repo_for_startup.init_db.side_effect = Exception(\"DB Init Failed\")\n        service = SortThirdService(algorithm=mock_algorithm, repository=mock_repo_for_startup, config=app_config_with_persistence)\n\n        with patch('sort_third_app.api.logger') as api_logger_mock:\n            with pytest.raises(RuntimeError):\n                with TestClient(create_app(app_config_with_persistence, service)):\n                    pass\n            mock_repo_for_startup.init_db.assert_called_once()\n            api_logger_mock.error.assert_any_call(f\"Failed to initialize database during startup: DB Init Failed\")\n\n```"}
