{"task_id": "HumanEval/1", "solution": "def separate_paren_groups(paren_string: str) -> list:\n    \"\"\" Input to this function is a string containing multiple groups of nested parentheses. Your goal is to\n    separate those group into separate strings and return the list of those.\n    Separate groups are balanced (each open brace is properly closed) and not nested within each other\n    Ignore any spaces in the input string.\n    \"\"\"\n    groups: list[str] = []\n    depth = 0\n    current_group_chars: list[str] = []\n\n    for char in paren_string:\n        if char == '(':\n            current_group_chars.append(char)\n            depth += 1\n        elif char == ')':\n            current_group_chars.append(char)\n            depth -= 1\n            if depth == 0 and current_group_chars:\n                groups.append(\"\".join(current_group_chars))\n                current_group_chars = []\n        # Any other character, including whitespace, is ignored as per the problem and design.\n\n    return groups"}
{"task_id": "HumanEval/0", "solution": "```python\nfrom typing import List\n\n\ndef has_close_elements(numbers: List[float], threshold: float) -> bool:\n    \"\"\" Check if in given list of numbers, are any two numbers closer to each other than\n    given threshold.\n    >>> has_close_elements([1.0, 2.0, 3.0], 0.5)\n    False\n    >>> has_close_elements([1.0, 2.8, 3.0, 4.0, 5.0, 2.0], 0.3)\n    True\n    \"\"\"\n    if len(numbers) < 2:\n        return False\n\n    sorted_numbers = sorted(numbers)\n\n    for i in range(len(sorted_numbers) - 1):\n        diff = sorted_numbers[i+1] - sorted_numbers[i]\n        if diff < threshold:\n            return True\n            \n    return False\n```"}
{"task_id": "HumanEval/1", "solution": "```python\nfrom typing import List\n\ndef separate_paren_groups(paren_string: str) -> List[str]:\n    \"\"\"\n    Separates a string containing multiple balanced parenthesis groups into a list of individual group strings.\n    Whitespace is ignored, and only correctly balanced top-level groups are returned.\n    \"\"\"\n    \n    # Normalize input: remove all characters that are not parentheses. This effectively ignores whitespace and other characters.\n    s = \"\".join(ch for ch in paren_string if ch == '(' or ch == ')')\n\n    groups: List[str] = []\n    current_group_buffer: List[str] = []\n    balance: int = 0\n\n    for char in s:\n        if char == '(':\n            balance += 1\n            current_group_buffer.append(char)\n        elif char == ')':\n            balance -= 1\n            current_group_buffer.append(char)\n        \n        # If balance goes negative, the current sequence is not a valid balanced group.\n        # Reset the buffer and balance to start fresh for the next potential group.\n        if balance < 0:\n            current_group_buffer = []\n            balance = 0\n        # If balance returns to zero, a top-level balanced group has been completed.\n        # Add it to the results and clear the buffer.\n        elif balance == 0 and current_group_buffer:\n            groups.append(\"\".join(current_group_buffer))\n            current_group_buffer = []\n            \n    return groups\n```"}
{"task_id": "HumanEval/0", "solution": "```python\nfrom typing import List\n\n\ndef has_close_elements(numbers: List[float], threshold: float) -> bool:\n    \"\"\" Check if in given list of numbers, are any two numbers closer to each other than\n    given threshold.\n    >>> has_close_elements([1.0, 2.0, 3.0], 0.5)\n    False\n    >>> has_close_elements([1.0, 2.8, 3.0, 4.0, 5.0, 2.0], 0.3)\n    True\n    \"\"\"\n    nums = sorted(numbers)\n    for i in range(1, len(nums)):\n        if abs(nums[i] - nums[i-1]) < threshold:\n            return True\n    return False\n```"}
{"task_id": "HumanEval/2", "solution": "import math\n\ndef truncate_number(number: float) -> float:\n    \"\"\"Returns the decimal part of a positive floating-point number.\n    This is the leftover part always smaller than 1.\n    \"\"\"\n    integer_part = math.floor(number)\n    decimal_part = number - integer_part\n    return decimal_part"}
{"task_id": "HumanEval/2", "solution": "import math\n\ndef truncate_number(number: float) -> float:\n    \"\"\"Return the decimal part of a positive floating-point number.\n    Handles precision to mitigate floating-point artifacts.\n    \"\"\"\n    # Default precision from the design specification (NFR1 and config.py).\n    DEFAULT_PRECISION = 12\n\n    int_part = math.floor(number)\n    raw_decimal_part = number - float(int_part)\n\n    # Round the raw decimal part to the default precision.\n    rounded_decimal_part = round(raw_decimal_part, DEFAULT_PRECISION)\n\n    # Clamp the result to ensure it's within the [0, 1) range,\n    # handling potential floating-point artifacts that might result in tiny negative numbers\n    # or values >= 1.0 after rounding.\n    if rounded_decimal_part < 0:\n        return 0.0\n    if rounded_decimal_part >= 1.0:\n        return 0.0\n    \n    return rounded_decimal_part"}
