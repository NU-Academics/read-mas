{"task_id": "HumanEval/55", "solution": "def fib(n: int) -> int:\n    \"\"\"Return the n-th Fibonacci number.\n    This implementation uses an iterative approach.\n    \"\"\"\n    if n <= 1:\n        return n\n    a, b = 0, 1\n    for _ in range(2, n + 1):\n        a, b = b, a + b\n    return b"}
{"task_id": "HumanEval/57", "solution": "def monotonic(l: list):\n    \"\"\"Return True if list elements are monotonically increasing or decreasing.\n    An empty or single-element list is considered monotonic.\n    \"\"\"\n    if len(l) <= 1:\n        return True\n\n    is_non_decreasing = True\n    is_non_increasing = True\n\n    for i in range(1, len(l)):\n        if l[i] < l[i-1]:\n            is_non_decreasing = False\n        if l[i] > l[i-1]:\n            is_non_increasing = False\n\n        if not is_non_decreasing and not is_non_increasing:\n            return False\n\n    return is_non_decreasing or is_non_increasing"}
{"task_id": "HumanEval/57", "solution": "def monotonic(l: list):\n    \"\"\"Return True if list elements are monotonically increasing or decreasing.\n    This includes non-strict monotonicity (equal adjacent values allowed).\n    \"\"\"\n    if len(l) < 2:\n        return True\n\n    saw_inc = False\n    saw_dec = False\n    prev = l[0]\n\n    for cur in l[1:]:\n        if cur > prev:\n            saw_inc = True\n        elif cur < prev:\n            saw_dec = True\n        prev = cur\n\n        if saw_inc and saw_dec:\n            return False\n            \n    return True"}
