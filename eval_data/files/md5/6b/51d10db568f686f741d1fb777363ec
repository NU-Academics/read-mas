{"task_id": "HumanEval/53", "solution": "```python\n# pyproject.toml\n# This file describes the project with its metadata and dependencies.\n# The `tool.poetry` section would typically be used for Poetry,\n# but `[project]` is a standard for PEP 621.\n\n[project]\nname = \"simplemath\"\nversion = \"0.1.0\"\ndescription = \"A small Python library for basic arithmetic with a robust add operation.\"\nauthors = [\"Your Name <your.email@example.com>\"]\nreadme = \"README.md\"\nlicense = \"MIT\"\nrequires-python = \">=3.8\"\nkeywords = [\"math\", \"arithmetic\", \"add\"]\nclassifiers = [\n    \"Programming Language :: Python :: 3\",\n    \"License :: OSI Approved :: MIT License\",\n    \"Operating System :: OS Independent\",\n    \"Development Status :: 3 - Alpha\",\n]\n\n[project.optional-dependencies]\nhttp = [\"Flask>=2.0.0\"]\n\n[project.scripts]\nsimplemath = \"simplemath.controllers.cli_controller:main\"\n\n[build-system]\nrequires = [\"setuptools>=61.0\"]\nbuild-backend = \"setuptools.build_meta\"\n\n# src/simplemath/config.py\n# Global constants and configuration settings for the simplemath package.\nimport os\n\nAPP_NAME = \"simplemath\"\nVERSION = \"0.1.0\"\nDEFAULT_ENCODING = \"utf-8\"\n\n# src/simplemath/exceptions.py\n# Defines custom exception classes for domain-specific errors.\n\nclass ValidationError(Exception):\n    \"\"\"Exception raised for invalid input values.\"\"\"\n    def __init__(self, message: str) -> None:\n        self.message = message\n        super().__init__(self.message)\n\nclass CalculationError(Exception):\n    \"\"\"Exception raised for unexpected errors during calculation.\"\"\"\n    def __init__(self, message: str) -> None:\n        self.message = message\n        super().__init__(self.message)\n\n# src/simplemath/dto.py\n# Data Transfer Objects (DTOs) for structured request and response data.\nfrom typing import Any, Tuple, Dict\n\nclass AddRequest:\n    \"\"\"Represents a request to add two numbers.\"\"\"\n    def __init__(self, a: float, b: float) -> None:\n        self.a = a\n        self.b = b\n\n    def to_tuple(self) -> Tuple[float, float]:\n        \"\"\"Returns the request values as a tuple.\"\"\"\n        return (self.a, self.b)\n\nclass AddResponse:\n    \"\"\"Represents the response containing the result of an addition operation.\"\"\"\n    def __init__(self, result: float) -> None:\n        self.result = result\n\n    def to_dict(self) -> Dict[str, float]:\n        \"\"\"Returns the response result as a dictionary.\"\"\"\n        return {\"result\": self.result}\n\n# src/simplemath/validators.py\n# Provides utilities for validating and converting input data.\nfrom typing import Any\nfrom simplemath.exceptions import ValidationError\nfrom simplemath.dto import AddRequest\n\nclass InputValidator:\n    \"\"\"Handles validation and type coercion for input values.\"\"\"\n    def validate_number(self, value: Any) -> float:\n        \"\"\"Validates and converts a value to a float.\"\"\"\n        if isinstance(value, (int, float)):\n            return float(value)\n        if isinstance(value, str):\n            s = value.strip()\n            if not s or len(s) > 64:  # Limit string length for DoS prevention\n                raise ValidationError(\"Invalid numeric string format or length.\")\n            try:\n                return float(s)\n            except ValueError:\n                raise ValidationError(f\"Cannot parse '{value}' as a number.\")\n        raise ValidationError(\"Value must be an int, float, or numeric string.\")\n\n    def validate_request(self, a: Any, b: Any) -> AddRequest:\n        \"\"\"Validates two inputs and returns an AddRequest DTO.\"\"\"\n        validated_a = self.validate_number(a)\n        validated_b = self.validate_number(b)\n        return AddRequest(validated_a, validated_b)\n\n# src/simplemath/operations.py\n# Contains pure arithmetic operations without side effects.\n\nclass MathOperations:\n    \"\"\"Provides fundamental mathematical operations.\"\"\"\n    def add(self, a: float, b: float) -> float:\n        \"\"\"Return the sum of a and b.\"\"\"\n        return a + b\n\n# src/simplemath/services/calculator_service.py\n# Orchestrates validation and arithmetic operations.\nfrom simplemath.dto import AddRequest, AddResponse\nfrom simplemath.exceptions import CalculationError\nfrom simplemath.operations import MathOperations\nfrom simplemath.validators import InputValidator\n\nclass CalculatorService:\n    \"\"\"Manages the business logic for arithmetic operations.\"\"\"\n    def __init__(self, validator: InputValidator = None, ops: MathOperations = None) -> None:\n        self.validator = validator or InputValidator()\n        self.ops = ops or MathOperations()\n\n    def add(self, req: AddRequest) -> AddResponse:\n        \"\"\"Performs addition based on an AddRequest.\"\"\"\n        try:\n            result = self.ops.add(req.a, req.b)\n            return AddResponse(result=result)\n        except Exception as e:\n            raise CalculationError(str(e))\n\n# src/simplemath/utils.py\n# Provides general utility functions for the package.\nimport logging\nfrom typing import Union\n\ndef format_result(value: Union[int, float]) -> str:\n    \"\"\"Formats a numeric result, removing trailing '.0' for integers.\"\"\"\n    if isinstance(value, float) and value.is_integer():\n        return str(int(value))\n    return str(value)\n\ndef setup_logging(level: str = \"INFO\") -> None:\n    \"\"\"Configures basic logging for the application.\"\"\"\n    logging.basicConfig(level=getattr(logging, level.upper(), logging.INFO),\n                        format='%(asctime)s - %(name)s - %(levelname)s - %(message)s')\n\n# src/simplemath/controllers/cli_controller.py\n# Handles command-line interface interactions.\nimport sys\nfrom typing import List\nfrom simplemath.services.calculator_service import CalculatorService\nfrom simplemath.validators import InputValidator\nfrom simplemath.exceptions import ValidationError, CalculationError\nfrom simplemath.utils import format_result, setup_logging\nfrom simplemath.config import APP_NAME\n\nclass CLIController:\n    \"\"\"Manages parsing CLI arguments and executing operations.\"\"\"\n    def __init__(self, service: CalculatorService) -> None:\n        self.service = service\n\n    def run(self, argv: List[str]) -> int:\n        \"\"\"Processes CLI arguments and prints results or errors.\"\"\"\n        if len(argv) < 1:\n            print(f\"Usage: {APP_NAME} <command> [args...]\", file=sys.stderr)\n            return 2\n\n        command = argv[0]\n        if command == \"add\":\n            if len(argv) != 3:\n                print(f\"Usage: {APP_NAME} add <a> <b>\", file=sys.stderr)\n                return 2\n            try:\n                # CLIController directly uses InputValidator to parse raw string args\n                req = InputValidator().validate_request(argv[1], argv[2])\n                resp = self.service.add(req)\n                print(format_result(resp.result))\n                return 0\n            except ValidationError as ve:\n                print(f\"Error: {ve.message}\", file=sys.stderr)\n                return 2\n            except CalculationError:\n                print(\"An unexpected calculation error occurred.\", file=sys.stderr)\n                return 1\n            except Exception:\n                print(\"An unknown error occurred.\", file=sys.stderr)\n                return 1\n        else:\n            print(f\"Unknown command: {command}\", file=sys.stderr)\n            return 2\n\ndef main():\n    \"\"\"Entry point for the simplemath CLI console script.\"\"\"\n    setup_logging()\n    service = CalculatorService()\n    controller = CLIController(service)\n    sys.exit(controller.run(sys.argv[1:]))\n\n# src/simplemath/controllers/http_controller.py\n# Provides a lightweight HTTP endpoint using Flask (optional dependency).\nimport logging\nfrom typing import TYPE_CHECKING\nfrom simplemath.services.calculator_service import CalculatorService\nfrom simplemath.validators import InputValidator\nfrom simplemath.dto import AddRequest\nfrom simplemath.exceptions import ValidationError, CalculationError\nfrom simplemath.utils import setup_logging\n\nif TYPE_CHECKING:\n    from flask import Flask\n\nlogger = logging.getLogger(__name__)\n\nclass HTTPController:\n    \"\"\"Manages HTTP endpoint definitions and request handling.\"\"\"\n    def __init__(self, service: CalculatorService = None) -> None:\n        self.service = service or CalculatorService()\n\n    def create_app(self) -> \"Flask\":\n        \"\"\"Creates and configures a Flask application.\"\"\"\n        try:\n            from flask import Flask, request, jsonify\n        except ImportError:\n            raise ImportError(\"Flask is not installed. Please install it with 'pip install \\\"simplemath[http]\\\"'\")\n\n        app = Flask(__name__)\n        setup_logging()\n\n        @app.route(\"/add\", methods=[\"POST\"])\n        def add_endpoint():\n            \"\"\"Handles POST requests to /add for numeric addition.\"\"\"\n            if not request.is_json:\n                return jsonify({\"error\": \"Request must be JSON\"}), 400\n\n            data = request.get_json()\n            try:\n                a = data.get(\"a\")\n                b = data.get(\"b\")\n                \n                # HTTPController directly uses InputValidator to parse raw JSON values\n                req = InputValidator().validate_request(a, b)\n                resp = self.service.add(req)\n                return jsonify(resp.to_dict()), 200\n            except ValidationError as ve:\n                logger.warning(f\"Validation error for /add: {ve.message}\")\n                return jsonify({\"error\": ve.message}), 400\n            except CalculationError as ce:\n                logger.exception(f\"Calculation error for /add: {ce.message}\")\n                return jsonify({\"error\": \"Internal server error\"}), 500\n            except Exception as e:\n                logger.exception(f\"Unexpected error in /add: {e}\")\n                return jsonify({\"error\": \"Internal server error\"}), 500\n        \n        return app\n\n# src/simplemath/__init__.py\n# Package exports, version, and a convenient top-level add function.\nfrom simplemath.config import VERSION as __version__\nfrom simplemath.exceptions import ValidationError, CalculationError\nfrom simplemath.dto import AddRequest, AddResponse\nfrom simplemath.operations import MathOperations\nfrom simplemath.validators import InputValidator\nfrom simplemath.services.calculator_service import CalculatorService\nfrom simplemath.controllers.cli_controller import CLIController\nfrom simplemath.controllers.http_controller import HTTPController\n\n# Initialize default service and validator for convenience\n_default_validator = InputValidator()\n_default_service = CalculatorService(validator=_default_validator)\n\ndef add(x: Any, y: Any) -> float:\n    \"\"\"Adds two numbers, handling type conversion and validation.\n    This serves as the simple programmatic API entry point.\"\"\"\n    req = _default_validator.validate_request(x, y)\n    resp = _default_service.add(req)\n    return resp.result\n\n# Export core components as per design\n__all__ = [\n    \"add\",\n    \"MathOperations\",\n    \"InputValidator\",\n    \"AddRequest\",\n    \"AddResponse\",\n    \"CalculatorService\",\n    \"CLIController\",\n    \"HTTPController\",\n    \"ValidationError\",\n    \"CalculationError\",\n]\n\n# README.md\n# Simple Math Library\nA small, well-tested Python library for basic arithmetic, focusing on a robust `add(x, y)` operation.\n\n## Features\n\n- Programmatic `add(x, y)` function for numeric inputs (int, float, numeric strings).\n- Command-line interface: `simplemath add <a> <b>`.\n- Optional HTTP endpoint: `POST /add` returning JSON.\n- Input validation and clear error handling.\n- Modular, testable, and publishable package structure.\n\n## Installation\n\nYou can install the library directly:\n\n```bash\npip install .\n```\n\nFor the optional HTTP server functionality (Flask), install with the `http` extra:\n\n```bash\npip install \".[http]\"\n```\n\n## Usage\n\n### Programmatic API\n\n```python\nfrom simplemath import add, CalculatorService, AddRequest\n\n# Simple convenience function\nresult = add(2, 3)          # Returns 5.0\nresult = add(\"2.5\", \"3.1\")  # Returns 5.6\n# result = add(\"hello\", 3)  # Raises ValidationError\n\n# Using the service layer for structured interaction\nservice = CalculatorService()\nrequest_dto = AddRequest(a=10, b=20)\nresponse_dto = service.add(request_dto)\nprint(f\"Service result: {response_dto.result}\") # Output: Service result: 30.0\n```\n\n### Command-Line Interface (CLI)\n\nAfter installation, the `simplemath` command will be available.\n\n```bash\n# Add two integers\nsimplemath add 5 7\n# Output: 12\n\n# Add with floats and numeric strings\nsimplemath add 2.5 \"3\"\n# Output: 5.5\n\n# Invalid input\nsimplemath add hello 10\n# Output: Error: Cannot parse 'hello' as a number.\n# Exit code: 2\n```\n\n### HTTP Endpoint (Optional)\n\nIf installed with the `http` extra, you can run the HTTP server:\n\n```bash\n# From the project root\n# Using Flask's development server (not for production)\nexport FLASK_APP=src/simplemath/controllers/http_controller.py\nexport FLASK_DEBUG=1 # Optional, for development\nflask run\n\n# Or using gunicorn (recommended for production)\n# gunicorn -w 4 -b 127.0.0.1:5000 'simplemath.controllers.http_controller:HTTPController().create_app()'\n```\n\nOnce the server is running (e.g., on `http://127.0.0.1:5000`), you can make POST requests:\n\n```bash\ncurl -X POST -H \"Content-Type: application/json\" -d '{\"a\": 15, \"b\": 25}' http://127.0.0.1:5000/add\n# Output: {\"result\":40.0}\n\ncurl -X POST -H \"Content-Type: application/json\" -d '{\"a\": \"1.5\", \"b\": 2.5}' http://127.0.0.1:5000/add\n# Output: {\"result\":4.0}\n\ncurl -X POST -H \"Content-Type: application/json\" -d '{\"a\": \"invalid\", \"b\": 2}' http://127.0.0.1:5000/add\n# Output: {\"error\":\"Cannot parse 'invalid' as a number.\"}\n```\n\n## Development and Testing\n\nThe project uses `pytest` for unit testing.\n```bash\n# Install development dependencies\npip install pytest flake8 black\n\n# Run tests\npytest\n\n# Run linting\nflake8 src/\nblack --check src/\n```\n\n## Project Structure\n\n```\n\u251c\u2500\u2500 src/\n\u2502   \u2514\u2500\u2500 simplemath/\n\u2502       \u251c\u2500\u2500 __init__.py\n\u2502       \u251c\u2500\u2500 config.py\n\u2502       \u251c\u2500\u2500 dto.py\n\u2502       \u251c\u2500\u2500 exceptions.py\n\u2502       \u251c\u2500\u2500 validators.py\n\u2502       \u251c\u2500\u2500 operations.py\n\u2502       \u251c\u2500\u2500 services/\n\u2502       \u2502   \u2514\u2500\u2500 calculator_service.py\n\u2502       \u251c\u2500\u2500 controllers/\n\u2502       \u2502   \u251c\u2500\u2500 cli_controller.py\n\u2502       \u2502   \u2514\u2500\u2500 http_controller.py\n\u2502       \u2514\u2500\u2500 utils.py\n\u251c\u2500\u2500 tests/\n\u2502   \u251c\u2500\u2500 test_operations.py\n\u2502   \u251c\u2500\u2500 test_validators.py\n\u2502   \u251c\u2500\u2500 test_service.py\n\u2502   \u251c\u2500\u2500 test_cli.py\n\u2502   \u2514\u2500\u2500 conftest.py\n\u251c\u2500\u2500 pyproject.toml\n\u251c\u2500\u2500 README.md\n\u251c\u2500\u2500 .gitignore\n\u2514\u2500\u2500 tox.ini\n```\n\n# .gitignore\n# Ignore common Python development files.\n# Byte-compiled / optimized / DLL files\n__pycache__/\n*.pyc\n*.pyd\n*.pyo\n\n# C extensions\n*.so\n\n# Distribution / packaging\n.Python\nbuild/\ndist/\n*.egg-info/\n.eggs/\n\n# Environments\n.env\n.venv\nenv/\nvenv/\nENV/\nenv.bak/\nvenv.bak/\n\n# Editors\n.vscode/\n.idea/\n\n# Testing\n.pytest_cache/\n.coverage\nhtmlcov/\n.tox/\n\n# Logs and other files\n*.log\n*.sqlite3\n\n# OS generated files\n.DS_Store\n.Trashes\nThumbs.db\n\n# tox.ini\n# Configuration for tox, a generic virtualenv management and test tool.\n[tox]\nenvlist = py38, py39, py310, py311, py312, lint, coverage\nisolated_build = True\n\n[gh-actions]\npython =\n    3.8: py38\n    3.9: py39\n    3.10: py310, coverage\n    3.11: py311, lint\n    3.12: py312\n\n[testenv]\ndescription = Run tests with pytest\ndeps =\n    pytest\ncommands =\n    pytest {posargs}\n\n[testenv:lint]\ndescription = Run linters (flake8, black)\nskip_install = True\ndeps =\n    flake8\n    black==24.4.0 # Pin black version to avoid unexpected formatting changes\ncommands =\n    flake8 src/\n    black --check src/\n\n[testenv:coverage]\ndescription = Run tests and generate coverage report\ndeps =\n    pytest\n    pytest-cov\ncommands =\n    pytest --cov=simplemath --cov-report=xml --cov-report=term-missing\n\n# For development, you might want to run the HTTP service via tox\n[testenv:http]\ndescription = Run the HTTP service (for manual testing)\ndeps =\n    Flask\ncommands =\n    gunicorn -w 1 -b 127.0.0.1:5000 'simplemath.controllers.http_controller:HTTPController().create_app()'\n```"}
