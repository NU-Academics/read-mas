\n    converter = RomanNumeralConverter()\n    roman_uppercase = converter.convert(integer_input.get_value())\n    roman_output = RomanNumeralOutput(roman_uppercase)\n    return roman_output.to_lowercase()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/156", "solution": "def int_to_mini_roman(number):\n    \"\"\"\n    Given a positive integer, obtain its roman numeral equivalent as a string,\n    and return it in lowercase. Restrictions: 1 <= num <= 1000.\n    \"\"\"\n    roman_map = [\n        (1000, 'm'), (900, 'cm'), (500, 'd'), (400, 'cd'),\n        (100, 'c'), (90, 'xc'), (50, 'l'), (40, 'xl'),\n        (10, 'x'), (9, 'ix'), (5, 'v'), (4, 'iv'),\n        (1, 'i')\n    ]\n\n    result = []\n    for value, numeral in roman_map:\n        while number >= value:\n            result.append(numeral)\n            number -= value\n    return ''.join(result)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/157": [{"task_id": "HumanEval/157", "solution": "def right_angle_triangle(a, b, c):\n    \"\"\"\n    Given three side lengths, determine if they form a right-angled triangle.\n    Uses the Pythagorean theorem with a small epsilon for float comparison.\n    \"\"\"\n    sides = sorted([a, b, c])\n\n    # Square the two shorter sides and the longest side\n    side1_sq = sides[0] * sides[0]\n    side2_sq = sides[1] * sides[1]\n    longest_side_sq = sides[2] * sides[2]\n\n    # Use a small epsilon for floating-point comparison\n    epsilon = 1e-9\n\n    return abs(side1_sq + side2_sq - longest_side_sq) < epsilon", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/157", "solution": "class Triangle:\n    \"\"\"\n    Represents a triangle with three side lengths and determines if it is right-angled.\n    \"\"\"\n    _side_a: float\n    _side_b: float\n    _side_c: float\n\n    def __init__(self, a: float, b: float, c: float):\n        \"\"\"\n        Initializes the Triangle object with its three side lengths.\n        \"\"\"\n        self._side_a = a\n        self._side_b = b\n        self._side_c = c\n\n    def _get_sorted_sides(self) -> list:\n        \"\"\"\n        A private helper method that sorts the three side lengths in ascending order.\n        \"\"\"\n        return sorted([self._side_a, self._side_b, self._side_c])\n\n    def is_right_angled(self) -> bool:\n        \"\"\"\n        Determines if the triangle is right-angled using the Pythagorean theorem.\n        Accounts for floating-point precision with a small epsilon.\n        \"\"\"\n        sides = self._get_sorted_sides()\n        a_squared = sides[0] * sides[0]\n        b_squared = sides[1] * sides[1]\n        c_squared = sides[2] * sides[2]\n\n        # Use a small epsilon for floating-point comparison\n        epsilon = 1e-6\n        return abs(a_squared + b_squared - c_squared) < epsilon\ndef right_angle_triangle(a, b, c):\n    \"\"\"\n    Given the lengths of the three sides of a triangle. Return True if the three\n    sides form a right-angled triangle, False otherwise.\n    \"\"\"\n    triangle_obj = Triangle(a, b, c)\n    return triangle_obj.is_right_angled()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/158": [{"task_id": "HumanEval/158", "solution": "def find_max(words):\n    \"\"\"Finds the word with the maximum unique characters, prioritizing lexicographical order on ties.\n\n    Returns an empty string if the input list is empty.\n    \"\"\"\n\n    def _count_unique_chars(word):\n        \"\"\"Counts the number of unique characters in a given word.\"\"\"\n        return len(set(word))\n\n    if not words:\n        return \"\"\n\n    max_unique_count = -1\n    result_word = \"\"\n\n    for current_word in words:\n        unique_char_count = _count_unique_chars(current_word)\n\n        if unique_char_count 