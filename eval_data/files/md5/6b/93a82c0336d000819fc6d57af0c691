.LETTERS_LOWER)\n                shifted_lower_char = Alphabet.LETTERS_LOWER[shifted_index]\n                return shifted_lower_char.upper() if is_upper else shifted_lower_char\n            return char\n\n    class CharacterUtils:\n        @staticmethod\n        def swap_case(char: str) -> str:\n            return char.swapcase()\n\n    def _process_character(char: str) -> str:\n        if Alphabet.is_letter(char):\n            if Alphabet.is_vowel(char):\n                shifted_char = Alphabet.get_shifted_letter(char, 2)\n                return CharacterUtils.swap_case(shifted_char)\n            else:\n                return CharacterUtils.swap_case(char)\n        else:\n            return char\n\n    encoded_chars = [_process_character(char) for char in message]\n    return \"\".join(encoded_chars)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/95": [{"task_id": "HumanEval/95", "solution": "def check_dict_case(dict):\n    \"\"\"\n    Checks if all string keys in a dictionary are consistently cased (all lowercase or all uppercase).\n    Returns False for empty dictionaries or if any key is not a string.\n    \"\"\"\n    if not dict:\n        return False\n\n    all_lower = True\n    all_upper = True\n\n    for key in dict.keys():\n        # As per design, return False if any key is not a string.\n        if not isinstance(key, str):\n            return False\n\n        if not key.islower():\n            all_lower = False\n        if not key.isupper():\n            all_upper = False\n\n    # Return True if all keys are either all lowercase or all uppercase.\n    return all_lower or all_upper", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/95", "solution": "def check_dict_case(dict):\n    \"\"\"\n    Evaluates case consistency of string keys in a dictionary.\n    Returns True if all keys are uniformly lowercase or uniformly uppercase, F