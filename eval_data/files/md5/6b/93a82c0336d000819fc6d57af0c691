_count('yearly')\n    2\n    >>> vowels_count('symphony')\n    3\n    >>> vowels_count('aeiou')\n    5\n    >>> vowels_count('sequoia')\n    5\n    >>> vowels_count('beautiful')\n    5\n    >>> vowels_count('')\n    0\n    >>> vowels_count('a')\n    1\n    >>> vowels_count('b')\n    0\n    >>> vowels_count('y')\n    1\n    >>> vowels_count('Apple')\n    2\n    >>> vowels_count('rHYthM')\n    1\n    >>> vowels_count('MYSTERY')\n    2\n    >>> vowels_count('gymnastics')\n    2\n    >>> vowels_count('happy')\n    2\n    >>> vowels_count('syzygy')\n    3\n    >>> vowels_count('rhythmically')\n    3\n    >>> vowels_count('education')\n    5\n    >>> vowels_count('strength')\n    1\n    >>> vowels_count('lynch')\n    1\n    >>> vowels_count('mythology')\n    4\n    >>> vowels_count('Pyramid')\n    2\n    >>> vowels_count('TYPE')\n    2\n    >>> vowels_count('rhyTHM')\n    1\n    >>> vowels_count('EMPTY')\n    1\n    >>> vowels_count('Yacht')\n    1\n    >>> vowels_count('Y')\n    1\n    >>> vowels_count('X')\n    0\n    \"\"\"\n    count = 0\n    lower_s = s.lower()\n    vowels = 'aeiou'\n\n    if not lower_s:\n        return 0\n\n    for i, char in enumerate(lower_s):\n        if char in vowels:\n            count += 1\n        elif char == 'y' and i == len(lower_s) - 1:\n            count += 1\n\n    return count", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/65": [{"task_id": "HumanEval/65", "solution": "def _convert_int_to_digit_sequence(x: int) -> str:\n    \"\"\"Converts an integer to its string representation.\n    This helper transforms the numerical input into a sequence of characters.\n    \"\"\"\n    return str(x)\ndef _get_number_of_digits(s: str) -> int:\n    \"\"\"Calculates the number of characters in a string.\n    It returns the total count of digits or characters within the given string.\n    \"\"\"\n    return len(s)\ndef _perform_circular_right_shift(digits: str, shift_amount: int) -> str:\n    \"\"\"Performs a circular right shift on a string of digits.\n    The shift amount is normalized to prevent excessive shifting beyond the string's length.\n    \"\"\"\n    if not digits:\n        return \"\"\n    num_digits = len(digits)\n    actual_shift = shift_amount % num_digits\n    return digits[-actual_shift:] + digits[:-actual_shift]\ndef _reverse_digits(digits: str) -> str:\n    \"\"\"Reverses the order of characters in a string.\n    This operation creates a new string with its characters in inverted order.\n    \"\"\"\n    return digits[::-1]\ndef circular_shift(x: int, shift: int) -> str:\n    \"\"\"Circular shift the digits of the integer x, shift the digits right by shift\n    and return the result as a string.\n    If shift > number of digits, return digits reversed.\n    \"\"\"\n    digits_str = _convert_int_to_digit_sequence(x)\n    num_digits = _get_number_of_digits(digits_str)\n\n    if shift <= num_digits:\n        result = _perform_circular_right_shift(digits_str, shift)\n    else:\n        result = _reverse_digits(digits_str)\n\n    return result", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/65", "solution": "from typing import List\nclass IntegerInput:\n    \"\"\"Stores the integer input and provides methods to access its digits.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def get_digits(self) -> List[str]:\n        \"\"\"Converts the absolute value of the integer to a list of digit strings.\"\"\"\n        return list(str(abs(self.value)))\n\n    def get_number_of_digits(self) -> int:\n        \"\"\"Returns the total number of digits in the integer.\"\"\"\n        return len(self.get_digits())\nclass ShiftValue:\n    \"\"\"Stores the integer shift value.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\nclass CircularShiftResult:\n    \"\"\"Stores the final result as a string.\"\"\"\n    def __init__(self, result_string: str):\n        self.result_string = result_string\nclass CircularShiftProcessor:\n    \"\"\"Contains the main logic for digit manipulation (shift or reverse).\"\"\"\n    def process(self, x_input: IntegerInput, shift_value: ShiftValue) -> CircularShiftResult:\n        \"\"\"Orchestrates digit manipulation based on shift value and number of digits.\"\"\"\n        digits = x_input.get_digits()\n        num_digits = x_input.get_number_of_digits()\n\n        final_digits: List[str]\n        if shift_value.value > num_digits:\n            final_digits = self._reverse_digits(digits)\n        else:\n            final_digits = self._perform_circular_right_shift(digits, shift_value.value)\n\n        return CircularShiftResult(\"\".join(final_digits))\n\n    def _perform_circular_right_shift(self, digits: List[str], shift: int) -> List[str]:\n        \"\"\"Performs a circular right shift on a list of digit strings.\"\"\"\n        if not digits:\n            return []\n        effective_shift = shift % len(digits)\n        return digits[-effective_shift:] + digits[:-effective_shift]\n\n    def _reverse_digits(self, digits: List[str]) -> List[str]:\n        \"\"\"Reverses the order of a list of digit strings.\"\"\"\n        return digits[::-1]\ndef circular_shift(x: int, shift: int) -> str:\n    \"\"\"Circularly shifts digits of x to the right by 'shift', returning the result as a string.\n    If 'shift' is greater than the number of digits, the digits are returned in reverse order.\"\"\"\n    integer_input = IntegerInput(x)\n    shift_val = ShiftValue(shift)\n    processor = CircularShiftProcessor()\n\n    result_obj = processor.process(integer_input, shift_val)\n    return result_obj.result_string", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/66": [{"task_id": "HumanEval/66", "solution": "def digitSum(s):\n    \"\"\"Calculates the sum of ASCII codes of only uppercase characters in a string.\n    Returns 0 for 