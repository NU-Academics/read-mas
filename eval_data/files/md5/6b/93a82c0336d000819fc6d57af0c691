, k)). Returns 0 if n < k, otherwise computes the value efficiently.\"\"\"\n    if k < 0 or k > n:\n        return 0\n    if k == 0 or k == n:\n        return 1\n    # Optimization: C(n, k) = C(n, n-k)\n    if k > n // 2:\n        k = n - k\n\n    res = 1\n    for i in range(k):\n        res = res * (n - i) // (i + 1)\n    return res\ndef get_max_triples(n: int) -> int:\n    \"\"\"\n    You are given a positive integer n. You have to create an integer array a of length n.\n        For each i (1 \u2264 i \u2264 n), the value of a[i] = i * i - i + 1.\n        Return the number of triples (a[i], a[j], a[k]) of a where i < j < k,\n    and a[i] + a[j] + a[k] is a multiple of 3.\n\n    Example :\n        Input: n = 5\n        Output: 1\n        Explanation:\n        a = [1, 3, 7, 13, 21]\n        The only valid triple is (1, 7, 13).\n    \"\"\"\n\n    count_rem0 = 0 # Counts a[x] such that a[x] % 3 == 0\n    count_rem1 = 0 # Counts a[x] such that a[x] % 3 == 1\n\n    # Based on the analysis of (i*i - i + 1) % 3:\n    # If i % 3 == 2, then (i*i - i + 1) % 3 == 0\n    # If i % 3 == 0 or i % 3 == 1, then (i*i - i + 1) % 3 == 1\n    # We only care about counts of elements that are 0 or 1 modulo 3.\n    # The sum of three elements a[i] + a[j] + a[k] is a multiple of 3 if and only if\n    # (a[i]%3 + a[j]%3 + a[k]%3) % 3 == 0.\n    # Given that remainders can only be 0 or 1, the only combinations that sum to a multiple of 3 are:\n    # 0 + 0 + 0 = 0\n    # 1 + 1 + 1 = 3\n\n    # Iterate from 1 to n (inclusive) to populate remainder counters.\n    for i in range(1, n + 1):\n        i_mod_3 = i % 3\n        if i_mod_3 == 2:\n            count_rem0 += 1\n        else: # i_mod_3 == 0 or i_mod_3 == 1\n            count_rem1 += 1\n\n    # Calculate combinations for triples from each remainder group.\n    combinations_rem0 = calculate_combinations(count_rem0, 3)\n    combinations_rem1 = calculate_combinations(count_rem1, 3)\n\n    total_triples = combinations_rem0 + combinations_rem1\n\n    return total_triples", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/149": [{"task_id": "HumanEval/149", "solution": "def sorted_list_sum(lst):\n    \"\"\"Filters a list of strings, keeping only even-length strings.\n    It then sorts the retained strings by length (ascending) and alphabetically for ties.\"\"\"\n\n    filtered_list = []\n    for s in lst:\n        if len(s) % 2 == 0:\n            filtered_list.append(s)\n\n    # Sort primarily by string length and secondarily by alphabetical order.\n    filtered_list.sort(key=lambda s: (len(s), s))\n\n    return filtered_list", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/149", "solution": "def sorted_list_sum(lst):\n    \"\"\"Filters a list of strings for even lengths. Sorts the result by length ascending, then alphabetically.\"\"\"\n    # Filter out strings with odd lengths.\n    filtered_list = [s for s in lst if len(s) % 2 == 0]\n\n    # Sort the filtered list primarily by length, secondarily alphabetically.\n    filtered_list.sort(key=lambda s: (len(s), s))\n\n    return filtered_list", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/150": [{"task_id": "HumanEval/150", "solution": "def is_prime(n: int) -> bool:\n    \"\"\"Checks if a given integer n is a prime number.\n    Handles edge cases for numbers less than or equal to 1 efficiently.\n    \"\"\"\n    if n <= 1:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n    i = 3\n    while i * i <= n:\n        if n % i == 0:\n            return False\n        i += 2\n    return True\ndef x_or_y(n: int, x: any, y: any) -> any:\n    \"\"\"A simple program which should return the value of x if n is\n    a prime number and should return the value of y otherwise.\n    This function utilizes a separate helper function, is_prime, for primality checking.\n    \"\"\"\n    if is_prime(n):\n        return x\n    else:\n        return y", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/150", "solution": "import math\ndef x_or_y(n, x, y):\n    \"\"\"A simple program which should return the value of x if n is\n    a prime number and should return the value of y otherwise.\n\n    Examples:\n    for x_or_y(7, 34, 12) == 34\n    for x_or_y(15, 8, 5) == 5\n\n    \"\"\"\n    def is_prime(n: int) -> bool:\n        \"\"\"Determines if a given integer n is a prime number.\n        It returns True if prime, False otherwise.\n        \"\"\"\n        if n <= 1:\n            return False\n        if n == 2:\n            return True\n        if n % 2 == 0:\n            return False\n\n        # Check for odd divisors from 3 up to the square root of n.\n        for i in range(3, int(math.sqrt(n)) + 1, 2):\n            if n % i == 0:\n                return False\n\n        return True\n\n    if is_prime(n):\n        return x\n    else:\n        return y", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/152": [{"task_id": "HumanEval/152", "solution": "def compare(game,guess):\n    \"\"\"Determines how far off each guess was for a series of matches.\n    If a guess is correct, the difference is 0; otherwise, it's the absolute difference between score and guess.\n    \"\"\"\n    results = []\n    for actual_score, predicted_guess in zip(game, guess):\n        if actual_score == predicted_guess:\n            results.append(0)\n        else:\n            results.append(abs(actual_score - predicted_guess))\n    return results", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/152", "solution": "def compare(game: list[int], guess: list[int]) -> list[int]:\n    \"\"\"Compares game scores to guesses, returning an array of differences.\n    A difference of 0 indicates a correct guess, otherwise it's the absolute deviation.\"\"\"\n    result_array = []\n    for i in range(len(game)):\n        game_score = game[i]\n        user_guess = guess[i]\n        if game_score == user_guess:\n            result_array.append(0)\n        else:\n            result_array.append(abs(game_score - user_guess))\n    return result_array", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/151": [{"task_id": "HumanEval/151", "solution": "def double_the_difference(lst):\n    '''\n    Calculates the sum of squares of positive odd integers in the list.\n    Returns 0 if the list is empty or contains no qualifying numbers.\n    '''\n    total_sum = 0\n\n    if not lst:\n        return 0\n\n    for element in lst:\n        # Filter for positive odd numbers\n        if isinstance(element, int) and element > 0 and element % 2 != 0:\n            total_sum += element * element\n\n    return total_sum", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/151", "solution": "def double_the_difference(lst: list) -> int:\n    \"\"\"\n    Calculates the sum of squares of odd, non-negative integers in a list.\n    Returns 0 for an empty list; skips non-integer, negative, or even numbers.\n    \"\"\"\n    if not lst:\n        return 0\n\n    total_sum = 0\n    for n in lst:\n        # Filters non-integer values (e.g., 3.5 is skipped, 3.0 proceeds).\n        # This relies on 'n' being a numeric type that int() can process without error.\n        if n != int(n):\n            continue\n\n        # Filters negative numbers.\n        if n < 0:\n            continue\n\n        # Filters even numbers (after ensuring it's an integer value and non-negative).\n        if n % 2 == 0:\n            continue\n\n        # If all filters pass, calculate square and add to sum.\n        total_sum += n * n\n\n    return total_sum", "b