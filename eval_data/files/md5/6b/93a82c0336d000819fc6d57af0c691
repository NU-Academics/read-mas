\n        return []\n\n    negative_numbers = []\n    non_negative_numbers = []\n\n    for x in arr:\n        if x < 0:\n            negative_numbers.append(x)\n        else:\n            non_negative_numbers.append(x)\n\n    negative_numbers.sort()\n\n    non_negative_numbers.sort(key=lambda x: (_count_set_bits(x), x))\n\n    return negative_numbers + non_negative_numbers", "base_status": "fail", "plus_status": "pass", "base_fail_tests": [[[-2, -3, -4, -5, -6]]], "plus_fail_tests": []}, {"task_id": "HumanEval/116", "solution": "def _custom_sort_key(num: int) -> tuple[int, int]:\n    \"\"\"\n    Generates a tuple key for sorting a single integer.\n    Negative numbers get a fixed primary key; non-negative use binary 1s count.\n    \"\"\"\n    if num < 0:\n        return (-1, num)  # Primary key -1 ensures negatives come first, sorted by value.\n    else:\n        return (bin(num).count('1'), num)  # Primary key by 1s count, then by value.\ndef sort_array(arr: list[int]) -> list[int]:\n    \"\"\"\n    Sorts an array of integers based on custom logic.\n    Negative numbers come first, sorted by value; non-negative by binary '1's count, then by value.\n    \"\"\"\n    return sorted(arr, key=_custom_sort_key)", "base_status": "fail", "plus_status": "pass", "base_fail_tests": [[[-2, -3, -4, -5, -6]]], "plus_fail_tests": []}], "HumanEval/117": [{"task_id": "HumanEval/117", "solution": "def _is_vowel(char):\n    \"\"\"Determines if a given character is a vowel (case-insensitive).\"\"\"\n    return char.lower() in ('a', 'e', 'i', 'o', 'u')\ndef _count_consonants(word):\n    \"\"\"Counts the number of consonants in a given word.\"\"\"\n    consonant_count = 0\n    for char in word:\n        if char.isalpha() and not _is_vowel(char):\n            consonant_count += 1\n    return consonant_count\ndef select_words(s, n):\n    \"\"\"Given a string s and a natural number n, return words from s with n consonants, preserving order.\n    An empty s results in an empty list; input is