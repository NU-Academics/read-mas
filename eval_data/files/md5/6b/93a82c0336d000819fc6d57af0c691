id": "HumanEval/163", "solution": "def generate_integers(a, b):\n    \"\"\"\n    Generates a list of single-digit even numbers (2, 4, 6, 8) that fall\n    within the inclusive range defined by `a` and `b`. The returned list\n    is in ascending order, assuming `a` and `b` are positive integers.\n    \"\"\"\n    start = min(a, b)\n    end = max(a, b)\n\n    result = []\n    candidate_numbers = [2, 4, 6, 8]\n\n    for num in candidate_numbers:\n        if start <= num <= end:\n            result.append(num)\n\n    return result", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/163", "solution": "def _determine_range(a: int, b: int) -> tuple[int, int]:\n    \"\"\"Calculates the lower and upper bounds of the inclusive range from a and b.\n    Returns a tuple (lower_bound, upper_bound).\"\"\"\n    lower_bound = min(a, b)\n    upper_bound = max(a, b)\n    return lower_bound, upper_bound\ndef _find_even_digits_in_range(lower: int, upper: int) -> list[int]:\n    \"\"\"Identifies all single-digit even integers (0, 2, 4, 6, 8) within the given range.\n    Returns them in ascending order.\"\"\"\n    single_digit_evens = [0, 2, 4, 6, 8]\n    found_digits = []\n    for digit in single_digit_evens:\n        if lower <= digit <= upper:\n            found_digits.append(digit)\n    return found_digits\ndef generate_integers(a, b):\n    \"\"\"\n    Given two positive integers a and b, return the even digits between a\n    and b, in ascending order.\n\n    For example:\n    generate_integers(2, 8) => [2, 4, 6, 8]\n    generate_integers(8, 2) => [2, 4, 6, 8]\n    generate_integers(10, 14) => []\n    \"\"\"\n    _validate_inputs(a, b)\n    lower_bound, upper_bound = _determine_range(a, b)\n    identified_even_digits = _find_even_digits_in_range(lower_bound, upper_bound)\n\n    # Sort the identified even digits to ensure ascending order as per FR4 and Sequence Diagram.\n    identified_even_digits.sort()\n\n    return identified_even_digits", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[2, 10]], "plus_fail_tests": [[6, 12]]}], "HumanEval/129": [{"task_id": "HumanEval/129", "solution": "def minPath(grid, k):\n    \"\"\"\n    Finds the lexicographically smallest path of length k in the grid.\n    Returns an ordered list of cell values for the minimum path.\n    \"\"\"\n\n    class InputValidator:\n        \"\"\"Validates the input grid and path length k against NFRs.\"\"\"\n        @staticmethod\n        def validate_input(grid, k):\n            N = len(grid)\n\n            # NFR1: Grid dimensions constraint (N x N, N >= 2)\n            if N < 2:\n                raise ValueError(\"Grid dimension N must be at least 2.\")\n            for row in grid:\n                if len(row) != N:\n                    raise ValueError(\"Grid must be square (N x N).\")\n\n            # NFR4: Path length (k) constraint (k must be positive)\n            if not isinstance(k, int) or k <= 0:\n                raise ValueError(\"Path length k must be a positive integer.\")\n\n            # NFR2 & NFR3: Unique cell values and range [1, N*N]\n            seen_values = set()\n            max_val_expected = N * N\n            for r in range(N):\n                for c in range(N):\n                    val = grid[r][c]\n                    if not (1 <= val <= max_val_expected):\n                        raise ValueError(f\"Cell value {val} out of range [1, {max_val_expected}].\")\n                    if val in seen_values:\n                        raise ValueError(f\"Duplicate cell value {val} found.\")\n                    seen_values.add(val)\n\n            if len(seen_values) != max_val_expected:\n                raise ValueError(f\"Not all values from 1 to {max_val_expected} are present or values are missing.\")\n\n\n    class Cell:\n        \"\"\"Represents a cell in the grid with its value and coordinates.\"\"\"\n        def __init__(self, value, row, col):\n            self.value = value\n            self.row = row\n            self.col = col\n\n        def get_neighbors(self, grid_N):\n            \"\"\"Returns coordinates of valid adjacent neighbors within grid boundaries.\"\"\"\n            neighbors = []\n            directions = [(0, 1), (0, -1), (1, 0), (-1, 0)] # Right, Left, Down, Up\n            for dr, dc in directions:\n                n_row, n_col = self.row + dr, self.col + dc\n                if 0 <= n_row < grid_N and 0 <= n_col < grid_N:\n                    neighbors.append((n_row, n_col))\n            return neighbors\n\n\n    class Grid:\n        \"\"\"Represents the 2D grid of Cell objects.\"\"\"\n        def __init__(self, grid_data):\n            self.N = len(grid_data)\n            self.cells = [[None for _ in range(self.N)] for _ in range(self.N)]\n            for r in range(self.N):\n                for c in range(self.N):\n                    self.cells[r][c] = Cell(grid_data[r][c], r, c)\n\n        def get_cell(self, row, col):\n            \"\"\"Retrieves a Cell object at specific coordinates.\"\"\"\n            return self.cells[row][col]\n\n\n    class Path:\n        \"\"\"Represents a sequence of cell values and provides lexicographical comparison.\"\"\"\n        def __init__(self, sequence_of_values):\n            self.sequence_of_values = sequence_of_values\n            self.length = len(sequence_of_values)\n\n        def is_lexicographically_smaller_than(self, other_path):\n            \"\"\"Compares two paths lexicographically.\"\"\"\n            for i in range(self.length):\n                if self.sequence_of_values[i] < other_path.sequence_of_values[i]:\n                    return True\n                elif self.sequence_of_values[i] > other_path.sequence_of_values[i]:\n                    return False\n            return False # Paths are identical up to length\n\n\n    class PathFinder:\n        \"\"\"Finds the lexicographically smallest path of length k using DFS.\"\"\"\n        def __init__(self):\n            # This attribute will store the list of values for the current minimum path found.\n            self.current_min_path_values = None\n\n        def _dfs_find_paths(self, current_cell, current_path_values, current_length, k, grid_obj):\n            \"\"\"Recursively explores paths using DFS.\"\"\"\n\n            # Base Case: Path length reached\n            if current_length == k:\n                # Compare the current path with the overall minimum found so far.\n                current_path_obj = Path(current_path_values)\n                min_path_obj = Path(self.current_min_path_values)\n                if current_path_obj.is_lexicographically_smaller_than(min_path_obj):\n                    self.current_min_path_values = list(current_path_values) # Update if current path is smaller\n                return\n\n            # Recursive Step: Explore neighbors\n            neighbors = current_cell.get_neighbors(grid_obj.N)\n            for n_row, n_col in neighbors:\n                neighbor_cell = grid_obj.get_cell(n_row, n_col)\n                # Create a new list for the next path segment to avoid modifying the current path.\n                new_path_values = current_path_values + [neighbor_cell.value]\n                self._dfs_find_paths(neighbor_cell, new_path_values, current_length + 1, k, grid_obj)\n\n\n        def find_min_path(self, grid_obj, k):\n            \"\"\"Initiates pathfinding from all possible starting cells.\"\"\"\n            N = grid_obj.N\n\n            # Initialize current_min_path_values with an arbitrarily large path to ensure any valid path is smaller.\n            self.current_min_path_values = [(N * N) + 1] * k\n\n            for r in range(N):\n                for c in range(N):\n                    start_cell = grid_obj.get_cell(r, c)\n                    # Start DFS from each cell with its value as the first element of the path.\n                    self._dfs_find_paths(start_cell, [start_cell.value], 1, k, grid_obj)\n\n            return Path(self.current_min_path_values)\n\n\n    # --- Main minPath function logic ---\n\n    # 1. Input Validation: Ensure grid and k meet all non-functional requirements.\n    InputValidator.validate_input(grid, k)\n\n    # 2. Grid Initialization: Create an object-oriented representation of the grid.\n    grid_obj = Grid(grid)\n\n    # 3. Pathfinding Execution: Use PathFinder to discover the lexicographically smallest path.\n    path_finder = PathFinder()\n    min_path_obj = path_finder.find_min_path(grid_obj, k)\n\n    # 4. Result Extraction: Return the sequence of values from the found minimum path.\n    return min_path_obj.sequence_of_values", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[[[12, 13, 10, 1], [9, 3, 15, 6], [5, 16, 14, 4], [11, 8, 7, 2]], 12]], "plus_fail_tests": [[[[1, 2, 3], [4, 5, 6], [7, 8, 9]], 15]]}, {"task_id": "HumanEval/129", "solution": "def minPath(grid_data, k):\n    \"\"\"\n    Finds the lexicographically smallest path of length k in a grid.\n    Returns an ordered list of cell values for the minimum path.\n    \"\"\"\n\n    class Cell:\n        \"\"\"Represents a single cell in the grid.\"\"\"\n        def __init__(self, value, row, col):\n            self.value = value\n            self.row = row\n            self.col = col\n\n    class Grid:\n        \"\"\"Manages the grid structure and cell access.\"\"\"\n        def __init__(self, grid_data_input):\n            self.N = len(grid_data_input)\n            self.cells = [[None for _ in range(self.N)] for _ in range(self.N)]\n            for r in range(self.N):\n                for c in range(self.N):\n                    self.cells[r][c] = Cell(grid_data_input[r][c], r, c)\n\n        def get_cell(self, row, col):\n            \"\"\"Returns the Cell object at specified coordinates.\"\"\"\n            return self.cells[row][col]\n\n        def is_valid_coordinate(self, row, col):\n            \"\"\"Checks if coordinates are within grid boundaries.\"\"\"\n            return 0 <= row < self.N and 0 <= col < self.N\n\n    class Path:\n        \"\"\"Represents a path, providing lexicographical comparison.\"\"\"\n        def __init__(self, cell_values):\n            self.cell_values = cell_values\n            self.length = len(cell_values)\n\n        def __lt__(self, other):\n            \"\"\"Implements lexicographical 'less than' comparison.\"\"\"\n            return self.cell_values < other.cell_values\n\n        def __eq__(self, other):\n            \"\"\"Implements equality comparison for paths.\"\"\"\n            return self.cell_values == other.cell_values\n\n    class MinimumPathFinderModule:\n        \"\"\"Orchestrates the finding of the minimum path.\"\"\"\n\n        def find_minimum_path(self, grid_data_input, path_length_k):\n            \"\"\"\n            Main entry point to find the minimum path.\n            Initializes grid and starts DFS from every cell.\n            \"\"\"\n            grid = Grid(grid_data_input)\n            # Use a list to hold min_path_found so it can be modified by reference in DFS calls.\n            min_path_found = [None]\n\n            for r in range(grid.N):\n                for c in range(grid.N):\n                    start_cell_value = grid.get_cell(r, c).value\n                    self._dfs(grid, [start_cell_value], r, c, path_length_k, min_path_found)\n\n            return min_path_found[0].cell_values\n\n        def _get_neighbors(self, grid, row, col):\n            \"\"\"Calculates valid adjacent cell coordinates.\"\"\"\n            neighbors = []\n            directions = [(-1, 0), (1, 0), (0, -1), (0, 1)] # Up, Down, Left, Right\n            for dr, dc in directions:\n                nr, nc = row + dr, col + dc\n                if grid.is_valid_coordinate(nr, nc):\n                    neighbors.append((nr, nc))\n            return neighbors\n\n        def _dfs(self, grid, current_path_values, current_row, current_col, path_length_k, min_path_found_ref):\n            \"\"\"\n            Performs a Depth-First Search to explore paths.\n            Updates min_path_found_ref if a smaller path is found.\n            \"\"\"\n            # Optimization: Prune if current path prefix is already lexicographically greater than the best found path's prefix.\n            if min_path_found_ref[0] is not None:\n                if current_path_values > min_path_found_ref[0].cell_values[:len(current_path_values)]:\n                    return\n\n            # Base Case 1: Path of desired length found\n            if len(current_path_values) == path_length_k:\n                current_path = Path(current_path_values)\n                if min_path_found_ref[0] is None or current_path < min_path_found_ref[0]:\n                    min_path_found_ref[0] = current_path\n                return\n\n            # Base Case 2: Path too long, terminate this branch.\n            if len(current_path_values) > path_length_k:\n                return\n\n            # Recursive Step: Explore neighbors\n            for nr, nc in self._get_neighbors(grid, current_row, current_col):\n                neighbor_value = grid.get_cell(nr, nc).value\n                self._dfs(grid, current_path_values + [neighbor_value], nr, nc, path_length_k, min_path_found_ref)\n\n    # Instantiate the module and run the path finding logic\n    module = MinimumPathFinderModule()\n    return module.find_minimum_path(grid_data, k)", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[[[10, 5, 20, 14, 16], [7, 11, 12, 17, 9], [13, 19, 1, 15, 8], [3, 18, 4, 6, 2], [22, 21, 23, 24, 25]], 25]]}], "HumanEval/130": [{"task_id": "HumanEval/130", "solution": "def tri(n):\n    \"\"\"Calculates the first n+1 numbers of the Tribonacci sequence.\n    Uses memoization to efficiently compute terms including forward dependencies.\"\"\"\n\n    if not hasattr(tri, \"_memo\"):\n        tri._memo = {}\n\n    def _get_term(k: int) -> float:\n        if k in tri._memo:\n            return tri._memo[k]\n\n        result: float\n        if k == 0:\n            result = 1.0\n        elif k == 1:\n            result = 3.0\n        elif k % 2 == 0:  # k is an even positive integer\n            result = 1 + k / 2\n        else:  # k is an odd positive integer\n            # tri(k) = tri(k - 1) + tri(k - 2) + tri(k + 1)\n            result = _get_term(k - 1) + _get_term(k - 2) + _get_term(k + 1)\n\n        tri._memo[k] = result\n        return result\n\n    sequence = []\n    for i in range(n + 1):\n        sequence.append(_get_term(i))\n\n    return sequence", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/130", "solution": "from typing import List, Dict\ndef _calculate_tribonacci_value(k: int, memo: Dict[int, int]) -> int:\n    \"\"\"\n    Helper to recursively calculate the k-th Tribonacci number with memoization.\n    It applies the sequence's recurrence relations.\n    \"\"\"\n    if k in memo:\n        return memo[k]\n\n    if k == 1:\n        memo[k] = 3\n        return 3\n\n    if k % 2 == 0:  # Even k\n        value = 1 + k // 2\n    else:  # Odd k\n        val_k_minus_1 = _calculate_tribonacci_value(k - 1, memo)\n        val_k_minus_2 = _calculate_tribonacci_value(k - 2, memo)\n        val_k_plus_1 = _calculate_tribonacci_value(k + 1, memo)\n        value = val_k_minus_1 + val_k_minus_2 + val_k_plus_1\n\n    memo[k] = value\n    return value\ndef tri(n: int) -> List[int]:\n    \"\"\"\n    Calculates the first n + 1 numbers of the Tribonacci sequence.\n    It uses a helper function with memoization for efficiency.\n    \"\"\"\n    memo: Dict[int, int] = {0: 1}\n\n    results = []\n    for k in range(n + 1):\n        results.append(_calculate_tribonacci_value(k, memo))\n\n    return results", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/139": [{"task_id": "HumanEval/139", "solution": "def _factorial(k: int) -> int:\n    \"\"\"Calculates the standard factorial of a non-negative integer k.\n    This helper is used by special_factorial.\"\"\"\n    res = 1\n    for i in range(1, k + 1):\n        res *= i\n    return res\ndef special_factorial(n: int) -> int:\n    \"\"\"The Brazilian factorial is defined as:\n    brazilian_factorial(n) = n! * (n-1)! * (n-2)! * ... * 1!\n    where n > 0\n\n    For example:\n    >>> special_factorial(4)\n    288\n\n    The function will receive an integer as input and should return the special\n    factorial of this integer.\n    \"\"\"\n    brazilian_factorial_result = 1\n    for k in range(n, 0, -1):\n        brazilian_factorial_result *= _factorial(k)\n    return brazilian_factorial_result", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/139", "solution": "def calculate_factorial(k):\n    \"\"\"Calculates the standard factorial for a positive integer k.\n    This helper assumes k is a positive integer.\n    \"\"\"\n    res = 1\n    for i in range(1, k + 1):\n        res *= i\n    return res\ndef special_factorial(n):\n    \"\"\"The Brazilian factorial is the product of factorials from n! down to 1!.\n    The function receives an integer n (n > 0) and returns its special factorial.\n    \"\"\"\n    total_product = 1\n    # Iterates from 1 up to n, calculating each k! and multiplying it into the total product.\n    for k in range(1, n + 1):\n        total_product *= calculate_factorial(k)\n    return total_product", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}]}}