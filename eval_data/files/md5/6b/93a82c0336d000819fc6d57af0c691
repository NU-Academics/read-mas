"def valid_date(date: str) -> bool:\n    \"\"\"Validates a date string in 'mm-dd-yyyy' format according to specified rules.\n    Returns True if valid, False otherwise.\"\"\"\n\n    class Date:\n        \"\"\"Encapsulates date components and validation logic.\"\"\"\n        def __init__(self, date_str: str):\n            self._date_string = date_str\n            self._month = 0\n            self._day = 0\n            self._year = 0\n\n        def _is_empty(self) -> bool:\n            \"\"\"Checks if the date string is empty.\"\"\"\n            return not self._date_string\n\n        def _is_valid_format(self) -> bool:\n            \"\"\"Checks if the date string adheres to 'mm-dd-yyyy' format.\"\"\"\n            if len(self._date_string) != 10:\n                return False\n            if self._date_string[2] != '-' or self._date_string[5] != '-':\n                return False\n            return True\n\n        def _parse_components(self) -> bool:\n            \"\"\"Parses month, day, year components from the date string.\"\"\"\n            try:\n                # Split by '-' after format validation, expecting 3 parts.\n                parts = self._date_string.split('-')\n                self._month = int(parts[0])\n                self._day = int(parts[1])\n                self._year = int(parts[2])\n                return True\n            except ValueError: # Catches non-integer components.\n                return False\n            except IndexError: # Catches if split didn't yield 3 parts, though format check should prevent this.\n                return False\n\n        def _is_valid_month(self) -> bool:\n            \"\"\"Checks if the month component is between 1 and 12.\"\"\"\n            return 1 <= self._month <= 12\n\n        def _is_valid_day_for_month(self) -> bool:\n            \"\"\"Checks if the day component is valid for the parsed month.\"\"\"\n            if self._month in {1, 3, 5, 7, 8, 10, 12}:\n                return 1 <= self._day <= 31\n