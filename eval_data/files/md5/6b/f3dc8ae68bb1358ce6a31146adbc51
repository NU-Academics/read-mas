{"task_id": "HumanEval/129", "solution": "def minPath(grid, k):\n    \"\"\"\n    Finds the lexicographically smallest path of length k in the grid.\n    This implementation assumes valid inputs as per critical requirements.\n    \"\"\"\n\n    # --- Utility functions ---\n    def is_valid_coordinate(r, c, N):\n        \"\"\"Checks if (r, c) is within N x N grid boundaries.\"\"\"\n        return 0 <= r < N and 0 <= c < N\n\n    def get_neighbors(r, c, N):\n        \"\"\"Returns valid adjacent (row, col) coordinates.\"\"\"\n        neighbors = []\n        for dr, dc in [(0, 1), (0, -1), (1, 0), (-1, 0)]:  # Right, Left, Down, Up\n            nr, nc = r + dr, c + dc\n            if is_valid_coordinate(nr, nc, N):\n                neighbors.append((nr, nc))\n        return neighbors\n\n    # --- Data Models ---\n    class Cell:\n        \"\"\"Represents a single cell with its coordinates and value.\"\"\"\n        def __init__(self, r, c, val):\n            self.row = r\n            self.col = c\n            self.value = val\n\n        def __eq__(self, other):\n            return self.row == other.row and self.col == other.col and self.value == other.value\n\n        def __hash__(self):\n            return hash((self.row, self.col, self.value))\n\n        def __repr__(self):\n            return f\"Cell(r={self.row}, c={self.col}, v={self.value})\"\n\n    class Grid:\n        \"\"\"Encapsulates the 2D grid data and provides access methods.\"\"\"\n        def __init__(self, data):\n            self._data = data\n            self._N = len(data)\n\n        def get_value(self, r, c):\n            return self._data[r][c]\n\n        def get_N(self):\n            return self._N\n\n    class Path:\n        \"\"\"Represents an ordered sequence of cells and supports lexicographical comparison.\"\"\"\n        def __init__(self, cells):\n            self._cells = list(cells)  # Store a copy\n            self._values = [cell.value for cell in cells]\n\n        def add_cell(self, cell):\n            self._cells.append(cell)\n            self._values.append(cell.value)\n\n        def get_values(self):\n            return self._values\n\n        def get_last_cell(self):\n            return self._cells[-1]\n\n        def get_length(self):\n            return len(self._cells)\n\n        def __lt__(self, other):\n            return self._values < other._values\n\n        def __eq__(self, other):\n            return self._values == other._values\n\n        def __repr__(self):\n            return f\"Path({self._values})\"\n\n    # --- Main Path Finding Logic ---\n    grid_obj = Grid(grid)\n    N = grid_obj.get_N()\n    min_path_values = None\n\n    # Iterate through each cell as a potential starting point\n    for r_start in range(N):\n        for c_start in range(N):\n            start_cell = Cell(r_start, c_start, grid_obj.get_value(r_start, c_start))\n\n            # Stack for iterative DFS: stores Path objects\n            stack = [Path([start_cell])]\n\n            while stack:\n                current_path = stack.pop()\n\n                # If path reaches desired length, compare and update min_path_values\n                if current_path.get_length() == k:\n                    current_path_values = current_path.get_values()\n                    if min_path_values is None or current_path_values < min_path_values:\n                        min_path_values = current_path_values\n                    continue  # Path found, no need to extend this branch further\n\n                # Pruning: If current path's values are already lexicographically greater\n                # than the known min_path_values for its current length, stop this branch.\n                if min_path_values is not None and current_path.get_values() >= min_path_values[:current_path.get_length()]:\n                    continue\n\n                last_cell = current_path.get_last_cell()\n\n                # Explore neighbors\n                for nr, nc in get_neighbors(last_cell.row, last_cell.col, N):\n                    neighbor_cell = Cell(nr, nc, grid_obj.get_value(nr, nc))\n\n                    # Create a new Path object to represent the extended path for this branch.\n                    new_path = Path(current_path._cells)\n                    new_path.add_cell(neighbor_cell)\n                    stack.append(new_path)\n\n    return min_path_values"}
{"task_id": "HumanEval/136", "solution": "def largest_smallest_integers(lst):\n    \"\"\"Returns a tuple (largest_negative, smallest_positive) from a list of integers.\n    Returns None for either if no such integers are found.\n    \"\"\"\n    negative_integers = [x for x in lst if x < 0]\n    positive_integers = [x for x in lst if x > 0]\n\n    largest_negative = max(negative_integers) if negative_integers else None\n    smallest_positive = min(positive_integers) if positive_integers else None\n\n    return (largest_negative, smallest_positive)"}
{"task_id": "HumanEval/134", "solution": "def check_if_last_char_is_a_letter(txt):\n    \"\"\"Checks if the last character is an alphabetical character and not part of a word.\n    An isolated letter is alphabetical and preceded by a space.\"\"\"\n    if not txt:\n        return False\n\n    last_char = txt[-1]\n\n    if not last_char.isalpha():\n        return False\n\n    # The last character is alphabetical.\n    # It is \"not part of a word\" if it's preceded by a space\n    # and the string has at least two characters.\n    # A single-character string is considered a word itself.\n    if len(txt) > 1 and txt[-2] == ' ':\n        return True\n\n    return False"}
{"task_id": "HumanEval/135", "solution": "def can_arrange(arr: list[int]) -> int:\n    \"\"\"\n    Returns the largest index where `arr[i] < arr[i-1]`.\n    If no such element exists, returns -1.\n    \"\"\"\n    if len(arr) < 2:\n        return -1\n\n    largest_breaking_index = -1\n    for i in range(len(arr) - 1, 0, -1):\n        if arr[i] < arr[i-1]:\n            largest_breaking_index = i\n            break # Found the largest such index, no need to check further left\n    return largest_breaking_index"}
{"task_id": "HumanEval/136", "solution": "def largest_smallest_integers(lst):\n    \"\"\"\n    Finds the largest negative integer and the smallest positive integer in a list.\n    Returns a tuple (largest_negative, smallest_positive), where each can be an integer or None.\n    \"\"\"\n    largest_negative = None\n    smallest_positive = None\n\n    for num in lst:\n        if num < 0:\n            if largest_negative is None or num > largest_negative:\n                largest_negative = num\n        elif num > 0:\n            if smallest_positive is None or num < smallest_positive:\n                smallest_positive = num\n\n    return (largest_negative, smallest_positive)"}
{"task_id": "HumanEval/137", "solution": "def _parse_to_float(value):\n    \"\"\"Converts a value to float, handling string real numbers with commas.\n    Assumes valid int, float, or parseable string input.\"\"\"\n    if isinstance(value, str):\n        return float(value.replace(',', '.'))\n    return float(value)\ndef compare_one(a, b):\n    \"\"\"Compares two values and returns the larger one in its original type.\n    Returns None if the values are numerically equal.\"\"\"\n    a_numeric = _parse_to_float(a)\n    b_numeric = _parse_to_float(b)\n\n    if a_numeric > b_numeric:\n        return a\n    elif b_numeric > a_numeric:\n        return b\n    else:\n        return None"}
{"task_id": "HumanEval/138", "solution": "def is_equal_to_sum_even(n):\n    \"\"\"\n    Evaluate whether n can be written as the sum of exactly 4 positive even numbers.\n    The minimum sum is 8 (2+2+2+2), and any such sum must be even.\n    \"\"\"\n    # Minimum sum of 4 positive even numbers is 2 + 2 + 2 + 2 = 8\n    # Also, the sum of 4 even numbers must always be an even number.\n    return n >= 8 and n % 2 == 0"}
{"task_id": "HumanEval/138", "solution": "def is_equal_to_sum_even(n):\n    \"\"\"Evaluate whether the given number n can be written as the sum of exactly 4 positive even numbers.\"\"\"\n    return n % 2 == 0 and n >= 8"}
{"task_id": "HumanEval/139", "solution": "def factorial(n):\n    \"\"\"Calculates the factorial of a non-negative integer n.\n    Assumes n is a non-negative integer.\n    \"\"\"\n    if n == 0:\n        return 1\n    result = 1\n    for i in range(1, n + 1):\n        result *= i\n    return result\ndef special_factorial(n):\n    \"\"\"The Brazilian factorial is defined as:\n    brazilian_factorial(n) = n! * (n-1)! * (n-2)! * ... * 1!\n    where n > 0\n\n    For example:\n    >>> special_factorial(4)\n    288\n\n    The function will receive an integer as input and should return the special\n    factorial of this integer.\n    \"\"\"\n    special_fact_result = 1\n    for i in range(1, n + 1):\n        special_fact_result *= factorial(i)\n    return special_fact_result"}
{"task_id": "HumanEval/140", "solution": "import re\ndef fix_spaces(text: str) -> str:\n    \"\"\"\n    Given a string text, replace all spaces in it with underscores,\n    and if a string has more than 2 consecutive spaces (i.e., 3 or more),\n    then replace all such consecutive spaces with a single hyphen.\n    \"\"\"\n    # First, replace sequences of 3 or more spaces with a hyphen\n    modified_text = re.sub(r' {3,}', '-', text)\n\n    # Then, replace any remaining single spaces with underscores\n    modified_text = modified_text.replace(' ', '_')\n\n    return modified_text"}
{"task_id": "HumanEval/137", "solution": "from typing import Union\ndef compare_one(a: Union[int, float, str], b: Union[int, float, str]) -> Union[int, float, str, None]:\n    \"\"\"\n    Compares two values (int, float, or string numbers) and returns the numerically larger value\n    in its original type, or None if they are equal or uncomparable.\n    \"\"\"\n\n    def _to_numeric_value(value: Union[int, float, str]) -> Union[float, None]:\n        \"\"\"Converts a value to float, handling comma decimal separators in strings.\"\"\"\n        try:\n            # Convert to string and replace comma with dot, then convert to float.\n            # This approach handles int, float, and string inputs without isinstance checks.\n            return float(str(value).replace(',', '.'))\n        except ValueError:\n            # Return None if the string cannot be converted to a valid float.\n            return None\n\n    a_numeric = _to_numeric_value(a)\n    b_numeric = _to_numeric_value(b)\n\n    if a_numeric is None or b_numeric is None:\n        # If either value could not be converted to a number, they are uncomparable.\n        return None\n\n    if a_numeric > b_numeric:\n        return a\n    elif b_numeric > a_numeric:\n        return b\n    else: # a_numeric == b_numeric\n        return None"}
{"task_id": "HumanEval/140", "solution": "import re\ndef fix_spaces(text):\n    \"\"\"\n    Given a string text, replace all spaces in it with underscores,\n    and if a string has more than 2 consecutive spaces,\n    then replace all consecutive spaces with -\n\n    fix_spaces(\"Example\") == \"Example\"\n    fix_spaces(\"Example 1\") == \"Example_1\"\n    fix_spaces(\" Example 2\") == \"_Example_2\"\n    fix_spaces(\" Example   3\") == \"_Example-3\"\n    \"\"\"\n    # Replace sequences of three or more spaces with a single hyphen.\n    # This step should occur before single space replacement.\n    processed_text = re.sub(r' {3,}', '-', text)\n\n    # Replace all remaining single spaces with underscores.\n    # This handles individual spaces and sequences of two spaces (e.g., '  ' becomes '__').\n    processed_text = processed_text.replace(' ', '_')\n\n    return processed_text"}
{"task_id": "HumanEval/141", "solution": "def file_name_check(file_name):\n    \"\"\"Create a function which takes a string representing a file's name, and returns\n    'Yes' if the the file's name is valid, and returns 'No' otherwise.\n    \"\"\"\n\n    # Rule: There should not be more than three digits ('0'-'9') in the file's name.\n    digit_count = 0\n    for char in file_name:\n        if '0' <= char <= '9':\n            digit_count += 1\n    if digit_count > 3:\n        return 'No'\n\n    # Rule: The file's name contains exactly one dot '.'\n    if file_name.count('.') != 1:\n        return 'No'\n\n    parts = file_name.split('.')\n    prefix = parts[0]\n    extension = parts[1]\n\n    # Rule: The substring before the dot should not be empty.\n    if not prefix:\n        return 'No'\n\n    # Rule: The substring before the dot starts with a letter from the latin alphapet.\n    first_char = prefix[0]\n    if not ('a' <= first_char <= 'z' or 'A' <= first_char <= 'Z'):\n        return 'No'\n\n    # Rule: The substring after the dot should be one of these: ['txt', 'exe', 'dll']\n    allowed_extensions = ['txt', 'exe', 'dll']\n    if extension not in allowed_extensions:\n        return 'No'\n\n    # If all conditions are met, the file name is valid.\n    return 'Yes'"}
{"task_id": "HumanEval/141", "solution": "def file_name_check(file_name):\n    \"\"\"Checks if a file name is valid based on specific rules.\n    Returns 'Yes' for valid, 'No' otherwise.\"\"\"\n\n    # Rule BR1: There should not be more than three digits ('0'-'9')\n    digit_count = sum(1 for char in file_name if char.isdigit())\n    if digit_count > 3:\n        return 'No'\n\n    # Rule BR2: The file's name contains exactly one dot '.'\n    if file_name.count('.') != 1:\n        return 'No'\n\n    prefix, extension = file_name.split('.')\n\n    # Rule BR3: The substring before the dot should not be empty\n    if not prefix:\n        return 'No'\n\n    # Rule BR4: The substring before the dot starts with a letter from the latin alphabet\n    first_char = prefix[0]\n    if not ('a' <= first_char <= 'z' or 'A' <= first_char <= 'Z'):\n        return 'No'\n\n    # Rule BR5: The substring after the dot should be one of ['txt', 'exe', 'dll']\n    VALID_EXTENSIONS = ['txt', 'exe', 'dll']\n    if extension not in VALID_EXTENSIONS:\n        return 'No'\n\n    return 'Yes'"}
{"task_id": "HumanEval/139", "solution": "_factorial_memo = {0: 1, 1: 1}\ndef factorial(k: int) -> int:\n    \"\"\"Calculates the factorial of a non-negative integer k using memoization.\"\"\"\n    if k in _factorial_memo:\n        return _factorial_memo[k]\n\n    result = k * factorial(k - 1)\n    _factorial_memo[k] = result\n    return result\ndef special_factorial(n):\n    \"\"\"The Brazilian factorial is defined as:\n    brazilian_factorial(n) = n! * (n-1)! * (n-2)! * ... * 1!\n    where n > 0\n\n    For example:\n    >>> special_factorial(4)\n    288\n\n    The function will receive an integer as input and should return the special\n    factorial of this integer.\n    \"\"\"\n    special_fact_result = 1\n    for i in range(1, n + 1):\n        special_fact_result *= factorial(i)\n    return special_fact_result"}
{"task_id": "HumanEval/142", "solution": "def sum_squares(lst):\n    \"\"\"\n    This function processes a list of integers, transforming elements based on their index.\n    It returns the sum of all transformed entries.\n    \"\"\"\n    if not lst:\n        return 0\n\n    total_sum = 0\n    for i, value in enumerate(lst):\n        transformed_value = value\n        if i % 3 == 0:\n            transformed_value = value * value\n        elif i % 4 == 0:\n            transformed_value = value * value * value\n\n        total_sum += transformed_value\n    return total_sum"}
{"task_id": "HumanEval/142", "solution": "def sum_squares(lst):\n    \"\"\"\n    Calculates the sum of integers from a list, modifying entries based on their index.\n    Entries are squared if the index is a multiple of 3, cubed if a multiple of 4 (but not 3), otherwise unchanged.\n    \"\"\"\n    modified_list = []\n    for i, num in enumerate(lst):\n        if i % 3 == 0:\n            modified_list.append(num * num)\n        elif i % 4 == 0: # This implies i % 3 != 0 due to the 'if' condition\n            modified_list.append(num * num * num)\n        else:\n            modified_list.append(num)\n    return sum(modified_list)"}
{"task_id": "HumanEval/143", "solution": "import math\ndef words_in_sentence(sentence: str) -> str:\n    \"\"\"\n    Filters words from a sentence, keeping only those with prime lengths.\n    The order of words is preserved in the output string.\n    \"\"\"\n    def is_prime(n: int) -> bool:\n        \"\"\"\n        Checks if an integer is prime.\n        Helper function for words_in_sentence.\n        \"\"\"\n        if n < 2:\n            return False\n        for i in range(2, int(math.sqrt(n)) + 1):\n            if n % i == 0:\n                return False\n        return True\n\n    words = sentence.split(\" \")\n    filtered_words = []\n\n    for word in words:\n        if is_prime(len(word)):\n            filtered_words.append(word)\n\n    return \" \".join(filtered_words)"}
{"task_id": "HumanEval/144", "solution": "class Fraction:\n    def __init__(self, numerator: int, denominator: int):\n        self.numerator = numerator\n        self.denominator = denominator\n\n    def multiply(self, other: 'Fraction') -> 'Fraction':\n        new_numerator = self.numerator * other.numerator\n        new_denominator = self.denominator * other.denominator\n        return Fraction(new_numerator, new_denominator)\n\n    def is_whole_number(self) -> bool:\n        return self.numerator % self.denominator == 0\ndef simplify(x, n):\n    \"\"\"Returns True if the product of two fractions x and n is a whole number.\n    Assumes valid input fractions without zero denominators.\"\"\"\n    x_parts = x.split('/')\n    n_parts = n.split('/')\n\n    fraction_x = Fraction(int(x_parts[0]), int(x_parts[1]))\n    fraction_n = Fraction(int(n_parts[0]), int(n_parts[1]))\n\n    product_fraction = fraction_x.multiply(fraction_n)\n    return product_fraction.is_whole_number()"}
