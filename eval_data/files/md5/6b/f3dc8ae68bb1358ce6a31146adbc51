{"task_id": "HumanEval/99", "solution": "import math\ndef closest_integer(value):\n    \"\"\"\n    Rounds a numeric string to the closest integer.\n    Numbers equidistant from two integers (X.5) are rounded away from zero.\n    \"\"\"\n    num = float(value)\n\n    floor_num = math.floor(num)\n    ceil_num = math.ceil(num)\n\n    if num - floor_num == 0.5:\n        # Equidistant, round away from zero\n        return int(ceil_num) if num > 0 else int(floor_num)\n    elif floor_num + 0.5 < num:\n        return int(ceil_num)\n    else:\n        return int(floor_num)"}
{"task_id": "HumanEval/98", "solution": "def count_upper(s):\n    \"\"\"\n    Counts uppercase vowels at even indices in string `s`.\n    For example, 'aBCdEf' returns 1 and 'abcdefg' returns 0.\n    \"\"\"\n    UPPERCASE_VOWELS = {'A', 'E', 'I', 'O', 'U'}\n    count = 0\n    for i, char in enumerate(s):\n        if i % 2 == 0 and char in UPPERCASE_VOWELS:\n            count += 1\n    return count"}
{"task_id": "HumanEval/99", "solution": "import math\ndef closest_integer(value):\n    \"\"\"\n    Takes a string representing a number and returns the closest integer.\n    Equidistant numbers are rounded away from zero (e.g., 14.5 -> 15, -14.5 -> -15).\n\n    Examples\n    >>> closest_integer(\"10\")\n    10\n    >>> closest_integer(\"15.3\")\n    15\n    \"\"\"\n    num_float = float(value)\n    fractional_part, integer_part = math.modf(num_float)\n\n    if abs(fractional_part) == 0.5:\n        if num_float >= 0:\n            return int(integer_part + 1)\n        else:\n            return int(integer_part - 1)\n    else:\n        return int(round(num_float))"}
{"task_id": "HumanEval/100", "solution": "def make_a_pile(n):\n    \"\"\"\n    Calculates stone counts for `n` levels, starting with `n` stones.\n    Subsequent levels add 2 stones, maintaining parity of initial `n`.\n    \"\"\"\n    pile = []\n    current_stones = n\n    for _ in range(n):\n        pile.append(current_stones)\n        current_stones += 2\n    return pile"}
