{"task_id": "HumanEval/86", "solution": "def anti_shuffle(s: str) -> str:\n    \"\"\"Sorts characters within each word of a string alphabetically by ASCII value, preserving word order and spacing.\"\"\"\n    if not s:\n        return \"\"\n\n    result_parts = []\n    current_word_chars = []\n\n    for char in s:\n        if char.isspace():\n            if current_word_chars:\n                result_parts.append(\"\".join(sorted(current_word_chars)))\n                current_word_chars = []\n            result_parts.append(char)\n        else:\n            current_word_chars.append(char)\n\n    if current_word_chars:\n        result_parts.append(\"\".join(sorted(current_word_chars)))\n\n    return \"\".join(result_parts)"}
{"task_id": "HumanEval/88", "solution": "def sort_array(array: list[int]) -> list[int]:\n    \"\"\"\n    Given an array of non-negative integers, return a copy of the given array after sorting,\n    you will sort the given array in ascending order if the sum( first index value, last index value) is odd,\n    or sort it in descending order if the sum( first index value, last index value) is even.\n    \"\"\"\n    if not array:\n        return []\n\n    if len(array) == 1:\n        return list(array)\n\n    copied_array = list(array)\n\n    first_val = copied_array[0]\n    last_val = copied_array[-1]\n    sum_first_last = first_val + last_val\n\n    is_sum_odd = (sum_first_last % 2 != 0)\n\n    if is_sum_odd:\n        return sorted(copied_array)\n    else:\n        return sorted(copied_array, reverse=True)"}
{"task_id": "HumanEval/87", "solution": "def get_row(lst, x):\n    \"\"\"\n    Finds occurrences of integer x in the nested list and returns their 0-based (row, column) coordinates.\n    The coordinates are sorted primarily by row in ascending order, then by column in descending order.\n    \"\"\"\n    found_coordinates = []\n\n    for row_idx, row_list in enumerate(lst):\n        for col_idx, value in enumerate(row_list):\n            if value == x:\n                found_coordinates.append((row_idx, col_idx))\n\n    # Sort the list of (row, col) tuples\n    # Primary sort: row ascending (coord[0])\n    # Secondary sort: column descending (-coord[1])\n    found_coordinates.sort(key=lambda coord: (coord[0], -coord[1]))\n\n    return found_coordinates"}
{"task_id": "HumanEval/89", "solution": "def encrypt(s):\n    \"\"\"Encrypts a string by rotating alphabetic characters by a fixed shift value.\n    Non-alphabetic characters are left unchanged.\"\"\"\n\n    # The alphabet rotation shift value is fixed at 4.\n    SHIFT_VALUE = 4\n    encrypted_chars = []\n\n    for char in s:\n        if 'a' <= char <= 'z':\n            start = ord('a')\n            rotated_char_ord = (ord(char) - start + SHIFT_VALUE) % 26 + start\n            encrypted_chars.append(chr(rotated_char_ord))\n        elif 'A' <= char <= 'Z':\n            start = ord('A')\n            rotated_char_ord = (ord(char) - start + SHIFT_VALUE) % 26 + start\n            encrypted_chars.append(chr(rotated_char_ord))\n        else:\n            encrypted_chars.append(char)\n\n    return \"\".join(encrypted_chars)"}
{"task_id": "HumanEval/88", "solution": "def sort_array(array):\n    \"\"\"\n    Given an array of non-negative integers, sort a copy based on the sum of its first and last elements.\n    Sort ascending if sum is odd, descending if sum is even. Original array is not modified.\n    \"\"\"\n    if not array:\n        return []\n\n    if len(array) == 1:\n        return array[:]\n\n    first_val = array[0]\n    last_val = array[-1]\n\n    if (first_val + last_val) % 2 != 0:\n        return sorted(array)  # Sort ascending if sum is odd\n    else:\n        return sorted(array, reverse=True) # Sort descending if sum is even"}
