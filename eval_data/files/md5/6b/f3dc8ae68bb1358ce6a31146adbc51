{"task_id": "HumanEval/102", "solution": "def choose_num(x: int, y: int) -> int:\n    \"\"\"This function takes two positive numbers x and y and returns the biggest even integer in range [x, y] inclusive. Returns -1 if no such number exists or if x > y.\"\"\"\n    if x > y:\n        return -1\n\n    # Find the largest even number less than or equal to y.\n    candidate = y\n    if candidate % 2 != 0:\n        candidate -= 1\n\n    # Check if this even candidate is within the valid range [x, y].\n    if candidate >= x:\n        return candidate\n    else:\n        return -1"}
{"task_id": "HumanEval/102", "solution": "def choose_num(x, y):\n    \"\"\"This function finds the biggest even integer in the range [x, y] inclusive.\n    It returns -1 if no such number exists, including when x is greater than y.\n    \"\"\"\n    if x > y:\n        return -1\n\n    for num in range(y, x - 1, -1):\n        if num % 2 == 0:\n            return num\n\n    return -1"}
{"task_id": "HumanEval/103", "solution": "def rounded_avg(n, m):\n    \"\"\"Computes the rounded average of integers in a range and converts it to binary.\n    Returns -1 if n is greater than m.\"\"\"\n    if n > m:\n        return -1\n\n    # Calculate sum and count using arithmetic series formulas for efficiency.\n    count = m - n + 1\n    total_sum = (count * (n + m)) // 2\n\n    # Calculate average, round it, and convert to binary string.\n    average = total_sum / count\n    rounded_value = round(average)\n\n    return bin(rounded_value)"}
{"task_id": "HumanEval/103", "solution": "def rounded_avg(n, m):\n    \"\"\"Computes the rounded average of integers in a range and returns its binary string.\n    Returns \"-1\" if n is greater than m.\"\"\"\n    if n > m:\n        return -1\n\n    # Calculate the sum of integers from n to m using the arithmetic series formula.\n    count = m - n + 1\n    total_sum = (count * (n + m)) // 2\n\n    # Calculate the floating-point average.\n    float_avg = total_sum / count\n\n    # Round the average to the nearest integer.\n    rounded_int_avg = round(float_avg)\n\n    # Convert the rounded integer to its binary string representation.\n    return bin(rounded_int_avg)"}
{"task_id": "HumanEval/104", "solution": "def unique_digits(x):\n    \"\"\"Filters a list of positive integers, returning a sorted list of\n    elements that do not contain any even digits.\"\"\"\n    filtered_numbers = []\n    for number in x:\n        has_even = False\n        for digit_char in str(number):\n            if int(digit_char) % 2 == 0:\n                has_even = True\n                break\n        if not has_even:\n            filtered_numbers.append(number)\n\n    filtered_numbers.sort()\n    return filtered_numbers"}
{"task_id": "HumanEval/106", "solution": "def f(n):\n    def _calculate_factorial(i: int) -> int:\n        # Calculates the factorial of a non-negative integer i.\n        if i == 0:\n            return 1\n        result = 1\n        for num in range(1, i + 1):\n            result *= num\n        return result\n\n    def _calculate_sum_up_to_i(i: int) -> int:\n        # Calculates the sum of integers from 1 up to i.\n        return i * (i + 1) // 2\n\n    result_list = []\n    for i in range(1, n + 1):\n        if i % 2 == 0:  # Even 1-based index\n            result_list.append(_calculate_factorial(i))\n        else:  # Odd 1-based index\n            result_list.append(_calculate_sum_up_to_i(i))\n    return result_list"}
{"task_id": "HumanEval/105", "solution": "def by_length(arr):\n    \"\"\"\n    Given an array of integers, filters, sorts, reverses, and maps numbers to words.\n    Ignores non-integer types and numbers outside the 1-9 range.\n    \"\"\"\n\n    DIGIT_TO_WORD_MAP = {\n        1: \"One\", 2: \"Two\", 3: \"Three\", 4: \"Four\", 5: \"Five\",\n        6: \"Six\", 7: \"Seven\", 8: \"Eight\", 9: \"Nine\"\n    }\n\n    # FR1: Filter an input array to include only integers between 1 and 9 inclusive.\n    # Assuming input 'arr' contains only integer types as per \"Given an array of integers\".\n    filtered_numbers = [n for n in arr if 1 <= n <= 9]\n\n    # FR5: Return an empty array if the input array is empty or contains no valid integers.\n    if not filtered_numbers:\n        return []\n\n    # FR2: Sort the filtered integers in ascending order.\n    sorted_numbers = sorted(filtered_numbers)\n\n    # FR3: Reverse the order of the sorted integers.\n    sorted_numbers.reverse()\n\n    # FR4: Replace each integer in the reversed list with its corresponding word name.\n    # Direct lookup is safe since filtered_numbers ensures 1-9 range.\n    word_list = [DIGIT_TO_WORD_MAP[n] for n in sorted_numbers]\n\n    return word_list"}
{"task_id": "HumanEval/104", "solution": "def unique_digits(x):\n    \"\"\"Given a list of positive integers x, return a sorted list of all\n    elements that hasn't any even digit.\n    The returned list will be sorted in increasing order.\n    \"\"\"\n\n    even_digits = {0, 2, 4, 6, 8}\n    filtered_list = []\n\n    for number in x:\n        has_even = False\n        num_to_check = number\n\n        # Handle the case of number 0 explicitly if it were allowed\n        # as a positive integer. The problem statement specifies positive integers.\n        # However, 0 itself has an even digit (0), so it would be filtered out.\n        # For a positive integer, this loop correctly handles all digits.\n\n        while num_to_check > 0:\n            digit = num_to_check % 10\n            if digit in even_digits:\n                has_even = True\n                break\n            num_to_check //= 10\n\n        if not has_even:\n            filtered_list.append(number)\n\n    filtered_list.sort()\n    return filtered_list"}
{"task_id": "HumanEval/105", "solution": "_DIGIT_WORDS = {\n    1: \"One\",\n    2: \"Two\",\n    3: \"Three\",\n    4: \"Four\",\n    5: \"Five\",\n    6: \"Six\",\n    7: \"Seven\",\n    8: \"Eight\",\n    9: \"Nine\",\n}\ndef _filter_range(arr, min_val, max_val):\n    \"\"\"Filters an array to include only numbers within a specified range.\n    Non-comparable types will raise a TypeError during evaluation.\"\"\"\n    return [n for n in arr if min_val <= n <= max_val]\ndef _sort_ascending(arr):\n    \"\"\"Sorts an array of numbers in ascending order.\"\"\"\n    return sorted(arr)\ndef _reverse_array(arr):\n    \"\"\"Reverses the order of elements in an array.\"\"\"\n    return arr[::-1]\ndef _convert_to_words(digits):\n    \"\"\"Converts a list of digits to their English word representations.\"\"\"\n    return [_DIGIT_WORDS[d] for d in digits]\ndef by_length(arr):\n    \"\"\"\n    Given an array of integers, sort the integers that are between 1 and 9 inclusive,\n    reverse the resulting array, and then replace each digit by its corresponding name from\n    \"One\", \"Two\", \"Three\", \"Four\", \"Five\", \"Six\", \"Seven\", \"Eight\", \"Nine\".\n\n    For example:\n      arr = [2, 1, 1, 4, 5, 8, 2, 3]\n            -> sort arr -> [1, 1, 2, 2, 3, 4, 5, 8]\n            -> reverse arr -> [8, 5, 4, 3, 2, 2, 1, 1]\n      return [\"Eight\", \"Five\", \"Four\", \"Three\", \"Two\", \"Two\", \"One\", \"One\"]\n\n      If the array is empty, return an empty array:\n      arr = []\n      return []\n\n      If the array has any strange number ignore it:\n      arr = [1, -1 , 55]\n            -> sort arr -> [-1, 1, 55]\n            -> reverse arr -> [55, 1, -1]\n      return = ['One']\n    \"\"\"\n    filtered_arr = _filter_range(arr, 1, 9)\n\n    if not filtered_arr:\n        return []\n\n    sorted_arr = _sort_ascending(filtered_arr)\n    reversed_arr = _reverse_array(sorted_arr)\n    word_arr = _convert_to_words(reversed_arr)\n\n    return word_arr"}
{"task_id": "HumanEval/107", "solution": "def even_odd_palindrome(n):\n    \"\"\"\n    Given a positive integer n, return a tuple that has the number of even and odd\n    integer palindromes that fall within the range(1, n), inclusive.\n    \"\"\"\n\n    def is_palindrome(num: int) -> bool:\n        \"\"\"Checks if a given integer is a palindrome.\"\"\"\n        return str(num) == str(num)[::-1]\n\n    def is_even(num: int) -> bool:\n        \"\"\"Checks if a given integer is even.\"\"\"\n        return num % 2 == 0\n\n    even_count = 0\n    odd_count = 0\n\n    for num in range(1, n + 1):\n        if is_palindrome(num):\n            if is_even(num):\n                even_count += 1\n            else:\n                odd_count += 1\n\n    return (even_count, odd_count)"}
{"task_id": "HumanEval/107", "solution": "def even_odd_palindrome(n):\n    \"\"\"\n    Counts even and odd integer palindromes within the range [1, n] inclusive.\n    Returns a tuple (even_count, odd_count).\n    \"\"\"\n\n    # Helper function to check if a number is a palindrome.\n    def is_palindrome(num):\n        s_num = str(num)\n        return s_num == s_num[::-1]\n\n    even_palindromes = 0\n    odd_palindromes = 0\n\n    for i in range(1, n + 1):\n        if is_palindrome(i):\n            if i % 2 == 0:\n                even_palindromes += 1\n            else:\n                odd_palindromes += 1\n    return (even_palindromes, odd_palindromes)"}
{"task_id": "HumanEval/108", "solution": "def _sum_digits(num: int) -> int:\n    \"\"\"\n    Calculates the sum of digits for a given integer.\n    If a number is negative, its first signed digit will be negative.\n    \"\"\"\n    if num == 0:\n        return 0\n\n    s_num = str(num)\n    digit_sum = 0\n\n    if s_num[0] == '-':\n        digit_sum += int(s_num[1]) * -1\n        for digit_char in s_num[2:]:\n            digit_sum += int(digit_char)\n    else:\n        for digit_char in s_num:\n            digit_sum += int(digit_char)\n    return digit_sum\ndef count_nums(arr: list[int]) -> int:\n    \"\"\"\n    Counts the number of elements in an array of integers which has a sum of digits > 0.\n    Handles negative numbers where the first digit contributes negatively.\n    \"\"\"\n    count = 0\n    for num in arr:\n        if _sum_digits(num) > 0:\n            count += 1\n    return count"}
{"task_id": "HumanEval/108", "solution": "def count_nums(arr):\n    \"\"\"\n    Counts numbers in an array whose sum of signed digits is positive.\n    The first digit of a negative number is treated as negative.\n    \"\"\"\n\n    def _calculate_signed_digit_sum(num):\n        \"\"\"\n        Calculates the sum of signed digits for an integer.\n        If negative, the first digit (after minus sign) is negative.\n        \"\"\"\n        if num == 0:\n            return 0\n\n        s_num = str(num)\n        total_sum = 0\n        is_negative = False\n\n        if s_num[0] == '-':\n            is_negative = True\n            s_num = s_num[1:] # Remove the minus sign.\n\n        for i, digit_char in enumerate(s_num):\n            digit = int(digit_char)\n            if is_negative and i == 0:\n                total_sum -= digit # Apply negative sign to the first digit.\n            else:\n                total_sum += digit\n        return total_sum\n\n    if not arr:\n        return 0\n\n    count = 0\n    for num in arr:\n        signed_sum = _calculate_signed_digit_sum(num)\n        if signed_sum > 0:\n            count += 1\n    return count"}
{"task_id": "HumanEval/109", "solution": "def move_one_ball(arr):\n    \"\"\"Determines if an array can be sorted non-decreasingly by right shifts.\n    Returns True if sortable, False otherwise.\"\"\"\n\n    # FR4: If arr is empty, return True.\n    if not arr:\n        return True\n\n    n = len(arr)\n\n    # Helper function to check if an array is sorted non-decreasingly.\n    def _is_sorted(arr_to_check: list[int]) -> bool:\n        if len(arr_to_check) <= 1:\n            return True\n        for i in range(len(arr_to_check) - 1):\n            if arr_to_check[i] > arr_to_check[i+1]:\n                return False\n        return True\n\n    # Iterate through all possible right shift configurations.\n    for i in range(n):\n        # Perform a right shift: last 'i' elements move to the front.\n        shifted_arr = arr[n-i:] + arr[:n-i]\n\n        # Check if the current configuration is sorted.\n        if _is_sorted(shifted_arr):\n            return True\n\n    # If no sorted configuration is found after all shifts, return False.\n    return False"}
{"task_id": "HumanEval/110", "solution": "def exchange(lst1, lst2):\n    \"\"\"\n    Determines if it's possible to make lst1 contain only even numbers by\n    exchanging elements with lst2.\n    \"\"\"\n    odd_count_lst1 = 0\n    for x in lst1:\n        if x % 2 != 0:\n            odd_count_lst1 += 1\n\n    even_count_lst2 = 0\n    for x in lst2:\n        if x % 2 == 0:\n            even_count_lst2 += 1\n\n    if odd_count_lst1 <= even_count_lst2:\n        return \"YES\"\n    else:\n        return \"NO\""}
{"task_id": "HumanEval/109", "solution": "def move_one_ball(arr):\n    \"\"\"\n    Determines if an array can be sorted into non-decreasing order by\n    repeatedly applying a right-shift operation. Returns True for an empty array.\n    \"\"\"\n    if not arr:\n        return True\n\n    n = len(arr)\n\n    # Find the index of the minimum element to determine the correct rotation point.\n    min_val = arr[0]\n    min_idx = 0\n    for i in range(1, n):\n        if arr[i] < min_val:\n            min_val = arr[i]\n            min_idx = i\n\n    # Construct the array rotated such that the minimum element is at the first position.\n    shifted_arr = arr[min_idx:] + arr[:min_idx]\n\n    # Check if this rotated array is sorted in non-decreasing order.\n    for i in range(len(shifted_arr) - 1):\n        if shifted_arr[i] > shifted_arr[i+1]:\n            return False\n\n    return True"}
{"task_id": "HumanEval/110", "solution": "def exchange(lst1, lst2):\n    \"\"\"Determines whether it is possible to perform an exchange of elements\n    between lst1 and lst2 to make lst1 a list of only even numbers.\n    \"\"\"\n    odd_count_lst1 = sum(1 for x in lst1 if x % 2 != 0)\n    even_count_lst2 = sum(1 for x in lst2 if x % 2 == 0)\n\n    if odd_count_lst1 <= even_count_lst2:\n        return \"YES\"\n    else:\n        return \"NO\""}
{"task_id": "HumanEval/111", "solution": "from collections import Counter\ndef histogram(test):\n    \"\"\"Given a string of space-separated lowercase letters, returns a dictionary\n    of the most frequent letters and their counts. If multiple letters share the highest frequency, all are included.\n    \"\"\"\n    if not test:\n        return {}\n\n    letters = test.split()\n    if not letters:  # Handles inputs like '   ' that result in an empty list after splitting\n        return {}\n\n    counts = Counter(letters)\n\n    max_count = 0\n    # The 'if counts' check is technically redundant if 'letters' is guaranteed non-empty\n    # as Counter will then not be empty, but it aligns with the provided example logic.\n    if counts:\n        max_count = max(counts.values())\n\n    result = {letter: count for letter, count in counts.items() if count == max_count}\n    return result"}
{"task_id": "HumanEval/112", "solution": "def reverse_delete(s,c):\n    \"\"\"Deletes characters from `s` found in `c`, then checks if the resulting string is a palindrome. Returns a tuple: (filtered_string, is_palindrome).\"\"\"\n\n    filtered_s_chars = []\n    for char in s:\n        if char not in c:\n            filtered_s_chars.append(char)\n    filtered_s = \"\".join(filtered_s_chars)\n\n    is_palindrome = filtered_s == filtered_s[::-1]\n\n    return (filtered_s, is_palindrome)"}
{"task_id": "HumanEval/112", "solution": "def reverse_delete(s, c):\n    \"\"\"Deletes characters from s present in c, then checks if the resulting string is a palindrome.\n    Returns a tuple with the modified string and the palindrome check result.\"\"\"\n    chars_to_delete = set(c)\n    s_prime_chars = []\n    for char_s in s:\n        if char_s not in chars_to_delete:\n            s_prime_chars.append(char_s)\n    s_prime = \"\".join(s_prime_chars)\n\n    is_palindrome_result = (s_prime == s_prime[::-1])\n\n    return (s_prime, is_palindrome_result)"}
{"task_id": "HumanEval/111", "solution": "def histogram(test):\n    \"\"\"Given a string of space-separated lowercase letters, returns a dictionary\n    of the most frequent letter(s) and their counts.\n    \"\"\"\n    if not test.strip():\n        return {}\n\n    # Split the string by spaces and filter out any empty strings.\n    letters = [letter for letter in test.split(' ') if letter]\n\n    if not letters: # Handles cases like '   ' after splitting and filtering.\n        return {}\n\n    # Count the occurrences of each letter.\n    counts = {}\n    for letter in letters:\n        counts[letter] = counts.get(letter, 0) + 1\n\n    # Find the maximum frequency among all counted letters.\n    max_freq = 0\n    if counts:\n        max_freq = max(counts.values())\n\n    # Construct the result dictionary containing only letters with the maximum frequency.\n    result = {}\n    for letter, count in counts.items():\n        if count == max_freq:\n            result[letter] = count\n\n    return result"}
{"task_id": "HumanEval/113", "solution": "def odd_count(lst):\n    \"\"\"Given a list of strings, where each string consists of only digits, return a list.\n    Each element i of the output should be \"the number of odd elements in the\n    string i of the input.\" where all the i's should be replaced by the number\n    of odd digits in the i'th string of the input.\n\n    >>> odd_count(['1234567'])\n    [\"the number of odd elements 4n the str4ng 4 of the 4nput.\"]\n    >>> odd_count(['3',\"11111111\"])\n    [\"the number of odd elements 1n the str1ng 1 of the 1nput.\",\n     \"the number of odd elements 8n the str8ng 8 of the 8nput.\"]\n    \"\"\"\n    results = []\n    # The template must include 'i' where it needs to be replaced, based on the problem's example output.\n    output_template = \"the number of odd elements in the string i of the input.\"\n    replacement_char = 'i'\n    odd_digits_set = {'1', '3', '5', '7', '9'}\n\n    for s in lst:\n        odd_digit_count = 0\n        for char_digit in s:\n            if char_digit in odd_digits_set:\n                odd_digit_count += 1\n\n        # Replace all occurrences of 'i' in the template with the odd_digit_count\n        formatted_string = output_template.replace(replacement_char, str(odd_digit_count))\n        results.append(formatted_string)\n\n    return results"}
{"task_id": "HumanEval/106", "solution": "def f(n):\n    \"\"\" Implement the function f that takes n as a parameter,\n    and returns a list of size n, such that the value of the element at index i is the factorial of i if i is even\n    or the sum of numbers from 1 to i otherwise.\n    i starts from 1.\n    the factorial of i is the multiplication of the numbers from 1 to i (1 * 2 * ... * i).\n    Example:\n    f(5) == [1, 2, 6, 24, 15]\n    \"\"\"\n\n    # Memoization dictionaries are declared within the function scope\n    # to avoid polluting the global namespace and to encapsulate them\n    # with this specific function call.\n    _memo_factorial = {0: 1, 1: 1}\n    _memo_sum = {0: 0, 1: 1}\n\n    def _calculate_factorial(i: int) -> int:\n        \"\"\"Helper to calculate the factorial of a non-negative integer using memoization.\"\"\"\n        # For this problem's loop, i will always be >= 1.\n        # However, for robustness if called independently, a negative check is good practice.\n        if i < 0:\n            raise ValueError(\"Factorial is not defined for negative numbers.\")\n        if i not in _memo_factorial:\n            result = 1\n            for k in range(1, i + 1):\n                result *= k\n            _memo_factorial[i] = result\n        return _memo_factorial[i]\n\n    def _calculate_sum_up_to(i: int) -> int:\n        \"\"\"Helper to calculate the sum of numbers from 1 up to a given integer using memoization.\"\"\"\n        # For this problem's loop, i will always be >= 1.\n        if i < 0:\n            raise ValueError(\"Sum up to a negative number is not defined.\")\n        if i not in _memo_sum:\n            # Using the arithmetic series formula: n * (n + 1) / 2\n            _memo_sum[i] = i * (i + 1) // 2\n        return _memo_sum[i]\n\n    # As per design and example tests, handle n <= 0 by returning an empty list.\n    if n <= 0:\n        return []\n\n    result_list = []\n    for i in range(1, n + 1):\n        if i % 2 == 0:  # Even 1-based index\n            result_list.append(_calculate_factorial(i))\n        else:  # Odd 1-based index\n            result_list.append(_calculate_sum_up_to(i))\n    return result_list"}
{"task_id": "HumanEval/114", "solution": "def minSubArraySum(nums):\n    \"\"\"\n    Given an array of integers nums, find the minimum sum of any non-empty sub-array\n    of nums. This uses a variant of Kadane's algorithm for optimal performance.\n    \"\"\"\n    current_min_sum = nums[0]\n    overall_min_sum = nums[0]\n\n    for num in nums[1:]:\n        current_min_sum = min(num, current_min_sum + num)\n        overall_min_sum = min(overall_min_sum, current_min_sum)\n\n    return overall_min_sum"}
{"task_id": "HumanEval/114", "solution": "def minSubArraySum(nums):\n    \"\"\"\n    Given an array of integers nums, find the minimum sum of any non-empty sub-array of nums.\n    This uses a modified Kadane's algorithm to track the minimum current sum and overall minimum sum.\n    \"\"\"\n    min_so_far = nums[0]\n    current_min = nums[0]\n\n    for i in range(1, len(nums)):\n        current_min = min(nums[i], current_min + nums[i])\n        min_so_far = min(min_so_far, current_min)\n\n    return min_so_far"}
{"task_id": "HumanEval/115", "solution": "import math\ndef max_fill(grid, capacity):\n    \"\"\"\n    Calculates the total number of times buckets need to be lowered to empty all wells.\n    Each 1 in the grid represents a unit of water, and capacity is the bucket's fill limit.\n    \"\"\"\n    total_bucket_lowers = 0\n    for well in grid:\n        # FR1: Calculate total water units in a single well.\n        water_units = sum(well)\n\n        # FR2: Calculate bucket lowers required for a single well.\n        # Only perform operations if there is water to be removed.\n        if water_units > 0:\n            lowers_for_well = math.ceil(water_units / capacity)\n            total_bucket_lowers += lowers_for_well\n\n    # FR3: Sum bucket lowers across all wells.\n    return total_bucket_lowers"}
{"task_id": "HumanEval/115", "solution": "import math\ndef max_fill(grid, capacity):\n    \"\"\"\n    Calculates the total number of times buckets need to be lowered to empty all wells.\n    Each well's water is summed, and then divided by capacity, rounding up for lowers.\n    \"\"\"\n    total_lowers = 0\n    for well_data in grid:\n        # Calculate total water units in the current well.\n        total_water_in_well = sum(well_data)\n\n        # Calculate bucket lowers required for this single well.\n        if total_water_in_well == 0:\n            lowers_for_well = 0\n        else:\n            lowers_for_well = math.ceil(total_water_in_well / capacity)\n\n        total_lowers += lowers_for_well\n\n    return total_lowers"}
{"task_id": "HumanEval/116", "solution": "def sort_array(arr):\n    \"\"\"Sorts an array of integers by set bit count for non-negatives and decimal value for negatives.\n    Non-negatives with equal bit counts are further sorted by decimal value.\"\"\"\n\n    def _count_set_bits(n: int) -> int:\n        count = 0\n        while n > 0:\n            n &= (n - 1)\n            count += 1\n        return count\n\n    def _get_sort_key(num: int) -> tuple:\n        if num < 0:\n            # Negative numbers are sorted purely by their decimal value.\n            # Using -1 as a primary sort key ensures they appear before any non-negative numbers.\n            return (-1, num)\n        else:\n            # Non-negative numbers are sorted by bit count, then decimal value.\n            return (_count_set_bits(num), num)\n\n    return sorted(arr, key=_get_sort_key)"}
{"task_id": "HumanEval/113", "solution": "def odd_count(lst):\n    \"\"\"Given a list of strings, where each string consists of only digits, return a list.\n    Each element i of the output should be \"the number of odd elements in the\n    string i of the input.\" where all the i's should be replaced by the number\n    of odd digits in the i'th string of the input.\n\n    >>> odd_count(['1234567'])\n    [\"the number of odd elements 4n the str4ng 4 of the 4nput.\"]\n    >>> odd_count(['3',\"11111111\"])\n    [\"the number of odd elements 1n the str1ng 1 of the 1nput.\",\n     \"the number of odd elements 8n the str8ng 8 of the 8nput.\"]\n    \"\"\"\n    results = []\n    for s in lst:\n        odd_digit_count = 0\n        for char_digit in s:\n            if int(char_digit) % 2 != 0:\n                odd_digit_count += 1\n\n        formatted_result = f\"the number of odd elements {odd_digit_count}n the str{odd_digit_count}ng {odd_digit_count} of the {odd_digit_count}nput.\"\n        results.append(formatted_result)\n\n    return results"}
{"task_id": "HumanEval/117", "solution": "def select_words(s, n):\n    \"\"\"Given a string s and a natural number n, you have been tasked to implement\n    a function that returns a list of all words from string s that contain exactly\n    n consonants, in order these words appear in the string s.\n    If the string s is empty then the function should return an empty list.\n    Note: you may assume the input string contains only letters and spaces.\n    Examples:\n    select_words(\"Mary had a little lamb\", 4) ==> [\"little\"]\n    select_words(\"Mary had a little lamb\", 3) ==> [\"Mary\", \"lamb\"]\n    select_words(\"simple white space\", 2) ==> []\n    select_words(\"Hello world\", 4) ==> [\"world\"]\n    select_words(\"Uncle sam\", 3) ==> [\"Uncle\"]\n    \"\"\"\n    VOWELS = {'a', 'e', 'i', 'o', 'u'}\n\n    def _count_consonants(word: str) -> int:\n        \"\"\"Counts consonants in a word.\n        Checks each character (case-insensitive) against predefined vowels.\n        \"\"\"\n        consonant_count = 0\n        lower_word = word.lower()\n        for char in lower_word:\n            if 'a' <= char <= 'z' and char not in VOWELS:\n                consonant_count += 1\n        return consonant_count\n\n    if not s:\n        return []\n\n    words = s.split()\n    result = []\n    for word in words:\n        if _count_consonants(word) == n:\n            result.append(word)\n    return result"}
{"task_id": "HumanEval/117", "solution": "def select_words(s, n):\n    \"\"\"Filters words from a string based on an exact consonant count.\n    Returns words in their original order, handling empty strings.\n    \"\"\"\n    if not s:\n        return []\n\n    VOWELS = \"aeiou\" # Defines the set of vowels for character classification.\n    selected_words = []\n\n    words = s.split() # Tokenizes the input string into individual words.\n\n    for word in words:\n        consonant_count = 0\n        lower_word = word.lower() # Converts the word to lowercase for case-insensitive comparison.\n\n        for char in lower_word:\n            # According to constraints, 'char' will always be a letter here.\n            if char not in VOWELS: # Counts 'y' as a consonant as it's not in VOWELS.\n                consonant_count += 1\n\n        if consonant_count == n:\n            selected_words.append(word)\n\n    return selected_words"}
{"task_id": "HumanEval/118", "solution": "def get_closest_vowel(word):\n    \"\"\"You are given a word. Your task is to find the closest vowel that stands between\n    two consonants from the right side of the word (case sensitive).\n\n    Vowels in the beginning and ending doesn't count. Return empty string if you didn't\n    find any vowel met the above condition.\n\n    You may assume that the given string contains English letter only.\n    \"\"\"\n    _VOWELS = {'a', 'e', 'i', 'o', 'u'}\n\n    def _is_vowel(char: str) -> bool:\n        \"\"\"Checks if a character is a vowel (case-insensitive).\"\"\"\n        return char.lower() in _VOWELS\n\n    def _is_consonant(char: str) -> bool:\n        \"\"\"Checks if a character is an English letter and not a vowel.\"\"\"\n        return char.isalpha() and not _is_vowel(char)\n\n    n = len(word)\n    if n < 3:\n        return \"\"\n\n    # Iterate from right to left, excluding the first and last characters.\n    for i in range(n - 2, 0, -1):\n        current_char = word[i]\n        left_char = word[i - 1]\n        right_char = word[i + 1]\n\n        # Check if the current character is a vowel surrounded by two consonants.\n        if _is_vowel(current_char) and \\\n           _is_consonant(left_char) and \\\n           _is_consonant(right_char):\n            return current_char\n\n    return \"\""}
{"task_id": "HumanEval/119", "solution": "def _is_balanced(s: str) -> bool:\n    \"\"\"Checks if a string of parentheses is balanced.\"\"\"\n    balance = 0\n    for char in s:\n        if char == '(':\n            balance += 1\n        elif char == ')':\n            balance -= 1\n        if balance < 0: # Balance dropped below zero.\n            return False\n    return balance == 0 # Final balance must be zero.\ndef match_parens(lst: list[str]) -> str:\n    \"\"\"\n    Checks if two parenthesis strings can form a balanced string when concatenated in any order.\n    Returns 'Yes' if a balanced string can be formed, 'No' otherwise.\n    \"\"\"\n    s1, s2 = lst[0], lst[1]\n\n    # Check the first concatenation order: string1 + string2\n    if _is_balanced(s1 + s2):\n        return 'Yes'\n\n    # Check the second concatenation order: string2 + string1\n    if _is_balanced(s2 + s1):\n        return 'Yes'\n\n    # If neither order results in a balanced string, return 'No'\n    return 'No'"}
{"task_id": "HumanEval/118", "solution": "def get_closest_vowel(word: str) -> str:\n    \"\"\"Finds the closest vowel from the right that is strictly between two consonants.\n    Returns an empty string if no such vowel is found.\n    \"\"\"\n    n = len(word)\n    if n < 3:\n        return \"\"\n\n    VOWELS = {'a', 'e', 'i', 'o', 'u'}\n\n    # Iterate from the second-to-last character down to the second character (index 1).\n    # This ensures there are characters at word[i-1] and word[i+1] for the CVC pattern.\n    for i in range(n - 2, 0, -1):\n        current_char = word[i]\n        prev_char = word[i - 1]\n        next_char = word[i + 1]\n\n        # Check if the current character is a vowel, and its surrounding characters are consonants.\n        # It's assumed all characters are English letters, so not being a vowel implies being a consonant.\n        if (current_char in VOWELS and\n                prev_char not in VOWELS and\n                next_char not in VOWELS):\n            return current_char\n    return \"\""}
{"task_id": "HumanEval/116", "solution": "def sort_array(arr):\n    \"\"\"\n    In this Kata, you have to sort an array of non-negative integers according to\n    number of ones in their binary representation in ascending order.\n    For similar number of ones, sort based on decimal value.\n\n    It must be implemented like this:\n    >>> sort_array([1, 5, 2, 3, 4]) == [1, 2, 3, 4, 5]\n    >>> sort_array([-2, -3, -4, -5, -6]) == [-6, -5, -4, -3, -2]\n    >>> sort_array([1, 0, 2, 3, 4]) [0, 1, 2, 3, 4]\n    \"\"\"\n\n    def get_sort_key(num: int) -> tuple[int, int]:\n        # This helper generates a tuple key for sorting: (bit_count_priority, decimal_value).\n        # Negative numbers are prioritized lower by assigning a bit count of 0.\n        if num < 0:\n            return (0, num)\n        else:\n            # Inline bit counting using Brian Kernighan's algorithm.\n            n_val = num\n            count = 0\n            while n_val > 0:\n                n_val &= (n_val - 1)\n                count += 1\n            return (count, num)\n\n    return sorted(arr, key=get_sort_key)"}
{"task_id": "HumanEval/120", "solution": "def maximum(arr, k):\n    \"\"\"\n    Given an array arr of integers and a positive integer k, return a sorted list\n    of length k with the maximum k numbers in arr.\n\n    Example 1:\n\n        Input: arr = [-3, -4, 5], k = 3\n        Output: [-4, -3, 5]\n\n    Example 2:\n\n        Input: arr = [4, -4, 4], k = 2\n        Output: [4, 4]\n\n    Example 3:\n\n        Input: arr = [-3, 2, 1, 2, -1, -2, 1], k = 1\n        Output: [2]\n\n    Note:\n        1. The length of the array will be in the range of [1, 1000].\n        2. The elements in the array will be in the range of [-1000, 1000].\n        3. 0 <= k <= len(arr)\n    \"\"\"\n    if not isinstance(arr, list):\n        raise TypeError(\"Input 'arr' must be a list.\")\n    if not all(isinstance(x, int) for x in arr):\n        raise TypeError(\"All elements in 'arr' must be integers.\")\n    if not isinstance(k, int):\n        raise TypeError(\"Input 'k' must be an integer.\")\n\n    if not (0 <= k <= len(arr)):\n        raise ValueError(f\"Input 'k' must be between 0 and {len(arr)} (inclusive).\")\n\n    if k == 0:\n        return []\n\n    # Sort the array in ascending order\n    sorted_arr = sorted(arr)\n\n    # Return the last k elements\n    return sorted_arr[len(sorted_arr) - k:]"}
{"task_id": "HumanEval/119", "solution": "def match_parens(lst):\n    '''\n    Checks if concatenating two parenthesis strings in any order forms a balanced string.\n    A string is balanced if all parentheses match and the balance never drops below zero.\n    '''\n    def _is_balanced(s: str) -> bool:\n        \"\"\"Determines if a given string of parentheses is balanced.\"\"\"\n        balance = 0\n        for char in s:\n            if char == '(':\n                balance += 1\n            else:\n                balance -= 1\n            if balance < 0:\n                return False\n        return balance == 0\n\n    s1, s2 = lst[0], lst[1]\n\n    # Check order 1: s1 + s2\n    if _is_balanced(s1 + s2):\n        return 'Yes'\n\n    # Check order 2: s2 + s1\n    if _is_balanced(s2 + s1):\n        return 'Yes'\n\n    return 'No'"}
