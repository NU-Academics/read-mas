{"task_id": "HumanEval/46", "solution": "def fib4(n: int):\n    \"\"\"The Fib4 number sequence is defined by fib4(0)=0, fib4(1)=0, fib4(2)=2, fib4(3)=0, and fib4(n) = fib4(n-1) + fib4(n-2) + fib4(n-3) + fib4(n-4) for n > 3. This function computes the n-th element iteratively.\n    >>> fib4(5)\n    4\n    >>> fib4(6)\n    8\n    >>> fib4(7)\n    14\n    \"\"\"\n    if n == 0:\n        return 0\n    if n == 1:\n        return 0\n    if n == 2:\n        return 2\n    if n == 3:\n        return 0\n\n    # Using a rolling array for O(1) space complexity.\n    # Stores [fib4(k-4), fib4(k-3), fib4(k-2), fib4(k-1)] for current k.\n    last_four = [0, 0, 2, 0] # Represents fib4(0), fib4(1), fib4(2), fib4(3)\n\n    for _ in range(4, n + 1):\n        next_fib4 = sum(last_four)\n        # Shift elements to prepare for the next iteration\n        last_four[0] = last_four[1]\n        last_four[1] = last_four[2]\n        last_four[2] = last_four[3]\n        last_four[3] = next_fib4\n\n    return last_four[3]"}
{"task_id": "HumanEval/47", "solution": "def median(l: list):\n    \"\"\"Return median of elements in the list l.\n    >>> median([3, 1, 2, 4, 5])\n    3\n    >>> median([-10, 4, 6, 1000, 10, 20])\n    15.0\n    \"\"\"\n    sorted_l = sorted(l)\n    n = len(sorted_l)\n\n    if n % 2 == 1:\n        # Odd number of elements: return the middle element.\n        return sorted_l[n // 2]\n    else:\n        # Even number of elements: return the average of the two middle elements.\n        mid1 = sorted_l[n // 2 - 1]\n        mid2 = sorted_l[n // 2]\n        return (mid1 + mid2) / 2.0"}
{"task_id": "HumanEval/47", "solution": "def median(l: list) -> float:\n    \"\"\"\n    Returns the median of elements in the list l.\n    The input list is assumed to be non-empty and contain only numeric values.\n    \"\"\"\n    sorted_data = sorted(l)\n    n = len(sorted_data)\n\n    if n % 2 == 1:\n        return float(sorted_data[n // 2])\n    else:\n        mid1 = sorted_data[n // 2 - 1]\n        mid2 = sorted_data[n // 2]\n        return (float(mid1) + float(mid2)) / 2.0"}
