{"task_id": "HumanEval/44", "solution": "class InvalidInputError(ValueError):\n    \"\"\"Custom exception for invalid input values.\"\"\"\n    pass\nclass InvalidBaseError(ValueError):\n    \"\"\"Custom exception for invalid base values.\"\"\"\n    pass\ndef change_base(x: int, base: int) -> str:\n    \"\"\"Change numerical base of input number x to base.\n    return string representation after the conversion.\n    base numbers are less than 10.\n    >>> change_base(8, 3)\n    '22'\n    >>> change_base(8, 2)\n    '1000'\n    >>> change_base(7, 2)\n    '111'\n    \"\"\"\n    if not isinstance(x, int) or x < 0:\n        raise InvalidInputError(f\"'x' must be a non-negative integer. Got: {x}\")\n\n    if not isinstance(base, int) or not (2 <= base < 10):\n        raise InvalidBaseError(f\"Base must be an integer between 2 and 9 (inclusive). Got: {base}\")\n\n    if x == 0:\n        return \"0\"\n\n    result = []\n    current_x = x\n    while current_x > 0:\n        remainder = current_x % base\n        result.append(str(remainder))\n        current_x //= base\n\n    return \"\".join(reversed(result))"}
{"task_id": "HumanEval/49", "solution": "def modp(n: int, p: int):\n    \"\"\"Return 2^n modulo p (be aware of numerics).\n    >>> modp(3, 5)\n    3\n    >>> modp(1101, 101)\n    2\n    >>> modp(0, 101)\n    1\n    >>> modp(3, 11)\n    8\n    >>> modp(100, 101)\n    1\n    \"\"\"\n    if n < 0:\n        raise ValueError(\"Exponent 'n' must be a non-negative integer.\")\n    if p <= 0:\n        raise ValueError(\"Modulus 'p' must be a positive integer.\")\n\n    if n == 0:\n        return 1 % p\n\n    result = 1\n    base = 2 % p\n    exponent = n\n\n    while exponent > 0:\n        if exponent % 2 == 1:\n            result = (result * base) % p\n        base = (base * base) % p\n        exponent //= 2\n    return result"}
{"task_id": "HumanEval/49", "solution": "def modp(n: int, p: int) -> int:\n    \"\"\"Calculates (2^n) % p using binary exponentiation.\n    This method efficiently computes modular exponentiation for large integers.\n    \"\"\"\n    result = 1\n    base = 2 % p\n\n    while n > 0:\n        if n % 2 == 1:\n            result = (result * base) % p\n        base = (base * base) % p\n        n //= 2\n    return result"}
