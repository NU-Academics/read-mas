{"task_id": "HumanEval/25", "solution": "from typing import List\ndef factorize(n: int) -> List[int]:\n    \"\"\"\n    Returns a list of prime factors for a given integer n, ordered from smallest to largest.\n    Each factor appears as many times as its multiplicity in the factorization.\n    \"\"\"\n    if n <= 1:\n        return []\n\n    factors = []\n    d = 2\n\n    while d * d <= n:\n        while n % d == 0:\n            factors.append(d)\n            n //= d\n        d += 1\n\n    if n > 1:\n        factors.append(n)\n\n    return factors"}
{"task_id": "HumanEval/25", "solution": "from typing import List\ndef factorize(n: int) -> List[int]:\n    \"\"\"Returns a list of prime factors for a given integer `n`, sorted smallest to largest.\n    Each factor appears according to its multiplicity, and their product equals `n`.\n    \"\"\"\n    factors = []\n    d = 2\n    temp_n = n\n    while d * d <= temp_n:\n        while temp_n % d == 0:\n            factors.append(d)\n            temp_n //= d\n        d += 1\n    if temp_n > 1:\n        factors.append(temp_n)\n    return factors"}
