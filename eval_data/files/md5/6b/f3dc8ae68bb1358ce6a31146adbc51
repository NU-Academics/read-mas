{"task_id": "HumanEval/37", "solution": "def sort_even(l: list):\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the odd indicies, while its values at the even indicies are equal\n    to the values of the even indicies of l, but sorted.\n    >>> sort_even([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_even([5, 6, 3, 4])\n    [3, 6, 5, 4]\n    \"\"\"\n    if not l:\n        return []\n\n    even_elements = []\n    for i in range(0, len(l), 2):\n        even_elements.append(l[i])\n\n    even_elements.sort()\n\n    result = list(l) # Create a shallow copy to modify even indices\n    even_idx_counter = 0\n    for i in range(0, len(l), 2):\n        result[i] = even_elements[even_idx_counter]\n        even_idx_counter += 1\n\n    return result"}
{"task_id": "HumanEval/36", "solution": "def fizz_buzz(n: int) -> int:\n    \"\"\"Return the number of times the digit 7 appears in integers less than n which are divisible by 11 or 13.\n    >>> fizz_buzz(50)\n    0\n    >>> fizz_buzz(78)\n    2\n    >>> fizz_buzz(79)\n    3\n    \"\"\"\n    total_sevens_count = 0\n\n    for i in range(1, n):\n        if i % 11 == 0 or i % 13 == 0:\n            total_sevens_count += str(i).count('7')\n\n    return total_sevens_count"}
{"task_id": "HumanEval/37", "solution": "def sort_even(l: list):\n    \"\"\"\n    This function takes a list l and returns a new list l' with even-indexed elements sorted.\n    Odd-indexed elements in l' remain in their original positions from l.\n    \"\"\"\n\n    even_elements = [l[i] for i in range(0, len(l), 2)]\n    even_elements.sort()\n\n    result_list = l[:]\n\n    sorted_idx = 0\n    for i in range(0, len(l), 2):\n        result_list[i] = even_elements[sorted_idx]\n        sorted_idx += 1\n\n    return result_list"}
{"task_id": "HumanEval/36", "solution": "def fizz_buzz(n: int) -> int:\n    \"\"\"\n    Return the number of times the digit '7' appears in integers less than n\n    which are divisible by 11 or 13.\n    \"\"\"\n    TARGET_DIGIT = \"7\"\n    total_sevens = 0\n\n    for i in range(1, n):\n        # Check if 'i' is divisible by 11 or 13.\n        if (i % 11 == 0) or (i % 13 == 0):\n            # Convert 'i' to string and count occurrences of TARGET_DIGIT.\n            total_sevens += str(i).count(TARGET_DIGIT)\n\n    return total_sevens"}
