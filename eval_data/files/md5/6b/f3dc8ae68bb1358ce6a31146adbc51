{"task_id": "HumanEval/4", "solution": "from typing import List\ndef mean_absolute_deviation(numbers: List[float]) -> float:\n    \"\"\" For a given list of input numbers, calculate Mean Absolute Deviation\n    around the mean of this dataset.\n    Mean Absolute Deviation is the average absolute difference between each\n    element and a centerpoint (mean in this case):\n    MAD = average | x - x_mean |\n    >>> mean_absolute_deviation([1.0, 2.0, 3.0, 4.0])\n    1.0\n    \"\"\"\n\n    def _calculate_mean(data: List[float]) -> float:\n        \"\"\"Calculates the arithmetic mean of a list of numbers.\"\"\"\n        return sum(data) / len(data)\n\n    def _calculate_absolute_differences(data: List[float], mean_val: float) -> List[float]:\n        \"\"\"Calculates the absolute difference between each number and the mean.\"\"\"\n        return [abs(x - mean_val) for x in data]\n\n    mean = _calculate_mean(numbers)\n    absolute_differences = _calculate_absolute_differences(numbers, mean)\n    mad = _calculate_mean(absolute_differences)\n\n    return mad"}
{"task_id": "HumanEval/8", "solution": "from typing import List, Tuple\ndef sum_product(numbers: List[int]) -> Tuple[int, int]:\n    \"\"\"For a given list of integers, return a tuple consisting of a sum and a product of all the integers in a list.\n    Empty sum should be equal to 0 and empty product should be equal to 1.\n    \"\"\"\n    current_sum = 0\n    current_product = 1\n\n    for number in numbers:\n        current_sum += number\n        current_product *= number\n\n    return (current_sum, current_product)"}
{"task_id": "HumanEval/6", "solution": "from typing import List\ndef _calculate_max_depth(group_string: str) -> int:\n    \"\"\"\n    Calculates the deepest nesting level for a single group of parentheses.\n    Returns 0 for empty, whitespace-only, or malformed groups.\n    \"\"\"\n    max_depth = 0\n    current_depth = 0\n    for char in group_string:\n        if char == '(':\n            current_depth += 1\n            max_depth = max(max_depth, current_depth)\n        elif char == ')':\n            current_depth -= 1\n        if current_depth < 0:\n            return 0\n\n    if current_depth != 0:\n        return 0\n    return max_depth\ndef parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\"\n    Parses a string of space-separated parentheses groups to find the deepest nesting level for each.\n    Returns a list of these maximum depths.\n    \"\"\"\n    if not paren_string.strip():\n        return []\n\n    groups = paren_string.split(' ')\n    results = []\n    for group in groups:\n        if group.strip():\n            results.append(_calculate_max_depth(group))\n        else:\n            results.append(0)\n    return results"}
{"task_id": "HumanEval/8", "solution": "from typing import List, Tuple\ndef sum_product(numbers: List[int]) -> Tuple[int, int]:\n    \"\"\" For a given list of integers, return a tuple consisting of a sum and a product of all the integers in a list.\n    Empty sum should be equal to 0 and empty product should be equal to 1.\n    \"\"\"\n    if not numbers:\n        return (0, 1)\n\n    total_sum = 0\n    total_product = 1\n    for num in numbers:\n        total_sum += num\n        total_product *= num\n    return (total_sum, total_product)"}
{"task_id": "HumanEval/9", "solution": "from typing import List\ndef rolling_max(numbers: List[int]) -> List[int]:\n    \"\"\" From a given list of integers, generate a list of rolling maximum element found until given moment\n    in the sequence.\n    \"\"\"\n    if not numbers:\n        return []\n\n    rolling_max_list: List[int] = []\n    current_max: int = numbers[0]\n\n    for number in numbers:\n        if number > current_max:\n            current_max = number\n        rolling_max_list.append(current_max)\n\n    return rolling_max_list"}
{"task_id": "HumanEval/6", "solution": "from typing import List\ndef parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\" Input to this function is a string represented multiple groups for nested parentheses separated by spaces.\n    For each of the group, output the deepest level of nesting of parentheses.\n    E.g. (()()) has maximum two levels of nesting while ((())) has three.\n\n    >>> parse_nested_parens('(()()) ((())) () ((())()())')\n    [2, 3, 1, 3]\n    \"\"\"\n\n    def _calculate_single_group_depth(group_str: str) -> int:\n        \"\"\"Calculates the maximum nesting depth within a single parentheses group string.\"\"\"\n        current_depth = 0\n        max_depth = 0\n        for char in group_str:\n            if char == '(':\n                current_depth += 1\n                max_depth = max(max_depth, current_depth)\n            elif char == ')':\n                current_depth -= 1\n        return max_depth\n\n    group_strings = paren_string.split(' ')\n    results: List[int] = []\n\n    for group_str in group_strings:\n        if group_str:  # Skip empty strings that result from multiple spaces.\n            depth = _calculate_single_group_depth(group_str)\n            results.append(depth)\n\n    return results"}
{"task_id": "HumanEval/10", "solution": "def is_palindrome(string: str) -> bool:\n    \"\"\"Checks if a string is a palindrome.\"\"\"\n    return string == string[::-1]\ndef make_palindrome(string: str) -> str:\n    \"\"\"Finds the shortest palindrome that begins with the supplied string.\n    Appends reversed prefixes to achieve the palindrome.\n    \"\"\"\n    if is_palindrome(string):\n        return string\n\n    n = len(string)\n    for i in range(n):\n        suffix = string[i:]\n        if is_palindrome(suffix):\n            prefix_to_reverse = string[:i]\n            return string + prefix_to_reverse[::-1]\n    return string  # This point should not be reached for non-empty inputs."}
{"task_id": "HumanEval/9", "solution": "from typing import List\ndef rolling_max(numbers: List[int]) -> List[int]:\n    \"\"\" From a given list of integers, generate a list of rolling maximum element found until given moment\n    in the sequence.\n    >>> rolling_max([1, 2, 3, 2, 3, 4, 2])\n    [1, 2, 3, 3, 3, 4, 4]\n    \"\"\"\n    if not numbers:\n        return []\n\n    rolling_max_list = []\n    current_max = float('-inf')\n\n    for num in numbers:\n        if num > current_max:\n            current_max = num\n        rolling_max_list.append(current_max)\n    return rolling_max_list"}
{"task_id": "HumanEval/11", "solution": "def string_xor(a: str, b: str) -> str:\n    \"\"\"Performs binary XOR on two input strings consisting only of '1's and '0's.\n    Pads the shorter string with leading zeros if lengths differ.\n    \"\"\"\n    max_len = max(len(a), len(b))\n    a_padded = a.zfill(max_len)\n    b_padded = b.zfill(max_len)\n\n    result_chars = []\n    for i in range(max_len):\n        if a_padded[i] == b_padded[i]:\n            result_chars.append('0')\n        else:\n            result_chars.append('1')\n    return \"\".join(result_chars)"}
{"task_id": "HumanEval/10", "solution": "def is_palindrome(string: str) -> bool:\n    \"\"\" Test if given string is a palindrome \"\"\"\n    return string == string[::-1]\ndef make_palindrome(string: str) -> str:\n    \"\"\" Find the shortest palindrome that begins with a supplied string.\n    It does this by finding the longest palindromic suffix and appending the reversed prefix.\n    \"\"\"\n    if is_palindrome(string):\n        return string\n\n    for i in range(len(string)):\n        suffix = string[i:]\n        if is_palindrome(suffix):\n            prefix_to_reverse = string[:i]\n            return string + prefix_to_reverse[::-1]\n\n    # This case should theoretically not be reached for any string,\n    # as an empty string (when i=len(string)) is always a palindrome,\n    # and a single character string (when i=len(string)-1) is always a palindrome.\n    # However, for full coverage, it implies the original string itself.\n    return string"}
{"task_id": "HumanEval/12", "solution": "from typing import List, Optional\ndef longest(strings: List[str]) -> Optional[str]:\n    \"\"\"Out of list of strings, return the longest one.\n    Returns the first one in case of multiple strings of the same length, or None if the input list is empty.\n    \"\"\"\n    if not strings:\n        return None\n\n    current_longest_string = \"\"\n    maximum_length = -1\n\n    for s in strings:\n        if len(s) > maximum_length:\n            maximum_length = len(s)\n            current_longest_string = s\n    return current_longest_string"}
{"task_id": "HumanEval/11", "solution": "def string_xor(a: str, b: str) -> str:\n    \"\"\" Input are two strings a and b consisting only of 1s and 0s.\n    Perform binary XOR on these inputs and return result also as a string.\n    >>> string_xor('010', '110')\n    '100'\n    \"\"\"\n    max_len = max(len(a), len(b))\n    # Pad shorter string with leading '0's to match the length of the longer string.\n    a_padded = a.zfill(max_len)\n    b_padded = b.zfill(max_len)\n\n    result = []\n    for i in range(max_len):\n        bit_a = int(a_padded[i])\n        bit_b = int(b_padded[i])\n        result.append(str(bit_a ^ bit_b))\n    return \"\".join(result)"}
{"task_id": "HumanEval/13", "solution": "def greatest_common_divisor(a: int, b: int) -> int:\n    \"\"\" Return a greatest common divisor of two integers a and b\n    >>> greatest_common_divisor(3, 5)\n    1\n    >>> greatest_common_divisor(25, 15)\n    5\n    \"\"\"\n    # Ensure inputs are non-negative for the standard Euclidean algorithm.\n    # The GCD is typically defined as a positive integer.\n    a = abs(a)\n    b = abs(b)\n\n    while b:\n        a, b = b, a % b\n    return a"}
{"task_id": "HumanEval/12", "solution": "from typing import List, Optional\ndef longest(strings: List[str]) -> Optional[str]:\n    \"\"\" Out of list of strings, return the longest one. Return the first one in case of multiple\n    strings of the same length. Return None in case the input list is empty.\n    >>> longest([])\n\n    >>> longest(['a', 'b', 'c'])\n    'a'\n    >>> longest(['a', 'bb', 'ccc'])\n    'ccc'\n    \"\"\"\n    if not strings:\n        return None\n\n    # Initialize with values that ensure any string (even an empty one) will be considered longer.\n    current_longest = \"\"\n    max_length = -1\n\n    for s in strings:\n        if len(s) > max_length:\n            max_length = len(s)\n            current_longest = s\n    return current_longest"}
