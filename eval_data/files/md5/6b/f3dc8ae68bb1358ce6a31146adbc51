{"task_id": "HumanEval/65", "solution": "def circular_shift(x, shift):\n    \"\"\"\n    Circularly shifts the digits of x to the right by 'shift' positions.\n    If 'shift' is greater than the number of digits in x, the digits are reversed.\n    \"\"\"\n    s_x = str(x)\n    length = len(s_x)\n\n    if shift > length:\n        return s_x[::-1]\n    else:\n        effective_shift = shift % length\n        return s_x[length - effective_shift:] + s_x[:length - effective_shift]"}
{"task_id": "HumanEval/64", "solution": "def vowels_count(s):\n    \"\"\"Counts the number of vowels in a given string.\n\n    Vowels are 'a', 'e', 'i', 'o', 'u'. 'y' is counted as a vowel\n    only if it appears at the end of a word. The count is case-insensitive.\n\n    Examples:\n    >>> vowels_count(\"hello world\")\n    3\n    >>> vowels_count(\"\")\n    0\n    >>> vowels_count(\"rhythm\")\n    1\n    >>> vowels_count(\"fly\")\n    1\n    >>> vowels_count(\"sky\")\n    1\n    >>> vowels_count(\"mystery\")\n    2\n    >>> vowels_count(\"happy yellow\")\n    4\n    >>> vowels_count(\"AEIOUaeiou\")\n    10\n    >>> vowels_count(\"The quick brown fox jumps over the lazy dog\")\n    12\n    >>> vowels_count(\"crypt\")\n    1\n    >>> vowels_count(\"gym\")\n    1\n    \"\"\"\n    count = 0\n    lower_s = s.lower()\n\n    _VOWELS = {'a', 'e', 'i', 'o', 'u'}\n\n    words = lower_s.split()\n\n    for char_index, char in enumerate(lower_s):\n        if char in _VOWELS:\n            count += 1\n        elif char == 'y':\n            is_at_end_of_word = False\n            for word in words:\n                # This logic checks if the 'y' character's index matches the end of a word segment.\n                # Note: lower_s.find(word) returns the index of the first occurrence of 'word'.\n                if word.endswith('y') and char_index == lower_s.find(word) + len(word) - 1:\n                    is_at_end_of_word = True\n                    break\n            if is_at_end_of_word:\n                count += 1\n    return count"}
{"task_id": "HumanEval/66", "solution": "def digitSum(s):\n    \"\"\"\n    Calculates the sum of the ASCII codes of only the uppercase characters in a string.\n    Only uppercase characters 'A' through 'Z' contribute to the total sum.\n    \"\"\"\n    total_sum = 0\n    for char in s:\n        if 'A' <= char <= 'Z':\n            total_sum += ord(char)\n    return total_sum"}
{"task_id": "HumanEval/65", "solution": "def circular_shift(x: int, shift: int) -> str:\n    \"\"\"Circular shift the digits of the integer x, shift the digits right by shift\n    and return the result as a string. If shift > number of digits, return digits reversed.\n    \"\"\"\n    x_str = str(x)\n    num_digits = len(x_str)\n\n    if shift > num_digits:\n        return x_str[::-1]\n    else:\n        effective_shift = shift % num_digits\n        if effective_shift == 0:\n            return x_str\n        return x_str[-effective_shift:] + x_str[:-effective_shift]"}
{"task_id": "HumanEval/66", "solution": "def digitSum(s: str) -> int:\n    \"\"\"Calculates the sum of ASCII values of all uppercase characters in the input string.\n    Returns 0 if the string is empty or contains no uppercase characters.\n    \"\"\"\n    total_sum = 0\n    for char in s:\n        if char.isupper():\n            total_sum += ord(char)\n    return total_sum"}
{"task_id": "HumanEval/67", "solution": "def fruit_distribution(s,n):\n    \"\"\"\n    Calculates the number of mangoes in a fruit basket.\n    It subtracts the counts of apples and oranges from the total fruits.\n    \"\"\"\n    # Extract apple count\n    parts = s.split(\" apples and \")\n    apple_count = int(parts[0])\n\n    # Extract orange count\n    orange_part = parts[1]\n    orange_count = int(orange_part.split(\" oranges\")[0])\n\n    # Calculate mango count\n    mango_count = n - (apple_count + orange_count)\n    return mango_count"}
{"task_id": "HumanEval/64", "solution": "def vowels_count(s):\n    \"\"\"Counts vowels in a string, where 'y' is a vowel only if it's the last character.\n    Case-insensitivity is applied for all vowel checks.\"\"\"\n    count = 0\n    for i, char in enumerate(s):\n        char_lower = char.lower()\n        if char_lower in 'aeiou':\n            count += 1\n        elif char_lower == 'y' and i == len(s) - 1:\n            count += 1\n    return count"}
{"task_id": "HumanEval/67", "solution": "import re\ndef fruit_distribution(s, n):\n    \"\"\"\n    Calculates the number of mango fruits.\n    It parses apple and orange counts from 's' and subtracts them from 'n'.\n    \"\"\"\n    # Parse the input string to extract the number of apples and oranges.\n    # The design assumes the string format \"X apples and Y oranges\".\n    match = re.match(r\"(\\d+)\\s*apples\\s*and\\s*(\\d+)\\s*oranges\", s)\n\n    # As per CRITICAL REQUIREMENTS, trust caller's inputs and do not raise exceptions.\n    # Assume match is successful and groups exist.\n    apples = int(match.group(1))\n    oranges = int(match.group(2))\n\n    # Calculate the number of mango fruits.\n    # As per CRITICAL REQUIREMENTS, do not raise exceptions for edge cases\n    # like sum exceeding total or negative counts.\n    mango_count = n - apples - oranges\n\n    return mango_count"}
{"task_id": "HumanEval/68", "solution": "def pluck(arr):\n    \"\"\"\n    Finds the smallest even-valued node and its index in an array.\n    Returns [value, index] or [] if no even numbers or array is empty.\n    \"\"\"\n    if not arr:\n        return []\n\n    smallest_even_value = float('inf')\n    smallest_even_index = -1\n\n    for i, value in enumerate(arr):\n        if value % 2 == 0:  # Check if the value is even\n            if value < smallest_even_value:\n                smallest_even_value = value\n                smallest_even_index = i\n            elif value == smallest_even_value and i < smallest_even_index:\n                # If same smallest even value, prefer smaller index\n                smallest_even_index = i\n\n    if smallest_even_index != -1:\n        return [smallest_even_value, smallest_even_index]\n    else:\n        return []"}
{"task_id": "HumanEval/70", "solution": "def strange_sort_list(lst):\n    '''\n    Given list of integers, return list in strange order.\n    Strange sorting, is when you start with the minimum value,\n    then maximum of the remaining integers, then minimum and so on.\n\n    Examples:\n    strange_sort_list([1, 2, 3, 4]) == [1, 4, 2, 3]\n    strange_sort_list([5, 5, 5, 5]) == [5, 5, 5, 5]\n    strange_sort_list([]) == []\n    '''\n    if not lst:\n        return []\n\n    sorted_list = sorted(lst)\n    result = []\n    is_min_turn = True\n\n    while sorted_list:\n        if is_min_turn:\n            result.append(sorted_list.pop(0))\n        else:\n            result.append(sorted_list.pop())\n        is_min_turn = not is_min_turn\n    return result"}
{"task_id": "HumanEval/69", "solution": "def search(lst: list[int]) -> int:\n    \"\"\"\n    Finds the greatest integer in a list whose frequency is greater than or equal to its value.\n    Returns -1 if no such integer exists.\n    \"\"\"\n\n    # Calculate the frequency of each unique integer in the list.\n    frequency_map = {}\n    for num in lst:\n        frequency_map[num] = frequency_map.get(num, 0) + 1\n\n    qualifying_integers = []\n    # Identify all integers 'n' such that their frequency 'f' satisfies 'f >= n'.\n    for num, freq in frequency_map.items():\n        if freq >= num:\n            qualifying_integers.append(num)\n\n    # Return the greatest qualifying integer, or -1 if no such value exists.\n    if not qualifying_integers:\n        return -1\n\n    return max(qualifying_integers)"}
{"task_id": "HumanEval/68", "solution": "def pluck(arr):\n    \"\"\"\n    Finds the smallest even non-negative integer and its index in an array.\n    Returns [value, index] or an empty list if no even values or the array is empty.\n    \"\"\"\n    if not arr:\n        return []\n\n    smallest_even_value = None\n    smallest_even_index = None\n\n    for i, value in enumerate(arr):\n        # Trusting input (no isinstance or negative checks as per critical requirements)\n        if value % 2 == 0:  # Check if it's an even number\n            if smallest_even_value is None or value < smallest_even_value:\n                smallest_even_value = value\n                smallest_even_index = i\n            elif value == smallest_even_value and i < smallest_even_index:\n                # Tie-breaking: same smallest even value, but current index is smaller\n                smallest_even_index = i\n\n    if smallest_even_value is None:\n        return []"}
{"task_id": "HumanEval/69", "solution": "def search(lst):\n    \"\"\"\n    Finds the greatest integer in the list that meets the criteria:\n    - Frequency is greater than or equal to its value.\n    Returns the greatest qualifying integer, or -1 if no such integer exists.\n    \"\"\"\n    frequency_map = {}\n    for item in lst:\n        frequency_map[item] = frequency_map.get(item, 0) + 1\n\n    qualifying_integers = []\n    for num, freq in frequency_map.items():\n        if freq >= num:\n            qualifying_integers.append(num)\n\n    if not qualifying_integers:\n        return -1\n\n    return max(qualifying_integers)"}
{"task_id": "HumanEval/70", "solution": "def strange_sort_list(lst):\n    \"\"\"\n    Given list of integers, return list in strange order.\n    Strange sorting starts with the minimum, then maximum of remaining, and so on.\n    \"\"\"\n    if not lst:\n        return []\n\n    mutable_list = sorted(lst) # Initial sort to easily pick min/max\n    result = []\n    is_min_turn = True\n\n    while mutable_list:\n        if is_min_turn:\n            result.append(mutable_list.pop(0)) # Append the current smallest element\n        else:\n            result.append(mutable_list.pop()) # Append the current largest element\n        is_min_turn = not is_min_turn\n    return result"}
{"task_id": "HumanEval/71", "solution": "import math\ndef triangle_area(a, b, c):\n    \"\"\"\n    Given the lengths of the three sides of a triangle. Return the area of\n    the triangle rounded to 2 decimal points if the three sides form a valid triangle.\n    Otherwise return -1.\n    \"\"\"\n    # Validate if the sides form a valid triangle: must be positive and satisfy triangle inequality.\n    if not (a > 0 and b > 0 and c > 0) or not ((a + b > c) and (a + c > b) and (b + c > a)):\n        return -1.0\n\n    # Calculate the semi-perimeter.\n    s = (a + b + c) / 2\n\n    # Calculate the area using Heron's formula.\n    area_squared = s * (s - a) * (s - b) * (s - c)\n\n    # Handle potential floating-point inaccuracies where area_squared might be slightly negative.\n    if area_squared < 0:\n        raw_area = 0.0\n    else:\n        raw_area = math.sqrt(area_squared)\n\n    # Round the calculated area to two decimal points.\n    return round(raw_area, 2)"}
{"task_id": "HumanEval/72", "solution": "def will_it_fly(q,w):\n  '''\n  Write a function that returns True if the object q will fly, and False otherwise.\n  The object q will fly if it's balanced (it is a palindromic list) and the sum of its elements is less than or equal the maximum possible weight w.\n  '''\n  is_balanced = q == q[::-1]\n  total_weight = sum(q)\n\n  return is_balanced and (total_weight <= w)"}
{"task_id": "HumanEval/73", "solution": "def smallest_change(arr):\n    \"\"\"\n    Given an array arr of integers, find the minimum changes needed to make it palindromic.\n    One change alters an element.\n    \"\"\"\n    changes_count = 0\n    left = 0\n    right = len(arr) - 1\n\n    while left < right:\n        if arr[left] != arr[right]:\n            changes_count += 1\n        left += 1\n        right -= 1\n    return changes_count"}
{"task_id": "HumanEval/72", "solution": "def will_it_fly(q,w):\n    \"\"\"\n    Determines if the object q will fly based on balance and weight.\n    It returns True if q is a palindromic list and its sum is less than or equal to w.\n    \"\"\"\n    is_balanced = (q == q[::-1])\n    total_weight = sum(q)\n    is_within_weight = (total_weight <= w)\n\n    return is_balanced and is_within_weight"}
{"task_id": "HumanEval/71", "solution": "import math\ndef triangle_area(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle. Return the area of\n    the triangle rounded to 2 decimal points if the three sides form a valid triangle.\n    Otherwise return -1\n    '''\n    # Validate if all sides are positive and satisfy the triangle inequality theorem.\n    if not (a > 0 and b > 0 and c > 0 and\n            a + b > c and a + c > b and b + c > a):\n        return -1.0\n\n    # Calculate the semi-perimeter and then the area using Heron's formula.\n    s = (a + b + c) / 2\n    area = math.sqrt(s * (s - a) * (s - b) * (s - c))\n\n    # Round the calculated area to two decimal places.\n    return round(area, 2)"}
