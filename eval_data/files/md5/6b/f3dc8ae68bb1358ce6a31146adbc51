{"task_id": "HumanEval/82", "solution": "def prime_length(string):\n    \"\"\"Checks if the string length is a prime number.\n    Returns True if prime, False otherwise.\"\"\"\n    length = len(string)\n\n    if length < 2:\n        return False\n\n    for i in range(2, int(length**0.5) + 1):\n        if length % i == 0:\n            return False\n\n    return True"}
{"task_id": "HumanEval/82", "solution": "def _is_prime(n: int) -> bool:\n    \"\"\"Checks if an integer is a prime number.\n    Returns True if n is prime, False otherwise.\"\"\"\n    if n <= 1:\n        return False\n    if n <= 3:\n        return True\n    if n % 2 == 0 or n % 3 == 0:\n        return False\n    i = 5\n    while i * i <= n:\n        if n % i == 0 or n % (i + 2) == 0:\n            return False\n        i += 6\n    return True\ndef prime_length(string):\n    \"\"\"Checks if the length of a string is a prime number.\n    Returns True if the length is prime, False otherwise.\"\"\"\n    length = len(string)\n    return _is_prime(length)"}
{"task_id": "HumanEval/81", "solution": "def numerical_letter_grade(grades):\n    \"\"\"Converts a list of numerical GPAs into a list of corresponding letter grades.\n    The conversion uses a specific grading scale provided in the problem statement.\n    \"\"\"\n    letter_grades = []\n    for gpa in grades:\n        if gpa == 4.0:\n            letter_grades.append(\"A+\")\n        elif gpa > 3.7:\n            letter_grades.append(\"A\")\n        elif gpa > 3.3:\n            letter_grades.append(\"A-\")\n        elif gpa > 3.0:\n            letter_grades.append(\"B+\")\n        elif gpa > 2.7:\n            letter_grades.append(\"B\")\n        elif gpa > 2.3:\n            letter_grades.append(\"B-\")\n        elif gpa > 2.0:\n            letter_grades.append(\"C+\")\n        elif gpa > 1.7:\n            letter_grades.append(\"C\")\n        elif gpa > 1.3:\n            letter_grades.append(\"C-\")\n        elif gpa > 1.0:\n            letter_grades.append(\"D+\")\n        elif gpa > 0.7:\n            letter_grades.append(\"D\")\n        elif gpa > 0.0:\n            letter_grades.append(\"D-\")\n        else: # gpa is 0.0 or less, as per the grading scale\n            letter_grades.append(\"E\")\n    return letter_grades"}
{"task_id": "HumanEval/83", "solution": "def starts_one_ends(n):\n    \"\"\"\n    Calculates the count of n-digit positive integers that start or end with 1.\n    Uses the principle of inclusion-exclusion for counts where n > 1.\n    \"\"\"\n    if n == 1:\n        return 1\n\n    # Count numbers that start with 1 (e.g., 1xx for n=3)\n    count_starts_with_one = 10**(n - 1)\n\n    # Count numbers that end with 1 (e.g., xxy1 for n=3)\n    count_ends_with_one = 9 * (10**(n - 2))\n\n    # Count numbers that start AND end with 1 (e.g., 1x1 for n=3)\n    count_starts_and_ends_with_one = 10**(n - 2)\n\n    return count_starts_with_one + count_ends_with_one - count_starts_and_ends_with_one"}
{"task_id": "HumanEval/84", "solution": "def solve(N):\n    \"\"\"Given a positive integer N, return the total sum of its digits in binary.\n    Constraints: 0 <= N <= 10000.\n    \"\"\"\n    s = 0\n    temp_N = N\n    if temp_N == 0:\n        s = 0\n    else:\n        while temp_N > 0:\n            s += temp_N % 10\n            temp_N //= 10\n\n    if s == 0:\n        return \"0\"\n    return bin(s)[2:]"}
{"task_id": "HumanEval/83", "solution": "def starts_one_ends(n: int) -> int:\n    \"\"\"\n    Calculates the count of n-digit positive integers that start or end with 1.\n    This function applies the principle of inclusion-exclusion.\n    \"\"\"\n    if n == 1:\n        return 1\n\n    # Count of n-digit numbers starting with 1. The first digit is 1, remaining n-1 digits can be any (0-9).\n    count_starts_with_1 = 10**(n - 1)\n\n    # Count of n-digit numbers ending with 1. The last digit is 1. The first digit can be 1-9, remaining n-2 digits any.\n    count_ends_with_1 = 9 * (10**(n - 2))\n\n    # Count of n-digit numbers starting AND ending with 1. First and last digits are 1, remaining n-2 digits any.\n    count_starts_and_ends_with_1 = 10**(n - 2)\n\n    # Apply inclusion-exclusion principle: P(A or B) = P(A) + P(B) - P(A and B).\n    return count_starts_with_1 + count_ends_with_1 - count_starts_and_ends_with_1"}
{"task_id": "HumanEval/85", "solution": "def add(lst):\n    \"\"\"Given a non-empty list of integers lst, add the even elements that are at odd indices.\n    This function assumes valid input as per the problem statement.\n    \"\"\"\n    total_sum = 0\n    for i, num in enumerate(lst):\n        # Check if the index is odd (1, 3, 5, ...) and the number is even.\n        if i % 2 != 0 and num % 2 == 0:\n            total_sum += num\n    return total_sum"}
{"task_id": "HumanEval/85", "solution": "def add(lst):\n    \"\"\"Sums even elements located at odd indices in the input list.\n    Example: add([4, 2, 6, 7]) ==> 2\n    \"\"\"\n    total_sum = 0\n    for i, element in enumerate(lst):\n        if i % 2 != 0:  # Check if the index is odd\n            if element % 2 == 0:  # Check if the element is even\n                total_sum += element\n    return total_sum"}
{"task_id": "HumanEval/84", "solution": "def int_to_binary_string(num: int) -> str:\n    # Converts a non-negative integer to its binary string representation.\n    # Assumes num is non-negative as per critical requirements.\n    return bin(num)[2:] if num > 0 else \"0\"\ndef calculate_digit_sum(n: int) -> int:\n    # Calculates the sum of decimal digits for a given integer n.\n    # It converts the number to a string and sums its digits.\n    total_sum = 0\n    s_n = str(n)\n    for digit_char in s_n:\n        total_sum += int(digit_char)\n    return total_sum\ndef solve(N: int) -> str:\n    # Given an integer N, returns the sum of its digits in binary.\n    # Assumes N is a valid integer between 0 and 10000.\n    digit_sum = calculate_digit_sum(N)\n    binary_sum_str = int_to_binary_string(digit_sum)\n    return binary_sum_str"}
{"task_id": "HumanEval/86", "solution": "def anti_shuffle(s):\n    \"\"\"\n    Sorts characters within each word of a string in ascending ASCII order,\n    preserving word order and original spacing.\n    \"\"\"\n    words_and_spaces = s.split(' ')\n    processed_items = []\n\n    for item in words_and_spaces:\n        if item:  # If it's a non-empty word\n            processed_items.append(\"\".join(sorted(item)))\n        else:  # If it's an empty string representing a space\n            processed_items.append(\"\")\n\n    return ' '.join(processed_items)"}
{"task_id": "HumanEval/87", "solution": "def get_row(lst: list[list[int]], x: int) -> list[tuple[int, int]]:\n    \"\"\"\n    Finds occurrences of integer 'x' in a nested list 'lst' and returns\n    their (row, column) coordinates, sorted by row ascending, then column descending.\n    Coordinates are 0-indexed.\n    \"\"\"\n    found_coordinates = []\n    for r_idx, row in enumerate(lst):\n        for c_idx, element in enumerate(row):\n            if element == x:\n                found_coordinates.append((r_idx, c_idx))\n\n    # Sort primarily by row (ascending), secondarily by column (descending).\n    found_coordinates.sort(key=lambda coord: (coord[0], -coord[1]))\n    return found_coordinates"}
