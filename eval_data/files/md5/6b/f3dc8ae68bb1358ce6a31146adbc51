{"task_id": "HumanEval/38", "solution": "def decode_cyclic(s: str):\n    \"\"\"\n    takes as input string encoded with encode_cyclic function. Returns decoded string.\n    \"\"\"\n    # split string to groups. Each of length 3.\n    groups = [s[(3 * i):min((3 * i + 3), len(s))] for i in range((len(s) + 2) // 3)]\n    # reverse cycle elements in each group. Unless group has fewer elements than 3.\n    decoded_groups = [(group[-1] + group[:-1]) if len(group) == 3 else group for group in groups]\n    return \"\".join(decoded_groups)"}
{"task_id": "HumanEval/39", "solution": "import math\nfrom typing import Iterator\ndef prime_fib(n: int) -> int:\n    \"\"\"\n    prime_fib returns n-th number that is a Fibonacci number and it's also prime.\n    \"\"\"\n\n    def _is_prime(num: int) -> bool:\n        if num < 2:\n            return False\n        if num == 2:\n            return True\n        if num % 2 == 0:\n            return False\n        for i in range(3, int(math.sqrt(num)) + 1, 2):\n            if num % i == 0:\n                return False\n        return True\n\n    def _generate_fibonacci_sequence() -> Iterator[int]:\n        a, b = 0, 1\n        yield a\n        yield b\n        while True:\n            a, b = b, a + b\n            yield b\n\n    fib_gen = _generate_fibonacci_sequence()\n    prime_count = 0\n\n    # Skip 0 and 1 from the sequence as they are not prime.\n    next(fib_gen) # consumes 0\n    next(fib_gen) # consumes 1\n\n    while True:\n        fib_num = next(fib_gen)\n        if _is_prime(fib_num):\n            prime_count += 1\n            if prime_count == n:\n                return fib_num"}
{"task_id": "HumanEval/39", "solution": "def prime_fib(n: int) -> int:\n    \"\"\"\n    prime_fib returns n-th number that is a Fibonacci number and it's also prime.\n    >>> prime_fib(1)\n    2\n    >>> prime_fib(2)\n    3\n    >>> prime_fib(3)\n    5\n    >>> prime_fib(4)\n    13\n    >>> prime_fib(5)\n    89\n    \"\"\"\n\n    def is_prime(num: int) -> bool:\n        # Determines if a positive integer is prime using optimized trial division.\n        # Assumes num >= 2 due to filtering in the main loop.\n        if num <= 3:\n            return True\n        if num % 2 == 0 or num % 3 == 0:\n            return False\n        i = 5\n        while i * i <= num:\n            if num % i == 0 or num % (i + 2) == 0:\n                return False\n            i += 6\n        return True\n\n    def generate_fibonacci_sequence():\n        # Generates an infinite sequence of Fibonacci numbers starting with 0, 1.\n        a, b = 0, 1\n        while True:\n            yield a\n            a, b = b, a + b\n\n    prime_fib_count = 0\n    fib_gen = generate_fibonacci_sequence()\n\n    while True:\n        fib_num = next(fib_gen)\n        # Fibonacci numbers 0 and 1 are not prime. Skip them directly.\n        if fib_num <= 1:\n            continue\n\n        if is_prime(fib_num):\n            prime_fib_count += 1\n            if prime_fib_count == n:\n                return fib_num"}
{"task_id": "HumanEval/38", "solution": "def decode_cyclic(s: str):\n    \"\"\"\n    takes as input string encoded with encode_cyclic function. Returns decoded string.\n    \"\"\"\n    # split string into groups of three characters, handling incomplete last groups.\n    groups = [s[(3 * i):min((3 * i + 3), len(s))] for i in range((len(s) + 2) // 3)]\n    # inverse cycle elements in each group that has exactly three characters.\n    # If a group is \"bca\", to reverse it to \"abc\", we take the last character \"a\",\n    # then the first character \"b\", and then the second character \"c\".\n    # So, group[2] + group[0] + group[1]\n    decoded_groups = [(group[2] + group[0] + group[1]) if len(group) == 3 else group for group in groups]\n    return \"\".join(decoded_groups)"}
{"task_id": "HumanEval/40", "solution": "def triples_sum_to_zero(l: list):\n    \"\"\"\n    Checks if there are three distinct elements in the list that sum to zero.\n    Implements an optimized algorithm using sorting and a two-pointer approach.\n    \"\"\"\n    n = len(l)\n    if n < 3:\n        return False\n\n    sorted_numbers = sorted(l)\n\n    for i in range(n - 2):\n        # Skip duplicate elements for 'i' to avoid redundant checks.\n        if i > 0 and sorted_numbers[i] == sorted_numbers[i-1]:\n            continue\n\n        left, right = i + 1, n - 1\n        while left < right:\n            current_sum = sorted_numbers[i] + sorted_numbers[left] + sorted_numbers[right]\n\n            if current_sum == 0:\n                return True\n            elif current_sum < 0:\n                left += 1\n            else: # current_sum > 0\n                right -= 1\n    return False"}
