{"task_id": "HumanEval/89", "solution": "def encrypt(s):\n    \"\"\"\n    Encrypts a string by rotating alphabetic characters by a fixed shift of 4 positions.\n    Non-alphabetic characters remain unchanged, and case is preserved.\n    \"\"\"\n    SHIFT_AMOUNT = 4\n\n    def _shift_char(char: str, base: int) -> str:\n        \"\"\"Helper to shift a single alphabetic character by SHIFT_AMOUNT.\"\"\"\n        offset = ord(char) - base\n        shifted_offset = (offset + SHIFT_AMOUNT) % 26\n        return chr(base + shifted_offset)\n\n    encrypted_chars = []\n    for char in s:\n        if 'a' <= char <= 'z':\n            encrypted_chars.append(_shift_char(char, ord('a')))\n        elif 'A' <= char <= 'Z':\n            encrypted_chars.append(_shift_char(char, ord('A')))\n        else:\n            encrypted_chars.append(char)\n    return \"\".join(encrypted_chars)"}
{"task_id": "HumanEval/92", "solution": "def any_int(x, y, z):\n    '''\n    Create a function that takes 3 numbers.\n    Returns true if one of the numbers is equal to the sum of the other two, and all numbers are integers.\n    Returns false in any other cases.\n\n    Examples\n    any_int(5, 2, 7) \u279e True\n\n    any_int(3, 2, 2) \u279e False\n\n    any_int(3, -2, 1) \u279e True\n\n    any_int(3.6, -2.2, 2) \u279e False\n\n\n\n    '''\n    # Check if all numbers are integers\n    if not (isinstance(x, int) and isinstance(y, int) and isinstance(z, int)):\n        return False\n\n    # Check if one of the numbers is the sum of the other two\n    if (x == y + z) or (y == x + z) or (z == x + y):\n        return True\n    else:\n        return False"}
{"task_id": "HumanEval/93", "solution": "def encode(message):\n    \"\"\"Encodes a message by swapping letter cases and replacing vowels.\n    Vowels are replaced by the letter two places ahead in the alphabet, preserving case.\"\"\"\n\n    VOWELS_LOWER = \"aeiou\"\n    VOWELS_UPPER = \"AEIOU\"\n    ALPHABET_LOWER = \"abcdefghijklmnopqrstuvwxyz\"\n    ALPHABET_UPPER = \"ABCDEFGHIJKLMNOPQRSTUVWXYZ\"\n\n    encoded_chars = []\n    for char in message:\n        # First, swap the case of the character.\n        swapped_char = char.swapcase()\n\n        # Then, check if the swapped character is a vowel and replace it.\n        if swapped_char in VOWELS_LOWER:\n            idx = ALPHABET_LOWER.find(swapped_char)\n            final_char = ALPHABET_LOWER[(idx + 2) % len(ALPHABET_LOWER)]\n        elif swapped_char in VOWELS_UPPER:\n            idx = ALPHABET_UPPER.find(swapped_char)\n            final_char = ALPHABET_UPPER[(idx + 2) % len(ALPHABET_UPPER)]\n        else:\n            # If not a vowel, keep the case-swapped character.\n            # This also handles non-letter characters as per \"Assume only letters\"\n            # for rules application, and preserves them as seen in examples.\n            final_char = swapped_char\n\n        encoded_chars.append(final_char)\n\n    return \"\".join(encoded_chars)"}
{"task_id": "HumanEval/92", "solution": "def any_int(x, y, z):\n    '''\n    Create a function that takes 3 numbers.\n    Returns true if one of the numbers is equal to the sum of the other two, and all numbers are integers.\n    Returns false in any other cases.\n\n    Examples\n    any_int(5, 2, 7) \u279e True\n\n    any_int(3, 2, 2) \u279e False\n\n    any_int(3, -2, 1) \u279e True\n\n    any_int(3.6, -2.2, 2) \u279e False\n    '''\n    if not all(isinstance(n, int) for n in [x, y, z]):\n        return False\n\n    return (x == y + z) or (y == x + z) or (z == x + y)"}
{"task_id": "HumanEval/91", "solution": "import re\ndef is_bored(S: str) -> int:\n    \"\"\"\n    Counts the number of 'boredoms' in a string.\n    A boredom is a sentence starting with 'I', delimited by '.', '?' or '!'.\n    \"\"\"\n    if not S:\n        sentences = []\n    else:\n        delimiters = ['.', '?', '!']\n        escaped_delimiters = [re.escape(d) for d in delimiters]\n        pattern = '|'.join(escaped_delimiters)\n\n        sentences_raw = re.split(f'({pattern})', S)\n\n        parsed_sentences = []\n        current_sentence_parts = []\n\n        for part in sentences_raw:\n            if part in delimiters:\n                if current_sentence_parts:\n                    sentence = \"\".join(current_sentence_parts).strip()\n                    if sentence:\n                        parsed_sentences.append(sentence + part)\n                    current_sentence_parts = []\n            else:\n                current_sentence_parts.append(part)\n\n        if current_sentence_parts:\n            sentence = \"\".join(current_sentence_parts).strip()\n            if sentence:\n                parsed_sentences.append(sentence)\n        sentences = parsed_sentences\n\n    boredom_count = 0\n    for sentence in sentences:\n        cleaned_sentence = sentence.strip()\n        if cleaned_sentence and (cleaned_sentence.lower().startswith(\"i \") or cleaned_sentence.lower() == \"i\"):\n            boredom_count += 1\n    return boredom_count"}
{"task_id": "HumanEval/91", "solution": "import re\nclass SentenceSplitter:\n    \"\"\"Utility to split text into sentences using common delimiters.\"\"\"\n    def split(self, text: str) -> list[str]:\n        # Splits text by '.', '?', '!' and filters out empty strings.\n        sentences = re.split(r'[.?!]', text)\n        return [s.strip() for s in sentences if s.strip()]\nclass WordExtractor:\n    \"\"\"Utility to extract the first word and check if it's 'I'.\"\"\"\n    def get_first_word(self, sentence: str) -> str | None:\n        cleaned_sentence = sentence.strip()\n        if not cleaned_sentence:\n            return None\n        # Splits by whitespace and returns the first word.\n        words = cleaned_sentence.split(maxsplit=1)\n        return words[0] if words else None\n\n    def starts_with_i(self, word: str) -> bool:\n        \"\"\"Checks if a word is 'I', case-insensitively.\"\"\"\n        if word is None:\n            return False\n        return word.lower() == \"i\"\nclass BoredomCounterService:\n    \"\"\"Coordinates sentence identification and boredom counting.\"\"\"\n    def __init__(self, sentence_splitter: SentenceSplitter, word_extractor: WordExtractor):\n        self._sentence_splitter = sentence_splitter\n        self._word_extractor = word_extractor\n\n    def count_boredoms(self, text: str) -> int:\n        \"\"\"Counts sentences starting with 'I' in the given text.\"\"\"\n        boredom_count = 0\n        sentences = self._sentence_splitter.split(text)\n\n        for sentence in sentences:\n            first_word = self._word_extractor.get_first_word(sentence)\n            if self._word_extractor.starts_with_i(first_word):\n                boredom_count += 1\n\n        return boredom_count\ndef is_bored(S: str) -> int:\n    \"\"\"\n    You'll be given a string of words, and your task is to count the number\n    of boredoms. A boredom is a sentence that starts with the word \"I\".\n    Sentences are delimited by '.', '?' or '!'.\n\n    For example:\n    >>> is_bored(\"Hello world\")\n    0\n    >>> is_bored(\"The sky is blue. The sun is shining. I love this weather\")\n    1\n    \"\"\"\n    splitter = SentenceSplitter()\n    extractor = WordExtractor()\n    service = BoredomCounterService(splitter, extractor)\n    return service.count_boredoms(S)"}
{"task_id": "HumanEval/93", "solution": "_VOWELS = {'a', 'e', 'i', 'o', 'u', 'A', 'E', 'I', 'O', 'U'}\n_ALPHABET_LOWER = 'abcdefghijklmnopqrstuvwxyz'\n_ALPHABET_UPPER = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'\ndef encode(message):\n    \"\"\"\n    Encodes a message by swapping letter case and shifting vowels two places forward.\n    Assumes input contains only letters; non-alphabetic characters are passed through unchanged.\n    \"\"\"\n    encoded_chars = []\n    for char in message:\n        if not char.isalpha():\n            # Pass non-alphabetic characters through unchanged as per specification.\n            encoded_chars.append(char)\n            continue\n\n        processed_char = char\n        if char in _VOWELS:\n            # Shift vowel two places ahead in the alphabet, preserving its original case.\n            if char.islower():\n                alphabet = _ALPHABET_LOWER\n            else: # char.isupper()\n                alphabet = _ALPHABET_UPPER\n\n            current_index = alphabet.index(char)\n            new_index = (current_index + 2) % len(alphabet)\n            processed_char = alphabet[new_index]\n\n        # Swap the case of the processed character (which might be shifted or original).\n        if processed_char.islower():\n            encoded_chars.append(processed_char.upper())\n        else: # processed_char.isupper()\n            encoded_chars.append(processed_char.lower())\n\n    return \"\".join(encoded_chars)"}
{"task_id": "HumanEval/94", "solution": "def skjkasdkd(lst):\n    \"\"\"Finds the largest prime in a list and returns the sum of its digits.\n    Returns 0 if no prime numbers are found.\"\"\"\n\n    def is_prime(n: int) -> bool:\n        \"\"\"Checks if a given integer n is a prime number.\"\"\"\n        if n < 2:\n            return False\n        i = 2\n        while i * i <= n:\n            if n % i == 0:\n                return False\n            i += 1\n        return True\n\n    def sum_digits(n: int) -> int:\n        \"\"\"Calculates the sum of the digits of an integer n (absolute value).\"\"\"\n        s = 0\n        n_abs = abs(n)\n        while n_abs > 0:\n            s += n_abs % 10\n            n_abs //= 10\n        return s\n\n    largest_prime = -1\n\n    for num in lst:\n        if is_prime(num):\n            if num > largest_prime:\n                largest_prime = num\n\n    if largest_prime > 1:\n        return sum_digits(largest_prime)\n    else:\n        return 0"}
{"task_id": "HumanEval/97", "solution": "def multiply(a, b):\n    \"\"\"Completes the function that takes two integers and returns the product of their unit digits.\n    Assumes the input is always valid.\n    Examples:\n    multiply(148, 412) should return 16.\n    multiply(19, 28) should return 72.\n    multiply(2020, 1851) should return 0.\n    multiply(14,-15) should return 20.\n    \"\"\"\n    unit_digit_a = abs(a) % 10\n    unit_digit_b = abs(b) % 10\n    return unit_digit_a * unit_digit_b"}
{"task_id": "HumanEval/96", "solution": "def count_up_to(n):\n    \"\"\"Generates all prime numbers strictly less than n.\n    Uses the Sieve of Eratosthenes for efficient prime generation.\"\"\"\n\n    if n <= 2:\n        return []\n\n    # The limit for the sieve is n-1, as we need primes strictly less than n.\n    limit = n - 1\n\n    # Initialize a boolean array where is_prime_flags[i] is True if i is prime.\n    is_prime_flags = [True] * (limit + 1)\n    is_prime_flags[0] = False  # 0 is not prime\n    is_prime_flags[1] = False  # 1 is not prime\n\n    p = 2\n    while p * p <= limit:\n        # If is_prime_flags[p] is still True, then p is a prime.\n        if is_prime_flags[p]:\n            # Mark all multiples of p (starting from p*p) as not prime.\n            for multiple in range(p * p, limit + 1, p):\n                is_prime_flags[multiple] = False\n        p += 1\n\n    # Collect all numbers for which is_prime_flags is True into a list.\n    primes_list = []\n    for i in range(2, limit + 1):\n        if is_prime_flags[i]:\n            primes_list.append(i)\n\n    return primes_list"}
{"task_id": "HumanEval/97", "solution": "def multiply(a, b):\n    \"\"\"\n    Calculates the product of the unit digits of two given integers.\n    Assumes inputs are always valid integers.\n    \"\"\"\n    unit_digit_a = abs(a) % 10\n    unit_digit_b = abs(b) % 10\n    return unit_digit_a * unit_digit_b"}
{"task_id": "HumanEval/96", "solution": "def count_up_to(n):\n    \"\"\"\n    Finds all prime numbers less than a specified non-negative integer n.\n    Utilizes the Sieve of Eratosthenes algorithm for efficient computation.\n    \"\"\"\n    if n <= 2:\n        return []\n\n    # Create a boolean list 'is_prime[0...n-1]' and initialize all entries as true.\n    # A value is_prime[i] will be false if i is not a prime, else true.\n    is_prime = [True] * n\n    is_prime[0] = False  # 0 is not a prime number\n    is_prime[1] = False  # 1 is not a prime number\n\n    # Iterate from p = 2 up to sqrt(n).\n    for p in range(2, int(n**0.5) + 1):\n        # If is_prime[p] is still true, then it is a prime number.\n        if is_prime[p]:\n            # Mark all multiples of p (starting from p*p) as not prime.\n            # Multiples less than p*p would have already been marked by smaller primes.\n            for multiple in range(p*p, n, p):\n                is_prime[multiple] = False\n\n    # Collect all numbers that are marked as prime.\n    primes = [p for p, prime in enumerate(is_prime) if prime]\n    return primes"}
{"task_id": "HumanEval/95", "solution": "def check_dict_case(dict):\n    \"\"\"\n    Given a dictionary, return True if all keys are strings in lower\n    case or all keys are strings in upper case, else return False.\n    The function should return False is the given dictionary is empty.\n    Examples:\n    check_dict_case({\"a\":\"apple\", \"b\":\"banana\"}) should return True.\n    check_dict_case({\"a\":\"apple\", \"A\":\"banana\", \"B\":\"banana\"}) should return False.\n    check_dict_case({\"a\":\"apple\", 8:\"banana\", \"a\":\"apple\"}) should return False.\n    check_dict_case({\"Name\":\"John\", \"Age\":\"36\", \"City\":\"Houston\"}) should return False.\n    check_dict_case({\"STATE\":\"NC\", \"ZIP\":\"12345\" }) should return True.\n    \"\"\"\n    if not dict:\n        return False\n\n    # First, check if all keys are strings as per FR3 and examples.\n    for key in dict.keys():\n        if not isinstance(key, str):\n            return False\n\n    # Now, all keys are confirmed to be strings.\n    # Check if all string keys are uniformly lowercase.\n    all_lower = all(key.islower() for key in dict.keys())\n    if all_lower:\n        return True\n\n    # Check if all string keys are uniformly uppercase.\n    all_upper = all(key.isupper() for key in dict.keys())\n    if all_upper:\n        return True\n\n    # If neither all_lower nor all_upper is True, keys are mixed case.\n    return False"}
{"task_id": "HumanEval/94", "solution": "import math\ndef skjkasdkd(lst):\n    \"\"\"Finds the largest prime number in a list and returns the sum of its digits.\n    Returns 0 if no prime numbers are found.\n    \"\"\"\n\n    def is_prime(n: int) -> bool:\n        \"\"\"Checks if an integer is a prime number.\n        It uses an optimized trial division method.\n        \"\"\"\n        if n <= 1:\n            return False\n        if n == 2:\n            return True\n        if n % 2 == 0:\n            return False\n        for i in range(3, int(math.sqrt(n)) + 1, 2):\n            if n % i == 0:\n                return False\n        return True\n\n    def sum_digits(n: int) -> int:\n        \"\"\"Calculates the sum of the absolute digits of an integer.\n        It converts the number to a string to iterate its digits.\n        \"\"\"\n        return sum(int(digit) for digit in str(abs(n)))\n\n    largest_prime = None\n    for num in lst:\n        if is_prime(num):\n            if largest_prime is None or num > largest_prime:\n                largest_prime = num\n\n    if largest_prime is None:\n        return 0\n\n    return sum_digits(largest_prime)"}
{"task_id": "HumanEval/95", "solution": "def check_dict_case(dict):\n    \"\"\"\n    Checks if all dictionary keys are consistently lowercase or uppercase strings.\n    Returns False for empty dictionaries.\n    \"\"\"\n    if not dict:\n        return False\n\n    keys = list(dict.keys())\n\n    if all(key == key.lower() for key in keys):\n        return True\n\n    if all(key == key.upper() for key in keys):\n        return True\n\n    return False"}
