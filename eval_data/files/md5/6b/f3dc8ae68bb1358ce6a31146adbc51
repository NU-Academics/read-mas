{"task_id": "HumanEval/59", "solution": "def largest_prime_factor(n: int) -> int:\n    \"\"\"Return the largest prime factor of n. Assume n > 1 and is not a prime.\"\"\"\n    largest_factor = 1\n\n    # Handle factor 2\n    while n % 2 == 0:\n        largest_factor = 2\n        n //= 2\n\n    # Handle odd factors\n    i = 3\n    while i * i <= n:\n        while n % i == 0:\n            largest_factor = i\n            n //= i\n        i += 2\n\n    # If n is still greater than 2, it must be a prime factor itself\n    if n > 2:\n        largest_factor = n\n\n    return largest_factor"}
{"task_id": "HumanEval/58", "solution": "def common(l1: list, l2: list):\n    \"\"\"Return sorted unique common elements for two lists.\n    >>> common([1, 4, 3, 34, 653, 2, 5], [5, 7, 1, 5, 9, 653, 121])\n    [1, 5, 653]\n    >>> common([5, 3, 2, 8], [3, 2])\n    [2, 3]\n\n    \"\"\"\n    set_l1 = set(l1)\n    set_l2 = set(l2)\n    common_elements = list(set_l1.intersection(set_l2))\n    common_elements.sort()\n    return common_elements"}
{"task_id": "HumanEval/59", "solution": "def largest_prime_factor(n: int):\n    \"\"\"Return the largest prime factor of n. Assume n > 1 and is not a prime.\n    >>> largest_prime_factor(13195)\n    29\n    >>> largest_prime_factor(2048)\n    2\n    \"\"\"\n    i = 2\n    largest_factor = 1\n    temp_n = n\n\n    while i * i <= temp_n:\n        if temp_n % i == 0:\n            largest_factor = i\n            while temp_n % i == 0:\n                temp_n //= i\n        i += 1\n\n    if temp_n > 1: # If temp_n is still greater than 1, it must be the largest prime factor.\n        largest_factor = temp_n\n\n    return largest_factor"}
{"task_id": "HumanEval/57", "solution": "def monotonic(l: list) -> bool:\n    \"\"\"Return True if list elements are monotonically increasing or decreasing.\n    >>> monotonic([1, 2, 4, 20])\n    True\n    >>> monotonic([1, 20, 4, 10])\n    False\n    >>> monotonic([4, 1, 0, -10])\n    True\n    \"\"\"\n    if len(l) <= 1:\n        return True\n\n    # Check for monotonically increasing\n    is_increasing = True\n    for i in range(len(l) - 1):\n        if l[i] > l[i+1]:\n            is_increasing = False\n            break\n\n    if is_increasing:\n        return True\n\n    # Check for monotonically decreasing if not increasing\n    is_decreasing = True\n    for i in range(len(l) - 1):\n        if l[i] < l[i+1]:\n            is_decreasing = False\n            break\n\n    return is_decreasing"}
{"task_id": "HumanEval/57", "solution": "def monotonic(l: list) -> bool:\n    \"\"\"Return True if list elements are monotonically increasing or decreasing.\n    >>> monotonic([1, 2, 4, 20])\n    True\n    >>> monotonic([1, 20, 4, 10])\n    False\n    >>> monotonic([4, 1, 0, -10])\n    True\n    \"\"\"\n    if len(l) <= 1:\n        return True\n\n    is_increasing = True\n    is_decreasing = True\n\n    for i in range(len(l) - 1):\n        if l[i] > l[i+1]:\n            is_increasing = False\n        if l[i] < l[i+1]:\n            is_decreasing = False\n\n        # Optimization: if neither is possible, we can stop early.\n        if not is_increasing and not is_decreasing:\n            return False\n\n    return is_increasing or is_decreasing"}
{"task_id": "HumanEval/60", "solution": "def sum_to_n(n: int):\n    \"\"\"sum_to_n is a function that sums numbers from 1 to n.\n    >>> sum_to_n(30)\n    465\n    >>> sum_to_n(100)\n    5050\n    >>> sum_to_n(5)\n    15\n    >>> sum_to_n(10)\n    55\n    >>> sum_to_n(1)\n    1\n    \"\"\"\n    return n * (n + 1) // 2"}
{"task_id": "HumanEval/58", "solution": "def common(l1: list, l2: list) -> list:\n    \"\"\"Return sorted unique common elements for two lists.\n    This function efficiently finds common elements, removes duplicates, and sorts them.\n    \"\"\"\n    # Convert inputs to sets to find unique common elements efficiently.\n    common_set = set(l1).intersection(set(l2))\n\n    # Convert the resulting set to a list and sort it in ascending order.\n    return sorted(list(common_set))"}
{"task_id": "HumanEval/60", "solution": "def sum_to_n(n: int):\n    \"\"\"sum_to_n is a function that sums numbers from 1 to n.\n    >>> sum_to_n(30)\n    465\n    >>> sum_to_n(100)\n    5050\n    >>> sum_to_n(5)\n    15\n    >>> sum_to_n(10)\n    55\n    >>> sum_to_n(1)\n    1\n    \"\"\"\n    if not isinstance(n, int):\n        raise ValueError(\"n must be an integer.\")\n    if n <= 0:\n        raise ValueError(\"n must be a positive integer.\")\n    return n * (n + 1) // 2"}
{"task_id": "HumanEval/61", "solution": "def correct_bracketing(brackets: str) -> bool:\n    \"\"\" brackets is a string of \"(\" and \")\".\n    return True if every opening bracket has a corresponding closing bracket.\n    \"\"\"\n    balance = 0\n    for char in brackets:\n        if char == '(':\n            balance += 1\n        elif char == ')':\n            balance -= 1\n        if balance < 0: # Closing bracket encountered before an opening one.\n            return False\n    return balance == 0"}
{"task_id": "HumanEval/61", "solution": "def correct_bracketing(brackets: str) -> bool:\n    \"\"\"\n    Checks if a string of '(' and ')' characters is correctly bracketed.\n    Returns True if balanced and correctly nested, False otherwise.\n    \"\"\"\n    open_count = 0\n    for char in brackets:\n        if char == '(':\n            open_count += 1\n        elif char == ')':\n            open_count -= 1\n        if open_count < 0:\n            return False\n    return open_count == 0"}
{"task_id": "HumanEval/62", "solution": "def derivative(xs: list):\n    \"\"\" xs represent coefficients of a polynomial.\n    xs[0] + xs[1] * x + xs[2] * x^2 + ....\\\n     Return derivative of this polynomial in the same form.\n    \"\"\"\n    if len(xs) <= 1:\n        return []\n\n    derivative_coeffs = []\n    for i in range(1, len(xs)):\n        derivative_coeffs.append(xs[i] * i)\n\n    return derivative_coeffs"}
{"task_id": "HumanEval/62", "solution": "def derivative(xs: list):\n    \"\"\" xs represent coefficients of a polynomial.\n    Returns the coefficients of the derivative polynomial.\n    \"\"\"\n    derivative_coeffs = []\n    # The derivative of c_i * x^i is i * c_i * x^(i-1).\n    # We iterate from the coefficient of x^1 (index 1) onwards.\n    for i in range(1, len(xs)):\n        derivative_coeffs.append(i * xs[i])\n    return derivative_coeffs"}
