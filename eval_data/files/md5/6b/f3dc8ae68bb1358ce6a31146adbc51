{"task_id": "HumanEval/143", "solution": "def words_in_sentence(sentence: str) -> str:\n    \"\"\"\n    Filters words from a sentence, keeping only those with prime lengths.\n    A helper function for primality testing is defined internally.\n    \"\"\"\n    def is_prime(n: int) -> bool:\n        \"\"\"Checks if a given integer n is a prime number.\"\"\"\n        if n < 2:\n            return False\n        for i in range(2, int(n**0.5) + 1):\n            if n % i == 0:\n                return False\n        return True\n\n    words = sentence.split()\n    prime_length_words = []\n    for word in words:\n        if is_prime(len(word)):\n            prime_length_words.append(word)\n    return \" \".join(prime_length_words)"}
{"task_id": "HumanEval/146", "solution": "def specialFilter(nums):\n    \"\"\"\n    Filters numbers to count those greater than 10 with odd first and last digits.\n    This function implements the special number criteria as defined.\n    \"\"\"\n\n    def is_odd(digit):\n        \"\"\"Checks if a given digit is odd.\"\"\"\n        return digit % 2 != 0\n\n    def get_first_digit(number):\n        \"\"\"Extracts the first digit of an integer (absolute value).\"\"\"\n        return int(str(abs(number))[0])\n\n    def get_last_digit(number):\n        \"\"\"Extracts the last digit of an integer (absolute value).\"\"\"\n        return int(str(abs(number))[-1])\n\n    def _is_special_number(number):\n        \"\"\"Determines if a single number meets all special criteria.\"\"\"\n        if number <= 10:\n            return False\n        first_digit = get_first_digit(number)\n        last_digit = get_last_digit(number)\n        return is_odd(first_digit) and is_odd(last_digit)\n\n    count = 0\n    for number in nums:\n        if _is_special_number(number):\n            count += 1\n    return count"}
{"task_id": "HumanEval/145", "solution": "def order_by_points(nums):\n    \"\"\"\n    Sorts a list of integers by the sum of their digits, then by original index.\n    If multiple items have the same sum of digits, they are ordered by their initial position.\n    \"\"\"\n\n    def calculate_digit_sum(num: int) -> int:\n        \"\"\"\n        Calculates the sum of the absolute digits of an integer.\n        For example, calculate_digit_sum(-12) returns 3.\n        \"\"\"\n        s = 0\n        for digit_char in str(abs(num)):\n            s += int(digit_char)\n        return s\n\n    decorated_list = []\n    # Create tuples: (sum_of_digits, original_index, number) to facilitate custom sorting.\n    for index, num in enumerate(nums):\n        sum_digits = calculate_digit_sum(num)\n        decorated_list.append((sum_digits, index, num))\n\n    # Sort the list of tuples. Python's default tuple sort orders by elements sequentially.\n    decorated_list.sort()\n\n    # Extract the original numbers from the sorted tuples.\n    sorted_nums = [item[2] for item in decorated_list]\n    return sorted_nums"}
{"task_id": "HumanEval/147", "solution": "def get_max_triples(n):\n    \"\"\"\n    Calculates the number of triples (a[i], a[j], a[k]) where i < j < k,\n    and a[i] + a[j] + a[k] is a multiple of 3.\n    \"\"\"\n    if n < 3:\n        return 0\n\n    def _combinations(num_n, num_k):\n        \"\"\"Calculates n choose k (C(n, k)).\"\"\"\n        if num_k < 0 or num_k > num_n:\n            return 0\n        if num_k == 0 or num_k == num_n:\n            return 1\n        if num_k > num_n // 2:\n            num_k = num_n - num_k\n\n        res = 1\n        for i in range(num_k):\n            res = res * (num_n - i) // (i + 1)\n        return res\n\n    remainder_counts = {0: 0, 1: 0, 2: 0}\n    for i in range(1, n + 1):\n        # a[i] = i * i - i + 1. Its remainder modulo 3 has a pattern:\n        # If i % 3 is 0 or 1, then a[i] % 3 is 1. If i % 3 is 2, then a[i] % 3 is 0.\n        if i % 3 == 2:\n            remainder_counts[0] += 1\n        else:\n            remainder_counts[1] += 1\n\n    count0 = remainder_counts[0]\n    count1 = remainder_counts[1]\n    count2 = remainder_counts[2]\n\n    # Triples sum to a multiple of 3 if (r1+r2+r3)%3 == 0.\n    # Relevant cases are (0,0,0), (1,1,1), (2,2,2), (0,1,2).\n    triples_000 = _combinations(count0, 3)\n    triples_111 = _combinations(count1, 3)\n    triples_222 = _combinations(count2, 3) # This will be 0 as count2 is always 0\n    triples_012 = count0 * count1 * count2 # This will be 0 as count2 is always 0\n\n    total_triples = triples_000 + triples_111 + triples_222 + triples_012\n    return total_triples"}
{"task_id": "HumanEval/147", "solution": "import math\ndef get_max_triples(n):\n    \"\"\"\n    Calculates the number of triples (a[i], a[j], a[k]) from an array where i < j < k,\n    and a[i] + a[j] + a[k] is a multiple of 3.\n    The array elements a[i] are defined as i*i - i + 1.\n    \"\"\"\n    if n < 3:\n        return 0\n\n    # Generate the array a where a[i] = i * i - i + 1 for 1 <= i <= n.\n    arr = [i * i - i + 1 for i in range(1, n + 1)]\n\n    # Count the number of triples (a[i], a[j], a[k]) from arr.\n    # This approach counts elements by their remainder modulo 3.\n    remainder_counts = [0, 0, 0]\n    for x in arr:\n        remainder_counts[x % 3] += 1\n\n    count_0 = remainder_counts[0]\n    count_1 = remainder_counts[1]\n    count_2 = remainder_counts[2]\n\n    total_triples = 0\n\n    # Triples (r1, r2, r3) whose sum is a multiple of 3.\n    # This includes (0,0,0), (1,1,1), (2,2,2), and (0,1,2).\n\n    # Case 1: (0, 0, 0) - choose 3 elements with remainder 0.\n    if count_0 >= 3:\n        total_triples += math.comb(count_0, 3)\n\n    # Case 2: (1, 1, 1) - choose 3 elements with remainder 1.\n    if count_1 >= 3:\n        total_triples += math.comb(count_1, 3)\n\n    # Case 3: (2, 2, 2) - choose 3 elements with remainder 2.\n    if count_2 >= 3:\n        total_triples += math.comb(count_2, 3)\n\n    # Case 4: (0, 1, 2) - choose 1 element of each remainder type.\n    total_triples += count_0 * count_1 * count_2\n\n    return total_triples"}
{"task_id": "HumanEval/148", "solution": "PLANETS = [\n    \"Mercury\",\n    \"Venus\",\n    \"Earth\",\n    \"Mars\",\n    \"Jupiter\",\n    \"Saturn\",\n    \"Uranus\",\n    \"Neptune\"\n]\ndef bf(planet1, planet2):\n    \"\"\"\n    Takes two planet names and returns a tuple of planets whose orbits are between them,\n    sorted by proximity to the Sun. Returns an empty tuple if either input planet is invalid.\n    \"\"\"\n    if planet1 not in PLANETS or planet2 not in PLANETS:\n        return ()\n\n    idx1 = PLANETS.index(planet1)\n    idx2 = PLANETS.index(planet2)\n\n    # Determine the correct slice range, ensuring start < end.\n    start_idx = min(idx1, idx2) + 1\n    end_idx = max(idx1, idx2)\n\n    if start_idx >= end_idx:\n        return ()\n\n    return tuple(PLANETS[start_idx:end_idx])"}
