{"task_id": "HumanEval/122", "solution": "def add_elements(arr: list[int], k: int) -> int:\n    \"\"\"\n    Calculates the sum of elements with at most two digits from the first k elements of arr.\n    Assumes valid inputs as per constraints: 1 <= len(arr) <= 100, 1 <= k <= len(arr).\n    \"\"\"\n    total_sum = 0\n    for i in range(k):\n        element = arr[i]\n        # Check if the element has at most two digits (absolute value less than 100).\n        if -100 < element < 100:\n            total_sum += element\n    return total_sum"}
{"task_id": "HumanEval/122", "solution": "def add_elements(arr, k):\n    \"\"\"\n    Given a non-empty array of integers arr and an integer k, return\n    the sum of the elements with at most two digits from the first k elements of arr.\n    \"\"\"\n    current_sum = 0\n    # Process only the first k elements of the array.\n    for i in range(k):\n        element = arr[i]\n        # Check if the absolute value of the element is less than 100 (at most two digits).\n        if abs(element) < 100:\n            current_sum += element\n    return current_sum"}
{"task_id": "HumanEval/123", "solution": "def get_odd_collatz(n):\n    \"\"\"\n    Given a positive integer n, return a sorted list that has the odd numbers in its Collatz sequence.\n    The sequence is generated by rules: n/2 if even, 3*n + 1 if odd, until 1 is reached.\n    \"\"\"\n    if n == 1:\n        return [1]\n\n    sequence = []\n    current_term = n\n    # Generate the Collatz sequence by repeatedly applying rules until 1\n    while current_term != 1:\n        sequence.append(current_term)\n        if current_term % 2 == 0:\n            current_term //= 2\n        else:\n            current_term = 3 * current_term + 1\n    sequence.append(1) # Always include the final 1 in the sequence\n\n    # Filter for odd numbers, get unique values, and sort them in increasing order\n    unique_odd_numbers = sorted(list(set(term for term in sequence if term % 2 != 0)))\n    return unique_odd_numbers"}
{"task_id": "HumanEval/120", "solution": "import heapq\ndef maximum(arr, k):\n    \"\"\"\n    Given an array arr of integers and a positive integer k, return a sorted list\n    of length k with the maximum k numbers in arr.\n\n    Example 1:\n\n        Input: arr = [-3, -4, 5], k = 3\n        Output: [-4, -3, 5]\n\n    Example 2:\n\n        Input: arr = [4, -4, 4], k = 2\n        Output: [4, 4]\n\n    Example 3:\n\n        Input: arr = [-3, 2, 1, 2, -1, -2, 1], k = 1\n        Output: [2]\n\n    Note:\n        1. The length of the array will be in the range of [1, 1000].\n        2. The elements in the array will be in the range of [-1000, 1000].\n        3. 0 <= k <= len(arr)\n    \"\"\"\n    if k == 0:\n        return []\n\n    # Use a min-heap to keep track of the k largest elements seen so far.\n    # This approach is efficient for finding k largest elements.\n    min_heap = []\n    for num in arr:\n        if len(min_heap) < k:\n            heapq.heappush(min_heap, num)\n        else:\n            if num > min_heap[0]:\n                heapq.heapreplace(min_heap, num)\n\n    return sorted(min_heap)"}
{"task_id": "HumanEval/125", "solution": "def split_words(txt):\n    '''\n    Splits a string based on precedence: whitespace, then commas.\n    If neither, it counts specific lowercase letters with odd alphabetical order.\n    '''\n\n    # Helper function defined locally as per critical requirements.\n    def _count_odd_order_lowercase_letters_local(text_to_analyze: str) -> int:\n        count = 0\n        for char in text_to_analyze:\n            if 'a' <= char <= 'z':\n                order = ord(char) - ord('a') # 'a' = 0, 'b' = 1, ...\n                if order % 2 != 0: # Check if the alphabetical order is odd.\n                    count += 1\n        return count\n\n    if ' ' in txt:\n        return txt.split(' ')\n    elif ',' in txt:\n        return txt.split(',')\n    else:\n        return _count_odd_order_lowercase_letters_local(txt)"}
{"task_id": "HumanEval/123", "solution": "def get_odd_collatz(n: int) -> list[int]:\n    \"\"\"\n    Given a positive integer n, return a sorted list that has the odd numbers in collatz sequence.\n\n    The Collatz conjecture is a conjecture in mathematics that concerns a sequence defined\n    as follows: start with any positive integer n. Then each term is obtained from the\n    previous term as follows: if the previous term is even, the next term is one half of\n    the previous term. If the previous term is odd, the next term is 3 times the previous\n    term plus 1. The conjecture is that no matter what value of n, the sequence will always reach 1.\n\n    Note:\n        1. Collatz(1) is [1].\n        2. returned list sorted in increasing order.\n\n    For example:\n    get_odd_collatz(5) returns [1, 5] # The collatz sequence for 5 is [5, 16, 8, 4, 2, 1], so the odd numbers are only 1, and 5.\n    \"\"\"\n\n    def _calculate_next_term(current_term: int) -> int:\n        \"\"\"Computes the next term in the Collatz sequence.\n        Applies the rule: n/2 if even, 3n+1 if odd.\n        \"\"\"\n        if current_term % 2 == 0:\n            return current_term // 2\n        else:\n            return 3 * current_term + 1\n\n    def generate_sequence(start_n: int) -> list[int]:\n        \"\"\"Generates the complete Collatz sequence from start_n down to 1.\n        It iteratively applies the Collatz rule until 1 is reached.\n        \"\"\"\n        sequence = [start_n]\n        current = start_n\n        while current != 1:\n            current = _calculate_next_term(current)\n            sequence.append(current)\n        return sequence\n\n    def get_odd_numbers(sequence: list[int]) -> list[int]:\n        \"\"\"Extracts unique odd numbers from a sequence and returns them sorted.\n        Uses a set to ensure uniqueness before sorting.\n        \"\"\"\n        odd_numbers = sorted(list(set(term for term in sequence if term % 2 != 0)))\n        return odd_numbers\n\n    # Main logic of get_odd_collatz\n    if n == 1:\n        return [1]\n\n    sequence = generate_sequence(n)\n    odd_numbers = get_odd_numbers(sequence)\n    return odd_numbers"}
{"task_id": "HumanEval/124", "solution": "def valid_date(date: str) -> bool:\n    \"\"\"Validates a date string according to specific rules: non-empty, 'mm-dd-yyyy' format,\n    month 1-12, and day valid for the given month (max 29 for Feb).\"\"\"\n\n    # FR1: The date string is not empty.\n    if not date:\n        return False\n\n    # FR2: The date should be in the format: mm-dd-yyyy\n    parts = date.split('-')\n    if len(parts) != 3:\n        return False\n\n    month_str, day_str, year_str = parts\n\n    # Ensure each part has the correct length for 'mm-dd-yyyy'\n    if not (len(month_str) == 2 and len(day_str) == 2 and len(year_str) == 4):\n        return False\n\n    try:\n        month = int(month_str)\n        day = int(day_str)\n        # Year is parsed to validate its format and integer nature, but its value isn't used for range checks.\n        year = int(year_str)\n    except ValueError:\n        return False\n\n    # FR3: The months should not be less than 1 or higher than 12.\n    if not (1 <= month <= 12):\n        return False\n\n    # FR4: Day validation based on month.\n    # Defines the maximum days for each month, adhering to the 1-29 for Feb rule.\n    MONTH_DAYS_MAP = {\n        1: 31, 3: 31, 5: 31, 7: 31, 8: 31, 10: 31, 12: 31,\n        4: 30, 6: 30, 9: 30, 11: 30,\n        2: 29\n    }\n\n    # Month is guaranteed to be valid due to the previous check (FR3).\n    max_days = MONTH_DAYS_MAP[month]\n\n    if not (1 <= day <= max_days):\n        return False\n\n    # FR5: All validation rules are satisfied.\n    return True"}
{"task_id": "HumanEval/124", "solution": "import re\ndef valid_date(date):\n    \"\"\"\n    Validates a date string in 'mm-dd-yyyy' format, checking for non-empty input,\n    valid month (1-12), and valid day for the given month.\n    \"\"\"\n    if not date:\n        return False\n\n    # Check format 'mm-dd-yyyy' and extract components.\n    match = re.fullmatch(r'(\\d{2})-(\\d{2})-(\\d{4})', date)\n    if not match:\n        return False\n\n    month = int(match.group(1))\n    day = int(match.group(2))\n    # year = int(match.group(3)) # Year is not used in validation rules.\n\n    # Validate month component is between 1 and 12.\n    if not (1 <= month <= 12):\n        return False\n\n    # Define max days for each month (inline for critical requirement compliance).\n    DAYS_IN_MONTH = {\n        1: 31, 3: 31, 5: 31, 7: 31, 8: 31, 10: 31, 12: 31,\n        4: 30, 6: 30, 9: 30, 11: 30,\n        2: 29  # February max days per rule (no leap year check).\n    }\n\n    # Validate day component is valid for the given month.\n    max_days = DAYS_IN_MONTH.get(month)\n    if max_days is None or not (1 <= day <= max_days):\n        return False\n\n    return True"}
{"task_id": "HumanEval/125", "solution": "def split_words(txt):\n    \"\"\"\n    Processes a string by splitting on whitespace, then commas, or counting odd-ordered lowercase letters.\n    The behavior depends on the presence and priority of delimiters in the input string.\n    \"\"\"\n    if any(c.isspace() for c in txt):\n        return txt.split()\n\n    if ',' in txt:\n        return txt.split(',')\n\n    count = 0\n    for char in txt:\n        if 'a' <= char <= 'z':\n            order = ord(char) - ord('a')\n            if order % 2 != 0:\n                count += 1\n    return count"}
{"task_id": "HumanEval/126", "solution": "from collections import Counter\ndef is_sorted(lst):\n    '''Determines if a list of non-negative integers is sorted in ascending order and has no more than two occurrences of any number. Returns True if valid, False otherwise.'''\n    if not lst:\n        return True\n\n    # Check for excessive duplicates (count > 2)\n    counts = Counter(lst)\n    for count in counts.values():\n        if count > 2:\n            return False\n\n    # Check for ascending order\n    for i in range(len(lst) - 1):\n        if lst[i] > lst[i+1]:\n            return False\n\n    return True"}
{"task_id": "HumanEval/127", "solution": "import math\ndef is_prime(n: int) -> bool:\n    \"\"\"Checks if a given non-negative integer is a prime number.\n    Handles edge cases for 0, 1, and 2 efficiently.\"\"\"\n    if n <= 1:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n    for i in range(3, int(math.sqrt(n)) + 1, 2):\n        if n % i == 0:\n            return False\n    return True\ndef intersection(interval1: tuple[int, int], interval2: tuple[int, int]) -> str:\n    \"\"\"\n    Determines whether the length of the intersection of two closed integer intervals is a prime number.\n    Returns \"YES\" if the length is prime, \"NO\" otherwise (including no intersection).\n    \"\"\"\n    start1, end1 = interval1\n    start2, end2 = interval2\n\n    # Calculate the intersection interval\n    max_start = max(start1, start2)\n    min_end = min(end1, end2)\n\n    if max_start <= min_end:\n        # Intersection exists, calculate its length\n        intersected_length = min_end - max_start\n\n        # Check if the length is a prime number\n        if is_prime(intersected_length):\n            return \"YES\"\n        else:\n            return \"NO\"\n    else:\n        # No intersection\n        return \"NO\""}
{"task_id": "HumanEval/127", "solution": "class Interval:\n    def __init__(self, start: int, end: int):\n        # Removed validation checks as per critical requirement.\n        self._start = start\n        self._end = end\n\n    def get_start(self) -> int:\n        \"\"\"Returns the start point of the interval.\"\"\"\n        return self._start\n\n    def get_end(self) -> int:\n        \"\"\"Returns the end point of the interval.\"\"\"\n        return self._end\nclass IntervalService:\n    def calculate_intersection(self, interval1: Interval, interval2: Interval) -> tuple[int, int]:\n        \"\"\"Calculates the intersection of two Interval objects.\"\"\"\n        intersect_start = max(interval1.get_start(), interval2.get_start())\n        intersect_end = min(interval1.get_end(), interval2.get_end())\n        return (intersect_start, intersect_end)\n\n    def get_length(self, start: int, end: int) -> int:\n        \"\"\"Calculates the length of an interval. Returns 0 if start > end.\"\"\"\n        if start > end:\n            return 0\n        return end - start + 1\n\n    def is_prime(self, n: int) -> bool:\n        \"\"\"Determines if a non-negative integer n is a prime number.\"\"\"\n        if n <= 1:\n            return False\n        if n <= 3:\n            return True\n        if n % 2 == 0 or n % 3 == 0:\n            return False\n        i = 5\n        while i * i <= n:\n            if n % i == 0 or n % (i + 2) == 0:\n                return False\n            i += 6\n        return True\nclass IntervalController:\n    def __init__(self, interval_service: IntervalService):\n        \"\"\"Initializes the controller with an IntervalService instance.\"\"\"\n        self._interval_service = interval_service\n\n    def intersection(self, interval1_tuple: tuple[int, int], interval2_tuple: tuple[int, int]) -> str:\n        \"\"\"Determines if the intersection length of two intervals is prime.\"\"\"\n        interval1_obj = Interval(interval1_tuple[0], interval1_tuple[1])\n        interval2_obj = Interval(interval2_tuple[0], interval2_tuple[1])\n\n        intersect_start, intersect_end = self._interval_service.calculate_intersection(\n            interval1_obj, interval2_obj\n        )\n        length = self._interval_service.get_length(intersect_start, intersect_end)\n\n        if length == 0:\n            return \"NO\"\n\n        if self._interval_service.is_prime(length):\n            return \"YES\"\n        else:\n            return \"NO\"\n_interval_service_instance = IntervalService()\n_interval_controller_instance = IntervalController(_interval_service_instance)\ndef intersection(interval1, interval2):\n    \"\"\"Determines if the length of intersection of two intervals is a prime number. Returns 'YES' or 'NO'.\"\"\"\n    return _interval_controller_instance.intersection(interval1, interval2)"}
{"task_id": "HumanEval/126", "solution": "from collections import Counter\ndef is_sorted(lst):\n    '''\n    Given a list of numbers, return whether or not they are sorted\n    in ascending order. If list has more than 1 duplicate of the same\n    number, return False. Assume no negative numbers and only integers.\n\n    Examples\n    is_sorted([5]) \u279e True\n    is_sorted([1, 2, 3, 4, 5]) \u279e True\n    is_sorted([1, 3, 2, 4, 5]) \u279e False\n    is_sorted([1, 2, 3, 4, 5, 6]) \u279e True\n    is_sorted([1, 2, 3, 4, 5, 6, 7]) \u279e True\n    is_sorted([1, 3, 2, 4, 5, 6, 7]) \u279e False\n    is_sorted([1, 2, 2, 3, 3, 4]) \u279e True\n    is_sorted([1, 2, 2, 2, 3, 4]) \u279e False\n    '''\n    # Check for ascending order\n    # An empty list or a single-element list is considered sorted\n    for i in range(len(lst) - 1):\n        if lst[i] > lst[i+1]:\n            return False\n\n    # Check for more than one duplicate of any number\n    counts = Counter(lst)\n    for count in counts.values():\n        if count > 2:  # A count of 3 or more means more than one duplicate\n            return False\n\n    return True"}
{"task_id": "HumanEval/128", "solution": "def _get_sign(num: int) -> int:\n    \"\"\"Returns 1 for positive, -1 for negative, and 0 for zero.\"\"\"\n    if num > 0:\n        return 1\n    elif num < 0:\n        return -1\n    else:\n        return 0\ndef prod_signs(arr):\n    \"\"\"\n    Calculates sum of magnitudes of integers multiplied by product of all signs.\n    Returns None for an empty array.\n    \"\"\"\n    if not arr:\n        return None\n\n    product_of_signs = 1\n    for num in arr:\n        product_of_signs *= _get_sign(num)\n\n    sum_of_magnitudes = 0\n    for num in arr:\n        sum_of_magnitudes += abs(num)\n\n    return product_of_signs * sum_of_magnitudes"}
{"task_id": "HumanEval/128", "solution": "def prod_signs(arr):\n    \"\"\"\n    Calculates sum of magnitudes of integers multiplied by product of all signs.\n    Returns None for an empty array.\n    \"\"\"\n\n    def get_sign(n: int) -> int:\n        \"\"\"Returns the sign of an integer: 1 for positive, -1 for negative, 0 for zero.\"\"\"\n        if n > 0:\n            return 1\n        elif n < 0:\n            return -1\n        else:\n            return 0\n\n    def get_magnitude(n: int) -> int:\n        \"\"\"Returns the absolute value (magnitude) of an integer.\"\"\"\n        return abs(n)\n\n    if not arr:\n        return None\n\n    def _calculate_product_of_signs_internal(input_arr: list[int]) -> int:\n        \"\"\"Calculates the product of signs for all numbers in the array. Returns 0 early if any sign is 0.\"\"\"\n        product = 1\n        for n in input_arr:\n            product *= get_sign(n)\n            if product == 0:\n                return 0\n        return product\n\n    def _calculate_sum_of_magnitudes_internal(input_arr: list[int]) -> int:\n        \"\"\"Calculates the sum of magnitudes for all numbers in the array.\"\"\"\n        total_magnitude = 0\n        for n in input_arr:\n            total_magnitude += get_magnitude(n)\n        return total_magnitude\n\n    product_of_signs_val = _calculate_product_of_signs_internal(arr)\n    sum_of_magnitudes_val = _calculate_sum_of_magnitudes_internal(arr)\n\n    return sum_of_magnitudes_val * product_of_signs_val"}
{"task_id": "HumanEval/129", "solution": "from typing import List, Dict\nclass Coordinate:\n    def __init__(self, row: int, col: int):\n        self.row = row\n        self.col = col\n\n    def __eq__(self, other: object) -> bool:\n        # Enables equality comparison for coordinates.\n        return self.row == other.row and self.col == other.col\n\n    def __hash__(self) -> int:\n        # Enables Coordinate objects to be used as dictionary keys.\n        return hash((self.row, self.col))\n\n    def __repr__(self) -> str:\n        # String representation for debugging.\n        return f\"({self.row}, {self.col})\"\nclass Grid:\n    def __init__(self, grid_data: List[List[int]]):\n        self._data = grid_data\n        self._N = len(grid_data)\n\n    def get_value(self, coord: Coordinate) -> int:\n        # Returns the integer value at the given Coordinate.\n        return self._data[coord.row][coord.col]\n\n    def is_valid(self, coord: Coordinate) -> bool:\n        # Checks if a Coordinate is within the grid boundaries.\n        return 0 <= coord.row < self._N and 0 <= coord.col < self._N\n\n    def get_neighbors(self, coord: Coordinate) -> List[Coordinate]:\n        # Returns a list of valid Coordinate objects for adjacent cells.\n        neighbors = []\n        directions = [(0, 1), (0, -1), (1, 0), (-1, 0)]\n        for dr, dc in directions:\n            new_row, new_col = coord.row + dr, coord.col + dc\n            new_coord = Coordinate(new_row, new_col)\n            if self.is_valid(new_coord):\n                neighbors.append(new_coord)\n        return neighbors\n\n    def get_N(self) -> int:\n        # Returns the dimension N of the grid.\n        return self._N\nclass MinPathFinder:\n    def __init__(self, grid_data: List[List[int]], k_val: int):\n        self._grid = Grid(grid_data)\n        self._k = k_val\n        self._N = self._grid.get_N()\n        # Initialize DP table with paths guaranteed to be larger than any valid path.\n        self._infinity_path = [self._N * self._N + 1] * self._k\n        self._dp: Dict[int, Dict[Coordinate, List[int]]] = {\n            length: {\n                Coordinate(r, c): list(self._infinity_path)\n                for r in range(self._N)\n                for c in range(self._N)\n            }\n            for length in range(1, self._k + 1)\n        }\n\n    def _compare_paths(self, path_a: List[int], path_b: List[int]) -> List[int]:\n        # Returns the lexicographically smaller of two paths.\n        if path_a == self._infinity_path:\n            return path_b\n        if path_b == self._infinity_path:\n            return path_a\n        return path_a if path_a < path_b else path_b\n\n    def find_min_path(self) -> List[int]:\n        \"\"\"\n        Executes the dynamic programming algorithm to find the lexicographically smallest path.\n        It builds up paths from length 1 to k and then finds the overall minimum.\n        \"\"\"\n        # Base case: paths of length 1 start at any cell.\n        for r in range(self._N):\n            for c in range(self._N):\n                coord = Coordinate(r, c)\n                self._dp[1][coord] = [self._grid.get_value(coord)]\n\n        # Fill DP table for lengths 2 to k.\n        for length in range(2, self._k + 1):\n            for r in range(self._N):\n                for c in range(self._N):\n                    current_coord = Coordinate(r, c)\n                    current_cell_value = self._grid.get_value(current_coord)\n\n                    # Iterate over all possible previous cells.\n                    for prev_coord in self._grid.get_neighbors(current_coord):\n                        prev_path = self._dp[length - 1][prev_coord]\n                        if prev_path != self._infinity_path:\n                            candidate_path = prev_path + [current_cell_value]\n                            self._dp[length][current_coord] = self._compare_paths(\n                                self._dp[length][current_coord], candidate_path\n                            )\n\n        # Find the overall minimum path among all paths of length k.\n        overall_min_path = list(self._infinity_path)\n        for r in range(self._N):\n            for c in range(self._N):\n                coord = Coordinate(r, c)\n                overall_min_path = self._compare_paths(\n                    overall_min_path, self._dp[self._k][coord]\n                )\n\n        return overall_min_path\ndef minPath(grid: List[List[int]], k: int) -> List[int]:\n    \"\"\"\n    Finds the lexicographically smallest path of length k in the grid.\n    This function delegates the pathfinding task to the MinPathFinder class.\n    \"\"\"\n    finder = MinPathFinder(grid, k)\n    return finder.find_min_path()"}
{"task_id": "HumanEval/131", "solution": "def digits(n: int) -> int:\n    \"\"\"Given a positive integer n, return the product of the odd digits.\n    Return 0 if all digits are even.\n    \"\"\"\n    product_of_odd_digits = 1\n    has_odd_digit = False\n\n    # Convert n to string to iterate through digits.\n    for digit_char in str(n):\n        digit = int(digit_char)\n        if digit % 2 != 0:  # Check if the digit is odd.\n            product_of_odd_digits *= digit\n            has_odd_digit = True\n\n    return product_of_odd_digits if has_odd_digit else 0"}
{"task_id": "HumanEval/131", "solution": "def digits(n):\n    \"\"\"Calculates the product of odd digits within a positive integer n.\n    Returns 0 if no odd digits are found.\"\"\"\n    product = 1\n    has_odd_digit = False\n\n    # Iterate through each digit of the number.\n    for digit_char in str(n):\n        digit = int(digit_char)\n        if digit % 2 != 0:  # Check if the digit is odd.\n            product *= digit\n            has_odd_digit = True\n\n    if not has_odd_digit:\n        return 0\n\n    return product"}
{"task_id": "HumanEval/130", "solution": "def tri(n):\n    \"\"\"Everyone knows Fibonacci sequence, it was studied deeply by mathematicians in\n    the last couple centuries. However, what people don't know is Tribonacci sequence.\n    Tribonacci sequence is defined by the recurrence:\n    tri(1) = 3\n    tri(n) = 1 + n / 2, if n is even.\n    tri(n) =  tri(n - 1) + tri(n - 2) + tri(n + 1), if n is odd.\n    For example:\n    tri(2) = 1 + (2 / 2) = 2\n    tri(4) = 3\n    tri(3) = tri(2) + tri(1) + tri(4)\n           = 2 + 3 + 3 = 8\n    You are given a non-negative integer number n, you have to a return a list of the\n    first n + 1 numbers of the Tribonacci sequence.\n    Examples:\n    tri(3) = [1, 3, 2, 8]\n    \"\"\"\n    memo = {}\n\n    def _get_tri_value(k: int) -> int | float:\n        \"\"\"Computes the k-th Tribonacci number with memoization.\"\"\"\n        if k in memo:\n            return memo[k]\n\n        if k == 0:\n            result = 1\n        elif k == 1:\n            result = 3\n        elif k % 2 == 0:  # k is even\n            # Using float division as specified in the problem statement and design.\n            result = 1 + k / 2\n        else:  # k is odd\n            tri_k_minus_1 = _get_tri_value(k - 1)\n            tri_k_minus_2 = _get_tri_value(k - 2)\n            # k+1 is always even if k is odd, so tri(k+1) can be calculated directly\n            tri_k_plus_1 = 1 + (k + 1) / 2\n\n            result = tri_k_minus_1 + tri_k_minus_2 + tri_k_plus_1\n\n        memo[k] = result\n        return result\n\n    if n < 0:\n        return []\n\n    results = []\n    for i in range(n + 1):\n        results.append(_get_tri_value(i))\n\n    return results"}
{"task_id": "HumanEval/132", "solution": "def is_nested(string):\n    \"\"\"\n    Checks if a string of square brackets contains a valid nested subsequence.\n    Returns True if a nested subsequence like `[[]]` or `[[][]]` is found, False otherwise.\n    \"\"\"\n    open_count = 0\n    nested_candidate = False\n\n    for char in string:\n        if char == '[':\n            # If we already have one open bracket, this second one makes it a nested candidate.\n            if open_count >= 1:\n                nested_candidate = True\n            open_count += 1\n        elif char == ']':\n            # Match a closing bracket if there's an open one.\n            if open_count > 0:\n                open_count -= 1\n            # If a nested pattern was identified and we've closed the outermost bracket.\n            if nested_candidate and open_count == 0:\n                return True\n    return False"}
{"task_id": "HumanEval/133", "solution": "import math\ndef sum_squares(lst):\n    \"\"\"Returns the sum of squared numbers after rounding each element up.\n    Each number in the list is rounded up to the nearest integer before squaring.\n    \"\"\"\n    squared_sum = 0\n    for item in lst:\n        rounded_up = math.ceil(item)\n        squared_sum += rounded_up * rounded_up\n    return squared_sum"}
{"task_id": "HumanEval/134", "solution": "def check_if_last_char_is_a_letter(txt):\n    '''\n    Create a function that returns True if the last character\n    of a given string is an alphabetical character and is not\n    a part of a word, and False otherwise.\n    Note: \"word\" is a group of characters separated by space.\n    '''\n    if not txt:\n        return False\n\n    last_char = txt[-1]\n\n    if not last_char.isalpha():\n        return False\n\n    if len(txt) == 1:\n        return True\n\n    # Check if the character before the last one is a space\n    if txt[-2] == ' ':\n        return True\n\n    return False"}
{"task_id": "HumanEval/130", "solution": "def tri(n):\n    \"\"\"\n    Calculates the first n + 1 numbers of the Tribonacci sequence.\n    Uses memoization for efficient computation of recursive values.\n    \"\"\"\n    memo = {}\n\n    def _get_trib_value(k):\n        \"\"\"\n        Recursively calculates the k-th Tribonacci number.\n        Stores and retrieves results from the memoization cache.\n        \"\"\"\n        if k in memo:\n            return memo[k]\n\n        result = 0\n        if k == 0:\n            result = 1\n        elif k == 1:\n            result = 3\n        elif k % 2 == 0:  # k is even and k > 1\n            result = 1 + k // 2\n        else:  # k is odd and k > 1\n            result = _get_trib_value(k - 1) + _get_trib_value(k - 2) + _get_trib_value(k + 1)\n\n        memo[k] = result\n        return result\n\n    sequence = []\n    for i in range(n + 1):\n        sequence.append(_get_trib_value(i))\n    return sequence"}
{"task_id": "HumanEval/133", "solution": "import math\ndef sum_squares(lst):\n    \"\"\"You are given a list of numbers.\n    You need to return the sum of squared numbers in the given list,\n    round each element in the list to the upper int(Ceiling) first.\n    Examples:\n    For lst = [1,2,3] the output should be 14\n    For lst = [1,4,9] the output should be 98\n    For lst = [1,3,5,7] the output should be 84\n    For lst = [1.4,4.2,0] the output should be 29\n    For lst = [-2.4,1,1] the output should be 6\n    \"\"\"\n    if not isinstance(lst, list):\n        raise TypeError(\"Input must be a list.\")\n\n    squared_sums = 0\n    for number in lst:\n        if not isinstance(number, (int, float)):\n            raise TypeError(f\"List elements must be numbers, got {type(number).__name__}.\")\n\n        rounded_number = math.ceil(number)\n        squared_sums += rounded_number ** 2\n\n    return squared_sums"}
{"task_id": "HumanEval/132", "solution": "def is_nested(string):\n    \"\"\"\n    Checks if the input string contains a valid nested subsequence `[[]]`.\n    This function returns True if the pattern is found, False otherwise.\n    \"\"\"\n\n    state = 0  # Tracks which part of '[[]]' we are currently looking for.\n\n    for char in string:\n        if state == 0:  # Looking for the first '['\n            if char == '[':\n                state = 1\n        elif state == 1:  # Looking for the second '['\n            if char == '[':\n                state = 2\n        elif state == 2:  # Looking for the first ']'\n            if char == ']':\n                state = 3\n        elif state == 3:  # Looking for the second ']'\n            if char == ']':\n                return True  # Found the complete '[[]]' subsequence\n\n    return False  # The full subsequence was not found after checking all characters"}
