{"task_id": "Mbpp/71", "solution": "import math\nimport time\n\ndef comb_sort(sequence, in_place=False, shrink_factor=1.3, log_performance=False):\n    \"\"\"\n    Sorts a list of elements using the comb sort algorithm.\n    Optionally sorts in-place and allows custom shrink factor.\n    \"\"\"\n    if shrink_factor <= 1:\n        raise ValueError(\"shrink_factor must be greater than 1.\")\n\n    if log_performance:\n        start_time = time.perf_counter()\n\n    if in_place:\n        working_sequence = sequence\n    else:\n        working_sequence = list(sequence) # Create a shallow copy for non-in-place sorting.\n\n    n = len(working_sequence)\n    if n <= 1:\n        if log_performance:\n            _ = time.perf_counter() # Measure end time even if no sorting happened.\n        return working_sequence\n\n    gap = n\n    swapped = True\n\n    while gap > 1 or swapped:\n        # Update gap: floor(gap / shrink_factor), minimum 1.\n        gap = math.floor(gap / shrink_factor)\n        if gap < 1:\n            gap = 1\n\n        swapped = False\n        # Perform comparison and swaps for the current gap\n        for i in range(n - gap):\n            if working_sequence[i] > working_sequence[i + gap]:\n                working_sequence[i], working_sequence[i + gap] = working_sequence[i + gap], working_sequence[i]\n                swapped = True\n\n    if log_performance:\n        _ = time.perf_counter() # Measure end time as required by logging.\n\n    return working_sequence"}
{"task_id": "Mbpp/75", "solution": "def validate_k(k):\n    # Validates that k is an integer and not zero.\n    if not isinstance(k, int):\n        raise TypeError(\"k must be an integer.\")\n    if k == 0:\n        raise ValueError(\"k cannot be zero.\")\n\ndef validate_elements(input_list):\n    # Validates that all elements within tuples in input_list are integers.\n    for tpl in input_list:\n        for element in tpl:\n            if not isinstance(element, int):\n                raise TypeError(\"All elements within tuples must be integers.\")\n\ndef filter(input_list, k) -> list[tuple]:\n    # Filters input_list to include only tuples where all elements are divisible by k.\n    result = []\n    for tpl in input_list:\n        # Empty tuples are considered valid and included.\n        if not tpl:\n            result.append(tpl)\n        else:\n            if all(element % k == 0 for element in tpl):\n                result.append(tpl)\n    return result\n\ndef find_tuples(input_list: list[tuple], k: int) -> list[tuple]:\n    \"\"\"\n    Finds tuples from a list where all elements are divisible by k.\n\n    Args:\n        input_list: A list of tuples, where each tuple contains integers.\n        k: An integer divisor.\n\n    Returns:\n        A new list containing tuples where every element is divisible by k.\n\n    Raises:\n        TypeError: If k is not an int, or any element in any tuple is not an int.\n        ValueError: If k is zero.\n    \"\"\"\n    validate_k(k)\n    validate_elements(input_list)\n    return filter(input_list, k)"}
{"task_id": "Mbpp/74", "solution": "def is_samepatterns(pattern, sequence, return_mapping=False):\n    \"\"\"\n    Checks if a sequence follows a given pattern, where pattern elements map to contiguous non-empty subsequences.\n    Optionally returns the mapping if a match is found.\n    \"\"\"\n    if pattern is None or sequence is None:\n        raise TypeError(\"pattern and sequence must be non-null\")\n\n    try:\n        m = len(pattern)\n        n = len(sequence)\n    except TypeError:\n        raise TypeError(\"pattern and sequence must be array-like (support len and indexing)\")\n\n    if m == 0:\n        return (n == 0) if not return_mapping else (n == 0, {})\n\n    if m > n:\n        return False if not return_mapping else (False, None)\n\n    current_mapping = {}\n\n    def _backtrack(p_idx, s_idx):\n        # Both pattern and sequence fully matched\n        if p_idx == m and s_idx == n:\n            return True\n        # One exhausted but not the other\n        if p_idx == m or s_idx == n:\n            return False\n\n        pat_elem = pattern[p_idx]\n\n        if pat_elem in current_mapping:\n            assigned_subsequence = current_mapping[pat_elem]\n            len_assigned = len(assigned_subsequence)\n\n            if s_idx + len_assigned > n:\n                return False\n            if sequence[s_idx : s_idx + len_assigned] == assigned_subsequence:\n                return _backtrack(p_idx + 1, s_idx + len_assigned)\n            return False\n        else:\n            remaining_pattern_elements = m - p_idx - 1\n            max_end_exclusive = n - remaining_pattern_elements\n\n            for end_exclusive in range(s_idx + 1, max_end_exclusive + 1):\n                candidate_subsequence = sequence[s_idx : end_exclusive]\n                current_mapping[pat_elem] = candidate_subsequence\n\n                if _backtrack(p_idx + 1, end_exclusive):\n                    return True\n\n                del current_mapping[pat_elem]\n            return False\n\n    matched = _backtrack(0, 0)\n\n    if return_mapping:\n        return (matched, current_mapping if matched else None)\n    return matched"}
{"task_id": "Mbpp/79", "solution": "def word_len(word: str) -> bool:\n    \"\"\"Check whether the length of the given word is odd.\n\n    Parameters:\n    - word (str): The word to check.\n\n    Returns:\n    - bool: True if the length of `word` is odd, False otherwise.\n\n    Raises:\n    - TypeError: If `word` is None or not an instance of str.\n    \"\"\"\n    if not isinstance(word, str):\n        raise TypeError(f\"word must be a str, got {type(word)}\")\n\n    return len(word) % 2 == 1"}
{"task_id": "Mbpp/80", "solution": "def tetrahedral_number(n):\n    \"\"\"\n    Computes the nth tetrahedral number.\n\n    A tetrahedral number is a figurate number that represents a pyramid with a triangular base and\n    three sides, i.e., a tetrahedron. The nth tetrahedral number can be calculated using the\n    closed-form formula: T_n = n * (n + 1) * (n + 2) // 6. This is combinatorially equivalent\n    to C(n+2, 3), the number of ways to choose 3 items from n+2 items.\n\n    Algorithm:\n    The function uses the direct closed-form formula n * (n + 1) * (n + 2) // 6 with integer\n    arithmetic (floor division) for O(1) time complexity and O(1) auxiliary space. This approach\n    is chosen for its constant-time nature, direct integer result, and avoidance of floating-point\n    inaccuracies or iterative summation. Python's arbitrary-precision integers handle large values\n    of n without overflow, though performance for extremely large n (where n has many digits)\n    will be affected by the underlying big-integer arithmetic, which is not strictly O(1) in CPU\n    time but rather depends on the bit-length of n.\n\n    Input Validation:\n    - n must be an integer. A TypeError is raised if n is not an int (e.g., float, string).\n    - n must be non-negative. A ValueError is raised if n is negative.\n\n    Examples:\n    >>> tetrahedral_number(0)\n    0\n    >>> tetrahedral_number(1)\n    1\n    >>> tetrahedral_number(2)\n    4\n    >>> tetrahedral_number(3)\n    10\n    >>> tetrahedral_number(4)\n    20\n    >>> tetrahedral_number(5)\n    35\n    \"\"\"\n\n    def _validate_n(n_val):\n        # Checks if n_val is an integer and non-negative, raising appropriate errors.\n        if not isinstance(n_val, int):\n            raise TypeError(\"expected int for n\")\n        if n_val < 0:\n            raise ValueError(\"expected non-negative n\")\n\n    def _closed_form(n_val):\n        # Computes the tetrahedral number using the closed-form formula.\n        return (n_val * (n_val + 1) * (n_val + 2)) // 6\n\n    _validate_n(n)\n    return _closed_form(n)"}
{"task_id": "Mbpp/82", "solution": "import math\nfrom typing import Any\n\n__all__ = (\"volume_sphere\",)\n\ndef _validate(radius: Any) -> None:\n    \"\"\"Validates the radius for type, finiteness, and non-negativity.\"\"\"\n    if not isinstance(radius, (int, float)):\n        raise TypeError(\"radius must be a finite non-negative int or float\")\n    if not math.isfinite(radius):\n        raise ValueError(\"radius must be a finite non-negative int or float\")\n    if radius < 0:\n        raise ValueError(\"radius must be a finite non-negative int or float\")\n\ndef volume_sphere(radius: float) -> float:\n    \"\"\"\n    Calculates the volume of a sphere given its radius.\n\n    Args:\n        radius: The radius of the sphere (must be a finite, non-negative int or float).\n\n    Returns:\n        The volume of the sphere as a float.\n\n    Raises:\n        TypeError: If radius is not an int or float.\n        ValueError: If radius is not finite (NaN, Inf) or is negative.\n    \"\"\"\n    _validate(radius)\n    return (4.0 / 3.0) * math.pi * (radius ** 3)"}
{"task_id": "Mbpp/77", "solution": "def is_Diff(n: int) -> bool:\n    \"\"\"Checks if a number is divisible by 11 using the alternating sum of its digits.\n    This function processes digits arithmetically for O(d) time and O(1) space complexity.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"is_Diff: input must be int\")\n\n    m = abs(n)\n    total = 0\n    sign = 1  # Start with +1 for the least significant digit\n\n    if m == 0:\n        return True  # 0 is divisible by 11\n\n    while m > 0:\n        digit = m % 10\n        total += sign * digit\n        sign = -sign\n        m //= 10\n\n    return (total % 11) == 0"}
{"task_id": "Mbpp/85", "solution": "import math\nfrom typing import Any\n\nclass Validator:\n    \"\"\"Helper class for validating input parameters.\"\"\"\n\n    @staticmethod\n    def validate_type(radius: Any) -> None:\n        \"\"\"Raises TypeError if radius is not an int or float.\"\"\"\n        if not isinstance(radius, (int, float)):\n            raise TypeError(\"radius must be int or float\")\n\n    @staticmethod\n    def validate_nonnegative_finite(radius: float) -> None:\n        \"\"\"Raises ValueError if radius is negative or not finite.\"\"\"\n        if not math.isfinite(radius) or radius < 0:\n            raise ValueError(\"radius must be finite and non-negative\")\n\ndef surfacearea_sphere(radius: float) -> float:\n    \"\"\"\n    Calculates the surface area of a sphere using the formula 4 * pi * radius^2.\n    Example: assert math.isclose(surfacearea_sphere(10), 1256.6370614359173, rel_tol=0.001)\n    \"\"\"\n    Validator.validate_type(radius)\n    Validator.validate_nonnegative_finite(radius)\n\n    if radius == 0:\n        return 0.0\n\n    return 4 * math.pi * float(radius) ** 2"}
{"task_id": "Mbpp/84", "solution": "class Validator:\n    \"\"\"Provides static methods for input validation.\"\"\"\n    @staticmethod\n    def validate_is_int(n: int) -> None:\n        \"\"\"Raises TypeError if n is not an integer.\"\"\"\n        if not isinstance(n, int):\n            raise TypeError(\"Input 'n' must be an integer.\")\n\n    @staticmethod\n    def validate_not_bool(n: int) -> None:\n        \"\"\"Raises TypeError if n is a boolean value.\"\"\"\n        if isinstance(n, bool):\n            raise TypeError(\"Input 'n' cannot be a boolean.\")\n\n    @staticmethod\n    def validate_minimum(n: int) -> None:\n        \"\"\"Raises ValueError if n is less than 1.\"\"\"\n        if n < 1:\n            raise ValueError(\"Input 'n' must be at least 1.\")\n\nclass MemoStore:\n    \"\"\"Stores computed Newman\u2013Conway numbers for memoization.\"\"\"\n    def __init__(self) -> None:\n        \"\"\"Initializes an empty dictionary for storing sequence values.\"\"\"\n        self._store: dict[int, int] = {}\n\n    def get(self, n: int) -> int:\n        \"\"\"Retrieves the value for index n.\"\"\"\n        return self._store.get(n)\n\n    def set(self, n: int, value: int) -> None:\n        \"\"\"Sets the value for index n.\"\"\"\n        self._store[n] = value\n\nclass SequenceCalculator:\n    \"\"\"Calculates Newman\u2013Conway sequence values iteratively using memoization.\"\"\"\n    def compute(self, n: int, memo: MemoStore) -> int:\n        \"\"\"Computes and stores sequence values up to n, returning P(n).\"\"\"\n        # Base cases P(1)=1, P(2)=1 are assumed to be pre-seeded in memo.\n        for i in range(3, n + 1):\n            seq_prev_val = memo.get(i - 1)\n            val_a = memo.get(seq_prev_val) # Calculates P(P(i-1))\n            val_b = memo.get(i - seq_prev_val) # Calculates P(i - P(i-1))\n            memo.set(i, val_a + val_b)\n        return memo.get(n)\n\ndef sequence(n: int) -> int:\n    \"\"\"\n    Calculates the nth Newman\u2013Conway number P(n) where P(1)=1, P(2)=1, P(n) = P(P(n-1)) + P(n-P(n-1)).\n    Achieves O(n) time and space complexity; raises TypeError for non-int/bool n, ValueError for n < 1. Example: sequence(10) == 6.\n    \"\"\"\n    Validator.validate_is_int(n)\n    Validator.validate_not_bool(n)\n    Validator.validate_minimum(n)\n\n    memo = MemoStore()\n    memo.set(1, 1)\n    memo.set(2, 1)\n\n    calculator = SequenceCalculator()\n    return calculator.compute(n, memo)"}
{"task_id": "Mbpp/86", "solution": "def centered_hexagonal_number(n):\n    \"\"\"Calculates the nth centered hexagonal number.\n\n    The centered hexagonal number C_n is computed using the formula C_n = 3 * n * (n - 1) + 1.\n    This function expects 'n' to be a positive integer as per the mathematical definition.\n\n    Parameters:\n        n (int): The position of the centered hexagonal number to find (n >= 1).\n\n    Returns:\n        int: The nth centered hexagonal number.\n\n    Formula:\n        C_n = 3 * n * (n - 1) + 1\n\n    Complexity:\n        Time: O(1) - constant time operation.\n        Additional Space: O(1) - constant additional space.\n\n    Examples:\n        centered_hexagonal_number(1) == 1\n        centered_hexagonal_number(2) == 7\n        centered_hexagonal_number(3) == 19\n        centered_hexagonal_number(10) == 271\n    \"\"\"\n    return 3 * n * (n - 1) + 1"}
{"task_id": "Mbpp/88", "solution": "def freq_count(lst):\n    \"\"\"Calculate the frequency of elements in a list and return a dict mapping element -> count.\n\n    Parameters\n    ----------\n    lst : iterable or None\n        An iterable of hashable elements (e.g., ints, strings, tuples). If None, it is\n        treated as an empty iterable.\n\n    Returns\n    -------\n    dict\n        A plain dictionary where keys are elements from lst and values are their occurrence counts.\n\n    Example\n    -------\n    >>> freq_count([10,10,10,10,20,20,20,20,40,40,50,50,30])\n    {10: 4, 20: 4, 40: 2, 50: 2, 30: 1}\n    \"\"\"\n    if lst is None:\n        return {}\n\n    try:\n        iterator = iter(lst)\n    except TypeError:\n        raise TypeError(\"freq_count expects an iterable or None\") from None\n\n    counts = {}\n    for item in iterator:\n        counts[item] = counts.get(item, 0) + 1\n    return counts"}
{"task_id": "Mbpp/87", "solution": "import collections.abc\nfrom typing import Any, Mapping\n\ndef merge_dictionaries_three(first: Mapping, second: Mapping, third: Mapping) -> dict:\n    \"\"\"\n    Merges three dictionaries (first, second, third) into a single new dictionary.\n\n    This function processes the dictionaries in the order first, then second, then third.\n    It preserves insertion order based on when a key is first encountered.\n    Values for overlapping keys follow last-wins precedence: third overrides second and first;\n    second overrides first. When a key is overwritten, its original insertion position is maintained.\n\n    Args:\n        first: The first dictionary or mapping to merge.\n        second: The second dictionary or mapping to merge.\n        third: The third dictionary or mapping to merge.\n\n    Returns:\n        A new dictionary containing the merged key-value pairs.\n\n    Raises:\n        TypeError: If any argument is not an instance of collections.abc.Mapping.\n                   Error message specifies the argument name and its actual type.\n\n    Complexity:\n        Time: O(n), where n is the total number of key-value pairs across all input mappings.\n        Space: O(n) for the newly created result dictionary.\n\n    Examples:\n        >>> merge_dictionaries_three({'a': 1}, {'b': 2}, {'c': 3})\n        {'a': 1, 'b': 2, 'c': 3}\n        >>> merge_dictionaries_three({'k': 1}, {'k': 2}, {'k': 3})\n        {'k': 3}\n        >>> merge_dictionaries_three({ \"R\": \"Red\", \"B\": \"Black\" }, { \"G\": \"Green\", \"W\": \"White\" }, { \"O\": \"Orange\", \"W\": \"White\", \"B\": \"Black\" })\n        {'R': 'Red', 'B': 'Black', 'G': 'Green', 'W': 'White', 'O': 'Orange'}\n        assert merge_dictionaries_three({'a':1},{'b':2},{'c':3}) == {'a':1,'b':2,'c':3}\n    \"\"\"\n    # Helper function for input validation, defined inline as per requirements.\n    def _validate_mapping(arg: Any, arg_name: str) -> None:\n        if not isinstance(arg, collections.abc.Mapping):\n            raise TypeError(f\"Argument '{arg_name}' must be a Mapping; got {type(arg).__name__}\")\n\n    # Validate all input arguments sequentially.\n    _validate_mapping(first, 'first')\n    _validate_mapping(second, 'second')\n    _validate_mapping(third, 'third')\n\n    result = {}\n\n    # Process dictionaries in order to ensure correct last-wins precedence\n    # and insertion order preservation (key's position set on first appearance).\n    for k, v in first.items():\n        result[k] = v\n    for k, v in second.items():\n        result[k] = v\n    for k, v in third.items():\n        result[k] = v\n\n    return result"}
{"task_id": "Mbpp/89", "solution": "import math\n\ndef _nextafter(x, y):\n    \"\"\"Returns the next representable floating-point value after x in the direction of y.\"\"\"\n    return math.nextafter(x, y)\n\ndef _validate_input(n):\n    \"\"\"Validates the input n, ensuring it's a valid int or float and handling specific edge cases.\"\"\"\n    if not isinstance(n, (int, float)):\n        raise ValueError(\"input must be int or float\")\n    if isinstance(n, float):\n        if math.isnan(n):\n            raise ValueError(\"input is NaN\")\n        if math.isinf(n) and n < 0:  # Checks for negative infinity\n            raise ValueError(\"input is -inf with no smaller representable value\")\n\ndef _compute_integer(n):\n    \"\"\"Computes the closest smaller integer for an integer input n.\"\"\"\n    return n - 1\n\ndef _compute_float(n):\n    \"\"\"Computes the closest smaller float for a float input n using IEEE-754 semantics.\"\"\"\n    return _nextafter(n, -math.inf)\n\ndef closest_num(n):\n    \"\"\"\n    Finds the closest number strictly smaller than n, maintaining the input type.\n\n    For integers, returns n - 1. For floats, returns the next representable\n    IEEE-754 float strictly less than n.\n    \"\"\"\n    _validate_input(n)\n\n    if isinstance(n, int):\n        return _compute_integer(n)\n    else:  # Guaranteed to be float by _validate_input\n        return _compute_float(n)"}
{"task_id": "Mbpp/90", "solution": "def len_log(words: list[str]) -> int:\n    \"\"\"\n    Finds the length of the longest word in a list of strings.\n    assert len_log([\"python\",\"PHP\",\"bigdata\"]) == 7\n    \"\"\"\n    if not words:\n        return 0\n    return max(len(w) for w in words)"}
{"task_id": "Mbpp/91", "solution": "from typing import List\n\ndef validate_inputs(strings, substring) -> None:\n    \"\"\"Raise TypeError on invalid inputs.\"\"\"\n    if not isinstance(strings, (list, tuple)):\n        raise TypeError(\"`strings` must be a list-like of strings\")\n    if not isinstance(substring, str):\n        raise TypeError(\"`substring` must be a string\")\n    for el in strings:\n        if not isinstance(el, str):\n            raise TypeError(\"all elements of `strings` must be strings\")\n\ndef find_substring(strings: List[str], substring: str) -> bool:\n    \"\"\"Return True if substring present in any element of strings; otherwise False.\"\"\"\n    validate_inputs(strings, substring)\n    if len(strings) == 0:\n        return False\n    for s in strings:\n        if substring in s:\n            return True\n    return False"}
{"task_id": "Mbpp/92", "solution": "def is_undulating(number):\n    \"\"\"\n    Checks if an integer is undulating: has at least two digits, and digits alternate\n    between exactly two distinct values (e.g., 12121).\n    \"\"\"\n    if not isinstance(number, int):\n        raise TypeError(\"Input must be an integer.\")\n\n    abs_number = abs(number)\n    digits = list(str(abs_number))\n\n    if len(digits) < 2:\n        return False\n\n    if digits[0] == digits[1]:\n        return False\n\n    for i in range(len(digits)):\n        expected_digit = digits[0] if i % 2 == 0 else digits[1]\n        if digits[i] != expected_digit:\n            return False\n\n    return True"}
{"task_id": "Mbpp/94", "solution": "def index_minimum(lst):\n    \"\"\"\n    Returns the first value of the tuple with the smallest second value.\n    If multiple tuples share the minimal second value, the first encountered is returned.\n\n    Args:\n        lst (list): list of tuples where each tuple has at least two elements.\n\n    Returns:\n        The first element (index 0) of the tuple with the smallest second element (index 1).\n\n    Raises:\n        ValueError: if lst is empty.\n        TypeError: if any item is not a tuple or has fewer than two elements.\n                   TypeError from comparing non-comparable second elements is propagated.\n    \"\"\"\n    if not lst:\n        raise ValueError(\"lst must not be empty\")\n\n    # Validate and initialize with the first element\n    first_item = lst[0]\n    if not isinstance(first_item, tuple) or len(first_item) < 2:\n        raise TypeError(\"each item must be a tuple with at least two elements\")\n    min_first = first_item[0]\n    min_second = first_item[1]\n\n    # Single-pass scan; preserves first-encountered on ties\n    for item in lst[1:]:\n        if not isinstance(item, tuple) or len(item) < 2:\n            raise TypeError(\"each item must be a tuple with at least two elements\")\n        current_second = item[1]\n        # Allow TypeError from non-comparable types to propagate\n        if current_second < min_second:\n            min_second = current_second\n            min_first = item[0]\n\n    return min_first"}
{"task_id": "Mbpp/96", "solution": "def divisor(n: int) -> int:\n    \"\"\"Compute the number of positive divisors of integer n. Uses abs(n) for negative inputs.\"\"\"\n    n_abs = abs(n)\n    if n_abs == 0:\n        return 0\n\n    count = 0\n    limit = int(n_abs**0.5) + 1\n\n    for d in range(1, limit):\n        if n_abs % d == 0:\n            if d * d == n_abs:\n                count += 1\n            else:\n                count += 2\n    return count"}
{"task_id": "Mbpp/95", "solution": "from typing import List, Any\n\ndef Find_Min_Length(lists: List[List[Any]]) -> int:\n    \"\"\"\n    Return the length of the smallest inner list in `lists`.\n\n    Args:\n        lists: Outer list containing inner lists.\n\n    Returns:\n        The minimum length (int) among the inner lists. Returns 0 immediately\n        if any inner list is empty.\n\n    Raises:\n        ValueError: If the outer list is empty.\n        TypeError: If any element of the outer list is not a list.\n\n    Time complexity: O(n) where n is the number of inner lists (len() is assumed O(1)).\n    Space complexity: O(1) additional space.\n    \"\"\"\n    if not isinstance(lists, list):\n        raise TypeError(f\"expected outer argument 'lists' to be a list (type: {type(lists).__name__})\")\n\n    if len(lists) == 0:\n        raise ValueError(\"outer list is empty\")\n\n    min_len = None\n    for i, item in enumerate(lists):\n        if not isinstance(item, list):\n            raise TypeError(f\"element at index {i} is not a list (type: {type(item).__name__})\")\n\n        current_len = len(item)\n        if current_len == 0:\n            return 0\n\n        if min_len is None or current_len < min_len:\n            min_len = current_len\n\n    # min_len is guaranteed to be set because outer list is non-empty\n    return int(min_len)"}
{"task_id": "Mbpp/97", "solution": "def frequency_lists(list_of_lists: list) -> dict:\n    \"\"\"\n    Calculates the frequency of each element in a flattened list of lists.\n    Raises TypeError if the outer input is not a list or if an element is unhashable.\n    \"\"\"\n    if not isinstance(list_of_lists, list):\n        raise TypeError(\"Outer input must be a list\")\n\n    counts = {}\n    for inner in list_of_lists:\n        if isinstance(inner, list):\n            iterable = inner\n        else:\n            iterable = [inner]\n\n        for elem in iterable:\n            # Python will raise TypeError if 'elem' is unhashable\n            counts[elem] = counts.get(elem, 0) + 1\n\n    return counts"}
{"task_id": "Mbpp/93", "solution": "import math\nfrom typing import Union\n\nclass NumericOperand:\n    \"\"\"Helper for operand value, type checking, and conversion.\"\"\"\n    def __init__(self, value):\n        self.value = value\n\n    def is_integer(self) -> bool:\n        \"\"\"Checks if the value is an integer or a float with no fractional part.\"\"\"\n        return isinstance(self.value, int) or (isinstance(self.value, float) and self.value.is_integer())\n\n    def is_float(self) -> bool:\n        \"\"\"Checks if the value is a float.\"\"\"\n        return isinstance(self.value, float)\n\n    def to_float(self) -> float:\n        \"\"\"Converts the value to a float, raising TypeError if conversion fails.\"\"\"\n        try:\n            return float(self.value)\n        except (ValueError, TypeError) as e:\n            raise TypeError(f\"Unsupported operand type for conversion to float: {type(self.value)}\") from e\n\nclass ExponentiationBySquaring:\n    \"\"\"Computes integer powers using exponentiation-by-squaring.\"\"\"\n    def compute(self, base_val: Union[int, float], exp: int) -> Union[int, float]:\n        \"\"\"Calculates base_val raised to the power of exp using the fast exponentiation algorithm.\n        Assumes exp is a non-negative integer.\n        \"\"\"\n        # 0^positive_exp is 0. 0^0 is handled in PowerFunction.\n        if base_val == 0:\n            return 0\n\n        result = 1\n        base = base_val\n\n        while exp > 0:\n            if exp % 2 == 1:\n                result *= base\n            base *= base\n            exp //= 2\n        return result\n\nclass LogExpStrategy:\n    \"\"\"Computes non-integer powers using math.exp(b * math.log(a)).\"\"\"\n    def compute(self, base_operand: NumericOperand, exp: float) -> float:\n        \"\"\"Calculates a^b using the log-exp identity for a > 0.\"\"\"\n        float_a = base_operand.to_float()\n        # The case float_a <= 0 should primarily be caught by _validate_inputs or earlier in compute.\n        if float_a <= 0:\n             raise ValueError(\"math domain error: base must be positive for non-integer exponent.\")\n        return math.exp(exp * math.log(float_a))\n\nclass PowerFunction:\n    \"\"\"Orchestrates validation, strategy selection, and result typing for power(a, b).\"\"\"\n    def compute(self, a, b):\n        \"\"\"Computes a**b, selecting the appropriate strategy and handling edge cases.\"\"\"\n        a_operand, b_operand = self._validate_inputs(a, b)\n\n        # Handle b == 0\n        if b_operand.to_float() == 0:\n            # Return int 1 if both original inputs were int, else float 1.0.\n            return 1 if a_operand.is_integer() and b_operand.is_integer() else 1.0\n\n        # Handle integer exponents\n        if b_operand.is_integer():\n            int_b = int(b_operand.value)\n            if int_b >= 0: # Non-negative integer exponent\n                result = ExponentiationBySquaring().compute(a_operand.value, int_b)\n                # Return int if both original inputs were int and result is whole, else float.\n                return int(result) if a_operand.is_integer() and b_operand.is_integer() and result == int(result) else float(result)\n            else: # Negative integer exponent\n                # ZeroDivisionError for 0^negative is handled in _validate_inputs.\n                pos_power = ExponentiationBySquaring().compute(a_operand.value, abs(int_b))\n                return 1.0 / float(pos_power) # Negative integer exponents always yield float reciprocals.\n        else: # Non-integer exponent\n            # ValueError for negative base with non-integer exponent is handled in _validate_inputs.\n            # Use log-exp strategy, always returns float.\n            return LogExpStrategy().compute(a_operand, b_operand.to_float())\n\n    def _validate_inputs(self, a, b):\n        \"\"\"Validates input types and domain, returning NumericOperand wrappers.\"\"\"\n        a_op, b_op = NumericOperand(a), NumericOperand(b)\n\n        try: # Attempt to convert to float to ensure basic numeric compatibility.\n            a_op.to_float()\n            b_op.to_float()\n        except TypeError as e:\n            raise TypeError(\"Unsupported operand type for 'power' function. Both 'a' and 'b' must be numeric.\") from e\n\n        # Handle specific domain error: 0 to a negative power.\n        if a_op.to_float() == 0 and b_op.to_float() < 0:\n            raise ZeroDivisionError(\"0.0 cannot be raised to a negative power.\")\n\n        # Handle specific domain error: negative base with non-integer exponent (real-only mode).\n        if a_op.to_float() < 0 and not b_op.is_integer():\n            raise ValueError(\"Cannot raise a negative number to a non-integer power in real-only mode.\")\n\n        return a_op, b_op\n\ndef power(a, b):\n    \"\"\"Calculates 'a' to the power of 'b' using optimized strategies.\n    Supports integer and non-integer exponents, returning int or float based on input types.\n    \"\"\"\n    return PowerFunction().compute(a, b)"}
{"task_id": "Mbpp/98", "solution": "def multiply_num(iterable):\n    \"\"\"\n    Multiplies all numbers in an iterable and divides the product by the count of numbers.\n    Raises TypeError or ValueError for invalid inputs or elements.\n    \"\"\"\n    def validate_iterable(input_iterable):\n        \"\"\"Validates if the input is an iterable, raising TypeError if not.\"\"\"\n        try:\n            iter(input_iterable)\n        except TypeError:\n            raise TypeError(\"input is not iterable\")\n\n    def validate_element(elem):\n        \"\"\"Validates if an element is numeric (int or float), raising TypeError if not.\"\"\"\n        if not isinstance(elem, (int, float)):\n            raise TypeError(f\"non-numeric element encountered: {elem}\")\n\n    def compute_product_and_count(input_iterable):\n        \"\"\"Computes the product and count of numeric elements in an iterable.\"\"\"\n        running_product = 1.0\n        count = 0\n        for elem in input_iterable:\n            validate_element(elem)\n            running_product *= float(elem)\n            count += 1\n        return running_product, count\n\n    validate_iterable(iterable)\n    product, count = compute_product_and_count(iterable)\n\n    if count == 0:\n        raise ValueError(\"iterable is empty\")\n\n    return product / count"}
{"task_id": "Mbpp/101", "solution": "def kth_element(array, k):\n    \"\"\"Return the k-th element (1-based indexing) from the given array.\n\n    Args:\n        array: A sequence supporting __len__ and __getitem__ (e.g., list or tuple).\n        k: Integer representing a 1-based index.\n\n    Returns:\n        The element at position k (array[k - 1]).\n\n    Raises:\n        TypeError: If k is not an int or array doesn't support required operations.\n        IndexError: If k is out of bounds (k < 1 or k > len(array)).\n    \"\"\"\n    # Validate k type\n    if not isinstance(k, int):\n        raise TypeError(\"k must be an int representing a 1-based index\")\n\n    # Validate array supports len() and indexing\n    try:\n        n = len(array)\n    except TypeError:\n        raise TypeError(\"array must be a sequence supporting __len__() and __getitem__()\")\n\n    if k < 1 or k > n:\n        raise IndexError(\"k is out of bounds for the given array\")\n\n    return array[k - 1]"}
{"task_id": "Mbpp/105", "solution": "def validate_input(items: list) -> None:\n    \"\"\"Validates that the input is a list.\"\"\"\n    if not isinstance(items, list):\n        raise TypeError('items must be a list')\n\ndef is_bool_true(x: object) -> bool:\n    \"\"\"Checks if an object is strictly the boolean True.\"\"\"\n    return x is True\n\ndef count(items: list) -> int:\n    \"\"\"Counts the number of strict boolean True values in a list.\n\n    Raises TypeError if items is not a list.\n    Examples:\n    count([True, False, True]) -> 2\n    count([1, True, 0, False]) -> 1\n    count([]) -> 0\n    count([True, True, True]) -> 3\n    \"\"\"\n    validate_input(items)\n    counter = 0\n    for x in items:\n        if is_bool_true(x):\n            counter += 1\n    return counter"}
{"task_id": "Mbpp/104", "solution": "from typing import Union, List, Sequence, Tuple\n\ndef sort_sublists(sequences: Union[List[Sequence[str]], Tuple[Sequence[str], ...]]) -> List[List[str]]:\n    \"\"\"\n    Sorts each sublist of strings in a given list or tuple of sublists.\n    Returns a new list containing alphabetically sorted copies of the sublists,\n    without modifying the original input.\n\n    Parameters:\n    - sequences: list or tuple whose elements are sequences of str.\n\n    Returns:\n    - List[List[str]]: a new list where each element is a list with the sorted\n      elements of the corresponding input sublist.\n\n    Note:\n    - This implementation assumes that each sublist contains only strings and\n      that the top-level container is a list or tuple. It will raise the\n      usual Python errors if non-iterable elements are present or elements are\n      not comparable.\n    \"\"\"\n    return [list(sorted(sublist)) for sublist in sequences]"}
{"task_id": "Mbpp/102", "solution": "def _process_segment(seg: str) -> str:\n    \"\"\"Transforms a single segment, uppercasing the first alphabetic character and lowercasing subsequent ones.\"\"\"\n    if not seg:\n        return seg\n\n    first_alpha_idx = -1\n    for i, char in enumerate(seg):\n        if char.isalpha():\n            first_alpha_idx = i\n            break\n\n    if first_alpha_idx == -1:\n        return seg  # No alphabetic characters, return segment unchanged\n\n    transformed_chars = []\n    for i, char in enumerate(seg):\n        if char.isalpha():\n            if i == first_alpha_idx:\n                transformed_chars.append(char.upper())\n            else:\n                transformed_chars.append(char.lower())\n        else:\n            transformed_chars.append(char)\n    return \"\".join(transformed_chars)\n\ndef snake_to_camel(s: str) -> str:\n    \"\"\"Converts a snake_case string to PascalCase (CamelCase with leading capitals).\"\"\"\n    segments = s.split('_')\n    camel_parts = []\n    for segment in segments:\n        if segment:  # Skip empty segments from leading/trailing/consecutive underscores\n            camel_parts.append(_process_segment(segment))\n    return \"\".join(camel_parts)"}
{"task_id": "Mbpp/106", "solution": "def add_lists(list_, tup):\n    \"\"\"\n    Return a new tuple containing items from tup followed by items from list_.\n    Duck-typing: both arguments must be iterable.\n    \"\"\"\n    try:\n        iter(tup)\n    except TypeError:\n        raise TypeError(\"tup must be an iterable\")\n    try:\n        iter(list_)\n    except TypeError:\n        raise TypeError(\"list_ must be an iterable\")\n\n    base = tuple(tup)\n    appended = tuple(list_)\n    return base + appended"}
{"task_id": "Mbpp/99", "solution": "def decimal_to_binary(n: int) -> str:\n    \"\"\"\nPurpose: Convert an integer to its binary string representation with no leading zeros.\n\nParameters:\n  n (int) -- the integer to convert.\n\nReturns:\n  str -- binary representation; \"0\" for zero; for negatives, a leading '-' followed by binary of abs(n).\n\nRaises:\n  TypeError -- if n is not an int (message: \"decimal_to_binary: input must be an int\").\n\nAlgorithm summary:\n  Iterative bit-extraction: repeatedly divide the absolute value by 2, collect remainders, then reverse the\n  collected bits to form the binary string.\n\nUsage examples:\n  decimal_to_binary(0) -> \"0\"\n  decimal_to_binary(5) -> \"101\"\n  decimal_to_binary(-5) -> \"-101\"\n  decimal_to_binary(1) -> \"1\"\n  decimal_to_binary(16) -> \"10000\"\n\"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"decimal_to_binary: input must be an int\")\n\n    if n == 0:\n        return \"0\"\n\n    is_negative = n < 0\n    abs_n = -n if is_negative else n\n\n    bits = []\n    while abs_n > 0:\n        bits.append(str(abs_n & 1))\n        abs_n >>= 1\n    bits.reverse()\n    bits_str = ''.join(bits)\n\n    return ('-' if is_negative else '') + bits_str"}
{"task_id": "Mbpp/100", "solution": "def next_smallest_palindrome(n: int) -> int:\n    \"\"\"\n    Finds the next smallest palindrome of a specified integer, returned as an integer.\n    \"\"\"\n\n    def _int_to_digits(num: int) -> list[int]:\n        \"\"\"Converts an integer to a list of its digits.\"\"\"\n        return [int(d) for d in str(num)]\n\n    def _digits_to_int(digits_list: list[int]) -> int:\n        \"\"\"Converts a list of digits back to an integer.\"\"\"\n        if not digits_list:\n            return 0\n        return int(\"\".join(map(str, digits_list)))\n\n    def _is_all_nines(digits_list: list[int]) -> bool:\n        \"\"\"Checks if all digits in the list are 9s.\"\"\"\n        return all(d == 9 for d in digits_list)\n\n    def _propagate_carry(half_digits: list[int]) -> list[int]:\n        \"\"\"Increments a list of digits (most-significant first), propagating carries from right to left.\"\"\"\n        new_half = list(half_digits)\n        carry = 1\n        for i in range(len(new_half) - 1, -1, -1):\n            digit_sum = new_half[i] + carry\n            new_half[i] = digit_sum % 10\n            carry = digit_sum // 10\n            if carry == 0:\n                break\n        if carry > 0:\n            new_half.insert(0, 1)\n        return new_half\n\n    def _mirror_digits_to_palindrome(current_digits: list[int]) -> list[int]:\n        \"\"\"Mirrors the left half of a digit list to form a full palindrome, based on its current length.\"\"\"\n        d = len(current_digits)\n        result = list(current_digits)\n        for i in range(d // 2):\n            result[d - 1 - i] = result[i]\n        return result\n\n    def _build_palindrome_from_half(left_half: list[int], middle_digit: int | None) -> list[int]:\n        \"\"\"Builds a complete palindrome from a left half and an optional middle digit.\"\"\"\n        palindrome = list(left_half)\n        if middle_digit is not None:\n            palindrome.append(middle_digit)\n        palindrome.extend(reversed(left_half))\n        return palindrome\n\n    if n < 10:\n        return n + 1\n\n    digits = _int_to_digits(n)\n    d = len(digits)\n\n    if _is_all_nines(digits):\n        # e.g., 9 -> 11, 99 -> 101, 999 -> 1001\n        return _digits_to_int([1] + [0] * (d - 1) + [1])\n\n    # Construct the first candidate palindrome by mirroring the left half\n    # This might result in a number smaller or equal to n, or larger.\n    candidate_digits = _mirror_digits_to_palindrome(digits)\n    candidate_num = _digits_to_int(candidate_digits)\n\n    if candidate_num > n:\n        return candidate_num\n    else:\n        # Candidate is not greater than n, so we need to increment the \"left\" side\n        # and re-mirror.\n        if d % 2 == 0:  # Even length\n            left = digits[0 : d // 2]\n            new_left = _propagate_carry(left)\n            result_digits = _build_palindrome_from_half(new_left, None)\n            return _digits_to_int(result_digits)\n        else:  # Odd length\n            left = digits[0 : d // 2]\n            middle = digits[d // 2]\n\n            middle += 1\n            if middle < 10:\n                # No carry from middle digit\n                result_digits = list(left) + [middle] + list(reversed(left))\n                return _digits_to_int(result_digits)\n            else:\n                # Middle digit became 10, propagate carry to left half\n                new_left = _propagate_carry(left)\n                # Middle digit effectively becomes 0 after carry\n                result_digits = _build_palindrome_from_half(new_left, 0)\n                return _digits_to_int(result_digits)"}
{"task_id": "Mbpp/103", "solution": "def eulerian_num(n: int, m: int) -> int:\n    \"\"\"Calculates the Eulerian number A(n, m) using dynamic programming.\n    A(n, m) is the number of permutations of {1..n} with exactly m descents.\n    \"\"\"\n    if not isinstance(n, int):\n        raise ValueError(f\"n must be an integer, got {n!r}\")\n    if not isinstance(m, int):\n        raise ValueError(f\"m must be an integer, got {m!r}\")\n    if n < 0:\n        raise ValueError(f\"n must be non-negative, got {n}\")\n    if m < 0:\n        raise ValueError(f\"m must be non-negative, got {m}\")\n\n    if n == 0 and m == 0:\n        return 1\n    # For n > 0, A(n, m) is 0 if m >= n.\n    if n > 0 and m >= n:\n        return 0\n\n    # Use a space-optimized 1D DP array of length m+1 (since we only need up to A(i, m))\n    # but ensure we allocate at least i elements per row; safe allocation is min(i, m)+1 each iteration.\n    # Simpler: allocate m+1 and update from high to low.\n    cur = [0] * (m + 1)\n    cur[0] = 1  # A(0,0) = 1\n\n    for i in range(1, n + 1):\n        # next_row will hold A(i, j) for j = 0..min(i-1, m)\n        next_row = [0] * (m + 1)\n        upper_j = min(i - 1, m)\n        for j in range(0, upper_j + 1):\n            term1 = 0\n            if j > 0:\n                term1 = (i - j) * cur[j - 1]\n            term2 = (j + 1) * (cur[j] if j < len(cur) else 0)\n            next_row[j] = term1 + term2\n        cur = next_row\n\n    return cur[m]"}
{"task_id": "Mbpp/113", "solution": "def check_integer(s: str) -> bool:\n    \"\"\"\n    Checks if a string represents an integer according to specific ASCII rules.\n    An integer string consists of an optional leading '+' or '-' followed by one or more ASCII digits.\n    \"\"\"\n    def is_ascii_digit(ch: str) -> bool:\n        \"\"\"Returns True if the character is an ASCII digit ('0'-'9').\"\"\"\n        return len(ch) == 1 and '0' <= ch <= '9'\n\n    trimmed = s.strip()\n\n    if not trimmed:\n        return False\n\n    start_index = 0\n    if trimmed[0] in ('+', '-'):\n        start_index = 1\n        # If only a sign exists, it's not a valid integer\n        if len(trimmed) == 1:\n            return False\n\n    # The remaining part (after an optional sign) must contain digits\n    if start_index >= len(trimmed):\n        return False\n\n    for i in range(start_index, len(trimmed)):\n        if not is_ascii_digit(trimmed[i]):\n            return False\n\n    return True"}
{"task_id": "Mbpp/108", "solution": "import heapq\nfrom typing import Any, List, Tuple\n\ndef merge_sorted_list(a: Any, b: Any, c: Any) -> List[Any]:\n    \"\"\"\n    Merges three input lists (or None, treated as empty) into a single sorted list, preserving duplicates and not mutating inputs.\n    Raises TypeError for invalid input types or non-comparable elements.\n    Example: assert merge_sorted_list([1,3],[2,4],[0,5]) == [0,1,2,3,4,5]\n    \"\"\"\n    def _validate_inputs(a_in: Any, b_in: Any, c_in: Any) -> Tuple[List[Any], List[Any], List[Any]]:\n        \"\"\"Validates inputs, converts None to empty lists, and raises TypeError for invalid types.\"\"\"\n        normalized_inputs = []\n        for arg in [a_in, b_in, c_in]:\n            if arg is None:\n                normalized_inputs.append([])\n            elif isinstance(arg, list):\n                normalized_inputs.append(arg)\n            else:\n                raise TypeError(f\"Input must be a list or None, but received {type(arg)}\")\n        return tuple(normalized_inputs)\n\n    def _k_way_merge(lists: List[List[Any]]) -> List[Any]:\n        \"\"\"Merges multiple sorted lists into a single sorted list using a min-heap.\"\"\"\n        result = []\n        min_heap = [] # Stores (value, list_idx, element_idx_in_list)\n\n        # Initialize heap with the first element from each non-empty list.\n        for list_idx, current_list in enumerate(lists):\n            if current_list:\n                # Push (value, source_list_index, index_of_next_element_to_push) to the heap.\n                heapq.heappush(min_heap, (current_list[0], list_idx, 1))\n\n        # Pop elements from heap and add the next one from its source list.\n        while min_heap:\n            value, list_idx, element_idx_in_list = heapq.heappop(min_heap)\n            result.append(value)\n\n            source_list = lists[list_idx]\n            if element_idx_in_list < len(source_list):\n                heapq.heappush(min_heap, (source_list[element_idx_in_list], list_idx, element_idx_in_list + 1))\n\n        return result\n\n    # Validate and normalize inputs (None becomes an empty list).\n    normalized_a, normalized_b, normalized_c = _validate_inputs(a, b, c)\n\n    # Perform the k-way merge on the normalized lists.\n    merged_list = _k_way_merge([normalized_a, normalized_b, normalized_c])\n\n    return merged_list"}
