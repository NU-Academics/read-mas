{"task_id": "Mbpp/754", "solution": "def extract_index_list(l1: list, l2: list, l3: list) -> list:\n    \"\"\"Finds elements that appear in all three lists at the same index.\n\n    Compares elements at corresponding indices up to the length of the shortest list.\n    Equality uses Python's `==` operator.\n\n    Args:\n        l1: The first input list.\n        l2: The second input list.\n        l3: The third input list.\n\n    Returns:\n        A new list containing elements that are common at the same index across all three lists,\n        preserving order and including duplicates.\n\n    Raises:\n        TypeError: If any of the arguments (`l1`, `l2`, `l3`) is not a list.\n\n    Complexity:\n        Time: O(n), where n = min(len(l1), len(l2), len(l3)).\n        Space: O(k) additional memory for the result list, where k is the number of matches.\n\n    Examples:\n        >>> extract_index_list([1, 1, 3, 4, 5, 6, 7], [0, 1, 2, 3, 4, 5, 7], [0, 1, 2, 3, 4, 5, 7])\n        [1, 7]\n        >>> extract_index_list([1, 2, 3], [1, 4, 3], [1, 5, 3])\n        [1, 3]\n        >>> extract_index_list([], [], [])\n        []\n        >>> extract_index_list([\"a\", \"b\"], [\"a\", \"x\"], [\"a\", \"y\"])\n        [\"a\"]\n    \"\"\"\n    if not isinstance(l1, list) or not isinstance(l2, list) or not isinstance(l3, list):\n        raise TypeError(\"All arguments must be lists\")\n\n    n = min(len(l1), len(l2), len(l3))\n    result: list = []\n\n    for i in range(n):\n        a = l1[i]\n        b = l2[i]\n        c = l3[i]\n        if a == b and b == c:\n            result.append(a)\n\n    return result"}
{"task_id": "Mbpp/753", "solution": "import collections.abc\nimport heapq\nfrom typing import Any, Iterable, List, Tuple\n\nSWITCH_TO_SORTED_RATIO: float = 0.25\n\nclass _Record:\n    \"\"\"Internal helper to store a record's data, original index, and sort key.\"\"\"\n    __slots__ = ('data', 'original_index', 'key')\n\n    def __init__(self, data: Tuple[Any, ...], original_index: int, key: Any):\n        self.data = data\n        self.original_index = original_index\n        self.key = key\n\n    def __lt__(self, other: '_Record') -> bool:\n        \"\"\"Compares records primarily by key, then by original index for stability.\"\"\"\n        if self.key < other.key:\n            return True\n        if self.key == other.key:\n            return self.original_index < other.original_index\n        return False\n\ndef min_k(records: Iterable[Tuple[Any, ...]], k: int) -> List[Tuple[Any, ...]]:\n    \"\"\"\n    Finds the minimum k records from an iterable of tuples.\n\n    Each record's second element (index 1) is used as the numeric key for comparison.\n    Ties are broken by the original input order. The function handles input validation,\n    edge cases for k, and optimizes performance using either heapq.nsmallest or sorted().\n\n    Args:\n        records: An iterable of tuples, each with at least two elements and a numeric\n                 (int or float) second element as the key.\n        k: The number of minimum records to retrieve.\n\n    Returns:\n        A new list containing the k records with the smallest second-element keys,\n        sorted ascending. Returns an empty list if k <= 0 or no valid records found.\n        If k >= the number of valid records, all valid records are returned, sorted.\n\n    Raises:\n        TypeError: If 'records' is not an iterable (or is a string), 'k' is not an int,\n                   any record is not a tuple or has fewer than two elements,\n                   or any record's second element is not numeric (int or float).\n\n    Complexity:\n        O(N) for validation and enumeration. O(N log k) using heapq.nsmallest for small k\n        (k < N * SWITCH_TO_SORTED_RATIO). O(N log N) using sorted() for large k.\n        The `SWITCH_TO_SORTED_RATIO` is set to 0.25.\n    Examples:\n        assert min_k([('Manjeet', 10), ('Akshat', 4), ('Akash', 2), ('Nikhil', 8)], 2) == [('Akash', 2), ('Akshat', 4)]\n        assert min_k([(1,5),(2,3),(3,7),(4,3)], 2) == [(2,3),(4,3)]\n        assert min_k([(1,5),(2,3),(3,7),(4,3)], 0) == []\n        assert min_k([(1,5),(2,3),(3,7),(4,3)], 10) == [(2,3),(4,3),(1,5),(3,7)]\n    \"\"\"\n    if not isinstance(k, int):\n        raise TypeError(\"k must be an integer.\")\n\n    if k <= 0:\n        return []\n\n    if not isinstance(records, collections.abc.Iterable) or isinstance(records, str):\n        raise TypeError(\"records must be an iterable and cannot be a string.\")\n\n    valid_records_snapshot: List[_Record] = []\n    for i, item in enumerate(records):\n        if not isinstance(item, tuple) or len(item) < 2:\n            raise TypeError(\n                f\"Record at index {i} must be a tuple with at least two elements.\"\n            )\n        if not isinstance(item[1], (int, float)):\n            raise TypeError(\n                f\"The second element (key) of record at index {i} must be numeric (int or float).\"\n            )\n        valid_records_snapshot.append(_Record(data=item, original_index=i, key=item[1]))\n\n    n = len(valid_records_snapshot)\n\n    if k >= n:\n        return [rec.data for rec in sorted(valid_records_snapshot)]\n\n    if k < max(1, int(n * SWITCH_TO_SORTED_RATIO)):\n        selected_records = heapq.nsmallest(k, valid_records_snapshot)\n    else:\n        selected_records = sorted(valid_records_snapshot)[:k]\n\n    return [rec.data for rec in selected_records]"}
{"task_id": "Mbpp/757", "solution": "import collections\n\ndef count_reverse_pairs(strings: list) -> int:\n    \"\"\"\n    Counts unordered pairs of strings in a list that are reverses of each other.\n    Handles palindromic strings and distinct non-palindromic reverse pairs efficiently.\n    \"\"\"\n    if not isinstance(strings, list):\n        raise TypeError(\"Input must be a list of strings\")\n    if any(not isinstance(s, str) for s in strings):\n        raise TypeError(\"All elements of the input list must be strings\")\n\n    if len(strings) < 2:\n        return 0\n\n    freq_map = collections.Counter(strings)\n    total_pairs = 0\n\n    # Iterate through each unique string in the frequency map.\n    # The canonical ordering (s < rev) ensures each distinct pair is counted once.\n    for s, count in freq_map.items():\n        rev = s[::-1]\n\n        if s == rev:\n            # For palindromic strings, count combinations within its own occurrences.\n            total_pairs += count * (count - 1) // 2\n        elif s < rev and rev in freq_map:\n            # For distinct reverse pairs (s, rev), count product of their frequencies.\n            # The 's < rev' condition prevents double-counting the pair (s, rev) and (rev, s).\n            total_pairs += count * freq_map[rev]\n\n    return total_pairs"}
{"task_id": "Mbpp/755", "solution": "def second_smallest(nums):\n    \"\"\"\n    Write a function to find the second smallest number in a list.\n    \"\"\"\n    iterator = iter(nums)\n\n    min1 = None\n    min2 = None\n\n    for element in iterator:\n        # Per design requirements, assume elements are numeric and not NaN;\n        # also assume there are at least two distinct numeric values, so no exceptions are raised for these edge cases.\n\n        if min1 is None:\n            min1 = element\n        elif element < min1:\n            min2 = min1\n            min1 = element\n        elif element > min1:\n            if min2 is None or element < min2:\n                min2 = element\n        # If element == min1, it is a duplicate of the smallest, so it's ignored.\n        # If element == min2 and element > min1, it is a duplicate of the second smallest, so it's ignored.\n\n    return min2"}
{"task_id": "Mbpp/760", "solution": "def unique_Element(numbers):\n    \"\"\"\n    Checks if a list of numbers contains only one distinct element.\n    Returns True if all elements are the same, False otherwise or if the list is empty.\n    \"\"\"\n    iterator = iter(numbers)\n\n    try:\n        first_element = next(iterator)\n    except StopIteration:\n        # The iterable is empty, meaning no distinct elements.\n        return False\n\n    for element in iterator:\n        if element != first_element:\n            return False\n\n    # All elements matched the first, or there was only one element.\n    return True"}
{"task_id": "Mbpp/762", "solution": "def check_monthnumber_number(month):\n    \"\"\"\n    Checks if a given month number (1-12) has 30 days.\n    Raises TypeError if month is not an int, ValueError if month is out of range.\n    \"\"\"\n    if not isinstance(month, int):\n        raise TypeError(\"month must be an int\")\n    if not (1 <= month <= 12):\n        raise ValueError(\"month must be in 1..12\")\n\n    THIRTY_DAY_MONTHS = (4, 6, 9, 11)\n    return month in THIRTY_DAY_MONTHS"}
{"task_id": "Mbpp/758", "solution": "from typing import Sequence, Any, Tuple, Dict\n\ndef _to_immutable(obj: Any) -> Any:\n    \"\"\"Recursively converts lists to tuples for hashing; preserves tuples and other objects.\"\"\"\n    if isinstance(obj, list):\n        return tuple(_to_immutable(elem) for elem in obj)\n    elif isinstance(obj, tuple):\n        return tuple(_to_immutable(elem) for elem in obj)\n    return obj\n\ndef unique_sublists(sublists: Sequence[Sequence[Any]]) -> Dict[Tuple[Any, ...], int]:\n    \"\"\"\n    Return a dictionary counting unique sublists.\n\n    Parameters\n    ----------\n    sublists : Sequence[Sequence[Any]]\n        A list (or tuple) of sublists; each sublist may contain arbitrary elements.\n\n    Returns\n    -------\n    Dict[Tuple[Any, ...], int]\n        A dictionary mapping each unique sublist (converted to an immutable tuple, nested lists recursively converted to tuples) to the number of times it appears in the input.\n\n    Raises\n    ------\n    TypeError\n        If the top-level argument is not a list or tuple, or if any element of the top-level sequence is not a list or tuple.\n\n    Examples\n    --------\n    >>> unique_sublists([[1, 3], [5, 7], [1, 3], [13, 15, 17], [5, 7], [9, 11]])\n    {(1, 3): 2, (5, 7): 2, (13, 15, 17): 1, (9, 11): 1}\n    \"\"\"\n    if not isinstance(sublists, (list, tuple)):\n        raise TypeError(\"sublists must be a list or tuple\")\n\n    if not sublists:\n        return {}\n\n    counts: Dict[Tuple[Any, ...], int] = {}\n    for sub in sublists:\n        if not isinstance(sub, (list, tuple)):\n            raise TypeError(\"each element of sublists must be a list or tuple\")\n        key = _to_immutable(sub)\n        counts[key] = counts.get(key, 0) + 1\n    return counts"}
{"task_id": "Mbpp/759", "solution": "def is_decimal(s: str) -> bool:\n    \"\"\"Checks if a string is a decimal number with exactly two decimal places.\n    Raises TypeError if the input is not a string.\"\"\"\n    import re\n    DECIMAL_PATTERN = r'^[+-]?[0-9]+\\.[0-9]{2}$'\n\n    if not isinstance(s, str):\n        raise TypeError('s must be a str')\n    return bool(re.fullmatch(DECIMAL_PATTERN, s))"}
{"task_id": "Mbpp/764", "solution": "def number_ctr(s: str) -> int:\n    \"\"\"Counts the number of ASCII decimal digits ('0'-'9') in a string.\"\"\"\n    count = 0\n    for ch in s:\n        if '0' <= ch <= '9':\n            count += 1\n    return count"}
{"task_id": "Mbpp/763", "solution": "class ValidationError(Exception):\n    \"\"\"Custom exception for validation errors in find_min_diff.\"\"\"\n    pass\n\ndef find_min_diff(arr, n):\n    \"\"\"\n    Finds the minimum difference between any two elements in a given array.\n    Sorts the array and scans adjacent elements to find the minimum difference.\n    \"\"\"\n    # Validation checks\n    if arr is None:\n        raise ValidationError(\"arr is null\")\n\n    if n != len(arr):\n        raise ValidationError(\"n does not match len(arr)\")\n\n    if n < 2:\n        raise ValidationError(\"n must be >= 2\")\n\n    # Create a mutable copy of the input for sorting (handles tuples/other sequences)\n    arr_copy = list(arr)\n\n    # Determine if any element is a float to decide return type\n    contains_float = any(isinstance(x, float) for x in arr_copy)\n\n    # Sort the array in-place\n    arr_copy.sort()\n\n    # Initialize minimum difference\n    min_diff = float('inf')\n\n    # Scan adjacent elements for minimum absolute difference\n    for i in range(1, n):\n        diff = abs(arr_copy[i] - arr_copy[i - 1])\n        if diff == 0:\n            return 0  # early exit on duplicate\n        if diff < min_diff:\n            min_diff = diff\n\n    return min_diff if contains_float else int(min_diff)"}
{"task_id": "Mbpp/766", "solution": "def pair_wise(input_list: list) -> list:\n    \"\"\"\n    Returns a list of all pairs of consecutive items in the given list.\n    Handles edge cases like empty or single-element lists by returning an empty list.\n    Example:\n        pair_wise([1, 2, 3])  # returns [(1, 2), (2, 3)]\n    Time complexity: O(n)\n    Space complexity: O(n)\n    \"\"\"\n    if len(input_list) < 2:\n        return []\n\n    result_pairs = []\n    for i in range(len(input_list) - 1):\n        result_pairs.append((input_list[i], input_list[i + 1]))\n\n    return result_pairs"}
{"task_id": "Mbpp/767", "solution": "def get_pairs_count(numbers, sum):\n    \"\"\"\n    Counts pairs (i, j) with i < j such that numbers[i] + numbers[j] == sum.\n    Uses a single-pass frequency-map algorithm (average O(n) time, O(n) space).\n    \"\"\"\n    if not isinstance(numbers, (list, tuple)):\n        raise TypeError(\"Input 'numbers' must be a list or tuple.\")\n    if not isinstance(sum, int):\n        raise TypeError(\"Input 'sum' must be an integer.\")\n\n    for num in numbers:\n        if not isinstance(num, int):\n            raise TypeError(\"All elements in 'numbers' must be integers.\")\n\n    if len(numbers) < 2:\n        return 0\n\n    freq_map = {}\n    count = 0\n\n    for num in numbers:\n        complement = sum - num\n        count += freq_map.get(complement, 0)\n        freq_map[num] = freq_map.get(num, 0) + 1\n\n    return count"}
{"task_id": "Mbpp/765", "solution": "def nth_polite(n: int) -> int:\n    \"\"\"\n    Finds the n-th polite number. A polite number is a positive integer that is not an exact power of two.\n    n must be an integer >= 1.\n    \"\"\"\n    if not isinstance(n, int) or n < 1:\n        raise ValueError(\"n must be an integer >= 1\")\n\n    def is_polite(k: int) -> bool:\n        # k is polite if k > 0 and k is not a power of two\n        return k > 0 and (k & (k - 1)) != 0\n\n    polite_count = 0\n    current_number = 1\n\n    while True:\n        if is_polite(current_number):\n            polite_count += 1\n            if polite_count == n:\n                return current_number\n        current_number += 1"}
{"task_id": "Mbpp/772", "solution": "def remove_length(s: str, k: int) -> str:\n    \"\"\"Removes words of a specific length from a string, normalizing whitespace.\n\n    Tokens are contiguous non-whitespace sequences; punctuation counts towards length.\n    \"\"\"\n    if not isinstance(s, str) or not isinstance(k, int):\n        raise TypeError(\"s must be a string and k must be an integer.\")\n    if k < 0:\n        raise ValueError(\"k must be a non-negative integer.\")\n\n    tokens = s.split()\n    filtered_tokens = [token for token in tokens if len(token) != k]\n    return ' '.join(filtered_tokens)"}
{"task_id": "Mbpp/771", "solution": "def check_expression(expression):\n    \"\"\"\n    Checks if the given expression has balanced and properly nested brackets.\n    Non-bracket characters are ignored.\n    \"\"\"\n    stack = []\n    opening_to_closing = {\n        '(': ')',\n        '[': ']',\n        '{': '}'\n    }\n    closing_brackets = {')', ']', '}'}\n\n    for char in expression:\n        if char in opening_to_closing:\n            stack.append(char)\n        elif char in closing_brackets:\n            if not stack:\n                return False  # Unmatched closing bracket found\n\n            last_open = stack.pop()\n            if opening_to_closing[last_open] != char:\n                return False  # Mismatched opening and closing brackets\n        # Non-bracket characters are ignored.\n\n    return not stack  # True if stack is empty (all brackets matched), False otherwise"}
{"task_id": "Mbpp/770", "solution": "def odd_num_sum(n):\n    \"\"\"\n    Calculates the sum of the fourth power of the first n odd natural numbers using a closed-form formula.\n    Assumes n is a non-negative integer.\n    \"\"\"\n    numerator = 48 * n**5 - 40 * n**3 + 7 * n\n    return numerator // 15"}
{"task_id": "Mbpp/769", "solution": "def Diff(list_a, list_b):\n    \"\"\"\n    Returns a new list containing elements from list_a that are not present in list_b, preserving their original order.\n    Removes all occurrences of a value in list_a if that value exists in list_b.\n    Raises TypeError if either argument is not a list.\n    \"\"\"\n    if not isinstance(list_a, list) or not isinstance(list_b, list):\n        raise TypeError(\"list_a and list_b must be lists\")\n\n    if not list_a:\n        return []\n\n    # Determine if list_b elements are hashable to use a set for optimized lookup.\n    is_list_b_hashable = True\n    for item_b in list_b:\n        try:\n            hash(item_b)\n        except TypeError:\n            is_list_b_hashable = False\n            break\n\n    result = []\n    if is_list_b_hashable:\n        membership_set = set(list_b)\n        for item_a in list_a:\n            if item_a not in membership_set:\n                result.append(item_a)\n    else:\n        for item_a in list_a:\n            found = False\n            for item_b in list_b:\n                if item_a == item_b:\n                    found = True\n                    break\n            if not found:\n                result.append(item_a)\n\n    return result"}
{"task_id": "Mbpp/777", "solution": "def find_sum(lst: list) -> float:\n    \"\"\"\n    Calculates the sum of non-repeated (unique) elements in a list.\n\n    The function validates input types and returns the sum as a float.\n\n    Examples:\n    >>> find_sum([1,2,3,1,1,4,5,6]) == 21.0\n    True\n    >>> find_sum([1, 2, 3]) == 6.0\n    True\n    >>> find_sum([1, 1.0, 2.0]) == 3.0\n    True\n    >>> find_sum([]) == 0.0\n    True\n    >>> import pytest\n    >>> with pytest.raises(TypeError): find_sum(\"not a list\")\n    >>> with pytest.raises(TypeError): find_sum([1, \"a\"])\n    \"\"\"\n\n    def validate_input(lst_to_validate) -> None:\n        \"\"\"\n        Validates that the input is a list and contains only int or float elements.\n        Raises TypeError on invalid input.\n        \"\"\"\n        if not isinstance(lst_to_validate, list):\n            raise TypeError(\"lst must be of type list\")\n        for element in lst_to_validate:\n            if not isinstance(element, (int, float)):\n                raise TypeError(\"all elements of lst must be int or float\")\n\n    def extract_unique_values(lst_to_process) -> set:\n        \"\"\"\n        Extracts unique numeric values from the list into a set.\n        \"\"\"\n        return set(lst_to_process)\n\n    def compute_sum(unique_values_set: set) -> float:\n        \"\"\"\n        Computes the sum of unique numeric values, returning 0.0 for an empty set.\n        \"\"\"\n        return float(sum(unique_values_set))\n\n    validate_input(lst)\n    unique_values = extract_unique_values(lst)\n    return compute_sum(unique_values)"}
{"task_id": "Mbpp/775", "solution": "def odd_position(lst: list) -> bool:\n    \"\"\"Checks if every odd-indexed element in the list is an odd number.\n    Raises TypeError for non-list input or non-integer elements at odd indices.\"\"\"\n    if not isinstance(lst, list):\n        raise TypeError(\"Input must be a list.\")\n\n    for i in range(1, len(lst), 2):\n        value = lst[i]\n        if not isinstance(value, int):\n            raise TypeError(f\"Element at odd index {i} must be an integer, got {type(value).__name__}.\")\n        if value % 2 == 0:\n            return False\n    return True"}
{"task_id": "Mbpp/773", "solution": "from typing import Optional, Tuple\n\ndef occurance_substring(main_string: str, sub_string: str) -> Optional[Tuple[str, int, int]]:\n    \"\"\"Return (sub_string, start, end) for first occurrence, or None if not found.\n    Empty sub_string matches at ('', 0, 0).\n    \"\"\"\n    if not isinstance(main_string, str) or not isinstance(sub_string, str):\n        raise TypeError('main_string and sub_string must be str')\n\n    if sub_string == '':\n        return ('', 0, 0)\n\n    n = len(main_string)\n    m = len(sub_string)\n\n    if m > n:\n        return None\n\n    idx = main_string.find(sub_string)\n\n    if idx == -1:\n        return None\n    return (sub_string, idx, idx + m)"}
{"task_id": "Mbpp/778", "solution": "def pack_consecutive_duplicates(items: list) -> list:\n    \"\"\"Groups consecutive duplicate elements of a list into sublists, preserving order. Raises TypeError if the input is not a list.\"\"\"\n    if not isinstance(items, list):\n        raise TypeError(\"items must be a list\")\n\n    if not items:\n        return []\n\n    groups = []\n    current_group = [items[0]]\n\n    for x in items[1:]:\n        if x == current_group[-1]:\n            current_group.append(x)\n        else:\n            groups.append(current_group)\n            current_group = [x]\n\n    groups.append(current_group)\n    return groups"}
{"task_id": "Mbpp/781", "solution": "import math\n\ndef count_divisors(n: int) -> bool:\n    \"\"\"Return True if the number of positive integer divisors of n is even, otherwise False.\n\n    Raises:\n      TypeError: if n is not of type int\n      ValueError: if n < 1\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"count_divisors: input must be an int\")\n    if n < 1:\n        raise ValueError(\"count_divisors: input must be >= 1\")\n\n    def _is_perfect_square(val: int) -> bool:\n        \"\"\"Return True if val is a perfect square using math.isqrt.\"\"\"\n        r = math.isqrt(val)\n        return r * r == val\n\n    # Perfect squares have an odd number of divisors; non-perfect squares have an even number.\n    return not _is_perfect_square(n)"}
{"task_id": "Mbpp/782", "solution": "def odd_length_sum(nums: list) -> int:\n    \"\"\"\n    Calculates the sum of all elements across all contiguous subarrays of odd length.\n    Uses an O(n) combinatorial approach by counting each element's contribution.\n    \"\"\"\n\n    def validate_input(nums_list):\n        \"\"\"Validates that the input is a list of integers.\"\"\"\n        if not isinstance(nums_list, list):\n            raise TypeError(\"Input must be a list.\")\n        for x in nums_list:\n            if not isinstance(x, int):\n                raise TypeError(\"All elements in the list must be integers.\")\n\n    def compute_contributions(nums_list):\n        \"\"\"Computes the sum using a combinatorial counting algorithm.\"\"\"\n        n = len(nums_list)\n        total_sum = 0\n        for i in range(n):\n            # total subarrays that include nums_list[i]\n            count_total_subarrays_with_element = (i + 1) * (n - i)\n            # odd-length subarrays containing nums_list[i]\n            count_odd_length_subarrays_with_element = (count_total_subarrays_with_element + 1) // 2\n            total_sum += nums_list[i] * count_odd_length_subarrays_with_element\n        return total_sum\n\n    validate_input(nums)\n\n    if not nums:\n        return 0\n\n    return compute_contributions(nums)"}
{"task_id": "Mbpp/784", "solution": "def mul_even_odd(lst):\n    \"\"\"Finds the product of the first even and odd number in a list.\n    Returns the product or None if either number type is not found.\"\"\"\n    first_odd = None\n    first_even = None\n\n    for x in lst:\n        if first_even is None and x % 2 == 0:\n            first_even = x\n        elif first_odd is None and x % 2 != 0:\n            first_odd = x\n\n        if first_even is not None and first_odd is not None:\n            break\n\n    if first_even is not None and first_odd is not None:\n        return first_even * first_odd\n    else:\n        return None"}
{"task_id": "Mbpp/780", "solution": "class _TupleList:\n    \"\"\"A wrapper for the input list or tuple to provide controlled access.\"\"\"\n    def __init__(self, data):\n        self._data = data\n\n    def length(self):\n        \"\"\"Returns the number of elements in the wrapped data.\"\"\"\n        return len(self._data)\n\n    def get(self, index):\n        \"\"\"Retrieves an element by its index.\"\"\"\n        return self._data[index]\n\nclass _InputTuple:\n    \"\"\"A domain object representing a 2-element numeric input tuple.\"\"\"\n    def __init__(self, tpl):\n        self.a = tpl[0]\n        self.b = tpl[1]\n\nclass _Combination:\n    \"\"\"A data container for the sum of two 2-element tuples.\"\"\"\n    def __init__(self, sum_a, sum_b):\n        self.sum_a = sum_a\n        self.sum_b = sum_b\n\nclass _ResultList:\n    \"\"\"Collects _Combination objects and provides a method to convert them to a list of tuples.\"\"\"\n    def __init__(self):\n        self._combinations = []\n\n    def append(self, comb: _Combination):\n        \"\"\"Adds a computed combination to the internal list.\"\"\"\n        self._combinations.append(comb)\n\n    def to_list(self):\n        \"\"\"Converts the collected combinations into a list of 2-element tuples.\"\"\"\n        return [(c.sum_a, c.sum_b) for c in self._combinations]\n\ndef _validate_container(obj):\n    \"\"\"Validates that the input object is a list or tuple.\"\"\"\n    if not isinstance(obj, (list, tuple)):\n        raise TypeError(\"tuple_list must be a list or tuple\")\n\ndef _validate_elements(obj):\n    \"\"\"Validates each element in the container to be a 2-element numeric tuple.\"\"\"\n    for idx, elem in enumerate(obj):\n        if not isinstance(elem, tuple):\n            raise TypeError(f\"Element at index {idx} must be a tuple, got {type(elem).__name__}\")\n        if len(elem) != 2:\n            raise TypeError(f\"Element at index {idx} must be a 2-element tuple, got {len(elem)} elements\")\n        if not (isinstance(elem[0], (int, float)) and isinstance(elem[1], (int, float))):\n            raise TypeError(f\"Elements inside tuple at index {idx} must be numbers (int or float)\")\n\ndef _combine(t1: _InputTuple, t2: _InputTuple) -> _Combination:\n    \"\"\"Performs element-wise sum of two InputTuple objects.\"\"\"\n    return _Combination(t1.a + t2.a, t1.b + t2.b)\n\ndef _generate_all(tuple_list_wrapper: _TupleList) -> list:\n    \"\"\"Generates all unique unordered pairwise sums from the wrapped tuple list.\"\"\"\n    result_list = _ResultList()\n    n = tuple_list_wrapper.length()\n    for i in range(n):\n        for j in range(i + 1, n):\n            t1_raw = tuple_list_wrapper.get(i)\n            t2_raw = tuple_list_wrapper.get(j)\n            input_t1 = _InputTuple(t1_raw)\n            input_t2 = _InputTuple(t2_raw)\n            combination = _combine(input_t1, input_t2)\n            result_list.append(combination)\n    return result_list.to_list()\n\ndef find_combinations(tuple_list):\n    \"\"\"\n    Finds combinations of sums with tuples in the given tuple list.\n    It computes tuple-wise sums for every unique unordered pair of input tuples.\n    \"\"\"\n    _validate_container(tuple_list)\n    _validate_elements(tuple_list)\n\n    tuple_list_wrapper = _TupleList(tuple_list)\n\n    if tuple_list_wrapper.length() < 2:\n        return []\n\n    return _generate_all(tuple_list_wrapper)"}
{"task_id": "Mbpp/787", "solution": "import re\n\nCOMPILED_PATTERN = re.compile(r'^ab{3}$')\n\ndef text_match_three(text) -> bool:\n    \"\"\"Matches a string that has an 'a' followed by exactly three 'b's.\"\"\"\n    if not isinstance(text, str):\n        raise TypeError(\"text must be an instance of str\")\n    return COMPILED_PATTERN.fullmatch(text) is not None"}
{"task_id": "Mbpp/788", "solution": "def new_tuple(items: List[str], s: str) -> Tuple[str, ...]:\n    \"\"\"Return a tuple containing the elements of `items` in order followed by `s`.\n    For example, new_tuple(['WEB', 'is'], 'best') -> ('WEB', 'is', 'best').\n    \"\"\"\n    return tuple(items) + (s,)"}
{"task_id": "Mbpp/785", "solution": "def _validate_type(s) -> None:\n    \"\"\"Ensures s is a str; raises TypeError if not.\"\"\"\n    if not isinstance(s, str):\n        type_name = type(s).__name__\n        raise TypeError(f\"tuple_str_int expects a str, got {type_name}\")\n\ndef _normalize(s: str) -> str:\n    \"\"\"Trims surrounding whitespace from the input string.\"\"\"\n    return s.strip()\n\ndef _tokenize(s: str) -> list[str]:\n    \"\"\"\n    Extracts, splits, and strips inner tokens from a parenthesized string.\n    Handles empty tuples and trailing commas correctly by filtering the last empty token if applicable.\n    \"\"\"\n    inner = s[1:-1]\n\n    if not inner.strip():\n        return []\n\n    raw_tokens_with_ws = inner.split(',')\n    stripped_tokens = [t.strip() for t in raw_tokens_with_ws]\n\n    # Handle trailing comma: if the last stripped token is empty and it's not the only token,\n    # it means it resulted from a trailing comma (e.g., \"(5,)\" produces ['5', '']), so remove it.\n    # This ensures \"(,)\" produces `['']` (or `['','']` before this pop) and `(1,,2)` produces `['1', '', '2']`.\n    if stripped_tokens and stripped_tokens[-1] == '' and len(stripped_tokens) > 1:\n        stripped_tokens.pop()\n\n    return stripped_tokens\n\ndef _convert_tokens(tokens: list[str]) -> tuple[int]:\n    \"\"\"Converts a list of string tokens into a tuple of integers, validating each token.\"\"\"\n    converted_values = []\n    for i, token in enumerate(tokens):\n        pos = i + 1\n        if token == '':\n            raise ValueError(f\"invalid empty token at position {pos}\")\n        try:\n            value = int(token)\n            converted_values.append(value)\n        except ValueError:\n            raise ValueError(f\"invalid integer token '{token}' at position {pos}\")\n    return tuple(converted_values)\n\ndef tuple_str_int(s: str) -> tuple[int]:\n    \"\"\"\n    Converts a string representation of an integer tuple (e.g., \"(7, 8, 9)\") into an actual tuple of integers.\n    It handles various formats and whitespace, raising TypeError for non-string input and ValueError for malformed tuple strings.\n    \"\"\"\n    _validate_type(s)\n    trimmed_s = _normalize(s)\n\n    if len(trimmed_s) < 2 or not (trimmed_s.startswith('(') and trimmed_s.endswith(')')):\n        raise ValueError(\"missing parentheses\")\n\n    token_strings = _tokenize(trimmed_s)\n    int_tuple = _convert_tokens(token_strings)\n\n    return int_tuple"}
{"task_id": "Mbpp/786", "solution": "def right_insertion(a, x):\n    \"\"\"\n    Finds the right insertion point for x in a sorted sequence a using iterative binary search.\n    This function implements bisect_right semantics, inserting to the right of existing equal elements.\n    \"\"\"\n    lo = 0\n    hi = len(a)\n\n    while lo < hi:\n        mid = (lo + hi) // 2\n        if a[mid] <= x:\n            lo = mid + 1\n        else:\n            hi = mid\n    return lo"}
{"task_id": "Mbpp/791", "solution": "def remove_nested(input_tuple):\n    \"\"\"remove_nested(input_tuple)\n    Return a new tuple containing only the non-tuple elements of input_tuple.\n\n    Parameters:\n        input_tuple (tuple): The tuple to filter.\n\n    Returns:\n        tuple: A tuple containing elements from input_tuple for which isinstance(element, tuple) is False.\n\n    Raises:\n        TypeError: If input_tuple is not a tuple. Message: \"remove_nested: argument must be a tuple; got <type_name>\".\n    \"\"\"\n    if not isinstance(input_tuple, tuple):\n        raise TypeError(f\"remove_nested: argument must be a tuple; got {type(input_tuple).__name__}\")\n    retained = []\n    for element in input_tuple:\n        if not isinstance(element, tuple):\n            retained.append(element)\n    return tuple(retained)"}
{"task_id": "Mbpp/790", "solution": "def even_position(arr: list) -> bool:\n    \"\"\"Check if every even index contains an even number.\n    Raise TypeError if input is not a list or contains non-integer elements.\"\"\"\n\n    class Validator:\n        @staticmethod\n        def validate_list(arr_input):\n            if not isinstance(arr_input, list):\n                raise TypeError(\"arr must be a list\")\n\n        @staticmethod\n        def validate_elements(arr_input):\n            for element in arr_input:\n                if not isinstance(element, int):\n                    raise TypeError(\"all elements must be int\")\n\n    class Checker:\n        @staticmethod\n        def check_even_indices(arr_input) -> bool:\n            for i in range(0, len(arr_input), 2):\n                if arr_input[i] % 2 != 0:\n                    return False\n            return True\n\n    Validator.validate_list(arr)\n    Validator.validate_elements(arr)\n    return Checker.check_even_indices(arr)"}
{"task_id": "Mbpp/792", "solution": "def count_list(collection) -> int:\n    \"\"\"Count the number of top-level elements in `collection` that are instances of built-in list.\n\n    Args:\n        collection: an iterable of top-level elements. If not iterable, raises TypeError(\"collection is not iterable\").\n\n    Returns:\n        int: number of top-level list instances (including list subclasses) found in collection.\n    \"\"\"\n    try:\n        _ = iter(collection)\n    except TypeError:\n        raise TypeError(\"collection is not iterable\")\n\n    count = 0\n    for element in collection:\n        if isinstance(element, list):\n            count += 1\n    return count"}
{"task_id": "Mbpp/794", "solution": "def text_starta_endb(text: str) -> bool:\n    \"\"\"\n    Checks if a string starts with 'a' and ends with 'b', with any characters in between.\n    Raises TypeError if the input is not a string.\n    \"\"\"\n    if not isinstance(text, str):\n        raise TypeError(\"text must be a string\")\n    if len(text) < 2:\n        return False\n    return text[0] == 'a' and text[-1] == 'b'"}
{"task_id": "Mbpp/793", "solution": "def last(array, target):\n    \"\"\"\n    Finds the last (rightmost) position of an element in a sorted array.\n    Returns the zero-based index or -1 if the target is not found.\n    \"\"\"\n    n = len(array)\n    if n == 0:\n        return -1\n\n    left, right = 0, n - 1\n    candidate = -1\n\n    while left <= right:\n        mid = (left + right) // 2\n        if array[mid] == target:\n            candidate = mid\n            left = mid + 1  # Search in the right half for a later occurrence\n        elif array[mid] < target:\n            left = mid + 1\n        else:  # array[mid] > target\n            right = mid - 1\n\n    return candidate"}
{"task_id": "Mbpp/798", "solution": "def _sum(iterable):\n    \"\"\"\n    Calculates the sum of numeric elements in an iterable, ignoring non-numeric items.\n    Raises TypeError if the input is not iterable.\n    \"\"\"\n    try:\n        iterator = iter(iterable)\n    except TypeError:\n        raise TypeError(\"_sum() expects an iterable argument\")\n\n    total = 0\n    for element in iterator:\n        if isinstance(element, (int, float)):\n            total += element\n    return total"}
{"task_id": "Mbpp/796", "solution": "def return_sum(data: dict) -> __import__(\"numbers\").Real:\n    \"\"\"Public API function. Validates input and returns numeric sum.\n\n    This function calculates the sum of all numeric values in the given dictionary.\n    It performs type validation on both the dictionary itself and its values.\n\n    Parameters:\n    - data (dict): Input dictionary whose values are summed.\n\n    Returns:\n    - numbers.Real: Numeric sum of values; returns 0 for empty dict.\n\n    Raises:\n    - TypeError: if data is not a dict.\n    - TypeError: if any value is not an instance of numbers.Real; message identifies first offending key/value.\n    \"\"\"\n    from typing import Any\n    import numbers\n\n    def _validate_dict(data: Any) -> None:\n        \"\"\"Raise TypeError if data is not a dict. Message: \"return_sum: expected dict, got <type>\\\".\"\"\"\n        if not isinstance(data, dict):\n            raise TypeError(f\"return_sum: expected dict, got {type(data)}\")\n\n    def _validate_value(key: Any, value: Any) -> None:\n        \"\"\"Raise TypeError if value is not an instance of numbers.Real.\n        Message: \"return_sum: non-numeric value at key <key!r>: <value!r>\".\n        \"\"\"\n        if not isinstance(value, numbers.Real):\n            raise TypeError(f\"return_sum: non-numeric value at key {key!r}: {value!r}\")\n\n    _validate_dict(data)\n\n    if not data:  # Equivalent to len(data) == 0\n        return 0\n\n    accumulator = 0\n    for key, value in data.items():\n        _validate_value(key, value)\n        accumulator += value\n    return accumulator"}
{"task_id": "Mbpp/797", "solution": "def sum_in_range(l, r):\n    \"\"\"\n    Calculates the sum of all odd natural numbers within the inclusive range [l, r].\n    Natural numbers are defined as integers >= 1.\n    \"\"\"\n    effective_l = max(l, 1)\n    effective_r = r\n\n    # If the effective range is empty, return 0.\n    if effective_l > effective_r:\n        return 0\n\n    # Determine the first odd number in the effective range.\n    first_odd = effective_l\n    if first_odd % 2 == 0:\n        first_odd += 1\n\n    # Determine the last odd number in the effective range.\n    last_odd = effective_r\n    if last_odd % 2 == 0:\n        last_odd -= 1\n\n    # If there are no odd numbers in the effective range (e.g., [2,2]), return 0.\n    if first_odd > last_odd:\n        return 0\n\n    # Calculate the number of odd terms.\n    n_terms = ((last_odd - first_odd) // 2) + 1\n\n    # Calculate the sum using the arithmetic series formula: n * (first + last) / 2.\n    # Since first_odd and last_odd are both odd, their sum is always even,\n    # ensuring (first_odd + last_odd) // 2 is an integer.\n    total_sum = n_terms * ((first_odd + last_odd) // 2)\n\n    return total_sum"}
{"task_id": "Mbpp/799", "solution": "def left_rotate(n: int, d: int) -> int:\n    \"\"\"\n    Rotates left bits by d bits for a 32-bit number.\n    Assumes the number is 32-bit unsigned.\n    \"\"\"\n    BITS = 32\n    MASK = 0xFFFFFFFF\n\n    # Enforce unsigned 32-bit input by masking.\n    n_masked = n & MASK\n\n    # Normalize rotation count into the range 0 to 31.\n    d_mod = d % BITS\n\n    # If rotation count is 0, return the masked number unchanged.\n    if d_mod == 0:\n        return n_masked\n\n    # Compute rotation: combine bits shifted left and bits wrapped around from the right.\n    # The final mask ensures the result remains within 32 bits.\n    rotated = ((n_masked << d_mod) | (n_masked >> (BITS - d_mod))) & MASK\n    return rotated"}
{"task_id": "Mbpp/801", "solution": "def test_three_equal(a: int, b: int, c: int) -> int:\n    \"\"\"Counts the number of equal integers among three given inputs.\"\"\"\n    eq_ab = (a == b)\n    eq_bc = (b == c)\n    eq_ac = (a == c)  # This is needed for the \"exactly two\" case when a == c but b is different.\n\n    if eq_ab and eq_bc:\n        return 3\n    if eq_ab or eq_bc or eq_ac:\n        return 2\n    return 0"}
{"task_id": "Mbpp/800", "solution": "def remove_all_spaces(input):\n    \"\"\"\n    Removes all whitespace characters, including Unicode whitespace, from the input string.\n    Non-whitespace characters retain their original order.\n    \"\"\"\n    result_chars = []\n    for char in input:\n        if not char.isspace():\n            result_chars.append(char)\n    return \"\".join(result_chars)"}
{"task_id": "Mbpp/803", "solution": "def is_perfect_square(n):\n    \"\"\"\n    Checks if a given number is a perfect square using binary search.\n    Handles non-negative integers correctly.\n    \"\"\"\n    if not isinstance(n, int):\n        # Reject non-integers (policy choice). If you want to accept integer-valued floats,\n        # change this to: if isinstance(n, float) and n.is_integer(): n = int(n)\n        return False\n\n    if n < 0:\n        return False\n    if n == 0 or n == 1:\n        return True\n\n    low = 1\n    high = n // 2\n\n    while low <= high:\n        mid = (low + high) // 2\n        square = mid * mid\n\n        if square == n:\n            return True\n        elif square < n:\n            low = mid + 1\n        else:\n            high = mid - 1\n\n    return False"}
{"task_id": "Mbpp/806", "solution": "def max_run_uppercase(s: str) -> int:\n    \"\"\"\n    Finds the maximum run of ASCII uppercase characters ('A'-'Z') in the given string.\n    Non-uppercase characters break a run.\n    \"\"\"\n    if not s:\n        return 0\n\n    max_run = 0\n    current_run = 0\n\n    for char in s:\n        if 'A' <= char <= 'Z':\n            current_run += 1\n            if current_run > max_run:\n                max_run = current_run\n        else:\n            current_run = 0\n\n    return max_run"}
{"task_id": "Mbpp/804", "solution": "class NumberValue:\n    def __init__(self, value):\n        self.value = value\n\n    def is_zero(self):\n        return self.value == 0\n\n    def is_integer_like(self):\n        return isinstance(self.value, int) or \\\n               (isinstance(self.value, float) and self.value == int(self.value))\n\n    def is_even(self):\n        # Assumes the value is integer-like\n        return int(self.value) % 2 == 0\n\nclass Validator:\n    def validate_element(self, element):\n        if not isinstance(element, (int, float)):\n            raise TypeError(f\"List element must be an int or float, got {type(element).__name__}\")\n        if isinstance(element, float) and element != int(element):\n            raise ValueError(f\"Float element must be an exact integer, got {element}\")\n\nclass Scanner:\n    def scan(self, numbers_list, validator_instance):\n        for element in numbers_list:\n            validator_instance.validate_element(element)\n            nv = NumberValue(element)\n            if nv.is_zero():\n                return True\n            if nv.is_integer_like() and nv.is_even():\n                return True\n        return False\n\nclass ProductParityService:\n    def is_product_even(self, numbers):\n        if not numbers:\n            return False\n        validator = Validator()\n        scanner = Scanner()\n        return scanner.scan(numbers, validator)\n\ndef is_product_even(numbers):\n    \"\"\"\n    Checks if the product of numbers in a list is even, returning True if any element is zero or an even integer (including exact-integer floats).\n    Raises TypeError for non-numeric elements or ValueError for non-integer floats, returning False for an empty list.\n    \"\"\"\n    return ProductParityService().is_product_even(numbers)"}
{"task_id": "Mbpp/807", "solution": "def first_odd(list_of_numbers):\n    \"\"\"Return the first odd element from list_of_numbers.\n    It iterates the input sequence and returns the first element where (e % 2 != 0).\n    \"\"\"\n    for number in list_of_numbers:\n        if number % 2 != 0:\n            return number"}
{"task_id": "Mbpp/805", "solution": "def max_sum_list(lists):\n    # Validate outer list\n    if not isinstance(lists, list):\n        raise ValueError(\"lists must be a list\")\n    if len(lists) == 0:\n        raise ValueError(\"lists must not be empty\")\n\n    best_sum = None\n    best_list = None\n\n    for inner in lists:\n        if not isinstance(inner, list):\n            raise TypeError(\"each element of outer list must be a list\")\n\n        s = 0\n        for elem in inner:\n            if not isinstance(elem, (int, float)):\n                raise TypeError(\"inner elements must be int or float\")\n            s += elem\n\n        if best_sum is None or s > best_sum:\n            best_sum = s\n            best_list = inner\n\n    return best_list"}
{"task_id": "Mbpp/809", "solution": "def check_smaller(a: tuple, b: tuple) -> bool:\n    \"\"\"\n    check_smaller(a, b) -> bool\n\n    Return True iff for every index i, b[i] < a[i].\n\n    Parameters:\n      - a (tuple): first tuple (must be instance of tuple)\n      - b (tuple): second tuple (must be instance of tuple)\n\n    Returns:\n      - bool: True if every b[i] < a[i], False otherwise.\n\n    Raises:\n      - TypeError: if a or b is not an instance of tuple, or if any element-wise '<' comparison raises TypeError for incomparable elements.\n      - ValueError: if len(a) != len(b).\n\n    Notes:\n      - Uses Python's native '<' semantics (behavior for NaN and custom objects follows Python semantics).\n      - Function is pure, performs no I/O and does not mutate inputs.\n    \"\"\"\n    def validate_types(a, b) -> None:\n        \"\"\"Ensures both inputs are strict instances of tuple.\"\"\"\n        if not isinstance(a, tuple):\n            raise TypeError(\"Input 'a' must be an instance of tuple.\")\n        if not isinstance(b, tuple):\n            raise TypeError(\"Input 'b' must be an instance of tuple.\")\n\n    def validate_lengths(a, b) -> None:\n        \"\"\"Ensures tuples have equal length.\"\"\"\n        if len(a) != len(b):\n            raise ValueError(f\"Tuples must have equal length, but got len(a)={len(a)} and len(b)={len(b)}.\")\n\n    def compare_elements(a: tuple, b: tuple) -> bool:\n        \"\"\"Compares elements such that b[i] < a[i] for all i.\"\"\"\n        for i in range(len(a)):\n            if not (b[i] < a[i]):\n                return False\n        return True\n\n    validate_types(a, b)\n    validate_lengths(a, b)\n    return compare_elements(a, b)"}
{"task_id": "Mbpp/808", "solution": "def check_K(tup: tuple, k: int) -> bool:\n    \"\"\"Checks if the integer k is present in the given tuple tup. Time complexity is O(n) in the worst case, and space complexity is O(1).\"\"\"\n    return k in tup"}
