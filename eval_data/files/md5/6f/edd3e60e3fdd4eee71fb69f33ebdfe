{"task_id": "Mbpp/109", "solution": "def odd_Equivalent(s: str, n: int) -> int:\n    \"\"\"\n    Counts the number of rotations among the first n rotations of a binary string s\n    that result in an odd binary number (least-significant bit is '1').\n    \"\"\"\n    # Validate inputs\n    if not isinstance(s, str):\n        raise ValueError(\"s must be a string of '0' and '1'\")\n    if len(s) == 0:\n        raise ValueError(\"s must be non-empty\")\n    if any(c not in '01' for c in s):\n        raise ValueError(\"s must contain only '0' and '1'\")\n    if not isinstance(n, int):\n        raise ValueError(\"n must be an integer\")\n    if n < 0:\n        raise ValueError(\"n must be non-negative\")\n\n    if n == 0:\n        return 0\n\n    L = len(s)\n    full_cycles = n // L\n    remainder = n % L\n    total_odd_rotations = 0\n\n    for i in range(L):\n        if s[i] == '1':\n            # Rotation index in [0..L-1] when s[i] becomes LSB is (L-1-i)\n            k_first_occurrence = L - 1 - i\n            contribution_for_one = full_cycles\n            if k_first_occurrence < remainder:\n                contribution_for_one += 1\n            total_odd_rotations += contribution_for_one\n\n    return total_odd_rotations"}
{"task_id": "Mbpp/116", "solution": "def tuple_to_int(t: tuple[int]) -> int:\n    \"\"\"Convert a tuple of non-negative integers into a single integer by concatenating their decimal representations.\n\n    Args:\n        t: A non-empty tuple of integers (each >= 0).\n\n    Returns:\n        The integer formed by concatenating the decimal representations of the tuple elements.\n\n    Raises:\n        ValueError: If t is not a tuple, is empty, contains non-integers, or contains negative integers.\n\n    Complexity:\n        Time O(n * k), Memory O(n * k) where n is number of elements and k is average digits per element.\n\n    Examples:\n        tuple_to_int((1, 2, 3)) -> 123\n        tuple_to_int((12, 3))   -> 123\n        tuple_to_int((0, 1))    -> 1\n        tuple_to_int((10, 0, 5))-> 1005\n    \"\"\"\n    if not isinstance(t, tuple):\n        raise ValueError(\"Input must be a tuple.\")\n    if len(t) == 0:\n        raise ValueError(\"Input tuple must not be empty.\")\n\n    for e in t:\n        if not isinstance(e, int):\n            raise ValueError(\"All elements in the tuple must be integers.\")\n        if e < 0:\n            raise ValueError(\"All elements in the tuple must be non-negative.\")\n\n    # Convert elements to strings and join them\n    joined_str = \"\".join(map(str, t))\n\n    # Convert the joined string to an integer\n    result = int(joined_str)\n\n    return result"}
{"task_id": "Mbpp/120", "solution": "def max_product_tuple(pairs):\n    \"\"\"\n    Finds the maximum absolute product between numbers in pairs of tuples within a given list.\n    Handles validation, numeric types, and returns an int or float based on input types.\n    \"\"\"\n    if not pairs:\n        raise ValueError(\"input list is empty\")\n\n    current_max_abs_product = None\n    all_elements_were_int = True\n\n    for idx, item in enumerate(pairs):\n        if not isinstance(item, tuple) or len(item) != 2:\n            raise TypeError(f\"item at index {idx} is not a 2-element tuple: {item}\")\n\n        a, b = item\n\n        if not isinstance(a, (int, float)):\n            raise TypeError(f\"non-numeric element at tuple index {idx}: {a}\")\n        if not isinstance(b, (int, float)):\n            raise TypeError(f\"non-numeric element at tuple index {idx}: {b}\")\n\n        if not (isinstance(a, int) and isinstance(b, int)):\n            all_elements_were_int = False\n\n        product = a * b\n        abs_product = abs(product)\n\n        if current_max_abs_product is None or abs_product > current_max_abs_product:\n            current_max_abs_product = abs_product\n\n    if all_elements_were_int and current_max_abs_product == int(current_max_abs_product):\n        return int(current_max_abs_product)\n    else:\n        return float(current_max_abs_product)"}
{"task_id": "Mbpp/111", "solution": "import collections\nfrom typing import List, Any, Iterable, Sequence\n\ndef common_in_nested_lists(nested_lists: Iterable[Iterable[Any]], *, mode: str = 'set', preserve_order: bool = False, reference_index: int = 0) -> List[Any]:\n    \"\"\"Finds common elements in nested lists using specified mode and optional order preservation.\"\"\"\n\n    # Normalize input: Convert all iterables to lists. Python's native TypeErrors will occur for invalid top-level or nested types.\n    normalized_lists: List[List[Any]] = [list(sublist_item) for sublist_item in nested_lists]\n\n    # Handle early return for empty lists or lists containing empty sublists.\n    if not normalized_lists or any(not sublist for sublist in normalized_lists):\n        return []\n\n    def _detect_hashable(sequence: Sequence[Any]) -> bool:\n        \"\"\"Determines if elements in a sequence are hashable by sampling a few.\"\"\"\n        if not sequence:\n            return True\n        for item in sequence[:5]: # Sample up to 5 elements\n            try:\n                hash(item)\n            except TypeError:\n                return False\n        return True\n\n    # Determine if elements are hashable based on the first sublist.\n    is_hashable = _detect_hashable(normalized_lists[0])\n\n    result_elements: List[Any]\n\n    if is_hashable:\n        if mode == 'set':\n            intersection_set = set(normalized_lists[0])\n            for sublist in normalized_lists[1:]:\n                intersection_set.intersection_update(sublist)\n            result_elements = list(intersection_set)\n\n        elif mode == 'multiset':\n            counters = [collections.Counter(sublist) for sublist in normalized_lists]\n            result_counts = counters[0].copy()\n            for other_counter in counters[1:]:\n                for item in list(result_counts.keys()):\n                    if item in other_counter:\n                        result_counts[item] = min(result_counts[item], other_counter[item])\n                    else:\n                        del result_counts[item]\n\n            temp_result = []\n            for item, count in result_counts.items():\n                temp_result.extend([item] * count)\n            result_elements = temp_result\n\n        else:\n            raise ValueError(f\"Invalid mode: '{mode}'. Expected 'set' or 'multiset'.\")\n    else: # Non-hashable fallback path\n        if mode == 'set':\n            common_elements_set_semantics = []\n            processed_candidates_from_ref = []\n\n            for item_ref in normalized_lists[0]:\n                is_already_processed = False\n                for processed_item in processed_candidates_from_ref:\n                    if item_ref == processed_item:\n                        is_already_processed = True\n                        break\n                if is_already_processed:\n                    continue\n\n                is_common_across_all = True\n                for other_list in normalized_lists[1:]:\n                    found_in_other_list = False\n                    for item_other in other_list:\n                        if item_ref == item_other:\n                            found_in_other_list = True\n                            break\n                    if not found_in_other_list:\n                        is_common_across_all = False\n                        break\n\n                if is_common_across_all:\n                    common_elements_set_semantics.append(item_ref)\n                processed_candidates_from_ref.append(item_ref)\n\n            result_elements = common_elements_set_semantics\n\n        elif mode == 'multiset':\n            all_list_counts: List[List[List[Any]]] = []\n            for sublist in normalized_lists:\n                current_list_counts: List[List[Any]] = []\n                for item in sublist:\n                    found = False\n                    for entry in current_list_counts:\n                        if entry[0] == item:\n                            entry[1] += 1\n                            found = True\n                            break\n                    if not found:\n                        current_list_counts.append([item, 1])\n                all_list_counts.append(current_list_counts)\n\n            common_multiset_elements = []\n            reference_list_counts = all_list_counts[0]\n\n            for ref_item, ref_count in reference_list_counts:\n                min_count_for_item = ref_count\n\n                for other_list_counts in all_list_counts[1:]:\n                    current_list_item_count = 0\n                    for other_item, other_count in other_list_counts:\n                        if ref_item == other_item:\n                            current_list_item_count = other_count\n                            break\n                    min_count_for_item = min(min_count_for_item, current_list_item_count)\n                    if min_count_for_item == 0:\n                        break\n\n                common_multiset_elements.extend([ref_item] * min_count_for_item)\n            result_elements = common_multiset_elements\n        else:\n            raise ValueError(f\"Invalid mode: '{mode}'. Expected 'set' or 'multiset'.\")\n\n    # Apply order preservation if requested.\n    if preserve_order:\n        if not (0 <= reference_index < len(normalized_lists)):\n            raise ValueError(f\"reference_index {reference_index} is out of bounds for {len(normalized_lists)} sublists.\")\n\n        reference_list = normalized_lists[reference_index]\n        ordered_result = []\n\n        if mode == 'set':\n            elements_to_order = []\n            seen_in_result = []\n            for item in result_elements:\n                found = False\n                for seen_item in seen_in_result:\n                    if item == seen_item:\n                        found = True\n                        break\n                if not found:\n                    elements_to_order.append(item)\n                    seen_in_result.append(item)\n\n            for item in reference_list:\n                found_entry_index = -1\n                for i, common_item in enumerate(elements_to_order):\n                    if item == common_item:\n                        found_entry_index = i\n                        break\n\n                if found_entry_index != -1:\n                    ordered_result.append(item)\n                    elements_to_order.pop(found_entry_index)\n                if not elements_to_order and len(result_elements) > 0:\n                    break\n\n            result_elements = ordered_result\n\n        elif mode == 'multiset':\n            elements_to_order_counts: List[List[Any]] = []\n            for item in result_elements:\n                found = False\n                for entry in elements_to_order_counts:\n                    if entry[0] == item:\n                        entry[1] += 1\n                        found = True\n                        break\n                if not found:\n                    elements_to_order_counts.append([item, 1])\n\n            for item in reference_list:\n                found_entry_index = -1\n                for i, entry in enumerate(elements_to_order_counts):\n                    if entry[0] == item:\n                        found_entry_index = i\n                        break\n\n                if found_entry_index != -1 and elements_to_order_counts[found_entry_index][1] > 0:\n                    ordered_result.append(item)\n                    elements_to_order_counts[found_entry_index][1] -= 1\n            result_elements = ordered_result\n\n    return result_elements"}
{"task_id": "Mbpp/119", "solution": "def search(nums: list) -> int:\n    \"\"\"\n    Finds the element that appears only once in a sorted array where every other element appears exactly twice.\n    Uses an iterative binary search with an index-parity trick.\n    \"\"\"\n    if not isinstance(nums, list):\n        raise TypeError(\"nums must be a list of integers\")\n    if len(nums) == 0:\n        raise ValueError(\"nums must be non-empty\")\n    for x in nums:\n        if not isinstance(x, int):\n            raise TypeError(\"all elements of nums must be int\")\n\n    if len(nums) == 1:\n        return nums[0]\n\n    left = 0\n    right = len(nums) - 1\n\n    while left < right:\n        mid = (left + right) // 2\n\n        # Ensure 'mid' is at an even index for comparison (parity trick)\n        if mid % 2 == 1:\n            mid -= 1\n\n        # If elements at 'mid' and 'mid+1' are a pair, the single element is to the right\n        if nums[mid] == nums[mid + 1]:\n            left = mid + 2\n        # Otherwise, the single element is at 'mid' or to its left\n        else:\n            right = mid\n\n    # After the loop, 'left' (which equals 'right') will point to the unique element\n    return nums[left]"}
{"task_id": "Mbpp/124", "solution": "import math\nfrom dataclasses import dataclass\n\n@dataclass\nclass ComplexNumber:\n    real: float\n    imag: float\n\ndef _parse_input(a, b) -> ComplexNumber:\n    \"\"\"Parses input arguments into a ComplexNumber(real, imag) tuple, handling various formats.\"\"\"\n    real: float\n    imag: float\n\n    if b is None:\n        if isinstance(a, complex):\n            real = a.real\n            imag = a.imag\n        elif isinstance(a, (int, float)):\n            real = float(a)\n            imag = 0.0\n        else:\n            raise TypeError(\"angle_complex: single argument must be int, float, or complex\")\n    else:\n        if isinstance(a, complex):\n            real = a.real\n            imag = a.imag\n        elif isinstance(b, complex):\n            real = b.real\n            imag = b.imag\n        elif isinstance(a, (int, float)) and isinstance(b, (int, float)):\n            real = float(a)\n            imag = float(b)\n        else:\n            raise TypeError(\"angle_complex: when two args provided, args must be numeric or one must be complex\")\n\n    return ComplexNumber(real, imag)\n\ndef _compute_angle(real: float, imag: float) -> float:\n    \"\"\"Calculates the angle using atan2 and applies normalization.\"\"\"\n    if real == 0.0 and imag == 0.0:\n        return 0.0\n\n    angle = math.atan2(imag, real)\n\n    if math.isclose(angle, -math.pi):\n        return math.pi\n    else:\n        return float(angle)\n\ndef angle_complex(a, b=None) -> float:\n    \"\"\"Calculates the argument (angle) of a complex number in radians.\n    Handles various input formats and normalizes the output to (-pi, pi].\n    \"\"\"\n    complex_num = _parse_input(a, b)\n    return _compute_angle(complex_num.real, complex_num.imag)"}
{"task_id": "Mbpp/127", "solution": "def multiply_int(a: int, b: int) -> int:\n    \"\"\"\n    Computes the mathematical product of two integers with strict type validation.\n\n    Args:\n        a: The first integer operand.\n        b: The second integer operand.\n\n    Returns:\n        The product of a and b.\n\n    Raises:\n        TypeError: If either a or b is not an integer.\n\n    Examples:\n        >>> assert multiply_int(10, 20) == 200\n        >>> assert multiply_int(-3, 5) == -15\n        >>> assert multiply_int(-4, -6) == 24\n        >>> assert multiply_int(0, 12345) == 0\n    \"\"\"\n    if not isinstance(a, int) or not isinstance(b, int):\n        raise TypeError(\"multiply_int: both arguments must be int\")\n    return a * b"}
{"task_id": "Mbpp/126", "solution": "import math\n\ndef sum(a, b):\n    \"\"\"\n    Finds the sum of common divisors of two given numbers.\n    Raises TypeError if inputs are not integers, ValueError if both are zero.\n    \"\"\"\n    if not isinstance(a, int) or not isinstance(b, int):\n        raise TypeError(\"Inputs must be integers.\")\n    if a == 0 and b == 0:\n        raise ValueError(\"Cannot find common divisors for (0, 0).\")\n\n    g = math.gcd(abs(a), abs(b))\n\n    total_sum = 0\n    if g == 0:\n        return 0\n\n    limit = math.isqrt(g)\n    for i in range(1, limit + 1):\n        if g % i == 0:\n            total_sum += i\n            if i * i != g:\n                total_sum += (g // i)\n    return total_sum"}
{"task_id": "Mbpp/123", "solution": "def amicable_numbers_sum(limit: int) -> int:\n    # Handle edge case for limits less than 2 as per design.\n    if limit < 2:\n        return 0\n\n    # Initialize a list to store the sum of proper divisors for each number.\n    # sum_div[n] will store s(n).\n    sum_div = [0] * (limit + 1)\n\n    # Use a sieve method to compute the sum of proper divisors for all numbers up to 'limit'.\n    # For each number 'i', add 'i' to the sum of divisors for all its multiples.\n    for i in range(1, (limit // 2) + 1):\n        for j in range(2 * i, limit + 1, i):\n            sum_div[j] += i\n\n    total = 0\n    # Iterate through numbers from 2 to 'limit' to find amicable pairs.\n    for a in range(2, limit + 1):\n        b = sum_div[a]\n        # Check the conditions for an amicable pair (a, b):\n        # b must not equal a (excluding perfect numbers), b must be within the limit,\n        # and the sum of proper divisors of b must equal a (mutual condition).\n        if b != a and 1 <= b <= limit and sum_div[b] == a:\n            total += a\n\n    return total"}
{"task_id": "Mbpp/125", "solution": "def find_length(s: str) -> int:\n    \"\"\"\n    Finds the maximum difference between the number of 0s and 1s\n    in any contiguous substring of the given binary string using Kadane's algorithm.\n    \"\"\"\n    if not s:\n        return 0\n\n    max_sum = None      # Stores the maximum sum found so far across all subarrays\n    current_sum = 0     # Stores the maximum sum ending at the current position\n\n    for char_code in s:\n        # Map '0' to +1 and '1' to -1\n        val = 1 if char_code == '0' else -1\n\n        # Kadane's algorithm update\n        current_sum = max(val, current_sum + val)\n\n        # Update the overall maximum sum if current_sum is greater\n        if max_sum is None or current_sum > max_sum:\n            max_sum = current_sum\n\n    return max_sum"}
{"task_id": "Mbpp/128", "solution": "import string\n\nPUNCTUATION = string.punctuation\n\ndef long_words(n, str):\n    \"\"\"\n    Finds words longer than n characters from a string, stripping surrounding ASCII punctuation.\n    Example: long_words(3, \"python is a programming language\") == ['python', 'programming', 'language']\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an int\")\n    if not isinstance(str, str):\n        raise TypeError(\"str must be a str\")\n\n    results = []\n    tokens = str.split()\n\n    for token in tokens:\n        stripped_token = token.strip(PUNCTUATION)\n        if stripped_token and len(stripped_token) > n:\n            results.append(stripped_token)\n\n    return results"}
{"task_id": "Mbpp/130", "solution": "def max_occurrences(items: list):\n    \"\"\"\n    Find the item with the maximum frequency in a list.\n    Returns the earliest-occurring item among those with maximal frequency, or None if the list is empty.\n    \"\"\"\n    if not items:\n        return None\n\n    from collections import Counter\n    counts = Counter(items)\n    max_count = max(counts.values())\n\n    for item in items:\n        if counts[item] == max_count:\n            return item"}
{"task_id": "Mbpp/129", "solution": "from typing import Sequence, Any\n\nclass MagicSquareTester:\n    \"\"\"Helper class to encapsulate logic for magic square testing as per design.\"\"\"\n\n    def __init__(self, matrix: Sequence[Sequence[Any]], tolerance: float):\n        self.matrix = matrix\n        self.tolerance = tolerance\n        self._n: int = 0\n        self._magic_constant: float = 0.0\n\n    def _validate_square(self) -> None:\n        \"\"\"Validates if the matrix is square (n x n) and non-empty.\"\"\"\n        if not isinstance(self.matrix, Sequence) or len(self.matrix) == 0:\n            raise ValueError(\"matrix must be square (n x n)\")\n\n        self._n = len(self.matrix)\n\n        for row in self.matrix:\n            if not isinstance(row, Sequence) or len(row) != self._n:\n                raise ValueError(\"matrix must be square (n x n)\")\n\n    def _validate_numeric(self) -> None:\n        \"\"\"Validates if all elements in the matrix are numeric (int or float).\"\"\"\n        for row in self.matrix:\n            for element in row:\n                if not isinstance(element, (int, float)):\n                    raise TypeError(\"all elements must be numeric (int or float)\")\n\n    def _compute_magic_constant(self) -> None:\n        \"\"\"Computes the magic constant from the sum of the first row.\"\"\"\n        self._magic_constant = float(sum(self.matrix[0]))\n\n    def _check_rows(self) -> bool:\n        \"\"\"Checks if all row sums equal the magic constant within tolerance.\"\"\"\n        for row in self.matrix:\n            if abs(sum(row) - self._magic_constant) > self.tolerance:\n                return False\n        return True\n\n    def _check_columns(self) -> bool:\n        \"\"\"Checks if all column sums equal the magic constant within tolerance.\"\"\"\n        for j in range(self._n):\n            col_sum = sum(self.matrix[i][j] for i in range(self._n))\n            if abs(col_sum - self._magic_constant) > self.tolerance:\n                return False\n        return True\n\n    def _check_diagonals(self) -> bool:\n        \"\"\"Checks if both main diagonal sums equal the magic constant within tolerance.\"\"\"\n        main_diag_sum = sum(self.matrix[i][i] for i in range(self._n))\n        sec_diag_sum = sum(self.matrix[i][self._n - 1 - i] for i in range(self._n))\n\n        if abs(main_diag_sum - self._magic_constant) > self.tolerance or \\\n           abs(sec_diag_sum - self._magic_constant) > self.tolerance:\n            return False\n        return True\n\n    def _check_duplicates(self) -> bool:\n        \"\"\"Checks for exact-equality duplicate elements in the matrix.\"\"\"\n        seen = set()\n        for row in self.matrix:\n            for element in row:\n                if element in seen:\n                    return False\n                seen.add(element)\n        return True\n\n    def run(self) -> bool:\n        \"\"\"Executes all magic square checks and returns True if all pass, False otherwise.\"\"\"\n        self._validate_square()\n        self._validate_numeric()\n        self._compute_magic_constant()\n\n        if not self._check_duplicates():\n            return False\n        if not self._check_rows():\n            return False\n        if not self._check_columns():\n            return False\n        if not self._check_diagonals():\n            return False\n\n        return True\n\ndef magic_square_test(matrix: Sequence[Sequence[Any]], tolerance: float = 1e-9) -> bool:\n    \"\"\"\n    Calculates whether the given matrix is a magic square.\n    It checks for square shape, numeric elements, distinct elements, and\n    equal sums for rows, columns, and both main diagonals within a tolerance.\n    \"\"\"\n    tester = MagicSquareTester(matrix, tolerance)\n    return tester.run()"}
{"task_id": "Mbpp/132", "solution": "def tup_string(input_tuple) -> str:\n    \"\"\"Converts a tuple of single-character strings into a single concatenated string.\"\"\"\n    if not isinstance(input_tuple, tuple):\n        raise TypeError(\"Input must be a tuple.\")\n    for elem in input_tuple:\n        if not isinstance(elem, str):\n            raise TypeError(\"All tuple elements must be strings.\")\n        if len(elem) != 1:\n            raise ValueError(\"All string elements must have a length of 1.\")\n    return \"\".join(input_tuple)"}
{"task_id": "Mbpp/131", "solution": "class VowelSet:\n    \"\"\"Helper class encapsulating the set of vowels for efficient lookup.\"\"\"\n    def __init__(self) -> None:\n        self.chars = {'a', 'e', 'i', 'o', 'u', 'A', 'E', 'I', 'O', 'U'}\n\n    def contains(self, c: str) -> bool:\n        \"\"\"Checks if a character is a vowel.\"\"\"\n        return c in self.chars\n\nclass ReverseVowels:\n    \"\"\"Helper class implementing the two-pointer algorithm for vowel reversal.\"\"\"\n    def __init__(self) -> None:\n        self._vowel_set = VowelSet()\n\n    def is_vowel(self, c: str) -> bool:\n        \"\"\"Determines if a character is a vowel using the internal VowelSet.\"\"\"\n        return self._vowel_set.contains(c)\n\n    def reverse(self, s: str) -> str:\n        \"\"\"Reverses only the vowels in the input string using a two-pointer approach.\"\"\"\n        if not s or len(s) < 2:\n            return s\n\n        chars = list(s)\n        left = 0\n        right = len(chars) - 1\n\n        while left < right:\n            while left < right and not self.is_vowel(chars[left]):\n                left += 1\n            while left < right and not self.is_vowel(chars[right]):\n                right -= 1\n\n            if left < right:\n                # Swap vowels\n                chars[left], chars[right] = chars[right], chars[left]\n                left += 1\n                right -= 1\n\n        return ''.join(chars)\n\ndef reverse_vowels(s: str) -> str:\n    \"\"\"Reverses only the vowels within a given string, preserving non-vowel characters.\"\"\"\n    return ReverseVowels().reverse(s)"}
{"task_id": "Mbpp/133", "solution": "from typing import Iterable\n\ndef sum_negativenum(numbers: Iterable[float]) -> float:\n    \"\"\"Return the sum of strictly negative numbers in 'numbers'.\n    The function expects 'numbers' to be an iterable of numeric values, returning 0.0 if no negatives are found.\n    \"\"\"\n    total: float = 0.0\n    for item in numbers:\n        if item < 0:\n            total += float(item)\n    return total"}
{"task_id": "Mbpp/137", "solution": "from typing import List\n\ndef zero_count(nums: List[int]) -> float:\n    \"\"\"Computes the ratio of zeroes to non-zeroes in a list of integers.\n\n    Performs a single pass to count zeroes and non-zeroes. Raises ValueError if no non-zero elements are found.\n    Example: assert zero_count([0, 1, 0, 2, 3]) == 2/3\n    \"\"\"\n    zeros_count = 0\n    nonzeros_count = 0\n\n    for x in nums:\n        if x == 0:\n            zeros_count += 1\n        else:\n            nonzeros_count += 1\n\n    if nonzeros_count == 0:\n        raise ValueError(\"No non-zero elements: cannot compute ratio\")\n\n    return zeros_count / nonzeros_count"}
{"task_id": "Mbpp/135", "solution": "class HexagonalFunction:\n    formula = \"n * (2*n - 1)\"\n    def compute(self, n: int) -> int:\n        return n * (2 * n - 1)\n\nclass Validator:\n    def check_type(self, n):\n        if not isinstance(n, int):\n            raise TypeError(\"n must be int\")\n    def check_range(self, n: int):\n        if n < 1:\n            raise ValueError(\"n must be >= 1\")\n\ndef hexagonal_num(n):\n    \"\"\"Return nth hexagonal number H(n) = n * (2*n - 1).\n    Raises TypeError if n is not int, or ValueError if n < 1.\n    \"\"\"\n    validator = Validator()\n    validator.check_type(n)\n    validator.check_range(n)\n    hf = HexagonalFunction()\n    return hf.compute(n)"}
{"task_id": "Mbpp/139", "solution": "import math\n\ndef circle_circumference(radius: float) -> float:\n    \"\"\"Calculates the circumference of a circle using the formula C = 2 * math.pi * radius.\n\n    Args:\n        radius: Radius of the circle (int or float). Returned circumference uses the same units.\n\n    Returns:\n        The circumference as a float.\n\n    Raises:\n        TypeError: If radius is not a numeric type.\n        ValueError: If radius is negative, NaN, or infinite.\n    \"\"\"\n    # Type check: reject bool explicitly (bool is subclass of int)\n    if isinstance(radius, bool) or not isinstance(radius, (int, float)):\n        raise TypeError(\"radius must be a numeric type (int or float)\")\n\n    # Convert to float for numeric checks\n    r = float(radius)\n\n    # Check for NaN or infinite values\n    if math.isnan(r) or not math.isfinite(r):\n        raise ValueError(\"radius must be a finite number and not NaN\")\n\n    # Non-negative check\n    if r < 0:\n        raise ValueError(\"radius must be non-negative\")\n\n    if r == 0.0:\n        return 0.0\n\n    return 2 * math.pi * r"}
{"task_id": "Mbpp/138", "solution": "from typing import List, Optional, Tuple, Union\n\ndef is_Sum_Of_Powers_Of_Two(n: int, allow_1: bool = False, return_terms: bool = False) -> Union[bool, Tuple[bool, Optional[List[int]]]]:\n    \"\"\"\n    Checks if a number can be represented as a sum of distinct powers of two.\n    By default, excludes 2^0 (1); `allow_1=True` includes it.\n\n    Return:\n    - If return_terms is False: returns a boolean.\n    - If return_terms is True: returns (isRepresentable: bool, terms: Optional[List[int]])\n      where terms is a list of powers-of-two in descending order, or None when not representable.\n\n    Validation policy:\n    - Only non-negative integers are accepted.\n    - Negative numbers and zero return False (or (False, None) when return_terms=True).\n    \"\"\"\n    # Input validation: ensure int and non-negative.\n    if not isinstance(n, int):\n        return (False, None) if return_terms else False\n    if n <= 0:\n        return (False, None) if return_terms else False\n\n    # Determine representability\n    if allow_1:\n        # Any positive integer can be represented as sum of distinct powers of two.\n        is_representable = True\n    else:\n        # Exclude 1 (2^0). Any odd number would require 1, so only even numbers >=2 are representable.\n        if n == 1 or (n & 1):\n            is_representable = False\n        else:\n            is_representable = True\n\n    if not return_terms:\n        return is_representable\n\n    # Build decomposition terms when requested\n    if not is_representable:\n        return (False, None)\n\n    terms: List[int] = []\n    for k in range(n.bit_length()):\n        if (n >> k) & 1:\n            term = 1 << k\n            if allow_1 or term != 1:\n                terms.append(term)\n\n    terms.sort(reverse=True)\n    return (True, terms)"}
{"task_id": "Mbpp/142", "solution": "def count_samepair(a: list, b: list, c: list) -> int:\n    \"\"\"\n    Counts the number of items that are identical at the same position in three lists.\n    Compares elements up to the minimum length of the input lists.\n    \"\"\"\n    min_len = min(len(a), len(b), len(c))\n    count = 0\n    for i in range(min_len):\n        if a[i] == b[i] == c[i]:\n            count += 1\n    return count"}
{"task_id": "Mbpp/140", "solution": "def extract_singly(collection):\n    \"\"\"\n    Flattens a one-level deep collection of iterables into a set of unique numeric values.\n    Raises TypeError for invalid top-level or inner iterable types, or non-numeric items.\n    Raises ValueError if an item within an inner iterable is itself an iterable (deeper nesting).\n    \"\"\"\n    from collections.abc import Iterable\n    import numbers\n\n    if collection is None:\n        return set()\n\n    if not isinstance(collection, Iterable):\n        raise TypeError(\"Top-level collection must be an iterable or None.\")\n\n    result_set = set()\n    for inner in collection:\n        if not isinstance(inner, Iterable):\n            raise TypeError(f\"Top-level element '{inner}' must be an iterable.\")\n\n        for item in inner:\n            if isinstance(item, Iterable) and not isinstance(item, (str, bytes)): # Exclude strings/bytes from deeper nesting check\n                raise ValueError(f\"Deeper nesting detected: item '{item}' is an iterable. Only one level of flattening is supported.\")\n            if not isinstance(item, numbers.Number):\n                raise TypeError(f\"Inner item '{item}' must be a numeric type.\")\n            result_set.add(item)\n\n    return result_set"}
{"task_id": "Mbpp/141", "solution": "def _flip(lst, k):\n    \"\"\"\n    Helper function: returns a new list with the prefix 0..k reversed and the remainder unchanged.\n    \"\"\"\n    if not lst:\n        return []\n\n    prefix_to_reverse = lst[:k+1]\n    remainder = lst[k+1:]\n\n    reversed_prefix = prefix_to_reverse[::-1]\n\n    return reversed_prefix + remainder\n\ndef _find_max_index(lst, n):\n    \"\"\"\n    Helper function: finds the index of the maximum element in the prefix lst[0:n].\n    Raises TypeError if elements are not comparable.\n    \"\"\"\n    max_idx = 0\n    # For n=0 or n=1, max_idx remains 0, which is correct as there's only one or no element.\n    if n <= 0:\n        return -1 # Should not be called with n <= 0 in pancake_sort logic.\n\n    max_val = lst[0]\n    for i in range(1, n):\n        try:\n            if lst[i] > max_val:\n                max_val = lst[i]\n                max_idx = i\n        except TypeError:\n            # Re-raise with an informative message as required by design context.\n            raise TypeError(\n                f\"Non-comparable elements found: '{lst[max_idx]}' (type {type(lst[max_idx]).__name__}) at index {max_idx} \"\n                f\"and '{lst[i]}' (type {type(lst[i]).__name__}) at index {i}.\"\n            )\n    return max_idx\n\ndef pancake_sort(lst):\n    \"\"\"\n    Sorts a list of elements using the pancake sort algorithm, returning a new sorted list.\n    \"\"\"\n    if not lst:\n        return []\n\n    working = list(lst)  # Create a shallow copy to ensure the input list is not modified.\n    n = len(working)\n\n    # Iterate from the end of the list down to the second element (index 1).\n    for current_n in range(n, 1, -1):\n        # Find the index of the maximum element in the unsorted prefix working[0:current_n].\n        max_idx = _find_max_index(working, current_n)\n\n        # If the maximum element is not already in its correct final position.\n        if max_idx != current_n - 1:\n            # 1. Flip the prefix up to max_idx to bring the maximum element to the front.\n            working = _flip(working, max_idx)\n            # 2. Flip the entire unsorted prefix (0 to current_n-1) to move the maximum element\n            #    to its final sorted position at current_n-1.\n            working = _flip(working, current_n - 1)\n\n    return working"}
{"task_id": "Mbpp/145", "solution": "def max_Abs_Diff(arr) -> float:\n    \"\"\"\n    Finds the maximum absolute difference between any two elements in a given array.\n    It identifies the minimum and maximum values in a single pass.\n\n    Args:\n        arr: A sequence (list/tuple) of numeric values (int or float). Must contain at least two elements.\n\n    Returns:\n        float: The maximum absolute difference between any two elements.\n\n    Raises:\n        ValueError: If arr has fewer than two elements.\n        TypeError: If any element in arr is not an int or float.\n    \"\"\"\n    if not hasattr(arr, \"__len__\"):\n        raise TypeError(\"arr must be a sequence with a length\")\n    if len(arr) < 2:\n        raise ValueError(\"arr must contain at least two elements\")\n\n    # Validate first element and initialize min/max\n    first = arr[0]\n    if not isinstance(first, (int, float)):\n        raise TypeError(\"all elements must be int or float\")\n    min_val = first\n    max_val = first\n\n    # Iterate remaining elements\n    for x in arr[1:]:\n        if not isinstance(x, (int, float)):\n            raise TypeError(\"all elements must be int or float\")\n        if x < min_val:\n            min_val = x\n        elif x > max_val:\n            max_val = x\n\n    return float(abs(max_val - min_val))"}
{"task_id": "Mbpp/160", "solution": "from typing import Optional, Tuple\n\ndef extended_gcd(a: int, b: int) -> Tuple[int, int, int]:\n    # Computes (g, x, y) such that a*x + b*y == g, where g is gcd(a, b).\n    # Uses the extended Euclidean algorithm, preserving original coefficient signs.\n    s_prev, s_curr = 1, 0\n    t_prev, t_curr = 0, 1\n\n    r_prev, r_curr = a, b\n\n    while r_curr != 0:\n        quotient = r_prev // r_curr\n        r_prev, r_curr = r_curr, r_prev - quotient * r_curr\n        s_prev, s_curr = s_curr, s_prev - quotient * s_curr\n        t_prev, t_curr = t_curr, t_prev - quotient * t_curr\n\n    return (r_prev, s_prev, t_prev)\n\ndef normalize_solution(x_p: int, y_p: int, a: int, b: int, g: int) -> Tuple[int, int]:\n    # Normalizes a particular solution (x_p, y_p) such that x is in [0, abs(b/g)-1]\n    # when b is non-zero, yielding a deterministic canonical solution.\n    step_x = b // g\n    step_y = a // g\n\n    modulus = abs(step_x)\n\n    # Compute canonical x in [0, modulus - 1] using Python's % operator\n    x_normalized = x_p % modulus\n\n    # Calculate t such that x_normalized = x_p + step_x * t\n    t = (x_normalized - x_p) // step_x\n\n    y_normalized = y_p - step_y * t\n\n    return (x_normalized, y_normalized)\n\ndef find_solution(a: int, b: int, n: int) -> Optional[Tuple[int, int]]:\n    \"\"\"\n    Returns (x,y) such that a*x + b*y == n or None if no integer solution exists.\n    Applies the extended Euclidean algorithm with deterministic normalization.\n    \"\"\"\n    # Handle special cases where a or b (or both) are zero\n    if a == 0 and b == 0:\n        return (0, 0) if n == 0 else None\n\n    if a == 0: # Here, b must be non-zero\n        return (0, n // b) if n % b == 0 else None\n\n    if b == 0: # Here, a must be non-zero\n        return (n // a, 0) if n % a == 0 else None\n\n    # General case: both a and b are non-zero\n    g, x0, y0 = extended_gcd(a, b)\n\n    # A solution exists if and only if n is divisible by g\n    if n % g != 0:\n        return None\n\n    # Scale x0, y0 to find a particular solution for n\n    factor = n // g\n    x_p = x0 * factor\n    y_p = y0 * factor\n\n    # Normalize the solution to a canonical form as b is non-zero here\n    return normalize_solution(x_p, y_p, a, b, g)"}
{"task_id": "Mbpp/161", "solution": "def _all_hashable(iterable):\n    \"\"\"Checks if all elements in an iterable are hashable.\"\"\"\n    for item in iterable:\n        try:\n            hash(item)\n        except TypeError:\n            return False\n    return True\n\ndef remove_elements(source, to_remove):\n    \"\"\"Removes all elements from `source` that are present in `to_remove`, preserving order.\n    Achieves O(N+M) average time if elements in `to_remove` are hashable, otherwise O(N*M) worst-case.\n    \"\"\"\n    if not isinstance(source, list) or not isinstance(to_remove, list):\n        raise TypeError(\"Both source and to_remove must be lists\")\n\n    if _all_hashable(to_remove):\n        to_remove_set = set(to_remove)\n        result = [item for item in source if item not in to_remove_set]\n    else:\n        result = [item for item in source if not any(item == r_item for r_item in to_remove)]\n\n    return result"}
{"task_id": "Mbpp/162", "solution": "def sum_series(n: int) -> int:\n    \"\"\"Calculates the sum (n - 2*i) from i=0 to n // 2 using a closed-form formula.\"\"\"\n    if type(n) is not int:\n        raise TypeError(\"n must be an integer\")\n    if n < 0:\n        raise ValueError(\"n must be non-negative\")\n\n    k = n // 2\n    result = (k + 1) * (n - k)\n    return result"}
{"task_id": "Mbpp/167", "solution": "def next_power_of_2(n: int) -> int:\n    \"\"\"Return smallest power of two greater than or equal to n.\n    Handles n=0 correctly by returning 1.\n    \"\"\"\n    power = 1\n    # If n is 0 or 1, the loop condition (power < n) will be false immediately,\n    # and 1 will be returned, satisfying the assert next_power_of_2(0) == 1.\n    while power < n:\n        power *= 2\n    return power"}
{"task_id": "Mbpp/165", "solution": "def count_char_position(s: str) -> int:\n    \"\"\"\n    Counts characters in a string whose 1-based alphabetical position matches their 1-based string position.\n    Considers only ASCII letters 'a'-'z' (case-insensitive) and positions 1 through 26.\n    \"\"\"\n    count = 0\n    # Iterate through the string, but only up to the 26th position\n    # as positions beyond that cannot match an alphabet index (1-26).\n    # The loop bound is min(len(s), 26) to handle both short and long strings efficiently.\n    for i in range(1, min(len(s), 26) + 1):\n        char = s[i - 1]\n        lower_char = char.lower()\n\n        # Check if the character is an ASCII letter\n        if 'a' <= lower_char <= 'z':\n            # Calculate 1-based alphabet index: 'a' is 1, 'b' is 2, etc.\n            alphabet_index = ord(lower_char) - ord('a') + 1\n\n            # Compare the alphabet index with the current 1-based string position\n            if alphabet_index == i:\n                count += 1\n    return count"}
{"task_id": "Mbpp/166", "solution": "def find_even_pair(list_of_integers: list[int]) -> int:\n    \"\"\"\n    Counts the number of pairs of integers in a list that xor to an even number.\n    Pairs are counted by index, and their XOR is even if they have the same parity.\n    \"\"\"\n    n = len(list_of_integers)\n    if n < 2:\n        return 0\n\n    even_count = 0\n    odd_count = 0\n\n    for num in list_of_integers:\n        # Determine parity using the least significant bit (x & 1)\n        if (num & 1) == 0:  # Even number\n            even_count += 1\n        else:  # Odd number\n            odd_count += 1\n\n    # Calculate combinations of 2 for even numbers and odd numbers\n    # C(k, 2) = k * (k - 1) // 2\n    even_pairs = even_count * (even_count - 1) // 2\n    odd_pairs = odd_count * (odd_count - 1) // 2\n\n    return even_pairs + odd_pairs"}
{"task_id": "Mbpp/168", "solution": "def frequency(lst, value):\n    \"Counts the occurrences of a value in a list using the `==` operator. It performs a linear scan with O(n) time and O(1) additional space.\"\n    count = 0\n    for element in lst:\n        if element == value:\n            count += 1\n    return count"}
{"task_id": "Mbpp/171", "solution": "def perimeter_pentagon(side):\n    \"\"\"\n    Calculates the perimeter of a regular pentagon given its side length.\n    Assumes valid numeric input for the side length.\n    \"\"\"\n    return float(5 * side)"}
{"task_id": "Mbpp/170", "solution": "def sum_range_list(nums, start, end):\n    \"\"\"Calculates the sum of numbers in a list within a specified range, handling validation and index normalization.\"\"\"\n\n    def _validate_inputs(nums_param, start_param, end_param):\n        \"\"\"Validates the types of nums, start, and end, and the numeric type of list elements.\"\"\"\n        if not isinstance(nums_param, list):\n            raise TypeError(\"nums must be a list\")\n        if not (isinstance(start_param, int) and isinstance(end_param, int)):\n            raise TypeError(\"start and end must be ints\")\n        for elem in nums_param:\n            if not isinstance(elem, (int, float)):\n                raise TypeError(\"all elements of nums must be int or float\")\n\n    def _normalize_index(index_param, length_param):\n        \"\"\"Normalizes negative indices by adding the list length.\"\"\"\n        if index_param < 0:\n            index_param += length_param\n        return index_param\n\n    _validate_inputs(nums, start, end)\n\n    length = len(nums)\n\n    normalized_start = _normalize_index(start, length)\n    normalized_end = _normalize_index(end, length)\n\n    # Bounds checks\n    if not (0 <= normalized_start <= length - 1) and length > 0:\n        raise IndexError(\"start index out of range\")\n    if length == 0 and (start >= 0 or start < 0): # Any index is out of range for an empty list\n        raise IndexError(\"start index out of range\")\n\n    # Repeat for end index. Note: the design specified to use the `length - 1` form\n    # and not use `length > 0` explicitly for bounds, but rather let it fall through.\n    # The condition `(0 <= index <= length - 1)` correctly evaluates to false for\n    # length=0 if index is non-negative, and for negative indices if length=0\n    # after normalization, if normalized_index remains negative.\n    # Re-checking for clarity and strict design adherence for empty list.\n    if not (0 <= normalized_start <= length - 1):\n        raise IndexError(\"start index out of range\")\n    if not (0 <= normalized_end <= length - 1):\n        raise IndexError(\"end index out of range\")\n\n    # Ordering check\n    if normalized_start > normalized_end:\n        raise ValueError(\"start index greater than end index\")\n\n    total = 0\n    for i in range(normalized_start, normalized_end + 1):\n        total += nums[i]\n\n    return total"}
