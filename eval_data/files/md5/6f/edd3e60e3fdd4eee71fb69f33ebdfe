{"task_id": "Mbpp/439", "solution": "from typing import List\nfrom dataclasses import dataclass\n\n@dataclass\nclass IntegerItem:\n    \"\"\"Represents a single integer with its decimal string representation.\"\"\"\n    value: int\n\n    def decimal_representation(self) -> str:\n        return str(self.value)\n\n@dataclass\nclass IntegerList:\n    \"\"\"A list of integers.\"\"\"\n    items: List[int]\n\n@dataclass\nclass ConcatenatedInteger:\n    \"\"\"The final concatenated integer value.\"\"\"\n    value: int\n\ndef _validate_input(ints: List[int]) -> None:\n    \"\"\"Validates the input list of integers (no-op as per constraints).\"\"\"\n    pass # As per constraints, validation logic is skipped.\n\ndef _to_decimal_strings(items: List[int]) -> List[str]:\n    \"\"\"Converts a list of integers to their decimal string representations.\"\"\"\n    return [IntegerItem(item).decimal_representation() for item in items]\n\ndef _concatenate_strings(strs: List[str]) -> str:\n    \"\"\"Joins a list of strings into a single concatenated string.\"\"\"\n    return \"\".join(strs)\n\ndef _to_integer(s: str) -> int:\n    \"\"\"Converts a decimal string to an integer.\"\"\"\n    return int(s)\n\ndef multiple_to_single(ints: List[int]) -> int:\n    \"\"\"\n    Joins a list of multiple integers into a single integer by concatenating their\n    decimal string representations.\n    \"\"\"\n    _validate_input(ints)\n    decimal_strings = _to_decimal_strings(ints)\n    concatenated_string = _concatenate_strings(decimal_strings)\n    result_integer = _to_integer(concatenated_string)\n    return result_integer"}
{"task_id": "Mbpp/437", "solution": "def remove_odd(s: str) -> str:\n    \"\"\"Removes characters at even (0-based) indices from a string.\n\n    Parameters:\n        s: The input string.\n\n    Returns:\n        A new string containing only characters at odd indices (1, 3, 5, ...).\n\n    Raises:\n        TypeError: If s is not an instance of str.\n\n    Algorithm:\n        This function performs a single-pass traversal of the input string,\n        collecting characters where the 0-based index is odd. It uses a list\n        comprehension and string join for efficiency.\n\n    Complexity:\n        Time: O(n), where n is the length of the input string.\n        Space: O(n) for the returned string; O(1) auxiliary space beyond that.\n\n    Examples:\n        remove_odd('python') -> 'yhn'\n        remove_odd('') -> ''\n        remove_odd('a') -> ''\n    \"\"\"\n    if not isinstance(s, str):\n        raise TypeError(\"remove_odd: s must be a str\")\n\n    # Collect characters at odd indices using a list comprehension.\n    # range(1, len(s), 2) generates odd indices: 1, 3, 5, ...\n    odd_chars = [s[i] for i in range(1, len(s), 2)]\n\n    return ''.join(odd_chars)"}
{"task_id": "Mbpp/441", "solution": "def surfacearea_cube(side):\n    \"\"\"\n    Calculates the surface area of a cube given its side length.\n\n    Raises TypeError if side is not numeric, ValueError if side is negative.\n    \"\"\"\n    def _validate_side(s):\n        \"\"\"Validates that side is a non-negative number.\"\"\"\n        if not isinstance(s, (int, float)):\n            raise TypeError(\"Side length must be a number (int or float).\")\n        if s < 0:\n            raise ValueError(\"Side length cannot be negative.\")\n\n    _validate_side(side)\n    return 6 * side * side"}
{"task_id": "Mbpp/440", "solution": "import unicodedata\n\ndef find_adverb_position(sentence: str) -> tuple[int, int, str] | None:\n    \"\"\"\n    Finds the first adverb and its positions in a given sentence.\n    Adverbs are identified by an '-ly' suffix or presence in a predefined whitelist,\n    after stripping leading/trailing Unicode punctuation.\n    \"\"\"\n    ADVERB_WHITELIST = {\"very\", \"too\", \"well\", \"fast\", \"hard\"}\n\n    i = 0\n    n = len(sentence)\n\n    while i < n:\n        # Skip leading whitespace characters\n        while i < n and sentence[i].isspace():\n            i += 1\n\n        # If we reached the end of the sentence, no more tokens\n        if i >= n:\n            break\n\n        token_start = i\n        j = i\n        # Find the end of the current word token (until next whitespace or end of string)\n        while j < n and not sentence[j].isspace():\n            j += 1\n        token_end = j\n\n        # Initialize stripped boundaries to current token boundaries\n        stripped_start = token_start\n        stripped_end = token_end\n\n        # Strip leading punctuation\n        while stripped_start < stripped_end and unicodedata.category(sentence[stripped_start]).startswith('P'):\n            stripped_start += 1\n\n        # Strip trailing punctuation\n        while stripped_end > stripped_start and unicodedata.category(sentence[stripped_end - 1]).startswith('P'):\n            stripped_end -= 1\n\n        # If the token became empty or only punctuation after stripping, move to the next token\n        if stripped_start >= stripped_end:\n            i = token_end\n            continue\n\n        # Extract the cleaned word and normalize it for case-insensitive detection\n        cleaned_word = sentence[stripped_start:stripped_end]\n        normalized_word = cleaned_word.lower()\n\n        # Check if the cleaned word is an adverb\n        is_adverb = normalized_word.endswith(\"ly\") or normalized_word in ADVERB_WHITELIST\n\n        if is_adverb:\n            # Return the start index, end index, and the original-cased cleaned word\n            return (stripped_start, stripped_end, cleaned_word)\n\n        # Move to the next token in the sentence\n        i = token_end\n\n    # If no adverb was found after processing all tokens\n    return None"}
{"task_id": "Mbpp/447", "solution": "def cube_nums(nums):\n    \"\"\"\n    Calculates the cube of each element in an iterable of numbers.\n\n    Raises TypeError if the input is not iterable or contains non-numeric elements.\n    \"\"\"\n    try:\n        iter(nums)\n    except TypeError:\n        raise TypeError(\"nums must be iterable\")\n    try:\n        return [x**3 for x in nums]\n    except TypeError:\n        raise TypeError(\"All elements in nums must be numeric and support ** operator\")"}
{"task_id": "Mbpp/445", "solution": "from typing import Sequence, Tuple, Union\nfrom collections.abc import Sequence as _SequenceABC\n\ndef validate_outer_sequences(\n    primary_tuple: Sequence[Tuple[float, ...]],\n    secondary_tuple: Sequence[Tuple[float, ...]]\n) -> None:\n    \"\"\"Validates that both outer inputs are Sequences (not str/bytes) and have equal outer length.\"\"\"\n    if not isinstance(primary_tuple, _SequenceABC) or isinstance(primary_tuple, (str, bytes)):\n        raise TypeError(\"primary_tuple must be a Sequence, not str or bytes.\")\n    if not isinstance(secondary_tuple, _SequenceABC) or isinstance(secondary_tuple, (str, bytes)):\n        raise TypeError(\"secondary_tuple must be a Sequence, not str or bytes.\")\n    if len(primary_tuple) != len(secondary_tuple):\n        raise ValueError(\"Outer sequences must have the same length.\")\n\ndef validate_inner_pair(\n    i: int,\n    left_inner: Sequence[Union[int, float]],\n    right_inner: Sequence[Union[int, float]]\n) -> None:\n    \"\"\"Validates inner sequences at index i are Sequences (not str/bytes) and have equal length.\"\"\"\n    if not isinstance(left_inner, _SequenceABC) or isinstance(left_inner, (str, bytes)):\n        raise TypeError(f\"Element at primary_tuple[{i}] must be a Sequence, not str or bytes.\")\n    if not isinstance(right_inner, _SequenceABC) or isinstance(right_inner, (str, bytes)):\n        raise TypeError(f\"Element at secondary_tuple[{i}] must be a Sequence, not str or bytes.\")\n    if len(left_inner) != len(right_inner):\n        raise ValueError(f\"Inner sequences at index {i} must have the same length.\")\n\ndef multiply_inner_pair(\n    left_inner: Sequence[Union[int, float]],\n    right_inner: Sequence[Union[int, float]]\n) -> Tuple[float, ...]:\n    \"\"\"Multiplies elements of two inner sequences after validating they are numeric.\"\"\"\n    inner_results = []\n    for j in range(len(left_inner)):\n        left_val = left_inner[j]\n        right_val = right_inner[j]\n        if not isinstance(left_val, (int, float)):\n            raise TypeError(f\"Element at primary_tuple[...][{j}] must be an int or float, got {type(left_val).__name__}.\")\n        if not isinstance(right_val, (int, float)):\n            raise TypeError(f\"Element at secondary_tuple[...][{j}] must be an int or float, got {type(right_val).__name__}.\")\n        inner_results.append(left_val * right_val)\n    return tuple(inner_results)\n\ndef index_multiplication(\n    primary_tuple: Sequence[Tuple[float, ...]],\n    secondary_tuple: Sequence[Tuple[float, ...]]\n) -> Tuple[Tuple[float, ...], ...]:\n    \"\"\"\n    Performs index-wise multiplication of tuple elements in two given tuples.\n\n    Validates input types and shapes strictly, performing elementwise multiplication\n    and returning an immutable tuple of tuples without mutating inputs.\n\n    Parameters:\n        primary_tuple: A sequence of inner numeric sequences (tuples preferred), where each inner element must be int or float.\n        secondary_tuple: A sequence of inner numeric sequences with the same requirements and shape as primary_tuple.\n\n    Returns:\n        A tuple of inner tuples containing elementwise products for corresponding inner sequences.\n\n    Raises:\n        TypeError: If outer inputs are not sequences, outer/inner elements are strings/bytes,\n                   inner elements are not sequences, or inner numeric elements are not int or float.\n        ValueError: If outer lengths differ or paired inner lengths differ.\n\n    Time Complexity: O(N * M) where N is the length of the outer sequences and M is the maximum inner sequence length.\n    Space Complexity: O(N * M) additional space for the returned tuple-of-tuples.\n    The function is pure and does not mutate its inputs.\n\n    Example:\n        assert index_multiplication(((1, 3), (4, 5), (2, 9), (1, 10)),((6, 7), (3, 9), (1, 1), (7, 3)) ) == ((6, 21), (12, 45), (2, 9), (7, 30))\n    \"\"\"\n    validate_outer_sequences(primary_tuple, secondary_tuple)\n\n    if not primary_tuple:\n        return ()\n\n    outer_results = []\n    for i in range(len(primary_tuple)):\n        left_inner = primary_tuple[i]\n        right_inner = secondary_tuple[i]\n\n        validate_inner_pair(i, left_inner, right_inner)\n        inner_result = multiply_inner_pair(left_inner, right_inner)\n        outer_results.append(inner_result)\n\n    return tuple(outer_results)"}
{"task_id": "Mbpp/451", "solution": "import re\n\n_WS_PATTERN = re.compile(r'\\s+', flags=re.UNICODE)\n\ndef remove_whitespaces(s: str) -> str:\n    \"\"\"\n    Return a new string with all Unicode whitespace characters removed.\n    This uses a precompiled regex pattern for efficient whitespace removal.\n    \"\"\"\n    return _WS_PATTERN.sub('', s)"}
{"task_id": "Mbpp/446", "solution": "def count_Occurrence(items: list, data: tuple) -> dict:\n    \"\"\"\n    Counts the occurrences of elements from 'items' list within the 'data' tuple.\n    Returns a dictionary mapping each unique item from 'items' to its count in 'data'.\n    \"\"\"\n    # Input validation: check types of items and data\n    if not isinstance(items, list):\n        raise TypeError(\"items must be a list\")\n    if not isinstance(data, tuple):\n        raise TypeError(\"data must be a tuple\")\n\n    # If items list is empty, return an empty dictionary\n    if not items:\n        return {}\n\n    # Hashability validation for elements in 'items'\n    for i, item in enumerate(items):\n        try:\n            hash(item)\n        except TypeError:\n            raise TypeError(f\"item at index {i} is unhashable: {item!r}\")\n\n    # Build initial lookup dictionary with unique items from 'items' and zero counts\n    lookup = {}\n    for x in items:\n        if x not in lookup:\n            lookup[x] = 0\n\n    # Scan 'data' tuple and increment counts for elements found in lookup\n    for d_item in data:\n        if d_item in lookup:\n            lookup[d_item] += 1\n\n    return lookup"}
{"task_id": "Mbpp/450", "solution": "def extract_string(values, size):\n    \"\"\"\n    Extract strings of a specified length from an iterable of strings.\n\n    Parameters:\n    - values: an iterable of str (e.g., list, tuple, generator). Each element must be a str.\n    - size: an int (must be non-negative).\n\n    Returns:\n    - A list of strings from `values` whose length equals `size`, preserving original order.\n\n    Raises:\n    - TypeError(\"size must be an int\") if size is not an int.\n    - ValueError(\"size must be non-negative\") if size < 0.\n    - TypeError(\"values must be an iterable of str\") if values is not iterable.\n    - TypeError(\"all elements in values must be of type str\") if any element is not a str.\n\n    Example:\n    >>> assert extract_string(['Python', 'list', 'exercises', 'practice', 'solution'], 8) == ['practice', 'solution']\n    \"\"\"\n    # Validate size\n    if not isinstance(size, int):\n        raise TypeError(\"size must be an int\")\n    if size < 0:\n        raise ValueError(\"size must be non-negative\")\n\n    # Validate values is iterable\n    try:\n        iterator = iter(values)\n    except TypeError:\n        raise TypeError(\"values must be an iterable of str\")\n\n    result = []\n    for item in iterator:\n        if not isinstance(item, str):\n            raise TypeError(\"all elements in values must be of type str\")\n        if len(item) == size:\n            result.append(item)\n\n    return result"}
{"task_id": "Mbpp/448", "solution": "def cal_sum(n: int) -> int:\n    \"\"\"Calculates the sum of Perrin numbers up to n (inclusive) iteratively.\n    Perrin numbers are P(0)=3, P(1)=0, P(2)=2, and P(n)=P(n-2)+P(n-3) for n>=3.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be int\")\n    if n < 0:\n        raise ValueError(\"n must be non-negative\")\n\n    if n == 0:\n        return 3\n    if n == 1:\n        return 3\n    if n == 2:\n        return 5\n\n    # Initialize the first three Perrin numbers\n    # a holds P(i-3), b holds P(i-2), c holds P(i-1)\n    a = 3  # P(0)\n    b = 0  # P(1)\n    c = 2  # P(2)\n\n    # Initialize the sum with the first three Perrin numbers\n    current_sum = a + b + c\n\n    # Iterate from i=3 up to n to calculate subsequent Perrin numbers and sum them\n    for _ in range(3, n + 1):\n        next_perrin = a + b  # Calculate P(i) = P(i-2) + P(i-3)\n        current_sum += next_perrin  # Add P(i) to the running sum\n\n        # Rotate values for the next iteration: P(i-3), P(i-2), P(i-1) become P(i-2), P(i-1), P(i)\n        a, b, c = b, c, next_perrin\n\n    return current_sum"}
{"task_id": "Mbpp/453", "solution": "def sumofFactors(n):\n    \"\"\"\n    Return the sum of even positive divisors of integer n.\n    This function efficiently enumerates divisors up to the square root of n.\n    \"\"\"\n    total = 0\n    import math\n    limit = math.isqrt(n)\n    for d in range(1, limit + 1):\n        if n % d == 0:\n            pair = n // d\n            if d % 2 == 0:\n                total += d\n            if pair != d and (pair % 2 == 0):\n                total += pair\n    return total"}
{"task_id": "Mbpp/454", "solution": "import re\n\nclass TextInput:\n    \"\"\"Represents the input text and provides emptiness check.\"\"\"\n    def __init__(self, content: str):\n        self.content = content\n\n    def isEmpty(self) -> bool:\n        \"\"\"Checks if the content is empty or contains only whitespace.\"\"\"\n        return self.content.strip() == ''\n\nclass RegexPattern:\n    \"\"\"Encapsulates the regex pattern for matching.\"\"\"\n    def __init__(self, pattern: str):\n        self.pattern = pattern\n\nclass Token:\n    \"\"\"Represents a single word token.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n\n    def containsZ(self) -> bool:\n        \"\"\"Checks if the token contains 'z' (case-insensitive).\"\"\"\n        return 'z' in self.value.lower()\n\nclass MatchResult:\n    \"\"\"Holds the boolean result of a match operation.\"\"\"\n    def __init__(self, found: bool):\n        self.found = found\n\nclass TextMatcher:\n    \"\"\"Applies a regex pattern to input text.\"\"\"\n    def __init__(self, pattern: RegexPattern):\n        self.pattern = pattern\n\n    def match(self, input: TextInput) -> MatchResult:\n        \"\"\"Searches for the pattern in the input content using re.search.\"\"\"\n        match_found = re.search(self.pattern.pattern, input.content) is not None\n        return MatchResult(found=match_found)\n\ndef text_match_wordz(input_text: str) -> bool:\n    \"\"\"\n    Determines if the input string contains at least one word with 'z' (case-insensitive).\n    This function uses an internal regex pattern and helper classes.\n    \"\"\"\n    text_input = TextInput(content=input_text)\n\n    if text_input.isEmpty():\n        return False\n\n    # The exact regex pattern from the design context, using raw string for backslashes.\n    regex_pattern = RegexPattern(pattern=r'(?i)\\b\\w*z\\w*\\b')\n    text_matcher = TextMatcher(regex_pattern)\n    result = text_matcher.match(text_input)\n\n    return result.found"}
