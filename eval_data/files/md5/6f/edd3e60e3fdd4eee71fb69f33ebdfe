{"task_id": "Mbpp/459", "solution": "def remove_uppercase(input_str: str) -> str:\n    \"\"\"Removes all uppercase characters from the input string, preserving the order of other characters.\n    This function uses `str.isupper()` for Unicode-aware detection and efficiently constructs the result.\n    \"\"\"\n    return ''.join(char for char in input_str if not char.isupper())"}
{"task_id": "Mbpp/460", "solution": "def Extract(input_list: list) -> list:\n    \"\"\"\n    Extracts the first element of each non-empty sublist from a list of lists.\n    Performs input validation as specified in the design context.\n    \"\"\"\n    def _is_sequence(obj) -> bool:\n        \"\"\"Checks if an object is an allowed sequence type (list or tuple).\"\"\"\n        return isinstance(obj, (list, tuple))\n\n    def _validate_input(input_val) -> None:\n        \"\"\"Validates the top-level input and its elements, raising TypeError on violations.\"\"\"\n        if not isinstance(input_val, list):\n            raise TypeError(\"Extract: input must be a list\")\n\n        for i, element in enumerate(input_val):\n            if not _is_sequence(element):\n                raise TypeError(f\"Extract: element at index {i} is not a sequence (list or tuple)\")\n\n    _validate_input(input_list)\n\n    result = []\n    for sublist in input_list:\n        if len(sublist) > 0:\n            result.append(sublist[0])\n\n    return result"}
{"task_id": "Mbpp/462", "solution": "def combinations_list(elements: list) -> list[list]:\n    \"\"\"\n    Generates all possible combinations (power set) of elements in a list iteratively.\n    The order of generated subsets and elements within subsets is deterministic as per the primary assertion.\n    \"\"\"\n    result = [[]]  # Initialize with the empty subset\n\n    for element in elements:\n        # Snapshot the current length of 'result' to iterate only over already existing subsets\n        current_len = len(result)\n        for i in range(current_len):\n            existing_subset = result[i]\n            # Form a new subset by prepending the current element to a copy of an existing subset\n            new_subset = [element] + existing_subset.copy()\n            result.append(new_subset)\n\n    return result"}
{"task_id": "Mbpp/470", "solution": "def add_pairwise(values: tuple) -> tuple:\n    \"\"\"Compute pairwise sums of neighboring elements in the input tuple. Returns an empty tuple if the input has less than two elements.\"\"\"\n    if len(values) < 2:\n        return ()\n\n    results = []\n    for i in range(len(values) - 1):\n        s = values[i] + values[i + 1]\n        results.append(s)\n\n    return tuple(results)"}
{"task_id": "Mbpp/465", "solution": "from typing import Any, Dict\n\ndef _is_empty(value: Any) -> bool:\n    \"\"\"Checks if a value is considered empty based on predefined rules.\"\"\"\n    if value is None:\n        return True\n    if value == '':\n        return True\n    # Check for empty containers of specific types: list, tuple, set, dict.\n    if isinstance(value, (list, tuple, set, dict)) and len(value) == 0:\n        return True\n    return False\n\ndef drop_empty(data: dict) -> dict:\n    \"\"\"\n    Removes key-value pairs from a dictionary where the value is considered empty.\n\n    An item's value is considered empty if it is None, an exact empty string '',\n    or an empty container (list, tuple, set, dict). Numeric zeros, booleans,\n    and whitespace-only strings are NOT considered empty. The function\n    performs a shallow check and returns a new dictionary without modifying the input.\n    \"\"\"\n    result = {}\n    for key, value in data.items():\n        if not _is_empty(value):\n            result[key] = value\n    return result"}
{"task_id": "Mbpp/463", "solution": "def max_subarray_product(array):\n    \"\"\"\n    Finds the maximum product of a contiguous subarray in the given array.\n    Handles negative numbers, zeros, and single-element arrays.\n    \"\"\"\n    if not array:\n        raise ValueError(\"Input array cannot be empty.\")\n\n    # Initialize current_max, current_min, and global_max with the first element.\n    # This handles single-element arrays and preserves numeric type.\n    current_max = array[0]\n    current_min = array[0]\n    global_max = array[0]\n\n    for x in array[1:]:\n        if x == 0:\n            # If current element is 0, it resets the current product segments.\n            # 0 itself is a candidate for maximum product (if all others are negative).\n            global_max = max(global_max, 0)\n            current_max = 0\n            current_min = 0\n        else:\n            # Store current_max before it's updated, as it's needed for current_min calculation.\n            temp_current_max = current_max\n\n            # For a new segment (after a zero), current_max and current_min should start with x.\n            # Otherwise, calculate candidates by multiplying with current_max, current_min.\n            if current_max == 0 and current_min == 0:\n                current_max = x\n                current_min = x\n            else:\n                # Calculate the three possible candidates for the new current_max and current_min:\n                # 1. The element itself (starting a new subarray)\n                # 2. Product with the previous max (extending the max product)\n                # 3. Product with the previous min (negative * negative = positive, could be new max)\n                current_max = max(x, temp_current_max * x, current_min * x)\n                current_min = min(x, temp_current_max * x, current_min * x)\n\n            # Update global_max with the largest product found so far.\n            global_max = max(global_max, current_max)\n\n    return global_max"}
{"task_id": "Mbpp/471", "solution": "from typing import Iterable\n\ndef find_remainder(arr: Iterable[int], n: int) -> int:\n    \"\"\"Find the product of array elements modulo n, applying modulo at each step.\n\n    Args:\n        arr: Iterable of integers.\n        n: Modulus (must be int > 0).\n\n    Returns:\n        int: The product of elements in arr modulo n (in range 0..n-1).\n\n    Raises:\n        TypeError: If n is not an int or arr is not iterable or any element is not an int.\n        ValueError: If n <= 0.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an int\")\n    if n <= 0:\n        raise ValueError(\"n must be > 0\")\n\n    try:\n        iterator = iter(arr)\n    except TypeError:\n        raise TypeError(\"arr must be an iterable\")\n\n    product_modulo_n = 1\n    has_elements = False\n\n    for element in iterator:\n        if not isinstance(element, int):\n            raise TypeError(\"all elements of arr must be int\")\n        product_modulo_n = (product_modulo_n * (element % n)) % n\n        has_elements = True\n\n    if not has_elements:\n        return 1 % n\n\n    return product_modulo_n"}
{"task_id": "Mbpp/472", "solution": "def check_Consecutive(list_input: list) -> bool:\n    \"\"\"Checks if a list contains consecutive integers, order-insensitively, with no duplicates.\n\n    The function returns True if:\n    - list_input is non-empty\n    - all elements are integers\n    - there are no duplicates\n    - the integers form a consecutive sequence (max - min + 1 == number of elements)\n\n    Returns False for an empty list.\n\n    Time complexity: O(n)\n    Space complexity: O(n)\n\n    Example:\n    >>> assert check_Consecutive([1, 2, 3, 4, 5]) == True\n    \"\"\"\n    if not list_input:\n        return False\n\n    min_val = float('inf')\n    max_val = float('-inf')\n    unique_elements = set()\n\n    for item in list_input:\n        if not isinstance(item, int):\n            raise TypeError(\"All elements must be integers\")\n        unique_elements.add(item)\n        if item < min_val:\n            min_val = item\n        if item > max_val:\n            max_val = item\n\n    if len(unique_elements) != len(list_input):\n        return False\n\n    return (max_val - min_val + 1) == len(unique_elements)"}
{"task_id": "Mbpp/468", "solution": "def max_product(arr):\n    \"\"\"\n    Finds the maximum product of an increasing subsequence in an array.\n    This dynamic programming approach correctly handles positive, negative, and zero values.\n    \"\"\"\n    if arr is None or len(arr) == 0:\n        return None\n\n    n = len(arr)\n    max_prod = [0] * n\n    min_prod = [0] * n\n\n    for i in range(n):\n        # Initialize with the element itself (a single-element subsequence)\n        max_prod[i] = arr[i]\n        min_prod[i] = arr[i]\n\n        # Consider all previous elements arr[j] that can precede arr[i]\n        for j in range(i):\n            if arr[j] < arr[i]:\n                # Calculate products by extending the subsequence ending at j\n                cand1 = max_prod[j] * arr[i]\n                cand2 = min_prod[j] * arr[i]\n\n                # Update max_prod[i] and min_prod[i]\n                # Both candidates are checked because multiplying by a negative number flips the sign.\n                max_prod[i] = max(max_prod[i], cand1, cand2)\n                min_prod[i] = min(min_prod[i], cand1, cand2)\n\n    # The maximum product can be any value in the max_prod array\n    return max(max_prod)"}
{"task_id": "Mbpp/473", "solution": "def tuple_intersection(listA, listB):\n    \"\"\"\n    Finds the intersection of elements in two tuple lists,\n    treating (a, b) and (b, a) as equivalent.\n    \"\"\"\n\n    def _unordered_key(t):\n        \"\"\"Returns a canonical, sorted key for a 2-element tuple.\"\"\"\n        return tuple(sorted(t))\n\n    def _build_unordered_map(input_list):\n        \"\"\"\n        Builds a map from canonical unordered key to the first-seen tuple representation,\n        deduplicating by the unordered key.\n        \"\"\"\n        unordered_map = {}\n        for item_tuple in input_list:\n            key = _unordered_key(item_tuple)\n            if key not in unordered_map:\n                unordered_map[key] = item_tuple\n        return unordered_map\n\n    mapA = _build_unordered_map(listA)\n    mapB = _build_unordered_map(listB)\n\n    intersection_set = set()\n    for key in mapA:\n        if key in mapB:\n            # Add the representation from listA to the result set\n            intersection_set.add(mapA[key])\n\n    return intersection_set"}
{"task_id": "Mbpp/474", "solution": "def replace_char(s: str, old: str, new: str) -> str:\n    \"\"\"Replaces all occurrences of character `old` with `new` in string `s`.\"\"\"\n    if not isinstance(s, str) or not isinstance(old, str) or not isinstance(new, str):\n        raise TypeError(\"s, old, and new must be instances of str\")\n    if len(old) != 1 or len(new) != 1:\n        raise ValueError(\"old and new must be length 1\")\n\n    result_chars = []\n    for char in s:\n        if char == old:\n            result_chars.append(new)\n        else:\n            result_chars.append(char)\n    return \"\".join(result_chars)"}
{"task_id": "Mbpp/476", "solution": "from typing import Iterable, TypeVar\n\nT = TypeVar('T')\n\ndef big_sum(seq: Iterable[T]) -> T:\n    \"\"\"\n    Calculates the sum of the largest and smallest values in a given iterable.\n\n    Raises TypeError for non-iterable input, unorderable or non-addable elements.\n    Raises ValueError for empty iterables. Generators are consumed. O(n) time, O(1) space.\n    \"\"\"\n    try:\n        iterator = iter(seq)\n    except TypeError:\n        raise TypeError(\"big_sum: seq must be an iterable\")\n\n    try:\n        first = next(iterator)\n    except StopIteration:\n        raise ValueError(\"big_sum: seq must contain at least one element\")\n\n    min_val = first\n    max_val = first\n\n    for element in iterator:\n        try:\n            if element < min_val:\n                min_val = element\n            if element > max_val:\n                max_val = element\n        except TypeError:\n            raise TypeError(\"big_sum: elements are not mutually orderable\")\n\n    try:\n        return min_val + max_val\n    except TypeError:\n        raise TypeError(\"big_sum: elements do not support addition\")"}
{"task_id": "Mbpp/477", "solution": "def is_lower(s: str) -> str:\n    \"\"\"\n    Return the lowercase form of the input string.\n\n    Parameters:\n      s (str): Input string to convert to lowercase.\n\n    Returns:\n      str: The lowercase form of the input string (equivalent to s.lower()).\n\n    Raises:\n      TypeError: If s is not an instance of str.\n\n    Edge cases:\n      - Empty string: returns empty string.\n      - Strings with no uppercase characters: returns a string equal to the input.\n      - Unicode: handled according to Python's str.lower() semantics.\n\n    Example:\n      assert is_lower('ABC') == 'abc'\n    \"\"\"\n    if not isinstance(s, str):\n        raise TypeError(\"is_lower: input must be an instance of str\")\n    return s.lower()"}
{"task_id": "Mbpp/475", "solution": "from typing import Mapping, List, Tuple, TypeVar\n\nK = TypeVar('K')\nV = TypeVar('V')\n\ndef sort_counter(mapping: Mapping[K, V]) -> List[Tuple[K, V]]:\n    \"\"\"Sorts a dictionary by its values in descending order.\n\n    This function returns a new list of (key, value) tuples sorted by value\n    descending, preserving original insertion order for ties.\n    Raises TypeError if input is not a mapping; comparator errors for\n    incomparable values may propagate. Time complexity: O(n log n), Space: O(n).\n\n    Args:\n        mapping: A dictionary-like object with an `items()` method.\n\n    Returns:\n        A new list of (key, value) tuples, sorted by value in descending order.\n\n    Raises:\n        TypeError: If `mapping` is not a mapping (e.g., not dict-like).\n\n    Examples:\n        >>> sort_counter({'Math': 81, 'Physics': 83, 'Chemistry': 87})\n        [('Chemistry', 87), ('Physics', 83), ('Math', 81)]\n        >>> sort_counter({'a': 1, 'b': 2, 'c': 2, 'd': 1})\n        [('b', 2), ('c', 2), ('a', 1), ('d', 1)]\n        >>> sort_counter({})\n        []\n    \"\"\"\n    if not isinstance(mapping, Mapping):\n        raise TypeError(f\"sort_counter expects a mapping (typing.Mapping); got {type(mapping)}\")\n\n    items = list(mapping.items())\n    items.sort(key=lambda kv: kv[1], reverse=True)\n    return items"}
{"task_id": "Mbpp/554", "solution": "def Split(lst):\n    # Validate that all elements in the list are integers.\n    for x in lst:\n        if not isinstance(x, int):\n            raise TypeError(\"All elements of lst must be int\")\n    # Return a new list containing only the odd integers, preserving original order.\n    return [x for x in lst if x % 2 != 0]"}
{"task_id": "Mbpp/478", "solution": "def remove_lowercase(input: str) -> str:\n    \"\"\"Return a new string where all characters for which c.islower() is True are removed.\"\"\"\n    result_chars = []\n    for c in input:\n        if not c.islower():\n            result_chars.append(c)\n    return \"\".join(result_chars)"}
{"task_id": "Mbpp/479", "solution": "import math\n\ndef first_Digit(value) -> int:\n    \"\"\"\n    Finds the first (leftmost) digit of a given number.\n    Handles integers and floats, negative numbers, and zero.\n    \"\"\"\n    # Validate numeric input\n    if not isinstance(value, (int, float)):\n        raise TypeError(\"value must be an int or float\")\n\n    # Reject NaN and infinities\n    if isinstance(value, float) and (math.isnan(value) or math.isinf(value)):\n        raise ValueError(\"value must be a finite number\")\n\n    # Truncate floats towards zero and take the absolute value\n    n = abs(int(value))\n\n    # Handle the special case of zero\n    if n == 0:\n        return 0\n\n    # Repeatedly divide by 10 until the number is a single digit\n    while n >= 10:\n        n //= 10\n\n    return n"}
{"task_id": "Mbpp/555", "solution": "def difference(n):\n    # Validate input: n must be a non-negative integer.\n    if not isinstance(n, int) or n < 0:\n        raise ValueError(\"n must be a non-negative integer\")\n\n    # Compute t = n*(n+1)/2 using integer arithmetic.\n    t = (n * (n + 1)) // 2\n\n    # The result is t * (t - 1).\n    return t * (t - 1)"}
{"task_id": "Mbpp/556", "solution": "def find_Odd_Pair(arr, n):\n    \"\"\"\n    Counts the number of pairs whose XOR value is odd.\n    An XOR value is odd iff one number is even and the other is odd.\n    \"\"\"\n    if not isinstance(n, int):\n        raise ValueError(\"n must be an integer\")\n    if not isinstance(arr, (list, tuple)):\n        raise ValueError(\"arr must be a list or tuple\")\n    if n != len(arr):\n        raise ValueError(\"n must be equal to len(arr)\")\n    if n < 2:\n        return 0\n\n    even_count = 0\n    odd_count = 0\n\n    for i in range(n):\n        if not isinstance(arr[i], int):\n            raise ValueError(\"all elements of arr must be integers\")\n        if arr[i] & 1:  # odd\n            odd_count += 1\n        else:\n            even_count += 1\n\n    return even_count * odd_count"}
{"task_id": "Mbpp/557", "solution": "def _is_letter(ch: str) -> bool:\n    \"\"\"Returns True if the character is alphabetic.\"\"\"\n    return ch.isalpha()\n\ndef _map_case(ch: str) -> str:\n    \"\"\"Applies Unicode-aware case mapping to a single character.\"\"\"\n    return ch.swapcase()\n\ndef _toggle_case(ch: str) -> str:\n    \"\"\"Toggles the case of an alphabetic character; otherwise returns it unchanged.\"\"\"\n    if _is_letter(ch):\n        return _map_case(ch)\n    return ch\n\ndef toggle_string(s: str) -> str:\n    \"\"\"\n    Toggles the case of all alphabetic characters in a string.\n    Non-alphabetic characters remain unchanged.\n    \"\"\"\n    result_chars = []\n    for char in s:\n        result_chars.append(_toggle_case(char))\n    return \"\".join(result_chars)"}
{"task_id": "Mbpp/562", "solution": "def Find_Max_Length(list_of_sublists):\n    \"\"\"\n    Find_Max_Length(list_of_sublists) -> int\n\n    Return the length of the longest immediate sublist in list_of_sublists.\n\n    Parameters:\n    - list_of_sublists (list): A Python list whose immediate elements are treated as sublists and must support len().\n\n    Returns:\n    - int: Non-negative integer equal to the maximum len() among immediate elements; returns 0 for an empty outer list.\n\n    Behavior / Edge cases:\n    - If list_of_sublists is not a list, raises TypeError.\n    - If any element does not support len(), raises TypeError.\n    - Empty sublists are allowed and have length 0.\n    - The function does not modify the input or any sublists (pure function).\n\n    Example:\n    >>> Find_Max_Length([[1,2], [3,4,5], [6]])\n    3\n    \"\"\"\n    if not isinstance(list_of_sublists, list):\n        raise TypeError(\"list_of_sublists must be a list\")\n\n    max_len = 0\n    for s in list_of_sublists:\n        try:\n            current_len = len(s)\n        except TypeError:\n            raise TypeError(\"elements of list_of_sublists must support len()\")\n        if current_len > max_len:\n            max_len = current_len\n    return max_len"}
{"task_id": "Mbpp/558", "solution": "def digit_distance_nums(a, b):\n    \"\"\"\n    Calculates the sum of per-digit absolute differences between two integers,\n    aligning digits from the least significant digit (LSB) and conceptually\n    padding the shorter number with leading zeros.\n    \"\"\"\n\n    # Input validation\n    if not isinstance(a, int) or not isinstance(b, int):\n        raise TypeError(\"digit_distance_nums: both parameters must be integers\")\n\n    # Helper generator function to yield digits from LSB to MSB using arithmetic.\n    # For n == 0, yield a single 0 to ensure correct comparisons.\n    def _yield_digits_arithmetic(n):\n        if n == 0:\n            yield 0\n            return\n        while n > 0:\n            yield n % 10\n            n //= 10\n\n    # Use absolute values of inputs for digit extraction.\n    a_abs = abs(a)\n    b_abs = abs(b)\n\n    iter_a = _yield_digits_arithmetic(a_abs)\n    iter_b = _yield_digits_arithmetic(b_abs)\n\n    total_distance = 0\n\n    # Iterate until both iterators are exhausted.\n    while True:\n        da = next(iter_a, None)\n        db = next(iter_b, None)\n\n        if da is None and db is None:\n            break\n\n        if da is None:\n            da = 0\n        if db is None:\n            db = 0\n\n        total_distance += abs(da - db)\n\n    return total_distance"}
{"task_id": "Mbpp/559", "solution": "def max_sub_array_sum(arr, n):\n    \"\"\"\n    Finds the sum of the largest contiguous sublist (maximum subarray sum) using Kadane's algorithm.\n    Performs strict input validation for arr and n before computation.\n    \"\"\"\n    if not isinstance(arr, (list, tuple)):\n        raise TypeError(\"arr must be list or tuple\")\n\n    if not isinstance(n, int) or n != len(arr):\n        raise ValueError(\"n must be integer equal to len(arr)\")\n\n    if len(arr) == 0:\n        raise ValueError(\"arr must not be empty\")\n\n    for x in arr:\n        if not isinstance(x, (int, float)):\n            raise TypeError(\"all elements of arr must be numeric (int or float)\")\n\n    current_sum = arr[0]\n    max_sum = arr[0]\n\n    for x in arr[1:]:\n        current_sum = max(x, current_sum + x)\n        max_sum = max(max_sum, current_sum)\n\n    return max_sum"}
{"task_id": "Mbpp/560", "solution": "def union_elements(a: tuple, b: tuple) -> tuple:\n    \"\"\"Finds the union of elements from two tuples, deduplicates them, sorts them, and returns the result as a new tuple.\"\"\"\n    if not isinstance(a, tuple):\n        raise TypeError(\"Input 'a' must be a tuple\")\n    if not isinstance(b, tuple):\n        raise TypeError(\"Input 'b' must be a tuple\")\n\n    unique_elements_list = []\n    hash_seen_set = set()\n    unhash_seen_list = []\n\n    # Iterate over all elements from both tuples for deduplication.\n    # Concatenating creates a new tuple, but is within acceptable complexity for this problem.\n    for item in a + b:\n        try:\n            # Attempt to hash the item; if successful, it's hashable.\n            hash(item)\n            if item not in hash_seen_set:\n                hash_seen_set.add(item)\n                unique_elements_list.append(item)\n        except TypeError:\n            # If a TypeError occurs, the item is unhashable.\n            # Check if it has been seen before using equality comparison.\n            is_seen_unhashable = False\n            for seen_item in unhash_seen_list:\n                if item == seen_item:\n                    is_seen_unhashable = True\n                    break\n            if not is_seen_unhashable:\n                unhash_seen_list.append(item)\n                unique_elements_list.append(item)\n\n    # Sort the unique elements.\n    try:\n        sorted_elements = sorted(unique_elements_list)\n    except TypeError:\n        # Catch and re-raise TypeError if elements cannot be compared for sorting.\n        raise TypeError(\"elements not comparable for sorting\")\n\n    # Return the result as a new tuple.\n    return tuple(sorted_elements)"}
{"task_id": "Mbpp/564", "solution": "def count_Pairs(lst, n):\n    \"\"\"\n    Counts the number of unordered pairs of unequal elements among the first min(n, len(lst)) elements.\n\n    Parameters:\n    - lst: list of integers\n    - n: int, number of elements from the start of lst to consider\n\n    Returns:\n    - int: count of unordered pairs (i < j) with lst[i] != lst[j]\n    \"\"\"\n    # Validate input types\n    if not isinstance(lst, list):\n        raise TypeError(\"lst must be a list\")\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an int\")\n    if n < 0:\n        raise ValueError(\"n must be non-negative\")\n\n    m = min(n, len(lst))\n\n    # Validate elements among the first m positions\n    for i in range(m):\n        if not isinstance(lst[i], int):\n            raise TypeError(\"all elements among the first m positions must be ints\")\n\n    if m < 2:\n        return 0\n\n    total_pairs = m * (m - 1) // 2\n\n    frequencies = {}\n    for i in range(m):\n        v = lst[i]\n        frequencies[v] = frequencies.get(v, 0) + 1\n\n    equal_pairs = sum(f * (f - 1) // 2 for f in frequencies.values())\n\n    return total_pairs - equal_pairs"}
{"task_id": "Mbpp/565", "solution": "def split(s):\n    \"\"\"Splits a string into a list of its individual characters.\"\"\"\n    return [c for c in s]"}
{"task_id": "Mbpp/563", "solution": "def extract_values(input_string):\n    \"\"\"\n    Extracts non-overlapping substrings enclosed by single (') or double (\") quotation marks.\n    Handles escaped quotes and ignores unmatched opening quotes.\n    \"\"\"\n    if not isinstance(input_string, str):\n        raise TypeError(\"input must be a string\")\n\n    results = []\n    buffer = []\n    state = \"OUT\"  # FSM States: \"OUT\" (not inside a quote), \"IN_QUOTE\"\n    quote_type = None  # Stores the type of the current opening quote (' or \")\n\n    i = 0\n    while i < len(input_string):\n        char = input_string[i]\n\n        if state == \"OUT\":\n            if char == '\"' or char == \"'\":\n                state = \"IN_QUOTE\"\n                quote_type = char\n                buffer = []  # Start new buffer for the new quoted value\n            # Characters outside quotes are ignored\n            i += 1\n        elif state == \"IN_QUOTE\":\n            if char == '\\\\':\n                # Handle escape sequence: consume the backslash and the next character\n                i += 1\n                if i < len(input_string):\n                    buffer.append(input_string[i])\n                else:\n                    # If string ends with an unescaped backslash, treat it as a literal\n                    buffer.append('\\\\')\n                i += 1\n            elif char == quote_type:\n                # Matching closing quote found, finish current extraction\n                results.append(\"\".join(buffer))\n                state = \"OUT\"\n                quote_type = None\n                i += 1\n            else:\n                # Regular character inside quotes\n                buffer.append(char)\n                i += 1\n\n    # If the loop ends while in IN_QUOTE state, it means the quote was unmatched;\n    # the buffer content is implicitly discarded as it was never appended to results.\n    return results"}
{"task_id": "Mbpp/566", "solution": "def sum_digits(n: int) -> int:\n    \"\"\"\n    Calculates the sum of the digits of a non-negative integer.\n    Raises ValidationError for invalid inputs.\n    \"\"\"\n    class ValidationError(Exception):\n        \"\"\"Custom exception for invalid input validation.\"\"\"\n        pass\n\n    def _validate_input(val: int) -> None:\n        \"\"\"Validates if val is a non-negative integer, raising ValidationError if not.\"\"\"\n        if not isinstance(val, int):\n            raise ValidationError(\"Input must be an integer.\")\n        if val < 0:\n            raise ValidationError(\"Input must be a non-negative integer.\")\n\n    def _digits_of(val: int) -> list[int]:\n        \"\"\"Extracts base-10 digits of a non-negative integer into a list.\"\"\"\n        if val == 0:\n            return [0]\n        return [int(digit) for digit in str(val)]\n\n    _validate_input(n)\n    digits = _digits_of(n)\n    return sum(digits)"}
{"task_id": "Mbpp/567", "solution": "def issort_list(seq) -> bool:\n    \"\"\"Checks if an iterable is sorted in non-decreasing order.\n    This function operates in O(n) time and O(1) additional space.\n\n    Examples:\n        >>> issort_list([1, 2, 4, 6, 8, 10, 12, 14, 16, 17])\n        True\n        >>> issort_list([1, 2, 2, 3])\n        True\n        >>> issort_list([])\n        True\n        >>> issort_list((5, 6, 7))\n        True\n        >>> issort_list([1, 5, 3])\n        False\n        >>> issort_list(x for x in [1, 3, 2])\n        False\n    \"\"\"\n    it = iter(seq)\n\n    try:\n        prev = next(it)\n    except StopIteration:\n        return True\n\n    while True:\n        try:\n            curr = next(it)\n        except StopIteration:\n            return True\n\n        try:\n            if prev <= curr:\n                prev = curr\n            else:\n                return False\n        except TypeError:\n            raise"}
{"task_id": "Mbpp/568", "solution": "from typing import List, Dict\n\ndef empty_list(N: int) -> list[dict]:\n    \"\"\"Creates a list containing N distinct empty dictionaries.\n    Each dictionary object in the returned list is unique.\n    \"\"\"\n    return [dict() for _ in range(N)]"}
{"task_id": "Mbpp/572", "solution": "def two_unique_nums(input_list) -> list:\n    \"\"\"Returns a list of integers that appear exactly once in the input, preserving original order.\n\n    Raises TypeError for invalid input_list type or non-integer elements.\n    \"\"\"\n    if not isinstance(input_list, list):\n        raise TypeError(\"input_list must be a list\")\n\n    for e in input_list:\n        if isinstance(e, bool) or not isinstance(e, int):\n            raise TypeError(\"all elements must be integers\")\n\n    freq = {}\n    for x in input_list:\n        freq[x] = freq.get(x, 0) + 1\n\n    result = [x for x in input_list if freq.get(x, 0) == 1]\n    return result"}
{"task_id": "Mbpp/569", "solution": "from typing import List\n\ndef sort_sublists(lists: List[List[str]]) -> List[List[str]]:\n    \"\"\"\n    Sorts each sublist of strings in a given list of lists lexicographically.\n    Performs input validation and returns a new list without modifying the input.\n\n    Examples:\n        >>> sort_sublists([['banana', 'apple'], ['dog', 'cat', 'cat']])\n        [['apple', 'banana'], ['cat', 'cat', 'dog']]\n        >>> sort_sublists([['z'], [], ['b', 'a']])\n        [['z'], [], ['a', 'b']]\n        >>> sort_sublists([])\n        []\n        >>> sort_sublists([['a', '\u00e1', 'a'], ['\u00df', 'ss']])\n        [['a', 'a', '\u00e1'], ['\u00df', 'ss']]\n    \"\"\"\n\n    def _validate_input(input_list):\n        if not isinstance(input_list, list):\n            raise TypeError(f\"input must be a list, got: {type(input_list)}\")\n\n    def _validate_sublist(sublist_to_validate, index: int):\n        if not isinstance(sublist_to_validate, list):\n            raise TypeError(f\"element at index {index} must be a list, got: {type(sublist_to_validate)}\")\n\n    def _validate_string_element(elem_to_validate, outer_index: int, inner_index: int):\n        if not isinstance(elem_to_validate, str):\n            raise TypeError(f\"element at index {outer_index},{inner_index} must be a string, got: {type(elem_to_validate)}\")\n\n    _validate_input(lists)\n\n    result: List[List[str]] = []\n    for k, sublist in enumerate(lists):\n        _validate_sublist(sublist, k)\n        for j, elem in enumerate(sublist):\n            _validate_string_element(elem, k, j)\n\n        # Create a shallow copy of the sublist and then sort it.\n        copy = list(sublist)\n        sorted_copy = sorted(copy)\n        result.append(sorted_copy)\n\n    return result"}
{"task_id": "Mbpp/573", "solution": "import math\n\ndef unique_product(numbers):\n    \"\"\"Calculates the product of the unique numbers in a given list.\"\"\"\n    unique_elements = set(numbers)\n\n    if not unique_elements:\n        return 1\n\n    return math.prod(unique_elements)"}
{"task_id": "Mbpp/577", "solution": "class ExceptionType(ValueError):\n    \"\"\"Domain wrapper for specific error messages.\"\"\"\n    pass\n\nclass Validator:\n    \"\"\"Responsible for validating input type and non-negativity.\"\"\"\n    def is_integer(self, value) -> bool:\n        return isinstance(value, int)\n\n    def is_non_negative(self, n: int) -> bool:\n        return n >= 0\n\nclass LookupTable:\n    \"\"\"Provides mapping for n in {0,1,2,3,4} to their factorial last digits.\"\"\"\n    def __init__(self):\n        self.values = {0: 1, 1: 1, 2: 2, 3: 6, 4: 4}\n\n    def get(self, n: int) -> int | None:\n        return self.values.get(n)\n\nclass Result:\n    \"\"\"Container for the computed last digit.\"\"\"\n    def __init__(self, digit: int):\n        self.digit = digit\n\nclass LastDigitFactorial:\n    \"\"\"Applies business rules to find the last decimal digit of n!.\"\"\"\n    def __init__(self):\n        self.validator = Validator()\n        self.lookup = LookupTable()\n\n    def compute(self, n: int) -> Result:\n        if not self.validator.is_integer(n):\n            raise ExceptionType(\"Input must be an integer.\")\n        if not self.validator.is_non_negative(n):\n            raise ExceptionType(\"Input must be a non-negative integer.\")\n\n        digit_from_lookup = self.lookup.get(n)\n        if digit_from_lookup is not None:\n            return Result(digit_from_lookup)\n        else: # n >= 5\n            return Result(0)\n\ndef last_Digit_Factorial(n) -> int:\n    \"\"\"Finds the last digit in factorial of a given number.\"\"\"\n    service = LastDigitFactorial()\n    result = service.compute(n)\n    return result.digit"}
{"task_id": "Mbpp/576", "solution": "def is_Sub_Array(arr, sub, comparator=None):\n    \"\"\"Checks if a list is a sublist (contiguous) of another.\n\n    Args:\n        arr: sequence to search within.\n        sub: sequence to search for.\n        comparator: optional object with equals(a, b) -> bool method for custom equality.\n\n    Returns:\n        True if `sub` is a contiguous sublist of `arr`, False otherwise.\n    \"\"\"\n    if arr is None or sub is None:\n        raise ValueError(\"arr and sub must not be None\")\n\n    if len(sub) == 0:\n        return True\n\n    if len(sub) > len(arr):\n        return False\n\n    if comparator is None:\n        _compare_elements = lambda a, b: a == b\n    else:\n        _compare_elements = comparator.equals\n\n    n = len(arr)\n    m = len(sub)\n\n    for i in range(n - m + 1):\n        match = True\n        for j in range(m):\n            if not _compare_elements(arr[i + j], sub[j]):\n                match = False\n                break\n        if match:\n            return True\n\n    return False"}
{"task_id": "Mbpp/578", "solution": "def interleave_lists(list_a: list, list_b: list, list_c: list) -> list:\n    \"\"\"Interleaves three lists of the same length into a single flat list.\n\n    The result order is: [a0, b0, c0, a1, b1, c1, ..., aN-1, bN-1, cN-1].\n\n    Raises:\n        TypeError: if any argument is not a list.\n        ValueError: if the input lists do not have the same length.\n\n    Time complexity: O(n), Space complexity: O(n) where n = len(list_a).\n    \"\"\"\n    if not isinstance(list_a, list) or not isinstance(list_b, list) or not isinstance(list_c, list):\n        raise TypeError(\"All arguments must be lists.\")\n\n    n = len(list_a)\n\n    if not (len(list_b) == n and len(list_c) == n):\n        raise ValueError(\"Input lists must have the same length.\")\n\n    result = [None] * (3 * n)\n    for i in range(n):\n        base_idx = 3 * i\n        result[base_idx] = list_a[i]\n        result[base_idx + 1] = list_b[i]\n        result[base_idx + 2] = list_c[i]\n\n    return result"}
{"task_id": "Mbpp/579", "solution": "from typing import Any, Tuple, Iterable\n\ndef _is_hashable(obj: Any) -> bool:\n    try:\n        hash(obj)\n        return True\n    except TypeError:\n        return False\n\ndef _equals(a: Any, b: Any) -> bool:\n    return a == b\n\ndef _hashable_symmetric_diff(tuple1: Tuple[Any, ...], tuple2: Tuple[Any, ...]) -> Tuple[Any, ...]:\n    set1 = set(tuple1)\n    set2 = set(tuple2)\n    symmetric_diff_members = (set1 - set2) | (set2 - set1)\n\n    result = []\n    seen_in_result = set()\n\n    for item in tuple1:\n        if item in symmetric_diff_members and item not in seen_in_result:\n            result.append(item)\n            seen_in_result.add(item)\n\n    for item in tuple2:\n        if item in symmetric_diff_members and item not in seen_in_result:\n            result.append(item)\n            seen_in_result.add(item)\n\n    return tuple(result)\n\ndef _equality_symmetric_diff(tuple1: Tuple[Any, ...], tuple2: Tuple[Any, ...]) -> Tuple[Any, ...]:\n    result = []\n    seen_in_result = []  # Stores elements added to result, for equality comparison\n\n    def _is_present_in_seq(item: Any, sequence: Iterable[Any]) -> bool:\n        for seq_item in sequence:\n            if _equals(item, seq_item):\n                return True\n        return False\n\n    def _is_in_result_list(item: Any, result_list: list) -> bool:\n        for res_item in result_list:\n            if _equals(item, res_item):\n                return True\n        return False\n\n    for item in tuple1:\n        if not _is_present_in_seq(item, tuple2):\n            if not _is_in_result_list(item, seen_in_result):\n                result.append(item)\n                seen_in_result.append(item)\n\n    for item in tuple2:\n        if not _is_present_in_seq(item, tuple1):\n            if not _is_in_result_list(item, seen_in_result):\n                result.append(item)\n                seen_in_result.append(item)\n\n    return tuple(result)\n\ndef find_dissimilar(tuple1: tuple, tuple2: tuple) -> tuple:\n    if not isinstance(tuple1, tuple):\n        raise TypeError(\"Input 'tuple1' must be a tuple.\")\n    if not isinstance(tuple2, tuple):\n        raise TypeError(\"Input 'tuple2' must be a tuple.\")\n\n    use_equality_path = False\n    for item in tuple1:\n        if not _is_hashable(item):\n            use_equality_path = True\n            break\n    if not use_equality_path:\n        for item in tuple2:\n            if not _is_hashable(item):\n                use_equality_path = True\n                break\n\n    if use_equality_path:\n        return _equality_symmetric_diff(tuple1, tuple2)\n    else:\n        return _hashable_symmetric_diff(tuple1, tuple2)"}
{"task_id": "Mbpp/583", "solution": "def catalan_number(n: int) -> int:\n    \"\"\"\n    Computes the nth Catalan number using the formula C_n = binomial(2n, n) // (n + 1).\n\n    Args:\n        n: non-negative integer index of the Catalan number.\n\n    Returns:\n        The nth Catalan number as an int.\n\n    Raises:\n        ValueError: if n is not a non-negative integer.\n    \"\"\"\n    if not isinstance(n, int) or n < 0:\n        raise ValueError(\"n must be a non-negative integer\")\n\n    def multiplicative_binomial(N: int, K: int) -> int:\n        \"\"\"Compute C(N, K) using an integer-only multiplicative method.\"\"\"\n        if K < 0 or K > N:\n            return 0\n        if K == 0 or K == N:\n            return 1\n        if K > N - K:\n            K = N - K\n        result = 1\n        for i in range(1, K + 1):\n            result = result * (N - K + i) // i\n        return result\n\n    # C_0 = 1\n    if n == 0:\n        return 1\n\n    binom = multiplicative_binomial(2 * n, n)\n    return binom // (n + 1)"}
{"task_id": "Mbpp/580", "solution": "def extract_even(data: tuple) -> tuple:\n    \"\"\"\n    Recursively removes odd integers from a nested tuple, preserving structure and order.\n    Non-integer, non-tuple elements are ignored during processing.\n    \"\"\"\n    if not isinstance(data, tuple):\n        raise TypeError(\"Input must be a tuple\")\n\n    def _is_even(n: int) -> bool:\n        \"\"\"Checks if an integer is even.\"\"\"\n        return n % 2 == 0\n\n    def _process_tuple(t: tuple) -> tuple:\n        \"\"\"Recursively processes a tuple, filtering out odd integers and handling nested tuples.\"\"\"\n        result_elems = []\n        for elem in t:\n            if isinstance(elem, int):\n                if _is_even(elem):\n                    result_elems.append(elem)\n            elif isinstance(elem, tuple):\n                rec_result = _process_tuple(elem)\n                result_elems.append(rec_result)\n            # Else: other types are ignored as per design.\n        return tuple(result_elems)\n\n    return _process_tuple(data)"}
{"task_id": "Mbpp/581", "solution": "import math\n\nclass Validator:\n    def validate_numeric(self, value, name: str) -> None:\n        \"\"\"Validates if a value is numeric (int or float), raising TypeError if not.\"\"\"\n        if not isinstance(value, (int, float)):\n            raise TypeError(f\"{name} must be numeric (int or float)\")\n\n    def validate_positive(self, value, name: str) -> None:\n        \"\"\"Validates if a value is positive, raising ValueError if not.\"\"\"\n        if value <= 0:\n            raise ValueError(f\"{name} must be > 0\")\n\nclass SquarePyramid:\n    def __init__(self, base_edge: float, height: float) -> None:\n        \"\"\"Initializes a SquarePyramid with its base edge and height.\"\"\"\n        self.base_edge = base_edge\n        self.height = height\n        self._slant_height = 0.0\n        self.surface_area = 0.0\n\n    def compute_slant_height(self) -> float:\n        \"\"\"Computes and stores the slant height of the pyramid.\"\"\"\n        l_squared = (self.base_edge / 2) ** 2 + self.height ** 2\n        self._slant_height = math.sqrt(l_squared)\n        return self._slant_height\n\n    def compute_surface_area(self) -> float:\n        \"\"\"Computes and stores the total surface area of the pyramid.\"\"\"\n        # A = base_edge^2 + 2 * base_edge * slant_height\n        self.surface_area = self.base_edge ** 2 + 2 * self.base_edge * self._slant_height\n        return self.surface_area\n\ndef surface_Area(base_edge, height) -> float:\n    \"\"\"\n    Calculates the total surface area of a square pyramid.\n\n    This function determines the surface area using the base edge and vertical height.\n    Formulas: l = sqrt((base_edge / 2)**2 + height**2); A = base_edge**2 + 2 * base_edge * l.\n\n    Parameters:\n        base_edge (int | float): The length of a base edge of the pyramid. Must be a positive number.\n        height (int | float): The vertical height of the pyramid. Must be a positive number.\n\n    Returns:\n        float: The calculated total surface area of the square pyramid.\n\n    Raises:\n        TypeError: If `base_edge` or `height` is not numeric (int or float).\n        ValueError: If `base_edge` or `height` is not greater than 0.\n    \"\"\"\n    validator = Validator()\n\n    validator.validate_numeric(base_edge, 'base_edge')\n    validator.validate_numeric(height, 'height')\n    validator.validate_positive(base_edge, 'base_edge')\n    validator.validate_positive(height, 'height')\n\n    pyramid = SquarePyramid(float(base_edge), float(height))\n    pyramid.compute_slant_height()\n    pyramid.compute_surface_area()\n\n    return float(pyramid.surface_area)"}
