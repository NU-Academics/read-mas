{"task_id": "Mbpp/455", "solution": "class Validator:\n    def validate_type(self, obj):\n        if not isinstance(obj, int):\n            raise TypeError(\"month_number must be an int\")\n\n    def validate_range(self, month_number):\n        if not (1 <= month_number <= 12):\n            raise ValueError(\"month_number must be in 1..12\")\n\nMONTHS_WITH_31_DAYS = frozenset({1, 3, 5, 7, 8, 10, 12})\n\ndef check_monthnumb_number(month_number):\n    \"\"\"\n    Checks if the given month number corresponds to a month with 31 days.\n    It validates input type and range before performing the check.\n    \"\"\"\n    validator = Validator()\n    validator.validate_type(month_number)\n    validator.validate_range(month_number)\n    return month_number in MONTHS_WITH_31_DAYS"}
{"task_id": "Mbpp/457", "solution": "from typing import List, Any\n\ndef Find_Min(lists: List[List[Any]]) -> List[Any]:\n    \"\"\"Finds the sublist with the minimum length from a list of lists.\n    Returns a reference to the first occurring sublist with minimal length.\n\n    Note: This function assumes `lists` is a non-empty list of lists.\n    \"\"\"\n    min_idx = 0\n    min_len = len(lists[0])\n\n    for i in range(1, len(lists)):\n        current_len = len(lists[i])\n        if current_len < min_len:\n            min_len = current_len\n            min_idx = i\n\n    return lists[min_idx]"}
