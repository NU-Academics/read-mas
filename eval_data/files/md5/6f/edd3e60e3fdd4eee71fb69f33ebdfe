{"task_id": "Mbpp/638", "solution": "import decimal\n\ndef wind_chill(v_kmh: float, T_c: float) -> int:\n    \"\"\"Calculates the wind chill index (W) in degrees Celsius.\n\n    Uses the Canadian wind-chill formula:\n    W = 13.12 + 0.6215 * T_c - 11.37 * (v_kmh ** 0.16) + 0.3965 * T_c * (v_kmh ** 0.16)\n\n    Parameters:\n        v_kmh (float): Wind speed in kilometers per hour (km/h). Must be >= 0.\n        T_c (float): Air temperature in degrees Celsius (\u00b0C).\n\n    Returns:\n        int: The wind chill index in \u00b0C, rounded using round-half-up semantics.\n\n    Applicability note:\n        The canonical formula is typically valid for T_c <= 10\u00b0C and v_kmh >= 4.8 km/h.\n        The function computes a numeric result for any numeric inputs; physical\n        meaning outside the canonical region should be interpreted by the caller.\n\n    Examples:\n        wind_chill(120, 35) == 40\n        wind_chill(0, 0) == 13\n\n    Raises:\n        TypeError: If either input is not numeric (int or float) or is a bool.\n        ValueError: If either input is NaN or infinite, or if v_kmh < 0.\n    \"\"\"\n    # Convert inputs to float to ensure consistency in calculations.\n    v = float(v_kmh)\n    T = float(T_c)\n\n    # Compute intermediate term for wind speed power.\n    v_pow = v ** 0.16\n\n    # Apply the Canadian wind-chill formula.\n    W = 13.12 + 0.6215 * T - 11.37 * v_pow + 0.3965 * T * v_pow\n\n    # Round using round-half-up semantics.\n    # Use Decimal to ensure deterministic half-up rounding.\n    rounded_W = int(decimal.Decimal(str(W)).quantize(decimal.Decimal('1'), rounding=decimal.ROUND_HALF_UP))\n\n    return rounded_W"}
{"task_id": "Mbpp/644", "solution": "def reverse_Array_Upto_K(arr, k) -> list:\n    \"\"\"\n    Reverses the first 'k' elements of a list, returning a new list.\n\n    Parameters:\n    - arr (list): Input list to operate on.\n    - k (int): Number of elements from the start to reverse.\n\n    Returns:\n    - list: A new list where the first k elements are reversed and the remainder are unchanged.\n\n    Raises:\n    - TypeError: if arr is not a list or k is not an integer.\n\n    Examples:\n    >>> reverse_Array_Upto_K([1, 2, 3, 4, 5, 6], 4)\n    [4, 3, 2, 1, 5, 6]\n\n    Time complexity: O(n) worst-case, where n = len(arr)\n    Space complexity: O(n) additional space for the returned list\n    \"\"\"\n    if not isinstance(arr, list):\n        raise TypeError(\"arr must be a list\")\n    if not isinstance(k, int):\n        raise TypeError(\"k must be an integer\")\n\n    if k <= 0:\n        return arr.copy()\n\n    if k >= len(arr):\n        return arr[::-1]\n\n    return arr[:k][::-1] + arr[k:]"}
{"task_id": "Mbpp/720", "solution": "def add_dict_to_tuple(source_tuple, mapping) -> tuple:\n    \"\"\"Adds a dictionary as the last element to a tuple.\n    Parameters:\n      source_tuple (tuple): The initial tuple.\n      mapping (dict): The dictionary to append (shallow-copied).\n    Returns:\n      A new tuple with the dictionary appended.\n    Raises:\n      TypeError: If source_tuple is not a tuple or mapping is not a dict.\n    Usage: add_dict_to_tuple((1, 2), {'a': 1}) -> (1, 2, {'a': 1})\n    \"\"\"\n    if type(source_tuple) is not tuple:\n        raise TypeError('source_tuple must be a tuple')\n    if type(mapping) is not dict:\n        raise TypeError('mapping must be a dict')\n\n    copied_mapping = mapping.copy()\n    new_tuple = source_tuple + (copied_mapping,)\n    return new_tuple"}
{"task_id": "Mbpp/721", "solution": "from typing import List\n\ndef maxAverageOfPath(matrix: List[List[float]]) -> float:\n    \"\"\"\n    Computes the maximum average cost path from top-left to bottom-right in a square matrix.\n    Paths can only move right or down.\n    \"\"\"\n    if not matrix or any(row is None or len(row) == 0 for row in matrix):\n        raise ValueError(\"matrix is empty or contains empty rows\")\n\n    n = len(matrix)\n    # Validate square and numeric entries\n    for i, row in enumerate(matrix):\n        if len(row) != n:\n            raise ValueError(\"matrix is not square\")\n        for j, val in enumerate(row):\n            if not isinstance(val, (int, float)):\n                raise TypeError(f\"non-numeric element at ({i},{j})\")\n\n    if n == 1:\n        return float(matrix[0][0])\n\n    # Initialize a 1D DP array to store maximum sums for the current row\n    dp = [0.0] * n\n\n    # Initialize the first row of the DP array\n    dp[0] = float(matrix[0][0])\n    for j in range(1, n):\n        dp[j] = dp[j-1] + float(matrix[0][j])\n\n    # Iterate through the remaining rows\n    for i in range(1, n):\n        dp[0] = dp[0] + float(matrix[i][0])\n        for j in range(1, n):\n            dp[j] = float(matrix[i][j]) + max(dp[j], dp[j-1])\n\n    max_sum = dp[n-1]\n    path_len = 2 * n - 1\n    return max_sum / path_len"}
{"task_id": "Mbpp/723", "solution": "def count_same_pair(list1, list2):\n    \"\"\"\n    Counts indices where the two input lists have the same values.\n    Assumes list1 and list2 are lists of equal length.\n    \"\"\"\n    count = 0\n    for i in range(len(list1)):\n        if list1[i] == list2[i]:\n            count += 1\n    return count"}
{"task_id": "Mbpp/722", "solution": "def filter_data(data, min_height, min_weight):\n    \"\"\"\n    Filters a dictionary of students based on height and weight criteria.\n    Includes students whose height is strictly greater than min_height\n    and weight is greater than or equal to min_weight.\n    \"\"\"\n    if not isinstance(min_height, (int, float)) or not isinstance(min_weight, (int, float)):\n        raise TypeError(\"min_height and min_weight must be numeric (int or float)\")\n\n    result = {}\n    for name, value in data.items():\n        if not isinstance(value, tuple) or len(value) != 2:\n            continue\n\n        height, weight = value\n\n        if not isinstance(height, (int, float)) or not isinstance(weight, (int, float)):\n            continue\n\n        if height > min_height and weight >= min_weight:\n            result[name] = value\n\n    return result"}
{"task_id": "Mbpp/726", "solution": "def multiply_elements(values: tuple) -> tuple:\n    \"\"\"\n    Computes pairwise products of adjacent elements in a tuple of numbers.\n    Input validation ensures the input is a tuple of at least two numbers.\n    \"\"\"\n    if not isinstance(values, tuple):\n        raise TypeError(\"values must be a tuple\")\n\n    n = len(values)\n    if n < 2:\n        raise ValueError(\"values must contain at least two elements\")\n\n    for x in values:\n        if not isinstance(x, (int, float)):\n            raise TypeError(\"all elements must be int or float\")\n\n    # Compute products and return a new tuple.\n    return tuple(values[i] * values[i+1] for i in range(n - 1))"}
{"task_id": "Mbpp/724", "solution": "def power_base_sum(base: int, power: int) -> int:\n    \"\"\"\n    Calculates the sum of all digits of the base to the specified power.\n    Raises TypeError if base or power are not integers, or ValueError if power is negative.\n    \"\"\"\n    if type(base) is not int:\n        raise TypeError(f\"Base must be an integer, but got {type(base).__name__}\")\n    if type(power) is not int:\n        raise TypeError(f\"Power must be an integer, but got {type(power).__name__}\")\n    if power < 0:\n        raise ValueError(\"Power must be a non-negative integer.\")\n\n    result = pow(base, power)\n    abs_result = abs(result)\n\n    digit_sum = 0\n    for digit_char in str(abs_result):\n        digit_sum += int(digit_char)\n\n    return digit_sum"}
{"task_id": "Mbpp/725", "solution": "from typing import List\nimport re\n\n# Module-level constant for the regex pattern.\n# This pattern matches a double quote not preceded by a backslash, captures content\n# which can include escaped characters (like \\\"), and then matches a closing\n# double quote not preceded by a backslash.\n_PATTERN: str = r'(?<!\\\\\\\\\\\\\\\\)\\\\\\\"((?:\\\\\\\\\\\\\\\\.|[^\\\\\\\"\\\\\\\\\\\\\\\\])*)\\\\\\\"'\n_COMPILED_PATTERN = re.compile(_PATTERN)\n\n\ndef extract_quotation(text: str) -> List[str]:\n    \"\"\"\n    Extracts values between double quotation marks from a given string.\n\n    Treats backslash-escaped quotes (\\\") as literal characters within content\n    and unescapes them in the returned substrings. Ignores unmatched quotes.\n\n    Args:\n        text: The input string to scan.\n\n    Returns:\n        A list of strings, where each string is the content found between\n        a matched pair of double quotes.\n\n    Raises:\n        TypeError: If the input 'text' is not a string.\n\n    Examples:\n        >>> extract_quotation('He said \"hello\" and left')\n        ['hello']\n        >>> extract_quotation('\"A \\\\\"B\\\\\" C\"')\n        ['A \"B\" C']\n        >>> extract_quotation('a \"\" b')\n        ['']\n        >>> extract_quotation('\"He said \\'hello\\'\"')\n        [\"He said 'hello'\"]\n        >>> extract_quotation('He said \"hello and left')\n        []\n        >>> extract_quotation('\\\\\"lonely\\\\\" \"ok\"')\n        ['ok']\n    \"\"\"\n    if not isinstance(text, str):\n        raise TypeError(\"text must be a str\")\n\n    results: List[str] = []\n    for match in _COMPILED_PATTERN.finditer(text):\n        raw_content = match.group(1)\n        unescaped_content = raw_content.replace('\\\\\"', '\"')\n        results.append(unescaped_content)\n\n    return results"}
{"task_id": "Mbpp/728", "solution": "def sum_list(a, b):\n    \"\"\"\n    Purpose:\n        Compute element-wise sums of two Python lists a and b.\n\n    Parameters:\n        a (list): first input list\n        b (list): second input list\n\n    Returns:\n        list: new list where result[i] == a[i] + b[i] for i in range(len(a))\n\n    Raises:\n        TypeError: if a or b is not a list, or if any element pair cannot be added\n        ValueError: if len(a) != len(b)\n\n    Algorithm summary:\n        1. Validate inputs are list instances (isinstance(..., list)); raise TypeError otherwise.\n        2. Validate lengths equal; raise ValueError if not.\n        3. Iterate once over indices 0..n-1:\n             try:\n                 s = a[i] + b[i]\n             except TypeError:\n                 raise TypeError(f\"Elements at index {i} cannot be added: {a[i]!r} + {b[i]!r}\")\n             append s to result list\n        4. Return result list\n\n    Complexity:\n        Time: O(n) where n == len(a) == len(b)\n        Space: O(n) additional (result list)\n\n    Examples:\n        assert sum_list([1, 2], [3, 4]) == [4, 6]\n    \"\"\"\n\n    if not isinstance(a, list):\n        raise TypeError(\"Input 'a' must be a list.\")\n    if not isinstance(b, list):\n        raise TypeError(\"Input 'b' must be a list.\")\n\n    if len(a) != len(b):\n        raise ValueError(\"Input lists 'a' and 'b' must have the same length.\")\n\n    result = []\n    for i in range(len(a)):\n        try:\n            s = a[i] + b[i]\n            result.append(s)\n        except TypeError as e:\n            raise TypeError(f\"Elements at index {i} cannot be added: {a[i]!r} + {b[i]!r}\") from e\n\n    return result"}
