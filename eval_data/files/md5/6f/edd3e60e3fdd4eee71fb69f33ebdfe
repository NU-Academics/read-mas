{"task_id": "Mbpp/222", "solution": "def check_type(t: tuple) -> bool:\n    \"\"\"Checks if all elements in tuple `t` have the same runtime data type using `type(x)` equality.\n\n    Returns True for empty or single-element tuples and raises TypeError for non-tuple input.\n    Implements an O(n) time, O(1) extra space algorithm by comparing each element's type to the first element's type.\n\n    Parameters:\n    - t: tuple -- the input tuple to check\n\n    Returns:\n    - bool -- True if all elements share the same type, False otherwise\n\n    Raises:\n    - TypeError -- if `t` is not an instance of tuple\n    \"\"\"\n    if not isinstance(t, tuple):\n        raise TypeError(\"check_type: input must be a tuple\")\n\n    if len(t) <= 1:\n        return True\n\n    first_type = type(t[0])\n    for item in t[1:]:\n        if type(item) is not first_type:\n            return False\n    return True"}
{"task_id": "Mbpp/223", "solution": "def is_majority(arr, n, element):\n    \"\"\"\n    Checks if an element is the majority element in the first 'n' elements of a sorted array.\n    A majority element occurs more than n/2 times.\n    \"\"\"\n    if n <= 0:\n        return False\n\n    # Helper function to find the index of the first occurrence of `element` in `arr[0...n-1]`.\n    # Returns -1 if the element is not found.\n    def _find_first_occurrence(arr_segment, length, target):\n        low = 0\n        high = length  # Exclusive upper bound for binary search\n        first_idx = -1\n\n        while low < high:\n            mid = low + (high - low) // 2\n            if arr_segment[mid] == target:\n                first_idx = mid\n                high = mid  # Try to find an earlier occurrence in the left half\n            elif arr_segment[mid] < target:\n                low = mid + 1\n            else:  # arr_segment[mid] > target\n                high = mid\n        return first_idx\n\n    first_occurrence_idx = _find_first_occurrence(arr, n, element)\n\n    if first_occurrence_idx == -1:\n        return False  # Element not found in the array segment\n\n    # If the element is a majority element, then the element at `first_occurrence_idx + n // 2`\n    # must also be the same element and within the array bounds.\n    # This efficiently checks if there are more than n/2 occurrences.\n    candidate_check_idx = first_occurrence_idx + n // 2\n\n    if candidate_check_idx < n and arr[candidate_check_idx] == element:\n        return True\n    else:\n        return False"}
{"task_id": "Mbpp/226", "solution": "def odd_values_string(s: str) -> str:\n    \"\"\"\n    Returns a new string containing characters from the input string at even indices (0, 2, 4, ...).\n    Example: odd_values_string('abcdef') == 'ace'.\n    \"\"\"\n    if not isinstance(s, str):\n        raise TypeError(\"s must be a str\")\n    return ''.join([s[i] for i in range(0, len(s), 2)])"}
{"task_id": "Mbpp/224", "solution": "def count_Set_Bits(n: int) -> int:\n    \"\"\"Counts the number of set bits (1s) in the binary representation of a non-negative integer.\n    It uses the built-in int.bit_count() when available, otherwise falls back to\n    Brian Kernighan's algorithm.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"Input must be an integer.\")\n    if n < 0:\n        raise ValueError(\"Input must be a non-negative integer.\")\n\n    if hasattr(int, \"bit_count\"):\n        return n.bit_count()\n    # Brian Kernighan's algorithm\n    count = 0\n    while n:\n        n &= n - 1\n        count += 1\n    return count"}
{"task_id": "Mbpp/230", "solution": "def replace_blank(string, character) -> str:\n    \"\"\"Replace ASCII spaces in `string` with `character`.\n\n    Signature:\n        replace_blank(string, character) -> str\n\n    Parameters:\n        string (str): input text; must be a str (TypeError if not)\n        character (str): single-character replacement; must be str of length 1\n\n    Returns:\n        str: new string where each ASCII space (U+0020) is replaced by `character`.\n\n    Raises:\n        TypeError: if `string` is not a str, or `character` is not a str\n        ValueError: if `character` is a str whose length != 1\n\n    Examples:\n        assert replace_blank(\"hello people\", \"@\") == \"hello@people\"\n    \"\"\"\n    if not isinstance(string, str):\n        raise TypeError(\"`string` must be of type str\")\n    if not isinstance(character, str):\n        raise TypeError(\"`character` must be of type str\")\n    if len(character) != 1:\n        raise ValueError(\"`character` must be a single character string\")\n\n    result_chars = []\n    for char in string:\n        if char == ' ':\n            result_chars.append(character)\n        else:\n            result_chars.append(char)\n    return ''.join(result_chars)"}
