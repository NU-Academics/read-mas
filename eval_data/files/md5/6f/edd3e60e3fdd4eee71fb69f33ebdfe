{"task_id": "Mbpp/731", "solution": "import math\n\ndef lateralsurface_cone(r, h):\n    \"\"\"Calculates the lateral surface area of a cone.\n    The formula is A = pi * r * s, where s is the slant height sqrt(r^2 + h^2).\n\n    Examples:\n        >>> lateralsurface_cone(5, 12)\n        204.20352248333654\n        >>> lateralsurface_cone(3, 4)\n        37.69911184307752\n        >>> lateralsurface_cone(0, 5)\n        0.0\n        >>> lateralsurface_cone(2, 0)\n        12.566370614359172\n    \"\"\"\n    if not isinstance(r, (int, float)) or not isinstance(h, (int, float)):\n        raise TypeError(\"r and h must be numeric (int or float)\")\n\n    r_f = float(r)\n    h_f = float(h)\n\n    if r_f < 0.0:\n        raise ValueError(\"r must be non-negative\")\n    if h_f < 0.0:\n        raise ValueError(\"h must be non-negative\")\n\n    if r_f == 0.0:\n        return 0.0\n\n    s = math.sqrt(r_f * r_f + h_f * h_f)\n    lateral_area = math.pi * r_f * s\n\n    return lateral_area"}
{"task_id": "Mbpp/733", "solution": "def find_first_occurrence(nums: list[int], target: int) -> int:\n    if not nums:\n        return -1\n\n    low = 0\n    high = len(nums) - 1\n    result = -1\n\n    while low <= high:\n        mid = (low + high) // 2\n        if nums[mid] < target:\n            low = mid + 1\n        elif nums[mid] > target:\n            high = mid - 1\n        else:  # nums[mid] == target\n            result = mid\n            high = mid - 1  # Bias left to find the first occurrence\n\n    return result"}
{"task_id": "Mbpp/735", "solution": "def toggle_middle_bits(n: int) -> int:\n    \"\"\"\n    Toggles all bits of the number except the first (MSB) and the last (LSB) bit.\n    For numbers with fewer than two bits (0 or 1), the number is returned unchanged.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an int\")\n    if n < 0:\n        raise ValueError(\"n must be non-negative\")\n\n    b = n.bit_length()\n    if b < 2:\n        return n\n\n    # The most significant bit is at index b - 1.\n    msb_index = b - 1\n\n    # Create a mask where bits from 1 to msb_index-1 are set to 1, and MSB and LSB are 0.\n    # ((1 << msb_index) - 1) creates a number with bits 0 through msb_index-1 set.\n    # XORing with 1 clears the LSB (bit 0), leaving bits 1 through msb_index-1 set.\n    mask = ((1 << msb_index) - 1) ^ 1\n\n    # Toggle the bits of n using the generated mask.\n    return n ^ mask"}
{"task_id": "Mbpp/736", "solution": "def left_insertion(a, x):\n    \"\"\"\n    Locates the left insertion point for value x in a sorted sequence a.\n    This function implements an iterative binary search equivalent to bisect.bisect_left.\n    \"\"\"\n    lo = 0\n    hi = len(a)\n\n    while lo < hi:\n        mid = (lo + hi) // 2\n        if a[mid] < x:\n            lo = mid + 1\n        else:\n            hi = mid\n    return lo"}
{"task_id": "Mbpp/737", "solution": "import re\n\n# Module-level pre-compiled regex for efficiency, as per design.\n_PATTERN: str = '^[aeiou]'\n_FLAGS: int = re.IGNORECASE\n_COMPILED: re.Pattern = re.compile(_PATTERN, _FLAGS)\n\ndef check_str(s: str) -> bool:\n    \"\"\"\n    Checks if the given string starts with an ASCII vowel using a case-insensitive regex.\n    Raises TypeError if input is not a string. Returns False for an empty string.\n    \"\"\"\n    if not isinstance(s, str):\n        raise TypeError(\"input must be a string\")\n\n    if s == \"\":\n        return False\n\n    # Check only the first character for O(1) performance as specified in design.\n    first_char = s[:1]\n    return bool(_COMPILED.match(first_char))"}
{"task_id": "Mbpp/734", "solution": "def sum_Of_Subarray_Prod(nums):\n    \"\"\"\n    Calculates the sum of products of all possible contiguous subarrays using a zero-splitting optimization.\n    Subarrays that include zero contribute 0 and are therefore skipped by splitting on zeros.\n    \"\"\"\n    total_sum = 0\n\n    segments = []\n    current_segment = []\n    for x in nums:\n        if x == 0:\n            if current_segment:\n                segments.append(current_segment)\n            current_segment = []\n        else:\n            current_segment.append(x)\n    if current_segment:\n        segments.append(current_segment)\n\n    for seg in segments:\n        len_seg = len(seg)\n        for i in range(len_seg):\n            running_product = 1\n            for j in range(i, len_seg):\n                running_product *= seg[j]\n                total_sum += running_product\n\n    return total_sum"}
{"task_id": "Mbpp/740", "solution": "def tuple_to_dict(input_tuple):\n    \"\"\"\n    Converts a tuple to a dictionary using adjacent elements as key-value pairs.\n    Handles type, length, and hashability checks, returning a new dictionary.\n    \"\"\"\n    if not isinstance(input_tuple, tuple):\n        raise TypeError(\"input must be a tuple\")\n\n    n = len(input_tuple)\n    if n % 2 != 0:\n        raise ValueError(\"tuple length must be even\")\n\n    result_dict = {}\n    for i in range(0, n, 2):\n        key = input_tuple[i]\n        value = input_tuple[i+1]\n\n        try:\n            hash(key)\n        except TypeError:\n            raise TypeError(\"unhashable key\")\n\n        result_dict[key] = value\n\n    return result_dict"}
{"task_id": "Mbpp/739", "solution": "def _isqrt(x: int) -> int:\n    # Computes the integer floor square root of x using Newton's method.\n    if x < 0:\n        raise ValueError(\"isqrt() argument must be nonnegative\")\n    if x == 0:\n        return 0\n    y = 1 << ((x.bit_length() + 1) // 2)  # Initial guess for Newton's method\n    while True:\n        next_y = (y + x // y) // 2\n        if next_y >= y:  # Converged\n            break\n        y = next_y\n    # Ensure y is the floor(sqrt(x))\n    while (y + 1) * (y + 1) <= x:\n        y += 1\n    while y * y > x:\n        y -= 1\n    return y\n\ndef _triangular(k: int) -> int:\n    # Computes the k-th triangular number.\n    return k * (k + 1) // 2\n\ndef find_Index(n: int) -> int:\n    \"\"\"\n    Finds the index k of the smallest triangular number with exactly n digits.\n    \"\"\"\n    # Validate input as per design context\n    if not isinstance(n, int) or n < 1:\n        raise ValueError(\"n must be an integer and >= 1\")\n\n    # Smallest n-digit number is 10^(n-1)\n    target = 10 ** (n - 1)\n\n    # Calculate the discriminant for the quadratic relation: (2k+1)^2 >= 8*target + 1\n    discriminant = 8 * target + 1\n\n    # Compute the integer floor square root of the discriminant\n    s = _isqrt(discriminant)\n\n    # Calculate an initial candidate for k using the derived formula: k = ceil((sqrt(discriminant)-1)/2)\n    k0 = (s - 1) // 2\n\n    # Adjust k0 if the triangular number for k0 is less than the target.\n    # This handles the ceiling operation correctly.\n    if _triangular(k0) < target:\n        k = k0 + 1\n    else:\n        k = k0\n\n    return k"}
{"task_id": "Mbpp/741", "solution": "def all_Characters_Same(s: str) -> bool:\n    \"\"\"Checks if all characters in a string are identical.\n\n    Args:\n        s: The input string to check.\n\n    Returns:\n        True if s is empty or all characters in s are the same, False otherwise.\n\n    Raises:\n        TypeError: If s is not a str.\n    \"\"\"\n    if not isinstance(s, str):\n        raise TypeError(\"s must be a str\")\n\n    if len(s) <= 1:\n        return True\n\n    first_char = s[0]\n    for char in s[1:]:\n        if char != first_char:\n            return False\n    return True"}
{"task_id": "Mbpp/742", "solution": "import math\n\ndef area_tetrahedron(side):\n    \"\"\"\n    Calculates the total surface area of a regular tetrahedron given its side length.\n    Raises ValueError for invalid inputs (non-numeric, NaN, Infinity, negative).\n    \"\"\"\n    # Validate input: must be numeric (int or float), finite (not NaN/Infinity), and non-negative (>= 0).\n    if not isinstance(side, (int, float)) or math.isnan(side) or math.isinf(side) or side < 0:\n        raise ValueError(\"Invalid side: must be numeric, finite, and non-negative\")\n\n    # If the side length is zero, the area is 0.0.\n    if side == 0:\n        return 0.0\n\n    # Calculate the area using the formula A = sqrt(3) * a^2.\n    area = math.sqrt(3) * (side ** 2)\n    return area"}
{"task_id": "Mbpp/743", "solution": "def rotate_right(lst: List[T], n: int) -> List[T]:\n    \"\"\"\n    Rotate a list to the right by a specified number of positions.\n\n    Args:\n        lst: The input list to rotate. Must be a list instance.\n        n: Number of positions to rotate right. If n <= 0, a shallow copy of lst is returned. If n > len(lst), effective rotation is n % len(lst).\n\n    Returns:\n        A new list containing the elements of lst rotated to the right by the effective shift amount.\n\n    Raises:\n        TypeError: If lst is not a list (message: \"lst must be a list\").\n        TypeError: If n is not an int (message: \"n must be an int\").\n\n    Examples:\n        >>> rotate_right([1, 2, 3, 4, 5], 2)\n        [4, 5, 1, 2, 3]\n\n        >>> rotate_right([1, 2, 3], 5)  # 5 % 3 == 2\n        [2, 3, 1]\n\n        >>> rotate_right([1, 2], 0)  # returns shallow copy\n        [1, 2]\n\n    Complexity:\n        Time: O(n) where n = len(lst).\n        Space: O(n) extra \u2014 a new list of size n is allocated and returned.\n    \"\"\"\n    # Input validation\n    if not isinstance(lst, list):\n        raise TypeError(\"lst must be a list\")\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an int\")\n\n    length = len(lst)\n\n    # Empty list -> return a new empty list\n    if length == 0:\n        return []\n\n    # Non-positive rotation -> return shallow copy (no mutation)\n    if n <= 0:\n        return lst.copy()\n\n    # Normalize rotation to [0, length-1]\n    k = n % length\n\n    if k == 0:\n        return lst.copy()\n\n    # Slicing-based rotation\n    return lst[-k:] + lst[:-k]"}
{"task_id": "Mbpp/744", "solution": "def check_none(tuple_value: tuple) -> bool:\n    \"\"\"Checks if the given tuple has any None value at the top level.\n    Returns True if any top-level element is None, False otherwise.\n    \"\"\"\n    for element in tuple_value:\n        if element is None:\n            return True\n    return False"}
{"task_id": "Mbpp/748", "solution": "def capital_words_spaces(input_str: str) -> str:\n    \"\"\"Inserts spaces into a string at capitalization boundaries, applying specific regex rules.\n    Assumes 'acronym_sep' and 'camel_sep' re.Pattern objects are pre-compiled at module level.\"\"\"\n    if not input_str:\n        return \"\"\n\n    # Apply acronym separation: e.g., \"HTTPServer\" -> \"HTTP Server\"\n    # Pattern: (?<=[A-Z])(?=[A-Z][a-z])\n    # Inserts space between an uppercase letter and a following capitalized word (uppercase then lowercase).\n    s = acronym_sep.sub(' ', input_str)\n\n    # Apply camelCase splitting: e.g., \"myVariableName\" -> \"my Variable Name\"\n    # Pattern: (?<=[a-z0-9])(?=[A-Z])\n    # Inserts space between a lowercase letter or digit and a following uppercase letter.\n    s = camel_sep.sub(' ', s)\n\n    return s"}
{"task_id": "Mbpp/745", "solution": "def divisible_by_digits(startnum: int, endnum: int) -> list[int]:\n    \"\"\"\n    Finds numbers within a given range where every number is divisible by every digit it contains.\n    Numbers containing the digit 0 are excluded.\n    \"\"\"\n    if not isinstance(startnum, int) or not isinstance(endnum, int):\n        raise TypeError(\"startnum and endnum must be integers.\")\n    if startnum > endnum:\n        raise ValueError(\"startnum must be less than or equal to endnum.\")\n\n    results = []\n    for n in range(startnum, endnum + 1):\n        if n == 0:\n            # The number 0 is excluded as it contains the digit 0.\n            continue\n\n        abs_n = abs(n)\n        s_abs_n = str(abs_n)\n\n        # Exclude numbers that contain the digit 0.\n        if '0' in s_abs_n:\n            continue\n\n        digits = [int(char) for char in s_abs_n]\n\n        is_divisible_by_all_digits = True\n        for digit in digits:\n            # All digits are guaranteed non-zero here, so no division-by-zero risk.\n            if abs_n % digit != 0:\n                is_divisible_by_all_digits = False\n                break\n\n        if is_divisible_by_all_digits:\n            results.append(n)\n\n    return results"}
{"task_id": "Mbpp/749", "solution": "from typing import List\n\ndef sort_numeric_strings(items: List[str]) -> List[str]:\n    \"\"\"\n    Sorts a list of strings of numbers numerically, returning a new list of trimmed strings.\n    Validates input and raises ValueError for type or parsing errors.\n    \"\"\"\n    if not isinstance(items, list):\n        raise ValueError(\"items must be a list of str\")\n\n    if not items:\n        return []\n\n    type_errors = []\n    for i, item in enumerate(items):\n        if item is None or not isinstance(item, str):\n            type_errors.append((i, item))\n\n    if type_errors:\n        raise ValueError(f\"Non-str or None elements at indices: {type_errors}\")\n\n    parsed_data = []\n    parse_errors = []\n    for i, original_value in enumerate(items):\n        trimmed_value = original_value.strip()\n        try:\n            numeric_value = float(trimmed_value)\n            parsed_data.append((numeric_value, i, trimmed_value))\n        except ValueError:\n            parse_errors.append((i, trimmed_value))\n\n    if parse_errors:\n        raise ValueError(f\"Unparseable trimmed values at indices: {parse_errors}\")\n\n    # Stable sort by numeric value, then original index for ties\n    sorted_keys = sorted(parsed_data, key=lambda t: (t[0], t[1]))\n\n    # Extract the trimmed strings in sorted order\n    output = [trimmed for (value, index, trimmed) in sorted_keys]\n\n    return output"}
{"task_id": "Mbpp/751", "solution": "def check_min_heap(arr: list) -> bool:\n    \"\"\"\n    Checks if the given array represents a min-heap.\n    An empty list or a single-element list is considered a valid min-heap.\n\n    Time complexity: O(n)\n    Space complexity: O(1)\n    \"\"\"\n    def _validate_input(arr_input) -> None:\n        if not isinstance(arr_input, list):\n            raise TypeError(\"Input 'arr' must be a list.\")\n\n    def _compare(parent, child) -> bool:\n        try:\n            return parent <= child\n        except TypeError as exc:\n            raise TypeError(\n                f\"Elements of the array must be comparable. Failed to compare {parent!r} and {child!r}.\"\n            ) from exc\n\n    _validate_input(arr)\n    n = len(arr)\n\n    # Empty or single-element lists are valid min-heaps\n    if n <= 1:\n        return True\n\n    # Iterate only through parent nodes\n    for i in range(n // 2):\n        parent_val = arr[i]\n\n        # Check left child\n        left_child_idx = 2 * i + 1\n        if not _compare(parent_val, arr[left_child_idx]):\n            return False\n\n        # Check right child, if it exists\n        right_child_idx = 2 * i + 2\n        if right_child_idx < n:\n            if not _compare(parent_val, arr[right_child_idx]):\n                return False\n\n    return True"}
{"task_id": "Mbpp/750", "solution": "def add_tuple(lst, tup):\n    \"\"\"\n    Adds elements of a tuple to a new list containing the original list's elements.\n    Returns a new list without modifying the original.\n    \"\"\"\n    new_list = lst.copy()\n    new_list.extend(tup)\n    return new_list"}
