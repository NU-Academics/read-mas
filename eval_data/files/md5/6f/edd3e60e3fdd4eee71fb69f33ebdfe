{"task_id": "Mbpp/629", "solution": "from typing import List, Union\n\ndef Split(numbers: List[Union[int, float]]) -> List[Union[int, float]]:\n    \"\"\"Filters a list of numbers, returning a new list containing only even elements.\n\n    Args:\n        numbers: A list of integers or floats.\n\n    Returns:\n        A new list containing only the even numbers from the input list, preserving order.\n\n    Raises:\n        TypeError: If 'numbers' is not a list, or if any element is not a valid int or float.\n                   (Boolean values are treated as invalid elements.)\n\n    Complexity:\n        Time: O(n), where n is the length of the input list.\n        Space: O(k) additional, where k is the number of even elements returned.\n    \"\"\"\n    if not isinstance(numbers, list):\n        raise TypeError(\"numbers must be a list\")\n\n    result: List[Union[int, float]] = []\n    for idx, elem in enumerate(numbers):\n        if isinstance(elem, bool):  # Explicitly exclude bools\n            raise TypeError(f\"element at index {idx} is not int or float\")\n        if not isinstance(elem, (int, float)):\n            raise TypeError(f\"element at index {idx} is not int or float\")\n\n        if isinstance(elem, int):\n            if elem % 2 == 0:\n                result.append(elem)\n        else:  # elem is a float\n            if elem.is_integer() and int(elem) % 2 == 0:\n                result.append(elem)\n    return result"}
{"task_id": "Mbpp/630", "solution": "def get_coordinates(coordinate: tuple[int, int] | list[int, int]) -> list[list[int]]:\n    \"\"\"\n    Extracts all adjacent coordinates for a given (row, column) tuple or list.\n    Returns nine newly constructed [row, column] lists in row-major order.\n    \"\"\"\n    row, col = coordinate[0], coordinate[1]\n    neighbors = []\n    for dr in (-1, 0, 1):\n        for dc in (-1, 0, 1):\n            neighbors.append([row + dr, col + dc])\n    return neighbors"}
{"task_id": "Mbpp/632", "solution": "def move_zero(arr: list[int]) -> list[int]:\n    \"\"\"Moves all zeros in-place to the end of the given list, preserving the relative order of non-zero elements.\"\"\"\n    if not arr:\n        return arr\n\n    write_index = 0\n    for read_index in range(len(arr)):\n        if arr[read_index] != 0:\n            arr[write_index] = arr[read_index]\n            write_index += 1\n\n    for i in range(write_index, len(arr)):\n        arr[i] = 0\n\n    return arr"}
{"task_id": "Mbpp/631", "solution": "def replace_spaces(input: str) -> str:\n    \"\"\"\n    Replaces whitespaces with an underscore and vice versa in a given string.\n    Each character is processed atomically to prevent double-replacement.\n    \"\"\"\n    if not input:\n        return \"\"\n\n    result_chars = []\n    for char in input:\n        if char == '_':\n            result_chars.append(' ')\n        elif char.isspace():\n            result_chars.append('_')\n        else:\n            result_chars.append(char)\n\n    return ''.join(result_chars)"}
{"task_id": "Mbpp/635", "solution": "def heap_sort(lst):\n    \"\"\"\n    Sorts a list in ascending order in-place using the heap sort algorithm.\n    \"\"\"\n    n = len(lst)\n    if n < 2:\n        return None\n\n    # Helper function to restore the max-heap property\n    def _sift_down(current_list, i, heap_size):\n        while True:\n            left = 2 * i + 1\n            right = left + 1\n            largest = i\n\n            if left < heap_size and current_list[left] > current_list[largest]:\n                largest = left\n            if right < heap_size and current_list[right] > current_list[largest]:\n                largest = right\n\n            if largest == i:\n                break\n\n            current_list[i], current_list[largest] = current_list[largest], current_list[i]\n            i = largest\n\n    # Build a max-heap (bottom-up heapify)\n    start = (n // 2) - 1\n    for i in range(start, -1, -1):\n        _sift_down(lst, i, n)\n\n    # Extract elements one by one from the heap\n    heap_size = n\n    for end in range(n - 1, 0, -1):\n        lst[0], lst[end] = lst[end], lst[0]  # Move current max to its final position\n        heap_size -= 1\n        _sift_down(lst, 0, heap_size)\n\n    return None"}
{"task_id": "Mbpp/633", "solution": "def pair_xor_Sum(arr, n):\n    if not isinstance(arr, list):\n        raise TypeError(\"arr must be a list\")\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an int\")\n    for i, x in enumerate(arr):\n        if not isinstance(x, int):\n            raise TypeError(f\"arr[{i}] is not an int\")\n    if n != len(arr):\n        raise ValueError(\"n does not match length of arr\")\n    if n < 2:\n        return 0\n\n    has_negative = any(x < 0 for x in arr)\n\n    if has_negative:\n        min_allowed = -(1 << 63)\n        max_allowed = (1 << 63) - 1\n        for x in arr:\n            if x < min_allowed or x > max_allowed:\n                raise OverflowError(\"value out of signed 64-bit range\")\n        B = 64\n    else:\n        max_val = max(arr) if arr else 0\n        B = max(1, max_val.bit_length())\n\n    counts = [0] * B\n    mask64 = (1 << 64) - 1\n\n    for x in arr:\n        pattern = (x & mask64) if has_negative else x\n        for b in range(B):\n            if (pattern >> b) & 1:\n                counts[b] += 1\n\n    total = 0\n    for b, ones in enumerate(counts):\n        zeros = n - ones\n        total += ones * zeros * (1 << b)\n\n    return total"}
{"task_id": "Mbpp/639", "solution": "def sample_nam(names):\n    \"\"\"\n    Sums the lengths of names after filtering out those that start with a lowercase letter.\n    \"\"\"\n\n    def validate_input(names_list):\n        \"\"\"Ensures the input is a list of strings, raising TypeError on invalid types.\"\"\"\n        if not isinstance(names_list, list):\n            raise TypeError(\"names must be a list\")\n        for i, name_item in enumerate(names_list):\n            if not isinstance(name_item, str):\n                raise TypeError(f\"element at index {i} is not a string\")\n\n    def filter_names(names_list):\n        \"\"\"Yields names that do not start with an ASCII lowercase letter.\"\"\"\n        for name_item in names_list:\n            if not name_item or not ('a' <= name_item[0] <= 'z'):\n                yield name_item\n\n    def compute_sum(filtered_names_iter):\n        \"\"\"Calculates the sum of lengths for names in an iterable.\"\"\"\n        total_length = 0\n        for name_item in filtered_names_iter:\n            total_length += len(name_item)\n        return total_length\n\n    validate_input(names)\n    filtered_names_generator = filter_names(names)\n    return compute_sum(filtered_names_generator)"}
{"task_id": "Mbpp/637", "solution": "def noprofit_noloss(amount1, amount2, tolerance=1e-9):\n    \"\"\"\n    Checks if two monetary amounts are equal within a given tolerance, indicating \"no profit and no loss\".\n\n    Supports int, float, and Decimal inputs. Returns True when abs(amount1 - amount2) <= tolerance.\n    Special cases:\n      - If either amount is NaN (float or Decimal), returns False.\n      - If either amount is infinite, returns True only if both are the same infinity (+inf/+inf or -inf/-inf).\n      - If either input is Decimal, Decimal arithmetic is used. Floats converted to Decimal via Decimal(str(...)).\n    Tolerance must be non-negative.\n\n    Examples:\n      noprofit_noloss(100, 100) -> True\n      noprofit_noloss(1.0000000005, 1.0) -> True (within default tolerance)\n      noprofit_noloss(1500, 1200) -> False\n    \"\"\"\n    from decimal import Decimal, InvalidOperation\n    import math\n    from typing import Tuple, Union\n\n    def _validate_numeric(value):\n        \"\"\"Raises TypeError if value is not an int, float, or Decimal.\"\"\"\n        if not isinstance(value, (int, float, Decimal)):\n            raise TypeError(f\"Unsupported type for amount: {type(value)}. Must be int, float, or Decimal.\")\n\n    def _is_nan(value):\n        \"\"\"Detects NaN for float and Decimal types.\"\"\"\n        if isinstance(value, float):\n            return math.isnan(value)\n        if isinstance(value, Decimal):\n            return value.is_nan()\n        return False\n\n    def _is_infinite(value):\n        \"\"\"Returns +1 for +infinity, -1 for -infinity, 0 for finite values.\"\"\"\n        if isinstance(value, float):\n            if math.isinf(value):\n                return 1 if value > 0 else -1\n        if isinstance(value, Decimal):\n            if value.is_infinite():\n                return 1 if value > 0 else -1\n        return 0\n\n    def _normalize_for_decimal(a, b, tol) -> Tuple[Union[int, float, Decimal], Union[int, float, Decimal], Union[float, Decimal], bool]:\n        \"\"\"Normalizes amounts and tolerance for comparison, preferring Decimal arithmetic when appropriate.\"\"\"\n        use_decimal = False\n        a_norm, b_norm, tol_norm = a, b, tol\n\n        # Check if Decimal arithmetic is required\n        if isinstance(a, Decimal) or isinstance(b, Decimal):\n            use_decimal = True\n\n            # Convert inputs to Decimal\n            if isinstance(a, int):\n                a_norm = Decimal(a)\n            elif isinstance(a, float):\n                a_norm = Decimal(str(a))  # Documented conversion for float to Decimal\n            elif not isinstance(a, Decimal):  # If it's a type not supported, raise\n                _validate_numeric(a)\n\n            if isinstance(b, int):\n                b_norm = Decimal(b)\n            elif isinstance(b, float):\n                b_norm = Decimal(str(b))  # Documented conversion for float to Decimal\n            elif not isinstance(b, Decimal):\n                _validate_numeric(b)\n\n            # Convert tolerance to Decimal if needed\n            if not isinstance(tol, Decimal):\n                try:\n                    tol_norm = Decimal(str(tol))\n                except InvalidOperation:\n                    raise TypeError(f\"Could not convert tolerance {tol} to Decimal.\")\n\n        # Ensure tolerance is non-negative\n        if tol_norm < 0:\n            raise ValueError(\"Tolerance must be a non-negative number.\")\n\n        return a_norm, b_norm, tol_norm, use_decimal\n\n    _validate_numeric(amount1)\n    _validate_numeric(amount2)\n\n    # Handle NaN\n    if _is_nan(amount1) or _is_nan(amount2):\n        return False\n\n    # Handle Infinity\n    inf1 = _is_infinite(amount1)\n    inf2 = _is_infinite(amount2)\n\n    if inf1 != 0 or inf2 != 0:\n        return inf1 == inf2  # True only if both are same infinity (+inf/+inf or -inf/-inf)\n\n    # Normalize values for comparison, potentially using Decimal\n    norm1, norm2, norm_tolerance, use_decimal = _normalize_for_decimal(amount1, amount2, tolerance)\n\n    # Perform comparison\n    if use_decimal:\n        return abs(norm1 - norm2) <= norm_tolerance\n    else:\n        # For int/float comparison, ensure tolerance is float for comparison\n        if isinstance(norm_tolerance, Decimal):\n             norm_tolerance = float(norm_tolerance)\n        return abs(norm1 - norm2) <= norm_tolerance"}
{"task_id": "Mbpp/641", "solution": "def nonagonal_number(n: int) -> int:\n    \"\"\"\n    Computes the nth nonagonal number using the closed-form formula P_9(n) = (7*n^2 - 5*n) / 2.\n\n    Args:\n        n: The index (1-based) of the nonagonal number to compute. Must be an integer >= 1.\n\n    Returns:\n        The nth nonagonal number as an int.\n\n    Raises:\n        ValueError: If n is not an int, is a bool, or is less than 1.\n    \"\"\"\n    if isinstance(n, bool):\n        raise ValueError(\"n must be an integer >= 1; bool is not accepted\")\n    if not isinstance(n, int):\n        raise ValueError(\"n must be an integer >= 1\")\n    if n < 1:\n        raise ValueError(\"n must be >= 1\")\n\n    # Formula: P_9(n) = (7*n^2 - 5*n) / 2\n    return (7 * n * n - 5 * n) // 2"}
