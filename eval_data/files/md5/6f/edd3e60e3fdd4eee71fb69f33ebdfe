{"task_id": "Mbpp/599", "solution": "from typing import Tuple\n\ndef sum_average(n: int) -> Tuple[int, float]:\n    \"\"\"\n    Compute sum and average of the first n natural numbers using closed-form formulas.\n    The sum is an integer, and the average is a float.\n    \"\"\"\n    total = n * (n + 1) // 2\n    average = total / n\n    return total, average"}
{"task_id": "Mbpp/597", "solution": "def find_kth(arr1, arr2, k):\n    \"\"\"\n    Finds the k-th smallest element (1-based) from two sorted arrays using a binary search approach.\n    Raises:\n        ValueError: 'k out of range' if k is not between 1 and len(arr1) + len(arr2).\n    \"\"\"\n    total_length = len(arr1) + len(arr2)\n    if not (1 <= k <= total_length):\n        raise ValueError('k out of range')\n\n    # Ensure arr1 is the shorter array for binary search efficiency\n    if len(arr1) > len(arr2):\n        arr1, arr2 = arr2, arr1\n\n    m, n = len(arr1), len(arr2)\n\n    # Handle cases where one array is empty\n    if m == 0:\n        return arr2[k - 1]\n\n    i_low = max(0, k - n)\n    i_high = min(k, m)\n\n    while i_low <= i_high:\n        i = (i_low + i_high) // 2\n        j = k - i\n\n        # Define sentinel values for boundary conditions\n        A_left_max = arr1[i - 1] if i > 0 else float('-inf')\n        A_right_min = arr1[i] if i < m else float('inf')\n        B_left_max = arr2[j - 1] if j > 0 else float('-inf')\n        B_right_min = arr2[j] if j < n else float('inf')\n\n        # Check if the partition is correct\n        if A_left_max <= B_right_min and B_left_max <= A_right_min:\n            # The k-th element is the maximum of the elements in the left partition\n            return max(A_left_max, B_left_max)\n        elif A_left_max > B_right_min:\n            # Too many elements taken from arr1 (A_left_max is too large), reduce i\n            i_high = i - 1\n        else:  # B_left_max > A_right_min\n            # Too few elements taken from arr1 (B_left_max is too large), increase i\n            i_low = i + 1\n\n    # This point should theoretically not be reached if k is within valid range\n    # and inputs are sorted.\n    return None"}
{"task_id": "Mbpp/604", "solution": "def reverse_words(input: str) -> str:\n    \"\"\"\n    Reverses the order of words in a string, normalizing whitespace.\n    Splits the string into words, reverses their order, and joins them with a single space.\n    \"\"\"\n    words = input.split()\n    reversed_words = words[::-1]\n    return \" \".join(reversed_words)"}
{"task_id": "Mbpp/602", "solution": "from typing import Optional\n\ndef first_repeated_char(s: str) -> Optional[str]:\n    \"\"\"Finds the first character whose second occurrence appears earliest in `s`, returning that character or `None` if no such repeat exists.\n\n    Behavior:\n    - If s is None -> returns None.\n    - If s is not a str -> raises TypeError.\n    - Otherwise scans left-to-right and returns the character whose second occurrence appears first.\n    - Uses Python str codepoint equality (no Unicode normalization).\n\n    Time complexity: O(n). Space complexity: O(min(n, A)) where A is the number of distinct characters.\n    Example: first_repeated_char(\"abcabc\") -> \"a\"\n    \"\"\"\n    if s is None:\n        return None\n    if not isinstance(s, str):\n        raise TypeError(\"s must be a str or None\")\n\n    seen = set()\n    for char in s:\n        if char in seen:\n            return char\n        seen.add(char)\n    return None"}
{"task_id": "Mbpp/605", "solution": "def prime_num(n: int) -> bool:\n    \"\"\"Checks if an integer n is a prime number using an optimized trial division (6k\u00b11).\n    Raises TypeError if n is not an integer.\n    \"\"\"\n    if type(n) is not int:\n        raise TypeError(\"n must be int\")\n\n    if n < 2:\n        return False\n    if n in (2, 3):\n        return True\n    if n % 2 == 0 or n % 3 == 0:\n        return False\n\n    # math.isqrt is assumed to be available in the execution environment\n    limit = __import__('math').isqrt(n)\n    for i in range(5, limit + 1, 6):\n        if n % i == 0 or n % (i + 2) == 0:\n            return False\n\n    return True"}
{"task_id": "Mbpp/606", "solution": "import math\n\ndef radian_degree(degrees: float) -> float:\n    \"\"\"\n    Convert degrees to radians.\n\n    Signature: radian_degree(degrees: float) -> float\n\n    Parameters:\n      degrees (float): angle in degrees (may be negative or non-integer).\n\n    Returns:\n      float: angle in radians computed as degrees * math.pi / 180. Returns a Python float (IEEE 754 double precision; ~15 decimal digits).\n\n    Formula:\n      radians = degrees * math.pi / 180\n\n    Example:\n      >>> radian_degree(90)\n      1.5707963267948966\n\n    Precision note:\n      Uses math.pi from Python's standard library. Results are Python floats (double precision) and are subject to floating-point rounding; tiny differences from exact mathematical values may occur.\n    \"\"\"\n    return degrees * math.pi / 180"}
{"task_id": "Mbpp/607", "solution": "def find_literals(text: str, pattern: str) -> \"Tuple[str, int, int]\":\n    \"\"\"\n    Search `text` for the first occurrence of the regex `pattern` and return a tuple\n    (matched_substring, start_index, end_index).\n\n    Indices are 0-based, start-inclusive, end-exclusive.\n\n    Raises:\n    - TypeError: if `text` or `pattern` is not a str.\n    - ValueError: with message \"No match found\" if the pattern does not match.\n    - re.error: propagated if `pattern` is an invalid regex.\n    \"\"\"\n    import re\n    from typing import Tuple\n\n    if not isinstance(text, str) or not isinstance(pattern, str):\n        raise TypeError(\"text and pattern must be str\")\n\n    match = re.search(pattern, text)\n    if match is None:\n        raise ValueError(\"No match found\")\n\n    matched_substring = match.group(0)\n    start_index, end_index = match.span(0)\n    return (matched_substring, start_index, end_index)"}
{"task_id": "Mbpp/610", "solution": "def remove_kth_element(lst, k):\n    \"\"\"\n    Returns a new list with the k'th element removed, using 1-based indexing.\n    The input list is not mutated.\n    \"\"\"\n\n    def validate_index(lst_inner, k_inner):\n        \"\"\"\n        Validates that k is an integer and within the 1-based bounds of the list.\n        Raises TypeError if k is not an int, IndexError if k is out of bounds.\n        \"\"\"\n        if not isinstance(k_inner, int):\n            raise TypeError(\"Index 'k' must be an integer.\")\n        if not (1 <= k_inner <= len(lst_inner)):\n            raise IndexError(f\"Index {k_inner} is out of bounds for list of length {len(lst_inner)} (1-based index).\")\n\n    validate_index(lst, k)\n\n    # k is 1-based, so for 0-based indexing, we need to remove at index k-1.\n    # We construct the new list by concatenating slices before and after the element.\n    result = lst[:k-1] + lst[k:]\n\n    return result"}
{"task_id": "Mbpp/603", "solution": "def get_ludic(n):\n    # Validate input\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n    if n < 1:\n        raise ValueError(\"n must be >= 1\")\n\n    # Initialize candidates from 1..n\n    candidates = list(range(1, n + 1))\n    ludics = []\n    current_index = 0\n\n    while current_index < len(candidates):\n        p = candidates[current_index]\n\n        # If p > n, stop (no further ludic numbers <= n)\n        if p > n:\n            break\n\n        ludics.append(p)\n\n        # Special-case p == 1: remove every 1st after p would remove all remaining,\n        # but per typical ludic definition starting at 1, we follow the sieve semantics\n        # that lead to classic sequence starting from 2. To match the provided assert,\n        # do not remove elements when p == 1 (so 1 remains and others are processed).\n        if p == 1:\n            current_index += 1\n            continue\n\n        # Delete every p-th remaining number after p (exclude p itself)\n        delete_pos = current_index + p\n        while delete_pos < len(candidates):\n            # remove element at delete_pos\n            candidates.pop(delete_pos)\n            # after removal, next p-th element is (p-1) positions ahead in the shifted list\n            delete_pos += (p - 1)\n\n        current_index += 1\n\n    return ludics"}
{"task_id": "Mbpp/608", "solution": "def bell_Number(n) -> int:\n    \"\"\"Calculates the nth Bell number using an iterative Bell triangle algorithm with rolling-row optimization.\n\n    Args:\n        n: non-negative integer index of Bell number (Bell(0) = 1).\n\n    Returns:\n        The nth Bell number as an int.\n\n    Raises:\n        TypeError: if n is not an int or is a bool.\n        ValueError: if n is negative.\n    \"\"\"\n    if isinstance(n, bool) or not isinstance(n, int):\n        raise TypeError(\"n must be an integer (bool is not accepted)\")\n    if n < 0:\n        raise ValueError(\"n must be a non-negative integer\")\n\n    if n == 0:\n        return 1\n\n    current_row = [1]\n    for row_index in range(1, n + 1):\n        first = current_row[-1]\n        new_row = [first]\n        for k in range(1, row_index + 1):\n            left = new_row[k - 1]\n            right = current_row[k - 1] if (k - 1) < len(current_row) else 0\n            new_row.append(left + right)\n        current_row = new_row\n    return current_row[0]"}
{"task_id": "Mbpp/612", "solution": "def merge(list_of_pairs):\n    \"\"\"Splits a list of 2-element sublists into two lists. The first output list contains all first elements, and the second contains all second elements.\"\"\"\n    firsts = []\n    seconds = []\n    for p in list_of_pairs:\n        firsts.append(p[0])\n        seconds.append(p[1])\n    return [firsts, seconds]"}
{"task_id": "Mbpp/611", "solution": "class IndexValidator:\n    def validate(self, n):\n        if not isinstance(n, int):\n            raise TypeError(\"n must be an int\")\n        if n < 0:\n            raise ValueError(\"n must be >= 0\")\n\nclass NumericChecker:\n    def is_numeric(self, value):\n        return isinstance(value, (int, float))\n\ndef max_of_nth(matrix, n):\n    \"\"\"\n    Returns the maximum numeric value found in the n-th column of the matrix.\n    Raises TypeError or ValueError for invalid inputs or non-numeric values.\n    \"\"\"\n    IndexValidator().validate(n)\n    num_check = NumericChecker()\n    found_any = False\n    running_max = None  # Initialize to None or a suitable default to be assigned on first valid element\n\n    for i, row in enumerate(matrix):\n        try:\n            value = row[n]\n        except (IndexError, TypeError):\n            # Either row is too short or not indexable; skip per FR-3\n            continue\n\n        if not num_check.is_numeric(value):\n            raise TypeError(f\"n-th element at row {i} is not numeric: {value!r}\")\n\n        if not found_any:\n            running_max = value\n            found_any = True\n        else:\n            # Python numeric comparison semantics handle int/float correctly\n            if value > running_max:\n                running_max = value\n\n    if not found_any:\n        raise ValueError(f\"no n-th elements found for column {n}\")\n    return running_max"}
{"task_id": "Mbpp/614", "solution": "from typing import List, Tuple\nfrom numbers import Number\n\ndef cummulative_sum(values: List[Tuple[Number, ...]]) -> Number:\n    total: Number = 0\n    for t in values:\n        for x in t:\n            total += x\n    return total"}
{"task_id": "Mbpp/615", "solution": "class _Validator:\n    \"\"\"Encapsulates validation logic for the average_tuple function.\"\"\"\n    def validate_top_level(self, data: object) -> None:\n        \"\"\"Raises TypeError if data is not a tuple.\"\"\"\n        if not isinstance(data, tuple):\n            raise TypeError(\"top-level input must be tuple\")\n\n    def validate_inner_type(self, inner: object, index: int) -> None:\n        \"\"\"Raises TypeError if inner is not a tuple.\"\"\"\n        if not isinstance(inner, tuple):\n            raise TypeError(f\"inner element at index {index} is not a tuple\")\n\n    def validate_non_empty(self, inner: tuple, index: int) -> None:\n        \"\"\"Raises ValueError if inner tuple is empty.\"\"\"\n        if not inner:\n            raise ValueError(f\"empty inner tuple at index {index}\")\n\n    def validate_numeric(self, value: object, inner_index: int, value_index: int) -> None:\n        \"\"\"Raises TypeError if value is not int or float.\"\"\"\n        if not isinstance(value, (int, float)):\n            raise TypeError(f\"non-numeric value at inner {inner_index} position {value_index}\")\n\ndef average_tuple(data: tuple[tuple[float, ...], ...]) -> list[float]:\n    \"\"\"Validate and compute per-inner-tuple averages.\n\n    Raises:\n      TypeError: if top-level is not tuple, if any inner element is not tuple, or if any value is non-numeric.\n      ValueError: if any inner tuple is empty.\n    \"\"\"\n    validator = _Validator()\n    validator.validate_top_level(data)\n\n    result: list[float] = []\n\n    for i, inner_tuple in enumerate(data):\n        validator.validate_inner_type(inner_tuple, i)\n        validator.validate_non_empty(inner_tuple, i)\n\n        running_sum = 0.0\n        for j, value in enumerate(inner_tuple):\n            validator.validate_numeric(value, i, j)\n            running_sum += float(value)\n\n        avg = running_sum / len(inner_tuple)\n        result.append(avg)\n\n    return result"}
{"task_id": "Mbpp/616", "solution": "class Validator:\n    \"\"\"Helper class to perform all pre-computation validations.\"\"\"\n    def validate_types(self, first, second) -> None:\n        \"\"\"Checks if both inputs are tuple instances.\"\"\"\n        if not isinstance(first, tuple) or not isinstance(second, tuple):\n            raise TypeError(\"Both inputs must be tuples.\")\n\n    def validate_lengths(self, first, second) -> None:\n        \"\"\"Checks if input tuples have the same length.\"\"\"\n        if len(first) != len(second):\n            raise ValueError(\"Input tuples must have the same length.\")\n\n    def validate_no_zero_divisors(self, second) -> None:\n        \"\"\"Ensures no element in the divisor tuple is zero.\"\"\"\n        for item in second:\n            if item == 0 or item == 0.0:\n                raise ZeroDivisionError(\"Cannot perform modulo with zero as a divisor.\")\n\ndef _compute_modulo(first_tuple, second_tuple) -> tuple:\n    \"\"\"Performs the element-wise modulo calculation after validations.\"\"\"\n    return tuple(a % b for a, b in zip(first_tuple, second_tuple))\n\ndef tuple_modulo(first_tuple, second_tuple) -> tuple:\n    \"\"\"\n    Performs element-wise modulo on two tuples of the same length, returning a new tuple.\n    Example: assert tuple_modulo((10, 20), (3, 6)) == (1, 2)\n    \"\"\"\n    validator = Validator()\n    validator.validate_types(first_tuple, second_tuple)\n    validator.validate_lengths(first_tuple, second_tuple)\n    validator.validate_no_zero_divisors(second_tuple)\n\n    return _compute_modulo(first_tuple, second_tuple)"}
{"task_id": "Mbpp/619", "solution": "def move_num(input_string: str) -> str:\n    \"\"\"Moves all numbers in the input string to the end, preserving relative order of non-digits and digits.\"\"\"\n\n    def _is_ascii_digit(char: str) -> bool:\n        \"\"\"Checks if a character is an ASCII digit ('0'-'9').\"\"\"\n        return '0' <= char <= '9'\n\n    non_digits_buffer = []\n    digits_buffer = []\n\n    for char in input_string:\n        if _is_ascii_digit(char):\n            digits_buffer.append(char)\n        else:\n            non_digits_buffer.append(char)\n\n    return \"\".join(non_digits_buffer) + \"\".join(digits_buffer)"}
{"task_id": "Mbpp/618", "solution": "def _validate_list_instance(obj: any, name: str) -> None:\n    \"\"\"Validates that an object is a list instance. Raises TypeError if not.\"\"\"\n    if not isinstance(obj, list):\n        raise TypeError(f\"'{name}' must be a list instance, got {type(obj).__name__}\")\n\ndef _validate_lengths(numerators: list, denominators: list) -> None:\n    \"\"\"Validates that two lists have the same length. Raises ValueError if lengths differ.\"\"\"\n    if len(numerators) != len(denominators):\n        raise ValueError(f\"'numerators' and 'denominators' must have the same length: got {len(numerators)} and {len(denominators)}\")\n\ndef _validate_elements(list_obj: list, name: str) -> None:\n    \"\"\"Validates that all elements in a list are either int or float. Raises TypeError for invalid elements.\"\"\"\n    for i, element in enumerate(list_obj):\n        if not isinstance(element, (int, float)):\n            raise TypeError(f\"{name}[{i}] must be int or float, got {type(element).__name__} ({element!r})\")\n\ndef _compute_elementwise(numerators: list, denominators: list) -> list:\n    \"\"\"Performs element-wise division of two lists, handling division by zero. Returns a new list of results.\"\"\"\n    result = []\n    for i in range(len(numerators)):\n        if denominators[i] == 0:\n            raise ZeroDivisionError(f\"denominators[{i}] is zero ({denominators[i]!r}); division by zero\")\n        result.append(numerators[i] / denominators[i])\n    return result\n\ndef div_list(numerators: list, denominators: list) -> list:\n    \"\"\"\n    Performs element-wise division of two lists using true division (/).\n\n    The function validates inputs strictly and returns a new list where result[i] == numerators[i] / denominators[i].\n    Inputs are not mutated, and order is preserved.\n\n    Raises:\n        TypeError: If 'numerators' or 'denominators' is not a list instance.\n        ValueError: If 'numerators' and 'denominators' have different lengths.\n        TypeError: If any element in 'numerators' or 'denominators' is not int or float.\n        ZeroDivisionError: If any denominator element is zero.\n\n    Examples:\n        >>> div_list([4, 1], [2, 0.5])\n        [2.0, 2.0]\n        >>> div_list([], [])\n        []\n        >>> # div_list((1,2), [1,2]) # -> TypeError: \"'numerators' must be a list instance, got tuple\"\n        >>> # div_list([1, 'a'], [1, 2]) # -> TypeError: \"numerators[1] must be int or float, got str ('a')\"\n        >>> # div_list([1,2], [1,0]) # -> ZeroDivisionError: \"denominators[1] is zero (0); division by zero\"\n\n    Complexity:\n        Time: O(n) where n is the length of the input lists.\n        Additional space: O(n) for the returned list.\n    \"\"\"\n    _validate_list_instance(numerators, 'numerators')\n    _validate_list_instance(denominators, 'denominators')\n\n    if not numerators and not denominators:\n        return []\n\n    _validate_lengths(numerators, denominators)\n    _validate_elements(numerators, 'numerators')\n    _validate_elements(denominators, 'denominators')\n\n    return _compute_elementwise(numerators, denominators)"}
{"task_id": "Mbpp/623", "solution": "def nth_nums(numbers, n) -> list:\n    \"\"\"Computes the n-th power for each number in the list.\n    Raises TypeError for invalid input types; runtime math exceptions propagate.\"\"\"\n    if not isinstance(numbers, list):\n        raise TypeError(\"Input 'numbers' must be a list.\")\n    if not isinstance(n, int):\n        raise TypeError(\"Input 'n' must be an integer.\")\n\n    results = []\n    for x in numbers:\n        if not isinstance(x, (int, float)):\n            raise TypeError(\"All elements in 'numbers' must be integers or floats.\")\n        results.append(x ** n)\n    return results"}
{"task_id": "Mbpp/622", "solution": "import math\nfrom typing import Sequence\n\nclass MedianCalculator:\n    \"\"\"Provides a static method to compute the median of two sorted lists.\"\"\"\n    @staticmethod\n    def find_median(a: Sequence, b: Sequence, n: int) -> float:\n        \"\"\"\n        Finds the median of two sorted lists 'a' and 'b' of the same size 'n'.\n        This algorithm assumes valid, sorted input sequences and a positive integer 'n'.\n        \"\"\"\n        if n == 1:\n            return (a[0] + b[0]) / 2.0\n\n        low = 0\n        high = n\n\n        while low <= high:\n            i = (low + high) // 2  # Partition point for list 'a'\n            j = n - i              # Partition point for list 'b'\n\n            max_left_a = a[i-1] if i > 0 else -math.inf\n            min_right_a = a[i] if i < n else math.inf\n\n            max_left_b = b[j-1] if j > 0 else -math.inf\n            min_right_b = b[j] if j < n else math.inf\n\n            if max_left_a <= min_right_b and max_left_b <= min_right_a:\n                median_left = max(max_left_a, max_left_b)\n                median_right = min(min_right_a, min_right_b)\n                return (median_left + median_right) / 2.0\n            elif max_left_a > min_right_b:\n                high = i - 1\n            else: # max_left_b > min_right_a\n                low = i + 1\n\n        # This point should not be reached if inputs are valid and the algorithm is correct.\n        return 0.0 # Fallback, indicating an unexpected state.\n\ndef get_median(a: Sequence, b: Sequence, n: int) -> float:\n    \"\"\"\n    Calculates the median of two sorted lists of the same size n.\n    Example: get_median([1, 12, 15, 26, 38], [2, 13, 17, 30, 45], 5) == 16.0\n    \"\"\"\n    return MedianCalculator.find_median(a, b, n)"}
{"task_id": "Mbpp/620", "solution": "def largest_subset(nums: list[int]) -> int:\n    \"\"\"\n    Finds the size of the largest subset of numbers where every pair is divisible,\n    considering absolute values and special zero handling.\n    \"\"\"\n    n = len(nums)\n    if n == 0:\n        return 0\n    if n == 1:\n        return 1\n\n    zero_count = 0\n    for num in nums:\n        if num == 0:\n            zero_count += 1\n\n    if zero_count == n:\n        return n\n\n    # Sort by absolute value. Python's Timsort is stable.\n    sorted_nums = sorted(nums, key=abs)\n\n    dp = [1] * n\n    max_size = 1\n\n    for i in range(n):\n        ai = sorted_nums[i]\n        abs_ai = abs(ai)\n        for j in range(i):\n            aj = sorted_nums[j]\n            abs_aj = abs(aj)\n\n            divisible = False\n            # Special handling for zero according to design rules\n            if abs_ai == 0 and abs_aj == 0:\n                divisible = True\n            elif abs_ai == 0 or abs_aj == 0:\n                divisible = False\n            else:\n                # abs_aj is always <= abs_ai because the list is sorted by abs.\n                # So we only need to check if abs_ai is divisible by abs_aj.\n                if abs_aj != 0 and abs_ai % abs_aj == 0:\n                    divisible = True\n\n            if divisible:\n                if dp[j] + 1 > dp[i]:\n                    dp[i] = dp[j] + 1\n\n        if dp[i] > max_size:\n            max_size = dp[i]\n\n    return max_size"}
