{"task_id": "Mbpp/242", "solution": "def count_charac(input_string: str) -> int:\n    \"\"\"Counts the total number of characters (Unicode code points) in a string.\"\"\"\n    return len(input_string)"}
{"task_id": "Mbpp/239", "solution": "def get_total_number_of_sequences(m: int, n: int) -> int:\n    \"\"\"\n    Calculates the number of sequences of length n with elements up to m,\n    where each element is at least twice the previous one.\n    \"\"\"\n    # Validate inputs\n    if not isinstance(m, int) or isinstance(m, bool) or m <= 0:\n        raise ValueError(\"m must be a positive integer\")\n    if not isinstance(n, int) or isinstance(n, bool) or n <= 0:\n        raise ValueError(\"n must be a positive integer\")\n\n    if n == 1:\n        return m\n\n    # Fast impossibility check: smallest possible sequence grows by powers of 2.\n    if (1 << (n - 1)) > m:\n        return 0\n\n    # dp_prev[v-1] stores the number of valid sequences of length (current_length - 1)\n    # that end with the value v. Initialize for length 1: one sequence per value.\n    dp_prev = [1] * m\n\n    # Iterate for sequence length from 2 up to n\n    for _ in range(2, n + 1):\n        # Calculate prefix sums for dp_prev.\n        prefix_sums = [0] * m\n        current_sum = 0\n        for i in range(m):\n            current_sum += dp_prev[i]\n            prefix_sums[i] = current_sum\n\n        # dp_cur[w-1] will store the number of valid sequences of the current_length\n        # that end with the value w.\n        dp_cur = [0] * m\n        for w_idx in range(m):\n            w = w_idx + 1  # current ending value of the sequence\n\n            # The previous element 'p' must satisfy p <= w // 2.\n            max_prev_val_allowed = w // 2\n\n            if max_prev_val_allowed >= 1:\n                dp_cur[w_idx] = prefix_sums[max_prev_val_allowed - 1]\n\n        dp_prev = dp_cur  # Update dp_prev for the next iteration (rolling array)\n\n    # The total number of sequences of length n is the sum of all counts in dp_prev.\n    return sum(dp_prev)"}
{"task_id": "Mbpp/244", "solution": "import math\n\ndef next_Perfect_Square(n):\n    \"\"\"\n    Finds the smallest perfect square strictly greater than a given number n.\n    Handles negative inputs by returning 0, and non-integer inputs by flooring them.\n    \"\"\"\n    # Compute m = floor(n) as per design specification.\n    m = math.floor(n)\n\n    # If m is negative, the next perfect square is 0.\n    if m < 0:\n        return 0\n\n    # Compute k = floor(sqrt(m)). math.isqrt provides this directly for non-negative integers.\n    k = math.isqrt(m)\n\n    # The next perfect square strictly greater than m (and thus n) is (k+1)^2.\n    result = (k + 1) ** 2\n\n    # In Python, integers have arbitrary precision, so a fixed 'host_max_int' overflow\n    # as described in the design (for fixed-size integer types) is not typically applicable.\n    return result"}
{"task_id": "Mbpp/250", "solution": "def count_X(items: tuple, element) -> int:\n    \"\"\"Counts occurrences of an element in a tuple.\n    Raises TypeError if 'items' is not a tuple; otherwise returns the count (O(n) time, O(1) space).\"\"\"\n    if not isinstance(items, tuple):\n        raise TypeError(\"items must be a tuple\")\n    return items.count(element)"}
{"task_id": "Mbpp/245", "solution": "def max_sum(arr):\n    n = len(arr)\n\n    # Handle trivial cases for empty or single-element arrays.\n    if n == 0:\n        return 0\n    if n == 1:\n        return arr[0]\n\n    # left_sum[i] stores the maximum sum of a strictly increasing subsequence ending at arr[i].\n    left_sum = [0] * n\n    for i in range(n):\n        left_sum[i] = arr[i]  # Initialize with the element itself\n        for j in range(i):\n            if arr[j] < arr[i]:  # Strictly increasing condition\n                left_sum[i] = max(left_sum[i], left_sum[j] + arr[i])\n\n    # right_sum[i] stores the maximum sum of a strictly decreasing subsequence starting at arr[i].\n    right_sum = [0] * n\n    for i in range(n - 1, -1, -1):\n        right_sum[i] = arr[i]  # Initialize with the element itself\n        for j in range(n - 1, i, -1):\n            if arr[j] < arr[i]:  # Strictly decreasing condition (arr[i] must be greater than arr[j])\n                right_sum[i] = max(right_sum[i], right_sum[j] + arr[i])\n\n    # Combine left_sum and right_sum to find the maximum sum of a bitonic subsequence.\n    # The element arr[i] acts as the peak and is included in both left_sum[i] and right_sum[i],\n    # so subtract it once to avoid double-counting.\n    max_bitonic_sum = float('-inf')\n    for i in range(n):\n        bitonic_sum_at_i = left_sum[i] + right_sum[i] - arr[i]\n        max_bitonic_sum = max(max_bitonic_sum, bitonic_sum_at_i)\n\n    return max_bitonic_sum"}
{"task_id": "Mbpp/247", "solution": "def lps(s: str) -> int:\n    \"\"\"Compute the length of the longest palindromic subsequence for string s.\n\n    Signature: lps(s: str) -> int\n    Algorithm: Dynamic Programming with a dp table where dp[i][j] is the LPS length for s[i..j].\n    Steps:\n      1. If len(s) == 0 return 0.\n      2. Build an n\u00d7n dp table initialized to 0 and set dp[i][i] = 1 for all i.\n      3. For substring lengths L = 2..n and for each start i compute end j = i+L-1:\n         - if s[i] == s[j]: dp[i][j] = dp[i+1][j-1] + 2 (if L == 2 then 2)\n         - else: dp[i][j] = max(dp[i+1][j], dp[i][j-1])\n      4. Return dp[0][n-1].\n    Complexity: Time O(n^2), Space O(n^2).\n    \"\"\"\n    n = len(s)\n    if n == 0:\n        return 0\n\n    dp = [[0] * n for _ in range(n)]\n    for i in range(n):\n        dp[i][i] = 1\n\n    for L in range(2, n + 1):\n        for i in range(n - L + 1):\n            j = i + L - 1\n            if s[i] == s[j]:\n                if L == 2:\n                    dp[i][j] = 2\n                else:\n                    dp[i][j] = dp[i + 1][j - 1] + 2\n            else:\n                dp[i][j] = max(dp[i + 1][j], dp[i][j - 1])\n\n    return dp[0][n - 1]"}
{"task_id": "Mbpp/251", "solution": "def insert_element(items, element):\n    \"\"\"\n    Return a new list with `element` inserted immediately before each element in `items`.\n    `items` may be any iterable; the returned object is a list.\n    \"\"\"\n    result = []\n    for item in items:\n        result.append(element)\n        result.append(item)\n    return result"}
{"task_id": "Mbpp/253", "solution": "def _is_exact_int(value) -> bool:\n    \"\"\"Helper to check if the value's runtime type is exactly int.\"\"\"\n    return type(value) is int\n\ndef count_integer(items: list) -> int:\n    \"\"\"Returns the number of integer elements in a given list, counting only exact int types.\"\"\"\n    count = 0\n    for item in items:\n        if _is_exact_int(item):\n            count += 1\n    return count"}
{"task_id": "Mbpp/252", "solution": "import math\n\ndef convert(value):\n    \"\"\"Convert a complex or real number to polar coordinates.\n\n    Returns (r, theta) where r >= 0.0 and theta in radians in [-pi, pi].\n    \"\"\"\n    if not isinstance(value, (int, float, complex)):\n        raise TypeError(\"convert: value must be int, float, or complex\")\n\n    if isinstance(value, complex):\n        real = float(value.real)\n        imag = float(value.imag)\n    else:\n        real = float(value)\n        imag = 0.0\n\n    if real == 0.0 and imag == 0.0:\n        return (0.0, 0.0)\n\n    r = math.hypot(real, imag)\n    theta = math.atan2(imag, real)\n\n    return (float(r), float(theta))"}
{"task_id": "Mbpp/255", "solution": "class CombinationGenerator:\n    \"\"\"\n    Generates combinations with repetition using recursive backtracking.\n    \"\"\"\n    def __init__(self, list, n):\n        self._list = list\n        self._n = n\n        self._buffer = []\n        self._result = []\n\n    def combinations(self):\n        \"\"\"\n        Public method to generate and return all combinations.\n        \"\"\"\n        self._validate_inputs()\n\n        if self._n == 0:\n            return [()]\n        if not self._list and self._n > 0:\n            return []\n\n        self._backtrack(0, 0)\n        return self._result\n\n    def _validate_inputs(self):\n        \"\"\"\n        Validates the input 'n' to ensure it's non-negative.\n        \"\"\"\n        if self._n < 0:\n            raise ValueError(\"n must be non-negative\")\n\n    def _backtrack(self, start_index, depth):\n        \"\"\"\n        Recursive backtracking function to build combinations.\n        \"\"\"\n        if depth == self._n:\n            self._emit_current()\n            return\n\n        for i in range(start_index, len(self._list)):\n            self._buffer.append(self._list[i])\n            self._backtrack(i, depth + 1)\n            self._buffer.pop()\n\n    def _emit_current(self):\n        \"\"\"\n        Converts the current buffer to a tuple and adds it to the result list.\n        \"\"\"\n        self._result.append(tuple(self._buffer))\n\ndef combinations_colors(list, n):\n    \"\"\"\n    Generates all combinations with repetition of elements from the input list,\n    returning them as a list of tuples.\n    \"\"\"\n    generator = CombinationGenerator(list, n)\n    return generator.combinations()"}
{"task_id": "Mbpp/257", "solution": "def validate(a, b) -> None:\n    \"\"\"Validate both parameters are int or float; raise TypeError on failure.\"\"\"\n    if not isinstance(a, (int, float)) or not isinstance(b, (int, float)):\n        raise TypeError(\"swap_numbers requires int or float for both parameters\")\n\ndef swap_numbers(a, b) -> tuple:\n    \"\"\"Swaps two numeric inputs and returns them in reversed order as a tuple (b, a).\n    It validates that both inputs are int or float, raising TypeError if not.\n    \"\"\"\n    validate(a, b)\n    return (b, a)"}
{"task_id": "Mbpp/260", "solution": "def newman_prime(n: int) -> int:\n    \"\"\"\n    Calculates the nth Newman\u2013Shanks\u2013Williams (NSW) number.\n\n    Args:\n        n (int): non-negative index (0-based) of the NSW sequence.\n\n    Returns:\n        int: the nth NSW number.\n\n    Raises:\n        TypeError: if n is not an int.\n        ValueError: if n < 0.\n    \"\"\"\n    if not isinstance(n, int) or isinstance(n, bool):\n        raise TypeError(\"n must be an int\")\n    if n < 0:\n        raise ValueError(\"n must be >= 0\")\n\n    if n == 0 or n == 1:\n        return 1\n\n    prev2, prev1 = 1, 1  # a_0, a_1\n    for _ in range(2, n + 1):\n        curr = 2 * prev1 + prev2\n        prev2, prev1 = prev1, curr\n    return prev1"}
{"task_id": "Mbpp/262", "solution": "def split_two_parts(lst: list, L: int) -> tuple[list, list]:\n    \"\"\"Splits a list into two parts at a given length L, returning them as a tuple of lists.\"\"\"\n    k = max(0, min(L, len(lst)))\n    return (lst[:k], lst[k:])"}
{"task_id": "Mbpp/256", "solution": "import numbers\nimport math\n\ndef count_Primes_nums(n, algorithm=\"auto\") -> int:\n    # Validate input 'n' as per design: must be a non-negative real number.\n    if not isinstance(n, numbers.Real):\n        raise ValueError(\"Input 'n' must be a real number (int or float).\")\n    if n < 0:\n        raise ValueError(\"Input 'n' must be non-negative.\")\n\n    # Fast-path for n <= 2, as there are no primes strictly less than 2.\n    if n <= 2:\n        return 0\n\n    # Determine the maximum integer p such that p < n for primality testing.\n    # Using floor(n) - 1 would be incorrect for exact integers; compute int(n) and\n    # ensure we count primes strictly less than n.\n    max_num_to_sieve = int(math.floor(n - 1e-12))\n\n    SIEVE_THRESHOLD = 50_000\n    chosen_algorithm = algorithm\n\n    if algorithm == \"auto\":\n        if max_num_to_sieve >= SIEVE_THRESHOLD:\n            chosen_algorithm = \"sieve\"\n        else:\n            chosen_algorithm = \"trial\"\n\n    if chosen_algorithm not in [\"sieve\", \"trial\"]:\n        raise ValueError(\"Invalid algorithm parameter. Must be 'auto', 'sieve', or 'trial'.\")\n\n    # Sieve of Eratosthenes algorithm execution path.\n    if chosen_algorithm == \"sieve\":\n        try:\n            if max_num_to_sieve < 2:  # No primes in range [0, 1]\n                return 0\n\n            # Use bytearray for memory efficiency, marking primes with 1.\n            is_prime = bytearray([1]) * (max_num_to_sieve + 1)\n            if max_num_to_sieve >= 0:\n                is_prime[0] = 0\n            if max_num_to_sieve >= 1:\n                is_prime[1] = 0\n\n            p = 2\n            while p * p <= max_num_to_sieve:\n                if is_prime[p]:\n                    start = p * p\n                    is_prime[start:max_num_to_sieve + 1:p] = b'\\x00' * (((max_num_to_sieve - start) // p) + 1)\n                p += 1\n\n            return sum(is_prime[2:])  # Count all '1's (primes) from index 2 onwards.\n\n        except MemoryError:\n            if algorithm == \"auto\":\n                # Fallback to trial division if Sieve was chosen automatically and failed.\n                chosen_algorithm = \"trial\"\n            else:\n                # If \"sieve\" was explicitly requested, re-raise the MemoryError as per design.\n                raise\n\n    # Optimized Trial Division algorithm execution path (also used as Sieve fallback).\n    if chosen_algorithm == \"trial\":\n        count = 0\n        if max_num_to_sieve < 2:\n            return 0\n\n        if max_num_to_sieve >= 2:\n            count += 1  # 2 is the first prime.\n\n        # Check odd numbers starting from 3 up to max_num_to_sieve.\n        for num in range(3, max_num_to_sieve + 1, 2):\n            is_num_prime = True\n            limit = int(math.isqrt(num))\n            for i in range(3, limit + 1, 2):\n                if num % i == 0:\n                    is_num_prime = False\n                    break\n            if is_num_prime:\n                count += 1\n        return count"}
{"task_id": "Mbpp/261", "solution": "def division_elements(tuple1: tuple, tuple2: tuple) -> tuple:\n    \"\"\"Perform element-wise floor division between two tuples.\n\n    Args:\n        tuple1 (tuple): Tuple of numeric dividends (int or float).\n        tuple2 (tuple): Tuple of numeric divisors (int or float).\n\n    Returns:\n        tuple: Tuple where each element is tuple1[i] // tuple2[i].\n\n    Raises:\n        ValueError: If the input tuples have different lengths.\n        TypeError: If any element in the tuples is not an int or float.\n        ZeroDivisionError: If any element in tuple2 is zero.\n\n    Example:\n        assert division_elements((10, 4, 6, 9), (5, 2, 3, 3)) == (2, 2, 2, 3)\n\n    Complexity:\n        Time: O(n)\n        Space: O(n)\n    \"\"\"\n    # Validate lengths\n    if len(tuple1) != len(tuple2):\n        raise ValueError(f\"tuple1 and tuple2 must have the same length; got len(tuple1)={len(tuple1)}, len(tuple2)={len(tuple2)}\")\n\n    # Validate element types and zero divisors\n    for idx, (a, b) in enumerate(zip(tuple1, tuple2)):\n        if not isinstance(a, (int, float)):\n            raise TypeError(f\"Element at index {idx} in tuple1 is not numeric: {a!r} (type {type(a).__name__})\")\n        if not isinstance(b, (int, float)):\n            raise TypeError(f\"Element at index {idx} in tuple2 is not numeric: {b!r} (type {type(b).__name__})\")\n        if b == 0:\n            raise ZeroDivisionError(f\"Division by zero encountered at index {idx} in tuple2\")\n\n    # Compute element-wise floor division\n    results = []\n    for a, b in zip(tuple1, tuple2):\n        results.append(a // b)\n\n    return tuple(results)"}
{"task_id": "Mbpp/259", "solution": "def maximize_elements(outer1, outer2):\n    \"\"\"\n    Return a tuple of tuples containing element-wise maxima of corresponding inner sequences.\n\n    Args:\n        outer1: First outer tuple (sequence of inner sequences).\n        outer2: Second outer tuple (sequence of inner sequences).\n\n    Returns:\n        A tuple of tuples where each inner tuple is the element-wise maximum of the corresponding\n        inner sequences from outer1 and outer2.\n\n    Raises:\n        ValueError: If outer lengths or corresponding inner lengths differ.\n        TypeError: If any element is not an int or float.\n    \"\"\"\n    if len(outer1) != len(outer2):\n        raise ValueError(f\"Outer lengths differ: {len(outer1)} != {len(outer2)}\")\n\n    result = []\n    for i, (inner1, inner2) in enumerate(zip(outer1, outer2)):\n        try:\n            len1 = len(inner1)\n            len2 = len(inner2)\n        except TypeError as exc:\n            raise TypeError(f\"Inner element at index {i} is not a sequence: {exc}\") from exc\n\n        if len1 != len2:\n            raise ValueError(f\"Inner lengths differ at index {i}: {len1} != {len2}\")\n\n        inner_result = []\n        for j, (v1, v2) in enumerate(zip(inner1, inner2)):\n            if not isinstance(v1, (int, float)):\n                raise TypeError(f\"Non-numeric element at ({i},{j}): {v1} (type {type(v1).__name__})\")\n            if not isinstance(v2, (int, float)):\n                raise TypeError(f\"Non-numeric element at ({i},{j}): {v2} (type {type(v2).__name__})\")\n            inner_result.append(v1 if v1 >= v2 else v2)\n\n        result.append(tuple(inner_result))\n\n    return tuple(result)"}
{"task_id": "Mbpp/264", "solution": "import math\n\nFIRST_TWO_RATE = 10.5\nADDITIONAL_RATE = 4.0\nWHOLE_NUMBER_REL_TOL = 1e-9\n\ndef _is_whole_number(value, *, rel_tol=WHOLE_NUMBER_REL_TOL, abs_tol=0.0):\n    \"\"\"Checks if a numeric value is mathematically integral within floating-point tolerances.\"\"\"\n    return math.isclose(value, round(value), rel_tol=rel_tol, abs_tol=abs_tol)\n\ndef validate(human_age):\n    \"\"\"Raises ValueError if human_age is negative.\"\"\"\n    if human_age < 0:\n        raise ValueError(\"human_age must be >= 0\")\n\ndef compute_first_two_years(human_age):\n    \"\"\"Calculates dog years contribution for the first two human years.\"\"\"\n    if human_age <= 2:\n        return human_age * FIRST_TWO_RATE\n    else:\n        return 2 * FIRST_TWO_RATE\n\ndef compute_additional_years(human_age):\n    \"\"\"Calculates dog years contribution for human years beyond two.\"\"\"\n    if human_age <= 2:\n        return 0.0\n    else:\n        return (human_age - 2) * ADDITIONAL_RATE\n\ndef dog_age(human_age):\n    \"\"\"\n    Calculates a dog's age in dog's years.\n    Returns an int if the result is a whole number, otherwise a float.\n    \"\"\"\n    validate(human_age)\n    first_part = compute_first_two_years(human_age)\n    second_part = compute_additional_years(human_age)\n    total = first_part + second_part\n\n    if _is_whole_number(total):\n        return int(round(total))\n    else:\n        return float(total)"}
{"task_id": "Mbpp/265", "solution": "def list_split(input_list, n):\n    \"\"\"\n    Splits a list into n sublists, distributing elements by their index modulo n.\n    Each sublist contains elements at indices i, i+n, i+2n, ...\n    \"\"\"\n    result = [[] for _ in range(n)]\n    for idx, elem in enumerate(input_list):\n        result[idx % n].append(elem)\n    return result"}
{"task_id": "Mbpp/266", "solution": "def lateralsurface_cube(side):\n    \"\"\"Computes the lateral surface area of a cube given its side length using the formula 4 * side * side. For example, lateralsurface_cube(2) returns 16.\"\"\"\n    return 4 * side * side"}
{"task_id": "Mbpp/269", "solution": "def validate_input(char: object) -> None:\n    \"\"\"Validates the input for type and length constraints.\"\"\"\n    if not isinstance(char, str):\n        raise TypeError(\"char must be a str\")\n    if len(char) != 1:\n        raise ValueError(\"char must be a single character\")\n\ndef compute_code(char: str) -> int:\n    \"\"\"Computes the Unicode code point for a single character.\"\"\"\n    return ord(char)\n\ndef ascii_value(char: str) -> int:\n    \"\"\"Finds the ASCII value (Unicode code point) of a single character.\n\n    Raises:\n        TypeError: If the input is not a string.\n        ValueError: If the input string is not a single character.\n    \"\"\"\n    validate_input(char)\n    return compute_code(char)"}
{"task_id": "Mbpp/268", "solution": "def find_star_num(n):\n    \"\"\"\n    Calculates the n'th star number using the formula S(n) = 6 * n * (n - 1) + 1.\n\n    Args:\n        n (int): 1-based index of the star number.\n\n    Returns:\n        int: the n-th star number.\n\n    Note:\n        This function assumes caller provides a valid positive integer n.\n    \"\"\"\n    return 6 * n * (n - 1) + 1"}
{"task_id": "Mbpp/267", "solution": "def square_Sum(n: int) -> int:\n    \"\"\"Calculate the sum of squares of the first n odd natural numbers.\n\n    The sum S = 1^2 + 3^2 + 5^2 + ... + (2n-1)^2 has the closed-form:\n        S = n * (2n - 1) * (2n + 1) / 3\n\n    This function uses integer arithmetic and returns an int.\n\n    Args:\n        n (int): number of first odd natural numbers to include.\n\n    Returns:\n        int: sum of squares of the first n odd natural numbers.\n\n    Raises:\n        TypeError: if n is not an int.\n        ValueError: if n is negative.\n\n    Examples:\n        square_Sum(0) -> 0\n        square_Sum(1) -> 1\n        square_Sum(2) -> 10\n        square_Sum(5) -> 165\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an int\")\n    if n < 0:\n        raise ValueError(\"n must be non-negative\")\n\n    return (n * (2 * n - 1) * (2 * n + 1)) // 3"}
{"task_id": "Mbpp/271", "solution": "def _compute_closed_form(n: int) -> int:\n    \"\"\"Calculates the sum using the closed-form formula for n >= 0.\n    Assumes n is a non-negative integer.\n    \"\"\"\n    a = n * n\n    b = (n + 1) * (n + 1)\n    c = 2 * n * n + 2 * n - 1\n    numerator = 8 * a * b * c\n    return numerator // 3\n\ndef even_Power_Sum(n: int) -> int:\n    \"\"\"Finds the sum of the first n even natural numbers that are raised to the fifth power.\n    Uses a closed-form integer formula for efficient computation.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n    if n < 0:\n        raise ValueError(\"n must be non-negative\")\n    if n == 0:\n        return 0\n    return _compute_closed_form(n)"}
{"task_id": "Mbpp/270", "solution": "def sum_even_and_even_index(lst: list) -> int:\n    \"\"\"Sums even numbers located at even 0-based indices in a list.\n\n    Parameters:\n    - lst: list -- the list to process\n\n    Returns:\n    - int -- sum of elements that are integers, even, and at even indices\n\n    Raises:\n    - TypeError: if lst is not a list\n    \"\"\"\n    if type(lst) is not list:\n        raise TypeError(\"lst must be a list\")\n\n    total = 0\n    for index, value in enumerate(lst):\n        if index % 2 == 0:  # even index\n            # include only plain ints (exclude bool) that are even\n            if type(value) is int and value % 2 == 0:\n                total += value\n    return total"}
{"task_id": "Mbpp/273", "solution": "def validate_types(a: tuple, b: tuple) -> None:\n    \"\"\"Validates that both inputs are tuples.\"\"\"\n    if not isinstance(a, tuple) or not isinstance(b, tuple):\n        raise TypeError(\"Inputs must be tuples.\")\n\ndef validate_lengths(a: tuple, b: tuple) -> None:\n    \"\"\"Validates that both tuples have equal length.\"\"\"\n    if len(a) != len(b):\n        raise ValueError(\"Tuples must have equal length.\")\n\ndef validate_elements(a: tuple, b: tuple) -> None:\n    \"\"\"Validates that all elements in both tuples are numeric (int or float).\"\"\"\n    for i in range(len(a)):\n        if not isinstance(a[i], (int, float)) or not isinstance(b[i], (int, float)):\n            raise TypeError(\"All elements in tuples must be numeric (int or float).\")\n\ndef compute(a: tuple, b: tuple) -> tuple:\n    \"\"\"Performs element-wise subtraction and returns a new tuple.\"\"\"\n    return tuple(a[i] - b[i] for i in range(len(a)))\n\ndef substract_elements(a: tuple, b: tuple) -> tuple:\n    \"\"\"\n    Subtracts elements of the second tuple from the first tuple element-wise.\n    Inputs must be tuples of equal length containing only numeric elements.\n    \"\"\"\n    validate_types(a, b)\n    validate_lengths(a, b)\n    validate_elements(a, b)\n    return compute(a, b)"}
{"task_id": "Mbpp/272", "solution": "def rear_extract(input_list):\n    \"\"\"Extract the last element from each tuple in input_list.\n\n    Parameters:\n    - input_list (list): A Python list whose elements must be non-empty tuples.\n\n    Returns:\n    - list: A new list containing the last element of each tuple in input_list, preserving order.\n\n    Raises:\n    - TypeError: If input_list is not a list or any element of input_list is not a tuple.\n    - ValueError: If any tuple in input_list is empty.\n\n    Time complexity: O(n) where n is len(input_list).\n    Space complexity: O(n) additional memory for the returned list.\n    \"\"\"\n    if not isinstance(input_list, list):\n        raise TypeError(\"Input must be a list.\")\n\n    extracted_elements = []\n    for item in input_list:\n        if not isinstance(item, tuple):\n            raise TypeError(\"All elements in the input list must be tuples.\")\n        if not item:\n            raise ValueError(\"All tuples in the input list must be non-empty.\")\n        extracted_elements.append(item[-1])\n\n    return extracted_elements"}
{"task_id": "Mbpp/276", "solution": "import math\n\ndef volume_cylinder(radius: float, height: float) -> float:\n    \"\"\"\n    Computes the volume of a cylinder given its radius and height.\n    Returns 0.0 if radius or height is zero.\n    \"\"\"\n    if radius == 0 or height == 0:\n        return 0.0\n    volume = math.pi * (radius ** 2) * height\n    return float(volume)"}
{"task_id": "Mbpp/278", "solution": "def count_first_elements(input_tuple):\n    \"\"\"Return number of top-level elements before the first top-level tuple element.\n    Raises TypeError if input_tuple is not a tuple (tuple subclasses allowed).\"\"\"\n\n    def _validate_tuple(tup):\n        if not isinstance(tup, tuple):\n            raise TypeError(\"input_tuple must be a tuple\")\n\n    def _is_tuple_instance(obj):\n        return isinstance(obj, tuple)\n\n    _validate_tuple(input_tuple)\n\n    for i, element in enumerate(input_tuple):\n        if _is_tuple_instance(element):\n            return i\n    return -1"}
{"task_id": "Mbpp/274", "solution": "def even_binomial_Coeff_Sum(n: int) -> int:\n    \"\"\"\n    Calculates the sum of even-indexed binomial coefficients for a non-negative integer n.\n    Uses the identity: sum_{k even} C(n, k) = 2^(n-1) for n >= 1, and = 1 for n = 0.\n    \"\"\"\n    if n == 0:\n        return 1\n\n    # Exponentiation by squaring to compute 2^exp efficiently.\n    def fast_pow2(exp: int) -> int:\n        result = 1\n        base = 2\n        while exp > 0:\n            if exp & 1:\n                result *= base\n            base *= base\n            exp >>= 1\n        return result\n\n    return fast_pow2(n - 1)"}
{"task_id": "Mbpp/277", "solution": "def dict_filter(d: dict, n: int) -> dict:\n    \"\"\"\n    Filters a dictionary to include only entries with values greater than or equal to n.\n\n    Raises TypeError for invalid input types or non-numeric dictionary values.\n    \"\"\"\n    if not isinstance(d, dict):\n        raise TypeError(f\"dict_filter: first argument 'd' must be dict, got {type(d).__name__}\")\n    if not isinstance(n, int):\n        raise TypeError(f\"dict_filter: second argument 'n' must be int, got {type(n).__name__}\")\n\n    # Validate dictionary values before filtering\n    for k, v in d.items():\n        if not isinstance(v, (int, float)):\n            raise TypeError(f\"dict_filter: value for key {repr(k)} must be int or float, got {type(v).__name__}\")\n\n    filtered_dict = {}\n    for k, v in d.items():\n        if v >= n:\n            filtered_dict[k] = v\n    return filtered_dict"}
{"task_id": "Mbpp/280", "solution": "def sequential_search(array, element):\n    \"\"\"\n    Searches for an element in an array using a linear scan.\n    Returns a tuple (found_bool, index), where index is -1 if not found.\n    \"\"\"\n    for i, item in enumerate(array):\n        if item == element:\n            return (True, i)\n    return (False, -1)"}
{"task_id": "Mbpp/279", "solution": "def is_num_decagonal(n):\n    \"\"\"Calculates the nth decagonal number, D(n) = 4 * n * n - 3 * n.\n    Raises ValueError if n is not an integer or n < 1.\n    \"\"\"\n    if not isinstance(n, int) or n < 1:\n        raise ValueError(\"n must be an integer and n >= 1\")\n    return 4 * n * n - 3 * n"}
{"task_id": "Mbpp/282", "solution": "from typing import Sequence, List, Any, Union\n\ndef validate_sequences(minuend: Any, subtrahend: Any) -> None:\n    \"\"\"Validates that both inputs are sequences (list or tuple).\"\"\"\n    if not isinstance(minuend, (list, tuple)):\n        raise TypeError(f\"Parameter 'minuend' must be a list or tuple, but got {type(minuend).__name__}.\")\n    if not isinstance(subtrahend, (list, tuple)):\n        raise TypeError(f\"Parameter 'subtrahend' must be a list or tuple, but got {type(subtrahend).__name__}.\")\n\ndef check_equal_length(minuend: Sequence[Any], subtrahend: Sequence[Any]) -> None:\n    \"\"\"Checks if the lengths of the two sequences are equal.\"\"\"\n    if len(minuend) != len(subtrahend):\n        raise ValueError(\n            f\"minuend and subtrahend must have the same length \"\n            f\"(len(minuend)={len(minuend)}, len(subtrahend)={len(subtrahend)})\"\n        )\n\ndef validate_element_types(sequence: Sequence[Any], name: str) -> None:\n    \"\"\"Validates that all elements in a sequence are numeric (int or float).\"\"\"\n    for i, element in enumerate(sequence):\n        if not isinstance(element, (int, float)):\n            raise TypeError(\n                f\"non-numeric element at index {i} in parameter '{name}': {repr(element)}\"\n            )\n\ndef compute_elementwise(minuend: Sequence[Union[int, float]], subtrahend: Sequence[Union[int, float]]) -> List[float]:\n    \"\"\"Performs element-wise subtraction, assuming inputs are valid sequences of numbers with equal length.\"\"\"\n    result = []\n    for i in range(len(minuend)):\n        result.append(float(minuend[i] - subtrahend[i]))\n    return result\n\ndef sub_list(minuend: Sequence[Union[int, float]], subtrahend: Sequence[Union[int, float]]) -> List[float]:\n    \"\"\"\n    Subtracts two lists element-wise.\n\n    This function takes two sequences (lists or tuples) of numbers (integers or floats)\n    and returns a new list where each element is the result of subtracting the\n    corresponding elements from the input sequences.\n\n    Args:\n        minuend: The first sequence of numbers (list or tuple of int or float).\n        subtrahend: The second sequence of numbers (list or tuple of int or float).\n\n    Returns:\n        A new list of floats, representing the element-wise difference.\n\n    Raises:\n        TypeError: If inputs are not lists/tuples or contain non-numeric elements.\n        ValueError: If the input sequences have different lengths.\n\n    Examples:\n        >>> sub_list([5.0, 3.0], [1.0, 2.0])\n        [4.0, 1.0]\n\n        >>> sub_list([1, 2, 3], [4, 5, 6])\n        [-3.0, -3.0, -3.0]\n\n        >>> sub_list([1, 2], [1])\n        Traceback (most recent call last):\n          ...\n        ValueError: minuend and subtrahend must have the same length (len(minuend)=2, len(subtrahend)=1)\n\n        >>> sub_list([1, 'a'], [0, 0])\n        Traceback (most recent call last):\n          ...\n        TypeError: non-numeric element at index 1 in parameter 'minuend': 'a'\n\n    Complexity:\n        Time O(n), Additional space O(n) where n = len(minuend).\n    \"\"\"\n    validate_sequences(minuend, subtrahend)\n    check_equal_length(minuend, subtrahend)\n    validate_element_types(minuend, 'minuend')\n    validate_element_types(subtrahend, 'subtrahend')\n    return compute_elementwise(minuend, subtrahend)"}
{"task_id": "Mbpp/283", "solution": "def validate(n: int) -> bool:\n    \"\"\"\n    Checks if the frequency of each digit in an integer is less than or equal to the digit itself.\n    Uses the absolute value of the input integer for digit analysis.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"Input must be an int\")\n\n    m = abs(n)\n    s = str(m)\n    counts = [0] * 10\n\n    for char_digit in s:\n        digit = ord(char_digit) - ord('0')\n        counts[digit] += 1\n\n    for d in range(10):\n        if counts[d] > d:\n            return False\n\n    return True"}
{"task_id": "Mbpp/281", "solution": "def all_unique(lst) -> bool:\n    \"\"\"\n    Checks if all elements in a list are unique.\n\n    Args:\n        lst (list): The list to check. Must be a list, otherwise TypeError is raised.\n\n    Returns:\n        bool: True if all elements are unique (by ==), False if any duplicates exist.\n\n    Notes:\n    - Uses a hash-based fast path (set) when elements are hashable (average O(n) time, O(n) space).\n    - Falls back to pairwise equality comparisons if any element is unhashable (O(n^2) time, O(1) extra space).\n    - Does not modify the input list.\n    \"\"\"\n    if not isinstance(lst, list):\n        raise TypeError(\"all_unique expects a list\")\n\n    n = len(lst)\n    if n <= 1:\n        return True\n\n    seen = set()\n    try:\n        for element in lst:\n            if element in seen:\n                return False\n            seen.add(element)\n        return True  # All elements were hashable and unique\n    except TypeError:\n        # Fallback to pairwise comparison if unhashable element encountered\n        pass\n\n    # Fallback path: pairwise comparisons for unhashable or mixed types\n    for i in range(n):\n        for j in range(i + 1, n):\n            if lst[i] == lst[j]:\n                return False\n    return True"}
{"task_id": "Mbpp/284", "solution": "def check_element(lst: list, element) -> bool:\n    \"\"\"\n    Checks if all items in the list are equal to the given element.\n    Returns True for an empty list.\n    \"\"\"\n    return all(item == element for item in lst)"}
{"task_id": "Mbpp/285", "solution": "def text_match_two_three(text):\n    \"\"\"\n    Checks if the string contains 'a' followed by exactly two or three 'b' characters.\n    This implementation uses an iterative scan, counting maximal consecutive 'b's.\n    \"\"\"\n    if len(text) < 3:\n        return False\n\n    for i in range(len(text)):\n        if text[i] == 'a':\n            j = i + 1\n            while j < len(text) and text[j] == 'b':\n                j += 1\n\n            run_length = j - (i + 1)\n            if run_length == 2 or run_length == 3:\n                return True\n    return False"}
{"task_id": "Mbpp/287", "solution": "def _validate_type(n) -> None:\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n\ndef _validate_non_negative(n) -> None:\n    if n < 0:\n        raise ValueError(\"n must be non-negative\")\n\ndef _compute_formula(n: int) -> int:\n    # Calculates 4 * sum(k^2) from k=1 to n using the closed-form formula.\n    # Uses integer division for correctness.\n    return 4 * n * (n + 1) * (2 * n + 1) // 6\n\ndef square_Sum(n: int) -> int:\n    _validate_type(n)\n    _validate_non_negative(n)\n    return _compute_formula(n)"}
{"task_id": "Mbpp/290", "solution": "import itertools\nfrom typing import Any, Iterable, Tuple\n\ndef max_length(iterable_of_iterables: Iterable[Iterable[Any]]) -> Tuple[int, Iterable[Any]]:\n    \"\"\"\n    Finds the list of maximum length in a list of lists.\n\n    Examples:\n    max_length([[1, 2], [3], [4, 5, 6]]) -> (3, [4, 5, 6])\n    max_length([]) -> (0, [])\n    max_length([[1,2], [3,4], [5]]) -> (2, [1,2])  # tie preserved (first occurrence)\n    max_length(42) -> raises TypeError(\"input must be an iterable of iterables\")\n\n    Time complexity: O(m * k) where m = number of sublists and k = average sublist length (calls len() on each sublist once).\n    Space complexity: O(1) extra beyond the input (only a few scalars and a reference to the current max sublist).\n    \"\"\"\n\n    def _validate_input(obj: Any) -> Iterable[Iterable[Any]]:\n        \"\"\"\n        Performs minimal input validation and prepares the iterator for finding the max.\n        Returns an iterator that can be consumed by _find_max.\n        \"\"\"\n        try:\n            iterator = iter(obj)\n        except TypeError:\n            raise TypeError(\"input must be an iterable of iterables\")\n\n        first_element = None\n        try:\n            first_element = next(iterator)\n        except StopIteration:\n            # Input is empty, it's valid. Return an empty iterator.\n            return iter([])\n\n        # Check if the first element is iterable\n        try:\n            iter(first_element)\n        except TypeError:\n            raise TypeError(\"input must be an iterable of iterables\")\n\n        # If validated, return an iterator that includes the peeked first element.\n        return itertools.chain([first_element], iterator)\n\n    def _find_max(iterable_of_iterables_validated: Iterable[Iterable[Any]]) -> Tuple[int, Iterable[Any]]:\n        \"\"\"\n        Iterates through the validated iterable to find the sublist with the maximum length.\n        Preserves first-occurrence tie behavior and returns (0, []) for empty input.\n        \"\"\"\n        max_len = 0\n        max_ref = []  # Default for empty input as per requirement (0, [])\n\n        for sublist in iterable_of_iterables_validated:\n            current_len = len(sublist)\n            if current_len > max_len:\n                max_len = current_len\n                max_ref = sublist\n        return (max_len, max_ref)\n\n    # Main logic for the public function\n    validated_iterator = _validate_input(iterable_of_iterables)\n    return _find_max(validated_iterator)"}
{"task_id": "Mbpp/292", "solution": "import math\n\ndef _validate_inputs(numerator, denominator) -> None:\n    \"\"\"Validates inputs for type and zero-denominator.\"\"\"\n    if not isinstance(numerator, (int, float)) or not isinstance(denominator, (int, float)):\n        raise TypeError(\"numerator and denominator must be int or float\")\n    if denominator == 0:\n        raise ValueError(\"denominator must not be zero\")\n\ndef _compute_floor_quotient(numerator, denominator) -> int:\n    \"\"\"Computes the floor quotient, handling int-int and mixed/float cases.\"\"\"\n    if isinstance(numerator, int) and isinstance(denominator, int):\n        return numerator // denominator\n    return int(math.floor(float(numerator) / float(denominator)))\n\ndef find(numerator, denominator) -> int:\n    \"\"\"Finds the quotient of two numbers, rounded down to the nearest integer (mathematical floor).\"\"\"\n    _validate_inputs(numerator, denominator)\n    return _compute_floor_quotient(numerator, denominator)"}
{"task_id": "Mbpp/286", "solution": "from typing import List\n\nclass Validator:\n    @staticmethod\n    def validate(arr: List[int], n: int, k: int) -> None:\n        \"\"\"Validates input parameters for type, value, and consistency.\"\"\"\n        if not isinstance(arr, list):\n            raise ValueError(\"arr must be a list of integers.\")\n        if not isinstance(n, int) or n < 0:\n            raise ValueError(\"n must be a non-negative integer.\")\n        if n != len(arr):\n            raise ValueError(\"n must be equal to len(arr).\")\n        if not isinstance(k, int) or k < 0:\n            raise ValueError(\"k must be a non-negative integer.\")\n        if n == 0 or k == 0:\n            raise ValueError(\"n==0 or k==0: no non-empty subarray exists.\")\n\nclass Kadane:\n    @staticmethod\n    def max_subarray(arr: List[int]) -> int:\n        \"\"\"Finds the maximum contiguous subarray sum in a single array.\"\"\"\n        # This implementation correctly handles arrays with all negative numbers by returning the largest element.\n        max_ending_here = arr[0]\n        max_so_far = arr[0]\n\n        for x in arr[1:]:\n            max_ending_here = max(x, max_ending_here + x)\n            max_so_far = max(max_so_far, max_ending_here)\n        return max_so_far\n\nclass RepeaterLogic:\n    @staticmethod\n    def total_sum(arr: List[int]) -> int:\n        \"\"\"Calculates the sum of all elements in the array.\"\"\"\n        return sum(arr)\n\n    @staticmethod\n    def prefix_max(arr: List[int]) -> int:\n        \"\"\"Finds the maximum prefix sum of the array.\"\"\"\n        current_sum = 0\n        best_prefix_sum = float('-inf')\n        for x in arr:\n            current_sum += x\n            best_prefix_sum = max(best_prefix_sum, current_sum)\n        return int(best_prefix_sum)\n\n    @staticmethod\n    def suffix_max(arr: List[int]) -> int:\n        \"\"\"Finds the maximum suffix sum of the array.\"\"\"\n        current_sum = 0\n        best_suffix_sum = float('-inf')\n        for x in reversed(arr):\n            current_sum += x\n            best_suffix_sum = max(best_suffix_sum, current_sum)\n        return int(best_suffix_sum)\n\n    @staticmethod\n    def max_over_two_copies(arr: List[int]) -> int:\n        \"\"\"Computes the maximum subarray sum over two logically concatenated copies of the array.\"\"\"\n        n = len(arr)\n        max_ending_here = arr[0]\n        max_two_copy = arr[0]\n\n        for i in range(1, 2 * n):\n            x = arr[i % n]\n            max_ending_here = max(x, max_ending_here + x)\n            max_two_copy = max(max_two_copy, max_ending_here)\n        return max_two_copy\n\n    @staticmethod\n    def combine_for_k(total: int, prefix: int, suffix: int, k: int) -> int:\n        \"\"\"Combines prefix, suffix, and middle full blocks' sums for k >= 3 repetitions.\"\"\"\n        return suffix + (k - 2) * total + prefix\n\ndef max_sub_array_sum_repeated(arr: List[int], n: int, k: int) -> int:\n    \"\"\"\n    Finds the largest sum of a contiguous array in the modified array\n    which is formed by repeating the given array k times.\n    \"\"\"\n    Validator.validate(arr, n, k)\n\n    if k == 1:\n        return Kadane.max_subarray(arr)\n\n    # For k >= 2, consider sums that span across repetitions.\n    total = RepeaterLogic.total_sum(arr)\n    prefix = RepeaterLogic.prefix_max(arr)\n    suffix = RepeaterLogic.suffix_max(arr)\n\n    # max_two_copy covers all cases for k=2 and provides a base for k > 2.\n    max_two_copy = RepeaterLogic.max_over_two_copies(arr)\n\n    result = max_two_copy\n\n    # If the total sum is positive, additional full blocks in the middle (k-2 blocks)\n    # can potentially increase the sum for k >= 3.\n    if total > 0 and k >= 3:\n        candidate_spanning_middle = RepeaterLogic.combine_for_k(total, prefix, suffix, k)\n        result = max(result, candidate_spanning_middle)\n\n    return result"}
{"task_id": "Mbpp/293", "solution": "def otherside_rightangle(a: float, b: float) -> float:\n    \"\"\"Calculates the hypotenuse of a right-angled triangle given two leg lengths.\n\n    Inputs are converted to float before computing the hypotenuse using math.sqrt.\n\n    Args:\n        a (int | float): length of first leg (must be non-negative).\n        b (int | float): length of second leg (must be non-negative).\n\n    Returns:\n        float: length of the hypotenuse.\n\n    Raises:\n        TypeError: if inputs are not int or float.\n        ValueError: if inputs are negative.\n    \"\"\"\n    import math\n\n    # Type validation\n    if not isinstance(a, (int, float)) or not isinstance(b, (int, float)):\n        raise TypeError(\"inputs must be int or float\")\n\n    # Non-negativity validation\n    if a < 0 or b < 0:\n        raise ValueError(\"inputs must be non-negative\")\n\n    # Convert inputs to float\n    a_f = float(a)\n    b_f = float(b)\n\n    # Compute the hypotenuse using the Pythagorean theorem\n    result_value = math.sqrt(a_f * a_f + b_f * b_f)\n\n    return result_value"}
{"task_id": "Mbpp/297", "solution": "def flatten_list(lst: list) -> list:\n    \"\"\"\n    Flattens a nested list structure into a single-level list, preserving the original order.\n    It uses an iterative approach with an explicit stack to handle arbitrary nesting depths.\n    \"\"\"\n    flattened = []\n    # Initialize the processing stack with elements of the input list in reverse order\n    # to ensure they are processed left-to-right (due to LIFO stack behavior).\n    processing_stack = list(reversed(lst))\n\n    while processing_stack:\n        current_item = processing_stack.pop()\n        if isinstance(current_item, list):\n            # If it's a list, extend the stack with its elements, also in reverse order,\n            # to maintain the overall left-to-right processing sequence.\n            processing_stack.extend(reversed(current_item))\n        else:\n            # If it's not a list, it's an atomic element; add it to the result.\n            flattened.append(current_item)\n    return flattened"}
{"task_id": "Mbpp/294", "solution": "def max_val(items):\n    \"\"\"\n    Finds the maximum numeric value (int or float) in a heterogeneous list.\n    Raises TypeError if input is not a list, or ValueError if no int/float values are found.\n    \"\"\"\n    if type(items) is not list:\n        raise TypeError(\"items must be a list\")\n\n    current_max = None\n    seen_numeric = False\n\n    for x in items:\n        if type(x) is int or type(x) is float:\n            if not seen_numeric:\n                current_max = x\n                seen_numeric = True\n            else:\n                if x > current_max:\n                    current_max = x\n\n    if seen_numeric:\n        return current_max\n    else:\n        raise ValueError(\"no numeric values in input\")"}
{"task_id": "Mbpp/296", "solution": "def _merge_count(left, right):\n    \"\"\"\n    Merges two sorted lists and counts split inversions.\n    Raises TypeError if elements are not comparable during merging.\n    \"\"\"\n    i = j = 0\n    merged = []\n    count = 0\n    while i < len(left) and j < len(right):\n        try:\n            if left[i] <= right[j]:\n                merged.append(left[i])\n                i += 1\n            else:\n                merged.append(right[j])\n                count += (len(left) - i) # All remaining elements in left[i:] are greater than right[j]\n                j += 1\n        except TypeError:\n            raise TypeError(\"Element comparisons failed; elements must be mutually comparable.\")\n\n    merged.extend(left[i:])\n    merged.extend(right[j:])\n    return merged, count\n\ndef _sort_count(a):\n    \"\"\"\n    Recursively sorts the list and counts inversions.\n    Returns a tuple of (sorted_list, inversion_count).\n    \"\"\"\n    n = len(a)\n    if n < 2:\n        return a, 0\n\n    mid = n // 2\n    left, left_count = _sort_count(a[:mid])\n    right, right_count = _sort_count(a[mid:])\n\n    merged, split_count = _merge_count(left, right)\n\n    return merged, left_count + right_count + split_count\n\ndef get_Inv_Count(arr):\n    \"\"\"\n    Counts the number of inversions in a sequence using a merge-sort based algorithm.\n    An inversion is a pair of indices (i, j) such that i < j and arr[i] > arr[j].\n\n    Time Complexity: O(n log n)\n    Space Complexity: O(n) auxiliary space (due to temporary merge buffers).\n    Recursion Depth: O(log n), which for very large n might approach Python's default recursion limit.\n\n    Parameters:\n        arr: A sequence (e.g., list, tuple) of comparable elements.\n\n    Returns:\n        int: The total count of inversions in the input sequence.\n\n    Raises:\n        TypeError: If the input is not a sequence (e.g., int, None) or if elements within\n                   the sequence are not mutually comparable (e.g., mixing int and str).\n\n    Example:\n        assert get_Inv_Count([2,4,1,3,5]) == 3\n    \"\"\"\n    try:\n        # Validate that arr is sequence-like and iterable without using isinstance\n        _ = len(arr)\n        a = list(arr) # Create a copy to avoid mutating the original input\n    except (TypeError, AttributeError):\n        raise TypeError(\"Input must be a sequence of comparable elements.\")\n\n    _, inv_count = _sort_count(a)\n    return inv_count"}
{"task_id": "Mbpp/301", "solution": "def dict_depth(d: dict) -> int:\n    \"\"\"\n    Calculates the maximum nesting depth of a dictionary, detecting cycles.\n\n    The depth of an empty dictionary is 1. Non-dictionary values are ignored\n    when calculating depth. If a cycle is detected, a ValueError is raised.\n\n    Example:\n        >>> d = {'a': {'b': {}}}\n        >>> dict_depth(d)\n        3\n\n    Note: For extremely deep nesting RecursionError may be raised. Consider\n    increasing Python's recursion limit or using an iterative algorithm if needed.\n    \"\"\"\n    if not isinstance(d, dict):\n        raise TypeError(\"dict_depth: argument must be dict\")\n\n    visited: set[int] = set()\n\n    def _depth_recursive(curr: dict, visited: set[int]) -> int:\n        obj_id = id(curr)\n        if obj_id in visited:\n            raise ValueError(\"Cycle detected in dicts\")\n\n        visited.add(obj_id)\n        try:\n            max_child = 0\n            for value in curr.values():\n                if isinstance(value, dict):\n                    child_depth = _depth_recursive(value, visited)\n                    if child_depth > max_child:\n                        max_child = child_depth\n            return 1 + max_child\n        finally:\n            visited.remove(obj_id)\n\n    return _depth_recursive(d, visited)"}
{"task_id": "Mbpp/300", "solution": "import math\n\ndef central_binomial(n: int) -> int:\n    \"\"\"\n    Computes the central binomial coefficient C(2n, n) using exact integer arithmetic.\n    Prefers math.comb; falls back to a multiplicative loop for older Python versions.\n    \"\"\"\n    try:\n        return math.comb(2 * n, n)\n    except AttributeError:\n        # Fallback for Python versions without math.comb (e.g., < 3.8)\n        # This computes C(2n, n) = product((n+i)/i for i=1 to n)\n        result = 1\n        for i in range(1, n + 1):\n            result = result * (n + i) // i\n        return result\n\ndef to_float(value: int) -> float:\n    \"\"\"\n    Converts an integer to a float.\n    For very large integers, this may result in float('inf').\n    \"\"\"\n    return float(value)\n\ndef count_binary_seq(n: int) -> float:\n    \"\"\"\n    Finds the count of all binary sequences of length 2n such that the\n    sum of the first n bits is the same as the sum of the last n bits.\n    This count is given by the central binomial coefficient C(2n, n).\n    \"\"\"\n    exact_count = central_binomial(n)\n    return to_float(exact_count)"}
{"task_id": "Mbpp/299", "solution": "from typing import Iterable, Tuple, Optional, Any, Dict\n\nclass AggregationRecord:\n    \"\"\"Holds per-name aggregated state and supports updating.\"\"\"\n    def __init__(self, name: Any, value: float | int, first_seen_index: int):\n        self.name = name\n        self.total: float | int = value\n        self.all_ints: bool = isinstance(value, int)\n        self.first_seen_index: int = first_seen_index\n\n    def update(self, value: float | int):\n        \"\"\"Adds value to total and updates the all_ints flag.\"\"\"\n        self.total += value\n        self.all_ints = self.all_ints and isinstance(value, int)\n\nclass Aggregator:\n    \"\"\"Maintains insertion-ordered mapping of name to AggregationRecord.\"\"\"\n    def __init__(self):\n        self.records: Dict[Any, AggregationRecord] = {}\n        self.next_index: int = 0\n\n    def process_item(self, item: Tuple[Any, float | int]):\n        \"\"\"Processes a single (name, value) item, updating or creating a record.\"\"\"\n        name, value = item\n        if name not in self.records:\n            self.records[name] = AggregationRecord(name, value, self.next_index)\n            self.next_index += 1\n        else:\n            self.records[name].update(value)\n\n    def select_max(self) -> Optional[AggregationRecord]:\n        \"\"\"Selects the record with the maximum total, with stable tie-breaking.\"\"\"\n        max_record: Optional[AggregationRecord] = None\n        for record in self.records.values():\n            if max_record is None or record.total > max_record.total:\n                max_record = record\n            elif record.total == max_record.total:\n                if record.first_seen_index < max_record.first_seen_index:\n                    max_record = record\n        return max_record\n\ndef max_aggregate(items: Iterable[Tuple[Any, float | int]]) -> Optional[Tuple[Any, float | int]]:\n    \"\"\"\n    Calculates the maximum aggregate from a list of tuples (name, value).\n    It aggregates values for each name and returns the name with the highest sum.\n    \"\"\"\n    try:\n        iterator = iter(items)\n    except TypeError:\n        raise TypeError(\"items must be an iterable of tuples\")\n\n    agg = Aggregator()\n\n    for item in iterator:\n        if not isinstance(item, tuple) or len(item) != 2:\n            raise ValueError(\"each item must be a 2-tuple (name, value)\")\n\n        name, value = item\n\n        if not isinstance(value, (int, float)):\n            raise TypeError(\"value must be int or float\")\n\n        agg.process_item((name, value))\n\n    record = agg.select_max()\n\n    if record is None:\n        return None\n    else:\n        total = record.total\n        if record.all_ints:\n            total = int(total)\n        else:\n            total = float(total)\n        return (record.name, total)"}
{"task_id": "Mbpp/305", "solution": "def start_withp(input_list: list[str]) -> tuple[str, str]:\n    \"\"\"\n    Returns two words from a list of words starting with 'p' (case-insensitive, Unicode-aware).\n    Raises TypeError for invalid input, ValueError for insufficient matches.\n    \"\"\"\n    # 1. Validate input\n    if not isinstance(input_list, list):\n        raise TypeError(f\"Input must be a list of strings; received type '{type(input_list).__name__}'.\")\n\n    for i, element in enumerate(input_list):\n        if not isinstance(element, str):\n            raise TypeError(f\"All elements of input_list must be strings; element at index {i} has type '{type(element).__name__}'.\")\n\n    # 2. Streaming token generator (inline implementation for O(1) additional memory)\n    # This generator yields trimmed, non-empty tokens, splitting on Unicode whitespace.\n    def _token_generator():\n        for s_item in input_list:\n            current_token_chars = []\n            in_word = False  # Tracks if we are currently building a word.\n\n            for char in s_item:\n                if char.isspace():\n                    if in_word:\n                        yield \"\".join(current_token_chars)\n                        current_token_chars = []\n                        in_word = False\n                else:\n                    current_token_chars.append(char)\n                    in_word = True\n\n            # Yield any remaining token at the end of the string\n            if in_word:\n                yield \"\".join(current_token_chars)\n\n    # 3. Consume tokens and collect matches\n    matches = []\n    tokens_iter = _token_generator()\n\n    for token in tokens_iter:\n        # tokens yielded are guaranteed non-empty by _token_generator logic.\n        # Check if the token starts with 'p' (case-insensitive, Unicode-aware).\n        if token[0].casefold() == 'p':\n            matches.append(token)\n            if len(matches) == 2:\n                break  # Stop early as soon as two matches are found\n\n    # 4. Handle insufficient matches\n    if len(matches) < 2:\n        raise ValueError(\"Insufficient matches: fewer than two tokens starting with 'p' were found.\")\n\n    # Return the collected matches as a tuple, as per the assert example.\n    return tuple(matches)"}
{"task_id": "Mbpp/306", "solution": "def max_sum_increasing_subseq(arr, n, i, k):\n    \"\"\"\n    Finds the maximum sum of an increasing subsequence from prefix arr[0..i]\n    that also includes arr[k] (where k > i).\n    \"\"\"\n    # Basic validation\n    if arr is None or not isinstance(arr, (list, tuple)):\n        raise ValueError(\"arr must be a non-empty list or tuple of numeric values\")\n    if not isinstance(n, int):\n        raise ValueError(\"n must be an integer\")\n    if n != len(arr):\n        raise ValueError(\"n must equal len(arr)\")\n    if not isinstance(i, int) or not isinstance(k, int):\n        raise ValueError(\"i and k must be integers\")\n    if not (0 <= i < n):\n        raise ValueError(\"i must satisfy 0 <= i < n\")\n    if not (0 <= k < n):\n        raise ValueError(\"k must satisfy 0 <= k < n\")\n    if not (k > i):\n        raise ValueError(\"k must be > i\")\n    # Ensure numeric elements\n    for idx, v in enumerate(arr):\n        if not isinstance(v, (int, float)):\n            raise ValueError(f\"arr must contain numeric values only (invalid at index {idx})\")\n\n    prefix_len = i + 1\n    # DP array: max sum of increasing subsequence ending at j using elements from prefix\n    dp = [0] * prefix_len\n    for j in range(prefix_len):\n        dp[j] = arr[j]\n\n    for j in range(prefix_len):\n        for t in range(j):\n            if arr[t] < arr[j]:\n                dp[j] = max(dp[j], dp[t] + arr[j])\n\n    # Combine prefix results with arr[k]\n    max_sum_including_k = arr[k]\n    for j in range(prefix_len):\n        if arr[j] < arr[k]:\n            max_sum_including_k = max(max_sum_including_k, dp[j] + arr[k])\n\n    return max_sum_including_k"}
{"task_id": "Mbpp/309", "solution": "def maximum(a: int | float, b: int | float) -> int | float:\n    \"\"\"Finds the maximum of two numbers.\n\n    Returns the numerically larger of two numeric operands (int or float).\n    If a and b are equal, returns a, preserving its type.\n\n    Args:\n        a (int | float): The first number.\n        b (int | float): The second number.\n\n    Returns:\n        int | float: The larger of the two numbers.\n                     The return type preserves Python's numeric promotion rules.\n\n    Raises:\n        TypeError: If either 'a' or 'b' is not an int or float,\n                   with a message like \"expected int or float for parameter 'a', got str\".\n\n    Examples:\n        >>> maximum(5, 10)\n        10\n        >>> maximum(3, 5)\n        5\n        >>> maximum(2.0, 1)\n        2.0\n        >>> maximum(-1, -1)\n        -1\n        >>> # maximum('a', 1) would raise TypeError(\"expected int or float for parameter 'a', got str\")\n    \"\"\"\n    if not isinstance(a, (int, float)):\n        raise TypeError(f\"expected int or float for parameter 'a', got {type(a).__name__}\")\n    if not isinstance(b, (int, float)):\n        raise TypeError(f\"expected int or float for parameter 'b', got {type(b).__name__}\")\n\n    return a if a >= b else b"}
{"task_id": "Mbpp/310", "solution": "def string_to_tuple(s: str) -> tuple:\n    \"\"\"Converts a string to a tuple of characters, excluding ASCII spaces.\"\"\"\n\n    def validate_type(arg) -> None:\n        \"\"\"Ensures the input argument is of type 'str', raising TypeError otherwise.\"\"\"\n        if not isinstance(arg, str):\n            raise TypeError(\"string_to_tuple: input must be of type 'str'\")\n\n    def filter_spaces(text: str) -> str:\n        \"\"\"Removes all ASCII space characters (U+0020) from the input string.\"\"\"\n        return text.replace(\" \", \"\")\n\n    validate_type(s)\n    filtered = filter_spaces(s)\n    return tuple(filtered)"}
{"task_id": "Mbpp/312", "solution": "import math\n\ndef volume_cone(radius, height):\n    \"\"\"Return the volume of a right circular cone.\n\n    Parameters:\n        radius (int | float): radius of base; must be >= 0\n        height (int | float): height of cone; must be >= 0\n\n    Returns:\n        float: volume computed as (1/3) * math.pi * radius**2 * height\n\n    Raises:\n        TypeError: if radius or height is not an int or float\n        ValueError: if radius or height is negative\n\n    Example:\n        import math\n        assert math.isclose(volume_cone(5, 12), 314.15926535897927, rel_tol=0.001)\n    \"\"\"\n    if not isinstance(radius, (int, float)):\n        raise TypeError(\"radius must be an int or float\")\n    if not isinstance(height, (int, float)):\n        raise TypeError(\"height must be an int or float\")\n\n    if radius < 0:\n        raise ValueError(\"radius must be non-negative\")\n    if height < 0:\n        raise ValueError(\"height must be non-negative\")\n\n    volume = (1.0 / 3.0) * math.pi * (radius ** 2) * height\n    return volume"}
{"task_id": "Mbpp/308", "solution": "import heapq\n\ndef large_product(listA, listB, k):\n    \"\"\"\n    Finds the specified number of largest products from two given lists,\n    selecting one factor from each list.\n    \"\"\"\n\n    # Helper class ProductPair to encapsulate (a_idx, b_idx, product) for\n    # deterministic heap operations and easier data access.\n    class ProductPair:\n        __slots__ = ('a_idx', 'b_idx', 'product')\n\n        def __init__(self, a_idx, b_idx, product):\n            self.a_idx = a_idx\n            self.b_idx = b_idx\n            self.product = product\n\n    # 1. Sort inputs in descending order. This serves as the 'InputList' concept.\n    # Python's sorted() is stable.\n    sorted_A = sorted(listA, reverse=True)\n    sorted_B = sorted(listB, reverse=True)\n\n    # 2. Handle empty lists as per design specification.\n    if not sorted_A or not sorted_B:\n        return []\n\n    n = len(sorted_A)\n    m = len(sorted_B)\n\n    # 3. Initialize data structures for the heap-based generation.\n    # The heap stores tuples: (-product, a_index, b_index, ProductPair object)\n    # to simulate a max-heap and provide deterministic tie-breaking as described in design.\n    heap = []\n    # The 'visited' set keeps track of (a_index, b_index) pairs already processed\n    # or added to the heap, preventing redundant calculations and infinite loops.\n    visited = set()\n    results = [] # This serves as the 'ResultList' to collect products.\n\n    # 4. Push the initial pair (product of the largest elements) into the heap.\n    initial_a_idx = 0\n    initial_b_idx = 0\n    initial_product = sorted_A[initial_a_idx] * sorted_B[initial_b_idx]\n    initial_pair_obj = ProductPair(initial_a_idx, initial_b_idx, initial_product)\n    heapq.heappush(heap, (-initial_product, initial_a_idx, initial_b_idx, initial_pair_obj))\n    visited.add((initial_a_idx, initial_b_idx))\n\n    # 5. Iteratively extract up to 'k' largest products.\n    count = 0\n    while count < k and heap:\n        # Pop the element with the largest product (smallest -product) from the heap.\n        neg_prod, a_idx, b_idx, current_pair_obj = heapq.heappop(heap)\n        results.append(current_pair_obj.product)\n        count += 1\n\n        # 6. Consider neighbor pairs for expansion, following the specified deterministic order.\n\n        # Consider neighbor (a_idx + 1, b_idx)\n        next_a_idx = a_idx + 1\n        if next_a_idx < n and (next_a_idx, b_idx) not in visited:\n            new_product = sorted_A[next_a_idx] * sorted_B[b_idx]\n            new_pair_obj = ProductPair(next_a_idx, b_idx, new_product)\n            heapq.heappush(heap, (-new_product, next_a_idx, b_idx, new_pair_obj))\n            visited.add((next_a_idx, b_idx))\n\n        # Consider neighbor (a_idx, b_idx + 1)\n        next_b_idx = b_idx + 1\n        if next_b_idx < m and (a_idx, next_b_idx) not in visited:\n            new_product = sorted_A[a_idx] * sorted_B[next_b_idx]\n            new_pair_obj = ProductPair(a_idx, next_b_idx, new_product)\n            heapq.heappush(heap, (-new_product, a_idx, next_b_idx, new_pair_obj))\n            visited.add((a_idx, next_b_idx))\n\n    # 7. Return the collected products.\n    return results"}
{"task_id": "Mbpp/311", "solution": "def set_left_most_unset_bit(n: int) -> int:\n    # Input validation\n    if not isinstance(n, int):\n        raise TypeError('n must be int')\n    if n < 0:\n        raise ValueError('n must be non-negative')\n\n    if n == 0:\n        return 1\n\n    width = n.bit_length()\n    mask_width = (1 << width) - 1\n\n    zeros = (~n) & mask_width\n\n    if zeros != 0:\n        p = zeros.bit_length() - 1\n        return n | (1 << p)\n    else:\n        return n | (1 << width)"}
{"task_id": "Mbpp/388", "solution": "def highest_Power_of_2(n: int) -> int:\n    \"\"\"Finds the highest power of 2 less than or equal to n for n >= 1.\n\n    Args:\n        n (int): The input integer (must be int and >= 1).\n\n    Returns:\n        int: The largest power of two 2**k such that 2**k <= n.\n\n    Raises:\n        TypeError: If n is not an int (this treats bool as non-int).\n        ValueError: If n < 1.\n    \"\"\"\n    if type(n) is not int:\n        raise TypeError(\"n must be an int\")\n    if n < 1:\n        raise ValueError(\"n must be >= 1\")\n\n    k = n.bit_length() - 1\n    return 1 << k"}
{"task_id": "Mbpp/390", "solution": "def add_string(elements: list, format_string: str) -> list:\n    \"\"\"\n    Applies a given format string to each element in a list, returning a new list of formatted strings.\n    Performs type validation and propagates any exceptions during formatting.\n    \"\"\"\n    if not isinstance(elements, list):\n        raise TypeError(\"elements must be a list\")\n    if not isinstance(format_string, str):\n        raise TypeError(\"format_string must be a str\")\n\n    result = []\n    for element in elements:\n        formatted = format_string.format(element)\n        result.append(formatted)\n    return result"}
{"task_id": "Mbpp/389", "solution": "def find_lucas(n):\n    \"\"\"\n    Compute the n-th Lucas number using an iterative approach.\n    It defines L(0)=2, L(1)=1, and L(n)=L(n-1)+L(n-2) for n >= 2.\n\n    Parameters:\n    - n (int): non-negative integer index of the Lucas sequence.\n\n    Returns:\n    - int: the n-th Lucas number.\n\n    Raises:\n    - ValueError: if n is not an int or is negative.\n    \"\"\"\n    if not isinstance(n, int) or n < 0:\n        raise ValueError(\"n must be a non-negative integer\")\n\n    if n == 0:\n        return 2\n    if n == 1:\n        return 1\n\n    # Initialize a and b with L(0) and L(1) respectively.\n    a, b = 2, 1\n\n    # Iterate from the 2nd Lucas number up to the n-th.\n    for _ in range(2, n + 1):\n        next_lucas = a + b\n        a = b\n        b = next_lucas\n    return b"}
{"task_id": "Mbpp/391", "solution": "from typing import Any, List, Dict, Sequence\n\ndef convert_list_dictionary(*sequences: Sequence[Any]) -> List[Dict[Any, Any]]:\n    \"\"\"\n    Convert two or more lists/tuples into a list of nested dictionaries.\n\n    Parameters:\n      *sequences: two or more positional arguments; each must be a list or tuple.\n                  Each sequence must have equal length.\n\n    Returns:\n      list of dictionaries built per index as specified.\n\n    Raises:\n      TypeError or ValueError with exact messages as specified in requirements.\n    \"\"\"\n    # 1. Validate minimum number of arguments\n    if len(sequences) < 2:\n        raise TypeError(\"convert_list_dictionary requires at least two iterables\")\n\n    # 2. Validate types of input sequences\n    for seq in sequences:\n        if seq is None:\n            raise TypeError(\"All inputs must be lists or tuples\")\n        if isinstance(seq, str):\n            raise TypeError(\"Inputs must be non-string iterables (list or tuple)\")\n        if not isinstance(seq, (list, tuple)):\n            raise TypeError(\"All inputs must be lists or tuples\")\n\n    # 3. Validate lengths of input sequences\n    # If sequences is empty after validation, it means len < 2, which is caught above.\n    # So sequences[0] is safe to access here.\n    n = len(sequences[0])\n    for seq in sequences[1:]:\n        if len(seq) != n:\n            raise ValueError(\"All input lists must have the same length\")\n\n    # 4. Build result list of nested dictionaries\n    result: List[Dict[Any, Any]] = []\n    k = len(sequences) # k is the number of input sequences\n\n    for i in range(n):\n        outer_key = sequences[0][i]\n\n        if k == 2:\n            # Simple two-level mapping: {outer_key: value_from_second_sequence}\n            element = {outer_key: sequences[1][i]}\n        else:\n            # Build nested dictionaries starting from the innermost value\n            # The last sequence's element is the deepest value\n            nested_value = sequences[k - 1][i]\n            # Iterate backwards from the second-to-last sequence up to the second sequence\n            # (index k-2 down to 1)\n            for idx in range(k - 2, 0, -1):\n                key = sequences[idx][i]\n                nested_value = {key: nested_value}\n\n            # The outermost nesting for this element\n            element = {outer_key: nested_value}\n\n        result.append(element)\n\n    return result"}
{"task_id": "Mbpp/392", "solution": "_memo = {}\n\ndef get_max_sum(n):\n    \"\"\"\n    Computes the maximum sum f(n) using the recurrence f(n) = max((f(n/2) + f(n/3) + f(n/4) + f(n/5)), n).\n    Results are memoized to optimize performance for repeated subproblems.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an int\")\n    if n < 0:\n        raise ValueError(\"n must be non-negative\")\n\n    if n == 0:\n        return 0\n\n    if n in _memo:\n        return _memo[n]\n\n    val_n2 = get_max_sum(n // 2)\n    val_n3 = get_max_sum(n // 3)\n    val_n4 = get_max_sum(n // 4)\n    val_n5 = get_max_sum(n // 5)\n\n    sum_subproblems = val_n2 + val_n3 + val_n4 + val_n5\n\n    result = max(sum_subproblems, n)\n\n    _memo[n] = result\n    return result"}
{"task_id": "Mbpp/394", "solution": "def check_distinct(seq):\n    \"\"\"\n    Checks if the given tuple contains no duplicate elements.\n    Uses a set for hashable items and falls back to pairwise comparison for unhashable items.\n    \"\"\"\n    if not isinstance(seq, tuple):\n        raise TypeError(\"Input must be a tuple\")\n\n    n = len(seq)\n    if n <= 1:\n        return True\n\n    seen = set()\n    use_set_path = True\n\n    for item in seq:\n        try:\n            if item in seen:\n                return False\n            seen.add(item)\n        except TypeError:\n            use_set_path = False\n            break\n\n    if use_set_path:\n        return True\n\n    # Fallback to pairwise comparison for unhashable items or mixed types\n    for i in range(n):\n        for j in range(i + 1, n):\n            if seq[i] == seq[j]:\n                return False\n    return True"}
{"task_id": "Mbpp/395", "solution": "from collections import Counter\nfrom typing import Optional\n\ndef first_non_repeating_character(s: str) -> Optional[str]:\n    \"\"\"\n    Finds the first non-repeated character in a string using a two-pass hash-count algorithm.\n    Returns the first character whose total occurrences equal 1, or None if no such character exists.\n\n    Args:\n        s: Input string (must be a str).\n\n    Returns:\n        A single-character string (the first non-repeating character) or None if none exists.\n\n    Raises:\n        TypeError: If s is not an instance of str.\n    \"\"\"\n    if not isinstance(s, str):\n        raise TypeError(\"s must be a str\")\n\n    char_counts = Counter(s)\n\n    for char in s:\n        if char_counts[char] == 1:\n            return char\n\n    return None"}
{"task_id": "Mbpp/397", "solution": "import math\n\ndef median_numbers(a, b, c):\n    \"\"\"\n    Returns the median of three numeric inputs.\n    Raises TypeError if inputs are not int/float, ValueError if any input is NaN.\n    Example: assert median_numbers(1, 2, 3) == 2\n    \"\"\"\n    inputs = [a, b, c]\n    for x in inputs:\n        if not isinstance(x, (int, float)):\n            raise TypeError(f\"All inputs must be numbers (int or float), got {type(x).__name__}.\")\n        if isinstance(x, float) and math.isnan(x):\n            raise ValueError(\"NaN is not allowed as an input.\")\n\n    any_float_input = any(isinstance(x, float) for x in inputs)\n\n    # Comparison-based branch logic to find the median\n    if a <= b:\n        if b <= c:\n            median_val = b\n        else:  # b > c\n            median_val = c if a <= c else a\n    else:  # a > b\n        if a <= c:\n            median_val = a\n        else:  # a > c\n            median_val = c if b <= c else b\n\n    # Adjust return type based on original inputs\n    if any_float_input:\n        return float(median_val)\n    else:\n        return int(median_val)"}
{"task_id": "Mbpp/398", "solution": "def sum_of_digits(numbers: list) -> int:\n    \"\"\"Computes the total sum of decimal digits across numbers in a list.\n\n    Handles:\n    - int: sum digits of abs(value)\n    - float: truncate toward zero with int(value), then sum digits of abs(truncated)\n    - str: parsed with int(s); on success sum digits of abs(parsed); on failure raise ValueError\n\n    Raises:\n    - TypeError for unsupported element types\n    - ValueError for strings that cannot be parsed as integers\n    \"\"\"\n    def _sum_digits_of_int(n: int) -> int:\n        \"\"\"Helper to sum the decimal digits of a non-negative integer using integer arithmetic.\"\"\"\n        total = 0\n        if n == 0:\n            return 0\n        while n > 0:\n            total += n % 10\n            n //= 10\n        return total\n\n    total_sum = 0\n    for item in numbers:\n        if isinstance(item, int):\n            total_sum += _sum_digits_of_int(abs(item))\n        elif isinstance(item, float):\n            total_sum += _sum_digits_of_int(abs(int(item)))\n        elif isinstance(item, str):\n            try:\n                parsed_int = int(item)\n                total_sum += _sum_digits_of_int(abs(parsed_int))\n            except ValueError:\n                raise ValueError(f\"String element '{item}' cannot be parsed as an integer.\")\n        else:\n            raise TypeError(f\"Unsupported element type: {type(item)}. Expected int, float, or str.\")\n    return total_sum"}
{"task_id": "Mbpp/404", "solution": "def _check_numeric(x) -> None:\n    \"\"\"Helper to validate if x is an int or float, raising TypeError if not.\"\"\"\n    if not isinstance(x, (int, float)):\n        raise TypeError(\"minimum: inputs must be int or float\")\n\ndef minimum(a, b):\n    \"\"\"\n    Finds the minimum of two numeric values.\n    Raises TypeError if inputs are not int or float.\n    \"\"\"\n    _check_numeric(a)\n    _check_numeric(b)\n    return a if a <= b else b"}
{"task_id": "Mbpp/405", "solution": "def check_tuplex(container, element):\n    \"\"\"\n    Check whether `element` exists within the tuple `container`.\n\n    Parameters:\n    - container: tuple - the tuple to search (must be a tuple)\n    - element: any - the element to search for\n\n    Returns:\n    - bool: True if element == any item in container, otherwise False\n\n    Raises:\n    - TypeError: if container is not a tuple\n    \"\"\"\n    if not isinstance(container, tuple):\n        raise TypeError(\"container must be a tuple\")\n\n    for item in container:\n        if item == element:\n            return True\n    return False"}
{"task_id": "Mbpp/406", "solution": "def find_Parity(n):\n    \"\"\"\n    Finds whether the parity of a given number is odd.\n    Returns True if n is odd, False if n is even.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be int\")\n    return (n % 2) != 0"}
{"task_id": "Mbpp/409", "solution": "from typing import Any, Union\n\ndef min_product_tuple(data: Any) -> Union[int, float]:\n    \"\"\"\n    Finds the minimum product from pairs of numeric elements within tuples in a list.\n    Validates input for type, emptiness, tuple structure, and numeric elements (int/float only, bool excluded).\n    Raises TypeError or ValueError on invalid input; operates in O(n) time and O(1) space.\n    \"\"\"\n\n    def _is_numeric(value: Any) -> bool:\n        \"\"\"Checks if a value is an int or float, explicitly excluding bool.\"\"\"\n        return isinstance(value, (int, float)) and not isinstance(value, bool)\n\n    if not isinstance(data, list):\n        raise TypeError(\"Input must be a list.\")\n    if not data:\n        raise ValueError(\"Input list cannot be empty.\")\n\n    min_product: Union[int, float, None] = None\n\n    for item in data:\n        if not isinstance(item, tuple):\n            raise TypeError(f\"List item '{item}' must be a tuple.\")\n\n        if len(item) != 2:\n            raise ValueError(f\"Tuple '{item}' must contain exactly two elements.\")\n\n        a, b = item\n\n        if not _is_numeric(a) or not _is_numeric(b):\n            raise TypeError(f\"Tuple elements '{a}' and '{b}' must be numeric (int or float).\")\n\n        current_product = a * b\n\n        if min_product is None or current_product < min_product:\n            min_product = current_product\n\n    # min_product is guaranteed to be initialized because the input list is not empty.\n    return min_product"}
{"task_id": "Mbpp/413", "solution": "def extract_nth_element(list_of_tuples, n):\n    \"\"\"\n    Extracts the nth element from each tuple in a list of tuples.\n    Raises TypeError for invalid input types or IndexError if an index is out of bounds.\n    \"\"\"\n    if not isinstance(list_of_tuples, list):\n        raise TypeError(\"list_of_tuples must be a list\")\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an int\")\n\n    result = []\n    for t in list_of_tuples:\n        if not isinstance(t, tuple):\n            raise TypeError(\"all elements of list_of_tuples must be tuples\")\n        try:\n            result.append(t[n])\n        except IndexError:\n            raise\n    return result"}
{"task_id": "Mbpp/410", "solution": "import numbers\nimport math\n\ndef min_val(items: list) -> numbers.Real:\n    \"\"\"\n    Finds the minimum numeric value in a heterogeneous list, ignoring non-numeric elements and NaNs.\n    Raises TypeError for non-list inputs and ValueError if no valid numeric elements are found.\n    \"\"\"\n    if not isinstance(items, list):\n        raise TypeError(\"Input must be a list.\")\n\n    def _is_numeric_real(x) -> bool:\n        \"\"\"Returns True if the item is an instance of numbers.Real, False otherwise.\"\"\"\n        return isinstance(x, numbers.Real)\n\n    def _is_nan(x) -> bool:\n        \"\"\"Detects if a numeric item is NaN for float and Decimal types.\"\"\"\n        if isinstance(x, float):\n            return math.isnan(x)\n        elif hasattr(x, \"is_nan\"): # Covers Decimal.is_nan()\n            return x.is_nan()\n        return False\n\n    current_min = None\n    found_numeric = False\n\n    for x in items:\n        if not _is_numeric_real(x):\n            continue\n        if _is_nan(x):\n            continue\n\n        if not found_numeric:\n            current_min = x\n            found_numeric = True\n        else:\n            if x < current_min:\n                current_min = x\n\n    if not found_numeric:\n        raise ValueError(\"No numeric non-NaN elements found in the list.\")\n\n    return current_min"}
{"task_id": "Mbpp/412", "solution": "from typing import Optional, List, Any\n\ndef remove_odd(numbers: Optional[List[Any]]) -> List[Any]:\n    \"\"\"\n    Removes odd integers from an input list and returns a new list.\n\n    Non-integer items are preserved, and all remaining items maintain their relative order.\n    If the input 'numbers' is None or an empty list, an empty list is returned.\n\n    Example:\n    >>> remove_odd([1, 2, 'a', 3])\n    [2, 'a']\n    \"\"\"\n    if numbers is None:\n        return []\n\n    result: List[Any] = []\n    for item in numbers:\n        # Check if the item is an integer and is odd (item % 2 != 0)\n        if isinstance(item, int) and item % 2 != 0:\n            continue  # Skip odd integers\n        else:\n            result.append(item)  # Keep non-integers and even integers\n    return result"}
{"task_id": "Mbpp/418", "solution": "def Find_Max(lst):\n    \"\"\"\n    Finds the element from a list with the maximum length, ignoring elements without a length.\n    Returns None if the list is empty or no elements support len().\n    \"\"\"\n    best_elem = None\n    best_len = -1\n\n    for element in lst:\n        try:\n            current_len = len(element)\n            if current_len > best_len:\n                best_len = current_len\n                best_elem = element\n        except TypeError:\n            # Ignore elements for which len() raises a TypeError.\n            pass\n\n    return best_elem"}
{"task_id": "Mbpp/415", "solution": "from typing import List, Tuple, Optional\n\nclass Element:\n    \"\"\"Helper class to store a value and its original index.\"\"\"\n    def __init__(self, value: int, index: int):\n        self.value = value\n        self.index = index\n\nclass Validator:\n    \"\"\"Helper class to encapsulate input validation logic.\"\"\"\n    @staticmethod\n    def validate_sequence(obj) -> None:\n        \"\"\"Raises TypeError if the input object is not a list or tuple.\"\"\"\n        if not isinstance(obj, (list, tuple)):\n            raise TypeError(\"Input must be a sequence (e.g., list or tuple).\")\n\n    @staticmethod\n    def validate_elements(seq) -> None:\n        \"\"\"Raises TypeError if any element in the sequence is not an integer.\"\"\"\n        for element in seq:\n            if not isinstance(element, int):\n                raise TypeError(\"All elements in the sequence must be integers.\")\n\nclass Tracker:\n    \"\"\"Tracks the two largest and two smallest elements along with their earliest indices.\"\"\"\n    def __init__(self):\n        self.max1_v, self.max1_i = float('-inf'), -1\n        self.max2_v, self.max2_i = float('-inf'), -1\n        self.min1_v, self.min1_i = float('inf'), -1\n        self.min2_v, self.min2_i = float('inf'), -1\n\n    def update(self, value: int, index: int) -> None:\n        \"\"\"Updates the tracked max/min values, ensuring distinct indices and earliest index for ties.\"\"\"\n        # Update maximums\n        if value > self.max1_v:\n            self.max2_v, self.max2_i = self.max1_v, self.max1_i\n            self.max1_v, self.max1_i = value, index\n        elif value == self.max1_v and (self.max1_i == -1 or index < self.max1_i):\n            self.max1_i = index\n        elif value > self.max2_v:\n            if index != self.max1_i:\n                self.max2_v, self.max2_i = value, index\n        elif value == self.max2_v:\n            if index != self.max1_i and (self.max2_i == -1 or index < self.max2_i):\n                self.max2_i = index\n\n        # Update minimums (symmetric logic)\n        if value < self.min1_v:\n            self.min2_v, self.min2_i = self.min1_v, self.min1_i\n            self.min1_v, self.min1_i = value, index\n        elif value == self.min1_v and (self.min1_i == -1 or index < self.min1_i):\n            self.min1_i = index\n        elif value < self.min2_v:\n            if index != self.min1_i:\n                self.min2_v, self.min2_i = value, index\n        elif value == self.min2_v:\n            if index != self.min1_i and (self.min2_i == -1 or index < self.min2_i):\n                self.min2_i = index\n\ndef max_Product(nums: List[int]) -> Tuple[int, int]:\n    \"\"\"\n    Finds a pair of integers from the given array with the highest product.\n    Returns the pair as a tuple (value1, value2), ordered by their original input indices.\n    \"\"\"\n    Validator.validate_sequence(nums)\n    Validator.validate_elements(nums)\n\n    if len(nums) < 2:\n        raise ValueError(\"Input array must contain at least two elements.\")\n\n    tracker = Tracker()\n    for index, value in enumerate(nums):\n        tracker.update(value, index)\n\n    max1_el = Element(int(tracker.max1_v), tracker.max1_i)\n    max2_el = Element(int(tracker.max2_v), tracker.max2_i)\n    min1_el = Element(int(tracker.min1_v), tracker.min1_i)\n    min2_el = Element(int(tracker.min2_v), tracker.min2_i)\n\n    product_of_max = max1_el.value * max2_el.value\n    product_of_min = min1_el.value * min2_el.value\n\n    chosen_el1: Element\n    chosen_el2: Element\n\n    if product_of_max > product_of_min:\n        chosen_el1, chosen_el2 = max1_el, max2_el\n    elif product_of_min > product_of_max:\n        chosen_el1, chosen_el2 = min1_el, min2_el\n    else:\n        # Products are equal, apply lexicographical tie-breaking for indices\n        max_pair_indices = (min(max1_el.index, max2_el.index), max(max1_el.index, max2_el.index))\n        min_pair_indices = (min(min1_el.index, min2_el.index), max(min1_el.index, min2_el.index))\n\n        if max_pair_indices < min_pair_indices:\n            chosen_el1, chosen_el2 = max1_el, max2_el\n        else:\n            chosen_el1, chosen_el2 = min1_el, min2_el\n\n    if chosen_el1.index <= chosen_el2.index:\n        return (chosen_el1.value, chosen_el2.value)\n    else:\n        return (chosen_el2.value, chosen_el1.value)"}
{"task_id": "Mbpp/414", "solution": "import collections.abc\nimport itertools\n\ndef _ensure_iterable(obj):\n    \"\"\"Ensures an object is iterable and returns its iterator.\"\"\"\n    try:\n        return iter(obj)\n    except TypeError:\n        raise TypeError(f\"'{type(obj).__name__}' object is not iterable\")\n\ndef _peek_iterable_empty_check_and_clone(iterable):\n    \"\"\"\n    Checks if an iterable is empty without consuming it fully for single-pass iterables,\n    and returns an iterator ready for use.\n    Returns (iterator, is_empty_flag).\n    \"\"\"\n    it = iter(iterable)\n    try:\n        first_item = next(it)\n        # Chain the first item back to the iterator so it's not lost\n        return itertools.chain([first_item], it), False\n    except StopIteration:\n        return iter([]), True # Empty iterable\n\ndef _collect_hashables(iterable):\n    \"\"\"\n    Partitions elements from an iterable into a set of hashables and a list of unhashables.\n    Returns (hashables_set, unhashables_list).\n    \"\"\"\n    hashables_set = set()\n    unhashables_list = []\n    for item in iterable:\n        try:\n            hash(item)\n            hashables_set.add(item)\n        except TypeError:\n            unhashables_list.append(item)\n    return hashables_set, unhashables_list\n\ndef _contains_via_set_and_unhashables(target_iter, hashables_set, unhashables_list):\n    \"\"\"\n    Checks if any element in target_iter exists in hashables_set (fast)\n    or matches any element in unhashables_list (pairwise).\n    \"\"\"\n    for item in target_iter:\n        try:\n            if item in hashables_set:\n                return True\n        except TypeError:\n            # If item is unhashable, it cannot be in hashables_set; proceed to unhashables_list comparison.\n            pass\n\n        for unhashable_elem in unhashables_list:\n            if item == unhashable_elem:\n                return True\n    return False\n\ndef _pairwise_compare(iter1, iter2):\n    \"\"\"\n    Compares every element in iter1 with every element in iter2 using equality.\n    Converts iter2 to a list for repeated iteration.\n    \"\"\"\n    list2 = list(iter2) # Materialize target_iter for efficient repeated inner loop comparisons\n    for item1 in iter1:\n        for item2 in list2:\n            if item1 == item2:\n                return True\n    return False\n\ndef overlapping(seq1, seq2):\n    \"\"\"\n    Checks whether any value in a sequence exists in another sequence.\n    \"\"\"\n    # Validate iterability of both arguments\n    iter1_obj = _ensure_iterable(seq1)\n    iter2_obj = _ensure_iterable(seq2)\n\n    # Check for emptiness and get usable iterators\n    iter1_cloned, empty1 = _peek_iterable_empty_check_and_clone(iter1_obj)\n    iter2_cloned, empty2 = _peek_iterable_empty_check_and_clone(iter2_obj)\n\n    if empty1 or empty2:\n        return False\n\n    # Materialize iterators into lists to allow multiple passes and length checks\n    list1 = list(iter1_cloned)\n    list2 = list(iter2_cloned)\n\n    # Re-check emptiness after materialization\n    if not list1 or not list2:\n        return False\n\n    # Choose the smaller list for set building to minimize memory usage\n    if len(list1) <= len(list2):\n        source_list, target_list = list1, list2\n    else:\n        source_list, target_list = list2, list1\n\n    # Partition elements from the source_list into hashables and unhashables\n    source_hashables, source_unhashables = _collect_hashables(source_list)\n\n    # Apply the primary comparison strategy (set-based and hybrid for unhashables)\n    if source_hashables or source_unhashables:\n        if _contains_via_set_and_unhashables(target_list, source_hashables, source_unhashables):\n            return True\n\n    # Fallback to full pairwise comparison if the source_list was entirely composed of unhashable items\n    # and the hybrid approach did not find a match.\n    if not source_hashables and source_unhashables:\n        # Perform full pairwise comparison using the original materialized lists.\n        return _pairwise_compare(list1, list2)\n\n    # No overlapping elements found by any method\n    return False"}
{"task_id": "Mbpp/421", "solution": "def concatenate_tuple(input_tuple):\n    # Converts each element of the tuple to its string representation.\n    # Then, it joins these string representations using a hyphen as a delimiter.\n    return '-'.join(str(e) for e in input_tuple)"}
{"task_id": "Mbpp/419", "solution": "def round_and_sum(input_list):\n    \"\"\"Rounds numbers in a list, sums them, multiplies by list length, prints, and returns the result.\n\n    Uses Python's built-in round() (ties-to-even). Raises TypeError for invalid inputs.\n    \"\"\"\n\n    def _validate_input(lst):\n        \"\"\"Validates that the input is a list and all its elements are numeric.\"\"\"\n        if not isinstance(lst, list):\n            raise TypeError(\"input must be a list\")\n        for idx, val in enumerate(lst):\n            if not isinstance(val, (int, float)):\n                raise TypeError(f\"non-numeric element at index {idx}: {val!r}\")\n\n    def _compute_rounded_sum(lst):\n        \"\"\"Computes the sum of rounded numeric elements in the list.\"\"\"\n        running_sum = 0\n        for val in lst:\n            rounded_val = round(val)\n            running_sum += int(rounded_val)\n        return running_sum\n\n    _validate_input(input_list)\n\n    if not input_list:\n        print(0)\n        return 0\n\n    running_sum = _compute_rounded_sum(input_list)\n    final_result = running_sum * len(input_list)\n\n    print(final_result)\n    return final_result"}
{"task_id": "Mbpp/424", "solution": "def _validate_elements_are_str(tup: tuple) -> None:\n    \"\"\"Validates that all elements in the tuple are strings, raising TypeError if not.\"\"\"\n    for idx, e in enumerate(tup):\n        if not isinstance(e, str):\n            raise TypeError(f\"All elements of tup must be of type str; element at index {idx} is {type(e).__name__}\")\n\ndef extract_rear(tup: tuple) -> list:\n    \"\"\"\n    Extracts the rear (last) index element of each string in the given tuple.\n    Raises TypeError if any element in the input tuple is not a string.\n    \"\"\"\n    _validate_elements_are_str(tup)\n\n    output = []\n    for s in tup:\n        if s == '':\n            output.append('')\n        else:\n            output.append(s[-1])\n\n    return output"}
{"task_id": "Mbpp/420", "solution": "def cube_Sum(n: int) -> int:\n    \"\"\"Calculates the sum of cubes of the first n even natural numbers using a closed-form formula.\n    The formula used is S(n) = 2 * n^2 * (n + 1)^2.\n\n    Note: This implementation assumes `n` is a non-negative integer.\n    \"\"\"\n    # Input validation\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n    if n < 0:\n        raise ValueError(\"n must be non-negative\")\n\n    # Compute using integer arithmetic to avoid floating point\n    n_squared = n * n\n    n_plus_1 = n + 1\n    n_plus_1_squared = n_plus_1 * n_plus_1\n\n    return 2 * n_squared * n_plus_1_squared"}
{"task_id": "Mbpp/422", "solution": "def find_Average_Of_Cube(n):\n    \"\"\"Calculates the average of the cubes of the first n natural numbers.\n\n    Uses the closed-form identity:\n      sum_{k=1..n} k^3 = (n(n+1)/2)^2\n    Therefore average = [sum]/n = n*(n+1)^2 / 4\n\n    Input rules:\n    - Accepts int and integral-valued float (e.g., 3.0).\n    - Raises TypeError for non-integer types or non-integral floats.\n    - Raises ValueError for n <= 0.\n\n    Returns:\n    - float result of the average.\n    \"\"\"\n    # Validate and normalize the input 'n'.\n    if isinstance(n, int):\n        normalized_n = n\n    elif isinstance(n, float):\n        if n.is_integer():\n            normalized_n = int(n)\n        else:\n            raise TypeError(\"n must be an integer\")\n    else:\n        raise TypeError(\"n must be an integer\")\n\n    # Ensure 'n' is a positive integer.\n    if normalized_n <= 0:\n        raise ValueError(\"n must be a positive integer\")\n\n    # Compute the average using the formula: n * (n + 1)^2 / 4.\n    numerator = normalized_n * (normalized_n + 1) ** 2\n    average = numerator / 4.0\n\n    return average"}
{"task_id": "Mbpp/425", "solution": "def count_element_in_list(list_of_lists, element) -> int:\n    \"\"\"Count how many sublists in list_of_lists contain element at least once.\n\n    Raises:\n        TypeError: if list_of_lists is not iterable or if any sub-item is not iterable.\n    \"\"\"\n    try:\n        iter(list_of_lists)\n    except TypeError:\n        raise TypeError(\"list_of_lists must be an iterable of iterables\")\n\n    count = 0\n    for sub in list_of_lists:\n        try:\n            if element in sub:\n                count += 1\n        except TypeError:\n            raise TypeError(\"each item of list_of_lists must be an iterable (e.g., list)\")\n    return count"}
{"task_id": "Mbpp/426", "solution": "from typing import List\n\ndef filter_oddnumbers(numbers: List[int]) -> List[int]:\n    \"\"\"Filters a list of integers, returning a new list containing only the odd numbers.\"\"\"\n    return [n for n in numbers if n % 2 != 0]"}
{"task_id": "Mbpp/429", "solution": "def and_tuples(a: tuple, b: tuple) -> tuple:\n    \"\"\"\n    Computes the elementwise bitwise AND of two input tuples of integers.\n    Validates inputs for type and length before computation.\n    \"\"\"\n\n    def _validate_is_tuple(obj, name):\n        \"\"\"Raises TypeError if obj is not a tuple.\"\"\"\n        if not isinstance(obj, tuple):\n            raise TypeError(f\"{name} must be a tuple\")\n\n    def _validate_same_length(tup1, tup2):\n        \"\"\"Raises ValueError if tuples have different lengths.\"\"\"\n        if len(tup1) != len(tup2):\n            raise ValueError(\"input tuples must have the same length\")\n\n    def _validate_all_ints(tup, name):\n        \"\"\"Raises TypeError if any element in tup is not an int.\"\"\"\n        for x in tup:\n            if not isinstance(x, int):\n                raise TypeError(f\"all elements of {name} must be int\")\n\n    _validate_is_tuple(a, 'a')\n    _validate_is_tuple(b, 'b')\n\n    _validate_same_length(a, b)\n\n    if not a:\n        return ()\n\n    _validate_all_ints(a, 'a')\n    _validate_all_ints(b, 'b')\n\n    return tuple(a[i] & b[i] for i in range(len(a)))"}
{"task_id": "Mbpp/427", "solution": "import re\n\ndef change_date_format(date_str: str) -> str:\n    \"\"\"\n    Converts a date string from 'yyyy-mm-dd' to 'dd-mm-yyyy' format,\n    performing validation for format and date values.\n    \"\"\"\n    if not isinstance(date_str, str) or not date_str:\n        raise ValueError('date_str must be a non-empty str')\n\n    if not re.match(r'^\\d{4}-\\d{2}-\\d{2}$', date_str):\n        raise ValueError('invalid format: expected YYYY-MM-DD')\n\n    year = int(date_str[0:4])\n    month = int(date_str[5:7])\n    day = int(date_str[8:10])\n\n    if not (1 <= month <= 12):\n        raise ValueError(f'invalid month value: {month}')\n\n    # Days in month (non-leap year)\n    days_in_month = [0, 31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31]\n\n    # Check for leap year\n    is_leap = (year % 4 == 0 and (year % 100 != 0 or year % 400 == 0))\n    if is_leap:\n        days_in_month[2] = 29 # February has 29 days in a leap year\n\n    if not (1 <= day <= days_in_month[month]):\n        raise ValueError(f'invalid day {day} for month {month} in year {year}')\n\n    return f\"{day:02d}-{month:02d}-{year:04d}\""}
{"task_id": "Mbpp/428", "solution": "def shell_sort(data: list) -> list:\n    \"\"\"Sorts a list in-place using the Shell sort algorithm with Knuth gap sequence.\n\n    Shell sort is an in-place comparison sort that can be seen as a generalization\n    of insertion sort, allowing the exchange of items that are far apart.\n    This implementation uses the Knuth gap sequence (h = 3*h + 1).\n\n    Time Complexity:\n        Average/Worst-case: O(n^(3/2)) with Knuth gaps.\n        Best-case: O(n) for nearly-sorted input.\n    Space Complexity: O(1) auxiliary space (in-place sort).\n\n    Args:\n        data: The list of comparable elements to be sorted.\n\n    Returns:\n        The same list instance, sorted in ascending order.\n\n    Raises:\n        TypeError: If `data` is not a list or if elements are not mutually comparable.\n\n    Example:\n        >>> shell_sort([12, 23, 4, 5, 3, 2, 12, 81, 56, 95])\n        [2, 3, 4, 5, 12, 12, 23, 56, 81, 95]\n    \"\"\"\n    if not isinstance(data, list):\n        raise TypeError(\"shell_sort expects a list\")\n\n    n = len(data)\n\n    if n == 0 or n == 1:\n        return data\n\n    def _generate_knuth_gaps(n_val: int) -> list:\n        \"\"\"Generates Knuth sequence gaps for Shell sort in descending order.\"\"\"\n        gaps = []\n        h = 1\n        while h < n_val:\n            gaps.append(h)\n            h = 3 * h + 1\n        return list(reversed(gaps))\n\n    gaps = _generate_knuth_gaps(n)\n\n    for gap in gaps:\n        # Perform a gapped insertion sort for the current gap size.\n        for i in range(gap, n):\n            temp = data[i]\n            j = i\n            try:\n                # Shift elements that are larger than temp to the right.\n                while j >= gap and data[j - gap] > temp:\n                    data[j] = data[j - gap]\n                    j -= gap\n            except Exception as exc:\n                # Re-raise comparison errors as TypeError for non-comparable elements.\n                raise TypeError(\"elements are not mutually comparable\") from exc\n            data[j] = temp\n    return data"}
{"task_id": "Mbpp/432", "solution": "def median_trapezium(a, b, c=None):\n    \"\"\"Calculates the median length of a trapezium given its parallel bases.\n\n    The median (mid-segment) of a trapezium is the average of the lengths\n    of the two parallel bases: (a + b) / 2.\n\n    Args:\n        a (int|float): length of base 1.\n        b (int|float): length of base 2.\n        c (int|float|None): optional non-parallel side (ignored).\n\n    Returns:\n        float: the median length.\n\n    Example:\n        >>> median_trapezium(15, 25, 35)\n        20.0\n    \"\"\"\n    return (a + b) / 2"}
{"task_id": "Mbpp/433", "solution": "def check_greater(value, arr) -> bool:\n    \"\"\"Return True iff value is strictly greater than every numeric element in arr.\n\n    Parameters\n    - value (int|float): numeric scalar to compare\n    - arr (iterable[int|float]): iterable of numeric scalars\n\n    Returns\n    - bool: True if value > every element of arr; True if arr is empty; False otherwise\n\n    Raises\n    - TypeError: if value is not int or float; if arr is not iterable; if any element of arr is not int or float\n\n    Examples\n    >>> check_greater(10, [1, 2, 3])\n    True\n\n    >>> check_greater(3, [1, 3, 2])\n    False\n\n    >>> check_greater(5, [])\n    True\n    \"\"\"\n    if not isinstance(value, (int, float)):\n        raise TypeError(\"value must be an int or float\")\n\n    try:\n        iterator = iter(arr)\n    except TypeError:\n        raise TypeError(\"arr must be an iterable of int or float\")\n\n    for elem in iterator:\n        if not isinstance(elem, (int, float)):\n            raise TypeError(\"all elements of arr must be int or float\")\n        if elem >= value:\n            return False\n\n    return True"}
{"task_id": "Mbpp/435", "solution": "from typing import Union\n\ndef last_Digit(n: Union[int, float, str]) -> int:\n  \"\"\"\n  last_Digit(n: Union[int, float, str]) -> int\n\n  Parameters:\n    n (int | float | str): The input value. Accepted types:\n      - int: returns last decimal digit of abs(n) (0..9).\n      - float: if mathematically whole (fractional part zero), treated as integer; otherwise raises ValueError.\n      - str: must represent an integer optionally with '+' or '-' sign and parseable by int(); otherwise raises ValueError.\n\n  Returns:\n    int: last decimal digit (0..9) of the numeric value represented by n.\n\n  Raises:\n    ValueError: for floats with non-zero fractional part, or strings that cannot be parsed as an integer.\n    TypeError: for input types other than int, float, or str.\n  \"\"\"\n  if isinstance(n, int):\n    return abs(n) % 10\n  elif isinstance(n, float):\n    if n.is_integer():\n      return abs(int(n)) % 10\n    else:\n      raise ValueError(\"float has non-zero fractional part\")\n  elif isinstance(n, str):\n    try:\n      parsed = int(n)\n    except ValueError:\n      raise ValueError(\"string not parseable as integer\")\n    else:\n      return abs(parsed) % 10\n  else:\n    raise TypeError(\"unsupported input type\")"}
{"task_id": "Mbpp/430", "solution": "import math\nfrom dataclasses import dataclass\n\n@dataclass\nclass Vertex:\n    h: float\n    k: float\n\n@dataclass\nclass Focus:\n    x: float\n    y: float\n\n@dataclass\nclass Directrix:\n    A: float\n    B: float\n    C: float\n    _is_vertical_axis: bool = False\n    _is_horizontal_axis: bool = False\n    _constant_value: float = None\n\ndef _select_input_set(a: float, b: float, c: float, h_param: float, k_param: float, p_param: float,\n                      focus_tuple: tuple, vertex_tuple: tuple) -> str:\n    _h, _k = h_param, k_param\n    if vertex_tuple is not None:\n        _h, _k = vertex_tuple[0], vertex_tuple[1]\n\n    if focus_tuple is not None and _h is not None and _k is not None:\n        return 'focus_vertex'\n    if _h is not None and _k is not None and p_param is not None:\n        return 'vertex_p'\n    if _h is not None and _k is not None and a is not None:\n        return 'vertex_a'\n    if a is not None and b is not None and c is not None:\n        return 'coeffs'\n    raise ValueError(\"Insufficient parameters to define a parabola.\")\n\ndef _compute_vertex_from_coeffs(a: float, b: float, c: float, tol: float) -> tuple[float, float]:\n    if abs(a) < tol:\n        raise ValueError(f\"Coefficient 'a' cannot be zero (within tolerance {tol}). Not a parabola of type y=ax^2+bx+c.\")\n    h = -b / (2 * a)\n    k = c - b**2 / (4 * a)\n    return h, k\n\ndef _compute_directrix_from_vertex_p(h: float, k: float, p: float, horizontal: bool, tol: float) -> Directrix:\n    if abs(p) < tol:\n        raise ValueError(f\"Focal length 'p' cannot be zero (within tolerance {tol}). Focus and vertex coincide.\")\n    if not horizontal:\n        constant_value = k - p\n        A, B, C = 0.0, 1.0, -constant_value\n        return Directrix(A=A, B=B, C=C, _is_horizontal_axis=True, _constant_value=constant_value)\n    else:\n        constant_value = h - p\n        A, B, C = 1.0, 0.0, -constant_value\n        return Directrix(A=A, B=B, C=C, _is_vertical_axis=True, _constant_value=constant_value)\n\ndef _compute_directrix_from_focus_vertex(focus: Focus, vertex: Vertex, tol: float) -> Directrix:\n    vx = focus.x - vertex.h\n    vy = focus.y - vertex.k\n    p = math.sqrt(vx**2 + vy**2)\n    if p < tol:\n        raise ValueError(f\"Focus and vertex are too close (distance < {tol}). Not a well-defined parabola.\")\n    ux = vx / p\n    uy = vy / p\n    Dx = vertex.h - ux * p\n    Dy = vertex.k - uy * p\n    A = ux\n    B = uy\n    C = -(A * Dx + B * Dy)\n    is_vertical_directrix = abs(uy) < tol\n    is_horizontal_directrix = abs(ux) < tol\n    constant_value = None\n    if abs(ux) < tol:\n        is_horizontal_directrix = True\n        is_vertical_directrix = False\n        constant_value = Dy\n        A, B, C = 0.0, 1.0, -constant_value\n    elif abs(uy) < tol:\n        is_vertical_directrix = True\n        is_horizontal_directrix = False\n        constant_value = Dx\n        A, B, C = 1.0, 0.0, -constant_value\n    return Directrix(A=A, B=B, C=C,\n                     _is_vertical_axis=is_vertical_directrix,\n                     _is_horizontal_axis=is_horizontal_directrix,\n                     _constant_value=constant_value)\n\ndef _normalize_line(A: float, B: float, C: float, tol: float) -> tuple[float, float, float]:\n    magnitude = math.sqrt(A**2 + B**2)\n    if magnitude < tol:\n        raise ValueError(\"Cannot normalize degenerate line (A=0, B=0).\")\n    return A / magnitude, B / magnitude, C / magnitude\n\ndef _format_equation(d: Directrix) -> str:\n    if d._is_vertical_axis:\n        return f\"x = {d._constant_value:.10g}\"\n    elif d._is_horizontal_axis:\n        return f\"y = {d._constant_value:.10g}\"\n    else:\n        parts = []\n        if abs(d.A) > 1e-9:\n            parts.append(f\"{d.A:.10g}*x\")\n        if abs(d.B) > 1e-9:\n            if parts and d.B >= 0:\n                parts.append(f\"+ {d.B:.10g}*y\")\n            else:\n                parts.append(f\"{d.B:.10g}*y\")\n        if abs(d.C) > 1e-9:\n            if parts and d.C >= 0:\n                parts.append(f\"+ {d.C:.10g}\")\n            else:\n                parts.append(f\"{d.C:.10g}\")\n        if not parts:\n             return \"0 = 0\"\n        return f\"{' '.join(parts)} = 0\"\n\ndef parabola_directrix(a: float = None, b: float = None, c: float = None,\n                       h: float = None, k: float = None,\n                       p: float = None,\n                       focus: tuple = None,\n                       vertex: tuple = None,\n                       horizontal: bool = False,\n                       output: str = 'equation',\n                       tol: float = 1e-12) -> (str | tuple):\n    if output not in ['equation', 'coeffs']:\n        raise ValueError(\"Invalid output format. Must be 'equation' or 'coeffs'.\")\n    _h, _k = h, k\n    if vertex is not None:\n        _h, _k = vertex[0], vertex[1]\n    input_set = _select_input_set(a, b, c, _h, _k, p, focus, (_h, _k) if _h is not None and _k is not None else None)\n    directrix_result: Directrix = None\n    if input_set == 'focus_vertex':\n        _focus_obj = Focus(focus[0], focus[1])\n        _vertex_obj = Vertex(_h, _k)\n        directrix_result = _compute_directrix_from_focus_vertex(_focus_obj, _vertex_obj, tol)\n    elif input_set == 'vertex_p':\n        directrix_result = _compute_directrix_from_vertex_p(_h, _k, p, horizontal, tol)\n    elif input_set == 'vertex_a':\n        if abs(a) < tol:\n            raise ValueError(f\"Coefficient 'a' cannot be zero (within tolerance {tol}). Not a parabola.\")\n        _p_from_a = 1 / (4 * a)\n        directrix_result = _compute_directrix_from_vertex_p(_h, _k, _p_from_a, horizontal, tol)\n    elif input_set == 'coeffs':\n        _h_from_coeffs, _k_from_coeffs = _compute_vertex_from_coeffs(a, b, c, tol)\n        _p_from_coeffs = 1 / (4 * a)\n        directrix_result = _compute_directrix_from_vertex_p(_h_from_coeffs, _k_from_coeffs, _p_from_coeffs, horizontal, tol)\n    if directrix_result is None:\n        raise ValueError(\"Failed to compute directrix due to unexpected input conditions.\")\n    if output == 'coeffs':\n        norm_A, norm_B, norm_C = _normalize_line(directrix_result.A, directrix_result.B, directrix_result.C, tol)\n        return norm_A, norm_B, norm_C\n    else:\n        return _format_equation(directrix_result)"}
