{"task_id": "Mbpp/233", "solution": "import math\n\ndef lateralsuface_cylinder(r: float, h: float) -> float:\n    \"\"\"\n    Calculates the lateral surface area of a cylinder using the formula A = 2 * pi * r * h.\n\n    Parameters:\n    - r (int | float): radius of the cylinder (must be >= 0)\n    - h (int | float): height of the cylinder (must be >= 0)\n\n    Returns:\n    - float: lateral surface area\n\n    Notes:\n    - Returns 0.0 exactly if r == 0 or h == 0.\n    - This function does not explicitly reject bool inputs; if you want to treat bool as invalid,\n      add an explicit check (e.g., isinstance(value, bool) -> raise TypeError).\n    - Due to floating-point arithmetic, use math.isclose in tests:\n      assert math.isclose(lateralsuface_cylinder(10, 5), 314.15000000000003, rel_tol=0.001)\n    \"\"\"\n    if r == 0 or h == 0:\n        return 0.0\n\n    return 2.0 * math.pi * float(r) * float(h)"}
{"task_id": "Mbpp/234", "solution": "def _is_numeric(obj) -> bool:\n    return isinstance(obj, (int, float))\n\ndef _is_non_negative(value) -> bool:\n    return value >= 0\n\ndef volume_cube(side: float) -> float:\n    \"\"\"\n    Compute the volume of a cube for a given side length.\n\n    Parameters:\n        side (int | float): Side length of the cube. Must be an int or float and non-negative.\n\n    Returns:\n        float: The cube volume computed as side ** 3.\n\n    Raises:\n        TypeError: If side is not an int or float.\n        ValueError: If side is negative.\n\n    Examples:\n        >>> volume_cube(2)\n        8.0\n        >>> volume_cube(1.5)\n        3.375\n        >>> volume_cube(-1)\n        Traceback (most recent call last):\n            ...\n        ValueError: side must be non-negative\n    \"\"\"\n    if not _is_numeric(side):\n        raise TypeError(\"side must be an int or float\")\n    if not _is_non_negative(side):\n        raise ValueError(\"side must be non-negative\")\n    volume = side ** 3\n    return float(volume)"}
{"task_id": "Mbpp/232", "solution": "from typing import Any, List\n\ndef validate_types(list: List[Any], n: int) -> None:\n    \"\"\"Validates the types of the input list parameter and integer n.\n    Raises TypeError if types are incorrect.\n    \"\"\"\n    if not isinstance(list, list):\n        raise TypeError(\"First parameter must be a list.\")\n    if not isinstance(n, int):\n        raise TypeError(\"Second parameter n must be an integer.\")\n\ndef deduplicate(items: List[Any]) -> List[Any]:\n    \"\"\"Returns a list of unique items from the input list.\n    Attempts hash-based deduplication; falls back to equality-scanning for unhashable items.\n    \"\"\"\n    try:\n        # Hashable path: O(N) average time complexity\n        return list(set(items))\n    except TypeError:\n        # Unhashable path: O(N^2) worst-case time complexity\n        unique_list = []\n        for item in items:\n            if item not in unique_list:  # Uses item's __eq__ method\n                unique_list.append(item)\n        return unique_list\n\ndef sort_desc(items: List[Any]) -> List[Any]:\n    \"\"\"Sorts a list of items in descending order.\n    Raises TypeError if items are not mutually comparable.\n    \"\"\"\n    try:\n        return sorted(items, reverse=True)\n    except TypeError:\n        raise TypeError(\"Input items are not mutually comparable for sorting.\")\n\ndef slice_top(items: List[Any], n: int) -> List[Any]:\n    \"\"\"Returns the first n items from the provided list.\n    If n is greater than the list's length, all items are returned.\n    \"\"\"\n    return items[:n]\n\ndef larg_nnum(list: List[Any], n: int) -> List[Any]:\n    \"\"\"\n    Returns a list containing the n largest unique items from the input list.\n    The items are sorted in descending order (largest to smallest).\n    \"\"\"\n    validate_types(list, n)\n\n    if not list or n <= 0:\n        return []\n\n    unique_items = deduplicate(list)\n    sorted_items = sort_desc(unique_items)\n    return slice_top(sorted_items, n)"}
{"task_id": "Mbpp/237", "solution": "def check_occurences(input_list: list[tuple]) -> dict:\n    \"\"\"\n    Counts occurrences of canonicalized tuples in a list.\n    Canonicalization involves sorting the elements within each tuple.\n    \"\"\"\n    from collections import defaultdict\n\n    occurrence_counts = defaultdict(int)\n    for tup in input_list:\n        canonical_tup = tuple(sorted(tup))\n        occurrence_counts[canonical_tup] += 1\n    return dict(occurrence_counts)"}
{"task_id": "Mbpp/235", "solution": "def even_bit_set_number(number: int) -> int:\n    \"\"\"Sets all even-positioned bits (1-indexed) of a number up to its MSB.\"\"\"\n    if not isinstance(number, int):\n        raise TypeError(\"number must be an int\")\n    if number < 0:\n        raise ValueError(\"number must be non-negative\")\n    if number == 0:\n        return 0\n\n    # Calculate the 1-indexed position of the most significant bit.\n    msb_index = number.bit_length()\n\n    mask = 0\n    # Iterate through even 1-indexed bit positions up to the MSB.\n    # A 1-indexed position 'p' corresponds to the bit (1 << (p - 1)).\n    for p in range(2, msb_index + 1, 2):\n        mask |= (1 << (p - 1))\n\n    # Combine the original number with the generated mask.\n    return number | mask"}
{"task_id": "Mbpp/238", "solution": "def number_of_substrings(s: str) -> int:\n    \"\"\"Counts the number of non-empty substrings of a given string using a mathematical formula.\n    Each substring is counted by its unique start and end index pair.\n\n    Args:\n        s (str): input string\n\n    Returns:\n        int: number of non-empty substrings\n\n    Raises:\n        TypeError: if s is not a str\n    \"\"\"\n    if not isinstance(s, str):\n        raise TypeError(\"s must be of type str\")\n    n = len(s)\n    return n * (n + 1) // 2"}
