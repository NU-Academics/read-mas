{"task_id": "Mbpp/8", "solution": "def _validate_input(nums):\n    \"\"\"Ensures the input is a non-None list.\"\"\"\n    if nums is None:\n        raise TypeError(\"Input 'nums' must not be None.\")\n    if not isinstance(nums, list):\n        raise TypeError(\"Input 'nums' must be a list.\")\n\ndef _validate_element(x, index):\n    \"\"\"Ensures an element is a numeric type and not a nested list.\"\"\"\n    if not isinstance(x, (int, float)):\n        if isinstance(x, list):\n            raise TypeError(f\"Element at index {index} is a nested list, which is not supported.\")\n        else:\n            raise TypeError(f\"Element at index {index} is not numeric (int or float).\")\n\ndef _compute_square(x):\n    \"\"\"Calculates the square of a numeric value.\"\"\"\n    return x * x\n\ndef square_nums(nums):\n    \"\"\"\n    Computes squares of individual elements in a list of numbers.\n    It returns a new list with each element squared, preserving order, and raises TypeError for invalid inputs.\n    \"\"\"\n    _validate_input(nums)\n\n    squared_elements = []\n    for i, num in enumerate(nums):\n        _validate_element(num, i)\n        squared_elements.append(_compute_square(num))\n    return squared_elements"}
{"task_id": "Mbpp/6", "solution": "class InputValidator:\n    @staticmethod\n    def validate_integer(x):\n        \"\"\"Raise TypeError if x is not an int.\"\"\"\n        if not isinstance(x, int):\n            raise TypeError(\"Input must be an integer.\")\n\nclass BitComparator:\n    @staticmethod\n    def xor(a, b):\n        \"\"\"Return a ^ b.\"\"\"\n        return a ^ b\n\n    @staticmethod\n    def has_single_set_bit(x):\n        \"\"\"Return True iff x != 0 and (x & (x - 1)) == 0.\"\"\"\n        return x != 0 and (x & (x - 1)) == 0\n\ndef differ_At_One_Bit_Pos(a, b):\n    \"\"\"Return True iff integers a and b differ in exactly one bit position.\n\n    Raises:\n        TypeError: If either a or b is not an int.\n    \"\"\"\n    InputValidator.validate_integer(a)\n    InputValidator.validate_integer(b)\n\n    xor_result = BitComparator.xor(a, b)\n    return BitComparator.has_single_set_bit(xor_result)"}
{"task_id": "Mbpp/7", "solution": "import re\n\nPATTERN = r'(?<![A-Za-z0-9_])[A-Za-z]{4,}(?![A-Za-z0-9_])'\n\ndef find_char_long(s):\n    \"\"\"\n    Finds all ASCII-letter words of length at least 4 in a string, ignoring tokens with digits or underscores.\n    Preserves original case and order of words.\n    \"\"\"\n    if s is None or s == '':\n        return []\n\n    return [match.group(0) for match in re.finditer(PATTERN, s)]"}
{"task_id": "Mbpp/11", "solution": "def remove_Occ(s: str, ch: str) -> str:\n    \"\"\"\n    Removes the first and last occurrences of a given character/substring from the string.\n    If the character/substring occurs only once, that single occurrence is removed.\n    If ch is empty or not found, returns s unchanged.\n    \"\"\"\n    if not isinstance(s, str) or not isinstance(ch, str):\n        raise TypeError(\"Both s and ch must be strings\")\n\n    if ch == \"\":\n        return s\n\n    first_idx = s.find(ch)\n    if first_idx == -1:\n        return s\n\n    last_idx = s.rfind(ch)\n\n    if first_idx == last_idx:\n        # Only one occurrence\n        return s[:first_idx] + s[first_idx + len(ch):]\n    else:\n        # Remove last occurrence first to preserve the first index\n        s_after_last_removed = s[:last_idx] + s[last_idx + len(ch):]\n        # Then remove the first occurrence from the modified string\n        return s_after_last_removed[:first_idx] + s_after_last_removed[first_idx + len(ch):]"}
{"task_id": "Mbpp/2", "solution": "from typing import Iterable, List, TypeVar\n\nT = TypeVar('T')\n\ndef _validate_iterable(x, name: str) -> None:\n    \"\"\"Raises TypeError if x is not iterable.\"\"\"\n    try:\n        iter(x)\n    except TypeError:\n        raise TypeError(f\"similar_elements: argument '{name}' is not iterable\")\n\ndef _is_hashable(x) -> bool:\n    \"\"\"Returns True if x is hashable, False otherwise.\"\"\"\n    try:\n        hash(x)\n        return True\n    except TypeError:\n        return False\n\ndef _hash_based_intersection(a_iter: Iterable[T], b_iter: Iterable[T]) -> List[T]:\n    \"\"\"Finds shared elements using a hash map for counts.\"\"\"\n    counts_b = {}\n    for item in b_iter:\n        counts_b[item] = counts_b.get(item, 0) + 1\n\n    result: List[T] = []\n    for item_a in a_iter:\n        if counts_b.get(item_a, 0) > 0:\n            result.append(item_a)\n            counts_b[item_a] -= 1\n    return result\n\ndef _fallback_intersection(a_iter: Iterable[T], b_iter: Iterable[T]) -> List[T]:\n    \"\"\"Finds shared elements for potentially unhashable types via pairwise comparison.\"\"\"\n    b_list = list(b_iter)\n    used_b = [False] * len(b_list)\n    result: List[T] = []\n\n    for item_a in a_iter:\n        for j in range(len(b_list)):\n            if not used_b[j] and b_list[j] == item_a:\n                used_b[j] = True\n                result.append(item_a)\n                break\n    return result\n\ndef similar_elements(a: Iterable[T], b: Iterable[T]) -> List[T]:\n    \"\"\"\n    Finds common elements between two iterables, preserving order from 'a' and handling duplicates.\n\n    Parameters:\n        a (Iterable[T]): The first iterable, whose order and initial duplicates are prioritized.\n        b (Iterable[T]): The second iterable, used to determine common elements and their counts.\n\n    Returns:\n        List[T]: A new list containing elements present in both 'a' and 'b'.\n                 Each element appears min(count_in_a, count_in_b) times, and\n                 the order of elements follows their appearance in 'a'.\n\n    Complexity:\n        - If all elements in 'b' are hashable: average O(n + m) time, O(k) auxiliary space (k = distinct keys in b).\n        - If any element in 'b' is unhashable: worst-case O(n * m) time, O(m) auxiliary space.\n\n    Raises:\n        TypeError: If 'a' or 'b' is not iterable, with specific messages like\n                   \"similar_elements: argument 'a' is not iterable\".\n\n    Examples:\n        >>> similar_elements((3, 4, 5, 6), (5, 7, 4, 10))\n        [4, 5]\n        >>> similar_elements([1, 2, 2, 3], [2, 2, 4])\n        [2, 2]\n        >>> similar_elements([[1], [1], [2]], [[1], [3], [1]])\n        [[1], [1]]\n    \"\"\"\n    _validate_iterable(a, 'a')\n    _validate_iterable(b, 'b')\n\n    b_list = list(b) # Materialize b to allow multiple passes and hashability inspection.\n\n    can_use_hash_based = True\n    for item_b in b_list:\n        if not _is_hashable(item_b):\n            can_use_hash_based = False\n            break\n\n    if can_use_hash_based:\n        return _hash_based_intersection(a, b_list)\n    else:\n        return _fallback_intersection(a, b_list)"}
{"task_id": "Mbpp/3", "solution": "def is_not_prime(n):\n    \"\"\"Return True if n is not a prime, False if n is a prime.\n\n    Algorithm:\n      - Strictly accepts int; raises TypeError for other types.\n      - Handles n <= 1 and n == 2 as special cases.\n      - Checks divisibility by 2 to shortcut even composites.\n      - For odd n > 2, uses trial division of odd divisors from 3 up to floor(sqrt(n)).\n    Complexity:\n      - Time (worst-case): O(sqrt(n))\n      - Auxiliary space: O(1)\n\n    Notes:\n      - Intended for integers of moderate size; extremely large integers may be slow.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"is_not_prime: input must be an int\")\n    if n <= 1:\n        return True\n    if n == 2:\n        return False\n    if n % 2 == 0:  # This covers all even numbers > 2, as n==2 is handled.\n        return True\n    limit = int(n**0.5)\n    d = 3\n    while d <= limit:\n        if n % d == 0:\n            return True\n        d += 2\n    return False"}
{"task_id": "Mbpp/4", "solution": "import heapq\n\ndef heap_queue_largest(nums, n):\n    \"\"\"Return a list of the n largest integers from nums in descending order.\n\n    Non-integer values and booleans are ignored.\n    Raises TypeError if nums is not iterable or n is not an int.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an int\")\n    try:\n        iter(nums)\n    except TypeError:\n        raise TypeError(\"nums must be an iterable\")\n\n    if n <= 0:\n        return []\n\n    # Generator for filtered integers, excluding booleans.\n    filtered_ints_iterator = (x for x in nums if isinstance(x, int) and not isinstance(x, bool))\n\n    # Use heapq.nlargest to find the n largest integers; it returns them in descending order.\n    result = heapq.nlargest(n, filtered_ints_iterator)\n\n    return result"}
{"task_id": "Mbpp/9", "solution": "from typing import List, Optional\n\ndef validate_type(value) -> None:\n    \"\"\"\n    Validates if the input value is a string.\n    Raises TypeError if not.\n    \"\"\"\n    if not isinstance(value, str):\n        raise TypeError(\"Input must be a string.\")\n\ndef handle_empty(value: str) -> Optional[int]:\n    \"\"\"\n    Handles the empty string case.\n    Returns 0 if empty, otherwise None.\n    \"\"\"\n    if value == \"\":\n        return 0\n    return None\n\ndef compute_pi(s: str) -> List[int]:\n    \"\"\"\n    Computes the KMP prefix function (pi array) for a string.\n    The pi array stores lengths of the longest proper prefixes that are also suffixes.\n    \"\"\"\n    n = len(s)\n    pi = [0] * n\n    for i in range(1, n):\n        j = pi[i - 1]\n        while j > 0 and s[i] != s[j]:\n            j = pi[j - 1]\n        if s[i] == s[j]:\n            j += 1\n        pi[i] = j\n    return pi\n\ndef minimal_period(s: str) -> int:\n    \"\"\"\n    Calculates the minimal period of a string using its KMP pi array.\n    The minimal period p is n - pi[n-1] for n > 0.\n    \"\"\"\n    n = len(s)\n    # The design specifies n > 0 for this helper.\n    # The main function ensures n > 0 before calling.\n    pi = compute_pi(s) # This recomputes the pi array as per design specification.\n    period = n - pi[n - 1]\n    return period\n\ndef left_rotate(s: str, k: int) -> str:\n    \"\"\"\n    Performs a left cyclic rotation on a string.\n    This helper is provided per design but not used in the main KMP logic.\n    \"\"\"\n    n = len(s)\n    if n == 0:\n        return \"\"\n    k_normalized = k % n\n    return s[k_normalized:] + s[:k_normalized]\n\ndef find_Rotations(s: str) -> int:\n    \"\"\"\n    Finds the minimum number of rotations (greater than 0) required to get the same string.\n    Uses the KMP prefix-function to compute the minimal period of the string.\n    \"\"\"\n    validate_type(s)\n\n    empty_result = handle_empty(s)\n    if empty_result is not None:\n        return empty_result\n\n    n = len(s)\n\n    # Handle single-character strings explicitly as specified in the design.\n    if n == 1:\n        return 1\n\n    # Compute the minimal period using KMP logic.\n    # As per the \"Implementation wiring\" in the design, compute_pi is called,\n    # then minimal_period is called, which internally recomputes pi to adhere to its signature.\n    _ = compute_pi(s) # This line is present in the design's \"Implementation wiring\" flow.\n    p = minimal_period(s)\n\n    # Determine the number of rotations.\n    # If the minimal period 'p' is less than the string length 'n' and 'n' is divisible by 'p',\n    # then 'p' is the minimum number of rotations.\n    # Otherwise, the string does not repeat in a smaller unit, so 'n' rotations are required.\n    if p < n and n % p == 0:\n        return p\n    else:\n        return n"}
{"task_id": "Mbpp/16", "solution": "import re\n\nREGEX_PATTERN: str = r\"[a-z]+_[a-z]+\"\n\ndef text_lowercase_underscore(s: str) -> bool:\n    \"\"\"\n    Checks if the input string contains sequences of lowercase letters joined with an underscore.\n    It returns True if such a sequence exists, and False otherwise.\n    \"\"\"\n    return re.search(REGEX_PATTERN, s) is not None"}
{"task_id": "Mbpp/14", "solution": "def find_Volume(base, height, length):\n    \"\"\"\n    Compute the volume of a triangular prism.\n\n    Volume = (0.5 * base * height) * length\n\n    Parameters:\n        base (int|float): base of the triangular cross-section (>= 0)\n        height (int|float): height of the triangular cross-section (>= 0)\n        length (int|float): length of the prism (>= 0)\n\n    Returns:\n        int|float: computed volume\n\n    Raises:\n        TypeError: if any parameter is not int or float\n        ValueError: if any parameter is negative\n    \"\"\"\n    if not isinstance(base, (int, float)):\n        raise TypeError(\"base must be int or float\")\n    if not isinstance(height, (int, float)):\n        raise TypeError(\"height must be int or float\")\n    if not isinstance(length, (int, float)):\n        raise TypeError(\"length must be int or float\")\n\n    if base < 0:\n        raise ValueError(\"base must be non-negative\")\n    if height < 0:\n        raise ValueError(\"height must be non-negative\")\n    if length < 0:\n        raise ValueError(\"length must be non-negative\")\n\n    area_of_triangle = 0.5 * base * height\n    volume = area_of_triangle * length\n    return volume"}
{"task_id": "Mbpp/17", "solution": "from typing import Union\n\nNumber = Union[int, float]\n\nclass InvalidInputError(Exception):\n    \"\"\"Custom exception for invalid input values.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n\nclass InvalidInputTypeError(InvalidInputError):\n    \"\"\"Custom exception for invalid input types.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n\ndef validate_side(side: Number) -> None:\n    \"\"\"\n    Validates the side length, ensuring it's a non-negative number.\n    Raises InvalidInputTypeError for non-numeric input or InvalidInputError for negative values.\n    \"\"\"\n    if not isinstance(side, (int, float)):\n        raise InvalidInputTypeError(\"side must be a number (int or float).\")\n    if side < 0:\n        raise InvalidInputError(\"side must be a non-negative number.\")\n\ndef square_perimeter(side: Number) -> Number:\n    \"\"\"\n    Calculates the perimeter of a square given its side length.\n    Validates input for type and non-negativity.\n    \"\"\"\n    validate_side(side)\n    return 4 * side"}
{"task_id": "Mbpp/18", "solution": "def remove_dirty_chars(first_string: str, chars_to_remove: str) -> str:\n    \"\"\"\n    Removes characters from the first string that are present in the second string.\n    Uses a set for efficient character lookup and a list for building the result.\n    \"\"\"\n    if not first_string:\n        return \"\"\n    if not chars_to_remove:\n        return first_string\n\n    chars_to_remove_set = set(chars_to_remove)\n    result_chars = []\n\n    for char in first_string:\n        if char not in chars_to_remove_set:\n            result_chars.append(char)\n\n    return \"\".join(result_chars)"}
{"task_id": "Mbpp/56", "solution": "def check(n):\n    \"\"\"\n    Checks if a number is one less than twice its reverse.\n    The reversal ignores leading zeros (e.g., reverse(10) is 1).\n    \"\"\"\n    def _reverse_num(num):\n        \"\"\"Computes the decimal-digit reversal of a non-negative integer.\"\"\"\n        if num == 0:\n            return 0\n        rev = 0\n        while num > 0:\n            num, digit = divmod(num, 10)\n            rev = rev * 10 + digit\n        return rev\n\n    rev = _reverse_num(n)\n    return n == (2 * rev - 1)"}
{"task_id": "Mbpp/19", "solution": "def test_duplicate(input_list: list) -> bool:\n    \"\"\"Checks if a list of integers contains any duplicate element.\n    This function raises TypeError for invalid input types as required by design.\"\"\"\n    class DuplicateChecker:\n        def __init__(self, use_hashset: bool = True):\n            self.use_hashset = use_hashset\n\n        def validate_input(self, input_list_to_validate: list) -> None:\n            if not isinstance(input_list_to_validate, list):\n                raise TypeError(\"input_list must be a list of integers\")\n            for elem in input_list_to_validate:\n                if not isinstance(elem, int):\n                    raise TypeError(\"all elements must be int\")\n\n        def test_duplicate(self, input_list_to_check: list) -> bool:\n            self.validate_input(input_list_to_check)\n\n            if len(input_list_to_check) <= 1:\n                return False\n\n            if self.use_hashset:\n                seen = set()\n                for value in input_list_to_check:\n                    if value in seen:\n                        return True\n                    seen.add(value)\n                return False\n            else:\n                # Sorting alternative (non-mutating recommended by design for generality).\n                copy_list = list(input_list_to_check)\n                copy_list.sort()\n                for i in range(1, len(copy_list)):\n                    if copy_list[i] == copy_list[i-1]:\n                        return True\n                return False\n\n    dc = DuplicateChecker(use_hashset=True)\n    return dc.test_duplicate(input_list)"}
{"task_id": "Mbpp/20", "solution": "def is_woodall(n: int) -> bool:\n    \"\"\"\n    Checks if the given number `n` is a Woodall number using an iterative exact algorithm.\n    A number `n` is Woodall if n = k * 2^k - 1 for some integer k >= 1.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an int\")\n    if n < 1:\n        return False\n\n    k = 1\n    while True:\n        # Calculate v = k * 2^k - 1 using Python's arbitrary-precision integers.\n        v = k * (1 << k) - 1\n\n        if v == n:\n            return True\n        if v > n:\n            return False\n\n        k += 1"}
{"task_id": "Mbpp/12", "solution": "from typing import Iterable, List\nfrom numbers import Number\n\ndef _validate_matrix(matrix) -> None:\n    # Checks if the top-level input is iterable.\n    try:\n        iter(matrix)\n    except TypeError:\n        raise TypeError(\"matrix must be an iterable of iterables\")\n\ndef _validate_row(row, row_index: int) -> None:\n    # Checks if a given row is iterable.\n    try:\n        iter(row)\n    except TypeError:\n        raise TypeError(f\"row {row_index} is not an iterable\")\n\ndef _validate_element(el, row_index: int, col_index: int) -> None:\n    # Checks if an element is numeric using numbers.Number.\n    if not isinstance(el, Number):\n        raise TypeError(f\"element at row {row_index}, col {col_index} is not numeric\")\n\ndef _compute_row_sum(row, row_index: int) -> Number:\n    # Computes the sum of a row after validating its elements.\n    total_sum = 0\n    for col_index, el in enumerate(row):\n        _validate_element(el, row_index, col_index)\n        total_sum += el\n    return total_sum\n\ndef sort_matrix(matrix: Iterable[Iterable[Number]]) -> List[List[Number]]:\n    \"\"\"Sort rows of matrix ascending by numeric sum and return a new list of rows.\n\n    Parameters:\n        matrix: Iterable[Iterable[Number]] -- top-level iterable of rows; each row is an iterable\n                of numeric elements (int, float, Decimal or other summable numeric objects).\n\n    Returns:\n        List[List[Number]] -- new list of rows (each row converted to list) sorted ascending by row sum.\n\n    Raises:\n        TypeError(\"matrix must be an iterable of iterables\") if matrix is not iterable.\n        TypeError(f\"row {i} is not an iterable\") if any row is not iterable (0-based i).\n        TypeError(f\"element at row {i}, col {j} is not numeric\") if any element is not numeric/summable.\n\n    Example:\n        assert sort_matrix([[3, 4], [1, 2]]) == [[1, 2], [3, 4]]\n    \"\"\"\n    _validate_matrix(matrix)\n\n    auxiliary_list = []\n    for original_index, row in enumerate(matrix):\n        _validate_row(row, original_index)\n        row_list = list(row)  # Convert to list to ensure repeatability and desired output type\n        sum_value = _compute_row_sum(row_list, original_index)\n        auxiliary_list.append((sum_value, original_index, row_list))\n\n    if not auxiliary_list:\n        return []\n\n    # Sort by sum_value, then by original_index for stable tie-breaking.\n    sorted_auxiliary_list = sorted(auxiliary_list, key=lambda t: (t[0], t[1]))\n\n    final_result = [entry[2] for entry in sorted_auxiliary_list]\n    return final_result"}
{"task_id": "Mbpp/58", "solution": "def opposite_Signs(x: int, y: int) -> bool:\n    \"\"\"Checks if two integers have opposite signs. Returns False if either integer is zero.\"\"\"\n    if x == 0 or y == 0:\n        return False\n    return (x * y) < 0"}
{"task_id": "Mbpp/57", "solution": "def find_Max_Num(digits):\n    \"\"\"\n    Finds the largest number that can be formed with the given list of digits.\n    This implementation validates input, sorts digits using counting sort,\n    and converts them to an integer, handling leading zeros automatically.\n    \"\"\"\n    # Validate input is not None\n    if digits is None:\n        raise TypeError(\"Input cannot be None.\")\n\n    # Validate input is a list or tuple\n    if not isinstance(digits, (list, tuple)):\n        raise TypeError(\"Input must be a list or tuple of digits.\")\n\n    # Validate each element is an integer between 0 and 9\n    for digit in digits:\n        if not isinstance(digit, int) or not (0 <= digit <= 9):\n            raise ValueError(\"Each element must be an integer between 0 and 9.\")\n\n    # Handle empty list case\n    if not digits:\n        return 0\n\n    # Perform counting sort to arrange digits in descending order\n    # Initialize counts array for digits 0-9\n    counts = [0] * 10\n    for digit in digits:\n        counts[digit] += 1\n\n    # Reconstruct the list of digits in descending order\n    sorted_digits = []\n    for i in range(9, -1, -1):  # Iterate from 9 down to 0\n        sorted_digits.extend([str(i)] * counts[i]) # Store as strings for easy join\n\n    # Concatenate the sorted digits to form a string and convert to an integer\n    # Python's int() conversion naturally handles leading zeros (e.g., int(\"007\") becomes 7)\n    number_str = \"\".join(sorted_digits)\n\n    return int(number_str)"}
{"task_id": "Mbpp/62", "solution": "from collections.abc import Iterable\nfrom typing import Iterator, Union\n\ndef smallest_num(iterable: Iterable) -> Union[int, float]:\n    \"\"\"\n    Finds the smallest numeric value (int or float) in an iterable.\n    \"\"\"\n\n    def validate_iterable(input_iterable: Iterable) -> None:\n        if not isinstance(input_iterable, Iterable):\n            raise TypeError(\"Input must be an iterable.\")\n\n    def filter_numeric(input_iterable: Iterable) -> Iterator[Union[int, float]]:\n        for item in input_iterable:\n            if isinstance(item, (int, float)):\n                yield item\n\n    def compute_min(numeric_iterable: Iterator[Union[int, float]]) -> Union[int, float]:\n        min_candidate = None\n        for item in numeric_iterable:\n            if min_candidate is None:\n                min_candidate = item\n            elif item < min_candidate:\n                min_candidate = item\n\n        if min_candidate is None:\n            raise ValueError(\"Iterable contains no numeric elements.\")\n        return min_candidate\n\n    validate_iterable(iterable)\n    numeric_generator = filter_numeric(iterable)\n    result = compute_min(numeric_generator)\n    return result"}
{"task_id": "Mbpp/59", "solution": "def is_octagonal(n):\n    \"\"\"\n    Calculates the nth octagonal number.\n\n    Octagonal numbers are a type of figurate number, representing the number of dots\n    in an octagon. They are defined by the formula O_n = n * (3 * n - 2).\n\n    Input Validation:\n    - `n` must be an integer. Boolean values are explicitly rejected.\n    - `n` must be greater than or equal to 1.\n\n    Exceptions:\n    - Raises `TypeError` if `n` is not an integer (e.g., float, string, bool).\n    - Raises `ValueError` if `n` is less than 1.\n\n    Formula:\n    O_n = n * (3 * n - 2)\n\n    Complexity:\n    - Time: O(1) - The calculation involves a fixed number of arithmetic operations.\n    - Space: O(1) additional - Constant local storage, excluding arbitrary-precision\n      integer memory growth for very large `n`.\n\n    Edge Cases:\n    - Non-integer input (e.g., \"3\", 2.0) will raise a TypeError.\n    - Boolean inputs (e.g., True, False) are treated as non-integers and raise a TypeError.\n    - Input `n < 1` (e.g., 0, -1) will raise a ValueError.\n    - Very large `n` values are supported by Python's arbitrary-precision integers\n      but may consume significant memory or computation time depending on magnitude.\n\n    Examples:\n    - is_octagonal(1) returns 1\n    - is_octagonal(2) returns 8\n    - is_octagonal(3) returns 21\n    - is_octagonal(10) returns 280\n    - is_octagonal(\"3\") raises TypeError\n    - is_octagonal(0) raises ValueError\n    \"\"\"\n\n    class InputValidator:\n        \"\"\"Validates input for type and range constraints.\"\"\"\n        def validate_type(self, n):\n            \"\"\"Ensures n is an integer, explicitly rejecting booleans.\"\"\"\n            if type(n) is not int:\n                raise TypeError(\"n must be an integer. Booleans are not allowed.\")\n\n        def validate_range(self, n):\n            \"\"\"Ensures n is greater than or equal to 1.\"\"\"\n            if n < 1:\n                raise ValueError(\"n must be greater than or equal to 1.\")\n\n    class OctagonalCalculator:\n        \"\"\"Encapsulates the calculation of the octagonal number.\"\"\"\n        def compute(self, n: int) -> int:\n            \"\"\"Calculates O_n = n * (3 * n - 2) using integer arithmetic.\"\"\"\n            return n * (3 * n - 2)\n\n    class OctagonalNumber:\n        \"\"\"A simple DTO to hold the input n and its calculated octagonal value.\"\"\"\n        def __init__(self, n: int, value: int):\n            \"\"\"Initializes the DTO with the input n and the computed value.\"\"\"\n            self.n = n\n            self.value = value\n\n    validator = InputValidator()\n    calculator = OctagonalCalculator()\n\n    validator.validate_type(n)\n    validator.validate_range(n)\n\n    result = calculator.compute(n)\n    # The OctagonalNumber DTO is for conceptual design; the function directly returns the integer value.\n    return result"}
{"task_id": "Mbpp/61", "solution": "from collections import defaultdict\n\ndef count_Substrings(s: str) -> int:\n    \"\"\"\n    Counts substrings where the sum of digits equals the substring's length.\n    Uses an O(n) adjusted-prefix-sum and hashmap approach.\n    \"\"\"\n    # Validate input: Ensure all characters in the string are digits.\n    for char in s:\n        if not '0' <= char <= '9':\n            raise ValueError(\"Input string must contain only digits.\")\n\n    # An empty string has no substrings, so the count is 0.\n    if not s:\n        return 0\n\n    # Initialize variables for the adjusted-prefix-sum algorithm.\n    prefix_sum = 0\n    result = 0\n    # freq_map stores counts of adjusted_prefix values encountered.\n    # freq_map[0] = 1 accounts for the \"empty prefix\" before index 0.\n    freq_map = defaultdict(int)\n    freq_map[0] = 1\n\n    # Iterate through the string to calculate prefix sums and adjusted values on the fly.\n    for i, char in enumerate(s):\n        digit = int(char)\n        prefix_sum += digit\n        # The adjusted_prefix for the current prefix (length i+1) is prefix_sum - (i+1).\n        adjusted = prefix_sum - (i + 1)\n\n        # If this adjusted value has been seen before, it means a valid substring exists.\n        result += freq_map[adjusted]\n\n        # Increment the count for the current adjusted value in the frequency map.\n        freq_map[adjusted] += 1\n\n    return result"}
{"task_id": "Mbpp/63", "solution": "from typing import List, Tuple, Any\n\ndef max_difference(pairs: List[Tuple[float, float]]) -> float:\n    \"\"\"\n    Finds the maximum absolute difference between elements in available pairs\n    from a given list of tuples.\n\n    This function iterates through a collection of 2-tuples, where each tuple\n    contains two numeric values (integers or floats). For each pair (a, b),\n    it computes the absolute difference |a - b| and returns the largest\n    difference found across all pairs.\n\n    The function performs strict input validation according to the following order:\n    1. Checks if the overall input `pairs` is an iterable.\n    2. Checks if the iterable `pairs` is empty.\n    3. For each item in `pairs`, it validates if it's a 2-tuple with numeric elements.\n\n    Parameters:\n        pairs: A list (or any iterable) of 2-tuples. Each 2-tuple must contain\n               two numeric values (int or float).\n               Type hint is List[Tuple[float, float]] as per PEP 484, but runtime\n               accepts any valid iterable that meets the structural constraints.\n\n    Returns:\n        float: The maximum absolute difference found among all valid pairs.\n\n    Raises:\n        TypeError:\n            - If `pairs` is not an iterable.\n            - If any item in `pairs` is not a tuple.\n            - If any tuple in `pairs` is not of length 2.\n            - If any element within a 2-tuple is not numeric (int or float).\n        ValueError:\n            - If `pairs` is an iterable but is empty.\n\n    Complexity:\n        Time: O(n), where n is the number of pairs in the input list, as it\n              requires a single pass through the input.\n        Space: O(1) additional space, as it only uses a few scalar variables.\n\n    Edge Cases:\n        - Empty list: Raises ValueError.\n        - Non-iterable input: Raises TypeError.\n        - List with non-tuple items: Raises TypeError.\n        - Tuples of incorrect length: Raises TypeError.\n        - Tuples with non-numeric elements: Raises TypeError.\n        - Input with negative numbers, floats, or mixed types: Handled correctly.\n\n    Examples:\n        >>> max_difference([(3, 5), (1, 7), (10, 3), (1, 2)])\n        7.0\n        >>> max_difference([(-5, -1), (0,0), (2.5, 5.5)])\n        3.0\n        >>> max_difference([(1, 1), (10, 10)])\n        0.0\n    \"\"\"\n    def _validate_input(input_pairs: Any) -> None:\n        \"\"\"\n        Validates if the input `input_pairs` is an iterable.\n        Raises TypeError if not iterable.\n        \"\"\"\n        try:\n            iter(input_pairs)\n        except TypeError as e:\n            raise TypeError(\"Input 'pairs' must be an iterable of 2-tuples.\") from e\n\n    def _validate_pair(pair_item: Any) -> None:\n        \"\"\"\n        Validates if a single item `pair_item` is a 2-tuple of numeric types (int or float).\n        Raises TypeError if not a 2-tuple or if elements are not numeric.\n        \"\"\"\n        if not isinstance(pair_item, tuple):\n            raise TypeError(\"Each item in 'pairs' must be a tuple.\")\n        if len(pair_item) != 2:\n            raise TypeError(\"Each tuple in 'pairs' must be of length 2.\")\n        if not isinstance(pair_item[0], (int, float)) or not isinstance(pair_item[1], (int, float)):\n            raise TypeError(\"All elements within each pair must be numeric (int or float).\")\n\n    def _abs_diff(a_val: float, b_val: float) -> float:\n        \"\"\"\n        Calculates the absolute difference between two numeric values.\n        Returns the absolute difference as a float.\n        \"\"\"\n        return float(abs(a_val - b_val))\n\n    _validate_input(pairs)\n\n    if not pairs:\n        raise ValueError(\"Input 'pairs' cannot be an empty iterable.\")\n\n    max_diff = 0.0\n\n    for pair in pairs:\n        _validate_pair(pair)\n        num1, num2 = pair\n        current_diff = _abs_diff(float(num1), float(num2))\n        if current_diff > max_diff:\n            max_diff = current_diff\n\n    return max_diff"}
{"task_id": "Mbpp/64", "solution": "def subject_marks(items: list) -> list:\n    \"\"\"Return a new list sorted in ascending order by the second element (mark) of each two-element tuple.\n    Raises TypeError if items is not a list or if any element is not a 2-element tuple.\"\"\"\n    class SubjectMarksService:\n        \"\"\"Encapsulates validation and key-extraction logic for sorting subject marks.\"\"\"\n        def subject_marks(self, items: list) -> list:\n            self.validate_input(items)\n            return sorted(items, key=self._extract_key)\n\n        def validate_input(self, items: list) -> bool:\n            if not isinstance(items, list):\n                raise TypeError(\"Input 'items' must be a list.\")\n            for i, item in enumerate(items):\n                if not isinstance(item, tuple) or len(item) != 2:\n                    raise TypeError(f\"List element at index {i} must be a 2-element tuple, but got {item!r}.\")\n            return True\n\n        def _extract_key(self, item: tuple) -> object:\n            return item[1]\n\n    service = SubjectMarksService()\n    return service.subject_marks(items)"}
{"task_id": "Mbpp/65", "solution": "def _recursive_sum(sublist: list) -> float:\n    \"\"\"Helper to recursively traverse the list and sum numeric elements.\n    It accumulates int and float values encountered.\n    \"\"\"\n    current_sum = 0.0\n    for item in sublist:\n        if isinstance(item, list):\n            current_sum += _recursive_sum(item)\n        elif isinstance(item, (int, float)):\n            current_sum += float(item)\n    return current_sum\n\ndef recursive_list_sum(lst: list) -> float:\n    \"\"\"\n    Flattens a list and sums all of its numeric (int, float) elements recursively.\n    For extremely deep nesting, consider adjusting `sys.setrecursionlimit` to avoid `RecursionError`.\n    \"\"\"\n    return _recursive_sum(lst)"}
{"task_id": "Mbpp/66", "solution": "def pos_count(items: list) -> int:\n    \"\"\"Counts the number of strictly positive numeric elements in a list.\n\n    Raises TypeError for non-list input or any non-numeric (including boolean) element.\n    \"\"\"\n    if not isinstance(items, list):\n        raise TypeError(\"Input 'items' must be a list.\")\n\n    count = 0\n    for elem in items:\n        if isinstance(elem, bool):\n            raise TypeError(\"List elements must be int or float, not boolean.\")\n        if not isinstance(elem, (int, float)):\n            raise TypeError(\"List elements must be int or float.\")\n\n        if elem > 0:\n            count += 1\n\n    return count"}
{"task_id": "Mbpp/68", "solution": "from typing import Iterable, Any, Iterator\n\ndef is_Monotonic(sequence: Iterable[Any]) -> bool:\n    \"\"\"\n    Checks if a sequence is monotonic (either non-decreasing or non-increasing).\n    Returns True for empty or single-element sequences.\n    Raises TypeError(\"sequence is not iterable\") if input is not iterable.\n    Raises TypeError(\"elements in sequence are not comparable\") if element comparisons fail.\n    \"\"\"\n    try:\n        it: Iterator[Any] = iter(sequence)\n    except TypeError:\n        raise TypeError(\"sequence is not iterable\")\n\n    try:\n        prev = next(it)\n    except StopIteration:\n        return True\n\n    non_decreasing = True\n    non_increasing = True\n\n    for curr in it:\n        try:\n            if curr < prev:\n                non_decreasing = False\n            if curr > prev:\n                non_increasing = False\n        except TypeError:\n            raise TypeError(\"elements in sequence are not comparable\")\n\n        if not non_decreasing and not non_increasing:\n            return False\n\n        prev = curr\n\n    return True"}
{"task_id": "Mbpp/70", "solution": "def get_equal(*tuples) -> bool:\n    \"\"\"Checks if all given tuples have equal length. Returns True for zero or one input tuple, and raises TypeError if any argument is not a tuple.\n\n    Examples:\n    get_equal() -> True\n    get_equal((), (), ()) -> True\n    get_equal((1,2), (3,4)) -> True\n    get_equal((1,2,3), (4,5)) -> False\n    get_equal((1,), 2) -> raises TypeError\n    \"\"\"\n    for arg in tuples:\n        if not isinstance(arg, tuple):\n            raise TypeError(\"All arguments must be tuples\")\n\n    if len(tuples) <= 1:\n        return True\n\n    reference_length = len(tuples[0])\n    for i in range(1, len(tuples)):\n        if len(tuples[i]) != reference_length:\n            return False\n\n    return True"}
{"task_id": "Mbpp/69", "solution": "from typing import List\n\ndef is_sublist(lst, sublist) -> bool:\n    \"\"\"\n    Return True if 'sublist' occurs as a contiguous subsequence in 'lst'.\n    Uses the Knuth\u2013Morris\u2013Pratt (KMP) algorithm for efficient searching.\n    \"\"\"\n    if not isinstance(lst, list) or not isinstance(sublist, list):\n        raise TypeError(\"Both lst and sublist must be lists\")\n    if len(sublist) == 0:\n        return True\n    if len(sublist) > len(lst):\n        return False\n\n    return _kmp_search(lst, sublist)\n\ndef _build_prefix(sublist) -> List[int]:\n    \"\"\"\n    Builds the KMP prefix (failure) table.\n    This table is used by the KMP search algorithm for efficient pattern matching.\n    \"\"\"\n    m = len(sublist)\n    prefix = [0] * m\n    k = 0\n    for q in range(1, m):\n        while k > 0 and sublist[k] != sublist[q]:\n            k = prefix[k - 1]\n        if sublist[k] == sublist[q]:\n            k += 1\n        prefix[q] = k\n    return prefix\n\ndef _kmp_search(lst, sublist) -> bool:\n    \"\"\"\n    Performs the KMP search to find a sublist within a list.\n    It utilizes a precomputed prefix table to achieve linear time complexity.\n    \"\"\"\n    n = len(lst)\n    m = len(sublist)\n    prefix = _build_prefix(sublist)\n    q = 0\n    for i in range(n):\n        while q > 0 and sublist[q] != lst[i]:\n            q = prefix[q - 1]\n        if sublist[q] == lst[i]:\n            q += 1\n            if q == m:\n                return True\n    return False"}
{"task_id": "Mbpp/67", "solution": "def bell_number(n: int) -> int:\n    \"\"\"\n    Computes the nth Bell number using the Bell triangle algorithm (dynamic programming).\n    The Bell number B_n counts the number of partitions of a set with n elements.\n\n    Examples:\n    >>> bell_number(0)\n    1\n    >>> bell_number(2)\n    2\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an int\")\n    if n < 0:\n        raise ValueError(\"n must be non-negative\")\n    if n == 0:\n        return 1\n\n    # Initialize the first row of the Bell triangle (B_0)\n    prev_row = [1]\n\n    # Build rows up to n (inclusive). After the k-th iteration prev_row corresponds to row k.\n    for k in range(1, n + 1):\n        # First element of the current row is the last element of the previous row.\n        curr_row = [prev_row[-1]]\n        # Fill the rest of the row using A[k][j] = A[k][j-1] + A[k-1][j-1]\n        for j in range(1, k + 1):\n            curr_row.append(curr_row[j - 1] + prev_row[j - 1])\n        prev_row = curr_row\n\n    # The Bell number B_n is the first element of the nth row.\n    return prev_row[0]"}
