nt:\n        \"\"\"Computes the k-th triangular number T_k = k*(k+1)//2.\"\"\"\n        return k * (k + 1) // 2\n\n    def count_digits(self, value: int) -> int:\n        \"\"\"Returns the number of decimal digits in abs(value).\"\"\"\n        return 1 if value == 0 else len(str(abs(value)))\nclass InputValidator:\n    \"\"\"InputValidator validates that n is a positive integer.\"\"\"\n    def validate_positive_integer(self, n: int) -> None:\n        \"\"\"Raises ValueError if n is not a positive integer.\"\"\"\n        if not isinstance(n, int) or n <= 0:\n            raise ValueError(\"n must be a positive integer\")\nclass TriangularNumber:\n    \"\"\"Domain model representing a triangular number for a given k; compute value and digit count.\"\"\"\n    def __init__(self, k: int):\n        self._k = k\n        self._value = 0\n        self._digits = 0\n\n    def compute(self) -> None:\n        \"\"\"Computes the triangular number T_k and its decimal digit count.\"\"\"\n        self._value = self._k * (self._k + 1) // 2\n        self._digits = 1 if self._value == 0 else len(str(abs(self._value)))\n\n    @property\n    def value(self) -> int:\n        \"\"\"Returns the computed triangular number value.\"\"\"\n        return self._value\n\n    @property\n    def digits(self) -> int:\n        \"\"\"Returns the computed number of decimal digits.\"\"\"\n        return self._digits", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/741": [{"task_id": "Mbpp/741", "solution": "def all_Characters_Same(s: str) -> bool:\n    \"\"\"Return True if every character in s is identical; False otherwise.\n\n    Parameters:\n    - s: str - input string to evaluate\n\n    Returns:\n    - bool - True when all characters in s are identical, False otherwise\n    \"\"\"\n    # Deterministic implementation: return True when set(s) has size <= 1\n    return len(set(s)) <= 1", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [