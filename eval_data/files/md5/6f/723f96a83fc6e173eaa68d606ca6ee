 _effective_rotation_count(count: int, length: int) -> int:\n    \"\"\"Calculates the effective right rotation count.\n    Uses modulo operator, handling zero length to prevent errors.\"\"\"\n    if length == 0:\n        return 0\n    return count % length\ndef _rotate_copy(items: List[Any], shift: int) -> List[Any]:\n    \"\"\"Returns a new list with elements rotated right by 'shift' positions.\n    A shift of 0 returns a shallow copy of the original list.\"\"\"\n    if shift == 0:\n        return list(items)\n    return items[-shift:] + items[:-shift]\ndef rotate_right(items: List[Any], count: int) -> List[Any]:\n    \"\"\"Rotates a list of items to the right by the specified count, returning a new list.\n    Handles empty lists and computes an effective rotation count based on list length.\"\"\"\n    length = len(items)\n    if length == 0:\n        return []\n\n    effective_shift = _effective_rotation_count(count, length)\n    return _rotate_copy(items, effective_shift)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "Mbpp/743", "solution": "def rotate_right(lst, k):\n    \"\"\"\n    Rotates the elements of a list to the right by k positions.\n    Returns a new list with elements rotated as specified.\n    \"\"\"\n    n = len(lst)\n    if n == 0:\n        return []\n\n    k_mod = k % n\n    if k_mod == 0:\n        return list(lst)  # Return a new list if no effective rotation\n\n    return list(lst[-k_mod:]) + list(lst[:-k_mod])", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/745": [{"task_id": "Mbpp/745", "solution": "from .divisible_by_digits import divisible_by_digits\nfrom typing import List, Iterator\nimport unittest\nimport sys\nimport os\nfrom src.divisible_by_digits import divisible_by_digits\nclass Digit:\n    \"\"\"Represents a single decimal digit value (0..9).\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\nclass Number:\n    \"\"\"Encapsulates an integer candidate, its digits, and divisibility checks.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n        self.digits: List[Digit] = self.get_digits()\n\n    def get_digits(self) -> List[Digit]:\n        \"\"\"Computes decimal digits as Digit objects from the number's value.\"\"\"\n        if self.value == 0:\n            return [Digit(0)]\n        \n        temp_value = self.value\n        digits_list: List[Digit] = []\n        while temp_value > 0:\n            digits_list.append(Digit(temp_value % 10))\n            temp_value //= 10\n        return digits_list[::-1] # Return digits in natural order\n\n    def containsZero(self) -> bool:\n        \"\"\"Checks if the number's decimal representation contains the digit 0.\"\"\"\n        return any(d.value == 0 for d in self.digits)\n\n    def divisibleByDigits(self) -> bool:\n        \"\"\"Verifies if the number is divisible by each of its non-zero digits.\"\"\"\n        for d in self.digits:\n            if d.value != 0: # Per requirement, non-zero digits are considered for division.\n                if self.value % d.value != 0:\n                    return False\n        return True\nclass ResultList:\n    \"\"\"Collects and manages a list of integer results, allowing sorting.\"\"\"\n    def __init__(self) -> None:\n        self.numbers: List[int] = []\n\n    def add(self, number_value: int) -> None:\n        \"\"\"Adds an integer value to the internal list of results.\"\"\"\n        self.numbers.append(number_value)\n\n    def sortAscending(self) -> None:\n        \"\"\"Sorts the collected numbers in ascending order.\"\"\"\n        self.numbers.sort()\n\n    def as_list(self) -> List[int]:\n        \"\"\"Returns the collected numbers as a standard Python list.\"\"\"\n        return self.numbers\nclass NumberRange:\n    \"\"\"Encapsulates and validates a numerical range, providing inclusive iteration.\"\"\"\n    def __init__(self, start: int, end: int) -> None:\n        self.start = start\n        self.end = end\n        self.validate() # Validate types upon instantiation.\n\n    def validate(self) -> None:\n        \"\"\"Validates that start and end parameters are integers, raising TypeError otherwise.\"\"\"\n        if not isinstance(self.start, int) or not isinstance(self.end, int):\n            raise TypeError(\"startnum and endnum must be integers.\")\n\n    def __iter__(self) -> Iterator[int]:\n        \"\"\"Provides an inclusive iterator over the range [start, end].\"\"\"\n        if self.start > self.end:\n            return iter([]) # Return an empty iterator if start > end.\n        return iter(range(self.start, self.end + 1))\nclass DivisibilityFunction:\n    \"\"\"Orchestrates the core logic for finding numbers divisible by their digits within a range.\"\"\"\n    def __init__(self, number_range: NumberRange) -> None:\n        self.number_range = number_range\n        self.result_list = ResultList()\n\n    def run(self) -> List[int]:\n        \"\"\"Iterates through the numbers in the range, applying divisibility rules and collecting valid results.\"\"\"\n        for num_value in self.number_range:\n            number_obj = Number(num_value)\n            # Numbers containing digit '0' are excluded.\n            if not number_obj.containsZero():\n                # Check if the number is divisible by all its non-zero digits.\n                if number_obj.divisibleByDigits():\n                    self.result_list.add(num_value)\n        \n        self.result_list.sortAscending()\n        return self.result_list.as_list()\ndef divisible_by_digits(startnum, endnum) -> List[int]:\n    \"\"\"\n    Finds numbers within a given range where every number is divisible by every digit it contains.\n    This public API validates inputs and delegates the core logic to supporting classes.\n    \"\"\"\n    nr = NumberRange(startnum, endnum)\n    df = DivisibilityFunction(nr)\n    return df.run()", "base_