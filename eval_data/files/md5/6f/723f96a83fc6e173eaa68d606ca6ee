.elements:\n            trimmed_element = element_str.strip()\n            if not trimmed_element:\n                raise ParseError(\"Cannot convert empty string to integer.\")\n            try:\n                converted_integers.append(int(trimmed_element))\n            except ValueError:\n                raise ParseError(f\"Could not convert '{element_str}' to an integer.\")\n        return converted_integers\nclass TupleFactory:\n    \"\"\"Aggregates integer values into a Python tuple.\"\"\"\n    def __init__(self, integers: List[int]):\n        self.integers = integers\n    \n    def create_tuple(self) -> tuple:\n        \"\"\"Creates a tuple from the list of integers, preserving order.\"\"\"\n        return tuple(self.integers)\ndef tuple_str_int(input_str: str) -> tuple:\n    \"\"\"Converts a tuple-formatted string into a Python tuple of integers.\"\"\"\n    inp = InputString(input_str)\n    trimmed = inp.strip()\n\n    parser = TupleStringParser(trimmed)\n    if not parser.validate_format():\n        raise ValueError('invalid tuple format')\n    elements = parser.extract_elements()\n\n    converter = IntegerConverter(elements)\n    try:\n        integers = converter.to_integers()\n    except ParseError as pe:\n        raise ValueError(pe.message)\n\n    factory = TupleFactory(integers)\n    return factory.create_tuple()", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [["((7, 8, 9)"]]}], "Mbpp/787": [{"task_id": "Mbpp/787", "solution": "PATTERN: str = \"abbb\"\ndef text_match_three(input: str) -> bool:\n    \"\"\"Return True if the literal substring PATTERN occurs in input.\n    Preconditions: input is a string.\n    \"\"\"\n    return PATTERN in input", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "Mbpp/787", "solution": "def text_match_three(s: str) -> bool:\n    \"\"\"Detects if 'abbb' is a contiguous substring in the input.\n    Returns True if found, Fa