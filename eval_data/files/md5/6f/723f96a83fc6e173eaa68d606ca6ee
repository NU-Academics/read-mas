t of canonical Tuple objects and provide add/contains.\"\"\"\n    _tuples: Set[Tuple]\n\n    def __init__(self):\n        self._tuples = set()\n\n    def add(self, t: Tuple) -> None:\n        \"\"\"Adds a canonical Tuple to the internal set.\"\"\"\n        self._tuples.add(t)\n\n    def contains(self, t: Tuple) -> bool:\n        \"\"\"Checks if a canonical Tuple is present in the internal set.\"\"\"\n        return t in self._tuples\n\n    def to_python_set(self) -> Set[PyTupleType[int, int]]:\n        \"\"\"Converts the internal set of domain Tuples to a set of Python tuples.\"\"\"\n        return {t.to_python_tuple() for t in self._tuples}\nclass TupleIntersectionService:\n    \"\"\"Computes intersection between two TupleList inputs and produces a TupleSet result.\"\"\"\n    def tuple_intersection(self, list1: TupleList, list2: TupleList) -> TupleSet:\n        \"\"\"Computes the intersection of two TupleLists using unordered equality.\"\"\"\n        result_set = TupleSet()\n        list1_copy = list1.copy()\n        list2_copy = list2.copy()\n\n        for t1 in list1_copy._tuples:\n            for t2 in list2_copy._tuples:\n                if t1.equalsUnordered(t2):\n                    canonical_t = t1.canonicalize()\n                    result_set.add(canonical_t)\n                    break # Break inner loop once a match is found for t1\n        return result_set\ndef tuple_intersection(list1: List[PyTupleType[int, int]], list2: List[PyTupleType[int, int]]) -> Set[PyTupleType[int, int]]:\n    \"\"\"\n    Computes intersection of two lists of 2-element integer tuples using unordered equality.\n    Returns canonical ordered tuples in a set.\n    \"\"\"\n    # Convert caller-provided Python lists to domain.TupleList objects.\n    domain_list1 = TupleList([Tuple(a, b) for a, b in list1])\n    domain_list2 = TupleList([Tuple(a, b) for a, b in list2])\n\n    # Delegate to TupleIntersectionService for the core logic.\n    service = TupleIntersectionService()\n    result_domain_set = service.tuple_intersection(domain_list1, domain_list2)\n\n    # Convert the resulting TupleSet to a Python set of canonical 2-element tuples for return.\n    return result_domain_set.to_python_set()", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[[[1, 2, 3], [4, 5, 6], [7, 8, 9]], [[1, 2, 3], [7, 8, 9], [10, 11, 12]]]]}, {"task_id": "Mbpp/473", "solution": "from typing import List, Set, Tuple, Any\nclass TuplePair:\n    \"\"\"Represents a 2-element tuple, providing canonicalization and unordered-equality semantics.\"\"\"\n    def __init__(self, e1: Any, e2: Any) -> None:\n        self._e1 = e1\n        self._e2 = e2\n\n    def __eq__(self, other: object) -> bool:\n        if not isinstance(other, TuplePair):\n            return NotImplemented\n        return self._e1 == other._e1 and self._e2 == other._e2\n\n    def __hash__(self) -> int:\n        return hash((self._e1, self._e2))\n\n    def canonicalize(self) -> 'TuplePair':\n        \"\"\"Returns a new TuplePair in canonical (min, max) order.\"\"\"\n        return TuplePair(min(self._e1, self._e2), max(self._e1, self._e2))\n\n    def equals_unordered(self, other: 'TuplePair') -> bool:\n        \"\"\"Checks if two TuplePair instances are equivalent ignoring order.\"\"\"\n        return self.canonicalize() == other.canonicalize()\n\n    def _as_native_tuple(self) -> Tuple[Any, Any]:\n        \"\"\"Internal helper to get elements as a Python tuple.\"\"\"\n        return (self._e1, self._e2)\nclass TupleSet:\n    \"\"\"Encapsulates a set of canonical Python tuples and supports intersection.\"\"\"\n    def __init__(self, iterable: 'Set[Tuple[Any, Any]]' = None) -> None:\n        \"\"\"Initializes TupleSet, expecting an iterable of canonical native Python tuples.\"\"\"\n        self._tuples: Set[Tuple[Any, Any]] = set()\n        if iterable is not None:\n            self._tuples.update(iterable)\n\n    def add(self, pair: 'TuplePair') -> None:\n        \"\"\"Adds a canonical TuplePair to the set, storing its native tuple form.\"\"\"\n        self._tuples.add(pair._as_native_tuple())\n\n    def contains(self, pair: 'TuplePair') -> bool:\n        \"\"\"Checks if the set contains the canonical form of the given TuplePair.\"\"\"\n        return pair._as_native_tuple() in self._tuples\n\n    def intersection(self, other: 'TupleSet') -> 'TupleSet':\n        \"\"\"Computes the intersection with another TupleSet, returning a new TupleSet.\"\"\"\n        result_native_tuples = self._tuples.intersection(other._tuples)\n        return TupleSet(result_native_tuples)\n\n    def as_python_set(self) -> Set[Tuple[Any, Any]]:\n        \"\"\"Returns the internal set of canonical Python tuples.\"\"\"\n        return self._tuples\nclass TupleList:\n    \"\"\"Adapter for input lists; constructs TuplePair instances and can produce a canonical TupleSet.\"\"\"\n    def __init__(self, tuples: list) -> None:\n        \"\"\"Initializes TupleList by wrapping native tuples into TuplePair instances.\"\"\"\n        self._tuples: List[TuplePair] = [TuplePair(e1, e2) for e1, e2 in tuples]\n\n    def add(self, pair: 'TuplePair') -> None:\n        \"\"\"Adds a TuplePair instance to the list.\"\"\"\n        self._tuples.append(pair)\n\n    def as_canonical_set(self) -> 'TupleSet':\n        \"\"\"Converts the list of TuplePairs to a TupleSet of canonical native tuples.\"\"\"\n        canonicalizer = Canonicalizer() # Instantiates Canonicalizer as it's stateless\n        canonical_native_tuples: Set[Tuple[Any, Any]] = set()\n        for pair in self._tuples:\n            canonical_pair = canonicalizer.canonicalize(pair)\n            canonical_native_tuples.add(canonical_pair._as_native_tuple())\n        return TupleSet(canonical_native_tuples)\nclass Canonicalizer:\n    \"\"\"Stateless service to canonicalize TuplePair instances to (min, max) TuplePair.\"\"\"\n    def canonicalize(self, pair: 'TuplePair') -> 'TuplePair':\n        \"\"\"Canonicalizes a TuplePair by returning a new TuplePair with elements in (min, max) order.\"\"\"\n        return pair.canonicalize()\nclass TupleIntersectionFunction:\n    \"\"\"Orchestrates canonicalization and set intersection to compute results.\"\"\"\n    def __init__(self, canonicalizer: 'Canonicalizer') -> None:\n        self._canonicalizer = canonicalizer\n\n    def tuple_intersection(self, listA: 'TupleList', listB: 'TupleList') -> 'TupleSet':\n        \"\"\"Computes the intersection of two TupleLists, returning a TupleSet of canonical results.\"\"\"\n        # Build canonical set A\n        canonical_set_a = TupleSet()\n        for pair in listA._tuples:\n            canonical_pair = self._canonicalizer.canonicalize(pair)\n            canonical_set_a.add(canonical_pair)\n\n        # Build canonical set B\n        canonical_set_b = TupleSet()\n        for pair in listB._tuples:\n            canonical_pair = self._canonicalizer.canonicalize(pair)\n            canonical_set_b.add(canonical_pair)\n\n        return canonical_set_a.intersection(canonical_set_b)\ndef tuple_intersection(listA: list, listB: list) -> Set[Tuple[Any, Any]]:\n    \"\"\"Accept Python lists of 2-element tuples and return a Python set of canonical 2-element tuples.\"\"\"\n    tuple_list_a = TupleList(listA)\n    tuple_list_b = TupleList(listB)\n\n    canonicalizer = Canonicalizer()\n    intersection_function = TupleIntersectionFunction(canonicalizer)\n\n    result_tuple_set = intersection_function.tuple_intersection(tuple_list_a, tuple_list_b)\n\n    return result_tuple_set.as_python_set()", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[[[1, 2, 3], [4, 5, 6], [7, 8, 9]], [[1, 2, 3], [7, 8, 9], [10, 11, 12]]]]}], "Mbpp/474": [{"task_id": "Mbpp/474", "solution": "import pytest\nfrom src.replace_char import replace_char", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "Mbpp/474", "solution": "def replace_char(input