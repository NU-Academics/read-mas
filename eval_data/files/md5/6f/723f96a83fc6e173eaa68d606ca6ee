ic API: Computes the sum of fourth powers of the first n odd natural numbers.\"\"\"\n    calculator = OddNumSumCalculator()\n    return calculator.odd_num_sum(n)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "Mbpp/770", "solution": "def odd_num_sum(n: int) -> int:\n    \"\"\"Calculates the sum of the fourth powers of the first n odd natural numbers.\n    Trusts that n is an integer greater than or equal to 1.\"\"\"\n    return sum((2 * k - 1) ** 4 for k in range(1, n + 1))", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/771": [{"task_id": "Mbpp/771", "solution": "from typing import List, Optional, Set, Dict\nclass Expression:\n    \"\"\"Represents the input expression string.\"\"\"\n    def __init__(self, value: str) -> None:\n        self.value = value\nclass Bracket:\n    \"\"\"Represents a bracket character and provides matching logic.\"\"\"\n    _OPENING_SYMBOLS: Set[str] = {'(', '[', '{'}\n    _CLOSING_SYMBOLS: Set[str] = {')', ']', '}'}\n    _BRACKET_PAIRS_MAP: Dict[str, str] = {\n        '(': ')', ')': '(',\n        '[': ']', ']': '[',\n        '{': '}', '}': '{'\n    }\n    _BRACKET_KINDS: Dict[str, str] = {\n        '(': 'paren', ')': 'paren',\n        '[': 'square', ']': 'square',\n        '{': 'curly', '}': 'curly'\n    }\n\n    def __init__(self, symbol: str) -> None:\n        self.symbol = symbol\n        self.kind = self._BRACKET_KINDS.get(symbol, 'unknown')\n\n    def is_opening(self) -> bool:\n        \"\"\"Checks if the bracket is an opening type.\"\"\"\n        return self.symbol in self._OPENING_SYMBOLS\n\n    def is_closing(self) -> bool:\n        \"\"\"Checks if the bracket is a closing type.\"\"\"\n        return self.symbol in self._CLOSING_SYMBOLS\n\n    def matching_symbol(self) -> str:\n        \"\"\"Returns the corresponding matching bracket symbol.\"\"\"\n        return self._BRACKET_PAIRS_MAP.get(self.symbol, '')\nclass CheckResult:\n    \"\"\"Represents the boolean outcome of the bracket check.\"\"\"\n    def __init__(self, is_balanced: bool) -> None:\n        self.is_balanced = is_balanced\nclass Stack:\n    \"\"\"A simple Last-In, First-Out (LIFO) stack implementation.\"\"\"\n    def __init__(self) -> None:\n        self._items: List[str] = []\n\n    def push(self, item: str) -> None:\n        \"\"\"Adds an item to the top of the stack.\"\"\"\n        self._items.append(item)\n\n    def pop(self) -> Optional[str]:\n        \"\"\"Removes and returns the item from the top of the stack.\"\"\"\n        if not self.is_empty():\n            return self._items.pop()\n        return None\n\n    def peek(self) -> Optional[str]:\n        \"\"\"Returns the item at the top of the stack without removing it.\"\"\"\n        if not self.is_empty():\n            return self._items[-1]\n        return None\n\n    def is_empty(self) -> bool:\n        \"\"\"Checks if the stack is empty.\"\"\"\n        return len(self._items) == 0\nclass CheckExpression:\n    \"\"\"Implements the core algorithm to check bracket balance.\"\"\"\n    _BRACKET_CHARS = {'(', ')', '[', ']', '{', '}'}\n\n    def check_expression(self, expr: str) -> bool:\n        \"\"\"Analyzes an expression for balanced and correctly nested brackets.\"\"\"\n        expression_obj = Expression(expr)\n        stack = Stack()\n\n        for char in expression_obj.value:\n            if char not in self._BRACKET_CHARS:\n                continue \n\n            current_bracket = Bracket(char)\n\n            if current_bracket.is_opening():\n                stack.push(current_bracket.symbol)\n            elif current_bracket.is_closing():\n                if stack.is_empty():\n                    # Closing bracket without a matching opening bracket\n                    return CheckResult(False).is_balanced\n                \n                top_symbol = stack.pop()\n                popped_bracket = Bracket(top_symbol)\n                \n           