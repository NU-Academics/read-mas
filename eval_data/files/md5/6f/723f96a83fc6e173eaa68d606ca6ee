      Computes the sum of strictly positive terms (n - 2*i) for i starting at 0.\n        Raises TypeError for non-integer input; returns 0 for n <= 0.\n        \"\"\"\n        if not isinstance(n, int):\n            raise TypeError(\"Input 'n' must be an integer.\")\n\n        if n <= 0:\n            return 0\n\n        current_sum = 0\n        i = 0\n        while True:\n            term = n - 2 * i\n            if term > 0:\n                current_sum += term\n                i += 1\n            else:\n                break\n        return current_sum\ndef sum_series(n: int) -> int:\n    \"\"\"\n    Module-level API required by the system.\n    Delegates the calculation to a SeriesCalculator instance.\n    \"\"\"\n    calculator = SeriesCalculator()\n    return calculator.sum_series(n)", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "Mbpp/162", "solution": "def sum_series(n: int) -> int:\n    \"\"\"Computes the sum of terms (n - 2*i) for i from 0 to floor(n/2).\"\"\"\n    total = 0\n    for i in range(0, (n // 2) + 1):\n        term = n - 2 * i\n        total += term\n    return total", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/165": [{"task_id": "Mbpp/165", "solution": "from src.alphabet import Alphabet", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "Mbpp/165", "solution": "from .count_char_position import count_char_position\ndef _alphabet_index(c: str) -> int:\n    \"\"\"Helper to map a character to its 1-based alphabet index, or 0 if not a letter.\n    Converts input char to lowercase for case-insensitive comparison.\n    \"\"\"\n    c_norm = c.lower()\n    if 'a' <= c_norm <= 'z':\n        return ord(c_norm) - ord('a') + 1\n    else:\n        return 0\ndef count_char_position(input: str) -> int:\n    \"\"\"\n    Counts characters in a string that occur at the same 1-based position as