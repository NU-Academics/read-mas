a to_digits.\n        digits = self.to_digits(n)\n        \n        # 3. If all digits are 9, call increment_middle which will expand digits and produce next palindrome (BR-5).\n        # This branch handles cases like 9, 99, 999 etc., resulting in a length increase (e.g., 99 -> 101).\n        if all(d == 9 for d in digits):\n            result_digits = self.increment_middle(digits)\n            return self.from_digits(result_digits)\n\n        # 4. Otherwise, create a mirrored candidate via mirror_left_to_right.\n        candidate_digits = self.mirror_left_to_right(digits)\n        candidate_val = self.from_digits(candidate_digits)\n        \n        # 5. If candidate > n, return candidate (converted to int via from_digits).\n        if candidate_val > n:\n            return candidate_val\n        \n        # 6. If candidate <= n, call increment_middle to adjust middle digits and propagate carry.\n        #    The increment_middle method itself handles internal mirroring to ensure a palindrome result.\n        result_digits = self.increment_middle(digits) \n        return self.from_digits(result_digits)\n\n    def is_palindrome(self, n: int) -> bool:\n        \"\"\"Check digit-wise palindrome property.\"\"\"\n        digits = self.to_digits(n)\n        return digits == digits[::-1]\n\n    def to_digits(self, n: int) -> List[int]:\n        \"\"\"Convert integer to most-significant-first digit list.\"\"\"\n        if n == 0:\n            return [0]\n        digits = []\n        temp_n = n\n        while temp_n > 0:\n            digits.append(temp_n % 10)\n            temp_n //= 10\n        return digits[::-1] # Reverse the list to get most-significant-first order\n\n    def from_digits(self, digits: List[int]) -> int:\n        \"\"\"Convert digit list back to integer.\"\"\"\n        if not digits:\n            return 0 # Handle empty digit lists, consistent with 0.\n        num = 0\n        for digit in digits:\n            num = num * 10 + digit\n        return num\n\n    def mirror_left_to_right(self, digits: List[int]) -> List[int]:\n        \"\"\"Mirror left half to right half to form candidate palindrome digits.\"\"\"\n        n = len(digits)\n        mirrored_digits = list(digits) # Work on a copy to avoid side effects\n        for i in range(n // 2):\n            mirrored_digits[n - 1 - i] = mirrored_digits[i]\n        return mirrored_digits\n\n    def increment_middle(self, digits: List[int]) -> List[int]:\n        \"\"\"Increment the middle digit(s) and propagate carry, expanding length for all-9s.\"\"\"\n        n = len(digits)\n        \n        # Special case: If all digits are 9, the number expands (e.g., 9 -> 11, 99 -> 101).\n        if all(d == 9 for d in digits):\n            return [1] + [0] * (n - 1) + [1] \n\n        new_digits = list(digits)\n        \n        # Determine the starting index for incrementing from the effective middle.\n        # This is the exact middle digit for odd length, or the rightmost digit of the left half for even length.\n        i = (n - 1) // 2 \n        \n        carry = 1\n        \n        # Propagate carry from the middle (or left-middle) towards the most significant digit.\n        while i >= 0 and carry > 0:\n            val = new_digits[i] + carry\n            new_digits[i] = val % 10\n            carry = val // 10\n            i -= 1\n        \n        # After incrementing and propagating carry, mirror the left half to the right to form a palindrome.\n        return self.mirror_left_to_right(new_digits)\n_palindrome_service_instance = PalindromeService()\ndef next_smallest_palindrome(n: int) -> int:\n    \"\"\"Public API entry point: Computes the smallest palindrome strictly greater than n.\"\"\"\n    return _palindrome_service_instance.next_smallest_palindrome(n)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "Mbpp/100", "solution": "from src.validator import Validator\nfrom src.models import InputInteger, PalindromeResult\nclass PalindromeCalculator:\n    \"\"\"Core algorithmic component finding minimal palindrome > input.\"\"\"\n\n    def is_palindrome(self, n: int) -> bool:\n        \"\"\"Checks if a number is a palindrome by comparing its string representation with its reverse.\"\"\"\n        s = str(n)\n        return s == s[::-1]\n\n    def generate_next_candidate(self, n: int) -> int:\n        \"\"\"Generates the next numerical candidate for palindrome search by incrementing the input.\"\"\"\n        return n + 1\n\n    def next_smallest_palindrome(self, n_val: int) -> int:\n        \"\"\"Finds the smallest palindrome integer strictly greater than the input by iterating candidates.\"\"\"\n        current_candidate = n_val\n        while True:\n            current_candidate = self.generate_next_candidate(current_candidate)\n            if self.is_palindrome(current_candidate):\n                return current_candidate\ndef next_smallest_palindrome(n: int) -> int:\n    \"\"\"Facade matching FR-1; validates, delegates to PalindromeCalculator, verifies overflow, and returns int.\"\"\"\n    Validator().validate_input_type(n)\n    \n    # InputInteger and PalindromeResult are used for traceability as per design.\n    input_obj = InputInteger(n) \n    \n    calculator = PalindromeCalculator()\n    result_int = calculator.next_smallest_palindrome(input_obj.value)\n    \n    Validator().check_overflow(result_int)\n    \n    result_obj = PalindromeResult(result_int)\n    return result_obj.value", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/103": [{"task_id": "Mbpp/103", "solution": "# src/calculator.py\n# from src.result import Result # Result is not directly used, int is returned.\n\nclass EulerianCalculator:\n    \"\"\"\n    EulerianCalculator implementation that computes a(n, m).\n    \"\"\"\n    def eulerian_num(self, n: int, m: int) -> int:\n        \"\"\"Public compute method; uses _compute_iterative for performance.\"\"\"\n        # The top-level eulerian_num function in src/eulerian.py handles validation.\n        # This method assumes valid inputs: n >= 0, 0 <= m < n.\n        return self._compute_iterative(n, m)\n\n    def _compute_recursive(self, n: int, m: int) -> int:\n        \"\"\"\n        Reference recursive implementation: a(n,m) = (n-m)*a(n-1,m-1) + (m+1)*a(n-1,m).\n        \"\"\"\n        # Base cases\n        if m < 0 or m >= n:\n            return 0\n        if n == 0 and m == 0:\n            return 1\n        \n        # Recurrence relation\n        term1 = (n - m) * self._compute_recursive(n - 1, m - 1)\n        term2 = (m + 1) * self._compute_recursive(n - 1, m)\n        return term1 + term2\n\n    def _compute_iterative(self, n: int, m: int) -> int:\n        \"\"\"\n        Iterative DP: fill A[0..n][0..n] using base cases and return A[n][m].\n        \"\"\"\n        # Initialize a 2D table A[i][j] where i is n_val and j is m_val\n        # The table size is (n+1) x (n+1) to accommodate indices from 0 to n.\n        A = [[0] * (n + 1) for _ in range(n + 1)]\n\n        # Base case: a(0,0) = 1\n        A[0][0] = 1\n\n        # Fill the table using the recurrence relation\n        for i in range(1, n + 1):  # Iterate for n from 1 to N\n            for j in range(i):  # Iterate for m from 0 to i-1\n                # a(i,j) = (i-j)*a(i-1,j-1) + (j+1)*a(i-1,j)\n                \n                # term1: (i-j) * A[i-1][j-1]\n                # If j-1 is out of bounds (i.e., j=0), a(i-1,-1) is 0.\n                term1 = (i - j) * (A[i-1][j-1] if j > 0 else 0)\n                \n                # term2: (j+1) * A[i-1][j]\n                term2 = (j + 1) * A[i-1][j]\n                \n                A[i][j] = term1 + term2\n        \n        # The result is the value at A[n][m]\n        return A[n][m]", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "Mbpp/103", "solution": "from typing import Optional\nclass ValidationError(Exception):\n    \"\"\"Exception raised for invalid inputs to Eulerian number calculations.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\nclass InputValidation:\n    \"\"\"Handles validation logic for Eulerian number inputs.\"\"\"\n    def __init__(self):\n        self.error_message: str = \"\"\n\n    def is_valid(self, n: int, m: int) -> bool:\n        \"\"\"Validates n and m based on Eulerian number domain rules.\"\"\"\n        if n < 0:\n            self.error_message = \"n must be non-negative.\"\n            return False\n        if n == 0:\n            if m != 0:\n                self.error_message = \"For n=0, m must be 0.\"\n                return False\n        else:  # n > 0\n            if not (0 <= m < n):\n                self.error_message = \"For n>0, m must be between 0 and n-1 (inclusive).\"\n                return False\n        return True\nclass EulerianService:\n    \"\"\"Service to validate inputs and compute Eulerian numbers.\"\"\"\n    def __init__(self):\n        self._memo = {} # Memoization dictionary for compute method.\n\n    def eulerian_num(self, n: int, m: int) -> int:\n        \"\"\"Public method to compute the Eulerian number a(n, m).\"\"\"\n        self.validate_inputs(n, m)\n        computed_value = self.compute(n, m)\n        return computed_value\n\n    def validate_inputs(self, n: int, m: int) -> None:\n        \"\"\"Validates inputs and raises ValidationError if invalid.\"\"\"\n        validator = InputValidation()\n        if not validator.is_valid(n, m):\n            raise ValidationError(validator.error_message)\n\n    def compute(self, n: int, m: int) -> int:\n        \"\"\"Computes a(n, m) using base case and recurrence with memoization.\"\"\"\n        if (n, m) in self._memo:\n            return self._memo[(n, m)]\n\n        # Base case a(0,0) = 1\n        if n == 0 and m == 0:\n            result = 1\n        # Boundary conditions: a(n,m) = 0 if m < 0 or m >= n 