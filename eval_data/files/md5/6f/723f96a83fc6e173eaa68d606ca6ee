 Algorithm to solve ax + by = gcd(a,b).\"\"\"\n    def solve(self, a: int, b: int) -> tuple[int, int, int]:\n        \"\"\"Returns (x, y, g) such that a*x + b*y = g and g = gcd(a, b).\"\"\"\n        s, old_s = 0, 1\n        t, old_t = 1, 0\n        r, old_r = b, a\n\n        while r != 0:\n            quotient = old_r // r\n            old_r, r = r, old_r - quotient * r\n            old_s, s = s, old_s - quotient * s\n            old_t, t = t, old_t - quotient * t\n\n        g = old_r\n        x, y = old_s, old_t\n\n        # Ensure g is non-negative as per design specification.\n        if g < 0:\n            g = -g\n            x = -x\n            y = -y\n\n        return (x, y, g)\nclass Solver:\n    \"\"\"Orchestrates the finding of integer solutions for a*x + b*y = n.\"\"\"\n    def __init__(self):\n        self.validator = Validator()\n        self.gcd_calculator = GCDCalculator()\n        self.extended_euclid = ExtendedEuclid()\n\n    def find_solution(self, a: int, b: int, n: int) -> tuple[int, int] | None:\n        \"\"\"Finds integers x, y satisfying a*x + b*y = n, or None if no solution exists.\"\"\"\n        # Per CRITICAL REQUIREMENTS: \"Trust the caller's inputs\".\n        # The Validator methods are called as per design but perform no checks.\n        self.validator.isInteger(a)\n        self.validator.isInteger(b)\n        self.validator.isInteger(n)\n        self.validator.validateRange(a)\n        self.validator.validateRange(b)\n        self.validator.validateRange(n)\n\n        # Handle degenerate case: a == 0 and b == 0 (UC7)\n        if a == 0 and b == 0:\n            if n == 0:\n                return (0, 0)  # Canonical choice per design decision\n            else:\n                return None\n\n        # Handle special case: a == 0 (implies b != 0 due to previous check) (UC6)\n        if a == 0:\n            if n % b == 0:\n                return (0, n // b)\n            else:\n                return None\n\n        # Handle special case: b == 0 (implies a != 0 due to previous checks) (UC6)\n        if b == 0:\n            if n % a == 0:\n                return (n // a, 0)\n            else:\n                return None\n\n        # General case: a != 0 and b != 0\n        g = self.gcd_calculator.compute(a, b)\n\n        # Check solvability: n must be divisible by gcd(a, b) (UC3, UC5)\n        if n % g != 0:\n            return None\n\n        # Compute a particular solution using Extended Euclidean Algorithm (UC4)\n        x0, y0, g_euclid = self.extended_euclid.solve(a, b)\n\n        # Scale the particular solution (x0, y0) by n/g_euclid\n        k = n // g_euclid\n        x = x0 * k\n        y = y0 * k\n        return (x, y)\ndef find_solution(a: int, b: int, n: int) -> tuple[int, int] | None:\n    \"\"\"Public API: Finds integers x, y satisfying a*x + b*y = n, or None if no solution exists.\"\"\"\n    return Solver().find_solution(a, b, n)", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[2, 3, 7]], "plus_fail_tests": [[25, 10, 500]]}, {"task_id": "Mbpp/160", "solution": "from typing import Tuple, Optional\nfrom dataclasses import dataclass\nclass LinearDiophantineSolver:\n    \"\"\"Core solver for linear Diophantine equations ax + by = n.\"\"\"\n\n    def compute_gcd(self, a: int, b: int) -> int:\n        \"\"\"Computes the greatest common divisor of a and b using the Euclidean algorithm.\"\"\"\n        while b:\n            a, b = b, a % b\n        return abs(a)\n\n    def extended_gcd(self, a: int, b: int) -> GCDResult:\n        \"\"\"Computes g = gcd(a, b) and coefficients x0, y0 such that a*x0 + b*y0 = g.\"\"\"\n        if a == 0:\n            # Base case: gcd(0, b) = abs(b), with 0*0 + b*(+/-1) = abs(b)\n            return GCDResult(abs(b), 0, 1 if b >= 0 else -1)\n        \n        # Recursive step\n        gcd_res = self.extended_gcd(b % a, a)\n        g, x1, y1 = gcd_res.g, gcd_res.x0, gcd_res.y0\n        \n        x0 = y1 - (b // a) * x1\n        y0 = x1\n        return GCDResult(g, x0, y0)\n\n    def find_solution(self, a: int, b: int, n: int) -> Optional[Tuple[int, int]]:\n        \"\"\"\n        Finds a particular integer solution (x, y) for a*x + b*y = n.\n        Returns None if no integer solution exists.\n        \"\"\"\n        # Handle the special case where both a and b are zero\n        if a == 0 and b == 0:\n            if n == 0:\n                return (0, 0) # Canonical solution for 0x + 0y = 0\n            else:\n                return None # No solution for 0x + 0y = n where n != 0\n\n        g = self.compute_gcd(a, b)\n\n        # Check if n is divisible by g; if not, no integer solution exists\n        if n % g != 0:\n            return None\n\n        # Compute Bezout coefficients x0, y0 for a*x0 + b*y0 = g\n        gcd_result = self.extended_gcd(a, b)\n        \n        # Scale the Bezout coefficients to find a particular solution for a*x + b*y = n\n        scale_factor = n // g\n        x_particular = gcd_result.x0 * scale_factor\n        y_particular = gcd_result.y0 * scale_factor\n\n        # Canonicalize the solution to satisfy specific examples like (2,1) for (2,3,7)\n        if b != 0:\n            b_prime = b // g\n            x_final = x_particular % b_prime\n            # If x_final becomes negative and b_prime is positive, adjust it.\n            # Python's % operator on negative numbers gives results with the same sign as divisor.\n            # For 2,3,7: x_particular is -7, b_prime is 3. -7 % 3 is 2. This works directly.\n            y_final = (n - a * x_final) // b\n        elif a != 0: # b must be 0 here\n            x_final = n // a\n            y_final = 0\n        else: # Both a and b are 0, handled at the start\n            return (0, 0) # Should not be reached if first check is correct\n\n        return (x_final, y_final)\n_solver = LinearDiophantineSolver()\ndef find_solution(a: int, b: int, n: int) -> Optional[Tuple[int, int]]:\n    \"\"\"\n    Returns integers x and y satisfying a*x + 