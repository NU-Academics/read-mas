  if not abs_value_str:  # Handles 0 correctly\n            return [Digit(0)]\n        return [Digit(int(d)) for d in abs_value_str]\nclass IntegerList:\n    \"\"\"Represents and validates a list of integers, wrapping them as Integer objects.\"\"\"\n    def __init__(self, elements: List[int]) -> None:\n        if not isinstance(elements, list):\n            raise TypeError(\"Input must be a list of integers.\")\n        \n        self.elements: List[Integer] = []\n        for item in elements:\n            if not isinstance(item, int):\n                raise TypeError(\"All elements in the list must be integers.\")\n            self.elements.append(Integer(item))\n\n    def length(self) -> int:\n        \"\"\"Returns the number of Integer elements in the list.\"\"\"\n        return len(self.elements)\nclass Result:\n    \"\"\"Holds the aggregated total sum of digits.\"\"\"\n    def __init__(self, total: int) -> None:\n        self.total = total\nclass SumOfDigitsFunction:\n    \"\"\"Encapsulates the computation algorithm for summing digits.\"\"\"\n    name: str = \"sum_of_digits\"\n\n    def compute(self, integer_list: IntegerList) -> Result:\n        \"\"\"Computes the total sum of all decimal digits from the IntegerList.\"\"\"\n        current_total = 0\n        for integer_obj in integer_list.elements:\n            for digit_obj in integer_obj.digits():\n                current_total += digit_obj.value\n        return Result(current_total)\ndef sum_of_digits(list_of_integers: List[int]) -> int:\n    \"\"\"\n    Public API to compute the sum of all decimal digits of each integer in the input list.\n    Ignores numeric sign and returns the aggregated total.\n    \"\"\"\n    integer_list_validated = IntegerList(list_of_integers)\n    calculator = SumOfDigitsFunction()\n    result = calculator.compute(integer_list_validated)\n    return result.total", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[[[10, 20, 4, 5, "b", 70, "a"]]]], "plus_fail_tests