init__(self, size: int):\n        self.size = size\ndef _to_NumberList(numbers: list[int]) -> NumberList:\n    \"\"\"\n    Converts a list of primitive integers to a NumberList of Number objects.\n    \"\"\"\n    return NumberList([Number(n) for n in numbers])\ndef largest_subset(numbers: list[int]) -> int:\n    \"\"\"\n    Computes the size of the largest subset where every unordered pair (a, b)\n    satisfies divisibility (either a divides b or b divides a).\n    \"\"\"\n    if not numbers:\n        return 0 # BR-5: Empty list returns 0.\n\n    # Convert primitive integers to domain Number objects.\n    number_list_obj = _to_NumberList(numbers)\n    number_objects = number_list_obj.numbers\n\n    # Sort numbers for dynamic programming. Sorting by absolute value primarily,\n    # then by value for ties, helps ensure that for any chain a | b, a will appear\n    # before b in the sorted list if abs(a) <= abs(b), simplifying DP checks.\n    # BR-6 implies duplicates are treated as separate elements.\n    number_objects.sort(key=lambda x: (abs(x.value), x.value))\n\n    n = len(number_objects)\n    # dp[i] will store the length of the longest divisibility chain ending with number_objects[i].\n    dp = [1] * n\n    div_rel = DivisibilityRelation()\n\n    max_size = 0 if n == 0 else 1 # Minimum size is 1 for any non-empty list\n\n    for i in range(n):\n        for j in range(i):\n            # For a divisibility chain num_j | num_i, we need div_rel.divides(num_j, num_i) to be true.\n            # Due to sorting by absolute value, if number_objects[j].value divides number_objects[i].value,\n            # then abs(number_objects[j].value) will be less than or equal to abs(number_objects[i].value).\n            # This ensures we are always extending a chain with a \"larger\" (in magnitude) number that it divides.\n            if div_rel.divides(number_objects[j], number_objects[i]):\n                dp[i] = max(dp[i], 1 + dp[j])\n        max_size = max(max_size, dp[i])\n\n    return Result(max_size).size", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[[9, 3, 12, 7, 16, 3, 11, 8, 4, 13, 13]]]}, {"task_id": "Mbpp/620", "solution": "def largest_subset(nums):\n    \"\"\"\n    Finds the size of the largest divisible subset in the given list of numbers.\n    The implementation is deterministic and side-effect-free.\n    \"\"\"\n    # Check if 0 is present in the input list.\n    has_zero = 0 in nums\n    \n    # Filter out zeros and sort the remaining numbers.\n    # Zeros are handled separately as they divide any non-zero number.\n    non_zero_nums = sorted([num for num in nums if num != 0])\n\n    max_size_for_non_zero = 0\n    if non_zero_nums:\n        # _compute_pairwise_divisibility_graph builds an adjacency list\n        # where graph[i] contains indices j (j < i) such that nums[j] and nums[i]\n        # satisfy the divisibility condition.\n        predecessors_graph = _compute_pairwise_divisibility_graph(non_zero_nums)\n\n        # _find_largest_subset_size computes the max length of a divisible subset chain\n        # using dynamic programming on the sorted numbers and the predecessors graph.\n        max_size_for_non_zero = _find_largest_subset_size(non_zero_nums, predecessors_graph)\n    \n    # If 0 was in the original list, it can be included with any other divisible subset\n    # to form a larger one, as any non-zero number divides 0.\n    # If only zeros were present, a subset containing one 0 has size 1.\n    if has_zero:\n        return max_size_for_non_zero + 1\n    else:\n        return max_size_for_non_zero\ndef _compute_pairwise_divisibility_graph(nums):\n    \"\"\"\n    Builds an adjacency list where graph[i] contains indices j (j < i) such that\n    nums[j] and nums[i] are divisible (a divides b or b divides a).\n    This function assumes `nums` contains no zeros.\n    \"\"\"\n    n = len(nums)\n    # predecessors_graph[i] stores indices j (where j < i) that can precede nums[i].\n    predecessors_graph = [[] for _ in range(n)]\n\n    for i in range(n):\n        for j in range(i):  # Check all previous numbers as potential predecessors.\n            # Check if nums[i] is divisible by nums[j] OR nums[j] is divisible by nums[i].\n            if nums[i] % nums[j] == 0 or nums[j] % nums[i] == 0:\n                predecessors_graph[i].append(j)\n    return predecessors_graph\ndef _find_largest_subset_size(nums, predecessors_graph):\n    \"\"\"\n    Computes the size of the largest divisible subset using dynamic programming.\n    dp[i] stores the length of the longest divisible subset ending with nums[i].\n    \"\"\"\n    n = len(nums)\n    if n == 0:\n        return 0\n\n    # Initialize dp values to 1, as each number itself forms a subset of size 1.\n    dp = [1] * n\n\n    # Iterate through the numbers and update dp values based on divisibility relations.\n    for i in range(n):\n        # For each j in predecessors_graph[i], nums[j] can extend to nums[i].\n        for j in predecessors_graph[i]:\n            dp[i] = max(dp[i], dp[j] + 1)\n    \n    # The maximum value in dp is the size of the longest divisible subset found.\n    return max(dp)", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[[9, 3, 12, 7, 16, 3, 11, 8, 4, 13, 13]]]}], "Mbpp/622": [{"task_id": "Mbpp/622", "solution": "from typing import Sequence, Union\nfrom src.input_validator import InputValidator\nfrom src.models import SortedList, NumericElement, MedianResult\ndef _median_of_two_sorted_lists(a: Sequence[float], b: Sequence[float], n: int) -> float:\n    \"\"\"\n    Calculates the median of two sorted lists, each of length n.\n    This module-private function assumes inputs are valid and sorted floats.\n    \"\"\"\n    i = 0  # Pointer for list a\n    j = 0  # Pointer for list b\n    m1 = 0.0 # Stores the (n)-th element of the merged list\n    m2 = 0.0 # Stores the (n+1)-th element of the merged list\n\n    # Iterate n+1 times