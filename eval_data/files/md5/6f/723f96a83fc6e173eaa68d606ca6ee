  self._n = len(input_list)\n\n    def combinations_list(self) -> List[List[Any]]:\n        \"\"\"Generates and returns the ordered list of all combinations using its internal state.\"\"\"\n        output_list = OutputList()\n        for bits_pattern in self._enumerate_bits():\n            combination = self._build_combination(bits_pattern)\n            output_list.append(combination)\n        return output_list.combinations\n\n    def _enumerate_bits(self) -> Iterator[int]:\n        \"\"\"Yields integers from 0 to 2^n - 1 for bit-index enumeration.\"\"\"\n        num_combinations = 1 << self._n # Equivalent to 2 raised to the power of self._n\n        for i in range(num_combinations):\n            yield i\n\n    def _build_combination(self, bits: int) -> List[Any]:\n        \"\"\"Builds a single combination by selecting elements based on bits, in descending index order.\"\"\"\n        current_combination: List[Any] = []\n        # Iterate from the highest index down to 0 (n-1 to 0)\n        for index in range(self._n - 1, -1, -1):\n            # Check if the bit at the current 'index' position is set (1)\n            if (bits >> index) & 1:\n                current_combination.append(self._input[index])\n        return current_combination\ndef combinations_list(input_list: list) -> List[List[Any]]:\n    \"\"\"\n    Public API function to generate all combinations of the input list.\n    Delegates the generation process to a CombinationGenerator instance.\n    \"\"\"\n    generator = CombinationGenerator(input_list)\n    return generator.combinations_list()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "Mbpp/462", "solution": "from typing import Any, List\nclass Combination:\n    \"\"\"Represents a generated subset, including its elements and the mask that created it.\"\"\"\n    def __init__(self, elements: List[Any], mask: int):\n        self.elements = elements\n        self.mask = mask\nclass Combinatio