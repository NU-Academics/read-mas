     continue\n\n            num_b = all_numbers_data.get(b_val)\n            # If b_val is outside the initial range (numbers list), create its Number object.\n            if not num_b:\n                num_b = Number(b_val)\n                all_numbers_data[b_val] = num_b # Cache it for future reference.\n            \n            if num_b.sumOfProperDivisors is None:\n                num_b.sumOfProperDivisors = self.divisor_calculator.sumOfProperDivisors(b_val)\n            \n            sum_b = num_b.sumOfProperDivisors\n\n            if sum_b == a_val:  # Amicable pair (a_val, b_val) found\n                num_a.isAmicable = True\n                num_b.isAmicable = True\n                AmicablePair(a_val, b_val) # Instantiate as per design.\n\n                # Add numbers to the sum if they are within the original 'n' range.\n                if a_val in numbers:\n                    amicable_numbers_to_sum.add(a_val)\n                if b_val in numbers:\n                    amicable_numbers_to_sum.add(b_val)\n\n        for val in amicable_numbers_to_sum:\n            result.add(val)\n        return result.sum\n_amicable_service_instance = AmicableService()\ndef amicable_numbers_sum(n: int) -> int:\n    \"\"\"Calculates the sum of all amicable numbers up to a specified number n.\"\"\"\n    return _amicable_service_instance.amicable_numbers_sum(n)", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/124": [{"task_id": "Mbpp/124", "solution": "from .angle_complex import angle_complex\nimport math\nfrom typing import Tuple, Union\nclass ComplexNumber:\n    \"\"\"Represents a complex number's real and imag components.\"\"\"\n    def __init__(self, real: float, imag: float):\n        self.real = real\n        self.imag = imag\n\n    def to_polar(self) -> Tuple[float, float]:\n        \"\"\"Returns the magnitude and argument (r, theta) of the complex number.\"\"\"\n        r = math.hypot(self.real, self.imag)\n        theta = math.atan2(self.imag, self.real)\n        return (r, theta)\nclass AngleResult:\n    \"\"\"Simple holder for the resulting angle in radians.\"\"\"\n    def __init__(self, radians: float):\n        self.radians = radians\nclass InputValidator:\n    \"\"\"Centralized input validation and conversion to numeric types.\"\"\"\n    def validate_numeric(self, value: Union[int, float, str, complex], role: str = 'value') -> float:\n        \"\"\"Attempts to convert a value to float, handling complex literals for 'imag' role.\"\"\"\n        if isinstance(value, complex):\n            # Special handling for Python-style imaginary literals for 'imag' input\n            if role == 'imag':\n                return value.imag\n            else:\n                # For 'real' input, complex numbers are not expected\n                raise TypeError(f\"'{role}' input cannot be a complex number like '{value}'.\")\n        try:\n            return float(value)\n        except (ValueError, TypeError) as e:\n            raise TypeError(f\"'{role}' input must be numeric or convertible to numeric, got '{value}' of type {type(value).__name__}.\") from e\n\n    def validate_pair(self, real: Union[int, float, str, complex], imag: Union[int, float, str, complex]) -> Tuple[float, float]:\n        \"\"\"Validates and converts both real and imag inputs to floats.\"\"\"\n        real_f = self.validate_numeric(real, role='real')\n        imag_f = self.validate_numeric(imag, role='imag')\n        return (real_f, imag_f)\nclass AngleCalculator:\n    \"\"\"Computes the angle (argument) of a ComplexNumber.\"\"\"\n    def compute_angle(self, c: ComplexNumber) -> float:\n        \"\"\"Calculates the angle using math.atan2(imag, real).\"\"\"\n        return math.atan2(c.imag, c.real)\ndef angle_complex(real: Union[int, float, str, complex], imag: Union[int, float, str, complex]) -> float:\n    \"\"\"\n    Computes the argument (angle) of a complex number from its real and imaginary parts.\n    Handles input validation and uses atan2(imag, real) for calculation.\n    \"\"\"\n    validator = InputValidator()\n    real_f, imag_f = validator.validate_pair(real, imag)\n\n    complex_num = ComplexNumber(real_f, imag_f)\n    calculator = AngleCalculator()\n    radians = calculator.compute_angle(complex_num)\n\n    angle_result = AngleResult(radians)\n    return angle_result.radians", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "Mbpp/124", "solution": "from dataclasses import dataclass\nimport math\nfrom typing import Union\nfrom src.domain import ComplexNumber, AngleResult\ndef angle_complex(*args) -> float:\n    \"\"\"\n    Computes the argument (angle) of a complex number in radians.\n    Supports angle_complex(z: complex) or angle_complex(real, imag) forms.\n    \"\"\"\n    real: float\n    imag: float\n\n    if len(args) == 1:\n        z = args[0]\n        # Assume z is a complex-like object with .real and .imag attributes.\n        real = float(z.real)\n        imag = float(z.imag)\n    elif len(args) == 2:\n        real_arg = args[0]\n        imag_arg = args[1]\n        \n        real = float(real_arg)\n        # If imag_arg has an 'imag' attribute (like a complex number), use it.\n        # Otherwise, coerce imag_arg directly to a float.\n        if hasattr(imag_arg, 'imag'):\n            imag = imag_arg.imag\n        else:\n            imag = float(imag_arg)\n    # Per design, implicitly handle valid inputs conforming to 1 or 2 arguments.\n    # No explicit error handling for other argument counts, trusting the caller.\n        \n    return math.atan2(imag, real)", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/125": [{"task_id": "Mbpp/125", "solution": "class Validator:\n    \"\"\"Provides stateless utilities for validating binary string inputs.\"\"\"\n    def validate_binary_chars(self, s: str) -> bool:\n        \"\"\"Returns True if s consists only of '0' and '1' characters.\"\"\"\n        for char in s:\n            if char not in ('0', '1'):\n                return False\n        return True\nclass FindLengthFunction:\n    \"\"\"Orchestrates validation and computes the maximum difference.\"\"\"\n    def __init__(self, validator: Validator = None):\n        self.validator = validator if validator is not None else Validator()\n\n    def find_length(self, s: str) -> int:\n        \"\"\"Computes the maximum (count('0') - count('1')) over all substrings.\n        Raises ValueError for invalid input characters.\n        \"\"\"\n        if not self.validator.validate_binary_chars(s):\n            raise ValueError(\"input must contain only '0' and '1'\")\n\n        max_difference = 0\n        current_difference = 0\n\n        for char in s:\n            val = 1 if char == '0' else -1\n            current_difference += val\n            max_difference = max(max_difference, current_difference)\n            if current_difference < 0:\n                current_difference = 0\n        \n        return max_difference\ndef find_length(s: str) -> int:\n    \"\"\"Public API: Finds the maximum (zeros - ones) over all contiguous substrings of s.\n    Raises ValueError for invalid input characters.\n    \"\"\"\n    finder = FindLengthFunction()\n    return finder.find_length(s)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "Mbpp/125", "solution": "class BinaryString:\n    \"\"\"Encapsulates the input string and provides its length.\"\"\"\n    def __init__(self, content: str):\n        self.content = content\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the binary string content.\"\"\"\n        return len(self.content)\nclass Substring:\n    \"\"\"Immutable container for substring data and difference calculation.\"\"\"\n    def __init__(self, content: str, startIndex: int, endIndex: int):\n        self.content = content\n        self.startIndex = startIndex\n        self.endIndex = endIndex\n        self.zerosCount = content.count('0')\n        self.onesCount = content.count('1')\n\n    def difference(self) -> int:\n        \"\"\"Computes and returns the difference (zerosCount - onesCount).\"\"\"\n        return self.zerosCount - self.onesCount\nclass Result:\n    \"\"\"Holds the final maximum difference integer.\"\"\"\n    def __init__(self, maxDifference: int):\n        self.maxDifference = maxDifference\nclass AnalyzerFunction:\n    \"\"\"Orchestrates validation, substring generation, difference computation, and result production.\"\"\"\n\n    def find_length(self, binaryString: str) -> int:\n        \"\"\"\n        Orchestrates finding the maximum difference between zeros and ones.\n        Per critical requirements, input is trusted without explicit validation.\n        \"\"\"\n        binary_str_obj = BinaryString(binaryString)\n\n        # Per critical requirement, explicit input validation is skipped.\n        # self.validateBinaryString(binary_str_obj) is not called.\n\n        substrings = self.generateContiguousSubstrings(binary_str_obj)\n\n        if not substrings:\n            return 0  # No substrings for an empty input string, max difference is 0.\n\n        max_difference = -float('inf')\n\n        for sub in substrings:\n            difference = self.computeDifference(sub)\n            if difference > max_difference:\n                max_difference = difference\n\n        return Result(max_difference).maxDifference\n\n    def validateBinaryString(self, binaryString: BinaryString) -> bool:\n        \"\"\"\n        Placeholder method per design.\n        Actual validation logic is forbidden by critical requirements.\n        \"\"\"\n        return True # Always returns True as per \"Trust the caller's inputs\"\n\n    def generateContiguousSubstrings(self, binaryString: BinaryString) -> list[Substring]:\n        \"\"\"Generates all contiguous substrings from the BinaryString.\"\"\"\n        substrings = []\n        n = binaryString.length()\n        for i in range(n):\n            for j in range(i, n):\n                sub_content = binaryString.content[i : j + 1]\n                substrings.append(Substring(sub_content, i, j))\n        return substrings\n\n    def computeDifference(self, substring: Substring) -> int:\n        \"\"\"Computes the difference for a given Substring instance.\"\"\"\n        return substring.difference()\n_analyzer = AnalyzerFunction()\ndef find_length(binary_string: str) -> int:\n    \"\"\"\n    Module-level API: finds the maximum difference (zeros - ones) in any substring.\n    Delegates to AnalyzerFunction and assumes valid input.\n    \"\"\"\n    return _analyzer.find_length(binary_string)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/126": [{"task_id": "Mbpp/126", "solution": "from .sum_function import sum\nfrom dataclasses import dataclass\nfrom .gcd import GCD\nfrom .models import InputPair, CommonDivisor, Result\nfrom .sum_function import sum\nclass GCD:\n    def compute(self, a: int, b: int) -> int:\n        \"\"\"Compute gcd(abs(a), abs(b)) using the Euclidean algorithm.\n        If both inputs are zero, returns 0 as per design.\n        \"\"\"\n        a, b = abs(a), abs(b)\n        if a == 0 and b == 0:\n            return 0\n        while b:\n            a, b = b, a % b\n        return a\ndef _find_divisors(n: int) -> list[int]:\n    \"\"\"Return a list of positive divisors of n.\n    Handles n=0 by returning an empty list.\n    \"\"\"\n    if n == 0:\n        return []\n    divs = []\n    for i in range(1, int(n**0.5) + 1):\n        if n % i == 0:\n            divs.append(i)\n            if i * i != n:\n                divs.append(n // i)\n    return sorted(divs)\ndef sum(a: int, b: int) -> int:\n    \"\"\"Computes the sum of all positive common divisors of two integers.\n    Uses GCD, enumerates its divisors, and sums them.\n    \"\"\"\n    # Input validation (e.g., TypeError for non-int) is explicitly forbidden by critical requirements,\n    # overriding BR5 from the design. Inputs are trusted to be integers.\n\n    gcd_calculator = GCD()\n    gcd_value = gcd_calculator.compute(a, b)\n\n    if gcd_value == 0: # This covers the both-zero input case and no positive common divisors.\n        return 0\n\n    divisors = _find_divisors(gcd_value)\n    return int(sum(divisors))", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "Mbpp/126", "solution": "import math\ndef sum(a, b) -> int:\n    \"\"\"Calculates the sum of common positive divisors for two integers.\n    It computes the GCD of absolute inputs, then sums its divisors.\"\"\"\n    n1 = abs(a)\n    n2 = abs(b)\n    \n    g = math.gcd(n1, n2)\n    \n    divisors = set()\n    # Enumerate divisors of g efficiently\n    for d in range(1, int(g**0.5) + 1):\n        if g % d == 0:\n            divisors.add(d)\n            if d != g // d:\n                divisors.add(g // d)\n                \n    return sum(divisors)", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[10, 15]], "plus_fail_tests": [[27, 81]]}], "Mbpp/127": [{"task_id": "Mbpp/127", "solution": "import pytest\nfrom src.multiply import multiply_int\ndef multiply_int(a: int, b: int) -> int:\n    \"\"\"Validates both a and b are integers, then computes their product.\n    Raises TypeError if either parameter is not an integer.\n    \"\"\"\n    if not (isinstance(a, int) and isinstance(b, int)):\n        raise TypeError(\"Both inputs must be integers.\")\n    return a * b", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "Mbpp/127", "solution": "from dataclasses import dataclass\ndef multiply_int(a: int, b: int) -> int:\n    \"\"\"Return integer product of a and b.\n    Preconditions: a and b are integers.\n    \"\"\"\n    return a * b", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/128": [{"task_id": "Mbpp/128", "solution": "def parse_words(words) -> list:\n    \"\"\"Converts input words into a list of string tokens.\n    Handles string input by splitting on whitespace, and iterable input by converting to a list.\"\"\"\n    if isinstance(words, str):\n        return words.split()\n    else:\n        return list(words)\ndef filter_long_words(tokens, n) -> list:\n    \"\"\"Filters a list of tokens, returning only those whose length is strictly greater than n.\n    Preserves the original order of qualifying tokens.\"\"\"\n    result = []\n    for token in tokens:\n        if len(token) > n:\n            result.append(token)\n    return result\ndef long_words(n, words) -> list:\n    \"\"\"Public API to find words longer than n characters from the input.\n    It parses the input words and then filters them based on length.\"\"\"\n    tokens = parse_words(words)\n    result = filter_long_words(tokens, n)\n    return result", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "Mbpp/128", "solution": "from typing import Iterable, List, Union\nfrom src.tokenizer import Tokenizer\nfrom src.domain import Word, ResultList, StringInput, ListInput\ndef _filter_words(n: int, tokens: Iterable[str]) -> List[str]:\n    \"\"\"Return tokens from iterable whose length > n preserving order.\"\"\"\n    filtered_tokens = []\n    for token in tokens:\n        word = Word(token)\n        if word.length() > n:\n            filtered_tokens.append(word.text)\n    return filtered_tokens\ndef long_words(n: int, words: Union[str, List[str]]) -> List[str]:\n    \"\"\"Public API: accepts int n and words (string or list); returns list[str] of tokens with len>n.\"\"\"\n    tokens_to_filter: Iterable[str]\n\n    # Differentiating input types is necessary as per design (string vs. list).\n    # Using isinstance for polymorphic dispatch, assuming \"trust caller's inputs\" implies\n    # valid types and \"do NOT add isinstance checks\" refers to validation for invalid types.\n    if isinstance(words, str):\n        string_input = StringInput(words)\n        tokens_to_filter = Tokenizer.tokenize(string_input.raw_text)\n    else:\n        list_input = ListInput(words)\n        tokens_to_filter = list_input.items\n\n    filtered_list = _filter_words(n, tokens_to_filter)\n    result_list = ResultList(filtered_list)\n    return result_list.to_list()", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/129": [{"task_id": "Mbpp/129", "solution": "from typing import List, Tuple\nfrom src.domain import Matrix, MagicSquareResult", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "Mbpp/129", "solution": "class Matrix:\n    \"\"\"Encapsulates matrix data and provides row/column/diagonal accessors.\"\"\"\n    def __init__(self, data: list[list[int]]) -> None:\n        self.data = data\n        self.n = len(data)\n\n    def get_row(self, i: int) -> list[int]:\n        \"\"\"Returns the row at the given index.\"\"\"\n        return self.data[i]\n\n    def get_col(self, j: int) -> list[int]:\n        \"\"\"Returns the column at the given index.\"\"\"\n        return [self.data[i][j] for i in range(self.n)]\n\n    def get_primary_diagonal(self) -> list[int]:\n        \"\"\"Returns the primary diagonal (top-left to bottom-right).\"\"\"\n        return [self.data[i][i] for i in range(self.n)]\n\n    def get_secondary_diagonal(self) -> list[int]:\n        \"\"\"Returns the secondary diagonal (top-right to bottom-left).\"\"\"\n        return [self.data[i][self.n - 1 - i] for i in range(self.n)]\nclass MagicSquareChecker:\n    \"\"\"\n    Validates matrix shape, computes/verifies sums, and determines magic square status.\n    This class is stateless; operations accept Matrix instances.\n    \"\"\"\n    def __init__(self) -> None:\n        pass\n\n    def is_square(self, m: Matrix) -> bool:\n        \"\"\"Validates if the matrix is non-empty and square (FR1 / BR1, BR2).\"\"\"\n        if not m.data:  # BR1: matrix must not be empty.\n            return False\n        # FR1 / BR2: matrix must be square (number of rows == number of columns).\n        for row in m.data:\n            if len(row) != m.n: \n                return False\n        return True\n\n    def magic_constant(self, m: Matrix) -> int:\n        \"\"\"Determines the magic constant as the sum of the first row (FR2 / BR3).\"\"\"\n        return sum(m.get_row(0))\n\n    def _check_rows_internal(self, m: Matrix, constant: int) -> bool:\n        \"\"\"Internal helper to verify each row sum against a given constant.\"\"\"\n        for i in range(m.n):\n            if sum(m.get_row(i)) != constant:\n                return False\n        return True\n\n    def _check_columns_internal(self, m: Matrix, constant: int) -> bool:\n        \"\"\"Internal helper to verify each column sum against a given constant.\"\"\"\n        for j in range(m.n):\n            if sum(m.get_col(j)) != constant:\n                return False\n        return True\n\n    def _check_diagonals_internal(self, m: Matrix, constant: int) -> bool:\n        \"\"\"Internal helper to verify both main diagonal sums against a given constant.\"\"\"\n        if sum(m.get_primary_diagonal()) != constant:\n            return False\n        if sum(m.get_secondary_diagonal()) != constant:\n            return False\n        return True\n    \n    def check_rows(self, m: Matrix) -> bool:\n        \"\"\"Verifies each row sum equals the magic constant (FR3 / BR4).\"\"\"\n        constant = self.magic_constant(m)\n        return self._check_rows_internal(m, constant)\n\n    def check_columns(self, m: Matrix) -> bool:\n        \"\"\"Verifies each column sum equals the magic constant (FR4 / BR5).\"\"\"\n        constant = self.magic_constant(m)\n        return self._check_columns_internal(m, constant)\n\n    def check_diagonals(self, m: Matrix) -> bool:\n        \"\"\"Verifies both main diagonal sums equal the magic constant (FR5 / BR6).\"\"\"\n        constant = self.magic_constant(m)\n        return self._check_diagonals_internal(m, constant)\n\n    def is_magic(self, m: Matrix) -> bool:\n        \"\"\"Aggregates all checks to determine if the matrix is a magic square (FR6 / BR7).\"\"\"\n        if not self.is_square(m):\n            return False\n        \n        constant = self.magic_constant(m) # FR2: Calculate magic constant once.\n\n        if not self._check_rows_internal(m, constant): return False # FR3\n        if not self._check_columns_internal(m, constant): return False # FR4\n        if not self._check_diagonals_internal(m, constant): return False # FR5\n\n        return True # BR7: Return True iff all checks pass.\nclass Result:\n    \"\"\"Simple container for the boolean outcome of a magic square check.\"\"\"\n    def __init__(self, is_magic: bool) -> None:\n        self.is_magic = is_magic\ndef magic_square_test(matrix: list[list[int]]) -> bool:\n    \"\"\"\n    Public API function to determine whether the provided 2D list of integers\n    is a magic square, as defined in the SRS (NFR1 / BR8).\n    \"\"\"\n    matrix_obj = Matrix(data=matrix)\n    checker = MagicSquareChecker()\n\n    # Data flow: Caller invokes, constructs Matrix.\n    # Data flow: magic_square_test calls MagicSquareChecker.is_square to validate FR1.\n    if not checker.is_square(matrix_obj):\n        return False\n\n    # Data flow: is_magic coordinates constant calculation and all checks (FR2-FR5).\n    is_magic_result = checker.is_magic(matrix_obj)\n\n    # Data flow: Aggregate the boolean results and produce Result (FR6).\n    # Data flow: magic_square_test returns Result.is_magic (boolean) to caller.\n    final_result_obj = Result(is_magic_result)\n    return final_result_obj.is_magic", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/130": [{"task_id": "Mbpp/130", "solution": "from typing import Any, List, Dict\nfrom dataclasses import dataclass", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "Mbpp/130", "solution": "from typing import Any\nclass ListInput:\n    \"\"\"Wraps the provided list input and exposes items.\"\"\"\n    def __init__(self, items: list) -> None:\n        self._items = items\n\n    def get_items(self) -> list:\n        \"\"\"Returns the underlying list.\"\"\"\n        return self._items\nclass FrequencyEntry:\n    \"\"\"Stores an item value and its occurrence count; allows incrementing.\"\"\"\n    def __init__(self, item_value: Any) -> None:\n        self.item_value = item_value\n        self._count = 1\n\n    def increment(self) -> None:\n        \"\"\"Increments the occurrence count.\"\"\"\n        self._count += 1\n\n    def get_count(self) -> int:\n        \"\"\"Returns the current occurrence count.\"\"\"\n        return self._count\nclass FrequencyMap:\n    \"\"\"Maintains a mapping of item_value to FrequencyEntry; provides build and selection operations.\"\"\"\n    def __init__(self) -> None:\n        self._map: dict[Any, FrequencyEntry] = {}\n\n    def add(self, item_value: Any) -> None:\n        \"\"\"Adds or increments an item in the map.\"\"\"\n        if item_value in self._map:\n            self._map[item_value].increment()\n        else:\n            self._map[item_value] = FrequencyEntry(item_value)\n\n    def build_from(self, items: list) -> None:\n        \"\"\"Builds the frequency map from a list of items.\"\"\"\n        for item_value in items:\n            self.add(item_value)\n\n    def entries(self) -> list[FrequencyEntry]:\n        \"\"\"Returns a list of all frequency entries.\"\"\"\n        return list(self._map.values())\n\n    def get_max_item(self) -> Any:\n        \"\"\"Returns an item value with the maximum count, tie-breaking by first encountered.\"\"\"\n        max_entry: FrequencyEntry | None = None\n        max_count = -1\n\n        for entry in self._map.values():\n            if entry.get_count() > max_count:\n                max_count = entry.get_count()\n                max_entry = entry\n        \n        # The design specification for max_occurrences states it raises ValueError for empty lists,\n        # so this method would only be called with a non-empty map.\n        # However, due to critical requirements, specific error checks are omitted here.\n        if max_entry is None:\n            # Fallback for unexpected empty map if critical requirements lead to omission of outer empty list check.\n            return None # Or raise an internal error, but avoiding 'raise' as per critical requirements.\n\n        return max_entry.item_value\n\n    def select_max(self) -> Any:\n        \"\"\"Alias for get_max_item.\"\"\"\n        return self.get_max_item()\nclass Result:\n    \"\"\"Wraps and exposes the selected item value for return to caller.\"\"\"\n    def __init__(self, selected_item: Any) -> None:\n        self._selected_item = selected_item\n\n    def as_value(self) -> Any:\n        \"\"\"Returns the wrapped selected item value.\"\"\"\n        return self._selected_item\ndef max_occurrences(list_input: list) -> Any:\n    \"\"\"\n    Public API: counts item occurrences, selects the max, and returns a single item.\n    Assumes valid, non-empty list input due to critical requirements.\n    \"\"\"\n    list_wrapper = ListInput(list_input)\n    \n    frequency_map = FrequencyMap()\n    frequency_map.build_from(list_wrapper.get_items())\n    \n    selected_item = frequency_map.select_max()\n    \n    result_wrapper = Result(selected_item)\n    return result_wrapper.as_value()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/132": [{"task_id": "Mbpp/132", "solution": "def tup_string(tuple):\n    \"\"\"Accepts a tuple and returns a string formed by concatenating its elements in order.\n