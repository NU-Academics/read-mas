lf.elements)):\n            current_val = self.elements[i].value\n            if not (1 <= current_val <= parameters.m):\n                return False\n            if i > 0:\n                prev_val = self.elements[i-1].value\n                if not (2 * prev_val <= current_val):\n                    return False\n        return True\n\n    def __eq__(self, other):\n        \"\"\"Checks if two sequences are equal by comparing their element values.\"\"\"\n        if not isinstance(other, Sequence):\n            return NotImplemented\n        return [e.value for e in self.elements] == [e.value for e in other.elements]\n\n    def __hash__(self):\n        \"\"\"Enables hashing for sequences, useful for deduplication.\"\"\"\n        return hash(tuple(e.value for e in self.elements))\nclass SequenceGenerator:\n    \"\"\"Generates all valid sequences given parameters.\"\"\"\n    def generateAll(self, parameters: Parameters) -> List[Sequence]:\n        \"\"\"Enumerates sequences of length n, satisfying constraints using backtracking.\"\"\"\n        all_sequences: List[Sequence] = []\n        \n        def backtrack(current_sequence_elements: List[SequenceElement]):\n            current_length = len(current_sequence_elements)\n\n            if current_length == parameters.n:\n                all_sequences.append(Sequence(list(current_sequence_elements)))\n                return\n\n            start_val = 1 if current_length == 0 else (2 * current_sequence_elements[-1].value)\n            \n            for value in range(start_val, parameters.m + 1):\n                # Prune if the current value itself exceeds m.\n                if value > parameters.m:\n                    break\n                \n                current_sequence_elements.append(SequenceElement(value, current_length + 1))\n                backtrack(current_sequence_elements)\n                current_sequence_elements.pop() # Backtrack\n\n        # For n = 1, sequences are simply 1-element sequences from 1 