 "def multiply_num(sequence):\n    \"\"\"Computes the product of all numeric elements in a sequence and divides by its length, returning a float.\"\"\"\n    product = 1.0\n    for num in sequence:\n        product *= num\n    return product / len(sequence)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/102": [{"task_id": "Mbpp/102", "solution": "class InputString:\n    \"\"\"A data holder for the input string.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\nclass Segment:\n    \"\"\"Holds a string segment and provides an operation to capitalize its initial character.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n\n    def capitalize_initial(self) -> str:\n        \"\"\"Capitalizes the first character of the segment, preserving the rest of its case.\"\"\"\n        return _capitalize_initial(self.value)\nclass OutputString:\n    \"\"\"A data holder for the resulting CamelCase string.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\ndef _capitalize_initial(segment: str) -> str:\n    \"\"\"Capitalizes the first character of a segment string.\n    Returns an empty string if the segment is empty; otherwise, uppercases the first character and appends the rest.\"\"\"\n    if not segment:\n        return ''\n    return segment[0].upper() + segment[1:]\ndef snake_to_camel(input: str) -> str:\n    \"\"\"Converts a snake_case string to CamelCase.\n    Splits the input on underscores, capitalizes the first letter of each resulting segment, and concatenates them.\"\"\"\n    input_obj = InputString(value=input)\n    segment_strings = input_obj.value.split('_')\n    segments = [Segment(value=s) for s in segment_strings]\n    capitalized_parts = [seg.capitalize_initial() for seg in segments]\n    output_value = ''.join(capitalized_parts)\n    return OutputString(value=output_value).value", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [],