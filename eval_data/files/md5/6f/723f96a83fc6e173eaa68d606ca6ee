alue: int):\n        self.value = value\n\n    def bit_length(self) -> int:\n        \"\"\"Returns the number of bits required to represent the integer.\"\"\"\n        return self.value.bit_length()\nclass BitMask:\n    \"\"\"Builds an integer mask to target middle bits.\"\"\"\n    def __init__(self):\n        self.mask_value = 0\n\n    def build(self, n: int) -> int:\n        \"\"\"Computes a mask with 1s for middle bits and 0s for MSB and LSB.\"\"\"\n        length = n.bit_length()\n        # Create a mask of all 1s for 'length' bits.\n        all_ones_mask = (1 << length) - 1\n        # Create a mask for the MSB, and for the LSB (1).\n        msb_mask = (1 << (length - 1))\n        # Remove MSB and LSB from the all_ones_mask by XORing them out.\n        self.mask_value = all_ones_mask ^ msb_mask ^ 1\n        return self.mask_value\nclass BitOperation:\n    \"\"\"Applies bitwise XOR to flip middle bits.\"\"\"\n    def __init__(self):\n        pass\n\n    def flipMiddleBits(self, n: int, mask: int) -> int:\n        \"\"\"Performs an XOR operation between the number and the mask to toggle bits.\"\"\"\n        return n ^ mask\nclass Result:\n    \"\"\"A simple holder for the resulting integer value.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\nclass ToggleMiddleBitsFunction:\n    \"\"\"Orchestrates the process of toggling middle bits as per the use case.\"\"\"\n    def toggle(self, n: int) -> int:\n        \"\"\"Executes the core logic to toggle middle bits or return n unchanged.\"\"\"\n        iv = IntegerValue(n)\n        bits = iv.bit_length()\n\n        if bits < 3:  # If bit length is less than 3, return n unchanged.\n            return n\n        else:  # Otherwise, build a mask and apply the bit flip.\n            bit_mask_builder = BitMask()\n            mask = bit_mask_builder.build(n)\n            \n            bit_operator = BitOperation()\n            res_int = bit_operator.flipMiddleBits(n, mask)\n            \n            result_holder = Result(res_int)\n            return result_holder.value\ndef toggle_middle_bits(n: int) -> int:\n    \"\"\"Public API to toggle bits of a number except the most significant and least significant bits.\"\"\"\n    # Input validation (e.g., n being a non-negative integer) is assumed per critical requirements.\n    \n    use_case_executor = ToggleMiddleBitsFunction()\n    return use_case_executor.toggle(n)", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[true]]}, {"task_id": "Mbpp/735", "solution": "class Number:\n    \"\"\"\n    Represent an integer and provide bit-position queries for MSB and LSB.\n    MSB is the highest-index set bit; LSB is defined as bit position 0.\n    \"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\n    def find_msb(self) -> int:\n        \"\"\"\n        Return the index of the most significant set bit.\n        For n=0, bit_length() is 0, so this returns -1.\n        \"\"\"\n        return self.value.bit_length() - 1\n\n    def find_lsb(self) -> int:\n        \"\"\"\n        Return the index of the least significant bit position, which is 0.\n        This aligns with the design's definition of LSB as bit position 0.\n        \"\"\"\n        return 0\nclass BitMask:\n    \"\"\"\n    Creates integer masks for bits strictly between MSB and LSB.\n    This class is primarily a static factory for mask generation.\n    \"\"\"\n    @staticmethod\n    def create_between_mask(msb: int, lsb: int) -> int:\n        \"\"\"\n        Return an integer mask with 1s in positions strictly between msb and lsb, 0s elsewhere.\n        MSB and LSB positions themselves remain 0 in the generated mask.\n        \"\"\"\n        # If there are 0 or 1 bits strictly between MSB and LSB, no bits to toggle.\n        # This occurs when msb <= lsb + 1 (e.g., msb=0, lsb=0 for value 1; msb=1, lsb=0 for value 2 or 3).\n        if msb <= lsb + 1:\n            return 0\n        \n        # Calcu