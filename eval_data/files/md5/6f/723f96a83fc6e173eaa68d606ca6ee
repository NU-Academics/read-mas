Positions is not None else []\nclass TextMatcher:\n    \"\"\"Orchestrates parsing and matching logic to detect middle 'z's.\"\"\"\n    def text_match_wordz_middle(self, input_text: Optional[str]) -> bool:\n        \"\"\"Public method for TextMatcher to check for middle 'z's, returning a boolean.\"\"\"\n        if input_text is None or not input_text:\n            return False\n        \n        text_input = TextInput(input_text)\n        result = self._find_matches(text_input)\n        return result.found\n\n    def _find_matches(self, text_input: TextInput) -> MatchResult:\n        \"\"\"Finds qualifying 'z's and returns a MatchResult.\"\"\"\n        found_any = False\n        words = text_input.parseWords()\n        for word in words:\n            if word.hasMiddleZ():\n                found_any = True\n                break # As per BR7, detection of at least one is required, so stop early.\n        # As per BR7 and design notes, matchCount and matchPositions are optional\n        # for the final boolean result, so we only populate 'found'.\n        return MatchResult(found=found_any)\ndef text_match_wordz_middle(input_text: Optional[str]) -> bool:\n    \"\"\"\n    Checks if the input string contains a lowercase 'z' that is not the first or last character of its word.\n    Returns True if found, False otherwise (including for empty or None input).\n    \"\"\"\n    matcher = TextMatcher()\n    return matcher.text_match_wordz_middle(input_text)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "Mbpp/643", "solution": "class Character:\n    \"\"\"Represents a single character with its absolute position.\"\"\"\n    def __init__(self, symbol: str, position: int):\n        self.symbol = symbol\n        self.position = position\n\n    def isWordChar(self) -> bool:\n        \"\"\"Determines if the character is considered a word character (alphanumeric).\"\"\"\n        return self.symbol.isalnum()\nclass MatchOccurrence:\n    \"\"\"Captures an occurrence of 'z', its context, and whether it's a middle 'z'.\"\"\"\n    def __init__(self, position: int, before_char: Character | None, after_char: Character | None):\n        self.position = position\n        self.before_char = before_char\n        self.after_char = after_char\n        # The is_middle property is derived based on neighbors being word characters.\n        self._is_middle = (\n            self.before_char is not None and self.before_char.isWordChar() and\n            self.after_char is not None and self.after_char.isWordChar()\n        )\n\n    @property\n    def is_middle(self) -> bool:\n        \"\"\"True if the 'z' is in the middle of a word, False otherwise.\"\"\"\n        return self._is_middle\nclass Word:\n    \"\"\"Represents a contiguous token (word) with its value and absolute position.\"\"\"\n    def __init__(self, value: str, start_pos: int, end_pos: int):\n        self.value = value\n        self.start_pos = start_pos\n        self.end_pos = end_pos # exclusive end position\n\n    def chars(self) -> list[Character]:\n        \"\"\"Returns a list of Character objects composing this word.\"\"\"\n        return [Character(s, self.start_pos + i) for i, s in enumerate(self.value)]\n\n    def hasZInMiddle(self) -> bool:\n        \"\"\"Checks if this word contains a 'z' character not at its start or end, with word character neighbors.\"\"\"\n        if len(self.value) < 3:\n            return False\n        \n        for i in range(1, len(self.value) - 1):\n            if self.value[i] == 'z':\n                before_char = Character(self.value[i-1], self.start_pos + i - 1)\n                after_char = Character(self.value[i+1], self.start_pos + i + 1)\n                if before_char.isWordChar() and after_char.isWordChar():\n                    return True\n        return False\nclass Text:\n    \"\"\"Represents the raw input text and provides methods for tokenization.\"\"\"\n    def __init__(self, content: str):\n        self.content = content\n        self.length = len(content)\n\n    def getWords(self) -> list[Word]:\n        \"\"\"Tokenizes the text into a list of Word objects based on alphanumeric characters.\"\"\"\n        words: list[Word] = []\n        current_word_chars: list[str] = []\n        current_word_start_pos = -1\n\n        for i, char_symbol in enumerate(self.content):\n            # Use Character's definition of a word character for consistency.\n            if Character(char_symbol, i).isWordChar():\n                if not current_word_chars:\n                    current_word_start_pos = i\n                current_word_chars.append(char_symbol)\n            else:\n                if current_word_chars:\n                    word_value = \"\".join(current_word_chars)\n                    word_end_pos = current_word_start_pos + len(word_value)\n                    words.append(Word(word_value, current_word_start_pos, word_end_pos))\n                    current_word_chars = []\n                    current_word_start_pos = -1\n        \n        if current_word_chars:\n            word_value = \"\".join(current_word_chars)\n            word_end_pos = current_word_start_pos + len(word_value)\n            words.append(Word(word_value, current_word_start_pos, word_end_pos))\n            \n        return words\nclass TextMatcher:\n    \"\"\"Analyzes text to find specific 'z' occurrences and determine if any are in the middle of a word.\"\"\"\n    def findMatches(self, text: str) -> list[MatchOccurrence]:\n        \"\"\"Identifies all 'z' characters and their surrounding context within words.\"\"\"\n        matches: list[MatchOccurrence] = []\n        text_obj = Text(text)\n        words = text_obj.getWords()\n\n        for word in words:\n            word_chars = word.chars()\n            for i, char in enumerate(word_chars):\n                if char.symbol == 'z':\n                    before_char = None\n                    after_char = None\n\n                    if i > 0:\n                        before_char = word_chars[i-1]\n                    if i < len(word_chars) - 1:\n                        after_char = word_chars[i+1]\n                    \n                    matches.append(MatchOccurrence(char.position, before_char, after_char))\n        return matches\n\n    def text_match_wordz_middle(self, text: str) -> bool:\n        \"\"\"Checks if the text contains any 'z' that is in the middle of a word.\"\"\"\n        occurrences = self.findMatches(text)\n        return any(o.is_middle for o in occurrences)\ndef text_match_wordz_middle(text: str) -> bool:\n    \"\"\"Public API function to check if a string contains 'z' not at the start or end of a word.\"\"\"\n    matcher = TextMatcher()\n    return matcher.text_match_wordz_middle(text)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/644": [{"task_id": "Mbpp/644", "solution": "from src.reverse_array import reverse_Array_Upto_K\nfrom src.domain import Array, TestCase", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "Mbpp/644", "solution": "from src.reverse_array import reverse_Array_Upto_K\ndef reverse_Array_Upto_K(arr, k):\n    \"\"\"Reverses the first k elements of a list, returning a new list.\n    Handles various k values as specified by the design.\n    \"\"\"\n    n = len(arr)\n\n    if k <= 0:\n        # If k is non-positive, return a shallow copy of the original array.\n        return arr.copy()\n    elif k >= n:\n        # If k is greater than or equal to the array length, reverse the entire array.\n        return arr[::-1]\n    else:\n        # Reverse the first k elements and append the rest of the array unchanged.\n        reversed_head = arr[0:k][::-1]\n        tail = arr[k:]\n        return reversed_head + tail", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/720": [{"task_id": "Mbpp/720", "s