to perform in-place sorting\n        arr = list(lst)\n\n        # Main sorting loop: place elements from largest to smallest at their final positions\n        for current_size in range(n, 1, -1):\n            # Find index of the maximum element in the current unsorted prefix arr[0...current_size-1]\n            try:\n                max_index = self._find_max_index(arr, current_size)\n            except TypeError as e:\n                # Catch runtime comparison errors and wrap them in ComparabilityError\n                raise ComparabilityError(f\"Elements are not mutually comparable: {e}\")\n\n            # If the maximum element is not already at the end of the current prefix\n            if max_index != current_size - 1:\n                # 1. Move the maximum element to the front of the current prefix\n                if max_index != 0:\n                    self._flip(arr, max_index + 1)\n\n                # 2. Move the maximum element from the front to its final sorted position\n                self._flip(arr, current_size)\n\n        return arr\n\n    def _find_max_index(self, lst: list, n: int) -> int:\n        \"\"\"Finds the index of the maximum element within the prefix lst[0...n-1].\n        This method relies on Python's default comparison operators.\n        \"\"\"\n        max_val = lst[0]\n        max_idx = 0\n        for i in range(1, n):\n            # Comparison happens here, which might raise TypeError for incomparable types\n            if lst[i] > max_val:\n                max_val = lst[i]\n                max_idx = i\n        return max_idx\n\n    def _flip(self, lst: list, k: int) -> None:\n        \"\"\"Reverses the prefix of the list up to k elements (lst[0...k-1]) in place.\n        This operation is a core building block of the pancake sort algorithm.\n        \"\"\"\n        start = 0\n        end = k - 1\n        while start < end:\n            lst[start], lst[end] = lst[end], lst[start]\n            start += 1\n            end -= 1\ndef