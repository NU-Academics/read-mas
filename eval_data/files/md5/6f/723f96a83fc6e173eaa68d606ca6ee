er = complex(number)\n    real_part = complex_number.real\n    imag_part = complex_number.imag\n\n    # Compute magnitude (r) using the built-in abs function.\n    r = abs(number)\n    # Compute angle (theta) using math.atan2 for correct quadrant handling.\n    theta = math.atan2(imag_part, real_part)\n\n    # Return the polar coordinates as a tuple of two floats.\n    return (float(r), float(theta))", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "Mbpp/252", "solution": "from dataclasses import dataclass\nimport math\ndef sqrt(x: float) -> float:\n    \"\"\"Wrapper for math.sqrt.\"\"\"\n    return math.sqrt(x)\ndef atan2(y: float, x: float) -> float:\n    \"\"\"Wrapper for math.atan2.\"\"\"\n    return math.atan2(y, x)\ndef _compute_magnitude(c: ComplexNumber) -> float:\n    \"\"\"Computes the magnitude (r) of a complex number.\"\"\"\n    return sqrt(c.real**2 + c.imag**2)\ndef _compute_phase(c: ComplexNumber) -> float:\n    \"\"\"Computes the phase (theta) of a complex number.\"\"\"\n    return atan2(c.imag, c.real)\ndef convert(value) -> tuple[float, float]:\n    \"\"\"Converts a complex or real number to polar coordinates (r, theta).\"\"\"\n    if isinstance(value, complex):\n        c_num = ComplexNumber(real=value.real, imag=value.imag)\n    else: # Handles int or float inputs.\n        c_num = ComplexNumber(real=float(value), imag=0.0)\n\n    r = _compute_magnitude(c_num)\n    theta = _compute_phase(c_num)\n\n    return (float(r), float(theta))", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/253": [{"task_id": "Mbpp/253", "solution": "from src.count_integer import count_integer", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "Mbpp/253", "solution": "def count_integer(input_list):\n    \"\"\"Return number of exact-int-typed elements in input_list.\n    This function processes the given list 