\n    It provides methods to check its first character and its length.\n    \"\"\"\n    def __init__(self, value: str):\n        self._value = value\n\n    def startsWithLowercase(self) -> bool:\n        \"\"\"Checks if the name starts with an ASCII lowercase letter (a-z).\n        Empty strings do not start with a lowercase letter.\n        \"\"\"\n        if not self._value:\n            return False\n        first_char = self._value[0]\n        return 'a' <= first_char <= 'z'\n\n    def length(self) -> int:\n        \"\"\"Returns the character length of the name.\n        This counts all characters in the string.\n        \"\"\"\n        return len(self._value)\nclass NameList:\n    \"\"\"Manages a collection of Name objects for filtering and length aggregation.\n    It normalizes a list of strings into internal Name objects upon initialization.\n    \"\"\"\n    def __init__(self, names: list):\n        # Converts a list of string names into a list of Name objects.\n        self._names = [Name(name_str) for name_str in names]\n\n    def filterOutLowercase(self) -> list[Name]:\n        \"\"\"Filters out names that start with a lowercase letter.\n        Returns a new list containing only the names that were not filtered.\n        \"\"\"\n        return [name for name in self._names if not name.startsWithLowercase()]\n\n    def totalLength(self) -> int:\n        \"\"\"Calculates the total length of all Name objects currently in this list.\n        It sums the length property of each contained Name object.\n        \"\"\"\n        return sum(name.length() for name in self._names)\nclass Result:\n    \"\"\"A simple data transfer object to hold the computed sum.\n    It provides a method to retrieve the encapsulated integer value.\n    \"\"\"\n    def __init__(self, sum: int):\n        self._sum = sum\n\n    def getValue(self) -> int:\n        \"\"\"Returns the encapsulated integer sum.\n        This provides direct access to the computed result.\n        \"\"\"\n        return self._sum\nclass SampleNamFunction:\n    \"\"\"Orchestrates the name filtering and length summation process.\n    It serves as the main domain logic entry point for the operation.\n    \"\"\"\n    def execute(self, names: list) -> int:\n        # If the input list is empty, per FR5, return 0.\n        if not names:\n            return 0\n\n        name_list_processor = NameList(names)\n        filtered_names = name_list_processor.filterOutLowercase()\n\n        # If all names are filtered out, per FR5, return 0.\n        if not filtered_names:\n            return 0\n\n        # Calculate the total length of the remaining names directly from the filtered list.\n        total_length = sum(name.length() for name in filtered_names)\n        \n        result_obj = Result(total_length)\n        return result_obj.getValue()\ndef sample_nam(names: list) -> int:\n    \"\"\"Filters names, then sums the lengths of remaining names.\n    This public API function delegates the processing to the domain logic.\n    \"\"\"\n    processor = SampleNamFunction()\n    return processor.execute(names)", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[["AbCdE", "fGH", "IJKLMnOp", "qrs", "TUVW", "xyz"]]]}], "Mbpp/638": [{"task_id": "Mbpp/638", "solution": "import math\nclass WindChillCalculator:\n    \"\"\"Calculates the wind chill index based on velocity and temperature.\"\"\"\n    def calculate(self, velocity_kmh: float, temperature_celsius: float) -> int:\n        \"\"\"Computes raw wind chill and rounds to the nearest integer.\"\"\"\n        raw = self.computeRaw(velocity_kmh, temperature_celsius)\n        rounded = int(round(raw))\n        # The design states WindChillResult can be produced for inspection,\n        # but the calculate method returns an int directly as per interface.\n        return rounded\n\n    def computeRaw(self, v: float, T: float) -> float:\n        \"\"\"Computes the raw wind chill value using the specified formula.\"\"\"\n        # raw = 13.12 + 0.6215*T - 11.37*v^0.16 + 0.3965*T*v^0.16\n        v_pow = math.pow(v, 0.16)\n        raw = 13.12 + 0.6215 * T - 11.37 * v_pow + 0.3965 * T * v_pow\n        return raw\ndef wind_chill(velocity_kmh: float, temperature_celsius: float) -> int:\n    \"\"\"Computes wind chill and returns the rounded integer.\"\"\"\n    calc = WindChillCalculator()\n    return calc.calculate(velocity_kmh, temperature_celsius)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "Mbpp/638", "solution": "from math import ceil\ndef wind_chill(wind_kmh, temp_c):\n    \"\"\"\n    Calculates the wind chill index rounded up to the next integer.\n    Uses an Environment-Canada-like formula.\n    \"\"\"\n    # Convert wind speed from km/h to m/s for the formula\n    V_internal = wind_kmh / 3.6\n\n    # Apply the Environment-Canada-like wind chill formula\n    wind_chill_value = (\n        13.12\n        + 0.6215 * temp_c\n        - 11.37 * (V_internal**0.16)\n        + 0.3965 * temp_c * (V_internal**0.16)\n    )\n\n    # Round the computed wind chill value up to the next integer\n    return ceil(wind_chill_value)", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[40, 20]], "plus_fail_tests": [[0, 0]]}], "Mbpp/641": [{"task_id": "Mbpp/641", "solution": "def is_nonagonal(n):\n    \"\"\"Calculates the nth nonagonal number using the formula n*(7*n - 5)/2.\n    The implementation trusts the input 'n' to be a valid integer as per critical requirements.\"\"\"\n    return (n * (7 * n - 5)) // 2", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "Mbpp/641", "solution": "import sys\nclass OverflowError(Exception):\n    \"\"\"Raised when the computed nonagonal number exceeds HostEnvironment.MAX_INTEGER.\"\"\"\n    pass\nclass HostEnvironment:\n    \"\"\"Provides the host system's maximum integer value for overflow checks.\"\"\"\n    MAX_INTEGER: