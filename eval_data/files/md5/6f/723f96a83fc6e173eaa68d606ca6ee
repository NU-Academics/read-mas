ay, element):\n    \"\"\"Performs a linear search on 'array' for 'element'.\n    Returns (True, index) on first match, otherwise (False, -1).\"\"\"\n    for i in range(len(array)):\n        if array[i] == element:\n            return (True, i)\n    return (False, -1)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/278": [{"task_id": "Mbpp/278", "solution": "def count_first_elements(input_tuple):\n    \"\"\"\n    Iterates immediate elements in index order and returns the index of the first\n    element that is itself a tuple. Returns the length of the tuple if no such\n    element is found.\n    \"\"\"\n    for i, elem in enumerate(input_tuple):\n        if isinstance(elem, tuple):\n            return i\n    return len(input_tuple)", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[[1, 2, 3, 4, 5, 6]]]}, {"task_id": "Mbpp/278", "solution": "def count_first_elements(t: tuple) -> int:\n    \"\"\"\n    Returns the count of elements before the first nested tuple in the input tuple.\n    It returns 0 if the first element is a tuple or if no nested tuple is found.\n    \"\"\"\n    for i, element in enumerate(t):\n        if isinstance(element, tuple):\n            return i\n    return 0", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[[1, 2, 3, 4, 5, 6]]]}], "Mbpp/282": [{"task_id": "Mbpp/282", "solution": "import sys\nimport os\nimport unittest\nfrom typing import List, Union\nfrom src.sub_list import sub_list", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "Mbpp/282", "solution": "from dataclasses import dataclass\nfrom typing import Sequence, List, Union\ndef sub_list(a: Sequence[Union[int, float]], b: Sequence[Union[int, float]]) -> List[Union[int, float]]:\n    \"\"\"\n    Computes element-wise subtraction of two numeric lists.\n    Validates inputs and raises TypeError or ValueError on invalid data.\n    \"\"\"\n    _validate_lists(a, b)\n    result_elements = [a[i] - b[i] for i in range(len(a))]\n    return result_elements", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[[1, 2, 3], [4, 5, 6]]], "plus_fail_tests": [[[1, 2, 3, 4], [5, 6, 7, 8]]]}], "Mbpp/283": [{"task_id": "Mbpp/283", "solution": "from typing import List, Dict\nclass ValidationResult:\n    \"\"\"Captures validation outcome: boolean and optional message.\"\"\"\n    def __init__(self, is_valid: bool, message: str = \"\") -> None:\n        self.is_valid: bool = is_valid\n        self.message: str = message\nclass DigitFrequency:\n    \"\"\"Represents a digit and its count; provides method to increment.\"\"\"\n    def __init__(self, digit: int) -> None:\n        self.digit: int = digit\n        self.count: int = 0\n\n    def increment(self) -> None:\n        \"\"\"Increments the frequency count for the digit.\"\"\"\n        self.count += 1\nclass InputInteger:\n    \"\"\"Represents an input integer and provides digit extraction.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value: int = value\n\n    def to_digits(self) -> List[int]:\n        \"\"\"Converts the absolute value of the integer to a list of its base-10 digits.\"\"\"\n        abs_value = abs(self.value)\n        if abs_value == 0:\n            return [0]\n        return [int(d) for d in str(abs_value)]\nclass Validator:\n    \"\"\"Encapsulates the validation algorithm and delegates to domain objects.\"\"\"\n    def validate(self, n: int) -> bool:\n        \"\"\"Executes the validation flow for integer n.\"\"\"\n        input_int = InputInteger(n)\n        digits = input_int.to_digits()\n\n        frequencies: Dict[int, DigitFrequency] = {}\n        for digit_val in digits:\n            if digit_val not in frequencies:\n                frequencies[digit_val] = DigitFrequency(digit_val)\n            frequencies[digit_val].increment()\n\n        for digit_val, freq_obj in frequencies.items():\n            if freq_obj.count > digit_val:\n                # Produces ValidationResult as per design, but returns its boolean value.\n                _ = ValidationResult(is_valid=False, message=f\"Digit {digit_val} frequency ({freq_obj.count}) exceeds its value.\")\n                return False\n        \n        # Produces ValidationResult as per design, but returns its boolean value.\n        _ = ValidationResult(is_valid=True, message=\"All digit frequencies are valid.\")\n        return True\ndef validate(n: int) -> bool:\n    \"\"\"Public API per FR1: accept single integer and return boolean.\"\"\"\n    return Validator().validate(n)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "Mbpp/283", "solution": "import collections\nimport collections.abc\nclass IntegerInput:\n    \"\"\"Represents the integer input value and provides its normalized decimal-string representation.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\n    def to_decimal_string(self) -> str:\n        \"\"\"Returns the decimal representation of the absolute integer value.\"\"\"\n        return str(abs(self.value))\nclass DigitFrequency:\n    \"\"\"Computes and maintains a mapping of digits to their counts from a decimal string.\"\"\"\n    def __init__(self, decimal_str: str) -> None:\n        self.digitsToCounts: dict[int, int] = collections.defaultdict(int)\n        for char_digit in decimal_str:\n            digit = int(char_digit)\n            self.digitsToCounts[digit] += 1\n\n    def get_count(self, digit: int) -> int:\n        \"\"\"Returns the count for a given digit, or 0 if the digit is not present.\"\"\"\n        return self.digitsToCounts.get(digit, 0)\n\n    def items(self) -> collections.abc.Iterable[tuple[int, int]]:\n        \"\"\"Returns an iterable of (digit, count) pairs.\"\"\"\n        return self.digitsToCounts.items()\nclass ValidationResult:\n    \"\"\"Encapsulates the boolean result of a validation.\"\"\"\n    def __init__(self, is_valid: bool) -> None:\n        self.is_valid = is_valid\nclass ValidateFunction:\n    \"\"\"Orchestrates validation: accepts IntegerInput, computes DigitFrequency, applies business rules, and returns ValidationResult.\"\"\"\n    def validate(self, integer_input: IntegerInput) -> ValidationResult:\n        \"\"\"Validates an IntegerInput based on digit frequency rules.\"\"\"\n        decimal_str = integer_input.to_decimal_string()\n        digit_frequency = DigitFrequency(decimal_str)\n\n        is_valid = True\n        for digit, count in digit_frequency.items():\n            if count > digit:\n                is_valid = False\n                break\n        \n        return ValidationResult(is_valid)\ndef validate(integer: int) -> bool:\n    \"\"\"Public API entry point for validating an integer's digit frequencies.\"\"\"\n    integer_input = IntegerInput(integer)\n    validator = ValidateFunction()\n    result = validator.validate(integer_input)\n    return result.is_valid", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/285": [{"task_id": "Mbpp/285", "solution": "import re\nMATCH_PATTERN: str = r\"ab{2,3}\"\ndef text_match_two_three(input: str) -> bool:\n    \"\"\"\n    Detects occurrences of 'a' followed by exactly two or three 'b' characters.\n    Returns True if any match is found, otherwise False.\n    \"\"\"\n    return bool(re.search(MATCH_PATTERN, input))", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "Mbpp/285", "solution": "import re", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/284": [{"task_id": "Mbpp/284", "solution": "from typing import Any, List as TypingList\nfrom .check_element import check_element", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "Mbpp/284", "solution": "def equality_comparator(a, b) -> bool:\n    \"\"\"Encapsulates a single equality comparison using the language's standard equality operator.\"\"\"\n    return a == b\ndef check_element(list, element) -> bool:\n    \"\"\"Iterates the provided list and returns True if every item equals element, using native equality.\"\"\"\n    for item in list:\n        if not equality_comparator(item, element):\n            return False\n    return True", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/286": [{"task_id": "Mbpp/286", "solution": "from typing import List, Optional\nclass SubarrayMetrics:\n    \"\"\"Stores aggregated metrics (sums, prefix, suffix, max subarray) for an array.\"\"\"\n    def __init__(self, totalSum: int, maxPrefixSum: int, maxSuffixSum: int, maxSubarraySum: int):\n        self.totalSum = totalSum\n        self.maxPrefixSum = maxPrefixSum\n        self.maxSuffixSum = maxSuffixSum\n        self.maxSubarraySum = maxSubarraySum\nclass MaxSubarrayService:\n    \"\"\"Encapsulates logic for input validation and computing the maximum subarray sum.\"\"\"\n\n    def max_sub_array_sum_repeated(self, array: List[int], n: int, k: int) -> int:\n        \"\"\"Service-level entry point to find the maximum subarray sum for k repetitions.\"\"\"\n        self.validateInput(array, n, k)\n        return self.computeRepeatedMax(array, k)\n\n    def validateInput(self, array: List[int], n: int, k: int):\n        \"\"\"Validates input parameters according to design requirements.\"\"\"\n        if n != len(array):\n            raise ValueError(\"n must equal len(array)\")\n        if not isinstance(k, int) or k < 1:\n            raise ValueError(\"k must be an integer >= 1\")\n        if not all(isinstance(x, int) for x in array):\n            raise ValueError(\"array elements must be integers\")\n\n    def computeSingleArrayMetrics(self, array: List[int]) -> SubarrayMetrics:\n        \"\"\"Computes various sums and max subarray sum for a single instance of the array.\"\"\"\n        if not array:\n            # For an empty array, all sums are conventionally 0.\n            return SubarrayMetrics(0, 0, 0, 0) \n\n        total_sum = sum(array)\n\n        # Kadane's algorithm for maxSubarraySum (assumes non-empty subarray, handles all negatives).\n        max_so_far = array[0]\n        current_max = array[0]\n        for num in array[1:]:\n            current_max = max(num, current_max + num)\n            max_so_far = max(max_so_far, current_max)\n        max_subarray_sum = max_so_far\n\n        # Max prefix sum (sum of any non-empty prefix).\n        max_prefix_sum = array[0]\n        current_prefix_sum = array[0]\n        for num in array[1:]:\n            current_prefix_sum += num\n            max_prefix_sum = max(max_prefix_sum, current_prefix_sum)\n        \n        # Max suffix sum (sum of any non-empty suffix).\n        max_suffix_sum = array[-1]\n        current_suffix_sum = array[-1]\n        for num in reversed(array[:-1]): # Iterate from second-to-last to first element.\n            current_suffix_sum += num\n            max_suffix_sum = max(max_suffix_sum, current_suffix_sum)\n\n        return SubarrayMetrics(total_sum, max_prefix_sum, max_suffix_sum, max_subarray_sum)\n\n    def computeRepeatedMax(self, array: List[int], k: int) -> int:\n        \"\"\"Computes the maximum contiguous subarray sum for the array repeated k times.\"\"\"\n        metrics = self.computeSingleArrayMetrics(array)\n\n        # The maximum sum could be entirely within one original array.\n        ans = metrics.maxSubarraySum\n\n        if k == 1:\n            return ans\n\n        # The maximum sum could span two repetitions (suffix of first + prefix of second).\n        ans = max(ans, metrics.maxSuffixSum + metrics.maxPrefixSum)\n\n        # The maximum sum could span multiple repetitions, including full middle arrays.\n        # This is only beneficial if the total sum of the array itself is positive.\n        if k > 2 and metrics.totalSum > 0:\n            ans = max(ans, metrics.maxSuffixSum + (k - 2) * metrics.totalSum + metrics.maxPrefixSum)\n        \n        return ans\ndef max_sub_array_sum_repeated(array: List[int], n: int, k: int) -> int:\n    \"\"\"\n    Finds the largest sum of a contiguous subarray in the modified array,\n    formed by repeating the given array k times.\n    \"\"\"\n    service = MaxSubarrayService()\n    return service.max_sub_array_sum_repeated(array, n, k)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "Mbpp/286", "solution": "from typing import List, Union", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/287": [{"task_id": "Mbpp/287", "solution": "class EvenNumberSequence:\n    \"\"\"Generates a sequence of even natural numbers.\"\"\"\n    def generate(self, n: int) -> list[int]:\n        \"\"\"Generates the first n even natural numbers.\"\"\"\n        return [2 * i for i in range(1, n + 1)]\nclass Result:\n    \"\"\"Wraps an integer result value.\"\"\"\n    def __init__(self, value: int) -> None:\n        \"\"\"Initializes Result with a value.\"\"\"\n        self.value = value\n\n    def get(self) -> int:\n        \"\"\"Returns the wrapped integer value.\"\"\"\n        return self.value\ndef square_Sum(n: int) -> int:\n    \"\"\"\n    Computes the sum of squares of the first n even natural numbers.\n    It calculates (2*1)^2 + (2*2)^2 + ... + (2*n)^2.\n    \"\"\"\n    ens = EvenNumberSequence()\n    even_numbers = ens.generate(n)\n    \n    sum_of_squares = 0\n    for num in even_numbers:\n        sum_of_squares += num * num\n        \n    result_wrapper = Result(sum_of_squares)\n    return result_wrapper.get()", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[1000000]]}, {"task_id": "Mbpp/287", "solution": "def _generate_even_series(n: int) -> list:\n    \"\"\"