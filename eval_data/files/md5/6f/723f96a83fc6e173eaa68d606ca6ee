ult()\n\n    for t in input_obj.tuples:\n        product = calc.computeProduct(t)\n        abs_prod = calc.absValue(product)\n        result.set(abs_prod)\n\n    return result.get()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "Mbpp/120", "solution": "from typing import List, Tuple, Iterator\nfrom dataclasses import dataclass\nclass TupleList:\n    \"\"\"A container for a list of TuplePair objects.\"\"\"\n    _tuples: List[TuplePair]\n\n    def __init__(self, tuples: List[Tuple[float, float]]) -> None:\n        \"\"\"Initializes TupleList from a list of raw (float, float) tuples.\"\"\"\n        self._tuples = [TuplePair(float(a), float(b)) for a, b in tuples]\n\n    def __iter__(self) -> Iterator[TuplePair]:\n        \"\"\"Returns an iterator over the contained TuplePair objects.\"\"\"\n        return iter(self._tuples)\n\n    def __len__(self) -> int:\n        \"\"\"Returns the number of TuplePair objects in the list.\"\"\"\n        return len(self._tuples)\ndef max_product_tuple(input_list: List[Tuple[float, float]]) -> float:\n    \"\"\"\n    Computes the maximum absolute product from a list of 2-element tuples.\n    Example: max_product_tuple([(2, 7), (2, 6), (1, 8), (4, 9)]) == 36.\n    \"\"\"\n    tuple_list_obj = TupleList(input_list)\n    absolute_products = [tp.abs_product() for tp in tuple_list_obj]\n    \n    # max() will raise ValueError for an empty list, adhering to \"simplest, most direct logic\".\n    max_val = max(absolute_products) \n    \n    return ProductResult(max_val).as_number()", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/123": [{"task_id": "Mbpp/123", "solution": "import pytest\nfrom src.amicable_calculator import AmicableCalculator", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "Mbpp/123", "solution": "from .validator import Validator\nfrom .divisor_calculator imp