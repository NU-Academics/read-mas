ates an integer and provides an oddness check.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def is_odd(self) -> bool:\n        \"\"\"Determines if the encapsulated integer is odd.\"\"\"\n        return self.value % 2 != 0\nclass IntegerList:\n    \"\"\"A lightweight wrapper for a list of integers, iterable as Integer objects.\"\"\"\n    def __init__(self, values: List[int]):\n        self.values = values\n\n    def __iter__(self) -> Iterator[Integer]:\n        \"\"\"Yields Integer objects for each value in the list.\"\"\"\n        for value in self.values:\n            yield Integer(value)\nclass ResultList:\n    \"\"\"Accumulates odd integers and provides them as a standard Python list.\"\"\"\n    def __init__(self):\n        self.values: List[int] = []\n\n    def append(self, value: int):\n        \"\"\"Adds an integer to the accumulated list.\"\"\"\n        self.values.append(value)\n\n    def to_list(self) -> List[int]:\n        \"\"\"Returns the accumulated list of integers.\"\"\"\n        return self.values\nclass SplitProcessor:\n    \"\"\"Coordinates filtering an input list to extract only odd integers.\"\"\"\n    def __init__(self, input_list: List[int]):\n        self._input_list = IntegerList(input_list)\n        self._result_list = ResultList()\n\n    def filter_odds(self) -> List[int]:\n        \"\"\"Processes the input list, filtering for odd integers.\"\"\"\n        for integer_wrapper in self._input_list:\n            if integer_wrapper.is_odd():\n                self._result_list.append(integer_wrapper.value)\n        return self._result_list.to_list()\ndef Split(input_list: List[int]) -> List[int]:\n    \"\"\"\n    Returns a list containing only the odd integers from the input list.\n    Preserves original order and handles negative odd integers.\n    \"\"\"\n    processor = SplitProcessor(input_list)\n    return processor.filter_odds()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/555": [{"task_id": "Mbpp/555", "solution": "def difference(n: int) -> int:\n    \"\"\"Entry point required by FR1. Returns sum_of_cubes - sum for first n natural numbers.\"\"\"\n    numbers = _generate_sequence(n)\n    sum_cubes = _sum_of_cubes(numbers)\n    sum_values = _sum(numbers)\n    return sum_cubes - sum_values\ndef _generate_sequence(n: int) -> list[int]:\n    \"\"\"Generates a sequence of natural numbers from 1 to n.\"\"\"\n    return list(range(1, n + 1))\ndef _sum_of_cubes(numbers: list[int]) -> int:\n    \"\"\"Computes the sum of cubes for a list of numbers.\"\"\"\n    return sum(x ** 3 for x in numbers)\ndef _sum(numbers: list[int]) -> int:\n    \"\"\"Computes the sum of a list of numbers.\"\"\"\n    return sum(numbers)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "Mbpp/555", "solution": "def difference(n: int) -> int:\n    \"\"\"\n    Computes the difference between the sum of cubes of the first n natural numbers\n    and the sum of the first n natural numbers using optimized formulas.\n    \"\"\"\n    sum_n = (n * (n + 1)) // 2\n    sum_cubes_n = sum_n * sum_n\n    return sum_cubes_n - sum_n", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/556": [{"task_id": "Mbpp/556", "solution": "from typing import List\nclass Element:\n    \"\"\"Represent a single input element and provide parity check.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\n    def is_odd(self) -> bool:\n        \"\"\"Checks if the element's value is odd.\"\"\"\n        return self.value % 2 != 0\nclass Array:\n    \"\"\"Wrap a Python list of Element and provide length and slice helpers.\"\"\"\n    def __init__(self, elements: List[Element]) -> None:\n        self.elements = elements\n\n    def length(self) -> int:\n        \"\"\"Returns the number of elements in the array.\"\"\"\n        return len(self.elements)\n\n    def slice_first_n(self, n: int) -> List[Element]:\n        \"\"\"Returns a slice containing the first n elements.\"\"\"\n        return self.elements[:n]\nclass Validator:\n    \"\"\"Validate input elements and normalize/clamp n per business rules.\"\"\"\n    def validate_elements(self, arr: list) -> bool:\n        \"\"\"Verifies all items in arr are integers.\"\"\"\n        return all(isinstance(item, int) for item in arr)\n\n    def validate_n(self, arr: list, n: int) -> int:\n        \"\"\"Clamps n to [0, len(arr)] and returns the normalized value.\"\"\"\n        return max(0, min(n, len(arr)))\nclass PairCounter:\n    \"\"\"Implement counting of unordered pairs with odd XOR using parity optimization.\"\"\"\n    def find_Odd_Pair(self, arr: list, n: int) -> int:\n        \"\"\"Orchestrates element conversion and counts odd XOR pairs, returning 0 when n < 2.\"\"\"\n        if n < 2:\n            return 0\n        \n        element_objects = [Element(val) for val in arr]\n        array_wrapper = Array(element_objects)\n        sliced_elements = array_wrapper.slice_first_n(n)\n        \n        return self.count_odd_xor_pairs(sliced_elements)\n\n    def count_odd_xor_pairs(self, elements: list) -> int:\n        \"\"\"Computes o * e where o = number of odd elements, e = number of even elements.\"\"\"\n        odd_count = 0\n        even_count = 0\n        for element in elements:\n            if element.is_odd():\n                odd_count += 1\n            else:\n                even_count += 1\n        return odd_count * even_count\ndef find_Odd_Pair(arr, n) -> int:\n    \"\"\"\n    Counts unordered index pairs (i < j) among the first n elements of arr \n    whose bitwise XOR is odd.\n    \"\"\"\n    validator = Validator()\n    if not validator.validate_elements(arr):\n        raise ValueError(\"arr must contain integers\")\n    n_clamped = validator.validate_n(arr, n)\n    counter = PairCounter()\n    return counter.find_Odd_Pair(arr, n_clamped)", "base_status