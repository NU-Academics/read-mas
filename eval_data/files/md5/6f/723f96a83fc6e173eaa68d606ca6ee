l be True if add() succeeded throughout).\n    # Then verify if applying the mapping to the sequence yields the pattern.\n    if not mapper.isBijective():\n        return False\n\n    return mapper.appliesTo(seq_obj) == pat_obj.elements", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[["red", "red", "red", "red", "red", "red"], ["a", "b", "c", "a", "b", "c"]]]}], "Mbpp/79": [{"task_id": "Mbpp/79", "solution": "def word_len(word: str) -> bool:\n    \"\"\"Return True if the number of characters in word is odd, else False.\"\"\"\n    return (len(word) % 2) == 1", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "Mbpp/79", "solution": "# src/domain.py\n\nclass Word:\n    \"\"\"Represent an input word and compute its length.\"\"\"\n    def __init__(self, text: str):\n        self.text = text\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the word.\"\"\"\n        return len(self.text)\n\nclass TestCase:\n    \"\"\"Encapsulate a unit test case specification and provide a run() helper.\"\"\"\n    def __init__(self, name: str, input: str, expected: bool):\n        self.name = name\n        self.input = input\n        self.expected = expected\n\n    def run(self) -> None:\n        \"\"\"Calls word_len and asserts the expectation.\"\"\"\n        # Import word_len dynamically to avoid circular dependency at module load if WordLengthChecker also imported TestCase\n        from src.word_length import word_len \n        assert word_len(self.input) == self.expected, \\\n            f\"Test '{self.name}' failed: Input '{self.input}', Expected {self.expected}, Got {word_len(self.input)}\"", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/80": [{"task_id": "Mbpp/80", "solution": "def tetrahedral_number(n: int) -> int:\n    \"\"\"\n    Calculates the nth tetrahedral number.\n    Uses the formula T(n) = n*(n+1)*(n+2)