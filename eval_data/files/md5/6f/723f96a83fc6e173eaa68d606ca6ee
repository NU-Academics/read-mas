 \"\"\"Finds the minimal positive integer k to rotate s back to itself.\"\"\"\n        n = len(s)\n        for k_val in range(1, n + 1):\n            if self.rotate(s, k_val) == s:\n                return k_val\n        return n # Return len(s) if no smaller rotation is found, as per design.\nclass Validator:\n    \"\"\"Enforces input preconditions for string rotation functions.\"\"\"\n\n    def validate_type(self, s) -> None:\n        \"\"\"Checks if the input is a string, raising TypeError otherwise.\"\"\"\n        if not isinstance(s, str):\n            raise TypeError(\"Input must be a string.\")\n\n    def validate_non_empty(self, s: str) -> None:\n        \"\"\"Checks if the string is non-empty, raising ValueError otherwise.\"\"\"\n        if len(s) < 1:\n            raise ValueError(\"Input string cannot be empty.\")\ndef find_Rotations(s) -> int:\n    \"\"\"\n    Public entry point to find the minimal positive integer k (1 <= k <= len(s))\n    such that rotating s left by k returns s.\n    \"\"\"\n    validator = Validator()\n    algorithm = RotationAlgorithm()\n\n    validator.validate_type(s)\n    validator.validate_non_empty(s)\n\n    result_k = algorithm.find_Rotations(s)\n\n    # Ensure returned value is int and >= 1, as per design specification.\n    if not isinstance(result_k, int) or result_k < 1:\n        raise AssertionError(\"Internal algorithm returned an invalid rotation count.\")\n\n    return result_k", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/12": [{"task_id": "Mbpp/12", "solution": "from typing import List, Union, Any\nNumber = Union[int, float]\nclass Row:\n    \"\"\"Represents a single row of numeric elements with its original index.\"\"\"\n    def __init__(self, elements: List[Number], index: int):\n        self.elements: List[Number] = list(elements)  # Copy elements for immutability\n        self.index: int = index\n\n    def sum(self) -> float:\n        \"\"\"Computes the arithmetic sum of the row's numeric elements.\"\"\"\n        return float(sum(self.elements))\nclass Matrix:\n    \"\"\"Aggregates Row objects and provides row-oriented operations.\"\"\"\n    def __init__(self, rows: List[Row]):\n        self.rows: List[Row] = list(rows) # Copy rows list itself for domain immutability\n\n    def get_row_sums(self) -> List[float]:\n        \"\"\"Calculates and returns a list of sums for each row.\"\"\"\n        return [row.sum() for row in self.rows]\ndef validate_matrix(matrix_input: Any) -> None:\n    \"\"\"\n    Validates the input matrix for correct structure and numeric elements.\n    Raises TypeError or ValueError for invalid input.\n    \"\"\"\n    if not isinstance(matrix_input, list):\n        raise TypeError(\"Input must be a list (matrix).\")\n\n    if not matrix_input: # An empty matrix is valid.\n        return\n\n    for i, row in enumerate(matrix_input):\n        if not isinstance(row, list):\n            raise TypeError(f\"Matrix row at index {i} must be a list.\")\n        for j, element in enumerate(row):\n            if not isinstance(element, (int, float)):\n                raise ValueError(\n                    f\"Matrix element at row {i}, column {j} must be a numeric type (int or float). \"\n                    f\"Got {type(element).__name__} with value {element}.\"\n                )\ndef calculate_row_sums(matrix_domain: Matrix) -> List[float]:\n    \"\"\"Computes numeric sums for each row in the domain Matrix.\"\"\"\n    return matrix_domain.get_row_sums()\ndef stable_sort_rows(matrix_domain: Matrix, row_sums: List[float]) -> Matrix:\n    \"\"\"\n    Returns a new Matrix with rows sorted stably by their sums.\n    Original indices are used for tie-breaking to ensure stability.\n    \"\"\"\n    # Pair (row_sum, original_index, Row object) for sorting\n    rows_with_sums_and_indices = []\n    for i, row in enumerate(matrix_domain.rows):\n        rows_with_sums_and_indices.append((row_sums[i], row.index, row))\n\n  