  \"\"\"\n    def __init__(self):\n        self.memo: dict[int, int] = {1: 1, 2: 1}\n\n    def a(self, n: int) -> int:\n        \"\"\"\n        Recursively computes the nth Newman-Conway number with memoization.\n        Fetches from memo if available, otherwise computes and stores.\n        \"\"\"\n        if n in self.memo:\n            return self.memo[n]\n\n        # For n > 2, a(n) = a(a(n-1)) + a(n - a(n-1))\n        prev_val = self.a(n - 1)\n        result = self.a(prev_val) + self.a(n - prev_val)\n        self.memo[n] = result\n        return result\nclass SequenceFunction:\n    \"\"\"\n    API fa\u00e7ade for the Newman-Conway sequence, handling input validation.\n    Delegates the actual computation to an instance of NewmanConwaySequence.\n    \"\"\"\n    def sequence(self, n: int) -> int:\n        \"\"\"\n        Validates input n to be a positive integer and returns the nth Newman-Conway number.\n        Raises ValueError for invalid inputs as per design.\n        \"\"\"\n        if not isinstance(n, int) or n < 1:\n            raise ValueError(\"Input 'n' must be a positive integer (n >= 1).\")\n\n        # Create a new computation core instance for each top-level call to ensure per-call memoization.\n        computation_core = NewmanConwaySequence()\n        return computation_core.a(n)\n_sequence_api_facade = SequenceFunction()\ndef sequence(n: int) -> int:\n    \"\"\"\n    The public API function to get the nth Newman-Conway sequence value.\n    This function delegates to the internal SequenceFunction for validation and computation.\n    \"\"\"\n    return _sequence_api_facade.sequence(n)", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[10000]]}, {"task_id": "Mbpp/84", "solution": "from .input_validator import InputValidator\nfrom .sequence_calculator import SequenceCalculator\nfrom .validation_error import ValidationError\nclass SequenceFunction:\n    \"\"\"\n    Orchestrates the computation of Newman\u2013