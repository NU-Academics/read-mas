Mbpp/721", "solution": "from __main__ import Matrix, Cell, Path\nfrom __main__ import Path\nfrom __main__ import Matrix, Path, Result, Validator, PathGenerator, AverageCalculator\nclass Cell:\n    \"\"\"Represents a single matrix cell with coordinates and cost.\"\"\"\n    def __init__(self, row: int, col: int, cost: float):\n        self.row = row\n        self.col = col\n        self.cost = cost\nclass Matrix:\n    \"\"\"Represents a square matrix of numeric costs.\"\"\"\n    def __init__(self, size: int, cells_data: list[list[float]]):\n        self.size = size\n        self.cells = cells_data\n\n    def getCell(self, r: int, c: int) -> Cell:\n        \"\"\"Returns the Cell object at the given row and column.\"\"\"\n        return Cell(r, c, self.cells[r][c])\nclass Path:\n    \"\"\"Represents a path (sequence of cells) and computes its cost, length, and average.\"\"\"\n    def __init__(self, cells: list[Cell]):\n        self.cells = cells\n\n    def totalCost(self) -> float:\n        \"\"\"Calculates the sum of costs of all cells in the path.\"\"\"\n        return sum(cell.cost for cell in self.cells)\n\n    def length(self) -> int:\n        \"\"\"Returns the number of cells in the path.\"\"\"\n        return len(self.cells)\n\n    def average(self) -> float:\n        \"\"\"Computes the average cost per cell for the path.\"\"\"\n        if not self.cells:\n            return 0.0\n        return self.totalCost() / self.length()\nclass Validator:\n    \"\"\"Validates input matrix structure and numeric content.\"\"\"\n    def isNonEmpty(self, matrix: list[list]) -> bool:\n        \"\"\"Checks if the matrix is non-empty.\"\"\"\n        return bool(matrix) and bool(matrix[0])\n\n    def isSquare(self, matrix: list[list]) -> bool:\n        \"\"\"Checks if the matrix is square (N x N).\"\"\"\n        if not matrix:\n            return False\n        n = len(matrix)\n        return all(len(row) == n for row in matrix)\n\n    def allCellsNumeric(self, matrix: list[list]) -> bool:\n        \"\"\"Checks if all cells in the matrix contain numeric values.\"\"\"\n        for row in matrix:\n            for cell in row:\n                if not isinstance(cell, (int, float)):\n                    return False\n        return True\nclass PathGenerator:\n    \"\"\"Generates or computes candidate path(s) obeying movement rules.\"\"\"\n    def __init__(self, matrix: Matrix):\n        self.matrix = matrix\n\n    def _compute_max_sum_dp(self) -> Path:\n        \"\"\"Computes the maximum-sum path using dynamic programming.\"\"\"\n        n = self.matrix.size\n        if n == 0:\n            return Path([])\n        if n == 1:\n            return Path([self.matrix.getCell(0, 0)])\n\n        dp_sum = [[0.0] * n for _ in range(n)]\n        dp_path = [[[] for _ in range(n)] for _ in range(n)]\n\n        # Initialize top-left cell\n        dp_sum[0][0] = self.matrix.getCell(0, 0).cost\n        dp_path[0][0] = [self.matrix.getCell(0, 0)]\n\n        # Initialize first row (only move right)\n        for c in range(1, n):\n            current_cell = self.matrix.getCell(0, c)\n            dp_sum[0][c] = dp_sum[0][c-1] + current_cell.cost\n            dp_path[0][c] = dp_path[0][c-1] + [current_cell]\n\n        # Initialize first column (only move down)\n        for r in range(1, n):\n            current_cell = self.matrix.getCell(r, 0)\n            dp_sum[r][0] = dp_sum[r-1][0] + current_cell.cost\n            dp_path[r][0] = dp_path[r-1][0] + [current_cell]\n\n        # Fill the rest of the DP table\n        for r in range(1, n):\n            for c in range(1, n):\n                current_cell = self.matrix.getCell(r, c)\n                if dp_sum[r-1][c] > dp_sum[r][c-1]:\n                    dp_sum[r][c] = dp_sum[r-1][c] + current_cell.cost\n                    dp_path[r][c] = dp_path[r-1][c] + [current_cell]\n                else:\n                    dp_sum[r][c] = dp_sum[r][c-1] + current_cell.cost\n                    dp_path[r][c] = dp_path[r][c-1] + [current_cell]\n        \n        return Path(dp_path[n-1][n-1])\n\n    def generateAllPaths(self) -> list[Path]:\n        \"\"\"Produces a list containing only the best (max-sum) Path object.\"\"\"\n        return [self._compute_max_sum_dp()]\n\n    def generateGreedyPath(self) -> Path:\n        \"\"\"Generates a path by always choosing the locally optimal (larger) cell cost.\"\"\"\n        path_cells = []\n        r, c = 0, 0\n        n = self.matrix.size\n        if n == 0: return Path([])\n\n        while r < n and c < n:\n            current_cell = self.matrix.getCell(r, c)\n            path_cells.append(current_cell)\n\n            if r == n - 1 and c == n - 1:\n                break\n            elif r == n - 1: # Only can move right\n                c += 1\n            elif c == n - 1: # Only can move down\n                r += 1\n            else: # Can move down or right\n                down_cost = self.matrix.getCell(r + 1, c).cost\n                right_cost = self.matrix.getCell(r, c + 1).cost\n                if down_cost >= right_cost:\n                    r += 1\n                else:\n                    c += 1\n        return Path(path_cells)\nclass AverageCalculator:\n    \"\"\"Computes the average for a given Path.\"\"\"\n    def computeAverage(self, path: Path) -> float:\n        \"\"\"Calculates the average cost of cells in the given path.\"\"\"\n        return path.average()\ndef maxAverageOfPath(matrix: list[list[float]]) -> float:\n    \"\"\"\n    Computes the maximum average path cost in a square matrix.\n    Paths start top-left, move right or down, end bottom-right.\n    \"\"\"\n    validator = Validator()\n    if not validator.isNonEmpty(matrix):\n        raise ValueError(\"Invalid input: Matrix cannot be empty.\")\n    if not validator.isSquare(matrix):\n        raise ValueError(\"Invalid input: Matrix must be square (N x N).\")\n    if not validator.allCellsNumeric(matrix):\n        raise ValueError(\"Invalid input: All matrix cells