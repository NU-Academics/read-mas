.\n    Raises TypeError if any element is not an int, ValueError for empty input or no non-zeroes.\n    \"\"\"\n    zeroes = 0\n    non_zeroes = 0\n    total_elements = 0\n\n    # Iterate through the input for validation and counting (O(1) extra space).\n    for element in arr:\n        total_elements += 1\n        if not isinstance(element, int):\n            raise TypeError(\"input must contain only integers\")\n        if element == 0:\n            zeroes += 1\n        else:\n            non_zeroes += 1\n\n    # Apply business rules for edge cases.\n    if total_elements == 0:\n        raise ValueError(\"input is empty\")\n    if non_zeroes == 0:\n        raise ValueError(\"no non-zero elements; ratio undefined\")\n\n    # Compute and return the ratio as a float.\n    ratio = float(zeroes) / non_zeroes\n    return ratio", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "Mbpp/137", "solution": "from typing import Sequence\ndef zero_count(integer_array: Sequence[int]) -> float:\n    \"\"\"Compute and return (zero_count / non_zero_count) as a Python float.\n\n    Returns:\n        float: zeros / non-zeros as Python float. If non_zero_count == 0 and zero_count > 0 -> float('inf').\n               If non_zero_count == 0 and zero_count == 0 (empty input) -> float('nan').\n    \"\"\"\n    num_zeros = 0\n    num_non_zeros = 0\n\n    for element in integer_array:\n        if element == 0:\n            num_zeros += 1\n        else:\n            num_non_zeros += 1\n\n    if num_non_zeros == 0:\n        if num_zeros > 0:\n            return float('inf')\n        else: # num_zeros == 0, implying an empty input\n            return float('nan')\n    else:\n        return float(num_zeros / num_non_zeros)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/139": [{"task_id": "Mbpp/139", "solution": "def circle_circumference(radius):\n    \"\"\"Computes the circumference of a