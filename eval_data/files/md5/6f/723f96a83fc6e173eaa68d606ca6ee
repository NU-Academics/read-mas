 the encapsulated list.\"\"\"\n        return len(self.elements)\nclass Validation:\n    \"\"\"Validates input structure and element types, enforcing BR6.\"\"\"\n    def is_list(self, input_value) -> bool:\n        \"\"\"Checks if the input_value is a list.\"\"\"\n        return isinstance(input_value, list)\n\n    def elements_are_numbers(self, input_value) -> bool:\n        \"\"\"Checks if all elements in the input_value are numeric.\"\"\"\n        for element in input_value:\n            if not isinstance(element, numbers.Number):\n                return False\n        return True\nclass Result:\n    \"\"\"Encapsulates boolean result and optional reasoning string.\"\"\"\n    def __init__(self, value: bool, reasoning: str = \"\"):\n        self.value = value\n        self.reasoning = reasoning\nclass MonotonicChecker:\n    \"\"\"Evaluates whether an InputList is monotonic using a single-pass algorithm.\"\"\"\n    def check_non_increasing(self, items: InputList) -> bool:\n        \"\"\"Checks if the InputList is entirely non-increasing.\"\"\"\n        if items.length() <= 1:\n            return True\n        for i in range(items.length() - 1):\n            if items.elements[i] < items.elements[i+1]:\n                return False\n        return True\n\n    def check_non_decreasing(self, items: InputList) -> bool:\n        \"\"\"Checks if the InputList is entirely non-decreasing.\"\"\"\n        if items.length() <= 1:\n            return True\n        for i in range(items.length() - 1):\n            if items.elements[i] > items.elements[i+1]:\n                return False\n        return True\n\n    def is_Monotonic(self, input_list: InputList) -> bool:\n        \"\"\"Coordinates non-increasing and non-decreasing checks to determine monotonicity.\"\"\"\n        if input_list.length() <= 1:\n            return Result(value=True, reasoning=\"Empty or single-element list is monotonic.\").value\n\n        is_non_increasing = self.check_non_increasing(input_list)\n        if is_non_increasing:\n            result_obj = Result(value=True, reasoning=\"List is non-increasing.\")\n        else:\n            is_non_decreasing = self.check_non_decreasing(input_list)\n            if is_non_decreasing:\n                result_obj = Result(value=True, reasoning=\"List is non-decreasing.\")\n            else:\n                result_obj = Result(value=False, reasoning=\"List is neither non-increasing nor non-decreasing.\")\n        return result_obj.value\ndef is_Monotonic(items: List[numbers.Number]) -> bool:\n    \"\"\"\n    Determines if a given list of numeric values is monotonic.\n    Validates input and delegates to MonotonicChecker for evaluation.\n    \"\"\"\n    validator = Validation()\n    if not validator.is_list(items):\n        raise TypeError(\"Input 'items' must be a list/sequence.\")\n    if not validator.elements_are_numbers(items):\n        raise TypeError(\"All elements in 'items' must be numeric.\")\n\n    input_list = InputList(items)\n    checker = MonotonicChecker()\n    return checker.is_Monotonic(input_list)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "Mbpp/68", "solution": "def _is_non_increasing(array):\n    \"\"\"Checks if the array is non-increasing.\n    Allows equal adjacent elements.\"\"\"\n    for i in range(1, len(array)):\n        if array[i] > array[i-1]:\n            return False\n    return True\ndef _is_non_decreasing(array):\n    \"\"\"Checks if the array is non-decreasing.\n    Allows equal adjacent elements.\"\"\"\n    for i in range(1, len(array)):\n        if array[i] < array[i-1]:\n            return False\n    return True\ndef is_Monotonic(array):\n    \"\"\"Return True if 'array' is monotonic (non-increasing OR non-decreasing), else False.\n    Input: array (list of numbers).\"\"\"\n    return _is_non_increasing(array) or _is_non_decreasing(array)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_test