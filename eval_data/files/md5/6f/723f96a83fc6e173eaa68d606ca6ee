p/131", "solution": "from typing import List, Set, Tuple\ndef reverse_vowels(s: str) -> str:\n    \"\"\"Reverses only the vowels in a string, preserving case and non-vowel positions.\"\"\"\n\n    # Vowel definition, moved inline as per \"inline\" requirement.\n    VOWELS: Set[str] = {'a','e','i','o','u','A','E','I','O','U'}\n\n    def is_vowel(c: str) -> bool:\n        \"\"\"Checks if a character is a vowel.\"\"\"\n        return c in VOWELS\n\n    def _collect_vowels(input_str: str) -> Tuple[List[int], List[str]]:\n        \"\"\"Collects vowels and their original indices from the input string.\"\"\"\n        indices: List[int] = []\n        vowels: List[str] = []\n        for i, char in enumerate(input_str):\n            if is_vowel(char):\n                indices.append(i)\n                vowels.append(char)\n        return indices, vowels\n\n    def _reinsert_vowels(original_str_list: List[str], vowel_indices: List[int], reversed_vowels: List[str]) -> str:\n        \"\"\"Reinserts reversed vowels into their original positions.\"\"\"\n        result_list = original_str_list[:] # Create a mutable copy of the character list.\n\n        for i, original_idx in enumerate(vowel_indices):\n            result_list[original_idx] = reversed_vowels[i]\n        return \"\".join(result_list)\n\n    # Main logic of reverse_vowels\n    # FR7: Empty input string returns empty output.\n    if not s:\n        return \"\"\n\n    vowel_indices, collected_vowels = _collect_vowels(s)\n\n    # FR6: If the input contains zero or one vowel, return input unchanged.\n    if len(collected_vowels) <= 1:\n        return s\n\n    # Reverse the collected vowels (FR2).\n    collected_vowels.reverse()\n\n    # Convert string to list of characters for modification by _reinsert_vowels.\n    s_char_list: List[str] = list(s)\n    \n    return _reinsert_vowels(s_char_list, vowel_indices, collected_vowels)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "