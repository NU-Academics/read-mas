{"task_id": "Mbpp/445", "solution": "from typing import Tuple, Any, TypeAlias\n\nOuterTuple: TypeAlias = Tuple[Tuple[Any, ...], ...]\nInnerTuple: TypeAlias = Tuple[Any, ...]\n\ndef index_multiplication(tuple1, tuple2) -> tuple:\n    \"\"\"\n    Compute index-wise multiplication of inner tuple elements from tuple1 and tuple2.\n    Raises ValueError on outer or inner length mismatches.\n    \"\"\"\n    if len(tuple1) != len(tuple2):\n        raise ValueError(\"outer length mismatch\")\n\n    result_outer_tuple = []\n    for i in range(len(tuple1)):\n        inner_tuple1 = tuple1[i]\n        inner_tuple2 = tuple2[i]\n\n        if len(inner_tuple1) != len(inner_tuple2):\n            raise ValueError(f\"inner length mismatch at index {i}\")\n\n        result_inner_tuple = []\n        for j in range(len(inner_tuple1)):\n            product = inner_tuple1[j] * inner_tuple2[j]\n            result_inner_tuple.append(product)\n        result_outer_tuple.append(tuple(result_inner_tuple))\n\n    return tuple(result_outer_tuple)"}
{"task_id": "Mbpp/439", "solution": "from typing import Iterator\n\nclass IntegerList:\n    \"\"\"\n    Encapsulates a list of integers for validation and iteration.\n    \"\"\"\n    def __init__(self, values: list[int]) -> None:\n        self.values = values\n\n    def validate(self) -> None:\n        \"\"\"\n        Per constraints, validation checks are omitted here.\n        \"\"\"\n        pass\n\n    def __iter__(self) -> Iterator[\"IntegerElement\"]:\n        \"\"\"\n        Yields IntegerElement instances for each value in the list.\n        \"\"\"\n        for value in self.values:\n            yield IntegerElement(value)\n\nclass IntegerElement:\n    \"\"\"\n    Represents a single integer and provides its decimal string representation.\n    \"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\n    def to_decimal_string(self) -> str:\n        \"\"\"\n        Converts the integer value to its base-10 decimal string.\n        \"\"\"\n        return str(self.value)\n\nclass SingleIntegerResult:\n    \"\"\"\n    Holds the final concatenated integer result.\n    \"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\nclass MultipleToSingleConverter:\n    \"\"\"\n    Orchestrates the conversion of a list of integers into a single integer.\n    \"\"\"\n    def multiple_to_single(self, values: list[int]) -> int:\n        \"\"\"\n        Coordinates the validation, string conversion, concatenation, and final integer conversion.\n        \"\"\"\n        integer_list = IntegerList(values)\n        integer_list.validate() \n\n        decimal_strings = []\n        for element in integer_list:\n            decimal_strings.append(element.to_decimal_string())\n        \n        concatenated_string = \"\".join(decimal_strings)\n        \n        final_int_value = int(concatenated_string)\n        \n        result_obj = SingleIntegerResult(final_int_value)\n        return result_obj.value\n\ndef multiple_to_single(values: list[int]) -> int:\n    \"\"\"\n    Joins a list of multiple integers into a single integer.\n    \"\"\"\n    converter = MultipleToSingleConverter()\n    return converter.multiple_to_single(values)"}
{"task_id": "Mbpp/440", "solution": "import re\n\nclass Sentence:\n    def __init__(self, text: str):\n        self.text = text\n\n    def length(self) -> int:\n        return len(self.text)\n\n    def charAt(self, i: int) -> str:\n        if 0 <= i < len(self.text):\n            return self.text[i]\n        return \"\"\n\nclass Token:\n    def __init__(self, text: str, startIndex: int, endIndex: int):\n        self.text = text\n        self.startIndex = startIndex\n        self.endIndex = endIndex\n\n    def normalized(self) -> str:\n        # Removes leading/trailing non-alphanumeric characters based on str.isalnum().\n        normalized_str = self.text\n        \n        start_strip = 0\n        while start_strip < len(normalized_str) and not normalized_str[start_strip].isalnum():\n            start_strip += 1\n        \n        end_strip = len(normalized_str)\n        while end_strip > start_strip and not normalized_str[end_strip - 1].isalnum():\n            end_strip -= 1\n            \n        return normalized_str[start_strip:end_strip]\n\nclass Adverb:\n    def __init__(self, text: str, startIndex: int, endIndex: int):\n        self.text = text\n        self.startIndex = startIndex\n        self.endIndex = endIndex\n\nclass Result:\n    def __init__(self, startIndex: int, endIndex: int, adverbText: str):\n        self.startIndex = startIndex\n        self.endIndex = endIndex\n        self.adverbText = adverbText\n\nclass Tokenizer:\n    def tokenize(self, sentence: Sentence) -> list[Token]:\n        tokens = []\n        # Uses regex to find sequences of non-whitespace characters, preserving original indices.\n        for match in re.finditer(r'\\S+', sentence.text):\n            token_text = match.group(0)\n            start_index = match.start()\n            end_index = match.end()\n            tokens.append(Token(token_text, start_index, end_index))\n        return tokens\n\nclass POSTagger:\n    # A small, deterministic lexical adverb list for identifying adverbs.\n    _ADVERBS = {\"clearly\", \"quickly\", \"slowly\", \"very\", \"always\", \"never\", \"often\", \"truly\", \"happily\", \"sadly\", \"really\"}\n\n    def tag(self, tokens: list[Token]) -> list[tuple[Token, str]]:\n        tagged_tokens = []\n        for token in tokens:\n            normalized_text = token.normalized().lower()\n            if normalized_text in self._ADVERBS:\n                tagged_tokens.append((token, \"ADVB\"))\n            else:\n                tagged_tokens.append((token, \"OTHER\"))\n        return tagged_tokens\n\n    def isAdverb(self, tag: str) -> bool:\n        return tag == \"ADVB\"\n\nclass AdverbFinder:\n    def findFirstAdverb(self, tokensWithTags: list[tuple[Token, str]]) -> Adverb | None:\n        \"\"\"\n        Iterates through tagged tokens to find the first adverb based on POSTagger.isAdverb().\n        Returns an Adverb object with normalized text and calculated indices, or None if no adverb is found.\n        \"\"\"\n        postagger = POSTagger()\n        for token, tag in tokensWithTags:\n            if postagger.isAdverb(tag):\n                normalized_text = token.normalized()\n                start_index = token.startIndex\n                # endIndex is exclusive and calculated based on the length of the normalized text.\n                end_index = start_index + len(normalized_text)\n                return Adverb(text=normalized_text, startIndex=start_index, endIndex=end_index)\n        return None\n\ndef find_adverb_position(sentence: str) -> tuple[int, int, str]:\n    \"\"\"\n    Finds the first adverb and its positions in a given sentence, orchestrating tokenization and POS tagging.\n    Returns a tuple (start_index, end_index, adverb_text).\n    \"\"\"\n    s = Sentence(text=sentence)\n    tokens = Tokenizer().tokenize(s)\n    tagged = POSTagger().tag(tokens)\n    adverb = AdverbFinder().findFirstAdverb(tagged)\n    \n    # As per design, behavior when no adverb is found is unspecified.\n    # The current implementation will raise an AttributeError if 'adverb' is None.\n    return (adverb.startIndex, adverb.endIndex, adverb.text)"}
{"task_id": "Mbpp/446", "solution": "def count_Occurrence(input_tuple, input_list) -> int:\n    \"\"\"\n    Counts the total occurrences of elements from input_list within input_tuple.\n    Each matching element in input_tuple is counted separately.\n    \"\"\"\n    count = 0\n    for item_in_tuple in input_tuple:\n        if item_in_tuple in input_list:\n            count += 1\n    return count"}
{"task_id": "Mbpp/447", "solution": "def cube_nums(inputList):\n    \"\"\"\n    Computes the cube of each element in a list of numbers.\n    Returns a new list with the cubed values, preserving order.\n    \"\"\"\n    if not isinstance(inputList, list):\n        raise TypeError(\"Input must be a list.\")\n\n    cubed_numbers = []\n    for num in inputList:\n        if not isinstance(num, (int, float)):\n            raise TypeError(\"All elements in the list must be numeric (int or float).\")\n        cubed_numbers.append(num ** 3)\n    return cubed_numbers"}
