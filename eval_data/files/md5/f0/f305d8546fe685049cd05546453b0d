{"task_id": "Mbpp/430", "solution": "class Vertex:\n    \"\"\"Represents a vertex of a parabola.\"\"\"\n    def __init__(self, x: float, y: float):\n        self.x = x\n        self.y = y\n\nclass Parabola:\n    \"\"\"Represents a parabola defined by y = a x^2 + b x + c.\"\"\"\n    def __init__(self, a: float, b: float, c: float):\n        self.a = a\n        self.b = b\n        self.c = c\n\n    def computeVertex(self) -> Vertex:\n        \"\"\"Computes the vertex (x, y) coordinates of the parabola.\"\"\"\n        x_v = -self.b / (2 * self.a)\n        y_v = self.a * x_v**2 + self.b * x_v + self.c\n        return Vertex(x_v, y_v)\n\nclass DirectrixCalculator:\n    \"\"\"Calculates the directrix of a parabola.\"\"\"\n    def __init__(self):\n        pass\n\n    def compute(self, p: Parabola) -> float:\n        \"\"\"Computes the directrix value for a given parabola.\"\"\"\n        V = p.computeVertex()\n        focal_length = 1.0 / (4.0 * p.a)\n        directrix_value = V.y - focal_length\n        return directrix_value\n\ndef parabola_directrix(a, b, c):\n    \"\"\"\n    Calculates the directrix of a parabola given its coefficients a, b, and c\n    in the form y = a x^2 + b x + c.\n    \"\"\"\n    parabola = Parabola(float(a), float(b), float(c))\n    calculator = DirectrixCalculator()\n    result_value = calculator.compute(parabola)\n    \n    return result_value"}
{"task_id": "Mbpp/432", "solution": "from dataclasses import dataclass\nfrom typing import Optional\n\n@dataclass\nclass ValidationResult:\n    \"\"\"Internal data holder for validation outcomes.\"\"\"\n    is_valid: bool\n    error_message: Optional[str]\n\ndef _is_numeric(x) -> bool:\n    \"\"\"Checks if a value is an integer or a float.\"\"\"\n    return isinstance(x, (int, float))\n\ndef _to_float(x) -> float:\n    \"\"\"Converts a numeric value to a float.\"\"\"\n    return float(x)\n\ndef _validate_params(a, b, c):\n    \"\"\"Validates that all parameters are numeric and bases are non-negative.\"\"\"\n    if not _is_numeric(a) or not _is_numeric(b) or not _is_numeric(c):\n        raise ValueError(\"All parameters (a, b, c) must be numeric (int or float).\")\n    if a < 0 or b < 0:\n        raise ValueError(\"The parallel sides (a and b) cannot be negative.\")\n\ndef _compute_median(base1, base2) -> float:\n    \"\"\"Computes the arithmetic mean of two bases.\"\"\"\n    return (base1 + base2) / 2.0\n\ndef median_trapezium(a, b, c):\n    \"\"\"\n    Calculates the median length of a trapezium given its parallel sides a, b,\n    and an ignored third parameter c.\n    \"\"\"\n    _validate_params(a, b, c)\n    float_a = _to_float(a)\n    float_b = _to_float(b)\n    return _compute_median(float_a, float_b)"}
