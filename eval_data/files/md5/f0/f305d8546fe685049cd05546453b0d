{"task_id": "Mbpp/145", "solution": "from typing import Iterable\nfrom numbers import Number\n\ndef max_Abs_Diff(iterable: Iterable[Number]) -> Number:\n    \"\"\"Compute and return the maximum absolute difference between any two numeric elements in iterable.\n    Raises ValueError if iterable is empty.\n    \"\"\"\n    it = iter(iterable)\n    try:\n        first = next(it)\n    except StopIteration:\n        raise ValueError('max_Abs_Diff requires a non-empty iterable')\n\n    min_v = max_v = first\n    for x in it:\n        if x < min_v:\n            min_v = x\n        if x > max_v:\n            max_v = x\n\n    return max_v - min_v"}
{"task_id": "Mbpp/160", "solution": "from typing import Optional, Tuple\n\ndef _extended_gcd(a: int, b: int) -> Tuple[int, int, int]:\n    \"\"\"Returns (g, x, y) such that g = gcd(a, b) and a*x + b*y == g.\n    Handles a or b being zero, but not both zero simultaneously.\n    \"\"\"\n    if b == 0:\n        return (a, 1, 0)\n    else:\n        g, x1, y1 = _extended_gcd(b, a % b)\n        x = y1\n        y = x1 - (a // b) * y1\n        return (g, x, y)\n\ndef find_solution(a: int, b: int, n: int) -> Optional[Tuple[int, int]]:\n    \"\"\"Returns (x, y) such that a*x + b*y == n, or None if no integer solution exists.\n    Uses the extended Euclidean algorithm to find a particular solution and normalizes it.\n    \"\"\"\n    g, x0, y0 = _extended_gcd(a, b)\n\n    if n % g != 0:\n        return None\n    \n    # Calculate initial particular solution\n    factor = n // g\n    x_particular = x0 * factor\n    y_particular = y0 * factor\n\n    # Adjust the solution for general cases where a and b are non-zero\n    # to find a 'canonical' solution, typically with x in a certain range.\n    if a != 0 and b != 0:\n        b_div_g = b // g\n        a_div_g = a // g\n\n        # Ensure x_final is in the range [0, abs(b_div_g)-1]\n        x_final = x_particular % abs(b_div_g)\n\n        # Calculate the shift factor k based on the difference from x_particular to x_final\n        k = (x_final - x_particular) // b_div_g\n        \n        # Apply the same shift to y_particular to find y_final\n        y_final = y_particular - k * a_div_g\n        \n        return (x_final, y_final)\n    else:\n        # If a or b is zero, the initial (x_particular, y_particular) is already specific.\n        # This covers cases like (0,3,6) -> (0,2) or (2,0,4) -> (2,0).\n        return (x_particular, y_particular)"}
{"task_id": "Mbpp/161", "solution": "def remove_elements(source, to_remove) -> list:\n    \"\"\"Return a list containing only elements from source that are not equal to any element in to_remove.\n\n    Parameters:\n      source (list): input source list (ordered sequence)\n      to_remove (list): list of elements to remove by equality\n\n    Returns:\n      list: filtered list preserving original relative order\n    \"\"\"\n    elements_to_remove = set(to_remove)\n    result = []\n    for item in source:\n        if item not in elements_to_remove:\n            result.append(item)\n    return result"}
{"task_id": "Mbpp/162", "solution": "from typing import List\n\nclass Term:\n    def __init__(self, index: int, value: int):\n        self.index = index\n        self.value = value\n\nclass Series:\n    def __init__(self):\n        self.terms: List[Term] = []\n\n    def generate_terms(self, n: int) -> None:\n        \"\"\"Generates terms for the series based on n, adding only positive values.\"\"\"\n        i = 0\n        while True:\n            value = n - 2 * i\n            if value <= 0:\n                break\n            self.terms.append(Term(i, value))\n            i += 1\n\n    def sum(self) -> int:\n        \"\"\"Calculates the sum of all positive terms in the series.\"\"\"\n        return sum(t.value for t in self.terms if t.value > 0)\n\nclass SumSeries:\n    def __init__(self, n: int):\n        self.n = n\n        self._series = Series()\n\n    def compute(self) -> int:\n        \"\"\"Orchestrates term generation and summation for the series.\"\"\"\n        self._series.generate_terms(self.n)\n        return self._series.sum()\n\ndef sum_series(n: int) -> int:\n    \"\"\"Return integer sum of positive terms n - 2*i for i=0.. until term <= 0.\"\"\"\n    s = SumSeries(n)\n    return s.compute()"}
{"task_id": "Mbpp/166", "solution": "def find_even_pair(nums: list[int]) -> int:\n    \"\"\"\n    Counts the number of pairs of integers in a list that XOR to an even number.\n    This is equivalent to counting pairs with the same parity.\n    \"\"\"\n    def _is_even(value: int) -> bool:\n        \"\"\"Determines if an integer is even.\"\"\"\n        return value % 2 == 0\n\n    def _comb2(n: int) -> int:\n        \"\"\"Calculates 'n choose 2' combinations.\"\"\"\n        if n < 2:\n            return 0\n        return n * (n - 1) // 2\n\n    def _count_same_parity_pairs(nums: list[int]) -> int:\n        \"\"\"Counts elements by parity and applies the combination formula.\"\"\"\n        even_count = 0\n        odd_count = 0\n        for num in nums:\n            if _is_even(num):\n                even_count += 1\n            else:\n                odd_count += 1\n\n        even_pairs = _comb2(even_count)\n        odd_pairs = _comb2(odd_count)\n        return even_pairs + odd_pairs\n\n    if len(nums) < 2:\n        return 0\n    \n    return _count_same_parity_pairs(nums)"}
{"task_id": "Mbpp/165", "solution": "def count_char_position(input: str) -> int:\n    \"\"\"\n    Counts characters whose 1-based index in the string matches their 1-based alphabetical position (A=1, B=2, ...).\n    Comparison is case-insensitive, and non-alphabetic characters are ignored.\n    \"\"\"\n    count = 0\n    for i, char in enumerate(input):\n        # 1-based index for string position\n        string_position = i + 1\n        \n        # Normalize character to uppercase for alphabetical position calculation\n        upper_char = char.upper()\n        \n        # Check if the character is an English alphabet letter\n        if 'A' <= upper_char <= 'Z':\n            # Calculate 1-based alphabetical position\n            alpha_position = ord(upper_char) - ord('A') + 1\n            \n            # Compare string position with alphabetical position\n            if string_position == alpha_position:\n                count += 1\n                \n    return count"}
{"task_id": "Mbpp/168", "solution": "class FrequencyFunction:\n    \"\"\"Encapsulates the logic for counting occurrences of a value in a list.\"\"\"\n\n    def __init__(self, list_init, value_init):\n        \"\"\"Initializes with the list and value for potential internal use, especially validation.\"\"\"\n        self._list = list_init\n        self._value = value_init\n\n    def validateInputs(self):\n        \"\"\"Performs defensive validation for the internally stored list.\"\"\"\n        # Per design, validation is defensive and returns True/False.\n        # No specific validation beyond \"list-like\" is detailed, and no exceptions are allowed.\n        # Assuming the input `list` is iterable.\n        return True\n\n    def frequency(self, list, value):\n        \"\"\"Counts the occurrences of `value` in `list` using host-language equality.\"\"\"\n        count = 0\n        for item in list:\n            if item == value:\n                count += 1\n        return count\n\n\ndef frequency(list, value):\n    \"\"\"\n    Counts the number of occurrences of a number in a given list.\n\n    Delegates the counting logic to a FrequencyFunction instance.\n    \"\"\"\n    freq_counter = FrequencyFunction(list, value)\n    freq_counter.validateInputs()  # Calls validation as per design, no action on return value.\n    return freq_counter.frequency(list, value)"}
{"task_id": "Mbpp/167", "solution": "def _validate_input(n):\n    \"\"\"Raise ValueError if n is not int or n < 0.\"\"\"\n    if not isinstance(n, int) or n < 0:\n        raise ValueError(\"Input n must be a non-negative integer.\")\n\ndef _is_power_of_two(n):\n    \"\"\"Detect if n is a power of two (for n >= 1).\"\"\"\n    # A number is a power of two if it's positive and has only one bit set.\n    return n > 0 and (n & (n - 1) == 0)\n\ndef _compute_next_power_of_two(n):\n    \"\"\"Compute and return (value, exponent) where value == 2**exponent >= n and exponent is minimal.\"\"\"\n    # For n >= 1, (n - 1).bit_length() finds the minimum exponent k such that 2**k >= n.\n    exponent = (n - 1).bit_length()\n    value = 1 << exponent\n    return value, exponent\n\ndef next_power_of_2(n):\n    \"\"\"\n    Find the smallest power of 2 greater than or equal to n.\n    assert next_power_of_2(0) == 1\n    \"\"\"\n    _validate_input(n)\n\n    if n == 0:\n        return 1\n\n    if _is_power_of_two(n):\n        return n\n\n    value, _ = _compute_next_power_of_two(n)\n    return value"}
{"task_id": "Mbpp/170", "solution": "def sum_range_list(values: list, start_index: int, end_index: int) -> float | int:\n    \"\"\"\n    Calculates the sum of numbers in a list within a specified inclusive index range,\n    performing validation and raising errors for invalid inputs.\n    \"\"\"\n    if not isinstance(start_index, int) or not isinstance(end_index, int):\n        raise TypeError(\"Indices must be integers.\")\n\n    list_len = len(values)\n\n    if list_len == 0:\n        # BR9: Empty list implies any non-negative index is out of bounds\n        if start_index >= 0 or end_index >= 0:\n            raise ValueError(\"Index out of bounds for an empty list.\")\n\n    # BR5: Validate bounds (0 <= index < list_len)\n    if not (0 <= start_index < list_len and 0 <= end_index < list_len):\n        raise ValueError(\"Index out of bounds.\")\n\n    # BR4: Validate start_index <= end_index\n    if start_index > end_index:\n        raise ValueError(\"Start index cannot be greater than end index.\")\n\n    # BR2: Extract inclusive sublist (values[start_index : end_index + 1])\n    sublist = values[start_index : end_index + 1]\n\n    total_sum = 0\n    # BR8: Verify each element in sublist is numeric (int or float) and sum\n    for item in sublist:\n        if not isinstance(item, (int, float)):\n            raise TypeError(\"List elements within the specified range must be numeric.\")\n        total_sum += item\n\n    return total_sum"}
