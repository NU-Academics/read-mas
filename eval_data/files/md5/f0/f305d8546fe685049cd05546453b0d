{"task_id": "Mbpp/422", "solution": "from typing import Iterator\n\ndef _validate_n(n) -> None:\n    \"\"\"Validates if n is an integer and n >= 1, otherwise raises ValueError.\"\"\"\n    if not isinstance(n, int):\n        raise ValueError(\"Input 'n' must be an integer.\")\n    if n < 1:\n        raise ValueError(\"Input 'n' must be a positive integer (n >= 1).\")\n\ndef _generate_sequence(n: int) -> Iterator[int]:\n    \"\"\"Generates a sequence of natural numbers from 1 to n.\"\"\"\n    for i in range(1, n + 1):\n        yield i\n\ndef _sum_of_cubes(n: int) -> int:\n    \"\"\"Calculates the sum of cubes of first n natural numbers.\"\"\"\n    total_sum = 0\n    for num in _generate_sequence(n):\n        total_sum += num ** 3\n    return total_sum\n\ndef find_Average_Of_Cube(n: int) -> float:\n    \"\"\"\n    Finds the average of cubes of first n natural numbers.\n    Input 'n' must be a positive integer (n >= 1).\n    \"\"\"\n    _validate_n(n)\n    total_sum = _sum_of_cubes(n)\n    return float(total_sum) / n"}
{"task_id": "Mbpp/424", "solution": "def extract_rear(input_tuple: tuple) -> list:\n    \"\"\"Extracts the rear index element (last character) of each string in the given tuple.\n\n    Returns a list containing the last character of each input string.\n    \"\"\"\n    if len(input_tuple) == 0:\n        return []\n    result = []\n    for s in input_tuple:\n        # s is expected to be a str; last char via s[-1]\n        result.append(s[-1])\n    return result"}
{"task_id": "Mbpp/426", "solution": "def filter_oddnumbers(inputList):\n    \"\"\"\n    Filters a list of integers, returning only the odd numbers while preserving their original order.\n    The inputList is expected to be a list of integers.\n    \"\"\"\n    result = []\n    for number in inputList:\n        if number % 2 != 0:\n            result.append(number)\n    return result"}
{"task_id": "Mbpp/425", "solution": "def count_element_in_list(list_of_sublists, target_element) -> int:\n    \"\"\"\n    Counts the number of sublists in a list of sublists that contain a particular element.\n    Each sublist is counted at most once, even if the element appears multiple times within it.\n    \"\"\"\n    count = 0\n    for sublist in list_of_sublists:\n        if target_element in sublist:\n            count += 1\n    return count"}
{"task_id": "Mbpp/427", "solution": "import re\n\nclass Validator:\n    \"\"\"Provides utility methods for validating date string formats.\"\"\"\n    @staticmethod\n    def isIsoDate(input_str: str) -> bool:\n        \"\"\"Checks if the input string matches 'yyyy-mm-dd' format.\"\"\"\n        parts = input_str.split('-')\n        if len(parts) != 3:\n            return False\n        year, month, day = parts\n        return (len(year) == 4 and year.isdigit() and\n                len(month) == 2 and month.isdigit() and\n                len(day) == 2 and day.isdigit())\n\n    @staticmethod\n    def matchesOutputRegex(output_str: str) -> bool:\n        \"\"\"Checks if the output string matches 'dd-mm-yyyy' format.\"\"\"\n        return re.match(r'^\\d{2}-\\d{2}-\\d{4}$', output_str) is not None\n\nclass DateString:\n    \"\"\"Represents a date string and provides parsing capabilities.\"\"\"\n    def __init__(self, raw_value: str) -> None:\n        self.rawValue = raw_value\n\n    def validateFormat(self) -> bool:\n        \"\"\"Validates the rawValue against the ISO date format.\"\"\"\n        return Validator.isIsoDate(self.rawValue)\n\n    def parse(self) -> dict:\n        \"\"\"Parses the rawValue into year, month, and day components.\"\"\"\n        year, month, day = self.rawValue.split('-')\n        return {'year': year, 'month': month, 'day': day}\n\nclass DateFormatter:\n    \"\"\"Orchestrates date validation, parsing, and reformatting.\"\"\"\n    def change_date_format(self, input_str: str) -> str:\n        \"\"\"Converts an 'yyyy-mm-dd' date string to 'dd-mm-yyyy'.\"\"\"\n        date_string_obj = DateString(input_str)\n        # As per design, behavior for invalid inputs is unspecified and not to raise exceptions.\n        # For the given problem, input is assumed to be valid per example.\n        date_string_obj.validateFormat()\n\n        parsed_parts = date_string_obj.parse()\n        year = parsed_parts['year']\n        month = parsed_parts['month']\n        day = parsed_parts['day']\n        \n        return self.formatParts(day, month, year)\n\n    def formatParts(self, day: str, month: str, year: str) -> str:\n        \"\"\"Formats given day, month, and year into 'dd-mm-yyyy'.\"\"\"\n        return f\"{day}-{month}-{year}\"\n\ndef change_date_format(input: str) -> str:\n    \"\"\"\n    Converts a date of yyyy-mm-dd format to dd-mm-yyyy format.\n    assert change_date_format(\"2026-01-02\") == '02-01-2026'\n    \"\"\"\n    formatter = DateFormatter()\n    return formatter.change_date_format(input)"}
{"task_id": "Mbpp/429", "solution": "class ValidationError(Exception):\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\n\nclass TupleInput:\n    def __init__(self, elements: tuple):\n        self.elements = elements\n\n    def length(self) -> int:\n        return len(self.elements)\n\nclass Element:\n    def __init__(self, value: int):\n        self.value = value\n\nclass TupleResult:\n    def __init__(self, elements: tuple):\n        self.elements = elements\n\nclass Validator:\n    def validateIsTuple(self, input_data) -> bool:\n        return isinstance(input_data, tuple)\n\n    def validateElementsAreIntegers(self, input_tuple: tuple) -> bool:\n        return all(isinstance(element, int) for element in input_tuple)\n\n    def validateEqualLength(self, t1: tuple, t2: tuple) -> bool:\n        return len(t1) == len(t2)\n\nclass AndOperator:\n    def bitwise_and(self, a: int, b: int) -> int:\n        return a & b\n\n    def apply(self, t1: tuple, t2: tuple) -> tuple:\n        result_elements = []\n        for i in range(len(t1)):\n            result_elements.append(self.bitwise_and(t1[i], t2[i]))\n        return tuple(result_elements)\n\ndef and_tuples(t1, t2) -> tuple:\n    \"\"\"\n    Orchestrates validation and computes the element-wise bitwise AND of two tuples.\n    Raises ValidationError if inputs are invalid.\n    \"\"\"\n    validator = Validator()\n\n    if not validator.validateIsTuple(t1):\n        raise ValidationError(\"Input t1 must be a tuple.\")\n    if not validator.validateIsTuple(t2):\n        raise ValidationError(\"Input t2 must be a tuple.\")\n\n    if not validator.validateElementsAreIntegers(t1):\n        raise ValidationError(\"All elements in t1 must be integers.\")\n    if not validator.validateElementsAreIntegers(t2):\n        raise ValidationError(\"All elements in t2 must be integers.\")\n\n    if not validator.validateEqualLength(t1, t2):\n        raise ValidationError(\"Input tuples must have the same length.\")\n\n    and_operator = AndOperator()\n    result_tuple = and_operator.apply(t1, t2)\n\n    return result_tuple"}
{"task_id": "Mbpp/428", "solution": "from typing import List\n\nclass ShellSortFunction:\n    \"\"\"Encapsulates the Shell sort algorithm and related helpers.\"\"\"\n\n    def generate_gap_sequence(self, n: int) -> List[int]:\n        \"\"\"Return gap sequence for length n.\"\"\"\n        gaps = []\n        gap = n // 2\n        while gap > 0:\n            gaps.append(gap)\n            gap //= 2\n        return gaps\n\n    def compare(self, a: float, b: float) -> int:\n        \"\"\"Return negative if a<b, zero if a==b, positive if a>b.\"\"\"\n        if a < b:\n            return -1\n        elif a > b:\n            return 1\n        else:\n            return 0\n\n    def shell_sort(self, arr: List[float]) -> List[float]:\n        \"\"\"Sort arr using Shell sort and return a new list sorted ascending.\"\"\"\n        temp_arr = list(arr)\n        n = len(temp_arr)\n        \n        gaps = self.generate_gap_sequence(n)\n        \n        for gap in gaps:\n            for i in range(gap, n):\n                current_element = temp_arr[i]\n                j = i\n                while j >= gap and self.compare(temp_arr[j - gap], current_element) > 0:\n                    temp_arr[j] = temp_arr[j - gap]\n                    j -= gap\n                temp_arr[j] = current_element\n        return temp_arr\n\ndef shell_sort(arr: List[float]) -> List[float]:\n    \"\"\"Top-level API function required by FR1: accepts a list and returns sorted list.\"\"\"\n    sorter = ShellSortFunction()\n    return sorter.shell_sort(arr)"}
