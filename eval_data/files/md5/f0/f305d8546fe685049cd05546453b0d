{"task_id": "Mbpp/62", "solution": "from typing import Any, List, Union\n\ndef _is_numeric(value: Any) -> bool:\n    \"\"\"Checks if a given value is an integer or a float.\"\"\"\n    return isinstance(value, (int, float))\n\ndef _validate_list(numbers: list) -> None:\n    \"\"\"Validates that the input is a non-empty list of numeric elements.\"\"\"\n    if not isinstance(numbers, list):\n        raise TypeError(\"Input must be a list.\")\n    if not numbers:\n        raise ValueError(\"List cannot be empty.\")\n    for element in numbers:\n        if not _is_numeric(element):\n            raise TypeError(\"All elements in the list must be numeric (int or float).\")\n\ndef smallest_num(numbers: list) -> Union[int, float]:\n    \"\"\"Finds the smallest numeric value in a list after validating its content.\"\"\"\n    _validate_list(numbers)\n    return min(numbers)"}
{"task_id": "Mbpp/59", "solution": "class ValidationError(Exception):\n    \"\"\"Custom exception for input validation errors. Contains a code and message.\"\"\"\n    def __init__(self, code: str, message: str) -> None:\n        super().__init__(message)\n        self.code = code\n        self.message = message\n\n    def __str__(self) -> str:\n        return f\"[{self.code}] {self.message}\"\n\nclass InputValidator:\n    \"\"\"Validates various inputs according to business rules.\"\"\"\n    def isPositiveInteger(self, n: object) -> bool:\n        \"\"\"Checks if the given input n is a positive integer.\"\"\"\n        return isinstance(n, int) and n > 0\n\n    def raise_error(self, code: str, message: str):\n        \"\"\"Raises a ValidationError with the specified code and message.\"\"\"\n        raise ValidationError(code, message)\n\nclass OctagonalCalculator:\n    \"\"\"Calculates octagonal numbers using a predefined formula.\"\"\"\n    def compute(self, n: int) -> int:\n        \"\"\"Computes the nth octagonal number.\"\"\"\n        return self.formula(n)\n\n    def formula(self, n: int) -> int:\n        \"\"\"Calculates O_n = n * (3*n - 2) using integer arithmetic.\"\"\"\n        return n * (3 * n - 2)\n\ndef is_octagonal(n: int) -> int:\n    \"\"\"\n    Computes the nth octagonal number.\n    Raises ValidationError if n is not a positive integer.\n    \"\"\"\n    validator = InputValidator()\n    if not validator.isPositiveInteger(n):\n        validator.raise_error(\"INVALID_INPUT\", \"Input 'n' must be a positive integer.\")\n\n    calculator = OctagonalCalculator()\n    return calculator.formula(n)"}
{"task_id": "Mbpp/61", "solution": "from typing import List\n\nclass InputString:\n    \"\"\"Lightweight wrapper around the input string.\"\"\"\n    def __init__(self, value: str) -> None:\n        self.value = value\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the input string.\"\"\"\n        return len(self.value)\n\nclass Substring:\n    \"\"\"Represents substring metadata and provides digit sum functionality.\"\"\"\n    def __init__(self, startIndex: int, digits: List[int]) -> None:\n        self.startIndex = startIndex\n        self.digits = digits\n        self.length = len(digits)\n\n    def sumDigits(self) -> int:\n        \"\"\"Calculates the sum of the digits in the substring.\"\"\"\n        return sum(self.digits)\n\n    def sumEqualsLength(self) -> bool:\n        \"\"\"Checks if the sum of digits equals the substring's length.\"\"\"\n        return self.sumDigits() == self.length\n\nclass CountSubstrings:\n    \"\"\"Stateless class implementing the enumeration and counting algorithm.\"\"\"\n    @staticmethod\n    def count_Substrings(s: str) -> int:\n        \"\"\"\n        Counts contiguous substrings where the sum of digits equals the substring length.\n        \"\"\"\n        match_count = 0\n        input_str_obj = InputString(s)\n        n = input_str_obj.length()\n\n        for i in range(n):\n            for j in range(i, n):\n                substring_slice = s[i : j + 1]\n                digits_list = [int(char) for char in substring_slice]\n                \n                current_substring = Substring(i, digits_list)\n                \n                if current_substring.sumEqualsLength():\n                    match_count += 1\n        \n        return match_count\n\ndef count_Substrings(s: str) -> int:\n    \"\"\"\n    Counts contiguous substrings of a digit-only string where the sum of digits equals the substring's length.\n    \"\"\"\n    return CountSubstrings.count_Substrings(s)"}
{"task_id": "Mbpp/57", "solution": "class Digit:\n    \"\"\"Represents a single digit occurrence with its value and original index.\"\"\"\n    def __init__(self, value: int, occurrence_index: int):\n        self.value = value\n        self.occurrence_index = occurrence_index\n\nclass DigitList:\n    \"\"\"Models input list as a collection of Digit instances preserving multiplicity.\"\"\"\n    def __init__(self, digit_values: list[int]):\n        self.digits: list[Digit] = []\n        for i, val in enumerate(digit_values):\n            self.digits.append(Digit(val, i))\n\n    def to_values(self) -> list[int]:\n        \"\"\"Returns digit values in their current order.\"\"\"\n        return [d.value for d in self.digits]\n\nclass DigitValidator:\n    \"\"\"Validates each element is an integer in the inclusive range 0-9.\"\"\"\n    def validate(self, digits: list) -> bool:\n        for element in digits:\n            if not isinstance(element, int) or not (0 <= element <= 9):\n                return False\n        return True\n\nclass MaxNumberResult:\n    \"\"\"Encapsulates the integer result.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\nclass MaxNumberService:\n    \"\"\"Core service for validating, ordering, concatenating digits to form the largest number.\"\"\"\n    def __init__(self, validator: DigitValidator):\n        self.validator = validator\n\n    def find_Max_Num(self, digits: list) -> int:\n        \"\"\"Finds the largest number formed by the given digits, after validation.\"\"\"\n        if not self.validator.validate(digits):\n            raise ValueError(\"Input list contains invalid elements. Elements must be integers between 0 and 9.\")\n\n        if not digits:\n            return 0 # Design decision: return 0 for an empty list.\n\n        digit_list_obj = DigitList(digits)\n        digit_list_obj.digits.sort(key=lambda d: d.value, reverse=True)\n\n        result_str = \"\".join(str(d.value) for d in digit_list_obj.digits)\n        int_value = int(result_str)\n        \n        max_num_result = MaxNumberResult(int_value)\n        return max_num_result.value\n\ndef find_Max_Num(digits: list) -> int:\n    \"\"\"Finds the largest number that can be formed with the given list of digits.\"\"\"\n    validator = DigitValidator()\n    service = MaxNumberService(validator=validator)\n    return service.find_Max_Num(digits)"}
{"task_id": "Mbpp/65", "solution": "def recursive_list_sum(input_list: list) -> int:\n    \"\"\"Accepts a single argument representing a list (which may contain nested lists) and returns the integer sum of all integer elements.\n\n    Behaviour required by SRS:\n    - Flatten nested lists of arbitrary depth and sum integer elements.\n    - Return 0 for an empty input list.\n\n    Preconditions: input_list is a Python list whose elements are integers or nested lists composed similarly.\n    \"\"\"\n    total_sum = 0\n    for item in input_list:\n        if isinstance(item, int):\n            total_sum += item\n        elif isinstance(item, list):\n            total_sum += recursive_list_sum(item)\n    return total_sum"}
{"task_id": "Mbpp/64", "solution": "from typing import List, Tuple, Union\nimport numbers\n\ndef _is_numeric(value: object) -> bool:\n    \"\"\"Checks if a value is a number (int or float).\"\"\"\n    return isinstance(value, numbers.Number)\n\ndef _validate_input(subjects: List[Tuple[str, Union[int, float]]]) -> None:\n    \"\"\"Validates the input list of tuples according to specified rules.\"\"\"\n    if not isinstance(subjects, list):\n        raise TypeError(\"Input must be a list.\")\n    for item in subjects:\n        if not isinstance(item, tuple) or len(item) != 2:\n            raise TypeError(\"Each item in the list must be a 2-element tuple.\")\n        if not isinstance(item[0], str):\n            raise TypeError(\"The first element of each tuple must be a string (subject name).\")\n        if not _is_numeric(item[1]):\n            raise TypeError(\"The second element of each tuple must be numeric (mark).\")\n\ndef _key_for_sort(item: Tuple[str, Union[int, float]]) -> Union[int, float]:\n    \"\"\"Returns the second element of a tuple for sorting purposes.\"\"\"\n    return item[1]\n\ndef subject_marks(subjects: List[Tuple[str, Union[int, float]]]) -> List[Tuple[str, Union[int, float]]]:\n    \"\"\"\n    Sorts a list of tuples (subject name, mark) by the mark in ascending order.\n    The sorting is stable, preserving the original relative order for equal marks.\n    \"\"\"\n    _validate_input(subjects)\n    return sorted(subjects, key=_key_for_sort)"}
{"task_id": "Mbpp/63", "solution": "class Pair:\n    \"\"\"Encapsulate two numeric values and compute their absolute difference.\"\"\"\n    def __init__(self, a, b):\n        self.a = a\n        self.b = b\n\n    def absDifference(self) -> float:\n        \"\"\"Return abs(self.a - self.b)\"\"\"\n        return abs(self.a - self.b)\n\n\nclass PairList:\n    \"\"\"Wrap a sequence of Pair objects.\"\"\"\n    def __init__(self, pairs: list):\n        self.pairs = pairs\n\n    def isEmpty(self) -> bool:\n        \"\"\"Return True if no pairs present.\"\"\"\n        return not self.pairs\n\n\nclass Validator:\n    \"\"\"Stateless utilities to validate tuple shape and numeric element types.\"\"\"\n    def validatePair(self, tuple_value) -> bool:\n        \"\"\"Return True if tuple_value is a 2-element sequence and both elements are numeric.\"\"\"\n        if not isinstance(tuple_value, (list, tuple)) or len(tuple_value) != 2:\n            return False\n        a, b = tuple_value\n        return isinstance(a, (int, float)) and isinstance(b, (int, float))\n\n    def validateList(self, list_value) -> bool:\n        \"\"\"Return True if list_value is iterable and every element passes validatePair().\"\"\"\n        if not isinstance(list_value, (list, tuple)):\n            return False\n        for item in list_value:\n            if not self.validatePair(item):\n                return False\n        return True\n\n\nclass DifferenceResult:\n    \"\"\"Value object to hold the resulting numeric maximum difference.\"\"\"\n    def __init__(self, value):\n        self.value = value\n\n\ndef _compute_differences(pairs: list) -> list:\n    \"\"\"Given a list of Pair instances, return a list of numeric absolute differences.\"\"\"\n    return [p.absDifference() for p in pairs]\n\n\ndef max_difference(list_of_pairs):\n    \"\"\"Public API. Accepts an iterable/list of 2-element numeric tuples and returns numeric maximum absolute difference.\"\"\"\n    validator = Validator()\n    if not validator.validateList(list_of_pairs):\n        raise ValueError(\"Input list is invalid: must be an iterable of 2-element numeric tuples.\")\n\n    # Construct Pair objects from input tuples\n    pairs = [Pair(a, b) for a, b in list_of_pairs]\n    pair_list = PairList(pairs)\n\n    if pair_list.isEmpty():\n        raise ValueError(\"Input list cannot be empty.\")\n\n    differences = _compute_differences(pair_list.pairs)\n    max_diff_value = max(differences)\n    \n    result = DifferenceResult(max_diff_value)\n    return result.value"}
{"task_id": "Mbpp/66", "solution": "def pos_count(input_list):\n    \"\"\"Count elements strictly greater than 0.\n\n    Returns the number of elements in input_list with value > 0.\n    \"\"\"\n    count = 0\n    for item in input_list:\n        if item > 0:\n            count += 1\n    return count"}
{"task_id": "Mbpp/68", "solution": "def is_Monotonic(arr):\n    \"\"\"Return True if arr is monotonic (non-increasing OR non-decreasing).\n\n    Adjacent equal elements allowed. Python comparison exceptions may surface for non-comparable elements.\n    \"\"\"\n    if len(arr) <= 1:\n        return True\n\n    non_decreasing = True\n    non_increasing = True\n\n    for i in range(len(arr) - 1):\n        if arr[i] < arr[i+1]:\n            non_increasing = False\n        if arr[i] > arr[i+1]:\n            non_decreasing = False\n        if not non_decreasing and not non_increasing:\n            return False\n\n    return True"}
{"task_id": "Mbpp/70", "solution": "from typing import List, Tuple\n\ndef _get_lengths(tuples: List[Tuple]) -> List[int]:\n    \"\"\"Extracts the length of each tuple in the given list.\"\"\"\n    return [len(t) for t in tuples]\n\nclass LengthComparator:\n    \"\"\"Helper class to compare lengths.\"\"\"\n    @staticmethod\n    def all_equal(lengths: List[int]) -> bool:\n        \"\"\"Checks if all lengths in the list are equal. Returns True for an empty list.\"\"\"\n        if not lengths:\n            return True\n        return len(set(lengths)) == 1\n\ndef get_equal(tuples: List[Tuple]) -> bool:\n    \"\"\"\n    Checks if all given tuples have equal length.\n    Returns True for an empty list of tuples.\n    \"\"\"\n    tuple_lengths = _get_lengths(tuples)\n    return LengthComparator.all_equal(tuple_lengths)"}
{"task_id": "Mbpp/69", "solution": "def is_sublist(main_list, sublist) -> bool:\n    \"\"\"\n    Checks if a sublist appears as a consecutive subsequence within a main list.\n    Returns True if sublist is found consecutively, False otherwise.\n    \"\"\"\n    len_main = len(main_list)\n    len_sub = len(sublist)\n\n    if len_sub > len_main:\n        return False\n\n    if len_sub == 0:\n        return True # An empty sublist is considered a sublist of any list\n\n    for i in range(len_main - len_sub + 1):\n        if main_list[i : i + len_sub] == sublist:\n            return True\n            \n    return False"}
{"task_id": "Mbpp/67", "solution": "class InvalidInputError(Exception):\n    \"\"\"Exception raised for invalid input to Bell number calculations.\"\"\"\n    pass\n\nclass InputValidator:\n    \"\"\"Validates input for Bell number computations, ensuring it's a non-negative integer.\"\"\"\n    def validate(self, n) -> bool:\n        if not isinstance(n, int):\n            raise InvalidInputError(\"n must be integer\")\n        if n < 0:\n            raise InvalidInputError(\"n must be non-negative\")\n        return True\n\nclass BellCache:\n    \"\"\"In-memory cache for Bell numbers.\"\"\"\n    def __init__(self):\n        self._store = {}\n\n    def get(self, n):\n        \"\"\"Retrieves a Bell number from the cache by n, or None if not found.\"\"\"\n        return self._store.get(n)\n\n    def set(self, n, value):\n        \"\"\"Stores a computed Bell number in the cache.\"\"\"\n        self._store[n] = value\n\nclass BellNumberService:\n    \"\"\"Orchestrates computation and caching of Bell numbers.\"\"\"\n    def __init__(self, cache: BellCache | None = None):\n        self._cache = cache or BellCache()\n\n    def bell_number(self, n) -> int:\n        \"\"\"Retrieves the nth Bell number, either from cache or by computing it.\"\"\"\n        cached_value = self._cache.get(n)\n        if cached_value is not None:\n            return cached_value\n\n        value = self._computeBell(n)\n        self._cache.set(n, value)\n        return value\n\n    def _computeBell(self, n) -> int:\n        \"\"\"\n        Computes the nth Bell number using the Bell triangle dynamic programming algorithm.\n        \"\"\"\n        if n == 0:\n            return 1\n\n        row_prev = [1]\n        for i in range(1, n + 1):\n            current_row = [row_prev[-1]]\n            for j in range(1, i + 1):\n                val = current_row[j - 1] + row_prev[j - 1]\n                current_row.append(val)\n            row_prev = current_row\n        return row_prev[0]\n\n_validator = InputValidator()\n_bell_service = BellNumberService()\n\ndef bell_number(n) -> int:\n    \"\"\"\n    Computes the nth Bell number, which represents the number of partitions of a set of n elements.\n    Validates input and retrieves or calculates the result using BellNumberService.\n    \"\"\"\n    _validator.validate(n)\n    return _bell_service.bell_number(n)"}
{"task_id": "Mbpp/72", "solution": "def dif_Square(n):\n    \"\"\"\n    Checks if the given number can be represented as the difference of two squares.\n    This is true if and only if n is not congruent to 2 modulo 4 (i.e., n % 4 != 2).\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an int\")\n    return (n % 4) != 2"}
{"task_id": "Mbpp/74", "solution": "from typing import Any, Dict, List\n\nclass Mapping:\n    \"\"\"Helper class to manage and validate one-to-one pattern-to-sequence mappings.\"\"\"\n    def __init__(self) -> None:\n        self.pattern_to_sequence: Dict[Any, Any] = {}\n        self.sequence_to_pattern: Dict[Any, Any] = {}\n\n    def isConsistent(self, patternElement: Any, sequenceElement: Any) -> bool:\n        \"\"\"\n        Checks if adding a mapping from patternElement to sequenceElement would be consistent.\n        \"\"\"\n        if patternElement in self.pattern_to_sequence:\n            if self.pattern_to_sequence[patternElement] != sequenceElement:\n                return False\n\n        if sequenceElement in self.sequence_to_pattern:\n            if self.sequence_to_pattern[sequenceElement] != patternElement:\n                return False\n        \n        return True\n\n    def addMapping(self, patternElement: Any, sequenceElement: Any) -> None:\n        \"\"\"Records a consistent mapping from patternElement to sequenceElement.\"\"\"\n        self.pattern_to_sequence[patternElement] = sequenceElement\n        self.sequence_to_pattern[sequenceElement] = patternElement\n\n\ndef is_samepatterns(patterns: List[Any], sequence: List[Any]) -> bool:\n    \"\"\"\n    Checks if two lists follow the same pattern based on a one-to-one consistent mapping.\n    \"\"\"\n    if len(patterns) != len(sequence):\n        return False\n\n    if not patterns and not sequence:\n        return True\n\n    mapper = Mapping()\n    for i in range(len(patterns)):\n        pattern_element = patterns[i]\n        sequence_element = sequence[i]\n\n        if not mapper.isConsistent(pattern_element, sequence_element):\n            return False\n        \n        mapper.addMapping(pattern_element, sequence_element)\n            \n    return True"}
{"task_id": "Mbpp/71", "solution": "from typing import List, Any\n\nclass CombSort:\n    _shrinkFactor: float = 1.3\n\n    def _compute_initial_gap(self, length: int) -> int:\n        \"\"\"\n        Computes the initial gap for the Comb Sort algorithm.\n        Ensures the gap is at least 1.\n        \"\"\"\n        gap = int(length / self._shrinkFactor)\n        return max(1, gap)\n\n    def comb_sort(self, inputList: List[Any]) -> List[Any]:\n        \"\"\"\n        Sorts a list using the Comb Sort algorithm.\n        Returns a new sorted list, without modifying the input.\n        \"\"\"\n        working_list = list(inputList)\n        n = len(working_list)\n\n        if n <= 1:\n            return working_list\n\n        gap = self._compute_initial_gap(n)\n        swapped = True\n\n        while gap > 1 or swapped:\n            swapped = False\n            for i in range(n - gap):\n                if working_list[i] > working_list[i + gap]:\n                    working_list[i], working_list[i + gap] = working_list[i + gap], working_list[i]\n                    swapped = True\n\n            if gap > 1:\n                gap = int(gap / self._shrinkFactor)\n                if gap < 1:\n                    gap = 1\n        return working_list\n\ndef comb_sort(inputList: List[Any]) -> List[Any]:\n    \"\"\"\n    Sorts a list of elements using the Comb Sort algorithm.\n    Returns a new sorted list in ascending order.\n    \"\"\"\n    sorter = CombSort()\n    return sorter.comb_sort(inputList)"}
{"task_id": "Mbpp/75", "solution": "from typing import List, Tuple\n\ndef find_tuples(list_of_tuples: List[Tuple[int, ...]], k: int) -> List[Tuple[int, ...]]:\n    \"\"\"Return a new list of tuples from list_of_tuples where every element in each tuple is divisible by k.\"\"\"\n    result: List[Tuple[int, ...]] = []\n    for t in list_of_tuples:\n        if all((e % k == 0) for e in t):\n            result.append(t)\n    return result"}
{"task_id": "Mbpp/80", "solution": "class TetrahedralCalculator:\n    \"\"\"A calculator for tetrahedral numbers.\"\"\"\n    def tetrahedral_number(self, n: int) -> int:\n        \"\"\"Calculates the nth tetrahedral number using the closed-form formula.\"\"\"\n        return n * (n + 1) * (n + 2) // 6\n\ndef tetrahedral_number(n: int) -> int:\n    \"\"\"\n    Finds the nth tetrahedral number.\n    Delegates the calculation to a TetrahedralCalculator instance.\n    \"\"\"\n    calculator = TetrahedralCalculator()\n    return calculator.tetrahedral_number(n)"}
{"task_id": "Mbpp/79", "solution": "class Word:\n    \"\"\"Represents a word with its text content.\"\"\"\n    def __init__(self, text: str):\n        self.text = text\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the word.\"\"\"\n        return len(self.text)\n\nclass WordLengthChecker:\n    \"\"\"Provides methods to check properties of word length.\"\"\"\n    def is_length_odd(self, word: 'Word') -> bool:\n        \"\"\"Checks if the length of the given word is odd.\"\"\"\n        return word.length() % 2 != 0\n\ndef word_len(word: str) -> bool:\n    \"\"\"\n    Checks if the length of the word is odd.\n    Delegates to domain objects for logic.\n    \"\"\"\n    word_obj = Word(word)\n    checker = WordLengthChecker()\n    return checker.is_length_odd(word_obj)"}
