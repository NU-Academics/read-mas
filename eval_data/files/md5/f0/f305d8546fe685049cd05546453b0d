{"task_id": "Mbpp/395", "solution": "class InputString:\n    \"\"\"\n    Conceptual wrapper for the input string value.\n    \"\"\"\n    def __init__(self, value: str) -> None:\n        self.value: str = value\n\nclass CharacterFrequency:\n    \"\"\"\n    Represents a mapping entry of a character and its integer count.\n    \"\"\"\n    def __init__(self, char: str, count: int) -> None:\n        self.char: str = char\n        self.count: int = count\n\nclass FrequencyTable:\n    \"\"\"\n    Builds and holds a frequency table mapping each character to its occurrence count.\n    Provides methods to build the table and query character counts.\n    \"\"\"\n    def __init__(self) -> None:\n        self.table: dict[str, int] = {}\n\n    def build(self, s: str) -> None:\n        \"\"\"Populates the frequency table based on the input string.\"\"\"\n        for char in s:\n            self.table[char] = self.table.get(char, 0) + 1\n\n    def get_count(self, c: str) -> int:\n        \"\"\"Returns the occurrence count for a given character, or 0 if absent.\"\"\"\n        return self.table.get(c, 0)\n\nclass Result:\n    \"\"\"\n    Represents the function result, holding a single-character string or None.\n    \"\"\"\n    def __init__(self, value: str | None) -> None:\n        self.value: str | None = value\n\nclass Finder:\n    \"\"\"\n    Executes the algorithm to find the first non-repeating character using a FrequencyTable.\n    \"\"\"\n    def first_non_repeating_character(self, s: str) -> Result:\n        \"\"\"\n        Builds a frequency table for the input string and scans it left-to-right\n        to find the first character that appears only once.\n        \"\"\"\n        freq_table = FrequencyTable()\n        freq_table.build(s)\n\n        for char in s:\n            if freq_table.get_count(char) == 1:\n                return Result(char)\n        return Result(None)\n\ndef first_non_repeating_character(s: str) -> str | None:\n    \"\"\"\n    Public module-level API that delegates to Finder and returns the result.\n    \"\"\"\n    finder = Finder()\n    result_obj = finder.first_non_repeating_character(s)\n    return result_obj.value"}
{"task_id": "Mbpp/398", "solution": "import collections\nfrom typing import List\n\ndef sum_of_digits(numbers: List[int]) -> int:\n    \"\"\"Compute sum of decimal digits for each integer in numbers and return total as int.\n\n    Raises:\n        TypeError: if numbers is not a list or contains non-int elements.\n    \"\"\"\n    def validate_input(numbers_input) -> None:\n        \"\"\"Validate input: ensure it is a list of integers, raising TypeError otherwise.\"\"\"\n        if not isinstance(numbers_input, list):\n            raise TypeError(\"input must be a list of integers\")\n        for num in numbers_input:\n            if not isinstance(num, int):\n                raise TypeError(\"input must be a list of integers\")\n\n    def digits_of_integer(value: int) -> List[int]:\n        \"\"\"Extract decimal digits of abs(value) and return them as a list of ints.\"\"\"\n        abs_value = abs(value)\n        if abs_value == 0:\n            return [0]\n        digits = []\n        while abs_value > 0:\n            digits.append(abs_value % 10)\n            abs_value //= 10\n        return digits[::-1] # Reverse to get correct order\n\n    def aggregate_digits(digits: List[int]) -> int:\n        \"\"\"Sum a sequence/list of integer digits and return an integer total.\"\"\"\n        return sum(digits)\n\n    validate_input(numbers)\n\n    if not numbers:\n        return 0\n\n    all_digits = []\n    for num in numbers:\n        all_digits.extend(digits_of_integer(num))\n\n    return aggregate_digits(all_digits)"}
