{"task_id": "Mbpp/391", "solution": "from dataclasses import dataclass\nfrom typing import Any, Sequence, List, Dict\n\nclass ValidationError(Exception):\n    \"\"\"Custom exception for validation failures in list conversion.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n\n@dataclass\nclass InputList:\n    \"\"\"Represents an input list with an optional identifier.\"\"\"\n    id: str\n    elements: Sequence[Any]\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the input list.\"\"\"\n        return len(self.elements)\n\n@dataclass\nclass OutputEntry:\n    \"\"\"Represents a single entry in the final output list.\"\"\"\n    key: Any\n    value: Any\n    index: int\n\n    def as_dict(self) -> Dict[Any, Any]:\n        \"\"\"Converts the entry into a dictionary.\"\"\"\n        return {self.key: self.value}\n\n@dataclass\nclass NestedMapping:\n    \"\"\"Holds a generated nested dictionary structure.\"\"\"\n    mapping: Dict[Any, Any]\n\n    def to_obj(self) -> Any:\n        \"\"\"Returns the internal mapping object.\"\"\"\n        return self.mapping\n\nclass ConvertListDictionary:\n    \"\"\"Coordinates the conversion of multiple lists into nested dictionaries.\"\"\"\n\n    def convert(self, *lists: Sequence[Any]) -> List[Dict[Any, Any]]:\n        \"\"\"\n        Converts multiple lists into a list of nested dictionaries.\n        The first list provides top-level keys, subsequent lists form nested values.\n        \"\"\"\n        self._validate_lengths(lists)\n\n        wrapped_lists = [InputList(id=f\"list_{idx}\", elements=lst) for idx, lst in enumerate(lists)]\n\n        output_list: List[Dict[Any, Any]] = []\n        \n        first_wrapped_list = wrapped_lists[0]\n        num_items = first_wrapped_list.length()\n\n        for i in range(num_items):\n            first_list_key = first_wrapped_list.elements[i]\n            remaining_values = [wrapped_lst.elements[i] for wrapped_lst in wrapped_lists[1:]]\n            nested_value = self._build_nested_mapping(remaining_values)\n            \n            entry = OutputEntry(key=first_list_key, value=nested_value, index=i)\n            output_list.append(entry.as_dict())\n        \n        return output_list\n\n    def _validate_lengths(self, lists: Sequence[Sequence[Any]]) -> None:\n        \"\"\"\n        Validates that there are at least two lists and all lists have equal length.\n        Raises ValidationError if validation fails.\n        \"\"\"\n        if len(lists) < 2:\n            raise ValidationError(\"At least two lists are required for conversion.\")\n\n        first_list_len = -1\n        for i, lst in enumerate(lists):\n            if not isinstance(lst, Sequence):\n                raise ValidationError(f\"Input argument at index {i} is not a sequence: {type(lst).__name__}\")\n            if i == 0:\n                first_list_len = len(lst)\n            elif len(lst) != first_list_len:\n                raise ValidationError(\"All input lists must have the same length.\")\n\n    def _build_nested_mapping(self, values: Sequence[Any]) -> Any:\n        \"\"\"\n        Builds a nested dictionary from a sequence of values.\n        If only one value, returns the value itself; otherwise, nests from right to left.\n        \"\"\"\n        if not values:\n            return None \n        if len(values) == 1:\n            return values[0]\n        \n        nested = values[-1]\n        for v in reversed(values[:-1]):\n            nested = {v: nested}\n        return nested\n\n\ndef convert_list_dictionary(*lists: Sequence[Any]) -> List[Dict[Any, Any]]:\n    \"\"\"\n    Converts two or more lists into a list of nested dictionaries.\n    The first list provides keys, and subsequent lists provide values for nested structures.\n    \"\"\"\n    coordinator = ConvertListDictionary()\n    return coordinator.convert(*lists)"}
{"task_id": "Mbpp/392", "solution": "import math\nfrom typing import Optional\n\nclass NegativeInputError(Exception):\n    \"\"\"Exception raised for negative input values.\"\"\"\n    def __init__(self, message: str):\n        self.message = message\n        super().__init__(self.message)\n\nclass MemoizationCache:\n    \"\"\"In-memory cache for storing computed function values.\"\"\"\n    def __init__(self) -> None:\n        self.cache: dict[int, int] = {}\n\n    def contains(self, n: int) -> bool:\n        \"\"\"Checks if a value for n is present in the cache.\"\"\"\n        return n in self.cache\n\n    def get(self, n: int) -> int:\n        \"\"\"Retrieves the cached value for n.\"\"\"\n        return self.cache[n]\n\n    def set(self, n: int, value: int) -> None:\n        \"\"\"Stores a value for n in the cache.\"\"\"\n        self.cache[n] = value\n\nclass GetMaxSumFunction:\n    \"\"\"Encapsulates the logic for computing f(n) with memoization and validation.\"\"\"\n    def __init__(self, cache: Optional[MemoizationCache] = None) -> None:\n        self._cache = cache if cache is not None else MemoizationCache()\n\n    def validate_input(self, n: int) -> None:\n        \"\"\"Validates that the input n is a non-negative integer.\"\"\"\n        if n < 0:\n            raise NegativeInputError(\"Input 'n' must be a non-negative integer.\")\n\n    def compute(self, n: int) -> int:\n        \"\"\"Public entry point for computing f(n), including validation.\"\"\"\n        self.validate_input(n)\n        return self._compute_rec(n)\n\n    def _compute_rec(self, n: int) -> int:\n        \"\"\"Recursive helper for computing f(n) with memoization.\"\"\"\n        if n == 0:\n            return 0\n\n        if self._cache.contains(n):\n            return self._cache.get(n)\n\n        sum_of_subproblems = (\n            self._compute_rec(n // 2) +\n            self._compute_rec(n // 3) +\n            self._compute_rec(n // 4) +\n            self._compute_rec(n // 5)\n        )\n        \n        result = max(sum_of_subproblems, n)\n        self._cache.set(n, result)\n        return result\n\n_max_sum_calculator = GetMaxSumFunction()\n\ndef get_max_sum(n: int) -> int:\n    \"\"\"\n    Finds the maximum sum possible by using the equation \n    f(n) = max( (f(n/2) + f(n/3) + f(n/4) + f(n/5)), n), with f(0)=0.\n    \"\"\"\n    return _max_sum_calculator.compute(n)"}
{"task_id": "Mbpp/394", "solution": "import dataclasses\n\n@dataclasses.dataclass(frozen=True)\nclass Result:\n    \"\"\"Immutable value-object for the distinctness check result.\"\"\"\n    is_distinct: bool\n\nclass CheckDistinctFunction:\n    \"\"\"Encapsulates logic for validating input and computing tuple uniqueness.\"\"\"\n\n    def validate_input(self, tuple_input: tuple) -> None:\n        \"\"\"Validates that the input is a tuple, raising TypeError if not.\"\"\"\n        if not isinstance(tuple_input, tuple):\n            raise TypeError(\"input must be tuple\")\n\n    def compute_uniqueness(self, tuple_input: tuple) -> Result:\n        \"\"\"Computes whether the given tuple contains only unique elements.\"\"\"\n        if len(tuple_input) == 0:\n            return Result(True)\n\n        try:\n            seen = set()\n            for elem in tuple_input:\n                if elem in seen:\n                    return Result(False)\n                seen.add(elem)\n        except TypeError:\n            # Fallback for unhashable elements: O(n^2) pairwise comparison.\n            for i in range(len(tuple_input)):\n                for j in range(i + 1, len(tuple_input)):\n                    if tuple_input[i] == tuple_input[j]:\n                        return Result(False)\n        return Result(True)\n\n    def execute(self, tuple_input: tuple) -> Result:\n        \"\"\"Orchestrates validation and uniqueness computation.\"\"\"\n        self.validate_input(tuple_input)\n        return self.compute_uniqueness(tuple_input)\n\ndef check_distinct(tuple_input: tuple) -> bool:\n    \"\"\"\n    Checks if the given tuple contains no duplicate elements.\n    Raises TypeError if the input is not a tuple.\n    \"\"\"\n    result = CheckDistinctFunction().execute(tuple_input)\n    return result.is_distinct"}
