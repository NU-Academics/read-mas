{"task_id": "Mbpp/286", "solution": "def _kadane(arr: list[int]) -> int:\n    \"\"\"Helper for standard Kadane's algorithm to find the maximum contiguous subarray sum in a single array.\"\"\"\n    # This variant correctly handles arrays with all negative numbers by returning the largest single element.\n    if not arr:\n        return 0\n\n    max_so_far = arr[0]\n    current_max = arr[0]\n\n    for x in arr[1:]:\n        current_max = max(x, current_max + x)\n        max_so_far = max(max_so_far, current_max)\n\n    return max_so_far\n\ndef _kadane_on_two_concat(arr: list[int]) -> int:\n    \"\"\"\n    Helper to find the maximum contiguous subarray sum in the array conceptually repeated twice.\n    This implementation avoids physically concatenating the array to save memory.\n    \"\"\"\n    n = len(arr)\n    if n == 0:\n        return 0\n\n    max_so_far = arr[0]\n    current_max = arr[0]\n\n    # Iterate through the array's elements conceptually twice.\n    # The first element is handled by initialization, so loop for 2*n - 1 additional elements.\n    for i in range(1, 2 * n):\n        val = arr[i % n]\n        current_max = max(val, current_max + val)\n        max_so_far = max(max_so_far, current_max)\n        \n    return max_so_far\n\ndef max_sub_array_sum_repeated(arr: list[int], n: int, k: int) -> int:\n    \"\"\"\n    Finds the largest sum of a contiguous array in the modified array which is formed by\n    repeating the given array k times.\n    \"\"\"\n    # The 'n' parameter is assumed to match len(arr) and 'k' is assumed to be a valid integer > 0\n    # as per problem instructions to omit explicit validation checks.\n\n    if not arr:\n        return 0\n\n    if k == 1:\n        return _kadane(arr)\n    elif k == 2:\n        return _kadane_on_two_concat(arr)\n    else: # k > 2\n        # For k > 2, we use an optimized approach based on the total sum of the array.\n        # Calculate the maximum sum for the array conceptually repeated twice.\n        best_two_concatenations = _kadane_on_two_concat(arr)\n        \n        # Calculate the total sum of the original array.\n        total_arr_sum = sum(arr)\n        \n        # If the total sum of the array is positive, repeating it further will increase the max sum.\n        # We add (k - 2) * total_arr_sum to the best sum from two concatenations.\n        # If total_arr_sum is non-positive, adding more copies won't improve the sum beyond\n        # what's already found within two concatenations, so we just use best_two_concatenations.\n        if total_arr_sum > 0:\n            return best_two_concatenations + (k - 2) * total_arr_sum\n        else:\n            return best_two_concatenations"}
{"task_id": "Mbpp/292", "solution": "import math\n\ndef find(dividend, divisor) -> int:\n    \"\"\"Compute floor(dividend / divisor) and return the result as an integer.\"\"\"\n    result_float = dividend / divisor\n    floored = math.floor(result_float)\n    return int(floored)"}
{"task_id": "Mbpp/290", "solution": "from typing import Any, List, Tuple, NamedTuple\n\nclass Result(NamedTuple):\n    max_len: int\n    max_list: List[Any]\n\ndef max_length(list_of_lists: List[List[Any]]) -> Tuple[int, List[Any]]:\n    \"\"\"Return (max_len, max_list) where max_len is the length of the longest sublist.\n    Raises TypeError if list_of_lists is not a list (top-level).\"\"\"\n    if not isinstance(list_of_lists, list):\n        raise TypeError(\"max_length requires a list of lists\")\n\n    if not list_of_lists:\n        return Result(0, [])\n\n    current_max_len = -1\n    current_max_list = []\n\n    for sub in list_of_lists:\n        if not isinstance(sub, list):\n            raise TypeError(\"elements of list_of_lists must be lists\")\n        l = len(sub)\n        if l > current_max_len:\n            current_max_len = l\n            current_max_list = sub\n            \n    return Result(current_max_len, current_max_list)"}
{"task_id": "Mbpp/293", "solution": "import math\n\ndef otherside_rightangle(a, b) -> float:\n    \"\"\"\n    Calculates the hypotenuse of a right-angled triangle given its two perpendicular sides.\n    Inputs must be numeric and positive.\n    \"\"\"\n    if not isinstance(a, (int, float)) or not isinstance(b, (int, float)):\n        raise ValueError(\"Inputs must be numeric (int or float).\")\n    if a <= 0 or b <= 0:\n        raise ValueError(\"Inputs must be positive numbers.\")\n    \n    hypotenuse = math.sqrt(a**2 + b**2)\n    return hypotenuse"}
{"task_id": "Mbpp/294", "solution": "from dataclasses import dataclass\nfrom typing import Any, Union\n\ndef _is_numeric(value: Any) -> bool:\n    \"\"\"Checks if a value is an integer or a float.\"\"\"\n    return isinstance(value, (int, float))\n\n@dataclass\nclass InputList:\n    elements: list\n\n@dataclass\nclass NumericElement:\n    value: Union[int, float]\n    type: str\n\n@dataclass\nclass NonNumericElement:\n    value: Any\n    type: str\n\n@dataclass\nclass Result:\n    maxValue: Union[int, float]\n\nclass MaxValFunction:\n    \"\"\"Encapsulates the algorithm to find the maximum numeric value.\"\"\"\n    def __init__(self):\n        self.input_list: InputList\n        self._numeric_elements: list[NumericElement]\n\n    def max_val(self, elements: list) -> Union[int, float]:\n        \"\"\"Processes the input list, filters numeric elements, and computes the maximum.\"\"\"\n        self.input_list = InputList(elements=elements)\n        self._numeric_elements = []\n\n        for e in self.input_list.elements:\n            if _is_numeric(e):\n                ne = NumericElement(value=e, type=(\"int\" if isinstance(e, int) else \"float\"))\n                self._numeric_elements.append(ne)\n            else:\n                pass # Non-numeric elements are ignored per design\n\n        return self.computeMax()\n\n    def computeMax(self) -> Union[int, float]:\n        \"\"\"Computes the maximum value from the filtered numeric elements.\"\"\"\n        values = [ne.value for ne in self._numeric_elements]\n        # Behavior for an empty list of numeric elements is unspecified in design,\n        # so default Python ValueError for max() on empty sequence is allowed.\n        return max(values)\n\ndef max_val(elements: list) -> Union[int, float]:\n    \"\"\"\n    Finds the maximum numeric value in a heterogeneous list, ignoring non-numeric elements.\n    \"\"\"\n    mf = MaxValFunction()\n    return mf.max_val(elements)"}
{"task_id": "Mbpp/296", "solution": "from typing import List\n\ndef _validate_input(arr) -> None:\n    \"\"\"Validates if the input is a list of integers, raising TypeError if not.\"\"\"\n    if not isinstance(arr, list):\n        raise TypeError(\"Input must be a list.\")\n    for x in arr:\n        if not isinstance(x, int):\n            raise TypeError(\"All elements in the list must be integers.\")\n\ndef _merge_and_count_inversions(left: List[int], right: List[int]) -> (List[int], int):\n    \"\"\"Merges two sorted subarrays and counts inversions between them.\"\"\"\n    merged_arr = []\n    inversions = 0\n    i, j = 0, 0\n    \n    while i < len(left) and j < len(right):\n        if left[i] <= right[j]:\n            merged_arr.append(left[i])\n            i += 1\n        else:\n            merged_arr.append(right[j])\n            inversions += (len(left) - i)\n            j += 1\n            \n    merged_arr.extend(left[i:])\n    merged_arr.extend(right[j:])\n    \n    return merged_arr, inversions\n\ndef _count_inversions_merge_recursive_impl(arr: List[int]) -> (List[int], int):\n    \"\"\"Recursively counts inversions using a merge sort approach, returning a sorted array and the count.\"\"\"\n    n = len(arr)\n    if n <= 1:\n        return arr, 0\n    \n    mid = n // 2\n    left_half = arr[:mid]\n    right_half = arr[mid:]\n    \n    sorted_left, inversions_left = _count_inversions_merge_recursive_impl(left_half)\n    sorted_right, inversions_right = _count_inversions_merge_recursive_impl(right_half)\n    \n    merged_arr, split_inversions = _merge_and_count_inversions(sorted_left, sorted_right)\n    \n    total_inversions = inversions_left + inversions_right + split_inversions\n    return merged_arr, total_inversions\n\ndef _count_inversions_merge(arr: List[int]) -> int:\n    \"\"\"Computes the total number of inversions in the array using a merge sort-based algorithm.\"\"\"\n    _, inversions = _count_inversions_merge_recursive_impl(arr)\n    return inversions\n\ndef get_Inv_Count(arr: List[int]) -> int:\n    \"\"\"\n    Counts the number of inversions in an array using a merge-sort based approach.\n    An inversion is a pair of indices (i, j) with i < j and arr[i] > arr[j].\n    \"\"\"\n    _validate_input(arr)\n    if len(arr) == 0:\n        return 0\n    return _count_inversions_merge(arr)"}
{"task_id": "Mbpp/297", "solution": "def flatten_list(input_list: list) -> list:\n    \"\"\"\n    Flattens a given nested list structure into a single-level list.\n    Elements are processed depth-first, left-to-right, and the input list is not modified.\n    \"\"\"\n    flat_list = []\n\n    def _flatten_recursive(item, acc):\n        if isinstance(item, list):\n            for sub_item in item:\n                _flatten_recursive(sub_item, acc)\n        else:\n            acc.append(item)\n\n    for item in input_list:\n        _flatten_recursive(item, flat_list)\n\n    return flat_list"}
{"task_id": "Mbpp/299", "solution": "class NameValueTuple:\n    \"\"\"Data-holder for an input entry.\"\"\"\n    def __init__(self, name: str, value: float) -> None:\n        self.name = name\n        self.value = float(value)\n\nclass AggregateRecord:\n    \"\"\"Data-holder for an aggregated total.\"\"\"\n    def __init__(self, name: str, total: float) -> None:\n        self.name = name\n        self.total = float(total)\n\nclass Result:\n    \"\"\"Data-holder for the returned result.\"\"\"\n    def __init__(self, name: str, total: float) -> None:\n        self.name = name\n        self.total = float(total)\n\nclass Aggregator:\n    \"\"\"Aggregates numeric values by name and finds the maximum aggregate.\"\"\"\n    def __init__(self) -> None:\n        self._aggregates: dict[str, float] = {}\n\n    def aggregate(self, entries: list) -> None:\n        \"\"\"Adds entries to the internal aggregates, summing values per name.\"\"\"\n        for name, value in entries:\n            self._aggregates[name] = self._aggregates.get(name, 0.0) + float(value)\n\n    def sumByName(self) -> dict:\n        \"\"\"Returns a copy of the per-name totals.\"\"\"\n        return self._aggregates.copy()\n\n    def maxAggregate(self) -> Result:\n        \"\"\"Finds the name with the maximum aggregated total.\"\"\"\n        if not self._aggregates:\n            raise ValueError(\"No aggregates to process.\")\n\n        max_name = None\n        max_total = -float('inf')\n\n        for name, total in self._aggregates.items():\n            if total > max_total:\n                max_total = total\n                max_name = name\n        \n        return Result(max_name, max_total)\n\ndef max_aggregate(input_list):\n    \"\"\"\n    Calculates the maximum aggregate from a list of (name, value) tuples.\n    Returns the name with the maximum total and its sum.\n    \"\"\"\n    aggregator = Aggregator()\n    aggregator.aggregate(input_list)\n    result = aggregator.maxAggregate()\n    return (result.name, result.total)"}
{"task_id": "Mbpp/300", "solution": "def count_binary_seq(n: int) -> float:\n    \"\"\"Validate and compute the count of binary sequences of length 2n where the sum of the first n bits equals the sum of the last n bits.\n    Raises ValueError for invalid n. Returns a numeric count (integer value returned but annotated as float per SRS guidance).\"\"\"\n\n    def _binomial(n_val: int, k_val: int) -> int:\n        \"\"\"Computes the binomial coefficient C(n, k) using integer arithmetic.\"\"\"\n        if k_val < 0 or k_val > n_val:\n            return 0\n        if k_val == 0 or k_val == n_val:\n            return 1\n        if k_val > n_val // 2:\n            k_val = n_val - k_val\n\n        res = 1\n        for i in range(k_val):\n            res = res * (n_val - i) // (i + 1)\n        return res\n\n    def _validate_n(n_val: int) -> None:\n        \"\"\"Validates that n is a non-negative integer, raising ValueError otherwise.\"\"\"\n        if not isinstance(n_val, int):\n            raise ValueError(\"Input 'n' must be an integer.\")\n        if n_val < 0:\n            raise ValueError(\"Input 'n' must be a non-negative integer.\")\n\n    def _compute_count(n_val: int) -> int:\n        \"\"\"Computes the exact integer count using the combinatorial identity C(2n, n).\"\"\"\n        return _binomial(2 * n_val, n_val)\n\n    _validate_n(n)\n    count = _compute_count(n)\n    return float(count)"}
{"task_id": "Mbpp/301", "solution": "from typing import Dict, Any\n\ndef dict_depth(input: Dict[str, Any]) -> int:\n    \"\"\"\n    Computes the maximum nesting depth of dictionaries within the input dictionary.\n    The top-level dictionary counts as depth 1.\n    \"\"\"\n    if not isinstance(input, dict):\n        raise TypeError(\"Input must be a dictionary.\")\n\n    def _dict_depth_recursive(node: Dict[str, Any]) -> int:\n        \"\"\"\n        Recursively computes the depth for a given dictionary node.\n        Counts the current node as 1 and adds the maximum child dictionary depth.\n        \"\"\"\n        max_child_depth = 0\n        for value in node.values():\n            if isinstance(value, dict):\n                max_child_depth = max(max_child_depth, _dict_depth_recursive(value))\n        return 1 + max_child_depth\n\n    return _dict_depth_recursive(input)"}
{"task_id": "Mbpp/305", "solution": "from dataclasses import dataclass\nfrom typing import List, Tuple\n\n@dataclass\nclass Word:\n    \"\"\"Represents a single word token.\"\"\"\n    text: str\n\n    def startsWithP(self) -> bool:\n        \"\"\"Checks if the word starts with 'p' or 'P', case-insensitively.\"\"\"\n        return bool(self.text) and self.text[0].lower() == 'p'\n\n@dataclass\nclass OutputTuple:\n    \"\"\"Container for the two selected words before converting to a native tuple.\"\"\"\n    first: str\n    second: str\n\n    def to_tuple(self) -> Tuple[str, str]:\n        \"\"\"Converts the container to a native 2-tuple.\"\"\"\n        return (self.first, self.second)\n\ndef parseStrings(inputList: List[str]) -> List[Word]:\n    \"\"\"Splits each string in the input list into Word tokens.\"\"\"\n    all_words: List[Word] = []\n    for s in inputList:\n        for token in s.split():\n            all_words.append(Word(text=token))\n    return all_words\n\ndef filterPWords(words: List[Word]) -> List[Word]:\n    \"\"\"Filters a list of Word objects, returning only those that start with 'p'.\"\"\"\n    p_words: List[Word] = []\n    for word in words:\n        if word.startsWithP():\n            p_words.append(word)\n    return p_words\n\ndef start_withp(inputList: List[str]) -> Tuple[str, str]:\n    \"\"\"\n    Returns two words from a list of words starting with letter 'p'.\n    Preserves original casing and order.\n    \"\"\"\n    parsed_words = parseStrings(inputList)\n    p_starting_words = filterPWords(parsed_words)\n\n    if len(p_starting_words) < 2:\n        raise ValueError(\"Fewer than two words starting with 'p' found.\")\n\n    first_match = p_starting_words[0]\n    second_match = p_starting_words[1]\n\n    output = OutputTuple(first=first_match.text, second=second_match.text)\n    return output.to_tuple()"}
