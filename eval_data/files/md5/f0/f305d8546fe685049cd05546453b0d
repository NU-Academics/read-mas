{"task_id": "Mbpp/239", "solution": "from typing import Optional\n\nclass Parameters:\n    def __init__(self, m: int, n: int):\n        self.m = m\n        self.n = n\n\nclass Validator:\n    def validate(self, parameters: Parameters) -> bool:\n        \"\"\"\n        Validates that m and n are positive integers.\n        \"\"\"\n        if not isinstance(parameters.m, int) or not isinstance(parameters.n, int):\n            return False\n        if parameters.m < 1 or parameters.n < 1:\n            return False\n        return True\n\nclass SequenceGenerator:\n    def __init__(self):\n        \"\"\"\n        Initializes the SequenceGenerator with an empty memoization cache.\n        \"\"\"\n        self._memo = {}  # Cache mapping (last_value, remaining_length) to count\n\n    def countSequences(self, parameters: Parameters) -> int:\n        \"\"\"\n        Counts valid sequences based on the provided parameters.\n        \"\"\"\n        # The memoization cache should be specific to this sequence counting process\n        self._memo = {}\n        return self._generateRecursively(last_value=None, remaining=parameters.n, m=parameters.m)\n\n    def _generateRecursively(self, last_value: Optional[int], remaining: int, m: int) -> int:\n        \"\"\"\n        Recursively counts sequences, utilizing memoization.\n        \"\"\"\n        if remaining == 0:\n            return 1  # Found a valid sequence of the specified length\n\n        memo_key = (last_value, remaining)\n        if memo_key in self._memo:\n            return self._memo[memo_key]\n\n        total_count = 0\n        if last_value is None:\n            # First element can be any integer from 1 to m\n            start_val = 1\n        else:\n            # Current element must be at least twice the previous element\n            start_val = 2 * last_value\n\n        # Iterate through possible values for the current element\n        for current_val in range(start_val, m + 1):\n            total_count += self._generateRecursively(current_val, remaining - 1, m)\n\n        self._memo[memo_key] = total_count\n        return total_count\n\ndef get_total_number_of_sequences(m: int, n: int) -> int:\n    \"\"\"\n    Counts sequences of length n, where elements are positive, <= m, and each is >= twice the previous.\n    \"\"\"\n    parameters = Parameters(m, n)\n    validator = Validator()\n    if not validator.validate(parameters):\n        raise ValueError(\"m and n must be positive integers with n >= 1\")\n\n    generator = SequenceGenerator()\n    return generator.countSequences(parameters)"}
