{"task_id": "Mbpp/762", "solution": "class MonthChecker:\n    \"\"\"Encapsulates business-rule lookup and validation for month days.\"\"\"\n    _thirty_day_months: set[int] = {4, 6, 9, 11}\n\n    def check_monthnumber_number(self, month: int) -> bool:\n        \"\"\"\n        Checks if the given month number has 30 days.\n        Returns False for out-of-range month values (outside 1-12).\n        \"\"\"\n        if not (1 <= month <= 12):\n            return False\n        return month in self._thirty_day_months\n\ndef check_monthnumber_number(month: int) -> bool:\n    \"\"\"\n    Checks if the given month number (1-12) contains 30 days.\n    Delegates the check to an instance of MonthChecker.\n    \"\"\"\n    checker = MonthChecker()\n    return checker.check_monthnumber_number(month)"}
{"task_id": "Mbpp/763", "solution": "from .validator import Validator\nfrom .domain import InputSequence, Result\n\ndef find_min_diff(arr, n) -> float:\n    \"\"\"Validate inputs and return minimum absolute difference among first n elements.\n    Raises ValueError or TypeError per validation rules.\n    \"\"\"\n    v = Validator()\n    v.validate_bounds(arr, n)\n    v.validate_types(arr, n)\n\n    # Convert the first n elements to a list of floats for consistency with InputSequence.elements: list[float].\n    numeric_elements = [float(x) for x in arr[:n]]\n    seq = InputSequence(elements=numeric_elements)\n\n    sorted_elements = sorted(seq.elements)\n\n    min_diff = float('inf')\n\n    # Since n >= 2 is enforced by validate_bounds, sorted_elements will always have at least two elements.\n    for i in range(len(sorted_elements) - 1):\n        diff = sorted_elements[i+1] - sorted_elements[i]\n        min_diff = min(min_diff, diff)\n\n    return min_diff"}
{"task_id": "Mbpp/764", "solution": "def number_ctr(input_string):\n    \"\"\"\n    Counts the number of ASCII decimal digit characters ('0' through '9') in the given string.\n    Raises TypeError if the input is not a string.\n    \"\"\"\n    def _validate_input_string(input_val):\n        \"\"\"Private helper to validate input type, raising TypeError if not a string.\"\"\"\n        if not isinstance(input_val, str):\n            raise TypeError(\"Input must be a string.\")\n\n    _validate_input_string(input_string)\n    \n    count = 0\n    for char in input_string:\n        if '0' <= char <= '9':  # Check for ASCII decimal digits\n            count += 1\n    return count"}
{"task_id": "Mbpp/766", "solution": "from typing import Any, List, Tuple\n\ndef pair_wise(items: list) -> list:\n    \"\"\"\n    Returns a list of all pairs of consecutive items in the given list.\n    Handles empty or single-item lists by returning an empty list.\n    \"\"\"\n    return [(items[i], items[i+1]) for i in range(len(items) - 1)]"}
{"task_id": "Mbpp/765", "solution": "class InputParameter:\n    def __init__(self, n: int) -> None:\n        self.n = n\n\n    def validate(self) -> bool:\n        # Validates that n is an integer >= 1.\n        return self.n >= 1\n\nclass PowerOfTwoChecker:\n    def is_power_of_two(self, x: int) -> bool:\n        # Determines if a positive integer x is a power of two.\n        # 1 is considered a power of two.\n        return (x > 0) and ((x & (x - 1)) == 0)\n\nclass PoliteNumberGenerator:\n    def __init__(self, checker: PowerOfTwoChecker = None) -> None:\n        # Initializes the generator, using a default checker if none is provided.\n        self._checker = checker if checker is not None else PowerOfTwoChecker()\n\n    def get_nth(self, n: int) -> int:\n        # Finds the nth polite number by iterating through positive integers.\n        polite_count = 0\n        candidate = 1\n        while True:\n            if not self._checker.is_power_of_two(candidate):\n                polite_count += 1\n                if polite_count == n:\n                    return candidate\n            candidate += 1\n\ndef is_polite(n: int) -> int:\n    \"\"\"\n    Finds the nth polite number.\n    A polite number is a positive integer that is not a power of two.\n    \"\"\"\n    param = InputParameter(n)\n    # The design includes validation but the prompt forbids raising exceptions.\n    # Therefore, we proceed assuming `n` is a valid positive integer (n >= 1).\n\n    generator = PoliteNumberGenerator()\n    return generator.get_nth(n)"}
{"task_id": "Mbpp/767", "solution": "from typing import Sequence\n\ndef validate_input(list_of_numbers: Sequence, target_sum) -> None:\n    \"\"\"Raise TypeError or ValueError on invalid inputs per FR6 / BR8.\"\"\"\n    if not isinstance(list_of_numbers, (list, tuple)):\n        raise TypeError(\"Input 'list_of_numbers' must be a list or tuple.\")\n\n    if not isinstance(target_sum, (int, float)):\n        raise TypeError(\"Input 'target_sum' must be a numeric value (int or float).\")\n\n    for i, num in enumerate(list_of_numbers):\n        if not isinstance(num, (int, float)):\n            raise ValueError(f\"Element at index {i} ('{num}') in 'list_of_numbers' is not a numeric value.\")\n\ndef get_pairs_count(list_of_numbers: Sequence, target_sum) -> int:\n    \"\"\"Return integer count of unordered index pairs (i<j) whose elements sum exactly to target_sum.\"\"\"\n    validate_input(list_of_numbers, target_sum)\n\n    n = len(list_of_numbers)\n    count = 0\n\n    for i in range(n):\n        for j in range(i + 1, n):\n            if list_of_numbers[i] + list_of_numbers[j] == target_sum:\n                count += 1\n    return count"}
{"task_id": "Mbpp/770", "solution": "from typing import List, Iterable\n\ndef _validate_n(n) -> None:\n    \"\"\"Validates that n is a positive integer (n >= 1).\n    Raises ValueError if validation fails.\n    \"\"\"\n    if not isinstance(n, int) or n < 1:\n        raise ValueError(\"Input 'n' must be a positive integer (n >= 1).\")\n\ndef _generate_odds(n) -> List[int]:\n    \"\"\"Generates a list of the first n odd natural numbers.\n    For n=1, returns [1]; for n=2, returns [1, 3].\n    \"\"\"\n    return [2 * i + 1 for i in range(n)]\n\ndef _sum_fourth_powers(values: Iterable[int]) -> int:\n    \"\"\"Computes the sum of the fourth powers of the numbers in the iterable.\n    Uses integer arithmetic for all computations.\n    \"\"\"\n    total_sum = 0\n    for v in values:\n        total_sum += v ** 4\n    return total_sum\n\ndef odd_num_sum(n):\n    \"\"\"Compute and return sum_{k=1..n} (2*k - 1)**4 as a Python int.\n    Raises ValueError if n is not an int or n < 1.\n    \"\"\"\n    _validate_n(n)\n    odds = _generate_odds(n)\n    result = _sum_fourth_powers(odds)\n    return result"}
{"task_id": "Mbpp/769", "solution": "def Diff(list1, list2):\n    \"\"\"Compute and return a list containing elements from list1 not present in list2.\n\n    Args:\n        list1 (list): The primary list whose elements are filtered.\n        list2 (list): The list of elements to be excluded from list1.\n\n    Returns:\n        list: Elements from list1 that are not present in list2, preserving their original order.\n    \"\"\"\n    set2 = set(list2)\n    result = [item for item in list1 if item not in set2]\n    return result"}
{"task_id": "Mbpp/771", "solution": "from typing import List\n\nclass Expression:\n    def __init__(self, raw: str):\n        self.raw: str = raw\n\n    def length(self) -> int:\n        return len(self.raw)\n\nclass Bracket:\n    def __init__(self, open_char: str, close_char: str):\n        self.open = open_char\n        self.close = close_char\n\n    def matches_closing(self, char: str) -> bool:\n        \"\"\"Checks if the given character is this bracket's corresponding closing bracket.\"\"\"\n        return char == self.close\n\n# Global mappings for bracket types and fast lookup, derived from Bracket instances.\n_BRACKET_TYPES = [\n    Bracket('(', ')'),\n    Bracket('[', ']'),\n    Bracket('{', '}'),\n]\n\n# Map opening characters to their Bracket instances for pushing onto the stack.\n_OPENING_BRACKET_MAP = {b.open: b for b in _BRACKET_TYPES}\n\n# Set of all closing characters for quick identification.\n_CLOSING_CHARS_SET = {b.close for b in _BRACKET_TYPES}\n\nclass Stack:\n    def __init__(self):\n        self._items: List[Bracket] = []\n\n    def push(self, bracket_obj: Bracket) -> None:\n        self._items.append(bracket_obj)\n\n    def pop(self) -> Bracket:\n        return self._items.pop()\n\n    def peek(self) -> Bracket:\n        if self.is_empty():\n            raise IndexError(\"peek from empty stack\")\n        return self._items[-1]\n\n    def is_empty(self) -> bool:\n        return len(self._items) == 0\n\nclass Result:\n    def __init__(self, isBalanced: bool):\n        self.isBalanced: bool = isBalanced\n\nclass ExpressionChecker:\n    @staticmethod\n    def check_expression(expression_str: str) -> bool:\n        \"\"\"\n        Performs the bracket-balance analysis using a stack.\n        \"\"\"\n        stack = Stack()\n\n        for char in expression_str:\n            if char in _OPENING_BRACKET_MAP:\n                stack.push(_OPENING_BRACKET_MAP[char])\n            elif char in _CLOSING_CHARS_SET:\n                if stack.is_empty():\n                    return False # Unbalanced: closing bracket without a matching opening bracket\n\n                last_open_bracket_obj = stack.pop()\n                if not last_open_bracket_obj.matches_closing(char):\n                    return False # Mismatched bracket types\n\n        return stack.is_empty() # True if all opening brackets were matched, False otherwise\n\ndef check_expression(expression: str) -> bool:\n    \"\"\"\n    Checks if the given expression has balanced and properly nested brackets.\n    \"\"\"\n    return ExpressionChecker.check_expression(expression)"}
{"task_id": "Mbpp/772", "solution": "from dataclasses import dataclass\nfrom typing import List\n\n@dataclass\nclass InputString:\n    raw: str\n    original_word_count: int\n\n@dataclass\nclass Word:\n    text: str\n    length: int\n\n@dataclass\nclass OutputString:\n    result: str\n    result_word_count: int\n\ndef _tokenize(input_string: str) -> List[Word]:\n    \"\"\"\n    Split input_string on any whitespace into non-empty tokens; punctuation remains part of tokens.\n    Return list of Word objects with text and length = len(text).\n    \"\"\"\n    tokens = input_string.split()\n    return [Word(text=token, length=len(token)) for token in tokens]\n\ndef _filter_tokens(words: List[Word], k: int) -> List[Word]:\n    \"\"\"\n    Return list of Word where word.length != k.\n    \"\"\"\n    return [word for word in words if word.length != k]\n\ndef _join_tokens(words: List[Word]) -> str:\n    \"\"\"\n    Join Word.text values with single spaces in original order.\n    Return '' if words is empty. Ensure no leading/trailing spaces.\n    \"\"\"\n    return \" \".join([word.text for word in words])\n\ndef remove_length(input_string, k) -> str:\n    \"\"\"\n    Public pure function.\n    Orchestrates tokenize -> filter -> join to produce the result string.\n    \"\"\"\n    words = _tokenize(input_string)\n    _ = InputString(raw=input_string, original_word_count=len(words))\n\n    filtered = _filter_tokens(words, k)\n\n    result = _join_tokens(filtered)\n\n    _ = OutputString(result=result, result_word_count=len(filtered))\n\n    return result"}
{"task_id": "Mbpp/773", "solution": "def occurance_substring(text: str, substring: str) -> tuple[str, int, int] | None:\n    \"\"\"\n    Finds the first occurrence of a substring within a string.\n    Returns a tuple (substring, start_index, end_index) or None if not found.\n    \"\"\"\n    start_index = text.find(substring)\n\n    if start_index == -1:\n        return None\n    else:\n        end_index = start_index + len(substring)\n        return (substring, start_index, end_index)"}
{"task_id": "Mbpp/775", "solution": "def _is_odd(value) -> bool:\n    \"\"\"Return True if an integer value is odd (value % 2 != 0).\"\"\"\n    return value % 2 != 0\n\ndef validate(list_of_integers) -> None:\n    \"\"\"Raise TypeError if input is not a list or contains non-int elements.\"\"\"\n    if not isinstance(list_of_integers, list):\n        raise TypeError(\"Input must be a list.\")\n    for element in list_of_integers:\n        if not isinstance(element, int):\n            raise TypeError(\"All elements in the list must be integers.\")\n\ndef check_odd_indices(list_of_integers) -> bool:\n    \"\"\"Return True if all elements at indices 1,3,5,... are odd; short-circuits to False on first even.\"\"\"\n    # Iterate through the list starting from index 1, with a step of 2, to access only odd indices.\n    for i in range(1, len(list_of_integers), 2):\n        if not _is_odd(list_of_integers[i]):\n            return False\n    return True\n\ndef odd_position(list_of_integers) -> bool:\n    \"\"\"\n    Checks if every odd index contains an odd number in the given list.\n    Raises TypeError if input is invalid.\n    \"\"\"\n    validate(list_of_integers)\n    return check_odd_indices(list_of_integers)"}
{"task_id": "Mbpp/778", "solution": "def pack_consecutive_duplicates(input_list):\n    \"\"\"\n    Packs consecutive duplicate elements of a list into sublists.\n    Returns a new list of sublists without modifying the input list.\n    \"\"\"\n    if not input_list:\n        return []\n\n    packed_list = []\n    current_sublist = [input_list[0]]\n\n    for i in range(1, len(input_list)):\n        if input_list[i] == current_sublist[-1]:\n            current_sublist.append(input_list[i])\n        else:\n            packed_list.append(current_sublist)\n            current_sublist = [input_list[i]]\n\n    packed_list.append(current_sublist)\n    return packed_list"}
{"task_id": "Mbpp/777", "solution": "def _validate_input(lst):\n    \"\"\"\n    Ensure lst is a list and every member is an int; raise TypeError on violation.\n    \"\"\"\n    if not isinstance(lst, list):\n        raise TypeError(\"Input must be a list.\")\n    for item in lst:\n        if not isinstance(item, int):\n            raise TypeError(\"All elements in the list must be integers.\")\n\ndef _has_identical_neighbor(lst, i):\n    \"\"\"\n    Return True if element at index i equals its left or right adjacent neighbor.\n    \"\"\"\n    current_value = lst[i]\n    if i > 0 and lst[i - 1] == current_value:\n        return True\n    if i < len(lst) - 1 and lst[i + 1] == current_value:\n        return True\n    return False\n\ndef find_sum(lst):\n    \"\"\"\n    Find the sum of non-repeated elements in a given list, where non-repeated means\n    without identical adjacent neighbors.\n    \"\"\"\n    _validate_input(lst)\n\n    total_sum = 0\n    if not lst:\n        return 0\n\n    for i in range(len(lst)):\n        if not _has_identical_neighbor(lst, i):\n            total_sum += lst[i]\n            \n    return total_sum"}
{"task_id": "Mbpp/781", "solution": "def count_divisors(n: int) -> bool:\n    \"\"\"\n    Counts the positive divisors of an integer n (including 1 and n)\n    and returns True if the count is even, False otherwise.\n    \"\"\"\n    divisor_count = 0\n    for i in range(1, n + 1):\n        if n % i == 0:\n            divisor_count += 1\n    return divisor_count % 2 == 0"}
{"task_id": "Mbpp/780", "solution": "from typing import List, Sequence, Tuple\n\ndef validate_input(input_list: Sequence[Tuple]) -> None:\n    \"\"\"Validate each item is a 2-element tuple and elements are numeric (int/float).\n    Raises ValueError with descriptive message on first violation.\n    \"\"\"\n    if not isinstance(input_list, (list, tuple)):\n        raise ValueError(\"Input must be a list or tuple of tuples.\")\n\n    for i, item in enumerate(input_list):\n        if not isinstance(item, tuple):\n            raise ValueError(f\"Item at index {i} is not a tuple.\")\n        if len(item) != 2:\n            raise ValueError(f\"Item at index {i} is not a 2-element tuple.\")\n        if not all(isinstance(elem, (int, float)) for elem in item):\n            raise ValueError(f\"Non-numeric element found at index {i}.\")\n\ndef compute_pairwise_sums(input_list: Sequence[Tuple[float, float]]) -> List[Tuple[float, float]]:\n    \"\"\"Compute (a_i+a_j, b_i+b_j) for each i<j and return new list ordered by indices.\"\"\"\n    result_sums: List[Tuple[float, float]] = []\n    n = len(input_list)\n    for i in range(n - 1):\n        for j in range(i + 1, n):\n            tuple1 = input_list[i]\n            tuple2 = input_list[j]\n            sum_tuple = (tuple1[0] + tuple2[0], tuple1[1] + tuple2[1])\n            result_sums.append(sum_tuple)\n    return result_sums\n\ndef find_combinations(input_list: Sequence[Tuple[float, float]]) -> List[Tuple[float, float]]:\n    \"\"\"Main API: validate input, return [] if len<2, otherwise compute and return pairwise sums.\"\"\"\n    validate_input(input_list)\n\n    if len(input_list) < 2:\n        return []\n\n    return compute_pairwise_sums(input_list)"}
{"task_id": "Mbpp/782", "solution": "from typing import List\n\ndef odd_length_sum(nums: List[int]) -> int:\n    \"\"\"Compute sum of all odd-length contiguous subarrays.\n    Aggregates the sum of elements for each subarray with an odd length.\n    \"\"\"\n    total = 0\n    n = len(nums)\n    for start in range(n):\n        for length in range(1, n - start + 1, 2):  # Iterate through odd lengths\n            end = start + length\n            total += sum(nums[start:end])\n    return total"}
