{"task_id": "Mbpp/9", "solution": "def rotateLeft(s: str, k: int) -> str:\n    \"\"\"Return the string produced by left-rotating s by k characters.\"\"\"\n    return s[k:] + s[:k]\n\ndef find_Rotations(s: str) -> int:\n    \"\"\"Return minimal positive k (1..len(s)) such that rotateLeft(s, k) == s.\n\n    Precondition: s is a non-empty string (len(s) >= 1). If precondition violated, ValueError is raised.\n    \"\"\"\n    if not isinstance(s, str) or len(s) < 1:\n        raise ValueError(\"find_Rotations precondition violated: s must be a non-empty string\")\n    n = len(s)\n    for k in range(1, n + 1):\n        if rotateLeft(s, k) == s:\n            return k\n    return n"}
{"task_id": "Mbpp/2", "solution": "def similar_elements(a, b):\n    \"\"\"\n    Return an iterable of elements that appear in both sequence inputs a and b.\n\n    Postconditions: set(similar_elements(a, b)) == set(elements common to a and b).\n    \"\"\"\n    intersection = set(a) & set(b)\n    for item in intersection:\n        yield item"}
{"task_id": "Mbpp/6", "solution": "def _count_set_bits(n: int) -> int:\n    \"\"\"Counts the number of set bits in a non-negative integer.\"\"\"\n    return bin(n).count('1')\n\ndef differ_At_One_Bit_Pos(a: int, b: int) -> bool:\n    \"\"\"Checks if two integers differ at exactly one bit position.\"\"\"\n    diff_mask = a ^ b\n    # Ensure the helper _count_set_bits receives a non-negative integer as per its design.\n    differing_bits = _count_set_bits(abs(diff_mask))\n    return differing_bits == 1"}
{"task_id": "Mbpp/7", "solution": "import re\nfrom typing import List\n\ndef find_char_long(input_string: str) -> List[str]:\n    \"\"\"\n    Finds all words in a string that are at least 4 characters long.\n    Words are split by any whitespace sequence; punctuation counts towards length.\n    \"\"\"\n    # Split the input string by one or more whitespace characters.\n    # This handles spaces, tabs, and newlines as delimiters.\n    words = re.split(r'\\s+', input_string)\n\n    # Filter the list, keeping only non-empty words that are 4 or more characters long.\n    long_words = [word for word in words if word and len(word) >= 4]\n\n    return long_words"}
{"task_id": "Mbpp/8", "solution": "def _validate_numeric_list(input_list: list) -> None:\n    \"\"\"Validates that all elements in the input list are numeric (int or float).\n    Raises TypeError if a non-numeric element is found.\n    \"\"\"\n    for i, x in enumerate(input_list):\n        if not isinstance(x, (int, float)):\n            raise TypeError(f\"Non-numeric element at index {i}: {x}\")\n\ndef square_nums(input_list: list) -> list:\n    \"\"\"Validates input_list elements are numeric, then returns a new list\n    with element-wise squares, preserving order and not mutating the input.\n    \"\"\"\n    _validate_numeric_list(input_list)\n    output = [x * x for x in input_list]\n    return output"}
{"task_id": "Mbpp/3", "solution": "import math\n\ndef is_not_prime(n: int) -> bool:\n    \"\"\"Identifies if a number is non-prime (composite, 0, 1, or negative).\"\"\"\n    # Numbers less than 2 (including 0, 1, and all negatives) are considered non-prime.\n    if n < 2:\n        return True\n\n    # Check for divisibility from 2 up to the square root of n.\n    # If any divisor is found, n is non-prime.\n    for i in range(2, int(math.sqrt(n)) + 1):\n        if n % i == 0:\n            return True\n\n    # If no divisors are found, n is prime, meaning it is NOT non-prime.\n    return False"}
{"task_id": "Mbpp/4", "solution": "import heapq\nfrom typing import List\n\nclass Number:\n    \"\"\"Wraps a single integer value.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\n    def __lt__(self, other: 'Number') -> bool:\n        \"\"\"Enables comparison of Number objects based on their value.\"\"\"\n        return self.value < other.value\n\n    def __eq__(self, other: object) -> bool:\n        \"\"\"Enables equality check for Number objects.\"\"\"\n        if not isinstance(other, Number):\n            return NotImplemented\n        return self.value == other.value\n\n    def __repr__(self) -> str:\n        return f\"Number({self.value})\"\n\nclass InputList:\n    \"\"\"Container for input numbers.\"\"\"\n    def __init__(self, numbers: List[int]) -> None:\n        self.numbers = [Number(val) for val in numbers]\n\nclass ResultList:\n    \"\"\"Container for selected Number elements.\"\"\"\n    def __init__(self, numbers: List['Number']) -> None:\n        self.numbers = numbers\n\nclass Function:\n    \"\"\"Domain operation that accepts an InputList and integer n and produces a ResultList.\"\"\"\n    def __init__(self, name: str = 'heap_queue_largest') -> None:\n        self.name = name\n\n    def execute(self, inputList: 'InputList', n: int) -> 'ResultList':\n        \"\"\"Selects the n largest integers and returns a ResultList with numbers sorted descending.\"\"\"\n        # Use heapq.nlargest to get the n largest Number objects based on their value.\n        # heapq.nlargest returns elements in ascending order of their key value.\n        n_largest_number_objects = heapq.nlargest(n, inputList.numbers, key=lambda num: num.value)\n        \n        # Sort these Number objects in descending order as required.\n        descending_number_objects = sorted(n_largest_number_objects, reverse=True)\n        \n        return ResultList(descending_number_objects)\n\ndef heap_queue_largest(input_list: List[int], n: int) -> List[int]:\n    \"\"\"\n    Public API that finds the n largest integers from a list, returned in descending order.\n    It constructs InputList, delegates to Function.execute, and returns a primitive list[int].\n    \"\"\"\n    func = Function(name='heap_queue_largest')\n    input_obj = InputList(input_list)\n    result_obj = func.execute(input_obj, n)\n    return [num.value for num in result_obj.numbers]"}
{"task_id": "Mbpp/11", "solution": "def remove_Occ(input_str: str, char: str) -> str:\n    \"\"\"\n    Removes the first and last occurrence of a given character from the string.\n    If the character appears once, it's removed once. If not found, the string is unchanged.\n    \"\"\"\n    first_idx = input_str.find(char)\n    if first_idx == -1:\n        return input_str\n\n    last_idx = input_str.rfind(char)\n\n    result_chars = []\n    for i, c in enumerate(input_str):\n        if i == first_idx:\n            # Skip the first occurrence\n            # If first_idx == last_idx, this handles the single removal\n            first_idx = -1 # Mark as skipped so it's not skipped again\n            continue\n        if i == last_idx:\n            # Only skip the last occurrence if it's distinct from the first (which it would be if first_idx was already skipped)\n            if first_idx != -1: # This means first_idx was not skipped at current 'i', so this 'i' must be the one to skip if first_idx == last_idx\n                # This condition here is tricky. Let's simplify.\n                # If first_idx and last_idx are different, we skip both.\n                # If they are the same, we skip only that one index.\n                # The first 'if' correctly handles first_idx.\n                # The second 'if' should only trigger for last_idx IF it's distinct and we are at it.\n                pass\n            else: # first_idx has already been skipped\n                continue\n        result_chars.append(c)\n    \n    # Re-thinking the skip logic for first and last, a single pass.\n    # We want to skip 'first_idx' and 'last_idx'.\n    # If first_idx == last_idx, we only skip one item.\n    \n    final_result = []\n    skipped_first = False\n    skipped_last = False\n\n    for i in range(len(input_str)):\n        if i == first_idx and not skipped_first:\n            skipped_first = True\n            continue\n        if i == last_idx and not skipped_last and last_idx != first_idx:\n            skipped_last = True\n            continue\n        final_result.append(input_str[i])\n\n    return \"\".join(final_result)"}
{"task_id": "Mbpp/17", "solution": "from typing import Any\n\nclass InputValidator:\n    \"\"\"Encapsulates numeric validation logic for inputs.\"\"\"\n    def is_numeric(self, value: Any) -> bool:\n        \"\"\"Checks if the given value is a numeric type (int or float).\"\"\"\n        return isinstance(value, (int, float))\n\nclass Square:\n    \"\"\"Domain holder for a Square value object and its side length.\"\"\"\n    def __init__(self, side_length: float):\n        self._side_length = side_length\n\n    def get_side_length(self) -> float:\n        \"\"\"Returns the side length of the square.\"\"\"\n        return self._side_length\n\nclass PerimeterCalculator:\n    \"\"\"Calculates the perimeter of a square after validating its side length.\"\"\"\n    def __init__(self, validator: InputValidator = None):\n        \"\"\"Initializes with an optional InputValidator instance.\"\"\"\n        self.validator = validator if validator is not None else InputValidator()\n\n    def square_perimeter(self, side_length: Any) -> float:\n        \"\"\"\n        Computes the perimeter of a square given its side length.\n        Raises TypeError if side_length is not numeric.\n        \"\"\"\n        if not self.validator.is_numeric(side_length):\n            raise TypeError(\"side_length must be numeric\")\n        \n        square_obj = Square(side_length)\n        return 4 * square_obj.get_side_length()\n\ndef square_perimeter(side_length: Any) -> float:\n    \"\"\"\n    Returns the perimeter of a square given its side length.\n    Delegates the calculation and validation to PerimeterCalculator.\n    \"\"\"\n    calculator = PerimeterCalculator()\n    return calculator.square_perimeter(side_length)"}
{"task_id": "Mbpp/12", "solution": "from typing import List\n\nclass Element:\n    \"\"\"Represents a single numeric element.\"\"\"\n    def __init__(self, value: float) -> None:\n        self.value = value\n\nclass Row:\n    \"\"\"Represents a single row of a matrix and computes its arithmetic sum.\"\"\"\n    def __init__(self, elements_data: List[float]) -> None:\n        self.elements: List[Element] = [Element(e) for e in elements_data]\n        # Store original data to reconstruct the output list of lists easily.\n        self._raw_elements: List[float] = elements_data\n\n    def sum(self) -> float:\n        \"\"\"Returns the arithmetic sum of the row's elements.\"\"\"\n        return float(sum(element.value for element in self.elements))\n\nclass Matrix:\n    \"\"\"Represents a matrix as a list of Row objects and provides sorting operations.\"\"\"\n    def __init__(self, rows_data: List[List[float]]) -> None:\n        self.rows: List[Row] = [Row(row_data) for row_data in rows_data]\n\n    def get_row_sums(self) -> List[float]:\n        \"\"\"Computes and returns arithmetic sums of each row in order.\"\"\"\n        return [row.sum() for row in self.rows]\n\n    def sorted(self) -> 'Matrix':\n        \"\"\"Returns a new Matrix with rows ordered ascending by row sums.\"\"\"\n        # Pair each row object with its calculated sum for sorting.\n        rows_with_sums = [(row, row.sum()) for row in self.rows]\n\n        # Sort the pairs based on the sum (the second element of the tuple).\n        sorted_rows_with_sums = sorted(rows_with_sums, key=lambda item: item[1])\n\n        # Extract the sorted Row objects.\n        sorted_row_objects = [item[0] for item in sorted_rows_with_sums]\n\n        # Reconstruct the original list-of-lists format from sorted Row objects.\n        sorted_rows_data = [row._raw_elements for row in sorted_row_objects]\n        return Matrix(sorted_rows_data)\n\nclass Sorter:\n    \"\"\"Orchestrates sorting of a matrix by row sums.\"\"\"\n    @staticmethod\n    def sort_matrix(matrix: List[List[float]]) -> List[List[float]]:\n        # Convert the input list of lists into a Matrix object for domain operations.\n        matrix_obj = Matrix(matrix)\n\n        # Get a new Matrix object with its rows sorted by their sums.\n        sorted_matrix_obj = matrix_obj.sorted()\n\n        # Convert the sorted Matrix object back to the required list of lists format.\n        result_matrix_list = [row._raw_elements for row in sorted_matrix_obj.rows]\n        return result_matrix_list\n\ndef sort_matrix(matrix: List[List[float]]) -> List[List[float]]:\n    \"\"\"Sorts a given matrix in ascending order according to the sum of its rows.\"\"\"\n    return Sorter.sort_matrix(matrix)"}
{"task_id": "Mbpp/16", "solution": "import re\n\nPATTERN = r'^[a-z]+_[a-z]+$'\n\ndef text_lowercase_underscore(input_string):\n    \"\"\"Return True iff the provided input_string (str) fully matches the anchored ASCII-lowercase + underscore + ASCII-lowercase pattern.\n\n    Raises:\n        TypeError: if input_string is not a str\n    \"\"\"\n    if not isinstance(input_string, str):\n        raise TypeError(\"input_string must be a str\")\n    match = re.fullmatch(PATTERN, input_string)\n    return bool(match)"}
{"task_id": "Mbpp/18", "solution": "from dataclasses import dataclass\n\n@dataclass\nclass SourceString:\n    value: str\n    def length(self) -> int:\n        return len(self.value)\n\n@dataclass\nclass MaskString:\n    value: str\n    def length(self) -> int:\n        return len(self.value)\n    def to_charset(self) -> 'CharacterSet':\n        return CharacterSet.from_string(self.value)\n\n@dataclass\nclass ResultString:\n    value: str\n    def length(self) -> int:\n        return len(self.value)\n\nclass CharacterSet:\n    def __init__(self, chars: set[str]):\n        self.chars = chars\n\n    def contains(self, char: str) -> bool:\n        return char in self.chars\n\n    @classmethod\n    def from_string(cls, s: str) -> 'CharacterSet':\n        return cls(set(s))\n\ndef remove_dirty_chars(source: str, mask: str) -> str:\n    \"\"\"Removes characters from the source string that are present in the mask string.\"\"\"\n    if not source:\n        return \"\"\n    if not mask:\n        return source\n\n    mask_obj = MaskString(mask)\n    dirty_chars = mask_obj.to_charset()\n    \n    result_chars_list = []\n    for char_s in source:\n        if not dirty_chars.contains(char_s):\n            result_chars_list.append(char_s)\n    \n    final_result_obj = ResultString(\"\".join(result_chars_list))\n    return final_result_obj.value"}
{"task_id": "Mbpp/14", "solution": "class TriangularPrism:\n    \"\"\"Domain model for a triangular prism; computes its volume.\"\"\"\n    def __init__(self, base, height, length):\n        self.base = base\n        self.height = height\n        self.length = length\n        self.volume = None\n\n    def computeVolume(self):\n        \"\"\"Computes and stores the volume of the triangular prism.\"\"\"\n        self.volume = 0.5 * self.base * self.height * self.length\n        return self.volume\n\ndef find_Volume(base, height, length):\n    \"\"\"Calculates the volume of a triangular prism using the TriangularPrism domain entity.\"\"\"\n    prism = TriangularPrism(float(base), float(height), float(length))\n    return prism.computeVolume()"}
{"task_id": "Mbpp/56", "solution": "def reverse(n):\n    \"\"\"\n    Reverses the base-10 digits of an integer n, dropping leading zeros.\n    The sign of the original number is preserved.\n    \"\"\"\n    sign = -1 if n < 0 else 1\n    abs_n_str = str(abs(n))\n    reversed_str = abs_n_str[::-1]\n    return sign * int(reversed_str)\n\ndef check(n):\n    \"\"\"\n    Checks if a given number n is one less than twice its reverse.\n    \"\"\"\n    reversed_n = reverse(n)\n    return n == 2 * reversed_n - 1"}
{"task_id": "Mbpp/19", "solution": "from typing import List\n\nclass Element:\n    \"\"\"Represents an integer element.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value: int = value\n\nclass IntegerArray:\n    \"\"\"A wrapper for a list of integers.\"\"\"\n    def __init__(self, elements: List[int]) -> None:\n        self.elements: List[int] = elements\n\n    def size(self) -> int:\n        return len(self.elements)\n\n    def get(self, index: int) -> int:\n        return self.elements[index]\n\nclass DuplicateDetectionResult:\n    \"\"\"Encapsulates the result of a duplicate detection.\"\"\"\n    def __init__(self, containsDuplicate: bool) -> None:\n        self.containsDuplicate: bool = containsDuplicate\n\n    def toBoolean(self) -> bool:\n        return self.containsDuplicate\n\nclass TestDuplicateFunction:\n    \"\"\"Orchestrates validation and duplicate detection for an array of integers.\"\"\"\n    def __init__(self, name: str = \"test_duplicate\") -> None:\n        pass\n\n    def validateInput(self, nums: list) -> None:\n        \"\"\"Verifies nums is a list and each element is an int. Raises TypeError on invalid input.\"\"\"\n        if not isinstance(nums, list):\n            raise TypeError(\"Input 'nums' must be a list.\")\n        for item in nums:\n            if not isinstance(item, int):\n                raise TypeError(\"All elements in 'nums' must be integers.\")\n\n    def hasDuplicates(self, nums: list) -> bool:\n        \"\"\"Detects duplicates based on integer value equality using IntegerArray.\"\"\"\n        integer_array = IntegerArray(nums)\n        seen = set()\n        for i in range(integer_array.size()):\n            element_value = integer_array.get(i)\n            if element_value in seen:\n                return True\n            seen.add(element_value)\n        return False\n\n    def test_duplicate(self, nums: list) -> bool:\n        \"\"\"Orchestrates validation and duplicate detection, returning a boolean result.\"\"\"\n        self.validateInput(nums)\n        contains_duplicate = self.hasDuplicates(nums)\n        result = DuplicateDetectionResult(contains_duplicate)\n        return result.toBoolean()\n\ndef test_duplicate(nums: List[int]) -> bool:\n    \"\"\"Checks if a list of integers contains any duplicate elements.\"\"\"\n    detector = TestDuplicateFunction()\n    return detector.test_duplicate(nums)"}
{"task_id": "Mbpp/20", "solution": "def is_woodall(n):\n    \"\"\"\n    Checks if a given number is a Woodall number.\n    A Woodall number is of the form k * 2^k - 1 for some integer k >= 1.\n    \"\"\"\n    if n < 1:\n        return False\n\n    k = 1\n    while True:\n        woodall_candidate = k * (2**k) - 1\n        if woodall_candidate == n:\n            return True\n        if woodall_candidate > n:\n            return False\n        k += 1"}
