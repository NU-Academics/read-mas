{"task_id": "Mbpp/448", "solution": "class InputParameter:\n    \"\"\"Represents and validates the input parameter n.\"\"\"\n    def __init__(self, n: int) -> None:\n        self.n = n\n\n    def validate(self) -> None:\n        \"\"\"Validates that n is a non-negative integer, raising ValueError if not.\"\"\"\n        if not isinstance(self.n, int) or self.n < 0:\n            raise ValueError(\"Input 'n' must be a non-negative integer.\")\n\nclass PerrinNumber:\n    \"\"\"Represents a single Perrin sequence term with its index and value.\"\"\"\n    def __init__(self, index: int, value: int) -> None:\n        self.index = index\n        self.value = value\n\nclass PerrinSequence:\n    \"\"\"Generates and provides access to Perrin sequence terms up to a given n.\"\"\"\n    def __init__(self) -> None:\n        self.terms: list[PerrinNumber] = []\n\n    def generate(self, n: int) -> list[PerrinNumber]:\n        \"\"\"Generates Perrin numbers P(0) through P(n) and stores them.\"\"\"\n        self.terms = [] # Reset terms for each generation call\n\n        if n >= 0:\n            self.terms.append(PerrinNumber(0, 3)) # P(0)\n        if n >= 1:\n            self.terms.append(PerrinNumber(1, 0)) # P(1)\n        if n >= 2:\n            self.terms.append(PerrinNumber(2, 2)) # P(2)\n\n        for i in range(3, n + 1):\n            p_i_minus_2 = self.terms[i-2].value\n            p_i_minus_3 = self.terms[i-3].value\n            self.terms.append(PerrinNumber(i, p_i_minus_2 + p_i_minus_3))\n        \n        return self.terms\n\n    def valueAt(self, i: int) -> int:\n        \"\"\"Returns the integer value of the Perrin number at index i.\"\"\"\n        if i < 0 or i >= len(self.terms):\n            raise IndexError(\"Perrin number index out of range.\")\n        return self.terms[i].value\n\nclass Result:\n    \"\"\"Holds the computed sum of Perrin numbers.\"\"\"\n    def __init__(self, sum_val: int) -> None:\n        self.sum = sum_val\n\ndef cal_sum(n: int) -> int:\n    \"\"\"\n    Calculates the sum of Perrin numbers from P(0) to P(n) inclusive.\n    Validates input and orchestrates sequence generation and summation.\n    \"\"\"\n    ip = InputParameter(n)\n    ip.validate()\n    \n    seq = PerrinSequence()\n    terms = seq.generate(n)\n    \n    total = sum([t.value for t in terms])\n    \n    res = Result(total)\n    return res.sum"}
{"task_id": "Mbpp/451", "solution": "class WhitespaceRemover:\n    \"\"\"A stateless class for removing whitespace characters from strings.\"\"\"\n    def remove_whitespaces(self, input: str) -> str:\n        \"\"\"\n        Removes all whitespace characters from the given string.\n        Whitespace is defined by str.isspace() semantics.\n        \"\"\"\n        result_chars = []\n        for char in input:\n            if not char.isspace():\n                result_chars.append(char)\n        return \"\".join(result_chars)\n\ndef remove_whitespaces(input: str) -> str:\n    \"\"\"\n    Removes all whitespace characters from the given string.\n    This function delegates the actual removal to a WhitespaceRemover instance.\n    \"\"\"\n    remover = WhitespaceRemover()\n    return remover.remove_whitespaces(input)"}
{"task_id": "Mbpp/454", "solution": "import re\nfrom typing import List, Optional\n\nclass TextInput:\n    \"\"\"Holds raw input and exposes normalize() and tokenize().\"\"\"\n    def __init__(self, rawText: str, received_at: Optional[float] = None) -> None:\n        self._rawText = rawText\n\n    def normalize(self) -> str:\n        \"\"\"Returns normalized form for tokenization (leaves case as-is).\"\"\"\n        return self._rawText\n\n    def tokenize(self) -> List['Word']:\n        \"\"\"Splits normalized text into Word tokens, treating punctuation and whitespace as separators.\"\"\"\n        words_found = re.findall(r'[a-zA-Z0-9]+', self.normalize())\n        token_list: List[Word] = []\n        for i, word_text in enumerate(words_found):\n            token_list.append(Word(word_text, i))\n        return token_list\n\nclass Word:\n    \"\"\"Represents a token and provides token-level checks.\"\"\"\n    def __init__(self, text: str, position: int) -> None:\n        self._text = text\n        self._position = position\n\n    def isAlphabetic(self) -> bool:\n        \"\"\"True if token is alphabetic.\"\"\"\n        return self._text.isalpha()\n\n    def containsZ(self) -> bool:\n        \"\"\"True if token contains lowercase 'z' (design default).\"\"\"\n        return 'z' in self._text\n\nclass MatchResult:\n    \"\"\"Value object carrying containsZWord boolean.\"\"\"\n    def __init__(self, containsZWord: bool) -> None:\n        self._contains_z = containsZWord\n\ndef text_match_wordz(text: str) -> bool:\n    \"\"\"\n    Checks if the input text contains at least one word with the character 'z'.\n    Non-string, empty, or None inputs return False.\n    \"\"\"\n    if not isinstance(text, str):\n        return False\n    if not text:\n        return False\n\n    text_input = TextInput(text)\n    words = text_input.tokenize()\n\n    for word in words:\n        if word.containsZ():\n            return True\n\n    return False"}
