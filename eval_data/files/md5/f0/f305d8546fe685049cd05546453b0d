{"task_id": "Mbpp/784", "solution": "from typing import List, Iterator\n\nclass InputList:\n    \"\"\"Represents the input list of integer values.\"\"\"\n    def __init__(self, items: List[int]) -> None:\n        self.items = items\n\n    def __iter__(self) -> Iterator[int]:\n        return iter(self.items)\n\nclass ListItem:\n    \"\"\"Represents a single list element with parity helper methods.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\n    def is_even(self) -> bool:\n        return self.value % 2 == 0\n\n    def is_odd(self) -> bool:\n        return self.value % 2 != 0\n\nclass ProductResult:\n    \"\"\"Represents the numeric product.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\nclass MulEvenOdd:\n    \"\"\"Implements the core algorithm to find and multiply first even and odd numbers.\"\"\"\n    def mul_even_odd(self, input_list: InputList) -> int:\n        first_odd = None\n        first_even = None\n\n        for item_value in input_list:\n            if first_odd is None and ListItem(item_value).is_odd():\n                first_odd = item_value\n            if first_even is None and ListItem(item_value).is_even():\n                first_even = item_value\n            \n            if first_odd is not None and first_even is not None:\n                break\n\n        if first_odd is None or first_even is None:\n            raise ValueError(\"missing odd or even value in input list\")\n        \n        product = first_odd * first_even\n        return ProductResult(product).value\n\ndef mul_even_odd(input_list: List[int]) -> int:\n    \"\"\"\n    Finds the product of the first even and first odd number in a list.\n    Raises ValueError if either parity is missing in the input list.\n    \"\"\"\n    domain_input_list = InputList(input_list)\n    return MulEvenOdd().mul_even_odd(domain_input_list)"}
{"task_id": "Mbpp/785", "solution": "class ParseError(Exception):\n    \"\"\"Internal exception for parsing failures.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\n\nclass IntegerTuple:\n    \"\"\"Domain value object holding integer elements and converting to a Python tuple.\"\"\"\n    def __init__(self, elements: list[int]):\n        self._elements = elements\n\n    def to_tuple(self) -> tuple:\n        return tuple(self._elements)\n\nclass Tokenizer:\n    \"\"\"Tokenizes the parenthesized payload into candidate string tokens separated by commas.\"\"\"\n    def tokenize(self, raw: str) -> list[str]:\n        # raw is the inner payload (without surrounding parentheses).\n        # Split by comma: parts = raw.split(',')\n        parts = raw.split(',')\n        # Detect empty tokens produced by consecutive commas, or leading/trailing comma, or empty payload\n        if any(part == '' for part in parts):\n            raise ParseError(\"empty token\")\n        # Return parts (not yet trimmed).\n        return parts\n\nclass TupleStringParser:\n    \"\"\"Orchestrates trimming, parenthesis check, tokenization, normalization, integer conversion and building IntegerTuple.\"\"\"\n    def __init__(self):\n        self._tokenizer = Tokenizer()\n\n    def _check_parens(self, raw: str) -> str:\n        \"\"\"Checks for leading '(' and trailing ')', returns inner payload or raises ParseError.\"\"\"\n        if not raw.startswith('(') or not raw.endswith(')'):\n            raise ParseError(\"missing parentheses\")\n        return raw[1:-1]\n\n    def parse(self, raw: str) -> IntegerTuple:\n        # 1. Trim outer whitespace\n        trimmed = raw.strip()\n\n        # 2. Check leading '(' and trailing ')' and extract inner payload\n        inner_payload = self._check_parens(trimmed)\n\n        # Handle empty tuple case '()'\n        if not inner_payload.strip():\n            return IntegerTuple([])\n\n        # 3. tokens = self._tokenizer.tokenize(inner_payload)  # raw tokens\n        tokens = self._tokenizer.tokenize(inner_payload)\n\n        # 4. normalized = [t.strip() for t in tokens]\n        normalized = [t.strip() for t in tokens]\n\n        # 5. If any normalized token == '' -> raise ParseError(\"empty token\")\n        if any(not token for token in normalized):\n            raise ParseError(\"empty token\")\n\n        # 6. Convert to integers\n        ints = []\n        for t in normalized:\n            try:\n                v = int(t)\n            except ValueError:\n                raise ParseError(f\"non-integer token: {t}\")\n            ints.append(v)\n\n        # 7. return IntegerTuple(ints)\n        return IntegerTuple(ints)\n\ndef tuple_str_int(raw: str) -> tuple:\n    \"\"\"\n    Converts a tuple string (e.g., \"(7, 8, 9)\") to an integer tuple (e.g., (7, 8, 9)).\n    Raises ValueError on parse failure.\n    \"\"\"\n    parser = TupleStringParser()\n    try:\n        integer_tuple = parser.parse(raw)\n    except ParseError as e:\n        raise ValueError(str(e)) from e\n    return integer_tuple.to_tuple()"}
