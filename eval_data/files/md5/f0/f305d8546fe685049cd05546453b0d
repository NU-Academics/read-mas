{"task_id": "Mbpp/126", "solution": "class IntegerInput:\n    \"\"\"Helper class to encapsulate integer input validation.\"\"\"\n    def __init__(self, value):\n        self.value = value\n\n    def is_valid(self) -> bool:\n        \"\"\"Checks if the encapsulated value is an integer.\"\"\"\n        return isinstance(self.value, int)\n\nclass Divisor:\n    \"\"\"Helper class to represent a divisor and check divisibility.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def divides(self, x: int) -> bool:\n        \"\"\"Checks if this divisor's value divides a given number x.\"\"\"\n        if self.value == 0: # A non-zero x cannot be divided by 0. 0 % 0 is undefined, but for common divisors, we assume positive divisors.\n            return x == 0\n        return x % self.value == 0\n\nclass CommonDivisorsCalculator:\n    \"\"\"Calculates common divisors and their sum for two numbers.\"\"\"\n    def __init__(self, a: int, b: int):\n        self.a = a\n        self.b = b\n\n    def validate(self) -> None:\n        \"\"\"Validates inputs for type and specific zero conditions.\"\"\"\n        if not IntegerInput(self.a).is_valid() or not IntegerInput(self.b).is_valid():\n            raise TypeError(\"Both inputs must be integers.\")\n        if self.a == 0 and self.b == 0:\n            raise ValueError(\"Both inputs cannot be zero.\")\n\n    def get_common_divisors(self) -> list[int]:\n        \"\"\"Computes a list of positive common divisors for self.a and self.b.\"\"\"\n        common_divs = []\n\n        # Determine the upper bound for divisor candidates.\n        # If one number is zero, common divisors are positive divisors of the non-zero number.\n        if self.a == 0 and self.b == 0:\n            return [] # This case is typically caught by validate(), but defensively handled.\n        elif self.a == 0:\n            upper_bound = abs(self.b)\n        elif self.b == 0:\n            upper_bound = abs(self.a)\n        else:\n            upper_bound = min(abs(self.a), abs(self.b))\n\n        # If upper_bound is 0 (e.g., after abs(0)), there are no positive divisors.\n        if upper_bound == 0:\n            return []\n\n        for i in range(1, upper_bound + 1):\n            d_obj = Divisor(i)\n            if d_obj.divides(self.a) and d_obj.divides(self.b):\n                common_divs.append(i)\n        return common_divs\n\n    def compute_sum(self) -> int:\n        \"\"\"Returns the sum of the positive common divisors.\"\"\"\n        return sum(self.get_common_divisors())\n\ndef sum(a, b):\n    \"\"\"\n    Finds the sum of common divisors of two given numbers.\n    Inputs are validated for type and zero conditions.\n    \"\"\"\n    calc = CommonDivisorsCalculator(a, b)\n    calc.validate()\n    return calc.compute_sum()"}
{"task_id": "Mbpp/130", "solution": "from typing import Any, List, Dict, Optional\n\nclass Item:\n    \"\"\"Lightweight wrapper for an element value.\"\"\"\n    def __init__(self, value: Any):\n        self.value = value\n\n    def __repr__(self) -> str:\n        return f\"Item({self.value!r})\"\n\nclass InputList:\n    \"\"\"Encapsulate the input Python list.\"\"\"\n    def __init__(self, items: List[Any]):\n        self.items = items\n\n    def length(self) -> int:\n        return len(self.items)\n\nclass FrequencyMap:\n    \"\"\"Maintain counts of distinct items.\"\"\"\n    def __init__(self):\n        self._counts: Dict[Any, int] = {}\n\n    def increment(self, item: Item) -> None:\n        \"\"\"Increments the count for the given item's value.\"\"\"\n        self._counts[item.value] = self._counts.get(item.value, 0) + 1\n\n    def get_count(self, item: Item) -> int:\n        \"\"\"Returns the count for the given item's value.\"\"\"\n        return self._counts.get(item.value, 0)\n\n    def get_max(self) -> Item:\n        \"\"\"Finds and returns an Item with the maximum frequency.\"\"\"\n        if not self._counts:\n            # This should not be reached if max_occurrences handles empty input.\n            raise ValueError(\"FrequencyMap is empty, cannot get max item.\")\n\n        max_item_value: Any = None\n        max_frequency: int = -1\n\n        for value, count in self._counts.items():\n            if count > max_frequency:\n                max_frequency = count\n                max_item_value = value\n        \n        return Item(max_item_value)\n\nclass MaxOccurrencesFunction:\n    \"\"\"Orchestrate counting and selection.\"\"\"\n    def compute(self, items: List[Any]) -> Any:\n        \"\"\"\n        Computes the item with the maximum frequency from the list.\n        Delegates to FrequencyMap for counting and finding the max.\n        \"\"\"\n        freq_map = FrequencyMap()\n        for item_value in items:\n            freq_map.increment(Item(item_value))\n\n        max_item = freq_map.get_max()\n        return max_item.value\n\nclass Output:\n    \"\"\"Conceptual wrapper for the result item.\"\"\"\n    def __init__(self, item: Item):\n        self.item = item\n\ndef max_occurrences(items: list) -> Any:\n    \"\"\"\n    Finds the item with maximum frequency in a given list.\n    Raises ValueError if the input list is empty.\n    \"\"\"\n    if not items:\n        raise ValueError(\"Input list cannot be empty.\")\n\n    max_func = MaxOccurrencesFunction()\n    return max_func.compute(items)"}
{"task_id": "Mbpp/128", "solution": "import re\n\ndef validateInput(n, input):\n    \"\"\"Validates input types for n and the words list/string, raising TypeError on violations.\"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer.\")\n    \n    if not isinstance(input, (str, list)):\n        raise TypeError(\"Input must be a string or a list of strings.\")\n    \n    if isinstance(input, list):\n        for i, element in enumerate(input):\n            if not isinstance(element, str):\n                raise TypeError(f\"List element at index {i} is not a string.\")\n\ndef splitString(s):\n    \"\"\"Splits a string by one or more whitespace characters and filters out empty tokens.\"\"\"\n    tokens = re.split(r'\\s+', s)\n    return [token for token in tokens if token]\n\ndef filterWords(n, candidates):\n    \"\"\"Filters a list of candidate words, keeping only those strictly longer than n characters.\"\"\"\n    return [word for word in candidates if len(word) > n]\n\ndef long_words(n, input):\n    \"\"\"\n    Finds words longer than n characters from a given list of words or a string.\n    The input can be a string (whitespace-separated words) or a list of strings.\n    \"\"\"\n    validateInput(n, input)\n    \n    candidates = []\n    if isinstance(input, str):\n        candidates = splitString(input)\n    else: \n        # input is a list, and validateInput has already ensured it contains only strings\n        candidates = input\n        \n    return filterWords(n, candidates)"}
{"task_id": "Mbpp/131", "solution": "from dataclasses import dataclass\n\n@dataclass\nclass InputString:\n    value: str\n    def length(self) -> int:\n        \"Return the length of the input string.\"\n        return len(self.value)\n\n@dataclass\nclass ResultString:\n    value: str\n\nclass VowelPool:\n    \"Vowel lookup per SRS: vowels = {a,e,i,o,u,A,E,I,O,U}; 'y' not a vowel.\"\n    vowels: set[str]\n\n    def __init__(self) -> None:\n        # initialize the set of vowel characters\n        self.vowels = {'a', 'e', 'i', 'o', 'u', 'A', 'E', 'I', 'O', 'U'}\n\n    def is_vowel(self, c: str) -> bool:\n        \"Return True if c is a vowel per SRS; False otherwise.\"\n        return c in self.vowels\n\ndef reverse_vowels(input: str) -> str:\n    \"Public API implementing FR-1..FR-7.\n    Reverses only vowel characters' relative order; non-vowel characters remain at original indices.\"\n    \n    if not input:\n        return \"\"\n\n    input_obj = InputString(value=input)\n    vowel_pool = VowelPool()\n\n    vowel_indices = []\n    vowel_chars = []\n\n    for i in range(input_obj.length()):\n        char = input_obj.value[i]\n        if vowel_pool.is_vowel(char):\n            vowel_indices.append(i)\n            vowel_chars.append(char)\n\n    if len(vowel_chars) <= 1:\n        return input\n\n    reversed_vowels = vowel_chars[::-1]\n\n    result_list = list(input_obj.value)\n    vowel_idx_in_reversed_list = 0\n    for original_index in vowel_indices:\n        result_list[original_index] = reversed_vowels[vowel_idx_in_reversed_list]\n        vowel_idx_in_reversed_list += 1\n    \n    final_result_str = \"\".join(result_list)\n    return ResultString(value=final_result_str).value"}
{"task_id": "Mbpp/129", "solution": "class Row:\n    \"\"\"Lightweight wrapper for a row; provides sum().\"\"\"\n    def __init__(self, values: list[int], index: int) -> None:\n        self.values = values\n        self.index = index\n\n    def sum(self) -> int:\n        \"\"\"Returns the sum of elements in the row.\"\"\"\n        return sum(self.values)\n\nclass Column:\n    \"\"\"Lightweight wrapper for a column; provides sum().\"\"\"\n    def __init__(self, values: list[int], index: int) -> None:\n        self.values = values\n        self.index = index\n\n    def sum(self) -> int:\n        \"\"\"Returns the sum of elements in the column.\"\"\"\n        return sum(self.values)\n\nclass Matrix:\n    \"\"\"Represents the input matrix and provides methods for size and sum calculations.\"\"\"\n    def __init__(self, values: list[list[int]]) -> None:\n        self.values = values\n        self.size = len(values)\n\n    def is_square(self) -> bool:\n        \"\"\"Checks if the matrix is non-empty and square.\"\"\"\n        if self.size == 0:\n            return False  # FR4: non-empty\n        \n        # Check if all rows have the same length as the number of rows\n        for row in self.values:\n            if len(row) != self.size:\n                return False\n        return True\n\n    def row_sum(self, index: int) -> int:\n        \"\"\"Calculates the sum of elements in a specific row using the Row helper.\"\"\"\n        return Row(self.values[index], index).sum()\n\n    def col_sum(self, index: int) -> int:\n        \"\"\"Calculates the sum of elements in a specific column using the Column helper.\"\"\"\n        # Extract column values to create a Column object\n        column_values = [self.values[r_idx][index] for r_idx in range(self.size)]\n        return Column(column_values, index).sum()\n\n    def primary_diagonal_sum(self) -> int:\n        \"\"\"Calculates the sum of elements in the primary diagonal (top-left to bottom-right).\"\"\"\n        diag_sum = 0\n        for i in range(self.size):\n            diag_sum += self.values[i][i]\n        return diag_sum\n\n    def secondary_diagonal_sum(self) -> int:\n        \"\"\"Calculates the sum of elements in the secondary diagonal (top-right to bottom-left).\"\"\"\n        diag_sum = 0\n        for i in range(self.size):\n            diag_sum += self.values[i][self.size - 1 - i]\n        return diag_sum\n\nclass MagicSquareTest:\n    \"\"\"Orchestrates validation and checks for a magic square.\"\"\"\n    def __init__(self) -> None:\n        self._target_sum: int = 0\n\n    def _validate_shape(self, matrix: list[list[int]]) -> bool:\n        \"\"\"Checks if the raw input matrix is non-empty and square.\"\"\"\n        if not matrix:  # FR4: non-empty\n            return False\n        \n        n = len(matrix)\n        for row in matrix:\n            if len(row) != n:  # FR4: square\n                return False\n        return True\n\n    def _compute_target(self, matrix_obj: Matrix) -> int:\n        \"\"\"Computes the target sum from the first row of the matrix.\"\"\"\n        return matrix_obj.row_sum(0)\n\n    def _check_rows(self, matrix_obj: Matrix, target: int) -> bool:\n        \"\"\"Verifies if every row's sum equals the target sum.\"\"\"\n        for i in range(matrix_obj.size):\n            if matrix_obj.row_sum(i) != target:\n                return False\n        return True\n\n    def _check_columns(self, matrix_obj: Matrix, target: int) -> bool:\n        \"\"\"Verifies if every column's sum equals the target sum.\"\"\"\n        for i in range(matrix_obj.size):\n            if matrix_obj.col_sum(i) != target:\n                return False\n        return True\n\n    def _check_diagonals(self, matrix_obj: Matrix, target: int) -> bool:\n        \"\"\"Verifies if both primary and secondary diagonal sums equal the target sum.\"\"\"\n        if matrix_obj.primary_diagonal_sum() != target:\n            return False\n        \n        if matrix_obj.secondary_diagonal_sum() != target:\n            return False\n        \n        return True\n\n    def magic_square_test(self, matrix: list[list[int]]) -> bool:\n        \"\"\"Evaluates whether the given matrix is a magic square.\"\"\"\n        if not self._validate_shape(matrix):\n            return False\n\n        matrix_obj = Matrix(matrix)\n        \n        self._target_sum = self._compute_target(matrix_obj)\n        \n        if not self._check_rows(matrix_obj, self._target_sum):\n            return False\n            \n        if not self._check_columns(matrix_obj, self._target_sum):\n            return False\n            \n        if not self._check_diagonals(matrix_obj, self._target_sum):\n            return False\n            \n        return True\n\ndef magic_square_test(matrix: list[list[int]]) -> bool:\n    \"\"\"\n    Calculates whether the given matrix is a magic square.\n    A magic square is a square matrix where the sum of numbers in each row,\n    each column, and both main diagonals is the same.\n    \"\"\"\n    evaluator = MagicSquareTest()\n    return evaluator.magic_square_test(matrix)"}
