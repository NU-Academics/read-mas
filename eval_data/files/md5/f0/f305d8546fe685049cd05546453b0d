{"task_id": "Mbpp/412", "solution": "class Integer:\n    \"\"\"Encapsulates an integer value and provides an evenness check.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\n    def is_even(self) -> bool:\n        \"\"\"Returns True if the encapsulated integer is even, False otherwise.\"\"\"\n        return self.value % 2 == 0\n\nclass IntegerList:\n    \"\"\"Validates if a list contains only integers.\"\"\"\n    def __init__(self, items: list) -> None:\n        self.items = items\n\n    def validate(self) -> bool:\n        \"\"\"Raises TypeError if items is not a list or contains non-integer elements.\"\"\"\n        if not isinstance(self.items, list):\n            raise TypeError(\"Input must be a list.\")\n        for item in self.items:\n            if not isinstance(item, int):\n                raise TypeError(\"All elements in the list must be integers.\")\n        return True\n\ndef is_even(n: int) -> bool:\n    \"\"\"Returns True if an integer is even, False otherwise.\"\"\"\n    return n % 2 == 0\n\ndef remove_odd(items: list) -> list:\n    \"\"\"\n    Removes odd numbers from a given list of integers, returning a new list.\n    Validates input type and elements.\n    \"\"\"\n    integer_list_validator = IntegerList(items)\n    integer_list_validator.validate()\n\n    result = []\n    for item in items:\n        if Integer(item).is_even():\n            result.append(item)\n    return result"}
{"task_id": "Mbpp/414", "solution": "def overlapping(seq1, seq2) -> bool:\n    \"\"\"Return True if any element from seq1 exists in seq2, otherwise False.\n    Returns False if either sequence is empty and does not modify inputs.\n    \"\"\"\n    if not seq1 or not seq2:\n        return False\n\n    # Convert seq2 to a set for efficient O(1) average time complexity membership checks.\n    # This creates a temporary structure and leaves the original sequences unmodified.\n    set2 = set(seq2)\n    for item in seq1:\n        if item in set2:\n            return True\n    return False"}
{"task_id": "Mbpp/415", "solution": "from typing import List, Tuple\n\ndef _sorted_pair(a: int, b: int) -> Tuple[int, int]:\n    \"\"\"Returns a tuple with two integers sorted in ascending order.\"\"\"\n    return (min(a, b), max(a, b))\n\ndef _compute_candidates(input_list: List[int]) -> Tuple[int, int]:\n    \"\"\"\n    Computes the pair of integers from the list that yields the maximal product,\n    applying a deterministic tie-breaker as described in max_Product's docstring.\n    \"\"\"\n    best_a, best_b = input_list[0], input_list[1]\n    max_product = best_a * best_b\n\n    n = len(input_list)\n    for i in range(n):\n        for j in range(i + 1, n):\n            current_a, current_b = input_list[i], input_list[j]\n            current_product = current_a * current_b\n\n            if current_product > max_product:\n                max_product = current_product\n                best_a, best_b = current_a, current_b\n            elif current_product == max_product:\n                # Apply deterministic tie-breaker based on lexicographical order of sorted pairs.\n                current_best_pair_sorted = _sorted_pair(best_a, best_b)\n                new_candidate_pair_sorted = _sorted_pair(current_a, current_b)\n\n                if new_candidate_pair_sorted < current_best_pair_sorted:\n                    best_a, best_b = current_a, current_b\n    return (best_a, best_b)\n\ndef max_Product(input_list: List[int]) -> Tuple[int, int]:\n    \"\"\"\n    Finds a pair of integers from a given array with the highest product.\n\n    Raises:\n        ValueError: If `input_list` contains fewer than two integers.\n\n    Tie-breaker rule:\n        When multiple unordered pairs yield the same maximal product, the pair\n        whose sorted representation has the smallest first element is chosen.\n        If still tied, the pair with the smallest second element is chosen.\n    \"\"\"\n    if len(input_list) < 2:\n        raise ValueError(\"input_list must contain at least two integers\")\n\n    a, b = _compute_candidates(input_list)\n    return _sorted_pair(a, b)"}
{"task_id": "Mbpp/418", "solution": "class LengthCalculator:\n    @staticmethod\n    def len(obj) -> int:\n        \"\"\"\n        Return built-in len(obj); propagate TypeError if obj does not support len().\n        \"\"\"\n        return len(obj)\n\nclass Element:\n    def __init__(self, value):\n        self.value = value\n        self.length: int = None\n\n    def compute_length(self) -> int:\n        \"\"\"Computes and stores the length of the element's value.\"\"\"\n        self.length = LengthCalculator.len(self.value)\n        return self.length\n\nclass InputList:\n    def __init__(self, elements: list):\n        self.elements: list = elements\n\n    def validate_elements_support_len(self) -> None:\n        \"\"\"Ensures each element supports len(); allows TypeError to propagate.\"\"\"\n        pass\n\ndef Find_Max(input_list):\n    \"\"\"\n    Accepts exactly one list argument and returns an element with maximum len().\n    \"\"\"\n    input_list_obj = InputList(input_list)\n    input_list_obj.validate_elements_support_len()\n\n    max_length = -1\n    max_element = None\n\n    for value in input_list_obj.elements:\n        e = Element(value)\n        current_length = e.compute_length()\n\n        if current_length > max_length:\n            max_length = current_length\n            max_element = value\n            \n    return max_element"}
{"task_id": "Mbpp/420", "solution": "class InputValidator:\n    \"\"\"Validates input n for the cube_Sum calculation.\"\"\"\n    def is_valid(self, n: int) -> bool:\n        \"\"\"Checks if n is a valid integer (n >= 1).\"\"\"\n        return isinstance(n, int) and n >= 1\n\nclass CubeCalculator:\n    \"\"\"Calculates the sum of cubes using a closed-form formula.\"\"\"\n    def compute_sum_formula(self, n: int) -> int:\n        \"\"\"Computes 2 * n^2 * (n+1)^2 for the sum of cubes.\"\"\"\n        return 2 * n * n * (n + 1) * (n + 1)\n\n    def cube_Sum(self, n: int) -> int:\n        \"\"\"Delegates to the formula computation and returns the integer result.\"\"\"\n        result_value = self.compute_sum_formula(n)\n        return int(result_value)\n\n# The EvenNumber and Result classes are described in the design but their direct\n# instantiation is not required for the implementation of the main cube_Sum function,\n# which directly returns an integer result from the calculator.\n\ndef cube_Sum(n):\n    \"\"\"\n    Finds the cube sum of the first n even natural numbers using a closed-form formula.\n    Raises ValueError if n is not an integer or is less than 1.\n    \"\"\"\n    validator = InputValidator()\n    if not validator.is_valid(n):\n        raise ValueError(\"n must be an integer >= 1\")\n    calculator = CubeCalculator()\n    result_value = calculator.cube_Sum(n)\n    return int(result_value)"}
{"task_id": "Mbpp/419", "solution": "def _bankers_round(value: float) -> int:\n    \"\"\"Applies round-half-to-even (banker's rounding) to a float.\"\"\"\n    return round(value)\n\ndef round_and_sum(numbers: list) -> int:\n    \"\"\"\n    Rounds numbers in a list using banker's rounding, sums them,\n    multiplies by list length, prints, and returns the product.\n    \"\"\"\n    rounded_numbers = []\n    for num in numbers:\n        rounded_numbers.append(_bankers_round(num))\n\n    sum_rounded = sum(rounded_numbers)\n    list_length = len(numbers)\n\n    product = sum_rounded * list_length\n\n    print(product)\n    return product"}
