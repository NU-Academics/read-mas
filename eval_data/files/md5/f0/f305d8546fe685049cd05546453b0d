{"task_id": "Mbpp/277", "solution": "class Validation:\n    \"\"\"Helper for validating types of n and dictionary values.\"\"\"\n    @staticmethod\n    def validate_types(inputDict, n):\n        if not isinstance(n, int):\n            raise TypeError(\"n must be int\")\n        for value in inputDict.values():\n            if not isinstance(value, int):\n                raise TypeError(\"all dictionary values must be int\")\n\nclass Dictionary:\n    \"\"\"A lightweight wrapper around a native dict to provide entry access.\"\"\"\n    def __init__(self, entries: dict):\n        self._entries = entries\n\n    def get_entries(self) -> list[tuple[str, int]]:\n        return list(self._entries.items())\n\ndef dict_filter(inputDict, n):\n    \"\"\"Filter inputDict to entries whose values are >= n and return a new dict.\n    Preconditions: n and all values in inputDict are ints (Validation enforces this).\n    \"\"\"\n    Validation.validate_types(inputDict, n)\n    dict_obj = Dictionary(inputDict)\n    out = {}\n    for key, value in dict_obj.get_entries():\n        if value >= n:\n            out[key] = value\n    return out"}
{"task_id": "Mbpp/278", "solution": "def count_first_elements(input: tuple) -> int:\n    \"\"\"\n    Counts the number of top-level elements that occur before the first top-level element that is itself a tuple.\n    \"\"\"\n    count = 0\n    for element in input:\n        if isinstance(element, tuple):\n            return count\n        count += 1\n    return count"}
{"task_id": "Mbpp/281", "solution": "def all_unique(input_list):\n    \"\"\"\n    Checks if all elements in the given list are unique, supporting both hashable and unhashable types.\n    Raises TypeError if the input is not a list.\n    \"\"\"\n    if not isinstance(input_list, list):\n        raise TypeError(\"input_list must be a list\")\n\n    seen_hashable = set()\n    seen_unhashable = []\n\n    for item in input_list:\n        try:\n            if item in seen_hashable:\n                return False\n            seen_hashable.add(item)\n        except TypeError: # Item is unhashable\n            for prev_unhashable_item in seen_unhashable:\n                if prev_unhashable_item == item:\n                    return False\n            seen_unhashable.append(item)\n\n    return True"}
