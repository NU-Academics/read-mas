{"task_id": "Mbpp/633", "solution": "```python\ndef pair_xor_Sum(values: list[int], n: int) -> int:\n    \"\"\"\n    Computes the sum of bitwise XORs for all unordered pairs (i < j) among the\n    first n elements of the input list `values`.\n    Clamps n to len(values) if n exceeds the list length, and returns 0 if n <= 1.\n    \"\"\"\n    total_xor_sum = 0\n    \n    # Clamp n to the actual length of the values list if it exceeds it.\n    # If n is less than or equal to 1, there are no pairs, so the sum is 0.\n    effective_n = min(n, len(values))\n    if effective_n <= 1:\n        return 0\n\n    for i in range(effective_n):\n        for j in range(i + 1, effective_n):\n            total_xor_sum += (values[i] ^ values[j])\n            \n    return total_xor_sum\n```"}
{"task_id": "Mbpp/631", "solution": "def replace_spaces(input: str) -> str:\n    \"\"\"\n    Replaces spaces with underscores and vice versa in a given string.\n    Other characters are preserved.\n    \"\"\"\n    char_buffer = []\n    for char in input:\n        if char == ' ':\n            char_buffer.append('_')\n        elif char == '_':\n            char_buffer.append(' ')\n        else:\n            char_buffer.append(char)\n    return \"\".join(char_buffer)"}
{"task_id": "Mbpp/630", "solution": "ValidationError = TypeError\n\nclass Coordinate:\n    \"\"\"\n    A domain value object representing a 2D coordinate (x, y).\n    Provides conversion to a native list format.\n    \"\"\"\n    def __init__(self, x: int, y: int) -> None:\n        self.x = x\n        self.y = y\n\n    def to_list(self) -> list:\n        \"\"\"\n        Converts the coordinate to a native list [x, y].\n        \"\"\"\n        return [self.x, self.y]\n\nclass CoordinateList:\n    \"\"\"\n    An aggregated container for multiple Coordinate objects.\n    Provides methods for size and conversion to a native list of lists.\n    \"\"\"\n    def __init__(self, coordinates: list) -> None:\n        self.coordinates = coordinates\n\n    def size(self) -> int:\n        \"\"\"\n        Returns the number of coordinates in the list.\n        \"\"\"\n        return len(self.coordinates)\n\n    def to_native_list(self) -> list:\n        \"\"\"\n        Converts the list of Coordinate objects to a native list of 2-element lists.\n        \"\"\"\n        return [coord.to_list() for coord in self.coordinates]\n\nclass CoordinateService:\n    \"\"\"\n    A stateless service for validating coordinates, computing adjacent grids,\n    and formatting results.\n    \"\"\"\n    def get_coordinates(self, coordinate: tuple) -> list:\n        \"\"\"\n        Validates the input coordinate, computes its 3x3 adjacent grid,\n        and returns it as a native list of 2-element lists.\n        \"\"\"\n        x, y = self._validate_coordinate(coordinate)\n        grid_coordinates = self._compute_grid(x, y)\n        coord_list_container = CoordinateList(grid_coordinates)\n        return coord_list_container.to_native_list()\n\n    def _validate_coordinate(self, coordinate: tuple) -> tuple[int, int]:\n        \"\"\"\n        Validates that the input is a tuple of two integers.\n        Raises ValidationError if validation fails.\n        \"\"\"\n        if not isinstance(coordinate, tuple):\n            raise ValidationError(\"Input must be a tuple.\")\n        if len(coordinate) != 2:\n            raise ValidationError(\"Coordinate tuple must contain exactly two elements.\")\n        x, y = coordinate\n        if not all(isinstance(val, int) for val in [x, y]):\n            raise ValidationError(\"Coordinate elements must be integers.\")\n        return x, y\n\n    def _compute_grid(self, x: int, y: int) -> list[Coordinate]:\n        \"\"\"\n        Computes the 3x3 grid of adjacent coordinates around (x, y)\n        in row-major order, returning them as a list of Coordinate objects.\n        \"\"\"\n        grid = []\n        for dx in [-1, 0, 1]:\n            for dy in [-1, 0, 1]:\n                grid.append(Coordinate(x + dx, y + dy))\n        return grid\n\ndef get_coordinates(coordinate) -> list:\n    \"\"\"\n    Extracts all adjacent coordinates of the given coordinate tuple.\n    \"\"\"\n    service = CoordinateService()\n    return service.get_coordinates(coordinate)"}
{"task_id": "Mbpp/632", "solution": "def move_zero(input_list: list) -> list:\n    \"\"\"Return a new list with zeros moved to the end, preserving order and counts.\"\"\"\n    non_zeros = []\n    zero_count = 0\n    for item in input_list:\n        if item == 0:\n            zero_count += 1\n        else:\n            non_zeros.append(item)\n    non_zeros.extend([0] * zero_count)\n    return non_zeros"}
