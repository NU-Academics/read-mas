{"task_id": "Mbpp/234", "solution": "from dataclasses import dataclass\nfrom typing import Union\n\nNumber = Union[int, float]\n\n@dataclass\nclass Cube:\n    side_length: float\n\n@dataclass\nclass VolumeResult:\n    value: float\n\nclass VolumeCalculator:\n    def volume_cube(self, side_length: Number) -> Number:\n        \"\"\"Compute and return side_length ** 3 as numeric value.\"\"\"\n        return side_length ** 3\n\ndef volume_cube(side_length: Number) -> Number:\n    \"\"\"Public API to calculate the volume of a cube.\"\"\"\n    calculator = VolumeCalculator()\n    return calculator.volume_cube(side_length)"}
{"task_id": "Mbpp/233", "solution": "import math\nfrom dataclasses import dataclass\nfrom datetime import datetime\n\n@dataclass\nclass Cylinder:\n    radius: float\n    height: float\n\n    def lateral_surface(self) -> float:\n        \"\"\"Compute and return 2 * math.pi * self.radius * self.height using math.pi.\"\"\"\n        return 2 * math.pi * self.radius * self.height\n\nclass GeometryService:\n    def calculate_lateral_surface(self, cylinder: Cylinder) -> float:\n        \"\"\"Return 2 * math.pi * cylinder.radius * cylinder.height (uses math.pi).\"\"\"\n        return 2 * math.pi * cylinder.radius * cylinder.height\n\n@dataclass\nclass CalculationResult:\n    value: float\n    units: str\n    timestamp: datetime\n\ndef lateralsuface_cylinder(radius, height):\n    \"\"\"Public function (exact name required by SRS).\n    Converts inputs to float, creates Cylinder, delegates to GeometryService, returns float.\n    \"\"\"\n    r_float = float(radius)\n    h_float = float(height)\n    cylinder_obj = Cylinder(radius=r_float, height=h_float)\n    service = GeometryService()\n    area = service.calculate_lateral_surface(cylinder_obj)\n    return area"}
{"task_id": "Mbpp/235", "solution": "class IntegerInput:\n    \"\"\"Holds the input integer value.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\nclass BitMask:\n    \"\"\"Generates a mask with 1s at even-numbered bit positions.\"\"\"\n    def __init__(self):\n        self.mask = 0\n\n    def generate_even_mask(self, max_bits: int) -> int:\n        \"\"\"\n        Generates an integer mask with 1s in even-numbered positions\n        for bit indices from 0 up to (max_bits - 1).\n        \"\"\"\n        mask = 0\n        for i in range(max_bits):\n            if i % 2 == 0:  # Check if the bit position is even (0-indexed)\n                mask |= (1 << i) # Set the bit at this position\n        return mask\n\nclass ResultInteger:\n    \"\"\"Holds the resulting integer value.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\ndef even_bit_set_number(value) -> int:\n    \"\"\"\n    Sets all even-numbered bits of a given number to 1, preserving odd-numbered bits.\n    Bit positions are 0-indexed, with LSB at position 0.\n    \"\"\"\n    integer_input = IntegerInput(value)\n\n    # Determine max_bits as max(1, value.bit_length()) for non-negative inputs.\n    # value.bit_length() returns the number of bits required to represent an integer.\n    # For 0, it returns 0, so max(1, 0) ensures at least 1 bit (position 0) is considered.\n    max_bits = max(1, integer_input.value.bit_length())\n\n    bit_mask_gen = BitMask()\n    mask = bit_mask_gen.generate_even_mask(max_bits)\n\n    # Compute the result by performing a bitwise OR operation.\n    # This sets all even-numbered bits in 'value' to 1 (if they are not already 1)\n    # while preserving the values of the odd-numbered bits.\n    result_int = integer_input.value | mask\n\n    # The design specifies building a ResultInteger object, though its value is returned.\n    result_integer_obj = ResultInteger(result_int)\n\n    return result_int"}
{"task_id": "Mbpp/238", "solution": "class SubstringCounter:\n    \"\"\"Encapsulates the algorithm for computing the number of non-empty contiguous substrings.\"\"\"\n    def number_of_substrings(self, s: str) -> int:\n        \"\"\"Computes the count of non-empty contiguous substrings for a given string.\"\"\"\n        n = len(s)\n        return n * (n + 1) // 2\n\ndef number_of_substrings(s: str) -> int:\n    \"\"\"Counts the number of non-empty substrings of a given string.\"\"\"\n    return SubstringCounter().number_of_substrings(s)"}
{"task_id": "Mbpp/237", "solution": "class NormalizedTuple:\n    \"\"\"An immutable, normalized 2-element tuple, where elements are stored in ascending order.\"\"\"\n    def __init__(self, a, b):\n        self.a, self.b = (min(a, b), max(a, b))\n\n    def to_tuple(self) -> tuple:\n        \"\"\"Converts the normalized elements into a standard tuple.\"\"\"\n        return (self.a, self.b)\n\n    def __eq__(self, other) -> bool:\n        \"\"\"Compares two NormalizedTuple instances for equality.\"\"\"\n        if not isinstance(other, NormalizedTuple):\n            return NotImplemented\n        return self.a == other.a and self.b == other.b\n\n    def __hash__(self) -> int:\n        \"\"\"Returns a hash value for the NormalizedTuple, making it suitable for dictionary keys.\"\"\"\n        return hash(self.to_tuple())\n\nclass TupleItem:\n    \"\"\"Represents a single 2-element tuple item from the input list.\"\"\"\n    def __init__(self, element1, element2):\n        self.element1 = element1\n        self.element2 = element2\n\n    @classmethod\n    def from_raw(cls, raw) -> \"TupleItem\":\n        \"\"\"Factory method to create a TupleItem from a raw input element, validating its format.\"\"\"\n        if not isinstance(raw, tuple) or len(raw) != 2:\n            raise ValueError(\"Each item in the input list must be a 2-element tuple.\")\n        return cls(raw[0], raw[1])\n\n    def normalize(self) -> \"NormalizedTuple\":\n        \"\"\"Normalizes the tuple's elements by sorting them in ascending order.\"\"\"\n        return NormalizedTuple(self.element1, self.element2)\n\nclass InputList:\n    \"\"\"Wraps and validates the entire input list of tuple items.\"\"\"\n    def __init__(self, raw_input):\n        if not isinstance(raw_input, list):\n            raise ValueError(\"Input must be a list.\")\n        self.items = []\n        for raw_item in raw_input:\n            self.items.append(TupleItem.from_raw(raw_item))\n\n    def validate(self) -> None:\n        \"\"\"Ensures the wrapped items are valid. (Validation occurs during initialization).\"\"\"\n        pass # Validation is implicitly performed in __init__ by attempting to create TupleItem instances.\n\nclass ResultDictionary:\n    \"\"\"A wrapper for the final dictionary mapping normalized tuples to counts.\"\"\"\n    def __init__(self, mapping: dict):\n        self.mapping = mapping\n\n    def to_dict(self) -> dict:\n        \"\"\"Returns the internal dictionary mapping.\"\"\"\n        return self.mapping\n\nclass OccurrenceCounter:\n    \"\"\"Aggregates and counts occurrences of NormalizedTuple objects.\"\"\"\n    def __init__(self):\n        self.counts: dict[tuple, int] = {}\n\n    def increment(self, normalized: \"NormalizedTuple\") -> None:\n        \"\"\"Increments the count for a given normalized tuple.\"\"\"\n        tuple_key = normalized.to_tuple()\n        self.counts[tuple_key] = self.counts.get(tuple_key, 0) + 1\n\n    def get_results(self) -> \"ResultDictionary\":\n        \"\"\"Returns the current counts as a ResultDictionary object.\"\"\"\n        return ResultDictionary(self.counts)\n\ndef _validate_and_wrap_input(input_list) -> InputList:\n    \"\"\"Validates the raw input list and wraps it into an InputList object.\"\"\"\n    return InputList(input_list)\n\ndef check_occurences(input_list):\n    \"\"\"\n    Validates the input list, normalizes 2-element tuples,\n    counts their occurrences, and returns a dictionary.\n    \"\"\"\n    validated_input = _validate_and_wrap_input(input_list)\n    counter = OccurrenceCounter()\n\n    for item in validated_input.items:\n        normalized_tuple = item.normalize()\n        counter.increment(normalized_tuple)\n\n    return counter.get_results().to_dict()"}
