{"task_id": "Mbpp/748", "solution": "class Character:\n    \"\"\"Encapsulates a single character's value, position, and classification properties.\"\"\"\n    def __init__(self, value: str, position: int) -> None:\n        self.value = value\n        self.position = position\n\n    def isUpper(self) -> bool:\n        \"\"\"Determines if the character is an uppercase letter.\"\"\"\n        return self.value.isupper()\n\n    def isLower(self) -> bool:\n        \"\"\"Determines if the character is a lowercase letter.\"\"\"\n        return self.value.islower()\n\n    def isLetter(self) -> bool:\n        \"\"\"Determines if the character is any letter (uppercase or lowercase).\"\"\"\n        return self.value.isalpha()\n\nclass InputString:\n    \"\"\"Represents the input string, providing character-level access.\"\"\"\n    def __init__(self, value: str) -> None:\n        self.value = value\n\n    def char_at(self, idx: int) -> 'Character':\n        \"\"\"Retrieves a Character object at the specified index.\"\"\"\n        return Character(self.value[idx], idx)\n\n    def __len__(self) -> int:\n        \"\"\"Returns the total number of characters in the input string.\"\"\"\n        return len(self.value)\n\nclass OutputString:\n    \"\"\"Accumulates string segments to efficiently build the final output string.\"\"\"\n    def __init__(self) -> None:\n        self._parts = []\n\n    def append(self, s: str) -> None:\n        \"\"\"Appends a string or character to the internal list of parts.\"\"\"\n        self._parts.append(s)\n\n    def build(self) -> str:\n        \"\"\"Joins all accumulated parts to form the complete output string.\"\"\"\n        return \"\".join(self._parts)\n\nclass Rule:\n    \"\"\"A placeholder class for business rule metadata for traceability.\"\"\"\n    def __init__(self, id: str, description: str) -> None:\n        self.id = id\n        self.description = description\n\nclass CapitalWordsProcessor:\n    \"\"\"Core processor that applies the word spacing transformation rules.\"\"\"\n    def capital_words_spaces(self, s: str) -> str:\n        \"\"\"\n        Transforms the input string by inserting spaces according to defined rules.\n        A space is inserted before an uppercase letter if it is immediately\n        preceded by a lowercase letter and not at the beginning of the string.\n        \"\"\"\n        if not s:\n            return \"\"\n\n        input_str = InputString(s)\n        output_str = OutputString()\n\n        for i in range(len(input_str)):\n            current_char = input_str.char_at(i)\n\n            # Insert a space if the current character is uppercase, the previous exists,\n            # and the previous character was lowercase.\n            if i > 0:\n                prev_char = input_str.char_at(i - 1)\n                if current_char.isUpper() and prev_char.isLower():\n                    output_str.append(' ')\n            \n            output_str.append(current_char.value)\n        \n        return output_str.build()\n\n\ndef capital_words_spaces(s: str) -> str:\n    \"\"\"\n    Inserts spaces between words starting with capital letters in a given string.\n    This function delegates the actual processing to CapitalWordsProcessor.\n    \"\"\"\n    processor = CapitalWordsProcessor()\n    return processor.capital_words_spaces(s)"}
{"task_id": "Mbpp/751", "solution": "def check_min_heap(array) -> bool:\n    \"\"\"\n    Checks if the given array represents a min-heap,\n    interpreting it as a zero-based binary heap.\n    \"\"\"\n    n = len(array)\n\n    if n <= 1:\n        return True\n\n    # Iterate through all nodes that could be parents.\n    # The last potential parent is at index (n // 2) - 1.\n    for i in range(n // 2):\n        left_child_idx = 2 * i + 1\n        right_child_idx = 2 * i + 2\n\n        # Check if the left child exists and violates the min-heap property.\n        if left_child_idx < n:\n            if array[i] > array[left_child_idx]:\n                return False\n\n        # Check if the right child exists and violates the min-heap property.\n        if right_child_idx < n:\n            if array[i] > array[right_child_idx]:\n                return False\n\n    return True"}
{"task_id": "Mbpp/753", "solution": "from typing import List, Tuple\n\n# Internal lightweight TupleRecord stores (identifier, value, original_index)\nclass TupleRecord:\n    def __init__(self, identifier: str, value: int, original_index: int):\n        self.identifier = identifier\n        self.value = value\n        self.original_index = original_index\n\n    def as_tuple(self) -> Tuple[str, int]:\n        return (self.identifier, self.value)\n\n# Type aliases for clarity in helper signatures\nTupleList = List[TupleRecord]\n\ndef _to_tuple_records(records: List[Tuple[str, int]]) -> TupleList:\n    \"\"\"Converts a list of 2-tuples to a list of TupleRecord objects.\"\"\"\n    tuple_records = []\n    for i, record in enumerate(records):\n        identifier = record[0]\n        value = record[1]\n        tuple_records.append(TupleRecord(identifier, value, i))\n    return tuple_records\n\ndef _select_k_smallest(records: TupleList, k: int) -> TupleList:\n    \"\"\"Selects k smallest TupleRecord objects, sorted by value.\"\"\"\n    # The design recommends sorting for deterministic ordered output.\n    sorted_records = sorted(records, key=lambda tr: tr.value)\n    return sorted_records[:k]\n\ndef _from_tuple_records(records: TupleList) -> List[Tuple[str, int]]:\n    \"\"\"Converts a list of TupleRecord objects back to a list of 2-tuples.\"\"\"\n    return [tr.as_tuple() for tr in records]\n\ndef min_k(records: List[Tuple[str, int]], k: int) -> List[Tuple[str, int]]:\n    \"\"\"\n    Finds the minimum k records from a list of 2-tuples, ordered ascending by the second element.\n    \"\"\"\n    if k <= 0:\n        return []\n\n    # Convert input to internal TupleRecord representation\n    tuple_records = _to_tuple_records(records)\n    n = len(tuple_records)\n\n    if k >= n:\n        # If k is greater than or equal to the number of records,\n        # return all records sorted ascending by value.\n        sorted_all_records = sorted(tuple_records, key=lambda tr: tr.value)\n        return _from_tuple_records(sorted_all_records)\n    else:\n        # Select the k smallest records and ensure they are sorted ascending by value.\n        selected_k_records = _select_k_smallest(tuple_records, k)\n        return _from_tuple_records(selected_k_records)"}
{"task_id": "Mbpp/755", "solution": "from typing import List, Union\n\nNumber = Union[int, float]\n\n__all__ = ['second_smallest']\n\nclass NumberElement:\n    \"\"\"Represents an individual numeric element.\"\"\"\n    def __init__(self, value: Number):\n        self._value = value\n\n    def value(self) -> Number:\n        \"\"\"Returns the numeric value.\"\"\"\n        return self._value\n\nclass Result:\n    \"\"\"Represents the returned numeric result.\"\"\"\n    def __init__(self, value: Number):\n        self._value = value\n\n    def value(self) -> Number:\n        \"\"\"Returns the numeric value.\"\"\"\n        return self._value\n\nclass InputList:\n    \"\"\"Represents and validates the input list and provides distinct-values extraction.\"\"\"\n    def __init__(self, elements: list):\n        if not isinstance(elements, list):\n            raise TypeError(\"Input must be a list.\")\n        self._elements = elements\n\n    def is_valid(self) -> bool:\n        \"\"\"Validates that all elements in the list are numeric.\"\"\"\n        for element in self._elements:\n            if not isinstance(element, (int, float)):\n                raise TypeError(f\"List elements must be numeric (int or float), got {type(element).__name__}.\")\n        return True\n\n    def distinct_values(self) -> List[Number]:\n        \"\"\"Extracts and returns a sorted list of distinct numeric values.\"\"\"\n        self.is_valid() # Ensure validation is performed\n        distinct = sorted(list(set(self._elements)))\n        return distinct\n\nclass SecondSmallestFunction:\n    \"\"\"Encapsulates the core process of validating an input list and computing the second smallest distinct number.\"\"\"\n    def second_smallest(self, numbers: list) -> Number:\n        \"\"\"\n        Validates the input list, extracts distinct numeric values,\n        and computes the second smallest distinct number.\n        \"\"\"\n        input_list = InputList(numbers)\n        distinct_numbers = input_list.distinct_values()\n\n        if len(distinct_numbers) < 2:\n            raise ValueError(\"Input list must contain at least two distinct numeric values.\")\n\n        second_smallest_value = distinct_numbers[1]\n        return second_smallest_value\n\ndef second_smallest(numbers: list) -> Number:\n    \"\"\"\n    Finds the second smallest distinct number in a list of numeric values.\n    This public API function delegates to SecondSmallestFunction.\n    \"\"\"\n    return SecondSmallestFunction().second_smallest(numbers)"}
{"task_id": "Mbpp/757", "solution": "from typing import List\n\nclass InvalidInputException(Exception):\n    def __init__(self, message: str = None):\n        super().__init__(message)\n\ndef validate(strings: List[str]) -> None:\n    if not isinstance(strings, list):\n        raise InvalidInputException(\"Input must be a list.\")\n    if any(not isinstance(x, str) for x in strings):\n        raise InvalidInputException(\"All elements in the list must be strings.\")\n\nclass StringElement:\n    def __init__(self, value: str, index: int):\n        self.value = value\n        self.index = index\n\n    def reverse(self) -> str:\n        return self.value[::-1]\n\nclass CountReversePairs:\n    def count(self, strings: List[str]) -> int:\n        n = len(strings)\n        if n < 2:\n            return 0\n\n        reverse_pair_count = 0\n        for i in range(n - 1):\n            for j in range(i + 1, n):\n                if strings[i] == StringElement(strings[j], j).reverse():\n                    reverse_pair_count += 1\n        return reverse_pair_count\n\ndef count_reverse_pairs(strings: List[str]) -> int:\n    \"\"\"Validates input and returns integer count of ordered reverse-string pairs.\"\"\"\n    validate(strings)\n    counter = CountReversePairs()\n    return counter.count(strings)"}
{"task_id": "Mbpp/758", "solution": "def unique_sublists(input_list):\n    \"\"\"Accepts a list of sublists and returns a dictionary mapping tuple(sublist) -> count.\n\n    For empty input_list returns {}.\n    \"\"\"\n    counts = {}\n    for sublist in input_list:\n        sublist_as_tuple = tuple(sublist)\n        counts[sublist_as_tuple] = counts.get(sublist_as_tuple, 0) + 1\n    return counts"}
{"task_id": "Mbpp/752", "solution": "from .calculator import JacobsthalCalculator\nfrom .errors import InvalidInputError\n\ndef jacobsthal_num(n: int) -> int:\n    \"\"\"\n    Computes the nth Jacobsthal number using the sequence J_0 = 0, J_1 = 1, J_n = J_{n-1} + 2 * J_{n-2}.\n    Raises InvalidInputError if n is not a non-negative integer.\n    \"\"\"\n    calculator = JacobsthalCalculator()\n    return calculator.jacobsthal_num(n)"}
{"task_id": "Mbpp/759", "solution": "import re\n\nPATTERN: str = '^\\\\d+\\\\.\\\\d{2}$'\n_RE = re.compile(PATTERN)\n\ndef is_decimal(input: str) -> bool:\n    \"\"\"\n    Checks if the input string is a decimal number with exactly two decimal places.\n    Non-string inputs or non-matching strings return False without raising exceptions.\n    \"\"\"\n    if not isinstance(input, str):\n        return False\n    return bool(_RE.fullmatch(input))"}
