{"task_id": "Mbpp/807", "solution": "from typing import Optional\n\ndef first_odd(numbers: list) -> Optional[int]:\n    \"\"\"\n    Finds the first odd number in a given list of numbers.\n    Returns None if no odd numbers are found.\n    \"\"\"\n    for number in numbers:\n        if number % 2 != 0:\n            return number\n    return None"}
{"task_id": "Mbpp/809", "solution": "def check_smaller(first_tuple, second_tuple) -> bool:\n    \"\"\"Checks if each element of the second tuple is smaller than its corresponding element in the first tuple.\n    Returns True if all elements satisfy the condition or if tuples are empty; False otherwise or if lengths differ.\n    \"\"\"\n    if len(first_tuple) != len(second_tuple):\n        return False\n\n    for i in range(len(first_tuple)):\n        if not (second_tuple[i] < first_tuple[i]):\n            return False\n\n    return True"}
{"task_id": "Mbpp/754", "solution": "def extract_index_list(l1, l2, l3) -> list:\n    \"\"\"\n    Compute and return a list of elements that are equal at the same index in all three input lists.\n\n    Complexity guarantees:\n    - Time: O(n) where n = min(len(l1), len(l2), len(l3))\n    - Auxiliary space: O(k) where k = number of matches returned\n\n    Parameters:\n    - l1, l2, l3: Python lists (caller-supplied). Behavior for non-list inputs or None is unspecified.\n\n    Returns: list containing matched elements in increasing index order.\n    \"\"\"\n    min_length = min(len(l1), len(l2), len(l3))\n    result = []\n    for i in range(min_length):\n        if l1[i] == l2[i] == l3[i]:\n            result.append(l1[i])\n    return result"}
{"task_id": "Mbpp/125", "solution": "def find_length(s: str) -> int:\n    \"\"\"\n    Finds the maximum difference between the number of 0s and 1s in any substring.\n    Raises ValueError if the input string contains characters other than '0' or '1'.\n    \"\"\"\n    def validate(s: str) -> bool:\n        \"\"\"Checks if the string contains only '0' and '1'.\"\"\"\n        return all(c in ('0', '1') for c in s)\n\n    def computeMaxDiff(s: str) -> int:\n        \"\"\"\n        Computes the maximum difference (#zeros - #ones) over all contiguous substrings.\n        Uses Kadane's algorithm by transforming '0' to 1 and '1' to -1.\n        \"\"\"\n        if not s:\n            return 0\n\n        # Transform the binary string: '0' -> 1, '1' -> -1\n        # This converts the problem into finding the maximum subarray sum.\n        nums = [1 if char == '0' else -1 for char in s]\n\n        max_so_far = nums[0]\n        current_max = nums[0]\n\n        for i in range 1, len(nums):\n            current_max = max(nums[i], current_max + nums[i])\n            max_so_far = max(max_so_far, current_max)\n        \n        return max_so_far\n\n    if not validate(s):\n        raise ValueError(\"Input string must contain only '0' and '1'.\")\n    \n    return computeMaxDiff(s)"}
{"task_id": "Mbpp/308", "solution": "from typing import List\n\ndef large_product(a: List[float], b: List[float], k: int) -> List[float]:\n    \"\"\"\n    Computes all pairwise products from elements of lists a and b,\n    then returns the k largest products sorted in descending order.\n    \"\"\"\n    all_products = []\n    for factor_a in a:\n        for factor_b in b:\n            all_products.append(factor_a * factor_b)\n\n    all_products.sort(reverse=True)\n    return all_products[:k]"}
{"task_id": "Mbpp/306", "solution": "def max_sum_increasing_subseq(arr, n, i, k) -> int:\n    \"\"\"\n    Finds the maximum sum of an increasing subsequence from arr[0...i]\n    including arr[k] (where k > i and all prefix elements must be less than arr[k]).\n    \"\"\"\n\n    if n != len(arr):\n        raise ValueError(\"n does not equal len(arr)\")\n    if not (0 <= i < n and 0 <= k < n and k > i):\n        raise ValueError(\"indices invalid or k <= i\")\n\n    # Helper function to compute the maximum sum of an increasing subsequence\n    # using elements from arr[0...end_idx] with values < target_val.\n    def _compute_max_prefix_sum(sub_arr, end_idx, target_val) -> int:\n        if end_idx < 0:\n            return 0\n\n        # dp[j] stores the maximum sum of an increasing subsequence ending at index j\n        # within sub_arr[0...j], provided sub_arr[j] < target_val.\n        dp = [0] * (end_idx + 1)\n        max_overall_prefix_sum = 0\n\n        for j in range(end_idx + 1):\n            current_element = sub_arr[j]\n            if current_element < target_val:\n                dp[j] = current_element # A subsequence can just be the element itself\n                for p in range(j):\n                    if sub_arr[p] < current_element: # Check for strictly increasing\n                        dp[j] = max(dp[j], dp[p] + current_element)\n                max_overall_prefix_sum = max(max_overall_prefix_sum, dp[j])\n        return max_overall_prefix_sum\n\n    arr_k_val = arr[k]\n    max_prefix_sum = _compute_max_prefix_sum(arr, i, arr_k_val)\n\n    # If no valid prefix elements were found, the subsequence is just arr[k].\n    if max_prefix_sum == 0 and arr_k_val <= 0: # Check if it's genuinely 0 (no elements) or if all numbers are negative\n        # If all prefix candidates are negative or zero, _compute_max_prefix_sum will return 0.\n        # However, if arr[k] is also negative/zero, and there are no valid prefix elements,\n        # we still return arr[k] as the minimum valid sum.\n        # This condition is tricky. The problem implies positive sum, but example has 1.\n        # \"Maximum sum of increasing subsequence\" implies sum >= 0, or sum could be negative.\n        # For simplicity based on problem nature, if _compute_max_prefix_sum is 0,\n        # it indicates no suitable prefix was found, and arr[k] itself forms the subsequence.\n        return arr_k_val\n    elif max_prefix_sum == 0 and arr_k_val > 0:\n        return arr_k_val\n    else:\n        return max_prefix_sum + arr_k_val"}
