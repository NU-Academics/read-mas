{"task_id": "Mbpp/279", "solution": "def is_num_decagonal(n: int) -> int:\n    \"\"\"\n    Computes the nth decagonal number using its closed-form formula.\n    This function assumes n is a valid integer (n >= 1) per external validation.\n    \"\"\"\n    return 4 * n * n - 3 * n"}
{"task_id": "Mbpp/282", "solution": "def _is_numeric(x):\n    \"\"\"Return True if x is int or float; False otherwise.\"\"\"\n    return isinstance(x, (int, float))\n\ndef _validate_list_of_numbers(seq, name):\n    \"\"\"Raise TypeError if seq is not a list or contains non-numeric elements; name is used in error message.\"\"\"\n    if not isinstance(seq, list):\n        raise TypeError(f\"{name} must be a list.\")\n    for i, x in enumerate(seq):\n        if not _is_numeric(x):\n            raise TypeError(f\"All elements in {name} must be numbers, but element at index {i} is not.\")\n\ndef sub_list(a, b):\n    \"\"\"Return a new list where result[i] = a[i] - b[i] for i in range(min(len(a), len(b))).\n    Raises TypeError if inputs are not lists or contain non-numeric elements.\n    \"\"\"\n    _validate_list_of_numbers(a, 'a')\n    _validate_list_of_numbers(b, 'b')\n\n    min_len = min(len(a), len(b))\n    result = []\n    for i in range(min_len):\n        result.append(a[i] - b[i])\n\n    return result"}
{"task_id": "Mbpp/284", "solution": "def check_element(list, element):\n    \"\"\"Return True if every item in `list` equals `element` using Python's `==` semantics; otherwise return False.\n    For an empty list, this function returns True (vacuous truth).\n    \"\"\"\n    return all(item == element for item in list)"}
{"task_id": "Mbpp/283", "solution": "def validate(n: int) -> bool:\n    \"\"\"\n    Checks if the frequency of each digit in the integer is less than or equal to the digit itself.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"Input must be an integer.\")\n\n    counts = [0] * 10\n\n    if n == 0:\n        digits = [0]\n    else:\n        temp_n = abs(n)\n        digits = []\n        while temp_n > 0:\n            digits.append(temp_n % 10)\n            temp_n //= 10\n        # No need to reverse for counting, but keeping the concept from design for completeness\n        # digits.reverse()\n\n    for digit in digits:\n        counts[digit] += 1\n\n    for i in range(10):\n        # Check if the frequency of digit 'i' is greater than 'i' itself.\n        # This covers cases where a digit 'i' is present but its count exceeds 'i',\n        # including the strict handling of digit 0 (counts[0] > 0 will be False).\n        if counts[i] > i:\n            return False\n\n    return True"}
{"task_id": "Mbpp/285", "solution": "from dataclasses import dataclass\nfrom typing import List\n\n@dataclass\nclass InputString:\n    value: str\n\n    def length(self) -> int:\n        return len(self.value)\n\n@dataclass\nclass MatchOccurrence:\n    start_index: int\n    pattern: str\n\n@dataclass\nclass MatchResult:\n    matched: bool\n\nclass TextMatchTwoThreeFunction:\n    name: str = \"text_match_two_three\"\n\n    def _scan_for_matches(self, input_value: str) -> List[MatchOccurrence]:\n        \"\"\"Internal helper to identify zero or more occurrences of \"abb\" or \"abbb\".\"\"\"\n        occurrences = []\n        n = len(input_value)\n        for i in range(n):\n            if i + 3 <= n and input_value[i:i+3] == \"abb\":\n                occurrences.append(MatchOccurrence(start_index=i, pattern=\"abb\"))\n            if i + 4 <= n and input_value[i:i+4] == \"abbb\":\n                occurrences.append(MatchOccurrence(start_index=i, pattern=\"abbb\"))\n        return occurrences\n\n    def execute(self, input: InputString) -> MatchResult:\n        \"\"\"Executes the string matching logic and returns the result.\"\"\"\n        occurrences = self._scan_for_matches(input.value)\n        return MatchResult(matched=bool(occurrences))\n\ndef text_match_two_three(input_string: str) -> bool:\n    \"\"\"\n    Checks whether a string contains the 'a' character followed by two or three 'b' characters.\n    \"\"\"\n    input_obj = InputString(value=input_string)\n    result = TextMatchTwoThreeFunction().execute(input_obj)\n    return result.matched"}
