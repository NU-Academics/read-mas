{"task_id": "Mbpp/133", "solution": "def sum_negativenum(numbers):\n    \"\"\"\n    Return the numeric sum of values strictly less than 0 from 'numbers'.\n    Non-numeric elements are ignored per design.\n    \"\"\"\n    total = 0\n    for number in numbers:\n        # Filter for numeric types (int or float) and sum only negative values.\n        if isinstance(number, (int, float)):\n            if number < 0:\n                total += number\n    return total"}
{"task_id": "Mbpp/135", "solution": "class InputValidator:\n    \"\"\"Validates input 'n' for the hexagonal number calculation.\"\"\"\n    def validate_n(self, n: int) -> bool:\n        \"\"\"Checks if n is an integer and n >= 1.\"\"\"\n        return isinstance(n, int) and n >= 1\n\nclass HexagonalCalculator:\n    \"\"\"Computes the nth hexagonal number.\"\"\"\n    def hexagonal_num(self, n: int) -> int:\n        \"\"\"Calculates H(n) = n * (2 * n - 1).\"\"\"\n        value = n * (2 * n - 1)\n        return value\n\ndef hexagonal_num(n: int) -> int:\n    \"\"\"\n    Finds the nth hexagonal number.\n    Raises ValueError if n is not a positive integer.\n    \"\"\"\n    validator = InputValidator()\n    if not validator.validate_n(n):\n        raise ValueError(\"Input 'n' must be an integer and n >= 1.\")\n\n    calculator = HexagonalCalculator()\n    return calculator.hexagonal_num(n)"}
{"task_id": "Mbpp/137", "solution": "from typing import List\nimport math\n\nclass IntegerArray:\n    \"\"\"Encapsulates the input list of integers for processing.\"\"\"\n    def __init__(self, elements: List[int]) -> None:\n        self.elements = elements\n\nclass ZeroCounter:\n    \"\"\"Performs counting of zeros and non-zeros and computes their ratio.\"\"\"\n    def __init__(self, integer_array: IntegerArray) -> None:\n        self.integer_array = integer_array\n        self._zeros: int = -1 # Memoization storage\n        self._non_zeros: int = -1 # Memoization storage\n\n    def count_zeros(self) -> int:\n        \"\"\"Counts the number of zero elements in the array.\"\"\"\n        if self._zeros == -1:\n            self._zeros = sum(1 for x in self.integer_array.elements if x == 0)\n        return self._zeros\n\n    def count_nonzeros(self) -> int:\n        \"\"\"Counts the number of non-zero elements in the array.\"\"\"\n        if self._non_zeros == -1:\n            self._non_zeros = len(self.integer_array.elements) - self.count_zeros()\n        return self._non_zeros\n\n    def compute_ratio(self) -> float:\n        \"\"\"Computes the ratio of zeros to non-zeros.\"\"\"\n        zeros = self.count_zeros()\n        non_zeros = self.count_nonzeros()\n        # Python's default ZeroDivisionError is preserved as per design if non_zeros is 0.\n        return float(zeros) / non_zeros\n\nclass ZeroCountResult:\n    \"\"\"Data Transfer Object to hold computed counts and ratio.\"\"\"\n    def __init__(self, zeros: int, non_zeros: int, ratio: float) -> None:\n        self.zeros = zeros\n        self.non_zeros = non_zeros\n        self.ratio = ratio\n\nclass TestAssertion:\n    \"\"\"Helper class for validating test assertions using math.isclose.\"\"\"\n    def __init__(self, expected: float, rel_tol: float) -> None:\n        self.expected = expected\n        self.rel_tol = rel_tol\n\n    def validate(self, actual: float) -> bool:\n        \"\"\"Validates if the actual value is close to the expected value.\"\"\"\n        return math.isclose(actual, self.expected, rel_tol=self.rel_tol)\n\ndef zero_count(elements: List[int]) -> float:\n    \"\"\"\n    Calculates the ratio of zeroes to non-zeroes in an array of integers.\n    \"\"\"\n    integer_array = IntegerArray(elements)\n    counter = ZeroCounter(integer_array)\n    \n    return counter.compute_ratio()"}
{"task_id": "Mbpp/138", "solution": "def validate_input(n) -> bool:\n    \"\"\"Checks if the input n is an integer.\"\"\"\n    return isinstance(n, int)\n\ndef decompose_into_powers(n) -> bool:\n    \"\"\"\n    Determines if n can be represented as a sum of 2^k where k >= 1 and n >= 2.\n    This simplifies to checking if n is an even integer greater than or equal to 2.\n    \"\"\"\n    return n >= 2 and n % 2 == 0\n\ndef is_Sum_Of_Powers_Of_Two(n) -> bool:\n    \"\"\"\n    Checks if the given number can be represented as a sum of non-zero powers of 2.\n    This means n must be an integer, even, and greater than or equal to 2.\n    \"\"\"\n    if not validate_input(n):\n        return False\n    return decompose_into_powers(n)"}
