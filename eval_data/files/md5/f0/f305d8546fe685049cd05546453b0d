{"task_id": "Mbpp/244", "solution": "import math\n\ndef _validate_input(n):\n    \"\"\"\n    Validates that the input n is an integer.\n    Raises TypeError if n is not an integer.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"Input must be an integer.\")\n\ndef _compute_next_square(n):\n    \"\"\"\n    Computes the smallest perfect square strictly greater than n.\n    It calculates the integer square root and then squares the next integer.\n    \"\"\"\n    root = math.isqrt(n)\n    # The next perfect square will be (root + 1)^2\n    next_root = root + 1\n    return next_root * next_root\n\ndef next_Perfect_Square(n):\n    \"\"\"\n    Finds the next perfect square strictly greater than a given number n.\n    It validates the input and computes the result using internal helpers.\n    \"\"\"\n    _validate_input(n)\n    return _compute_next_square(n)"}
{"task_id": "Mbpp/245", "solution": "class ArrayInput:\n    def __init__(self, values: list) -> None:\n        self.values = values\n\nclass MaxSumResult:\n    def __init__(self, value: float) -> None:\n        self.value = value\n\nclass InvalidInputError(Exception):\n    pass\n\nclass Validator:\n    def validate(self, array_input: ArrayInput) -> bool:\n        \"\"\"Return True when array_input.values is list-like and all elements are numeric.\n           On invalid input raise InvalidInputError per UC2 flow.\"\"\"\n        if not isinstance(array_input.values, (list, tuple)):\n            raise InvalidInputError(\"Input must be a list or tuple.\")\n        for x in array_input.values:\n            if not isinstance(x, (int, float)):\n                raise InvalidInputError(\"All elements must be numeric.\")\n        return True\n\nclass Algorithm:\n    def computeIncreasingSums(self, array_input: ArrayInput) -> list[float]:\n        \"\"\"For each index i compute maximum sum of an increasing subsequence ending at i.\"\"\"\n        values = array_input.values\n        n = len(values)\n        if n == 0:\n            return []\n        \n        inc_sums = [float(v) for v in values]\n\n        for i in range(1, n):\n            for j in range(i):\n                if values[i] > values[j]:\n                    inc_sums[i] = max(inc_sums[i], inc_sums[j] + values[i])\n        return inc_sums\n\n    def computeDecreasingSums(self, array_input: ArrayInput) -> list[float]:\n        \"\"\"For each index i compute maximum sum of a decreasing subsequence starting at i (reverse scan).\"\"\"\n        values = array_input.values\n        n = len(values)\n        if n == 0:\n            return []\n\n        dec_sums = [float(v) for v in values]\n\n        for i in range(n - 2, -1, -1):\n            for j in range(n - 1, i, -1):\n                if values[i] > values[j]:\n                    dec_sums[i] = max(dec_sums[i], dec_sums[j] + values[i])\n        return dec_sums\n\n    def computeMaxSum(self, array_input: ArrayInput) -> MaxSumResult:\n        \"\"\"Combine per-element inc and dec sums to compute candidate bitonic sums and return maximum.\n           Typical combination: max_{i}(inc[i] + dec[i] - value[i]).\"\"\"\n        values = array_input.values\n        n = len(values)\n\n        if n == 0:\n            return MaxSumResult(0.0)\n        \n        inc_sums = self.computeIncreasingSums(array_input)\n        dec_sums = self.computeDecreasingSums(array_input)\n\n        max_bitonic_sum = float('-inf')\n\n        for i in range(n):\n            current_sum = inc_sums[i] + dec_sums[i] - values[i]\n            if current_sum > max_bitonic_sum:\n                max_bitonic_sum = current_sum\n        \n        return MaxSumResult(max_bitonic_sum)\n\ndef max_sum(array) -> float:\n    \"\"\"Public API:\n       - Wrap array into ArrayInput\n       - Validator.validate(ArrayInput)\n       - Algorithm.computeMaxSum(ArrayInput)\n       - return MaxSumResult.value\n       On InvalidInputError, propagate exception to caller.\n    \"\"\"\n    array_input = ArrayInput(array)\n    \n    validator = Validator()\n    validator.validate(array_input)\n\n    algorithm = Algorithm()\n    max_sum_result = algorithm.computeMaxSum(array_input)\n    \n    return max_sum_result.value"}
