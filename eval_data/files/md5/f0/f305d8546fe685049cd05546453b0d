{"task_id": "Mbpp/635", "solution": "class InputList:\n    \"\"\"A simple DTO for input list elements.\"\"\"\n    def __init__(self, elements: list):\n        self.elements = elements\n\nclass SortedList:\n    \"\"\"A simple DTO for sorted output elements.\"\"\"\n    def __init__(self, elements: list = None):\n        self.elements = elements if elements is not None else []\n\nclass Heap:\n    \"\"\"Encapsulates array-backed heap storage and low-level heap operations.\"\"\"\n    def __init__(self, data: list):\n        # Initializes the heap with a copy of the provided data and builds a max-heap.\n        self._data = list(data) # Create a copy to prevent modifying the original input list\n        self._size = len(self._data)\n        self.heapify()\n\n    def sift_down(self, index: int, heap_size: int):\n        \"\"\"Maintains the max-heap property by sifting an element down to its correct position.\"\"\"\n        largest = index\n        left_child = 2 * index + 1\n        right_child = 2 * index + 2\n\n        if left_child < heap_size and self._data[left_child] > self._data[largest]:\n            largest = left_child\n        if right_child < heap_size and self._data[right_child] > self._data[largest]:\n            largest = right_child\n\n        if largest != index:\n            self._data[index], self._data[largest] = self._data[largest], self._data[index]\n            self.sift_down(largest, heap_size)\n\n    def heapify(self):\n        \"\"\"Builds a max-heap from the current list data.\"\"\"\n        # Start from the last non-leaf node and sift down each node.\n        for i in range(self._size // 2 - 1, -1, -1):\n            self.sift_down(i, self._size)\n\n    def extract_max(self):\n        \"\"\"Removes and returns the maximum element (root) from the heap.\"\"\"\n        if self._size == 0:\n            raise IndexError(\"Heap is empty\")\n\n        # Swap the root with the last element in the effective heap.\n        self._data[0], self._data[self._size - 1] = self._data[self._size - 1], self._data[0]\n        max_val = self._data.pop() # Remove the swapped max element from the list.\n        self._size -= 1 # Decrease the effective size of the heap.\n\n        # Sift down the new root to maintain the heap property if elements remain.\n        if self._size > 0:\n            self.sift_down(0, self._size)\n        return max_val\n\nclass SortingSystem:\n    \"\"\"Coordinates the heap-sort process using a Heap instance.\"\"\"\n    def __init__(self):\n        self._heap: Heap = None # Stores the Heap object used for sorting.\n\n    def build_heap(self, lst: list) -> None:\n        \"\"\"Initializes the internal heap from the given list.\"\"\"\n        self._heap = Heap(lst)\n\n    def sift_down(self, index: int, heap_size: int) -> None:\n        \"\"\"Delegates the sift_down operation to the internal heap.\"\"\"\n        if self._heap:\n            self._heap.sift_down(index, heap_size)\n\n    def extract_sorted(self) -> list:\n        \"\"\"Extracts elements from the heap in descending order and reverses them to ascending.\"\"\"\n        sorted_elements_desc = []\n        # Repeatedly extract the maximum element until the heap is empty.\n        while self._heap._size > 0:\n            sorted_elements_desc.append(self._heap.extract_max())\n        \n        sorted_elements_desc.reverse() # Reverse to get ascending order.\n        return sorted_elements_desc\n\n    def heap_sort(self, lst: list) -> list:\n        \"\"\"The main orchestration method for heap sorting an input list.\"\"\"\n        self.build_heap(lst) # Build a max-heap from the input list.\n        sorted_result = self.extract_sorted() # Extract elements and return them sorted.\n        return sorted_result\n\ndef heap_sort(lst: list) -> list:\n    \"\"\"\n    Sorts a list using the heap sort algorithm.\n    This function acts as the public API entry point.\n    \"\"\"\n    sorter = SortingSystem()\n    return sorter.heap_sort(lst)"}
{"task_id": "Mbpp/639", "solution": "from typing import List\n\nclass Name:\n    \"\"\"Represents a single name with methods to get its first character and length.\"\"\"\n    def __init__(self, value: str) -> None:\n        self.value = value\n\n    def firstChar(self) -> str:\n        \"\"\"Returns the first character of the name, or an empty string if the name is empty.\"\"\"\n        if not self.value:\n            return ''\n        return self.value[0]\n\n    def length(self) -> int:\n        \"\"\"Returns the character length of the name.\"\"\"\n        return len(self.value)\n\nclass NameList:\n    \"\"\"Manages a collection of Name objects and provides filtering capabilities.\"\"\"\n    def __init__(self, names_str_list: List[str]) -> None:\n        # Constructs internal Name objects from the list of strings\n        self.names: List[Name] = [Name(name_str) for name_str in names_str_list]\n\n    def count(self) -> int:\n        \"\"\"Returns the number of Name objects in the list.\"\"\"\n        return len(self.names)\n\n    def filterLowercase(self) -> List[Name]:\n        \"\"\"\n        Filters out names that start with a lowercase ASCII letter ('a' through 'z').\n        Returns a list of preserved Name objects.\n        \"\"\"\n        preserved_names: List[Name] = []\n        for name_obj in self.names:\n            first_char = name_obj.firstChar()\n            # Preserve if the first character is not a lowercase ASCII letter 'a'..'z'.\n            # This includes empty strings (first_char == ''), uppercase letters, or non-alphabetic characters.\n            if first_char == '' or not ('a' <= first_char <= 'z'):\n                preserved_names.append(name_obj)\n        return preserved_names\n\ndef sample_nam(names: list) -> int:\n    \"\"\"\n    Sums the length of the names from a list after removing those that start with a lowercase letter.\n    \"\"\"\n    name_list_obj = NameList(names)\n    preserved_name_objs = name_list_obj.filterLowercase()\n\n    total_length = 0\n    for name_obj in preserved_name_objs:\n        total_length += name_obj.length()\n\n    return total_length"}
{"task_id": "Mbpp/638", "solution": "import math\nfrom numbers import Real\n\nclass Measurement:\n    \"\"\"Value object for inputs.\"\"\"\n    def __init__(self, velocity_kmh: float, temperature_celsius: float):\n        self.velocity_kmh = velocity_kmh\n        self.temperature_celsius = temperature_celsius\n\nclass WindChillResult:\n    \"\"\"Value object for integer result.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\nclass WindChillCalculator:\n    \"\"\"Encapsulates deterministic wind chill computation and rounding.\"\"\"\n    def _compute_raw(self, velocity_kmh: float, temperature_celsius: float) -> float:\n        \"\"\"\n        Computes the raw wind chill value using the standard metric formula.\n        If wind velocity is below 0.5 m/s (1.8 km/h), the air temperature is returned.\n        \"\"\"\n        velocity_ms = velocity_kmh / 3.6\n        \n        if velocity_ms < 0.5: # Below ~1.8 km/h, no significant wind chill effect\n            return float(temperature_celsius)\n\n        v_pow_0_16 = math.pow(velocity_ms, 0.16)\n        \n        raw_wind_chill = (\n            13.12\n            + 0.6215 * temperature_celsius\n            - 11.37 * v_pow_0_16\n            + 0.3965 * temperature_celsius * v_pow_0_16\n        )\n        return raw_wind_chill\n\n    def wind_chill(self, velocity_kmh: float, temperature_celsius: float) -> int:\n        \"\"\"\n        Computes the wind chill index as an integer, rounded up (ceiling).\n        Delegates to _compute_raw for the base calculation and uses WindChillResult.\n        \"\"\"\n        raw_result = self._compute_raw(velocity_kmh, temperature_celsius)\n        return WindChillResult(math.ceil(raw_result)).value\n\ndef wind_chill(velocity_kmh, temperature_celsius) -> int:\n    \"\"\"\n    Calculates the wind chill index rounded up to the next integer.\n    Validates inputs are numeric and delegates computation to WindChillCalculator.\n    \"\"\"\n    if not isinstance(velocity_kmh, Real) or not isinstance(temperature_celsius, Real):\n        raise TypeError(\"velocity_kmh and temperature_celsius must be numeric\")\n\n    measurement = Measurement(velocity_kmh, temperature_celsius)\n    calculator = WindChillCalculator()\n    result = calculator.wind_chill(measurement.velocity_kmh, measurement.temperature_celsius)\n    \n    return result"}
{"task_id": "Mbpp/641", "solution": "class InputParameter:\n    \"\"\"Encapsulates input n and provides validation logic.\"\"\"\n    def __init__(self, n: int):\n        self.n = n\n\n    def validate(self) -> bool:\n        \"\"\"Returns True if n is an integer and n >= 1; otherwise False.\"\"\"\n        return isinstance(self.n, int) and self.n >= 1\n\nclass Formula:\n    \"\"\"Encapsulates the formula expression and computation.\"\"\"\n    expression: str = \"(7*n*n - 5*n) / 2\"\n\n    def compute(self, n: int) -> int:\n        \"\"\"Computes and returns the integer value of the formula for integer n.\"\"\"\n        numerator = 7 * n * n - 5 * n\n        return numerator // 2\n\nclass Result:\n    \"\"\"Value object holding the computed integer result.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\ndef is_nonagonal(n: int) -> int:\n    \"\"\"\n    Finds the nth nonagonal number.\n    Raises ValueError if n is not an integer or n < 1.\n    \"\"\"\n    input_param = InputParameter(n)\n    if not input_param.validate():\n        raise ValueError(\"Input 'n' must be an integer greater than or equal to 1.\")\n\n    formula = Formula()\n    computed_value = formula.compute(n)\n\n    result = Result(computed_value)\n    return result.value"}
{"task_id": "Mbpp/644", "solution": "def reverse_Array_Upto_K(arr, k):\n    \"\"\"Reverse the order of the first k elements of arr and return a new list.\n    The remaining elements from index k onward preserve their original order.\n    \"\"\"\n    if k <= 0:\n        return list(arr)\n    \n    # Create a copy to avoid modifying the original array\n    result = list(arr)\n\n    # Slice the part to be reversed\n    sub_array_to_reverse = result[0:k]\n    \n    # Reverse the slice\n    sub_array_to_reverse.reverse()\n    \n    # Reconstruct the array\n    result[0:k] = sub_array_to_reverse\n    \n    return result"}
{"task_id": "Mbpp/720", "solution": "class TypeValidator:\n    \"\"\"Helper class to validate input types for the add_dict_to_tuple function.\"\"\"\n    @staticmethod\n    def validate(t, d) -> None:\n        \"\"\"Validates that the first argument is a tuple and the second is a dictionary.\"\"\"\n        if not isinstance(t, tuple):\n            raise TypeError('First argument must be a tuple')\n        if not isinstance(d, dict):\n            raise TypeError('Second argument must be a dict')\n\ndef add_dict_to_tuple(t, d) -> tuple:\n    \"\"\"Adds a dictionary as the last element to a tuple, returning a new tuple.\"\"\"\n    TypeValidator.validate(t, d)\n    return t + (d,)"}
{"task_id": "Mbpp/643", "solution": "import re\n\ndef text_match_wordz_middle(text):\n    \"\"\"\n    Checks if a string contains 'z', except at the start and end of any word.\n    Words are defined as contiguous sequences of alphabetic characters.\n    \"\"\"\n    if not text:\n        return False\n\n    # Extract all alphabetic word sequences from the text.\n    words = re.findall(r'[a-zA-Z]+', text)\n\n    for word in words:\n        word_length = len(word)\n        # A word must have at least 3 characters for 'z' to be strictly in the middle.\n        if word_length >= 3:\n            # Check for lowercase 'z' from the second character (index 1)\n            # up to the second-to-last character (index word_length - 2).\n            for i in range(1, word_length - 1):\n                if word[i] == 'z':\n                    return True\n    return False"}
{"task_id": "Mbpp/722", "solution": "class FilterService:\n    \"\"\"Encapsulates the logic for filtering students based on height and weight criteria.\"\"\"\n    def filter_data(self, students: dict[str, tuple[float, float]], minHeight: float, minWeight: float) -> dict[str, tuple[float, float]]:\n        \"\"\"\n        Filters students based on minimum height and weight criteria.\n        Returns a new dictionary of students meeting the criteria.\n        \"\"\"\n        filtered_students = {}\n        for name, (height, weight) in students.items():\n            if height >= minHeight and weight >= minWeight:\n                filtered_students[name] = (height, weight)\n        return filtered_students\n\ndef filter_data(students: dict[str, tuple[float, float]], minHeight: float, minWeight: float) -> dict[str, tuple[float, float]]:\n    \"\"\"\n    Filters students that have height and weight above or equal to the minimums.\n    The input is a dictionary with student name as key and (height, weight) as value.\n    \"\"\"\n    service = FilterService()\n    return service.filter_data(students, minHeight, minWeight)"}
{"task_id": "Mbpp/721", "solution": "class ValidationError(Exception):\n    \"\"\"Exception for validation failures.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\n\nclass Validator:\n    \"\"\"Validates matrix input.\"\"\"\n    @staticmethod\n    def isSquare(matrix) -> bool:\n        \"\"\"\n        Checks if the input is a non-empty square matrix.\n        \"\"\"\n        if not isinstance(matrix, list) or not matrix:\n            return False\n        N = len(matrix)\n        for row in matrix:\n            if not isinstance(row, list) or len(row) != N:\n                return False\n        return True\n\n    @staticmethod\n    def validate(matrix) -> None:\n        \"\"\"\n        Validates matrix for non-empty, square shape, and numeric entries.\n        Raises ValidationError on failure.\n        \"\"\"\n        if not Validator.isSquare(matrix):\n            raise ValidationError(\"Matrix must be a non-empty square list of lists.\")\n        \n        N = len(matrix)\n        for r in range(N):\n            for c in range(N):\n                if not isinstance(matrix[r][c], (int, float)):\n                    raise ValidationError(f\"Matrix cell [{r}][{c}] must be a number.\")\n\nclass Cell:\n    \"\"\"Represents a cell in the matrix with its coordinates and cost.\"\"\"\n    def __init__(self, row: int, col: int, cost: float):\n        self.row = row\n        self.col = col\n        self.cost = cost\n\nclass Matrix:\n    \"\"\"Represents the input matrix with its costs and dimensions.\"\"\"\n    def __init__(self, costs: list[list[float]]):\n        self.N = len(costs)\n        self.costs = costs\n\n    def getCell(self, row: int, col: int) -> 'Cell':\n        \"\"\"Returns a Cell object for the given coordinates.\"\"\"\n        return Cell(row, col, self.costs[row][col])\n\nclass MaxAverageCalculator:\n    \"\"\"Calculates the maximum average path in a matrix using dynamic programming.\"\"\"\n    def __init__(self, matrix: 'Matrix'):\n        self.matrix = matrix\n\n    def maxAverageOfPath(self) -> float:\n        \"\"\"\n        Computes the maximum path sum from top-left to bottom-right using DP\n        and returns the average.\n        \"\"\"\n        N = self.matrix.N\n        costs = self.matrix.costs\n\n        # dp[i][j] stores the maximum sum to reach cell (i, j)\n        dp = [[0.0] * N for _ in range(N)]\n\n        # Base case: top-left cell\n        dp[0][0] = float(costs[0][0])\n\n        # Fill first column\n        for i in range(1, N):\n            dp[i][0] = dp[i-1][0] + float(costs[i][0])\n\n        # Fill first row\n        for j in range(1, N):\n            dp[0][j] = dp[0][j-1] + float(costs[0][j])\n\n        # Fill the rest of the dp table\n        for i in range(1, N):\n            for j in range(1, N):\n                dp[i][j] = max(dp[i-1][j], dp[i][j-1]) + float(costs[i][j])\n\n        max_sum = dp[N-1][N-1]\n        \n        # Every full path from (0,0) to (N-1, N-1) has length 2*N - 1.\n        path_length = (2 * N) - 1\n        \n        return float(max_sum / path_length)\n\ndef maxAverageOfPath(matrix) -> float:\n    \"\"\"\n    Given a square matrix, finds a path from top-left to bottom-right\n    with the maximum average cost, moving only right or down.\n    \"\"\"\n    Validator.validate(matrix)\n    mat = Matrix(matrix)\n    calc = MaxAverageCalculator(mat)\n    return calc.maxAverageOfPath()"}
{"task_id": "Mbpp/723", "solution": "def validate_equal_length(list1, list2) -> None:\n    \"\"\"\n    Validates that two lists have equal length.\n    Raises ValueError if lengths differ.\n    \"\"\"\n    if len(list1) != len(list2):\n        raise ValueError('Input lists must be of equal length')\n\nclass ComparisonResult:\n    \"\"\"\n    A simple data holder for the result of a single element comparison.\n    Stores the index and whether a match occurred.\n    \"\"\"\n    def __init__(self, index: int, match: bool) -> None:\n        self.index = index\n        self.match = match\n\ndef count_same_pair(list1, list2) -> int:\n    \"\"\"\n    Counts indices where the two input lists have identical values at the same position.\n    Raises ValueError if the input lists are of different lengths.\n    \"\"\"\n    validate_equal_length(list1, list2)\n    n = len(list1)\n    count = 0\n    for i in range(n):\n        if list1[i] == list2[i]:\n            count += 1\n    return count"}
{"task_id": "Mbpp/724", "solution": "def power_base_sum(base, power):\n    \"\"\"\n    Calculates the sum of all digits of the base to the specified power.\n    This function orchestrates helper functions to compute, convert, and sum.\n    \"\"\"\n    def computePower(base, power):\n        \"\"\"Computes the integer exponentiation of base to the power.\"\"\"\n        return base ** power\n\n    def toDecimal(value):\n        \"\"\"Converts an integer value to its decimal string representation.\"\"\"\n        return str(value)\n\n    def sumDigits(decimalStr):\n        \"\"\"Sums the integer values of digit characters in a decimal string, ignoring non-digits.\"\"\"\n        return sum(int(ch) for ch in decimalStr if ch.isdigit())\n\n    value = computePower(base, power)\n    decimalStr = toDecimal(value)\n    digit_sum = sumDigits(decimalStr)\n    return digit_sum"}
{"task_id": "Mbpp/726", "solution": "def is_numeric(value) -> bool:\n    \"\"\"Checks if a value is an integer or a float.\"\"\"\n    return isinstance(value, (int, float))\n\ndef _validate_input_tuple(input_tuple: tuple) -> None:\n    \"\"\"Validates the input tuple according to specified rules.\"\"\"\n    if not isinstance(input_tuple, tuple):\n        raise TypeError(\"input_tuple must be a tuple of numeric elements\")\n    if len(input_tuple) < 2:\n        raise ValueError(\"input_tuple must contain at least 2 elements\")\n    for element in input_tuple:\n        if not is_numeric(element):\n            raise TypeError(\"all elements of input_tuple must be numeric (int or float)\")\n\ndef multiply_elements(input_tuple: tuple) -> tuple:\n    \"\"\"\n    Computes pairwise products of adjacent elements in a tuple of numbers.\n    Returns a new tuple where the i-th element is input_tuple[i] * input_tuple[i+1].\n    \"\"\"\n    _validate_input_tuple(input_tuple)\n\n    result = tuple(input_tuple[i] * input_tuple[i+1] for i in range(len(input_tuple) - 1))\n    return result"}
{"task_id": "Mbpp/730", "solution": "from typing import List, Any\n\ndef consecutive_duplicates(input_list: List[Any]) -> List[Any]:\n    \"\"\"Return a list containing the first element of every run of equal adjacent elements in input_list.\"\"\"\n    result = []\n    if not input_list:\n        return result\n\n    result.append(input_list[0])\n    prev_element = input_list[0]\n\n    for item in input_list[1:]:\n        if item != prev_element:\n            result.append(item)\n            prev_element = item\n    return result"}
{"task_id": "Mbpp/728", "solution": "def _validate_lengths(list_a, list_b):\n    \"\"\"Checks if two lists have equal length, raising ValueError if not.\"\"\"\n    if len(list_a) != len(list_b):\n        raise ValueError(\"Input lists must have equal length\")\n\ndef _validate_numeric_elements(list_a, list_b):\n    \"\"\"Checks if all elements in two lists are numeric, raising TypeError if not.\"\"\"\n    for val in list_a + list_b:\n        if not isinstance(val, (int, float)):\n            raise TypeError(\"All elements must be numeric (int or float)\")\n\ndef sum_list(list_a, list_b):\n    \"\"\"\n    Takes two lists of numbers and returns a new list with their element-wise sum.\n    Performs validation for equal length and numeric elements.\n    \"\"\"\n    _validate_lengths(list_a, list_b)\n    _validate_numeric_elements(list_a, list_b)\n\n    result = []\n    for i in range(len(list_a)):\n        result.append(list_a[i] + list_b[i])\n    return result"}
{"task_id": "Mbpp/725", "solution": "from typing import List\n\ndef extract_quotation(input_string: str) -> List[str]:\n    \"\"\"\n    Extracts values between double quotation marks \" \" from the given string.\n    Unmatched trailing quotes are ignored; escaped quotes are not specially handled.\n    \"\"\"\n    extracted_values = []\n    in_quote = False\n    start_index = -1\n\n    for i, char in enumerate(input_string):\n        if char == '\"':\n            if not in_quote:\n                # Found an opening double quote\n                in_quote = True\n                start_index = i + 1\n            else:\n                # Found a closing double quote\n                in_quote = False\n                if start_index != -1: # Ensure a valid opening quote was found\n                    extracted_values.append(input_string[start_index:i])\n                start_index = -1 # Reset for the next potential quoted substring\n\n    return extracted_values"}
{"task_id": "Mbpp/731", "solution": "import math\n\nclass CalculationEngine:\n    \"\"\"Performs geometric calculations for a cone.\"\"\"\n    def computeSlantHeight(self, r: float, h: float) -> float:\n        \"\"\"Calculates the slant height of a cone.\"\"\"\n        return math.sqrt(r*r + h*h)\n\n    def computeLateralSurface(self, r: float, h: float) -> float:\n        \"\"\"Calculates the lateral surface area of a cone.\"\"\"\n        s = self.computeSlantHeight(r, h)\n        return math.pi * r * s\n\ndef lateralsurface_cone(r,h):\n    \"\"\"\n    Calculates the lateral surface area of a cone given radius r and height h.\n    Delegates computation to CalculationEngine.\n    \"\"\"\n    return CalculationEngine().computeLateralSurface(r, h)"}
{"task_id": "Mbpp/732", "solution": "def replace_specialchar(input_string: str) -> str:\n    \"\"\"\n    Replaces all occurrences of spaces, commas, or dots with a colon in the input string.\n    Processes the string in a single pass, building a new string.\n    \"\"\"\n    output_chars = []\n    for char in input_string:\n        if char == ' ' or char == ',' or char == '.':\n            output_chars.append(':')\n        else:\n            output_chars.append(char)\n    return ''.join(output_chars)"}
{"task_id": "Mbpp/733", "solution": "def find_first_occurrence(array, target) -> int:\n    \"\"\"\n    Finds the index of the first occurrence of a target number in a sorted array.\n    Returns -1 if the target is not found.\n    \"\"\"\n    low = 0\n    high = len(array) - 1\n    result = -1\n\n    while low <= high:\n        mid = low + (high - low) // 2  # Prevent potential overflow compared to (low + high) // 2\n\n        if array[mid] == target:\n            result = mid\n            high = mid - 1  # Try to find an earlier occurrence in the left half\n        elif array[mid] < target:\n            low = mid + 1\n        else:  # array[mid] > target\n            high = mid - 1\n            \n    return result"}
{"task_id": "Mbpp/734", "solution": "from typing import List, Union\n\nNumber = Union[int, float]\n\nclass InputList:\n    \"\"\"Encapsulates the input list and provides safe access.\"\"\"\n    def __init__(self, elements: list) -> None:\n        self._elements = elements\n\n    def length(self) -> int:\n        \"\"\"Returns the number of elements in the list.\"\"\"\n        return len(self._elements)\n\n    def isEmpty(self) -> bool:\n        \"\"\"Checks if the list is empty.\"\"\"\n        return not bool(self._elements)\n\n    def get_slice(self, start: int, end: int) -> list:\n        \"\"\"Returns a slice of elements from start to end (inclusive).\"\"\"\n        return self._elements[start : end + 1]\n\nclass Subarray:\n    \"\"\"Represents a contiguous subarray and computes its product.\"\"\"\n    def __init__(self, startIndex: int, endIndex: int, elements: list) -> None:\n        self.startIndex = startIndex\n        self.endIndex = endIndex\n        self.elements = elements\n\n    def product(self) -> Number:\n        \"\"\"Computes the product of all elements in the subarray.\"\"\"\n        prod: Number = 1\n        for x in self.elements:\n            prod *= x\n        return prod\n\nclass Result:\n    \"\"\"Encapsulates the numeric sum-of-products result.\"\"\"\n    def __init__(self, value: Number) -> None:\n        self.value = value\n\n    def asNumber(self) -> Number:\n        \"\"\"Returns the encapsulated numeric value.\"\"\"\n        return self.value\n\nclass SumCalculator:\n    \"\"\"Calculates the sum of products of all possible sublists.\"\"\"\n    def sum_Of_Subarray_Prod(self, lst: List[Number]) -> Number:\n        \"\"\"Computes the sum of products of all contiguous non-empty subarrays.\"\"\"\n        input_list = InputList(lst)\n\n        if input_list.isEmpty():\n            return 0\n\n        total_sum_of_products: Number = 0\n        n = input_list.length()\n\n        for start in range(n):\n            for end in range(start, n):\n                current_sub_elements = input_list.get_slice(start, end)\n                sub = Subarray(start, end, current_sub_elements)\n                product = sub.product()\n                total_sum_of_products += product\n        \n        return Result(total_sum_of_products).asNumber()\n\ndef sum_Of_Subarray_Prod(lst: List[Number]) -> Number:\n    \"\"\"Finds the sum of products of all possible sublists of a given list.\"\"\"\n    calculator = SumCalculator()\n    return calculator.sum_Of_Subarray_Prod(lst)"}
{"task_id": "Mbpp/737", "solution": "import re\n\nVOWEL_PATTERN: str = \"^[aeiou]\"\n\ndef check_str(input: str) -> bool:\n    \"\"\"\n    Checks if the given string starts with a lowercase vowel using regex.\n    Returns True if it starts with 'a', 'e', 'i', 'o', or 'u', otherwise False.\n    \"\"\"\n    return re.match(VOWEL_PATTERN, input) is not None"}
{"task_id": "Mbpp/735", "solution": "class InputNumber:\n    \"\"\"Wraps an input integer and provides bit-related helpers.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\n    def bit_length(self) -> int:\n        return self.value.bit_length()\n\n    def to_bits(self) -> str:\n        # Returns binary string without the '0b' prefix\n        return bin(self.value)[2:]\n\nclass BitRepresentation:\n    \"\"\"Represents a binary string and provides methods to access its parts.\"\"\"\n    def __init__(self, bits: str) -> None:\n        self.bits = bits\n        self.length = len(bits)\n\n    def get_msb(self) -> str:\n        return self.bits[0]\n\n    def get_lsb(self) -> str:\n        return self.bits[-1]\n\n    def get_middle_bits(self) -> str:\n        # Returns the substring between MSB and LSB. Returns empty string if length < 3.\n        if self.length < 3:\n            return \"\"\n        return self.bits[1:-1]\n\nclass ToggleOperation:\n    \"\"\"Provides a stateless operation to toggle middle bits of a binary string.\"\"\"\n    def __init__(self) -> None:\n        pass\n\n    def toggle_middle_bits(self, bits: str) -> str:\n        \"\"\"Toggles all bits between MSB and LSB in the given binary string.\"\"\"\n        bit_rep = BitRepresentation(bits)\n        msb = bit_rep.get_msb()\n        lsb = bit_rep.get_lsb()\n        middle_bits = bit_rep.get_middle_bits()\n\n        toggled_middle = ''.join(['1' if bit == '0' else '0' for bit in middle_bits])\n\n        return msb + toggled_middle + lsb\n\nclass OutputNumber:\n    \"\"\"Converts a binary string back to an integer.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\n    @staticmethod\n    def from_bits(bits: str) -> int:\n        return int(bits, 2)\n\ndef toggle_middle_bits(n: int) -> int:\n    \"\"\"\n    Toggles middle bits of the number, preserving the first and last bit.\n    Returns the original number if its binary representation has fewer than 3 bits.\n    \"\"\"\n    inp = InputNumber(n)\n    bits_str = inp.to_bits()\n\n    if inp.bit_length() < 3:\n        return n\n\n    toggler = ToggleOperation()\n    toggled_full_bits_str = toggler.toggle_middle_bits(bits_str)\n\n    return OutputNumber.from_bits(toggled_full_bits_str)"}
{"task_id": "Mbpp/740", "solution": "def tuple_to_dict(t):\n    \"\"\"Convert a tuple t into a dict by pairing adjacent elements: t[0]->t[1], t[2]->t[3], ...\n\n    Args:\n      t: tuple (expected by design)\n\n    Returns:\n      dict mapping keys to values as described\n    \"\"\"\n    result = {}\n    for i in range(0, len(t), 2):\n        if i + 1 < len(t):\n            result[t[i]] = t[i+1]\n    return result"}
{"task_id": "Mbpp/739", "solution": "class InputValidator:\n    \"\"\"Helper class for input validation.\"\"\"\n    @staticmethod\n    def isInteger(value) -> bool:\n        return isinstance(value, int)\n\n    @staticmethod\n    def isPositiveInteger(n: int) -> bool:\n        return InputValidator.isInteger(n) and n >= 1\n\nclass TriangularNumber:\n    \"\"\"Helper class for triangular number computations and digit counting.\"\"\"\n    @staticmethod\n    def computeValue(k: int) -> int:\n        return k * (k + 1) // 2\n\n    @staticmethod\n    def digitCount(v: int) -> int:\n        if v == 0:\n            return 1\n        return len(str(v))\n\ndef find_Index(n: int) -> int:\n    \"\"\"\n    Finds the index of the smallest triangular number with n digits.\n    Raises ValueError if n is not a positive integer.\n    \"\"\"\n    if not InputValidator.isPositiveInteger(n):\n        raise ValueError(\"Input n must be a positive integer.\")\n\n    k = 1\n    # Initialize previous digit count with T_0, which is 0 and has 1 digit by design.\n    prev_digit_count = TriangularNumber.digitCount(0)\n\n    while True:\n        current_triangular_value = TriangularNumber.computeValue(k)\n        current_digit_count = TriangularNumber.digitCount(current_triangular_value)\n\n        # Check if T_k has n digits and T_{k-1} had fewer than n digits.\n        if current_digit_count == n and prev_digit_count < n:\n            return k\n        \n        prev_digit_count = current_digit_count\n        k += 1"}
{"task_id": "Mbpp/741", "solution": "def all_Characters_Same(input: str) -> bool:\n    \"\"\"\n    Return True when all characters in input are identical, otherwise False.\n\n    Raises:\n        TypeError: if input is not an instance of str (design choice).\n    \"\"\"\n    if not isinstance(input, str):\n        raise TypeError(\"Input must be a string.\")\n\n    if not input:\n        return True\n    \n    return len(set(input)) == 1"}
{"task_id": "Mbpp/742", "solution": "import math\n\nclass Tetrahedron:\n    def __init__(self, edge_length: float) -> None:\n        self.edge_length = edge_length\n\n    def compute_surface_area(self) -> float:\n        return math.sqrt(3) * self.edge_length * self.edge_length\n\nclass CalculationResult:\n    def __init__(self, surface_area: float) -> None:\n        self.surface_area = surface_area\n\ndef area_tetrahedron(a: float) -> float:\n    \"\"\"Compute and return the surface area of a regular tetrahedron with edge length a.\n\n    Formula: surface_area = math.sqrt(3) * a * a\n    \"\"\"\n    tetrahedron = Tetrahedron(edge_length=a)\n    surface_area = tetrahedron.compute_surface_area()\n    result = CalculationResult(surface_area=surface_area)\n    return result.surface_area"}
{"task_id": "Mbpp/736", "solution": "def comparable(a, b) -> bool:\n    \"\"\"Attempts a dummy comparison to check if a and b are mutually comparable.\n    Propagates TypeError if comparison fails.\"\"\"\n    try:\n        _ = a < b # Perform a comparison to trigger TypeError if types are incompatible\n        return True\n    except TypeError:\n        raise\n\ndef binary_search_left(arr, value) -> int:\n    \"\"\"Internal helper for iterative binary search to find the leftmost index where arr[index] >= value.\n    Propagates TypeError if comparisons between elements fail.\"\"\"\n    low = 0\n    high = len(arr)\n\n    while low < high:\n        mid = (low + high) // 2\n        mid_val = arr[mid]\n        \n        # Ensure comparability, propagating TypeError if necessary\n        comparable(mid_val, value) \n        \n        if mid_val < value:\n            low = mid + 1\n        else: # mid_val >= value\n            high = mid\n    return low\n\ndef left_insertion(arr, value) -> int:\n    \"\"\"Locates the left insertion point for a specified value in sorted order.\n    Returns the index where value should be inserted to maintain sorted order.\"\"\"\n    if not arr:\n        return 0\n    return binary_search_left(arr, value)"}
{"task_id": "Mbpp/743", "solution": "def rotate_right(list, k):\n    \"\"\"\n    Rotates a list to the right by k positions.\n\n    The function handles empty lists, normalizes k, and returns a new list without modifying the original.\n    \"\"\"\n    if not list:\n        return []\n\n    n = len(list)\n    effective_k = k % n\n\n    if effective_k == 0:\n        return list[:]\n\n    # Split the list into two parts and concatenate them in rotated order\n    # The last `effective_k` elements come first, followed by the initial `n - effective_k` elements.\n    return list[n - effective_k:] + list[:n - effective_k]"}
