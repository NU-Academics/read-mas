{"task_id": "Mbpp/622", "solution": "class MedianCalculator:\n    def get_median(self, arr1: list, arr2: list, n: int) -> float:\n        \"\"\"Computes the median of two sorted lists by finding the (n-1)-th and n-th elements.\"\"\"\n        a = self._find_kth(arr1, arr2, n - 1)\n        b = self._find_kth(arr1, arr2, n)\n        median_value = (a + b) / 2\n        return float(median_value)\n\n    def _find_kth(self, arr1: list, arr2: list, k: int):\n        \"\"\"Returns the k-th smallest element (0-based) from the combined sorted lists.\"\"\"\n        i = 0\n        j = 0\n        count = 0\n        n1 = len(arr1)\n        n2 = len(arr2)\n        while i < n1 and j < n2:\n            if arr1[i] <= arr2[j]:\n                if count == k:\n                    return arr1[i]\n                i += 1\n            else:\n                if count == k:\n                    return arr2[j]\n                j += 1\n            count += 1\n        while i < n1:\n            if count == k:\n                return arr1[i]\n            i += 1\n            count += 1\n        while j < n2:\n            if count == k:\n                return arr2[j]\n            j += 1\n            count += 1\n\n\ndef get_median(arr1, arr2, n):\n    \"\"\"\n    Finds the median of two sorted lists of the same size.\n    The function delegates to an internal calculator for computation.\n    \"\"\"\n    calc = MedianCalculator()\n    return calc.get_median(arr1, arr2, n)"}
{"task_id": "Mbpp/623", "solution": "from typing import List, Union\n\ndef nth_nums(numbers: List[Union[int, float]], n: int) -> List[Union[int, float]]:\n    \"\"\"\n    Computes the n-th power of each number in a list.\n    Returns a new list with the results.\n    \"\"\"\n    return [number ** n for number in numbers]"}
{"task_id": "Mbpp/626", "solution": "from typing import Optional, Any, Union\nfrom dataclasses import dataclass\n\n@dataclass\nclass Semicircle:\n    radius: float\n\n@dataclass\nclass Triangle:\n    area: float\n\nclass InputValidator:\n    \"\"\"Encapsulates input validation logic.\"\"\"\n    @staticmethod\n    def is_numeric(value: Any) -> bool:\n        \"\"\"Returns True if value is an int or float, but not a bool.\"\"\"\n        return isinstance(value, (int, float)) and not isinstance(value, bool)\n\n    @staticmethod\n    def is_non_negative(value: Union[int, float]) -> bool:\n        \"\"\"Returns True if the numeric value is non-negative.\"\"\"\n        return value >= 0\n\nclass TriangleAreaCalculator:\n    \"\"\"Encapsulates the computation logic for the triangle area.\"\"\"\n    @staticmethod\n    def triangle_area(radius: Union[int, float]) -> float:\n        \"\"\"Computes the area of the largest triangle inscribed in a semicircle.\"\"\"\n        s = Semicircle(radius=float(radius))\n        t = Triangle(area=s.radius * s.radius)\n        return t.area\n\ndef triangle_area(radius: Any) -> Optional[float]:\n    \"\"\"\n    Finds the area of the largest triangle that can be inscribed in a semicircle.\n    Returns None for negative radii and raises TypeError for non-numeric inputs.\n    \"\"\"\n    if not InputValidator.is_numeric(radius):\n        raise TypeError(\"radius must be a numeric type (int or float)\")\n    \n    if not InputValidator.is_non_negative(radius):\n        return None\n        \n    return TriangleAreaCalculator.triangle_area(radius)"}
{"task_id": "Mbpp/629", "solution": "def _is_even(n: int) -> bool:\n    \"\"\"Checks if a number is even.\"\"\"\n    return n % 2 == 0\n\ndef Split(numbers: list) -> list:\n    \"\"\"Finds even numbers from a list of numbers.\"\"\"\n    even_numbers = []\n    for number in numbers:\n        if _is_even(number):\n            even_numbers.append(number)\n    return even_numbers"}
