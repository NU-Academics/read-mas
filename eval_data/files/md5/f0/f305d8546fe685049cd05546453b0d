{"task_id": "Mbpp/745", "solution": "class Digit:\n    \"\"\"Represents a single decimal digit.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\nclass Number:\n    \"\"\"Represents an integer and provides methods to analyze its digits.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n        self.digits = self._extract_digits(value)\n\n    def _extract_digits(self, num: int) -> list[int]:\n        \"\"\"Extracts decimal digits from the number's absolute value.\"\"\"\n        if num == 0:\n            return [0]\n        digits_list = []\n        temp_num = abs(num)\n        while temp_num > 0:\n            digits_list.append(temp_num % 10)\n            temp_num //= 10\n        return digits_list[::-1] # Reverse to get digits in order\n\n    def hasZero(self) -> bool:\n        \"\"\"Checks if any digit in the number is zero.\"\"\"\n        return 0 in self.digits\n\n    def divisibleByDigits(self) -> bool:\n        \"\"\"Checks if the number is divisible by each of its non-zero digits.\"\"\"\n        for digit_val in self.digits:\n            if digit_val == 0:\n                continue # Already handled by hasZero check or explicitly ignored for divisibility\n            if self.value % digit_val != 0:\n                return False\n        return True\n\nclass ResultList:\n    \"\"\"Accumulates qualifying integers and provides sorting.\"\"\"\n    def __init__(self):\n        self.numbers = []\n\n    def add(self, n: int):\n        \"\"\"Adds a number to the list.\"\"\"\n        self.numbers.append(n)\n\n    def sortAscending(self) -> list[int]:\n        \"\"\"Returns the accumulated numbers sorted in ascending order.\"\"\"\n        self.numbers.sort()\n        return self.numbers\n\nclass DivisibleByDigitsFunction:\n    \"\"\"Orchestrates the process of finding numbers divisible by their digits within a range.\"\"\"\n    def __init__(self, startnum: int, endnum: int):\n        self.startnum = startnum\n        self.endnum = endnum\n\n    def execute(self) -> list[int]:\n        \"\"\"Iterates through the range, filters numbers, and returns the sorted result.\"\"\"\n        result_list = ResultList()\n        if self.startnum > self.endnum:\n            return result_list.sortAscending()\n\n        for n in range(self.startnum, self.endnum + 1):\n            number_obj = Number(n)\n            if number_obj.hasZero():\n                continue\n            if number_obj.divisibleByDigits():\n                result_list.add(n)\n        return result_list.sortAscending()\n\ndef divisible_by_digits(startnum: int, endnum: int) -> list[int]:\n    \"\"\"\n    Finds numbers within a given range where every number is divisible by every digit it contains.\n    Numbers containing the digit 0 are excluded from consideration.\n    \"\"\"\n    function_executor = DivisibleByDigitsFunction(startnum, endnum)\n    return function_executor.execute()"}
{"task_id": "Mbpp/749", "solution": "def sort_numeric_strings(input: list[str]) -> list[int]:\n    \"\"\"\n    Converts a list of numeric strings to integers, sorts them numerically,\n    and returns the sorted list of integers.\n    \"\"\"\n    converted_numbers = []\n    for s in input:\n        converted_numbers.append(int(s))\n    converted_numbers.sort()\n    return converted_numbers"}
