{"task_id": "Mbpp/109", "solution": "class BinaryString:\n    def __init__(self, value: str):\n        self.value = value\n        self.length = len(value)\n\n    def isValid(self) -> bool:\n        \"\"\"Checks if the binary string is non-empty and contains only '0' and '1'.\"\"\"\n        if not self.value:\n            return False\n        return all(char in ('0', '1') for char in self.value)\n\n    def rightmostChar(self) -> str:\n        \"\"\"Returns the rightmost character of the binary string.\"\"\"\n        return self.value[-1]\n\nclass Validator:\n    def validateBinaryString(self, binary: BinaryString) -> bool:\n        \"\"\"Validates the content of a BinaryString object.\"\"\"\n        return binary.isValid()\n\n    def validateRotations(self, rotations: int) -> bool:\n        \"\"\"Validates that rotations is a non-negative integer.\"\"\"\n        return isinstance(rotations, int) and rotations >= 0\n\nclass Rotation:\n    def __init__(self, index: int, rotatedValue: str):\n        self.index = index\n        self.rotatedValue = rotatedValue\n\n    def isOdd(self) -> bool:\n        \"\"\"Determines if the rotated value represents an odd integer.\"\"\"\n        return self.rotatedValue[-1] == '1'\n\nclass RotationEngine:\n    def generateRotation(self, binary: BinaryString, index: int) -> Rotation:\n        \"\"\"Generates the initial rotation (index 0).\"\"\"\n        return Rotation(index, binary.value)\n\n    def nextRotation(self, rotation: Rotation) -> Rotation:\n        \"\"\"Generates the next left-circular rotation based on the current one.\"\"\"\n        next_rotated_value = rotation.rotatedValue[1:] + rotation.rotatedValue[0]\n        return Rotation(rotation.index + 1, next_rotated_value)\n\nclass Counter:\n    def countOddRotations(self, binary: BinaryString, rotations: int) -> int:\n        \"\"\"Counts the number of odd-value rotations.\"\"\"\n        odd_count = 0\n        rotation_engine = RotationEngine()\n\n        if rotations == 0:\n            return 0\n\n        current_rotation = rotation_engine.generateRotation(binary, 0)\n        if current_rotation.isOdd():\n            odd_count += 1\n\n        for i in range(1, rotations):\n            current_rotation = rotation_engine.nextRotation(current_rotation)\n            if current_rotation.isOdd():\n                odd_count += 1\n        \n        return odd_count\n\nclass Result:\n    def __init__(self, oddCount: int, rotations: int):\n        self.oddCount = oddCount\n        self.rotations = rotations\n\ndef odd_Equivalent(binary_string, rotations) -> int:\n    \"\"\"\n    Public API: validate inputs; compute and return integer odd rotation count;\n    raise ValueError on invalid inputs.\n    \"\"\"\n    validator = Validator()\n    binary = BinaryString(binary_string)\n\n    if not validator.validateBinaryString(binary):\n        raise ValueError(\"binary_string must be non-empty and contain only '0' and '1'.\")\n\n    if not validator.validateRotations(rotations):\n        raise ValueError(\"rotations must be a non-negative integer.\")\n\n    counter = Counter()\n    odd_count = counter.countOddRotations(binary, rotations)\n\n    return odd_count"}
{"task_id": "Mbpp/120", "solution": "from typing import Iterable\nimport numbers\nfrom .validator import Validator\nfrom .calculator import ProductCalculator\n\ndef max_product_tuple(tuple_list: Iterable) -> numbers.Real:\n    \"\"\"\n    Finds the maximum absolute product between numbers in pairs of tuples within a given list.\n    Validates input using a Validator and computes the result using a ProductCalculator.\n    \"\"\"\n    validator = Validator()\n    validator.validate(tuple_list)\n\n    calculator = ProductCalculator()\n    max_abs_product = calculator.computeMaxAbsProduct(tuple_list)\n\n    return max_abs_product"}
{"task_id": "Mbpp/119", "solution": "from typing import List\n\n# Helper class: SortedArray\nclass SortedArray:\n    \"\"\"Encapsulates the input list and provides sortedness and length checks.\"\"\"\n    def __init__(self, items: List[int]):\n        self.items = items\n\n    def isSorted(self) -> bool:\n        \"\"\"Returns True if items are in non-decreasing order.\"\"\"\n        if not self.items:\n            return True\n        for i in range(len(self.items) - 1):\n            if self.items[i] > self.items[i+1]:\n                return False\n        return True\n\n    def length(self) -> int:\n        \"\"\"Returns number of items.\"\"\"\n        return len(self.items)\n\n# Helper class: Element\nclass Element:\n    \"\"\"Represents a distinct integer value and provides occurrence counting helper.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n        self.occurrences = 0\n\n    def countOccurrences(self, array: List[int]) -> int:\n        \"\"\"Counts and returns occurrences of self.value in array.\"\"\"\n        return array.count(self.value)\n\n# Helper function: validateInput\ndef validateInput(sortedList: List[int]) -> None:\n    \"\"\"\n    Verifies the list is sorted and that exactly one element appears an odd number of times;\n    raises ValueError if validation fails.\n    \"\"\"\n    sa = SortedArray(sortedList)\n    if not sa.isSorted():\n        raise ValueError('Input list is not sorted.')\n\n    if not sortedList:\n        return\n\n    distinct_elements = []\n    distinct_elements.append(sortedList[0])\n    for i in range(1, len(sortedList)):\n        if sortedList[i] != sortedList[i-1]:\n            distinct_elements.append(sortedList[i])\n\n    odd_occurrence_count = 0\n    for val in distinct_elements:\n        el = Element(val)\n        count = el.countOccurrences(sortedList)\n        if count % 2 != 0:\n            odd_occurrence_count += 1\n\n    if odd_occurrence_count != 1:\n        raise ValueError('Incorrect pairing property: exactly one element must appear an odd number of times.')\n\ndef search(sortedList: List[int]) -> int:\n    \"\"\"\n    Finds the element that appears only once in a sorted array where all other elements appear exactly twice.\n    Validates input and raises appropriate errors based on design.\n    \"\"\"\n    validateInput(sortedList)\n\n    if not sortedList:\n        raise LookupError('unique element not found')\n\n    low = 0\n    high = len(sortedList) - 1\n\n    while low < high:\n        mid = (low + high) // 2\n\n        # Ensure mid points to the start of a potential pair or the unique element itself (at an even index).\n        # If mid is odd, decrement it to make it even.\n        if mid % 2 == 1:\n            mid -= 1\n\n        # Compare elements at mid and mid+1\n        if sortedList[mid] == sortedList[mid+1]:\n            # This pair is regular. The unique element must be in the right half (after mid+1).\n            low = mid + 2\n        else:\n            # The unique element is either sortedList[mid] or to its left.\n            # It's at an even index, and doesn't match the next element.\n            # So the unique element is in [low ... mid].\n            high = mid\n            \n    # When the loop terminates, low == high, and sortedList[low] is the unique element.\n    return sortedList[low]"}
{"task_id": "Mbpp/123", "solution": "class Number:\n    \"\"\"Represents a number and computes its sum of proper divisors.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def sumProperDivisors(self) -> int:\n        \"\"\"Computes the sum of proper divisors for the number.\"\"\"\n        if self.value <= 1:\n            return 0\n        s = 1\n        for i in range(2, int(self.value**0.5) + 1):\n            if self.value % i == 0:\n                s += i\n                if i * i != self.value:\n                    s += self.value // i\n        return s\n\n    def isAmicableWith(self, other: \"Number\") -> bool:\n        \"\"\"Checks if this number is amicable with another number.\"\"\"\n        return (self.sumProperDivisors() == other.value and\n                other.sumProperDivisors() == self.value and\n                self.value != other.value)\n\nclass AmicablePair:\n    \"\"\"Represents a candidate amicable pair.\"\"\"\n    def __init__(self, a: int, b: int):\n        self.a = a\n        self.b = b\n\n    def isValid(self) -> bool:\n        \"\"\"Checks if the pair consists of distinct numbers.\"\"\"\n        return self.a != self.b\n\nclass Range:\n    \"\"\"Represents an inclusive interval (min..max) and checks for containment.\"\"\"\n    def __init__(self, min: int, max: int):\n        self.min = min\n        self.max = max\n\n    def contains(self, value: int) -> bool:\n        \"\"\"Checks if a value is within the inclusive range.\"\"\"\n        return self.min <= value <= self.max\n\nclass AmicableFunction:\n    \"\"\"Orchestrates computation: computes divisor sums, identifies amicable pairs, sums valid pairs.\"\"\"\n    def __init__(self):\n        self._n: int = 0\n        self._divisor_sums: dict[int, int] = {}\n        self._pairs: list[AmicablePair] = []\n        self._range: Range | None = None\n\n    def amicable_numbers_sum(self, n: int) -> int:\n        \"\"\"Computes the sum of all amicable numbers up to n.\"\"\"\n        self._n = n\n        self._range = Range(min=1, max=n)\n        self.compute_divisor_sums()\n        self.identify_amicable_pairs()\n        return self.sum_valid_pairs()\n\n    def compute_divisor_sums(self) -> None:\n        \"\"\"Populates the _divisor_sums dictionary for numbers up to _n.\"\"\"\n        for i in range(1, self._n + 1):\n            self._divisor_sums[i] = Number(i).sumProperDivisors()\n\n    def identify_amicable_pairs(self) -> None:\n        \"\"\"Identifies amicable pairs within the precomputed divisor sums.\"\"\"\n        self._pairs = []\n        for a in range(1, self._n + 1):\n            b_candidate = self._divisor_sums.get(a)\n            if b_candidate is not None and b_candidate <= self._n and a != b_candidate:\n                a_candidate = self._divisor_sums.get(b_candidate)\n                if a_candidate == a:\n                    # To avoid duplicate pairs (e.g., (220, 284) and (284, 220)), only add if a < b\n                    if a < b_candidate:\n                        self._pairs.append(AmicablePair(a, b_candidate))\n\n    def sum_valid_pairs(self) -> int:\n        \"\"\"Sums the members of valid amicable pairs within the specified range.\"\"\"\n        total_sum = 0\n        added_numbers = set()\n        for pair in self._pairs:\n            if pair.isValid() and self._range.contains(pair.a) and self._range.contains(pair.b):\n                if pair.a not in added_numbers:\n                    total_sum += pair.a\n                    added_numbers.add(pair.a)\n                if pair.b not in added_numbers:\n                    total_sum += pair.b\n                    added_numbers.add(pair.b)\n        return total_sum\n\nclass TestCase:\n    \"\"\"Represents and runs a test case for amicable number summation.\"\"\"\n    def __init__(self, name: str, input_n: int, expected: int):\n        self.name = name\n        self.input_n = input_n\n        self.expected = expected\n\n    def run(self) -> bool:\n        \"\"\"Invokes amicable_numbers_sum and compares the result to expected.\"\"\"\n        result = amicable_numbers_sum(self.input_n)\n        return result == self.expected\n\ndef amicable_numbers_sum(n: int) -> int:\n    \"\"\"\n    Returns the sum of all amicable numbers in the inclusive range 1..n.\n    Precondition: n is a positive integer >= 1.\n    \"\"\"\n    amicable_func = AmicableFunction()\n    return amicable_func.amicable_numbers_sum(n)"}
{"task_id": "Mbpp/124", "solution": "import math\n\ndef angle_complex(z, imag=None) -> float:\n    \"\"\"\n    Compute the signed angle (argument) of a complex number in radians.\n\n    Allowed call forms:\n      - angle_complex(z: complex) -> float\n      - angle_complex(real: numeric, imag: numeric) -> float\n    \"\"\"\n    def _angle_from_parts(real, imag) -> float:\n        \"\"\"Internal helper that returns math.atan2(imag, real) as a float.\"\"\"\n        return float(math.atan2(imag, real))\n\n    if imag is None:\n        if isinstance(z, complex):\n            real_part = float(z.real)\n            imag_part = float(z.imag)\n            return _angle_from_parts(real_part, imag_part)\n        else:\n            raise TypeError(\"angle_complex expects either a single complex or two numeric arguments\")\n    else:  # two-argument form\n        if isinstance(z, (int, float)) and isinstance(imag, (int, float)):\n            real_part = float(z)\n            imag_part = float(imag)\n            return _angle_from_parts(real_part, imag_part)\n        else:\n            raise TypeError(\"angle_complex expects either a single complex or two numeric arguments\")"}
