{"task_id": "Mbpp/409", "solution": "from typing import Iterable, List, Tuple, Union\n\nclass TuplePair:\n    \"\"\"Represents a two-element tuple and computes its product.\"\"\"\n    def __init__(self, a: int, b: int):\n        self._a = a\n        self._b = b\n\n    def product(self) -> int:\n        \"\"\"Computes the product of the two elements.\"\"\"\n        return self._a * self._b\n\nclass ProductResult:\n    \"\"\"Holds and exposes the computed minimum product.\"\"\"\n    def __init__(self, min_value: int):\n        self._min_value = min_value\n\n    def value(self) -> int:\n        \"\"\"Returns the stored minimum value.\"\"\"\n        return self._min_value\n\nclass MinProductService:\n    \"\"\"Computes products for input pairs and returns the minimum product.\"\"\"\n    def compute_min_product(self, pairs: Iterable[Union[Tuple[int, int], TuplePair]]) -> int:\n        \"\"\"\n        Computes the minimum product from a list of pairs.\n        Each pair can be a tuple (int, int) or a TuplePair object.\n        \"\"\"\n        min_product_value = float('inf')\n\n        for item in pairs:\n            if isinstance(item, TuplePair):\n                current_product = item.product()\n            else: # Assumes item is a Tuple[int, int] based on design context and type hints\n                tuple_pair_instance = TuplePair(item[0], item[1])\n                current_product = tuple_pair_instance.product()\n\n            if current_product < min_product_value:\n                min_product_value = current_product\n        \n        result_obj = ProductResult(int(min_product_value))\n        return result_obj.value()\n\ndef min_product_tuple(pairs: Iterable[Tuple[int, int]]) -> int:\n    \"\"\"\n    Finds the minimum product from the pairs of tuples within a given list.\n    Delegates to MinProductService for computation.\n    \"\"\"\n    service = MinProductService()\n    return service.compute_min_product(pairs)"}
{"task_id": "Mbpp/410", "solution": "def is_numeric(value) -> bool:\n    \"\"\"\n    Checks if a value is an integer or a float, excluding booleans.\n    \"\"\"\n    return isinstance(value, (int, float)) and not isinstance(value, bool)\n\ndef min_val(lst):\n    \"\"\"\n    Finds the minimum numeric value (int or float) in a heterogeneous list,\n    ignoring non-numeric elements and booleans.\n    \"\"\"\n    numeric_elements = [item for item in lst if is_numeric(item)]\n    return min(numeric_elements)"}
