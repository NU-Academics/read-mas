{"task_id": "Mbpp/786", "solution": "from typing import List, Protocol, TypeVar\n\n# Define a TypeVar bound to Comparable for type hinting\nT = TypeVar('T', bound='Comparable')\n\n# Define the Comparable Protocol as specified in the design\nclass Comparable(Protocol):\n    \"\"\"\n    Protocol for types that support comparison operations, required for sorting.\n    \"\"\"\n    def __lt__(self, other: any) -> bool: ...\n    def __le__(self, other: any) -> bool: ...\n    def __eq__(self, other: any) -> bool: ...\n    def __gt__(self, other: any) -> bool: ...\n    def __ge__(self, other: any) -> bool: ...\n\nclass SortedList:\n    \"\"\"\n    A lightweight wrapper around a native Python list, providing controlled access\n    for length and element retrieval as specified in the design.\n    \"\"\"\n    def __init__(self, items: List[T]) -> None:\n        self.items = items\n\n    def length(self) -> int:\n        return len(self.items)\n\n    def get(self, i: int) -> T:\n        return self.items[i]\n\n    def __len__(self) -> int:\n        return len(self.items)\n\nclass InsertionIndex:\n    \"\"\"\n    A conceptual value object for an insertion index, included for traceability\n    to analysis but not directly returned by the main function.\n    \"\"\"\n    def __init__(self, index: int) -> None:\n        self.index = index\n\nclass RightInsertionFunction:\n    \"\"\"\n    Encapsulates the algorithm for finding the right insertion point using\n    an upper-bound binary search.\n    \"\"\"\n    def execute(self, sorted_list_wrapper: SortedList, value: T) -> int:\n        low = 0\n        high = sorted_list_wrapper.length()\n\n        while low < high:\n            mid = low + (high - low) // 2\n            # For right insertion (upper bound), we move 'low' past elements <= value\n            if sorted_list_wrapper.get(mid) <= value:\n                low = mid + 1\n            else:\n                high = mid\n        return low\n\ndef right_insertion(sorted_list: List[T], value: T) -> int:\n    \"\"\"\n    Locates the right insertion point for a specified value in a sorted list.\n    Returns the index where the value can be inserted to maintain sorted order,\n    placing new equal values to the right of existing equal values.\n    \"\"\"\n    wrapper = sorted_list if isinstance(sorted_list, SortedList) else SortedList(sorted_list)\n    return RightInsertionFunction().execute(wrapper, value)"}
{"task_id": "Mbpp/790", "solution": "def even_position(input_list: list) -> bool:\n    \"\"\"\n    Checks if every element at an even index in the given list is an even number.\n    Returns True if all even-indexed elements are even; otherwise, returns False.\n    \"\"\"\n    for i in range(len(input_list)):\n        if i % 2 == 0:  # Check if the current index is even\n            if input_list[i] % 2 != 0:  # Check if the number at this even index is odd\n                return False\n    return True"}
{"task_id": "Mbpp/791", "solution": "def remove_nested(input_tuple: tuple) -> tuple:\n    \"\"\"\n    Removes top-level tuple elements from the given tuple.\n    Returns a new tuple containing only the non-tuple elements in their original order.\n    \"\"\"\n    if not isinstance(input_tuple, tuple):\n        raise TypeError(\"Input must be a tuple.\")\n\n    return tuple(item for item in input_tuple if not isinstance(item, tuple))"}
{"task_id": "Mbpp/792", "solution": "class Validator:\n    \"\"\"Encapsulates input validation logic.\"\"\"\n    def validate_input(self, input_obj) -> bool:\n        \"\"\"Returns True if the input is a list, False otherwise.\"\"\"\n        return isinstance(input_obj, list)\n\nclass ListInput:\n    \"\"\"Wrapper for an input list providing a length method.\"\"\"\n    def __init__(self, elements: list) -> None:\n        self.elements = elements\n\n    def length(self) -> int:\n        \"\"\"Returns the number of elements in the wrapped list.\"\"\"\n        return len(self.elements)\n\nclass CountList:\n    \"\"\"Implements the logic to count top-level elements of a list.\"\"\"\n    def __init__(self, validator: Validator):\n        self._validator = validator\n\n    def count(self, input_list_wrapper: ListInput) -> int:\n        \"\"\"Computes the number of top-level elements using the ListInput wrapper's length.\"\"\"\n        return input_list_wrapper.length()\n\ndef count_list(input_list) -> int:\n    \"\"\"\n    Counts the number of top-level elements in a given list.\n    Raises TypeError if the input is not a list.\n    \"\"\"\n    validator = Validator()\n    if not validator.validate_input(input_list):\n        raise TypeError('input must be a list')\n\n    li = ListInput(input_list)\n    counter = CountList(validator)\n    count = counter.count(li)\n    return int(count)"}
{"task_id": "Mbpp/793", "solution": "def last(array, element):\n    \"\"\"\n    Finds the last position of an element in a sorted array using binary search.\n    Returns the zero-based index of the last occurrence, or -1 if not found.\n    \"\"\"\n    low = 0\n    high = len(array) - 1\n    result = -1\n\n    while low <= high:\n        mid = low + (high - low) // 2\n        if array[mid] == element:\n            result = mid\n            low = mid + 1  # Try to find further occurrences in the right half\n        elif array[mid] < element:\n            low = mid + 1\n        else:  # array[mid] > element\n            high = mid - 1\n    return result"}
{"task_id": "Mbpp/794", "solution": "import re\n\nclass InputString:\n    \"\"\"Value object representing an input string and providing its length.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the encapsulated string.\"\"\"\n        return len(self.value)\n\nclass MatchResult:\n    \"\"\"Value object representing the outcome of a pattern match.\"\"\"\n    def __init__(self, matched: bool):\n        self.matched = matched\n\nclass TextStartAEndB:\n    \"\"\"Encapsulates the logic to match strings starting with 'a' and ending with 'b'.\"\"\"\n    name: str = \"text_starta_endb\"\n    _pattern: re.Pattern = re.compile(r\"^a.*b$\")\n\n    def match(self, text: str) -> MatchResult:\n        \"\"\"Evaluates if the given text matches the pattern and returns the result.\"\"\"\n        # For simplicity, InputString is not explicitly instantiated here as re.match directly uses the string.\n        match_obj = self._pattern.match(text)\n        return MatchResult(matched=bool(match_obj))\n\ndef text_starta_endb(text: str) -> bool:\n    \"\"\"\n    Checks if a string starts with 'a', is followed by anything, and ends with 'b'.\n    This function delegates the actual matching logic to the TextStartAEndB domain class.\n    \"\"\"\n    matcher = TextStartAEndB()\n    result = matcher.match(text)\n    return result.matched"}
{"task_id": "Mbpp/796", "solution": "def return_sum(input_dict):\n    \"\"\"\n    Computes the sum of all numeric values in the given dictionary.\n    Raises TypeError if input is not a dict or if any value is not numeric.\n    \"\"\"\n    if not isinstance(input_dict, dict):\n        raise TypeError(\"input must be a dict\")\n\n    # Validate all values are numeric (int or float)\n    for value in input_dict.values():\n        if not isinstance(value, (int, float)):\n            raise TypeError(\"all dictionary values must be numeric\")\n\n    # The built-in sum() function handles empty iterables (returns 0)\n    # and correctly manages int/float type promotion.\n    return sum(input_dict.values())"}
{"task_id": "Mbpp/798", "solution": "from dataclasses import dataclass\nfrom typing import List, Union\n\n@dataclass\nclass NumericList:\n    elements: List[Union[int, float]]\n\n@dataclass\nclass SumResult:\n    value: Union[int, float]\n\ndef _sum(numbers: List[Union[int, float]]) -> Union[int, float]:\n    \"\"\"Calculates the arithmetic sum of a list of numeric values.\n    It relies on Python's built-in `sum()` function, which handles empty lists by returning 0 and type coercion.\n    \"\"\"\n    return sum(numbers)"}
{"task_id": "Mbpp/797", "solution": "from typing import List\n\nclass Validator:\n    \"\"\"Provides utility methods for validating natural numbers and range order.\"\"\"\n    def validate_natural(self, num: int) -> bool:\n        \"\"\"Checks if a number is a natural number (positive integer).\"\"\"\n        return num >= 1\n\n    def validate_order(self, l: int, r: int) -> bool:\n        \"\"\"Checks if the left bound is less than or equal to the right bound.\"\"\"\n        return l <= r\n\nclass Range:\n    \"\"\"Immutable data holder for an inclusive range [l, r], with a validity check.\"\"\"\n    def __init__(self, l: int, r: int):\n        self.l = l\n        self.r = r\n        self._validator = Validator()\n\n    def is_valid(self) -> bool:\n        \"\"\"Checks if the range bounds are natural numbers and in correct order.\"\"\"\n        return (self._validator.validate_natural(self.l) and\n                self._validator.validate_natural(self.r) and\n                self._validator.validate_order(self.l, self.r))\n\nclass OddNumberGenerator:\n    \"\"\"Generates a list of odd natural numbers within a given inclusive range.\"\"\"\n    def generate_odds(self, l: int, r: int) -> List[int]:\n        \"\"\"Generates all odd numbers in the range [l, r].\"\"\"\n        odds = []\n        start = l\n        if start % 2 == 0:\n            start += 1\n        \n        for num in range(start, r + 1, 2):\n            odds.append(num)\n        return odds\n\nclass Result:\n    \"\"\"A value object to hold the computed total sum.\"\"\"\n    def __init__(self, total: int):\n        self.total = total\n\nclass SumFunction:\n    \"\"\"Orchestrates validation, odd number generation, and summation.\"\"\"\n    def sum_in_range(self, l: int, r: int) -> int:\n        \"\"\"Calculates the sum of all odd natural numbers in the inclusive range [l, r].\"\"\"\n        current_range = Range(l, r)\n        if not current_range.is_valid():\n            return 0\n\n        odd_generator = OddNumberGenerator()\n        odd_numbers = odd_generator.generate_odds(l, r)\n        \n        total_sum = sum(odd_numbers)\n        result = Result(total_sum)\n        \n        return result.total\n\ndef sum_in_range(l: int, r: int) -> int:\n    \"\"\"\n    Finds the sum of all odd natural numbers within the range l and r.\n    This function validates inputs and computes the sum, returning 0 for invalid ranges.\n    \"\"\"\n    return SumFunction().sum_in_range(l, r)"}
{"task_id": "Mbpp/800", "solution": "def remove_all_spaces(input: str) -> str:\n    \"\"\"Removes all whitespace characters from a string.\"\"\"\n    if not isinstance(input, str):\n        raise TypeError(\"Input must be a string.\")\n    return ''.join(ch for ch in input if not ch.isspace())"}
{"task_id": "Mbpp/799", "solution": "def left_rotate(value: int, d: int) -> int:\n    \"\"\"\n    Rotates the bits of a 32-bit number left by d positions.\n    The result is masked to ensure it remains within 32 bits.\n    \"\"\"\n    MASK_32 = 0xFFFFFFFF\n\n    # Enforce 32-bit view of the value\n    v32 = value & MASK_32\n\n    # Reduce rotation count modulo 32\n    k = d % 32\n\n    # If k is 0, no effective rotation, return original value (masked)\n    if k == 0:\n        return v32\n\n    # Perform the left rotation: bits shifted out from the left re-enter from the right.\n    # The final mask ensures the result fits within 32 bits, handling potential overflow from << k.\n    rotated = ((v32 << k) | (v32 >> (32 - k))) & MASK_32\n    return rotated"}
{"task_id": "Mbpp/804", "solution": "def is_product_even(numbers) -> bool:\n    \"\"\"Return True if any element in 'numbers' is even, otherwise False.\n    'numbers' is expected to be an iterable of numeric values (integers implied).\"\"\"\n    for n in numbers:\n        if n % 2 == 0:\n            return True\n    return False"}
{"task_id": "Mbpp/803", "solution": "import math\n\ndef is_perfect_square(n: int) -> bool:\n    \"\"\"\n    Checks if the given integer n is a perfect square.\n    Negative numbers are not considered perfect squares.\n    \"\"\"\n    if n < 0:\n        return False\n    \n    # Calculate the integer square root\n    root = math.isqrt(n)\n    \n    # A number is a perfect square if the square of its integer square root equals the number itself.\n    return root * root == n"}
{"task_id": "Mbpp/801", "solution": "def test_three_equal(a: int, b: int, c: int) -> int:\n    \"\"\"Return count of equal numbers among a, b, c. Possible returns: 3, 2, 0.\"\"\"\n    if a == b and b == c:\n        return 3\n    elif a == b or a == c or b == c:\n        return 2\n    else:\n        return 0"}
{"task_id": "Mbpp/805", "solution": "from typing import List, Iterator\nimport numbers\n\nclass InnerList:\n    \"\"\"Wraps an inner list and computes its numeric sum.\"\"\"\n    def __init__(self, elements: list):\n        self._elements = elements\n\n    def sum(self) -> numbers.Number:\n        return sum(self._elements)\n\nclass InputList:\n    \"\"\"Provides iteration over inner lists without performing validation checks.\"\"\"\n    def __init__(self, list_of_lists: List[list]):\n        self._list_of_lists = list_of_lists\n\n    def validate(self) -> None:\n        # As per prompt constraint, no isinstance() checks or exceptions are added here.\n        pass\n\n    def __iter__(self) -> Iterator[InnerList]:\n        for inner_list_ref in self._list_of_lists:\n            yield InnerList(inner_list_ref)\n\nclass MaxSumListFunction:\n    \"\"\"Encapsulates the algorithm to find the inner list with the maximal sum.\"\"\"\n    def compute(self, list_of_lists: List[list]) -> list:\n        input_wrapper = InputList(list_of_lists)\n        input_wrapper.validate() # Validation method is called but performs no checks due to constraints.\n\n        max_sum = float('-inf')\n        max_sum_list_ref = None\n\n        for inner_list_ref in list_of_lists:\n            inner_list_wrapper = InnerList(inner_list_ref)\n            current_sum = inner_list_wrapper.sum()\n\n            # Selects the first occurrence in case of a tie for maximum sum.\n            if current_sum > max_sum:\n                max_sum = current_sum\n                max_sum_list_ref = inner_list_ref\n        \n        return max_sum_list_ref\n\ndef max_sum_list(list_of_lists: List[list]) -> list:\n    \"\"\"\n    Returns the list in a list of lists whose sum of elements is the highest.\n    Assumes valid input (list of lists of numbers) based on prompt constraints.\n    \"\"\"\n    return MaxSumListFunction().compute(list_of_lists)"}
{"task_id": "Mbpp/806", "solution": "class StringInput:\n    \"\"\"Represents the input string and provides length access.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the string.\"\"\"\n        return len(self.value)\n\nclass UppercaseCharacter:\n    \"\"\"Represents a single character and determines if it is an uppercase ASCII letter.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n\n    def is_uppercase(self) -> bool:\n        \"\"\"Returns True if the character is an uppercase ASCII letter (A-Z).\"\"\"\n        return 'A' <= self.value <= 'Z'\n\nclass UppercaseRun:\n    \"\"\"Represents a contiguous run of uppercase characters.\"\"\"\n    def __init__(self, start_index: int, end_index: int):\n        self.start_index = start_index\n        self.end_index = end_index\n        self.length = self.compute_length()\n\n    def compute_length(self) -> int:\n        \"\"\"Computes the length of the run.\"\"\"\n        return self.end_index - self.start_index + 1\n\nclass MaxRunResult:\n    \"\"\"Represents the maximum length of uppercase runs.\"\"\"\n    def __init__(self, max_length: int):\n        self.max_length = max_length\n\nclass MaxRunUppercaseFunction:\n    \"\"\"Contains the algorithm to scan a StringInput and produce a MaxRunResult.\"\"\"\n    def execute(self, input_obj: 'StringInput') -> 'MaxRunResult':\n        \"\"\"Scans the input string for the maximum run of uppercase characters.\"\"\"\n        max_run_length = 0\n        current_run_length = 0\n\n        for char_value in input_obj.value:\n            uppercase_char = UppercaseCharacter(char_value)\n            if uppercase_char.is_uppercase():\n                current_run_length += 1\n            else:\n                max_run_length = max(max_run_length, current_run_length)\n                current_run_length = 0\n        \n        # Check for a run that extends to the end of the string\n        max_run_length = max(max_run_length, current_run_length)\n        \n        return MaxRunResult(max_run_length)\n\ndef max_run_uppercase(input_string: str) -> int:\n    \"\"\"\n    Finds the maximum run of uppercase characters in the given string.\n    \"\"\"\n    string_input_obj = StringInput(input_string)\n    max_run_func = MaxRunUppercaseFunction()\n    result = max_run_func.execute(string_input_obj)\n    return result.max_length"}
