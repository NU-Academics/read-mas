{"task_id": "Mbpp/453", "solution": "from typing import List\n\nclass Number:\n    \"\"\"Value object representing the input integer and parity helper.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\n    def isEven(self) -> bool:\n        \"\"\"Checks if the number's value is even.\"\"\"\n        return self.value % 2 == 0\n\nclass Divisor:\n    \"\"\"Value object for a divisor and parity helper.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\n    def isEven(self) -> bool:\n        \"\"\"Checks if the divisor's value is even.\"\"\"\n        return self.value % 2 == 0\n\nclass CalculationResult:\n    \"\"\"Container for Number and its computed sum of even divisors.\"\"\"\n    def __init__(self, number: 'Number', sumEvenDivisors: int) -> None:\n        self.number = number\n        self.sumEvenDivisors = sumEvenDivisors\n\nclass FactorCalculator:\n    \"\"\"Encapsulates divisor generation and summation logic. Stateless.\"\"\"\n    def _isDivisor(self, n: int, d: int) -> bool:\n        \"\"\"Checks if d is a divisor of n.\"\"\"\n        return n % d == 0\n\n    def _getDivisors(self, n: int) -> List[int]:\n        \"\"\"Generates all positive integer divisors of n.\"\"\"\n        divisors = []\n        for i in range(1, n + 1):\n            if self._isDivisor(n, i):\n                divisors.append(i)\n        return divisors\n\n    def sumofFactors(self, n: int) -> int:\n        \"\"\"\n        Computes the sum of all even positive divisors of n.\n        Filters divisors to even ones and sums them.\n        \"\"\"\n        all_divisors = self._getDivisors(n)\n        sum_even = 0\n        for d_value in all_divisors:\n            divisor_obj = Divisor(d_value)\n            if divisor_obj.isEven():\n                sum_even += d_value\n        return sum_even\n\ndef sumofFactors(n: int) -> int:\n    \"\"\"\n    Returns the sum of all even positive divisors of a number n.\n    Delegates the calculation to a FactorCalculator instance.\n    \"\"\"\n    calculator = FactorCalculator()\n    return calculator.sumofFactors(n)"}
{"task_id": "Mbpp/456", "solution": "from typing import List\n\nclass ReverseStringService:\n    def reverse_string_list(self, inputList: List[str]) -> List[str]:\n        \"\"\"Reverses each string in the input list, preserving order and length.\"\"\"\n        return [s[::-1] for s in inputList]\n\ndef reverse_string_list(inputList: List[str]) -> List[str]:\n    \"\"\"Public API to reverse each string in a list, delegating to a service.\"\"\"\n    svc = ReverseStringService()\n    return svc.reverse_string_list(inputList)"}
{"task_id": "Mbpp/458", "solution": "class Rectangle:\n    def __init__(self, length: float, width: float) -> None:\n        self.length = length\n        self.width = width\n        self.area = 0.0\n\n    def computeArea(self) -> float:\n        \"\"\"Calculates and updates the area of the rectangle.\"\"\"\n        self.area = self.length * self.width\n        return self.area\n\ndef rectangle_area(length: float, width: float) -> float:\n    \"\"\"Computes the area of a rectangle using the Rectangle domain class.\"\"\"\n    rectangle = Rectangle(length, width)\n    return rectangle.computeArea()"}
{"task_id": "Mbpp/457", "solution": "import collections\nfrom typing import List, Any\n\n\nclass Sublist:\n    \"\"\"Lightweight wrapper for an individual sublist providing a length accessor.\"\"\"\n    def __init__(self, elements: List[Any]):\n        self._elements = elements\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the underlying elements.\"\"\"\n        return len(self._elements)\n\n\nclass SublistCollection:\n    \"\"\"Encapsulates a collection of sublists and provides an operation to compute the minimum-length sublist.\"\"\"\n    def __init__(self, sublists: List[List[Any]]):\n        self._sublists = sublists\n\n    def get_min_length_sublist(self) -> list:\n        \"\"\"Computes and returns the first sublist having minimum length among _sublists.\"\"\"\n        if not self._sublists:\n            # This case is handled by Find_Min's initial validation, but included for completeness.\n            raise ValueError(\"No sublists to evaluate.\")\n\n        min_length = float('inf')\n        min_sublist = None\n\n        for sublist_elements in self._sublists:\n            # Wrap the sublist using the Sublist class to access its length\n            current_sublist = Sublist(sublist_elements)\n            current_length = current_sublist.length()\n\n            if current_length < min_length:\n                min_length = current_length\n                min_sublist = sublist_elements # Store reference to the original sublist\n\n        return min_sublist\n\n\ndef Find_Min(sublists) -> list:\n    \"\"\"Find_Min(sublists) : list\n    Validates input and returns the minimum-length sublist.\n    Raises:\n      - TypeError: if top-level argument is not a list or any element is not a list\n      - ValueError: if the top-level list is empty\n    \"\"\"\n    if not isinstance(sublists, list):\n        raise TypeError(\"Top-level input must be a list.\")\n    if not sublists:\n        raise ValueError(\"No sublists to evaluate.\")\n\n    for item in sublists:\n        if not isinstance(item, list):\n            raise TypeError(\"Each element of the top-level list must be a list.\")\n\n    collection = SublistCollection(sublists)\n    return collection.get_min_length_sublist()"}
{"task_id": "Mbpp/459", "solution": "class Character:\n    \"\"\"Encapsulates a single character and provides classification.\"\"\"\n    def __init__(self, ch: str):\n        self.ch = ch\n\n    def is_uppercase(self) -> bool:\n        \"\"\"Checks if the character is an uppercase letter (A-Z).\"\"\"\n        return 'A' <= self.ch <= 'Z'\n\nclass InputString:\n    \"\"\"Read-only wrapper around the input string.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the wrapped string.\"\"\"\n        return len(self.value)\n\n    def get_char(self, index: int) -> str:\n        \"\"\"Returns the character at the specified index.\"\"\"\n        return self.value[index]\n\nclass OutputString:\n    \"\"\"Buffers preserved characters and builds the result string.\"\"\"\n    def __init__(self):\n        self._buffer = []\n\n    def append_char(self, c: str) -> None:\n        \"\"\"Appends a character to the internal buffer.\"\"\"\n        self._buffer.append(c)\n\n    def to_string(self) -> str:\n        \"\"\"Joins the buffered characters to form the final string.\"\"\"\n        return \"\".join(self._buffer)\n\nclass StringProcessor:\n    \"\"\"Processes an input string to remove uppercase characters.\"\"\"\n    def remove_uppercase(self, input_str: str) -> str:\n        \"\"\"Iterates through the input, classifies characters, and assembles output.\"\"\"\n        input_string = InputString(input_str)\n        output_string = OutputString()\n\n        for i in range(input_string.length()):\n            char_val = input_string.get_char(i)\n            char_obj = Character(char_val)\n            if not char_obj.is_uppercase():\n                output_string.append_char(char_val)\n\n        return output_string.to_string()\n\ndef remove_uppercase(input: str) -> str:\n    \"\"\"\n    Removes all uppercase substrings from the given string.\n    Delegates processing to a StringProcessor instance.\n    \"\"\"\n    processor = StringProcessor()\n    return processor.remove_uppercase(input)"}
{"task_id": "Mbpp/460", "solution": "def Extract(input_list):\n    \"\"\"Accepts a single positional argument 'input_list' (a list of sublists) and returns\n    a list containing the first element of each sublist in input order.\n    Behavior for empty or malformed sublists is unspecified in SRS; this implementation\n    uses Python's default behavior (IndexError / TypeError) if encountered.\n    \"\"\"\n    return [sublist[0] for sublist in input_list]"}
{"task_id": "Mbpp/465", "solution": "from typing import Dict, Any\n\ndef drop_empty(input_dict: Dict[Any, Any]) -> Dict[Any, Any]:\n    \"\"\"Return a new dict containing only key: value pairs from input_dict where value is not None.\"\"\"\n    return {k: v for k, v in input_dict.items() if v is not None}"}
{"task_id": "Mbpp/470", "solution": "from typing import Tuple, Any\n\nclass ValidationError(Exception):\n    \"\"\"Custom exception for validation errors.\"\"\"\n    def __init__(self, message: str) -> None:\n        self.message = message\n        super().__init__(self.message)\n\ndef _validate_input(input_tuple: tuple) -> None:\n    \"\"\"Validates the input tuple and its elements.\"\"\"\n    if not isinstance(input_tuple, tuple):\n        raise ValidationError(\"Input must be a tuple.\")\n    for item in input_tuple:\n        if not isinstance(item, (int, float)):\n            raise ValidationError(\"All elements in the tuple must be numeric.\")\n\ndef _compute_pairwise(input_tuple: tuple) -> tuple:\n    \"\"\"Computes pairwise sums of neighboring elements.\"\"\"\n    if len(input_tuple) < 2:\n        return ()\n    return tuple(input_tuple[i] + input_tuple[i+1] for i in range(len(input_tuple) - 1))\n\ndef add_pairwise(input_tuple: tuple) -> tuple:\n    \"\"\"\n    Finds the pairwise addition of the neighboring elements of the given tuple.\n    Raises ValidationError if the input is not a tuple or contains non-numeric elements.\n    \"\"\"\n    _validate_input(input_tuple)\n    return _compute_pairwise(input_tuple)"}
{"task_id": "Mbpp/463", "solution": "from typing import List\nfrom numbers import Number\n\ndef max_subarray_product(arr: List[Number]) -> Number:\n    \"\"\"Finds the maximum product of a contiguous subarray in the given array.\n    Uses dynamic programming to track current maximum and minimum products.\"\"\"\n    overall_max = arr[0]\n    current_max = arr[0]\n    current_min = arr[0]\n\n    for i in range(1, len(arr)):\n        num = arr[i]\n        \n        # Store the current_max before it's updated, as it's needed for current_min calculation\n        temp_current_max = current_max\n        \n        # Update current_max and current_min considering the current number\n        current_max = max(num, current_max * num, current_min * num)\n        current_min = min(num, temp_current_max * num, current_min * num)\n        \n        # Update the overall maximum product found so far\n        overall_max = max(overall_max, current_max)\n        \n    return overall_max"}
{"task_id": "Mbpp/462", "solution": "from typing import List, Any\n\ndef _validate_input(input_list: list) -> None:\n    \"\"\"Raises TypeError if input_list is not an instance of list.\"\"\"\n    if not isinstance(input_list, list):\n        raise TypeError(\"Input must be a list.\")\n\ndef _compute_index_combinations(n: int) -> List[List[int]]:\n    \"\"\"Generates all combinations of indices from 0 to n-1 using bitmasks.\"\"\"\n    index_combos = []\n    for i in range(1 << n):  # Iterate from 0 to 2^n - 1\n        current_combo = []\n        for j in range(n):\n            if (i >> j) & 1:  # Check if the j-th bit is set\n                current_combo.append(j)\n        index_combos.append(current_combo)\n    return index_combos\n\ndef _order_combinations_by_pattern(index_combos: List[List[int]]) -> List[List[int]]:\n    \"\"\"\n    Reorders index combinations into the deterministic pattern by sorting indices\n    within each combination descending, then sorting the combinations lexicographically.\n    \"\"\"\n    # Sort indices within each combination in descending order\n    processed_combos = [sorted(combo, reverse=True) for combo in index_combos]\n    \n    # Sort the list of combinations lexicographically using their tuple representation\n    processed_combos.sort(key=tuple)\n    return processed_combos\n\ndef _order_items_by_desc_indices(indices: List[int], input_list: list) -> list:\n    \"\"\"\n    Maps indices to elements from input_list, returning them in the order\n    given by the (descending) indices list.\n    \"\"\"\n    return [input_list[i] for i in indices]\n\ndef combinations_list(input_list: list) -> List[List[Any]]:\n    \"\"\"\n    Finds all possible combinations of the elements of a given list,\n    ordered according to a specified pattern: combinations are grouped by\n    inclusion of later indices first, and elements within each combination\n    are ordered by descending original index.\n    \"\"\"\n    _validate_input(input_list)\n\n    n = len(input_list)\n    \n    # Generate all index-based combinations in an initial order\n    initial_index_combos = _compute_index_combinations(n)\n    \n    # Order these index combinations to match the example pattern\n    ordered_index_combos = _order_combinations_by_pattern(initial_index_combos)\n    \n    # Map ordered index combinations to actual values from the input list\n    final_combinations = []\n    for indices in ordered_index_combos:\n        final_combinations.append(_order_items_by_desc_indices(indices, input_list))\n            \n    return final_combinations"}
{"task_id": "Mbpp/471", "solution": "def find_remainder(array, n):\n    \"\"\"\n    Calculates the product of array elements modulo n using per-step modular reduction.\n    Assumes valid inputs: array is a list of integers, n is an integer greater than 0.\n    \"\"\"\n    current_product = 1\n    for element in array:\n        current_product = (current_product * element) % n\n    return current_product"}
{"task_id": "Mbpp/472", "solution": "from typing import List\n\nclass ConsecutiveChecker:\n    \"\"\"Encapsulates the adjacency evaluation algorithm.\"\"\"\n    def check_Consecutive(self, elements: List[int]) -> bool:\n        \"\"\"Return True if every adjacent pair satisfies elements[i] == elements[i-1] + 1; otherwise False.\"\"\"\n        if len(elements) <= 1:\n            return True\n        for i in range(1, len(elements)):\n            if elements[i] != elements[i-1] + 1:\n                return False\n        return True\n\ndef check_Consecutive(elements: list) -> bool:\n    \"\"\"Validate input and return whether elements are consecutive by +1 in provided order.\"\"\"\n    if not isinstance(elements, list):\n        raise TypeError(\"elements must be a list of integers\")\n    if any(not isinstance(x, int) for x in elements):\n        raise TypeError(\"elements must be a list of integers\")\n    \n    checker = ConsecutiveChecker()\n    return checker.check_Consecutive(elements)"}
{"task_id": "Mbpp/468", "solution": "class Element:\n    \"\"\"Represents an element with its value and original index.\"\"\"\n    def __init__(self, value, index):\n        self.value = value\n        self.index = index\n\nclass InputArray:\n    \"\"\"A wrapper for the input list of numbers.\"\"\"\n    def __init__(self, numbers):\n        self.numbers = numbers\n\n    def length(self):\n        \"\"\"Returns the number of elements in the array.\"\"\"\n        return len(self.numbers)\n\nclass Subsequence:\n    \"\"\"Represents a subsequence of elements.\"\"\"\n    def __init__(self, elements):\n        self.elements = elements\n\n    def isStrictlyIncreasing(self):\n        \"\"\"Checks if the subsequence is strictly increasing.\"\"\"\n        if len(self.elements) < 2:\n            return True\n        for i in range(1, len(self.elements)):\n            if self.elements[i].value <= self.elements[i-1].value:\n                return False\n        return True\n\n    def product(self):\n        \"\"\"Calculates the product of elements in the subsequence.\"\"\"\n        if not self.elements:\n            return 1.0 # This case should ideally not be reached based on problem constraints\n        prod_val = 1.0\n        for element in self.elements:\n            prod_val *= element.value\n        return prod_val\n\nclass ProductCalculator:\n    \"\"\"Calculates the maximum product of a strictly increasing subsequence.\"\"\"\n    def max_product(self, array: InputArray) -> float:\n        \"\"\"Finds the maximum product of an increasing subsequence in the array.\"\"\"\n        all_subsequences = self._generate_subsequences(array)\n        \n        # Initialize with negative infinity to correctly handle all-negative products.\n        max_prod_val = -float('inf') \n        found_valid_subsequence = False \n\n        for sub in all_subsequences:\n            if self._is_strictly_increasing(sub):\n                current_prod = self._compute_product(sub)\n                if not found_valid_subsequence or current_prod > max_prod_val:\n                    max_prod_val = current_prod\n                    found_valid_subsequence = True\n        \n        return max_prod_val\n\n    def _generate_subsequences(self, array: InputArray) -> list: # List[Subsequence]\n        \"\"\"Generates all non-empty subsequences from the input array.\"\"\"\n        elements = [Element(array.numbers[i], i) for i in range(array.length())]\n        all_subs = []\n        num_elements = len(elements)\n        \n        if num_elements == 0:\n            return []\n\n        # Use bitmasks to generate all 2^N - 1 non-empty subsequences.\n        for i in range(1, 1 << num_elements): \n            current_sub_elements = []\n            for j in range(num_elements):\n                if (i >> j) & 1: # If j-th bit is set, include j-th element\n                    current_sub_elements.append(elements[j])\n            all_subs.append(Subsequence(current_sub_elements))\n        return all_subs\n\n    def _is_strictly_increasing(self, sub: Subsequence) -> bool:\n        \"\"\"Delegates to Subsequence's method to check if it's strictly increasing.\"\"\"\n        return sub.isStrictlyIncreasing()\n\n    def _compute_product(self, sub: Subsequence) -> float:\n        \"\"\"Delegates to Subsequence's method to compute its product.\"\"\"\n        return sub.product()\n\ndef max_product(array: list) -> float:\n    \"\"\"\n    Finds the maximum product formed by multiplying numbers of an increasing subsequence of that array.\n    \"\"\"\n    input_array_obj = InputArray(array)\n    calculator = ProductCalculator()\n    return calculator.max_product(input_array_obj)"}
{"task_id": "Mbpp/473", "solution": "def _canonical_tuple(pair: tuple) -> tuple:\n    \"\"\"Canonicalizes a 2-element tuple by ordering its elements ascending.\"\"\"\n    return (min(pair[0], pair[1]), max(pair[0], pair[1]))\n\ndef tuple_intersection(list1, list2):\n    \"\"\"\n    Finds the tuple intersection of elements in two given tuple lists,\n    treating tuples (a, b) and (b, a) as equal.\n    \"\"\"\n    canonical_set1 = {_canonical_tuple(p) for p in list1}\n    canonical_set2 = {_canonical_tuple(p) for p in list2}\n    return canonical_set1 & canonical_set2"}
{"task_id": "Mbpp/474", "solution": "from typing import Any\n\ndef _validate_single_char(param_name: str, value: Any) -> None:\n    \"\"\"Validates that a value is a single-character string, raising TypeError if not.\"\"\"\n    if not isinstance(value, str) or len(value) != 1:\n        raise TypeError(f\"{param_name} must be a single-character string\")\n\ndef replace_char(input_string, target_char, replacement_char):\n    \"\"\"Replaces all occurrences of a target character with a replacement character in a string.\"\"\"\n    _validate_single_char('target_char', target_char)\n    _validate_single_char('replacement_char', replacement_char)\n\n    if target_char == replacement_char:\n        return input_string\n\n    if target_char not in input_string:\n        return input_string\n\n    result_buffer = []\n    for char in input_string:\n        if char == target_char:\n            result_buffer.append(replacement_char)\n        else:\n            result_buffer.append(char)\n            \n    return ''.join(result_buffer)"}
{"task_id": "Mbpp/477", "solution": "def is_lower(s: str) -> str:\n    \"\"\"Return the lower-case form of s.\"\"\"\n    return s.lower()"}
{"task_id": "Mbpp/476", "solution": "def big_sum(numbers):\n    \"\"\"\n    Finds the sum of the largest and smallest value in a given array of numbers.\n    Raises ValueError for an empty list and TypeError for non-numeric elements.\n    \"\"\"\n\n    def _is_numeric(value):\n        \"\"\"Returns True if the value is an int or float, but not a bool.\"\"\"\n        return isinstance(value, (int, float)) and not isinstance(value, bool)\n\n    def _compute_min_max(arr):\n        \"\"\"Performs a single-pass computation of min and max values, raising TypeError on non-numeric elements.\"\"\"\n        min_val = float('inf')\n        max_val = float('-inf')\n        initialized = False\n\n        for x in arr:\n            if not _is_numeric(x):\n                raise TypeError(\"All elements in the list must be numeric.\")\n\n            if not initialized:\n                min_val = x\n                max_val = x\n                initialized = True\n            else:\n                if x < min_val:\n                    min_val = x\n                if x > max_val:\n                    max_val = x\n        return min_val, max_val\n\n    if not numbers:\n        raise ValueError(\"Input list cannot be empty.\")\n\n    if len(numbers) == 1:\n        if not _is_numeric(numbers[0]):\n            raise TypeError(\"All elements in the list must be numeric.\")\n        return 2 * numbers[0]\n\n    min_value, max_value = _compute_min_max(numbers)\n\n    return min_value + max_value"}
{"task_id": "Mbpp/479", "solution": "def first_Digit(number):\n    \"\"\"Return the most significant decimal digit of integer `number`. Handles both positive and negative inputs.\"\"\"\n    s = str(abs(number))\n    return int(s[0])"}
{"task_id": "Mbpp/475", "solution": "def sort_counter(input_dict: dict[str, int]) -> list[tuple[str, int]]:\n    \"\"\"Sorts a dictionary by its values in descending order and returns a list of (key, value) tuples.\"\"\"\n    if not input_dict:\n        return []\n    \n    items = list(input_dict.items())\n    items.sort(key=lambda item: item[1], reverse=True)\n    return items"}
{"task_id": "Mbpp/478", "solution": "def remove_lowercase(input: str) -> str:\n    \"\"\"Removes all contiguous ASCII lowercase substrings from the input string.\n    Non-lowercase characters are preserved in their original relative order.\"\"\"\n    result_chars = []\n    i = 0\n    while i < len(input):\n        char = input[i]\n        if 'a' <= char <= 'z':\n            # Skip this run of lowercase characters\n            while i < len(input) and 'a' <= input[i] <= 'z':\n                i += 1\n        else:\n            # Append non-lowercase character and move to the next\n            result_chars.append(char)\n            i += 1\n    return \"\".join(result_chars)"}
{"task_id": "Mbpp/554", "solution": "def Split(input_list):\n    \"\"\"Filters a list of integers, returning only the odd ones while preserving relative order.\"\"\"\n    odd_numbers = []\n    for number in input_list:\n        if number % 2 != 0:\n            odd_numbers.append(number)\n    return odd_numbers"}
{"task_id": "Mbpp/555", "solution": "class Validator:\n    def validatePositiveInteger(self, n) -> bool:\n        return isinstance(n, int) and n >= 1\n\nclass SumComputation:\n    def computeSum(self, n) -> int:\n        # closed-form formula: n * (n + 1) // 2\n        return n * (n + 1) // 2\n\n    def computeSumOfCubes(self, n) -> int:\n        # closed-form formula: (n * (n + 1) // 2) ** 2\n        return (n * (n + 1) // 2) ** 2\n\nclass DifferenceFunction:\n    def __init__(self, sum_computation: SumComputation = None, validator: Validator = None):\n        self.sum_computation = sum_computation or SumComputation()\n        self.validator = validator or Validator()\n\n    def difference(self, n) -> int:\n        if not self.validator.validatePositiveInteger(n):\n            # The validator returns False for invalid inputs.\n            raise ValueError(\"n must be an integer >= 1\")\n        sum_of_cubes = self.sum_computation.computeSumOfCubes(n)\n        sum_ = self.sum_computation.computeSum(n)\n        return sum_of_cubes - sum_\n\ndef difference(n) -> int:\n    \"\"\"\n    Calculates the difference between the sum of cubes of the first n natural numbers\n    and the sum of the first n natural numbers.\n    \"\"\"\n    return DifferenceFunction().difference(n)"}
{"task_id": "Mbpp/557", "solution": "from dataclasses import dataclass\n\n@dataclass\nclass StringInput:\n    value: str\n    def length(self) -> int:\n        return len(self.value)\n\n@dataclass\nclass Character:\n    ch: str\n    def is_alphabetic(self) -> bool:\n        return self.ch.isalpha()\n    def is_uppercase(self) -> bool:\n        return self.ch.isupper()\n    def toggle_case(self) -> str:\n        if not self.is_alphabetic():\n            return self.ch\n        return self.ch.lower() if self.is_uppercase() else self.ch.upper()\n\n@dataclass\nclass OutputString:\n    value: str\n    def length(self) -> int:\n        return len(self.value)\n\ndef toggle_string(input: str) -> str:\n    \"\"\"Return a string where each alphabetic character from input has inverted case.\n    Behavior maps to SRS functional requirements FR1-FR6.\n    \"\"\"\n    string_input = StringInput(input)\n\n    if string_input.length() == 0:\n        return \"\"\n\n    output_chars = []\n    for char_str in string_input.value:\n        character = Character(char_str)\n        output_chars.append(character.toggle_case())\n\n    output_string_obj = OutputString(\"\".join(output_chars))\n    return output_string_obj.value"}
{"task_id": "Mbpp/558", "solution": "from typing import List\n\nclass Result:\n    \"\"\"Value object for the computed sum.\"\"\"\n    def __init__(self, sum_val: int):\n        self.sum = sum_val\n\nclass Digit:\n    \"\"\"Value object for a single digit with position.\"\"\"\n    def __init__(self, position: int, value: int):\n        self.position = position\n        self.value = value\n\nclass IntegerNumber:\n    \"\"\"Represents an integer input and provides digit extraction in LSB-first order.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def get_digits_lsb_first(self) -> List[int]:\n        \"\"\"Returns decimal digits in LSB-first order; for 0 returns [0].\"\"\"\n        if self.value == 0:\n            return [0]\n\n        digits = []\n        temp_value = self.value\n        while temp_value > 0:\n            digits.append(temp_value % 10)\n            temp_value //= 10\n        return digits\n\nclass DigitDistanceCalculator:\n    \"\"\"Encapsulates algorithm for computing sum of per-digit absolute differences.\"\"\"\n    def digit_distance_nums(self, a: int, b: int) -> int:\n        a_abs = abs(a)\n        b_abs = abs(b)\n\n        digits_a = IntegerNumber(a_abs).get_digits_lsb_first()\n        digits_b = IntegerNumber(b_abs).get_digits_lsb_first()\n\n        len_a = len(digits_a)\n        len_b = len(digits_b)\n        max_len = max(len_a, len_b)\n\n        if len_a < max_len:\n            digits_a.extend([0] * (max_len - len_a))\n        if len_b < max_len:\n            digits_b.extend([0] * (max_len - len_b))\n\n        total_diff_sum = sum(abs(digits_a[i] - digits_b[i]) for i in range(max_len))\n\n        return Result(total_diff_sum).sum\n\ndef digit_distance_nums(a, b):\n    \"\"\"\n    Finds the sum of the per-digit difference between two integers.\n    The public API delegates to an internal calculator.\n    \"\"\"\n    calc = DigitDistanceCalculator()\n    return calc.digit_distance_nums(a, b)"}
{"task_id": "Mbpp/562", "solution": "def Find_Max_Length(sublists):\n    \"\"\"\n    Calculates the length of the longest sublist within a list of sublists.\n    Returns 0 if the input list is empty.\n    \"\"\"\n    max_length = 0\n    for sublist in sublists:\n        current_length = len(sublist)\n        if current_length > max_length:\n            max_length = current_length\n    return max_length"}
{"task_id": "Mbpp/556", "solution": "def _count_parity(iterable):\n    \"\"\"Counts odd and even numbers in an iterable.\n    Returns a tuple (odd_count, even_count).\"\"\"\n    odd_count = 0\n    even_count = 0\n    for x in iterable:\n        if x % 2 != 0:\n            odd_count += 1\n        else:\n            even_count += 1\n    return odd_count, even_count\n\ndef find_Odd_Pair(arr, n):\n    \"\"\"\n    Counts the number of unordered pairs (i < j) among the first n elements of arr whose XOR is odd.\n    Clamps n to the actual length of arr if n is greater, ensuring read-only behavior.\n    \"\"\"\n    n_clamped = min(n, len(arr))\n\n    if n_clamped <= 1:\n        return 0\n\n    arr_slice = arr[0:n_clamped]\n    odd_count, even_count = _count_parity(arr_slice)\n\n    return odd_count * even_count"}
{"task_id": "Mbpp/560", "solution": "def union_elements(tuple1, tuple2):\n    \"\"\"\n    Finds the union of elements from two tuples, removes duplicates, and sorts them.\n    Returns the unique, sorted elements as a new tuple.\n    \"\"\"\n    combined_elements = tuple1 + tuple2\n    unique_elements = set(combined_elements)\n    sorted_unique_elements = sorted(list(unique_elements))\n    return tuple(sorted_unique_elements)"}
{"task_id": "Mbpp/559", "solution": "import math\nfrom typing import List\n\nclass Error(Exception):\n    \"\"\"\n    Exception class used for input validation errors.\n    Contains a message string readable by the caller.\n    \"\"\"\n    def __init__(self, message: str):\n        self.message = message\n        super().__init__(self.message)\n\nclass InputValidator:\n    \"\"\"\n    Responsibility: Ensure n is an integer and 1 <= n <= len(arr).\n    Raises Error with a message for invalid n.\n    \"\"\"\n    def validate_n(self, n: int, arr: List[int]) -> None:\n        if not isinstance(n, int):\n            raise Error(\"Input 'n' must be an integer.\")\n        if not (1 <= n <= len(arr)):\n            raise Error(f\"Input 'n' must be between 1 and {len(arr)} (inclusive).\")\n\nclass ArrayModel:\n    \"\"\"\n    Encapsulates arr and provides prefix retrieval arr[0..n-1].\n    \"\"\"\n    def __init__(self, elements: List[int]):\n        self.elements = elements\n        self.length = len(elements)\n\n    def get_prefix(self, n: int) -> List[int]:\n        return self.elements[:n]\n\nclass Subarray:\n    \"\"\"\n    Represents a candidate contiguous subarray (used internally).\n    \"\"\"\n    def __init__(self, startIndex: int, endIndex: int, current_sum: int):\n        self.startIndex = startIndex\n        self.endIndex = endIndex\n        self.sum = current_sum\n\n    def as_tuple(self) -> (int, int, int):\n        return (self.startIndex, self.endIndex, self.sum)\n\nclass Result:\n    \"\"\"\n    Container for the returned sum value.\n    \"\"\"\n    def __init__(self, current_sum: int):\n        self.sum = current_sum\n\ndef max_sub_array_sum(arr: List[int], n: int) -> int:\n    \"\"\"\n    Finds the sum of the largest contiguous sublist in the given list's prefix.\n    Orchestrates validation and computation using Kadane's algorithm variant.\n    \"\"\"\n    InputValidator().validate_n(n, arr)\n    \n    array_model = ArrayModel(arr)\n    prefix = array_model.get_prefix(n)\n\n    # Kadane's algorithm variant to handle all-negative arrays correctly\n    max_so_far = -math.inf\n    current_max = 0\n\n    if not prefix: # This case should be prevented by validate_n (n>=1) but as a safeguard.\n        return 0\n\n    # The Kadane's variant below correctly handles all negative numbers by picking the largest negative\n    # if all sums are negative.\n    max_so_far = prefix[0]\n    current_max = prefix[0]\n\n    for i in range(1, len(prefix)):\n        current_max = max(prefix[i], current_max + prefix[i])\n        max_so_far = max(max_so_far, current_max)\n    \n    # Per design, conceptually create a Result object and return its sum.\n    final_result_obj = Result(max_so_far)\n    return final_result_obj.sum"}
{"task_id": "Mbpp/563", "solution": "from typing import List\nfrom dataclasses import dataclass\n\n@dataclass\nclass QuotedSubstring:\n    \"\"\"Represents a substring found between quotes, with its original value and indices.\"\"\"\n    value: str\n    start_index: int\n    end_index: int\n\ndef _trim(value: str) -> str:\n    \"\"\"Removes leading and trailing whitespace from a string.\"\"\"\n    return value.strip()\n\ndef _find_quoted_substrings(input_str: str) -> List[QuotedSubstring]:\n    \"\"\"Finds all double-quoted substrings and their locations in the input string.\"\"\"\n    quoted_substrings = []\n    in_quote = False\n    start_content_index = -1\n\n    for i, char in enumerate(input_str):\n        if char == '\"':\n            if not in_quote:\n                # Start of a quoted string, content begins after this quote\n                in_quote = True\n                start_content_index = i + 1\n            else:\n                # End of a quoted string, content ends before this quote\n                in_quote = False\n                end_content_index = i\n                \n                # Extract the raw content value\n                raw_value = input_str[start_content_index:end_content_index]\n                quoted_substrings.append(QuotedSubstring(raw_value, start_content_index, end_content_index))\n                start_content_index = -1 # Reset for the next pair of quotes\n    \n    return quoted_substrings\n\ndef extract_values(input_str: str) -> List[str]:\n    \"\"\"\n    Extracts values between quotation marks from a string, trimming leading/trailing whitespace.\n    Returns a list of extracted values in order, or an empty list if no quoted values are found.\n    \"\"\"\n    found_quoted_objects = _find_quoted_substrings(input_str)\n    \n    result = []\n    for q_obj in found_quoted_objects:\n        trimmed_value = _trim(q_obj.value)\n        result.append(trimmed_value)\n        \n    return result"}
{"task_id": "Mbpp/564", "solution": "from typing import List\nfrom dataclasses import dataclass\n\n@dataclass\nclass InputList:\n    elements: List[int]\n    length: int\n\n@dataclass\nclass PairCountResult:\n    count: int\n\ndef count_Pairs(arr: List[int], n: int) -> int:\n    \"\"\"Compute number of unordered index pairs (i, j) with 0 <= i < j < n and arr[i] != arr[j].\n\n    The function considers the first n elements of the input list.\n    \"\"\"\n    n_effective = min(n, len(arr))\n\n    # Construct InputList for traceability as per design\n    input_data = InputList(elements=arr[:n_effective], length=n_effective)\n\n    pair_count = 0\n    # Iterate through elements to find unordered pairs where values differ\n    for i in range(input_data.length):\n        for j in range(i + 1, input_data.length):\n            if input_data.elements[i] != input_data.elements[j]:\n                pair_count += 1\n\n    # Construct PairCountResult for traceability as per design\n    result = PairCountResult(count=pair_count)\n    return result.count"}
{"task_id": "Mbpp/565", "solution": "from typing import List, Any\n\nclass SplitFunction:\n    \"\"\"Helper class to encapsulate string splitting logic and validation.\"\"\"\n    def validate(self, input: Any) -> bool:\n        \"\"\"Validates if the input is a string.\"\"\"\n        return isinstance(input, str)\n\n    def split(self, input: Any) -> List[str]:\n        \"\"\"Splits a string into a list of characters, raising TypeError for invalid input.\"\"\"\n        if not self.validate(input):\n            raise TypeError(\"Input must be a string.\")\n        return list(input)\n\ndef validate(input: Any) -> bool:\n    \"\"\"Module-level helper to validate if the input is a string.\"\"\"\n    return isinstance(input, str)\n\ndef split(input: Any) -> List[str]:\n    \"\"\"Splits a string into a list of characters. Raises TypeError if input is not a string.\"\"\"\n    splitter = SplitFunction()\n    return splitter.split(input)"}
{"task_id": "Mbpp/566", "solution": "from dataclasses import dataclass\n\nclass ValidationError(Exception):\n    \"\"\"Exception raised for invalid input to sum_digits.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n\n@dataclass\nclass NonNegativeInteger:\n    \"\"\"Represents a validated non-negative integer input.\"\"\"\n    value: int\n\n@dataclass\nclass Digit:\n    \"\"\"Represents a single decimal digit with its position.\"\"\"\n    position: int\n    value: int\n\n@dataclass\nclass SumResult:\n    \"\"\"Represents the computed sum of digits.\"\"\"\n    sum: int\n\ndef sum_digits(n: int) -> int:\n    \"\"\"\n    Calculates the sum of the digits of a non-negative integer.\n    Assumes n is a non-negative integer due to \"no validation\" constraints.\n    \"\"\"\n    # Represent the input as per design, assuming valid input.\n    non_negative_n = NonNegativeInteger(value=n)\n\n    current_sum = 0\n    # Convert the number to a string to iterate through digits.\n    n_str = str(non_negative_n.value)\n\n    # Extract digits and sum them up.\n    for position, char_digit in enumerate(n_str):\n        digit_value = int(char_digit)\n        digit_obj = Digit(position=position, value=digit_value)\n        current_sum += digit_obj.value\n\n    # Wrap the result as per design.\n    result_obj = SumResult(sum=current_sum)\n    return result_obj.sum"}
{"task_id": "Mbpp/568", "solution": "def empty_list(N):\n    \"\"\"Return a list containing N empty dictionaries.\n\n    Parameters:\n    - N (int): number of empty dictionaries to create. Behavior specified for N >= 0.\n\n    Returns:\n    - list[dict]: a list with N empty dict objects. For N == 0 returns [].\n    \"\"\"\n    return [{} for _ in range(N)]"}
{"task_id": "Mbpp/572", "solution": "def two_unique_nums(items: list) -> list:\n    \"\"\"Return list of numbers that occur exactly once in items, preserving original order.\n\n    Args:\n        items (list): input list of numeric values.\n\n    Returns:\n        list: values from items that occur exactly once, in original relative order.\n    \"\"\"\n    counts = {}\n    for item in items:\n        counts[item] = counts.get(item, 0) + 1\n\n    result = []\n    for item in items:\n        if counts[item] == 1:\n            result.append(item)\n            \n    return result"}
{"task_id": "Mbpp/569", "solution": "from typing import List\n\ndef sort_sublists(input_list: List[List[str]]) -> List[List[str]]:\n    \"\"\"Return a new list of lists where each inner list's strings are sorted lexicographically ascending.\n    Empty input returns []; empty sublists are preserved.\n    \"\"\"\n    if not input_list:\n        return []\n    \n    return [sorted(sublist) for sublist in input_list]"}
{"task_id": "Mbpp/573", "solution": "def unique_product(numbers: list) -> int | float:\n    \"\"\"Compute the product of unique numeric values in `numbers`.\n\n    It deduces unique numbers and multiplies them, returning 1 for an empty list.\n    \"\"\"\n    unique_numbers = set(numbers)\n    product = 1\n    for num in unique_numbers:\n        product *= num\n    return product"}
{"task_id": "Mbpp/567", "solution": "def check_type(lst) -> None:\n    \"\"\"Ensures the argument is a Python built-in list, raising TypeError if not.\"\"\"\n    if not isinstance(lst, list):\n        raise TypeError(\"issort_list expects a list\")\n\ndef scan_elements(lst) -> bool:\n    \"\"\"Performs a left-to-right scan to check for non-decreasing order.\"\"\"\n    for i in range(1, len(lst)):\n        try:\n            if not (lst[i-1] <= lst[i]):\n                return False\n        except TypeError:\n            raise  # Propagate TypeError for incomparable elements\n    return True\n\ndef issort_list(lst) -> bool:\n    \"\"\"\n    Checks whether a specified list is sorted in non-decreasing order.\n    Returns True for empty or single-element lists, False on first violation.\n    \"\"\"\n    check_type(lst)\n\n    if len(lst) <= 1:\n        return True\n\n    return scan_elements(lst)"}
{"task_id": "Mbpp/576", "solution": "def is_Sub_Array(list_a, list_b):\n    \"\"\"\n    Checks if list_b is a contiguous sublist of list_a.\n    An empty list_b is considered a sublist of any list_a.\n    \"\"\"\n    n = len(list_a)\n    m = len(list_b)\n\n    if m == 0:\n        return True  # An empty list is considered a sublist of any list.\n\n    # If list_b is longer than list_a, it cannot be a sublist.\n    # The loop range will handle this case automatically by being empty if m > n.\n    \n    for i in range(n - m + 1):\n        if list_a[i : i + m] == list_b:\n            return True\n\n    return False"}
{"task_id": "Mbpp/577", "solution": "def last_Digit_Factorial(n):\n    \"\"\"Returns the last digit of n! for a non-negative integer n.\"\"\"\n    if n == 0 or n == 1:\n        return 1\n    elif n == 2:\n        return 2\n    elif n == 3:\n        return 6\n    elif n == 4:\n        return 4\n    else: # n >= 5\n        return 0"}
{"task_id": "Mbpp/579", "solution": "def find_dissimilar(tuple1, tuple2) -> tuple:\n    \"\"\"Finds elements present in exactly one of the two input tuples, preserving order and uniqueness.\"\"\"\n    setA = set(tuple1)\n    setB = set(tuple2)\n\n    unique_to_A = setA - setB\n    unique_to_B = setB - setA\n\n    result_list = []\n    seen = set()\n\n    for item in tuple1:\n        if item in unique_to_A and item not in seen:\n            result_list.append(item)\n            seen.add(item)\n\n    for item in tuple2:\n        if item in unique_to_B and item not in seen:\n            result_list.append(item)\n            seen.add(item)\n\n    return tuple(result_list)"}
{"task_id": "Mbpp/583", "solution": "class CatalanNumberGenerator:\n    @staticmethod\n    def catalan_number(n: int) -> int:\n        \"\"\"Compute nth Catalan number and return as int using dynamic programming.\"\"\"\n        if n < 0:\n            raise ValueError(\"Input must be a non-negative integer.\")\n        if n == 0:\n            return 1\n        \n        catalan = [0] * (n + 1)\n        catalan[0] = 1\n        \n        for i in range(1, n + 1):\n            for j in range(i):\n                catalan[i] += catalan[j] * catalan[i - 1 - j]\n        \n        return catalan[n]\n\ndef catalan_number(n):\n    \"\"\"Public API function required by FR-1, delegates to CatalanNumberGenerator.catalan_number.\"\"\"\n    return CatalanNumberGenerator.catalan_number(n)"}
{"task_id": "Mbpp/578", "solution": "class LengthMismatchError(Exception):\n    def __init__(self, message: str):\n        super().__init__(message)\n\nclass InputList:\n    def __init__(self, elements: list):\n        self.elements = elements\n\n    def length(self) -> int:\n        return len(self.elements)\n\nclass ResultList:\n    def __init__(self, elements: list):\n        self.elements = elements\n\nclass InterleaverFunction:\n    @staticmethod\n    def validate_lengths(list1, list2, list3) -> bool:\n        return len(list1) == len(list2) == len(list3)\n\n    @staticmethod\n    def _do_interleave(list1, list2, list3) -> list:\n        # Assumes all input lists are of equal length.\n        interleaved_list = []\n        for i in range(len(list1)):\n            interleaved_list.append(list1[i])\n            interleaved_list.append(list2[i])\n            interleaved_list.append(list3[i])\n        return interleaved_list\n\n    @staticmethod\n    def interleave_lists(list1, list2, list3) -> list:\n        # Validates input list lengths and then performs interleaving.\n        if not InterleaverFunction.validate_lengths(list1, list2, list3):\n            raise LengthMismatchError(\"Input lists must have equal length.\")\n        return InterleaverFunction._do_interleave(list1, list2, list3)\n\ndef interleave_lists(list1, list2, list3) -> list:\n    \"\"\"\n    Interleaves three lists of the same length into a single flat list.\n    Raises LengthMismatchError if input lists are not of equal length.\n    \"\"\"\n    return InterleaverFunction.interleave_lists(list1, list2, list3)"}
{"task_id": "Mbpp/581", "solution": "class SquarePyramid:\n    \"\"\"Represents a square pyramid and computes its component areas.\"\"\"\n    def __init__(self, base_edge: float, height: float):\n        self.base_edge = base_edge\n        self.height = height\n        self.base_area = 0.0\n        self.lateral_area = 0.0\n        self.surface_area = 0.0\n\n    def compute_base_area(self) -> float:\n        \"\"\"Computes and returns the base area of the pyramid.\"\"\"\n        self.base_area = self.base_edge ** 2\n        return self.base_area\n\n    def compute_lateral_area(self) -> float:\n        \"\"\"Computes and returns the lateral area of the pyramid.\"\"\"\n        # As per design, lateral_area is 2 * base_edge * height.\n        self.lateral_area = 2 * self.base_edge * self.height\n        return self.lateral_area\n\n    def compute_surface_area(self) -> float:\n        \"\"\"Computes and returns the total surface area of the pyramid.\"\"\"\n        base_area = self.compute_base_area()\n        lateral_area = self.compute_lateral_area()\n        self.surface_area = base_area + lateral_area\n        return self.surface_area\n\nclass SurfaceAreaCalculator:\n    \"\"\"Calculates the surface area of a square pyramid by orchestrating SquarePyramid.\"\"\"\n    @staticmethod\n    def surface_Area(base_edge: float, height: float) -> float:\n        \"\"\"Orchestrates the calculation of a square pyramid's surface area.\"\"\"\n        pyramid = SquarePyramid(base_edge, height)\n        return pyramid.compute_surface_area()\n\ndef surface_Area(base_edge: float, height: float) -> float:\n    \"\"\"Calculates the surface area of a square pyramid with given base edge and height.\"\"\"\n    return SurfaceAreaCalculator.surface_Area(base_edge, height)"}
{"task_id": "Mbpp/580", "solution": "def extract_even(input_tuple: tuple) -> tuple:\n    \"\"\"\n    Recursively removes all odd integers from a nested tuple, preserving order and structure.\n    Raises TypeError if input or nested elements are not integers or tuples.\n    \"\"\"\n    if not isinstance(input_tuple, tuple):\n        raise TypeError(\"Input must be a tuple.\")\n\n    result = []\n    for element in input_tuple:\n        if isinstance(element, int):\n            if element % 2 == 0:\n                result.append(element)\n        elif isinstance(element, tuple):\n            sub_result = extract_even(element)\n            result.append(sub_result)\n        else:\n            raise TypeError(\"Tuple elements must be integers or tuples.\")\n            \n    return tuple(result)"}
{"task_id": "Mbpp/586", "solution": "def split_Arr(input_list, n):\n    \"\"\"\n    Splits a list at the nth element and moves the initial n elements to the end.\n    \"\"\"\n    return input_list[n:] + input_list[:n]"}
{"task_id": "Mbpp/585", "solution": "class ValidationError(Exception):\n    \"\"\"Exception raised for invalid inputs or malformed items.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n\nclass PriceValidator:\n    \"\"\"Utility class for validating numeric price values.\"\"\"\n    @staticmethod\n    def is_numeric(value) -> bool:\n        \"\"\"Returns True if the value is an int or float, but not a boolean.\"\"\"\n        return isinstance(value, (int, float)) and not isinstance(value, bool)\n\ndef _validate_inputs(dataset, n):\n    \"\"\"Validates the top-level types and values of dataset and n.\"\"\"\n    if not isinstance(dataset, list):\n        raise ValidationError(\"dataset must be a list\")\n    if not isinstance(n, int) or n < 0:\n        raise ValidationError(\"n must be a non-negative integer\")\n\ndef _validate_item(item, index):\n    \"\"\"Validates an individual item's structure and price field.\"\"\"\n    if not isinstance(item, dict):\n        raise ValidationError(f\"item at index {index} must be a mapping (dict)\")\n    if 'name' not in item:\n        raise ValidationError(f\"item at index {index} is missing 'name' key\")\n    if 'price' not in item:\n        raise ValidationError(f\"item at index {index} is missing 'price' key\")\n    if not PriceValidator.is_numeric(item['price']):\n        raise ValidationError(f\"item at index {index} has a non-numeric 'price'\")\n\ndef expensive_items(dataset, n):\n    \"\"\"\n    Finds the n most expensive items in a dataset.\n    Validates inputs, sorts items by price descending, and returns up to n items.\n    \"\"\"\n    _validate_inputs(dataset, n)\n\n    if not dataset or n == 0:\n        return []\n\n    for i, item in enumerate(dataset):\n        _validate_item(item, i)\n\n    sorted_items = sorted(dataset, key=lambda x: x['price'], reverse=True)\n\n    return sorted_items[:n]"}
{"task_id": "Mbpp/587", "solution": "def list_tuple(inputList: list) -> tuple:\n    \"\"\"\n    Converts a list to a tuple, preserving element order and types.\n    The input list is not modified.\n    \"\"\"\n    return tuple(inputList)"}
{"task_id": "Mbpp/588", "solution": "def big_diff(values):\n    \"\"\"Compute and return the numeric difference between the largest and smallest elements in values.\n\n    Note: Behavior for empty list or non-numeric inputs follows Python built-ins (ValueError/TypeError).\n    \"\"\"\n    return max(values) - min(values)"}
{"task_id": "Mbpp/589", "solution": "import math\n\ndef _validate_inputs(start, end) -> None:\n    \"\"\"Internal: raises TypeError if start or end is not an int.\"\"\"\n    if not isinstance(start, int) or not isinstance(end, int):\n        raise TypeError(\"Both start and end must be integers.\")\n\ndef _compute_squares(start, end) -> list:\n    \"\"\"Internal: returns the ascending list of perfect squares between start and end inclusive.\"\"\"\n    if end < 0:\n        return []\n\n    # Perfect squares are non-negative, so adjust 'start' if it's negative.\n    effective_start = max(0, start)\n    root_min = math.ceil(math.sqrt(effective_start))\n    root_max = math.floor(math.sqrt(end))\n\n    if root_min > root_max:\n        return []\n\n    # Generate squares for integer roots in the determined range.\n    squares = [r * r for r in range(int(root_min), int(root_max) + 1)]\n    return squares\n\ndef perfect_squares(start, end) -> list:\n    \"\"\"\n    Public API: returns a list of ints containing perfect squares x such that start <= x <= end (inclusive), sorted ascending.\n    \"\"\"\n    _validate_inputs(start, end)\n\n    if start > end:\n        return []\n\n    return _compute_squares(start, end)"}
{"task_id": "Mbpp/591", "solution": "def swap_List(input_list):\n    \"\"\"\n    Interchanges the first and last elements in a list.\n    Returns the original list if its length is less than 2.\n    \"\"\"\n    list_length = len(input_list)\n\n    if list_length < 2:\n        return input_list\n\n    return [input_list[-1]] + input_list[1:-1] + [input_list[0]]"}
{"task_id": "Mbpp/590", "solution": "import math\n\nclass CartesianCoordinate:\n    \"\"\"A data holder for Cartesian x and y coordinates.\"\"\"\n    def __init__(self, x: float, y: float):\n        self.x = float(x)\n        self.y = float(y)\n\nclass PolarCoordinate:\n    \"\"\"A data holder for polar radius r and angle theta.\"\"\"\n    def __init__(self, r: float, theta: float):\n        self.r = float(r)\n        self.theta = float(theta)\n\nclass ComplexNumber:\n    \"\"\"A data holder for the real and imaginary parts of a complex number.\"\"\"\n    def __init__(self, real: float, imag: float):\n        self.real = float(real)\n        self.imag = float(imag)\n\n    def to_complex(self) -> complex:\n        \"\"\"Converts the stored real and imaginary parts to a built-in complex type.\"\"\"\n        return complex(self.real, self.imag)\n\nclass InputValidator:\n    \"\"\"A utility class for validating input values.\"\"\"\n    @staticmethod\n    def validate_numeric(value) -> bool:\n        \"\"\"Checks if the given value is an integer or a float.\"\"\"\n        return isinstance(value, (int, float))\n\ndef polar_rect(x, y) -> tuple:\n    \"\"\"\n    Converts Cartesian coordinates (x, y) to polar coordinates (r, theta) and a complex number representation.\n    Interprets x and y as Cartesian coordinates.\n    \"\"\"\n    if not InputValidator.validate_numeric(x) or not InputValidator.validate_numeric(y):\n        raise ValueError(\"Inputs must be numeric (int or float).\")\n\n    # Compute r = sqrt(x^2 + y^2) per FR2.\n    r = math.sqrt(x*x + y*y)\n\n    # Compute theta = atan2(y, x) per FR3.\n    theta = math.atan2(y, x)\n\n    # Construct complex_rect = complex(x, y) per FR4 and BR-6.\n    complex_rect = complex(x, y)\n\n    # Return ((r, theta), complex_rect) per FR4.\n    return ((r, theta), complex_rect)"}
{"task_id": "Mbpp/592", "solution": "class BinomialCoefficient:\n    \"\"\"Utility to compute binomial coefficients C(n, k).\"\"\"\n    @staticmethod\n    def C(n: int, k: int) -> int:\n        \"\"\"\n        Computes C(n, k) using integer arithmetic.\n        Returns 0 if k < 0 or k > n.\n        \"\"\"\n        if k < 0 or k > n:\n            return 0\n        if k == 0 or k == n:\n            return 1\n        if k > n // 2:\n            k = n - k\n\n        res = 1\n        for i in range(k):\n            res = res * (n - i) // (i + 1)\n        return res\n\nclass SumOfProductFunction:\n    \"\"\"Handles validation and computation for the sum of products of consecutive binomial coefficients.\"\"\"\n    def validateInput(self, n: int) -> None:\n        \"\"\"Validates the input 'n', raising TypeError or ValueError for invalid cases.\"\"\"\n        if not isinstance(n, int):\n            raise TypeError(\"Input 'n' must be an integer.\")\n        if n < 0:\n            raise ValueError(\"Input 'n' must be a non-negative integer.\")\n\n    def sum_Of_product(self, n: int) -> int:\n        \"\"\"\n        Computes the sum S(n) = sum_{k=0..n-1} C(n,k) * C(n,k+1).\n        Delegates to BinomialCoefficient for C(n,k) calculations.\n        \"\"\"\n        self.validateInput(n)\n\n        total_sum = 0\n        for k in range(n):\n            coeff_k = BinomialCoefficient.C(n, k)\n            coeff_k_plus_1 = BinomialCoefficient.C(n, k + 1)\n            total_sum += coeff_k * coeff_k_plus_1\n        return total_sum\n\ndef sum_Of_product(n: int) -> int:\n    \"\"\"\n    Computes the sum of the product of consecutive binomial coefficients.\n    S(n) = sum_{k=0..n-1} C(n,k) * C(n,k+1)\n    \"\"\"\n    computer = SumOfProductFunction()\n    return computer.sum_Of_product(n)"}
{"task_id": "Mbpp/594", "solution": "def diff_even_odd(input_list: list) -> int:\n    \"\"\"\n    Finds the difference of the first even and first odd number in the given list.\n    Assumes the list contains at least one even and one odd number.\n    \"\"\"\n    first_odd_val = None\n    first_even_val = None\n\n    for num in input_list:\n        if first_odd_val is None and num % 2 != 0:\n            first_odd_val = num\n        if first_even_val is None and num % 2 == 0:\n            first_even_val = num\n\n        if first_odd_val is not None and first_even_val is not None:\n            break\n\n    return first_even_val - first_odd_val"}
{"task_id": "Mbpp/593", "solution": "class Octet:\n    \"\"\"Represents a single octet of an IPv4 address and handles its normalization.\"\"\"\n    def __init__(self, rawValue: str, position: int):\n        self.rawValue = rawValue\n        self.position = position\n\n    def hasLeadingZeros(self) -> bool:\n        \"\"\"Checks if the octet's raw value has leading zeros.\"\"\"\n        return len(self.rawValue) > 1 and self.rawValue[0] == '0'\n\n    def isAllZeros(self) -> bool:\n        \"\"\"Checks if the octet's raw value represents an all-zero octet (e.g., '0', '00', '000').\"\"\"\n        return all(c == '0' for c in self.rawValue)\n\n    def removeLeadingZeros(self) -> str:\n        \"\"\"Removes leading zeros from the octet's raw value. Converts '00' or '000' to '0'.\"\"\"\n        return str(int(self.rawValue))\n\nclass IPAddress:\n    \"\"\"Represents an IPv4 address, containing four Octet instances, and orchestrates octet normalization.\"\"\"\n    def __init__(self, raw: str):\n        self.raw = raw\n        self.octets: list[Octet] = []\n        self.normalized = \"\"\n\n    @classmethod\n    def parse(cls, raw: str) -> 'IPAddress':\n        \"\"\"Parses a raw IP address string into an IPAddress object with Octet instances.\"\"\"\n        ip_address = cls(raw)\n        parts = raw.split('.')\n        for i, part in enumerate(parts):\n            ip_address.octets.append(Octet(part, i + 1))\n        return ip_address\n\n    def normalize(self) -> str:\n        \"\"\"Normalizes the IP address by removing leading zeros from its octets.\"\"\"\n        normalized_parts = []\n        for octet in self.octets:\n            # octet.removeLeadingZeros() (using str(int())) effectively handles both\n            # leading zero removal (e.g., \"08\" -> \"8\") and all-zero octets (\"000\" -> \"0\").\n            # An octet like \"0\" has no *removable* leading zeros, so hasLeadingZeros() is False.\n            if octet.hasLeadingZeros():\n                normalized_parts.append(octet.removeLeadingZeros())\n            else:\n                # This path covers octets like \"216\" or \"0\" which require no modification.\n                normalized_parts.append(octet.rawValue)\n        self.normalized = '.'.join(normalized_parts)\n        return self.normalized\n\nclass RemoveZeroIPFunction:\n    \"\"\"Orchestrates the parsing, validation, and normalization of an IP address.\"\"\"\n    def execute(self, input_ip: str) -> str:\n        \"\"\"Executes the IP address normalization process.\"\"\"\n        ip_address = IPAddress.parse(input_ip)\n        \n        # FR6 validation (octet content 1-3 numeric chars) is noted in the design.\n        # Due to constraints on error handling (no exceptions, unspecified behavior),\n        # explicit validation checks are omitted, assuming valid input for happy path.\n        \n        return ip_address.normalize()\n\ndef removezero_ip(ip_address_str: str) -> str:\n    \"\"\"\n    Removes leading zeroes from an IPv4 address string, normalizing each octet.\n    Example: removezero_ip(\"216.08.094.196\") == \"216.8.94.196\"\n    \"\"\"\n    orchestrator = RemoveZeroIPFunction()\n    return orchestrator.execute(ip_address_str)"}
{"task_id": "Mbpp/596", "solution": "import sys\n\ndef tuple_size(t):\n    \"\"\"\n    Returns the size in bytes of the given tuple, matching sys.getsizeof.\n    Raises TypeError if the input is not a tuple.\n    \"\"\"\n    if not isinstance(t, tuple):\n        raise TypeError(\"tuple_size requires a tuple input\")\n    return sys.getsizeof(t)"}
{"task_id": "Mbpp/598", "solution": "class Number:\n    \"\"\"Represents an integer value, providing access to its digits and digit count.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n        self.digits = self.compute_digits()\n        self.num_digits = self.count_digits()\n\n    def compute_digits(self) -> list['Digit']:\n        \"\"\"Extracts individual decimal digits from the number.\"\"\"\n        return [Digit(int(d)) for d in str(self.value)]\n\n    def count_digits(self) -> int:\n        \"\"\"Counts the number of decimal digits in the number.\"\"\"\n        return len(str(self.value))\n\nclass Digit:\n    \"\"\"Represents a single decimal digit and provides power operation.\"\"\"\n    def __init__(self, value: int, position: int = None):\n        self.value = value\n        self.position = position # Not strictly used, but kept for design completeness\n\n    def pow(self, exponent: int) -> int:\n        \"\"\"Raises the digit's value to the given exponent.\"\"\"\n        return self.value ** exponent\n\nclass Result:\n    \"\"\"A value object holding the final boolean classification for an Armstrong number check.\"\"\"\n    def __init__(self, is_armstrong: bool):\n        self.is_armstrong = is_armstrong\n\nclass ArmstrongChecker:\n    \"\"\"Orchestrates the computation to determine if a number is Armstrong.\"\"\"\n    def is_armstrong(self, number: Number) -> Result:\n        \"\"\"Computes the sum of digits raised to the power of the number of digits and compares to the original number.\"\"\"\n        power_sum = 0\n        for digit in number.digits:\n            power_sum += digit.pow(number.num_digits)\n        \n        return Result(power_sum == number.value)\n\ndef armstrong_number(n: int) -> bool:\n    \"\"\"Checks whether the given number is an Armstrong number.\"\"\"\n    number_obj = Number(n)\n    checker = ArmstrongChecker()\n    result = checker.is_armstrong(number_obj)\n    return result.is_armstrong"}
{"task_id": "Mbpp/597", "solution": "import math\n\nclass InputValidator:\n    \"\"\"\n    Validates the 1-based k value against the total length of combined arrays.\n    \"\"\"\n    def validate_k(self, k: int, total_len: int) -> None:\n        \"\"\"\n        Raises IndexError if k is less than 1 or greater than total_len.\n        \"\"\"\n        if k < 1 or k > total_len:\n            raise IndexError(\"k is out of range\")\n\ndef _binary_select(a: list, b: list, k: int) -> int:\n    \"\"\"\n    Internal helper to find the k-th smallest element using a binary search approach.\n    It assumes k is a valid 1-based index within the combined length of the two sorted arrays.\n    \"\"\"\n    m, n = len(a), len(b)\n\n    if m > n: # Ensure 'a' is the shorter array for efficiency\n        return _binary_select(b, a, k)\n\n    if m == 0: # If 'a' is empty, the element must be in 'b'\n        return b[k - 1]\n    \n    # Define the search range for 'part_a', the number of elements taken from array 'a'\n    # part_a + part_b = k\n    low = max(0, k - n)\n    high = min(k, m)\n\n    while low <= high:\n        part_a = low + (high - low) // 2\n        part_b = k - part_a\n\n        # Get elements at the partition boundaries, using -inf and +inf for edge cases\n        L1 = a[part_a - 1] if part_a > 0 else -math.inf\n        R1 = a[part_a] if part_a < m else math.inf\n        \n        L2 = b[part_b - 1] if part_b > 0 else -math.inf\n        R2 = b[part_b] if part_b < n else math.inf\n\n        if L1 <= R2 and L2 <= R1:\n            # Correct partition found, the k-th element is the maximum of the two left elements\n            return max(L1, L2)\n        elif L1 > R2:\n            # part_a is too large, need to take fewer elements from 'a'\n            high = part_a - 1\n        else: # L2 > R1\n            # part_a is too small, need to take more elements from 'a'\n            low = part_a + 1\n    \n    # This line should not be reached if k is valid and arrays are sorted.\n    return -1 \n\ndef find_kth(arr1: list, arr2: list, k: int) -> int:\n    \"\"\"\n    Finds the kth smallest element from two given sorted arrays.\n    The parameter k is 1-based.\n    \"\"\"\n    validator = InputValidator()\n    total_len = len(arr1) + len(arr2)\n    validator.validate_k(k, total_len) # Validates k and raises IndexError if out of range\n\n    return _binary_select(arr1, arr2, k)"}
{"task_id": "Mbpp/600", "solution": "def is_Even(n: int) -> bool:\n    \"\"\"Return True if integer n is even, False otherwise.\"\"\"\n    return (n % 2) == 0"}
{"task_id": "Mbpp/599", "solution": "from typing import NamedTuple, Iterator\n\nclass ResultTuple(NamedTuple):\n    \"\"\"Immutable data container for returned values.\"\"\"\n    sum: int\n    average: float\n\nclass InputParameter:\n    \"\"\"Encapsulates input n and performs validation.\"\"\"\n    def __init__(self, n):\n        self.n = n\n\n    def validate(self) -> None:\n        \"\"\"Validates that n is an int and n >= 1; raises ValueError on failure.\"\"\"\n        if not isinstance(self.n, int):\n            raise ValueError(\"Input 'n' must be an integer.\")\n        if self.n < 1:\n            raise ValueError(\"Input 'n' must be a natural number (>= 1).\")\n\nclass NaturalNumberSequence:\n    \"\"\"Domain utility providing a generator for the sequence 1..n.\"\"\"\n    @staticmethod\n    def generate(n: int) -> Iterator[int]:\n        \"\"\"Yields natural numbers from 1 up to n.\"\"\"\n        for i in range(1, n + 1):\n            yield i\n\ndef _validate_input(n) -> None:\n    \"\"\"Validates that n is an integer and n >= 1; raises ValueError otherwise.\"\"\"\n    if not isinstance(n, int):\n        raise ValueError(\"Input 'n' must be an integer.\")\n    if n < 1:\n        raise ValueError(\"Input 'n' must be a natural number (>= 1).\")\n\ndef sum_average(n):\n    \"\"\"\n    Finds the sum and average of the first n natural numbers.\n    Validates input and computes using closed-form formulas.\n    \"\"\"\n    _validate_input(n)\n\n    total_sum = n * (n + 1) // 2\n    average = float(total_sum) / n\n\n    return ResultTuple(total_sum, average)"}
{"task_id": "Mbpp/602", "solution": "def first_repeated_char(input_string: str) -> str:\n    \"\"\"Return the first character (one-character string) that appears more than once in input_string.\"\"\"\n    return find_first_repeated(input_string)\n\ndef find_first_repeated(input_string: str) -> str:\n    \"\"\"Compute char frequencies and first indices; return first repeated char by input order.\"\"\"\n    seen_chars = set()\n    for char in input_string:\n        if char in seen_chars:\n            return char\n        seen_chars.add(char)\n    return \"\""}
{"task_id": "Mbpp/604", "solution": "def _tokenize_on_space(input_string: str) -> list[str]:\n    \"\"\"Splits the input string by a single ASCII space, preserving empty tokens.\"\"\"\n    return input_string.split(' ')\n\ndef _reverse_list(words: list[str]) -> list[str]:\n    \"\"\"Returns a new list with elements in reversed order.\"\"\"\n    return words[::-1]\n\ndef _join_with_space(words: list[str]) -> str:\n    \"\"\"Joins a list of strings into a single string using a single space as a separator.\"\"\"\n    return ' '.join(words)\n\ndef reverse_words(input_string: str) -> str:\n    \"\"\"\n    Reverses the order of words separated by spaces in a given string.\n    Words are tokenized by ASCII space, preserving empty tokens and internal characters.\n    \"\"\"\n    words = _tokenize_on_space(input_string)\n    reversed_words = _reverse_list(words)\n    output_string = _join_with_space(reversed_words)\n    return output_string"}
{"task_id": "Mbpp/603", "solution": "from typing import List, Any\n\nclass InputValidator:\n    \"\"\"Input validation utilities for checking type and minimum threshold.\"\"\"\n    def is_integer(self, n: Any) -> bool:\n        \"\"\"Return True only if n is an exact integer type.\"\"\"\n        return isinstance(n, int)\n\n    def ensure_minimum(self, n: int, minVal: int) -> bool:\n        \"\"\"Return True if n is greater than or equal to minVal.\"\"\"\n        return n >= minVal\n\nclass SequenceGenerator:\n    \"\"\"Implements ludic sequence generation algorithm.\"\"\"\n    def _apply_ludic_sieve(self, numbers: List[int], sieve_value: int) -> List[int]:\n        \"\"\"Internal helper to remove every sieve_value-th element from the numbers list.\"\"\"\n        if not numbers or sieve_value <= 0:\n            return numbers\n\n        indices_to_remove = []\n        for i in range(sieve_value - 1, len(numbers), sieve_value):\n            indices_to_remove.append(i)\n        \n        for index in reversed(indices_to_remove):\n            if index < len(numbers):\n                numbers.pop(index)\n        \n        return numbers\n\n    def generate_up_to(self, n: int) -> List[int]:\n        \"\"\"Return a list of ludic numbers (ints) up to n in ascending order.\"\"\"\n        if n < 1:\n            return []\n\n        ludic_numbers = [1]\n        candidates = list(range(2, n + 1))\n        \n        while candidates and candidates[0] <= n:\n            next_ludic = candidates.pop(0)\n            ludic_numbers.append(next_ludic)\n            self._apply_ludic_sieve(candidates, next_ludic)\n\n        return ludic_numbers\n\nclass Result:\n    \"\"\"Lightweight Result container holding the list of ludic numbers.\"\"\"\n    def __init__(self, numbers: List[int]) -> None:\n        \"\"\"Initializes the Result with a list of numbers.\"\"\"\n        self.numbers = numbers\n\n    def to_list(self) -> List[int]:\n        \"\"\"Returns the stored list of numbers.\"\"\"\n        return self.numbers\n\nclass LudicService:\n    \"\"\"Fa\u00e7ade that orchestrates input validation and sequence generation.\"\"\"\n    def __init__(self):\n        \"\"\"Initializes LudicService with an InputValidator and SequenceGenerator.\"\"\"\n        self._validator = InputValidator()\n        self._generator = SequenceGenerator()\n\n    def get_ludic(self, n: int) -> List[int]:\n        \"\"\"\n        Validates input, handles boundary conditions, and generates ludic numbers.\n        Raises TypeError if n is not an integer.\n        \"\"\"\n        if not self._validator.is_integer(n):\n            raise TypeError(\"Input 'n' must be an integer.\")\n        \n        if not self._validator.ensure_minimum(n, 1):\n            return []\n        \n        ludic_numbers = self._generator.generate_up_to(n)\n        result_obj = Result(ludic_numbers)\n        return result_obj.to_list()\n\ndef get_ludic(n: int) -> List[int]:\n    \"\"\"\n    Returns all ludic numbers less than or equal to a given integer n.\n    Raises TypeError if n is not an integer.\n    \"\"\"\n    service = LudicService()\n    return service.get_ludic(n)"}
{"task_id": "Mbpp/605", "solution": "from math import isqrt\nfrom typing import Any\n\nclass IntegerInput:\n    \"\"\"Represents and validates an integer input.\"\"\"\n    def __init__(self, value: Any) -> None:\n        self.value = value\n\n    def validate(self) -> bool:\n        \"\"\"Returns True if the value is an integer, False otherwise.\"\"\"\n        return isinstance(self.value, int)\n\nclass PrimeChecker:\n    \"\"\"Encapsulates the primality-detection algorithm.\"\"\"\n    def is_prime(self, n: int) -> bool:\n        \"\"\"Returns True if n is prime, False otherwise.\"\"\"\n        if n <= 1:\n            return False\n        if n == 2:\n            return True\n        if n % 2 == 0:\n            return False\n        \n        # Check for odd divisors from 3 up to sqrt(n)\n        for i in range(3, isqrt(n) + 1, 2):\n            if n % i == 0:\n                return False\n        return True\n\nclass PrimeResult:\n    \"\"\"Value object encapsulating the boolean result of a primality check.\"\"\"\n    def __init__(self, is_prime: bool) -> None:\n        self.is_prime = is_prime\n\nclass TestAssertion:\n    \"\"\"Represents a test assertion concept.\"\"\"\n    def __init__(self, expression: str) -> None:\n        self.expression = expression\n        self.passed = False # Default state, actual run would set this\n\n    def run(self) -> bool:\n        \"\"\"Simulates running the assertion, returning a placeholder boolean.\"\"\"\n        # For this design, actual evaluation is done by the test harness.\n        # This method is for conceptual completeness.\n        return self.passed\n\ndef prime_num(n: int) -> bool:\n    \"\"\"Checks if the given integer is a prime number.\"\"\"\n    integer_input = IntegerInput(n)\n    if not integer_input.validate():\n        return False # Policy: return False for non-integer inputs\n\n    checker = PrimeChecker()\n    is_prime_result = checker.is_prime(integer_input.value)\n    \n    prime_result_obj = PrimeResult(is_prime_result)\n    return prime_result_obj.is_prime"}
{"task_id": "Mbpp/606", "solution": "import math\n\n_PI_OVER_180: float = math.pi / 180.0\n\ndef radian_degree(angle_degrees: float) -> float:\n    \"\"\"Compute radians from degrees using radians = degrees * PI / 180 and return float.\"\"\"\n    return float(angle_degrees) * _PI_OVER_180"}
{"task_id": "Mbpp/607", "solution": "from typing import Optional, Tuple\nimport re\n\ndef find_literals(text: str, pattern: str) -> Optional[Tuple[str, int, int]]:\n    \"\"\"Search `text` for the first match of regex `pattern`.\n\n    Returns (matched_substring, start_index, end_index) or None if no match is found.\n    \"\"\"\n    match = re.search(pattern, text)\n    if not match:\n        return None\n    matched = match.group(0)\n    start, end = match.span()\n    return (matched, start, end)"}
{"task_id": "Mbpp/608", "solution": "def bell_Number(n):\n    \"\"\"\n    Calculates the nth Bell number using dynamic programming (Bell triangle).\n    The Bell number B_n counts the number of partitions of a set with n elements.\n    \"\"\"\n    if n == 0:\n        return 1\n\n    # Create a 2D list (Bell triangle) to store intermediate values.\n    # bell[i][j] stores the j-th number in the i-th row of the triangle.\n    bell = [[0 for _ in range(n + 1)] for _ in range(n + 1)]\n\n    # Initialize the first element, B_0 = 1.\n    bell[0][0] = 1\n\n    # Fill the triangle row by row.\n    # The i-th row (0-indexed) eventually holds B_i in its first element.\n    for i in range(1, n + 1):\n        # The first element of the current row is the last element of the previous row.\n        bell[i][0] = bell[i - 1][i - 1]\n        # Fill the remaining elements of the current row using the recurrence.\n        for j in range(1, i + 1):\n            bell[i][j] = bell[i][j - 1] + bell[i - 1][j - 1]\n\n    # The nth Bell number is the first element of the nth row.\n    return bell[n][0]"}
{"task_id": "Mbpp/611", "solution": "from typing import List, Sequence, Union\n\nNumber = Union[int, float]\n\ndef get_nth_column(matrix: Sequence[Sequence[Number]], n: int) -> List[Number]:\n    \"\"\"Return a list of numeric values representing the nth column of matrix.\n    Preconditions (per SRS): matrix is non-empty and each row has at least n+1 elements.\n    \"\"\"\n    column_values = []\n    for row in matrix:\n        column_values.append(row[n])\n    return column_values\n\ndef max_of_nth(matrix: Sequence[Sequence[Number]], n: int) -> Number:\n    \"\"\"Return the maximum numeric value in the nth (zero-based) column of matrix.\n    Preconditions (per SRS): matrix non-empty and each row contains at least n+1 elements.\n    \"\"\"\n    nth_column = get_nth_column(matrix, n)\n    return max(nth_column)"}
{"task_id": "Mbpp/610", "solution": "def _validate_index(lst, k):\n    \"\"\"Validates k (1-based) and returns 0-based index or raises IndexError.\"\"\"\n    if not isinstance(k, int):\n        raise IndexError(\"k must be an integer.\")\n    if not (1 <= k <= len(lst)):\n        raise IndexError(\"k is out of 1-based list range.\")\n    return k - 1\n\ndef _construct_output_list(lst, remove_index):\n    \"\"\"Constructs and returns a new list omitting the element at remove_index (0-based).\"\"\"\n    new_list = []\n    for i, item in enumerate(lst):\n        if i != remove_index:\n            new_list.append(item)\n    return new_list\n\ndef remove_kth_element(lst, k):\n    \"\"\"\n    Returns a new list with the k'th element removed (1-based index).\n    Does not mutate the input list.\n    \"\"\"\n    remove_idx = _validate_index(lst, k)\n    return _construct_output_list(lst, remove_idx)"}
{"task_id": "Mbpp/612", "solution": "from typing import Any, List\n\ndef validate(input_list: List[List[Any]]) -> bool:\n    \"\"\"\n    Checks if the input is a list of lists, where each sublist has exactly two elements.\n    Returns True if valid, False otherwise.\n    \"\"\"\n    if not isinstance(input_list, list):\n        return False\n    for sublist in input_list:\n        if not isinstance(sublist, list) or len(sublist) != 2:\n            return False\n    return True\n\ndef split(input_list: List[List[Any]]) -> List[List[Any]]:\n    \"\"\"\n    Transposes a list of 2-element sublists into two lists of first and second elements.\n    Assumes valid input_list and preserves original order.\n    \"\"\"\n    # Using zip for transposition\n    # zip(*[['x', 'y'], ['a', 'b']]) results in [('x', 'a'), ('y', 'b')]\n    first_elements, second_elements = zip(*input_list)\n    return [list(first_elements), list(second_elements)]\n\ndef merge(input_list: List[List[Any]]) -> List[List[Any]]:\n    \"\"\"\n    Takes a list of 2-element sublists and returns a list of two lists,\n    containing the first and second elements respectively.\n    \"\"\"\n    if not input_list:\n        return [[], []]\n\n    if not validate(input_list):\n        raise ValueError(\"Input must be a list of 2-element lists\")\n\n    return split(input_list)"}
{"task_id": "Mbpp/614", "solution": "from numbers import Number\nfrom typing import Iterator\n\ndef _validate_input(list_of_tuples: list[tuple[Number, ...]]) -> None:\n    \"\"\"Raises TypeError if list_of_tuples is not a list of tuples of numerics.\"\"\"\n    if not isinstance(list_of_tuples, list):\n        raise TypeError(\"Input must be a list.\")\n    for i, item in enumerate(list_of_tuples):\n        if not isinstance(item, tuple):\n            raise TypeError(f\"Element at index {i} must be a tuple.\")\n        for j, num in enumerate(item):\n            if not isinstance(num, Number):\n                raise TypeError(f\"Element at tuple index {j} within list index {i} must be a numeric type.\")\n\ndef _flatten_tuple_list(list_of_tuples: list[tuple[Number, ...]]) -> Iterator[Number]:\n    \"\"\"Yields numeric values from each tuple in list_of_tuples (empty tuples yield nothing).\"\"\"\n    for item_tuple in list_of_tuples:\n        for num_value in item_tuple:\n            yield num_value\n\ndef cummulative_sum(list_of_tuples: list[tuple[Number, ...]]) -> Number:\n    \"\"\"Public API per SRS: number cummulative_sum(list_of_tuples)\n    - list_of_tuples: a list where each element is a tuple of numeric values.\n    - Returns: numeric total (int or float). Raises TypeError if validation fails.\n    \"\"\"\n    _validate_input(list_of_tuples)\n    flattened_values = _flatten_tuple_list(list_of_tuples)\n    return sum(flattened_values)"}
{"task_id": "Mbpp/615", "solution": "def average_tuple(input_tuple_of_tuples: tuple[tuple[int | float, ...], ...]) -> list[float]:\n    \"\"\"\n    Computes the average value for each inner tuple in a tuple of tuples.\n    Returns a list of float averages, preserving the order of the inner tuples.\n    \"\"\"\n    averages = []\n    for inner_tuple in input_tuple_of_tuples:\n        tuple_sum = sum(inner_tuple)\n        tuple_count = len(inner_tuple)\n        average = tuple_sum / tuple_count\n        averages.append(average)\n    return averages"}
{"task_id": "Mbpp/618", "solution": "def div_list(first_list: list[float|int], second_list: list[float|int]) -> list[float]:\n    \"\"\"\n    Computes element-wise division of two lists, returning a list of floats.\n    SRS signature (literal): div_list(first_list: list[number], second_list: list[number]) -> list[float]\n    Python runtime signature: def div_list(first_list: list[float|int], second_list: list[float|int]) -> list[float]\n    \"\"\"\n    return [float(a) / float(b) for a, b in zip(first_list, second_list)]"}
{"task_id": "Mbpp/616", "solution": "def validate_lengths(first: tuple[int, ...], second: tuple[int, ...]) -> None:\n    \"\"\"\n    Validates if two tuples have the same length.\n    Raises ValueError if lengths differ.\n    \"\"\"\n    if len(first) != len(second):\n        raise ValueError(\"Input tuples must have the same length.\")\n\ndef validate_divisors(second: tuple[int, ...]) -> None:\n    \"\"\"\n    Validates if any element in the divisor tuple is zero.\n    Raises ZeroDivisionError if any element is zero.\n    \"\"\"\n    for divisor in second:\n        if divisor == 0:\n            raise ZeroDivisionError(\"Divisor tuple cannot contain zero.\")\n\ndef tuple_modulo(first: tuple[int, ...], second: tuple[int, ...]) -> tuple[int, ...]:\n    \"\"\"\n    Performs element-wise modulo on two tuples of integers.\n    Raises ValueError if lengths differ, ZeroDivisionError if any divisor is zero.\n    \"\"\"\n    validate_lengths(first, second)\n    validate_divisors(second)\n\n    result = [first[i] % second[i] for i in range(len(first))]\n    return tuple(result)"}
{"task_id": "Mbpp/619", "solution": "def move_num(input: str) -> str:\n    \"\"\"\n    Moves all digit characters to the end of the string, preserving relative order.\n    Non-digit characters appear first, followed by digit characters.\n    \"\"\"\n    non_digits = []\n    digits = []\n    for char in input:\n        if '0' <= char <= '9':  # Check for ASCII digits\n            digits.append(char)\n        else:\n            non_digits.append(char)\n    return \"\".join(non_digits) + \"\".join(digits)"}
{"task_id": "Mbpp/620", "solution": "import collections\nfrom typing import List\n\nclass Validator:\n    \"\"\"Validates input for the largest_subset function, ensuring type correctness and enforcing zero policy.\"\"\"\n    def validate(self, items: List[int]) -> bool:\n        if not isinstance(items, list):\n            raise ValueError(\"Input 'items' must be a list.\")\n        for i, item in enumerate(items):\n            if not isinstance(item, int):\n                raise ValueError(f\"Element at index {i} is not an integer: {item}.\")\n            if item == 0:\n                raise ValueError(\"Zero is not allowed in the input list due to divisibility constraints.\")\n        return True\n\nclass ComputationEngine:\n    \"\"\"Computes the size of the largest divisibility subset using dynamic programming.\"\"\"\n    def compute_largest_subset(self, items: List[int]) -> int:\n        if not items:\n            return 0\n\n        # Sort items to facilitate dynamic programming\n        items.sort()\n\n        # dp[i] stores the size of the largest divisible subset ending with items[i]\n        dp = [1] * len(items)\n        \n        # Iterate through each element to build the longest divisible chain\n        for i in range(len(items)):\n            for j in range(i):\n                # If items[i] is divisible by items[j], it can extend the subset ending at items[j]\n                if items[i] % items[j] == 0:\n                    dp[i] = max(dp[i], dp[j] + 1)\n        \n        # The maximum value in dp array is the size of the largest subset\n        return max(dp)\n\ndef largest_subset(items: List[int]) -> int:\n    \"\"\"Finds the size of the largest subset of numbers where every pair is divisible.\"\"\"\n    validator = Validator()\n    validator.validate(items)\n\n    if not items:\n        return 0\n    \n    computation_engine = ComputationEngine()\n    return computation_engine.compute_largest_subset(items)"}
