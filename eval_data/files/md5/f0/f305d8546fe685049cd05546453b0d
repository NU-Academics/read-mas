{"task_id": "Mbpp/269", "solution": "class ValidationError(Exception):\n    \"\"\"Exception raised for validation errors in character input.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\n\nclass CharacterInput:\n    \"\"\"Data holder for input character and its length.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n        self.length = len(value)\n\nclass AsciiCode:\n    \"\"\"Data holder for the integer ASCII code result.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\ndef validateInput(char: str) -> None:\n    \"\"\"Validates that the input is a single-character string.\"\"\"\n    if not isinstance(char, str) or len(char) != 1:\n        raise ValidationError(\"input must be a string of length 1\")\n\ndef ascii_value(char: str) -> int:\n    \"\"\"Returns the ASCII integer value for a single character string.\"\"\"\n    validateInput(char)\n    return ord(char)"}
{"task_id": "Mbpp/270", "solution": "def sum_even_and_even_index(input_list: list[int]) -> int:\n    \"\"\"\n    Calculates the sum of even numbers found at even positions (0-indexed) in a list.\n    Returns 0 if no such numbers are found or the list is empty.\n    \"\"\"\n    total_sum = 0\n    for index, value in enumerate(input_list):\n        if index % 2 == 0 and value % 2 == 0:\n            total_sum += value\n    return total_sum"}
{"task_id": "Mbpp/271", "solution": "def validate_input(n):\n    \"\"\"Raise TypeError if n is not an instance of int.\"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an int\")\n\ndef compute(n):\n    \"\"\"Compute and return sum_{k=1..n} (2*k)**5.\"\"\"\n    total_sum = 0\n    for k in range(1, n + 1):\n        total_sum += (2 * k) ** 5\n    return total_sum\n\ndef even_Power_Sum(n):\n    \"\"\"Public API. Validates and computes sum_{k=1..n} (2k)**5.\"\"\"\n    validate_input(n)\n    return compute(n)"}
{"task_id": "Mbpp/273", "solution": "from typing import Union\n\ndef substract_elements(a: tuple, b: tuple) -> tuple:\n    \"\"\"Subtracts elements of the second tuple from the first tuple element-wise.\n    Validates inputs for type, length, and numeric elements, raising ValueError on failure.\n    \"\"\"\n    if not isinstance(a, tuple) or not isinstance(b, tuple):\n        raise ValueError(\"Inputs must both be tuples.\")\n\n    if len(a) != len(b):\n        raise ValueError(\"Input tuples must have the same length.\")\n\n    result = []\n    for i in range(len(a)):\n        val_a = a[i]\n        val_b = b[i]\n\n        if not isinstance(val_a, (int, float)) or not isinstance(val_b, (int, float)):\n            raise ValueError(\"All elements in both tuples must be numeric (int or float).\")\n\n        result.append(val_a - val_b)\n\n    return tuple(result)"}
{"task_id": "Mbpp/274", "solution": "try:\n    from math import comb as _math_comb\nexcept ImportError:\n    _math_comb = None\n\n\ndef _validate_n(n):\n    \"\"\"Ensures n is a positive integer.\"\"\"\n    if not isinstance(n, int):\n        raise ValueError(\"n must be an integer\")\n    if n <= 0:\n        raise ValueError(\"n must be a positive integer (n >= 1)\")\n\n\ndef _binomial_coefficient(n, k):\n    \"\"\"Computes the binomial coefficient C(n, k).\"\"\"\n    if _math_comb is not None:\n        return _math_comb(n, k)\n\n    # Fallback implementation: C(n,k) = C(n, n-k) optimization and iterative multiplication/division\n    # This also handles k < 0 or k > n correctly by setting k to a negative value initially,\n    # which then passes the k < 0 check.\n    k = min(k, n - k)\n    if k < 0:\n        return 0\n    \n    result = 1\n    for i in range(1, k + 1):\n        result = result * (n - (k - i)) // i\n    return result\n\n\ndef even_binomial_Coeff_Sum(n):\n    \"\"\"Validates n and returns the sum of C(n,k) for even k in 0..n as an integer.\"\"\"\n    _validate_n(n)\n    total = 0\n    for k in range(0, n + 1):\n        if k % 2 == 0:\n            total += _binomial_coefficient(n, k)\n    return int(total)"}
