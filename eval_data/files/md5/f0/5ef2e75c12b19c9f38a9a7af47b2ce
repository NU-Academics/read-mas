{"task_id": "HumanEval/146", "solution": "def specialFilter(nums):\n    \"\"\"\n    Counts elements in the array that are greater than 10 and have both\n    first and last digits as odd numbers.\n    \"\"\"\n    count = 0\n    for num in nums:\n        if num > 10:\n            # Convert the absolute value to a string to easily access digits\n            s_num = str(abs(num))\n\n            # Extract first and last digits\n            first_digit = int(s_num[0])\n            last_digit = int(s_num[-1])\n\n            # Check if both digits are odd\n            if first_digit % 2 != 0 and last_digit % 2 != 0:\n                count += 1\n    return count"}
{"task_id": "HumanEval/145", "solution": "def order_by_points(nums):\n    \"\"\"\n    Sorts the given list of integers in ascending order according to the sum of their digits.\n    If sums of digits are similar, order them based on their original index.\n    \"\"\"\n\n    def _calculate_sum_of_digits(number):\n        \"\"\"Calculates the sum of digits for an integer, using its absolute value.\"\"\"\n        return sum(int(digit) for digit in str(abs(number)))\n\n    decorated_list = []\n    for index, value in enumerate(nums):\n        sum_digits = _calculate_sum_of_digits(value)\n        decorated_list.append((sum_digits, index, value))\n\n    decorated_list.sort()\n\n    sorted_result = [item[2] for item in decorated_list]\n    return sorted_result"}
{"task_id": "HumanEval/149", "solution": "def sorted_list_sum(lst):\n    \"\"\"Filters a list of strings to remove odd-length strings,\n    then sorts the remaining strings by length (ascending) and alphabetically (ascending) for equal lengths.\n    \"\"\"\n    even_length_strings = [s for s in lst if len(s) % 2 == 0]\n    sorted_result = sorted(even_length_strings, key=lambda s: (len(s), s))\n    return sorted_result"}
{"task_id": "HumanEval/150", "solution": "import math\ndef x_or_y(n, x, y):\n    \"\"\"A simple program which should return the value of x if n is\n    a prime number and should return the value of y otherwise.\n\n    Examples:\n    for x_or_y(7, 34, 12) == 34\n    for x_or_y(15, 8, 5) == 5\n\n    \"\"\"\n    # Determines if a given integer is a prime number.\n    def is_prime(number: int) -> bool:\n        if number < 2:\n            return False\n        if number == 2:\n            return True\n        if number % 2 == 0:\n            return False"}
{"task_id": "HumanEval/148", "solution": "def bf(planet1, planet2):\n    '''\n    There are eight planets in our solar system: the closerst to the Sun\n    is Mercury, the next one is Venus, then Earth, Mars, Jupiter, Saturn,\n    Uranus, Neptune.\n    Write a function that takes two planet names as strings planet1 and planet2.\n    The function should return a tuple containing all planets whose orbits are\n    located between the orbit of planet1 and the orbit of planet2, sorted by\n    the proximity to the sun.\n    The function should return an empty tuple if planet1 or planet2\n    are not correct planet names.\n    Examples\n    bf(\"Jupiter\", \"Neptune\") ==> (\"Saturn\", \"Uranus\")\n    bf(\"Earth\", \"Mercury\") ==> (\"Venus\")\n    bf(\"Mercury\", \"Uranus\") ==> (\"Venus\", \"Earth\", \"Mars\", \"Jupiter\", \"Saturn\")\n    '''\n    # Define Planet class as a local helper, as implied by design context and \"inline\" constraint.\n    class Planet:\n        def __init__(self, name: str, order_from_sun: int):\n            self.name = name\n            self.order_from_sun = order_from_sun\n\n    # Define the ordered list of Planet objects, representing the solar system data.\n    planets_data = [\n        Planet(\"Mercury\", 1),\n        Planet(\"Venus\", 2),\n        Planet(\"Earth\", 3),\n        Planet(\"Mars\", 4),\n        Planet(\"Jupiter\", 5),\n        Planet(\"Saturn\", 6),\n        Planet(\"Uranus\", 7),\n        Planet(\"Neptune\", 8),\n    ]\n\n    # Create a quick lookup map for planet names to their corresponding Planet objects.\n    planet_map = {p.name: p for p in planets_data}\n\n    # Return an empty tuple if either input planet name is not valid.\n    if planet1 not in planet_map or planet2 not in planet_map:\n        return ()\n\n    # Get the order from the sun for the two input planets.\n    order1 = planet_map[planet1].order_from_sun\n    order2 = planet_map[planet2].order_from_sun\n\n    # Determine the minimum and maximum order to define the exclusive range.\n    min_order = min(order1, order2)\n    max_order = max(order1, order2)\n\n    # Collect the names of planets whose orbits lie strictly between the two input planets.\n    result_planets_names = []\n    for p in planets_data:\n        if min_order < p.order_from_sun < max_order:\n            result_planets_names.append(p.name)\n\n    return tuple(result_planets_names)"}
{"task_id": "HumanEval/151", "solution": "class Number:\n    # Encapsulates a value and provides methods to determine its properties and calculate its square.\n    def __init__(self, value):\n        self.value = value\n\n    # Checks if the value is an integer.\n    def is_integer(self):\n        return isinstance(self.value, int)\n\n    # Checks if the value is non-negative.\n    def is_positive(self):\n        return self.value >= 0\n\n    # Checks if the value is odd.\n    def is_odd(self):\n        return self.value % 2 != 0\n\n    # Calculates the square of the value.\n    def get_square(self):\n        return self.value * self.value\ndef double_the_difference(lst):\n    '''\n    Given a list of numbers, return the sum of squares of the numbers\n    in the list that are odd. Ignore numbers that are negative or not integers.\n\n    double_the_difference([1, 3, 2, 0]) == 1 + 9 + 0 + 0 = 10\n    double_the_difference([-1, -2, 0]) == 0\n    double_the_difference([9, -2]) == 81\n    double_the_difference([0]) == 0\n\n    If the input list is empty, return 0.\n    '''\n    total_sum = 0\n    if not lst:\n        return 0\n\n    for element in lst:\n        num_obj = Number(element)\n        # Filter for integer, non-negative, and odd numbers before squaring.\n        if num_obj.is_integer() and num_obj.is_positive() and num_obj.is_odd():\n            total_sum += num_obj.get_square()\n\n    return total_sum"}
{"task_id": "HumanEval/154", "solution": "def cycpattern_check(a , b):\n    \"\"\"\n    Checks if the second word or any of its rotations is a substring in the first word.\n    \"\"\"\n    def _generate_rotations(s: str) -> list[str]:\n        \"\"\"Generates all cyclic rotations of a given string.\"\"\"\n        if not s:\n            return [\"\"]\n        rotations = []\n        s_double = s + s\n        for i in range(len(s)):\n            rotations.append(s_double[i : i + len(s)])\n        return rotations\n\n    b_rotations = _generate_rotations(b)\n\n    for rotation in b_rotations:\n        if rotation in a:\n            return True\n\n    return False"}
{"task_id": "HumanEval/152", "solution": "def compare(game,guess):\n    \"\"\"I think we all remember that feeling when the result of some long-awaited\n    event is finally known. The feelings and thoughts you have at that moment are\n    definitely worth noting down and comparing.\n    Your task is to determine if a person correctly guessed the results of a number of matches.\n    You are given two arrays of scores and guesses of equal length, where each index shows a match.\n    Return an array of the same length denoting how far off each guess was. If they have guessed correctly,\n    the value is 0, and if not, the value is the absolute difference between the guess and the score.\n\n\n    example:\n\n    compare([1,2,3,4,5,1],[1,2,3,4,2,-2]) -> [0,0,0,0,3,3]\n    compare([0,5,0,0,0,4],[4,1,1,0,0,-2]) -> [4,4,1,0,0,6]\n    \"\"\"\n    differences = []\n    for i in range(len(game)):\n        if game[i] == guess[i]:\n            differences.append(0)\n        else:\n            differences.append(abs(game[i] - guess[i]))\n    return differences"}
{"task_id": "HumanEval/155", "solution": "def even_odd_count(num):\n    \"\"\"Given an integer. return a tuple that has the number of even and odd digits respectively.\n\n     Example:\n        even_odd_count(-12) ==> (1, 1)\n        even_odd_count(123) ==> (1, 2)\n    \"\"\"\n    even_count = 0\n    odd_count = 0\n\n    # Handle negative numbers by taking the absolute value\n    num_str = str(abs(num))\n\n    # Iterate through each digit in the string representation\n    for digit_char in num_str:\n        digit = int(digit_char)\n        if digit % 2 == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n\n    return (even_count, odd_count)"}
{"task_id": "HumanEval/156", "solution": "def int_to_mini_roman(number):\n    \"\"\"\n    Given a positive integer, obtain its roman numeral equivalent as a string,\n    and return it in lowercase.\n    Restrictions: 1 <= num <= 1000\n    \"\"\"\n\n    def _validate_input(num):\n        \"\"\"Validates if the input integer is within the acceptable range [1, 1000].\"\"\"\n        if not (1 <= num <= 1000):\n            raise ValueError(\"Input out of range: number must be between 1 and 1000.\")\n\n    def _convert_to_roman(num):\n        \"\"\"Converts a valid integer into its standard uppercase Roman numeral string representation.\"\"\"\n        roman_map = [\n            (1000, 'M'), (900, 'CM'), (500, 'D'), (400, 'CD'),\n            (100, 'C'), (90, 'XC'), (50, 'L'), (40, 'XL'),\n            (10, 'X'), (9, 'IX'), (5, 'V'), (4, 'IV'), (1, 'I')\n        ]\n\n        roman_numeral = []\n        temp_num = num\n        for value, symbol in roman_map:\n            while temp_num >= value:\n                roman_numeral.append(symbol)\n                temp_num -= value\n        return \"\".join(roman_numeral)\n\n    def _to_lowercase(roman_str):\n        \"\"\"Converts an uppercase Roman numeral string to its lowercase equivalent.\"\"\"\n        return roman_str.lower()\n\n    _validate_input(number)\n    uppercase_roman = _convert_to_roman(number)\n    return _to_lowercase(uppercase_roman)"}
{"task_id": "HumanEval/153", "solution": "def _calculate_strength(extension_name):\n    \"\"\"Calculates an extension's strength as (uppercase letters) - (lowercase letters).\n    Non-alphabetic characters are ignored.\"\"\"\n    uppercase_count = 0\n    lowercase_count = 0\n    for char in extension_name:\n        if 'A' <= char <= 'Z':\n            uppercase_count += 1\n        elif 'a' <= char <= 'z':\n            lowercase_count += 1\n    return uppercase_count - lowercase_count\nclass ExtensionInfo:\n    \"\"\"Holds an extension's name, its calculated strength, and its original index.\"\"\"\n    def __init__(self, name, strength, original_index):\n        self.name = name\n        self.strength = strength\n        self.original_index = original_index\ndef Strongest_Extension(class_name, extensions):\n    \"\"\"Finds the strongest extension from a list based on CAP - SM strength.\n    In case of a tie, the extension that appears first in the input list is chosen.\"\"\"\n    if not extensions:\n        return f\"{class_name}.NoExtensionFound\"\n\n    strongest_ext_info = None\n\n    for i, ext_name in enumerate(extensions):\n        current_strength = _calculate_strength(ext_name)\n        current_ext_info = ExtensionInfo(ext_name, current_strength, i)\n\n        if strongest_ext_info is None or \\\n           current_ext_info.strength > strongest_ext_info.strength or \\\n           (current_ext_info.strength == strongest_ext_info.strength and \\\n            current_ext_info.original_index < strongest_ext_info.original_index):\n            strongest_ext_info = current_ext_info\n\n    return f\"{class_name}.{strongest_ext_info.name}\""}
{"task_id": "HumanEval/147", "solution": "def get_max_triples(n):\n    \"\"\"Calculates the number of triples (a[i], a[j], a[k]) where 1 <= i < j < k <= n,\n    and a[i] + a[j] + a[k] is a multiple of 3, with a[x] = x*x - x + 1.\n    \"\"\"\n    if n < 3:\n        return 0\n\n    valid_triples_count = 0\n\n    # The loops iterate over 0-indexed i_idx, j_idx, k_idx.\n    # The value a[x] is defined for 1-indexed x, so we use (index + 1) for calculation.\n    for i_idx in range(n - 2):\n        for j_idx in range(i_idx + 1, n - 1):\n            for k_idx in range(j_idx + 1, n):\n                # Calculate sequence elements based on 1-indexed values (idx+1)\n                val_i = (i_idx + 1) * (i_idx + 1) - (i_idx + 1) + 1\n                val_j = (j_idx + 1) * (j_idx + 1) - (j_idx + 1) + 1\n                val_k = (k_idx + 1) * (k_idx + 1) - (k_idx + 1) + 1\n\n                current_sum = val_i + val_j + val_k\n\n                if current_sum % 3 == 0:\n                    valid_triples_count += 1\n\n    return valid_triples_count"}
{"task_id": "HumanEval/162", "solution": "import hashlib\ndef string_to_md5(text):\n    \"\"\"\n    Given a string 'text', return its md5 hash equivalent string.\n    If 'text' is an empty string, return None.\n    \"\"\"\n    if not text:\n        return None\n    return hashlib.md5(text.encode('utf-8')).hexdigest()"}
{"task_id": "HumanEval/157", "solution": "def right_angle_triangle(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle. Return True if the three\n    sides form a right-angled triangle, False otherwise.\n    A right-angled triangle is a triangle in which one angle is right angle or\n    90 degree.\n    Example:\n    right_angle_triangle(3, 4, 5) == True\n    right_angle_triangle(1, 2, 3) == False\n    '''\n    # Validate that all sides are positive.\n    if a <= 0 or b <= 0 or c <= 0:\n        return False\n\n    # Sort the sides to easily identify the potential hypotenuse.\n    sides = sorted([a, b, c])\n    x, y, z = sides[0], sides[1], sides[2]\n\n    # Check if the Pythagorean theorem holds using direct equality.\n    return x * x + y * y == z * z"}
{"task_id": "HumanEval/161", "solution": "def solve(s):\n    \"\"\"You are given a string s.\n    if s[i] is a letter, reverse its case from lower to upper or vise versa,\n    otherwise keep it as it is.\n    If the string contains no letters, reverse the string.\n    The function should return the resulted string.\n    \"\"\"\n\n    def _contains_letters(text: str) -> bool:\n        \"\"\"Checks if the given string contains at least one letter.\"\"\"\n        for char in text:\n            if char.isalpha():\n                return True\n        return False\n\n    def _process_case_reversal(text: str) -> str:\n        \"\"\"Processes the string by reversing case of letters and keeping non-letters as is.\"\"\"\n        result_chars = []\n        for char in text:\n            if char.islower():\n                result_chars.append(char.upper())\n            elif char.isupper():\n                result_chars.append(char.lower())\n            else:\n                result_chars.append(char)\n        return \"\".join(result_chars)\n\n    def _reverse_entire_string(text: str) -> str:\n        \"\"\"Reverses the order of all characters in a string.\"\"\"\n        return text[::-1]\n\n    if _contains_letters(s):\n        return _process_case_reversal(s)\n    else:\n        return _reverse_entire_string(s)"}
{"task_id": "HumanEval/160", "solution": "def do_algebra(operator, operand):\n    \"\"\"\n    Given two lists operator, and operand. The first list has basic algebra operations, and\n    the second list is a list of integers. Use the two given lists to build the algebric\n    expression and return the evaluation of this expression.\n    \"\"\"\n    expression_parts = [str(operand[0])]\n    for i in range(len(operator)):\n        expression_parts.append(operator[i])\n        expression_parts.append(str(operand[i+1]))\n\n    expression_str = \" \".join(expression_parts)\n    return eval(expression_str)"}
{"task_id": "HumanEval/159", "solution": "from typing import List\ndef eat(number: int, need: int, remaining: int) -> List[int]:\n    \"\"\"Calculates the total carrots eaten and remaining after a meal.\n    The rabbit eats 'need' carrots if available, otherwise all 'remaining' carrots.\n    \"\"\"\n\n    consumed_amount: int\n\n    if need <= remaining:\n        consumed_amount = need\n    else:\n        consumed_amount = remaining\n\n    total_eaten_carrots = number + consumed_amount\n    carrots_left = remaining - consumed_amount\n\n    return [total_eaten_carrots, carrots_left]"}
{"task_id": "HumanEval/158", "solution": "class Word:\n    \"\"\"Encapsulates a string value and its unique character count, providing methods for calculation and comparison.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n        self.unique_char_count = self.calculate_unique_characters()\n\n    def calculate_unique_characters(self) -> int:\n        \"\"\"Determines the count of distinct characters in the value string.\"\"\"\n        return len(set(self.value))\n\n    def __lt__(self, other: 'Word') -> bool:\n        \"\"\"Implements the \"less than\" comparison operator for lexicographical sorting.\"\"\"\n        return self.value < other.value\n\n    def __eq__(self, other: object) -> bool:\n        \"\"\"Implements the \"equals\" comparison operator, checking if two Word objects are equal based on their value.\"\"\"\n        return self.value == other.value\ndef find_max(words):\n    \"\"\"Return the word with the maximum number of unique characters.\n    If multiple strings have maximum unique characters, return the one which comes first lexicographically.\n    \"\"\"\n    if not words:\n        return \"\"\n\n    word_objects = [Word(word) for word in words]\n\n    max_unique_count = -1\n    for word_obj in word_objects:\n        if word_obj.unique_char_count > max_unique_count:\n            max_unique_count = word_obj.unique_char_count\n\n    candidate_words = [word_obj for word_obj in word_objects if word_obj.unique_char_count == max_unique_count]\n\n    # Use min() which leverages the __lt__ method for lexicographical tie-breaking\n    selected_word_obj = min(candidate_words)\n\n    return selected_word_obj.value"}
{"task_id": "HumanEval/163", "solution": "def generate_integers(a, b):\n    \"\"\"\n    Given two positive integers a and b, return the even digits between a\n    and b, in ascending order.\n\n    For example:\n    generate_integers(2, 8) => [2, 4, 6, 8]\n    generate_integers(8, 2) => [2, 4, 6, 8]\n    generate_integers(10, 14) => []\n    \"\"\"\n    min_val = min(a, b)\n    max_val = max(a, b)\n\n    target_numbers = [2, 4, 6, 8]\n\n    result_list = []\n\n    for number in target_numbers:\n        if min_val <= number <= max_val:\n            result_list.append(number)\n\n    result_list.sort() # Ensure ascending order, though already sorted by construction here.\n\n    return result_list"}
