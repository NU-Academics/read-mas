{"task_id": "HumanEval/39", "solution": "class PrimeChecker:\n    \"\"\"Determines if a given integer is a prime number.\"\"\"\n    def __init__(self):\n        pass\n\n    def is_prime(self, num: int) -> bool:\n        \"\"\"Checks if a number is prime.\"\"\"\n        if num < 2:\n            return False\n        if num == 2:\n            return True\n        if num % 2 == 0:\n            return False\n        i = 3\n        while i * i <= num:\n            if num % i == 0:\n                return False\n            i += 2\n        return True\nclass FibonacciGenerator:\n    \"\"\"Generates Fibonacci numbers iteratively.\"\"\"\n    def __init__(self):\n        self._a: int = 0\n        self._b: int = 1\n\n    def generate(self) -> int:\n        \"\"\"Returns the next Fibonacci number in the sequence.\"\"\"\n        current_fib = self._a\n        self._a, self._b = self._b, self._a + self._b\n        return current_fib\nclass PrimeFibonacciFinder:\n    \"\"\"Orchestrates finding the n-th prime Fibonacci number.\"\"\"\n    def __init__(self, fib_generator: FibonacciGenerator, prime_checker: PrimeChecker):\n        self._fib_generator = fib_generator\n        self._prime_checker = prime_checker\n\n    def find_nth(self, n: int) -> int:\n        \"\"\"Finds the n-th number that is both Fibonacci and prime.\"\"\"\n        prime_fib_count = 0\n        while True:\n            fib_num = self._fib_generator.generate()\n            if self._prime_checker.is_prime(fib_num):\n                prime_fib_count += 1\n                if prime_fib_count == n:\n                    return fib_num\ndef prime_fib(n: int):\n    \"\"\"\n    prime_fib returns n-th number that is a Fibonacci number and it's also prime.\n    >>> prime_fib(1)\n    2\n    >>> prime_fib(2)\n    3\n    >>> prime_fib(3)\n    5\n    >>> prime_fib(4)\n    13\n    >>> prime_fib(5)\n    89\n    \"\"\"\n    fib_generator = FibonacciGenerator()\n    prime_checker = PrimeChecker()\n    finder = PrimeFibonacciFinder(fib_generator, prime_checker)\n    return finder.find_nth(n)"}
