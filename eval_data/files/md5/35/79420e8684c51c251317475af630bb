{"task_id": "HumanEval/86", "solution": "class AntiShuffle:\n    def process(self, s: str) -> str:\n        if not s:\n            return \"\"\n\n        tokens_and_types = []\n        current_token = \"\"\n        is_current_token_space = None\n\n        for char in s:\n            char_is_space = (char == ' ')\n\n            if not current_token:\n                current_token = char\n                is_current_token_space = char_is_space\n            elif char_is_space == is_current_token_space:\n                current_token += char\n            else:\n                tokens_and_types.append((current_token, is_current_token_space))\n                current_token = char\n                is_current_token_space = char_is_space\n\n        if current_token:\n            tokens_and_types.append((current_token, is_current_token_space))\n\n        result_parts = []\n        for token_str, is_space_token in tokens_and_types:\n            if is_space_token:\n                result_parts.append(token_str)\n            else:\n                result_parts.append(\"\".join(sorted(token_str)))\n\n        return \"\".join(result_parts)\n\ndef anti_shuffle(s):\n    \"\"\"\n    Rearranges characters within words of a string to ascending ASCII order,\n    preserving word order and blank spaces.\n    \"\"\"\n    processor = AntiShuffle()\n    return processor.process(s)"}
{"task_id": "HumanEval/86", "solution": "def anti_shuffle(s):\n    \"\"\"\n    Returns an ordered version of the string where characters within each word are sorted.\n    Words are separated by spaces, and their order, along with space order, is preserved.\n    \"\"\"\n    result_parts = []\n    current_word_chars = []\n\n    for char in s:\n        if char == ' ':\n            if current_word_chars:\n                # If a word was accumulated, sort its characters and add it\n                sorted_word = \"\".join(sorted(current_word_chars))\n                result_parts.append(sorted_word)\n                current_word_chars = []  # Reset for the next word\n            result_parts.append(' ')  # Add the space\n        else:\n            # Accumulate characters for the current word\n            current_word_chars.append(char)\n    \n    # After the loop, process any remaining characters as the last word\n    if current_word_chars:\n        sorted_word = \"\".join(sorted(current_word_chars))\n        result_parts.append(sorted_word)\n    \n    return \"\".join(result_parts)"}
{"task_id": "HumanEval/87", "solution": "def get_row(lst, x):\n    \"\"\"\n    Find integers x in the list and return list of coordinates (row, column).\n    Coordinates are sorted by row ascending, then by column descending.\n    \"\"\"\n    coords = []\n    for i, row in enumerate(lst):\n        for j, val in enumerate(row):\n            if val == x:\n                coords.append((i, j))\n    # Sort: row ascending, then column descending\n    coords.sort(key=lambda c: (c[0], -c[1]))\n    return coords"}
{"task_id": "HumanEval/87", "solution": "def get_row(lst, x):\n    \"\"\"\n    Finds integer x in a nested list and returns a list of (row, column) coordinates.\n    Coordinates are sorted by row ascending, then by column descending.\n    \"\"\"\n    coordinates = []\n    for r_idx, row in enumerate(lst):\n        for c_idx, value in enumerate(row):\n            if value == x:\n                coordinates.append((r_idx, c_idx))\n\n    # Sort coordinates: primary by row (ascending), secondary by column (descending)\n    coordinates.sort(key=lambda coord: (coord[0], -coord[1]))\n\n    return coordinates"}
{"task_id": "HumanEval/88", "solution": "def sort_array(array):\n    \"\"\"\n    Sorts an array of non-negative integers based on the parity of the sum of its first and last elements.\n    Returns a new sorted array, leaving the original array unchanged.\n    \"\"\"\n    if not array:\n        return []\n\n    # Calculate sum of first and last elements.\n    # For single-element arrays, both array[0] and array[-1] refer to the same element.\n    sum_first_last = array[0] + array[-1]\n\n    # Determine sorting order\n    if sum_first_last % 2 == 0:  # Sum is even, sort in descending order\n        return sorted(array, reverse=True)\n    else:  # Sum is odd, sort in ascending order\n        return sorted(array)"}
{"task_id": "HumanEval/88", "solution": "def sort_array(array):\n    \"\"\"\n    Given an array of non-negative integers, return a copy of the given array after sorting,\n    you will sort the given array in ascending order if the sum( first index value, last index value) is odd,\n    or sort it in descending order if the sum( first index value, last index value) is even.\n    \"\"\"\n    if len(array) <= 1:\n        return list(array)\n\n    first_element = array[0]\n    last_element = array[-1]\n    sum_first_last = first_element + last_element\n\n    if sum_first_last % 2 == 1:  # Odd sum, sort ascending\n        return sorted(array)\n    else:  # Even sum, sort descending\n        return sorted(array, reverse=True)"}
{"task_id": "HumanEval/89", "solution": "def encrypt(s):\n    \"\"\"Encrypts a string by shifting each alphabetic character down by four places, wrapping around the alphabet.\"\"\"\n    encrypted_chars = []\n    shift = 4\n\n    for char in s:\n        if 'a' <= char <= 'z':\n            start_ord = ord('a')\n            current_pos = ord(char) - start_ord\n            new_pos = (current_pos + shift) % 26\n            encrypted_chars.append(chr(start_ord + new_pos))\n        elif 'A' <= char <= 'Z':\n            start_ord = ord('A')\n            current_pos = ord(char) - start_ord\n            new_pos = (current_pos + shift) % 26\n            encrypted_chars.append(chr(start_ord + new_pos))\n        else:\n            encrypted_chars.append(char)\n\n    return \"\".join(encrypted_chars)"}
{"task_id": "HumanEval/89", "solution": "def encrypt(s):\n    \"\"\"Create a function encrypt that takes a string as an argument and\n    returns a string encrypted with the alphabet being rotated. \n    The alphabet should be rotated in a manner such that the letters \n    shift down by two multiplied to two places.\n    For example:\n    encrypt('hi') returns 'lm'\n    encrypt('asdfghjkl') returns 'ewhjklnop'\n    encrypt('gf') returns 'kj'\n    encrypt('et') returns 'ix'\n    \"\"\"\n    result = []\n    shift_amount = 4  # Two multiplied by two places\n\n    for char in s:\n        if 'a' <= char <= 'z':\n            # Handle lowercase letters with wrap-around\n            start_ord = ord('a')\n            current_index = ord(char) - start_ord\n            new_index = (current_index + shift_amount) % 26\n            result.append(chr(start_ord + new_index))\n        elif 'A' <= char <= 'Z':\n            # Handle uppercase letters with wrap-around\n            start_ord = ord('A')\n            current_index = ord(char) - start_ord\n            new_index = (current_index + shift_amount) % 26\n            result.append(chr(start_ord + new_index))\n        else:\n            # Non-alphabetic characters remain unchanged\n            result.append(char)\n\n    return \"\".join(result)"}
{"task_id": "HumanEval/90", "solution": "def next_smallest(lst):\n    \"\"\"\n    You are given a list of integers.\n    Write a function next_smallest() that returns the 2nd smallest element of the list.\n    Return None if there is no such element.\n    \n    next_smallest([1, 2, 3, 4, 5]) == 2\n    next_smallest([5, 1, 4, 3, 2]) == 2\n    next_smallest([]) == None\n    next_smallest([1, 1]) == None\n    \"\"\"\n    unique_elements = sorted(list(set(lst)))\n\n    if len(unique_elements) < 2:\n        return None\n    else:\n        return unique_elements[1]"}
{"task_id": "HumanEval/90", "solution": "def next_smallest(lst):\n    \"\"\"\n    Returns the 2nd smallest distinct element of the list, or None if not available.\n    This implementation achieves O(N) time complexity and O(1) space complexity.\n    \"\"\"\n    first_smallest = float('inf')\n    second_smallest = float('inf')\n\n    for x in lst:\n        if x < first_smallest:\n            # Found a new smallest element, so the old smallest becomes the new second smallest\n            second_smallest = first_smallest\n            first_smallest = x\n        elif x > first_smallest and x < second_smallest:\n            # Found an element that is smaller than second_smallest but larger than first_smallest\n            second_smallest = x\n    \n    # If second_smallest is still infinity, it means there was no second distinct element\n    if second_smallest == float('inf'):\n        return None\n    else:\n        return second_smallest"}
{"task_id": "HumanEval/91", "solution": "def is_bored(S):\n    \"\"\"\n    Counts the number of sentences in a string that start with the word \"I\".\n    Sentences are delimited by '.', '?' or '!'.\n    \"\"\"\n    import re\n\n    class StringInput:\n        \"\"\"Handles input trimming for further processing.\"\"\"\n        def __init__(self, text: str):\n            self.text = text\n\n        def trim(self) -> str:\n            \"\"\"Removes leading/trailing whitespace from the input text.\"\"\"\n            return self.text.strip()\n\n    class Sentence:\n        \"\"\"Represents a parsed sentence and checks if it starts with 'I'.\"\"\"\n        def __init__(self, text: str):\n            self.text = text\n\n        def startsWithI(self) -> bool:\n            \"\"\"Returns True if the sentence text begins with the uppercase 'I'.\"\"\"\n            return self.text.startswith(\"I\")\n\n    class BoredomCounter:\n        \"\"\"Parses sentences and counts 'boredoms'.\"\"\"\n        @staticmethod\n        def parseSentences(input_obj: StringInput) -> list[Sentence]:\n            \"\"\"Splits the trimmed input into Sentence objects using delimiters.\"\"\"\n            trimmed = input_obj.trim()\n            # Split by '.', '?', '!' and filter out any empty fragments after stripping.\n            fragments = [f.strip() for f in re.split(r'[.!?]', trimmed) if f.strip()]\n            return [Sentence(f) for f in fragments]\n\n        @staticmethod\n        def countBoredoms(sentences: list[Sentence]) -> int:\n            \"\"\"Counts how many sentences in the list start with 'I'.\"\"\"\n            return sum(1 for s in sentences if s.startsWithI())\n\n    if not S:\n        return 0\n\n    input_obj = StringInput(S)\n    sentences = BoredomCounter.parseSentences(input_obj)\n    return BoredomCounter.countBoredoms(sentences)"}
{"task_id": "HumanEval/91", "solution": "def is_bored(S):\n    \"\"\"\n    Counts sentences starting with \"I\", delimited by '.', '?' or '!'.\n    \"\"\"\n\n    class Sentence:\n        \"\"\"\n        Represents a sentence extracted from the input string.\n        \"\"\"\n        def __init__(self, raw: str):\n            self.text = raw\n\n        def startsWithI(self) -> bool:\n            \"\"\"\n            Returns True if the sentence starts with an uppercase 'I'\n            followed by a space or end of string, ignoring leading whitespace.\n            \"\"\"\n            stripped = self.text.lstrip()\n            if not stripped:\n                return False\n            if stripped[0] != 'I':\n                return False\n            # Ensure 'I' is followed by space or end of string\n            return len(stripped) == 1 or stripped[1] == ' '\n\n    class StringProcessor:\n        \"\"\"\n        Core logic for parsing the input string and counting boredom sentences.\n        \"\"\"\n        _DELIMITERS = {'.', '?', '!'}\n\n        def countBoredoms(self, text: str) -> int:\n            if not text:\n                return 0\n\n            # Split on delimiters while preserving empty fragments for consecutive delimiters\n            raw_sentences = []\n            start = 0\n            for i, ch in enumerate(text):\n                if ch in self._DELIMITERS:\n                    raw_sentences.append(text[start:i+1])\n                    start = i+1\n            # Add the last fragment\n            raw_sentences.append(text[start:])\n\n            count = 0\n            for raw in raw_sentences:\n                sentence = Sentence(raw)\n                if sentence.startsWithI():\n                    count += 1\n            return count\n\n    processor = StringProcessor()\n    return processor.countBoredoms(S)"}
{"task_id": "HumanEval/92", "solution": "def any_int(x, y, z):\n    '''\n    Create a function that takes 3 numbers.\n    Returns true if one of the numbers is equal to the sum of the other two, and all numbers are integers.\n    Returns false in any other cases.\n    \n    Examples\n    any_int(5, 2, 7) \u279e True\n    \n    any_int(3, 2, 2) \u279e False\n\n    any_int(3, -2, 1) \u279e True\n    \n    any_int(3.6, -2.2, 2) \u279e False\n  \n\n    \n    '''\n    # Check if all inputs are effectively integers (e.g., 5, 5.0 are integers, 3.6 is not).\n    if not (x == int(x) and y == int(y) and z == int(z)):\n        return False\n    \n    # Check if any one number is the sum of the other two.\n    if (x + y == z) or (x + z == y) or (y + z == x):\n        return True\n    else:\n        return False"}
{"task_id": "HumanEval/92", "solution": "def any_int(x, y, z):\n    '''\n    Create a function that takes 3 numbers.\n    Returns true if one of the numbers is equal to the sum of the other two, and all numbers are integers.\n    Returns false in any other cases.\n    \n    Examples\n    any_int(5, 2, 7) \u279e True\n    \n    any_int(3, 2, 2) \u279e False\n\n    any_int(3, -2, 1) \u279e True\n    \n    any_int(3.6, -2.2, 2) \u279e False\n  \n\n    \n    '''\n    # Check if all numbers are effectively integers (e.g., 3.0 is an integer, 3.6 is not)\n    are_all_integers = (x == int(x)) and (y == int(y)) and (z == int(z))\n\n    if not are_all_integers:\n        return False\n\n    # Check if one number is the sum of the other two\n    sum_condition = (x == y + z) or (y == x + z) or (z == x + y)\n\n    return sum_condition"}
{"task_id": "HumanEval/93", "solution": "def encode(message):\n    \"\"\"\n    Encodes a message by swapping case of all letters and replacing vowels\n    with the letter that appears 2 places ahead in the alphabet,\n    then swapping the case of the replaced vowel.\n    \"\"\"\n    result_chars = []\n    vowels = \"aeiouAEIOU\"\n\n    for char in message:\n        if char.isalpha():\n            if char in vowels:\n                # For vowels, first find the letter 2 places ahead (preserving original case).\n                replaced_char_original_case = chr(ord(char) + 2)\n                # Then, swap the case of this new character.\n                final_char = replaced_char_original_case.swapcase()\n            else:\n                # For consonants, just swap the case.\n                final_char = char.swapcase()\n        else:\n            # Non-alphabetic characters are kept as is.\n            final_char = char\n        result_chars.append(final_char)\n\n    return \"\".join(result_chars)"}
{"task_id": "HumanEval/94", "solution": "def skjkasdkd(lst):\n    \"\"\"You are given a list of integers.\n    You need to find the largest prime value and return the sum of its digits.\n    \"\"\"\n\n    def is_prime(n):\n        \"\"\"Checks if a number is prime.\"\"\"\n        if n < 2:\n            return False\n        if n == 2:\n            return True\n        if n % 2 == 0:\n            return False\n        i = 3\n        while i * i <= n:\n            if n % i == 0:\n                return False\n            i += 2\n        return True\n\n    def sum_of_digits(n):\n        \"\"\"Calculates the sum of the digits of a number.\"\"\"\n        digit_sum = 0\n        while n > 0:\n            digit_sum += n % 10\n            n //= 10\n        return digit_sum\n\n    largest_prime = 0\n\n    for num in lst:\n        if is_prime(num):\n            if num > largest_prime:\n                largest_prime = num\n\n    if largest_prime > 0:\n        return sum_of_digits(largest_prime)\n    else:\n        return 0"}
{"task_id": "HumanEval/93", "solution": "def encode(message):\n    \"\"\"\n    Encodes a message by swapping case of letters and replacing vowels.\n    Vowels are replaced by the letter 2 places ahead in the alphabet,\n    after their case has been swapped. Non-letters are unchanged.\n    \"\"\"\n    vowels_lower = {'a', 'e', 'i', 'o', 'u'}\n    encoded_chars = []\n\n    for char in message:\n        if not char.isalpha():\n            encoded_chars.append(char)\n        else:\n            is_original_vowel = char.lower() in vowels_lower\n            \n            swapped_char = char.swapcase()\n\n            if is_original_vowel:\n                # Replace the case-swapped vowel with the letter 2 places ahead\n                replaced_char = chr(ord(swapped_char) + 2)\n                encoded_chars.append(replaced_char)\n            else:\n                # Consonants only have their case swapped\n                encoded_chars.append(swapped_char)\n\n    return \"\".join(encoded_chars)"}
{"task_id": "HumanEval/94", "solution": "def skjkasdkd(lst):\n    \"\"\"You are given a list of integers.\n    You need to find the largest prime value and return the sum of its digits.\n    \"\"\"\n\n    def is_prime(n: int) -> bool:\n        \"\"\"Return True if n is a prime number > 1.\"\"\"\n        if n <= 1:\n            return False\n        if n <= 3:\n            return True\n        if n % 2 == 0 or n % 3 == 0:\n            return False\n        i = 5\n        while i * i <= n:\n            if n % i == 0 or n % (i + 2) == 0:\n                return False\n            i += 6\n        return True\n\n    def sum_of_digits(n: int) -> int:\n        \"\"\"Return the sum of decimal digits of n.\"\"\"\n        return sum(int(d) for d in str(abs(n)))\n\n    largest_prime_val = None\n\n    for num in lst:\n        if is_prime(num):\n            if largest_prime_val is None or num > largest_prime_val:\n                largest_prime_val = num\n\n    if largest_prime_val is None:\n        return 0\n    else:\n        return sum_of_digits(largest_prime_val)"}
{"task_id": "HumanEval/95", "solution": "def check_dict_case(dict):\n    \"\"\"\n    Given a dictionary, return True if all keys are strings in lower \n    case or all keys are strings in upper case, else return False.\n    \"\"\"\n    if not dict:\n        return False\n\n    # Determine the expected case from the first string key encountered.\n    # first_key_is_lower will be True if expecting all lower, False if expecting all upper.\n    first_key_is_lower = None \n\n    for key in dict.keys():\n        if not isinstance(key, str):\n            return False\n\n        if first_key_is_lower is None: # This is the first string key\n            if key.islower():\n                first_key_is_lower = True\n            elif key.isupper():\n                first_key_is_lower = False\n            else:\n                # The first key is neither fully lower nor fully upper (e.g., \"Name\", \"123\").\n                # This violates the condition, so return False immediately.\n                return False\n        else: # Subsequent string keys must match the established case\n            if first_key_is_lower: # Expecting all lower case\n                if not key.islower():\n                    return False\n            else: # Expecting all upper case\n                if not key.isupper():\n                    return False\n                    \n    return True"}
{"task_id": "HumanEval/95", "solution": "def check_dict_case(dict):\n    \"\"\"\n    Given a dictionary, return True if all keys are strings in lower case or all keys are strings in upper case.\n    Returns False if the dictionary is empty or contains non-string keys or mixed-case keys.\n    \"\"\"\n    if not dict:\n        return False\n\n    all_keys_are_lower = True\n    all_keys_are_upper = True\n\n    for key in dict.keys():\n        if not isinstance(key, str):\n            return False\n\n        if not key.islower():\n            all_keys_are_lower = False\n        \n        if not key.isupper():\n            all_keys_are_upper = False\n            \n        # Optimization: if both possibilities are already ruled out, no need to check further keys\n        if not all_keys_are_lower and not all_keys_are_upper:\n            return False\n\n    return all_keys_are_lower or all_keys_are_upper"}
{"task_id": "HumanEval/96", "solution": "def count_up_to(n):\n    \"\"\"Implement a function that takes a non-negative integer and returns an array of the first n\n    integers that are prime numbers and less than n.\n    for example:\n    count_up_to(5) => [2,3]\n    count_up_to(11) => [2,3,5,7]\n    count_up_to(0) => []\n    count_up_to(20) => [2,3,5,7,11,13,17,19]\n    count_up_to(1) => []\n    count_up_to(18) => [2,3,5,7,11,13,17]\n    \"\"\"\n    def _is_prime(num):\n        \"\"\"Check if a number is prime using trial division.\"\"\"\n        if num < 2:\n            return False\n        if num == 2:\n            return True\n        if num % 2 == 0:\n            return False\n        limit = int(num ** 0.5) + 1\n        for divisor in range(3, limit, 2):\n            if num % divisor == 0:\n                return False\n        return True\n\n    if n <= 1:\n        return []\n\n    primes = []\n    for candidate in range(2, n):\n        if _is_prime(candidate):\n            primes.append(candidate)\n    return primes"}
{"task_id": "HumanEval/97", "solution": "def multiply(a, b):\n    \"\"\"Complete the function that takes two integers and returns \n    the product of their unit digits.\n    Assume the input is always valid.\n    Examples:\n    multiply(148, 412) should return 16.\n    multiply(19, 28) should return 72.\n    multiply(2020, 1851) should return 0.\n    multiply(14,-15) should return 20.\n    \"\"\"\n    class Number:\n        \"\"\"Holds an integer value and provides its unit digit.\"\"\"\n        def __init__(self, value: int):\n            self.value = value\n\n        def getUnitDigit(self) -> int:\n            \"\"\"Returns the absolute unit digit of the stored number.\"\"\"\n            return abs(self.value) % 10\n\n    class MultiplyOperation:\n        \"\"\"Performs the multiplication of unit digits.\"\"\"\n        def multiply(self, num1: Number, num2: Number) -> int:\n            \"\"\"Calculates the product of the unit digits of two Number objects.\"\"\"\n            unit_digit_a = num1.getUnitDigit()\n            unit_digit_b = num2.getUnitDigit()\n            return unit_digit_a * unit_digit_b\n\n    number_a = Number(a)\n    number_b = Number(b)\n    operation = MultiplyOperation()\n    return operation.multiply(number_a, number_b)"}
{"task_id": "HumanEval/96", "solution": "def count_up_to(n):\n    \"\"\"Implement a function that takes a non-negative integer and returns an array of the first n\n    integers that are prime numbers and less than n.\n    \"\"\"\n    if n <= 2:\n        return []\n\n    # Initialize a boolean array 'is_prime' up to n, marking all numbers as potentially prime.\n    is_prime = [True] * n\n    is_prime[0] = is_prime[1] = False # 0 and 1 are not prime numbers.\n\n    # Apply the Sieve of Eratosthenes to find primes less than n.\n    # Iterate from p = 2 up to the square root of n.\n    for p in range(2, int(n**0.5) + 1):\n        if is_prime[p]:\n            # Mark all multiples of p (starting from p*p) as not prime.\n            for multiple in range(p * p, n, p):\n                is_prime[multiple] = False\n\n    # Collect all numbers that are marked as prime into a list.\n    primes = []\n    for i in range(2, n):\n        if is_prime[i]:\n            primes.append(i)\n\n    return primes"}
{"task_id": "HumanEval/97", "solution": "def multiply(a, b):\n    \"\"\"Complete the function that takes two integers and returns \n    the product of their unit digits.\n    Assume the input is always valid.\n    Examples:\n    multiply(148, 412) should return 16.\n    multiply(19, 28) should return 72.\n    multiply(2020, 1851) should return 0.\n    multiply(14,-15) should return 20.\n    \"\"\"\n    unit_a = abs(a) % 10\n    unit_b = abs(b) % 10\n    return unit_a * unit_b"}
