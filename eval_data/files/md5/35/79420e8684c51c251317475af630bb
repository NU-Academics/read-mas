{"task_id": "HumanEval/38", "solution": "def decode_cyclic(s: str):\n    \"\"\"\n    takes as input string encoded with encode_cyclic function. Returns decoded string.\n    \"\"\"\n    # split string to groups. Each of length 3.\n    groups = [s[(3 * i):min((3 * i + 3), len(s))] for i in range((len(s) + 2) // 3)]\n    # cycle elements in each group back (rotate right). Unless group has fewer elements than 3.\n    groups = [(group[-1] + group[:-1]) if len(group) == 3 else group for group in groups]\n    return \"\".join(groups)"}
{"task_id": "HumanEval/37", "solution": "def sort_even(l: list):\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the odd indicies, while its values at the even indicies are equal\n    to the values of the even indicies of l, but sorted.\n    >>> sort_even([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_even([5, 6, 3, 4])\n    [3, 6, 5, 4]\n    \"\"\"\n    even_elements = []\n    # Collect all elements from even indices.\n    for i in range(0, len(l), 2):\n        even_elements.append(l[i])\n    \n    # Sort the collected even-indexed elements.\n    even_elements.sort()\n    \n    result = l[:] # Create a shallow copy of the list.\n    even_idx_counter = 0\n    # Replace elements at even indices with sorted values.\n    for i in range(0, len(l), 2):\n        result[i] = even_elements[even_idx_counter]\n        even_idx_counter += 1\n        \n    return result"}
{"task_id": "HumanEval/37", "solution": "def sort_even(l: list):\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the odd indicies, while its values at the even indicies are equal\n    to the values of the even indicies of l, but sorted.\n    \"\"\"\n    if not l:\n        return []\n\n    # Extract elements at even indices\n    even_values = []\n    for i in range(0, len(l), 2):\n        even_values.append(l[i])\n\n    # Sort the extracted even values\n    even_values.sort()\n\n    # Create a new list to store the result, initially a copy of l\n    result_list = list(l)\n\n    # Reinsert the sorted even values back into the result list at their original even indices\n    sorted_idx = 0\n    for i in range(0, len(l), 2):\n        result_list[i] = even_values[sorted_idx]\n        sorted_idx += 1\n\n    return result_list"}
{"task_id": "HumanEval/38", "solution": "def decode_cyclic(s: str):\n    \"\"\"\n    takes as input string encoded with encode_cyclic function. Returns decoded string.\n    \"\"\"\n    # split string to groups. Each of length 3.\n    groups = [s[(3 * i):min((3 * i + 3), len(s))] for i in range((len(s) + 2) // 3)]\n    # reverse cycle elements in each group. Unless group has fewer elements than 3.\n    groups = [(group[-1] + group[:-1]) if len(group) == 3 else group for group in groups]\n    return \"\".join(groups)"}
{"task_id": "HumanEval/39", "solution": "import math\n\nclass FibonacciGenerator:\n    def __init__(self):\n        self.prev = 0\n        self.curr = 1\n\n    def next(self) -> int:\n        next_val = self.prev + self.curr\n        self.prev, self.curr = self.curr, next_val\n        return next_val\n\n    def get(self, index: int) -> int:\n        if index < 0:\n            raise ValueError(\"Index must be non\u2011negative.\")\n        a, b = 0, 1\n        for _ in range(index):\n            a, b = b, a + b\n        return a\n\nclass PrimeChecker:\n    def is_prime(self, number: int) -> bool:\n        if number <= 1:\n            return False\n        if number <= 3:\n            return True\n        if number % 2 == 0 or number % 3 == 0:\n            return False\n        i = 5\n        while i * i <= number:\n            if number % i == 0 or number % (i + 2) == 0:\n                return False\n            i += 6\n        return True\n\nclass PrimeFibonacciCalculator:\n    def __init__(self):\n        self.fib_gen = FibonacciGenerator()\n        self.prime_checker = PrimeChecker()\n\n    def prime_fib(self, n: int) -> int:\n        count = 0\n        while True:\n            fib_value = self.fib_gen.next()\n            if self.prime_checker.is_prime(fib_value):\n                count += 1\n                if count == n:\n                    return fib_value\n\ndef prime_fib(n: int):\n    \"\"\"\n    prime_fib returns n-th number that is a Fibonacci number and it's also prime.\n    >>> prime_fib(1)\n    2\n    >>> prime_fib(2)\n    3\n    >>> prime_fib(3)\n    5\n    >>> prime_fib(4)\n    13\n    >>> prime_fib(5)\n    89\n    \"\"\"\n    if not isinstance(n, int) or n < 1:\n        raise ValueError(\"Input must be a positive integer.\")\n    calculator = PrimeFibonacciCalculator()\n    return calculator.prime_fib(n)"}
{"task_id": "HumanEval/39", "solution": "def prime_fib(n: int):\n    \"\"\"\n    prime_fib returns n-th number that is a Fibonacci number and it's also prime.\n    >>> prime_fib(1)\n    2\n    >>> prime_fib(2)\n    3\n    >>> prime_fib(3)\n    5\n    >>> prime_fib(4)\n    13\n    >>> prime_fib(5)\n    89\n    \"\"\"\n\n    def is_prime(num):\n        # Checks if a number is prime using an optimized trial division.\n        if num <= 1:\n            return False\n        if num <= 3:\n            return True\n        if num % 2 == 0 or num % 3 == 0:\n            return False\n        i = 5\n        while i * i <= num:\n            if num % i == 0 or num % (i + 2) == 0:\n                return False\n            i += 6\n        return True\n\n    count = 0\n    a, b = 0, 1 # Initialize Fibonacci sequence with F(0)=0, F(1)=1.\n\n    # Iterate through Fibonacci numbers until the n-th prime is found.\n    while True:\n        next_fib = a + b\n        a = b\n        b = next_fib\n        \n        if is_prime(next_fib):\n            count += 1\n            if count == n:\n                return next_fib"}
{"task_id": "HumanEval/40", "solution": "def triples_sum_to_zero(l: list):\n    \"\"\"\n    triples_sum_to_zero takes a list of integers as an input.\n    it returns True if there are three distinct elements in the list that\n    sum to zero, and False otherwise.\n    \"\"\"\n    n = len(l)\n    if n < 3:\n        return False\n\n    l.sort()  # Sort the list to use the two-pointer technique.\n\n    for i in range(n - 2):\n        # Skip duplicate elements for the first number to avoid redundant calculations.\n        if i > 0 and l[i] == l[i-1]:\n            continue\n\n        target = -l[i]\n        left, right = i + 1, n - 1\n\n        while left < right:\n            current_sum = l[left] + l[right]\n            if current_sum == target:\n                return True\n            elif current_sum < target:\n                left += 1\n            else:\n                right -= 1\n    return False"}
