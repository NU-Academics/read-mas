{"task_id": "HumanEval/59", "solution": "def largest_prime_factor(n: int) -> int:\n    \"\"\"Return the largest prime factor of n. Assume n > 1 and is not a prime.\"\"\"\n    largest_prime = 1\n\n    # Divide by 2 until n is odd\n    while n % 2 == 0:\n        largest_prime = 2\n        n //= 2\n\n    # Now n must be odd. Iterate for odd factors from 3 up to sqrt(n)\n    i = 3\n    while i * i <= n:\n        while n % i == 0:\n            largest_prime = i\n            n //= i\n        i += 2  # Increment by 2 to check only odd numbers\n\n    # If n is still greater than 1 after all divisions,\n    # the remaining n must be a prime number itself, and it is the largest prime factor.\n    if n > 1:\n        largest_prime = n\n\n    return largest_prime"}
{"task_id": "HumanEval/59", "solution": "class PrimeFactor:\n    \"\"\"Represents a prime factor with an integer value.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\nclass Number:\n    \"\"\"Encapsulates operations on a number, like primality test and finding largest prime factor.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def isPrime(self) -> bool:\n        \"\"\"Checks if the number is prime.\"\"\"\n        if self.value <= 1:\n            return False\n        i = 2\n        while i * i <= self.value:\n            if self.value % i == 0:\n                return False\n            i += 1\n        return True\n\n    def largestPrimeFactor(self) -> int:\n        \"\"\"Finds the largest prime factor of the number.\"\"\"\n        n = self.value\n        largest_factor = 1\n\n        while n % 2 == 0:\n            largest_factor = 2\n            n //= 2\n\n        i = 3\n        while i * i <= n:\n            while n % i == 0:\n                largest_factor = i\n                n //= i\n            i += 2\n\n        if n > 1:\n            largest_factor = n\n        return largest_factor\n\n\ndef largest_prime_factor(n: int):\n    \"\"\"Return the largest prime factor of n. Assume n > 1 and is not a prime.\"\"\"\n    number_obj = Number(n)\n    return number_obj.largestPrimeFactor()"}
{"task_id": "HumanEval/60", "solution": "from dataclasses import dataclass\n\n@dataclass\nclass InputNumber:\n    \"\"\"Represents the input value for the sum calculation.\"\"\"\n    value: int\n\n@dataclass\nclass SumResult:\n    \"\"\"Represents the calculated sum result.\"\"\"\n    value: int\n\nclass SumCalculator:\n    \"\"\"Performs the calculation to sum numbers from 1 to n.\"\"\"\n    def calculate(self, input_num: InputNumber) -> SumResult:\n        \"\"\"Applies the arithmetic series formula n*(n+1)/2 to compute the sum.\"\"\"\n        n = input_num.value\n        sum_val = n * (n + 1) // 2\n        return SumResult(sum_val)\n\ndef sum_to_n(n: int):\n    \"\"\"sum_to_n is a function that sums numbers from 1 to n.\n    >>> sum_to_n(30)\n    465\n    >>> sum_to_n(100)\n    5050\n    >>> sum_to_n(5)\n    15\n    >>> sum_to_n(10)\n    55\n    >>> sum_to_n(1)\n    1\n    \"\"\"\n    # Orchestrates domain objects to compute the sum.\n    # Input validation and error handling (e.g., n < 1) are omitted per specific completion instructions.\n    input_number_obj = InputNumber(n)\n    calculator = SumCalculator()\n    sum_result_obj = calculator.calculate(input_number_obj)\n    return sum_result_obj.value"}
{"task_id": "HumanEval/61", "solution": "def correct_bracketing(brackets: str):\n    \"\"\"Checks if every opening bracket has a corresponding closing bracket.\n    It uses a counter, incrementing for '(' and decrementing for ')'.\n    \"\"\"\n    balance = 0\n    for char in brackets:\n        if char == '(':\n            balance += 1\n        elif char == ')':\n            balance -= 1\n        if balance < 0:\n            return False\n    return balance == 0"}
{"task_id": "HumanEval/61", "solution": "def correct_bracketing(brackets: str):\n    \"\"\" brackets is a string of \"(\" and \")\".\n    return True if every opening bracket has a corresponding closing bracket.\n    \"\"\"\n    balance = 0\n    for char in brackets:\n        if char == '(':\n            balance += 1\n        elif char == ')':\n            balance -= 1\n        \n        # If balance ever drops below zero, a closing bracket appeared without a corresponding opening one.\n        if balance < 0:\n            return False\n            \n    # After iterating through all characters, if balance is 0, all brackets are correctly matched.\n    return balance == 0"}
{"task_id": "HumanEval/62", "solution": "from __future__ import annotations\nfrom typing import List, Union\n\ndef derivative(xs: List[Union[int, float]]) -> List[Union[int, float]]:\n    \"\"\" xs represent coefficients of a polynomial.\n    xs[0] + xs[1] * x + xs[2] * x^2 + ....\n     Return derivative of this polynomial in the same form.\n    >>> derivative([3, 1, 2, 4, 5])\n    [1, 4, 12, 20]\n    >>> derivative([1, 2, 3])\n    [2, 6]\n    \"\"\"\n    class Polynomial:\n        \"\"\"Represents a polynomial with its coefficients and degree.\"\"\"\n        def __init__(self, coefficients: List[Union[int, float]]):\n            self.coefficients: List[Union[int, float]] = coefficients\n            self.degree: int = len(coefficients) - 1\n\n    class DerivativeCalculator:\n        \"\"\"A domain service to compute the derivative of a polynomial.\"\"\"\n        def compute(self, poly: Polynomial) -> List[Union[int, float]]:\n            # For a polynomial c0 + c1*x + c2*x^2 + ... + cn*x^n\n            # its derivative is c1 + 2*c2*x + ... + n*cn*x^(n-1).\n            derivative_coeffs: List[Union[int, float]] = []\n            # Iterate from the coefficient of x^1 (index 1) up to the last coefficient.\n            for i in range(1, len(poly.coefficients)):\n                derivative_coeffs.append(poly.coefficients[i] * i)\n            return derivative_coeffs\n\n    # Validate input 'xs' as per design: must be a list of numbers.\n    if not isinstance(xs, list):\n        raise TypeError(\"Input 'xs' must be a list.\")\n    for i, x in enumerate(xs):\n        if not isinstance(x, (int, float)):\n            raise TypeError(f\"Coefficient at index {i} must be a number (int or float), got {type(x).__name__}.\")\n\n    # If the polynomial is constant or empty, its derivative is an empty list of coefficients.\n    if not xs or len(xs) == 1:\n        return []\n\n    # Application layer: orchestrate domain objects.\n    polynomial_entity = Polynomial(xs)\n    calculator_service = DerivativeCalculator()\n    result_coefficients = calculator_service.compute(polynomial_entity)\n\n    return result_coefficients"}
{"task_id": "HumanEval/62", "solution": "def derivative(xs: list):\n    \"\"\" xs represent coefficients of a polynomial.\n    xs[0] + xs[1] * x + xs[2] * x^2 + ....\n     Return derivative of this polynomial in the same form.\n    >>> derivative([3, 1, 2, 4, 5])\n    [1, 4, 12, 20]\n    >>> derivative([1, 2, 3])\n    [2, 6]\n    \"\"\"\n    if not xs or len(xs) == 1:\n        return []\n\n    # The derivative of c*x^k is c*k*x^(k-1).\n    # The i-th coefficient in the input (xs[i]) corresponds to x^i.\n    # Its derivative contributes to the (i-1)-th coefficient in the result.\n    return [xs[i] * i for i in range(1, len(xs))]"}
{"task_id": "HumanEval/63", "solution": "def fibfib(n: int):\n    \"\"\"The FibFib number sequence is a sequence similar to the Fibbonacci sequnece that's defined as follows:\n    fibfib(0) == 0\n    fibfib(1) == 0\n    fibfib(2) == 1\n    fibfib(n) == fibfib(n-1) + fibfib(n-2) + fibfib(n-3).\n    Please write a function to efficiently compute the n-th element of the fibfib number sequence.\n    >>> fibfib(1)\n    0\n    >>> fibfib(5)\n    4\n    >>> fibfib(8)\n    24\n    \"\"\"\n    if n == 0:\n        return 0\n    if n == 1:\n        return 0\n    if n == 2:\n        return 1\n\n    # Iteratively compute and store FibFib numbers to avoid re-computation.\n    fib_sequence = [0, 0, 1]\n    for i in range(3, n + 1):\n        fib_sequence.append(fib_sequence[i-1] + fib_sequence[i-2] + fib_sequence[i-3])\n\n    return fib_sequence[n]"}
{"task_id": "HumanEval/63", "solution": "def fibfib(n: int):\n    \"\"\"Computes the n-th element of the FibFib number sequence efficiently.\"\"\"\n    if n == 0 or n == 1:\n        return 0\n    if n == 2:\n        return 1\n\n    # Initialize with fibfib(0), fibfib(1), fibfib(2)\n    a, b, c = 0, 0, 1\n\n    # Calculate fibfib(i) for i from 3 up to n\n    for _ in range(3, n + 1):\n        next_fibfib = a + b + c\n        a = b\n        b = c\n        c = next_fibfib\n    return c"}
{"task_id": "HumanEval/64", "solution": "def vowels_count(s):\n    \"\"\"Counts the number of vowels in a string, including 'y' if it's the last character.\"\"\"\n    vowel_count = 0\n    vowels = {'a', 'e', 'i', 'o', 'u'}\n    s_lower = s.lower()\n\n    for i, char in enumerate(s_lower):\n        if char in vowels:\n            vowel_count += 1\n        elif char == 'y' and i == len(s_lower) - 1:\n            vowel_count += 1\n            \n    return vowel_count"}
