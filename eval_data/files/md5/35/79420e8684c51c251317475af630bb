{"task_id": "HumanEval/23", "solution": "def strlen(string: str) -> int:\n    \"\"\" Return length of given string.\"\"\"\n\n    class String:\n        \"\"\"Represents a string for length calculation.\"\"\"\n        def __init__(self, value: str):\n            self.value = value\n\n        def length(self) -> int:\n            \"\"\"Calculates the length of the string.\"\"\"\n            return len(self.value)\n\n    class StringService:\n        \"\"\"Provides services related to strings.\"\"\"\n        def getLength(self, input_string: str) -> int:\n            \"\"\"Returns the length of the given string using the String class.\"\"\"\n            s = String(input_string)\n            return s.length()\n\n    service = StringService()\n    return service.getLength(string)"}
{"task_id": "HumanEval/24", "solution": "import math\n\ndef largest_divisor(n: int) -> int:\n    \"\"\" For a given number n, find the largest number that divides n evenly, smaller than n\n    \"\"\"\n    limit = int(math.sqrt(n))\n    \n    for i in range(limit, 0, -1):\n        if n % i == 0:\n            if i == 1:\n                return 1\n            else:\n                return n // i"}
{"task_id": "HumanEval/24", "solution": "import math\n\ndef largest_divisor(n: int) -> int:\n    \"\"\" For a given number n, find the largest number that divides n evenly, smaller than n\n    \"\"\"\n    # Iterate from 2 up to the square root of n to find the smallest factor 'i'.\n    # If such a factor 'i' is found, then 'n // i' is the largest divisor of 'n' that is smaller than 'n'.\n    for i in range(2, int(math.sqrt(n)) + 1):\n        if n % i == 0:\n            return n // i\n    \n    # If the loop completes without finding any factors, 'n' must be a prime number.\n    # For a prime number, the largest divisor smaller than 'n' is 1.\n    return 1"}
{"task_id": "HumanEval/25", "solution": "def factorize(n: int) -> List[int]:\n    \"\"\" Return list of prime factors of given integer in the order from smallest to largest.\n    Each of the factors should be listed number of times corresponding to how many times it appeares in factorization.\n    Input number should be equal to the product of all factors\n    >>> factorize(8)\n    [2, 2, 2]\n    >>> factorize(25)\n    [5, 5]\n    >>> factorize(70)\n    [2, 5, 7]\n    \"\"\"\n    if n == 1:\n        return []\n\n    factors: List[int] = []\n    divisor = 2\n    while divisor * divisor <= n:\n        while n % divisor == 0:\n            factors.append(divisor)\n            n //= divisor\n        divisor += 1\n    if n > 1:\n        factors.append(n)\n    return factors"}
{"task_id": "HumanEval/25", "solution": "def factorize(n: int) -> List[int]:\n    \"\"\" Return list of prime factors of given integer in the order from smallest to largest.\n    Each of the factors should be listed number of times corresponding to how many times it appeares in factorization.\n    \"\"\"\n    factors = []\n    d = 2\n    temp_n = n\n\n    while d * d <= temp_n:\n        while temp_n % d == 0:\n            factors.append(d)\n            temp_n //= d\n        d += 1\n\n    if temp_n > 1:\n        factors.append(temp_n)\n        \n    return factors"}
