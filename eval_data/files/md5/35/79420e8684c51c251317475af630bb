{"task_id": "HumanEval/75", "solution": "def is_multiply_prime(a):\n    \"\"\"Returns true if the given number is the multiplication of 3 prime numbers\n    and false otherwise.\n    \"\"\"\n    if a < 2:\n        return False\n\n    prime_factors = []\n    temp_a = a\n    d = 2\n    while d * d <= temp_a:\n        while temp_a % d == 0:\n            prime_factors.append(d)\n            temp_a //= d\n        d += 1\n    if temp_a > 1:\n        prime_factors.append(temp_a)\n\n    return len(prime_factors) == 3"}
{"task_id": "HumanEval/75", "solution": "def is_multiply_prime(a):\n    \"\"\"Returns true if the number is the multiplication of 3 prime numbers, false otherwise.\n    The input 'a' is guaranteed to be less than 100.\n    \"\"\"\n    factors = []\n    n = a\n    divisor = 2\n    while n > 1:\n        while n % divisor == 0:\n            factors.append(divisor)\n            n //= divisor\n        divisor += 1\n    return len(factors) == 3"}
{"task_id": "HumanEval/76", "solution": "def is_simple_power(x, n):\n    \"\"\"Checks if x is a simple power of n (n**k = x for some integer k >= 0).\"\"\"\n    if n <= 1:\n        return False\n\n    if x <= 0:\n        return False\n\n    current_power = 1\n    while current_power < x:\n        current_power *= n\n\n    return current_power == x"}
{"task_id": "HumanEval/76", "solution": "def is_simple_power(x, n):\n    \"\"\"Your task is to write a function that returns true if a number x is a simple\n    power of n and false in other cases.\n    x is a simple power of n if n**int=x\n    For example:\n    is_simple_power(1, 4) => true\n    is_simple_power(2, 2) => true\n    is_simple_power(8, 2) => true\n    is_simple_power(3, 2) => false\n    is_simple_power(3, 1) => false\n    is_simple_power(5, 3) => false\n    \"\"\"\n    # According to the design context, negative or zero inputs for x or n result in False.\n    if x <= 0 or n <= 0:\n        return False\n\n    # If n is 1, x must also be 1 for it to be a simple power (1^k = 1).\n    if n == 1:\n        return x == 1\n\n    # Check powers of n, starting from n^0 = 1.\n    power = 1\n    while power <= x:\n        if power == x:\n            return True\n        # To prevent potential infinite loops or overflow with very large numbers,\n        # ensure that power doesn't exceed x before multiplying by n.\n        # If x / n is less than power, then power * n would definitely be greater than x.\n        if power > x / n:\n            return False\n        power *= n\n\n    # If the loop completes without finding x as a power, it's not a simple power.\n    return False"}
{"task_id": "HumanEval/77", "solution": "def iscube(a):\n    '''\n    Checks if an integer `a` is a perfect cube.\n    Handles positive, negative, and zero inputs.\n    '''\n    if a == 0:\n        return True\n    \n    # Calculate the integer cube root of the absolute value of 'a'.\n    root = round(abs(a) ** (1/3))\n    \n    # Check if `root` cubed equals `abs(a)`, and if the signed `root` cubed equals `a`.\n    return root ** 3 == abs(a) and (root if a > 0 else -root) ** 3 == a"}
{"task_id": "HumanEval/77", "solution": "def iscube(a):\n    '''\n    Checks if an integer `a` is a cube of some integer number using binary search for the cube root.\n    This implementation uses only integer arithmetic to avoid floating-point precision issues.\n    '''\n    if a == 0:\n        return True\n\n    # Use absolute value for finding the cube root, then verify.\n    x = abs(a)\n\n    low = 0\n    high = x # The cube root k satisfies 0 <= k <= x for x >= 0.\n\n    while low <= high:\n        mid = (low + high) // 2\n        # Use Python's arbitrary precision integers for mid_cubed\n        mid_cubed = mid * mid * mid\n\n        if mid_cubed == x:\n            return True\n        elif mid_cubed < x:\n            low = mid + 1\n        else: # mid_cubed > x\n            high = mid - 1\n    \n    return False"}
