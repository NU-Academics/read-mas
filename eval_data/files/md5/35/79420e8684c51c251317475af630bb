{"task_id": "HumanEval/65", "solution": "def circular_shift(x, shift):\n    \"\"\"Circular shift the digits of the integer x, shift the digits right by shift\n    and return the result as a string.\n    If shift > number of digits, return digits reversed.\n    \"\"\"\n    if x == 0:\n        return \"0\"\n\n    sign = \"-\" if x < 0 else \"\"\n    abs_x_str = str(abs(x))\n    num_digits = len(abs_x_str)\n\n    if shift > num_digits:\n        shifted_digits = abs_x_str[::-1]\n    else:\n        # Perform a right circular shift by 'shift' positions\n        split_point = num_digits - shift\n        shifted_digits = abs_x_str[split_point:] + abs_x_str[:split_point]\n\n    return sign + shifted_digits"}
{"task_id": "HumanEval/65", "solution": "def circular_shift(x, shift):\n    \"\"\"Circular shift the digits of the integer x, shift the digits right by shift\n    and return the result as a string.\n    If shift > number of digits, return digits reversed.\n    \"\"\"\n    s_x = str(x)\n    n = len(s_x)\n\n    if n == 0:\n        return \"\"\n\n    if shift > n:\n        return s_x[::-1]\n    else:\n        # Calculate the effective shift amount (0 to n-1)\n        actual_shift = shift % n\n        # Perform the circular right shift\n        return s_x[n - actual_shift:] + s_x[:n - actual_shift]"}
{"task_id": "HumanEval/66", "solution": "def digitSum(s):\n    \"\"\"Task\n    Write a function that takes a string as input and returns the sum of the upper characters only'\n    ASCII codes.\n\n    Examples:\n        digitSum(\"\") => 0\n        digitSum(\"abAB\") => 131\n        digitSum(\"abcCd\") => 67\n        digitSum(\"helloE\") => 69\n        digitSum(\"woArBld\") => 131\n        digitSum(\"aAaaaXa\") => 153\n    \"\"\"\n    total = 0\n    for ch in s:\n        ascii_val = ord(ch)\n        if 65 <= ascii_val <= 90:  # Uppercase A-Z ASCII range\n            total += ascii_val\n    return total"}
{"task_id": "HumanEval/66", "solution": "def digitSum(s):\n    \"\"\"Calculates the sum of ASCII codes for all uppercase characters in the input string.\"\"\"\n    total_sum = 0\n    for char in s:\n        if char.isupper():\n            total_sum += ord(char)\n    return total_sum"}
{"task_id": "HumanEval/67", "solution": "def fruit_distribution(s,n):\n    \"\"\"\n    Calculates the number of mango fruits given a string describing apples and oranges\n    and the total number of fruits.\n    \"\"\"\n    parts = s.split(\" apples and \")\n    apples_str = parts[0]\n    \n    oranges_part = parts[1].split(\" oranges\")[0]\n    oranges_str = oranges_part\n\n    apples = int(apples_str)\n    oranges = int(oranges_str)\n    \n    mangoes = n - apples - oranges\n    return mangoes"}
{"task_id": "HumanEval/67", "solution": "import re\n\ndef fruit_distribution(s,n):\n    \"\"\"\n    In this task, you will be given a string that represents a number of apples and oranges \n    that are distributed in a basket of fruit this basket contains \n    apples, oranges, and mango fruits. Given the string that represents the total number of \n    the oranges and apples and an integer that represent the total number of the fruits \n    in the basket return the number of the mango fruits in the basket.\n    for examble:\n    fruit_distribution(\"5 apples and 6 oranges\", 19) ->19 - 5 - 6 = 8\n    fruit_distribution(\"0 apples and 1 oranges\",3) -> 3 - 0 - 1 = 2\n    fruit_distribution(\"2 apples and 3 oranges\", 100) -> 100 - 2 - 3 = 95\n    fruit_distribution(\"100 apples and 1 oranges\",120) -> 120 - 100 - 1 = 19\n    \"\"\"\n    # Extract apple and orange counts using a regular expression as specified in the design.\n    match = re.match(r\"(\\d+) apples and (\\d+) oranges\", s)\n\n    # Raise ValueError if the string format does not match the expectation.\n    if not match:\n        raise ValueError(\"Input string 's' does not match the expected format 'X apples and Y oranges'\")\n\n    apples = int(match.group(1))\n    oranges = int(match.group(2))\n\n    total_known_fruits = apples + oranges\n\n    # Raise ValueError if total fruits 'n' is less than the sum of apples and oranges.\n    if n < total_known_fruits:\n        raise ValueError(\"Total fruits 'n' cannot be less than the sum of apples and oranges\")\n\n    # Calculate the number of mangoes by subtracting known fruits from the total.\n    mangoes = n - total_known_fruits\n\n    return mangoes"}
{"task_id": "HumanEval/68", "solution": "def pluck(arr):\n    \"\"\"\n    Finds the smallest even value in the array and its first index.\n    Returns [value, index] or an empty list if no even values are found.\n    \"\"\"\n    smallest_even_value = float('inf')\n    smallest_even_index = -1\n\n    for index, value in enumerate(arr):\n        if value % 2 == 0:  # Check if the value is even\n            if value < smallest_even_value:\n                smallest_even_value = value\n                smallest_even_index = index\n\n    if smallest_even_index == -1:\n        return []\n    else:\n        return [smallest_even_value, smallest_even_index]"}
{"task_id": "HumanEval/68", "solution": "def pluck(arr):\n    \"\"\"\n    Finds the smallest even value and its first index in the array.\n    Returns [value, index] or an empty list if no even values exist or the array is empty.\n    \"\"\"\n    if not arr:\n        return []\n\n    min_even = None\n    min_index = -1\n\n    for i, value in enumerate(arr):\n        if value % 2 == 0:  # Check if the number is even\n            if min_even is None or value < min_even:\n                min_even = value\n                min_index = i\n\n    return [] if min_even is None else [min_even, min_index]"}
{"task_id": "HumanEval/69", "solution": "def search(lst):\n    \"\"\"\n    Given a non-empty list of positive integers, return the greatest integer that is greater than \n    zero, and has a frequency greater than or equal to the value of the integer itself. \n    \"\"\"\n    frequency_map = {}\n    for num in lst:\n        frequency_map[num] = frequency_map.get(num, 0) + 1\n\n    qualifying_integers = []\n    for num, freq in frequency_map.items():\n        if freq >= num:\n            qualifying_integers.append(num)\n\n    if not qualifying_integers:\n        return -1\n    \n    return max(qualifying_integers)"}
{"task_id": "HumanEval/69", "solution": "def search(lst):\n    '''\n    You are given a non-empty list of positive integers. Return the greatest integer that is greater than \n    zero, and has a frequency greater than or equal to the value of the integer itself. \n    The frequency of an integer is the number of times it appears in the list.\n    If no such a value exist, return -1.\n    '''\n    frequency_map = {}\n    for num in lst:\n        frequency_map[num] = frequency_map.get(num, 0) + 1\n\n    max_qualifying_integer = -1\n\n    for num, freq in frequency_map.items():\n        # Check if the number meets the criteria: frequency >= its value.\n        # Numbers in the input list are guaranteed to be positive, so num > 0 is always true here.\n        if freq >= num:\n            if num > max_qualifying_integer:\n                max_qualifying_integer = num\n\n    return max_qualifying_integer"}
{"task_id": "HumanEval/70", "solution": "def strange_sort_list(lst):\n    '''\n    Given list of integers, return list in strange order.\n    Strange sorting, is when you start with the minimum value,\n    then maximum of the remaining integers, then minimum and so on.\n    '''\n    if not lst:\n        return []\n\n    sorted_lst = sorted(lst)\n    left, right = 0, len(sorted_lst) - 1\n    result = []\n\n    while left <= right:\n        result.append(sorted_lst[left])\n        left += 1\n        if left <= right:  # Only append maximum if there are elements remaining\n            result.append(sorted_lst[right])\n            right -= 1\n\n    return result"}
{"task_id": "HumanEval/70", "solution": "def strange_sort_list(lst):\n    \"\"\"\n    Given list of integers, return list in strange order.\n    Strange sorting, is when you start with the minimum value,\n    then maximum of the remaining integers, then minimum and so on.\n    \"\"\"\n    if not lst:\n        return []\n\n    sorted_lst = sorted(lst)\n    result = []\n    low = 0\n    high = len(sorted_lst) - 1\n    \n    # 'turn' variable alternates between picking minimum (0) and maximum (1)\n    turn = 0 \n\n    while low <= high:\n        if turn == 0:  # Current turn is to pick the smallest remaining element\n            result.append(sorted_lst[low])\n            low += 1\n        else:  # Current turn is to pick the largest remaining element\n            result.append(sorted_lst[high])\n            high -= 1\n        turn = 1 - turn  # Toggle the turn for the next iteration\n\n    return result"}
{"task_id": "HumanEval/71", "solution": "def triangle_area(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle. Return the area of\n    the triangle rounded to 2 decimal points if the three sides form a valid triangle. \n    Otherwise return -1\n    Three sides make a valid triangle when the sum of any two sides is greater \n    than the third side.\n    Example:\n    triangle_area(3, 4, 5) == 6.00\n    triangle_area(1, 2, 10) == -1\n    '''\n    # Check if the sides form a valid triangle\n    if not (a > 0 and b > 0 and c > 0 and\n            a + b > c and a + c > b and b + c > a):\n        return -1\n    \n    # Calculate the semi-perimeter\n    s = (a + b + c) / 2\n    \n    # Calculate the area using Heron's formula\n    import math\n    area = math.sqrt(s * (s - a) * (s - b) * (s - c))\n    \n    # Round the area to 2 decimal places\n    return round(area, 2)"}
{"task_id": "HumanEval/71", "solution": "def triangle_area(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle. Return the area of\n    the triangle rounded to 2 decimal points if the three sides form a valid triangle. \n    Otherwise return -1\n    Three sides make a valid triangle when the sum of any two sides is greater \n    than the third side.\n    Example:\n    triangle_area(3, 4, 5) == 6.00\n    triangle_area(1, 2, 10) == -1\n    '''\n    # Check for valid triangle: all sides must be positive and satisfy triangle inequality\n    if a <= 0 or b <= 0 or c <= 0:\n        return -1\n    if not (a + b > c and a + c > b and b + c > a):\n        return -1\n\n    # Calculate semi-perimeter\n    s = (a + b + c) / 2\n\n    # Calculate area using Heron's formula\n    area_squared = s * (s - a) * (s - b) * (s - c)\n    \n    # Due to floating point precision, area_squared might be very slightly negative for degenerate triangles.\n    # Clamp it to zero before taking the square root.\n    if area_squared < 0:\n        area_squared = 0 \n        \n    area = area_squared ** 0.5\n\n    return round(area, 2)"}
{"task_id": "HumanEval/72", "solution": "def will_it_fly(q,w):\n    \"\"\"\n    Checks if object q will fly: it must be a palindromic list and its sum must not exceed weight w.\n    An empty list `q` will not fly, as inferred from design context.\n    \"\"\"\n    if not q: # An empty list cannot fly, as per design's test cases.\n        return False\n    \n    is_palindromic = (q == q[::-1])\n    sum_elements = sum(q)\n    \n    return is_palindromic and (sum_elements <= w)"}
{"task_id": "HumanEval/72", "solution": "def will_it_fly(q,w):\n    \"\"\"\n    Checks if an object q (list) will fly.\n    An object flies if it's a palindromic list and its sum is <= w.\n    \"\"\"\n    is_palindromic = (q == q[::-1])\n    sum_elements = sum(q)\n    is_weight_ok = (sum_elements <= w)\n    return is_palindromic and is_weight_ok"}
{"task_id": "HumanEval/73", "solution": "def smallest_change(arr):\n    \"\"\"\n    Given an array arr of integers, find the minimum number of elements that\n    need to be changed to make the array palindromic.\n    \"\"\"\n    n = len(arr)\n    changes = 0\n    # Iterate from the start to the middle of the array, comparing symmetric counterparts.\n    for i in range(n // 2):\n        if arr[i] != arr[n - 1 - i]:\n            changes += 1\n    return changes"}
