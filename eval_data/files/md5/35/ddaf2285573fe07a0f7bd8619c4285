{"task_id": "HumanEval/124", "solution": "def valid_date(date: str) -> bool:\n    \"\"\"Validates a date string against specific format and range rules.\n    Returns True if the date is valid, False otherwise.\n    \"\"\"\n    DAYS_IN_MONTH = {\n        1: 31, 3: 31, 5: 31, 7: 31, 8: 31, 10: 31, 12: 31,\n        4: 30, 6: 30, 9: 30, 11: 30,\n        2: 29\n    }\n\n    # FR1: Validate that the input date string is not empty.\n    if not date:\n        return False\n\n    # FR2: Validate that the date string adheres to the \"mm-dd-yyyy\" format.\n    parts = date.split('-')\n    if len(parts) != 3:\n        return False\n\n    # Further enforce 'mm-dd-yyyy' length format (e.g., '03', not '3')\n    if not (len(parts[0]) == 2 and len(parts[1]) == 2 and len(parts[2]) == 4):\n        return False\n\n    try:\n        month = int(parts[0])\n        day = int(parts[1])\n        year = int(parts[2])\n    except ValueError:\n        # Error in converting parts to integers (e.g., 'aa-bb-cccc').\n        return False\n\n    # FR3: Validate that the month component is between 1 and 12 (inclusive).\n    if not (1 <= month <= 12):\n        return False\n\n    # FR4: Validate the day component based on the month.\n    if not (1 <= day):\n        return False\n\n    max_days = DAYS_IN_MONTH.get(month)\n    if max_days is None:\n        # This case should not be reached if month is already validated.\n        return False\n\n    if not (day <= max_days):\n        return False\n\n    return True"}
{"task_id": "HumanEval/124", "solution": "import re\ndef valid_date(date: str) -> bool:\n    \"\"\"Validates a date string against format and logical rules.\n    Returns True if valid, False otherwise.\n    \"\"\"\n\n    # Constants derived from the design specification for date validation rules.\n    DAYS_IN_MONTH_31 = [1, 3, 5, 7, 8, 10, 12]\n    DAYS_IN_MONTH_30 = [4, 6, 9, 11]\n    MONTH_FEB = 2\n    MAX_DAY_FEB = 29\n    # Regex to match \"mm-dd-yyyy\" format, capturing month, day, and year.\n    DATE_FORMAT_REGEX = r\"^(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])-(\\d{4})$\"\n\n    # FR1: The system shall validate that the input date string is not empty.\n    if not date:\n        return False\n\n    # FR2: The system shall validate that the date string adheres to the \"mm-dd-yyyy\" format.\n    match = re.match(DATE_FORMAT_REGEX, date)\n    if not match:\n        return False\n\n    # Extract and convert components.\n    month = int(match.group(1))\n    day = int(match.group(2))\n    # year = int(match.group(3)) # The year is extracted but not used for validity per the rules.\n\n    # FR3: The system shall validate that the month component is between 1 and 12 (inclusive).\n    if not (1 <= month <= 12):\n        return False\n\n    # FR4: The system shall validate the day component based on the month's specific rules.\n    if month in DAYS_IN_MONTH_31:\n        if not (1 <= day <= 31):\n            return False\n    elif month in DAYS_IN_MONTH_30:\n        if not (1 <= day <= 30):\n            return False\n    elif month == MONTH_FEB:\n        if not (1 <= day <= MAX_DAY_FEB): # Max day for February is 29, no leap year logic required.\n            return False\n    # No 'else' branch is needed here as FR3 ensures the month is within 1-12,\n    # meaning it must fall into one of the categories above.\n\n    # FR5: The system shall return True if all validation rules are satisfied, otherwise False.\n    return True"}
{"task_id": "HumanEval/126", "solution": "from collections import Counter\ndef is_sorted(lst):\n    \"\"\"\n    Checks if a list of non-negative integers is sorted in ascending order\n    and if no number appears more than twice.\n    \"\"\"\n    if len(lst) <= 1:\n        return True\n\n    # Check for ascending order\n    for i in range(1, len(lst)):\n        if lst[i] < lst[i-1]:\n            return False\n\n    # Check for duplicate counts\n    counts = Counter(lst)\n    for count in counts.values():\n        if count > 2:\n            return False\n\n    return True"}
{"task_id": "HumanEval/126", "solution": "def is_sorted(lst: list[int]) -> bool:\n    \"\"\"\n    Checks if a list of integers is sorted in ascending order and adheres to a duplicate constraint.\n    No number in the list may appear more than twice.\n    \"\"\"\n    n = len(lst)\n\n    # Handle empty or single-element lists, which are considered sorted and valid (FR5, FR6).\n    if n <= 1:\n        return True\n\n    # Use a dictionary to count occurrences of each number for duplicate validation (FR4).\n    counts = {}\n\n    # Iterate through the list, checking for sorting order and duplicate limits simultaneously.\n    for i in range(n):\n        current_num = lst[i]\n\n        # FR3: Return False immediately if an element is smaller than its predecessor (not sorted).\n        if i > 0 and current_num < lst[i - 1]:\n            return False\n\n        # Update the count for the current number.\n        counts[current_num] = counts.get(current_num, 0) + 1\n\n        # FR4: Return False immediately if any number appears more than twice.\n        if counts[current_num] > 2:\n            return False\n\n    # FR2: If the loop completes without returning False, the list is sorted and meets constraints.\n    return True"}
{"task_id": "HumanEval/125", "solution": "class InvalidInputError(TypeError):\n    \"\"\"Custom exception for invalid input types.\"\"\"\n    def __init__(self, message=\"Invalid input type provided.\"):\n        self.message = message\n        super().__init__(self.message)\ndef split_words(txt) -> list[str] | int:\n    \"\"\"\n    Given a string of words, return a list of words split on whitespace, if no whitespaces exists in the text you\n    should split on commas ',' if no commas exists you should return the number of lower-case letters with odd order in the\n    alphabet, ord('a') = 0, ord('b') = 1, ... ord('z') = 25\n    Examples\n    split_words(\"Hello world!\") \u279e [\"Hello\", \"world!\"]\n    split_words(\"Hello,world!\") \u279e [\"Hello\", \"world!\"]\n    split_words(\"abcdef\") == 3 \n    \"\"\"\n    if not isinstance(txt, str):\n        raise InvalidInputError(\"Input must be a string.\")\n\n    if any(char.isspace() for char in txt):\n        return txt.split()\n    elif ',' in txt:\n        return txt.split(',')\n    else:\n        count = 0\n        for char in txt:\n            if 'a' <= char <= 'z':\n                order = ord(char) - ord('a')\n                if order % 2 != 0:\n                    count += 1\n        return count"}
{"task_id": "HumanEval/125", "solution": "import re\nALPHABET_START_ORD = ord('a')\ndef _is_lowercase_letter(char):\n    \"\"\"Checks if a character is a lowercase English letter.\"\"\"\n    return 'a' <= char <= 'z'\ndef _get_alphabetical_order(char):\n    \"\"\"Calculates the 0-indexed alphabetical order of a lowercase letter.\"\"\"\n    return ord(char) - ALPHABET_START_ORD\ndef _is_odd(order):\n    \"\"\"Checks if a number is odd.\"\"\"\n    return order % 2 != 0\ndef _count_odd_ordered_lowercase(txt):\n    \"\"\"Counts lowercase English letters in a string that have an odd 0-indexed alphabetical order.\"\"\"\n    count = 0\n    for char in txt:\n        if _is_lowercase_letter(char):\n            order = _get_alphabetical_order(char)\n            if _is_odd(order):\n                count += 1\n    return count\ndef split_words(txt):\n    \"\"\"\n    Given a string, returns a list of words or a count based on delimiters.\n    Splits by whitespace, then by commas, or counts odd-ordered lowercase letters.\n    \"\"\"\n    if not isinstance(txt, str):\n        raise TypeError(\"Input 'txt' must be a string.\")\n\n    if re.search(r'\\s', txt):\n        return txt.split()\n    elif ',' in txt:\n        return txt.split(',')\n    else:\n        return _count_odd_ordered_lowercase(txt)"}
{"task_id": "HumanEval/127", "solution": "import math\ndef is_prime(n: int) -> bool:\n    \"\"\"Determines if the given integer n is a prime number.\n    Returns True if n is prime, False otherwise.\"\"\"\n    if n <= 1:\n        return False\n    # Check for divisibility from 2 up to the square root of n.\n    for i in range(2, int(math.sqrt(n)) + 1):\n        if n % i == 0:\n            return False\n    return True\ndef intersection(interval1: tuple[int, int], interval2: tuple[int, int]) -> str:\n    \"\"\"Checks if the length of the intersection of two intervals is a prime number.\n    Returns \"YES\" if the length is prime, \"NO\" otherwise or if no intersection.\"\"\"\n    YES_RESPONSE = \"YES\"\n    NO_RESPONSE = \"NO\"\n\n    intersection_start = max(interval1[0], interval2[0])\n    intersection_end = min(interval1[1], interval2[1])\n\n    if intersection_start > intersection_end:\n        return NO_RESPONSE\n\n    length = intersection_end - intersection_start + 1\n    \n    if is_prime(length):\n        return YES_RESPONSE\n    else:\n        return NO_RESPONSE"}
{"task_id": "HumanEval/128", "solution": "from math import prod\ndef prod_signs(arr):\n    \"\"\"\n    Calculates the sum of magnitudes of integers multiplied by the product of their signs.\n    Returns None for an empty input array.\n    \"\"\"\n    if not arr:\n        return None\n\n    def _get_sign(num):\n        \"\"\"Determines the sign of a single integer as 1, -1, or 0.\"\"\"\n        if num > 0:\n            return 1\n        elif num < 0:\n            return -1\n        else:\n            return 0\n\n    sum_magnitudes = sum(abs(n) for n in arr)\n    signs = [_get_sign(n) for n in arr]\n    product_signs = prod(signs)\n\n    return sum_magnitudes * product_signs"}
{"task_id": "HumanEval/127", "solution": "from typing import Tuple, Optional\nimport math\nfrom dataclasses import dataclass\nclass Utils:\n    \"\"\"Provides static utility functions, specifically for mathematical operations.\"\"\"\n    @staticmethod\n    def is_prime(n: int) -> bool:\n        \"\"\"Determines if a given non-negative integer n is a prime number.\"\"\"\n        if n <= 1:\n            return False\n        if n == 2:\n            return True\n        if n % 2 == 0:\n            return False\n        for i in range(3, int(math.sqrt(n)) + 1, 2):\n            if n % i == 0:\n                return False\n        return True\nclass IntervalService:\n    \"\"\"Encapsulates the core business logic for interval operations.\"\"\"\n    def calculate_intersection(self, interval1: Interval, interval2: Interval) -> Optional[Interval]:\n        \"\"\"Calculates the intersection of two Interval objects.\"\"\"\n        max_start = max(interval1.start, interval2.start)\n        min_end = min(interval1.end, interval2.end)\n\n        if max_start <= min_end:\n            return Interval(max_start, min_end)\n        return None\n\n    def get_length(self, interval: Interval) -> int:\n        \"\"\"Calculates the length of a given Interval.\"\"\"\n        return interval.end - interval.start\n\n    def is_intersection_length_prime(self, interval1: Interval, interval2: Interval) -> str:\n        \"\"\"Determines if the length of the intersection of two intervals is a prime number.\"\"\"\n        intersection_interval = self.calculate_intersection(interval1, interval2)\n\n        if intersection_interval is None:\n            return \"NO\"\n\n        length = self.get_length(intersection_interval)\n        if Utils.is_prime(length):\n            return \"YES\"\n        return \"NO\"\ndef intersection(interval1: Tuple[int, int], interval2: Tuple[int, int]) -> str:\n    \"\"\"Determines if the length of the intersection of two closed integer intervals is a prime number.\n    Returns \"YES\" if prime, \"NO\" otherwise, including if intervals don't intersect.\"\"\"\n    \n    interval_service = IntervalService()\n\n    # Convert input tuples to Interval objects\n    interval1_obj = Interval(interval1[0], interval1[1])\n    interval2_obj = Interval(interval2[0], interval2[1])\n    \n    return interval_service.is_intersection_length_prime(interval1_obj, interval2_obj)"}
{"task_id": "HumanEval/131", "solution": "def digits(n: int) -> int:\n    \"\"\"Given a positive integer n, return the product of its odd digits.\n    Returns 0 if all digits are even.\n    \"\"\"\n    product = 1\n    has_odd_digit = False\n\n    for digit_char in str(n):\n        digit = int(digit_char)\n        if digit % 2 != 0:  # Check if the digit is odd\n            product *= digit\n            has_odd_digit = True\n\n    if not has_odd_digit:\n        return 0\n    else:\n        return product"}
