{"task_id": "HumanEval/161", "solution": "class StringUtil:\n    @staticmethod\n    def has_letters(s: str) -> bool:\n        \"\"\"Checks if the string contains any alphabetic characters.\"\"\"\n        return any(char.isalpha() for char in s)\n\n    @staticmethod\n    def reverse_case(char: str) -> str:\n        \"\"\"Reverses the case of a single alphabetic character; returns unchanged otherwise.\"\"\"\n        if char.islower():\n            return char.upper()\n        elif char.isupper():\n            return char.lower()\n        return char\n\n    @staticmethod\n    def reverse_string(s: str) -> str:\n        \"\"\"Reverses the entire input string.\"\"\"\n        return s[::-1]\nclass StringTransformer:\n    def transform_string(self, s: str) -> str:\n        \"\"\"Applies transformation: case reversal for letters, or full string reversal if no letters.\"\"\"\n        if not StringUtil.has_letters(s):\n            return StringUtil.reverse_string(s)\n        \n        transformed_chars = []\n        for char in s:\n            transformed_chars.append(StringUtil.reverse_case(char))\n        return \"\".join(transformed_chars)\ndef solve(s: str) -> str:\n    \"\"\"\n    Transforms a string: reverses case of letters, keeps non-letters as is.\n    If no letters are present, reverses the entire string.\n    \"\"\"\n    transformer = StringTransformer()\n    return transformer.transform_string(s)"}
{"task_id": "HumanEval/159", "solution": "def eat(number, need, remaining):\n    \"\"\"\n    You're a hungry rabbit, and you already have eaten a certain number of carrots,\n    but now you need to eat more carrots to complete the day's meals.\n    you should return an array of [ total number of eaten carrots after your meals,\n                                    the number of carrots left after your meals ]\n    if there are not enough remaining carrots, you will eat all remaining carrots, but will still be hungry.\n    \n    Example:\n    * eat(5, 6, 10) -> [11, 4]\n    * eat(4, 8, 9) -> [12, 1]\n    * eat(1, 10, 10) -> [11, 0]\n    * eat(2, 11, 5) -> [7, 0]\n    \n    Variables:\n    @number : integer\n        the number of carrots that you have eaten.\n    @need : integer\n        the number of carrots that you need to eat.\n    @remaining : integer\n        the number of remaining carrots thet exist in stock\n    \n    Constrain:\n    * 0 <= number <= 1000\n    * 0 <= need <= 1000\n    * 0 <= remaining <= 1000\n\n    Have fun :)\n    \"\"\"\n    carrots_eaten_now = min(need, remaining)\n    total_eaten = number + carrots_eaten_now\n    carrots_left = remaining - carrots_eaten_now\n    return [total_eaten, carrots_left]"}
{"task_id": "HumanEval/161", "solution": "def solve(s: str) -> str:\n    \"\"\"Transforms a string: reverses case of letters, keeps non-letters as is. If no letters, reverses the entire string.\"\"\"\n    if not isinstance(s, str):\n        raise TypeError(\"Input must be a string.\")\n\n    has_letters = any(c.isalpha() for c in s)\n\n    if has_letters:\n        result_chars = []\n        for char in s:\n            if char.isalpha():\n                if char.islower():\n                    result_chars.append(char.upper())\n                else:\n                    result_chars.append(char.lower())\n            else:\n                result_chars.append(char)\n        return \"\".join(result_chars)\n    else:\n        return s[::-1]"}
{"task_id": "HumanEval/160", "solution": "from typing import List, Set\nclass InvalidExpressionError(ValueError):\n    \"\"\"Custom exception for invalid algebraic expression inputs.\"\"\"\n    pass\nSUPPORTED_OPERATORS: Set[str] = {'+', '-', '*', '//', '**'}\ndef do_algebra(operator: List[str], operand: List[int]) -> int:\n    \"\"\"\n    Evaluates an algebraic expression constructed from lists of operators and operands.\n    Supports addition, subtraction, multiplication, floor division, and exponentiation.\n    \"\"\"\n    # Validate inputs according to business rules.\n    if not isinstance(operator, list) or not all(isinstance(op_item, str) for op_item in operator):\n        raise InvalidExpressionError(\"Operators must be a list of strings.\")\n    if not isinstance(operand, list) or not all(isinstance(op_item, int) for op_item in operand):\n        raise InvalidExpressionError(\"Operands must be a list of integers.\")\n\n    if len(operator) != len(operand) - 1:\n        raise InvalidExpressionError(\"Operator list length must be one less than operand list length.\")\n    if len(operator) < 1:\n        raise InvalidExpressionError(\"Operator list must have at least one operator.\")\n    if len(operand) < 2:\n        raise InvalidExpressionError(\"Operand list must have at least two operands.\")\n\n    for op_item in operator:\n        if op_item not in SUPPORTED_OPERATORS:\n            raise InvalidExpressionError(f\"Unsupported operator: {op_item}\")\n    for val in operand:\n        if val < 0:\n            raise InvalidExpressionError(\"All operands must be non-negative integers.\")\n\n    # Construct the algebraic expression string.\n    expression_parts = []\n    for i in range(len(operand)):\n        expression_parts.append(str(operand[i]))\n        if i < len(operator):\n            expression_parts.append(operator[i])\n    expression_string = \" \".join(expression_parts)\n\n    # Evaluate the expression safely using eval() due to strict input validation.\n    try:\n        result = eval(expression_string)\n    except ZeroDivisionError:\n        raise ZeroDivisionError(\"Division by zero occurred in the expression.\")\n    except Exception as e:\n        raise InvalidExpressionError(f\"Error evaluating expression: {e}\")\n\n    return int(result)"}
{"task_id": "HumanEval/160", "solution": "def do_algebra(operator, operand):\n    \"\"\"\n    Given two lists operator, and operand. The first list has basic algebra operations, and \n    the second list is a list of integers. Use the two given lists to build the algebric \n    expression and return the evaluation of this expression.\n\n    The basic algebra operations:\n    Addition ( + ) \n    Subtraction ( - ) \n    Multiplication ( * ) \n    Floor division ( // ) \n    Exponentiation ( ** ) \n\n    Example:\n    operator['+', '*', '-']\n    array = [2, 3, 4, 5]\n    result = 2 + 3 * 4 - 5\n    => result = 9\n\n    Note:\n        The length of operator list is equal to the length of operand list minus one.\n        Operand is a list of of non-negative integers.\n        Operator list has at least one operator, and operand list has at least two operands.\n\n    \"\"\"\n    class InvalidInputError(Exception):\n        \"\"\"Custom exception for invalid input lists (e.g., incorrect lengths, types, or values).\"\"\"\n        def __init__(self, message: str):\n            super().__init__(message)\n            self.message = message\n\n    class UnsupportedOperatorError(Exception):\n        \"\"\"Custom exception for unsupported or unrecognized operator strings.\"\"\"\n        def __init__(self, message: str):\n            super().__init__(message)\n            self.message = message\n\n    class AlgebraEvaluator:\n        \"\"\"Handles the validation, construction, and evaluation of algebraic expressions.\"\"\"\n        _SUPPORTED_OPERATORS = {'+', '-', '*', '//', '**'}\n\n        def evaluate(self, operators: list[str], operands: list[int]) -> int:\n            \"\"\"Evaluates an algebraic expression given lists of operators and operands.\"\"\"\n            self._validate_inputs(operators, operands)\n            expression_string = self._build_expression_string(operators, operands)\n            try:\n                # Eval is used here for its simplicity and correct operator precedence handling.\n                # Security is mitigated by strict input validation within _validate_inputs.\n                result = eval(expression_string)\n                return int(result)\n            except Exception as e:\n                raise RuntimeError(f\"Error during expression evaluation: {e}\") from e\n\n        def _validate_inputs(self, operators: list[str], operands: list[int]) -> None:\n            \"\"\"Validates the input lists for correctness and adherence to rules.\"\"\"\n            if not operators or not operands:\n                raise InvalidInputError(\"Operator and operand lists cannot be empty.\")\n            if len(operands) < 2:\n                raise InvalidInputError(\"Operand list must contain at least two operands.\")\n            if len(operators) < 1:\n                raise InvalidInputError(\"Operator list must contain at least one operator.\")\n            if len(operators) != len(operands) - 1:\n                raise InvalidInputError(\n                    f\"Length mismatch: operators ({len(operators)}) should be \"\n                    f\"len(operands) - 1 ({len(operands) - 1}).\"\n                )\n\n            for op in operators:\n                if not isinstance(op, str) or op not in self._SUPPORTED_OPERATORS:\n                    raise UnsupportedOperatorError(f\"Unsupported operator found: '{op}'\")\n\n            for operand in operands:\n                if not isinstance(operand, int) or operand < 0:\n                    raise InvalidInputError(\n                        f\"Invalid operand: '{operand}'. Operands must be non-negative integers.\"\n                    )\n\n        def _build_expression_string(self, operators: list[str], operands: list[int]) -> str:\n            \"\"\"Constructs the algebraic expression string from operators and operands.\"\"\"\n            expression_parts = []\n            for i in range(len(operands)):\n                expression_parts.append(str(operands[i]))\n                if i < len(operators):\n                    expression_parts.append(operators[i])\n            return \" \".join(expression_parts)\n\n    evaluator = AlgebraEvaluator()\n    return evaluator.evaluate(operator, operand)"}
{"task_id": "HumanEval/162", "solution": "import hashlib\ndef string_to_md5(text):\n    \"\"\"\n    Given a string 'text', return its MD5 hash equivalent as a hexadecimal string.\n    If 'text' is an empty string, return None.\n    \"\"\"\n    if not text:\n        return None\n    return hashlib.md5(text.encode('utf-8')).hexdigest()"}
{"task_id": "HumanEval/163", "solution": "def generate_integers(a, b):\n    \"\"\"\n    Given two non-negative integers a and b, return the even single-digit numbers\n    within their inclusive range, in ascending order.\n    \"\"\"\n    if not (isinstance(a, int) and isinstance(b, int) and a >= 0 and b >= 0):\n        raise ValueError(\"Inputs 'a' and 'b' must be non-negative integers.\")\n\n    EVEN_DIGITS = [0, 2, 4, 6, 8]\n    start, end = min(a, b), max(a, b)\n    \n    result_digits = []\n    for digit in EVEN_DIGITS:\n        if start <= digit <= end:\n            result_digits.append(digit)\n    \n    return result_digits"}
{"task_id": "HumanEval/163", "solution": "def generate_integers(a, b):\n    \"\"\"\n    Given two positive integers a and b, this function returns a list of all even integers\n    found between a and b (inclusive), sorted in ascending order.\n    \"\"\"\n    if not isinstance(a, int) or not isinstance(b, int):\n        raise ValueError(\"Inputs 'a' and 'b' must be integers.\")\n    if a <= 0 or b <= 0:\n        raise ValueError(\"Inputs 'a' and 'b' must be positive integers.\")\n\n    start = min(a, b)\n    end = max(a, b)\n    \n    even_numbers = []\n    for i in range(start, end + 1):\n        if i % 2 == 0:\n            even_numbers.append(i)\n    \n    return even_numbers"}
