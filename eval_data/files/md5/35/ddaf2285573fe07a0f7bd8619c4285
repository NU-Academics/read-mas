{"task_id": "HumanEval/155", "solution": "def even_odd_count(num: int) -> tuple[int, int]:\n    \"\"\"Given an integer. return a tuple that has the number of even and odd digits respectively.\n\n     Example:\n        even_odd_count(-12) ==> (1, 1)\n        even_odd_count(123) ==> (1, 2)\n    \"\"\"\n    even_count = 0\n    odd_count = 0\n    \n    # Handle zero as a special case, it has one even digit.\n    if num == 0:\n        return (1, 0)\n\n    # Convert to string to process digits, handling negative numbers by taking absolute value.\n    num_str = str(abs(num))\n\n    for digit_char in num_str:\n        digit = int(digit_char)\n        if digit % 2 == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n    return (even_count, odd_count)"}
{"task_id": "HumanEval/156", "solution": "ROMAN_MAP = {\n    1000: 'm', 900: 'cm', 500: 'd', 400: 'cd',\n    100: 'c', 90: 'xc', 50: 'l', 40: 'xl',\n    10: 'x', 9: 'ix', 5: 'v', 4: 'iv', 1: 'i'\n}\ndef int_to_mini_roman(number):\n    \"\"\"\n    Converts a positive integer (1-1000) into its lowercase Roman numeral equivalent.\n    Raises ValueError for invalid input types or numbers outside the specified range.\n    \"\"\"\n    if not isinstance(number, int) or not (1 <= number <= 1000):\n        raise ValueError(\"Input must be an integer between 1 and 1000.\")\n\n    roman_numeral = []\n    temp_num = number\n    for value, symbol in ROMAN_MAP.items():\n        while temp_num >= value:\n            roman_numeral.append(symbol)\n            temp_num -= value\n    return \"\".join(roman_numeral)"}
{"task_id": "HumanEval/156", "solution": "def int_to_mini_roman(number):\n    \"\"\"\n    Given a positive integer, obtain its roman numeral equivalent as a string,\n    and return it in lowercase.\n    Restrictions: 1 <= num <= 1000\n    \"\"\"\n    if not isinstance(number, int) or not (1 <= number <= 1000):\n        raise ValueError(\"Input number must be an integer between 1 and 1000.\")\n\n    # Predefined mapping of integer values to lowercase Roman numeral symbols.\n    roman_map = [\n        (1000, 'm'), (900, 'cm'), (500, 'd'), (400, 'cd'),\n        (100, 'c'), (90, 'xc'), (50, 'l'), (40, 'xl'),\n        (10, 'x'), (9, 'ix'), (5, 'v'), (4, 'iv'), (1, 'i')\n    ]\n\n    roman_numeral_parts = []\n    temp_num = number\n    for value, symbol in roman_map:\n        while temp_num >= value:\n            roman_numeral_parts.append(symbol)\n            temp_num -= value\n    return \"\".join(roman_numeral_parts)"}
{"task_id": "HumanEval/158", "solution": "def find_max(words):\n    \"\"\"\n    Finds the word with the maximum number of unique characters.\n    Handles ties by returning the lexicographically smallest word.\n    \"\"\"\n    if not words:\n        return \"\"\n\n    candidates = []\n    for word in words:\n        unique_count = len(set(word))\n        candidates.append((unique_count, word))\n    \n    # Sort candidates by unique character count (descending) and then by word (ascending).\n    candidates.sort(key=lambda x: (-x[0], x[1]))\n\n    return candidates[0][1]"}
{"task_id": "HumanEval/158", "solution": "def find_max(words):\n    \"\"\"\n    Finds the word with the maximum number of unique characters.\n    If multiple strings have the maximum, returns the lexicographically smallest.\n    \"\"\"\n    if not words:\n        return \"\"\n\n    max_unique_count = -1\n    result_word = \"\"\n\n    for word in words:\n        current_unique_count = len(set(word))\n\n        if current_unique_count > max_unique_count:\n            max_unique_count = current_unique_count\n            result_word = word\n        elif current_unique_count == max_unique_count:\n            # Tie-breaking: if current_word is lexicographically smaller.\n            if result_word == \"\" or word < result_word:\n                result_word = word\n    \n    return result_word"}
{"task_id": "HumanEval/157", "solution": "def right_angle_triangle(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle. Return True if the three\n    sides form a right-angled triangle, False otherwise.\n    A right-angled triangle is a triangle in which one angle is right angle or \n    90 degree.\n    Example:\n    right_angle_triangle(3, 4, 5) == True\n    right_angle_triangle(1, 2, 3) == False\n    '''\n    # Input validation: check if all sides are numeric\n    if not all(isinstance(s, (int, float)) for s in [a, b, c]):\n        raise TypeError(\"All side lengths must be numeric.\")\n\n    # Input validation: check if all sides are positive\n    if not all(s > 0 for s in [a, b, c]):\n        raise ValueError(\"All side lengths must be positive.\")\n\n    # Sort the sides to easily identify the potential hypotenuse\n    sides = sorted([a, b, c])\n    side1, side2, hypotenuse = sides[0], sides[1], sides[2]\n\n    # Use a small epsilon for floating-point comparison to account for precision issues\n    epsilon = 1e-9\n\n    # Check the Pythagorean theorem: a^2 + b^2 = c^2\n    return abs(side1**2 + side2**2 - hypotenuse**2) < epsilon"}
{"task_id": "HumanEval/159", "solution": "def eat(number, need, remaining):\n    \"\"\"Calculates total carrots eaten and remaining stock after a rabbit's meal.\n    If not enough carrots are available, the rabbit eats all remaining.\n    \"\"\"\n    carrots_consumed = min(need, remaining)\n    total_eaten = number + carrots_consumed\n    remaining_stock = remaining - carrots_consumed\n    return [total_eaten, remaining_stock]"}
