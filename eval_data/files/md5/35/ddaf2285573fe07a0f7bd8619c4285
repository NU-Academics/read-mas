{"task_id": "HumanEval/55", "solution": "class InvalidInputError(Exception):\n    \"\"\"Custom exception for invalid input.\n    It is raised for non-integer or negative inputs.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\ndef fib(n: int):\n    \"\"\"Return n-th Fibonacci number.\n    >>> fib(10)\n    55\n    >>> fib(1)\n    1\n    >>> fib(8)\n    21\n    \"\"\"\n    if not isinstance(n, int):\n        raise InvalidInputError(\"Input 'n' must be an integer.\")\n    if n < 0:\n        raise InvalidInputError(\"Input 'n' cannot be negative.\")\n    \n    if n == 0:\n        return 0\n    elif n == 1:\n        return 1\n    else:\n        a, b = 0, 1\n        for _ in range(2, n + 1):\n            a, b = b, a + b\n        return b"}
{"task_id": "HumanEval/55", "solution": "from typing import Dict\nclass InvalidInputError(Exception):\n    \"\"\"Custom exception for invalid input to Fibonacci calculation.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\nclass FibonacciCalculator:\n    \"\"\"Calculates Fibonacci numbers using memoization for efficiency.\"\"\"\n    def __init__(self):\n        self._cache: Dict[int, int] = {0: 0, 1: 1}\n\n    def calculate(self, n: int) -> int:\n        \"\"\"Computes the Nth Fibonacci number, validating input.\"\"\"\n        if not isinstance(n, int) or n < 0:\n            raise InvalidInputError(\"Invalid input: n must be a non-negative integer.\")\n\n        if n in self._cache:\n            return self._cache[n]\n\n        # Determine the highest Fibonacci number already in cache.\n        current_max_cached_idx = max(self._cache.keys())\n\n        # Start calculation from the next number, using the last two cached values.\n        a = self._cache[current_max_cached_idx - 1]\n        b = self._cache[current_max_cached_idx]\n\n        for i in range(current_max_cached_idx + 1, n + 1):\n            next_fib = a + b\n            self._cache[i] = next_fib\n            a, b = b, next_fib\n            \n        return self._cache[n]\n_calculator = FibonacciCalculator()\ndef fib(n: int) -> int:\n    \"\"\"Return n-th Fibonacci number.\n    >>> fib(10)\n    55\n    >>> fib(1)\n    1\n    >>> fib(8)\n    21\n    \"\"\"\n    return _calculator.calculate(n)"}
{"task_id": "HumanEval/57", "solution": "def monotonic(l: list) -> bool:\n    \"\"\"\n    Determines if a list of elements is monotonically increasing or decreasing.\n    Handles empty, single-element, and lists with duplicates.\n    \"\"\"\n    if len(l) <= 1:\n        return True\n\n    # Tracks the determined trend: True for non-decreasing, False for non-increasing, None if not yet determined.\n    is_non_decreasing = None \n\n    for i in range(len(l) - 1):\n        if l[i] < l[i+1]:\n            # Current pair is increasing. If previous trend was decreasing, it's not monotonic.\n            if is_non_decreasing is False:\n                return False\n            is_non_decreasing = True\n        elif l[i] > l[i+1]:\n            # Current pair is decreasing. If previous trend was increasing, it's not monotonic.\n            if is_non_decreasing is True:\n                return False\n            is_non_decreasing = False\n        # If l[i] == l[i+1], the trend is maintained, and is_non_decreasing remains unchanged.\n    \n    return True"}
{"task_id": "HumanEval/56", "solution": "def correct_bracketing(brackets: str) -> bool:\n    \"\"\"Checks if the given string of '<>' brackets is correctly balanced.\n    It ensures every opening bracket has a corresponding closing bracket and they are properly nested.\"\"\"\n    balance = 0\n    for char in brackets:\n        if char == '<':\n            balance += 1\n        elif char == '>':\n            balance -= 1\n        \n        # If balance ever drops below zero, a closing bracket appeared without a matching open one.\n        if balance < 0:\n            return False\n            \n    # After iterating, if balance is zero, all brackets were correctly matched.\n    return balance == 0"}
{"task_id": "HumanEval/56", "solution": "def correct_bracketing(brackets: str):\n    \"\"\" brackets is a string of \"<\" and \">\".\n    return True if every opening bracket has a corresponding closing bracket.\n\n    >>> correct_bracketing(\"<\")\n    False\n    >>> correct_bracketing(\"<>\")\n    True\n    >>> correct_bracketing(\"<<><>>\")\n    True\n    >>> correct_bracketing(\"><<>\")\n    False\n    \"\"\"\n    if not isinstance(brackets, str):\n        raise TypeError(\"Input must be a string.\")\n\n    valid_chars = \"<>\"\n    for char in brackets:\n        if char not in valid_chars:\n            raise ValueError(f\"Invalid character '{char}' found. Only '<' and '>' are allowed.\")\n\n    balance = 0\n    for char in brackets:\n        if char == '<':\n            balance += 1\n        elif char == '>':\n            balance -= 1\n        if balance < 0: \n            return False\n            \n    return balance == 0"}
{"task_id": "HumanEval/57", "solution": "def _is_increasing(l: list) -> bool:\n    \"\"\"Checks if the list is monotonically increasing (non-decreasing).\"\"\"\n    for i in range(len(l) - 1):\n        if l[i] > l[i+1]:\n            return False\n    return True\ndef _is_decreasing(l: list) -> bool:\n    \"\"\"Checks if the list is monotonically decreasing (non-increasing).\"\"\"\n    for i in range(len(l) - 1):\n        if l[i] < l[i+1]:\n            return False\n    return True\ndef monotonic(l: list) -> bool:\n    \"\"\"Return True is list elements are monotonically increasing or decreasing.\n    >>> monotonic([1, 2, 4, 20])\n    True\n    >>> monotonic([1, 20, 4, 10])\n    False\n    >>> monotonic([4, 1, 0, -10])\n    True\n    \"\"\"\n    if len(l) <= 1:\n        return True\n    return _is_increasing(l) or _is_decreasing(l)"}
