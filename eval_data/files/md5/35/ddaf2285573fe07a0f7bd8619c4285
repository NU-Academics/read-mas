{"task_id": "HumanEval/70", "solution": "def strange_sort_list(lst):\n    \"\"\"\n    Given list of integers, return list in strange order.\n    Strange sorting, is when you start with the minimum value,\n    then maximum of the remaining integers, then minimum and so on.\n    \"\"\"\n    if not lst:\n        return []\n\n    # Create a sorted copy of the input list.\n    # This allows efficient retrieval of min/max elements using pop(0) and pop().\n    mutable_list = sorted(lst)\n    result = []\n\n    while mutable_list:\n        # Append the current minimum element (from the front of the sorted list).\n        result.append(mutable_list.pop(0))\n\n        # If there are still elements, append the current maximum element (from the end).\n        if mutable_list:\n            result.append(mutable_list.pop())\n    \n    return result"}
{"task_id": "HumanEval/71", "solution": "import math\ndef triangle_area(a, b, c):\n    \"\"\"\n    Calculates the area of a triangle given its three side lengths.\n    Returns the area rounded to 2 decimal points if valid, otherwise returns -1.00.\n    \"\"\"\n    # Check for positive side lengths and triangle inequality\n    if not (a > 0 and b > 0 and c > 0 and\n            a + b > c and a + c > b and b + c > a):\n        return -1.00\n\n    # Calculate the semi-perimeter\n    s = (a + b + c) / 2\n\n    # Calculate the area using Heron's formula\n    area = math.sqrt(s * (s - a) * (s - b) * (s - c))\n\n    return round(area, 2)"}
{"task_id": "HumanEval/72", "solution": "def will_it_fly(q: list[int], w: int) -> bool:\n    \"\"\"\n    Determines if an object represented by list 'q' will fly.\n    An object flies if it's a palindrome and its sum is within the maximum weight 'w'.\n    \"\"\"\n    is_balanced = q == q[::-1]\n    total_weight = sum(q)\n    weight_ok = total_weight <= w\n    return is_balanced and weight_ok"}
{"task_id": "HumanEval/71", "solution": "import math\nclass TriangleUtils:\n    @staticmethod\n    def round_to_two_decimals(value: float) -> float:\n        \"\"\"\n        Rounds a float value to two decimal places.\n        This function ensures the output precision.\n        \"\"\"\n        return round(value, 2)\nclass TriangleCalculator:\n    @staticmethod\n    def is_valid_triangle(a: float, b: float, c: float) -> bool:\n        \"\"\"\n        Checks if three side lengths can form a valid triangle.\n        It validates positivity and triangle inequality.\n        \"\"\"\n        if a <= 0 or b <= 0 or c <= 0:\n            return False\n        return (a + b > c) and (a + c > b) and (b + c > a)\n\n    @staticmethod\n    def calculate_area(a: float, b: float, c: float) -> float:\n        \"\"\"\n        Calculates the area of a triangle using Heron's formula.\n        It assumes the input sides already form a valid triangle.\n        \"\"\"\n        s = (a + b + c) / 2\n        area = math.sqrt(s * (s - a) * (s - b) * (s - c))\n        return area\ndef triangle_area(a, b, c):\n    \"\"\"\n    Given three side lengths, calculates the triangle's area.\n    Returns the area rounded to two decimal points, or -1 for invalid triangles.\n    \"\"\"\n    if not TriangleCalculator.is_valid_triangle(a, b, c):\n        return -1.0\n    \n    area = TriangleCalculator.calculate_area(a, b, c)\n    return TriangleUtils.round_to_two_decimals(area)"}
{"task_id": "HumanEval/70", "solution": "class InvalidInputError(Exception):\n    \"\"\"Custom exception for invalid input to the strange sort function.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\ndef strange_sort_list(lst):\n    '''\n    Given list of integers, return list in strange order.\n    Strange sorting, is when you start with the minimum value,\n    then maximum of the remaining integers, then minimum and so on.\n\n    Examples:\n    strange_sort_list([1, 2, 3, 4]) == [1, 4, 2, 3]\n    strange_sort_list([5, 5, 5, 5]) == [5, 5, 5, 5]\n    strange_sort_list([]) == []\n    '''\n    if not isinstance(lst, list):\n        raise InvalidInputError(\"Input must be a list.\")\n    if not all(isinstance(item, int) for item in lst):\n        raise InvalidInputError(\"All elements in the list must be integers.\")\n\n    if not lst:\n        return []\n\n    mutable_list = sorted(lst)\n    result_list = []\n    is_min_turn = True\n\n    while mutable_list:\n        if is_min_turn:\n            result_list.append(mutable_list.pop(0))\n        else:\n            result_list.append(mutable_list.pop())\n        is_min_turn = not is_min_turn\n    \n    return result_list"}
{"task_id": "HumanEval/73", "solution": "def smallest_change(arr):\n    \"\"\"\n    Finds the minimum changes to make an array palindromic. A change involves modifying one element.\n    \"\"\"\n    n = len(arr)\n    changes = 0\n    for i in range(n // 2):\n        if arr[i] != arr[n - 1 - i]:\n            changes += 1\n    return changes"}
{"task_id": "HumanEval/72", "solution": "def will_it_fly(q, w):\n    \"\"\"\n    Determines if an object represented by list 'q' will fly, based on balance and weight.\n    An object flies if it's a palindrome and its sum is less than or equal to 'w'.\n    \"\"\"\n    if not isinstance(q, list):\n        raise TypeError(\"Input 'q' must be a list.\")\n    if not isinstance(w, (int, float)):\n        raise TypeError(\"Input 'w' (max weight) must be numeric.\")\n\n    # Check if 'q' is a palindrome (balanced)\n    is_balanced = (q == q[::-1])\n\n    # Calculate sum of elements in 'q' and validate element types\n    current_sum = 0.0\n    for item in q:\n        if not isinstance(item, (int, float)):\n            raise TypeError(\"List elements in 'q' must be numeric.\")\n        current_sum += item\n\n    # Check if sum is less than or equal to maximum weight 'w'\n    is_within_weight_limit = (current_sum <= w)\n\n    # An object flies if it is balanced AND its weight is within limits\n    return is_balanced and is_within_weight_limit"}
{"task_id": "HumanEval/73", "solution": "def smallest_change(arr):\n    \"\"\"\n    Calculates the minimum changes needed to make an array palindromic.\n    Compares elements from both ends, incrementing a counter for mismatches.\n    \"\"\"\n    if not isinstance(arr, list):\n        raise TypeError(\"Input must be a list.\")\n\n    for item in arr:\n        if not isinstance(item, int):\n            raise ValueError(\"All elements in the list must be integers.\")\n\n    n = len(arr)\n    if n <= 1:\n        return 0\n\n    changes = 0\n    left, right = 0, n - 1\n\n    while left < right:\n        if arr[left] != arr[right]:\n            changes += 1\n        left += 1\n        right -= 1\n\n    return changes"}
{"task_id": "HumanEval/74", "solution": "def total_match(lst1, lst2):\n    \"\"\"\n    Compares two lists of strings by their total character count.\n    Returns the list with the smaller total character count, or lst1 if counts are equal.\n    \"\"\"\n    if not isinstance(lst1, list) or not isinstance(lst2, list):\n        raise TypeError(\"Both inputs must be lists.\")\n\n    # Calculate total characters for lst1\n    count1 = 0\n    for s in lst1:\n        if not isinstance(s, str):\n            raise TypeError(\"List must contain only strings.\")\n        count1 += len(s)\n\n    # Calculate total characters for lst2\n    count2 = 0\n    for s in lst2:\n        if not isinstance(s, str):\n            raise TypeError(\"List must contain only strings.\")\n        count2 += len(s)\n\n    if count1 <= count2:\n        return lst1\n    else:\n        return lst2"}
{"task_id": "HumanEval/76", "solution": "def is_simple_power(x: int, n: int) -> bool:\n    \"\"\"\n    Checks if x is a simple power of n (n**k = x for integer k).\n    Returns True if x is a simple power of n, False otherwise.\n    \"\"\"\n    if n <= 0:\n        return False\n    if x <= 0:\n        return False\n    if x == 1:\n        return True\n\n    if n == 1:\n        return False # Only x=1 is a power of 1, handled above.\n\n    while x % n == 0:\n        x //= n\n    return x == 1"}
{"task_id": "HumanEval/77", "solution": "def iscube(a):\n    \"\"\"\n    Checks if an integer 'a' is a perfect cube of another integer.\n    This implementation handles positive, negative, and zero inputs.\n    \"\"\"\n    if a == 0:\n        return True\n\n    # Calculate the approximate integer cube root of the absolute value.\n    root = round(abs(a)**(1/3))\n\n    # Reconstruct the cube with the original sign for comparison.\n    candidate_cube = root ** 3\n    if a < 0:\n        candidate_cube = -candidate_cube\n\n    return candidate_cube == a"}
{"task_id": "HumanEval/77", "solution": "def iscube(a: int) -> bool:\n    \"\"\"\n    Checks if an integer `a` is a perfect cube of some integer.\n    Returns `True` if `a` is a perfect cube, `False` otherwise.\n    \"\"\"\n    if a == 0:\n        return True\n    \n    abs_a = abs(a)\n    # Handle negative numbers by using the absolute value for cube root calculation.\n    # The original sign is re-applied when checking the result.\n    \n    cbrt = round(abs_a**(1/3))\n    # Calculate the approximate cube root of the absolute value.\n    # Rounding helps mitigate floating-point inaccuracies.\n    \n    # Check if the cubed root, with the original sign, equals the original number.\n    if a < 0:\n        return (-cbrt * -cbrt * -cbrt) == a\n    else:\n        return (cbrt * cbrt * cbrt) == a"}
{"task_id": "HumanEval/75", "solution": "def is_multiply_prime(a):\n    \"\"\"Checks if a given number 'a' is the product of exactly three prime numbers.\n    The three prime factors can be repeated.\n    \"\"\"\n\n    def is_prime(n: int) -> bool:\n        \"\"\"Determines if a number is prime.\"\"\"\n        if n < 2:\n            return False\n        for i in range(2, int(n**0.5) + 1):\n            if n % i == 0:\n                return False\n        return True\n\n    def get_primes_up_to(limit: int) -> list[int]:\n        \"\"\"Generates a list of all prime numbers up to and including 'limit'.\"\"\"\n        primes = []\n        for i in range(2, limit + 1):\n            if is_prime(i):\n                primes.append(i)\n        return primes\n\n    if not isinstance(a, int):\n        raise TypeError(\"Input 'a' must be an integer.\")\n    \n    # Numbers outside the range 0 < a < 100 are not considered multiply primes.\n    if a <= 0 or a >= 100:\n        return False\n\n    # Get all primes up to 'a' as potential factors.\n    primes = get_primes_up_to(a)\n\n    n = len(primes)\n    # Iterate through combinations of three primes, allowing repetition.\n    for i in range(n):\n        for j in range(i, n):\n            for k in range(j, n):\n                p1 = primes[i]\n                p2 = primes[j]\n                p3 = primes[k]\n                \n                product = p1 * p2 * p3\n                \n                if product == a:\n                    return True\n                \n                # Optimization: if the product exceeds 'a', further products with\n                # larger primes in this inner loop will also exceed 'a'.\n                if product > a:\n                    break \n    \n    return False"}
{"task_id": "HumanEval/74", "solution": "def _count_total_characters(lst: list[str]) -> int:\n    \"\"\"Calculates the total number of characters across all strings in a list.\n    This function sums the lengths of all strings to determine the aggregated character count.\n    \"\"\"\n    total_chars = 0\n    for s in lst:\n        total_chars += len(s)\n    return total_chars\ndef total_match(lst1: list[str], lst2: list[str]) -> list[str]:\n    \"\"\"Compares two lists of strings by their total character count.\n    Returns the list with the smaller character count, or the first list if counts are equal.\n    \"\"\"\n    count1 = _count_total_characters(lst1)\n    count2 = _count_total_characters(lst2)\n\n    if count1 <= count2:\n        return lst1\n    else:\n        return lst2"}
{"task_id": "HumanEval/75", "solution": "def is_multiply_prime(a):\n    \"\"\"Checks if a number is a product of three distinct prime numbers.\n    The input 'a' must be an integer strictly between 0 and 100.\n    \"\"\"\n    if not isinstance(a, int):\n        raise ValueError(\"Input must be an integer.\")\n    if a <= 0 or a >= 100:\n        raise ValueError(\"Number must be between 1 and 99.\")\n\n    # Smallest product of 3 distinct primes is 2 * 3 * 5 = 30.\n    # Numbers less than 30 cannot satisfy the condition.\n    if a < 30:\n        return False\n\n    def _get_primes_up_to(limit: int) -> list[int]:\n        \"\"\"Generates a list of all prime numbers up to and including limit using the Sieve of Eratosthenes.\"\"\"\n        if limit < 2:\n            return []\n        \n        primes_sieve = [True] * (limit + 1)\n        primes_sieve[0] = primes_sieve[1] = False\n        for p in range(2, int(limit**0.5) + 1):\n            if primes_sieve[p]:\n                for multiple in range(p * p, limit + 1, p):\n                    primes_sieve[multiple] = False\n        \n        return [p for p, is_p in enumerate(primes_sieve) if is_p]\n\n    def _get_distinct_prime_factors(num: int, primes_list: list[int]) -> set[int]:\n        \"\"\"Finds all distinct prime factors of num using a pre-generated list of primes.\"\"\"\n        factors = set()\n        temp_num = num\n        for prime in primes_list:\n            if prime * prime > temp_num:\n                break \n            if temp_num % prime == 0:\n                factors.add(prime)\n                while temp_num % prime == 0:\n                    temp_num //= prime\n        if temp_num > 1:\n            factors.add(temp_num)\n        return factors\n\n    # Generate primes up to 'a' as 'a' is the number being factored.\n    primes_up_to_a = _get_primes_up_to(a)\n    \n    # Find all distinct prime factors of 'a'.\n    distinct_prime_factors = _get_distinct_prime_factors(a, primes_up_to_a)\n    \n    # Check if 'a' has exactly three distinct prime factors.\n    return len(distinct_prime_factors) == 3"}
{"task_id": "HumanEval/76", "solution": "import math\nEPSILON = 1e-9\nclass InvalidInputError(ValueError):\n    \"\"\"Custom exception for invalid input parameters.\"\"\"\n    pass\ndef is_simple_power(x, n):\n    \"\"\"Your task is to write a function that returns true if a number x is a simple\n    power of n and false in other cases.\n    x is a simple power of n if n**int=x\n    For example:\n    is_simple_power(1, 4) => true\n    is_simple_power(2, 2) => true\n    is_simple_power(8, 2) => true\n    is_simple_power(3, 2) => false\n    is_simple_power(3, 1) => false\n    is_simple_power(5, 3) => false\n    \"\"\"\n    if x < 1 or n < 1:\n        raise InvalidInputError(\"Both x and n must be positive integers (>= 1).\")\n\n    if x == 1:\n        return True # Any n >= 1 raised to the power of 0 is 1.\n\n    if n == 1: # and x > 1\n        return False # 1 raised to any positive power is 1, so x cannot be > 1.\n\n    try:\n        exponent = math.log(x, n)\n    except ValueError:\n        return False # This handles cases like log(negative) or log(base=1) if not caught above.\n\n    return abs(exponent - round(exponent)) < EPSILON"}
{"task_id": "HumanEval/59", "solution": "def largest_prime_factor(n: int) -> int:\n    \"\"\"Calculates the largest prime factor of a given integer n.\n    Assumes n > 1 and n is not a prime number.\n    \"\"\"\n    largest_factor = 1\n    i = 2\n\n    # Divide by 2 until n is odd\n    while n % 2 == 0:\n        largest_factor = 2\n        n //= 2\n\n    # Iterate for odd factors from 3 up to sqrt(n)\n    while i * i <= n:\n        while n % i == 0:\n            largest_factor = i\n            n //= i\n        i += 2\n\n    # If n is still greater than 1, it must be the largest prime factor itself\n    if n > 1:\n        largest_factor = n\n\n    return largest_factor"}
{"task_id": "HumanEval/79", "solution": "def decimal_to_binary(decimal):\n    \"\"\"Converts a decimal number to a specific binary string format.\n    The output string includes 'db' prefix and suffix.\n    \"\"\"\n    if not isinstance(decimal, int) or decimal < 0:\n        raise ValueError(\"Input must be a non-negative integer.\")\n\n    binary_representation = bin(decimal)[2:]\n    return f\"db{binary_representation}db\""}
{"task_id": "HumanEval/78", "solution": "def hex_key(num):\n    \"\"\"Counts prime hexadecimal digits in a given string.\n    Prime digits (2, 3, 5, 7, B, D) are identified by their decimal equivalents.\n    \"\"\"\n    prime_hex_decimal_values = {2, 3, 5, 7, 11, 13}\n    count = 0\n    for char in num:\n        # Convert the hexadecimal character to its decimal equivalent.\n        decimal_value = int(char, 16)\n        # Check if the decimal value is one of the prime hexadecimal values.\n        if decimal_value in prime_hex_decimal_values:\n            count += 1\n    return count"}
{"task_id": "HumanEval/79", "solution": "def decimal_to_binary(decimal: int) -> str:\n    \"\"\"\n    Converts a decimal number to its binary format, prefixed and suffixed with 'db'.\n    Handles non-negative integer inputs; raises ValueError for invalid types or negative numbers.\n    \"\"\"\n    if not isinstance(decimal, int) or decimal < 0:\n        raise ValueError(\"Input must be a non-negative integer.\")\n\n    if decimal == 0:\n        binary_str = \"0\"\n    else:\n        binary_str = bin(decimal)[2:]\n\n    BINARY_PREFIX = \"db\"\n    BINARY_SUFFIX = \"db\"\n    return f\"{BINARY_PREFIX}{binary_str}{BINARY_SUFFIX}\""}
{"task_id": "HumanEval/80", "solution": "def is_happy(s: str) -> bool:\n    \"\"\"Checks if a string is 'happy'. A string is happy if its length is at least 3\n    and every 3 consecutive letters within the string are distinct.\n    \"\"\"\n    if len(s) < 3:\n        return False\n\n    for i in range(len(s) - 2):\n        substring = s[i:i+3]\n        if not (substring[0] != substring[1] and\n                substring[0] != substring[2] and\n                substring[1] != substring[2]):\n            return False\n    return True"}
{"task_id": "HumanEval/78", "solution": "def hex_key(num: str) -> int:\n    \"\"\"Counts prime hexadecimal digits in a given string.\n    Identifies digits 2, 3, 5, 7, B (decimal 11), D (decimal 13).\n    \"\"\"\n    prime_hex_decimal_values = {2, 3, 5, 7, 11, 13}\n    count = 0\n    for char in num:\n        decimal_value = int(char, 16)\n        if decimal_value in prime_hex_decimal_values:\n            count += 1\n    return count"}
