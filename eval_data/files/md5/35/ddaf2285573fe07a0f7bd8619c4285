{"task_id": "HumanEval/157", "solution": "import math\nclass InvalidInputError(Exception):\n    \"\"\"Raised when input types are incorrect.\"\"\"\n    pass\nclass InvalidSideLengthError(Exception):\n    \"\"\"Raised when side lengths are not positive.\"\"\"\n    pass\nclass NotATriangleError(Exception):\n    \"\"\"Raised when side lengths do not form a valid triangle.\"\"\"\n    pass\nclass TriangleSides:\n    \"\"\"A data transfer object to hold the three side lengths of a triangle.\"\"\"\n    def __init__(self, side1: float, side2: float, side3: float):\n        if not all(isinstance(s, (int, float)) for s in [side1, side2, side3]):\n            raise TypeError(\"Side lengths must be numerical.\")\n        self.side1 = float(side1)\n        self.side2 = float(side2)\n        self.side3 = float(side3)\nclass TriangleSolverService:\n    \"\"\"Encapsulates business logic for validating and classifying triangles.\"\"\"\n    _EPSILON = 1e-9 # Tolerance for floating-point comparisons.\n\n    def _is_positive(self, side: float) -> bool:\n        \"\"\"Helper to check if a single side length is positive.\"\"\"\n        return side > 0\n\n    def _satisfies_triangle_inequality(self, s1: float, s2: float, s3: float) -> bool:\n        \"\"\"Helper to check the triangle inequality for three sides.\"\"\"\n        return s1 + s2 > s3\n\n    def is_valid_triangle(self, sides: TriangleSides) -> bool:\n        \"\"\"Validates if sides are positive and satisfy triangle inequality.\"\"\"\n        if not (self._is_positive(sides.side1) and\n                self._is_positive(sides.side2) and\n                self._is_positive(sides.side3)):\n            raise InvalidSideLengthError(\"All side lengths must be positive.\")\n\n        if not (self._satisfies_triangle_inequality(sides.side1, sides.side2, sides.side3) and\n                self._satisfies_triangle_inequality(sides.side2, sides.side3, sides.side1) and\n                self._satisfies_triangle_inequality(sides.side3, sides.side1, sides.side2)):\n            raise NotATriangleError(\"The given side lengths do not form a valid triangle.\")\n        return True\n\n    def is_right_angled(self, sides: TriangleSides) -> bool:\n        \"\"\"Determines if a valid triangle is a right-angled triangle.\"\"\"\n        s = sorted([sides.side1, sides.side2, sides.side3])\n        a, b, c = s[0], s[1], s[2]\n        return math.isclose(a**2 + b**2, c**2, rel_tol=self._EPSILON)\ndef right_angle_triangle(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle. Return True if the three\n    sides form a right-angled triangle, False otherwise.\n    A right-angled triangle is a triangle in which one angle is right angle or \n    90 degree.\n    Example:\n    right_angle_triangle(3, 4, 5) == True\n    right_angle_triangle(1, 2, 3) == False\n    '''\n    try:\n        sides = TriangleSides(a, b, c)\n        solver = TriangleSolverService()\n        solver.is_valid_triangle(sides) \n        return solver.is_right_angled(sides)\n    except (InvalidInputError, InvalidSideLengthError, NotATriangleError, TypeError):\n        return False"}
