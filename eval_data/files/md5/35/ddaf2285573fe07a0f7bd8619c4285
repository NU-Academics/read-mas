{"task_id": "HumanEval/2", "solution": "def truncate_number(number: float) -> float:\n    \"\"\" Given a positive floating point number, it can be decomposed into\n    an integer part (largest integer smaller than given number) and decimals.\n    Return the decimal part of the number.\n    \"\"\"\n    if not isinstance(number, float):\n        raise TypeError(\"Input must be a float.\")\n    if number < 0:\n        raise ValueError(\"Input must be a positive floating-point number.\")\n    \n    integer_part = int(number)\n    decimal_part = number - integer_part\n    return decimal_part"}
{"task_id": "HumanEval/2", "solution": "def truncate_number(number: float) -> float:\n    \"\"\" Given a positive floating point number, it can be decomposed into an integer part and decimals.\n    Return the decimal part of the number.\n    \"\"\"\n    if not isinstance(number, float):\n        raise TypeError(\"Input must be a floating-point number.\")\n    if number < 0:\n        raise ValueError(\"Input number must be positive.\")\n\n    integer_part = float(int(number)) # Calculate the largest integer less than or equal to number.\n    decimal_part = number - integer_part # Subtract the integer part from the original number.\n    return decimal_part"}
{"task_id": "HumanEval/3", "solution": "from typing import List\ndef below_zero(operations: List[int]) -> bool:\n    \"\"\"Calculates the running balance based on operations and checks if it ever drops below zero.\n    Returns True if balance falls below zero at any point, False otherwise.\n    \"\"\"\n    balance = 0\n    for op in operations:\n        balance += op\n        if balance < 0:\n            return True\n    return False"}
{"task_id": "HumanEval/3", "solution": "from typing import List\ndef below_zero(operations: List[int]) -> bool:\n    \"\"\" Detects if a bank account balance falls below zero at any point.\n    The account starts with zero balance.\n    \"\"\"\n    if not isinstance(operations, list):\n        raise TypeError(\"Operations must be a list.\")\n    if not all(isinstance(op, int) for op in operations):\n        raise TypeError(\"All operations must be integers.\")\n\n    balance = 0\n    for op in operations:\n        balance += op\n        if balance < 0:\n            return True\n    return False"}
{"task_id": "HumanEval/4", "solution": "from typing import List\ndef mean_absolute_deviation(numbers: List[float]) -> float:\n    \"\"\"Calculates the Mean Absolute Deviation for a list of numbers.\n    Returns 0.0 for empty or single-element lists.\n    \"\"\"\n    if not numbers or len(numbers) <= 1:\n        return 0.0\n\n    mean = sum(numbers) / len(numbers)\n    absolute_differences = [abs(x - mean) for x in numbers]\n    mad = sum(absolute_differences) / len(absolute_differences)\n    return mad"}
{"task_id": "HumanEval/1", "solution": "from typing import List\ndef separate_paren_groups(paren_string: str) -> List[str]:\n    \"\"\"Separates balanced, non-nested parenthesis groups from a string, ignoring spaces.\n    Returns a list of strings, where each is an independent parenthesis group.\n    \"\"\"\n    cleaned_string = paren_string.replace(\" \", \"\")\n    \n    result: List[str] = []\n    balance: int = 0\n    current_group_start: int = 0\n\n    # Process characters to track balance and identify top-level balanced groups.\n    # When balance returns to zero, a complete, non-nested group is found.\n    for i, char in enumerate(cleaned_string):\n        if char == '(':\n            balance += 1\n        elif char == ')':\n            balance -= 1\n\n        if balance == 0 and i >= current_group_start:\n            group = cleaned_string[current_group_start : i + 1]\n            result.append(group)\n            current_group_start = i + 1\n    \n    return result"}
{"task_id": "HumanEval/0", "solution": "from typing import List\ndef has_close_elements(numbers: List[float], threshold: float) -> bool:\n    \"\"\" Check if in given list of numbers, are any two numbers closer to each other than\n    given threshold.\n    >>> has_close_elements([1.0, 2.0, 3.0], 0.5)\n    False\n    >>> has_close_elements([1.0, 2.8, 3.0, 4.0, 5.0, 2.0], 0.3)\n    True\n    \"\"\"\n    if not isinstance(numbers, list):\n        raise TypeError(\"Input 'numbers' must be a list.\")\n    if not isinstance(threshold, (int, float)):\n        raise TypeError(\"Input 'threshold' must be a float or int.\")\n    if threshold < 0:\n        raise ValueError(\"Threshold cannot be negative.\")\n\n    n = len(numbers)\n    if n < 2:\n        return False\n\n    # This O(N^2) approach processes all pairs.\n    for i in range(n):\n        for j in range(i + 1, n):\n            if abs(numbers[i] - numbers[j]) < threshold:\n                return True\n    return False"}
{"task_id": "HumanEval/0", "solution": "from typing import List\ndef has_close_elements(numbers: List[float], threshold: float) -> bool:\n    \"\"\"\n    Check if in given list of numbers, any two numbers are closer than the threshold.\n    \"\"\"\n    n = len(numbers)\n    if n < 2:\n        return False\n\n    # This uses a nested loop for simplicity.\n    # For larger lists, sorting and checking adjacent elements would be more efficient.\n    for i in range(n):\n        for j in range(i + 1, n):\n            if abs(numbers[i] - numbers[j]) < threshold:\n                return True\n    return False"}
{"task_id": "HumanEval/5", "solution": "from typing import List\ndef intersperse(numbers: List[int], delimeter: int) -> List[int]:\n    \"\"\" Insert a number 'delimeter' between every two consecutive elements of input list `numbers'\n    >>> intersperse([], 4)\n    []\n    >>> intersperse([1, 2, 3], 4)\n    [1, 4, 2, 4, 3]\n    \"\"\"\n    if not numbers:\n        return []\n\n    result = []\n    for i, num in enumerate(numbers):\n        result.append(num)\n        if i < len(numbers) - 1:\n            result.append(delimeter)\n    return result"}
{"task_id": "HumanEval/5", "solution": "from typing import List\ndef intersperse(numbers: List[int], delimeter: int) -> List[int]:\n    \"\"\" Insert a number 'delimeter' between every two consecutive elements of input list `numbers`.\"\"\"\n    if not numbers:\n        return []\n\n    result = []\n    for i, num in enumerate(numbers):\n        result.append(num)\n        if i < len(numbers) - 1:\n            result.append(delimeter)\n    return result"}
{"task_id": "HumanEval/4", "solution": "from typing import List\nclass EmptyInputError(ValueError):\n    \"\"\"Custom exception for empty input lists. Raised when a calculation cannot proceed due to missing data.\"\"\"\n    def __init__(self, message: str = \"Input list cannot be empty.\"):\n        super().__init__(message)\ndef mean_absolute_deviation(numbers: List[float]) -> float:\n    \"\"\"Calculates the Mean Absolute Deviation of a list of numbers.\n    It represents the average variability around the mean of the dataset.\"\"\"\n    if not numbers:\n        raise EmptyInputError(\"Cannot calculate Mean Absolute Deviation for an empty list.\")\n\n    mean = sum(numbers) / len(numbers)\n    absolute_differences = [abs(x - mean) for x in numbers]\n    mad = sum(absolute_differences) / len(absolute_differences)\n    return mad"}
{"task_id": "HumanEval/8", "solution": "from typing import List, Tuple\ndef sum_product(numbers: List[int]) -> Tuple[int, int]:\n    \"\"\"For a given list of integers, return a tuple consisting of a sum and a product of all the integers in a list.\n    Empty sum should be equal to 0 and empty product should be equal to 1.\"\"\"\n    current_sum = 0\n    current_product = 1\n\n    for number in numbers:\n        current_sum += number\n        current_product *= number\n\n    return (current_sum, current_product)"}
{"task_id": "HumanEval/7", "solution": "from typing import List\ndef filter_by_substring(strings: List[str], substring: str) -> List[str]:\n    \"\"\" Filter an input list of strings only for ones that contain given substring\n    >>> filter_by_substring([], 'a')\n    []\n    >>> filter_by_substring(['abc', 'bacd', 'cde', 'array'], 'a')\n    ['abc', 'bacd', 'array']\n    \"\"\"\n    if not isinstance(strings, list):\n        raise TypeError(\"Input 'strings' must be a list.\")\n    if not isinstance(substring, str):\n        raise TypeError(\"Input 'substring' must be a string.\")\n\n    filtered_list = []\n    for s in strings:\n        if not isinstance(s, str):\n            raise TypeError(\"All elements in 'strings' must be strings.\")\n        if substring in s:\n            filtered_list.append(s)\n    return filtered_list"}
{"task_id": "HumanEval/7", "solution": "from typing import List\ndef filter_by_substring(strings: List[str], substring: str) -> List[str]:\n    \"\"\" Filter an input list of strings only for ones that contain given substring\n    >>> filter_by_substring([], 'a')\n    []\n    >>> filter_by_substring(['abc', 'bacd', 'cde', 'array'], 'a')\n    ['abc', 'bacd', 'array']\n    \"\"\"\n    return [s for s in strings if substring in s]"}
{"task_id": "HumanEval/6", "solution": "from typing import List\ndef _calculate_max_depth(group_string: str) -> int:\n    \"\"\"Calculates the deepest level of nesting for a single group of parentheses.\n    Non-parenthesis characters are ignored, and depth never drops below zero.\n    \"\"\"\n    current_depth = 0\n    max_depth = 0\n    for char in group_string:\n        if char == '(':\n            current_depth += 1\n            max_depth = max(max_depth, current_depth)\n        elif char == ')':\n            current_depth = max(0, current_depth - 1)\n    return max_depth\ndef parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\"\n    Parses a string of space-separated parenthesis groups to find the maximum nesting depth for each.\n    An empty input or string with only spaces returns an empty list.\n    \"\"\"\n    if not paren_string.strip():\n        return []\n\n    groups = paren_string.split(' ')\n    results = []\n    for group in groups:\n        if group:\n            results.append(_calculate_max_depth(group))\n    return results"}
{"task_id": "HumanEval/6", "solution": "from typing import List\ndef parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\" Input to this function is a string represented multiple groups for nested parentheses separated by spaces.\n    For each of the group, output the deepest level of nesting of parentheses.\n    E.g. (()()) has maximum two levels of nesting while ((())) has three.\n    \"\"\"\n\n    def _calculate_group_depth(group_str: str) -> int:\n        \"\"\"Calculates the maximum nesting depth for a given parentheses group string.\n        It iterates through characters, tracking current and maximum depths.\n        \"\"\"\n        max_depth = 0\n        current_depth = 0\n        for char in group_str:\n            if char == '(':\n                current_depth += 1\n                max_depth = max(max_depth, current_depth)\n            elif char == ')':\n                current_depth -= 1\n        return max_depth\n\n    if not paren_string.strip():\n        return []\n\n    groups = paren_string.split(' ')\n    results = []\n    for group_string in groups:\n        if group_string:\n            results.append(_calculate_group_depth(group_string))\n    return results"}
{"task_id": "HumanEval/8", "solution": "from typing import List, Tuple\ndef sum_product(numbers: List[int]) -> Tuple[int, int]:\n    \"\"\"\n    For a given list of integers, return a tuple consisting of a sum and a product of all the integers in a list.\n    Empty sum should be equal to 0 and empty product should be equal to 1.\n    \"\"\"\n    current_sum = 0\n    current_product = 1\n\n    for number in numbers:\n        current_sum += number\n        current_product *= number\n\n    return (current_sum, current_product)"}
{"task_id": "HumanEval/12", "solution": "from typing import List, Optional\ndef longest(strings: List[str]) -> Optional[str]:\n    \"\"\"Out of list of strings, return the longest one. Returns the first one in case of a tie.\n    Returns None if the input list is empty.\n    \"\"\"\n    if not strings:\n        return None\n\n    max_length = -1\n    longest_str = None\n\n    for s in strings:\n        if len(s) > max_length:\n            max_length = len(s)\n            longest_str = s\n    return longest_str"}
{"task_id": "HumanEval/11", "solution": "def string_xor(a: str, b: str) -> str:\n    \"\"\"Input are two strings a and b consisting only of 1s and 0s.\n    Perform binary XOR on these inputs and return result also as a string.\n    \"\"\"\n    # Validate that input strings contain only '0' or '1' characters and are not empty (FR2).\n    for s_name, s_value in [(\"a\", a), (\"b\", b)]:\n        if not s_value:\n            raise ValueError(f\"Input string '{s_value}' contains non-binary characters or is empty.\")\n        if any(char not in '01' for char in s_value):\n            raise ValueError(f\"Input string '{s_value}' contains non-binary characters.\")\n\n    # Pad the shorter binary string with leading zeros to match the length of the longer string (FR3).\n    max_length = max(len(a), len(b))\n    padded_a = a.zfill(max_length)\n    padded_b = b.zfill(max_length)\n\n    # Perform a bitwise XOR operation on the two padded binary strings (FR4).\n    result_bits = []\n    for i in range(max_length):\n        bit_a = int(padded_a[i])\n        bit_b = int(padded_b[i])\n        xor_result = bit_a ^ bit_b\n        result_bits.append(str(xor_result))\n    return \"\".join(result_bits) # Return the XOR result as a binary string (FR5)."}
{"task_id": "HumanEval/10", "solution": "def is_palindrome(string: str) -> bool:\n    \"\"\" Test if given string is a palindrome. \"\"\"\n    return string == string[::-1]\ndef make_palindrome(string: str) -> str:\n    \"\"\" Find the shortest palindrome that begins with a supplied string. \"\"\"\n    if not string:\n        return \"\"\n\n    longest_palindromic_postfix_len = 0\n    for i in range(len(string)):\n        suffix = string[i:]\n        if is_palindrome(suffix):\n            longest_palindromic_postfix_len = len(suffix)\n            break\n\n    prefix_to_reverse = string[:-longest_palindromic_postfix_len]\n    return string + prefix_to_reverse[::-1]"}
{"task_id": "HumanEval/11", "solution": "def string_xor(a: str, b: str) -> str:\n    \"\"\" Input are two strings a and b consisting only of 1s and 0s.\n    Perform binary XOR on these inputs and return result also as a string.\n    >>> string_xor('010', '110')\n    '100'\n    \"\"\"\n    if not all(c in '01' for c in a) or not all(c in '01' for c in b):\n        raise ValueError(\"Input strings must contain only '0's and '1's.\")\n\n    max_len = max(len(a), len(b))\n    a_padded = a.zfill(max_len)\n    b_padded = b.zfill(max_len)\n\n    result = []\n    for i in range(max_len):\n        if a_padded[i] != b_padded[i]:\n            result.append('1')\n        else:\n            result.append('0')\n    return \"\".join(result)"}
{"task_id": "HumanEval/12", "solution": "from typing import List, Optional\ndef longest(strings: List[str]) -> Optional[str]:\n    \"\"\"Out of list of strings, return the longest one.\n    Returns the first one in case of multiple strings of the same length, or None if the input is empty.\n    \"\"\"\n    if not strings:\n        return None\n\n    longest_str = strings[0]\n    max_length = len(strings[0])\n\n    for s in strings[1:]:\n        if len(s) > max_length:\n            longest_str = s\n            max_length = len(s)\n    return longest_str"}
{"task_id": "HumanEval/10", "solution": "def is_palindrome(string: str) -> bool:\n    \"\"\" Test if given string is a palindrome. \"\"\"\n    if not isinstance(string, str):\n        raise TypeError(\"Input must be a string.\")\n    return string == string[::-1]\ndef make_palindrome(string: str) -> str:\n    \"\"\" Finds the shortest palindrome beginning with the supplied string. It identifies the longest palindromic suffix and appends the reversed preceding prefix. \"\"\"\n    if not isinstance(string, str):\n        raise TypeError(\"Input must be a string.\")\n    if not string:\n        return \"\"\n\n    for i in range(len(string)):\n        suffix = string[i:]\n        if is_palindrome(suffix):\n            prefix_to_reverse = string[:i]\n            return string + prefix_to_reverse[::-1]"}
{"task_id": "HumanEval/13", "solution": "def greatest_common_divisor(a: int, b: int) -> int:\n    \"\"\"Return the greatest common divisor of two non-negative integers a and b.\n    Raises TypeError for non-integer inputs and ValueError for negative inputs.\n    >>> greatest_common_divisor(3, 5)\n    1\n    >>> greatest_common_divisor(25, 15)\n    5\n    \"\"\"\n    if not isinstance(a, int) or not isinstance(b, int):\n        raise TypeError(\"Inputs must be integers.\")\n    if a < 0 or b < 0:\n        raise ValueError(\"Inputs must be non-negative integers.\")\n\n    while b:\n        a, b = b, a % b\n    return a"}
{"task_id": "HumanEval/13", "solution": "def greatest_common_divisor(a: int, b: int) -> int:\n    \"\"\"\n    Return the greatest common divisor of two integers a and b.\n    Uses the Euclidean algorithm and handles zero/negative inputs.\n    \"\"\"\n    a = abs(a)\n    b = abs(b)\n    while b:\n        a, b = b, a % b\n    return a"}
