{"task_id": "HumanEval/137", "solution": "def compare_one(a, b):\n    \"\"\"\n    Compares two numerical values, returning the larger one with its original type or None if equal.\n    Handles int, float, and string representations with '.' or ',' decimal separators.\n    \"\"\"\n\n    def _convert_to_float(value):\n        \"\"\"\n        Converts a value to float, handling string formats; raises Type/ValueErrors.\n        \"\"\"\n        if isinstance(value, (int, float)):\n            return float(value)\n        elif isinstance(value, str):\n            try:\n                # Replace comma with dot for consistent float conversion.\n                normalized_value = value.replace(',', '.')\n                return float(normalized_value)\n            except ValueError as e:\n                raise ValueError(f\"Invalid string representation of a number: '{value}'\") from e\n        else:\n            raise TypeError(f\"Unsupported type for comparison: {type(value)}\")\n\n    # Convert inputs to a comparable float type using the helper.\n    float_a = _convert_to_float(a)\n    float_b = _convert_to_float(b)\n\n    # Perform comparison based on the float values.\n    if float_a == float_b:\n        return None\n    elif float_a > float_b:\n        return a  # Return original 'a' preserving its type.\n    else:\n        return b  # Return original 'b' preserving its type."}
{"task_id": "HumanEval/138", "solution": "def is_equal_to_sum_even(n):\n    \"\"\"\n    Evaluates if n can be written as the sum of exactly four positive even numbers.\n    The smallest such sum is 8 (2+2+2+2).\n    \"\"\"\n    if not isinstance(n, int):\n        return False\n\n    # A number can be a sum of four positive evens if it's even and at least 8.\n    # This is because any even n >= 8 can be written as 2 + 2 + 2 + (n-6), where (n-6) is also a positive even.\n    return n >= 8 and n % 2 == 0"}
{"task_id": "HumanEval/138", "solution": "def is_equal_to_sum_even(n):\n    \"\"\"Evaluate whether n can be written as the sum of exactly 4 positive even numbers.\n    Raises TypeError if n is not an integer.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"Input 'n' must be an integer.\")\n    return n % 2 == 0 and n >= 8"}
{"task_id": "HumanEval/137", "solution": "from typing import Union, Optional\nclass NumberParser:\n    \"\"\"\n    Utility for parsing number types into a canonical float representation.\n    Handles strings with '.' or ',' decimal separators; raises ValueError for invalid formats.\n    \"\"\"\n    def parse_to_float(self, value: Union[int, float, str]) -> Optional[float]:\n        if value is None:\n            return None\n        if isinstance(value, (int, float)):\n            return float(value)\n        if isinstance(value, str):\n            try:\n                return float(value)\n            except ValueError:\n                try:\n                    return float(value.replace(',', '.'))\n                except ValueError:\n                    raise ValueError(f\"Cannot parse '{value}' to a real number.\")\n        raise TypeError(f\"Unsupported type for parsing: {type(value)}\")\n_number_parser_instance = NumberParser()\ndef compare_one(a: Union[int, float, str], b: Union[int, float, str]) -> Union[int, float, str, None]:\n    \"\"\"\n    Create a function that takes integers, floats, or strings representing\n    real numbers, and returns the larger variable in its given variable type.\n    Return None if the values are equal.\n    Note: If a real number is represented as a string, the floating point might be . or ,\n\n    compare_one(1, 2.5) \u279e 2.5\n    compare_one(1, \"2,3\") \u279e \"2,3\"\n    compare_one(\"5,1\", \"6\") \u279e \"6\"\n    compare_one(\"1\", 1) \u279e None\n    \"\"\"\n    a_numeric = _number_parser_instance.parse_to_float(a)\n    b_numeric = _number_parser_instance.parse_to_float(b)\n\n    if a_numeric is None or b_numeric is None:\n        raise ValueError(\"One or both inputs could not be parsed to a number.\")\n\n    if a_numeric > b_numeric:\n        return a\n    elif b_numeric > a_numeric:\n        return b\n    else:\n        return None"}
