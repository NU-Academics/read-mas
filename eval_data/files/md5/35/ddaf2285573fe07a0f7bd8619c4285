{"task_id": "HumanEval/24", "solution": "def largest_divisor(n: int) -> int:\n    \"\"\"Finds the largest proper divisor of a positive integer `n`. Returns 1 if `n` is 1 or a prime number.\"\"\"\n    if n <= 1:\n        return 1\n\n    for i in range(n // 2, 0, -1):\n        if n % i == 0:\n            return i\n    return 1 # Should only be reached if n is prime and > 1"}
{"task_id": "HumanEval/24", "solution": "def largest_divisor(n: int) -> int:\n    \"\"\"\n    Finds the largest integer that divides n evenly, smaller than n.\n    Raises ValueError if n is not an integer or n is less than or equal to 1.\n    \"\"\"\n    if not isinstance(n, int):\n        raise ValueError(\"Input n must be an integer.\")\n    if n <= 1:\n        raise ValueError(\"Input n must be greater than 1 to have a proper divisor smaller than n.\")\n\n    # Iterate downwards from n-1 to 1 to find the largest proper divisor.\n    for i in range(n - 1, 0, -1):\n        if n % i == 0:\n            return i\n    # This line should theoretically not be reached for n > 1, as 1 is always a divisor.\n    # It ensures a return in all logical paths, though practically unreachable for valid N.\n    return 1"}
{"task_id": "HumanEval/25", "solution": "from typing import List\nclass InvalidInputError(ValueError):\n    \"\"\"Custom exception for invalid input to the factorizer.\"\"\"\n    pass\ndef factorize(n: int) -> List[int]:\n    \"\"\"Returns a list of prime factors for a positive integer `n`, in ascending order and with correct multiplicities.\n    The product of these factors will equal `n`.\n    \"\"\"\n    if not isinstance(n, int) or n <= 0:\n        raise InvalidInputError(\"Input must be a positive integer.\")\n\n    factors = []\n    d = 2\n    temp_n = n\n\n    while d * d <= temp_n:\n        while temp_n % d == 0:\n            factors.append(d)\n            temp_n //= d\n        d += 1\n\n    if temp_n > 1:\n        factors.append(temp_n)\n\n    return factors"}
{"task_id": "HumanEval/26", "solution": "from typing import List\nfrom collections import Counter\ndef remove_duplicates(numbers: List[int]) -> List[int]:\n    \"\"\"From a list of integers, remove all elements that occur more than once.\n    Keep order of elements left the same as in the input.\n    \"\"\"\n    if not numbers:\n        return []\n\n    counts = Counter(numbers)\n\n    # Filter elements that appear exactly once, preserving their original order.\n    result = [num for num in numbers if counts[num] == 1]\n\n    return result"}
{"task_id": "HumanEval/25", "solution": "from typing import List\ndef factorize(n: int) -> List[int]:\n    \"\"\" Return list of prime factors of given integer in the order from smallest to largest.\n    Each of the factors should be listed number of times corresponding to how many times it appeares in factorization.\n    Input number should be equal to the product of all factors\n    >>> factorize(8)\n    [2, 2, 2]\n    >>> factorize(25)\n    [5, 5]\n    >>> factorize(70)\n    [2, 5, 7]\n    \"\"\"\n    factors = []\n    d = 2\n    temp_n = n\n    while d * d <= temp_n:\n        while temp_n % d == 0:\n            factors.append(d)\n            temp_n //= d\n        d += 1\n    if temp_n > 1:\n        factors.append(temp_n)\n    return factors"}
{"task_id": "HumanEval/26", "solution": "from collections import Counter\nfrom typing import List\ndef remove_duplicates(numbers: List[int]) -> List[int]:\n    \"\"\"From a list of integers, remove all elements that occur more than once.\n    The original relative order of the remaining unique elements is preserved.\n    \"\"\"\n    counts = Counter(numbers)\n    result = [num for num in numbers if counts[num] == 1]\n    return result"}
