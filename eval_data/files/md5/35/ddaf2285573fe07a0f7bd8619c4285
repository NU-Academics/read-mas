{"task_id": "HumanEval/62", "solution": "from typing import List, Union\nclass PolynomialError(Exception):\n    \"\"\"Base exception for all errors within the polynomial calculator.\"\"\"\n    pass\nclass InvalidPolynomialInputError(PolynomialError, ValueError):\n    \"\"\"Exception raised when the polynomial input is invalid (e.g., wrong type or non-numeric elements).\"\"\"\n    pass\ndef derivative(xs: List[Union[int, float]]) -> List[Union[int, float]]:\n    \"\"\" xs represent coefficients of a polynomial.\n    xs[0] + xs[1] * x + xs[2] * x^2 + ....\n     Return derivative of this polynomial in the same form.\n    >>> derivative([3, 1, 2, 4, 5])\n    [1, 4, 12, 20]\n    >>> derivative([1, 2, 3])\n    [2, 6]\n    \"\"\"\n    # FR1: Validate that input is a list and contains only numbers.\n    if not isinstance(xs, list):\n        raise InvalidPolynomialInputError(\"Coefficients must be a list.\")\n    if not all(isinstance(c, (int, float)) for c in xs):\n        raise InvalidPolynomialInputError(\"All coefficients must be numbers.\")\n\n    # FR5: If the input list is empty, its derivative is an empty list.\n    if not xs:\n        return []\n\n    # FR4: If the input is a constant polynomial (e.g., [C]), its derivative is [0].\n    if len(xs) == 1:\n        return [0]\n\n    # FR2: Calculate the derivative using the power rule: d(c_i * x^i)/dx = c_i * i * x^(i-1).\n    # The resulting coefficients are for x^0, x^1, x^2, etc., based on original indices.\n    derivative_coeffs = [coeff * index for index, coeff in enumerate(xs[1:], 1)]\n\n    # FR3: Return the calculated derivative coefficients as a list.\n    return derivative_coeffs"}
{"task_id": "HumanEval/64", "solution": "def vowels_count(s: str) -> int:\n    \"\"\"Counts vowels in a string, with 'y' counted only if it's the last character.\"\"\"\n    if not s:\n        return 0\n\n    vowel_count = 0\n    s_lower = s.lower()\n    \n    standard_vowels = {'a', 'e', 'i', 'o', 'u'}\n\n    for i, char in enumerate(s_lower):\n        # Check if the character is a standard vowel.\n        if char in standard_vowels:\n            vowel_count += 1\n        # Check if 'y' should be counted, only if it's the last character.\n        elif char == 'y' and i == len(s_lower) - 1:\n            vowel_count += 1\n            \n    return vowel_count"}
{"task_id": "HumanEval/64", "solution": "def vowels_count(s):\n    \"\"\"Write a function vowels_count which takes a string representing\n    a word as input and returns the number of vowels in the string.\n    Vowels in this case are 'a', 'e', 'i', 'o', 'u'. Here, 'y' is also a\n    vowel, but only when it is at the end of the given word.\n\n    Example:\n    >>> vowels_count(\"abcde\")\n    2\n    >>> vowels_count(\"ACEDY\")\n    3\n    \"\"\"\n    if not isinstance(s, str):\n        raise TypeError(\"Input must be a string.\")\n\n    standard_vowels = {'a', 'e', 'i', 'o', 'u'}\n    s_lower = s.lower()\n    vowel_count = 0\n\n    for char in s_lower:\n        if char in standard_vowels:\n            vowel_count += 1\n\n    if s_lower and s_lower[-1] == 'y':\n        vowel_count += 1\n\n    return vowel_count"}
{"task_id": "HumanEval/66", "solution": "def digitSum(s):\n    \"\"\"\n    Calculates the sum of ASCII values of all uppercase characters in the input string.\n    Raises TypeError if the input is not a string.\n    \"\"\"\n    if not isinstance(s, str):\n        raise TypeError(\"Input must be a string.\")\n\n    total_sum = 0\n    for char in s:\n        if char.isupper():\n            total_sum += ord(char)\n    return total_sum"}
{"task_id": "HumanEval/65", "solution": "def circular_shift(x, shift):\n    \"\"\"\n    Performs a circular right shift on integer digits, returning the result as a string.\n    If the shift amount is greater than or equal to the number of digits, the digits are reversed.\n    \"\"\"\n    s_x = str(x)\n    n = len(s_x)\n\n    if shift >= n:\n        return s_x[::-1]\n    else:\n        effective_shift = shift % n\n        return s_x[n - effective_shift:] + s_x[:n - effective_shift]"}
{"task_id": "HumanEval/66", "solution": "def digitSum(s):\n    \"\"\"\n    Calculates the sum of the ASCII codes of only the upper characters in a string.\n    Returns 0 if the string is empty or contains no uppercase characters.\n    \"\"\"\n    if not isinstance(s, str):\n        raise TypeError(\"Input must be a string.\")\n\n    total_sum = 0\n    for char in s:\n        if char.isupper():\n            total_sum += ord(char)\n    return total_sum"}
{"task_id": "HumanEval/67", "solution": "import re\ndef fruit_distribution(s, n):\n    \"\"\"\n    Calculates the number of mango fruits in a basket based on the count of apples and oranges and the total fruits.\n    It parses the fruit counts from the input string and subtracts them from the total.\n    \"\"\"\n    if not isinstance(s, str) or not isinstance(n, int):\n        raise TypeError(\"Input 's' must be a string and 'n' must be an integer.\")\n    if n < 0:\n        raise ValueError(\"Total fruits 'n' cannot be negative.\")\n\n    # Extracts the numerical value preceding \"apples\".\n    apples_match = re.search(r\"(\\d+)\\s+apples\", s)\n    if apples_match:\n        apples = int(apples_match.group(1))\n    else:\n        raise ValueError(f\"Could not find count for apples in string: {s}\")\n\n    # Extracts the numerical value preceding \"oranges\".\n    oranges_match = re.search(r\"(\\d+)\\s+oranges\", s)\n    if oranges_match:\n        oranges = int(oranges_match.group(1))\n    else:\n        raise ValueError(f\"Could not find count for oranges in string: {s}\")\n\n    total_known_fruits = apples + oranges\n    # Ensures the total known fruits do not exceed the overall total.\n    if total_known_fruits > n:\n        raise ValueError(\"Total known fruits (apples + oranges) cannot exceed total fruits 'n'.\")\n\n    return n - total_known_fruits"}
{"task_id": "HumanEval/68", "solution": "def pluck(arr):\n    \"\"\"\n    Finds the smallest even-valued node and its smallest index in an array of non-negative integers.\n    Returns `[value, index]` or `[]` if no even numbers are found or the array is empty.\n    \"\"\"\n    if not arr:\n        return []\n\n    smallest_even_value = None\n    smallest_even_index = -1\n\n    for index, value in enumerate(arr):\n        if value % 2 == 0:\n            if smallest_even_value is None or value < smallest_even_value:\n                smallest_even_value = value\n                smallest_even_index = index\n            elif value == smallest_even_value and index < smallest_even_index:\n                smallest_even_index = index\n\n    if smallest_even_value is None:\n        return []\n    else:\n        return [smallest_even_value, smallest_even_index]"}
{"task_id": "HumanEval/67", "solution": "import re\nclass FruitCounts:\n    \"\"\"A DTO for apple and orange counts.\n    Holds the extracted counts of apples and oranges.\"\"\"\n    def __init__(self, apples: int, oranges: int):\n        self.apples = apples\n        self.oranges = oranges\nclass FruitParser:\n    \"\"\"Extracts numerical counts of apples and oranges from a string.\n    Uses regex to find numbers preceding \"apples\" and \"oranges\".\"\"\"\n    _APPLE_PATTERN = r\"(\\d+)\\s*apples\"\n    _ORANGE_PATTERN = r\"(\\d+)\\s*oranges\"\n\n    def parse(self, s: str) -> FruitCounts:\n        \"\"\"Parses the input string `s` to find apple and orange counts.\n        Defaults missing fruit counts to 0.\"\"\"\n        apples = 0\n        oranges = 0\n\n        apple_match = re.search(self._APPLE_PATTERN, s)\n        if apple_match:\n            apples = int(apple_match.group(1))\n\n        orange_match = re.search(self._ORANGE_PATTERN, s)\n        if orange_match:\n            oranges = int(orange_match.group(1))\n\n        return FruitCounts(apples=apples, oranges=oranges)\nclass FruitCalculator:\n    \"\"\"Orchestrates parsing and calculates mangoes.\n    Uses a FruitParser instance to extract fruit counts.\"\"\"\n    def __init__(self, parser: FruitParser):\n        self._parser = parser\n\n    def fruit_distribution(self, s: str, n: int) -> int:\n        \"\"\"Calculates mangoes based on string `s` and total fruit count `n`.\n        Ensures the final mango count is non-negative.\"\"\"\n        fruit_counts: FruitCounts = self._parser.parse(s)\n        total_known_fruits = fruit_counts.apples + fruit_counts.oranges\n        mangoes = n - total_known_fruits\n        return max(0, mangoes)\ndef fruit_distribution(s, n):\n    \"\"\"\n    In this task, you will be given a string that represents a number of apples and oranges \n    that are distributed in a basket of fruit this basket contains \n    apples, oranges, and mango fruits. Given the string that represents the total number of \n    the oranges and apples and an integer that represent the total number of the fruits \n    in the basket return the number of the mango fruits in the basket.\n    for examble:\n    fruit_distribution(\"5 apples and 6 oranges\", 19) ->19 - 5 - 6 = 8\n    fruit_distribution(\"0 apples and 1 oranges\",3) -> 3 - 0 - 1 = 2\n    fruit_distribution(\"2 apples and 3 oranges\", 100) -> 100 - 2 - 3 = 95\n    fruit_distribution(\"100 apples and 1 oranges\",120) -> 120 - 100 - 1 = 19\n    \"\"\"\n    parser = FruitParser()\n    calculator = FruitCalculator(parser=parser)\n    return calculator.fruit_distribution(s, n)"}
{"task_id": "HumanEval/69", "solution": "import collections\ndef search(lst):\n    \"\"\"\n    Finds the greatest integer in a list whose frequency is greater than or equal to its value.\n    Returns -1 if no such integer exists.\n    \"\"\"\n    frequencies = collections.Counter(lst)\n\n    qualifying_integers = []\n    for num, freq in frequencies.items():\n        # Input integers are guaranteed to be positive as per business rules.\n        if freq >= num:\n            qualifying_integers.append(num)\n\n    if not qualifying_integers:\n        return -1\n    else:\n        return max(qualifying_integers)"}
{"task_id": "HumanEval/68", "solution": "def pluck(arr):\n    \"\"\"Identifies the smallest even-valued node in an array, prioritizing smaller indices for ties.\n    Returns `[value, index]` or `[]` if no even numbers are found or the array is empty.\"\"\"\n    if not arr:\n        return []\n\n    smallest_even_value = float('inf')\n    smallest_even_index = -1\n\n    for index, value in enumerate(arr):\n        if value % 2 == 0:  # Check if the value is even.\n            if value < smallest_even_value:\n                smallest_even_value = value\n                smallest_even_index = index\n            elif value == smallest_even_value and index < smallest_even_index:\n                # If values are equal, prioritize the one with the smaller index.\n                smallest_even_index = index\n\n    if smallest_even_index != -1:\n        return [smallest_even_value, smallest_even_index]\n    else:\n        return []"}
{"task_id": "HumanEval/69", "solution": "from collections import Counter\ndef search(lst):\n    \"\"\"\n    Finds the greatest integer x in a list where x > 0 and its frequency >= x.\n    Returns -1 if no such integer exists.\n    \"\"\"\n    # The problem statement guarantees a non-empty list of positive integers.\n    # A defensive check for an empty list is included for robustness.\n    if not lst:\n        return -1\n\n    frequencies = Counter(lst)\n    \n    candidates = []\n    for num, freq in frequencies.items():\n        # Check if the number is positive and its frequency meets the condition.\n        if num > 0 and freq >= num:\n            candidates.append(num)\n    \n    if not candidates:\n        return -1\n    \n    return max(candidates)"}
