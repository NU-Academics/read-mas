{"task_id": "HumanEval/108", "solution": "def count_nums(arr):\n    \"\"\"\n    Counts numbers in an array where the sum of digits is greater than 0.\n    For negative numbers, the first digit is negative, others positive (e.g., -123 -> -1 + 2 + 3).\n    \"\"\"\n\n    def _sum_digits(num: int) -> int:\n        \"\"\"\n        Calculates the sum of digits for a number, applying special rules for negative values.\n        Returns the digit sum for the given integer.\n        \"\"\"\n        if num == 0:\n            return 0\n\n        s = str(num)\n        digit_sum = 0\n        if s[0] == '-':\n            # For negative numbers, the first digit is negative.\n            digit_sum -= int(s[1])\n            # Subsequent digits are positive.\n            for digit_char in s[2:]:\n                digit_sum += int(digit_char)\n        else:\n            # For positive numbers, all digits are positive.\n            for digit_char in s:\n                digit_sum += int(digit_char)\n        return digit_sum\n\n    count = 0\n    for num in arr:\n        if _sum_digits(num) > 0:\n            count += 1\n    return count"}
{"task_id": "HumanEval/108", "solution": "def count_nums(arr: list[int]) -> int:\n    \"\"\"\n    Counts numbers in an array whose sum of digits is greater than 0.\n    Handles negative numbers where the first digit contributes negatively.\n    \"\"\"\n\n    def _calculate_sum_of_digits(num: int) -> int:\n        \"\"\"\n        Calculates the sum of digits for an integer according to the specified rule.\n        The first digit of a negative number contributes negatively.\n        \"\"\"\n        if num == 0:\n            return 0\n\n        s = str(num)\n        digit_sum = 0\n\n        if s[0] == '-':\n            # First digit after '-' is negative.\n            digit_sum += -int(s[1])\n            # Sum subsequent digits as positive.\n            for digit_char in s[2:]:\n                digit_sum += int(digit_char)\n        else:\n            # All digits are positive.\n            for digit_char in s:\n                digit_sum += int(digit_char)\n                \n        return digit_sum\n\n    count = 0\n    \n    # Returns 0 if the input array is empty.\n    if not arr:\n        return 0\n\n    for num in arr:\n        # Raises TypeError if an element is not an integer.\n        if not isinstance(num, int):\n            raise TypeError(f\"Expected integer in array, got {type(num).__name__}\")\n        \n        # Calculates the sum of digits for the current number.\n        sum_of_digits = _calculate_sum_of_digits(num)\n        \n        # Increments count if the sum of digits is greater than 0.\n        if sum_of_digits > 0:\n            count += 1\n            \n    return count"}
{"task_id": "HumanEval/109", "solution": "def move_one_ball(arr):\n    \"\"\"We have an array 'arr' of N integers. Determine if it's possible to sort it in non-decreasing order\n    by performing right shift operations. Return True if possible, False otherwise; True for an empty array.\"\"\"\n    if not arr:\n        return True\n\n    n = len(arr)\n    \n    # Find the index of the minimum element, which must be the start of the sorted sequence.\n    min_val = arr[0]\n    min_idx = 0\n    for i in range(1, n):\n        if arr[i] < min_val:\n            min_val = arr[i]\n            min_idx = i\n    \n    # Construct the array after shifting it so the minimum element is at the beginning.\n    shifted_arr = arr[min_idx:] + arr[:min_idx]\n    \n    # Check if this shifted array is sorted in non-decreasing order.\n    for i in range(len(shifted_arr) - 1):\n        if shifted_arr[i] > shifted_arr[i+1]:\n            return False\n    return True"}
{"task_id": "HumanEval/110", "solution": "def exchange(lst1, lst2):\n    \"\"\"Determines if `lst1` can be made entirely even by exchanging elements with `lst2`.\n    Returns \"YES\" if possible, \"NO\" otherwise.\n    \"\"\"\n    odds_in_lst1 = sum(1 for x in lst1 if x % 2 != 0)\n    evens_in_lst2 = sum(1 for x in lst2 if x % 2 == 0)\n\n    if odds_in_lst1 <= evens_in_lst2:\n        return \"YES\"\n    else:\n        return \"NO\""}
{"task_id": "HumanEval/109", "solution": "def move_one_ball(arr: list[int]) -> bool:\n    \"\"\"\n    Determines if an array of unique elements can be sorted in non-decreasing order by\n    performing zero or more right shift operations. Returns True if sortable, False otherwise,\n    and True for an empty array.\n    \"\"\"\n    if not arr:\n        return True\n\n    break_point_index = -1\n    # Identify the single \"break point\" where an element is greater than its successor.\n    for i in range(len(arr) - 1):\n        if arr[i] > arr[i+1]:\n            # If a second break point is found, the array cannot be sorted by one rotation.\n            if break_point_index != -1:\n                return False\n            break_point_index = i\n\n    # If no break point exists, the array is already sorted.\n    if break_point_index == -1:\n        return True\n    \n    # If exactly one break point exists, construct the potential sorted array\n    # by rotating it from the break point.\n    rotated_arr = arr[break_point_index+1:] + arr[:break_point_index+1]\n\n    # Check if this potentially rotated array is actually sorted.\n    for i in range(len(rotated_arr) - 1):\n        if rotated_arr[i] > rotated_arr[i+1]:\n            return False\n\n    return True"}
{"task_id": "HumanEval/110", "solution": "def exchange(lst1, lst2):\n    \"\"\"Determines if lst1 can be made entirely even by exchanging elements with lst2.\n    Returns \"YES\" if possible, \"NO\" otherwise.\"\"\"\n\n    # FR2: Count the number of odd elements in lst1.\n    odd_count_lst1 = sum(1 for x in lst1 if x % 2 != 0)\n\n    # FR3: Count the number of even elements in lst2.\n    even_count_lst2 = sum(1 for x in lst2 if x % 2 == 0)\n\n    # FR4, FR5: Determine if odd_count_lst1 <= even_count_lst2 and return \"YES\" or \"NO\".\n    if odd_count_lst1 <= even_count_lst2:\n        return \"YES\"\n    else:\n        return \"NO\""}
{"task_id": "HumanEval/111", "solution": "from collections import Counter\nfrom typing import Dict\ndef histogram(test: str) -> Dict[str, int]:\n    \"\"\"Given a string of space-separated lowercase letters, return a dictionary of the most frequent letters and their counts.\n    If several letters have the same highest occurrence, all are included.\n    \"\"\"\n    if not test:\n        return {}\n\n    # Split the input string into a list of letters, filtering out empty strings from multiple spaces.\n    letters = [letter for letter in test.split(' ') if letter]\n\n    # If the filtered list of letters is empty (e.g., input was only spaces), return an empty dictionary.\n    if not letters:\n        return {}\n\n    counts = Counter(letters)\n    max_count = max(counts.values())\n\n    # Return letters that match the maximum frequency count.\n    result = {\n        letter: count\n        for letter, count in counts.items()\n        if count == max_count\n    }\n    return result"}
{"task_id": "HumanEval/97", "solution": "def multiply(a, b):\n    \"\"\"Calculates the product of the unit digits of two integers. It extracts the absolute unit digit of each number and then multiplies them.\"\"\"\n    unit_digit_a = abs(a) % 10\n    unit_digit_b = abs(b) % 10\n    return unit_digit_a * unit_digit_b"}
{"task_id": "HumanEval/112", "solution": "def _filter_characters(source: str, chars_to_remove: str) -> str:\n    \"\"\"Removes all characters from 'source' that are present in 'chars_to_remove'.\n    Uses a set for efficient character lookup.\"\"\"\n    result_chars = []\n    chars_set = set(chars_to_remove)\n    for char in source:\n        if char not in chars_set:\n            result_chars.append(char)\n    return \"\".join(result_chars)\ndef _is_palindrome(text: str) -> bool:\n    \"\"\"Checks if the given 'text' string is a palindrome.\n    An empty string is considered a palindrome.\"\"\"\n    return text == text[::-1]\ndef reverse_delete(s: str, c: str) -> tuple[str, bool]:\n    \"\"\"\n    Deletes characters from s that are in c, then checks if the result is a palindrome.\n    Returns a tuple containing the filtered string and the palindrome check result.\n    \"\"\"\n    filtered_string = _filter_characters(s, c)\n    is_palindrome_result = _is_palindrome(filtered_string)\n    return (filtered_string, is_palindrome_result)"}
{"task_id": "HumanEval/111", "solution": "from collections import Counter\ndef histogram(test):\n    \"\"\"Given a string of space-separated lowercase letters, returns a dictionary\n    of letters with the highest repetition and their counts. Handles multiple letters\n    with the same maximum frequency, and returns an empty dict for empty input.\n    \"\"\"\n    if not isinstance(test, str):\n        raise TypeError(\"Input must be a string.\")\n    \n    if not test:\n        return {}\n\n    # Split the input string and filter for valid single lowercase letters.\n    all_words = test.split(' ')\n    valid_letters = [word for word in all_words if len(word) == 1 and 'a' <= word <= 'z']\n\n    # Count occurrences of each valid letter using collections.Counter.\n    counts = dict(Counter(valid_letters))\n\n    # Determine the maximum frequency, returning 0 if no letters were counted.\n    max_frequency = max(counts.values()) if counts else 0\n\n    # Filter the counts to include only letters that match the maximum frequency.\n    if max_frequency == 0:\n        return {}\n    \n    return {letter: count for letter, count in counts.items() if count == max_frequency}"}
{"task_id": "HumanEval/112", "solution": "def reverse_delete(s, c):\n    \"\"\"Deletes characters from s found in c, then checks if the result is a palindrome.\n    Returns the filtered string and a boolean indicating if it's a palindrome.\"\"\"\n\n    # Helper function to remove characters present in `chars_to_remove` from `text`.\n    def _filter_string_internal(text: str, chars_to_remove: str) -> str:\n        return \"\".join(char for char in text if char not in chars_to_remove)\n\n    # Helper function to determine if a string is a palindrome.\n    def _is_palindrome_internal(text: str) -> bool:\n        return text == text[::-1]\n\n    filtered_s = _filter_string_internal(s, c)\n    is_palindrome = _is_palindrome_internal(filtered_s)\n    return (filtered_s, is_palindrome)"}
{"task_id": "HumanEval/98", "solution": "def count_upper(s):\n    \"\"\"\n    Counts uppercase vowels at even indices in a string.\n    Raises TypeError if input is not a string.\n    \"\"\"\n    if not isinstance(s, str):\n        raise TypeError(\"Input must be a string.\")\n\n    UPPERCASE_VOWELS = {'A', 'E', 'I', 'O', 'U'}\n    count = 0\n\n    for i in range(0, len(s), 2):\n        char = s[i]\n        if char in UPPERCASE_VOWELS:\n            count += 1\n\n    return count"}
{"task_id": "HumanEval/113", "solution": "def odd_count(lst: list[str]) -> list[str]:\n    \"\"\"\n    Counts odd digits in each string of a list and formats output strings.\n    Each input string is guaranteed to consist solely of digits.\n    \"\"\"\n    results = []\n    # This template is used to construct the output string for each input.\n    output_template = \"the number of odd elements in the string i of the input.\"\n\n    for digit_string in lst:\n        odd_digit_count = 0\n        for digit_char in digit_string:\n            if int(digit_char) % 2 != 0:\n                odd_digit_count += 1\n        \n        # Replace all occurrences of 'i' in the template with the calculated count.\n        formatted_string = output_template.replace('i', str(odd_digit_count))\n        results.append(formatted_string)\n        \n    return results"}
{"task_id": "HumanEval/114", "solution": "def minSubArraySum(nums: list[int]) -> int:\n    \"\"\"\n    Finds the minimum sum of any non-empty sub-array of nums.\n    \"\"\"\n    if not nums:\n        raise ValueError(\"Input array 'nums' cannot be empty.\")\n\n    min_so_far = nums[0]\n    current_min = nums[0]\n\n    for i in range(1, len(nums)):\n        current_min = min(nums[i], current_min + nums[i])\n        min_so_far = min(min_so_far, current_min)\n\n    return min_so_far"}
{"task_id": "HumanEval/113", "solution": "def odd_count(lst):\n    \"\"\"Given a list of strings, where each string consists of only digits, return a list.\n    Each element i of the output should be \"the number of odd elements in the\n    string i of the input.\" where all the i's should be replaced by the number\n    of odd digits in the i'th string of the input.\n\n    >>> odd_count(['1234567'])\n    [\"the number of odd elements 4n the str4ng 4 of the 4nput.\"]\n    >>> odd_count(['3',\"11111111\"])\n    [\"the number of odd elements 1n the str1ng 1 of the 1nput.\",\n     \"the number of odd elements 8n the str8ng 8 of the 8nput.\"]\n    \"\"\"\n    _ODD_COUNT_FORMAT_STRING = \"the number of odd elements {count}n the str{count}ng {count} of the {count}nput.\"\n\n    def _count_odd_digits_in_string(digit_string: str) -> int:\n        \"\"\"Counts the number of odd digits in a given digit string.\n        Assumes the input string contains only digit characters.\n        \"\"\"\n        odd_count_val = 0\n        for char_digit in digit_string:\n            digit = int(char_digit)\n            if digit % 2 != 0:\n                odd_count_val += 1\n        return odd_count_val\n\n    results = []\n    for digit_string in lst:\n        odd_digit_count = _count_odd_digits_in_string(digit_string)\n        formatted_string = _ODD_COUNT_FORMAT_STRING.format(count=odd_digit_count)\n        results.append(formatted_string)\n    return results"}
{"task_id": "HumanEval/114", "solution": "def minSubArraySum(nums: list[int]) -> int:\n    \"\"\"\n    Given an array of integers nums, find the minimum sum of any non-empty sub-array\n    of nums.\n    \"\"\"\n    if not isinstance(nums, list):\n        raise TypeError(\"Input 'nums' must be a list.\")\n    if not nums:\n        raise ValueError(\"Input 'nums' cannot be empty.\")\n    if not all(isinstance(x, int) for x in nums):\n        raise TypeError(\"All elements in 'nums' must be integers.\")\n\n    min_so_far = float('inf')\n    current_min = 0\n\n    for x in nums:\n        current_min += x\n        min_so_far = min(min_so_far, current_min)\n        # If current_min is positive, it's better to discard it and start a new subarray.\n        if current_min > 0:\n            current_min = 0\n            \n    return min_so_far"}
{"task_id": "HumanEval/115", "solution": "import math\ndef max_fill(grid: list[list[int]], capacity: int) -> int:\n    \"\"\"\n    Calculates the total number of times buckets need to be lowered to empty all wells.\n    \"\"\"\n    if not isinstance(grid, list):\n        raise TypeError(\"Grid must be a list.\")\n    if not isinstance(capacity, int) or capacity < 1:\n        raise ValueError(\"Capacity must be a positive integer.\")\n\n    total_operations = 0\n    for well_row in grid:\n        if not isinstance(well_row, list):\n            raise TypeError(\"Each well in the grid must be a list.\")\n        \n        water_units = sum(well_row) # Sums water units, relies on grid[i][j] being 0 or 1.\n        \n        if water_units == 0:\n            operations_for_well = 0\n        else:\n            operations_for_well = math.ceil(water_units / capacity)\n        \n        total_operations += operations_for_well\n    \n    return total_operations"}
