{"task_id": "HumanEval/36", "solution": "def fizz_buzz(n: int) -> int:\n    \"\"\"\n    Return the total occurrences of digit 7 in numbers less than n,\n    which are divisible by 11 or 13.\n    \"\"\"\n    DIGIT_TO_COUNT = 7\n    DIVISOR_ONE = 11\n    DIVISOR_TWO = 13\n\n    if not isinstance(n, int) or n <= 0:\n        raise ValueError(\"Input 'n' must be a positive integer.\")\n\n    total_count = 0\n    for num in range(1, n):\n        is_divisible = (num % DIVISOR_ONE == 0) or (num % DIVISOR_TWO == 0)\n        if is_divisible:\n            count_in_num = str(num).count(str(DIGIT_TO_COUNT))\n            total_count += count_in_num\n    return total_count"}
{"task_id": "HumanEval/39", "solution": "import math\nfrom typing import Generator\ndef _is_prime(num: int) -> bool:\n    \"\"\"Checks if a number is prime using trial division.\n    Numbers less than 2 are not prime.\"\"\"\n    if num < 2:\n        return False\n    for i in range(2, int(math.sqrt(num)) + 1):\n        if num % i == 0:\n            return False\n    return True\ndef prime_fib(n: int) -> int:\n    \"\"\"\n    prime_fib returns n-th number that is a Fibonacci number and it's also prime.\n    Raises ValueError if n is not a positive integer.\n    \"\"\"\n    if not isinstance(n, int) or n <= 0:\n        raise ValueError(\"Input 'n' must be a positive integer.\")\n\n    fib_generator = _generate_fibonacci_sequence()\n    prime_fib_count = 0\n    next(fib_generator) # Skip 0\n    next(fib_generator) # Skip 1 (first 1)\n\n    while True:\n        current_fib = next(fib_generator)\n        if _is_prime(current_fib):\n            prime_fib_count += 1\n            if prime_fib_count == n:\n                return current_fib"}
{"task_id": "HumanEval/38", "solution": "def decode_cyclic(s: str) -> str:\n    \"\"\"\n    Takes as input a string encoded with encode_cyclic. Returns the decoded string.\n    Groups of three characters are reverse-cyclically shifted back to their original order.\n    \"\"\"\n    if not isinstance(s, str):\n        raise TypeError(\"Input must be a string.\")\n\n    groups = [s[(3 * i):min((3 * i + 3), len(s))] for i in range((len(s) + 2) // 3)]\n    decoded_groups = []\n    for group in groups:\n        if len(group) == 3:\n            # Reverse cyclic shift: \"bca\" -> \"abc\"\n            decoded_groups.append(group[2] + group[0] + group[1])\n        else:\n            decoded_groups.append(group)\n    return \"\".join(decoded_groups)"}
{"task_id": "HumanEval/39", "solution": "import math\nfrom typing import Iterator\nclass MathUtils:\n    \"\"\"\n    Provides mathematical utility functions like primality testing and Fibonacci sequence generation.\n    This class handles core mathematical operations.\n    \"\"\"\n    def is_prime(self, num: int) -> bool:\n        \"\"\"\n        Checks if a given number is prime.\n        It uses an optimized approach for primality testing.\n        \"\"\"\n        if num < 2:\n            return False\n        if num == 2:\n            return True\n        if num % 2 == 0:\n            return False\n        # Checks for odd divisors up to the square root of the number.\n        for i in range(3, int(math.sqrt(num)) + 1, 2):\n            if num % i == 0:\n                return False\n        return True\n\n    def generate_fibonacci_sequence(self) -> Iterator[int]:\n        \"\"\"\n        Generates an infinite sequence of Fibonacci numbers, starting with 0, 1.\n        It yields the next Fibonacci number in each iteration.\n        \"\"\"\n        a, b = 0, 1\n        while True:\n            yield a\n            a, b = b, a + b\nclass PrimeFibCalculator:\n    \"\"\"\n    Orchestrates finding the Nth number that is both a Fibonacci number and a prime number.\n    It uses MathUtils to perform primality tests and generate Fibonacci numbers.\n    \"\"\"\n    def __init__(self, math_utils: MathUtils):\n        \"\"\"\n        Initializes the calculator with a MathUtils instance.\n        This allows delegation of mathematical operations.\n        \"\"\"\n        self._math_utils = math_utils\n\n    def prime_fib(self, n: int) -> int:\n        \"\"\"\n        Calculates and returns the Nth prime Fibonacci number.\n        It iteratively checks Fibonacci numbers for primality.\n        \"\"\"\n        if not isinstance(n, int) or n <= 0:\n            raise ValueError(\"Input 'n' must be a positive integer.\")\n\n        prime_fib_count = 0\n        fib_generator = self._math_utils.generate_fibonacci_sequence()\n\n        while True:\n            fib_num = next(fib_generator)\n            if self._math_utils.is_prime(fib_num):\n                prime_fib_count += 1\n                if prime_fib_count == n:\n                    return fib_num\ndef prime_fib(n: int) -> int:\n    \"\"\"\n    Returns the n-th number that is both a Fibonacci number and a prime number.\n    This function acts as an entry point, using internal classes for computation.\n    \"\"\"\n    math_utils_instance = MathUtils()\n    calculator_instance = PrimeFibCalculator(math_utils_instance)\n    return calculator_instance.prime_fib(n)"}
{"task_id": "HumanEval/41", "solution": "def car_race_collision(n: int) -> int:\n    \"\"\"\n    Calculates the number of collisions between n cars moving left-to-right\n    and n cars moving right-to-left on an infinitely long line.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"Input 'n' must be an integer.\")\n    if n < 0:\n        raise ValueError(\"Input 'n' cannot be negative.\")\n    return n * n"}
{"task_id": "HumanEval/40", "solution": "import itertools\ndef triples_sum_to_zero(l: list):\n    \"\"\"\n    triples_sum_to_zero takes a list of integers as an input.\n    it returns True if there are three distinct elements in the list that\n    sum to zero, and False otherwise.\n\n    >>> triples_sum_to_zero([1, 3, 5, 0])\n    False\n    >>> triples_sum_to_zero([1, 3, -2, 1])\n    True\n    >>> triples_sum_to_zero([1, 2, 3, 7])\n    False\n    >>> triples_sum_to_zero([2, 4, -5, 3, 9, 7])\n    True\n    >>> triples_sum_to_zero([1])\n    False\n    \"\"\"\n    # Validate input: ensure 'l' is a list.\n    if not isinstance(l, list):\n        raise TypeError(\"Input must be a list.\")\n    # Validate input: ensure all elements are integers.\n    for item in l:\n        if not isinstance(item, int):\n            raise TypeError(\"All elements in the list must be integers.\")\n\n    if len(l) < 3:\n        return False\n\n    # Iterate through all unique combinations of three distinct indices.\n    for i, j, k in itertools.combinations(range(len(l)), 3):\n        if l[i] + l[j] + l[k] == 0:\n            return True\n    return False"}
