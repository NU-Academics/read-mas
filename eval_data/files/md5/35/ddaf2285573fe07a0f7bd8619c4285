{"task_id": "HumanEval/81", "solution": "GRADING_SCALE = [\n    (4.0, \"A+\"),\n    (3.7, \"A\"),\n    (3.3, \"A-\"),\n    (3.0, \"B+\"),\n    (2.7, \"B\"),\n    (2.3, \"B-\"),\n    (2.0, \"C+\"),\n    (1.7, \"C\"),\n    (1.3, \"C-\"),\n    (1.0, \"D+\"),\n    (0.7, \"D\"),\n    (0.0, \"D-\"),\n    (-float('inf'), \"E\") # Catches any GPA equal to or less than 0.0.\n]\ndef numerical_letter_grade(grades):\n    \"\"\"Converts a list of numerical GPAs into a corresponding list of letter grades.\n    The conversion follows a predefined grading scale, handling various GPA ranges.\n    \"\"\"\n\n    def _get_letter_grade(gpa: float) -> str:\n        \"\"\"Determines the letter grade for a single GPA based on the GRADING_SCALE.\"\"\"\n        for min_gpa, letter_grade in GRADING_SCALE:\n            if gpa >= min_gpa:\n                return letter_grade\n        return \"E\" # Fallback, though the GRADING_SCALE should cover all cases.\n\n    return [_get_letter_grade(gpa) for gpa in grades]"}
{"task_id": "HumanEval/84", "solution": "def solve(N: int) -> str:\n    \"\"\"Given a positive integer N, return the total sum of its digits in binary.\n    The input N is guaranteed to be within the range 0 <= N <= 10000.\n    \"\"\"\n    decimal_sum = 0\n    # Iterate through the decimal digits of N and accumulate their sum.\n    for digit_char in str(N):\n        decimal_sum += int(digit_char)\n\n    # Convert the calculated decimal sum into its binary string representation.\n    # The [2:] slices off the \"0b\" prefix from Python's bin() function output.\n    # Handle the special case where decimal_sum is 0, as bin(0) returns '0b0',\n    # and [2:] would result in '0' which is correct.\n    return bin(decimal_sum)[2:]"}
{"task_id": "HumanEval/83", "solution": "class InvalidInputError(ValueError):\n    \"\"\"Custom exception for invalid input parameters.\"\"\"\n    pass\ndef starts_one_ends(n: int) -> int:\n    \"\"\"\n    Given a positive integer n, return the count of the numbers of n-digit\n    positive integers that start or end with 1.\n    \"\"\"\n    if not isinstance(n, int) or n < 1:\n        raise InvalidInputError(\"Input 'n' must be a positive integer.\")\n\n    if n == 1:\n        # Only '1' starts or ends with 1 among 1-digit numbers (1-9).\n        return 1\n\n    # Calculate count of numbers starting with 1.\n    count_starts_with_1 = 10**(n - 1)\n\n    # Calculate count of numbers ending with 1.\n    count_ends_with_1 = 9 * (10**(n - 2))\n\n    # Calculate count of numbers starting AND ending with 1 (overlap).\n    count_starts_and_ends_with_1 = 10**(n - 2)\n\n    return count_starts_with_1 + count_ends_with_1 - count_starts_and_ends_with_1"}
{"task_id": "HumanEval/83", "solution": "def starts_one_ends(n):\n    \"\"\"\n    Calculates the count of n-digit positive integers that start or end with 1.\n    Uses the principle of inclusion-exclusion for the final calculation.\n    \"\"\"\n    # Calculate count of n-digit numbers starting with 1 (FR2)\n    if n == 1:\n        count_start = 1\n    else:\n        count_start = 10**(n - 1)\n\n    # Calculate count of n-digit numbers ending with 1 (FR3)\n    if n == 1:\n        count_end = 1\n    else:\n        count_end = 9 * (10**(n - 2))\n\n    # Calculate count of n-digit numbers starting AND ending with 1 (FR4)\n    if n == 1:\n        count_both = 1\n    elif n == 2:\n        count_both = 1\n    else:\n        count_both = 10**(n - 2)\n\n    # Calculate final count using inclusion-exclusion (FR5)\n    total_count = count_start + count_end - count_both\n    return total_count"}
{"task_id": "HumanEval/81", "solution": "EPSILON = 1e-9\nGRADING_SCALE = [\n    (4.0, \"A+\"),\n    (3.7 + EPSILON, \"A\"),\n    (3.3 + EPSILON, \"A-\"),\n    (3.0 + EPSILON, \"B+\"),\n    (2.7 + EPSILON, \"B\"),\n    (2.3 + EPSILON, \"B-\"),\n    (2.0 + EPSILON, \"C+\"),\n    (1.7 + EPSILON, \"C\"),\n    (1.3 + EPSILON, \"C-\"),\n    (1.0 + EPSILON, \"D+\"),\n    (0.7 + EPSILON, \"D\"),\n    (0.0 + EPSILON, \"D-\"),\n    (0.0, \"E\"),\n    (-float('inf'), \"E\")\n]\ndef numerical_letter_grade(grades):\n    \"\"\"Converts a list of GPAs to a list of letter grades.\n    It applies a predefined grading scale using a highest-to-lowest threshold comparison.\n    \"\"\"\n    \n    def _get_letter_grade(gpa: float) -> str:\n        \"\"\"Determines the letter grade for a single GPA based on the GRADING_SCALE.\"\"\"\n        for threshold, grade in GRADING_SCALE:\n            if gpa >= threshold:\n                return grade\n        return \"E\" # Fallback, though -inf should catch all lower values.\n\n    return [_get_letter_grade(gpa) for gpa in grades]"}
