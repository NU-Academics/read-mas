{"task_id": "HumanEval/91", "solution": "import re\nclass TextParser:\n    def split_into_sentences(self, text: str) -> list[str]:\n        \"\"\"Splits text into sentences using '.', '?', '!' as delimiters.\n        Handles various whitespace and consecutive delimiters gracefully.\"\"\"\n        if not isinstance(text, str):\n            raise TypeError(\"Input must be a string.\")\n        \n        sentences = re.split(r'(?<=[.?!])\\s*', text)\n        return [s.strip() for s in sentences if s.strip()]\nclass BoredomCounter:\n    def __init__(self, text_parser: TextParser = None):\n        \"\"\"Initializes BoredomCounter with an optional TextParser instance.\"\"\"\n        self._text_parser = text_parser if text_parser is not None else TextParser()\n\n    def count_boredoms(self, text: str) -> int:\n        \"\"\"Counts sentences starting with 'I' (boredoms) in the given text.\n        It uses TextParser to segment the text into sentences.\"\"\"\n        if not isinstance(text, str):\n            raise TypeError(\"Input must be a string.\")\n\n        sentences = self._text_parser.split_into_sentences(text)\n        boredom_count = 0\n        for sentence in sentences:\n            stripped_sentence = sentence.strip()\n            # Check if the sentence starts with \"I \" or is exactly \"I\".\n            if stripped_sentence.startswith(\"I \") or stripped_sentence == \"I\":\n                boredom_count += 1\n        return boredom_count\ndef is_bored(S: str) -> int:\n    \"\"\"Counts the number of boredoms in a string.\n    A boredom is a sentence that starts with the word \"I\".\"\"\"\n    counter = BoredomCounter()\n    return counter.count_boredoms(S)"}
