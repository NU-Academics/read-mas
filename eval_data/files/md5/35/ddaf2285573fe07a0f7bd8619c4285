{"task_id": "HumanEval/130", "solution": "class InvalidInputError(ValueError):\n    \"\"\"Custom exception for invalid input values.\"\"\"\n    pass\nclass TribonacciCalculator:\n    \"\"\"Manages Tribonacci term calculation with memoization.\"\"\"\n    def __init__(self):\n        self._memo: dict[int, int] = {}\n\n    def _calculate_term(self, k: int) -> int:\n        \"\"\"Recursively computes the k-th Tribonacci term using memoization.\"\"\"\n        if k < 0:\n            raise InvalidInputError(\"Tribonacci term index cannot be negative.\")\n        if k in self._memo:\n            return self._memo[k]\n\n        if k == 0:\n            result = 1\n        elif k == 1:\n            result = 3\n        elif k % 2 == 0:  # k is even and k > 0\n            result = 1 + k // 2\n        else:  # k is odd and k > 1\n            # tri(k) depends on tri(k+1) for odd k.\n            term_n_minus_1 = self._calculate_term(k - 1)\n            term_n_minus_2 = self._calculate_term(k - 2)\n            term_n_plus_1 = self._calculate_term(k + 1)\n            result = term_n_minus_1 + term_n_minus_2 + term_n_plus_1\n\n        self._memo[k] = result\n        return result\n\n    def get_sequence(self, n: int) -> list[int]:\n        \"\"\"Computes and returns a list of the first n + 1 Tribonacci numbers.\"\"\"\n        if n < 0:\n            raise InvalidInputError(\"Input 'n' cannot be negative.\")\n\n        # Determine the maximum k needed for calculation; for odd n > 1, tri(n) depends on tri(n+1).\n        max_k_to_calculate = n + 1 if n % 2 != 0 and n > 1 else n\n\n        # Ensure all necessary terms up to max_k_to_calculate are computed.\n        for i in range(max_k_to_calculate + 1):\n            self._calculate_term(i)\n\n        # Construct the result list from memoized values up to n.\n        return [self._memo[i] for i in range(n + 1)]\ndef tri(n: int) -> list[int]:\n    \"\"\"\n    Calculates the first n + 1 numbers of the Tribonacci sequence.\n    Raises InvalidInputError if n is negative.\n    \"\"\"\n    if n < 0:\n        raise InvalidInputError(\"Input 'n' must be a non-negative integer.\")\n\n    calculator = TribonacciCalculator()\n    return calculator.get_sequence(n)"}
{"task_id": "HumanEval/131", "solution": "def digits(n):\n    \"\"\"Given a positive integer n, return the product of its odd digits.\n    Returns 0 if all digits are even, otherwise the product of the odd digits.\n    \"\"\"\n    if not isinstance(n, int) or n <= 0:\n        raise ValueError(\"Input must be a positive integer.\")\n\n    product = 1\n    found_odd_digit = False\n\n    for char_digit in str(n):\n        digit = int(char_digit)\n        if digit % 2 != 0:\n            product *= digit\n            found_odd_digit = True\n\n    return product if found_odd_digit else 0"}
{"task_id": "HumanEval/129", "solution": "import heapq\nclass InvalidGridError(ValueError):\n    \"\"\"Raised when the input grid is invalid.\"\"\"\n    pass\ndef validate_grid(grid_data: list[list[int]]) -> int:\n    \"\"\"Validates the input grid structure and content.\"\"\"\n    if not isinstance(grid_data, list) or not grid_data:\n        raise InvalidGridError(\"Grid must be a non-empty list of lists.\")\n\n    N = len(grid_data)\n    if N < 2:\n        raise InvalidGridError(\"Grid dimension N must be at least 2.\")\n\n    expected_values = set(range(1, N * N + 1))\n    found_values = set()\n\n    for row_idx, row in enumerate(grid_data):\n        if not isinstance(row, list) or len(row) != N:\n            raise InvalidGridError(\"Grid must be square (N x N).\")\n        for col_idx, value in enumerate(row):\n            if not isinstance(value, int):\n                raise InvalidGridError(f\"Grid cell ({row_idx}, {col_idx}) contains non-integer value.\")\n            if value in found_values:\n                raise InvalidGridError(f\"Duplicate value {value} found in grid.\")\n            if value not in expected_values:\n                raise InvalidGridError(f\"Value {value} is out of expected range [1, {N*N}] or missing from expected set.\")\n            found_values.add(value)\n    \n    if found_values != expected_values:\n        raise InvalidGridError(f\"Grid values are not unique or do not cover range [1, {N*N}]. Missing values: {expected_values - found_values}\")\n\n    return N\nclass Grid:\n    \"\"\"Represents the immutable grid structure.\"\"\"\n    def __init__(self, grid_data: list[list[int]]):\n        self._data = grid_data\n        self._N = len(grid_data)\n\n    def get_value(self, row: int, col: int) -> int:\n        \"\"\"Returns the value at the specified coordinates.\"\"\"\n        return self._data[row][col]\n\n    def get_neighbors(self, row: int, col: int) -> list[tuple[int, int]]:\n        \"\"\"Returns a list of valid (row, col) coordinates for neighbors.\"\"\"\n        neighbors = []\n        directions = [(0, 1), (0, -1), (1, 0), (-1, 0)] # Right, Left, Down, Up\n        for dr, dc in directions:\n            new_row, new_col = row + dr, col + dc\n            if 0 <= new_row < self._N and 0 <= new_col < self._N:\n                neighbors.append((new_row, new_col))\n        return neighbors\n\n    def get_N(self) -> int:\n        \"\"\"Returns the dimension N of the grid.\"\"\"\n        return self._N\nclass Path:\n    \"\"\"Represents a sequence of cell values forming a path.\"\"\"\n    def __init__(self, values: list[int], last_cell_coords: tuple[int, int]):\n        self._values = values\n        self._last_cell_coords = last_cell_coords\n\n    def __lt__(self, other: 'Path') -> bool:\n        \"\"\"Compares two paths lexicographically.\"\"\"\n        return self._values < other._values\n\n    def get_values(self) -> list[int]:\n        \"\"\"Returns the list of values in the path.\"\"\"\n        return self._values\n\n    def get_last_cell_coords(self) -> tuple[int, int]:\n        \"\"\"Returns the coordinates of the last cell in the path.\"\"\"\n        return self._last_cell_coords\n\n    def get_length(self) -> int:\n        \"\"\"Returns the current length of the path.\"\"\"\n        return len(self._values)\n\n    def append(self, cell_value: int, cell_coords: tuple[int, int]) -> 'Path':\n        \"\"\"Returns a new Path object with the given cell appended.\"\"\"\n        new_values = self._values + [cell_value]\n        return Path(new_values, cell_coords)\nclass GridSolver:\n    \"\"\"Orchestrates the search for the lexicographically smallest path.\"\"\"\n    def find_min_path(self, grid: Grid, k: int) -> list[int]:\n        \"\"\"Implements the core BFS-like algorithm using a priority queue.\"\"\"\n        priority_queue = [] # Stores Path objects.\n\n        # Initialize with all possible starting cells.\n        for r in range(grid.get_N()):\n            for c in range(grid.get_N()):\n                initial_path = Path([grid.get_value(r, c)], (r, c))\n                heapq.heappush(priority_queue, initial_path)\n\n        while priority_queue:\n            current_path = heapq.heappop(priority_queue)\n\n            if current_path.get_length() == k:\n                return current_path.get_values()\n\n            if current_path.get_length() < k:\n                last_row, last_col = current_path.get_last_cell_coords()\n                for next_row, next_col in grid.get_neighbors(last_row, last_col):\n                    next_value = grid.get_value(next_row, next_col)\n                    new_path = current_path.append(next_value, (next_row, next_col))\n                    heapq.heappush(priority_queue, new_path)\n        \n        # This part should theoretically not be reached given problem constraints.\n        return []\ndef minPath(grid: list[list[int]], k: int) -> list[int]:\n    \"\"\"\n    Given a grid with N rows and N columns (N >= 2) and a positive integer k, \n    each cell of the grid contains a value. Every integer in the range [1, N * N]\n    inclusive appears exactly once on the cells of the grid.\n\n    You have to find the minimum path of length k in the grid. You can start\n    from any cell, and in each step you can move to any of the neighbor cells,\n    in other words, you can go to cells which share an edge with you current\n    cell.\n    Please note that a path of length k means visiting exactly k cells (not\n    necessarily distinct).\n    You CANNOT go off the grid.\n    A path A (of length k) is considered less than a path B (of length k) if\n    after making the ordered lists of the values on the cells that A and B go\n    through (let's call them lst_A and lst_B), lst_A is lexicographically less\n    than lst_B, in other words, there exist an integer index i (1 <= i <= k)\n    such that lst_A[i] < lst_B[i] and for any j (1 <= j < i) we have\n    lst_A[j] = lst_B[j].\n    It is guaranteed that the answer is unique.\n    Return an ordered list of the values on the cells that the minimum path go through.\n\n    Examples:\n\n        Input: grid = [ [1,2,3], [4,5,6], [7,8,9]], k = 3\n        Output: [1, 2, 1]\n\n        Input: grid = [ [5,9,3], [4,1,6], [7,8,2]], k = 1\n        Output: [1]\n    \"\"\"\n    N = validate_grid(grid)\n    validate_k(k, N)\n\n    grid_obj = Grid(grid)\n    solver = GridSolver()\n    return solver.find_min_path(grid_obj, k)"}
{"task_id": "HumanEval/130", "solution": "def tri(n):\n    \"\"\"Everyone knows Fibonacci sequence, it was studied deeply by mathematicians in \n    the last couple centuries. However, what people don't know is Tribonacci sequence.\n    Tribonacci sequence is defined by the recurrence:\n    tri(1) = 3\n    tri(n) = 1 + n / 2, if n is even.\n    tri(n) =  tri(n - 1) + tri(n - 2) + tri(n + 1), if n is odd.\n    For example:\n    tri(2) = 1 + (2 / 2) = 2\n    tri(4) = 3\n    tri(3) = tri(2) + tri(1) + tri(4)\n           = 2 + 3 + 3 = 8 \n    You are given a non-negative integer number n, you have to a return a list of the \n    first n + 1 numbers of the Tribonacci sequence.\n    Examples:\n    tri(3) = [1, 3, 2, 8]\n    \"\"\"\n    if n == 0:\n        return [1]\n    if n == 1:\n        return [1, 3]\n\n    trib_sequence = [1, 3]  # Initialize with tri(0) and tri(1)\n\n    for i in range(2, n + 1):\n        if i % 2 == 0:  # i is even\n            # Calculate tri(i) using the rule: 1 + i // 2 (using integer division as per examples)\n            current_tri = 1 + (i // 2)\n        else:  # i is odd\n            # Calculate tri(i + 1) which is even: 1 + ( (i + 1) // 2 )\n            tri_i_plus_1 = 1 + ((i + 1) // 2)\n            # Calculate tri(i) using the rule: trib_sequence[i - 1] + trib_sequence[i - 2] + tri(i + 1)\n            current_tri = trib_sequence[i - 1] + trib_sequence[i - 2] + tri_i_plus_1\n        trib_sequence.append(current_tri)\n\n    return trib_sequence"}
{"task_id": "HumanEval/133", "solution": "import math\ndef sum_squares(lst):\n    \"\"\"\n    Calculates the sum of squares of numbers in a list after ceiling-rounding each.\n    Handles type validation for the list and its elements.\n    \"\"\"\n    if not isinstance(lst, list):\n        raise TypeError(\"Input must be a list.\")\n\n    total_sum_of_squares = 0\n    for num in lst:\n        if not isinstance(num, (int, float)):\n            raise ValueError(f\"List elements must be numbers, got {type(num)}.\")\n        \n        rounded_num = math.ceil(num)\n        total_sum_of_squares += rounded_num * rounded_num\n        \n    return total_sum_of_squares"}
{"task_id": "HumanEval/134", "solution": "def check_if_last_char_is_a_letter(txt: str) -> bool:\n    if not isinstance(txt, str):\n        raise TypeError(\"Input must be a string.\")\n    if not txt:\n        return False\n    \n    last_char = txt[-1]\n    \n    if not last_char.isalpha():\n        return False\n        \n    if len(txt) == 1:\n        return True\n        \n    char_before_last = txt[-2]\n    \n    return char_before_last == ' '"}
{"task_id": "HumanEval/134", "solution": "def check_if_last_char_is_a_letter(txt: str) -> bool:\n    \"\"\"\n    Returns True if the last character of a given string is an alphabetical\n    character and is not a part of a word, and False otherwise.\n    Note: \"word\" is a group of characters separated by space.\n    \"\"\"\n    if not txt:\n        return False\n\n    last_char = txt[-1]\n\n    if not last_char.isalpha():\n        return False\n\n    # Check if the last character is \"not a part of a word\"\n    # This means either it's the only character, or the character before it is a space.\n    if len(txt) == 1 or txt[-2] == ' ':\n        return True\n    else:\n        return False"}
{"task_id": "HumanEval/133", "solution": "import math\ndef sum_squares(lst):\n    \"\"\"You are given a list of numbers.\n    You need to return the sum of squared numbers in the given list,\n    round each element in the list to the upper int(Ceiling) first.\n    Examples:\n    For lst = [1,2,3] the output should be 14\n    For lst = [1,4,9] the output should be 98\n    For lst = [1,3,5,7] the output should be 84\n    For lst = [1.4,4.2,0] the output should be 29\n    For lst = [-2.4,1,1] the output should be 6\n    \n\n    \"\"\"\n    if not isinstance(lst, list):\n        raise TypeError(\"Input must be a list.\")\n\n    total_sum = 0\n    for item in lst:\n        if not isinstance(item, (int, float)):\n            raise TypeError(\"All elements in the list must be numbers (int or float).\")\n        \n        rounded_num = math.ceil(item)\n        total_sum += rounded_num * rounded_num\n        \n    return total_sum"}
{"task_id": "HumanEval/132", "solution": "def is_nested(string: str) -> bool:\n    \"\"\"\n    Checks if a string of square brackets contains a valid subsequence with at least one nested bracket.\n    Nesting is defined as a '[]' pair enclosed within another '[]' pair, such as '[[]]'.\n    \"\"\"\n    balance = 0\n    has_seen_double_open = False\n    has_seen_nested_close = False\n\n    for char in string:\n        if char == '[':\n            balance += 1\n            if balance >= 2:\n                has_seen_double_open = True\n        elif char == ']':\n            if balance > 0:\n                balance -= 1\n                if has_seen_double_open and balance == 0:\n                    has_seen_nested_close = True\n                    # Reset for subsequent distinct nested patterns within the same string.\n                    has_seen_double_open = False\n            else:\n                # An unmatched closing bracket invalidates any prior `[[` for forming a valid nested sequence.\n                has_seen_double_open = False\n    \n    return has_seen_nested_close"}
