{"task_id": "HumanEval/142", "solution": "def sum_squares(lst):\n    \"\"\"\n    Calculates a specific sum from a list of integers based on index-dependent transformations.\n    Elements are squared if their index is a multiple of 3, cubed if their index is a multiple of 4 (but not 3), and otherwise unchanged.\n    \"\"\"\n    if not lst:\n        return 0\n\n    transformed_list = []\n    for i, x in enumerate(lst):\n        if i % 3 == 0:\n            transformed_list.append(x * x)\n        elif i % 4 == 0:  # Implies i % 3 != 0 due to the 'elif'\n            transformed_list.append(x * x * x)\n        else:\n            transformed_list.append(x)\n\n    return sum(transformed_list)"}
{"task_id": "HumanEval/141", "solution": "import string\nALLOWED_EXTENSIONS = ['txt', 'exe', 'dll']\ndef file_name_check(file_name):\n    \"\"\"Checks if a file name is valid based on specific criteria.\n    Returns 'Yes' if valid, 'No' otherwise.\n    \"\"\"\n    # Check FR2: The file name contains no more than three digits.\n    digit_count = sum(1 for char in file_name if char.isdigit())\n    if digit_count > 3:\n        return 'No'\n\n    # Check FR3: The file name contains exactly one dot.\n    parts = file_name.split('.')\n    if len(parts) != 2:\n        return 'No'\n\n    prefix, suffix = parts\n\n    # Check FR4: The substring before the dot is not empty and starts with a letter.\n    if not prefix:\n        return 'No'\n    if prefix[0] not in string.ascii_letters:\n        return 'No'\n\n    # Check FR5: The substring after the dot is one of ['txt', 'exe', 'dll'].\n    if suffix not in ALLOWED_EXTENSIONS:\n        return 'No'\n\n    return 'Yes'"}
{"task_id": "HumanEval/142", "solution": "def sum_squares(lst: list[int]) -> int:\n    \"\"\"\n    Transforms list elements based on their index and returns the sum of the modified elements.\n    Elements at indices that are multiples of 3 are squared; elements at indices that are multiples of 4 (but not 3) are cubed.\n    \"\"\"\n    if not lst:\n        return 0\n\n    total_sum = 0\n    for i, item in enumerate(lst):\n        transformed_value = item\n        if i % 3 == 0:\n            transformed_value = item * item\n        elif i % 4 == 0:\n            transformed_value = item * item * item\n        # Otherwise, transformed_value remains item (unchanged)\n        total_sum += transformed_value\n            \n    return total_sum"}
{"task_id": "HumanEval/143", "solution": "class PrimeChecker:\n    @staticmethod\n    def is_prime(n: int) -> bool:\n        \"\"\"Checks if an integer n is a prime number.\n        Returns True if n is prime, False otherwise.\"\"\"\n        if n < 2:\n            return False\n        i = 2\n        while i * i <= n:\n            if n % i == 0:\n                return False\n            i += 1\n        return True\ndef words_in_sentence(sentence: str) -> str:\n    \"\"\"Filters words from a sentence, keeping only those with prime lengths.\n    Words are separated by spaces, and their order is preserved.\"\"\"\n    words = sentence.split(' ')\n    filtered_words = []\n    for word in words:\n        if PrimeChecker.is_prime(len(word)):\n            filtered_words.append(word)\n    return ' '.join(filtered_words)"}
{"task_id": "HumanEval/144", "solution": "import math\ndef simplify(x, n):\n    \"\"\"Your task is to implement a function that will simplify the expression\n    x * n. The function returns True if x * n evaluates to a whole number and False\n    otherwise. Both x and n, are string representation of a fraction, and have the following format,\n    <numerator>/<denominator> where both numerator and denominator are positive whole numbers.\n\n    You can assume that x, and n are valid fractions, and do not have zero as denominator.\n\n    simplify(\"1/5\", \"5/1\") = True\n    simplify(\"1/6\", \"2/1\") = False\n    simplify(\"7/10\", \"10/2\") = False\n    \"\"\"\n    def parse_fraction(fraction_str: str):\n        parts = fraction_str.split('/')\n        numerator = int(parts[0])\n        denominator = int(parts[1])\n        return numerator, denominator\n\n    numerator_x, denominator_x = parse_fraction(x)\n    numerator_n, denominator_n = parse_fraction(n)\n\n    # Multiply fractions\n    result_numerator = numerator_x * numerator_n\n    result_denominator = denominator_x * denominator_n\n\n    # Simplify the resulting fraction\n    common_divisor = math.gcd(result_numerator, result_denominator)\n    simplified_denominator = result_denominator // common_divisor\n\n    # Check if the simplified fraction is a whole number\n    return simplified_denominator == 1"}
{"task_id": "HumanEval/145", "solution": "def order_by_points(nums):\n    \"\"\"\n    Sorts a list of integers based on the sum of their digits, then by original index.\n    If multiple integers have the same digit sum, their original relative order is maintained.\n    \"\"\"\n\n    def _calculate_digit_sum(n: int) -> int:\n        \"\"\"Calculates the sum of the absolute value of digits for a given integer.\"\"\"\n        s = 0\n        n_abs = abs(n)\n        while n_abs > 0:\n            s += n_abs % 10\n            n_abs //= 10\n        return s\n\n    # Create tuples (sum_of_digits, original_index, number) for sorting.\n    decorated_list = []\n    for index, num in enumerate(nums):\n        digit_sum = _calculate_digit_sum(num)\n        decorated_list.append((digit_sum, index, num))\n\n    # Python's Timsort is stable and sorts tuples lexicographically by default.\n    # This ensures sorting by digit_sum primarily, then original_index for ties.\n    decorated_list.sort()\n\n    # Extract the original numbers from the sorted decorated list.\n    sorted_nums = [item[2] for item in decorated_list]\n    return sorted_nums"}
{"task_id": "HumanEval/146", "solution": "def specialFilter(nums: list[int]) -> int:\n    \"\"\"Filters numbers: counts those > 10 with both first and last digits odd.\n    Considers the absolute value for digit extraction.\n    \"\"\"\n    count = 0\n    for number in nums:\n        if number > 10:\n            abs_number_str = str(abs(number))\n            first_digit = int(abs_number_str[0])\n            last_digit = int(abs_number_str[-1])\n\n            is_first_odd = first_digit % 2 != 0\n            is_last_odd = last_digit % 2 != 0\n\n            if is_first_odd and is_last_odd:\n                count += 1\n    return count"}
{"task_id": "HumanEval/144", "solution": "import math\nclass Fraction:\n    \"\"\"Represents a mathematical fraction, always stored in its simplest form.\n    Provides basic arithmetic capabilities and checks if it's a whole number.\"\"\"\n    def __init__(self, numerator: int, denominator: int):\n        if denominator == 0:\n            raise ValueError(\"Denominator cannot be zero.\")\n        if not isinstance(numerator, int) or not isinstance(denominator, int):\n            raise TypeError(\"Numerator and denominator must be integers.\")\n\n        common_divisor = math.gcd(numerator, denominator)\n        self._numerator = numerator // common_divisor\n        self._denominator = denominator // common_divisor\n\n    @property\n    def numerator(self) -> int:\n        \"\"\"Returns the numerator of the fraction.\"\"\"\n        return self._numerator\n\n    @property\n    def denominator(self) -> int:\n        \"\"\"Returns the denominator of the fraction.\"\"\"\n        return self._denominator\n\n    def __mul__(self, other: 'Fraction') -> 'Fraction':\n        \"\"\"Multiplies this fraction by another and returns a new simplified Fraction.\"\"\"\n        new_numerator = self.numerator * other.numerator\n        new_denominator = self.denominator * other.denominator\n        return Fraction(new_numerator, new_denominator)\n\n    def is_whole_number(self) -> bool:\n        \"\"\"Checks if the fraction represents a whole number.\"\"\"\n        return self.denominator == 1\n\n    def __repr__(self) -> str:\n        \"\"\"Returns a string representation for debugging purposes.\"\"\"\n        return f\"Fraction({self.numerator}, {self.denominator})\"\n\n    def __eq__(self, other: object) -> bool:\n        \"\"\"Compares two Fraction objects for equality.\"\"\"\n        if not isinstance(other, Fraction):\n            return NotImplemented\n        return self.numerator == other.numerator and self.denominator == other.denominator\nclass FractionParser:\n    \"\"\"Parses string representations of fractions into Fraction objects.\n    Assumes input strings are in \"numerator/denominator\" format.\"\"\"\n    def parse(self, fraction_str: str) -> Fraction:\n        \"\"\"Parses a string like \"num/den\" into a Fraction object.\"\"\"\n        parts = fraction_str.split('/')\n        if len(parts) != 2:\n            raise ValueError(f\"Invalid fraction string format: {fraction_str}\")\n        try:\n            numerator = int(parts[0])\n            denominator = int(parts[1])\n        except ValueError:\n            raise ValueError(f\"Numerator or denominator is not a valid integer: {fraction_str}\")\n\n        return Fraction(numerator, denominator)\nclass FractionCalculator:\n    \"\"\"Encapsulates logic for arithmetic operations and checks on Fraction objects.\n    Delegates core operations to the Fraction class.\"\"\"\n    def multiply(self, f1: Fraction, f2: Fraction) -> Fraction:\n        \"\"\"Multiplies two Fraction objects.\"\"\"\n        return f1 * f2\n\n    def is_whole_number(self, f: Fraction) -> bool:\n        \"\"\"Checks if a Fraction object represents a whole number.\"\"\"\n        return f.is_whole_number()\ndef simplify(x: str, n: str) -> bool:\n    \"\"\"\n    Determines if the product of two fractions x and n is a whole number.\n    Returns True if x * n is a whole number, and False otherwise.\n    \"\"\"\n    parser = FractionParser()\n    calculator = FractionCalculator()\n\n    fraction_x = parser.parse(x)\n    fraction_n = parser.parse(n)\n\n    product_fraction = calculator.multiply(fraction_x, fraction_n)\n\n    return calculator.is_whole_number(product_fraction)"}
{"task_id": "HumanEval/145", "solution": "from typing import List\ndef order_by_points(nums: List[int]) -> List[int]:\n    \"\"\"\n    Sorts a list of integers by the sum of their absolute digits, then by original index.\n    This ensures stability and adheres to the specified sorting criteria.\n    \"\"\"\n    if not isinstance(nums, list):\n        raise TypeError(\"Input must be a list.\")\n\n    if not nums:\n        return []\n\n    decorated_list = []\n    for i, num in enumerate(nums):\n        # Validate that each element is an integer as per FR1 and FR2 error handling.\n        if not isinstance(num, int):\n            raise TypeError(f\"List elements must be integers, but found {type(num).__name__} at index {i}.\")\n        \n        # Calculate the sum of absolute digits as per FR1.\n        digit_sum = sum(int(digit) for digit in str(abs(num)))\n        decorated_list.append((digit_sum, i, num))\n\n    # Sort the decorated list. Python's Timsort is stable and sorts tuples lexicographically,\n    # satisfying FR2 (primary sort by digit sum) and FR3 (secondary sort by original index).\n    decorated_list.sort()\n    \n    # Extract and return the original values in their new sorted order.\n    return [item[2] for item in decorated_list]"}
{"task_id": "HumanEval/146", "solution": "def specialFilter(nums):\n    \"\"\"Counts numbers in a list that are greater than 10 and have both odd first and last digits.\n    Uses absolute values for digit checks as per design specification.\n    \"\"\"\n    count = 0\n    for num in nums:\n        if num > 10:\n            abs_num_str = str(abs(num))\n            first_digit = int(abs_num_str[0])\n            last_digit = int(abs_num_str[-1])\n\n            if (first_digit % 2 != 0) and (last_digit % 2 != 0):\n                count += 1\n    return count"}
{"task_id": "HumanEval/135", "solution": "def can_arrange(arr: list[int]) -> int:\n    \"\"\"\n    Returns the largest index of an element which is strictly less than its\n    preceding element. If no such element exists, return -1.\n    \"\"\"\n    if len(arr) < 2:\n        return -1\n\n    for i in range(len(arr) - 1, 0, -1):\n        if arr[i] < arr[i - 1]:\n            return i\n    return -1"}
{"task_id": "HumanEval/149", "solution": "def sorted_list_sum(lst: list[str]) -> list[str]:\n    \"\"\"Filters a list of strings to include only even-length strings.\n    Then, it sorts the result by length (ascending) and alphabetically (ascending).\"\"\"\n    \n    # Filter out strings with odd lengths.\n    filtered_list = [s for s in lst if len(s) % 2 == 0]\n    \n    # Sort the filtered list: primarily by length (ascending), then alphabetically (ascending).\n    filtered_list.sort(key=lambda s: (len(s), s))\n    \n    return filtered_list"}
{"task_id": "HumanEval/149", "solution": "def sorted_list_sum(lst):\n    \"\"\"Accepts a list of strings, filters out strings with odd lengths, and returns the resulted list with a sorted order. The list is sorted ascending by length of each word, and if two words have the same length, they are sorted alphabetically.\"\"\"\n    even_length_strings = [s for s in lst if len(s) % 2 == 0]\n    sorted_list = sorted(even_length_strings, key=lambda s: (len(s), s))\n    return sorted_list"}
{"task_id": "HumanEval/148", "solution": "PLANET_NAMES = [\n    \"Mercury\", \"Venus\", \"Earth\", \"Mars\",\n    \"Jupiter\", \"Saturn\", \"Uranus\", \"Neptune\"\n]\ndef bf(planet1, planet2):\n    '''\n    Returns a tuple of planets whose orbits are between planet1 and planet2, sorted by proximity to the sun.\n    Returns an empty tuple if planet1 or planet2 are not correct planet names.\n    '''\n    # Validate if both input planet names are recognized.\n    if planet1 not in PLANET_NAMES or planet2 not in PLANET_NAMES:\n        return ()\n\n    # Get the orbital indices for both planets.\n    idx1 = PLANET_NAMES.index(planet1)\n    idx2 = PLANET_NAMES.index(planet2)\n\n    # Determine the correct range, ensuring planets are sorted by sun proximity.\n    start_idx = min(idx1, idx2)\n    end_idx = max(idx1, idx2)\n\n    # Extract planets strictly between the two input planets.\n    intermediate_planets = PLANET_NAMES[start_idx + 1:end_idx]\n    return tuple(intermediate_planets)"}
{"task_id": "HumanEval/148", "solution": "from typing import List, Optional, Tuple\nSOLAR_SYSTEM_PLANETS: List[str] = [\n    \"Mercury\", \"Venus\", \"Earth\", \"Mars\", \"Jupiter\", \"Saturn\", \"Uranus\", \"Neptune\"\n]\nclass PlanetUtils:\n    \"\"\"Provides utility methods for validating planet names and retrieving their orbital indices.\"\"\"\n\n    @staticmethod\n    def get_planet_index(planet_name: str) -> Optional[int]:\n        \"\"\"Returns the zero-based index of a planet. Returns None if the planet is not found.\"\"\"\n        try:\n            return SOLAR_SYSTEM_PLANETS.index(planet_name)\n        except ValueError:\n            return None\n\n    @staticmethod\n    def is_valid_planet(planet_name: str) -> bool:\n        \"\"\"Checks if a planet name is present in the list of known planets.\"\"\"\n        return planet_name in SOLAR_SYSTEM_PLANETS\nclass PlanetService:\n    \"\"\"Encapsulates the core business logic for finding planets between two given planets.\"\"\"\n    def __init__(self, planet_utils: PlanetUtils):\n        \"\"\"Constructor, injects PlanetUtils dependency.\"\"\"\n        self._planet_utils = planet_utils\n\n    def find_planets_between(self, planet1: str, planet2: str) -> Tuple[str, ...]:\n        \"\"\"Implements the logic to find planets between the two given names. Returns a tuple of planets in order, or an empty tuple.\"\"\"\n        idx1 = self._planet_utils.get_planet_index(planet1)\n        idx2 = self._planet_utils.get_planet_index(planet2)\n\n        if idx1 is None or idx2 is None:\n            return ()\n\n        start_idx = min(idx1, idx2)\n        end_idx = max(idx1, idx2)\n\n        # Planets between are strictly greater than start_idx and strictly less than end_idx.\n        if end_idx - start_idx <= 1:\n            return ()\n\n        return tuple(SOLAR_SYSTEM_PLANETS[start_idx + 1 : end_idx])\ndef bf(planet1: str, planet2: str) -> Tuple[str, ...]:\n    \"\"\"\n    There are eight planets in our solar system: the closerst to the Sun \n    is Mercury, the next one is Venus, then Earth, Mars, Jupiter, Saturn, \n    Uranus, Neptune.\n    Write a function that takes two planet names as strings planet1 and planet2. \n    The function should return a tuple containing all planets whose orbits are \n    located between the orbit of planet1 and the orbit of planet2, sorted by \n    the proximity to the sun. \n    The function should return an empty tuple if planet1 or planet2\n    are not correct planet names. \n    Examples\n    bf(\"Jupiter\", \"Neptune\") ==> (\"Saturn\", \"Uranus\")\n    bf(\"Earth\", \"Mercury\") ==> (\"Venus\")\n    bf(\"Mercury\", \"Uranus\") ==> (\"Venus\", \"Earth\", \"Mars\", \"Jupiter\", \"Saturn\")\n    \"\"\"\n    planet_utils = PlanetUtils()\n    planet_service = PlanetService(planet_utils)\n    return planet_service.find_planets_between(planet1, planet2)"}
{"task_id": "HumanEval/147", "solution": "def get_max_triples(n):\n    \"\"\"\n    Calculates the count of triples (a[i], a[j], a[k]) whose sum is a multiple of 3.\n    The array elements are defined by a[i] = i * i - i + 1 for 1 <= i <= n.\n    \"\"\"\n    if not isinstance(n, int) or n <= 0:\n        raise ValueError(\"Input 'n' must be a positive integer.\")\n\n    a = [i * i - i + 1 for i in range(1, n + 1)]\n\n    length_a = len(a)\n    if length_a < 3:\n        return 0\n\n    triple_count = 0\n    for i in range(length_a - 2):\n        for j in range(i + 1, length_a - 1):\n            for k in range(j + 1, length_a):\n                if (a[i] + a[j] + a[k]) % 3 == 0:\n                    triple_count += 1\n    \n    return triple_count"}
{"task_id": "HumanEval/147", "solution": "class InvalidInputError(ValueError):\n    \"\"\"Custom exception for invalid input parameters.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\nclass InputValidator:\n    \"\"\"Provides static utility methods for validating input parameters.\"\"\"\n    @staticmethod\n    def validate_positive_integer(n: int, param_name: str) -> None:\n        \"\"\"Checks if n is a positive integer, raising InvalidInputError if not.\"\"\"\n        if not isinstance(n, int) or n <= 0:\n            raise InvalidInputError(f\"{param_name} must be a positive integer.\")\nclass TripleCalculator:\n    \"\"\"Manages core logic for generating array 'a' and counting valid triples.\"\"\"\n    def calculate_array(self, n: int) -> list[int]:\n        \"\"\"Generates the array 'a' where a[i] = i * i - i + 1 for 1 <= i <= n.\"\"\"\n        arr = [0] * n\n        for i in range(1, n + 1):\n            arr[i - 1] = i * i - i + 1\n        return arr\n\n    def _count_by_remainder(self, arr: list[int]) -> list[int]:\n        \"\"\"Counts elements by their remainder modulo 3.\"\"\"\n        counts = [0, 0, 0]\n        for x in arr:\n            counts[x % 3] += 1\n        return counts\n\n    def count_valid_triples(self, arr: list[int]) -> int:\n        \"\"\"Counts triples (x, y, z) such that x + y + z is a multiple of 3.\"\"\"\n        if len(arr) < 3:\n            return 0\n\n        counts = self._count_by_remainder(arr)\n        c0, c1, c2 = counts[0], counts[1], counts[2]\n\n        total_triples = 0\n\n        # Combinations where sum is 0 (mod 3):\n        # (0, 0, 0)\n        total_triples += (c0 * (c0 - 1) * (c0 - 2)) // 6\n        # (1, 1, 1) - sum is 3 (mod 3)\n        total_triples += (c1 * (c1 - 1) * (c1 - 2)) // 6\n        # (2, 2, 2) - sum is 6 (mod 3)\n        total_triples += (c2 * (c2 - 1) * (c2 - 2)) // 6\n        # (0, 1, 2) - sum is 3 (mod 3)\n        total_triples += c0 * c1 * c2\n\n        return total_triples\n\n    def get_max_triples_logic(self, n: int) -> int:\n        \"\"\"Encapsulates the full logic for calculating valid triples for a given n.\"\"\"\n        InputValidator.validate_positive_integer(n, \"n\")\n\n        if n < 3:\n            return 0\n\n        arr = self.calculate_array(n)\n        return self.count_valid_triples(arr)\ndef get_max_triples(n):\n    \"\"\"\n    Calculates the number of triples (a[i], a[j], a[k]) where i < j < k,\n    and a[i] + a[j] + a[k] is a multiple of 3.\n    \"\"\"\n    calculator = TripleCalculator()\n    return calculator.get_max_triples_logic(n)"}
{"task_id": "HumanEval/150", "solution": "import math\ndef x_or_y(n, x, y):\n    \"\"\"\n    A simple program which should return the value of x if n is a prime number and should return the value of y otherwise.\n    This function determines if 'n' is prime and returns the corresponding value.\n    \"\"\"\n\n    def is_prime(num: int) -> bool:\n        \"\"\"Determines if the given integer 'num' is a prime number.\n        Raises ValueError if 'num' is not an integer as per the design specification.\n        \"\"\"\n        if not isinstance(num, int):\n            raise ValueError(\"Input 'n' must be an integer.\")\n        if num <= 1:\n            return False\n        if num == 2:\n            return True\n        if num % 2 == 0:\n            return False\n        # Iterate from 3 up to the square root of num, incrementing by 2.\n        for i in range(3, int(math.sqrt(num)) + 1, 2):\n            if num % i == 0:\n                return False\n        return True\n\n    if is_prime(n):\n        return x\n    else:\n        return y"}
{"task_id": "HumanEval/150", "solution": "import math\ndef x_or_y(n, x, y):\n    \"\"\"A simple program which should return the value of x if n is\n    a prime number and should return the value of y otherwise.\n    \"\"\"\n\n    def _is_prime(num: int) -> bool:\n        \"\"\"Determines if the given integer is a prime number.\n        Checks for divisibility by odd numbers up to the square root.\n        \"\"\"\n        if num <= 1:\n            return False\n        if num == 2:\n            return True\n        if num % 2 == 0:\n            return False\n        for i in range(3, int(math.sqrt(num)) + 1, 2):\n            if num % i == 0:\n                return False\n        return True\n\n    if _is_prime(n):\n        return x\n    else:\n        return y"}
{"task_id": "HumanEval/151", "solution": "def double_the_difference(lst):\n    \"\"\"Calculates the sum of squares of positive, odd integers in a list, ignoring other number types or signs. Returns 0 for an empty list.\"\"\"\n    if not lst:\n        return 0\n\n    total_sum = 0\n\n    for num in lst:\n        # Check if the number is a positive integer.\n        if isinstance(num, int) and num > 0:\n            # Check if the positive integer is odd.\n            if num % 2 != 0:\n                total_sum += num * num\n                \n    return total_sum"}
{"task_id": "HumanEval/152", "solution": "def compare(game, guess):\n    \"\"\"Compares actual game scores against user guesses, returning absolute differences.\n    A value of 0 indicates a perfectly correct guess for that match.\n    \"\"\"\n    if len(game) != len(guess):\n        raise ValueError(\"Input arrays must be of equal length.\")\n\n    differences = []\n    for i in range(len(game)):\n        differences.append(abs(game[i] - guess[i]))\n    return differences"}
{"task_id": "HumanEval/151", "solution": "def double_the_difference(lst: list) -> int:\n    \"\"\"\n    Given a list, this function sums the squares of numbers that are odd, positive, and integers.\n    Negative or non-integer elements are ignored; returns 0 if the list is empty.\n\n    Examples:\n    double_the_difference([1, 3, 2, 0]) == 10\n    double_the_difference([-1, -2, 0]) == 0\n    double_the_difference([9, -2]) == 81\n    double_the_difference([0]) == 0\n    \"\"\"\n    total_sum = 0\n    for item in lst:\n        # Check if the item is an odd, positive integer.\n        if isinstance(item, int) and item > 0 and item % 2 != 0:\n            total_sum += item * item\n    return total_sum"}
{"task_id": "HumanEval/152", "solution": "class InputMismatchError(Exception):\n    \"\"\"Exception raised when input arrays have different lengths.\"\"\"\n    def __init__(self, message: str = \"Input arrays must have the same length.\"):\n        self.message = message\n        super().__init__(self.message)\nclass InputValidationError(Exception):\n    \"\"\"Exception raised when input arrays contain invalid data types.\"\"\"\n    def __init__(self, message: str = \"Input arrays must contain only integers.\"):\n        self.message = message\n        super().__init__(self.message)\ndef compare(game, guess):\n    \"\"\"\n    Compares two lists of integers (game scores and guesses) and returns\n    a new list containing the absolute difference for each corresponding element.\n    If elements are identical, the difference is 0.\n    \"\"\"\n    if not isinstance(game, list) or not isinstance(guess, list):\n        raise InputValidationError(\"Inputs must be lists.\")\n    if not all(isinstance(x, int) for x in game) or not all(isinstance(x, int) for x in guess):\n        raise InputValidationError(\"All elements in input lists must be integers.\")\n\n    if len(game) != len(guess):\n        raise InputMismatchError()\n\n    differences = []\n    for i in range(len(game)):\n        differences.append(abs(game[i] - guess[i]))\n    return differences"}
{"task_id": "HumanEval/153", "solution": "def Strongest_Extension(class_name, extensions):\n    \"\"\"Calculates the strength of extensions and finds the strongest one.\n    Strength is (uppercase count) - (lowercase count), with ties broken by list order.\n    \"\"\"\n    if not isinstance(class_name, str):\n        raise TypeError(\"Class name must be a string.\")\n    if not isinstance(extensions, list):\n        raise TypeError(\"Extensions must be a list.\")\n    if not all(isinstance(ext, str) for ext in extensions):\n        raise TypeError(\"All extensions in the list must be strings.\")\n    if not extensions:\n        raise ValueError(\"Extensions list cannot be empty.\")\n\n    strongest_ext_name = \"\"\n    max_strength = -float('inf')  # Initialize with a very low strength\n\n    for ext_name in extensions:\n        # Calculate strength based on uppercase and lowercase character counts.\n        cap_count = sum(1 for char in ext_name if 'A' <= char <= 'Z')\n        sm_count = sum(1 for char in ext_name if 'a' <= char <= 'z')\n        current_strength = cap_count - sm_count\n\n        # Update strongest extension if current one is strictly stronger.\n        # Tie-breaking (first occurring) is handled naturally by this condition.\n        if current_strength > max_strength:\n            max_strength = current_strength\n            strongest_ext_name = ext_name\n    \n    return f\"{class_name}.{strongest_ext_name}\""}
