{"task_id": "HumanEval/9", "solution": "from typing import List\ndef rolling_max(numbers: List[int]) -> List[int]:\n    \"\"\" From a given list of integers, generate a list of rolling maximum element found until given moment\n    in the sequence.\n    >>> rolling_max([1, 2, 3, 2, 3, 4, 2])\n    [1, 2, 3, 3, 3, 4, 4]\n    \"\"\"\n    # Validate that the input is a list.\n    if not isinstance(numbers, list):\n        raise TypeError(\"numbers must be a list\")\n    \n    # Validate that all elements in the list are integers.\n    for item in numbers:\n        if not isinstance(item, int):\n            raise ValueError(\"All elements in numbers must be integers\")\n\n    # Handle the business rule for an empty input list.\n    if not numbers:\n        return []\n\n    result = []\n    current_max = float('-inf') # Initialize with negative infinity to correctly handle any integer range.\n\n    # Iterate through the numbers to compute the rolling maximums.\n    for number in numbers:\n        current_max = max(current_max, number)\n        result.append(current_max)\n\n    return result"}
{"task_id": "HumanEval/9", "solution": "from typing import List\ndef rolling_max(numbers: List[int]) -> List[int]:\n    \"\"\"From a given list of integers, generate a list of rolling maximum element\n    found until given moment in the sequence.\n    \"\"\"\n    if not numbers:\n        return []\n\n    rolling_maximums: List[int] = []\n    current_max: int = float('-inf')\n\n    for number in numbers:\n        if number > current_max:\n            current_max = number\n        rolling_maximums.append(current_max)\n\n    return rolling_maximums"}
