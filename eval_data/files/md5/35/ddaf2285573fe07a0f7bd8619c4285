{"task_id": "HumanEval/119", "solution": "def match_parens(lst):\n    \"\"\"\n    Checks if two parenthesis strings can form a balanced string by concatenation.\n    Returns 'Yes' if a balanced string can be formed, 'No' otherwise.\n    \"\"\"\n    if not isinstance(lst, list) or len(lst) != 2:\n        raise ValueError(\"Input must be a list containing exactly two strings.\")\n\n    s1, s2 = lst[0], lst[1]\n\n    for s_val in [s1, s2]:\n        if not isinstance(s_val, str) or not all(c in '()' for c in s_val):\n            raise ValueError(\"Each element in the list must be a string containing only '(' or ')'.\")\n\n    def _is_balanced(s: str) -> bool:\n        \"\"\"\n        Helper function to check if a single string of parentheses is balanced.\n        It counts the balance of open and close parentheses.\n        \"\"\"\n        balance = 0\n        for char in s:\n            if char == '(':\n                balance += 1\n            else: # char == ')'\n                balance -= 1\n            if balance < 0: # More close than open at any point\n                return False\n        return balance == 0 # Final balance must be zero\n\n    # Try first concatenation order\n    if _is_balanced(s1 + s2):\n        return \"Yes\"\n\n    # Try second concatenation order\n    if _is_balanced(s2 + s1):\n        return \"Yes\"\n\n    return \"No\""}
{"task_id": "HumanEval/120", "solution": "def maximum(arr, k):\n    \"\"\"\n    Given an array arr of integers and a non-negative integer k, return a sorted list\n    of length k with the maximum k numbers in arr.\n    \"\"\"\n    if k == 0:\n        return []\n\n    # Sort the array in descending order to identify the largest elements.\n    arr.sort(reverse=True)\n\n    # Select the top k elements and then sort them in ascending order for the final result.\n    top_k_elements = arr[:k]\n    top_k_elements.sort()\n\n    return top_k_elements"}
{"task_id": "HumanEval/118", "solution": "def get_closest_vowel(word):\n    \"\"\"\n    Finds the closest vowel that stands between two consonants\n    from the right side of the word (case sensitive return).\n    Vowels at the beginning and ending positions do not count.\n    \"\"\"\n    VOWELS = {'a', 'e', 'i', 'o', 'u'}\n\n    def _is_vowel(char: str) -> bool:\n        \"\"\"Checks if a character is a vowel (case-insensitive).\"\"\"\n        return char.lower() in VOWELS\n\n    def _is_consonant(char: str) -> bool:\n        \"\"\"Checks if a character is a consonant (case-insensitive).\"\"\"\n        return char.isalpha() and not _is_vowel(char)\n\n    n = len(word)\n    # Words shorter than 3 characters cannot have an internal vowel with two neighbors.\n    if n < 3:\n        return \"\"\n\n    # Iterate from right to left, considering indices from n-2 down to 1.\n    # This range explicitly excludes the first and last characters (indices 0 and n-1).\n    for i in range(n - 2, 0, -1):\n        current_char = word[i]\n        left_char = word[i - 1]\n        right_char = word[i + 1]\n\n        if (_is_vowel(current_char) and\n                _is_consonant(left_char) and\n                _is_consonant(right_char)):\n            return current_char\n    return \"\""}
{"task_id": "HumanEval/121", "solution": "def solution(lst):\n    \"\"\"Given a non-empty list of integers, return the sum of all of the odd elements that are in even positions.\n    \"\"\"\n    if not lst:\n        raise ValueError(\"Input list cannot be empty.\")\n\n    total_sum = 0\n    for i in range(len(lst)):\n        if i % 2 == 0:  # Check if position is even (0-indexed)\n            if lst[i] % 2 != 0:  # Check if element at even position is odd\n                total_sum += lst[i]\n    return total_sum"}
{"task_id": "HumanEval/119", "solution": "def match_parens(lst):\n    '''\n    You are given a list of two strings, both strings consist of open\n    parentheses '(' or close parentheses ')' only.\n    Your job is to check if it is possible to concatenate the two strings in\n    some order, that the resulting string will be good.\n    A string S is considered to be good if and only if all parentheses in S\n    are balanced. For example: the string '(())()' is good, while the string\n    '())' is not.\n    Return 'Yes' if there's a way to make a good string, and return 'No' otherwise.\n\n    Examples:\n    match_parens(['()(', ')']) == 'Yes'\n    match_parens([')', ')']) == 'No'\n    '''\n\n    s1 = lst[0]\n    s2 = lst[1]\n\n    def _is_balanced(s: str) -> bool:\n        balance = 0\n        for char in s:\n            if char == '(':\n                balance += 1\n            elif char == ')':\n                balance -= 1\n            if balance < 0:\n                return False\n        return balance == 0\n\n    # Check the first concatenation order: s1 + s2\n    if _is_balanced(s1 + s2):\n        return 'Yes'\n\n    # Check the second concatenation order: s2 + s1\n    if _is_balanced(s2 + s1):\n        return 'Yes'\n\n    # Neither concatenation formed a balanced string\n    return 'No'"}
{"task_id": "HumanEval/121", "solution": "def solution(lst: list[int]) -> int:\n    \"\"\"Given a non-empty list of integers, return the sum of all odd elements at even positions (0-indexed).\n    Raises ValueError if the input list is empty.\n    \"\"\"\n    if not lst:\n        raise ValueError(\"Input list cannot be empty.\")\n\n    total_sum = 0\n    for i, num in enumerate(lst):\n        if i % 2 == 0 and num % 2 != 0:\n            total_sum += num\n    return total_sum"}
{"task_id": "HumanEval/120", "solution": "class InvalidInputError(Exception):\n    \"\"\"Custom exception for signaling invalid input parameters.\"\"\"\n    def __init__(self, message):\n        super().__init__(message)\ndef maximum(arr, k):\n    \"\"\"\n    Given an array arr of integers and a positive integer k, return a sorted list \n    of length k with the maximum k numbers in arr.\n\n    Example 1:\n\n        Input: arr = [-3, -4, 5], k = 3\n        Output: [-4, -3, 5]\n\n    Example 2:\n\n        Input: arr = [4, -4, 4], k = 2\n        Output: [4, 4]\n\n    Example 3:\n\n        Input: arr = [-3, 2, 1, 2, -1, -2, 1], k = 1\n        Output: [2]\n\n    Note:\n        1. The length of the array will be in the range of [1, 1000].\n        2. The elements in the array will be in the range of [-1000, 1000].\n        3. 0 <= k <= len(arr)\n    \"\"\"\n    # Validate inputs based on business rules and functional requirements.\n    # Raises InvalidInputError if any constraint is violated.\n    if not isinstance(arr, list):\n        raise InvalidInputError(\"Input 'arr' must be a list.\")\n    if not arr:\n        raise InvalidInputError(\"Input 'arr' cannot be empty.\")\n    if not isinstance(k, int):\n        raise InvalidInputError(\"Input 'k' must be an integer.\")\n\n    if not (1 <= len(arr) <= 1000):\n        raise InvalidInputError(\"Length of 'arr' must be between 1 and 1000.\")\n    if not all(isinstance(x, int) and -1000 <= x <= 1000 for x in arr):\n        raise InvalidInputError(\"All elements in 'arr' must be integers between -1000 and 1000.\")\n\n    if k < 0:\n        raise InvalidInputError(\"Input 'k' cannot be negative.\")\n    if k > len(arr):\n        raise InvalidInputError(\"Input 'k' cannot be greater than the length of 'arr'.\")\n\n    if k == 0:\n        return []\n\n    # Sort the array and select the k largest elements.\n    # The result is sorted in ascending order as required.\n    sorted_arr = sorted(arr)\n    return sorted_arr[len(sorted_arr) - k:]"}
