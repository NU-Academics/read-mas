{"task_id": "HumanEval/82", "solution": "def prime_length(string):\n    \"\"\"Write a function that takes a string and returns True if the string\n    length is a prime number or False otherwise\n    Examples\n    prime_length('Hello') == True\n    prime_length('abcdcba') == True\n    prime_length('kittens') == True\n    prime_length('orange') == False\n    \"\"\"\n    if not isinstance(string, str):\n        raise TypeError(\"Input 'string' must be a string.\")\n\n    length = len(string)\n\n    n = length\n    if not isinstance(n, int):\n        # This case is actually handled by len(string) always returning an int,\n        # but kept for robustness as per original is_prime design's type check philosophy.\n        # In this specific context, len(string) always returns an integer,\n        # so this check for `n` is technically redundant but harmless.\n        raise TypeError(\"Input 'n' must be an integer.\")\n    if n < 2:\n        return False\n    for i in range(2, int(n**0.5) + 1):\n        if n % i == 0:\n            return False\n    return True"}
{"task_id": "HumanEval/84", "solution": "class InputValidator:\n    MIN_N = 0\n    MAX_N = 10000\n\n    def validate_n(self, n: int) -> None:\n        \"\"\"Validates input N against type and range constraints.\"\"\"\n        if not isinstance(n, int):\n            raise ValueError(\"Input N must be an integer.\")\n        if not (self.MIN_N <= n <= self.MAX_N):\n            raise ValueError(f\"Input N must be between {self.MIN_N} and {self.MAX_N} (inclusive).\")\nclass DigitSumCalculator:\n    def calculate(self, number: int) -> int:\n        \"\"\"Computes the sum of the decimal digits of a number.\"\"\"\n        sum_val = 0\n        num_str = str(number)\n        for digit_char in num_str:\n            sum_val += int(digit_char)\n        return sum_val\nclass BinaryConverter:\n    def convert(self, number: int) -> str:\n        \"\"\"Converts an integer to its binary string representation.\"\"\"\n        if number == 0:\n            return \"0\"\n        return bin(number)[2:]\ndef solve(N: int) -> str:\n    \"\"\"Given a positive integer N, return the total sum of its digits in binary.\"\"\"\n    input_validator = InputValidator()\n    digit_sum_calculator = DigitSumCalculator()\n    binary_converter = BinaryConverter()\n\n    input_validator.validate_n(N)\n    sum_of_digits = digit_sum_calculator.calculate(N)\n    binary_string = binary_converter.convert(sum_of_digits)\n    return binary_string"}
{"task_id": "HumanEval/85", "solution": "def add(lst):\n    \"\"\"\n    Sums even numbers located at odd indices in the input list.\n    Handles type validation for the list and its numeric elements at odd indices.\n    \"\"\"\n    if not isinstance(lst, list):\n        raise TypeError(\"Input must be a list.\")\n\n    total_sum = 0\n    for i, item in enumerate(lst):\n        if i % 2 != 0:  # Check for odd index\n            if not isinstance(item, (int, float)):\n                raise TypeError(f\"Element at odd index {i} must be a number, got {type(item).__name__}.\")\n            \n            # Check if the number is even, including float integers like 4.0\n            if isinstance(item, int):\n                if item % 2 == 0:\n                    total_sum += item\n            elif isinstance(item, float):\n                if item.is_integer() and int(item) % 2 == 0:\n                    total_sum += int(item)\n    return total_sum"}
{"task_id": "HumanEval/86", "solution": "import re\ndef anti_shuffle(s: str) -> str:\n    \"\"\"\n    Returns a string where characters within each word are sorted alphabetically.\n    Preserves original word order and spacing.\n    \"\"\"\n    if not isinstance(s, str):\n        raise TypeError(\"Input must be a string.\")\n\n    if not s:\n        return \"\"\n\n    # Split the string by one or more spaces, capturing the spaces themselves\n    parts = re.split(r'(\\s+)', s)\n    \n    result_parts = []\n    for part in parts:\n        # If the part is not empty and contains non-whitespace characters, it's a word.\n        if part and part.strip() != \"\":\n            result_parts.append(\"\".join(sorted(part)))\n        else: # It's either an empty string or a sequence of spaces, preserve it.\n            result_parts.append(part)\n    \n    return \"\".join(result_parts)"}
{"task_id": "HumanEval/86", "solution": "import re\ndef anti_shuffle(s):\n    \"\"\"\n    Returns an ordered version of the input string where characters within each word are sorted.\n    The original word order and spacing are preserved based on ASCII values.\n    \"\"\"\n    if not isinstance(s, str):\n        raise TypeError(\"Input must be a string.\")\n\n    # Split the string by one or more spaces, capturing the spaces themselves to preserve them.\n    parts = re.split(r'(\\s+)', s)\n\n    processed_parts = []\n    for part in parts:\n        # If the part is an empty string or consists only of spaces, append it as is.\n        if part.isspace() or not part:\n            processed_parts.append(part)\n        else:\n            # Otherwise, it's a word; sort its characters by ASCII value and append.\n            processed_parts.append(\"\".join(sorted(part)))\n\n    # Reconstruct the string from the processed words and preserved spaces.\n    return \"\".join(processed_parts)"}
{"task_id": "HumanEval/87", "solution": "def get_row(lst: list[list[int]], x: int) -> list[tuple[int, int]]:\n    \"\"\"\n    Finds occurrences of an integer x in a 2D nested list.\n    Returns a list of 0-indexed (row, column) coordinates, sorted by row ascending and column descending.\n    \"\"\"\n    found_coordinates = []\n    for row_idx, row in enumerate(lst):\n        for col_idx, value in enumerate(row):\n            if value == x:\n                found_coordinates.append((row_idx, col_idx))\n\n    # Sort primarily by row (ascending), secondarily by column (descending).\n    found_coordinates.sort(key=lambda coord: (coord[0], -coord[1]))\n    return found_coordinates"}
{"task_id": "HumanEval/87", "solution": "def get_row(lst, x):\n    \"\"\"\n    Finds all occurrences of `x` in a 2D list `lst`, returning their `(row, column)` coordinates.\n    Coordinates are sorted primarily by row ascending, then by column descending.\n    \"\"\"\n    found_coordinates = []\n\n    for r_idx, row_list in enumerate(lst):\n        for c_idx, element in enumerate(row_list):\n            if element == x:\n                found_coordinates.append((r_idx, c_idx))\n\n    # Sort primarily by row (ascending) and secondarily by column (descending)\n    found_coordinates.sort(key=lambda coord: (coord[0], -coord[1]))\n\n    return found_coordinates"}
{"task_id": "HumanEval/88", "solution": "def sort_array(array):\n    \"\"\"\n    Given an array of non-negative integers, return a copy of the given array after sorting,\n    you will sort the given array in ascending order if the sum( first index value, last index value) is odd,\n    or sort it in descending order if the sum( first index value, last index value) is even.\n\n    Note:\n    * don't change the given array.\n\n    Examples:\n    * sort_array([]) => []\n    * sort_array([5]) => [5]\n    * sort_array([2, 4, 3, 0, 1, 5]) => [0, 1, 2, 3, 4, 5]\n    * sort_array([2, 4, 3, 0, 1, 5, 6]) => [6, 5, 4, 3, 2, 1, 0]\n    \"\"\"\n    if not array:\n        return []\n    if len(array) == 1:\n        return list(array)\n\n    first_element = array[0]\n    last_element = array[-1]\n    sum_first_last = first_element + last_element\n\n    array_copy = list(array)\n\n    if sum_first_last % 2 != 0:  # Sum is odd, sort ascending\n        return sorted(array_copy, reverse=False)\n    else:  # Sum is even, sort descending\n        return sorted(array_copy, reverse=True)"}
{"task_id": "HumanEval/88", "solution": "from typing import List\ndef sort_array(array: List[int]) -> List[int]:\n    \"\"\"\n    Given an array of non-negative integers, return a copy of the given array after sorting.\n    Sorts in ascending order if the sum of the first and last elements is odd, or in descending order if the sum is even.\n    \"\"\"\n    if not array or len(array) == 1:\n        return list(array)\n\n    first_val = array[0]\n    last_val = array[-1]\n    sum_val = first_val + last_val\n\n    array_copy = list(array) \n\n    if sum_val % 2 != 0:  # Sum is odd\n        array_copy.sort()\n    else:  # Sum is even\n        array_copy.sort(reverse=True)\n\n    return array_copy"}
