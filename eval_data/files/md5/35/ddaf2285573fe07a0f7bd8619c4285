{"task_id": "HumanEval/40", "solution": "def triples_sum_to_zero(l: list):\n    \"\"\"\n    triples_sum_to_zero takes a list of integers as an input.\n    it returns True if there are three distinct elements in the list that\n    sum to zero, and False otherwise.\n    \"\"\"\n    import itertools\n\n    if not isinstance(l, list):\n        raise TypeError(\"Input must be a Python list.\")\n    \n    # Ensure all elements in the list are integers.\n    for x in l:\n        if not isinstance(x, int):\n            raise TypeError(\"List elements must be integers.\")\n\n    # If the list has fewer than 3 elements, no triple can be formed.\n    if len(l) < 3:\n        return False\n\n    # Iterate through all unique combinations of three distinct elements by index.\n    for combo in itertools.combinations(l, 3):\n        if sum(combo) == 0:\n            return True # A zero-sum triple was found.\n            \n    return False # No zero-sum triple found after checking all combinations."}
{"task_id": "HumanEval/43", "solution": "def pairs_sum_to_zero(l):\n    \"\"\"\n    pairs_sum_to_zero takes a list of integers as an input.\n    It returns True if there are two distinct elements in the list that\n    sum to zero, and False otherwise.\n    \"\"\"\n    if not isinstance(l, list):\n        raise TypeError(\"Input must be a list.\")\n\n    seen_numbers = set()\n    for num in l:\n        if not isinstance(num, int):\n            raise TypeError(\"All elements in the list must be integers.\")\n        \n        complement = -num\n        if complement in seen_numbers:\n            return True\n        seen_numbers.add(num)\n    return False"}
{"task_id": "HumanEval/44", "solution": "def change_base(x: int, base: int):\n    \"\"\"Change numerical base of input number x to base.\n    return string representation after the conversion.\n    base numbers are less than 10.\n    >>> change_base(8, 3)\n    '22'\n    >>> change_base(8, 2)\n    '1000'\n    >>> change_base(7, 2)\n    '111'\n    \"\"\"\n    if x < 0:\n        raise ValueError(\"Input number 'x' must be non-negative.\")\n    # The target base is restricted to 2-9 as per design.\n    if not (2 <= base <= 9):\n        raise ValueError(\"Base must be between 2 and 9.\")\n\n    if x == 0:\n        return \"0\"\n\n    result_digits = []\n    current_x = x\n    while current_x > 0:\n        remainder = current_x % base\n        result_digits.append(str(remainder))\n        current_x //= base\n    \n    # Digits are collected in reverse order, so reverse the list and join.\n    return \"\".join(reversed(result_digits))"}
{"task_id": "HumanEval/42", "solution": "from .exceptions import InvalidInputTypeError\nfrom .incrementer import incr_list\nfrom .exceptions import InvalidInputTypeError\nclass InvalidInputTypeError(TypeError):\n    \"\"\"Custom exception for invalid input types or values.\n    It provides a descriptive message explaining the nature of the error.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\nclass ListIncrementer:\n    \"\"\"\n    Provides core logic for incrementing elements in a list.\n    It encapsulates validation and the transformation process.\n    \"\"\"\n    @staticmethod\n    def _validate_list_type(l: list) -> None:\n        \"\"\"Validates that the input is a list.\n        Raises InvalidInputTypeError if the input is not a list.\"\"\"\n        if not isinstance(l, list):\n            raise InvalidInputTypeError(\"Input must be a list.\")\n\n    @staticmethod\n    def _validate_list_elements(l: list) -> None:\n        \"\"\"Validates that all elements in the list are numeric.\n        Raises InvalidInputTypeError if any element is not an int or float.\"\"\"\n        for element in l:\n            if not isinstance(element, (int, float)):\n                raise InvalidInputTypeError(f\"List elements must be numbers, found: {type(element).__name__}\")\n\n    @staticmethod\n    def increment_elements(l: list) -> list:\n        \"\"\"\n        Returns a new list with elements incremented by 1.\n        It performs input validation before processing.\n        \"\"\"\n        ListIncrementer._validate_list_type(l)\n        ListIncrementer._validate_list_elements(l)\n        return [x + 1 for x in l]\ndef incr_list(l: list) -> list:\n    \"\"\"\n    Returns a new list with elements incremented by 1.\n    This public function acts as a facade to the core ListIncrementer logic.\n    \"\"\"\n    return ListIncrementer.increment_elements(l)"}
{"task_id": "HumanEval/41", "solution": "def car_race_collision(n: int):\n    \"\"\"\n    Imagine a road that's a perfectly straight infinitely long line.\n    n cars are driving left to right;  simultaneously, a different set of n cars\n    are driving right to left.   The two sets of cars start out being very far from\n    each other.  All cars move in the same speed.  Two cars are said to collide\n    when a car that's moving left to right hits a car that's moving right to left.\n    However, the cars are infinitely sturdy and strong; as a result, they continue moving\n    in their trajectory as if they did not collide.\n\n    This function outputs the number of such collisions.\n    \"\"\"\n    # Each of the 'n' cars moving left to right will collide with each of the 'n' cars\n    # moving right to left. Since there are 'n' cars in the first set and 'n' cars\n    # in the second set, and each car from the first set collides with every car\n    # from the second set, the total number of collisions is n multiplied by n.\n    return n * n"}
{"task_id": "HumanEval/43", "solution": "def pairs_sum_to_zero(l):\n    \"\"\"\n    pairs_sum_to_zero takes a list of integers as an input.\n    it returns True if there are two distinct elements in the list that\n    sum to zero, and False otherwise.\n    >>> pairs_sum_to_zero([1, 3, 5, 0])\n    False\n    >>> pairs_sum_to_zero([1, 3, -2, 1])\n    False\n    >>> pairs_sum_to_zero([1, 2, 3, 7])\n    False\n    >>> pairs_sum_to_zero([2, 4, -5, 3, 5, 7])\n    True\n    >>> pairs_sum_to_zero([1])\n    False\n    \"\"\"\n    if not isinstance(l, list):\n        raise TypeError(\"Input must be a list.\")\n    for item in l:\n        if not isinstance(item, int):\n            raise TypeError(\"All elements in the list must be integers.\")\n\n    seen_numbers = set()\n    for num in l:\n        target = -num\n        # Check if the complement exists in seen_numbers.\n        # This inherently handles the \"distinct\" requirement for non-zero numbers\n        # because if 'num' is processed, and its complement 'target' is already in 'seen_numbers',\n        # it means 'target' was encountered at an earlier position in the list.\n        # For zero, if we encounter a second zero, its complement (0) will be in seen_numbers.\n        if target in seen_numbers:\n            return True\n        seen_numbers.add(num)\n\n    return False"}
{"task_id": "HumanEval/45", "solution": "def triangle_area(a: float | int, h: float | int) -> float:\n    \"\"\"Given length of a side and high return area for a triangle.\n    >>> triangle_area(5, 3)\n    7.5\n    \"\"\"\n    if not isinstance(a, (int, float)) or not isinstance(h, (int, float)):\n        raise TypeError(\"Base and height must be numeric.\")\n    if a <= 0 or h <= 0:\n        raise ValueError(\"Base and height must be positive.\")\n    return (a * h) / 2"}
