{"task_id": "HumanEval/115", "solution": "import math\nclass Well:\n    def __init__(self, water_units: int):\n        self._water_units = water_units\n\n    @staticmethod\n    def from_row(row_data: list[int]) -> 'Well':\n        \"\"\"Constructs a Well from a row of water data.\"\"\"\n        water_units = sum(row_data)\n        return Well(water_units)\n\n    def get_water_units(self) -> int:\n        \"\"\"Returns the total water units in the well.\"\"\"\n        return self._water_units\nclass Grid:\n    def __init__(self, wells: list[Well]):\n        self._wells = wells\n\n    @staticmethod\n    def from_list(grid_data: list[list[int]]) -> 'Grid':\n        \"\"\"Constructs a Grid from a 2D list of integers.\"\"\"\n        wells = [Well.from_row(row) for row in grid_data]\n        return Grid(wells)\n\n    def get_wells(self) -> list[Well]:\n        \"\"\"Returns the list of Well objects in the grid.\"\"\"\n        return self._wells\nclass WellService:\n    @staticmethod\n    def calculate_max_fill(grid_obj: Grid, capacity: int) -> int:\n        \"\"\"Calculates total bucket lowering operations for all wells in a grid.\"\"\"\n        total_operations = 0\n        for well in grid_obj.get_wells():\n            water_units = well.get_water_units()\n            if water_units > 0:\n                operations_for_well = math.ceil(water_units / capacity)\n                total_operations += operations_for_well\n        return int(total_operations)\ndef max_fill(grid: list[list[int]], capacity: int) -> int:\n    \"\"\"\n    Calculates the number of times buckets need to be lowered to empty wells.\n\n    Each '1' in a row is a unit of water. Operations per well are ceil(water / capacity).\n    \"\"\"\n    grid_obj = Grid.from_list(grid)\n    return WellService.calculate_max_fill(grid_obj, capacity)"}
{"task_id": "HumanEval/116", "solution": "def sort_array(arr: list[int]) -> list[int]:\n    \"\"\"\n    Sorts an array of integers primarily by '1' bit count, secondarily by decimal value.\n    Raises TypeError for invalid input array or non-integer elements.\n    \"\"\"\n\n    if not isinstance(arr, list):\n        raise TypeError(\"Input must be a list.\")\n    if not all(isinstance(x, int) for x in arr):\n        raise TypeError(\"All elements in the list must be integers.\")\n\n    def _count_set_bits(n: int) -> int:\n        \"\"\"Counts '1' bits in an integer's binary representation, using absolute value for negative numbers.\"\"\"\n        return bin(abs(n)).count('1')\n\n    return sorted(arr, key=lambda x: (_count_set_bits(x), x))"}
{"task_id": "HumanEval/117", "solution": "def select_words(s, n):\n    \"\"\"\n    Given a string s and a natural number n, returns a list of all words from string s\n    that contain exactly n consonants, in order these words appear in the string s.\n    \"\"\"\n    if not s:\n        return []\n\n    words = s.split()\n    result = []\n    vowels_set = {\"a\", \"e\", \"i\", \"o\", \"u\"}\n\n    for word in words:\n        consonant_count = 0\n        for char in word:\n            # Check if character is an alphabetic letter and not a vowel (case-insensitive)\n            if char.isalpha() and char.lower() not in vowels_set:\n                consonant_count += 1\n        \n        if consonant_count == n:\n            result.append(word)\n            \n    return result"}
{"task_id": "HumanEval/117", "solution": "from typing import List\ndef select_words(s: str, n: int) -> List[str]:\n    \"\"\"\n    Given a string s and a natural number n, returns a list of all words from string s\n    that contain exactly n consonants, preserving their original order.\n    If the string s is empty, the function returns an empty list.\n    \"\"\"\n\n    VOWELS = {'a', 'e', 'i', 'o', 'u'}\n\n    def is_vowel(char: str) -> bool:\n        \"\"\"Checks if a character is a vowel (case-insensitive).\"\"\"\n        return char.lower() in VOWELS\n\n    def count_consonants(word: str) -> int:\n        \"\"\"Counts consonants in a word. It considers only alphabetic characters.\"\"\"\n        consonant_count = 0\n        for char in word:\n            if char.isalpha() and not is_vowel(char):\n                consonant_count += 1\n        return consonant_count\n\n    if not s:\n        return []\n\n    words = s.split()\n    result = []\n\n    for word in words:\n        if count_consonants(word) == n:\n            result.append(word)\n    return result"}
