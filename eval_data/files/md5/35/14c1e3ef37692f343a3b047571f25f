alse\n\n    if not _is_valid_month_range(month):\n        return False\n\n    max_days = _get_max_days_in_month(month)\n    if not _is_valid_day_range(day, max_days):\n        return False\n\n    return True", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/125": [{"task_id": "HumanEval/125", "solution": "def split_words(txt):\n    '''\n    Given a string of words, return a list of words split on whitespace, if no whitespaces exists in the text you\n    should split on commas ',' if no commas exists you should return the number of lower-case letters with odd order in the\n    alphabet, ord('a') = 0, ord('b') = 1, ... ord('z') = 25\n    Examples\n    split_words(\"Hello world!\") \u279e [\"Hello\", \"world!\"]\n    split_words(\"Hello,world!\") \u279e [\"Hello\", \"world!\"]\n    split_words(\"abcdef\") == 3 \n    '''\n\n    def _contains_whitespace(text):\n        \"\"\"Checks if a string contains any whitespace characters.\"\"\"\n        return any(c.isspace() for c in text)\n\n    def _contains_comma(text):\n        \"\"\"Checks if a string contains a comma character.\"\"\"\n        return ',' in text\n\n    def _split_by_whitespace(text):\n        \"\"\"Splits a string by whitespace into a list of words.\"\"\"\n        return text.split()\n\n    def _split_by_comma(text):\n        \"\"\"Splits a string by commas into a list of words.\"\"\"\n        return text.split(',')\n\n    def _count_odd_order_lowercase_letters(text):\n        \"\"\"Counts lowercase letters with an odd alphabetical order.\"\"\"\n        count = 0\n        for char in text:\n            if 'a' <= char <= 'z': # Check if char is a lowercase letter.\n                # Count if the alphabetical order (0-indexed) is odd.\n                if (ord(char) - ord('a')) % 2 == 1:\n                    count += 1\n        return count\n\n    if _contains_whitespace(txt):\n        return _split_by_whitespace(txt)\n    elif _contains_comma(txt):\n        return _split_by_comma(txt)\n    else:\n        return _count_odd_order_lowercase_letters(txt)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/126": [{"task_id": "HumanEval/126", "solution": "def is_sorted(lst):\n    '''\n    Given a list of numbers, return whether or not they are sorted\n    in ascending order. If list has more than 1 duplicate of the same\n    number, return False. Assume no negative numbers and only integers.\n    '''\n    n = len(lst)\n\n    # Check for ascending order\n    for i in range(n - 1):\n        if lst[i] > lst[i+1]:\n            return False\n\n    # Check for excessive duplicates\n    counts = {}\n    for num in lst:\n        counts[num] = counts.get(num, 0) + 1\n        if counts[num] > 2:\n            return False\n\n    return True", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/127": [{"task_id": "HumanEval/127", "solution": "from typing import Tuple, Optional\nclass Interval:\n    \"\"\"Represents a closed interval [start, end].\"\"\"\n    def __init__(self, start: int, end: int):\n        self.start = start\n        self.end = end\n\n    def __repr__(self):\n        return f\"Interval({self.start}, {self.end})\"\ndef _calculate_intersection(interval1: Interval, interval2: Interval) -> Optional[Interval]:\n    \"\"\"Calculates the intersection of two intervals. Returns None if no intersection.\"\"\"\n    intersect_start = max(interval1.start, interval2.start)\n    intersect_end = min(interval1.end, interval2.end)\n\n    if intersect_start > intersect_end:\n        return None\n    else:\n        return Interval(intersect_start, intersect_end)\ndef _calculate_length(interval: Interval) -> int:\n    \"\"\"Calculates the length of an interval [start, end] as end - start + 1.\"\"\"\n    return interval.end - interval.start + 1\ndef _is_prime(number: int) -> bool:\n    \"\"\"Determines if a number is prime (natural number > 1 with only 1 and itself as divisors).\"\"\"\n    if number <= 1:\n        return False\n    i = 2\n    while i * i <= number:\n        if number % i == 0:\n            return False\n        i += 1\n    return True\ndef intersection(interval1: Tuple[int, int], interval2: Tuple[int, int]) -> str:\n    \"\"\"Determines if the length of the intersection of two intervals is a prime number.\"\"\"\n    int1_obj = Interval(interval1[0], interval1[1])\n    int2_obj = Interval(interval2[0], interval2[1])\n\n    intersecting_interval = _calculate_intersection(int1_obj, int2_obj)\n\n    if intersecting_interval is None:\n        return \"NO\"\n\n    length = _calculate_length(intersecting_interval)\n\n    if _is_prime(length):\n        return \"YES\"\n    else:\n        return \"NO\"", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[[-1, 1], [0, 4]]], "plus_fail_tests": [[[10, 20], [15, 25]]]}], "HumanEval/128": [{"task_id": "HumanEval/128", "solution": "def prod_signs(arr):\n    \"\"\"\n    You are given an array arr of integers and you need to return\n    sum of magnitudes of integers multiplied by product of all signs\n    of each number in the array, represented by 1, -1 or 0.\n    Note: return None for empty arr.\n    \"\"\"\n    if not arr:\n        return None\n\n    def _get_sign(number):\n        \"\"\"Returns the sign of a number: 1 for positive, -1 for negative, 0 for zero.\"\"\"\n        if number > 0:\n            return 1\n        elif number < 0:\n            return -1\n        else:\n            return 0\n\n    def _get_magnitude(number):\n        \"\"\"Returns the absolute value (magnitude) of a number.\"\"\"\n        return abs(number)\n\n    product_of_signs = 1\n    sum_of_magnitudes = 0\n\n    for num in arr:\n        product_of_signs *= _get_sign(num)\n        sum_of_magnitudes += _get_magnitude(num)\n\n    return sum_of_magnitudes * product_of_signs", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus