ages the state and application of space replacement rules to a string.\"\"\"\n    def __init__(self, text: str):\n        self._original_value = text\n        self._processed_value = text\n\n    def apply_space_replacement_rules(self) -> None:\n        \"\"\"Applies all defined space replacement rules sequentially to _processed_value.\n        The order of rules is crucial: 3+ spaces, then 2 spaces, then 1 space.\"\"\"\n        rules = [\n            SpaceReplacementRule(r\"   +\", \"-\"),  # Three or more consecutive spaces\n            SpaceReplacementRule(r\"  \", \"__\"),   # Exactly two consecutive spaces\n            SpaceReplacementRule(r\" \", \"_\"),     # Single space\n        ]\n        for rule in rules:\n            self._processed_value = rule.apply(self._processed_value)\n\n    def get_processed_value(self) -> str:\n        \"\"\"Returns the final processed string.\"\"\"\n        return self._processed_value\ndef fix_spaces(text):\n    \"\"\"\n    Given a string text, replace all spaces in it with underscores, \n    and if a string has more than 2 consecutive spaces, \n    then replace all consecutive spaces with - \n    \"\"\"\n    text_obj = Text(text)\n    text_obj.apply_space_replacement_rules()\n    return text_obj.get_processed_value()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/143": [{"task_id": "HumanEval/143", "solution": "def is_prime(n):\n    \"\"\"\n    Checks if a number is prime.\n    \"\"\"\n    if n <= 1:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n    i = 3\n    while i * i <= n:\n        if n % i == 0:\n            return False\n        i += 2\n    return True\ndef words_in_sentence(sentence):\n    \"\"\"\n    Filters words from a sentence whose lengths are prime numbers.\n    \"\"\"\n    words = sentence.split()\n    prime_length_words = []\n\n    for word in words:\n        if is_prime(len(word)):\n            p