1_or_13(i):\n            total_count += _count_digit_occurrences(i, 7)\n    return total_count", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/36", "solution": "def fizz_buzz(n: int):\n    \"\"\"Counts digit '7' in numbers less than n, divisible by 11 or 13.\n    This function iterates numbers from 1 to n-1, applying divisibility and digit counting checks.\"\"\"\n\n    def _is_divisible_by_11(num: int) -> bool:\n        \"\"\"Checks if a number is divisible by 11.\"\"\"\n        return num % 11 == 0\n\n    def _is_divisible_by_13(num: int) -> bool:\n        \"\"\"Checks if a number is divisible by 13.\"\"\"\n        return num % 13 == 0\n\n    def _is_divisible_by_11_or_13(num: int) -> bool:\n        \"\"\"Checks if a number is divisible by 11 or 13.\"\"\"\n        return _is_divisible_by_11(num) or _is_divisible_by_13(num)\n\n    def _count_digit_seven(num: int) -> int:\n        \"\"\"Counts occurrences of the digit '7' in a number.\"\"\"\n        count = 0\n        for digit_char in str(num):\n            if digit_char == '7':\n                count += 1\n        return count\n\n    total_count = 0\n    for num in range(1, n):\n        if _is_divisible_by_11_or_13(num):\n            total_count += _count_digit_seven(num)\n\n    return total_count", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/67": [{"task_id": "HumanEval/67", "solution": "import re\ndef fruit_distribution(s: str, n: int) -> int:\n    \"\"\"\n    Calculates the number of mango fruits given a string describing apples and oranges\n    and the total number of fruits. It extracts fruit counts and ensures a non-negative result.\n    \"\"\"\n\n    # FR1: Extract the number of apples from the input string s.\n    apple_match = re.search(r\"(\\d+)\\s*apples\", s)\n    apple_count = int(apple_match.group(1)) if apple_match else 0\n\n    # FR2: Extract the number of oranges from the input string s.\n    orange_match = re.search(r\"(\\d+)\\s*oranges\", s)\n    orange_count = int(orange_match.group(1)) if orange_match else 0\n\n    # FR3: Calculate the total number of apples and oranges.\n    total_apples_oranges = apple_count + orange_count\n\n    # FR4: Subtract the total from n to find mango fruits, ensuring the result is non-negative.\n    mango_count = max(0, n - total_apples_oranges)\n\n    # FR5: Return the calculated number of mango fruits.\n    return mango_count", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/67", "solution": "import re\ndef fruit_distribution(s, n):\n    \"\"\"\n    Calculates the number of mango fruits given a string of apple/orange counts and total fruits.\n    It parses the string to extract apple and orange counts, then subtracts their sum from the total.\n    \"\"\"\n    match = re.search(r'(\\d+) apples and (\\d+) oranges', s)\n\n    apple_count = int(match.group(1))\n    orange_count = int(match.group(2))\n\n    mango_count = n - (apple_count + orange_count)\n\n    return mango_count", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/68": [{"task_id": "HumanEval/68", "solution": "def pluck(arr):\n    \"\"\"\n    Identifies the smallest even value and its first occurrence index from an array.\n    Returns an empty list if the array is empty or contains no even values.\n    \"\"\"\n    # 1. Input Validation: Check if the array is empty.\n    if not arr:\n        return []\n\n    # 2. Initialization:\n    # smallest_even_value will be set to positive infinity.\n    # smallest_even_index will be set to -1.\n    smallest_even_value = float('inf')\n    smallest_even_index = -1\n\n    # 3. Iteration and Identification:\n    for index, value in enumerate(arr):\n        # Check if the value is even.\n        if value % 2 == 0:\n            # If value is strictly less than smallest_even_value, update both.\n            if value < smallest_even_value:\n                smallest_even_value = value\n                smallest_even_index = index\n            # If value is equal to smallest_even_value and a smaller index is found, update the index.\n            # (Note: This `index < smallest_even_index` condition will never be true\n            # if `smallest_even_index` always stores the first occurrence for a value.)\n            elif value == smallest_even_value and index < smallest_even_index:\n                smallest_even_index = index\n\n    # 4. Result Formulation:\n    # If no even values were found, return an empty list.\n    if smallest_even_index == -1:\n        return []\n    # Otherwise, return the smallest even value and its index.\n    else:\n        return [smallest_even_value, smallest_even_index]", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/68", "solution": "def pluck(arr: list[int]) -> list[int]:\n    \"\"\"\n    Finds the smallest even-valued node with the smallest index in a non-negative integer array.\n    Returns [value, index] or an empty list if no even values are found or the array is empty.\n    \"\"\"\n    if not arr:\n        return []\n\n    smallest_even_value = float('inf')\n    smallest_even_index = -1\n\n    for index, value in enumerate(arr):\n        if value % 2 == 0:  # Check if value is even\n            if value < smallest_even_value:\n                smallest_even_value = value\n                smallest_even_index = index\n            elif value == smallest_even_value:\n                # If values are equal, prioritize the smallest index\n                if index < smallest_even_index:\n                    smallest_even_index = index\n\n    if smallest_even_index == -1:\n        return []\n    else:\n        return [smallest_even_value, smallest_even_index]", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}]