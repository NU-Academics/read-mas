e_fail_tests": [], "plus_fail_tests": []}], "HumanEval/154": [{"task_id": "HumanEval/154", "solution": "def _is_substring(main_string: str, sub_string: str) -> bool:\n    \"\"\"Checks if sub_string is a substring of main_string.\"\"\"\n    return sub_string in main_string\ndef _generate_rotations(s: str) -> list[str]:\n    \"\"\"Generates all cyclic rotations of string s.\"\"\"\n    rotations = []\n    n = len(s)\n    if n == 0:\n        return []\n\n    for i in range(n):\n        rotated_s = s[i:] + s[:i]\n        rotations.append(rotated_s)\n    return rotations\ndef cycpattern_check(a: str, b: str) -> bool:\n    \"\"\"\n    Checks if any cyclic rotation of string 'b' is a substring of string 'a'.\n    \"\"\"\n    if not b:\n        return True\n\n    rotations_of_b = _generate_rotations(b)\n\n    for rotation in rotations_of_b:\n        if _is_substring(a, rotation):\n            return True\n    return False", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/154", "solution": "def cycpattern_check(a, b):\n    \"\"\"Checks if the pattern `b` or any of its cyclic rotations is a substring of `a`.\n    This function handles edge cases for empty `b` or when `len(b)` exceeds `len(a)`.\n    \"\"\"\n    if not b:\n        return True\n    if len(b) > len(a):\n        return False\n\n    b_doubled = b + b\n    for i in range(len(b)):\n        rotation_candidate = b_doubled[i : i + len(b)]\n        if rotation_candidate in a:\n            return True\n\n    return False", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/158": [{"task_id": "HumanEval/158", "solution": "def _get_unique_char_count(word: str) -> int:\n    \"\"\"Calculates the number of unique characters in a given string.\n    This function uses a set to efficiently count distinct characters.\n    \"\"\"\n    return len(set(word))\ndef find_max(words: list[str]) -> str:\n    \"\"\"Return