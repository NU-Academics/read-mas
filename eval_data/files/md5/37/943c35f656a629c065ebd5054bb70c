uple[str, bool]]:\n        \"\"\"\n        Parses the input string into a list of (segment_string, is_word) tuples.\n        Words are sequences of non-space characters; spaces are sequences of space characters.\n        \"\"\"\n        segments = []\n        if not text:\n            return segments\n\n        current_segment_start = 0\n        is_current_segment_word = (text[0] != ' ')\n\n        for i in range(1, len(text)):\n            char = text[i]\n            char_is_space = (char == ' ')\n\n            if char_is_space == is_current_segment_word:\n                segments.append((text[current_segment_start:i], is_current_segment_word))\n                current_segment_start = i\n                is_current_segment_word = not char_is_space\n\n        segments.append((text[current_segment_start:len(text)], is_current_segment_word))\n        return segments\n\n    def _sort_word_characters(word: str) -> str:\n        \"\"\"\n        Sorts the characters within a single word string in ascending ASCII order.\n        \"\"\"\n        return \"\".join(sorted(word))\n\n    def _reconstruct_from_segments(segments: list[tuple[str, bool]]) -> str:\n        \"\"\"\n        Concatenates the string values from a list of segments into a single string.\n        \"\"\"\n        return \"\".join(segment[0] for segment in segments)\n\n    segments = _split_into_words_and_spaces(s)\n    processed_segments = []\n    for segment_str, is_word in segments:\n        if is_word:\n            processed_segments.append((_sort_word_characters(segment_str), True))\n        else:\n            processed_segments.append((segment_str, False))\n\n    return _reconstruct_from_segments(processed_segments)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/87": [{"task_id": "HumanEval/87", "solution": "def get_row(lst: list[list[int]], x: int) -> list[tuple[int, int]]:\n    \"\"\"\n    Finds all occurrences of an integer x in a nested list