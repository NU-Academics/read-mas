tes triangle properties and area calculation logic.\"\"\"\n\n    def __init__(self, a: float, b: float, c: float):\n        \"\"\"Initializes a Triangle object with given side lengths.\"\"\"\n        self._side_a = a\n        self._side_b = b\n        self._side_c = c\n\n    def _is_valid_positive_sides(self) -> bool:\n        \"\"\"Checks if all sides are positive numbers.\"\"\"\n        return self._side_a > 0 and self._side_b > 0 and self._side_c > 0\n\n    def _is_valid_triangle_inequality(self) -> bool:\n        \"\"\"Checks if the triangle inequality theorem holds.\"\"\"\n        return (self._side_a + self._side_b > self._side_c and\n                self._side_a + self._side_c > self._side_b and\n                self._side_b + self._side_c > self._side_a)\n\n    def _calculate_semi_perimeter(self) -> float:\n        \"\"\"Calculates the semi-perimeter of the triangle.\"\"\"\n        return (self._side_a + self._side_b + self._side_c) / 2\n\n    def _calculate_raw_area(self, s: float) -> float:\n        \"\"\"Calculates the raw area using Heron's formula.\"\"\"\n        # Heron's formula: A = sqrt(s * (s - a) * (s - b) * (s - c))\n        # Due to floating point inaccuracies, the term inside sqrt might be very slightly negative for degenerate triangles.\n        # However, per design, the inequality check should prevent truly invalid cases.\n        return (s * (s - self._side_a) * (s - self._side_b) * (s - self._side_c)) ** 0.5\n\n    def get_area(self) -> float | int:\n        \"\"\"Validates sides and calculates the rounded area of the triangle.\"\"\"\n        if not self._is_valid_positive_sides():\n            return -1\n        if not self._is_valid_triangle_inequality():\n            return -1\n\n        s = self._calculate_semi_perimeter()\n        raw_area = self._calculate_raw_area(s)\n        return round(raw_area, 2)\ndef triangle_area(a: float, b: float, c: float) -> float | int:\n    \"\"\"\n    Given the lengths of the three sides of a triangle.