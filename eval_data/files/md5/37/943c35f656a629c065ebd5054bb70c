al_index, extension_name in enumerate(extensions):\n        cap_count = 0\n        sm_count = 0\n        for char in extension_name:\n            if 'A' <= char <= 'Z':\n                cap_count += 1\n            elif 'a' <= char <= 'z':\n                sm_count += 1\n\n        current_strength = cap_count - sm_count\n\n        if current_strength > max_strength:\n            max_strength = current_strength\n            best_extension_name = extension_name\n            best_extension_original_index = original_index\n        elif current_strength == max_strength:\n            # Apply tie-breaking rule: choose the one that comes first in the list\n            if original_index < best_extension_original_index:\n                best_extension_name = extension_name\n                best_extension_original_index = original_index\n\n    return f\"{class_name}.{best_extension_name}\"", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/153", "solution": "def _calculate_strength(extension_name: str) -> int:\n    \"\"\"Calculates the strength of an extension name.\n    Strength is uppercase letter count minus lowercase letter count.\"\"\"\n    cap_count = 0\n    sm_count = 0\n    for char in extension_name:\n        if char.isupper():\n            cap_count += 1\n        elif char.islower():\n            sm_count += 1\n    return cap_count - sm_count\ndef Strongest_Extension(class_name: str, extensions: list[str]) -> str:\n    \"\"\"Finds the strongest extension from a list for a given class name.\n    Prioritizes the earliest extension in case of a tie in strength.\"\"\"\n\n    # Initialize with the first extension, assuming extensions list is not empty\n    # and to correctly handle the tie-breaker rule (first in list).\n    strongest_extension_name = extensions[0]\n    max_strength = _calculate_strength(extensions[0])\n\n    # Iterate through the rest of the extensions to find the strongest.\n    for i in range(1, len(extensions)):\n        ext = extensions[i]\n        current_strength = _calculate_strength(ext)\n\n        # If a new extension is strictly stronger, update the strongest.\n        # The '>' comparison inherently preserves the earlier extension if strengths are equal.\n        if current_strength > max_strength:\n            max_strength = current_strength\n            strongest_extension_name = ext\n\n    return f\"{class_name}.{strongest_extension_name}\"", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/155": [{"task_id": "HumanEval/155", "solution": "def even_odd_count(num):\n    \"\"\"Given an integer, return a tuple that has the number of even and odd digits respectively.\n    This function orchestrates the digit counting process using dedicated classes.\"\"\"\n    class Integer:\n        \"\"\"Encapsulates an integer and provides methods for its absolute value and digits.\"\"\"\n        def __init__(self, value: int):\n            self._value = value\n\n        def get_absolute_value(self) -> int:\n            \"\"\"Returns the absolute value of the encapsulated integer.\"\"\"\n            return abs(self._value)\n\n        def get_digits(self) -> list:\n            \"\"\"Extracts and returns a list of Digit objects from the integer's absolute value.\n            It converts the number to a string to iterate through digits.\"\"\"\n            abs_value_str = str(self.get_absolute_value())\n            digits_list = []\n            for char_digit in abs_value_str:\n                digits_list.append(Digit(int(char_digit)))\n            return digits_list\n\n    class Digit:\n        \"\"\"Represents a single digit and provides methods to check its parity.\"\"\"\n        def __init__(self, value: int):\n            self._value = value\n\n        def is_even(self) -> bool:\n            \"\"\"Checks if the digit is even.\"\"\"\n            return self._value % 2 == 0\n\n        def is_odd(self) -> bool:\n            \"\"\"Checks if the digit is odd.\"\"\"\n            return self._value % 2 != 0\n\n    class DigitCountResult:\n        \"\"\"Stores the counts of even and odd digits.\"\"\"\n        def __init__(self, even_count: int, odd_count: int):\n            self.even_count = even_count\n            self.odd_count = odd_count\n\n        def to_tuple(self) -> tuple[int, int]:\n            \"\"\"Converts the counts into a tuple (even_count, odd_count).\"\"\"\n            return (self.even_count, self.odd_count)\n\n    class DigitCounter:\n        \"\"\"Counts even and odd digits from an Integer object.\"\"\"\n        def count_even_odd_digits(self, num_obj: Integer) -> DigitCountResult:\n            \"\"\"Processes an Integer object to count its even and odd digits.\n            It iterates through the digits and increments respective counters.\"\"\"\n            digits_list = num_obj.get_digits()\n            even_count = 0\n            odd_count = 0\n\n            for digit_obj in digits_list:\n                if digit_obj.is_even():\n                    even_count += 1\n                else:\n                    odd_count += 1\n            return DigitCountResult(even_count, odd_count)\n\n    num_obj = Integer(num)\n    counter = DigitCounter()\n    result_obj = counter.count_even_odd_digits(num_obj)\n    output_tuple = result_obj.to_tuple()\n    return output_tuple", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/155", "solution": "def even_odd_count(num):\n    \"\"\"Given an integer. return a tuple that has the number of even and odd digits respectively.\n\n     Example:\n        even_odd_count(-12) ==> (1, 1)\n        even_odd_count(123) ==> (1, 2)\n    \"\"\"\n    even_count = 0\n    odd_count = 0\n\n    # Take the absolute value of the number to handle negative inputs\n    abs_num = abs(num)\n\n    # Handle the case of 0 separately\n    if abs_num == 0:\n        return (1, 0) # 0