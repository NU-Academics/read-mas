{"task_id": "HumanEval/54", "solution": "from dataclasses import dataclass\nfrom typing import Optional, List, Dict, Any\n\nclass Normalizer:\n    \"\"\"Encapsulates string normalization logic based on ignore_case and ignore_whitespace flags.\"\"\"\n    def __init__(self, ignore_case: bool = False, ignore_whitespace: bool = False) -> None:\n        self._ignore_case = bool(ignore_case)\n        self._ignore_whitespace = bool(ignore_whitespace)\n\n    def normalize(self, s: str) -> str:\n        \"\"\"Applies normalization rules to the input string.\"\"\"\n        if self._ignore_whitespace:\n            s = \"\".join(s.split())\n        if self._ignore_case:\n            s = s.casefold()\n        return s\n\n@dataclass(frozen=True)\nclass CharSet:\n    \"\"\"Immutable representation of a set of characters from a string.\"\"\"\n    chars: frozenset[str]\n\n    @classmethod\n    def from_string(cls, s: str, normalizer: Normalizer) -> \"CharSet\":\n        \"\"\"Builds a CharSet from a string after normalization.\"\"\"\n        normalized_s = normalizer.normalize(s)\n        return cls(frozenset(normalized_s))\n\n    def to_list(self) -> List[str]:\n        \"\"\"Returns a deterministic sorted list of characters.\"\"\"\n        return sorted(list(self.chars))\n\n@dataclass\nclass ResultDTO:\n    \"\"\"Data transfer object carrying comparison result and details.\"\"\"\n    same: bool\n    left_set: List[str]\n    right_set: List[str]\n    options: Dict[str, Any]\n\n    def to_json(self) -> Dict[str, Any]:\n        \"\"\"Produces a JSON-serializable dictionary representation.\"\"\"\n        return {\n            \"same\": self.same,\n            \"left_set\": self.left_set,\n            \"right_set\": self.right_set,\n            \"options\": self.options,\n        }\n\nclass CharSetComparator:\n    \"\"\"Core service that compares two strings for same characters using normalization.\"\"\"\n    def __init__(self, normalizer: Optional[Normalizer] = None) -> None:\n        self._normalizer = normalizer or Normalizer()\n\n    def compare(self, left: str, right: str) -> ResultDTO:\n        \"\"\"Performs a full character set comparison and returns a ResultDTO.\"\"\"\n        left_cs = CharSet.from_string(left, self._normalizer)\n        right_cs = CharSet.from_string(right, self._normalizer)\n        same = left_cs.chars == right_cs.chars\n        result = ResultDTO(\n            same=same,\n            left_set=left_cs.to_list(),\n            right_set=right_cs.to_list(),\n            options={\n                \"ignore_case\": self._normalizer._ignore_case,\n                \"ignore_whitespace\": self._normalizer._ignore_whitespace\n            }\n        )\n        return result\n\n    def same_chars(self, left: str, right: str) -> bool:\n        \"\"\"Convenience method returning a boolean result of the character set comparison.\"\"\"\n        return self.compare(left, right).same\n\ndef same_chars(s0: str, s1: str) -> bool:\n    \"\"\"\n    Check if two words have the same characters.\n    \"\"\"\n    comparator = CharSetComparator(normalizer=Normalizer(ignore_case=False, ignore_whitespace=False))\n    return comparator.same_chars(s0, s1)"}
{"task_id": "HumanEval/57", "solution": "from monotonic_checker.services import MonotonicService\nfrom monotonic_checker.repository import InMemorySequenceRepository\nfrom monotonic_checker.utils import Validator\n\n\ndef monotonic(l: list):\n    \"\"\"Return True is list elements are monotonically increasing or decreasing.\n    >>> monotonic([1, 2, 4, 20])\n    True\n    >>> monotonic([1, 20, 4, 10])\n    False\n    >>> monotonic([4, 1, 0, -10])\n    True\n    \"\"\"\n    repo = InMemorySequenceRepository(limit=100)\n    validator = Validator()\n    svc = MonotonicService(repository=repo, validator=validator)\n    return svc.is_monotonic(l)"}
