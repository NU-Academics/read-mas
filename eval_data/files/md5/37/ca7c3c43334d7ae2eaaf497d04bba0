{"task_id": "HumanEval/10", "solution": "def make_palindrome(string: str) -> str:\n    \"\"\" Find the shortest palindrome that begins with a supplied string.\n    Algorithm idea is simple:\n    - Find the longest postfix of supplied string that is a palindrome.\n    - Append to the end of the string reverse of a string prefix that comes before the palindromic suffix.\n    >>> make_palindrome('')\n    ''\n    >>> make_palindrome('cat')\n    'catac'\n    >>> make_palindrome('cata')\n    'catac'\n    \"\"\"\n    if not string:\n        return \"\"\n\n    longest_palindromic_suffix_start_index = 0\n    # Find the earliest start index for the longest palindromic suffix.\n    for i in range(len(string)):\n        suffix = string[i:]\n        if string == suffix[::-1]: # Using string == string[::-1] for is_palindrome logic\n            longest_palindromic_suffix_start_index = i\n            break\n\n    # The prefix is the part of the string before the longest palindromic suffix.\n    prefix_to_reverse = string[:longest_palindromic_suffix_start_index]\n    # Reverse the prefix and append it to the original string.\n    return string + prefix_to_reverse[::-1]"}
{"task_id": "HumanEval/14", "solution": "from typing import List\ndef all_prefixes(string: str) -> List[str]:\n    \"\"\" Return list of all prefixes from shortest to longest of the input string\n    >>> all_prefixes('abc')\n    ['a', 'ab', 'abc']\n    \"\"\"\n    prefixes = []\n    for i in range(1, len(string) + 1):\n        prefixes.append(string[0:i])\n    return prefixes"}
{"task_id": "HumanEval/13", "solution": "class GreatestCommonDivisorFunction:\n    \"\"\"Encapsulates GCD computation logic including validation and Euclidean algorithm.\"\"\"\n    def __init__(self, a: int, b: int):\n        self._a = a\n        self._b = b\n\n    def validateInputs(self) -> bool:\n        \"\"\"Validates that inputs are integers, raising TypeError if not.\"\"\"\n        if not isinstance(self._a, int) or not isinstance(self._b, int):\n            raise TypeError(\"Inputs must be integers.\")\n        return True\n\n    def computeGCD(self) -> int:\n        \"\"\"Computes the greatest common divisor using the Euclidean algorithm, handling zero cases.\"\"\"\n        if self._a == 0 and self._b == 0:\n            raise ValueError(\"GCD of (0, 0) is undefined.\")\n        if self._a == 0:\n            return abs(self._b)\n        if self._b == 0:\n            return abs(self._a)\n\n        x, y = abs(self._a), abs(self._b)\n        while y:\n            x, y = y, x % y\n        return x\ndef greatest_common_divisor(a: int, b: int) -> int:\n    \"\"\" Return a greatest common divisor of two integers a and b\n    >>> greatest_common_divisor(3, 5)\n    1\n    >>> greatest_common_divisor(25, 15)\n    5\n    \"\"\"\n    gcd_func = GreatestCommonDivisorFunction(a, b)\n    gcd_func.validateInputs()\n    result = gcd_func.computeGCD()\n    return result"}
{"task_id": "HumanEval/11", "solution": "def _compute_xor(a: str, b: str) -> str:\n    \"\"\"Computes the bitwise XOR of two binary strings of equal length.\"\"\"\n    result_chars = []\n    for i in range(len(a)):\n        if a[i] != b[i]:\n            result_chars.append('1')\n        else:\n            result_chars.append('0')\n    return ''.join(result_chars)\ndef string_xor(a: str, b: str) -> str:\n    \"\"\" Input are two strings a and b consisting only of 1s and 0s.\n    Perform binary XOR on these inputs and return result also as a string.\n    >>> string_xor('010', '110')\n    '100'\n    \"\"\"\n    if not a and not b:\n        return ''\n\n    _validate_chars('a', a)\n    _validate_chars('b', b)\n    _validate_lengths(a, b)\n\n    return _compute_xor(a, b)"}
{"task_id": "HumanEval/17", "solution": "from typing import List\nBEAT_MAPPING: dict = {'o': 4, 'o|': 2, '.|': 1}\ndef parse_music(music_string: str) -> List[int]:\n    \"\"\" Input to this function is a string representing musical notes in a special ASCII format.\n    Your task is to parse this string and return list of integers corresponding to how many beats does each\n    not last.\n\n    Here is a legend:\n    'o' - whole note, lasts four beats\n    'o|' - half note, lasts two beats\n    '.|' - quater note, lasts one beat\n\n    >>> parse_music('o o| .| o| o| .| .| .| .| o o')\n    [4, 2, 1, 2, 2, 1, 1, 1, 1, 4, 4]\n    \"\"\"\n    if not music_string.strip():\n        return []\n\n    tokens = music_string.split()\n    result: List[int] = []\n\n    for token in tokens:\n        if token not in BEAT_MAPPING:\n            raise ValueError(f\"Invalid token: {token}\")\n        result.append(BEAT_MAPPING[token])\n\n    return result"}
{"task_id": "HumanEval/18", "solution": "def how_many_times(string: str, substring: str) -> int:\n    \"\"\" Find how many times a given substring can be found in the original string. Count overlaping cases.\n    >>> how_many_times('', 'a')\n    0\n    >>> how_many_times('aaa', 'a')\n    3\n    >>> how_many_times('aaaa', 'aa')\n    3\n    \"\"\"\n    count = 0\n    n = len(string)\n    m = len(substring)\n\n    # Behavior for empty substring is unspecified; return 0 to prevent complex edge cases\n    # and align with scanning only when substring length > 0.\n    if m == 0:\n        return 0\n\n    for i in range(n - m + 1):\n        if string[i:i+m] == substring:\n            count += 1\n    return count"}
{"task_id": "HumanEval/16", "solution": "from dataclasses import dataclass\nfrom typing import Set\nclass DistinctCharacterCounter:\n    \"\"\"A stateless domain service to compute the number of distinct characters.\"\"\"\n    def count_distinct_characters(self, input_string: InputString) -> int:\n        \"\"\"Iterates through characters, casefolds them, and adds to a set to find distinct count.\"\"\"\n        distinct_chars: Set[str] = set()\n        for char in input_string.value:\n            distinct_chars.add(char.casefold())\n        return len(distinct_chars)\ndef count_distinct_characters(string: str) -> int:\n    \"\"\" Given a string, find out how many distinct characters (regardless of case) does it consist of\n    >>> count_distinct_characters('xyzXYZ')\n    3\n    >>> count_distinct_characters('Jerry')\n    4\n    \"\"\"\n    input_str_obj = InputString(value=string)\n    counter = DistinctCharacterCounter()\n    count = counter.count_distinct_characters(input_str_obj)\n    return count"}
