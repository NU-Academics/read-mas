{"task_id": "HumanEval/3", "solution": "from typing import List\nclass Account:\n    \"\"\"Maintains and exposes the account balance.\"\"\"\n    def __init__(self):\n        self.balance = 0\n\n    def getBalance(self) -> int:\n        \"\"\"Returns the current balance.\"\"\"\n        return self.balance\n\n    def updateBalance(self, amount: int) -> None:\n        \"\"\"Adds amount to balance (positive deposit increases, negative decreases).\"\"\"\n        self.balance += amount\nclass TransactionProcessor:\n    \"\"\"Processes a sequence of operations and detects if balance ever falls below zero.\"\"\"\n    def __init__(self):\n        self.account = Account()\n\n    def process(self, operations: List[int]) -> bool:\n        \"\"\"Sequentially applies operations and returns True if balance falls below zero.\"\"\"\n        for amount in operations:\n            self.account.updateBalance(amount)\n            if self.account.getBalance() < 0:\n                return True\n        return False\ndef below_zero(operations: List[int]) -> bool:\n    \"\"\" You're given a list of deposit and withdrawal operations on a bank account that starts with\n    zero balance. Your task is to detect if at any point the balance of account fallls below zero, and\n    at that point function should return True. Otherwise it should return False.\n    >>> below_zero([1, 2, 3])\n    False\n    >>> below_zero([1, 2, -4, 5])\n    True\n    \"\"\"\n    processor = TransactionProcessor()\n    return processor.process(operations)"}
{"task_id": "HumanEval/2", "solution": "class NumberInput:\n    def __init__(self, value: float):\n        self.value = value\n\n    def isPositive(self) -> bool:\n        return self.value > 0\n\n    def isInteger(self) -> bool:\n        return self.value == int(self.value)\nclass TruncationService:\n    def truncate(self, number: float) -> float:\n        num_input = NumberInput(number)\n        if num_input.isInteger():\n            return 0.0\n        return self.decimalPart(number)\n\n    def integerPart(self, number: float) -> int:\n        return int(number)\n\n    def decimalPart(self, number: float) -> float:\n        int_part = self.integerPart(number)\n        return number - int_part\ndef truncate_number(number: float) -> float:\n    \"\"\" Given a positive floating point number, it can be decomposed into\n    and integer part (largest integer smaller than given number) and decimals\n    (leftover part always smaller than 1).\n\n    Return the decimal part of the number.\n    >>> truncate_number(3.5)\n    0.5\n    \"\"\"\n    service = TruncationService()\n    return service.truncate(number)"}
{"task_id": "HumanEval/5", "solution": "from typing import List\ndef intersperse(numbers: List[int], delimeter: int) -> List[int]:\n    \"\"\" Insert a number 'delimeter' between every two consecutive elements of input list `numbers'\n    >>> intersperse([], 4)\n    []\n    >>> intersperse([1, 2, 3], 4)\n    [1, 4, 2, 4, 3]\n    \"\"\"\n    if not numbers:\n        return []\n    if len(numbers) == 1:\n        return list(numbers)  # Return a shallow copy as specified by FR4 (or original)\n\n    result = [numbers[0]]\n    for i in range(1, len(numbers)):\n        result.append(delimeter)\n        result.append(numbers[i])\n    return result"}
{"task_id": "HumanEval/7", "solution": "def filter_by_substring(strings: List[str], substring: str) -> List[str]:\n    \"\"\" Filter an input list of strings only for ones that contain given substring\n    >>> filter_by_substring([], 'a')\n    []\n    >>> filter_by_substring(['abc', 'bacd', 'cde', 'array'], 'a')\n    ['abc', 'bacd', 'array']\n    \"\"\"\n    result: List[str] = []\n    for s in strings:\n        if substring in s:\n            result.append(s)\n    return result"}
{"task_id": "HumanEval/6", "solution": "from typing import List\nclass ParenString:\n    \"\"\"Represents the raw input string and produces ParenGroup tokens.\"\"\"\n    def __init__(self, raw: str) -> None:\n        self.raw = raw\n\n    def split(self) -> List['ParenGroup']:\n        \"\"\"Splits the raw string into ParenGroup instances by spaces.\"\"\"\n        groups: List[ParenGroup] = []\n        for i, text in enumerate(self.raw.split(' ')):\n            groups.append(ParenGroup(text, i))\n        return groups\nclass ParenGroup:\n    \"\"\"Represents one contiguous non-space token and holds its computed maxDepth and index.\"\"\"\n    def __init__(self, text: str, index: int) -> None:\n        self.text = text\n        self.index = index\n        self.maxDepth = 0\n\n    def isValid(self) -> bool:\n        \"\"\"Performs basic validation for the group (e.g., non-empty).\"\"\"\n        return self.text != ''\nclass DepthCalculator:\n    \"\"\"Computes the maximum nesting depth for a given ParenGroup.\"\"\"\n    def computeMaxDepth(self, group: 'ParenGroup') -> int:\n        \"\"\"Scans group's text to find the maximum nesting depth.\"\"\"\n        current_depth = 0\n        max_depth = 0\n        for char in group.text:\n            if char == '(':\n                current_depth += 1\n                max_depth = max(max_depth, current_depth)\n            elif char == ')':\n                current_depth -= 1\n        return max_depth\nclass DepthResult:\n    \"\"\"Container for the ordered list of computed depths.\"\"\"\n    def __init__(self, depths: List[int]) -> None:\n        self.depths = depths\ndef parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\" Input to this function is a string represented multiple groups for nested parentheses separated by spaces.\n    For each of the group, output the deepest level of nesting of parentheses.\n    E.g. (()()) has maximum two levels of nesting while ((())) has three.\n\n    >>> parse_nested_parens('(()()) ((())) () ((())()())')\n    [2, 3, 1, 3]\n    \"\"\"\n    ps = ParenString(raw=paren_string)\n    groups = ps.split()\n    calculator = DepthCalculator()\n    computed_depths: List[int] = []\n\n    for g in groups:\n        depth = calculator.computeMaxDepth(g)\n        g.maxDepth = depth\n        computed_depths.append(depth)\n\n    result = DepthResult(depths=computed_depths)\n    return result.depths"}
{"task_id": "HumanEval/4", "solution": "from typing import List\nclass InputNumbers:\n    def __init__(self, numbers: List[float]) -> None:\n        self.numbers = numbers\nclass MeanCalculator:\n    def compute_mean(self, numbers: List[float]) -> float:\n        return sum(numbers) / len(numbers)\nclass AbsoluteDifferenceCalculator:\n    def compute_abs_differences(self, numbers: List[float], mean: float) -> List[float]:\n        return [abs(x - mean) for x in numbers]\nclass MADCalculator:\n    def compute_mad(self, abs_differences: List[float]) -> float:\n        return sum(abs_differences) / len(abs_differences)\ndef mean_absolute_deviation(numbers: List[float]) -> float:\n    \"\"\" For a given list of input numbers, calculate Mean Absolute Deviation\n    around the mean of this dataset.\n    Mean Absolute Deviation is the average absolute difference between each\n    element and a centerpoint (mean in this case):\n    MAD = average | x - x_mean |\n    >>> mean_absolute_deviation([1.0, 2.0, 3.0, 4.0])\n    1.0\n    \"\"\"\n    input_numbers = InputNumbers(numbers)\n    mean = MeanCalculator().compute_mean(input_numbers.numbers)\n    abs_diffs = AbsoluteDifferenceCalculator().compute_abs_differences(input_numbers.numbers, mean)\n    mad_value = MADCalculator().compute_mad(abs_diffs)\n    return float(mad_value)"}
{"task_id": "HumanEval/1", "solution": "from typing import List\nclass InputString:\n    \"\"\"Encapsulates raw input and provides a normalized parentheses-only string.\"\"\"\n    def __init__(self, raw: str) -> None:\n        self.raw = raw\n\n    def normalize(self) -> str:\n        \"\"\"Returns the raw string with all whitespace removed.\"\"\"\n        return self.raw.replace(' ', '')\nclass ParenthesisGroup:\n    \"\"\"Represents an extracted top-level balanced parenthesis group.\"\"\"\n    def __init__(self, content: str) -> None:\n        self.content = content\n        self.nestingDepth: int = 0\n\n    def isBalanced(self) -> bool:\n        \"\"\"Checks if the content of the group is balanced.\"\"\"\n        balance = 0\n        for char in self.content:\n            if char == '(':\n                balance += 1\n            elif char == ')':\n                balance -= 1\n            if balance < 0:\n                return False\n        return balance == 0\nclass ResultList:\n    \"\"\"Collects ParenthesisGroup instances and converts them to a List[str].\"\"\"\n    def __init__(self) -> None:\n        self.groups: List[ParenthesisGroup] = []\n\n    def append(self, group: 'ParenthesisGroup') -> None:\n        \"\"\"Adds a ParenthesisGroup to the list.\"\"\"\n        self.groups.append(group)\n\n    def to_list(self) -> List[str]:\n        \"\"\"Returns a list of content strings from the collected groups.\"\"\"\n        return [group.content for group in self.groups]\nclass Parser:\n    \"\"\"Scans input to extract balanced parenthesis groups.\"\"\"\n    def __init__(self) -> None:\n        self._balance_counter: int = 0\n        self._current_buffer: str = ''\n\n    def separate_paren_groups(self, paren_string: str) -> List[str]:\n        \"\"\"Separates top-level balanced parenthesis groups from the input string.\"\"\"\n        input_string_obj = InputString(paren_string)\n        normalized_string = input_string_obj.normalize()\n\n        result_list_obj = ResultList()\n\n        self._balance_counter = 0\n        self._current_buffer = ''\n\n        for char in normalized_string:\n            self._current_buffer += char\n            if char == '(':\n                self._balance_counter += 1\n            elif char == ')':\n                self._balance_counter -= 1\n\n            if self._balance_counter == 0:\n                group = ParenthesisGroup(self._current_buffer)\n                result_list_obj.append(group)\n                self._current_buffer = ''\n        \n        return result_list_obj.to_list()\ndef separate_paren_groups(paren_string: str) -> List[str]:\n    \"\"\" Input to this function is a string containing multiple groups of nested parentheses. Your goal is to\n    separate those group into separate strings and return the list of those.\n    Separate groups are balanced (each open brace is properly closed) and not nested within each other\n    Ignore any spaces in the input string.\n    >>> separate_paren_groups('( ) (( )) (( )( ))')\n    ['()', '(())', '(()())']\n    \"\"\"\n    parser = Parser()\n    return parser.separate_paren_groups(paren_string)"}
{"task_id": "HumanEval/0", "solution": "from typing import List\ndef validate_count(numbers: List[float]) -> bool:\n    \"\"\"Validate that the list contains at least two numbers.\"\"\"\n    return len(numbers) >= 2\ndef is_close(a: float, b: float, threshold: float) -> bool:\n    \"\"\"Check if two numbers are closer to each other than the given threshold.\"\"\"\n    return abs(a - b) < threshold\ndef evaluate(numbers: List[float], threshold: float) -> bool:\n    \"\"\"Determine if any two numbers in a sorted list are closer than the threshold.\"\"\"\n    sorted_numbers = sorted(numbers)\n    for i in range(len(sorted_numbers) - 1):\n        if is_close(sorted_numbers[i], sorted_numbers[i+1], threshold):\n            return True\n    return False\ndef has_close_elements(numbers: List[float], threshold: float) -> bool:\n    \"\"\" Check if in given list of numbers, are any two numbers closer to each other than\n    given threshold.\n    >>> has_close_elements([1.0, 2.0, 3.0], 0.5)\n    False\n    >>> has_close_elements([1.0, 2.8, 3.0, 4.0, 5.0, 2.0], 0.3)\n    True\n    \"\"\"\n    if not validate_count(numbers):\n        return False\n    return evaluate(numbers, threshold)"}
{"task_id": "HumanEval/9", "solution": "def rolling_max(numbers: List[int]) -> List[int]:\n    \"\"\" From a given list of integers, generate a list of rolling maximum element found until given moment\n    in the sequence.\n    >>> rolling_max([1, 2, 3, 2, 3, 4, 2])\n    [1, 2, 3, 3, 3, 4, 4]\n    \"\"\"\n    if not numbers:\n        return []\n\n    result = []\n    current_max = numbers[0]\n    result.append(current_max)\n\n    for number in numbers[1:]:\n        current_max = max(current_max, number)\n        result.append(current_max)\n    \n    return result"}
{"task_id": "HumanEval/8", "solution": "def sum_product(numbers: List[int]) -> Tuple[int, int]:\n    \"\"\" For a given list of integers, return a tuple consisting of a sum and a product of all the integers in a list.\n    Empty sum should be equal to 0 and empty product should be equal to 1.\n    >>> sum_product([])\n    (0, 1)\n    >>> sum_product([1, 2, 3, 4])\n    (10, 24)\n    \"\"\"\n    total_sum = 0\n    total_product = 1\n\n    for number in numbers:\n        total_sum += number\n        total_product *= number\n\n    return (total_sum, total_product)"}
{"task_id": "HumanEval/12", "solution": "from typing import List, Optional\ndef longest(strings: List[str]) -> Optional[str]:\n    \"\"\" Out of list of strings, return the longest one. Return the first one in case of multiple\n    strings of the same length. Return None in case the input list is empty.\n    >>> longest([])\n\n    >>> longest(['a', 'b', 'c'])\n    'a'\n    >>> longest(['a', 'bb', 'ccc'])\n    'ccc'\n    \"\"\"\n    if not strings:\n        return None\n    max_index = 0\n    max_len = len(strings[0])\n    for i, s in enumerate(strings):\n        l = len(s)\n        if l > max_len:\n            max_len = l\n            max_index = i\n    return strings[max_index]"}
