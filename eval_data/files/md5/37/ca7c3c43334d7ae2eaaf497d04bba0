{"task_id": "HumanEval/36", "solution": "from typing import List\nclass DigitCounter:\n    \"\"\"Stateless utility for counting digit occurrences.\"\"\"\n    def countDigit(self, number: int, digit: int) -> int:\n        \"\"\"Count occurrences of a digit in a number's decimal representation.\"\"\"\n        return str(abs(number)).count(str(digit))\nclass IntegerNumber:\n    \"\"\"Represents an integer value with divisibility and delegated digit counting operations.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def divisibleBy(self, d: int) -> bool:\n        \"\"\"Check if the integer is divisible by d.\"\"\"\n        return (self.value % d) == 0\n\n    def countDigitOccurrences(self, digit: int, counter: 'DigitCounter') -> int:\n        \"\"\"Count occurrences of a specific digit using a DigitCounter.\"\"\"\n        return counter.countDigit(self.value, digit)\nclass IntegerSequence:\n    \"\"\"Generates a sequence of IntegerNumber instances.\"\"\"\n    def generate(self, n: int) -> List[IntegerNumber]:\n        \"\"\"Produce IntegerNumber(i) for i in range(max(0, n)).\"\"\"\n        return [IntegerNumber(i) for i in range(max(0, n))]\nclass FizzBuzzService:\n    \"\"\"Orchestrates iteration, filtering, counting, and summation.\"\"\"\n    def __init__(self, divisors: List[int] = [11, 13], digit: int = 7):\n        self.divisors = divisors\n        self._digit = digit\n        self._digit_counter = DigitCounter()\n        self._sequence = IntegerSequence()\n\n    def fizz_buzz(self, n: int) -> int:\n        \"\"\"Generate, filter, count digit occurrences, and sum them.\"\"\"\n        total_count = 0\n        numbers = self._sequence.generate(n)\n\n        for num_obj in numbers:\n            is_divisible = False\n            for d in self.divisors:\n                if num_obj.divisibleBy(d):\n                    is_divisible = True\n                    break\n\n            if is_divisible:\n                total_count += num_obj.countDigitOccurrences(self._digit, self._digit_counter)\n        return total_count\ndef fizz_buzz(n: int):\n    \"\"\"Return the number of times the digit 7 appears in integers less than n which are divisible by 11 or 13.\n    >>> fizz_buzz(50)\n    0\n    >>> fizz_buzz(78)\n    2\n    >>> fizz_buzz(79)\n    3\n    \"\"\"\n    service = FizzBuzzService()\n    return service.fizz_buzz(n)"}
{"task_id": "HumanEval/37", "solution": "import collections\nfrom typing import List, Any, Tuple\ndef sort_even(l: list):\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the odd indicies, while its values at the even indicies are equal\n    to the values of the even indicies of l, but sorted.\n    >>> sort_even([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_even([5, 6, 3, 4])\n    [3, 6, 5, 4]\n    \"\"\"\n\n    def extract_even_values(lst: list) -> list:\n        \"\"\"Extracts values at even indices from a list.\"\"\"\n        return [lst[i] for i in range(0, len(lst), 2)]\n\n    def extract_odd_values(lst: list) -> List[Tuple[int, Any]]:\n        \"\"\"Extracts (index, value) tuples for odd indices from a list.\"\"\"\n        return [(i, lst[i]) for i in range(1, len(lst), 2)]\n\n    def sort_ascending(values: list) -> list:\n        \"\"\"Returns a new list with values sorted in ascending order.\"\"\"\n        return sorted(values)\n\n    def merge_sorted_evens(sorted_evens: list, odd_values: List[Tuple[int, Any]], length: int) -> list:\n        \"\"\"Constructs a new list by merging sorted even values and preserved odd values.\"\"\"\n        new_list = [None] * length\n        even_idx_counter = 0\n        for i in range(length):\n            if i % 2 == 0:\n                if even_idx_counter < len(sorted_evens):\n                    new_list[i] = sorted_evens[even_idx_counter]\n                    even_idx_counter += 1\n            else:\n                # Find the corresponding odd value by iterating or using a dict for efficiency.\n                # Given 'odd_values' is a list of tuples, a direct lookup might be slow for large lists.\n                # Since the design context mentions 'for each (index, value) in odd_values, set new_list[index] = value'\n                # and odd_values are extracted in order, we can iterate through it.\n                # A dict comprehension for odd_values might be more robust if odd_values list is not strictly ordered by index.\n                # Given the specific instruction for `merge_sorted_evens`, a temporary dictionary is the clearest way\n                # to map an odd index back to its value from the `odd_values` list of tuples.\n                pass # This needs to be handled after the loop or pre-processed\n\n        # A more straightforward merge is to populate the new list directly.\n        # Initialize new_list with correct length.\n        merged_list = [None] * length\n\n        # Place odd values first\n        for idx, val in odd_values:\n            merged_list[idx] = val\n\n        # Place sorted even values\n        even_val_ptr = 0\n        for i in range(0, length, 2):\n            if even_val_ptr < len(sorted_evens):\n                merged_list[i] = sorted_evens[even_val_ptr]\n                even_val_ptr += 1\n        \n        return merged_list\n\n    if not l:\n        return []\n\n    even_values = extract_even_values(l)\n    odd_values = extract_odd_values(l)\n    sorted_even = sort_ascending(even_values)\n    new_list = merge_sorted_evens(sorted_even, odd_values, len(l))\n\n    return new_list"}
{"task_id": "HumanEval/32", "solution": "import math\nEPSILON = 1e-7\nclass ValidationError(Exception):\n    \"\"\"\n    Exception raised for validation errors in find_zero input.\n    \"\"\"\n    def __init__(self, code: str, message: str):\n        self.code = code\n        self.message = message\n        super().__init__(f\"[{code}] {message}\")\nclass Polynomial:\n    \"\"\"\n    Encapsulates polynomial coefficients (lowest-degree first) and provides evaluation.\n    \"\"\"\n    def __init__(self, coefficients: list):\n        self.coefficients = [float(c) for c in coefficients]\n        self.degree = len(self.coefficients) - 1\n\n    def evaluate(self, x: float) -> float:\n        \"\"\"\n        Evaluates the polynomial at point x. Returns 0.0 for an empty coefficient list.\n        \"\"\"\n        if not self.coefficients:\n            return 0.0\n        \n        result = 0.0\n        for i, coeff in enumerate(self.coefficients):\n            result += coeff * (x ** i)\n        return result\nclass RootFinder:\n    \"\"\"\n    Finds a single root for a polynomial, enforcing validation and deterministic selection.\n    \"\"\"\n    def _bisection_method(self, poly_obj: Polynomial, low: float, high: float) -> float:\n        \"\"\"\n        Finds a root within the interval [low, high] using bisection, assuming a sign change.\n        \"\"\"\n        y_low = poly_obj.evaluate(low)\n        y_high = poly_obj.evaluate(high)\n\n        # Handle cases where an endpoint is already a root or very close.\n        if abs(y_low) < EPSILON:\n            return low\n        if abs(y_high) < EPSILON:\n            return high\n        \n        # Iteratively narrow down the interval\n        for _ in range(100): # Max iterations to ensure convergence or limit computation\n            mid = (low + high) / 2.0\n            y_mid = poly_obj.evaluate(mid)\n\n            if abs(high - low) < EPSILON or abs(y_mid) < EPSILON:\n                return mid\n\n            if y_low * y_mid < 0: # Root is in the left half\n                high = mid\n                # y_high = y_mid (optimization, not strictly needed as y_low always refers to `low`'s eval)\n            else: # Root is in the right half\n                low = mid\n                y_low = y_mid\n        \n        return (low + high) / 2.0 # Return midpoint as best approximation after iterations\n\n    def find_zero(self, xs: list) -> float:\n        \"\"\"\n        Finds a single zero point for the polynomial defined by xs.\n        Enforces validation and returns the smallest real root.\n        \"\"\"\n        n = len(xs)\n\n        # Validation: even number of coefficients\n        if n % 2 != 0:\n            raise ValidationError(code=\"INVALID_LENGTH\", message=\"Coefficient list must have an even number of coefficients.\")\n        \n        # Validation: leading coefficient must be non-zero\n        if n == 0 or abs(xs[-1]) < EPSILON:\n            raise ValidationError(code=\"ZERO_LEADING_COEFFICIENT\", message=\"Leading coefficient must be non-zero.\")\n\n        poly_obj = Polynomial(xs)\n        \n        # Specific handling for linear equation (degree 1)\n        if n == 2: # xs = [b, a] for ax + b = 0\n            return -xs[0] / xs[1]\n\n        # For general odd degree polynomials, find the smallest real root by scanning.\n        # Determine a search interval for roots using Cauchy's bound.\n        max_ratio = 0.0\n        leading_coeff = xs[-1]\n        for i in range(n - 1): \n            max_ratio = max(max_ratio, abs(xs[i] / leading_coeff))\n        \n        # Extend the bound slightly for robustness\n        search_bound = (1.0 + max_ratio) * 1.1\n\n        # Scan the interval to identify all possible root locations.\n        num_scan_steps = 2000 # Number of steps for initial root isolation\n        scan_step_size = (2 * search_bound) / num_scan_steps\n\n        possible_roots = []\n        \n        x_current = -search_bound\n        y_current = poly_obj.evaluate(x_current)\n\n        for _ in range(num_scan_steps + 1):\n            x_prev = x_current\n            y_prev = y_current\n            \n            x_current = min(x_current + scan_step_size, search_bound) # Increment and cap at search_bound\n            y_current = poly_obj.evaluate(x_current)\n\n            # If a root is hit directly within tolerance\n            if abs(y_current) < EPSILON:\n                is_new_root = True\n                for existing_root in possible_roots:\n                    if abs(existing_root - x_current) < EPSILON:\n                        is_new_root = False\n                        break\n                if is_new_root:\n                    possible_roots.append(x_current)\n            # If a sign change indicates a root in the interval [x_prev, x_current]\n            elif y_prev * y_current < 0:\n                root_in_interval = self._bisection_method(poly_obj, x_prev, x_current)\n                is_new_root = True\n                for existing_root in possible_roots:\n                    if abs(existing_root - root_in_interval) < EPSILON:\n                        is_new_root = False\n                        break\n                if is_new_root:\n                    possible_roots.append(root_in_interval)\n            \n            if x_current == search_bound:\n                break # Reached the end of the search range\n\n        # The problem guarantees a solution for valid inputs.\n        # If no roots are found by the scanning method, it indicates an unexpected numerical issue\n        # with the scanning parameters for a given polynomial, which should ideally not happen\n        # for standard polynomial inputs with the chosen step count and bounds.\n        if not possible_roots:\n            raise RuntimeError(\"Internal root-finding algorithm failed to find any root.\")\n\n        # Return the smallest numerically found real root.\n        return min(possible_roots)\ndef find_zero(xs: list):\n    \"\"\" xs are coefficients of a polynomial.\n    find_zero find x such that poly(x) = 0.\n    find_zero returns only only zero point, even if there are many.\n    Moreover, find_zero only takes list xs having even number of coefficients\n    and largest non zero coefficient as it guarantees\n    a solution.\n    >>> round(find_zero([1, 2]), 2) # f(x) = 1 + 2x\n    -0.5\n    >>> round(find_zero([-6, 11, -6, 1]), 2) # (x - 1) * (x - 2) * (x - 3) = -6 + 11x - 6x^2 + x^3\n    1.0\n    \"\"\"\n    rf = RootFinder()\n    return rf.find_zero(xs)"}
{"task_id": "HumanEval/38", "solution": "def decode_cyclic(s: str):\n    \"\"\"\n    takes as input string encoded with encode_cyclic function. Returns decoded string.\n    \"\"\"\n    # split string to groups. Each of length 3.\n    groups = [s[(3 * i):min((3 * i + 3), len(s))] for i in range((len(s) + 2) // 3)]\n    # cycle elements in each group rightward. Unless group has fewer elements than 3.\n    groups = [(group[-1] + group[0:2]) if len(group) == 3 else group for group in groups]\n    return \"\".join(groups)"}
{"task_id": "HumanEval/39", "solution": "class FibonacciNumber:\n    \"\"\"Data holder for a Fibonacci number with its index and value.\"\"\"\n    def __init__(self, index: int, value: int) -> None:\n        self.index = index\n        self.value = value\nclass SequenceGenerator:\n    \"\"\"Generates Fibonacci numbers starting F1=1, F2=1.\"\"\"\n    def __init__(self) -> None:\n        self._a = 0\n        self._b = 1\n        self._index = 0\n\n    def next(self) -> FibonacciNumber:\n        \"\"\"Computes and returns the next Fibonacci number in sequence.\"\"\"\n        self._index += 1\n        if self._index == 1:\n            value = 1 # F1\n            self._a = 0 # Maintain state for next (F2) calculation\n            self._b = 1\n        elif self._index == 2:\n            value = 1 # F2\n            self._a = 1 # Update state for next (F3) calculation\n            self._b = 1\n        else:\n            value = self._a + self._b\n            self._a = self._b\n            self._b = value\n        return FibonacciNumber(self._index, value)\n\n    def reset(self) -> None:\n        \"\"\"Resets the generator to its initial state.\"\"\"\n        self._a = 0\n        self._b = 1\n        self._index = 0\nclass PrimalityTest:\n    \"\"\"Provides a deterministic primality test for integers > 1.\"\"\"\n    def __init__(self) -> None:\n        pass\n\n    def isPrime(self, x: int) -> bool:\n        \"\"\"Checks if a given integer x is prime.\"\"\"\n        if x <= 1:\n            return False\n        if x == 2:\n            return True\n        if x % 2 == 0:\n            return False\n        i = 3\n        while i * i <= x:\n            if x % i == 0:\n                return False\n            i += 2\n        return True\ndef prime_fib(n: int):\n    \"\"\"\n    prime_fib returns n-th number that is a Fibonacci number and it's also prime.\n    >>> prime_fib(1)\n    2\n    >>> prime_fib(2)\n    3\n    >>> prime_fib(3)\n    5\n    >>> prime_fib(4)\n    13\n    >>> prime_fib(5)\n    89\n    \"\"\"\n    if not isinstance(n, int) or n < 1:\n        raise ValueError(\"n must be integer >= 1\")\n\n    gen = SequenceGenerator()\n    tester = PrimalityTest()\n    found_primes_count = 0\n\n    while True:\n        fn = gen.next()\n        if fn.value <= 1: # Values <= 1 are not considered prime.\n            continue\n        \n        if tester.isPrime(fn.value):\n            found_primes_count += 1\n            if found_primes_count == n:\n                return int(fn.value)"}
{"task_id": "HumanEval/40", "solution": "def triples_sum_to_zero(l: list):\n    \"\"\"\n    triples_sum_to_zero takes a list of integers as an input.\n    it returns True if there are three distinct elements in the list that\n    sum to zero, and False otherwise.\n\n    >>> triples_sum_to_zero([1, 3, 5, 0])\n    False\n    >>> triples_sum_to_zero([1, 3, -2, 1])\n    True\n    >>> triples_sum_to_zero([1, 2, 3, 7])\n    False\n    >>> triples_sum_to_zero([2, 4, -5, 3, 9, 7])\n    True\n    >>> triples_sum_to_zero([1])\n    False\n    \"\"\"\n    n = len(l)\n    if n < 3:\n        return False\n\n    for i in range(n - 2):\n        for j in range(i + 1, n - 1):\n            for k in range(j + 1, n):\n                if l[i] + l[j] + l[k] == 0:\n                    return True\n    return False"}
{"task_id": "HumanEval/42", "solution": "def incr_list(l: list):\n    \"\"\"Return list with elements incremented by 1.\n    >>> incr_list([1, 2, 3])\n    [2, 3, 4]\n    >>> incr_list([5, 3, 5, 2, 3, 3, 9, 0, 123])\n    [6, 4, 6, 3, 4, 4, 10, 1, 124]\n    \"\"\"\n    return [e + 1 for e in l]"}
{"task_id": "HumanEval/41", "solution": "class ValidationResult:\n    \"\"\"DTO for validation outcome.\"\"\"\n    def __init__(self, is_valid: bool, error_message: str = \"\"):\n        self.is_valid = is_valid\n        self.error_message = error_message\nclass CollisionResult:\n    \"\"\"DTO for collision computation result.\"\"\"\n    def __init__(self, collisions: int):\n        self.collisions = collisions\nclass Input:\n    \"\"\"Encapsulates raw input and basic validation.\"\"\"\n    def __init__(self, n: int):\n        self.n = n\n\n    def validate(self) -> bool:\n        \"\"\"Checks if n is a non-negative integer.\"\"\"\n        # Adhering to \"DO NOT add isinstance() checks\" and \"DO NOT ... raise exceptions for edge cases\"\n        # The function signature for car_race_collision(n: int) implies n is an int.\n        # Therefore, only the non-negativity constraint needs explicit checking here.\n        return self.n >= 0\nclass CollisionModel:\n    \"\"\"Encapsulates collision computation logic (n * n).\"\"\"\n    def compute_collisions(self, n: int) -> int:\n        \"\"\"Computes total collisions as n * n.\"\"\"\n        return n * n\nclass CollisionSystem:\n    \"\"\"Orchestrates validation and model invocation.\"\"\"\n    def __init__(self):\n        self.model = CollisionModel()\n\n    def process(self, n: int) -> CollisionResult | ValidationResult:\n        \"\"\"Processes input, validates, and computes collisions.\"\"\"\n        input_obj = Input(n)\n        if not input_obj.validate():\n            return ValidationResult(is_valid=False, error_message=\"Input 'n' must be a non-negative integer.\")\n        \n        collisions = self.model.compute_collisions(n)\n        return CollisionResult(collisions)\ndef car_race_collision(n: int):\n    \"\"\"\n    Imagine a road that's a perfectly straight infinitely long line.\n    n cars are driving left to right;  simultaneously, a different set of n cars\n    are driving right to left.   The two sets of cars start out being very far from\n    each other.  All cars move in the same speed.  Two cars are said to collide\n    when a car that's moving left to right hits a car that's moving right to left.\n    However, the cars are infinitely sturdy and strong; as a result, they continue moving\n    in their trajectory as if they did not collide.\n\n    This function outputs the number of such collisions.\n    \"\"\"\n    system = CollisionSystem()\n    result = system.process(n)\n\n    if isinstance(result, CollisionResult):\n        return result.collisions\n    else: # The result must be a ValidationResult per design\n        return result"}
{"task_id": "HumanEval/43", "solution": "def pairs_sum_to_zero(l):\n    \"\"\"\n    pairs_sum_to_zero takes a list of integers as an input.\n    it returns True if there are two distinct elements in the list that\n    sum to zero, and False otherwise.\n    >>> pairs_sum_to_zero([1, 3, 5, 0])\n    False\n    >>> pairs_sum_to_zero([1, 3, -2, 1])\n    False\n    >>> pairs_sum_to_zero([1, 2, 3, 7])\n    False\n    >>> pairs_sum_to_zero([2, 4, -5, 3, 5, 7])\n    True\n    >>> pairs_sum_to_zero([1])\n    False\n    \"\"\"\n    # Handles conceptual InputList, IntegerElement, PairCandidate, and Result.\n    # Returns False for lists with fewer than two elements, per FR5.\n    if len(l) < 2:\n        return False\n\n    # Use a frequency map to count occurrences of each number.\n    # This allows checking for distinct elements (by index) efficiently.\n    num_counts = {}\n    for x in l:\n        num_counts[x] = num_counts.get(x, 0) + 1\n\n    for num, count in num_counts.items():\n        complement = -num\n        if complement in num_counts:\n            # If num is not 0, and its complement exists, we found a pair.\n            # If num is 0, we need at least two zeros (count > 1) to form a distinct pair.\n            if num != 0:\n                return True\n            elif count > 1: # This handles the case of [0, 0]\n                return True\n    return False"}
{"task_id": "HumanEval/44", "solution": "from dataclasses import dataclass\nclass InputValidator:\n    def validate(self, x: int, base: int) -> ValidationResult:\n        if base >= 10:\n            return ValidationResult(is_valid=False, error_message=f\"Base {base} must be less than 10.\")\n        return ValidationResult(is_valid=True, error_message=\"\")\nclass BaseConverter:\n    def convert(self, x: int, base: int) -> str:\n        if x == 0:\n            return '0'\n\n        is_negative = False\n        if x < 0:\n            is_negative = True\n            x = abs(x)\n\n        digits = []\n        while x > 0:\n            remainder = x % base\n            digits.append(str(remainder))\n            x //= base\n\n        result = \"\".join(digits[::-1])\n        if is_negative:\n            result = \"-\" + result\n        return result\ndef change_base(x: int, base: int):\n    \"\"\"Change numerical base of input number x to base.\n    return string representation after the conversion.\n    base numbers are less than 10.\n    >>> change_base(8, 3)\n    '22'\n    >>> change_base(8, 2)\n    '1000'\n    >>> change_base(7, 2)\n    '111'\n    \"\"\"\n    input_obj = Input(x=x, base=base)\n    validation = InputValidator().validate(input_obj.x, input_obj.base)\n    if not validation.is_valid:\n        raise ValueError(validation.error_message)\n    result_str = BaseConverter().convert(input_obj.x, input_obj.base)\n    return result_str"}
{"task_id": "HumanEval/45", "solution": "import math\ndef _is_numeric(obj) -> bool:\n    \"\"\"Checks if the object is an int or float.\"\"\"\n    return isinstance(obj, (int, float))\ndef _is_finite_nonnegative(value) -> bool:\n    \"\"\"Checks if the value is finite and non-negative.\"\"\"\n    return math.isfinite(value) and value >= 0\ndef triangle_area(a, h):\n    \"\"\"Given length of a side and high return area for a triangle.\n    >>> triangle_area(5, 3)\n    7.5\n    \"\"\"\n    if not _is_numeric(a):\n        raise TypeError(\"Side 'a' must be a numeric value (int or float).\")\n    if not _is_numeric(h):\n        raise TypeError(\"Height 'h' must be a numeric value (int or float).\")\n\n    if not _is_finite_nonnegative(a):\n        raise ValueError(\"Side 'a' must be a non-negative and finite number.\")\n    if not _is_finite_nonnegative(h):\n        raise ValueError(\"Height 'h' must be a non-negative and finite number.\")\n\n    return 0.5 * a * h"}
{"task_id": "HumanEval/48", "solution": "def is_palindrome(text: str):\n    \"\"\"\n    Checks if given string is a palindrome\n    >>> is_palindrome('')\n    True\n    >>> is_palindrome('aba')\n    True\n    >>> is_palindrome('aaaaa')\n    True\n    >>> is_palindrome('zbcd')\n    False\n    \"\"\"\n    return text == text[::-1]"}
{"task_id": "HumanEval/47", "solution": "import math\ndef median(l: list):\n    \"\"\"Return median of elements in the list l.\n    >>> median([3, 1, 2, 4, 5])\n    3\n    >>> median([-10, 4, 6, 1000, 10, 20])\n    15.0\n    \"\"\"\n    def _validate_list(l: list) -> None:\n        \"\"\"Raise TypeError or ValueError per design if validation fails; return None on success.\"\"\"\n        if not isinstance(l, list):\n            raise TypeError(\"Input must be a list.\")\n        if not l:\n            raise ValueError(\"Input list cannot be empty.\")\n        for item in l:\n            if not isinstance(item, (int, float)):\n                raise TypeError(\"List elements must be numeric (int or float).\")\n\n    def _sort_ascending(l: list) -> list:\n        \"\"\"Return a new list sorted in ascending order using Python's sorted().\"\"\"\n        return sorted(l)\n\n    def _compute_median_odd(sorted_list: list):\n        \"\"\"Return center element preserving its type (int or float).\"\"\"\n        n = len(sorted_list)\n        return sorted_list[n // 2]\n\n    def _compute_median_even(sorted_list: list) -> float:\n        \"\"\"Return arithmetic mean of two centers as float.\"\"\"\n        n = len(sorted_list)\n        mid1 = sorted_list[n // 2 - 1]\n        mid2 = sorted_list[n // 2]\n        return (mid1 + mid2) / 2.0\n\n    _validate_list(l)\n    sorted_list = _sort_ascending(l)\n    n = len(sorted_list)\n    if n % 2 == 1:\n        return _compute_median_odd(sorted_list)\n    else:\n        return _compute_median_even(sorted_list)"}
{"task_id": "HumanEval/46", "solution": "class InputParameter:\n    def __init__(self, n):\n        self.n = n\n\n    def isValid(self):\n        return isinstance(self.n, int) and self.n >= 0\nclass Fib4Calculator:\n    def compute(self, n: int) -> int:\n        if n == 0:\n            return 0\n        if n == 1:\n            return 0\n        if n == 2:\n            return 2\n        if n == 3:\n            return 0\n\n        _a = 0  # fib4(0)\n        _b = 0  # fib4(1)\n        _c = 2  # fib4(2)\n        _d = 0  # fib4(3)\n\n        for _ in range(4, n + 1):\n            next_val = _d + _c + _b + _a\n            _a, _b, _c, _d = _b, _c, _d, next_val\n        return _d\ndef fib4(n: int):\n    \"\"\"The Fib4 number sequence is a sequence similar to the Fibbonacci sequnece that's defined as follows:\n    fib4(0) -> 0\n    fib4(1) -> 0\n    fib4(2) -> 2\n    fib4(3) -> 0\n    fib4(n) -> fib4(n-1) + fib4(n-2) + fib4(n-3) + fib4(n-4).\n    Please write a function to efficiently compute the n-th element of the fib4 number sequence.  Do not use recursion.\n    >>> fib4(5)\n    4\n    >>> fib4(6)\n    8\n    >>> fib4(7)\n    14\n    \"\"\"\n    ip = InputParameter(n)\n    if not ip.isValid():\n        raise ValueError(\"Invalid input: n must be a non-negative integer\")\n    \n    calc = Fib4Calculator()\n    return calc.compute(n)"}
{"task_id": "HumanEval/49", "solution": "class Validator:\n    \"\"\"Validates inputs for modular exponentiation.\"\"\"\n    def validate(self, n: int, p: int) -> bool:\n        \"\"\"Checks if n and p are valid integers for the calculation.\"\"\"\n        if not isinstance(n, int) or not isinstance(p, int):\n            return False\n        if p <= 0:\n            return False\n        if n < 0: # Recommended assumption per design context\n            return False\n        return True\nclass ModularExponentiation:\n    \"\"\"Performs modular exponentiation using exponentiation by squaring.\"\"\"\n    def compute(self, n: int, p: int) -> int:\n        \"\"\"Calculates (2^n) mod p efficiently.\"\"\"\n        base = 2\n        exponent = n\n        modulus = p\n        result = 1\n\n        base %= modulus # Initialize base correctly for modulus\n\n        while exponent > 0:\n            if exponent % 2 == 1:\n                result = (result * base) % modulus\n            base = (base * base) % modulus\n            exponent //= 2\n        \n        return result\ndef modp(n: int, p: int):\n    \"\"\"Return 2^n modulo p (be aware of numerics).\n    >>> modp(3, 5)\n    3\n    >>> modp(1101, 101)\n    2\n    >>> modp(0, 101)\n    1\n    >>> modp(3, 11)\n    8\n    >>> modp(100, 101)\n    1\n    \"\"\"\n    validator = Validator()\n    if not validator.validate(n, p):\n        raise ValueError(\"Invalid inputs: n must be non-negative int; p must be positive int\")\n\n    value = ModularExponentiation().compute(n, p)\n    return value"}
