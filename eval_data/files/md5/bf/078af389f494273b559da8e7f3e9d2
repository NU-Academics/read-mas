{"task_id": "Mbpp/261", "solution": "class TupleDivisionError(Exception):\n    \"\"\"Base exception for errors in element-wise tuple division.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\nclass TupleLengthMismatchError(TupleDivisionError):\n    \"\"\"Raised when input tuples have different lengths.\"\"\"\n    pass\nclass DivisionByZeroError(TupleDivisionError):\n    \"\"\"Raised when an attempt to divide by zero occurs.\"\"\"\n    pass\nclass NonNumericInputError(TupleDivisionError):\n    \"\"\"Raised when input tuples contain non-numeric elements.\"\"\"\n    pass\ndef division_elements(tuple1: tuple, tuple2: tuple) -> tuple:\n    \"\"\"\n    Performs element-wise mathematical division on two input tuples.\n    Raises custom exceptions for validation failures such as length mismatch, non-numeric input, or division by zero.\n    \"\"\"\n    if len(tuple1) != len(tuple2):\n        raise TupleLengthMismatchError(\"Input tuples must have the same number of elements.\")\n\n    results = []\n    for i in range(len(tuple1)):\n        val1 = tuple1[i]\n        val2 = tuple2[i]\n\n        if not isinstance(val1, (int, float)) or not isinstance(val2, (int, float)):\n            raise NonNumericInputError(f\"Both elements at index {i} must be numeric. Got {type(val1).__name__} and {type(val2).__name__}.\")\n\n        if val2 == 0:\n            raise DivisionByZeroError(f\"Division by zero is not permitted at index {i}.\")\n\n        results.append(val1 / val2)\n\n    return tuple(results)"}
