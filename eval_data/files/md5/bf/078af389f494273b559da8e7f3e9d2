{"task_id": "Mbpp/739", "solution": "def find_Index(n: int) -> int:\n    # Finds the index of the smallest triangular number with 'n' digits.\n    # It iterates through triangular numbers, calculating their value and digit count.\n    \n    # Helper class to encapsulate TriangularNumber logic\n    class TriangularNumber:\n        def __init__(self, index: int):\n            self._index = index\n            self._value = self.calculate_value(index)\n            self._num_digits = self.count_digits(self._value)\n\n        def get_index(self) -> int:\n            return self._index\n\n        def get_value(self) -> int:\n            return self._value\n\n        def get_num_digits(self) -> int:\n            return self._num_digits\n\n        @staticmethod\n        def calculate_value(index: int) -> int:\n            return index * (index + 1) // 2\n\n        @staticmethod\n        def count_digits(value: int) -> int:\n            # Efficiently counts digits for positive integers.\n            if value == 0:\n                return 1\n            count = 0\n            temp_value = value\n            while temp_value > 0:\n                temp_value //= 10\n                count += 1\n            return count\n\n    # Helper function for input validation\n    def validate_n(n: int) -> None:\n        if not isinstance(n, int) or n <= 0:\n            raise ValueError(\"n must be a positive integer.\")\n    \n    validate_n(n) # Validate input n\n\n    k = 1\n    while True:\n        tn = TriangularNumber(k)\n        if tn.get_num_digits() == n:\n            return k\n        k += 1"}
{"task_id": "Mbpp/736", "solution": "def left_insertion(sorted_list: list[int], value: int) -> int:\n    \"\"\"\n    Locates the left insertion point for a specified value in a sorted list.\n    This index 'i' ensures all elements sorted_list[j] for j < i are strictly less than 'value'.\n    \"\"\"\n    low = 0\n    high = len(sorted_list)\n\n    while low < high:\n        mid = (low + high) // 2\n        if sorted_list[mid] < value:\n            low = mid + 1\n        else:\n            high = mid\n    return low"}
