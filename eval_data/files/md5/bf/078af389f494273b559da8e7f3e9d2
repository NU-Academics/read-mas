{"task_id": "Mbpp/388", "solution": "def highest_Power_of_2(n: int) -> int:\n    \"\"\"\n    Calculates the highest power of 2 that is less than or equal to n.\n    If n is less than or equal to 0, returns 0.\n    \"\"\"\n    if n <= 0:\n        return 0\n\n    power = 1\n    while (power << 1) <= n:\n        power <<= 1\n    return power"}
{"task_id": "Mbpp/306", "solution": "def max_sum_increasing_subseq(array: list[int], length: int, i: int, k: int) -> int:\n    \"\"\"\n    Calculates the maximum sum of an increasing subsequence from array[0...i]\n    that includes array[k], ensuring k > i.\n    \"\"\"\n    # Input validation as per design context for bounds and k > i\n    if not (0 <= i < length and 0 <= k < length and k > i):\n        return 0\n\n    # dp[x] stores the maximum sum of an increasing subsequence ending at index x,\n    # considering only elements from array[0...i].\n    dp = [0] * (i + 1)\n\n    # Populate dp array for the prefix array[0...i]\n    for current_idx in range(i + 1):\n        dp[current_idx] = array[current_idx]\n        for prev_idx in range(current_idx):\n            if array[current_idx] > array[prev_idx]:\n                dp[current_idx] = max(dp[current_idx], dp[prev_idx] + array[current_idx])\n\n    # Find the maximum sum from dp array whose last element array[idx] < array[k]\n    max_prefix_sum = 0\n    for idx in range(i + 1):\n        if array[idx] < array[k]:\n            max_prefix_sum = max(max_prefix_sum, dp[idx])\n\n    # The final sum includes array[k]\n    return max_prefix_sum + array[k]"}
{"task_id": "Mbpp/311", "solution": "def set_left_most_unset_bit(integer_input: int) -> int:\n    \"\"\"\n    Sets the leftmost unset bit in the given integer.\n    If all existing bits are set, it sets the next higher bit.\n    \"\"\"\n    current_bit_length = integer_input.bit_length()\n\n    # Iterate from the most significant bit downwards to find the leftmost unset bit.\n    # The loop range handles the case where integer_input is 0 (current_bit_length = 0).\n    for i in range(current_bit_length - 1, -1, -1):\n        # Check if the bit at position 'i' is unset (0).\n        if not ((integer_input >> i) & 1):\n            # If an unset bit is found, set it using a bitwise OR and return.\n            return integer_input | (1 << i)\n\n    # If the loop completes, it means all bits up to `current_bit_length - 1` are already set.\n    # In this case (including when integer_input was 0), set the next highest bit at position `current_bit_length`.\n    return integer_input | (1 << current_bit_length)"}
{"task_id": "Mbpp/389", "solution": "def find_lucas(n: int) -> int:\n    \"\"\"Calculates the n'th Lucas number.\n    Uses an iterative approach based on L0=2, L1=1, and Ln=L(n-1)+L(n-2).\n    \"\"\"\n    if n == 0:\n        return 2\n    if n == 1:\n        return 1\n\n    a, b = 2, 1\n    for _ in range(2, n + 1):\n        a, b = b, a + b\n    return b"}
{"task_id": "Mbpp/391", "solution": "def convert_list_dictionary(list1: list, list2: list, list3: list) -> list:\n    \"\"\"\n    Converts three input lists into a list of nested dictionaries.\n    Raises ValueError if lists are of unequal length.\n    \"\"\"\n    if not (len(list1) == len(list2) == len(list3)):\n        raise ValueError(\"Input lists must have equal lengths.\")\n\n    result = []\n    for outer_key, inner_key, inner_value in zip(list1, list2, list3):\n        nested_dict = {outer_key: {inner_key: inner_value}}\n        result.append(nested_dict)\n    return result"}
