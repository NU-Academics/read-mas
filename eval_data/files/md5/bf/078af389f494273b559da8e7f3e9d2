{"task_id": "Mbpp/643", "solution": "def text_match_wordz_middle(input_string: str) -> bool:\n    \"\"\"\n    Checks if a string contains 'z', except at the start and end of the word.\n    Returns True if 'z' is found at an index i such that 0 < i < length - 1, False otherwise.\n    \"\"\"\n    length = len(input_string)\n    if length < 3:\n        return False\n\n    # Iterate from the second character (index 1) up to the second to last character (index length - 2)\n    for i in range(1, length - 1):\n        if input_string[i] == 'z':\n            return True\n            \n    return False"}
{"task_id": "Mbpp/644", "solution": "def reverse_Array_Upto_K(arr: list, k: int) -> list:\n    \"\"\"Reverses the order of the first 'k' elements of the input array.\n\n    If 'k' is less than or equal to 0, the array is returned unchanged.\n    \"\"\"\n    if k <= 0:\n        return arr[:]\n\n    # Slice the first k elements, reverse them, and concatenate with the rest.\n    # Python's slicing `arr[:k]` handles cases where k is greater than len(arr)\n    # by taking all elements up to the end of the array.\n    reversed_prefix = arr[:k][::-1]\n    suffix = arr[k:]\n    return reversed_prefix + suffix"}
