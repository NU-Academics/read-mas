{"task_id": "Mbpp/428", "solution": "def shell_sort(arr: list[float | int]) -> list[float | int]:\n    \"\"\"\n    Sorts an array of numbers in ascending order using the Shell Sort algorithm.\n    It returns a new list containing the sorted numbers.\n    \"\"\"\n    n = len(arr)\n    if n <= 1:\n        return arr[:] # Return a copy to ensure a \"new list\" even for edge cases\n\n    # Create a mutable copy of the input list\n    mutable_arr = arr[:]\n\n    # Using a simple N/2 gap sequence\n    gap = n // 2\n    while gap > 0:\n        for i in range(gap, n):\n            temp = mutable_arr[i]\n            j = i\n            # Perform insertion sort for current gap\n            while j >= gap and mutable_arr[j - gap] > temp:\n                mutable_arr[j] = mutable_arr[j - gap]\n                j -= gap\n            mutable_arr[j] = temp\n        gap //= 2\n    return mutable_arr"}
{"task_id": "Mbpp/429", "solution": "def and_tuples(tuple1: tuple[int, ...], tuple2: tuple[int, ...]) -> tuple[int, ...]:\n    \"\"\"Performs element-wise bitwise AND on two tuples of integers.\n\n    Returns a new tuple containing the results of the element-wise bitwise AND operations.\n    \"\"\"\n    if len(tuple1) != len(tuple2):\n        raise ValueError(\"Input tuples must be of equal length.\")\n\n    result = []\n    for a, b in zip(tuple1, tuple2):\n        result.append(a & b)\n    return tuple(result)"}
