{"task_id": "Mbpp/68", "solution": "def is_Monotonic(array: list) -> bool:\n    \"\"\"\n    Checks if the given array is monotonic (either increasing or decreasing).\n    An array is monotonic if it is either monotonically increasing or monotonically decreasing.\n    \"\"\"\n    if len(array) <= 1:\n        return True\n\n    is_increasing = True\n    is_decreasing = True\n\n    for i in range(len(array) - 1):\n        if array[i] > array[i+1]:\n            is_increasing = False\n        if array[i] < array[i+1]:\n            is_decreasing = False\n\n    return is_increasing or is_decreasing"}
{"task_id": "Mbpp/67", "solution": "def bell_number(n: int) -> int:\n    \"\"\"\n    Calculates the Bell number for a given non-negative integer input.\n    \"\"\"\n    class IntegerInput:\n        def __init__(self, value: int):\n            if not isinstance(value, int):\n                raise TypeError(\"Input must be an integer.\")\n            if not self.is_non_negative(value):\n                raise ValueError(\"Input must be a non-negative integer.\")\n            self._value = value\n\n        def is_non_negative(self, value: int) -> bool:\n            return value >= 0\n\n        def get_value(self) -> int:\n            return self._value\n\n    class BellNumberCalculator:\n        @staticmethod\n        def calculate(n: int) -> int:\n            if n == 0:\n                return 1\n\n            stirling = [[0] * (n + 1) for _ in range(n + 1)]\n\n            stirling[0][0] = 1\n\n            for i in range(1, n + 1):\n                for j in range(1, i + 1):\n                    stirling[i][j] = stirling[i-1][j-1] + j * stirling[i-1][j]\n\n            bell_n = 0\n            for k in range(n + 1):\n                bell_n += stirling[n][k]\n\n            return bell_n\n\n    validated_input = IntegerInput(n)\n    result = BellNumberCalculator.calculate(validated_input.get_value())\n\n    return result"}
{"task_id": "Mbpp/71", "solution": "def comb_sort(data: list) -> list:\n    \"\"\"Sorts a list of comparable elements in ascending order using the Comb Sort algorithm.\n    Returns a new list containing the sorted elements.\n    \"\"\"\n    n = len(data)\n    if n == 0:\n        return []\n\n    arr = list(data)  # Create a copy to avoid modifying the original list\n    shrink_factor = 1.3\n    gap = n\n    swapped = True\n\n    while gap > 1 or swapped:\n        gap = int(gap / shrink_factor)\n        if gap < 1:\n            gap = 1\n\n        swapped = False\n        for i in range(n - gap):\n            if arr[i] > arr[i + gap]:\n                arr[i], arr[i + gap] = arr[i + gap], arr[i]\n                swapped = True\n    return arr"}
{"task_id": "Mbpp/75", "solution": "def find_tuples(list_of_tuples: list[tuple[int, ...]], k: int) -> list[tuple[int, ...]]:\n    \"\"\"\n    Filters a list of tuples, retaining only those tuples where all elements are divisible by k.\n    \"\"\"\n    filtered_tuples = []\n    for current_tuple in list_of_tuples:\n        all_elements_divisible = True\n        for element in current_tuple:\n            if element % k != 0:\n                all_elements_divisible = False\n                break\n        if all_elements_divisible:\n            filtered_tuples.append(current_tuple)\n    return filtered_tuples"}
