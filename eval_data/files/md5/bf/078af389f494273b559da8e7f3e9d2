{"task_id": "Mbpp/558", "solution": "def digit_distance_nums(num1: int, num2: int) -> int:\n    \"\"\"\n    Calculates the sum of absolute per-digit differences between two non-negative integers.\n    This function uses helper functions to convert numbers to digit lists and pad them.\n    \"\"\"\n\n    def _int_to_digit_list(number: int) -> list[int]:\n        \"\"\"Converts a non-negative integer into a list of its individual digits.\"\"\"\n        if number == 0:\n            return [0]\n        return [int(d) for d in str(number)]\n\n    def _pad_digit_lists(digits1: list[int], digits2: list[int]) -> tuple[list[int], list[int]]:\n        \"\"\"Pads the shorter digit list with leading zeros to match the length of the longer list.\"\"\"\n        max_len = max(len(digits1), len(digits2))\n        padded_digits1 = [0] * (max_len - len(digits1)) + digits1\n        padded_digits2 = [0] * (max_len - len(digits2)) + digits2\n        return padded_digits1, padded_digits2\n\n    digits1_raw = _int_to_digit_list(num1)\n    digits2_raw = _int_to_digit_list(num2)\n\n    padded_digits1, padded_digits2 = _pad_digit_lists(digits1_raw, digits2_raw)\n\n    total_sum = 0\n    for i in range(len(padded_digits1)):\n        total_sum += abs(padded_digits1[i] - padded_digits2[i])\n\n    return total_sum"}
{"task_id": "Mbpp/556", "solution": "def find_Odd_Pair(arr, n):\n    \"\"\"\n    Counts pairs in `arr` whose XOR sum is odd.\n    An XOR sum is odd if and only if one operand is odd and the other is even.\n    \"\"\"\n    odd_count = 0\n    even_count = 0\n\n    for num in arr:\n        if num % 2 == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n\n    return odd_count * even_count"}
{"task_id": "Mbpp/557", "solution": "def toggle_string(input_string: str) -> str:\n    # Toggles the case of each character in the input string.\n    # Uppercase becomes lowercase, lowercase becomes uppercase, others remain unchanged.\n    toggled_chars = []\n    for char in input_string:\n        if char.isupper():\n            toggled_chars.append(char.lower())\n        elif char.islower():\n            toggled_chars.append(char.upper())\n        else:\n            toggled_chars.append(char)\n    return \"\".join(toggled_chars)"}
{"task_id": "Mbpp/559", "solution": "def max_sub_array_sum(arr: list[int], n: int) -> int:\n    \"\"\"\n    Finds the sum of the largest contiguous sublist in the given list.\n\n    Args:\n        arr (list[int]): The input list of integers.\n        n (int): The length of the input list.\n\n    Returns:\n        int: The maximum contiguous sublist sum.\n    \"\"\"\n    if n == 0:\n        return 0\n\n    max_so_far = arr[0]\n    curr_max = arr[0]\n\n    for i in range(1, n):\n        curr_max = max(arr[i], curr_max + arr[i])\n        max_so_far = max(max_so_far, curr_max)\n\n    return max_so_far"}
