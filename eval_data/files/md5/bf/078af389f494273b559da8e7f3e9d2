{"task_id": "Mbpp/170", "solution": "from typing import Union\ndef sum_range_list(list_of_numbers: list[Union[int, float]], start_index: int, end_index: int) -> Union[int, float]:\n    \"\"\"Calculates the sum of numbers in a list within a specified inclusive range.\n\n    Raises:\n        ValueError: If list_of_numbers is empty, start_index or end_index is negative,\n                    or start_index is greater than end_index.\n        IndexError: If start_index or end_index is out of bounds for the list.\n    \"\"\"\n    if not list_of_numbers:\n        raise ValueError(\"list_of_numbers cannot be empty.\")\n    if start_index < 0 or end_index < 0:\n        raise ValueError(\"Indices cannot be negative.\")\n    if start_index > end_index:\n        raise ValueError(\"start_index cannot be greater than end_index.\")\n    if start_index >= len(list_of_numbers) or end_index >= len(list_of_numbers):\n        raise IndexError(\"Indices are out of bounds for the list.\")\n\n    current_sum = 0\n    for i in range(start_index, end_index + 1):\n        current_sum += list_of_numbers[i]\n    return current_sum"}
{"task_id": "Mbpp/222", "solution": "def check_type(input_tuple: tuple) -> bool:\n    # Handles empty or single-element tuples as all elements having the same type.\n    if len(input_tuple) <= 1:\n        return True\n\n    # Get the type of the first element for comparison.\n    first_element_type = type(input_tuple[0])\n\n    # Iterate through the rest of the elements and compare their types.\n    for element in input_tuple[1:]:\n        if type(element) is not first_element_type:\n            return False\n\n    return True"}
{"task_id": "Mbpp/172", "solution": "def count_occurance(text):\n    \"\"\"Counts the number of non-overlapping occurrences of 'std' in the given text.\n    The search is case-sensitive.\"\"\"\n    substring = 'std'\n    count = 0\n    start_index = 0\n    while True:\n        index = text.find(substring, start_index)\n        if index != -1:\n            count += 1\n            start_index = index + len(substring)\n        else:\n            break\n    return count"}
