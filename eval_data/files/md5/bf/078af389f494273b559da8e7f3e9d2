{"task_id": "Mbpp/95", "solution": "import math\ndef Find_Min_Length(list_of_lists: list) -> int:\n    \"\"\"Determines the length of the shortest list in a list of lists.\n\n    Args:\n        list_of_lists: A list where each element is expected to be another list.\n\n    Returns:\n        An integer representing the length of the shortest list. Returns 0 if\n        list_of_lists is empty or contains only empty lists.\n    \"\"\"\n    if not list_of_lists:\n        return 0\n\n    min_length = math.inf\n    for inner_list in list_of_lists:\n        current_length = len(inner_list)\n        if current_length < min_length:\n            min_length = current_length\n            \n    return int(min_length)"}
{"task_id": "Mbpp/99", "solution": "def decimal_to_binary(decimal_num: int) -> str:\n    # Convert a decimal number to its binary string representation without leading zeros.\n    # Handles the special case where decimal_num is 0.\n    if decimal_num == 0:\n        return '0'\n\n    binary_string = ''\n    temp_num = decimal_num\n    while temp_num > 0:\n        remainder = temp_num % 2\n        binary_string = str(remainder) + binary_string\n        temp_num //= 2\n    \n    return binary_string"}
{"task_id": "Mbpp/94", "solution": "from typing import Any, List, Tuple as PyTuple, Union\nComparableNumber = Union[int, float]\ndef index_minimum(data: List[PyTuple[Any, ComparableNumber]]) -> Any:\n    \"\"\"\n    Returns the first value of the tuple with the smallest second value from a list of tuples.\n    Assumes valid input data according to the type hints.\n    \"\"\"\n    min_tuple = None\n\n    for current_tuple in data:\n        current_second_value = current_tuple[1]\n\n        if min_tuple is None or current_second_value < min_tuple[1]:\n            min_tuple = current_tuple\n\n    return min_tuple[0]"}
{"task_id": "Mbpp/92", "solution": "def is_undulating(number: int) -> bool:\n    \"\"\"\n    Checks if the given number is undulating.\n    An undulating number consists of two distinct alternating digits (e.g., 1212121).\n    \"\"\"\n    stringValue = str(abs(number))\n\n    if len(stringValue) < 2:\n        return False\n\n    digit1 = stringValue[0]\n    digit2 = stringValue[1]\n\n    if digit1 == digit2:\n        return False\n\n    for i in range(2, len(stringValue)):\n        current_digit = stringValue[i]\n        if i % 2 == 0:\n            if current_digit != digit1:\n                return False\n        else:\n            if current_digit != digit2:\n                return False\n\n    return True"}
{"task_id": "Mbpp/97", "solution": "def frequency_lists(list_of_lists: list) -> dict:\n    \"\"\"\n    Calculates the frequency of each element in a flattened list of lists.\n    Returns a dictionary mapping each unique element to its frequency.\n    \"\"\"\n    flattened_list = [item for sublist in list_of_lists for item in sublist]\n    frequency_map = {}\n    for element in flattened_list:\n        frequency_map[element] = frequency_map.get(element, 0) + 1\n    return frequency_map"}
{"task_id": "Mbpp/98", "solution": "def multiply_num(numbers):\n    \"\"\"\n    Multiplies all numbers in a list and divides the product by the list's length.\n    Raises ValueError for empty lists.\n    \"\"\"\n    if not numbers:\n        raise ValueError(\"Input list cannot be empty\")\n\n    product = 1.0\n    for num in numbers:\n        product *= num\n\n    return product / len(numbers)"}
{"task_id": "Mbpp/100", "solution": "def next_smallest_palindrome(n: int) -> int:\n    \"\"\"\n    Computes and returns the next smallest palindrome strictly greater than the input integer.\n    \"\"\"\n    def _is_palindrome(num: int) -> bool:\n        \"\"\"\n        Determines if a given integer is a palindrome.\n        \"\"\"\n        s = str(num)\n        return s == s[::-1]\n\n    next_num = n + 1\n    while True:\n        if _is_palindrome(next_num):\n            return next_num\n        next_num += 1"}
