{"task_id": "Mbpp/759", "solution": "import re\ndef is_decimal(input_string: str) -> bool:\n    \"\"\"\n    Evaluates if the input_string represents a decimal number with exactly two digits after the decimal point.\n    \"\"\"\n    if not input_string:\n        return False\n    # Matches an optional sign, one or more digits, a decimal point, and exactly two digits.\n    pattern = r\"^[+-]?\\d+\\.\\d{2}$\"\n    return re.fullmatch(pattern, input_string) is not None"}
{"task_id": "Mbpp/764", "solution": "def number_ctr(input_string: str) -> int:\n    \"\"\"Counts the number of digit characters in a given string.\n\n    Iterates through each character and increments a counter if the character is a digit.\n    \"\"\"\n    count = 0\n    for char in input_string:\n        if '0' <= char <= '9':  # Check if the character is between '0' and '9'\n            count += 1\n    return count"}
{"task_id": "Mbpp/757", "solution": "def count_reverse_pairs(string_list: list[str]) -> int:\n    \"\"\"Counts unique pairs of reverse strings in the given list.\"\"\"\n\n    def _is_reverse(s1: str, s2: str) -> bool:\n        \"\"\"Checks if s1 is the reverse of s2.\"\"\"\n        return s1 == s2[::-1]\n\n    def _normalize_pair(s1: str, s2: str) -> frozenset[str]:\n        \"\"\"Creates a unique, order-insensitive representation of a pair.\"\"\"\n        return frozenset({s1, s2})\n\n    unique_pairs_set: set[frozenset[str]] = set()\n\n    n = len(string_list)\n    for i in range(n):\n        s1 = string_list[i]\n        for j in range(i + 1, n):  # Iterate from i+1 to avoid duplicate (s1,s2) and (s2,s1) checks, and to ensure distinct indices.\n            s2 = string_list[j]\n\n            # BR4: A string cannot be a reverse of itself for the purpose of pair counting.\n            # This means string values s1 and s2 must be different.\n            if s1 != s2 and _is_reverse(s1, s2):\n                normalized_pair = _normalize_pair(s1, s2)\n                unique_pairs_set.add(normalized_pair)\n\n    return len(unique_pairs_set)"}
{"task_id": "Mbpp/767", "solution": "def get_pairs_count(numbers: list[int], target_sum: int) -> int:\n    \"\"\"\n    Counts pairs in a list whose sum equals a target value,\n    considering distinct indices.\n    \"\"\"\n    pair_count = 0\n    n = len(numbers)\n\n    for i in range(n):\n        for j in range(i + 1, n):\n            if numbers[i] + numbers[j] == target_sum:\n                pair_count += 1\n    return pair_count"}
{"task_id": "Mbpp/765", "solution": "def findNthPoliteNumber(n: int) -> int:\n    \"\"\"Calculates the nth polite number. A polite number is a positive integer that is not a power of 2.\"\"\"\n    polite_count = 0\n    current_num = 0\n\n    while polite_count < n:\n        current_num += 1\n        # A positive integer 'num' is a power of two if 'num > 0' and '(num & (num - 1)) == 0'.\n        # If it's NOT a power of two, it's a polite number.\n        if not (current_num > 0 and (current_num & (current_num - 1)) == 0):\n            polite_count += 1\n            \n    return current_num"}
{"task_id": "Mbpp/766", "solution": "def pair_wise(input_list: list) -> list[tuple]:\n    \"\"\"Returns a list of all pairs of consecutive items in a given list.\"\"\"\n    result = []\n    # Iterate from the first element up to the second-to-last element\n    for i in range(len(input_list) - 1):\n        pair = (input_list[i], input_list[i+1])\n        result.append(pair)\n    return result"}
{"task_id": "Mbpp/770", "solution": "def odd_num_sum(n: int) -> int:\n    \"\"\"Calculates the sum of the fourth powers of the first n odd natural numbers.\"\"\"\n    total_sum = 0\n    for i in range(1, n + 1):\n        odd_number = 2 * i - 1\n        total_sum += odd_number ** 4\n    return total_sum"}
{"task_id": "Mbpp/772", "solution": "def remove_length(text: str, k: int) -> str:\n    \"\"\"Removes all words of length k from the given string, normalizes spaces, and trims leading/trailing spaces.\"\"\"\n    \n    def _split_words(input_text: str) -> list[str]:\n        \"\"\"Splits the input text into a list of non-empty words.\"\"\"\n        return [word for word in input_text.split(' ') if word]\n\n    def _filter_words_by_length(words: list[str], length: int) -> list[str]:\n        \"\"\"Filters a list of words, retaining only those whose length does not match 'length'.\"\"\"\n        return [word for word in words if len(word) != length]\n\n    def _join_words(words: list[str]) -> str:\n        \"\"\"Joins a list of words into a single string, separated by a single space.\"\"\"\n        return ' '.join(words)\n\n    words_list = _split_words(text)\n    filtered_words = _filter_words_by_length(words_list, k)\n    result_string = _join_words(filtered_words)\n    return result_string"}
{"task_id": "Mbpp/771", "solution": "def check_expression(expression: str) -> bool:\n    \"\"\"\n    Checks if the given string expression has balanced opening and closing brackets.\n    Returns True if the expression is balanced, False otherwise.\n    \"\"\"\n    OPENING_BRACKETS = {'(', '{', '['}\n    CLOSING_BRACKETS = {')', '}', ']'}\n    BRACKET_PAIRS = {\n        '(': ')',\n        '{': '}',\n        '[': ']'\n    }\n\n    stack = []\n    for char in expression:\n        if char in OPENING_BRACKETS:\n            stack.append(char)\n        elif char in CLOSING_BRACKETS:\n            if not stack:\n                return False  # Closing bracket without a matching opening bracket\n            last_opening = stack.pop()\n            if BRACKET_PAIRS.get(last_opening) != char:\n                return False  # Mismatched brackets\n\n    return not stack # If the stack is empty, all opening brackets had a matching closing bracket."}
{"task_id": "Mbpp/769", "solution": "def Diff(list1: list, list2: list) -> list:\n    \"\"\"\n    Calculates the difference between two lists, preserving the order of elements from list1.\n    Elements from list1 that are also present in list2 are excluded.\n    \"\"\"\n    set_list2 = set(list2)\n    result_list = []\n    for item in list1:\n        if item not in set_list2:\n            result_list.append(item)\n    return result_list"}
{"task_id": "Mbpp/773", "solution": "def occurance_substring(main_string: str, sub_string: str) -> tuple[str, int, int] | None:\n    \"\"\"\n    Finds the first occurrence and position of a substring within a main string.\n    Returns None if no match is found.\n    \"\"\"\n    start_index = main_string.find(sub_string)\n    if start_index == -1:\n        return None\n    end_index = start_index + len(sub_string)\n    return (sub_string, start_index, end_index)"}
{"task_id": "Mbpp/775", "solution": "def odd_position(input_list: list[int]) -> bool:\n    \"\"\"Checks if every odd index in the list contains an odd number.\"\"\"\n\n    def _is_odd(num: int) -> bool:\n        \"\"\"Determines if a given integer is an odd number.\"\"\"\n        return num % 2 != 0\n\n    def _is_odd_index(index: int) -> bool:\n        \"\"\"Determines if a given integer index is an odd position.\"\"\"\n        return index % 2 != 0\n\n    for index, value in enumerate(input_list):\n        if _is_odd_index(index):\n            if not _is_odd(value):\n                return False\n    return True"}
{"task_id": "Mbpp/777", "solution": "def find_sum(input_list):\n    \"\"\"Calculates the sum of elements that appear exactly once in the provided list.\n    It uses a frequency map to count occurrences and then sums elements with a count of 1.\"\"\"\n    counts = {}\n    for item in input_list:\n        counts[item] = counts.get(item, 0) + 1\n\n    running_sum = 0\n    for item, count in counts.items():\n        if count == 1:\n            running_sum += item\n            \n    return running_sum"}
{"task_id": "Mbpp/778", "solution": "def pack_consecutive_duplicates(input_list: list) -> list[list]:\n    \"\"\"Groups consecutive identical elements of a list into sublists.\n\n    Args:\n        input_list: A list of elements of any comparable data type.\n\n    Returns:\n        A list of sublists, where each sublist contains consecutive identical elements.\n    \"\"\"\n    output_sublists = []\n    current_group = []\n\n    if not input_list:\n        return []\n\n    for element in input_list:\n        if not current_group or element == current_group[-1]:\n            current_group.append(element)\n        else:\n            output_sublists.append(current_group)\n            current_group = [element]\n\n    # Append the last group after the loop finishes\n    if current_group:\n        output_sublists.append(current_group)\n\n    return output_sublists"}
{"task_id": "Mbpp/786", "solution": "def right_insertion(sorted_list: list[int], value: int) -> int:\n    \"\"\"\n    Locates the right insertion point for a specified value in a sorted list.\n    This function implements the logic to find the index where 'value' should be inserted\n    into 'sorted_list' to maintain its ascending sorted order.\n    \"\"\"\n    low = 0\n    high = len(sorted_list)\n\n    while low < high:\n        mid = (low + high) // 2\n        if sorted_list[mid] <= value:\n            low = mid + 1\n        else:\n            high = mid\n    return low"}
{"task_id": "Mbpp/780", "solution": "import itertools\ndef find_combinations(tuple_list: list[tuple]) -> list[tuple]:\n    \"\"\"\n    Calculates element-wise sums for every unique pair of distinct tuples\n    from the input list.\n    \"\"\"\n    for t in tuple_list:\n        _validate_tuple(t)\n\n    result_sums = []\n    for t1, t2 in itertools.combinations(tuple_list, 2):\n        sum_tuple = (t1[0] + t2[0], t1[1] + t2[1])\n        result_sums.append(sum_tuple)\n\n    return result_sums"}
{"task_id": "Mbpp/782", "solution": "def odd_length_sum(numbers: list) -> int:\n    \"\"\"\n    Calculates the sum of all elements within contiguous subarrays of odd length.\n    \"\"\"\n    total_sum = 0\n    n = len(numbers)\n\n    for i in range(n):\n        for j in range(i, n):\n            current_subarray = numbers[i : j + 1]\n            if len(current_subarray) % 2 != 0:\n                total_sum += sum(current_subarray)\n    return total_sum"}
{"task_id": "Mbpp/784", "solution": "def mul_even_odd(numbers_list: list) -> int:\n    first_odd = None\n    first_even = None\n\n    for number in numbers_list:\n        if first_odd is None and number % 2 != 0:\n            first_odd = number\n        if first_even is None and number % 2 == 0:\n            first_even = number\n\n        if first_odd is not None and first_even is not None:\n            break\n\n    if first_odd is None:\n        raise ValueError(\"No odd number found in the list.\")\n    if first_even is None:\n        raise ValueError(\"No even number found in the list.\")\n\n    return first_odd * first_even"}
{"task_id": "Mbpp/785", "solution": "def tuple_str_int(tuple_string: str) -> tuple[int, ...]:\n    \"\"\"Converts a string representation of an integer tuple into an actual integer tuple.\"\"\"\n    # Remove outer parentheses\n    inner_string = tuple_string[1:-1]\n\n    # Handle empty tuple case\n    if not inner_string.strip():\n        return ()\n\n    # Split by comma, strip whitespace, and convert each part to an integer\n    integer_list = [int(s.strip()) for s in inner_string.split(',')]\n\n    # Convert the list of integers to a tuple\n    return tuple(integer_list)"}
{"task_id": "Mbpp/781", "solution": "import math\ndef _count_positive_divisors(number: int) -> int:\n    \"\"\"Calculates the total number of positive divisors for a given integer.\"\"\"\n    if number == 1:\n        return 1\n    count = 0\n    # Iterate up to the square root of the number to find divisors efficiently.\n    limit = int(math.sqrt(number))\n    for i in range(1, limit + 1):\n        if number % i == 0:\n            if i * i == number:\n                count += 1  # i is a divisor and its pair is itself (perfect square)\n            else:\n                count += 2  # i and number // i are two distinct divisors\n    return count\ndef count_divisors(number: int) -> bool:\n    \"\"\"Checks whether the count of positive divisors for an integer is even.\"\"\"\n    divisor_count = _count_positive_divisors(number)\n    return divisor_count % 2 == 0"}
