{"task_id": "Mbpp/631", "solution": "def replace_spaces(input_string: str) -> str:\n    \"\"\"Replaces all whitespace characters with underscores and all underscore characters with whitespaces in the given string.\"\"\"\n    # Use a unique temporary character to perform a simultaneous swap without conflicts.\n    temp_char = '\\0'  # Null character is typically not found in standard strings.\n\n    # First, replace all actual spaces with the temporary character.\n    intermediate_string = input_string.replace(' ', temp_char)\n\n    # Next, replace all underscores with actual spaces.\n    intermediate_string = intermediate_string.replace('_', ' ')\n\n    # Finally, replace the temporary characters (which were original spaces) with underscores.\n    final_string = intermediate_string.replace(temp_char, '_')\n\n    return final_string"}
{"task_id": "Mbpp/629", "solution": "def Split(numbers_list: list[int]) -> list[int]:\n    \"\"\"Filters a list of integers, returning only the even numbers.\n\n    Iterates through the input list, checks for even numbers, and appends them to a new list.\n    \"\"\"\n    even_numbers = []\n    for number in numbers_list:\n        if number % 2 == 0:\n            even_numbers.append(number)\n    return even_numbers"}
{"task_id": "Mbpp/632", "solution": "def move_zero(input_list: list) -> list:\n    \"\"\"\n    Moves all zero elements to the end of the given list, preserving the\n    relative order of non-zero elements.\n    \"\"\"\n    non_zeroes = []\n    zeroes = []\n    for item in input_list:\n        if item == 0:\n            zeroes.append(item)\n        else:\n            non_zeroes.append(item)\n    return non_zeroes + zeroes"}
{"task_id": "Mbpp/630", "solution": "def get_coordinates(center_coordinate: tuple[int, int]) -> list[list[int]]:\n    \"\"\"\n    Extracts all adjacent coordinates for the given coordinate tuple, including the center.\n    The returned list is sorted first by x-coordinate and then by y-coordinate.\n    \"\"\"\n    x, y = center_coordinate\n\n    x_coords = [x - 1, x, x + 1]\n    y_coords = [y - 1, y, y + 1]\n\n    adjacent_points = []\n    for x_val in x_coords:\n        for y_val in y_coords:\n            adjacent_points.append([x_val, y_val])\n\n    adjacent_points.sort(key=lambda p: (p[0], p[1]))\n\n    return adjacent_points"}
