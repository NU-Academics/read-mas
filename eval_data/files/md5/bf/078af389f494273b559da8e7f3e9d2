{"task_id": "Mbpp/103", "solution": "import functools\ndef eulerian_num(n: int, m: int) -> int:\n    \"\"\"\n    Calculates the Eulerian number a(n, m) using a recursive definition with memoization.\n    It raises ValueError for invalid inputs (n < 0, m < 0, or m >= n).\n    \"\"\"\n    if n < 0 or m < 0 or m >= n:\n        raise ValueError(\"Inputs must satisfy 0 <= m < n.\")\n\n    @functools.lru_cache(None)\n    def _eulerian_recursive(n_val: int, m_val: int) -> int:\n        # Base cases for the Eulerian number A(n, m)\n        if m_val == 0:\n            return 1\n        if m_val == n_val - 1:\n            return 1\n        \n        # Apply the recursive definition: A(n,m) = (m+1)A(n-1,m) + (n-m)A(n-1,m-1)\n        return (m_val + 1) * _eulerian_recursive(n_val - 1, m_val) + \\\n               (n_val - m_val) * _eulerian_recursive(n_val - 1, m_val - 1)\n\n    return _eulerian_recursive(n, m)"}
