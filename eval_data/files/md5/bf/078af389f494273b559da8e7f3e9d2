{"task_id": "Mbpp/145", "solution": "from typing import Sequence, Union\ndef max_Abs_Diff(numbers: Sequence[Union[int, float]]) -> Union[int, float]:\n    \"\"\"\n    Calculates the maximum absolute difference between any two elements in a given numerical sequence.\n\n    Args:\n        numbers: A sequence (e.g., list, tuple) of numerical values (int or float).\n\n    Returns:\n        The maximum absolute difference as an int or float. Returns 0 if the sequence\n        contains fewer than two elements.\n    \"\"\"\n    if len(numbers) < 2:\n        return 0\n\n    min_value = min(numbers)\n    max_value = max(numbers)\n    return max_value - min_value"}
{"task_id": "Mbpp/160", "solution": "def find_solution(a: int, b: int, n: int) -> tuple[int, int] | None:\n    \"\"\"\n    Finds integer solutions (x, y) for the linear Diophantine equation ax + by = n.\n    Returns (x, y) if a solution exists, otherwise returns None.\n    \"\"\"\n\n    def _gcd(num1: int, num2: int) -> int:\n        \"\"\"Calculates the greatest common divisor of two integers using the Euclidean algorithm.\"\"\"\n        while num2:\n            num1, num2 = num2, num1 % num2\n        return abs(num1)\n\n    def _extended_gcd(num1: int, num2: int) -> tuple[int, int, int]:\n        \"\"\"\n        Implements the extended Euclidean algorithm to find g = gcd(a, b) and\n        integers x, y such that ax + by = g.\n        \"\"\"\n        if num1 == 0:\n            return num2, 0, 1\n        gcd_val, x1, y1 = _extended_gcd(num2 % num1, num1)\n        x = y1 - (num2 // num1) * x1\n        y = x1\n        return gcd_val, x, y\n\n    # Handle edge cases where a or b are zero\n    if a == 0 and b == 0:\n        return (0, 0) if n == 0 else None\n    elif a == 0:\n        return (0, n // b) if n % b == 0 else None\n    elif b == 0:\n        return (n // a, 0) if n % a == 0 else None\n\n    # Calculate GCD of a and b\n    g = _gcd(a, b)\n\n    # If n is not divisible by g, no integer solution exists\n    if n % g != 0:\n        return None\n\n    # Use the extended Euclidean algorithm to find x0, y0 such that a*x0 + b*y0 = g\n    g_val, x0, y0 = _extended_gcd(a, b)\n\n    # Scale the particular solution by k = n // g\n    k = n // g\n    x = x0 * k\n    y = y0 * k\n\n    return (x, y)"}
{"task_id": "Mbpp/161", "solution": "def remove_elements(source_list: list, removal_list: list) -> list:\n    \"\"\"\n    Removes all elements from the source list that are present in the removal list,\n    preserving the relative order of the remaining elements.\n    \"\"\"\n    removal_set = set(removal_list)\n    result_list = []\n    for item in source_list:\n        if item not in removal_set:\n            result_list.append(item)\n    return result_list"}
{"task_id": "Mbpp/162", "solution": "def sum_series(n: int) -> int:\n    \"\"\"Calculates the sum (n - 2*i) from i=0 to n // 2.\"\"\"\n    total_sum = 0\n    for i in range(n // 2 + 1):\n        term = n - 2 * i\n        total_sum += term\n    return total_sum"}
{"task_id": "Mbpp/167", "solution": "def next_power_of_2(n: int) -> int:\n    \"\"\"\n    Calculates the smallest power of 2 that is greater than or equal to n.\n    Raises ValueError if n is negative.\n    \"\"\"\n    if n < 0:\n        raise ValueError(\"Input n must be a non-negative integer.\")\n    if n == 0:\n        return 1\n\n    power = 1\n    while power < n:\n        power <<= 1\n    return power"}
{"task_id": "Mbpp/165", "solution": "def _is_alphabetic(char: str) -> bool:\n    \"\"\"Checks if a character is an English alphabet letter (a-z or A-Z).\"\"\"\n    return ('a' <= char <= 'z') or ('A' <= char <= 'Z')\ndef _to_lowercase(char: str) -> str:\n    \"\"\"Converts an alphabetic character to its lowercase equivalent.\"\"\"\n    return char.lower()\ndef _get_alphabetical_position(char: str) -> int:\n    \"\"\"Calculates the 0-based alphabetical position of a lowercase character.\"\"\"\n    return ord(char) - ord('a')\ndef count_char_position(input_string: str) -> int:\n    \"\"\"\n    Counts characters in a string that occur at the same position in the string\n    as in the English alphabet (case insensitive).\n    \"\"\"\n    match_count = 0\n    for index, char in enumerate(input_string):\n        if _is_alphabetic(char):\n            lower_char = _to_lowercase(char)\n            alphabetical_position = _get_alphabetical_position(lower_char)\n            if index == alphabetical_position:\n                match_count += 1\n    return match_count"}
{"task_id": "Mbpp/168", "solution": "def frequency(numbers: list[int], target_number: int) -> int:\n    \"\"\"\n    Counts the occurrences of a target number in a given list of numbers.\n    Iterates through the list and increments a counter each time the target is found.\n    \"\"\"\n    count = 0\n    for item in numbers:\n        if item == target_number:\n            count += 1\n    return count"}
{"task_id": "Mbpp/166", "solution": "def find_even_pair(numbers: list[int]) -> int:\n    \"\"\"Counts pairs of integers in a list that XOR to an even number.\n\n    This function leverages the property that two numbers XOR to an even number\n    if and only if they have the same parity (both even or both odd).\n    \"\"\"\n\n    def _is_even(number: int) -> bool:\n        \"\"\"Checks if an integer is even.\"\"\"\n        return number % 2 == 0\n\n    def _get_parity(number: int) -> int:\n        \"\"\"Returns the parity of an integer (0 for even, 1 for odd).\"\"\"\n        return 0 if _is_even(number) else 1\n\n    count_even = 0\n    count_odd = 0\n\n    for num in numbers:\n        if _get_parity(num) == 0:\n            count_even += 1\n        else:\n            count_odd += 1\n\n    # Number of pairs of even integers: C_even * (C_even - 1) / 2\n    # Number of pairs of odd integers: C_odd * (C_odd - 1) / 2\n    even_pairs = (count_even * (count_even - 1)) // 2\n    odd_pairs = (count_odd * (count_odd - 1)) // 2\n\n    return even_pairs + odd_pairs"}
