{"task_id": "Mbpp/752", "solution": "def jacobsthal_num(n: int) -> int:\n    \"\"\"\n    Calculates the nth Jacobsthal number.\n    It uses an iterative approach based on J(n) = J(n-1) + 2 * J(n-2).\n    \"\"\"\n    if n < 0:\n        raise ValueError(\"Input 'n' must be a non-negative integer.\")\n    if n == 0:\n        return 0\n    if n == 1:\n        return 1\n\n    a, b = 0, 1  # J(0), J(1)\n    for _ in range(2, n + 1):\n        a, b = b, a + 2 * b\n    return b"}
{"task_id": "Mbpp/751", "solution": "def check_min_heap(arr: list) -> bool:\n    \"\"\"\n    Checks if the given array represents a min-heap.\n    An empty or single-element array is considered a min-heap.\n    \"\"\"\n    n = len(arr)\n\n    # Edge cases: an empty or single-element array is a min-heap\n    if n <= 1:\n        return True\n\n    # Iterate through the array, focusing only on non-leaf nodes.\n    # Non-leaf nodes are typically found from index 0 up to (n // 2) - 1.\n    for i in range(n // 2):\n        left_child_idx = 2 * i + 1\n        right_child_idx = 2 * i + 2\n\n        # Check left child\n        if left_child_idx < n and arr[i] > arr[left_child_idx]:\n            return False\n\n        # Check right child\n        if right_child_idx < n and arr[i] > arr[right_child_idx]:\n            return False\n\n    return True"}
{"task_id": "Mbpp/754", "solution": "def extract_index_list(list1: list, list2: list, list3: list) -> list:\n    \"\"\"\n    Finds elements that appear in all three input lists at the same index.\n    Compares elements up to the length of the shortest list.\n    \"\"\"\n    min_length = min(len(list1), len(list2), len(list3))\n    common_elements = []\n\n    for i in range(min_length):\n        if list1[i] == list2[i] and list2[i] == list3[i]:\n            common_elements.append(list1[i])\n\n    return common_elements"}
{"task_id": "Mbpp/753", "solution": "def min_k(tuple_list: list[tuple], k: int) -> list[tuple]:\n    \"\"\"\n    Finds the minimum k records from a list of tuples based on their second element.\n    Returns the k smallest tuples, sorted in ascending order by their second element.\n    \"\"\"\n    if not tuple_list or k <= 0:\n        return []\n\n    # Sort the list of tuples based on the second element (index 1) in ascending order.\n    sorted_list = sorted(tuple_list, key=lambda x: x[1])\n\n    # Return the first k elements from the sorted list.\n    # Slicing handles cases where k is greater than the list length by returning the whole list.\n    return sorted_list[:k]"}
{"task_id": "Mbpp/758", "solution": "from collections import Counter\nfrom typing import List, Any, Dict, Tuple\ndef unique_sublists(input_list: List[List[Any]]) -> Dict[Tuple[Any], int]:\n    \"\"\"Counts unique sublists within a list, returning a dictionary of their occurrences.\n    Each sublist is converted to a tuple to serve as a dictionary key.\"\"\"\n    converted_sublists = [tuple(sublist) for sublist in input_list]\n    return dict(Counter(converted_sublists))"}
