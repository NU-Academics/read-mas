{"task_id": "Mbpp/594", "solution": "def diff_even_odd(numbers: list[int]) -> int:\n    \"\"\"\n    Finds the difference of the first even and first odd number of a given list.\n    Assumes the list always contains at least one even and one odd number.\n    \"\"\"\n\n    def _is_even(number: int) -> bool:\n        \"\"\"Determines if a given integer is even.\"\"\"\n        return number % 2 == 0\n\n    def _is_odd(number: int) -> bool:\n        \"\"\"Determines if a given integer is odd.\"\"\"\n        return number % 2 != 0\n\n    def _find_first_even(numbers: list[int]) -> int:\n        \"\"\"Iterates through the list to find and return the first even number.\"\"\"\n        for num in numbers:\n            if _is_even(num):\n                return num\n        # According to design context, an even number will always be found.\n        # This line is theoretically unreachable under given assumptions.\n        return 0\n\n    def _find_first_odd(numbers: list[int]) -> int:\n        \"\"\"Iterates through the list to find and return the first odd number.\"\"\"\n        for num in numbers:\n            if _is_odd(num):\n                return num\n        # According to design context, an odd number will always be found.\n        # This line is theoretically unreachable under given assumptions.\n        return 0\n\n    first_even = _find_first_even(numbers)\n    first_odd = _find_first_odd(numbers)\n\n    return first_even - first_odd"}
{"task_id": "Mbpp/597", "solution": "def find_kth(array1: list[int], array2: list[int], k: int) -> int:\n    \"\"\"\n    Finds the kth smallest element from two sorted arrays.\n\n    This function merges elements conceptually until the kth element is found.\n    \"\"\"\n    n1, n2 = len(array1), len(array2)\n    i, j = 0, 0\n    current_kth_element = -1\n    count = 0\n\n    while i < n1 and j < n2 and count < k:\n        if array1[i] < array2[j]:\n            current_kth_element = array1[i]\n            i += 1\n        else:\n            current_kth_element = array2[j]\n            j += 1\n        count += 1\n\n    while i < n1 and count < k:\n        current_kth_element = array1[i]\n        i += 1\n        count += 1\n\n    while j < n2 and count < k:\n        current_kth_element = array2[j]\n        j += 1\n        count += 1\n\n    return current_kth_element"}
{"task_id": "Mbpp/598", "solution": "def armstrong_number(number: int) -> bool:\n    \"\"\"\n    Checks if the given number is an Armstrong number.\n    An Armstrong number is equal to the sum of its digits raised to the power of the number of digits.\n    \"\"\"\n    num_str = str(number)\n    n = len(num_str)\n    sum_of_powers = 0\n    for digit_char in num_str:\n        digit = int(digit_char)\n        sum_of_powers += digit ** n\n    return sum_of_powers == number"}
