{"task_id": "Mbpp/572", "solution": "def two_unique_nums(numbers_list: list) -> list:\n    \"\"\"\n    Identifies and returns numbers that occur exactly once in the input list,\n    preserving the relative order of their first appearance.\n    \"\"\"\n    from collections import Counter\n\n    if not numbers_list:\n        return []\n\n    counts = Counter(numbers_list)\n    unique_ordered_list = []\n\n    for num in numbers_list:\n        if counts[num] == 1:\n            unique_ordered_list.append(num)\n\n    return unique_ordered_list"}
{"task_id": "Mbpp/576", "solution": "def is_Sub_Array(main_list: list, sublist_candidate: list) -> bool:\n    \"\"\"\n    Checks if sublist_candidate is a consecutive sub-sequence of main_list.\n    Handles cases including empty lists.\n    \"\"\"\n    n = len(main_list)\n    m = len(sublist_candidate)\n\n    # An empty list is always a sublist of any list.\n    if m == 0:\n        return True\n    # If the sublist is longer than the main list, it cannot be a sublist.\n    if m > n:\n        return False\n\n    for i in range(n - m + 1):\n        # Check if the slice of main_list matches the sublist_candidate.\n        if main_list[i : i + m] == sublist_candidate:\n            return True\n            \n    return False"}
{"task_id": "Mbpp/573", "solution": "import collections\nimport math\ndef unique_product(numbers: list) -> int:\n    \"\"\"\n    Calculates the product of unique numbers in a given list.\n\n    A unique number is defined as a number that appears exactly once in the input list.\n    If no unique numbers are found, the product is 1 (multiplicative identity).\n    \"\"\"\n    counts = collections.Counter(numbers)\n    unique_numbers = [num for num, count in counts.items() if count == 1]\n    return math.prod(unique_numbers, start=1)"}
{"task_id": "Mbpp/579", "solution": "def find_dissimilar(tuple1: tuple, tuple2: tuple) -> tuple:\n    \"\"\"Finds elements that are present in either tuple but not in both, returning them as a sorted tuple.\"\"\"\n    set1 = set(tuple1)\n    set2 = set(tuple2)\n    dissimilar_elements = (set1 - set2) | (set2 - set1)\n    return tuple(sorted(list(dissimilar_elements)))"}
{"task_id": "Mbpp/578", "solution": "def interleave_lists(list1: list, list2: list, list3: list) -> list:\n    \"\"\"Interleaves three lists of the same length into a single flat list.\"\"\"\n    n = len(list1)\n    if not (len(list2) == n and len(list3) == n):\n        raise ValueError(\"Input lists must be of the same length\")\n\n    result = []\n    for i in range(n):\n        result.append(list1[i])\n        result.append(list2[i])\n        result.append(list3[i])\n    return result"}
{"task_id": "Mbpp/577", "solution": "def last_Digit_Factorial(n: int) -> int:\n    \"\"\"Calculates the last digit of the factorial of a given non-negative integer.\n    For n >= 5, the last digit is always 0 due to factors of 2 and 5.\n    \"\"\"\n    if n >= 5:\n        return 0\n    elif n == 0:\n        return 1\n    elif n == 1:\n        return 1\n    elif n == 2:\n        return 2\n    elif n == 3:\n        return 6\n    elif n == 4:\n        return 4"}
{"task_id": "Mbpp/581", "solution": "import math\ndef surface_Area(base_edge: float, height: float) -> float:\n    \"\"\"\n    Calculates the total surface area of a square pyramid.\n    Raises ValueError if base_edge or height are negative.\n    \"\"\"\n    if base_edge < 0 or height < 0:\n        raise ValueError(\"Base edge and height must be non-negative values.\")\n\n    base_area = base_edge * base_edge\n    slant_height = math.sqrt((base_edge / 2)**2 + height**2)\n    lateral_surface_area = 2 * base_edge * slant_height\n    total_surface_area = base_area + lateral_surface_area\n\n    return total_surface_area"}
