{"task_id": "Mbpp/410", "solution": "def min_val(heterogeneous_list: list):\n    \"\"\"Finds the minimum numeric value in a heterogeneous list.\"\"\"\n    \n    def _is_numeric(element: any) -> bool:\n        \"\"\"Checks if an element is an integer or a float.\"\"\"\n        return isinstance(element, (int, float))\n\n    numeric_elements = []\n    for element in heterogeneous_list:\n        if _is_numeric(element):\n            numeric_elements.append(element)\n\n    if not numeric_elements:\n        raise ValueError(\"No numeric elements found in the list.\")\n\n    return min(numeric_elements)"}
{"task_id": "Mbpp/414", "solution": "from typing import Iterable, Any\ndef overlapping(sequence1: Iterable[Any], sequence2: Iterable[Any]) -> bool:\n    \"\"\"Checks if any element in sequence1 exists in sequence2.\n    Uses a set for efficient lookups.\"\"\"\n    \n    # Convert the first sequence to a set for efficient average O(1) time lookups.\n    set_s1 = set(sequence1)\n    \n    # Iterate through the second sequence and check for any overlap.\n    for item in sequence2:\n        if item in set_s1:\n            return True\n            \n    return False"}
{"task_id": "Mbpp/415", "solution": "def max_Product(input_array: list[int]) -> tuple[int, int]:\n    \"\"\"\n    Finds a pair of integers with the highest product from a given array.\n    Considers products of both the largest positives and smallest negatives.\n    \"\"\"\n    if len(input_array) < 2:\n        raise ValueError(\"Input array must contain at least two elements.\")\n\n    sorted_array = sorted(input_array)\n    n = len(sorted_array)\n\n    # Product of the two largest numbers\n    product_largest_two = sorted_array[n-1] * sorted_array[n-2]\n    # Product of the two smallest (most negative) numbers\n    product_smallest_two = sorted_array[0] * sorted_array[1]\n\n    if product_largest_two > product_smallest_two:\n        return (sorted_array[n-2], sorted_array[n-1])\n    else:\n        return (sorted_array[0], sorted_array[1])"}
{"task_id": "Mbpp/420", "solution": "def cube_Sum(n: int) -> int:\n    \"\"\"Calculates the sum of the cubes of the first 'n' even natural numbers.\"\"\"\n    total_sum = 0\n    for i in range(1, n + 1):\n        even_num = 2 * i\n        cube = even_num ** 3\n        total_sum += cube\n    return total_sum"}
{"task_id": "Mbpp/418", "solution": "def Find_Max(inputList: list):\n    \"\"\"\n    Finds the element of a list having the maximum length.\n    Returns None if the input list is empty.\n    \"\"\"\n    if not inputList:\n        return None\n\n    max_length_element = inputList[0]\n    max_length = len(inputList[0])\n\n    for element in inputList[1:]:\n        current_length = len(element)\n        if current_length > max_length:\n            max_length = current_length\n            max_length_element = element\n\n    return max_length_element"}
