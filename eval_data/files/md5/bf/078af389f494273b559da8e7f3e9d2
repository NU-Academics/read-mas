{"task_id": "Mbpp/639", "solution": "class Name:\n    \"\"\"Encapsulates a single name string and provides methods for its properties and validation.\"\"\"\n    def __init__(self, value: str):\n        self._value = value\n\n    def get_value(self) -> str:\n        \"\"\"Returns the name string.\"\"\"\n        return self._value\n\n    def get_length(self) -> int:\n        \"\"\"Returns the length of the name.\"\"\"\n        return len(self._value)\n\n    def starts_with_lowercase(self) -> bool:\n        \"\"\"Checks if the name starts with a lowercase letter.\"\"\"\n        if not self._value:\n            return False\n        return self._value[0].islower()\nclass NameList:\n    \"\"\"Manages a collection of Name objects, filters them, and calculates total length.\"\"\"\n    def __init__(self, name_strings: list[str]):\n        self._names: list[Name] = [Name(s) for s in name_strings]\n\n    def filter_valid_names(self) -> 'NameList':\n        \"\"\"Returns a new NameList containing only names that do not start with a lowercase letter.\"\"\"\n        valid_name_values = [name.get_value() for name in self._names if not name.starts_with_lowercase()]\n        return NameList(valid_name_values)\n\n    def calculate_total_length(self) -> int:\n        \"\"\"Calculates and returns the sum of lengths of all names in the list.\"\"\"\n        return sum(name.get_length() for name in self._names)\ndef sample_nam(name_strings: list[str]) -> int:\n    \"\"\"\n    Sums the length of names after removing those that start with a lowercase letter.\n    \"\"\"\n    initial_name_list = NameList(name_strings)\n    filtered_name_list = initial_name_list.filter_valid_names()\n    total_length = filtered_name_list.calculate_total_length()\n    return total_length"}
{"task_id": "Mbpp/638", "solution": "import math\ndef wind_chill(wind_velocity_kmh: float, temperature_celsius: float) -> int:\n    \"\"\"\n    Calculates the wind chill index rounded to the nearest integer.\n    \"\"\"\n    # WCI = 13.12 + 0.6215 * T - 11.37 * V^0.16 + 0.3965 * T * V^0.16\n    # T is temperature_celsius, V is wind_velocity_kmh\n    wci_raw = 13.12 + (0.6215 * temperature_celsius) - \\\n              (11.37 * math.pow(wind_velocity_kmh, 0.16)) + \\\n              (0.3965 * temperature_celsius * math.pow(wind_velocity_kmh, 0.16))\n    return round(wci_raw)"}
