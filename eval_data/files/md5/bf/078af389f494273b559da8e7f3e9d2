{"task_id": "Mbpp/290", "solution": "def max_length(list_of_lists: list) -> tuple:\n    \"\"\"\n    Finds the list of maximum length in a list of lists.\n    Returns a tuple containing the maximum length and the corresponding list object.\n    \"\"\"\n    max_len = 0\n    longest_list = []\n\n    for sub_list in list_of_lists:\n        current_len = len(sub_list)\n        if current_len > max_len:\n            max_len = current_len\n            longest_list = sub_list\n            \n    return (max_len, longest_list)"}
{"task_id": "Mbpp/299", "solution": "def max_aggregate(data_list: list[tuple[str, int]]) -> tuple[str, int]:\n    \"\"\"\n    Calculates the maximum aggregate score from a list of name-score tuples.\n    Returns the name with the highest aggregate score and that score.\n    \"\"\"\n    aggregated_scores = {}\n    for name, score in data_list:\n        aggregated_scores[name] = aggregated_scores.get(name, 0) + score\n\n    max_name = None\n    max_score = 0\n\n    for name, total_score in aggregated_scores.items():\n        if max_name is None or total_score > max_score:\n            max_score = total_score\n            max_name = name\n\n    return (max_name, max_score)"}
