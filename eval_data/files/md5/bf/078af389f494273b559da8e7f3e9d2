{"task_id": "Mbpp/440", "solution": "def find_adverb_position(sentence: str) -> tuple[int, int, str] | None:\n    \"\"\"Finds the first adverb and its positions in a given sentence.\"\"\"\n\n    def _tokenize_sentence(sentence: str) -> list[tuple[str, int, int]]:\n        \"\"\"Tokenizes a sentence into words, tracking their original positions.\"\"\"\n        tokens = []\n        current_index = 0\n        for word in sentence.split():\n            start_index = sentence.find(word, current_index)\n            end_index = start_index + len(word)\n            tokens.append((word, start_index, end_index))\n            current_index = end_index\n        return tokens\n\n    def _clean_word(word: str) -> str:\n        \"\"\"Strips leading/trailing punctuation from a word.\"\"\"\n        return word.strip(\".,!?;:\\\"'()[]{}\")\n\n    def _is_adverb(cleaned_word: str) -> bool:\n        \"\"\"Checks if a cleaned word is an adverb using a simple hardcoded list.\"\"\"\n        # This list is a placeholder; a real system would use a POS tagger or comprehensive lexicon.\n        adverb_list = {\n            \"clearly\", \"quickly\", \"slowly\", \"very\", \"really\", \"always\",\n            \"never\", \"often\", \"seldom\", \"sometimes\", \"usually\", \"ever\",\n            \"here\", \"there\", \"everywhere\", \"somewhere\", \"nowhere\", \"anywhere\",\n            \"today\", \"yesterday\", \"tomorrow\", \"now\", \"then\", \"soon\", \"early\", \"late\",\n            \"well\", \"badly\", \"hard\", \"softly\", \"almost\", \"enough\", \"just\", \"quite\", \"rather\", \"too\"\n        }\n        return cleaned_word.lower() in adverb_list\n\n    tokens = _tokenize_sentence(sentence)\n    for word_text, start_idx, end_idx in tokens:\n        cleaned_word = _clean_word(word_text)\n        if cleaned_word and _is_adverb(cleaned_word):\n            return (start_idx, end_idx, cleaned_word)\n    return None"}
