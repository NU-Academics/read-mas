{"task_id": "Mbpp/3", "solution": "import math\ndef is_not_prime(number: int) -> bool:\n    \"\"\"\n    Determines if a given integer is a non-prime number.\n    Returns True if the number is non-prime, False otherwise (i.e., if it's prime or not considered non-prime by definition).\n    \"\"\"\n    if number <= 1:\n        return False\n\n    if number == 2:\n        return False\n\n    for i in range(2, int(math.sqrt(number)) + 1):\n        if number % i == 0:\n            return True\n\n    return False"}
{"task_id": "Mbpp/6", "solution": "def differ_At_One_Bit_Pos(num1: int, num2: int) -> bool:\n    \"\"\"\n    Checks if two numbers differ at exactly one bit position.\n    This is achieved by XORing the numbers and counting the set bits in the result.\n    \"\"\"\n    xor_result = num1 ^ num2\n    # Count the number of set bits (1s) in xor_result using Brian Kernighan's algorithm.\n    count = 0\n    while xor_result > 0:\n        xor_result &= (xor_result - 1)\n        count += 1\n    return count == 1"}
{"task_id": "Mbpp/11", "solution": "def remove_Occ(input_string: str, char_to_remove: str) -> str:\n    \"\"\"\n    Removes the first and last occurrences of a specified character from a string.\n    The function handles cases where the character is not found or is found only once.\n    \"\"\"\n    first_idx = input_string.find(char_to_remove)\n\n    if first_idx == -1:\n        # Character not found at all, return original string\n        return input_string\n\n    # Remove the first occurrence\n    temp_string_after_first_removal = input_string[:first_idx] + input_string[first_idx + 1:]\n\n    # Find the last occurrence in the string after the first one was removed\n    last_idx_in_temp = temp_string_after_first_removal.rfind(char_to_remove)\n\n    if last_idx_in_temp == -1:\n        # Character was only present once, or no second occurrence was found\n        return temp_string_after_first_removal\n    else:\n        # Remove the last occurrence from the temporary string\n        return temp_string_after_first_removal[:last_idx_in_temp] + temp_string_after_first_removal[last_idx_in_temp + 1:]"}
{"task_id": "Mbpp/8", "solution": "def square_nums(numbers):\n    \"\"\"Calculates the square of each element in a list.\"\"\"\n    squared_numbers = []\n    for num in numbers:\n        squared_numbers.append(num * num)\n    return squared_numbers"}
{"task_id": "Mbpp/4", "solution": "import heapq\ndef heap_queue_largest(numbers: list[int], n: int) -> list[int]:\n    \"\"\"\n    Finds the n largest integers from a given list of numbers, returned in descending order.\n    Handles edge cases for n <= 0 or an empty numbers list by returning an empty list.\n    \"\"\"\n    if n <= 0:\n        return []\n    if not numbers:\n        return []\n\n    # heapq.nlargest efficiently finds the n largest elements and returns them in descending order.\n    # It implicitly handles cases where n is greater than the list size.\n    return heapq.nlargest(n, numbers)"}
{"task_id": "Mbpp/9", "solution": "def find_Rotations(input_string: str) -> int:\n    \"\"\"\n    Calculates the minimum number of rotations (greater than 0) required\n    for a given input string to become identical to its original form.\n    \"\"\"\n    original_string = input_string\n    current_string = input_string\n    rotations = 0\n    while True:\n        rotations += 1\n        current_string = current_string[1:] + current_string[0]\n        if current_string == original_string:\n            return rotations"}
{"task_id": "Mbpp/14", "solution": "def find_Volume(base: float, height: float, length: float) -> float:\n    \"\"\"Calculates the volume of a triangular prism given its base, height, and length.\n    Input parameters must be numerical and positive values.\"\"\"\n    if not all(isinstance(arg, (int, float)) for arg in [base, height, length]):\n        raise TypeError(\"All inputs (base, height, length) must be numerical values.\")\n    if not all(arg > 0 for arg in [base, height, length]):\n        raise ValueError(\"All inputs (base, height, length) must be positive values.\")\n\n    volume = 0.5 * base * height * length\n    return float(volume)"}
