{"task_id": "Mbpp/615", "solution": "def average_tuple(data: tuple[tuple[float | int], ...]) -> list[float]:\n    \"\"\"\n    Calculates the column-wise averages from a tuple of tuples.\n    Returns an empty list if the input 'data' is empty.\n    \"\"\"\n    if not data:\n        return []\n\n    num_columns = len(data[0])\n    results_list = []\n\n    for col_idx in range(num_columns):\n        column_elements = [inner_tuple[col_idx] for inner_tuple in data]\n\n        column_sum = sum(column_elements)\n        column_count = len(column_elements)\n        current_mean = float(column_sum) / column_count\n\n        results_list.append(current_mean)\n\n    return results_list"}
{"task_id": "Mbpp/616", "solution": "def tuple_modulo(tuple1: tuple, tuple2: tuple) -> tuple:\n    \"\"\"\n    Performs element-wise modulo on two tuples of the same length.\n    Raises ValueError if input tuples have different lengths.\n    \"\"\"\n    if len(tuple1) != len(tuple2):\n        raise ValueError(\"Input tuples must be of the same length.\")\n\n    results = []\n    for i in range(len(tuple1)):\n        results.append(tuple1[i] % tuple2[i])\n    return tuple(results)"}
{"task_id": "Mbpp/618", "solution": "def div_list(list1: list[float | int], list2: list[float | int]) -> list[float]:\n    \"\"\"\n    Performs element-wise division of two lists, returning floating-point results.\n    Raises ValueError if lengths differ, ZeroDivisionError if division by zero occurs.\n    \"\"\"\n    if len(list1) != len(list2):\n        raise ValueError(\"Lists must have the same length\")\n\n    results = []\n    for num, den in zip(list1, list2):\n        if den == 0:\n            raise ZeroDivisionError(\"Division by zero\")\n        results.append(float(num) / float(den))\n    return results"}
{"task_id": "Mbpp/620", "solution": "def largest_subset(numbers: List[int]) -> int:\n    \"\"\"\n    Finds the size of the largest subset of numbers where every pair is mutually divisible.\n    Helper functions _is_divisible_pair and _is_divisible_subset are defined internally.\n    \"\"\"\n    import itertools\n\n    def _is_divisible_pair(a: int, b: int) -> bool:\n        \"\"\"Checks if two numbers form a divisible pair, handling zero cases.\"\"\"\n        # 0 is considered divisible by any integer (0 % b == 0 for b != 0, 0 % 0 is True by convention).\n        # Any non-zero integer a is considered divisible by 0 if 0 % a == 0.\n        if a == 0:\n            return True\n        if b == 0:\n            return True\n        return (a % b == 0) or (b % a == 0)\n\n    def _is_divisible_subset(subset: List[int]) -> bool:\n        \"\"\"Checks if every pair in the subset is mutually divisible.\"\"\"\n        if len(subset) <= 1:\n            return True\n\n        # Check every distinct pair in the subset\n        for i in range(len(subset)):\n            for j in range(i + 1, len(subset)):\n                if not _is_divisible_pair(subset[i], subset[j]):\n                    return False\n        return True\n\n    if not numbers:\n        return 0\n\n    # Iterate from the largest possible subset size down to 1.\n    # The first divisible subset found guarantees it's the largest.\n    for k in range(len(numbers), 0, -1):\n        for subset_tuple in itertools.combinations(numbers, k):\n            if _is_divisible_subset(list(subset_tuple)):\n                return k\n    \n    # This part is technically unreachable if `numbers` is not empty,\n    # as a subset of size 1 (any single element) is always divisible and will be found.\n    return 0"}
{"task_id": "Mbpp/619", "solution": "def move_num(input_string: str) -> str:\n    \"\"\"\n    Moves all numeric characters to the end of the given string, preserving relative order.\n    \"\"\"\n    non_numeric_chars = []\n    numeric_chars = []\n\n    for char in input_string:\n        if char.isdigit():\n            numeric_chars.append(char)\n        else:\n            non_numeric_chars.append(char)\n\n    return \"\".join(non_numeric_chars) + \"\".join(numeric_chars)"}
