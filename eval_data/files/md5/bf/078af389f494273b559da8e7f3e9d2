{"task_id": "Mbpp/276", "solution": "import math\nclass Cylinder:\n    \"\"\"Represents a cylinder and calculates its volume.\"\"\"\n    def __init__(self, radius: float, height: float):\n        self._radius = radius\n        self._height = height\n        self._volume = 0.0\n\n    def calculate_volume(self) -> float:\n        \"\"\"Calculates the volume of the cylinder (V = \u03c0 * r^2 * h).\"\"\"\n        self._volume = math.pi * (self._radius ** 2) * self._height\n        return self._volume\n\n    def get_volume(self) -> float:\n        \"\"\"Returns the calculated volume. Calculates if not already done.\"\"\"\n        if self._volume == 0.0:\n            self.calculate_volume()\n        return self._volume\ndef volume_cylinder(radius: float, height: float) -> float:\n    \"\"\"\n    Calculates the volume of a cylinder given its radius and height.\n    This function serves as the public API as specified in the SRS.\n    \"\"\"\n    cylinder = Cylinder(radius, height)\n    return cylinder.calculate_volume()"}
