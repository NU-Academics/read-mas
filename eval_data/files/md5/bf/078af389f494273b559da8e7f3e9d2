{"task_id": "Mbpp/721", "solution": "def maxAverageOfPath(matrix: list[list[int]]) -> float:\n    \"\"\"\n    Finds the path with the maximum average cost from top-left to bottom-right\n    in a square matrix, moving only right or down.\n    \"\"\"\n    N = len(matrix)\n    max_average_cost = -1.0\n\n    class Cell:\n        \"\"\"Represents a single cell within the input matrix.\"\"\"\n        def __init__(self, cost: int, row: int, col: int):\n            self.cost = cost\n            self.row = row\n            self.col = col\n\n    class Path:\n        \"\"\"Encapsulates a sequence of Cell objects forming a valid path and computes its metrics.\"\"\"\n        def __init__(self, cells_in_path: list[Cell]):\n            self.cells_in_path = cells_in_path\n            self.total_cost = sum(cell.cost for cell in cells_in_path)\n            self.number_of_cells = len(cells_in_path)\n            self.average_cost = self.total_cost / self.number_of_cells if self.number_of_cells > 0 else 0.0\n\n    def dfs(row: int, col: int, current_path_cells: list[Cell]):\n        nonlocal max_average_cost\n\n        # Base case: Reached the bottom-right cell\n        if row == N - 1 and col == N - 1:\n            path = Path(current_path_cells)\n            if path.average_cost > max_average_cost:\n                max_average_cost = path.average_cost\n            return\n\n        # Move right\n        if col + 1 < N:\n            current_path_cells.append(Cell(matrix[row][col + 1], row, col + 1))\n            dfs(row, col + 1, current_path_cells)\n            current_path_cells.pop()  # Backtrack\n\n        # Move down\n        if row + 1 < N:\n            current_path_cells.append(Cell(matrix[row + 1][col], row + 1, col))\n            dfs(row + 1, col, current_path_cells)\n            current_path_cells.pop()  # Backtrack\n\n    # Start DFS from the top-left cell\n    initial_cell = Cell(matrix[0][0], 0, 0)\n    dfs(0, 0, [initial_cell])\n\n    return max_average_cost"}
{"task_id": "Mbpp/723", "solution": "def count_same_pair(list1: list, list2: list) -> int:\n    \"\"\"\n    Counts indices where elements in two lists have the same values.\n    Assumes list1 and list2 are of the same length and contain numerical values.\n    \"\"\"\n    count = 0\n    for i in range(len(list1)):\n        if list1[i] == list2[i]:\n            count += 1\n    return count"}
{"task_id": "Mbpp/730", "solution": "def consecutive_duplicates(input_list: list) -> list:\n    \"\"\"\n    Removes consecutive duplicate elements from a list, retaining only the first occurrence.\n    A new list with consecutive duplicates removed is returned.\n    \"\"\"\n    if not input_list:\n        return []\n\n    result_list = [input_list[0]]\n    for i in range(1, len(input_list)):\n        if input_list[i] != result_list[-1]:\n            result_list.append(input_list[i])\n    return result_list"}
{"task_id": "Mbpp/725", "solution": "def extract_quotation(input_string: str) -> list[str]:\n    \"\"\"\n    Extracts values between double quotation marks from the given string.\n    This function finds all non-overlapping quoted values and returns them in order.\n    \"\"\"\n    extracted_values = []\n    current_pos = 0\n\n    while True:\n        # Find the index of the first double quote\n        first_quote_idx = input_string.find('\"', current_pos)\n\n        if first_quote_idx == -1:\n            break  # No more opening quotes found\n\n        # Find the index of the second double quote after the first one\n        second_quote_idx = input_string.find('\"', first_quote_idx + 1)\n\n        if second_quote_idx == -1:\n            break  # Opening quote found, but no closing quote\n\n        # Extract the substring between the two quotes\n        value = input_string[first_quote_idx + 1:second_quote_idx]\n        extracted_values.append(value)\n\n        # Continue searching from after the second quote\n        current_pos = second_quote_idx + 1\n\n    return extracted_values"}
