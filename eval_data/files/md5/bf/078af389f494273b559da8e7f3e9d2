{"task_id": "Mbpp/252", "solution": "import math\ndef convert(z: complex | int | float) -> tuple[float, float]:\n    \"\"\"\n    Converts a complex number or a numeric type coercible to a complex number\n    into its polar coordinate representation (magnitude, angle).\n    \"\"\"\n    complex_val = complex(z)\n    magnitude = math.sqrt(complex_val.real**2 + complex_val.imag**2)\n    angle = math.atan2(complex_val.imag, complex_val.real)\n    return (magnitude, angle)"}
{"task_id": "Mbpp/247", "solution": "def lps(input_string: str) -> int:\n    \"\"\"Calculates the length of the longest palindromic subsequence.\n\n    Args:\n        input_string: The string for which to find the LPS length.\n\n    Returns:\n        The length of the longest palindromic subsequence.\n    \"\"\"\n    n = len(input_string)\n\n    if n == 0:\n        return 0\n\n    # dp[i][j] stores the length of the longest palindromic subsequence\n    # of the substring input_string[i...j].\n    dp = [[0] * n for _ in range(n)]\n\n    # All single characters are palindromic subsequences of length 1.\n    for i in range(n):\n        dp[i][i] = 1\n\n    # Fill the table for lengths from 2 to n.\n    for length in range(2, n + 1):\n        for i in range(n - length + 1):\n            j = i + length - 1\n            if input_string[i] == input_string[j]:\n                # If characters match, they contribute 2 to the LPS.\n                # The remaining length comes from the inner substring input_string[i+1...j-1].\n                # If length is 2 (e.g., \"aa\"), dp[i+1][j-1] will be dp[i+1][i], which is 0 by default, so 2 + 0 = 2.\n                dp[i][j] = 2 + dp[i+1][j-1]\n            else:\n                # If characters do not match, take the maximum of\n                # excluding the first character or excluding the last character.\n                dp[i][j] = max(dp[i+1][j], dp[i][j-1])\n\n    # The length of the longest palindromic subsequence for the entire string.\n    return dp[0][n-1]"}
{"task_id": "Mbpp/256", "solution": "def count_Primes_nums(num: int) -> int:\n    \"\"\"\n    Counts the number of prime numbers strictly less than the given non-negative number.\n    This function uses a helper function `_is_prime` to check for primality.\n    \"\"\"\n\n    def _is_prime(n: int) -> bool:\n        \"\"\"\n        Determines if a given integer is a prime number.\n        Checks for divisibility up to the square root of n.\n        \"\"\"\n        if n < 2:\n            return False\n        if n == 2:\n            return True\n        if n % 2 == 0:\n            return False\n        # Check for odd divisors from 3 up to the square root of n\n        i = 3\n        while i * i <= n:\n            if n % i == 0:\n                return False\n            i += 2\n        return True\n\n    prime_count = 0\n    # Iterate from 2 up to num - 1 to find prime numbers\n    for i in range(2, num):\n        if _is_prime(i):\n            prime_count += 1\n    return prime_count"}
{"task_id": "Mbpp/259", "solution": "def maximize_elements(collection1: tuple[tuple[int, int]], collection2: tuple[tuple[int, int]]) -> tuple[tuple[int, int]]:\n    \"\"\"\n    Maximizes elements of two tuple collections element by element.\n    Returns a new collection where each tuple's components (x and y) are maximized from corresponding input tuples.\n    \"\"\"\n    if len(collection1) != len(collection2):\n        raise ValueError(\"Input collections must have the same number of elements.\")\n\n    maximized_result = []\n    for t1, t2 in zip(collection1, collection2):\n        max_x = max(t1[0], t2[0])\n        max_y = max(t1[1], t2[1])\n        maximized_result.append((max_x, max_y))\n\n    return tuple(maximized_result)"}
