{"task_id": "Mbpp/463", "solution": "def max_subarray_product(arr: list[int]) -> int:\n    \"\"\"Calculates the maximum product of a contiguous subarray within a list of integers.\n    Returns the maximum product found.\n    \"\"\"\n    if not arr:\n        return 0\n\n    max_so_far = arr[0]\n    min_so_far = arr[0]\n    result = arr[0]\n\n    for i in range(1, len(arr)):\n        num = arr[i]\n\n        temp_max_so_far = max_so_far\n\n        max_so_far = max(num, temp_max_so_far * num, min_so_far * num)\n        min_so_far = min(num, temp_max_so_far * num, min_so_far * num)\n\n        result = max(result, max_so_far)\n\n    return result"}
{"task_id": "Mbpp/472", "solution": "def check_Consecutive(input_list: list) -> bool:\n    \"\"\"\n    Checks if the unique, sorted elements of the input list form a consecutive sequence.\n    An empty list or a list with one element is considered consecutive.\n    \"\"\"\n    if not input_list:\n        return True\n\n    # Remove duplicates and sort the list\n    unique_sorted_list = sorted(list(set(input_list)))\n\n    # If after removing duplicates, the list is empty, it's consecutive.\n    if not unique_sorted_list:\n        return True\n\n    # Check if the difference between the max and min values plus one equals the length of the list.\n    # This ensures no gaps and that all numbers between min and max are present.\n    return unique_sorted_list[-1] - unique_sorted_list[0] + 1 == len(unique_sorted_list)"}
{"task_id": "Mbpp/473", "solution": "def tuple_intersection(list_of_tuples_1: list[tuple], list_of_tuples_2: list[tuple]) -> set[tuple]:\n    \"\"\"\n    Computes the intersection of two lists of tuples, treating tuples\n    with the same elements as identical regardless of their internal order.\n    Returns a set of unique common tuples in their canonical (sorted) form.\n    \"\"\"\n    def _to_canonical_tuple(input_tuple: tuple) -> tuple:\n        \"\"\"Sorts the elements of a tuple to create a canonical representation.\"\"\"\n        return tuple(sorted(input_tuple))\n\n    canonical_set_1 = set()\n    for tpl in list_of_tuples_1:\n        canonical_set_1.add(_to_canonical_tuple(tpl))\n\n    canonical_set_2 = set()\n    for tpl in list_of_tuples_2:\n        canonical_set_2.add(_to_canonical_tuple(tpl))\n\n    return canonical_set_1.intersection(canonical_set_2)"}
{"task_id": "Mbpp/470", "solution": "def add_pairwise(input_tuple: tuple) -> tuple:\n    \"\"\"\n    Computes the sum of each adjacent pair of elements in the given tuple.\n    Raises TypeError if input is not a tuple or contains non-numerical elements.\n    \"\"\"\n    if not isinstance(input_tuple, tuple):\n        raise TypeError(\"Input must be a tuple.\")\n\n    if len(input_tuple) < 2:\n        return ()\n\n    result_sums = []\n    for i in range(len(input_tuple) - 1):\n        val1 = input_tuple[i]\n        val2 = input_tuple[i+1]\n\n        if not isinstance(val1, (int, float)) or not isinstance(val2, (int, float)):\n            raise TypeError(f\"Tuple elements must be numerical. Found non-numerical element at index {i} or {i+1}.\")\n\n        result_sums.append(val1 + val2)\n\n    return tuple(result_sums)"}
