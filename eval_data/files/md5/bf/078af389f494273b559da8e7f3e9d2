{"task_id": "Mbpp/129", "solution": "import collections\nfrom typing import List\nclass Matrix:\n    \"\"\"\n    Encapsulates matrix data and provides methods for dimension checks and sum calculations.\n    \"\"\"\n    def __init__(self, elements: List[List[int]]) -> None:\n        self._elements = elements\n        self._num_rows = len(elements)\n        self._num_cols = len(elements[0]) if self._num_rows > 0 else 0\n        if self._num_rows > 0:\n            # Ensure all rows have the same number of columns\n            for row in elements:\n                if len(row) != self._num_cols:\n                    # Mark as non-square effectively by setting inconsistent dimensions\n                    # Or could raise an error, but design context implies robust checking.\n                    # For simplicity, we'll let `is_square` handle it more broadly.\n                    self._num_cols = -1 # Sentinel value to indicate inconsistency\n                    break\n\n\n    def is_square(self) -> bool:\n        \"\"\"Determines if the matrix is square and non-empty.\"\"\"\n        if self._num_rows == 0:\n            return False # An empty matrix is not a magic square by common definition\n        if self._num_cols == -1: # Inconsistent row lengths\n            return False\n        return self._num_rows == self._num_cols\n\n    def get_row_sum(self, row_index: int) -> int:\n        \"\"\"Calculates the sum of a specific row.\"\"\"\n        return sum(self._elements[row_index])\n\n    def get_col_sum(self, col_index: int) -> int:\n        \"\"\"Calculates the sum of a specific column.\"\"\"\n        return sum(self._elements[r][col_index] for r in range(self._num_rows))\n\n    def get_main_diagonal_sum(self) -> int:\n        \"\"\"Calculates the sum of the main diagonal.\"\"\"\n        return sum(self._elements[i][i] for i in range(self._num_rows))\n\n    def get_anti_diagonal_sum(self) -> int:\n        \"\"\"Calculates the sum of the anti-diagonal.\"\"\"\n        return sum(self._elements[i][self._num_rows - 1 - i] for i in range(self._num_rows))\nclass MagicSquareChecker:\n    \"\"\"\n    Implements the core business logic to determine if a matrix is a magic square.\n    \"\"\"\n    def check(self, matrix_data: List[List[int]]) -> bool:\n        \"\"\"\n        Main method to determine if the input matrix is a magic square.\n        \"\"\"\n        matrix = Matrix(matrix_data)\n\n        if not matrix.is_square():\n            return False\n\n        n = matrix._num_rows # side length of the square matrix\n\n        # Calculate the magic constant from the first row\n        magic_constant = matrix.get_row_sum(0)\n\n        # Check all row sums\n        for i in range(n):\n            if matrix.get_row_sum(i) != magic_constant:\n                return False\n\n        # Check all column sums\n        for i in range(n):\n            if matrix.get_col_sum(i) != magic_constant:\n                return False\n\n        # Check main diagonal sum\n        if matrix.get_main_diagonal_sum() != magic_constant:\n            return False\n\n        # Check anti-diagonal sum\n        if matrix.get_anti_diagonal_sum() != magic_constant:\n            return False\n\n        return True\ndef magic_square_test(matrix_data: List[List[int]]) -> bool:\n    \"\"\"\n    Serves as the public API entry point for the magic square check.\n    \"\"\"\n    checker = MagicSquareChecker()\n    return checker.check(matrix_data)"}
{"task_id": "Mbpp/130", "solution": "from collections import Counter\nfrom typing import List, Any, Optional\ndef max_occurrences(input_list: List[Any]) -> Optional[Any]:\n    \"\"\"\n    Finds the item with the maximum frequency in a given list.\n    Returns None if the input_list is empty.\n    \"\"\"\n    if not input_list:\n        return None\n\n    item_counts = Counter(input_list)\n\n    max_freq = 0\n    max_freq_item = None\n\n    for item, count in item_counts.items():\n        if count > max_freq:\n            max_freq = count\n            max_freq_item = item\n\n    return max_freq_item"}
