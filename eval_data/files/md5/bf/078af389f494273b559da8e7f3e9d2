{"task_id": "Mbpp/301", "solution": "def dict_depth(input_dict: dict) -> int:\n    \"\"\"\n    Calculates the maximum nesting level of dictionaries within the input dictionary.\n    The outermost dictionary is considered level 1.\n    \"\"\"\n    current_max_depth = 1\n    for value in input_dict.values():\n        if isinstance(value, dict):\n            # Recursively call dict_depth for nested dictionaries\n            nested_depth = dict_depth(value)\n            # The depth of the current path is 1 (for current_dict) + nested_depth\n            current_max_depth = max(current_max_depth, nested_depth + 1)\n    return current_max_depth"}
{"task_id": "Mbpp/305", "solution": "from typing import List, Tuple, Optional\ndef start_withp(input_list: List[str]) -> Tuple[Optional[str], Optional[str]]:\n    \"\"\"\n    Extracts the first two words starting with 'p' (case-insensitive) from a list of strings.\n    Returns them as a tuple, filling missing slots with None if fewer than two are found.\n    \"\"\"\n    found_p_words = []\n    for text_string in input_list:\n        words = text_string.split()\n        for word in words:\n            if word.lower().startswith('p'):\n                found_p_words.append(word)\n                if len(found_p_words) == 2:\n                    return (found_p_words[0], found_p_words[1])\n    \n    # Handle cases where less than two P-words were found\n    if len(found_p_words) == 1:\n        return (found_p_words[0], None)\n    else: # len(found_p_words) == 0\n        return (None, None)"}
{"task_id": "Mbpp/308", "solution": "def large_product(list1: list[float | int], list2: list[float | int], k: int) -> list[float | int]:\n    \"\"\"\n    Finds the specified number of largest products from two given lists.\n    It generates all possible products, sorts them, and returns the top k.\n    \"\"\"\n    products_collection = []\n    for element_l1 in list1:\n        for element_l2 in list2:\n            products_collection.append(element_l1 * element_l2)\n\n    products_collection.sort(reverse=True)\n\n    return products_collection[:k]"}
