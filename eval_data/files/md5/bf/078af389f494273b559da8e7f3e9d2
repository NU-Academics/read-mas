{"task_id": "Mbpp/237", "solution": "def check_occurences(input_list: list[tuple]) -> dict[tuple, int]:\n    \"\"\"\n    Counts the occurrences of unique canonical tuples in a list of tuples.\n    A canonical tuple is formed by sorting the elements of the original tuple.\n    \"\"\"\n    def _get_canonical_form(raw_tuple: tuple) -> tuple:\n        \"\"\"Transforms a raw tuple into its canonical (sorted) form.\"\"\"\n        return tuple(sorted(raw_tuple))\n\n    occurrences_map = {}\n    for raw_tuple in input_list:\n        canonical_tuple = _get_canonical_form(raw_tuple)\n        occurrences_map[canonical_tuple] = occurrences_map.get(canonical_tuple, 0) + 1\n    return occurrences_map"}
{"task_id": "Mbpp/244", "solution": "import math\ndef next_Perfect_Square(input_number: float) -> int:\n    \"\"\"Calculates the smallest perfect square strictly greater than the input number.\n    It takes the floor of the square root and adds one, then squares the result.\n    \"\"\"\n    # Calculate the square root of the input number.\n    root = math.sqrt(input_number)\n    \n    # Find the smallest integer greater than the square root of input_number.\n    # Adding 1 to the integer part of the root ensures we get the next whole number.\n    next_int_root = int(root) + 1\n    \n    # Square this integer to get the next perfect square.\n    next_square = next_int_root * next_int_root\n    \n    return next_square"}
{"task_id": "Mbpp/239", "solution": "def get_total_number_of_sequences(m: int, n: int) -> int:\n    \"\"\"\n    Calculates the total number of sequences of length n,\n    where elements are positive, <= m, and >= twice the previous element.\n    \"\"\"\n    memo = {}\n\n    def _count_sequences_recursive(current_length: int, prev_element: int) -> int:\n        \"\"\"\n        Recursive helper to count sequences from a given state, using memoization.\n        \"\"\"\n        if (current_length, prev_element) in memo:\n            return memo[(current_length, prev_element)]\n\n        if current_length == n:\n            return 1  # A complete sequence of length n has been formed\n\n        count = 0\n        # Iterate for the next element in the sequence\n        # It must be at least twice the previous element and at most m\n        for next_element in range(2 * prev_element, m + 1):\n            count += _count_sequences_recursive(current_length + 1, next_element)\n\n        memo[(current_length, prev_element)] = count\n        return count\n\n    total_number_of_sequences = 0\n    # Iterate through all possible first elements for the sequence\n    # The first element can be any positive integer from 1 to m\n    for first_element in range(1, m + 1):\n        total_number_of_sequences += _count_sequences_recursive(1, first_element)\n\n    return total_number_of_sequences"}
