{"task_id": "Mbpp/555", "solution": "def calculate_sum_of_cubes(n: int) -> int:\n    \"\"\"\n    Calculates the sum of cubes of the first n natural numbers.\n    This is done by iterating from 1 to n and summing the cube of each number.\n    \"\"\"\n    total_sum_cubes = 0\n    for i in range(1, n + 1):\n        total_sum_cubes += i ** 3\n    return total_sum_cubes\n\ndef calculate_sum_of_natural_numbers(n: int) -> int:\n    \"\"\"\n    Calculates the sum of the first n natural numbers.\n    This is done by iterating from 1 to n and summing each number.\n    \"\"\"\n    total_sum_natural = 0\n    for i in range(1, n + 1):\n        total_sum_natural += i\n    return total_sum_natural\n\ndef difference(n: int) -> int:\n    \"\"\"\n    Calculates the difference between the sum of cubes of the first n natural numbers\n    and the sum of the first n natural numbers.\n    \"\"\"\n    sum_cubes = calculate_sum_of_cubes(n)\n    sum_natural = calculate_sum_of_natural_numbers(n)\n    return sum_cubes - sum_natural"}
{"task_id": "Mbpp/556", "solution": "def find_Odd_Pair(array: list[int], size: int) -> int:\n    \"\"\"\n    Counts the number of pairs in an array whose XOR value is odd.\n    Iterates through all unique pairs and checks if their bitwise XOR result is odd.\n    \"\"\"\n    count = 0\n    for i in range(size):\n        for j in range(i + 1, size):\n            # Calculate the XOR value of the current pair\n            xor_result = array[i] ^ array[j]\n            # Check if the XOR result is odd\n            if xor_result % 2 != 0:\n                count += 1\n    return count"}
{"task_id": "Mbpp/557", "solution": "def toggle_string(input_string: str) -> str:\n    \"\"\"\n    Toggle the case of all characters in a string.\n    Converts uppercase characters to lowercase and lowercase to uppercase.\n    \"\"\"\n    toggled_chars = []\n    for char in input_string:\n        if char.isupper():\n            toggled_chars.append(char.lower())\n        elif char.islower():\n            toggled_chars.append(char.upper())\n        else:\n            toggled_chars.append(char)\n    return \"\".join(toggled_chars)"}
{"task_id": "Mbpp/558", "solution": "def _extract_digits(number: int) -> list[int]:\n    \"\"\"Extracts individual digits from an integer, least significant first.\"\"\"\n    number = abs(number)\n    if number == 0:\n        return [0]\n    digits = []\n    while number > 0:\n        digits.append(number % 10)\n        number //= 10\n    return digits\n\ndef _calculate_difference(digit1: int, digit2: int) -> int:\n    \"\"\"Calculates the absolute difference between two digits.\"\"\"\n    return abs(digit1 - digit2)\n\ndef _sum_differences(differences: list[int]) -> int:\n    \"\"\"Sums all individual digit differences.\"\"\"\n    return sum(differences)\n\ndef digit_distance_nums(num1: int, num2: int) -> int:\n    \"\"\"\n    Calculates the sum of per-digit differences between two integers.\n    Missing digits in shorter numbers are treated as zero.\n    \"\"\"\n    digits1 = _extract_digits(num1)\n    digits2 = _extract_digits(num2)\n\n    max_len = max(len(digits1), len(digits2))\n    all_differences = []\n\n    for i in range(max_len):\n        d1 = digits1[i] if i < len(digits1) else 0\n        d2 = digits2[i] if i < len(digits2) else 0\n        all_differences.append(_calculate_difference(d1, d2))\n\n    return _sum_differences(all_differences)"}
{"task_id": "Mbpp/560", "solution": "def union_elements(tuple1: tuple, tuple2: tuple) -> tuple:\n    \"\"\"\n    Find the union of elements from two tuples and return in sorted order.\n    \"\"\"\n    union_set = set(tuple1).union(set(tuple2))\n    return tuple(sorted(union_set))"}
{"task_id": "Mbpp/562", "solution": "def Find_Max_Length(list_of_lists):\n    \"\"\"\n    Finds the length of the longest sublist within a list of lists.\n    \"\"\"\n    max_length = 0\n    for sublist in list_of_lists:\n        current_length = len(sublist)\n        if current_length > max_length:\n            max_length = current_length\n    return max_length"}
{"task_id": "Mbpp/559", "solution": "import math\nfrom typing import List\n\ndef max_sub_array_sum(list: List[int], length: int) -> int:\n    \"\"\"\n    Finds the sum of the largest contiguous sublist in the given list.\n    Implements Kadane's algorithm to efficiently find the maximum subarray sum.\n    \"\"\"\n    if length == 0:\n        return 0\n\n    # Initialize variables for Kadane's algorithm.\n    # max_so_far stores the maximum sum found globally.\n    # current_max stores the maximum sum of the subarray ending at the current position.\n    max_so_far = list[0]\n    current_max = list[0]\n\n    # Iterate through the list starting from the second element.\n    for i in range(1, length):\n        # Update current_max: decide whether to extend the current subarray\n        # or start a new subarray from the current element.\n        current_max = max(list[i], current_max + list[i])\n        \n        # Update max_so_far with the larger of itself or current_max.\n        max_so_far = max(max_so_far, current_max)\n\n    return max_so_far"}
