{"task_id": "Mbpp/751", "solution": "def check_min_heap(array: list) -> bool:\n    \"\"\"\n    Checks if the given array represents a min heap.\n    Iterates through parent nodes and validates min heap property against children.\n    \"\"\"\n    n = len(array)\n\n    # An empty array or an array with a single element is always a valid min heap.\n    if n <= 1:\n        return True\n\n    # Iterate only up to the last parent node.\n    # The last parent node is at index (n // 2) - 1.\n    for i in range(n // 2):\n        left_child_idx = 2 * i + 1\n        right_child_idx = 2 * i + 2\n\n        # Check if parent is greater than its left child\n        if array[i] > array[left_child_idx]:\n            return False\n\n        # Check if right child exists and parent is greater than its right child\n        if right_child_idx < n and array[i] > array[right_child_idx]:\n            return False\n\n    return True"}
{"task_id": "Mbpp/753", "solution": "def min_k(tuple_list, k):\n    \"\"\"\n    Finds the minimum k records from a list of tuples based on their second element.\n    The result is sorted in ascending order by the second element.\n    \"\"\"\n    # Sort the list of tuples based on the second element (index 1)\n    sorted_list = sorted(tuple_list, key=lambda x: x[1])\n\n    # Return the first k elements from the sorted list\n    return sorted_list[:k]"}
{"task_id": "Mbpp/755", "solution": "def second_smallest(input_list: list) -> float:\n    \"\"\"\n    Finds the second smallest unique value in a list.\n    Assumes input_list contains numerical values and has at least two unique elements.\n    \"\"\"\n    unique_elements = sorted(list(set(input_list)))\n    return unique_elements[1]"}
{"task_id": "Mbpp/754", "solution": "def extract_index_list(l1, l2, l3):\n    \"\"\"\n    Finds elements that appear in all three lists under the same index.\n    Returns a new list containing these common elements.\n    \"\"\"\n    min_length = min(len(l1), len(l2), len(l3))\n    result = []\n    for i in range(min_length):\n        if l1[i] == l2[i] == l3[i]:\n            result.append(l1[i])\n    return result"}
{"task_id": "Mbpp/752", "solution": "def jacobsthal_num(n: int) -> int:\n    \"\"\"\n    Calculate the nth Jacobsthal number.\n\n    Args:\n        n (int): Non-negative integer representing position in sequence\n\n    Returns:\n        int: The nth Jacobsthal number\n    \"\"\"\n    if n == 0:\n        return 0\n    if n == 1:\n        return 1\n\n    # Initialize the first two Jacobsthal numbers\n    # j_n_minus_2 corresponds to J(i-2)\n    # j_n_minus_1 corresponds to J(i-1)\n    j_n_minus_2 = 0\n    j_n_minus_1 = 1\n\n    current_jacobsthal = 0\n    for i in range(2, n + 1):\n        # Apply the recurrence relation: J(i) = J(i-1) + 2*J(i-2)\n        current_jacobsthal = j_n_minus_1 + 2 * j_n_minus_2\n        # Update values for the next iteration\n        j_n_minus_2 = j_n_minus_1\n        j_n_minus_1 = current_jacobsthal\n\n    return current_jacobsthal"}
{"task_id": "Mbpp/759", "solution": "def _contains_only_valid_characters(s: str) -> bool:\n    \"\"\"Ensure string contains only digits and decimal point. Returns False for empty strings.\"\"\"\n    if not s:\n        return False\n    for char in s:\n        if not (char.isdigit() or char == '.'):\n            return False\n    return True\n\ndef _has_single_decimal_point(s: str) -> bool:\n    \"\"\"Check if string has exactly one decimal point.\"\"\"\n    return s.count('.') == 1\n\ndef _has_exactly_two_decimal_places(s: str) -> bool:\n    \"\"\"Verify exactly two digits after decimal point.\"\"\"\n    dot_index = s.find('.')\n    # If no dot, or dot is the last character, or only one character after dot.\n    if dot_index == -1 or dot_index >= len(s) - 2:\n        return False\n    \n    decimal_part = s[dot_index + 1:]\n    return len(decimal_part) == 2 and decimal_part.isdigit()\n\ndef is_decimal(input_string: str) -> bool:\n    \"\"\"Main validation function for decimal format checking with two decimal places.\"\"\"\n    # Minimum valid length for \"D.DD\" is 4 characters (e.g., \"0.00\").\n    if not input_string or len(input_string) < 4:\n        return False\n\n    # Ensure all characters are digits or a single decimal point.\n    if not _contains_only_valid_characters(input_string):\n        return False\n\n    # Check that there is exactly one decimal point.\n    if not _has_single_decimal_point(input_string):\n        return False\n\n    # Ensure there is at least one digit before the decimal point (e.g., not \".11\").\n    dot_index = input_string.find('.')\n    if dot_index == 0:\n        return False\n    \n    # Verify that there are exactly two digits after the decimal point.\n    if not _has_exactly_two_decimal_places(input_string):\n        return False\n    \n    return True"}
{"task_id": "Mbpp/758", "solution": "def unique_sublists(input_list: list) -> dict:\n    \"\"\"\n    Count occurrences of sublists converted to tuples.\n\n    Args:\n        input_list: List containing sublists to count\n\n    Returns:\n        Dictionary with tuple keys and occurrence counts as values\n    \"\"\"\n    counts = {}\n    for sublist in input_list:\n        sublist_tuple = tuple(sublist)\n        counts[sublist_tuple] = counts.get(sublist_tuple, 0) + 1\n    return counts"}
{"task_id": "Mbpp/760", "solution": "def unique_Element(numbers: list) -> bool:\n    \"\"\"\n    Check whether a list of numbers contains only one distinct element.\n    \"\"\"\n    if not numbers:\n        return False\n    return len(set(numbers)) == 1"}
{"task_id": "Mbpp/757", "solution": "from typing import List\n\ndef _normalize_string(s: str) -> str:\n    \"\"\"Normalizes string for case-insensitive comparison.\"\"\"\n    return s.lower()\n\ndef _is_reverse(s1: str, s2: str) -> bool:\n    \"\"\"Determines if two strings are reverses of each other, with a palindrome check on s1.\"\"\"\n    norm_s1 = _normalize_string(s1)\n    norm_s2 = _normalize_string(s2)\n\n    # Check if the first normalized string is the reverse of the second normalized string.\n    is_reverse_match = (norm_s1 == norm_s2[::-1])\n\n    # Per design, a pair is only counted if the first normalized string itself is not a palindrome.\n    is_not_palindrome = (norm_s1 != norm_s1[::-1])\n\n    return is_reverse_match and is_not_palindrome\n\ndef count_reverse_pairs(string_list: List[str]) -> int:\n    \"\"\"Counts the pairs of reverse strings in the given string list.\"\"\"\n    count = 0\n    # A set to store canonical representations of pairs already counted,\n    # ensuring each unique reverse pair is counted exactly once.\n    processed_pairs = set()\n\n    n = len(string_list)\n    for i in range(n):\n        for j in range(i + 1, n): # Iterate through unique pairs of indices\n            s1 = string_list[i]\n            s2 = string_list[j]\n\n            if _is_reverse(s1, s2):\n                # Create a canonical representation for the pair to handle order and duplicates.\n                # Example: (\"best\", \"tseb\") and (\"tseb\", \"best\") should map to the same canonical form.\n                norm_s1 = _normalize_string(s1)\n                norm_s2 = _normalize_string(s2)\n                canonical_pair = tuple(sorted((norm_s1, norm_s2)))\n\n                if canonical_pair not in processed_pairs:\n                    count += 1\n                    processed_pairs.add(canonical_pair)\n    return count"}
{"task_id": "Mbpp/762", "solution": "def check_monthnumber_number(month_number: int) -> bool:\n    \"\"\"\n    Check whether the given month number contains 30 days.\n\n    Args:\n        month_number (int): Month number from 1 to 12\n\n    Returns:\n        bool: True if month has 30 days, False otherwise\n    \"\"\"\n    if not (1 <= month_number <= 12):\n        return False\n\n    thirty_day_months = {4, 6, 9, 11}  # April, June, September, November\n    return month_number in thirty_day_months"}
{"task_id": "Mbpp/764", "solution": "def number_ctr(input_string):\n    \"\"\"Counts the number of digit characters in the given string.\n\n    Iterates through each character and checks if it's a digit.\n    \"\"\"\n    digit_count = 0\n    for char in input_string:\n        if char.isdigit():\n            digit_count += 1\n    return digit_count"}
{"task_id": "Mbpp/763", "solution": "def find_min_diff(array, length: int) -> int:\n    \"\"\"\n    Calculate the minimum absolute difference between any two distinct elements in the array.\n    Compares all possible pairs to find the smallest difference.\n    \"\"\"\n    min_diff = float('inf')\n\n    for i in range(length):\n        for j in range(i + 1, length):\n            current_diff = abs(array[i] - array[j])\n            if current_diff < min_diff:\n                min_diff = current_diff\n    return int(min_diff)"}
{"task_id": "Mbpp/770", "solution": "def odd_num_sum(n):\n    \"\"\"\n    Calculates the sum of the fourth power of the first n odd natural numbers.\n    \"\"\"\n    total_sum = 0\n    for i in range(1, n + 1):\n        # The i-th odd natural number is (2*i - 1)\n        odd_number = 2 * i - 1\n        total_sum += odd_number ** 4\n    return total_sum"}
{"task_id": "Mbpp/767", "solution": "def get_pairs_count(numbers: list, target_sum) -> int:\n    \"\"\"\n    Count pairs of elements whose sum equals target_sum.\n\n    Args:\n        numbers: List of numeric values\n        target_sum: Target sum value for pairs\n\n    Returns:\n        Integer count of valid pairs\n    \"\"\"\n    count = 0\n    n = len(numbers)\n    for i in range(n):\n        for j in range(i + 1, n):\n            if numbers[i] + numbers[j] == target_sum:\n                count += 1\n    return count"}
{"task_id": "Mbpp/766", "solution": "from typing import List, Tuple\n\ndef pair_wise(input_list: List) -> List[Tuple]:\n    \"\"\"\n    Returns a list of all pairs of consecutive items in a given list.\n    Handles lists with fewer than two items by returning an empty list.\n    \"\"\"\n    if len(input_list) < 2:\n        return []\n\n    result = []\n    for i in range(len(input_list) - 1):\n        result.append((input_list[i], input_list[i+1]))\n    return result"}
{"task_id": "Mbpp/769", "solution": "def Diff(list1, list2):\n    \"\"\"\n    Calculate the difference between two lists.\n\n    Args:\n        list1: First list (source list)\n        list2: Second list (filter list)\n\n    Returns:\n        List containing elements from list1 that are not in list2,\n        preserving the original order from list1\n    \"\"\"\n    filter_set = set(list2)\n    result = [element for element in list1 if element not in filter_set]\n    return result"}
{"task_id": "Mbpp/765", "solution": "def is_polite(n: int) -> int:\n    \"\"\"\n    Finds the nth polite number. A polite number is a positive integer that is not a power of 2\n    and can be expressed as the sum of two or more consecutive positive integers.\n    \"\"\"\n    if n <= 0:\n        raise ValueError(\"Input 'n' must be a positive integer.\")\n\n    # The formula for the nth polite number is 2n + 1.\n    # This comes from the observation that polite numbers are all odd numbers\n    # except 1, and all numbers that are not powers of two and are greater than 2.\n    # More precisely, a number is polite if and only if it is not a power of 2.\n    # The sequence of polite numbers (excluding powers of 2) are 3, 5, 6, 7, 9, 10, 11, ...\n    # If we consider all positive integers that are NOT powers of 2, and label them sequentially,\n    # the nth such number is the nth polite number.\n    # The problem description and example (is_polite(7) == 11) indicates this specific definition\n    # where polite numbers are essentially all non-powers of 2, starting from 3.\n\n    # We need to find the nth number that is NOT a power of 2.\n    # We can iterate through positive integers and count polite numbers.\n    # This approach is simple but potentially slow.\n\n    # A more efficient approach for finding the Nth non-power of two is described at\n    # https://www.geeksforgeeks.org/n-th-polite-number/\n    # The nth polite number is 2 * n + 1. This is based on the sequence\n    # of odd numbers that are not powers of two. However, this is not entirely correct\n    # as 6, 10, 12, etc., are also polite numbers.\n\n    # Let's re-evaluate the definition and the assert.\n    # Polite numbers are positive integers that are not powers of 2.\n    # The sequence of polite numbers:\n    # 1: not polite (power of 2)\n    # 2: not polite (power of 2)\n    # 3: polite (3 = 1+2)\n    # 4: not polite (power of 2)\n    # 5: polite (5 = 2+3)\n    # 6: polite (6 = 1+2+3)\n    # 7: polite (7 = 3+4)\n    # 8: not polite (power of 2)\n    # 9: polite (9 = 2+3+4)\n    # 10: polite (10 = 1+2+3+4)\n    # 11: polite (11 = 5+6)\n\n    # Polite sequence: 3, 5, 6, 7, 9, 10, 11, ...\n    # 1st: 3\n    # 2nd: 5\n    # 3rd: 6\n    # 4th: 7\n    # 5th: 9\n    # 6th: 10\n    # 7th: 11\n    # The example `is_polite(7) == 11` matches this sequence.\n\n    # The actual algorithm to find the nth polite number:\n    # The number of non-polite numbers (powers of 2) up to a given number 'x' is floor(log2(x)).\n    # So, if 'x' is the nth polite number, then n + floor(log2(x)) = x.\n    # We are looking for 'x' such that n + (number of powers of 2 <= x) = x.\n    # Powers of 2 are 1, 2, 4, 8, 16, ...\n    # Let's say 'x' is the Nth polite number.\n    # This means there are (N-1) polite numbers before 'x'.\n    # And 'k' non-polite numbers (powers of 2) before 'x'.\n    # So, (N-1) + k + 1 = x => N + k = x. (The +1 is for x itself if it's polite)\n    # More simply, x is the (n + count_of_powers_of_2_less_than_or_equal_to_x)th integer.\n\n    # The number of powers of 2 less than or equal to 'x' is floor(log2(x)).\n    # Let x be the nth polite number. Then x is approximately n + log2(x).\n    # We can iterate, but the design context suggests O(log n).\n\n    # The design context provides a hint: \"The Nth Polite Number Calculator ... excluding all powers of 2.\"\n    # The `_is_power_of_two` and `_can_express_as_consecutive_sum` functions in the design imply\n    # that the process involves checking numbers sequentially.\n    # However, for an O(log n) solution, direct iteration is too slow.\n\n    # The \"trick\" for the nth polite number often relies on the relationship\n    # between the index 'n' and the actual number 'x'.\n    # A number is polite if and only if it is not a power of 2.\n    # This is a common definition for polite numbers (also known as non-powers of 2).\n    # The number of integers up to M that are NOT powers of 2 is M - floor(log2(M)).\n    # So, we are looking for M such that M - floor(log2(M)) = n.\n\n    # We can use binary search or a mathematical approximation to find M.\n    # Since floor(log2(M)) grows very slowly, M is roughly n.\n    # Let's start with a guess for M, say M = n.\n    # If M is too small, M - floor(log2(M)) < n.\n    # If M is too large, M - floor(log2(M)) > n.\n\n    # A simple iterative solution to find x where x - floor(log2(x)) = n is to start checking from n.\n    # Or, to start from a lower bound. The actual value will be slightly larger than n.\n    # The difference between x and n is floor(log2(x)). So x = n + floor(log2(x)).\n    # We can estimate x initially as n + floor(log2(n)).\n    # Let k = 0\n    # While x - 2^k < n (meaning x has to be larger than n + 2^k)\n    #   k += 1\n    # This is not directly useful for O(log n).\n\n    # Let's use the property: x is the nth polite number implies that x has n-1 polite numbers before it.\n    # And there are `floor(log2(x))` numbers that are powers of 2 less than or equal to x.\n    # So, `x = n + count_of_powers_of_2_le_x`.\n    # Let's say `count_of_powers_of_2_le_x = k`.\n    # Then `x = n + k`.\n    # Also, `2^(k-1) <= x < 2^k` (if k is the exact count).\n    # So `2^(k-1) <= n+k < 2^k`.\n    # We can iterate on `k` (the number of powers of 2) to find the correct `x`.\n    # `k` will be `floor(log2(x))`.\n    # Since `x` is approximately `n`, `k` will be approximately `floor(log2(n))`.\n    # The number of powers of 2 less than or equal to `x` is `_count_powers_of_2_le(x)`.\n\n    # The Nth Polite Number can be found by searching for a number 'x' such that\n    # the count of non-powers-of-2 up to 'x' equals 'n'.\n    # `x - _count_powers_of_2_le(x) == n`\n    # Where `_count_powers_of_2_le(x)` is `floor(log2(x))` if x is not a power of 2,\n    # or `floor(log2(x)) + 1` if x is a power of 2 (this definition of count needs care).\n    # More precisely, `_count_powers_of_2_le(x)` is the largest integer `k` such that `2^k <= x`.\n    # For example, for x=7, powers are 1,2,4, so k=3. For x=8, powers are 1,2,4,8, so k=4.\n    # This is `int(math.log2(x)) + 1` if we count starting from 2^0=1.\n\n    import math\n\n    # Define a helper to check if a number is a power of 2\n    def _is_power_of_two(num: int) -> bool:\n        if num <= 0:\n            return False\n        return (num & (num - 1)) == 0\n\n    # The problem boils down to finding the nth number that is not a power of 2.\n    # We know that the value will be roughly n + log2(n).\n    # Let's try to find k such that `n + k` is our number and `k` is the number of powers of 2 up to `n + k`.\n    # `k = floor(log2(x))` for powers of 2 starting from 1.\n    # So `x = n + floor(log2(x))`.\n    # Since `log2(x)` is a slowly growing function, `x` will be slightly larger than `n`.\n    # We can iterate `k` from `floor(log2(n))` (or 0) upwards.\n    # For a given `k`, calculate `current_x = n + k`.\n    # Then check if `k` is actually `floor(log2(current_x))`.\n    # And if `current_x` is not a power of 2, and the count matches, then `current_x` is the answer.\n\n    # More precisely, we are looking for the smallest `x` such that `x - _count_powers_of_2_le(x) = n`.\n    # Here, `_count_powers_of_2_le(x)` counts 1, 2, 4, ..., 2^k where 2^k <= x.\n    # This count is `int(math.log2(x))` if x > 0.\n    # For example, `_count_powers_of_2_le(1) = int(log2(1)) = 0`. This is wrong.\n    # It should be 1 (for 1).\n    # `_count_powers_of_2_le(2) = int(log2(2)) = 1`. This is wrong. Should be 2 (for 1, 2).\n    # The count of powers of 2 less than or equal to x is `floor(log2(x)) + 1` for x >= 1.\n    # Let `count_pows = int(math.log2(x)) + 1` for x >= 1.\n    # We want to find x such that `x - count_pows(x) = n`.\n\n    # Example: n=7.\n    # Try x = 11.\n    # count_pows(11) = int(math.log2(11)) + 1 = int(3.45) + 1 = 3 + 1 = 4. (powers are 1,2,4,8).\n    # 11 - 4 = 7. This matches n.\n    # So 11 is the 7th polite number. This confirms the logic.\n\n    # How to find this x efficiently?\n    # We know `x` is slightly larger than `n`.\n    # Let `low = n`, `high = n + int(math.log2(n)) + 5` (a reasonable upper bound, since log2 grows slowly).\n    # Or, we can use an iterative approach from `n`.\n    # Since `x - (int(math.log2(x)) + 1) = n`, we can try values of `x` starting from `n`.\n    # The function `f(x) = x - (int(math.log2(x)) + 1)` is monotonically increasing.\n    # We can use binary search.\n\n    # Estimate search range:\n    # Smallest possible x for n=1: 3. `3 - (int(log2(3))+1) = 3 - (1+1) = 1`. Correct.\n    # Max x for n=1000: roughly 1000 + log2(1000) = 1000 + 10 = 1010.\n    # So the search range can be from `n` to `n + 60` (log2(2^60) is 60, covers huge n).\n    # For the problem constraints, `n` up to `1000`, the range is small.\n\n    low = n\n    # Upper bound: A loose upper bound can be n + 2 * log2(n) (or a constant like 60 for 64-bit int).\n    # For n=7, high would be around 7 + 2*log2(7) = 7 + 2*2.8 = 7 + 5.6 = 12.6. So, 13.\n    # A safe upper bound for typical integer sizes would be n + 60 (as log2(2^60) is 60).\n    # Given the test case n=7 -> 11, the value of log2(11) is 3.45.\n    # The required value is x = n + (int(log2(x)) + 1).\n    # The count of powers of 2 up to x will be at most `int(math.log2(n + 60)) + 1`. This is roughly `log2(n) + 1`.\n    # So, `high = n + int(math.log2(n + 60)) + 2` is a safe upper bound.\n    # For n=1, high = 1 + int(log2(61)) + 2 = 1 + 5 + 2 = 8.\n    # For n=7, high = 7 + int(log2(67)) + 2 = 7 + 6 + 2 = 15.\n    # For n=1000, high = 1000 + int(log2(1060)) + 2 = 1000 + 10 + 2 = 1012.\n    # This ensures `x` is in the search space.\n\n    # We are looking for the smallest `x` such that `x - (int(math.log2(x)) + 1) >= n`.\n    # If `x` is a power of 2, it is not polite. So we skip it.\n    # However, the formula `x - (int(math.log2(x)) + 1)` correctly accounts for powers of 2.\n    # For `x=8` (a power of 2), `8 - (int(log2(8)) + 1) = 8 - (3+1) = 4`.\n    # This means there are 4 polite numbers before or including 8.\n    # Polite numbers: 3, 5, 6, 7. Indeed, there are 4.\n    # So the function `f(x) = x - (int(math.log2(x)) + 1)` directly counts the number of polite integers <= x.\n    # We are looking for the smallest `x` such that `f(x) == n` AND `x` is not a power of 2.\n    # If `f(x) == n` and `x` IS a power of 2, then we need to find the next available non-power-of-2.\n    # However, because `f(x)` increments by 1 for each non-power-of-2 and stays same for power of 2.\n\n    # Let's adjust f(x) to correctly count *polite* numbers.\n    # `count_polite(x)` = `x` - `count_powers_of_2_le(x)`\n    # `count_powers_of_2_le(x)` is `k` where `2^k <= x < 2^(k+1)`. So it's `int(math.log2(x)) + 1` for `x >= 1`.\n    # This gives us `f(x) = x - (int(math.log2(x)) + 1)` for `x >= 1`.\n    # This function counts the number of non-powers of 2 up to x.\n    # We need to find the smallest `x` such that `f(x) == n`.\n\n    # Binary search for `x`.\n    # `low` can be `n`. `high` can be `n + int(math.log2(n)) + 2` (if n is large). For safety, `n + 60` for general case.\n    # The actual value of `x` is guaranteed to be within this range.\n    low = n\n    high = n + 60 # A safe upper bound for n up to 2^60-1.\n\n    ans = -1\n    while low <= high:\n        mid = low + (high - low) // 2\n        if mid == 0: # Avoid log2(0)\n            low = 1\n            continue\n\n        # Calculate the number of polite integers up to 'mid'\n        # count_powers_of_2_le(mid) = int(math.log2(mid)) + 1\n        polite_count_le_mid = mid - (int(math.log2(mid)) + 1)\n\n        if polite_count_le_mid >= n:\n            ans = mid\n            high = mid - 1\n        else:\n            low = mid + 1\n\n    # After binary search, `ans` holds the smallest `x` such that `x - (int(math.log2(x)) + 1) >= n`.\n    # This `ans` might be a power of 2.\n    # If `ans` is a power of 2, it is not polite. The `n`th polite number will be `ans + 1`.\n    # Let's verify `ans`.\n    # If `_is_power_of_two(ans)` is True, then `ans` is not the Nth polite number itself.\n    # `polite_count_le_ans` would be `ans - (int(math.log2(ans)) + 1)`.\n    # If `ans` is a power of 2, say 8. `f(8) = 8 - (int(log2(8)) + 1) = 8 - 4 = 4`.\n    # So the 4th polite number is 7. If `n=4`, binary search finds 8. But 8 is not polite.\n    # The actual 4th polite number is 7.\n    # If `n=5`, binary search finds 9. `f(9) = 9 - (int(log2(9)) + 1) = 9 - 4 = 5`.\n    # 9 is not a power of 2. So 9 is the 5th polite number. Correct.\n\n    # So, if `ans` is a power of 2, we need to increment it until it's not a power of 2.\n    # But `ans` from binary search is the smallest `x` such that `f(x) >= n`.\n    # The `f(x)` function counts the *total number* of non-powers of two up to `x`.\n    # If `ans` itself is a power of two, it means `f(ans)` is the count, but `ans` itself is not included.\n    # Example: n=4.\n    # f(7) = 7 - (int(log2(7)) + 1) = 7 - (2+1) = 4.\n    # Binary search finds ans = 7. 7 is not a power of 2. So 7 is the 4th polite number. Correct.\n\n    # Example: n=1.\n    # f(3) = 3 - (int(log2(3)) + 1) = 3 - (1+1) = 1.\n    # Binary search finds ans = 3. 3 is not a power of 2. So 3 is the 1st polite number. Correct.\n\n    # Example: n=3.\n    # f(6) = 6 - (int(log2(6)) + 1) = 6 - (2+1) = 3.\n    # Binary search finds ans = 6. 6 is not a power of 2. So 6 is the 3rd polite number. Correct.\n\n    # It seems the `ans` from the binary search is directly the result, as long as `ans` is not a power of 2.\n    # If `ans` is a power of 2, it means `f(ans-1)` was less than `n`, and `f(ans)` is `n`.\n    # Example: n=4, target 7.\n    # low=4, high=64.\n    # mid=34. f(34) = 34 - (5+1) = 28. Too high. ans=34, high=33.\n    # mid=18. f(18) = 18 - (4+1) = 13. Too high. ans=18, high=17.\n    # mid=10. f(10) = 10 - (3+1) = 6. Too high. ans=10, high=9.\n    # mid=6. f(6) = 6 - (2+1) = 3. Too low. low=7.\n    # low=7, high=9.\n    # mid=8. f(8) = 8 - (3+1) = 4. Match `n`. ans=8, high=7.\n    # low=7, high=7.\n    # mid=7. f(7) = 7 - (2+1) = 4. Match `n`. ans=7, high=6.\n    # Loop ends. `ans = 7`. This is correct.\n\n    # The result `ans` from the binary search `x - (int(math.log2(x)) + 1) >= n` is\n    # the smallest integer `x` such that there are at least `n` polite numbers up to `x`.\n    # If `x` itself is a polite number, then it is the `n`-th polite number.\n    # If `x` is a power of two, say `x=8` and `n=4`. `f(8)=4`. But 8 is not polite.\n    # In this case, the `n`-th polite number is `x-1`, which is 7.\n    # So we need to check if `ans` is a power of 2. If it is, the actual Nth polite number is `ans-1`.\n\n    # Final check of the assertion: is_polite(7) == 11\n    # n=7.\n    # low = 7, high = 67 (or 7+60).\n    # ...\n    # Let's test with `ans=11`. `f(11) = 11 - (int(log2(11)) + 1) = 11 - (3+1) = 7`.\n    # `f(10) = 10 - (int(log2(10)) + 1) = 10 - (3+1) = 6`.\n    # So `ans` will converge to 11.\n    # Is 11 a power of 2? No. So 11 is the 7th polite number.\n\n    # What if `ans` is a power of 2?\n    # Say we are looking for the 4th polite number (`n=4`).\n    # The sequence is 3, 5, 6, 7. So the 4th is 7.\n    # Binary search with `n=4`:\n    # low=4, high=64 (approx).\n    # ... `ans` will converge to 8.\n    # At `ans=8`, `f(8) = 8 - (int(log2(8)) + 1) = 8 - (3+1) = 4`. So `f(ans) == n`.\n    # Is 8 a power of 2? Yes.\n    # So the current `ans` (8) is not polite. The actual polite number must be `ans - 1`.\n    # Result should be 7.\n\n    # The logic is:\n    # 1. Binary search to find the smallest `x` such that `x - (int(math.log2(x)) + 1) = n`. Let this be `ans_candidate`.\n    # 2. If `_is_power_of_two(ans_candidate)`, then the actual `n`-th polite number is `ans_candidate + 1`.\n    #    No, this isn't right. It should be `ans_candidate + 1` only if `ans_candidate` was found as `f(x) == n-1` but `x` itself is power of 2.\n    #    The binary search finds the smallest `ans` such that `count_polite(ans) >= n`.\n    #    If `count_polite(ans) == n` and `ans` is NOT a power of 2, then `ans` is the answer.\n    #    If `count_polite(ans) == n` and `ans` IS a power of 2, then `ans` cannot be the nth polite number.\n    #    In this case, `ans-1` must have `count_polite(ans-1) = n`. And `ans-1` cannot be a power of two\n    #    (because `ans` is a power of two, so `ans-1` must be odd and not a power of two unless `ans=1` or `ans=2`).\n    #    But for `ans > 2` and being power of two, `ans-1` is always polite.\n    #    Consider `n=4`, `ans=8`. `f(8)=4`. But 8 is not polite. `f(7)=4`. 7 is polite. So result is 7.\n    #    This implies that if `f(ans) == n` and `ans` is a power of 2, then `ans-1` is the result.\n\n    # The code `ans = mid` in `polite_count_le_mid >= n` assigns the smallest `mid` that satisfies the condition.\n    # After the loop, `ans` holds `x` such that `f(x) = n` or `f(x) = n-1` and `x` is the transition point.\n    # This `ans` will be the smallest number `M` such that `M - (int(math.log2(M)) + 1)` is exactly `n`.\n    # Except, if `M` itself is a power of 2, `M - (int(math.log2(M)) + 1)` correctly gives the count of polite numbers *up to and including* `M-1`.\n    # Because a power of 2 contributes zero to the count of polite numbers.\n    # So, if `_is_power_of_two(ans)` is True, it means `ans` is a power of two,\n    # and `ans - (int(math.log2(ans)) + 1)` counts `n` polite numbers, all of which must be less than `ans`.\n    # Therefore, the `n`-th polite number is `ans - 1`.\n    # If `_is_power_of_two(ans)` is False, then `ans` itself is the `n`-th polite number.\n\n    if _is_power_of_two(ans):\n        return ans - 1\n    else:\n        return ans"}
{"task_id": "Mbpp/772", "solution": "def remove_length(input_string: str, k: int) -> str:\n    \"\"\"Removes all words with k length from the given string.\"\"\"\n    if not input_string:\n        return \"\"\n    if k <= 0:\n        return input_string\n\n    words = input_string.split(' ')\n    filtered_words = [word for word in words if len(word) != k]\n    return ' '.join(filtered_words)"}
{"task_id": "Mbpp/773", "solution": "def occurance_substring(main_string: str, search_substring: str) -> tuple[str, int, int] | None:\n    \"\"\"\n    Find the occurrence and position of substring within a string.\n    Returns (substring, start_position, end_position) if found, None otherwise.\n    \"\"\"\n    start_index = main_string.find(search_substring)\n\n    if start_index == -1:\n        return None\n    else:\n        end_index = start_index + len(search_substring)\n        return (search_substring, start_index, end_index)"}
{"task_id": "Mbpp/771", "solution": "def check_expression(expression: str) -> bool:\n    \"\"\"\n    Checks if the given expression has balanced brackets using a stack-based approach.\n    It supports parentheses, square brackets, and curly braces.\n    \"\"\"\n    BRACKET_PAIRS = {')': '(', ']': '[', '}': '{'}\n    \n    # Sets for efficient lookup of opening and closing brackets\n    open_brackets = set(BRACKET_PAIRS.values())\n    close_brackets = set(BRACKET_PAIRS.keys())\n    \n    stack = []\n\n    for char in expression:\n        if char in open_brackets:\n            stack.append(char)\n        elif char in close_brackets:\n            if not stack:\n                return False  # Mismatched closing bracket (no corresponding opening bracket)\n            \n            last_open = stack.pop()\n            if last_open != BRACKET_PAIRS[char]:\n                return False  # Mismatched bracket type\n    \n    return not stack # Expression is balanced if the stack is empty at the end"}
{"task_id": "Mbpp/775", "solution": "def odd_position(input_list):\n    \"\"\"Checks if every odd-indexed element in the list is an odd number.\"\"\"\n    for i, num in enumerate(input_list):\n        if i % 2 != 0:  # If the index is odd\n            if num % 2 == 0:  # And the number at this odd index is even\n                return False\n    return True"}
{"task_id": "Mbpp/781", "solution": "def count_divisors(n: int) -> bool:\n    \"\"\"\n    Checks if the count of divisors for a given positive integer is even.\n    This function utilizes helper functions to find divisors and check parity.\n    \"\"\"\n\n    def _find_divisors(num: int) -> list[int]:\n        \"\"\"\n        Finds all positive divisors for a given integer.\n        Returns a list containing all divisors.\n        \"\"\"\n        divs = []\n        i = 1\n        while i * i <= num:\n            if num % i == 0:\n                divs.append(i)\n                if i * i != num:\n                    divs.append(num // i)\n            i += 1\n        return divs\n\n    def _is_even(count: int) -> bool:\n        \"\"\"\n        Checks if a given integer count is an even number.\n        Returns True if even, False otherwise.\n        \"\"\"\n        return count % 2 == 0\n\n    divisors = _find_divisors(n)\n    return _is_even(len(divisors))"}
{"task_id": "Mbpp/777", "solution": "def find_sum(input_list):\n    \"\"\"\n    Finds the sum of non-repeated elements in a given list.\n    Elements that appear exactly once are considered non-repeated.\n    \"\"\"\n    frequency_map = {}\n    for item in input_list:\n        frequency_map[item] = frequency_map.get(item, 0) + 1\n\n    total_sum = 0\n    for item, count in frequency_map.items():\n        if count == 1:\n            total_sum += item\n            \n    return total_sum"}
{"task_id": "Mbpp/778", "solution": "def pack_consecutive_duplicates(input_list: list) -> list:\n    \"\"\"\n    Packs consecutive duplicate elements of a list into sublists.\n    Processes the list in O(n) time, grouping identical consecutive items.\n    \"\"\"\n    if not input_list:\n        return []\n\n    result = []\n    current_group = []\n\n    for element in input_list:\n        if not current_group or element == current_group[0]:\n            current_group.append(element)\n        else:\n            result.append(current_group)\n            current_group = [element]\n\n    # Append the last accumulated group\n    if current_group:\n        result.append(current_group)\n\n    return result"}
{"task_id": "Mbpp/780", "solution": "import itertools\nfrom typing import List, Tuple, Union\n\ndef find_combinations(tuple_list: List[Tuple[Union[int, float], Union[int, float]]]) -> List[Tuple[Union[int, float], Union[int, float]]]:\n    \"\"\"\n    Finds all unique pairwise combinations of tuples from the input list and returns their element-wise sums.\n    Assumes each input tuple contains exactly two numeric elements.\n    \"\"\"\n    result_sums = []\n    # Generate all unique pairs of tuples from the input list\n    for t1, t2 in itertools.combinations(tuple_list, 2):\n        # Calculate the element-wise sum for each pair\n        sum_tuple = (t1[0] + t2[0], t1[1] + t2[1])\n        result_sums.append(sum_tuple)\n    return result_sums"}
{"task_id": "Mbpp/782", "solution": "def odd_length_sum(arr: list) -> int:\n    \"\"\"\n    Calculates the sum of all odd-length subarrays within a given input array.\n    This function coordinates helper functions to generate odd-length subarray indices and sum their values.\n    \"\"\"\n    def _generate_subarrays(arr: list) -> list:\n        \"\"\"Generates all subarray indices with odd lengths from the input array.\"\"\"\n        n = len(arr)\n        odd_length_indices = []\n        for i in range(n):\n            for j in range(i, n):\n                if (j - i + 1) % 2 != 0:  # Check if length is odd\n                    odd_length_indices.append((i, j))\n        return odd_length_indices\n\n    def _calculate_subarray_sum(arr: list, start: int, end: int) -> int:\n        \"\"\"Calculates the sum of a subarray from start to end index.\"\"\"\n        return sum(arr[start : end + 1])\n\n    total_sum = 0\n    odd_indices = _generate_subarrays(arr)\n    for start, end in odd_indices:\n        total_sum += _calculate_subarray_sum(arr, start, end)\n    return total_sum"}
{"task_id": "Mbpp/784", "solution": "from typing import List\n\ndef mul_even_odd(numbers: List[int]) -> int:\n    \"\"\"Finds the product of the first even and first odd number in a list.\n    Assumes the list will contain at least one even and one odd number.\"\"\"\n    first_even = None\n    first_odd = None\n\n    for num in numbers:\n        if first_odd is None and num % 2 != 0:\n            first_odd = num\n        if first_even is None and num % 2 == 0:\n            first_even = num\n        \n        # If both are found, we can stop iterating\n        if first_even is not None and first_odd is not None:\n            break\n            \n    return first_even * first_odd"}
