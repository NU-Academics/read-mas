{"task_id": "Mbpp/799", "solution": "def left_rotate(number: int, distance: int) -> int:\n    \"\"\"\n    Rotates the bits of a 32-bit number to the left by a given distance.\n    \"\"\"\n    BITS = 32\n    \n    # Normalize the rotation distance\n    normalized_distance = distance % BITS\n    \n    # Perform the left shift, including bits that wrap around\n    # The part that shifts into the higher bits (and needs to be wrapped)\n    left_shifted = (number << normalized_distance)\n    # The part that wraps around from the higher bits to the lower bits\n    wrapped_around = (number >> (BITS - normalized_distance))\n    \n    # Combine the shifted parts and mask to ensure it stays within 32 bits\n    return (left_shifted | wrapped_around) & ((1 << BITS) - 1)"}
{"task_id": "Mbpp/800", "solution": "def remove_all_spaces(input_string: str) -> str:\n    \"\"\"Removes all whitespace characters from the input string.\"\"\"\n    return ''.join(char for char in input_string if not char.isspace())"}
{"task_id": "Mbpp/801", "solution": "def test_three_equal(a: int, b: int, c: int) -> int:\n    \"\"\"\n    Count the number of equal values among three integers.\n    The count reflects the size of the largest group of identical numbers.\n    \"\"\"\n    unique_numbers = {a, b, c}\n    num_unique = len(unique_numbers)\n\n    if num_unique == 1:\n        return 3 # All three are equal\n    elif num_unique == 2:\n        return 2 # Exactly two are equal\n    else: # num_unique == 3\n        return 1 # All three are distinct"}
{"task_id": "Mbpp/803", "solution": "import math\n\ndef is_perfect_square(number):\n    \"\"\"\n    Checks if the given number is a perfect square.\n    Returns False for negative numbers.\n    \"\"\"\n    if number < 0:\n        return False\n    \n    # Calculate the square root using math.sqrt.\n    # This handles both integer and float inputs.\n    sqrt_val = math.sqrt(number)\n    \n    # Check if the square root is an integer by comparing it to its integer part.\n    # A robust way to avoid float precision issues is to cast to int and then square it.\n    int_sqrt = int(sqrt_val)\n    return int_sqrt * int_sqrt == number"}
{"task_id": "Mbpp/806", "solution": "def max_run_uppercase(input_string: str) -> int:\n    \"\"\"\n    Finds the maximum run of consecutive uppercase ASCII characters in a string.\n    Processes the string in a single pass to achieve O(n) time complexity.\n    \"\"\"\n    max_run = 0\n    current_run = 0\n    for char in input_string:\n        if 'A' <= char <= 'Z':  # Check for ASCII uppercase characters\n            current_run += 1\n        else:\n            current_run = 0\n        max_run = max(max_run, current_run)\n    return max_run"}
