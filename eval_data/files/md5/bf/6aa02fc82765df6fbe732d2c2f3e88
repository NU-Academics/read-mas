{"task_id": "Mbpp/566", "solution": "def sum_digits(n: int) -> int:\n    \"\"\"Calculates the sum of the digits of a non-negative integer.\"\"\"\n    total_sum = 0\n    if n == 0:\n        return 0\n    while n > 0:\n        digit = n % 10\n        total_sum += digit\n        n //= 10\n    return total_sum"}
{"task_id": "Mbpp/563", "solution": "def extract_values(input_string: str) -> list[str]:\n    \"\"\"Extract all values enclosed in double quotation marks from input string.\"\"\"\n    _validate_input(input_string)\n    \n    positions = _find_quoted_segments(input_string)\n    extracted_values = _extract_content(input_string, positions)\n    \n    return extracted_values\n\ndef _find_quoted_segments(text: str) -> list[tuple[int, int]]:\n    \"\"\"Find start and end positions of all quoted segments.\"\"\"\n    segments = []\n    in_quote = False\n    start_index = -1\n    for i, char in enumerate(text):\n        if char == '\"':\n            if not in_quote:\n                start_index = i + 1\n                in_quote = True\n            else:\n                segments.append((start_index, i))\n                in_quote = False\n    return segments\n\ndef _extract_content(text: str, positions: list[tuple[int, int]]) -> list[str]:\n    \"\"\"Extract content from text at specified positions.\"\"\"\n    return [text[start:end] for start, end in positions]\n\ndef _validate_input(input_string: str) -> bool:\n    \"\"\"Validate input string meets requirements.\"\"\"\n    # Based on the context, validation here implies ensuring it's a string,\n    # but the type hint already covers that. Length constraint is also mentioned\n    # (up to 10,000 chars), which Python handles efficiently.\n    # No explicit error raising for simplicity as per instructions.\n    return True"}
{"task_id": "Mbpp/564", "solution": "def count_Pairs(numbers: list[int], n: int) -> int:\n    \"\"\"\n    Count unordered pairs of unequal elements in a list of integers.\n\n    Args:\n        numbers: List of integers to process\n        n: Length parameter (for interface compliance)\n\n    Returns:\n        Integer count of unordered pairs with unequal elements\n    \"\"\"\n    count = 0\n    num_elements = len(numbers)\n\n    # Iterate through all possible unordered pairs (i, j) where i < j\n    for i in range(num_elements):\n        for j in range(i + 1, num_elements):\n            # Check if the elements at indices i and j are unequal\n            if numbers[i] != numbers[j]:\n                count += 1\n    return count"}
{"task_id": "Mbpp/567", "solution": "def issort_list(input_list: list) -> bool:\n    \"\"\"\n    Checks if a list is sorted in ascending order.\n    Handles empty and single-element lists as sorted.\n    \"\"\"\n    if len(input_list) <= 1:\n        return True\n\n    for i in range(len(input_list) - 1):\n        if input_list[i] > input_list[i+1]:\n            return False\n    return True"}
