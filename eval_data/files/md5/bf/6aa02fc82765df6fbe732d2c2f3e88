{"task_id": "Mbpp/445", "solution": "def index_multiplication(tuple1, tuple2):\n    \"\"\"\n    Performs index-wise multiplication of elements in two input tuples containing nested tuples.\n    Each nested tuple's corresponding elements are multiplied together.\n    \"\"\"\n    result = []\n    for inner_tuple1, inner_tuple2 in zip(tuple1, tuple2):\n        multiplied_first = inner_tuple1[0] * inner_tuple2[0]\n        multiplied_second = inner_tuple1[1] * inner_tuple2[1]\n        result.append((multiplied_first, multiplied_second))\n    return tuple(result)"}
{"task_id": "Mbpp/440", "solution": "import string\nimport re\n\n# Define a set of common adverbs for internal use. This list is illustrative.\n# Adverbs are stored in lowercase for case-insensitive matching.\n_ADVERB_LIST = {\n    \"abruptly\", \"always\", \"anywhere\", \"apart\", \"away\", \"backward\", \"back\", \"bravely\",\n    \"carefully\", \"clearly\", \"down\", \"eagerly\", \"easily\", \"eventually\", \"everywhere\",\n    \"exactly\", \"finally\", \"forward\", \"frankly\", \"generally\", \"gently\", \"greatly\",\n    \"happily\", \"here\", \"honestly\", \"hopefully\", \"immediately\", \"in\", \"just\",\n    \"kindly\", \"lazily\", \"loudly\", \"madly\", \"mostly\", \"nearly\", \"neatly\", \"nervously\",\n    \"never\", \"nowhere\", \"often\", \"only\", \"out\", \"patiently\", \"perfectly\",\n    \"personally\", \"poorly\", \"possibly\", \"presently\", \"probably\", \"quickly\",\n    \"quietly\", \"rarely\", \"readily\", \"really\", \"recently\", \"regularly\", \"rightly\",\n    \"roughly\", \"sadly\", \"safely\", \"secretly\", \"seriously\", \"shortly\", \"simply\",\n    \"sincerely\", \"slowly\", \"smoothly\", \"softly\", \"somewhere\", \"soon\",\n    \"specifically\", \"suddenly\", \"surely\", \"terribly\", \"thankfully\", \"there\",\n    \"thoroughly\", \"tightly\", \"today\", \"together\", \"tomorrow\", \"truly\", \"unexpectedly\",\n    \"up\", \"usually\", \"very\", \"virtually\", \"warmly\", \"weakly\", \"wearily\", \"wildly\",\n    \"wisely\", \"yearly\", \"yesterday\"\n}\n\ndef _clean_punctuation(word: str) -> str:\n    \"\"\"Removes leading and trailing punctuation from a word.\"\"\"\n    return word.strip(string.punctuation)\n\ndef _is_adverb(word: str) -> bool:\n    \"\"\"Checks if a cleaned word (case-insensitive) is in the predefined adverb list.\"\"\"\n    return word.lower() in _ADVERB_LIST\n\ndef _calculate_positions(sentence: str, original_word: str, search_start_index: int) -> tuple:\n    \"\"\"Calculates the start and end character positions of the adverb in the sentence.\"\"\"\n    start_pos = sentence.find(original_word, search_start_index)\n    cleaned_word = _clean_punctuation(original_word)\n    end_pos = start_pos + len(cleaned_word)\n    return (start_pos, end_pos)\n\ndef _split_words(sentence: str) -> list[tuple[str, int]]:\n    \"\"\"\n    Splits a sentence into a list of (word, start_index) tuples.\n    A word is defined as a sequence of non-whitespace characters.\n    \"\"\"\n    words_with_positions = []\n    for match in re.finditer(r'\\S+', sentence):\n        words_with_positions.append((match.group(0), match.start()))\n    return words_with_positions\n\ndef find_adverb_position(sentence: str) -> tuple:\n    \"\"\"\n    Finds the first adverb and its positions in a given sentence.\n    Returns (start_position, end_position, adverb_text) or None if no adverb is found.\n    \"\"\"\n    words_with_positions = _split_words(sentence)\n\n    for word, start_index_in_sentence in words_with_positions:\n        cleaned_word = _clean_punctuation(word)\n        if _is_adverb(cleaned_word):\n            start_pos, end_pos = _calculate_positions(sentence, word, start_index_in_sentence)\n            return (start_pos, end_pos, cleaned_word)\n            \n    return None"}
{"task_id": "Mbpp/450", "solution": "from typing import List\n\ndef extract_string(string_list: List[str], size: int) -> List[str]:\n    \"\"\"\n    Extract strings of specified size from a given list of string values.\n    Returns a new list containing only strings with length equal to the specified size.\n    \"\"\"\n    filtered_strings = []\n    for s in string_list:\n        if len(s) == size:\n            filtered_strings.append(s)\n    return filtered_strings"}
{"task_id": "Mbpp/451", "solution": "def _is_whitespace(char: str) -> bool:\n    \"\"\"\n    Check if a character is whitespace.\n    \"\"\"\n    return char.isspace()\n\ndef remove_whitespaces(input_string: str) -> str:\n    \"\"\"\n    Remove all whitespace characters from the given string.\n    \"\"\"\n    result_chars = []\n    for char in input_string:\n        if not _is_whitespace(char):\n            result_chars.append(char)\n    return \"\".join(result_chars)"}
{"task_id": "Mbpp/448", "solution": "def cal_sum(n: int) -> int:\n    \"\"\"Calculate sum of first n Perrin numbers.\n\n    Args:\n        n: Number of Perrin numbers to sum (non-negative integer)\n\n    Returns:\n        Sum of first n Perrin numbers\n\n    Raises:\n        ValueError: If n is negative\n    \"\"\"\n    def _validate_input(val: int) -> bool:\n        \"\"\"Validate input parameter. Returns True if valid, False otherwise.\"\"\"\n        return val >= 0\n\n    def _generate_perrin_sequence(count: int) -> list[int]:\n        \"\"\"Generate first count Perrin numbers. Returns a list of Perrin numbers.\"\"\"\n        if count <= 0:\n            return []\n        if count == 1:\n            return [3]\n        if count == 2:\n            return [3, 0]\n\n        perrin_sequence = [3, 0, 2] # P(0), P(1), P(2)\n\n        for i in range(3, count):\n            next_perrin = perrin_sequence[i-2] + perrin_sequence[i-3]\n            perrin_sequence.append(next_perrin)\n        return perrin_sequence\n\n    if not _validate_input(n):\n        raise ValueError(\"Input must be a non-negative integer\")\n\n    if n == 0:\n        return 0\n\n    perrin_numbers = _generate_perrin_sequence(n)\n    return sum(perrin_numbers)"}
{"task_id": "Mbpp/453", "solution": "def sumofFactors(number: int) -> int:\n    \"\"\"\n    Calculates the sum of even factors for a given number.\n    Identifies all factors, filters for even ones, and sums them.\n    \"\"\"\n    if number <= 0:\n        return 0\n\n    total_sum = 0\n    # Iterate from 1 up to the number itself to find all factors\n    for i in range(1, number + 1):\n        if number % i == 0:  # Check if 'i' is a factor\n            if i % 2 == 0:  # Check if the factor 'i' is even\n                total_sum += i\n    return total_sum"}
