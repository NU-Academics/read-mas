{"task_id": "Mbpp/614", "solution": "def cummulative_sum(tuple_list):\n    \"\"\"\n    Calculate cumulative sum of all numeric values in tuple list.\n\n    Args:\n        tuple_list (list): List of tuples containing numeric values\n\n    Returns:\n        number: Sum of all numeric values across all tuples\n    \"\"\"\n    # Handle empty list case\n    if not tuple_list:\n        return 0\n\n    # Extract and sum all numeric values\n    total_sum = 0\n    for tuple_item in tuple_list:\n        for value in tuple_item:\n            if isinstance(value, (int, float)):\n                total_sum += value\n\n    return total_sum"}
{"task_id": "Mbpp/612", "solution": "def merge(list_of_lists):\n    \"\"\"\n    Transforms a list of two-element sublists into a list of two new lists.\n    The first new list contains all first elements, the second contains all second elements.\n    \"\"\"\n    first_elements = [sublist[0] for sublist in list_of_lists]\n    second_elements = [sublist[1] for sublist in list_of_lists]\n    return [first_elements, second_elements]"}
{"task_id": "Mbpp/615", "solution": "def average_tuple(input_tuples: tuple) -> list[float]:\n    \"\"\"\n    Calculate arithmetic mean for each inner tuple.\n    \"\"\"\n    results = []\n    for inner_tuple in input_tuples:\n        if inner_tuple: # Handle empty inner tuples gracefully to avoid ZeroDivisionError\n            results.append(sum(inner_tuple) / len(inner_tuple))\n        else:\n            results.append(0.0) # Or specific handling for empty tuples, e.g., 0.0 or NaN\n    return results"}
{"task_id": "Mbpp/616", "solution": "def _validate_length(tuple1: tuple, tuple2: tuple) -> None:\n    \"\"\"Validates that input tuples have the same length.\n    Raises ValueError if lengths do not match.\"\"\"\n    if len(tuple1) != len(tuple2):\n        raise ValueError(\"Tuples must have the same length for element-wise modulo.\")\n\ndef _handle_division_by_zero(dividend: int, divisor: int) -> int:\n    \"\"\"Performs modulo operation, raising ZeroDivisionError if divisor is zero.\"\"\"\n    if divisor == 0:\n        raise ZeroDivisionError(\"Cannot perform modulo with a divisor of zero.\")\n    return dividend % divisor\n\ndef tuple_modulo(tuple1: tuple, tuple2: tuple) -> tuple:\n    \"\"\"Performs element-wise modulo operation on two tuples of the same length.\"\"\"\n    _validate_length(tuple1, tuple2)\n    \n    result = []\n    for x, y in zip(tuple1, tuple2):\n        result.append(_handle_division_by_zero(x, y))\n        \n    return tuple(result)"}
