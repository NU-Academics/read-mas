{"task_id": "Mbpp/111", "solution": "def common_in_nested_lists(nested_lists):\n    \"\"\"\n    Find elements that appear in all sublists of the input nested list.\n\n    Args:\n        nested_lists: List of lists containing numeric elements\n\n    Returns:\n        set: Set of elements common to all sublists\n    \"\"\"\n    if not nested_lists:\n        return set()\n\n    # Initialize the set of common elements with the elements from the first sublist\n    common_elements = set(nested_lists[0])\n\n    # Iterate through the rest of the sublists and perform intersection\n    for sublist in nested_lists[1:]:\n        common_elements.intersection_update(set(sublist))\n        # If common_elements becomes empty, no need to check further\n        if not common_elements:\n            break\n\n    return common_elements"}
{"task_id": "Mbpp/113", "solution": "def check_integer(input_string: str) -> bool:\n    \"\"\"\n    Checks if a string represents a valid integer, handling signs and non-numeric characters.\n    It returns False for empty or whitespace-only strings.\n    \"\"\"\n\n    def _is_empty(s: str) -> bool:\n        return len(s) == 0\n\n    def _is_whitespace_only(s: str) -> bool:\n        return s.isspace()\n\n    def _handle_sign(s: str) -> str:\n        if len(s) > 0 and (s[0] == '-' or s[0] == '+'):\n            return s[1:]\n        return s\n\n    def _is_numeric(char: str) -> bool:\n        return '0' <= char <= '9'\n\n    if _is_empty(input_string):\n        return False\n    if _is_whitespace_only(input_string):\n        return False\n\n    processed_string = _handle_sign(input_string)\n\n    if _is_empty(processed_string):  # After removing sign, string might be empty (e.g., \"+\", \"-\")\n        return False\n\n    for char in processed_string:\n        if not _is_numeric(char):\n            return False\n    return True"}
{"task_id": "Mbpp/119", "solution": "def search(array: list) -> int:\n    \"\"\"\n    Finds the element that appears only once in a sorted array where all other elements appear twice.\n    \"\"\"\n    low = 0\n    high = len(array) - 1\n\n    while low < high:\n        mid = (low + high) // 2\n\n        # Ensure mid is an even index to compare with mid+1 for pairs.\n        # If mid is odd, decrement it to point to the start of the current pair.\n        if mid % 2 == 1:\n            mid -= 1\n\n        # Check if the current pair (array[mid], array[mid+1]) is normal.\n        if array[mid] == array[mid + 1]:\n            # If they are equal, the unique element is to the right of this pair.\n            # Move 'low' past this pair.\n            low = mid + 2\n        else:\n            # If they are not equal, array[mid] is either the unique element itself,\n            # or the unique element is in the left part of the array before mid.\n            # So, the search space reduces to the left part including mid.\n            high = mid\n\n    # When low == high, we have found the index of the single element.\n    return array[low]"}
{"task_id": "Mbpp/120", "solution": "import math\nfrom typing import List, Tuple, Union\n\ndef max_product_tuple(tuple_list: List[Tuple[Union[int, float], Union[int, float]]]) -> Union[int, float]:\n    \"\"\"\n    Finds the maximum absolute product between numbers in pairs of tuples within a given list.\n    Handles input validation and returns 0 for an empty list.\n    \"\"\"\n    def validate_input(lst):\n        if not isinstance(lst, list):\n            raise ValueError(\"Input must be a list.\")\n        for item in lst:\n            if not isinstance(item, tuple) or len(item) != 2:\n                raise ValueError(\"Each item in the list must be a tuple of exactly two elements.\")\n            if not all(isinstance(x, (int, float)) for x in item):\n                raise ValueError(\"All tuple elements must be numeric (int or float).\")\n\n    def calculate_absolute_product(tuple_pair):\n        return math.fabs(tuple_pair[0] * tuple_pair[1])\n\n    def find_maximum(products):\n        if not products:\n            # According to the diagram 'Empty List? -> Yes -> Return 0 or Raise Exception'\n            # The assert implies 0 for empty list if not explicitly stated otherwise for this specific function.\n            return 0\n        return max(products)\n\n    validate_input(tuple_list)\n\n    if not tuple_list:\n        return 0\n\n    products = []\n    for item in tuple_list:\n        products.append(calculate_absolute_product(item))\n\n    return find_maximum(products)"}
