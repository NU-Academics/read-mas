{"task_id": "Mbpp/301", "solution": "def dict_depth(dictionary: dict) -> int:\n    \"\"\"\n    Calculates the maximum depth of nested dictionaries.\n    Returns a minimum depth of 1 for any dictionary.\n    \"\"\"\n    if not isinstance(dictionary, dict):\n        # As per design context, input validation ensures a dict is passed.\n        # This branch should ideally not be reached if validation is external.\n        return 0 # Or handle error, but design states no explicit error handling for this func.\n\n    def _is_dict(value) -> bool:\n        \"\"\"Helper to check if a value is a dictionary.\"\"\"\n        return isinstance(value, dict)\n\n    def _calculate_max_depth(current_dict: dict, current_depth: int) -> int:\n        \"\"\"Recursively traverses nested dictionaries to find the maximum depth.\"\"\"\n        max_depth_found = current_depth\n        for value in current_dict.values():\n            if _is_dict(value):\n                max_depth_found = max(max_depth_found, _calculate_max_depth(value, current_depth + 1))\n        return max_depth_found\n\n    return _calculate_max_depth(dictionary, 1)"}
{"task_id": "Mbpp/297", "solution": "from typing import List\n\ndef flatten_list(nested_list: List) -> List:\n    \"\"\"\n    Flattens a nested list structure into a single-level list.\n    Recursively processes sublists to preserve element order.\n    \"\"\"\n    result = []\n    for item in nested_list:\n        if isinstance(item, list):\n            result.extend(flatten_list(item))\n        else:\n            result.append(item)\n    return result"}
{"task_id": "Mbpp/299", "solution": "from typing import List, Tuple, Dict, Union\n\ndef max_aggregate(tuple_list: List[Tuple[str, Union[int, float]]]) -> Tuple[str, Union[int, float]]:\n    \"\"\"\n    Calculates the maximum aggregate from a list of name-value tuples.\n    Aggregates values by name and returns the name with the highest total sum.\n    \"\"\"\n\n    def _aggregate_by_name(data_list: List[Tuple[str, Union[int, float]]]) -> Dict[str, Union[int, float]]:\n        \"\"\"Aggregates numeric values by name from a list of tuples.\"\"\"\n        aggregates: Dict[str, Union[int, float]] = {}\n        for name, value in data_list:\n            aggregates[name] = aggregates.get(name, 0) + value\n        return aggregates\n\n    def _find_maximum(aggregates_dict: Dict[str, Union[int, float]]) -> Tuple[str, Union[int, float]]:\n        \"\"\"Identifies the name with the highest aggregate value.\"\"\"\n        if not aggregates_dict:\n            # If the aggregates dictionary is empty, return a default.\n            return (None, 0) \n        \n        # Find the (name, total_sum) pair with the maximum total_sum.\n        max_item = max(aggregates_dict.items(), key=lambda item: item[1])\n        return max_item\n\n    aggregated_sums = _aggregate_by_name(tuple_list)\n    result = _find_maximum(aggregated_sums)\n    return result"}
{"task_id": "Mbpp/306", "solution": "def max_sum_increasing_subseq(array, length, i, k):\n    \"\"\"\n    Finds the maximum sum of an increasing subsequence from array[0...i] that also includes array[k] (where k > i).\n    Returns 0 if no such subsequence exists.\n    \"\"\"\n    if not (0 <= i < length and 0 <= k < length and k > i):\n        return 0\n\n    dp = [0] * (i + 1)\n    # Initialize dp array with the elements themselves for single-element subsequences\n    for x in range(i + 1):\n        dp[x] = array[x]\n\n    # Calculate max sum increasing subsequence for prefix up to i\n    for current_idx in range(i + 1):\n        for prev_idx in range(current_idx):\n            if array[current_idx] > array[prev_idx]:\n                dp[current_idx] = max(dp[current_idx], dp[prev_idx] + array[current_idx])\n\n    max_sum = 0\n    # Consider subsequences ending at various points in the prefix `i`\n    # and ensuring that they are smaller than array[k]\n    for x in range(i + 1):\n        if array[k] > array[x]: # Ensure the subsequence can be extended by array[k]\n            max_sum = max(max_sum, dp[x])\n    \n    # If no valid subsequence ending at or before i can be extended by array[k],\n    # the sum might just be array[k] itself if k is the only element or the first element.\n    # However, the problem implies extending a prefix subsequence.\n    # If max_sum is still 0, it means no increasing subsequence ending at x < k and array[x] < array[k] was found.\n    # In this case, the subsequence can start with array[k] or just be array[k].\n    # But the requirement is \"from prefix until ith index and also including a given kth element\".\n    # This implies array[k] must be *added* to a prefix increasing subsequence.\n    # If max_sum is 0, it means no valid prefix was found, so we check if array[k] can start a subsequence.\n    # If array[k] is the smallest element or the first increasing element, it could be part of a solution.\n    # The current logic assumes we *extend* an existing prefix subsequence.\n    \n    # The minimum sum including array[k] would be array[k] itself if no valid prefix subsequence exists.\n    # However, the problem states \"max sum of increasing subsequence from prefix until ith index AND also including k\".\n    # This means the subsequence MUST contain elements from [0...i] AND element at k.\n    # If no prefix element array[x] (x <= i) satisfies array[x] < array[k], then it's impossible to form an\n    # increasing subsequence that includes both. In this scenario, max_sum would remain 0 from the loop above.\n    \n    # If `max_sum` is 0 here, it means no valid `dp[x]` (for x <= i) was found such that `array[x] < array[k]`.\n    # This implies no such increasing subsequence (from 0 to i) can be extended by `array[k]`.\n    # Therefore, the overall max sum is 0 if no valid path exists.\n    # Otherwise, we add array[k] to the best prefix sum found.\n    \n    if max_sum > 0:\n        return max_sum + array[k]\n    else:\n        # If no prefix element can precede array[k] while maintaining increasing order,\n        # then no valid subsequence meeting all criteria exists.\n        # Or, if array[k] is the smallest element and no element before it can precede it,\n        # but the sequence still requires \"from prefix until ith index\".\n        # The only case where max_sum could be 0 is if array[k] is less than or equal to all prefix elements,\n        # or if all valid prefix subsequences are less than array[k] (which max_sum considers).\n        # Consider `[10, 20, 30], i=2, k=3, arr[k]=5`. max_sum would be 0 after loop. Then `0 + 5` is not right.\n        # The correct interpretation is if no `dp[x]` could be extended by `array[k]`, then no such sequence exists.\n        # So return 0.\n        return 0 if max_sum == 0 else max_sum + array[k] # Redundant check, simplified below.\n\n    # Simplified logic: if `max_sum` is 0 from the loop, it means no valid prefix `dp[x]` was found\n    # that could be extended by `array[k]`. In this case, the result is 0 because the requirement\n    # is to include a subsequence \"from prefix until ith index\".\n    # If `max_sum` is greater than 0, it means we found the maximum increasing subsequence sum\n    # from the prefix that can be followed by `array[k]`.\n    # So we add `array[k]` to that sum.\n    return max_sum + array[k] if max_sum > 0 else 0"}
{"task_id": "Mbpp/308", "solution": "def large_product(list1, list2, count):\n    \"\"\"\n    Finds the specified number of largest products from two given lists,\n    selecting one factor from each list.\n    \"\"\"\n    all_products = []\n    for num1 in list1:\n        for num2 in list2:\n            all_products.append(num1 * num2)\n\n    all_products.sort(reverse=True)\n    return all_products[:count]"}
