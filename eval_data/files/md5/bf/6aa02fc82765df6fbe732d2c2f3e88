{"task_id": "Mbpp/735", "solution": "def toggle_middle_bits(number: int) -> int:\n    \"\"\"\n    Toggles all bits of the number except the first (MSB) and the last (LSB) bit.\n    This function operates in O(1) time complexity using bitwise operations.\n    \"\"\"\n    if number == 0:\n        return 0\n\n    # Calculate the number of bits required to represent the number\n    # For number = 9 (binary 1001), bit_length = 4\n    bit_length = number.bit_length()\n\n    # Create a mask to toggle all bits. E.g., for bit_length 4, all_ones_mask = 1111 (binary)\n    all_ones_mask = (1 << bit_length) - 1\n\n    # Create a mask for the first bit (MSB). E.g., for bit_length 4, first_bit_mask = 1000 (binary)\n    first_bit_mask = 1 << (bit_length - 1)\n\n    # Create a mask for the last bit (LSB). E.g., for bit_length 4, last_bit_mask = 0001 (binary)\n    last_bit_mask = 1\n\n    # Combine the first and last bit masks. E.g., for bit_length 4, boundary_mask = 1001 (binary)\n    boundary_mask = first_bit_mask | last_bit_mask\n\n    # Create the middle bits mask. This is all_ones_mask XORed with boundary_mask.\n    # E.g., all_ones_mask = 1111, boundary_mask = 1001, middle_mask = 0110 (binary)\n    middle_mask = all_ones_mask ^ boundary_mask\n\n    # Toggle the middle bits of the original number by XORing with the middle_mask.\n    # E.g., number = 1001, middle_mask = 0110, result = 1111 (binary)\n    return number ^ middle_mask"}
{"task_id": "Mbpp/734", "solution": "from typing import List\n\ndef _calculate_product(sublist: List) -> int:\n    \"\"\"\n    Calculates the product of elements in a sublist, treating an empty sublist's product as 0.\n    \"\"\"\n    if not sublist:\n        return 0\n    product = 1\n    for x in sublist:\n        product *= x\n    return product\n\ndef _generate_sublists(input_list: List) -> List[List]:\n    \"\"\"\n    Generates all contiguous sublists from the given input list.\n    \"\"\"\n    sublists = []\n    n = len(input_list)\n    for i in range(n):\n        for j in range(i, n):\n            sublists.append(input_list[i : j + 1])\n    return sublists\n\ndef sum_Of_Subarray_Prod(input_list: List) -> int:\n    \"\"\"\n    Finds the sum of products of all possible contiguous sublists of a given list.\n    \"\"\"\n    all_sublists = _generate_sublists(input_list)\n    total_sum_of_products = 0\n    for sublist in all_sublists:\n        total_sum_of_products += _calculate_product(sublist)\n    return total_sum_of_products"}
{"task_id": "Mbpp/733", "solution": "from typing import List\n\ndef find_first_occurrence(arr: List[int], target: int) -> int:\n    \"\"\"\n    Finds the index of the first occurrence of target in a sorted array using binary search.\n    Returns the index or -1 if the target is not found.\n    \"\"\"\n    low = 0\n    high = len(arr) - 1\n    result_idx = -1\n\n    while low <= high:\n        mid = low + (high - low) // 2\n\n        if arr[mid] == target:\n            result_idx = mid\n            high = mid - 1  # Search for the first occurrence in the left half\n        elif arr[mid] < target:\n            low = mid + 1\n        else:  # arr[mid] > target\n            high = mid - 1\n\n    return result_idx"}
{"task_id": "Mbpp/737", "solution": "import re\n\ndef check_str(input_string: str) -> bool:\n    \"\"\"\n    Checks if the given string starts with a vowel (a, e, i, o, u) using regex, case-insensitively.\n    Returns False for empty strings.\n    \"\"\"\n    if not input_string:\n        return False\n    # Use re.IGNORECASE for case-insensitive matching\n    # The pattern \"^[aeiou]\" matches a vowel at the beginning of the string\n    return bool(re.match(r\"^[aeiou]\", input_string, re.IGNORECASE))"}
{"task_id": "Mbpp/736", "solution": "def left_insertion(array: list[int], target: int) -> int:\n    \"\"\"\n    Locates the left insertion point for a specified value in a sorted array using binary search.\n    Handles various edge cases including empty arrays and duplicates to return the leftmost index.\n    \"\"\"\n    left, right = 0, len(array)\n\n    while left < right:\n        mid = left + (right - left) // 2\n        if array[mid] < target:\n            left = mid + 1\n        else:\n            right = mid\n    return left"}
