{"task_id": "Mbpp/629", "solution": "def Split(numbers: list[int]) -> list[int]:\n    \"\"\"Filters even numbers from a list, preserving order.\"\"\"\n    even_numbers = []\n    for num in numbers:\n        if num % 2 == 0:\n            even_numbers.append(num)\n    return even_numbers"}
{"task_id": "Mbpp/632", "solution": "from typing import List\n\ndef move_zero(input_list: List[int]) -> List[int]:\n    \"\"\"\n    Move all zero values to the end of the list while preserving\n    the relative order of non-zero elements.\n\n    Args:\n        input_list: List of integers to process\n\n    Returns:\n        List with all zeros moved to the end\n    \"\"\"\n    non_zeros = []\n    zero_count = 0\n\n    for num in input_list:\n        if num == 0:\n            zero_count += 1\n        else:\n            non_zeros.append(num)\n\n    non_zeros.extend([0] * zero_count)\n    return non_zeros"}
{"task_id": "Mbpp/630", "solution": "def get_coordinates(coord_tuple):\n    \"\"\"\n    Extracts all adjacent coordinates of the given coordinate tuple in a 3x3 grid pattern.\n    The coordinates are returned in row-major order (y-coordinate first, then x-coordinate).\n    \"\"\"\n\n    x_center, y_center = coord_tuple\n\n    def _generate_grid_offsets():\n        \"\"\"Generates offset values for a 3x3 grid.\"\"\"\n        offsets = []\n        for dy in range(-1, 2):\n            for dx in range(-1, 2):\n                offsets.append((dx, dy))\n        return offsets\n\n    def _calculate_adjacent_coordinates(x, y):\n        \"\"\"Calculates all 9 coordinates in a 3x3 grid centered at (x, y).\"\"\"\n        all_coords = []\n        offsets = _generate_grid_offsets()\n        for dx, dy in offsets:\n            all_coords.append((x + dx, y + dy))\n        return all_coords\n\n    def _sort_coordinates(coordinates):\n        \"\"\"Sorts coordinates in row-major order (y-coordinate first, then x-coordinate).\"\"\"\n        return sorted(coordinates, key=lambda coord: (coord[1], coord[0]))\n\n    def _format_output(coordinates):\n        \"\"\"Formats coordinates as a list of lists.\"\"\"\n        return [[x, y] for x, y in coordinates]\n\n    # Main workflow\n    raw_coordinates = _calculate_adjacent_coordinates(x_center, y_center)\n    sorted_coordinates = _sort_coordinates(raw_coordinates)\n    formatted_output = _format_output(sorted_coordinates)\n\n    return formatted_output"}
{"task_id": "Mbpp/633", "solution": "def pair_xor_Sum(numbers, count):\n    \"\"\"\n    Calculates the sum of XOR of all unique pairs of numbers in the given list.\n    The 'count' parameter is not strictly used for logic but kept for signature compliance.\n    \"\"\"\n    total_xor_sum = 0\n    n = len(numbers)\n\n    # Iterate through all unique pairs\n    for i in range(n):\n        for j in range(i + 1, n):\n            # Calculate XOR for the current pair\n            xor_result = numbers[i] ^ numbers[j]\n            # Add the result to the total sum\n            total_xor_sum += xor_result\n            \n    return total_xor_sum"}
