{"task_id": "Mbpp/472", "solution": "def check_Consecutive(numbers: list) -> bool:\n    \"\"\"\n    Checks if a list of numbers contains consecutive integers after sorting.\n    Returns True if the numbers are consecutive, False otherwise.\n    \"\"\"\n    if not numbers or len(numbers) < 2:\n        return False\n\n    sorted_numbers = sorted(numbers)\n\n    for i in range(len(sorted_numbers) - 1):\n        if sorted_numbers[i] + 1 != sorted_numbers[i+1]:\n            return False\n\n    return True"}
{"task_id": "Mbpp/463", "solution": "def max_subarray_product(arr: list[int]) -> int:\n    \"\"\"\n    Finds the maximum product of a contiguous subarray within the given array.\n    Handles positive, negative, and zero values efficiently.\n    \"\"\"\n    # Initialize max_product to negative infinity to correctly handle arrays with all negative numbers,\n    # where the maximum product might still be negative (e.g., [-1]).\n    # current_max and current_min track the maximum and minimum product ending at the current position.\n    # They are initialized to 1, representing an empty product sequence that we can extend.\n    max_product = float('-inf')\n    current_max = 1\n    current_min = 1\n\n    for num in arr:\n        if num == 0:\n            # If the current number is 0, any product ending at this point becomes 0.\n            # We reset current_max and current_min to 1 to start a new subarray product calculation\n            # from the next element. The global max_product is updated to consider 0 itself.\n            current_max = 1\n            current_min = 1\n            max_product = max(max_product, 0)\n        else:\n            # Store the current_max before it's potentially updated, as it's needed for current_min calculation.\n            temp_current_max = current_max\n\n            # The new current_max can be:\n            # 1. The number itself (starting a new subarray).\n            # 2. The previous current_max multiplied by the number (extending the max positive product).\n            # 3. The previous current_min multiplied by the number (if number is negative, this can turn a small negative into a large positive).\n            current_max = max(num, temp_current_max * num, current_min * num)\n\n            # The new current_min can be:\n            # 1. The number itself (starting a new subarray).\n            # 2. The previous current_max multiplied by the number (extending the negative product).\n            # 3. The previous current_min multiplied by the number (extending the small negative product).\n            current_min = min(num, temp_current_max * num, current_min * num)\n\n            # Update the global maximum product found so far.\n            max_product = max(max_product, current_max)\n            \n    return max_product"}
{"task_id": "Mbpp/474", "solution": "def replace_char(input_string: str, target_char: str, replacement_char: str) -> str:\n    \"\"\"\n    Replace all occurrences of target_char in input_string with replacement_char.\n\n    Returns a new string with all occurrences of target_char replaced.\n    \"\"\"\n    new_string_chars = []\n    for char in input_string:\n        if char == target_char:\n            new_string_chars.append(replacement_char)\n        else:\n            new_string_chars.append(char)\n    return \"\".join(new_string_chars)"}
{"task_id": "Mbpp/473", "solution": "def tuple_intersection(list1: list, list2: list) -> set:\n    \"\"\"\n    Finds the intersection of tuples between two lists, treating tuples as equivalent irrespective of element order.\n    It returns a set of normalized common tuples.\n    \"\"\"\n\n    def _normalize_tuple(tuple_input: tuple) -> tuple:\n        \"\"\"Sorts the elements within a tuple for consistent comparison.\"\"\"\n        return tuple(sorted(tuple_input))\n\n    # Normalize all tuples in the first list and store them in a set for efficient lookup.\n    normalized_set1 = {_normalize_tuple(t) for t in list1}\n\n    # Normalize all tuples in the second list.\n    normalized_set2 = {_normalize_tuple(t) for t in list2}\n\n    # Find the intersection of the two sets of normalized tuples.\n    return normalized_set1.intersection(normalized_set2)"}
