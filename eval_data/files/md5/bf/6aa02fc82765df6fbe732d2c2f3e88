{"task_id": "Mbpp/96", "solution": "def divisor(n: int) -> int:\n    \"\"\"\n    Calculates the number of positive divisors for a given integer.\n    Iterates up to the square root of n to find divisor pairs efficiently.\n    \"\"\"\n    count = 0\n    i = 1\n    while i * i <= n:\n        if n % i == 0:\n            if i * i == n:  # Perfect square, i is counted once\n                count += 1\n            else:  # i and n/i are two distinct divisors\n                count += 2\n        i += 1\n    return count"}
{"task_id": "Mbpp/92", "solution": "def is_undulating(number: int) -> bool:\n    \"\"\"\n    Checks if a number is undulating (alternates between two different digits).\n    Requires a minimum of 3 digits.\n    \"\"\"\n\n    def _extract_digits(num: int) -> list[int]:\n        \"\"\"Extracts individual digits from an integer.\"\"\"\n        s_num = str(num)\n        return [int(digit) for digit in s_num]\n\n    def _validate_length(digits_list: list[int]) -> bool:\n        \"\"\"Validates if the digit list has a minimum of 3 elements.\"\"\"\n        return len(digits_list) >= 3\n\n    def _check_alternating_pattern(digits_list: list[int]) -> bool:\n        \"\"\"Checks if digits alternate between exactly two different values.\"\"\"\n        first_digit = digits_list[0]\n        second_digit = digits_list[1]\n\n        # The two alternating digits must be different\n        if first_digit == second_digit:\n            return False\n\n        for i in range(2, len(digits_list)):\n            if i % 2 == 0:  # Even index, should match the first digit\n                if digits_list[i] != first_digit:\n                    return False\n            else:  # Odd index, should match the second digit\n                if digits_list[i] != second_digit:\n                    return False\n        return True\n\n    # Handle negative numbers by taking the absolute value as the pattern is sign-agnostic\n    abs_number = abs(number)\n\n    digits = _extract_digits(abs_number)\n\n    if not _validate_length(digits):\n        return False\n\n    return _check_alternating_pattern(digits)"}
{"task_id": "Mbpp/97", "solution": "def frequency_lists(list_of_lists: list) -> dict:\n    \"\"\"\n    Calculates the frequency of each element in a flattened list of lists.\n    Returns a dictionary mapping elements to their counts.\n    \"\"\"\n    # Flatten the nested list structure into a single list.\n    flattened_list = [item for sublist in list_of_lists for item in sublist]\n\n    # Count the frequency of each unique element in the flattened list.\n    frequency_map = {}\n    for item in flattened_list:\n        frequency_map[item] = frequency_map.get(item, 0) + 1\n\n    return frequency_map"}
{"task_id": "Mbpp/95", "solution": "def Find_Min_Length(list_of_lists):\n    \"\"\"\n    Find the length of the smallest list in a list of lists.\n    Returns 0 if the input list of lists is empty.\n    \"\"\"\n    if not list_of_lists:\n        return 0\n\n    min_length = float('inf')\n\n    for sublist in list_of_lists:\n        current_length = len(sublist)\n        if current_length < min_length:\n            min_length = current_length\n            \n    return int(min_length)"}
{"task_id": "Mbpp/98", "solution": "import math\n\ndef multiply_num(input_collection):\n    \"\"\"\n    Multiplies all numbers in a collection and divides the product by the collection's length.\n    Handles empty collections by returning 0 to avoid division by zero.\n    \"\"\"\n    if not input_collection:\n        return 0.0\n\n    product = 1\n    for num in input_collection:\n        product *= num\n        \n    return product / len(input_collection)"}
