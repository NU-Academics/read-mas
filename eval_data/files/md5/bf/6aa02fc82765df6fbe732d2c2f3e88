{"task_id": "Mbpp/726", "solution": "def multiply_elements(input_tuple: tuple) -> tuple:\n    \"\"\"\n    Calculates the product of consecutive elements in a tuple of numbers.\n    Raises ValueError if the input tuple contains fewer than two elements.\n    \"\"\"\n    if len(input_tuple) < 2:\n        raise ValueError(\"Input tuple must contain at least two elements.\")\n\n    products = []\n    for i in range(len(input_tuple) - 1):\n        products.append(input_tuple[i] * input_tuple[i+1])\n\n    return tuple(products)"}
{"task_id": "Mbpp/725", "solution": "def extract_quotation(input_string: str) -> list[str]:\n    \"\"\"\n    Extracts values enclosed within double quotation marks from the given string.\n    Processes the string once to find quoted segments and add them to a list.\n    \"\"\"\n    extracted_values = []\n    in_quote = False\n    start_index = -1\n\n    for i, char in enumerate(input_string):\n        if char == '\"':\n            if not in_quote:\n                # Found an opening quote\n                in_quote = True\n                start_index = i + 1\n            else:\n                # Found a closing quote\n                in_quote = False\n                extracted_values.append(input_string[start_index:i])\n                start_index = -1 # Reset for next segment\n\n    return extracted_values"}
{"task_id": "Mbpp/731", "solution": "import math\n\ndef lateralsurface_cone(r, h):\n    \"\"\"\n    Calculates the lateral surface area of a cone given its radius and height.\n    Uses the formula \u03c0 * r * \u221a(r\u00b2 + h\u00b2).\n    \"\"\"\n    slant_height = math.sqrt(r**2 + h**2)\n    lateral_area = math.pi * r * slant_height\n    return lateral_area"}
{"task_id": "Mbpp/730", "solution": "def consecutive_duplicates(input_list):\n    \"\"\"\n    Removes consecutive duplicate elements from a list, preserving the order and non-consecutive duplicates.\n    Returns a new list with no side effects on the original input.\n    \"\"\"\n    if not input_list:\n        return []\n\n    result_list = [input_list[0]]\n    for i in range(1, len(input_list)):\n        if input_list[i] != input_list[i-1]:\n            result_list.append(input_list[i])\n    return result_list"}
