{"task_id": "Mbpp/721", "solution": "import math\n\nclass Cell:\n    \"\"\"Represents an individual cell in the matrix with its coordinates and cost.\"\"\"\n    def __init__(self, row: int, col: int, cost: float):\n        self._row = row\n        self._col = col\n        self._cost = float(cost)\n\n    def get_row(self) -> int:\n        return self._row\n\n    def get_col(self) -> int:\n        return self._col\n\n    def get_cost(self) -> float:\n        return self._cost\n\nclass Matrix:\n    \"\"\"Manages matrix data and provides cell access.\"\"\"\n    def __init__(self, matrix_data: list[list[float]]):\n        self._cells = matrix_data\n        self._size = len(matrix_data)\n\n    def get_cell_cost(self, row: int, col: int) -> float:\n        return self._cells[row][col]\n\n    def get_size(self) -> int:\n        return self._size\n\nclass Path:\n    \"\"\"Manages path sequences and calculates costs/averages.\"\"\"\n    def __init__(self):\n        self._cells: list[Cell] = []\n        self._total_cost: float = 0.0\n        self._cell_count: int = 0\n\n    def add_cell(self, cell: Cell) -> None:\n        self._cells.append(cell)\n        self._total_cost += cell.get_cost()\n        self._cell_count += 1\n\n    def calculate_average(self) -> float:\n        if self._cell_count == 0:\n            return 0.0\n        return self._total_cost / self._cell_count\n\n    def get_last_cell(self) -> Cell | None:\n        if not self._cells:\n            return None\n        return self._cells[-1]\n\nclass PathFinder:\n    \"\"\"Generates all valid paths and finds the maximum average.\"\"\"\n    def __init__(self, matrix: Matrix):\n        self._matrix = matrix\n        self._max_average = -math.inf\n        self._size = matrix.get_size()\n\n    def _find_paths_recursive(self, current_path: Path, row: int, col: int) -> None:\n        if row >= self._size or col >= self._size:\n            return\n\n        cell_cost = self._matrix.get_cell_cost(row, col)\n        current_cell = Cell(row, col, cell_cost)\n        current_path.add_cell(current_cell)\n\n        if row == self._size - 1 and col == self._size - 1:\n            self._max_average = max(self._max_average, current_path.calculate_average())\n            # Backtrack by removing the last cell added\n            current_path._total_cost -= current_cell.get_cost()\n            current_path._cell_count -= 1\n            current_path._cells.pop()\n            return\n\n        # Move right\n        self._find_paths_recursive(current_path, row, col + 1)\n        # Move down\n        self._find_paths_recursive(current_path, row + 1, col)\n\n        # Backtrack: remove the current cell after exploring all paths from it\n        current_path._total_cost -= current_cell.get_cost()\n        current_path._cell_count -= 1\n        current_path._cells.pop()\n\n    def find_max_average(self) -> float:\n        initial_path = Path()\n        self._find_paths_recursive(initial_path, 0, 0)\n        return self._max_average\n\ndef maxAverageOfPath(matrix: list[list[float]]) -> float:\n    \"\"\"\n    Finds a path with the maximum average over all existing paths in a square matrix.\n    Paths start from the top-left, move only right or down, and end at the bottom-right.\n    \"\"\"\n    matrix_obj = Matrix(matrix)\n    path_finder = PathFinder(matrix_obj)\n    return path_finder.find_max_average()"}
{"task_id": "Mbpp/724", "solution": "def power_base_sum(base: int, power: int) -> int:\n    \"\"\"Calculate the sum of all digits of the base to the specified power.\"\"\"\n    # Calculate the exponential result (base^power)\n    exponential_result = base ** power\n\n    # Convert the result to a string to iterate through digits\n    number_string = str(exponential_result)\n\n    # Sum all individual digits in the string\n    digit_sum = sum(int(digit) for digit in number_string)\n\n    return digit_sum"}
