{"task_id": "Mbpp/745", "solution": "from typing import List\n\ndef extract_digits(number: int) -> List[int]:\n    \"\"\"\n    Extracts individual digits from a number.\n    \"\"\"\n    return [int(d) for d in str(number)]\n\ndef contains_zero(digits: List[int]) -> bool:\n    \"\"\"\n    Checks if a list of digits contains the digit zero.\n    \"\"\"\n    return 0 in digits\n\ndef is_divisible_by_digits(number: int, digits: List[int]) -> bool:\n    \"\"\"\n    Checks if a number is divisible by all its constituent digits.\n    \"\"\"\n    for digit in digits:\n        if number % digit != 0:\n            return False\n    return True\n\ndef divisible_by_digits(startnum: int, endnum: int) -> List[int]:\n    \"\"\"\n    Finds numbers within a given range where every number is divisible by every digit it contains.\n    Numbers containing the digit 0 are excluded.\n    \"\"\"\n    result = []\n    for num in range(startnum, endnum + 1):\n        digits = extract_digits(num)\n        \n        if contains_zero(digits):\n            continue\n        \n        if is_divisible_by_digits(num, digits):\n            result.append(num)\n            \n    return result"}
{"task_id": "Mbpp/748", "solution": "def capital_words_spaces(input_string: str) -> str:\n    \"\"\"\n    Adds spaces before capital letters that start new words in a given string.\n    \"\"\"\n    if not input_string:\n        return \"\"\n\n    result = []\n    for i, char in enumerate(input_string):\n        if i > 0 and char.isupper():\n            # Add space if previous character was lowercase (e.g., camelCase)\n            if input_string[i-1].islower():\n                result.append(' ')\n            # Add space if previous was uppercase but current is followed by lowercase (e.g., HTTPResponse)\n            elif input_string[i-1].isupper() and (i + 1 < len(input_string) and input_string[i+1].islower()):\n                result.append(' ')\n        result.append(char)\n\n    return \"\".join(result)"}
