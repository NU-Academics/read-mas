{"task_id": "Mbpp/16", "solution": "def text_lowercase_underscore(input_string: str) -> bool:\n    \"\"\"\n    Checks if the input string consists only of lowercase letters and underscores,\n    with underscores separating letter sequences and not appearing consecutively or at ends.\n    \"\"\"\n    if not input_string:\n        return False\n\n    if input_string.startswith('_') or input_string.endswith('_'):\n        return False\n\n    for i, char in enumerate(input_string):\n        # Character validation: must be a lowercase letter or an underscore.\n        if not ('a' <= char <= 'z' or char == '_'):\n            return False\n\n        # Consecutive underscore validation.\n        if char == '_' and i + 1 < len(input_string) and input_string[i + 1] == '_':\n            return False\n\n    return True"}
{"task_id": "Mbpp/56", "solution": "def check(number):\n    \"\"\"\n    Checks if a given number is one less than twice its reverse.\n    Uses a helper function to reverse the number's digits.\n    \"\"\"\n    def reverse_number(n):\n        \"\"\"Reverses the digits of an integer.\"\"\"\n        return int(str(n)[::-1])\n\n    reversed_num = reverse_number(number)\n    return number == (2 * reversed_num) - 1"}
