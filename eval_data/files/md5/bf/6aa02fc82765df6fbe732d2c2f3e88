{"task_id": "Mbpp/71", "solution": "def _calculate_gap(current_gap: int) -> int:\n    \"\"\"Calculates the next gap value for the comb sort algorithm.\"\"\"\n    return max(1, int(current_gap / 1.3))\n\ndef _swap_elements(arr: list, i: int, j: int) -> None:\n    \"\"\"Swaps two elements in the list at specified indices.\"\"\"\n    arr[i], arr[j] = arr[j], arr[i]\n\ndef comb_sort(input_list: list) -> list:\n    \"\"\"\n    Sorts a list of elements using the Comb Sort algorithm in ascending order.\n    A mutable copy of the input list is sorted and returned.\n    \"\"\"\n    arr = input_list[:]\n    n = len(arr)\n\n    if n <= 1:\n        return arr\n\n    gap = n\n    swapped = True\n\n    while gap > 1 or swapped:\n        gap = _calculate_gap(gap)\n        swapped = False\n\n        for i in range(n - gap):\n            if arr[i] > arr[i + gap]:\n                _swap_elements(arr, i, i + gap)\n                swapped = True\n    return arr"}
{"task_id": "Mbpp/74", "solution": "def is_samepatterns(array1: list, array2: list) -> bool:\n    \"\"\"\n    Checks if two arrays follow the same pattern structure.\n    \"\"\"\n    if len(array1) != len(array2):\n        return False\n\n    def _create_pattern_map(arr: list) -> dict:\n        \"\"\"\n        Creates a dictionary where keys are elements and values are lists of indices\n        where each element appears in the array.\n        \"\"\"\n        pattern_map = {}\n        for i, item in enumerate(arr):\n            if item not in pattern_map:\n                pattern_map[item] = []\n            pattern_map[item].append(i)\n        return pattern_map\n\n    def _compare_pattern_sequences(map1: dict, map2: dict) -> bool:\n        \"\"\"\n        Compares two pattern maps to determine if they represent the same structural pattern.\n        This is achieved by comparing the ordered sequences of index lists for corresponding elements.\n        \"\"\"\n        if len(map1) != len(map2):\n            return False\n\n        # Extract the values (lists of indices) from both maps.\n        # Sort these lists of index lists based on their first element (the first occurrence index).\n        # This ensures that we compare the pattern of the \"first unique element\",\n        # \"second unique element\", and so on, consistently between the two arrays.\n        map1_values_sorted = sorted(map1.values(), key=lambda x: x[0])\n        map2_values_sorted = sorted(map2.values(), key=lambda x: x[0])\n\n        return map1_values_sorted == map2_values_sorted\n\n    pattern_map1 = _create_pattern_map(array1)\n    pattern_map2 = _create_pattern_map(array2)\n\n    return _compare_pattern_sequences(pattern_map1, pattern_map2)"}
{"task_id": "Mbpp/75", "solution": "def find_tuples(tuple_list, k):\n    \"\"\"\n    Filters a list of tuples, returning only those where all elements are divisible by k.\n    Assumes k is a non-zero integer and tuple elements are integers.\n    \"\"\"\n    result = []\n    for current_tuple in tuple_list:\n        all_elements_divisible = True\n        for element in current_tuple:\n            if element % k != 0:\n                all_elements_divisible = False\n                break\n        if all_elements_divisible:\n            result.append(current_tuple)\n    return result"}
