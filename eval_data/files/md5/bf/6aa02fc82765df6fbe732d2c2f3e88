{"task_id": "Mbpp/591", "solution": "def swap_List(input_list: list) -> list:\n    \"\"\"\n    Interchanges the first and last elements in a list.\n    Returns a new list with the elements swapped, without modifying the original.\n    \"\"\"\n    list_length = len(input_list)\n    if list_length < 2:\n        return list(input_list)\n    else:\n        # Create a new list with the last element first,\n        # middle elements in place, and the first element last.\n        return [input_list[list_length - 1]] + input_list[1:list_length - 1] + [input_list[0]]"}
{"task_id": "Mbpp/589", "solution": "import math\n\ndef perfect_squares(start, end):\n    \"\"\"\n    Finds perfect squares between two given numbers (inclusive).\n    \"\"\"\n    if start < 0:\n        start = 0 # Perfect squares are non-negative, start from 0 if lower bound is negative\n\n    # Calculate the smallest integer whose square is >= start\n    min_root = math.ceil(math.sqrt(start))\n    \n    # Calculate the largest integer whose square is <= end\n    max_root = math.floor(math.sqrt(end))\n\n    perfect_squares_list = []\n    # Iterate from min_root to max_root (inclusive) to generate perfect squares\n    for i in range(int(min_root), int(max_root) + 1):\n        perfect_squares_list.append(i * i)\n\n    return perfect_squares_list"}
{"task_id": "Mbpp/593", "solution": "def removezero_ip(ip_address: str) -> str:\n    \"\"\"\n    Removes leading zeroes from each octet of an IPv4 address string.\n    Splits the IP by dots, converts each octet to an integer and back to string to remove leading zeroes, then joins them back.\n    \"\"\"\n    octets = ip_address.split('.')\n    processed_octets = [str(int(octet)) for octet in octets]\n    return '.'.join(processed_octets)"}
{"task_id": "Mbpp/592", "solution": "import math\n\ndef _calculate_binomial_coefficient(n: int, k: int) -> int:\n    \"\"\"Calculates the binomial coefficient C(n, k).\"\"\"\n    if k < 0 or k > n:\n        return 0\n    return math.factorial(n) // (math.factorial(k) * math.factorial(n - k))\n\ndef _validate_input(n) -> bool:\n    \"\"\"Placeholder for input validation; assumes input is valid per requirements.\"\"\"\n    return True\n\ndef _calculate_sum_of_products(n: int) -> int:\n    \"\"\"Calculates the sum of products of consecutive binomial coefficients.\"\"\"\n    total_sum = 0\n    for k in range(n):\n        product = _calculate_binomial_coefficient(n, k) * _calculate_binomial_coefficient(n, k + 1)\n        total_sum += product\n    return total_sum\n\ndef sum_Of_product(n: int) -> int:\n    \"\"\"\n    Calculates the sum of the product of consecutive binomial coefficients.\n    For n, it computes sum from k=0 to n-1 of [C(n,k) * C(n,k+1)].\n    \"\"\"\n    _validate_input(n)\n    return _calculate_sum_of_products(n)"}
