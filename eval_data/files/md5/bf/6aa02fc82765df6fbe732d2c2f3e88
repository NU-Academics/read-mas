{"task_id": "Mbpp/722", "solution": "def filter_data(students_dict, min_height, min_weight):\n    \"\"\"\n    Filters students from a dictionary based on minimum height and weight criteria.\n    Returns a new dictionary containing only the students who meet both criteria.\n    \"\"\"\n    filtered_students = {}\n    for name, (height, weight) in students_dict.items():\n        if height >= min_height and weight >= min_weight:\n            filtered_students[name] = (height, weight)\n    return filtered_students"}
{"task_id": "Mbpp/643", "solution": "def text_match_wordz_middle(input_string: str) -> bool:\n    \"\"\"\n    Checks if any word in the input string contains 'z' in its middle positions.\n    'z' at the start or end of a word is ignored.\n    \"\"\"\n    def is_alphanumeric(char: str) -> bool:\n        \"\"\"Helper to check if a character is alphanumeric.\"\"\"\n        return '0' <= char <= '9' or 'a' <= char <= 'z' or 'A' <= char <= 'Z'\n\n    def parse_words(text: str) -> list[str]:\n        \"\"\"Extracts words from the input string based on alphanumeric sequences.\"\"\"\n        words = []\n        current_word = []\n        for char in text:\n            if is_alphanumeric(char):\n                current_word.append(char)\n            else:\n                if current_word:\n                    words.append(\"\".join(current_word))\n                    current_word = []\n        if current_word:\n            words.append(\"\".join(current_word))\n        return words\n\n    def check_middle_z(word: str) -> bool:\n        \"\"\"Checks if a word contains 'z' in its middle positions (not first or last).\"\"\"\n        if len(word) < 3:  # A word must have at least 3 characters for a 'middle' position\n            return False\n        for i in range(1, len(word) - 1):\n            if word[i] == 'z' or word[i] == 'Z':\n                return True\n        return False\n\n    words = parse_words(input_string)\n    for word in words:\n        if check_middle_z(word):\n            return True\n    return False"}
