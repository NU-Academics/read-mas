{"task_id": "Mbpp/11", "solution": "def remove_Occ(input_string: str, character: str) -> str:\n    \"\"\"\n    Removes the first and last occurrence of a given character from the string.\n    If the character appears only once, that single occurrence is removed.\n    \"\"\"\n    first_idx = input_string.find(character)\n\n    if first_idx == -1:\n        # Character not found, return original string\n        return input_string\n\n    last_idx = input_string.rfind(character)\n\n    if first_idx == last_idx:\n        # Character appears only once, remove it\n        return input_string[:first_idx] + input_string[first_idx + 1:]\n    else:\n        # Character appears at least twice\n        # Remove the first occurrence\n        temp_string = input_string[:first_idx] + input_string[first_idx + 1:]\n        \n        # Find the last occurrence in the modified string\n        # The index of the original last_idx character will be shifted left by 1\n        # if the first_idx was before last_idx\n        new_last_idx = temp_string.rfind(character)\n        \n        # Remove the (new) last occurrence\n        return temp_string[:new_last_idx] + temp_string[new_last_idx + 1:]"}
{"task_id": "Mbpp/9", "solution": "def _validate_input(s: str) -> bool:\n    \"\"\"Helper function to validate input string for processing.\"\"\"\n    return len(s) > 0\n\ndef _find_string_period(s: str) -> int:\n    \"\"\"Helper function to find the smallest period (length of the repeating unit) of a string.\"\"\"\n    n = len(s)\n    for k in range(1, n + 1):\n        if n % k == 0:\n            if s == s[0:k] * (n // k):\n                return k\n    return n\n\n\ndef find_Rotations(s: str) -> int:\n    \"\"\"\n    Calculates the minimum number of rotations (greater than 0) required to get the same string.\n    Handles empty strings, single-character strings, and strings with repeating characters.\n    \"\"\"\n    if not _validate_input(s):\n        return 1\n\n    return _find_string_period(s)"}
{"task_id": "Mbpp/4", "solution": "import heapq\n\ndef heap_queue_largest(numbers: list, n: int) -> list:\n    \"\"\"\n    Finds the n largest integers from a list of numbers using a min-heap\n    and returns them in descending order.\n    \"\"\"\n    # Handle edge cases\n    if n <= 0 or not numbers:\n        return []\n    \n    if n >= len(numbers):\n        # If n is greater than or equal to the list length, sort all elements in descending order\n        return sorted(numbers, reverse=True)\n\n    # Initialize a min-heap\n    min_heap = []\n\n    for num in numbers:\n        if len(min_heap) < n:\n            # If the heap size is less than n, push the element onto the heap\n            heapq.heappush(min_heap, num)\n        elif num > min_heap[0]:\n            # If the current number is larger than the smallest element in the heap,\n            # replace the smallest with the current number\n            heapq.heapreplace(min_heap, num)\n    \n    # The min_heap now contains the n largest elements.\n    # Sort them in descending order for the final result.\n    result = sorted(min_heap, reverse=True)\n    return result"}
