{"task_id": "Mbpp/605", "solution": "import math\n\ndef prime_num(n: int) -> bool:\n    \"\"\"\n    Checks if the given integer is a prime number.\n    A prime number is a natural number greater than 1 that has no positive divisors other than 1 and itself.\n    \"\"\"\n    if n <= 1:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n\n    # Check for divisibility from 3 up to the square root of n, skipping even numbers\n    for i in range(3, int(math.sqrt(n)) + 1, 2):\n        if n % i == 0:\n            return False\n    return True"}
{"task_id": "Mbpp/603", "solution": "def get_ludic(limit: int) -> list[int]:\n    \"\"\"\n    Generates all lucid numbers up to a given limit using a sieve method.\n    Includes 1 as the first lucid number.\n    \"\"\"\n    if limit < 1:\n        return []\n\n    # Initialize a list of numbers from 1 up to the limit.\n    # We will remove numbers from this list as per the sieve process.\n    numbers = list(range(1, limit + 1))\n    ludics = []\n\n    idx = 0\n    while idx < len(numbers):\n        ludic_num = numbers[idx]\n        ludics.append(ludic_num)\n\n        if ludic_num == 1:\n            # For 1, we just add it and continue to the next number without sieving.\n            idx += 1\n            continue\n\n        # Sieve out numbers based on the current lucid_num.\n        # Remove every ludic_num-th number *from the current `numbers` list* (not the original sequence).\n        # We need to build a new list because modifying `numbers` in place while iterating can be tricky.\n        next_numbers = []\n        for i, num in enumerate(numbers):\n            # Check if the number is NOT at an index to be removed.\n            # The indices are 1-based for the sieve logic, so (i+1) % ludic_num == 0 means remove.\n            # We want to keep numbers where (i+1) % ludic_num != 0.\n            if (i + 1) % ludic_num != 0:\n                next_numbers.append(num)\n        numbers = next_numbers\n        # After sieving, reset the index to 0 because the list `numbers` has changed.\n        # The next lucid number will be the first element of the new `numbers` list.\n        idx = 0\n\n    return ludics"}
{"task_id": "Mbpp/606", "solution": "import math\n\ndef radian_degree(degrees: float) -> float:\n    \"\"\"Convert degrees to radians using the formula: radians = degrees \u00d7 (\u03c0/180)\"\"\"\n    return degrees * (math.pi / 180)"}
{"task_id": "Mbpp/610", "solution": "def remove_kth_element(input_list, k):\n    \"\"\"\n    Returns a new list with the k-th element removed, preserving order.\n    k is a zero-based index.\n    \"\"\"\n    return input_list[:k] + input_list[k+1:]"}
{"task_id": "Mbpp/608", "solution": "def bell_Number(n: int) -> int:\n    \"\"\"\n    Calculate the nth Bell number using the Bell triangle method.\n    The Bell number counts the number of partitions of a set of n elements.\n    \"\"\"\n    if n == 0:\n        return 1\n\n    # Initialize the first row of the Bell triangle (for B_0)\n    bell_row = [1]\n\n    # Iterate to build subsequent rows up to n\n    for i in range(1, n + 1):\n        # The first element of the new row is the last element of the previous row\n        new_row = [bell_row[-1]]\n        # Calculate subsequent elements using the Bell triangle recurrence\n        for j in range(len(bell_row)):\n            new_row.append(new_row[-1] + bell_row[j])\n        bell_row = new_row\n\n    # The nth Bell number is the first element of the nth row\n    return bell_row[0]"}
{"task_id": "Mbpp/607", "solution": "import re\n\ndef find_literals(string: str, pattern: str) -> tuple[str, int, int] | None:\n    \"\"\"\n    Searches a string for the first occurrence of a regex pattern.\n    Returns the matching substring, its start index, and end index, or None if no match.\n    \"\"\"\n    match = re.search(pattern, string)\n    if match:\n        return match.group(0), match.start(), match.end()\n    return None"}
