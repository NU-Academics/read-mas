{"task_id": "Mbpp/131", "solution": "def reverse_vowels(input_string: str) -> str:\n    \"\"\"\n    Reverses only the vowels of a given string (where y is not a vowel) while preserving case and position.\n    \"\"\"\n\n    def _is_vowel(char: str) -> bool:\n        \"\"\"Determines if a character is a vowel (a, e, i, o, u, case-insensitive, excluding y).\"\"\"\n        return char.lower() in \"aeiou\"\n\n    def _preserve_case(original_char: str, new_char: str) -> str:\n        \"\"\"Applies the original case of a character to a new character.\"\"\"\n        if original_char.isupper():\n            return new_char.upper()\n        return new_char.lower()\n\n    def _extract_vowels(s: str) -> tuple:\n        \"\"\"Extracts vowels and their original positions from a string.\"\"\"\n        vowels_found = []\n        vowel_indices = []\n        for i, char in enumerate(s):\n            if _is_vowel(char):\n                vowels_found.append(char)\n                vowel_indices.append(i)\n        return (vowels_found, vowel_indices)\n\n    char_list = list(input_string)\n    extracted_vowels, vowel_indices = _extract_vowels(input_string)\n    \n    extracted_vowels.reverse()\n\n    reversed_vowel_idx = 0\n    for original_idx in vowel_indices:\n        original_char_at_pos = input_string[original_idx]\n        new_vowel = extracted_vowels[reversed_vowel_idx]\n        \n        case_preserved_vowel = _preserve_case(original_char_at_pos, new_vowel)\n        char_list[original_idx] = case_preserved_vowel\n        \n        reversed_vowel_idx += 1\n\n    return \"\".join(char_list)"}
{"task_id": "Mbpp/135", "solution": "def hexagonal_num(n):\n    \"\"\"\n    Calculate the nth hexagonal number using formula H(n) = n(2n-1)\n\n    Args:\n        n (int): Position in the hexagonal number sequence\n\n    Returns:\n        int: The nth hexagonal number\n    \"\"\"\n    return n * (2 * n - 1)"}
