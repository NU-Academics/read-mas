{"task_id": "Mbpp/286", "solution": "def _kadane(arr: list[int]) -> int:\n    \"\"\"\n    Finds the maximum sum of a contiguous subarray using Kadane's algorithm.\n    Handles arrays with all negative numbers by returning the largest single element.\n    \"\"\"\n    if not arr:\n        return 0\n\n    max_so_far = arr[0]\n    current_max = arr[0]\n\n    for i in range(1, len(arr)):\n        current_max = max(arr[i], current_max + arr[i])\n        max_so_far = max(max_so_far, current_max)\n    return max_so_far\n\ndef max_sub_array_sum_repeated(arr: list[int], length: int, k: int) -> int:\n    \"\"\"\n    Finds the largest sum of a contiguous subarray in an array formed by\n    repeating the given array k times.\n    \"\"\"\n    if length == 0 or k == 0:\n        return 0\n\n    total_sum = sum(arr)\n    max_sum_1_rep = _kadane(arr)\n\n    if k == 1:\n        return max_sum_1_rep\n\n    arr_double = arr + arr\n    max_sum_2_rep = _kadane(arr_double)\n\n    if total_sum <= 0:\n        # If the total sum of the array is non-positive, repeating it more than twice\n        # won't help in increasing the maximum subarray sum if it spans across\n        # multiple full blocks.\n        return max_sum_2_rep\n    else:\n        # If the total sum is positive, and k > 2, we can extend the maximum sum\n        # by adding (k - 2) full copies of the array.\n        return max_sum_2_rep + (k - 2) * total_sum"}
{"task_id": "Mbpp/300", "solution": "import math\n\ndef count_binary_seq(n: int) -> float:\n    \"\"\"\n    Counts binary sequences of length 2n where the sum of the first n bits equals the sum of the last n bits.\n    This implementation uses a combinatorial approach based on Lucas's Theorem for central binomial coefficients.\n    \"\"\"\n    total_count = 0.0\n    # Iterate through all possible sums (k) for the first n bits.\n    # The sum k can range from 0 to n.\n    for k in range(n + 1):\n        # Calculate the number of ways to choose k bits from n bits (nCk).\n        # This is (n choose k)^2, as both halves must sum to k.\n        # math.comb(n, k) calculates \"n choose k\".\n        nCk = math.comb(n, k)\n        total_count += nCk * nCk\n    return float(total_count)"}
{"task_id": "Mbpp/305", "solution": "def start_withp(word_list: list[str]) -> tuple[str, str]:\n    \"\"\"\n    Extract first two words starting with 'p' from a list of word strings.\n    \"\"\"\n    p_words = []\n    for s in word_list:\n        words_in_string = s.split(' ')\n        for word in words_in_string:\n            if word.startswith('p') or word.startswith('P'):\n                p_words.append(word)\n            if len(p_words) == 2:\n                return (p_words[0], p_words[1])\n    # The assert in the problem description implies we will always find two words.\n    # No explicit error handling for fewer than two words is requested in the design context."}
