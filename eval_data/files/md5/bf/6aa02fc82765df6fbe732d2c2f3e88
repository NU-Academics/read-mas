{"task_id": "Mbpp/454", "solution": "import re\nfrom typing import List\n\ndef extract_words(input_string: str) -> List[str]:\n    \"\"\"\n    Extract words from string using punctuation as separators.\n    It splits the string by any non-word characters and filters out empty results.\n    \"\"\"\n    words = re.split(r'\\W+', input_string)\n    return [word for word in words if word]\n\ndef contains_z(word: str) -> bool:\n    \"\"\"\n    Check if a word contains the lowercase character 'z'.\n    Performs case-sensitive matching for 'z'.\n    \"\"\"\n    return 'z' in word\n\ndef text_match_wordz(input_string: str) -> bool:\n    \"\"\"\n    Check if any word in the input string contains the character 'z'.\n    It extracts words and then checks each for 'z'.\n    \"\"\"\n    words = extract_words(input_string)\n    for word in words:\n        if contains_z(word):\n            return True\n    return False"}
{"task_id": "Mbpp/457", "solution": "def Find_Min(input_list: list[list]) -> list:\n    \"\"\"Finds the sublist with the minimum length from a list of sublists, returning the first one encountered in case of ties.\"\"\"\n\n    # Initialize with the first sublist, assuming input_list is non-empty as per problem context.\n    min_sublist = input_list[0]\n    min_length = len(input_list[0])\n\n    # Iterate through the rest of the sublists to find the one with the minimum length.\n    for i in range(1, len(input_list)):\n        current_sublist = input_list[i]\n        current_length = len(current_sublist)\n\n        # Update if a shorter sublist is found. This naturally handles tie-breaking by keeping the first occurrence.\n        if current_length < min_length:\n            min_length = current_length\n            min_sublist = current_sublist\n            \n    return min_sublist"}
