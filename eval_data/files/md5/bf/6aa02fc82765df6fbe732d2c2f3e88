{"task_id": "Mbpp/99", "solution": "def _convert_to_binary(number: int) -> str:\n    \"\"\"Convert a non-negative integer to its raw binary string representation.\"\"\"\n    # Python's bin() function returns a string prefixed with '0b'.\n    # We slice it off. This correctly handles 0 as well (bin(0) is '0b0').\n    return bin(number)[2:]\n\ndef _remove_leading_zeros(binary_string: str) -> str:\n    \"\"\"Remove leading zeros from a binary string, preserving '0' for the number zero.\"\"\"\n    # The idiom `s.lstrip('0') or '0'` correctly handles cases like '00101' -> '101'\n    # and '0' -> '0' (since '0'.lstrip('0') is '', and '' or '0' is '0').\n    return binary_string.lstrip('0') or '0'\n\ndef decimal_to_binary(decimal_number: int) -> str:\n    \"\"\"Convert the given decimal number to its binary equivalent, represented as a string with no leading zeros.\"\"\"\n    # Per design context and constraints, we assume decimal_number is a valid integer.\n    # No explicit input validation (e.g., isinstance checks) or error raising is performed.\n\n    raw_binary_representation = _convert_to_binary(decimal_number)\n    final_binary_string = _remove_leading_zeros(raw_binary_representation)\n    \n    return final_binary_string"}
{"task_id": "Mbpp/100", "solution": "def reverse_digits(n: int) -> int:\n    \"\"\"Reverse the digits of a number.\"\"\"\n    s = str(n)\n    reversed_s = s[::-1]\n    return int(reversed_s)\n\ndef is_palindrome(n: int) -> bool:\n    \"\"\"Check if a number is a palindrome.\"\"\"\n    return n == reverse_digits(n)\n\ndef next_smallest_palindrome(n: int) -> int:\n    \"\"\"\n    Find the next smallest palindrome greater than the given integer.\n\n    Args:\n        n: Input integer\n\n    Returns:\n        Next smallest palindrome as integer\n    \"\"\"\n    candidate = n + 1\n    while True:\n        if is_palindrome(candidate):\n            return candidate\n        candidate += 1"}
