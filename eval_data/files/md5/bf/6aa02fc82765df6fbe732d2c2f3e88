{"task_id": "Mbpp/61", "solution": "from typing import List\n\ndef _generate_substrings(s: str) -> List[str]:\n    \"\"\"Generates all possible contiguous substrings of the input string.\"\"\"\n    substrings = []\n    n = len(s)\n    for i in range(n):\n        for j in range(i, n):\n            substrings.append(s[i:j+1])\n    return substrings\n\ndef _calculate_digit_sum(substring: str) -> int:\n    \"\"\"Calculates the sum of digits in a given digit substring.\"\"\"\n    digit_sum = 0\n    for char_digit in substring:\n        digit_sum += int(char_digit)\n    return digit_sum\n\ndef _is_valid_substring(substring: str) -> bool:\n    \"\"\"Checks if the digit sum of a substring equals its length.\"\"\"\n    return _calculate_digit_sum(substring) == len(substring)\n\ndef count_Substrings(s: str) -> int:\n    \"\"\"\n    Counts the number of substrings where the sum of digits equals their length.\n    \"\"\"\n    valid_substring_count = 0\n    all_substrings = _generate_substrings(s)\n\n    for substring in all_substrings:\n        if _is_valid_substring(substring):\n            valid_substring_count += 1\n            \n    return valid_substring_count"}
{"task_id": "Mbpp/67", "solution": "_stirling_cache = {}\n\ndef stirling_second_kind(n: int, k: int) -> int:\n    \"\"\"Calculates Stirling numbers of the second kind S(n,k) using memoization.\n    It returns the count of ways to partition a set of n elements into k non-empty subsets.\"\"\"\n    if k < 0 or k > n:\n        return 0\n    if k == 0:\n        return 1 if n == 0 else 0\n    if k == n:\n        return 1\n\n    if (n, k) in _stirling_cache:\n        return _stirling_cache[(n, k)]\n\n    # Recurrence relation: S(n, k) = k * S(n-1, k) + S(n-1, k-1)\n    result = k * stirling_second_kind(n - 1, k) + stirling_second_kind(n - 1, k - 1)\n    _stirling_cache[(n, k)] = result\n    return result\n\ndef handle_base_cases(n: int) -> int | None:\n    \"\"\"Handles base cases for Bell numbers, returning 1 for n=0 or n=1.\"\"\"\n    if n == 0 or n == 1:\n        return 1\n    return None\n\ndef compute_bell_number(n: int) -> int:\n    \"\"\"Core Bell number computation logic using Stirling numbers of the second kind.\"\"\"\n    base_case_result = handle_base_cases(n)\n    if base_case_result is not None:\n        return base_case_result\n\n    # B(n) = sum_{k=0 to n} S(n, k)\n    total_stirling_sum = 0\n    for k in range(n + 1):\n        total_stirling_sum += stirling_second_kind(n, k)\n    return total_stirling_sum\n\ndef bell_number(n: int) -> int:\n    \"\"\"Calculates the Bell number B(n), representing the number of ways to partition a set of n elements.\n    It assumes n is a non-negative integer and delegates computation.\"\"\"\n    return compute_bell_number(n)"}
