{"task_id": "Mbpp/3", "solution": "def is_not_prime(number: int) -> bool:\n    \"\"\"\n    Identifies whether a given integer is a non-prime number.\n    Returns True if non-prime, False if prime.\n    \"\"\"\n    if number < 2:\n        return True  # Numbers less than 2 are not prime (and thus non-prime for 0, 1, negatives)\n    for i in range(2, int(number**0.5) + 1):\n        if number % i == 0:\n            return True  # Found a divisor, so it's non-prime\n    return False  # No divisors found, it's prime"}
{"task_id": "Mbpp/6", "solution": "def _calculate_xor(num1: int, num2: int) -> int:\n    \"\"\"Calculates the bitwise XOR of two integers.\"\"\"\n    return num1 ^ num2\n\ndef _count_set_bits(n: int) -> int:\n    \"\"\"Counts the number of set bits (1s) in an integer using Brian Kernighan's algorithm.\"\"\"\n    count = 0\n    while n > 0:\n        n &= (n - 1)\n        count += 1\n    return count\n\ndef differ_At_One_Bit_Pos(num1: int, num2: int) -> bool:\n    \"\"\"\n    Checks whether two numbers differ at exactly one bit position.\n    It returns True if they do, False otherwise.\n    \"\"\"\n    xor_result = _calculate_xor(num1, num2)\n    bit_count = _count_set_bits(xor_result)\n    return bit_count == 1"}
