{"task_id": "Mbpp/142", "solution": "def count_samepair(list1, list2, list3):\n    \"\"\"\n    Counts the number of items that are identical in the same position of three given lists.\n    The comparison is limited to the length of the shortest list.\n    \"\"\"\n    min_length = min(len(list1), len(list2), len(list3))\n    count = 0\n    for i in range(min_length):\n        if list1[i] == list2[i] == list3[i]:\n            count += 1\n    return count"}
{"task_id": "Mbpp/162", "solution": "def sum_series(n: int) -> int:\n    \"\"\"\n    Calculates the sum of the series (n - 2*i) for i from 0 up to n // 2,\n    stopping when the term becomes less than or equal to 0.\n    \"\"\"\n    total_sum = 0\n    i = 0\n    # Iterate while the term (n - 2*i) is positive\n    while True:\n        term = n - 2 * i\n        if term <= 0:\n            break\n        total_sum += term\n        i += 1\n    return total_sum"}
{"task_id": "Mbpp/165", "solution": "def count_char_position(input_string: str) -> int:\n    \"\"\"\n    Counts characters in a string that match their 0-indexed position in the English alphabet (case-insensitive).\n    'a' is at position 0, 'b' at 1, etc.\n    \"\"\"\n    def normalize_character(char: str) -> str:\n        \"\"\"Converts a character to lowercase.\"\"\"\n        return char.lower()\n\n    def get_alphabet_char(position: int) -> str:\n        \"\"\"Returns the alphabet character at the given 0-indexed position.\"\"\"\n        if 0 <= position < 26:\n            return chr(ord('a') + position)\n        return '' # Return empty string for out-of-bounds positions\n\n    def is_alphabetic(char: str) -> bool:\n        \"\"\"Checks if a character is an English alphabet letter.\"\"\"\n        return 'a' <= char <= 'z'\n\n    match_count = 0\n    for i, char in enumerate(input_string):\n        normalized_char = normalize_character(char)\n        if is_alphabetic(normalized_char):\n            expected_char_at_pos = get_alphabet_char(i)\n            if normalized_char == expected_char_at_pos:\n                match_count += 1\n    return match_count"}
