{"task_id": "Mbpp/804", "solution": "from typing import List\n\ndef is_product_even(numbers: List[int]) -> bool:\n    \"\"\"\n    Checks if the product of numbers in a list is even.\n    Returns True if the product is even, False otherwise.\n    \"\"\"\n    if not numbers:\n        # An empty list's product is considered False as per design context.\n        return False\n\n    # The product is even if any number in the list is even, or if any number is zero.\n    # If a zero is present, the product is zero, which is even.\n    # If an even number is present, the product will be even.\n    for num in numbers:\n        if num == 0:\n            return True # Product will be 0, which is even\n        if num % 2 == 0:\n            return True # Found an even factor, product will be even\n\n    # If the loop finishes, all numbers are odd and non-zero, so their product is odd.\n    return False"}
{"task_id": "Mbpp/805", "solution": "from typing import List\n\ndef max_sum_list(input_lists: List[List[int]]) -> List[int]:\n    \"\"\"\n    Returns the list in a list of lists whose sum of elements is the highest.\n    In case of a tie, the first list encountered with the maximum sum is returned.\n    \"\"\"\n    if not input_lists:\n        return []\n\n    return max(input_lists, key=sum)"}
