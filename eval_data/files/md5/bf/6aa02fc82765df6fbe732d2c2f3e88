{"task_id": "Mbpp/791", "solution": "def remove_nested(input_tuple: tuple) -> tuple:\n    \"\"\"\n    Filters nested tuple elements from the given input tuple, preserving order of non-tuple elements.\n    It iterates through the elements and includes only those that are not tuples in the result.\n    \"\"\"\n    result = []\n    for element in input_tuple:\n        if not isinstance(element, tuple):\n            result.append(element)\n    return tuple(result)"}
{"task_id": "Mbpp/786", "solution": "def right_insertion(sorted_array: list, target_value: int) -> int:\n    \"\"\"\n    Locates the rightmost insertion point for a specified value in a sorted array.\n    This implementation uses an iterative binary search algorithm.\n    \"\"\"\n    left = 0\n    right = len(sorted_array)\n\n    while left < right:\n        mid = left + (right - left) // 2\n        if sorted_array[mid] <= target_value:\n            left = mid + 1\n        else:\n            right = mid\n    return left"}
{"task_id": "Mbpp/793", "solution": "def last(array, target):\n    \"\"\"\n    Finds the last position of an element in a sorted array using binary search.\n    Returns the index of the last occurrence, or -1 if the element is not found.\n    \"\"\"\n    low = 0\n    high = len(array) - 1\n    result = -1\n\n    while low <= high:\n        mid = low + (high - low) // 2\n        if array[mid] == target:\n            result = mid  # Found a potential last occurrence\n            low = mid + 1 # Search for a further occurrence in the right half\n        elif array[mid] < target:\n            low = mid + 1\n        else: # array[mid] > target\n            high = mid - 1\n            \n    return result"}
