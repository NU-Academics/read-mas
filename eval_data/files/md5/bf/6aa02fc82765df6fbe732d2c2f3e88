{"task_id": "Mbpp/635", "solution": "def heap_sort(arr: list) -> list:\n    \"\"\"\n    Sorts a list in ascending order using the heap sort algorithm.\n    This implementation achieves O(n log n) time complexity and O(1) space complexity (in-place).\n    \"\"\"\n    n = len(arr)\n\n    # Build a max heap.\n    # The heapify operation is applied to all non-leaf nodes, starting from the last non-leaf node up to the root.\n    for i in range(n // 2 - 1, -1, -1):\n        heapify(arr, n, i)\n\n    # Extract elements one by one from the heap.\n    # In each iteration, the largest element (root) is swapped with the last element of the heap,\n    # and then heapify is called on the reduced heap.\n    for i in range(n - 1, 0, -1):\n        arr[i], arr[0] = arr[0], arr[i]  # Swap root with current last element\n        heapify(arr, i, 0) # Call max heapify on the reduced heap\n\n    return arr\n\ndef heapify(arr: list, n: int, i: int) -> None:\n    \"\"\"\n    Maintains the max heap property for a subtree rooted at index i.\n    n is the size of the heap.\n    \"\"\"\n    largest = i  # Initialize largest as root\n    left = 2 * i + 1  # Left child\n    right = 2 * i + 2  # Right child\n\n    # If left child is larger than root\n    if left < n and arr[left] > arr[largest]:\n        largest = left\n\n    # If right child is larger than largest so far\n    if right < n and arr[right] > arr[largest]:\n        largest = right\n\n    # If largest is not root\n    if largest != i:\n        arr[i], arr[largest] = arr[largest], arr[i]  # Swap\n        heapify(arr, n, largest)  # Recursively heapify the affected sub-tree"}
{"task_id": "Mbpp/638", "solution": "import math\n\ndef wind_chill(velocity: float, temperature: float) -> int:\n    \"\"\"\n    Calculates the wind chill index given wind velocity in km/h and temperature in Celsius.\n    The result is rounded up to the next integer.\n    \"\"\"\n    # Convert velocity from km/h to m/s for the formula\n    velocity_mps = velocity * 1000 / 3600\n    \n    # Wind chill formula (standard for Celsius and m/s)\n    # This formula is specifically for calculating wind chill in Celsius when velocity is in m/s\n    # Source for formula: https://www.weather.gov/epz/windchill\n    # The formula commonly used with m/s is Twc = 13.12 + 0.6215*T - 11.37*V^0.16 + 0.3965*T*V^0.16\n    # Where T is in Celsius and V is in m/s.\n    # However, the problem context and assert example (120,35)==40 suggest a different formula\n    # Let's re-evaluate based on common formulas and the given assert example.\n    # The assert example wind_chill(120,35)==40 implies a formula that yields approximately 39.7.\n    # A commonly cited formula (Canadian/US adapted for metric) is:\n    # WC = 13.12 + 0.6215*T - 11.37*(V^0.16) + 0.3965*T*(V^0.16)\n    # Where T is Celsius and V is wind speed in km/h. Let's use this one to match the assert.\n\n    if temperature > 10: # Wind chill is not defined for temperatures above 10\u00b0C\n        return int(math.ceil(temperature)) # Or simply return temperature rounded up\n        \n    # Using the adapted Canadian/US wind chill formula where V is in km/h and T is in Celsius.\n    wind_chill_c = 13.12 + (0.6215 * temperature) - (11.37 * (velocity**0.16)) + (0.3965 * temperature * (velocity**0.16))\n\n    return int(math.ceil(wind_chill_c))"}
{"task_id": "Mbpp/639", "solution": "def sample_nam(names: list) -> int:\n    \"\"\"\n    Calculates the sum of lengths of names that start with an uppercase letter.\n    Names starting with a lowercase letter are ignored.\n    \"\"\"\n    total_length = 0\n    for name in names:\n        if name and name[0].isupper():\n            total_length += len(name)\n    return total_length"}
{"task_id": "Mbpp/644", "solution": "def reverse_Array_Upto_K(array, position):\n    \"\"\"\n    Reverses elements in an array from the beginning up to a specified position K.\n    Elements beyond position K remain in their original order.\n    \"\"\"\n    first_k_elements = array[:position]\n    remaining_elements = array[position:]\n    \n    reversed_first_k = first_k_elements[::-1]\n    \n    return reversed_first_k + remaining_elements"}
