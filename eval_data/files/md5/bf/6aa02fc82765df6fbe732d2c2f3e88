{"task_id": "Mbpp/618", "solution": "def div_list(list1: list, list2: list) -> list:\n    \"\"\"\n    Divides two lists element-wise, returning results as floats.\n    Assumes lists are of equal length and contain numeric elements, without explicit validation checks.\n    \"\"\"\n    # Performs element-wise division using zip to pair elements.\n    # Python's division operator '/' inherently produces floating-point numbers.\n    result_list = [num1 / num2 for num1, num2 in zip(list1, list2)]\n\n    return result_list"}
{"task_id": "Mbpp/619", "solution": "def move_num(input_string: str) -> str:\n    \"\"\"\n    Moves all numeric characters to the end of the given string,\n    preserving the relative order of non-numeric and numeric characters.\n    \"\"\"\n    non_numeric_chars = []\n    numeric_chars = []\n\n    for char in input_string:\n        if char.isdigit():\n            numeric_chars.append(char)\n        else:\n            non_numeric_chars.append(char)\n\n    return \"\".join(non_numeric_chars) + \"\".join(numeric_chars)"}
{"task_id": "Mbpp/622", "solution": "def get_median(list1, list2, size):\n    \"\"\"\n    Finds the median of two sorted lists of the same size.\n    It merges the lists and then calculates the median from the combined sorted list.\n    \"\"\"\n    i = 0\n    j = 0\n    merged_list = []\n\n    # Merge the two sorted lists using a two-pointer approach\n    while i < size and j < size:\n        if list1[i] <= list2[j]:\n            merged_list.append(list1[i])\n            i += 1\n        else:\n            merged_list.append(list2[j])\n            j += 1\n\n    # Append any remaining elements from list1\n    while i < size:\n        merged_list.append(list1[i])\n        i += 1\n\n    # Append any remaining elements from list2\n    while j < size:\n        merged_list.append(list2[j])\n        j += 1\n\n    # The total number of elements in merged_list is 2 * size.\n    # For an even number of elements, the median is the average of the two middle elements.\n    # These elements are at indices `size - 1` and `size`.\n    median_val = (merged_list[size - 1] + merged_list[size]) / 2.0\n\n    return median_val"}
{"task_id": "Mbpp/626", "solution": "def triangle_area(radius: float) -> float | None:\n    \"\"\"\n    Calculate the area of the largest triangle inscribed in a semicircle.\n    Returns None if the radius is negative.\n    \"\"\"\n    if radius < 0:\n        return None\n    return radius * radius"}
{"task_id": "Mbpp/620", "solution": "import itertools\n\ndef _is_divisible(a: int, b: int) -> bool:\n    \"\"\"\n    Checks if one integer divides the other. Handles zero values.\n    \"\"\"\n    if a == 0 and b == 0:\n        return True\n    if a == 0 or b == 0:\n        return False\n    return (a % b == 0) or (b % a == 0)\n\ndef _forms_valid_pair(num1: int, num2: int) -> bool:\n    \"\"\"\n    Wrapper for divisibility check between two numbers.\n    \"\"\"\n    return _is_divisible(num1, num2)\n\ndef _validate_subset(subset: list[int]) -> bool:\n    \"\"\"\n    Checks if every pair in the subset satisfies the divisibility condition.\n    \"\"\"\n    if len(subset) <= 1:\n        return True\n    for num1, num2 in itertools.combinations(subset, 2):\n        if not _forms_valid_pair(num1, num2):\n            return False\n    return True\n\ndef _generate_subsets(numbers: list[int]): # -> Iterator[list[int]]\n    \"\"\"\n    Generates all possible subsets of the input list.\n    \"\"\"\n    for i in range(len(numbers) + 1):\n        for combo in itertools.combinations(numbers, i):\n            yield list(combo)\n\ndef largest_subset(numbers: list[int]) -> int:\n    \"\"\"\n    Finds the size of the largest subset where every pair of numbers is divisible.\n    \"\"\"\n    max_size = 0\n    for subset in _generate_subsets(numbers):\n        if _validate_subset(subset):\n            max_size = max(max_size, len(subset))\n    return max_size"}
