{"task_id": "Mbpp/223", "solution": "def is_majority(array: list[int], n: int, element: int) -> bool:\n    \"\"\"\n    Checks if an element is the majority element in a sorted array.\n    A majority element occurs more than n/2 times.\n    \"\"\"\n\n    def handle_empty_array(current_n: int) -> bool:\n        \"\"\"Returns True if the array is empty, otherwise False.\"\"\"\n        return current_n == 0\n\n    def handle_single_element(current_array: list[int], target_element: int) -> bool:\n        \"\"\"Checks if the target element is the single element in the array.\"\"\"\n        return current_array[0] == target_element\n\n    def find_first_occurrence(current_array: list[int], target_element: int) -> int:\n        \"\"\"Finds the index of the first occurrence of the target element using binary search.\"\"\"\n        low, high = 0, len(current_array) - 1\n        result = -1\n        while low <= high:\n            mid = low + (high - low) // 2\n            if current_array[mid] == target_element:\n                result = mid\n                high = mid - 1  # Search in the left half for an earlier occurrence\n            elif current_array[mid] < target_element:\n                low = mid + 1\n            else:\n                high = mid - 1\n        return result\n\n    def find_last_occurrence(current_array: list[int], target_element: int) -> int:\n        \"\"\"Finds the index of the last occurrence of the target element using binary search.\"\"\"\n        low, high = 0, len(current_array) - 1\n        result = -1\n        while low <= high:\n            mid = low + (high - low) // 2\n            if current_array[mid] == target_element:\n                result = mid\n                low = mid + 1  # Search in the right half for a later occurrence\n            elif current_array[mid] < target_element:\n                low = mid + 1\n            else:\n                high = mid - 1\n        return result\n\n    def calculate_majority_threshold(current_n: int) -> float:\n        \"\"\"Calculates the threshold for an element to be a majority element.\"\"\"\n        return current_n / 2.0\n\n    # Handle edge cases for array length\n    if handle_empty_array(n):\n        return False\n    \n    if n == 1: # Specifically check single-element array after empty array\n        return handle_single_element(array, element)\n\n    # Find first and last occurrences of the element\n    first_idx = find_first_occurrence(array, element)\n\n    # If the element is not found, it cannot be a majority element\n    if first_idx == -1:\n        return False\n\n    last_idx = find_last_occurrence(array, element)\n\n    # Calculate the total count of the element\n    occurrence_count = last_idx - first_idx + 1\n\n    # Calculate the majority threshold\n    majority_threshold = calculate_majority_threshold(n)\n\n    # Compare the occurrence count with the majority threshold\n    return occurrence_count > majority_threshold"}
