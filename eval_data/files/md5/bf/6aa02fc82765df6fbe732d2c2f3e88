{"task_id": "Mbpp/125", "solution": "def find_length(s: str) -> int:\n    \"\"\"\n    Finds the maximum difference between the number of 0s and 1s\n    in any substring of the given binary string.\n    \"\"\"\n\n    def kadane(arr):\n        max_so_far = 0\n        current_max = 0\n        for x in arr:\n            current_max += x\n            if current_max < 0:\n                current_max = 0\n            max_so_far = max(max_so_far, current_max)\n        return max_so_far\n\n    if not s:\n        return 0\n\n    # Calculate max(count_0 - count_1) by mapping '0' to 1 and '1' to -1\n    transformed_s1 = []\n    for char in s:\n        if char == '0':\n            transformed_s1.append(1)\n        else: # char == '1'\n            transformed_s1.append(-1)\n    \n    max_diff_0_minus_1 = kadane(transformed_s1)\n\n    # Calculate max(count_1 - count_0) by mapping '1' to 1 and '0' to -1\n    transformed_s2 = []\n    for char in s:\n        if char == '0':\n            transformed_s2.append(-1)\n        else: # char == '1'\n            transformed_s2.append(1)\n    \n    max_diff_1_minus_0 = kadane(transformed_s2)\n\n    # The maximum absolute difference is the greater of these two maximums\n    return max(max_diff_0_minus_1, max_diff_1_minus_0)"}
{"task_id": "Mbpp/129", "solution": "from typing import List\n\ndef magic_square_test(matrix: List[List[int]]) -> bool:\n    \"\"\"\n    Determines if a given 2D matrix is a magic square.\n    A magic square is a square matrix where all row, column, and diagonal sums are equal.\n    \"\"\"\n\n    def _is_square(matrix: List[List[int]]) -> bool:\n        \"\"\"Validates that the matrix has equal rows and columns.\"\"\"\n        n = len(matrix)\n        if n == 0:\n            return False  # An empty matrix is not a magic square\n        for row in matrix:\n            if len(row) != n:\n                return False\n        return True\n\n    def _calculate_row_sums(matrix: List[List[int]]) -> List[int]:\n        \"\"\"Calculates the sum for each row in the matrix.\"\"\"\n        return [sum(row) for row in matrix]\n\n    def _calculate_column_sums(matrix: List[List[int]]) -> List[int]:\n        \"\"\"Calculates the sum for each column in the matrix.\"\"\"\n        n = len(matrix)\n        col_sums = [0] * n\n        for i in range(n):\n            for j in range(n):\n                col_sums[j] += matrix[i][j]\n        return col_sums\n\n    def _calculate_main_diagonal_sum(matrix: List[List[int]]) -> int:\n        \"\"\"Calculates the sum of the main diagonal (top-left to bottom-right).\"\"\"\n        n = len(matrix)\n        main_diag_sum = 0\n        for i in range(n):\n            main_diag_sum += matrix[i][i]\n        return main_diag_sum\n\n    def _calculate_anti_diagonal_sum(matrix: List[List[int]]) -> int:\n        \"\"\"Calculates the sum of the anti-diagonal (top-right to bottom-left).\"\"\"\n        n = len(matrix)\n        anti_diag_sum = 0\n        for i in range(n):\n            anti_diag_sum += matrix[i][n - 1 - i]\n        return anti_diag_sum\n\n    def _all_sums_equal(row_sums: List[int], col_sums: List[int], main_diag: int, anti_diag: int) -> bool:\n        \"\"\"Compares all calculated sums for equality.\"\"\"\n        if not row_sums: # Handle case of 1x1 matrix or empty matrix if _is_square allowed it.\n                        # For 1x1, row_sums[0] will exist and be the target.\n            return False\n        \n        target_sum = row_sums[0]\n        \n        # Check all row sums\n        if not all(s == target_sum for s in row_sums):\n            return False\n        \n        # Check all column sums\n        if not all(s == target_sum for s in col_sums):\n            return False\n        \n        # Check main and anti-diagonal sums\n        if main_diag != target_sum or anti_diag != target_sum:\n            return False\n            \n        return True\n\n    if not _is_square(matrix):\n        return False\n\n    if len(matrix) == 1: # Special case for 1x1 matrix where all sums are the single element\n        return True\n\n    row_sums = _calculate_row_sums(matrix)\n    col_sums = _calculate_column_sums(matrix)\n    main_diag_sum = _calculate_main_diagonal_sum(matrix)\n    anti_diag_sum = _calculate_anti_diagonal_sum(matrix)\n\n    return _all_sums_equal(row_sums, col_sums, main_diag_sum, anti_diag_sum)"}
{"task_id": "Mbpp/130", "solution": "from typing import List, Dict\n\ndef max_occurrences(input_list: List[int]) -> int:\n    \"\"\"\n    Finds the item with maximum frequency in a given list.\n    Helper functions are used for clarity and separation of concerns.\n    \"\"\"\n\n    def _count_frequencies(items: List[int]) -> Dict[int, int]:\n        \"\"\"Counts the frequency of each item in the input list.\"\"\"\n        frequency_map = {}\n        for item in items:\n            frequency_map[item] = frequency_map.get(item, 0) + 1\n        return frequency_map\n\n    def _find_max_frequency_item(frequency_map: Dict[int, int]) -> int:\n        \"\"\"Finds the item with the maximum frequency from a frequency map.\"\"\"\n        max_item = None\n        max_freq = -1 \n        for item, freq in frequency_map.items():\n            if freq > max_freq:\n                max_freq = freq\n                max_item = item\n        return max_item\n\n    frequency_map = _count_frequencies(input_list)\n    result_item = _find_max_frequency_item(frequency_map)\n    return result_item"}
