{"task_id": "Mbpp/569", "solution": "import collections\ndef sort_sublists(input_list):\n    \"\"\"\n    Sorts each sublist of strings in a given list of lists alphabetically.\n    Returns a new list of lists with sorted sublists, without modifying the original.\n    \"\"\"\n    sorted_outer_list = []\n    for sublist in input_list:\n        # Create a sorted copy of the current sublist and append it to the result\n        sorted_outer_list.append(sorted(sublist))\n    return sorted_outer_list"}
{"task_id": "Mbpp/572", "solution": "def _count_occurrences(numbers: list) -> dict:\n    \"\"\"Counts the occurrences of each number in a list.\"\"\"\n    counts = {}\n    for number in numbers:\n        counts[number] = counts.get(number, 0) + 1\n    return counts\n\ndef _filter_unique(numbers: list, counts: dict) -> list:\n    \"\"\"Filters numbers that appear exactly once, preserving original order.\"\"\"\n    unique_nums = []\n    for number in numbers:\n        if counts[number] == 1:\n            unique_nums.append(number)\n    return unique_nums\n\ndef two_unique_nums(input_list: list) -> list:\n    \"\"\"\n    Removes duplicate numbers from a list, returning only numbers that appear exactly once.\n    The original order of unique numbers is preserved.\n    \"\"\"\n    counts = _count_occurrences(input_list)\n    unique_elements = _filter_unique(input_list, counts)\n    return unique_elements"}
{"task_id": "Mbpp/573", "solution": "def unique_product(input_list):\n    \"\"\"\n    Calculates the product of the unique numbers in a given list.\n    Duplicates are removed before the product is computed.\n    \"\"\"\n    unique_numbers = set(input_list)\n    product = 1\n    for number in unique_numbers:\n        product *= number\n    return product"}
{"task_id": "Mbpp/576", "solution": "def is_Sub_Array(main_list, sub_list):\n    \"\"\"\n    Check if sub_list is a contiguous sublist of main_list.\n\n    Args:\n        main_list (list): The list to search within\n        sub_list (list): The list to search for\n\n    Returns:\n        bool: True if sub_list is contiguous sublist of main_list, False otherwise\n    \"\"\"\n    len_main = len(main_list)\n    len_sub = len(sub_list)\n\n    if len_sub == 0:\n        return True\n    if len_sub > len_main:\n        return False\n\n    for i in range(len_main - len_sub + 1):\n        if main_list[i:i+len_sub] == sub_list:\n            return True\n    return False"}
