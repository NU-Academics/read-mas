{"task_id": "Mbpp/239", "solution": "def get_total_number_of_sequences(m: int, n: int) -> int:\n    \"\"\"\n    Calculates the number of sequences of length n, where each element is a positive integer,\n    greater than or equal to twice the previous element, and less than or equal to m.\n    \"\"\"\n    memo = {} # Stores results for (current_length, last_element_val) to avoid recomputation.\n\n    def _solve(current_length: int, last_element_val: int) -> int:\n        # Base case: A sequence of length n has been successfully formed.\n        if current_length == n:\n            return 1\n\n        # Check memoization table to return previously computed results.\n        if (current_length, last_element_val) in memo:\n            return memo[(current_length, last_element_val)]\n\n        ways = 0\n        # Determine the minimum value for the next element based on sequence rules.\n        # For the first element (current_length = 0), it must be at least 1.\n        # For subsequent elements, it must be at least twice the previous element.\n        start_next_val = 1 if current_length == 0 else 2 * last_element_val\n\n        # Iterate through all possible valid values for the current position in the sequence.\n        for next_val in range(start_next_val, m + 1):\n            ways += _solve(current_length + 1, next_val)\n\n        # Store the computed result in the memoization table before returning.\n        memo[(current_length, last_element_val)] = ways\n        return ways\n\n    # Initiate the recursive process to find all valid sequences.\n    # We start with `current_length = 0` and `last_element_val = 0` (a dummy value,\n    # as the `_solve` function handles the specific `start_next_val = 1` logic for the first element).\n    return _solve(0, 0)"}
{"task_id": "Mbpp/240", "solution": "def replace_list(list1: list, list2: list) -> list:\n    \"\"\"\n    Replaces the last element of list1 with all elements from list2.\n\n    Args:\n        list1: First input list (must contain at least one element).\n        list2: Second input list (elements to append).\n\n    Returns:\n        New list with last element of list1 replaced by elements from list2.\n\n    Raises:\n        ValueError: If list1 is empty.\n    \"\"\"\n    if not list1:\n        raise ValueError(\"list1 must not be empty.\")\n    \n    # Create a new list containing all elements of list1 except the last one,\n    # then append all elements from list2 to it.\n    result_list = list1[:-1] + list2\n    return result_list"}
{"task_id": "Mbpp/244", "solution": "import math\n\ndef next_Perfect_Square(number):\n    \"\"\"\n    Calculates the smallest perfect square greater than the given number.\n    It finds the square root, takes the next integer, and squares it.\n    \"\"\"\n    root = math.sqrt(number)\n    next_integer = math.floor(root) + 1\n    return next_integer * next_integer"}
{"task_id": "Mbpp/245", "solution": "def max_sum(array: list[int]) -> int:\n    \"\"\"\n    Finds the maximum sum of a bitonic subsequence in the given array.\n    A bitonic sequence is first increasing and then decreasing.\n    \"\"\"\n    n = len(array)\n\n    if n == 0:\n        return 0\n    if n == 1:\n        return array[0]\n\n    # Calculate increasing subsequence sums ending at each index\n    # inc_sums[i] stores the maximum sum of an increasing subsequence ending at index i\n    inc_sums = list(array)\n    for i in range(1, n):\n        for j in range(i):\n            if array[i] > array[j]:\n                inc_sums[i] = max(inc_sums[i], inc_sums[j] + array[i])\n\n    # Calculate decreasing subsequence sums starting at each index (from right to left)\n    # dec_sums[i] stores the maximum sum of a decreasing subsequence starting at index i\n    dec_sums = list(array)\n    for i in range(n - 2, -1, -1):\n        for j in range(n - 1, i, -1):\n            if array[i] > array[j]:\n                dec_sums[i] = max(dec_sums[i], dec_sums[j] + array[i])\n\n    # Combine increasing and decreasing sums to find the maximum bitonic sum\n    max_bitonic_sum = 0\n    for i in range(n):\n        # A bitonic subsequence can be purely increasing or purely decreasing (if array length > 1)\n        # Or it can have a peak at 'i' (inc_sums[i] + dec_sums[i] - array[i] to avoid double counting array[i])\n        max_bitonic_sum = max(max_bitonic_sum, inc_sums[i] + dec_sums[i] - array[i])\n    \n    return max_bitonic_sum"}
