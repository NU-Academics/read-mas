{"task_id": "Mbpp/392", "solution": "memo_cache = {}\n\ndef get_max_sum(n: int) -> int:\n    \"\"\"\n    Calculates the maximum sum for a given integer n using the formula\n    f(n) = max((f(n/2) + f(n/3) + f(n/4) + f(n/5)), n) with memoization.\n    \"\"\"\n    if n in memo_cache:\n        return memo_cache[n]\n\n    if n <= 1:\n        memo_cache[n] = n\n        return n\n\n    # Calculate the sum of recursive calls using integer division\n    recursive_sum = (\n        get_max_sum(n // 2) +\n        get_max_sum(n // 3) +\n        get_max_sum(n // 4) +\n        get_max_sum(n // 5)\n    )\n\n    # The result is the maximum of the recursive sum and n itself\n    result = max(recursive_sum, n)\n    memo_cache[n] = result\n    return result"}
{"task_id": "Mbpp/395", "solution": "def _count_characters(input_string: str) -> dict[str, int]:\n    \"\"\"Counts character occurrences in the given string.\"\"\"\n    char_counts = {}\n    for char_val in input_string:\n        char_counts[char_val] = char_counts.get(char_val, 0) + 1\n    return char_counts\n\ndef _find_first_unique(input_string: str, char_counts: dict[str, int]) -> str | None:\n    \"\"\"Finds the first character that appears only once in the string based on counts.\"\"\"\n    for char_val in input_string:\n        if char_counts[char_val] == 1:\n            return char_val\n    return None\n\ndef first_non_repeating_character(input_string: str) -> str | None:\n    \"\"\"Finds the first non-repeated character in a given string.\"\"\"\n    counts = _count_characters(input_string)\n    return _find_first_unique(input_string, counts)"}
