{"task_id": "Mbpp/578", "solution": "def interleave_lists(list1: list, list2: list, list3: list) -> list:\n    \"\"\"Interleaves three lists of the same length into a single flat list.\n    Elements are taken round-robin from list1, list2, and list3.\"\"\"\n    \n    result = []\n    # All lists are guaranteed to be of the same length.\n    length = len(list1) \n\n    for i in range(length):\n        result.append(list1[i])\n        result.append(list2[i])\n        result.append(list3[i])\n            \n    return result"}
{"task_id": "Mbpp/580", "solution": "def extract_even(input_tuple):\n    \"\"\"\n    Removes odd integer elements from nested mixed tuples while preserving structure.\n    \"\"\"\n\n    def _is_even(element):\n        \"\"\"Checks if an element is an even integer.\"\"\"\n        return isinstance(element, int) and element % 2 == 0\n\n    def _process_element(element):\n        \"\"\"Processes an individual element, applying filtering or recursion.\"\"\"\n        if isinstance(element, int):\n            return element if _is_even(element) else None\n        elif isinstance(element, tuple):\n            return _filter_tuple(element)\n        else:\n            return element\n\n    def _filter_tuple(current_tuple):\n        \"\"\"Recursively processes a tuple, building a new one with filtered elements.\"\"\"\n        filtered_elements = []\n        for item in current_tuple:\n            processed_item = _process_element(item)\n            if processed_item is not None:\n                filtered_elements.append(processed_item)\n        return tuple(filtered_elements)\n\n    return _filter_tuple(input_tuple)"}
{"task_id": "Mbpp/579", "solution": "def find_dissimilar(tuple1: tuple, tuple2: tuple) -> tuple:\n    \"\"\"\n    Finds dissimilar elements in two tuples, returning them in a single tuple\n    while preserving their original relative order from tuple1 then tuple2.\n    \"\"\"\n    def _get_unique_elements(t1: tuple, t2: tuple) -> tuple:\n        \"\"\"\n        Identifies elements that exist in one tuple but not the other.\n        Returns these elements as a tuple, without guaranteed order, for further processing.\n        \"\"\"\n        set1 = set(t1)\n        set2 = set(t2)\n        return tuple(set1 ^ set2)\n\n    def _preserve_order(elements_to_order: set, t1: tuple, t2: tuple) -> tuple:\n        \"\"\"\n        Constructs a tuple of elements, preserving the original relative order from t1 then t2.\n        Only includes elements found in elements_to_order, adding each unique value only once.\n        \"\"\"\n        result = []\n        added_elements = set()\n\n        # Iterate through the first tuple to add its unique elements in order\n        for item in t1:\n            if item in elements_to_order and item not in added_elements:\n                result.append(item)\n                added_elements.add(item)\n        \n        # Iterate through the second tuple to add its remaining unique elements in order\n        for item in t2:\n            if item in elements_to_order and item not in added_elements:\n                result.append(item)\n                added_elements.add(item)\n        \n        return tuple(result)\n\n    # Get the set of unique elements (symmetric difference) as a tuple, as per helper signature.\n    unique_elements_as_tuple = _get_unique_elements(tuple1, tuple2)\n    \n    # Convert to a set, as the _preserve_order helper expects a set for efficient lookups.\n    unique_elements_set = set(unique_elements_as_tuple)\n    \n    # Order the unique elements according to their appearance in the original tuples.\n    final_dissimilar_elements = _preserve_order(unique_elements_set, tuple1, tuple2)\n    \n    return final_dissimilar_elements"}
{"task_id": "Mbpp/583", "solution": "def catalan_number(n: int) -> int:\n    \"\"\"\n    Calculates the nth Catalan number using the formula C(n) = (2n)! / ((n+1)! * n!).\n    \"\"\"\n    def _factorial(k: int) -> int:\n        \"\"\"Helper function to calculate factorial of a non-negative integer.\"\"\"\n        if k == 0:\n            return 1\n        res = 1\n        for i in range(1, k + 1):\n            res *= i\n        return res\n\n    numerator = _factorial(2 * n)\n    denominator = _factorial(n + 1) * _factorial(n)\n    return numerator // denominator"}
