{"task_id": "Mbpp/100", "solution": "def next_smallest_palindrome(num: int) -> int:\n    \"\"\"\n    Computes the next smallest palindrome that is strictly greater than the input integer.\n    \"\"\"\n    def is_palindrome(n: int) -> bool:\n        \"\"\"\n        Checks if an integer is a palindrome.\n        A palindrome reads the same forwards and backward.\n        \"\"\"\n        if n < 0:\n            return False\n        s = str(n)\n        return s == s[::-1]\n\n    current_num = num + 1\n    while True:\n        if is_palindrome(current_num):\n            return current_num\n        current_num += 1"}
{"task_id": "Mbpp/104", "solution": "def sort_sublists(input_list_of_lists: list[list[str]]) -> list[list[str]]:\n    \"\"\"\n    Sorts the string elements within each sublist of a given list of lists\n    in ascending alphabetical order.\n    \"\"\"\n    sorted_output_list = []\n    for sublist in input_list_of_lists:\n        sorted_sublist = sorted(sublist)\n        sorted_output_list.append(sorted_sublist)\n    return sorted_output_list"}
{"task_id": "Mbpp/106", "solution": "def add_lists(list_input: list, tuple_input: tuple) -> tuple:\n    \"\"\"Appends elements of a given list to a given tuple, returning a new tuple.\"\"\"\n    # Convert the input tuple to a temporary mutable list to allow extension.\n    temp_list = list(tuple_input)\n    # Extend the temporary list with all elements from the input list.\n    temp_list.extend(list_input)\n    # Convert the combined temporary list back to an immutable tuple and return it.\n    return tuple(temp_list)"}
{"task_id": "Mbpp/102", "solution": "def snake_to_camel(snake_case_string: str) -> str:\n    \"\"\"Converts a snake_case string to CamelCase by splitting, capitalizing, and joining words.\"\"\"\n    words = snake_case_string.split('_')\n    camel_case_words = [word.capitalize() for word in words]\n    return \"\".join(camel_case_words)"}
{"task_id": "Mbpp/103", "solution": "def _calculate_eulerian_recursive(n: int, m: int, memo: dict) -> int:\n    \"\"\"Recursively calculates the Eulerian number a(n, m) using memoization.\"\"\"\n    if (n, m) in memo:\n        return memo[(n, m)]\n\n    # Base case for A(0,0) = 1\n    if n == 0:\n        result = 1 if m == 0 else 0\n    # For n > 0, handle out-of-range m values\n    elif m < 0 or m >= n:\n        result = 0\n    # Standard base cases for n > 0: A(n,0) = 1 and A(n, n-1) = 1\n    elif m == 0 or m == n - 1:\n        result = 1\n    # Recursive step for n > 0, 0 < m < n-1\n    else:\n        result = (m + 1) * _calculate_eulerian_recursive(n - 1, m, memo) + \\\n                 (n - m) * _calculate_eulerian_recursive(n - 1, m - 1, memo)\n\n    memo[(n, m)] = result\n    return result\ndef eulerian_num(n: int, m: int) -> int:\n    \"\"\"Calculates the Eulerian number a(n, m) for given non-negative integers n and m.\"\"\"\n    memo = {}\n    return _calculate_eulerian_recursive(n, m, memo)"}
{"task_id": "Mbpp/105", "solution": "def count(boolean_list: list) -> int:\n    \"\"\"Counts the number of True boolean values in the given list.\n    It iterates through the list and increments a counter for each True element.\"\"\"\n    true_count = 0\n    for item in boolean_list:\n        if item is True:\n            true_count += 1\n    return true_count"}
