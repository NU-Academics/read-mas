{"task_id": "Mbpp/767", "solution": "from typing import List\ndef get_pairs_count(numbers: List[int], target_sum: int) -> int:\n    \"\"\"\n    Counts the number of pairs of distinct elements (by index) in a list\n    whose sum equals the specified target_sum.\n    \"\"\"\n    count = 0\n    n = len(numbers)\n    for i in range(n):\n        for j in range(i + 1, n):\n            if numbers[i] + numbers[j] == target_sum:\n                count += 1\n    return count"}
{"task_id": "Mbpp/765", "solution": "def findNthPoliteNumber(n: int) -> int:\n    \"\"\"\n    Finds the nth polite number. A polite number is a positive integer that is not a power of two.\n    \"\"\"\n    count = 0\n    num = 1\n    while True:\n        # Check if 'num' is a power of two using bitwise operations:\n        # A positive integer x is a power of two if (x & (x - 1)) is 0.\n        if (num & (num - 1)) == 0:\n            # It's a power of two, skip it.\n            pass\n        else:\n            # It's not a power of two, so it's a polite number.\n            count += 1\n            if count == n:\n                return num\n        num += 1"}
{"task_id": "Mbpp/770", "solution": "def odd_num_sum(n):\n    \"\"\"\n    Calculates the sum of the fourth power of the first n odd natural numbers.\n    Assumes n is a non-negative integer.\n    \"\"\"\n    total_sum = 0\n    for i in range(n):\n        odd_number = 2 * i + 1\n        total_sum += odd_number ** 4\n    return total_sum"}
{"task_id": "Mbpp/769", "solution": "def Diff(list1: list, list2: list) -> list:\n    \"\"\"\n    Calculates the difference between two lists, returning elements from list1 not present in list2\n    while preserving their original relative order.\n    \"\"\"\n    result = []\n    # Convert list2 to a set for efficient lookup\n    set2 = set(list2)\n    for item in list1:\n        if item not in set2:\n            result.append(item)\n    return result"}
{"task_id": "Mbpp/771", "solution": "def check_expression(expression_string: str) -> bool:\n    \"\"\"\n    Checks if the given expression has balanced delimiters using a stack.\n    Ignores characters that are not delimiters.\n    \"\"\"\n    _OPENING_DELIMITERS = {'(', '[', '{'}\n    _CLOSING_DELIMITERS = {')', ']', '}'}\n    _DELIMITER_MAP = {')': '(', ']': '[', '}': '{'}\n\n    stack = []\n    for char in expression_string:\n        if char in _OPENING_DELIMITERS:\n            stack.append(char)\n        elif char in _CLOSING_DELIMITERS:\n            if not stack:\n                return False  # Unmatched closing delimiter\n            \n            last_opening = stack.pop()\n            if _DELIMITER_MAP[char] != last_opening:\n                return False  # Mismatched delimiters\n    \n    return not stack # True if stack is empty (all opening delimiters matched)"}
{"task_id": "Mbpp/772", "solution": "def remove_length(text_string: str, k_length: int) -> str:\n    # Splits the string into words, filters out words of length k_length, and joins the remaining words.\n    words = text_string.split(' ')\n    filtered_words = [word for word in words if len(word) != k_length]\n    return ' '.join(filtered_words)"}
{"task_id": "Mbpp/777", "solution": "def find_sum(input_list: list[int | float]) -> int | float:\n    \"\"\"Calculates the sum of non-repeated elements in a given list.\n\n    An element is considered 'non-repeated' if it appears exactly once in the input list.\n    \"\"\"\n    from collections import Counter\n\n    counts = Counter(input_list)\n    total_sum = 0\n    for element, count in counts.items():\n        if count == 1:\n            total_sum += element\n    return total_sum"}
{"task_id": "Mbpp/773", "solution": "def occurance_substring(main_string: str, substring: str) -> tuple[str, int, int] | None:\n    \"\"\"\n    Finds the first occurrence and position of a substring within a main string.\n    Returns (substring, start_index, end_index) if found, otherwise None.\n    \"\"\"\n    start_index = main_string.find(substring)\n    if start_index != -1:\n        end_index = start_index + len(substring)\n        return (substring, start_index, end_index)\n    else:\n        return None"}
{"task_id": "Mbpp/775", "solution": "def odd_position(input_list: list) -> bool:\n    \"\"\"Checks if every number at an odd index in input_list is an odd number.\"\"\"\n\n    def _is_odd(number: int) -> bool:\n        \"\"\"Returns True if the number is odd, False otherwise.\"\"\"\n        return number % 2 != 0\n\n    for index, value in enumerate(input_list):\n        if index % 2 != 0:  # Check if index is odd\n            if not _is_odd(value):  # Check if value at odd index is not odd\n                return False\n    return True"}
{"task_id": "Mbpp/778", "solution": "def pack_consecutive_duplicates(input_list: list) -> list:\n    \"\"\"\n    Packs consecutive duplicates of list elements into sublists.\n    This function iterates through the list, grouping identical consecutive elements.\n    \"\"\"\n    if not input_list:\n        return []\n\n    result_list = []\n    current_sublist = []\n\n    for item in input_list:\n        # If current_sublist is empty or the item is a duplicate of the last element\n        if not current_sublist or item == current_sublist[-1]:\n            current_sublist.append(item)\n        else:\n            # Item is different, so add the completed sublist and start a new one\n            result_list.append(current_sublist)\n            current_sublist = [item]\n\n    # Add the last current_sublist after the loop finishes\n    if current_sublist:\n        result_list.append(current_sublist)\n\n    return result_list"}
{"task_id": "Mbpp/780", "solution": "def find_combinations(tuple_list: list[tuple[int | float, int | float]]) -> list[tuple[int | float, int | float]]:\n    \"\"\"\n    Calculates element-wise sums of all unique pairs of distinct 2-element tuples from the input list.\n    Handles input validation and uses itertools for combinations.\n    \"\"\"\n    import itertools\n\n    if not isinstance(tuple_list, list):\n        raise TypeError(\"Input 'tuple_list' must be a list.\")\n\n    if len(tuple_list) < 2:\n        return []\n\n    for i, item in enumerate(tuple_list):\n        if not isinstance(item, tuple):\n            raise ValueError(f\"Element at index {i} must be a tuple.\")\n        if len(item) != 2:\n            raise ValueError(f\"Tuple at index {i} must have exactly 2 elements.\")\n        if not (isinstance(item[0], (int, float)) and isinstance(item[1], (int, float))):\n            raise TypeError(f\"Elements within tuple at index {i} must be numbers (int or float).\")\n\n    result_sums = []\n    for (t1_0, t1_1), (t2_0, t2_1) in itertools.combinations(tuple_list, 2):\n        result_sums.append((t1_0 + t2_0, t1_1 + t2_1))\n\n    return result_sums"}
{"task_id": "Mbpp/781", "solution": "def count_divisors(n: int) -> bool:\n    \"\"\"\n    Checks if the count of positive divisors for a given integer `n` is an even number.\n    This function leverages a helper to calculate the divisor count.\n    \"\"\"\n    count = 0\n    # Loop from 1 to the square root of n to find divisors efficiently.\n    # Each divisor i implies a corresponding divisor n/i.\n    for i in range(1, int(n**0.5) + 1):\n        if n % i == 0:\n            if i * i == n:  # If i is a perfect square root, it's counted once.\n                count += 1\n            else:  # Otherwise, i and n/i are two distinct divisors.\n                count += 2\n    return count % 2 == 0"}
{"task_id": "Mbpp/784", "solution": "def mul_even_odd(input_list: list[int]) -> int | None:\n    \"\"\"Finds the product of the first even and first odd number in a list.\n    Returns their product, or None if either is not found.\n    \"\"\"\n    def _is_even(number: int) -> bool:\n        \"\"\"Checks if a number is even.\"\"\"\n        return number % 2 == 0\n\n    def _is_odd(number: int) -> bool:\n        \"\"\"Checks if a number is odd.\"\"\"\n        return number % 2 != 0\n\n    first_even = None\n    first_odd = None\n\n    for number in input_list:\n        if first_even is None and _is_even(number):\n            first_even = number\n        if first_odd is None and _is_odd(number):\n            first_odd = number\n\n        if first_even is not None and first_odd is not None:\n            break\n\n    if first_even is None or first_odd is None:\n        return None\n    else:\n        return first_even * first_odd"}
{"task_id": "Mbpp/782", "solution": "def odd_length_sum(arr: list[int]) -> int:\n    # Calculates the sum of all odd-length subarrays within the input array.\n    # It iterates through all possible subarrays, summing elements of odd-length ones.\n    total_sum = 0\n    n = len(arr)\n\n    for i in range(n):\n        for j in range(i, n):\n            subarray = arr[i : j + 1]\n            if len(subarray) % 2 == 1:\n                total_sum += sum(subarray)\n    return total_sum"}
{"task_id": "Mbpp/786", "solution": "def right_insertion(sorted_list: list, value: object) -> int:\n    \"\"\"\n    Locates the right insertion point for a specified value in a sorted list.\n    Ensures insertion after existing occurrences if duplicates are present.\n    \"\"\"\n    low = 0\n    high = len(sorted_list)\n    while low < high:\n        mid = (low + high) // 2\n        if value < sorted_list[mid]:\n            high = mid\n        else:\n            low = mid + 1\n    return low"}
{"task_id": "Mbpp/785", "solution": "def tuple_str_int(tuple_string: str) -> tuple:\n    \"\"\"\n    Converts a string representation of a tuple (e.g., \"(7, 8, 9)\")\n    into a Python tuple containing integer elements (e.g., (7, 8, 9)).\n    \"\"\"\n    cleaned_str = tuple_string.strip()\n    if cleaned_str == \"()\":\n        return ()\n\n    # Remove the outer parentheses and strip any remaining whitespace\n    elements_str = cleaned_str[1:-1].strip()\n\n    # If the string inside parentheses is empty (e.g., from \"( )\"), return an empty tuple\n    if not elements_str:\n        return ()\n\n    # Split by comma, strip each element, and convert to int\n    elements = [int(e.strip()) for e in elements_str.split(',')]\n    return tuple(elements)"}
