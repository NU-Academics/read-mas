{"task_id": "Mbpp/608", "solution": "def bell_Number(n: int) -> int:\n    \"\"\"\n    Calculates the nth Bell number using dynamic programming (Bell triangle).\n    The Bell number B_n is the number of ways a set of n elements can be partitioned into non-empty subsets.\n    \"\"\"\n    if n == 0:\n        return 1\n\n    bell_triangle = [[0] * (n + 1) for _ in range(n + 1)]\n\n    bell_triangle[0][0] = 1\n\n    for i in range(1, n + 1):\n        bell_triangle[i][0] = bell_triangle[i-1][i-1]\n        for j in range(1, i + 1):\n            bell_triangle[i][j] = bell_triangle[i][j-1] + bell_triangle[i-1][j-1]\n\n    return bell_triangle[n][0]"}
{"task_id": "Mbpp/457", "solution": "def Find_Min(list_of_lists):\n    \"\"\"\n    Finds the sublist with the minimum length from a given list of lists.\n    Returns the first such sublist encountered.\n    \"\"\"\n    if not list_of_lists:\n        return []\n\n    min_length = float('inf')\n    min_sublist = None\n\n    for sublist in list_of_lists:\n        if not isinstance(sublist, list):\n            raise TypeError(\"Input list_of_lists must contain only lists.\")\n        \n        current_length = len(sublist)\n        if current_length < min_length:\n            min_length = current_length\n            min_sublist = sublist\n            \n    return min_sublist"}
{"task_id": "Mbpp/607", "solution": "def find_literals(text: str, pattern: str) -> tuple[str, int, int] | None:\n    \"\"\"\n    Searches a target string for the first occurrence of a literal pattern.\n    Returns the matched substring, its start index, and its end index (exclusive).\n    \"\"\"\n    start_index = text.find(pattern)\n    if start_index == -1:\n        return None\n    end_index = start_index + len(pattern)\n    return (pattern, start_index, end_index)"}
