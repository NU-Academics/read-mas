{"task_id": "Mbpp/68", "solution": "def is_Monotonic(array: list) -> bool:\n    \"\"\"\n    Checks if the given array is monotonic (either increasing or decreasing).\n    Handles empty and single-element arrays as monotonic.\n    \"\"\"\n    if len(array) <= 1:\n        return True\n\n    is_increasing = True\n    is_decreasing = True\n\n    for i in range(len(array) - 1):\n        if array[i] > array[i+1]:\n            is_increasing = False\n        if array[i] < array[i+1]:\n            is_decreasing = False\n\n    return is_increasing or is_decreasing"}
{"task_id": "Mbpp/67", "solution": "def bell_number(n: int) -> int:\n    \"\"\"\n    Calculates the Bell number B(n), which is the number of ways to partition a set of n labeled elements.\n    Uses dynamic programming with an inline binomial coefficient helper.\n    \"\"\"\n    def binomial_coefficient(n_val: int, k_val: int) -> int:\n        \"\"\"Calculates the binomial coefficient 'n_val choose k_val'.\"\"\"\n        if k_val < 0 or k_val > n_val:\n            return 0\n        if k_val == 0 or k_val == n_val:\n            return 1\n        if k_val > n_val // 2:\n            k_val = n_val - k_val\n\n        res = 1\n        for i in range(k_val):\n            res = res * (n_val - i) // (i + 1)\n        return res\n\n    # Memoization table for Bell numbers.\n    dp = [0] * (n + 1)\n\n    # Base case: B(0) = 1\n    dp[0] = 1\n\n    # Calculate Bell numbers iteratively up to n\n    # The recurrence B(i) = sum from k=0 to i-1 of (C(i-1, k) * B(k))\n    for i in range(1, n + 1):\n        current_bell_sum = 0\n        for k_val in range(i):\n            current_bell_sum += binomial_coefficient(i - 1, k_val) * dp[k_val]\n        dp[i] = current_bell_sum\n    \n    return dp[n]"}
{"task_id": "Mbpp/69", "solution": "def is_sublist(main_list: list, sub_list: list) -> bool:\n    \"\"\"\n    Checks if a list contains the given sublist as a contiguous sequence of elements.\n    \"\"\"\n    len_main = len(main_list)\n    len_sub = len(sub_list)\n\n    if len_sub == 0:\n        return True  # An empty list is always considered a sublist\n    if len_sub > len_main:\n        return False\n\n    for i in range(len_main - len_sub + 1):\n        if main_list[i:i + len_sub] == sub_list:\n            return True\n    return False"}
{"task_id": "Mbpp/71", "solution": "def comb_sort(input_list: list) -> list:\n    \"\"\"\n    Sorts a list of comparable elements in ascending order using the Comb Sort algorithm.\n    Returns a new list, leaving the original input_list unchanged.\n    \"\"\"\n    arr = list(input_list)\n    n = len(arr)\n    gap = n\n    shrink_factor = 1.3\n    sorted_flag = False\n\n    while gap > 1 or not sorted_flag:\n        gap = int(gap / shrink_factor)\n        if gap < 1:\n            gap = 1\n\n        sorted_flag = True\n        for i in range(n - gap):\n            if arr[i] > arr[i + gap]:\n                arr[i], arr[i + gap] = arr[i + gap], arr[i]\n                sorted_flag = False\n    return arr"}
