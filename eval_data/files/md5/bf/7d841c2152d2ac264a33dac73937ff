{"task_id": "Mbpp/126", "solution": "def sum_common_divisors(num1: int, num2: int) -> int:\n    \"\"\"\n    Calculates the sum of all common divisors for two given positive integers.\n    This function orchestrates the finding of divisors, common divisors, and their sum.\n    \"\"\"\n    def _get_divisors(n: int) -> set[int]:\n        \"\"\"\n        Finds all positive divisors for a given positive integer.\n        \"\"\"\n        divs = set()\n        for i in range(1, int(n**0.5) + 1):\n            if n % i == 0:\n                divs.add(i)\n                divs.add(n // i)\n        return divs\n\n    def _find_common_divisors(divisors1: set[int], divisors2: set[int]) -> set[int]:\n        \"\"\"\n        Identifies common divisors between two sets of divisors.\n        \"\"\"\n        return divisors1.intersection(divisors2)\n\n    divs1 = _get_divisors(num1)\n    divs2 = _get_divisors(num2)\n    common_divs = _find_common_divisors(divs1, divs2)\n    return sum(common_divs)"}
{"task_id": "Mbpp/130", "solution": "def max_occurrences(items: list):\n    \"\"\"\n    Finds the item with the maximum frequency in a given list.\n    Returns None if the list is empty.\n    \"\"\"\n    if not items:\n        return None\n\n    frequency_map = {}\n    for item in items:\n        frequency_map[item] = frequency_map.get(item, 0) + 1\n\n    max_freq = -1\n    max_item = None\n    for item, freq in frequency_map.items():\n        if freq > max_freq:\n            max_freq = freq\n            max_item = item\n    return max_item"}
{"task_id": "Mbpp/131", "solution": "def _is_vowel(char: str) -> bool:\n    \"\"\"Checks if a character is a vowel (a, e, i, o, u, case-insensitive, 'y' excluded).\"\"\"\n    return char.lower() in 'aeiou'\ndef reverse_vowels(s: str) -> str:\n    \"\"\"Reverses only the vowels in a given string while preserving non-vowel positions.\"\"\"\n    s_list = list(s)\n    vowels_in_string = []\n    \n    # Collect all vowels in the order they appear\n    for char in s_list:\n        if _is_vowel(char):\n            vowels_in_string.append(char)\n            \n    # Reverse the collected vowels\n    vowels_in_string.reverse()\n    \n    vowel_index = 0\n    # Replace vowels in the original string with the reversed vowels\n    for i in range(len(s_list)):\n        if _is_vowel(s_list[i]):\n            s_list[i] = vowels_in_string[vowel_index]\n            vowel_index += 1\n            \n    return \"\".join(s_list)"}
{"task_id": "Mbpp/129", "solution": "def magic_square_test(matrix: list[list[int]]) -> bool:\n    \"\"\"\n    Determines if a given matrix is a magic square by orchestrating checks for squareness and sum equality.\n    A magic square must be square and have all row, column, and diagonal sums equal.\n    \"\"\"\n\n    def _is_square_matrix(matrix: list[list[int]]) -> bool:\n        \"\"\"Verifies if the input matrix has an equal number of rows and columns, and consistent row lengths.\"\"\"\n        n = len(matrix)\n        if n == 0:\n            return False  # An empty matrix cannot be a magic square.\n        for row in matrix:\n            if len(row) != n:\n                return False\n        return True\n\n    def _calculate_row_sums(matrix: list[list[int]]) -> list[int]:\n        \"\"\"Computes the sum of elements for each row in the matrix.\"\"\"\n        return [sum(row) for row in matrix]\n\n    def _calculate_column_sums(matrix: list[list[int]]) -> list[int]:\n        \"\"\"Computes the sum of elements for each column in the matrix.\"\"\"\n        n = len(matrix)\n        column_sums = [0] * n\n        for r in range(n):\n            for c in range(n):\n                column_sums[c] += matrix[r][c]\n        return column_sums\n\n    def _calculate_main_diagonal_sum(matrix: list[list[int]]) -> int:\n        \"\"\"Computes the sum of elements along the main diagonal (top-left to bottom-right).\"\"\"\n        n = len(matrix)\n        main_diag_sum = 0\n        for i in range(n):\n            main_diag_sum += matrix[i][i]\n        return main_diag_sum\n\n    def _calculate_anti_diagonal_sum(matrix: list[list[int]]) -> int:\n        \"\"\"Computes the sum of elements along the anti-diagonal (top-right to bottom-left).\"\"\"\n        n = len(matrix)\n        anti_diag_sum = 0\n        for i in range(n):\n            anti_diag_sum += matrix[i][n - 1 - i]\n        return anti_diag_sum\n\n    def _all_sums_equal(sums: list[int]) -> bool:\n        \"\"\"Checks if all sums in a given list are identical.\"\"\"\n        if not sums:\n            return True  # An empty list of sums is trivially equal.\n        first_sum = sums[0]\n        for s in sums:\n            if s != first_sum:\n                return False\n        return True\n\n    if not _is_square_matrix(matrix):\n        return False\n\n    if not matrix: # Handle empty matrix or 0x0 matrix\n        return False\n\n    row_sums = _calculate_row_sums(matrix)\n    col_sums = _calculate_column_sums(matrix)\n    main_diag_sum = _calculate_main_diagonal_sum(matrix)\n    anti_diag_sum = _calculate_anti_diagonal_sum(matrix)\n\n    all_calculated_sums = row_sums + col_sums + [main_diag_sum, anti_diag_sum]\n\n    return _all_sums_equal(all_calculated_sums)"}
