{"task_id": "Mbpp/92", "solution": "from typing import Union\ndef is_undulating(number: Union[int, str]) -> bool:\n    \"\"\"\n    Checks if the given number is undulating.\n    An undulating number has at least two digits, strictly alternating digits, and exactly two distinct digit values.\n    \"\"\"\n    str_num = str(number)\n\n    if len(str_num) < 2:\n        return False\n\n    digits = [int(d) for d in str_num]\n\n    distinct_digits = list(set(digits))\n    if len(distinct_digits) != 2:\n        return False\n\n    first_digit_val = digits[0]\n    second_digit_val = digits[1]\n\n    if first_digit_val == second_digit_val:\n        return False\n\n    for i in range(len(digits)):\n        if i % 2 == 0:\n            if digits[i] != first_digit_val:\n                return False\n        else:\n            if digits[i] != second_digit_val:\n                return False\n\n    return True"}
{"task_id": "Mbpp/95", "solution": "def Find_Min_Length(list_of_lists: list) -> int:\n    \"\"\"\n    Finds the length of the smallest list in a list of lists.\n    Returns 0 if the input list_of_lists is empty.\n    \"\"\"\n    if not list_of_lists:\n        return 0\n\n    min_len = float('inf')\n\n    for inner_list in list_of_lists:\n        current_len = len(inner_list)\n        if current_len < min_len:\n            min_len = current_len\n\n    return int(min_len)"}
{"task_id": "Mbpp/97", "solution": "def frequency_lists(list_of_lists: list[list[any]]) -> dict[any, int]:\n    \"\"\"\n    Calculates the frequency of each element in a flattened list of lists.\n    Returns a dictionary mapping unique elements to their integer counts.\n    \"\"\"\n    frequency_map = {}\n    for sublist in list_of_lists:\n        for element in sublist:\n            frequency_map[element] = frequency_map.get(element, 0) + 1\n    return frequency_map"}
{"task_id": "Mbpp/94", "solution": "def index_minimum(data):\n    \"\"\"\n    Given a list of tuples, returns the first value of the tuple with the smallest second value.\n    Raises ValueError if the input list is empty.\n    \"\"\"\n    if not data:\n        raise ValueError(\"Input list cannot be empty.\")\n    \n    # Find the tuple with the minimum second value using the 'min' function with a key.\n    # The key function extracts the second element (index 1) for comparison.\n    min_tuple = min(data, key=lambda x: x[1])\n    \n    # Return the first element (index 0) of the identified tuple.\n    return min_tuple[0]"}
{"task_id": "Mbpp/96", "solution": "def divisor(n: int) -> int:\n    \"\"\"Calculates the number of divisors for a given positive integer n.\"\"\"\n    count = 0\n    for i in range(1, n + 1):\n        if n % i == 0:\n            count += 1\n    return count"}
{"task_id": "Mbpp/98", "solution": "def multiply_num(numbers):\n    \"\"\"\n    Calculates the product of all numbers in a list or tuple and divides by its length.\n    It returns the floating-point result of this calculation.\n    \"\"\"\n    product = 1.0\n    for num in numbers:\n        product *= num\n    \n    # The problem statement implies valid, non-empty input by example.\n    # Python's / operator performs float division in Python 3.\n    return product / len(numbers)"}
{"task_id": "Mbpp/99", "solution": "def decimal_to_binary(decimal_number: int) -> str:\n    \"\"\"\n    Converts a non-negative decimal integer to its binary string representation.\n    The result has no leading zeros, except for '0' itself.\n    \"\"\"\n    if decimal_number == 0:\n        return '0'\n\n    binary_digits = []\n    while decimal_number > 0:\n        binary_digits.append(str(decimal_number % 2))\n        decimal_number //= 2\n    \n    return \"\".join(binary_digits[::-1])"}
{"task_id": "Mbpp/70", "solution": "def get_equal(list_of_tuples: list[tuple]) -> bool:\n    \"\"\"\n    Checks if all tuples in `list_of_tuples` have the same length.\n    Returns True if all tuples have the same length or the list is empty; False otherwise.\n    \"\"\"\n    if not list_of_tuples:\n        return True\n\n    # Get the length of the first tuple as the reference\n    reference_length = len(list_of_tuples[0])\n\n    # Check if all subsequent tuples have the same length\n    for tpl in list_of_tuples:\n        if len(tpl) != reference_length:\n            return False\n\n    return True"}
