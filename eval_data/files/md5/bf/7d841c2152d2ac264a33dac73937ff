{"task_id": "Mbpp/614", "solution": "from typing import List, Tuple, Union\ndef cummulative_sum(input_list: List[Tuple[Union[int, float], ...]]) -> Union[int, float]:\n    \"\"\"\n    Calculates the cumulative sum of all numerical values across all tuples in a list.\n    This function assumes all values within the tuples are numeric (int or float).\n    \"\"\"\n    total_sum = 0\n\n    for tpl in input_list:\n        for value in tpl:\n            total_sum += value\n            \n    return total_sum"}
{"task_id": "Mbpp/618", "solution": "def div_list(list1, list2):\n    \"\"\"\n    Divides two lists element-wise, ensuring results are floats.\n    Assumes valid inputs as per design context for this implementation.\n    \"\"\"\n    result = []\n    for i in range(len(list1)):\n        result.append(float(list1[i]) / list2[i])\n    return result"}
{"task_id": "Mbpp/612", "solution": "def merge(input_list: List[List[Any]]) -> List[List[Any]]:\n    \"\"\"\n    Transforms a list of two-element sublists into a list of two lists.\n\n    The first output list contains the first element of each sublist.\n    The second output list contains the second element of each sublist.\n    \"\"\"\n    first_elements = []\n    second_elements = []\n    for sublist in input_list:\n        first_elements.append(sublist[0])\n        second_elements.append(sublist[1])\n    return [first_elements, second_elements]"}
{"task_id": "Mbpp/616", "solution": "def tuple_modulo(tuple1: tuple, tuple2: tuple) -> tuple:\n    \"\"\"Performs element-wise modulo on two tuples of the same length.\n\n    Args:\n        tuple1 (tuple): The first input tuple (dividend elements).\n        tuple2 (tuple): The second input tuple (divisor elements).\n    \"\"\"\n    if len(tuple1) != len(tuple2):\n        raise ValueError(\"Input tuples must be of the same length.\")\n\n    result = []\n    for i in range(len(tuple1)):\n        result.append(tuple1[i] % tuple2[i])\n\n    return tuple(result)"}
{"task_id": "Mbpp/615", "solution": "def average_tuple(input_data: tuple[tuple[int | float, ...], ...]) -> list[float]:\n    \"\"\"Calculates the average value for each inner tuple and returns them as a list.\"\"\"\n    averages = []\n    for inner_tuple in input_data:\n        if not inner_tuple:\n            averages.append(0.0)\n        else:\n            averages.append(sum(inner_tuple) / len(inner_tuple))\n    return averages"}
