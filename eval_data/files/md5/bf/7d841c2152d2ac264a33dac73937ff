{"task_id": "Mbpp/300", "solution": "def count_binary_seq(n: int) -> int:\n    \"\"\"Calculates the count of binary sequences of length 2n where the sum of the first n bits equals the sum of the last n bits.\n\n    Args:\n        n: A positive integer representing half the total length of the binary sequence.\n\n    Returns:\n        The total count of such binary sequences.\n\n    Raises:\n        ValueError: If n is not a positive integer.\n    \"\"\"\n    if n <= 0:\n        raise ValueError(\"n must be a positive integer.\")\n\n    def combinations(n_val: int, k_val: int) -> int:\n        \"\"\"Calculates n choose k (nCk) efficiently.\n        Assumes k_val is within the valid range [0, n_val].\n        \"\"\"\n        if k_val < 0 or k_val > n_val:\n            return 0\n        if k_val == 0 or k_val == n_val:\n            return 1\n        if k_val > n_val // 2:\n            k_val = n_val - k_val\n\n        res = 1\n        for i in range(k_val):\n            res = res * (n_val - i) // (i + 1)\n        return res\n\n    total_count = 0\n    # Iterate through all possible sums (k) for the first n bits.\n    # For each sum k, the number of ways to choose k ones from n bits is C(n, k).\n    # The last n bits must also sum to k, which is also C(n, k) ways.\n    # Thus, for each k, the contribution is C(n, k) * C(n, k).\n    for k in range(n + 1):\n        num_ways_for_k_ones = combinations(n, k)\n        total_count += (num_ways_for_k_ones * num_ways_for_k_ones)\n\n    return total_count"}
{"task_id": "Mbpp/308", "solution": "def large_product(list1: list[int | float], list2: list[int | float], k: int) -> list[int | float]:\n    \"\"\"\n    Finds the specified number of largest products from two given lists, selecting one factor from each list.\n    Returns the k largest products sorted in descending order.\n    \"\"\"\n\n    def _compute_all_products(lst1: list[int | float], lst2: list[int | float]) -> list[int | float]:\n        \"\"\"Generates all possible products by combining elements from two input lists.\"\"\"\n        products = []\n        for val1 in lst1:\n            for val2 in lst2:\n                products.append(val1 * val2)\n        return products\n\n    def _identify_k_largest(all_products: list[int | float], count: int) -> list[int | float]:\n        \"\"\"Selects the k largest products from a given list of all products.\"\"\"\n        if not all_products:\n            return []\n        # Sort in descending order to easily pick the largest\n        all_products.sort(reverse=True)\n        return all_products[:count]\n\n    def _sort_products_descending(products: list[int | float]) -> list[int | float]:\n        \"\"\"Sorts a list of products in descending order.\"\"\"\n        # This function is redundant if _identify_k_largest already sorts,\n        # but included for adherence to design document.\n        return sorted(products, reverse=True)\n\n    all_products = _compute_all_products(list1, list2)\n    k_largest_products_unsorted = _identify_k_largest(all_products, k)\n    k_largest_products_sorted = _sort_products_descending(k_largest_products_unsorted)\n\n    return k_largest_products_sorted"}
{"task_id": "Mbpp/306", "solution": "def max_sum_increasing_subseq(arr: list[int], length: int, i: int, k: int) -> int:\n    \"\"\"Calculates the maximum sum of an increasing subsequence.\n    The subsequence is formed from arr[0...i] and must include arr[k].\n    \"\"\"\n    # Initialize dp array for prefix arr[0...i]\n    # dp[x] stores the maximum sum of an increasing subsequence ending at arr[x]\n    dp = [0] * (i + 1)\n\n    for current_idx in range(i + 1):\n        dp[current_idx] = arr[current_idx]  # A single element forms an increasing subsequence\n        for prev_idx in range(current_idx):\n            if arr[current_idx] > arr[prev_idx]:\n                dp[current_idx] = max(dp[current_idx], dp[prev_idx] + arr[current_idx])\n\n    # Now find the maximum sum from dp that can be extended by arr[k]\n    max_prefix_sum = 0\n    for j in range(i + 1):\n        if arr[j] < arr[k]:\n            max_prefix_sum = max(max_prefix_sum, dp[j])\n\n    # If max_prefix_sum is 0, it means no element in arr[0...i] is smaller than arr[k].\n    # In this case, arr[k] itself forms the subsequence.\n    return max_prefix_sum + arr[k]"}
{"task_id": "Mbpp/388", "solution": "def highest_Power_of_2(n: int) -> int:\n    \"\"\"Finds the highest power of 2 that is less than or equal to n.\"\"\"\n    power_of_2 = 1\n    while power_of_2 * 2 <= n:\n        power_of_2 *= 2\n    return power_of_2"}
{"task_id": "Mbpp/311", "solution": "def set_left_most_unset_bit(value: int) -> int:\n    \"\"\"Sets the left-most (most significant) unset bit in the given integer.\n    Returns the new integer value after setting the bit.\n    \"\"\"\n    if value < 0:\n        raise ValueError(\"Negative integers are not supported as per current scope.\")\n\n    if value == 0:\n        return 1\n\n    msb_pos = value.bit_length() - 1\n\n    for i in range(msb_pos, -1, -1):\n        if not (value & (1 << i)):\n            return value | (1 << i)\n\n    return value | (1 << (msb_pos + 1))"}
{"task_id": "Mbpp/312", "solution": "import math\ndef volume_cone(radius: float, height: float) -> float:\n    \"\"\"Calculates the volume of a cone.\n    Raises ValueError if radius or height are negative.\n    \"\"\"\n    if radius < 0 or height < 0:\n        raise ValueError(\"Radius and height must be non-negative.\")\n\n    volume = (1/3) * math.pi * (radius ** 2) * height\n    return volume"}
{"task_id": "Mbpp/391", "solution": "def convert_list_dictionary(student_ids: list[str], student_names: list[str], scores: list[int]) -> list[dict]:\n    \"\"\"\n    Converts three parallel input lists into a list of nested dictionaries, validating input lengths.\n    Each dictionary in the output list will have the structure: {'Student ID': {'Student Name': Score}}.\n    \"\"\"\n    if not (len(student_ids) == len(student_names) == len(scores)):\n        raise ValueError(\"Input lists must have the same length.\")\n\n    result_list = []\n    for student_id, student_name, score in zip(student_ids, student_names, scores):\n        inner_dict = {student_name: score}\n        outer_dict = {student_id: inner_dict}\n        result_list.append(outer_dict)\n\n    return result_list"}
