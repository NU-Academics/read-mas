{"task_id": "Mbpp/120", "solution": "def max_product_tuple(data: list[tuple[float, float]]) -> float:\n    \"\"\"\n    Calculates the maximum absolute product between numbers in pairs of tuples.\n    Raises ValueError if the input list is empty.\n    \"\"\"\n\n    def _calculate_product(num1: float, num2: float) -> float:\n        \"\"\"Calculates the product of two numbers.\"\"\"\n        return num1 * num2\n\n    def _calculate_absolute_value(product: float) -> float:\n        \"\"\"Determines the absolute value of a number.\"\"\"\n        return abs(product)\n\n    def _find_max_value(values: list[float]) -> float:\n        \"\"\"Identifies the maximum value from a list of numbers.\"\"\"\n        return max(values)\n\n    if not data:\n        raise ValueError(\"Input list cannot be empty.\")\n\n    absolute_products = []\n    for num1, num2 in data:\n        product = _calculate_product(num1, num2)\n        abs_product = _calculate_absolute_value(product)\n        absolute_products.append(abs_product)\n\n    return _find_max_value(absolute_products)"}
{"task_id": "Mbpp/119", "solution": "def search(arr: list[int]) -> int:\n    \"\"\"\n    Finds the single element that appears only once in a sorted array\n    where all other elements appear exactly twice.\n    \"\"\"\n    low = 0\n    high = len(arr) - 1\n\n    while low < high:\n        mid = (low + high) // 2\n\n        # Ensure mid always points to the start of a potential pair (an even index)\n        # If mid is odd, decrement it to make it even.\n        if mid % 2 == 1:\n            mid -= 1\n\n        # If elements at mid and mid+1 are the same, the unique element\n        # must be in the right half (after this pair).\n        if arr[mid] == arr[mid + 1]:\n            low = mid + 2\n        # Otherwise, the unique element is in the left half,\n        # at or before mid.\n        else:\n            high = mid\n            \n    return arr[low]"}
{"task_id": "Mbpp/123", "solution": "def amicable_numbers_sum(limit: int) -> int:\n    \"\"\"Calculates the sum of all amicable numbers from 1 to limit.\"\"\"\n    total_sum = 0\n    found_amicable_numbers = set()\n\n    for n in range(1, limit + 1):\n        d_n = _get_proper_divisor_sum(n)\n\n        if d_n > n and d_n <= limit:\n            d_d_n = _get_proper_divisor_sum(d_n)\n\n            if d_d_n == n:\n                if n not in found_amicable_numbers:\n                    total_sum += n\n                    found_amicable_numbers.add(n)\n                if d_n not in found_amicable_numbers:\n                    total_sum += d_n\n                    found_amicable_numbers.add(d_n)\n    return total_sum"}
{"task_id": "Mbpp/125", "solution": "def find_length(binary_string: str) -> int:\n    \"\"\"\n    Calculates the maximum difference between the count of '0's and '1's\n    in any substring of the given binary string using Kadane's algorithm.\n    '0' is treated as 1 and '1' as -1 to find the maximum subarray sum.\n    \"\"\"\n    if not binary_string:\n        return 0\n\n    # Convert binary string to a list of numbers: '0' -> 1, '1' -> -1\n    nums = [1 if char == '0' else -1 for char in binary_string]\n\n    max_so_far = nums[0]\n    current_max = nums[0]\n\n    # Apply Kadane's algorithm to find the maximum subarray sum\n    for i in range(1, len(nums)):\n        current_max = max(nums[i], current_max + nums[i])\n        max_so_far = max(max_so_far, current_max)\n\n    return max_so_far"}
