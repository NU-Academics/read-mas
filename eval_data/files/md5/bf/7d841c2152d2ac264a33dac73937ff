{"task_id": "Mbpp/602", "solution": "def first_repeated_char(input_string: str) -> str | None:\n    \"\"\"\n    Identifies the first character in the input string that has a subsequent occurrence.\n    Returns the first repeated character (str of length 1) or None if no character is repeated.\n    \"\"\"\n    seen_chars = set()\n    for char in input_string:\n        if char in seen_chars:\n            return char\n        seen_chars.add(char)\n    return None"}
{"task_id": "Mbpp/604", "solution": "def reverse_words(input_string: str) -> str:\n    \"\"\"\n    Reverses the order of words in the given input string.\n    Words are separated by spaces.\n    \"\"\"\n    def _split_words(text: str) -> list[str]:\n        \"\"\"Splits a string into a list of words, handling multiple spaces.\"\"\"\n        return text.split()\n\n    def _join_words(words: list[str]) -> str:\n        \"\"\"Joins a list of words into a single string with single spaces.\"\"\"\n        return \" \".join(words)\n\n    words = _split_words(input_string)\n    words.reverse()\n    return _join_words(words)"}
{"task_id": "Mbpp/605", "solution": "def prime_num(number: int) -> bool:\n    \"\"\"\n    Determines if a given integer is a prime number.\n    A prime number is a natural number greater than 1 that has no positive\n    divisors other than 1 and itself.\n    \"\"\"\n    if not isinstance(number, int):\n        raise TypeError(\"Input must be an integer.\")\n    if number <= 1:\n        return False\n    if number <= 3:\n        return True\n    if number % 2 == 0 or number % 3 == 0:\n        return False\n\n    i = 5\n    while i * i <= number:\n        if number % i == 0 or number % (i + 2) == 0:\n            return False\n        i += 6\n    return True"}
{"task_id": "Mbpp/603", "solution": "def get_ludic(n: int) -> list[int]:\n    \"\"\"\n    Calculates all ludic numbers less than or equal to n using a sieving process.\n    \"\"\"\n    # Initialize a list of natural numbers from 1 to n.\n    # Using a list allows efficient element removal by index.\n    numbers_sequence = list(range(1, n + 1))\n    ludic_numbers = []\n\n    # Continue the sieving process as long as there are numbers in the sequence.\n    while numbers_sequence:\n        # The first number in the sequence is always the next ludic number.\n        p = numbers_sequence[0]\n        ludic_numbers.append(p)\n\n        # Remove p from the working sequence.\n        numbers_sequence.pop(0)\n\n        # Remove every p-th element from the remaining numbers_sequence.\n        # This sieving step is skipped for p=1 as it would remove all elements.\n        if p > 1:\n            indices_to_remove = []\n            current_index = p - 1  # 0-based index of the first element to remove\n\n            # Collect all indices to be removed in the current sequence.\n            while current_index < len(numbers_sequence):\n                indices_to_remove.append(current_index)\n                current_index += p\n\n            # Remove elements in reverse order to prevent index shifting issues.\n            for idx in reversed(indices_to_remove):\n                numbers_sequence.pop(idx)\n\n    return ludic_numbers"}
