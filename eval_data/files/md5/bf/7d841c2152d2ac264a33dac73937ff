{"task_id": "Mbpp/724", "solution": "def power_base_sum(base, power):\n    \"\"\"\n    Calculates the sum of all digits of the base to the specified power.\n    This function orchestrates exponentiation and digit summation using internal helpers.\n    \"\"\"\n\n    def _calculate_power(b, p):\n        \"\"\"Internal helper to compute base raised to power.\"\"\"\n        return b ** p\n\n    def _sum_digits(num):\n        \"\"\"Internal helper to extract digits from a number and sum them.\"\"\"\n        return sum(int(digit) for digit in str(num))\n\n    calculated_value = _calculate_power(base, power)\n    sum_of_digits = _sum_digits(calculated_value)\n    return sum_of_digits"}
{"task_id": "Mbpp/730", "solution": "def consecutive_duplicates(input_list: list) -> list:\n    \"\"\"\n    Removes consecutive duplicate elements from a list, preserving order.\n    Returns a new list with consecutive duplicates removed.\n    \"\"\"\n    result_list = []\n    for element in input_list:\n        if not result_list or element != result_list[-1]:\n            result_list.append(element)\n    return result_list"}
{"task_id": "Mbpp/732", "solution": "def replace_specialchar(input_string: str) -> str:\n    \"\"\"\n    Replaces all occurrences of spaces, commas, or dots with a colon in the input string.\n    \"\"\"\n    # Replace spaces with colons\n    modified_string = input_string.replace(' ', ':')\n    # Replace commas with colons\n    modified_string = modified_string.replace(',', ':')\n    # Replace dots with colons\n    modified_string = modified_string.replace('.', ':')\n    return modified_string"}
{"task_id": "Mbpp/731", "solution": "import math\nclass Cone:\n    \"\"\"Represents a cone and provides methods for calculating its geometric properties.\"\"\"\n    def __init__(self, r: float, h: float) -> None:\n        self._radius = r\n        self._height = h\n\n    def slantHeight(self) -> float:\n        \"\"\"Computes the slant height (l) of the cone.\"\"\"\n        return math.sqrt(self._radius**2 + self._height**2)\n\n    def lateralSurfaceArea(self) -> float:\n        \"\"\"Computes the lateral surface area of the cone.\"\"\"\n        l = self.slantHeight()\n        return math.pi * self._radius * l\ndef lateralsurface_cone(r: float, h: float) -> float:\n    \"\"\"Calculates the lateral surface area of a cone given its radius and height.\"\"\"\n    cone = Cone(r, h)\n    return cone.lateralSurfaceArea()"}
{"task_id": "Mbpp/733", "solution": "def find_first_occurrence(array: list[int], target: int) -> int:\n    \"\"\"\n    Finds the index of the first occurrence of a target number in a sorted array using binary search.\n    Returns the index or -1 if the target is not found.\n    \"\"\"\n    low = 0\n    high = len(array) - 1\n    result = -1\n\n    while low <= high:\n        mid = (low + high) // 2\n        if array[mid] == target:\n            result = mid\n            high = mid - 1  # Continue searching in the left half for an earlier occurrence\n        elif array[mid] < target:\n            low = mid + 1\n        else:  # array[mid] > target\n            high = mid - 1\n            \n    return result"}
{"task_id": "Mbpp/736", "solution": "def left_insertion(sorted_list: list[int | float], value: int | float) -> int:\n    \"\"\"\n    Locates the left insertion point for a specified value in a sorted list using binary search.\n    Returns the index where 'value' should be inserted to maintain sorted order.\n    \"\"\"\n    low, high = 0, len(sorted_list)\n    while low < high:\n        mid = (low + high) // 2\n        if sorted_list[mid] < value:\n            low = mid + 1\n        else:\n            high = mid\n    return low"}
{"task_id": "Mbpp/735", "solution": "def toggle_middle_bits(input_integer: int) -> int:\n    \"\"\"\n    Toggles all bits of the input_integer except the first (MSB) and the last (LSB) bit.\n    \"\"\"\n    if input_integer == 0:\n        return 0\n    \n    # Determine the bit length of the number. This is the position of the MSB + 1.\n    bit_length = input_integer.bit_length()\n\n    # If the number has 2 or fewer bits, there are no \"middle\" bits to toggle.\n    if bit_length <= 2:\n        return input_integer\n\n    # Create a mask for all bits between the MSB and LSB (exclusive of MSB and LSB).\n    # The mask will have 1s from bit position 1 up to bit_length - 2.\n    # A full mask of `bit_length` ones is (1 << bit_length) - 1.\n    # To remove the MSB (at bit_length-1) and LSB (at bit 0):\n    # Start with a mask of all ones: `(1 << bit_length) - 1`\n    # Remove MSB: `mask &= ~(1 << (bit_length - 1))`\n    # Remove LSB: `mask &= ~1`\n    \n    # Alternatively, construct a mask that only has ones for middle bits.\n    # A sequence of `bit_length - 2` ones, shifted left by 1.\n    # E.g., for 9 (1001), bit_length is 4. Middle bits are at pos 1, 2. (bit_length - 2 = 2 ones)\n    # Mask should be 0110.\n    \n    # Calculate a mask with ones in the middle positions.\n    # This involves creating a sequence of (bit_length - 2) ones.\n    # (1 << (bit_length - 2)) - 1 creates (bit_length - 2) ones at the rightmost positions.\n    # Then shift it left by 1 to skip the LSB position.\n    \n    middle_bits_mask = ((1 << (bit_length - 2)) - 1) << 1\n    \n    # Apply the XOR operation with this mask to toggle the middle bits.\n    result = input_integer ^ middle_bits_mask\n    \n    return result"}
{"task_id": "Mbpp/737", "solution": "import re\ndef check_str(input_string: str) -> bool:\n    \"\"\"Checks if the given string starts with a vowel using regex.\"\"\"\n    # Define a regex pattern that matches a vowel (case-insensitive) at the beginning of the string.\n    pattern = r\"^[aeiouAEIOU]\"\n    # Use re.match to check if the pattern exists at the beginning of the string.\n    return re.match(pattern, input_string) is not None"}
{"task_id": "Mbpp/740", "solution": "def tuple_to_dict(input_tuple: tuple) -> dict:\n    \"\"\"\n    Converts a tuple into a dictionary using adjacent elements as key-value pairs.\n    If the tuple contains an odd number of elements, the last element is ignored.\n    \"\"\"\n    result_dict = {}\n    for i in range(0, len(input_tuple) - 1, 2):\n        key = input_tuple[i]\n        value = input_tuple[i+1]\n        result_dict[key] = value\n    return result_dict"}
{"task_id": "Mbpp/741", "solution": "def all_Characters_Same(input_string: str) -> bool:\n    \"\"\"Checks if all characters in the input_string are identical.\n    Returns True for empty or single-character strings.\n    \"\"\"\n    if not input_string or len(input_string) == 1:\n        return True\n    first_char = input_string[0]\n    for char in input_string[1:]:\n        if char != first_char:\n            return False\n    return True"}
{"task_id": "Mbpp/739", "solution": "def find_Index(n: int) -> int:\n    \"\"\"\n    Finds the index of the smallest triangular number with exactly 'n' digits.\n    \"\"\"\n\n    def _calculate_triangular_number(k: int) -> int:\n        \"\"\"\n        Calculates the k-th triangular number.\n        \"\"\"\n        return k * (k + 1) // 2\n\n    def _get_digit_count(number: int) -> int:\n        \"\"\"\n        Determines the number of digits in an integer.\n        \"\"\"\n        return len(str(number))\n\n    k = 1\n    while True:\n        triangular_number = _calculate_triangular_number(k)\n        digit_count = _get_digit_count(triangular_number)\n\n        if digit_count == n:\n            return k\n        k += 1"}
