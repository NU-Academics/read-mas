{"task_id": "Mbpp/133", "solution": "def sum_negativenum(numbers: list[float]) -> float:\n    \"\"\"Calculates the sum of negative numbers in a list using Number and NumberList classes.\"\"\"\n\n    class Number:\n        def __init__(self, value: float):\n            self._value = value\n\n        def is_negative(self) -> bool:\n            return self._value < 0\n\n    class NumberList:\n        def __init__(self, values: list[float]):\n            self._numbers = [Number(val) for val in values]\n\n        def calculate_sum_of_negative_numbers(self) -> float:\n            running_total = 0.0\n            for number_obj in self._numbers:\n                if number_obj.is_negative():\n                    running_total += number_obj._value\n            return running_total\n\n    number_list_instance = NumberList(numbers)\n    result = number_list_instance.calculate_sum_of_negative_numbers()\n    return result"}
{"task_id": "Mbpp/137", "solution": "def zero_count(arr: list[int]) -> float:\n    \"\"\"Calculates the ratio of zero elements to non-zero elements in an array of integers.\n    Returns float('nan') if there are no non-zero elements.\"\"\"\n    zero_elements_count = 0\n    non_zero_elements_count = 0\n\n    for element in arr:\n        if element == 0:\n            zero_elements_count += 1\n        else:\n            non_zero_elements_count += 1\n\n    if non_zero_elements_count == 0:\n        return float('nan')\n    else:\n        return zero_elements_count / non_zero_elements_count"}
{"task_id": "Mbpp/138", "solution": "class Number:\n    \"\"\"Encapsulates an integer value and provides methods to check its properties.\"\"\"\n    def __init__(self, value: int):\n        self._value = value\n\n    def isPositive(self) -> bool:\n        \"\"\"Determines if the number is positive.\"\"\"\n        return self._value > 0\n\n    def isEven(self) -> bool:\n        \"\"\"Determines if the number is even.\"\"\"\n        return self._value % 2 == 0\ndef is_Sum_Of_Powers_Of_Two(n: int) -> bool:\n    \"\"\"\n    Checks if the given number can be represented as a sum of non-zero powers of 2.\n    This is true if and only if the number is a positive even integer.\n    \"\"\"\n    number_obj = Number(n)\n    is_positive = number_obj.isPositive()\n    is_even = number_obj.isEven()\n    return is_positive and is_even"}
{"task_id": "Mbpp/139", "solution": "import math\ndef circle_circumference(radius: float) -> float:\n    \"\"\"\n    Calculates the circumference of a circle.\n\n    Args:\n        radius: The radius of the circle.\n    \"\"\"\n    return 2 * math.pi * radius"}
{"task_id": "Mbpp/145", "solution": "def max_Abs_Diff(input_array):\n    \"\"\"\n    Finds the maximum absolute difference between any two elements in a given array.\n    Raises ValueError if the array has fewer than two elements.\n    \"\"\"\n    if len(input_array) < 2:\n        raise ValueError(\"Input array must contain at least two elements.\")\n\n    min_val = float('inf')\n    max_val = float('-inf')\n\n    for x in input_array:\n        if x < min_val:\n            min_val = x\n        if x > max_val:\n            max_val = x\n\n    return max_val - min_val"}
{"task_id": "Mbpp/140", "solution": "def extract_singly(data: list[iter]) -> set[int | float]:\n    \"\"\"\n    Flattens a list of iterables into a set of unique numeric elements.\n    It iterates through nested iterables, adding only numeric elements (int or float) to a result set.\n    \"\"\"\n    result_set = set()\n    for inner_iterable in data:\n        for element in inner_iterable:\n            if isinstance(element, (int, float)):\n                result_set.add(element)\n    return result_set"}
{"task_id": "Mbpp/142", "solution": "def count_samepair(list1: list, list2: list, list3: list) -> int:\n    \"\"\"\n    Counts the number of items that are identical in the same position of three given lists.\n    Compares elements only up to the length of the shortest list.\n    \"\"\"\n    count = 0\n    min_length = min(len(list1), len(list2), len(list3))\n\n    for i in range(min_length):\n        if list1[i] == list2[i] == list3[i]:\n            count += 1\n    return count"}
{"task_id": "Mbpp/141", "solution": "def _find_max_index(arr: list, n: int) -> int:\n    \"\"\"Finds the index of the maximum element in arr[0...n-1].\"\"\"\n    max_val = arr[0]\n    max_idx = 0\n    for i in range(1, n):\n        if arr[i] > max_val:\n            max_val = arr[i]\n            max_idx = i\n    return max_idx\ndef pancake_sort(elements: list) -> list:\n    \"\"\"Sorts a list of comparable elements in ascending order using the Pancake Sort algorithm.\n\n    Returns a new list containing the elements sorted in ascending order.\n    \"\"\"\n    n = len(elements)\n    if n <= 1:\n        return list(elements)\n\n    arr = list(elements) # Create a mutable copy\n\n    for current_size in range(n, 1, -1):\n        max_idx = _find_max_index(arr, current_size)\n\n        if max_idx != current_size - 1:\n            _flip(arr, max_idx)\n            _flip(arr, current_size - 1)\n    return arr"}
