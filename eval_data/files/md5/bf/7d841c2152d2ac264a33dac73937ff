{"task_id": "Mbpp/109", "solution": "def odd_Equivalent(binary_string: str, num_rotations: int) -> int:\n    \"\"\"Calculates the number of odd decimal equivalents when rotating a binary string.\n    Orchestrates the rotation, conversion, and counting process.\"\"\"\n\n    def _rotate_binary_string(s: str) -> str:\n        \"\"\"Rotates a string by moving the first character to the end.\"\"\"\n        if not s:\n            return s\n        return s[1:] + s[0]\n\n    def _convert_binary_to_decimal(binary_str: str) -> int:\n        \"\"\"Converts a binary string to its decimal integer equivalent.\"\"\"\n        if not binary_str:\n            return 0\n        return int(binary_str, 2)\n\n    def _is_decimal_odd(decimal_val: int) -> bool:\n        \"\"\"Determines if a decimal integer is odd.\"\"\"\n        return decimal_val % 2 == 1\n\n    if not all(c in '01' for c in binary_string):\n        raise ValueError(\"Input binary_string must contain only '0' and '1'.\")\n    if num_rotations < 0:\n        raise ValueError(\"Number of rotations cannot be negative.\")\n\n    current_string = binary_string\n    odd_count = 0\n\n    for _ in range(num_rotations):\n        current_string = _rotate_binary_string(current_string)\n        decimal_val = _convert_binary_to_decimal(current_string)\n        if _is_decimal_odd(decimal_val):\n            odd_count += 1\n\n    return odd_count"}
{"task_id": "Mbpp/113", "solution": "def check_integer(input_string: str) -> bool:\n    \"\"\"\n    Checks if a string represents an integer, optionally with a leading sign.\n    Handles empty strings, non-digit characters, and incorrect sign placement.\n    \"\"\"\n    if not input_string:\n        return False\n\n    start_index = 0\n    if input_string[0] in ('-', '+'):\n        start_index = 1\n    \n    # An empty string or just a sign is not a valid integer.\n    if start_index >= len(input_string):\n        return False\n\n    return input_string[start_index:].isdigit()"}
{"task_id": "Mbpp/111", "solution": "def common_in_nested_lists(nested_list):\n    \"\"\"\n    Finds common elements across multiple nested lists.\n    Returns a set of unique elements that are present in every sub-list.\n    \"\"\"\n    if not nested_list:\n        return set()\n\n    # Start with the set of elements from the first sub-list\n    common_elements = set(nested_list[0])\n\n    # If the first sub-list was empty, no common elements are possible\n    if not common_elements and nested_list[0] == []:\n        return set()\n\n    # Intersect with subsequent sub-lists\n    for sub_list in nested_list[1:]:\n        common_elements.intersection_update(sub_list)\n        # Optimization: if common_elements becomes empty, no need to check further\n        if not common_elements:\n            break\n\n    return common_elements"}
