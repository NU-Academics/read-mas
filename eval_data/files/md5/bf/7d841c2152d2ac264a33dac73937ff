{"task_id": "Mbpp/247", "solution": "def lps(s: str) -> int:\n    \"\"\"\n    Calculates the length of the longest palindromic subsequence in the given string.\n    This uses dynamic programming to find the LCS of the string and its reverse.\n    \"\"\"\n    n = len(s)\n    if n == 0:\n        return 0\n\n    s_reversed = s[::-1]\n\n    dp = [[0] * (n + 1) for _ in range(n + 1)]\n\n    for i in range(1, n + 1):\n        for j in range(1, n + 1):\n            if s[i - 1] == s_reversed[j - 1]:\n                dp[i][j] = 1 + dp[i - 1][j - 1]\n            else:\n                dp[i][j] = max(dp[i - 1][j], dp[i][j - 1])\n\n    return dp[n][n]"}
{"task_id": "Mbpp/245", "solution": "def _calculate_lis_sums(arr: list[int]) -> list[int]:\n    \"\"\"\n    Computes the maximum sum of an increasing subsequence ending at each position.\n    Each element `i` in the returned list contains the maximum sum of an increasing subsequence ending at `arr[i]`.\n    \"\"\"\n    n = len(arr)\n    if n == 0:\n        return []\n\n    lis_sums = list(arr) \n\n    for i in range(1, n):\n        for j in range(i):\n            if arr[i] > arr[j]:\n                lis_sums[i] = max(lis_sums[i], lis_sums[j] + arr[i])\n    return lis_sums\ndef _calculate_lds_sums(arr: list[int]) -> list[int]:\n    \"\"\"\n    Computes the maximum sum of a decreasing subsequence starting at each position.\n    Each element `i` in the returned list contains the maximum sum of a decreasing subsequence starting at `arr[i]`.\n    \"\"\"\n    n = len(arr)\n    if n == 0:\n        return []\n\n    lds_sums = list(arr) \n\n    for i in range(n - 2, -1, -1):\n        for j in range(n - 1, i, -1):\n            if arr[i] > arr[j]:\n                lds_sums[i] = max(lds_sums[i], lds_sums[j] + arr[i])\n    return lds_sums\ndef max_sum(arr: list[int]) -> int:\n    \"\"\"\n    Calculates the maximum sum of a bitonic subsequence for a given array.\n    A sequence is bitonic if it is first increasing and then decreasing.\n    \"\"\"\n    n = len(arr)\n    if n == 0:\n        return 0\n    if n == 1:\n        return arr[0]\n\n    lis_sums = _calculate_lis_sums(arr)\n    lds_sums = _calculate_lds_sums(arr)\n\n    max_bitonic_sum = 0\n    for i in range(n):\n        # A bitonic subsequence with arr[i] as the peak is formed by an\n        # increasing subsequence ending at arr[i] and a decreasing subsequence\n        # starting at arr[i]. arr[i] is counted once in each, so we subtract it once.\n        current_bitonic_sum = lis_sums[i] + lds_sums[i] - arr[i]\n        max_bitonic_sum = max(max_bitonic_sum, current_bitonic_sum)\n\n    return max_bitonic_sum"}
