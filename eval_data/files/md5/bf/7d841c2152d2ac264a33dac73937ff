{"task_id": "Mbpp/160", "solution": "def find_solution(a, b, n):\n    \"\"\"\n    Finds integer solutions (x, y) for ax + by = n, or returns None if no solution exists.\n    \"\"\"\n    def _extended_gcd(a, b):\n        \"\"\"\n        Computes gcd(a, b) and coefficients x, y such that ax + by = gcd(a, b).\n        \"\"\"\n        if a == 0:\n            return b, 0, 1\n        gcd, x1, y1 = _extended_gcd(b % a, a)\n        x = y1 - (b // a) * x1\n        y = x1\n        return gcd, x, y\n\n    gcd_val, x0, y0 = _extended_gcd(a, b)\n\n    if n % gcd_val != 0:\n        return None\n    else:\n        # Calculate particular solution\n        x = x0 * (n // gcd_val)\n        y = y0 * (n // gcd_val)\n        return (x, y)"}
{"task_id": "Mbpp/162", "solution": "def sum_series(n):\n    \"\"\"Calculates the sum of (n - 2*i) for i from 0 to n // 2.\n    This function provides a direct functional interface to the series sum calculation.\n    \"\"\"\n    total_sum = 0\n    for i in range(n // 2 + 1):\n        term = n - (2 * i)\n        total_sum += term\n    return total_sum"}
{"task_id": "Mbpp/165", "solution": "def count_char_position(input_string: str) -> int:\n    \"\"\"\n    Counts characters whose 0-based index matches their 0-based alphabetical position (case-insensitive).\n    \"\"\"\n\n    def _is_english_alphabetic(char: str) -> bool:\n        \"\"\"Determines if a given character is an English alphabet letter.\"\"\"\n        return 'a' <= char <= 'z' or 'A' <= char <= 'Z'\n\n    def _to_lowercase(char: str) -> str:\n        \"\"\"Converts an English alphabet character to its lowercase equivalent.\"\"\"\n        return char.lower()\n\n    def _get_0_based_alphabetical_position(char: str) -> int:\n        \"\"\"Determines the 0-based alphabetical position of a lowercase English alphabet character.\"\"\"\n        return ord(char) - ord('a')\n\n    count = 0\n    for index, char in enumerate(input_string):\n        if _is_english_alphabetic(char):\n            lower_char = _to_lowercase(char)\n            alpha_pos = _get_0_based_alphabetical_position(lower_char)\n            if alpha_pos == index:\n                count += 1\n    return count"}
