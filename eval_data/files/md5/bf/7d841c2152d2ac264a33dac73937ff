{"task_id": "Mbpp/577", "solution": "def last_Digit_Factorial(n: int) -> int:\n    \"\"\"\n    Calculates the last digit of the factorial of a given number n.\n    Handles special cases for n < 5 and returns 0 for n >= 5.\n    \"\"\"\n    if n < 0:\n        raise ValueError(\"Input must be a non-negative integer.\")\n\n    if n >= 5:\n        return 0\n    elif n == 0:\n        return 1\n    elif n == 1:\n        return 1\n    elif n == 2:\n        return 2\n    elif n == 3:\n        return 6\n    elif n == 4:\n        return 4\n    # The problem implies n is an integer, and previous checks cover all cases.\n    # This branch should ideally not be reached with valid n."}
{"task_id": "Mbpp/578", "solution": "def interleave_lists(list1: list, list2: list, list3: list) -> list:\n    \"\"\"\n    Interleaves three lists of the same length into a single flat list.\n    Elements are taken sequentially from each list for each index.\n    \"\"\"\n    interleaved_list = []\n    length = len(list1)  # All lists are assumed to be of the same length\n\n    for i in range(length):\n        interleaved_list.append(list1[i])\n        interleaved_list.append(list2[i])\n        interleaved_list.append(list3[i])\n\n    return interleaved_list"}
{"task_id": "Mbpp/579", "solution": "def find_dissimilar(tuple1: tuple, tuple2: tuple) -> tuple:\n    \"\"\"Finds elements present in one tuple but not in the other.\"\"\"\n    set_tuple1 = set(tuple1)\n    set_tuple2 = set(tuple2)\n\n    unique_to_tuple1 = set_tuple1 - set_tuple2\n    unique_to_tuple2 = set_tuple2 - set_tuple1\n\n    combined_set = unique_to_tuple1.union(unique_to_tuple2)\n    \n    return tuple(combined_set)"}
{"task_id": "Mbpp/580", "solution": "def extract_even(input_tuple: tuple) -> tuple:\n    \"\"\"\n    Recursively extracts even integer elements from a nested tuple,\n    preserving the original nesting structure and relative order.\n    \"\"\"\n    results = []\n    for element in input_tuple:\n        if isinstance(element, int):\n            if element % 2 == 0:\n                results.append(element)\n        elif isinstance(element, tuple):\n            nested_result = extract_even(element)\n            # Add the nested result if it's not empty, or if the original element was an empty tuple.\n            if nested_result or element == ():\n                results.append(nested_result)\n    return tuple(results)"}
{"task_id": "Mbpp/581", "solution": "def surface_Area(base_edge: float, height: float) -> float:\n    \"\"\"\n    Calculates the total surface area of a square pyramid.\n    The 'height' parameter represents the slant height of the pyramid.\n    \"\"\"\n    base_area = base_edge * base_edge\n    triangular_face_area = 0.5 * base_edge * height\n    total_triangular_area = 4 * triangular_face_area\n    total_surface_area = base_area + total_triangular_area\n    return total_surface_area"}
{"task_id": "Mbpp/585", "solution": "def expensive_items(items: list[dict], n: int) -> list[dict]:\n    \"\"\"\n    Finds the 'n' most expensive items from a list of item dictionaries.\n    Handles various edge cases such as empty input, n <= 0, or n exceeding item count.\n    \"\"\"\n    if n <= 0 or not items:\n        return []\n\n    # Sort items by 'price' in descending order\n    sorted_items = sorted(items, key=lambda item: item['price'], reverse=True)\n\n    # Return the top 'n' items\n    return sorted_items[:n]"}
{"task_id": "Mbpp/583", "solution": "def _factorial(k: int) -> int:\n    \"\"\"Calculates the factorial of a non-negative integer k.\"\"\"\n    res = 1\n    for i in range(1, k + 1):\n        res *= i\n    return res\ndef catalan_number(n: int) -> int:\n    \"\"\"Calculates the nth Catalan number C_n using the formula C_n = (2n)! / ((n+1)! * n!).\"\"\"\n    numerator = _factorial(2 * n)\n    denominator = _factorial(n + 1) * _factorial(n)\n    return numerator // denominator"}
{"task_id": "Mbpp/586", "solution": "def split_Arr(arr, n):\n    \"\"\"\n    Splits a list at the nth element and reorders it by moving the first part to the end.\n    Returns a new list with elements reordered.\n    \"\"\"\n    if n == 0 or n == len(arr):\n        return list(arr)\n\n    first_part = arr[0:n]\n    second_part = arr[n:]\n    return second_part + first_part"}
