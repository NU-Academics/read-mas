{"task_id": "Mbpp/462", "solution": "def combinations_list(input_list: list) -> list:\n    \"\"\"\n    Generates all possible unique combinations of elements from the given list.\n\n    The empty list is always included in the result.\n    \"\"\"\n    output_combinations = [[]]\n    for element in input_list:\n        # Create new combinations by adding the current element to all existing combinations.\n        new_combinations = [combination + [element] for combination in output_combinations]\n        output_combinations.extend(new_combinations)\n    return output_combinations"}
{"task_id": "Mbpp/468", "solution": "def max_product(arr: list[int]) -> int:\n    \"\"\"Calculates the maximum product of an increasing subsequence from the input array using dynamic programming.\"\"\"\n    n = len(arr)\n    if n == 0:\n        return 0\n\n    # dp[i] stores the maximum product of an increasing subsequence ending at index i\n    dp = [0] * n\n\n    # Initialize dp array: each element itself forms an increasing subsequence of length 1\n    # with a product equal to its value. Products must be positive, so skip non-positive numbers for initialization.\n    for i in range(n):\n        if arr[i] > 0:\n            dp[i] = arr[i]\n        # If arr[i] is 0 or negative, it cannot start a positive increasing product subsequence\n        # unless it's the only element, but we initialize to 0 for non-positive.\n        # This will be handled by the outer max_product_value initialization.\n\n    # If all elements are non-positive or 0, the maximum product is 0\n    # (or the largest single non-positive element if the problem required it, but here it's \"product of increasing subsequence\")\n    # For the given problem, an empty subsequence would be 1, but we return 0 for an empty array.\n    # An increasing subsequence must have elements.\n    max_product_value = 0\n    if n > 0: # If there's at least one positive element, max_product_value will be updated.\n        for val in dp:\n            max_product_value = max(max_product_value, val)\n\n    for i in range(n):\n        for j in range(i):\n            if arr[i] > arr[j] and arr[i] > 0: # Current element must be greater and positive to extend product\n                if dp[j] > 0: # Only extend if the product ending at j is positive\n                    dp[i] = max(dp[i], dp[j] * arr[i])\n        max_product_value = max(max_product_value, dp[i])\n\n    return max_product_value"}
{"task_id": "Mbpp/463", "solution": "def max_subarray_product(nums: list) -> int:\n    \"\"\"Finds the maximum product of a contiguous subarray within a given array of numbers.\n    This dynamically tracks the maximum and minimum product ending at each position.\"\"\"\n    if not nums:\n        return 0\n\n    current_max_product = nums[0]\n    current_min_product = nums[0]\n    overall_max_product = nums[0]\n\n    for i in range(1, len(nums)):\n        num = nums[i]\n        \n        # Store previous current_max_product as it's needed for current_min_product calculation\n        temp_max_product = current_max_product\n\n        current_max_product = max(num, temp_max_product * num, current_min_product * num)\n        current_min_product = min(num, temp_max_product * num, current_min_product * num)\n        \n        overall_max_product = max(overall_max_product, current_max_product)\n        \n    return overall_max_product"}
{"task_id": "Mbpp/472", "solution": "def check_Consecutive(numbers: list[int]) -> bool:\n    \"\"\"\n    Checks if a given list of integers contains consecutive numbers.\n    Assumes \"consecutive\" means each element is exactly one greater than its preceding element after sorting.\n    \"\"\"\n    if not numbers:\n        return False\n    if len(numbers) == 1:\n        return True\n\n    sorted_numbers = sorted(numbers)\n\n    for i in range(1, len(sorted_numbers)):\n        if sorted_numbers[i] != sorted_numbers[i-1] + 1:\n            return False\n    return True"}
{"task_id": "Mbpp/470", "solution": "def add_pairwise(input_tuple: tuple) -> tuple:\n    \"\"\"Calculates the pairwise sum of neighboring elements in a tuple.\n    It returns a new tuple containing the sums of adjacent elements.\n    \"\"\"\n    if not input_tuple or len(input_tuple) < 2:\n        return ()\n\n    result_list = []\n    for i in range(len(input_tuple) - 1):\n        result_list.append(input_tuple[i] + input_tuple[i+1])\n    \n    return tuple(result_list)"}
