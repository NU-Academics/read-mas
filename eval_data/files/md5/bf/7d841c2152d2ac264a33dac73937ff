{"task_id": "Mbpp/576", "solution": "def is_Sub_Array(main_list: list, sub_list: list) -> bool:\n    \"\"\"\n    Checks if 'sub_list' is a consecutive sublist of 'main_list'.\n    Returns True if sub_list is found consecutively within main_list, False otherwise.\n    \"\"\"\n    if not sub_list:\n        return True\n\n    if len(sub_list) > len(main_list):\n        return False\n\n    n = len(main_list)\n    m = len(sub_list)\n\n    for i in range(n - m + 1):\n        if main_list[i : i + m] == sub_list:\n            return True\n\n    return False"}
{"task_id": "Mbpp/721", "solution": "from typing import List\ndef maxAverageOfPath(matrix: List[List[int]]) -> float:\n    \"\"\"\n    Finds the path with the maximum average cost from the top-left to the bottom-right cell\n    in a square matrix, moving only right or down.\n    \"\"\"\n\n    class Cell:\n        \"\"\"Represents a single cell in the matrix with its coordinates and cost.\"\"\"\n        def __init__(self, row: int, col: int, cost: int) -> None:\n            self._row = row\n            self._col = col\n            self._cost = cost\n        def get_row(self) -> int: return self._row\n        def get_col(self) -> int: return self._col\n        def get_cost(self) -> int: return self._cost\n\n    class Path:\n        \"\"\"Represents a sequence of cells forming a path and calculates its associated metrics.\"\"\"\n        def __init__(self, cells_list: List[Cell]) -> None:\n            self._cells_in_path: List[Cell] = cells_list\n            self._total_cost: float = 0.0\n            self._number_of_cells: int = 0\n            self._average_cost: float = 0.0\n            self.calculate_metrics()\n\n        def calculate_metrics(self) -> None:\n            \"\"\"Computes total cost, number of cells, and average cost for the path.\"\"\"\n            self._total_cost = sum(cell.get_cost() for cell in self._cells_in_path)\n            self._number_of_cells = len(self._cells_in_path)\n            if self._number_of_cells > 0:\n                self._average_cost = self._total_cost / self._number_of_cells\n            else:\n                self._average_cost = 0.0\n\n        def get_average_cost(self) -> float:\n            \"\"\"Returns the average cost of the path.\"\"\"\n            return self._average_cost\n\n    class Matrix:\n        \"\"\"Manages the grid of cells and provides access to individual cells.\"\"\"\n        def __init__(self, matrix_data_input: List[List[int]]) -> None:\n            self._N = len(matrix_data_input)\n            self._cells: List[List[Cell]] = []\n            for r in range(self._N):\n                row_cells = []\n                for c in range(self._N):\n                    row_cells.append(Cell(r, c, matrix_data_input[r][c]))\n                self._cells.append(row_cells)\n\n        def get_cell(self, row: int, col: int) -> Cell:\n            \"\"\"Returns the Cell object at the specified row and column.\"\"\"\n            return self._cells[row][col]\n\n        def get_N(self) -> int:\n            \"\"\"Returns the dimension N of the square matrix.\"\"\"\n            return self._N\n\n    # Initialize Matrix and storage for all found paths\n    matrix_obj = Matrix(matrix)\n    N = matrix_obj.get_N()\n    all_paths: List[Path] = []\n\n    # Depth-First Search (DFS) helper function to find all paths\n    def _find_all_paths_dfs(r: int, c: int, current_path_cells_list: List[Cell]) -> None:\n        current_cell = matrix_obj.get_cell(r, c)\n        new_path_cells_list = current_path_cells_list + [current_cell]\n\n        # Base case: Reached the bottom-right cell\n        if r == N - 1 and c == N - 1:\n            all_paths.append(Path(new_path_cells_list))\n            return\n\n        # Explore moving right\n        if c + 1 < N:\n            _find_all_paths_dfs(r, c + 1, new_path_cells_list)\n\n        # Explore moving down\n        if r + 1 < N:\n            _find_all_paths_dfs(r + 1, c, new_path_cells_list)\n\n    # Start DFS from the top-left cell (0,0) with an empty path\n    _find_all_paths_dfs(0, 0, [])\n\n    # Find the maximum average among all discovered paths\n    max_avg = 0.0\n    if not all_paths: # Handle cases like empty matrix, though problem implies N*N matrix\n        return max_avg\n\n    for path in all_paths:\n        max_avg = max(max_avg, path.get_average_cost())\n\n    return max_avg"}
