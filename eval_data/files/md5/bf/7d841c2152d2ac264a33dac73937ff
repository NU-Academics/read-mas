{"task_id": "Mbpp/8", "solution": "def square_nums(input_list: list) -> list:\n    \"\"\"Calculates the square of each element in a list of numbers.\n    Returns a new list containing the square of each number.\"\"\"\n    return [num * num for num in input_list]"}
{"task_id": "Mbpp/11", "solution": "def remove_Occ(input_string: str, char_to_remove: str) -> str:\n    \"\"\"\n    Removes the first and last occurrences of a given character from the string.\n    Returns the original string if the character is not found or only found once.\n    \"\"\"\n    first_index = input_string.find(char_to_remove)\n    last_index = input_string.rfind(char_to_remove)\n\n    if first_index == -1:\n        # Character not found\n        return input_string\n    elif first_index == last_index:\n        # Character found only once\n        return input_string[0:first_index] + input_string[first_index + 1:]\n    else:\n        # Character found multiple times\n        return input_string[0:first_index] + input_string[first_index + 1:last_index] + input_string[last_index + 1:]"}
{"task_id": "Mbpp/6", "solution": "def differ_At_One_Bit_Pos(num1: int, num2: int) -> bool:\n    \"\"\"\n    Checks if two integer numbers differ at exactly one bit position.\n    It performs a bitwise XOR and counts the set bits in the result.\n    \"\"\"\n    xor_result = num1 ^ num2\n    count = 0\n    while xor_result > 0:\n        xor_result &= (xor_result - 1)\n        count += 1\n    return count == 1"}
{"task_id": "Mbpp/4", "solution": "import heapq\ndef heap_queue_largest(numbers: list[int], n: int) -> list[int]:\n    \"\"\"\n    Finds the n largest integers from a list and returns them in descending order.\n    Handles empty lists or non-positive n by returning an empty list.\n    \"\"\"\n    if not numbers or n <= 0:\n        return []\n\n    # heapq.nlargest returns elements in descending order\n    largest = heapq.nlargest(n, numbers)\n    return largest"}
{"task_id": "Mbpp/2", "solution": "def similar_elements(list1: tuple | list, list2: tuple | list) -> set:\n    \"\"\"Finds the shared elements from two given lists or tuples.\n    This function efficiently determines the intersection of two collections by converting them to sets.\"\"\"\n    set1 = set(list1)\n    set2 = set(list2)\n    return set1.intersection(set2)"}
{"task_id": "Mbpp/3", "solution": "import math\ndef is_not_prime(number: int) -> bool:\n    \"\"\"\n    Identifies if a given integer is a non-prime number.\n    Returns True if the number is non-prime, False otherwise.\n    \"\"\"\n    if number <= 1:\n        return False\n    if number == 2:\n        return False\n    if number % 2 == 0:\n        return True\n\n    for i in range(3, int(math.sqrt(number)) + 1, 2):\n        if number % i == 0:\n            return True\n\n    return False"}
{"task_id": "Mbpp/7", "solution": "def find_char_long(input_string: str) -> set[str]:\n    \"\"\"Finds all words at least 4 characters long in a string.\"\"\"\n\n    import re\n\n    def _parse_words(text: str) -> list[str]:\n        \"\"\"Splits a string into words based on whitespace and punctuation.\"\"\"\n        return re.findall(r'\\b\\w+\\b', text)\n\n    def _calculate_length(word: str) -> int:\n        \"\"\"Calculates the character length of a given word.\"\"\"\n        return len(word)\n\n    def _filter_words(words: list[str], min_length: int) -> set[str]:\n        \"\"\"Filters a list of words, returning only those >= min_length.\"\"\"\n        filtered = set()\n        for word in words:\n            if _calculate_length(word) >= min_length:\n                filtered.add(word)\n        return filtered\n\n    parsed_words = _parse_words(input_string)\n    result_set = _filter_words(parsed_words, 4)\n    return result_set"}
{"task_id": "Mbpp/9", "solution": "def find_Rotations(input_string: str) -> int:\n    \"\"\"\n    Calculates the minimum number of rotations (greater than 0) required to get the same string.\n    A rotation moves the first character to the end.\n    \"\"\"\n\n    class RotatableString:\n        \"\"\"\n        Manages a string and provides methods to rotate it and find the minimum rotations.\n        \"\"\"\n        def __init__(self, input_string: str):\n            self._original_string = input_string\n            self._current_string = input_string\n            self._length = len(input_string)\n\n        def _rotate_once(self) -> None:\n            \"\"\"Performs one rotation on _current_string.\"\"\"\n            if self._length > 0:\n                self._current_string = self._current_string[1:] + self._current_string[0]\n\n        def _is_original(self) -> bool:\n            \"\"\"Checks if _current_string matches _original_string.\"\"\"\n            return self._current_string == self._original_string\n\n        def findMinimumRotations(self) -> int:\n            \"\"\"\n            Calculates and returns the minimum number of rotations (greater than 0)\n            to get the same string.\n            \"\"\"\n            if self._length == 0:\n                return 0\n\n            rotations = 0\n            # Perform at least one rotation, then check if it's back to original.\n            self._rotate_once()\n            rotations += 1\n\n            if self._is_original():\n                return rotations\n\n            # Continue rotating until the original string is found again.\n            while not self._is_original():\n                self._rotate_once()\n                rotations += 1\n            \n            return rotations\n\n    rotatable_str_instance = RotatableString(input_string)\n    return rotatable_str_instance.findMinimumRotations()"}
{"task_id": "Mbpp/14", "solution": "def find_Volume(base: float, height: float, length: float) -> float:\n    \"\"\"Calculates the volume of a triangular prism.\n    Raises ValueError if any input dimension is not a positive numerical value.\n    \"\"\"\n    if not (base > 0 and height > 0 and length > 0):\n        raise ValueError(\"Dimensions must be positive\")\n    \n    volume = 0.5 * base * height * length\n    return float(volume)"}
