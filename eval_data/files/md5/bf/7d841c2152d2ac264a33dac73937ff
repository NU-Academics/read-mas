{"task_id": "Mbpp/751", "solution": "from typing import List, TypeVar\nfrom collections.abc import Sized\n_Comparable = TypeVar('_Comparable', bound='Comparable')\ndef check_min_heap(array: List[_Comparable]) -> bool:\n    \"\"\"Checks if the given array represents a min-heap.\"\"\"\n    n = len(array)\n\n    if n <= 1:\n        return True\n\n    # Iterate only through potential parent nodes\n    # Parents are at indices from 0 up to (n // 2) - 1\n    for i in range(n // 2):\n        left_child_idx = 2 * i + 1\n        right_child_idx = 2 * i + 2\n\n        # Check left child\n        if left_child_idx < n and array[i] > array[left_child_idx]:\n            return False\n\n        # Check right child\n        if right_child_idx < n and array[i] > array[right_child_idx]:\n            return False\n\n    return True"}
{"task_id": "Mbpp/752", "solution": "def jacobsthal_num(n: int) -> int:\n    \"\"\"Calculates the nth Jacobsthal number using an iterative approach.\n    J(0)=0, J(1)=1, J(n) = J(n-1) + 2 * J(n-2) for n > 1.\n    \"\"\"\n    j_n_minus_2 = 0\n    j_n_minus_1 = 1\n\n    if n == 0:\n        return j_n_minus_2\n    if n == 1:\n        return j_n_minus_1\n\n    for _ in range(2, n + 1):\n        j_n = j_n_minus_1 + 2 * j_n_minus_2\n        j_n_minus_2 = j_n_minus_1\n        j_n_minus_1 = j_n\n    return j_n"}
{"task_id": "Mbpp/753", "solution": "def min_k(tuple_list: list[tuple], k: int) -> list[tuple]:\n    \"\"\"\n    Finds the minimum k records from a list of tuples, sorted by the second element.\n    \"\"\"\n    # Sort the list of tuples based on the second element (index 1) in ascending order.\n    sorted_list = sorted(tuple_list, key=lambda x: x[1])\n    # Return the first k elements from the sorted list.\n    return sorted_list[:k]"}
{"task_id": "Mbpp/754", "solution": "def extract_index_list(l1: list, l2: list, l3: list) -> list:\n    \"\"\"Finds elements common to three lists at the same index.\n\n    Args:\n        l1: The first input list.\n        l2: The second input list.\n        l3: The third input list.\n\n    Returns:\n        A new list containing elements that appear in all three lists\n        at the same corresponding index.\n    \"\"\"\n    common_elements_list = []\n    min_length = min(len(l1), len(l2), len(l3))\n\n    for i in range(min_length):\n        if l1[i] == l2[i] == l3[i]:\n            common_elements_list.append(l1[i])\n\n    return common_elements_list"}
{"task_id": "Mbpp/755", "solution": "def second_smallest(numbers: list) -> int:\n    \"\"\"Finds the second smallest distinct number in a list.\"\"\"\n    unique_numbers = sorted(list(set(numbers)))\n    if len(unique_numbers) < 2:\n        raise ValueError(\"List must contain at least two distinct elements to find the second smallest.\")\n    return unique_numbers[1]"}
{"task_id": "Mbpp/759", "solution": "def is_decimal(input_string: str) -> bool:\n    \"\"\"\n    Checks if a string represents a decimal number with exactly two digits after the decimal point.\n    It supports optional leading zeros and a single decimal point.\n    \"\"\"\n    parts = input_string.split('.')\n    if len(parts) == 1:\n        # No decimal point, not a 2-precision decimal\n        return False\n    elif len(parts) == 2:\n        integer_part = parts[0]\n        fractional_part = parts[1]\n\n        # Fractional part must have exactly two digits\n        if len(fractional_part) != 2 or not fractional_part.isdigit():\n            return False\n\n        # Integer part can be empty (e.g., '.11') but if present, must be digits\n        if not integer_part and input_string[0] == '.': # Handles cases like '.11'\n            return True\n        elif not integer_part: # Handles cases like '' before .xx\n            return False\n        \n        # Check if the integer part is composed of digits.\n        # This covers positive numbers and leading zeros, e.g., '01.11', '123.11'\n        if not integer_part.isdigit():\n            return False\n        \n        return True\n    else:\n        # More than one decimal point\n        return False"}
{"task_id": "Mbpp/758", "solution": "def unique_sublists(list_of_lists: list) -> dict:\n    \"\"\"\n    Counts occurrences of unique sublists within a list of lists.\n    Converts each sublist to a tuple and returns a dictionary of counts.\n    \"\"\"\n    counts_map = {}\n    for sublist in list_of_lists:\n        current_tuple = tuple(sublist)\n        counts_map[current_tuple] = counts_map.get(current_tuple, 0) + 1\n    return counts_map"}
{"task_id": "Mbpp/757", "solution": "def count_reverse_pairs(string_list: list[str]) -> int:\n    \"\"\"\n    Counts unique pairs of reverse strings in a given list.\n    Handles palindromes as a pair with themselves.\n    \"\"\"\n    unique_pairs_set = set()\n    unique_strings_set = set(string_list)\n\n    for s1 in unique_strings_set:\n        s1_rev = s1[::-1]\n        if s1_rev in unique_strings_set:\n            # Create a canonical representation of the pair to ensure uniqueness (e.g., (\"a\", \"b\") vs (\"b\", \"a\"))\n            canonical_pair = tuple(sorted((s1, s1_rev)))\n            unique_pairs_set.add(canonical_pair)\n\n    return len(unique_pairs_set)"}
{"task_id": "Mbpp/762", "solution": "def check_monthnumber_number(month_number: int) -> bool:\n    \"\"\"Checks if the given month number (1-12) contains 30 days.\n\n    Raises ValueError if month_number is outside the valid range.\n    \"\"\"\n    if not 1 <= month_number <= 12:\n        raise ValueError(\"Month number must be between 1 and 12.\")\n    return month_number in [4, 6, 9, 11]"}
