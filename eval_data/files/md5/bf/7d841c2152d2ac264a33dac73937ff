{"task_id": "Mbpp/453", "solution": "def _is_even(num: int) -> bool:\n    \"\"\"Checks if a given integer is even.\"\"\"\n    return num % 2 == 0\ndef _get_factors(num: int) -> list[int]:\n    \"\"\"Finds all positive integer factors of a given number.\"\"\"\n    factors = []\n    i = 1\n    while i * i <= num:\n        if num % i == 0:\n            factors.append(i)\n            if i * i != num:\n                factors.append(num // i)\n        i += 1\n    return factors\ndef sumofFactors(number: int) -> int:\n    \"\"\"Calculates the sum of all even factors of a given positive integer.\"\"\"\n    even_factors_sum = 0\n    all_factors = _get_factors(number)\n\n    for factor in all_factors:\n        if _is_even(factor):\n            even_factors_sum += factor\n\n    return even_factors_sum"}
