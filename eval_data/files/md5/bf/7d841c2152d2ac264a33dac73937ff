{"task_id": "Mbpp/305", "solution": "from typing import List, Tuple\ndef start_withp(words_list: List[str]) -> Tuple[str, str]:\n    \"\"\"\n    Identifies and returns the first two words starting with 'p' or 'P'\n    from a list of strings.\n    \"\"\"\n    def _extract_words(text: str) -> List[str]:\n        \"\"\"Extracts individual words from a string, splitting by whitespace.\"\"\"\n        return text.split()\n\n    def _is_p_word(word: str) -> bool:\n        \"\"\"Checks if a word starts with 'p' or 'P' (case-insensitive).\"\"\"\n        return word.lower().startswith('p')\n\n    p_words_found = []\n    for text_item in words_list:\n        words = _extract_words(text_item)\n        for word in words:\n            if _is_p_word(word):\n                p_words_found.append(word)\n                if len(p_words_found) == 2:\n                    return (p_words_found[0], p_words_found[1])\n    \n    raise ValueError(\"Fewer than two 'p'-starting words found.\")"}
