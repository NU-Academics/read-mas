{"task_id": "Mbpp/555", "solution": "def difference(n: int) -> int:\n    \"\"\"\n    Calculates the difference between the sum of cubes of the first n natural numbers\n    and the sum of the first n natural numbers using mathematical formulas.\n    \"\"\"\n    if n < 1:\n        raise ValueError(\"Input 'n' must be a positive integer.\")\n\n    # Sum of the first n natural numbers: S_n = n * (n + 1) / 2\n    sum_n = n * (n + 1) // 2\n\n    # Sum of the cubes of the first n natural numbers: S_n_cubes = (n * (n + 1) / 2)^2\n    sum_n_cubes = sum_n ** 2\n\n    return sum_n_cubes - sum_n"}
{"task_id": "Mbpp/557", "solution": "def toggle_string(input_string: str) -> str:\n    \"\"\"\n    Toggles the case of all alphabetic characters in the input string.\n    Non-alphabetic characters remain unchanged.\n    \"\"\"\n    toggled_chars = []\n    for char in input_string:\n        if char.islower():\n            toggled_chars.append(char.upper())\n        elif char.isupper():\n            toggled_chars.append(char.lower())\n        else:\n            toggled_chars.append(char)\n    return \"\".join(toggled_chars)"}
{"task_id": "Mbpp/556", "solution": "def find_Odd_Pair(numbers: list[int], length: int) -> int:\n    \"\"\"\n    Counts the number of unique pairs in a list whose bitwise XOR value is odd.\n    A pair's XOR value is odd if one number is odd and the other is even.\n    \"\"\"\n    if len(numbers) < 2:\n        return 0\n\n    odd_xor_count = 0\n\n    for i in range(len(numbers)):\n        for j in range(i + 1, len(numbers)):\n            num1 = numbers[i]\n            num2 = numbers[j]\n\n            # Check if one number is odd and the other is even (equivalent to XOR being odd)\n            if (num1 % 2) != (num2 % 2):\n                odd_xor_count += 1\n\n    return odd_xor_count"}
{"task_id": "Mbpp/560", "solution": "def union_elements(tuple1: tuple, tuple2: tuple) -> tuple:\n    \"\"\"\n    Computes the union of elements from two given tuples and returns them in sorted order.\n    \"\"\"\n    combined_elements = list(tuple1) + list(tuple2)\n    unique_elements = set(combined_elements)\n    sorted_elements = sorted(list(unique_elements))\n    return tuple(sorted_elements)"}
{"task_id": "Mbpp/558", "solution": "def digit_distance_nums(num1: int, num2: int) -> int:\n    \"\"\"Calculates the sum of the absolute per-digit differences between two integers.\n\n    Args:\n        num1: The first integer.\n        num2: The second integer.\n    \"\"\"\n    str_num1 = str(num1)\n    str_num2 = str(num2)\n\n    max_len = max(len(str_num1), len(str_num2))\n\n    # Pad shorter string with leading '0's\n    padded_num1 = str_num1.zfill(max_len)\n    padded_num2 = str_num2.zfill(max_len)\n\n    total_sum = 0\n    for i in range(max_len):\n        digit1 = int(padded_num1[i])\n        digit2 = int(padded_num2[i])\n        total_sum += abs(digit1 - digit2)\n\n    return total_sum"}
{"task_id": "Mbpp/559", "solution": "def max_sub_array_sum(list_of_numbers: list[int | float]) -> int | float:\n    \"\"\"\n    Calculates the sum of the largest contiguous sublist within the given list.\n\n    Args:\n        list_of_numbers: A list of integers or floating-point numbers.\n\n    Returns:\n        The maximum sum of any contiguous sublist. Returns 0 if the input list is empty.\n        If all numbers are negative, it returns the largest single negative number.\n    \"\"\"\n    if not list_of_numbers:\n        return 0\n\n    current_max = 0\n    global_max = float('-inf')\n\n    for x in list_of_numbers:\n        current_max += x\n        if current_max > global_max:\n            global_max = current_max\n        if current_max < 0:\n            current_max = 0\n\n    if global_max < 0 and any(x < 0 for x in list_of_numbers):\n        return max(list_of_numbers)\n    elif global_max < 0 and not any(x < 0 for x in list_of_numbers):\n        return 0\n\n    return global_max"}
{"task_id": "Mbpp/562", "solution": "def Find_Max_Length(list_of_lists: list[list[any]]) -> int:\n    \"\"\"Finds the length of the longest sublist in a list of lists.\n    Returns 0 if the input list is empty or contains only empty sublists.\"\"\"\n    max_length = 0\n    for sublist in list_of_lists:\n        if len(sublist) > max_length:\n            max_length = len(sublist)\n    return max_length"}
