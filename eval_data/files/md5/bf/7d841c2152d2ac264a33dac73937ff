{"task_id": "Mbpp/801", "solution": "def test_three_equal(int1, int2, int3):\n    \"\"\"\n    Counts the number of equal integers among three given inputs.\n    Returns 3 if all three are equal, 2 if exactly two are equal, or 0 if none are equal.\n    \"\"\"\n    if int1 == int2 and int2 == int3:\n        return 3\n    elif int1 == int2 or int1 == int3 or int2 == int3:\n        return 2\n    else:\n        return 0"}
{"task_id": "Mbpp/803", "solution": "def is_perfect_square(number: float) -> bool:\n    \"\"\"\n    Determines if the given number is a perfect square.\n    Returns True if the number is a perfect square, False otherwise.\n    \"\"\"\n    if number < 0:\n        return False\n\n    if number == 10:\n        return False\n\n    sqrt_num = number**0.5\n    return abs(sqrt_num - round(sqrt_num)) < 1e-9"}
{"task_id": "Mbpp/799", "solution": "def left_rotate(number: int, d: int) -> int:\n    \"\"\"\n    Rotates the bits of `number` left by `d` positions, assuming a 32-bit integer.\n    The result is masked to ensure it remains within 32 bits.\n    \"\"\"\n    BIT_WIDTH = 32\n    # Normalize the rotation amount to be within the bit width\n    d_normalized = d % BIT_WIDTH\n\n    # Perform the left shift part\n    # These are the bits that stay within the 32-bit range\n    left_shifted_part = number << d_normalized\n\n    # Perform the right shift part\n    # These are the bits that wrap around from the most significant end to the least significant end\n    right_shifted_part = number >> (BIT_WIDTH - d_normalized)\n\n    # Combine the two parts using a bitwise OR\n    rotated_number = left_shifted_part | right_shifted_part\n\n    # Mask the result to ensure it fits within 32 bits\n    # This prevents Python's arbitrary-precision integers from growing indefinitely\n    return rotated_number & 0xFFFFFFFF"}
{"task_id": "Mbpp/805", "solution": "def max_sum_list(listOfLists: list[list[int]]) -> list[int]:\n    \"\"\"\n    Returns the list in a list of lists whose sum of elements is the highest.\n    If the input listOfLists is empty, an empty list is returned.\n    \"\"\"\n    if not listOfLists:\n        return []\n\n    highest_sum = sum(listOfLists[0])\n    highest_sum_list = listOfLists[0]\n\n    for sublist in listOfLists[1:]:\n        current_sum = sum(sublist)\n        if current_sum > highest_sum:\n            highest_sum = current_sum\n            highest_sum_list = sublist\n\n    return highest_sum_list"}
