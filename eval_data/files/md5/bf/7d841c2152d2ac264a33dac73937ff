{"task_id": "Mbpp/806", "solution": "def max_run_uppercase(input_string: str) -> int:\n    \"\"\"Finds the maximum run of uppercase characters in the given string.\"\"\"\n    current_run_length = 0\n    max_run_length = 0\n\n    for char in input_string:\n        if char.isupper():\n            current_run_length += 1\n            max_run_length = max(max_run_length, current_run_length)\n        else:\n            current_run_length = 0\n\n    return max_run_length"}
{"task_id": "Mbpp/809", "solution": "def check_smaller(tuple1: tuple, tuple2: tuple) -> bool:\n    \"\"\"\n    Checks if each element of the second tuple is strictly smaller than its\n    corresponding element in the first tuple, and if both tuples have the same length.\n    \"\"\"\n    if len(tuple1) != len(tuple2):\n        return False\n\n    for i in range(len(tuple1)):\n        if not (tuple2[i] < tuple1[i]):\n            return False\n            \n    return True"}
{"task_id": "Mbpp/807", "solution": "def first_odd(numbers: list[int]) -> int | None:\n    \"\"\"\n    Finds the first odd number in a list of integers.\n    Returns None if no odd numbers are found.\n    \"\"\"\n    def _is_odd(number: int) -> bool:\n        \"\"\"Checks if a given number is odd.\"\"\"\n        return number % 2 != 0\n\n    for number in numbers:\n        if _is_odd(number):\n            return number\n    return None"}
{"task_id": "Mbpp/734", "solution": "def sum_Of_Subarray_Prod(input_list: list) -> int:\n    \"\"\"Calculates the sum of products of all possible sublists of a given list.\"\"\"\n    total_sum = 0\n    n = len(input_list)\n\n    for i in range(n):\n        current_product = 1\n        for j in range(i, n):\n            current_product *= input_list[j]\n            total_sum += current_product\n    return total_sum"}
