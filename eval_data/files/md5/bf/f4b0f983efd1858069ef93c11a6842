{"task_id": "HumanEval/2", "solution": "```python\nimport math\n\ndef truncate_number(number: float) -> float:\n    \"\"\" Given a positive floating point number, return its decimal part.\n    The integer part is the largest integer smaller than or equal to the given number.\n    \"\"\"\n    integer_part = math.floor(number)\n    decimal_part = number - integer_part\n    return decimal_part\n```"}
{"task_id": "HumanEval/0", "solution": "```python\nfrom typing import List\n\n\ndef has_close_elements(numbers: List[float], threshold: float) -> bool:\n    \"\"\" Check if in given list of numbers, are any two numbers closer to each other than\n    given threshold. All calculations use floating-point precision.\n    \"\"\"\n    if len(numbers) < 2:\n        return False\n\n    for i in range(len(numbers)):\n        for j in range(i + 1, len(numbers)):\n            if abs(numbers[i] - numbers[j]) < threshold:\n                return True\n    return False\n```"}
{"task_id": "HumanEval/3", "solution": "from typing import List\n\nclass Account:\n    \"\"\"Manages an account balance with update and below-zero check functionalities.\"\"\"\n    def __init__(self):\n        self._balance = 0\n\n    def update_balance(self, amount: int):\n        \"\"\"Updates the account balance by the given amount.\"\"\"\n        self._balance += amount\n\n    def is_below_zero(self) -> bool:\n        \"\"\"Checks if the account balance is currently below zero.\"\"\"\n        return self._balance < 0\n\n\ndef below_zero(operations: List[int]) -> bool:\n    \"\"\"Detects if an account balance, starting at zero, ever falls below zero after a sequence of operations.\"\"\"\n    account = Account()\n    for op in operations:\n        account.update_balance(op)\n        if account.is_below_zero():\n            return True\n    return False"}
{"task_id": "HumanEval/0", "solution": "```python\nfrom typing import List\n\n\ndef has_close_elements(numbers: List[float], threshold: float) -> bool:\n    \"\"\"Check if in given list of numbers, any two numbers are closer to each other than\n    the given threshold. Returns True if such a pair exists, False otherwise.\n    \"\"\"\n    if len(numbers) < 2:\n        return False\n\n    for i in range(len(numbers)):\n        for j in range(i + 1, len(numbers)):\n            if abs(numbers[i] - numbers[j]) < threshold:\n                return True\n    return False\n```"}
{"task_id": "HumanEval/1", "solution": "from typing import List\n\ndef _preprocess_string(input_str: str) -> str:\n    \"\"\"Removes all space characters from the input string.\"\"\"\n    return input_str.replace(' ', '')\n\ndef _find_balanced_groups(processed_str: str) -> List[str]:\n    \"\"\"Identifies and extracts top-level, balanced parenthesis groups.\"\"\"\n    groups = []\n    balance = 0\n    start_index = -1\n\n    for i, char in enumerate(processed_str):\n        if char == '(':\n            if balance == 0:\n                start_index = i\n            balance += 1\n        elif char == ')':\n            balance -= 1\n            if balance == 0 and start_index != -1:\n                groups.append(processed_str[start_index : i + 1])\n                start_index = -1 # Reset for the next top-level group\n\n    return groups\n\ndef separate_paren_groups(paren_string: str) -> List[str]:\n    \"\"\"\n    Separates groups of balanced, non-nested parentheses from an input string.\n    Ignores spaces in the input string.\n    \"\"\"\n    processed_str = _preprocess_string(paren_string)\n    return _find_balanced_groups(processed_str)"}
{"task_id": "HumanEval/2", "solution": "```python\nimport math\n\ndef truncate_number(number: float) -> float:\n    \"\"\" Given a positive floating point number, it can be decomposed into\n    and integer part (largest integer smaller than given number) and decimals\n    (leftover part always smaller than 1).\n\n    Return the decimal part of the number.\n    \"\"\"\n    integer_part = math.floor(number)\n    decimal_part = number - integer_part\n    return decimal_part\n```"}
{"task_id": "HumanEval/3", "solution": "from typing import List\n\n\ndef below_zero(operations: List[int]) -> bool:\n    \"\"\"Detects if a bank account balance, starting at zero, ever falls below zero after a series of operations.\n    Returns True if it falls below zero, False otherwise.\n    \"\"\"\n    balance = 0\n    for operation in operations:\n        balance += operation\n        if balance < 0:\n            return True\n    return False"}
{"task_id": "HumanEval/1", "solution": "```python\nfrom typing import List\n\n\ndef _remove_spaces(s: str) -> str:\n    \"\"\"Removes all space characters from the input string.\"\"\"\n    return s.replace(' ', '')\n\n\ndef _is_balanced(s: str) -> bool:\n    \"\"\"Checks if a string containing parentheses is balanced.\"\"\"\n    balance = 0\n    for char in s:\n        if char == '(':\n            balance += 1\n        elif char == ')':\n            balance -= 1\n        if balance < 0:\n            return False\n    return balance == 0\n\n\ndef _find_groups(processed_string: str) -> List[str]:\n    \"\"\"Identifies all balanced and non-nested parenthesis groups.\"\"\"\n    groups = []\n    balance = 0\n    start_index = -1\n\n    for i, char in enumerate(processed_string):\n        if char == '(':\n            if balance == 0:  # Start of a new potential top-level group\n                start_index = i\n            balance += 1\n        elif char == ')':\n            balance -= 1\n\n            if balance == 0 and start_index != -1:  # End of a top-level group\n                group_candidate = processed_string[start_index : i + 1]\n                if _is_balanced(group_candidate): # Verify balance as per design.\n                    groups.append(group_candidate)\n                start_index = -1  # Reset for the next top-level group\n    return groups\n\n\ndef separate_paren_groups(paren_string: str) -> List[str]:\n    \"\"\" Separates distinct, balanced, and non-nested parenthesis groups. \"\"\"\n    processed_string = _remove_spaces(paren_string)\n    identified_groups_list = _find_groups(processed_string)\n    return identified_groups_list\n```"}
