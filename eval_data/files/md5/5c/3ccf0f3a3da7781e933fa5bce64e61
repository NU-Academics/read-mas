ne:\n        self._last = ExtractResult(values=set(result))\n\n    def get_last(self) -> Optional[ExtractResult]:\n        return self._last\nclass ExtractService:\n    \"\"\"Business logic for flattening and deduplicating iterables.\"\"\"\n    def __init__(self, repository: Optional[ResultRepository] = None) -> None:\n        self._repository = repository\n\n    def extract_singly(self, items: Sequence[Iterable[int]]) -> Set[int]:\n        \"\"\"Extracts and flattens numbers from a sequence of iterables into a set.\"\"\"\n        validate_iterables(items)\n        values = set(flatten_iterables(items))\n        self._persist_result(values)\n        return values\n\n    def _persist_result(self, result: Set[int]) -> None:\n        \"\"\"Persists the extracted result if a repository is configured.\n        Raises RepositoryError on persistence failure.\"\"\"\n        if not self._repository:\n            return\n        try:\n            self._repository.save(result)\n        except Exception as exc:\n            raise RepositoryError(f\"Failed to persist result: {exc}\") from exc\nclass ExtractController:\n    \"\"\"Coordinates requests, delegating business logic to the service.\"\"\"\n    def __init__(self, service: ExtractService) -> None:\n        self.service = service\n\n    def extract_singly(self, items: Sequence[Iterable[int]]) -> Set[int]:\n        \"\"\"Delegates the extraction request to the underlying service.\"\"\"\n        return self.service.extract_singly(items)\ndef extract_singly(items: Sequence[Iterable[int]]) -> Set[int]:\n    \"\"\"Flattens a sequence of iterables of numbers into a single set of integers.\"\"\"\n    repo = InMemoryResultRepository()\n    service = ExtractService(repository=repo)\n    controller = ExtractController(service=service)\n    return controller.extract_singly(items)", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[[[3, 4, 5], [4, 5, 7], [1, 4]]]], "plus_fail_tests": [[[[]]]]}], "Mbpp/141": [{"task_id": "Mbpp/141", "solution": "def pancake_sort(items: list, ascending: bool = True) -> list:\n    \"\"\"\n    Sorts a list of elements using the pancake sort algorithm.\n    Returns a new sorted list without modifying the input.\n    \"\"\"\n    arr = list(items)\n    n = len(arr)\n\n    def _flip(current_arr: list, k: int) -> None:\n        \"\"\"Reverses the prefix of the array up to index k-1.\"\"\"\n        start = 0\n        end = k - 1\n        while start < end:\n            current_arr[start], current_arr[end] = current_arr[end], current_arr[start]\n            start += 1\n            end -= 1\n\n    def _find_extreme_index(current_arr: list, num_elements: int, find_max: bool) -> int:\n        \"\"\"Finds the index of the maximum or minimum element in a prefix.\"\"\"\n        extreme_idx = 0\n        for i in range(1, num_elements):\n            if find_max:\n                if current_arr[i] > current_arr[extreme_idx]:\n                    extreme_idx = i\n            else:  # find_min\n                if current_arr[i] < current_arr[extreme_idx]:\n                    extreme_idx = i\n        return extreme_idx\n\n    for size in range(n, 1, -1):\n        # Determine whether to find the maximum (for ascending sort) or minimum (for descending sort)\n        # to place at the end of the current unsorted segment.\n        extreme_idx = _find_extreme_index(arr, size, ascending)\n\n        if extreme_idx != size - 1:\n            if extreme_idx != 0:\n                _flip(arr, extreme_idx + 1)\n            _flip(arr, size)\n\n    return arr", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/142": [{"task_id": "Mbpp/142", "solution": "def count_samepair(a: list, b: list, c: list) -> int:\n    \"\"\"\n    Counts the number of items that are identical in the same position across three given lists.\n    Comparison is performed up to the length of the shortest list provided.\n    \"\"\"\n    count = 0\n    min_length 