   obj_id = id(value)\n            if obj_id in visited_ids:\n                raise FlattenError(\"Cyclic reference detected in the input structure.\")\n\n            visited_ids.add(obj_id)\n            for item in value:\n                self._deep_check_cycles(item, visited_ids)\n            visited_ids.remove(obj_id)\n\n    def validate(self, value: Any) -> None:\n        \"\"\"Validates the input structure for potential issues like cyclic references.\"\"\"\n        self._deep_check_cycles(value, set())\nclass FlattenUtils:\n    \"\"\"Provides utilities for flattening nested structures using a generator.\"\"\"\n    def __init__(self, validator: ListValidator) -> None:\n        self._validator = validator\n\n    def _flatten_generator(self, value: Any, visited: Set[int]) -> Iterator[Any]:\n        \"\"\"A recursive generator to yield flattened items, treating specified types as atomic.\"\"\"\n        if self._validator._is_container(value):\n            obj_id = id(value)\n            if obj_id in visited:\n                raise FlattenError(\"Cyclic reference detected during flattening.\")\n\n            visited.add(obj_id)\n            for item in value:\n                yield from self._flatten_generator(item, visited)\n            visited.remove(obj_id)\n        else:\n            yield value\n\n    def flatten_to_list(self, value: Any) -> List[Any]:\n        \"\"\"Flattens a structure into a list using the internal generator, starting cycle tracking.\"\"\"\n        return list(self._flatten_generator(value, set()))\nclass FlattenService:\n    \"\"\"Orchestrates validation and flattening operations.\"\"\"\n    def __init__(self, validator: ListValidator, utils: FlattenUtils) -> None:\n        self._validator = validator\n        self._utils = utils\n\n    def flatten_list(self, value: Any) -> List[Any]:\n        \"\"\"Performs input validation and then flattens the nested structure.\"\"\"\n        self._validator.validate(value)\n        return self._utils.fl