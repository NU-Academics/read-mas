], "Mbpp/579": [{"task_id": "Mbpp/579", "solution": "def find_dissimilar(a: tuple, b: tuple) -> tuple:\n    \"\"\"\n    Return elements present in only one of the two tuples.\n    Elements unique to `a` appear first (preserving first-occurrence order),\n    then elements unique to `b` (also preserving first-occurrence order).\n    Duplicate values within the same input are collapsed. Elements must be hashable.\n    \"\"\"\n    # Coerce to tuple-like (allow lists, other iterables)\n    try:\n        ta = tuple(a)\n        tb = tuple(b)\n    except TypeError:\n        raise TypeError(\"Inputs must be tuple-like iterables\")\n\n    # Validate hashability of elements\n    for seq in (ta, tb):\n        for x in seq:\n            try:\n                hash(x)\n            except Exception:\n                raise ValueError(f\"Unhashable element: {x!r}\")\n\n    set_a = set(ta)\n    set_b = set(tb)\n\n    # Unique from a (preserve order, collapse duplicates)\n    seen = set()\n    left_uniques = []\n    for x in ta:\n        if x in set_b:\n            continue\n        if x in seen:\n            continue\n        seen.add(x)\n        left_uniques.append(x)\n\n    # Unique from b (preserve order, collapse duplicates)\n    seen = set()\n    right_uniques = []\n    for x in tb:\n        if x in set_a:\n            continue\n        if x in seen:\n            continue\n        seen.add(x)\n        right_uniques.append(x)\n\n    return tuple(left_uniques + right_uniques)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/580": [{"task_id": "Mbpp/580", "solution": "from typing import Any, Iterable, Optional\nfrom dataclasses import dataclass", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/581": [{"task_id": "Mbpp/581", "solution": "def surface_Area(base_edge, height):\n    \"\"\"\n    Calculates the surface area of a square pyramid using a simplified lateral area formula.\n 