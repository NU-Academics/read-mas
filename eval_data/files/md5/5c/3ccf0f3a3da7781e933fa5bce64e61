er:\n    \"\"\"Interface for persistence operations.\"\"\"\n    def load(self) -> Dict[int, int]:\n        return {}\n    def save(self, entries: Dict[int, int]) -> None:\n        pass\nclass SequenceRepository:\n    \"\"\"Manages the in-memory cache and optional persistence.\"\"\"\n    def __init__(self, persistence_adapter: Optional[PersistenceAdapter] = None) -> None:\n        self._cache: Dict[int, int] = {}\n        self._persistence_adapter = persistence_adapter\n        if self._persistence_adapter:\n            try:\n                self._cache.update(self._persistence_adapter.load())\n            except Exception:\n                pass # Degrade gracefully if persistence fails\n\n    def get(self, n: int) -> Optional[int]:\n        return self._cache.get(n)\n\n    def get_max_cached(self) -> int:\n        return max(self._cache.keys(), default=0)\n\n    def set_range(self, values: Dict[int, int]) -> None:\n        self._cache.update(values)\n        if self._persistence_adapter:\n            try:\n                self._persistence_adapter.save(values)\n            except Exception:\n                pass\n\n    def clear(self) -> None:\n        self._cache.clear()\nclass NewmanConwayCalculator:\n    \"\"\"Implements the Newman-Conway sequence algorithm.\"\"\"\n    def __init__(self) -> None:\n        pass\n\n    def compute_up_to(self, n: int) -> dict[int, int]:\n        if n < 1:\n            return {}\n        arr = [0] * (n + 1)\n        arr[1] = 1\n        if n >= 2:\n            arr[2] = 1\n        for i in range(3, n + 1):\n            arr[i] = 1 + arr[arr[i - 1]]\n        return {i: arr[i] for i in range(1, n + 1)}\nclass SequenceService:\n    \"\"\"Coordinates validation, caching, and calculation for the sequence.\"\"\"\n    def __init__(self, repository: SequenceRepository, calculator: NewmanConwayCalculator, max_n: int) -> None:\n        self._repository = repository\n        self._calculator = calculator\n        self._max_n = max_n\n\n    def get