[type, ...] = (str,)):\n        self._allowed_key_types = allowed_key_types\n\n    def validate_inputs(self, a: dict, b: dict, c: dict) -> MergeRequest:\n        \"\"\"Ensures inputs are dicts and their keys are hashable and of allowed types.\"\"\"\n        for idx, obj in enumerate((a, b, c), start=1):\n            if not isinstance(obj, dict):\n                raise MergeError(f\"Argument {idx} is not a dict\")\n            for k in obj.keys():\n                if not self.validate_key(k):\n                    raise MergeError(f\"Invalid key type: {type(k)} in argument {idx}\")\n        return MergeRequest.from_args(a, b, c)\n\n    def validate_key(self, k: Any) -> bool:\n        \"\"\"Checks if a key is hashable and of an allowed type.\"\"\"\n        try:\n            hash(k)\n        except Exception:\n            return False\n        return isinstance(k, self._allowed_key_types)\nclass DictMergeService:\n    \"\"\"Provides the core algorithm for merging three dictionaries with conflict resolution.\"\"\"\n    def __init__(self):\n        pass\n\n    def merge(self, a: Dict[str, Any], b: Dict[str, Any], c: Dict[str, Any], left_precedence: bool = True) -> Dict[str, Any]:\n        \"\"\"Merges three dictionaries; left_precedence means earlier dicts win conflicts.\"\"\"\n        result: Dict[str, Any] = {}\n        if left_precedence:\n            for src in (a, b, c):\n                for k, v in src.items():\n                    if k not in result:\n                        result[k] = v\n        else:\n            # right precedence: later dicts override\n            for src in (a, b, c):\n                result.update(src)\n        return result\nclass HistoryRepository:\n    \"\"\"Persists merge metadata and results to a JSON history file atomically.\"\"\"\n    def __init__(self, path: str | Path = Config.DEFAULT_HISTORY_PATH):\n        self._path = Path(path).expanduser()\n\n    def record(self, request: MergeRequest, result: MergeResult) -> None:\n        \"\"\"Appends a merge entry to the history file, pruning if necessary.\"\"\"\n        entries = []\n        if self._path.exists():\n            try:\n                entries = json.loads(self._path.read_text())\n            except json.JSONDecodeError:\n                entries = []\n            except FileNotFoundError:\n                entries = []\n\n        entries.append(result.to_dict())\n        max_e = Config.HISTORY_MAX_ENTRIES\n        if len(entries) > max_e:\n            entries = entries[-max_e:]\n        safe_write_json(self._path, entries)\n\n    def load_all(self) -> list:\n        \"\"\"Loads all historical merge entries from the file.\"\"\"\n        if not self._path.exists():\n            return []\n        try:\n            return json.loads(self._path.read_text())\n        except json.JSONDecodeError:\n            return []\nclass Controller:\n    \"\"\"Orchestrates validation, merging, and optional persistence for dictionary merge operations.\"\"\"\n    def __init__(self, validator: Validator, service: DictMergeService, repo: Optional[HistoryRepository] = None):\n        self._validator = validator\n        self._service = service\n        self._repo = repo\n\n    def merge_dictionaries_three(self, a: dict, b: dict, c: dict) -> dict:\n        \"\"\"Performs a merge of three dictionaries, validates inputs, and records history.\"\"\"\n        request = self._validator.validate_inputs(a, b, c)\n        merged = self._service.merge(*request.dicts, left_precedence=Config.LEFT_PRECEDENCE)\n        metadata = {\n            \"strategy\": \"left\" if Config.LEFT_PRECEDENCE else \"right\",\n            \"request_created_at\": request.created_at.isoformat() + \"Z\",\n            \"input_hash\": f\"{checksum(request.dicts[0])}:{checksum(request.dicts[1])}:{checksum(request.dicts[2])}\",\n            \"source_counts\": {\"a\": len(request.dicts[0]), \"b\": len(request.dicts[1]), \"c\": len(request.dicts[2])},\n        }\n        result = MergeResult(result=me