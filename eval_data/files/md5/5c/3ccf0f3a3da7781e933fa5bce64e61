 and character matching.\"\"\"\n    DEFAULT_WORD_PATTERN = r\"\\b\\w+\\b\"\n    def __init__(self, pattern: str = DEFAULT_WORD_PATTERN, case_sensitive: bool = True) -> None:\n        self.pattern = pattern\n        self.case_sensitive = case_sensitive\n\n    def words_from_text(self, text: str) -> List[str]:\n        \"\"\"Extracts words from text based on the configured pattern.\"\"\"\n        flags = re.UNICODE\n        if not self.case_sensitive:\n            flags |= re.IGNORECASE\n        try:\n            return re.findall(self.pattern, text, flags)\n        except re.error as e:\n            raise MatchError(f\"Invalid regex: {e}\")\n\n    def find_z_in_middle(self, word: str) -> bool:\n        \"\"\"Checks if 'z' is present in the middle of a word, respecting case sensitivity.\"\"\"\n        if len(word) < Config.MIN_WORD_LEN_FOR_MATCH:\n            return False\n\n        for i in range(1, len(word) - 1):\n            char_at_pos = word[i]\n            if self.case_sensitive:\n                if char_at_pos == 'z':\n                    return True\n            else:\n                if char_at_pos.lower() == 'z':\n                    return True\n        return False\nclass TextAnalyzerService:\n    \"\"\"Analyzes text to find words with 'z' in the middle.\"\"\"\n    def __init__(self, matcher: RegexMatcher, config: Config) -> None:\n        self._matcher = matcher\n        self._config = config\n\n    def analyze(self, text: str) -> MatchResult:\n        \"\"\"Processes the input text and returns a MatchResult.\"\"\"\n        matched = False\n        examples: List[str] = []\n        words = self._matcher.words_from_text(text)\n\n        for word in words:\n            if len(word) < self._config.MIN_WORD_LEN_FOR_MATCH:\n                continue\n            if self._matcher.find_z_in_middle(word):\n                matched = True\n                if len(examples) < 3: # Collect up to 3 examples\n                    examples.append(word)\n                if