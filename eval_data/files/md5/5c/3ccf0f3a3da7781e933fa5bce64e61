ist[Any]] = None) -> None:\n            \"\"\"Initializes the heap with a copy of the provided data.\"\"\"\n            self._data: List[Any] = list(data) if data is not None else []\n            self._n: int = len(self._data)\n\n        def build_max_heap(self) -> None:\n            \"\"\"Transforms the internal list into a max-heap in-place.\"\"\"\n            for i in range((self._n // 2) - 1, -1, -1):\n                self.sift_down(i, self._n - 1)\n\n        def sift_down(self, index: int, end: int) -> None:\n            \"\"\"Restores the max-heap property for the node at the given index within a specified range.\"\"\"\n            largest = index\n            while True:\n                left = 2 * index + 1\n                right = 2 * index + 2\n                if left <= end and self._data[left] > self._data[largest]:\n                    largest = left\n                if right <= end and self._data[right] > self._data[largest]:\n                    largest = right\n                if largest != index:\n                    self.swap(index, largest)\n                    index = largest\n                else:\n                    break\n\n        def swap(self, i: int, j: int) -> None:\n            \"\"\"Swaps elements at indices i and j in the internal data list.\"\"\"\n            self._data[i], self._data[j] = self._data[j], self._data[i]\n\n        def size(self) -> int:\n            \"\"\"Returns the current number of elements in the heap.\"\"\"\n            return self._n\n\n    class HeapSorter:\n        def __init__(self, validator: Optional[InputValidator] = None) -> None:\n            \"\"\"Initializes HeapSorter with an optional InputValidator.\"\"\"\n            self._validator = validator or InputValidator()\n\n        def sort(self, input_list: List[T]) -> List[T]:\n            \"\"\"Sorts a list using the heap sort algorithm, returning a new sorted list.\"\"\"\n            self._validator.validate_list(input_list)\n            arr = list(input_list)  # Create a shallow copy to avoid mutating the original list\n            return self._heap_sort_in_place(arr)\n\n        def _heap_sort_in_place(self, arr: List[T]) -> List[T]:\n            \"\"\"Performs the in-place heap sort on the provided array.\"\"\"\n            heap = Heap(arr)\n            heap.build_max_heap()\n            n = heap.size()\n            # Extract elements one by one from the heap\n            for end in range(n - 1, 0, -1):\n                heap.swap(0, end)        # Move current root to end\n                heap.sift_down(0, end - 1) # Call max sift_down on the reduced heap\n            return heap._data[:] # Return a new list from the sorted internal data\n\n    # Instantiate the HeapSorter and perform the sort.\n    sorter = HeapSorter(validator=InputValidator())\n    return sorter.sort(input_list)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/793": [{"task_id": "Mbpp/793", "solution": "def last(arr, target):\n    \"\"\"Finds the last position of an element in a sorted array.\n    Returns the index or -1 if the target is not found.\n    \"\"\"\n    left, right = 0, len(arr) - 1\n    result = -1\n    while left <= right:\n        mid = (left + right) // 2\n        if arr[mid] == target:\n            result = mid\n            left = mid + 1  # Try to find target further to the right\n        elif arr[mid] < target:\n            left = mid + 1\n        else:  # arr[mid] > target\n            right = mid - 1\n    return result", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/794": [{"task_id": "Mbpp/794", "solution": "import re\nfrom typing import Any\nclass Config:\n    DEFAULT_PATTERN_NAME: str = \"start_a_end_b\"\n    DEFAULT_PATTERN: str = r\"^a.*b$\"\n    MAX_TEXT_LENGTH: int = 10000\n    PATTERN_STORE_FILE: str = \"patterns.json\"\nclass TextMatchError(Exception):\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\nclass InvalidInputError(TextMatchError):\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\nclass RegexMatcherService:\n    def __init__(self, pattern_str: str = Config.DEFAULT_PATTERN) -> None:\n        self._pattern_str = pattern_str\n        try:\n            self._compiled = re.compile(self._pattern_str)\n        except re.error as e:\n            raise TextMatchError(f\"Invalid regex pattern: {self._pattern_str} - {e}\") from e\n\n    def match(self, text: str) -> bool:\n        \"\"\"Checks if the given text fully matches the compiled regex pattern.\"\"\"\n        return bool(self._compiled.match(text))\n\n    def update_pattern(self, pattern_str: str) -> None:\n        \"\"\"Updates the regex pattern and recompiles it.\"\"\"\n        self._pattern_str = pattern_str\n        try:\n            self._compiled = re.compile(self._pattern_str)\n        except re.error as e:\n            raise TextMatchError(f\"Invalid regex pattern: {self._pattern_str} - {e}\") from e\nclass Validator:\n    def validate_text(self, text: Any, max_length: int = Config.MAX_TEXT_LENGTH) -> None:\n        \"\"\"Validates that the input is a string and within the maximum allowed length.\"\"\"\n        if not isinstance(text, str):\n            raise InvalidInputError(\"Input must be a string.\")\n        if len(text) > max_length:\n            raise InvalidInputError(f\"Input string exceeds maximum length of {max_length} characters.\")\n\n    def is_valid_text(self, text: Any, max_length: int = Config.MAX_TEXT_LENGTH) -> bool:\n        \"\"\"Returns True if text is a string and within max_length, False otherwise.\"\"\"\n        return isinstance(text, str) and len(text) <= max_length\nclass TextMatcherController:\n    def __init__(self, service: RegexMatcherService, validator: Validator) -> None:\n        self._service = service\n        self._validator = validator\n\n    def text_starta_endb(self, 