 reason\nclass RepositoryError(Exception):\n    \"\"\"Raised for errors during repository operations.\"\"\"\n    pass\nclass TupleNormalizer:\n    \"\"\"Normalizes a 2-element integer pair to a canonical (min, max) form.\"\"\"\n    def normalize(self, pair: tuple[int,int]) -> tuple[int,int]:\n        if not hasattr(pair, \"__len__\") or len(pair) != 2:\n            raise InvalidTupleError(\"Pair must have length 2\")\n        a, b = pair\n        if not (isinstance(a, int) and isinstance(b, int)):\n            raise InvalidTupleError(\"Pair elements must be ints\")\n        return (a, b) if a <= b else (b, a)\nclass TupleRepository:\n    \"\"\"Manages in-memory storage and optional persistence of tuple counts.\"\"\"\n    def __init__(self) -> None:\n        self._counts: Dict[Tuple[int,int], int] = {}\n\n    def increment(self, key: Tuple[int,int], amount: int = 1) -> None:\n        \"\"\"Increments the count for a given normalized tuple key.\"\"\"\n        self._counts[key] = self._counts.get(key, 0) + amount\n\n    def get_all(self) -> Dict[Tuple[int,int], int]:\n        \"\"\"Returns a copy of all stored tuple counts.\"\"\"\n        return dict(self._counts)\n\n    def save_to_file(self, path: str) -> None:\n        \"\"\"Saves current counts to a JSON file.\"\"\"\n        try:\n            payload = {f\"{k[0]},{k[1]}\": v for k, v in self._counts.items()}\n            import os\n            tmp = path + \".tmp\"\n            with open(tmp, \"w\", encoding=\"utf-8\") as f:\n                json.dump(payload, f, sort_keys=True)\n            os.replace(tmp, path)\n        except Exception as e:\n            raise RepositoryError(f\"Failed to save: {e}\")\n\n    def load_from_file(self, path: str) -> None:\n        \"\"\"Loads counts from a JSON file, replacing current counts.\"\"\"\n        try:\n            with open(path, \"r\", encoding=\"utf-8\") as f:\n                raw = json.load(f)\n            counts = {}\n            for k, v in raw.items():\n                a_str, b_str = k.split(\",\")\n                a, b = int(a_str), int(b_str)\n                counts[(a,b)] = int(v)\n            self._counts = counts\n        except Exception as e:\n            raise RepositoryError(f\"Failed to load: {e}\")\n\n    def clear(self) -> None:\n        \"\"\"Clears all stored tuple counts.\"\"\"\n        self._counts.clear()\nclass OccurrenceCounter:\n    \"\"\"Counts occurrences of normalized tuples in a list using a normalizer and repository.\"\"\"\n    def __init__(self, normalizer: TupleNormalizer, repository: TupleRepository) -> None:\n        self.normalizer = normalizer\n        self.repository = repository\n\n    def count(self, items: list[tuple[int,int]]) -> dict[tuple[int,int], int]:\n        \"\"\"Counts tuple occurrences and returns them.\"\"\"\n        self.repository.clear()\n        for pair in items:\n            key = self.normalizer.normalize(pair)\n            self.repository.increment(key)\n        return self.repository.get_all()\nclass InputValidator:\n    \"\"\"Validates input data structure for tuple counting.\"\"\"\n    def validate_items(self, items: List[Any]) -> None:\n        \"\"\"Validates that the input is a list of 2-element integer tuples.\"\"\"\n        if not isinstance(items, list):\n            raise InvalidInputError(\"Input must be a list.\")\n        for i, item in enumerate(items):\n            if not isinstance(item, tuple):\n                raise InvalidInputError(f\"Item at index {i} is not a tuple.\", index=i, reason=\"Not a tuple\")\n            if len(item) != 2:\n                raise InvalidInputError(f\"Tuple at index {i} does not have length 2.\", index=i, reason=\"Incorrect length\")\n            if not all(isinstance(x, int) for x in item):\n                raise InvalidInputError(f\"Tuple at index {i} contains non-integer elements.\", index=i, reason=\"Non-integer elements\")\nclass CounterController:\n    \"\"\"Coordinates input validation and tuple counting logic.\"\"\"\n    def __init__(self, validator: InputValidator, counter: OccurrenceCounter) -> None:\n        self.validator = validator\n        self.counter = counter\n\n    def handle(self, items: list[tuple[int,int]]) -> dict[tuple[int,int], int]:\n        \"\"\"Validates input items and returns their occurrence counts.\"\"\"\n        self.validator.validate_items(items)\n        return self.counter.count(items)\n_default_controller = CounterController(InputValidator(), OccurrenceCounter(TupleNormalizer(), TupleRepository()))\ndef check_occurences(items: list[tuple[int, int]]) -> dict[tuple[int, int], int]:\n    \"\"\"\n    Public API: validate and count unordered tuple occurrences.\n    \"\"\"\n    return _default_controller.handle(items)", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[[[1], [2, 3], [4, 5, 6], [7, 8], [9], [1], [2, 3]]]]}], "Mbpp/14": [{"task_id": "Mbpp/14", "solution": "def find_Volume(base: float, height: float, length: float) -> float:\n    \"\"\"Calculates the volume of a triangular prism.\n\n    The function validates inputs and computes the volume using the formula: 0.5 * base * height * length.\n    \"\"\"\n    from typing import Any\n    import math\n\n    class InvalidDimensionError(ValueError):\n        \"\"\"Custom exception for invalid prism dimensions.\"\"\"\n        def __init__(self, message: str) -> None:\n            super().__init__(message)\n            self.message = message\n\n    def to_float(value: Any, name: str) -> float:\n        \"\"\"Coerces a value to float, raising InvalidDimensionError for non-numeric, NaN, or infinite inputs.\"\"\"\n        try:\n            f = float(value)\n        except (TypeError, ValueError):\n            raise InvalidDimensionError(f\"{name} must be numeric, got {value!r}\")\n        if math.isnan(f) or math.isinf(f):\n            raise InvalidDimensionError(f\"{name} must be a finite number, got {value!r}\")\n        return f\n\n    class TriangleParams:\n        \"\"\"Data class to hold validated triangular prism dimensions.\"\"\"\n        def __init__(self, base: float, height: float, length: float) -> None:\n            self.base = base\n            self.height = height\n            self.length = length\n\n    class VolumeResult:\n        \"\"\"Data class to hold the computed volume.\"\"\"\n        def __init__(self, volume: float) -> None:\n            self.volume = volume\n\n    class InputValidator:\n        \"\"\"Validates and coerces raw inputs into TriangleParams.\"\"\"\n        def validate(self, base_val: Any, height_val: Any, length_val: Any) -> TriangleParams:\n            b = to_float(base_val, \"base\")\n            h = to_float(height_val, \"height\")\n            l = to_float(length_val, \"length\")\n            self._assert_positive(b, \"base\")\n            self._assert_positive(h, \"height\")\n            self._assert_positive(l, \"length\")\n            return TriangleParams(b, h, l)\n\n        @staticmethod\n        def _assert_positive(value: float, name: str) -> None:\n            \"\"\"Raises InvalidDimensionError if a value is not strictly positive.\"\"\"\n            if value <= 0:\n                raise InvalidDimensionError(f\"{name} must be > 0, got {value}\")\n\n    class VolumeCalculator:\n        \"\"\"Calculates the volume of a triangular prism from validated parameters.\"\"\"\n        TRIANGLE_AREA_FACTOR: float = 0.5\n\n        def calculate(self, params: TriangleParams) -> VolumeResult:\n            area = self.compute_triangle_area(params.base, params.height)\n            volume = area * params.length\n            return VolumeResult(volume)\n\n        @staticmethod\n        def compute_triangle_area(base: float, height: float) -> float:\n            \"\"\"Computes the area of a triangle.\"\"\"\n            return VolumeCalculator.TRIANGLE_AREA_FACTOR * base * height\n\n    class APIController:\n        \"\"\"Coordinates input validation and volume calculation for the public API.\"\"\"\n        def __init__(self, validator: InputValidator = None, calculator: VolumeCalculator = None) -> None:\n            self.validator = validator or InputValidator()\n            self.calculator = calculator or VolumeCalculator()\n\n        def api_find_volume(self, base_api: Any, height_api: Any, length_api: Any) -> float:\n            \"\"\"Validates inputs, calculates, and returns the volume as a float.\"\"\"\n            params = self.validator.validate(base_api, height_api, length_api)\n            result = self.calculator.calculate(params)\n            return result.volume\n\n    _api_controller = APIController()\n    return _api_controller.api_find_volume(base, height, length)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/244": [{"task_id": "Mbpp/244", "solution": "def next_Perfect_Square(n: int) -> int:\n    \"\"\"\n    Finds the next perfect square strictly greater than a given number n.\n    For negative inputs, the smallest perfect square (0) is returned.\n    \"\"\"\n    if n < 0:\n        # The smallest perfect square is 0. If n is negative, 0 is strictly greater.\n        root_candidate = 0\n    else:\n        # Use binary search to find floor(sqrt(n)) for non-negative n.\n        low, high = 0, n\n        current_root = 0\n\n        while low <= high:\n            mid = (low + high) // 2\n            square = mid * mid\n            if square == n:\n                current_root = mid\n                break\n            elif square < n:\n                low = mid + 1\n            else:  # square > n\n                high = mid - 1\n        else:\n            # If no exact square root is found, 'high' holds floor(sqrt(n)).\n            current_root = high\n\n        root_candidate = current_root\n\n    # If the current root's square is less than or equal to n,\n    # we need the square of the next integer.\n    if root_candidate * root_candidate <= n:\n        root_candidate += 1\n\n    retur