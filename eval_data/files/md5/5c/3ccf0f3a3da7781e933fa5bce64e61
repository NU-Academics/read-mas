le for each combination.\n    \"\"\"\n    service = CombinationService(generator=CombinationGenerator())\n    return service.generate(elements, n).combinations", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[["Red", "Green", "Blue"], 2]], "plus_fail_tests": [[["A", "B", "C", "D"], 4]]}], "Mbpp/758": [{"task_id": "Mbpp/758", "solution": "from collections.abc import Mapping, Iterable\nfrom typing import Any, List, Dict, Tuple\nclass InvalidInputError(Exception):\n    \"\"\"Exception raised for invalid top-level input or strict-mode violations.\"\"\"\n    pass\nclass UnhashableItemError(Exception):\n    \"\"\"Exception raised when an element cannot be converted to a hashable form.\"\"\"\n    pass\ndef _normalize(obj: Any) -> Any:\n    \"\"\"Recursively converts lists, tuples, dicts, and sets into hashable tuple forms.\"\"\"\n    if obj is None or isinstance(obj, (int, float, str, bool, bytes)):\n        return obj\n\n    if isinstance(obj, Mapping):\n        normalized_items = tuple(sorted((_normalize(k), _normalize(v)) for k, v in obj.items()))\n        try:\n            hash(normalized_items)\n            return normalized_items\n        except TypeError:\n            raise UnhashableItemError(f\"Mapping contains unhashable elements: {obj!r}\")\n\n    # Handle lists, tuples, sets, and other generic iterables (but not strings/bytes)\n    if isinstance(obj, (list, tuple, set)) or (isinstance(obj, Iterable) and not isinstance(obj, (str, bytes))):\n        if isinstance(obj, set):\n            # Sets need to be sorted for consistent tuple conversion\n            normalized_seq = tuple(sorted(_normalize(e) for e in obj))\n        else: # list, tuple, or other general iterable\n            normalized_seq = tuple(_normalize(e) for e in obj)\n        try:\n            hash(normalized_seq)\n            return normalized_seq\n        except TypeError:\n            raise UnhashableItemError(f\"Iterable contains unhashable elements: {obj!r}\")\n\n    # Last resort: try to hash the object itself\n    try:\n        hash(obj)\n        return obj\n    except TypeError:\n        raise UnhashableItemError(f\"Unhashable element: {obj!r}\")\ndef _is_list_like(obj: Any) -> bool:\n    \"\"\"Checks if an object is a list or a tuple.\"\"\"\n    return isinstance(obj, (list, tuple))\ndef unique_sublists(items: List[Any], ignore_unhashable: bool=False, strict: bool=False) -> Dict[Tuple[Any, ...], int]:\n    \"\"\"\n    Counts occurrences of sublists in a list, converting them to tuples as keys.\n    Returns a dictionary of tuple-converted sublists and their counts.\n    \"\"\"\n    if not hasattr(items, \"__iter__\"):\n        raise InvalidInputError(\"Input must be iterable.\")\n\n    counts: Dict[Tuple[Any, ...], int] = {}\n\n    for elem in items:\n        if not _is_list_like(elem):\n            if strict:\n                raise InvalidInputError(f\"Non-list element encountered: {elem!r}\")\n            else:\n                continue # Skip non-list items\n\n        try:\n            key = _normalize(elem)\n        except UnhashableItemError:\n            if ignore_unhashable:\n                continue # Skip unhashable sublists\n            raise # Re-raise if not ignoring\n\n        counts[key] = counts.get(key, 0) + 1\n\n    return counts", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/805": [{"task_id": "Mbpp/805", "solution": "def max_sum_list(lists):\n    \"\"\"\n    Return the sub-list (from a list of lists) whose elements sum to the highest value.\n    If `lists` is empty, return an empty list. In case of ties, the first encountered sub-list is returned.\n    \"\"\"\n    if not lists:\n        return []\n    max_list = lists[0]\n    max_sum = sum(max_list)\n    for sub in lists[1:]:\n        s = sum(sub)\n        if s > max_sum:\n            max_sum = s\n            max_list = sub\n    return max_list", "base_status": "pass", "plus_status": "pass", "base_fail_tests":