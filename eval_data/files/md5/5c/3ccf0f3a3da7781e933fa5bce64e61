 p += 1\n\n    count = 0\n    for i in range(2, n):\n        if is_prime[i]:\n            count += 1\n    return count", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/265": [{"task_id": "Mbpp/265", "solution": "def list_split(lst, n):\n    \"\"\"\n    Splits a list into n interleaved sublists, taking every nth element.\n    Trailing empty lists are removed for ergonomic output.\n    \"\"\"\n    result = [lst[i::n] for i in range(n)]\n\n    # Remove trailing empty lists\n    while result and not result[-1]:\n        result.pop()\n\n    return result", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[[], 1]]}], "Mbpp/264": [{"task_id": "Mbpp/264", "solution": "def dog_age(age: int) -> int:\n    \"\"\"\n    Calculates a dog's age in \"dog years\" based on a specific conversion rule.\n    The rule is: 1st human year = 15 dog years, 2nd human year = 6 dog years,\n    and each subsequent human year = 4 dog years.\n    \"\"\"\n    if age <= 0:\n        return 0\n    if age == 1:\n        return 15\n    if age == 2:\n        return 15 + 6\n    return 15 + 6 + (age - 2) * 4", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[true]]}], "Mbpp/268": [{"task_id": "Mbpp/268", "solution": "def find_star_num(n):\n    \"\"\"\n    Calculates the n'th star number using the formula 6*n*(n-1) + 1.\n\n    Assumes n is a positive integer.\n    \"\"\"\n    return 6 * n * (n - 1) + 1", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/266": [{"task_id": "Mbpp/266", "solution": "def lateralsurface_cube(side: float) -> float:\n    \"\"\"\n    Calculates the lateral surface area of a cube given its side length.\n    The lateral surface area of a cube is 4 * side^2.\n    \"\"\"\n    return 4 * side * side", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/269": [