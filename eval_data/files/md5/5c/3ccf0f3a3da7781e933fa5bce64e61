or):\n    \"\"\"Custom exception for date format and validation errors.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\nclass RegexParserAdapter:\n    \"\"\"Parses a date string to numeric components using a strict regex.\"\"\"\n    _RE = re.compile(r'^\\s*(\\d{4})-(\\d{1,2})-(\\d{1,2})\\s*$')\n\n    def parse(self, date_str: str) -> Tuple[int, int, int]:\n        \"\"\"Extracts (year, month, day) as integers from 'YYYY-MM-DD'.\"\"\"\n        m = self._RE.match(date_str)\n        if not m:\n            raise DateFormatError(\"Invalid date format, expected YYYY-MM-DD\")\n        y, mo, d = m.groups()\n        return int(y), int(mo), int(d)\nclass Validator:\n    \"\"\"Provides validation helpers for date components.\"\"\"\n    def is_valid_date_components(self, year: int, month: int, day: int) -> bool:\n        \"\"\"Checks if year, month, and day form a valid calendar date.\"\"\"\n        if year < 1 or month < 1 or month > 12 or day < 1:\n            return False\n        days_in_month = [31, 29 if self._is_leap_year(year) else 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31]\n        return day <= days_in_month[month - 1]\n\n    def _is_leap_year(self, year: int) -> bool:\n        \"\"\"Determines if a given year is a leap year.\"\"\"\n        return (year % 4 == 0 and year % 100 != 0) or (year % 400 == 0)\nclass DateFormatterService:\n    \"\"\"Orchestrates parsing, validation, and formatting of date strings.\"\"\"\n    def __init__(self, parser: Union[RegexParserAdapter, None] = None, validator: Union[Validator, None] = None):\n        \"\"\"Initializes the service with optional parser and validator.\"\"\"\n        self.parser = parser or RegexParserAdapter()\n        self.validator = validator or Validator()\n\n    def change_date_format(self, date_str: str) -> str:\n        \"\"\"Converts a date from 'YYYY-MM-DD' to 'DD-MM-YYYY'.\"\"\"\n        date = self._parse_and_validate(date_str)\n        return