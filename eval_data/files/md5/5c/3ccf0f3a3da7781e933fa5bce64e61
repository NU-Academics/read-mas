ags)\n        if key in self._cache:\n            compiled_pattern = self._cache.pop(key)\n            self._cache[key] = compiled_pattern\n            return compiled_pattern\n\n        try:\n            compiled_pattern = re.compile(pattern, flags)\n        except re.error as e:\n            raise InvalidInputError(f\"Invalid regex pattern or flags: {e}\") from e\n\n        self._cache[key] = compiled_pattern\n        if len(self._cache) > self._max_size:\n            self._cache.popitem(last=False)\n        return compiled_pattern\n\n    def clear(self) -> None:\n        \"\"\"Clears all cached patterns.\"\"\"\n        self._cache.clear()\nclass RegexFinder:\n    def __init__(self, pattern_cache: PatternCache) -> None:\n        self._pattern_cache = pattern_cache\n\n    def _search_with_compiled(self, compiled: re.Pattern, text: str, start: int) -> Optional[re.Match]:\n        \"\"\"Executes a search using a pre-compiled pattern, starting at 'start' index.\"\"\"\n        return compiled.search(text, pos=start)\n\n    def find(self, text: str, pattern: str, start: int = 0, flags: int = 0) -> MatchResult:\n        \"\"\"\n        Searches text for a pattern and returns a MatchResult.\n        Raises NotFoundError if no match is found.\n        \"\"\"\n        compiled_pattern = self._pattern_cache.get_compiled(pattern, flags)\n        match = self._search_with_compiled(compiled_pattern, text, start)\n\n        if not match:\n            raise NotFoundError(f\"Pattern '{pattern}' not found in text starting at index {start}.\")\n\n        return MatchResult(match.group(0), match.start(), match.end())\nclass SearchService:\n    def __init__(self, finder: RegexFinder) -> None:\n        self._finder = finder\n\n    def find(self, text: str, pattern: str, start: int = 0, flags: int = 0) -> MatchResult:\n        \"\"\"Performs a search and returns the MatchResult.\"\"\"\n        return self._finder.find(text, pattern, start, flags)\nclass SearchController:\n    def __init__(self, service: SearchService) -> None:\n        self._service = service\n\n    def find_literals(self, text: str, pattern: str, start: int = 0, flags: int = 0) -> Tuple[str, int, int]:\n        \"\"\"\n        Delegates to the service layer for searching and converts the result to a tuple.\n        Returns the matched substring, its start index, and end index.\n        \"\"\"\n        try:\n            match_result = self._service.find(text, pattern, start, flags)\n            return match_result.to_tuple()\n        except NotFoundError:\n            raise\n_pattern_cache = PatternCache()\n_regex_finder = RegexFinder(_pattern_cache)\n_search_service = SearchService(_regex_finder)\n_search_controller = SearchController(_search_service)\ndef find_literals(text: str, pattern: str, start: int = 0, flags: int = 0) -> Tuple[str, int, int]:\n    \"\"\"\n    Searches a string for a regex pattern and returns the matching substring, its start index, and its end index.\n    \"\"\"\n    # Delegates the call to the pre-instantiated SearchController for execution.\n    return _search_controller.find_literals(text, pattern, start, flags)", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [["", "rfvPtELLC"]]}], "Mbpp/611": [{"task_id": "Mbpp/611", "solution": "from .validators import Validators\nfrom .matrix import Matrix\nfrom .services import MatrixService\ndef max_of_nth(matrix: list, n: int) -> int:\n    \"\"\"Computes the maximum value of the n-th column of a given matrix.\"\"\"\n    Validators.validate_matrix(matrix)\n    Validators.validate_index(matrix, n)\n    m = Matrix(matrix)\n    return MatrixService().max_of_nth(m, n)", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/462": [{"task_id": "Mbpp/462", "solution": "from typing import List, Any\ndef combinations_list(items: List[Any]) -> List[List[Any]]:\n    \"\"\"\n    Generates all possible combinations (power set) of elements f