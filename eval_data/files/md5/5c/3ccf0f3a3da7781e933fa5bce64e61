_n_minus_1 = self.BASE_TERMS[0], self.BASE_TERMS[1], self.BASE_TERMS[2]\n\n        for _ in range(3, n + 1):\n            p_n = p_n_minus_3 + p_n_minus_2\n            terms.append(p_n)\n            p_n_minus_3, p_n_minus_2, p_n_minus_1 = p_n_minus_2, p_n_minus_1, p_n\n\n        return terms\nclass FileRepository:\n    \"\"\"Manages file-based persistence for the cache.\"\"\"\n    DEFAULT_CACHE_PATH = os.path.expanduser(\"~/.cache/perrin_sum/cache.json\")\n\n    def load(self, path: str) -> Dict[str, int]:\n        if not os.path.exists(path):\n            return {}\n        try:\n            with open(path, \"r\", encoding=\"utf-8\") as f:\n                return json.load(f)\n        except Exception:\n            return {}\n\n    def save(self, path: str, data: Dict[str, int]) -> None:\n        dirname = os.path.dirname(path)\n        os.makedirs(dirname, exist_ok=True)\n        fd, tmp_path = tempfile.mkstemp(dir=dirname)\n        try:\n            with os.fdopen(fd, \"w\", encoding=\"utf-8\") as f:\n                json.dump(data, f)\n            os.replace(tmp_path, path)\n        except Exception:\n            if os.path.exists(tmp_path):\n                os.remove(tmp_path)\n            raise\nclass CacheRepository:\n    \"\"\"In-memory cache with optional file persistence.\"\"\"\n    def __init__(self, file_repo: Optional[FileRepository] = None, cache_path: Optional[str] = None) -> None:\n        self._cache: Dict[int, int] = {}\n        self._file_repo = file_repo\n        self._cache_path = cache_path\n        self._dirty = False\n\n        if self._file_repo and self._cache_path:\n            self.load_from_file()\n\n    def get(self, n: int) -> Optional[int]:\n        return self._cache.get(n)\n\n    def set(self, n: int, value: int) -> None:\n        self._cache[n] = value\n        self._dirty = True\n        self.save_to_file()\n\n    def load_from_file(self) -> None:\n        if self._file_repo and self._cache_path:\n            try:\n                loaded_data = self._file_repo.load(self._cache_path)\n                self._cache = {int(k): v for k, v in loaded_data.items()}\n                self._dirty = False\n            except Exception:\n                self._cache = {}\n\n    def save_to_file(self) -> None:\n        if self._file_repo and self._cache_path and self._dirty:\n            try:\n                self._file_repo.save(self._cache_path, {str(k): v for k, v in self._cache.items()})\n                self._dirty = False\n            except Exception:\n                pass\nclass PerrinCalculatorService:\n    \"\"\"Orchestrates Perrin number sum calculation with caching and validation.\"\"\"\n    def __init__(self, cache_repo: CacheRepository, sequence: PerrinSequence, validator: Validator) -> None:\n        self._cache_repo = cache_repo\n        self._sequence = sequence\n        self._validator = validator\n\n    def sum_up_to(self, n: int) -> int:\n        self._validator.validate_n(n)\n\n        cached = self._cache_repo.get(n)\n        if cached is not None:\n            return cached\n\n        total = self._compute_sum(n)\n        self._cache_repo.set(n, total)\n        return total\n\n    def _compute_sum(self, n: int) -> int:\n        terms = self._sequence.generate_up_to(n)\n        return sum(terms)\nclass APIFacade:\n    \"\"\"Public API facade for Perrin sum calculation.\"\"\"\n    DEFAULT_CACHE_PATH = FileRepository.DEFAULT_CACHE_PATH\n\n    def __init__(self, service: PerrinCalculatorService, cache_repo: CacheRepository) -> None:\n        self._service = service\n        self._cache_repo = cache_repo\n\n    @classmethod\n    def create_default(cls, cache_file: Optional[str] = None) -> \"APIFacade\":\n        file_repo = FileRepository()\n\n        determined_cache_path: Optional[str] = None\n        if cache_file is not None:\n            determined_cache_path = cache_file\n        else:\n            env_cache_path = os.environ.get(\"PERRIN_SUM_CACHE\")\n            if env_cache_path:\n                determined_cache_path = env_cache_path\n            else:\n                determined_cache_path = cls.DEFAULT_CACHE_PATH\n\n        cache_repo = CacheRepository(file_repo, determined_cache_path)\n        seq = PerrinSequence()\n        validator = Validator()\n        service = PerrinCalculatorService(cache_repo, seq, validator)\n        return cls(service, cache_repo)\n\n    def cal_sum(self, n: int) -> int:\n        return self._service.sum_up_to(n)\n_default_facade = APIFacade.create_default()\ndef cal_sum(n: int) -> int:\n    \"\"\"Calculates the sum of Perrin numbers from P(0) to P(n) inclusive.\"\"\"\n    return _default_facade.cal_sum(n)", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[-5]]}], "Mbpp/459": [{"task_id": "Mbpp/459", "solution": "from typing import Optional, Any\nclass RemovalError(Exception):\n    def __init__(self, message: str, cause: Exception = None) -> None:\n        super().__init__(message)\n        self.message = message\n        self.cause = cause\n    def __str__(self) -> str:\n        return f\"{self.message}\" + (f\" (cause: {self.cause})\" if self.cause else \"\")\nclass StringInput:\n    def __init__(self, value: str) -> None:\n        self.value: str = value\nclass StringUtils:\n    def is_upper(self, char: str) -> bool:\n        if not isinstance(char, str) or len(char) != 1:\n            raise RemovalError(\"is_upper expects a single-character string\")\n        return char.isupper()\n\n    def validate_input(self, value: Any) -> str:\n        if value is None:\n            raise RemovalError(\"input cannot be None\")\n        if isinstance(value, bytes):\n            try:\n                return value.decode(\"utf-8\")\n            except Exception as e:\n                raise RemovalError(\"invalid bytes input\", e)\n        return str(value)\nclass UppercaseRemoverService:\n    def __init__(self, utils: Optional[StringUtils] = None) -> None:\n        self._utils = ut