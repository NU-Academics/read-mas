ut must be a str\")\ndef utc_now() -> datetime.datetime:\n    \"\"\"Returns a timezone-aware UTC timestamp.\"\"\"\n    return datetime.datetime.now(datetime.timezone.utc)\nclass StringRepository:\n    \"\"\"Persists conversion records to SQLite and reads recent records.\"\"\"\n    CREATE_TABLE_SQL = \"\"\"\n    CREATE TABLE IF NOT EXISTS conversions (\n      id INTEGER PRIMARY KEY AUTOINCREMENT,\n      input_text TEXT NOT NULL,\n      output_text TEXT NOT NULL,\n      timestamp TEXT NOT NULL -- ISO8601 UTC\n    );\n    CREATE INDEX IF NOT EXISTS idx_conversions_timestamp ON conversions (timestamp DESC);\n    \"\"\"\n\n    def __init__(self, db_path: str) -> None:\n        self._db_path = db_path\n        self._conn_lock = threading.Lock()\n        self._logger = logging.getLogger(__name__)\n\n    def _get_connection(self):\n        return sqlite3.connect(self._db_path)\n\n    def init_schema(self) -> None:\n        with self._conn_lock:\n            try:\n                with self._get_connection() as conn:\n                    cursor = conn.cursor()\n                    cursor.executescript(self.CREATE_TABLE_SQL)\n                    conn.commit()\n            except sqlite3.Error as e:\n                self._logger.error(f\"Error initializing DB schema: {e}\")\n                raise PersistenceError(f\"Failed to initialize database schema: {e}\")\n\n    def persist(self, conversion: StringResult) -> None:\n        sql = \"INSERT INTO conversions (input_text, output_text, timestamp) VALUES (?, ?, ?)\"\n        with self._conn_lock:\n            try:\n                with self._get_connection() as conn:\n                    cursor = conn.cursor()\n                    cursor.execute(sql, (\n                        conversion.input_text,\n                        conversion.output_text,\n                        conversion.timestamp.isoformat()\n                    ))\n                    conn.commit()\n            except sqlite3.Error as e:\n                self._logger.error(f\"Error persisting conversion: {e}\")\n                raise PersistenceError(f\"Failed to persist conversion: {e}\")\nclass StringService:\n    \"\"\"Core business logic: validate input, produce lowercase conversion, optionally persist.\"\"\"\n    def __init__(self, validator: StringValidator, repository: Optional[StringRepository] = None, config: Optional[AppConfig] = None) -> None:\n        self._validator = validator\n        self._repository = repository\n        self._config = config or AppConfig()\n        self._logger = logging.getLogger(__name__)\n\n    def to_lower(self, request: StringRequest) -> StringResult:\n        self._validator.validate_input(request.input_text)\n        output = request.input_text.lower()\n        result = StringResult(input_text=request.input_text, output_text=output, timestamp=utc_now())\n        if self._config.persist and self._repository:\n            try:\n                self._repository.persist(result)\n            except PersistenceError:\n                self._logger.exception(\"Failed to persist conversion\") # Log and continue as per design\n        return result\nclass StringController:\n    \"\"\"Thin adapter between callers and service; converts DTO to plain string.\"\"\"\n    def __init__(self, service: StringService) -> None:\n        self._service = service\n\n    def handle_lower(self, input_text: str) -> str:\n        request = StringRequest(input_text)\n        result = self._service.to_lower(request)\n        return result.output_text\ndef is_lower(s: str) -> str:\n    \"\"\"Converts the given string to lower case using the configured service.\"\"\"\n    # Initialize components with default configuration (persistence disabled).\n    config = AppConfig()\n    validator = StringValidator()\n    repo = None\n    if config.persist:\n        repo = StringRepository(config.db_path)\n        repo.init_schema()\n\n    service = StringService(validator=validator, repository=repo, config=config)\n    controller = StringController(service)\n\n    return controller.handle_lower(s)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/420": [{"task_id": "Mbpp/420", "solution": "def cube_Sum(n: int) -> int:\n    \"\"\"Calculates the cube sum of the first n even natural numbers.\n    Assumes n is a non-negative integer as per type hint and problem context.\"\"\"\n    from typing import Iterator, List, Any\n\n    class InputValidator:\n        def validate_n(self, n_val: Any) -> int:\n            return int(n_val)\n\n    class EvenSequence:\n        def __init__(self, n_seq: int) -> None:\n            self.n: int = n_seq\n\n        def __iter__(self) -> Iterator[int]:\n            for k in range(1, self.n + 1):\n                yield 2 * k\n\n        def to_list(self) -> List[int]:\n            return list(iter(self))\n\n    class CubeSumResult:\n        def __init__(self, n_res: int, sum_cubes_res: int, numbers_res: List[int]) -> None:\n            self.n = n_res\n            self.sum_cubes = sum_cubes_res\n            self.numbers = numbers_res\n\n    class CubeCalculator:\n        def __init__(self, validator: InputValidator = None) -> None:\n            self._validator = validator or InputValidator()\n\n        def compute(self, n_calc: int) -> CubeSumResult:\n            validated_n = self._validator.validate_n(n_calc)\n            numbers = EvenSequence(validated_n).to_list()\n            sum_cubes = self._sum_of_cubes(numbers)\n            return CubeSumResult(validated_n, sum_cubes, numbers)\n\n        def _sum_of_cubes(self, numbers: List[int]) -> int:\n            return sum(x ** 3 for x in numbers)\n\n    calc = CubeCalculator()\n    return calc.compute(n).sum_cubes", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/555": [{"task_id": "Mbpp/555", "solution": "def difference(n: int) -> int:\n    \"\"\"\n    Calculate the difference between the sum of cubes of the first n natural numbers\n    and the sum of the first n natural numbers.\n\n    Uses the formulas:\n      sum_{i=1..n} i = n*(n+1)//2\n      sum_{i=1..n} i^3 = (sum_{i=1..n} i)^2\n\n    Returns:\n      int: (sum of cubes) - (sum)\n    Raises:\n      TypeError: if n cannot be interpreted as an integer\n      ValueError: if n < 1\n    \"\"\"\n    # Allow integer-like inputs but enforce integer semantics\n    if not isinstance(n, int):\n        try:\n            n = int(n)\n        except Exception as exc:\n            raise TypeError(\"n must be an integer\") from exc\n\n    if n < 1:\n        raise ValueError(\"n must be >= 1\")\n\n    s1 = n * (n + 1) // 2\n    s3 = s1 * s1\n    return s3 - s1", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[0]]}], "Mbpp/471": [{"task_id": "Mbpp/471", "solution": "def find_remainder(numbers: list[int], modulus: int) -> int:\n    \"\"\"\n    Calculates the product of a list of numbers modulo n.\n    \"\"\"\n\n    class InvalidInputError(Exception):\n        \"\"\"Raised when input numbers are invalid.\"\"\"\n        pass\n\n    class InvalidModulusError(Exception):\n        \"\"\"Raised when the modulus is invalid (e.g., non-positive).\"\"\"\n        pass\n\n    DEFAULT_EMPTY_PRODUCT = 1\n\n    def safe_mul_mod(a: int, b: int, mod: int) -> int:\n        \"\"\"Computes (a * b) % mod efficiently, reducing intermediate values.\"\"\"\n        return ((a % mod) * (b % mod)) % mod\n\n    class ProductRepository:\n        \"\"\"Manages the accumulation of products modulo a given modulus.\"\"\"\n        def __init__(self, modulus: int) -> None:\n            if not isinstance(modulus, int):\n                raise InvalidModulusError(\"modulus must be an integer > 0\")\n            if modulus <= 0:\n                raise InvalidModulusError(\"modulus must be > 0\")\n            self._modulus = modulus\n            self._product = DEFAULT_EMPTY_PRODUCT % modulus\n\n        def multiply(self, value: int) -> None:\n            \"\"\"Multiplies the current product by a value, applying modulo.\"\"\"\n            if not isinstance(value, int):\n                raise InvalidInputError(\"all elements must be integers\")\n            self._product = safe_mul_mod(self._product, value, self._modulus)\n\n        def get_product(self) -> int:\n            \"\"\"Returns the current accumulated product modulo the modulus.\"\"\"\n            return self._product\n\n        def reset(self) -> None:\n            \"\"\"Resets the product to the default empty product value.\"\"\"\n            self._product = DEFAULT_EMPTY_PRODUCT % self._modulus\n\n    class CalculatorService:\n        \"\"\"Implements the core logic for finding the product modulo n.\"\"\"\n        def __init__(self, repo: ProductRepository) -> None:\n            self._repo = repo\n\n        def find_remainder(self, numbers: list[int]) -> int:\n            \"\"\"Iterates through numbers, multiplying each into the repository's product.\"\"\"\n            for number in numbers:\n                self._repo.multiply(number)\n            return self._repo.get_product()\n\n    class RemainderController:\n        \"\"\"Orchestrates input handling and delegates computation to the service.\"\"\"\n        def __init__(self, service: CalculatorService) -> None:\n            self._service = service\n\n        def handle_find_remainder(self, numbers: list[int], modulus: int) -> int:\n            \"\"\"Calls the calculator service to compute the remainder.\"\"\"\n            return self._service.find_remainder(numbers=numbers)\n\n    # Validate inputs at the API boundary\n    if not isinstance(numbers, (list, tuple)):\n        raise InvalidInputError(\"numbers must be a list or tuple of integers\")\n    # Elements validated inside ProductRepository.multiply\n\n    repo = ProductRepository(modulus=modulus)\n    service = CalculatorService(repo=repo)\n    controller = RemainderController(service=service)\n    return controller.handle_find_remainder(numbers=numbers, modulus=modulus)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/554": [{"task_id": "Mbpp/554", "solution": "from typing import Any, List\nclass InvalidInputError(Exception):\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\nclass InputValidator:\n    \"\"\"Validates if the input is a list of integers.\"\"\"\n    def __init__(self) -> None:\n        pass\n\n    def validate_list(self, values: Any) -> List[int]:\n        \"\"\"Checks if the input is a list and all its elements are integers.\"\"\"\n        if not isinstance(values, list):\n            raise InvalidInputError(\"Input must be a list of integers.\")\n        for idx, v in enumerate(values):\n            if not isinstance(v, int):\n                raise InvalidInputError(f\"Element at index {idx} is not an int: {repr(v)}\")\n        return list(values)\nclass SplitService:\n    \"\"\"Provides business logic to filter odd integers.\"\"\"\n    def __init__(self) -> None:\n        pass\n\n    def filter_odds(self, values: List[int]) -> List[int]:\n        \"\"\"Returns a new list containing only the odd integers from the input list.\"\"\"\n        return [x for x in values if x % 2 != 0]\n_default_validator = InputValidator()\n_default_service = SplitService()\n_default_controller = None\nclass SplitController:\n    \"\"\"Orchestrates input validation and odd number filtering.\"\"\"\n    def __init__(self, validator: InputValidator, service: SplitService) -> None:\n        self.validator = validator\n        self.service = service\n\n    def split(self, lst: List[int]) -> List[int]:\n        \"\"\"Validates the input list and returns a list of its odd integers.\"\"\"\n        validated = self.validator.validate_list(lst)\n        return self.service.filter_odds(validated)\n\n    @staticmethod\n    def Split(lst: List[int]) -> List[int]:\n        \"\"\"Static met