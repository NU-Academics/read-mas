    products = [A[i] * B[j] for i in range(n) for j in range(m)]\n        products.sort(reverse=True)\n        return products[:k]\n\n    heap = []\n    visited = set()\n\n    def push(i, j):\n        if 0 <= i < n and 0 <= j < m and (i, j) not in visited:\n            visited.add((i, j))\n            heapq.heappush(heap, (-(A[i] * B[j]), i, j))\n\n    push(0, 0)\n    result = []\n\n    while heap and len(result) < k:\n        neg_prod, i, j = heapq.heappop(heap)\n        result.append(-neg_prod)\n        push(i + 1, j)\n        push(i, j + 1)\n\n    return result", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[[], [], 0]]}], "Mbpp/296": [{"task_id": "Mbpp/296", "solution": "import sqlite3\nimport os\nimport tempfile\nimport logging\nfrom typing import List, Tuple, Any, Callable, Optional, Dict\nclass InversionError(Exception):\n    \"\"\"Custom exception for inversion counting errors.\"\"\"\n    pass\n_temp_dir = tempfile.gettempdir()\nDB_PATH = os.path.join(_temp_dir, \"invcount_cache_temp.db\")\nCACHE_ENABLED = True\n_logger = logging.getLogger(__name__)\nFINGERPRINT_SEPARATOR = ','\ndef validate_array(arr: Any) -> List[int]:\n    \"\"\"Validates that the input is an iterable and its elements are convertible to integers.\"\"\"\n    try:\n        seq = list(arr)\n    except TypeError:\n        raise InversionError(\"Input must be an iterable of integers\")\n    result = []\n    for i, v in enumerate(seq):\n        try:\n            result.append(int(v))\n        except Exception:\n            raise InversionError(f\"Element at index {i} is not convertible to int: {v!r}\")\n    return result\ndef fingerprint(arr: List[int]) -> str:\n    \"\"\"Generates a deterministic string fingerprint for an array to be used as a cache key.\"\"\"\n    return f\"{len(arr)}|{FINGERPRINT_SEPARATOR.join(map(str, arr))}\"\nclass MergeSortInversionCounter:\n    \"\"\"Counts inversions in an array using a modified merge sort algorithm with O(N