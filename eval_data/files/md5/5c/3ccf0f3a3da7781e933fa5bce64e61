in_s * full_cycles\n\n    # Now, account for the remainder rotations.\n    if remainder_rotations > 0:\n        # For a left rotation by `k` positions (0-indexed), the original character at index `(k-1) % n`\n        # becomes the last character of the rotated string.\n        # We need to count '1's at these positions for `k` from `0` to `remainder_rotations - 1`.\n\n        # For k=0 (the original string), the last character is s[n-1].\n        if s[n - 1] == '1':\n            total_odd_count += 1\n\n        # For k=1 to k=remainder_rotations-1, the last characters are s[0] through s[remainder_rotations-2].\n        for i in range(remainder_rotations - 1):\n            if s[i] == '1':\n                total_odd_count += 1\n\n    return total_odd_count", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [["10000100110011", 5]]}], "Mbpp/111": [{"task_id": "Mbpp/111", "solution": "def common_in_nested_lists(nested_lists):\n    \"\"\"\n    Finds the common elements in given nested lists.\n    Returns a sorted list of unique common elements.\n    \"\"\"\n\n    def _to_sorted_list(s):\n        \"\"\"Converts a set to a deterministically sorted list, handling mixed types.\"\"\"\n        try:\n            return sorted(s)\n        except TypeError:\n            return sorted(s, key=lambda x: repr(x))\n\n    def _to_set(iterable):\n        \"\"\"Converts an iterable to a set.\"\"\"\n        return set(iterable)\n\n    def _intersect_sets(sets_to_intersect):\n        \"\"\"Computes the intersection of a collection of sets efficiently.\"\"\"\n        sets_to_intersect = [s for s in sets_to_intersect if s]\n        if not sets_to_intersect:\n            return set()\n        sets_to_intersect.sort(key=len)\n        result = sets_to_intersect[0].copy()\n        for s in sets_to_intersect[1:]:\n            result &= s\n            if not result:\n                break\n        return result\n\n    if not nested_lists:\n        return []\n\n    # Initialize common_elements_set with the first inner list's elements\n    it = iter(nested_lists)\n    first_iterable = next(it)\n    common_elements_set = _to_set(first_iterable)\n\n    # If the first set is empty, no common elements are possible\n    if not common_elements_set:\n        return []\n\n    # Intersect with the remaining inner lists\n    for inner_list in it:\n        current_set = _to_set(inner_list)\n        common_elements_set = _intersect_sets([common_elements_set, current_set])\n        # Early exit if the common set becomes empty\n        if not common_elements_set:\n            return []\n\n    return _to_sorted_list(common_elements_set)", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[[[87.07763738802882], [], [], []]]]}], "Mbpp/108": [{"task_id": "Mbpp/108", "solution": "import heapq\nfrom typing import Any, Iterable, List, Optional, Tuple, Union, Iterator\nclass InputValidationError(Exception):\n    def __init__(self, message: str, errors: Optional[List] = None):\n        super().__init__(message)\n        self.errors = errors if errors is not None else []\nclass MergeError(Exception):\n    def __init__(self, message: str):\n        super().__init__(message)\ndef is_numeric(value: Any) -> bool:\n    \"\"\"Checks if a value is an integer or float.\"\"\"\n    return isinstance(value, (int, float))\ndef safe_coerce_numeric(value: Any) -> Union[int, float]:\n    \"\"\"Attempts to coerce a value to int or float, raising ValueError on failure.\"\"\"\n    if isinstance(value, (int, float)):\n        return value\n    if isinstance(value, str):\n        try:\n            if '.' in value:\n                return float(value)\n            return int(value)\n        except ValueError:\n            pass\n    raise ValueError(f\"Cannot coerce '{value}' to a numeric type.\")\n_ALLOWED_NUMERIC_TYPES = (int, float)\n_DEFAULT_MAX_PERSIST = 100\nclass MergeResult:\n    def __init__(self, merged: List):\n        self.merged = merged\nclass ListValidator:\n    def __init__(self):\n        self.allowed_types = _ALLOWED_NUMERIC_TYPES\n\n    def _validate_iterable(self, sequence: Iterable, list_idx: int, allow_coerce: bool) -> List[dict]:\n        errors = []\n        for elem_idx, element in enumerate(sequence):\n            if not is_numeric(element):\n                if allow_coerce:\n                    try:\n                        safe_coerce_numeric(element)\n                    except ValueError:\n                        errors.append({\n                            \"list_index\": list_idx,\n                            \"element_index\": elem_idx,\n                            \"value\": str(element),\n                            \"reason\": f\"Element '{element}' is not numeric and cannot be coerced.\"\n                        })\n                else:\n                    errors.append({\n                        \"list_index\": list_idx,\n                        \"element_index\": elem_idx,\n                        \"value\": str(element),\n                        \"reason\": f\"Element '{element}' is not a numeric type.\"\n                    })\n        return errors\n\n    def validate(self, lists: List[List], *, allow_coerce: bool = False) -> None:\n        if not isinstance(lists, list):\n            raise InputValidationError(\"Input 'lists' must be a list of lists.\")\n\n        all_errors = []\n        for i, lst in enumerate(lists):\n            if not isinstance(lst, (list, tuple)):\n                all_errors.append({\"list_index\": i, \"reason\": f\"Element at index {i} is not a list or tuple.\"})\n                continue\n            all_errors.extend(self._validate_iterable(lst, i, allow_coerce))\n\n        if all_errors:\n            raise InputValidationError(\"One or more input lists contain invalid elements.\", errors=all_errors)\nclass Sorter:\n    def sort_individual(self, lst: List) -> List:\n        \"\"\"Returns a new sorted list from the input.\"\"\"\n        return sorted(lst)\n\n    def k_way_merge(self, lists: List[List]) -> List:\n        \"\"\"Merges multiple lists into a single sorted list using a min-heap.\"\"\"\n        sorted_lists = [self.sort_individual(lst) for lst in lists]\n        heap: List[Tuple[Any, int, int]] = [] # (value, list_index, element_index)\n        result = []\n\n        for i, lst in enumerate(sorted_lists):\n            if lst:\n                heapq.heappush(heap, (lst[0], i, 0))\n\n        while heap:\n            val, list_idx, element_idx = heapq.heappop(heap)\n            result.append(val)\n\n            element_idx += 1\n            if element_idx < len(sorted_lists[list_idx]):\n                heapq.heappush(heap, (sorted_lists[list_idx][element_idx], list_idx, element_idx))\n        return result\n\n    def merge_three_lists_optimized(self, a: List, b: List, c: List) -> List:\n        \"\"\"Optimized two-pointer merge for exactly three lists (optional).\"\"\"\n        sorted_a = self.sort_individual(a)\n        sorted_b = self.sort_individual(b)\n        sorted_c = self.sort_individual(c)\n\n        temp_merged = []\n        i, j = 0, 0\n        while i < len(sorted_a) and j < len(sorted_b):\n            if sorted_a[i] <= sorted_b[j]:\n                temp_merged.append(sorted_a[i])\n                i += 1\n            else:\n                temp_merged.append(sorted_b[j])\n                j += 1\n        temp_merged.extend(sorted_a[i:])\n        temp_merged.extend(sorted_b[j:])\n\n        final_merged = []\n        i, j = 0, 0\n        while i < len(temp_merged) and j < len(sorted_c):\n            if temp_merged[i] <= sorted_c[j]:\n                final_merged.append(temp_merged[i])\n                i += 1\n            else:\n                final_merged.append(sorted_c[j])\n                j += 1\n        final_merged.extend(temp_merged[i:])\n        final_merged.extend(sorted_c[j:])\n\n        return final_merged\nclass InMemoryRepository:\n    def __init__(self