 "Mbpp/473": [{"task_id": "Mbpp/473", "solution": "from typing import Iterable, Tuple, Set, Dict, Any, Optional\nclass InvalidInputError(ValueError):\n    \"\"\"Exception raised for invalid input formats.\"\"\"\n    def __init__(self, message: str, item=None) -> None:\n        super().__init__(message)\n        self.message = message\n        self.item = item\nclass TupleNormalizer:\n    \"\"\"Normalizes and canonicalizes 2-element tuples for order-insensitive comparison.\"\"\"\n    def normalize(self, pair: Iterable[Any]) -> Tuple[Any, Any]:\n        \"\"\"Validates a pair and returns its normalized (sorted) form.\"\"\"\n        try:\n            a, b = pair\n        except Exception:\n            raise InvalidInputError(\"Each item must be a pair (length 2).\", item=pair)\n        try:\n            return (a, b) if a <= b else (b, a)\n        except TypeError: # Fallback for non-comparable types\n            return (a, b) if repr(a) <= repr(b) else (b, a)\n\n    def canonical(self, pair: Tuple[Any, Any]) -> Tuple[Any, Any]:\n        \"\"\"Returns the canonical (sorted) form of an already validated pair.\"\"\"\n        a, b = pair\n        try:\n            return (a, b) if a <= b else (b, a)\n        except TypeError: # Fallback for non-comparable types\n            return (a, b) if repr(a) <= repr(b) else (b, a)\nclass TupleRepository:\n    \"\"\"Adapts input iterables into normalized mappings and key sets.\"\"\"\n    def __init__(self, normalizer: TupleNormalizer) -> None:\n        self._normalizer = normalizer\n\n    def build_normalized_map(self, iterable: Iterable[Iterable[Any]]) -> Dict[Tuple[Any,Any], Tuple[Any,Any]]:\n        \"\"\"Creates a map from normalized tuple to its preferred original orientation.\"\"\"\n        mapping = {}\n        for item in iterable:\n            norm = self._normalizer.normalize(item)\n            if norm not in mapping:\n                mapping[norm] = tuple(item)\n        return mapping\n\n    def keys_set(self, iterable: Iterable[Iterable[Any]]) -> Set[Tuple[Any,Any]]:\n        \"\"\"Creates a set of normalized tuples from an iterable.\"\"\"\n        return {self._normalizer.normalize(item) for item in iterable}\nclass IntersectionResult:\n    \"\"\"A data transfer object for the result of the intersection.\"\"\"\n    def __init__(self, pairs: Set[Tuple[Any,Any]]) -> None:\n        self._pairs = set(pairs)\n\n    def to_set(self) -> Set[Tuple[Any,Any]]:\n        \"\"\"Returns the set of intersecting pairs.\"\"\"\n        return set(self._pairs)\nclass TupleIntersectionService:\n    \"\"\"Orchestrates validation, normalization, and intersection computation.\"\"\"\n    def __init__(self, repository: TupleRepository, normalizer: TupleNormalizer) -> None:\n        self._repository = repository\n        self._normalizer = normalizer\n\n    def intersect(self, a: Iterable[Tuple[Any,Any]], b: Iterable[Tuple[Any,Any]]) -> IntersectionResult:\n        \"\"\"Computes the intersection of two iterables of 2-element tuples.\"\"\"\n        self.validate_inputs(a, b)\n        map_a = self._repository.build_normalized_map(a)\n        keys_b = self._repository.keys_set(b)\n        pairs = self._compute_intersection(map_a, keys_b)\n        return IntersectionResult(pairs)\n\n    def _compute_intersection(self, map_a: Dict[Tuple[Any,Any], Tuple[Any,Any]], map_b_keys: Set[Tuple[Any,Any]]) -> Set[Tuple[Any,Any]]:\n        \"\"\"Internal method to compute the intersection with orientation preference.\"\"\"\n        result = set()\n        for key in map_a.keys() & map_b_keys:\n            preferred = map_a.get(key)\n            if preferred is not None:\n                result.add(preferred)\n            else:\n                result.add(self._normalizer.canonical(key))\n        return result\n\n    def validate_inputs(self, a: Iterable, b: Iterable) -> None:\n        \"\"\"Validates that inputs are iterable.\"\"\"\n        try:\n            iter(a)\n            iter(b)\n        except TypeError:\n            raise InvalidInputError(\"Inputs must be iterable\", item=(a, b))\n_normalizer = TupleNormalizer()\n_repository = TupleRepository(_normalizer)\n_service = TupleIntersectionService(_repository, _normalizer)\ndef tuple_intersection(list_a: Iterable[Tuple[Any,Any]], list_b: Iterable[Tuple[Any,Any]]) -> Set[Tuple[Any,Any]]:\n    \"\"\"\n    Finds the tuple intersection of elements in the given tuple list irrespective of their order.\n    The output tuples preserve the orientation from `list_a` if possible, otherwise use a canonical form.\n    \"\"\"\n    return _service.intersect(list_a, list_b).to_set()", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[[[4, 1], [7, 4], [11, 13], [17, 14]], [[1, 4], [7, 4], [16, 12], [10, 13]]]], "plus_fail_tests": [[[[1, 2, 3], [4, 5, 6], [7, 8, 9]], [[1, 2, 3], [7, 8, 9], [10, 11, 12]]]]}], "Mbpp/563": [{"task_id": "Mbpp/563", "solution": "from typing import Optional, List\ndef extract_values(input_str: Optional[str]) -> List[str]:\n    \"\"\"\n    Extract substrings between matching single or double quotes.\n    Returns [] if input_str is None or no matches found.\n    Raises TypeError if input_str is not None and not a str.\n    \"\"\"\n    if input_str is None:\n        return []\n    if not isinstance(input_str, str):\n        raise TypeError(\"input_str must be a str or None\")\n\n    import re\n    pattern = r'([\\\"\\\\\\'])(.*?)\\\\1'\n    matches = re.findall(pattern, input_str)\n    return [content for (_quote, content) in matches]", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [["\"Python\", \"PHP\", \"Java\""]], "plus_fail_tests": [["\"red\" \"blue\" \"green\" \"yellow\" \"red\" \"blue\" \"green\" \"yellow\""]]}], "Mbpp/558": [{"task_id": "Mbpp/558", "solution": "def digit_distance_nums(a: int, b: int) -> int:\n    \"\"\"\n    Calculates the sum of per-digit absolute differences between two integers.\n    Digits are aligned from the least-significant position, with shorter numbers zero-padded.\n    \"\"\"\n\n    # Convert integer 'a' to a list of its digits, least-significant-first.\n    n_a = abs(a)\n    if n_a == 0:\n        a_digits = [0]\n    else:\n        a_digits = []\n        while n_a > 0:\n            a_digits.append(n_a % 10)\n            n_a //= 10\n\n    # Convert integer 'b' to a list of its digits, least-significant-first.\n    n_b = abs(b)\n    if n_b == 0:\n        b_digits = [0]\n    else:\n        b_digits = []\n        while n_b > 0:\n            b_digits.append(n_b % 10)\n            n_b //= 10\n\n    # Pad the shorter digit list with zeros to match the length of the longer list.\n    len_a, len_b = len(a_digits), len(b_digits)\n    if len_a < len_b:\n        a_digits_padded = a_digits + [0] * (len_b - len_a)\n        b_digits_padded = b_digits\n    elif len_b < len_a:\n        a_digits_padded = a_digits\n        b_digits_padded = b_digits + [0] * (len_a - len_b)\n    else:\n        a_digits_padded = a_digits\n        b_digits_padded = b_digits\n\n    # Calculate the sum of absolute differences for each corresponding digit.\n    total_diff = 0\n    for digit_a, digit_b in zip(a_digits_padded, b_digits_padded):\n        total_diff += abs(digit_a - digit_b)\n\n    return total_diff", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/559": [{"task_id": "Mbpp/559", "solution": "import hashlib\nfrom typing import List, Optional, Callable, Dict, Any\nDEFAULT_ALGORITHM: str = \"kadane\"\nCACHE_ENABLED: bool = True\nclass MaxSubArrayError(ValueError):\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\nclass ArrayInput:\n    def __init__(self, nums: List[int], n: int) -> None:\n        self.n = n\n        self.nums = nums\nclass Validator:\n    @staticmethod\n    def validate_input(nums: Any, n: int) -> None:\n        if not isinstance(n, int):\n            raise MaxSubArrayError(\"n must be an int\")\n        if not isinstance(nums, (list, tuple)):\n            raise MaxSubArrayError(\"nums must be a list or tuple\")\n        if len(nums) != n:\n            raise MaxSubArrayError(\"n must equal len(nums)\")\n        if n == 0:\n            raise MaxSubArrayError(\"nums must not be empty\")\n        for x in nums:\n            if not isinstance(x, int):\n                raise MaxSubArrayError(\"all elements in nums must be ints\")\nclass IAlgorithm:\n    def run(self, nums: List[int]) -> int:\n        raise NotImplementedError\nclass KadaneAlgorithm(IAlgorithm):\n    def run(self, nums: List[int]) -> int:\n        if not nums:\n            raise MaxSubArrayError(\"nums must not be empty for Kadane's algorithm\")\n        max_here = nums[0]\n        max_so_far = nums[0]\n        for x in nums[1:]:\n            max_here = max(x, max_here + x)\n            max_so_far = max(max_so_far, max_here)\n        return max_so_far\nclass BruteForceAlgorithm(IAlgorithm):\n    def run(self, nums: List[int]) -> int:\n        # The Validator ensures nums is not empty before this method is called.\n        n = len(nums)\n        best = nums[0]\n        for i in range(n):\n            current = 0\n            for j in range(i, n):\n                current += nums[j]\n                if current > best:\n                    best = current\n        return best\nclass ResultRepository:\n    def __init__(self) -> None:\n        self._cache: Dict[str, int] = {}\n\n    def get(self, key: str) -> Optional[int]:\n        return self._cache.get(key)\n\n    def save(self, key: str, result: int) -> None:\n        self._cache[key] = result\n\n    def _make_key(self, nums: List[int], n: int) -> str:\n        h = hashlib.sha256(repr(tuple(nums)).encode()).hexdigest()\n        return f\"{h}:{n}\"\nclass MaxSubArrayService:\n    def __init__(self, repository: ResultRepository, algorithm_factory: Callable[[str], IAlgorithm]) -> None:\n        self._repository = repository\n        # This algorithm_factory is stored but not directly used by _select_algorithm.\n        self._algorithm_factory = algorithm_factory\n\n    def _select_algorithm(self, name: Optional[str]) -> IAlgorithm:\n        if name is None or name == DEFAULT_ALGORITHM:\n            return KadaneAlgorithm()\n        if name == \"bruteforce\":\n            return BruteForceAlgorithm()\n        # Fallback to the default algorithm if an unknown name is provided.\n        return KadaneAlgorithm()\n\n    def max_sub_array_sum(self, input: ArrayInput, algorithm_name: Optional[str] = None) -> int:\n        Validator.validate_input(input.nums, input.n)\n\n        key = self._repository._make_key(input.nums, input.n)\n        if CACHE_ENABLED:\n            cached = self._repository.get(key)\n            if cached is not None:\n                return cached\n\n        alg = self._select_algorithm(algorithm_name)\n        try:\n            result = alg.run(input.nums)\n        except MaxSubArrayError as e:\n            raise e\n        except Exception as e:\n            raise MaxSubArrayError(f\"algorithm error: {e}\") from e\n\n        if CACHE_ENABLED:\n            self._repository.save(key, result)\n        return result\nclass MaxSubArrayController:\n    def __init__(self, service: MaxSubArrayService) -> None:\n        self._service = service\n\n    def max_sub_array_sum(self, nums: List[int], n: int, algorithm_name: Optional[str] = None) -> int:\n        input_dto = ArrayInput(nums, n)\n        return self._service.max_sub_array_sum(input_dto, algorithm_name)\n_default_repo = ResultRepository()\n_default_service = MaxSubArrayService(_default_repo, lambda name: KadaneAlgorithm())\n_controller = MaxSubArrayController(_default_service)\ndef max_sub_array_sum(nums: List[int], n: int) -> int:\n    \"\"\"\n    Computes the maximum contiguous subarray sum using Kadane's algorithm by default.\n    It validates inputs and caches results to optimize repeated calls.\n    \"\"\"\n    return _controller.max_sub_array_sum(nums, n)", "bas