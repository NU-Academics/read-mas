terable, Tuple, Union\ndef is_numeric(value: Any) -> bool:\n    \"\"\"Checks if a value is an integer or a float.\"\"\"\n    return isinstance(value, (int, float))\nclass InvalidListError(Exception):\n    \"\"\"Custom exception for invalid list operations.\"\"\"\n    def __init__(self, message: str, code: str = \"invalid_list\", details: dict = None) -> None:\n        super().__init__(message)\n        self.message = message\n        self.code = code\n        self.details = details if details is not None else {}\nMAX_LIST_SIZE: int = 1000000\nclass ListModel:\n    \"\"\"Immutable wrapper for a validated list of numeric values.\"\"\"\n    def __init__(self, items: list[float]) -> None:\n        self.items = items\n\n    def to_list(self) -> list[float]:\n        \"\"\"Returns the underlying list of items.\"\"\"\n        return self.items\nclass ListRepository:\n    \"\"\"Handles validation and creation of ListModel instances.\"\"\"\n\n    @staticmethod\n    def validate_and_create(a: Iterable, b: Iterable) -> Tuple[ListModel, ListModel]:\n        \"\"\"Validates input iterables and returns them as ListModel instances.\"\"\"\n        a_list = list(a)\n        b_list = list(b)\n\n        if len(a_list) != len(b_list):\n            raise InvalidListError(\n                \"Input lists must have the same length.\",\n                code=\"length_mismatch\",\n                details={'len_a': len(a_list), 'len_b': len(b_list)}\n            )\n\n        if len(a_list) > MAX_LIST_SIZE:\n            raise InvalidListError(\n                f\"List size exceeds maximum allowed: {MAX_LIST_SIZE}\",\n                code=\"too_large\",\n                details={'max': MAX_LIST_SIZE, 'actual': len(a_list)}\n            )\n\n        processed_a = []\n        for idx, item in enumerate(a_list):\n            if not is_numeric(item):\n                raise InvalidListError(\n                    f\"List 'a' contains a non-numeric element at index {idx}: {item}\",\n                    code=\"invalid_element\",\n                    details={'list_name': 'a', 'index': idx, 'value': item}\n                )\n            processed_a.append(float(item))\n\n        processed_b = []\n        for idx, item in enumerate(b_list):\n            if not is_numeric(item):\n                raise InvalidListError(\n                    f\"List 'b' contains a non-numeric element at index {idx}: {item}\",\n                    code=\"invalid_element\",\n                    details={'list_name': 'b', 'index': idx, 'value': item}\n                )\n            processed_b.append(float(item))\n\n        return ListModel(processed_a), ListModel(processed_b)\nclass ListService:\n    \"\"\"Core business logic for list operations.\"\"\"\n\n    @staticmethod\n    def subtract_lists(list_a: list[float], list_b: list[float]) -> list[float]:\n        \"\"\"Performs element-wise subtraction of two lists.\"\"\"\n        result = [a - b for a, b in zip(list_a, list_b)]\n        return result\nclass ListController:\n    \"\"\"Orchestrates list operations, handling input validation and service calls.\"\"\"\n\n    @staticmethod\n    def handle_subtract(a: Iterable, b: Iterable) -> list[float]:\n        \"\"\"Validates inputs, then performs element-wise subtraction.\"\"\"\n        model_a, model_b = ListRepository.validate_and_create(a, b)\n        result_list = ListService.subtract_lists(model_a.to_list(), model_b.to_list())\n        return result_list\ndef sub_list(a: List[Union[int, float]], b: List[Union[int, float]]) -> List[float]:\n    \"\"\"Subtracts two lists element-wise, validating inputs.\"\"\"\n    return ListController.handle_subtract(a, b)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/257": [{"task_id": "Mbpp/257", "solution": "def swap_numbers(a: object, b: object) -> tuple[float, float]:\n    \"\"\"\n    Swaps two numbers, returning them as a tuple (b, a) after validation.\n    Raises ValueError if inputs are not numeric.\n    \"\"\"\n    class Validator:\n        \"\"\"Utility for validating and converting values to numeric types.\"\"\"\n        def __init__(self) -> None:\n            pass\n\n        def validate_number(self, value: object) -> float:\n            \"\"\"Validates a value as numeric, converting strings and returning an int or float.\"\"\"\n            if isinstance(value, (int, float)):\n                return value\n            if isinstance(value, str):\n                try:\n                    v = float(value)\n                    # Convert to int if the float represents an integer, otherwise keep as float.\n                    return int(v) if v.is_integer() else v\n                except ValueError:\n                    pass\n            raise ValueError(f\"Invalid numeric value: {value!r}\")\n\n    class SwapService:\n        \"\"\"Core business logic for swapping numbers, utilizing a Validator for input processing.\"\"\"\n        def __init__(self, validator: Validator) -> None:\n            self._validator = validator\n\n        def swap(self, a_val: object, b_val: object) -> tuple[float, float]:\n            \"\"\"Validates and swaps two input values, returning them as a tuple (b, a).\"\"\"\n            validated_a = self._validator.validate_number(a_val)\n            validated_b = self._validator.validate_number(b_val)\n            return (validated_b, validated_a)\n\n    validator = Validator()\n    service = SwapService(validator)\n    return service.swap(a, b)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/260": [{"task_id": "Mbpp/260", "solution": "def newman_prime(n: int) -> int:\n    \"\"\"\n    Find the nth Newman\u2013Shanks\u2013Williams (NSW) sequence value using 0-based indexing.\n    Example: newman_prime(3) == 7\n    \"\"\"\n\n    class Matrix2x2:\n        \"\"\"Represents a 2x2 integer matrix and provides matrix operations.\"\"\"\n        def __init__(self, a: int, b: int, c: int, d: int) -> None:\n            self.a = a\n            self.b = b\n            self.c = c\n            self.d = d\n\n        def __mul__(self, other: 'Matrix2x2') -> 'Matrix2x2':\n            \"\"\"Performs matrix multiplication.\"\"\"\n            return Matrix2x2(\n                self.a * other.a + self.b * other.c,\n                self.a * other.b + self.b * other.d,\n                self.c * other.a + self.d * other.c,\n                self.c * other.b + self.d * other.d\n            )\n\n        def pow(self, exp: int) -> 'Matrix2x2':\n            \"\"\"Computes matrix raised to the power of exp using exponentiation by squaring.\"\"\"\n            result = Matrix2x2(1, 0, 0, 1)  # Identity matrix\n            base = self\n\n            while exp > 0:\n                if exp % 2 == 1:\n                    result = result * base\n                base = base * base\n                exp //= 2\n            return result\n\n        def apply_to_vector(self, v: tuple[int, int]) -> tuple[int, int]:\n            \"\"\"Multiplies the matrix by a 2-element vector (x, y).\"\"\"\n            x, y = v\n            return (self.a * x + self.b * y, self.c * x + self.d * y)\n\n    class NSWGenerator:\n        \"\"\"Generates Newman-Shanks-Williams (NSW) numbers.\"\"\"\n        def __init__(self) -> None:\n            # The recurrence relation S(n) = 2*S(n-1) + S(n-2) can be represented by this matrix.\n            self.base_matrix = Matrix2x2(2, 1, 1, 0)\n            # Initial vector (S(1), S(0)) for 0-based indexing.\n            self.initial_vector = (1, 1)\n\n        def nth(self, n: int) -> int:\n            \"\"\"Calculates the nth NSW number S(n) using matrix exponentiation.\"\"\"\n            if n == 0 or n == 1:\n                return 1\n\n            # Compute M^(n-1) where M is the base_matrix\n            # M^(n-1) * [S(1), S(0)] = [S(n), S(n-1)]\n            matrix_power = self.base_matrix.pow(n - 1)\n\n            # Apply the resulting matrix power to the initial vector\n            result_vector = matrix_power.apply_to_vector(self.initial_vector)\n\n            # The first element of the result vector is S(n)\n            return result_vector[0]\n\n    # Instantiate the NSWGenerator and calculate the nth term\n    generator = NSWGenerator()\n    return generator.nth(n)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/290": [{"task_id": "Mbpp/290", "solution": "def find_max_length(lists):\n    \"\"\"\n    Finds the list of maximum length in a list of lists.\n    Returns a tuple containing the maximum length and the first list with that length.\n    \"\"\"\n    max_len = -1\n    max_list = None\n    for sub in lists:\n        # Assuming sub is a list-like object for which len() is defined\n        # and validation ensures it's a list or tuple.\n        l = len(sub)\n        if l > max_len:\n            max_len = l\n            max_list = sub\n    return (max_len, max_list)", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/287": [{"task_id": "Mbpp/287", "solution": "def square_Sum(n):\n    \"\"\"\n    Calculates the sum of squares of the first n even natural numbers using a closed-form formula.\n\n    Sum_{k=1..n} (2k)^2 = 4 * sum_{k=1..n} k^2 = 4 * n(n+1)(2n+1)/6\n    Simplified: 2 * n * (n + 1) * (2n + 1) / 3\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n    if n < 0:\n        raise ValueError(\"n must be non-negative\")\n\n    return 2 * n * (n + 1) * (2 * n + 1) // 3", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[1000000]]}], "Mbpp/285": [{"task_id": "Mbpp/285", "solution": "import re\nimport datetime\nfrom typing import Optional, Any\nfrom dataclasses import dataclass\nclass InvalidInputError(Exception):\n    \"\"\"Exception raised for invalid input.\"\"\"\n    pass\nREGEX_PATTERN: str = r'a(?:bb|bbb)'\nclass TextValida