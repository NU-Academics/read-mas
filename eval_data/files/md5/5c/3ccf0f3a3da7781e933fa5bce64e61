c] = dp[0][c-1] + float(matrix[0][c])\n\n    # Initialize the first column\n    for r in range(1, n):\n        dp[r][0] = dp[r-1][0] + float(matrix[r][0])\n\n    # Fill the rest of the dp table\n    for r in range(1, n):\n        for c in range(1, n):\n            dp[r][c] = float(matrix[r][c]) + max(dp[r-1][c], dp[r][c-1])\n\n    # The maximum sum path ends at dp[n-1][n-1]\n    max_total_sum = dp[n-1][n-1]\n\n    # For an N*N matrix, any path from top-left to bottom-right moving only right or down\n    # will always visit exactly (2*N - 1) cells.\n    path_length = 2 * n - 1\n\n    return max_total_sum / path_length", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/724": [{"task_id": "Mbpp/724", "solution": "def power_base_sum(base, power):\n    \"\"\"\n    Calculates base to the specified power and returns the sum of its decimal digits.\n    The sum is computed over the absolute value of the result.\n    \"\"\"\n    result = base ** power\n    abs_result_str = str(abs(result))\n    return sum(int(digit) for digit in abs_result_str)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/726": [{"task_id": "Mbpp/726", "solution": "def multiply_elements(numbers_tuple):\n    \"\"\"\n    Calculates the product of adjacent elements in a tuple of numbers.\n    Given (t_1,...,t_{N+1}), returns (t_1*t_2, t_2*t_3, ..., t_N*t_{N+1]).\n    \"\"\"\n    return tuple(numbers_tuple[i] * numbers_tuple[i+1] for i in range(len(numbers_tuple) - 1))", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/725": [{"task_id": "Mbpp/725", "solution": "def extract_quotation(s: str) -> list:\n    \"\"\"\n    Extracts values between double quotation marks \" \" from the given string.\n    Escaped quotes (e.g., \\\") are treated as literal characters within the quoted string\n    and not as delimiters. Unmatched quotes are ignored.\n    \"\"\"\n\n    def _is_escaped(text, index):\n        \"\"\"\n        Helper to check if the character at `index` is escaped by an odd number\n        of preceding backslashes.\n        \"\"\"\n        count = 0\n        j = index - 1\n        while j >= 0 and text[j] == '\\\\':\n            count += 1\n            j -= 1\n        return count % 2 == 1\n\n    def _unescape_string(text_segment):\n        \"\"\"\n        Replace escaped sequences \\\" -> \" and \\\\ -> \\ within a string segment.\n        Other backslash sequences are preserved as literal sequences.\n        \"\"\"\n        result_chars = []\n        i = 0\n        n = len(text_segment)\n        while i < n:\n            ch = text_segment[i]\n            if ch == '\\\\' and i + 1 < n:\n                nxt = text_segment[i + 1]\n                if nxt == '\"':\n                    result_chars.append('\"')\n                    i += 2\n                elif nxt == '\\\\':\n                    result_chars.append('\\\\')\n                    i += 2\n                else:\n                    # Preserve other escape sequences as two literal characters\n                    result_chars.append('\\\\')\n                    result_chars.append(nxt)\n                    i += 2\n            else:\n                result_chars.append(ch)\n                i += 1\n        return ''.join(result_chars)\n\n    results = []\n    in_quote = False\n    current_segment_chars = []\n\n    i = 0\n    n = len(s)\n    while i < n:\n        ch = s[i]\n        if ch == '\"':\n            # Check if this quote character is a delimiter (i.e., not escaped)\n            if not _is_escaped(s, i):\n                if not in_quote:\n                    # Opening delimiter\n                    in_quote = True\n                    current_segment_chars = []\n                else:\n                    # Closing delimiter\n                    in_quote = False\n                    raw_segment = ''.join(current_segment_chars)\n                    results.