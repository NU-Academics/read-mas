n    Convert a snake_case string to PascalCase (UpperCamelCase).\n    Empty segments from underscores are ignored.\n    \"\"\"\n    def _normalize_underscores_inline(text: str) -> str:\n        \"\"\"Helper to collapse multiple underscores into a single one.\"\"\"\n        if not text:\n            return \"\"\n\n        result_chars = []\n        last_char_was_underscore = False\n        for char in text:\n            if char == '_':\n                if not last_char_was_underscore:\n                    result_chars.append('_')\n                last_char_was_underscore = True\n            else:\n                result_chars.append(char)\n                last_char_was_underscore = False\n        return \"\".join(result_chars)\n\n    # 1. Sanitize the string: strip whitespace, collapse multiple underscores, remove leading/trailing underscores.\n    s = s.strip()\n    s = _normalize_underscores_inline(s)\n    sanitized = s.strip(\"_\")\n\n    if not sanitized:\n        return \"\"\n\n    # 2. Split the sanitized string by '_' and filter out empty segments.\n    segments = [segment for segment in sanitized.split(\"_\") if segment]\n\n    # 3. Convert each segment to capitalized form and join them.\n    camel_case_segments = []\n    for segment in segments:\n        camel_case_segments.append(segment[0].upper() + segment[1:].lower())\n\n    return \"\".join(camel_case_segments)", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [["___python_program"]]}], "Mbpp/100": [{"task_id": "Mbpp/100", "solution": "def next_smallest_palindrome(n: int) -> int:\n    \"\"\"\n    Finds the next smallest palindrome integer strictly greater than the input integer n.\n    Handles negative numbers, treating the smallest palindrome greater than them as 0.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"Input must be an integer\")\n\n    if n < 0:\n        return 0\n\n    s = str(n)\n    length = len(s)\n\n    # Determine left half length (including middle digit for odd lengths)\n    left_half_len = (length + 1) // 2\n    left_half_str = s[:left_half_len]\n\n    # Build candidate by mirroring\n    first_half_for_mirror = s[:length // 2]\n    mid_char = s[length // 2] if length % 2 == 1 else ''\n    candidate_val_str = first_half_for_mirror + mid_char + first_half_for_mirror[::-1]\n    candidate_val = int(candidate_val_str)\n\n    if candidate_val > n:\n        return candidate_val\n\n    # Increment the left half (including middle when present), then mirror again\n    left_half_num = int(left_half_str) + 1\n    new_left_half_str = str(left_half_num)\n\n    # Overflow happened (e.g., 9 -> 10, 99 -> 100) and increases total length\n    if len(new_left_half_str) > left_half_len:\n        new_length = length + 1\n        # For new length, construct palindrome like 100...001 or 10...01 depending on parity\n        # e.g., 9 -> 11, 99 -> 101, 1999 -> 2002\n        if new_length % 2 == 0:\n            left = new_left_half_str[: new_length // 2]\n            return int(left + left[::-1])\n        else:\n            left = new_left_half_str[: new_length // 2]\n            mid = new_left_half_str[new_length // 2]\n            return int(left + mid + left[::-1])\n    else:\n        # No overflow: mirror the updated left half appropriately\n        if length % 2 == 0:\n            left = new_left_half_str\n            return int(left + left[::-1])\n        else:\n            left = new_left_half_str[:-1]\n            mid = new_left_half_str[-1]\n            return int(left + mid + left[::-1])", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/104": [{"task_id": "Mbpp/104", "solution": "from typing import List, Tuple, Iterable, Any, Union\nclass SortSublistsError(Exception):\n    \"\"\"Base exception for the sort_sublists library.\"\"\"\n    pass\nclass InvalidInputError(SortSublistsError):\n    \"\"\"Exception raised for general invalid input issues.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\nclass SublistTypeError(InvalidInputError):\n    \"\"\"Exception raised when a sublist has an unexpected type.\"\"\"\n    def __init__(self, index: int, expected: str, actual: str) -> None:\n        super().__init__(f\"Sublist at index {index} expected {expected} but got {actual}\")\n        self.index = index\n        self.expected = expected\n        self.actual = actual\nclass ElementTypeError(InvalidInputError):\n    \"\"\"Exception raised when an element within a sublist is not a string.\"\"\"\n    def __init__(self, sublist_index: int, elem_index: int, actual_type: str) -> None:\n        super().__init__(f\"Element at {sublist_index}[{elem_index}] has invalid type {actual_type}\")\n        self.sublist_index = sublist_index\n        self.elem_index = elem_index\n        self.actual_type = actual_type\nclass InputValidator:\n    \"\"\"Validates the input collection for type and content.\"\"\"\n    ALLOWED_TOP_TYPES = (list, tuple)\n    ALLOWED_SUB_TYPES = (list, tuple)\n\n    def __init__(self) -> None:\n        pass\n\n    def validate(self, input_collection: Any) -> Tuple[Tuple[str, ...], ...]:\n        \"\"\"\n        Validates input_collection and normalizes it to a tuple of tuples of strings.\n        Raises specific exceptions for invalid types or elements.\n        \"\"\"\n        if not isinstance(input_collection, self.ALLOWED_TOP_TYPES):\n            raise InvalidInputError(\"Top-level container must be list or tuple\")\n\n        normalized_collection: List[Tuple[str, ...]] = []\n        for i, sub in enumerate(input_collection):\n            if not isinstance(sub, self.ALLOWED_SUB_TYPES):\n                raise SublistTypeError(i, \"list/tuple\", type(sub).__name__)\n\n            normalized_sub: List[str] = []\n            for j, elem in enumerate(sub):\n                if not isinstance(elem, str):\n                    raise ElementTypeError(i, j, type(elem).__name__)\n                normalized_sub.append(elem)\n            normalized_collection.append(tuple(normalized_sub))\n\n        return tuple(normalized_collection)\nclass SortService:\n    \"\"\"Provides the core logic for sorting sublists.\"\"\"\n    def __init__(self) -> None:\n        pass\n\n    def sort_sublists(self, validated_input: Tuple[Tuple[str, ...], ...]) -> Tuple[Tuple[str, ...], ...]:\n        \"\"\"\n        Sorts each inner tuple of strings in the validated input.\n        Returns a new tuple of tuples with sorted strings.\n        \"\"\"\n        result: List[Tuple[str, ...]] = []\n        for sub in validated_input:\n            sorted_sub = tuple(sorted(sub))\n            result.append(sorted_sub)\n        return tuple(result)\nclass SortController:\n    \"\"\"Orchestrates validation and sorting, exposes public API.\"\"\"\n    def __init__(self, validator: InputValidator, service: SortService) -> None:\n        self.validator = validator\n        self.service = service\n\n    def sort_sublists(self, input_collection: Union[List[Iterable[str]], Tuple[Iterable[str], ...]]) -> Tuple[Tuple[str, ...], ...]:\n        \"\"\"\n        Validates the input, sorts each sublist, and returns an immutable tuple of tuples.\n        This is the public entry point for the sorting functionality.\n        \"\"\"\n        validated = self.validator.validate(input_collection)\n        result = self.service.sort_sublists(validated)\n        return result\n_controller = SortController(InputValidator(), SortService())\ndef sort_sublists(input_collection: Union[List[Iterable[str]], Tuple[Iterable[str], ...]]) -> Tuple[Tuple[str, ...], ...]:\n    \"\"\"\n    Sorts each sublist of strings in the given list or tuple of lists/tuples.\n    Returns a new tuple of tuples where each inner tuple contains sorted strings.\n    \"\"\"\n    return _controller.sort_sublists(input_collection)", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[[["green", "orange"], ["bl