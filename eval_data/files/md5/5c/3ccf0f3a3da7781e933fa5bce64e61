enizer: 'Tokenizer' = None):\n            self.sanitizer = sanitizer or StringUtils()\n            self.tokenizer = tokenizer or Tokenizer()\n\n        def parse(self, tuple_str: str) -> TupleDTO:\n            inner = self.sanitizer.sanitize_tuple_str(tuple_str)\n            tokens = self.tokenizer.tokenize(inner)\n            values = self._convert_tokens(tokens)\n            return TupleDTO(typing.cast(typing.Tuple[int, ...], tuple(values)))\n\n        def _convert_tokens(self, tokens: typing.List[str]) -> typing.Tuple[int, ...]:\n            converted = []\n            for t in tokens:\n                try:\n                    converted.append(int(t, 10))\n                except ValueError as e:\n                    raise ValueError(f\"Invalid integer token '{t}'\") from e\n            return typing.cast(typing.Tuple[int, ...], tuple(converted))\n\n    class TupleService:\n        def __init__(self, parser: 'TupleParser' = None):\n            self.parser = parser or TupleParser()\n\n        def parse_and_validate(self, tuple_str: str) -> typing.Tuple[int, ...]:\n            if tuple_str is None or not isinstance(tuple_str, str) or tuple_str.strip() == '':\n                raise ValueError(\"Input must be a non-empty string\")\n            dto = self.parser.parse(tuple_str)\n            return dto.to_tuple()\n\n    _service_instance = TupleService()\n    return _service_instance.parse_and_validate(tuple_str)", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [["((7, 8, 9)"]]}], "Mbpp/788": [{"task_id": "Mbpp/788", "solution": "def new_tuple(items: list[str], extra: str) -> tuple[str, ...]:\n    \"\"\"\n    Creates a new tuple from a list of strings and an additional string, with validation.\n    All helper components are defined inline to meet specific completion requirements.\n    \"\"\"\n\n    class ValidationError(Exception):\n        \"\"\"Custom exception for validation failures.\"\"\"\n        def __init__(self, messag