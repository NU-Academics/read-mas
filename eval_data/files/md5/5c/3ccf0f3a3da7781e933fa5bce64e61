 list(arr)\n    n = len(a)\n\n    if n == 0:\n        return 0\n    if n == 1:\n        return a[0]\n\n    lis_sums = _compute_lis_sums_local(a)  # Max sum of increasing subsequence ending at each index.\n    mds_sums = _compute_mds_sums_local(a)  # Max sum of decreasing subsequence starting at each index.\n\n    max_bitonic_sum = 0\n    for i in range(n):\n        # Calculate sum for current peak 'a[i]', subtracting 'a[i]' as it's counted twice.\n        current_bitonic_sum = lis_sums[i] + mds_sums[i] - a[i]\n        max_bitonic_sum = max(max_bitonic_sum, current_bitonic_sum)\n\n    return max_bitonic_sum", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/86": [{"task_id": "Mbpp/86", "solution": "import shelve\nfrom typing import Any, Optional\nclass InvalidInputError(ValueError):\n    \"\"\"Raised for invalid input values according to business rules.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\ndef validate_positive_int(n: Any) -> int:\n    \"\"\"Validates if n is a positive integer (>= 1) and converts it to int.\"\"\"\n    try:\n        i = int(n)\n    except (TypeError, ValueError):\n        raise InvalidInputError(f\"n must be an integer, got {n!r}\")\n    if i < 1:\n        raise InvalidInputError(f\"n must be >= 1, got {i}\")\n    return i\ndef compute_formula(n: int) -> int:\n    \"\"\"Calculates the nth centered hexagonal number using its closed-form formula.\"\"\"\n    return 3 * n * (n - 1) + 1\nDEFAULT_CACHE_FILE = \"centered_hexagonal_cache.db\"\nclass CacheRepository:\n    \"\"\"Manages in-memory and optional disk-persisted cache for hexagonal numbers.\"\"\"\n    def __init__(self, persist: bool = True, filename: str = DEFAULT_CACHE_FILE):\n        self._persist = persist\n        self._filename = filename\n        self._memory_cache: dict[int, int] = {}\n        self._shelf = None\n\n    def _open_shelf(self):\n        \"\"\"Lazily opens the shelve file for disk persistence.\"\"\"\n        if not self._shelf and self._persist:\n            try:\n                self._shelf = shelve.open(self._filename)\n            except Exception:\n                self._persist = False # Fallback to memory-only on failure\n\n    def get(self, n: int) -> Optional[int]:\n        \"\"\"Retrieves a cached value by n, checking memory then disk.\"\"\"\n        if n in self._memory_cache:\n            return self._memory_cache[n]\n        if self._persist:\n            try:\n                self._open_shelf()\n                if self._shelf and str(n) in self._shelf:\n                    val = int(self._shelf[str(n)])\n                    self._memory_cache[n] = val\n                    return val\n            except Exception:\n                self._persist = False # Fallback to memory-only on read error\n        return None\n\n    def set(self, n: int, value: int) -> None:\n        \"\"\"Stores a value in the memory cache and persists it to disk if enabled.\"\"\"\n        self._memory_cache[n] = value\n        if self._persist:\n            try:\n                self._open_shelf()\n                if self._shelf:\n                    self._shelf[str(n)] = value\n                    self._shelf.sync()\n            except Exception:\n                self._persist = False # Fallback to memory-only on write error\n\n    def close(self) -> None:\n        \"\"\"Closes the underlying shelve file if it was opened.\"\"\"\n        if self._shelf:\n            self._shelf.close()\n            self._shelf = None\nclass CenteredHexagonalService:\n    \"\"\"Core service for computing centered hexagonal numbers, handling validation and caching.\"\"\"\n    def __init__(self, cache_repo: Optional[CacheRepository] = None):\n        self._cache = cache_repo or CacheRepository()\n\n    def calculate(self, n: int) -> int:\n        \"\"\"Calculates the nth centered hexagonal number, using cache if available.\"\"\"\n        i = validate_positive_int(n)\n        cached = self._cache.get(i)\n        if cached is not None:\n            return cached\n        value = compute_formula(i)\n        try:\n            self._cache.set(i, value)\n        except Exception:\n            pass # Caching is best-effort; ignore failures.\n        return value\n_default_repo = CacheRepository()\n_default_service = CenteredHexagonalService(cache_repo=_default_repo)\ndef centered_hexagonal_number(n: int) -> int:\n    \"\"\"\n    Computes the nth centered hexagonal number for a positive integer n.\n    It leverages an internal service with caching and input validation.\n    \"\"\"\n    return _default_service.calculate(n)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/252": [{"task_id": "Mbpp/252", "solution": "import math\ndef convert(value):\n    \"\"\"\n    Converts a complex number to its polar coordinates (radius, angle).\n    It handles numeric and complex string inputs, returning (r: float, theta: float).\n    \"\"\"\n    c = complex(value)\n    r = math.hypot(c.real, c.imag)\n\n    if r == 0.0:\n        theta = 0.0\n    else:\n        theta = math.atan2(c.imag, c.real)\n\n    return r, theta", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/250": [{"task_id": "Mbpp/250", "solution": "def count_X(data: tuple, element: object) -> int:\n    \"\"\"Counts the occurrences of an element in a tuple.\"\"\"\n    count = 0\n    for item in data:\n        if item == element:\n            count += 1\n    return count", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/239": [{"task_id": "Mbpp/239", "solution": "def get_total_number_of_sequences(m: int, n: int) -> int:\n    \"\"\"\n    Calculates the total number of sequences of length n,\n    such that each element is a positive integer and is greater than\n    or equal to twice the previous element but less than or equal to m.\n    \"\"\"\n\n    class DPRepository:\n        \"\"\"Manages memoization for dynamic programming states.\"\"\"\n        def __init__(self):\n            self._store = {}\n\n        def get(self, key: tuple) -> int | None:\n            \"\"\"Retrieves a cached value for the given state key.\"\"\"\n            return self._store.get(key)\n\n        def set(self, key: tuple, value: int) -> None:\n            \"\"\"Stores a value for the given state key.\"\"\"\n            self._store[key] = value\n\n    class SequenceCounterService:\n        \"\"\"Core service to count valid sequences using dynamic programming.\"\"\"\n        def __init__(self, repository: DPRepository | None = None):\n            self.repository = repository if repository is not None else DPRepository()\n            self._m = 0 # This will store the maximum allowed value for elements\n\n        def count_total_sequences(self, m_param: int, n_param: int) -> int:\n            \"\"\"\n            Initiates the sequence counting process by considering all possible\n            starting values and summing their sequence counts.\n            \"\"\"\n            if not isinstance(m_param, int) or not isinstance(n_param, int):\n                raise TypeError(\"m and n must be integers\")\n            if m_param < 1 or n_param < 1:\n                raise ValueError(\"m and n must be positive integers (>=1)\")\n\n            self._m = m_param  # Store m for use in recursive calls\n            total_sequences = 0\n            # The first element 'a1' can be any integer from 1 to m.\n            # We then recursively find sequences of length (n-1) that follow 'a1'.\n            for first_element in range(1, m_param + 1):\n                total_sequences += self._count_from_value(first_element, n_param - 1)\n            return total_sequences\n\n        def _count_from_value(self, current_value: int, remaining_length: int) -> int:\n            \"\"\"\n            Recursively counts valid sequences starting with `current_value`\n            and needing `remaining_length` more elements.\n            \"\"\"\n            key = (current_value, remaining_length)\n            cached_result = self.repository.get(key)\n            if cached_result is not None:\n                return cached_result\n\n            # Base case: If no more elements are needed, a valid sequence of length n has been formed.\n            if remaining_length == 0:\n                self.repository.set(key, 1)\n                return 1\n\n            # Calculate the minimum possible value for the next element.\n            next_min_value = 2 * current_value\n\n            # If the next element must exceed 'm', no valid sequence can be formed from this point.\n            if next_min_value > self._m:\n                self.repository.set(key, 0)\n                return 0\n\n            # Recursive step: Sum counts from all possible next elements.\n            count = 0\n            for next_element in range(next_min_value, self._m + 1):\n                count += self._count_from_value(next_element, remaining_length - 1)\n\n            self.repository.set(key, count)\n            return count\n\n    # Instantiate the service with an in-memory repository and compute the total.\n    service = SequenceCounterService()\n    return service.count_total_sequences(m, n)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/259": [{"task_id": "Mbpp/259", "solution": "def maximize_elements(a, b):\n    \"\"\"\n    Computes the element-wise maximum of two tuples of tuples.\n    \"\"\"\n    result = []\n    for inner_tuple_a, inner_tuple_b in zip(a, b):\n        max_inner_tuple = tuple(max(x, y) for x, y in zip(inner_tuple_a, inner_tuple_b))\n        result.append(max_inner_tuple)\n    return tuple(result)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/262": [{"task_id": "Mbpp/262", "solution": "def split_two_parts(lst, L):\n    \"\"\"\n    Splits a list into two parts based on a given length L for the first part.\n    The first part will have length L (or less if L is negative or greater than the list length).\n    \"\"\"\n    actual_L = max(L, 0)\n    first_part = lst[:actual_L]\n    second_part = lst[actual_L:]\n    return (first_part, second_part)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/261": [{"task_id": "Mbpp/261", "solution": "class DivisionError(Exception):\n    def __init__(self, code: str, message: str) -> None:\n        self.code = code\n        self.message = message\n        super().__init__(f\"{code}: {message}\")\nclass TupleOperands:\n    def __init__(self, values: tuple[int, ...]) -> None:\n        # Defensive check; primary validation is in InputValidator.\n        if not isinstance(values, tuple):\n            raise ValueError(\"values must be a tuple\")\n        self.values: tuple[int, ...] = values\n\n    @classmethod\n    def from_raw(cls, values: tuple[int, ...]) -> \"TupleOperands\":\n        return cls(values)\n\n    def __len__(self) -> int:\n        return len(self.values)\n\n    def __getitem__(self, idx: int) -> int:\n        return self.values[idx]\nclass DivisionResult:\n    def __init__(self, result: tuple[int, ...]) -> None:\n        self.result: tuple[int, ...] = result\n\n    def as_tuple(self) -> tuple[int, ...]:\n        return self.result\nclass TupleOperandsPair:\n    def __init__(self, left: TupleOperands, right: TupleOperands) -> None:\n        self.left = left\n        self.right = right\nclass InputValidator:\n    @staticmethod\n    def validate(left: object, right: object) -> TupleOperandsPair:\n        # Validates input types, lengths, and element types, raising DivisionError on invalid input.\n        if not isinstance(left, tuple) or not isinstance(right, tuple):\n            raise DivisionError(\"INVALID_TYPE\", \"Both operands must be tuples\")\n        if len(left) != len(right):\n            rais