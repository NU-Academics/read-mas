{"task_id": "HumanEval/87", "solution": "def get_row(lst, x):\n    \"\"\"\n    Find all coordinates (row_index, col_index) where value == x in a nested list.\n    Rows may have different lengths. Coordinates are sorted by row ascending,\n    and within the same row by column descending.\n    \"\"\"\n    results = []\n    for row_idx, row in enumerate(lst):\n        for col_idx, val in enumerate(row):\n            if val == x:\n                results.append((row_idx, col_idx))\n    results.sort(key=lambda coord: (coord[0], -coord[1]))\n    return results"}
{"task_id": "HumanEval/87", "solution": "def get_row(lst, x):\n    \"\"\"\n    Finds all occurrences of x in a nested list and returns their (row, column) coordinates.\n    The coordinates are sorted by row ascending, then by column descending.\n    \"\"\"\n    coordinates = []\n    for r_idx, row_list in enumerate(lst):\n        for c_idx, item in enumerate(row_list):\n            if item == x:\n                coordinates.append((r_idx, c_idx))\n\n    coordinates.sort(key=lambda coord: (coord[0], -coord[1]))\n\n    return coordinates"}
{"task_id": "HumanEval/86", "solution": "def anti_shuffle(s):\n    \"\"\"\n    Transforms a string by sorting characters within each word, preserving word order and spaces.\n    Characters are sorted by ASCII/codepoint value.\n    \"\"\"\n    if not s:\n        return s\n\n    words = s.split(' ')\n    sorted_words = [\n        word if not word else \"\".join(sorted(word))\n        for word in words\n    ]\n    return ' '.join(sorted_words)"}
{"task_id": "HumanEval/88", "solution": "def sort_array(array):\n    \"\"\"\n    Sorts a copy of the array based on the parity of the sum of its first and last elements.\n    Sorts ascending if odd, descending if even; handles empty or single-element arrays.\n    \"\"\"\n    if not array:\n        return []\n\n    if len(array) == 1:\n        return list(array)\n\n    # Determine sorting order based on the sum of the first and last elements\n    sum_first_last = array[0] + array[-1]\n    sort_ascending = (sum_first_last % 2) == 1\n\n    # Use Python's built-in sorted() which returns a new list, ensuring the input is not mutated\n    if sort_ascending:\n        return sorted(array)\n    else:\n        return sorted(array, reverse=True)"}
{"task_id": "HumanEval/88", "solution": "def sort_array(array):\n    \"\"\"\n    Sorts a copy of the array based on the parity of the sum of its first and last elements.\n    If the sum is odd, it sorts ascending; if even, it sorts descending.\n    \"\"\"\n    arr_copy = list(array)\n    if not arr_copy or len(arr_copy) == 1:\n        return arr_copy\n\n    first_element = arr_copy[0]\n    last_element = arr_copy[-1]\n\n    if (first_element + last_element) % 2 != 0:  # Sum is odd, sort ascending\n        arr_copy.sort()\n    else:  # Sum is even, sort descending\n        arr_copy.sort(reverse=True)\n\n    return arr_copy"}
{"task_id": "HumanEval/89", "solution": "def encrypt(s):\n    \"\"\"Encrypts a string by rotating the alphabet.\n    Letters shift down by four places, non-letters remain unchanged.\"\"\"\n    result = []\n    for char in s:\n        if 'a' <= char <= 'z':\n            # Shift by 2 * 2 = 4 places\n            shifted_char_code = ord('a') + (ord(char) - ord('a') + 4) % 26\n            result.append(chr(shifted_char_code))\n        else:\n            result.append(char)\n    return \"\".join(result)"}
