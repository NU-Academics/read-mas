{"task_id": "HumanEval/108", "solution": "def count_nums(arr):\n    \"\"\"\n    Counts elements in arr where the sum of digits (with first digit negative for negative numbers) is greater than 0.\n    \"\"\"\n    count = 0\n    for n in arr:\n        total = 0\n        if n >= 0:\n            s = str(n)\n            total = sum(int(ch) for ch in s)\n        else:\n            s = str(abs(n))\n            # The first digit of the absolute value is negated.\n            first = -int(s[0])\n            # The rest of the digits are summed as positive.\n            rest = sum(int(ch) for ch in s[1:]) if len(s) > 1 else 0\n            total = first + rest\n\n        if total > 0:\n            count += 1\n    return count"}
{"task_id": "HumanEval/108", "solution": "def count_nums(arr):\n    \"\"\"\n    Write a function count_nums which takes an array of integers and returns\n    the number of elements which has a sum of digits > 0.\n    If a number is negative, then its first signed digit will be negative:\n    e.g. -123 has signed digits -1, 2, and 3.\n    >>> count_nums([]) == 0\n    >>> count_nums([-1, 11, -11]) == 1\n    >>> count_nums([1, 1, 2]) == 3\n    \"\"\"\n    count = 0\n    for n in arr:\n        if n == 0:\n            digit_sum = 0\n        else:\n            s = str(abs(n))\n            if n < 0:\n                signed_first = -int(s[0])\n                rest_sum = sum(int(d) for d in s[1:]) if len(s) > 1 else 0\n                digit_sum = signed_first + rest_sum\n            else:  # n > 0\n                digit_sum = sum(int(d) for d in s)\n\n        if digit_sum > 0:\n            count += 1\n\n    return count"}
{"task_id": "HumanEval/109", "solution": "def move_one_ball(arr):\n    \"\"\"Determines if an array can be made non-decreasing by right circular shifts.\n    It counts cyclic 'drops' where an element is greater than its successor.\"\"\"\n    n = len(arr)\n    if n <= 1:\n        return True\n\n    drops = 0\n    for i in range(n):\n        # Compare current element with the next element in a circular manner\n        if arr[i] > arr[(i + 1) % n]:\n            drops += 1\n\n        # If more than one drop is found, it's not a rotated sorted array\n        if drops > 1:\n            return False\n\n    # Return True if there's 0 or 1 drop, indicating it's a valid rotation\n    return True"}
{"task_id": "HumanEval/110", "solution": "def exchange(lst1, lst2):\n    \"\"\"Determines if elements can be exchanged between lst1 and lst2 to make all elements of lst1 even.\n    Returns \"YES\" if possible, otherwise \"NO\".\"\"\"\n\n    total_evens = 0\n\n    # Count even elements in lst1\n    for x in lst1:\n        if x % 2 == 0:\n            total_evens += 1\n\n    # Count even elements in lst2\n    for x in lst2:\n        if x % 2 == 0:\n            total_evens += 1\n\n    # Check if the total number of available evens is sufficient for lst1\n    if total_evens >= len(lst1):\n        return \"YES\"\n    else:\n        return \"NO\""}
{"task_id": "HumanEval/109", "solution": "def move_one_ball(arr):\n    \"\"\"We have an array 'arr' of N integers arr[1], arr[2], ..., arr[N].The\n    numbers in the array will be randomly ordered. Your task is to determine if\n    it is possible to get an array sorted in non-decreasing order by performing\n    the following operation on the given array:\n        You are allowed to perform right shift operation any number of times.\n\n    One right shift operation means shifting all elements of the array by one\n    position in the right direction. The last element of the array will be moved to\n    the starting position in the array i.e. 0th index.\n\n    If it is possible to obtain the sorted array by performing the above operation\n    then return True else return False.\n    If the given array is empty then return True.\n\n    Note: The given list is guaranteed to have unique elements.\n\n    For Example:\n\n    move_one_ball([3, 4, 5, 1, 2])==>True\n    Explanation: By performin 2 right shift operations, non-decreasing order can\n                 be achieved for the given array.\n    move_one_ball([3, 5, 4, 1, 2])==>False\n    Explanation:It is not possible to get non-decreasing order for the given\n                array by performing any number of right shift operations.\n\n    \"\"\"\n    n = len(arr)\n\n    # Handle empty or single-element arrays as trivially sorted.\n    if n <= 1:\n        return True\n\n    count = 0\n    # Iterate through the array, comparing each element to the next (cyclically).\n    for i in range(n):\n        # Use modulo operator to handle the wraparound comparison from last to first element.\n        if arr[i] > arr[(i + 1) % n]:\n            count += 1\n\n    # If there is at most one \"drop\" (inversion), it can be sorted by rotation.\n    return count <= 1"}
{"task_id": "HumanEval/111", "solution": "from collections import Counter\n\ndef histogram(test):\n    \"\"\"Given a string of space-separated letters, compute the most frequent letter(s) and their counts.\n    Returns a dictionary mapping each most-frequent letter to its count.\n    \"\"\"\n    tokens = test.split()\n    counts = Counter(tokens)\n\n    if not counts:\n        return {}\n\n    max_count = max(counts.values())\n\n    result = {}\n    for letter, count in counts.items():\n        if count == max_count:\n            result[letter] = count\n\n    return result"}
{"task_id": "HumanEval/110", "solution": "def exchange(lst1, lst2):\n    \"\"\"Determines if it's possible to make lst1 all even by exchanging elements.\n    It counts total even numbers and checks if there are enough for lst1.\"\"\"\n    total_evens = 0\n    for num in lst1:\n        if num % 2 == 0:\n            total_evens += 1\n\n    for num in lst2:\n        if num % 2 == 0:\n            total_evens += 1\n\n    if total_evens >= len(lst1):\n        return \"YES\"\n    else:\n        return \"NO\""}
{"task_id": "HumanEval/112", "solution": "def reverse_delete(s, c):\n    \"\"\"Deletes characters from s found in c, then checks if the resulting string is a palindrome.\n    Returns the modified string and a boolean indicating if it's a palindrome.\n    \"\"\"\n    chars_to_delete = set(c)\n    result_chars = []\n    for char_s in s:\n        if char_s not in chars_to_delete:\n            result_chars.append(char_s)\n\n    result_string = \"\".join(result_chars)\n    is_palindrome = (result_string == result_string[::-1])\n\n    return (result_string, is_palindrome)"}
{"task_id": "HumanEval/112", "solution": "def reverse_delete(s,c):\n    \"\"\"Delete characters from s that appear in c, then check if the result is a palindrome.\n    Returns a tuple: (result_string, is_palindrome).\n    \"\"\"\n    to_remove = set(c)\n    result = ''.join(ch for ch in s if ch not in to_remove)\n    return (result, result == result[::-1])"}
{"task_id": "HumanEval/111", "solution": "def histogram(test):\n    \"\"\"Given a string of space-separated letters, returns a dictionary of letters\n    with the maximum repetition and their counts. If multiple letters share the max count, all are returned.\n    \"\"\"\n    if not test:\n        return {}\n\n    counts = {}\n    for letter in test.split():\n        counts[letter] = counts.get(letter, 0) + 1\n\n    if not counts:\n        return {}\n\n    max_count = 0\n    for count in counts.values():\n        if count > max_count:\n            max_count = count\n\n    result = {}\n    for letter, count in counts.items():\n        if count == max_count:\n            result[letter] = count\n\n    return result"}
{"task_id": "HumanEval/115", "solution": "def max_fill(grid, capacity):\n    \"\"\"\n    Calculates the minimum number of times buckets need to be lowered to empty all wells.\n    Each well is a list of 0/1 values; capacity is the bucket capacity.\n    \"\"\"\n    total_bucket_lowerings = 0\n    for well in grid:\n        water_in_current_well = sum(well)\n        if water_in_current_well > 0:\n            lowerings_for_well = (water_in_current_well + capacity - 1) // capacity\n            total_bucket_lowerings += lowerings_for_well\n    return total_bucket_lowerings"}
{"task_id": "HumanEval/114", "solution": "def minSubArraySum(nums):\n    \"\"\"\n    Given an array of integers nums, find the minimum sum of any non-empty contiguous subarray.\n    Raises ValueError if nums is empty.\n    \"\"\"\n    # Accept any iterable but work with a sequence for len/indexing without unnecessary copies\n    if isinstance(nums, (list, tuple)):\n        seq = nums\n    else:\n        seq = list(nums)\n\n    if len(seq) == 0:\n        raise ValueError(\"nums must be non-empty\")\n\n    min_so_far = current_min = seq[0]\n    for x in seq[1:]:\n        # If current_min > 0, starting new subarray at x is better; otherwise extend\n        current_min = x if current_min > 0 else current_min + x\n        if current_min < min_so_far:\n            min_so_far = current_min\n\n    return min_so_far"}
{"task_id": "HumanEval/115", "solution": "import math\n\ndef max_fill(grid, capacity):\n    \"\"\"\n    Calculates the total number of times buckets need to be lowered to empty all wells.\n    Each 1 in a grid row represents a unit of water, and buckets have a fixed capacity.\n    \"\"\"\n    total_lowerings = 0\n    for well in grid:\n        water_units = sum(well)\n        if water_units > 0:\n            total_lowerings += math.ceil(water_units / capacity)\n    return total_lowerings"}
{"task_id": "HumanEval/113", "solution": "def odd_count(lst):\n    \"\"\"Given a list of digit-only strings, return a list of formatted messages\n    where each message reports the number of odd digits in the corresponding input string,\n    replacing each 'i' in the template with that number.\n    \"\"\"\n    result = []\n    for s in lst:\n        count = sum(1 for ch in s if ch in \"13579\")\n        result.append(f\"the number of odd elements {count}n the str{count}ng {count} of the {count}nput.\")\n    return result"}
{"task_id": "HumanEval/114", "solution": "def minSubArraySum(nums):\n    \"\"\"\n    Given an array of integers nums, find the minimum sum of any non-empty sub-array of nums.\n    Returns the minimum subarray sum.\n    Raises ValueError if nums is empty.\n    \"\"\"\n    if not nums:\n        raise ValueError(\"nums must be a non-empty sequence\")\n\n    min_so_far = current_min = nums[0]\n    for x in nums[1:]:\n        current_min = min(x, current_min + x)\n        min_so_far = min(min_so_far, current_min)\n    return min_so_far"}
