{"task_id": "HumanEval/33", "solution": "def sort_third(l: list):\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the indicies that are not divisible by three, while its values at the indicies that are divisible by three are equal\n    to the values of the corresponding indicies of l, but sorted.\n    >>> sort_third([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_third([5, 6, 3, 4, 8, 9, 2])\n    [2, 6, 3, 4, 8, 9, 5]\n    \"\"\"\n    elements_to_sort = []\n    indices_to_replace = []\n    for i, x in enumerate(l):\n        if i % 3 == 0:\n            elements_to_sort.append(x)\n            indices_to_replace.append(i)\n\n    elements_to_sort.sort()\n\n    result = list(l) # Create a copy of the original list.\n    for i, sorted_val in zip(indices_to_replace, elements_to_sort):\n        result[i] = sorted_val\n\n    return result"}
{"task_id": "HumanEval/36", "solution": "def fizz_buzz(n: int):\n    \"\"\"Return the count of '7's in numbers less than n, divisible by 11 or 13.\n    This implementation follows the preferred algorithm from the design specification.\n    \"\"\"\n    total_sevens = sum(\n        str(i).count('7') for i in range(n) if i % 11 == 0 or i % 13 == 0\n    )\n    return total_sevens"}
{"task_id": "HumanEval/36", "solution": "def fizz_buzz(n: int):\n    \"\"\"Return the number of times the digit 7 appears in integers less than n which are divisible by 11 or 13.\n    >>> fizz_buzz(50)\n    0\n    >>> fizz_buzz(78)\n    2\n    >>> fizz_buzz(79)\n    3\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an int\")\n    if n <= 0:\n        return 0\n\n    multiples = set()\n\n    # Add multiples of 11\n    for k in range(11, n, 11):\n        multiples.add(k)\n\n    # Add multiples of 13\n    for k in range(13, n, 13):\n        multiples.add(k)\n\n    total_sevens = 0\n    for x in multiples:\n        total_sevens += str(x).count('7')\n\n    return total_sevens"}
{"task_id": "HumanEval/37", "solution": "def sort_even(l: list):\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the odd indicies, while its values at the even indicies are equal\n    to the values of the even indicies of l, but sorted.\n    >>> sort_even([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_even([5, 6, 3, 4])\n    [3, 6, 5, 4]\n    \"\"\"\n    if not l:\n        return []\n\n    # Extract values at even indices\n    even_vals = [l[i] for i in range(0, len(l), 2)]\n\n    # Sort the extracted values\n    sorted_even = sorted(even_vals)\n\n    # Create a copy of original list to preserve odd positions\n    result = l.copy()\n\n    # Iterate over even indices and assign values from sorted_even\n    even_idx_in_sorted_even = 0\n    for i in range(0, len(l), 2):\n        result[i] = sorted_even[even_idx_in_sorted_even]\n        even_idx_in_sorted_even += 1\n\n    return result"}
{"task_id": "HumanEval/37", "solution": "def sort_even(l: list):\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the odd indicies, while its values at the even indicies are equal\n    to the values of the even indicies of l, but sorted.\n    >>> sort_even([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_even([5, 6, 3, 4])\n    [3, 6, 5, 4]\n    \"\"\"\n    if not isinstance(l, list):\n        raise TypeError(\"l must be a list\")\n\n    # Create a shallow copy of the original list for modification.\n    result = l.copy()\n\n    # Extract elements at even indices.\n    even_values = [l[i] for i in range(0, len(l), 2)]\n\n    # Sort the extracted even values in non-decreasing order.\n    sorted_even_values = sorted(even_values)\n\n    # Reassign sorted even values back into the even positions of the result list.\n    sorted_idx = 0\n    for i in range(0, len(result), 2):\n        result[i] = sorted_even_values[sorted_idx]\n        sorted_idx += 1\n\n    return result"}
{"task_id": "HumanEval/38", "solution": "def decode_cyclic(s: str):\n    \"\"\"\n    Takes as input a string encoded with encode_cyclic and returns the decoded string.\n    Reverses the left-rotate-by-1 applied to each full group of 3 characters.\n    \"\"\"\n    if not s:\n        return s\n    groups = [s[(3 * i):min((3 * i + 3), len(s))] for i in range((len(s) + 2) // 3)]\n    decoded_groups = [(group[-1] + group[:-1]) if len(group) == 3 else group for group in groups]\n    return \"\".join(decoded_groups)"}
{"task_id": "HumanEval/39", "solution": "def miller_rabin_check(a, d, s, n):\n    \"\"\"\n    Performs one round of Miller-Rabin primality test.\n    Checks if n is likely prime using base a.\n    \"\"\"\n    x = pow(a, d, n)\n    if x == 1 or x == n - 1:\n        return True\n    for _ in range(s - 1):\n        x = (x * x) % n\n        if x == n - 1:\n            return True\n    return False\n\ndef is_prime(x):\n    \"\"\"\n    Determines if a number x is prime using a deterministic Miller-Rabin test.\n    Handles small primes and even numbers trivially.\n    \"\"\"\n    if x < 2:\n        return False\n    if x == 2 or x == 3:\n        return True\n    if x % 2 == 0:\n        return False\n\n    # Write x-1 as d * 2^s\n    s = 0\n    d = x - 1\n    while d % 2 == 0:\n        d //= 2\n        s += 1\n\n    # Deterministic bases for numbers up to 2^64 (Python integers handle arbitrary size)\n    deterministic_bases = [2, 325, 9375, 28178, 450775, 9780504, 1795265022]\n\n    for base in deterministic_bases:\n        # If base % x == 0, pow(base, d, x) == 0 which is != 1 and != x-1, so the check below will handle it.\n        if not miller_rabin_check(base, d, s, x):\n            return False\n    return True\n\ndef prime_fib(n: int):\n    \"\"\"\n    prime_fib returns n-th number that is a Fibonacci number and it's also prime.\n    Generates Fibonacci numbers iteratively and checks for primality.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n    if n < 1:\n        raise ValueError(\"n must be >= 1\")\n\n    count = 0\n    a, b = 0, 1  # F(0), F(1)\n\n    while True:\n        a, b = b, a + b  # a becomes F(k), b becomes F(k+1)\n        if a >= 2 and is_prime(a):\n            count += 1\n            if count == n:\n                return a"}
{"task_id": "HumanEval/40", "solution": "def triples_sum_to_zero(l: list):\n    \"\"\"\n    Checks if there are three distinct elements in the list that sum to zero.\n    Returns True if such a triplet exists, False otherwise.\n    \"\"\"\n    n = len(l)\n    if n < 3:\n        return False\n\n    for i in range(n - 2):\n        for j in range(i + 1, n - 1):\n            for k in range(j + 1, n):\n                if l[i] + l[j] + l[k] == 0:\n                    return True\n    return False"}
