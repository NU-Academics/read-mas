{"task_id": "HumanEval/139", "solution": "def special_factorial(n):\n    \"\"\"Return the Brazilian (special) factorial: product of i! for i = 1..n.\n\n    Raises:\n        TypeError: if n is not an int.\n        ValueError: if n < 1.\n    \"\"\"\n    if not isinstance(n, int) or isinstance(n, bool):\n        raise TypeError(\"n must be an integer\")\n    if n < 1:\n        raise ValueError(\"n must be a positive integer (n >= 1)\")\n\n    result = 1\n    fac = 1  # current i!\n    for i in range(1, n + 1):\n        fac *= i\n        result *= fac\n    return result"}
{"task_id": "HumanEval/160", "solution": "def do_algebra(operator, operand):\n    \"\"\"\n    Given two lists operator, and operand. The first list has basic algebra operations, and\n    the second list is a list of integers. Use the two given lists to build the algebric\n    expression and return the evaluation of this expression.\n\n    The basic algebra operations:\n    Addition ( + )\n    Subtraction ( - )\n    Multiplication ( * )\n    Floor division ( // )\n    Exponentiation ( ** )\n\n    Example:\n    operator['+', '*', '-']\n    array = [2, 3, 4, 5]\n    result = 2 + 3 * 4 - 5\n    => result = 9\n\n    Note:\n        The length of operator list is equal to the length of operand list minus one.\n        Operand is a list of of non-negative integers.\n        Operator list has at least one operator, and operand list has at least two operands.\n\n    \"\"\"\n    # 1. Validate inputs\n    if len(operator) != len(operand) - 1:\n        raise ValueError(\"Length of operator list must be one less than length of operand list.\")\n\n    allowed_operators = ['+', '-', '*', '//', '**']\n\n    # Precedence and associativity maps for shunting-yard algorithm\n    prec = {'+': 1, '-': 1, '*': 2, '//': 2, '**': 3}\n    assoc = {'+': 'L', '-': 'L', '*': 'L', '//': 'L', '**': 'R'}\n\n    # 2. Build tokens list by alternating operand and operator\n    tokens = []\n    for i in range(len(operand)):\n        tokens.append(operand[i])\n        if i < len(operator):\n            op = operator[i]\n            if op not in allowed_operators:\n                raise ValueError(f\"Invalid operator '{op}' found.\")\n            tokens.append(op)\n\n    # 3. Infix to postfix (shunting-yard algorithm)\n    postfix_output = []\n    operator_stack = []\n\n    for token in tokens:\n        if isinstance(token, int):  # Token is a number (operand)\n            postfix_output.append(token)\n        else:  # Token is an operator o1\n            o1 = token\n            while (operator_stack and\n                   operator_stack[-1] in allowed_operators and\n                   ((assoc[o1] == 'L' and prec[o1] <= prec[operator_stack[-1]]) or\n                    (assoc[o1] == 'R' and prec[o1] < prec[operator_stack[-1]]))):\n                postfix_output.append(operator_stack.pop())\n            operator_stack.append(o1)\n\n    while operator_stack:\n        postfix_output.append(operator_stack.pop())\n\n    # 4. Evaluate postfix expression\n    eval_stack = []\n    for token in postfix_output:\n        if isinstance(token, int):\n            eval_stack.append(token)\n        else:  # Token is an operator\n            if len(eval_stack) < 2:\n                raise ValueError(\"Postfix evaluation error: insufficient operands for operator.\")\n            b = eval_stack.pop()\n            a = eval_stack.pop()\n\n            if token == '+':\n                eval_stack.append(a + b)\n            elif token == '-':\n                eval_stack.append(a - b)\n            elif token == '*':\n                eval_stack.append(a * b)\n            elif token == '//':\n                if b == 0:\n                    raise ZeroDivisionError(\"Division by zero in expression.\")\n                eval_stack.append(a // b)\n            elif token == '**':\n                eval_stack.append(a ** b)\n\n    if len(eval_stack) != 1:\n        raise ValueError(\"Postfix evaluation error: stack did not contain a single result.\")\n\n    return eval_stack.pop()"}
{"task_id": "HumanEval/52", "solution": "```python\ndef below_threshold(l: list, t: int):\n    \"\"\"Return True if all numbers in the list l are strictly less than threshold t.\n    Returns True for empty lists and allows TypeError to propagate for non-comparable elements.\n\n    >>> below_threshold([1, 2, 4, 10], 100)\n    True\n    >>> below_threshold([1, 20, 4, 10], 5)\n    False\n    >>> below_threshold([], 5)\n    True\n    >>> below_threshold([1, 2, 3], 3)\n    False\n    >>> below_threshold([1, 2.5, 2.9], 3.0)\n    True\n    >>> below_threshold([1, 2.5, 3.1], 3.0)\n    False\n    >>> below_threshold([1, 'a', 3], 5)\n    Traceback (most recent call last):\n      ...\n    TypeError: '<' not supported between instances of 'str' and 'int'\n    >>> below_threshold(['b', 3], 5)\n    Traceback (most recent call last):\n      ...\n    TypeError: '<' not supported between instances of 'str' and 'int'\n    \"\"\"\n    for element in l:\n        if not (element < t):\n            return False\n    return True\n```"}
{"task_id": "HumanEval/163", "solution": "```python\nfrom typing import List, Set\n\nclass InputParameters:\n    \"\"\"Represents input parameters a and b, with validation.\"\"\"\n    def __init__(self, a: int, b: int):\n        self.a = a\n        self.b = b\n\n    def validate(self) -> bool:\n        \"\"\"Validates that a and b are positive integers.\n        Per critical requirements, no actual validation or exceptions are performed here; it trusts inputs.\n        \"\"\"\n        return True\n\nclass Range:\n    \"\"\"Holds the inclusive numeric interval endpoints.\"\"\"\n    def __init__(self):\n        self.min: int = 0\n        self.max: int = 0\n\n    def compute(self, a: int, b: int) -> None:\n        \"\"\"Computes and sets the min and max values from a and b.\"\"\"\n        self.min = min(a, b)\n        self.max = max(a, b)\n\nclass EvenDigitSet:\n    \"\"\"Defines eligible digits and filters them by a given range.\"\"\"\n    def __init__(self):\n        self.digits: Set[int] = {0, 2, 4, 6, 8}\n\n    def filter(self, range: Range) -> List[int]:\n        \"\"\"Returns the subset of eligible digits that lie within the inclusive range.\"\"\"\n        return [d for d in self.digits if range.min <= d <= range.max]\n\nclass ResultList:\n    \"\"\"Collects results and performs deduplication and sorting.\"\"\"\n    def __init__(self, digits: List[int]):\n        self.digits = digits\n\n    def unique(self) -> None:\n        \"\"\"Removes duplicates from the digits list while preserving order.\"\"\"\n        self.digits = list(dict.fromkeys(self.digits))\n\n    def sortAscending(self) -> None:\n        \"\"\"Sorts the digits list in ascending order.\"\"\"\n        self.digits.sort()\n\ndef generate_integers(a: int, b: int) -> List[int]:\n    \"\"\"\n    Given two positive integers a and b, return the single-digit even integers\n    between a and b, in ascending order and without duplicates.\n    \"\"\"\n    input_params = InputParameters(a, b)\n    # Per critical requirements, validation is structurally called but does not raise exceptions.\n    input_params.validate()\n\n    num_range = Range()\n    num_range.compute(a, b)\n\n    even_digit_set = EvenDigitSet()\n    candidate_digits = even_digit_set.filter(num_range)\n\n    result_list = ResultList(digits=candidate_digits)\n    result_list.unique()\n    result_list.sortAscending()\n\n    return result_list.digits\n```"}
{"task_id": "HumanEval/39", "solution": "class InputValidator:\n    \"\"\"\n    Validates input n is an integer and n >= 1.\n    Raises ValueError for invalid input.\n    \"\"\"\n    def validate(self, n) -> None:\n        \"\"\"Raises ValueError if n is not an integer or n < 1.\"\"\"\n        if not isinstance(n, int):\n            raise ValueError(\"Input 'n' must be an integer.\")\n        if n < 1:\n            raise ValueError(\"Input 'n' must be greater than or equal to 1.\")\n\nclass FibonacciGenerator:\n    \"\"\"\n    Iteratively generates Fibonacci numbers (0, 1, 1, 2, 3, 5, ...).\n    Supports arbitrary-size integers.\n    \"\"\"\n    def __init__(self):\n        self._a: int = 0\n        self._b: int = 1\n        self._index: int = 0\n\n    def next(self) -> int:\n        \"\"\"Return the next Fibonacci number in the sequence.\"\"\"\n        if self._index == 0:\n            self._index += 1\n            return 0\n        elif self._index == 1:\n            self._index += 1\n            return 1\n        else:\n            fib_value = self._a + self._b\n            self._a = self._b\n            self._b = fib_value\n            self._index += 1\n            return fib_value\n\nclass PrimalityTester:\n    \"\"\"\n    Determines whether integers >= 2 are prime.\n    Uses trial division; supports arbitrary-size integers.\n    \"\"\"\n    def isPrime(self, x: int) -> bool:\n        \"\"\"Return True if x is prime, else False.\"\"\"\n        if x < 2:\n            return False\n        if x == 2:\n            return True\n        if x % 2 == 0:\n            return False\n        \n        i = 3\n        while i * i <= x:\n            if x % i == 0:\n                return False\n            i += 2\n        return True\n\nclass PrimeFibonacciSequence:\n    \"\"\"\n    Collects discovered prime Fibonacci numbers.\n    Provides append/get by 1-based rank.\n    \"\"\"\n    def __init__(self):\n        self._values: list[int] = []\n\n    def append(self, v: int) -> None:\n        \"\"\"Appends a prime Fibonacci number to the sequence.\"\"\"\n        self._values.append(v)\n\n    def get(self, rank: int) -> int:\n        \"\"\"Return the value at the 1-based rank.\"\"\"\n        return self._values[rank - 1]\n\nclass PrimeFibService:\n    \"\"\"\n    Orchestrates validation, Fibonacci generation, primality testing, and collection.\n    It finds the n-th prime Fibonacci number.\n    \"\"\"\n    def __init__(self, validator: InputValidator, generator: FibonacciGenerator,\n                 tester: PrimalityTester, sequence: PrimeFibonacciSequence):\n        self.validator = validator\n        self.generator = generator\n        self.tester = tester\n        self.sequence = sequence\n\n    def compute(self, n: int) -> int:\n        \"\"\"\n        Computes the n-th prime Fibonacci number.\n        Propagates ValueError for invalid input.\n        \"\"\"\n        self.validator.validate(n)\n\n        primes_found = 0\n        while primes_found < n:\n            fib_value = self.generator.next()\n            if self.tester.isPrime(fib_value):\n                self.sequence.append(fib_value)\n                primes_found += 1\n        \n        return self.sequence.get(n)\n\ndef prime_fib(n: int) -> int:\n    \"\"\"\n    prime_fib returns n-th number that is a Fibonacci number and it's also prime.\n    \"\"\"\n    service = PrimeFibService(InputValidator(), FibonacciGenerator(), PrimalityTester(), PrimeFibonacciSequence())\n    return service.compute(n)"}
{"task_id": "HumanEval/105", "solution": "```python\n# src/__init__.py\n\"\"\"\nPackage marker and public API export for by_length.\nThis file exports the main by_length function for external use.\n\"\"\"\n__all__ = [\"by_length\"]\n\nfrom .by_length import by_length\n\n```python\n# src/domain.py\n\"\"\"\nImplements the SRS domain classes and methods used by the processing pipeline.\nEach class encapsulates a specific processing step or data representation as per design.\n\"\"\"\nfrom typing import List, Dict\n\nclass InputArray:\n    \"\"\"Wraps an input list of integers and provides a method to receive them.\"\"\"\n    def __init__(self, values: List[int]):\n        self.values = values\n\n    def receive(self) -> List[int]:\n        \"\"\"Returns the wrapped list of integers, representing the initial input.\"\"\"\n        return self.values\n\nclass IntegerElement:\n    \"\"\"A lightweight holder for a single integer value, representing a numeric element.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\nclass FilteredIntegers:\n    \"\"\"Filters a list of integers, retaining only those between 1 and 9 inclusive.\"\"\"\n    def __init__(self, values: List[int]):\n        self.values = values\n\n    def filter(self) -> List[int]:\n        \"\"\"Filters the values to keep only those within the valid 1-9 range.\"\"\"\n        return [val for val in self.values if 1 <= val <= 9]\n\nclass SortedIntegers:\n    \"\"\"Sorts a list of integers in ascending numerical order.\"\"\"\n    def __init__(self, values: List[int]):\n        self.values = values\n\n    def sortAscending(self) -> List[int]:\n        \"\"\"Returns a new list with integers sorted in ascending order.\"\"\"\n        return sorted(self.values)\n\nclass DescendingIntegers:\n    \"\"\"Reverses a list of sorted integers to obtain descending order.\"\"\"\n    def __init__(self, values: List[int]):\n        self.values = values\n\n    def reverse(self) -> List[int]:\n        \"\"\"Returns a new list with integers in reverse (descending) order.\"\"\"\n        return self.values[::-1]\n\nclass IntegerToNameMap:\n    \"\"\"Holds the mapping from integers 1-9 to their English names and provides a lookup method.\"\"\"\n    def __init__(self):\n        self.mapping: Dict[int, str] = {\n            1: \"One\", 2: \"Two\", 3: \"Three\", 4: \"Four\", 5: \"Five\",\n            6: \"Six\", 7: \"Seven\", 8: \"Eight\", 9: \"Nine\"\n        }\n\n    def getName(self, value: int) -> str:\n        \"\"\"Retrieves the English name for a given integer from the internal mapping.\"\"\"\n        return self.mapping.get(value, \"\") # Returns empty string if not found, though design implies valid inputs.\n\nclass MappedNames:\n    \"\"\"Converts a list of integers to a list of their corresponding English names using a mapper.\"\"\"\n    def __init__(self, values: List[int], mapper: IntegerToNameMap):\n        self.values = values\n        self.mapper = mapper\n\n    def map(self) -> List[str]:\n        \"\"\"Maps each integer in the list to its English name using the provided mapper.\"\"\"\n        return [self.mapper.getName(val) for val in self.values]\n\n```python\n# src/by_length.py\n\"\"\"\nPublic API entry point implementing by_length(arr) and wiring the processing pipeline.\nIt orchestrates domain classes to transform an integer array into a list of names.\n\"\"\"\nfrom typing import List\nfrom .domain import (\n    InputArray,\n    FilteredIntegers,\n    SortedIntegers,\n    DescendingIntegers,\n    IntegerToNameMap,\n    MappedNames\n)\n\ndef _validate_input(arr: List[int]) -> None:\n    \"\"\"\n    Documents the precondition that `arr` is a sequence of integers.\n    No runtime checks or exception handling are performed as per design specification.\n    \"\"\"\n    pass\n\ndef by_length(arr: List[int]) -> List[str]:\n    \"\"\"\n    Processes an array of integers by filtering, sorting, reversing, and mapping to names.\n    This function implements the complete processing pipeline specified in the design.\n    \"\"\"\n    _validate_input(arr)\n\n    # Receive the input array\n    inp = InputArray(arr)\n    values = inp.receive()\n\n    # Filter integers to retain only values in 1..9 inclusive\n    filtered = FilteredIntegers(values).filter()\n    if not filtered:\n        return []\n\n    # Sort retained integers in ascending numerical order\n    sorted_vals = SortedIntegers(filtered).sortAscending()\n\n    # Reverse the sorted list to obtain descending order\n    descending = DescendingIntegers(sorted_vals).reverse()\n\n    # Map each integer to its exact English name and return the resulting list\n    mapper = IntegerToNameMap()\n    names = MappedNames(descending, mapper).map()\n\n    return names\n```"}
{"task_id": "HumanEval/38", "solution": "```python\nGROUP_SIZE = 3\n\nclass Group:\n    \"\"\"Represents a contiguous substring of 1 to 3 characters.\"\"\"\n    def __init__(self, value: str, index: int) -> None:\n        self.value = value\n        self.index = index\n\n    def size(self) -> int:\n        \"\"\"Returns the length of the group's string value.\"\"\"\n        return len(self.value)\n\n    def is_full(self) -> bool:\n        \"\"\"Checks if the group contains exactly GROUP_SIZE characters.\"\"\"\n        return self.size() == GROUP_SIZE\n\n    def rotate_left(self) -> str:\n        \"\"\"Left-rotates the group if full, otherwise returns its original value.\"\"\"\n        if self.is_full():\n            return self.value[1:] + self.value[0]\n        else:\n            return self.value\n\n    def rotate_right(self) -> str:\n        \"\"\"Right-rotates the group if full, otherwise returns its original value.\"\"\"\n        if self.is_full():\n            return self.value[-1] + self.value[:-1]\n        else:\n            return self.value\n\nclass Encoder:\n    \"\"\"Encodes a string by splitting, rotating full groups left, and joining.\"\"\"\n    def encode(self, s: str) -> str:\n        \"\"\"Encodes the input string.\"\"\"\n        groups = self._split_into_groups(s)\n        processed = [group.rotate_left() for group in groups]\n        return self._join_groups(processed)\n\n    def _split_into_groups(self, s: str) -> list[Group]:\n        \"\"\"Splits the string into consecutive Group objects.\"\"\"\n        group_list = []\n        for i in range(0, len(s), GROUP_SIZE):\n            slice_value = s[i : i + GROUP_SIZE]\n            group_list.append(Group(slice_value, i // GROUP_SIZE))\n        return group_list\n\n    def _join_groups(self, groups: list[str]) -> str:\n        \"\"\"Concatenates a list of strings into a single string.\"\"\"\n        return \"\".join(groups)\n\nclass Decoder:\n    \"\"\"Decodes a string by splitting, rotating full groups right, and joining.\"\"\"\n    def decode(self, s: str) -> str:\n        \"\"\"Decodes the input string.\"\"\"\n        groups = self._split_into_groups(s)\n        processed = [group.rotate_right() for group in groups]\n        return self._join_groups(processed)\n\n    def _split_into_groups(self, s: str) -> list[Group]:\n        \"\"\"Splits the string into consecutive Group objects.\"\"\"\n        group_list = []\n        for i in range(0, len(s), GROUP_SIZE):\n            slice_value = s[i : i + GROUP_SIZE]\n            group_list.append(Group(slice_value, i // GROUP_SIZE))\n        return group_list\n\n    def _join_groups(self, groups: list[str]) -> str:\n        \"\"\"Concatenates a list of strings into a single string.\"\"\"\n        return \"\".join(groups)\n\ndef encode_cyclic(s: str) -> str:\n    \"\"\"\n    Encode input string by splitting into consecutive groups of up to 3 characters and left-rotating every full group.\n    For s == \"\", returns \"\".\n    \"\"\"\n    encoder = Encoder()\n    return encoder.encode(s)\n\ndef decode_cyclic(s: str) -> str:\n    \"\"\"\n    Decode an encoded string by splitting into consecutive groups of up to 3 characters and right-rotating every full group.\n    For s == \"\", returns \"\".\n    \"\"\"\n    decoder = Decoder()\n    return decoder.decode(s)\n```"}
{"task_id": "HumanEval/41", "solution": "To implement the design, we'll create the specified file structure and populate each file with the described classes and functions.\n\n**File Structure:**\n\n```\n.\n\u251c\u2500\u2500 src/\n\u2502   \u251c\u2500\u2500 __init__.py\n\u2502   \u251c\u2500\u2500 cli.py\n\u2502   \u251c\u2500\u2500 calculator.py\n\u2502   \u251c\u2500\u2500 validator.py\n\u2502   \u251c\u2500\u2500 models.py\n\u2502   \u2514\u2500\u2500 errors.py\n```\n\n---\n\n**`src/errors.py`**\n\n```python\nclass InvalidInputError(Exception):\n    \"\"\"\n    Deterministic exception type for input validation failures.\n    Raised when user input does not meet specified criteria.\n    \"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n\n```\n\n---\n\n**`src/models.py`**\n\n```python\nfrom dataclasses import dataclass\nfrom datetime import datetime\nfrom typing import Optional, Literal\n\n@dataclass\nclass Car:\n    \"\"\"\n    Domain representation of an individual car.\n    \"\"\"\n    id: int\n    direction: Literal['LTR', 'RTL']\n    position: float\n\n@dataclass\nclass CarSet:\n    \"\"\"\n    Domain representation of a set of cars.\n    \"\"\"\n    id: int\n    count: int\n    direction: Literal['LTR', 'RTL']\n\n    def getCount(self) -> int:\n        \"\"\"Returns the number of cars in the set.\"\"\"\n        return self.count\n\n@dataclass\nclass CollisionEvent:\n    \"\"\"\n    Domain representation of a collision between two cars.\n    \"\"\"\n    id: int\n    carLTRId: int\n    carRTLId: int\n    time: float\n    position: float\n\n@dataclass\nclass CalculationRequest:\n    \"\"\"\n    Encapsulates input request for a calculation.\n    \"\"\"\n    id: Optional[int]\n    n: int\n    requested_at: datetime\n\n@dataclass\nclass CalculationResult:\n    \"\"\"\n    Encapsulates the computed collision result.\n    \"\"\"\n    id: Optional[int]\n    request_id: Optional[int]\n    collisions: int\n    computed_at: datetime\n\n```\n\n---\n\n**`src/validator.py`**\n\n```python\nclass InputValidator:\n    \"\"\"\n    Validates that provided input 'n' is a non-negative integer.\n    Sets an error message if validation fails.\n    \"\"\"\n    def __init__(self):\n        self._error_message: str = \"\"\n\n    def validate(self, n) -> bool:\n        \"\"\"\n        Checks if n is an integer and n >= 0.\n        \"\"\"\n        if not isinstance(n, int):\n            self._error_message = \"Input 'n' must be an integer.\"\n            return False\n        if n < 0:\n            self._error_message = \"Input 'n' must be a non-negative integer.\"\n            return False\n        self._error_message = \"\"  # Clear message on success\n        return True\n\n    @property\n    def error_message(self) -> str:\n        \"\"\"Returns the error message from the last validation attempt.\"\"\"\n        return self._error_message\n\n```\n\n---\n\n**`src/calculator.py`**\n\n```python\nfrom .validator import InputValidator\nfrom .errors import InvalidInputError\n# Models are imported for traceability/optional persistence per design,\n# though not strictly used in the core n*n calculation here.\nfrom .models import CalculationRequest, CalculationResult\nfrom datetime import datetime\n\nclass CollisionCalculator:\n    \"\"\"\n    Computes the number of collisions based on 'n' cars in each direction.\n    It is stateless and uses the formula collisions = n * n.\n    \"\"\"\n    def calculate(self, n: int) -> int:\n        \"\"\"\n        Calculates the number of collisions for 'n' cars.\n        Assumes n is a valid non-negative integer.\n        \"\"\"\n        return n * n\n\ndef car_race_collision(n: int) -> int:\n    \"\"\"\n    Calculates collisions between two sets of 'n' cars moving in opposite directions.\n    Each car in one set collides with every car in the other set.\n    \"\"\"\n    validator = InputValidator()\n    if not validator.validate(n):\n        raise InvalidInputError(validator.error_message)\n\n    # Per design, CalculationRequest/Result classes exist for traceability and optional persistence.\n    # request = CalculationRequest(id=None, n=n, requested_at=datetime.now()) # Example usage\n    \n    calculator = CollisionCalculator()\n    collisions = calculator.calculate(n)\n    \n    # result = CalculationResult(id=None, request_id=request.id, collisions=collisions, computed_at=datetime.now()) # Example usage\n    \n    return collisions\n\n```\n\n---\n\n**`src/cli.py`**\n\n```python\nimport argparse\nimport sys\nfrom typing import Optional, List\n\nfrom .calculator import car_race_collision\nfrom .errors import InvalidInputError\n\ndef _parse_args(argv: Optional[List[str]]) -> int:\n    \"\"\"\n    Parses command-line arguments and extracts the integer 'n'.\n    Raises InvalidInputError if the input 'n' cannot be converted to an integer.\n    \"\"\"\n    parser = argparse.ArgumentParser(\n        prog='car_race_collision',\n        description='Calculate the number of collisions between two sets of cars.'\n    )\n    parser.add_argument(\n        'n',\n        help='number of cars in each direction (non-negative integer)'\n    )\n    \n    args = parser.parse_args(argv)\n\n    try:\n        n_val = int(args.n)\n    except ValueError:\n        raise InvalidInputError(f\"Input '{args.n}' cannot be converted to an integer.\")\n    \n    return n_val\n\n\ndef main(argv: Optional[List[str]] = None) -> int:\n    \"\"\"\n    CLI entry point. Parses arguments, calls car_race_collision,\n    prints result, and returns exit code.\n    \"\"\"\n    try:\n        n = _parse_args(argv)\n        result = car_race_collision(n)\n        print(result)\n        return 0\n    except InvalidInputError as e:\n        print(e.args[0], file=sys.stderr)\n        return 2\n    except SystemExit as e:\n        # argparse can call sys.exit() directly for help or invalid arguments (e.g., missing 'n').\n        # We let argparse handle these specific exits.\n        return e.code if e.code is not None else 1\n\n\nif __name__ == '__main__':\n    sys.exit(main())\n\n```\n\n---\n\n**`src/__init__.py`**\n\n```python\n\"\"\"\nCar Race Collision library package.\nExposes the main car_race_collision function for direct import.\n\"\"\"\nfrom .calculator import car_race_collision\n\n```"}
