{"task_id": "HumanEval/47", "solution": "def median(l: list):\n    \"\"\"Return median of elements in the list l.\n    >>> median([3, 1, 2, 4, 5])\n    3\n    >>> median([-10, 4, 6, 1000, 10, 20])\n    15.0\n    \"\"\"\n    if not l:\n        raise ValueError(\"median() arg is an empty list\")\n\n    s = sorted(l)\n    n = len(s)\n    mid = n // 2\n\n    if n % 2 == 1:\n        return s[mid]\n    else:\n        a = s[mid - 1]\n        b = s[mid]\n        try:\n            return (a + b) / 2.0\n        except TypeError as e:\n            raise TypeError(\"Cannot compute median: arithmetic mean requires numeric elements for even-length lists.\") from e"}
{"task_id": "HumanEval/47", "solution": "def median(l: list):\n    \"\"\"Return median of elements in the list l.\n    Sorts the list and finds the middle element or average of two middle elements.\n    \"\"\"\n    l.sort()\n    n = len(l)\n    if n == 0:\n        raise ValueError(\"median() arg is an empty list\")\n    if n % 2 == 1:\n        return l[n // 2]\n    else:\n        return (l[n // 2 - 1] + l[n // 2]) / 2"}
