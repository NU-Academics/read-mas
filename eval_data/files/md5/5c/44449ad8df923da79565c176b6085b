{"task_id": "HumanEval/30", "solution": "def get_positive(l: list):\n    \"\"\"Return only positive numbers in the list.\n    >>> get_positive([-1, 2, -4, 5, 6])\n    [2, 5, 6]\n    >>> get_positive([5, 3, -5, 2, -3, 3, 9, 0, 123, 1, -10])\n    [5, 3, 2, 3, 9, 123, 1]\n    \"\"\"\n    positive_numbers = []\n    for num in l:\n        # Exclude booleans (subclass of int) and non-numeric items\n        if isinstance(num, bool):\n            continue\n        try:\n            if isinstance(num, (int, float)) and num > 0:\n                positive_numbers.append(num)\n        except TypeError:\n            # skip non-comparable or non-numeric types\n            continue\n    return positive_numbers"}
{"task_id": "HumanEval/29", "solution": "def filter_by_prefix(strings: List[str], prefix: str) -> List[str]:\n    \"\"\" Filter an input list of strings only for ones that start with a given prefix.\n    >>> filter_by_prefix([], 'a')\n    []\n    >>> filter_by_prefix(['abc', 'bcd', 'cde', 'array'], 'a')\n    ['abc', 'array']\n    \"\"\"\n    if not isinstance(prefix, str):\n        raise TypeError(\"prefix must be a str\")\n    result: List[str] = []\n    for s in strings:\n        if isinstance(s, str) and s.startswith(prefix):\n            result.append(s)\n    return result"}
{"task_id": "HumanEval/30", "solution": "def get_positive(l: list):\n    \"\"\"Return only positive numbers in the list.\n    >>> get_positive([-1, 2, -4, 5, 6])\n    [2, 5, 6]\n    >>> get_positive([5, 3, -5, 2, -3, 3, 9, 0, 123, 1, -10])\n    [5, 3, 2, 3, 9, 123, 1]\n    \"\"\"\n    return [x for x in l if x > 0]"}
{"task_id": "HumanEval/31", "solution": "def is_prime(n):\n    \"\"\"Return true if a given number is prime, and false otherwise.\n    >>> is_prime(6)\n    False\n    >>> is_prime(101)\n    True\n    >>> is_prime(11)\n    True\n    >>> is_prime(13441)\n    True\n    >>> is_prime(61)\n    True\n    >>> is_prime(4)\n    False\n    >>> is_prime(1)\n    False\n    \"\"\"\n    if n <= 1:\n        return False\n    if n <= 3:\n        return True\n    if n % 2 == 0 or n % 3 == 0:\n        return False\n\n    i = 5\n    while i * i <= n:\n        if n % i == 0 or n % (i + 2) == 0:\n            return False\n        i += 6\n    return True"}
{"task_id": "HumanEval/31", "solution": "def is_prime(n):\n    \"\"\"Return true if a given number is prime, and false otherwise.\n    >>> is_prime(6)\n    False\n    >>> is_prime(101)\n    True\n    >>> is_prime(11)\n    True\n    >>> is_prime(13441)\n    True\n    >>> is_prime(61)\n    True\n    >>> is_prime(4)\n    False\n    >>> is_prime(1)\n    False\n    \"\"\"\n    if n <= 1:\n        return False\n    if n <= 3:\n        return True\n    if n % 2 == 0 or n % 3 == 0:\n        return False\n    i = 5\n    while i * i <= n:\n        if n % i == 0 or n % (i + 2) == 0:\n            return False\n        i += 6\n    return True"}
{"task_id": "HumanEval/32", "solution": "import math\n\ndef find_zero(xs: list):\n    \"\"\" xs are coefficients of a polynomial.\n    find_zero find x such that poly(x) = 0.\n    find_zero returns only only zero point, even if there are many.\n    Moreover, find_zero only takes list xs having even number of coefficients\n    and largest non zero coefficient as it guarantees\n    a solution.\n    >>> round(find_zero([1, 2]), 2) # f(x) = 1 + 2x\n    -0.5\n    >>> round(find_zero([-6, 11, -6, 1]), 2) # (x - 1) * (x - 2) * (x - 3) = -6 + 11x - 6x^2 + x^3\n    1.0\n    \"\"\"\n    # Tolerances and constants from the design document.\n    tol_x = 1e-12\n    tol_f = 1e-12\n    growth_factor = 2.0\n    max_expand = 200\n    max_bisect_iters = 2000\n\n    def horner_poly(coeffs, x_val):\n        \"\"\"Evaluates a polynomial using Horner's method for numerical stability.\"\"\"\n        if not coeffs:\n            return 0.0\n        result = float(coeffs[-1])\n        for i in range(len(coeffs) - 2, -1, -1):\n            result = result * x_val + float(coeffs[i])\n        return result\n\n    # 1. Input validation and trimming.\n    trimmed_xs = list(xs)  # Create a mutable copy of coefficients.\n    while trimmed_xs and abs(trimmed_xs[-1]) <= tol_f:\n        trimmed_xs.pop()\n\n    if not trimmed_xs:\n        raise ValueError(\"Zero polynomial has infinite roots\")\n\n    if len(trimmed_xs) == 1:\n        raise ValueError(\"Constant non-zero polynomial has no roots\")\n\n    # The polynomial evaluation function specific to the trimmed coefficients.\n    f = lambda x_val: horner_poly(trimmed_xs, x_val)\n\n    # 2. Evaluate f(0). If f(0) is close to zero, return 0.0.\n    f0 = f(0.0)\n    if abs(f0) <= tol_f:\n        return 0.0\n\n    # 3. Bracket search.\n    current_R = 1.0\n    left, right, fl, fr = 0.0, 0.0, 0.0, 0.0  # Initialize to ensure variables are always set.\n    bracket_found = False\n\n    for _ in range(max_expand):\n        left = -current_R\n        right = current_R\n\n        fl = f(left)\n        fr = f(right)\n\n        if abs(fl) <= tol_f:\n            return left\n        if abs(fr) <= tol_f:\n            return right\n\n        # Check if f(left) and f(right) have opposite signs to form a bracket.\n        if (fl > 0 and fr < 0) or (fl < 0 and fr > 0):\n            bracket_found = True\n            break\n\n        current_R *= growth_factor\n\n    if not bracket_found:\n        raise RuntimeError(\"Failed to find sign-changing interval for the polynomial\")\n\n    # 4. Bisection on [left, right].\n    for _ in range(max_bisect_iters):\n        mid = (left + right) / 2.0\n        fm = f(mid)\n\n        # Termination conditions based on x-tolerance or f(x)-tolerance.\n        if abs(fm) <= tol_f or (right - left) / 2.0 <= tol_x:\n            return mid\n\n        # Update the interval based on the sign of f(mid) relative to f(left).\n        # If f(left) and f(mid) have opposite signs, root is in [left, mid].\n        if (fl > 0 and fm < 0) or (fl < 0 and fm > 0):\n            right = mid\n            fr = fm\n        else: # Otherwise, root is in [mid, right].\n            left = mid\n            fl = fm\n\n    # 5. Return the best estimate after maximum iterations.\n    return mid"}
