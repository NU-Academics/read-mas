{"task_id": "HumanEval/1", "solution": "from typing import List\n\n\ndef separate_paren_groups(paren_string: str) -> List[str]:\n    \"\"\"Parses a string for top-level balanced parenthesis groups, returning a list of strings with whitespace removed.\n    Raises ValueError for unbalanced parentheses or invalid characters.\n    \"\"\"\n    groups: List[str] = []\n    depth: int = 0\n    buffer: List[str] = []\n\n    for i, ch in enumerate(paren_string):\n        if ch.isspace():\n            continue\n        elif ch == '(':\n            if depth == 0:\n                buffer = []\n            buffer.append('(')\n            depth += 1\n        elif ch == ')':\n            if depth == 0:\n                raise ValueError(f\"Unmatched closing parenthesis at position {i}\")\n            buffer.append(')')\n            depth -= 1\n            if depth == 0:\n                groups.append(''.join(buffer))\n        else:\n            raise ValueError(f\"Invalid character '{ch}' at position {i}\")\n\n    if depth != 0:\n        raise ValueError(\"Unmatched opening parenthesis(s) in input\")\n\n    return groups"}
{"task_id": "HumanEval/0", "solution": "from typing import List\nimport math\n\ndef has_close_elements(numbers: List[float], threshold: float) -> bool:\n    \"\"\" Check if in given list of numbers, are any two numbers closer to each other than\n    given threshold.\n    >>> has_close_elements([1.0, 2.0, 3.0], 0.5)\n    False\n    >>> has_close_elements([1.0, 2.8, 3.0, 4.0, 5.0, 2.0], 0.3)\n    True\n    \"\"\"\n    if threshold < 0:\n        raise ValueError(\"threshold must be non-negative\")\n\n    # Filter out NaN values; NaNs are incomparable and should be ignored.\n    filtered = [x for x in numbers if not math.isnan(x)]\n\n    if len(filtered) < 2:\n        return False\n\n    sorted_numbers = sorted(filtered)\n\n    for i in range(len(sorted_numbers) - 1):\n        a = sorted_numbers[i]\n        b = sorted_numbers[i + 1]\n\n        # If equal, difference is 0. Only counts if threshold > 0 (strictly less).\n        if a == b:\n            if threshold > 0:\n                return True\n            else:\n                continue\n\n        # For distinct values, compute absolute difference.\n        # For infinities, abs(inf - inf) can be NaN, but equality above handles identical infinities.\n        if abs(a - b) < threshold:\n            return True\n\n    return False"}
{"task_id": "HumanEval/0", "solution": "def has_close_elements(numbers: List[float], threshold: float) -> bool:\n    \"\"\" Check if in given list of numbers, any two numbers are closer to each other than\n    the given threshold (i.e., absolute difference < threshold).\n    \"\"\"\n    # Quick checks\n    if threshold <= 0:\n        # No positive distance can be strictly less than a non-positive threshold\n        return False\n    if len(numbers) < 2:\n        return False\n\n    # Sort the numbers and check adjacent differences (O(n log n) time, O(n) space)\n    sorted_nums = sorted(numbers)\n    prev = sorted_nums[0]\n    for current in sorted_nums[1:]:\n        if current - prev < threshold:\n            return True\n        prev = current\n\n    return False"}
{"task_id": "HumanEval/5", "solution": "from typing import List\n\n\ndef intersperse(numbers: List[int], delimeter: int) -> List[int]:\n    \"\"\" Insert a number 'delimeter' between every two consecutive elements of input list `numbers'.\n    >>> intersperse([], 4)\n    []\n    >>> intersperse([1, 2, 3], 4)\n    [1, 4, 2, 4, 3]\n    \"\"\"\n    result: List[int] = []\n    for i, num in enumerate(numbers):\n        result.append(num)\n        if i < len(numbers) - 1:\n            result.append(delimeter)\n    return result"}
{"task_id": "HumanEval/4", "solution": "from typing import List\n\n\ndef mean_absolute_deviation(numbers: List[float]) -> float:\n    \"\"\" For a given list of input numbers, calculate Mean Absolute Deviation\n    around the mean of this dataset.\n    Mean Absolute Deviation is the average absolute difference between each\n    element and a centerpoint (mean in this case).\n    \"\"\"\n    data_length = len(numbers)\n    # The problem constraints imply that an empty list would lead to division by zero,\n    # which we are forbidden to handle with explicit checks.\n    # Therefore, proceed directly with calculations, assuming valid input as per type hint.\n    data_mean = sum(numbers) / data_length\n\n    absolute_deviations_sum = sum(abs(x - data_mean) for x in numbers)\n\n    return absolute_deviations_sum / data_length"}
{"task_id": "HumanEval/4", "solution": "def mean_absolute_deviation(numbers: List[float]) -> float:\n    \"\"\" For a given list of input numbers, calculate Mean Absolute Deviation\n    around the mean of this dataset.\n    Mean Absolute Deviation is the average absolute difference between each\n    element and a centerpoint (mean in this case):\n    MAD = average | x - x_mean |\n    >>> mean_absolute_deviation([1.0, 2.0, 3.0, 4.0])\n    1.0\n    \"\"\"\n    if not numbers:\n        raise ValueError(\"numbers must not be empty\")\n\n    total = 0.0\n    count = 0\n\n    # First pass: compute total and validate elements\n    for x in numbers:\n        try:\n            fx = float(x)\n        except (TypeError, ValueError):\n            raise TypeError(\"All elements must be numeric\") from None\n\n        # Check for NaN or infinity\n        if fx != fx or abs(fx) == float(\"inf\"):\n            raise ValueError(\"All elements must be finite numbers\")\n\n        total += fx\n        count += 1\n\n    mean = total / count\n\n    # Second pass: compute sum of absolute deviations\n    total_abs_dev = 0.0\n    for x in numbers:\n        # Re-convert; conversion errors already checked above in first pass\n        fx = float(x)\n        total_abs_dev += abs(fx - mean)\n\n    return total_abs_dev / count"}
{"task_id": "HumanEval/5", "solution": "from typing import List\n\n\ndef intersperse(numbers: List[int], delimeter: int) -> List[int]:\n    \"\"\"Insert a number 'delimeter' between every two consecutive elements of input list `numbers`.\n    It returns a new list without modifying the input.\n    \"\"\"\n    result = []\n    for i, num in enumerate(numbers):\n        result.append(num)\n        if i < len(numbers) - 1:\n            result.append(delimeter)\n    return result"}
{"task_id": "HumanEval/6", "solution": "from typing import List\n\n\ndef parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\" Input to this function is a string represented multiple groups for nested parentheses separated by spaces.\n    For each of the group, output the deepest level of nesting of parentheses.\n    E.g. (()()) has maximum two levels of nesting while ((())) has three.\n\n    >>> parse_nested_parens('(()()) ((())) () ((())()())')\n    [2, 3, 1, 3]\n    \"\"\"\n    result = []\n    groups = paren_string.split()\n\n    if not groups:\n        return []\n\n    for group in groups:\n        current_depth = 0\n        max_depth = 0\n        for ch in group:\n            if ch == '(':\n                current_depth += 1\n                max_depth = max(max_depth, current_depth)\n            elif ch == ')':\n                current_depth -= 1\n                if current_depth < 0:\n                    raise ValueError(f\"Unbalanced parentheses: too many closing parens in group: '{group}'\")\n            else:\n                raise ValueError(f\"Invalid character in group: '{ch}' in group: '{group}'\")\n\n        if current_depth != 0:\n            raise ValueError(f\"Unbalanced parentheses: too many opening parens in group: '{group}'\")\n        result.append(max_depth)\n\n    return result"}
{"task_id": "HumanEval/7", "solution": "from typing import List\n\n\ndef filter_by_substring(strings: List[str], substring: str) -> List[str]:\n    \"\"\" Filter an input list of strings only for ones that contain given substring\n    >>> filter_by_substring([], 'a')\n    []\n    >>> filter_by_substring(['abc', 'bacd', 'cde', 'array'], 'a')\n    ['abc', 'bacd', 'array']\n    \"\"\"\n    # Returns a new list with elements from 'strings' that contain 'substring'.\n    # This preserves order and handles empty substrings according to Python's 'in' operator.\n    return [s for s in strings if substring in s]"}
{"task_id": "HumanEval/7", "solution": "from typing import List\n\n\ndef filter_by_substring(strings: List[str], substring: str) -> List[str]:\n    \"\"\" Filter an input list of strings only for ones that contain given substring\n    >>> filter_by_substring([], 'a')\n    []\n    >>> filter_by_substring(['abc', 'bacd', 'cde', 'array'], 'a')\n    ['abc', 'bacd', 'array']\n    \"\"\"\n    return [s for s in strings if substring in s]"}
{"task_id": "HumanEval/6", "solution": "from typing import List\n\n\ndef parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\"Compute the maximum nesting depth of parentheses for each group in a whitespace-separated input string.\n    Each group is a contiguous substring composed of '(' and ')' characters.\n    \"\"\"\n    result = []\n    groups = paren_string.split()\n\n    for group in groups:\n        depth = 0\n        max_depth = 0\n        for ch in group:\n            if ch == '(':\n                depth += 1\n                max_depth = max(max_depth, depth)\n            elif ch == ')':\n                depth -= 1\n                if depth < 0:\n                    raise ValueError(f\"Unbalanced parentheses in group '{group}': too many closing parentheses.\")\n            else:\n                raise ValueError(f\"Invalid character '{ch}' found in group '{group}'. Only '(' and ')' are allowed.\")\n\n        if depth != 0:\n            raise ValueError(f\"Unbalanced parentheses in group '{group}': too many opening parentheses remaining.\")\n\n        result.append(max_depth)\n\n    return result"}
{"task_id": "HumanEval/8", "solution": "from typing import List, Tuple\n\n\ndef sum_product(numbers: List[int]) -> Tuple[int, int]:\n    \"\"\" For a given list of integers, return a tuple consisting of a sum and a product of all the integers in a list.\n    Empty sum should be equal to 0 and empty product should be equal to 1.\n    \"\"\"\n    current_sum = 0\n    current_product = 1\n    for num in numbers:\n        current_sum += num\n        current_product *= num\n    return (current_sum, current_product)"}
