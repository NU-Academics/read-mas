{"task_id": "HumanEval/123", "solution": "def get_odd_collatz(n):\n    \"\"\"\n    Given a positive integer n, return a sorted list that has the odd numbers in the Collatz sequence.\n    \"\"\"\n    if not isinstance(n, int) or n < 1:\n        raise ValueError(\"n must be a positive integer\")\n\n    odds = set()\n    current = n\n    while True:\n        if current % 2 == 1:\n            odds.add(current)\n            if current == 1:\n                break\n            current = 3 * current + 1\n        else:\n            current //= 2\n\n    return sorted(odds)"}
{"task_id": "HumanEval/122", "solution": "def add_elements(arr, k):\n    \"\"\"\n    Given a non-empty array of integers `arr` and an integer `k`, return the sum of the elements\n    with at most two digits from the first `k` elements of `arr`.\n\n    An element is considered to have at most two digits if its absolute value is <= 99.\n\n    Raises:\n        TypeError: if `arr` is not a sequence of integers or `k` is not an int.\n        ValueError: if `arr` is empty or `k` is outside the range [1, len(arr)].\n    \"\"\"\n    # Basic type checks\n    if not isinstance(arr, (list, tuple)):\n        raise TypeError(\"arr must be a list or tuple of integers\")\n    if not isinstance(k, int):\n        raise TypeError(\"k must be an integer\")\n\n    n = len(arr)\n    if n == 0:\n        raise ValueError(\"arr must be non-empty\")\n    if k < 1 or k > n:\n        raise ValueError(\"k must be between 1 and len(arr)\")\n\n    total = 0\n    for x in arr[:k]:\n        if not isinstance(x, int):\n            raise TypeError(\"arr must contain integers\")\n        if abs(x) <= 99:\n            total += x\n\n    return total"}
{"task_id": "HumanEval/122", "solution": "def add_elements(arr, k):\n    \"\"\"\n    Given an array arr and integer k, sum elements with at most two digits from the first k elements.\n    Elements are considered to have at most two digits if their absolute value is less than 100.\n    \"\"\"\n    total_sum = 0\n    for i in range(k):\n        num = arr[i]\n        if -100 < num < 100:\n            total_sum += num\n    return total_sum"}
{"task_id": "HumanEval/123", "solution": "def get_odd_collatz(n):\n    \"\"\"\n    Given a positive integer n, return a sorted list of the unique odd numbers in its Collatz sequence.\n    The list includes 1 and is sorted in ascending order.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n    if n <= 0:\n        raise ValueError(\"n must be a positive integer\")\n\n    odd_values = set()\n    current = n\n\n    while current > 1:\n        if current % 2 != 0:  # If current is odd\n            odd_values.add(current)\n\n        if current % 2 == 0:\n            current = current // 2\n        else:\n            current = 3 * current + 1\n\n    odd_values.add(1)  # Ensure 1 is always included\n\n    return sorted(list(odd_values))"}
{"task_id": "HumanEval/125", "solution": "def split_words(txt):\n    \"\"\"\n    Splits the input string based on whitespace or commas, or counts specific lowercase letters.\n    The splitting priority is whitespace first, then commas.\n    \"\"\"\n    if any(c.isspace() for c in txt):\n        return txt.split()\n    elif ',' in txt:\n        return txt.split(',')\n    else:\n        count = 0\n        for char in txt:\n            if 'a' <= char <= 'z' and (ord(char) - ord('a')) % 2 == 1:\n                count += 1\n        return count"}
{"task_id": "HumanEval/126", "solution": "def is_sorted(lst):\n    \"\"\"Checks if a list is sorted in ascending order and if no number appears more than twice.\n    Returns True if both conditions are met, False otherwise.\n    \"\"\"\n    if len(lst) <= 1:\n        return True\n\n    counts = {}\n    for i in range(len(lst)):\n        num = lst[i]\n\n        counts[num] = counts.get(num, 0) + 1\n        if counts[num] > 2:\n            return False\n\n        if i > 0 and lst[i] < lst[i - 1]:\n            return False\n\n    return True"}
{"task_id": "HumanEval/126", "solution": "def is_sorted(lst):\n    '''\n    Given a list of numbers, return whether or not they are sorted\n    in ascending order. If list has more than 1 duplicate of the same\n    number, return False. Assume no negative numbers and only integers.\n    '''\n    counts = {}\n    for i in range(len(lst)):\n        current_num = lst[i]\n\n        # Check for non-decreasing order\n        if i > 0 and current_num < lst[i - 1]:\n            return False\n\n        # Check for duplicate count\n        counts[current_num] = counts.get(current_num, 0) + 1\n        if counts[current_num] > 2:\n            return False\n\n    return True"}
{"task_id": "HumanEval/124", "solution": "import re\n\ndef valid_date(date):\n    \"\"\"Validate a date string for format, range, and non-emptiness.\n    Returns True if valid, False otherwise.\n    \"\"\"\n    # Type and emptiness check\n    if not isinstance(date, str):\n        return False\n    stripped_date = date.strip()\n    if not stripped_date:\n        return False\n\n    # Format check: must be mm-dd-yyyy with two digits for month/day, four for year\n    if not re.match(r'^\\d{2}-\\d{2}-\\d{4}$', stripped_date):\n        return False\n\n    # Parse components into integers\n    parts = stripped_date.split('-')\n    month = int(parts[0])\n    day = int(parts[1])\n\n    # Month must be between 1 and 12\n    if not (1 <= month <= 12):\n        return False\n\n    # Determine max_day based on month\n    if month in {1, 3, 5, 7, 8, 10, 12}:\n        max_day = 31\n    elif month in {4, 6, 9, 11}:\n        max_day = 30\n    else:  # month == 2\n        max_day = 29  # As per specification, February allows up to 29 days\n\n    # Day must be between 1 and max_day for the given month\n    if not (1 <= day <= max_day):\n        return False\n\n    return True"}
{"task_id": "HumanEval/127", "solution": "def intersection(interval1, interval2):\n    \"\"\"Computes the length of the intersection of two intervals and checks if it's a prime number.\n    Returns \"YES\" if prime, otherwise \"NO\", or \"NO\" if no intersection.\"\"\"\n    def is_prime(n):\n        \"\"\"Checks if a number is prime.\"\"\"\n        if n <= 1:\n            return False\n        if n <= 3:\n            return True\n        if n % 2 == 0:\n            return False\n        i = 3\n        while i * i <= n:\n            if n % i == 0:\n                return False\n            i += 2\n        return True\n\n    a, b = interval1\n    c, d = interval2\n\n    left = max(a, c)\n    right = min(b, d)\n\n    if left > right:\n        return \"NO\"\n\n    length = right - left\n\n    if is_prime(length):\n        return \"YES\"\n    else:\n        return \"NO\""}
{"task_id": "HumanEval/128", "solution": "def prod_signs(arr):\n    \"\"\"\n    Calculates the sum of magnitudes of integers multiplied by the product of their signs.\n    Returns None for an empty array.\n    \"\"\"\n    if not arr:\n        return None\n\n    sum_magnitudes = 0\n    product_of_signs = 1\n\n    for x in arr:\n        sum_magnitudes += abs(x)\n        if x > 0:\n            product_of_signs *= 1\n        elif x < 0:\n            product_of_signs *= -1\n        else:  # x == 0\n            product_of_signs = 0\n            break  # If any number is 0, the product of signs is 0.\n\n    return sum_magnitudes * product_of_signs"}
{"task_id": "HumanEval/127", "solution": "def intersection(interval1, interval2):\n    \"\"\"Determines if the length of the intersection of two intervals is a prime number.\n    Uses deterministic Miller-Rabin for primality testing.\n    \"\"\"\n\n    def is_prime(n):\n        \"\"\"Tests if a number n is prime using deterministic Miller-Rabin for 64-bit integers.\"\"\"\n        if n < 2:\n            return False\n        if n == 2 or n == 3:\n            return True\n        if n % 2 == 0:\n            return False\n\n        # Miller-Rabin bases suitable for 64-bit integers\n        bases = [2, 325, 9375, 28178, 450775, 9780504, 1795265022]\n\n        # Decompose n-1 as d * 2^s with d odd\n        s = 0\n        d = n - 1\n        while d % 2 == 0:\n            d //= 2\n            s += 1\n\n        for a in bases:\n            # If 'a' is a multiple of 'n', it doesn't provide useful information for this test.\n            if a % n == 0:\n                continue\n\n            x = pow(a, d, n)\n            if x == 1 or x == n - 1:\n                continue\n\n            # Repeated squaring\n            composite_for_this_base = True\n            for _ in range(s - 1):\n                x = (x * x) % n\n                if x == n - 1:\n                    composite_for_this_base = False\n                    break\n\n            if composite_for_this_base:\n                return False  # n is composite\n\n        return True  # n is prime (deterministic for 64-bit with these bases)\n\n    # Unpack intervals (start1, end1) and (start2, end2)\n    a, b = interval1\n    c, d = interval2\n\n    # Compute intersection endpoints: [max(a,c), min(b,d)]\n    left = max(a, c)\n    right = min(b, d)\n\n    # If left > right, there is no intersection\n    if left > right:\n        return \"NO\"\n\n    # Calculate intersection length\n    length = right - left\n\n    # Check primality of length. Lengths 0 and 1 are not prime.\n    if length < 2:\n        return \"NO\"\n\n    if is_prime(length):\n        return \"YES\"\n    else:\n        return \"NO\""}
{"task_id": "HumanEval/129", "solution": "def minPath(grid, k):\n    \"\"\"\n    Given a grid with N rows and N columns (N >= 2) and a positive integer k,\n    each cell of the grid contains a value. Every integer in the range [1, N * N]\n    inclusive appears exactly once on the cells of the grid.\n\n    You have to find the minimum path of length k in the grid. You can start\n    from any cell, and in each step you can move to any of the neighbor cells,\n    in other words, you can go to cells which share an edge with you current\n    cell.\n    Please note that a path of length k means visiting exactly k cells (not\n    necessarily distinct).\n    You CANNOT go off the grid.\n    A path A (of length k) is considered less than a path B (of length k) if\n    after making the ordered lists of the values on the cells that A and B go\n    through (let's call them lst_A and lst_B), lst_A is lexicographically less\n    than lst_B, in other words, there exist an integer index i (1 <= i <= k)\n    such that lst_A[i] < lst_B[i] and for any j (1 <= j < i) we have\n    lst_A[j] = lst_B[j].\n    It is guaranteed that the answer is unique.\n    Return an ordered list of the values on the cells that the minimum path go through.\n    \"\"\"\n    import heapq\n\n    N = len(grid)\n    if N == 0 or k <= 0:\n        return []\n\n    # memo[(r, c, length)] = best path tuple reaching (r,c) with given length\n    memo = {}\n\n    # Priority queue items: (path_tuple, r, c)\n    pq = []\n\n    # Initialize with all starting cells (paths of length 1)\n    for r in range(N):\n        for c in range(N):\n            initial = (grid[r][c],)\n            memo[(r, c, 1)] = initial\n            heapq.heappush(pq, (initial, r, c))\n\n    # Directions: up, down, left, right\n    directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n\n    while pq:\n        path_tuple, r, c = heapq.heappop(pq)\n        length = len(path_tuple)\n\n        # If we have a strictly better recorded path for this state, skip\n        key = (r, c, length)\n        if key in memo and memo[key] < path_tuple:\n            continue\n\n        # If we've reached required length, return result (PQ ensures lexicographic minimality)\n        if length == k:\n            return list(path_tuple)\n\n        # Expand neighbors\n        for dr, dc in directions:\n            nr, nc = r + dr, c + dc\n            if 0 <= nr < N and 0 <= nc < N:\n                next_path = path_tuple + (grid[nr][nc],)\n                next_key = (nr, nc, length + 1)\n                if next_key not in memo or next_path < memo[next_key]:\n                    memo[next_key] = next_path\n                    heapq.heappush(pq, (next_path, nr, nc))\n\n    # As per problem statement, there should always be an answer; return empty list as fallback.\n    return []"}
{"task_id": "HumanEval/131", "solution": "def digits(n):\n    \"\"\"Given a positive integer n, return the product of the odd digits.\n    Return 0 if all digits are even.\"\"\"\n    product = 1\n    found_odd = False\n    for digit_char in str(n):\n        digit = int(digit_char)\n        if digit % 2 != 0:\n            product *= digit\n            found_odd = True\n    return product if found_odd else 0"}
{"task_id": "HumanEval/129", "solution": "def minPath(grid, k):\n    \"\"\"\n    Given an N x N grid where each integer 1..N^2 appears exactly once,\n    return the lexicographically smallest path of length k (list of values)\n    where you may start at any cell and at each step move to an orthogonally\n    adjacent cell. Path may revisit cells.\n    \"\"\"\n    N = len(grid)\n    # Initialize for path length 1: each cell's value is a path of length 1 ending at itself.\n    min_path_prev_len = [[None for _ in range(N)] for _ in range(N)]\n    for r in range(N):\n        for c in range(N):\n            min_path_prev_len[r][c] = [grid[r][c]]\n\n    # Directions for orthogonal movement: (dr, dc)\n    dr = [-1, 1, 0, 0]\n    dc = [0, 0, -1, 1]\n\n    # Build paths iteratively from length 2 to k\n    for length in range(2, k + 1):\n        min_path_current_len = [[None for _ in range(N)] for _ in range(N)]\n\n        for r in range(N):\n            for c in range(N):\n                best_path_for_rc = None\n                # Consider all neighbor cells that could have been the previous position\n                for i in range(4):\n                    prev_r, prev_c = r + dr[i], c + dc[i]\n                    if 0 <= prev_r < N and 0 <= prev_c < N:\n                        path_from_prev = min_path_prev_len[prev_r][prev_c]\n                        if path_from_prev is not None:\n                            candidate = path_from_prev + [grid[r][c]]\n                            if best_path_for_rc is None or candidate < best_path_for_rc:\n                                best_path_for_rc = candidate\n                min_path_current_len[r][c] = best_path_for_rc\n\n        min_path_prev_len = min_path_current_len\n\n    # Find the overall minimum path among all cells for length k\n    overall_min_path = None\n    for r in range(N):\n        for c in range(N):\n            path = min_path_prev_len[r][c]\n            if path is not None and (overall_min_path is None or path < overall_min_path):\n                overall_min_path = path\n\n    return overall_min_path"}
{"task_id": "HumanEval/131", "solution": "def digits(n):\n    \"\"\"Given an integer n, return the product of the odd digits.\n    Return 0 if all digits are even. Works for negative numbers by using abs(n).\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an int\")\n\n    n = abs(n)\n\n    # If n == 0, its only digit is 0 (even) so result should be 0\n    if n == 0:\n        return 0\n\n    product = 1\n    found_odd = False\n\n    while n > 0:\n        digit = n % 10\n        if digit % 2 == 1:\n            product *= digit\n            found_odd = True\n        n //= 10\n\n    return product if found_odd else 0"}
{"task_id": "HumanEval/134", "solution": "def check_if_last_char_is_a_letter(txt):\n    \"\"\"\n    Create a function that returns True if the last character\n    of a given string is an alphabetical character and is not\n    a part of a word, and False otherwise.\n    Note: \"word\" is a group of characters separated by space.\n    \"\"\"\n    if not txt:\n        return False\n\n    last_char = txt[-1]\n    if not last_char.isalpha():\n        return False\n\n    # Not part of a word if it's the only character or the previous character is a space\n    if len(txt) == 1 or txt[-2] == ' ':\n        return True\n\n    return False"}
{"task_id": "HumanEval/135", "solution": "def can_arrange(arr):\n    \"\"\"Create a function which returns the largest index of an element which\n    is not greater than or equal to the element immediately preceding it. If\n    no such element exists then return -1. The given array will not contain\n    duplicate values.\n    \"\"\"\n    for i in range(len(arr) - 1, 0, -1):\n        if arr[i] < arr[i - 1]:\n            return i\n    return -1"}
{"task_id": "HumanEval/132", "solution": "def is_nested(string):\n    \"\"\"\n    Return True if there exists a balanced subsequence of brackets with at least one nested pair.\n    That is, there exist indices i < j < k < l with string[i] == string[j] == '[' and\n    string[k] == string[l] == ']' (this subsequence corresponds to a nested pair like '[[]]').\n    \"\"\"\n    n = len(string)\n    if n < 4:\n        return False\n\n    # prefix count of '[' up to (but not including) index i: opens_prefix[i]\n    opens_prefix = [0] * (n + 1)\n    for i, ch in enumerate(string):\n        opens_prefix[i + 1] = opens_prefix[i] + (1 if ch == '[' else 0)\n\n    # suffix count of ']' after index i: closes_suffix[i] is count of ']' at indices >= i\n    closes_suffix = [0] * (n + 1)\n    for i in range(n - 1, -1, -1):\n        closes_suffix[i] = closes_suffix[i + 1] + (1 if string[i] == ']' else 0)\n\n    # Look for a ']' at position k such that there are at least two '[' before it\n    # and at least one ']' after it => indices i<j<k<l exist\n    for k, ch in enumerate(string):\n        if ch == ']' and opens_prefix[k] >= 2 and closes_suffix[k + 1] >= 1:\n            return True\n\n    return False"}
{"task_id": "HumanEval/135", "solution": "def can_arrange(arr):\n    \"\"\"\n    Returns the largest index of an element which is not greater than or equal to the element immediately preceding it.\n    If no such element exists, then returns -1.\n    \"\"\"\n    for i in range(len(arr) - 1, 0, -1):\n        if arr[i] < arr[i-1]:\n            return i\n    return -1"}
{"task_id": "HumanEval/134", "solution": "def check_if_last_char_is_a_letter(txt):\n    \"\"\"\n    Checks if the last character of a string is an alphabetical character\n    and is not part of a word (separated by space).\n    \"\"\"\n    if not txt:\n        return False\n\n    last_char = txt[-1]\n\n    if not last_char.isalpha():\n        return False\n\n    if len(txt) == 1:\n        return True\n\n    second_to_last_char = txt[-2]\n    return second_to_last_char == ' '"}
{"task_id": "HumanEval/132", "solution": "def is_nested(string):\n    \"\"\"\n    Checks if there exists a subsequence of brackets that contains at least one nested pair.\n    A nested pair implies finding the pattern '[ [ ] ]' as a subsequence.\n    \"\"\"\n    state = 0  # 0: looking for first '[', 1: found first '[', 2: found second '[', 3: found first ']'\n\n    for char in string:\n        if state == 0:\n            if char == '[':\n                state = 1\n        elif state == 1:\n            if char == '[':\n                state = 2\n        elif state == 2:\n            if char == ']':\n                state = 3\n        elif state == 3:\n            if char == ']':\n                return True\n\n    return False"}
{"task_id": "HumanEval/133", "solution": "import math\n\ndef sum_squares(lst):\n    \"\"\"Calculates the sum of squares of numbers after rounding each to its ceiling.\n    Handles empty lists by returning 0 and negative numbers correctly.\"\"\"\n    return sum(math.ceil(x) ** 2 for x in lst)"}
