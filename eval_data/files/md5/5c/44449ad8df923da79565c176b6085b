{"task_id": "HumanEval/118", "solution": "def get_closest_vowel(word):\n    \"\"\"Finds the closest vowel from the right side of the word that is surrounded by two consonants.\n    Vowels at the beginning or end of the word do not count.\n    \"\"\"\n    vowels = \"aeiouAEIOU\"\n\n    # Iterate from right to left, excluding the first and last characters.\n    for i in range(len(word) - 2, 0, -1):\n        char = word[i]\n\n        # Check if the current character is a vowel\n        if char in vowels:\n            left_char = word[i-1]\n            right_char = word[i+1]\n\n            # A character is considered a consonant if it is not a vowel,\n            # given the assumption that the string contains only English letters.\n            is_left_consonant = left_char not in vowels\n            is_right_consonant = right_char not in vowels\n\n            if is_left_consonant and is_right_consonant:\n                return char\n\n    return \"\""}
{"task_id": "HumanEval/117", "solution": "def select_words(s, n):\n    \"\"\"Given a string s and a natural number n, return a list of words from s\n    that contain exactly n consonants, preserving original order and casing.\n    Consonants are all letters except a, e, i, o, u (case-insensitive); 'y' is a consonant.\n    \"\"\"\n    vowels = {'a', 'e', 'i', 'o', 'u'}\n    result = []\n\n    words = s.split()  # Handles multiple spaces and leading/trailing spaces\n\n    for word in words:\n        consonant_count = 0\n        word_lower = word.lower()  # Convert to lowercase for case-insensitive counting\n        for char in word_lower:\n            # Check if character is alphabetic and not in the set of vowels\n            if char.isalpha() and char not in vowels:\n                consonant_count += 1\n\n        if consonant_count == n:\n            result.append(word)  # Append the original word (preserving its case)\n\n    return result"}
{"task_id": "HumanEval/119", "solution": "def match_parens(lst):\n    \"\"\"\n    Checks if concatenating two strings of parentheses in any order results in a balanced string.\n    Returns 'Yes' if possible, 'No' otherwise.\n    \"\"\"\n    def _is_balanced(s):\n        \"\"\"Checks if a string of parentheses is balanced.\"\"\"\n        balance = 0\n        for char in s:\n            if char == '(':\n                balance += 1\n            else:  # char == ')'\n                balance -= 1\n            if balance < 0:\n                return False\n        return balance == 0\n\n    # Check the first concatenation order: lst[0] + lst[1]\n    s1 = lst[0] + lst[1]\n    if _is_balanced(s1):\n        return 'Yes'\n\n    # Check the second concatenation order: lst[1] + lst[0]\n    s2 = lst[1] + lst[0]\n    if _is_balanced(s2):\n        return 'Yes'\n\n    # If neither concatenation results in a balanced string\n    return 'No'"}
{"task_id": "HumanEval/118", "solution": "def get_closest_vowel(word):\n    \"\"\"Finds the closest vowel surrounded by consonants from the right.\n    Returns an empty string if no such vowel is found.\n    \"\"\"\n    vowels = \"aeiouAEIOU\"\n\n    # A word needs at least 3 characters for a middle vowel (not at start/end)\n    # to be surrounded by two consonants.\n    if len(word) < 3:\n        return \"\"\n\n    # Iterate from the second-to-last character down to the second character (index 1).\n    # This ensures word[i] is never at the very beginning or end of the word.\n    for i in range(len(word) - 2, 0, -1):\n        char = word[i]\n\n        # Check if the current character is a vowel.\n        if char in vowels:\n            left_neighbor = word[i-1]\n            right_neighbor = word[i+1]\n\n            # Check if both neighbors are consonants.\n            if left_neighbor not in vowels and right_neighbor not in vowels:\n                return char # Found the closest valid vowel from the right.\n\n    return \"\" # No vowel met the conditions."}
