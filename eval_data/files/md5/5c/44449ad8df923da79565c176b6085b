{"task_id": "HumanEval/32", "solution": "def find_zero(xs: list):\n    \"\"\"Find and return a single real root of the polynomial whose coefficients are given\n    in xs (constant term first). Assumes:\n      - len(xs) is even (so degree is odd, guaranteeing at least one real root)\n      - the leading coefficient (xs[-1]) is non-zero\n    Raises ValueError for invalid input or if a bracket cannot be found.\n    \"\"\"\n    import math\n\n    # Input validation\n    if not isinstance(xs, (list, tuple)):\n        raise ValueError(\"xs must be a list or tuple of coefficients.\")\n    n = len(xs)\n    if n < 2:\n        raise ValueError(\"xs must contain at least two coefficients (odd degree >= 1).\")\n    if n % 2 != 0:\n        raise ValueError(\"xs must have an even number of coefficients (odd polynomial degree).\")\n    leading = xs[-1]\n    if leading == 0:\n        raise ValueError(\"Leading coefficient must be non-zero.\")\n\n    # Horner's method for polynomial evaluation (more stable than pow-based eval)\n    def _eval(x: float) -> float:\n        acc = 0.0\n        # iterate from highest degree down to constant term\n        for coeff in reversed(xs):\n            acc = acc * x + coeff\n        return acc\n\n    tol = 1e-12\n    max_expand = 200\n    max_bisect = 200\n\n    # Quick check at 0\n    f0 = _eval(0.0)\n    if math.isfinite(f0) and abs(f0) <= tol:\n        return 0.0\n\n    # Find bracket [a, b] with sign change. Start at [-1, 1] and expand exponentially.\n    a, b = -1.0, 1.0\n    fa = _eval(a)\n    fb = _eval(b)\n    if math.isfinite(fa) and abs(fa) <= tol:\n        return a\n    if math.isfinite(fb) and abs(fb) <= tol:\n        return b\n\n    for _ in range(max_expand):\n        if not (math.isfinite(fa) and math.isfinite(fb)):\n            # If evaluation overflowed/nan, try reducing growth by choosing smaller initial brackets\n            a, b = -0.5, 0.5\n            fa = _eval(a)\n            fb = _eval(b)\n        if fa * fb < 0:\n            break\n        # expand interval outward\n        a *= 2.0\n        b *= 2.0\n        fa = _eval(a)\n        fb = _eval(b)\n        if math.isfinite(fa) and abs(fa) <= tol:\n            return a\n        if math.isfinite(fb) and abs(fb) <= tol:\n            return b\n    else:\n        raise ValueError(\"Failed to find an interval where the polynomial changes sign.\")\n\n    # Bisection method on [a, b]\n    for _ in range(max_bisect):\n        mid = (a + b) / 2.0\n        fmid = _eval(mid)\n        if not math.isfinite(fmid):\n            # numerical issues at midpoint; shrink interval a bit and continue\n            mid = (2 * a + b) / 3.0\n            fmid = _eval(mid)\n            if not math.isfinite(fmid):\n                mid = (a + 2 * b) / 3.0\n                fmid = _eval(mid)\n                if not math.isfinite(fmid):\n                    raise ValueError(\"Numerical instability encountered during root finding.\")\n        # stopping criteria\n        if abs(fmid) <= tol or (b - a) / 2.0 <= tol:\n            return mid\n        # choose subinterval\n        if fa * fmid <= 0:\n            b = mid\n            fb = fmid\n        else:\n            a = mid\n            fa = fmid\n\n    # If not converged within iteration limit, return midpoint as best effort\n    return (a + b) / 2.0"}
{"task_id": "HumanEval/33", "solution": "def sort_third(l: list):\n    \"\"\"This function sorts elements at indices divisible by three in a list, keeping other elements in their original positions.\n    It returns a new list with these sorted elements.\n    \"\"\"\n    elements_at_third_indices = []\n    for i, x in enumerate(l):\n        if i % 3 == 0:\n            elements_at_third_indices.append(x)\n\n    elements_at_third_indices.sort()\n\n    result_list = list(l)  # Create a mutable copy of the input list\n    sorted_idx = 0\n    for i in range(len(result_list)):\n        if i % 3 == 0:\n            result_list[i] = elements_at_third_indices[sorted_idx]\n            sorted_idx += 1\n\n    return result_list"}
{"task_id": "HumanEval/35", "solution": "def max_element(l: list):\n    \"\"\"Return maximum element in the list.\n    >>> max_element([1, 2, 3])\n    3\n    >>> max_element([5, 3, -5, 2, -3, 3, 9, 0, 123, 1, -10])\n    123\n    \"\"\"\n    if not isinstance(l, list):\n        raise TypeError(\"l must be a list\")\n    if not l:\n        raise ValueError(\"max_element() arg is an empty list\")\n\n    max_val = l[0]\n    for element in l[1:]:\n        try:\n            if element > max_val:\n                max_val = element\n        except TypeError:\n            raise TypeError(\"Elements of l are not comparable\")\n    return max_val"}
