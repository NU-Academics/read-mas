{"task_id": "HumanEval/16", "solution": "def count_distinct_characters(string: str) -> int:\n    \"\"\" Given a string, find out how many distinct characters (regardless of case) does it consist of\n    >>> count_distinct_characters('xyzXYZ')\n    3\n    >>> count_distinct_characters('Jerry')\n    4\n    \"\"\"\n    if not isinstance(string, str):\n        raise TypeError(\"string must be a str\")\n    return len(set(string.lower()))"}
{"task_id": "HumanEval/17", "solution": "from typing import List\n\n\ndef parse_music(music_string: str) -> List[int]:\n    \"\"\"Parses a string of musical notes and returns a list of their durations in beats.\n    Valid notes are 'o' (4 beats), 'o|' (2 beats), and '.|' (1 beat).\n    \"\"\"\n    if not isinstance(music_string, str):\n        raise TypeError(\"music_string must be a str\")\n\n    duration_map = {\n        'o': 4,\n        'o|': 2,\n        '.|': 1,\n    }\n\n    tokens = music_string.split()\n    durations: List[int] = []\n    for token in tokens:\n        if token not in duration_map:\n            raise ValueError(f\"Invalid token: '{token}'\")\n        durations.append(duration_map[token])\n\n    return durations"}
{"task_id": "HumanEval/16", "solution": "def count_distinct_characters(string: str) -> int:\n    \"\"\"Given a string, return the number of distinct characters it contains,\n    counting characters case-insensitively (Unicode-aware).\n\n    Examples:\n    >>> count_distinct_characters('xyzXYZ')\n    3\n    >>> count_distinct_characters('Jerry')\n    4\n    \"\"\"\n    if not isinstance(string, str):\n        raise TypeError(\"string must be a str\")\n    # Use casefold() for Unicode-aware case-insensitive comparison\n    return len(set(string.casefold()))"}
{"task_id": "HumanEval/18", "solution": "def how_many_times(string: str, substring: str) -> int:\n    \"\"\"Finds overlapping occurrences of a substring in a string.\n    Iterates through the string to count matches at each possible start position.\"\"\"\n    count = 0\n    n = len(string)\n    m = len(substring)\n    if m == 0:\n        return 0\n    for i in range(n - m + 1):\n        if string[i: i + m] == substring:\n            count += 1\n    return count"}
{"task_id": "HumanEval/17", "solution": "from typing import List\n\n\ndef parse_music(music_string: str) -> List[int]:\n    \"\"\"Parses a music string with ASCII tokens into a list of beat durations.\n    Tokens 'o', 'o|', '.|' map to 4, 2, 1 beats respectively; unknown tokens raise ValueError.\"\"\"\n    if not music_string:\n        return []\n\n    beat_mapping = {\n        'o': 4,\n        'o|': 2,\n        '.|': 1\n    }\n\n    tokens = music_string.split()\n    result = []\n\n    for token in tokens:\n        if token not in beat_mapping:\n            raise ValueError(f\"Unknown token: {token}\")\n        result.append(beat_mapping[token])\n\n    return result"}
{"task_id": "HumanEval/18", "solution": "def how_many_times(string: str, substring: str) -> int:\n    \"\"\"Find how many times a given substring can be found in the original string. Count overlapping cases.\n    If the substring is empty, return 0 as per design specifications.\n    \"\"\"\n    if not substring:\n        return 0\n\n    count = 0\n    start = 0\n    while True:\n        idx = string.find(substring, start)\n        if idx == -1:\n            break\n        count += 1\n        start = idx + 1\n    return count"}
{"task_id": "HumanEval/20", "solution": "def find_closest_elements(numbers: List[float]) -> Tuple[float, float]:\n    \"\"\"Finds two numbers in a list that are closest to each other.\n    Returns them as a tuple (smaller number, larger number).\n    \"\"\"\n    if len(numbers) < 2:\n        # Per problem constraints, list length is at least two.\n        # This branch is here for completeness.\n        return (float('nan'), float('nan'))\n\n    sorted_numbers = sorted(numbers)\n\n    min_diff = float('inf')\n    closest_pair = (sorted_numbers[0], sorted_numbers[1])\n\n    for i in range(len(sorted_numbers) - 1):\n        diff = sorted_numbers[i + 1] - sorted_numbers[i]\n        if diff < min_diff:\n            min_diff = diff\n            closest_pair = (sorted_numbers[i], sorted_numbers[i + 1])\n\n    return closest_pair"}
{"task_id": "HumanEval/19", "solution": "def sort_numbers(numbers: str) -> str:\n    \"\"\" Input is a space-delimited string of numberals from 'zero' to 'nine'.\n    Returns the string with numbers sorted from smallest to largest.\n    \"\"\"\n    word_to_int = {\n        'zero': 0, 'one': 1, 'two': 2, 'three': 3, 'four': 4,\n        'five': 5, 'six': 6, 'seven': 7, 'eight': 8, 'nine': 9\n    }\n    int_to_word = {v: k for k, v in word_to_int.items()}\n\n    number_words = numbers.split()\n    numeric_values = [word_to_int[word] for word in number_words]\n    numeric_values.sort()\n\n    sorted_words = [int_to_word[val] for val in numeric_values]\n    return ' '.join(sorted_words)"}
{"task_id": "HumanEval/19", "solution": "def sort_numbers(numbers: str) -> str:\n    \"\"\" Input is a space-delimited string of numerals from 'zero' to 'nine'.\n    Valid choices are 'zero', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight' and 'nine'.\n    Return the string with numbers sorted from smallest to largest\n    >>> sort_numbers('three one five')\n    'one three five'\n    \"\"\"\n    word_to_int = {\n        'zero': 0, 'one': 1, 'two': 2, 'three': 3, 'four': 4,\n        'five': 5, 'six': 6, 'seven': 7, 'eight': 8, 'nine': 9\n    }\n    int_to_word = {v: k for k, v in word_to_int.items()}\n\n    if numbers is None:\n        raise TypeError(\"numbers must be a str\")\n\n    # Split handles extra spaces; normalize to lowercase to be permissive\n    tokens = [tok.lower() for tok in numbers.split()]\n\n    # Empty or whitespace-only input -> return empty string\n    if not tokens:\n        return \"\"\n\n    invalid = [tok for tok in tokens if tok not in word_to_int]\n    if invalid:\n        raise ValueError(f\"Invalid numeral token(s): {', '.join(invalid)}\")\n\n    numeric_values = [word_to_int[tok] for tok in tokens]\n    numeric_values.sort()\n    sorted_words = [int_to_word[num] for num in numeric_values]\n    return \" \".join(sorted_words)"}
