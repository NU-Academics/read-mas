{"task_id": "HumanEval/105", "solution": "def by_length(arr):\n    \"\"\"\n    Sorts integers between 1 and 9, reverses them, and replaces with names.\n    Numbers outside the 1-9 range are ignored.\n    \"\"\"\n    digit_names = {\n        1: \"One\", 2: \"Two\", 3: \"Three\", 4: \"Four\", 5: \"Five\",\n        6: \"Six\", 7: \"Seven\", 8: \"Eight\", 9: \"Nine\"\n    }\n\n    # Filter for numbers between 1 and 9 inclusive, then sort them in ascending order.\n    filtered_and_sorted_numbers = sorted([n for n in arr if 1 <= n <= 9])\n\n    # Reverse the sorted list of numbers.\n    reversed_numbers = filtered_and_sorted_numbers[::-1]\n\n    # Replace each number with its corresponding English name.\n    result = [digit_names[n] for n in reversed_numbers]\n\n    return result"}
{"task_id": "HumanEval/103", "solution": "def rounded_avg(n, m):\n    \"\"\"Computes the average of integers from n through m, rounded half to even, and returns its binary string.\n    Returns -1 if n > m.\"\"\"\n    if n > m:\n        return -1\n\n    total = n + m\n    integer_part = total // 2\n\n    # Check if the average is X.5 (total is odd)\n    if total % 2 != 0:\n        # Apply \"round half to even\" rule for X.5 cases.\n        # If integer_part (X) is odd, round up (X.5 -> X+1).\n        # If integer_part (X) is even, round down (X.5 -> X).\n        if integer_part % 2 != 0:\n            integer_part += 1\n\n    return bin(integer_part)"}
{"task_id": "HumanEval/106", "solution": "def f(n):\n    \"\"\"\n    Implement the function f that takes n as a parameter,\n    and returns a list of size n, such that the value of the element at index i is the factorial of i if i is even\n    or the sum of numbers from 1 to i otherwise.\n    i starts from 1.\n    the factorial of i is the multiplication of the numbers from 1 to i (1 * 2 * ... * i).\n    Example:\n    f(5) == [1, 2, 6, 24, 15]\n    \"\"\"\n    if n <= 0:\n        return []\n    result = []\n    factorial = 1\n    running_sum = 0\n    for i in range(1, n + 1):\n        factorial *= i\n        running_sum += i\n        if i % 2 == 0:\n            result.append(factorial)\n        else:\n            result.append(running_sum)\n    return result"}
{"task_id": "HumanEval/107", "solution": "def even_odd_palindrome(n):\n    \"\"\"\n    Counts even and odd integer palindromes up to n.\n    Returns a tuple with the counts of even and odd palindromes respectively.\n    \"\"\"\n    even_palindromes = 0\n    odd_palindromes = 0\n\n    for i in range(1, n + 1):\n        s = str(i)\n        if s == s[::-1]:  # Check if the number is a palindrome\n            if i % 2 == 0:\n                even_palindromes += 1\n            else:\n                odd_palindromes += 1\n\n    return (even_palindromes, odd_palindromes)"}
