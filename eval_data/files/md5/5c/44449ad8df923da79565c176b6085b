{"task_id": "HumanEval/92", "solution": "def any_int(x, y, z):\n    \"\"\"\n    Returns True if one of the numbers equals the sum of the other two, and all inputs are integers.\n    Returns False otherwise, especially for non-int or boolean inputs.\n    \"\"\"\n    # Validate inputs: all must be integers and not booleans.\n    for val in (x, y, z):\n        if not isinstance(val, int) or isinstance(val, bool):\n            return False\n\n    # Check if any number is the sum of the other two.\n    if x == y + z:\n        return True\n    if y == x + z:\n        return True\n    if z == x + y:\n        return True\n\n    return False"}
{"task_id": "HumanEval/91", "solution": "def is_bored(S):\n    import re\n    if S is None or S == \"\":\n        return 0\n    # Match start of segment allowing leading spaces and opening punctuation,\n    # then an 'I' not followed by a word character or apostrophe (to exclude \"I'm\" and \"Ink\").\n    pattern = re.compile(r'^[\\s\"\\'\\(\\[\\{\\<]*I(?![\\w\\'])')\n    segments = re.split(r'[.!?]', S)\n    count = 0\n    for seg in segments:\n        if pattern.match(seg):\n            count += 1\n    return count"}
{"task_id": "HumanEval/93", "solution": "def encode(message):\n    \"\"\"\n    Encodes a message by swapping letter cases and replacing vowels.\n    Vowels are replaced by the letter 2 places ahead in the alphabet.\n    \"\"\"\n    result_chars = []\n    vowels = \"aeiouAEIOU\"\n\n    for char in message:\n        processed_char = char\n        if char.isalpha():\n            if char in vowels:\n                base = ord('a') if char.islower() else ord('A')\n                offset = ord(char) - base\n                new_offset = (offset + 2)\n                processed_char = chr(base + new_offset)\n\n            processed_char = processed_char.swapcase()\n\n        result_chars.append(processed_char)\n\n    return \"\".join(result_chars)"}
{"task_id": "HumanEval/91", "solution": "def is_bored(S):\n    \"\"\"\n    Count how many sentences in S start with the word \"I\".\n    Sentences are delimited by '.', '?' or '!'. Leading whitespace and\n    common opening punctuation (quotes, parentheses, brackets, braces, '<')\n    before the 'I' are ignored.\n    \"\"\"\n    import re\n\n    if not S:\n        return 0\n\n    # Split on sentence delimiters. This may produce empty fragments; that's fine.\n    sentences = re.split(r'[.?!]', S)\n\n    # Match start of sentence with optional whitespace and opening punctuation,\n    # followed by uppercase I as a whole word (so \"I\", \"I'm\", \"I,\" etc. count).\n    pattern = re.compile(r'^\\s*[\\\"\\'\u201c\u201d\u2018\u2019\\(\\[\\{<]*I\\b')\n\n    count = 0\n    for seg in sentences:\n        if pattern.match(seg):\n            count += 1\n\n    return count"}
{"task_id": "HumanEval/93", "solution": "def encode(message):\n    \"\"\"\n    Encodes a message by swapping letter cases and replacing vowels.\n    Vowels (a, e, i, o, u) are replaced by letters two positions ahead (e.g., a->c, E->G).\n    \"\"\"\n    result_chars = []\n    # Define explicit vowel mappings for both cases.\n    vowel_map_lower = {'a': 'c', 'e': 'g', 'i': 'k', 'o': 'q', 'u': 'w'}\n    vowel_map_upper = {'A': 'C', 'E': 'G', 'I': 'K', 'O': 'Q', 'U': 'W'}\n\n    for char in message:\n        if char.isalpha():\n            processed_char = char\n            # Apply vowel replacement if the character is a vowel.\n            if char in vowel_map_lower:\n                processed_char = vowel_map_lower[char]\n            elif char in vowel_map_upper:\n                processed_char = vowel_map_upper[char]\n\n            # Swap the case of the (potentially replaced) character.\n            if processed_char.islower():\n                result_chars.append(processed_char.upper())\n            else: # processed_char.isupper()\n                result_chars.append(processed_char.lower())\n        else:\n            # Non-alphabetic characters are preserved unchanged.\n            result_chars.append(char)\n\n    return \"\".join(result_chars)"}
{"task_id": "HumanEval/94", "solution": "def skjkasdkd(lst):\n    \"\"\"You are given a list of integers.\n    You need to find the largest prime value and return the sum of its digits.\n\n    Examples:\n    For lst = [0,3,2,1,3,5,7,4,5,5,5,2,181,32,4,32,3,2,32,324,4,3] the output should be 10\n    For lst = [1,0,1,8,2,4597,2,1,3,40,1,2,1,2,4,2,5,1] the output should be 25\n    For lst = [1,3,1,32,5107,34,83278,109,163,23,2323,32,30,1,9,3] the output should be 13\n    For lst = [0,724,32,71,99,32,6,0,5,91,83,0,5,6] the output should be 11\n    For lst = [0,81,12,3,1,21] the output should be 3\n    For lst = [0,8,1,2,1,7] the output should be 7\n    \"\"\"\n    def is_prime(n):\n        if n <= 1:\n            return False\n        if n <= 3:\n            return True\n        if n % 2 == 0 or n % 3 == 0:\n            return False\n        i = 5\n        while i * i <= n:\n            if n % i == 0 or n % (i + 2) == 0:\n                return False\n            i += 6\n        return True\n\n    largest = None\n    for x in lst:\n        if is_prime(x):\n            if largest is None or x > largest:\n                largest = x\n\n    if largest is None:\n        return 0\n\n    return sum(int(d) for d in str(largest))"}
