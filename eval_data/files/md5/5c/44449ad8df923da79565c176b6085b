{"task_id": "HumanEval/9", "solution": "def rolling_max(numbers: List[int]) -> List[int]:\n    \"\"\" From a given list of integers, generate a list of rolling maximum element found until given moment\n    in the sequence.\n    >>> rolling_max([1, 2, 3, 2, 3, 4, 2])\n    [1, 2, 3, 3, 3, 4, 4]\n    \"\"\"\n    result: List[int] = []\n    if not numbers:\n        return result\n    current_max = numbers[0]\n    result.append(current_max)\n    for num in numbers[1:]:\n        if num > current_max:\n            current_max = num\n        result.append(current_max)\n    return result"}
{"task_id": "HumanEval/9", "solution": "from typing import List\n\ndef rolling_max(numbers: List[int]) -> List[int]:\n    \"\"\"Generates a list where each element is the maximum value seen in the input list up to that index.\n    Example: [1, 2, 3, 2, 3, 4, 2] -> [1, 2, 3, 3, 3, 4, 4].\n    \"\"\"\n    if not numbers:\n        return []\n\n    result: List[int] = []\n    current_max = float('-inf')\n\n    for x in numbers:\n        if x > current_max:\n            current_max = x\n        result.append(current_max)\n\n    return result"}
{"task_id": "HumanEval/10", "solution": "def make_palindrome(string: str) -> str:\n    \"\"\"Find the shortest palindrome that begins with the supplied string.\n\n    Algorithm:\n    - Find the longest suffix of `string` that is a palindrome.\n    - Append the reverse of the prefix that precedes that suffix.\n\n    Examples:\n    >>> make_palindrome('')\n    ''\n    >>> make_palindrome('cat')\n    'catac'\n    >>> make_palindrome('cata')\n    'catac'\n    \"\"\"\n    n = len(string)\n    # Check each suffix starting from the whole string; the first palindrome suffix\n    # encountered is the longest one.\n    for i in range(n):\n        suffix = string[i:]\n        if suffix == suffix[::-1]:\n            return string + string[:i][::-1]\n    # If no suffix is palindrome (only possible when string is empty), append reversed whole string\n    return string + string[::-1]"}
{"task_id": "HumanEval/10", "solution": "def prefix_function(t: str) -> list[int]:\n    \"\"\"Computes the KMP prefix function (LPS array) for a given string.\n    The LPS array stores the length of the longest proper prefix of the string\n    that is also a suffix of the string for each prefix.\n    \"\"\"\n    m = len(t)\n    pi = [0] * m\n    for i in range(1, m):\n        j = pi[i-1]\n        while j > 0 and t[i] != t[j]:\n            j = pi[j-1]\n        if t[i] == t[j]:\n            j += 1\n        pi[i] = j\n    return pi\n\ndef make_palindrome(string: str) -> str:\n    \"\"\"Finds the shortest palindrome that begins with a supplied string.\n    It uses the KMP prefix function to find the longest palindromic suffix.\n    \"\"\"\n    n = len(string)\n    if n <= 1:\n        return string\n\n    rev_string = string[::-1]\n    # Construct combined string: reversed_string + '#' + original_string\n    combined = rev_string + '#' + string\n\n    # Compute prefix function for the combined string\n    pi = prefix_function(combined)\n\n    # The last element of pi array gives the length of the longest prefix of\n    # rev_string that is also a suffix of string (longest palindromic suffix).\n    match_len = pi[-1]\n\n    # The characters to append are the reverse of the prefix of string\n    # that comes before the longest palindromic suffix.\n    to_append = string[:n - match_len][::-1]\n\n    return string + to_append"}
{"task_id": "HumanEval/11", "solution": "def string_xor(a: str, b: str) -> str:\n    \"\"\" Input are two strings a and b consisting only of 1s and 0s.\n    Perform binary XOR on these inputs and return result also as a string.\n    >>> string_xor('010', '110')\n    '100'\n    \"\"\"\n    if not isinstance(a, str) or not isinstance(b, str):\n        raise TypeError(\"Both inputs must be strings.\")\n    if len(a) != len(b):\n        raise ValueError(\"Inputs must have the same length.\")\n    valid_chars = {\"0\", \"1\"}\n    if (set(a) - valid_chars) or (set(b) - valid_chars):\n        raise ValueError(\"Inputs must contain only '0' and '1' characters.\")\n    return ''.join('1' if x != y else '0' for x, y in zip(a, b))"}
{"task_id": "HumanEval/12", "solution": "from typing import List, Optional\n\n\ndef longest(strings: List[str]) -> Optional[str]:\n    \"\"\"Out of list of strings, return the longest one.\n    Returns None if the input list is empty, otherwise the first longest string.\n    \"\"\"\n    if not strings:\n        return None\n\n    max_string = strings[0]\n    for s in strings:\n        if len(s) > len(max_string):\n            max_string = s\n    return max_string"}
{"task_id": "HumanEval/11", "solution": "def string_xor(a: str, b: str) -> str:\n    \"\"\" Input are two strings a and b consisting only of 1s and 0s.\n    Perform binary XOR on these inputs and return result also as a string.\n    \"\"\"\n    result = []\n    for i in range(len(a)):\n        if a[i] == b[i]:\n            result.append('0')\n        else:\n            result.append('1')\n    return \"\".join(result)"}
{"task_id": "HumanEval/13", "solution": "def greatest_common_divisor(a: int, b: int) -> int:\n    \"\"\" Return a greatest common divisor of two integers a and b\n    >>> greatest_common_divisor(3, 5)\n    1\n    >>> greatest_common_divisor(25, 15)\n    5\n    \"\"\"\n    # Use absolute values to ensure a non-negative greatest common divisor.\n    # This implements the Euclidean algorithm efficiently.\n    a_val, b_val = abs(a), abs(b)\n    while b_val:\n        a_val, b_val = b_val, a_val % b_val\n    return a_val"}
{"task_id": "HumanEval/13", "solution": "def greatest_common_divisor(a: int, b: int) -> int:\n    \"\"\"Return a greatest common divisor of two integers a and b using the iterative Euclidean algorithm.\n    >>> greatest_common_divisor(3, 5)\n    1\n    >>> greatest_common_divisor(25, 15)\n    5\n    \"\"\"\n    a, b = abs(a), abs(b)\n    while b != 0:\n        a, b = b, a % b\n    return a"}
{"task_id": "HumanEval/12", "solution": "def longest(strings: List[str]) -> Optional[str]:\n    \"\"\" Out of list of strings, return the longest one. Return the first one in case of multiple\n    strings of the same length. Return None in case the input list is empty.\n    \"\"\"\n    if not strings:\n        return None\n    return max(strings, key=len)"}
{"task_id": "HumanEval/14", "solution": "from typing import List\n\n\ndef all_prefixes(string: str) -> List[str]:\n    \"\"\" Return list of all prefixes from shortest to longest of the input string.\"\"\"\n    prefixes = []\n    for i in range(1, len(string) + 1):\n        prefixes.append(string[0:i])\n    return prefixes"}
{"task_id": "HumanEval/14", "solution": "from typing import List\n\ndef all_prefixes(string: str) -> List[str]:\n    \"\"\"Return a list of all prefixes of the input string from shortest to longest.\n\n    Examples:\n    >>> all_prefixes('abc')\n    ['a', 'ab', 'abc']\n    \"\"\"\n    if not isinstance(string, str):\n        raise TypeError(f\"Expected 'string' to be str, got {type(string).__name__}\")\n    return [string[:i] for i in range(1, len(string) + 1)]"}
