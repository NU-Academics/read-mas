{"task_id": "HumanEval/65", "solution": "def circular_shift(x, shift):\n    \"\"\"Circular shift the digits of the integer x right by shift positions.\n    If shift exceeds the number of digits, the digits are reversed.\n    \"\"\"\n    s_x = str(x)\n    n = len(s_x)\n\n    if shift > n:\n        return s_x[::-1]\n    else:\n        effective_shift = shift % n\n        if effective_shift == 0:\n            return s_x\n        return s_x[-effective_shift:] + s_x[:-effective_shift]"}
{"task_id": "HumanEval/65", "solution": "def circular_shift(x, shift):\n    \"\"\"Circular shift the digits of the integer x, shift the digits right by shift\n    and return the result as a string. If shift > number of digits, return digits reversed.\n    \"\"\"\n    s = str(x)\n    n = len(s)\n\n    if shift > n:\n        return s[::-1]\n    else:\n        # Calculate the effective shift and perform circular right shift.\n        k = shift % n\n        return s[-k:] + s[:-k]"}
{"task_id": "HumanEval/67", "solution": "import re\n\ndef fruit_distribution(s,n):\n    \"\"\"\n    Calculates the number of mango fruits in a basket given apple/orange counts string and total fruits.\n    It parses the string for apple and orange counts using regular expressions.\n    \"\"\"\n    apples_match = re.search(r'(\\d+)\\s*apples', s)\n    num_apples = int(apples_match.group(1))\n\n    oranges_match = re.search(r'(\\d+)\\s*oranges', s)\n    num_oranges = int(oranges_match.group(1))\n\n    num_mangoes = n - num_apples - num_oranges\n    return num_mangoes"}
{"task_id": "HumanEval/67", "solution": "import re\n\ndef fruit_distribution(s, n):\n    \"\"\"\n    Calculates the number of mango fruits based on a string describing apples and oranges,\n    and a total fruit count. It parses fruit counts from the string and subtracts them from the total.\n    \"\"\"\n    if not isinstance(s, str):\n        raise TypeError(\"s must be a string\")\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n\n    s_normalized = s.lower().strip()\n\n    apples_re = re.compile(r\"([0-9,]+)\\s*apples?\", re.IGNORECASE)\n    oranges_re = re.compile(r\"([0-9,]+)\\s*oranges?\", re.IGNORECASE)\n    numbers_re = re.compile(r\"[0-9,]+\")\n\n    apple_match = apples_re.search(s_normalized)\n    orange_match = oranges_re.search(s_normalized)\n\n    if apple_match and orange_match:\n        apples = int(apple_match.group(1).replace(\",\", \"\"))\n        oranges = int(orange_match.group(1).replace(\",\", \"\"))\n    else:\n        all_num_strs = numbers_re.findall(s_normalized)\n        if len(all_num_strs) < 2:\n            raise ValueError(\"could not find both apples and oranges counts in the string\")\n        num_list = [int(num_str.replace(\",\", \"\")) for num_str in all_num_strs]\n        apples, oranges = num_list[0], num_list[1]\n\n    if apples < 0 or oranges < 0:\n        raise ValueError(\"fruit counts must be non-negative\")\n\n    mangoes = n - apples - oranges\n    if mangoes < 0:\n        raise ValueError(\"total n is inconsistent: negative mango count\")\n\n    return mangoes"}
{"task_id": "HumanEval/69", "solution": "from collections import Counter\n\ndef search(lst):\n    \"\"\"\n    Finds the greatest integer v in the list such that its frequency is >= v.\n    Returns -1 if no such integer exists.\n    \"\"\"\n    counts = Counter(lst)\n    best = -1\n    for v, freq in counts.items():\n        if freq >= v:  # v is guaranteed positive by problem statement\n            if v > best:\n                best = v\n    return best"}
{"task_id": "HumanEval/68", "solution": "def pluck(arr):\n    \"\"\"\n    Finds the smallest even value and its first-occurrence index in arr.\n    Returns [value, index] or [] if no even numbers are found or arr is empty.\n    \"\"\"\n    if not arr:\n        return []\n\n    min_val = None\n    min_idx = -1\n\n    for i, v in enumerate(arr):\n        if v % 2 == 0:\n            if min_val is None or v < min_val:\n                min_val = v\n                min_idx = i\n\n    if min_val is None:\n        return []\n    else:\n        return [min_val, min_idx]"}
{"task_id": "HumanEval/68", "solution": "def pluck(arr):\n    \"\"\"\n    Finds the smallest even-valued node in an array, returning its value and the smallest index it appears at.\n    If no even values or the array is empty, an empty list is returned.\n    \"\"\"\n    smallest_even_value = float('inf')\n    smallest_even_index = -1\n\n    for i, val in enumerate(arr):\n        if val % 2 == 0:  # Check if the current node value is even\n            if val < smallest_even_value:\n                smallest_even_value = val\n                smallest_even_index = i\n\n    if smallest_even_index == -1:\n        return []\n    else:\n        return [smallest_even_value, smallest_even_index]"}
{"task_id": "HumanEval/70", "solution": "def strange_sort_list(lst):\n    \"\"\"\n    Sorts a list of integers in a 'strange' order: min, then max, then next min, etc.\n    Returns a new list without mutating the input.\n    \"\"\"\n    if not lst:\n        return []\n\n    s = sorted(lst)\n    result = []\n    l = 0\n    r = len(s) - 1\n    turn_min = True\n\n    while l <= r:\n        if turn_min:\n            result.append(s[l])\n            l += 1\n        else:\n            result.append(s[r])\n            r -= 1\n        turn_min = not turn_min\n\n    return result"}
{"task_id": "HumanEval/72", "solution": "def will_it_fly(q, w):\n    \"\"\"\n    Returns True if list q is balanced (palindromic) and the sum of its elements is <= w; otherwise returns False.\n    \"\"\"\n    # 1. Convert q to a list. This will raise TypeError for non-iterables.\n    try:\n        seq = list(q)\n    except TypeError:\n        raise TypeError(\"q must be an iterable.\")\n\n    # 2. Validate each element in seq is a real number (int/float).\n    for item in seq:\n        if not isinstance(item, (int, float)):\n            raise TypeError(\"All elements in q must be numeric (int or float).\")\n\n    # 3. Validate w is numeric.\n    if not isinstance(w, (int, float)):\n        raise TypeError(\"w must be a numeric value (int or float).\")\n\n    # 4. Check palindrome and sum constraint.\n    return seq == seq[::-1] and sum(seq) <= w"}
{"task_id": "HumanEval/70", "solution": "def strange_sort_list(lst):\n    '''\n    Sorts a list by alternating between the minimum and maximum remaining elements.\n    It returns a new list with the elements arranged in this \"strange\" order.\n    '''\n    sorted_lst = sorted(lst)\n    result = []\n    left, right = 0, len(sorted_lst) - 1\n    is_min_turn = True\n\n    while left <= right:\n        if is_min_turn:\n            result.append(sorted_lst[left])\n            left += 1\n        else:\n            result.append(sorted_lst[right])\n            right -= 1\n        is_min_turn = not is_min_turn\n    return result"}
{"task_id": "HumanEval/73", "solution": "def smallest_change(arr):\n    \"\"\"\n    Calculates the minimum changes to make an array palindromic.\n    It counts pairs of non-matching elements from array ends.\n    \"\"\"\n    n = len(arr)\n    changes = 0\n    for i in range(n // 2):\n        if arr[i] != arr[n - 1 - i]:\n            changes += 1\n    return changes"}
{"task_id": "HumanEval/71", "solution": "def triangle_area(a, b, c):\n    \"\"\"\n    Given three side lengths, return the triangle area rounded to 2 decimals if\n    they form a valid triangle. Otherwise return -1.\n    \"\"\"\n    import math\n\n    # Validate numeric types (reject bools)\n    for val in (a, b, c):\n        if isinstance(val, bool) or not isinstance(val, (int, float)):\n            return -1\n\n    a, b, c = float(a), float(b), float(c)\n\n    # Sides must be positive\n    if a <= 0 or b <= 0 or c <= 0:\n        return -1\n\n    # Numerical tolerance for floating-point comparisons\n    eps = 1e-12\n\n    # Strict triangle inequality with tolerance: sum of any two sides > third\n    if (a + b) - c <= eps or (a + c) - b <= eps or (b + c) - a <= eps:\n        return -1\n\n    # Heron's formula (numerically stable check)\n    s = (a + b + c) / 2.0\n    term = s * (s - a) * (s - b) * (s - c)\n\n    # If term is non-positive (or nearly so) treat as invalid/degenerate\n    if term <= eps:\n        return -1\n\n    area = math.sqrt(term)\n    return round(area, 2)"}
{"task_id": "HumanEval/71", "solution": "def triangle_area(a, b, c):\n    \"\"\"\n    Given the lengths of the three sides of a triangle. Return the area of\n    the triangle rounded to 2 decimal points if the three sides form a valid triangle.\n    Otherwise return -1\n    Three sides make a valid triangle when the sum of any two sides is greater\n    than the third side.\n    \"\"\"\n    import math\n\n    # Convert inputs to float and validate numeric types\n    try:\n        a = float(a)\n        b = float(b)\n        c = float(c)\n    except (TypeError, ValueError):\n        return -1\n\n    # Check for finiteness and positive lengths\n    if not (math.isfinite(a) and math.isfinite(b) and math.isfinite(c)):\n        return -1\n    if a <= 0 or b <= 0 or c <= 0:\n        return -1\n\n    # Triangle inequality (with a tiny epsilon to account for floating-point noise)\n    eps = 1e-12\n    if a + b <= c + eps or a + c <= b + eps or b + c <= a + eps:\n        return -1\n\n    # Heron's formula\n    s = (a + b + c) / 2.0\n    area_sq = s * (s - a) * (s - b) * (s - c)\n\n    # Guard against minor negative values due to floating-point errors\n    if area_sq < 0:\n        if area_sq > -1e-12:\n            area_sq = 0.0\n        else:\n            return -1\n\n    area = math.sqrt(area_sq)\n    return round(area, 2)"}
{"task_id": "HumanEval/72", "solution": "def will_it_fly(q,w):\n    '''\n    Checks if the object q will fly based on two conditions: balance and weight.\n    It flies if it is a palindromic list and its sum of elements is less than or equal to w.\n    '''\n    is_balanced = (q == q[::-1])\n    is_light_enough = (sum(q) <= w)\n\n    return is_balanced and is_light_enough"}
{"task_id": "HumanEval/74", "solution": "def total_match(lst1, lst2):\n    \"\"\"\n    Compares two lists of strings based on the total character count of their elements.\n    Returns the list with fewer total characters, or the first list if counts are equal.\n    \"\"\"\n    total_chars_lst1 = sum(len(s) for s in lst1)\n    total_chars_lst2 = sum(len(s) for s in lst2)\n\n    if total_chars_lst1 <= total_chars_lst2:\n        return lst1\n    return lst2"}
{"task_id": "HumanEval/73", "solution": "def smallest_change(arr):\n    \"\"\"\n    Calculates the minimum number of elements to change to make an array palindromic.\n    Compares elements from both ends and counts mismatches; each mismatch requires one change.\n    \"\"\"\n    changes = 0\n    left = 0\n    right = len(arr) - 1\n\n    while left < right:\n        if arr[left] != arr[right]:\n            changes += 1\n        left += 1\n        right -= 1\n    return changes"}
{"task_id": "HumanEval/74", "solution": "def total_match(lst1, lst2):\n    '''\n    Compares two lists of strings based on the total character count of their elements.\n    Returns the list with fewer total characters, or the first list if counts are equal.\n    '''\n    total_chars_lst1 = sum(len(s) for s in lst1)\n    total_chars_lst2 = sum(len(s) for s in lst2)\n\n    if total_chars_lst1 <= total_chars_lst2:\n        return lst1\n    else:\n        return lst2"}
{"task_id": "HumanEval/77", "solution": "def iscube(a):\n    \"\"\"\n    Write a function that takes an integer a and returns True\n    if this integer is a cube of some integer number.\n    \"\"\"\n    if a == 0:\n        return True\n\n    target = abs(a)\n    lo, hi = 0, target\n\n    while lo <= hi:\n        mid = (lo + hi) // 2\n        cube = mid * mid * mid\n        if cube == target:\n            return True\n        if cube < target:\n            lo = mid + 1\n        else:\n            hi = mid - 1\n\n    return False"}
{"task_id": "HumanEval/75", "solution": "def is_multiply_prime(a):\n    \"\"\"Write a function that returns true if the given number is the multiplication of 3 prime numbers\n    and false otherwise.\n    Knowing that (a) is less then 100.\n    Example:\n    is_multiply_prime(30) == True\n    30 = 2 * 3 * 5\n    \"\"\"\n    if a <= 1:\n        return False\n\n    factor_count = 0\n    num = a\n    i = 2\n    while i * i <= num:\n        while num % i == 0:\n            factor_count += 1\n            num //= i\n        i += 1\n\n    if num > 1:\n        factor_count += 1\n\n    return factor_count == 3"}
{"task_id": "HumanEval/77", "solution": "def iscube(a):\n    \"\"\"\n    Checks if an integer `a` is a perfect cube using exponential search followed by binary search.\n    This method uses only integer arithmetic to avoid floating-point inaccuracies.\n    \"\"\"\n    if a == 0:\n        return True\n\n    abs_a = abs(a)\n    low = 0\n    high = 1\n    # Exponential search to find an upper bound for the cube root.\n    while high * high * high < abs_a:\n        high *= 2\n\n    # Binary search between low and high (inclusive) to find the cube root.\n    while low <= high:\n        mid = (low + high) // 2\n        cube = mid * mid * mid\n        if cube == abs_a:\n            return True\n        if cube < abs_a:\n            low = mid + 1\n        else:\n            high = mid - 1\n    return False"}
