{"task_id": "HumanEval/96", "solution": "def count_up_to(n):\n    \"\"\"\n    Finds all prime numbers that are less than n.\n    Returns a list of these prime numbers in ascending order.\n    \"\"\"\n    primes = []\n    if n <= 2:\n        return primes\n\n    for num in range(2, n):\n        is_prime = True\n        if num == 2:\n            is_prime = True\n        elif num % 2 == 0:\n            is_prime = False\n        else:\n            i = 3\n            # Check for odd divisors up to the square root of num\n            limit = int(num**0.5) + 1\n            while i < limit:\n                if num % i == 0:\n                    is_prime = False\n                    break\n                i += 2\n\n        if is_prime:\n            primes.append(num)\n\n    return primes"}
{"task_id": "HumanEval/95", "solution": "def check_dict_case(dict):\n    \"\"\"\n    Checks if all dictionary keys are all lowercase strings or all uppercase strings.\n    Returns False if the dictionary is empty.\n    \"\"\"\n    if not dict:\n        return False\n\n    # Ensure all keys are strings first\n    keys = dict.keys()\n    if not all(isinstance(k, str) for k in keys):\n        return False\n\n    all_keys_are_lower = all(k.islower() for k in keys)\n    all_keys_are_upper = all(k.isupper() for k in keys)\n\n    return all_keys_are_lower or all_keys_are_upper"}
{"task_id": "HumanEval/96", "solution": "def count_up_to(n):\n    \"\"\"Returns a list of all prime numbers strictly less than n in ascending order.\n    Uses the Sieve of Eratosthenes algorithm.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n    if n < 0:\n        raise ValueError(\"n must be non-negative\")\n    if n <= 2:\n        return []\n\n    is_prime = [True] * n\n    is_prime[0] = False\n    is_prime[1] = False\n\n    limit = int(n**0.5) + 1\n    for i in range(2, limit):\n        if is_prime[i]:\n            start = i * i\n            for multiple in range(start, n, i):\n                is_prime[multiple] = False\n\n    return [i for i in range(2, n) if is_prime[i]]"}
