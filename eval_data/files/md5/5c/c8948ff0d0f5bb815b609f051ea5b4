      dp[i][j] = dp[i + 1][j - 1] + 2\n            else:\n                dp[i][j] = max(dp[i + 1][j], dp[i][j - 1])\n    \n    return dp[0][n - 1]", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/239": [{"task_id": "Mbpp/239", "solution": "def get_total_number_of_sequences(m, n):\n    \"\"\"Count sequences where each element >= 2*previous and <= m.\"\"\"\n    if n == 0:\n        return 1\n    if n == 1:\n        return m\n    \n    # dp[i][j] = number of sequences of length i ending with value j\n    dp = {}\n    \n    # Base case: sequences of length 1\n    for j in range(1, m + 1):\n        dp[(1, j)] = 1\n    \n    # Fill for lengths 2 to n\n    for i in range(2, n + 1):\n        for j in range(1, m + 1):\n            dp[(i, j)] = 0\n            # Previous element must be <= j//2 to satisfy j >= 2*prev\n            for prev in range(1, min(j // 2, m) + 1):\n                dp[(i, j)] += dp.get((i - 1, prev), 0)\n    \n    # Sum all sequences of length n\n    total = 0\n    for j in range(1, m + 1):\n        total += dp.get((n, j), 0)\n    \n    return total", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "Mbpp/239", "solution": "def get_total_number_of_sequences(m, n):\n    \"\"\"Returns the number of valid sequences of length n where each element is >= 2*previous and <= m.\"\"\"\n    if n == 0:\n        return 1\n    if n == 1:\n        return m\n    \n    # dp[i][j] = number of sequences of length i ending with value j\n    dp = [[0] * (m + 1) for _ in range(n + 1)]\n    \n    # Base case: sequences of length 1\n    for j in range(1, m + 1):\n        dp[1][j] = 1\n    \n    # Fill the dp table\n    for i in range(2, n + 1):\n        for j in range(1, m + 1):\n            # For ending with value j, previous value must be <= j//2\n            for prev in range(1, min(j // 2, m) + 1):\n                dp[i][j] += dp[i-1][prev]\n    \n    # Sum all seque