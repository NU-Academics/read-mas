= 2:\n            self.replacement = '__'\n        elif length >= 3:\n            self.replacement = '-'\n        else:\n            self.replacement = ''\nclass ResultString:\n    \"\"\"Data carrier for the transformed output and its length.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n        self.length = len(value)\nclass FixSpacesFunction:\n    \"\"\"Encapsulates the core logic for detecting space runs and applying replacement rules.\"\"\"\n    def fix_spaces(self, text: str) -> str:\n        # Public method for the class, delegates to the rule application logic.\n        return self.applyReplacementRules(text)\n\n    def applyReplacementRules(self, text: str) -> str:\n        \"\"\"Scans the text, detects space runs, and applies replacement rules.\"\"\"\n        input_text_obj = TextInput(text)\n\n        if not input_text_obj.value:\n            return \"\"\n\n        result_parts = []\n        i = 0\n        n = input_text_obj.length\n\n        while i < n:\n            current_char = input_text_obj.value[i]\n            if current_char != ' ':\n                # Found a non-space segment\n                j = i\n                while j < n and input_text_obj.value[j] != ' ':\n                    j += 1\n                result_parts.append(input_text_obj.value[i:j])\n                i = j\n            else:\n                # Found a space segment\n                j = i\n                while j < n and input_text_obj.value[j] == ' ':\n                    j += 1\n                \n                space_run_length = j - i\n                space_run = SpaceRun(i, space_run_length)\n                result_parts.append(space_run.replacement)\n                i = j\n        \n        final_str = \"\".join(result_parts)\n        result_str_obj = ResultString(final_str)\n        return result_str_obj.value\ndef fix_spaces(text):\n    \"\"\"\n    Given a string text, replace all spaces in it with underscores, \n    and if a string has more than 2 consecutive spaces, \n    then replace all consecutive spaces with - \n    \n    fix_spaces(\"Example\") == \"Example\"\n    fix_spaces(\"Example 1\") == \"Example_1\"\n    fix_spaces(\" Example 2\") == \"_Example_2\"\n    fix_spaces(\" Example   3\") == \"_Example-3\"\n    \"\"\"\n    # The module-level function acts as the public API entry point.\n    processor = FixSpacesFunction()\n    return processor.fix_spaces(text)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/141": [{"task_id": "HumanEval/141", "solution": "class FileName:\n    \"\"\"Represents parsed file name data and counts for validation.\"\"\"\n    def __init__(self, raw: str = \"\"):\n        self.raw = raw\n        self.namePart: str = \"\"\n        self.extension: str = \"\"\n        self.digitCount: int = 0\n        self.dotCount: int = 0\n        self.isValid: bool = False\nclass ValidationResult:\n    \"\"\"Represents the outcome of validation.\"\"\"\n    def __init__(self, result: str, failedChecks: list[str] = None):\n        self.result = result\n        self.failedChecks = failedChecks if failedChecks is not None else []\nclass FileNameValidator:\n    \"\"\"Performs atomic validation checks for a file name.\"\"\"\n    def countDigits(self, raw: str) -> int:\n        \"\"\"Counts digit characters '0'..'9' in the input string.\"\"\"\n        return sum(1 for char in raw if char.isdigit())\n\n    def countDots(self, raw: str) -> int:\n        \"\"\"Counts occurrences of '.' in the input string.\"\"\"\n        return raw.count('.')\n\n    def splitName(self, raw: str) -> tuple[str, str]:\n        \"\"\"Splits raw into (namePart, extension) assuming exactly one dot.\"\"\"\n        parts = raw.split('.', 1)\n        if len(parts) == 2:\n            return parts[0], parts[1]\n        return \"\", \"\"\n\n    def validate(self, file_data: FileName) -> ValidationResult:\n        \"\"\"Runs all validation checks on FileName data and returns a ValidationResult.\"\"\"\n        result = 'Yes'\n        failed_checks = []\n\n        # Condition 1: Not more than three digits in the file's name.\n        if file_data.digitCount > 3:\n            result = 'No'\n            failed_checks.append('DigitCountTooHigh')\n\n        # Condition 2: The file's name contains exactly one dot '.'\n        if file_data.dotCount != 1:\n            result = 'No'\n            failed_checks.append('InvalidDotCount')\n        else:\n            # These conditions depend on a valid split, which requires exactly one dot.\n            # Condition 3: Substring before the dot should not be empty, and it starts with a letter.\n            if not file_data.namePart or not file_data.namePart[0].isalpha():\n                result = 'No'\n                failed_checks.append('InvalidNamePart')\n\n            # Condition 4: Substring after the dot should be one of these: ['txt', 'exe', 'dll']\n            allowed_extensions = ['txt', 'exe', 'dll']\n            if file_data.extension not in allowed_extensions:\n                result = 'No'\n                failed_checks.append('InvalidExtension')\n\n        return ValidationResult(result, failed_checks)\ndef file_name_check(file_name):\n    \"\"\"Create a function which takes a string representing a file's name, and returns\n    'Yes' if the the file's name is valid, and returns 'No' otherwise.\n    \"\"\"\n    # Precondition: input must be a Python str.\n    if not isinstance(file_name, str):\n        return 'No'\n\n    file_data = FileName(raw=file_name)\n    validator = FileNameValidator()\n\n    file_data.dotCount = validator.countDots(file_data.raw)\n\n    if file_data.dotCount == 1:\n        file_data.namePart, file_data.extension = validator.splitName(file_data.raw)\n\n    file_data.digitCount = validator.countDigits(file_data.raw)\n\n    validation_outcome = validator.validate(file_data)\n\n    file_data.isValid = (validation_outcome.result == 'Yes')\n    return validation_outcome.result", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/144": [{"task_id": "HumanEval/144", "solution": "class Fraction:\n    \"\"\"Represents a fraction with a numerator and a denominator.\"\"\"\n    def __init__(self, numerator: int, denominator: int):\n        self.numerator = numerator\n        self.denominator = denominator\n\n    @staticmethod\n    def parse(s: str) -> 'Fraction':\n        \"\"\"Parses a string of format \"numerator/denominator\" into a Fraction object.\"\"\"\n        parts = s.split('/')\n        return Fraction(int(parts[0]), int(parts[1]))\nclass Product:\n    \"\"\"Represents the product of two fractions.\"\"\"\n    def __init__(self, numerator: int, denominator: int):\n        self.numerator = numerator\n        self.denominator = denominator\n\n    def isWhole(self) -> bool:\n        \"\"\"Checks if the product is a whole number.\"\"\"\n        return self.numerator % self.denominator == 0\nclass Simplifier:\n    \"\"\"Provides arithmetic operations for fractions.\"\"\"\n    def multiply(self, a: Fraction, b: Fraction) -> Product:\n        \"\"\"Multiplies two fractions and returns their product.\"\"\"\n        product_numerator = a.numerator * b.numerator\n        product_denominator = a.denominator * b.denominator\n        return Product(product_numerator, product_denominator)\n\n    def isWhole(self, p: Product) -> bool:\n        \"\"\"Delegates the wholeness check to the Product object.\"\"\"\n        return p.isWhole()\ndef simplify(x, n):\n    \"\"\"Your task is to implement a function that will simplify the expression\n    x * n. The function returns True if x * n evaluates to a whole number and False\n    otherwise. Both x and n, are string representation of a fraction, and have the following format,\n    <numerator>/<denominator> where both numerator and denominator are positive whole numbers.\n\n    You can assume that x, and n are valid fractions, and do not have zero as denominator.\n    \"\"\"\n    fx = Fraction.parse(x)\n    fn = Fraction.parse(n)\n    svc = Simplifier()\n    product = svc.multiply(fx, fn)\n    return svc.isWhole(product)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/142": [{"task_id": "HumanEval/142", "solution": "from typing import List, Callable\nclass TransformationRule:\n    \"\"\"Encapsulates a named rule with a condition and operation; evaluates applicability and applies the operation.\"\"\"\n    def __init__(self, name: str, condition: str, operation: str, applies_fn: Callable[[int], bool], apply_fn: Callable[[int], int]):\n        self.name = name\n        self.condition = condition\n        self.operation = operation\n        self._applies_fn = applies_fn\n        self._apply_fn = apply_fn\n\n    def applies(self, index: int) -> bool:\n        \"\"\"Checks if this rule applies to the given index.\"\"\"\n        return self._applies_fn(index)\n\n    def apply(self, value: int) -> int:\n        \"\"\"Applies the transformation to the given value.\"\"\"\n        return self._apply_fn(value)\nclass RuleSet:\n    \"\"\"Manages a collection of TransformationRule objects and resolves which rule applies to an index, enforcing precedence.\"\"\"\n    def __init__(self, rules: List[TransformationRule]):\n        self.rules = rules\n\n    def resolve(self, index: int) -> TransformationRule | None:\n        \"\"\"Returns the first applicable rule according to precedence, otherwise None.\"\"\"\n        for rule in self.rules:\n            if rule.applies(index):\n                return rule\n        return None\nclass ListElement:\n    \"\"\"Represents an element with its index, original value, and its transformed value.\"\"\"\n    def __init__(self, index: int, value: int):\n        self.index = index\n        self.value = value\n        self.transformedValue: int | None = None\n\n    def applyTransformation(self, ruleSet: RuleSet) -> int:\n        \"\"\"Resolves an applicable rule via ruleSet, computes and sets transformedValue, then returns it.\"\"\"\n        if self.transformedValue is not None:\n            return self.transformedValue\n\n        applicable_rule = ruleSet.resolve(self.index)\n        if applicable_rule:\n            self.transformedValue = applicable_rule.apply(self.value)\n        else:\n            self.transformedValue = self.value # Leave unchanged\n\n        return self.transformedValue\nclass InputList:\n    \"\"\"Represents the input sequence as a collection of ListElement objects.\"\"\"\n    def __init__(self, elements: List[ListElement]):\n        self.elements = elements\n        self.length = len(elements)\n\n    def getElement(self, index: int) -> ListElement:\n        \"\"\"Returns the element at the given zero-based index.\"\"\"\n        if 0 <= index < self.length:\n            return self.elements[index]\n        raise IndexError(\"Index out of range\")\nclass Result:\n    \"\"\"Accumulates and holds the computed sum from an InputList's transformed values.\"\"\"\n    def __init__(self):\n        self.sum = 0\n\n    def computeFrom(self, inputList: InputList) -> int:\n        \"\"\"Accumulates the sum of all transformed values from the InputList.\"\"\"\n        total_sum = 0\n        for element in inputList.elements:\n            # The transformedValue is expected to be set by the orchestration before this call.\n            total_sum += element.transformedValue\n        self.sum = total_sum\n        return self.sum\ndef _default_ruleset() -> RuleSet:\n    \"\"\"Constructs and returns a RuleSet containing the default squaring and cubing rules with precedence.\"\"\"\n    square_rule = TransformationRule(\n        name='square-rule',\n        condition='index % 3 == 0',\n        operation='square',\n        applies_fn=lambda index: index % 3 == 0,\n        apply_fn=lambda value: value ** 2\n    )\n    cube_rule = TransformationRule(\n        name='cube-rule',\n        condition='index % 4 == 0 and index % 3 != 0',\n        operation='cube',\n        applies_fn=lambda index: index % 4 == 0 and index % 3 != 0,\n        apply_fn=lambda value: value ** 3\n    )\n    # Rules are ordered to enforce precedence: square rule is resolved before cube rule.\n    return RuleSet([square_rule, cube_rule])\ndef sum_squares(lst):\n    \"\"\"\"\n    This function will take a list of integers. For all entries in the list, the function shall square the integer entry if its index is a \n    multiple of 3 and will cube the integer entry if its index is a multiple of 4 and not a multiple of 3. The function will not \n    change the entries in the list whose indexes are not a multiple of 3 or 4. The function shall then return the sum of all entries. \n    \n    Examples:\n    For lst = [1,2,3] the output should be 6\n    For lst = []  the output should be 0\n    For lst = [-1,-5,2,-1,-5]  the output should be -126\n    \"\"\"\n    if not lst:\n        return 0\n\n    input_elements = [ListElement(i, val) for i, val in enumerate(lst)]\n    input_list = InputList(input_elements)\n\n    ruleset = _default_ruleset()\n\n    for element in input_list.elements:\n        element.applyTransformation(ruleset)\n\n    result_calculator = Result()\n    return result_calculator.computeFrom(input_list)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/143": [{"task_id": "HumanEval/143", "solution": "import math\nclass PrimeChecker:\n    \"\"\"Encapsulates primality test.\"\"\"\n    def isPrime(self, n: int) -> bool:\n        \"\"\"Returns True if n is prime, False otherwise.\"\"\"\n        if n < 2:\n            return False\n        for i in range(2, int(math.sqrt(n)) + 1):\n            if n % i == 0:\n                return False\n        return True\nclass Word:\n    \"\"\"Domain model for a word.\"\"\"\n    def __init__(self, text: str):\n        self.text: str = text\n        self.isPrimeLength: bool = False\n\n    def length(self) -> int:\n        \"\"\"Returns count of alphabetic characters in text.\"\"\"\n        return len(self.text)\nclass Result:\n    \"\"\"Domain model for the final output result.\"\"\"\n    def __init__(self, text: str):\n        self.text: str = text\n\n    def wordCount(self) -> int:\n        \"\"\"Returns number of words included in Result.\"\"\"\n        return 0 if self.text == \"\" else len(self.text.split(' '))\nclass SentenceProcessor:\n    \"\"\"Orchestrates split, prime-filter, join logic.\"\"\"\n    def __init__(self, prime_checker: PrimeChecker = None):\n        self.prime_checker = prime_checker if prime_checker is not None else PrimeChecker()\n\n    def process(self, sentence: str) -> str:\n        \"\"\"Orchestrates split -> filterPrimeWords -> join -> returns Result.text.\"\"\"\n        words = self.split(sentence)\n        prime_words = self.filterPrimeWords(words)\n        result_text = self.join(prime_words)\n        return Result(result_text).text\n\n    def split(self, sentence: str) -> list[Word]:\n        \"\"\"Split by single space and construct Word instances.\"\"\"\n        if not sentence:\n            return []\n        return [Word(token) for token in sentence.split(' ')]\n\n    def filterPrimeWords(self, words: list[Word]) -> list[Word]:\n        \"\"\"Use PrimeChecker.isPrime(word.length()) to select words.\"\"\"\n        selected_words = []\n        for word in words:\n            if self.prime_checker.isPrime(word.length()):\n                word.isPrimeLength = True\n                selected_words.append(word)\n        return selected_words\n\n    def join(self, words: list[Word]) -> str:\n        \"\"\"Join selected Word.text values with single spaces; return \"\" if empty.\"\"\"\n        return \" \".join([word.text for word in words])\ndef words_in_sentence(sentence):\n    \"\"\"\n    You are given a string representing a sentence,\n    the sentence contains some words separated by a space,\n    and you have to return a string that contains the words from the original sentence,\n    whose lengths are prime numbers,\n    the order of the words in the new string should be the same as the original one.\n    \"\"\"\n    return SentenceProcessor().process(sentence)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/146": [{"task_id": "HumanEval/146", "solution": "import collections\nfrom typing import Iterable, Set\nclass NumberElement:\n    \"\"\"Encapsulates number data and methods for digit extraction.\"\"\"\n    def __init__(self, original_value):\n        self.original_value = original_value\n        self.int_value = None\n        self.abs_int_value = None\n        self.first_digit = None\n        self.last_digit = None\n\n    def compute_derived(self):\n        \"\"\"Computes integer, absolute integer, first, and last digits.\"\"\"\n        self.int_value = int(self.original_value)\n        self.abs_int_value = abs(self.int_value)\n\n        if self.abs_int_value == 0:\n            self.first_digit = 0\n            self.last_digit = 0\n        else:\n            self.last_digit = self.abs_int_value % 10\n            temp = self.abs_int_value\n            while temp >= 10:\n                temp //= 10\n            self.first_digit = temp\nclass DigitRules:\n    \"\"\"Encapsulates rules for digit membership.\"\"\"\n    def __init__(self):\n        self.odd_digits: Set[int] = {1, 3, 5, 7, 9}\n\n    def is_odd(self, d: int) -> bool:\n        \"\"\"Checks if a digit is odd.\"\"\"\n        return d in self.odd_digits\nclass Result:\n    \"\"\"Simple container for the final count.\"\"\"\n    def __init__(self, count: int = 0):\n        self.count: int = count\ndef specialFilter(nums):\n    \"\"\"\n    Filters numbers based on being greater than 10 and having odd first/last digits.\n    Returns the count of numbers satisfying these criteria.\n    \"\"\"\n    if not isinstance(nums, collections.Iterable):\n        raise TypeError(\"Input 'nums' must be an iterable.\")\n\n    result = Result()\n    digit_rules = DigitRules()\n\n    for num in nums:\n        if not isinstance(num, (int, float)):\n            raise TypeError(\"Elements in 'nums' must be numeric (int or float).\")\n\n        if num <= 10:\n            continue\n\n        element = NumberElement(num)\n        element.compute_derived()\n\n        if (element.first_digit is not None and digit_rules.is_odd(element.first_digit) and\n                element.last_digit is not None and digit_rules.is_odd(element.last_digit)):\n            result.count += 1\n\n    return result.count", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[[5, -2, 1, -5]]], "plus_fail_tests": [[[24, -25, 9, 37, -71, -18]]]}], "HumanEval/147": [{"task_id": "HumanEval/147", "solution": "def get_max_triples(n):\n    \"\"\"\n    You are given a positive integer n. You have to create an integer array a of length n.\n        For each i (1 \u2264 i \u2264 n), the value of a[i] = i * i - i + 1.\n        Return the number of triples (a[i], a[j], a[k]) of a where i < j < k, \n    and a[i] + a[j] + a[k] is a multiple of 3.\n    \"\"\"\n    if n < 3:\n        return 0\n\n    # Helper function to calculate combinations C(n_val, 3)\n    # Returns 0 if n_val is less than 3, as it's impossible to choose 3 items.\n    def combinations_3(n_val):\n        if n_val < 3:\n            return 0\n        return n_val * (n_val - 1) * (n_val - 2) // 6\n\n    count0 = 0  # Count of numbers a[i] such that a[i] % 3 == 0\n    count1 = 0  # Count of numbers a[i] such that a[i] % 3 == 1\n    count2 = 0  # Count of numbers a[i] such that a[i] % 3 == 2\n\n    # Calculate a[i] values and categorize them by their remainder modulo 3.\n    for i in range(1, n + 1):\n        val = i * i - i + 1\n        remainder = val % 3\n        if remainder == 0:\n            count0 += 1\n        elif remainder == 1:\n            count1 += 1\n        else:  # remainder == 2\n            count2 += 1\n\n    total_triples = 0\n\n    # A sum of three numbers (a[i] + a[j] + a[k]) is a multiple of 3 if their remainders modulo 3 sum to a multiple of 3.\n    # The possible combinations of remainders (r1, r2, r3) that satisfy this condition are:\n    # 1. All three remainders are 0: (0, 0, 0)\n    # 2. All three remainders are 1: (1, 1, 1)\n    # 3. All three remainders are 2: (2, 2, 2)\n    # 4. One of each remainder: (0, 1, 2)\n\n    # Number of triples where all three elements have remainder 0\n    total_triples += combinations_3(count0)\n\n    # Number of triples where all three elements have remainder 1\n    total_triples += combinations_3(count1)\n\n    # Number of triples where all three elements have remainder 2\n    total_triples += combinations_3(count2)\n\n    # Number of triples where one element has remainder 0, one has 1, and one has 2\n    total_triples += count0 * count1 * count2\n\n    return total_triples", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/145": [{"task_id": "HumanEval/145", "solution": "from dataclasses import dataclass\nfrom typing import List\nclass OrderByPointsService:\n    \"\"\"Service for sorting numbers by their digit sum.\"\"\"\n\n    @staticmethod\n    def _digit_sum(value: int) -> int:\n        \"\"\"Computes the sum of decimal digits of the absolute value.\"\"\"\n        abs_value = abs(value)\n        s = 0\n        if abs_value == 0:\n            return 0\n        while abs_value > 0:\n            s += abs_value % 10\n            abs_value //= 10\n        return s\n\n    @staticmethod\n    def order_by_points(nums: List[int]) -> List[int]:\n        \"\"\"Sorts a list of integers by their digit sum, stably.\"\"\"\n        if not nums:\n            return []\n\n        items: List[IntegerItem] = []\n        for i, num in enumerate(nums):\n            digit_sum = OrderByPointsService._digit_sum(num)\n            items.append(IntegerItem(value=num, digitSum=digit_sum, originalIndex=i))\n\n        # Python's sorted() is stable, preserving original relative order for ties.\n        sorted_items = sorted(items, key=lambda item: item.digitSum)\n\n        return [item.as_value() for item in sorted_items]\ndef order_by_points(nums: List[int]) -> List[int]:\n    \"\"\"\n    Sorts the given list of integers in ascending order according to the sum of their digits.\n    Note: if there are several items with similar sum of their digits,\n    order them based on their index in original list.\n    \"\"\"\n    return OrderByPointsService.order_by_points(nums)", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[[1, 11, -1, -11, -12]]], "plus_fail_tests": [[[1, 2, 3]]]}], "HumanEval/149": [{"task_id": "HumanEval/149", "solution": "from typing import List\nclass InputList:\n    \"\"\"Encapsulates the incoming list of strings.\"\"\"\n    def __init__(self, items: List[str]):\n        self.items = items\n\n    def isEmpty(self) -> bool:\n        return not self.items\n\n    def length(self) -> int:\n        return len(self.items)\nclass StringItem:\n    \"\"\"Value object wrapping a string with cached length and parity helper.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n        self.length = len(value)\n\n    def isEvenLength(self) -> bool:\n        return self.length % 2 == 0\nclass ResultList:\n    \"\"\"Collects StringItem instances and exposes asList() to return ordered List[str].\"\"\"\n    def __init__(self):\n        self.items: List[StringItem] = []\n\n    def add(self, item: StringItem) -> None:\n        self.items.append(item)\n\n    def asList(self) -> List[str]:\n        return [item.value for item in self.items]\nclass FilterProcess:\n    \"\"\"Stateless process that filters even-length strings.\"\"\"\n    def filterEvenLengths(self, input_list: InputList) -> ResultList:\n        filtered_result = ResultList()\n        for value in input_list.items:\n            item = StringItem(value)\n            if item.isEvenLength():\n                filtered_result.add(item)\n        return filtered_result\nclass SortProcess:\n    \"\"\"Stateless process that sorts a ResultList by length then alphabetically.\"\"\"\n    def sortByLengthThenAlpha(self, result: ResultList) -> ResultList:\n        result.items.sort(key=lambda item: (item.length, item.value))\n        return result\ndef sorted_list_sum(lst):\n    \"\"\"Removes odd-length strings from the list, then sorts the remaining strings\n    by length ascending, then alphabetically, preserving duplicates.\"\"\"\n    input_obj = InputList(lst)\n    \n    filterer = FilterProcess()\n    filtered = filterer.filterEvenLengths(input_obj)\n    \n    sorter = SortProcess()\n    sorted_result = sorter.sortByLengthThenAlpha(filtered)\n    \n    return sorted_result.asList()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/148": [{"task_id": "HumanEval/148", "solution": "from typing import List, Dict, Optional, Tuple\nclass Planet:\n    \"\"\"Represents a planet with its name and order from the Sun.\"\"\"\n    def __init__(self, name: str, orderFromSun: int):\n        self.name = name\n        self.orderFromSun = orderFromSun\n\n    def __repr__(self):\n        return f\"Planet('{self.name}', {self.orderFromSun})\"\nclass PlanetRepository:\n    \"\"\"Manages the canonical dataset of planets and provides accessors.\"\"\"\n    CANONICAL_PLANETS_DATA = [\n        (\"Mercury\", 1), (\"Venus\", 2), (\"Earth\", 3), (\"Mars\", 4),\n        (\"Jupiter\", 5), (\"Saturn\", 6), (\"Uranus\", 7), (\"Neptune\", 8)\n    ]\n\n    def __init__(self):\n        self._planets_by_name: Dict[str, Planet] = {}\n        self._planets_ordered: List[Planet] = []\n        for name, order in self.CANONICAL_PLANETS_DATA:\n            planet = Planet(name, order)\n            self._planets_by_name[name] = planet\n            self._planets_ordered.append(planet)\n\n    def getPlanetByName(self, name: str) -> Optional[Planet]:\n        \"\"\"Returns a Planet object by its name, or None if not found.\"\"\"\n        return self._planets_by_name.get(name)\n\n    def getAllPlanets(self) -> List[Planet]:\n        \"\"\"Returns a list of all canonical planets, sorted by proximity to the Sun.\"\"\"\n        return list(self._planets_ordered)\nclass Validator:\n    \"\"\"Validates planet names against the canonical set.\"\"\"\n    def __init__(self, repository: PlanetRepository):\n        self._repository = repository\n\n    def isValidPlanetName(self, name: str) -> bool:\n        \"\"\"Checks if a given name is a valid canonical planet name.\"\"\"\n        return self._repository.getPlanetByName(name) is not None\nclass BFService:\n    \"\"\"Provides the core business logic for finding planets between two orbits.\"\"\"\n    def __init__(self, repository: PlanetRepository, validator: Validator):\n        self._repository = repository\n        self._validator = validator\n\n    def computeBetween(self, p1: Planet, p2: Planet) -> List[Planet]:\n        \"\"\"Returns a list of planets strictly between two given planet objects, sorted by proximity to the Sun.\"\"\"\n        min_order = min(p1.orderFromSun, p2.orderFromSun)\n        max_order = max(p1.orderFromSun, p2.orderFromSun)\n\n        between_planets = []\n        for planet in self._repository.getAllPlanets():\n            if min_order < planet.orderFromSun < max_order:\n                between_planets.append(planet)\n        return between_planets\n\n    def bf(self, planet1_name: str, planet2_name: str) -> Tuple[str, ...]:\n        \"\"\"Main entry point for finding planets between two orbits.\"\"\"\n        if not self._validator.isValidPlanetName(planet1_name) or \\\n           not self._validator.isValidPlanetName(planet2_name):\n            return ()\n\n        if planet1_name == planet2_name:\n            return ()\n\n        p1 = self._repository.getPlanetByName(planet1_name)\n        p2 = self._repository.getPlanetByName(planet2_name)\n\n        # p1 and p2 are guaranteed to be Planet objects here due to isValidPlanetName checks.\n        between_planets = self.computeBetween(p1, p2)\n\n        if not between_planets:\n            return ()\n\n        return tuple(planet.name for planet in between_planets)\ndef bf(planet1, planet2):\n    '''\n    There are eight planets in our solar system: the closerst to the Sun \n    is Mercury, the next one is Venus, then Earth, Mars, Jupiter, Saturn, \n    Uranus, Neptune.\n    Write a function that takes two planet names as strings planet1 and planet2. \n    The function should return a tuple containing all planets whose orbits are \n    located between the orbit of planet1 and the orbit of planet2, sorted by \n    the proximity to the sun. \n    The function should return an empty tuple if planet1 or planet2\n    are not correct planet names. \n    Examples\n    bf(\"Jupiter\", \"Neptune\") ==> (\"Saturn\", \"Uranus\")\n    bf(\"Earth\", \"Mercury\") ==> (\"Venus\")\n    bf(\"Mercury\", \"Uranus\") ==> (\"Venus\", \"Earth\", \"Mars\", \"Jupiter\", \"Saturn\")\n    '''\n    _planet_repository_instance = PlanetRepository()\n    _validator_instance = Validator(_planet_repository_instance)\n    _bf_service_instance = BFService(_planet_repository_instance, _validator_instance)\n\n    return _bf_service_instance.bf(planet1, planet2)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/151": [{"task_id": "HumanEval/151", "solution": "from typing import List, Any, Union\nclass InputList:\n    \"\"\"Domain wrapper for input collection.\"\"\"\n    def __init__(self, numbers: list):\n        self.numbers: list = numbers\nclass NumberElement:\n    \"\"\"Encapsulates a numeric value and derived predicates and square computation.\"\"\"\n    def __init__(self, value: Any):\n        self.value: Any = value\n\n    def is_integer(self) -> bool:\n        \"\"\"True if integer type or float with no fractional part (float.is_integer()).\"\"\"\n        return isinstance(self.value, int) or (isinstance(self.value, float) and self.value.is_integer())\n\n    def is_non_negative(self) -> bool:\n        \"\"\"True if value >= 0.\"\"\"\n        return self.value >= 0\n\n    def is_odd(self) -> bool:\n        \"\"\"True if integer and value % 2 != 0.\"\"\"\n        if not self.is_integer():\n            return False\n        return int(self.value) % 2 != 0\n\n    def square(self) -> int:\n        \"\"\"Returns the square of the value as an integer.\"\"\"\n        return int(self.value * self.value)\nclass Processor:\n    \"\"\"Stateless use-case/service implementing filtering, squaring, and summing logic.\"\"\"\n    def filter(self, elements: List[NumberElement]) -> List[NumberElement]:\n        \"\"\"Returns elements satisfying is_integer(), is_non_negative(), is_odd(), ignoring non-numeric.\"\"\"\n        filtered_elements = []\n        for element in elements:\n            try:\n                if element.is_integer() and element.is_non_negative() and element.is_odd():\n                    filtered_elements.append(element)\n            except (TypeError, AttributeError):\n                pass\n        return filtered_elements\n\n    def square_elements(self, elements: List[NumberElement]) -> List[int]:\n        \"\"\"Returns a list of integer squares for the given elements.\"\"\"\n        return [element.square() for element in elements]\n\n    def sum_squares(self, squares: List[int]) -> int:\n        \"\"\"Returns the sum of squares, or 0 if the list is empty.\"\"\"\n        return sum(squares)\nclass Result:\n    \"\"\"Simple container for the integer result.\"\"\"\n    def __init__(self, value: int):\n        self.value: int = value\ndef double_the_difference(lst):\n    '''\n    Given a list of numbers, return the sum of squares of the numbers\n    in the list that are odd. Ignore numbers that are negative or not integers.\n    '''\n    input_list = InputList(lst)\n    \n    elements = [NumberElement(v) for v in input_list.numbers]\n\n    processor = Processor()\n    filtered = processor.filter(elements)\n    squares = processor.square_elements(filtered)\n    total = processor.sum_squares(squares)\n    result = Result(total)\n    \n    return result.value", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[[1.0, 3.5, -4.6]]]}], "HumanEval/152": [{"task_id": "HumanEval/152", "solution": "def compare(game,guess):\n    \"\"\"Return an array of the same length denoting how far off each guess was.\n    If they have guessed correctly, the value is 0, and if not, the value is the absolute difference between the guess and the score.\"\"\"\n    \n    results = []\n    for i in range(len(game)):\n        score = game[i]\n        user_guess = guess[i]\n        if score == user_guess:\n            results.append(0)\n        else:\n            results.append(abs(score - user_guess))\n            \n    return results", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/153": [{"task_id": "HumanEval/153", "solution": "class Extension:\n    \"\"\"Data holder for a single extension name and its computed values.\"\"\"\n    def __init__(self, name: str):\n        self.name = name\n        self.CAP = 0\n        self.SM = 0\n        self.strength = 0\nclass ExtensionList:\n    \"\"\"Container for Extension instances.\"\"\"\n    def __init__(self, items: list['Extension']):\n        self.items = items\n    def size(self) -> int:\n        return len(self.items)\nclass Result:\n    \"\"\"Data holder for the formatted output string.\"\"\"\n    def __init__(self, formatted: str):\n        self.formatted = formatted\nclass StrengthCalculator:\n    \"\"\"Encapsulates counting logic and strength computation for extensions.\"\"\"\n    def count_uppercase(self, name: str) -> int:\n        \"\"\"Counts uppercase letters in a string using Unicode rules.\"\"\"\n        return sum(1 for char in name if char.isupper())\n\n    def count_lowercase(self, name: str) -> int:\n        \"\"\"Counts lowercase letters in a string using Unicode rules.\"\"\"\n        return sum(1 for char in name if char.islower())\n\n    def compute_strength(self, extension: 'Extension') -> int:\n        \"\"\"Computes and sets CAP, SM, and strength for an Extension object.\"\"\"\n        extension.CAP = self.count_uppercase(extension.name)\n        extension.SM = self.count_lowercase(extension.name)\n        extension.strength = extension.CAP - extension.SM\n        return extension.strength\ndef Strongest_Extension(class_name, extensions):\n    \"\"\"\n    Finds the strongest extension based on CAP (uppercase) - SM (lowercase) count\n    and returns a formatted string: ClassName.StrongestExtensionName.\n    \"\"\"\n    extension_objects = []\n    strength_calculator = StrengthCalculator()\n\n    for ext_name in extensions:\n        current_extension = Extension(ext_name)\n        strength_calculator.compute_strength(current_extension)\n        extension_objects.append(current_extension)\n\n    # Creating an ExtensionList instance to fulfill the design relationship.\n    # The problem context implies 'extensions' will always contain at least one element.\n    extension_list_container = ExtensionList(extension_objects)\n\n    strongest_extension_obj = extension_objects[0]\n    max_strength = strongest_extension_obj.strength\n\n    for i in range(1, len(extension_objects)):\n        current_extension = extension_objects[i]\n        if current_extension.strength > max_strength:\n            strongest_extension_obj = current_extension\n            max_strength = current_extension.strength\n    \n    # Creating a Result object to fulfill the design relationship.\n    result_obj = Result(f\"{class_name}.{strongest_extension_obj.name}\")\n    return result_obj.formatted", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/155": [{"task_id": "HumanEval/155", "solution": "class IntegerInput:\n    \"\"\"Represents an integer input and provides its absolute value.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def getAbsoluteValue(self) -> int:\n        \"\"\"Returns the absolute value of the input.\"\"\"\n        return abs(self.value)\nclass Digit:\n    \"\"\"Represents a single decimal digit and determines its parity.\"\"\"\n    def __init__(self, value: int, position: int):\n        self.value = value\n        self.position = position\n\n    def isEven(self) -> bool:\n        \"\"\"Returns True if the digit is even (0 is treated as even).\"\"\"\n        return self.value % 2 == 0\nclass EvenOddCountResult:\n    \"\"\"Accumulates even and odd digit counts and provides them as a tuple.\"\"\"\n    def __init__(self, evenCount: int = 0, oddCount: int = 0):\n        self.evenCount = evenCount\n        self.oddCount = oddCount\n\n    def toTuple(self) -> tuple[int, int]:\n        \"\"\"Returns the accumulated counts as an (evenCount, oddCount) tuple.\"\"\"\n        return (self.evenCount, self.oddCount)\ndef even_odd_count(num):\n    \"\"\"Given an integer. return a tuple that has the number of even and odd digits respectively.\n\n     Example:\n        even_odd_count(-12) ==> (1, 1)\n        even_odd_count(123) ==> (1, 2)\n    \"\"\"\n    integer_input = IntegerInput(num)\n    abs_value = integer_input.getAbsoluteValue()\n\n    result_counter = EvenOddCountResult()\n    pos = 0\n\n    if abs_value == 0:\n        # Special handling for 0, which has one digit '0'\n        digit_instance = Digit(value=0, position=0)\n        if digit_instance.isEven():\n            result_counter.evenCount += 1\n        else:\n            result_counter.oddCount += 1 # This branch won't be taken for 0\n    else:\n        current_abs_value = abs_value\n        while current_abs_value > 0:\n            digit_val = current_abs_value % 10\n            digit_instance = Digit(value=digit_val, position=pos)\n            if digit_instance.isEven():\n                result_counter.evenCount += 1\n            else:\n                result_counter.oddCount += 1\n            current_abs_value //= 10\n            pos += 1\n\n    return result_counter.toTuple()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/154": [{"task_id": "HumanEval/154", "solution": "from typing import List, Optional\nclass InputString:\n    \"\"\"Represents the haystack string and its length.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n        self.length = len(value)\nclass PatternString:\n    \"\"\"Represents the pattern string and its length.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n        self.length = len(value)\nclass Rotation:\n    \"\"\"Represents a single rotation candidate of b with its shift index.\"\"\"\n    def __init__(self, value: str, shiftIndex: int):\n        self.value = value\n        self.shiftIndex = shiftIndex\nclass MatchResult:\n    \"\"\"Represents the outcome of checking rotations against the haystack.\"\"\"\n    def __init__(self, matched: bool, matchedRotation: Optional[str]):\n        self.matched = matched\n        self.matchedRotation = matchedRotation\nclass RotationGenerator:\n    \"\"\"Generates all cyclic rotations of PatternString b.\"\"\"\n    def generateRotations(self, b_str: str) -> List[Rotation]:\n        rotations = []\n        n = len(b_str)\n        if n == 0:\n            return rotations\n        for s in range(n):\n            rotated_value = b_str[s:] + b_str[:s]\n            rotations.append(Rotation(rotated_value, s))\n        return rotations\nclass SubstringChecker:\n    \"\"\"Provides substring membership checks and aggregates checks over rotation candidates.\"\"\"\n    def isSubstring(self, haystack: str, needle: str) -> bool:\n        return needle in haystack\n\n    def checkAny(self, haystack: str, needles: List[Rotation]) -> MatchResult:\n        for rotation in needles:\n            if self.isSubstring(haystack, rotation.value):\n                return MatchResult(True, rotation.value)\n        return MatchResult(False, None)\ndef cycpattern_check(a , b):\n    \"\"\"You are given 2 words. You need to return True if the second word or any of its rotations is a substring in the first word\n    cycpattern_check(\"abcd\",\"abd\") => False\n    cycpattern_check(\"hello\",\"ell\") => True\n    cycpattern_check(\"whassup\",\"psus\") => False\n    cycpattern_check(\"abab\",\"baa\") => True\n    cycpattern_check(\"efef\",\"eeff\") => False\n    cycpattern_check(\"himenss\",\"simen\") => True\n\n    \"\"\"\n    a_model = InputString(a)\n    b_model = PatternString(b)\n    \n    rotations = RotationGenerator().generateRotations(b_model.value)\n    result = SubstringChecker().checkAny(a_model.value, rotations)\n    \n    return result.matched", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [["", ""]]}], "HumanEval/156": [{"task_id": "HumanEval/156", "solution": "CONVERSION_RULES = [\n    (1000, 'M'), (900, 'CM'), (500, 'D'), (400, 'CD'), (100, 'C'),\n    (90, 'XC'), (50, 'L'), (40, 'XL'), (10, 'X'), (9, 'IX'),\n    (5, 'V'), (4, 'IV'), (1, 'I')\n]\nclass IntegerInput:\n    \"\"\"Represents an integer input for Roman numeral conversion.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def is_valid(self) -> bool:\n        \"\"\"Checks if the integer is within the valid range [1, 1000].\"\"\"\n        return 1 <= self.value <= 1000\nclass RomanNumeral:\n    \"\"\"Represents a Roman numeral string.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\nclass ValidationService:\n    \"\"\"Provides validation services for IntegerInput objects.\"\"\"\n    def validate(self, integer_input: IntegerInput) -> bool:\n        \"\"\"Validates if the IntegerInput is valid for conversion.\"\"\"\n        return integer_input.is_valid()\nclass RomanConverter:\n    \"\"\"Converts an IntegerInput to a RomanNumeral string.\"\"\"\n    def __init__(self, mapping: list = None):\n        # Uses the default CONVERSION_RULES if no specific mapping is provided.\n        self._mapping = mapping if mapping is not None else CONVERSION_RULES\n\n    def convert(self, integer_input: IntegerInput) -> RomanNumeral:\n        \"\"\"Converts an integer to its Roman numeral equivalent using a greedy algorithm.\"\"\"\n        num = integer_input.value\n        roman_numeral_parts = []\n        for value, symbol in self._mapping:\n            while num >= value:\n                roman_numeral_parts.append(symbol)\n                num -= value\n        return RomanNumeral(\"\".join(roman_numeral_parts))\ndef int_to_mini_roman(number) -> str:\n    \"\"\"\n    Given a positive integer, obtain its roman numeral equivalent as a string,\n    and return it in lowercase.\n    \"\"\"\n    integer_input = IntegerInput(number)\n    validator = ValidationService()\n    \n    if validator.validate(integer_input):\n        converter = RomanConverter()\n        roman_numeral = converter.convert(integer_input)\n        return roman_numeral.value.lower()\n    else:\n        # Behavior for invalid inputs is unspecified; returning an empty string.\n        return \"\"", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/157": [{"task_id": "HumanEval/157", "solution": "import math\nclass TriangleSides:\n    \"\"\"Holds the three side lengths a, b, c.\"\"\"\n    def __init__(self, a: float, b: float, c: float) -> None:\n        self.a = float(a)\n        self.b = float(b)\n        self.c = float(c)\n\n    def as_tuple(self) -> tuple[float, float, float]:\n        \"\"\"Returns the sides as a tuple.\"\"\"\n        return (self.a, self.b, self.c)\nclass InputValidator:\n    \"\"\"Validates numeric/positive inputs and strict triangle inequality.\"\"\"\n    def validateNumericPositive(self, sides: TriangleSides) -> bool:\n        \"\"\"Returns True if all three sides are numeric and > 0; False otherwise.\"\"\"\n        a, b, c = sides.as_tuple()\n        return a > 0 and b > 0 and c > 0\n\n    def validateTriangleInequality(self, sides: TriangleSides) -> bool:\n        \"\"\"Returns True if each side < sum of the other two (strict inequality); False otherwise.\"\"\"\n        a, b, c = sides.as_tuple()\n        return (a < b + c) and (b < a + c) and (c < a + b)\nclass HypotenuseFinder:\n    \"\"\"Identifies the largest side as hypotenuse candidate.\"\"\"\n    def findHypotenuse(self, sides: TriangleSides) -> tuple[float, float, float]:\n        \"\"\"Returns (hypotenuse, side1, side2) where hypotenuse is largest of a,b,c.\"\"\"\n        a, b, c = sides.as_tuple()\n        \n        s = sorted([a, b, c])\n        hypotenuse = s[2]\n        side1 = s[0]\n        side2 = s[1]\n        \n        return (hypotenuse, side1, side2)\nclass RightAngleChecker:\n    \"\"\"Performs the Pythagorean check using squared values and a floating-point tolerance epsilon.\"\"\"\n    DEFAULT_EPSILON: float = 1e-9\n\n    def isRightAngled(self, hypotenuse: float, side1: float, side2: float, epsilon: float = DEFAULT_EPSILON) -> bool:\n        \"\"\"Returns True if |hypotenuse^2 - (side1^2 + side2^2)| <= epsilon, else False.\"\"\"\n        h_sq = hypotenuse ** 2\n        s1_sq = side1 ** 2\n        s2_sq = side2 ** 2\n        \n        return math.fabs(h_sq - (s1_sq + s2_sq)) <= epsilon\ndef right_angle_triangle(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle. Return True if the three\n    sides form a right-angled triangle, False otherwise.\n    A right-angled triangle is a triangle in which one angle is right angle or \n    90 degree.\n    Example:\n    right_angle_triangle(3, 4, 5) == True\n    right_angle_triangle(1, 2, 3) == False\n    '''\n    try:\n        sides = TriangleSides(a, b, c)\n    except ValueError:\n        return False # Return False if input cannot be converted to float\n\n    validator = InputValidator()\n    if not validator.validateNumericPositive(sides):\n        return False\n    if not validator.validateTriangleInequality(sides):\n        return False\n\n    finder = HypotenuseFinder()\n    h, s1, s2 = finder.findHypotenuse(sides)\n\n    checker = RightAngleChecker()\n    return checker.isRightAngled(h, s1, s2)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/158": [{"task_id": "HumanEval/158", "solution": "class Word:\n    \"\"\"Domain object representing a word and its unique character count.\"\"\"\n    def __init__(self, text: str):\n        self.text = text\n\n    def unique_count(self) -> int:\n        \"\"\"Computes the number of distinct characters in the word.\"\"\"\n        return len(set(self.text))\nclass WordList:\n    \"\"\"A container for Word instances.\"\"\"\n    def __init__(self, words: list[Word]):\n        self.words = words\n\n    @classmethod\n    def from_strings(cls, strings: list) -> 'WordList':\n        \"\"\"Constructs a WordList from a list of string texts.\"\"\"\n        return cls([Word(text) for text in strings])\n\n    def __iter__(self):\n        \"\"\"Allows iteration over the Word objects in the list.\"\"\"\n        return iter(self.words)\nclass FindMaxService:\n    \"\"\"Service that implements the selection logic and tie-breaker.\"\"\"\n    def find_max(self, words: list) -> str:\n        \"\"\"Finds the word with maximum unique characters, applying tie-breaker.\"\"\"\n        if not words:\n            return \"\"\n\n        wordlist = WordList.from_strings(words)\n        unique_counts_map = self._compute_unique_counts(wordlist)\n\n        max_count = -1\n        if unique_counts_map:\n            max_count = max(unique_counts_map.values())\n\n        candidates = [word_str for word_str, count in unique_counts_map.items() if count == max_count]\n\n        if candidates:\n            return self._select_with_tiebreaker(candidates)\n        return \"\"\n\n    def _compute_unique_counts(self, wordlist: WordList) -> dict[str, int]:\n        \"\"\"Computes a mapping of word string to its unique character count.\"\"\"\n        counts = {}\n        for word_obj in wordlist:\n            counts[word_obj.text] = word_obj.unique_count()\n        return counts\n\n    def _select_with_tiebreaker(self, candidates: list) -> str:\n        \"\"\"Selects the lexicographically first word from a list of candidates.\"\"\"\n        return sorted(candidates)[0]\ndef find_max(words):\n    \"\"\"Write a function that accepts a list of strings.\n    The list contains different words. Return the word with maximum number\n    of unique characters. If multiple strings have maximum number of unique\n    characters, return the one which comes first in lexicographical order.\n    \"\"\"\n    return FindMaxService().find_max(words)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/150": [{"task_id": "HumanEval/150", "solution": "import math\nclass PrimeChecker:\n    def isPrime(self, n: int) -> bool:\n        \"\"\"Return True if n is prime per SRS; False for n <= 1.\n        This uses trial division up to the square root of n.\"\"\"\n        if n <= 1:\n            return False\n        if n == 2:\n            return True\n        if n % 2 == 0:\n            return False\n        # Check for odd divisors from 3 up to sqrt(n)\n        for i in range(3, math.isqrt(n) + 1, 2):\n            if n % i == 0:\n                return False\n        return True\ndef x_or_y(n, x, y):\n    \"\"\"A simple program which should return the value of x if n is\n    a prime number and should return the value of y otherwise.\n\n    Examples:\n    for x_or_y(7, 34, 12) == 34\n    for x_or_y(15, 8, 5) == 5\n\n    \"\"\"\n    checker = PrimeChecker()\n    if checker.isPrime(n):\n        return x\n    else:\n        return y", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/161": [{"task_id": "HumanEval/161", "solution": "def solve(s):\n    \"\"\"You are given a string s.\n    if s[i] is a letter, reverse its case from lower to upper or vise versa, \n    otherwise keep it as it is.\n    If the string contains no letters, reverse the string.\n    The function should return the resulted string.\n    Examples\n    solve(\"1234\") = \"4321\"\n    solve(\"ab\") = \"AB\"\n    solve(\"#a@C\") = \"#A@c\"\n    \"\"\"\n    \n    has_letters = False\n    for char in s:\n        if char.isalpha():\n            has_letters = True\n            break\n            \n    if not has_letters:\n        return s[::-1]\n    else:\n        result_chars = []\n        for char in s:\n            if char.isalpha():\n                if char.isupper():\n                    result_chars.append(char.lower())\n                else:\n                    result_chars.append(char.upper())\n            else:\n                result_chars.append(char)\n        return \"\".join(result_chars)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/160": [{"task_id": "HumanEval/160", "solution": "class Operator:\n    \"\"\"\n    Represents an operator with its symbol, precedence, and associativity.\n    \"\"\"\n    def __init__(self, symbol: str, precedence: int, associativity: str) -> None:\n        self.symbol = symbol\n        self.precedence = precedence\n        self.associativity = associativity\n\n    def __str__(self):\n        return self.symbol\n\n    def __repr__(self):\n        return f\"Operator('{self.symbol}', {self.precedence}, '{self.associativity}')\"\nclass Operand:\n    \"\"\"\n    Domain holder for a non-negative integer operand.\n    \"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\n    def __str__(self):\n        return str(self.value)\n\n    def __repr__(self):\n        return f\"Operand({self.value})\"\nclass Validator:\n    \"\"\"\n    Validates input lists per specified rules and raises ValueError on failure.\n    \"\"\"\n    SUPPORTED_OPERATORS = {'+', '-', '*', '//', '**'}\n\n    def validate_length(self, operators, operands) -> None:\n        if len(operators) != len(operands) - 1:\n            raise ValueError(\"Length of operator list must be equal to length of operand list minus one.\")\n\n    def validate_counts(self, operators, operands) -> None:\n        if not operators:\n            raise ValueError(\"Operator list must have at least one operator.\")\n        if len(operands) < 2:\n            raise ValueError(\"Operand list must have at least two operands.\")\n\n    def validate_operators(self, operators) -> None:\n        for op in operators:\n            if not isinstance(op, str) or op not in self.SUPPORTED_OPERATORS:\n                raise ValueError(f\"Unsupported or invalid operator: '{op}'. Supported operators are {', '.join(sorted(self.SUPPORTED_OPERATORS))}.\")\n\n    def validate_operands(self, operands) -> None:\n        for op in operands:\n            if not isinstance(op, int) or op < 0:\n                raise ValueError(f\"Operand must be a non-negative integer, got: {op}.\")\n\n    def validate_all(self, operators, operands) -> None:\n        self.validate_counts(operators, operands)\n        self.validate_length(operators, operands)\n        self.validate_operators(operators)\n        self.validate_operands(operands)\nclass ExpressionEvaluator:\n    \"\"\"\n    Builds an internal representation of the expression and computes the integer result\n    applying operator precedence and associativity.\n    \"\"\"\n    _OPERATOR_METADATA = {\n        '**': {'precedence': 3, 'associativity': 'right'},\n        '*': {'precedence': 2, 'associativity': 'left'},\n        '//': {'precedence': 2, 'associativity': 'left'},\n        '+': {'precedence': 1, 'associativity': 'left'},\n        '-': {'precedence': 1, 'associativity': 'left'},\n    }\n\n    def __init__(self, operators: list, operands: list) -> None:\n        self.operands = [Operand(val) for val in operands]\n        self.operators = [\n            Operator(\n                op_sym,\n                self._OPERATOR_METADATA[op_sym]['precedence'],\n                self._OPERATOR_METADATA[op_sym]['associativity']\n            )\n            for op_sym in operators\n        ]\n        self.result = 0\n\n    def evaluate(self) -> int:\n        expression_tokens = []\n        for i in range(len(self.operators)):\n            expression_tokens.append(self.operands[i])\n            expression_tokens.append(self.operators[i])\n        expression_tokens.append(self.operands[-1])\n\n        self.result = self._apply_precedence_and_associativity(expression_tokens)\n        return self.result\n\n    def _apply_precedence_and_associativity(self, expression_tokens: list) -> int:\n        operand_stack = []\n        operator_stack = []\n\n        def perform_operation():\n            operator_obj = operator_stack.pop()\n            right = operand_stack.pop().value\n            left = operand_stack.pop().value\n            \n            if operator_obj.symbol == '+':\n                res = left + right\n            elif operator_obj.symbol == '-':\n                res = left - right\n            elif operator_obj.symbol == '*':\n                res = left * right\n            elif operator_obj.symbol == '//':\n                res = left // right\n            elif operator_obj.symbol == '**':\n                res = left ** right\n            \n            operand_stack.append(Operand(res))\n\n        for token in expression_tokens:\n            if isinstance(token, Operand):\n                operand_stack.append(token)\n            elif isinstance(token, Operator):\n                current_op = token\n                while operator_stack:\n                    top_op = operator_stack[-1]\n                    \n                    if top_op.precedence < current_op.precedence:\n                        break\n                    \n                    if top_op.precedence == current_op.precedence and current_op.associativity == 'right':\n                        break\n\n                    perform_operation()\n                operator_stack.append(current_op)\n        \n        while operator_stack:\n            perform_operation()\n            \n        return operand_stack[0].value\ndef do_algebra(operator: list, operand: list) -> int:\n    \"\"\"\n    Given two lists operator, and operand. The first list has basic algebra operations, and \n    the second list is a list of integers. Use the two given lists to build the algebric \n    expression and return the evaluation of this expression.\n    \"\"\"\n    validator = Validator()\n    validator.validate_all(operator, operand)\n\n    evaluator = ExpressionEvaluator(operator, operand)\n    return evaluator.evaluate()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/159": [{"task_id": "HumanEval/159", "solution": "class Rabbit:\n    \"\"\"Value object holding the number of carrots already eaten.\"\"\"\n    def __init__(self, number: int) -> None:\n        self.number = number\nclass InputParameters:\n    \"\"\"Encapsulates need and remaining, and validates their constraints.\"\"\"\n    def __init__(self, need: int, remaining: int) -> None:\n        self.need = need\n        self.remaining = remaining\n\n    def validate(self) -> None:\n        \"\"\"Enforces need and remaining are within 0..1000, raising ValueError if violated.\"\"\"\n        if not (0 <= self.need <= 1000):\n            raise ValueError(\"Need must be between 0 and 1000.\")\n        if not (0 <= self.remaining <= 1000):\n            raise ValueError(\"Remaining must be between 0 and 1000.\")\nclass CarrotStock:\n    \"\"\"Manages the remaining carrots and allows consumption.\"\"\"\n    def __init__(self, remaining: int) -> None:\n        self.remaining = remaining\n\n    def consume(self, amount: int) -> int:\n        \"\"\"Consumes carrots, updates remaining, and returns the actual amount consumed.\"\"\"\n        consumed_amount = min(amount, self.remaining)\n        self.remaining -= consumed_amount\n        return consumed_amount\nclass Result:\n    \"\"\"Container for the total eaten and remaining after the meal.\"\"\"\n    def __init__(self, total_eaten: int, remaining_after: int) -> None:\n        self.total_eaten = total_eaten\n        self.remaining_after = remaining_after\n\n    def to_list(self) -> list:\n        \"\"\"Converts the result to a two-element list.\"\"\"\n        return [self.total_eaten, self.remaining_after]\nclass EatOperation:\n    \"\"\"Orchestrates the carrot eating logic.\"\"\"\n    def __init__(self) -> None:\n        self.carrots_to_eat = 0\n\n    def execute(self, number: int, need: int, remaining: int) -> Result:\n        \"\"\"Performs the carrot eating calculation and returns the result.\"\"\"\n        input_params = InputParameters(need, remaining)\n        input_params.validate()\n\n        rabbit = Rabbit(number)\n        carrot_stock = CarrotStock(remaining)\n\n        self.carrots_to_eat = min(input_params.need, carrot_stock.remaining)\n        carrot_stock.consume(self.carrots_to_eat)\n\n        total_eaten = rabbit.number + self.carrots_to_eat\n        remaining_after = carrot_stock.remaining\n\n        return Result(total_eaten, remaining_after)\ndef eat(number, need, remaining):\n    \"\"\"\n    You're a hungry rabbit, and you already have eaten a certain number of carrots,\n    but now you need to eat more carrots to complete the day's meals.\n    you should return an array of [ total number of eaten carrots after your meals,\n                                    the number of carrots left after your meals ]\n    if there are not enough remaining carrots, you will eat all remaining carrots, but will still be hungry.\n    \"\"\"\n    operation = EatOperation()\n    result_obj = operation.execute(number, need, remaining)\n    return result_obj.to_list()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/162": [{"task_id": "HumanEval/162", "solution": "import hashlib\ndef string_to_md5(text):\n    \"\"\"\n    Given a string 'text', return its md5 hash equivalent string.\n    If 'text' is an empty string, return None.\n    \"\"\"\n    if not text:\n        return None\n    \n    # Encode the text to bytes using UTF-8 before hashing\n    encoded_text = text.encode('utf-8')\n    md5_hash = hashlib.md5(encoded_text).hexdigest()\n    return md5_hash", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/94": [{"task_id": "HumanEval/94", "solution": "import math\ndef _is_prime(n: int) -> bool:\n    \"\"\"Checks if a number is prime using trial division.\"\"\"\n    if n <= 1:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n    for i in range(3, int(math.sqrt(n)) + 1, 2):\n        if n % i == 0:\n            return False\n    return True\ndef _digit_sum(n: int) -> int:\n    \"\"\"Calculates the sum of the decimal digits of a number.\"\"\"\n    s = 0\n    while n > 0:\n        s += n % 10\n        n //= 10\n    return s\ndef skjkasdkd(lst):\n    \"\"\"You are given a list of integers.\n    You need to find the largest prime value and return the sum of its digits.\n\n    Examples:\n    For lst = [0,3,2,1,3,5,7,4,5,5,5,2,181,32,4,32,3,2,32,324,4,3] the output should be 10\n    For lst = [1,0,1,8,2,4597,2,1,3,40,1,2,1,2,4,2,5,1] the output should be 25\n    For lst = [1,3,1,32,5107,34,83278,109,163,23,2323,32,30,1,9,3] the output should be 13\n    For lst = [0,724,32,71,99,32,6,0,5,91,83,0,5,6] the output should be 11\n    For lst = [0,81,12,3,1,21] the output should be 3\n    For lst = [0,8,1,2,1,7] the output should be 7\n    \"\"\"\n    largest_prime = None\n\n    for num in lst:\n        if _is_prime(num):\n            if largest_prime is None or num > largest_prime:\n                largest_prime = num\n    \n    if largest_prime is not None:\n        return _digit_sum(largest_prime)\n    else:\n        # Based on the examples, inputs are expected to contain at least one prime.\n        # If no prime is found, returning 0 is a reasonable default behavior.\n        return 0", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/15": [{"task_id": "HumanEval/15", "solution": "def string_sequence(n: int) -> str:\n    \"\"\" Return a string containing space-delimited numbers starting from 0 upto n inclusive.\n    \"\"\"\n    return ' '.join(str(i) for i in range(n + 1))", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/163": [{"task_id": "HumanEval/163", "solution": "from typing import Iterator, List\nclass Input:\n    \"\"\"Represents the raw input integers a and b and validates them.\"\"\"\n    def __init__(self, a: int, b: int) -> None:\n        self.a = a\n        self.b = b\n\n    def validate(self) -> bool:\n        \"\"\"Verifies both a and b are positive integers.\"\"\"\n        if not isinstance(self.a, int) or not isinstance(self.b, int):\n            return False\n        if self.a <= 0 or self.b <= 0:\n            return False\n        return True\nclass IntegerRange:\n    \"\"\"Normalizes an integer pair into an inclusive range [start, end] and enumerates it.\"\"\"\n    def __init__(self, a: int = None, b: int = None) -> None:\n        self.start: int = 0\n        self.end: int = 0\n        if a is not None and b is not None:\n            self.normalize(a, b)\n\n    def normalize(self, a: int, b: int) -> None:\n        \"\"\"Sets the start and end of the range.\"\"\"\n        self.start = min(a, b)\n        self.end = max(a, b)\n\n    def enumerate(self) -> Iterator[int]:\n        \"\"\"Yields integers from start to end inclusive.\"\"\"\n        for i in range(self.start, self.end + 1):\n            yield i\nclass Digit:\n    \"\"\"Represents a candidate integer and applies filtering rules.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\n    def isSingleDigit(self) -> bool:\n        \"\"\"Checks if the value is a single digit (0-9 inclusive).\"\"\"\n        return 0 <= self.value <= 9\n\n    def isEven(self) -> bool:\n        \"\"\"Checks if the value is even.\"\"\"\n        return self.value % 2 == 0\nclass ResultList:\n    \"\"\"Collects eligible integers, maintains order, and provides final list export.\"\"\"\n    def __init__(self) -> None:\n        self.values: List[int] = []\n\n    def add(self, value: int) -> None:\n        \"\"\"Adds a value to the list.\"\"\"\n        self.values.append(value)\n\n    def sortAscending(self) -> None:\n        \"\"\"Sorts the collected values in ascending order.\"\"\"\n        self.values.sort()\n\n    def isEmpty(self) -> bool:\n        \"\"\"Checks if the list is empty.\"\"\"\n        return not self.values\n\n    def as_list(self) -> List[int]:\n        \"\"\"Returns the internal values as a plain list.\"\"\"\n        return list(self.values)\ndef generate_integers(a, b) -> list:\n    \"\"\"\n    Given two positive integers a and b, return the even digits between a\n    and b, in ascending order.\n    \"\"\"\n    inp = Input(a, b)\n    if not inp.validate():\n        raise ValueError(\"invalid inputs: a and b must be positive integers\")\n\n    rng = IntegerRange()\n    rng.normalize(a, b)\n\n    result = ResultList()\n    for v in rng.enumerate():\n        d = Digit(v)\n        if d.isSingleDigit() and d.isEven():\n            result.add(v)\n\n    result.sortAscending()\n    return result.as_list()", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[987654321, 123456789]]}], "HumanEval/129": [{"task_id": "HumanEval/129", "solution": "from typing import List\nclass Cell:\n    \"\"\"Represents a single grid cell with coordinates and integer value.\"\"\"\n    def __init__(self, row: int, col: int, value: int):\n        self.row = row\n        self.col = col\n        self.value = value\nclass Path:\n    \"\"\"Represents a candidate path of exactly k visited cells and its values.\"\"\"\n    def __init__(self, k: int):\n        self.k = k\n        self.values: List[int] = []\n        self.steps: List[Cell] = []\n\n    def append(self, cell: Cell) -> None:\n        \"\"\"Appends a cell and its value to the path.\"\"\"\n        self.steps.append(cell)\n        self.values.append(cell.value)\n\n    def length(self) -> int:\n        \"\"\"Returns the current number of steps/values in the path.\"\"\"\n        return len(self.steps)\nclass Grid:\n    \"\"\"Represents an N x N grid of Cell objects and validates permutation constraint.\"\"\"\n    def __init__(self, grid_data: List[List[int]]):\n        self.N = len(grid_data)\n        self.cells: List[List[Cell]] = []\n        for r in range(self.N):\n            row_cells = []\n            for c in range(self.N):\n                row_cells.append(Cell(r, c, grid_data[r][c]))\n            self.cells.append(row_cells)\n\n    def validatePermutation(self) -> bool:\n        \"\"\"Returns True if the grid values are a permutation of 1 to N*N.\"\"\"\n        expected_size = self.N * self.N\n        seen = [False] * (expected_size + 1)\n        for r in range(self.N):\n            for c in range(self.N):\n                val = self.cells[r][c].value\n                if not (1 <= val <= expected_size) or seen[val]:\n                    return False\n                seen[val] = True\n        return all(seen[1:])\nclass MinPathService:\n    \"\"\"Performs validation, searches for the minimal path, and compares paths.\"\"\"\n    def minPath(self, grid_data: List[List[int]], k: int) -> List[int]:\n        \"\"\"Orchestrates validation and search for the minimal path.\"\"\"\n        self.validateGrid(grid_data)\n        self.validateK(k)\n        \n        grid_obj = Grid(grid_data)\n        best_path = self.searchMinimalPath(grid_obj, k)\n        return best_path.values\n\n    def validateGrid(self, grid_data: List[List[int]]) -> None:\n        \"\"\"Ensures input is a square N x N grid with N >= 2 and permutation constraint holds.\"\"\"\n        if not isinstance(grid_data, list) or not grid_data:\n            raise ValueError(\"Grid must be a non-empty list of lists.\")\n        N = len(grid_data)\n        if N < 2:\n            raise ValueError(\"Grid must have N rows where N >= 2.\")\n        for row in grid_data:\n            if not isinstance(row, list) or len(row) != N:\n                raise ValueError(\"Grid must be square (N x N).\")\n            for val in row:\n                if not isinstance(val, int):\n                    raise ValueError(\"Grid cells must contain integers.\")\n        \n        temp_grid_obj = Grid(grid_data) \n        if not temp_grid_obj.validatePermutation():\n            raise ValueError(f\"Grid values must be a permutation of 1 to {N*N}.\")\n\n    def validateK(self, k: int) -> None:\n        \"\"\"Ensures k is an integer and k >= 1.\"\"\"\n        if not isinstance(k, int) or k < 1:\n            raise ValueError(\"k must be a positive integer.\")\n\n    def lexCompare(self, a: Path, b: Path) -> int:\n        \"\"\"Compares two Path objects lexicographically based on their values.\"\"\"\n        if a.values < b.values:\n            return -1\n        if a.values > b.values:\n            return 1\n        return 0\n\n    def searchMinimalPath(self, grid_obj: Grid, k: int) -> Path:\n        \"\"\"Finds the lexicographically minimal path of length k using DFS with pruning.\"\"\"\n        N = grid_obj.N\n        \n        best_overall_path = None \n\n        directions = [(-1, 0), (1, 0), (0, -1), (0, 1)] # Up, Down, Left, Right\n\n        def dfs(r_curr: int, c_curr: int, current_path: Path):\n            nonlocal best_overall_path\n            \n            if best_overall_path is not None:\n                if current_path.values > best_overall_path.values[:current_path.length()]:\n                    return \n            \n            if current_path.length() == k:\n                if best_overall_path is None or self.lexCompare(current_path, best_overall_path) < 0:\n                    best_overall_path = Path(k)\n                    best_overall_path.values.extend(current_path.values)\n                    best_overall_path.steps.extend(current_path.steps) \n                return\n\n            for dr, dc in directions:\n                next_r, next_c = r_curr + dr, c_curr + dc\n\n                if 0 <= next_r < N and 0 <= next_c < N:\n                    next_cell = grid_obj.cells[next_r][next_c]\n                    \n                    new_path = Path(k)\n                    new_path.values.extend(current_path.values)\n                    new_path.steps.extend(current_path.steps)\n                    new_path.append(next_cell)\n                    \n                    dfs(next_r, next_c, new_path)\n        \n        for r_start in range(N):\n            for c_start in range(N):\n                initial_cell = grid_obj.cells[r_start][c_start]\n                initial_path = Path(k)\n                initial_path.append(initial_cell)\n                dfs(r_start, c_start, initial_path)\n\n        return best_overall_path\ndef minPath(grid: List[List[int]], k: int) -> List[int]:\n    \"\"\"\n    Given a grid and a positive integer k, find the minimum path of length k.\n    \"\"\"\n    service = MinPathService()\n    return service.minPath(grid, k)", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[[[10, 5, 20, 14, 16], [7, 11, 12, 17, 9], [13, 19, 1, 15, 8], [3, 18, 4, 6, 2], [22, 21, 23, 24, 25]], 23]]}], "HumanEval/130": [{"task_id": "HumanEval/130", "solution": "from typing import List\nclass InputParameter:\n    \"\"\"Encapsulates input n and validates it.\"\"\"\n    def __init__(self, n):\n        self.n = n\n\n    def validate(self) -> None:\n        \"\"\"Validates that n is a non-negative integer, raising ValueError if invalid.\"\"\"\n        if not isinstance(self.n, int):\n            raise ValueError(\"Input 'n' must be an integer.\")\n        if self.n < 0:\n            raise ValueError(\"Input 'n' must be a non-negative integer.\")\nclass OutputList:\n    \"\"\"Encapsulates the generated list of Tribonacci values.\"\"\"\n    def __init__(self, values: List[int]) -> None:\n        self.values = values\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the contained list of values.\"\"\"\n        return len(self.values)\nclass TribonacciSequence:\n    \"\"\"Generates the Tribonacci sequence based on its rules.\"\"\"\n    def __init__(self) -> None:\n        \"\"\"Initializes the Tribonacci sequence generator.\"\"\"\n        self.values: List[int] = []\n\n    def getTerm(self, k: int) -> int:\n        \"\"\"Retrieves a computed Tribonacci term by index.\"\"\"\n        if 0 <= k < len(self.values):\n            return self.values[k]\n        else:\n            # This method acts as an accessor for already computed values.\n            raise IndexError(f\"Tribonacci term at index {k} is not available.\")\n\n    def generate(self, n: int) -> OutputList:\n        \"\"\"\n        Generates Tribonacci sequence terms up to index n,\n        precomputing even values before odd values due to recurrence.\n        \"\"\"\n        # Determine the maximum index we need to compute to satisfy odd recurrences.\n        # For tri(k) where k is odd, we need tri(k+1). So, we need values up to n+1.\n        max_compute_idx = n + 1\n\n        # Initialize storage for all terms up to max_compute_idx.\n        # The list size is (max_compute_idx + 1) to accommodate indices 0 through max_compute_idx.\n        self.values = [0] * (max_compute_idx + 1)\n\n        # Precompute all even-indexed values using the closed form: tri(k) = 1 + k / 2.\n        # This covers tri(0), tri(2), tri(4), etc., up to max_compute_idx.\n        for k in range(0, max_compute_idx + 1):\n            if k % 2 == 0: # If k is even\n                self.values[k] = 1 + k // 2\n\n        # Handle the specific base case for tri(1).\n        if 1 <= max_compute_idx:\n            self.values[1] = 3\n\n        # Compute odd-indexed values using the recurrence relation:\n        # tri(k) = tri(k-1) + tri(k-2) + tri(k+1).\n        # We iterate through odd indices from 1 up to n.\n        # tri(1) is a base case, so start the recurrence from k=3.\n        for k in range(1, n + 1):\n            if k % 2 != 0 and k != 1: # If k is odd and not the base case tri(1)\n                self.values[k] = self.values[k-1] + self.values[k-2] + self.values[k+1]\n\n        # Extract the required range: tri(0) to tri(n).\n        result_sublist = self.values[:n+1]\n        return OutputList(result_sublist)\ndef tri(n):\n    \"\"\"\n    Generates the first n+1 numbers of the Tribonacci sequence according to its rules.\n    \"\"\"\n    # Validate the input 'n' as per design requirements.\n    param = InputParameter(n)\n    param.validate()\n\n    # Delegate the sequence generation to the TribonacciSequence class.\n    sequence_generator = TribonacciSequence()\n    output_list = sequence_generator.generate(n)\n\n    # Return the generated values as a plain Python list.\n    return output_list.values", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/139": [{"task_id": "HumanEval/139", "solution": "class Factorial:\n    @staticmethod\n    def compute(k: int) -> int:\n        \"\"\"Compute k! for k >= 1.\"\"\"\n        result = 1\n        for i in range(1, k + 1):\n            result *= i\n        return result\nclass BrazilianFactorialCalculator:\n    def compute(self, n: int) -> int:\n        \"\"\"Compute product of Factorial.compute(k) for k in 1..n.\"\"\"\n        product_of_factorials = 1\n        for k_val in range(1, n + 1):\n            current_factorial = Factorial.compute(k_val)\n            product_of_factorials *= current_factorial\n        return product_of_factorials\ndef special_factorial(n):\n    \"\"\"The Brazilian factorial is defined as:\n    brazilian_factorial(n) = n! * (n-1)! * (n-2)! * ... * 1!\n    where n > 0\n\n    For example:\n    >>> special_factorial(4)\n    288\n\n    The function will receive an integer as input and should return the special\n    factorial of this integer.\n    \"\"\"\n    if not isinstance(n, int) or n <= 0:\n        raise ValueError(\"Input n must be a positive integer.\")\n\n    calculator = BrazilianFactorialCalculator()\n    computed_value = calculator.compute(n)\n    return computed_value", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}]}}