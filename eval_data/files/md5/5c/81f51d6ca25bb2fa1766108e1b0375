 if n > 1: # Only calculate product if n is positive to match factors list\n            for factor in factors:\n                result_product *= factor\n\n        # Verification check as per design, but only for n > 1 as factors list is empty for n <= 1\n        verified = (n == 1 and not factors) or (n > 1 and result_product == n)\n\n        return FactorizationResult(factors=factors, verified=verified)\ndef factorize(n: int) -> List[int]:\n    \"\"\" Return list of prime factors of given integer in the order from smallest to largest.\n    Each of the factors should be listed number of times corresponding to how many times it appeares in factorization.\n    Input number should be equal to the product of all factors\n    >>> factorize(8)\n    [2, 2, 2]\n    >>> factorize(25)\n    [5, 5]\n    >>> factorize(70)\n    [2, 5, 7]\n    \"\"\"\n    if n <= 1:\n        raise ValueError(\"Input number must be greater than 1.\")\n\n    request = FactorizationRequest(n)\n    service = FactorizationService()\n    result = service.factorize(request)\n\n    if not result.verified:\n        raise ValueError(f\"Verification failed: product of factors ({result.product()}) does not equal input n ({n}).\")\n\n    return result.factors", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/35": [{"task_id": "HumanEval/35", "solution": "def max_element(l: list):\n    \"\"\"Return maximum element in the list.\n    >>> max_element([1, 2, 3])\n    3\n    >>> max_element([5, 3, -5, 2, -3, 3, 9, 0, 123, 1, -10])\n    123\n    \"\"\"\n    # Assume list 'l' is non-empty and contains pairwise comparable elements.\n    current_max = l[0]\n    for element in l[1:]:\n        if element > current_max:\n            current_max = element\n    return current_max", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/32": [{"task_id": "HumanEval/32", "solution": "import math\ndef poly(xs: list, x: float):\n    \"\"\"\n    Evaluates polynomial with coefficients xs at point x.\n    return xs[0] + xs[1] * x + xs[1] * x^2 + .... xs[n] * x^n\n    \"\"\"\n    return sum([coeff * math.pow(x, i) for i, coeff in enumerate(xs)])\ndef _validate_coefficients(xs: list) -> bool:\n    \"\"\"\n    Validates polynomial coefficients.\n    Returns True if length is even and leading coefficient is non-zero, False otherwise.\n    \"\"\"\n    if not xs:\n        return False\n    if len(xs) % 2 != 0:\n        return False\n    if xs[-1] == 0:\n        return False\n    return True\ndef find_zero(xs: list):\n    \"\"\" xs are coefficients of a polynomial.\n    find_zero find x such that poly(x) = 0.\n    find_zero returns only only zero point, even if there are many.\n    Moreover, find_zero only takes list xs having even number of coefficients\n    and largest non zero coefficient as it guarantees\n    a solution.\n    >>> round(find_zero([1, 2]), 2) # f(x) = 1 + 2x\n    -0.5\n    >>> round(find_zero([-6, 11, -6, 1]), 2) # (x - 1) * (x - 2) * (x - 3) = -6 + 11x - 6x^2 + x^3\n    1.0\n    \"\"\"\n    if not _validate_coefficients(xs):\n        raise ValueError(\"Invalid coefficients: length must be even and leading coefficient non-zero.\")\n\n    # Bisection method to find a single real root.\n    # An odd-degree polynomial (guaranteed by even number of coefficients) always has at least one real root.\n    \n    low = -1000.0  # Initial lower bound for the search interval\n    high = 1000.0  # Initial upper bound for the search interval\n    tolerance = 1e-7 # Precision for the root-finding\n    max_iterations = 1000 # Limit iterations to prevent infinite loops\n\n    for _ in range(max_iterations):\n        p_low = poly(xs, low)\n        p_high = poly(xs, high)\n\n        if abs(p_low) < tolerance:\n            return low\n        if abs(p_high) < tolerance:\n            return high\n\n        mid = (low + high) / 2\n        p_mid = poly(xs, mid)\n\n        if abs(p_mid) < tolerance:\n            return mid\n\n        # Narrow the interval based on the sign change.\n        if p_low * p_mid < 0:\n            high = mid\n        else:\n            low = mid\n            \n    # Return the best approximation if max_iterations is reached\n    return (low + high) / 2", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[[5, 10, -3, 1]]]}], "HumanEval/33": [{"task_id": "HumanEval/33", "solution": "class IndexSelector:\n    def isDivByThree(self, i: int) -> bool:\n        return i % 3 == 0\nclass Sorter:\n    def sortValues(self, values: list) -> list:\n        return sorted(values)\ndef sort_third(l: list):\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the indicies that are not divisible by three, while its values at the indicies that are divisible by three are equal\n    to the values of the corresponding indicies of l, but sorted.\n    >>> sort_third([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_third([5, 6, 3, 4, 8, 9, 2])\n    [2, 6, 3, 4, 8, 9, 5]\n    \"\"\"\n    if not l:\n        return []\n\n    selector = IndexSelector()\n    sorter = Sorter()\n\n    target_values = []\n    target_indices = []\n    for i in range(len(l)):\n        if selector.isDivByThree(i):\n            target_values.append(l[i])\n            target_indices.append(i)\n\n    sorted_target_values = sorter.sortValues(target_values)\n\n    l_prime = list(l) # Create a new list to avoid mutating the input.\n\n    # Replace values at target indices with sorted values.\n    for i, original_index in enumerate(target_indices):\n        l_prime[original_index] = sorted_target_values[i]\n\n    return l_prime", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/37": [{"task_id": "HumanEval/37", "solution": "from typing import List\ndef _is_even_index(i: int) -> bool:\n    \"\"\"Checks if an index is even (zero-based).\"\"\"\n    return i % 2 =