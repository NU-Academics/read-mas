mpty product should be equal to 1.\n    >>> sum_product([])\n    (0, 1)\n    >>> sum_product([1, 2, 3, 4])\n    (10, 24)\n    \"\"\"\n    if not numbers:\n        return (0, 1)\n\n    total_sum = 0\n    total_product = 1\n\n    for num in numbers:\n        total_sum += num\n        total_product *= num\n\n    return (total_sum, total_product)", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/10": [{"task_id": "HumanEval/10", "solution": "def make_palindrome(string: str) -> str:\n    \"\"\" Find the shortest palindrome that begins with a supplied string.\n    Algorithm idea is simple:\n    - Find the longest postfix of supplied string that is a palindrome.\n    - Append to the end of the string reverse of a string prefix that comes before the palindromic suffix.\n    >>> make_palindrome('')\n    ''\n    >>> make_palindrome('cat')\n    'catac'\n    >>> make_palindrome('cata')\n    'catac'\n    \"\"\"\n    if not string:\n        return \"\"\n\n    for i in range(len(string)):\n        suffix = string[i:]\n        if is_palindrome(suffix):\n            # The current suffix is a palindrome. Since we iterate from the start (i=0),\n            # this is the longest palindromic suffix.\n            prefix_to_reverse = string[:i]\n            return string + prefix_to_reverse[::-1]", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [["x"]], "plus_fail_tests": [["race"]]}], "HumanEval/11": [{"task_id": "HumanEval/11", "solution": "class ValidationError(ValueError):\n    \"\"\"Custom exception for validation errors, subclassing ValueError.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\nclass BinaryString:\n    \"\"\"Represents a binary string and provides validation and length operations.\"\"\"\n    def __init__(self, value: str) -> None:\n        self.value = value\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the binary string.\"\"\"\n        return len(self.value)\n\n    def is_valid_binary(self) -> bool:\n        \"\"\"Checks if the string contains only '0' and '1' characters.\"\"\"\n        return all(char in {'0', '1'} for char in self.value)\n\n    def validate_chars(self) -> None:\n        \"\"\"Raises ValidationError if the string contains invalid characters.\"\"\"\n        if not self.is_valid_binary():\n            raise ValidationError(\"Input string must contain only '0' or '1'.\")\n\n    def validate_length(self, other: 'BinaryString') -> None:\n        \"\"\"Raises ValidationError if the length of this string differs from another.\"\"\"\n        if self.length() != other.length():\n            raise ValidationError(\"Input strings must have equal length.\")\nclass StringXOR:\n    \"\"\"Performs per-index XOR on two BinaryString instances.\"\"\"\n    @staticmethod\n    def string_xor(a: BinaryString, b: BinaryString) -> BinaryString:\n        \"\"\"Computes the binary XOR of two BinaryString objects.\"\"\"\n        result_chars = []\n        for i in range(a.length()):\n            if a.value[i] != b.value[i]:\n                result_chars.append('1')\n            else:\n                result_chars.append('0')\n        return BinaryString(\"\".join(result_chars))\ndef string_xor(a: str, b: str) -> str:\n    \"\"\" Input are two strings a and b consisting only of 1s and 0s.\n    Perform binary XOR on these inputs and return result also as a string.\n    >>> string_xor('010', '110')\n    '100'\n    \"\"\"\n    binary_a = BinaryString(a)\n    binary_b = BinaryString(b)\n\n    binary_a.validate_chars()\n    binary_b.validate_chars()\n    binary_a.validate_length(binary_b)\n\n    result_binary_string = StringXOR.string_xor(binary_a, binary_b)\n    return result_binary_string.value", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/12": [{"task_id": "HumanEval/12", "solution": "from typing import List, Optional\ndef longest(strings: List