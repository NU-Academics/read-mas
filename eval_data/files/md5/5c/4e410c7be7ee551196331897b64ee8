{"task_id": "HumanEval/0", "solution": "def has_close_elements(numbers: List[float], threshold: float) -> bool:\n    \"\"\" Check if in given list of numbers, are any two numbers closer to each other than\n    given threshold.\n    \"\"\"\n    # Sort the numbers to easily compare adjacent elements.\n    sorted_numbers = sorted(numbers)\n\n    # Iterate through the sorted list and check differences between adjacent elements.\n    for i in range(len(sorted_numbers) - 1):\n        if abs(sorted_numbers[i] - sorted_numbers[i+1]) < threshold:\n            return True\n            \n    return False"}
{"task_id": "HumanEval/2", "solution": "import math\n\ndef truncate_number(number: float) -> float:\n    \"\"\" Given a positive floating point number, it can be decomposed into\n    and integer part (largest integer smaller than given number) and decimals\n    (leftover part always smaller than 1).\n\n    Return the decimal part of the number.\n    >>> truncate_number(3.5)\n    0.5\n    \"\"\"\n    # Use a small tolerance for floating point comparisons to handle precision issues.\n    EPSILON: float = 1e-12\n\n    integer_part = math.floor(number)\n    decimal_part = number - integer_part\n\n    # Adjust for potential floating-point inaccuracies near integer boundaries.\n    if decimal_part < EPSILON or decimal_part + EPSILON >= 1.0:\n        return 0.0\n\n    return decimal_part"}
{"task_id": "HumanEval/1", "solution": "def separate_paren_groups(paren_string: str) -> List[str]:\n    \"\"\" Input to this function is a string containing multiple groups of nested parentheses. Your goal is to\n    separate those group into separate strings and return the list of those.\n    Separate groups are balanced (each open brace is properly closed) and not nested within each other\n    Ignore any spaces in the input string.\n    >>> separate_paren_groups('( ) (( )) (( )( ))')\n    ['()', '(())', '(()())']\n    \"\"\"\n    # Normalize: remove all whitespace characters.\n    normalized_string = \"\".join(ch for ch in paren_string if not ch.isspace())\n\n    groups: List[str] = []\n    current_group_buffer: List[str] = []\n    balance_counter = 0\n\n    for char in normalized_string:\n        if char == '(':\n            balance_counter += 1\n            current_group_buffer.append(char)\n        elif char == ')':\n            current_group_buffer.append(char)\n            balance_counter -= 1\n\n            if balance_counter < 0:\n                # Unmatched closing parenthesis; discard the current invalid group.\n                current_group_buffer.clear()\n                balance_counter = 0  # Reset for the next potential group\n            elif balance_counter == 0:\n                # A complete balanced group has been found.\n                groups.append(\"\".join(current_group_buffer))\n                current_group_buffer.clear()\n        # Other characters are implicitly ignored as they are not '(' or ')'.\n\n    # Any remaining content in current_group_buffer represents an unbalanced group\n    # (e.g., unmatched opening parentheses) and is implicitly discarded.\n\n    return groups"}
{"task_id": "HumanEval/7", "solution": "def filter_by_substring(strings: List[str], substring: str) -> List[str]:\n    \"\"\" Filter an input list of strings only for ones that contain given substring\n    >>> filter_by_substring([], 'a')\n    []\n    >>> filter_by_substring(['abc', 'bacd', 'cde', 'array'], 'a')\n    ['abc', 'bacd', 'array']\n    \"\"\"\n    return [s for s in strings if substring in s]"}
{"task_id": "HumanEval/6", "solution": "from typing import List, Optional\n\nclass ParseError(Exception):\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\nclass ValidationError(ParseError):\n    def __init__(self, message: str, group_index: Optional[int] = None) -> None:\n        super().__init__(message)\n        self.group_index = group_index\n\nclass Utils:\n    def split_groups(self, s: str) -> List[str]:\n        \"\"\"Splits a string into groups by whitespace, filtering out empty tokens.\"\"\"\n        return [group for group in s.split() if group]\n\nclass InputValidator:\n    VALID_CHARS = {\"(\", \")\"}\n\n    def is_valid_chars(self, group: str) -> bool:\n        \"\"\"Checks if all characters in the group are valid parentheses.\"\"\"\n        return all(ch in self.VALID_CHARS for ch in group)\n\n    def is_balanced(self, group: str) -> bool:\n        \"\"\"Checks if parentheses in a group are balanced.\"\"\"\n        balance = 0\n        for ch in group:\n            if ch == \"(\":\n                balance += 1\n            else:\n                balance -= 1\n                if balance < 0:\n                    return False\n        return balance == 0\n\n    def validate_group(self, group: str, index: int) -> None:\n        \"\"\"Validates a single group for allowed characters and balance.\"\"\"\n        if not self.is_valid_chars(group):\n            raise ValidationError(message=\"Invalid characters present\", group_index=index)\n        if not self.is_balanced(group):\n            raise ValidationError(message=\"Unbalanced parentheses\", group_index=index)\n\nclass ParserService:\n    def __init__(self, validator: InputValidator = None, utils: Utils = None) -> None:\n        \"\"\"Initializes ParserService with optional validator and utility dependencies.\"\"\"\n        self.validator = validator or InputValidator()\n        self.utils = utils or Utils()\n\n    def parse(self, paren_string: str) -> List[int]:\n        \"\"\"Parses a string of space-separated parenthesis groups, returning their max nesting depths.\"\"\"\n        groups = self.utils.split_groups(paren_string)\n        depths: List[int] = []\n        for idx, g in enumerate(groups):\n            self.validator.validate_group(g, idx)\n            depths.append(self._parse_group(g))\n        return depths\n\n    def _parse_group(self, group: str) -> int:\n        \"\"\"Computes the maximum nesting depth for a single, validated parenthesis group.\"\"\"\n        depth = 0\n        max_depth = 0\n        for ch in group:\n            if ch == \"(\":\n                depth += 1\n                max_depth = max(max_depth, depth)\n            else:\n                depth -= 1\n                if depth < 0:\n                    raise ValidationError(message=\"Unbalanced parentheses\")\n        if depth != 0:\n            raise ValidationError(message=\"Unbalanced parentheses\")\n        return max_depth\n\n\ndef parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\" Input to this function is a string represented multiple groups for nested parentheses separated by spaces.\n    For each of the group, output the deepest level of nesting of parentheses.\n    E.g. (()()) has maximum two levels of nesting while ((())) has three.\n\n    >>> parse_nested_parens('(()()) ((())) () ((())()())')\n    [2, 3, 1, 3]\n    \"\"\"\n    service = ParserService()\n    return service.parse(paren_string)"}
{"task_id": "HumanEval/5", "solution": "def intersperse(numbers: List[int], delimeter: int) -> List[int]:\n    \"\"\" Insert a number 'delimeter' between every two consecutive elements of input list `numbers'.\n    \"\"\"\n    if not numbers:\n        return []\n\n    result: List[int] = []\n    for i, num in enumerate(numbers):\n        result.append(num)\n        if i < len(numbers) - 1:\n            result.append(delimeter)\n    return result"}
