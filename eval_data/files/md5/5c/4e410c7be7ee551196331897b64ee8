{"task_id": "HumanEval/57", "solution": "def monotonic(l: list):\n    \"\"\"Return True if list elements are monotonically increasing or decreasing, allowing equal elements.\n    An empty list or a single-element list is considered monotonic.\n    \"\"\"\n    if len(l) <= 1:\n        return True\n\n    non_decreasing = True\n    non_increasing = True\n\n    for i in range(len(l) - 1):\n        if l[i+1] < l[i]:\n            non_decreasing = False\n        if l[i+1] > l[i]:\n            non_increasing = False\n\n        if not (non_decreasing or non_increasing):\n            return False\n\n    return non_decreasing or non_increasing"}
{"task_id": "HumanEval/55", "solution": "def fib(n: int):\n    \"\"\"Return n-th Fibonacci number.\n    >>> fib(10)\n    55\n    >>> fib(1)\n    1\n    >>> fib(8)\n    21\n    \"\"\"\n    # The design specifies n is 1-indexed with fib(1)=1, fib(2)=1.\n    # It also states inputs less than 1 are invalid, but the prompt forbids raising exceptions.\n    # We proceed assuming n >= 1 as implied by the docstring examples.\n    \n    if n == 1 or n == 2:\n        return 1\n    \n    a, b = 1, 1\n    for _ in range(3, n + 1):\n        a, b = b, a + b\n    return b"}
{"task_id": "HumanEval/58", "solution": "def common(l1: list, l2: list):\n    \"\"\"Return sorted unique common elements for two lists.\"\"\"\n    # Convert lists to sets to get unique elements and enable efficient intersection.\n    set1 = set(l1)\n    set2 = set(l2)\n\n    # Compute the intersection of the two sets to find common elements.\n    common_elements = set1.intersection(set2)\n\n    # Convert the resulting set back to a list.\n    result_list = list(common_elements)\n\n    # Sort the list. If elements are of mixed incomparable types, sort by string representation.\n    try:\n        return sorted(result_list)\n    except TypeError:\n        return sorted(result_list, key=lambda x: str(x))"}
{"task_id": "HumanEval/60", "solution": "def sum_to_n(n: int):\n    \"\"\"sum_to_n is a function that sums numbers from 1 to n.\n    >>> sum_to_n(30)\n    465\n    >>> sum_to_n(100)\n    5050\n    >>> sum_to_n(5)\n    15\n    >>> sum_to_n(10)\n    55\n    >>> sum_to_n(1)\n    1\n    \"\"\"\n    # Computes the sum of integers from 1 to n using the arithmetic series formula.\n    return n * (n + 1) // 2"}
