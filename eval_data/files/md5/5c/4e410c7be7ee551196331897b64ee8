{"task_id": "HumanEval/4", "solution": "from typing import List\nimport math\n\nclass InvalidInputError(Exception):\n    \"\"\"Exception raised for invalid input data.\"\"\"\n    pass\n\nclass ComputationError(Exception):\n    \"\"\"Exception raised for errors during computation.\"\"\"\n    pass\n\ndef is_finite(x: float) -> bool:\n    \"\"\"Check if a number is finite (not NaN or Inf).\"\"\"\n    return math.isfinite(x)\n\nclass InputValidator:\n    \"\"\"Validates and normalizes input sequences.\"\"\"\n    def validate(self, numbers: List[object]) -> List[float]:\n        \"\"\"Ensures input is a non-empty list of finite numeric values.\"\"\"\n        if numbers is None:\n            raise InvalidInputError(\"Input is None\")\n        try:\n            seq = list(numbers)\n        except TypeError:\n            raise InvalidInputError(\"Input is not iterable\")\n        if len(seq) == 0:\n            raise InvalidInputError(\"Input sequence is empty\")\n        out: List[float] = []\n        for i, v in enumerate(seq):\n            try:\n                f = float(v)\n            except Exception:\n                raise InvalidInputError(f\"Element at index {i} is not numeric: {v!r}\")\n            if not is_finite(f):\n                raise InvalidInputError(f\"Element at index {i} is not finite: {v!r}\")\n            out.append(f)\n        return out\n\nDEFAULT_USE_NUMPY = True\n\nclass MeanAbsoluteDeviationService:\n    \"\"\"Core logic to compute Mean Absolute Deviation (MAD).\"\"\"\n    def __init__(self, use_numpy: bool = DEFAULT_USE_NUMPY) -> None:\n        self._use_numpy = use_numpy\n        self._np = None\n        if use_numpy:\n            try:\n                import numpy as _np # type: ignore\n                self._np = _np\n            except ImportError:\n                # NumPy is optional, fall back to pure python if not available.\n                pass\n            except Exception:\n                # Catch other potential errors during numpy import.\n                pass\n\n    def compute(self, numbers: List[float]) -> float:\n        \"\"\"Computes MAD for a list of floats, using NumPy if available and enabled.\"\"\"\n        if not numbers: # Defensive check, InputValidator should catch this first.\n            raise InvalidInputError(\"Input list is empty\")\n        try:\n            if self._use_numpy and self._np is not None:\n                return self._compute_numpy(numbers)\n            return self._compute_pure_python(numbers)\n        except InvalidInputError:\n            raise\n        except Exception as exc:\n            raise ComputationError(f\"Error during MAD computation: {exc}\")\n\n    def _compute_pure_python(self, numbers: List[float]) -> float:\n        \"\"\"Pure Python implementation of MAD calculation.\"\"\"\n        n = len(numbers)\n        mean = sum(numbers) / n\n        total_abs_dev = 0.0\n        for x in numbers:\n            total_abs_dev += abs(x - mean)\n        return total_abs_dev / n\n\n    def _compute_numpy(self, numbers: List[float]) -> float:\n        \"\"\"NumPy-optimized implementation of MAD calculation.\"\"\"\n        # self._np is guaranteed to be not None by the caller compute().\n        arr = self._np.array(numbers, dtype=float) # type: ignore\n        mean = arr.mean()\n        return float(self._np.abs(arr - mean).mean()) # type: ignore\n\n\ndef mean_absolute_deviation(numbers: List[float]) -> float:\n    \"\"\" For a given list of input numbers, calculate Mean Absolute Deviation\n    around the mean of this dataset.\n    Mean Absolute Deviation is the average absolute difference between each\n    element and a centerpoint (mean in this case):\n    MAD = average | x - x_mean |\n    >>> mean_absolute_deviation([1.0, 2.0, 3.0, 4.0])\n    1.0\n    \"\"\"\n    validator = InputValidator()\n    normalized = validator.validate(numbers)\n    svc = MeanAbsoluteDeviationService()\n    return svc.compute(normalized)"}
{"task_id": "HumanEval/12", "solution": "def longest(strings: List[str]) -> Optional[str]:\n    \"\"\" Out of list of strings, return the longest one. Return the first one in case of multiple\n    strings of the same length. Return None in case the input list is empty.\n    >>> longest([])\n\n    >>> longest(['a', 'b', 'c'])\n    'a'\n    >>> longest(['a', 'bb', 'ccc'])\n    'ccc'\n    \"\"\"\n    if not strings:\n        return None\n\n    longest_string: Optional[str] = strings[0]\n    max_len = len(strings[0])\n\n    for s in strings[1:]:\n        current_len = len(s)\n        if current_len > max_len:\n            max_len = current_len\n            longest_string = s\n\n    return longest_string"}
{"task_id": "HumanEval/8", "solution": "def sum_product(numbers: List[int]) -> Tuple[int, int]:\n    \"\"\" For a given list of integers, return a tuple consisting of a sum and a product of all the integers in a list.\n    Empty sum should be equal to 0 and empty product should be equal to 1.\n    >>> sum_product([])\n    (0, 1)\n    >>> sum_product([1, 2, 3, 4])\n    (10, 24)\n    \"\"\"\n    total_sum = 0\n    total_product = 1\n\n    for num in numbers:\n        total_sum += num\n        total_product *= num\n\n    return total_sum, total_product"}
{"task_id": "HumanEval/11", "solution": "def string_xor(a: str, b: str) -> str:\n    \"\"\" Input are two strings a and b consisting only of 1s and 0s.\n    Perform binary XOR on these inputs and return result also as a string.\n    >>> string_xor('010', '110')\n    '100'\n    \"\"\"\n    def xor_bits(bit_a: str, bit_b: str) -> str:\n        return \"1\" if bit_a != bit_b else \"0\"\n\n    def lpad(value: str, length: int, pad_char: str = \"0\") -> str:\n        return value.rjust(length, pad_char)\n\n    max_len = max(len(a), len(b))\n    padded_a = lpad(a, max_len)\n    padded_b = lpad(b, max_len)\n\n    result_chars = []\n    for char_a, char_b in zip(padded_a, padded_b):\n        result_chars.append(xor_bits(char_a, char_b))\n\n    return \"\".join(result_chars)"}
{"task_id": "HumanEval/9", "solution": "def rolling_max(numbers: List[int]) -> List[int]:\n    \"\"\" From a given list of integers, generate a list of rolling maximum element found until given moment\n    in the sequence.\n    >>> rolling_max([1, 2, 3, 2, 3, 4, 2])\n    [1, 2, 3, 3, 3, 4, 4]\n    \"\"\"\n    result: List[int] = []\n    current_max: Optional[int] = None\n    for x in numbers:\n        if current_max is None or x > current_max:\n            current_max = x\n        result.append(current_max)\n    return result"}
{"task_id": "HumanEval/14", "solution": "```python\ndef all_prefixes(string: str) -> List[str]:\n    \"\"\" Return list of all prefixes from shortest to longest of the input string\n    >>> all_prefixes('abc')\n    ['a', 'ab', 'abc']\n    \"\"\"\n    return [string[:i] for i in range(1, len(string) + 1)]\n```"}
{"task_id": "HumanEval/10", "solution": "def make_palindrome(string: str) -> str:\n    \"\"\" Find the shortest palindrome that begins with a supplied string.\n    Algorithm idea is simple:\n    - Find the longest postfix of supplied string that is a palindrome.\n    - Append to the end of the string reverse of a string prefix that comes before the palindromic suffix.\n    >>> make_palindrome('')\n    ''\n    >>> make_palindrome('cat')\n    'catac'\n    >>> make_palindrome('cata')\n    'catac'\n    \"\"\"\n    n = len(string)\n    for i in range(n):\n        suffix = string[i:]\n        # Use the provided is_palindrome helper function\n        if suffix == suffix[::-1]:\n            prefix_to_reverse = string[:i]\n            return string + prefix_to_reverse[::-1]\n    \n    # This line is reached only if the input string is empty (n=0),\n    # as any non-empty string will have at least its last character as a palindrome,\n    # ensuring the loop finds a suffix and returns.\n    return string"}
{"task_id": "HumanEval/13", "solution": "def greatest_common_divisor(a: int, b: int) -> int:\n    \"\"\" Return a greatest common divisor of two integers a and b\n    >>> greatest_common_divisor(3, 5)\n    1\n    >>> greatest_common_divisor(25, 15)\n    5\n    \"\"\"\n    a, b = abs(a), abs(b)\n    while b != 0:\n        a, b = b, a % b\n    return a"}
{"task_id": "HumanEval/15", "solution": "def string_sequence(n: int) -> str:\n    \"\"\" Return a string containing space-delimited numbers starting from 0 upto n inclusive.\n    \"\"\"\n\n    class ValidationError(Exception):\n        \"\"\"Exception raised for invalid input.\"\"\"\n        pass\n\n    class SequenceValidator:\n        \"\"\"Validates and coerces inputs, enforcing business rules.\"\"\"\n        def __init__(self, max_n: int = 1_000_000):\n            self._max_n = max_n\n\n        def validate_n(self, n_raw) -> int:\n            \"\"\"Ensure n_raw is an integer-like value, convert if str, and ensure 0 <= n <= max_n.\"\"\"\n            try:\n                n_val = int(n_raw)\n            except (ValueError, TypeError):\n                raise ValidationError(f\"n must be an integer, got {n_raw!r}\")\n            if n_val < 0:\n                raise ValidationError(\"n must be >= 0\")\n            if n_val > self._max_n:\n                raise ValidationError(f\"n exceeds max allowed ({self._max_n})\")\n            return n_val\n\n    class SequenceFormatter:\n        \"\"\"Formats integer ranges into a space-delimited string.\"\"\"\n        def format_range(self, n_val: int) -> str:\n            \"\"\"Produces \"0 1 ... n\" from an integer n_val.\"\"\"\n            return \" \".join(map(str, range(n_val + 1)))\n\n    class SequenceService:\n        \"\"\"Orchestrates validation and formatting to generate sequences.\"\"\"\n        def __init__(self, validator: SequenceValidator, formatter: SequenceFormatter, repository=None, max_n: int = 1_000_000):\n            self._validator = validator\n            self._formatter = formatter\n            self._repository = repository\n            self._max_n = max_n\n\n        def generate_sequence(self, n_raw, persist: bool = False) -> str:\n            \"\"\"Validates n_raw, formats the sequence, and returns it.\"\"\"\n            n_validated = self._validator.validate_n(n_raw)\n            sequence = self._formatter.format_range(n_validated)\n            return sequence\n\n    validator = SequenceValidator()\n    formatter = SequenceFormatter()\n    service = SequenceService(validator, formatter)\n    return service.generate_sequence(n, persist=False)"}
{"task_id": "HumanEval/16", "solution": "import unicodedata\n\ndef count_distinct_characters(string: str) -> int:\n    \"\"\" Given a string, find out how many distinct characters (regardless of case) does it consist of\n    >>> count_distinct_characters('xyzXYZ')\n    3\n    >>> count_distinct_characters('Jerry')\n    4\n    \"\"\"\n    # Normalize the string to a canonical form (NFKC) for consistent comparison of Unicode characters.\n    normalized_string = unicodedata.normalize('NFKC', string)\n    # Convert the normalized string to its casefolded form to handle case-insensitivity robustly across Unicode.\n    casefolded_string = normalized_string.casefold()\n    \n    # Use a set to store unique characters from the processed string.\n    distinct_chars = set()\n    for char in casefolded_string:\n        distinct_chars.add(char)\n        \n    return len(distinct_chars)"}
{"task_id": "HumanEval/20", "solution": "def find_closest_elements(numbers: List[float]) -> Tuple[float, float]:\n    \"\"\" From a supplied list of numbers (of length at least two) select and return two that are the closest to each\n    other and return them in order (smaller number, larger number).\n    \"\"\"\n    nums = sorted(numbers)\n\n    # Initialize with the first pair\n    best_a, best_b = nums[0], nums[1]\n    best_diff = abs(best_b - best_a)\n\n    # Iterate through adjacent pairs to find the minimum difference\n    for i in range(1, len(nums)):\n        prev, curr = nums[i - 1], nums[i]\n        diff = abs(curr - prev)\n        if diff < best_diff:\n            best_diff = diff\n            best_a, best_b = prev, curr\n        # Optimization: if current difference is 0, we can't get closer\n        if best_diff == 0:\n            break\n\n    return (best_a, best_b)"}
{"task_id": "HumanEval/18", "solution": "def how_many_times(string: str, substring: str) -> int:\n    \"\"\" Find how many times a given substring can be found in the original string. Count overlaping cases.\n    >>> how_many_times('', 'a')\n    0\n    >>> how_many_times('aaa', 'a')\n    3\n    >>> how_many_times('aaaa', 'aa')\n    3\n    \"\"\"\n    if not substring:\n        return 0\n    count = 0\n    start_index = 0\n    while True:\n        start_index = string.find(substring, start_index)\n        if start_index == -1:\n            break\n        count += 1\n        start_index += 1\n    return count"}
{"task_id": "HumanEval/17", "solution": "from typing import List\nimport json\nimport uuid\nimport datetime\nimport os\n\nTOKEN_MAP = {\"o\": 4, \"o|\": 2, \".|\": 1}\n\nclass ParseError(Exception):\n    \"\"\"Custom exception for errors during music string parsing.\"\"\"\n    def __init__(self, token: str, message: str):\n        super().__init__(message)\n        self.token = token\n        self.message = message\n\nclass StorageError(Exception):\n    \"\"\"Custom exception for errors during history persistence.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\n\nclass ParseResult:\n    \"\"\"Data transfer object for a parsed music string and its beat duration.\"\"\"\n    def __init__(self, id: str, timestamp: str, input_str: str, beats: List[int]):\n        self.id = id\n        self.timestamp = timestamp\n        self.input_str = input_str\n        self.beats = beats\n\n    def to_dict(self) -> dict:\n        return {\n            \"id\": self.id,\n            \"timestamp\": self.timestamp,\n            \"input_str\": self.input_str,\n            \"beats\": self.beats\n        }\n\ndef tokenize(music_string: str) -> List[str]:\n    \"\"\"Splits a music string by whitespace and filters out empty tokens.\"\"\"\n    return [token.strip() for token in music_string.split() if token.strip()]\n\nclass Parser:\n    \"\"\"Parses musical tokens into their corresponding beat durations.\"\"\"\n    def __init__(self, token_map: dict = None):\n        self.token_map = token_map if token_map is not None else TOKEN_MAP\n\n    def parse(self, music_string: str) -> List[int]:\n        tokens = tokenize(music_string)\n        beats = []\n        for t in tokens:\n            beats.append(self._map_token(t))\n        return beats\n\n    def _map_token(self, token: str) -> int:\n        if token not in self.token_map:\n            raise ParseError(token, f\"Unknown token: '{token}'\")\n        return self.token_map[token]\n\nclass JSONFileRepository:\n    \"\"\"Persists and retrieves parse results from a JSON lines file.\"\"\"\n    def __init__(self, path: str):\n        self.path = path\n\n    def save(self, result: ParseResult) -> None:\n        \"\"\"Appends a ParseResult as a JSON line to the history file.\"\"\"\n        try:\n            # Ensure directory exists if path includes directories.\n            dirname = os.path.dirname(self.path)\n            if dirname:\n                os.makedirs(dirname, exist_ok=True)\n            with open(self.path, \"a\", encoding=\"utf-8\") as f:\n                f.write(json.dumps(result.to_dict(), ensure_ascii=False) + \"\\n\")\n        except OSError as e:\n            raise StorageError(f\"Failed to save to history file '{self.path}': {e}\")\n\n    def list(self, limit: int = 100) -> List[ParseResult]:\n        \"\"\"Reads the last N ParseResults from the history file.\"\"\"\n        results: List[ParseResult] = []\n        if not os.path.exists(self.path):\n            return results\n        try:\n            with open(self.path, \"r\", encoding=\"utf-8\") as f:\n                lines = f.readlines()\n                # Read from the end to get the most recent entries, then reverse to original order.\n                for line in reversed(lines[-limit:]):\n                    data = json.loads(line)\n                    results.insert(0, ParseResult(**data))\n        except (OSError, json.JSONDecodeError):\n            # As per NFR3, storage errors are best-effort, so we log (implicitly) and continue.\n            pass\n        return results\n\nclass MusicService:\n    \"\"\"Orchestrates parsing and optional persistence of music strings.\"\"\"\n    def __init__(self, parser: Parser, repo: JSONFileRepository | None = None):\n        self.parser = parser\n        self.repo = repo\n\n    def parse(self, music_string: str, record: bool = True) -> List[int]:\n        \"\"\"Parses a music string into beats and optionally records the result.\"\"\"\n        try:\n            beats = self.parser.parse(music_string)\n        except ParseError as e:\n            # Propagate ParseError as ValueError in the public API.\n            raise ValueError(str(e)) from e\n\n        if record and self.repo:\n            result = ParseResult(\n                id=str(uuid.uuid4()),\n                timestamp=datetime.datetime.utcnow().isoformat(timespec='seconds') + \"Z\",\n                input_str=music_string,\n                beats=beats\n            )\n            try:\n                self.repo.save(result)\n            except StorageError:\n                # NFR3: History persistence is best-effort; log and continue.\n                pass # In a real system, logging would occur here.\n        return beats\n\ndef parse_music(music_string: str) -> List[int]:\n    \"\"\" Input to this function is a string representing musical notes in a special ASCII format.\n    Your task is to parse this string and return list of integers corresponding to how many beats does each\n    not last.\n\n    Here is a legend:\n    'o' - whole note, lasts four beats\n    'o|' - half note, lasts two beats\n    '.|' - quater note, lasts one beat\n\n    >>> parse_music('o o| .| o| o| .| .| .| .| o o')\n    [4, 2, 1, 2, 2, 1, 1, 1, 1, 4, 4]\n    \"\"\"\n    # This function acts as a convenience wrapper, instantiating the necessary components.\n    # It defaults to not recording parse history to file when used as a library.\n    parser = Parser()\n    # \"history.jsonl\" is the default path for the JSON file repository.\n    repo = JSONFileRepository(\"history.jsonl\")\n    svc = MusicService(parser, repo)\n    return svc.parse(music_string, record=False)"}
{"task_id": "HumanEval/19", "solution": "from typing import List\n\nclass SorterError(Exception):\n    \"\"\"Domain-specific error for sorting issues.\"\"\"\n    def __init__(self, message: str, invalid_tokens: List[str] = None):\n        super().__init__(message)\n        self.message = message\n        self.invalid_tokens = invalid_tokens or []\n\n    def __str__(self) -> str:\n        if self.invalid_tokens:\n            return f\"{self.message}: invalid tokens={self.invalid_tokens}\"\n        return self.message\n\nclass NumeralMapper:\n    \"\"\"Provides canonical mapping between spelled numerals and integer values.\"\"\"\n    DEFAULT_MAPPING = {\n        \"zero\": 0, \"one\": 1, \"two\": 2, \"three\": 3, \"four\": 4,\n        \"five\": 5, \"six\": 6, \"seven\": 7, \"eight\": 8, \"nine\": 9,\n    }\n    ALLOWED_TOKENS = DEFAULT_MAPPING\n    TOKEN_BY_VALUE = {v: k for k, v in DEFAULT_MAPPING.items()}\n\n    def to_value(self, token: str) -> int:\n        \"\"\"Returns integer value for a numeral token (case-insensitive).\"\"\"\n        return self.ALLOWED_TOKENS[token.lower()]\n\n    def to_token(self, value: int) -> str:\n        \"\"\"Returns canonical numeral token for a numeric value.\"\"\"\n        return self.TOKEN_BY_VALUE[value]\n\n    def is_valid(self, token: str) -> bool:\n        \"\"\"Checks if a token is a valid numeral.\"\"\"\n        return token.lower() in self.ALLOWED_TOKENS\n\ndef tokenize(input_str: str) -> List[str]:\n    \"\"\"Splits input string by whitespace into a list of tokens.\"\"\"\n    return [t for t in input_str.split()]\n\ndef normalize_token(token: str) -> str:\n    \"\"\"Normalizes a token by stripping whitespace and converting to lower-case.\"\"\"\n    return token.strip().lower()\n\nclass ParserAdapter:\n    \"\"\"Converts a free-form input string into a list of normalized tokens.\"\"\"\n    def parse(self, input_str: str) -> List[str]:\n        \"\"\"Tokenizes and normalizes the input string.\"\"\"\n        return [normalize_token(t) for t in tokenize(input_str)]\n\nclass FormatterAdapter:\n    \"\"\"Converts a list of tokens back into a single, space-delimited string.\"\"\"\n    def format(self, tokens: List[str]) -> str:\n        \"\"\"Joins tokens with a single space.\"\"\"\n        return \" \".join(t.lower() for t in tokens) if tokens else \"\"\n\nclass SorterService:\n    \"\"\"Handles core sorting logic: validation, mapping, and sorting.\"\"\"\n    def __init__(self, mapper: NumeralMapper):\n        self.mapper = mapper\n\n    def validate_tokens(self, tokens: List[str]) -> None:\n        \"\"\"Ensures all tokens are valid numerals, raising SorterError if not.\"\"\"\n        invalid = [t for t in tokens if not self.mapper.is_valid(t)]\n        if invalid:\n            raise SorterError(\"Invalid tokens provided\", invalid_tokens=invalid)\n\n    def sort_tokens(self, tokens: List[str]) -> List[str]:\n        \"\"\"Sorts a list of numeral tokens by their numeric value.\"\"\"\n        mapped = [(self.mapper.to_value(t), t) for t in tokens]\n        mapped.sort(key=lambda x: x[0]) # Sorts by numeric value\n        return [self.mapper.to_token(v) for v, _ in mapped]\n\n    def sort_string(self, input_str: str, parser: ParserAdapter, formatter: FormatterAdapter) -> str:\n        \"\"\"Parses, validates, sorts, and formats a numeral string.\"\"\"\n        tokens = parser.parse(input_str)\n        if not tokens:\n            return \"\"\n        self.validate_tokens(tokens)\n        sorted_tokens = self.sort_tokens(tokens)\n        return formatter.format(sorted_tokens)\n\n_mapper = NumeralMapper()\n_service = SorterService(_mapper)\n_parser = ParserAdapter()\n_formatter = FormatterAdapter()\n\ndef sort_numbers(numbers: str) -> str:\n    \"\"\" Input is a space-delimited string of numberals from 'zero' to 'nine'.\n    Valid choices are 'zero', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight' and 'nine'.\n    Return the string with numbers sorted from smallest to largest\n    >>> sort_numbers('three one five')\n    'one three five'\n    \"\"\"\n    return _service.sort_string(numbers, _parser, _formatter)"}
