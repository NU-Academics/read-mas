{"task_id": "HumanEval/36", "solution": "import collections\nfrom typing import List, Optional, Iterable, Iterator\n\nclass Config:\n    \"\"\"Centralized immutable configuration for divisors and target digit.\"\"\"\n    def __init__(self, divisors: List[int] = [11, 13], target_digit: str = \"7\") -> None:\n        self.divisors = divisors\n        self.target_digit = target_digit\n\nclass ResultRepository:\n    \"\"\"Simple LRU in-memory cache to store computed results.\"\"\"\n    def __init__(self, maxsize: int = 128) -> None:\n        self._maxsize = maxsize\n        self._cache = collections.OrderedDict()\n\n    def get(self, n: int) -> Optional[int]:\n        val = self._cache.get(n)\n        if val is not None:\n            self._cache.move_to_end(n)\n        return val\n\n    def set(self, n: int, value: int) -> None:\n        self._cache[n] = value\n        self._cache.move_to_end(n)\n        if len(self._cache) > self._maxsize:\n            self._cache.popitem(last=False)\n\nclass DividerFilter:\n    \"\"\"Provides an iterator of integers < n divisible by any configured divisors.\"\"\"\n    def __init__(self, divisors: List[int]) -> None:\n        self._divisors = list(divisors)\n\n    def filter_up_to(self, n: int) -> Iterator[int]:\n        # Yields integers x such that 0 <= x < n and divisible by any of _divisors.\n        for x in range(0, n):\n            for d in self._divisors:\n                if d == 0:\n                    continue\n                if x % d == 0:\n                    yield x\n                    break\n\nclass DigitCounter:\n    \"\"\"Counts occurrences of a given digit in integers or iterables.\"\"\"\n    def __init__(self, target_digit: str = \"7\") -> None:\n        self._target = target_digit\n\n    def count_in_number(self, x: int) -> int:\n        # Returns occurrences of target_digit in decimal representation of abs(x).\n        return str(abs(x)).count(self._target)\n\n    def count_in_iterable(self, items: Iterable[int]) -> int:\n        # Sums count_in_number for each item in the iterable.\n        total = 0\n        for v in items:\n            total += self.count_in_number(v)\n        return total\n\nclass FizzBuzzService:\n    \"\"\"Core application logic: orchestrate filter and counter, use repository.\"\"\"\n    def __init__(self, repo: Optional[ResultRepository], config: Config) -> None:\n        self.repo = repo\n        self.config = config\n        self.filter = DividerFilter(config.divisors)\n        self.counter = DigitCounter(config.target_digit)\n\n    def compute(self, n: int) -> int:\n        # Computes the count, checking cache and storing result.\n        if self.repo:\n            cached = self.repo.get(n)\n            if cached is not None:\n                return cached\n        \n        iterator = self.filter.filter_up_to(n)\n        total = self.counter.count_in_iterable(iterator)\n        \n        if self.repo:\n            self.repo.set(n, total)\n        return total\n\ndef fizz_buzz(n: int):\n    \"\"\"Return the number of times the digit 7 appears in integers less than n which are divisible by 11 or 13.\n    >>> fizz_buzz(50)\n    0\n    >>> fizz_buzz(78)\n    2\n    >>> fizz_buzz(79)\n    3\n    \"\"\"\n    # Instantiate default configuration and repository for the public API.\n    config = Config()\n    repo = ResultRepository(maxsize=128)\n    \n    # Create the service with configured dependencies.\n    svc = FizzBuzzService(repo=repo, config=config)\n    \n    # Delegate the computation to the service.\n    return svc.compute(n)"}
{"task_id": "HumanEval/42", "solution": "def incr_list(l: list):\n    \"\"\"Return list with elements incremented by 1.\n    >>> incr_list([1, 2, 3])\n    [2, 3, 4]\n    >>> incr_list([5, 3, 5, 2, 3, 3, 9, 0, 123])\n    [6, 4, 6, 3, 4, 4, 10, 1, 124]\n    \"\"\"\n    return [x + 1 for x in l]"}
{"task_id": "HumanEval/43", "solution": "def pairs_sum_to_zero(l):\n    \"\"\"\n    pairs_sum_to_zero takes a list of integers as an input.\n    it returns True if there are two distinct elements in the list that\n    sum to zero, and False otherwise.\n    >>> pairs_sum_to_zero([1, 3, 5, 0])\n    False\n    >>> pairs_sum_to_zero([1, 3, -2, 1])\n    False\n    >>> pairs_sum_to_zero([1, 2, 3, 7])\n    False\n    >>> pairs_sum_to_zero([2, 4, -5, 3, 5, 7])\n    True\n    >>> pairs_sum_to_zero([1])\n    False\n    \"\"\"\n    seen_numbers = set()\n    zero_count = 0\n\n    for x in l:\n        if x == 0:\n            zero_count += 1\n            if zero_count >= 2:\n                return True\n        elif -x in seen_numbers:\n            return True\n        seen_numbers.add(x)\n\n    return False"}
{"task_id": "HumanEval/44", "solution": "def change_base(x: int, base: int):\n    \"\"\"Change numerical base of input number x to base.\n    return string representation after the conversion.\n    base numbers are less than 10.\n    \"\"\"\n    if x == 0:\n        return \"0\"\n\n    digits = []\n    current_x = x\n    while current_x > 0:\n        remainder = current_x % base\n        digits.append(str(remainder))\n        current_x //= base\n\n    digits.reverse()\n    return \"\".join(digits)"}
{"task_id": "HumanEval/45", "solution": "def triangle_area(a, h):\n    \"\"\"Given length of a side and high return area for a triangle.\n    >>> triangle_area(5, 3)\n    7.5\n    \"\"\"\n    return (a * h) / 2.0"}
{"task_id": "HumanEval/46", "solution": "def fib4(n: int):\n    \"\"\"The Fib4 number sequence is a sequence similar to the Fibbonacci sequnece that's defined as follows:\n    fib4(0) -> 0\n    fib4(1) -> 0\n    fib4(2) -> 2\n    fib4(3) -> 0\n    fib4(n) -> fib4(n-1) + fib4(n-2) + fib4(n-3) + fib4(n-4).\n    This function efficiently computes the n-th element of the fib4 number sequence iteratively.\n    \"\"\"\n    if n == 0:\n        return 0\n    elif n == 1:\n        return 0\n    elif n == 2:\n        return 2\n    elif n == 3:\n        return 0\n\n    # Initialize the first four terms\n    f0 = 0 # fib4(i-4)\n    f1 = 0 # fib4(i-3)\n    f2 = 2 # fib4(i-2)\n    f3 = 0 # fib4(i-1)\n\n    # Compute terms iteratively starting from n=4\n    for _ in range(4, n + 1):\n        next_fib = f0 + f1 + f2 + f3\n        f0 = f1\n        f1 = f2\n        f2 = f3\n        f3 = next_fib\n    \n    return f3"}
{"task_id": "HumanEval/49", "solution": "def modp(n: int, p: int):\n    \"\"\"Return 2^n modulo p (be aware of numerics).\n    This function uses Python's built-in modular exponentiation for efficiency and correctness.\n    \"\"\"\n    return pow(2, n, p)"}
{"task_id": "HumanEval/48", "solution": "def is_palindrome(text: str):\n    \"\"\"\n    Checks if given string is a palindrome after normalizing it.\n    \"\"\"\n    normalized_text = ''.join(char for char in text.casefold() if char.isalnum())\n    return normalized_text == normalized_text[::-1]"}
{"task_id": "HumanEval/47", "solution": "def median(l: list):\n    \"\"\"Return median of elements in the list l.\n    >>> median([3, 1, 2, 4, 5])\n    3\n    >>> median([-10, 4, 6, 1000, 10, 20])\n    15.0\n    \"\"\"\n    # The function assumes 'l' is a non-empty list of numeric values;\n    # validation and error handling are handled upstream per design context.\n    \n    sorted_l = sorted(l)\n    n = len(sorted_l)\n\n    if n % 2 == 1:\n        # Odd number of elements: median is the middle element.\n        result = float(sorted_l[n // 2])\n    else:\n        # Even number of elements: median is the average of the two middle elements.\n        mid1 = sorted_l[n // 2 - 1]\n        mid2 = sorted_l[n // 2]\n        result = (mid1 + mid2) / 2.0\n    \n    # Return an integer if the result is an exact integer, otherwise return a float.\n    if result == int(result):\n        return int(result)\n    else:\n        return result"}
{"task_id": "HumanEval/50", "solution": "def decode_shift(s: str):\n    \"\"\"\n    takes as input string encoded with encode_shift function. Returns decoded string.\n    \"\"\"\n    return \"\".join([chr(((ord(ch) - 5 - ord(\"a\")) % 26) + ord(\"a\")) for ch in s])"}
{"task_id": "HumanEval/51", "solution": "def remove_vowels(text):\n    \"\"\"\n    remove_vowels is a function that takes string and returns string without vowels.\n    >>> remove_vowels('')\n    ''\n    >>> remove_vowels(\"abcdef\\nghijklm\")\n    'bcdf\\nghjklm'\n    >>> remove_vowels('abcdef')\n    'bcdf'\n    >>> remove_vowels('aaaaa')\n    ''\n    >>> remove_vowels('aaBAA')\n    'B'\n    >>> remove_vowels('zbcd')\n    'zbcd'\n    \"\"\"\n    vowels = frozenset({'a', 'e', 'i', 'o', 'u', 'A', 'E', 'I', 'O', 'U'})\n    return ''.join(char for char in text if char not in vowels)"}
