{"task_id": "HumanEval/39", "solution": "def prime_fib(n: int):\n    \"\"\"\n    prime_fib returns n-th number that is a Fibonacci number and it's also prime.\n    >>> prime_fib(1)\n    2\n    >>> prime_fib(2)\n    3\n    >>> prime_fib(3)\n    5\n    >>> prime_fib(4)\n    13\n    >>> prime_fib(5)\n    89\n    \"\"\"\n    class InvalidInputError(ValueError):\n        \"\"\"Custom exception for invalid input values.\"\"\"\n        pass\n\n    class FibonacciGenerator:\n        \"\"\"Generates an infinite sequence of Fibonacci numbers starting from 2.\"\"\"\n        def __init__(self):\n            self._current_fib = 2\n            self._next_fib = 3\n\n        def generate_sequence(self):\n            yield self._current_fib\n            yield self._next_fib\n            while True:\n                next_val = self._current_fib + self._next_fib\n                self._current_fib = self._next_fib\n                self._next_fib = next_val\n                yield next_val\n\n    class PrimeChecker:\n        \"\"\"Determines if a given integer is a prime number.\"\"\"\n        def is_prime(self, num: int) -> bool:\n            if num < 2:\n                return False\n            if num == 2:\n                return True\n            if num % 2 == 0:\n                return False\n            i = 3\n            while i * i <= num:\n                if num % i == 0:\n                    return False\n                i += 2\n            return True\n\n    if n < 1:\n        raise InvalidInputError(\"Input 'n' must be a positive integer (n >= 1).\")\n\n    fib_generator = FibonacciGenerator()\n    prime_checker = PrimeChecker()\n    prime_fib_count = 0\n\n    for fib_num in fib_generator.generate_sequence():\n        if prime_checker.is_prime(fib_num):\n            prime_fib_count += 1\n            if prime_fib_count == n:\n                return fib_num"}
{"task_id": "HumanEval/37", "solution": "def sort_even(l: list):\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the odd indicies, while its values at the even indicies are equal\n    to the values of the even indicies of l, but sorted.\n    >>> sort_even([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_even([5, 6, 3, 4])\n    [3, 6, 5, 4]\n    \"\"\"\n    if not l:\n        return []\n\n    even_elements = [l[i] for i in range(0, len(l), 2)]\n    even_elements.sort()\n\n    result = l[:]  # Create a shallow copy to preserve odd indices and original list\n    even_idx_counter = 0\n    for i in range(0, len(l), 2):\n        result[i] = even_elements[even_idx_counter]\n        even_idx_counter += 1\n    \n    return result"}
