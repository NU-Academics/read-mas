{"task_id": "HumanEval/46", "solution": "def fib4(n: int):\n    \"\"\"Computes the n-th element of the fib4 number sequence efficiently without recursion.\"\"\"\n    if n == 0:\n        return 0\n    elif n == 1:\n        return 0\n    elif n == 2:\n        return 2\n    elif n == 3:\n        return 0\n\n    # Initialize variables for fib4(i-4), fib4(i-3), fib4(i-2), fib4(i-1)\n    a, b, c, d = 0, 0, 2, 0 \n\n    for _ in range(4, n + 1):\n        next_fib4 = a + b + c + d\n        a = b\n        b = c\n        c = d\n        d = next_fib4\n\n    return d"}
{"task_id": "HumanEval/50", "solution": "def _shift_char(char: str, shift_amount: int) -> str:\n    \"\"\"\n    Shifts a single lowercase English alphabet character by a given amount.\n    Handles wrap-around from 'a' to 'z' and 'z' to 'a'.\n    Non-lowercase English alphabet characters are returned unchanged.\n    \"\"\"\n    if 'a' <= char <= 'z':\n        start_ord = ord('a')\n        shifted_ord = (ord(char) - start_ord + shift_amount) % 26 + start_ord\n        return chr(shifted_ord)\n    return char\n\ndef decode_shift(s: str):\n    \"\"\"\n    takes as input string encoded with encode_shift function. Returns decoded string.\n    \"\"\"\n    return \"\".join([_shift_char(ch, -5) for ch in s])"}
