{"task_id": "HumanEval/104", "solution": "def _has_even_digit(n):\n    \"\"\"Checks if a positive integer contains any even digits.\"\"\"\n    s = str(n)\n    for digit_char in s:\n        digit = int(digit_char)\n        if digit % 2 == 0:\n            return True\n    return False\n\ndef unique_digits(x):\n    \"\"\"Given a list of positive integers x. return a sorted list of all \n    elements that hasn't any even digit.\n    \"\"\"\n    result = []\n    for num in x:\n        if not _has_even_digit(num):\n            result.append(num)\n    \n    result.sort()\n    return result"}
{"task_id": "HumanEval/106", "solution": "def _calculate_factorial(num: int) -> int:\n    \"\"\"Calculates the factorial of a given positive integer (1 * 2 * ... * num).\"\"\"\n    if num == 0:\n        return 1\n    factorial = 1\n    for j in range(1, num + 1):\n        factorial *= j\n    return factorial\n\ndef _calculate_summation(num: int) -> int:\n    \"\"\"Calculates the sum of numbers from 1 to a given positive integer (1 + 2 + ... + num).\"\"\"\n    sum_val = 0\n    for j in range(1, num + 1):\n        sum_val += j\n    return sum_val\n\ndef f(n):\n    \"\"\" Implement the function f that takes n as a parameter,\n    and returns a list of size n, such that the value of the element at index i is the factorial of i if i is even\n    or the sum of numbers from 1 to i otherwise.\n    i starts from 1.\n    the factorial of i is the multiplication of the numbers from 1 to i (1 * 2 * ... * i).\n    Example:\n    f(5) == [1, 2, 6, 24, 15]\n    \"\"\"\n    result_list = []\n    for i in range(1, n + 1):\n        if i % 2 == 0:  # i is even\n            result_list.append(_calculate_factorial(i))\n        else:  # i is odd\n            result_list.append(_calculate_summation(i))\n    return result_list"}
{"task_id": "HumanEval/105", "solution": "_DIGIT_NAMES = {\n    1: \"One\", 2: \"Two\", 3: \"Three\", 4: \"Four\", 5: \"Five\",\n    6: \"Six\", 7: \"Seven\", 8: \"Eight\", 9: \"Nine\"\n}\n\ndef by_length(arr):\n    \"\"\"\n    Given an array of integers, sort the integers that are between 1 and 9 inclusive,\n    reverse the resulting array, and then replace each digit by its corresponding name from\n    \"One\", \"Two\", \"Three\", \"Four\", \"Five\", \"Six\", \"Seven\", \"Eight\", \"Nine\".\n\n    For example:\n      arr = [2, 1, 1, 4, 5, 8, 2, 3]   \n            -> sort arr -> [1, 1, 2, 2, 3, 4, 5, 8] \n            -> reverse arr -> [8, 5, 4, 3, 2, 2, 1, 1]\n      return [\"Eight\", \"Five\", \"Four\", \"Three\", \"Two\", \"Two\", \"One\", \"One\"]\n    \n      If the array is empty, return an empty array:\n      arr = []\n      return []\n    \n      If the array has any strange number ignore it:\n      arr = [1, -1 , 55] \n            -> sort arr -> [-1, 1, 55]\n            -> reverse arr -> [55, 1, -1]\n      return = ['One']\n    \"\"\"\n    if not arr:\n        return []\n\n    # Filter for numbers between 1 and 9 inclusive.\n    filtered_digits = [num for num in arr if 1 <= num <= 9]\n\n    # Sort the filtered digits in ascending order.\n    filtered_digits.sort()\n\n    # Reverse the sorted digits.\n    filtered_digits.reverse()\n\n    # Replace each digit with its corresponding word name.\n    result_names = [_DIGIT_NAMES[num] for num in filtered_digits]\n\n    return result_names"}
{"task_id": "HumanEval/107", "solution": "def _is_palindrome(num: int) -> bool:\n    \"\"\"Checks if a number is a palindrome.\"\"\"\n    return str(num) == str(num)[::-1]\n\ndef _validate_input(n: int) -> None:\n    \"\"\"Validates the input n against the range [1, 1000].\"\"\"\n    if not (1 <= n <= 1000):\n        raise ValueError(\"Input n must be between 1 and 1000, inclusive.\")\n\ndef even_odd_palindrome(n):\n    \"\"\"\n    Given a positive integer n, return a tuple that has the number of even and odd\n    integer palindromes that fall within the range(1, n), inclusive.\n    \"\"\"\n    _validate_input(n)\n\n    even_count = 0\n    odd_count = 0\n\n    for i in range(1, n + 1):\n        if _is_palindrome(i):\n            if i % 2 == 0:\n                even_count += 1\n            else:\n                odd_count += 1\n\n    return (even_count, odd_count)"}
{"task_id": "HumanEval/108", "solution": "from typing import List\n\ndef _calculate_signed_digit_sum(num: int) -> int:\n    \"\"\"\n    Calculates the sum of digits for a single integer, treating the first digit of\n    negative numbers as negative and subsequent digits as positive.\n    \"\"\"\n    if num == 0:\n        return 0\n\n    s = str(num)\n    digit_sum = 0\n\n    if s[0] == '-':\n        digit_sum += int(s[1]) * -1\n        for digit_char in s[2:]:\n            digit_sum += int(digit_char)\n    else:\n        for digit_char in s:\n            digit_sum += int(digit_char)\n\n    return digit_sum\n\ndef count_nums(arr: List[int]) -> int:\n    \"\"\"\n    Counts the number of elements in an array of integers which has a sum of digits > 0.\n    For negative numbers, the first signed digit will be negative.\n    \"\"\"\n    if not arr:\n        return 0\n\n    count = 0\n    for num in arr:\n        current_sum = _calculate_signed_digit_sum(num)\n        if current_sum > 0:\n            count += 1\n\n    return count"}
{"task_id": "HumanEval/111", "solution": "import collections\n\ndef histogram(test):\n    \"\"\"Given a string representing a space separated lowercase letters, return a dictionary\n    of the letter with the most repetition and containing the corresponding count.\n    If several letters have the same occurrence, return all of them.\n    \n    Example:\n    histogram('a b c') == {'a': 1, 'b': 1, 'c': 1}\n    histogram('a b b a') == {'a': 2, 'b': 2}\n    histogram('a b c a b') == {'a': 2, 'b': 2}\n    histogram('b b b b a') == {'b': 4}\n    histogram('') == {}\n\n    \"\"\"\n    if not test:\n        return {}\n\n    # Split the input string into individual letters, filtering out empty strings from multiple spaces.\n    letters = [char for char in test.split(' ') if char]\n\n    if not letters:\n        return {}\n\n    # Count the occurrences of each unique letter.\n    letter_counts = collections.Counter(letters)\n\n    # Find the maximum occurrence count among all letters.\n    max_occurrence = 0\n    if letter_counts:\n        max_occurrence = max(letter_counts.values())\n    \n    # Build the final dictionary containing only letters with the maximum occurrence count.\n    final_histogram = {\n        char: count for char, count in letter_counts.items() \n        if count == max_occurrence\n    }\n    \n    return final_histogram"}
{"task_id": "HumanEval/110", "solution": "def exchange(lst1, lst2):\n    \"\"\"In this problem, you will implement a function that takes two lists of numbers,\n    and determines whether it is possible to perform an exchange of elements\n    between them to make lst1 a list of only even numbers.\n    There is no limit on the number of exchanged elements between lst1 and lst2.\n    If it is possible to exchange elements between the lst1 and lst2 to make\n    all the elements of lst1 to be even, return \"YES\".\n    Otherwise, return \"NO\".\n    For example:\n    exchange([1, 2, 3, 4], [1, 2, 3, 4]) => \"YES\"\n    exchange([1, 2, 3, 4], [1, 5, 3, 4]) => \"NO\"\n    It is assumed that the input lists will be non-empty.\n    \"\"\"\n    # Count the number of odd integers in lst1 that need to be replaced.\n    odd_count_lst1 = sum(1 for num in lst1 if num % 2 != 0)\n\n    # Count the number of even integers available in lst2 for exchange.\n    even_count_lst2 = sum(1 for num in lst2 if num % 2 == 0)\n\n    # If there are enough even numbers in lst2 to replace all odd numbers in lst1, it's possible.\n    if odd_count_lst1 <= even_count_lst2:\n        return \"YES\"\n    else:\n        return \"NO\""}
{"task_id": "HumanEval/109", "solution": "def _is_sorted(arr):\n    \"\"\"Checks if an array is sorted in non-decreasing order.\"\"\"\n    if not arr or len(arr) == 1:\n        return True\n    for i in range(len(arr) - 1):\n        if arr[i] > arr[i+1]:\n            return False\n    return True\n\ndef _right_shift(arr):\n    \"\"\"Performs a single right shift operation on an array.\"\"\"\n    if not arr:\n        return []\n    return [arr[-1]] + arr[:-1]\n\ndef move_one_ball(arr):\n    \"\"\"We have an array 'arr' of N integers arr[1], arr[2], ..., arr[N].The\n    numbers in the array will be randomly ordered. Your task is to determine if\n    it is possible to get an array sorted in non-decreasing order by performing \n    the following operation on the given array:\n        You are allowed to perform right shift operation any number of times.\n    \n    One right shift operation means shifting all elements of the array by one\n    position in the right direction. The last element of the array will be moved to\n    the starting position in the array i.e. 0th index. \n\n    If it is possible to obtain the sorted array by performing the above operation\n    then return True else return False.\n    If the given array is empty then return True.\n\n    Note: The given list is guaranteed to have unique elements.\n\n    For Example:\n    \n    move_one_ball([3, 4, 5, 1, 2])==>True\n    Explanation: By performin 2 right shift operations, non-decreasing order can\n                 be achieved for the given array.\n    move_one_ball([3, 5, 4, 1, 2])==>False\n    Explanation:It is not possible to get non-decreasing order for the given\n                array by performing any number of right shift operations.\n                \n    \"\"\"\n    if not arr:\n        return True\n\n    n = len(arr)\n    current_arr = list(arr) \n\n    for _ in range(n): \n        if _is_sorted(current_arr):\n            return True\n        current_arr = _right_shift(current_arr)\n\n    return False"}
{"task_id": "HumanEval/112", "solution": "def reverse_delete(s,c):\n    \"\"\"\n    Deletes characters from s that are in c, then checks if the result is a palindrome.\n    Returns a tuple of the result string and a boolean indicating palindrome status.\n    \"\"\"\n\n    def _filter_string(s_to_filter, chars_to_remove_set):\n        \"\"\"Removes characters from s_to_filter that are present in chars_to_remove_set.\"\"\"\n        filtered_chars = [char for char in s_to_filter if char not in chars_to_remove_set]\n        return \"\".join(filtered_chars)\n\n    def _is_palindrome(text):\n        \"\"\"Checks if the given text is a palindrome.\"\"\"\n        return text == text[::-1]\n\n    chars_to_remove_set = set(c)\n    filtered_s = _filter_string(s, chars_to_remove_set)\n    is_palindrome_result = _is_palindrome(filtered_s)\n\n    return (filtered_s, is_palindrome_result)"}
{"task_id": "HumanEval/114", "solution": "def minSubArraySum(nums):\n    \"\"\"\n    Given an array of integers nums, find the minimum sum of any non-empty sub-array\n    of nums.\n    Example\n    minSubArraySum([2, 3, 4, 1, 2, 4]) == 1\n    minSubArraySum([-1, -2, -3]) == -6\n    \"\"\"\n    # Initialize min_overall_sum with the first element to handle single-element arrays\n    # and ensure a valid starting point for comparison.\n    min_overall_sum = nums[0]\n\n    # Kadane's algorithm variation for minimum sum sub-array\n    current_min_sum = nums[0]\n\n    for i in range(1, len(nums)):\n        # The current_min_sum for the sub-array ending at index i is either\n        # the current element itself, or the current element added to the\n        # minimum sum ending at the previous position.\n        current_min_sum = min(nums[i], current_min_sum + nums[i])\n        min_overall_sum = min(min_overall_sum, current_min_sum)\n\n    return min_overall_sum"}
{"task_id": "HumanEval/113", "solution": "def _validate_digit_string(s: str) -> None:\n    \"\"\"Validates if the given string contains only digit characters.\n    Raises ValueError if non-digit characters are found.\n    \"\"\"\n    for char in s:\n        if not char.isdigit():\n            raise ValueError(\"String contains non-digit characters\")\n\ndef _count_odd_digits(s: str) -> int:\n    \"\"\"Counts the number of odd digits (1, 3, 5, 7, 9) in the given string.\n    Assumes the string contains only digits after validation.\n    \"\"\"\n    odd_digits = {'1', '3', '5', '7', '9'}\n    count = 0\n    for char in s:\n        if char in odd_digits:\n            count += 1\n    return count\n\ndef _format_output_string(count: int) -> str:\n    \"\"\"Generates the formatted output string, replacing 'i' with the given count.\"\"\"\n    phrase = \"the number of odd elements in the string i of the input.\"\n    return phrase.replace('i', str(count))\n\ndef odd_count(lst: list[str]) -> list[str]:\n    \"\"\"Given a list of strings, where each string consists of only digits, return a list.\n    Each element i of the output should be \"the number of odd elements in the\n    string i of the input.\" where all the i's should be replaced by the number\n    of odd digits in the i'th string of the input.\n\n    >>> odd_count(['1234567'])\n    [\"the number of odd elements 4n the str4ng 4 of the 4nput.\"]\n    >>> odd_count(['3',\"11111111\"])\n    [\"the number of odd elements 1n the str1ng 1 of the 1nput.\",\n     \"the number of odd elements 8n the str8ng 8 of the 8nput.\"]\n    \"\"\"\n    results = []\n    for s in lst:\n        _validate_digit_string(s)\n        odd_count_value = _count_odd_digits(s)\n        formatted_string = _format_output_string(odd_count_value)\n        results.append(formatted_string)\n    return results"}
{"task_id": "HumanEval/115", "solution": "import math\n\ndef max_fill(grid, capacity):\n    \"\"\"\n    Calculates the total number of times buckets need to be lowered to empty wells.\n    This includes validating the input grid and capacity against specified constraints.\n    \"\"\"\n    # --- Input Validation ---\n    # Validate grid structure and content\n    if not grid:\n        raise ValueError(\"Grid cannot be empty (grid.length >= 1).\")\n    if len(grid) > 100:\n        raise ValueError(\"Grid length cannot exceed 100.\")\n\n    expected_well_length = len(grid[0])\n    if not (1 <= expected_well_length <= 100):\n        raise ValueError(\"Well length must be between 1 and 100.\")\n\n    for well_row in grid:\n        if len(well_row) != expected_well_length:\n            raise ValueError(\"All wells must have the same length.\")\n        for unit in well_row:\n            if unit not in (0, 1):\n                raise ValueError(\"Well units must be 0 or 1.\")\n\n    # Validate capacity\n    if not (1 <= capacity <= 10):\n        raise ValueError(\"Bucket capacity must be between 1 and 10.\")\n\n    # --- Core Calculation Helper Functions (defined inline) ---\n    def _calculate_water_units_in_well(well_row_param):\n        \"\"\"Counts the number of water units (1s) in a single well.\"\"\"\n        return sum(well_row_param)\n\n    def _calculate_lowerings_for_well(water_units_param, capacity_param):\n        \"\"\"Calculates the number of bucket lowerings for a single well.\"\"\"\n        if water_units_param == 0:\n            return 0\n        return math.ceil(water_units_param / capacity_param)\n\n    # --- Main Calculation Logic ---\n    total_lowerings = 0\n    for well_row in grid:\n        water_units = _calculate_water_units_in_well(well_row)\n        lowerings_for_well = _calculate_lowerings_for_well(water_units, capacity)\n        total_lowerings += lowerings_for_well\n        \n    return total_lowerings"}
{"task_id": "HumanEval/120", "solution": "def _validate_inputs(arr: list[int], k: int):\n    \"\"\"\n    Validates the input array arr and integer k based on SRS constraints.\n    Raises ValueError for invalid inputs.\n    \"\"\"\n    if not (1 <= len(arr) <= 1000):\n        raise ValueError(\"Array length must be between 1 and 1000, inclusive.\")\n\n    for x in arr:\n        if not (-1000 <= x <= 1000):\n            raise ValueError(\"Array elements must be between -1000 and 1000, inclusive.\")\n\n    if not (0 <= k <= len(arr)):\n        raise ValueError(\"k must be between 0 and the length of the array, inclusive.\")\n\n\ndef maximum(arr, k):\n    \"\"\"\n    Given an array arr of integers and a positive integer k, return a sorted list \n    of length k with the maximum k numbers in arr.\n    \"\"\"\n    _validate_inputs(arr, k)\n\n    if k == 0:\n        return []\n\n    # Sort the array in descending order to easily pick the largest elements.\n    sorted_arr_desc = sorted(arr, reverse=True)\n\n    # Take the first k elements.\n    top_k_elements = sorted_arr_desc[:k]\n\n    # Sort these k elements in ascending order as required for the final output.\n    final_result = sorted(top_k_elements)\n\n    return final_result"}
{"task_id": "HumanEval/117", "solution": "def _is_vowel(char):\n    \"\"\"Checks if a character is a vowel (case-insensitive).\"\"\"\n    return char.lower() in 'aeiou'\n\nclass Word:\n    \"\"\"Encapsulates a word's text and its consonant count.\"\"\"\n    def __init__(self, text):\n        self._text = text\n        self._consonant_count = 0\n        for char in text:\n            if char.isalpha() and not _is_vowel(char):\n                self._consonant_count += 1\n\n    def get_text(self):\n        \"\"\"Returns the word's text.\"\"\"\n        return self._text\n\n    def get_consonant_count(self):\n        \"\"\"Returns the pre-calculated number of consonants.\"\"\"\n        return self._consonant_count\n\ndef select_words(s, n):\n    \"\"\"Given a string s and a natural number n, returns a list of words from s\n    that contain exactly n consonants, in order.\"\"\"\n    if not s:\n        return []\n\n    result_list = []\n    words = s.split()\n\n    for word_text in words:\n        word_obj = Word(word_text)\n        if word_obj.get_consonant_count() == n:\n            result_list.append(word_obj.get_text())\n\n    return result_list"}
{"task_id": "HumanEval/119", "solution": "def _is_balanced(s: str) -> bool:\n    \"\"\"Checks if a string of parentheses is balanced.\"\"\"\n    balance = 0\n    for char in s:\n        if char == '(':\n            balance += 1\n        else:  # char == ')'\n            balance -= 1\n        if balance < 0:\n            return False\n    return balance == 0\n\n\ndef match_parens(lst):\n    '''\n    You are given a list of two strings, both strings consist of open\n    parentheses '(' or close parentheses ')' only.\n    Your job is to check if it is possible to concatenate the two strings in\n    some order, that the resulting string will be good.\n    A string S is considered to be good if and only if all parentheses in S\n    are balanced. For example: the string '(())()' is good, while the string\n    '())' is not.\n    Return 'Yes' if there's a way to make a good string, and return 'No' otherwise.\n\n    Examples:\n    match_parens(['()(', ')']) == 'Yes'\n    match_parens([')', ')']) == 'No'\n    '''\n    s1 = lst[0] + lst[1]\n    s2 = lst[1] + lst[0]\n\n    if _is_balanced(s1) or _is_balanced(s2):\n        return 'Yes'\n    else:\n        return 'No'"}
{"task_id": "HumanEval/116", "solution": "def _count_ones_in_binary(n: int) -> int:\n    \"\"\"\n    Counts the number of '1's in the binary representation of a non-negative integer.\n    Assumes n >= 0.\n    \"\"\"\n    return bin(n).count('1')\n\ndef _get_sort_key(num: int) -> tuple[int, int, int]:\n    \"\"\"\n    Generates a tuple key for sorting an integer based on specified rules.\n    The key ensures correct ordering: negative numbers first, then non-negative by ones count then decimal value.\n    \"\"\"\n    if num < 0:\n        # Negative numbers: group priority 0 (first group), placeholder for ones count, then actual value\n        return (0, 0, num)\n    else:\n        # Non-negative numbers: group priority 1 (second group), ones count, then actual value\n        ones_count = _count_ones_in_binary(num)\n        return (1, ones_count, num)\n\ndef sort_array(arr):\n    \"\"\"\n    In this Kata, you have to sort an array of non-negative integers according to\n    number of ones in their binary representation in ascending order.\n    For similar number of ones, sort based on decimal value.\n    \"\"\"\n    return sorted(arr, key=_get_sort_key)"}
{"task_id": "HumanEval/118", "solution": "def get_closest_vowel(word):\n    \"\"\"You are given a word. Your task is to find the closest vowel that stands between \n    two consonants from the right side of the word (case sensitive).\n    \n    Vowels in the beginning and ending doesn't count. Return empty string if you didn't\n    find any vowel met the above condition. \n\n    You may assume that the given string contains English letter only.\n\n    Example:\n    get_closest_vowel(\"yogurt\") ==> \"u\"\n    get_closest_vowel(\"FULL\") ==> \"U\"\n    get_closest_vowel(\"quick\") ==> \"\"\n    get_closest_vowel(\"ab\") ==> \"\"\n    \"\"\"\n\n    def _is_vowel(char: str) -> bool:\n        \"\"\"Determines if a given character is a vowel (case-insensitive).\"\"\"\n        return char.lower() in 'aeiou'\n\n    def _is_consonant(char: str) -> bool:\n        \"\"\"Determines if a given character is a consonant (case-insensitive).\"\"\"\n        return char.isalpha() and not _is_vowel(char)\n\n    # Iterate from the second to the second-to-last character (inclusive)\n    # in reverse order, to find the \"closest from the right\".\n    for i in range(len(word) - 2, 0, -1):\n        current_char = word[i]\n        prev_char = word[i-1]\n        next_char = word[i+1]\n\n        if _is_vowel(current_char) and _is_consonant(prev_char) and _is_consonant(next_char):\n            return current_char\n            \n    return \"\""}
{"task_id": "HumanEval/121", "solution": "def solution(lst):\n    \"\"\"Given a non-empty list of integers, return the sum of all of the odd elements that are in even positions.\n    \"\"\"\n    total_sum = 0\n    for index, element in enumerate(lst):\n        # Check if the current position (index) is even and the element itself is odd.\n        if index % 2 == 0 and element % 2 != 0:\n            total_sum += element\n    return total_sum"}
{"task_id": "HumanEval/122", "solution": "class InputValidator:\n    @staticmethod\n    def validate_inputs(arr: list[int], k: int) -> None:\n        if not (1 <= len(arr) <= 100):\n            raise ValueError(\"Array length must be between 1 and 100 inclusive.\")\n        if not (1 <= k <= len(arr)):\n            raise ValueError(\"k must be between 1 and the length of the array inclusive.\")\n\nclass IntegerElement:\n    def __init__(self, value: int):\n        self._value = value\n\n    def has_at_most_two_digits(self) -> bool:\n        \"\"\"Returns True if the absolute value of the element has at most two digits.\"\"\"\n        return abs(self._value) < 100\n\n    def get_value(self) -> int:\n        \"\"\"Returns the encapsulated integer value.\"\"\"\n        return self._value\n\nclass ElementProcessor:\n    @staticmethod\n    def calculate_sum_of_two_digit_elements(elements: list[IntegerElement]) -> int:\n        \"\"\"Calculates the sum of elements with at most two digits from a list of IntegerElement objects.\"\"\"\n        total_sum = 0\n        for element in elements:\n            if element.has_at_most_two_digits():\n                total_sum += element.get_value()\n        return total_sum\n\ndef add_elements(arr, k):\n    \"\"\"\n    Given a non-empty array of integers arr and an integer k, return\n    the sum of the elements with at most two digits from the first k elements of arr.\n    \"\"\"\n    InputValidator.validate_inputs(arr, k)\n\n    first_k_elements = arr[:k]\n    integer_elements = [IntegerElement(value) for value in first_k_elements]\n\n    return ElementProcessor.calculate_sum_of_two_digit_elements(integer_elements)"}
{"task_id": "HumanEval/125", "solution": "import re\n\ndef _contains_whitespace(text: str) -> bool:\n    \"\"\"Checks if the given text contains any whitespace characters.\"\"\"\n    return bool(re.search(r'\\s', text))\n\ndef _contains_comma(text: str) -> bool:\n    \"\"\"Checks if the given text contains any comma characters.\"\"\"\n    return ',' in text\n\nclass CharacterCounter:\n    \"\"\"Provides functionality to count lowercase letters with odd alphabetical order.\"\"\"\n    @staticmethod\n    def count_odd_order_lowercase_letters(text: str) -> int:\n        \"\"\"Counts lowercase letters with an odd 0-indexed alphabetical order.\"\"\"\n        count = 0\n        for char in text:\n            if 'a' <= char <= 'z':\n                if (ord(char) - ord('a')) % 2 != 0:\n                    count += 1\n        return count\n\ndef split_words(txt):\n    '''\n    Given a string of words, return a list of words split on whitespace, if no whitespaces exists in the text you\n    should split on commas ',' if no commas exists you should return the number of lower-case letters with odd order in the\n    alphabet, ord('a') = 0, ord('b') = 1, ... ord('z') = 25\n    Examples\n    split_words(\"Hello world!\") \u279e [\"Hello\", \"world!\"]\n    split_words(\"Hello,world!\") \u279e [\"Hello\", \"world!\"]\n    split_words(\"abcdef\") == 3 \n    '''\n    if _contains_whitespace(txt):\n        return txt.split()\n    elif _contains_comma(txt):\n        return txt.split(',')\n    else:\n        return CharacterCounter.count_odd_order_lowercase_letters(txt)"}
{"task_id": "HumanEval/123", "solution": "def get_odd_collatz(n):\n    \"\"\"\n    Given a positive integer n, return a sorted list that has the odd numbers in collatz sequence.\n    \"\"\"\n    odd_numbers = set()\n    current_n = n\n\n    while current_n != 1:\n        if current_n % 2 != 0:\n            odd_numbers.add(current_n)\n        \n        if current_n % 2 == 0:\n            current_n = current_n // 2\n        else:\n            current_n = 3 * current_n + 1\n    \n    # After the loop, current_n is 1. Since 1 is always odd and part of the sequence, add it.\n    odd_numbers.add(1)\n    \n    result = list(odd_numbers)\n    result.sort()\n    return result"}
{"task_id": "HumanEval/124", "solution": "from typing import Optional\n\nclass DateComponents:\n    \"\"\"A simple data structure to hold parsed date components.\"\"\"\n    def __init__(self, month: int, day: int, year: int):\n        self.month = month\n        self.day = day\n        self.year = year\n\ndef _parse_date_string(date_string: str) -> Optional[DateComponents]:\n    \"\"\"Parses a date string in 'mm-dd-yyyy' format into DateComponents.\n    Returns DateComponents if successful, None otherwise.\n    \"\"\"\n    if not date_string:\n        return None\n\n    parts = date_string.split('-')\n    if len(parts) != 3:\n        return None\n\n    try:\n        month = int(parts[0])\n        day = int(parts[1])\n        year = int(parts[2])\n    except ValueError:\n        return None\n\n    if not (len(parts[0]) == 2 and len(parts[1]) == 2 and len(parts[2]) == 4):\n        return None\n\n    return DateComponents(month, day, year)\n\ndef _validate_month(month: int) -> bool:\n    \"\"\"Validates if the month is within the range [1, 12].\"\"\"\n    return 1 <= month <= 12\n\ndef _validate_day(day: int, month: int) -> bool:\n    \"\"\"Validates if the day is within the correct range for the given month.\"\"\"\n    if not (1 <= day):\n        return False\n\n    if month in {1, 3, 5, 7, 8, 10, 12}:\n        return day <= 31\n    elif month in {4, 6, 9, 11}:\n        return day <= 30\n    elif month == 2:\n        return day <= 29\n    else:\n        return False\n\ndef valid_date(date):\n    \"\"\"You have to write a function which validates a given date string and\n    returns True if the date is valid otherwise False.\n    The date is valid if all of the following rules are satisfied:\n    1. The date string is not empty.\n    2. The number of days is not less than 1 or higher than 31 days for months 1,3,5,7,8,10,12. And the number of days is not less than 1 or higher than 30 days for months 4,6,9,11. And, the number of days is not less than 1 or higher than 29 for the month 2.\n    3. The months should not be less than 1 or higher than 12.\n    4. The date should be in the format: mm-dd-yyyy\n\n    for example: \n    valid_date('03-11-2000') => True\n\n    valid_date('15-01-2012') => False\n\n    valid_date('04-0-2040') => False\n\n    valid_date('06-04-2020') => True\n\n    valid_date('06/04/2020') => False\n    \"\"\"\n    if not date:\n        return False\n\n    date_components = _parse_date_string(date)\n    if date_components is None:\n        return False\n\n    if not _validate_month(date_components.month):\n        return False\n\n    if not _validate_day(date_components.day, date_components.month):\n        return False\n\n    return True"}
{"task_id": "HumanEval/126", "solution": "import collections\n\ndef is_sorted(lst):\n    '''\n    Given a list of numbers, return whether or not they are sorted\n    in ascending order. If list has more than 1 duplicate of the same\n    number, return False. Assume no negative numbers and only integers.\n    '''\n\n    def _check_duplicates(nums):\n        # Checks if any number in the list occurs three or more times.\n        counts = collections.Counter(nums)\n        for count in counts.values():\n            if count >= 3:\n                return False\n        return True\n\n    def _check_sorted_order(nums):\n        # Determines if the list is sorted in ascending order.\n        if len(nums) < 2:\n            return True\n        for i in range(1, len(nums)):\n            if nums[i] < nums[i-1]:\n                return False\n        return True\n\n    if not _check_duplicates(lst):\n        return False\n\n    return _check_sorted_order(lst)"}
{"task_id": "HumanEval/127", "solution": "import math\n\ndef _is_prime(n: int) -> bool:\n    \"\"\"\n    Determines if a given integer is a prime number.\n    A prime number is a natural number greater than 1 that has no positive divisors other than 1 and itself.\n    \"\"\"\n    if n <= 1:\n        return False\n    if n <= 3:\n        return True\n    if n % 2 == 0 or n % 3 == 0:\n        return False\n    i = 5\n    while i * i <= n:\n        if n % i == 0 or n % (i + 2) == 0:\n            return False\n        i += 6\n    return True\n\ndef _calculate_intersection_interval(interval1: tuple[int, int], interval2: tuple[int, int]) -> tuple[int, int] | None:\n    \"\"\"\n    Calculates the intersection of two intervals.\n    Returns the intersection interval (start, end) or None if no intersection.\n    \"\"\"\n    s1, e1 = interval1\n    s2, e2 = interval2\n\n    intersect_start = max(s1, s2)\n    intersect_end = min(e1, e2)\n\n    if intersect_start <= intersect_end:\n        return (intersect_start, intersect_end)\n    else:\n        return None\n\ndef _calculate_intersection_length(intersection_interval: tuple[int, int]) -> int:\n    \"\"\"\n    Calculates the length of a closed interval.\n    Assumes the input is a valid intersection interval (start <= end).\n    \"\"\"\n    start, end = intersection_interval\n    return end - start + 1\n\ndef intersection(interval1, interval2):\n    \"\"\"You are given two intervals,\n    where each interval is a pair of integers. For example, interval = (start, end) = (1, 2).\n    The given intervals are closed which means that the interval (start, end)\n    includes both start and end.\n    For each given interval, it is assumed that its start is less or equal its end.\n    Your task is to determine whether the length of intersection of these two \n    intervals is a prime number.\n    Example, the intersection of the intervals (1, 3), (2, 4) is (2, 3)\n    which its length is 1, which not a prime number.\n    If the length of the intersection is a prime number, return \"YES\",\n    otherwise, return \"NO\".\n    If the two intervals don't intersect, return \"NO\".\n\n\n    [input/output] samples:\n    intersection((1, 2), (2, 3)) ==> \"NO\"\n    intersection((-1, 1), (0, 4)) ==> \"NO\"\n    intersection((-3, -1), (-5, 5)) ==> \"YES\"\n    \"\"\"\n    intersect_interval = _calculate_intersection_interval(interval1, interval2)\n\n    if intersect_interval is None:\n        return \"NO\"\n\n    length = _calculate_intersection_length(intersect_interval)\n\n    if _is_prime(length):\n        return \"YES\"\n    else:\n        return \"NO\""}
{"task_id": "HumanEval/128", "solution": "def prod_signs(arr):\n    \"\"\"\n    You are given an array arr of integers and you need to return\n    sum of magnitudes of integers multiplied by product of all signs\n    of each number in the array, represented by 1, -1 or 0.\n    Note: return None for empty arr.\n\n    Example:\n    >>> prod_signs([1, 2, 2, -4]) == -9\n    >>> prod_signs([0, 1]) == 0\n    >>> prod_signs([]) == None\n    \"\"\"\n    if not arr:\n        return None\n\n    sum_magnitudes = 0\n    product_signs = 1\n\n    def _get_magnitude(number):\n        \"\"\"Returns the absolute value (magnitude) of an integer.\"\"\"\n        return abs(number)\n\n    def _get_sign(number):\n        \"\"\"Returns the sign of an integer: 1 for positive, -1 for negative, 0 for zero.\"\"\"\n        if number > 0:\n            return 1\n        elif number < 0:\n            return -1\n        else:\n            return 0\n\n    for number in arr:\n        sum_magnitudes += _get_magnitude(number)\n        product_signs *= _get_sign(number)\n\n    return sum_magnitudes * product_signs"}
{"task_id": "HumanEval/129", "solution": "class Cell:\n    \"\"\"Stores the coordinates and value of a single grid cell.\"\"\"\n    def __init__(self, row: int, col: int, value: int):\n        self.row = row\n        self.col = col\n        self.value = value\n\n    def __repr__(self) -> str:\n        return f\"Cell({self.row},{self.col}={self.value})\"\n\n    def __eq__(self, other) -> bool:\n        if not isinstance(other, Cell):\n            return NotImplemented\n        return self.row == other.row and self.col == other.col and self.value == other.value\n\n    def __hash__(self) -> int:\n        return hash((self.row, self.col, self.value))\n\nclass Grid:\n    \"\"\"Represents the N x N grid, provides access to cells and boundary checks.\"\"\"\n    def __init__(self, grid_values: list[list[int]]):\n        self.N = _validate_grid_input(grid_values)\n        self._cells: list[list[Cell]] = []\n        for r in range(self.N):\n            row_cells = []\n            for c in range(self.N):\n                row_cells.append(Cell(r, c, grid_values[r][c]))\n            self._cells.append(row_cells)\n\n    def get_cell(self, row: int, col: int) -> Cell:\n        \"\"\"Returns the Cell object at the specified coordinates.\"\"\"\n        return self._cells[row][col]\n\n    def is_valid_coord(self, row: int, col: int) -> bool:\n        \"\"\"Checks if the given coordinates are within the grid boundaries.\"\"\"\n        return 0 <= row < self.N and 0 <= col < self.N\n\nclass Path:\n    \"\"\"Represents a path of k cell values, supports lexicographical comparison.\"\"\"\n    def __init__(self, values: list[int]):\n        self.cell_values = values\n\n    def __len__(self) -> int:\n        return len(self.cell_values)\n\n    def __lt__(self, other) -> bool:\n        \"\"\"Compares two paths lexicographically.\"\"\"\n        if not isinstance(other, Path):\n            return NotImplemented\n        return self.cell_values < other.cell_values\n\n    def __repr__(self) -> str:\n        return f\"Path({self.cell_values})\"\n\ndef _validate_grid_input(grid_values: list[list[int]]) -> int:\n    \"\"\"Validates the input grid against NFR1 (N x N, N>=2) and NFR2 (unique values [1, N*N]).\"\"\"\n    if not isinstance(grid_values, list) or not grid_values:\n        raise ValueError(\"Grid must be a non-empty list of lists.\")\n\n    N = len(grid_values)\n    if N < 2:\n        raise ValueError(\"Grid dimension N must be at least 2.\")\n\n    all_values = set()\n    expected_sum = N * N * (N * N + 1) // 2\n    actual_sum = 0\n\n    for row_idx, row in enumerate(grid_values):\n        if not isinstance(row, list) or len(row) != N:\n            raise ValueError(f\"All rows must have length N={N}.\")\n        for col_idx, value in enumerate(row):\n            if not isinstance(value, int):\n                raise ValueError(f\"Cell value at ({row_idx},{col_idx}) must be an integer.\")\n            if not (1 <= value <= N * N):\n                raise ValueError(f\"Cell value {value} at ({row_idx},{col_idx}) out of range [1, N*N].\")\n            if value in all_values:\n                raise ValueError(f\"Duplicate value {value} found in grid.\")\n            all_values.add(value)\n            actual_sum += value\n    \n    if len(all_values) != N * N or actual_sum != expected_sum:\n        raise ValueError(\"Grid must contain all integers from 1 to N*N exactly once.\")\n    return N\n\ndef _validate_k_input(k: int):\n    \"\"\"Validates the input k against NFR3 (positive integer).\"\"\"\n    if not isinstance(k, int) or k <= 0:\n        raise ValueError(\"Path length k must be a positive integer.\")\n\n_DR = [-1, 1, 0, 0] # Row changes for neighbors (up, down, left, right)\n_DC = [0, 0, -1, 1] # Column changes for neighbors (up, down, left, right)\n\ndef _find_paths_recursive(\n    current_cell: Cell,\n    current_path_values: list[int],\n    current_length: int,\n    k: int,\n    grid_obj: Grid,\n    min_path_found_wrapper: list[list[int]]\n):\n    \"\"\"Recursively explores paths and updates the lexicographically smallest path found so far.\"\"\"\n    if current_length == k:\n        if not min_path_found_wrapper[0] or current_path_values < min_path_found_wrapper[0]:\n            min_path_found_wrapper[0] = current_path_values[:]\n        return\n\n    for i in range(4):\n        next_row, next_col = current_cell.row + _DR[i], current_cell.col + _DC[i]\n        \n        if grid_obj.is_valid_coord(next_row, next_col):\n            next_cell = grid_obj.get_cell(next_row, next_col)\n            _find_paths_recursive(\n                next_cell,\n                current_path_values + [next_cell.value],\n                current_length + 1,\n                k,\n                grid_obj,\n                min_path_found_wrapper\n            )\n\ndef minPath(grid, k):\n    \"\"\"\n    Given a grid with N rows and N columns (N >= 2) and a positive integer k, \n    each cell of the grid contains a value. Every integer in the range [1, N * N]\n    inclusive appears exactly once on the cells of the grid.\n\n    You have to find the minimum path of length k in the grid. You can start\n    from any cell, and in each step you can move to any of the neighbor cells,\n    in other words, you can go to cells which share an edge with you current\n    cell.\n    Please note that a path of length k means visiting exactly k cells (not\n    necessarily distinct).\n    You CANNOT go off the grid.\n    A path A (of length k) is considered less than a path B (of length k) if\n    after making the ordered lists of the values on the cells that A and B go\n    through (let's call them lst_A and lst_B), lst_A is lexicographically less\n    than lst_B, in other words, there exist an integer index i (1 <= i <= k)\n    such that lst_A[i] < lst_B[i] and for any j (1 <= j < i) we have\n    lst_A[j] = lst_B[j].\n    It is guaranteed that the answer is unique.\n    Return an ordered list of the values on the cells that the minimum path go through.\n\n    Examples:\n\n        Input: grid = [ [1,2,3], [4,5,6], [7,8,9]], k = 3\n        Output: [1, 2, 1]\n\n        Input: grid = [ [5,9,3], [4,1,6], [7,8,2]], k = 1\n        Output: [1]\n    \"\"\"\n    _validate_k_input(k)\n    grid_obj = Grid(grid)\n\n    # Initialize min_path_found_wrapper with a path guaranteed to be lexicographically larger.\n    # A list containing a single list is used to allow the recursive function to modify it by reference.\n    initial_large_value = (grid_obj.N * grid_obj.N) + 1\n    min_path_found_wrapper = [[initial_large_value] * k] \n\n    for r in range(grid_obj.N):\n        for c in range(grid_obj.N):\n            start_cell = grid_obj.get_cell(r, c)\n            _find_paths_recursive(\n                start_cell,\n                [start_cell.value],\n                1,\n                k,\n                grid_obj,\n                min_path_found_wrapper\n            )\n            \n    return min_path_found_wrapper[0]"}
{"task_id": "HumanEval/133", "solution": "import math\n\ndef sum_squares(lst):\n    \"\"\"You are given a list of numbers.\n    You need to return the sum of squared numbers in the given list,\n    round each element in the list to the upper int(Ceiling) first.\n    Examples:\n    For lst = [1,2,3] the output should be 14\n    For lst = [1,4,9] the output should be 98\n    For lst = [1,3,5,7] the output should be 84\n    For lst = [1.4,4.2,0] the output should be 29\n    For lst = [-2.4,1,1] the output should be 6\n    \n\n    \"\"\"\n    total_sum = 0\n    for num in lst:\n        # Round each number to the upper integer (ceiling)\n        ceiled_num = math.ceil(num)\n        # Square the ceiled number and add to the total sum\n        total_sum += ceiled_num * ceiled_num\n    return total_sum"}
{"task_id": "HumanEval/130", "solution": "def tri(n):\n    \"\"\"Calculates the first n+1 numbers of the Tribonacci sequence.\n    This sequence uses specific recurrence relations, including memoization to handle forward dependencies.\n    \"\"\"\n    memo = {}\n\n    def _get_tri_value(k):\n        if k in memo:\n            return memo[k]\n\n        result = 0.0\n\n        if k == 0:\n            result = 1.0\n        elif k == 1:\n            result = 3.0\n        elif k % 2 == 0:  # k is even\n            result = 1.0 + float(k) / 2\n        else:  # k is odd and k > 1\n            # tri(k) = tri(k - 1) + tri(k - 2) + tri(k + 1)\n            result = _get_tri_value(k - 1) + _get_tri_value(k - 2) + _get_tri_value(k + 1)\n\n        memo[k] = result\n        return result\n\n    sequence = []\n    for i in range(n + 1):\n        sequence.append(_get_tri_value(i))\n\n    return sequence"}
{"task_id": "HumanEval/131", "solution": "def _get_digits(n: int) -> list[int]:\n    \"\"\"Extracts individual digits from a positive integer n into a list.\"\"\"\n    return [int(d) for d in str(n)]\n\ndef _is_odd(digit: int) -> bool:\n    \"\"\"Determines if a given integer digit is odd.\"\"\"\n    return digit % 2 != 0\n\ndef digits(n):\n    \"\"\"Given a positive integer n, return the product of the odd digits.\n    Return 0 if all digits are even.\n    For example:\n    digits(1)  == 1\n    digits(4)  == 0\n    digits(235) == 15\n    \"\"\"\n    product_of_odd_digits = 1\n    odd_digit_found = False\n\n    list_of_digits = _get_digits(n)\n\n    for digit in list_of_digits:\n        if _is_odd(digit):\n            product_of_odd_digits *= digit\n            odd_digit_found = True\n\n    if odd_digit_found:\n        return product_of_odd_digits\n    else:\n        return 0"}
{"task_id": "HumanEval/132", "solution": "def is_nested(string):\n    '''\n    Create a function that takes a string as input which contains only square brackets.\n    The function should return True if and only if there is a valid subsequence of brackets \n    where at least one bracket in the subsequence is nested.\n\n    is_nested('[[]]') \u279e True\n    is_nested('[]]]]]]][[[[[]') \u279e False\n    is_nested('[][]') \u279e False\n    is_nested('[]') \u279e False\n    is_nested('[[][]]') \u279e True\n    is_nested('[[]][[') \u279e True\n    '''\n    class BracketString:\n        \"\"\"Encapsulates bracket string logic for validation and nested subsequence detection.\"\"\"\n        def __init__(self, value: str):\n            \"\"\"Initializes the BracketString with the given value.\"\"\"\n            self._value = value\n\n        def _is_valid_char_content(self) -> bool:\n            \"\"\"Checks if the string contains only square bracket characters ('[' and ']').\"\"\"\n            for char in self._value:\n                if char not in ['[', ']']:\n                    return False\n            return True\n\n        def _is_valid_bracket_sequence(self, sequence: str) -> bool:\n            \"\"\"Helper: Checks if a given subsequence of brackets is valid.\"\"\"\n            stack = []\n            for char in sequence:\n                if char == '[':\n                    stack.append(char)\n                elif char == ']':\n                    if not stack or stack[-1] != '[':\n                        return False\n                    stack.pop()\n            return not stack\n\n        def _has_nested_structure(self, sequence: str) -> bool:\n            \"\"\"Helper: Checks if a given valid bracket sequence contains a nested structure.\"\"\"\n            # A valid sequence has a nested structure if its max depth exceeds 1.\n            current_depth = 0\n            max_depth = 0\n            for char in sequence:\n                if char == '[':\n                    current_depth += 1\n                    max_depth = max(max_depth, current_depth)\n                elif char == ']':\n                    current_depth -= 1\n            \n            return max_depth > 1\n\n        def has_nested_valid_subsequence(self) -> bool:\n            \"\"\"Searches for any valid subsequence within _value that contains a nested bracket.\"\"\"\n            n = len(self._value)\n            \n            # Iterate through all 2^n possible subsequences using bitmasking.\n            for i in range(1 << n):\n                subsequence_chars = []\n                for j in range(n):\n                    if (i >> j) & 1: # If the j-th bit is set, include the j-th character.\n                        subsequence_chars.append(self._value[j])\n                \n                subsequence = \"\".join(subsequence_chars)\n                \n                # Check if it's a valid bracket sequence and has a nested structure.\n                # _has_nested_structure correctly handles empty strings (max_depth=0).\n                if self._is_valid_bracket_sequence(subsequence) and self._has_nested_structure(subsequence):\n                    return True\n                    \n            return False\n\n    bracket_obj = BracketString(string)\n    \n    # If input char content is invalid, return False as per FR3 acceptance criteria.\n    if not bracket_obj._is_valid_char_content():\n        return False\n\n    return bracket_obj.has_nested_valid_subsequence()"}
{"task_id": "HumanEval/135", "solution": "def can_arrange(arr):\n    \"\"\"Create a function which returns the largest index of an element which\n    is not greater than or equal to the element immediately preceding it. If\n    no such element exists then return -1. The given array will not contain\n    duplicate values.\n\n    Examples:\n    can_arrange([1,2,4,3,5]) = 3\n    can_arrange([1,2,3]) = -1\n    \"\"\"\n    largest_index = -1\n    # Iterate from the second element to compare with its predecessor\n    for i in range(1, len(arr)):\n        if arr[i] < arr[i-1]:\n            largest_index = i\n    return largest_index"}
{"task_id": "HumanEval/134", "solution": "def check_if_last_char_is_a_letter(txt):\n    '''\n    Create a function that returns True if the last character\n    of a given string is an alphabetical character and is not\n    a part of a word, and False otherwise.\n    Note: \"word\" is a group of characters separated by space.\n\n    Examples:\n    check_if_last_char_is_a_letter(\"apple pie\") \u279e False\n    check_if_last_char_is_a_letter(\"apple pi e\") \u279e True\n    check_if_last_char_is_a_letter(\"apple pi e \") \u279e False\n    check_if_last_char_is_a_letter(\"\") \u279e False \n    '''\n    if not txt:\n        return False\n\n    last_char = txt[-1]\n\n    if not last_char.isalpha():\n        return False\n\n    # Check if the last character is part of a word.\n    # A word is defined as a group of characters separated by space.\n    # If the last character is 'e' in \"apple pi e\", it's not part of a word.\n    # If the last character is 'e' in \"apple pie\", it is part of a word.\n    # If the last character is ' ' in \"apple pi e \", it's not alphabetical, handled above.\n    \n    # We need to split the string by space.\n    # If there's a space immediately before the last character, then the last char is isolated.\n    # Example: \"apple pi e\" -> last char 'e', previous char ' ', return True.\n    # Example: \"apple pie\" -> last char 'e', previous char 'i', return False.\n    # Example: \"apple \" -> last char ' ', not alpha, handled.\n    if len(txt) > 1 and txt[-2] == ' ':\n        return True\n    \n    return False"}
{"task_id": "HumanEval/136", "solution": "def largest_smallest_integers(lst):\n    \"\"\"\n    Finds the largest negative and smallest positive integers in a list.\n    Returns a tuple (largest_negative, smallest_positive).\n    \"\"\"\n    largest_negative = None\n    smallest_positive = None\n\n    for number in lst:\n        if number < 0:\n            if largest_negative is None or number > largest_negative:\n                largest_negative = number\n        elif number > 0:\n            if smallest_positive is None or number < smallest_positive:\n                smallest_positive = number\n\n    return (largest_negative, smallest_positive)"}
{"task_id": "HumanEval/139", "solution": "def _calculate_factorial(k):\n    \"\"\"Calculates the standard factorial k!.\"\"\"\n    if k == 0:\n        return 1\n    \n    product = 1\n    for i in range(1, k + 1):\n        product *= i\n    return product\n\ndef special_factorial(n):\n    \"\"\"The Brazilian factorial is defined as:\n    brazilian_factorial(n) = n! * (n-1)! * (n-2)! * ... * 1!\n    where n > 0\n\n    For example:\n    >>> special_factorial(4)\n    288\n\n    The function will receive an integer as input and should return the special\n    factorial of this integer.\n    \"\"\"\n    if n <= 0:\n        raise ValueError(\"Input n must be greater than 0\")\n\n    result = 1\n    for i in range(n, 0, -1):\n        result *= _calculate_factorial(i)\n    \n    return result"}
{"task_id": "HumanEval/138", "solution": "def is_equal_to_sum_even(n):\n    \"\"\"Evaluate whether the given number n can be written as the sum of exactly 4 positive even numbers.\n    A positive even number is an integer greater than 0 and divisible by 2. The minimum sum of four positive even numbers is 8.\n    \"\"\"\n    # If n is less than 8 or odd, it cannot be the sum of four positive even numbers.\n    if n < 8 or n % 2 != 0:\n        return False\n\n    # Any even number n >= 8 can be expressed as 2 + 2 + 2 + (n - 6), where (n - 6) is a positive even number.\n    return True"}
{"task_id": "HumanEval/140", "solution": "import re\n\ndef _has_spaces(text):\n    \"\"\"Checks if the string contains any space characters.\"\"\"\n    return ' ' in text\n\ndef _apply_multiple_space_rule(text):\n    \"\"\"Replaces sequences of three or more consecutive spaces with a single hyphen.\"\"\"\n    return re.sub(r' {3,}', '-', text)\n\ndef _apply_single_space_rule(text):\n    \"\"\"Replaces each single space character with an underscore.\"\"\"\n    return text.replace(' ', '_')\n\ndef fix_spaces(text):\n    \"\"\"\n    Given a string text, replace all spaces in it with underscores, \n    and if a string has more than 2 consecutive spaces, \n    then replace all consecutive spaces with - \n    \n    fix_spaces(\"Example\") == \"Example\"\n    fix_spaces(\"Example 1\") == \"Example_1\"\n    fix_spaces(\" Example 2\") == \"_Example_2\"\n    fix_spaces(\" Example   3\") == \"_Example-3\"\n    \"\"\"\n    if not _has_spaces(text):\n        return text\n    \n    # First, apply the rule for three or more consecutive spaces.\n    intermediate_text = _apply_multiple_space_rule(text)\n    \n    # Then, apply the rule for single spaces (including any remaining from original two-space sequences).\n    final_text = _apply_single_space_rule(intermediate_text)\n    \n    return final_text"}
{"task_id": "HumanEval/137", "solution": "def compare_one(a, b):\n    \"\"\"\n    Create a function that takes integers, floats, or strings representing\n    real numbers, and returns the larger variable in its given variable type.\n    Return None if the values are equal.\n    Note: If a real number is represented as a string, the floating point might be . or ,\n    \"\"\"\n\n    def _parse_input(value):\n        \"\"\"Parses a value (int, float, or string) into a float and retains its original form.\"\"\"\n        original_value = value\n        if isinstance(value, str):\n            value = value.replace(',', '.')\n        numeric_value = float(value)\n        return numeric_value, original_value\n\n    parsed_a_numeric, original_a = _parse_input(a)\n    parsed_b_numeric, original_b = _parse_input(b)\n\n    if parsed_a_numeric > parsed_b_numeric:\n        return original_a\n    elif parsed_b_numeric > parsed_a_numeric:\n        return original_b\n    else:  # parsed_a_numeric == parsed_b_numeric\n        return None"}
{"task_id": "HumanEval/142", "solution": "def sum_squares(lst):\n    \"\"\"\"\n    This function will take a list of integers. For all entries in the list, the function shall square the integer entry if its index is a \n    multiple of 3 and will cube the integer entry if its index is a multiple of 4 and not a multiple of 3. The function will not \n    change the entries in the list whose indexes are not a multiple of 3 or 4. The function shall then return the sum of all entries. \n    \n    Examples:\n    For lst = [1,2,3] the output should be 6\n    For lst = []  the output should be 0\n    For lst = [-1,-5,2,-1,-5]  the output should be -126\n    \"\"\"\n    total_sum = 0\n    for index, value in enumerate(lst):\n        current_value = value\n        if index % 3 == 0:\n            current_value = value ** 2\n        elif index % 4 == 0: # This condition implies index is not a multiple of 3 due to the preceding 'if'\n            current_value = value ** 3\n        \n        total_sum += current_value\n    \n    return total_sum"}
{"task_id": "HumanEval/143", "solution": "class PrimeNumberChecker:\n    \"\"\"\n    Determines if a given integer is a prime number.\n    \"\"\"\n    def is_prime(self, number: int) -> bool:\n        if number < 2:\n            return False\n        for i in range(2, int(number**0.5) + 1):\n            if number % i == 0:\n                return False\n        return True\n\nclass Word:\n    \"\"\"\n    Represents a single word, providing its text and length, and checking if its length is prime.\n    \"\"\"\n    def __init__(self, text: str):\n        self._text = text\n        self._length = len(text)\n\n    def get_text(self) -> str:\n        return self._text\n\n    def get_length(self) -> int:\n        return self._length\n\n    def is_length_prime(self, prime_checker: PrimeNumberChecker) -> bool:\n        return prime_checker.is_prime(self._length)\n\nclass Sentence:\n    \"\"\"\n    Represents a sentence, splitting it into individual Word objects.\n    \"\"\"\n    def __init__(self, text: str):\n        self._text = text\n        self._words = [Word(word_str) for word_str in text.split()]\n\n    def get_words(self) -> list[Word]:\n        return self._words\n\ndef words_in_sentence(sentence: str) -> str:\n    \"\"\"\n    Filters words from a sentence based on whether their lengths are prime numbers.\n    \"\"\"\n    prime_checker = PrimeNumberChecker()\n    sentence_obj = Sentence(sentence)\n    \n    filtered_words = []\n    for word_obj in sentence_obj.get_words():\n        if word_obj.is_length_prime(prime_checker):\n            filtered_words.append(word_obj.get_text())\n            \n    return \" \".join(filtered_words)"}
{"task_id": "HumanEval/141", "solution": "class FileName:\n    \"\"\"Encapsulates a file name string and provides methods for extracting components and performing primitive validation checks.\"\"\"\n    def __init__(self, name: str):\n        self._name = name\n\n    def get_prefix(self) -> str:\n        \"\"\"Returns the substring before the first dot.\"\"\"\n        dot_index = self._name.find('.')\n        if dot_index == -1:\n            return \"\"\n        return self._name[:dot_index]\n\n    def get_suffix(self) -> str:\n        \"\"\"Returns the substring after the first dot.\"\"\"\n        dot_index = self._name.find('.')\n        if dot_index == -1 or dot_index == len(self._name) - 1:\n            return \"\"\n        return self._name[dot_index + 1:]\n\n    def count_digits(self) -> int:\n        \"\"\"Counts the number of digits ('0'-'9') in the entire file name.\"\"\"\n        return sum(1 for char in self._name if char.isdigit())\n\n    def count_dots(self) -> int:\n        \"\"\"Counts the number of dots ('.') in the entire file name.\"\"\"\n        return self._name.count('.')\n\n    def starts_with_letter(self) -> bool:\n        \"\"\"Checks if the prefix of the file name starts with a letter from the Latin alphabet.\"\"\"\n        prefix = self.get_prefix()\n        if not prefix:\n            return False\n        return prefix[0].isalpha()\n\n    def is_allowed_extension(self, allowed_extensions: list[str]) -> bool:\n        \"\"\"Checks if the suffix (extension) of the file name is present in the provided list of allowed_extensions.\"\"\"\n        suffix = self.get_suffix()\n        return suffix in allowed_extensions\n\ndef file_name_check(file_name):\n    \"\"\"Create a function which takes a string representing a file's name, and returns\n    'Yes' if the the file's name is valid, and returns 'No' otherwise.\"\"\"\n    \n    file_obj = FileName(file_name)\n    allowed_extensions = ['txt', 'exe', 'dll']\n\n    # Condition 1: There should not be more than three digits ('0'-'9')\n    digits_ok = file_obj.count_digits() <= 3\n\n    # Condition 2: The file's name contains exactly one dot '.'\n    dots_ok = file_obj.count_dots() == 1\n\n    # Get prefix and suffix for other checks\n    prefix = file_obj.get_prefix()\n    suffix = file_obj.get_suffix()\n\n    # Condition 3: The substring before the dot should not be empty, and it starts with a letter\n    prefix_not_empty_ok = len(prefix) > 0\n    prefix_starts_with_letter_ok = file_obj.starts_with_letter()\n\n    # Condition 4: The substring after the dot should be one of ['txt', 'exe', 'dll']\n    suffix_ok = file_obj.is_allowed_extension(allowed_extensions)\n\n    if (digits_ok and dots_ok and prefix_not_empty_ok and\n            prefix_starts_with_letter_ok and suffix_ok):\n        return 'Yes'\n    else:\n        return 'No'"}
{"task_id": "HumanEval/144", "solution": "class Fraction:\n    \"\"\"Represents a fraction with a numerator and denominator.\"\"\"\n    def __init__(self, numerator: int, denominator: int):\n        self.numerator = numerator\n        self.denominator = denominator\n\n    def multiply(self, other: 'Fraction') -> 'Fraction':\n        \"\"\"Multiplies this fraction by another fraction and returns a new Fraction.\"\"\"\n        new_numerator = self.numerator * other.numerator\n        new_denominator = self.denominator * other.denominator\n        return Fraction(new_numerator, new_denominator)\n\n    def is_whole_number(self) -> bool:\n        \"\"\"Checks if the fraction represents a whole number.\"\"\"\n        return self.numerator % self.denominator == 0\n\ndef simplify(x, n):\n    \"\"\"\n    Simplifies the expression x * n.\n    Returns True if x * n evaluates to a whole number and False otherwise.\n    \"\"\"\n    x_parts = x.split('/')\n    x_frac = Fraction(int(x_parts[0]), int(x_parts[1]))\n\n    n_parts = n.split('/')\n    n_frac = Fraction(int(n_parts[0]), int(n_parts[1]))\n\n    product_frac = x_frac.multiply(n_frac)\n\n    return product_frac.is_whole_number()"}
{"task_id": "HumanEval/145", "solution": "def order_by_points(nums):\n    \"\"\"\n    Sorts a list of integers based on the sum of their digits and original index.\n    Uses a helper function to calculate the sum of digits.\n    \"\"\"\n\n    def _calculate_sum_of_digits(n: int) -> int:\n        \"\"\"Calculates the sum of the absolute values of digits for a given integer.\"\"\"\n        s = 0\n        for digit in str(abs(n)):\n            s += int(digit)\n        return s\n\n    if not nums:\n        return []\n\n    # Create a list of tuples: (original_value, sum_of_digits, original_index)\n    # This prepares data for multi-criteria sorting.\n    decorated_list = []\n    for i, num in enumerate(nums):\n        sum_digits = _calculate_sum_of_digits(num)\n        decorated_list.append((num, sum_digits, i))\n\n    # Sort primarily by sum_of_digits, then by original_index, both ascending.\n    decorated_list.sort(key=lambda x: (x[1], x[2]))\n\n    # Extract the original values from the sorted list.\n    return [item[0] for item in decorated_list]"}
{"task_id": "HumanEval/146", "solution": "class Number:\n    \"\"\"Encapsulates a number and provides methods to extract its first and last digits, ignoring the sign.\"\"\"\n    def __init__(self, num: int):\n        self._value = abs(num)\n\n    def get_first_digit(self) -> int:\n        \"\"\"Returns the first digit of the number.\"\"\"\n        if self._value == 0:\n            return 0\n        return int(str(self._value)[0])\n\n    def get_last_digit(self) -> int:\n        \"\"\"Returns the last digit of the number.\"\"\"\n        return self._value % 10\n\n    def get_value(self) -> int:\n        \"\"\"Returns the original absolute value of the number.\"\"\"\n        return self._value\n\ndef _is_odd(digit: int) -> bool:\n    \"\"\"Helper function to determine if a digit is odd.\"\"\"\n    return digit in (1, 3, 5, 7, 9)\n\nclass FilterCriteria:\n    \"\"\"Defines and evaluates the criteria for a number to be considered 'special'.\"\"\"\n    def is_special(self, number_obj: Number) -> bool:\n        \"\"\"Evaluates if a given Number object meets all 'special' criteria.\"\"\"\n        value = number_obj.get_value()\n        if value <= 10:\n            return False\n\n        first_digit = number_obj.get_first_digit()\n        if not _is_odd(first_digit):\n            return False\n\n        last_digit = number_obj.get_last_digit()\n        if not _is_odd(last_digit):\n            return False\n\n        return True\n\ndef specialFilter(nums):\n    \"\"\"\n    Counts elements in the array that are greater than 10 and have both \n    first and last digits that are odd.\n    \"\"\"\n    count = 0\n    criteria_evaluator = FilterCriteria()\n\n    for num in nums:\n        number_obj = Number(num)\n        if criteria_evaluator.is_special(number_obj):\n            count += 1\n            \n    return count"}
{"task_id": "HumanEval/148", "solution": "_PLANETS_ORDERED = [\"Mercury\", \"Venus\", \"Earth\", \"Mars\", \"Jupiter\", \"Saturn\", \"Uranus\", \"Neptune\"]\n_PLANETS_MAP = {planet: i for i, planet in enumerate(_PLANETS_ORDERED)}\n\ndef bf(planet1, planet2):\n    '''\n    There are eight planets in our solar system: the closerst to the Sun \n    is Mercury, the next one is Venus, then Earth, Mars, Jupiter, Saturn, \n    Uranus, Neptune.\n    Write a function that takes two planet names as strings planet1 and planet2. \n    The function should return a tuple containing all planets whose orbits are \n    located between the orbit of planet1 and the orbit of planet2, sorted by \n    the proximity to the sun. \n    The function should return an empty tuple if planet1 or planet2\n    are not correct planet names. \n    Examples\n    bf(\"Jupiter\", \"Neptune\") ==> (\"Saturn\", \"Uranus\")\n    bf(\"Earth\", \"Mercury\") ==> (\"Venus\")\n    bf(\"Mercury\", \"Uranus\") ==> (\"Venus\", \"Earth\", \"Mars\", \"Jupiter\", \"Saturn\")\n    '''\n    if planet1 not in _PLANETS_MAP or planet2 not in _PLANETS_MAP:\n        return ()\n\n    index1 = _PLANETS_MAP[planet1]\n    index2 = _PLANETS_MAP[planet2]\n\n    start_index = min(index1, index2)\n    end_index = max(index1, index2)\n\n    # Slice the list to get planets strictly between the two given planets.\n    # Add 1 to start_index and keep end_index as is for an exclusive range.\n    intermediate_planets = _PLANETS_ORDERED[start_index + 1:end_index]\n    \n    return tuple(intermediate_planets)"}
{"task_id": "HumanEval/147", "solution": "def get_max_triples(n):\n    \"\"\"\n    Counts the number of triples (a[i], a[j], a[k]) such that i < j < k\n    and a[i] + a[j] + a[k] is a multiple of 3.\n    \"\"\"\n    # Analyze the remainder of a[i] modulo 3:\n    # a[i] = i * i - i + 1 = i * (i - 1) + 1.\n    # The product i * (i - 1) is always a multiple of 2.\n    # Modulo 3 analysis for i * (i - 1):\n    # If i % 3 == 0, then i * (i - 1) % 3 == 0.\n    # If i % 3 == 1, then (i - 1) % 3 == 0, so i * (i - 1) % 3 == 0.\n    # If i % 3 == 2, then i * (i - 1) % 3 == (2 * 1) % 3 == 2.\n\n    # Therefore, for a[i] % 3:\n    # If i % 3 == 0 or i % 3 == 1, then a[i] % 3 == (0 + 1) % 3 == 1.\n    # If i % 3 == 2, then a[i] % 3 == (2 + 1) % 3 == 0.\n\n    # We need to find triples (a[i], a[j], a[k]) such that (a[i]%3 + a[j]%3 + a[k]%3) % 3 == 0.\n    # This occurs in two scenarios:\n    # 1. All three remainders are 0 (0 + 0 + 0 = 0).\n    # 2. All three remainders are 1 (1 + 1 + 1 = 3).\n    # (A remainder of 2 is never possible for a[i]%3).\n\n    count_rem_0 = 0  # Count of a[i] values where a[i] % 3 == 0\n    count_rem_1 = 0  # Count of a[i] values where a[i] % 3 == 1\n\n    for i in range(1, n + 1):\n        if i % 3 == 2:\n            count_rem_0 += 1\n        else:  # i % 3 == 0 or i % 3 == 1\n            count_rem_1 += 1\n\n    total_valid_triples = 0\n\n    # Calculate combinations C(N, 3) = N * (N-1) * (N-2) / 6\n    # Number of triples where all three elements have remainder 0\n    if count_rem_0 >= 3:\n        total_valid_triples += (count_rem_0 * (count_rem_0 - 1) * (count_rem_0 - 2)) // 6\n\n    # Number of triples where all three elements have remainder 1\n    if count_rem_1 >= 3:\n        total_valid_triples += (count_rem_1 * (count_rem_1 - 1) * (count_rem_1 - 2)) // 6\n\n    return total_valid_triples"}
{"task_id": "HumanEval/150", "solution": "def is_prime(n):\n    \"\"\"\n    Determines if an integer n is a prime number.\n    A prime number is a natural number greater than 1 that has no positive divisors other than 1 and itself.\n    \"\"\"\n    if n <= 1:\n        return False\n    if n <= 3:\n        return True\n    if n % 2 == 0 or n % 3 == 0:\n        return False\n    i = 5\n    while i * i <= n:\n        if n % i == 0 or n % (i + 2) == 0:\n            return False\n        i += 6\n    return True\n\ndef x_or_y(n, x, y):\n    \"\"\"A simple program which should return the value of x if n is \n    a prime number and should return the value of y otherwise.\n\n    Examples:\n    for x_or_y(7, 34, 12) == 34\n    for x_or_y(15, 8, 5) == 5\n    \n    \"\"\"\n    if is_prime(n):\n        return x\n    else:\n        return y"}
{"task_id": "HumanEval/153", "solution": "from dataclasses import dataclass\n\n@dataclass\nclass ExtensionInfo:\n    \"\"\"A value object to hold an extension's name, its calculated strength, and its original index for tie-breaking.\"\"\"\n    name: str\n    strength: int\n    original_index: int\n\ndef _count_case_letters(s: str) -> tuple[int, int]:\n    \"\"\"Counts the number of uppercase and lowercase letters in a given string.\"\"\"\n    uppercase_count = 0\n    lowercase_count = 0\n    for char in s:\n        if char.isupper():\n            uppercase_count += 1\n        elif char.islower():\n            lowercase_count += 1\n    return uppercase_count, lowercase_count\n\ndef _calculate_strength(extension_name: str) -> int:\n    \"\"\"Calculates the strength of a single extension name based on uppercase and lowercase letter counts.\"\"\"\n    cap, sm = _count_case_letters(extension_name)\n    return cap - sm\n\ndef Strongest_Extension(class_name, extensions):\n    \"\"\"\n    Finds the strongest extension based on CAP - SM strength calculation and returns a formatted string.\n    If strengths are equal, the first extension in the list is chosen.\n    \"\"\"\n    strongest_extension_info = None\n\n    for i, ext_name in enumerate(extensions):\n        current_strength = _calculate_strength(ext_name)\n        current_extension_info = ExtensionInfo(name=ext_name, strength=current_strength, original_index=i)\n\n        if strongest_extension_info is None:\n            strongest_extension_info = current_extension_info\n        elif current_extension_info.strength > strongest_extension_info.strength:\n            strongest_extension_info = current_extension_info\n        # If current_extension_info.strength == strongest_extension_info.strength,\n        # the existing strongest_extension_info (which appeared earlier or at the same index) is kept.\n        # This satisfies the tie-breaking rule to choose the one that comes first in the list.\n\n    return f\"{class_name}.{strongest_extension_info.name}\""}
{"task_id": "HumanEval/152", "solution": "def compare(game,guess):\n    \"\"\"Calculates the absolute difference between corresponding elements of two lists.\n    Returns 0 if elements are equal, otherwise returns the absolute difference.\n    \"\"\"\n    if len(game) != len(guess):\n        raise ValueError(\"Input arrays 'game' and 'guess' must be of equal length.\")\n\n    differences = []\n    for i in range(len(game)):\n        if game[i] == guess[i]:\n            differences.append(0)\n        else:\n            differences.append(abs(game[i] - guess[i]))\n    return differences"}
{"task_id": "HumanEval/149", "solution": "def sorted_list_sum(lst):\n    \"\"\"Write a function that accepts a list of strings as a parameter,\n    deletes the strings that have odd lengths from it,\n    and returns the resulted list with a sorted order.\n    \"\"\"\n    even_length_strings = []\n    for s in lst:\n        if len(s) % 2 == 0:\n            even_length_strings.append(s)\n\n    even_length_strings.sort(key=lambda x: (len(x), x))\n    return even_length_strings"}
{"task_id": "HumanEval/151", "solution": "def double_the_difference(lst):\n    '''\n    Given a list of numbers, return the sum of squares of the numbers\n    in the list that are odd. Ignore numbers that are negative or not integers.\n    '''\n    total_sum = 0\n\n    def _is_integer(element):\n        # Checks if element is an int or a float that is numerically an integer.\n        return isinstance(element, int) or (isinstance(element, float) and element.is_integer())\n\n    def _is_non_negative(number):\n        # Checks if number is greater than or equal to zero.\n        return number >= 0\n\n    def _is_odd(number):\n        # Checks if the number is odd.\n        return number % 2 != 0\n\n    for num in lst:\n        if _is_integer(num):\n            # Convert to int for consistent type handling after validation.\n            int_num = int(num)\n            if _is_non_negative(int_num) and _is_odd(int_num):\n                total_sum += int_num * int_num\n\n    return total_sum"}
{"task_id": "HumanEval/155", "solution": "def even_odd_count(num):\n    \"\"\"Given an integer. return a tuple that has the number of even and odd digits respectively.\n\n    Example:\n        even_odd_count(-12) ==> (1, 1)\n        even_odd_count(123) ==> (1, 2)\n    \"\"\"\n    even_count = 0\n    odd_count = 0\n\n    abs_num = abs(num)\n\n    if abs_num == 0:\n        return (1, 0)\n\n    while abs_num > 0:\n        digit = abs_num % 10\n        if digit % 2 == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n        abs_num //= 10\n\n    return (even_count, odd_count)"}
{"task_id": "HumanEval/154", "solution": "def _generate_rotations(s):\n    \"\"\"Generates all unique cyclic rotations of a given string.\n    \"\"\"\n    if not s:\n        return {\"\"}\n    rotations = set()\n    n = len(s)\n    for i in range(n):\n        rotated_s = s[i:] + s[:i]\n        rotations.add(rotated_s)\n    return rotations\n\ndef _is_substring(main_str, sub_str):\n    \"\"\"Checks if sub_str is a substring of main_str.\n    \"\"\"\n    return sub_str in main_str\n\ndef cycpattern_check(a , b):\n    \"\"\"You are given 2 words. You need to return True if the second word or any of its rotations is a substring in the first word\n    cycpattern_check(\"abcd\",\"abd\") => False\n    cycpattern_check(\"hello\",\"ell\") => True\n    cycpattern_check(\"whassup\",\"psus\") => False\n    cycpattern_check(\"abab\",\"baa\") => True\n    cycpattern_check(\"efef\",\"eeff\") => False\n    cycpattern_check(\"himenss\",\"simen\") => True\n\n    \"\"\"\n    if not b:\n        return True\n    if not a:\n        return False\n\n    rotations_of_b = _generate_rotations(b)\n\n    for rotation in rotations_of_b:\n        if _is_substring(a, rotation):\n            return True\n    return False"}
{"task_id": "HumanEval/156", "solution": "def int_to_mini_roman(number):\n    \"\"\"\n    Given a positive integer, obtain its roman numeral equivalent as a string,\n    and return it in lowercase.\n    Restrictions: 1 <= num <= 1000\n\n    Examples:\n    >>> int_to_mini_roman(19) == 'xix'\n    >>> int_to_mini_roman(152) == 'clii'\n    >>> int_to_mini_roman(426) == 'cdxxvi'\n    \"\"\"\n    roman_map = [\n        (1000, 'M'), (900, 'CM'), (500, 'D'), (400, 'CD'),\n        (100, 'C'), (90, 'XC'), (50, 'L'), (40, 'XL'),\n        (10, 'X'), (9, 'IX'), (5, 'V'), (4, 'IV'), (1, 'I')\n    ]\n    \n    # The design context indicates validation should happen, but the requirements\n    # specify not to add isinstance() checks or raise exceptions for edge cases.\n    # Therefore, assume input is valid (1 <= number <= 1000) as per restrictions.\n\n    roman_numeral = []\n    for value, symbol in roman_map:\n        while number >= value:\n            roman_numeral.append(symbol)\n            number -= value\n    \n    return \"\".join(roman_numeral).lower()"}
{"task_id": "HumanEval/157", "solution": "import math\n\ndef right_angle_triangle(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle. Return True if the three\n    sides form a right-angled triangle, False otherwise.\n    A right-angled triangle is a triangle in which one angle is right angle or \n    90 degree.\n    Example:\n    right_angle_triangle(3, 4, 5) == True\n    right_angle_triangle(1, 2, 3) == False\n    '''\n    sides = sorted([a, b, c])\n    s1, s2, s3 = sides[0], sides[1], sides[2]\n    # Check if the square of the longest side equals the sum of squares of the other two sides, accounting for floating-point precision.\n    return math.isclose(s1**2 + s2**2, s3**2)"}
{"task_id": "HumanEval/162", "solution": "import hashlib\nfrom typing import Optional\n\ndef string_to_md5(text: str) -> Optional[str]:\n    \"\"\"\n    Given a string 'text', return its md5 hash equivalent string.\n    If 'text' is an empty string, return None.\n    \"\"\"\n    if not text:\n        return None\n    # Encode the string to bytes before hashing\n    text_bytes = text.encode('utf-8')\n    md5_hash = hashlib.md5(text_bytes).hexdigest()\n    return md5_hash"}
{"task_id": "HumanEval/158", "solution": "import collections\n\n\ndef find_max(words):\n    \"\"\"Write a function that accepts a list of strings.\n    The list contains different words. Return the word with maximum number\n    of unique characters. If multiple strings have maximum number of unique\n    characters, return the one which comes first in lexicographical order.\n    \"\"\"\n\n    def _count_unique_characters(word):\n        \"\"\"Calculates the number of unique characters in a string.\"\"\"\n        return len(set(word))\n\n    max_unique_count = -1\n    result_word = \"\"\n\n    for word in words:\n        current_unique_count = _count_unique_characters(word)\n\n        if current_unique_count > max_unique_count:\n            max_unique_count = current_unique_count\n            result_word = word\n        elif current_unique_count == max_unique_count:\n            # Tie-breaking: return the one which comes first in lexicographical order\n            if result_word == \"\" or word < result_word:\n                result_word = word\n    \n    return result_word"}
{"task_id": "HumanEval/159", "solution": "def eat(number, need, remaining):\n    \"\"\"\n    You're a hungry rabbit, and you already have eaten a certain number of carrots,\n    but now you need to eat more carrots to complete the day's meals.\n    you should return an array of [ total number of eaten carrots after your meals,\n                                    the number of carrots left after your meals ]\n    if there are not enough remaining carrots, you will eat all remaining carrots, but will still be hungry.\n    \"\"\"\n    carrots_eaten_in_meal = min(need, remaining)\n    total_eaten = number + carrots_eaten_in_meal\n    final_remaining = remaining - carrots_eaten_in_meal\n    return [total_eaten, final_remaining]"}
{"task_id": "HumanEval/163", "solution": "def generate_integers(a, b):\n    \"\"\"\n    Given two positive integers a and b, return the even digits between a\n    and b, in ascending order.\n\n    For example:\n    generate_integers(2, 8) => [2, 4, 6, 8]\n    generate_integers(8, 2) => [2, 4, 6, 8]\n    generate_integers(10, 14) => []\n    \"\"\"\n    actual_min = min(a, b)\n    actual_max = max(a, b)\n    \n    even_single_digits = [0, 2, 4, 6, 8]\n    result = []\n    \n    for digit in even_single_digits:\n        if actual_min <= digit <= actual_max:\n            result.append(digit)\n            \n    return result"}
{"task_id": "HumanEval/161", "solution": "def solve(s):\n    \"\"\"\n    Transforms the input string by reversing the case of letters or reversing the entire string if it contains no letters.\n    \"\"\"\n\n    def _is_letter(char):\n        \"\"\"Checks if a character is an alphabetic letter.\"\"\"\n        return char.isalpha()\n\n    def _reverse_case(char):\n        \"\"\"Reverses the case of an alphabetic character.\"\"\"\n        return char.swapcase()\n\n    def _contains_letters(s):\n        \"\"\"Determines if the input string contains any alphabetic letters.\"\"\"\n        for char in s:\n            if _is_letter(char):\n                return True\n        return False\n\n    def _transform_char_by_char(s):\n        \"\"\"Applies case reversal to letters, keeping non-letters unchanged.\"\"\"\n        transformed_chars = []\n        for char in s:\n            if _is_letter(char):\n                transformed_chars.append(_reverse_case(char))\n            else:\n                transformed_chars.append(char)\n        return \"\".join(transformed_chars)\n\n    def _reverse_string(s):\n        \"\"\"Reverses the entire input string.\"\"\"\n        return s[::-1]\n\n    if _contains_letters(s):\n        return _transform_char_by_char(s)\n    else:\n        return _reverse_string(s)"}
{"task_id": "HumanEval/160", "solution": "class InvalidInputError(Exception):\n    \"\"\"Custom exception for invalid input data.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\n\nclass UnsupportedOperatorError(InvalidInputError):\n    \"\"\"Custom exception for unsupported operators.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n\nclass MathematicalError(Exception):\n    \"\"\"Custom exception for mathematical errors during evaluation.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\n\nclass InputValidator:\n    SUPPORTED_OPERATORS = {'+', '-', '*', '//', '**'}\n\n    @staticmethod\n    def validate_inputs(operators: list[str], operands: list[int]) -> None:\n        \"\"\"Validates input lists against defined rules, raising specific exceptions on failure.\"\"\"\n        if not operators or len(operators) < 1:\n            raise InvalidInputError(\"Operator list must have at least one operator.\")\n\n        if not operands or len(operands) < 2:\n            raise InvalidInputError(\"Operand list must have at least two operands.\")\n\n        if len(operators) != len(operands) - 1:\n            raise InvalidInputError(\"Length mismatch: operator list length must be operand list length minus one.\")\n\n        for i, operand in enumerate(operands):\n            if not isinstance(operand, int) or operand < 0:\n                raise InvalidInputError(f\"Operand at index {i} is not a non-negative integer: {operand}\")\n\n        for i, op in enumerate(operators):\n            if op not in InputValidator.SUPPORTED_OPERATORS:\n                raise UnsupportedOperatorError(f\"Operator at index {i} is not supported: '{op}'. Supported operators are {', '.join(sorted(InputValidator.SUPPORTED_OPERATORS))}\")\n\nclass AlgebraicExpressionEvaluator:\n    @staticmethod\n    def _build_expression_string(operators: list[str], operands: list[int]) -> str:\n        \"\"\"Constructs the algebraic expression string by interleaving operands and operators.\"\"\"\n        expression_parts = []\n        for i in range(len(operands)):\n            expression_parts.append(str(operands[i]))\n            if i < len(operators):\n                expression_parts.append(operators[i])\n        return ' '.join(expression_parts)\n\n    @staticmethod\n    def _evaluate_expression_string(expression_string: str) -> float | int:\n        \"\"\"Evaluates the given expression string and handles potential mathematical errors.\"\"\"\n        try:\n            result = eval(expression_string)\n            return int(result) if result == int(result) else float(result)\n        except (SyntaxError, TypeError, NameError, ZeroDivisionError, OverflowError) as e:\n            raise MathematicalError(f\"Error during expression evaluation: {e}\") from e\n\n    @staticmethod\n    def evaluate(operators: list[str], operands: list[int]) -> float | int:\n        \"\"\"Orchestrates input validation, expression string building, and evaluation.\"\"\"\n        InputValidator.validate_inputs(operators, operands)\n        expression_string = AlgebraicExpressionEvaluator._build_expression_string(operators, operands)\n        result = AlgebraicExpressionEvaluator._evaluate_expression_string(expression_string)\n        return result\n\ndef do_algebra(operator: list[str], operand: list[int]) -> float | int:\n    \"\"\"\n    Given two lists operator, and operand, build an algebraic expression and return its evaluation.\n    \"\"\"\n    return AlgebraicExpressionEvaluator.evaluate(operator, operand)"}
