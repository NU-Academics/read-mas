{"task_id": "HumanEval/33", "solution": "def sort_third(l: list):\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the indicies that are not divisible by three, while its values at the indicies that are divisible by three are equal\n    to the values of the corresponding indicies of l, but sorted.\n    >>> sort_third([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_third([5, 6, 3, 4, 8, 9, 2])\n    [2, 6, 3, 4, 8, 9, 5]\n    \"\"\"\n    l_prime = list(l) # Create a shallow copy of the input list.\n    elements_to_sort = []\n    divisible_indices = []\n\n    for i in range(len(l)):\n        if i % 3 == 0:\n            elements_to_sort.append(l[i])\n            divisible_indices.append(i)\n\n    elements_to_sort.sort() # Sort the collected elements.\n\n    for i in range(len(divisible_indices)):\n        original_index = divisible_indices[i]\n        sorted_value = elements_to_sort[i]\n        l_prime[original_index] = sorted_value\n\n    return l_prime"}
{"task_id": "HumanEval/32", "solution": "import math\n\n\ndef poly(xs: list, x: float):\n    \"\"\"\n    Evaluates polynomial with coefficients xs at point x.\n    return xs[0] + xs[1] * x + xs[1] * x^2 + .... xs[n] * x^n\n    \"\"\"\n    return sum([coeff * math.pow(x, i) for i, coeff in enumerate(xs)])\n\n\ndef find_zero(xs: list):\n    \"\"\" xs are coefficients of a polynomial.\n    find_zero find x such that poly(x) = 0.\n    find_zero returns only only zero point, even if there are many.\n    Moreover, find_zero only takes list xs having even number of coefficients\n    and largest non zero coefficient as it guarantees\n    a solution.\n    >>> round(find_zero([1, 2]), 2) # f(x) = 1 + 2x\n    -0.5\n    >>> round(find_zero([-6, 11, -6, 1]), 2) # (x - 1) * (x - 2) * (x - 3) = -6 + 11x - 6x^2 + x^3\n    1.0\n    \"\"\"\n\n    def poly_derivative(coeffs: list, x_val: float) -> float:\n        \"\"\"Evaluates the derivative of a polynomial with coefficients coeffs at point x_val.\"\"\"\n        derivative_coeffs = [i * coeffs[i] for i in range(1, len(coeffs))]\n        return sum([coeff * math.pow(x_val, i) for i, coeff in enumerate(derivative_coeffs)])\n\n    x = 0.0  # Initial guess for Newton's method\n    max_iterations = 100\n    tolerance = 1e-7\n\n    for _ in range(max_iterations):\n        poly_val = poly(xs, x)\n        deriv_val = poly_derivative(xs, x)\n\n        if abs(poly_val) < tolerance:\n            return x\n\n        if abs(deriv_val) < 1e-10:\n            # Derivative is too small, Newton's method may fail.\n            # As per docstring, a solution is guaranteed for valid inputs,\n            # so this scenario should ideally not be problematic near a root.\n            return x # Return current approximation\n\n        x_next = x - poly_val / deriv_val\n        if abs(x_next - x) < tolerance:\n            return x_next\n\n        x = x_next\n    \n    return x # Return best approximation after max_iterations"}
{"task_id": "HumanEval/36", "solution": "def fizz_buzz(n: int):\n    \"\"\"Return the number of times the digit 7 appears in integers less than n which are divisible by 11 or 13.\n    >>> fizz_buzz(50)\n    0\n    >>> fizz_buzz(78)\n    2\n    >>> fizz_buzz(79)\n    3\n    \"\"\"\n    total_count_of_seven = 0\n    for number in range(1, n):\n        if number % 11 == 0 or number % 13 == 0:\n            total_count_of_seven += str(number).count('7')\n    return total_count_of_seven"}
{"task_id": "HumanEval/40", "solution": "def triples_sum_to_zero(l: list):\n    \"\"\"\n    triples_sum_to_zero takes a list of integers as an input.\n    it returns True if there are three distinct elements in the list that\n    sum to zero, and False otherwise.\n    \"\"\"\n    # If the list has fewer than 3 elements, it's impossible to form a triplet.\n    if len(l) < 3:\n        return False\n\n    n = len(l)\n    # Iterate through all unique combinations of three distinct elements (by index).\n    for i in range(n - 2):\n        for j in range(i + 1, n - 1):\n            for k in range(j + 1, n):\n                # Check if the sum of the three distinct elements is zero.\n                if l[i] + l[j] + l[k] == 0:\n                    return True\n\n    # If no zero-sum triplet is found after checking all combinations, return False.\n    return False"}
{"task_id": "HumanEval/37", "solution": "```python\ndef sort_even(l: list):\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the odd indicies, while its values at the even indicies are equal\n    to the values of the even indicies of l, but sorted.\n    >>> sort_even([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_even([5, 6, 3, 4])\n    [3, 6, 5, 4]\n    \"\"\"\n    result = l[:]  # Create a shallow copy of l for the output list\n    even_indexed_values = []\n    \n    # Extract values from even indices\n    for i in range(0, len(l), 2):\n        even_indexed_values.append(l[i])\n        \n    even_indexed_values.sort()  # Sort the extracted values\n    \n    # Place sorted values back into even indices of the result list\n    sorted_idx = 0\n    for i in range(0, len(result), 2):\n        result[i] = even_indexed_values[sorted_idx]\n        sorted_idx += 1\n        \n    return result\n```"}
