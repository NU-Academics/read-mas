{"task_id": "Mbpp/260", "solution": "def newman_prime(n):\n    \"\"\"Find the nth Newman-Shanks-Williams prime number. These are primes of the form (2^m - 1)/3 where m is odd.\"\"\"\n    \n    def is_prime(num):\n        if num < 2:\n            return False\n        if num == 2:\n            return True\n        if num % 2 == 0:\n            return False\n        for i in range(3, int(num ** 0.5) + 1, 2):\n            if num % i == 0:\n                return False\n        return True\n    \n    count = 0\n    m = 1\n    \n    while count < n:\n        if m % 2 == 1:\n            candidate = (2 ** m - 1) // 3\n            if candidate > 0 and (2 ** m - 1) % 3 == 0 and is_prime(candidate):\n                count += 1\n                if count == n:\n                    return candidate\n        m += 1\n    \n    return None"}
{"task_id": "Mbpp/260", "solution": "def newman_prime(n):\n    \"\"\"Find the nth Newman-Shanks-Williams prime number.\"\"\"\n    def s_sequence(k):\n        if k == 0:\n            return 1\n        elif k == 1:\n            return 1\n        else:\n            a, b = 1, 1\n            for i in range(2, k + 1):\n                a, b = b, 2 * b - a\n            return b\n    \n    def is_prime(num):\n        if num < 2:\n            return False\n        if num == 2:\n            return True\n        if num % 2 == 0:\n            return False\n        for i in range(3, int(num ** 0.5) + 1, 2):\n            if num % i == 0:\n                return False\n        return True\n    \n    count = 0\n    k = 1\n    while count < n:\n        candidate = (2 * s_sequence(k) - 1) // 3\n        if candidate > 0 and is_prime(candidate):\n            count += 1\n            if count == n:\n                return candidate\n        k += 1"}
