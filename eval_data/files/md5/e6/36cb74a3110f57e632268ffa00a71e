{"task_id": "HumanEval/39", "solution": "from typing import Iterator\nclass InvalidInputError(Exception):\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\nclass PrimalityChecker:\n    def is_prime(self, num: int) -> bool:\n        if num <= 1:\n            return False\n        if num <= 3:\n            return True\n        if num % 2 == 0 or num % 3 == 0:\n            return False\n\n        i = 5\n        while i * i <= num:\n            if num % i == 0 or num % (i + 2) == 0:\n                return False\n            i += 6\n        return True\nclass FibonacciGenerator:\n    def generate_sequence(self) -> Iterator[int]:\n        a, b = 0, 1\n        while True:\n            yield a\n            a, b = b, a + b\ndef prime_fib(n: int):\n    \"\"\"\n    prime_fib returns n-th number that is a Fibonacci number and it's also prime.\n    >>> prime_fib(1)\n    2\n    >>> prime_fib(2)\n    3\n    >>> prime_fib(3)\n    5\n    >>> prime_fib(4)\n    13\n    >>> prime_fib(5)\n    89\n    \"\"\"\n    if n < 1:\n        raise InvalidInputError(\"Input 'n' must be a positive integer.\")\n\n    prime_fib_count = 0\n    fib_generator = FibonacciGenerator()\n    primality_checker = PrimalityChecker()\n    fib_sequence = fib_generator.generate_sequence()\n\n    MAX_FIB_ITERATIONS = 10000 # Safeguard to prevent excessive computation for very large n.\n    current_fib_index = 0\n\n    while current_fib_index < MAX_FIB_ITERATIONS:\n        fib_num = next(fib_sequence)\n        current_fib_index += 1\n\n        if fib_num <= 1: # 0 and 1 are not prime numbers.\n            continue\n\n        if primality_checker.is_prime(fib_num):\n            prime_fib_count += 1\n            if prime_fib_count == n:\n                return fib_num\n    \n    raise ValueError(f\"Could not find the {n}-th prime Fibonacci number within {MAX_FIB_ITERATIONS} Fibonacci numbers.\")"}
