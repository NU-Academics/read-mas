{"task_id": "HumanEval/46", "solution": "def fib4(n: int):\n    \"\"\"The Fib4 number sequence is a sequence similar to the Fibbonacci sequnece that's defined as follows:\n    fib4(0) -> 0\n    fib4(1) -> 0\n    fib4(2) -> 2\n    fib4(3) -> 0\n    fib4(n) -> fib4(n-1) + fib4(n-2) + fib4(n-3) + fib4(n-4).\n    Please write a function to efficiently compute the n-th element of the fib4 number sequence.  Do not use recursion.\n    >>> fib4(5)\n    4\n    >>> fib4(6)\n    8\n    >>> fib4(7)\n    14\n    \"\"\"\n    FIB4_BASE_CASES = {\n        0: 0,\n        1: 0,\n        2: 2,\n        3: 0\n    }\n\n    if n in FIB4_BASE_CASES:\n        return FIB4_BASE_CASES[n]\n\n    # Initialize a list for dynamic programming to store intermediate results.\n    # This avoids recursion and provides O(n) time complexity.\n    dp = [0] * (n + 1)\n    dp[0] = FIB4_BASE_CASES[0]\n    dp[1] = FIB4_BASE_CASES[1]\n    dp[2] = FIB4_BASE_CASES[2]\n    dp[3] = FIB4_BASE_CASES[3]\n\n    for i in range(4, n + 1):\n        dp[i] = dp[i-1] + dp[i-2] + dp[i-3] + dp[i-4]\n\n    return dp[n]"}
{"task_id": "HumanEval/54", "solution": "def same_chars(s0: str, s1: str):\n    \"\"\"\n    Check if two words have the same characters.\n    >>> same_chars('eabcdzzzz', 'dddzzzzzzzddeddabc')\n    True\n    >>> same_chars('abcd', 'dddddddabc')\n    True\n    >>> same_chars('dddddddabc', 'abcd')\n    True\n    >>> same_chars('eabcd', 'dddddddabc')\n    False\n    >>> same_chars('abcd', 'dddddddabce')\n    False\n    >>> same_chars('eabcdzzzz', 'dddzzzzzzzddddabc')\n    False\n    \"\"\"\n    return set(s0) == set(s1)"}
{"task_id": "HumanEval/49", "solution": "def modp(n: int, p: int):\n    \"\"\"Return 2^n modulo p using modular exponentiation by squaring.\n    This method efficiently calculates (base^n) % p for large n values.\n    \"\"\"\n    result = 1\n    base = 2 % p  # Initialize base as 2 mod p\n    while n > 0:\n        if n % 2 == 1:\n            result = (result * base) % p\n        base = (base * base) % p\n        n //= 2\n    return result"}
