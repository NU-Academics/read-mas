{"task_id": "HumanEval/19", "solution": "from typing import List\nclass InvalidNumberWordError(ValueError):\n    \"\"\"Custom exception for invalid number words.\"\"\"\n    pass\nclass NumberWordMapper:\n    \"\"\"Provides bidirectional mapping between number words and integers.\"\"\"\n\n    NUMBER_WORD_MAP = {\n        \"zero\": 0, \"one\": 1, \"two\": 2, \"three\": 3, \"four\": 4,\n        \"five\": 5, \"six\": 6, \"seven\": 7, \"eight\": 8, \"nine\": 9\n    }\n\n    INT_WORD_MAP = {\n        0: \"zero\", 1: \"one\", 2: \"two\", 3: \"three\", 4: \"four\",\n        5: \"five\", 6: \"six\", 7: \"seven\", 8: \"eight\", 9: \"nine\"\n    }\n\n    def word_to_int(self, word: str) -> int:\n        \"\"\"Converts a number word to its integer equivalent.\n        Raises InvalidNumberWordError if the word is not found.\"\"\"\n        if not self.is_valid_word(word):\n            raise InvalidNumberWordError(f\"'{word}' is not a valid number word.\")\n        return self.NUMBER_WORD_MAP[word]\n\n    def int_to_word(self, num: int) -> str:\n        \"\"\"Converts an integer to its number word string.\n        Raises ValueError if the integer is out of range (0-9).\"\"\"\n        if num not in self.INT_WORD_MAP:\n            raise ValueError(f\"'{num}' is out of range (0-9) for number word conversion.\")\n        return self.INT_WORD_MAP[num]\n\n    def is_valid_word(self, word: str) -> bool:\n        \"\"\"Checks if a string is a valid number word.\"\"\"\n        return word in self.NUMBER_WORD_MAP\nclass NumberSorterService:\n    \"\"\"Encapsulates the core business logic for sorting number words.\"\"\"\n\n    def __init__(self, mapper: NumberWordMapper):\n        \"\"\"Initializes the service with a NumberWordMapper instance.\"\"\"\n        self._mapper = mapper\n\n    def sort_number_words(self, words: List[str]) -> List[str]:\n        \"\"\"Converts number words to integers, sorts them, and converts them back to sorted number words.\"\"\"\n        if not words:\n            return []\n\n        integer_list: List[int] = []\n        for word in words:\n            integer_list.append(self._mapper.word_to_int(word))\n\n        integer_list.sort()\n\n        sorted_words: List[str] = []\n        for num in integer_list:\n            sorted_words.append(self._mapper.int_to_word(num))\n\n        return sorted_words\n_number_word_mapper = NumberWordMapper()\n_number_sorter_service = NumberSorterService(mapper=_number_word_mapper)\ndef sort_numbers(numbers: str) -> str:\n    \"\"\" Input is a space-delimited string of numberals from 'zero' to 'nine'.\n    Valid choices are 'zero', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight' and 'nine'.\n    Return the string with numbers sorted from smallest to largest\n    >>> sort_numbers('three one five')\n    'one three five'\n    \"\"\"\n    if not isinstance(numbers, str):\n        raise TypeError(\"Input 'numbers' must be a string.\")\n\n    if not numbers.strip():\n        return ''\n\n    word_list: List[str] = numbers.split(' ')\n\n    try:\n        sorted_word_list: List[str] = _number_sorter_service.sort_number_words(word_list)\n        return ' '.join(sorted_word_list)\n    except InvalidNumberWordError as e:\n        raise ValueError(f\"Invalid input: {e}\") from e"}
{"task_id": "HumanEval/25", "solution": "def factorize(n: int) -> List[int]:\n    \"\"\" Return list of prime factors of given integer in the order from smallest to largest.\n    Each of the factors should be listed number of times corresponding to how many times it appeares in factorization.\n    Input number should be equal to the product of all factors\n    >>> factorize(8)\n    [2, 2, 2]\n    >>> factorize(25)\n    [5, 5]\n    >>> factorize(70)\n    [2, 5, 7]\n    \"\"\"\n    if n < 2:\n        raise ValueError(\"Input number must be 2 or greater.\")\n\n    factors: List[int] = []\n    divisor = 2\n    temp_n = n\n\n    while temp_n > 1:\n        if temp_n % divisor == 0:\n            factors.append(divisor)\n            temp_n //= divisor\n        else:\n            divisor += 1\n    return factors"}
{"task_id": "HumanEval/26", "solution": "from typing import List\nfrom collections import Counter\ndef remove_duplicates(numbers: List[int]) -> List[int]:\n    \"\"\" From a list of integers, remove all elements that occur more than once.\n    Keep order of elements left the same as in the input.\n    >>> remove_duplicates([1, 2, 3, 2, 4])\n    [1, 3, 4]\n    \"\"\"\n    if not numbers:\n        return []\n\n    counts = Counter(numbers)\n    result = []\n    for num in numbers:\n        if counts[num] == 1:\n            result.append(num)\n\n    return result"}
