{"task_id": "Mbpp/75", "solution": "def find_tuples(lst: list[tuple[int, ...]], k: int) -> list[tuple[int, ...]]:\n    \"\"\"\n    Finds tuples in a list where all elements are divisible by k.\n\n    Parameters:\n    - lst: iterable of tuples of ints\n    - k: non-zero integer divisor\n\n    Returns:\n    - list of tuples from lst where every element is divisible by k\n\n    Raises:\n    - ValueError: if k is not an int or is zero\n    - TypeError: if lst is not iterable, an item is not a tuple, or tuple elements are not ints\n    \"\"\"\n    # Validate k\n    if not isinstance(k, int) or k == 0:\n        raise ValueError(\"k must be a non-zero int\")\n\n    # Ensure lst is iterable\n    try:\n        iterator = iter(lst)\n    except TypeError:\n        raise TypeError(\"lst must be an iterable of tuples of ints\")\n\n    result: list[tuple[int, ...]] = []\n    for item in iterator:\n        if not isinstance(item, tuple):\n            raise TypeError(\"each item in lst must be a tuple\")\n        # Validate elements are ints\n        for e in item:\n            if not isinstance(e, int):\n                raise TypeError(\"all elements in tuples must be ints\")\n        # Check divisibility (empty tuple is vacuously True)\n        if all(e % k == 0 for e in item):\n            result.append(item)\n\n    return result"}
{"task_id": "Mbpp/80", "solution": "class InvalidTypeError(ValueError):\n    \"\"\"Raised when the input 'n' is not an integer.\"\"\"\n    pass\n\nclass NegativeInputError(ValueError):\n    \"\"\"Raised when the input 'n' is negative.\"\"\"\n    pass\n\nclass InputValidator:\n    \"\"\"Validates input 'n' for the tetrahedral number calculation.\"\"\"\n    @staticmethod\n    def validate(n):\n        \"\"\"Checks if n is a non-negative integer, raising errors if not.\"\"\"\n        if not isinstance(n, int):\n            raise InvalidTypeError(\"Input 'n' must be an integer.\")\n        if n < 0:\n            raise NegativeInputError(\"Input 'n' must be a non-negative integer.\")\n\nclass TetrahedralFunction:\n    \"\"\"Computes the nth tetrahedral number using the closed-form formula.\"\"\"\n    def compute(self, n: int) -> int:\n        \"\"\"Calculates n*(n+1)*(n+2)/6, assuming n is a validated non-negative integer.\"\"\"\n        return (n * (n + 1) * (n + 2)) // 6\n\ndef tetrahedral_number(n: int) -> int:\n    \"\"\"\n    Calculates the nth tetrahedral number.\n    Raises InvalidTypeError if n is not an integer or NegativeInputError if n is negative.\n    \"\"\"\n    InputValidator.validate(n)\n    return TetrahedralFunction().compute(n)"}
{"task_id": "Mbpp/85", "solution": "import math\n\nclass NumericValidator:\n    \"\"\"Validates numeric inputs for type and value constraints.\"\"\"\n    def validate_type(self, value):\n        \"\"\"Raises TypeError if value is not int/float or is bool.\"\"\"\n        if isinstance(value, bool) or not isinstance(value, (int, float)):\n            raise TypeError(\"radius must be int or float and not boolean\")\n\n    def validate_value(self, value):\n        \"\"\"Raises ValueError if value is NaN, infinite, or negative.\"\"\"\n        if math.isnan(value) or math.isinf(value):\n            raise ValueError(\"radius must be finite and not NaN or infinity\")\n        if value < 0:\n            raise ValueError(\"radius must be non-negative\")\n\nclass Sphere:\n    \"\"\"Represents a sphere and computes its surface area.\"\"\"\n    def __init__(self, radius: float):\n        self.radius = float(radius)\n\n    def compute_surface_area(self) -> float:\n        \"\"\"Computes the surface area using A = 4 * pi * r^2.\"\"\"\n        return 4 * math.pi * self.radius * self.radius\n\nclass SurfaceAreaResult:\n    \"\"\"A simple value object to hold the computed surface area.\"\"\"\n    def __init__(self, value: float):\n        self.value = value\n\ndef surfacearea_sphere(r) -> float:\n    \"\"\"Calculates the surface area of a sphere given its radius.\n    This function validates the input radius and delegates computation to a Sphere object.\n    \"\"\"\n    validator = NumericValidator()\n    validator.validate_type(r)\n    validator.validate_value(r)\n\n    # The design specifies r == 0 should return 0.0. The formula naturally handles this.\n    sphere = Sphere(r)\n    area = sphere.compute_surface_area()\n\n    result_obj = SurfaceAreaResult(area)\n    return result_obj.value"}
{"task_id": "Mbpp/82", "solution": "import math\n\nPI = math.pi\n\ndef _validate_numeric(value) -> None:\n    \"\"\"Validates if the input value is a number (int or float).\n    Raises TypeError if the value is not numeric.\n    \"\"\"\n    if not isinstance(value, (int, float)):\n        raise TypeError(\"non-numeric radius\")\n\ndef _validate_non_negative(value: float) -> None:\n    \"\"\"Validates if the numeric input value is non-negative.\n    Raises ValueError if the value is negative.\n    \"\"\"\n    if value < 0.0:\n        raise ValueError(\"negative radius\")\n\ndef volume_sphere(radius: float) -> float:\n    \"\"\"Calculates the volume of a sphere given its radius.\n    Handles non-numeric or negative radius with appropriate exceptions.\n    \"\"\"\n    _validate_numeric(radius)\n    _validate_non_negative(radius)\n\n    if radius == 0.0:\n        return 0.0\n\n    # Formula: V = (4/3) * pi * r^3\n    return (4.0 / 3.0) * PI * (radius ** 3)"}
{"task_id": "Mbpp/86", "solution": "def centered_hexagonal_number(n):\n    \"\"\"Calculates the nth centered hexagonal number using the formula C(n) = 3 * n * (n - 1) + 1.\n\n    Args:\n        n (int): The index (must be an integer >= 1).\n\n    Returns:\n        int: The nth centered hexagonal number.\n\n    Raises:\n        TypeError: If n is not an int.\n        ValueError: If n < 1.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n    if n < 1:\n        raise ValueError(\"n must be >= 1\")\n    return 3 * n * (n - 1) + 1"}
{"task_id": "Mbpp/87", "solution": "def merge_dictionaries_three(dict1: dict, dict2: dict, dict3: dict) -> dict:\n    \"\"\"Merges three dictionaries into a new dictionary, with dict3 overriding dict2, and dict2 overriding dict1.\"\"\"\n    if not (isinstance(dict1, dict) and isinstance(dict2, dict) and isinstance(dict3, dict)):\n        raise TypeError(\"All arguments must be dict\")\n\n    result = dict1.copy()\n    result.update(dict2)\n    result.update(dict3)\n    return result"}
{"task_id": "Mbpp/88", "solution": "def freq_count(lst: list) -> dict:\n    \"\"\"\n    Calculates the frequency of elements in a list.\n    Returns a dictionary where keys are elements and values are their counts.\n    \"\"\"\n    counts = {}\n    for element in lst:\n        counts[element] = counts.get(element, 0) + 1\n    return counts"}
{"task_id": "Mbpp/84", "solution": "def sequence(n: int) -> int:\n    \"\"\"Finds the nth number in the Newman\u2013Conway sequence.\n\n    Args:\n        n (int): The 1-based index (must be >= 1) of the desired number.\n\n    Returns:\n        int: The nth Newman\u2013Conway number.\n    \"\"\"\n    if not isinstance(n, int) or n < 1:\n        raise ValueError(\"n must be an integer >= 1\")\n\n    if n == 1 or n == 2:\n        return 1\n\n    # Initialize a list for 1-based indexing, where a[0] is unused.\n    a = [0] * (n + 1)\n    a[1] = 1\n    a[2] = 1\n\n    # Compute a[k] iteratively for k from 3 to n.\n    for k in range(3, n + 1):\n        # Apply the recurrence relation: a(k) = a(a(k-1)) + a(k - a(k-1))\n        a[k] = a[a[k - 1]] + a[k - a[k - 1]]\n\n    return a[n]"}
{"task_id": "Mbpp/89", "solution": "import math\nfrom typing import Union\n\ndef closest_num(n: Union[int, float]) -> int:\n    \"\"\"\n    Finds the largest integer strictly less than the input number n.\n    Handles int, float, negative numbers, and specific error conditions.\n    \"\"\"\n    if isinstance(n, bool):\n        raise TypeError(\"Input cannot be boolean.\")\n\n    if not isinstance(n, (int, float)):\n        raise TypeError(\"Input must be an int or a float.\")\n\n    if isinstance(n, float):\n        if math.isnan(n) or math.isinf(n):\n            raise ValueError(\"Input cannot be NaN or infinity.\")\n\n        if n.is_integer():\n            return int(n) - 1\n        else:\n            return math.floor(n)\n    else: # n is an int\n        return n - 1"}
{"task_id": "Mbpp/90", "solution": "def len_log(input_list):\n    \"\"\"Finds the length of the longest word in a list of strings. Returns 0 if the list is empty.\"\"\"\n    if not input_list:\n        return 0\n    return len(max(input_list, key=len))"}
{"task_id": "Mbpp/91", "solution": "class ValidationError(Exception):\n    \"\"\"Custom exception for validation errors.\"\"\"\n    def __init__(self, message):\n        self.message = message\n        super().__init__(self.message)\n\ndef find_substring(list_of_strings, substring):\n    \"\"\"\n    Checks if a string is present as a substring in a list of string values.\n    Raises ValidationError for invalid input types or None values.\n    \"\"\"\n    if list_of_strings is None:\n        raise ValidationError(\"list_of_strings cannot be None\")\n    if substring is None:\n        raise ValidationError(\"substring cannot be None\")\n\n    if not isinstance(list_of_strings, list):\n        raise ValidationError(\"list_of_strings must be a list\")\n    if not isinstance(substring, str):\n        raise ValidationError(\"substring must be a string\")\n\n    if not list_of_strings:\n        return False\n\n    if substring == \"\":\n        for element in list_of_strings:\n            if not isinstance(element, str):\n                raise ValidationError(\"All elements in list_of_strings must be strings\")\n            return True # empty substring considered found if list contains at least one string\n\n    for element in list_of_strings:\n        if not isinstance(element, str):\n            raise ValidationError(\"All elements in list_of_strings must be strings\")\n        if substring in element:\n            return True\n\n    return False"}
{"task_id": "Mbpp/94", "solution": "def validate_input(tuples: list) -> bool:\n    \"\"\"Validate that input is a list where every element is a 2-element tuple.\n    Returns True if valid or raises ValueError for invalid input.\"\"\"\n    if not isinstance(tuples, list):\n        raise ValueError(\"Input must be a list.\")\n    if not tuples:\n        raise ValueError(\"Input list cannot be empty.\")\n    for item in tuples:\n        if not isinstance(item, tuple):\n            raise ValueError(\"All elements in the list must be tuples.\")\n        if len(item) != 2:\n            raise ValueError(\"All tuples must have exactly two elements.\")\n    return True\n\ndef find_min_index(tuples: list) -> int:\n    \"\"\"Return index of tuple with smallest second element.\n    Tie-breaker: first encountered minimal index.\"\"\"\n    min_val = tuples[0][1]\n    min_idx = 0\n    for i in range(1, len(tuples)):\n        if tuples[i][1] < min_val:\n            min_val = tuples[i][1]\n            min_idx = i\n    return min_idx\n\ndef index_minimum(tuples: list) -> any:\n    \"\"\"Public API: Accepts a list of 2-element tuples and returns the first element of the tuple whose\n    second element is smallest. Raises ValueError for invalid input.\"\"\"\n    validate_input(tuples)\n    idx = find_min_index(tuples)\n    return tuples[idx][0]"}
{"task_id": "Mbpp/96", "solution": "import math\n\ndef divisor(n: int) -> int:\n    \"\"\"Calculates the number of positive divisors for a given integer.\n    Uses the square root method for efficient computation.\n    \"\"\"\n    m = abs(n)\n    r = math.isqrt(m)\n    count = 0\n    for i in range(1, r + 1):\n        if m % i == 0:\n            if i * i == m:\n                count += 1\n            else:\n                count += 2\n    return count"}
{"task_id": "Mbpp/92", "solution": "from typing import Union, Any\n\ndef validate_type(value: Any) -> None:\n    \"\"\"Raise TypeError if value not int or str.\n    This ensures the input is of an expected type for further processing.\"\"\"\n    if not isinstance(value, (int, str)):\n        raise TypeError(\"is_undulating: value must be int or str\")\n\ndef to_digit_string(value: Union[int, str]) -> str:\n    \"\"\"Normalize input to sign-less digit string.\n    Integers are converted to their absolute string representation; strings remove a single leading sign.\"\"\"\n    if isinstance(value, int):\n        return str(abs(value))\n    # value is str\n    if value.startswith('+') or value.startswith('-'):\n        return value[1:]\n    return value\n\ndef validate_digits(digit_str: str) -> None:\n    \"\"\"Raise ValueError if digit_str is empty or contains non-decimal characters.\n    This ensures the string contains only valid digit characters.\"\"\"\n    if digit_str == '':\n        raise ValueError(\"is_undulating: digit string is empty after sign removal\")\n    for ch in digit_str:\n        if not ('0' <= ch <= '9'):\n            raise ValueError(\"is_undulating: digit string contains non-digit characters\")\n\ndef undulating_predicate(digit_str: str) -> bool:\n    \"\"\"Evaluate undulating predicate on a validated digit string.\n    Checks for alternating digits where even-indexed digits are uniform and odd-indexed digits are uniform and different.\"\"\"\n    if len(digit_str) < 2:\n        return False\n\n    even_digit = digit_str[0]\n    odd_digit = digit_str[1]\n\n    if even_digit == odd_digit:\n        return False\n\n    for i in range(len(digit_str)):\n        if i % 2 == 0 and digit_str[i] != even_digit:\n            return False\n        if i % 2 == 1 and digit_str[i] != odd_digit:\n            return False\n\n    return True\n\ndef is_undulating(value: Union[int, str]) -> bool:\n    \"\"\"Public API to check if a number is undulating.\n    An undulating number's digits strictly alternate between two different values.\"\"\"\n    validate_type(value)\n    digit_str = to_digit_string(value)\n    validate_digits(digit_str)\n    return undulating_predicate(digit_str)"}
{"task_id": "Mbpp/95", "solution": "def Find_Min_Length(list_of_lists):\n    \"\"\"\n    Finds the length of the smallest list within a list of lists.\n    Assumes `list_of_lists` is non-empty and contains only lists.\n    \"\"\"\n    min_length = None\n    for sublist in list_of_lists:\n        current_length = len(sublist)\n        if min_length is None or current_length < min_length:\n            min_length = current_length\n    return min_length"}
{"task_id": "Mbpp/97", "solution": "from typing import Any\nfrom collections import Counter\n\ndef frequency_lists(data: list[list[Any]]) -> dict[Any, int]:\n    \"\"\"\n    Count frequencies of elements across a top-level list of sublists (flattened).\n\n    Behavior: Validates the top-level argument is a list, validates each sublist is iterable, ensures each element is hashable, aggregates counts using collections.Counter, and returns a dict mapping each element to its frequency.\n\n    Complexity: O(N) time where N is total number of elements; O(K) space where K distinct elements.\n\n    Examples:\n        >>> frequency_lists([[1,2,1],[2,3]])\n        {1: 2, 2: 2, 3: 1}\n\n    Raises:\n        TypeError: \"data must be a list\"\n        TypeError: \"sublist at index {i} is not iterable\"\n        TypeError: \"unhashable element encountered at index path {i}->{j}\"\n    \"\"\"\n    if not isinstance(data, list):\n        raise TypeError(\"data must be a list\")\n\n    counts = Counter()\n\n    for i, sub in enumerate(data):\n        # Validate sublist is iterable\n        try:\n            _ = iter(sub)\n        except TypeError:\n            raise TypeError(f\"sublist at index {i} is not iterable\")\n\n        for j, elem in enumerate(sub):\n            # Ensure element is hashable\n            try:\n                hash(elem)\n            except TypeError:\n                raise TypeError(f\"unhashable element encountered at index path {i}->{j}\")\n\n            counts[elem] += 1\n\n    return dict(counts)"}
{"task_id": "Mbpp/98", "solution": "def multiply_num(items: Iterable[Union[int, float]]) -> float:\n    \"\"\"\n    Multiply all numbers in a list and divide by the list's length.\n\n    Args:\n        items: An iterable of numbers (integers or floats).\n\n    Returns:\n        The product of all numbers divided by the count of numbers, as a float.\n\n    Raises:\n        ValueError: If the input iterable contains no elements.\n        TypeError: If a non-numeric element is found in the iterable.\n\n    Examples:\n        >>> import math\n        >>> assert math.isclose(multiply_num((8, 2, 3, -1, 7)), -67.2, rel_tol=0.001)\n    \"\"\"\n    try:\n        n = len(items)\n        sequence_to_process = items\n    except TypeError:  # items does not implement __len__ (e.g., generator)\n        sequence_to_process = list(items)\n        n = len(sequence_to_process)\n\n    if n == 0:\n        raise ValueError(\"multiply_num: input contains no elements\")\n\n    product = 1\n    for i, elem in enumerate(sequence_to_process):\n        if not isinstance(elem, numbers.Real):\n            raise TypeError(f\"multiply_num: non-numeric element at index {i}: {repr(elem)}\")\n        product *= elem\n\n    return float(product) / n"}
{"task_id": "Mbpp/93", "solution": "import math\n\ndef fast_pow_int(base, exp):\n    \"\"\"Computes base to the power of a non-negative integer exponent using exponentiation by squaring.\"\"\"\n    res = 1\n    curr_base = base\n    e = exp\n    while e > 0:\n        if e % 2 == 1:\n            res *= curr_base\n        curr_base *= curr_base\n        e //= 2\n    return res\n\ndef exp_log(base, exp):\n    \"\"\"Computes base to a non-integer exponent using math.exp and math.log. Expects base > 0.\"\"\"\n    return math.exp(exp * math.log(base))\n\ndef power(a, b):\n    \"\"\"Calculates 'a' to the power 'b' with explicit error handling and return-type rules.\"\"\"\n    if not isinstance(a, (int, float)) or not isinstance(b, (int, float)):\n        raise TypeError('power: a and b must be int or float')\n\n    if a == 0 and b == 0:\n        return 1 if isinstance(a, int) and isinstance(b, int) else 1.0\n\n    if a == 0 and b < 0:\n        raise ZeroDivisionError('power: 0 cannot be raised to a negative exponent')\n\n    if a < 0 and not isinstance(b, int):\n        raise ValueError('power: negative base with non-integer exponent is a domain error for real results')\n\n    if isinstance(b, int):\n        if b >= 0:\n            return fast_pow_int(a, b)\n        else:  # b < 0\n            denom = fast_pow_int(a, -b)\n            if denom == 0:\n                raise ZeroDivisionError('power: 0 cannot be raised to a negative exponent')\n            return 1.0 / denom\n    else:  # b is float\n        if a <= 0:\n            # a == 0 handled above; a < 0 with non-integer b handled above\n            # If a is negative and b is float but integral (rare per design) still treat as float branch\n            # but math.log will fail for a <= 0, so raise for clarity\n            raise ValueError('power: base must be positive for non-integer exponent')\n        return exp_log(float(a), float(b))"}
{"task_id": "Mbpp/101", "solution": "def kth_element(sequence, k):\n    \"\"\"\n    Finds the kth element in the given array using 1-based indexing.\n    Performs strict input validation.\n    \"\"\"\n    # Validate sequence type and behavior\n    if sequence is None or not (hasattr(sequence, '__len__') and hasattr(sequence, '__getitem__')):\n        raise TypeError(\"sequence must be a sequence/array-like object\")\n\n    # Validate k type\n    if not isinstance(k, int):\n        raise TypeError(\"k must be an integer >= 1\")\n\n    # Get sequence length and validate against k\n    n = len(sequence)\n    if n == 0:\n        raise IndexError(\"sequence must not be empty\")\n\n    # Validate k is within the 1-based range\n    if k < 1 or k > n:\n        raise IndexError(f\"k must be between 1 and {n} (got {k})\")\n\n    # Return the element at the 0-based index\n    return sequence[k - 1]"}
{"task_id": "Mbpp/99", "solution": "def decimal_to_binary(n: int) -> str:\n    \"\"\"Converts a non-negative decimal integer to its binary string representation.\n    Raises:\n        TypeError: if n is not an int\n        ValueError: if n is negative\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"decimal_to_binary: input must be int\")\n    if n < 0:\n        raise ValueError(\"decimal_to_binary: input must be non-negative\")\n    if n == 0:\n        return '0'\n    return bin(n)[2:]"}
