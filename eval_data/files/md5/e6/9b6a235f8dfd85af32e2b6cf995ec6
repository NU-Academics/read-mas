{"task_id": "Mbpp/4", "solution": "import heapq\nfrom typing import List, Iterable\n\ndef heap_queue_largest(numbers: Iterable[int], n: int) -> List[int]:\n    \"\"\"\n    Finds the n largest integers from a list of numbers, returned in descending order.\n    Handles edge cases for n <= 0 and n >= length of numbers.\n    \"\"\"\n    materialized_numbers = list(numbers)\n    num_length = len(materialized_numbers)\n\n    if n <= 0:\n        return []\n\n    if n >= num_length:\n        return sorted(materialized_numbers, reverse=True)\n\n    min_heap = []\n    for num in materialized_numbers:\n        if len(min_heap) < n:\n            heapq.heappush(min_heap, num)\n        elif num > min_heap[0]:\n            heapq.heapreplace(min_heap, num)\n\n    return sorted(min_heap, reverse=True)"}
{"task_id": "Mbpp/2", "solution": "def similar_elements(iter_a, iter_b):\n    \"\"\"Return a tuple of unique elements present in both iterables.\n    Raises TypeError if any element is unhashable (propagated from set()).\n    \"\"\"\n    set_a = set(iter_a)\n    set_b = set(iter_b)\n    inter = set_a & set_b\n    return tuple(inter)"}
{"task_id": "Mbpp/3", "solution": "def is_not_prime(n):\n    \"\"\"\n    Identifies non-prime numbers. Returns True if n is not prime, False if n is prime.\n    Handles integer inputs and integral floats, raising TypeError for other types.\n    \"\"\"\n\n    def _to_integer_if_integral_float(val):\n        \"\"\"Converts an int or integral float to an int, otherwise raises TypeError.\"\"\"\n        if isinstance(val, int):\n            return val\n        if isinstance(val, float) and val.is_integer():\n            return int(val)\n        raise TypeError('is_not_prime expects an int or an integral float')\n\n    def _integer_sqrt(val):\n        \"\"\"Computes the integer square root (floor(sqrt(val))), using math.isqrt if available.\"\"\"\n        import math\n        isqrt_fn = getattr(math, 'isqrt', None)\n        if isqrt_fn is not None:\n            return isqrt_fn(val)\n        else:\n            # Fallback for older Python versions\n            r = int(math.sqrt(val))\n            # Adjust to ensure floor(sqrt(n)) correctness\n            while (r + 1) * (r + 1) <= val:\n                r += 1\n            while r * r > val:\n                r -= 1\n            return r\n\n    m = _to_integer_if_integral_float(n)\n\n    if m <= 1:\n        return True\n    if m == 2:\n        return False\n    if m % 2 == 0:\n        return True\n\n    r = _integer_sqrt(m)\n    for d in range(3, r + 1, 2):\n        if m % d == 0:\n            return True\n    return False"}
{"task_id": "Mbpp/11", "solution": "def remove_Occ(s, ch):\n    \"\"\"\n    Removes the first and last occurrence of a given character from the string.\n    If the character is not found, the original string is returned.\n    \"\"\"\n    first_idx = s.find(ch)\n\n    if first_idx == -1:\n        return s\n\n    last_idx = s.rfind(ch)\n\n    if first_idx == last_idx:\n        # Only one occurrence\n        return s[:first_idx] + s[first_idx + 1:]\n    else:\n        # Multiple occurrences, remove first and last\n        return s[:first_idx] + s[first_idx + 1:last_idx] + s[last_idx + 1:]"}
{"task_id": "Mbpp/7", "solution": "import unicodedata\nfrom typing import List\n\ndef find_char_long(text: str) -> List[str]:\n    \"\"\"\n    Finds all words at least 4 characters long in the input string.\n\n    Words:\n    - Are composed of Unicode letters and may include internal hyphens (-) or apostrophes (').\n    - Are stripped of leading and trailing punctuation (Unicode punctuation categories) before measuring length.\n    - Preserve original casing and order in the returned list.\n\n    Args:\n        text: Input string.\n\n    Returns:\n        A list of words (strings) whose stripped form has length >= 4.\n\n    Raises:\n        TypeError: If the input is not a string.\n\n    Complexity:\n        Time: O(n) where n is the length of the input string (single pass).\n        Memory: O(m) where m is the total size of returned words plus small transient buffers.\n    \"\"\"\n    if not isinstance(text, str):\n        raise TypeError(\"Input must be a string.\")\n\n    def _is_unicode_letter(ch: str) -> bool:\n        return unicodedata.category(ch).startswith('L')\n\n    def _is_internal_hyphen_or_apostrophe(ch: str) -> bool:\n        return ch == '-' or ch == \"'\"\n\n    def _is_punctuation(ch: str) -> bool:\n        return unicodedata.category(ch).startswith('P')\n\n    def _strip_punctuation(word_str: str) -> str:\n        # Remove leading/trailing punctuation\n        start = 0\n        end = len(word_str) - 1\n        while start <= end and _is_punctuation(word_str[start]):\n            start += 1\n        while start <= end and _is_punctuation(word_str[end]):\n            end -= 1\n        return word_str[start : end + 1]\n\n    result_words: List[str] = []\n    current_word_chars: List[str] = []\n\n    for char in text:\n        if _is_unicode_letter(char) or _is_internal_hyphen_or_apostrophe(char):\n            current_word_chars.append(char)\n        else:\n            if current_word_chars:\n                raw_word = \"\".join(current_word_chars)\n                stripped_word = _strip_punctuation(raw_word)\n                if len(stripped_word) >= 4:\n                    result_words.append(stripped_word)\n                current_word_chars = []\n\n    if current_word_chars:\n        raw_word = \"\".join(current_word_chars)\n        stripped_word = _strip_punctuation(raw_word)\n        if len(stripped_word) >= 4:\n            result_words.append(stripped_word)\n\n    return result_words"}
{"task_id": "Mbpp/9", "solution": "def find_Rotations(s: str) -> int:\n    # Helper function to compute the KMP prefix function (pi array).\n    # pi[i] is the length of the longest proper prefix of pattern[0..i]\n    # that is also a suffix of pattern[0..i].\n    def _compute_prefix(pattern: str) -> list[int]:\n        m = len(pattern)\n        pi = [0] * m\n        k = 0\n\n        for i in range(1, m):\n            while k > 0 and pattern[i] != pattern[k]:\n                k = pi[k - 1]\n            if pattern[i] == pattern[k]:\n                k += 1\n            pi[i] = k\n        return pi\n\n    if not isinstance(s, str):\n        raise TypeError(\"Input must be a string\")\n    n = len(s)\n    if n == 0:\n        raise ValueError(\"Input string must not be empty\")\n\n    # Handle single-character strings and strings with all identical characters.\n    if n == 1 or s.count(s[0]) == n:\n        return 1\n\n    # Use KMP algorithm with the doubled string to find the smallest period.\n    doubled_s = s + s\n    pi = _compute_prefix(s)\n\n    matched_length = 0\n    for i in range(2 * n):\n        while matched_length > 0 and doubled_s[i] != s[matched_length]:\n            matched_length = pi[matched_length - 1]\n        if doubled_s[i] == s[matched_length]:\n            matched_length += 1\n\n        if matched_length == n:\n            p = i - n + 1\n            if p != 0:\n                return p\n            matched_length = pi[matched_length - 1]\n\n    # Fallback (should not be reached)\n    return n"}
{"task_id": "Mbpp/6", "solution": "def differ_At_One_Bit_Pos(a: int, b: int) -> bool:\n    \"\"\"Checks if two integers differ at exactly one bit position.\"\"\"\n    if not isinstance(a, int) or not isinstance(b, int):\n        raise TypeError(\"a and b must be int\")\n    x = a ^ b\n    if x == 0:\n        return False\n    if hasattr(int, 'bit_count'):\n        return x.bit_count() == 1\n    return (x & (x - 1)) == 0"}
{"task_id": "Mbpp/8", "solution": "def square_nums(numbers: list) -> list:\n    \"\"\"\n    Computes the square of each numeric element in the input list.\n    Returns a new list containing the squared values, preserving order.\n\n    Args:\n        numbers (list): A list of numeric values (ints or floats).\n\n    Returns:\n        list: A new list where each element is the square of the corresponding input element.\n\n    Raises:\n        TypeError: If `numbers` is not a list or contains non-numeric elements.\n    \"\"\"\n    if not isinstance(numbers, list):\n        raise TypeError(\"numbers must be a list\")\n    result = []\n    for i, num in enumerate(numbers):\n        if not isinstance(num, (int, float)):\n            raise TypeError(f\"element at index {i} is not numeric (int or float)\")\n        result.append(num ** 2)\n    return result"}
{"task_id": "Mbpp/17", "solution": "from typing import Union\n\ndef square_perimeter(side_length: Union[int, float]) -> Union[int, float]:\n    \"\"\"Calculates the perimeter of a square. Returns 4 times the side length.\"\"\"\n    return 4 * side_length"}
{"task_id": "Mbpp/16", "solution": "import re\n\n# The regex pattern to match sequences of lowercase letters joined by single underscores.\n_PATTERN = \"[a-z]+(?:_[a-z]+)+\"\n_COMPILED_PATTERN = re.compile(_PATTERN, re.ASCII)\n\ndef text_lowercase_underscore(input_string: str) -> bool:\n    \"\"\"\n    Checks if the input string contains sequences of lowercase letters joined with an underscore.\n    \"\"\"\n    if not input_string:\n        return False\n    return bool(_COMPILED_PATTERN.search(input_string))"}
{"task_id": "Mbpp/14", "solution": "def find_Volume(base, height, length):\n    \"\"\"\n    Calculates the volume of a triangular prism.\n    The algorithm computes the area of the triangular base (0.5 * base * height)\n    and then multiplies it by the prism's length to find the total volume.\n\n    Args:\n        base (int | float): The length of the base of the triangular face.\n        height (int | float): The height of the triangular face.\n        length (int | float): The length of the prism.\n\n    Returns:\n        float: The computed volume of the triangular prism.\n\n    Raises:\n        TypeError: If any input (base, height, or length) is not a numeric type (int or float).\n        ValueError: If any input (base, height, or length) is not strictly greater than zero.\n\n    Examples:\n        >>> find_Volume(3, 4, 5)\n        30.0\n        >>> find_Volume(2.5, 4.0, 10)\n        50.0\n    \"\"\"\n    # Validate input types and convert integers to floats.\n    # This ensures all calculations use floating-point arithmetic.\n    if not isinstance(base, (int, float)):\n        raise TypeError(\"The 'base' parameter must be a numeric type (int or float).\")\n    base_f = float(base)\n\n    if not isinstance(height, (int, float)):\n        raise TypeError(\"The 'height' parameter must be a numeric type (int or float).\")\n    height_f = float(height)\n\n    if not isinstance(length, (int, float)):\n        raise TypeError(\"The 'length' parameter must be a numeric type (int or float).\")\n    length_f = float(length)\n\n    # Validate that all dimensions are strictly positive.\n    # Non-positive dimensions are physically impossible for a prism.\n    if base_f <= 0:\n        raise ValueError(\"The 'base' parameter must be strictly greater than zero.\")\n    if height_f <= 0:\n        raise ValueError(\"The 'height' parameter must be strictly greater than zero.\")\n    if length_f <= 0:\n        raise ValueError(\"The 'length' parameter must be strictly greater than zero.\")\n\n    # Calculate the area of the triangular base.\n    # This uses the standard formula for a triangle's area.\n    area = 0.5 * base_f * height_f\n\n    # Calculate the volume of the prism.\n    # This multiplies the base area by the prism's length.\n    volume = area * length_f\n\n    return volume"}
{"task_id": "Mbpp/12", "solution": "from typing import List, Any, Union\n\n# Define the 'number' type as specified in design context\nnumber = Union[int, float]\n\nclass ValidationError(Exception):\n    \"\"\"Custom exception for validation failures.\"\"\"\n    pass\n\nclass Validator:\n    \"\"\"Provides matrix validation functionality.\"\"\"\n\n    @staticmethod\n    def _is_finite_number(x: Any) -> bool:\n        \"\"\"Checks if x is an int or float and is finite (not NaN or Infinity).\"\"\"\n        return isinstance(x, (int, float)) and not (x != x or x == float('inf') or x == float('-inf'))\n\n    @staticmethod\n    def validate(matrix: Any) -> None:\n        \"\"\"\n        Validates the input matrix structure and elements.\n        Raises ValidationError if validation fails.\n        \"\"\"\n        if not isinstance(matrix, list):\n            raise ValidationError(\"Input must be a list.\")\n\n        for i, row in enumerate(matrix):\n            if not isinstance(row, list):\n                raise ValidationError(f\"Row at index {i} must be a list.\")\n            for j, element in enumerate(row):\n                if not Validator._is_finite_number(element):\n                    raise ValidationError(\n                        f\"Element at row {i}, column {j} must be a finite number (int or float).\"\n                    )\n\ndef _compute_row_sum(row: List[number]) -> float:\n    \"\"\"Computes the arithmetic sum of elements in a row. Returns 0 for an empty row.\"\"\"\n    return float(sum(row))\n\ndef sort_matrix(matrix: List[List[number]]) -> List[List[number]]:\n    \"\"\"\n    Sorts a given matrix in ascending order according to the sum of its rows.\n    Returns a new matrix with rows sorted based on their sums, preserving intra-row order.\n    \"\"\"\n    Validator.validate(matrix)\n\n    if not matrix:\n        return []\n\n    row_sums_and_rows = []\n    for i, row in enumerate(matrix):\n        current_sum = _compute_row_sum(row)\n        # Store (sum, original_index, row_reference) to facilitate sorting and reconstruction\n        row_sums_and_rows.append((current_sum, i, row))\n\n    # Sort the list of tuples by the computed sum (first element)\n    row_sums_and_rows.sort(key=lambda item: item[0])\n\n    # Construct the result matrix with shallow copies of the rows\n    sorted_matrix = [row_ref.copy() for _, _, row_ref in row_sums_and_rows]\n\n    return sorted_matrix"}
{"task_id": "Mbpp/18", "solution": "def remove_dirty_chars(source: str, removals: str) -> str:\n    # Validate input types\n    if not isinstance(source, str) or not isinstance(removals, str):\n        raise TypeError(\"Both 'source' and 'removals' must be str\")\n\n    # Short-circuit cases\n    if source == \"\":\n        return \"\"\n    if removals == \"\":\n        return source\n\n    # Build set for O(1) membership checks\n    chars_to_remove = set(removals)\n\n    # Collect characters not in removals\n    result_chars = []\n    for char in source:\n        if char not in chars_to_remove:\n            result_chars.append(char)\n\n    return \"\".join(result_chars)"}
{"task_id": "Mbpp/19", "solution": "from typing import List\n\ndef test_duplicate(arr: List[int]) -> bool:\n    \"\"\"Checks if an array of integers contains any duplicate element using a hash set.\n    This provides average O(n) time complexity and O(n) space complexity.\n    \"\"\"\n    seen = set()\n    for x in arr:\n        if x in seen:\n            return True\n        seen.add(x)\n    return False"}
{"task_id": "Mbpp/56", "solution": "def check(n: int) -> bool:\n    \"\"\"\n    Checks if a number is one less than twice its reverse.\n    Handles non-integer input by raising TypeError and negative integers by returning False.\n    \"\"\"\n    # Using isinstance allows bool inputs (e.g., True is 1), as noted in the design context.\n    if not isinstance(n, int):\n        raise TypeError(\"Input 'n' must be an integer.\")\n\n    if n < 0:\n        return False\n\n    def _compute_reverse(num: int) -> int:\n        \"\"\"Computes the integer reverse of the absolute value of a number.\"\"\"\n        x = abs(num)\n        r = 0\n        while x > 0:\n            r = r * 10 + (x % 10)\n            x //= 10\n        return r\n\n    reversed_n = _compute_reverse(n)\n\n    return n == (2 * reversed_n - 1)"}
{"task_id": "Mbpp/20", "solution": "def is_woodall(number: int) -> bool:\n    \"\"\"\n    Checks if the given number is a Woodall number, defined as n * 2**n - 1 for n >= 1.\n\n    Raises:\n        TypeError: if number is not an int.\n\n    Returns:\n        bool: True if number is a Woodall number, False otherwise.\n    \"\"\"\n    if not isinstance(number, int):\n        raise TypeError(\"number must be an int\")\n    if number < 1:\n        return False\n\n    def _compute_candidate(n: int) -> int:\n        \"\"\"Computes n * 2**n - 1 using integer arithmetic.\"\"\"\n        return n * (2 ** n) - 1\n\n    n = 1\n    while True:\n        candidate = _compute_candidate(n)\n        if candidate == number:\n            return True\n        if candidate > number:\n            return False\n        n += 1"}
{"task_id": "Mbpp/62", "solution": "def smallest_num(list_input):\n    \"\"\"\n    Finds the smallest numeric (int or float, excluding bool) element in a list.\n    Raises TypeError if input is not a list, ValueError if no numeric elements are found.\n    O(n) time, O(1) space.\n    \"\"\"\n    if not isinstance(list_input, list):\n        raise TypeError(\"smallest_num: input must be a list\")\n\n    found_numeric = False\n    current_min = None\n\n    for item in list_input:\n        if isinstance(item, (int, float)) and not isinstance(item, bool):\n            if not found_numeric:\n                current_min = item\n                found_numeric = True\n            elif item < current_min:\n                current_min = item\n\n    if not found_numeric:\n        raise ValueError(\"smallest_num: no numeric elements found\")\n\n    return current_min"}
{"task_id": "Mbpp/57", "solution": "def find_Max_Num(digits: list) -> int:\n    \"\"\"\n    Finds the largest number that can be formed with the given list of digits.\n\n    Examples:\n    Normal case:\n        >>> find_Max_Num([3, 1, 9])\n        931\n\n    All-zeros edge case:\n        >>> find_Max_Num([0, 0, 0])\n        0\n\n    Invalid input example (raises ValueError):\n        >>> find_Max_Num((1,2,3))\n        Traceback (most recent call last):\n        ValueError: digits must be a list\n    \"\"\"\n    if not isinstance(digits, list):\n        raise ValueError(\"digits must be a list\")\n\n    if not digits:\n        raise ValueError(\"digits list must not be empty\")\n\n    for d in digits:\n        if not isinstance(d, int) or not (0 <= d <= 9):\n            raise ValueError(\"each digit must be an int in 0..9\")\n\n    # Create a shallow copy to avoid mutating the input list\n    local_digits = list(digits)\n\n    # Sort the digits in descending order to form the largest number\n    local_digits.sort(reverse=True)\n\n    # Handle the special case where all digits are zero\n    if local_digits[0] == 0:\n        return 0\n\n    # Concatenate digits into a single integer\n    result_num = 0\n    for digit in local_digits:\n        result_num = result_num * 10 + digit\n\n    return result_num"}
{"task_id": "Mbpp/58", "solution": "def opposite_Signs(a: int, b: int) -> bool:\n    \"\"\"Checks if two integers have opposite signs.\n\n    This function verifies type constraints, treats zero as neither positive nor negative,\n    and returns True iff one input is > 0 and the other < 0.\n\n    Raises:\n        TypeError: if either argument is not an int.\n\n    Examples:\n        opposite_Signs(1, -2) == True\n        opposite_Signs(3, 2) == False\n        opposite_Signs(0, -1) == False\n    \"\"\"\n    if not isinstance(a, int) or not isinstance(b, int):\n        raise TypeError(\"opposite_Signs: both arguments must be int\")\n    if a == 0 or b == 0:\n        return False\n    return (a > 0 and b < 0) or (a < 0 and b > 0)"}
{"task_id": "Mbpp/61", "solution": "def count_Substrings(s: str) -> int:\n    \"\"\"\n    Counts substrings where the sum of digits equals the substring's length.\n    Uses a prefix sum transformation approach for O(n) time complexity.\n    \"\"\"\n    n = len(s)\n    if n == 0:\n        return 0\n\n    prefix_sum = 0\n    transformed_prefix_freq = {0: 1}\n\n    for i in range(1, n + 1):\n        ch = s[i - 1]\n        if not ch.isdigit():\n            raise ValueError(\"Input string must contain only digit characters.\")\n        prefix_sum += ord(ch) - 48  # faster than int(ch)\n        t_value = prefix_sum - i\n        transformed_prefix_freq[t_value] = transformed_prefix_freq.get(t_value, 0) + 1\n\n    count = 0\n    for freq in transformed_prefix_freq.values():\n        count += freq * (freq - 1) // 2\n\n    return count"}
{"task_id": "Mbpp/64", "solution": "from typing import List, Tuple, Any\n\ndef subject_marks(records: List[Tuple[str, Any]]) -> List[Tuple[str, Any]]:\n    \"\"\"\n    Sorts a list of tuples based on the second value (mark) of each tuple in ascending order.\n    It returns a new list containing the sorted tuples.\n    \"\"\"\n    return sorted(records, key=lambda x: x[1])"}
{"task_id": "Mbpp/59", "solution": "class InputValidator:\n    \"\"\"Responsible for validating parameter type and range.\"\"\"\n    def validate_type(self, n):\n        \"\"\"Raises TypeError if n is not an integer.\"\"\"\n        if not isinstance(n, int):\n            raise TypeError(\"Input 'n' must be an integer.\")\n\n    def validate_range(self, n):\n        \"\"\"Raises ValueError if n is less than 1.\"\"\"\n        if n < 1:\n            raise ValueError(\"Input 'n' must be greater than or equal to 1.\")\n\nclass OctagonalCalculator:\n    \"\"\"Responsible for computing nth octagonal number using integer arithmetic.\"\"\"\n    def formula(self, n):\n        \"\"\"Computes the octagonal number using the formula O_n = n * (3 * n - 2).\"\"\"\n        return n * (3 * n - 2)\n\n    def compute(self, n):\n        \"\"\"Calculates the nth octagonal number by applying the formula.\"\"\"\n        return self.formula(n)\n\nclass OctagonalNumber:\n    \"\"\"A value object holding the input 'n' and its computed octagonal value.\"\"\"\n    def __init__(self, n, value):\n        self._n = n\n        self._value = value\n\n    def get_value(self):\n        \"\"\"Returns the stored computed octagonal number.\"\"\"\n        return self._value\n\ndef is_octagonal(n: int) -> int:\n    \"\"\"Calculates the nth octagonal number.\n\n    The octagonal numbers are figurate numbers representing the number of dots\n    in a regular octagon.\n\n    Parameters:\n        n (int): The position of the octagonal number to find. Must be an\n                 integer greater than or equal to 1.\n\n    Returns:\n        int: The nth octagonal number.\n\n    Formula:\n        The nth octagonal number O_n is calculated using the formula:\n        O_n = n * (3 * n - 2).\n\n    Examples:\n        - is_octagonal(1) == 1\n        - is_octagonal(2) == 8\n        - is_octagonal(3) == 21\n        - is_octagonal(4) == 40\n        - is_octagonal(5) == 65\n\n    Complexity:\n        Time: O(1) - involves a fixed number of arithmetic operations.\n        Space: O(1) - uses a constant amount of extra space.\n\n    Exceptions:\n        - TypeError: If 'n' is not an integer.\n        - ValueError: If 'n' is less than 1.\n    \"\"\"\n    validator = InputValidator()\n    validator.validate_type(n)\n    validator.validate_range(n)\n\n    calculator = OctagonalCalculator()\n    value = calculator.compute(n)\n\n    oct_num = OctagonalNumber(n, value)\n    return oct_num.get_value()"}
{"task_id": "Mbpp/63", "solution": "def max_difference(pairs):\n    \"\"\"Return the maximum absolute difference between elements of 2-element numeric tuples in pairs.\n\n    Validations:\n    - `pairs` must be a list and non-empty.\n    - Each item must be a tuple of length 2.\n    - Each element of the tuple must be an int or float and finite (not NaN or infinite).\n\n    Returns:\n    - A float equal to the maximum abs(a - b) across all pairs.\n\n    Raises:\n    - TypeError for wrong top-level type or non-numeric elements.\n    - ValueError for empty list, wrong tuple shape, or non-finite numeric values.\n\n    Complexity: O(n) time, O(1) additional space.\n    \"\"\"\n    import math\n\n    if not isinstance(pairs, list):\n        raise TypeError(\"Input 'pairs' must be a list.\")\n    if not pairs:\n        raise ValueError(\"Input 'pairs' must be a non-empty list.\")\n\n    max_diff = -float(\"inf\")\n\n    for idx, pair in enumerate(pairs):\n        if not isinstance(pair, tuple) or len(pair) != 2:\n            raise ValueError(f\"Item at index {idx} must be a 2-element tuple.\")\n\n        a, b = pair\n\n        if not isinstance(a, (int, float)):\n            raise TypeError(f\"Element 0 of pair at index {idx} must be an int or float.\")\n        if not math.isfinite(a):\n            raise ValueError(f\"Element 0 of pair at index {idx} must be finite (not NaN or infinity).\")\n\n        if not isinstance(b, (int, float)):\n            raise TypeError(f\"Element 1 of pair at index {idx} must be an int or float.\")\n        if not math.isfinite(b):\n            raise ValueError(f\"Element 1 of pair at index {idx} must be finite (not NaN or infinity).\")\n\n        diff = abs(a - b)\n        if diff > max_diff:\n            max_diff = diff\n\n    return float(max_diff)"}
{"task_id": "Mbpp/65", "solution": "def recursive_list_sum(lst):\n    \"\"\"\n    Flattens a list and sums all of its numeric (int, float) elements, handling nested lists.\n    Raises TypeError for invalid input or element types.\n    \"\"\"\n    if not isinstance(lst, list):\n        raise TypeError(\"recursive_list_sum: input must be a list\")\n\n    def _recursive_sum_helper(curr_list, path):\n        \"\"\"\n        Internal helper to recursively traverse, validate, and sum elements.\n        Returns (accumulated_sum: float, encountered_float: bool, encountered_any_number: bool).\n        \"\"\"\n        acc_sum = 0.0\n        saw_float_in_subtree = False\n        saw_any_number_in_subtree = False\n\n        for index, element in enumerate(curr_list):\n            current_path = path + (index,)\n            if isinstance(element, list):\n                sub_sum, sub_saw_float, sub_saw_any_number = _recursive_sum_helper(element, current_path)\n                acc_sum += sub_sum\n                saw_float_in_subtree = saw_float_in_subtree or sub_saw_float\n                saw_any_number_in_subtree = saw_any_number_in_subtree or sub_saw_any_number\n            elif isinstance(element, bool): # Explicitly exclude bool as per design\n                raise TypeError(f\"recursive_list_sum: invalid element type at path {current_path}: expected list|int|float, got {type(element).__name__}\")\n            elif isinstance(element, int):\n                acc_sum += element\n                saw_any_number_in_subtree = True\n            elif isinstance(element, float):\n                acc_sum += element\n                saw_float_in_subtree = True\n                saw_any_number_in_subtree = True\n            else:\n                raise TypeError(f\"recursive_list_sum: invalid element type at path {current_path}: expected list|int|float, got {type(element).__name__}\")\n\n        return acc_sum, saw_float_in_subtree, saw_any_number_in_subtree\n\n    total, saw_float, saw_any_number = _recursive_sum_helper(lst, ())\n\n    if not saw_any_number:\n        return 0\n    elif saw_float:\n        return total\n    else:\n        return int(total)"}
{"task_id": "Mbpp/67", "solution": "def bell_number(n):\n    \"\"\"Calculates the Bell number B_n using the Bell triangle algorithm.\"\"\"\n    if not isinstance(n, int) or n < 0:\n        raise ValueError(\"n must be a non-negative integer\")\n    if n == 0:\n        return 1\n\n    # Initialize the first row of the Bell triangle (B_0)\n    current_row = [1]\n\n    # Build the triangle row by row up to n\n    for i in range(1, n + 1):\n        next_row = []\n        # The first element of the new row is the last element of the previous row\n        next_row.append(current_row[-1])\n\n        # Calculate subsequent elements in the new row\n        for j in range(1, i + 1):\n            value = next_row[j - 1] + current_row[j - 1]\n            next_row.append(value)\n\n        current_row = next_row\n\n    # The Bell number B_n is the first element of the nth row\n    return current_row[0]"}
{"task_id": "Mbpp/66", "solution": "def pos_count(values: list) -> int:\n    \"\"\"Counts the number of positive numbers in a list, validating element types.\"\"\"\n\n    def validate_element(el) -> bool:\n        \"\"\"Checks if an element is a valid int or float, and not a bool.\"\"\"\n        return isinstance(el, (int, float)) and not isinstance(el, bool)\n\n    def count_positives(values) -> int:\n        \"\"\"Counts elements strictly greater than zero in a pre-validated list.\"\"\"\n        counter = 0\n        for el in values:\n            if el > 0:\n                counter += 1\n        return counter\n\n    for i, el in enumerate(values):\n        if not validate_element(el):\n            raise TypeError(f\"invalid element at index {i}: {el!r}\")\n\n    return count_positives(values)"}
{"task_id": "Mbpp/68", "solution": "def is_Monotonic(arr: list[int | float]) -> bool:\n    \"\"\"Checks if a list is monotonic (entirely non-decreasing or non-increasing).\n    Example: assert is_Monotonic([6, 5, 4, 4]) == True\n    \"\"\"\n    if len(arr) <= 1:\n        return True\n\n    non_decreasing = True\n    non_increasing = True\n\n    for i in range(1, len(arr)):\n        if arr[i] > arr[i - 1]:\n            non_increasing = False\n        if arr[i] < arr[i - 1]:\n            non_decreasing = False\n\n        if not non_decreasing and not non_increasing:\n            return False\n\n    return non_decreasing or non_increasing"}
{"task_id": "Mbpp/70", "solution": "def get_equal(*tuples) -> bool:\n    \"\"\"Checks if all provided tuples have the same length after validating their types.\n    Returns True if all tuples are of equal length or if zero/one tuples are provided, otherwise False.\n    \"\"\"\n    for i, arg in enumerate(tuples):\n        if not isinstance(arg, tuple):\n            raise TypeError(f\"Argument at index {i} must be a tuple, but got {type(arg).__name__}\")\n\n    if not tuples or len(tuples) == 1:\n        return True\n\n    reference_length = len(tuples[0])\n    for t in tuples[1:]:\n        if len(t) != reference_length:\n            return False\n\n    return True"}
{"task_id": "Mbpp/69", "solution": "from typing import Any, List\n\ndef is_sublist(haystack: List[Any], needle: List[Any]) -> bool:\n    \"\"\"\n    Purpose: Determine whether `needle` appears as a contiguous sublist of `haystack`.\n\n    Parameters:\n      haystack: List[Any] -- list to search\n      needle: List[Any] -- pattern list to find\n\n    Returns:\n      bool -- True if `needle` exists as a contiguous subsequence of `haystack`, else False\n\n    Raises:\n      TypeError -- if either argument is not a list\n\n    Notes:\n      - Uses Python equality (==) for element comparisons.\n      - Guard clauses: empty needle -> True; len(needle) > len(haystack) -> False.\n      - Preferred algorithm: KMP adapted for lists (O(n + m) time, O(m) extra space).\n      - Alternative documented algorithm: naive sliding-window (O(n*m) time).\n      - Example usage (must be present in docstring):\n          assert is_sublist([2, 4, 3, 5, 7], [3, 7]) == False\n    \"\"\"\n\n    def _validate_args(haystack_arg: List[Any], needle_arg: List[Any]) -> None:\n        \"\"\"Raise TypeError if haystack or needle is not a list.\"\"\"\n        if not isinstance(haystack_arg, list) or not isinstance(needle_arg, list):\n            raise TypeError(\"haystack and needle must be lists\")\n\n    def _build_prefix_table(pattern_arg: List[Any]) -> List[int]:\n        \"\"\"Return lps (longest proper prefix which is also suffix) array for KMP preprocessing.\"\"\"\n        m = len(pattern_arg)\n        lps = [0] * m\n        length = 0\n        i = 1\n        while i < m:\n            if pattern_arg[i] == pattern_arg[length]:\n                length += 1\n                lps[i] = length\n                i += 1\n            else:\n                if length != 0:\n                    length = lps[length - 1]\n                else:\n                    lps[i] = 0\n                    i += 1\n        return lps\n\n    def _kmp_search(text_arg: List[Any], pattern_arg: List[Any], lps_arg: List[int]) -> bool:\n        \"\"\"Return True if pattern is found in text using provided lps; compares elements with ==.\"\"\"\n        n = len(text_arg)\n        m = len(pattern_arg)\n        i = 0  # index for text_arg\n        j = 0  # index for pattern_arg\n        while i < n:\n            if text_arg[i] == pattern_arg[j]:\n                i += 1\n                j += 1\n            if j == m:\n                return True\n            elif i < n and text_arg[i] != pattern_arg[j]:\n                if j != 0:\n                    j = lps_arg[j - 1]\n                else:\n                    i += 1\n        return False\n\n    _validate_args(haystack, needle)\n\n    # Guard cases\n    if not needle:  # An empty list is always considered a sublist\n        return True\n\n    if len(needle) > len(haystack):\n        return False\n\n    lps = _build_prefix_table(needle)\n    return _kmp_search(haystack, needle, lps)"}
{"task_id": "Mbpp/74", "solution": "def is_samepatterns(sequence, patterns):\n    if sequence is None or patterns is None:\n        raise ValueError(\"sequence and patterns must not be None\")\n    if not isinstance(sequence, list) or not isinstance(patterns, list):\n        raise TypeError(\"sequence and patterns must be lists\")\n    if len(sequence) != len(patterns):\n        return False\n\n    # Maps pattern tokens to sequence elements.\n    forward_map = {}\n    # Maps sequence elements to pattern tokens to enforce bijectivity.\n    reverse_map = {}\n\n    for pattern_token, sequence_element in zip(patterns, sequence):\n        # Check for consistency of existing forward mapping.\n        if pattern_token in forward_map:\n            if forward_map[pattern_token] != sequence_element:\n                return False\n        else:\n            # If new pattern token, check for consistency of reverse mapping\n            # to ensure no two pattern tokens map to the same sequence element.\n            if sequence_element in reverse_map:\n                if reverse_map[sequence_element] != pattern_token:\n                    return False\n\n            # Establish new bijective mappings.\n            forward_map[pattern_token] = sequence_element\n            reverse_map[sequence_element] = pattern_token\n\n    return True"}
{"task_id": "Mbpp/71", "solution": "import math\n\n_shrink_factor = 1.3\n\ndef comb_sort(data_list):\n    \"\"\"\n    Sorts a list of elements in non-decreasing order using the Comb Sort algorithm.\n    The sort is performed in-place.\n    \"\"\"\n    n = len(data_list)\n\n    if n <= 1:\n        return data_list\n\n    gap = n\n    swapped = True\n\n    while gap > 1 or swapped:\n        # Calculate the next gap size using the shrink factor.\n        gap = max(1, math.floor(gap / _shrink_factor))\n\n        swapped = False\n        # Perform a single pass through the list with the current gap.\n        for i in range(n - gap):\n            if data_list[i] > data_list[i + gap]:\n                data_list[i], data_list[i + gap] = data_list[i + gap], data_list[i]\n                swapped = True\n\n    return data_list"}
{"task_id": "Mbpp/72", "solution": "def dif_Square(n: int) -> bool:\n    \"\"\"Checks if an integer can be represented as the difference of two squares (x^2 - y^2).\n    This is true if and only if n is not congruent to 2 modulo 4 (n % 4 != 2).\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an int\")\n    return (n % 4) != 2"}
