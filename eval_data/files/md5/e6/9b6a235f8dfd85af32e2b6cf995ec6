{"task_id": "Mbpp/102", "solution": "def snake_to_camel(input_string):\n    \"\"\"\n    Converts a snake_case string to a PascalCase (CamelCase with initial capital) string.\n    \"\"\"\n    if not input_string:\n        return \"\"\n\n    tokens = input_string.split('_')\n    camel_case_parts = []\n\n    for token in tokens:\n        # Remove any characters from token_raw that are neither letters nor digits\n        cleaned_token_chars = [char for char in token if char.isalnum()]\n        cleaned_token = \"\".join(cleaned_token_chars)\n\n        # Skip empty tokens (from leading/trailing/consecutive underscores or after cleaning)\n        if not cleaned_token:\n            continue\n\n        # Lowercase all alphabetic characters then capitalize the first letter\n        capitalized_part = cleaned_token.lower().capitalize()\n        camel_case_parts.append(capitalized_part)\n\n    # If after processing no tokens remain, return an empty string\n    if not camel_case_parts:\n        return \"\"\n\n    return \"\".join(camel_case_parts)"}
{"task_id": "Mbpp/100", "solution": "def next_smallest_palindrome(n):\n    # Validate input\n    if not isinstance(n, int) or n < 0:\n        raise ValueError(\"n must be a non-negative integer\")\n\n    # Handle single-digit fast path as per design.\n    if 0 <= n <= 8:\n        return n + 1\n\n    digits = [int(c) for c in str(n)]\n    d = len(digits)\n\n    # Handle all-9s numbers like 9, 99, 999.\n    if all(digit == 9 for digit in digits):\n        return int('1' + '0' * (d - 1) + '1')\n\n    # Helper function to mirror the left half of digits to the right half.\n    def mirror_left_to_right(digs_list):\n        res = digs_list[:]  # Create a copy to modify\n        for i in range(d // 2):\n            res[d - 1 - i] = res[i]\n        return res\n\n    # Generate an initial palindrome candidate by mirroring the left half.\n    candidate = mirror_left_to_right(digits)\n    cand_int = int(''.join(map(str, candidate)))\n\n    # If the mirrored candidate is already greater than n, it's the answer.\n    if cand_int > n:\n        return cand_int\n\n    # Otherwise, we need to increment the middle part and remirror.\n    chars_to_increment = digits[:]  # Copy for modification\n    mid = d // 2\n    carry = 1\n\n    # Handle incrementing the middle digit(s) based on length parity.\n    if d % 2 == 1:\n        # Odd length: increment the actual middle digit.\n        new_mid = chars_to_increment[mid] + carry\n        if new_mid == 10:\n            chars_to_increment[mid] = 0\n            carry = 1\n        else:\n            chars_to_increment[mid] = new_mid\n            carry = 0\n        left_idx = mid - 1\n    else:\n        # Even length: start carry propagation from the left-middle.\n        left_idx = mid - 1\n        carry = 1\n\n    # Propagate carry to the left.\n    while left_idx >= 0 and carry:\n        new_digit = chars_to_increment[left_idx] + carry\n        if new_digit == 10:\n            chars_to_increment[left_idx] = 0\n            carry = 1\n        else:\n            chars_to_increment[left_idx] = new_digit\n            carry = 0\n        left_idx -= 1\n\n    # After incrementing, mirror again to get the final palindrome.\n    final_candidate = mirror_left_to_right(chars_to_increment)\n    return int(''.join(map(str, final_candidate)))"}
{"task_id": "Mbpp/104", "solution": "from typing import Iterable, List\n\ndef sort_sublists(collection: Iterable[Iterable[str]]) -> List[List[str]]:\n    \"\"\"\n    Sorts each sublist of strings in a given list of lists lexicographically.\n\n    Args:\n        collection: An iterable of iterables, where each inner iterable contains strings.\n\n    Returns:\n        A new list of lists, where each inner list is a sorted version of the corresponding input sublist.\n\n    Example:\n        assert sort_sublists([[\"b\",\"a\"]]) == [[\"a\",\"b\"]]\n    \"\"\"\n    result: List[List[str]] = []\n\n    try:\n        # Validate outer input is iterable and iterate over it\n        for i, sublist_candidate in enumerate(collection):\n            collected_elements: List[str] = []\n            try:\n                # Attempt to iterate over the sublist_candidate and collect elements\n                for j, element in enumerate(sublist_candidate):\n                    if not isinstance(element, str):\n                        raise TypeError(f\"element at index {j} in sublist {i} is not a string\")\n                    collected_elements.append(element)\n            except TypeError:\n                # Raised if sublist_candidate is not iterable\n                raise TypeError(f\"sublist at index {i} is not iterable\")\n\n            # Sort the collected elements and append to the result list\n            sorted_sublist = list(sorted(collected_elements))\n            result.append(sorted_sublist)\n\n    except TypeError:\n        # Raised if the outer collection itself is not iterable\n        raise TypeError(\"outer input is not iterable\")\n\n    return result"}
{"task_id": "Mbpp/103", "solution": "def eulerian_num(n: int, m: int) -> int:\n    \"\"\"\n    Calculates the Eulerian number A(n, m) using dynamic programming.\n    A(n, m) is the number of permutations of {1, ..., n} with exactly m ascents.\n    \"\"\"\n    if not isinstance(n, int):\n        raise ValueError(f\"n must be a non-negative integer; got {n!r}\")\n    if not isinstance(m, int):\n        raise ValueError(f\"m must be a non-negative integer; got {m!r}\")\n    if n < 0 or m < 0:\n        raise ValueError(f\"n and m must be non-negative integers; got n={n}, m={m}\")\n\n    if n == 0:\n        return 1 if m == 0 else 0\n    if m >= n:  # For n > 0, A(n,m) is 0 if m is n or greater.\n        return 0\n    # Initialize DP table: dp[i][j] stores A(i, j)\n    # The table size is (n+1) rows by (m+1) columns.\n    dp = [[0] * (m + 1) for _ in range(n + 1)]\n\n    # Base case for A(0,0)\n    dp[0][0] = 1\n\n    # Fill the DP table using the recurrence relation:\n    # A(i, j) = (i - j) * A(i-1, j-1) + (j + 1) * A(i-1, j)\n    for i in range(1, n + 1):\n        dp[i][0] = 1\n        for j in range(1, min(i, m + 1)):\n            term1 = (i - j) * dp[i - 1][j - 1]\n            term2 = (j + 1) * dp[i - 1][j]\n            dp[i][j] = term1 + term2\n\n    return dp[n][m]"}
{"task_id": "Mbpp/108", "solution": "from typing import List, TypeVar\n\nT = TypeVar('T')\n\ndef merge_sorted_list(a: List[T], b: List[T], c: List[T]) -> List[T]:\n    \"\"\"Merges three sorted lists into a single sorted list, preserving multiplicity.\n    Assumes inputs are sorted and comparable; comparison errors will propagate as TypeError.\n    \"\"\"\n    result = []\n    i, j, k = 0, 0, 0\n    len_a, len_b, len_c = len(a), len(b), len(c)\n\n    while i < len_a or j < len_b or k < len_c:\n        a_has = i < len_a\n        b_has = j < len_b\n        c_has = k < len_c\n\n        if a_has and (not b_has or a[i] <= b[j]) and (not c_has or a[i] <= c[k]):\n            result.append(a[i])\n            i += 1\n        elif b_has and (not a_has or b[j] < a[i]) and (not c_has or b[j] <= c[k]):\n            result.append(b[j])\n            j += 1\n        elif c_has:\n            result.append(c[k])\n            k += 1\n\n    return result"}
{"task_id": "Mbpp/118", "solution": "def string_to_list(input_string: str) -> list[str]:\n    \"\"\"Convert a string to a list of strings by splitting on the space character.\n    This method preserves empty tokens from consecutive, leading, or trailing spaces.\"\"\"\n    return input_string.split(' ')"}
{"task_id": "Mbpp/109", "solution": "def odd_Equivalent(s: str, k: int) -> int:\n    # Validate types\n    if not isinstance(s, str) or not isinstance(k, int):\n        raise TypeError(\"s must be a str and k must be an int\")\n    # Validate values\n    if k < 0:\n        raise ValueError(\"k must be non-negative\")\n    if not s:\n        raise ValueError(\"s must be a non-empty binary string\")\n    if any(c not in {'0', '1'} for c in s):\n        raise ValueError(\"s must contain only '0' and '1' characters\")\n\n    n = len(s)\n    if k == 0:\n        return 0\n\n    ones_in_full_string = s.count('1')\n    cycles = k // n\n    leftover = k % n\n\n    leftover_ones = 0\n    for i in range(leftover):\n        # LSB mapping for rotation i:\n        # i == 0 -> s[-1], else -> s[i-1]\n        lsb = s[-1] if i == 0 else s[i - 1]\n        if lsb == '1':\n            leftover_ones += 1\n\n    return cycles * ones_in_full_string + leftover_ones"}
{"task_id": "Mbpp/111", "solution": "def common_in_nested_lists(nested_list):\n    \"\"\"\n    Finds common elements in nested lists, maintaining order from the first inner list and removing duplicates.\n    It handles both hashable and unhashable elements, raising TypeError for invalid input types.\n    \"\"\"\n\n    def _is_hashable(obj):\n        try:\n            hash(obj)\n            return True\n        except TypeError:\n            return False\n\n    def _validate(nl):\n        if not isinstance(nl, list):\n            raise TypeError(\"Input must be a list of lists.\")\n        for inner_list in nl:\n            if not isinstance(inner_list, list):\n                raise TypeError(\"All inner elements must be lists.\")\n\n    def _contains_empty_inner(nl):\n        return any(not inner_list for inner_list in nl)\n\n    def _all_elements_hashable(nl):\n        if not nl:\n            return True\n        for inner_list in nl:\n            for item in inner_list:\n                if not _is_hashable(item):\n                    return False\n        return True\n\n    def _hashable_intersect(lists):\n        if not lists:\n            return set()\n        common_set = set(lists[0])\n        for i in range(1, len(lists)):\n            common_set.intersection_update(set(lists[i]))\n        return common_set\n\n    def _equality_intersect(lists):\n        if not lists:\n            return []\n\n        first_list_unique_candidates = []\n        for item_from_first in lists[0]:\n            if not any(item_from_first == existing_candidate for existing_candidate in first_list_unique_candidates):\n                first_list_unique_candidates.append(item_from_first)\n\n        common_candidates = []\n        for candidate in first_list_unique_candidates:\n            is_common = True\n            for i in range(1, len(lists)):\n                if not any(candidate == item_in_other_list for item_in_other_list in lists[i]):\n                    is_common = False\n                    break\n            if is_common:\n                common_candidates.append(candidate)\n        return common_candidates\n\n    _validate(nested_list)\n\n    if not nested_list or _contains_empty_inner(nested_list):\n        return []\n\n    if _all_elements_hashable(nested_list):\n        candidate_set = _hashable_intersect(nested_list)\n        result = []\n        seen = set()\n        for item in nested_list[0]:\n            if item in candidate_set and item not in seen:\n                result.append(item)\n                seen.add(item)\n        return result\n    else:\n        candidate_list = _equality_intersect(nested_list)\n        result = []\n        for item in nested_list[0]:\n            if any(item == c for c in candidate_list) and not any(item == r for r in result):\n                result.append(item)\n        return result"}
{"task_id": "Mbpp/119", "solution": "def search(nums: list[int]) -> int:\n    \"\"\"Finds the single element that appears only once in a sorted array.\"\"\"\n    if not nums:\n        raise ValueError(\"Input list cannot be empty.\")\n\n    if len(nums) == 1:\n        return nums[0]\n\n    left, right = 0, len(nums) - 1\n\n    while left < right:\n        mid = (left + right) // 2\n\n        # Ensure mid is at an even index to simplify pair checking.\n        if mid % 2 == 1:\n            mid -= 1\n\n        if nums[mid] == nums[mid + 1]:\n            left = mid + 2\n        else:\n            right = mid\n\n    return nums[left]"}
{"task_id": "Mbpp/113", "solution": "from typing import Any\n\ndef check_integer(s: Any) -> bool:\n    \"\"\"Return True if s represents an integer per SRS, else False.\n\n    Adhere to BR1..BR10 and NFRs: type guard, index-based trimming, optional ASCII sign,\n    digit validation with str.isdecimal(), O(n) time, O(1) extra space, pure (no I/O), return False for invalid inputs.\n    \"\"\"\n    if not isinstance(s, str):\n        return False\n\n    n = len(s)\n    if n == 0:\n        return False\n\n    # Find the first non-whitespace character's index\n    first_char_idx = 0\n    while first_char_idx < n and s[first_char_idx].isspace():\n        first_char_idx += 1\n\n    # Find the last non-whitespace character's index\n    last_char_idx = n - 1\n    while last_char_idx >= 0 and s[last_char_idx].isspace():\n        last_char_idx -= 1\n\n    # If no non-whitespace characters were found (string is empty or whitespace-only)\n    if first_char_idx > last_char_idx:\n        return False\n\n    # Check for an optional sign\n    start_digits_idx = first_char_idx\n    if s[start_digits_idx] in ('+', '-'):\n        start_digits_idx += 1\n\n    # If only a sign was present (e.g., \"+\", \"-\") or string became empty after sign\n    if start_digits_idx > last_char_idx:\n        return False\n\n    # Validate that all remaining characters are decimal digits\n    for i in range(start_digits_idx, last_char_idx + 1):\n        if not s[i].isdecimal():\n            return False\n\n    return True"}
{"task_id": "Mbpp/116", "solution": "class TupleValidator:\n    def is_tuple(self, value) -> bool:\n        return isinstance(value, tuple)\n\n    def elements_are_positive_ints(self, elements) -> bool:\n        for element in elements:\n            if not isinstance(element, int) or element <= 0:\n                return False\n        return True\n\n    def validate(self, input) -> None:\n        if not self.is_tuple(input):\n            raise ValueError(\"input must be a tuple\")\n        if not self.elements_are_positive_ints(input):\n            raise ValueError(\"each element must be int > 0\")\n\nclass TupleInput:\n    def __init__(self, input_tuple: tuple) -> None:\n        self._elements: list[int] = list(input_tuple)\n\n    @property\n    def elements(self) -> list[int]:\n        return self._elements\n\n    def length(self) -> int:\n        return len(self._elements)\n\nclass IntegerOutput:\n    def __init__(self, value: int) -> None:\n        self._value: int = value\n\n    @property\n    def value(self) -> int:\n        return self._value\n\ndef tuple_to_int(input: tuple) -> int:\n    validator = TupleValidator()\n    validator.validate(input)\n\n    tuple_input = TupleInput(input)\n    if tuple_input.length() == 0:\n        return 0\n\n    string_elements = [str(element) for element in tuple_input.elements]\n    concatenated_string = \"\".join(string_elements)\n\n    integer_output = IntegerOutput(int(concatenated_string))\n    return integer_output.value"}
{"task_id": "Mbpp/120", "solution": "from typing import List, Tuple\n\nclass _Validator:\n    \"\"\"Helper class for input validation, grouping validation logic for clarity.\"\"\"\n\n    @staticmethod\n    def validate_is_list(pairs):\n        \"\"\"Validates that the 'pairs' argument is a list.\"\"\"\n        if not isinstance(pairs, list):\n            raise TypeError(f\"max_product_tuple: expected pairs to be list, got {type(pairs).__name__}\")\n\n    @staticmethod\n    def validate_is_2tuple(element, i):\n        \"\"\"Validates that 'element' at index 'i' is a 2-element tuple.\"\"\"\n        if not isinstance(element, tuple) or len(element) != 2:\n            raise TypeError(f\"max_product_tuple: element {i} is not a 2-tuple: {element!r}\")\n\n    @staticmethod\n    def validate_items_numeric(pair, i):\n        \"\"\"Validates that both items in 'pair' at index 'i' are numeric (int or float).\"\"\"\n        for j, item in enumerate(pair):\n            if not isinstance(item, (int, float)):\n                raise TypeError(f\"max_product_tuple: element {i} item {j} is not numeric: {item!r}\")\n\ndef max_product_tuple(pairs: List[Tuple[float, float]]) -> float:\n    \"\"\"\n    Finds the maximum absolute product between numbers in pairs of tuples.\n\n    It validates input and computes the maximum absolute product |a * b| among a list of 2-element tuples.\n    Returns an int if all input items are integers; otherwise, returns a float.\n    \"\"\"\n    _Validator.validate_is_list(pairs)\n\n    if not pairs:\n        raise ValueError(\"max_product_tuple: pairs must not be empty\")\n\n    max_abs_product = None\n    all_ints = True\n\n    for i, element in enumerate(pairs):\n        _Validator.validate_is_2tuple(element, i)\n\n        a, b = element\n\n        _Validator.validate_items_numeric(element, i)\n\n        # Check if all numbers encountered so far are integers (bool is an int)\n        if not isinstance(a, int) or not isinstance(b, int):\n            all_ints = False\n\n        prod = a * b\n        abs_prod = abs(prod)\n\n        if max_abs_product is None or abs_prod > max_abs_product:\n            max_abs_product = abs_prod\n\n    if all_ints:\n        return int(max_abs_product)\n    else:\n        return float(max_abs_product)"}
{"task_id": "Mbpp/127", "solution": "def _validate_operand(x) -> None:\n    if type(x) is not int:\n        raise TypeError(\"Operands must be int\")\n\ndef multiply_int(a: int, b: int) -> int:\n    \"\"\"Validate operands and return their mathematical product as int.\"\"\"\n    _validate_operand(a)\n    _validate_operand(b)\n    return a * b"}
