ms_prev = prefix_sums_current\n    \n    # The total number of sequences of length n is the sum of all valid sequences ending at any element from 1 to m.\n    # This sum is available as the last element of the prefix_sums_prev array for length n.\n    return prefix_sums_prev[m]", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/252": [{"task_id": "Mbpp/252", "solution": "def convert(input: Union[complex, float, int]) -> Tuple[float, float]:\n    \"\"\"Convert complex number to polar coordinates.\n\n    Uses math.sqrt for magnitude and math.atan2 for angle.\n    \"\"\"\n    if not isinstance(input, complex):\n        input = complex(input)\n    \n    magnitude = math.sqrt(input.real**2 + input.imag**2)\n    angle = math.atan2(input.imag, input.real)\n    \n    return (magnitude, angle)", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/253": [{"task_id": "Mbpp/253", "solution": "def count_integer(input_list: list) -> int:\n    \"\"\"\n    Counts the number of integer elements in the given list.\n    Iterates through the list and checks the type of each element.\n    \"\"\"\n    count = 0\n    for element in input_list:\n        if isinstance(element, int):\n            count += 1\n    return count", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/257": [{"task_id": "Mbpp/257", "solution": "def swap_numbers(num1, num2):\n    \"\"\"\n    Swaps two numbers and returns them in a tuple in reverse order.\n    The second number comes first in the returned tuple, followed by the first number.\n    \"\"\"\n    return (num2, num1)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/247": [{"task_id": "Mbpp/247", "solution": "def lps(s: str) -> int:\n    \"\"\"\n    Finds the length of the longest palindromic subsequence in the given string.\n    Uses a dynamic programming approach to fill a 2D table.\n    \"\"\"\n    n = len(s)\n    if n == 0:\n        return 0\n\n    # dp[i][j] stores the length of the longest palindromic subsequence of substring s[i...j]\n    dp = [[0] * n for _ in range(n)]\n\n    # Base case: A single character is a palindrome of length 1\n    for i in range(n):\n        dp[i][i] = 1\n\n    # Fill the DP table for substrings of length 2 to n\n    # 'gap' represents the length of the substring minus 1\n    for gap in range(1, n):\n        for i in range(n - gap):\n            j = i + gap\n            if s[i] == s[j]:\n                # If characters match, they contribute 2 to the subsequence,\n                # plus the LPS of the inner substring s[i+1...j-1].\n                # dp[i+1][j-1] correctly defaults to 0 if i+1 > j-1 (empty inner string).\n                dp[i][j] = 2 + dp[i + 1][j - 1]\n            else:\n                # If characters don't match, take the maximum of\n                # excluding s[i] or excluding s[j].\n                dp[i][j] = max(dp[i + 1][j], dp[i][j - 1])\n\n    # The result for the entire string s[0...n-1] is at dp[0][n-1]\n    return dp[0][n-1]", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/162": [{"task_id": "Mbpp/162", "solution": "def sum_series(n: int) -> int:\n    \"\"\"\n    Calculates the sum of the series (n - 2*i) from i=0 to n // 2,\n    terminating if a term becomes less than or equal to 0.\n    \"\"\"\n    total_sum = 0\n    i = 0\n    while True:\n        term = n - 2 * i\n        if term <= 0:\n            break\n        total_sum += term\n        i += 1\n        if i > n // 2: # This condition might be redundant if term <= 0 captures it first, but included based on loop specification.\n            break\n    return total_sum", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/166": [{"task_id": "Mbpp/166", "solution": "def find_even_pair(numbers: list) -> int:\n    \"\"\"\n    Counts the number of pairs of integers in a list that xor to an even number.\n    This implementation adheres to the detailed architectural design provided.\n    \"\"\"\n\n    class XORCalculator:\n        \"\"\"Provides mathematical operations for XOR and even number detection.\"\"\"\n        def calculate_xor(self, a: int, b: int) -> int:\n            return a ^ b\n        \n        def is_even(self, value: int) -> bool:\n            return value % 2 == 0\n\n    class IntegerPair:\n        \"\"\"Represents a pair of integers and provides XOR operations.\"\"\"\n        def __init__(self, first: int, second: int, calculator: XORCalculator):\n            self._first = first\n            self._second = second\n            self._calculator = calculator\n            self._xor_result = None\n        \n        def xor_result(self) -> int:\n            \"\"\"Calculates and caches the XOR result of the pair.\"\"\"\n            if self._xor_result is None:\n                self._xor_result = self._calculator.calculate_xor(self._first, self._second)\n            return self._xor_result\n        \n        def is_xor_even(self) -> bool:\n            \"\"\"Checks if the XOR result of the pair is an even number.\"\"\"\n            return self._calculator.is_even(self.xor_result())\n\n    class IntegerList:\n        \"\"\"Encapsulates integer list operations and provides safe access to elements.\"\"\"\n        def __init__(self, values: list[int]):\n            self._values = values\n        \n        def size(self) -> int:\n            return len(self._values)\n        \n        def is_empty(self) -> bool:\n            return self.size() == 0\n        \n        def get(self, index: int) -> int:\n            return self._values[index]\n\n    class PairCounter:\n        \"\"\"Orchestrates pair generation and counting of even XOR results.\"\"\"\n        def __init__(self):\n            self._calculator = XORCalculator()\n        \n        def generate_pairs(self, in