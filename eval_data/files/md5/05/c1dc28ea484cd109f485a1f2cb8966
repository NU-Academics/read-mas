{"task_id": "HumanEval/112", "solution": "def reverse_delete(s, c):\n    \"\"\"\n    Deletes characters from string 's' that are present in 'c' and checks if the resulting string is a palindrome.\n    Returns a tuple of the resulting string and a boolean indicating if it's a palindrome.\n    \"\"\"\n    # Create a set of characters from 'c' for efficient lookup.\n    c_chars_to_delete = set(c)\n\n    # Build the new string by including only characters from 's' not in 'c_chars_to_delete'.\n    result_chars = []\n    for char_s in s:\n        if char_s not in c_chars_to_delete:\n            result_chars.append(char_s)\n    \n    result_string = \"\".join(result_chars)\n\n    # Check if the result string is a palindrome.\n    # A string is a palindrome if it reads the same forwards and backwards.\n    is_palindrome = result_string == result_string[::-1]\n\n    return (result_string, is_palindrome)"}
{"task_id": "HumanEval/112", "solution": "def reverse_delete(s,c):\n    \"\"\"Deletes characters from s found in c and checks if the resulting string is a palindrome.\n    Returns a tuple with the filtered string and a boolean indicating if it's a palindrome.\n    \"\"\"\n    chars_to_remove = set(c)\n    filtered_chars = []\n    for char_s in s:\n        if char_s not in chars_to_remove:\n            filtered_chars.append(char_s)\n    result_string = \"\".join(filtered_chars)\n\n    is_palindrome_check = True\n    left = 0\n    right = len(result_string) - 1\n    while left < right:\n        if result_string[left] != result_string[right]:\n            is_palindrome_check = False\n            break\n        left += 1\n        right -= 1\n\n    return (result_string, is_palindrome_check)"}
{"task_id": "HumanEval/113", "solution": "def odd_count(lst):\n    \"\"\"Counts odd digits in each string and formats a sentence.\n\n    Replaces every 'i' in the template with the count of odd digits.\n    \"\"\"\n    TEMPLATE = \"the number of odd elements in the string i of the input.\"\n    \n    results = []\n    odd_chars = {'1', '3', '5', '7', '9'}\n\n    for s in lst:\n        # Count odd digits in the string\n        count = sum(1 for char_digit in s if char_digit in odd_chars)\n        \n        # Format the template string by replacing 'i' with the count\n        formatted_string = TEMPLATE.replace(\"i\", str(count))\n        \n        results.append(formatted_string)\n        \n    return results"}
{"task_id": "HumanEval/114", "solution": "def minSubArraySum(nums):\n    \"\"\"\n    Finds the minimum sum of any non-empty contiguous sub-array of nums.\n    Uses an O(n) Kadane's-like algorithm.\n    \"\"\"\n    current_min_sum = nums[0]\n    overall_min_sum = nums[0]\n\n    for num in nums[1:]:\n        current_min_sum = min(num, current_min_sum + num)\n        overall_min_sum = min(overall_min_sum, current_min_sum)\n\n    return overall_min_sum"}
{"task_id": "HumanEval/114", "solution": "def minSubArraySum(nums):\n    \"\"\"\n    Finds the minimum sum of any non-empty sub-array using a variation of Kadane's algorithm.\n    This algorithm runs in O(n) time and O(1) space.\n    \"\"\"\n    min_ending_here = nums[0]\n    min_so_far = nums[0]\n\n    for i in range(1, len(nums)):\n        # If min_ending_here is positive, starting a new subarray from current element\n        # will yield a smaller sum than extending the current min_ending_here.\n        # Otherwise, extend the current min_ending_here by adding the current element.\n        min_ending_here = min(nums[i], min_ending_here + nums[i])\n        \n        # Update min_so_far if min_ending_here is smaller\n        min_so_far = min(min_so_far, min_ending_here)\n\n    return min_so_far"}
{"task_id": "HumanEval/115", "solution": "def max_fill(grid, capacity):\n    \"\"\"\n    Calculates the total number of times buckets need to be lowered to empty all wells.\n    For each well (row), it sums the water units and applies ceil division by capacity.\n    \"\"\"\n    total_lowerings = 0\n    for row in grid:\n        water_in_well = sum(row)\n        if water_in_well > 0:\n            lowerings_for_well = math.ceil(water_in_well / capacity)\n            total_lowerings += lowerings_for_well\n    return total_lowerings"}
{"task_id": "HumanEval/115", "solution": "\n    total_lowers = 0\n    for row in grid:\n        units_in_well = sum(row)\n        # Calculate the number of times the bucket needs to be lowered for this well\n        # using integer division to achieve a ceiling effect.\n        lowers_for_well = (units_in_well + capacity - 1) // capacity\n        total_lowers += lowers_for_well\n    return total_lowers"}
{"task_id": "HumanEval/116", "solution": "def sort_array(arr):\n    \"\"\"\n    Sorts an array of integers by the number of ones in their binary representation in ascending order.\n    For numbers with the same count of ones, they are sorted by their decimal value in ascending order.\n    \"\"\"\n\n    def bit_count(n: int) -> int:\n        \"\"\"Counts the number of set bits in the absolute value of an integer.\"\"\"\n        n = abs(n)\n        return n.bit_count()\n\n    def compute_sort_key(value: int) -> tuple[int, int]:\n        \"\"\"Generates a sorting key (ones_count, original_value) for a given integer.\"\"\"\n        return (bit_count(value), value)\n\n    # Create a list of (sort_key, original_value) pairs\n    keyed_values = [(compute_sort_key(x), x) for x in arr]\n\n    # Sort the list using the keys; Python's Timsort is stable.\n    keyed_values.sort(key=lambda item: item[0])\n\n    # Extract the original values from the sorted list\n    result = [item[1] for item in keyed_values]\n\n    return result"}
{"task_id": "HumanEval/116", "solution": "```python\ndef sort_array(arr):\n    \"\"\"\n    In this Kata, you have to sort an array of non-negative integers according to\n    number of ones in their binary representation in ascending order.\n    For similar number of ones, sort based on decimal value.\n\n    It must be implemented like this:\n    >>> sort_array([1, 5, 2, 3, 4]) == [1, 2, 3, 4, 5]\n    >>> sort_array([-2, -3, -4, -5, -6]) == [-6, -5, -4, -3, -2]\n    >>> sort_array([1, 0, 2, 3, 4]) [0, 1, 2, 3, 4]\n    \"\"\"\n    # The sorting logic prioritizes the count of set bits (ones) in the absolute value,\n    # then the decimal value for tie-breaking, as specified in the design context.\n    # Python's int.bit_count() method is used for efficient bit counting.\n    return sorted(arr, key=lambda x: (abs(x).bit_count(), x))\n```"}
{"task_id": "HumanEval/117", "solution": "def select_words(s, n):\n    \"\"\"Given a string s and a natural number n, you have been tasked to implement \n    a function that returns a list of all words from string s that contain exactly \n    n consonants, in order these words appear in the string s.\n    \"\"\"\n    VOWELS = {'a', 'e', 'i', 'o', 'u'}\n    \n    if not s:\n        return []\n\n    words = s.strip().split()\n    result = []\n\n    for word in words:\n        consonant_count = 0\n        for char in word.lower():\n            if char.isalpha() and char not in VOWELS:\n                consonant_count += 1\n        \n        if consonant_count == n:\n            result.append(word)\n            \n    return result"}
{"task_id": "HumanEval/117", "solution": "class TextUtils:\n    \"\"\"Helper class for text processing tasks like consonant counting and word splitting.\"\"\"\n    VOWELS = {\"a\", \"e\", \"i\", \"o\", \"u\"}\n\n    @staticmethod\n    def is_consonant(ch: str) -> bool:\n        \"\"\"Checks if a character is a consonant.\"\"\"\n        return len(ch) == 1 and ch.isalpha() and ch.lower() not in TextUtils.VOWELS\n\n    @staticmethod\n    def count_consonants(word: str) -> int:\n        \"\"\"Counts the number of consonants in a given word.\"\"\"\n        return sum(1 for ch in word if TextUtils.is_consonant(ch))\n\n    @staticmethod\n    def split_words(s: str) -> list[str]:\n        \"\"\"Splits a string into words based on whitespace.\"\"\"\n        stripped_s = s.strip()\n        return stripped_s.split() if stripped_s else []\n\nclass SelectRequest:\n    \"\"\"Data transfer object for select_words function requests.\"\"\"\n    def __init__(self, text: str, n: int):\n        self.text = text\n        self.n = n\n\nclass SelectResponse:\n    \"\"\"Data transfer object for select_words function responses.\"\"\"\n    def __init__(self, matches: list[str]):\n        self.matches = matches\n\n    def to_list(self) -> list[str]:\n        \"\"\"Returns the list of matching words.\"\"\"\n        return list(self.matches)\n\nclass SelectWordsService:\n    \"\"\"Core business logic to select words by consonant count.\"\"\"\n    def __init__(self, utils: TextUtils):\n        self._utils = utils\n\n    def select(self, request: SelectRequest) -> SelectResponse:\n        \"\"\"Selects words from the request text that have exactly n consonants.\"\"\"\n        matches = []\n        for w in self._utils.split_words(request.text):\n            if self._utils.count_consonants(w) == request.n:\n                matches.append(w)\n        return SelectResponse(matches)\n\nclass SelectWordsController:\n    \"\"\"Orchestrates the selection process, delegating to the service.\"\"\"\n    def __init__(self, service: SelectWordsService):\n        self._service = service\n\n    def handle(self, request: SelectRequest) -> SelectResponse:\n        \"\"\"Handles a select request and returns the response.\"\"\"\n        return self._service.select(request)\n\n    \n    req = SelectRequest(text=s, n=n)\n    utils = TextUtils()\n    service = SelectWordsService(utils)\n    controller = SelectWordsController(service)\n    return controller.handle(req).to_list()"}
{"task_id": "HumanEval/118", "solution": "VOWELS = {\"a\", \"e\", \"i\", \"o\", \"u\", \"A\", \"E\", \"I\", \"O\", \"U\"}\n\ndef get_closest_vowel(word):\n    \"\"\"\n    Finds the closest vowel that stands between two consonants from the right side of the word.\n    \"\"\"\n    def is_vowel(char):\n        return char in VOWELS\n\n    def is_consonant(char):\n        return char.isalpha() and char not in VOWELS\n\n    n = len(word)\n    if n < 3:\n        return \"\"\n\n    # Iterate from right to left, considering only middle characters (not first or last)\n    for i in range(n - 2, 0, -1):\n        mid_char = word[i]\n        left_char = word[i - 1]\n        right_char = word[i + 1]\n\n        if is_vowel(mid_char) and is_consonant(left_char) and is_consonant(right_char):\n            return mid_char\n            \n    return \"\""}
{"task_id": "HumanEval/118", "solution": "VOWELS = set(\"aeiouAEIOU\")\n\ndef is_vowel(ch: str) -> bool:\n    \"\"\"Checks if a character is a vowel.\"\"\"\n    return ch in VOWELS\n\ndef is_consonant(ch: str) -> bool:\n    \"\"\"Checks if a character is a consonant.\"\"\"\n    return ch.isalpha() and ch not in VOWELS\n\ndef get_closest_vowel(word):\n    \"\"\"You are given a word. Your task is to find the closest vowel that stands between \n    two consonants from the right side of the word (case sensitive).\n    \n    Vowels in the beginning and ending doesn't count. Return empty string if you didn't\n    find any vowel met the above condition. \n\n    You may assume that the given string contains English letter only.\n\n    Example:\n    get_closest_vowel(\"yogurt\") ==> \"u\"\n    get_closest_vowel(\"FULL\") ==> \"U\"\n    get_closest_vowel(\"quick\") ==> \"\"\n    get_closest_vowel(\"ab\") ==> \"\"\n    \"\"\"\n    \n    # Iterate from right to left, excluding the first and last character.\n    # The loop range len(word) - 2 to 0 (exclusive) covers indices from (length - 2) down to 1.\n    for i in range(len(word) - 2, 0, -1):\n        char = word[i]\n        # Check if the current character is a vowel and its immediate neighbors are consonants.\n        if is_vowel(char) and is_consonant(word[i - 1]) and is_consonant(word[i + 1]):\n            return char\n    return \"\""}
{"task_id": "HumanEval/119", "solution": "def match_parens(lst):\n    \"\"\"\n    Checks if two parenthesis strings can be concatenated in any order to form a balanced string.\n    \"\"\"\n\n    def _compute_net_and_min(s: str) -> tuple[int, int]:\n        \"\"\"\n        Computes the net balance and the minimum prefix balance for a string.\n        (net_balance, min_prefix_balance)\n        \"\"\"\n        net_balance = 0\n        min_prefix_balance = 0\n        for char in s:\n            if char == '(':\n                net_balance += 1\n            else:  # char == ')'\n                net_balance -= 1\n            min_prefix_balance = min(min_prefix_balance, net_balance)\n        return net_balance, min_prefix_balance\n\n    def _can_concatenate_good(net_a: int, min_a: int, net_b: int, min_b: int) -> bool:\n        \"\"\"\n        Determines if a string with (net_a, min_a) concatenated with a string\n        with (net_b, min_b) forms a good (balanced) parentheses string.\n        \"\"\"\n        # 1. The first string 'a' must not have any negative prefix balance on its own.\n        if min_a < 0:\n            return False\n        \n        # 2. When 'b' is appended, its prefixes (adjusted by 'a's net balance) must not go negative.\n        if net_a + min_b < 0:\n            return False\n            \n        # 3. The total balance of the concatenated string must be zero.\n        if net_a + net_b != 0:\n            return False\n            \n        return True\n\n    s1, s2 = lst[0], lst[1]\n\n    net_s1, min_s1 = _compute_net_and_min(s1)\n    net_s2, min_s2 = _compute_net_and_min(s2)\n\n    # Check s1 + s2\n    if _can_concatenate_good(net_s1, min_s1, net_s2, min_s2):\n        return 'Yes'\n    \n    # Check s2 + s1\n    if _can_concatenate_good(net_s2, min_s2, net_s1, min_s1):\n        return 'Yes'\n        \n    return 'No'"}
{"task_id": "HumanEval/119", "solution": "def match_parens(lst):\n    '''\n    You are given a list of two strings, both strings consist of open\n    parentheses '(' or close parentheses ')' only.\n    Your job is to check if it is possible to concatenate the two strings in\n    some order, that the resulting string will be good.\n    A string S is considered to be good if and only if all parentheses in S\n    are balanced. For example: the string '(())()' is good, while the string\n    '())' is not.\n    Return 'Yes' if there's a way to make a good string, and return 'No' otherwise.\n\n    Examples:\n    match_parens(['()(', ')']) == 'Yes'\n    match_parens([')', ')']) == 'No'\n    '''\n\n    def _get_balance_metrics(s: str) -> tuple[int, int]:\n        \"\"\"Calculates net balance and minimum prefix balance for a string.\"\"\"\n        balance = 0\n        min_balance = 0\n        for char in s:\n            if char == '(':\n                balance += 1\n            else:  # char must be ')' based on problem description\n                balance -= 1\n            min_balance = min(min_balance, balance)\n        return balance, min_balance\n\n    def _is_balanced_concatenation(\n        first_metrics: tuple[int, int], second_metrics: tuple[int, int]\n    ) -> bool:\n        \"\"\"Checks if concatenating two strings (by their metrics) results in a balanced string.\"\"\"\n        first_net_balance, first_min_prefix_balance = first_metrics\n        second_net_balance, second_min_prefix_balance = second_metrics\n\n        # The first string itself must not have a negative prefix balance.\n        if first_min_prefix_balance < 0:\n            return False\n\n        # The combined prefix balance must not go negative when the second string is appended.\n        if first_net_balance + second_min_prefix_balance < 0:\n            return False\n\n        # The total balance of the concatenated string must be zero.\n        if first_net_balance + second_net_balance != 0:\n            return False\n\n        return True\n\n    s1, s2 = lst\n\n    s1_metrics = _get_balance_metrics(s1)\n    s2_metrics = _get_balance_metrics(s2)\n\n    # Check order s1 + s2\n    if _is_balanced_concatenation(s1_metrics, s2_metrics):\n        return 'Yes'\n\n    # Check order s2 + s1\n    if _is_balanced_concatenation(s2_metrics, s1_metrics):\n        return 'Yes'\n\n    return 'No'"}
