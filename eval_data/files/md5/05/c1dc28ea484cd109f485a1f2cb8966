{"task_id": "HumanEval/156", "solution": "def int_to_mini_roman(number):\n    \"\"\"\n    Given a positive integer, obtain its roman numeral equivalent as a string,\n    and return it in lowercase.\n    Restrictions: 1 <= num <= 1000\n    \"\"\"\n    roman_map = [\n        (\"m\", 1000), (\"cm\", 900), (\"d\", 500), (\"cd\", 400),\n        (\"c\", 100), (\"xc\", 90), (\"l\", 50), (\"xl\", 40),\n        (\"x\", 10), (\"ix\", 9), (\"v\", 5), (\"iv\", 4), (\"i\", 1),\n    ]\n\n    result = []\n    current_num = number\n    for symbol, value in roman_map:\n        while current_num >= value:\n            result.append(symbol)\n            current_num -= value\n    return \"\".join(result)"}
{"task_id": "HumanEval/158", "solution": "def find_max(words):\n    \"\"\"\n    Returns the word with the maximum number of unique characters from a list of strings.\n    Tie-breaks by lexicographical order if counts are equal.\n    \"\"\"\n    if not words:\n        return \"\"\n\n    best_word = \"\"\n    best_count = -1\n\n    for word in words:\n        # Calculate unique characters for the current word\n        current_count = len(set(word))\n\n        # Check if current word is better than the best found so far\n        if current_count > best_count:\n            best_count = current_count\n            best_word = word\n        elif current_count == best_count:\n            # Tie-breaking by lexicographical order\n            if word < best_word:\n                best_word = word\n\n    return best_word"}
{"task_id": "HumanEval/157", "solution": "import math\n\ndef right_angle_triangle(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle. Return True if the three\n    sides form a right-angled triangle, False otherwise.\n    '''\n    \n    # Cast inputs to float for consistent calculations as per design.\n    a_f = float(a)\n    b_f = float(b)\n    c_f = float(c)\n\n    # Check if sides are positive and finite; otherwise, it's not a valid triangle.\n    for side in (a_f, b_f, c_f):\n        if not math.isfinite(side) or side <= 0:\n            return False\n\n    # Check triangle inequality: sum of any two sides must be greater than the third.\n    if not ((a_f + b_f > c_f) and (a_f + c_f > b_f) and (b_f + c_f > a_f)):\n        return False\n\n    # Sort sides to identify the hypotenuse (the largest side).\n    x, y, z = sorted((a_f, b_f, c_f))\n\n    # Define epsilon for floating-point comparison, as specified in the design context.\n    epsilon = 1e-9\n\n    # Apply Pythagorean theorem: c^2 = a^2 + b^2, checking with tolerance.\n    lhs = z * z\n    rhs = x * x + y * y\n\n    return abs(lhs - rhs) <= epsilon * max(1.0, rhs)"}
{"task_id": "HumanEval/157", "solution": "def right_angle_triangle(a, b, c):\n    \"\"\"\n    Given the lengths of the three sides of a triangle. Return True if the three\n    sides form a right-angled triangle, False otherwise.\n    \"\"\"\n    def approx_equal(x: float, y: float, tol: float = 1e-9) -> bool:\n        \"\"\"Compares two floats for approximate equality within a given tolerance.\"\"\"\n        return abs(x - y) <= tol * max(1.0, abs(x), abs(y))\n\n    # Sort the sides to identify the potential hypotenuse (the largest side)\n    sides = sorted([a, b, c])\n    x, y, z = sides[0], sides[1], sides[2]\n\n    # Apply the Pythagorean theorem (a^2 + b^2 = c^2) with a tolerance\n    return approx_equal(x*x + y*y, z*z)"}
{"task_id": "HumanEval/158", "solution": "def find_max(words):\n    \"\"\"\n    Finds the word with the maximum number of unique characters.\n    If there's a tie, returns the lexicographically smallest word among them.\n    \"\"\"\n    if not words:\n        return \"\"\n\n    # Calculate unique character count for each word\n    word_stats = []\n    for word in words:\n        unique_count = len(set(word))\n        word_stats.append((unique_count, word))\n\n    # Determine the maximum unique character count\n    max_unique_count = -1\n    if word_stats:\n        max_unique_count = max(stat[0] for stat in word_stats)\n\n    # Collect all words that achieve the maximum unique character count\n    candidates = []\n    for unique_count, word in word_stats:\n        if unique_count == max_unique_count:\n            candidates.append(word)\n\n    # From the candidates, return the one that comes first lexicographically\n    if candidates:\n        return min(candidates)\n    \n    return \"\"  # Should not be reached if words is not empty and word_stats is populated"}
