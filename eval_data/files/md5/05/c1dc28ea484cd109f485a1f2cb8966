{"task_id": "HumanEval/55", "solution": "def fib(n: int):\n    \"\"\"Return n-th Fibonacci number using fast doubling.\"\"\"\n    if n == 0:\n        return 0\n\n    def _fast_doubling(k: int) -> tuple[int, int]:\n        \"\"\"Returns (F(k), F(k+1)) using recursive fast doubling.\"\"\"\n        if k == 0:\n            return (0, 1)\n\n        a, b = _fast_doubling(k >> 1)\n        \n        c = a * (2 * b - a) # F(2k) = F(k) * (2 * F(k+1) - F(k))\n        d = a * a + b * b   # F(2k+1) = F(k)^2 + F(k+1)^2\n        \n        if k & 1: # If k is odd\n            return (d, c + d) # (F(2k+1), F(2k+2))\n        else: # If k is even\n            return (c, d)     # (F(2k), F(2k+1))\n\n    fn, _ = _fast_doubling(n)\n    return fn"}
{"task_id": "HumanEval/55", "solution": "from .service import FibService\nfrom .repository.cache import CacheRepository\nfrom .calculators.iterative import IterativeCalculator\nfrom .calculators.memoized import MemoizedCalculator\nfrom .calculators.matrix import MatrixCalculator\nfrom .config import DEFAULT_DB_PATH, DEFAULT_ALGORITHM, ALGORITHM_THRESHOLD\n\n_default_cache = CacheRepository(DEFAULT_DB_PATH)\n_default_algos = {\n    \"iterative\": IterativeCalculator(),\n    \"memoized\": MemoizedCalculator(),\n    \"matrix\": MatrixCalculator(),\n}\n_default_service = FibService(\n    _default_cache,\n    _default_algos,\n    default_algorithm=DEFAULT_ALGORITHM,\n    algorithm_threshold=ALGORITHM_THRESHOLD\n)\n\ndef fib(n: int):\n    \"\"\"Return n-th Fibonacci number.\n    >>> fib(10)\n    55\n    >>> fib(1)\n    1\n    >>> fib(8)\n    21\n    \"\"\"\n    result = _default_service.compute(n)\n    return result.value"}
