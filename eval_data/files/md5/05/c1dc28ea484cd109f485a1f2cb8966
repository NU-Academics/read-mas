{"task_id": "HumanEval/58", "solution": "import json\nimport hashlib\nimport os\nimport logging\nimport shutil\nfrom typing import Iterable, List, Optional\n\n# --- Exceptions ---\nclass ValidationError(Exception):\n    \"\"\"Exception raised for invalid input.\"\"\"\n    pass\n\nclass ServiceError(Exception):\n    \"\"\"Exception raised for unexpected errors within the service logic.\"\"\"\n    pass\n\n# --- Config ---\n# Default cache file path and caching enablement flag\nDEFAULT_CACHE_FILE = os.path.expanduser(\"~/.cache/listcommons/cache.json\")\nCACHE_ENABLED = True\n\n# --- Utils ---\ndef make_key(l1: list, l2: list) -> str:\n    \"\"\"Generate a deterministic SHA256 key from two lists for caching.\"\"\"\n    # Serialize lists to JSON with sorted keys and default string conversion for consistency.\n    s = json.dumps([l1, l2], default=str, sort_keys=True, separators=(',', ':'))\n    return hashlib.sha256(s.encode('utf-8')).hexdigest()\n\ndef safe_sort(seq: Iterable) -> List:\n    \"\"\"Safely sort an iterable, raising TypeError if elements are incomparable.\"\"\"\n    try:\n        return sorted(seq)\n    except TypeError as e:\n        raise e # Let caller (e.g., CommonService) handle and wrap this\n\n# --- Validators ---\nclass InputValidator:\n    \"\"\"Validates input lists and their elements for comparability.\"\"\"\n    def validate_lists(self, l1: list, l2: list) -> None:\n        \"\"\"Ensures inputs are lists and their elements are mutually comparable.\"\"\"\n        if not isinstance(l1, list) or not isinstance(l2, list):\n            raise ValidationError(\"Both inputs must be lists.\")\n        \n        # Sample a few elements to check for comparability without processing the whole list.\n        sample = []\n        sample.extend(l1[:5])\n        sample.extend(l2[:5])\n        if sample:\n            try:\n                sorted(sample)\n            except TypeError:\n                raise ValidationError(\"Elements are not mutually comparable for sorting.\")\n\n# --- Services ---\nclass CommonService:\n    \"\"\"Core logic for computing sorted unique common elements.\"\"\"\n    def compute_common(self, l1: list, l2: list) -> list:\n        \"\"\"Computes the sorted unique common elements of two lists using sets.\"\"\"\n        try:\n            set1 = set(l1)\n            set2 = set(l2)\n            common_elements_set = set1 & set2\n            return safe_sort(common_elements_set)\n        except TypeError as e:\n            # Catches errors like unhashable types during set conversion or incomparable types during sorting.\n            raise ServiceError(f\"Error computing common elements: {e}\") from e\n        except Exception as e:\n            raise ServiceError(f\"An unexpected error occurred in CommonService: {e}\") from e\n\n# --- Repositories ---\n_logger = logging.getLogger(__name__)\n\nclass InMemoryCacheRepository:\n    \"\"\"Manages an in-memory cache with optional JSON file persistence.\"\"\"\n    def __init__(self, persist_file: Optional[str] = None, enabled: bool = True) -> None:\n        self.persist_file = persist_file\n        self.enabled = enabled\n        self._store: dict[str, list] = {}\n        if self.enabled and self.persist_file:\n            self.load()\n\n    def get(self, key: str) -> Optional[list]:\n        \"\"\"Retrieves a cached list by key.\"\"\"\n        if not self.enabled:\n            return None\n        return self._store.get(key) # Returns reference; caller should not modify\n\n    def set(self, key: str, value: list) -> None:\n        \"\"\"Stores a list in the cache for a given key.\"\"\"\n        if not self.enabled:\n            return\n        self._store[key] = list(value) # Store a shallow copy\n        if self.persist_file:\n            self.persist()\n\n    def persist(self) -> None:\n        \"\"\"Writes the current cache to the configured JSON file atomically.\"\"\"\n        if not self.persist_file:\n            return\n        try:\n            temp_file = self.persist_file + \".tmp\"\n            with open(temp_file, 'w', encoding='utf-8') as f:\n                json.dump(self._store, f, default=str, ensure_ascii=False)\n            shutil.move(temp_file, self.persist_file) # Atomic rename\n        except Exception as e:\n            _logger.warning(f\"Failed to persist cache to {self.persist_file}: {e}\")\n\n    def load(self) -> None:\n        \"\"\"Loads the cache from the configured JSON file.\"\"\"\n        if not self.persist_file or not os.path.exists(self.persist_file):\n            return\n        try:\n            with open(self.persist_file, 'r', encoding='utf-8') as f:\n                self._store = json.load(f)\n        except json.JSONDecodeError as e:\n            _logger.warning(f\"Failed to decode cache from {self.persist_file}: {e}. Cache will be empty.\")\n            self._store = {}\n        except Exception as e:\n            _logger.warning(f\"Failed to load cache from {self.persist_file}: {e}. Cache will be empty.\")\n            self._store = {}\n\n# --- Controllers ---\nclass CommonController:\n    \"\"\"Orchestrates validation, caching, and common element computation.\"\"\"\n    def __init__(self, service: CommonService, validator: InputValidator, repository: InMemoryCacheRepository) -> None:\n        self.service = service\n        self.validator = validator\n        self.repository = repository\n\n    def get_common(self, l1: list, l2: list) -> list:\n        \"\"\"Retrieves sorted unique common elements, utilizing validation and caching.\"\"\"\n        self.validator.validate_lists(l1, l2)\n\n        key = make_key(l1, l2)\n\n        if self.repository.enabled:\n            cached_result = self.repository.get(key)\n            if cached_result is not None:\n                return cached_result # Cache hit\n\n        # Cache miss or caching disabled, compute result\n        result = self.service.compute_common(l1, l2)\n\n        if self.repository.enabled:\n            self.repository.set(key, result)\n\n        return result\n\n# --- Public API Function ---\n# Instantiate dependencies for the default public API\n_default_service = CommonService()\n_default_validator = InputValidator()\n_default_repository = InMemoryCacheRepository(persist_file=DEFAULT_CACHE_FILE, enabled=CACHE_ENABLED)\n\n# Instantiate the default controller\n_default_controller = CommonController(\n    service=_default_service,\n    validator=_default_validator,\n    repository=_default_repository,\n)\n\ndef common(l1: list, l2: list) -> list:\n    \"\"\"Return sorted unique common elements for two lists.\"\"\"\n    return _default_controller.get_common(l1, l2)"}
{"task_id": "HumanEval/59", "solution": "def largest_prime_factor(n: int):\n    \"\"\"Return the largest prime factor of n. Assume n > 1 and is not a prime.\"\"\"\n    largest_prime = 1\n\n    # Handle factors of 2\n    while n % 2 == 0:\n        largest_prime = 2\n        n //= 2\n\n    # Handle odd factors starting from 3\n    # Iterate only up to the square root of the remaining n\n    i = 3\n    while i * i <= n:\n        while n % i == 0:\n            largest_prime = i\n            n //= i\n        i += 2\n\n    # If n is still greater than 1, it must be a prime factor itself\n    # (and since all smaller factors have been divided out, this remaining n is the largest).\n    if n > 1:\n        largest_prime = n\n\n    return largest_prime"}
{"task_id": "HumanEval/59", "solution": "def largest_prime_factor(n: int):\n    \"\"\"Return the largest prime factor of n. Assume n > 1 and is not a prime.\"\"\"\n    largest_factor = 1\n\n    # Divide by 2 until n is odd\n    while n % 2 == 0:\n        largest_factor = 2\n        n //= 2\n\n    # Divide by 3 until n is not divisible by 3\n    while n % 3 == 0:\n        largest_factor = 3\n        n //= 3\n\n    # Check for prime factors from 5 upwards using a step of 6 (6k +/- 1)\n    i = 5\n    while i * i <= n:\n        # Check for factor i\n        while n % i == 0:\n            largest_factor = i\n            n //= i\n        # Check for factor i + 2\n        while n % (i + 2) == 0:\n            largest_factor = i + 2\n            n //= (i + 2)\n        i += 6\n\n    # If n is still greater than 1, it means the remaining n is prime\n    # and is the largest prime factor\n    if n > 1:\n        largest_factor = n\n\n    return largest_factor"}
