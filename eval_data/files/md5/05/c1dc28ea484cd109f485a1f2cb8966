{"task_id": "HumanEval/0", "solution": "def has_close_elements(numbers: List[float], threshold: float) -> bool:\n    \"\"\" Check if in given list of numbers, are any two numbers closer to each other than\n    given threshold.\n    \"\"\"\n    if len(numbers) < 2:\n        return False\n\n    # Sort the numbers to efficiently check adjacent differences.\n    sorted_numbers = sorted(numbers)\n\n    # Iterate through adjacent elements to find a pair closer than the threshold.\n    for i in range(len(sorted_numbers) - 1):\n        if (sorted_numbers[i+1] - sorted_numbers[i]) < threshold:\n            return True\n            \n    return False"}
{"task_id": "HumanEval/1", "solution": "def separate_paren_groups(paren_string: str) -> List[str]:\n    \"\"\" Input to this function is a string containing multiple groups of nested parentheses. Your goal is to\n    separate those group into separate strings and return the list of those.\n    Separate groups are balanced (each open brace is properly closed) and not nested within each other\n    Ignore any spaces in the input string.\n    >>> separate_paren_groups('( ) (( )) (( )( ))')\n    ['()', '(())', '(()())']\n    \"\"\"\n    sanitized_s = \"\".join(ch for ch in paren_string if ch != ' ')\n\n    balance = 0\n    start_index = -1\n    groups: List[str] = []\n\n    for i, ch in enumerate(sanitized_s):\n        if ch == '(':\n            if balance == 0:\n                start_index = i\n            balance += 1\n        elif ch == ')':\n            balance -= 1\n            if balance == 0 and start_index != -1:\n                groups.append(sanitized_s[start_index : i + 1])\n                start_index = -1\n\n    return groups"}
{"task_id": "HumanEval/1", "solution": "from typing import List\n\n\ndef separate_paren_groups(paren_string: str) -> List[str]:\n    \"\"\" Input to this function is a string containing multiple groups of nested parentheses. Your goal is to\n    separate those group into separate strings and return the list of those.\n    Separate groups are balanced (each open brace is properly closed) and not nested within each other\n    Ignore any spaces in the input string.\n    >>> separate_paren_groups('( ) (( )) (( )( ))')\n    ['()', '(())', '(()())']\n    \"\"\"\n    groups: List[str] = []\n    depth = 0\n    current_group_content_chars: List[str] = []\n\n    for char in paren_string:\n        if char.isspace():\n            continue\n\n        if char == '(':\n            if depth == 0:\n                # Start of a new top-level group\n                current_group_content_chars = []\n            current_group_content_chars.append(char)\n            depth += 1\n        elif char == ')':\n            current_group_content_chars.append(char)\n            depth -= 1\n            if depth == 0:\n                # End of a top-level balanced group\n                groups.append(\"\".join(current_group_content_chars))\n                current_group_content_chars = []  # Reset for the next group\n\n    return groups"}
{"task_id": "HumanEval/2", "solution": "from math import floor\n\ndef truncate_number(number: float) -> float:\n    \"\"\" Given a positive floating point number, it can be decomposed into\n    an integer part (largest integer smaller than given number) and decimals\n    (leftover part always smaller than 1).\n\n    Return the decimal part of the number.\n    \"\"\"\n    integer_part = floor(number)\n    decimal_part = number - integer_part\n    # Adjust for potential floating point inaccuracies where `decimal_part`\n    # might be extremely close to 1.0 instead of 0.0 (e.g., 2.0 - floor(2.0))\n    if abs(decimal_part - 1.0) < 1e-12:\n        return 0.0\n    return decimal_part"}
{"task_id": "HumanEval/0", "solution": "    \"\"\" Check if in given list of numbers, are any two numbers closer to each other than\n    given threshold.\n    >>> has_close_elements([1.0, 2.0, 3.0], 0.5)\n    False\n    >>> has_close_elements([1.0, 2.8, 3.0, 4.0, 5.0, 2.0], 0.3)\n    True\n    \"\"\"\n    if len(numbers) < 2:\n        return False\n\n    # Sort the numbers to efficiently check adjacent elements for closeness.\n    sorted_numbers = sorted(numbers)\n\n    # Iterate through the sorted list and check differences between adjacent numbers.\n    for i in range(1, len(sorted_numbers)):\n        if sorted_numbers[i] - sorted_numbers[i - 1] < threshold:\n            return True\n\n    return False"}
{"task_id": "HumanEval/2", "solution": "import math\n\ndef truncate_number(number: float) -> float:\n    \"\"\" Given a positive floating point number, return its decimal part.\n    Handles floating point inaccuracies by treating numbers very close to an integer as having 0.0 decimal part.\n    \"\"\"\n    tolerance = 1e-12 # A small value to account for floating-point inaccuracies.\n\n    # Calculate the integer part, adjusting for potential floating-point precision issues\n    # that might place a number slightly below an intended integer.\n    integer_part = math.floor(number + tolerance)\n\n    # Calculate the raw decimal part.\n    decimal_part = number - integer_part\n\n    # If the decimal part is very close to zero due to floating-point errors, normalize it to 0.0.\n    if abs(decimal_part) < tolerance:\n        return 0.0\n\n    return decimal_part"}
