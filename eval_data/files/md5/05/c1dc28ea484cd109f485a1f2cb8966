{"task_id": "HumanEval/160", "solution": "```python\ndef do_algebra(operator, operand):\n    \"\"\"\n    Evaluates an algebraic expression built from interleaved operators and operands,\n    respecting standard operator precedence and associativity using the Shunting-Yard algorithm.\n    \"\"\"\n    OPERATOR_PRECEDENCE = {\"**\": 4, \"*\": 3, \"//\": 3, \"+\": 2, \"-\": 2}\n    RIGHT_ASSOCIATIVE = {\"**\"}\n\n    output_queue = []  # Stores tokens in Reverse Polish Notation (RPN)\n    operator_stack = []  # Temporarily holds operators\n\n    # Build an interleaved token stream: operand[0], operator[0], operand[1], ...\n    token_stream = []\n    for i in range(len(operand)):\n        token_stream.append(operand[i])\n        if i < len(operator):\n            token_stream.append(operator[i])\n\n    # Shunting-Yard algorithm to convert to RPN\n    for token in token_stream:\n        if isinstance(token, int):  # Token is an operand\n            output_queue.append(token)\n        else:  # Token is an operator\n            current_op = token\n            while (operator_stack and\n                   operator_stack[-1] in OPERATOR_PRECEDENCE and  # Ensure it's a known operator\n                   (OPERATOR_PRECEDENCE[operator_stack[-1]] > OPERATOR_PRECEDENCE[current_op] or\n                    (OPERATOR_PRECEDENCE[operator_stack[-1]] == OPERATOR_PRECEDENCE[current_op] and\n                     operator_stack[-1] not in RIGHT_ASSOCIATIVE))):\n                output_queue.append(operator_stack.pop())\n            operator_stack.append(current_op)\n\n    # Pop any remaining operators from the stack to the output queue\n    while operator_stack:\n        output_queue.append(operator_stack.pop())\n\n    # Evaluate the RPN expression using a stack\n    evaluation_stack = []\n    for token in output_queue:\n        if isinstance(token, int):  # Token is an operand\n            evaluation_stack.append(token)\n        else:  # Token is an operator\n            right_operand = evaluation_stack.pop()\n            left_operand = evaluation_stack.pop()\n            \n            result = 0\n            if token == '+':\n                result = left_operand + right_operand\n            elif token == '-':\n                result = left_operand - right_operand\n            elif token == '*':\n                result = left_operand * right_operand\n            elif token == '//':\n                result = left_operand // right_operand\n            elif token == '**':\n                result = left_operand ** right_operand\n            \n            evaluation_stack.append(result)\n\n    return evaluation_stack[0]\n```"}
{"task_id": "HumanEval/160", "solution": "from enum import Enum\nfrom abc import ABC, abstractmethod\nfrom typing import List\n\n\nclass InvalidInputError(Exception):\n    \"\"\"Exception raised for invalid input data.\"\"\"\n    pass\n\n\nclass ParseError(InvalidInputError):\n    \"\"\"Exception raised when unable to parse the expression.\"\"\"\n    pass\n\n\nclass EvaluationError(Exception):\n    \"\"\"Exception raised during expression evaluation.\"\"\"\n    pass\n\n\nclass Operator(Enum):\n    \"\"\"Enumeration for supported algebraic operators.\"\"\"\n    PLUS = '+'\n    MINUS = '-'\n    MUL = '*'\n    FLOOR_DIV = '//'\n    POW = '**'\n\n    @staticmethod\n    def from_token(token: str) -> \"Operator\":\n        \"\"\"Converts a string token to an Operator enum member.\"\"\"\n        for op in Operator:\n            if op.value == token:\n                return op\n        raise ValueError(f\"Unknown operator token: {token}\")\n\n\nclass ExpressionNode(ABC):\n    \"\"\"Abstract base class for all expression tree nodes.\"\"\"\n    @abstractmethod\n    def evaluate(self) -> int:\n        pass\n\n\nclass NumberNode(ExpressionNode):\n    \"\"\"Represents a numeric leaf node in the expression tree.\"\"\"\n    def __init__(self, value: int):\n        self._value = value\n\n    def evaluate(self) -> int:\n        \"\"\"Evaluates the number node, returning its integer value.\"\"\"\n        return self._value\n\n\nclass BinaryOpNode(ExpressionNode):\n    \"\"\"Represents a binary operation node in the expression tree.\"\"\"\n    def __init__(self, left: ExpressionNode, op: Operator, right: ExpressionNode):\n        self._left = left\n        self._op = op\n        self._right = right\n\n    def evaluate(self) -> int:\n        \"\"\"Evaluates the binary operation node.\"\"\"\n        l = self._left.evaluate()\n        r = self._right.evaluate()\n        if self._op is Operator.PLUS:\n            return l + r\n        if self._op is Operator.MINUS:\n            return l - r\n        if self._op is Operator.MUL:\n            return l * r\n        if self._op is Operator.FLOOR_DIV:\n            if r == 0:\n                raise ZeroDivisionError(\"division by zero\")\n            return l // r\n        if self._op is Operator.POW:\n            return l ** r\n        raise ValueError(f\"Unsupported operator: {self._op.value}\")\n\n\nclass ExpressionBuilder:\n    \"\"\"Builds an abstract syntax tree (AST) from operator and operand lists.\"\"\"\n    def build(self, operators: List[str], operands: List[int]) -> ExpressionNode:\n        \"\"\"Constructs an AST representing the algebraic expression.\"\"\"\n        op_stack: List[Operator] = []\n        val_stack: List[ExpressionNode] = []\n\n        val_stack.append(NumberNode(operands[0]))\n        for i, tok in enumerate(operators):\n            current_op = Operator.from_token(tok)\n            while op_stack:\n                top = op_stack[-1]\n                top_prec = self._prec(top)\n                cur_prec = self._prec(current_op)\n                if (top_prec > cur_prec) or \\\n                   (top_prec == cur_prec and self._is_left_assoc(top)):\n                    op_stack.pop()\n                    right = val_stack.pop()\n                    left = val_stack.pop()\n                    val_stack.append(BinaryOpNode(left, top, right))\n                else:\n                    break\n            op_stack.append(current_op)\n            val_stack.append(NumberNode(operands[i+1]))\n\n        while op_stack:\n            op = op_stack.pop()\n            right = val_stack.pop()\n            left = val_stack.pop()\n            val_stack.append(BinaryOpNode(left, op, right))\n        return val_stack[-1]\n\n    def _prec(self, op: Operator) -> int:\n        \"\"\"Returns the precedence level for an operator.\"\"\"\n        if op is Operator.POW:\n            return 3\n        if op in (Operator.MUL, Operator.FLOOR_DIV):\n            return 2\n        return 1\n\n    def _is_left_assoc(self, op: Operator) -> bool:\n        \"\"\"Checks if an operator is left-associative.\"\"\"\n        return op is not Operator.POW\n\n\nclass ExpressionEvaluator:\n    \"\"\"Evaluates an ExpressionNode (AST) to an integer result.\"\"\"\n    def evaluate(self, node: ExpressionNode) -> int:\n        \"\"\"Traverses the AST and computes the integer result.\"\"\"\n        try:\n            return node.evaluate()\n        except ZeroDivisionError as ex:\n            raise EvaluationError(str(ex))\n        except ValueError as ex:\n            raise EvaluationError(str(ex))\n\n\ndef do_algebra(operator: List[str], operand: List[int]) -> int:\n    \"\"\"\n    Given two lists operator, and operand. The first list has basic algebra operations, and\n    the second list is a list of integers. Use the two given lists to build the algebric\n    expression and return the evaluation of this expression.\n    \"\"\"\n    builder = ExpressionBuilder()\n    evaluator = ExpressionEvaluator()\n    expression_tree = builder.build(operator, operand)\n    result = evaluator.evaluate(expression_tree)\n    return result"}
{"task_id": "HumanEval/162", "solution": "import hashlib\nfrom typing import Optional\n\n\ndef string_to_md5(text: str) -> Optional[str]:\n    \"\"\"\n    Given a string 'text', return its md5 hash equivalent string.\n    If 'text' is an empty string, return None.\n    \"\"\"\n    if text == \"\":\n        return None\n    b = text.encode(\"utf-8\")\n    h = hashlib.md5(b).hexdigest()\n    return h.lower()"}
