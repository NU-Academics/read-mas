{"task_id": "HumanEval/67", "solution": "import re\n\ndef fruit_distribution(s,n):\n    \"\"\"\n    Given a string like \"5 apples and 6 oranges\" and a total number of fruits,\n    return the number of mango fruits.\n    \"\"\"\n    # Regex pattern to capture apple and orange counts, handling pluralization.\n    # Uses named groups 'apples' and 'oranges' for easy extraction.\n    APPLY_REGEX = re.compile(r\"(?P<apples>\\d+)\\s*apples?\\s*(?:and)\\s*(?P<oranges>\\d+)\\s*oranges?\", re.IGNORECASE)\n\n    m = APPLY_REGEX.search(s)\n\n    # Assuming valid input format based on problem description and examples,\n    # a match will always be found.\n    apples = int(m.group(\"apples\"))\n    oranges = int(m.group(\"oranges\"))\n\n    # Calculate the number of mangoes\n    mangoes = n - apples - oranges\n\n    return mangoes"}
{"task_id": "HumanEval/67", "solution": "import re\n\ndef fruit_distribution(s, n):\n    \"\"\"\n    Computes the number of mango fruits in a basket given a string of apple and orange counts and the total fruits.\n    \"\"\"\n\n    class InvalidInputError(Exception):\n        \"\"\"Custom exception for invalid input encountered during parsing or validation.\"\"\"\n        def __init__(self, message: str) -> None:\n            super().__init__(message)\n            self.message = message\n        def __str__(self) -> str:\n            return self.message\n\n    class FruitCounts:\n        \"\"\"Data model for parsed fruit counts (apples and oranges).\"\"\"\n        def __init__(self, apples: int, oranges: int) -> None:\n            self.apples: int = apples\n            self.oranges: int = oranges\n        def total_counts(self) -> int:\n            return self.apples + self.oranges\n\n    # Configuration for parsing, based on PARSE_REGEX from design context\n    PARSE_REGEX = r\"(?P<apples>\\d+)\\s*apples?\\s*(?:and|,)\\s*(?P<oranges>\\d+)\\s*oranges?\"\n    _COMPILED_REGEX = re.compile(PARSE_REGEX, re.IGNORECASE)\n\n    def safe_int(value: str) -> int:\n        \"\"\"Converts a string to an integer, raising InvalidInputError on failure.\"\"\"\n        try:\n            return int(value)\n        except ValueError:\n            raise InvalidInputError(f\"Invalid integer value: '{value}'\")\n\n    def normalize_whitespace(input_string: str) -> str:\n        \"\"\"Normalizes whitespace and converts the input string to lowercase.\"\"\"\n        return \" \".join(input_string.strip().split()).lower()\n\n    def _parse_input_string(input_str: str) -> FruitCounts:\n        \"\"\"Parses the input string to extract apple and orange counts.\"\"\"\n        s_normalized = normalize_whitespace(input_str)\n        m = _COMPILED_REGEX.search(s_normalized)\n        if not m:\n            raise InvalidInputError(f\"Could not parse counts from '{input_str}'\")\n        \n        apples = safe_int(m.group('apples'))\n        oranges = safe_int(m.group('oranges'))\n\n        return FruitCounts(apples=apples, oranges=oranges)\n\n    def _validate_total(total_fruits: int) -> None:\n        \"\"\"Validates the total number of fruits. Assumes 'total_fruits' is an int per type hint.\"\"\"\n        # As per design, negative totals are allowed and type checking (isinstance) is not required for `int` type hint.\n        pass\n\n    def _validate_counts(counts: FruitCounts) -> None:\n        \"\"\"Validates that apple and orange counts are non-negative.\"\"\"\n        if counts.apples < 0:\n            raise InvalidInputError(f\"Apple count cannot be negative: {counts.apples}\")\n        if counts.oranges < 0:\n            raise InvalidInputError(f\"Orange count cannot be negative: {counts.oranges}\")\n\n    def _compute_mangoes(total_fruits: int, counts: FruitCounts) -> int:\n        \"\"\"Calculates the number of mangoes by subtracting apples and oranges from the total.\"\"\"\n        return total_fruits - counts.apples - counts.oranges\n\n    # --- Main function logic ---\n    _validate_total(n) # Validate the total number of fruits.\n    \n    parsed_counts = _parse_input_string(s) # Extract apple and orange counts from the input string.\n    \n    _validate_counts(parsed_counts) # Ensure parsed counts are valid (non-negative).\n    \n    mango_count = _compute_mangoes(n, parsed_counts) # Compute the final mango count.\n    \n    return mango_count"}
{"task_id": "HumanEval/68", "solution": "def pluck(arr):\n    \"\"\"\n    Finds the smallest even node in an array and returns its value and index.\n    Prioritizes the smallest index for ties in value.\n    \"\"\"\n    best_value = None\n    best_index = -1\n\n    for i, v in enumerate(arr):\n        if v % 2 == 0:  # Check if the value is even\n            # If no even value has been found yet, or the current even value is smaller,\n            # or the current even value is equal to the best_value but has a smaller index\n            if best_value is None or v < best_value or (v == best_value and i < best_index):\n                best_value = v\n                best_index = i\n\n    if best_value is None:\n        return []\n    return [best_value, best_index]"}
{"task_id": "HumanEval/69", "solution": "import collections\n\ndef search(lst):\n    \"\"\"\n    Returns the greatest integer x > 0 such that its frequency in the list is greater than or equal to x.\n    If no such integer exists, returns -1.\n    \"\"\"\n    freq_map = collections.Counter(lst)\n    \n    candidates = []\n    for num, freq in freq_map.items():\n        if num > 0 and freq >= num:\n            candidates.append(num)\n            \n    return max(candidates) if candidates else -1"}
{"task_id": "HumanEval/70", "solution": "def strange_sort_list(lst):\n    \"\"\"\n    Sorts a list of integers in a strange order: min, max, min, max, etc.\n    \"\"\"\n    if not lst:\n        return []\n\n    sorted_items = sorted(lst)\n    lo, hi = 0, len(sorted_items) - 1\n    result = []\n    pick_low = True\n\n    while lo <= hi:\n        if pick_low:\n            result.append(sorted_items[lo])\n            lo += 1\n        else:\n            result.append(sorted_items[hi])\n            hi -= 1\n        pick_low = not pick_low\n        \n    return result"}
{"task_id": "HumanEval/70", "solution": "def strange_sort_list(lst):\n    \"\"\"\n    Given list of integers, return list in strange order.\n    Strange sorting, is when you start with the minimum value,\n    then maximum of the remaining integers, then minimum and so on.\n    \"\"\"\n    if not lst:\n        return []\n\n    sorted_items = sorted(lst)\n    result = []\n    left, right = 0, len(sorted_items) - 1\n    toggle_min = True\n\n    while left <= right:\n        if toggle_min:\n            result.append(sorted_items[left])\n            left += 1\n        else:\n            result.append(sorted_items[right])\n            right -= 1\n        toggle_min = not toggle_min\n        \n    return result"}
{"task_id": "HumanEval/71", "solution": "import math\n\ndef triangle_area(a, b, c):\n    \"\"\"\n    Given the lengths of the three sides of a triangle. Return the area of\n    the triangle rounded to 2 decimal points if the three sides form a valid triangle. \n    Otherwise return -1\n    \"\"\"\n    # 1. Validate triangle sides\n    if not (a > 0 and b > 0 and c > 0):\n        return -1\n\n    if not ((a + b > c) and (a + c > b) and (b + c > a)):\n        return -1\n\n    # 2. Calculate area using Heron's formula\n    s = (a + b + c) / 2.0\n    \n    # Calculate the term under the square root\n    term = s * (s - a) * (s - b) * (s - c)\n\n    # Handle floating point inaccuracies for values very close to zero but negative\n    if term < 0 and term > -1e-12:\n        term = 0.0\n    elif term < 0:\n        # Should ideally not happen if the triangle inequality holds,\n        # but as a safeguard or for extreme precision issues.\n        return -1\n\n    area = math.sqrt(term)\n\n    # 3. Round the result to 2 decimal points\n    return float(f\"{area:.2f}\")"}
{"task_id": "HumanEval/71", "solution": "import math\n\ndef triangle_area(a, b, c):\n    \"\"\"\n    Given the lengths of the three sides of a triangle. Return the area of\n    the triangle rounded to 2 decimal points if the three sides form a valid triangle. \n    Otherwise return -1\n    \"\"\"\n    # Check if sides are strictly positive and satisfy the triangle inequality\n    if not (a > 0 and b > 0 and c > 0 and\n            a + b > c and a + c > b and b + c > a):\n        return -1\n\n    # Calculate the semi-perimeter\n    s = (a + b + c) / 2\n\n    # Calculate the area using Heron's formula\n    # The term inside the sqrt should not be negative for a valid triangle,\n    # but due to floating point inaccuracies, it might be very slightly negative.\n    # We ensure it's non-negative before taking the square root.\n    radicand = s * (s - a) * (s - b) * (s - c)\n    if radicand < 0: # This case implies a degenerate or invalid triangle due to precision\n        return -1\n\n    area = math.sqrt(radicand)\n\n    # Round the area to 2 decimal points\n    return round(area, 2)"}
{"task_id": "HumanEval/72", "solution": "def will_it_fly(q,w):\n    \"\"\"\n    Checks if the object q will fly.\n    It flies if it's balanced (palindromic list) and its sum is <= w.\n    \"\"\"\n    # Check if the list q is balanced (palindromic)\n    is_balanced = (q == q[::-1])\n\n    # Calculate the sum of elements in q\n    total_weight = sum(q)\n\n    # Check if the total weight is within the limit w\n    is_under_weight_limit = (total_weight <= w)\n\n    # Return True if both conditions are met\n    return is_balanced and is_under_weight_limit"}
{"task_id": "HumanEval/73", "solution": "def smallest_change(arr):\n    \"\"\"\n    Calculates the minimum number of elements to change to make the array palindromic.\n    This is achieved by counting mismatched symmetric pairs.\n    \"\"\"\n    n = len(arr)\n    mismatches = 0\n    for i in range(n // 2):\n        if arr[i] != arr[n - 1 - i]:\n            mismatches += 1\n    return mismatches"}
{"task_id": "HumanEval/73", "solution": "def smallest_change(arr):\n    \"\"\"\n    Calculates the minimum changes to make an array palindromic.\n    Compares elements from the start with elements from the end, counting mismatches.\n    \"\"\"\n    n = len(arr)\n    changes = 0\n    for i in range(n // 2):\n        if arr[i] != arr[n - 1 - i]:\n            changes += 1\n    return changes"}
