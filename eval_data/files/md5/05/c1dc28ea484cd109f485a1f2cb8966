{"task_id": "HumanEval/93", "solution": "def encode(message):\n    \"\"\"\n    Encodes a message by swapping case of all letters and replacing vowels.\n    Vowels are replaced with the letter two places ahead in the alphabet, preserving case.\n    \"\"\"\n    vowels_lower = {'a', 'e', 'i', 'o', 'u'}\n    alphabet_lower = 'abcdefghijklmnopqrstuvwxyz'\n    encoded_chars = []\n\n    for char in message:\n        # Step 1: Swap case for the current character\n        swapped_char = char.swapcase()\n        \n        # Check if the swapped character is a letter\n        if swapped_char.isalpha():\n            lower_swapped_char = swapped_char.lower()\n            \n            # Step 2: If it's a vowel, replace it\n            if lower_swapped_char in vowels_lower:\n                idx = alphabet_lower.index(lower_swapped_char)\n                new_idx = (idx + 2) % 26\n                replacement_char_lower = alphabet_lower[new_idx]\n                \n                # Preserve the case of the original swapped vowel\n                if swapped_char.isupper():\n                    encoded_chars.append(replacement_char_lower.upper())\n                else:\n                    encoded_chars.append(replacement_char_lower)\n            else:\n                # If it's a non-vowel letter, keep the swapped case\n                encoded_chars.append(swapped_char)\n        else:\n            # If it's not a letter (e.g., space), keep it as is\n            encoded_chars.append(swapped_char)\n            \n    return ''.join(encoded_chars)"}
{"task_id": "HumanEval/94", "solution": "def skjkasdkd(lst):\n    \"\"\"Finds the largest prime number in the list and returns the sum of its digits.\n    Returns 0 if no prime numbers are found.\n    \"\"\"\n\n    def is_prime(n: int) -> bool:\n        \"\"\"Determines if a number is prime.\"\"\"\n        if n < 2:\n            return False\n        if n % 2 == 0:\n            return n == 2\n        if n % 3 == 0:\n            return n == 3\n        i = 5\n        while i * i <= n:\n            if n % i == 0 or n % (i + 2) == 0:\n                return False\n            i += 6\n        return True\n\n    def digit_sum(n: int) -> int:\n        \"\"\"Calculates the sum of the digits of a number.\"\"\"\n        s = 0\n        n = abs(n)\n        while n:\n            s += n % 10\n            n //= 10\n        return s\n\n    largest_prime = None\n\n    for num in lst:\n        if is_prime(num):\n            if largest_prime is None or num > largest_prime:\n                largest_prime = num\n\n    if largest_prime is None:\n        return 0\n    else:\n        return digit_sum(largest_prime)"}
{"task_id": "HumanEval/93", "solution": "def encode(message):\n    \"\"\"\n    Encodes a message by swapping case of all letters and advancing vowels by two places.\n    Non-letter characters are preserved.\n    \"\"\"\n    encoded_chars = []\n    VOWELS = \"aeiou\"\n\n    for char in message:\n        # Step 1: Swap the case of the character.\n        swapped_char = char.swapcase()\n\n        # Step 2: If the swapped character is an alphabet letter, check for vowel transformation.\n        if swapped_char.isalpha():\n            # If it's a vowel (case-insensitive) after case-swapping.\n            if swapped_char.lower() in VOWELS:\n                # Determine if the character was uppercase after swapping.\n                is_upper = swapped_char.isupper()\n                \n                # Get the 0-indexed position in the alphabet for the lowercase vowel.\n                alpha_pos = ord(swapped_char.lower()) - ord('a')\n                \n                # Advance the position by 2, wrapping around the alphabet (e.g., y -> a, z -> b).\n                new_alpha_pos = (alpha_pos + 2) % 26\n                \n                # Convert the new position back to a lowercase character.\n                new_char_lower = chr(ord('a') + new_alpha_pos)\n                \n                # Apply the original case (from after the swap) to the new character.\n                final_char = new_char_lower.upper() if is_upper else new_char_lower\n            else:\n                # If it's a consonant after swapping, keep it as is.\n                final_char = swapped_char\n        else:\n            # If it's not an alphabet character (e.g., space),\n            # swapcase() already returned it unchanged, so just use it.\n            final_char = swapped_char\n        \n        encoded_chars.append(final_char)\n    \n    return \"\".join(encoded_chars)"}
{"task_id": "HumanEval/94", "solution": "def skjkasdkd(lst):\n    \"\"\"Finds the largest prime in a list and returns the sum of its digits.\n    Returns 0 if no prime numbers are found in the list.\n    \"\"\"\n\n    def is_prime(n):\n        \"\"\"Checks if a number is prime using trial division with 6k +/- 1 optimization.\"\"\"\n        if n < 2:\n            return False\n        if n == 2 or n == 3:\n            return True\n        if n % 2 == 0 or n % 3 == 0:\n            return False\n        i = 5\n        while i * i <= n:\n            if n % i == 0 or n % (i + 2) == 0:\n                return False\n            i += 6\n        return True\n\n    def sum_digits(n):\n        \"\"\"Calculates the sum of digits of a non-negative integer.\"\"\"\n        digit_sum = 0\n        while n > 0:\n            digit_sum += n % 10\n            n //= 10\n        return digit_sum\n\n    largest_prime = None\n\n    for num in lst:\n        if is_prime(num):\n            if largest_prime is None or num > largest_prime:\n                largest_prime = num\n\n    if largest_prime is None:\n        return 0\n    else:\n        return sum_digits(largest_prime)"}
{"task_id": "HumanEval/95", "solution": "def check_dict_case(dict):\n    \"\"\"\n    Checks if all keys in the dictionary are either all lowercase strings or all uppercase strings.\n    Returns False if the dictionary is empty or contains non-string keys.\n    \"\"\"\n    if not dict:\n        return False\n\n    all_lower_case = True\n    all_upper_case = True\n\n    for key in dict.keys():\n        # All keys must be strings. If any key is not a string, return False immediately.\n        if not isinstance(key, str):\n            return False\n\n        # Check if the current key violates the 'all lower case' condition.\n        if key != key.lower():\n            all_lower_case = False\n\n        # Check if the current key violates the 'all upper case' condition.\n        if key != key.upper():\n            all_upper_case = False\n\n        # If it's impossible for keys to be uniformly lower or upper, we can stop early.\n        if not all_lower_case and not all_upper_case:\n            return False\n\n    # Return True if all keys are uniformly lower case OR uniformly upper case.\n    return all_lower_case or all_upper_case"}
{"task_id": "HumanEval/95", "solution": "def check_dict_case(dict):\n    \"\"\"\n    Given a dictionary, return True if all keys are strings in lower \n    case or all keys are strings in upper case, else return False.\n    The function should return False is the given dictionary is empty.\n    \"\"\"\n    if not dict:\n        return False\n\n    keys = list(dict.keys())\n\n    # First, check if all keys are strings. If not, it's an invalid case.\n    if not all(isinstance(k, str) for k in keys):\n        return False\n\n    # Check if all string keys are entirely lowercase.\n    if all(k.islower() for k in keys):\n        return True\n\n    # Check if all string keys are entirely uppercase.\n    if all(k.isupper() for k in keys):\n        return True\n\n    # If neither condition is met, the keys are mixed case or a mix of alphabetic and non-alphabetic strings.\n    return False"}
{"task_id": "HumanEval/96", "solution": "import math\n\ndef count_up_to(n):\n    \"\"\"Returns an array of prime numbers strictly less than n using the Sieve of Eratosthenes.\n    Handles non-negative integers as input.\n    \"\"\"\n    if n <= 2:\n        return []\n\n    # Initialize a bytearray where sieve[i] is 1 if i is potentially prime, else 0.\n    sieve = bytearray(b'\\x01') * n\n    sieve[0:2] = b'\\x00\\x00'  # 0 and 1 are not prime\n\n    # Iterate from 2 up to the square root of n-1.\n    # Any composite number x < n must have a prime factor <= sqrt(x).\n    for p in range(2, int(math.isqrt(n - 1)) + 1):\n        if sieve[p]:  # If p is marked as prime\n            # Mark all multiples of p (starting from p*p) as not prime.\n            # These multiples have p as a factor and are thus not prime.\n            start_multiple = p * p\n            # Calculate the number of elements to set to 0 in the slice.\n            # This is equivalent to `for multiple in range(p * p, n, p): sieve[multiple] = 0`\n            count = (n - 1 - start_multiple) // p + 1\n            sieve[start_multiple:n:p] = b'\\x00' * count\n\n    # Collect all numbers that are marked as prime.\n    primes = [i for i in range(n) if sieve[i]]\n\n    return primes"}
{"task_id": "HumanEval/96", "solution": "def count_up_to(n):\n    \"\"\"Returns a list of prime numbers strictly less than n, using the Sieve of Eratosthenes.\"\"\"\n    if n <= 2:\n        return []\n\n    # Initialize a boolean array (sieve) where sieve[i] is true if i is potentially prime.\n    # bytearray is used for memory efficiency, with 0 for False and 1 for True.\n    sieve = bytearray(b\"\\x01\") * n\n    sieve[0:2] = b\"\\x00\\x00\"  # 0 and 1 are not prime\n\n    # Iterate from 2 up to the square root of n.\n    for p in range(2, int(n**0.5) + 1):\n        if sieve[p]:\n            # If p is prime, mark all its multiples as not prime, starting from p*p.\n            # The slice assignment with step is an efficient way to do this.\n            step = p\n            start = p * p\n            sieve[start:n:step] = b\"\\x00\" * ((n - 1 - start) // step + 1)\n\n    # Collect all numbers that are marked as prime.\n    return [i for i, is_prime in enumerate(sieve) if is_prime]"}
