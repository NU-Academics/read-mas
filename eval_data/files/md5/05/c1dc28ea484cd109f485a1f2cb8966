{"task_id": "HumanEval/140", "solution": "def fix_spaces(text):\n    \"\"\"\n    Given a string text, replace all spaces in it with underscores, \n    and if a string has more than 2 consecutive spaces, \n    then replace all consecutive spaces with - \n    \"\"\"\n    result = []\n    space_count = 0\n    for char in text:\n        if char == ' ':\n            space_count += 1\n        else:\n            if space_count > 0:\n                # Apply rules for the consecutive spaces just encountered\n                if space_count >= 3:\n                    result.append('-')\n                else:  # space_count is 1 or 2\n                    result.append('_' * space_count)\n            result.append(char)\n            space_count = 0\n    \n    # Handle any trailing spaces at the end of the string\n    if space_count > 0:\n        if space_count >= 3:\n            result.append('-')\n        else:\n            result.append('_' * space_count)\n            \n    return \"\".join(result)"}
{"task_id": "HumanEval/139", "solution": "def special_factorial(n):\n    \"\"\"\n    Computes the Brazilian factorial for a given positive integer n.\n    This involves calculating the product of factorials from 1! up to n!.\n    \"\"\"\n    def _get_factorials_up_to_n(limit):\n        \"\"\"Helper to pre-compute factorials from 1! to limit!.\"\"\"\n        factorials = {}\n        current_factorial = 1\n        for i in range(1, limit + 1):\n            current_factorial *= i\n            factorials[i] = current_factorial\n        return factorials\n\n    all_factorials = _get_factorials_up_to_n(n)\n\n    product_of_factorials = 1\n    for k in range(1, n + 1):\n        product_of_factorials *= all_factorials[k]\n\n    return product_of_factorials"}
{"task_id": "HumanEval/139", "solution": "def special_factorial(n):\n    \"\"\"Calculates the Brazilian factorial, defined as n! * (n-1)! * ... * 1!\"\"\"\n    \n    # Memoization dictionary to store computed factorials for efficiency.\n    memo = {0: 1, 1: 1}\n\n    def factorial(k: int) -> int:\n        \"\"\"Computes k! using memoization for previously calculated values.\"\"\"\n        if k in memo:\n            return memo[k]\n\n        last_computed = max(memo.keys())\n        current_factorial = memo[last_computed]\n        for i in range(last_computed + 1, k + 1):\n            current_factorial *= i\n            memo[i] = current_factorial\n        return memo[k]\n\n    total_product = 1\n    # Iterate from 1 to n to calculate and multiply each factorial.\n    for i in range(1, n + 1):\n        f_i = factorial(i)\n        total_product *= f_i\n        \n    return total_product"}
{"task_id": "HumanEval/140", "solution": "import re\n\ndef fix_spaces(text):\n    \"\"\"\n    Given a string text, replace all spaces in it with underscores, \n    and if a string has more than 2 consecutive spaces, \n    then replace all consecutive spaces with - \n    \"\"\"\n    \n    pattern = re.compile(r\"( +)\")\n\n    def replacer(match):\n        run = match.group(1)\n        if len(run) >= 3:\n            return \"-\"\n        return \"_\" * len(run)\n\n    return pattern.sub(replacer, text)"}
{"task_id": "HumanEval/141", "solution": "def file_name_check(file_name):\n    \"\"\"Checks if a file's name is valid based on a set of conditions.\"\"\"\n    # Condition 1: The file's name contains exactly one dot '.'\n    if file_name.count('.') != 1:\n        return 'No'\n\n    parts = file_name.split('.')\n    prefix = parts[0]\n    extension = parts[1]\n\n    # Condition 2: The substring before the dot should not be empty,\n    # and it starts with a letter from the latin alphapet ('a'-'z' and 'A'-'Z').\n    if not prefix or not prefix[0].isalpha():\n        return 'No'\n\n    # Condition 3: The substring after the dot should be one of these: ['txt', 'exe', 'dll']\n    if extension not in ['txt', 'exe', 'dll']:\n        return 'No'\n\n    # Condition 4: There should not be more than three digits ('0'-'9') in the file's name.\n    digit_count = sum(1 for char in file_name if char.isdigit())\n    if digit_count > 3:\n        return 'No'\n\n    return 'Yes'"}
{"task_id": "HumanEval/141", "solution": "def file_name_check(file_name):\n    \"\"\"Checks if a file's name is valid based on several conditions.\"\"\"\n\n    # Condition 2: The file's name contains exactly one dot '.'\n    if file_name.count('.') != 1:\n        return 'No'\n\n    parts = file_name.split('.')\n    prefix = parts[0]\n    suffix = parts[1]\n\n    # Condition 3: The substring before the dot should not be empty\n    if not prefix:\n        return 'No'\n\n    # Condition 3: and it starts with a letter from the latin alphapet ('a'-'z' and 'A'-'Z').\n    # This also covers the case where prefix is empty, as prefix[0] would raise an error.\n    # However, 'if not prefix' handles that already.\n    first_char_prefix = prefix[0]\n    if not ('a' <= first_char_prefix <= 'z' or 'A' <= first_char_prefix <= 'Z'):\n        return 'No'\n\n    # Condition 4: The substring after the dot should be one of these: ['txt', 'exe', 'dll']\n    allowed_extensions = ['txt', 'exe', 'dll']\n    if suffix not in allowed_extensions:\n        return 'No'\n\n    # Condition 1: There should not be more than three digits ('0'-'9') in the file's name.\n    digit_count = 0\n    for char in file_name:\n        if '0' <= char <= '9':\n            digit_count += 1\n    if digit_count > 3:\n        return 'No'\n\n    # If all conditions are met\n    return 'Yes'"}
{"task_id": "HumanEval/142", "solution": "def sum_squares(lst):\n    \"\"\"\n    Transforms list entries based on index and returns their sum.\n    Indexes that are multiples of 3 are squared; indexes that are multiples of 4 (but not 3) are cubed.\n    \"\"\"\n    total_sum = 0\n    for i, entry in enumerate(lst):\n        if i % 3 == 0:\n            total_sum += entry * entry\n        elif i % 4 == 0:  # Implies i % 3 != 0 due to the `if` condition above\n            total_sum += entry * entry * entry\n        else:\n            total_sum += entry\n    return total_sum"}
{"task_id": "HumanEval/143", "solution": "def words_in_sentence(sentence):\n    \"\"\"\n    Returns a string containing words from the original sentence whose lengths are prime numbers.\n    The order of words is preserved.\n    \"\"\"\n\n    def is_prime(n: int) -> bool:\n        \"\"\"\n        Checks if a number is prime.\n        Assumes n is a non-negative integer.\n        \"\"\"\n        if n <= 1:\n            return False\n        if n <= 3:\n            return True\n        if n % 2 == 0:\n            return False\n        i = 3\n        while i * i <= n:\n            if n % i == 0:\n                return False\n            i += 2\n        return True\n\n    words = sentence.split()\n    prime_length_words = [word for word in words if is_prime(len(word))]\n    return \" \".join(prime_length_words)"}
{"task_id": "HumanEval/142", "solution": "def sum_squares(lst):\n    \"\"\"\n    Squares integers at indices that are multiples of 3, cubes integers at indices that are\n    multiples of 4 but not 3, and sums all transformed entries.\n    \"\"\"\n    total = 0\n    for i, v in enumerate(lst):\n        if i % 3 == 0:\n            total += v ** 2\n        elif i % 4 == 0:\n            total += v ** 3\n        else:\n            total += v\n    return total"}
{"task_id": "HumanEval/143", "solution": "def words_in_sentence(sentence):\n    \"\"\"\n    Filters words from a sentence, returning only those whose lengths are prime numbers.\n    The order of the words is preserved.\n    \"\"\"\n\n    def _is_prime(n: int) -> bool:\n        \"\"\"Checks if a given integer n is a prime number.\"\"\"\n        if n <= 1:\n            return False\n        if n == 2:\n            return True\n        if n % 2 == 0:\n            return False\n        i = 3\n        while i * i <= n:\n            if n % i == 0:\n                return False\n            i += 2\n        return True\n\n    words = sentence.split()\n    filtered_words = [word for word in words if _is_prime(len(word))]\n\n    return \" \".join(filtered_words)"}
{"task_id": "HumanEval/144", "solution": "import re\n\nclass GCDUtil:\n    \"\"\"Utility for greatest common divisor and fraction reduction.\"\"\"\n    @staticmethod\n    def gcd(a: int, b: int) -> int:\n        \"\"\"Computes the greatest common divisor of two integers using Euclidean algorithm.\"\"\"\n        while b:\n            a, b = b, a % b\n        return abs(a)\n\n    @staticmethod\n    def reduce_fraction(num: int, den: int) -> tuple[int, int]:\n        \"\"\"Reduces a fraction (num, den) to its simplest form.\"\"\"\n        common_divisor = GCDUtil.gcd(abs(num), abs(den))\n        return num // common_divisor, den // common_divisor\n\nclass Fraction:\n    \"\"\"Represents an immutable rational number.\"\"\"\n    def __init__(self, numerator: int, denominator: int) -> None:\n        self.numerator = numerator\n        self.denominator = denominator\n\n    def multiply(self, other: \"Fraction\") -> \"Fraction\":\n        \"\"\"Multiplies this fraction by another fraction and returns a new Fraction.\"\"\"\n        new_numerator = self.numerator * other.numerator\n        new_denominator = self.denominator * other.denominator\n        return Fraction(new_numerator, new_denominator)\n\nclass FractionParser:\n    \"\"\"Parses a string representation of a fraction into a Fraction object.\"\"\"\n    def parse(self, s: str) -> Fraction:\n        \"\"\"Converts a string 'num/den' to a Fraction object.\"\"\"\n        num_str, den_str = s.split('/')\n        num = int(num_str)\n        den = int(den_str)\n        return Fraction(num, den)\n\nclass SimplifierService:\n    \"\"\"Orchestrates fraction operations to determine if a product is a whole number.\"\"\"\n    def __init__(self, parser: FractionParser, gcd_util: GCDUtil) -> None:\n        self.parser = parser\n        self.gcd_util = gcd_util\n\n    def simplify(self, x: str, n: str) -> bool:\n        \"\"\"Parses, multiplies, reduces, and checks if the product of two fractions is a whole number.\"\"\"\n        f1 = self.parser.parse(x)\n        f2 = self.parser.parse(n)\n        \n        product = f1.multiply(f2)\n        \n        reduced_num, reduced_den = self.gcd_util.reduce_fraction(product.numerator, product.denominator)\n        \n        return reduced_num % reduced_den == 0\n\ndef simplify(x, n):\n    \"\"\"\n    Your task is to implement a function that will simplify the expression\n    x * n. The function returns True if x * n evaluates to a whole number and False\n    otherwise. Both x and n, are string representation of a fraction, and have the following format,\n    <numerator>/<denominator> where both numerator and denominator are positive whole numbers.\n\n    You can assume that x, and n are valid fractions, and do not have zero as denominator.\n\n    simplify(\"1/5\", \"5/1\") = True\n    simplify(\"1/6\", \"2/1\") = False\n    simplify(\"7/10\", \"10/2\") = False\n    \"\"\"\n    parser = FractionParser()\n    gcd_util = GCDUtil()\n    service = SimplifierService(parser, gcd_util)\n    return service.simplify(x, n)"}
{"task_id": "HumanEval/144", "solution": "import math\n\n\ndef simplify(x, n):\n    \"\"\"\n    Checks if the product of two fractions x and n evaluates to a whole number.\n    Fractions are given as strings \"numerator/denominator\".\n    \"\"\"\n\n    class FractionParseError(Exception):\n        \"\"\"Custom exception for fraction parsing and validation errors.\"\"\"\n        pass\n\n    def compute_gcd(a: int, b: int) -> int:\n        \"\"\"Computes the greatest common divisor of two positive integers.\"\"\"\n        return math.gcd(a, b)\n\n    class Fraction:\n        def __init__(self, numerator: int, denominator: int) -> None:\n            if denominator == 0 or numerator <= 0 or denominator <= 0:\n                raise FractionParseError(\"Numerator and denominator must be positive and denominator non-zero\")\n            self._numerator = numerator\n            self._denominator = denominator\n            gcd = compute_gcd(self._numerator, self._denominator)\n            self._numerator //= gcd\n            self._denominator //= gcd\n\n        @property\n        def numerator(self) -> int:\n            return self._numerator\n\n        @property\n        def denominator(self) -> int:\n            return self._denominator\n\n        def multiply(self, other: \"Fraction\") -> \"Fraction\":\n            return Fraction(self._numerator * other._numerator, self._denominator * other._denominator)\n\n        def is_whole(self) -> bool:\n            return self._numerator % self._denominator == 0\n\n    class FractionParser:\n        def parse(self, text: str) -> Fraction:\n            try:\n                a, b = text.split(\"/\")\n            except ValueError:\n                raise FractionParseError(f\"Invalid fraction format: {text!r}\")\n            try:\n                an = int(a)\n                bn = int(b)\n            except ValueError:\n                raise FractionParseError(f\"Non-integer numerator/denominator: {text!r}\")\n            return Fraction(an, bn)\n\n    class SimplifyService:\n        def __init__(self, parser: \"FractionParser\") -> None:\n            self._parser = parser\n\n        def simplify(self, x_str: str, n_str: str) -> bool:\n            fx = self._parser.parse(x_str)\n            fn = self._parser.parse(n_str)\n            product = fx.multiply(fn)\n            return product.is_whole()\n\n    # Instantiate the service and perform the simplification\n    svc = SimplifyService(FractionParser())\n    return svc.simplify(x, n)"}
{"task_id": "HumanEval/145", "solution": "def order_by_points(nums):\n    \"\"\"\n    Sorts a list of integers based on the sum of their digits,\n    maintaining original order for ties by original index.\n    \"\"\"\n\n    def _digit_sum(n: int) -> int:\n        \"\"\"Calculates the sum of digits for an integer using its absolute value.\"\"\"\n        n_abs = abs(n)\n        return sum(int(ch) for ch in str(n_abs))\n\n    class _NumberItem:\n        \"\"\"Internal helper class to hold an integer's value, original index, and digit sum.\"\"\"\n        def __init__(self, value: int, original_index: int) -> None:\n            self.value: int = value\n            self.original_index: int = original_index\n            self.points: int = _digit_sum(value)\n\n    items = []\n    for i, num in enumerate(nums):\n        items.append(_NumberItem(num, i))\n\n    items.sort(key=lambda item: (item.points, item.original_index))\n\n    return [item.value for item in items]"}
{"task_id": "HumanEval/145", "solution": "def order_by_points(nums):\n    \"\"\"\n    Sorts a list of integers by the sum of their digits,\n    then by their original index for ties.\n    \"\"\"\n\n    class DigitSumCalculator:\n        def compute(self, n: int) -> int:\n            x = abs(n)\n            total = 0\n            while x:\n                total += x % 10\n                x //= 10\n            return total\n\n    class NumberItem:\n        def __init__(self, value: int, index: int) -> None:\n            self.value = value\n            self.index = index\n\n    class OrderService:\n        def __init__(self, calculator: DigitSumCalculator) -> None:\n            self._calculator = calculator\n\n        def sort_numbers(self, nums: list[int]) -> list[int]:\n            items = [NumberItem(value=n, index=i) for i, n in enumerate(nums)]\n            scored = [(self._calculator.compute(it.value), it.index, it) for it in items]\n            scored_sorted = sorted(scored, key=lambda t: (t[0], t[1]))\n            return [t[2].value for t in scored_sorted]\n\n    calculator = DigitSumCalculator()\n    service = OrderService(calculator)\n    return service.sort_numbers(nums)"}
{"task_id": "HumanEval/146", "solution": "def specialFilter(nums):\n    \"\"\"Counts numbers in an array that are greater than 10 and have both first and last digits odd.\"\"\"\n    count = 0\n    ODD_DIGITS = {1, 3, 5, 7, 9}\n\n    for num in nums:\n        # Check if the number is greater than 10\n        if num > 10:\n            # Get the absolute integer value for digit extraction\n            # This handles both integers and whole-number floats (e.g., 15.0 -> 15)\n            n_abs = abs(int(num))\n\n            # Extract the last digit\n            last_digit = n_abs % 10\n\n            # Extract the first digit by converting to string\n            s_num = str(n_abs)\n            first_digit = int(s_num[0])\n\n            # Check if both first and last digits are odd\n            if first_digit in ODD_DIGITS and last_digit in ODD_DIGITS:\n                count += 1\n    return count"}
{"task_id": "HumanEval/146", "solution": "def specialFilter(nums):\n    \"\"\"\n    Counts elements greater than 10 where both first and last digits are odd.\n    \"\"\"\n    ODD_DIGITS = {1, 3, 5, 7, 9}\n    MIN_THRESHOLD = 10\n    count = 0\n\n    def _normalize_number(value):\n        \"\"\"Converts a numeric value to its absolute integer part.\"\"\"\n        return int(abs(int(float(value))))\n\n    def _get_first_last_digits(n):\n        \"\"\"Extracts the first and last digits of a non-negative integer.\"\"\"\n        s = str(n)\n        return (int(s[0]), int(s[-1]))\n\n    def _is_odd_digit(d):\n        \"\"\"Checks if a given digit is odd.\"\"\"\n        return d in ODD_DIGITS\n\n    for num in nums:\n        normalized_num = _normalize_number(num)\n\n        if normalized_num > MIN_THRESHOLD:\n            first_digit, last_digit = _get_first_last_digits(normalized_num)\n            if _is_odd_digit(first_digit) and _is_odd_digit(last_digit):\n                count += 1\n    return count"}
{"task_id": "HumanEval/147", "solution": "import math\n\ndef _comb(n: int, k: int) -> int:\n    \"\"\"Calculates nCk, returning 0 if n < k or k < 0.\"\"\"\n    if k < 0 or k > n:\n        return 0\n    return math.comb(n, k)\n\ndef get_max_triples(n):\n    \"\"\"\n    Calculates the number of triples (a[i], a[j], a[k]) of a where i < j < k,\n    and a[i] + a[j] + a[k] is a multiple of 3.\n    \"\"\"\n    # The sequence a[i] = i*i - i + 1, for i starting at 1.\n    # Analyzing a[i] modulo 3:\n    # a[i] % 3 is 0 if i % 3 == 2\n    # a[i] % 3 is 1 if i % 3 == 1 or i % 3 == 0\n    # a[i] % 3 is never 2.\n\n    # Count elements whose value modulo 3 is 0, 1, or 2.\n    # cnt0: count of a[i] % 3 == 0\n    # cnt1: count of a[i] % 3 == 1\n    # cnt2: count of a[i] % 3 == 2 (always 0 for this sequence)\n    cnt0 = (n + 1) // 3\n    cnt1 = n - cnt0\n    cnt2 = 0 # Based on the pattern a[i] mod 3 is never 2\n\n    # A sum (a[i] + a[j] + a[k]) is a multiple of 3 if the sum of their residues mod 3 is 0, 3, 6, ...\n    # Possible residue combinations (r_i, r_j, r_k) that sum to a multiple of 3:\n    # 1. (0, 0, 0): all three elements are 0 mod 3. Number of ways: _comb(cnt0, 3)\n    # 2. (1, 1, 1): all three elements are 1 mod 3. Number of ways: _comb(cnt1, 3)\n    # 3. (2, 2, 2): all three elements are 2 mod 3. Number of ways: _comb(cnt2, 3)\n    # 4. (0, 1, 2): one of each residue. Number of ways: cnt0 * cnt1 * cnt2\n\n    # Since cnt2 is always 0, cases 3 and 4 contribute 0 to the total count.\n    # Therefore, the total number of valid triples is the sum of combinations from cases 1 and 2.\n    return _comb(cnt0, 3) + _comb(cnt1, 3)"}
{"task_id": "HumanEval/148", "solution": "def bf(planet1, planet2):\n    '''\n    There are eight planets in our solar system: the closerst to the Sun \n    is Mercury, the next one is Venus, then Earth, Mars, Jupiter, Saturn, \n    Uranus, Neptune.\n    Write a function that takes two planet names as strings planet1 and planet2. \n    The function should return a tuple containing all planets whose orbits are \n    located between the orbit of planet1 and the orbit of planet2, sorted by \n    the proximity to the sun. \n    The function should return an empty tuple if planet1 or planet2\n    are not correct planet names. \n    Examples\n    bf(\"Jupiter\", \"Neptune\") ==> (\"Saturn\", \"Uranus\")\n    bf(\"Earth\", \"Mercury\") ==> (\"Venus\")\n    bf(\"Mercury\", \"Uranus\") ==> (\"Venus\", \"Earth\", \"Mars\", \"Jupiter\", \"Saturn\")\n    '''\n    PLANETS_ORDERED = [\"Mercury\", \"Venus\", \"Earth\", \"Mars\", \"Jupiter\", \"Saturn\", \"Uranus\", \"Neptune\"]\n    \n    # Create a mapping for case-insensitive lookup to canonical names.\n    planet_map = {p.lower(): p for p in PLANETS_ORDERED}\n\n    # Helper to get the canonical name from a given input string.\n    def get_canonical_name(name_str):\n        return planet_map.get(name_str.strip().lower())\n\n    p1_canonical = get_canonical_name(planet1)\n    p2_canonical = get_canonical_name(planet2)\n\n    # Return an empty tuple if either planet name is invalid.\n    if p1_canonical is None or p2_canonical is None:\n        return ()\n\n    # Get the indices of the canonical planets in the ordered list.\n    idx1 = PLANETS_ORDERED.index(p1_canonical)\n    idx2 = PLANETS_ORDERED.index(p2_canonical)\n\n    # Determine the start and end indices for slicing, ensuring they are sorted.\n    start_idx = min(idx1, idx2)\n    end_idx = max(idx1, idx2)\n\n    # If the planets are the same or adjacent, there are no planets strictly between them.\n    if end_idx - start_idx <= 1:\n        return ()\n\n    # Slice the list to get planets strictly between the two given planets.\n    # The slice is exclusive of start_idx and end_idx.\n    result_planets = PLANETS_ORDERED[start_idx + 1 : end_idx]\n\n    return tuple(result_planets)"}
{"task_id": "HumanEval/147", "solution": "def get_max_triples(n):\n    \"\"\"\n    Counts the number of triples (a[i], a[j], a[k]) from an array a (where a[x] = x*x - x + 1)\n    such that i < j < k and a[i] + a[j] + a[k] is a multiple of 3.\n    \"\"\"\n    if n < 3:\n        return 0\n\n    def choose3(count: int) -> int:\n        \"\"\"Calculates 'count choose 3' combinations, returning 0 if count is less than 3.\"\"\"\n        if count < 3:\n            return 0\n        return count * (count - 1) * (count - 2) // 6\n\n    # Analyze a[i] % 3 based on i % 3:\n    # a[i] = i*i - i + 1\n    # If i % 3 == 0: a[i] % 3 = (0*0 - 0 + 1) % 3 = 1\n    # If i % 3 == 1: a[i] % 3 = (1*1 - 1 + 1) % 3 = 1\n    # If i % 3 == 2: a[i] % 3 = (2*2 - 2 + 1) % 3 = (4 - 2 + 1) % 3 = 3 % 3 = 0\n\n    # We need a[i] + a[j] + a[k] to be a multiple of 3.\n    # This happens only if:\n    # 1. All three a values are 0 mod 3 (0+0+0 = 0)\n    # 2. All three a values are 1 mod 3 (1+1+1 = 3 = 0)\n    # Any other combination (e.g., 0+0+1, 0+1+1) will not sum to 0 mod 3.\n\n    # Count indices 1 to n based on their residue modulo 3.\n    # Let cnt_i_mod_x be the count of indices i such that i % 3 == x.\n    base = n // 3\n    rem = n % 3\n\n    cnt_i_mod_1 = base + (1 if rem >= 1 else 0)  # Indices: 1, 4, 7...\n    cnt_i_mod_2 = base + (1 if rem >= 2 else 0)  # Indices: 2, 5, 8...\n    cnt_i_mod_0 = base                           # Indices: 3, 6, 9...\n\n    # Now map these index counts to the counts of a[i] values based on their modulo 3.\n    # cnt_a_mod_0: number of a[x] that are 0 mod 3. This happens when x % 3 == 2.\n    cnt_a_mod_0 = cnt_i_mod_2\n\n    # cnt_a_mod_1: number of a[x] that are 1 mod 3. This happens when x % 3 == 0 or x % 3 == 1.\n    cnt_a_mod_1 = cnt_i_mod_0 + cnt_i_mod_1\n\n    # Total valid triples = (combinations of 3 from cnt_a_mod_0) + (combinations of 3 from cnt_a_mod_1)\n    return choose3(cnt_a_mod_0) + choose3(cnt_a_mod_1)"}
{"task_id": "HumanEval/148", "solution": "from typing import List, Optional, Tuple, Iterable, Set\nimport json\nfrom pathlib import Path\n\nclass InvalidPlanetNameError(ValueError):\n    \"\"\"Exception raised for invalid planet names.\"\"\"\n    pass\n\nclass AppConfig:\n    \"\"\"Central configuration for data paths and default values.\"\"\"\n    # Path is relative to the current file's directory\n    DATA_FILE_PATH: Path = Path(__file__).parent / \"data\" / \"planets.json\"\n    DEFAULT_PLANET_LIST: List[str] = [\n        \"Mercury\", \"Venus\", \"Earth\", \"Mars\", \"Jupiter\", \"Saturn\", \"Uranus\", \"Neptune\"\n    ]\n\nclass PlanetModel:\n    \"\"\"Represents a planet with its canonical name and orbital index.\"\"\"\n    def __init__(self, name: str, index: int) -> None:\n        self._name = name\n        self._index = index\n\n    @property\n    def name(self) -> str:\n        return self._name\n\n    @property\n    def index(self) -> int:\n        return self._index\n\nclass PlanetRepository:\n    \"\"\"Provides access to an ordered list of planets.\"\"\"\n    def __init__(self, data_file_path: Optional[Path] = None) -> None:\n        self._data_file_path = data_file_path or AppConfig.DATA_FILE_PATH\n        self._planets: List[PlanetModel] = []\n        self._index: dict = {} # For O(1) lookup\n        self.load()\n\n    def load(self) -> None:\n        \"\"\"Loads planet data from JSON or uses a default list.\"\"\"\n        raw_planet_names: List[str]\n        try:\n            if self._data_file_path.exists():\n                raw_planet_names = json.loads(self._data_file_path.read_text(encoding='utf-8'))\n            else:\n                raw_planet_names = AppConfig.DEFAULT_PLANET_LIST\n        except Exception: # Catch any IO/JSON parsing errors\n            raw_planet_names = AppConfig.DEFAULT_PLANET_LIST\n        \n        self._planets = [PlanetModel(name, i) for i, name in enumerate(raw_planet_names)]\n        self._index = {p.name.lower(): p for p in self._planets}\n\n    def get_ordered_planets(self) -> List[PlanetModel]:\n        \"\"\"Returns a shallow copy of the ordered list of planet models.\"\"\"\n        return list(self._planets)\n\n    def find_by_name(self, name: str) -> Optional[PlanetModel]:\n        \"\"\"Finds a planet model by its case-insensitive name.\"\"\"\n        return self._index.get(name.lower())\n\nclass NameValidator:\n    \"\"\"Validates and normalizes planet names.\"\"\"\n    def __init__(self, valid_names: Iterable[str]) -> None:\n        self._valid_names: Set[str] = {name.lower() for name in valid_names}\n\n    def normalize(self, name: str) -> str:\n        \"\"\"Normalizes a planet name to capitalized format.\"\"\"\n        return name.strip().capitalize()\n\n    def is_valid(self, name: str) -> bool:\n        \"\"\"Checks if a given name is a valid planet name (case-insensitive).\"\"\"\n        return name.strip().lower() in self._valid_names\n\nclass PlanetService:\n    \"\"\"Business logic for finding planets between two given planets.\"\"\"\n    def __init__(self, repo: PlanetRepository, validator: NameValidator) -> None:\n        self._repo = repo\n        self._validator = validator\n\n    def get_between(self, planet1: str, planet2: str) -> List[str]:\n        \"\"\"\n        Returns a list of planet names strictly between planet1 and planet2,\n        sorted by proximity to the sun. Raises InvalidPlanetNameError for invalid inputs.\n        \"\"\"\n        if not self._validator.is_valid(planet1) or not self._validator.is_valid(planet2):\n            raise InvalidPlanetNameError(\"One or both planet names are invalid.\")\n        \n        # Normalize for internal lookup as per design, even if validation is case-insensitive\n        p1_norm = self._validator.normalize(planet1)\n        p2_norm = self._validator.normalize(planet2)\n\n        p1_model = self._repo.find_by_name(p1_norm)\n        p2_model = self._repo.find_by_name(p2_norm)\n\n        # This check is mostly for type hinting; is_valid should prevent None\n        if p1_model is None or p2_model is None:\n            raise InvalidPlanetNameError(\"One or both planet names not found after normalization.\")\n\n        low_index, high_index = sorted([p1_model.index, p2_model.index])\n\n        # If planets are adjacent or the same, there are no planets strictly between them\n        if high_index - low_index <= 1:\n            return []\n\n        # Slice the ordered list of all planets\n        between_planets = self._repo.get_ordered_planets()[low_index + 1:high_index]\n        return [pm.name for pm in between_planets]\n\ndef bf(planet1, planet2):\n    \"\"\"\n    Returns a tuple of planet names whose orbits are located between the orbit of planet1\n    and planet2, sorted by proximity to the sun. Returns an empty tuple if planet1 or planet2\n    are not correct planet names.\n    \"\"\"\n    # Initialize components\n    repo = PlanetRepository()\n    # Provide normalized canonical names for validator\n    validator = NameValidator([p.name for p in repo.get_ordered_planets()])\n    service = PlanetService(repo, validator)\n\n    try:\n        result = service.get_between(planet1, planet2)\n        return tuple(result)\n    except InvalidPlanetNameError:\n        return tuple()\n\n```"}
{"task_id": "HumanEval/149", "solution": "def sorted_list_sum(lst):\n    \"\"\"Deletes strings with odd lengths from the list and returns the remaining\n    list sorted by length (ascending) then alphabetically (ascending).\n    \"\"\"\n    \n    # Filter out strings that have odd lengths\n    filtered_list = [s for s in lst if len(s) % 2 == 0]\n\n    # Sort the filtered list by length, then alphabetically\n    # The key function returns a tuple (length, string),\n    # which Python's sorted function uses for stable multi-criteria sorting.\n    sorted_result = sorted(filtered_list, key=lambda s: (len(s), s))\n\n    return sorted_result"}
