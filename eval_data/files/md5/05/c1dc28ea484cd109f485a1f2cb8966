{"task_id": "HumanEval/74", "solution": "def total_match(lst1, lst2):\n    '''\n    Returns the list with fewer total characters; returns the first list if totals are equal.\n    '''\n    def _calculate_total_chars(lst):\n        \"\"\"Calculates the sum of lengths of all strings in a list.\"\"\"\n        total = 0\n        for s in lst:\n            total += len(s)\n        return total\n\n    total_chars_lst1 = _calculate_total_chars(lst1)\n    total_chars_lst2 = _calculate_total_chars(lst2)\n\n    if total_chars_lst1 <= total_chars_lst2:\n        return lst1\n    else:\n        return lst2"}
{"task_id": "HumanEval/75", "solution": "def is_multiply_prime(a):\n    \"\"\"\n    Checks if the given number is the multiplication of 3 prime numbers.\n    Assumes 'a' is an integer between 1 and 99.\n    \"\"\"\n\n    def is_prime(n):\n        \"\"\"Helper to check if a number is prime for n < 100.\"\"\"\n        if n < 2:\n            return False\n        for i in range(2, int(n**0.5) + 1):\n            if n % i == 0:\n                return False\n        return True\n\n    if a < 1:\n        return False\n\n    primes = [p for p in range(2, 100) if is_prime(p)]\n\n    # Iterate through all combinations of three primes p, q, r such that p * q * r == a.\n    # We enforce p <= q <= r to avoid duplicate permutations and ensure factors are ordered.\n    for i in range(len(primes)):\n        p = primes[i]\n        if p * p * p > a:  # Optimization: if p^3 is already greater than a, no larger p will work\n            break\n        for j in range(i, len(primes)):  # Start q from p (q >= p)\n            q = primes[j]\n            if p * q * q > a:  # Optimization: if p*q^2 is already greater than a, no larger q will work\n                break\n            \n            # Calculate the third potential factor, r\n            if a % (p * q) == 0:\n                r = a // (p * q)\n                # Check if r is prime and if it maintains the order r >= q\n                if r >= q and is_prime(r):\n                    return True\n    return False"}
{"task_id": "HumanEval/76", "solution": "def is_simple_power(x, n):\n    \"\"\"Checks if a number x is a simple power of n (n**k == x for k >= 0).\"\"\"\n    # Rule 1: If x is 1, it's a power of any non-zero n (n**0 = 1).\n    # If n is 0 and x is 1, it's false as 0**0 is undefined/treated as false.\n    if x == 1:\n        return n != 0\n\n    # Rule 2: If n is 0 (and x is not 1, as handled above)\n    # 0**k = 0 for k > 0. So, x must be 0.\n    if n == 0:\n        return x == 0\n\n    # Rule 3: If n is 1 (and x is not 1, as handled above)\n    # 1**k = 1 for any k. Since x is not 1, it cannot be a power of 1.\n    if n == 1:\n        return False\n\n    # Rule 4: If n is -1 (and x is not 1, as handled above)\n    # (-1)**k can only be 1 (for even k) or -1 (for odd k). Since x != 1, x must be -1.\n    if n == -1:\n        return x == -1\n\n    # General cases for n (n not 0, 1, -1) and x (x not 0, 1)\n\n    # If x is 0 at this point, and n is not 0, then n**k can never be 0.\n    if x == 0:\n        return False\n\n    # If n is positive (n > 1)\n    if n > 1:\n        # If x is negative, a positive base cannot produce a negative result.\n        if x < 0:\n            return False\n\n        temp_x = x\n        while temp_x > 1:\n            if temp_x % n != 0:\n                return False  # Not perfectly divisible\n            temp_x //= n\n        return temp_x == 1  # After divisions, if it reduced to 1, it's a power\n\n    # If n is negative (n < -1)\n    else:\n        # For a negative base n, the sign of x depends on the parity of the exponent k.\n        # If x > 0, k must be even.\n        # If x < 0, k must be odd.\n\n        temp_x_abs = abs(x)\n        abs_n = abs(n)\n\n        # temp_x_abs must be a power of abs_n.\n        if temp_x_abs == 0:  # If x was 0, it's already handled above for n!=0.\n            return False\n\n        exponent = 0\n        while temp_x_abs > 1:\n            if temp_x_abs % abs_n != 0:\n                return False\n            temp_x_abs //= abs_n\n            exponent += 1\n\n        if temp_x_abs != 1:  # Did not reduce to 1.\n            return False\n\n        # Check parity of the exponent against the original sign of x.\n        if x > 0:  # Original x was positive, so exponent must be even.\n            return exponent % 2 == 0\n        else:  # Original x was negative, so exponent must be odd.\n            return exponent % 2 != 0"}
{"task_id": "HumanEval/76", "solution": "def is_simple_power(x, n):\n    \"\"\"\n    Checks if x is a simple power of n (n**k == x for some integer k >= 0).\n    Uses integer arithmetic to prevent floating-point inaccuracies.\n    \"\"\"\n    if n == 1:\n        return x == 1\n    if x == 1:\n        return True\n\n    # Binary search for the exponent k such that n**k == x\n    lo, hi = 0, x # A safe upper bound for k is x itself if n is 2, or log_n(x) which is less than x\n    \n    # Refine upper bound (can start with a smaller, more practical upper bound like log2(x) if n=2)\n    # For n > 1, if n**k = x, then k <= x.\n    # We can refine hi to a smaller value:\n    # if x > 0 and n > 1:\n    #     hi = 1\n    #     while True:\n    #         try:\n    #             if pow(n, hi) >= x:\n    #                 break\n    #             hi *= 2\n    #         except OverflowError: # n**hi became too large, x must be smaller\n    #             break\n    # If x is very large, pow(n,hi) can take a long time or overflow before hi is actually an upper bound.\n    # A simple and robust upper bound is x itself, or even log_2(x) for n > 1.\n    # For a general base n, a simple binary search directly on the exponent will work.\n    \n    # A tighter initial upper bound for binary search:\n    # k = log_n(x) => k < x (for n > 1, x > 1)\n    # For example, if x is 8 and n is 2, k is 3. `hi` can be initially set to `x` or even calculated as `x`'s bit length.\n    # Let's use a dynamic doubling approach as suggested in the design.\n    current_k_upper = 1\n    while True:\n        try:\n            if pow(n, current_k_upper) >= x:\n                break\n            current_k_upper *= 2\n        except OverflowError:\n            # If n**current_k_upper overflows, then x must be smaller than this power.\n            # So, the actual exponent must be less than current_k_upper.\n            # We can use current_k_upper as a safe upper bound for our binary search.\n            break\n    hi = current_k_upper\n\n\n    while lo <= hi:\n        mid = (lo + hi) // 2\n        power_val = pow(n, mid)\n\n        if power_val == x:\n            return True\n        elif power_val < x:\n            lo = mid + 1\n        else: # power_val > x\n            hi = mid - 1\n            \n    return False"}
{"task_id": "HumanEval/77", "solution": "def iscube(a):\n    \"\"\"\n    Checks if an integer is a perfect cube using an integer binary search.\n    Assumes the input 'a' is always a valid integer.\n    \"\"\"\n    if a == 0:\n        return True\n\n    # Use absolute value for binary search and restore sign later if needed\n    x = abs(a)\n    \n    # Binary search for the integer cube root of x\n    # The cube root of x will be between 0 and x (inclusive).\n    lo, hi = 0, x \n\n    while lo <= hi:\n        mid = (lo + hi) // 2\n        # Calculate cube; Python's integers handle arbitrary size, so no overflow.\n        cube = mid * mid * mid\n\n        if cube == x:\n            # Found an exact integer cube root for abs(a)\n            return True\n        elif cube < x:\n            # Mid is too small, search in the upper half\n            lo = mid + 1\n        else: # cube > x\n            # Mid is too large, search in the lower half\n            hi = mid - 1\n            \n    # If the loop completes, no exact integer cube root was found for abs(a).\n    return False"}
{"task_id": "HumanEval/77", "solution": "def iscube(a):\n    '''\n    Checks if an integer 'a' is a perfect cube.\n    Uses binary search to find the integer cube root and verifies its cube.\n    '''\n\n    def _integer_cuberoot(n: int) -> int:\n        \"\"\"\n        Calculates the integer cube root of n.\n        Returns floor(cbrt(|n|)) with the sign of n.\n        \"\"\"\n        if n == 0:\n            return 0\n        \n        sign = 1 if n > 0 else -1\n        target_abs = abs(n)\n        \n        # Binary search for the integer root\n        # The upper bound can be optimized, e.g., to min(target_abs, 2 * 10**6 + 1)\n        # for 64-bit integers, but target_abs is simpler and correct for Python's arbitrary-precision ints.\n        low, high = 0, target_abs \n        \n        while low <= high:\n            mid = (low + high) // 2\n            cube = mid * mid * mid\n            \n            if cube == target_abs:\n                return sign * mid\n            if cube < target_abs:\n                low = mid + 1\n            else:\n                high = mid - 1\n        \n        # At this point, low > high. 'high' holds the largest integer \n        # whose cube is less than or equal to target_abs.\n        return sign * high\n\n    root = _integer_cuberoot(a)\n    return root * root * root == a"}
