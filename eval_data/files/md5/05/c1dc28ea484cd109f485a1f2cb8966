{"task_id": "HumanEval/47", "solution": "from typing import Any, Iterable, List, Optional\nfrom abc import ABC, abstractmethod\nimport uuid\nfrom datetime import datetime\n\nclass MedianError(Exception):\n    \"\"\"Base exception for median-related errors.\"\"\"\n    pass\n\nclass MedianValidationError(MedianError):\n    \"\"\"Raised when input validation fails.\"\"\"\n    def __init__(self, message: str, invalid_item: Any = None, index: Optional[int] = None):\n        super().__init__(message)\n        self.invalid_item = invalid_item\n        self.index = index\n\nclass MedianPersistenceError(MedianError):\n    \"\"\"Raised for errors during persistence operations.\"\"\"\n    pass\n\nclass Validator:\n    \"\"\"Provides utility methods for input validation and coercion.\"\"\"\n    @staticmethod\n    def is_number(x: Any) -> bool:\n        \"\"\"Checks if a value is a number (int or float, excluding bool).\"\"\"\n        return isinstance(x, (int, float)) and not isinstance(x, bool)\n\n    @staticmethod\n    def validate_numbers(values: Iterable[Any]) -> List[float]:\n        \"\"\"Ensures an iterable contains only numeric types and converts them to floats.\"\"\"\n        if values is None:\n            raise MedianValidationError(\"Input is None.\")\n        lst = list(values)\n        if len(lst) == 0:\n            raise MedianValidationError(\"Input list is empty.\")\n        out = []\n        for i, v in enumerate(lst):\n            if not Validator.is_number(v):\n                raise MedianValidationError(\"Non-numeric value found.\", invalid_item=v, index=i)\n            out.append(float(v))\n        return out\n\nclass Sorter(ABC):\n    \"\"\"Abstract base class for sorting strategies.\"\"\"\n    @abstractmethod\n    def sort(self, values: List[float]) -> List[float]:\n        pass\n\nclass TimsortSorter(Sorter):\n    \"\"\"Implements sorting using Python's built-in Timsort algorithm.\"\"\"\n    def sort(self, values: List[float]) -> List[float]:\n        return sorted(values)\n\nclass MedianCalculator:\n    \"\"\"Calculates the median of a list of numbers.\"\"\"\n    def median(self, values: Iterable[float], sorter: Optional[Sorter] = None) -> float:\n        \"\"\"Computes the median of the given numeric values.\"\"\"\n        lst = list(values)\n        if not lst:\n            raise MedianValidationError(\"Empty list provided for median calculation.\")\n        \n        actual_sorter = sorter or TimsortSorter()\n        s = actual_sorter.sort(lst)\n        return self._median_from_sorted(s)\n\n    def _median_from_sorted(self, sorted_values: List[float]) -> float:\n        \"\"\"Computes the median from an already sorted list.\"\"\"\n        n = len(sorted_values)\n        if n % 2 == 1:\n            return float(sorted_values[n // 2])\n        else:\n            mid1 = sorted_values[n // 2 - 1]\n            mid2 = sorted_values[n // 2]\n            return (float(mid1) + float(mid2)) / 2.0\n\nclass MedianDTO:\n    \"\"\"Data transfer object representing a computed median record.\"\"\"\n    def __init__(self, id: str, timestamp: str, input_list: List[float], median: float, count: int) -> None:\n        self.id = id\n        self.timestamp = timestamp\n        self.input_list = input_list\n        self.median = median\n        self.count = count\n\n    def to_dict(self) -> dict[str, Any]:\n        \"\"\"Serializes the DTO to a JSON-friendly dictionary.\"\"\"\n        return {\n            \"id\": self.id,\n            \"timestamp\": self.timestamp,\n            \"input_list\": self.input_list,\n            \"median\": self.median,\n            \"count\": self.count,\n        }\n\n    @staticmethod\n    def from_dict(d: dict[str, Any]) -> \"MedianDTO\":\n        \"\"\"Creates a MedianDTO instance from a dictionary.\"\"\"\n        return MedianDTO(\n            id=d[\"id\"],\n            timestamp=d[\"timestamp\"],\n            input_list=d[\"input_list\"],\n            median=d[\"median\"],\n            count=d[\"count\"],\n        )\n\nclass MedianRepository:\n    \"\"\"A stub repository for persistence operations, not actively used by the 'median' function.\"\"\"\n    def __init__(self, path: Optional[str] = None) -> None:\n        pass\n\n    def save(self, dto: MedianDTO) -> None:\n        pass\n\n    def load_all(self) -> List[MedianDTO]:\n        return []\n\nclass MedianController:\n    \"\"\"Orchestrates validation, median calculation, and optional persistence.\"\"\"\n    def __init__(self, repo: Optional[MedianRepository] = None, sorter: Optional[Sorter] = None) -> None:\n        self._repo = repo or MedianRepository()\n        self._sorter = sorter or TimsortSorter()\n        self._validator = Validator()\n\n    def compute(self, raw_input: Any, persist: bool = False) -> MedianDTO:\n        \"\"\"Computes the median and optionally persists the result.\"\"\"\n        processed_list = self._validator.validate_numbers(raw_input)\n\n        calculator = MedianCalculator()\n        median_value = calculator.median(processed_list, sorter=self._sorter)\n\n        dto = MedianDTO(\n            id=str(uuid.uuid4()),\n            timestamp=datetime.utcnow().isoformat(timespec='milliseconds') + 'Z',\n            input_list=processed_list,\n            median=median_value,\n            count=len(processed_list)\n        )\n\n        if persist:\n            self._repo.save(dto)\n        \n        return dto\n\ndef median(l: list):\n    \"\"\"Return median of elements in the list l.\n    >>> median([3, 1, 2, 4, 5])\n    3\n    >>> median([-10, 4, 6, 1000, 10, 20])\n    15.0\n    \"\"\"\n    controller = MedianController()\n    dto = controller.compute(l, persist=False)\n    return dto.median"}
