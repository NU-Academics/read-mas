{"task_id": "HumanEval/86", "solution": "def anti_shuffle(s):\n    \"\"\"\n    Returns an ordered version of the string where words have characters sorted by ASCII value.\n    The order of words and blank spaces in the sentence is preserved.\n    \"\"\"\n    \n    # Split the string by spaces, preserving all space characters as empty strings between words\n    words = s.split(' ')\n    \n    sorted_words = []\n    for word in words:\n        # Sort characters within each word based on their ASCII value\n        sorted_chars = sorted(word, key=ord)\n        sorted_words.append(''.join(sorted_chars))\n        \n    # Join the sorted words back with spaces to preserve the original sentence structure\n    return ' '.join(sorted_words)"}
{"task_id": "HumanEval/86", "solution": "import collections # Not used, but keeping it to avoid minimal diff if it was an earlier thought.\n\n# 1. Models\nclass Token:\n    \"\"\"Base class for string tokens.\"\"\"\n    def __init__(self, text: str, index: int) -> None:\n        self.text = text\n        self.index = index\n\n    def is_space(self) -> bool:\n        \"\"\"Determines if the token represents a sequence of spaces.\"\"\"\n        raise NotImplementedError\n\nclass WordToken(Token):\n    \"\"\"Represents a token consisting of non-space characters.\"\"\"\n    def __init__(self, text: str, index: int) -> None:\n        super().__init__(text, index)\n\n    def is_space(self) -> bool:\n        return False\n\nclass SpaceToken(Token):\n    \"\"\"Represents a token consisting of one or more space characters.\"\"\"\n    def __init__(self, text: str, index: int) -> None:\n        super().__init__(text, index)\n\n    def is_space(self) -> bool:\n        return True\n\n# 2. Tokenizer\nclass Tokenizer:\n    \"\"\"Splits an input string into a sequence of WordToken and SpaceToken objects.\"\"\"\n    def __init__(self) -> None:\n        pass\n\n    def tokenize(self, s: str) -> list[Token]:\n        tokens = []\n        if not s:\n            return tokens\n\n        current_chars = []\n        is_current_token_space = None # Tracks if the current sequence is spaces or words\n\n        for char in s:\n            char_is_space = (char == ' ')\n\n            if is_current_token_space is None: # Initialize for the first character\n                is_current_token_space = char_is_space\n                current_chars.append(char)\n            elif char_is_space == is_current_token_space: # Continue current token type\n                current_chars.append(char)\n            else: # Token type changed, finalize previous token and start new one\n                token_text = \"\".join(current_chars)\n                if is_current_token_space:\n                    tokens.append(SpaceToken(token_text, len(tokens)))\n                else:\n                    tokens.append(WordToken(token_text, len(tokens)))\n\n                current_chars = [char]\n                is_current_token_space = char_is_space\n        \n        # Add the last accumulated token after the loop finishes\n        if current_chars:\n            token_text = \"\".join(current_chars)\n            if is_current_token_space:\n                tokens.append(SpaceToken(token_text, len(tokens)))\n            else:\n                tokens.append(WordToken(token_text, len(tokens)))\n        \n        return tokens\n\n# 3. Sorter\nclass Sorter:\n    \"\"\"Sorts characters within string tokens based on their ASCII/Unicode values.\"\"\"\n    def __init__(self) -> None:\n        pass\n\n    def sort_chars(self, s: str) -> str:\n        \"\"\"Sorts characters of a string alphabetically by code point.\"\"\"\n        return ''.join(sorted(s))\n\n    def sort_token(self, token: Token) -> Token:\n        \"\"\"Sorts characters within a WordToken, returns SpaceTokens unchanged.\"\"\"\n        if token.is_space():\n            return token\n        sorted_text = self.sort_chars(token.text)\n        return WordToken(sorted_text, token.index)\n\n# 4. AntiShuffleService\nclass AntiShuffleService:\n    \"\"\"Orchestrates tokenization, character sorting, and reassembly.\"\"\"\n    def __init__(self, tokenizer: Tokenizer, sorter: Sorter) -> None:\n        self._tokenizer = tokenizer\n        self._sorter = sorter\n\n    def process(self, s: str) -> str:\n        tokens = self._tokenizer.tokenize(s)\n        processed = [self._sorter.sort_token(t) for t in tokens]\n        return self._reassemble(processed)\n\n    def _reassemble(self, tokens: list[Token]) -> str:\n        \"\"\"Joins a list of tokens back into a single string.\"\"\"\n        return \"\".join(t.text for t in sorted(tokens, key=lambda x: x.index))\n\ndef anti_shuffle(s):\n    \"\"\"\n    Returns an ordered version of the string where words are sorted by ASCII value.\n    Keeps word order and blank spaces.\n    \"\"\"\n    service = AntiShuffleService(Tokenizer(), Sorter())\n    return service.process(s)"}
{"task_id": "HumanEval/87", "solution": "def get_row(lst, x):\n    \"\"\"\n    Finds integers x in a nested list and returns a list of (row, column) coordinates.\n    Coordinates are sorted by row ascending, then by column descending.\n    \"\"\"\n    found_coordinates = []\n    for r_idx, row in enumerate(lst):\n        for c_idx, val in enumerate(row):\n            if val == x:\n                found_coordinates.append((r_idx, c_idx))\n\n    # Sort coordinates by row in ascending order, and by column in descending order\n    return sorted(found_coordinates, key=lambda coord: (coord[0], -coord[1]))"}
{"task_id": "HumanEval/88", "solution": "def sort_array(array):\n    \"\"\"\n    Given an array of non-negative integers, return a copy of the given array after sorting,\n    you will sort the given array in ascending order if the sum( first index value, last index value) is odd,\n    or sort it in descending order if the sum( first index value, last index value) is even.\n    \"\"\"\n    if not array:\n        return []\n\n    if len(array) == 1:\n        return [array[0]]\n\n    first_element = array[0]\n    last_element = array[-1]\n    sum_first_last = first_element + last_element\n\n    # Sort in ascending order if the sum is odd\n    if (sum_first_last % 2) == 1:\n        return sorted(array)\n    # Sort in descending order if the sum is even\n    else:\n        return sorted(array, reverse=True)"}
{"task_id": "HumanEval/87", "solution": "from typing import List, Tuple, Any\n\ndef get_row(lst: List[List[Any]], x: int) -> List[Tuple[int, int]]:\n    \"\"\"\n    Finds integer x in a nested list and returns a list of its (row, column) coordinates.\n    Coordinates are sorted by row ascending, and within each row, by column descending.\n    \"\"\"\n    \n    coords_by_row = {}\n\n    for r_idx, row in enumerate(lst):\n        for c_idx, val in enumerate(row):\n            if val == x:\n                if r_idx not in coords_by_row:\n                    coords_by_row[r_idx] = []\n                coords_by_row[r_idx].append((r_idx, c_idx))\n    \n    final_sorted_coords = []\n    \n    for r_idx in sorted(coords_by_row.keys()):\n        row_coords = coords_by_row[r_idx]\n        row_coords.sort(key=lambda coord: -coord[1])\n        final_sorted_coords.extend(row_coords)\n        \n    return final_sorted_coords"}
{"task_id": "HumanEval/88", "solution": "def sort_array(array):\n    \"\"\"\n    Given an array of non-negative integers, return a copy of the given array after sorting,\n    you will sort the given array in ascending order if the sum( first index value, last index value) is odd,\n    or sort it in descending order if the sum( first index value, last index value) is even.\n    \"\"\"\n    if not array:\n        return []\n    if len(array) == 1:\n        return list(array)  # Return a copy for consistency\n\n    first_element = array[0]\n    last_element = array[-1]\n    \n    if (first_element + last_element) % 2 == 1:\n        # Sum is odd, sort in ascending order\n        return sorted(list(array))\n    else:\n        # Sum is even, sort in descending order\n        return sorted(list(array), reverse=True)"}
{"task_id": "HumanEval/89", "solution": "def encrypt(s):\n    \"\"\"Encrypts a string by rotating alphabetic characters by 4 positions, preserving case and non-letters.\n    The rotation shifts letters down by two multiplied to two places (i.e., by 4).\n    \"\"\"\n    result_chars = []\n    rotation_amount = 4  # Derived from \"two multiplied to two places\" (2 * 2)\n\n    for char in s:\n        if 'a' <= char <= 'z':\n            base = ord('a')\n            shifted_code = (ord(char) - base + rotation_amount) % 26 + base\n            result_chars.append(chr(shifted_code))\n        elif 'A' <= char <= 'Z':\n            base = ord('A')\n            shifted_code = (ord(char) - base + rotation_amount) % 26 + base\n            result_chars.append(chr(shifted_code))\n        else:\n            result_chars.append(char)  # Non-alphabetic characters are unchanged\n\n    return \"\".join(result_chars)"}
{"task_id": "HumanEval/90", "solution": "from typing import List, Optional\n\n\ndef next_smallest(lst: List[int]) -> Optional[int]:\n    \"\"\"\n    Returns the 2nd smallest distinct element of the list, or None if no such element.\n    \"\"\"\n    distinct = set(lst)\n\n    if len(distinct) < 2:\n        return None\n\n    min1 = None\n    min2 = None\n\n    for v in distinct:\n        if min1 is None or v < min1:\n            min2 = min1\n            min1 = v\n        elif min2 is None or v < min2:\n            min2 = v\n\n    return min2"}
{"task_id": "HumanEval/89", "solution": "def encrypt(s):\n    \"\"\"Create a function encrypt that takes a string as an argument and\n    returns a string encrypted with the alphabet being rotated.\n    The alphabet should be rotated in a manner such that the letters\n    shift down by two multiplied to two places.\n    For example:\n    encrypt('hi') returns 'lm'\n    encrypt('asdfghjkl') returns 'ewhjklnop'\n    encrypt('gf') returns 'kj'\n    encrypt('et') returns 'ix'\n    \"\"\"\n    shift = 4  # The alphabet shifts down by two multiplied to two places (2 * 2 = 4)\n    encrypted_chars = []\n    for char in s:\n        if 'a' <= char <= 'z':\n            # Handle lowercase letters with wraparound\n            encrypted_char = chr(((ord(char) - ord('a') + shift) % 26) + ord('a'))\n            encrypted_chars.append(encrypted_char)\n        elif 'A' <= char <= 'Z':\n            # Handle uppercase letters with wraparound\n            encrypted_char = chr(((ord(char) - ord('A') + shift) % 26) + ord('A'))\n            encrypted_chars.append(encrypted_char)\n        else:\n            # Non-alphabetic characters remain unchanged\n            encrypted_chars.append(char)\n    return \"\".join(encrypted_chars)"}
{"task_id": "HumanEval/91", "solution": "import re\nfrom dataclasses import dataclass\nfrom typing import List, Optional\n\n# --- Exceptions ---\nclass ValidationError(Exception):\n    def __init__(self, message: str):\n        self.message = message\n        super().__init__(self.message)\n\nclass ParseError(Exception):\n    def __init__(self, message: str):\n        self.message = message\n        super().__init__(self.message)\n\n# --- Models ---\n@dataclass(frozen=True)\nclass Sentence:\n    text: str\n    start_index: int\n\n    def __repr__(self) -> str:\n        return f\"Sentence(start={self.start_index}, text={self.text!r})\"\n\n# --- Utils ---\nLEADING_TRIM_REGEX = r'^\\s*[\"\\'(\\[]*'\nI_START_RE = r'^\\s*[\"\\'(\\[]*I\\b'\n\ndef normalize_leading(text: str) -> str:\n    \"\"\"Strips leading whitespace and opening punctuation from text.\"\"\"\n    return re.sub(LEADING_TRIM_REGEX, '', text)\n\n# --- Parser ---\nclass SentenceParser:\n    SENTENCE_DELIMITERS = r'([^\\.?!]+)([\\.?!]|$)'\n\n    def parse(self, text: str) -> List[Sentence]:\n        segments = re.finditer(self.SENTENCE_DELIMITERS, text, flags=re.DOTALL)\n        sentences = []\n        for m in segments:\n            seg_content = m.group(1)\n            start = m.start(1)\n            \n            # Normalize leading part, then strip all surrounding whitespace\n            norm = normalize_leading(seg_content).strip()\n            \n            if norm: # Only add non-empty normalized sentences\n                sentences.append(Sentence(text=norm, start_index=start))\n        return sentences\n\n# --- Analyzer ---\nclass SentenceAnalyzer:\n    I_START_RE = I_START_RE\n\n    def is_bored_sentence(self, sentence: Sentence) -> bool:\n        return re.match(self.I_START_RE, sentence.text) is not None\n\n# --- Service ---\nclass BoredomService:\n    def __init__(self, parser: Optional[SentenceParser] = None, analyzer: Optional[SentenceAnalyzer] = None):\n        self.parser = parser or SentenceParser()\n        self.analyzer = analyzer or SentenceAnalyzer()\n\n    def count_boredoms(self, text: str) -> int:\n        sentences = self.parser.parse(text)\n        return sum(1 for s in sentences if self.analyzer.is_bored_sentence(s))\n\n# --- Public API function ---\ndef is_bored(S: str) -> int:\n    \"\"\"\n    Counts the number of boredoms in a string.\n    A boredom is a sentence that starts with the word \"I\".\n    \"\"\"\n    service = BoredomService()\n    return service.count_boredoms(S)"}
{"task_id": "HumanEval/90", "solution": "import math\nfrom typing import List, Optional, Any, Iterable\n\ndef next_smallest(lst: List[int]) -> Optional[int]:\n    \"\"\"\n    Returns the 2nd smallest distinct element of the list.\n    Returns None if there is no such element.\n    \"\"\"\n\n    class InvalidInputError(Exception):\n        \"\"\"Custom exception for invalid input.\"\"\"\n        def __init__(self, message: str) -> None:\n            self.message = message\n            super().__init__(self.message)\n\n    class NextSmallestResult:\n        \"\"\"DTO for encapsulating the result value.\"\"\"\n        def __init__(self, value: Optional[int]) -> None:\n            self.value = value\n\n    class Validator:\n        \"\"\"Validates and coerces input lists.\"\"\"\n        def __init__(self, allow_float_to_int: bool = False) -> None:\n            self.ALLOW_FLOAT_TO_INT = allow_float_to_int\n\n        def _coerce_value(self, v: Any) -> int:\n            \"\"\"Attempts to coerce a single value to int.\"\"\"\n            if isinstance(v, int):\n                return v\n            if self.ALLOW_FLOAT_TO_INT and isinstance(v, float) and v.is_integer():\n                return int(v)\n            raise InvalidInputError(f\"Element '{v}' is not a valid integer.\")\n\n        def validate_list_of_ints(self, lst: Any) -> List[int]:\n            \"\"\"Validates that input is an iterable of integers.\"\"\"\n            if not isinstance(lst, (list, tuple)):\n                raise InvalidInputError(\"Input must be a list or tuple.\")\n            \n            validated_list = []\n            for item in lst:\n                validated_list.append(self._coerce_value(item))\n            return validated_list\n\n    class NextSmallestService:\n        \"\"\"Encapsulates the business logic for finding the 2nd smallest distinct integer.\"\"\"\n        def __init__(self, validator: Optional[Validator] = None) -> None:\n            self.validator = validator or Validator()\n\n        def compute(self, lst: List[int]) -> NextSmallestResult:\n            \"\"\"Validates input, computes the 2nd smallest distinct integer, and returns the result.\"\"\"\n            validated_values = self.validator.validate_list_of_ints(lst)\n            val = self._compute_second_smallest_ints(validated_values)\n            return NextSmallestResult(val)\n\n        def _compute_second_smallest_ints(self, values: Iterable[int]) -> Optional[int]:\n            \"\"\"Efficiently computes the second smallest distinct integer using a single pass.\"\"\"\n            min1 = None\n            min2 = None\n            seen = set()\n\n            for v in values:\n                if v in seen:\n                    continue\n                seen.add(v)\n\n                if min1 is None or v < min1:\n                    min2 = min1\n                    min1 = v\n                elif min2 is None or v < min2:\n                    min2 = v\n            return min2\n\n    svc = NextSmallestService()\n    result = svc.compute(lst)\n    return result.value"}
{"task_id": "HumanEval/92", "solution": "import math\n\ndef any_int(x, y, z):\n    \"\"\"\n    Create a function that takes 3 numbers.\n    Returns true if one of the numbers is equal to the sum of the other two, and all numbers are integers.\n    Returns false in any other cases.\n    \"\"\"\n    # Helper function to check if a value is an integer or a float with no fractional part.\n    def _is_int_value(value):\n        if value is None:\n            return False\n        if isinstance(value, int):\n            return True\n        if isinstance(value, float):\n            if not math.isfinite(value):\n                return False\n            return value.is_integer()\n        return False\n\n    # First, validate that all three inputs are integers (including floats like 3.0)\n    if not (_is_int_value(x) and _is_int_value(y) and _is_int_value(z)):\n        return False\n\n    # If all are valid integers, cast them to int for precise sum comparison.\n    int_x, int_y, int_z = int(x), int(y), int(z)\n\n    # Check if any one number equals the sum of the other two\n    return (int_x == int_y + int_z) or \\\n           (int_y == int_x + int_z) or \\\n           (int_z == int_x + int_y)"}
{"task_id": "HumanEval/91", "solution": "from typing import Optional\n\ndef is_bored(S):\n    \"\"\"\n    Counts the number of \"boredoms\" in a string. A boredom is a sentence\n    that starts with the word \"I\". Sentences are delimited by '.', '?' or '!'.\n    \"\"\"\n    boredom_count = 0\n    fragments = []\n    current_fragment_chars = []\n    DELIMITERS = {'.', '?', '!'}\n\n    # Split the input string into sentence fragments based on delimiters.\n    for char in S:\n        if char in DELIMITERS:\n            if current_fragment_chars:\n                fragments.append(\"\".join(current_fragment_chars))\n                current_fragment_chars = []\n        else:\n            current_fragment_chars.append(char)\n\n    # Add any remaining fragment after the loop if the string doesn't end with a delimiter.\n    if current_fragment_chars:\n        fragments.append(\"\".join(current_fragment_chars))\n\n    def _get_first_token(sentence_text: str) -> Optional[str]:\n        \"\"\"\n        Extracts the first token of a sentence after stripping leading quotes and punctuation.\n        \"\"\"\n        # Leading characters to strip as specified in the design context (utils.tokenize_sentence_start).\n        leading_chars_to_strip = \" \\\"'\u201c\u201d\u00ab\u00bb\\u2018\\u2019\\u201c\\u201d\"\n        s_stripped = sentence_text.lstrip(leading_chars_to_strip)\n\n        if not s_stripped:\n            return None\n        \n        # Split on whitespace and return the first part.\n        first_word_parts = s_stripped.split(None, 1)\n        if first_word_parts:\n            return first_word_parts[0]\n        return None # Should not be reached if s_stripped is not empty\n\n    # Process each extracted fragment.\n    for fragment in fragments:\n        trimmed_fragment = fragment.strip()\n        if not trimmed_fragment:\n            continue\n        \n        first_token = _get_first_token(trimmed_fragment)\n        \n        # Check if the first token is exactly \"I\" (case-sensitive).\n        if first_token == \"I\":\n            boredom_count += 1\n            \n    return boredom_count"}
