{"task_id": "HumanEval/34", "solution": "import abc\nimport collections\nimport json\nfrom typing import Any, Optional\n\n\nclass InvalidInputError(Exception):\n    \"\"\"Custom exception for invalid input types or values.\"\"\"\n    pass\n\n\nclass IncomparableElementsError(Exception):\n    \"\"\"Custom exception for lists containing non-comparable elements.\"\"\"\n    pass\n\n\nclass SortStrategy(abc.ABC):\n    \"\"\"Abstract base class for sorting strategies.\"\"\"\n    @abc.abstractmethod\n    def sort(self, items: list) -> list:\n        pass\n\n\nclass DefaultSortStrategy(SortStrategy):\n    \"\"\"Default sorting implementation using Python's built-in sorted().\"\"\"\n    def __init__(self) -> None:\n        pass\n\n    def sort(self, items: list) -> list:\n        return sorted(items)\n\n\nclass InputValidator:\n    \"\"\"Validates inputs for iterability and comparability.\"\"\"\n    def validate_iterable(self, obj: Any) -> list:\n        \"\"\"Ensures the object is an iterable and converts it to a list.\"\"\"\n        if isinstance(obj, str):\n            raise InvalidInputError(\"String input is not supported directly; wrap in a list if intended.\")\n        if not hasattr(obj, '__iter__'):\n            raise InvalidInputError(\"Input must be an iterable.\")\n        \n        return list(obj)\n\n    def ensure_comparable(self, items: list) -> None:\n        \"\"\"Checks if elements in the list can be compared.\"\"\"\n        if not items:\n            return\n        try:\n            # Attempt a minimal sort to check for comparability.\n            # This will raise TypeError if elements are not comparable.\n            _ = sorted(items[:2])\n        except TypeError as e:\n            raise IncomparableElementsError(f\"Elements in the list are not comparable: {e}\")\n\n\nclass ResultCache:\n    \"\"\"An in-memory LRU cache for results.\"\"\"\n    def __init__(self, max_size: int = 128) -> None:\n        self._max_size = max_size\n        self._store: collections.OrderedDict[str, list] = collections.OrderedDict()\n\n    def get(self, key: str) -> Optional[list]:\n        \"\"\"Retrieves an item from the cache, moving it to the front.\"\"\"\n        if key not in self._store:\n            return None\n        value = self._store.pop(key)\n        self._store[key] = value\n        return value\n\n    def set(self, key: str, value: list) -> None:\n        \"\"\"Adds an item to the cache, managing LRU eviction.\"\"\"\n        if key in self._store:\n            self._store.pop(key)\n        elif len(self._store) >= self._max_size:\n            self._store.popitem(last=False)  # LRU eviction\n        self._store[key] = value\n\n    def clear(self) -> None:\n        \"\"\"Clears all items from the cache.\"\"\"\n        self._store.clear()\n\n\ndef _hash_items(items: list) -> str:\n    \"\"\"Generates a stable string hash for a list of items for caching.\"\"\"\n    try:\n        # Use canonical JSON dump for stable hashing of JSON-serializable items.\n        return json.dumps(items, sort_keys=True)\n    except TypeError:\n        # Fallback for non-JSON-serializable items (e.g., custom objects, specific unhashable types).\n        # Convert to tuple for consistent string representation if elements are hashable.\n        # If not, use basic string conversion as a last resort.\n        try:\n            return str(tuple(items))\n        except TypeError:\n            return str(items)\n\n\nclass UniqueService:\n    \"\"\"Central business logic for producing sorted unique lists.\"\"\"\n    def __init__(self, sort_strategy: SortStrategy, cache: ResultCache, validator: InputValidator) -> None:\n        self._sort_strategy = sort_strategy\n        self._cache = cache\n        self._validator = validator\n\n    def get_unique(self, items: list) -> list:\n        normalized = self._validator.validate_iterable(items)\n        \n        key = _hash_items(normalized)\n        cached = self._cache.get(key)\n        if cached is not None:\n            return cached\n        \n        deduped = []\n        try:\n            deduped = list(set(normalized))\n        except TypeError:\n            # Fallback for unhashable items (e.g., lists of lists).\n            # This preserves the order of first appearance before sorting.\n            seen_elements = []\n            for x in normalized:\n                if x not in seen_elements:\n                    seen_elements.append(x)\n            deduped = seen_elements\n        \n        self._validator.ensure_comparable(deduped)\n        \n        result = self._sort_strategy.sort(deduped)\n        \n        try:\n            self._cache.set(key, result)\n        except Exception:\n            # Cache failures are logged and ignored, not failing the request.\n            pass\n            \n        return result\n\n\ndef unique(l: list) -> list:\n    \"\"\"Return sorted unique elements in a list.\"\"\"\n    service = UniqueService(DefaultSortStrategy(), ResultCache(), InputValidator())\n    return service.get_unique(l)"}
{"task_id": "HumanEval/35", "solution": "class EmptyCollectionError(ValueError):\n    \"\"\"Raised when the collection is empty.\"\"\"\n    def __init__(self, message: str = \"Iterable is empty\"):\n        super().__init__(message)\n\nclass NonComparableError(TypeError):\n    \"\"\"Raised when elements in the collection cannot be compared.\"\"\"\n    def __init__(self, message: str = \"Elements are not comparable\"):\n        super().__init__(message)\n\ndef max_element(l: list):\n    \"\"\"Return maximum element in the list.\n    >>> max_element([1, 2, 3])\n    3\n    >>> max_element([5, 3, -5, 2, -3, 3, 9, 0, 123, 1, -10])\n    123\n    \"\"\"\n    try:\n        return max(l)\n    except ValueError as e:\n        raise EmptyCollectionError(str(e))\n    except TypeError as e:\n        raise NonComparableError(str(e))"}
{"task_id": "HumanEval/36", "solution": "def fizz_buzz(n: int):\n    \"\"\"Return the number of times the digit 7 appears in integers less than n which are divisible by 11 or 13.\n    >>> fizz_buzz(50)\n    0\n    >>> fizz_buzz(78)\n    2\n    >>> fizz_buzz(79)\n    3\n    \"\"\"\n\n    total_sevens_count = 0\n    divisors = (11, 13)\n\n    # Helper function to count occurrences of a digit in a number's string representation.\n    def count_digit_in_number(x: int, digit_char: str = '7') -> int:\n        return str(x).count(digit_char)\n\n    # Collect all unique numbers less than n that are divisible by 11 or 13.\n    # This logic mimics InMemoryNumberRepository.generate to efficiently find multiples\n    # and avoid duplicates if a number is divisible by multiple divisors.\n    eligible_numbers = set()\n    for d in divisors:\n        # We only consider positive divisors as per typical problem context\n        if d <= 0:\n            continue\n        multiple = 0\n        while multiple < n:\n            eligible_numbers.add(multiple)\n            multiple += d\n            \n    # Iterate through the collected unique numbers and sum the counts of the digit '7'.\n    for num in eligible_numbers:\n        total_sevens_count += count_digit_in_number(num)\n        \n    return total_sevens_count"}
{"task_id": "HumanEval/36", "solution": "def fizz_buzz(n: int):\n    \"\"\"Return the number of times the digit 7 appears in integers less than n which are divisible by 11 or 13.\"\"\"\n    \n    # As per design, sanitize n to be non-negative.\n    n = max(0, n)\n    \n    total_sevens = 0\n    \n    # Iterate through numbers from 1 to n-1. 0 is divisible by 11 and 13 but does not contain the digit 7,\n    # and the design's NumberRepository snippet explicitly excludes 0.\n    for k in range(1, n):\n        # Check if k is divisible by 11 or 13.\n        if k % 11 == 0 or k % 13 == 0:\n            # Count occurrences of '7' in the string representation of k.\n            total_sevens += str(k).count('7')\n            \n    return total_sevens"}
{"task_id": "HumanEval/37", "solution": "def sort_even(l: list):\n    \"\"\"\n    Sorts elements at even indices of a list in ascending order while preserving elements at odd indices.\n    Returns a new list with the sorted even-indexed elements.\n    \"\"\"\n    if not l:\n        return []\n\n    # Extract elements at even indices\n    even_indexed_elements = [l[i] for i in range(0, len(l), 2)]\n\n    # Sort the extracted elements\n    sorted_even_elements = sorted(even_indexed_elements)\n\n    # Create a new list to store the result, initially a copy of the original\n    result = list(l)\n\n    # Place the sorted even elements back into their original even indices\n    sorted_idx = 0\n    for i in range(0, len(l), 2):\n        result[i] = sorted_even_elements[sorted_idx]\n        sorted_idx += 1\n\n    return result"}
{"task_id": "HumanEval/37", "solution": "def sort_even(l: list):\n    \"\"\"This function sorts elements at even indices of a list, leaving odd-indexed elements unchanged.\"\"\"\n    \n    # Extract elements at even indices\n    evens = [l[i] for i in range(0, len(l), 2)]\n    # Sort the extracted even-indexed elements\n    evens_sorted = sorted(evens)\n\n    # Recompose the list\n    result = []\n    even_idx_counter = 0\n    for i in range(len(l)):\n        if i % 2 == 0:\n            # Place sorted even element at current even index\n            result.append(evens_sorted[even_idx_counter])\n            even_idx_counter += 1\n        else:\n            # Place original odd element at current odd index\n            result.append(l[i])\n    return result"}
{"task_id": "HumanEval/38", "solution": "def decode_cyclic(s: str):\n    \"\"\"\n    takes as input string encoded with encode_cyclic function. Returns decoded string.\n    \"\"\"\n    # split string to groups. Each of length 3.\n    groups = [s[(3 * i):min((3 * i + 3), len(s))] for i in range((len(s) + 2) // 3)]\n    # cycle elements in each group. Unless group has fewer elements than 3.\n    # Inverse of (group[1:] + group[0]) is (group[-1] + group[:-1]) for a right rotation.\n    groups = [(group[-1] + group[:-1]) if len(group) == 3 else group for group in groups]\n    return \"\".join(groups)"}
