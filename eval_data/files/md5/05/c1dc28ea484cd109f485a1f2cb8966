{"task_id": "HumanEval/132", "solution": "def is_nested(string):\n    \"\"\"\n    Checks if there is a valid subsequence of brackets where at least one bracket is nested.\n    \"\"\"\n    # open_needed tracks how many opening brackets are still required to form the '[[[' part.\n    # It starts at 2, meaning we need two '[' to establish a potential nested sequence start.\n    open_needed = 2\n\n    # close_needed tracks how many closing brackets are still required to complete the ']]' part,\n    # once the '[[[' part has been established.\n    close_needed = 0\n\n    for char in string:\n        if char == '[':\n            if open_needed > 0:\n                open_needed -= 1\n                if open_needed == 0:\n                    # We've found at least '[[', now we need to find two ']]'.\n                    close_needed = 2\n        elif char == ']':\n            if close_needed > 0:\n                close_needed -= 1\n                if close_needed == 0:\n                    # We've found '[[...]]' as a subsequence. This confirms nesting.\n                    return True\n    return False"}
{"task_id": "HumanEval/134", "solution": "def check_if_last_char_is_a_letter(txt):\n    # If the string is empty, the condition cannot be met.\n    if not txt:\n        return False\n\n    # If the last character is a space, it is not an alphabetical character\n    # and thus cannot be a single, isolated letter.\n    if txt[-1].isspace():\n        return False\n\n    # Split the string by spaces to identify words/tokens.\n    parts = txt.split(' ')\n\n    # Iterate from the end to find the last non-empty token.\n    last_non_empty_token = None\n    for p in reversed(parts):\n        if p:\n            last_non_empty_token = p\n            break\n\n    # If no non-empty token is found (e.g., input was just spaces or empty,\n    # though empty is handled by the first check), the condition cannot be met.\n    if last_non_empty_token is None:\n        return False\n\n    # The condition is met if the last non-empty token consists of exactly\n    # one alphabetical character.\n    return len(last_non_empty_token) == 1 and last_non_empty_token.isalpha()"}
{"task_id": "HumanEval/133", "solution": "import math\n\ndef sum_squares(lst):\n    \"\"\"Calculates the sum of squared numbers after rounding each to its ceiling.\"\"\"\n    total_sum = 0\n    for num in lst:\n        ceiled_num = math.ceil(num)\n        total_sum += int(ceiled_num * ceiled_num)\n    return total_sum"}
{"task_id": "HumanEval/132", "solution": "def is_nested(string):\n    \"\"\"\n    Checks if there's a valid subsequence of brackets with at least one nested pair.\n    A pair is nested if, after matching, an outer opening bracket still exists on the stack.\n    \"\"\"\n    stack = []\n    for char in string:\n        if char == '[':\n            stack.append(char)\n        elif char == ']':\n            if stack:\n                stack.pop()\n                if stack:\n                    # If stack is not empty after popping, the matched pair\n                    # was inside another currently open bracket.\n                    return True\n    return False"}
{"task_id": "HumanEval/134", "solution": "def check_if_last_char_is_a_letter(txt):\n    \"\"\"\n    Checks if the last character of a string is an alphabetical character\n    and is not part of a multi-character word.\n    \"\"\"\n    if not txt:\n        return False\n\n    last_char = txt[-1]\n\n    if not last_char.isalpha():\n        return False\n\n    if len(txt) == 1:\n        return True\n\n    return txt[-2] == \" \""}
{"task_id": "HumanEval/135", "solution": "def can_arrange(arr):\n    \"\"\"\n    Returns the largest index i such that arr[i] < arr[i-1].\n    If no such element exists, returns -1.\n    \"\"\"\n    n = len(arr)\n    if n <= 1:\n        return -1\n\n    # Scan the array from right to left\n    for i in range(n - 1, 0, -1):\n        if arr[i] < arr[i - 1]:\n            return i\n    return -1"}
{"task_id": "HumanEval/136", "solution": "import math\n\ndef largest_smallest_integers(lst):\n    \"\"\"\n    Finds the largest negative and smallest positive integers in a list.\n    Returns (largest_negative, smallest_positive), or None if not found.\n    \"\"\"\n    largest_neg = None\n    smallest_pos = None\n\n    for num in lst:\n        if num < 0:\n            if largest_neg is None or num > largest_neg:\n                largest_neg = num\n        elif num > 0:\n            if smallest_pos is None or num < smallest_pos:\n                smallest_pos = num\n\n    return (largest_neg, smallest_pos)"}
{"task_id": "HumanEval/135", "solution": "def can_arrange(arr):\n    \"\"\"\n    Returns the largest index `i` such that `arr[i] < arr[i-1]`.\n    If no such element exists, returns -1.\n    \"\"\"\n    n = len(arr)\n    if n < 2:\n        return -1\n\n    # Iterate from the second to last element down to the second element\n    # (index 1), as arr[i-1] requires a preceding element.\n    for i in range(n - 1, 0, -1):\n        if arr[i] < arr[i - 1]:\n            return i\n    \n    return -1"}
{"task_id": "HumanEval/137", "solution": "import re\n\nclass ParseError(ValueError):\n    \"\"\"Raised when an input string cannot be parsed into a numeric value.\"\"\"\n    pass\n\nclass NumericValue:\n    \"\"\"Represents an input value with its original form and a normalized float for comparison.\"\"\"\n    def __init__(self, raw, normalized, original_type, original_str=None):\n        self.raw = raw\n        self.normalized = normalized\n        self.original_type = original_type\n        self.original_str = original_str\n\n    @classmethod\n    def from_input(cls, raw, normalized):\n        \"\"\"Factory method to create a NumericValue from raw and normalized values.\"\"\"\n        t = 'str' if isinstance(raw, str) else ('int' if isinstance(raw, int) else 'float')\n        return cls(raw=raw, normalized=normalized, original_type=t, original_str=raw if t == 'str' else None)\n\n    def is_equal(self, other: 'NumericValue') -> bool:\n        \"\"\"Checks numeric equality based on the normalized float value.\"\"\"\n        return self.normalized == other.normalized\n\n    def compare(self, other: 'NumericValue') -> int:\n        \"\"\"Compares this value to another, returning -1 if less, 0 if equal, or 1 if greater.\"\"\"\n        if self.normalized < other.normalized:\n            return -1\n        if self.normalized > other.normalized:\n            return 1\n        return 0\n\nRE_FLOAT_LIKE = re.compile(r'^[+-]?\\d+([.,]\\d+)?$')\nMAX_INPUT_LENGTH = 1024\n\nclass NumericParser:\n    \"\"\"Parses various input types into a NumericValue object, handling decimal separators.\"\"\"\n    def parse(self, value):\n        \"\"\"Parses an input value (int, float, or str) into a NumericValue.\"\"\"\n        if isinstance(value, (int, float)):\n            try:\n                return NumericValue.from_input(value, float(value))\n            except Exception as e:\n                raise ParseError(f\"Cannot convert numeric input: {e}\")\n        if not isinstance(value, str):\n            raise ParseError(\"Value must be int, float, or numeric string\")\n\n        s = str(value).strip()\n        if not (0 < len(s) <= MAX_INPUT_LENGTH):\n            raise ParseError(\"Invalid string length or empty string\")\n\n        if not RE_FLOAT_LIKE.match(s):\n            raise ParseError(f\"Invalid numeric string format: '{s}'\")\n\n        normalized = self._normalize_string(s)\n        return NumericValue.from_input(value, normalized)\n\n    def _normalize_string(self, s: str) -> float:\n        \"\"\"Internal helper to convert a string with ',' or '.' decimal to float.\"\"\"\n        normalized_s = s.replace(',', '.')\n        try:\n            return float(normalized_s)\n        except ValueError as e:\n            raise ParseError(f\"Cannot convert '{s}' to float after normalization: {e}\")\n\nclass ComparatorService:\n    \"\"\"Compares two numeric values, preserving the original type of the larger one.\"\"\"\n    def __init__(self, parser: NumericParser = None):\n        self.parser = parser or NumericParser()\n\n    def compare_one(self, a, b):\n        \"\"\"Compares two inputs and returns the larger in its original form, or None if equal.\"\"\"\n        a_nv = self.parser.parse(a)\n        b_nv = self.parser.parse(b)\n\n        cmp_result = a_nv.compare(b_nv)\n\n        if cmp_result == 1:\n            return a_nv.raw\n        elif cmp_result == -1:\n            return b_nv.raw\n        else:\n            return None\n\n_default_service = ComparatorService()\n\ndef compare_one(a, b):\n    \"\"\"\n    Create a function that takes integers, floats, or strings representing\n    real numbers, and returns the larger variable in its given variable type.\n    Return None if the values are equal.\n    Note: If a real number is represented as a string, the floating point might be . or ,\n    \"\"\"\n    return _default_service.compare_one(a, b)"}
{"task_id": "HumanEval/136", "solution": "def largest_smallest_integers(lst):\n    \"\"\"\n    Finds the largest negative integer and the smallest positive integer in a list.\n    Returns (largest_negative, smallest_positive), with None if no such numbers exist.\n    \"\"\"\n    negatives = []\n    positives = []\n\n    for x in lst:\n        if x < 0:\n            negatives.append(x)\n        elif x > 0:\n            positives.append(x)\n\n    largest_negative = max(negatives) if negatives else None\n    smallest_positive = min(positives) if positives else None\n\n    return (largest_negative, smallest_positive)"}
{"task_id": "HumanEval/137", "solution": "from typing import Union, Optional\nimport re\n\ndef compare_one(a, b):\n    \"\"\"\n    Create a function that takes integers, floats, or strings representing\n    real numbers, and returns the larger variable in its given variable type.\n    Return None if the values are equal.\n    Note: If a real number is represented as a string, the floating point might be . or ,\n    \"\"\"\n\n    class ParseError(Exception):\n        \"\"\"Custom exception for parsing errors.\"\"\"\n        def __init__(self, message: str) -> None:\n            self.message = message\n            super().__init__(self.message)\n\n    class Value:\n        \"\"\"Domain model encapsulating original value and its numeric form.\"\"\"\n        def __init__(self, original: Union[int, float, str], numeric: float) -> None:\n            self._original = original\n            self._numeric = numeric\n\n        @property\n        def original(self) -> Union[int, float, str]:\n            return self._original\n\n        @property\n        def numeric(self) -> float:\n            return self._numeric\n\n        def is_numeric_equal(self, other: \"Value\") -> bool:\n            return self._numeric == other.numeric\n\n    def normalize_decimal(value: str) -> str:\n        \"\"\"Normalizes decimal separator and strips whitespace from a string.\"\"\"\n        return value.strip().replace(',', '.')\n\n    class ValueParser:\n        \"\"\"Parses various input types into a canonical float representation.\"\"\"\n        # Regex to validate numeric strings after normalization and stripping.\n        # Allows optional sign, digits, and optional fractional part separated by a dot.\n        _NUMERIC_STR_REGEX = re.compile(r\"^[+-]?\\d+(\\.\\d+)?$\")\n\n        def parse(self, value: Union[int, float, str]) -> float:\n            if isinstance(value, (int, float)):\n                return float(value)\n            \n            s = normalize_decimal(str(value))\n            if not self._validate_numeric_str(s):\n                raise ParseError(f\"Cannot parse '{value}' as a real number.\")\n            \n            try:\n                return float(s)\n            except ValueError:\n                # This catch is a safeguard, as the regex should prevent most ValueError scenarios.\n                raise ParseError(f\"Cannot parse '{value}' as a real number.\")\n\n        def _validate_numeric_str(self, s: str) -> bool:\n            return bool(self._NUMERIC_STR_REGEX.fullmatch(s))\n\n    class ValueFactory:\n        \"\"\"Creates Value objects from raw inputs using a ValueParser.\"\"\"\n        def __init__(self, parser: ValueParser) -> None:\n            self._parser = parser\n\n        def create(self, value: Union[int, float, str]) -> Value:\n            numeric = self._parser.parse(value)\n            return Value(original=value, numeric=numeric)\n\n    class ComparisonService:\n        \"\"\"Compares two values, preserving the original type of the larger one.\"\"\"\n        def __init__(self, factory: ValueFactory) -> None:\n            self._factory = factory\n\n        def compare(self, a_input: Union[int, float, str], b_input: Union[int, float, str]) -> Optional[Union[int, float, str]]:\n            val_a = self._factory.create(a_input)\n            val_b = self._factory.create(b_input)\n\n            if val_a.is_numeric_equal(val_b):\n                return None\n            \n            return val_a.original if val_a.numeric > val_b.numeric else val_b.original\n\n    # Instantiate the necessary components to perform the comparison.\n    parser_instance = ValueParser()\n    factory_instance = ValueFactory(parser_instance)\n    service_instance = ComparisonService(factory_instance)\n\n    return service_instance.compare(a, b)"}
