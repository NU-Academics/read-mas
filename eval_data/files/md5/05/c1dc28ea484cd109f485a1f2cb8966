{"task_id": "HumanEval/7", "solution": "import unicodedata\nfrom typing import List\n\n\nclass Normalizer:\n    \"\"\"Trim whitespace and apply Unicode NFKC normalization.\"\"\"\n    @staticmethod\n    def normalize(s: str) -> str:\n        return unicodedata.normalize('NFKC', s).strip()\n\n\nclass FilterService:\n    \"\"\"Core logic to filter strings based on a substring with optional case-insensitivity and normalization.\"\"\"\n    def __init__(self, ignore_case: bool = False, normalize: bool = False) -> None:\n        self.ignore_case = ignore_case\n        self.normalize = normalize\n\n    def filter(self, strings: List[str], substring: str) -> List[str]:\n        \"\"\"\n        Filters a list of strings for those containing the given substring, applying configured rules.\n        Returns the original strings that match, preserving order.\n        \"\"\"\n        processed_search_strings = list(strings)\n        processed_substring_for_comparison = substring\n\n        if self.normalize:\n            processed_search_strings = [Normalizer.normalize(s) for s in processed_search_strings]\n            processed_substring_for_comparison = Normalizer.normalize(processed_substring_for_comparison)\n\n        if self.ignore_case:\n            processed_search_strings = [s.lower() for s in processed_search_strings]\n            processed_substring_for_comparison = processed_substring_for_comparison.lower()\n\n        results = []\n        for i, searchable_s in enumerate(processed_search_strings):\n            if processed_substring_for_comparison in searchable_s:\n                results.append(strings[i])\n\n        return results\n\n\ndef filter_by_substring(strings: List[str], substring: str) -> List[str]:\n    \"\"\" Filter an input list of strings only for ones that contain given substring\n    >>> filter_by_substring([], 'a')\n    []\n    >>> filter_by_substring(['abc', 'bacd', 'cde', 'array'], 'a')\n    ['abc', 'bacd', 'array']\n    \"\"\"\n    service = FilterService()\n    return service.filter(strings, substring)"}
