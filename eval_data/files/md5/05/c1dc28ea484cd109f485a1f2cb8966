{"task_id": "HumanEval/101", "solution": "import re\n\ndef words_string(s):\n    \"\"\"\n    Splits a string into words, using commas or spaces as delimiters.\n    Empty tokens resulting from multiple delimiters are discarded.\n    \"\"\"\n    # Replace sequences of whitespace with a single space and strip leading/trailing whitespace.\n    normalized_s = re.sub(r'\\s+', ' ', s).strip()\n    \n    # If the string becomes empty after normalization, return an empty list.\n    if not normalized_s:\n        return []\n\n    # Split the normalized string by one or more commas or whitespace characters.\n    # Then strip each resulting token and filter out any empty strings.\n    tokens = [token.strip() for token in re.split(r'[,\\s]+', normalized_s) if token.strip()]\n    \n    return tokens"}
{"task_id": "HumanEval/101", "solution": "import re\n\ndef words_string(s):\n    \"\"\"\n    Splits a string into words, separating by commas or spaces,\n    trimming punctuation, and discarding empty tokens.\n    \"\"\"\n    if not s:\n        return []\n\n    DEFAULT_TRIM_CHARS = \".,;:!?\\\"'()[]{}\"\n    SPLIT_REGEX = r\"[,\\s]+\"\n\n    # Use re.split to get raw tokens based on commas and spaces\n    raw_tokens = re.split(SPLIT_REGEX, s)\n\n    processed_words = []\n    for token in raw_tokens:\n        # Normalize each token by stripping leading/trailing whitespace and specified punctuation\n        # This combines the Normalizer's logic: token.strip().strip(DEFAULT_TRIM_CHARS)\n        normalized_token = token.strip().strip(DEFAULT_TRIM_CHARS)\n\n        # Discard empty tokens after normalization\n        if normalized_token:\n            processed_words.append(normalized_token)\n\n    return processed_words"}
{"task_id": "HumanEval/102", "solution": "import math\n\ndef choose_num(x, y):\n    \"\"\"Returns the biggest even integer in the range [x, y] or -1 if none exists.\"\"\"\n    max_int = math.floor(y)\n    min_int = math.ceil(x)\n\n    if max_int < min_int:\n        return -1\n\n    # Start checking from the largest possible integer in the range [x, y]\n    # which is floor(y).\n    if max_int % 2 == 0:\n        candidate = int(max_int)\n    else:\n        candidate = int(max_int - 1)\n\n    # Check if the candidate even number is within the valid integer range [ceil(x), floor(y)]\n    if candidate >= min_int:\n        return candidate\n    else:\n        return -1"}
