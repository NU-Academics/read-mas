{"task_id": "HumanEval/56", "solution": "def correct_bracketing(brackets: str) -> bool:\n    \"\"\"Checks if a string of '<' and '>' brackets is correctly bracketed.\n\n    An integer counter is used to track the balance of opening and closing brackets.\n    \"\"\"\n    balance = 0\n    for char in brackets:\n        if char == '<':\n            balance += 1\n        elif char == '>':\n            balance -= 1\n        # If balance drops below zero, a closing bracket appeared without a matching opening one.\n        if balance < 0:\n            return False\n    # A correctly bracketed string must have a final balance of zero.\n    return balance == 0"}
