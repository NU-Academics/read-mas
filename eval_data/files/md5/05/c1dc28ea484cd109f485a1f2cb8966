{"task_id": "HumanEval/153", "solution": "def Strongest_Extension(class_name, extensions):\n    \"\"\"\n    Finds the strongest extension based on uppercase and lowercase letter counts.\n    Ties are broken by choosing the extension that appears first in the list.\n    \"\"\"\n\n    def _calculate_strength(ext_name):\n        \"\"\"Calculates the strength of a single extension string.\"\"\"\n        cap_count = 0\n        sm_count = 0\n        for char in ext_name:\n            if char.isupper():\n                cap_count += 1\n            elif char.islower():\n                sm_count += 1\n        return cap_count - sm_count\n\n    max_strength = float('-inf')\n    strongest_extension_name = \"\"\n\n    for extension in extensions:\n        current_strength = _calculate_strength(extension)\n\n        if current_strength > max_strength:\n            max_strength = current_strength\n            strongest_extension_name = extension\n        # If current_strength == max_strength, no update is needed due to the tie-breaking rule\n        # of choosing the one that comes first in the list, which is implicitly handled by iteration order.\n\n    return f\"{class_name}.{strongest_extension_name}\""}
{"task_id": "HumanEval/153", "solution": "def Strongest_Extension(class_name, extensions):\n    \"\"\"Finds the strongest extension based on CAP - SM strength and formats the output string.\"\"\"\n\n    def calculate_strength(extension_name):\n        \"\"\"Calculates the strength of a single extension name.\"\"\"\n        caps = 0\n        lowers = 0\n        for char in extension_name:\n            if char.isupper():\n                caps += 1\n            elif char.islower():\n                lowers += 1\n        return caps - lowers\n\n    max_strength = -float('inf')\n    strongest_extension_name = \"\"\n\n    for extension in extensions:\n        current_strength = calculate_strength(extension)\n        # If the current strength is greater, or if it's equal but we prefer the first occurrence,\n        # we update the strongest extension. The `>` operator naturally handles tie-breaking\n        # by preserving the first encountered extension if strengths are equal.\n        if current_strength > max_strength:\n            max_strength = current_strength\n            strongest_extension_name = extension\n\n    return f\"{class_name}.{strongest_extension_name}\""}
{"task_id": "HumanEval/154", "solution": "def cycpattern_check(a , b):\n    \"\"\"\n    Checks if the second word or any of its cyclic rotations is a substring in the first word.\n    \"\"\"\n    if not b:  # If pattern 'b' is empty, it is considered a substring of any string 'a'.\n        return True\n\n    if len(b) > len(a):  # A string cannot contain a substring longer than itself.\n        return False\n\n    # Generate all cyclic rotations of 'b' and check if any is a substring of 'a'.\n    # The 'b + b' trick implicitly contains all rotations of 'b' as substrings of length len(b).\n    # We check if any of these rotations exist in 'a'.\n    # This can be done by iterating through rotations, or by checking 'b' itself within a doubled 'a'.\n    # A simpler way is to check all rotations of 'b' directly in 'a'.\n    \n    # Concatenate 'a' with itself to check for cyclic patterns spanning the boundary.\n    # No, the problem asks if 'b' OR ANY OF ITS ROTATIONS is a substring of 'a'.\n    # This means we need to find if any 'rotated_b' is present in 'a'.\n    # The 'a + a' trick is for checking if 'b' is a rotation of 'a', not the other way around.\n    \n    # Correct logic: iterate through rotations of 'b' and check 'in a'.\n    len_b = len(b)\n    for i in range(len_b):\n        rotated_b = b[i:] + b[:i]\n        if rotated_b in a:\n            return True\n            \n    return False"}
{"task_id": "HumanEval/154", "solution": "def cycpattern_check(a , b):\n    \"\"\"You are given 2 words. You need to return True if the second word or any of its rotations is a substring in the first word\n    cycpattern_check(\"abcd\",\"abd\") => False\n    cycpattern_check(\"hello\",\"ell\") => True\n    cycpattern_check(\"whassup\",\"psus\") => False\n    cycpattern_check(\"abab\",\"baa\") => True\n    cycpattern_check(\"efef\",\"eeff\") => False\n    cycpattern_check(\"himenss\",\"simen\") => True\n\n    \"\"\"\n    # Normalize inputs to lowercase as per design's default normalization.\n    a_lower = a.lower()\n    b_lower = b.lower()\n\n    # Handle empty pattern: if the pattern is empty, no meaningful rotation exists, return False.\n    if not b_lower:\n        return False\n\n    # Generate all cyclic rotations of the pattern string.\n    rotations = []\n    n = len(b_lower)\n    for i in range(n):\n        rotated_b = b_lower[i:] + b_lower[:i]\n        rotations.append(rotated_b)\n\n    # Check if any generated rotation is a substring within the normalized text.\n    for rotation in rotations:\n        if rotation in a_lower:\n            return True\n\n    # If no rotation is found as a substring, return False.\n    return False"}
