{"task_id": "HumanEval/6", "solution": "from typing import List\n\n\ndef parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\" Input to this function is a string represented multiple groups for nested parentheses separated by spaces.\n    For each of the group, output the deepest level of nesting of parentheses.\n    E.g. (()()) has maximum two levels of nesting while ((())) has three.\n\n    >>> parse_nested_parens('(()()) ((())) () ((())()())')\n    [2, 3, 1, 3]\n    \"\"\"\n\n    class ParenGroup:\n        \"\"\"Represents a single group of parentheses with its raw string and index.\"\"\"\n        def __init__(self, raw: str, index: int):\n            self.raw = raw\n            self.index = index\n\n        def is_empty(self) -> bool:\n            \"\"\"Checks if the raw group string is empty.\"\"\"\n            return not self.raw\n\n    class ParserError(Exception):\n        \"\"\"Custom exception for parsing errors within a parentheses group.\"\"\"\n        def __init__(self, message: str, group: ParenGroup = None):\n            super().__init__(message)\n            self.message = message\n            self.group = group\n\n        def __str__(self):\n            group_info = \"\"\n            if self.group:\n                group_info = f\" (group_index={self.group.index}, raw='{self.group.raw}')\"\n            return f\"{self.message}{group_info}\"\n\n    class Parser:\n        \"\"\"Calculates the maximum nesting depth for a single parentheses group.\"\"\"\n        allowed_chars = \"()\"\n\n        def parse(self, group: ParenGroup) -> int:\n            \"\"\"Parses a ParenGroup to determine its deepest nesting level.\"\"\"\n            current_depth = 0\n            max_depth = 0\n            for ch in group.raw:\n                if ch == \"(\":\n                    current_depth += 1\n                    if current_depth > max_depth:\n                        max_depth = current_depth\n                elif ch == \")\":\n                    current_depth -= 1\n                    if current_depth < 0:\n                        raise ParserError(\"Unbalanced: too many closing parens\", group)\n                else:\n                    raise ParserError(f\"Invalid character '{ch}'\", group)\n            \n            if current_depth != 0:\n                raise ParserError(\"Unbalanced: too many opening parens\", group)\n            \n            return max_depth\n\n    class ParenService:\n        \"\"\"Manages the parsing of multiple parentheses groups from an input string.\"\"\"\n        def __init__(self, parser: Parser):\n            self._parser = parser\n\n        def _split_groups(self, input_str: str) -> List[ParenGroup]:\n            \"\"\"Splits the input string into ParenGroup objects, filtering out empty parts.\"\"\"\n            parts = input_str.split()\n            return [ParenGroup(raw=p, index=i) for i, p in enumerate(parts) if p]\n\n        def parse_input(self, input_str: str) -> List[int]:\n            \"\"\"Processes an input string containing multiple groups and returns their max depths.\"\"\"\n            groups = self._split_groups(input_str)\n            results = []\n            for g in groups:\n                results.append(self._parser.parse(g))\n            return results\n\n    # Instantiate the parser and service, then parse the input string.\n    parser_instance = Parser()\n    service_instance = ParenService(parser_instance)\n    return service_instance.parse_input(paren_string)"}
