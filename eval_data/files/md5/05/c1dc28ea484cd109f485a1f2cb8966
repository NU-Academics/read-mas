{"task_id": "HumanEval/24", "solution": "import math\n\ndef largest_divisor(n: int) -> int:\n    \"\"\" For a given number n, find the largest number that divides n evenly, smaller than n\n    >>> largest_divisor(15)\n    5\n    \"\"\"\n    if n <= 3:\n        return 1\n    \n    largest = 1\n    # Iterate from 1 up to the square root of n\n    # If i divides n, then n/i also divides n.\n    # We want the largest divisor smaller than n.\n    r = int(math.isqrt(n))\n    for i in range(1, r + 1):\n        if n % i == 0:\n            # i is a divisor\n            j = n // i # j is the corresponding co-divisor\n            \n            # Check i if it's a proper divisor and larger than current largest\n            if i != n and i > largest:\n                largest = i\n            \n            # Check j if it's a proper divisor and larger than current largest\n            if j != n and j > largest:\n                largest = j\n    return largest"}
{"task_id": "HumanEval/57", "solution": "def monotonic(l: list):\n    if len(l) <= 1:\n        return True\n\n    is_non_decreasing = True\n    is_non_increasing = True\n\n    for i in range(len(l) - 1):\n        if l[i] > l[i+1]:\n            is_non_decreasing = False\n        if l[i] < l[i+1]:\n            is_non_increasing = False\n\n    return is_non_decreasing or is_non_increasing"}
{"task_id": "HumanEval/43", "solution": "def pairs_sum_to_zero(l):\n    \"\"\"\n    Checks if there are two distinct elements in the list that sum to zero.\n    Uses a set for efficient lookup and handles multiple zeros correctly.\n    \"\"\"\n    if len(l) < 2:\n        return False\n\n    seen_numbers = set()\n    zero_count = 0\n    for num in l:\n        if num == 0:\n            zero_count += 1\n            if zero_count >= 2:\n                return True\n        else:\n            # For any non-zero number 'num', check if its negative counterpart '-num'\n            # has been seen before. If so, they form a pair that sums to zero.\n            if -num in seen_numbers:\n                return True\n            seen_numbers.add(num)\n            \n    return False"}
{"task_id": "HumanEval/46", "solution": "def fib4(n: int):\n    \"\"\"Computes the n-th element of the Fib4 number sequence using an iterative approach.\n    Handles base cases directly and iteratively calculates subsequent numbers.\n    \"\"\"\n    if n == 0:\n        return 0\n    elif n == 1:\n        return 0\n    elif n == 2:\n        return 2\n    elif n == 3:\n        return 0\n\n    # Initialize the last four Fib4 numbers: fib4(n-4), fib4(n-3), fib4(n-2), fib4(n-1)\n    # For n=4, these would correspond to fib4(0), fib4(1), fib4(2), fib4(3)\n    a, b, c, d = 0, 0, 2, 0  # fib4(0), fib4(1), fib4(2), fib4(3)\n\n    for _ in range(4, n + 1):\n        next_fib = d + c + b + a\n        a, b, c, d = b, c, d, next_fib\n    \n    return d"}
{"task_id": "HumanEval/16", "solution": "import unicodedata\n\ndef count_distinct_characters(string: str) -> int:\n    \"\"\" Given a string, find out how many distinct characters (regardless of case) does it consist of\n    \"\"\"\n    normalized_string = unicodedata.normalize(\"NFKC\", string).strip().casefold()\n    distinct_characters = set(normalized_string)\n    return len(distinct_characters)"}
{"task_id": "HumanEval/68", "solution": "def pluck(arr):\n    \"\"\"\n    Finds the smallest even number and its first index in a list.\n    Returns [value, index] or [] if no even number is found.\n    \"\"\"\n    smallest_value = None\n    smallest_index = -1\n\n    for i, v in enumerate(arr):\n        if v % 2 == 0:  # Check if the value is even\n            if smallest_value is None or v < smallest_value:\n                smallest_value = v\n                smallest_index = i\n\n    if smallest_value is None:\n        return []\n    return [smallest_value, smallest_index]"}
{"task_id": "HumanEval/69", "solution": "def search(lst):\n    \"\"\"\n    Returns the greatest integer v > 0 such that its frequency in the list is >= v.\n    Returns -1 if no such integer exists.\n    \"\"\"\n    counts = {}\n    for x in lst:\n        counts[x] = counts.get(x, 0) + 1\n\n    candidates = []\n    for value, frequency in counts.items():\n        if frequency >= value:\n            candidates.append(value)\n\n    if not candidates:\n        return -1\n    return max(candidates)"}
{"task_id": "HumanEval/72", "solution": "def will_it_fly(q,w):\n    \"\"\"\n    Checks if object q will fly based on two conditions:\n    1. q must be a palindromic list.\n    2. The sum of q's elements must be less than or equal to w.\n    \"\"\"\n    is_balanced = (q == q[::-1])\n    sum_within_limit = (sum(q) <= w)\n    \n    return is_balanced and sum_within_limit"}
{"task_id": "HumanEval/75", "solution": "def is_multiply_prime(a):\n    \"\"\"Write a function that returns true if the given number is the multiplication of 3 prime numbers\n    and false otherwise.\n    Knowing that (a) is less then 100.\n    Example:\n    is_multiply_prime(30) == True\n    30 = 2 * 3 * 5\n    \"\"\"\n    if a <= 1:\n        return False\n\n    factors = []\n    temp_a = a\n    d = 2\n\n    while d * d <= temp_a:\n        while temp_a % d == 0:\n            factors.append(d)\n            temp_a //= d\n        d += 1\n        if d > 2 and d % 2 == 0:\n            d += 1\n\n    if temp_a > 1:\n        factors.append(temp_a)\n\n    return len(factors) == 3"}
