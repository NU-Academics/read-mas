{"task_id": "HumanEval/81", "solution": "_GRADE_THRESHOLDS = [\n    (3.7, \"A\"),\n    (3.3, \"A-\"),\n    (3.0, \"B+\"),\n    (2.7, \"B\"),\n    (2.3, \"B-\"),\n    (2.0, \"C+\"),\n    (1.7, \"C\"),\n    (1.3, \"C-\"),\n    (1.0, \"D+\"),\n    (0.7, \"D\"),\n    (0.0, \"D-\"),\n]\n\ndef numerical_letter_grade(grades):\n    \"\"\"\n    Maps a list of numerical GPAs to their corresponding letter grades.\n    \"\"\"\n    letter_grades = []\n    for gpa in grades:\n        if gpa == 4.0:\n            letter_grades.append(\"A+\")\n        else:\n            found_grade = False\n            for threshold, grade in _GRADE_THRESHOLDS:\n                if gpa > threshold:\n                    letter_grades.append(grade)\n                    found_grade = True\n                    break\n            if not found_grade:\n                # If no threshold was strictly greater, it must be 0.0\n                letter_grades.append(\"E\")\n    return letter_grades"}
{"task_id": "HumanEval/81", "solution": "def numerical_letter_grade(grades):\n    \"\"\"It is the last week of the semester and the teacher has to give the grades\n    to students. The teacher has been making her own algorithm for grading.\n    The only problem is, she has lost the code she used for grading.\n    She has given you a list of GPAs for some students and you have to write \n    a function that can output a list of letter grades using the following table:\n             GPA       |    Letter grade\n              4.0                A+\n            > 3.7                A \n            > 3.3                A- \n            > 3.0                B+\n            > 2.7                B \n            > 2.3                B-\n            > 2.0                C+\n            > 1.7                C\n            > 1.3                C-\n            > 1.0                D+ \n            > 0.7                D \n            > 0.0                D-\n              0.0                E\n    \n\n    Example:\n    grade_equation([4.0, 3, 1.7, 2, 3.5]) ==> ['A+', 'B', 'C-', 'C', 'A-']\n    \"\"\"\n    result = []\n    for gpa in grades:\n        if gpa == 4.0:\n            result.append(\"A+\")\n        elif gpa > 3.7:\n            result.append(\"A\")\n        elif gpa > 3.3:\n            result.append(\"A-\")\n        elif gpa > 3.0:\n            result.append(\"B+\")\n        elif gpa > 2.7:\n            result.append(\"B\")\n        elif gpa > 2.3:\n            result.append(\"B-\")\n        elif gpa > 2.0:\n            result.append(\"C+\")\n        elif gpa > 1.7:\n            result.append(\"C\")\n        elif gpa > 1.3:\n            result.append(\"C-\")\n        elif gpa > 1.0:\n            result.append(\"D+\")\n        elif gpa > 0.7:\n            result.append(\"D\")\n        elif gpa > 0.0:\n            result.append(\"D-\")\n        elif gpa == 0.0:\n            result.append(\"E\")\n    return result"}
{"task_id": "HumanEval/82", "solution": "def prime_length(string):\n    \"\"\"\n    Checks if the length of a given string is a prime number.\n    Returns True if the length is prime, False otherwise.\n    \"\"\"\n    length = len(string)\n\n    if length < 2:\n        return False\n    if length == 2 or length == 3:\n        return True\n    if length % 2 == 0 or length % 3 == 0:\n        return False\n\n    i = 5\n    while i * i <= length:\n        if length % i == 0 or length % (i + 2) == 0:\n            return False\n        i += 6\n    return True"}
{"task_id": "HumanEval/82", "solution": "def prime_length(string):\n    \"\"\"\n    Checks if the length of the given string is a prime number.\n    \"\"\"\n    n = len(string)\n\n    if n < 2:\n        return False\n    if n in (2, 3):\n        return True\n    if n % 2 == 0:\n        return False\n    \n    i = 3\n    while i * i <= n:\n        if n % i == 0:\n            return False\n        i += 2\n    return True"}
{"task_id": "HumanEval/83", "solution": "def starts_one_ends(n):\n    \"\"\"\n    Given a positive integer n, return the count of the numbers of n-digit\n    positive integers that start or end with 1.\n    \"\"\"\n    if n == 1:\n        return 1\n    # For n >= 2, the count is 18 * 10^(n-2)\n    return 18 * (10 ** (n - 2))"}
{"task_id": "HumanEval/83", "solution": "def starts_one_ends(n):\n    \"\"\"\n    Given a positive integer n, return the count of the numbers of n-digit\n    positive integers that start or end with 1.\n    \"\"\"\n    if n == 1:\n        # For n=1, the only 1-digit number that starts or ends with 1 is '1'.\n        # count_first = 1 (number '1')\n        # count_last = 1 (number '1')\n        # intersection = 1 (number '1')\n        count_first = 1\n        count_last = 1\n        intersection = 1\n    else:\n        # Count of n-digit numbers that start with 1:\n        # The first digit is 1. The remaining (n-1) digits can be any of 0-9.\n        count_first = 10 ** (n - 1)\n\n        # Count of n-digit numbers that end with 1:\n        # The last digit is 1. The first digit can be any of 1-9 (9 options).\n        # The (n-2) middle digits can be any of 0-9 (10 options each).\n        count_last = 9 * (10 ** (n - 2))\n\n        # Count of n-digit numbers that start with 1 AND end with 1 (intersection):\n        # The first digit is 1, the last digit is 1.\n        # The (n-2) middle digits can be any of 0-9 (10 options each).\n        intersection = 10 ** (n - 2)\n\n    # Apply the principle of inclusion-exclusion:\n    # P(starts with 1 OR ends with 1) = P(starts with 1) + P(ends with 1) - P(starts AND ends with 1)\n    return count_first + count_last - intersection"}
{"task_id": "HumanEval/84", "solution": "class InvalidInputError(Exception):\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\nDEFAULT_MIN = 0\nDEFAULT_MAX = 10000\n\nclass Validator:\n    @staticmethod\n    def is_int_in_range(n: int, min_value: int, max_value: int) -> bool:\n        return isinstance(n, int) and min_value <= n <= max_value\n\nclass InputAdapter:\n    def parse_int(self, value) -> int:\n        try:\n            parsed = int(value)\n        except Exception:\n            raise InvalidInputError(f\"Value '{value}' is not an integer\")\n        if not Validator.is_int_in_range(parsed, DEFAULT_MIN, DEFAULT_MAX):\n            raise InvalidInputError(f\"Integer {parsed} out of allowed range [{DEFAULT_MIN}, {DEFAULT_MAX}]\")\n        return parsed\n\nclass DigitSumResult:\n    def __init__(self, value: int, binary: str) -> None:\n        self.value = value\n        self.binary = binary\n\n    def to_dict(self) -> dict:\n        return {\"value\": self.value, \"binary\": self.binary}\n\nclass DigitService:\n    def sum_digits(self, n: int) -> int:\n        \"\"\"Sums the decimal digits of a non-negative integer n.\"\"\"\n        return sum(int(ch) for ch in str(n))\n\n    def to_binary_string(self, n: int) -> str:\n        \"\"\"Converts a non-negative integer n to its binary string representation.\"\"\"\n        return format(n, \"b\")\n\n    def compute(self, n: int) -> DigitSumResult:\n        s = self.sum_digits(n)\n        b = self.to_binary_string(s)\n        return DigitSumResult(value=s, binary=b)\n\nclass SolutionController:\n    def __init__(self):\n        self.adapter = InputAdapter()\n        self.service = DigitService()\n\n    def solve(self, N) -> str:\n        \"\"\"Orchestrates parsing, validation, and service invocation for the API.\"\"\"\n        parsed = self.adapter.parse_int(N)\n        result = self.service.compute(parsed)\n        return result.binary\n\ndef solve(N):\n    \"\"\"Given a positive integer N, return the total sum of its digits in binary.\n    \n    Example\n        For N = 1000, the sum of digits will be 1 the output should be \"1\".\n        For N = 150, the sum of digits will be 6 the output should be \"110\".\n        For N = 147, the sum of digits will be 12 the output should be \"1100\".\n    \n    Variables:\n        @N integer\n             Constraints: 0 \u2264 N \u2264 10000.\n    Output:\n         a string of binary number\n    \"\"\"\n    # Delegates the request to the SolutionController for processing.\n    return SolutionController().solve(N)"}
{"task_id": "HumanEval/84", "solution": "def solve(N):\n    \"\"\"Given a positive integer N, return the total sum of its digits in binary.\"\"\"\n    \n    # Calculate the sum of decimal digits of N\n    digit_sum = 0\n    if N == 0:\n        digit_sum = 0\n    else:\n        temp_N = N\n        while temp_N > 0:\n            digit_sum += temp_N % 10\n            temp_N //= 10\n            \n    # Convert the decimal sum to a binary string\n    if digit_sum == 0:\n        return \"0\"\n    return bin(digit_sum)[2:]"}
