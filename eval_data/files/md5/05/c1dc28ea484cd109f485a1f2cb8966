{"task_id": "HumanEval/43", "solution": "def pairs_sum_to_zero(l):\n    \"\"\"\n    Checks if there are two distinct elements in the list that sum to zero.\n    Uses a set for efficient lookups, handling the special case of zero.\n    \"\"\"\n    seen_numbers = set()\n    for num in l:\n        # If num is 0, we need to ensure there's another 0 already seen\n        if num == 0:\n            if 0 in seen_numbers:\n                return True\n        # For non-zero numbers, check if its negative complement exists\n        elif -num in seen_numbers:\n            return True\n        seen_numbers.add(num)\n    return False"}
{"task_id": "HumanEval/44", "solution": "def change_base(x: int, base: int):\n    \"\"\"Change numerical base of input number x to base.\n    return string representation after the conversion.\n    base numbers are less than 10.\n    >>> change_base(8, 3)\n    '22'\n    >>> change_base(8, 2)\n    '1000'\n    >>> change_base(7, 2)\n    '111'\n    \"\"\"\n    if x == 0:\n        return \"0\"\n    \n    digits = []\n    while x > 0:\n        digits.append(str(x % base))\n        x //= base\n        \n    return \"\".join(reversed(digits))"}
{"task_id": "HumanEval/44", "solution": "def change_base(x: int, base: int):\n    \"\"\"Change numerical base of input number x to base.\n    Returns string representation after the conversion.\n    \"\"\"\n    if x == 0:\n        return \"0\"\n\n    is_negative = x < 0\n    n = -x if is_negative else x\n    \n    digits = []\n    while n > 0:\n        digits.append(str(n % base))\n        n //= base\n    \n    result = \"\".join(reversed(digits))\n    return \"-\" + result if is_negative else result"}
