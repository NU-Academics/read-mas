{"task_id": "HumanEval/120", "solution": "import heapq\n\ndef maximum(arr, k):\n    \"\"\"\n    Returns a sorted list of length k with the maximum k numbers in arr.\n    \"\"\"\n    if k == 0:\n        return []\n    if k >= len(arr):\n        return sorted(arr)\n    \n    # Use heapq.nlargest to get the k largest elements, then sort them.\n    top_k = heapq.nlargest(k, arr)\n    return sorted(top_k)"}
{"task_id": "HumanEval/120", "solution": "import heapq\nfrom typing import List\n\ndef maximum(arr: List[int], k: int) -> List[int]:\n    \"\"\"\n    Returns a sorted list of length k with the maximum k numbers in arr.\n    Uses heapq.nlargest for efficient selection and sorts the result.\n    \"\"\"\n    if k == 0:\n        return []\n    \n    # Use heapq.nlargest to get the k largest elements (returns them in descending order).\n    top_k_elements = heapq.nlargest(k, arr)\n    \n    # Sort the selected elements in ascending order as required by the problem statement.\n    return sorted(top_k_elements)"}
{"task_id": "HumanEval/121", "solution": "def solution(lst):\n    \"\"\"Given a non-empty list of integers, return the sum of all of the odd elements that are in even positions.\"\"\"\n    \n    total_sum = 0\n    for idx, val in enumerate(lst):\n        # Check if the current position (index) is even\n        # and if the element at that position is odd.\n        if idx % 2 == 0 and val % 2 != 0:\n            total_sum += val\n    return total_sum"}
{"task_id": "HumanEval/122", "solution": "def add_elements(arr, k):\n    \"\"\"\n    Calculates the sum of elements with at most two digits from the first k elements of arr.\n    An element has at most two digits if its absolute value is less than or equal to 99.\n    \"\"\"\n    total_sum = 0\n    for i in range(min(k, len(arr))):  # Iterate up to k elements, or end of array if k is larger\n        element = arr[i]\n        if -99 <= element <= 99:  # Check if element has at most two digits (absolute value <= 99)\n            total_sum += element\n    return total_sum"}
{"task_id": "HumanEval/123", "solution": "def get_odd_collatz(n):\n    \"\"\"\n    Given a positive integer n, return a sorted list that has the odd numbers in collatz sequence.\n    \"\"\"\n    odd_numbers = set()\n    current_n = n\n\n    while current_n != 1:\n        if current_n % 2 != 0:\n            odd_numbers.add(current_n)\n        \n        if current_n % 2 == 0:\n            current_n = current_n // 2\n        else:\n            current_n = 3 * current_n + 1\n    \n    odd_numbers.add(1) # The sequence always reaches 1, which is odd.\n    \n    return sorted(list(odd_numbers))"}
{"task_id": "HumanEval/122", "solution": "def add_elements(arr, k):\n    \"\"\"\n    Given a non-empty array of integers arr and an integer k, return\n    the sum of the elements with at most two digits from the first k elements of arr.\n    \"\"\"\n    total_sum = 0\n    # Iterate through the first k elements of the array.\n    for i in range(k):\n        num = arr[i]\n        # Check if the absolute value of the number has at most two digits (0-99).\n        if -99 <= num <= 99:\n            total_sum += num\n    return total_sum"}
{"task_id": "HumanEval/123", "solution": "def get_odd_collatz(n):\n    \"\"\"\n    Given a positive integer n, return a sorted list that has the odd numbers in collatz sequence.\n    \"\"\"\n    odd_numbers = set()\n    current_num = n\n    while True:\n        if current_num % 2 != 0:\n            odd_numbers.add(current_num)\n\n        if current_num == 1:\n            break\n        \n        if current_num % 2 == 0:\n            current_num = current_num // 2\n        else:\n            current_num = 3 * current_num + 1\n            \n    return sorted(list(odd_numbers))"}
{"task_id": "HumanEval/124", "solution": "import re\n\ndef valid_date(date):\n    \"\"\"Validates a given date string according to specific rules and format.\n\n    The date must be non-empty, in 'mm-dd-yyyy' format, with valid month (1-12)\n    and day ranges specific to each month (e.g., Feb max 29 days).\n    \"\"\"\n    # Rule 1: The date string is not empty.\n    if not date:\n        return False\n\n    # Rule 4: The date should be in the format: mm-dd-yyyy\n    # This regex ensures exactly two digits for month/day and four for year,\n    # separated by hyphens. It also implicitly handles non-numeric characters\n    # and incorrect separators.\n    date_pattern = r\"^\\d{2}-\\d{2}-\\d{4}$\"\n    if not re.match(date_pattern, date):\n        return False\n\n    # Split the string into components, which are guaranteed to be valid digit strings by the regex.\n    month_str, day_str, year_str = date.split('-')\n    month = int(month_str)\n    day = int(day_str)\n    # Year itself has no specific range rules beyond being a 4-digit number.\n    # year = int(year_str) # Not strictly needed for logic if no year-based validation (like leap years)\n\n    # Rule 3: The months should not be less than 1 or higher than 12.\n    if not (1 <= month <= 12):\n        return False\n\n    # Rule 2: Validate days based on month.\n    # Months with 31 days\n    if month in {1, 3, 5, 7, 8, 10, 12}:\n        if not (1 <= day <= 31):\n            return False\n    # Months with 30 days\n    elif month in {4, 6, 9, 11}:\n        if not (1 <= day <= 30):\n            return False\n    # February (month 2)\n    elif month == 2:\n        # Per design, leap-year checks are not required; Feb allows up to 29 days.\n        if not (1 <= day <= 29):\n            return False\n    # This 'else' case should theoretically not be reached due to Rule 3 check,\n    # but serves as a defensive measure.\n    else:\n        return False\n\n    # If all checks pass, the date is valid.\n    return True"}
{"task_id": "HumanEval/124", "solution": "def valid_date(date):\n    \"\"\"\n    Validates a given date string based on format, month, and day rules.\n    \"\"\"\n    if not date:\n        return False\n\n    parts = date.split('-')\n    if len(parts) != 3:\n        return False\n\n    try:\n        month = int(parts[0])\n        day = int(parts[1])\n        year = int(parts[2])\n    except ValueError:\n        return False\n\n    # Rule 3: The months should not be less than 1 or higher than 12.\n    if not (1 <= month <= 12):\n        return False\n\n    # Rule 2: The number of days is not less than 1.\n    if day < 1:\n        return False\n\n    # Determine maximum days for the month\n    if month in [1, 3, 5, 7, 8, 10, 12]:\n        max_days = 31\n    elif month in [4, 6, 9, 11]:\n        max_days = 30\n    elif month == 2:\n        max_days = 29  # Explicitly 29 for February, no leap year calculation\n    else:\n        # This case should ideally not be reached due to the month check above\n        # but provides a fallback for robustness, or could indicate an issue.\n        return False\n\n    # Rule 2: The number of days is not higher than max_days for the month.\n    if day > max_days:\n        return False\n\n    return True"}
{"task_id": "HumanEval/125", "solution": "def split_words(txt):\n    \"\"\"\n    Splits a string by whitespace, then by commas, or counts odd-ordered lowercase letters.\n    \"\"\"\n    whitespace_present = False\n    for char in txt:\n        if char.isspace():\n            whitespace_present = True\n            break\n\n    if whitespace_present:\n        return txt.split()\n\n    if \",\" in txt:\n        return [t.strip() for t in txt.split(\",\")]\n\n    count = 0\n    ASCII_LOWER_START = ord('a')\n\n    for char in txt:\n        o = ord(char)\n        if ASCII_LOWER_START <= o <= ord('z'):\n            alphabet_order = o - ASCII_LOWER_START\n            if (alphabet_order % 2) == 1:\n                count += 1\n    return count"}
{"task_id": "HumanEval/125", "solution": "import re\n\ndef split_words(txt):\n    '''\n    Given a string of words, return a list of words split on whitespace, if no whitespaces exists in the text you\n    should split on commas ',' if no commas exists you should return the number of lower-case letters with odd order in the\n    alphabet, ord('a') = 0, ord('b') = 1, ... ord('z') = 25\n    '''\n    \n    if re.search(r\"\\s\", txt):\n        return re.split(r\"\\s+\", txt.strip())\n    \n    if \",\" in txt:\n        return [token.strip() for token in txt.split(\",\")]\n    \n    # No whitespace and no commas, count odd-order lowercase letters\n    count = 0\n    for char in txt:\n        if 'a' <= char <= 'z':\n            if (ord(char) - ord('a')) % 2 == 1:\n                count += 1\n    return count"}
{"task_id": "HumanEval/126", "solution": "def is_sorted(lst):\n    # An empty list or a list with a single element is considered sorted.\n    if len(lst) <= 1:\n        return True\n\n    # Use a dictionary to count occurrences of each number.\n    # The problem states \"If list has more than 1 duplicate of the same\n    # number, return False.\" This means any number can appear at most twice.\n    counts = {}\n\n    # Initialize prev with the first element and its count.\n    prev = lst[0]\n    counts[prev] = 1\n\n    # Iterate from the second element to check both sortedness and duplicate limits.\n    for i in range(1, len(lst)):\n        current = lst[i]\n\n        # Check if the list is sorted in ascending order.\n        if current < prev:\n            return False\n\n        # Update the count for the current number.\n        counts[current] = counts.get(current, 0) + 1\n\n        # Check if any number appears more than twice (i.e., has more than 1 duplicate).\n        if counts[current] > 2:\n            return False\n\n        # Update prev for the next iteration.\n        prev = current\n\n    # If all checks pass, the list is sorted and meets the duplicate criteria.\n    return True"}
{"task_id": "HumanEval/126", "solution": "def is_sorted(lst):\n    # Check for duplicate frequency: no number may appear more than twice.\n    counts = {}\n    for num in lst:\n        counts[num] = counts.get(num, 0) + 1\n        if counts[num] > 2:\n            return False\n\n    # Check for ascending (non-decreasing) order.\n    # Empty lists and single-element lists are considered sorted.\n    for i in range(len(lst) - 1):\n        if lst[i] > lst[i+1]:\n            return False\n\n    return True"}
{"task_id": "HumanEval/127", "solution": "def intersection(interval1, interval2):\n    \"\"\"\n    Determines if the length of the intersection of two closed intervals is a prime number.\n    Returns \"YES\" if prime, \"NO\" otherwise or if intervals don't intersect.\n    \"\"\"\n\n    def is_prime(n: int) -> bool:\n        \"\"\"Checks if a given non-negative integer is a prime number.\"\"\"\n        if n < 2:\n            return False\n        if n == 2 or n == 3:\n            return True\n        if n % 2 == 0 or n % 3 == 0:\n            return False\n        i = 5\n        while i * i <= n:\n            if n % i == 0 or n % (i + 2) == 0:\n                return False\n            i += 6\n        return True\n\n    start1, end1 = interval1\n    start2, end2 = interval2\n\n    # Calculate the start and end of the intersection\n    inter_start = max(start1, start2)\n    inter_end = min(end1, end2)\n\n    # If the intersection is empty (start > end), return \"NO\"\n    if inter_start > inter_end:\n        return \"NO\"\n\n    # Calculate the length of the intersection\n    # As per example (2,3) length is 1, so it's end - start\n    intersection_length = inter_end - inter_start\n\n    # Check if the length is a prime number\n    if is_prime(intersection_length):\n        return \"YES\"\n    else:\n        return \"NO\""}
{"task_id": "HumanEval/127", "solution": "def intersection(interval1, interval2):\n    \"\"\"\n    Determines if the length of the intersection of two intervals is a prime number.\n    Returns \"YES\" if prime, \"NO\" otherwise, or if intervals don't intersect.\n    \"\"\"\n\n    class PrimeUtils:\n        @staticmethod\n        def is_prime(n: int) -> bool:\n            if n <= 1:\n                return False\n            if n <= 3:\n                return True\n            if n % 2 == 0 or n % 3 == 0:\n                return False\n            i = 5\n            while i * i <= n:\n                if n % i == 0 or n % (i + 2) == 0:\n                    return False\n                i += 6\n            return True\n\n    # Calculate the start and end of the intersection\n    # max(start1, start2) determines the later start point\n    # min(end1, end2) determines the earlier end point\n    intersection_start = max(interval1[0], interval2[0])\n    intersection_end = min(interval1[1], interval2[1])\n\n    # If intersection_start is greater than intersection_end, the intervals do not overlap.\n    # In this case, the length of the intersection is considered 0.\n    if intersection_start > intersection_end:\n        length = 0\n    else:\n        # The length of the intersection (inclusive endpoints) is end - start.\n        # Example (2,3) length is 1 as per problem description.\n        length = intersection_end - intersection_start\n\n    if PrimeUtils.is_prime(length):\n        return \"YES\"\n    else:\n        return \"NO\""}
{"task_id": "HumanEval/128", "solution": "def prod_signs(arr):\n    \"\"\"\n    You are given an array arr of integers and you need to return\n    sum of magnitudes of integers multiplied by product of all signs\n    of each number in the array, represented by 1, -1 or 0.\n    Note: return None for empty arr.\n    \"\"\"\n    if not arr:\n        return None\n\n    total_abs = 0\n    prod_sign = 1\n\n    for x in arr:\n        # Determine the sign of the current number\n        if x > 0:\n            current_sign = 1\n        elif x < 0:\n            current_sign = -1\n        else:  # x == 0\n            current_sign = 0\n\n        total_abs += abs(x)  # Accumulate the magnitude\n\n        # Update the product of signs\n        if current_sign == 0:\n            prod_sign = 0  # If any number is zero, the overall product of signs becomes zero\n        else:\n            prod_sign *= current_sign  # Otherwise, multiply by the current sign\n\n    return prod_sign * total_abs"}
{"task_id": "HumanEval/129", "solution": "def minPath(grid, k):\n    \"\"\"\n    Finds the lexicographically smallest path of length k in the grid.\n    A path of length k means visiting exactly k cells.\n    \"\"\"\n    N = len(grid)\n\n    def neighbor_coords(r, c, size):\n        # Returns a list of valid orthogonal neighbor coordinates (row, col) within the grid.\n        neighbors = []\n        for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):\n            nr, nc = r + dr, c + dc\n            if 0 <= nr < size and 0 <= nc < size:\n                neighbors.append((nr, nc))\n        return neighbors\n\n    # Step 1: Initialize for the first cell of the path (k=1)\n    # Find the overall minimum value in the grid and all its positions.\n    min_overall_val = float('inf')\n    initial_candidate_positions = set() # Stores (row, col) tuples\n\n    for r_idx in range(N):\n        for c_idx in range(N):\n            val = grid[r_idx][c_idx]\n            if val < min_overall_val:\n                min_overall_val = val\n                initial_candidate_positions = {(r_idx, c_idx)}\n            elif val == min_overall_val:\n                initial_candidate_positions.add((r_idx, c_idx))\n\n    # If k is 1, the path is simply the minimum value found.\n    if k == 1:\n        return [min_overall_val]\n\n    path_values = [min_overall_val]\n    # `current_candidate_positions` tracks all possible (row, col) cell positions\n    # that could be the end of a path prefix of length `len(path_values)`,\n    # where that prefix results in the lexicographically smallest sequence of values found so far.\n    current_candidate_positions = initial_candidate_positions\n\n    # Step 2 to k: Extend the path for k-1 more steps\n    for _ in range(1, k):\n        reachable_neighbors = set()\n        for r, c in current_candidate_positions:\n            reachable_neighbors.update(neighbor_coords(r, c, N))\n\n        # Find the minimum value among all cells reachable from the current candidate positions.\n        next_min_val = float('inf')\n        for r_n, c_n in reachable_neighbors:\n            next_min_val = min(next_min_val, grid[r_n][c_n])\n\n        path_values.append(next_min_val)\n\n        # Update `current_candidate_positions` to only include those\n        # neighbors that contain the `next_min_val`, as these are the only\n        # valid continuations for the lexicographically smallest path.\n        current_candidate_positions = {\n            (r_n, c_n) for r_n, c_n in reachable_neighbors if grid[r_n][c_n] == next_min_val\n        }\n\n    return path_values"}
{"task_id": "HumanEval/128", "solution": "def prod_signs(arr):\n    \"\"\"\n    Returns sum of magnitudes of integers multiplied by product of all signs.\n    Returns None for empty arr.\n    \"\"\"\n    if not arr:\n        return None\n\n    def _get_sign(num: int) -> int:\n        \"\"\"Returns the sign of a number: 1 for positive, -1 for negative, 0 for zero.\"\"\"\n        if num == 0:\n            return 0\n        return 1 if num > 0 else -1\n\n    product_of_signs = 1\n    sum_of_magnitudes = 0\n\n    for x in arr:\n        current_sign = _get_sign(x)\n        if current_sign == 0:\n            return 0  # If any number is zero, the overall product is zero.\n        product_of_signs *= current_sign\n        sum_of_magnitudes += abs(x)\n\n    return product_of_signs * sum_of_magnitudes"}
{"task_id": "HumanEval/131", "solution": "def digits(n):\n    \"\"\"Given a positive integer n, return the product of the odd digits.\n    Return 0 if all digits are even.\n    \"\"\"\n    if n == 0:\n        return 0\n\n    extracted_digits = []\n    temp_n = n\n    while temp_n > 0:\n        extracted_digits.append(temp_n % 10)\n        temp_n //= 10\n    \n    # Digits are extracted in reverse order, so we need to reverse the list.\n    # For this problem, the order of digits doesn't matter for product,\n    # but the design context implied a specific order from `digits_from_int`.\n    # However, for just filtering and product, the original reversed order is fine too.\n    # Let's stick to simple extraction and filtering.\n\n    product_of_odds = 1\n    found_odd = False\n\n    for digit in extracted_digits:\n        if digit % 2 == 1:\n            product_of_odds *= digit\n            found_odd = True\n            \n    if not found_odd:\n        return 0\n    \n    return product_of_odds"}
{"task_id": "HumanEval/129", "solution": "def minPath(grid, k):\n    \"\"\"\n    Finds the lexicographically minimum path of length k in the grid.\n    Starts at the cell containing the value 1 and at each step moves to an adjacent cell\n    with the smallest value.\n    \"\"\"\n    N = len(grid)\n    \n    # Find the starting position of the globally minimum value (which is 1)\n    start_row, start_col = -1, -1\n    for r in range(N):\n        for c in range(N):\n            if grid[r][c] == 1:\n                start_row, start_col = r, c\n                break\n        if start_row != -1:\n            break\n\n    current_row, current_col = start_row, start_col\n    path = []\n\n    # Directions for 4-way movement (up, down, left, right)\n    dr = [-1, 1, 0, 0]\n    dc = [0, 0, -1, 1]\n\n    while len(path) < k:\n        path.append(grid[current_row][current_col])\n\n        if len(path) == k:\n            break\n\n        min_neighbor_value = float('inf')\n        next_row, next_col = -1, -1\n\n        # Find the neighbor with the minimum value\n        for i in range(4):\n            nr, nc = current_row + dr[i], current_col + dc[i]\n\n            # Check if neighbor is within grid bounds\n            if 0 <= nr < N and 0 <= nc < N:\n                neighbor_value = grid[nr][nc]\n                if neighbor_value < min_neighbor_value:\n                    min_neighbor_value = neighbor_value\n                    next_row, next_col = nr, nc\n        \n        # Move to the chosen neighbor\n        current_row, current_col = next_row, next_col\n\n    return path"}
{"task_id": "HumanEval/130", "solution": "\"\"\"\nComputes the Tribonacci sequence up to the n-th term (0-indexed).\nThe sequence starts with tri(0)=1, tri(1)=3, and follows given recurrence rules.\n\"\"\"\n    # Initialize the sequence with the base values.\n    # tri(0) is inferred as 1 from the example output: tri(3) = [1, 3, 2, 8]\n    # tri(1) is given as 3.\n    trib = [1, 3]\n\n    # Handle edge cases for n=0 and n=1 directly.\n    if n == 0:\n        return trib[:1]\n    if n == 1:\n        return trib\n\n    # Determine the maximum index required for internal computation.\n    # If n is odd, tri(n) depends on tri(n+1), so we must compute up to n+1.\n    # Otherwise, we only need to compute up to n.\n    max_compute_index = n if n % 2 == 0 else n + 1\n\n    # Pre-allocate space for the sequence, filling with zeros as placeholders.\n    # We already have elements for index 0 and 1.\n    while len(trib) <= max_compute_index:\n        trib.append(0)\n\n    # First pass: Compute all even-indexed terms (for i >= 2).\n    # These terms can be calculated independently.\n    for i in range(2, max_compute_index + 1, 2):\n        trib[i] = 1 + i // 2\n\n    # Second pass: Compute all odd-indexed terms (for i >= 3).\n    # These terms depend on already computed previous odd and even terms.\n    for i in range(3, max_compute_index + 1, 2):\n        trib[i] = trib[i - 1] + trib[i - 2] + trib[i + 1]\n\n    # Return the sequence up to the requested n-th term (inclusive).\n    return trib[:n + 1]"}
{"task_id": "HumanEval/130", "solution": "def tri(n):\n    \"\"\"\n    Computes the first n+1 numbers of the Tribonacci sequence using memoization.\n    \"\"\"\n    memo = {}\n\n    def _get_tribonacci_value(k):\n        \"\"\"\n        Calculates tri(k) recursively, storing results in `memo` to avoid recomputation.\n        \"\"\"\n        if k in memo:\n            return memo[k]\n\n        if k == 0:\n            value = 1\n        elif k == 1:\n            value = 3\n        elif k % 2 == 0:  # n is even\n            value = 1 + (k // 2)\n        else:  # n is odd\n            value = _get_tribonacci_value(k - 1) + _get_tribonacci_value(k - 2) + _get_tribonacci_value(k + 1)\n        \n        memo[k] = value\n        return value\n\n    result_sequence = []\n    for i in range(n + 1):\n        result_sequence.append(_get_tribonacci_value(i))\n\n    return result_sequence"}
{"task_id": "HumanEval/131", "solution": "def digits(n):\n    \"\"\"Given a positive integer n, return the product of the odd digits.\n    Return 0 if all digits are even.\"\"\"\n    product = 1\n    found_odd = False\n\n    for digit_char in str(n):\n        digit = int(digit_char)\n        if digit % 2 != 0:  # Check if the digit is odd\n            product *= digit\n            found_odd = True\n\n    if not found_odd:\n        return 0\n    else:\n        return product"}
