{"task_id": "HumanEval/0", "solution": "# threshold_checker/checker.py\nfrom __future__ import annotations\nfrom typing import Sequence\n\n\nclass ThresholdChecker:\n    \"\"\"Checks whether any two numbers in a sequence are within a specified\n    threshold distance.\n\n    The class is stateless and can be reused across multiple calls. It\n    implements a simple O(n\u00b2) pairwise comparison algorithm, which is\n    efficient enough for lists of moderate size (thousands of elements).\n    For very large lists, an alternative algorithm (e.g., sorting + two\u2011pointer)\n    could be used.\n    \"\"\"\n\n    def has_close_elements(self, nums: Sequence[float], threshold: float) -> bool:\n        \"\"\"Return True if any two distinct elements of `nums` are within\n        `threshold` of each other.\n\n        Parameters\n        ----------\n        nums : Sequence[float]\n            A sequence of numeric values. Empty or single\u2011element sequences\n            immediately return False.\n        threshold : float\n            The maximum allowed distance between two numbers to be\n            considered \"close\". Must be non\u2011negative.\n\n        Returns\n        -------\n        bool\n            True if at least one pair satisfies the condition,\n            otherwise False.\n        \"\"\"\n        if threshold < 0:\n            raise ValueError(\"Threshold must be non\u2011negative\")\n\n        n = len(nums)\n        if n < 2:\n            return False\n\n        # O(n^2) straightforward pairwise comparison\n        for i in range(n - 1):\n            for j in range(i + 1, n):\n                if abs(nums[i] - nums[j]) <= threshold:\n                    return True\n        return False\n\n\n# Singleton instance used by the functional wrapper\n_checker = ThresholdChecker()\n\n\n# threshold_checker/__init__.py\nfrom .checker import _checker\n\n\ndef has_close_elements(nums, threshold):\n    \"\"\"Functional wrapper that delegates to the singleton ThresholdChecker.\"\"\"\n    return _checker.has_close_elements(nums, threshold)"}
{"task_id": "HumanEval/0", "solution": "from typing import List\n\ndef has_close_elements(numbers: List[float], threshold: float) -> bool:\n    \"\"\"Check if any two numbers in the list are closer than the given threshold.\n\n    Args:\n        numbers: List of float numbers.\n        threshold: Positive float threshold to compare distances.\n\n    Returns:\n        True if any two distinct numbers are closer than threshold, otherwise False.\n\n    Raises:\n        ValueError: If threshold is not positive.\n\n    Examples:\n        >>> has_close_elements([1.0, 2.0, 3.0], 0.5)\n        False\n        >>> has_close_elements([1.0, 2.8, 3.0, 4.0, 5.0, 2.0], 0.3)\n        True\n    \"\"\"\n    if threshold <= 0:\n        raise ValueError(\"threshold must be positive\")\n    if len(numbers) < 2:\n        return False\n\n    # Sort numbers to compare only adjacent pairs for efficiency.\n    sorted_nums = sorted(numbers)\n    for i in range(len(sorted_nums) - 1):\n        if abs(sorted_nums[i + 1] - sorted_nums[i]) < threshold:\n            return True\n    return False\n\nif __name__ == \"__main__\":\n    import doctest\n    doctest.testmod()"}
