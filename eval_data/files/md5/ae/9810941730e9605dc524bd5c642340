task_id": "HumanEval/127", "solution": "from typing import Tuple, Optional\ndef intersection(interval1: Tuple[int, int], interval2: Tuple[int, int]) -> str:\n    \"\"\"\n    Determines whether the length of the intersection of two intervals is a prime number.\n    Returns \"YES\" if the length is prime, \"NO\" otherwise or if no intersection.\n    \"\"\"\n\n    class Interval:\n        def __init__(self, start: int, end: int):\n            self._start = start\n            self._end = end\n\n        def get_start(self) -> int:\n            return self._start\n\n        def get_end(self) -> int:\n            return self._end\n\n        def get_length(self) -> int:\n            # Length is end - start as per problem examples and design correction\n            return self._end - self._start\n\n    class IntervalService:\n        @staticmethod\n        def get_intersection(i1: 'Interval', i2: 'Interval') -> Optional['Interval']:\n            max_start = max(i1.get_start(), i2.get_start())\n            min_end = min(i1.get_end(), i2.get_end())\n\n            if max_start <= min_end:\n                return Interval(max_start, min_end)\n            else:\n                return None\n\n    class MathService:\n        @staticmethod\n        def is_prime(n: int) -> bool:\n            if n <= 1:\n                return False\n            if n == 2:\n                return True\n            if n % 2 == 0:\n                return False\n            i = 3\n            while i * i <= n:\n                if n % i == 0:\n                    return False\n                i += 2\n            return True\n\n    _interval1 = Interval(interval1[0], interval1[1])\n    _interval2 = Interval(interval2[0], interval2[1])\n\n    intersected_interval = IntervalService.get_intersection(_interval1, _interval2)\n\n    if intersected_interval is None:\n        return \"NO\"\n\n    intersection_length = intersected_interval.get_length()\n\n    if MathService.is_prime(intersection_length):\n        return \"YES\"\n    else:\n        return \"NO\"", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/127", "solution": "class Interval:\n    \"\"\"Represents a closed integer interval [start, end].\"\"\"\n    def __init__(self, start: int, end: int):\n        self.start = start\n        self.end = end\n\n    def get_length(self) -> int:\n        \"\"\"Calculates the length of the interval, or 0 if empty.\"\"\"\n        if self.start > self.end:\n            return 0\n        return self.end - self.start + 1\nclass PrimeChecker:\n    \"\"\"Provides a utility method to check if an integer is prime.\"\"\"\n    def is_prime(self, n: int) -> bool:\n        \"\"\"Checks if a number n is prime using an optimized trial division.\"\"\"\n        if n <= 1:\n            return False\n        if n <= 3:\n            return True\n        if n % 2 == 0 or n % 3 == 0:\n            return False\n\n        i = 5\n        while i * i <= n:\n            if n % i == 0 or n % (i + 2) == 0:\n                return False\n            i += 6\n        return True\nclass IntervalService:\n    \"\"\"Encapsulates business logic for interval operations and primality checks.\"\"\"\n    def __init__(self, prime_checker: PrimeChecker):\n        self._prime_checker = prime_checker\n\n    def get_intersection(self, interval1: Interval, interval2: Interval) -> Interval | None:\n        \"\"\"Calculates the intersection of two intervals, or None if they don't intersect.\"\"\"\n        intersection_start = max(interval1.start, interval2.start)\n        intersection_end = min(interval1.end, interval2.end)\n\n        if intersection_start > intersection_end:\n            return None\n        return Interval(intersection_start, intersection_end)\n\n    def get_intersection_length(self, interval1: Interval, interval2: Interval) -> int:\n        \"\"\"Calculates the length of the intersection of two intervals, or 0 if none.\"\"\"\n        intersection_interval = self.get_intersection(interval1, interval2)\n        if intersection_interval is None:\n            return 0\n        return intersection_interval.get_length()\n\n    def check_intersection_length_primality(self, interval1: Interval, interval2: Interval) -> str:\n        \"\"\"Determines if the intersection's length is prime, returning \"YES\" or \"NO\".\"\"\"\n        length = self.get_intersection_length(interval1, interval2)\n        if self._prime_checker.is_prime(length):\n            return \"YES\"\n        return \"NO\"\ndef intersection(interval1: tuple[int, int], interval2: tuple[int, int]) -> str:\n    \"\"\"\n    Determines if the length of the intersection of two closed integer intervals\n    is a prime number.\n    \"\"\"\n    interval1_obj = Interval(interval1[0], interval1[1])\n    interval2_obj = Interval(interval2[0], interval2[1])\n\n    prime_checker = PrimeChecker()\n    service = IntervalService(prime_checker)\n\n    return service.check_intersection_length_primality(interval1_obj, interval2_obj)", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[[-1, 1], [0, 4]]], "plus_fail_tests": [[[10, 20], [15, 25]]]}], "HumanEval/131": [{"task_id": "HumanEval/131", "solution": "def digits(n):\n    \"\"\"Given a positive integer n, return the product of the odd digits.\n    Return 0 if all digits are even.\n    For example:\n    digits(1)  == 1\n    digits(4)  == 0\n    digits(235) == 15\n    \"\"\"\n    product = 1\n    has_odd_digit = False\n\n    # Iterate through the digits of n as characters.\n    for digit_char in str(n):\n        digit = int(digit_char)\n        if digit % 2 != 0:  # Check if the current digit is odd.\n            product *= digit\n            has_odd_digit = True\n\n    if not has_odd_digit:\n        return 0\n\n    return product", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/131", "solution": "{\"error\": \"agent_no_response\", \"message\": \"Agent returned no response.\"}", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/132": [{"task_id": "HumanEval/132", "solution": "def is_nested(string):\n    '''\n    Create a function that takes a string as input which contains only square brackets.\n    The function should return True if and only if there is a valid subsequence of brackets\n    where at least one bracket in the subsequence is nested.\n\n    is_nested('[[]]') \u279e True\n    is_nested('[]]]]]]][[[[[]') \u279e False\n    is_nested('[][]') \u279e False\n    is_nested('[]') \u279e False\n    is_nested('[[][]]') \u279e True\n    is_nested('[[]][[') \u279e True\n    '''\n    # The problem defines \"nested\" as finding the subsequence '[[]]'\n    # We use a state machine to track the progress of finding this subsequence.\n    # State transitions:\n    # 0: Initial state, looking for the first '['\n    # 1: Found first '[', looking for the second '['\n    # 2: Found second '[', looking for the first ']'\n    # 3: Found first ']', looking for the second ']'\n\n    state = 0\n    for char in string:\n        if state == 0 and char == '[':\n            state = 1\n        elif state == 1 and char == '[':\n            state = 2\n        elif state == 2 and char == ']':\n            state = 3\n        elif state == 3 and char == ']':\n            # We have successfully found the '[[]]' subsequence\n            return True\n\n    # If we iterate through the entire string and do not reach the final state (state 3 and find ']')\n    # then the '[[]]' subsequence is not present.\n    return False", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [["[][][]"]]}, {"task_id": "HumanEval/132", "solution": "def is_nested(string):\n    '''\n    Checks if the input string contains a nested bracket subsequence (i.e., [[...]]).\\\n    Returns True if a nested subsequence is found, False otherwise.\n    '''\n    if not string:\n        return False\n\n    idx1 = -1\n    idx2 = -1\n    idx3 = -1\n    idx4 = -1\n\n    # Find the first '['\n    for i, char in enumerate(string):\n        if char == '[':\n            idx1 = i\n            break\n    if idx1 == -1:\n        return False\n\n    # Find the second '[' after the first '['\n    for i in range(idx1 + 1, len(string)):\n        if string[i] == '[':\n            idx2 = i\n            break\n    if idx2 == -1:\n        return False\n\n    # Find the first ']' after the second '['\n    for i in range(idx2 + 1, len(string)):\n        if string[i] == ']':\n            idx3 = i\n            break\n    if idx3 == -1:\n        return False\n\n    # Find the second ']' after the first ']'\n    for i in range(idx3 + 1, len(string)):\n        if string[i] == ']':\n            idx4 = i\n            break\n    if idx4 == -1:\n        return False\n\n    return True", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [["[][][]"]]}], "HumanEval/129": [{"task_id": "HumanEval/129", "solution": "import heapq\nfrom typing import List, Tuple\nfrom dataclasses import dataclass, field\nclass Grid:\n    \"\"\"Manages the 2D grid data, providing methods to access cell values and Cell objects.\"\"\"\n    def __init__(self, grid_data: List[List[int]]):\n        self._N = len(grid_data)\n        self._cells = [[Cell(r, c, grid_data[r][c]) for c in range(self._N)] for r in range(self._N)]\n\n    def get_value(self, row: int, col: int) -> int:\n        \"\"\"Returns the integer value at the specified (row, col).\"\"\"\n        # Input validation removed per critical requirements.\n        return self._cells[row][col].value\n\n    def get_cell(self, row: int, col: int) -> Cell:\n        \"\"\"Returns the Cell object at the specified (row, col).\"\"\"\n        # Input validation removed per critical requirements.\n        return self._cells[row][col]\n\n    def get_N(self) -> int:\n        \"\"\"Returns the dimension N of the grid.\"\"\"\n        return self._N\ndef get_neighbors(row: int, col: int, N: int) -> List[Tuple[int, int]]:\n    \"\"\"Calculates the valid (on-grid) coordinates of the neighbors for a given cell.\"\"\"\n    neighbors = []\n    moves = [(-1, 0), (1, 0), (0, -1), (0, 1)] # Up, Down, Left, Right\n\n    for dr, dc in moves:\n        new_row, new_col = row + dr, col + dc\n        if 0 <= new_row < N and 0 <= new_col < N:\n            neighbors.append((new_row, new_col))\n    return neighbors\nclass PathFinder:\n    \"\"\"Implements the core algorithm to find the lexicographically smallest path of length k.\"\"\"\n    def find_min_path(self, grid_data: List[List[int]], k: int) -> List[int]:\n        \"\"\"The main method to initiate the pathfinding process, preparing the grid and length.\"\"\"\n        # Input validation removed per critical requirements.\n        grid = Grid(grid_data)\n        return self._explore_paths(grid, k)\n\n    def _explore_paths(self, grid: Grid, k: int) -> List[int]:\n        \"\"\"Explores paths using a min-priority queue to find the lexicographically smallest path.\"\"\"\n        priority_queue: List[Path] = []\n        N = grid.get_N()\n\n        # Initialize paths from all starting cells.\n        for r in range(N):\n            for c in range(N):\n                initial_cell = grid.get_cell(r, c)\n                heapq.heappush(priority_queue, Path(values=[initial_cell.value], last_cell=initial_cell))\n\n        while priority_queue:\n            current_path = heapq.heappop(priority_queue)\n\n            if len(current_path.values) == k:\n                return current_path.values\n\n            # Explore neighbors and add new paths to the queue.\n            r, c = current_path.last_cell.row, current_path.last_cell.col\n            for next_r, next_c in get_neighbors(r, c, N):\n                next_cell = grid.get_cell(next_r, next_c)\n                new_path = current_path.add_step(next_cell)\n                heapq.heappush(priority_queue, new_path)\n\n        # This return should ideally not be reached, as a unique answer is guaranteed.\n        return []\ndef minPath(grid: List[List[int]], k: int) -> List[int]:\n    \"\"\"\n    Given a grid with N rows and N columns and a positive integer k,\n    find the minimum path of length k in the grid.\n    \"\"\"\n    path_finder = PathFinder()\n    return path_finder.find_min_path(grid, k)", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/129", "solution": "import heapq\nfrom collections import namedtuple\ndef minPath(grid, k):\n    \"\"\"\n    Given a grid and a path length k, finds the lexicographically smallest path.\n    Uses a modified Dijkstra-like algorithm with a priority queue for path exploration.\n    \"\"\"\n\n    # --- Nested Data Model: PathState ---\n    PathState = namedtuple('PathState', ['path_values', 'coords', 'length'])\n\n    def _path_state_lt(self, other):\n        \"\"\"Compares two PathState objects based on their path_values.\"\"\"\n        return self.path_values < other.path_values\n    PathState.__lt__ = _path_state_lt\n\n    # --- Nested Utility: GridUtils ---\n    class GridUtils:\n        @staticmethod\n        def get_neighbors(r: int, c: int, N: int) -> list[tuple[int, int]]:\n            \"\"\"Returns valid neighbors for a given cell (r, c) within an N x N grid.\"\"\"\n            neighbors = []\n            dr = [-1, 1, 0, 0] # Row changes for Up, Down, Left, Right\n            dc = [0, 0, -1, 1] # Column changes for Up, Down, Left, Right\n\n            for i in range(4):\n                nr, nc = r + dr[i], c + dc[i]\n                if 0 <= nr < N and 0 <= nc < N: # Check boundaries\n                    neighbors.append((nr, nc))\n            return neighbors\n\n    # --- Nested Service: MinPathFinder ---\n    class MinPathFinder:\n        def __init__(self, grid_ref: list[list[int]], k_ref: int):\n            \"\"\"Initializes the pathfinder with the grid, target length, and internal structures.\"\"\"\n            self._grid = grid_ref\n            self._N = len(grid_ref)\n            self._k = k_ref\n            self._pq = []  # Min-priority queue for PathState objects\n            # Stores the lexicographically smallest path found to reach (r, c) with a specific length.\n            self._min_paths_found = {} # Key: (r, c, length), Value: path_values_tuple\n\n        def _initialize_priority_queue(self) -> None:\n            \"\"\"Populates the priority queue with all single-cell paths as starting points.\"\"\"\n            for r in range(self._N):\n                for c in range(self._N):\n                    initial_value = self._grid[r][c]\n                    initial_path = (initial_value,)\n                    initial_state = PathState(initial_path, (r, c), 1)\n                    heapq.heappush(self._pq, initial_state)\n                    self._min_paths_found[(r, c, 1)] = initial_path\n\n        def _process_neighbors(self, current_state: PathState) -> None:\n            \"\"\"Extends the current path to all valid neighbors, updating the PQ and min_paths_found.\"\"\"\n            current_path_values, (r, c), current_length = current_state\n\n            for nr, nc in GridUtils.get_neighbors(r, c, self._N):\n                next_length = current_length + 1\n                if next_length > self._k: # Path length exceeds target, no need to extend\n                    continue\n\n                next_path_values = current_path_values + (self._grid[nr][nc],)\n\n                # Check if this new path is better than any existing path to (nr, nc) at next_length\n                existing_min_path = self._min_paths_found.get((nr, nc, next_length))\n\n                if existing_min_path is None or next_path_values < existing_min_path:\n                    self._min_paths_found[(nr, nc, next_length)] = next_path_values\n                    heapq.heappush(self._pq, PathState(next_path_values, (nr, nc), next_length))\n\n        def find_min_path(self) -> list[int]:\n            \"\"\"Executes the Dijkstra-like algorithm to find the lexicographically smallest path.\"\"\"\n            self._initialize_priority_queue()\n\n            while self._pq:\n                current_path_values, (r, c), current_length = heapq.heappop(self._pq)\n\n                # Pruning: If a lexicographically smaller path to this state has already been found\n                # and processed, or if this path is worse than the current known minimum, skip it.\n                # The `get` default value handles cases where the key might not exist yet, treating it as 'infinite'.\n                if current_path_values > self._min_paths_found.get((r, c, current_length), current_path_values + (float('inf'),)):\n                    continue\n\n                if current_length == self._k:\n                    return list(current_path_values) # Target length reached\n\n                self._process_neighbors(PathState(current_path_values, (r, c), current_length))\n\n            # This part should theoretically not be reached as per problem guarantees for valid k.\n            return []\n\n    # Instantiate the MinPathFinder and execute the search\n    finder = MinPathFinder(grid, k)\n    return finder.find_min_path()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/133": [{"task_id": "HumanEval/133", "solution": "import math\ndef sum_squares(lst):\n    \"\"\"You are given a list of numbers.\n    This function returns the sum of squared numbers in the given list, after rounding each element up to the nearest integer.\n    \"\"\"\n    total_sum = 0\n    for number in lst:\n        rounded_number = math.ceil(number)\n        total_sum += rounded_number ** 2\n    return total_sum", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/133", "solution": "import math\ndef sum_squares(lst):\n    \"\"\"You are given a list of numbers.\n    You need to return the sum of squared numbers in the given list,\n    round each element in the list to the upper int(Ceiling) first.\n    \"\"\"\n    total_sum = 0.0\n    for num in lst:\n        rounded_num = math.ceil(num)\n        total_sum += rounded_num ** 2\n\n    if total_sum.is_integer():\n        return int(total_sum)\n    return total_sum", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/83": [{"task_id": "HumanEval/83", "solution": "def starts_one_ends(n: int) -> int:\n    \"\"\"\n    Calculates the count of n-digit positive integers that start or end with 1.\n    Assumes n is a positive integer as per the problem statement.\n    \"\"\"\n    if n == 1:\n        return 1\n    else:  # For n >= 2, apply the formula\n        return 18 * (10**(n - 2))", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/83", "solution": "def _count_starts_with_1(n: int) -> int:\n    \"\"\"\n    Calculates the count of n-digit numbers starting with 1.\n    Handles n=1 as an edge case, otherwise uses power of 10.\n    \"\"\"\n    if n == 1:\n        return 1\n    return 10**(n - 1)\ndef _count_ends_with_1(n: int) -> int:\n    \"\"\"\n    Calculates the count of n-digit numbers ending with 1.\n    For n>1, the first digit cannot be zero, leading to 9 options for the first digit.\n    \"\"\"\n    if n == 1:\n        return 1\n    return 9 * (10**(n - 2))\ndef _count_starts_and_ends_with_1(n: int) -> int:\n    \"\"\"\n    Calculates the count of n-digit numbers starting AND ending with 1.\n    Special handling for n=1 and n=2, then general formula for n>2.\n    \"\"\"\n    if n == 1:\n        return 1\n    if n == 2:\n        return 1\n    return 10**(n - 2)\ndef starts_one_ends(n: int) -> int:\n    \"\"\"\n    Given a positive integer n, return the count of the numbers of n-digit\n    positive integers that start or end with 1.\n    The calculation uses the principle of inclusion-exclusion.\n    \"\"\"\n    starts = _count_starts_with_1(n)\n    ends = _count_ends_with_1(n)\n    both = _count_starts_and_ends_with_1(n)\n\n    return starts + ends - both", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/134": [{"task_id": "HumanEval/134", "solution": "def check_if_last_char_is_a_letter(txt):\n    \"\"\"\n    Returns True if the last character of `txt` is an alphabetical character\n    and is not part of a word (single char or preceded by space), False otherwise.\n    \"\"\"\n    if not txt:\n        return False\n\n    last_char = txt[-1]\n\n    if not last_char.isalpha():\n        return False\n\n    if len(txt) == 1:\n        return True\n    else:\n        return txt[-2] == ' '", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/134", "solution": "import string\ndef check_if_last_char_is_a_letter(txt):\n    \"\"\"\n    Checks if the last character of a given string is an alphabetical character\n    and is not a part of a word.\n    \"\"\"\n    if not txt:\n        return False\n\n    last_char = txt[-1]\n\n    if last_char not in string.ascii_letters:\n        return False\n\n    if len(txt) == 1:\n        return True\n\n    char_before_last = txt[-2]\n\n    if char_before_last == ' ':\n        return True\n    else:\n        return False", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/135": [{"task_id": "HumanEval/135", "solution": "def can_arrange(arr):\n    \"\"\"Returns the largest index of an element which is strictly less than\n    its preceding element. Returns -1 if no such element exists.\n    \"\"\"\n    if len(arr) < 2:\n        return -1\n\n    for i in range(len(arr) - 1, 0, -1):\n        if arr[i] < arr[i-1]:\n            return i\n\n    return -1", "base_sta