perator) != len(operand) - 1:\n        raise InvalidInputError(\n            f\"Length of operator list ({len(operator)}) must be one less than \"\n            f\"the length of operand list ({len(operand)}).\"\n        )\n\n    for i, num in enumerate(operand):\n        if not isinstance(num, int) or num < 0:\n            raise InvalidInputError(\n                f\"Operand at index {i} ({num}) must be a non-negative integer.\"\n            )\n\n    for i, op in enumerate(operator):\n        if not isinstance(op, str) or op not in ALLOWED_OPERATORS:\n            raise InvalidInputError(\n                f\"Operator at index {i} ('{op}') is not one of the allowed operators: \"\n                f\"{', '.join(ALLOWED_OPERATORS)}.\"\n            )\n\n    # --- Expression Construction Logic (from AlgebraEvaluator._construct_expression) ---\n    expression_parts = []\n    for i in range(len(operand)):\n        expression_parts.append(str(operand[i]))\n        if i < len(operator):\n            expression_parts.append(operator[i])\n    expression_string = \" \".join(expression_parts)\n\n    # --- Expression Evaluation Logic (from AlgebraEvaluator._evaluate_expression) ---\n    try:\n        result = eval(expression_string)\n        # Ensure integer result if possible, otherwise float\n        return int(result) if result == int(result) else float(result)\n    except ZeroDivisionError:\n        raise ZeroDivisionError(\"Division by zero occurred in the expression.\")\n    except SyntaxError as e:\n        raise SyntaxError(f\"Malformed expression generated: {expression_string}. Error: {e}\")\n    except Exception as e:\n        raise RuntimeError(f\"An unexpected error occurred during evaluation: {e}\")", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/160", "solution": "import re\ndef do_algebra(operator, operand):\n    \"\"\"\n    Given two lists operator, and operand. The first list has basic algebra operations, and\n    the second list is a list of integers. Use the two given lists to build the algebric\n    expression and return the evaluation of this expression.\n\n    The basic algebra operations:\n    Addition ( + )\n    Subtraction ( - )\n    Multiplication ( * )\n    Floor division ( // )\n    Exponentiation ( ** )\n\n    Example:\n    operator['+', '*', '-']\n    array = [2, 3, 4, 5]\n    result = 2 + 3 * 4 - 5\n    => result = 9\n\n    Note:\n        The length of operator list is equal to the length of operand list minus one.\n        Operand is a list of of non-negative integers.\n        Operator list has at least one operator, and operand list has at least two operands.\n\n    \"\"\"\n\n    # Inlining validation logic from Validator class\n    # _validate_lengths\n    if not (len(operator) == len(operand) - 1):\n        raise ValueError(\n            f\"Length mismatch: operator list ({len(operator)}) \"\n            f\"must be one less than operand list ({len(operand)}).\"\n        )\n\n    # _validate_min_lengths\n    if len(operator) < 1:\n        raise ValueError(\"Operator list must contain at least one operator.\")\n    if len(operand) < 2:\n        raise ValueError(\"Operand list must contain at least two operands.\")\n\n    # _validate_operand_types\n    if not all(isinstance(op, int) for op in operand):\n        raise ValueError(\"All operands must be integers.\")\n\n    # _validate_operator_types\n    if not all(isinstance(op, str) for op in operator):\n        raise ValueError(\"All operators must be strings.\")\n\n    # _validate_supported_operators\n    SUPPORTED_OPERATORS = {'+', '-', '*', '//', '**'}\n    if not all(op in SUPPORTED_OPERATORS for op in operator):\n        unsupported = {op for op in operator if op not in SUPPORTED_OPERATORS}\n        raise ValueError(f\"Unsupported operator(s) found: {', '.join(unsupported)}\")\n\n    # _validate_non_negative_operands\n    if not all(op >= 0 for op in operand):\n        raise ValueError(\"All operands must be non-negative integers.\")\n\n    # Inlining _build_expression_string logic from AlgebraEvaluator class\n    expression_parts = []\n    for i in range(len(operator)):\n        expression_parts.append(str(operand[i]))\n        expression_parts.append(operator[i])\n    expression_parts.append(str(operand[-1]))\n\n    expression_string = \" \".join(expression_parts)\n\n    # Inlining _sanitize_and_eval logic from AlgebraEvaluator class\n    # More robust pattern as suggested in the design document comments for eval() safety.\n    # We escape operators for regex and join them.\n    # This pattern ensures only digits, spaces, and the *supported* operators are present.\n    # It also checks for the general structure of operand (operator operand)*\n    escaped_operators = [re.escape(op) for op in SUPPORTED_OPERATORS]\n    operators_pattern_part = \"|\".join(escaped_operators)\n\n    # A robust pattern: ^\\s*\\d+(\\s*(OPERATOR)\\s*\\d+)*\\s*$\n    # This checks for a number, optionally followed by space, operator, space, number, repeated.\n    # The 'r' before string ensures it's a raw string, preventing issues with backslashes.\n    allowed_chars_pattern = r\"^\\s*\\d+(\\s*(\" + operators_pattern_part + r\")\\s*\\d+)*\\s*$\"\n\n    if not re.match(allowed_chars_pattern, expression_string):\n        # This acts as an additional safety net for eval(), though primary validation\n        # is expected from the input checks.\n        raise ValueError(f\"Expression contains disallowed characters or has an invalid structure: {expression_string}\")\n\n    try:\n        # Using eval() as per the design document's constraints and assumptions,\n        # with strong prior validation and sanitization to mitigate risks.\n        return int(eval(expression_string))\n    except (SyntaxError, TypeError, NameError) as e:\n        raise ValueError(f\"Error evaluating expression: {expression_string}. Details: {e}\")", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/161": [{"task_id": "HumanEval/161", "solution": "def solve(s):\n    \"\"\"You are given a string s.\n    if s[i] is a letter, reverse its case from lower to upper or vise versa,\n    otherwise keep it as it is.\n    If the string contains no letters, reverse the string.\n    The function should return the resulted string.\n    Examples\n    solve(\"1234\") = \"4321\"\n    solve(\"ab\") = \"AB\"\n    solve(\"#a@C\") = \"#A@c\"\n    \"\"\"\n    has_letters = False\n    for char in s:\n        if char.isalpha():\n            has_letters = True\n            break\n\n    if not has_letters:\n        return s[::-1]\n    else:\n        result_chars = []\n        for char in s:\n            if char.isalpha():\n                if char.islower():\n                    result_chars.append(char.upper())\n                else: # char.isupper()\n                    result_chars.append(char.lower())\n            else:\n                result_chars.append(char)\n        return \"\".join(result_chars)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/161", "solution": "def solve(s):\n    \"\"\"Transforms a string by reversing letter case or reversing the whole string if no letters are present.\n    Non-letter characters keep their original form unless the entire string is reversed.\n    \"\"\"\n    if not s:\n        return \"\"\n\n    contains_letters = False\n    for char in s:\n        if char.isalpha():\n            contains_letters = True\n            break\n\n    if not contains_letters:\n        return s[::-1]\n    else:\n        transformed_chars = []\n        for char in s:\n            if char.islower():\n                transformed_chars.append(char.upper())\n            elif char.isupper():\n                transformed_chars.append(char.lower())\n            else:\n                transformed_chars.append(char)\n        return \"\".join(transformed_chars)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/130": [{"task_id": "HumanEval/130", "solution": "def tri(n):\n    \"\"\"Everyone knows Fibonacci sequence, it was studied deeply by mathematicians in\n    the last couple centuries. However, what people don't know is Tribonacci sequence.\n    Tribonacci sequence is defined by the recurrence:\n    tri(1) = 3\n    tri(n) = 1 + n / 2, if n is even.\n    tri(n) =  tri(n - 1) + tri(n - 2) + tri(n + 1), if n is odd.\n    For example:\n    tri(2) = 1 + (2 / 2) = 2\n    tri(4) = 3\n    tri(3) = tri(2) + tri(1) + tri(4)\n           = 2 + 3 + 3 = 8\n    You are given a non-negative integer number n, you have to a return a list of the\n    first n + 1 numbers of the Tribonacci sequence.\n    Examples:\n    tri(3) = [1, 3, 2, 8]\n    \"\"\"\n    memo = {}\n\n    def _calculate_single_tri(k):\n        \"\"\"Helper to calculate a single Tribonacci number tri(k) with memoization.\"\"\"\n        if k in memo:\n            return memo[k]\n\n        result = 0.0\n        if k == 0:\n            result = 1.0\n        elif k == 1:\n            result = 3.0\n        elif k % 2 == 0:  # k is even\n            result = 1.0 + k / 2.0\n        else:  # k is odd\n            val_k_minus_1 = _calculate_single_tri(k - 1)\n            val_k_minus_2 = _calculate_single_tri(k - 2)\n            val_k_plus_1 = _calculate_single_tri(k + 1)\n            result = val_k_minus_1 + val_k_minus_2 + val_k_plus_1\n\n        memo[k] = result\n        return result\n\n    sequence = []\n    for i in range(n + 1):\n        sequence.append(int(_calculate_single_tri(i)))\n    return sequence", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/130", "solution": "def tri(n: int) -> list[float]:\n    \"\"\"Calculates the first n+1 numbers of a specific Tribonacci-like sequence.\n    The sequence is defined with special rules for even and odd indices.\n    \"\"\"\n    if n == 0:\n        return [1.0]\n\n    sequence = [1.0, 3.0]\n\n    for i in range(2, n + 1):\n        if i % 2 == 0:\n            tri_i = 1.0 + i / 2.0\n        else:\n            tri_i_plus_1 = 1.0 + (i + 1) / 2.0\n            tri_i = sequence[i - 1] + sequence[i - 2] + tri_i_plus_1\n        sequence.append(tri_i)\n\n    return sequence", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}]}}