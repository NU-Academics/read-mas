oup within a string.\n    It scans an input string from a start index to find the next complete, balanced group.\n    \"\"\"\n    def find_next_group(self, s: str, start_index: int) -> Tuple[str, int]:\n        balance = 0\n        group_start = -1\n\n        for i in range(start_index, len(s)):\n            char = s[i]\n            if char == '(':\n                if balance == 0:  # Start of a new top-level group\n                    group_start = i\n                balance += 1\n            elif char == ')':\n                balance -= 1\n\n            if balance == 0 and group_start != -1:  # Found a balanced group\n                return s[group_start : i + 1], i + 1\n            elif balance < 0:  # Malformed, closing parenthesis without opening\n                return \"\", -1  # Invalid sequence, cannot form a group\n\n        return \"\", -1  # No balanced group found from start_index\nclass ParenGroupSeparatorService:\n    \"\"\"\n    Orchestrates the high-level process of separating multiple balanced parenthesis groups.\n    It handles string cleaning and iteration, delegating group identification to ParenGroupParser.\n    \"\"\"\n    def __init__(self, parser: ParenGroupParser):\n        self._parser = parser\n\n    def separate_groups(self, paren_string: str) -> List[str]:\n        cleaned_string = paren_string.replace(\" \", \"\")\n        result_groups: List[str] = []\n        current_index = 0\n\n        while current_index < len(cleaned_string):\n            group, next_index = self._parser.find_next_group(cleaned_string, current_index)\n            if group:\n                result_groups.append(group)\n                current_index = next_index\n            else:\n                # No more valid groups found from current_index\n                break\n        return result_groups\ndef separate_paren_groups(paren_string: str) -> List[str]:\n    \"\"\" Input to this function is a string containing multiple groups of nested parentheses. Your goal is t