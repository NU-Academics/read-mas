is a multiple of 3 if and only if (a[i]%3 + a[j]%3 + a[k]%3) is a multiple of 3.\n    # Since remainders are only 0 or 1, valid combinations for their sum modulo 3 are:\n    # 1. All three elements have a remainder of 0 (0 + 0 + 0 = 0).\n    # 2. All three elements have a remainder of 1 (1 + 1 + 1 = 3).\n    # We sum the number of ways to choose 3 elements from count_0 and 3 elements from count_1.\n    total_triples = combinations_n_choose_3(count_0) + combinations_n_choose_3(count_1)\n\n    return total_triples", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/147", "solution": "from math import comb\ndef get_max_triples(n: int) -> int:\n    \"\"\"\n    Counts specific integer triples from a generated array whose sum is a multiple of 3.\n    The array a is defined by a[i] = i*i - i + 1 for 1 <= i <= n.\n    \"\"\"\n    a = []\n    for i in range(1, n + 1):\n        a.append(i * i - i + 1)\n\n    # Count elements based on their remainder modulo 3.\n    counts = [0, 0, 0]\n    for x in a:\n        counts[x % 3] += 1\n\n    count_0, count_1, count_2 = counts[0], counts[1], counts[2]\n    total_triples = 0\n\n    # Combinations of remainders that sum to a multiple of 3.\n    if count_0 >= 3:\n        total_triples += comb(count_0, 3)\n    if count_1 >= 3:\n        total_triples += comb(count_1, 3)\n    if count_2 >= 3:\n        total_triples += comb(count_2, 3)\n    total_triples += count_0 * count_1 * count_2\n\n    return total_triples", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/150": [{"task_id": "HumanEval/150", "solution": "def x_or_y(n, x, y):\n    \"\"\"Returns x if n is a prime number, otherwise returns y.\n    This function implements a trial division primality test.\n    \"\"\"\n\n    is_prime_n = True\n\n    if n <= 1:\n        is_prime_n = False\n    elif n == 2:\n        is_prime_n = True\n    elif n % 2 == 0: # Even numbers gr