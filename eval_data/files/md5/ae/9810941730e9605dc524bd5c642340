ssage)\n        self.message = message\nBISECTION_TOLERANCE = 1e-6\nBISECTION_MAX_ITERATIONS = 100\nBISECTION_LOWER_BOUND = -100.0\nBISECTION_UPPER_BOUND = 100.0\ndef poly(xs: list, x: float) -> float:\n    \"\"\"\n    Evaluates polynomial with coefficients xs at point x.\n    return xs[0] + xs[1] * x + xs[2] * x^2 + .... xs[n] * x^n\n    \"\"\"\n    return sum([coeff * math.pow(x, i) for i, coeff in enumerate(xs)])\ndef find_zero(xs: list) -> float:\n    \"\"\" xs are coefficients of a polynomial.\n    find_zero find x such that poly(x) = 0.\n    find_zero returns only only zero point, even if there are many.\n    Moreover, find_zero only takes list xs having even number of coefficients\n    and largest non zero coefficient as it guarantees\n    a solution.\n    \"\"\"\n    lower_bound = BISECTION_LOWER_BOUND\n    upper_bound = BISECTION_UPPER_BOUND\n    tolerance = BISECTION_TOLERANCE\n    max_iterations = BISECTION_MAX_ITERATIONS\n\n    p_lower = poly(xs, lower_bound)\n    p_upper = poly(xs, upper_bound)\n\n    if abs(p_lower) < tolerance:\n        return lower_bound\n    if abs(p_upper) < tolerance:\n        return upper_bound\n\n    if p_lower * p_upper > 0:\n        raise ZeroNotFoundError(\n            f\"No sign change found in initial interval [{lower_bound}, {upper_bound}]. \"\n            \"Consider expanding the search bounds or check polynomial properties.\"\n        )\n\n    for _ in range(max_iterations):\n        mid = (lower_bound + upper_bound) / 2\n        p_mid = poly(xs, mid)\n\n        if abs(p_mid) < tolerance:\n            return mid\n\n        if p_lower * p_mid < 0:\n            upper_bound = mid\n            p_upper = p_mid\n        else:\n            lower_bound = mid\n            p_lower = p_mid\n\n    raise ZeroNotFoundError(\n        f\"Zero not found within {max_iterations} iterations \"\n        f\"and tolerance {tolerance} in interval [{lower_bound}, {upper_bound}].\"\n    )", "base_status": "fail", "plus_status": "fail", "base_fail