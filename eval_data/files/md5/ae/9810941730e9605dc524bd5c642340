al/78", "solution": "def hex_key(num: str) -> int:\n    \"\"\"\n    Counts prime hexadecimal digits in a string.\n    Processes each character to find primes based on a predefined set.\n    \"\"\"\n    # Define the set of prime hexadecimal decimal values.\n    PRIME_HEX_DECIMAL_VALUES = {2, 3, 5, 7, 11, 13}\n\n    class HexDigitConverter:\n        \"\"\"Converts a single hex character to its decimal equivalent.\"\"\"\n        def hex_char_to_decimal(self, char: str) -> int:\n            return int(char, 16)\n\n    class PrimeChecker:\n        \"\"\"Checks if a decimal number (0-15) is prime.\"\"\"\n        def __init__(self, prime_values: set[int]):\n            self._prime_values = prime_values\n\n        def is_prime(self, number: int) -> bool:\n            return number in self._prime_values\n\n    class HexCounterService:\n        \"\"\"Orchestrates counting prime hex digits using converter and checker.\"\"\"\n        def __init__(self, hex_digit_converter: HexDigitConverter, prime_checker: PrimeChecker):\n            self._hex_digit_converter = hex_digit_converter\n            self._prime_checker = prime_checker\n\n        def count_prime_hex_digits(self, hex_string: str) -> int:\n            prime_count = 0\n            for char in hex_string:\n                decimal_value = self._hex_digit_converter.hex_char_to_decimal(char)\n                if self._prime_checker.is_prime(decimal_value):\n                    prime_count += 1\n            return prime_count\n\n    # Instantiate and use the services as described in the design.\n    hex_digit_converter = HexDigitConverter()\n    prime_checker = PrimeChecker(PRIME_HEX_DECIMAL_VALUES)\n    service = HexCounterService(hex_digit_converter, prime_checker)\n    return service.count_prime_hex_digits(num)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/80": [{"task_id": "HumanEval/80", "solution": "def is_happy(s: str) -> bool:\n    \"\"\"\n    Checks if a string s is happy.\n    A string is happy if its length is at least 3 and every 3 consecutive letters are distinct.\n    \"\"\"\n    if len(s) < 3:\n        return False\n\n    for i in range(len(s) - 2):\n        if s[i] == s[i+1] or s[i] == s[i+2] or s[i+1] == s[i+2]:\n            return False\n    return True", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/80", "solution": "def is_happy(s):\n    \"\"\"Checks if a string is happy.\n    A string is happy if its length is at least 3 and every 3 consecutive letters are distinct.\"\"\"\n    if len(s) < 3:\n        return False\n\n    for i in range(len(s) - 2):\n        if s[i] == s[i+1] or s[i] == s[i+2] or s[i+1] == s[i+2]:\n            return False\n\n    return True", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/82": [{"task_id": "HumanEval/82", "solution": "def prime_length(string):\n    \"\"\"\n    Checks if the length of the input string is a prime number.\n    Returns True if prime, False otherwise.\n    \"\"\"\n    length = len(string)\n\n    # Numbers less than 2 are not considered prime.\n    if length < 2:\n        return False\n\n    # Check for divisors from 2 up to the square root of the number.\n    i = 2\n    while i * i <= length:\n        if length % i == 0:\n            return False\n        i += 1\n\n    return True", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/82", "solution": "def _is_prime(n: int) -> bool:\n    \"\"\"Checks if an integer is a prime number.\n    Returns True if n is prime, False otherwise.\n    \"\"\"\n    if n < 2:\n        return False\n    # Optimize by checking for divisors up to the square root of n.\n    i = 2\n    while i * i <= n:\n        if n % i == 0:\n            return False\n        i += 1\n    return True\ndef prime_length(string: str) -> bool:\n    \"\"\"Write a function that takes a string and returns True if the string\n    length is a prime number or False otherwise\n    Examples\n    prime_length('Hello') == True\n    prime_length('abcdcba') == True\n    prime_length('kittens') == True\n    prime_length('orange') == False\n    \"\"\"\n    length = len(string)\n    return _is_prime(length)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/81": [{"task_id": "HumanEval/81", "solution": "def numerical_letter_grade(grades):\n    \"\"\"Converts a list of numerical GPAs to corresponding letter grades based on a predefined scale.\n    The logic specifically aligns with the example output and business rules for boundary conditions.\n    \"\"\"\n    result = []\n    for gpa in grades:\n        if gpa >= 4.0:\n            result.append(\"A+\")\n        elif gpa >= 3.7:\n            result.append(\"A\")\n        elif gpa >= 3.3:\n            result.append(\"A-\")\n        elif gpa > 3.0:\n            result.append(\"B+\")\n        elif gpa >= 2.7:\n            result.append(\"B\")\n        elif gpa >= 2.3:\n            result.append(\"B-\")\n        elif gpa >= 2.0:\n            result.append(\"C+\")\n        elif gpa >= 1.7:\n            result.append(\"C\")\n        elif gpa >= 1.3:\n            result.append(\"C-\")\n        elif gpa >= 1.0:\n            result.append(\"D+\")\n        elif gpa >= 0.7:\n            result.append(\"D\")\n        elif gpa > 0.0:\n            result.append(\"D-\")\n        else:\n            result.append(\"E\")\n    return result", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[[4.0, 3, 1.7, 2, 3.5]]], "plus_fail_tests": [[[3.8, 2.5, 3.9, 2.2, 1.0]]]}, {"task_id": "HumanEval/81", "solution": "class GradeMapping:\n    \"\"\"\n    Defines the static mapping from GPA thresholds to letter grades.\n    The list is ordered from highest GPA threshold to lowest for efficient lookup.\n    \"\"\"\n    # Each tuple contains a GPA threshold (float) and its corresponding letter grade (str).\n    # Thresholds are exclusive lower bounds for the grade, exact 4.0 and 0.0 are handled separately.\n    GPA_SCALE: list[tuple[float, str]] = [\n        (3.7, \"A\"),  # for GPA > 3.7\n        (3.3, \"A-\"), # for GPA > 3.3\n        (3.0, \"B+\"), # for GPA > 3.0\n        (2.7, \"B\"),  # for GPA > 2.7\n        (2.3, \"B-\"), # for GPA > 2.3\n        (2.0, \"C+\"), # for GPA > 2.0\n        (1.7, \"C\"),  # for GPA > 1.7\n        (1.3, \"C-\"), # for GPA > 1.3\n        (1.0, \"D+\"), # for GPA > 1.0\n        (0.7, \"D\"),  # for GPA > 0.7\n        (0.0, \"D-\"), # for GPA > 0.0\n    ]\nclass GradeConverter:\n    \"\"\"\n    Handles the conversion of numerical GPAs to letter grades.\n    It encapsulates the logic for applying the specified grading scale.\n    \"\"\"\n    def __init__(self, grade_scale: list[tuple[float, str]]):\n        self._grade_scale = grade_scale\n\n    def convert_gpa_to_letter_grade(self, gpa: float) -> str:\n        \"\"\"\n        Converts a single GPA to its corresponding letter grade based on the scale.\n        Exact 4.0 and 0.0 GPAs are handled as special cases.\n        \"\"\"\n        if gpa == 4.0:\n            return \"A+\"\n        if gpa == 0.0:\n            return \"E\"\n\n        for threshold, grade in self._grade_scale:\n            if gpa > threshold:\n                return grade\n\n        # If GPA falls below all defined thresholds (e.g., negative GPA) and is not exactly 0.0.\n        # These cases are assigned an 'E' grade.\n        return \"E\"\n\n    def convert_gpas_to_letter_grades(self, gpas: list[float]) -> list[str]:\n        \"\"\"\n        Converts a list of GPAs to a list of letter grades.\n        Each GPA is converted individually using the single GPA conversion method.\n        \"\"\"\n        return [self.convert_gpa_to_letter_grade(gpa) for gpa in gpas]\ndef numerical_letter_grade(grades: list[float]) -> list[str]:\n    \"\"\"\n    Converts a list of numerical GPAs to a list of corresponding letter grades.\n    It instantiates a GradeConverter and uses it to process the list of GPAs.\n    \"\"\"\n    converter = GradeConverter(GradeMapping.GPA_SCALE)\n    return converter.convert_gpas_to_letter_grades(grades)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/84": [{"task_id": "HumanEval/84", "solution": "def solve(N):\n    \"\"\"Given a positive integer N, return the total sum of its digits in binary.\n\n    Example\n        For N = 1000, the sum of digits will be 1 the output should be \"1\".\n        For N = 150, the sum of digits will be 6 the output should be \"110\".\n        For N = 147, the sum of digits will be 12 the output should be \"1100\".\n\n    Variables:\n        @N integer\n             Constraints: 0 \u2264 N \u2264 10000.\n    Output:\n         a string of binary number\n    \"\"\"\n    decimal_sum = sum(int(digit) for digit in str(N))\n\n    if decimal_sum == 0:\n        return \"0\"\n    return bin(decimal_sum)[2:]", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/84", "solution": "def solve(N):\n    \"\"\"Given a positive integer N, return the total sum of its digits in binary.\n    Constraints: 0 \u2264 N \u2264 10000.\n    \"\"\"\n\n    # Calculate the sum of the decimal digits of N.\n    decimal_sum = 0\n    temp_n = N\n    if temp_n == 0:\n        decimal_sum = 0\n    else:\n        while temp_n > 0:\n            decimal_sum += temp_n % 10\n            temp_n //= 10\n\n    # Convert the calculated decimal sum into its binary string representation.\n    if decimal_sum == 0:\n        return '0'\n\n    binary_digits = []\n    temp_sum = decimal_sum\n    while temp_sum > 0:\n        binary_digits.append(str(temp_sum % 2))\n        temp_sum //= 2\n\n    return \"\".join(binary_digits[::-1])", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_te