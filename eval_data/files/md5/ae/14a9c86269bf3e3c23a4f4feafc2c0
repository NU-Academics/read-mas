{"task_id": "HumanEval/5", "solution": "from typing import List\n\n\ndef intersperse(numbers: List[int], delimeter: int) -> List[int]:\n    \"\"\" Insert a number 'delimeter' between every two consecutive elements of input list `numbers'\n    >>> intersperse([], 4)\n    []\n    >>> intersperse([1, 2, 3], 4)\n    [1, 4, 2, 4, 3]\n    \"\"\"\n    if not numbers:\n        return []\n\n    result = []\n    for i, num in enumerate(numbers):\n        if i > 0:\n            result.append(delimeter)\n        result.append(num)\n    return result"}
{"task_id": "HumanEval/1", "solution": "from typing import List\n\nclass InputString:\n    \"\"\"Encapsulates raw input and provides normalized string.\"\"\"\n    def __init__(self, raw: str) -> None:\n        self.raw = raw\n\n    def normalized(self) -> str:\n        \"\"\"Returns raw string with all whitespace characters removed.\"\"\"\n        return self.raw.replace(' ', '').replace('\\t', '').replace('\\n', '')\n\nclass ParenGroup:\n    \"\"\"Represents a single top-level parenthesis group, storing its content and order.\"\"\"\n    def __init__(self, content: str, order_index: int) -> None:\n        self.content = content\n        self.order_index = order_index\n        self.nesting_level = 0\n\n    def __repr__(self) -> str:\n        return f\"ParenGroup(content='{self.content}', order_index={self.order_index}, nesting_level={self.nesting_level})\"\n\nclass OutputList:\n    \"\"\"Collects ParenGroup instances and facilitates conversion to a list of content strings.\"\"\"\n    def __init__(self) -> None:\n        self.groups: List[ParenGroup] = []\n\n    def add_group(self, group: ParenGroup) -> None:\n        \"\"\"Adds a ParenGroup object to the internal list.\"\"\"\n        self.groups.append(group)\n\n    def to_list(self) -> List[str]:\n        \"\"\"Returns the content of all collected groups as a list of strings.\"\"\"\n        return [g.content for g in self.groups]\n\nclass Parser:\n    \"\"\"Scans a normalized string to identify and construct top-level balanced ParenGroup objects.\"\"\"\n    def __init__(self) -> None:\n        pass\n\n    def parse(self, input_string: InputString) -> List[ParenGroup]:\n        \"\"\"Parses the normalized input string into a list of ParenGroup objects.\"\"\"\n        normalized = input_string.normalized()\n        balance = 0\n        group_start = None\n        groups: List[ParenGroup] = []\n        order_index = 0\n        current_group_max_balance = 0\n\n        for i, char in enumerate(normalized):\n            if char == '(':\n                if balance == 0:\n                    group_start = i\n                    current_group_max_balance = 1\n                else:\n                    current_group_max_balance = max(current_group_max_balance, balance + 1)\n                balance += 1\n            elif char == ')':\n                balance -= 1\n                if balance == 0:\n                    group_content = normalized[group_start:i+1]\n                    nesting_level = current_group_max_balance\n                    group = ParenGroup(content=group_content, order_index=order_index)\n                    group.nesting_level = nesting_level\n                    groups.append(group)\n                    order_index += 1\n        return groups\n\n\ndef separate_paren_groups(paren_string: str) -> List[str]:\n    \"\"\" Input to this function is a string containing multiple groups of nested parentheses. Your goal is to\n    separate those group into separate strings and return the list of those.\n    Separate groups are balanced (each open brace is properly closed) and not nested within each other\n    Ignore any spaces in the input string.\n    >>> separate_paren_groups('( ) (( )) (( )( ))')\n    ['()', '(())', '(()())']\n    \"\"\"\n    input_obj = InputString(raw=paren_string)\n    parser = Parser()\n    groups = parser.parse(input_obj)\n    output = OutputList()\n    for g in groups:\n        output.add_group(g)\n    return output.to_list()"}
{"task_id": "HumanEval/2", "solution": "from math import floor, isfinite\n\ndef _is_valid(number: float) -> bool:\n    \"\"\"Checks if the number is finite and non-negative.\"\"\"\n    return isfinite(number) and number >= 0.0\n\ndef _compute_integer_part(number: float) -> int:\n    \"\"\"Computes the integer part of a positive float using floor.\"\"\"\n    return int(floor(number))\n\ndef _compute_fractional_part(number: float, integer_part: int) -> float:\n    \"\"\"Computes the fractional part by subtracting the integer part.\"\"\"\n    return number - float(integer_part)\n\ndef truncate_number(number: float) -> float:\n    \"\"\" Given a positive floating point number, it can be decomposed into\n    and integer part (largest integer smaller than given number) and decimals\n    (leftover part always smaller than 1).\n\n    Return the decimal part of the number.\n    >>> truncate_number(3.5)\n    0.5\n    \"\"\"\n    if not _is_valid(number):\n        if not isfinite(number):\n            raise ValueError(f\"invalid input: {number} is not a finite number.\")\n        else:\n            raise ValueError(f\"invalid input: {number} is a negative number. Only non-negative numbers are allowed.\")\n\n    integer_part = _compute_integer_part(number)\n    fractional = _compute_fractional_part(number, integer_part)\n    return fractional"}
{"task_id": "HumanEval/6", "solution": "from typing import List\n\n\nclass NestingResult:\n    \"\"\"Collects computed depths and provides them as typing.List[int].\"\"\"\n    def __init__(self):\n        self.depths: List[int] = []\n\n    def as_list(self) -> List[int]:\n        \"\"\"Returns the collected depths.\"\"\"\n        return self.depths\n\n\nclass InputString:\n    \"\"\"Value-object wrapper around the input string providing trimmed/emptiness checks.\"\"\"\n    def __init__(self, value: str):\n        self.value: str = value\n\n    def is_empty(self) -> bool:\n        \"\"\"True if the trimmed value of the input string is empty.\"\"\"\n        return self.value.strip() == ''\n\n\nclass Group:\n    \"\"\"Represents a single whitespace-separated parenthesis group and encapsulates the depth computation.\"\"\"\n    def __init__(self, text: str):\n        self.text: str = text\n        self.max_depth: int = 0\n\n    def compute_max_depth(self) -> int:\n        \"\"\"Computes and sets the maximum nesting depth for the group.\"\"\"\n        current_depth = 0\n        max_seen_depth = 0\n        for char in self.text:\n            if char == '(':\n                current_depth += 1\n                max_seen_depth = max(max_seen_depth, current_depth)\n            elif char == ')':\n                current_depth -= 1\n        self.max_depth = max_seen_depth\n        return self.max_depth\n\n\nclass Parser:\n    \"\"\"Orchestrates parsing pipeline: trimming, splitting, per-group computation, and result assembly.\"\"\"\n    def __init__(self):\n        # No internal fields for _input or _groups as per the design that these are transient\n        # for a single parse operation within the parse_nested_parens method.\n        pass\n\n    def parse_nested_parens(self, paren_string: str) -> List[int]:\n        \"\"\"Parses the input string and returns a list of max nesting depths.\"\"\"\n        input_obj = InputString(paren_string)\n        if input_obj.is_empty():\n            return []\n\n        group_texts = self._split_input(paren_string)\n        results = NestingResult()\n\n        for text in group_texts:\n            group = Group(text)\n            results.depths.append(group.compute_max_depth())\n        \n        return results.as_list()\n\n    def _split_input(self, paren_string: str) -> List[str]:\n        \"\"\"Trims leading/trailing whitespace and splits the input string by spaces.\"\"\"\n        return paren_string.strip().split(' ')\n\n\ndef parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\" Input to this function is a string represented multiple groups for nested parentheses separated by spaces.\n    For each of the group, output the deepest level of nesting of parentheses.\n    E.g. (()()) has maximum two levels of nesting while ((())) has three.\n\n    >>> parse_nested_parens('(()()) ((())) () ((())()())')\n    [2, 3, 1, 3]\n    \"\"\"\n    parser = Parser()\n    return parser.parse_nested_parens(paren_string)"}
{"task_id": "HumanEval/7", "solution": "def filter_by_substring(strings: List[str], substring: str) -> List[str]:\n    \"\"\" Filter an input list of strings only for ones that contain given substring\n    >>> filter_by_substring([], 'a')\n    []\n    >>> filter_by_substring(['abc', 'bacd', 'cde', 'array'], 'a')\n    ['abc', 'bacd', 'array']\n    \"\"\"\n    return [s for s in strings if substring in s]"}
{"task_id": "HumanEval/0", "solution": "from typing import List\n\n\ndef has_close_elements(numbers: List[float], threshold: float) -> bool:\n    \"\"\" Check if in given list of numbers, are any two numbers closer to each other than\n    given threshold.\n    >>> has_close_elements([1.0, 2.0, 3.0], 0.5)\n    False\n    >>> has_close_elements([1.0, 2.8, 3.0, 4.0, 5.0, 2.0], 0.3)\n    True\n    \"\"\"\n    n = len(numbers)\n    if n < 2:\n        return False\n\n    for i in range(n):\n        for j in range(i + 1, n):\n            if abs(numbers[i] - numbers[j]) < threshold:\n                return True\n    return False"}
{"task_id": "HumanEval/4", "solution": "from typing import List\n\nclass Validator:\n    \"\"\"Validator to enforce non-empty and numeric element rules.\"\"\"\n    def validate_non_empty(self, numbers: List[float]) -> bool:\n        \"\"\"Return True if numbers is a list with len(numbers) > 0; otherwise raise ValueError.\"\"\"\n        if not numbers:\n            raise ValueError(\"Input list cannot be empty.\")\n        return True\n\n    def validate_numeric(self, numbers: List[float]) -> bool:\n        \"\"\"Return True if every element in numbers is numeric; otherwise raise TypeError or ValueError.\"\"\"\n        for num in numbers:\n            if not isinstance(num, (int, float)):\n                raise TypeError(\"All elements in the input list must be numeric (int or float).\")\n        return True\n\nclass StatisticsCalculator:\n    \"\"\"StatisticsCalculator for mean and MAD computations.\"\"\"\n    def compute_mean(self, numbers: List[float]) -> float:\n        \"\"\"Compute arithmetic mean as sum(numbers) / len(numbers).\"\"\"\n        if not numbers:\n            raise ValueError(\"Cannot compute mean of an empty list.\") # Should be caught by Validator.\n        return sum(numbers) / len(numbers)\n\n    def compute_absolute_differences(self, numbers: List[float], mean: float) -> List[float]:\n        \"\"\"For each x in numbers compute abs(x - mean).\"\"\"\n        return [abs(x - mean) for x in numbers]\n\n    def compute_average(self, numbers: List[float]) -> float:\n        \"\"\"Compute arithmetic mean of numbers (used to compute MAD).\"\"\"\n        return self.compute_mean(numbers)\n\ndef mean_absolute_deviation(numbers: List[float]) -> float:\n    \"\"\" For a given list of input numbers, calculate Mean Absolute Deviation\n    around the mean of this dataset.\n    Mean Absolute Deviation is the average absolute difference between each\n    element and a centerpoint (mean in this case):\n    MAD = average | x - x_mean |\n    >>> mean_absolute_deviation([1.0, 2.0, 3.0, 4.0])\n    1.0\n    \"\"\"\n    validator = Validator()\n    stats_calculator = StatisticsCalculator()\n\n    # Validate input list\n    validator.validate_non_empty(numbers)\n    validator.validate_numeric(numbers)\n\n    # Compute mean\n    mean_value = stats_calculator.compute_mean(numbers)\n\n    # Compute absolute differences from the mean\n    abs_diffs = stats_calculator.compute_absolute_differences(numbers, mean_value)\n\n    # Compute the average of absolute differences (MAD)\n    mad_value = stats_calculator.compute_average(abs_diffs)\n\n    return mad_value"}
{"task_id": "HumanEval/3", "solution": "from typing import List, Iterator\n\n\nclass BalanceChecker:\n    def __init__(self) -> None:\n        self.balance: int = 0\n\n    def below_zero(self, operations: List[int]) -> bool:\n        \"\"\"Return True at first prefix that yields balance < 0; raise TypeError if any element is not int.\"\"\"\n        self.balance = 0\n        seq = 0\n        for amount in operations:\n            seq += 1\n            if not isinstance(amount, int):\n                raise TypeError(f\"operation at index {seq-1} is not int: {type(amount).__name__}\")\n            self.balance += amount\n            if self.balance < 0:\n                return True\n        return False\n\n\ndef below_zero(operations: List[int]) -> bool:\n    \"\"\"Public entry point per SRS: below_zero(operations: List[int]) -> bool.\n    Behavior: validate that operations is a list, then delegate to BalanceChecker.below_zero.\n    \"\"\"\n    if not isinstance(operations, list):\n        raise TypeError(\"operations must be a list of ints\")\n    checker = BalanceChecker()\n    return checker.below_zero(operations)"}
{"task_id": "HumanEval/8", "solution": "from typing import List, Tuple\n\n\ndef sum_product(numbers: List[int]) -> Tuple[int, int]:\n    \"\"\" For a given list of integers, return a tuple consisting of a sum and a product of all the integers in a list.\n    Empty sum should be equal to 0 and empty product should be equal to 1.\n    >>> sum_product([])\n    (0, 1)\n    >>> sum_product([1, 2, 3, 4])\n    (10, 24)\n    \"\"\"\n    total: int = 0\n    product: int = 1\n    for n in numbers:\n        total += n\n        product *= n\n    return (total, product)"}
{"task_id": "HumanEval/11", "solution": "from typing import List\n\n\nclass BinaryString:\n    \"\"\"Encapsulates an input binary string, provides length, character access, and validity check.\"\"\"\n    def __init__(self, value: str) -> None:\n        self.value = value\n\n    def length(self) -> int:\n        \"\"\"Return length of the string value.\"\"\"\n        return len(self.value)\n\n    def is_valid(self) -> bool:\n        \"\"\"Return True if all characters are '0' or '1'.\"\"\"\n        return all(char in ('0', '1') for char in self.value)\n\n    def char_at(self, i: int) -> str:\n        \"\"\"Return character at index i.\"\"\"\n        return self.value[i]\n\n\nclass ResultString:\n    \"\"\"Builds and holds the XOR result string composed only of '0' and '1'.\"\"\"\n    def __init__(self) -> None:\n        self._value: List[str] = []\n\n    def append_char(self, c: str) -> None:\n        \"\"\"Append a single character '0' or '1' to the internal list.\"\"\"\n        self._value.append(c)\n\n    def length(self) -> int:\n        \"\"\"Return length of the accumulated string.\"\"\"\n        return len(self._value)\n\n    def __str__(self) -> str:\n        \"\"\"Return the joined string value.\"\"\"\n        return \"\".join(self._value)\n\n\ndef string_xor(a: str, b: str) -> str:\n    \"\"\" Input are two strings a and b consisting only of 1s and 0s.\n    Perform binary XOR on these inputs and return result also as a string.\n    >>> string_xor('010', '110')\n    '100'\n    \"\"\"\n    bin_a = BinaryString(a)\n    bin_b = BinaryString(b)\n\n    if not bin_a.is_valid():\n        raise ValueError(\"Input 'a' must contain only '0' or '1' characters.\")\n    if not bin_b.is_valid():\n        raise ValueError(\"Input 'b' must contain only '0' or '1' characters.\")\n\n    if bin_a.length() != bin_b.length():\n        raise ValueError(\"Input strings 'a' and 'b' must have equal length.\")\n\n    result_string = ResultString()\n    common_length = bin_a.length()\n\n    for i in range(common_length):\n        char_a = bin_a.char_at(i)\n        char_b = bin_b.char_at(i)\n        \n        # Perform XOR: '1' if bits are different, '0' if bits are the same.\n        if char_a != char_b:\n            result_string.append_char('1')\n        else:\n            result_string.append_char('0')\n            \n    return str(result_string)"}
{"task_id": "HumanEval/12", "solution": "from typing import List, Optional\n\n\ndef longest(strings: List[str]) -> Optional[str]:\n    \"\"\" Out of list of strings, return the longest one. Return the first one in case of multiple\n    strings of the same length. Return None in case the input list is empty.\n    \"\"\"\n    if not strings:\n        return None\n\n    longest_str = None\n    max_length = -1\n\n    for s in strings:\n        current_length = len(s)\n        if current_length > max_length:\n            max_length = current_length\n            longest_str = s\n    \n    return longest_str"}
{"task_id": "HumanEval/13", "solution": "def greatest_common_divisor(a: int, b: int) -> int:\n    \"\"\" Return a greatest common divisor of two integers a and b\n    >>> greatest_common_divisor(3, 5)\n    1\n    >>> greatest_common_divisor(25, 15)\n    5\n    \"\"\"\n    # Use the Euclidean algorithm to find the greatest common divisor.\n    while b:\n        a, b = b, a % b\n    return a"}
{"task_id": "HumanEval/9", "solution": "from typing import List, Tuple\n\n\ndef rolling_max(numbers: List[int]) -> List[int]:\n    \"\"\" From a given list of integers, generate a list of rolling maximum element found until given moment\n    in the sequence.\n    >>> rolling_max([1, 2, 3, 2, 3, 4, 2])\n    [1, 2, 3, 3, 3, 4, 4]\n    \"\"\"\n    if not numbers:\n        return []\n\n    result = []\n    current_max = float('-inf')\n\n    for number in numbers:\n        current_max = max(current_max, number)\n        result.append(current_max)\n\n    return result"}
{"task_id": "HumanEval/14", "solution": "from typing import List\nfrom dataclasses import dataclass\n\n\n@dataclass\nclass InputString:\n    value: str\n\n    def length(self) -> int:\n        return len(self.value)\n\n\n@dataclass\nclass Prefix:\n    value: str\n    index: int\n\n    def length(self) -> int:\n        return len(self.value)\n\n\nclass PrefixList:\n    prefixes: List[Prefix]\n\n    def __init__(self, prefixes: List[Prefix]) -> None:\n        self.prefixes = prefixes\n\n    def size(self) -> int:\n        return len(self.prefixes)\n\n    def as_strings(self) -> List[str]:\n        return [p.value for p in self.prefixes]\n\n\ndef all_prefixes(string: str) -> List[str]:\n    \"\"\" Return list of all prefixes from shortest to longest of the input string\n    >>> all_prefixes('abc')\n    ['a', 'ab', 'abc']\n    \"\"\"\n    if not string:\n        return []\n\n    # The design context mentions InputString for traceability, though not strictly used in the return value.\n    # input_str = InputString(string) # Commented out as it's not directly used for the final result.\n\n    generated_prefixes: List[Prefix] = []\n    for i in range(len(string)):\n        prefix_value = string[0:i+1]\n        generated_prefixes.append(Prefix(value=prefix_value, index=i))\n\n    prefix_list = PrefixList(prefixes=generated_prefixes)\n    return prefix_list.as_strings()"}
{"task_id": "HumanEval/15", "solution": "from typing import List\n\ndef _validate_n(n: int) -> None:\n    \"\"\"Validates the input n to be a non-negative integer.\"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer.\")\n    if n < 0:\n        raise ValueError(\"n must be a non-negative integer.\")\n\ndef _generate_sequence(n: int) -> List[int]:\n    \"\"\"Generates a list of integers from 0 to n inclusive.\"\"\"\n    return list(range(n + 1))\n\ndef _format_numbers(numbers: List[int]) -> str:\n    \"\"\"Formats a list of integers into a space-delimited string.\"\"\"\n    return ' '.join(str(x) for x in numbers)\n\ndef string_sequence(n: int) -> str:\n    \"\"\" Return a string containing space-delimited numbers starting from 0 upto n inclusive.\n    >>> string_sequence(0)\n    '0'\n    >>> string_sequence(5)\n    '0 1 2 3 4 5'\n    \"\"\"\n    _validate_n(n)\n    numbers = _generate_sequence(n)\n    return _format_numbers(numbers)"}
{"task_id": "HumanEval/10", "solution": "def make_palindrome(string: str) -> str:\n    \"\"\" Find the shortest palindrome that begins with a supplied string.\n    Algorithm idea is simple:\n    - Find the longest postfix of supplied string that is a palindrome.\n    - Append to the end of the string reverse of a string prefix that comes before the palindromic suffix.\n    >>> make_palindrome('')\n    ''\n    >>> make_palindrome('cat')\n    'catac'\n    >>> make_palindrome('cata')\n    'catac'\n    \"\"\"\n    for i in range(len(string)):\n        suffix = string[i:]\n        if is_palindrome(suffix):\n            prefix_to_reverse = string[0:i]\n            reversed_prefix = prefix_to_reverse[::-1]\n            return string + reversed_prefix\n    return string"}
{"task_id": "HumanEval/16", "solution": "def _normalize_char(ch: str) -> str:\n    \"\"\"Return Unicode-aware normalized character for case-insensitive comparison (uses str.casefold()).\"\"\"\n    return ch.casefold()\n\ndef count_distinct_characters(string: str) -> int:\n    \"\"\" Given a string, find out how many distinct characters (regardless of case) does it consist of\n    >>> count_distinct_characters('xyzXYZ')\n    3\n    >>> count_distinct_characters('Jerry')\n    4\n    \"\"\"\n    distinct_chars = set()\n    for char in string:\n        normalized_char = _normalize_char(char)\n        distinct_chars.add(normalized_char)\n    return len(distinct_chars)"}
{"task_id": "HumanEval/18", "solution": "def how_many_times(string: str, substring: str) -> int:\n    \"\"\" Find how many times a given substring can be found in the original string. Count overlaping cases.\n    >>> how_many_times('', 'a')\n    0\n    >>> how_many_times('aaa', 'a')\n    3\n    >>> how_many_times('aaaa', 'aa')\n    3\n    \"\"\"\n    count = 0\n    len_string = len(string)\n    len_substring = len(substring)\n\n    # If the substring is empty, there are no meaningful overlaps, and it's not explicitly defined.\n    # The current loop correctly handles this for non-empty string.\n    # For an empty string, the loop range will be empty or yield 0.\n    if len_substring == 0:\n        # If substring is empty, typically it's considered to occur at every position\n        # including before the first character and after the last.\n        # However, the SRS doesn't specify behavior for empty substrings,\n        # so we'll rely on the current loop's natural behavior or return 0 for simplicity\n        # as it aligns with the 'finding' concept if not explicitly defined.\n        # Given the examples and \"Count overlaping cases\", an empty substring is usually a special case.\n        # Sticking to the most literal interpretation for non-empty substring from examples.\n        # For simplicity and given no examples, we return 0 for an empty substring,\n        # as a non-empty string cannot \"contain\" an empty string in a meaningful \"overlap\" sense\n        # without further definition. Or if we strictly follow the loop, for 'abc', '' it gives 4.\n        # Let's keep the loop general and see how it performs, but for `substring == ''` it will\n        # count `len(string) + 1` times. This is common behavior, but if this is not desired,\n        # an explicit check for `len_substring == 0` is needed.\n        # Given no examples for empty substring, the most conservative approach for *this* design\n        # would be to not over-engineer for that specific case.\n        # The loop naturally handles len_substring == 0 returning len(string) + 1.\n        # Let's assume the provided examples sufficiently define behavior.\n        # For the given examples, this general loop is correct.\n        if len_string == 0:\n            return 0\n        return len_string + 1 # This is the standard Python `str.count` behavior for empty substring\n\n    for i in range(len_string - len_substring + 1):\n        if string[i : i + len_substring] == substring:\n            count += 1\n    return count"}
{"task_id": "HumanEval/22", "solution": "from typing import List, Any\n\n\ndef filter_integers(values: List[Any]) -> List[int]:\n    \"\"\" Filter given list of any python values only for integers.\n    Uses isinstance(x, int) for inclusion, which includes bool and int subclasses.\n    >>> filter_integers(['a', 3.14, 5])\n    [5]\n    >>> filter_integers([1, 2, 3, 'abc', {}, []])\n    [1, 2, 3]\n    \"\"\"\n    if not isinstance(values, list):\n        raise TypeError(\"Input 'values' must be a list.\")\n    \n    return [item for item in values if isinstance(item, int)]"}
