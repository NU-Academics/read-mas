{"task_id": "HumanEval/26", "solution": "from typing import List, Dict\n\n\nclass FrequencyMap:\n    \"\"\"Helper class to compute and store integer frequencies.\"\"\"\n    def __init__(self) -> None:\n        self._counts: Dict[int, int] = {}\n\n    def compute(self, numbers: List[int]) -> None:\n        \"\"\"Populates frequency counts from a list of numbers.\"\"\"\n        for num in numbers:\n            self._counts[num] = self._counts.get(num, 0) + 1\n\n    @property\n    def counts(self) -> Dict[int, int]:\n        \"\"\"Returns the computed frequency map.\"\"\"\n        return self._counts\n\n\ndef remove_duplicates(numbers: List[int]) -> List[int]:\n    \"\"\" From a list of integers, remove all elements that occur more than once.\n    Keep order of elements left the same as in the input.\n    >>> remove_duplicates([1, 2, 3, 2, 4])\n    [1, 3, 4]\n    \"\"\"\n    freq_map = FrequencyMap()\n    freq_map.compute(numbers)\n\n    result: List[int] = []\n    for num in numbers:\n        if freq_map.counts[num] == 1:\n            result.append(num)\n\n    return result"}
{"task_id": "HumanEval/29", "solution": "from typing import List\n\n\ndef filter_by_prefix(strings: List[str], prefix: str) -> List[str]:\n    \"\"\" Filter an input list of strings only for ones that start with a given prefix.\n    >>> filter_by_prefix([], 'a')\n    []\n    >>> filter_by_prefix(['abc', 'bcd', 'cde', 'array'], 'a')\n    ['abc', 'array']\n    \"\"\"\n    return [s for s in strings if s.startswith(prefix)]"}
