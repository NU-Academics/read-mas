{"task_id": "HumanEval/32", "solution": "import math\n\n\ndef poly(xs: list, x: float):\n    \"\"\"\n    Evaluates polynomial with coefficients xs at point x.\n    return xs[0] + xs[1] * x + xs[1] * x^2 + .... xs[n] * x^n\n    \"\"\"\n    return sum([coeff * math.pow(x, i) for i, coeff in enumerate(xs)])\n\n\nclass Coefficient:\n    \"\"\"Data holder for coefficient and index.\"\"\"\n    def __init__(self, index: int, value: float) -> None:\n        self.index = index\n        self.value = value\n\nclass Polynomial:\n    \"\"\"Encapsulates coefficients and provides degree and evaluation using math.pow.\"\"\"\n    def __init__(self, coefficients: list) -> None:\n        self.coefficients = coefficients\n\n    def degree(self) -> int:\n        \"\"\"Returns the degree of the polynomial.\"\"\"\n        return len(self.coefficients) - 1\n\n    def evaluate(self, x: float) -> float:\n        \"\"\"Evaluates the polynomial at point x using math.pow.\"\"\"\n        return sum(coeff * math.pow(x, i) for i, coeff in enumerate(self.coefficients))\n\nclass EvaluationResult:\n    \"\"\"Holds a numeric result and supports tolerance comparison.\"\"\"\n    def __init__(self, value: float) -> None:\n        self.value = value\n\n    def toleranceCompare(self, expected: float, decimals: int) -> bool:\n        \"\"\"Compares values by rounding to a specified number of decimals.\"\"\"\n        return round(self.value, decimals) == round(expected, decimals)\n\nclass RootFinder:\n    \"\"\"Validates coefficient lists and performs deterministic root search.\"\"\"\n    def __init__(self, tolerance: float = 1e-9) -> None:\n        self.tolerance = tolerance\n        self._max_bisection_iterations = 100\n        self._search_min = -100.0\n        self._search_max = 100.0\n        self._search_step = 1.0\n\n    def _validate_coeffs(self, xs: list) -> None:\n        \"\"\"Validates the input coefficients list, raising ValueError on invalid input.\"\"\"\n        if not isinstance(xs, list):\n            raise ValueError(\"Coefficients must be provided as a list.\")\n        if len(xs) == 0:\n            raise ValueError(\"Coefficient list cannot be empty.\")\n        if len(xs) % 2 != 0:\n            raise ValueError(\"Coefficient list must have an even number of coefficients.\")\n        if xs[-1] == 0.0:\n            raise ValueError(\"Highest-degree coefficient must not be zero.\")\n\n    def _search_root(self, poly: Polynomial) -> float:\n        \"\"\"Performs deterministic scan and bisection to find the first real root.\"\"\"\n        prev_x = self._search_min\n        prev_y = poly.evaluate(prev_x)\n\n        if abs(prev_y) < self.tolerance: # Check if the starting point is already a root\n            return prev_x\n\n        current_x = self._search_min + self._search_step\n        while current_x <= self._search_max:\n            current_y = poly.evaluate(current_x)\n\n            if abs(current_y) < self.tolerance: # Found a root directly on a step point\n                return current_x\n\n            if prev_y * current_y < 0: # Sign change detected, a root is in [prev_x, current_x]\n                low = prev_x\n                high = current_x\n                \n                for _ in range(self._max_bisection_iterations):\n                    mid = (low + high) / 2.0\n                    y_mid = poly.evaluate(mid)\n\n                    if abs(y_mid) < self.tolerance:\n                        return mid\n                    \n                    if y_mid * poly.evaluate(low) < 0: # Root is in the lower half\n                        high = mid\n                    else: # Root is in the upper half\n                        low = mid\n                return mid # Return the best approximation found by bisection\n            \n            prev_x = current_x\n            prev_y = current_y\n            current_x += self._search_step\n            \n        raise ValueError(\"No real root found within the search range and tolerance.\")\n\n\n    def find_zero(self, xs: list) -> float:\n        \"\"\"Finds a single real root for a polynomial after validation.\"\"\"\n        self._validate_coeffs(xs)\n        polynomial_obj = Polynomial(xs)\n        root = self._search_root(polynomial_obj)\n        return root\n\n\ndef find_zero(xs: list):\n    \"\"\" xs are coefficients of a polynomial.\n    find_zero find x such that poly(x) = 0.\n    find_zero returns only only zero point, even if there are many.\n    Moreover, find_zero only takes list xs having even number of coefficients\n    and largest non zero coefficient as it guarantees\n    a solution.\n    >>> round(find_zero([1, 2]), 2) # f(x) = 1 + 2x\n    -0.5\n    >>> round(find_zero([-6, 11, -6, 1]), 2) # (x - 1) * (x - 2) * (x - 3) = -6 + 11x - 6x^2 + x^3\n    1.0\n    \"\"\"\n    root_finder = RootFinder()\n    return root_finder.find_zero(xs)"}
{"task_id": "HumanEval/33", "solution": "\nclass Comparator:\n    \"\"\"Encapsulates comparison logic. Uses Python native comparisons.\"\"\"\n    @staticmethod\n    def compare(a, b) -> int:\n        if a < b:\n            return -1\n        elif a == b:\n            return 0\n        else:\n            return 1\n\nclass Subsequence:\n    \"\"\"Container for indices and elements, providing sorting operation.\"\"\"\n    def __init__(self, indices: list[int], elements: list) -> None:\n        self.indices = indices\n        self.elements = elements\n\n    def sortAscending(self) -> None:\n        \"\"\"Sorts self.elements in non-decreasing order.\"\"\"\n        self.elements.sort()\n\ndef _extract_indices(l: list) -> list[int]:\n    \"\"\"Returns a list of integer indices i in range(len(l)) where i % 3 == 0.\"\"\"\n    return [i for i in range(len(l)) if i % 3 == 0]\n\ndef _extract_subsequence(l: list) -> Subsequence:\n    \"\"\"Creates a Subsequence(indices, elements) for indices where i % 3 == 0.\"\"\"\n    indices = _extract_indices(l)\n    elements = [l[i] for i in indices]\n    return Subsequence(indices, elements)\n\ndef _reinsert_sorted(base: list, indices: list[int], sorted_values: list) -> list:\n    \"\"\"Returns a new list with values at specified indices replaced by sorted_values.\"\"\"\n    result = base[:]\n    for i, idx in enumerate(indices):\n        result[idx] = sorted_values[i]\n    return result\n\ndef sort_third(l: list):\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the indicies that are not divisible by three, while its values at the indicies that are divisible by three are equal\n    to the values of the corresponding indicies of l, but sorted.\n    >>> sort_third([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_third([5, 6, 3, 4, 8, 9, 2])\n    [2, 6, 3, 4, 8, 9, 5]\n    \"\"\"\n    if not l:\n        return []\n\n    subseq = _extract_subsequence(l)\n    subseq.sortAscending()\n    \n    result = _reinsert_sorted(l, subseq.indices, subseq.elements)\n    return result"}
{"task_id": "HumanEval/34", "solution": "def unique(l: list):\n    \"\"\"Return sorted unique elements in a list\n    >>> unique([5, 3, 5, 2, 3, 3, 9, 0, 123])\n    [0, 2, 3, 5, 9, 123]\n    \"\"\"\n    unique_elements = []\n    for item in l:\n        if item not in unique_elements:\n            unique_elements.append(item)\n    return sorted(unique_elements)"}
{"task_id": "HumanEval/37", "solution": "def sort_even(l: list):\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the odd indicies, while its values at the even indicies are equal\n    to the values of the even indicies of l, but sorted.\n    >>> sort_even([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_even([5, 6, 3, 4])\n    [3, 6, 5, 4]\n    \"\"\"\n\n    def _extract_even_elements(lst: list) -> list:\n        \"\"\"Extracts values from even indices of a list, preserving their original order.\"\"\"\n        even_values = []\n        for i in range(0, len(lst), 2):\n            even_values.append(lst[i])\n        return even_values\n\n    def _merge_sorted_even(original_lst: list, sorted_even_values: list) -> list:\n        \"\"\"Merges sorted even values back into a new list, copying odd-indexed values from the original list.\"\"\"\n        result_lst = [0] * len(original_lst) # Initialize with placeholder values\n        sorted_even_idx = 0\n        for i in range(len(original_lst)):\n            if i % 2 == 0:  # Even index\n                result_lst[i] = sorted_even_values[sorted_even_idx]\n                sorted_even_idx += 1\n            else:  # Odd index\n                result_lst[i] = original_lst[i]\n        return result_lst\n\n    even_elements = _extract_even_elements(l)\n    sorted_even_elements = sorted(even_elements)\n    result = _merge_sorted_even(l, sorted_even_elements)\n    return result"}
{"task_id": "HumanEval/36", "solution": "from typing import List, Iterable, Optional\n\nclass DivisibilityFilter:\n    \"\"\"Filters integers based on divisibility by a list of divisors.\"\"\"\n    def __init__(self, divisors: Optional[List[int]] = None) -> None:\n        self.divisors = divisors if divisors is not None else [11, 13]\n\n    def is_divisible(self, i: int) -> bool:\n        \"\"\"Checks if an integer is divisible by any of the configured divisors.\"\"\"\n        return any(i % d == 0 for d in self.divisors)\n\n    def filter(self, nums: Iterable[int]) -> List[int]:\n        \"\"\"Returns a list of numbers from the iterable that are divisible by any configured divisor.\"\"\"\n        return [num for num in nums if self.is_divisible(num)]\n\nclass DigitCounter:\n    \"\"\"Counts occurrences of a specific digit in integers.\"\"\"\n    def count_digit(self, i: int, d: str) -> int:\n        \"\"\"Counts how many times a digit appears in the decimal representation of an integer.\"\"\"\n        return str(abs(i)).count(d)\n\n    def count_in_list(self, nums: Iterable[int], d: str) -> int:\n        \"\"\"Sums the count of a digit for all integers in a list.\"\"\"\n        total_count = 0\n        for num in nums:\n            total_count += self.count_digit(num, d)\n        return total_count\n\ndef fizz_buzz(n: int):\n    \"\"\"Return the number of times the digit 7 appears in integers less than n which are divisible by 11 or 13.\n    >>> fizz_buzz(50)\n    0\n    >>> fizz_buzz(78)\n    2\n    >>> fizz_buzz(79)\n    3\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n    if n <= 0:\n        return 0\n\n    div_filter = DivisibilityFilter()\n    digit_counter = DigitCounter()\n\n    candidates = range(0, n)\n    qualifying_list = div_filter.filter(candidates)\n\n    total_count = digit_counter.count_in_list(qualifying_list, '7')\n\n    return total_count"}
{"task_id": "HumanEval/38", "solution": "def _split_into_groups(s: str) -> list:\n    \"\"\"Splits a string into groups of up to three characters.\"\"\"\n    n_groups = (len(s) + 2) // 3\n    groups = [s[3 * i : min(3 * i + 3, len(s))] for i in range(n_groups)]\n    return groups\n\ndef _rotate_left_3(group: str) -> str:\n    \"\"\"Left-rotates a 3-character group by one position.\"\"\"\n    return group[1:] + group[0]\n\ndef _rotate_right_3(group: str) -> str:\n    \"\"\"Right-rotates a 3-character group by one position.\"\"\"\n    return group[-1] + group[:-1]\n\ndef encode_cyclic(s: str):\n    \"\"\"\n    returns encoded string by cycling groups of three characters.\n    \"\"\"\n    groups = _split_into_groups(s)\n    transformed = [(_rotate_left_3(g) if len(g) == 3 else g) for g in groups]\n    return \"\".join(transformed)\n\ndef decode_cyclic(s: str):\n    \"\"\"\n    takes as input string encoded with encode_cyclic function. Returns decoded string.\n    \"\"\"\n    groups = _split_into_groups(s)\n    transformed = [(_rotate_right_3(g) if len(g) == 3 else g) for g in groups]\n    return \"\".join(transformed)"}
{"task_id": "HumanEval/42", "solution": "def incr_list(l: list):\n    \"\"\"Return list with elements incremented by 1.\n    >>> incr_list([1, 2, 3])\n    [2, 3, 4]\n    >>> incr_list([5, 3, 5, 2, 3, 3, 9, 0, 123])\n    [6, 4, 6, 3, 4, 4, 10, 1, 124]\n    \"\"\"\n    return [x + 1 for x in l]"}
{"task_id": "HumanEval/39", "solution": "import math\nfrom typing import List\n\n\nclass InputValidator:\n    \"\"\"\n    InputValidator validates that 'n' is a positive integer.\n    \"\"\"\n    def validate(self, n: int) -> bool:\n        if not isinstance(n, int):\n            raise ValueError(\"Input 'n' must be an integer.\")\n        if n < 1:\n            raise ValueError(\"Input 'n' must be a positive integer (n >= 1).\")\n        return True\n\n\nclass FibonacciNumber:\n    \"\"\"\n    FibonacciNumber is a data holder for a Fibonacci number and its zero-based index.\n    \"\"\"\n    def __init__(self, index: int, value: int):\n        self.index = index\n        self.value = value\n\n\nclass FibGenerator:\n    \"\"\"\n    FibGenerator generates Fibonacci numbers sequentially starting from F0=0, F1=1.\n    \"\"\"\n    def __init__(self):\n        self._current_fib_num = 0\n        self._next_fib_num = 1\n        self._index = 0\n\n    def reset(self):\n        self._current_fib_num = 0\n        self._next_fib_num = 1\n        self._index = 0\n\n    def next(self) -> FibonacciNumber:\n        fib_number = FibonacciNumber(self._index, self._current_fib_num)\n        temp = self._current_fib_num + self._next_fib_num\n        self._current_fib_num = self._next_fib_num\n        self._next_fib_num = temp\n        self._index += 1\n        return fib_number\n\n\nclass PrimeTester:\n    \"\"\"\n    PrimeTester determines if a given integer is a prime number.\n    \"\"\"\n    def is_prime(self, x: int) -> bool:\n        if x < 2:\n            return False\n        if x == 2:\n            return True\n        if x % 2 == 0:\n            return False\n        for i in range(3, int(math.sqrt(x)) + 1, 2):\n            if x % i == 0:\n                return False\n        return True\n\n\nclass FibonacciPrimeStore:\n    \"\"\"\n    FibonacciPrimeStore collects discovered Fibonacci prime values and allows 1-based retrieval by rank.\n    \"\"\"\n    def __init__(self):\n        self._primes: List[int] = []\n\n    def add(self, value: int) -> None:\n        self._primes.append(value)\n\n    def get(self, rank: int) -> int:\n        if not (1 <= rank <= len(self._primes)):\n            raise IndexError(\"Rank out of bounds.\")\n        return self._primes[rank - 1]\n\n    def count(self) -> int:\n        return len(self._primes)\n\n\nclass Result:\n    \"\"\"\n    Result wraps an integer value for consistent return type.\n    \"\"\"\n    def __init__(self, value: int):\n        self._value = value\n\n    def to_int(self) -> int:\n        return self._value\n\n\nclass FibonacciPrimeService:\n    \"\"\"\n    FibonacciPrimeService orchestrates validation, Fibonacci generation, primality testing, and storage\n    to find the n-th Fibonacci prime.\n    \"\"\"\n    def __init__(self):\n        self._validator = InputValidator()\n        self._generator = FibGenerator()\n        self._tester = PrimeTester()\n        self._store = FibonacciPrimeStore()\n\n    def prime_fib(self, n: int) -> int:\n        self._validator.validate(n)\n\n        self._generator.reset()\n        self._store = FibonacciPrimeStore() # Reset store for each service call\n\n        found_count = 0\n        while found_count < n:\n            fib_num_obj = self._generator.next()\n            fib_value = fib_num_obj.value\n\n            if self._tester.is_prime(fib_value):\n                self._store.add(fib_value)\n                found_count += 1\n        \n        result_value = self._store.get(n)\n        return Result(result_value).to_int()\n\n\ndef prime_fib(n: int):\n    \"\"\"\n    prime_fib returns n-th number that is a Fibonacci number and it's also prime.\n    >>> prime_fib(1)\n    2\n    >>> prime_fib(2)\n    3\n    >>> prime_fib(3)\n    5\n    >>> prime_fib(4)\n    13\n    >>> prime_fib(5)\n    89\n    \"\"\"\n    service = FibonacciPrimeService()\n    return service.prime_fib(n)"}
{"task_id": "HumanEval/40", "solution": "class IntegerElement:\n    \"\"\"Represents an integer value along with its original index.\"\"\"\n    def __init__(self, value: int, index: int):\n        self.value = value\n        self.index = index\n\n    def __lt__(self, other):\n        \"\"\"Enables sorting IntegerElement objects by their value.\"\"\"\n        return self.value < other.value\n\nclass Triplet:\n    \"\"\"Represents a triplet of IntegerElement objects.\"\"\"\n    def __init__(self, a: IntegerElement, b: IntegerElement, c: IntegerElement):\n        self.a = a\n        self.b = b\n        self.c = c\n\n    def sum(self) -> int:\n        \"\"\"Calculates the sum of the values in the triplet.\"\"\"\n        return self.a.value + self.b.value + self.c.value\n\nclass Validator:\n    \"\"\"Validates the input list and its elements.\"\"\"\n    def validate_list(self, l) -> None:\n        \"\"\"Ensures the input is a list and all its elements are integers.\"\"\"\n        if not isinstance(l, list):\n            raise TypeError(\"Input must be a list.\")\n        for item in l:\n            if not isinstance(item, int):\n                raise TypeError(f\"List elements must be integers, but found {type(item).__name__}.\")\n\nclass TripletSumChecker:\n    \"\"\"Implements the core algorithm to check for triplets summing to zero.\"\"\"\n    def triples_sum_to_zero(self, l: list) -> bool:\n        \"\"\"Checks if there are three distinct elements in the list that sum to zero.\"\"\"\n        n = len(l)\n        if n < 3:\n            return False\n\n        # Create IntegerElement objects to preserve original indices and enable sorting\n        elements = [IntegerElement(value, index) for index, value in enumerate(l)]\n        elements.sort() # Sorts based on IntegerElement's value\n\n        for i in range(n - 2):\n            left = i + 1\n            right = n - 1\n\n            while left < right:\n                current_sum = elements[i].value + elements[left].value + elements[right].value\n\n                if current_sum == 0:\n                    # Found a triplet. Since elements[i], elements[left], elements[right]\n                    # come from distinct positions in the sorted 'elements' list,\n                    # their original indices are guaranteed to be distinct.\n                    return True\n                elif current_sum < 0:\n                    left += 1\n                else: # current_sum > 0\n                    right -= 1\n        return False\n\ndef triples_sum_to_zero(l: list):\n    \"\"\"\n    triples_sum_to_zero takes a list of integers as an input.\n    it returns True if there are three distinct elements in the list that\n    sum to zero, and False otherwise.\n    \"\"\"\n    validator = Validator()\n    validator.validate_list(l)\n    checker = TripletSumChecker()\n    return checker.triples_sum_to_zero(l)"}
{"task_id": "HumanEval/45", "solution": "def triangle_area(a, h):\n    \"\"\"Given length of a side and height, return the area for a triangle.\n    >>> triangle_area(5, 3)\n    7.5\n    \"\"\"\n    return (a * h) / 2"}
{"task_id": "HumanEval/41", "solution": "def car_race_collision(n: int):\n    \"\"\"\n    Imagine a road that's a perfectly straight infinitely long line.\n    n cars are driving left to right;  simultaneously, a different set of n cars\n    are driving right to left.   The two sets of cars start out being very far from\n    each other.  All cars move in the same speed.  Two cars are said to collide\n    when a car that's moving left to right hits a car that's moving right to left.\n    However, the cars are infinitely sturdy and strong; as a result, they continue moving\n    in their trajectory as if they did not collide.\n\n    This function outputs the number of such collisions.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an int\")\n    if n < 0:\n        raise ValueError(\"n must be non-negative\")\n    return n * n"}
{"task_id": "HumanEval/44", "solution": "def change_base(x: int, base: int):\n    \"\"\"Change numerical base of input number x to base.\n    return string representation after the conversion.\n    base numbers are less than 10.\n    >>> change_base(8, 3)\n    '22'\n    >>> change_base(8, 2)\n    '1000'\n    >>> change_base(7, 2)\n    '111'\n    \"\"\"\n    if not isinstance(x, int) or not isinstance(base, int) or base < 2 or base >= 10 or x < 0:\n        raise ValueError(\"base must be integer in range 2..9 and x must be non-negative int\")\n\n    if x == 0:\n        return '0'\n\n    buf = []\n    while x > 0:\n        rem = x % base\n        buf.append(chr(ord('0') + rem))\n        x //= base\n    return ''.join(reversed(buf))"}
{"task_id": "HumanEval/43", "solution": "from __future__ import annotations\nfrom typing import List, Optional, Tuple, Dict\n\nclass Element:\n    \"\"\"Represents an element with its value and original index.\"\"\"\n    def __init__(self, value: int, index: int) -> None:\n        self.value = value\n        self.index = index\n\nclass InputList:\n    \"\"\"Adapts a raw list of integers for domain logic, providing length and indexed access.\"\"\"\n    def __init__(self, elements: list[int]) -> None:\n        self.elements = elements\n        self.length = len(elements)\n\n    def get(self, index: int) -> Element:\n        \"\"\"Returns an Element object for the given index.\"\"\"\n        return Element(self.elements[index], index)\n\nclass Result:\n    \"\"\"A data carrier for the result of a pair search, indicating if a pair was found and their indices.\"\"\"\n    def __init__(self, hasPair: bool, elem1_index: int | None = None, elem2_index: int | None = None) -> None:\n        self.hasPair = hasPair\n        self.elem1_index = elem1_index\n        self.elem2_index = elem2_index\n\nclass PairChecker:\n    \"\"\"Responsible for finding two distinct elements in an InputList that sum to zero.\"\"\"\n    def __init__(self) -> None:\n        pass\n\n    def has_zero_sum_pair(self, input_list: InputList) -> bool:\n        \"\"\"Checks if the input list contains two distinct elements that sum to zero.\"\"\"\n        if input_list.length < 2:\n            return False\n        \n        pair = self.findPair(input_list)\n        return pair is not None\n\n    def findPair(self, input_list: InputList) -> Optional[Tuple[Element, Element]]:\n        \"\"\"Searches for two elements with distinct indices summing to zero.\"\"\"\n        value_to_indices: Dict[int, List[int]] = {}\n\n        for i in range(input_list.length):\n            current_value = input_list.elements[i]\n            target = -current_value\n\n            if target in value_to_indices:\n                # Check for an existing index of the target that is different from the current index.\n                for target_index in value_to_indices[target]:\n                    if target_index != i:\n                        return (input_list.get(target_index), input_list.get(i))\n            \n            # Store the current value's index for future lookups.\n            value_to_indices.setdefault(current_value, []).append(i)\n        \n        return None\n\ndef pairs_sum_to_zero(l: list[int]) -> bool:\n    \"\"\"\n    pairs_sum_to_zero takes a list of integers as an input.\n    it returns True if there are two distinct elements in the list that\n    sum to zero, and False otherwise.\n    >>> pairs_sum_to_zero([1, 3, 5, 0])\n    False\n    >>> pairs_sum_to_zero([1, 3, -2, 1])\n    False\n    >>> pairs_sum_to_zero([1, 2, 3, 7])\n    False\n    >>> pairs_sum_to_zero([2, 4, -5, 3, 5, 7])\n    True\n    >>> pairs_sum_to_zero([1])\n    False\n    \"\"\"\n    input_list = InputList(l)\n    checker = PairChecker()\n    return checker.has_zero_sum_pair(input_list)"}
{"task_id": "HumanEval/46", "solution": "def fib4(n: int):\n    \"\"\"The Fib4 number sequence is a sequence similar to the Fibbonacci sequnece that's defined as follows:\n    fib4(0) -> 0\n    fib4(1) -> 0\n    fib4(2) -> 2\n    fib4(3) -> 0\n    fib4(n) -> fib4(n-1) + fib4(n-2) + fib4(n-3) + fib4(n-4).\n    \"\"\"\n    if n == 0:\n        return 0\n    elif n == 1:\n        return 0\n    elif n == 2:\n        return 2\n    elif n == 3:\n        return 0\n\n    # Initialize with the base case values for fib4(0), fib4(1), fib4(2), fib4(3)\n    # a = fib4(k-4), b = fib4(k-3), c = fib4(k-2), d = fib4(k-1)\n    a, b, c, d = 0, 0, 2, 0\n\n    for _ in range(4, n + 1):\n        next_fib = a + b + c + d\n        a, b, c, d = b, c, d, next_fib\n    \n    return d"}
{"task_id": "HumanEval/48", "solution": "def is_palindrome(text: str):\n    \"\"\"\n    Checks if given string is a palindrome\n    >>> is_palindrome('')\n    True\n    >>> is_palindrome('aba')\n    True\n    >>> is_palindrome('aaaaa')\n    True\n    >>> is_palindrome('zbcd')\n    False\n    \"\"\"\n    if type(text) is not str:\n        raise TypeError(\"Input must be a string.\")\n    return text == text[::-1]"}
{"task_id": "HumanEval/47", "solution": "def median(l: list):\n    \"\"\"Return median of elements in the list l.\n    >>> median([3, 1, 2, 4, 5])\n    3\n    >>> median([-10, 4, 6, 1000, 10, 20])\n    15.0\n    \"\"\"\n\n    def _sorted_list(l_inner: list) -> list:\n        \"\"\"Return a sorted shallow copy of the input list.\"\"\"\n        return sorted(l_inner)\n\n    def _compute_median_sorted(sorted_l_inner: list):\n        \"\"\"Compute median on an already-sorted list, assuming it's non-empty.\"\"\"\n        n = len(sorted_l_inner)\n        if n % 2 == 1:\n            # Odd length, return the middle element\n            return sorted_l_inner[n // 2]\n        else:\n            # Even length, return the arithmetic mean of the two middle elements\n            a = sorted_l_inner[n // 2 - 1]\n            b = sorted_l_inner[n // 2]\n            return (a + b) / 2\n\n    # Validation for empty list and numeric elements are omitted per specific instructions.\n    # The function assumes a non-empty list of numeric elements.\n\n    sorted_l = _sorted_list(l)\n    return _compute_median_sorted(sorted_l)"}
{"task_id": "HumanEval/51", "solution": "VOWEL_CHARS = frozenset({'a', 'e', 'i', 'o', 'u'})\n\ndef remove_vowels(text):\n    \"\"\"\n    remove_vowels is a function that takes string and returns string without vowels.\n    >>> remove_vowels('')\n    ''\n    >>> remove_vowels(\"abcdef\\nghijklm\")\n    'bcdf\\nghjklm'\n    >>> remove_vowels('abcdef')\n    'bcdf'\n    >>> remove_vowels('aaaaa')\n    ''\n    >>> remove_vowels('aaBAA')\n    'B'\n    >>> remove_vowels('zbcd')\n    'zbcd'\n    \"\"\"\n    result_chars = []\n    for char in text:\n        if char.lower() not in VOWEL_CHARS:\n            result_chars.append(char)\n    return ''.join(result_chars)"}
{"task_id": "HumanEval/52", "solution": "class InputList:\n    \"\"\"Encapsulate input list and provide is_empty() helper.\"\"\"\n    def __init__(self, items: list):\n        self.items = items\n\n    def is_empty(self) -> bool:\n        \"\"\"Returns True if items is empty.\"\"\"\n        return not self.items\n\nclass Threshold:\n    \"\"\"Encapsulate threshold integer value.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\nclass ComparisonEngine:\n    \"\"\"Provide numeric comparison semantics.\"\"\"\n    @staticmethod\n    def compare(value: int, threshold: int) -> bool:\n        \"\"\"Returns True iff value < threshold.\"\"\"\n        return value < threshold\n\nclass Result:\n    \"\"\"Encapsulate the final boolean outcome.\"\"\"\n    def __init__(self, value: bool):\n        self.value = value\n\ndef below_threshold(l: list, t: int):\n    \"\"\"Return True if all numbers in the list l are below threshold t.\n    >>> below_threshold([1, 2, 4, 10], 100)\n    True\n    >>> below_threshold([1, 20, 4, 10], 5)\n    False\n    \"\"\"\n    input_list = InputList(l)\n    threshold = Threshold(t)\n\n    if input_list.is_empty():\n        return Result(True).value\n\n    for element in input_list.items:\n        if not ComparisonEngine.compare(element, threshold.value):\n            return Result(False).value\n\n    return Result(True).value"}
