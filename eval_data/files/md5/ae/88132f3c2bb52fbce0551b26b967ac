{"task_id": "HumanEval/57", "solution": "def _is_non_decreasing(values: list) -> bool:\n    \"\"\"Checks if list elements are non-decreasing.\"\"\"\n    return all(values[i] <= values[i+1] for i in range(len(values)-1))\ndef _is_non_increasing(values: list) -> bool:\n    \"\"\"Checks if list elements are non-increasing.\"\"\"\n    return all(values[i] >= values[i+1] for i in range(len(values)-1))\ndef monotonic(l: list):\n    \"\"\"Return True is list elements are monotonically increasing or decreasing.\n    >>> monotonic([1, 2, 4, 20])\n    True\n    >>> monotonic([1, 20, 4, 10])\n    False\n    >>> monotonic([4, 1, 0, -10])\n    True\n    \"\"\"\n    if len(l) <= 1:\n        return True\n    return _is_non_decreasing(l) or _is_non_increasing(l)"}
{"task_id": "HumanEval/59", "solution": "def largest_prime_factor(n: int) -> int:\n    \"\"\"Return the largest prime factor of n. Assume n > 1 and is not a prime.\"\"\"\n    largest_factor = 1\n\n    # Divide by 2 until n is odd\n    while n % 2 == 0:\n        largest_factor = 2\n        n //= 2\n\n    # Iterate through odd numbers as potential factors\n    f = 3\n    while f * f <= n:\n        while n % f == 0:\n            largest_factor = f\n            n //= f\n        f += 2\n\n    # If n is still greater than 1, it must be the largest prime factor\n    if n > 1:\n        largest_factor = n\n\n    return largest_factor"}
