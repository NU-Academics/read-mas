{"task_id": "HumanEval/54", "solution": "import unicodedata\nimport time\nclass CharProfile:\n    \"\"\"Represents a string and its processed form, provides unique character set.\"\"\"\n    def __init__(self, raw: str):\n        self._raw: str = raw\n        self._normalized: str = raw\n\n    def get_unique_chars(self) -> set[str]:\n        return set(self._normalized)\nclass ComparisonResult:\n    \"\"\"Encapsulates comparison outcome and profiles.\"\"\"\n    def __init__(self, result: bool, s0_profile: CharProfile, s1_profile: CharProfile, timestamp: float | None = None) -> None:\n        self.result: bool = result\n        self.s0_profile: CharProfile = s0_profile\n        self.s1_profile: CharProfile = s1_profile\n        self.timestamp: float = timestamp if timestamp is not None else time.time()\nclass StringNormalizer:\n    \"\"\"Applies unicode normalization, whitespace removal, and case conversions.\"\"\"\n    def normalize(self, s: str, form: str = \"NFKC\", ignore_whitespace: bool = False, case_sensitive: bool = True) -> str:\n        s = unicodedata.normalize(form, s)\n        if ignore_whitespace:\n            s = \"\".join(s.split())\n        if not case_sensitive:\n            s = s.casefold()\n        return s\nclass CharRepository:\n    \"\"\"Cache mapping keys to ComparisonResult with in-memory storage.\"\"\"\n    def __init__(self, maxsize: int = 1024, persist_path=None):\n        self._cache = {}\n        self._maxsize = maxsize\n        self._persist_path = persist_path\n\n    def get(self, key: str):\n        return self._cache.get(key)\n\n    def set(self, key: str, result: ComparisonResult) -> None:\n        # Simple LRU-like eviction\n        if len(self._cache) >= self._maxsize:\n            if self._cache:\n                oldest_key = next(iter(self._cache))\n                del self._cache[oldest_key]\n        self._cache[key] = result\n\n    def _make_key(self, s0: str, s1: str, normalize: bool, ignore_whitespace: bool, case_sensitive: bool) -> str:\n        # Creates a deterministic key for an unordered pair and options.\n        pair = (s0, s1) if s0 <= s1 else (s1, s0)\n        opts = f\"{normalize}:{ignore_whitespace}:{case_sensitive}\"\n        return f\"{pair[0]}|{pair[1]}|{opts}\"\nclass SameCharsService:\n    \"\"\"Implements the main comparison logic for character sets.\"\"\"\n    def __init__(self, repo: CharRepository | None = None, normalizer: StringNormalizer | None = None):\n        self.repo = repo\n        self.normalizer = normalizer or StringNormalizer()\n\n    def compare(self, s0: str, s1: str, normalize: bool = False, ignore_whitespace: bool = False, case_sensitive: bool = True) -> bool:\n        key = self.repo._make_key(s0, s1, normalize, ignore_whitespace, case_sensitive) if self.repo else None\n        if self.repo:\n            cached = self.repo.get(key)\n            if cached:\n                return cached.result\n\n        # Determine if normalization or specific processing is required beyond default NFKC\n        needs_processing = normalize or ignore_whitespace or (not case_sensitive)\n\n        if needs_processing:\n            ns0 = self.normalizer.normalize(s0, ignore_whitespace=ignore_whitespace, case_sensitive=case_sensitive)\n            ns1 = self.normalizer.normalize(s1, ignore_whitespace=ignore_whitespace, case_sensitive=case_sensitive)\n        else:\n            # If no special processing, basic NFKC (often no-op for simple ASCII)\n            # The StringNormalizer handles default 'NFKC' even if flags are False.\n            # However, for efficiency, can avoid explicit call if flags are truly default.\n            # But the detailed design (services.py snippet) implies a call regardless of flags\n            # if `normalize or ignore_whitespace or (not case_sensitive)` is true,\n            # otherwise it just uses s0 directly. Let's align with the snippet's logic.\n            ns0 = s0\n            ns1 = s1\n\n        # Adjust ns0, ns1 if StringNormalizer's normalize is always called (as per design context snippet)\n        # The design context snippet for services.py had a conditional `if normalize or ignore_whitespace or (not case_sensitive)`\n        # This means default `same_chars` would skip the normalizer call and use s0 directly.\n        # Let's revert to the more precise logic from the service.py snippet.\n        ns0_processed = self.normalizer.normalize(s0, ignore_whitespace=ignore_whitespace, case_sensitive=case_sensitive) if needs_processing else s0\n        ns1_processed = self.normalizer.normalize(s1, ignore_whitespace=ignore_whitespace, case_sensitive=case_sensitive) if needs_processing else s1\n\n        result = set(ns0_processed) == set(ns1_processed)\n\n        if self.repo:\n            s0_profile = self._compute_profile(s0, normalize, ignore_whitespace, case_sensitive)\n            s1_profile = self._compute_profile(s1, normalize, ignore_whitespace, case_sensitive)\n            comparison_result = ComparisonResult(result, s0_profile, s1_profile)\n            self.repo.set(key, comparison_result)\n\n        return result\n\n    def _compute_profile(self, s: str, normalize_flag: bool, ignore_whitespace_flag: bool, case_sensitive_flag: bool) -> CharProfile:\n        \"\"\"Computes a CharProfile for a given string based on normalization options.\"\"\"\n        normalized_s = self.normalizer.normalize(\n            s,\n            normalize_flag, # Pass form via `normalize_flag` if needed, but the method has default NFKC\n            ignore_whitespace=ignore_whitespace_flag,\n            case_sensitive=case_sensitive_flag\n        )\n        profile = CharProfile(s)\n        profile._normalized = normalized_s\n        return profile\n_default_service = SameCharsService(repo=CharRepository(), normalizer=StringNormalizer())\ndef same_chars(s0: str, s1: str):\n    \"\"\"\n    Check if two words have the same characters.\n    >>> same_chars('eabcdzzzz', 'dddzzzzzzzddeddabc')\n    True\n    >>> same_chars('abcd', 'dddddddabc')\n    True\n    >>> same_chars('dddddddabc', 'abcd')\n    True\n    >>> same_chars('eabcd', 'dddddddabc')\n    False\n    >>> same_chars('abcd', 'dddddddabce')\n    False\n    >>> same_chars('eabcdzzzz', 'dddzzzzzzzddddabc')\n    False\n    \"\"\"\n    return _default_service.compare(s0, s1)"}
