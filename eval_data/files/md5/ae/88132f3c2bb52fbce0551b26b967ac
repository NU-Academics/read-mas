{"task_id": "HumanEval/46", "solution": "def fib4(n: int):\n    \"\"\"The Fib4 number sequence is a sequence similar to the Fibbonacci sequnece that's defined as follows:\n    fib4(0) -> 0\n    fib4(1) -> 0\n    fib4(2) -> 2\n    fib4(3) -> 0\n    fib4(n) -> fib4(n-1) + fib4(n-2) + fib4(n-3) + fib4(n-4).\n    Please write a function to efficiently compute the n-th element of the fib4 number sequence.  Do not use recursion.\n    >>> fib4(5)\n    4\n    >>> fib4(6)\n    8\n    >>> fib4(7)\n    14\n    \"\"\"\n    if n == 0:\n        return 0\n    elif n == 1:\n        return 0\n    elif n == 2:\n        return 2\n    elif n == 3:\n        return 0\n\n    # Initialize the four previous values corresponding to fib4(3), fib4(2), fib4(1), fib4(0)\n    # The variables are shifted to represent fib4(i-1), fib4(i-2), fib4(i-3), fib4(i-4) in each step.\n    # Initially:\n    # fib4(i-1) is current_fib4_val (a)\n    # fib4(i-2) is b\n    # fib4(i-3) is c\n    # fib4(i-4) is d\n    a, b, c, d = 0, 2, 0, 0 # These are fib4(3), fib4(2), fib4(1), fib4(0) respectively\n\n    for i in range(4, n + 1):\n        next_val = a + b + c + d\n        d, c, b, a = c, b, a, next_val # Shift values: new d becomes old c, new c becomes old b, etc.\n    return a"}
{"task_id": "HumanEval/47", "solution": "import math\ndef median(l: list):\n    \"\"\"Return median of elements in the list l.\n    >>> median([3, 1, 2, 4, 5])\n    3\n    >>> median([-10, 4, 6, 1000, 10, 20])\n    15.0\n    \"\"\"\n    if not l:\n        # Per FR1, empty list is invalid, but the prompt says\n        # \"Do NOT add isinstance() checks or raise exceptions for edge cases\"\n        # Assuming the caller handles empty list. Returning None or raising an error\n        # would be more robust per FR1, but for this completion, we'll proceed\n        # assuming `l` is non-empty.\n        return None \n    \n    # Sort the list to find the median.\n    arr = sorted(l)\n    n = len(arr)\n    mid = n // 2\n\n    # If the number of elements is odd, return the middle element.\n    if n % 2 == 1:\n        return float(arr[mid])\n    # If the number of elements is even, return the average of the two middle elements.\n    else:\n        return (arr[mid - 1] + arr[mid]) / 2.0"}
{"task_id": "HumanEval/48", "solution": "import re\nimport unicodedata\ndef is_palindrome(text: str):\n    \"\"\"\n    Checks if given string is a palindrome\n    >>> is_palindrome('')\n    True\n    >>> is_palindrome('aba')\n    True\n    >>> is_palindrome('aaaaa')\n    True\n    >>> is_palindrome('zbcd')\n    False\n    \"\"\"\n    if not text:\n        return True\n\n    # Normalize the string: Unicode NFKC, remove non-alphanumeric, then lowercase.\n    normalized_text = unicodedata.normalize(\"NFKC\", text)\n    normalized_text = re.sub(r'\\W+', '', normalized_text, flags=re.UNICODE)\n    normalized_text = normalized_text.lower()\n\n    return normalized_text == normalized_text[::-1]"}
