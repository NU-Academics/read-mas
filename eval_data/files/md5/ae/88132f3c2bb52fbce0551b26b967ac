{"task_id": "HumanEval/24", "solution": "import math\ndef largest_divisor(n: int) -> int:\n    \"\"\" For a given number n, find the largest number that divides n evenly, smaller than n\n    >>> largest_divisor(15)\n    5\n    \"\"\"\n    if n % 2 == 0:\n        return n // 2\n\n    # Check for odd divisors starting from 3 up to sqrt(n)\n    limit = int(math.isqrt(n))\n    i = 3\n    while i <= limit:\n        if n % i == 0:\n            # If a divisor is found, the largest proper divisor is n // i\n            return n // i\n        i += 2\n\n    # If no divisors were found, n is a prime number.\n    # The largest divisor smaller than n for a prime number is 1.\n    return 1"}
{"task_id": "HumanEval/25", "solution": "from typing import List\ndef factorize(n: int) -> List[int]:\n    \"\"\" Return list of prime factors of given integer in the order from smallest to largest.\n    Each of the factors should be listed number of times corresponding to how many times it appeares in factorization.\n    Input number should be equal to the product of all factors\n    >>> factorize(8)\n    [2, 2, 2]\n    >>> factorize(25)\n    [5, 5]\n    >>> factorize(70)\n    [2, 5, 7]\n    \"\"\"\n    factors = []\n    d = 2\n    temp_n = n\n\n    # Handle factor 2\n    while temp_n % d == 0:\n        factors.append(d)\n        temp_n //= d\n\n    # Handle odd factors\n    d = 3\n    while d * d <= temp_n:\n        while temp_n % d == 0:\n            factors.append(d)\n            temp_n //= d\n        d += 2 # Increment by 2 to check only odd numbers\n\n    # If temp_n is still greater than 1, it must be a prime number itself\n    if temp_n > 1:\n        factors.append(temp_n)\n\n    return factors"}
{"task_id": "HumanEval/29", "solution": "def filter_by_prefix(strings: List[str], prefix: str) -> List[str]:\n    \"\"\" Filter an input list of strings only for ones that start with a given prefix.\n    The comparison is case-sensitive.\n    >>> filter_by_prefix([], 'a')\n    []\n    >>> filter_by_prefix(['abc', 'bcd', 'cde', 'array'], 'a')\n    ['abc', 'array']\n    \"\"\"\n    result = []\n    for s in strings:\n        if s.startswith(prefix):\n            result.append(s)\n    return result"}
