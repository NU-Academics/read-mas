ss TransactionLog:\n    \"\"\"Records a sequence of operations.\"\"\"\n    def __init__(self) -> None:\n        self.entries: List['Operation'] = []\n\n    def append(self, op: 'Operation') -> None:\n        \"\"\"Appends an operation to the log.\"\"\"\n        self.entries.append(op)\nclass TransactionProcessor:\n    \"\"\"Processes a list of operations, updates account, and logs transactions.\"\"\"\n    def __init__(self, account: 'Account' = None, log: 'TransactionLog' = None) -> None:\n        self.account: Account = account if account is not None else Account()\n        self.log: TransactionLog = log if log is not None else TransactionLog()\n\n    def process(self, operations: List[int]) -> bool:\n        \"\"\"Processes operations and returns True if balance falls below zero.\"\"\"\n        for element in operations:\n            op = Operation(element)\n            self.account.apply(op.amount)\n            self.log.append(op)\n            if self.account.getBalance() < 0:\n                return True\n        return False\ndef below_zero(operations: List[int]) -> bool:\n    \"\"\" You're given a list of deposit and withdrawal operations on a bank account that starts with\n    zero balance. Your task is to detect if at any point the balance of account fallls below zero, and\n    at that point function should return True. Otherwise it should be False.\n    >>> below_zero([1, 2, 3])\n    False\n    >>> below_zero([1, 2, -4, 5])\n    True\n    \"\"\"\n    processor = TransactionProcessor()\n    return processor.process(operations)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/2": [{"task_id": "HumanEval/2", "solution": "import math\nclass TruncateFunction:\n    \"\"\"Stateless implementation encapsulating the algorithm to compute the decimal part.\"\"\"\n    def truncate_number(self, number: float) -> float:\n        \"\"\"Computes and returns the decimal part of the given number.\"\"\"\n        integer_part = math.floor(number)\n        decimal = number - integer_part\n        return float(decimal)\ndef truncate_number(number: float) -> float:\n    \"\"\" Given a positive floating point number, it can be decomposed into\n    and integer part (largest integer smaller than given number) and decimals\n    (leftover part always smaller than 1).\n\n    Return the decimal part of the number.\n    >>> truncate_number(3.5)\n    0.5\n    \"\"\"\n    impl = TruncateFunction()\n    return impl.truncate_number(number)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/9": [{"task_id": "HumanEval/9", "solution": "def rolling_max(numbers: List[int]) -> List[int]:\n    \"\"\" From a given list of integers, generate a list of rolling maximum element found until given moment\n    in the sequence.\n    >>> rolling_max([1, 2, 3, 2, 3, 4, 2])\n    [1, 2, 3, 3, 3, 4, 4]\n    \"\"\"\n    if not numbers:\n        return []\n\n    result = []\n    current_max = numbers[0]\n\n    for number in numbers:\n        current_max = max(current_max, number)\n        result.append(current_max)\n    \n    return result", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/10": [{"task_id": "HumanEval/10", "solution": "def make_palindrome(string: str) -> str:\n    \"\"\" Find the shortest palindrome that begins with a supplied string.\n    Algorithm idea is simple:\n    - Find the longest postfix of supplied string that is a palindrome.\n    - Append to the end of the string reverse of a string prefix that comes before the palindromic suffix.\n    >>> make_palindrome('')\n    ''\n    >>> make_palindrome('cat')\n    'catac'\n    >>> make_palindrome('cata')\n    'catac'\n    \"\"\"\n    if not string:\n        return \"\"\n\n    # Find the longest palindromic suffix\n    longest_palindromic_suffix_index = 0\n    for i in range(len(string)):\n        suffix = string[i:]\n        if is_palindrome(suffix):\n            longest_palindromic_suffix_index = i\n            break\n    \n    # The prefix that comes before the palindromic suffix\n    prefix_before_suffix = string[:longest_palindromic_suffix_index]\n    \n    # Append the reverse of this prefix to the original string\n    return string + prefix_before_suffix[::-1]", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [["x"]], "plus_fail_tests": [["race"]]}], "HumanEval/11": [{"task_id": "HumanEval/11", "solution": "class InputString:\n    \"\"\"Holds an input string value and provides helpers for length and validation.\"\"\"\n    def __init__(self, value: str) -> None:\n        self.value = value\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the input string.\"\"\"\n        return len(self.value)\n\n    def is_valid(self) -> bool:\n        \"\"\"Checks if the string contains only '0' or '1' characters.\"\"\"\n        return all(char in '01' for char in self.value)\nclass Validator:\n    \"\"\"Provides a method to validate if a string consists only of '0' or '1'.\"\"\"\n    def validate_binary_string(self, s: str) -> bool:\n        \"\"\"Returns True if the string is a valid binary string, False otherwise.\"\"\"\n        return all(char in '01' for char in s)\nclass ResultString:\n    \"\"\"A container for the resulting binary string with a length helper.\"\"\"\n    def __init__(self, value: str) -> None:\n        self.value = value\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the result string.\"\"\"\n        return len(self.value)\nclass XOROperation:\n    \"\"\"Performs a binary XOR operation on two InputString objects.\"\"\"\n    def __init__(self, a: InputString, b: InputString) -> None:\n        self.a = a\n        self.b = b\n\n    def perform(self) -> ResultString:\n        \"\"\"Computes the bitwise XOR of the two input strings.\"\"\"\n        result_chars = []\n        for i in range(self.a.length()):\n            if self.a.value[i] != self.b.value[i]:\n                result_chars.append('1')\n            else:\n                result_chars.append('0')\n        return ResultString(\"\".join(result_chars))\ndef string_xor(a: str, b: str) -> str:\n    \"\"\" Input are two strings a and b consisting only of 1s and 0s.\n    Perform binary XOR on these inputs and return result also as a string.\n    >>> string_xor('010', '110')\n    '100'\n    \"\"\"\n    a_in = InputString(a)\n    b_in = InputString(b)\n    validator = Validator()\n\n    if not validator.validate_binary_string(a_in.value) or not validator.validate_binary_string(b_in.value):\n        raise ValueError(\"input strings must contain only characters '0' and '1'\")\n\n    if a_in.length() != b_in.length():\n        raise ValueError(\"input strings must have equal length\")\n\n    xor_op = XOROperation(a_in, b_in)\n    result = xor_op.perform()\n    return result.value", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/12": [{"task_id": "HumanEval/12", "solution": "from typing import List, Optional\nfrom dataclasses import dataclass\nclass Validator:\n    \"\"\"Encapsulates validation logic for input types.\"\"\"\n    def validateList(self, obj: object) -> bool:\n        \"\"\"Return True if obj is a list instance.\"\"\"\n        return isinstance(obj, list)\n\n    def validateElements(self, items: List[object]) -> bool:\n        \"\"\"Return True if every element in the list is a string.\"\"\"\n        return all(isinstance(item, str) for item in items)\ndef longest(strings: List[str]) -> Optional[str]:\n    \"\"\" Out of list of strings, return the longest one. Return the first one in case of multiple\n    strings of the same length. Return None in case the input list is empty.\n    >>> longest([])\n\n    >>> longest(['a', 'b', 'c'])\n    'a'\n    >>> longest(['a', 'bb', 'ccc'])\n    'ccc'\n    \"\"\"\n    validator = Validator()\n\n    if not validator.validateList(strings):\n        raise TypeError(\"Input must be a list.\")\n\n    if not validator.validateElements(strings):\n        raise TypeError(\"All elements in the list must be strings.\")\n\n    if not strings:\n        return None\n\n    max_length = -1\n    longest_string = None\n\n    for index, s in enumerate(strings):\n        string_item = StringItem(value=s, index=index)\n        current_length = string_item.length()\n\n        if current_length > max_length:\n            max_length = current_length\n            longest_string = s\n\n    return longest_string", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[["x", "y", "z"]]], "plus_fail_tests": [[["", "a", "aa", "aaa"]]]}], "HumanEval/8": [{"task_id": "HumanEval/8", "solution": "from typing import List, Tuple\nclass InputList:\n    def __init__(self, numbers: List[int]):\n        self.numbers = numbers\n        self.length = len(numbers)\nclass ResultTuple:\n    def __init__(self, s: int, p: int):\n        self.sum = s\n        self.product = p\n\n    def to_tuple(self) -> Tuple[int, int]:\n        return (self.sum, self.product)\nclass Validator:\n    def is_valid(self, numbers: List[int]) -> bool:\n        # Per BR10, the Validator is permissive and assumes the caller passes a List[int].\n        return True\nclass Accumulator:\n    def __init__(self):\n        self.running_sum = 0\n        self.running_product = 1\n\n    def add(self, value: int) -> None:\n        self.running_sum += value\n\n    def multiply(self, value: int) -> None:\n        self.running_product *= value\n\n    def to_result(self) -> ResultTuple:\n        return ResultTuple(self.running_sum, self.running_product)\nclass SumProductFunction:\n    def compute(self, numbers: List[int]) -> Tuple[int, int]:\n        validator = Validator()\n        # The validator is called as per design, though it always returns True.\n        validator.is_valid(numbers)\n\n        input_list = InputList(numbers)\n        accumulator = Accumulator()\n\n        for number in input_list.numbers:\n            accumulator.add(number)\n            accumulator.multiply(number)\n\n        result_tuple_obj = accumulator.to_result()\n        return result_tuple_obj.to_tuple()\ndef sum_product(numbers: List[int]) -> Tuple[int, int]:\n    \"\"\" For a given list of integers, return a tuple consisting of a sum and a product of all the integers in a list.\n    Empty sum should be equal to 0 and empty product should be equal to 1.\n    \"\"\"\n    return SumProductFunction().compute(numbers)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/13": [{"task_id": "HumanEval/13", "solution": "def greatest_common_divisor(a: int, b: int) -> int:\n    \"\"\" Return a greatest common divisor of two integers a and b.\n    The result is always non-negative. By convention, gcd(0, 0) returns 0.\n    >>> greatest_common_divisor(3, 5)\n    1\n    >>> greatest_common_divisor(25, 15)\n    5\n    \"\"\"\n    a, b = abs(a), abs(b)\n    while b != 0:\n        a, b = b, a % b\n    return a", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/14": [{"task_id": "HumanEval/14", "solution": "from typing import List\nclass InputString:\n    \"\"\"Encapsulates input string value and provides convenience methods.\"\"\"\n    def __init__(self, value: str) -> None:\n        self.value = value\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the string.\"\"\"\n        return len(self.value)\n\n    def is_empty(self) -> bool:\n        \"\"\"Checks if the string is empty.\"\"\"\n        return self.length() == 0\nclass PrefixList:\n    \"\"\"Builds and holds ordered prefixes as a list of strings.\"\"\"\n    def __init__(self) -> None:\n        self.prefixes: List[str] = []\n\n    def append(self, prefix: str) -> None:\n        \"\"\"Adds a prefix to the list.\"\"\"\n        self.prefixes.append(prefix)\n\n    def count(self) -> int:\n        \"\"\"Returns the number of prefixes in the list.\"\"\"\n        return len(self.prefixes)\ndef all_prefixes(string: str) -> List[str]:\n    \"\"\" Return list of all prefixes from shortest to longest of the input string\n    >>> all_prefixes('abc')\n    ['a', 'ab', 'abc']\n    \"\"\"\n    input_str_obj = InputString(string)\n\n    if input_str_obj.is_empty():\n        return []\n\n    prefix_list_obj = PrefixList()\n    for i in range(1, input_str_obj.length() + 1):\n        prefix = string[:i]\n        prefix_list_obj.append(prefix)\n\n    return prefix_list_obj.prefixes", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/22": [{"task_id": "HumanEval/22", "solution": "def filter_integers(values: List[Any]) -> List[int]:\n    \"\"\" Filter given list of any python values only for integers\n    >>> filter_integers(['a', 3.14, 5])\n    [5]\n    >>> filter_integers([1, 2, 3, 'abc', {}, []])\n    [1, 2, 3]\n    \"\"\"\n    result = []\n    for item in values:\n        if type(item) is int:\n            result.append(item)\n    return result", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/19": [{"task_id": "HumanEval/19", "solution": "from typing import List\nclass InputString:\n    \"\"\"Represent the raw input string provided to the system.\"\"\"\n    def __init__(self, raw: str):\n        self.raw = raw\nclass Token:\n    \"\"\"Represent a single token (word) and its numeric value.\"\"\"\n    def __init__(self, word: str, value: int = None):\n        self.word = word\n        self.value = value\nMAPPING = {\n    'zero': 0, 'one': 1, 'two': 2, 'three': 3, 'four': 4, 'five': 5,\n    'six': 6, 'seven': 7, 'eight': 8, 'nine': 9\n}\nclass TokenMapper:\n    \"\"\"Map a token word to its numeric value.\"\"\"\n    def __init__(self):\n        self.mapping = MAPPING\n\n    def mapWordToValue(self, word: str) -> int:\n        return self.mapping.get(word)\nclass Sorter:\n    \"\"\"Sort a list of Token objects by value.\"\"\"\n    def sortTokens(self, tokens: List[Token]) -> List[Token]:\n        # Sort based on the 'value' field of Token objects in ascending order.\n        return sorted(tokens, key=lambda t: t.value)\nclass OutputString:\n    \"\"\"Represent the resulting single space-delimited output string.\"\"\"\n    def __init__(self, raw: str):\n        self.raw = raw\ndef sort_numbers(numbers: str) -> str:\n    \"\"\" Input is a space-delimited string of numberals from 'zero' to 'nine'.\n    Valid choices are 'zero', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight' and 'nine'.\n    Return the string with numbers sorted from smallest to largest\n    >>> sort_numbers('three one five')\n    'one three five'\n    \"\"\"\n    input_obj = InputString(raw=numbers)\n    token_words = input_obj.raw.split(' ')\n    tokens = [Token(word=w) for w in token_words]\n\n    mapper = TokenMapper()\n    sorter = Sorter()\n\n    for t in tokens:\n        t.value = mapper.mapWordToValue(t.word)\n\n    sorted_tokens = sorter.sortTokens(tokens)\n\n    output_raw = ' '.join(t.word for t in sorted_tokens)\n    output = OutputString(raw=output_raw)\n\n    return output.raw", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/17": [{"task_id": "HumanEval/17", "solution": "from typing import List, Dict\nclass Legend:\n    \"\"\"Encapsulates token-to-beat mappings and provides a lookup mechanism.\n    Raises ValueError for unrecognized musical tokens.\"\"\"\n\n    def __init__(self, mappings: Dict[str, int] = None) -> None:\n        self.mappings = mappings if mappings is not None else {'o': 4, 'o|': 2, '.|': 1}\n\n    def lookup(self, symbol: str) -> int:\n        \"\"\"Returns the beat duration for a given symbol, or raises an error if unknown.\"\"\"\n        if symbol in self.mappings:\n            return self.mappings[symbol]\n        raise ValueError(f\"Unrecognized