lue(self, val: int) -> Tuple[int, int]:\n        \"\"\"Returns (row, col) for a given value.\"\"\"\n        return self.valueToCoord[val]\nclass Path:\n    \"\"\"Represents a candidate path of visits; supports cloning/extension.\"\"\"\n    def __init__(self, initial_cell: Cell):\n        self.values: List[int] = [initial_cell.value]\n        self.cells: List[Cell] = [initial_cell]\n        self.length: int = 1\n\n    def append(self, cell: Cell) -> None:\n        \"\"\"Appends a cell to the path.\"\"\"\n        self.values.append(cell.value)\n        self.cells.append(cell)\n        self.length += 1\n\n    def clone(self) -> 'Path':\n        \"\"\"Returns a deep copy of the path.\"\"\"\n        cloned_path = Path(self.cells[0])\n        cloned_path.values = list(self.values)\n        cloned_path.cells = list(self.cells)\n        cloned_path.length = self.length\n        return cloned_path\nclass Validator:\n    \"\"\"Input validation component, failing fast with exceptions on invalid inputs.\"\"\"\n    def validateGrid(self, grid_data: List[List[int]]) -> None:\n        \"\"\"Validates grid shape (N x N, N >= 2) and element types.\"\"\"\n        if not isinstance(grid_data, list) or not grid_data:\n            raise ValueError(\"Grid must be a non-empty list of lists.\")\n        N = len(grid_data)\n        if N < 2:\n            raise ValueError(\"Grid dimension N must be at least 2.\")\n        for row in grid_data:\n            if not isinstance(row, list) or len(row) != N:\n                raise ValueError(\"Grid must be square (N x N).\")\n            for val in row:\n                if not isinstance(val, int):\n                    raise ValueError(\"Grid cells must contain integers.\")\n\n    def validatePermutation(self, grid_data: List[List[int]]) -> None:\n        \"\"\"Validates that values 1 to N*N appear exactly once.\"\"\"\n        N = len(grid_data)\n        expected_size = N * N\n        seen_values = set()\n        for r in range(N):\n            for c in range(N):\n                val = grid_data[r][c]\n                if not (1 <= val <= expected_size):\n                    raise ValueError(f\"Grid contains value {val} outside of range [1, {expected_size}].\")\n                if val in seen_values:\n                    raise ValueError(f\"Grid contains duplicate value {val}.\")\n                seen_values.add(val)\n        if len(seen_values) != expected_size:\n            raise ValueError(f\"Grid does not contain all values from 1 to {expected_size}.\")\n\n    def validateK(self, k: int, N: int) -> None:\n        \"\"\"Validates that k is a positive integer.\"\"\"\n        if not isinstance(k, int) or k <= 0:\n            raise ValueError(\"k must be a positive integer.\")\nclass MinPathSolver:\n    \"\"\"Finds the lexicographically minimal path of length k in the grid.\"\"\"\n    def __init__(self):\n        self.grid: Optional[Grid] = None\n        self.k: int = 0\n        self.bestValues: Optional[List[int]] = None\n\n    def comparePaths(self, pathA: Path, pathB: Path) -> int:\n        \"\"\"Compares two paths lexicographically. Returns -1 if A<B, 0 if equal, +1 if A>B.\"\"\"\n        return self._compare_value_lists(pathA.values, pathB.values)\n\n    def _compare_value_lists(self, list_a: List[int], list_b: List[int]) -> int:\n        \"\"\"Compares two lists of integers lexicographically.\"\"\"\n        for i in range(min(len(list_a), len(list_b))):\n            if list_a[i] < list_b[i]:\n                return -1\n            elif list_a[i] > list_b[i]:\n                return 1\n        return 0\n\n    def expand(self, path: Path) -> List[Path]:\n        \"\"\"Generates a list of new paths by extending the given path by one step.\"\"\"\n        if path.length >= self.k:\n            return []\n        \n        new_paths = []\n        last_cell = path.cells[-1]\n        for neighbor_cell in last_cell.neighbors(self.grid):\n            new_path = path.clone()\n            new_path.append(neighbor_cell)\n            new_paths.append(new_path)\n        return new_paths\n\n    def _recursive_find_path(self, current_path: Path):\n        \"\"\"Recursive helper for DFS-like path finding, using expand and comparePaths.\"\"\"\n        if current_path.length == self.k:\n            if self.bestValues is None or self._compare_value_lists(current_path.values, self.bestValues) == -1:\n                self.bestValues = list(current_path.values)\n            return\n\n        if self.bestValues is not None:\n            # Pruning: if current_path's prefix is already lexicographically worse than bestValues' prefix\n            for i in range(current_path.length):\n                if current_path.values[i] > self.bestValues[i]:\n                    return\n                elif current_path.values[i] < self.bestValues[i]:\n                    break\n\n        for new_path in self.expand(current_path):\n            self._recursive_find_path(new_path)\n\n    def findMinPath(self, grid: Grid, k: int) -> List[int]:\n        \"\"\"Finds the lexicographically minimal path of length k in the grid.\"\"\"\n        self.grid = grid\n        self.k = k\n        self.bestValues = None\n\n        if k == 1:\n            min_val = float('inf')\n            for r in range(self.grid.N):\n                for c in range(self.grid.N):\n                    min_val = min(min_val, self.grid.getCell(r, c).value)\n            return [min_val]\n\n        for r in range(self.grid.N):\n            for c in range(self.grid.N):\n                start_cell = self.grid.getCell(r, c)\n                initial_path = Path(start_cell)\n                self._recursive_find_path(initial_path)\n        \n        return self.bestValues\ndef minPath(grid: List[List[int]], k: int) -> List[int]:\n    \"\"\"\n    Given a grid with N rows and N columns (N >= 2) and a positive integer k, \n    find the minimum path of length k.\n    \"\"\"\n    validator = Validator()\n    validator.validateGrid(grid)\n    validator.validatePermutation(grid)\n    N = len(grid)\n    validator.validateK(k, N)\n\n    grid_model = Grid(grid)\n    solver = MinPathSolver()\n    return solver.findMinPath(grid_model, k)", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[[[1, 4, 7], [2, 5, 8], [3, 6, 9]], 20]]}], "HumanEval/32": [{"task_id": "HumanEval/32", "solution": "import math\nfrom typing import List, Tuple\nTOLERANCE: float = 1e-9\nMAX_SEARCH_RADIUS = 1000.0\nSTEP_SIZE = 0.01\nBISECTION_MAX_ITER = 100\nclass ValidationResult:\n    \"\"\"Container for validation outcome.\"\"\"\n    def __init__(self, is_valid: bool, error_message: str = \"\"):\n        self.is_valid = is_valid\n        self.error_message = error_message\nclass PolynomialEvaluator:\n    \"\"\"Evaluate a polynomial at a given x.\"\"\"\n    def poly(self, coeffs: list, x: float) -> float:\n        \"\"\"Computes polynomial value using floating-point math and math.pow.\"\"\"\n        x_float = float(x)\n        float_coeffs = [float(c) for c in coeffs]\n        \n        # Using math.pow as specified in the design context and original stub function.\n        return sum([coeff * math.pow(x_float, i) for i, coeff in enumerate(float_coeffs)])\nclass InputValidator:\n    \"\"\"Validate coefficient lists per the rules.\"\"\"\n    def validate_coeffs(self, coeffs: list) -> ValidationResult:\n        \"\"\"Validates coefficient list for find_zero.\"\"\"\n        if not isinstance(coeffs, (list, tuple)):\n            return ValidationResult(False, \"Coefficients must be a list or tuple.\")\n        \n        if not coeffs:\n            return ValidationResult(False, \"Coefficient list cannot be empty.\")\n\n        # Convert to float to ensure numeric and consistent type\n        try:\n            float_coeffs = [float(c) for c in coeffs]\n        except (TypeError, ValueError):\n            return ValidationResult(False, \"All coefficients must be numeric.\")\n\n        # Rule: len(coeffs) must be even\n        if len(float_coeffs) % 2 != 0:\n            return ValidationResult(False, \"Coefficient list must have an even number of elements.\")\n\n        # Rule: the leading (highest non-zero) coefficient must be non-zero.\n        leading_coeff = 0.0\n        for i in range(len(float_coeffs) - 1, -1, -1):\n            if float_coeffs[i] != 0.0:\n                leading_coeff = float_coeffs[i]\n                break\n        \n        if leading_coeff == 0.0:\n            return ValidationResult(False, \"Leading coefficient (highest non-zero) must not be zero.\")\n            \n        return ValidationResult(True)\nclass RootFinder:\n    \"\"\"Find a single real root.\"\"\"\n    def __init__(self, evaluator: PolynomialEvaluator = None, validator: InputValidator = None, tolerance: float = None):\n        self.evaluator = evaluator if evaluator is not None else PolynomialEvaluator()\n        self.validator = validator if validator is not None else InputValidator()\n        self.tolerance = tolerance if tolerance is not None else TOLERANCE\n\n    def _residual(self, r: float, coeffs: list) -> float:\n        \"\"\"Returns abs(evaluator.poly(coeffs, r)).\"\"\"\n        return abs(self.evaluator.poly(coeffs, r))\n\n    def _bisect(self, coeffs: list, a: float, b: float) -> float:\n        \"\"\"Performs bisection to find a root within [a, b].\"\"\"\n        low = a\n        high = b\n        y_low = self.evaluator.poly(coeffs, low)\n\n        # Check endpoints for tolerance.\n        if abs(y_low) <= self.tolerance: return low\n        if abs(self.evaluator.poly(coeffs, high)) <= self.tolerance: return high\n        \n        for _ in range(BISECTION_MAX_ITER):\n            mid = (low + high) / 2.0\n            y_mid = self.evaluator.poly(coeffs, mid)\n\n            if abs(y_mid) <= self.tolerance:\n                return mid\n            \n            if y_low * y_mid < 0:\n                high = mid\n            else:\n                low = mid\n                y_low = y_mid\n        \n        return (low + high) / 2.0 # Best estimate after iterations\n\n    def _search_root(self, coeffs: list) -> float:\n        \"\"\"Deterministic bracket-and-bisection search for a single root.\"\"\"\n        # Check x = 0.0 first.\n        if self._residual(0.0, coeffs) <= self.tolerance:\n            return 0.0\n\n        # Deterministic search strategy: Prioritize positive roots first, then negative.\n        # This ensures consistent results when multiple roots exist.\n        \n        # Search positive axis outwards from 0.0.\n        prev_x_pos = 0.0\n        prev_y_pos = self.evaluator.poly(coeffs, prev_x_pos)\n\n        for i in range(1, int(MAX_SEARCH_RADIUS / STEP_SIZE) + 1):\n            current_x_pos = i * STEP_SIZE\n            current_y_pos = self.evaluator.poly(coeffs, current_x_pos)\n\n            if abs(current_y_pos) <= self.tolerance:\n                return current_x_pos\n            \n            if prev_y_pos * current_y_pos < 0: # Sign change detected, indicating a root.\n                return self._bisect(coeffs, prev_x_pos, current_x_pos)\n            \n            prev_x_pos = current_x_pos\n            prev_y_pos = current_y_pos\n        \n        # If no root found on the positive axis, search negative axis outwards from 0.0.\n        prev_x_neg = 0.0\n        prev_y_neg = self.evaluator.poly(coeffs, prev_x_neg) \n\n        for i in range(1, int(MAX_SEARCH_RADIUS / STEP_SIZE) + 1):\n            current_x_neg = -i * STEP_SIZE\n            current_y_neg = self.evaluator.poly(coeffs, current_x_neg)\n\n            if abs(current_y_neg) <= self.tolerance:\n                return current_x_neg\n            \n            if prev_y_neg * current_y_neg < 0: # Sign change detected.\n                return self._bisect(coeffs, current_x_neg, prev_x_neg) # Order for [low, high].\n            \n            prev_x_neg = current_x_neg\n            prev_y_neg = current_y_neg\n        \n        # According to requirements, a solution is guaranteed for valid inputs.\n        # This RuntimeError should ideally not be reached with sufficient search parameters.\n        raise RuntimeError(\"RootFinder failed to locate a root within the defined search parameters.\")\n\n    def find_zero(self, coeffs: list) -> float:\n        \"\"\"Validates coefficients and finds a single real root.\"\"\"\n        validation_result = self.validator.validate_coeffs(coeffs)\n        if not validation_result.is_valid:\n            raise ValueError(validation_result.error_message)\n        \n        # Convert all coefficients to floats for internal consistency.\n        float_coeffs = [float(c) for c in coeffs]\n        \n        return self._search_root(float_coeffs)\n_polynomial_evaluator = PolynomialEvaluator()\n_input_validator = InputValidator()\n_root_finder = RootFinder(evaluator=_polynomial_evaluator, validator=_input_validator)\ndef poly(xs: list, x: float):\n    \"\"\"\n    Evaluates polynomial with coefficients xs at point x.\n    return xs[0] + xs[1] * x + xs[1] * x^2 + .... xs[n] * x^n\n    \"\"\"\n    return _polynomial_evaluator.poly(xs, x)\ndef find_zero(xs: list):\n    \"\"\" xs are coefficients of a polynomial.\n    find_zero find x such that poly(x) = 0.\n    find_zero returns only only zero point, even if there are many.\n    Moreover, find_zero only takes list xs having even number of coefficients\n    and largest non zero coefficient as it guarantees\n    a solution.\n    >>> round(find_zero([1, 2]), 2) # f(x) = 1 + 2x\n    -0.5\n    >>> round(find_zero([-6, 11, -6, 1]), 2) # (x - 1) * (x - 2) * (x - 3) = -6 + 11x - 6x^2 + x^3\n    1.0\n    \"\"\"\n    return _root_finder.find_zero(xs)", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[[5, 10, -3, 1]]]}], "HumanEval/130": [{"task_id": "HumanEval/130", "solution": "def tri(n):\n    \"\"\"Everyone knows Fibonacci sequence, it was studied deeply by mathematicians in \n    the last couple centuries. However, what people don't know is Tribonacci sequence.\n    Tribonacci sequence is defined by the recurrence:\n    tri(1) = 3\n    tri(n) = 1 + n / 2, if n is even.\n    tri(n) =  tri(n - 1) + tri(n - 2) + tri(n + 1), if n is odd.\n    For example:\n    tri(2) = 1 + (2 / 2) = 2\n    tri(4) = 3\n    tri(3) = tri(2) + tri(1) + tri(4)\n           = 2 + 3 + 3 = 8 \n    You are given a non-negative integer number n, you have to a return a list of the \n    first n + 1 numbers of the Tribonacci sequence.\n    Examples:\n    tri(3) = [1, 3, 2, 8]\n    \"\"\"\n    # Initialize a memoization cache to store computed Tribonacci numbers.\n    cache = {}\n\n    def _compute_tri_recursive(k):\n        \"\"\"Computes tri(k) using the defined rules and memoization.\"\"\"\n        if k in cache:\n            return cache[k]\n\n        result = 0\n        if k == 0:\n            result = 1\n        elif k == 1:\n            result = 3\n        elif k % 2 == 0:  # k is even, apply direct formula\n            result = 1 + (k // 2)\n        else:  # k is odd, apply recurrence relation\n            term_k_minus_1 = _compute_tri_recursive(k - 1)\n            term_k_minus_2 = _compute_tri_recursive(k - 2)\n            # For tri(k+1), since k is odd, k+1 is even; apply even rule directly.\n            term_k_plus_1 = 1 + ((k + 1) // 2)\n            result = term_k_minus_1 + term_k_minus_2 + term_k_plus_1\n        \n        cache[k] = result\n        return result\n\n    # Generate the sequence of n + 1 numbers.\n    sequence = []\n    for i in range(n + 1):\n        sequence.append(_compute_tri_recursive(i))\n\n    return sequence", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/139": [{"task_id": "HumanEval/139", "solution": "def special_factorial(n):\n    \"\"\"The Brazilian factorial is defined as:\n    brazilian_factorial(n) = n! * (n-1)! * (n-2)! * ... * 1!\n    where n > 0\n\n    For example:\n    >>> special_factorial(4)\n    288\n\n    The function will receive an integer as input and should return the special\n    factorial of this integer.\n    \"\"\"\n    # Private helper returning k! as Python int.\n    def _factorial(k):\n        res = 1\n        for i in range(1, k + 1):\n            res *= i\n        return res\n\n    total_product = 1\n    for i in range(1, n + 1):\n        factorial_i = _factorial(i)\n        total_product *= factorial_i\n\n    return total_product", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}]}}