{"date": "2026-05-06 23:01", "hash": "fe585eb4df8c88d844eeb463ea4d0302", "eval": {"HumanEval/6": [{"task_id": "HumanEval/6", "solution": "from typing import List\nclass InputString:\n    \"\"\"Represents the raw input string and splits it into groups.\"\"\"\n    def __init__(self, raw: str):\n        self.raw = raw\n        self.groups: List[str] = []\n\n    def parse_groups(self) -> List[str]:\n        \"\"\"Splits the raw string on space characters into tokens.\"\"\"\n        self.groups = self.raw.split(' ')\n        return self.groups\nclass ParentheticalGroup:\n    \"\"\"Represents one parenthetical group and computes its maximum nesting depth.\"\"\"\n    def __init__(self, text: str, index: int):\n        self.text = text\n        self.index = index\n        self.maxDepth: int = 0\n\n    def compute_max_depth(self) -> int:\n        \"\"\"Scans the group's text to find the maximum nesting depth.\"\"\"\n        current_depth = 0\n        max_depth_seen = 0\n        for char in self.text:\n            if char == '(':\n                current_depth += 1\n                max_depth_seen = max(max_depth_seen, current_depth)\n            elif char == ')':\n                current_depth -= 1\n        self.maxDepth = max_depth_seen\n        return self.maxDepth\nclass OutputList:\n    \"\"\"Aggregates per-group integer depths and provides the final return container.\"\"\"\n    def __init__(self):\n        self.depths: List[int] = []\n\n    def append(self, depth: int) -> None:\n        \"\"\"Appends a computed depth, preserving order.\"\"\"\n        self.depths.append(depth)\nclass Parser:\n    \"\"\"Orchestrates parsing, depth computation, and aggregation.\"\"\"\n    def parse_nested_parens(self, paren_string: str) -> List[int]:\n        \"\"\"Orchestrates creating InputString, splitting groups, computing depths, and aggregating results.\"\"\"\n        input_string_obj = InputString(paren_string)\n        groups = input_string_obj.parse_groups()\n\n        output_list_obj = OutputList()\n        for i, group_text in enumerate(groups):\n            group = ParentheticalGroup(group_text, i)\n            depth = group.compute_max_depth()\n            output_list_obj.append(depth)\n\n        return output_list_obj.depths\n\n    def compute_depth(self, group: str) -> int:\n        \"\"\"Computes max depth for a raw group string.\"\"\"\n        group_obj = ParentheticalGroup(group, 0) # Index doesn't matter for this specific call\n        return group_obj.compute_max_depth()\ndef parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\" Input to this function is a string represented multiple groups for nested parentheses separated by spaces.\n    For each of the group, output the deepest level of nesting of parentheses.\n    E.g. (()()) has maximum two levels of nesting while ((())) has three.\n\n    >>> parse_nested_parens('(()()) ((())) () ((())()())')\n    [2, 3, 1, 3]\n    \"\"\"\n    parser = Parser()\n    return parser.parse_nested_parens(paren_string)", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[""]]}], "HumanEval/4": [{"task_id": "HumanEval/4", "solution": "def mean_absolute_deviation(numbers: List[float]) -> float:\n    \"\"\" For a given list of input numbers, calculate Mean Absolute Deviation\n    around the mean of this dataset.\n    Mean Absolute Deviation is the average absolute difference between each\n    element and a centerpoint (mean in this case):\n    MAD = average | x - x_mean |\n    >>> mean_absolute_deviation([1.0, 2.0, 3.0, 4.0])\n    1.0\n    \"\"\"\n    if not numbers:\n        raise ValueError(\"mean_absolute_deviation requires at least one number\")\n\n    n = len(numbers)\n    \n    # First pass: calculate the mean\n    total_sum = sum(numbers)\n    mean = total_sum / float(n)\n\n    # Second pass: calculate the sum of absolute differences from the mean\n    sum_abs_diffs = 0.0\n    for x in numbers:\n        sum_abs_diffs += abs(x - mean)\n\n    # Calculate MAD\n    mad = sum_abs_diffs / float(n)\n    return mad", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/0": [{"task_id": "HumanEval/0", "solution": "def has_close_elements(numbers: List[float], threshold: float) -> bool:\n    \"\"\" Check if in given list of numbers, are any two numbers closer to each other than\n    given threshold.\n    >>> has_close_elements([1.0, 2.0, 3.0], 0.5)\n    False\n    >>> has_close_elements([1.0, 2.8, 3.0, 4.0, 5.0, 2.0], 0.3)\n    True\n    \"\"\"\n    from typing import TypeAlias\n    from dataclasses import dataclass\n\n    # Design-mandated internal type aliases and dataclasses for domain traceability.\n    NumberList: TypeAlias = List[float] # Included as per design, though not used as a variable type hint inside.\n    Threshold: TypeAlias = float\n\n    @dataclass\n    class Pair:\n        a: float\n        b: float\n\n        def abs_diff(self) -> float:\n            \"\"\"Calculates the absolute difference between the two numbers in the pair.\"\"\"\n            return abs(self.a - self.b)\n\n    @dataclass\n    class HasCloseElementsResult:\n        value: bool\n\n    # FR5: Return False for zero or one-element lists.\n    if len(numbers) <= 1:\n        return HasCloseElementsResult(value=False).value\n\n    # FR3, FR4: Iterate through all distinct pairs of numbers to find a qualifying pair.\n    # FR6: The input list is preserved by read-only access.\n    num_elements = len(numbers)\n    for i in range(num_elements):\n        for j in range(i + 1, num_elements): # Ensures distinct pairs (i != j) and avoids duplicates.\n            num1 = numbers[i]\n            num2 = numbers[j]\n            current_pair = Pair(num1, num2)\n            \n            # FR7: Compare strict absolute difference with threshold (use '<').\n            if current_pair.abs_diff() < threshold:\n                # Short-circuit and return True upon first qualifying pair.\n                re