Mapping] = [\n    GradeMapping(4.0, 4.0, 'A+', is_exact=True),\n    GradeMapping(3.7, 4.0, 'A'),\n    GradeMapping(3.3, 3.7, 'A-'),\n    GradeMapping(3.0, 3.3, 'B+'),\n    GradeMapping(2.7, 3.0, 'B'),\n    GradeMapping(2.3, 2.7, 'B-'),\n    GradeMapping(2.0, 2.3, 'C+'),\n    GradeMapping(1.7, 2.0, 'C'),\n    GradeMapping(1.3, 1.7, 'C-'),\n    GradeMapping(1.0, 1.3, 'D+'),\n    GradeMapping(0.7, 1.0, 'D'),\n    GradeMapping(0.0, 0.7, 'D-'),\n    GradeMapping(0.0, 0.0, 'E', is_exact=True),\n]\nclass GradeConverter:\n    \"\"\"Converts a list of GPA values into corresponding letter grades using predefined mappings.\"\"\"\n    def __init__(self, mappings: List[GradeMapping]) -> None:\n        self.mappings: List[GradeMapping] = mappings\n\n    def _evaluate_gpa(self, value: float) -> str:\n        \"\"\"Evaluates a single normalized GPA value to its letter grade.\"\"\"\n        for mapping in self.mappings:\n            if mapping.matches(value):\n                return mapping.letter\n        raise ValueError(f\"No letter grade mapping found for GPA value {value} in the defined table.\")\n\n    def numerical_letter_grade(self, grades_raw: List[Union[int, float]]) -> List[str]:\n        \"\"\"Processes a list of raw GPA inputs, validating and converting each to a letter grade.\"\"\"\n        result_grades: List[str] = []\n        for gpa_raw in grades_raw:\n            gpa_obj = GPAValue(gpa_raw) # Handles type and range validation\n            letter = self._evaluate_gpa(gpa_obj.value)\n            result_grades.append(LetterGrade(letter).grade)\n        return result_grades\ndef numerical_letter_grade(grades: List[Union[int, float]]) -> List[str]:\n    \"\"\"It is the last week of the semester and the teacher has to give the grades\n    to students. The teacher has been making her own algorithm for grading.\n    The only problem is, she has lost the code she used for grading.\n    She has given you a list of GPAs for some students and you have to write \n    a functio