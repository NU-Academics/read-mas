culator:\n        \"\"\"Computes the number of mango fruits.\"\"\"\n        def compute(self, n: int, counts: FruitCounts) -> MangoResult:\n            mango_count = n - counts.apples - counts.oranges\n            return MangoResult(mango_count)\n\n    parser = Parser()\n    fruit_counts = parser.parse(s)\n\n    calculator = Calculator()\n    mango_result = calculator.compute(n, fruit_counts)\n\n    return mango_result.mango_count", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/66": [{"task_id": "HumanEval/66", "solution": "def digitSum(s):\n    \"\"\"Compute and return sum of ASCII codes of uppercase ASCII letters in s (ASCII 65..90).\"\"\"\n    accumulator = 0\n    for c in s:\n        code = ord(c)\n        if 65 <= code <= 90:\n            accumulator += code\n    return accumulator", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/68": [{"task_id": "HumanEval/68", "solution": "def pluck(arr):\n    \"\"\"\n    Finds the smallest even node and its index in the array.\n    Returns [value, index] or an empty list if no even numbers are found.\n    \"\"\"\n    smallest_even_value = float('inf')\n    smallest_even_index = -1\n\n    for i, num in enumerate(arr):\n        if num % 2 == 0:  # Check if the number is even\n            if num < smallest_even_value:\n                smallest_even_value = num\n                smallest_even_index = i\n            # If num == smallest_even_value, we do nothing to preserve the smallest index\n\n    if smallest_even_index == -1:\n        return []\n    else:\n        return [smallest_even_value, smallest_even_index]", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/70": [{"task_id": "HumanEval/70", "solution": "def strange_sort_list(lst):\n    \"\"\"\n    Given list of integers, return list in strange order.\n    Strange sorting, is when you start with the minimum value,\n    then maximum of the remaining integers, then minimum and so on.\n    \"\"\"\n    if not lst:\n        return []\n\n    sorted_lst = sorted(lst)\n    result = []\n    is_min_turn = True\n\n    while sorted_lst:\n        if is_min_turn:\n            result.append(sorted_lst.pop(0))\n        else:\n            result.append(sorted_lst.pop())\n        is_min_turn = not is_min_turn\n\n    return result", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/65": [{"task_id": "HumanEval/65", "solution": "def circular_shift(x, shift):\n    \"\"\"Circular shift the digits of the integer x, shift the digits right by shift\n    and return the result as a string.\n    If shift > number of digits, return digits reversed.\n    \"\"\"\n\n    class InputInteger:\n        \"\"\"Encapsulates the input integer and provides its digit count.\"\"\"\n        def __init__(self, value: int):\n            self.value = value\n\n        def numDigits(self) -> int:\n            \"\"\"Returns the number of decimal digits in the integer.\"\"\"\n            return len(str(abs(self.value)))\n\n    class DigitSequence:\n        \"\"\"Represents the tokenized decimal digits of an integer as a string.\"\"\"\n        def __init__(self, digits: str):\n            self.digits = digits\n\n        @classmethod\n        def tokenize(cls, value: int) -> 'DigitSequence':\n            \"\"\"Converts an integer to a string of its absolute decimal digits.\"\"\"\n            return cls(str(abs(value)))\n\n    class ShiftOperation:\n        \"\"\"Encapsulates the shift parameter and provides basic validation.\"\"\"\n        def __init__(self, shift: int):\n            self.shift = shift\n\n        def isNonNegative(self) -> bool:\n            \"\"\"Checks if the shift value is non-negative.\"\"\"\n            return self.shift >= 0\n\n    class CircularShiftProcessor:\n        \"\"\"Provides algorithms for circular shifting and reversing digit sequences.\"\"\"\n        def applyShift(self, seq: DigitSequence, op: ShiftOperation) -> str:\n            \"\"\"Performs a right circular shift on the digit sequence.\"\"\"\n            digits = seq.digits\n            shift_val = op.shift % len(digits) if len(digits) > 0 else 0\n            return digits[-shift_val:] + digits[:-shift_val]\n\n        def reverse(self, seq: DigitSequence) -> str:\n            \"\"\"Reverses the digit sequence.\"\"\"\n            return seq.digits[::-1]\n\n    class OutputString:\n        \"\"\"Holds the final string result of the operation.\"\"\"\n        def __init__(self, result: str):\n            self._result = result\n\n        @property\n        def result(self) -> str:\n            \"\"\"Returns the stored result string.\"\"\"\n            return self._result\n\n    inp = InputInteger(x)\n    seq = DigitSequence.tokenize(inp.value)\n    op = ShiftOperation(shift)\n    proc = CircularShiftProcessor()\n\n    # The design mentioned validating non-negative shift, but per instructions,\n    # we don't raise exceptions for edge cases. We proceed with the operation.\n    op.isNonNegative() # Call the method as per design, but ignore its direct validation effect.\n\n    if inp.numDigits() == 0: # Handle edge case for 0-digit number (only occurs if x is somehow an empty string, but design expects int)\n        result_str = \"\"\n    elif op.shift > inp.numDigits():\n        result_str = proc.reverse(seq)\n    else:\n        result_str = proc.applyShift(seq, op)\n\n    out = OutputString(result_str)\n    return out.result", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/71": [{"task_id": "HumanEval/71", "solution": "import math\nclass Triangle:\n    \"\"\"Domain model holding three side lengths and providing domain computations.\"\"\"\n    def __init__(self, a: float, b: float, c: float):\n        self.a = a\n        self.b = b\n        self.c = c\n\n    def semiperimeter(self) -> float:\n        \"\"\"Returns s = (a + b + c) / 2.\"\"\"\n        return (self.a + self.b + self.c) / 2\n\n    def isValid(self) -> bool:\n        \"\"\"Returns true iff all sides are positive and satisfy triangle inequality.\"\"\"\n        if not (self.a > 0 and self.b > 0 and self.c > 0):\n            return False\n        return (self.a + self.b > self.c and\n                self.a + self.c > self.b and\n                self.b + self.c > self.a)\nclass Validator:\n    \"\"\"Encapsulates validation logic for a Triangle instance.\"\"\"\n    def validate(self, triangle: Triangle) -> bool:\n        \"\"\"Validate numericness and triangle inequality; returns boolean.\"\"\"\n        return triangle.isValid()\nclass AreaCalculator:\n    \"\"\"Computes triangle area using Heron's formula.\"\"\"\n    def computeArea(self, triangle: Triangle) -> float:\n        \"\"\"Compute area using Heron's formula; assumes triangle.isValid() true.\"\"\"\n        s = triangle.semiperimeter()\n        # Heron's formula: sqrt(s * (s - a) * (s - b) * (s - c))\n        area_squared = s * (s - triangle.a) * (s - triangle.b) * (s - triangle.c)\n        # Clamp to 0 in case of floating point inaccuracies resulting in slight negative\n        if area_squared < 0:\n            area_squared = 0\n        return math.sqrt(area_squared)\nclass Result:\n    \"\"\"Holds computation outcome and provides formatted representation.\"\"\"\n    def __init__(self, area: float, valid: bool):\n        self.area = area\n        self.valid = valid\n\n    def formatted(self):\n        \"\"\"Returns the area rounded to 2 decimal places if valid, otherwise -1.\"\"\"\n        if self.valid:\n            return round(self.area, 2)\n        else:\n            return -1\ndef triangle_area(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle. Return the area of\n    the triangle rounded to 2 decimal points if the three sides form a valid triangle.\n    Otherwise return -1\n    Three sides make a valid triangle when the sum of any two sides is greater\n    than the third side.\n    Example:\n    triangle_area(3, 4, 5) == 6.00\n    triangle_area(1, 2, 10) == -1\n    '''\n    try:\n        a_f = float(a)\n        b_f = float(b)\n        c_f = float(c)\n    except (ValueError, TypeError):\n        return -1\n\n    triangle = Triangle(a_f, b_f, c_f)\n    validator = Validator()\n\n    if not validator.validate(triangle):\n        result = Result(area=0.0, valid=False)\n        return result.formatted()\n    else:\n        area_calculator = AreaCalculator()\n        raw_area = area_calculator.computeArea(triangle)\n        result = Result(area=raw_area, valid=True)\n        return result.formatted()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/24": [{"task_id": "HumanEval/24", "solution": "def largest_divisor(n: int) -> int:\n    \"\"\" For a given number n, find the largest number that divides n evenly, smaller than n\n    >>> largest_divisor(15)\n    5\n    \"\"\"\n    # Inlining the logic for primality check as per design guidance.\n    # Import math needed for sqrt, assumed to be available at module level.\n    import math\n    \n    is_n_prime = True\n    if n <= 1:\n        is_n_prime = False\n    else:\n        # Check divisibility from 2 up to sqrt(n) to determine primality.\n        for i in range(2, int(math.sqrt(n)) + 1):\n            if n % i == 0:\n                is_n_prime = False\n                break\n\n    # If n is prime (and greater than 1), its largest proper divisor is 1.\n    if is_n_prime and n > 1:\n        return 1\n\n    # If n is not prime (or n <= 1), search for the largest proper divisor by iterating downwards.\n    # This loop finds the first divisor from n-1 down to 1, which is the largest.\n    for d in range(n - 1, 0, -1):\n        if n % d == 0:\n            return d\n\n    # For cases like n=1, where no divisor smaller than n exists, the loop completes without returning.\n    # The problem description does not specify behavior for n <= 1, and explicit error handling\n    # for such edge cases is prohibited by the design constraints.", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/76": [{"task_id": "HumanEval/76", "solution": "def is_simple_power(x, n):\n    \"\"\"Your task is to write a function that returns true if a number x is a simple\n    power of n and false in other cases.\n    x is a simple power of n if n**int=x\n    For example:\n    is_simple_power(1, 4) => true\n    is_simple_power(2, 2) => true\n    is_simple_power(8, 2) => true\n    is_simple_power(3, 2) => false\n    is_simple_power(3, 1) => false\n    is_simple_power(5, 3) => false\n    \"\"\"\n    if x == 1:\n        return True\n    if n == 1:\n        return False\n    if n <= 0 or x <= 0: # Powers only make sense for positive bases and results, given k>=0\n        return False\n\n    current_power = 1\n    while current_power < x:\n        current_power *= n\n    return current_power == x", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[-2, -2]]}], "HumanEval/74": [{"task_id": "HumanEval/74", "solution": "def total_chars(lst):\n    \"\"\"Return integer sum(len(s) for s in lst) using Python len().\"\"\"\n    total = 0\n    for s in lst:\n        total += len(s)\n    return total\ndef total_match(lst1, lst2):\n    '''\n    Write a function that accepts two lists of strings and returns the list that has \n    total number of chars in the all strings of the list less than the other list.\n\n    if the two lists have the same number of chars, return the first list.\n\n    Examples\n    total_match([], []) \u279e []\n    total_match(['hi', 'admin'], ['hI', 'Hi']) \u279e ['hI', 'Hi']\n    total_match(['hi', 'admin'], ['hi', 'hi', 'admin', 'project']) \u279e ['hi', 'admin']\n    total_match(['hi', 'admin'], ['hI', 'hi', 'hi']) \u279e ['hI', 'hi', 'hi']\n    total_match(['4'], ['1', '2', '3', '4', '5']) \u279e ['4']\n    '''\n    total1 = total_chars(lst1)\n    total2 = total_chars(lst2)\n\n    if total1 <= total2:\n        return lst1\n    else:\n        return lst2", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/69": [{"task_id": "HumanEval/69", "solution": "def search(lst):\n    \"\"\"\n    You are given a non-empty list of positive integers. Return the greatest integer that is greater than \n    zero, and has a frequency greater than or equal to the value of the integer itself. \n    The frequency of an integer is the number of times it appears in the list.\n    If no such a value exist, return -1.\n    \"\"\"\n    from typing import List, Dict\n\n    class InputList:\n        \"\"\"Encapsulates input data and performs basic validation for the list of integers.\"\"\"\n        def __init__(self, values: List[int]) -> None:\n            self.values = values\n\n        def validate(self) -> bool:\n            \"\"\"Checks if the list is non-empty and contains only positive integers.\"\"\"\n            if not self.values:\n                return False\n            for v in self.values:\n                if not isinstance(v, int) or v <= 0:\n                    return False\n            return True\n\n    class IntegerValue:\n        \"\"\"A simple data holder for an integer value and its corresponding frequency.\"\"\"\n        def __init__(self, value: int, frequency: int) -> None:\n            self.value = value\n            self.frequency = frequency\n\n    class FrequencyCounter:\n        \"\"\"Responsible for computing the frequency of each integer within an InputList.\"\"\"\n        def countFrequencies(self, lst_instance: InputList) -> Dict[int, int]:\n            \"\"\"Calculates and returns a dictionary mapping integers to their counts.\"\"\"\n            frequencies = {}\n            for x in lst_instance.values:\n                frequencies[x] = frequencies.get(x, 0) + 1\n            return frequencies\n\n    class Result:\n        \"\"\"Encapsulates the final search outcome, storing the integer result and a found flag.\"\"\"\n        def __init__(self, result: int, found: bool) -> None:\n            self.result = result\n            self.found = found\n\n    class SearchService:\n        \"\"\"Coordinates the overall search logic, identifying and selecting the greatest qualifying integer.\"\"\"\n        def __init__(self, frequency_counter: FrequencyCounter = None) -> None:\n            self.frequency_counter = frequency_counter if frequency_counter else FrequencyCounter()\n\n        def search(self, input_list_instance: InputList) -> int:\n            \"\"\"\n            Executes the core search, returning the greatest integer v where frequency(v) >= v.\n            If no such integer is found, it returns -1.\n            \"\"\"\n            frequencies = self.frequency_counter.countFrequencies(input_list_instance)\n\n            max_candidate_value = -1\n            \n            for value, freq in frequencies.items():\n                if freq >= value:\n                    if value > max_candidate_value:\n                        max_candidate_value = value\n            \n            found_candidate = (max_candidate_value != -1)\n            final_result_obj = Result(max_candidate_value, found_candidate)\n            return final_result_obj.result\n\n    # The public module-level function acts as a thin wrapper around SearchService.\n    # It constructs an InputList and delegates the core search to the SearchService.\n    input_list_instance = InputList(lst)\n    \n    # As per design's assumption (FR1), the input is considered valid,\n    # so the return value of validate() is not explicitly handled here.\n    input_list_instance.validate() \n\n    search_service_instance = SearchService()\n    return search_service_instance.search(input_list_instance)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/73": [{"task_id": "HumanEval/73", "solution": "def smallest_change(arr):\n    \"\"\"Return minimum number of element changes to make arr palindromic.\n\n    Preconditions: arr is a list (or array-like) of integers.\n    Returns: int >= 0 (number of mismatched symmetric pairs).\n    Complexity: O(n) time, O(1) extra space.\n    \"\"\"\n    n = len(arr)\n    count = 0\n    for i in range(n // 2):\n        if arr[i] != arr[n - 1 - i]:\n            count += 1\n    return count", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/75": [{"task_id": "HumanEval/75", "solution": "from dataclasses import dataclass\nfrom typing import List, Optional\ndef _is_prime(n: int) -> bool:\n    \"\"\"Checks if a number is prime. Suitable for small integers.\"\"\"\n    if n < 2:\n        return False\n    for i in range(2, int(n**0.5) + 1):\n        if n % i == 0:\n            return False\n    return True\ndef _primes_upto(limit: int) -> List[int]:\n    \"\"\"Generates a list of prime numbers up to a given limit.\"\"\"\n    primes = []\n    for i in range(2, limit + 1):\n        if _is_prime(i):\n            primes.append(i)\n    return primes\ndef _find_three_prime_factors(a: int, primes: List[int]) -> Optional[FactorTriple]:\n    \"\"\"Finds if 'a' can be expressed as the product of three primes from the given list.\"\"\"\n    for p1_val in primes:\n        # Optimization: if p1_val is too large for the product even with smallest primes\n        if p1_val * 2 * 2 > a:\n            break\n        for p2_val in primes:\n            # Optimization: if p1_val * p2_val is too large for the product with smallest prime\n            if p1_val * p2_val * 2 > a:\n                break\n            for p3_val in primes:\n                product = p1_val * p2_val * p3_val\n                if product == a:\n                    return FactorTriple(Prime(p1_val), Prime(p2_val), Prime(p3_val))\n                # Optimization: if product exceeds 'a', further p3_val will only increase it\n                if product > a:\n                    break\n    return None\ndef is_multiply_prime(a):\n    \"\"\"Write a function that returns true if the given number is the multiplication of 3 prime numbers\n    and false otherwise.\n    Knowing that (a) is less then 100. \n    Example:\n    is_multiply_prime(30) == True\n    30 = 2 * 3 * 5\n    \"\"\"\n    input_num = InputNumber(a)\n    if not input_num.is_valid():\n        return False\n\n    # A number must be at least 2*2*2 = 8 to be a product of three primes.\n    if a < 8:\n        return False\n\n    # Generate primes up to 'a' itself, as a prime factor cannot exceed the number.\n    primes_list = _primes_upto(a)\n\n    found_triple = _find_three_prime_factors(a, primes_list)\n\n    return found_triple is not None", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/77": [{"task_id": "HumanEval/77", "solution": "from typing import Optional\nclass CubeChecker:\n    \"\"\"Encapsulates cube-detection logic.\"\"\"\n\n    def integer_cube_root(self, a: int) -> int:\n        \"\"\"Computes an integer cube-root candidate for 'a', handling negative values.\"\"\"\n        if a == 0:\n            return 0\n        \n        abs_a = abs(a)\n        cbrt_candidate_abs = round(abs_a ** (1/3))\n        \n        return -cbrt_candidate_abs if a < 0 else cbrt_candidate_abs\n\n    def verify_cube(self, n: int, a: int) -> bool:\n        \"\"\"Returns whether n^3 equals 'a'.\"\"\"\n        return n * n * n == a\n\n    def iscube(self, a: int) -> bool:\n        \"\"\"Returns True iff there exists an integer n such that n^3 == 'a'.\"\"\"\n        n = self.integer_cube_root(a)\n        is_a_cube = self.verify_cube(n, a)\n        return is_a_cube\ndef iscube(a):\n    '''\n    Write a function that takes an integer a and returns True \n    if this ingeger is a cube of some integer number.\n  