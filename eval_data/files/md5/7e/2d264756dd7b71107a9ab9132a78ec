fic handling (e.g., return None).\n        if not ext_objs:\n            return None \n\n        strongest_ext = ext_objs[0]\n        max_strength = strongest_ext.strength\n\n        for ext in ext_objs[1:]:\n            if ext.strength > max_strength:\n                max_strength = ext.strength\n                strongest_ext = ext\n        return strongest_ext\n\n    extension_objects: List[Extension] = []\n    for ext_name in extensions:\n        cap_count = _count_upper(ext_name)\n        sm_count = _count_lower(ext_name)\n        \n        ext_obj = Extension(name=ext_name, cap=cap_count, sm=sm_count)\n        _compute_strength(ext_obj)\n        \n        extension_objects.append(ext_obj)\n\n    strongest_extension_obj = _select_max(extension_objects)\n\n    return f\"{class_name}.{strongest_extension_obj.name}\"", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/161": [{"task_id": "HumanEval/161", "solution": "def solve(s):\n    \"\"\"You are given a string s.\n    if s[i] is a letter, reverse its case from lower to upper or vise versa, \n    otherwise keep it as it is.\n    If the string contains no letters, reverse the string.\n    The function should return the resulted string.\n    Examples\n    solve(\"1234\") = \"4321\"\n    solve(\"ab\") = \"AB\"\n    solve(\"#a@C\") = \"#A@c\"\n    \"\"\"\n    \n    has_alphabetic_chars = False\n    for char_s in s:\n        if ('a' <= char_s <= 'z') or ('A' <= char_s <= 'Z'):\n            has_alphabetic_chars = True\n            break\n            \n    if has_alphabetic_chars:\n        transformed_chars = []\n        for char_s in s:\n            if 'a' <= char_s <= 'z':\n                transformed_chars.append(char_s.upper())\n            elif 'A' <= char_s <= 'Z':\n                transformed_chars.append(char_s.lower())\n            else:\n                transformed_chars.append(char_s)\n        return \"\".join(transformed_chars)\n    else:\n        return s[::-1]", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [["\u00e4\u00eb\u00ef\u00f6\u00fc"]]}], "HumanEval/160": [{"task_id": "HumanEval/160", "solution": "def do_algebra(operator, operand):\n    \"\"\"\n    Evaluates an algebraic expression constructed from lists of operators and operands.\n    This function validates inputs, constructs an infix string, and evaluates it using Python's `eval`.\n    \"\"\"\n    if not isinstance(operator, list) or not all(isinstance(op, str) for op in operator):\n        raise ValueError(\"operator must be a list of strings.\")\n    if not isinstance(operand, list) or not all(isinstance(op, int) for op in operand):\n        raise ValueError(\"operand must be a list of integers.\")\n\n    if len(operator) < 1:\n        raise ValueError(\"Operator list must have at least one operator.\")\n    if len(operand) < 2:\n        raise ValueError(\"Operand list must have at least two operands.\")\n    if len(operator) != len(operand) - 1:\n        raise ValueError(\"Length of operator list must be equal to length of operand list minus one.\")\n\n    allowed_operators = {'+', '-', '*', '//', '**'}\n    for op in operator:\n        if op not in allowed_operators:\n            raise ValueError(f\"Invalid operator '{op}' found. Allowed operators are: {', '.join(allowed_operators)}\")\n\n    for op_val in operand:\n        if op_val < 0:\n            raise ValueError(\"Operand values must be non-negative integers.\")\n\n    # Construct the expression string\n    expression_parts = []\n    for i in range(len(operand)):\n        expression_parts.append(str(operand[i]))\n        if i < len(operator):\n            expression_parts.append(operator[i])\n\n    expression_str = \" \".join(expression_parts)\n\n    # Evaluate the expression\n    try:\n        # Using eval() is safe here because we strictly control the content of expression_str.\n        # It's built only from validated integer strings and a predefined set of operators.\n        result = eval(expression_str)\n        return result\n    except ZeroDivisionError:\n        raise # Re-raise ZeroDivisionError directly as specified\n    except Exception as e:\n        # Catch any other potential eval errors, though unlikely with current validation\n        raise ValueError(f\"Error evaluating expression: {e}\")", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/162": [{"task_id": "HumanEval/162", "solution": "import hashlib\nfrom typing import Optional\ndef string_to_md5(text: str) -> Optional[str]:\n    \"\"\"\n    Given a string 'text', return its md5 hash equivalent string.\n    If 'text' is an empty string, return None.\n    \"\"\"\n    if not text:\n        return None\n    return hashlib.md5(text.encode('utf-8')).hexdigest().lower()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/163": [{"task_id": "HumanEval/163", "solution": "class ValidationError(Exception):\n    \"\"\"Represents validation failure; mapped to Python ValueError at the boundary.\"\"\"\n    def __init__(self, message: str):\n        self.message = message\nclass InputParameter:\n    \"\"\"Validates a single parameter to be an integer and strictly positive.\"\"\"\n    def __init__(self, value):\n        self.value = value\n\n    def validate(self) -> None:\n        \"\"\"Raises ValidationError if the value is not an integer or is not positive.\"\"\"\n        if not isinstance(self.value, int):\n            raise ValidationError(f\"Input '{self.value}' must be an integer.\")\n        if self.value <= 0:\n            raise ValidationError(f\"Input '{self.value}' must be a positive integer.\")\nclass IntegerRange:\n    \"\"\"Represents a normalized inclusive integer range [start, end].\"\"\"\n    def __init__(self, start: int, end: int):\n        self.start = min(start, end)\n        self.end = max(start, end)\n\n    def contains(self, value: int) -> bool:\n        \"\"\"Checks if a value is within the inclusive range.\"\"\"\n        return self.start <= value <= self.end\nclass DigitCandidate:\n    \"\"\"Represents a candidate integer and provides checks for evenness and single-digit.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def is_even(self) -> bool:\n        \"\"\"Returns true if the candidate value is even.\"\"\"\n        return self.value % 2 == 0\n\n    def is_single_digit(self) -> bool:\n        \"\"\"Returns true if the candidate value is a single positive digit (1-9).\"\"\"\n        return 0 < self.value < 10\nclass ResultList:\n    \"\"\"Collects selected digits, ensuring uniqueness and ascending order.\"\"\"\n    def __init__(self):\n        self.digits = set()\n\n    def add(self, value: int) -> None:\n        \"\"\"Adds a value to the collection, ensuring uniqueness.\"\"\"\n        self.digits.add(value)\n\n    def to_list(self) -> list:\n        \"\"\"Returns a sorted list of unique integers.\"\"\"\n        return sorted(list(self.digits))\nclass GenerateIntegers:\n    \"\"\"Orchestrates the pipeline: input validation, range normalization, candidate filtering, and result assembly.\"\"\"\n    def __init__(self, a, b):\n        self.a = a\n        self.b = b\n\n    def execute(self) -> list:\n        \"\"\"Executes the generation process and returns a list of even digits.\"\"\"\n        # 1. Validate inputs\n        InputParameter(self.a).validate()\n        InputParameter(self.b).validate()\n\n        # 2. Normalize range\n        integer_range = IntegerRange(self.a, self.b)\n\n        # 3. Filter candidates\n        result_list = ResultList()\n        # Candidate set is explicit: [2, 4, 6, 8]\n        possible_digits = [2, 4, 6, 8] \n\n        for digit in possible_digits:\n            candidate = DigitCandidate(digit)\n            if candidate.is_even() and candidate.is_single_digit() and integer_range.contains(digit):\n                result_list.add(digit)\n        \n        # 4. Return sorted unique list\n        return result_list.to_list()\ndef generate_integers(a, b):\n    \"\"\"\n    Given two positive integers a and b, return the even digits between a\n    and b, in ascending order.\n    \"\"\"\n    try:\n        generator = GenerateIntegers(a, b)\n        return generator.execute()\n    except ValidationError as e:\n        raise ValueError(e.message)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/159": [{"task_id": "HumanEval/159", "solution": "def eat(number, need, remaining):\n    \"\"\"\n    You're a hungry rabbit, and you already have eaten a certain number of carrots,\n    but now you need to eat more carrots to complete the day's meals.\n    you should return an array of [ total number of eaten carrots after your meals,\n                                    the number of carrots left after your meals ]\n    if there are not enough remaining carrots, you will eat all remaining carrots, but will still be hungry.\n    \"\"\"\n\n    def validate_inputs(num_val, need_val, rem_val) -> None:\n        \"\"\"Raises ValueError if any input is not int or not in 0..1000 inclusive.\"\"\"\n        for name, value in [(\"number\", num_val), (\"need\", need_val), (\"remaining\", rem_val)]:\n            if not isinstance(value, int):\n                raise ValueError(f\"{name} must be an integer.\")\n            if not (0 <= value <= 1000):\n                raise ValueError(f\"{name} must be between 0 and 1000 (inclusive).\")\n\n    class Rabbit:\n        def __init__(self, numberEaten: int):\n            self.numberEaten: int = numberEaten\n        def getNumberEaten(self) -> int:\n            return self.numberEaten\n        def addEaten(self, n: int) -> None:\n            self.numberEaten += n\n\n    class CarrotStock:\n        def __init__(self, remaining: int):\n            self.remaining: int = remaining\n        def getRemaining(self) -> int:\n            return self.remaining\n        def consume(self, n: int) -> None:\n            self.remaining -= n\n            if self.remaining < 0:\n                self.remaining = 0\n\n    class EatOperation:\n        def __init__(self, need_amount: int):\n            self.need = need_amount\n            self.eatenNow = 0\n            self.totalEaten = 0\n            self.remainingAfter = 0\n\n        def execute(self, rabbit_obj: Rabbit, stock_obj: CarrotStock) -> None:\n            self.eatenNow = min(self.need, stock_obj.getRemaining())\n            self.totalEaten = rabbit_obj.getNumberEaten() + self.eatenNow\n            self.remainingAfter = stock_obj.getRemaining() - self.eatenNow\n            rabbit_obj.addEaten(self.eatenNow)\n            stock_obj.consume(self.eatenNow)\n\n    validate_inputs(number, need, remaining)\n    rabbit = Rabbit(number)\n    stock = CarrotStock(remaining)\n    op = EatOperation(need)\n    op.execute(rabbit, stock)\n    return [op.totalEaten, op.remainingAfter]", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/94": [{"task_id": "HumanEval/94", "solution": "class IntegerList:\n    \"\"\"Represents a list of integers.\"\"\"\n    def __init__(self, values):\n        self.values = list(values)\n\n    def add(self, value):\n        \"\"\"Adds a value to the list.\"\"\"\n        self.values.append(value)\n\n    def size(self):\n        \"\"\"Returns the number of elements in the list.\"\"\"\n        return len(self.values)\nclass Number:\n    \"\"\"Represents a single integer and can evaluate its primality.\"\"\"\n    def __init__(self, value):\n        self.value = value\n        self.isPrime = False\n\n    def evaluatePrime(self):\n        \"\"\"Determines if the number is prime.\"\"\"\n        if self.value <= 1:\n            self.isPrime = False\n            return False\n        if self.value == 2:\n            self.isPrime = True\n            return True\n        if self.value % 2 == 0:\n            self.isPrime = False\n            return False\n\n        i = 3\n        while i * i <= self.value:\n            if self.value % i == 0:\n                self.isPrime = False\n                return False\n            i += 2\n        self.isPrime = True\n        return True\nclass PrimeNumber(Number):\n    \"\"\"A number confirmed to be prime.\"\"\"\n    def __init__(self, value):\n        super().__init__(value)\n        self.isPrime = True\nclass LargestPrime:\n    \"\"\"Wrapper for the largest prime value found.\"\"\"\n    def __init__(self, value):\n        self.value = value\nclass PrimeDetector:\n    \"\"\"Detects prime numbers from an IntegerList.\"\"\"\n    def detect(self, integer_list: IntegerList):\n        \"\"\"Returns a list of PrimeNumber instances.\"\"\"\n        primes = []\n        for val in integer_list.values:\n            number = Number(val)\n            if number.evaluatePrime():\n                primes.append(PrimeNumber(val))\n        return primes\nclass MaxSelector:\n    \"\"\"Selects the largest prime from a list of PrimeNumber.\"\"\"\n    def select(self, primes: list):\n        \"\"\"Returns LargestPrime instance or None if no primes.\"\"\"\n        if not primes:\n            return None\n        max_prime_val = max(p.value for p in primes)\n        return LargestPrime(max_prime_val)\nclass DigitSumCalculator:\n    \"\"\"Calculates the sum of decimal digits of an integer.\"\"\"\n    def compute(self, value: int):\n        \"\"\"Returns the sum of digits of the absolute value of the integer.\"\"\"\n        s_value = str(abs(value))\n        digit_sum = sum(int(d) for d in s_value)\n        return digit_sum\ndef skjkasdkd(lst):\n    \"\"\"You are given a list of integers.\n    You need to find the largest prime value and return the sum of its digits.\n    \"\"\"\n    integer_list = IntegerList(lst)\n\n    detector = PrimeDetector()\n    primes = detector.detect(integer_list)\n\n    selector = MaxSelector()\n 