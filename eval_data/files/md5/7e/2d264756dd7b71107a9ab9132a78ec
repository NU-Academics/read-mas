-> int:\n            return x * y\n\n    class Matrix3x3:\n        \"\"\"Represents a 3x3 integer matrix and performs matrix multiplication.\"\"\"\n        def __init__(self, a11: int, a12: int, a13: int,\n                     a21: int, a22: int, a23: int,\n                     a31: int, a32: int, a33: int):\n            self.a11 = a11\n            self.a12 = a12\n            self.a13 = a13\n            self.a21 = a21\n            self.a22 = a22\n            self.a23 = a23\n            self.a31 = a31\n            self.a32 = a32\n            self.a33 = a33\n            self._arith = BigIntegerArithmetic()\n\n        def multiply(self, other: 'Matrix3x3') -> 'Matrix3x3':\n            \"\"\"Performs matrix multiplication with another Matrix3x3 instance.\"\"\"\n            arith = self._arith\n            \n            r1c1 = arith.add(arith.add(arith.mul(self.a11, other.a11), arith.mul(self.a12, other.a21)), arith.mul(self.a13, other.a31))\n            r1c2 = arith.add(arith.add(arith.mul(self.a11, other.a12), arith.mul(self.a12, other.a22)), arith.mul(self.a13, other.a32))\n            r1c3 = arith.add(arith.add(arith.mul(self.a11, other.a13), arith.mul(self.a12, other.a23)), arith.mul(self.a13, other.a33))\n            \n            r2c1 = arith.add(arith.add(arith.mul(self.a21, other.a11), arith.mul(self.a22, other.a21)), arith.mul(self.a23, other.a31))\n            r2c2 = arith.add(arith.add(arith.mul(self.a21, other.a12), arith.mul(self.a22, other.a22)), arith.mul(self.a23, other.a32))\n            r2c3 = arith.add(arith.add(arith.mul(self.a21, other.a13), arith.mul(self.a22, other.a23)), arith.mul(self.a23, other.a33))\n            \n            r3c1 = arith.add(arith.add(arith.mul(self.a31, other.a11), arith.mul(self.a32, other.a21)), arith.mul(self.a33, other.a31))\n            r3c2 = arith.add(arith.add(arith.mul(self.a31, other.a12), arith.mul(self.a32, other.a22)), arith.mul(self.a33, other.a32))\n            r3c3 = arith.add(arith.add(arith.mul(self.a31, other.a13), arith.mul(self.a32, other.a23)), arith.mul(self.a33, other.a33))\n            \n            return Matrix3x3(r1c1, r1c2, r1c3, r2c1, r2c2, r2c3, r3c1, r3c2, r3c3)\n\n    class MatrixExponentiator:\n        \"\"\"Efficiently raises 3x3 matrices to integer powers using exponentiation-by-squaring.\"\"\"\n        def fast_exponentiation(self, M: Matrix3x3, e: int) -> Matrix3x3:\n            \"\"\"Computes M raised to the power e using an iterative exponentiation-by-squaring algorithm.\"\"\"\n            identity = Matrix3x3(1, 0, 0, 0, 1, 0, 0, 0, 1)\n            \n            res = identity\n            base = M\n            \n            while e > 0:\n                if e % 2 == 1:\n                    res = res.multiply(base)\n                base = base.multiply(base)\n                e //= 2\n            \n            return res\n\n    class InputValidator:\n        \"\"\"Validates input to ensure it's a non-negative integer.\"\"\"\n        def validate_non_negative_integer(self, n) -> None:\n            \"\"\"Raises ValueError if n is not an integer or is negative.\"\"\"\n            if not isinstance(n, int):\n                raise ValueError(\"Input must be an integer.\")\n            if n < 0:\n                raise ValueError(\"Input must be a non-negative integer.\")\n\n    class FibFibFunction:\n        \"\"\"Computes fibfib(n); handles base cases and delegates matrix-based computation for larger n.\"\"\"\n        def compute(self, n: int) -> int:\n            \"\"\"Calculates the n-th FibFib number, handling base cases directly.\"\"\"\n            if n == 0:\n                return 0\n            elif n == 1:\n                return 0\n            elif n == 2:\n                return 1\n            else:\n                return self.compute_by_matrix(n)\n\n        def compute_by_matrix(self, n: int) -> int:\n            \"\"\"Computes fibfib(n) for n >= 3 using matrix exponentiation.\"\"\"\n            # The companion matrix C transforms [f(k), f(k-1), f(k-2)] to [f(k+1), f(k), f(k-1)].\n            # The initial vector is [f(2), f(1), f(0)] = [1, 0, 0].\n            # We need C^(n-2) to transform [f(2), f(1), f(0)] to [f(n), f(n-1), f(n-2)].\n            companion_matrix = Matrix3x3(1, 1, 1,\n                                         1, 0, 0,\n                                         0, 1, 0)\n            \n            exponentiator = MatrixExponentiator()\n            matrix_power = exponentiator.fast_exponentiation(companion_matrix, n - 2)\n            \n            # fibfib(n) is the a11 element of the resulting matrix power.\n            return matrix_power.a11\n\n    validator = InputValidator()\n    validator.validate_non_negative_integer(n)\n\n    fibfib_calculator = FibFibFunction()\n    return fibfib_calculator.compute(n)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/64": [{"task_id": "HumanEval/64", "solution": "class VowelSet:\n    \"\"\"Encapsulates vowel membership rules.\"\"\"\n    def __init__(self):\n        self._vowels = {'a', 'e', 'i', 'o', 'u'}\n\n    def is_vowel(self, ch: str, pos: int, length: int) -> bool:\n        \"\"\"Returns True if ch is a vowel based on rules.\"\"\"\n        return ch in self._vowels or (ch == 'y' and pos == length - 1)\nclass Word:\n    \"\"\"Value object for input text.\"\"\"\n    def __init__(self, text: str):\n        self.text = text\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the word.\"\"\"\n        return len(self.text)\n\n    def char_at(self, pos: int) -> str:\n        \"\"\"Returns the character at the specified position.\"\"\"\n        return self.text[pos]\nclass VowelCounter:\n    \"\"\"Implements the vowel counting algorithm.\"\"\"\n    def __init__(self, vowel_set: VowelSet):\n        self.vowel_set = vowel_set\n\n    def countVowels(self, s: str) -> int:\n        \"\"\"Counts vowels in the string, handling case-insensitivity.\"\"\"\n        s_lower = s.lower()\