eric(lst) -> bool:\n        \"\"\"Checks if all elements in the list are numeric.\"\"\"\n        return all(isinstance(x, Number) for x in lst)\nclass InputList:\n    \"\"\"Wraps the caller-supplied list of numbers.\"\"\"\n    def __init__(self, elements: List[Number]) -> None:\n        self.elements = elements\n\n    def validate(self) -> bool:\n        \"\"\"Validates if elements are numeric. (Not directly used by get_positive for initial validation).\"\"\"\n        return Validator.areElementsNumeric(self.elements)\n\n    def getElements(self) -> List[Number]:\n        \"\"\"Returns the raw list of numbers.\"\"\"\n        return self.elements\nclass Element:\n    \"\"\"Represents a single value with its original position.\"\"\"\n    def __init__(self, value: Number, position: int) -> None:\n        self.value = value\n        self.position = position\n\n    def isPositive(self) -> bool:\n        \"\"\"Checks if the element's value is positive.\"\"\"\n        return self.value > 0\nclass OutputList:\n    \"\"\"Container for resulting Element instances that are positive.\"\"\"\n    def __init__(self, elements: List['Element']) -> None:\n        self.elements = elements\n\n    def size(self) -> int:\n        \"\"\"Returns the number of elements in the output list.\"\"\"\n        return len(self.elements)\nclass PositiveFilter:\n    \"\"\"Filters an InputList to produce an OutputList of positive elements.\"\"\"\n    def filter(self, input_list_obj: InputList) -> 'OutputList':\n        \"\"\"Applies the positive filter to the input list.\"\"\"\n        positive_elements = []\n        for i, value in enumerate(input_list_obj.getElements()):\n            element_obj = Element(value, i)\n            if element_obj.isPositive():\n                positive_elements.append(element_obj)\n        return OutputList(positive_elements)\ndef get_positive(l: list) -> list:\n    \"\"\"Return only positive numbers in the list.\n    >>> get_positive([-1, 2, -4, 5, 6])\n    [2, 5, 6]\n    >>> get_positive([5, 3, -5, 2, -3, 3, 9, 0, 123, 1, -10])\n    [5, 3, 2, 3, 9, 123, 1]\n    \"\"\"\n    if not Validator.isList(l):\n        raise TypeError(\"Input must be a list\")\n\n    input_obj = InputList(l)\n    pf = PositiveFilter()\n    output_obj = pf.filter(input_obj)\n    \n    return [e.value for e in output_obj.elements]", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/29": [{"task_id": "HumanEval/29", "solution": "def filter_by_prefix(strings: List[str], prefix: str) -> List[str]:\n    \"\"\" Filter an input list of strings only for ones that start with a given prefix.\n    >>> filter_by_prefix([], 'a')\n    []\n    >>> filter_by_prefix(['abc', 'bcd', 'cde', 'array'], 'a')\n    ['abc', 'array']\n    \"\"\"\n    result = []\n    for s in strings:\n        if s.startswith(prefix):\n            result.append(s)\n    return result", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/25": [{"task_id": "HumanEval/25", "solution": "from typing import List\ndef _trial_division(n: int) -> List[int]:\n    \"\"\"Extracts and returns prime factors in ascending order with multiplicity.\"\"\"\n    factors = []\n    # Handle factor 2\n    while n % 2 == 0:\n        factors.append(2)\n        n //= 2\n    # Handle odd factors\n    d = 3\n    while d * d <= n:\n        while n % d == 0:\n            factors.append(d)\n            n //= d\n        d += 2\n    # If n is still greater than 1, it must be a prime factor itself\n    if n > 1:\n        factors.append(n)\n    return factors\ndef factorize(n: int) -> List[int]:\n    \"\"\" Return list of prime factors of given integer in the order from smallest to largest.\n    Each of the factors should be listed number of times corresponding to how many times it appeares in factorization.\n    Input number should be equal to the product of all factors\n    >>> factorize(8)\n    [2, 2, 2]\n    >>> factorize(25)