{"task_id": "Mbpp/749", "solution": "from dataclasses import dataclass\nfrom typing import List\nclass NumericStringSorter:\n    \"\"\"Encapsulates the sorting logic for a list of NumericString objects.\"\"\"\n    @staticmethod\n    def sort(strings: List[NumericString]) -> List[IntegerNumber]:\n        # Convert each string to an IntegerNumber\n        ints = [IntegerNumber(int(s.value)) for s in strings]\n        # Sort by the integer value\n        ints.sort(key=lambda x: x.value)\n        return ints\ndef sort_numeric_strings(strings: List[str]) -> List[int]:\n    \"\"\"\n    Accepts a list of numeric strings, converts them to integers, sorts them,\n    and returns the sorted list of integers.\n    \"\"\"\n    numeric_strings = [NumericString(s) for s in strings]\n    sorted_numbers = NumericStringSorter.sort(numeric_strings)\n    return [n.value for n in sorted_numbers]"}
