{"task_id": "Mbpp/415", "solution": "from typing import List, Tuple\ndef max_Product(numbers: List[int]) -> Tuple[int, int]:\n    \"\"\"\n    Return the pair of integers from 'numbers' that yields the maximum product.\n    The returned tuple is sorted in ascending order.\n    \"\"\"\n    if len(numbers) < 2:\n        raise ValueError(\"At least two integers required\")\n\n    # Initialize extremes to find the two largest and two smallest numbers\n    # max1 will hold the largest, max2 the second largest\n    # min1 will hold the smallest, min2 the second smallest\n    max1 = max2 = float('-inf')\n    min1 = min2 = float('inf')\n\n    for num in numbers:\n        # Update max values\n        if num > max1:\n            max2 = max1\n            max1 = num\n        elif num > max2:\n            max2 = num\n\n        # Update min values\n        if num < min1:\n            min2 = min1\n            min1 = num\n        elif num < min2:\n            min2 = num\n\n    # Determine best pair: either the two largest numbers or the two smallest (negatives)\n    prod_max_positives = max1 * max2\n    prod_two_negatives = min1 * min2\n\n    if prod_max_positives >= prod_two_negatives:\n        pair = (max2, max1)\n    else:\n        pair = (min1, min2)\n\n    # Return the pair sorted in ascending order\n    return tuple(sorted(pair))"}
{"task_id": "Mbpp/413", "solution": "from typing import List, Tuple, Any\nclass ElementExtractor:\n    \"\"\"\n    Handles the extraction of the nth element from a list of tuples.\n    This class encapsulates the core logic as per system design.\n    \"\"\"\n    def extract_nth_element(self, tuples_list: List[Tuple], n: int) -> List[Any]:\n        \"\"\"\n        Extracts the nth element from each tuple in the provided list.\n        Raises IndexError if n is out of bounds for any tuple.\n        \"\"\"\n        result = []\n        for i, tpl in enumerate(tuples_list):\n            try:\n                result.append(tpl[n])\n            except IndexError:\n                raise IndexError(f\"Tuple at index {i} has {len(tpl)} elements, but tried to access index {n}.\")\n        return result\ndef extract_nth_element(tuples: List[Tuple], n: int) -> List[Any]:\n    \"\"\"\n    Extracts the nth element from each tuple in a list.\n    Delegates the extraction logic to an ElementExtractor instance.\n    \"\"\"\n    extractor = ElementExtractor()\n    return extractor.extract_nth_element(tuples, n)"}
