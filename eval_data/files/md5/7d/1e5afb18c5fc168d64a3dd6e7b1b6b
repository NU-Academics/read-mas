{"task_id": "Mbpp/99", "solution": "def decimal_to_binary(number: int) -> str:\n    \"\"\"\n    Converts a non-negative decimal integer to its binary equivalent as a string.\n    The string will have no leading zeros, except for the number 0 itself.\n    \"\"\"\n    # Python's built-in bin() function returns a string prefixed with '0b'.\n    # Slicing [2:] removes this prefix. For number 0, bin(0) is '0b0', which becomes '0' after slicing.\n    return bin(number)[2:]"}
{"task_id": "Mbpp/103", "solution": "def eulerian_num(n: int, m: int) -> int:\n    \"\"\"Calculates the Eulerian number a(n, m) using dynamic programming.\n    This counts permutations of {1, ..., n} with exactly m ascents.\n    \"\"\"\n    if n < 0 or m < 0:\n        raise ValueError(\"Invalid arguments: n and m must be non-negative.\")\n\n    if n == 0:\n        if m == 0:\n            return 1\n        else:\n            raise ValueError(\"Invalid arguments: for n=0, m must be 0.\")\n\n    # For n > 0, m must be in the range [0, n-1]\n    if m >= n:\n        raise ValueError(f\"Invalid arguments: for n={n}, m={m} must be < n.\")\n\n    # Initialize a 2D DP table. dp[i][j] stores a(i,j).\n    # We use (n+1) x (n+1) size for simpler indexing, though m only goes up to n-1.\n    dp = [[0] * (n + 1) for _ in range(n + 1)]\n\n    # Base case for the recurrence: a(0,0) = 1.\n    dp[0][0] = 1\n\n    # Fill the DP table using the recurrence relation:\n    # a(i,j) = (i-j)*a(i-1,j-1) + (j+1)*a(i-1,j)\n    for i in range(1, n + 1):\n        for j in range(i):  # m ranges from 0 to i-1\n            # Term for a(i-1, j-1). Handle j=0 case separately as j-1 would be negative.\n            left_term = (i - j) * dp[i - 1][j - 1] if j > 0 else 0\n\n            # Term for a(i-1, j)\n            right_term = (j + 1) * dp[i - 1][j]\n\n            dp[i][j] = left_term + right_term\n\n    return dp[n][m]"}
