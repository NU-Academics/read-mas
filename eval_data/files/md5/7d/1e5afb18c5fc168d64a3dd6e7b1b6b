{"task_id": "Mbpp/731", "solution": "import math\nclass Cone:\n    \"\"\"Represents a right circular cone with a given radius and height.\"\"\"\n    def __init__(self, radius: float, height: float):\n        \"\"\"Initializes the Cone with radius and height, validating inputs.\"\"\"\n        if radius <= 0 or height <= 0:\n            raise ValueError(\"Radius and height must be positive numbers.\")\n        self.radius = radius\n        self.height = height\n\n    def lateralSurfaceArea(self) -> float:\n        \"\"\"Calculates the lateral surface area of the cone.\"\"\"\n        slant_height = math.sqrt(self.radius**2 + self.height**2)\n        return math.pi * self.radius * slant_height\ndef lateralsurface_cone(r: float, h: float) -> float:\n    \"\"\"Calculates the lateral surface area of a cone given radius r and height h.\"\"\"\n    cone = Cone(r, h)\n    return cone.lateralSurfaceArea()"}
{"task_id": "Mbpp/739", "solution": "class TriangularNumber:\n    def __init__(self, index: int):\n        self.index = index\n        self.value = index * (index + 1) // 2\n\n    def digit_count(self) -> int:\n        \"\"\"Return the number of decimal digits of the triangular number.\"\"\"\n        return len(str(self.value))\nclass TriangularNumberFinder:\n    def find_index(self, n: int) -> int:\n        k = 1\n        while True:\n            tri = TriangularNumber(k)\n            if tri.digit_count() >= n:\n                return k\n            k += 1\ndef find_Index(n: int) -> int:\n    \"\"\"Finds the index of the smallest triangular number with at least n digits.\"\"\"\n    finder = TriangularNumberFinder()\n    return finder.find_index(n)"}
