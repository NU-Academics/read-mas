{"task_id": "Mbpp/141", "solution": "from typing import List, Any\ndef pancake_sort(input_list: List[Any]) -> List[Any]:\n    \"\"\"Sorts a list using the pancake sort algorithm and returns a new sorted list.\n    The original input list remains unchanged.\n    \"\"\"\n    n = len(input_list)\n    if n <= 1:\n        return list(input_list)\n\n    arr = list(input_list)\n\n    def _flip(sub_arr: List[Any], k: int):\n        \"\"\"Reverses the sub-array from index 0 to k (inclusive).\"\"\"\n        start = 0\n        while start < k:\n            sub_arr[start], sub_arr[k] = sub_arr[k], sub_arr[start]\n            start += 1\n            k -= 1\n\n    for curr_size in range(n, 1, -1):\n        # Find the index of the maximum element in the current unsorted portion\n        max_idx = 0\n        for i in range(1, curr_size):\n            if arr[i] > arr[max_idx]:\n                max_idx = i\n\n        # If the maximum element is not already at its correct position\n        if max_idx != curr_size - 1:\n            # First flip: bring the maximum element to the front\n            _flip(arr, max_idx)\n            # Second flip: move the maximum element to its sorted position\n            _flip(arr, curr_size - 1)\n            \n    return arr"}
{"task_id": "Mbpp/160", "solution": "import math\ndef find_solution(a, b, n):\n    \"\"\"\n    Finds integer solutions (x, y) for the linear Diophantine equation ax + by = n.\n    Returns (x, y) as a tuple if a solution exists, otherwise returns None.\n    \"\"\"\n    if a == 0 and b == 0:\n        return (0, 0) if n == 0 else None\n\n    # Handle cases where one coefficient is zero\n    if a == 0:\n        if n % b == 0:\n            return (0, n // b)\n        else:\n            return None\n    if b == 0:\n        if n % a == 0:\n            return (n // a, 0)\n        else:\n            return None\n\n    common_divisor = math.gcd(a, b)\n\n    if n % common_divisor != 0:\n        return None\n\n    # Reduce the equation by the common divisor\n    a_prime = a // common_divisor\n    b_prime = b // common_divisor\n    n_prime = n // common_divisor\n\n    # Extended Euclidean algorithm to find x0, y0 such that a_prime*x0 + b_prime*y0 = 1\n    # This loop calculates gcd(a_prime, b_prime) and coefficients for it.\n    # Since a_prime and b_prime are coprime, their gcd is 1.\n    x0, y0, r0 = 1, 0, a_prime\n    x1, y1, r1 = 0, 1, b_prime\n\n    while r1 != 0:\n        q = r0 // r1\n        x0, x1 = x1, x0 - q * x1\n        y0, y1 = y1, y0 - q * y1\n        r0, r1 = r1, r0 - q * r1\n\n    # Now r0 is gcd(a_prime, b_prime), which is 1.\n    # And x0, y0 are coefficients such that a_prime*x0 + b_prime*y0 = 1.\n\n    # Multiply by n_prime to get a_prime*(x0*n_prime) + b_prime*(y0*n_prime) = n_prime\n    x_particular = x0 * n_prime\n    y_particular = y0 * n_prime\n\n    # This provides one solution (x_particular, y_particular).\n    # The problem asks for any solution, so this one is sufficient.\n    return (x_particular, y_particular)"}
