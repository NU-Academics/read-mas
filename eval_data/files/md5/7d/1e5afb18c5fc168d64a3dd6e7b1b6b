{"task_id": "Mbpp/618", "solution": "def div_list(list1, list2):\n    \"\"\"\n    Divides elements of two lists element-wise, returning a new list of floats.\n    Raises ZeroDivisionError if any element in the second list is zero.\n    \"\"\"\n    result = []\n    for a, b in zip(list1, list2):\n        if b == 0:\n            raise ZeroDivisionError(\"division by zero\")\n        result.append(float(a) / float(b))\n    return result"}
{"task_id": "Mbpp/619", "solution": "def move_num(input_string: str) -> str:\n    \"\"\"\n    Moves all numeric characters to the end of the given string,\n    preserving the relative order of both non-numeric and numeric characters.\n    \"\"\"\n    non_digits = []\n    digits = []\n    for char in input_string:\n        if '0' <= char <= '9':  # check if character is a digit\n            digits.append(char)\n        else:\n            non_digits.append(char)\n    return \"\".join(non_digits) + \"\".join(digits)"}
{"task_id": "Mbpp/620", "solution": "from typing import List\ndef largest_subset(numbers: List[int]) -> int:\n    \"\"\"\n    Finds the size of the largest subset of numbers where every pair is divisible.\n    It uses dynamic programming, sorting the input first to build up divisible chains.\n    \"\"\"\n    nums = sorted(numbers)\n    n = len(nums)\n    dp = [1] * n\n\n    for i in range(n):\n        for j in range(i):\n            if nums[i] % nums[j] == 0:\n                dp[i] = max(dp[i], dp[j] + 1)\n\n    return max(dp)"}
