{"task_id": "Mbpp/299", "solution": "def max_aggregate(data):\n    \"\"\"\n    Calculates the maximum aggregate score from a list of (name, score) tuples.\n    Aggregates scores for each name and returns the name with the highest total score.\n    \"\"\"\n    aggregated_scores = {}\n    for name, score in data:\n        aggregated_scores[name] = aggregated_scores.get(name, 0) + score\n\n    if not aggregated_scores:\n        return None  # Or raise an error, or return a default as per design, but None is reasonable for empty input\n\n    max_name = None\n    max_score = -1\n\n    for name, total_score in aggregated_scores.items():\n        if total_score > max_score:\n            max_score = total_score\n            max_name = name\n\n    return (max_name, max_score)"}
{"task_id": "Mbpp/296", "solution": "from typing import List\nclass InversionCounter:\n    def countInversions(self, arr: List[int]) -> int:\n        \"\"\"Counts inversions using a merge-sort based approach.\"\"\"\n        if not arr:\n            return 0\n        _, inv_count = self._merge_sort(arr)\n        return inv_count\n\n    def _merge_sort(self, arr: List[int]):\n        \"\"\"Recursively sorts and counts inversions.\"\"\"\n        if len(arr) <= 1:\n            return arr, 0\n        mid = len(arr) // 2\n        left, inv_left = self._merge_sort(arr[:mid])\n        right, inv_right = self._merge_sort(arr[mid:])\n        merged, inv_split = self._merge(left, right)\n        return merged, inv_left + inv_right + inv_split\n\n    def _merge(self, left: List[int], right: List[int]):\n        \"\"\"Merges two sorted arrays and counts split inversions.\"\"\"\n        merged = []\n        i = j = inv_count = 0\n        while i < len(left) and j < len(right):\n            if left[i] <= right[j]:\n                merged.append(left[i]); i += 1\n            else:\n                merged.append(right[j]); j += 1\n                inv_count += len(left) - i\n        merged.extend(left[i:])\n        merged.extend(right[j:])\n        return merged, inv_count\ndef get_Inv_Count(arr: List[int]) -> int:\n    \"\"\"Return the number of inversions in *arr*.\"\"\"\n    counter = InversionCounter()\n    return counter.countInversions(arr)"}
{"task_id": "Mbpp/427", "solution": "from datetime import datetime\ndef change_date_format(date_str: str) -> str:\n    \"\"\"\n    Converts a date string from 'yyyy-mm-dd' format to 'dd-mm-yyyy' format.\n    Validates the input date format and value using the datetime module.\n    \"\"\"\n    try:\n        # Parse the input date string from yyyy-mm-dd format\n        dt_object = datetime.strptime(date_str, \"%Y-%m-%d\")\n        # Format the datetime object to dd-mm-yyyy format\n        return dt_object.strftime(\"%d-%m-%Y\")\n    except ValueError as e:\n        # Re-raise ValueError if parsing fails due to invalid format or date\n        raise ValueError(f\"Invalid date format or value: {date_str}. Expected 'yyyy-mm-dd'. Original error: {e}\")"}
