{"task_id": "Mbpp/119", "solution": "def search(array: list) -> int:\n    \"\"\"\n    Finds the element that appears only once in a sorted array where all other elements appear twice.\n    Uses a binary search approach to achieve O(log n) time complexity.\n    \"\"\"\n    low, high = 0, len(array) - 1\n\n    while low < high:\n        mid = (low + high) // 2\n\n        # If mid is even, check with the next element (mid+1)\n        # If mid is odd, check with the previous element (mid-1)\n        if (mid % 2 == 0 and array[mid] == array[mid + 1]) or \\\n           (mid % 2 == 1 and array[mid] == array[mid - 1]):\n            # The unique element is in the right half\n            low = mid + 1\n        else:\n            # The unique element is in the left half or is at mid\n            high = mid\n\n    return array[low]"}
{"task_id": "Mbpp/120", "solution": "from typing import List, Tuple\ndef max_product_tuple(tuples: List[Tuple[int, int]]) -> int:\n    \"\"\"\n    Finds the maximum absolute product of numbers within each tuple in the list.\n    Assumes valid input conforming to the type hint.\n    \"\"\"\n    # Initialize with the absolute product of the first tuple\n    max_abs_prod = abs(tuples[0][0] * tuples[0][1])\n\n    # Iterate through the rest of the tuples to find the maximum absolute product\n    for a, b in tuples[1:]:\n        current_prod = abs(a * b)\n        if current_prod > max_abs_prod:\n            max_abs_prod = current_prod\n\n    return max_abs_prod"}
{"task_id": "Mbpp/123", "solution": "def amicable_numbers_sum(N: int) -> int:\n    \"\"\"Calculates the sum of all amicable numbers up to N.\"\"\"\n\n    def _sum_of_proper_divisors(n: int) -> int:\n        \"\"\"Returns the sum of proper divisors for a given number n.\"\"\"\n        if n <= 1:\n            return 0\n        total = 1\n        for i in range(2, int(n**0.5) + 1):\n            if n % i == 0:\n                total += i\n                if i * i != n:\n                    total += n // i\n        return total\n\n    total_amicable_sum = 0\n    found_amicable_numbers = set()\n\n    for a in range(1, N + 1):\n        if a in found_amicable_numbers:\n            continue\n\n        b = _sum_of_proper_divisors(a)\n\n        if b > a and b <= N:\n            sum_div_b = _sum_of_proper_divisors(b)\n            if sum_div_b == a:\n                total_amicable_sum += a + b\n                found_amicable_numbers.add(a)\n                found_amicable_numbers.add(b)\n\n    return total_amicable_sum"}
