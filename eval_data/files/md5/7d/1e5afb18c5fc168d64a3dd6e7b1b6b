{"task_id": "Mbpp/637", "solution": "class Transaction:\n    \"\"\"\n    Represents a financial transaction with associated cost and revenue.\n    Provides a method to check for a no profit, no loss condition.\n    \"\"\"\n    def __init__(self, cost: float, revenue: float):\n        self.cost = cost\n        self.revenue = revenue\n\n    def noprofit_noloss(self) -> bool:\n        \"\"\"\n        Determines if the transaction resulted in no profit and no loss.\n        This occurs when the cost exactly equals the revenue.\n        \"\"\"\n        return self.cost == self.revenue\ndef noprofit_noloss(cost: float, revenue: float) -> bool:\n    \"\"\"\n    Checks if a given amount for a transaction has no profit and no loss.\n    This condition is met when the cost of the transaction equals its revenue.\n    \"\"\"\n    transaction = Transaction(cost, revenue)\n    return transaction.noprofit_noloss()"}
{"task_id": "Mbpp/633", "solution": "from typing import List\ndef pair_xor_Sum(numbers: List[int], n: int) -> int:\n    \"\"\"\n    Finds the sum of XOR of all unique pairs of numbers in the given list up to index n-1.\n    Iterates through all i < j < n, calculates numbers[i] ^ numbers[j], and sums these values.\n    \"\"\"\n    total_xor_sum = 0\n    for i in range(n):\n        for j in range(i + 1, n):\n            total_xor_sum += (numbers[i] ^ numbers[j])\n    return total_xor_sum"}
{"task_id": "Mbpp/635", "solution": "from typing import List\nclass IntegerList:\n    def __init__(self, elements: list[int]):\n        \"\"\"Initializes IntegerList with a copy of the given elements.\"\"\"\n        self.elements = list(elements)\nclass Heap:\n    def __init__(self):\n        \"\"\"Initializes an empty min-heap.\"\"\"\n        self._heap = []\n\n    def _parent(self, i):\n        return (i - 1) // 2\n\n    def _left_child(self, i):\n        return 2 * i + 1\n\n    def _right_child(self, i):\n        return 2 * i + 2\n\n    def _heapify_up(self, i):\n        \"\"\"Sifts an element up to maintain heap property.\"\"\"\n        while i > 0 and self._heap[self._parent(i)] > self._heap[i]:\n            parent_idx = self._parent(i)\n            self._heap[i], self._heap[parent_idx] = self._heap[parent_idx], self._heap[i]\n            i = parent_idx\n\n    def _heapify_down(self, i):\n        \"\"\"Sifts an element down to maintain heap property.\"\"\"\n        n = len(self._heap)\n        smallest = i\n        left = self._left_child(i)\n        right = self._right_child(i)\n\n        if left < n and self._heap[left] < self._heap[smallest]:\n            smallest = left\n        if right < n and self._heap[right] < self._heap[smallest]:\n            smallest = right\n\n        if smallest != i:\n            self._heap[i], self._heap[smallest] = self._heap[smallest], self._heap[i]\n            self._heapify_down(smallest)\n\n    def buildHeap(self, elements: list[int]):\n        \"\"\"Builds a min-heap from a list of elements.\"\"\"\n        self._heap = list(elements)\n        n = len(self._heap)\n        for i in range(n // 2 - 1, -1, -1):\n            self._heapify_down(i)\n\n    def extractMin(self) -> int:\n        \"\"\"Removes and returns the smallest element from the heap.\"\"\"\n        if len(self._heap) == 1:\n            return self._heap.pop()\n\n        root = self._heap[0]\n        self._heap[0] = self._heap.pop()\n        if self._heap:\n            self._heapify_down(0)\n        return root\n\n    def is_empty(self) -> bool:\n        \"\"\"Checks if the heap is empty.\"\"\"\n        return len(self._heap) == 0\ndef heap_sort(list: List[int]) -> List[int]:\n    \"\"\"Sorts a list of integers using the heap sort algorithm.\"\"\"\n    if not list:\n        return []\n\n    integer_list_wrapper = IntegerList(list)\n    \n    min_heap = Heap()\n    min_heap.buildHeap(integer_list_wrapper.elements)\n\n    sorted_list = []\n    while not min_heap.is_empty():\n        sorted_list.append(min_heap.extractMin())\n    \n    return sorted_list"}
{"task_id": "Mbpp/638", "solution": "import math\ndef wind_chill(wind_velocity, temperature):\n    \"\"\"\n    Calculates the wind chill index given wind velocity in km/h and temperature in Celsius,\n    rounded up to the next integer.\n    \"\"\"\n    v_pow = wind_velocity ** 0.16\n    wci = 13.12 + 0.6215 * temperature - 11.37 * v_pow + 0.3965 * temperature * v_pow\n    return int(math.ceil(wci))"}
{"task_id": "Mbpp/641", "solution": "def is_nonagonal(n):\n    \"\"\"\n    Calculates the nth nonagonal number using the formula n * (7n - 5) / 2.\n    \"\"\"\n    return n * (7 * n - 5) // 2"}
{"task_id": "Mbpp/643", "solution": "import re\ndef text_match_wordz_middle(input_string: str) -> bool:\n    \"\"\"\n    Checks if a string contains 'z' anywhere except at the start or end of a word.\n    Words are considered sequences of alphabetic characters.\n    \"\"\"\n    words = re.findall(r'[a-zA-Z]+', input_string)\n    for word in words:\n        # Check for 'z' in the substring excluding the first and last characters\n        if 'z' in word[1:-1]:\n            return True\n    return False"}
{"task_id": "Mbpp/644", "solution": "def reverse_Array_Upto_K(arr, k):\n    \"\"\"\n    Reverses an array up to a given position k.\n    Returns a new list with elements from index 0 up to k-1 reversed, leaving the original array unchanged.\n    \"\"\"\n    new_arr = list(arr)\n    new_arr[0:k] = new_arr[0:k][::-1]\n    return new_arr"}
