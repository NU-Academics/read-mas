{"task_id": "Mbpp/591", "solution": "def swap_List(lst: list) -> list:\n    \"\"\"\n    Interchanges the first and last elements of a list, returning a new list.\n    The original list remains unmodified.\n    \"\"\"\n    if len(lst) < 2:\n        return lst.copy()\n    \n    new_lst = lst.copy()\n    new_lst[0], new_lst[-1] = new_lst[-1], new_lst[0]\n    return new_lst"}
{"task_id": "Mbpp/590", "solution": "import math\ndef polar_rect(radius, angle):\n    \"\"\"\n    Converts polar coordinates (radius, angle) to rectangular coordinates (x, y)\n    and returns them as a complex number x + yj.\n    \"\"\"\n    x = radius * math.cos(angle)\n    y = radius * math.sin(angle)\n    return complex(x, y)"}
{"task_id": "Mbpp/592", "solution": "class BinomialCoefficient:\n    \"\"\"\n    Helper class to compute binomial coefficients using the multiplicative formula.\n    \"\"\"\n\n    @staticmethod\n    def compute(n: int, k: int) -> int:\n        \"\"\"\n        Compute C(n, k) = n! / (k! (n-k)!) using an efficient multiplicative approach.\n        \"\"\"\n        if k < 0 or k > n:\n            return 0\n        if k == 0 or k == n:\n            return 1\n        k = min(k, n - k)\n        result = 1\n        for i in range(1, k + 1):\n            result = result * (n - k + i) // i\n        return result\nclass BinomialCoefficientCalculator:\n    \"\"\"\n    Core calculator that implements the sum of products algorithm.\n    \"\"\"\n\n    @staticmethod\n    def sum_of_product(n: int) -> int:\n        \"\"\"\n        Compute \u03a3_{k=0}^{n-1} C(n,k) * C(n,k+1).\n        \"\"\"\n        if n < 0:\n            raise ValueError(\"n must be a non\u2011negative integer\")\n        if n == 0:\n            return 0\n\n        total = 0\n        for k in range(n):\n            c_k = BinomialCoefficient.compute(n, k)\n            c_k1 = BinomialCoefficient.compute(n, k + 1)\n            total += c_k * c_k1\n        return total\ndef sum_Of_product(n: int) -> int:\n    \"\"\"\n    Public API that returns the sum of products of consecutive binomial coefficients for n.\n    \"\"\"\n    return BinomialCoefficientCalculator.sum_of_product(n)"}
