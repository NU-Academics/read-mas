nts)\n\n    for i in range(n):\n        for j in range(i + 1, n):\n            pair = Pair(elements[i], elements[j])\n            xor_result = xor_calculator.compute(pair)\n            if even_checker.is_even(xor_result):\n                counter.increment()\n\n    return counter.get_count()"}
{"task_id": "Mbpp/167", "solution": "import math\ndef next_power_of_2(n):\n    \"\"\"\n    Finds the smallest power of 2 greater than or equal to n.\n    Handles n <= 0 by returning 1.\n    \"\"\"\n    if n <= 0:\n        return 1\n    \n    # Use math.ceil(math.log2(n)) to find the exponent k, then calculate 2**k.\n    # The bit shift operator (1 << k) is an efficient way to calculate 2**k.\n    k = math.ceil(math.log2(n))\n    return 1 << k"}
