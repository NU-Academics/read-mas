{"task_id": "Mbpp/62", "solution": "from typing import List\nclass NumberList:\n    \"\"\"Encapsulates a list of numbers and provides methods to find the smallest.\"\"\"\n    def __init__(self, numbers: List[int]):\n        self.numbers = numbers\n\n    def smallest(self) -> int:\n        \"\"\"Finds and returns the smallest number in the encapsulated list.\"\"\"\n        return min(self.numbers)\ndef smallest_num(numbers: List[int]) -> int:\n    \"\"\"\n    Finds the smallest number in a list of integers.\n    Raises ValueError if the input list is empty.\n    \"\"\"\n    if not numbers:\n        raise ValueError(\"Input list cannot be empty.\")\n    \n    number_list_entity = NumberList(numbers)\n    return number_list_entity.smallest()"}
{"task_id": "Mbpp/61", "solution": "def count_Substrings(input: str) -> int:\n    \"\"\"\n    Count substrings where the sum of digits equals the substring length.\n    Raises ValueError if input contains non-digit characters.\n    \"\"\"\n    if not input:\n        return 0\n\n    for char in input:\n        if not '0' <= char <= '9':\n            raise ValueError(\"Input string must contain only digits.\")\n\n    count = 0\n    n = len(input)\n\n    for i in range(n):\n        current_sum = 0\n        for j in range(i, n):\n            digit = int(input[j])\n            current_sum += digit\n\n            substring_length = j - i + 1\n\n            if current_sum == substring_length:\n                count += 1\n\n    return count"}
