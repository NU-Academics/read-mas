{"task_id": "Mbpp/125", "solution": "def find_length(s):\n    \"\"\"\n    Finds the maximum difference between the count of 0s and 1s in any substring.\n    This uses a linear scan approach by transforming '0' to +1 and '1' to -1,\n    then finding the maximum range (max prefix sum - min prefix sum) of the\n    resulting sequence.\n    \"\"\"\n    if not s:\n        return 0\n\n    current_balance = 0\n    min_balance_seen = 0\n    max_balance_seen = 0\n    max_difference = 0\n\n    for char in s:\n        if char == '0':\n            current_balance += 1\n        else:  # char == '1'\n            current_balance -= 1\n\n        # The maximum difference is the largest range between any two prefix sums.\n        # This considers differences ending at the current point (current_balance - min_balance_seen)\n        # and differences starting from points where max_balance_seen was achieved (max_balance_seen - current_balance).\n        max_difference = max(max_difference, current_balance - min_balance_seen)\n        max_difference = max(max_difference, max_balance_seen - current_balance)\n\n        min_balance_seen = min(min_balance_seen, current_balance)\n        max_balance_seen = max(max_balance_seen, current_balance)\n\n    return max_difference"}
{"task_id": "Mbpp/129", "solution": "class Matrix:\n    \"\"\"\n    Represents a square matrix and provides methods for validation and sum calculations.\n    \"\"\"\n    def __init__(self, values: list[list[int]]):\n        self.values = values\n        self.size = len(values) if values else 0\n\n    def isSquare(self) -> bool:\n        \"\"\"\n        Checks if the matrix is square (N rows and N columns for all rows).\n        \"\"\"\n        if not self.values:\n            return False # An empty matrix is not considered a square matrix in this context.\n\n        num_rows = len(self.values)\n        if num_rows == 0:\n            return False\n\n        first_row_len = len(self.values[0])\n        if first_row_len == 0:\n            return False # A matrix with empty rows is not square.\n\n        if num_rows != first_row_len:\n            return False\n\n        for row in self.values:\n            if len(row) != first_row_len:\n                return False\n        return True\n\n    def sumRow(self, rowIndex: int) -> int:\n        \"\"\"\n        Calculates the sum of elements in a specified row.\n        \"\"\"\n        return sum(self.values[rowIndex])\n\n    def sumColumn(self, colIndex: int) -> int:\n        \"\"\"\n        Calculates the sum of elements in a specified column.\n        \"\"\"\n        col_sum = 0\n        for row_index in range(self.size):\n            col_sum += self.values[row_index][colIndex]\n        return col_sum\n\n    def sumMainDiagonal(self) -> int:\n        \"\"\"\n        Calculates the sum of elements along the main diagonal (top-left to bottom-right).\n        \"\"\"\n        diag_sum = 0\n        for i in range(self.size):\n            diag_sum += self.values[i][i]\n        return diag_sum\n\n    def sumAntiDiagonal(self) -> int:\n        \"\"\"\n        Calculates the sum of elements along the anti-diagonal (top-right to bottom-left).\n        \"\"\"\n        diag_sum = 0\n        for i in range(self.size):\n            diag_sum += self.values[i][self.size - 1 - i]\n        return diag_sum\ndef magic_square_test(matrix: list[list[int]]) -> bool:\n    \"\"\"\n    Determines if a given two-dimensional integer matrix is a magic square.\n    It checks if all row, column, and both main diagonal sums are equal.\n    \"\"\"\n    m = Matrix(matrix)\n\n    if not m.isSquare():\n        return False\n\n    # A 0x0 square matrix is not considered a magic square.\n    if m.size == 0:\n        return False\n        \n    # The magic sum can be derived from the first row.\n    magic_sum = m.sumRow(0)\n\n    # Check all row sums\n    for i in range(m.size):\n        if m.sumRow(i) != magic_sum:\n            return False\n\n    # Check all column sums\n    for i in range(m.size):\n        if m.sumColumn(i) != magic_sum:\n            return False\n\n    # Check main diagonal sum\n    if m.sumMainDiagonal() != magic_sum:\n        return False\n\n    # Check anti-diagonal sum\n    if m.sumAntiDiagonal() != magic_sum:\n        return False\n\n    return True"}
{"task_id": "Mbpp/130", "solution": "from typing import List, Any, Optional\ndef max_occurrences(lst: List[Any]) -> Optional[Any]:\n    \"\"\"\n    Finds the item with the maximum frequency in a given list.\n    Returns None if the list is empty.\n    \"\"\"\n    if not lst:\n        return None\n\n    frequency_map = {}\n    for item in lst:\n        frequency_map[item] = frequency_map.get(item, 0) + 1\n\n    # Return the item (key) that has the maximum frequency (value)\n    return max(frequency_map, key=frequency_map.get)"}
