{"task_id": "Mbpp/573", "solution": "from typing import List\ndef unique_product(numbers: List[int]) -> int:\n    \"\"\"\n    Calculates the product of all unique numbers in a given list.\n    Uses a set to deduplicate elements and computes the product.\n    \"\"\"\n    unique_nums = set()\n    product = 1\n\n    for num in numbers:\n        if num not in unique_nums:\n            unique_nums.add(num)\n            product *= num\n            \n    return product"}
{"task_id": "Mbpp/576", "solution": "from typing import List, Any\ndef is_Sub_Array(main: List[Any], sub: List[Any]) -> bool:\n    \"\"\"\n    Checks if a list is a contiguous sublist of another.\n    This function implements an O(n*m) sliding window comparison.\n    \"\"\"\n    if not sub:\n        return True\n    if len(sub) > len(main):\n        return False\n\n    for i in range(len(main) - len(sub) + 1):\n        if main[i : i + len(sub)] == sub:\n            return True\n    return False"}
{"task_id": "Mbpp/577", "solution": "def last_Digit_Factorial(n: int) -> int:\n    \"\"\"\n    Returns the last decimal digit of n! for a non-negative integer n.\n    For n >= 5, the last digit is 0.\n    \"\"\"\n    if n < 5:\n        fact = 1\n        for i in range(2, n + 1):\n            fact *= i\n        return fact % 10\n    else:\n        return 0"}
{"task_id": "Mbpp/579", "solution": "def find_dissimilar(tuple1: tuple, tuple2: tuple) -> tuple:\n    \"\"\"\n    Finds elements present in either tuple but not in both (symmetric difference).\n    The result is returned as a sorted tuple.\n    \"\"\"\n    set1 = set(tuple1)\n    set2 = set(tuple2)\n    dissimilar_elements = set1.symmetric_difference(set2)\n    return tuple(sorted(list(dissimilar_elements)))"}
{"task_id": "Mbpp/578", "solution": "from typing import List, TypeVar\nT = TypeVar('T')\ndef interleave_lists(list1: List[T], list2: List[T], list3: List[T]) -> List[T]:\n    \"\"\"\n    Interleaves three lists of equal length into a single flat list.\n    Raises ValueError if the input lists are not of equal length.\n    \"\"\"\n    if not (len(list1) == len(list2) == len(list3)):\n        raise ValueError(\"All input lists must have the same length.\")\n\n    interleaved: List[T] = [\n        elem\n        for pair in zip(list1, list2, list3)\n        for elem in pair\n    ]\n    return interleaved"}
{"task_id": "Mbpp/580", "solution": "def extract_even(input_tuple: tuple) -> tuple:\n    \"\"\"\n    Recursively removes odd integers from a nested tuple, preserving the structure.\n    Non-integer elements are assumed to be tuples to be further processed.\n    \"\"\"\n    def _process_tuple(current_tuple):\n        result = []\n        for item in current_tuple:\n            if isinstance(item, tuple):\n                # Recursively process nested tuples\n                processed_sub_tuple = _process_tuple(item)\n                # Only add non-empty sub-tuples to preserve structure\n                if processed_sub_tuple:\n                    result.append(processed_sub_tuple)\n            elif item % 2 == 0:\n                # Add even integers\n                result.append(item)\n        return tuple(result)\n\n    return _process_tuple(input_tuple)"}
{"task_id": "Mbpp/583", "solution": "import math\ndef catalan_number(n: int) -> int:\n    \"\"\"\n    Compute the nth Catalan number using the formula C(n) = comb(2n, n) // (n + 1).\n    Raises ValueError if n is negative.\n    \"\"\"\n    if n < 0:\n        raise ValueError(\"n must be a non-negative integer\")\n\n    return math.comb(2 * n, n) // (n + 1)"}
