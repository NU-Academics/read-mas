{"task_id": "Mbpp/607", "solution": "import re\nfrom typing import Optional, Tuple\ndef find_literals(text: str, pattern: str) -> Optional[Tuple[str, int, int]]:\n    \"\"\"\n    Search `text` for the first occurrence of `pattern`.\n\n    Returns (substring, start_index, end_index) if a match is found, else None.\n    \"\"\"\n    match = re.search(pattern, text)\n    if match is None:\n        return None\n    start, end = match.span()\n    return match.group(), start, end"}
{"task_id": "Mbpp/608", "solution": "def bell_Number(n: int) -> int:\n    \"\"\"\n    Calculates the nth Bell number using dynamic programming based on the\n    recurrence relation B(i) = \u03a3_{k=0}^{i-1} C(i-1, k) * B(k).\n    \"\"\"\n\n    if n == 0:\n        return 1\n\n    def nCr(n_val, r_val):\n        \"\"\"Calculates the binomial coefficient (n_val choose r_val).\"\"\"\n        if r_val < 0 or r_val > n_val:\n            return 0\n        if r_val == 0 or r_val == n_val:\n            return 1\n        if r_val > n_val // 2:\n            r_val = n_val - r_val\n        \n        res = 1\n        for i in range(r_val):\n            res = res * (n_val - i) // (i + 1)\n        return res\n\n    bell_numbers = [0] * (n + 1)\n    bell_numbers[0] = 1\n\n    for i in range(1, n + 1):\n        current_bell = 0\n        # B(i) = sum_{k=0 to i-1} C(i-1, k) * B(k)\n        for k in range(i):\n            current_bell += nCr(i - 1, k) * bell_numbers[k]\n        bell_numbers[i] = current_bell\n\n    return bell_numbers[n]"}
{"task_id": "Mbpp/610", "solution": "from typing import List, Any\ndef remove_kth_element(lst: List[Any], k: int) -> List[Any]:\n    \"\"\"\n    Returns a new list with the k'th element removed, without modifying the original.\n    Raises IndexError if k is out of bounds.\n    \"\"\"\n    if not 0 <= k < len(lst):\n        raise IndexError(f\"Index {k} out of range for list of length {len(lst)}\")\n\n    return lst[:k] + lst[k+1:]"}
{"task_id": "Mbpp/611", "solution": "def max_of_nth(matrix: list[list[int]], n: int) -> int:\n    \"\"\"\n    Returns the maximum value in the n-th column of a given matrix.\n    Raises ValueError for invalid matrix or IndexError if n is out of bounds.\n    \"\"\"\n    if not matrix or not all(isinstance(row, list) for row in matrix):\n        raise ValueError(\"Matrix must be a non-empty list of lists.\")\n    if not all(len(row) == len(matrix[0]) for row in matrix):\n        raise ValueError(\"All rows in the matrix must have the same length.\")\n    if not matrix[0]:  # Handle empty columns (e.g., matrix = [[]])\n        raise ValueError(\"Matrix must contain at least one column.\")\n\n    num_rows = len(matrix)\n    num_cols = len(matrix[0])\n\n    if not (0 <= n < num_cols):\n        raise IndexError(\"Column index 'n' is out of bounds.\")\n\n    max_val = matrix[0][n]\n    for r in range(1, num_rows):\n        if matrix[r][n] > max_val:\n            max_val = matrix[r][n]\n\n    return max_val"}
{"task_id": "Mbpp/614", "solution": "from typing import List, Tuple\ndef cummulative_sum(list_of_tuples: List[Tuple[int]]) -> int:\n    \"\"\"Calculates the cumulative sum of all integers present in a list of tuples.\n    It iterates through each tuple and sums all its elements.\"\"\"\n    total_sum = 0\n    for tpl in list_of_tuples:\n        for item in tpl:\n            total_sum += item\n    return total_sum"}
