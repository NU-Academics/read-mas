{"task_id": "Mbpp/594", "solution": "def diff_even_odd(numbers):\n    \"\"\"\n    Finds the difference between the first even and first odd number in a list.\n    Assumes the list contains at least one even and one odd number.\n    \"\"\"\n    first_even = None\n    first_odd = None\n\n    for num in numbers:\n        if first_even is None and num % 2 == 0:\n            first_even = num\n        elif first_odd is None and num % 2 != 0:\n            first_odd = num\n\n        if first_even is not None and first_odd is not None:\n            break\n            \n    return first_even - first_odd"}
{"task_id": "Mbpp/598", "solution": "def armstrong_number(number: int) -> bool:\n    \"\"\"\n    Checks if a given number is an Armstrong number.\n    An Armstrong number is one whose sum of digits raised to the power of the number of digits equals the number itself.\n    \"\"\"\n    if number < 0:\n        return False\n\n    s_number = str(number)\n    num_digits = len(s_number)\n    armstrong_sum = 0\n\n    for digit_char in s_number:\n        digit = int(digit_char)\n        armstrong_sum += digit ** num_digits\n\n    return armstrong_sum == number"}
{"task_id": "Mbpp/599", "solution": "def sum_average(n):\n    \"\"\"\n    Calculates the sum and average of the first n natural numbers.\n    Raises ValueError if n is not a positive integer.\n    \"\"\"\n    if not isinstance(n, int) or n <= 0:\n        raise ValueError(\"n must be a positive integer.\")\n    \n    total_sum = n * (n + 1) // 2\n    average = total_sum / n\n    \n    return (total_sum, average)"}
{"task_id": "Mbpp/597", "solution": "def find_kth(arr1: list[int], arr2: list[int], k: int) -> int:\n    \"\"\"\n    Finds the k-th smallest element from two sorted arrays.\n    Uses a binary search approach to efficiently locate the k-th element without merging.\n    \"\"\"\n    m, n = len(arr1), len(arr2)\n\n    # Ensure arr1 is the shorter array to optimize binary search range\n    if m > n:\n        arr1, arr2 = arr2, arr1\n        m, n = n, m\n\n    # Define the binary search range for 'p1' (number of elements from arr1)\n    # p1 can range from max(0, k - n) to min(k, m)\n    low = max(0, k - n)\n    high = min(k, m)\n\n    while low <= high:\n        p1 = low + (high - low) // 2  # Number of elements taken from arr1\n        p2 = k - p1                   # Number of elements taken from arr2\n\n        # Get the four boundary elements for the partition\n        # L1: element immediately before p1-th element in arr1\n        # R1: p1-th element in arr1\n        # L2: element immediately before p2-th element in arr2\n        # R2: p2-th element in arr2\n        L1 = arr1[p1 - 1] if p1 > 0 else float('-inf')\n        R1 = arr1[p1] if p1 < m else float('inf')\n        L2 = arr2[p2 - 1] if p2 > 0 else float('-inf')\n        R2 = arr2[p2] if p2 < n else float('inf')\n\n        # Check if the partition is correct\n        if L1 <= R2 and L2 <= R1:\n            # We found the correct partition\n            # The k-th element is the maximum of the two elements before the split\n            return max(L1, L2)\n        elif L1 > R2:\n            # We took too many elements from arr1, adjust high to search left\n            high = p1 - 1\n        else:  # L2 > R1\n            # We took too few elements from arr1, adjust low to search right\n            low = p1 + 1\n\n    # This part should ideally not be reached if inputs are valid and k is within bounds.\n    # It might indicate an error or an impossible k.\n    return -1 # Or raise an error, but the prompt says not to raise exceptions for edge cases."}
{"task_id": "Mbpp/603", "solution": "from typing import List\ndef get_ludic(n: int) -> List[int]:\n    \"\"\"\n    Calculates all lucid numbers less than or equal to a given integer n.\n    Lucid numbers are defined as 1 and all prime numbers up to n.\n    \"\"\"\n    if n < 1:\n        return []\n    if n == 1:\n        return [1]\n\n    # Use Sieve of Eratosthenes to find prime numbers up to n.\n    is_prime = [True] * (n + 1)\n    is_prime[0] = False\n    is_prime[1] = False\n\n    for p in range(2, int(n**0.5) + 1):\n        if is_prime[p]:\n            for multiple in range(p * p, n + 1, p):\n                is_prime[multiple] = False\n\n    # Collect 1 and all prime numbers identified by the sieve.\n    lucid_numbers = [1]\n    for i in range(2, n + 1):\n        if is_prime[i]:\n            lucid_numbers.append(i)\n\n    return lucid_numbers"}
