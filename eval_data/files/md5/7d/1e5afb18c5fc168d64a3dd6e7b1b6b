{"task_id": "Mbpp/462", "solution": "from typing import List\ndef combinations_list(elements: List[str]) -> List[List[str]]:\n    \"\"\"\n    Finds all possible combinations of the elements of a given list.\n    New elements are prepended to existing combinations to form new ones.\n    \"\"\"\n    result: List[List[str]] = [[]]\n    for item in elements:\n        # For each existing combination, create a new one by prepending the current item.\n        new_combos: List[List[str]] = []\n        for existing_combo in result:\n            new_combos.append([item] + existing_combo)\n        result.extend(new_combos)\n    return result"}
{"task_id": "Mbpp/463", "solution": "def max_subarray_product(array: list[int]) -> int:\n    \"\"\"\n    Finds the maximum product of a contiguous subarray within the given array.\n    Handles negative numbers, zeros, and empty arrays efficiently in O(n) time and O(1) space.\n    \"\"\"\n    if not array:\n        return 0\n\n    max_ending_here = array[0]\n    min_ending_here = array[0]\n    max_so_far = array[0]\n\n    for i in range(1, len(array)):\n        num = array[i]\n        if num == 0:\n            max_ending_here = 0\n            min_ending_here = 0\n            max_so_far = max(max_so_far, 0)\n            continue\n\n        # Store the old max_ending_here before it gets updated\n        temp_max_ending_here = max_ending_here\n\n        max_ending_here = max(num, num * max_ending_here, num * min_ending_here)\n        min_ending_here = min(num, num * temp_max_ending_here, num * min_ending_here)\n\n        max_so_far = max(max_so_far, max_ending_here)\n\n    return max_so_far"}
{"task_id": "Mbpp/470", "solution": "def add_pairwise(input_tuple: tuple) -> tuple:\n    \"\"\"\n    Finds the pairwise addition of neighboring elements of the given tuple.\n    Returns an empty tuple if the input has fewer than two elements.\n    \"\"\"\n    if len(input_tuple) < 2:\n        return ()\n\n    pairwise_sums = [\n        input_tuple[i] + input_tuple[i+1]\n        for i in range(len(input_tuple) - 1)\n    ]\n\n    return tuple(pairwise_sums)"}
{"task_id": "Mbpp/478", "solution": "def remove_lowercase(s):\n    \"\"\"\n    Removes contiguous lowercase substrings from the input string.\n    Characters that are not lowercase or are not part of a lowercase sequence are retained.\n    \"\"\"\n    result = []\n    skipping_lowercase_block = False\n\n    for char in s:\n        if char.islower():\n            skipping_lowercase_block = True\n        else:\n            if skipping_lowercase_block:\n                skipping_lowercase_block = False\n            result.append(char)\n\n    return \"\".join(result)"}
{"task_id": "Mbpp/468", "solution": "def max_product(array):\n    \"\"\"\n    Finds the maximum product formed by multiplying numbers of an increasing subsequence.\n    \"\"\"\n    if not array:\n        return 0\n\n    n = len(array)\n    dp = [0] * n\n    max_prod = array[0] # Initialize with the first element's product\n\n    for i in range(n):\n        dp[i] = array[i] # A subsequence can consist of just one element\n        for j in range(i):\n            if array[j] < array[i]: # Check for increasing order\n                dp[i] = max(dp[i], dp[j] * array[i]) # Update max product ending at array[i]\n        max_prod = max(max_prod, dp[i]) # Update overall maximum product found so far\n\n    return max_prod"}
{"task_id": "Mbpp/475", "solution": "from typing import Dict, List, Tuple\ndef sort_counter(input_dict: Dict[str, int]) -> List[Tuple[str, int]]:\n    \"\"\"Sorts a dictionary by its integer values in descending order.\n    Returns a list of (key, value) tuples, preserving insertion order for equal values.\n    \"\"\"\n    sorted_items = sorted(input_dict.items(), key=lambda item: item[1], reverse=True)\n    return sorted_items"}
{"task_id": "Mbpp/479", "solution": "def first_Digit(number: int) -> int:\n    \"\"\"\n    Finds the first (most significant) digit of a given integer.\n    Handles negative numbers by considering their absolute value.\n    \"\"\"\n    number = abs(number)\n    if number == 0:\n        return 0\n    while number >= 10:\n        number //= 10\n    return number"}
{"task_id": "Mbpp/557", "solution": "def toggle_string(input_str: str) -> str:\n    \"\"\"Toggles the case of all alphabetic characters in a string, preserving non-alphabetic ones.\"\"\"\n    result = []\n    for ch in input_str:\n        if ch.isalpha():\n            result.append(ch.upper() if ch.islower() else ch.lower())\n        else:\n            result.append(ch)\n    return ''.join(result)"}
{"task_id": "Mbpp/555", "solution": "def difference(n: int) -> int:\n    \"\"\"\n    Calculates the difference between the sum of cubes of the first n natural numbers\n    and the sum of the first n natural numbers using closed-form formulas.\n    \"\"\"\n    sum_of_numbers = n * (n + 1) // 2\n    sum_of_cubes = sum_of_numbers * sum_of_numbers\n    return sum_of_cubes - sum_of_numbers"}
{"task_id": "Mbpp/558", "solution": "class Number:\n    \"\"\"A value object to represent an integer and provide its digits.\"\"\"\n    def __init__(self, value: int):\n        self.value = abs(value)\n        self._digits = self._extract_digits()\n\n    def _extract_digits(self) -> list[int]:\n        \"\"\"Extracts digits from the number, storing them least-significant first.\"\"\"\n        if self.value == 0:\n            return [0]\n        digits = []\n        temp_value = self.value\n        while temp_value > 0:\n            digits.append(temp_value % 10)\n            temp_value //= 10\n        return digits\n\n    def getDigits(self) -> list[int]:\n        \"\"\"Returns the list of digits in reverse order (least-significant first).\"\"\"\n        return self._digits\nclass DigitDistanceCalculator:\n    \"\"\"Calculates the sum of per-digit absolute differences between two numbers.\"\"\"\n    def compute(self, a: int, b: int) -> int:\n        \"\"\"Computes the sum of per-digit absolute differences.\"\"\"\n        num_a = Number(a)\n        num_b = Number(b)\n\n        digits_a = num_a.getDigits()\n        digits_b = num_b.getDigits()\n\n        max_len = max(len(digits_a), len(digits_b))\n        total_diff = 0\n\n        for i in range(max_len):\n            digit_a = digits_a[i] if i < len(digits_a) else 0\n            digit_b = digits_b[i] if i < len(digits_b) else 0\n            total_diff += abs(digit_a - digit_b)\n        return total_diff\ndef digit_distance_nums(a: int, b: int) -> int:\n    \"\"\"\n    Finds the sum of the per-digit difference between two integers.\n    This function acts as a public interface wrapper around DigitDistanceCalculator.\n    \"\"\"\n    calculator = DigitDistanceCalculator()\n    return calculator.compute(a, b)"}
{"task_id": "Mbpp/562", "solution": "import collections\ndef Find_Max_Length(list_of_lists):\n    \"\"\"\n    Finds the length of the longest sublist in a list of lists.\n    Returns 0 if the input list is empty or contains only empty sublists.\n    \"\"\"\n    max_len = 0\n    for sublist in list_of_lists:\n        if len(sublist) > max_len:\n            max_len = len(sublist)\n    return max_len"}
{"task_id": "Mbpp/559", "solution": "def max_sub_array_sum(list_param, length):\n    \"\"\"\n    Finds the sum of the largest contiguous sublist in the given list using Kadane's algorithm.\n    Returns 0 if the list is empty.\n    \"\"\"\n    if length == 0:\n        return 0\n\n    max_so_far = list_param[0]\n    current_max = list_param[0]\n\n    for i in range(1, length):\n        current_max = max(list_param[i], current_max + list_param[i])\n        max_so_far = max(max_so_far, current_max)\n\n    return max_so_far"}
{"task_id": "Mbpp/560", "solution": "def union_elements(tuple1: tuple[int], tuple2: tuple[int]) -> tuple[int]:\n    \"\"\"\n    Finds the union of elements from two tuples and returns them in a new sorted tuple.\n    \"\"\"\n    combined_elements = set(tuple1)\n    combined_elements.update(tuple2)\n    sorted_elements = sorted(list(combined_elements))\n    return tuple(sorted_elements)"}
{"task_id": "Mbpp/563", "solution": "def extract_values(s: str) -> list[str]:\n    \"\"\"Extract all substrings enclosed in double quotes from a string.\"\"\"\n    results: list[str] = []\n    i = 0\n    n = len(s)\n    while i < n:\n        if s[i] == '\"':\n            i += 1  # Move past the opening quote\n            start = i\n            # Find the closing quote or end of string\n            while i < n and s[i] != '\"':\n                i += 1\n            if i < n:  # A closing quote was found\n                results.append(s[start:i])\n            i += 1  # Move past the closing quote or current position\n        else:\n            i += 1  # Move to the next character\n    return results"}
{"task_id": "Mbpp/566", "solution": "def sum_digits(n: int) -> int:\n    \"\"\"\n    Calculates the sum of the digits of a non-negative integer.\n    \"\"\"\n    total = 0\n    temp = n\n    while temp > 0:\n        total += temp % 10\n        temp //= 10\n    return total"}
