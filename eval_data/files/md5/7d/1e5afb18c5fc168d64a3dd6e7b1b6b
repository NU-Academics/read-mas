{"task_id": "Mbpp/92", "solution": "def is_undulating(number: int) -> bool:\n    \"\"\"\n    Checks if a number is undulating, meaning its digits alternate between increasing and decreasing.\n    Single-digit numbers are considered undulating.\n    \"\"\"\n    s = str(number)\n    n = len(s)\n\n    # Business rule 3: Single-digit numbers are considered undulating by default.\n    if n <= 1:\n        return True\n\n    # Algorithm highlight 4: Iterate over adjacent digit pairs.\n    # Determine the initial direction (increasing or decreasing) between the first two digits.\n    prev_diff_positive = None\n    if s[0] < s[1]:\n        prev_diff_positive = True\n    elif s[0] > s[1]:\n        prev_diff_positive = False\n    else: # s[0] == s[1]\n        return False # Digits are equal, cannot be undulating\n\n    # Check remaining pairs for alternating difference signs.\n    for i in range(1, n - 1):\n        digit1 = int(s[i])\n        digit2 = int(s[i+1])\n\n        if digit1 == digit2:\n            return False # Digits are equal, cannot be undulating\n\n        current_diff_positive = (digit1 < digit2)\n\n        # Business rule 2: For every adjacent pair of digits, the difference alternates sign.\n        if current_diff_positive == prev_diff_positive:\n            return False\n        \n        prev_diff_positive = current_diff_positive\n\n    return True"}
{"task_id": "Mbpp/94", "solution": "import math\ndef index_minimum(tuples):\n    \"\"\"\n    Given a list of tuples, returns the first value of the tuple with the smallest second value.\n    Assumes input list is non-empty and tuples are well-formed.\n    \"\"\"\n    min_tuple = None\n    min_second_value = math.inf\n\n    for tpl in tuples:\n        current_second_value = tpl[1]\n        if current_second_value < min_second_value:\n            min_second_value = current_second_value\n            min_tuple = tpl\n    \n    return min_tuple[0]"}
{"task_id": "Mbpp/95", "solution": "from typing import Iterable, Any\ndef Find_Min_Length(input_list: Iterable[Iterable[Any]]) -> int:\n    \"\"\"\n    Calculates the length of the smallest list within a list of lists.\n    It returns 0 for an empty input and raises TypeError for non-iterable elements.\n    \"\"\"\n    try:\n        iterator = iter(input_list)\n    except TypeError as e:\n        raise TypeError(f\"Input must be an iterable of iterables, got {type(input_list).__name__}\") from e\n\n    min_length = None\n    for idx, sub in enumerate(iterator):\n        if not hasattr(sub, \"__iter__\"):\n            raise TypeError(f\"Element at index {idx} is not iterable: {sub!r}\")\n        length = len(sub)\n        if min_length is None or length < min_length:\n            min_length = length\n\n    return min_length if min_length is not None else 0"}
{"task_id": "Mbpp/96", "solution": "def divisor(n: int) -> int:\n    \"\"\"Return the number of positive divisors of n. This function efficiently counts divisors up to the square root of n.\"\"\"\n    count = 0\n    sqrt_n = int(n ** 0.5)\n    for i in range(1, sqrt_n + 1):\n        if n % i == 0:\n            count += 2  # Each factor i has a corresponding factor n//i\n    if sqrt_n * sqrt_n == n:\n        count -= 1  # Correct for perfect squares where sqrt_n is counted twice\n\n    return count"}
