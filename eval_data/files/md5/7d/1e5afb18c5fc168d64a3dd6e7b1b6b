{"task_id": "Mbpp/286", "solution": "class SubarraySumCalculator:\n    \"\"\"\n    Domain service that implements the core algorithm.\n    \"\"\"\n\n    def compute_max_subarray_sum(self, array: list[int], k: int) -> int:\n        max_kadane = self._kadane(array)\n        max_prefix = self._max_prefix(array)\n        max_suffix = self._max_suffix(array)\n        total_sum = sum(array)\n\n        if k == 1:\n            return max_kadane\n\n        if total_sum > 0:\n            # The maximum subarray can span multiple copies when total_sum is positive.\n            return max(\n                max_kadane,\n                max_suffix + max_prefix + (k - 2) * total_sum\n            )\n        else:\n            # If total_sum is not positive, the maximum subarray is confined to at most two copies.\n            return max(max_kadane, max_suffix + max_prefix)\n\n    @staticmethod\n    def _kadane(arr: list[int]) -> int:\n        \"\"\"Calculates the maximum subarray sum using Kadane's algorithm.\"\"\"\n        max_ending_here = max_so_far = arr[0]\n        for x in arr[1:]:\n            max_ending_here = max(x, max_ending_here + x)\n            max_so_far = max(max_so_far, max_ending_here)\n        return max_so_far\n\n    @staticmethod\n    def _max_prefix(arr: list[int]) -> int:\n        \"\"\"Calculates the maximum prefix sum of the array.\"\"\"\n        max_prefix = cur = arr[0]\n        for x in arr[1:]:\n            cur += x\n            max_prefix = max(max_prefix, cur)\n        return max_prefix\n\n    @staticmethod\n    def _max_suffix(arr: list[int]) -> int:\n        \"\"\"Calculates the maximum suffix sum of the array.\"\"\"\n        max_suffix = cur = arr[-1]\n        for x in reversed(arr[:-1]):\n            cur += x\n            max_suffix = max(max_suffix, cur)\n        return max_suffix\ndef max_sub_array_sum_repeated(array: list[int], k: int) -> int:\n    \"\"\"\n    Finds the largest sum of a contiguous array in the modified array formed by repeating the given array k times.\n    Public API that delegates to SubarraySumCalculator.\n    \"\"\"\n    calculator = SubarraySumCalculator()\n    return calculator.compute_max_subarray_sum(array, k)"}
{"task_id": "Mbpp/290", "solution": "from typing import List, Any, Tuple\ndef max_length(list_of_lists: List[List[Any]]) -> Tuple[int, List[Any]]:\n    \"\"\"\n    Finds the length of the longest sub-list and the first sub-list that\n    achieves that length in a list of lists.\n    \"\"\"\n    max_len = -1\n    max_sublist: List[Any] = []\n\n    for sublist in list_of_lists:\n        current_len = len(sublist)\n        if current_len > max_len:\n            max_len = current_len\n            max_sublist = sublist\n\n    # Handle the case where the input list_of_lists was empty\n    if max_len == -1:\n        max_len = 0\n        max_sublist = []\n\n    return max_len, max_sublist"}
