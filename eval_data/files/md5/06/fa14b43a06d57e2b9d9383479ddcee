l/118": [{"task_id": "HumanEval/118", "solution": "def get_closest_vowel(word):\n    \"\"\"Finds the closest vowel that stands between two consonants from the right side of the word.\n    Returns an empty string if no such vowel is found.\n    \"\"\"\n    VOWELS = {\"a\", \"e\", \"i\", \"o\", \"u\", \"A\", \"E\", \"I\", \"O\", \"U\"}\n    MIN_WORD_LEN = 3\n\n    def is_vowel(char):\n        return char in VOWELS\n\n    def is_consonant(char):\n        return char.isalpha() and char not in VOWELS\n\n    if len(word) < MIN_WORD_LEN:\n        return \"\"\n\n    # Iterate from right to left, excluding the first and last characters (indices 0 and len-1)\n    # The loop range for `i` goes from `len(word) - 2` down to `1`.\n    # This means `i` can be `len(word) - 2`, `len(word) - 3`, ..., `1`.\n    # For `word[i-1]` and `word[i+1]` to be valid:\n    # `i-1` must be at least 0. Smallest `i` is 1, so `i-1` is 0, which is valid.\n    # `i+1` must be less than `len(word)`. Largest `i` is `len(word) - 2`, so `i+1` is `len(word) - 1`, which is valid.\n    for i in range(len(word) - 2, 0, -1):\n        char = word[i]\n        if is_vowel(char):\n            left_char = word[i - 1]\n            right_char = word[i + 1]\n            if is_consonant(left_char) and is_consonant(right_char):\n                return char\n    return \"\"", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/118", "solution": "def get_closest_vowel(word):\n    \"\"\"Finds the closest vowel that stands between two consonants from the right side of the word.\n    Returns the vowel as a string, or an empty string if no such vowel is found.\n    \"\"\"\n    VOWELS = {\"a\", \"e\", \"i\", \"o\", \"u\", \"A\", \"E\", \"I\", \"O\", \"U\"}\n\n    def is_vowel(char):\n        return char in VOWELS\n\n    def is_consonant(char):\n        return char.isalpha() and char not in VOWELS\n\n    n = len(word)\n    # The problem specifies \"vowels in the beginning and ending doesn't count\",\n    # meaning we only consider characters at index i where 0 < i < n - 1.\n    # We scan from right to left, so the loop goes from n-2 down to 1.\n    for i in range(n - 2, 0, -1):\n        char = word[i]\n        if is_vowel(char):\n            left_neighbor = word[i - 1]\n            right_neighbor = word[i + 1]\n            if is_consonant(left_neighbor) and is_consonant(right_neighbor):\n                return char\n    return \"\"", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/117": [{"task_id": "HumanEval/117", "solution": "def select_words(s, n):\n    \"\"\"Returns a list of words from string s that contain exactly n consonants.\n\n    The words are returned in the order they appear in s, and 'a', 'e', 'i', 'o', 'u'\n    are considered vowels (case-insensitive); all other letters are consonants.\n    \"\"\"\n    VOWELS = {\"a\", \"e\", \"i\", \"o\", \"u\"}\n\n    def _count_consonants_in_word(word_text):\n        \"\"\"Counts consonants in a single word.\"\"\"\n        lower_word = word_text.lower()\n        count = 0\n        for char in lower_word:\n            if char.isalpha() and char not in VOWELS:\n                count += 1\n        return count\n\n    if not s:\n        return []\n\n    words_from_s = s.split()\n    result = []\n    for word in words_from_s:\n        if _count_consonants_in_word(word) == n:\n            result.append(word)\n            \n    return result", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/117", "solution": "VOWELS = {'a', 'e', 'i', 'o', 'u'}\ndef select_words(s, n):\n    \"\"\"Returns a list of words from string s that contain exactly n consonants.\"\"\"\n    \n    # Split the string into words, handling multiple spaces and stripping\n    # This also naturally handles an empty string s resulting in an empty list of words\n    words = [word for word in s.st