durations.\"\"\"\n        result: List[int] = []\n        for i, t in enumerate(tokens):\n            if t not in self.token_map:\n                raise InvalidNoteError(t, f\"Unknown token at position {i}: {t}\")\n            result.append(self.token_map[t])\n        return result\n\n    def parse_music_string(self, music_string: str) -> List[int]:\n        \"\"\"Tokenizes the input string and then parses the tokens into beat durations.\"\"\"\n        try:\n            tokens = self._tokenizer.tokenize(music_string)\n            return self.parse_tokens(tokens)\n        except InvalidNoteError:\n            raise\n        except Exception as ex:\n            raise ParseError(f\"Failed to parse music string: {ex}\")\ndef parse_music(music_string: str) -> List[int]:\n    \"\"\"Parses a musical note string into a list of beat durations.\"\"\"\n    parser = Parser()\n    return parser.parse_music_string(music_string)", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/17", "solution": "import re\nfrom typing import List\ndef parse_music(music_string: str) -> List[int]:\n    \"\"\"\n    Parses a string representing musical notes in a special ASCII format\n    and returns a list of integers corresponding to beat durations.\n    \"\"\"\n\n    class MusicParseError(Exception):\n        \"\"\"Custom exception for music parsing errors.\"\"\"\n        pass\n\n    TOKEN_BEATS = {\"o\": 4, \"o|\": 2, \".|\": 1}\n\n    class Note:\n        \"\"\"Represents a musical token mapped to a beat count.\"\"\"\n        def __init__(self, token: str, beats: int) -> None:\n            self.token = token\n            self.beats = beats\n\n    class Tokenizer:\n        \"\"\"Tokenizes input string into a list of note tokens.\"\"\"\n        def tokenize(self, music: str) -> List[str]:\n            \"\"\"Splits the music string into tokens by whitespace, stripping empty results.\"\"\"\n            parts = music.strip().split()\n            return [p for p in parts if p]\n\n    class InputValidator:\n        \"\"\"Validates raw music string characters and token forms.\"\"\"\n        # Regex to allow 'o', '.', '|', and whitespace. Escaped '.' and '|' for literal match.\n        ALLOWED_PATTERN = re.compile(r'^[o\\.\\s\\|]+$')\n        SUPPORTED_TOKENS = [\"o\", \"o|\", \".|\"]\n\n        def validate(self, music: str) -> None:\n            \"\"\"Validates characters and tokens; raises MusicParseError if invalid.\"\"\"\n            self._validate_characters(music)\n            \n            # Simple tokenization for validation purposes.\n            temp_tokens = [p for p in music.strip().split() if p]\n            self._validate_tokens(temp_tokens)\n\n        def _validate_characters(self, music: str) -> None:\n            \"\"\"Ensures only allowed characters (o, ., |, whitespace).\"\"\"\n            if not self.ALLOWED_PATTERN.match(music):\n                raise MusicParseError(\"Input contains illegal characters. Only 'o', '.', '|', and whitespace are allowed.\")\n\n        def _validate_tokens(self, tokens: List[str]) -> None:\n            \"\"\"Ensures tokens belong to SUPPORTED_TOKENS.\"\"\"\n            for token in tokens:\n                if token not in self.SUPPORTED_TOKENS:\n                    raise MusicParseError(f\"Unsupported musical token found: '{token}'\")\n\n    class ParserService:\n        \"\"\"Orchestrates validation, tokenization, and mapping to beats.\"\"\"\n        def __init__(self, validator: 'InputValidator', tokenizer: 'Tokenizer') -> None:\n            self.validator = validator\n            self.tokenizer = tokenizer\n\n        def parse(self, music: str, persist: bool = False) -> List[int]:\n            \"\"\"\n            Parses a music string into a list of beat durations.\n            Validates input, tokenizes, and maps tokens to beat values.\n            \"\"\"\n            if not music.strip():\n                return []\n\n            self.validator.validate(music)\n            \n            tokens = self.tokenizer.tokenize(music)\n            \n            notes = self._map_tokens_to_notes(tokens)\n            beats = [n.beats for n in notes]\n            \n            return beats\n\n        def _map_tokens_to_notes(self, tokens: List[str]) -> List['Note']:\n            \"\"\"Maps token strings to Note objects using the TOKEN_BEATS legend.\"\"\"\n            notes = []\n            for token in tokens:\n                beats = TOKEN_BEATS[token]\n                notes.append(Note(token, beats))\n            return notes\n\n    # Instantiate components as per the design context for the default parser.\n    validator = InputValidator()\n    tokenizer = Tokenizer()\n    parser_service = ParserService(validator, tokenizer)\n\n    # Call the service method, with persist=False as specified for the public function.\n    return parser_service.parse(music_string, persist=False)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/16": [{"task_id": "HumanEval/16", "solution": "def count_distinct_characters(string: str) -> int:\n    \"\"\" Given a string, find out how many distinct characters (regardless of case) does it consist of\n    >>> count_distinct_characters('xyzXYZ')\n    3\n    >>> count_distinct_characters('Jerry')\n    4\n    \"\"\"\n    normalized_string = string.casefold()\n    return len(set(normalized_string))", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/16", "solution": "def count_distinct_characters(string: str) -> int:\n    \"\"\" Given a string, find out how many distinct characters (regardless of case) does it consist of\n    >>> count_distinct_characters('xyzXYZ')\n    3\n    >>> count_distinct_characters('Jerry')\n    4\n    \"\"\"\n    normalized_string = string.casefold()\n    return len(set(normalized_string))", "base_status": "pass", "plus_status": "pass", "base_fail_