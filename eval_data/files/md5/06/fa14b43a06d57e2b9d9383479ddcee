sing or non_increasing", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/57", "solution": "def monotonic(l: list):\n    \"\"\"Return True if list elements are monotonically increasing or decreasing.\"\"\"\n    if not l or len(l) < 2:\n        return True\n\n    increasing = True\n    decreasing = True\n\n    for i in range(1, len(l)):\n        if l[i] > l[i-1]:\n            decreasing = False\n        elif l[i] < l[i-1]:\n            increasing = False\n\n        if not increasing and not decreasing:\n            return False\n\n    return True", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/59": [{"task_id": "HumanEval/59", "solution": "import math\ndef largest_prime_factor(n: int):\n    \"\"\"Return the largest prime factor of n. Assume n > 1 and is not a prime.\n    The algorithm uses trial division, optimizing by first dividing out factors of 2\n    and then odd numbers up to the square root of n.\n    \"\"\"\n    largest_factor = 1\n\n    # Divide by 2 until n is odd\n    while n % 2 == 0:\n        largest_factor = 2\n        n //= 2\n\n    # Check for odd factors from 3 up to sqrt(n)\n    f = 3\n    # Recalculate limit inside the loop if n changes significantly\n    limit = int(math.isqrt(n)) + 1\n    while f <= limit and n > 1:\n        while n % f == 0:\n            largest_factor = f\n            n //= f\n            limit = int(math.isqrt(n)) + 1 # Re-evaluate limit after division\n        f += 2 # Move to the next odd number\n\n    # If n is still greater than 1, it must be a prime factor larger than any found so far\n    if n > 1:\n        largest_factor = n\n\n    return largest_factor", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/59", "solution": "def largest_prime_factor(n: int):\n    \"\"\"Return the largest prime factor of n. Assume n > 1.\n    >>> large