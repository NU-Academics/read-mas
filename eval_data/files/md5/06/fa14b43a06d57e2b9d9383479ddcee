Optional, Dict, Tuple\nfrom dataclasses import dataclass\nimport os\nimport time\nimport json\nimport sqlite3\nfrom collections import OrderedDict\ndef all_prefixes(string: str) -> List[str]:\n    \"\"\"Return list of all prefixes from shortest to longest of the input string.\"\"\"\n\n    # All necessary classes are defined inline to adhere to the \"no helper not defined inline\" constraint.\n\n    class InvalidInputError(Exception):\n        def __init__(self, message: str, status_code: int = 400) -> None:\n            super().__init__(message)\n            self.message = message\n            self.status_code = status_code\n\n    @dataclass(frozen=True)\n    class Config:\n        max_input_length: int = 10000\n        allow_empty: bool = False\n        cache_ttl_seconds: int = 3600\n        sqlite_path: Optional[str] = None\n        api_key: Optional[str] = None\n\n        @classmethod\n        def from_env(cls) -> \"Config\":\n            return cls(\n                max_input_length=int(os.getenv(\"STRPREFIX_MAX_LEN\", \"10000\")),\n                allow_empty=os.getenv(\"STRPREFIX_ALLOW_EMPTY\", \"false\").lower() == \"true\",\n                cache_ttl_seconds=int(os.getenv(\"STRPREFIX_CACHE_TTL\", \"3600\")),\n                sqlite_path=os.getenv(\"STRPREFIX_SQLITE_PATH\"),\n                api_key=os.getenv(\"STRPREFIX_API_KEY\"),\n            )\n\n    class PrefixDTO:\n        def __init__(self, prefixes: List[str]) -> None:\n            self.prefixes = prefixes\n\n        def to_dict(self) -> Dict[str, List[str]]:\n            return {\"prefixes\": self.prefixes}\n\n    class Validator:\n        def validate_string(self, value: str, config: Config) -> None:\n            # Per prompt constraints: \"Do NOT add isinstance() checks or raise exceptions for edge cases\".\n            # This method acts as a no-op in this context, deviating from the full design's error handling.\n            pass\n\n    class PrefixCacheRepository:\n        def __init__(self, config: Config, max_size: int = 10000) -> None:\n            self._cache: \"OrderedDict[str, Tuple[List[str], float]]\" = OrderedDict()\n            self._max_size = max_size\n            self._ttl_seconds = config.cache_ttl_seconds\n            self._sqlite_path = config.sqlite_path\n            if self._sqlite_path:\n                self._ensure_table()\n\n        def _ensure_table(self) -> None:\n            if not self._sqlite_path:\n                return\n            try:\n                conn = sqlite3.connect(self._sqlite_path)\n                conn.execute(\n                    \"CREATE TABLE IF NOT EXISTS prefix_cache (input TEXT PRIMARY KEY, result TEXT, created_at REAL)\"\n                )\n                conn.commit()\n                conn.close()\n            except Exception:\n                # Fail-safe as per design for cache failures without raising.\n                pass\n\n        def get(self, input_str: str) -> Optional[List[str]]:\n            now = time.time()\n            item = self._cache.get(input_str)\n            if item:\n                prefixes, ts = item\n                if now - ts <= self._ttl_seconds:\n                    self._cache.move_to_end(input_str)\n                    return prefixes\n                else:\n                    del self._cache[input_str]\n            if self._sqlite_path:\n                try:\n                    return self._load_sqlite(input_str)\n                except Exception:\n                    pass\n            return None\n\n        def set(self, input_str: str, prefixes: List[str]) -> None:\n            now = time.time()\n            self._cache[input_str] = (prefixes, now)\n            self._cache.move_to_end(input_str)\n            if len(self._cache) > self._max_size:\n                self._cache.popitem(last=False)\n            if self._sqlite_path:\n                try:\n                    self._persist_sqlite(input_str, prefixes)\n                except Exception:\n                    pass\n\n        def _persist_sqlite(self, input_str: str, prefixes: List[str]) -> None:\n            if not self._sqlite_path:\n                return\n            conn = sqlite3.connect(self._sqlite_path)\n            conn.execute(\n                \"REPLACE INTO prefix_cache(input, result, created_at) VALUES(?,?,?)\",\n                (input_str, json.dumps(prefixes), time.time()),\n            )\n            conn.commit()\n            conn.close()\n\n        def _load_sqlite(self, input_str: str) -> Optional[List[str]]:\n            if not self._sqlite_path:\n                return None\n            conn = sqlite3.connect(self._sqlite_path)\n            cur = conn.execute(\"SELECT result, created_at FROM prefix_cache WHERE input = ?\", (input_str,))\n            row = cur.fetchone()\n            conn.close()\n            if not row:\n                return None\n            result_json, created_at = row\n            if time.time() - float(created_at) > self._ttl_seconds:\n                return None\n            return json.loads(result_json)\n\n    class StringService:\n        def __init__(self, repo: PrefixCacheRepository, config: Config, validator: Validator) -> None:\n            self._repo = repo\n            self._config = config\n            self._validator = validator\n\n        def compute_prefixes(self, string: str) -> PrefixDTO:\n            self._validator.validate_string(string, self._config)\n            \n            cached = self._repo.get(string)\n            if cached is not None:\n                return PrefixDTO(cached)\n            \n            prefixes: List[str] = [string[:i] for i in range(1, len(string) + 1)]\n            self._repo.set(string, prefixes)\n            return PrefixDTO(prefixes)\n\n    class Application:\n        def __init__(self, config: Config, service: StringService) -> None:\n            self.config = config\n            self.service = service\n\n        @classmethod\n        def create_with_defaults(cls) -> \"Application\":\n            cfg = Config.from_env()\n            repo = PrefixCacheRepository(cfg)\n            validator = Validator()\n            svc = StringService(repo, cfg, validator)\n            return cls(cfg, svc)\n\n    # Delegate the actual computation to the StringService through the Application factory.\n    app = Application.create_with_defaults()\n    dto = app.service.compute_prefixes(string)\n    return dto.prefixes", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/13": [{"task_id": "HumanEval/13", "solution": "def greatest_common_divisor(a: int, b: int) -> int:\n    \"\"\" Return a greatest common divisor of two integers a and b using the Euclidean algorithm.\n    The result is always non-negative; gcd(0,0) returns 0.\n    \"\"\"\n    a, b = abs(a), abs(b)\n    if a == 0 and b == 0:\n        return 0\n    while b:\n        a, b = b, a % b\n    return a", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/13", "solution": "def greatest_common_divisor(a: int, b: int) -> int:\n    \"\"\" Return a greatest common divisor of two integers a and b\n    >>> greatest_common_divisor(3, 5)\n    1\n    >>> greatest_common_divisor(25, 15)\n    5\n    \"\"\"\n    # Use the Euclidean algorithm to find the GCD of absolute values.\n    # Handles negative numbers and zero correctly based on design conventions.\n    a, b = abs(a), abs(b)\n    while b:\n        a, b = b, a % b\n    return a", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/18": [{"task_id": "HumanEval/18", "solution": "                # To count overlapping occurrences, reset j to lps[j-1]\n                # instead of j=0. This allows the search to continue\n                # from the next possible overlapping start.", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "Human