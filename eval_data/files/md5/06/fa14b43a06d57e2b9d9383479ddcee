ge)\n            self.component = component\n            self.value = value\n\n    _DATE_RE = re.compile(r'^\\s*(\\d{1,2})-(\\d{1,2})-(\\d{4})\\s*$')\n\n    class DateParser:\n        def parse(self, date_str) -> DateParts:\n            # Rule 1: The date string is not empty.\n            if not date_str or (isinstance(date_str, str) and date_str.strip() == \"\"):\n                raise EmptyDateError(\"Date string is empty.\")\n            \n            # Rule 4: The date should be in the format: mm-dd-yyyy\n            m = _DATE_RE.match(date_str)\n            if not m:\n                raise InvalidFormatError(\"Date must be in mm-dd-yyyy format using '-' separators.\")\n            \n            # Extract and convert components. Regex ensures these are valid integers.\n            month = safe_int(m.group(1))\n            day = safe_int(m.group(2))\n            year = safe_int(m.group(3))\n            \n            return DateParts(month=month, day=day, year=year)\n\n    class DateRules:\n        _MONTH_31 = {1,3,5,7,8,10,12}\n        _MONTH_30 = {4,6,9,11}\n        FEBRUARY = 2 # Max 29 days for February, per requirement 2.\n\n        def is_valid_month(self, month: int) -> bool:\n            # Rule 3: Months should not be less than 1 or higher than 12.\n            return 1 <= month <= 12\n\n        def get_max_days_for_month(self, month: int) -> int:\n            if month in self._MONTH_31:\n                return 31\n            if month in self._MONTH_30:\n                return 30\n            if month == self.FEBRUARY:\n                return 29\n            # If month is not valid, raise an internal error.\n            raise InvalidComponentError(\"month\", month, f\"Invalid month: {month}\")\n\n        def is_valid_day_for_month(self, month: int, day: int) -> bool:\n            # Rule 2: Day ranges based on month.\n            if not (1 <= day):\n                return False\n            try:\n                max_d = self.get_max_days_for_month(month)\n