         return 1\n        if k_val == 3:\n            return (n_val * (n_val - 1) * (n_val - 2)) // 6\n        # Other k_val cases are not relevant for this problem, return 0.\n        return 0\n\n    def get_index_mod_counts(n_val: int) -> tuple[int, int, int]:\n        \"\"\"\n        Returns counts of indices i in 1..n_val where i % 3 is 1, 2, or 0 respectively.\n        (count for i%3==1, count for i%3==2, count for i%3==0)\n        \"\"\"\n        base = n_val // 3\n        rem = n_val % 3\n        count1 = base + (1 if rem >= 1 else 0)\n        count2 = base + (1 if rem >= 2 else 0)\n        count0 = base\n        return (count1, count2, count0)\n\n    # Analyze a[i] = i*i - i + 1 modulo 3:\n    # If i % 3 == 0: a[i] = 0*0 - 0 + 1 = 1 (mod 3)\n    # If i % 3 == 1: a[i] = 1*1 - 1 + 1 = 1 (mod 3)\n    # If i % 3 == 2: a[i] = 2*2 - 2 + 1 = 4 - 2 + 1 = 3 = 0 (mod 3)\n\n    # So, a[i] % 3 is 0 if i % 3 == 2\n    # And a[i] % 3 is 1 if i % 3 == 0 or i % 3 == 1\n\n    mod1_indices, mod2_indices, mod0_indices = get_index_mod_counts(n)\n\n    # Count how many a[i] values are 0 (mod 3) and 1 (mod 3)\n    count_a_mod_0 = mod2_indices\n    count_a_mod_1 = mod0_indices + mod1_indices\n\n    # For a[i] + a[j] + a[k] to be a multiple of 3 (i.e., sum to 0 mod 3),\n    # all three a values must be 0 (mod 3), OR all three must be 1 (mod 3).\n    # (0+0+0 = 0; 1+1+1 = 3 = 0; other combinations like 0+0+1, 0+1+1 do not sum to 0 mod 3)\n\n    # Number of triples where all a values are 0 (mod 3)\n    triples_0_mod_3 = comb(count_a_mod_0, 3)\n\n    # Number of triples where all a values are 1 (mod 3)\n    triples_1_mod_3 = comb(count_a_mod_1, 3)\n\n    return triples_0_mod_3 + triples_1_mod_3", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/147", "solution": "def get_max_triples(n):\n    \"\"\"\n    Calculates the number of triples (a[i], a[j], a[k]) such that i < j < k\n    and a[i] + a[j] + a[k] is a multiple of 3, where a[i] = i*i - i + 1.\n    \"\"\"\n    def comb(n_val, k_val):\n        \"\"\"Computes n_val choose k_val for k_val up to 3.\"\"\"\n        if n_val < k_val or k_val < 0:\n            return 0\n        if k_val == 0:\n            return 1\n        if k_val == 1:\n            return n_val\n        if k_val == 2:\n            return n_val * (n_val - 1) // 2\n        if k_val == 3:\n            return n_val * (n_val - 1) * (n_val - 2) // 6\n        return 0 # for k_val > 3, not needed by problem\n\n    # Analyze a[i] = i*i - i + 1 modulo 3:\n    # i % 3 == 1  => a[i] % 3 == (1*1 - 1 + 1) % 3 == 1\n    # i % 3 == 2  => a[i] % 3 == (2*2 - 2 + 1) % 3 == (4 - 2 + 1) % 3 == 3 % 3 == 0\n    # i % 3 == 0  => a[i] % 3 == (0*0 - 0 + 1) % 3 == 1\n    # So, a[i] % 3 is 0 if i % 3 == 2, and 1 if i % 3 == 0 or i % 3 == 1.\n    # The residue 2 never occurs.\n\n    # Triples (a[i], a[j], a[k]) sum to a multiple of 3 if:\n    # (a[i]%3 + a[j]%3 + a[k]%3) % 3 == 0\n    # Given residues are only 0 or 1, this means:\n    # 1. Three elements with residue 0: (0, 0, 0)\n    # 2. Three elements with residue 1: (1, 1, 1)\n\n    # Count elements with residue 0 (cnt0) and residue 1 (cnt1)\n    # cnt0: number of i in 1..n such that i % 3 == 2\n    cnt0 = n // 3 + (1 if n % 3 == 2 else 0)\n    \n    # cnt1: number of i in 1..n such that i % 3 == 0 or i % 3 == 1\n    cnt1 = n - cnt0\n\n    # The total number of valid triples is C(cnt0, 3) + C(cnt1, 3)\n    return comb(cnt0, 3) + comb(cnt1, 3)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/148": [{"task_id": "HumanEval/148", "solution": "def bf(planet1, planet2):\n    planets = [\"Mercury\", \"Venus\", \"Earth\", \"Mars\", \"Jupiter\", \"Saturn\", \"Uranus\", \"Neptune\"]\n\n    # Normalize planet names and find their indices in the ordered list.\n    normalized_p1 = planet1.strip().capitalize()\n    normalized_p2 = planet2.strip().capitalize()\n\n    try:\n        idx1 = planets.i