j: ClassName, extensions_list: list) -> str:\n            \"\"\"Iterates extensions to find the one with maximum strength, favoring earlier ones on tie.\"\"\"\n            max_strength = float('-inf')\n            strongest_extension_name = \"\"\n\n            for ext in extensions_list:\n                current_strength = self.compute_strength(ext)\n                if current_strength > max_strength:\n                    max_strength = current_strength\n                    strongest_extension_name = ext.name\n            \n            return f\"{class_name_obj.name}.{strongest_extension_name}\"\n\n    cls = ClassName(class_name)\n    exts = [Extension(e) for e in extensions]\n    service = ExtensionService()\n    return service.find_strongest(cls, exts)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/153", "solution": "def Strongest_Extension(class_name, extensions):\n    \"\"\"Finds the strongest extension for a class based on uppercase and lowercase letter counts.\n    Returns the class name concatenated with the strongest extension name.\n    \"\"\"\n    if not extensions:\n        return f\"{class_name}.\"\n\n    strongest_extension_name = \"\"\n    max_strength = float('-inf')\n\n    for ext_name in extensions:\n        cap_count = 0\n        sm_count = 0\n        for char in ext_name:\n            if char.isupper():\n                cap_count += 1\n            elif char.islower():\n                sm_count += 1\n        \n        current_strength = cap_count - sm_count\n\n        if current_strength > max_strength:\n            max_strength = current_strength\n            strongest_extension_name = ext_name\n    \n    return f\"{class_name}.{strongest_extension_name}\"", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/154": [{"task_id": "HumanEval/154", "solution": "def cycpattern_check(a , b):\n    \"\"\"\n    Checks if the second word or any of its rotations is a substring in the first word.\n    \"\"\"\n    if not b:\n        return True\n\n    if b in a:\n        return True\n\n    n = len(b)\n    for i in range(n):\n        rotated_b = b[i:] + b[:i]\n        if rotated_b in a:\n            return True\n            \n    return False", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/154", "solution": "def cycpattern_check(a , b):\n    \"\"\"\n    Checks if the second word or any of its cyclic rotations is a substring in the first word.\n    \"\"\"\n    n = len(b)\n    if n == 0:\n        return False  # Per design, empty string b should not match\n\n    # Generate all cyclic rotations of b\n    rotations = [b[i:] + b[:i] for i in range(n)]\n\n    # Check if any rotation is a substring of a\n    for rotation in rotations:\n        if rotation in a:\n            return True\n            \n    return False", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [["", ""]]}], "HumanEval/155": [{"task_id": "HumanEval/155", "solution": "def even_odd_count(num):\n    \"\"\"Given an integer. return a tuple that has the number of even and odd digits respectively.\"\"\"\n    even_count = 0\n    odd_count = 0\n\n    # Convert the number to its absolute string representation to iterate through digits.\n    # This handles negative numbers by ignoring the sign and 0 correctly.\n    num_str = str(abs(num))\n\n    for digit_char in num_str:\n        digit = int(digit_char)\n        if (digit % 2) == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n\n    return (even_count, odd_count)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/155", "solution": "def even_odd_count(num):\n    \"\"\"Given an integer, return a tuple that has the number of even and odd digits respectively.\"\"\"\n    even_count = 0\n    odd_coun