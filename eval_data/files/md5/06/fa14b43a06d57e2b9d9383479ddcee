 string is balanced if its final net balance is zero and its minimum prefix balance is non-negative.\n        return final_net_balance == 0 and combined_min_prefix >= 0\n\n    s1, s2 = lst[0], lst[1]\n\n    # Check the first concatenation order: s1 + s2\n    if _check_order(s1, s2):\n        return 'Yes'\n\n    # Check the second concatenation order: s2 + s1\n    if _check_order(s2, s1):\n        return 'Yes'\n\n    return 'No'", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/119", "solution": "def match_parens(lst):\n    \"\"\"\n    Checks if it is possible to concatenate two parenthesis strings in some order\n    to form a balanced string.\n    \"\"\"\n\n    def _compute_metrics(s: str) -> tuple[int, int]:\n        \"\"\"\n        Computes the total balance and the minimum prefix balance for a string.\n        A positive balance means more open than close, negative means more close.\n        min_prefix_balance tracks the lowest balance reached at any point.\n        \"\"\"\n        balance = 0\n        min_prefix_balance = 0\n        for char in s:\n            if char == '(':\n                balance += 1\n            else:  # char == ')'\n                balance -= 1\n            min_prefix_balance = min(min_prefix_balance, balance)\n        return balance, min_prefix_balance\n\n    def _is_balanced_after_concat(\n        a_total: int, a_min: int, b_total: int, b_min: int\n    ) -> bool:\n        \"\"\"\n        Determines if concatenating string A then string B results in a good (balanced) string,\n        given their individual total and minimum prefix balances.\n        \"\"\"\n        # A good string must have a total balance of 0.\n        if a_total + b_total != 0:\n            return False\n        # All prefixes within string A must be non-negative.\n        if a_min < 0:\n            return False\n        # All prefixes spanning A and part of B must be non-negative.\n        # This means the minimum balance encountered when traversing B,\n        # starting from A's total balance, must be non-negative.\n        if a_total + b_min < 0:\n            return False\n        return True\n\n    s1, s2 = lst\n    \n    # Compute metrics for both strings\n    s1_total, s1_min = _compute_metrics(s1)\n    s2_total, s2_min = _compute_metrics(s2)\n\n    # Check order s1 + s2\n    if _is_balanced_after_concat(s1_total, s1_min, s2_total, s2_min):\n        return 'Yes'\n\n    # Check order s2 + s1\n    if _is_balanced_after_concat(s2_total, s2_min, s1_total, s1_min):\n        return 'Yes'\n\n    return 'No'", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/120": [{"task_id": "HumanEval/120", "solution": "import heapq\ndef maximum(arr, k):\n    \"\"\"\n    Given an array arr of integers and a positive integer k, return a sorted list \n    of length k with the maximum k numbers in arr.\n    \"\"\"\n    if k == 0:\n        return []\n\n    n = len(arr)\n    if k < n // 2:\n        # For smaller k, heapq.nlargest is more efficient (O(n log k))\n        # heapq.nlargest returns elements in descending order, so sort ascending.\n        top_k = heapq.nlargest(k, arr)\n        result = sorted(top_k)\n    else:\n        # For larger k, sorting the whole array is efficient enough (O(n log n))\n        # and directly provides the last k (largest) elements already sorted.\n        result = sorted(arr)[-k:]\n    \n    return result", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/120", "solution": "def maximum(arr, k):\n    \"\"\"\n    Returns a sorted list of length k with the maximum k numbers in arr.\n    \"\"\"\n    if k == 0:\n        return []\n    \n    # Sort the entire array in non-decreasing order.\n    arr.sort() \n    \n    # Return the last k elements, which are the k largest, already sorted.\n    return arr[len(arr) - k:]", "base_status"