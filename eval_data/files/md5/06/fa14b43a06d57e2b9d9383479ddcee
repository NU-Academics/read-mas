n be decomposed into\n    and integer part (largest integer smaller than given number) and decimals\n    (leftover part always smaller than 1).\n\n    Return the decimal part of the number.\n    >>> truncate_number(3.5)\n    0.5\n    \"\"\"\n    # Use Decimal for stable subtraction to mitigate floating-point inaccuracies.\n    # Set precision for Decimal context, typically a few more digits than needed for final output.\n    precision = 12\n    getcontext().prec = max(precision + 4, 16)\n\n    dec_number = Decimal(str(number))\n    integer_part = math.floor(number)\n    dec_integer_part = Decimal(integer_part)\n\n    # Calculate the fractional part and quantize to the specified precision.\n    fractional_part = dec_number - dec_integer_part\n    return float(+fractional_part.quantize(Decimal(10) ** -precision))", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/4": [{"task_id": "HumanEval/4", "solution": "\n    # Calculate the absolute differences from the mean.", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/4", "solution": "    # Assuming numbers is a non-empty list of floats based on design context,\n    # where validation for empty list or non-numeric values is handled externally.", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/5": [{"task_id": "HumanEval/5", "solution": "def intersperse(numbers: List[int], delimeter: int) -> List[int]:\n    \"\"\" Insert a number 'delimeter' between every two consecutive elements of input list `numbers'\n    >>> intersperse([], 4)\n    []\n    >>> intersperse([1, 2, 3], 4)\n    [1, 4, 2, 4, 3]\n    \"\"\"\n    if not numbers:\n        return []\n\n    result: List[int] = []\n    n = len(numbers)\n    for i, value in enumerate(numbers):\n        result.append(value)\n        if i < n - 1:  # Only append delimiter if it's not the last element\n    