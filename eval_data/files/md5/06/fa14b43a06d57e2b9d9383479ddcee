s: Optional[List[str]] = None) -> None:\n            names = planet_names if planet_names else DEFAULT_ORDERING\n            self._planets: List[Planet] = [Planet(n) for n in names]\n            self._name_to_index: Dict[str, int] = {p.normalized_name(): i for i, p in enumerate(self._planets)}\n\n        def index_of(self, name: str) -> int:\n            return self._name_to_index[name.strip().lower()]\n\n        def between_by_indices(self, i1: int, i2: int) -> Tuple[str, ...]:\n            if i1 == i2:\n                return ()\n            start, end = sorted((i1, i2))\n            # Slice strictly between the indices.\n            return tuple(p.name for p in self._planets[start + 1 : end])\n\n    catalog = PlanetCatalog()\n\n    try:\n        idx1 = catalog.index_of(planet1)\n        idx2 = catalog.index_of(planet2)\n    except KeyError:\n        # Return an empty tuple if one or both planet names are invalid.\n        return ()\n\n    return catalog.between_by_indices(idx1, idx2)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/149": [{"task_id": "HumanEval/149", "solution": "def sorted_list_sum(lst):\n    \"\"\"\n    Deletes strings with odd lengths, then sorts the list by length\n    and alphabetically for same-length words.\n    \"\"\"\n    # Filter out strings that have odd lengths\n    filtered_list = [s for s in lst if len(s) % 2 == 0]\n\n    # Sort the filtered list: first by length, then alphabetically\n    sorted_list = sorted(filtered_list, key=lambda s: (len(s), s))\n\n    return sorted_list", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/149", "solution": "def sorted_list_sum(lst):\n    \"\"\"\n    Filters a list of strings, keeping only those with even lengths,\n    then sorts the remaining strings by length ascending and alphabetically for ties.\n    \"\"\"\n    even_length_strings = [s for s in lst if len(s) % 2 == 0]\