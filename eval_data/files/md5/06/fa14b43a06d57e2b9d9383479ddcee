.\"\"\"\n        if n < 2:\n            return False\n        if n == 2:\n            return True\n        if n % 2 == 0:\n            return False\n        r = int(math.sqrt(n))\n        for i in range(3, r + 1, 2):\n            if n % i == 0:\n                return False\n        return True\n\n    words = sentence.strip().split()\n    filtered_words = [word for word in words if _is_prime(len(word))]\n\n    return \" \".join(filtered_words)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/143", "solution": "import uuid\nfrom datetime import datetime\nfrom dataclasses import dataclass\nfrom typing import List, Protocol, Dict, Any\nclass PrimeUtils:\n    \"\"\"Utility class for prime number checks.\"\"\"\n    @staticmethod\n    def is_prime(n: int) -> bool:\n        \"\"\"Determines if a given integer is a prime number.\"\"\"\n        if n < 2:\n            return False\n        if n in (2, 3):\n            return True\n        if n % 2 == 0:\n            return False\n        r = int(n ** 0.5)\n        for d in range(3, r + 1, 2):\n            if n % d == 0:\n                return False\n        return True\nclass DTOFactory:\n    \"\"\"Factory for creating Data Transfer Objects.\"\"\"\n    @staticmethod\n    def result_to_dto(sentence: Sentence, filtered_words: List[Word]) -> FilterResultDTO:\n        \"\"\"Constructs a FilterResultDTO from sentence and filtered word models.\"\"\"\n        current_time_iso = datetime.now().isoformat()\n        filtered_texts = [word.text for word in filtered_words]\n        result_text_str = \" \".join(filtered_texts)\n        return FilterResultDTO(\n            id=str(uuid.uuid4()),\n            original=sentence.text,\n            filtered=filtered_texts,\n            result_text=result_text_str,\n            timestamp=current_time_iso\n        )\nclass Repository(Protocol):\n    \"\"\"Abstract interface for data persistence.\"\"\"\n    def save(self, record