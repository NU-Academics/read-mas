n        self._number_map = number_map\n\n    def validate(self, words: List[str]) -> None:\n        \"\"\"Checks if all words are valid; raises ValidationError if not.\"\"\"\n        invalid_tokens = [word for word in words if not self._number_map.is_valid(word)]\n        if invalid_tokens:\n            raise ValidationError(\n                f\"Invalid tokens found: {', '.join(set(invalid_tokens))}\",\n                invalid_tokens\n            )\nclass NumberSorter:\n    \"\"\"Sorts a list of number words based on their numerical value.\"\"\"\n    def __init__(self, number_map: NumberMap):\n        self._number_map = number_map\n\n    def sort_words(self, words: List[str]) -> List[str]:\n        \"\"\"Converts words to ints, sorts, and converts back to words.\"\"\"\n        ints = [self._number_map.word_to_int(w) for w in words]\n        ints.sort()\n        return [self._number_map.int_to_word(i) for i in ints]\n\n    def sort_string(self, raw: str, parser: InputParser, validator: Validator) -> str:\n        \"\"\"Parses, validates, and sorts a raw input string.\"\"\"\n        words = parser.parse(raw)\n        if not words:\n            return \"\"\n        validator.validate(words)\n        sorted_words = self.sort_words(words)\n        return \" \".join(sorted_words)\ndef sort_numbers(numbers: str) -> str:\n    \"\"\" Input is a space-delimited string of numberals from 'zero' to 'nine'.\n    Return the string with numbers sorted from smallest to largest\n    \"\"\"\n    _default_number_map = NumberMap()\n    _default_parser = InputParser()\n    _default_validator = Validator(_default_number_map)\n    _default_sorter = NumberSorter(_default_number_map)\n\n    return _default_sorter.sort_string(numbers, _default_parser, _default_validator)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/19", "solution": "from typing import List\nclass InvalidNumberError(Exception):\n    \"\"\"Custom exception for invalid number words.\"\"\"\n    def __init__(self, invalid_tokens: List[str]) -> None:\n        self.invalid_tokens = invalid_tokens\n        super().__init__(f\"Invalid number words found: {', '.join(invalid_tokens)}\")\nWORD_TO_DIGIT = {\n    \"zero\": 0, \"one\": 1, \"two\": 2, \"three\": 3, \"four\": 4,\n    \"five\": 5, \"six\": 6, \"seven\": 7, \"eight\": 8, \"nine\": 9\n}\nDIGIT_TO_WORD = {v: k for k, v in WORD_TO_DIGIT.items()}\nVALID_WORDS = set(WORD_TO_DIGIT.keys())\ndef sort_numbers(numbers: str) -> str:\n    \"\"\" Input is a space-delimited string of numberals from 'zero' to 'nine'.\n    Valid choices are 'zero', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight' and 'nine'.\n    Return the string with numbers sorted from smallest to largest\n    >>> sort_numbers('three one five')\n    'one three five'\n    \"\"\"\n    # Parse input string into normalized tokens\n    if not numbers or numbers.strip() == \"\":\n        tokens: List[str] = []\n    else:\n        tokens = [token.strip().lower() for token in numbers.split()]\n\n    # Validate tokens against valid number words\n    invalid_tokens = [t for t in tokens if t not in VALID_WORDS]\n    if invalid_tokens:\n        raise InvalidNumberError(invalid_tokens)\n\n    # Map words to their corresponding digit values\n    digits = [WORD_TO_DIGIT[t] for t in tokens]\n\n    # Sort the digit values numerically\n    digits.sort()\n\n    # Map sorted digit values back to number words\n    sorted_words = [DIGIT_TO_WORD[d] for d in digits]\n\n    # Join the sorted words into a space-delimited string\n    return \" \".join(sorted_words)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/20": [{"task_id": "HumanEval/20", "solution": "\n    # Initialize with the first pair", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/20", "solution": "def find_closest_elements(numbers: List[float]) -> Tuple[float, float]:\n    \"\"\" From a supplied list of numbers (of length at least two) select and return two that are the closest to each\n    other and return them in order (smaller number, larger number).\n    \"\"\"\n    sorted_numbers = sorted(numbers)\n    \n    min_diff = float('inf')\n    closest_pair = (sorted_numbers[0], sorted_numbers[1])\n\n    for i in range(len(sorted_numbers) - 1):\n        num1 = sorted_numbers[i]\n        num2 = sorted_numbers[i+1]\n        current_diff = num2 - num1\n\n        if current_diff < min_diff:\n            min_diff = current_diff\n            closest_pair = (num1, num2)\n            \n    return closest_pair", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/22": [{"task_id": "HumanEval/22", "solution": "def filter_integers(values: List[Any]) -> List[int]:\n    \"\"\"Filter given list of any Python values only for integers.\n    Returns a new list containing only integer values, excluding booleans, while preserving order.\n    \"\"\"\n    return [value for value in values if type(value) is int]", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/22", "solution": "class InvalidInputError(Exception):\n    \"\"\"Custom exception for invalid input to filter_integers.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\ndef filter_integers(values: List[Any]) -> List[int]:\n    \"\"\" Filter given list of any python values only for integers\n    >>> filter_integers(['a', 3.14, 5])\n    [5]\n    >>> filter_integers([1, 2, 3, 'abc', {}, []])\n    [1, 2, 3]\n    \"\"\"\n    # Validate that the input is a list-like structure (list or tuple) and not None.\n    if values is None:\n        raise InvalidInputError(\"Input cannot be None\")\n    if not isinstance(values, (list, tuple)):\n        raise InvalidInputError(\"Expected a list or tuple of values\")\n\n    # Iterate through the validated values and collect only exact integer types.\n    result: List[int] = []\n    for item in values:\n        if type(item) is int:  # This correctly excludes booleans, which are subclasses of int.\n            result.append(item)\n\n    return result", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/21": [{"task_id": "HumanEval/21", "solution": "    \n    # Handle the degenerate case where all numbers are the same, preventing division by zero.\n    # A small epsilon is used for floating-point comparison.", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/21", "solution": "        # If all numbers are the same, they cannot be rescaled to both 0 and 1.\n        # Following common practice for such a case when exceptions are disallowed,\n        # return a list of 0.0s, satisfying the \"smallest becomes 0\" part.", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/24": [{"task_id": "HumanEval/24", "solution": "import math\ndef integer_sqrt(n: int) -> int:\n    \"\"\"Calculates the integer square root of n.\n    Assumes n is a non-negative integer.\n    \"\"\"\n    return int(math.sqrt(n))\ndef is_prime(n: int) -> bool:\n    \"\"\"Checks if a number n is prime using trial division up to sqrt(n).\"\"\"\n    if n < 2:\n        return False\n    if n == 2 or n == 3:\n        return True\n    if n % 2 == 0 or n % 3 == 0:\n        return False\n    i = 5\n    while i * i <= n:\n        if n % i == 0 or n % (i + 2) == 0:\n            return False\n        i += 6\n    return True\ndef find_largest_divisor_by_search(n: int) -> int:\n    \"\"\"\n    For an odd composite number n, this searches for its largest proper divisor.\n    It iterates downwards from integer_sqrt(n) to find a divisor and its counterpart.\n    \"\"\"\n    root = integer_sqrt(n)\n    # Search for divisors starting from the integer square root, downwards to 1.\n    # We are guaranteed that n is composite and odd at this point.\n    for d in range(root, 0, -1):\n        if n % d == 0:\n            other = n // d\n            # We are looking for the largest divisor strictly smaller than n.\n            # If 'other' (n // d) is less than n, then both d and other are proper divisors.\n            # In this case, max(d, other) will be the largest proper divisor found by this method.\n            # The 'other < n' check handles the case where d=1, making other=n, which is not a proper divisor.\n            if other < n:\n                return max(d, other)\n    # This line should ideally not be reached for composite numbers since a divisor > 1 will be found.\n    # It acts as a fallback, e.g., if `is_prime` somehow missed a prime, it would return 1.\n    return 1\ndef largest_divisor(n: int) -> int:\n    \"\"\" For a given number n, find the largest number that divides n evenly, smaller than n\n    >>> largest_divisor(15)\n    5\n    \"\"\"\n    # According to design, n > 1 is guaranteed by prior validation.\n    \n    # Optimization: if n is even, its largest proper divisor is n // 2.\n    if n % 2 == 0:\n        return n // 2\n\n    # Check if n is prime. If so, its only proper divisor is 1.\n    if is_prime(n):\n        return 1\n\n    # If n is odd and composite, search for its largest proper divisor.\n    return find_largest_divisor_by_search(n)", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[999]]}, {"task_id": "HumanEval/24", "solution": "import math\ndef largest_divisor(n: int) -> int:\n    \"\"\" For a given number n, find the largest number that divides n evenly, smaller than n\n    >>> largest_divisor(15)\n    5\n    \"\"\"\n    max_div = 1\n    # We only need to check for divisors up to the square root of n.\n    # If a number i divides n, then n // i also divides n.\n    # By checking up 