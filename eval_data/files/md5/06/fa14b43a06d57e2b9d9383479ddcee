 exception*, a direct guard is needed.\n        # Let's consider the problem statement: \"find_max([\"name\", \"of\", \"string\"]) == \"string\"\".\n        # It doesn't show an empty list case.\n        # If we *must* return a string and not raise, returning \"\" is the safest bet for empty input.\n        # BUT \"Do NOT add isinstance() checks or raise exceptions for edge cases\" could also mean\n        # that we assume the caller guarantees `words` is never empty and contains only strings.\n        # Given this constraint, let's proceed assuming `words` is guaranteed non-empty.\n        # This implies `max()` and `min()` will always operate on non-empty iterables.\n        pass # Proceeding without an explicit empty list check based on \"no exceptions for edge cases\"\n\n    # Step 1: Calculate the number of unique characters for each word\n    word_metrics = []\n    for word in words:\n        unique_count = len(set(word))\n        word_metrics.append((word, unique_count))\n\n    # Step 2: Find the maximum unique character count\n    # Assumes word_metrics is not empty, which is true if `words` is not empty.\n    max_unique_chars = max(metric[1] for metric in word_metrics)\n\n    # Step 3: Filter words that have the maximum unique character count\n    candidates = [word for word, count in word_metrics if count == max_unique_chars]\n\n    # Step 4: From the candidates, select the one that comes first lexicographically\n    # Assumes candidates is not empty, which is true if `words` is not empty.\n    return min(candidates)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/160": [{"task_id": "HumanEval/160", "solution": "import collections\ndef do_algebra(operator, operand):\n    \"\"\"\n    Evaluates an algebraic expression built from operators and operands, respecting\n    standard operator precedence and associativity.\n    \"\"\"\n\n    class ValidationError(Exception):\n        \"\"\"Custom exception for input validation issues.\"\"\"\n        pass\n\n    class ParseError(Exception):\n        \"\"\"Custom exception for parsing failures.\"\"\"\n        pass\n\n    class EvaluationError(Exception):\n        \"\"\"Custom exception for runtime evaluation errors.\"\"\"\n        pass\n\n    class ExpressionDTO:\n        \"\"\"Data Transfer Object for operators and operands.\"\"\"\n        def __init__(self, operators, operands):\n            self.operators = operators\n            self.operands = operands\n\n        @staticmethod\n        def make(operators, operands):\n            # Shallow copy to ensure internal consistency if original lists are modified externally\n            return ExpressionDTO(list(operators), list(operands))\n\n    class Token:\n        \"\"\"Represents a lexical token (operand or operator).\"\"\"\n        def __init__(self, kind, value):\n            self.kind = kind  # \"OP\" or \"NUM\"\n            self.value = value\n\n        def is_operator(self):\n            return self.kind == \"OP\"\n\n        def is_operand(self):\n            return self.kind == \"NUM\"\n\n    class ASTNode:\n        \"\"\"Node in a binary Abstract Syntax Tree.\"\"\"\n        def __init__(self, left=None, right=None, op=None, value=None):\n            self.left = left\n            self.right = right\n            self.op = op\n            self.value = value\n\n        def is_leaf(self):\n            return self.op is None and self.value is not None\n\n    class OperatorUtils:\n        \"\"\"Centralizes operator metadata and safe operation implementations.\"\"\"\n        SUPPORTED_OPS = {\"+\", \"-\", \"*\", \"//\", \"**\"}\n        _PRECEDENCE = {\"**\": 3, \"*\": 2, \"//\": 2, \"+\": 1, \"-\": 1}\n        _RIGHT_ASSOC = {\"**\"}\n\n        @staticmethod\n        def precedence(op):\n            if op not in OperatorUtils.SUPPORTED_OPS:\n                raise ValidationError(f\"Unsupported operator: {op}\")\n            return OperatorUtils._PRECEDENCE.get(op, 0)\n\n        @staticmethod\n        def is_right_associative(op):\n            return op in OperatorUtils._RIGHT_ASSOC\n\n        @staticmethod\n        def apply(op, left, right):\n            try:\n                if op == \"+\":\n                    return left + right\n                elif op == \"-\":\n                    return left - right\n                elif op == \"*\":\n                    return left * right\n                elif op == \"//\":\n                    if right == 0:\n                        raise EvaluationError(\"Division by zero\")\n                    return left // right\n                elif op == \"**\":\n                    if left == 0 and right < 0: # Python raises ZeroDivisionError, but it's more like a MathError\n                        raise EvaluationError(\"Zero to negative power is undefined\")\n                    return left ** right\n                else:\n                    raise EvaluationError(f\"Unknown operator during evaluation: {op}\")\n            except OverflowError:\n                raise EvaluationError(f\"Overflow during operation: {left} {op} {right}\")\n            except Exception as e:\n                # Catch general exceptions for unexpected behavior during apply\n                raise EvaluationError(f\"Error applying operator {op}: {e}\")\n\n    class ExpressionValidator:\n        \"\"\"Validates ExpressionDTO against business rules.\"\"\"\n        def __init__(self):\n            self.allowed_ops = OperatorUtils.SUPPORTED_OPS\n\n        def validate(self, dto):\n            if not dto.operands:\n                raise ValidationError(\"Operand list cannot be empty.\")\n\n            if not dto.operators and len(dto.operands) > 1:\n                 raise ValidationError(\"Operator list is empty but multiple operands exist.\")\n            \n            if len(dto.operators) != len(dto.operands) - 1:\n                raise ValidationError(\n                    \"Length of operator list must be equal to length of operand list minus one.\"\n                )\n            \n            if len(dto.operands) < 2:\n                raise ValidationError(\"Operand list must contain at least two operands.\")\n\n            if len(dto.operators) < 1:\n                raise ValidationError(\"Operator list must contain at least one operator.\")\n\n            for op in dto.operators:\n                if op not in self.allowed_ops:\n                    raise ValidationError(f\"Unsupported operator found: '{op}'\")\n\n            for i, operand_val in enumerate(dto.operands):\n                if not isinstance(operand_val, int):\n                    raise ValidationError(f\"Operand at index {i} is not an integer: '{operand_val}'\")\n                if operand_val < 0:\n                    raise ValidationError(f\"Operand at index {i} is negative: '{operand_val}'\")\n            \n\n    class ExpressionParser:\n        \"\"\"Parses token sequence into an AST using the shunting-yard algorithm.\"\"\"\n\n        def parse(self, dto):\n            tokens = self._to_tokens(dto)\n            rpn_tokens = self._shunting_yard(tokens)\n            ast_root = self._build_ast_from_rpn(rpn_tokens)\n            return ast_root\n\n        def _to_tokens(self, dto):\n            all_tokens = []\n            for i in range(len(dto.operands)):\n                all_tokens.append(Token(\"NUM\", dto.operands[i]))\n                if i < len(dto.operators):\n                    all_tokens.append(Token(\"OP\", dto.operators[i]))\n            return all_tokens\n\n        def _shunting_yard(self, tokens):\n            output_queue = collections.deque()\n            operator_stack = collections.deque()\n\n            for token in tokens:\n                if token.is_operand():\n                    output_queue.append(token)\n                elif token.is_operator():\n                    while (\n                        operator_stack and operator_stack[-1].is_operator() and\n                        (\n                            (OperatorUtils.precedence(operator_stack[-1].value) > OperatorUtils.precedence(token.value)) or\n                            (\n                                OperatorUtils.precedence(operator_stack[-1].value) == OperatorUtils.precedence(token.value) and\n                                not OperatorUtils.is_right_associative(token.value)\n                            )\n                        )\n                    ):\n                        output_queue.append(operator_stack.pop())\n                    operator_stack.append(token)\n            \n            while operator_stack:\n                if not operator_stack[-1].is_operator():\n                    # This case typically indicates mismatched parentheses, but our grammar doesn't have them\n                    raise ParseError(\"Invalid expression structure: operator stack not empty at end.\")\n                output_queue.append(operator_stack.pop())\n\n            return list(output_queue)\n\n        def _build_ast_from_rpn(self, rpn_tokens):\n            stack = collections.deque()\n            for token in rpn_tokens:\n                if token.is_operand():\n                    stack.append(ASTNode(value=token.value))\n                elif token.is_operator():\n                    if len(stack) < 2:\n                        raise ParseError(\"Not enough operands for operator in RPN.\")\n                    right_node = stack.pop()\n                    left_node = stack.pop()\n                    stack.append(ASTNode(left=left_node, right=right_node, op=token.value))\n            \n            if len(stack) != 1:\n                raise ParseError(\"Invalid RPN expression: stack did not yield a single AST root.\")\n            return stack.pop()\n\n    class Evaluator:\n        \"\"\"Evaluates an AST to produce an integer result.\"\"\"\n\n        def evaluate(self, node):\n            if node.is_leaf():\n                return node.value\n            else:\n                left_val =