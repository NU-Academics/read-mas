ervice\n\n    def filter(self, request: FilterRequest) -> FilterResult:\n        \"\"\"Validates the request and performs the filtering operation.\"\"\"\n        validate_strings(request.items)\n        validate_substring(request.substring)\n        filtered = self._service.filter_by_substring(request.items, request.substring)\n        return FilterResult(filtered)\ndef filter_by_substring(strings: List[str], substring: str) -> List[str]:\n    \"\"\" Filter an input list of strings only for ones that contain given substring\n    >>> filter_by_substring([], 'a')\n    []\n    >>> filter_by_substring(['abc', 'bacd', 'cde', 'array'], 'a')\n    ['abc', 'bacd', 'array']\n    \"\"\"\n    repo = InMemoryStringRepository(strings)\n    service = FilterService(repo)\n    controller = FilterController(service)\n    req = FilterRequest(strings, substring)\n    result = controller.filter(req)\n    return result.filtered", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[[], "john"]], "plus_fail_tests": [[["banana", "apple", "kiwi", "peach"], "a"]]}, {"task_id": "HumanEval/7", "solution": "def filter_by_substring(strings: List[str], substring: str) -> List[str]:\n    \"\"\" Filter an input list of strings only for ones that contain given substring.\n    The search is case-sensitive.\n    \"\"\"\n    return [s for s in strings if substring in s]", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/8": [{"task_id": "HumanEval/8", "solution": "from typing import List, Tuple, Any\nimport json\nclass InvalidInputError(Exception):\n    def __init__(self, message: str) -> None:\n        self.message = message\n        super().__init__(message)\n    def __str__(self) -> str:\n        return self.message\nclass Result:\n    \"\"\"DTO for computation result, encapsulating sum and product.\"\"\"\n    def __init__(self, sum: int, product: int) -> None:\n        self.sum = sum\n        self.product = product\n    def to_tuple(self) -> Tuple[int, int]:\n        return (self.sum, self.product)\n    def to_dict(self) -> dict:\n        return {\"sum\": self.sum, \"product\": self.product}\nclass InputValidator:\n    \"\"\"Validates raw input into a List[int] according to business rules.\"\"\"\n    ALLOW_JSON_ARRAY = True\n\n    def validate(self, raw: Any) -> List[int]:\n        if raw is None:\n            return []\n        if isinstance(raw, (list, tuple)):\n            return [self._validate_item(it, i) for i, it in enumerate(raw)]\n        if isinstance(raw, str):\n            s = raw.strip()\n            if self.ALLOW_JSON_ARRAY and s.startswith('['):\n                try:\n                    parsed = json.loads(s)\n                except json.JSONDecodeError as e:\n                    raise InvalidInputError(f\"Invalid JSON: {e}\")\n                if not isinstance(parsed, list):\n                    raise InvalidInputError(\"JSON must be an array of integers\")\n                return [self._validate_item(it, i) for i, it in enumerate(parsed)]\n            if s == '':\n                return []\n            parts = s.split()\n            return [self._validate_item(int(p), i) for i, p in enumerate(parts)]\n        raise InvalidInputError(\"Unsupported input type; provide list[int] or string\")\n\n    def _validate_item(self, item: Any, idx: int) -> int:\n        \"\"\"Validates a single item to ensure it's an integer.\"\"\"\n        if not isinstance(item, int):\n            raise InvalidInputError(f\"Item at index {idx} is not int: {item!r}\")\n        return item\nclass SumProductService:\n    \"\"\"Core algorithm to compute the sum and product of a list of integers.\"\"\"\n    def compute(self, numbers: List[int]) -> Result:\n        total = sum(numbers)\n        product = self._product_iter(numbers)\n        return Result(total, product)\n\n    def _product_iter(self, numbers: List[int]) -> int:\n        \"\"\"Iteratively computes the product of numbers, returning 1 for an empty list.\"\"\"\n        prod = 1\n        for n in numbers:\n            prod *= n\n        return prod\nclass SumProductController:\n    \"\"\"Orchestrates validation and service to produce a Result.\"\"\"\n    def __init__(self, validator: InputValidator, service: SumProductService) -> None:\n        self.validator = validator\n        self.service = service\n\n    def handle(self, raw_input: object) -> Result:\n        validated = self.validator.validate(raw_input)\n        return self.service.compute(validated)\ndef sum_product(numbers: List[int]) -> Tuple[int, int]:\n    \"\"\"\n    For a given list of integers, return a tuple consisting of a sum and a product of all the integers in a list.\n    Empty sum should be equal to 0 and empty product should be equal to 1.\n    \"\"\"\n    controller = SumProductController(InputValidator(), SumProductService())\n    result = controller.handle(numbers)\n    return result.to_tuple()", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[{}]]}, {"task_id": "HumanEval/8", "solution": "def sum_product(numbers: List[int]) -> Tuple[int, int]:\n    \"\"\" For a given list of integers, return a tuple consisting of a sum and a product of all the integers in a list.\n    Empty sum should be equal to 0 and empty product should be equal to 1.\n    \"\"\"\n    total_sum = sum(numbers)\n    total_product = 1\n    for num in numbers:\n        total_product *= num\n    return total_sum, total_product", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/9": [{"task_id": "HumanEval/9", "solution": "    \"\"\" From a given list of integers, generate a list of rolling maximum element found until given moment", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/9", "solution": "    \"\"\" From a given list of integers, generate a list of rolling maximum element found until given moment", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/10": [{"task_id": "HumanEval/10", "solution": "def make_palindrome(string: str) -> str:\n    \"\"\" Find the shortest palindrome that begins with a supplied string.\n    Algorithm idea is simple:\n    - Find the longest postfix of supplied string that is a palindrome.\n    - Append to the end of the string reverse of a string prefix that comes before the palindromic suffix.\n    >>> make_palindrome('')\n    ''\n    >>> make_palindrome('cat')\n    'catac'\n    >>> make_palindrome('cata')\n    'catac'\n    \"\"\"\n\n    def _kmp_prefix_table(s: str) -> list[int]:\n        \"\"\"Builds the KMP prefix function (LPS array) for a given string.\"\"\"\n        n = len(s)\n        lps = [0] * n\n        length = 0  # Length of the previous longest prefix suffix\n        i = 1\n        while i < n:\n            if s[i] == s[length]:\n                length += 1\n                lps[i] = length\n                i += 1\n            else:\n                if length != 0:\n                    length = lps[length - 1]\n                else:\n                    lps[i] = 0\n                    i += 1\n        return lps\n\n    if not string:\n        return \"\"\n\n    # To find the longest palindromic suffix of the 'string', we use a KMP-like approach.\n    # We construct a new string by concatenating the original string, a unique separator '#',\n    # and the reversed original string.\n    # The last value of the LPS array for this concatenated string will give the length\n    # of the longest prefix of the reversed string that is also a suffix of the original string.\n    # This length corresponds to the longest palindromic suffix of the original string.\n    \n    reversed_string = string[::-1]\n    concat_string = string + '#' + reversed_string\n    \n    lps_array = _kmp_prefix_table(concat_string)\n    \n    # 'longest_palindromic_suffix_len' is the length of the longest palindromic suffix of 'string'.\n    longest_palindromic_suffix_len = lps_array[-1]\n    \n    # The 'prefix' of the original string that needs to be reversed and appended\n    # is the part that comes before this longest palindromic suffix.\n    # The length of this prefix is len(string) - longest_palindromic_suffix_len.\n    # The characters to append are the first 'len(string) - longest_palindromic_suffix_len'\n    # characters of the 'reversed_string'. This effectively reverses that non-palindromic prefix.\n    chars_to_add = reversed_string[:len(string) - longest_palindromic_suffix_len]\n    \n    return string + chars_to_add", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [["xyz"]], "plus_fail_tests": [["race"]]}, {"task_id": "HumanEval/10", "solution": "def is_palindrome(string: str) -> bool:\n    \"\"\" Test if given string is a palindrome \"\"\"\n    return string == string[::-1]\ndef make_palindrome(string: str) -> str:\n    \"\"\" Find the shortest palindrome that begins with a supplied string.\n    Algorithm idea is simple:\n    - Find the longest postfix of supplied string that is a palindrome.\n    - Append to the end of the string reverse of a string prefix that comes before the palindromic suffix.\n    >>> make_palindrome('')\n    ''\n    >>> make_palindrome('cat')\n    'catac'\n    >>> make_palindrome('cata')\n    'catac'\n    \"\"\"\n    if not string:\n        return \"\"\n\n    n = len(string)\n    for i in range(n):\n        # Check if the suffix string[i:] is a palindrome\n        if is_palindrome(string[i:]):\n            # If it is, the prefix string[:i] needs to be reversed and appended\n            prefix_to_reverse = string[:i]\n            return string + prefix_to_reverse[::-1]\n\n    # This case should theoretically not be reached if string is non-empty,\n    # as at least a single character (the last one) would be a palindrome.\n    # However, as a fallback (e.g., if input validation wasn't strict or for completeness),\n    # return the original string plus its full reverse (excluding the original itself)\n    # This case is when the only palindromic suffix is the entire string itself.\n    # But the loop above would find it at i=0. The algorithm ensures a palindrome is found.\n    # The loop `for i in range(n)` ensures `string[n-1:]` (the last character)\n    # will be checked, which is always a palindrome.\n    # So `i` will always be found.\n    return string", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/11": [{"task_id": "HumanEval/11", "solution": "from typing import List\nclass InvalidBinaryStringError(ValueError):\n    \"\"\"Custom exception for invalid binary string input.\"\"\"\n    def __init__(self, message: str, invalid_value: str) -> None:\n        super().__init__(message)\n        self.message = message\n        self.invalid_value = invalid_value\nclass MismatchedLengthError(ValueError):\n    \"\"\"Custom exception for binary strings of mismatched lengths.\"\"\"\n    def __init__(self, message: str, len_a: int, len_b: int) -> None:\n        super().__init__(message)\n        self.message = message\n        self.len_a = len_a\n        self.len_b = len_b\nclass XORRequest:\n    \"\"\"Data Transfer Object for XOR operation request.\"\"\"\n    def __init__(self, a: str, b: str) -> None:\n        self.a = a\n        self.b = b\n\n    def __repr__(self) -> str:\n        return f\"XORRequest(a='{self.a}', b='{self.b}')\"\nclass XORResponse:\n    \"\"\"Data Transfer Object for XOR operation response.\"\"\"\n    def __init__(self, result: str) -> None:\n        self.result = result\n\n    def __repr__(self) -> str:\n        return f\"XORResponse(result='{self.result}')\"\nclass StringXORService:\n    \"\"\"Core logic service to perform binary XOR operation.\"\"\"\n    def __init__(self) -> None:\n        pass\n\n    def xor(self, a: str, b: str) -> str:\n        \"\"\"Performs bitwise XOR on two equal-length