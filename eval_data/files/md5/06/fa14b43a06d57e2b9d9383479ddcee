return sequence", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/130", "solution": "def tri(n):\n    \"\"\"Computes the first n + 1 numbers of the Tribonacci sequence based on its recurrence relations.\n    The sequence is defined with tri(0)=1, tri(1)=3, and specific rules for even and odd indices.\n    \"\"\"\n    if n < 0:\n        return []\n\n    # Initialize a list to store the sequence values, up to tri(n)\n    sequence = [0] * (n + 1)\n\n    for i in range(n + 1):\n        if i == 1:\n            # Special case for tri(1)\n            sequence[i] = 3\n        elif i % 2 == 0:\n            # Rule for even indices, including tri(0)\n            sequence[i] = 1 + (i // 2)\n        else:\n            # Rule for odd indices. tri(i+1) is an even index, so it can be computed directly.\n            # tri(i) = tri(i - 1) + tri(i - 2) + tri(i + 1)\n            tri_i_minus_1 = sequence[i - 1]\n            tri_i_minus_2 = sequence[i - 2]\n            tri_i_plus_1 = 1 + ((i + 1) // 2)  # Since i+1 is always even\n\n            sequence[i] = tri_i_minus_1 + tri_i_minus_2 + tri_i_plus_1\n    return sequence", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/139": [{"task_id": "HumanEval/139", "solution": "_DEFAULT_CACHE_CAPACITY = 128\nclass _FactorialCalculator:\n    \"\"\"Computes factorials with memoization to optimize repeated calculations.\"\"\"\n    def __init__(self):\n        self._memo = {0: 1, 1: 1}\n\n    def factorial(self, n):\n        if n in self._memo:\n            return self._memo[n]\n\n        last_computed_n = max(self._memo)\n        result = self._memo[last_computed_n]\n        for k in range(last_computed_n + 1, n + 1):\n            result *= k\n            self._memo[k] = result\n        return self._memo[n]\nclass _InMemoryCacheRepository:\n    \"\"\"An in-memory LRU cache implementation for storing results.\"\"\"\n    def __