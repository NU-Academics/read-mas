ng Unicode NFC and applies optional case-folding or whitespace removal based on configuration.\"\"\"\n    def __init__(self, config: ComparerConfig, form: str = \"NFC\") -> None:\n        self._config = config\n        self._form = form\n\n    def normalize(self, s: str) -> str:\n        s = unicodedata.normalize(self._form, s)\n        if self._config.ignore_case:\n            s = s.casefold()\n        if self._config.ignore_whitespace:\n            s = \"\".join(ch for ch in s if not ch.isspace())\n        return s\nclass CharSetComparer:\n    \"\"\"Compares two strings to determine if they contain the same set of characters after normalization.\"\"\"\n    def __init__(self, config: ComparerConfig) -> None:\n        self._config = config\n        self._normalizer = StringNormalizer(config)\n\n    def same_chars(self, s0: str, s1: str) -> bool:\n        s0n = self._normalizer.normalize(s0)\n        s1n = self._normalizer.normalize(s1)\n        return set(s0n) == set(s1n)\ndef same_chars(s0: str, s1: str) -> bool:\n    \"\"\"\n    Check if two words have the same characters.\n    >>> same_chars('eabcdzzzz', 'dddzzzzzzzddeddabc')\n    True\n    >>> same_chars('abcd', 'dddddddabc')\n    True\n    >>> same_chars('dddddddabc', 'abcd')\n    True\n    >>> same_chars('eabcd', 'dddddddabc')\n    False\n    >>> same_chars('abcd', 'dddddddabce')\n    False\n    >>> same_chars('eabcdzzzz', 'dddzzzzzzzddddabc')\n    False\n    \"\"\"\n    config = ComparerConfig()\n    comparer = CharSetComparer(config)\n    return comparer.same_chars(s0, s1)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/55": [{"task_id": "HumanEval/55", "solution": "def fib(n: int):\n    \"\"\"Return n-th Fibonacci number using an iterative approach.\"\"\"\n    if n == 0:\n        return 0\n    a, b = 0, 1\n    for _ in range(1, n):\n        a, b = b, a + b\n    return b", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fai