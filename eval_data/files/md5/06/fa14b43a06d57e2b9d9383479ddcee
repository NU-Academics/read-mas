       return datetime.datetime.now(datetime.timezone.utc).isoformat()\n\n    def safe_len(s: str) -> int:\n        return len(s)\n\n    # 4. Define StorageAdapter interface (from design's adapters/base.py)\n    class StorageAdapter(abc.ABC):\n        @abc.abstractmethod\n        def save_entry(self, entry: Dict[str, Any]) -> None:\n            pass\n\n        @abc.abstractmethod\n        def fetch_entries(self, limit: int, filter_substring: Optional[str]) -> List[Dict[str, Any]]:\n            pass\n\n    # 5. Define SqliteStorageAdapter (from design's adapters/sqlite_adapter.py)\n    CREATE_TABLE_SQL = \"\"\"\n    CREATE TABLE IF NOT EXISTS history (\n      id INTEGER PRIMARY KEY AUTOINCREMENT,\n      input TEXT NOT NULL,\n      length INTEGER NOT NULL,\n      timestamp TEXT NOT NULL\n    );\n    CREATE INDEX IF NOT EXISTS idx_history_timestamp ON history(timestamp DESC);\n    \"\"\"\n    class SqliteStorageAdapter(StorageAdapter):\n        def __init__(self, db_path: str):\n            self._db_path = db_path\n            # check_same_thread=False allows SQLite connection to be used across threads,\n            # important if used in HTTP server context, but also harmless for single-threaded CLI use.\n            self._conn = sqlite3.connect(self._db_path, check_same_thread=False)\n            self._ensure_schema()\n\n        def _ensure_schema(self) -> None:\n            self._conn.executescript(CREATE_TABLE_SQL)\n            self._conn.commit()\n\n        def save_entry(self, entry: Dict[str, Any]) -> None:\n            try:\n                with self._conn:\n                    self._conn.execute(\n                        \"INSERT INTO history (input, length, timestamp) VALUES (?, ?, ?)\",\n                        (entry[\"input\"], entry[\"length\"], entry[\"timestamp\"])\n                    )\n            except sqlite3.Error as e:\n                raise RepositoryError(\"sqlite save failed\", cause=e)\n\n        def fetch_entries(self, limit: int, filter_substring: Optional[str]) -> List[Dict[str, Any]]:\n            # This method is part of the adapter but not directly called by the strlen convenience wrapper.\n            try:\n                cur = self._conn.cursor()\n                if filter_substring:\n                    q = \"SELECT id, input, length, timestamp FROM history WHERE input LIKE ? ORDER BY timestamp DESC LIMIT ?\"\n                    cur.execute(q, (f\"%{filter_substring}%\", limit))\n                else:\n                    q = \"SELECT id, input, length, timestamp FROM history ORDER BY timestamp DESC LIMIT ?\"\n                    cur.execute(q, (limit,))\n                rows = cur.fetchall()\n                return [{\"id\": r[0], \"input\": r[1], \"length\": r[2], \"timestamp\": r[3]} for r in rows]\n            except sqlite3.Error as e:\n                raise RepositoryError(\"sqlite fetch failed\", cause=e)\n\n    # 6. Define HistoryRepository (from design's repository.py)\n    class HistoryRepository:\n        def __init__(self, adapter: StorageAdapter):\n            self._adapter = adapter\n\n        def add_entry(self, input_str: str, length: int, timestamp: str) -> None:\n            entry = {\"input\": input_str, \"length\": length, \"timestamp\": timestamp}\n            self._adapter.save_entry(entry)\n\n        # get_recent method from design is not directly used by this strlen wrapper, thus omitted.\n\n    # 7. Define StringValidator (from design's validators.py)\n    class StringValidator:\n        def __init__(self, max_length: int = MAX_INPUT_LENGTH):\n            self.max_length = max_length\n\n        def validate(self, value: Any) -> str:\n            if value is None:\n                raise ValidationError(\"input is required\")\n            if not isinstance(value, str):\n                raise ValidationError(f\"expected str, got {type(value).__name__}\")\n            if safe_len(value) > self.max_length: # Using safe_len defined locally\n                raise ValidationError(\"input too long\")\n            return value\n\n    # 8. Define StringService (from design's core.py snippet)\n    class StringService:\n        def __init__(self, repository: HistoryRepository, validator: StringValidator):\n            self._repository = repository\n            self._validator = validator\n\n        def strlen(self, value: Any) -> int:\n            s = self._validator.validate(value)\n            length = safe_len(s)\n            try:\n                self._repository.add_entry(s, length, now_iso())\n            except Exception:\n                # Log persistence failure but allow main function to return result\n                _logger = logging.getLogger(__name__)\n                _logger.exception(\"Failed to persist history for input: %s\", s[:100])\n            return length\n\n    # 9. The actual implementation for the strlen convenience wrapper, creating default components.\n    # This aligns with the snippet provided in the design context for the top-level strlen function.\n    adapter = SqliteStorageAdapter(DEFAULT_DB_PATH)\n    repo = HistoryRepository(adapter)\n    service = StringService(repo, StringValidator())\n    return service.strlen(string)", "base_status": "timeout", "plus_status": "timeout", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/25": [{"task_id": "HumanEval/25", "solution": "from typing import List\ndef factorize(n: int) -> List[int]:\n    \"\"\" Return list of prime factors of given integer in the order from smallest to largest.\n    Each of the factors should be listed number of times corresponding to how many times it appeares in factorization.\n    Input number should be equal to the product of all factors\n    >>> factorize(8)\n    [2, 2, 2]\n    >>> factorize(25)\n    [5, 5]\n    >>> factorize(70)\n    [2, 5, 7]\n    \"\"\"\n    factors = []\n\n    # Handle factor 2\n    while n % 2 == 0:\n        factors.append(2)\n        n //= 2\n\n    # Handle odd factors starting from 3\n    f = 3\n    while f * f <= n:\n        while n % f == 0:\n            factors.append(f)\n            n //= f\n        f += 2 # Move to the next odd number\n\n    # If n is still greater than 1, it must be the last remaining prime factor\n    if n > 1:\n        factors.append(n)\n\n    return factors", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/25", "solution": "from typing import List\nimport math\ndef factorize(n: int) -> List[int]:\n    \"\"\" Return list of prime factors of given integer in the order from smallest to largest.\n    Each of the factors should be listed number of times corresponding to how many times it appeares in factorization.\n    \"\"\"\n    factors: List[int] = []\n\n    # Handle factor 2\n    while n % 2 == 0:\n        factors.append(2)\n        n //= 2\n\n    # Handle odd factors starting from 3\n    d = 3\n    # Iterate up to the square root of n (or the current n if it's reduced)\n    while d * d <= n:\n        while n % d == 0:\n            factors.append(d)\n            n //= d\n        d += 2  # Increment by 2 to check only odd numbers\n\n    # If n is still greater than 1, it must be a prime factor itself\n    if n > 1:\n        factors.append(n)\n\n    return factors", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/26": [{"task_id": "HumanEval/26", "solution": "from typing import List, Callable, Dict\nimport time\nimport logging\nfrom collections import deque\nclass NumbersRequest:\n    \"\"\"DTO for incoming request containing numbers.\"\"\"\n    def __init__(self, numbers: List[int]):\n        self.numbers = numbers\nclass NumbersResponse:\n    \"\"\"DTO for outgoing response containing filtered numbers and counts.\"\"\"\n    def __init__(self, filtered: List[int], original_count: int, filtered_count: int):\n        self.filtered = filtered\n        self.original_count = original_count\n        self.filtered_count = filtered_count\nclass AuditRecord:\n    \"\"\"Record of an operation for auditing purposes.\"\"\"\n    def __init__(self, timestamp: float, original_count: int, filtered_count: int, input_preview: List[int]):\n        self.timestamp = timestamp\n        self.original_count = original_count\n        self.filtered_count = filtered_count\n        self.input_preview = input_preview\nclass AuditRepositoryInterface:\n    \"\"\"Interface for storing audit records.\"\"\"\n    def save(self, record: 'AuditRecord') -> None:\n        raise NotImplementedError\n    def list_recent(self, limit: int) -> List['AuditRecord']:\n        raise NotImplementedError\nclass InMemoryAuditRepository(AuditRepositoryInterface):\n    \"\"\"In-memory implementation of the audit repository.\"\"\"\n    def __init__(self, max_entries: int = 1000):\n        self._max_entries = max_entries\n        self._records: deque[AuditRecord] = deque(maxlen=max_entries)\n\n    def save(self, record: AuditRecord) -> None:\n        self._records.append(record)\n\n    def list_recent(self, limit: int) -> List[AuditRecord]:\n        return list(self._records)[-limit:]\nclass DuplicateRemoverService:\n    \"\"\"Core business logic for removing duplicate numbers.\"\"\"\n    def __init__(self, repository: AuditRepositoryInterface, validator: Callable[[List[int]], None] = validate_numbers):\n        self._repository = repository\n        self._validator = validator\n\n    def remove_duplicates(self, numbers: List[int]) -> (List[int], AuditRecord):\n        self._validator(numbers)\n        freqs = self._compute_frequencies(numbers)\n        filtered = [x for x in numbers if freqs.get(x, 0) == 1]\n        audit = AuditRecord(time.time(), len(numbers), len(filtered), numbers[:10])\n        try:\n            self._repository.save(audit)\n        except Exception:\n            logging.exception(\"Failed to save audit; continuing\")\n        return filtered, audit\n\n    def _compute_frequencies(self, numbers: List[int]) -> Dict[int, int]:\n        counts = {}\n        for number in numbers:\n            counts[number] = counts.get(number, 0) + 1\n        return counts\nclass DuplicateRemoverController:\n    \"\"\"Controller for handling number removal requests.\"\"\"\n    def __init__(self, service: DuplicateRemoverService):\n        self._service = service\n\n    def remove_duplicates_request(self, request: NumbersRequest) -> NumbersResponse:\n        filtered_list, audit_record = self._service.remove_duplicates(request.numbers)\n        return NumbersResponse(\n            filtered=filtered_list,\n            original_count=audit_record.original_count,\n            filtered_count=audit_record.filtered_count\n        )\ndef remove_duplicates(numbers: List[int]) -> List[int]:\n    \"\"\" From a list of integers, remove all elements that occur more than once.\n    Keep order of elements left the same as in the input.\n    >>> remove_duplicates([1, 2, 3, 2, 4])\n    [1, 3, 4]\n    \"\"\"\n    repo = InMemoryAuditRepository()\n    svc = DuplicateRemoverService(repo)\n    ctrl = DuplicateRemoverController(svc)\n    resp = ctrl.remove_duplicates_request(NumbersRequest(numbers))\n    return resp.filtered", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/26", "solution": "    \"\"\" From a list of integers, remove all elements that occur more than once.", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/28": [{"task_id": "HumanEval/28", "solution": "def concatenate(strings: List[str]) -> str:\n    \"\"\"Concatenate a list of strings into a single string.\"\"\"\n    return \"\".join(strings)", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/28", "solution": "    \"\"\" Concatenate list of strings into a single string. \"\"\"", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail