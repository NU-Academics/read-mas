{"task_id": "HumanEval/55", "solution": "def fib(n: int):\n    \"\"\"Return n-th Fibonacci number.\n    >>> fib(10)\n    55\n    >>> fib(1)\n    1\n    >>> fib(8)\n    21\n    \"\"\"\n    if n <= 2:\n        return 1\n\n    a, b = 1, 1\n    for _ in range(3, n + 1):\n        a, b = b, a + b\n    return b"}
{"task_id": "HumanEval/54", "solution": "def same_chars(s0: str, s1: str):\n    \"\"\"\n    Check if two words have the same characters.\n    >>> same_chars('eabcdzzzz', 'dddzzzzzzzddeddabc')\n    True\n    >>> same_chars('abcd', 'dddddddabc')\n    True\n    >>> same_chars('dddddddabc', 'abcd')\n    True\n    >>> same_chars('eabcd', 'dddddddabc')\n    False\n    >>> same_chars('abcd', 'dddddddabce')\n    False\n    >>> same_chars('eabcdzzzz', 'dddzzzzzzzddddabc')\n    False\n    \"\"\"\n    def _get_unique_characters(input_string: str) -> set[str]:\n        \"\"\"Extracts the set of unique characters from a given string.\"\"\"\n        return set(input_string)\n\n    unique_chars_s0 = _get_unique_characters(s0)\n    unique_chars_s1 = _get_unique_characters(s1)\n\n    return unique_chars_s0 == unique_chars_s1"}
{"task_id": "HumanEval/56", "solution": "def correct_bracketing(brackets: str):\n    \"\"\" brackets is a string of \"<\" and \">\".\n    return True if every opening bracket has a corresponding closing bracket.\n\n    >>> correct_bracketing(\"<\")\n    False\n    >>> correct_bracketing(\"<>\")\n    True\n    >>> correct_bracketing(\"<<><>>\")\n    True\n    >>> correct_bracketing(\"><<>\")\n    False\n    \"\"\"\n    balance = 0\n    for char in brackets:\n        if char == '<':\n            balance += 1\n        elif char == '>':\n            if balance == 0:\n                return False\n            balance -= 1\n\n    return balance == 0"}
{"task_id": "HumanEval/57", "solution": "def monotonic(l: list):\n    \"\"\"Return True is list elements are monotonically increasing or decreasing.\"\"\"\n\n    def _is_increasing(l: list) -> bool:\n        \"\"\"Return True if list elements are monotonically increasing or constant.\n        An empty list or a list with a single element is considered increasing.\n        \"\"\"\n        if len(l) <= 1:\n            return True\n        for i in range(len(l) - 1):\n            if l[i] > l[i+1]:\n                return False\n        return True\n\n    def _is_decreasing(l: list) -> bool:\n        \"\"\"Return True if list elements are monotonically decreasing or constant.\n        An empty list or a list with a single element is considered decreasing.\n        \"\"\"\n        if len(l) <= 1:\n            return True\n        for i in range(len(l) - 1):\n            if l[i] < l[i+1]:\n                return False\n        return True\n\n    return _is_increasing(l) or _is_decreasing(l)"}
