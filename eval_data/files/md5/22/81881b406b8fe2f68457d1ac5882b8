       day = int(parts[1])\n            year = int(parts[2])\n            return (month, day, year)\n        except ValueError:\n            return None\n\n    def _is_valid_month_range(month):\n        \"\"\"Validates if the month component is within the valid range [1, 12].\"\"\"\n        return 1 <= month <= 12\n\n    def _is_valid_day_range(month, day):\n        \"\"\"Validates if the day component is within the valid range for the given month.\"\"\"\n        if not (1 <= day):\n            return False\n\n        if month in [1, 3, 5, 7, 8, 10, 12]:\n            return day <= 31\n        elif month in [4, 6, 9, 11]:\n            return day <= 30\n        elif month == 2:\n            return day <= 29\n        return False # Should not be reached if month is already validated\n\n    if not _is_not_empty(date):\n        return False\n\n    components = _parse_date_components(date)\n    if components is None:\n        return False\n\n    month, day, year = components\n\n    if not _is_valid_month_range(month):\n        return False\n\n    if not _is_valid_day_range(month, day):\n        return False\n\n    return True", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [["06-04-202"]]}, {"task_id": "HumanEval/124", "solution": "class DateComponents:\n    \"\"\"Encapsulates parsed month, day, and year.\"\"\"\n    def __init__(self, month: int, day: int, year: int):\n        self.month = month\n        self.day = day\n        self.year = year\ndef _parse_date_string(date_string: str) -> 'DateComponents | None':\n    \"\"\"Parses date string into components, validating format and non-emptiness.\"\"\"\n    if not date_string:\n        return None\n\n    parts = date_string.split('-')\n    if len(parts) != 3:\n        return None\n\n    try:\n        month_str, day_str, year_str = parts\n        # Rule 4: mm-dd-yyyy format check (length of string parts)\n        if not (len(month_str) == 2 and len(day_str) == 2 and len(year_str) == 4):\n            return None\n\n        month = int(month_str)\n        day = int(day_str)\n        year = int(year_str)\n    except ValueError:\n        return None\n    \n    return DateComponents(month, day, year)\ndef _validate_date_components(components: DateComponents) -> bool:\n    \"\"\"Applies business rules to parsed date components.\"\"\"\n    month = components.month\n    day = components.day\n    # Rule 3: Months should not be less than 1 or higher than 12\n    if not (1 <= month <= 12):\n        return False\n\n    # Rule 2: Days validation based on month\n    days_in_month = {\n        1: 31, 3: 31, 5: 31, 7: 31, 8: 31, 10: 31, 12: 31, # 31-day months\n        4: 30, 6: 30, 9: 30, 11: 30,                      # 30-day months\n        2: 29                                             # February (max 29 as no leap year rule is given)\n    }\n\n    max_days = days_in_month.get(month)\n    if max_days is None: \n        return False # Should not be reached if month is already validated between 1 and 12\n    \n    if not (1 <= day <= max_days):\n        return False\n    \n    return True\ndef valid_date(date):\n    \"\"\"You have to write a function which validates a given date string and\n    returns True if the date is valid otherwise False.\n    The date is valid if all of the following rules are satisfied:\n    1. The date string is not empty.\n    2. The number of days is not less than 1 or higher than 31 days for months 1,3,5,7,8,10,12. And the number of days is not less than 1 or higher than 30 days for months 4,6,9,11. And, the number of days is not less than 1 or higher than 29 for the month 2.\n    3. The months should not be less than 1 or higher than 12.\n    4. The date should be in the format: mm-dd-yyyy\n\n    for example: \n    valid_date('03-11-2000') => True\n\n    valid_date('15-01-2012') => False\n\n    valid_date('04-0-2040') => False\n\n    valid_date('06-04-2020') => True\n\n    valid_date('06/04/2020') => False\n    \"\"\"\n    parsed_components = _parse_date_string(date)\n    if parsed_components is None:\n        return False\n    \n    return _validate_date_components(parsed_components)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/127": [{"task_id": "HumanEval/127", "solution": "def intersection(interval1, interval2):\n    \"\"\"Determines if the length of the intersection of two closed intervals is a prime number.\n    Returns \"YES\" if prime, \"NO\" otherwise (including non-intersecting intervals).\n    \"\"\"\n\n    def is_prime(n):\n        \"\"\"Checks if a given integer n is a prime number.\"\"\"\n        if n <= 1:\n            return False\n        if n == 2:\n            return True\n        if n % 2 == 0:\n            return False\n        i = 3\n        while i * i <= n:\n            if n % i == 0:\n                return False\n            i += 2\n        return True\n\n    start1, end1 = interval1\n    start2, end2 = interval2\n\n    intersection_start = max(start1, start2)\n    intersection_end = min(end1, end2)\n\n    if intersection_start > intersection_end:\n        # No intersection\n        return \"NO\"\n    else:\n        intersection_length = intersection_end - intersection_start + 1\n        if is_prime(intersection_length):\n            return \"YES\"\n        else:\n            return \"NO\"", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[[-1, 1], [0, 4]]], "plus_fail_tests": [[[10, 20], [15, 25]]]}, {"task_id": "HumanEval/127", "solution": "def intersection(interval1, interval2):\n    \"\"\"You are given two intervals,\n    where each interval is a pair of integers. For example, interval = (start, end) = (1, 2).\n    The given intervals are closed which means that the interval (start, end)\n    includes both start and end.\n    For each given interval, it is assumed that its start is less or equal its end.\n    Your task is to determine whether the length of intersection of these two \n    intervals is a prime number.\n    Example, the intersection of the intervals (1, 3), (2, 4) is (2, 3)\n    which its length is 1, which not a prime number.\n    If the length of the intersection is a prime number, return \"YES\",\n    otherwise, return \"NO\".\n    If the two intervals don't intersect, return \"NO\".\n\n\n    [input/output] samples:\n    intersection((1, 2), (2, 3)) ==> \"NO\"\n    intersection((-1, 1), (0, 4)) ==> \"NO\"\n    intersection((-3, -1), (-5, 5)) ==> \"YES\"\n    \"\"\"\n\n    def _is_prime(number: int) -> bool:\n        \"\"\"Checks if a given number is prime. Numbers <= 1 are not prime.\"\"\"\n        if number <= 1:\n            return False\n        if number == 2:\n            return True\n        if number % 2 == 0:\n            return False\n        # Check for odd divisors up to the square root of the number.\n        i = 3\n        while i * i <= number:\n            if number % i == 0:\n                return False\n            i += 2\n        return True\n\n    def _calculate_intersection_interval(interval1_inner: tuple[int, int], interval2_inner: tuple[int, int]) -> tuple[int, int] | None:\n        \"\"\"Calculates the intersection of two intervals, returning None if they don't intersect.\"\"\"\n        start1, end1 = interval1_inner\n        start2, end2 = interval2_inner\n\n        intersection_start = max(start1, start2)\n        intersection_end = min(end1, end2)\n\n        if intersection_start > intersection_end:\n            return None\n        else:\n            return (intersection_start, intersection_end)\n\n    def _calculate_length(interval_start_inner: int, interval_end_inner: int) -> int:\n        \"\"\"Computes the length of a closed interval as (end - start), based on sample behavior.\"\"\"\n        return interval_end_inner - interval_start_inner\n    \n    intersect_interval = _calculate_intersection_interval(interval1, interval2)\n\n    if intersect_interval is None:\n        return \"NO\"\n    \n    intersect_start, intersect_end = intersect_interval\n    length = _calculate_length(intersect_start, intersect_end)\n\n    if _is_prime(length):\n        return \"YES\"\n    else:\n        return \"NO\"", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/94": [{"task_id": "HumanEval/94", "solution": "def skjkasdkd(lst):\n    \"\"\"You are given a list of integers.\n    You need to find the largest prime value and return the sum of its digits.\n    \"\"\"\n\n    class PrimeNumber:\n        \"\"\"Utility class for prime number operations.\"\"\"\n        @staticmethod\n        def is_prime(n: int) -> bool:\n            if n <= 1:\n                return False\n            if n <= 3:\n                return True\n            if n % 2 == 0 or n % 3 == 0:\n                return False\n            i = 5\n            while i * i <= n:\n                if n % i == 0 or n % (i + 2) == 0:\n                    return False\n                i += 6\n            return True\n\n    class DigitSumCalculator:\n        \"\"\"Utility class for calculating the sum of digits of an integer.\"\"\"\n        @staticmethod\n        def sum_digits(n: int) -> int:\n            s = 0\n            num_str = str(abs(n))\n            for digit_char in num_str:\n                s += int(digit_char)\n            return s\n\n    identified_primes = []\n    for number in lst:\n        if PrimeNumber.is_prime(number):\n            identified_primes.append(number)\n\n    largest_prime = 0\n    if identified_primes:\n        largest_prime = max(identified_primes)\n\n    return DigitSumCalculator.sum_digits(largest_prime)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/94", "solution": "def skjkasdkd(lst):\n    \"\"\"You are given a list of integers.\n    You need to find the largest prime value and return the sum of its digits.\n    \"\"\"\n\n    def _is_prime(n: int) -> bool:\n        \"\"\"Checks if a given integer is a prime number.\"\"\"\n        if n <= 1:\n            return False\n        if n <= 3:\n            return True\n        if n % 2 == 0 or n % 3 == 0:\n            return False\n        i = 5\n        while i * i <= n:\n            if n % i == 0 or n % (i + 2) == 0:\n                return False\n            i += 6\n        return True\n\n    def _get_digits_sum(n: int) -> int:\n        \"\"\"Calculates the sum of the individual digits of an integer.\"\"\"\n        if n < 0:\n            n = abs(n)\n        total_sum = 0\n        if n == 0:\n            return 0\n        while n > 0:\n            total_sum += n % 10\n            n //= 10\n        return total_sum\n\n    prime_numbers = []\n    for num in lst:\n        if _is_prime(num):\n            prime_numbers.append(num)\n\n    if not prime_numbers:\n        return 0\n\n    largest_prime = max(prime_numbers)\n    return _get_digits_sum(largest_prime)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/125": [{"task_id": "HumanEval/125", "solution": "def split_words(txt):\n    '''\n    Given a string of words, return a list of words split on whitespace, if no whitespaces exists in the text you\n    should split on commas ',' if no commas exists you should return the number of lower-case letters with odd order in the\n    alphabet, ord('a') = 0, ord('b') = 1, ... ord('z') = 25\n    Examples\n    split_words(\"Hello world!\") \u279e [\"Hello\", \"world!\"]\n    split_words(\"Hello,world!\") \u279e [\"Hello\", \"world!\"]\n    split_words(\"abcdef\") == 3 \n    '''\n    class Character:\n        def __init__(self, char_value: str):\n            self._char_value = char_value\n\n        def is_lowercase(self) -> bool:\n            return 'a' <= self._char_value <= 'z'\n\n        def get_alphabetical_order(self) -> int:\n            if self.is_lowercase():\n                return ord(self._char_value) - ord('a')\n       