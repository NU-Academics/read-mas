vity = 'left'\n            else:\n                # Should not happen given valid input constraint\n                raise ValueError(f\"Unknown operator: {symbol}\")\n\n        def get_symbol(self):\n            return self._symbol\n\n        def get_precedence(self):\n            return self._precedence\n\n        def get_associativity(self):\n            return self._associativity\n\n        def apply(self, val1, val2):\n            if self._symbol == '+':\n                return val1 + val2\n            elif self._symbol == '-':\n                return val1 - val2\n            elif self._symbol == '*':\n                return val1 * val2\n            elif self._symbol == '//':\n                return val1 // val2\n            elif self._symbol == '**':\n                return val1 ** val2\n\n    # Shunting-yard algorithm implementation to evaluate the expression.\n    # This approach converts the infix expression to postfix (RPN) implicitly\n    # or evaluates it directly using two stacks.\n    \n    output_queue = [] # Stores operands and operators in RPN order\n    operator_stack = [] # Stores operators for precedence handling\n\n    # Process operands and operators\n    for i in range(len(operand)):\n        output_queue.append(operand[i])\n        if i < len(operator):\n            current_op = _Operator(operator[i])\n            while (operator_stack and \n                   (operator_stack[-1].get_precedence() > current_op.get_precedence() or\n                   (operator_stack[-1].get_precedence() == current_op.get_precedence() and \n                    current_op.get_associativity() == 'left'))):\n                output_queue.append(operator_stack.pop())\n            operator_stack.append(current_op)\n\n    while operator_stack:\n        output_queue.append(operator_stack.pop())\n\n    # Evaluate the RPN expression\n    evaluation_stack = []\n    for token in output_queue:\n        if isinstance(token, int): # It's an operand\n            evaluation_stack