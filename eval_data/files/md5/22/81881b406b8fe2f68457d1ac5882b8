st_vowel(\"FULL\") ==> \"U\"\n    get_closest_vowel(\"quick\") ==> \"\"\n    get_closest_vowel(\"ab\") ==> \"\"\n    \"\"\"\n    # Iterate from the second to last character down to the second character (index 1).\n    # This excludes characters at the beginning (index 0) and end (index len-1).\n    for i in range(len(word) - 2, 0, -1):\n        current_char = word[i]\n        if _is_vowel(current_char):\n            if _is_consonant(word[i-1]) and _is_consonant(word[i+1]):\n                return current_char\n    return \"\"", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/118", "solution": "def get_closest_vowel(word):\n    \"\"\"Finds the closest vowel that stands between two consonants from the right side of the word.\n    Vowels at the beginning and ending don't count. Returns an empty string if no vowel\n    meets the condition.\"\"\"\n    \n    def _is_vowel(char_input):\n        VOWELS = {'a', 'e', 'i', 'o', 'u', 'A', 'E', 'I', 'O', 'U'}\n        return char_input in VOWELS\n\n    def _is_consonant(char_input):\n        return ('A' <= char_input <= 'Z' or 'a' <= char_input <= 'z') and not _is_vowel(char_input)\n\n    word_length = len(word)\n\n    if word_length < 3:\n        return \"\"\n\n    for i in range(word_length - 2, 0, -1):\n        current_char = word[i]\n        left_char = word[i - 1]\n        right_char = word[i + 1]\n\n        if _is_vowel(current_char) and \\\n           _is_consonant(left_char) and \\\n           _is_consonant(right_char):\n            return current_char\n\n    return \"\"", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/117": [{"task_id": "HumanEval/117", "solution": "def select_words(s, n):\n    \"\"\"Given a string s and a natural number n, this function returns a list of words from s\n    that contain exactly n consonants, preserving their original order.\n    \"\"\"\n    VOWELS_SET = {'a', 'e',