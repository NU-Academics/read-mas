            self._value = value\n\n        def is_positive(self) -> bool:\n            return self._value > 0\n\n        def is_odd(self) -> bool:\n            return self._value % 2 != 0\n\n        def is_even(self) -> bool:\n            return self._value % 2 == 0\n\n        def half(self) -> 'Integer':\n            return Integer(self._value // 2)\n\n        def three_n_plus_one(self) -> 'Integer':\n            return Integer(3 * self._value + 1)\n\n        def get_value(self) -> int:\n            return self._value\n\n        def __eq__(self, other: object) -> bool:\n            if isinstance(other, Integer):\n                return self._value == other._value\n            return self._value == other\n\n        def __lt__(self, other: object) -> bool:\n            if isinstance(other, Integer):\n                return self._value < other._value\n            return self._value < other\n\n        def __hash__(self) -> int:\n            return hash(self._value)\n\n    class CollatzSequenceGenerator:\n        \"\"\"Generates the complete Collatz sequence for a given starting Integer.\"\"\"\n        def generate(self, start: Integer) -> list[Integer]:\n            sequence = [start]\n            current = start\n            while current != 1:\n                if current.is_even():\n                    current = current.half()\n                else:\n                    current = current.three_n_plus_one()\n                sequence.append(current)\n            return sequence\n\n    class OddNumberExtractor:\n        \"\"\"Filters a list of Integer objects, returning only the odd ones.\"\"\"\n        def extract(self, sequence: list[Integer]) -> list[Integer]:\n            return [num for num in sequence if num.is_odd()]\n\n    class ListSorter:\n        \"\"\"Sorts a list of Integer objects in increasing order.\"\"\"\n        def sort_ascending(self, numbers: list[Integer]) -> list[Integer]:\n            return sorted(numbers)\n\n    if not isinstance(n, int) or n <