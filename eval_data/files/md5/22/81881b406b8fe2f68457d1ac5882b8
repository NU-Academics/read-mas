n    solve(\"ab\") = \"AB\"\n    solve(\"#a@C\") = \"#A@c\"\n    \"\"\"\n\n    def _has_letters(s: str) -> bool:\n        \"\"\"Checks if the string contains any alphabetic characters.\n        Returns True if a letter is found, False otherwise.\"\"\"\n        for char in s:\n            if char.isalpha():\n                return True\n        return False\n\n    def _reverse_case_char(char: str) -> str:\n        \"\"\"Reverses the case of a single alphabetic character.\n        Assumes the input character is an alphabet.\"\"\"\n        if char.islower():\n            return char.upper()\n        else: \n            return char.lower()\n\n    def _process_string_with_letters(s: str) -> str:\n        \"\"\"Processes a string by reversing letter cases and keeping non-letters as is.\n        This function is used when the string is known to contain letters.\"\"\"\n        processed_chars = []\n        for char in s:\n            if char.isalpha():\n                processed_chars.append(_reverse_case_char(char))\n            else:\n                processed_chars.append(char)\n        return \"\".join(processed_chars)\n\n    def _reverse_string(s: str) -> str:\n        \"\"\"Reverses the entire input string.\n        This function is used when the string contains no letters.\"\"\"\n        return \"\".join(reversed(s))\n\n    if not _has_letters(s):\n        return _reverse_string(s)\n    else:\n        return _process_string_with_letters(s)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/83": [{"task_id": "HumanEval/83", "solution": "def starts_one_ends(n):\n    \"\"\"\n    Given a positive integer n, return the count of the numbers of n-digit\n    positive integers that start or end with 1.\n    \"\"\"\n    if n <= 0:\n        raise ValueError(\"Input 'n' must be a positive integer.\")\n\n    if n == 1:\n        return 1\n\n    def _count_starts_with_one(n_val):\n        \"\"\"Calculates count of n-digit numb