t(num):\n        \"\"\"Returns the first digit of a number (e.g., 15 -> 1, -73 -> 7).\"\"\"\n        return int(str(abs(num))[0])\n\n    def _get_last_digit(num):\n        \"\"\"Returns the last digit of a number (e.g., 15 -> 5, -73 -> 3).\"\"\"\n        return abs(num) % 10\n\n    def _is_odd(digit):\n        \"\"\"Checks if a digit is odd (1, 3, 5, 7, 9).\"\"\"\n        return digit % 2 != 0\n\n    def _is_greater_than_ten(num):\n        \"\"\"Checks if a number is strictly greater than 10.\"\"\"\n        return num > 10\n\n    def _has_odd_first_digit(num):\n        \"\"\"Checks if the first digit of a number is odd.\"\"\"\n        first_digit = _get_first_digit(num)\n        return _is_odd(first_digit)\n\n    def _has_odd_last_digit(num):\n        \"\"\"Checks if the last digit of a number is odd.\"\"\"\n        last_digit = _get_last_digit(num)\n        return _is_odd(last_digit)\n\n    def _is_special(num):\n        \"\"\"Determines if a number is 'special' based on all criteria.\"\"\"\n        return _is_greater_than_ten(num) and _has_odd_first_digit(num) and _has_odd_last_digit(num)\n\n    count = 0\n    for num in nums:\n        if _is_special(num):\n            count += 1\n    return count", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/129": [{"task_id": "HumanEval/129", "solution": "def minPath(grid, k):\n    \"\"\"\n    Given a grid with N rows and N columns (N >= 2) and a positive integer k, \n    each cell of the grid contains a value. Every integer in the range [1, N * N]\n    inclusive appears exactly once on the cells of the grid.\n\n    You have to find the minimum path of length k in the grid. You can start\n    from any cell, and in each step you can move to any of the neighbor cells,\n    in other words, you can go to cells which share an edge with you current\n    cell.\n    Please note that a path of length k means visiting exactly k cells (not\n    necessarily distinct).\n    You CANNOT go off the grid.\n    A path A (of length k) is considered less than a path B (of length k) if\n    after making the ordered lists of the values on the cells that A and B go\n    through (let's call them lst_A and lst_B), lst_A is lexicographically less\n    than lst_B, in other words, there exist an integer index i (1 <= i <= k)\n    such that lst_A[i] < lst_B[i] and for any j (1 <= j < i) we have\n    lst_A[j] = lst_B[j].\n    It is guaranteed that the answer is unique.\n    Return an ordered list of the values on the cells that the minimum path go through.\n\n    Examples:\n\n        Input: grid = [ [1,2,3], [4,5,6], [7,8,9]], k = 3\n        Output: [1, 2, 1]\n\n        Input: grid = [ [5,9,3], [4,1,6], [7,8,2]], k = 1\n        Output: [1]\n    \"\"\"\n\n    class Cell:\n        \"\"\"Represents a single cell in the grid with its coordinates and value.\"\"\"\n        def __init__(self, row: int, col: int, value: int):\n            self.row = row\n            self.col = col\n            self.value = value\n\n        def __eq__(self, other):\n            if not isinstance(other, Cell):\n                return NotImplemented\n            return self.row == other.row and self.col == other.col and self.value == other.value\n\n        def __hash__(self):\n            return hash((self.row, self.col, self.value))\n\n        def __repr__(self):\n            return f\"Cell(r={self.row}, c={self.col}, val={self.value})\"\n\n    class Grid:\n        \"\"\"Represents the N x N grid, providing access to individual cells and grid dimensions.\"\"\"\n        def __init__(self, raw_grid_data: list[list[int]]):\n            self.N = len(raw_grid_data)\n            self.cells = [[None for _ in range(self.N)] for _ in range(self.N)]\n            for r in range(self.N):\n                for c in range(self.N):\n                    self.cells[r][c] = Cell(r, c, raw_grid_data[r][c])\n\n        def get_cell(self, row: int, col: int) -> Cell:\n            return self.cells[row][col]\n\n        def is_valid_coordinate(self, row: int, col: int) -> bool:\n            return 0 <= row < self.N and 0 <= col < self.N\n\n    class Path:\n        \"\"\"Represents an ordered sequence of visited cells and provides lexicographical comparison logic.\"\"\"\n        def __init__(self, cells: list[Cell]):\n            self.visited_cells = cells\n            self.values = [cell.value for cell in cells]\n\n        def get_values(self) -> list[int]:\n            return self.values\n\n        def is_lexicographically_smaller(self, other_path: 'Path') -> bool:\n            return self.values < other_path.values\n\n        def __lt__(self, other: 'Path') -> bool:\n            return self.is_lexicographically_smaller(other)\n\n        def __repr__(self):\n            return f\"Path(values={self.values})\"\n\n    def validate_grid(grid_data: list[list[int]]) -> None:\n        \"\"\"Validates the input grid dimensions, values, and uniqueness.\"\"\"\n        N = len(grid_data)\n        if N < 2:\n            raise ValueError(\"Grid dimension N must be at least 2.\")\n        \n        for row in grid_data:\n            if len(row) != N:\n                raise ValueError(\"Grid must be square (N x N).\")\n        \n        expected_values = set(range(1, N * N + 1))\n        found_values = set()\n        for r in range(N):\n            for c in range(N):\n                val = grid_data[r][c]\n                if not isinstance(val, int):\n                    raise ValueError(\"Grid cells must contain integers.\")\n                if val < 1 or val > N * N:\n                    raise ValueError(f\"Grid cell value {val} is out of range [1, {N*N}].\")\n                if val in found_values:\n                    raise ValueError(f\"Duplicate value {val} found in grid.\")\n                found_values.add(val)\n        \n        if found_values != expected_values:\n            raise ValueError(\"Grid values do not contain all integers from 1 to N*N exactly once.\")\n\n    def validate_k(k_val: int) -> None:\n        \"\"\"Validates that k is a positive integer.\"\"\"\n        if not isinstance(k_val, int) or k_val <= 0:\n            raise ValueError(\"Path length k must be a positive integer.\")\n\n    def _get_neighbors(grid_obj: Grid, cell: Cell) -> list[Cell]:\n        \"\"\"Returns a list of valid neighboring Cell objects for a given cell.\"\"\"\n        neighbors = []\n        directions = [(0, 1), (0, -1), (1, 0), (-1, 0)]  # Right, Left, Down, Up\n        for dr, dc in directions:\n            nr, nc = cell.row + dr, cell.col + dc\n            if grid_obj.is_valid_coordinate(nr, nc):\n                neighbors.append(grid_obj.get_cell(nr, nc))\n        return neighbors\n\n    def _find_all_paths_dfs(grid_obj: Grid, current_cell: Cell, target_k: int,\n                            current_path_cells: list[Cell], all_paths: list[Path]) -> None:\n        \"\"\"Recursively explores paths of length k using Depth-First Search.\"\"\"\n        if len(current_path_cells) == target_k:\n            all_paths.append(Path(list(current_path_cells))) # Create a new Path instance\n            return\n\n        for neighbor in _get_neighbors(grid_obj, current_cell):\n            current_path_cells.append(neighbor)\n            _find_all_paths_dfs(grid_obj, neighbor, target_k, current_path_cells, all_paths)\n            current_path_cells.pop() # Backtrack\n\n    # --- Main minPath function logic ---\n    validate_grid(grid)\n    validate_k(k)\n\n    grid_obj = Grid(grid)\n    all_paths: list[Path] = []\n\n    # Iterate through all possible starting cells\n    for r_start in range(grid_obj.N):\n        for c_start in range(grid_obj.N):\n            start_cell = grid_obj.get_cell(r_start, c_start)\n            # Start DFS for paths of length k from each cell\n            _find_all_paths_dfs(grid_obj, start_cell, k, [start_cell], all_paths)\n\n    min_path: Path | None = None\n    if not all_paths:\n        # This case should not happen based on problem constraints (N >= 2, k >= 1)\n        # and guaranteed unique answer, implying a path always exists.\n        return [] \n    \n    # Find the lexicographically smallest path\n    min_path = all_paths[0]\n    for path in all_paths:\n        if path < min_path:\n            min_path = path\n\n    return min_path.get_values()", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[[[12, 13, 10, 1], [9, 3, 15, 6], [5, 16, 14, 4], [11, 8, 7, 2]], 12]], "plus_fail_tests": [[[[1, 2, 3], [4, 5, 6], [7, 8, 9]], 15]]}, {"task_id": "HumanEval/129", "solution": "def minPath(grid, k):\n    \"\"\"\n    Given a grid with N rows and N columns (N >= 2) and a positive integer k, \n    each cell of the grid contains a value. Every integer in the range [1, N * N]\n    inclusive appears exactly once on the cells of the grid.\n\n    You have to find the minimum path of length k in the grid. You can start\n    from any cell, and in each step you can move to any of the neighbor cells,\n    in other words, you can go to cells which share an edge with you current\n    cell.\n    Please note that a path of length k means visiting exactly k cells (not\n    necessarily distinct).\n    You CANNOT go off the grid.\n    A path A (of length k) is considered less than a path B (of length k) if\n    after making the ordered lists of the values on the cells that A and B go\n    through (let's call them lst_A and lst_B), lst_A is lexicographically less\n    than lst_B, in other words, there exist an integer index i (1 <= i <= k)\n    such that lst_A[i] < lst_B[i] and for any j (1 <= j < i) we have\n    lst_A[j] = lst_B[j].\n    It is guaranteed that the answer is unique.\n    Return an ordered list of the values on the cells that the minimum path go through.\n\n    Examples:\n\n        Input: grid = [ [1,2,3], [4,5,6], [7,8,9]], k = 3\n        Output: [1, 2, 1]\n\n        Input: grid = [ [5,9,3], [4,1,6], [7,8,2]], k = 1\n        Output: [1]\n    \"\"\"\n\n    def _validate_input(grid_data, k):\n        N = len(grid_data)\n\n        if N < 2:\n            raise ValueError(\"Grid dimension N must be at least 2.\")\n\n        for row in grid_data:\n            if len(row) != N:\n                raise ValueError(\"Grid must be square (N x N).\")\n\n        if k <= 0:\n            raise ValueError(\"Path length k must be a positive integer.\")\n\n        seen_values = set()\n        total_cells = N * N\n        for r in range(N):\n            for c in range(N):\n                value = grid_data[r][c]\n                if not (1 <= value <= total_cells):\n                    raise ValueError(f\"Cell value {value} is out of range [1, {total_cells}].\")\n                if value in seen_values:\n                    raise ValueError(f\"Duplicate cell value {value} found.\")\n                seen_values.add(value)\n        if len(seen_values) != total_cells:\n            raise ValueError(\"Not all integers from 1 to N*N appear exactly once.\")\n\n    class Cell:\n        def __init__(self, row: int, col: int, value: int):\n            self._row = row\n            self._col = col\n            self._value = value\n\n        def get_row(self) -> int:\n            return self._row\n\n        def get_col(self) -> int:\n            return self._col\n\n        def get_value(self) -> int:\n            return self._value\n\n        def __eq__(self, other: object) -> bool:\n            if not isinstance(other, Cell):\n                return NotImplemented\n            return self._row == other._row and self._col == other._col\n\n        def __hash__(self) -> int:\n            return hash((self._row, self._col))\n\n    class Grid:\n        def __init__(self, grid_data: list[list[int]]):\n            self._N = len(grid_data)\n            self._cells: list[list[Cell]] = [[None for _ in range(self._N)] for _ in range(self._N)]\n            for r in range(self._N):\n                for c in range(self._N):\n                    self._cells[r][c] = Cell(r, c, grid_data[r][c])\n\n        def get_N(self) -> int:\n            return self._N\n\n        def get_cell(self, row: int, col: int) -> Cell:\n            return self._cells[row][col]\n\n        def is_valid_coordinate(self, row: int, col: int) -> bool:\n            return 0 <= row < self._N and 0 <= col < self._N\n\n        def get_neighbors(self, cell: Cell) -> list[Cell]:\n            neighbors = []\n            row, col = cell.get_row(), cell.get_col()\n            dr = [-1, 1, 0, 0] # Row changes for (Up, Down, Left, Right)\n            dc = [0, 0, -1, 1] # Column changes for (Up, Down, Left, Right)\n\n            for i in range(4):\n                new_row, new_col = row + dr[i], col + dc[i]\n                if self.is_valid_coordinate(new_row, new_col):\n                    neighbors.append(self.get_cell(new_row, new_col))\n            return neighbors\n\n    class Path:\n        def __init__(self, length_k: int, initial_values_list: list[int] = None):\n            self._cell_values: list[int] = initial_values_list if initial_values_list is not None else []\n            self._length_k = length_k\n\n        def add_cell_value(self, value: int) -> None:\n            self._cell_values.append(value)\n\n        def remove_last_value(self) -> None:\n            if self._cell_values:\n                self._cell_values.pop()\n\n        def get_values(self) -> list[int]:\n            return self._cell_values\n\n        def get_current_length(self) -> int:\n            return len(self._cell_values)\n\n        def is_complete(self) -> bool:\n            return self.get_current_length() == self._length_k\n\n        def __lt__(self, other: 'Path') -> bool:\n            # Lexicographically compares two paths based on their cell values.\n            if not isinstance(other, Path):\n                return NotImplemented\n            return self._cell_values < other._cell_values\n\n        def __eq__(self, other: object) -> bool:\n            if not isinstance(other, Path):\n               