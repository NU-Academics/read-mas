hat returns true if the given number is the multiplication of 3 prime numbers\n    and false otherwise.\n    Knowing that (a) is less then 100. \n    Example:\n    is_multiply_prime(30) == True\n    30 = 2 * 3 * 5\n    \"\"\"\n    if a >= 100:\n        return False\n\n    def _is_prime(n):\n        if n < 2:\n            return False\n        for i in range(2, int(n**0.5) + 1):\n            if n % i == 0:\n                return False\n        return True\n\n    def _get_prime_factors(n):\n        factors = []\n        d = 2\n        temp_n = n\n        while d * d <= temp_n:\n            if temp_n % d == 0:\n                factors.append(d)\n                temp_n //= d\n            else:\n                d += 1\n        if temp_n > 1:\n            factors.append(temp_n)\n        return factors\n\n    prime_factors = _get_prime_factors(a)\n    distinct_prime_factors = set(prime_factors)\n\n    if len(distinct_prime_factors) == 3:\n        # Check if all elements in prime_factors are actually prime,\n        # which _get_prime_factors already ensures.\n        # This check confirms that the factors are distinct and prime.\n        # For a number less than 100, if it has 3 distinct prime factors,\n        # these factors must be small primes (e.g., 2, 3, 5).\n        # We also need to confirm that their product is exactly 'a',\n        # not just that 'a' contains them as factors along with duplicates.\n        \n        # If a is a product of 3 distinct prime numbers,\n        # then len(prime_factors) must also be 3 and all elements must be distinct.\n        # e.g., 30 = 2*3*5. prime_factors = [2,3,5]. distinct_prime_factors = {2,3,5}. len = 3.\n        # e.g., 12 = 2*2*3. prime_factors = [2,2,3]. distinct_prime_factors = {2,3}. len = 2. -> False\n        return len(prime_factors) == 3\n    else:\n        return False", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[8]], "plus_fail_tests": [[99]]}], "HumanEval/76": [{"task_id": "HumanEval/76",