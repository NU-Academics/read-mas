{"task_id": "Mbpp/440", "solution": "import re\nfrom typing import Optional, Tuple\n\ndef find_adverb_position(sentence: str) -> Optional[Tuple[int, int, str]]:\n    \"\"\"\n    Finds the first adverb and its position in a given sentence.\n    An adverb is defined as an alphabetic word ending in \"ly\", case-insensitive.\n    Returns a tuple (start_index, end_index, adverb_text) or None if no match.\n    \"\"\"\n    if not isinstance(sentence, str):\n        raise TypeError(\"sentence must be a str\")\n    if sentence.strip() == \"\":\n        return None\n\n    pattern = r\"\\b([A-Za-z]+ly)\\b\"\n    match = re.search(pattern, sentence, re.IGNORECASE)\n\n    if match:\n        start, end = match.span(1)\n        adverb_text = match.group(1)\n        return (start, end, adverb_text)\n    else:\n        return None"}
{"task_id": "Mbpp/446", "solution": "def count_Occurrence(items_list: list, haystack_tuple: tuple) -> dict:\n    \"\"\"Counts occurrences of unique elements from items_list within haystack_tuple.\n    Returns a dictionary mapping each unique item to its count.\n    \"\"\"\n    if not isinstance(items_list, list) or not isinstance(haystack_tuple, tuple):\n        raise TypeError(\"count_Occurrence expects (list, tuple)\")\n\n    if len(items_list) == 0:\n        return {}\n\n    # Initialize counts for all unique elements in items_list to 0.\n    occurrence_map = {item: 0 for item in set(items_list)}\n\n    # Iterate through the tuple and increment counts for matching items.\n    for item in haystack_tuple:\n        if item in occurrence_map:\n            occurrence_map[item] += 1\n\n    return occurrence_map"}
{"task_id": "Mbpp/447", "solution": "from typing import List\n\ndef cube_nums(numbers: List[float]) -> List[float]:\n    \"\"\"Compute the cube of each numeric element in a list.\n\n    Raises TypeError if input is not a list or contains non-int/float elements.\n    \"\"\"\n    if not isinstance(numbers, list):\n        raise TypeError(\"numbers must be a list\")\n    result: List[float] = []\n    for x in numbers:\n        if not isinstance(x, (int, float)):\n            raise TypeError(\"all elements of numbers must be int or float\")\n        result.append(x ** 3)\n    return result"}
{"task_id": "Mbpp/450", "solution": "def extract_string(strings, size):\n    \"\"\"\n    Return a list of strings from `strings` whose length equals `size`.\n\n    Raises:\n        TypeError: if `size` is not int, if `strings` is not iterable, or if any element is not str.\n        ValueError: if `size` is negative.\n    \"\"\"\n    if not isinstance(size, int):\n        raise TypeError(\"size must be an int\")\n    if size < 0:\n        raise ValueError(\"size must be non-negative\")\n\n    try:\n        iterator = iter(strings)\n    except TypeError:\n        raise TypeError(\"strings must be an iterable of str\")\n\n    result = []\n    for s in iterator:\n        if not isinstance(s, str):\n            raise TypeError(\"all elements of strings must be str\")\n        if len(s) == size:\n            result.append(s)\n    return result"}
{"task_id": "Mbpp/448", "solution": "def cal_sum(n: int) -> int:\n    \"\"\"\n    Calculates the inclusive sum of Perrin numbers P(0) through P(n).\n\n    The Perrin sequence starts with P(0)=3, P(1)=0, P(2)=2, and P(n) = P(n-2) + P(n-3) for n >= 3.\n\n    Args:\n        n (int): The non-negative integer index up to which Perrin numbers are summed.\n\n    Returns:\n        int: The sum S(n) = sum_{i=0..n} P(i).\n\n    Raises:\n        TypeError: If n is not an int.\n        ValueError: If n is negative.\n\n    Complexity:\n        Time: O(n)\n        Auxiliary Space: O(1)\n\n    Examples:\n        >>> cal_sum(0)\n        3\n        >>> cal_sum(1)\n        3\n        >>> cal_sum(2)\n        5\n        >>> cal_sum(3)\n        8\n        >>> cal_sum(9)\n        49\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an int\")\n    if n < 0:\n        raise ValueError(\"n must be non-negative\")\n\n    if n == 0:\n        return 3\n    if n == 1:\n        return 3\n    if n == 2:\n        return 5\n\n    # Initialize rolling Perrin numbers P(i-3), P(i-2), P(i-1)\n    # For i=3, these correspond to P(0), P(1), P(2)\n    p_prev3, p_prev2, p_prev1 = 3, 0, 2\n\n    # Initialize sum with the sum of P(0), P(1), P(2)\n    current_sum = p_prev3 + p_prev2 + p_prev1\n\n    # Iterate from i=3 up to n to calculate subsequent Perrin numbers and add to sum\n    for _ in range(3, n + 1):\n        p_current = p_prev3 + p_prev2  # P(i) = P(i-3) + P(i-2)\n        current_sum += p_current\n        # Roll the values for the next iteration: P(i-2), P(i-1), P(i)\n        p_prev3, p_prev2, p_prev1 = p_prev2, p_prev1, p_current\n\n    return current_sum"}
{"task_id": "Mbpp/451", "solution": "from typing import Any\n\ndef remove_whitespaces(s: str) -> str:\n    \"\"\"\n    Removes all Unicode whitespace characters from the given string.\n\n    Parameters:\n        s: str - The input string from which to remove whitespaces.\n                 Must be a Python str; otherwise, a TypeError is raised.\n\n    Returns:\n        str - A new string with all characters for which str.isspace()\n              returns True removed, preserving the order of non-whitespace\n              characters.\n\n    Raises:\n        TypeError: If 's' is not a string.\n\n    Complexity:\n        Time: O(n) where n is the length of the input string 's'.\n        Space: O(n) additional worst-case, for the buffer and final string.\n\n    Unicode whitespace definition:\n        Uses Python's built-in str.isspace(), which returns True for\n        characters Unicode classifies with the White_Space property.\n\n    Examples:\n        >>> remove_whitespaces('a b\\\\t c\\\\n')\n        'abc'\n        >>> remove_whitespaces('a\\\\u00A0b\\\\u2009c')\n        'abc'\n    \"\"\"\n    if not isinstance(s, str):\n        raise TypeError(\"s must be str\")\n\n    buffer: list[str] = []\n    for ch in s:\n        if not ch.isspace():\n            buffer.append(ch)\n    return \"\".join(buffer)"}
{"task_id": "Mbpp/454", "solution": "import re\n\ndef text_match_wordz(input_string):\n    \"\"\"\n    Checks if the input string contains at least one word with the letter 'z' (case-insensitive).\n    Returns True on the first match, False otherwise, including for empty or whitespace-only inputs.\n    \"\"\"\n    if not input_string or not input_string.strip():\n        return False\n\n    # Preferred regex pattern: (?i) for inline case-insensitive, \\b for word boundaries, \\w for word characters.\n    # \\w*z\\w* matches any word containing 'z'.\n    pattern = r'(?i)\\b\\w*z\\w*\\b'\n\n    # Perform a regex search with UNICODE flag for proper \\b and \\w behavior across different languages.\n    match = re.search(pattern, input_string, re.UNICODE)\n\n    return match is not None"}
{"task_id": "Mbpp/453", "solution": "import math\n\ndef sumofFactors(n: int) -> int:\n    \"\"\"\n    Compute the sum of even positive divisors of abs(n).\n    Returns 0 if abs(n) has no even positive divisors.\n    \"\"\"\n    abs_n = abs(n)\n\n    # Optimization: if abs_n is odd, it has no even factors.\n    if abs_n % 2 == 1:\n        return 0\n\n    acc = 0\n    limit = math.isqrt(abs_n)\n\n    for i in range(1, limit + 1):\n        if abs_n % i == 0:\n            d1 = i\n            d2 = abs_n // i\n\n            if d1 % 2 == 0:\n                acc += d1\n            if d2 != d1 and d2 % 2 == 0:\n                acc += d2\n    return acc"}
{"task_id": "Mbpp/455", "solution": "MONTHS_31 = (1, 3, 5, 7, 8, 10, 12)\n\ndef check_monthnumb_number(month):\n    \"\"\"Checks if the given month number contains 31 days.\n\n    Purpose: Determines whether an integer month number (1-12) corresponds to a month with 31 days.\n    Inputs: month (int) - The numerical representation of a month. Must be an integer within the range [1, 12].\n    Outputs: bool - True if the month has 31 days, False otherwise. Raises TypeError for non-integer inputs, ValueError for out-of-range integers.\n    Behavior: First, validates if the input is an integer. Second, checks if the integer is within the valid month range [1, 12]. Finally, performs an O(1) membership check against a predefined set of 31-day months.\n    Examples: check_monthnumb_number(1)==True, check_monthnumb_number(2)==False, check_monthnumb_number(7)==True, check_monthnumb_number(12)==True. check_monthnumb_number(0) raises ValueError. check_monthnumb_number('3') raises TypeError.\n    Edge cases: Month 1 (January) returns True. Month 12 (December) returns True. Non-integer inputs (e.g., 3.0, \"3\", None) raise TypeError. Integers outside 1-12 (e.g., 0, 13, -1) raise ValueError.\n    Implementation notes: This pure function uses a module-level constant tuple for O(1) lookup. It operates in O(1) time and O(1) additional space, compatible with Python 3.6+.\n    \"\"\"\n    if not isinstance(month, int):\n        raise TypeError(\"Month number must be an integer.\")\n    if not (1 <= month <= 12):\n        raise ValueError(\"Month number must be between 1 and 12, inclusive.\")\n    return month in MONTHS_31"}
