{"task_id": "Mbpp/457", "solution": "from typing import List, Any, Optional\n\ndef Find_Min(sublists: List[List[Any]]) -> Optional[List[Any]]:\n    \"\"\"\n    Finds the sublist with the minimum length from a list of sublists.\n    Raises TypeError if input is not a list of lists. Returns None for an empty input list.\n    \"\"\"\n\n    def validate_input(sublists_arg: Any) -> None:\n        \"\"\"Validates that the input is a list of lists, raising TypeError for invalid types.\"\"\"\n        if not isinstance(sublists_arg, list):\n            raise TypeError(\"Input 'sublists' must be a list.\")\n        for i, sublist_item in enumerate(sublists_arg):\n            if not isinstance(sublist_item, list):\n                raise TypeError(f\"Element at index {i} is not a list.\")\n\n    def find_min_single_pass(sublists_arg: List[List[Any]]) -> List[Any]:\n        \"\"\"Implements the single-pass algorithm to find the minimum length sublist.\"\"\"\n        current_min_sublist = sublists_arg[0]\n        current_min_length = len(current_min_sublist)\n\n        # Single-pass: iterate once, track current_min_sublist and its length; update only for strictly shorter sublists to preserve first-occurrence tie-break.\n        for sublist_item in sublists_arg[1:]:\n            if len(sublist_item) < current_min_length:\n                current_min_length = len(sublist_item)\n                current_min_sublist = sublist_item\n        return current_min_sublist\n\n    validate_input(sublists)\n\n    if not sublists:\n        return None\n\n    return find_min_single_pass(sublists)"}
{"task_id": "Mbpp/459", "solution": "def remove_uppercase(s: str) -> str:\n    \"\"\"Return a new string with all ASCII uppercase runs ('A'..'Z') removed.\n    This function processes the string in a single pass for efficiency.\n    \"\"\"\n    n = len(s)\n    i = 0\n    buf = []\n    while i < n:\n        c = s[i]\n        if 'A' <= c <= 'Z':\n            # Skip entire contiguous uppercase run\n            while i < n and 'A' <= s[i] <= 'Z':\n                i += 1\n        else:\n            # Append non-uppercase character\n            buf.append(c)\n            i += 1\n    return ''.join(buf)"}
