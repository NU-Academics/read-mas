{"task_id": "Mbpp/123", "solution": "def amicable_numbers_sum(n: int) -> int:\n    \"\"\"Calculates the sum of all amicable numbers up to n.\n    It uses a sieve method to precompute divisor sums for efficiency.\n    \"\"\"\n    if not isinstance(n, int) or n < 1:\n        raise ValueError(\"n must be an integer >= 1\")\n    if n == 1:\n        return 0\n\n    # sum_divisors[i] will store the sum of proper divisors of i.\n    sum_divisors = [0] * (n + 1)\n\n    # Sieve to compute the sum of proper divisors for each number.\n    for d in range(1, n // 2 + 1):\n        for m in range(2 * d, n + 1, d):\n            sum_divisors[m] += d\n\n    total_amicable_sum = 0\n    # Use ordering a < b to count each amicable pair once.\n    for a in range(2, n + 1):\n        b = sum_divisors[a]\n        if b > a and b <= n and sum_divisors[b] == a:\n            total_amicable_sum += a + b\n\n    return total_amicable_sum"}
{"task_id": "Mbpp/125", "solution": "def find_length(s: str) -> int:\n    \"\"\"\n    Finds the maximum difference between the number of 0s and 1s in any substring.\n    Applies Kadane's algorithm on a mapped array where '0' -> +1 and '1' -> -1.\n    \"\"\"\n    if not s:\n        return 0\n\n    # Initialize max_so_far and current_max with the mapped value of the first character.\n    # This correctly handles cases where all elements are negative (e.g., all '1's).\n    first_val = 1 if s[0] == '0' else -1\n    max_so_far = first_val\n    current_max = first_val\n\n    # Iterate through the string starting from the second character\n    for i in range(1, len(s)):\n        value = 1 if s[i] == '0' else -1\n        current_max = max(value, current_max + value)\n        max_so_far = max(max_so_far, current_max)\n\n    return max_so_far"}
{"task_id": "Mbpp/126", "solution": "def sum(a: int, b: int) -> int:\n    \"\"\"\n    Return the sum of positive common divisors of two integers.\n\n    Raises:\n        TypeError: if either argument is not an int.\n        ValueError: if both arguments are zero (undefined).\n    \"\"\"\n    if not isinstance(a, int) or not isinstance(b, int):\n        raise TypeError(\"Both inputs must be integers\")\n\n    a_abs = abs(a)\n    b_abs = abs(b)\n\n    from math import gcd, isqrt\n\n    g = gcd(a_abs, b_abs)\n    if g == 0:\n        raise ValueError(\"sum of common divisors undefined for (0, 0)\")\n\n    total = 0\n    r = isqrt(g)\n    for i in range(1, r + 1):\n        if g % i == 0:\n            total += i\n            j = g // i\n            if j != i:\n                total += j\n    return total"}
{"task_id": "Mbpp/124", "solution": "import math\nimport cmath\n\ndef angle_complex(*args) -> float:\n    \"\"\"Calculates the angle (argument/phase) of a complex number in radians.\n    It supports one or two arguments and normalizes the output to (-pi, pi].\"\"\"\n\n    def _coerce_to_float(arg, arg_name=\"argument\"):\n        try:\n            return float(arg)\n        except (ValueError, TypeError) as e:\n            raise TypeError(f\"cannot convert {arg_name} to float: {arg!r}\") from e\n\n    def _coerce_to_complex(arg, arg_name=\"argument\"):\n        try:\n            return complex(arg)\n        except (ValueError, TypeError) as e:\n            raise TypeError(f\"cannot convert {arg_name} to complex: {arg!r}\") from e\n\n    def _get_phase_from_complex(z_val: complex) -> float:\n        # Zero handling for complex(0,0)\n        if z_val.real == 0.0 and z_val.imag == 0.0:\n            return 0.0\n\n        result = cmath.phase(z_val)\n\n        # Range normalization (-pi, pi]\n        if result == -math.pi:\n            return math.pi\n        return result\n\n    def _get_phase_from_re_im(re_val: float, im_val: float) -> float:\n        # Zero handling for real(0,0)\n        if re_val == 0.0 and im_val == 0.0:\n            return 0.0\n\n        result = math.atan2(im_val, re_val)\n\n        # Range normalization (-pi, pi]\n        if result == -math.pi:\n            return math.pi\n        return result\n\n    # Arity validation\n    if len(args) == 1:\n        arg = args[0]\n        z = _coerce_to_complex(arg, \"single argument\")\n        return _get_phase_from_complex(z)\n\n    elif len(args) == 2:\n        arg1, arg2 = args[0], args[1]\n\n        # Check if both arguments are coercible to float without error\n        is_arg1_float_coercible = False\n        try:\n            float(arg1)\n            is_arg1_float_coercible = True\n        except (ValueError, TypeError):\n            pass\n\n        is_arg2_float_coercible = False\n        try:\n            float(arg2)\n            is_arg2_float_coercible = True\n        except (ValueError, TypeError):\n            pass\n\n        if is_arg1_float_coercible and is_arg2_float_coercible:\n            # Two-argument behavior, both real types\n            re = _coerce_to_float(arg1, \"first argument (real part)\")\n            im = _coerce_to_float(arg2, \"second argument (imaginary part)\")\n            return _get_phase_from_re_im(re, im)\n        else:\n            # Two-argument behavior, one or both complex or not both plain-real\n            z1 = _coerce_to_complex(arg1, \"first argument\")\n            z2 = _coerce_to_complex(arg2, \"second argument\")\n            combined_z = z1 + z2\n            return _get_phase_from_complex(combined_z)\n    else:\n        raise TypeError(f\"angle_complex() takes 1 or 2 positional arguments but {len(args)} were given\")"}
{"task_id": "Mbpp/130", "solution": "def max_occurrences(items):\n    \"\"\"Finds the item with maximum frequency, using earliest appearance for ties.\n    Raises TypeError if input is not iterable or contains unhashable elements.\n    \"\"\"\n    try:\n        # Validate that items is iterable as required by the design.\n        iterator = iter(items)\n    except TypeError:\n        raise TypeError(f\"'{type(items).__name__}' object is not iterable\")\n\n    counts = {}\n    first_seen = {}\n    index = 0\n\n    for element in iterator:\n        # Hashability check for `element` happens implicitly when used as a dict key.\n        # If `element` is unhashable, a TypeError will be raised and propagated here.\n        if element not in counts:\n            counts[element] = 1\n            first_seen[element] = index\n        else:\n            counts[element] += 1\n        index += 1\n\n    # Return None if no items were processed, as per design.\n    if index == 0:\n        return None\n\n    # Compute the maximum frequency found.\n    max_count = max(counts.values())\n\n    # Collect all items that achieve the maximum frequency along with their first appearance index.\n    candidates_with_first_seen = []\n    for item, count in counts.items():\n        if count == max_count:\n            candidates_with_first_seen.append((first_seen[item], item))\n\n    # Sort candidates by their first appearance index (the first element of the tuple)\n    # and return the item (the second element of the tuple) from the earliest one.\n    return min(candidates_with_first_seen)[1]"}
{"task_id": "Mbpp/131", "solution": "def reverse_vowels(s: str) -> str:\n    \"\"\"\n    Reverses only the vowels in the input string s.\n    Vowels are defined as 'a', 'e', 'i', 'o', 'u' and their uppercase counterparts (y is not a vowel).\n    \"\"\"\n    VOWELS = {'a', 'e', 'i', 'o', 'u', 'A', 'E', 'I', 'O', 'U'}\n    chars = list(s)\n    left = 0\n    right = len(chars) - 1\n\n    while left < right:\n        # Move left pointer to the right until a vowel is found\n        while left < right and chars[left] not in VOWELS:\n            left += 1\n\n        # Move right pointer to the left until a vowel is found\n        while left < right and chars[right] not in VOWELS:\n            right -= 1\n\n        # If both pointers found vowels and haven't crossed, swap them\n        if left < right:\n            chars[left], chars[right] = chars[right], chars[left]\n            left += 1\n            right -= 1\n\n    return \"\".join(chars)"}
