{"task_id": "Mbpp/135", "solution": "def hexagonal_num(n: int) -> int:\n    \"\"\"\n    Calculates the nth hexagonal number using the formula H(n) = n * (2*n - 1).\n\n    Args:\n        n (int): A 1-based integer index (n >= 1) representing which hexagonal number to find.\n\n    Returns:\n        int: The nth hexagonal number.\n\n    Raises:\n        TypeError: If n is not an integer or is a boolean.\n        ValueError: If n is less than 1.\n\n    Examples:\n        hexagonal_num(1) == 1\n        hexagonal_num(2) == 6\n        hexagonal_num(10) == 190\n    \"\"\"\n    if isinstance(n, bool):\n        raise TypeError(\"Input 'n' must be an integer, not a boolean.\")\n    if not isinstance(n, int):\n        raise TypeError(\"Input 'n' must be an integer.\")\n    if n < 1:\n        raise ValueError(\"Input 'n' must be a positive integer (n >= 1).\")\n\n    return n * (2 * n - 1)"}
{"task_id": "Mbpp/129", "solution": "import math\nfrom typing import List, Union, Optional, Dict, Any\n\ndef _get_numeric_value(value: Any, require_integer: bool, r: int, c: int) -> Union[int, float]:\n    \"\"\"Validates a single cell value and returns its numeric representation,\n    potentially coercing whole-number floats to integers for calculation.\n    \"\"\"\n    if not isinstance(value, (int, float)) or not math.isfinite(value):\n        raise TypeError(f\"non-numeric value at row {r} col {c}: {value!r}\")\n\n    if require_integer and isinstance(value, float) and not value.is_integer():\n        raise ValueError(f\"non-integer numeric value at row {r} col {c}: {value!r}\")\n\n    if isinstance(value, float) and value.is_integer():\n        return int(value)\n\n    return value\n\ndef _validate_structure(matrix: List[List[Any]]) -> int:\n    \"\"\"Validates the overall structure of the matrix (non-empty list of lists, square).\"\"\"\n    if not isinstance(matrix, list) or not matrix:\n        raise ValueError(\"matrix must be a non-empty list of lists\")\n\n    n = len(matrix)\n    for i, row in enumerate(matrix):\n        if not isinstance(row, list):\n            raise ValueError(\"matrix must be a non-empty list of lists\")\n        if len(row) != n:\n            raise ValueError(f\"matrix must be square: row count n != length of row {i}\")\n    return n\n\ndef _validate_cell_types(matrix: List[List[Any]], n: int, require_integer: bool) -> None:\n    \"\"\"Iterates through all cells to validate their types and integer-like constraint.\"\"\"\n    for r in range(n):\n        for c in range(n):\n            _get_numeric_value(matrix[r][c], require_integer, r, c)\n\ndef _compute_magic_sum(matrix: List[List[Any]], n: int, require_integer: bool) -> int:\n    \"\"\"Calculates the magic sum from the first row, ensuring it is an integer.\"\"\"\n    current_sum: Union[int, float] = 0\n    for c in range(n):\n        val = _get_numeric_value(matrix[0][c], require_integer, 0, c)\n        current_sum += val\n\n    if isinstance(current_sum, float):\n        return int(current_sum)\n    return current_sum\n\ndef _check_rows(matrix: List[List[Any]], n: int, magic_sum: int, require_integer: bool) -> Optional[str]:\n    \"\"\"Checks if all row sums match the magic sum.\"\"\"\n    for r in range(n):\n        row_sum: Union[int, float] = 0\n        for c in range(n):\n            val = _get_numeric_value(matrix[r][c], require_integer, r, c)\n            row_sum += val\n\n        if isinstance(row_sum, float):\n            row_sum = int(row_sum)\n\n        if row_sum != magic_sum:\n            return f\"row sum mismatch at row {r}\"\n    return None\n\ndef _check_columns(matrix: List[List[Any]], n: int, magic_sum: int, require_integer: bool) -> Optional[str]:\n    \"\"\"Checks if all column sums match the magic sum.\"\"\"\n    for c in range(n):\n        col_sum: Union[int, float] = 0\n        for r in range(n):\n            val = _get_numeric_value(matrix[r][c], require_integer, r, c)\n            col_sum += val\n\n        if isinstance(col_sum, float):\n            col_sum = int(col_sum)\n\n        if col_sum != magic_sum:\n            return f\"column sum mismatch at column {c}\"\n    return None\n\ndef _check_diagonals(matrix: List[List[Any]], n: int, magic_sum: int, require_integer: bool) -> Optional[str]:\n    \"\"\"Checks if primary and secondary diagonal sums match the magic sum.\"\"\"\n    primary_diag_sum: Union[int, float] = 0\n    secondary_diag_sum: Union[int, float] = 0\n    for i in range(n):\n        primary_diag_sum += _get_numeric_value(matrix[i][i], require_integer, i, i)\n        secondary_diag_sum += _get_numeric_value(matrix[i][n - 1 - i], require_integer, i, n - 1 - i)\n\n    if isinstance(primary_diag_sum, float):\n        primary_diag_sum = int(primary_diag_sum)\n    if isinstance(secondary_diag_sum, float):\n        secondary_diag_sum = int(secondary_diag_sum)\n\n    if primary_diag_sum != magic_sum:\n        return \"primary diagonal sum mismatch\"\n    if secondary_diag_sum != magic_sum:\n        return \"secondary diagonal sum mismatch\"\n    return None\n\ndef _check_consecutive(matrix: List[List[Any]], n: int, require_integer: bool) -> Optional[str]:\n    \"\"\"Verifies that all values in the matrix form the consecutive sequence 1 to n*n.\"\"\"\n    expected_max_val = n * n\n\n    if expected_max_val == 0:\n        return None\n\n    seen_values: List[int] = []\n    for r in range(n):\n        for c in range(n):\n            val_raw = matrix[r][c]\n\n            # For this check, values MUST be positive integers (1 to N*N).\n            num_val = _get_numeric_value(val_raw, False, r, c)\n\n            if not isinstance(num_val, int) and (not isinstance(num_val, float) or not num_val.is_integer()):\n                return \"values are not consecutive 1..n^2: missing {}; duplicates {}\"\n\n            current_val = int(num_val)\n\n            if not (1 <= current_val <= expected_max_val):\n                return \"values are not consecutive 1..n^2: missing {}; duplicates {}\"\n\n            seen_values.append(current_val)\n\n    expected_set = set(range(1, expected_max_val + 1))\n    actual_counts: Dict[int, int] = {}\n    for val in seen_values:\n        actual_counts[val] = actual_counts.get(val, 0) + 1\n\n    actual_set = set(actual_counts.keys())\n\n    missing = sorted(list(expected_set - actual_set))\n    duplicates = {v: c for v, c in actual_counts.items() if c > 1}\n\n    if missing or duplicates:\n        reason_parts = []\n        if missing:\n            reason_parts.append(f\"missing {{{', '.join(map(str, missing))}}}\")\n        if duplicates:\n            sorted_duplicates = sorted(duplicates.items())\n            dup_str = \", \".join([f\"{k}:{v}\" for k, v in sorted_duplicates])\n            reason_parts.append(f\"duplicates {{{dup_str}}}\")\n\n        return f\"values are not consecutive 1..n^2: {'; '.join(reason_parts)}\"\n\n    return None\n\ndef magic_square_test(matrix: List[List[Any]], require_consecutive: bool = False, require_integer: bool = True) -> Dict[str, Any]:\n    \"\"\"\n    Calculates whether the given matrix is a magic square based on configurable constraints.\n    It validates structure, cell types, sums, and optionally consecutive values.\n    \"\"\"\n    n = _validate_structure(matrix)\n\n    if n == 0:\n        return {\"is_magic\": True, \"magic_sum\": 0, \"reason\": None}\n\n    _validate_cell_types(matrix, n, require_integer)\n\n    magic_sum = _compute_magic_sum(matrix, n, require_integer)\n\n    if (reason := _check_rows(matrix, n, magic_sum, require_integer)) is not None:\n        return {\"is_magic\": False, \"magic_sum\": None, \"reason\": reason}\n\n    if (reason := _check_columns(matrix, n, magic_sum, require_integer)) is not None:\n        return {\"is_magic\": False, \"magic_sum\": None, \"reason\": reason}\n\n    if (reason := _check_diagonals(matrix, n, magic_sum, require_integer)) is not None:\n        return {\"is_magic\": False, \"magic_sum\": None, \"reason\": reason}\n\n    if require_consecutive:\n        if (reason := _check_consecutive(matrix, n, require_integer)) is not None:\n            return {\"is_magic\": False, \"magic_sum\": None, \"reason\": reason}\n\n    return {\"is_magic\": True, \"magic_sum\": magic_sum, \"reason\": None}"}
{"task_id": "Mbpp/137", "solution": "def zero_count(iterable) -> float:\n    \"\"\"\n    Calculates the ratio of zeroes to non-zeroes in an iterable of integers.\n    Raises TypeError for invalid input, ValueError for empty input.\n    \"\"\"\n    zeroes = 0\n    non_zeroes = 0\n\n    try:\n        iterator = iter(iterable)\n    except TypeError:\n        raise TypeError(\"Input must be an iterable.\")\n\n    for element in iterator:\n        if not isinstance(element, int):\n            raise TypeError(\"All elements in the iterable must be integers.\")\n\n        if element == 0:\n            zeroes += 1\n        else:\n            non_zeroes += 1\n\n    if zeroes == 0 and non_zeroes == 0:\n        raise ValueError(\"Input iterable cannot be empty.\")\n    elif non_zeroes == 0:\n        return float('inf')\n    else:\n        return float(zeroes / non_zeroes)"}
{"task_id": "Mbpp/139", "solution": "import math\n\ndef circle_circumference(radius: float | int) -> float:\n    \"\"\"Computes the circumference of a circle given its radius.\n    Accepts a numeric radius (int or float) and returns the circumference as a float.\n    \"\"\"\n    if radius == 0:\n        return 0.0\n    return 2.0 * math.pi * float(radius)"}
{"task_id": "Mbpp/138", "solution": "def is_Sum_Of_Powers_Of_Two(n: int) -> bool:\n    \"\"\"\n    Check whether the given number can be represented as a sum of non-zero powers of 2.\n\n    Raises:\n        TypeError: if n is not an int (bool is not accepted).\n    Returns:\n        bool: True if n can be represented as a non-empty sum of powers of two, False otherwise.\n    \"\"\"\n    if not isinstance(n, int) or isinstance(n, bool):\n        raise TypeError(\"n must be an integer\")\n    if n <= 0:\n        return False\n\n    # Bitwise scan (O(number_of_bits) time, O(1) space).\n    temp = n\n    while temp > 0:\n        if (temp & 1) == 1:\n            return True\n        temp >>= 1\n\n    # Shouldn't be reached for positive integers, but kept for completeness.\n    return False"}
{"task_id": "Mbpp/140", "solution": "from typing import Iterable, Union, Set\n\ndef extract_singly(iterables: Iterable[Iterable[Union[int, float]]]) -> Set[Union[int, float]]:\n    \"\"\"\n    Flattens a one-level deep iterable of iterables into a set of unique numeric elements, raising TypeError for invalid input types.\n    This is O(N) time and O(U) space, consuming iterators but not mutating other inputs.\n    \"\"\"\n    result: Set[Union[int, float]] = set()\n\n    try:\n        outer_iterator = iter(iterables)\n    except TypeError:\n        raise TypeError(\"extract_singly: outer argument is not iterable\")\n\n    for inner in outer_iterator:\n        try:\n            inner_iterator = iter(inner)\n        except TypeError:\n            raise TypeError(\"extract_singly: item of outer iterable is not iterable\")\n\n        for elem in inner_iterator:\n            if not isinstance(elem, (int, float)):\n                raise TypeError(f\"extract_singly: inner element {elem!r} is not numeric (int or float)\")\n            result.add(elem)\n\n    return result"}
{"task_id": "Mbpp/141", "solution": "def validate_input(items: Any) -> None:\n    \"\"\"Validates if the input is a list, raising TypeError if not.\"\"\"\n    if not isinstance(items, list):\n        raise TypeError(\"pancake_sort: items must be a list\")\n\ndef _flip(items: list, k: int) -> None:\n    \"\"\"Reverses the prefix items[0...k] in-place.\"\"\"\n    items[0 : k + 1] = items[0 : k + 1][::-1]\n\ndef pancake_sort(items: list) -> list:\n    \"\"\"\n    Sorts a list of elements in ascending order using the pancake sort algorithm.\n\n    This function performs a non-destructive sort, returning a new list and\n    leaving the original input list unchanged. It uses prefix flips.\n\n    Args:\n        items: The list of elements to be sorted.\n\n    Returns:\n        A new list containing the elements of 'items' sorted in ascending order.\n\n    Raises:\n        TypeError: If 'items' is not a list, or if elements within the list\n                   are not mutually comparable during sorting.\n\n    Complexity:\n        Time: O(n^2) in the worst case, where n is the number of elements.\n        Space: O(n) due to the creation of a shallow copy of the input list.\n    \"\"\"\n    validate_input(items)\n    arr = list(items)  # Create a shallow copy to ensure non-destructive sort\n    n = len(arr)\n\n    if n <= 1:\n        return arr\n\n    for current_size in range(n - 1, 0, -1):\n        # Find the index of the maximum element in the current unsorted prefix arr[0...current_size]\n        max_idx = 0\n        try:\n            for i in range(1, current_size + 1):\n                if arr[i] > arr[max_idx]:\n                    max_idx = i\n        except TypeError:\n            raise TypeError(\"pancake_sort: elements are not mutually comparable\")\n\n        # If the maximum element is not already at its correct position\n        if max_idx != current_size:\n            # First flip: Move the maximum element to the front if it's not already there\n            if max_idx != 0:\n                _flip(arr, max_idx)\n\n            # Second flip: Move the maximum element from the front to its final sorted position\n            _flip(arr, current_size)\n\n    return arr"}
{"task_id": "Mbpp/142", "solution": "def count_samepair(list_a: list, list_b: list, list_c: list) -> int:\n    \"\"\"Counts items identical in the same position across three lists, up to the length of the shortest list.\n\n    Args:\n        list_a (list): First list.\n        list_b (list): Second list.\n        list_c (list): Third list.\n\n    Returns:\n        int: Number of indices i where list_a[i] == list_b[i] == list_c[i].\n\n    Raises:\n        TypeError: If any of the inputs is not a list.\n\n    Complexity:\n        Time: O(n) where n = min(len(list_a), len(list_b), len(list_c)).\n        Space: O(1) auxiliary.\n    \"\"\"\n    if not isinstance(list_a, list) or not isinstance(list_b, list) or not isinstance(list_c, list):\n        raise TypeError(\"count_samepair: all inputs must be list instances\")\n\n    min_length = min(len(list_a), len(list_b), len(list_c))\n    count = 0\n    for i in range(min_length):\n        if list_a[i] == list_b[i] == list_c[i]:\n            count += 1\n    return count"}
{"task_id": "Mbpp/161", "solution": "def remove_elements(first_list, second_list):\n    \"\"\"\n    Removes all elements from first_list that are present in second_list, returning a new list.\n    Preserves order of remaining elements and does not modify the input lists.\n    \"\"\"\n    def _all_hashable(items):\n        \"\"\"Checks if all elements in a list are hashable.\"\"\"\n        for x in items:\n            try:\n                hash(x)\n            except TypeError:\n                return False\n        return True\n\n    if not first_list:\n        return []\n    if not second_list:\n        return first_list.copy()\n\n    if _all_hashable(second_list):\n        s = set(second_list)\n        return [x for x in first_list if x not in s]\n    else:\n        result = []\n        for x in first_list:\n            should_remove = False\n            for y in second_list:\n                if x == y:\n                    should_remove = True\n                    break\n            if not should_remove:\n                result.append(x)\n        return result"}
{"task_id": "Mbpp/145", "solution": "import numbers\n\nclass MinMaxTracker:\n    \"\"\"A helper class to track minimum, maximum, and float presence in a stream of numbers.\"\"\"\n    def __init__(self, first_value):\n        self.min_value = first_value\n        self.max_value = first_value\n        self.any_float = isinstance(first_value, float)\n\n    def process(self, value):\n        self.min_value = min(self.min_value, value)\n        self.max_value = max(self.max_value, value)\n        if isinstance(value, float):\n            self.any_float = True\n\n    def result(self):\n        return abs(self.max_value - self.min_value)\n\n    def all_inputs_int(self):\n        return not self.any_float\n\ndef max_Abs_Diff(seq):\n    \"\"\"Calculates the maximum absolute difference between any two real numeric elements in `seq` (O(n) time, O(1) space).\n    It raises `TypeError` for invalid inputs/elements, `ValueError` for empty sequences, and accepts `bool` values as numbers.\"\"\"\n    try:\n        iterator = iter(seq)\n    except TypeError:\n        raise TypeError(\"seq is not iterable; expected an iterable of numbers.Real\")\n\n    try:\n        first = next(iterator)\n    except StopIteration:\n        raise ValueError(\"seq is empty; cannot compute max absolute difference\")\n\n    if not isinstance(first, numbers.Real):\n        raise TypeError(f\"element {first!r} of type {type(first).__name__} is not a real numeric type (numbers.Real expected)\")\n\n    tracker = MinMaxTracker(first)\n\n    for elem in iterator:\n        if not isinstance(elem, numbers.Real):\n            raise TypeError(f\"element {elem!r} of type {type(elem).__name__} is not a real numeric type (numbers.Real expected)\")\n        tracker.process(elem)\n\n    return tracker.result()"}
{"task_id": "Mbpp/160", "solution": "from dataclasses import dataclass\nfrom typing import Optional, Tuple\n\n@dataclass\nclass GCDResult:\n    \"\"\"Holds the greatest common divisor (g) and B\u00e9zout coefficients (u, v) such that a*u + b*v = g.\"\"\"\n    g: int\n    u: int\n    v: int\n\nclass ExtendedGCD:\n    \"\"\"Implements the Extended Euclidean Algorithm.\"\"\"\n\n    @staticmethod\n    def compute(a: int, b: int) -> GCDResult:\n        \"\"\"\n        Computes g = gcd(a, b) and coefficients u, v such that a*u + b*v = g, with g >= 0.\n        This is an iterative implementation of the Extended Euclidean Algorithm.\n        \"\"\"\n        r0, r1 = a, b\n        s0, s1 = 1, 0\n        t0, t1 = 0, 1\n\n        while r1 != 0:\n            q = r0 // r1\n            r0, r1 = r1, r0 - q * r1\n            s0, s1 = s1, s0 - q * s1\n            t0, t1 = t1, t0 - q * t1\n\n        # Ensure g is non-negative. If gcd is negative, invert signs of g, u, v.\n        if r0 < 0:\n            return GCDResult(-r0, -s0, -t0)\n        return GCDResult(r0, s0, t0)\n\ndef find_solution(a: int, b: int, n: int) -> Optional[Tuple[int, int]]:\n    \"\"\"\n    Returns integers x and y that satisfy ax + by = n as a tuple, or None if no solution exists.\n    A canonical solution (x, y) is chosen such that 0 <= x < |b/g| when b != 0.\n    \"\"\"\n    # Special cases handling (BR-3, BR-8, BR-9)\n    if a == 0 and b == 0:\n        return (0, 0) if n == 0 else None\n    if a == 0: # b != 0 implied\n        return (0, n // b) if n % b == 0 else None\n    if b == 0: # a != 0 implied\n        return (n // a, 0) if n % a == 0 else None\n\n    # General case: both a and b are non-zero\n    gcd_result = ExtendedGCD.compute(a, b)\n    g, u, v = gcd_result.g, gcd_result.u, gcd_result.v\n\n    # Check for solvability (BR-4)\n    if n % g != 0:\n        return None\n\n    # Scale B\u00e9zout coefficients to find an initial particular solution (BR-5)\n    k = n // g\n    x0 = u * k\n    y0 = v * k\n\n    # Canonicalize the solution (BR-6, BR-7)\n    # The general solution is x = x0 + (b/g)*t, y = y0 - (a/g)*t\n    # We choose x in range 0 .. |b/g|-1\n    b_over_g = b // g\n    a_over_g = a // g\n\n    m = abs(b_over_g) # m is the modulus for x\n    x = x0 % m\n\n    # Calculate t based on the chosen x\n    # (x - x0) must be a multiple of b_over_g\n    t = (x - x0) // b_over_g\n\n    # Adjust y accordingly\n    y = y0 - a_over_g * t\n\n    return (x, y)"}
{"task_id": "Mbpp/162", "solution": "def sum_series(n):\n    \"\"\"\n    Calculate the sum n + (n-2) + (n-4) + ... down to the last non-negative term.\n\n    Raises:\n        TypeError: if n is not an integer.\n        ValueError: if n is negative.\n    \"\"\"\n    if not isinstance(n, int) or isinstance(n, bool):\n        raise TypeError(\"n must be an integer\")\n    if n < 0:\n        raise ValueError(\"n must be non-negative\")\n\n    m = n // 2\n    return (m + 1) * (n - m)"}
{"task_id": "Mbpp/165", "solution": "def count_char_position(s: str) -> int:\n    \"\"\"\n    Counts characters in a string whose 1-based position equals their position\n    in the English alphabet (A/a=1 ... Z/z=26), case-insensitively.\n    \"\"\"\n    if not isinstance(s, str):\n        raise TypeError(\"Input must be a string.\")\n\n    count = 0\n    for i, ch in enumerate(s, start=1):\n        if 'A' <= ch <= 'Z' or 'a' <= ch <= 'z':\n            alphabet_pos = ord(ch.lower()) - ord('a') + 1\n            if alphabet_pos == i:\n                count += 1\n    return count"}
{"task_id": "Mbpp/171", "solution": "def perimeter_pentagon(side_length):\n    \"\"\"Calculates the perimeter of a regular pentagon.\n\n    Args:\n        side_length (int | float): Length of one side of the pentagon.\n\n    Returns:\n        float: Perimeter of the pentagon (5 * side_length).\n\n    Raises:\n        ValueError: If side_length is not a number, is NaN/Inf, or is negative.\n    \"\"\"\n    import math\n\n    if not isinstance(side_length, (int, float)):\n        raise ValueError(\"side_length must be a numeric type (int or float)\")\n    if math.isnan(side_length) or not math.isfinite(side_length):\n        raise ValueError(\"side_length must be a finite number\")\n    if side_length < 0:\n        raise ValueError(\"side_length must be non-negative\")\n\n    return float(5 * side_length)"}
{"task_id": "Mbpp/167", "solution": "def next_power_of_2(n: int) -> int:\n    \"\"\"\n    Finds the smallest power of 2 greater than or equal to n.\n    Handles n=0 as a special case, otherwise uses bit_length for efficiency.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an int\")\n    if n < 0:\n        raise ValueError(\"n must be non-negative\")\n    if n == 0:\n        return 1\n    # For n > 0, find the number of bits required to represent n-1.\n    # Shifting 1 left by this many bits gives the next power of 2.\n    k = (n - 1).bit_length()\n    return 1 << k"}
{"task_id": "Mbpp/166", "solution": "def find_even_pair(values: list[int]) -> int:\n    \"\"\"Return the number of unordered index pairs (i < j) such that values[i] ^ values[j] is even.\"\"\"\n    if len(values) < 2:\n        return 0\n\n    even_count = 0\n    odd_count = 0\n\n    for v in values:\n        # Determine parity using the least significant bit\n        if (v & 1) == 0:  # If LSB is 0, number is even\n            even_count += 1\n        else:  # If LSB is 1, number is odd\n            odd_count += 1\n\n    # Calculate combinations of even numbers: n * (n - 1) / 2\n    even_pairs = even_count * (even_count - 1) // 2\n    # Calculate combinations of odd numbers: n * (n - 1) / 2\n    odd_pairs = odd_count * (odd_count - 1) // 2\n\n    # The XOR of two numbers is even if and only if both numbers have the same parity.\n    return even_pairs + odd_pairs"}
{"task_id": "Mbpp/168", "solution": "from typing import Any\n\nclass TypeValidator:\n    @staticmethod\n    def ensure_list(value: Any) -> None:\n        if not isinstance(value, list):\n            raise TypeError(\"items must be a list\")\n\ndef frequency(items: list, target: Any) -> int:\n    \"\"\"\n    Counts occurrences of target in items.\n\n    Parameters:\n        items: A list of elements to search through.\n        target: The value to count occurrences of, compared using `==`.\n\n    Returns:\n        An integer representing the number of times `target` appears in `items`.\n\n    Raises:\n        TypeError: If `items` is not a list.\n        (Other exceptions may propagate from element `__eq__` implementations.)\n\n    Examples:\n        >>> frequency([1, 2, 3, 2, 1], 1)\n        2\n        >>> frequency([1, 2, 3], 4)\n        0\n        >>> frequency([None, 1, None], None)\n        2\n\n    Notes:\n        - Equality checks are performed using the `==` operator.\n        - The input list `items` is not mutated.\n        - An acceptable alternative implementation is `return items.count(target)`.\n    \"\"\"\n    TypeValidator.ensure_list(items)\n    count = 0\n    for element in items:\n        if element == target:\n            count += 1\n    return count"}
{"task_id": "Mbpp/170", "solution": "def sum_range_list(lst, start, end):\n    \"\"\"Calculates the sum of numeric values in `lst` from `start` to `end` (inclusive, zero-based).\n\n    Parameters:\n    - lst (list): list of numeric values (int or float).\n    - start (int): inclusive start index (zero-based).\n    - end (int): inclusive end index (zero-based).\n\n    Returns:\n    - int or float: sum of elements lst[start] through lst[end] inclusive.\n      If start > end (and indices are in-bounds), returns 0.\n\n    Raises:\n    - TypeError: if lst is not a list, any element of lst is not int/float, or start/end are not ints.\n    - IndexError: if lst is empty or start/end are out of valid index range [0, len(lst)-1].\n\n    Complexity:\n    - Time: O(k) where k = number of elements summed (end - start + 1). Worst-case O(n).\n    - Space: O(1) additional.\n    \"\"\"\n    # Type Validation\n    if not isinstance(lst, list):\n        raise TypeError(\"lst must be a list of int/float.\")\n    if not isinstance(start, int) or not isinstance(end, int):\n        raise TypeError(\"start and end must be integers.\")\n    for x in lst:\n        if not isinstance(x, (int, float)):\n            raise TypeError(\"all elements of lst must be int or float.\")\n\n    # Bounds Validation\n    n = len(lst)\n    if n == 0:\n        raise IndexError(\"list is empty; indices out of range.\")\n    if start < 0 or end < 0 or start >= n or end >= n:\n        raise IndexError(f\"start ({start}) and end ({end}) must be within [0, {n-1}].\")\n\n    # Handle Empty In-bounds Segment\n    if start > end:\n        return 0\n\n    # Summation\n    current_sum = 0\n    for i in range(start, end + 1):\n        current_sum += lst[i]\n    return current_sum"}
{"task_id": "Mbpp/172", "solution": "def count_occurance(s: str) -> int:\n    \"\"\"Counts occurrences of the substring 'std' in a given string, including overlapping matches.\"\"\"\n    pattern = \"std\"\n    window_size = len(pattern)\n\n    if s is None:\n        raise TypeError(\"Input must be a string, not None.\")\n    if not isinstance(s, str):\n        raise TypeError(f\"Input must be a string, got {type(s).__name__}.\")\n\n    count = 0\n    for i in range(len(s) - window_size + 1):\n        if s[i:i + window_size] == pattern:\n            count += 1\n    return count"}
{"task_id": "Mbpp/226", "solution": "def odd_values_string(s: str) -> str:\n    \"\"\"Removes characters with odd index values from a string, returning a new string.\"\"\"\n    if not isinstance(s, str):\n        raise TypeError(\"s must be a str\")\n    return s[::2]"}
{"task_id": "Mbpp/222", "solution": "def check_type(t: tuple) -> bool:\n    \"\"\"Checks if all top-level elements in a tuple have the same data type.\n\n    Returns True for empty or single-element tuples.\n    Raises TypeError if the input is not a tuple.\n    \"\"\"\n    if not isinstance(t, tuple):\n        raise TypeError(\"Input must be a tuple\")\n\n    if len(t) <= 1:\n        return True\n\n    first_type = type(t[0])\n    for element in t[1:]:\n        if type(element) != first_type:\n            return False\n    return True"}
{"task_id": "Mbpp/223", "solution": "from typing import Any, Sequence, Optional\n\ndef is_majority(arr: Sequence, n: int, x: Any) -> bool:\n    \"\"\"\n    Checks if an element x is the majority element in a sorted array arr of length n.\n    The majority element occurs more than n/2 times.\n\n    Parameters:\n    - arr: Sequence (sorted in non-decreasing order)\n    - n: int (must be equal to len(arr))\n    - x: Any (element to test)\n\n    Returns:\n    - True if x is the majority element, False otherwise.\n\n    Note:\n    - This function assumes arr is sorted. It runs in O(log n) time.\n    \"\"\"\n    if not isinstance(n, int) or n != len(arr):\n        raise ValueError(f\"n must be an int equal to len(arr): expected {len(arr)}, got {n}\")\n    if n == 0:\n        return False\n\n    # Find the first occurrence of x using iterative binary search\n    lo, hi = 0, n - 1\n    first_index: Optional[int] = None\n    while lo <= hi:\n        mid = (lo + hi) // 2\n        if arr[mid] < x:\n            lo = mid + 1\n        elif arr[mid] > x:\n            hi = mid - 1\n        else:  # arr[mid] == x\n            first_index = mid\n            hi = mid - 1  # continue searching left\n\n    if first_index is None:\n        return False\n\n    candidate_index = first_index + n // 2\n    return candidate_index < n and arr[candidate_index] == x"}
{"task_id": "Mbpp/224", "solution": "_HAS_INT_BIT_COUNT = getattr(int, \"bit_count\", None) is not None and callable(getattr(int, \"bit_count\", None))\n\ndef _brian_kernighan_count(n):\n    \"\"\"Counts set bits using Brian Kernighan's algorithm.\n    This helper is defined but not used by the primary count_Set_Bits implementation.\"\"\"\n    count = 0\n    while n:\n        n &= n - 1\n        count += 1\n    return count\n\ndef count_Set_Bits(value):\n    \"\"\"Counts the number of set bits (1s) in the binary representation of a non-negative integer.\n    Prefers int.bit_count() when available, otherwise falls back to string conversion.\"\"\"\n    if not isinstance(value, int):\n        raise TypeError(\"count_Set_Bits: value must be int\")\n    if value < 0:\n        raise ValueError(\"count_Set_Bits: value must be non-negative\")\n\n    if value == 0:\n        return 0\n\n    if _HAS_INT_BIT_COUNT:\n        return value.bit_count()\n    else:\n        # Fallback for older Python versions or where int.bit_count is unavailable.\n        return bin(value).count(\"1\")"}
{"task_id": "Mbpp/227", "solution": "def is_numeric(x):\n    \"\"\"Checks if the input is an int or float.\"\"\"\n    return isinstance(x, (int, float))\n\ndef validate_inputs(a, b, c):\n    \"\"\"Validates that all inputs are int or float, raising TypeError if not.\"\"\"\n    if not (is_numeric(a) and is_numeric(b) and is_numeric(c)):\n        raise TypeError(\"min_of_three: all inputs must be int or float\")\n\ndef min_of_three(a, b, c):\n    \"\"\"\n    Finds the minimum of three numeric inputs (int or float).\n    Handles NaN, +inf, and -inf according to Python's numeric semantics.\n    \"\"\"\n    validate_inputs(a, b, c)\n    return min(a, b, c)"}
{"task_id": "Mbpp/230", "solution": "def replace_blank(s, ch) -> str:\n    \"\"\"Replaces ASCII spaces (U+0020) in a string with a given character.\"\"\"\n    result_chars = []\n    for char in s:\n        if char == ' ':\n            result_chars.append(ch)\n        else:\n            result_chars.append(char)\n    return \"\".join(result_chars)"}
{"task_id": "Mbpp/233", "solution": "import math\n\ndef lateralsuface_cylinder(radius, height):\n    \"\"\"\n    Calculates the lateral surface area of a cylinder.\n    Returns 0.0 if radius or height is zero, otherwise computes 2 * PI * radius * height.\n    \"\"\"\n    if radius == 0 or height == 0:\n        return 0.0\n    return 2 * math.pi * float(radius) * float(height)"}
{"task_id": "Mbpp/232", "solution": "import heapq\nfrom typing import Iterable, List, Any\n\ndef larg_nnum(iterable: Iterable[Any], n: int, uniqueOnly: bool = False) -> List[Any]:\n    \"\"\"\n    Returns a list containing the n largest items from the iterable.\n    Handles uniqueOnly option and uses optimized selection strategies.\n    \"\"\"\n    items_list = list(iterable)  # Create a list copy to ensure immutability and allow internal operations.\n\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n\n    if n <= 0:\n        return []\n\n    if uniqueOnly:\n        items_list = list(set(items_list))  # Deduplicate items; order is not guaranteed but irrelevant for final sort.\n\n    num_items = len(items_list)\n\n    if n >= num_items:\n        # If n is greater than or equal to the number of items, return all items sorted descending.\n        return sorted(items_list, reverse=True)\n\n    # Choose between heapq.nlargest (heap-based) or a full sort and slice.\n    # heapq.nlargest is generally efficient, especially when n is small relative to num_items.\n    if n < num_items // 2:  # Heuristic: use heap for smaller n, full sort for larger n.\n        return heapq.nlargest(n, items_list)  # heapq.nlargest returns items in descending order.\n    else:\n        return sorted(items_list, reverse=True)[:n]  # Sort the copy and take the first n items."}
{"task_id": "Mbpp/234", "solution": "class InputValidator:\n    \"\"\"Handles validation of input side length for type and non-negativity.\"\"\"\n    def validateType(self, side):\n        \"\"\"Checks if the side is an int or float, raising TypeError if not.\"\"\"\n        if not isinstance(side, (int, float)):\n            raise TypeError(\"Side length must be an integer or a float.\")\n\n    def validateNonNegative(self, side):\n        \"\"\"Checks if the side is non-negative, raising ValueError if negative.\"\"\"\n        if side < 0:\n            raise ValueError(\"Side length cannot be negative.\")\n\nclass VolumeCalculator:\n    \"\"\"Computes the volume of a cube.\"\"\"\n    def compute(self, side):\n        \"\"\"Calculates the cube of the side length.\"\"\"\n        return side ** 3\n\ndef volume_cube(side):\n    \"\"\"\n    Calculates the volume of a cube given its side length.\n    It validates input and computes side ** 3, preserving native numeric types.\n    \"\"\"\n    validator = InputValidator()\n    calculator = VolumeCalculator()\n\n    validator.validateType(side)\n    validator.validateNonNegative(side)\n\n    return calculator.compute(side)"}
{"task_id": "Mbpp/235", "solution": "def even_bit_set_number(n) -> int:\n    \"\"\"Sets all even bits of a given number n, where even bits are 1-indexed (positions 2, 4, 6...).\"\"\"\n\n    def _validate_input(val):\n        if not isinstance(val, int):\n            raise TypeError(\"n must be an integer.\")\n        if val < 0:\n            raise ValueError(\"n must be non-negative.\")\n\n    def _generate_mask(bitlen: int) -> int:\n        mask = 0\n        # Iterate through zero-based bit positions 1, 3, 5, ... up to bitlen-1.\n        for pos in range(1, bitlen, 2):\n            mask |= (1 << pos)\n        return mask\n\n    _validate_input(n)\n\n    if n == 0:\n        return 0\n\n    bit_length = n.bit_length()\n    mask = _generate_mask(bit_length)\n    return n | mask"}
{"task_id": "Mbpp/238", "solution": "def number_of_substrings(s: str) -> int:\n    \"\"\"\n    Counts the number of non-empty contiguous substrings of the given string.\n    This uses a mathematical formula for O(1) time complexity.\n    \"\"\"\n    n = len(s)\n    return n * (n + 1) // 2"}
{"task_id": "Mbpp/237", "solution": "from collections import Counter\nfrom typing import List, Tuple, Dict, Any\n\nclass Validator:\n    \"\"\"Helper for validating input data types.\"\"\"\n    @staticmethod\n    def validate_all_are_tuples(tuples: list) -> None:\n        \"\"\"Ensures all items in the list are tuples, raising TypeError if not.\"\"\"\n        for item in tuples:\n            if not isinstance(item, tuple):\n                raise TypeError(\"All items must be tuples\")\n\nclass NormalizedTuple:\n    \"\"\"Helper for creating a canonical representation of a tuple.\"\"\"\n    @staticmethod\n    def canonical_from(raw: tuple) -> tuple:\n        \"\"\"Returns a canonical sorted tuple from the raw input tuple.\"\"\"\n        return tuple(sorted(raw))\n\nclass CounterResult:\n    \"\"\"Helper for counting occurrences and returning a dictionary.\"\"\"\n    @staticmethod\n    def from_iterable(iterable: List[Tuple[Any, ...]]) -> dict:\n        \"\"\"Counts occurrences of items in an iterable and returns a dictionary.\"\"\"\n        return dict(Counter(iterable))\n\ndef check_occurences(tuples: list) -> dict:\n    \"\"\"\n    Takes a list of tuples, validates input, normalizes each tuple to a\n    canonical form, and returns a dictionary mapping each unique canonical\n    tuple to its occurrence count.\n    \"\"\"\n    Validator.validate_all_are_tuples(tuples)\n    canonical_iter = (NormalizedTuple.canonical_from(t) for t in tuples)\n    return CounterResult.from_iterable(canonical_iter)"}
{"task_id": "Mbpp/240", "solution": "def replace_list(list1: list, list2: list) -> list:\n    \"\"\"Return a new list composed of list1 except its last element followed by list2.\n    If list1 is empty, a shallow copy of list2 is returned.\n    Raises TypeError if either argument is not a list.\n    \"\"\"\n    if not isinstance(list1, list) or not isinstance(list2, list):\n        raise TypeError(\"Both arguments must be lists.\")\n    if not list1:\n        return list2.copy()\n    return list1[:-1] + list2"}
{"task_id": "Mbpp/242", "solution": "def count_charac(input_string: str) -> int:\n    \"\"\"Return number of characters (Unicode code points) in input_string.\n\n    Raises:\n      TypeError: if input_string is None or not an instance of str.\n    \"\"\"\n    if not isinstance(input_string, str):\n        raise TypeError(\"input_string must be a str\")\n    return len(input_string)"}
{"task_id": "Mbpp/239", "solution": "def get_total_number_of_sequences(m, n):\n    # Validate inputs\n    if not isinstance(m, int) or not isinstance(n, int):\n        raise TypeError(\"m and n must be integers\")\n    if m <= 0 or n <= 0:\n        raise ValueError(\"m and n must be positive integers\")\n\n    # Fast-path: if n == 1, any integer from 1..m is a valid sequence\n    if n == 1:\n        return m\n\n    # Early-exit: check if m < 2^(n-1). If so, impossible to build length-n sequence.\n    threshold = 1\n    for _ in range(n - 1):\n        threshold <<= 1  # multiply by 2\n        if threshold > m:\n            return 0\n\n    # dp[x] = number of sequences of current length starting with value x\n    # Use 1-based indexing: dp[0] unused; dp has length m+1\n    dp = [0] * (m + 1)\n    for x in range(1, m + 1):\n        dp[x] = 1  # base case: sequences of length 1\n\n    # Build layers from length 2 to n\n    for k in range(2, n + 1):\n        # Build suffix sums S where S[i] = sum_{j=i..m} dp[j]\n        S = [0] * (m + 2)  # S[m+1] = 0 sentinel\n        for i in range(m, 0, -1):\n            S[i] = S[i + 1] + dp[i]\n\n        next_dp = [0] * (m + 1)\n        all_zero = True\n        # next_dp[x] = sum_{y=2*x..m} dp[y] = S[2*x] if 2*x <= m else 0\n        for x in range(1, m + 1):\n            idx = 2 * x\n            if idx <= m:\n                next_dp[x] = S[idx]\n                if next_dp[x] != 0:\n                    all_zero = False\n            else:\n                next_dp[x] = 0\n\n        dp = next_dp\n        if all_zero:\n            return 0\n\n    # Total sequences = sum of dp[x] for x=1..m\n    total = sum(dp[1:])\n    return total"}
{"task_id": "Mbpp/244", "solution": "import math\n\ndef next_Perfect_Square(n: int) -> int:\n    \"\"\"\n    Finds the next perfect square strictly greater than the given number n.\n    Raises TypeError if input is not an integer.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"Input must be an integer.\")\n\n    if n < 0:\n        return 0\n\n    # Calculate the integer square root of n\n    k = math.isqrt(n)\n\n    # The next perfect square is (k + 1) squared\n    return (k + 1) ** 2"}
{"task_id": "Mbpp/250", "solution": "class TypeChecker:\n    \"\"\"Helper for input validation, ensuring arguments are of expected types.\"\"\"\n    @staticmethod\n    def validate_tuple(arg) -> None:\n        \"\"\"Raises TypeError if the argument is not a tuple.\"\"\"\n        if not isinstance(arg, tuple):\n            raise TypeError(\"tpl must be a tuple\")\n\ndef count_X(tpl: tuple, element) -> int:\n    \"\"\"Counts the occurrences of an element in a tuple.\n    Raises TypeError if the first argument is not a tuple.\"\"\"\n    TypeChecker.validate_tuple(tpl)\n    count = 0\n    for item in tpl:\n        if item == element:\n            count += 1\n    return count"}
{"task_id": "Mbpp/251", "solution": "def insert_element(list, element):\n    \"\"\"\n    Inserts 'element' before each item in the input 'list' iterable, returning a new list.\n    Raises TypeError if 'list' is not iterable. Note: 'list' shadows the built-in list.\n    \"\"\"\n    try:\n        iterator = iter(list)\n    except TypeError:\n        raise TypeError(\"list must be iterable\")\n    result = []\n    for item in iterator:\n        result.append(element)\n        result.append(item)\n    return result"}
{"task_id": "Mbpp/245", "solution": "def max_sum(array):\n    \"\"\"\n    Calculates the maximum sum of a bitonic subsequence in the given array.\n    A bitonic subsequence is strictly increasing then strictly decreasing.\n    \"\"\"\n    if not array:\n        return 0\n\n    n = len(array)\n    if n == 1:\n        return array[0]\n\n    # left_sum[i] stores the maximum sum of a strictly increasing subsequence ending at array[i].\n    left_sum = list(array)\n    # right_sum[i] stores the maximum sum of a strictly decreasing subsequence starting at array[i].\n    right_sum = list(array)\n\n    # Compute left_sum array\n    for i in range(n):\n        for j in range(i):\n            if array[j] < array[i]:\n                left_sum[i] = max(left_sum[i], left_sum[j] + array[i])\n\n    # Compute right_sum array\n    for i in range(n - 1, -1, -1):\n        for j in range(n - 1, i, -1):\n            if array[j] < array[i]:\n                right_sum[i] = max(right_sum[i], right_sum[j] + array[i])\n\n    # Combine left_sum and right_sum to find the maximum bitonic sum\n    max_bitonic_sum = float('-inf')\n    for i in range(n):\n        # array[i] is counted twice (once in left_sum[i] and once in right_sum[i]), so subtract it.\n        current_bitonic_sum = left_sum[i] + right_sum[i] - array[i]\n        if current_bitonic_sum > max_bitonic_sum:\n            max_bitonic_sum = current_bitonic_sum\n\n    return max_bitonic_sum"}
{"task_id": "Mbpp/252", "solution": "import math\n\ndef convert(z) -> tuple[float, float]:\n    \"\"\"Converts a numeric input (int, float, or complex) to polar coordinates (r, theta).\"\"\"\n    if isinstance(z, complex):\n        real, imag = z.real, z.imag\n    elif isinstance(z, (int, float)):\n        real, imag = float(z), 0.0\n    else:\n        raise TypeError(\"unsupported input type: expected int, float, or complex\")\n\n    if real == 0.0 and imag == 0.0:\n        return (0.0, 0.0)\n\n    r = math.hypot(real, imag)\n    theta = math.atan2(imag, real)\n\n    return (float(r), float(theta))"}
{"task_id": "Mbpp/247", "solution": "def lps(s):\n    \"\"\"\n    Calculates the length of the longest palindromic subsequence using space-optimized dynamic programming.\n    Handles base cases and full palindromes efficiently.\n    \"\"\"\n    if not isinstance(s, str):\n        raise TypeError(\"s must be a string\")\n\n    n = len(s)\n\n    if n == 0:\n        return 0\n    if n == 1:\n        return 1\n    # Early exit: If the string itself is a palindrome, its LPS is its length.\n    if s == s[::-1]:\n        return n\n\n    # dp[j] will store the length of the LPS for the substring s[i...j]\n    # for the current outer loop iteration 'i'.\n    dp = [0] * n\n\n    # Iterate 'i' from n-1 down to 0 (rows of the conceptual DP table, from bottom up).\n    for i in range(n - 1, -1, -1):\n        # Base case: A single character substring s[i...i] has an LPS of length 1.\n        dp[i] = 1\n\n        # 'prev' stores the value of dp[i+1][j-1] from the previous row.\n        # It's initialized to 0 because dp[i+1][i-1] (conceptually) is 0.\n        prev = 0\n\n        # Iterate 'j' from i+1 to n-1 (columns of the conceptual DP table, from left to right).\n        for j in range(i + 1, n):\n            # 'temp' stores dp[i+1][j] before it's overwritten, which will be the 'prev' for the next 'j'.\n            temp = dp[j]\n            if s[i] == s[j]:\n                # If s[i] and s[j] match, they extend the palindrome.\n                # The length is 2 plus the LPS of the inner substring s[i+1...j-1].\n                dp[j] = 2 + prev\n            else:\n                # If they don't match, take the maximum of:\n                # 1. LPS of s[i+1...j] (excluding s[i], which is current dp[j])\n                # 2. LPS of s[i...j-1] (excluding s[j], which is dp[j-1])\n                dp[j] = max(dp[j], dp[j - 1])\n\n            # Update 'prev' for the next iteration of 'j'.\n            prev = temp\n\n    # After iterating through all 'i', dp[n-1] will contain the LPS length for s[0...n-1].\n    return dp[n - 1]"}
{"task_id": "Mbpp/253", "solution": "from typing import Iterable, Any\n\ndef _is_int(value: Any, include_bools: bool = False) -> bool:\n    \"\"\"Determines if a value is an integer, optionally including booleans.\"\"\"\n    if include_bools:\n        return isinstance(value, int)\n    else:\n        return type(value) is int\n\ndef _is_iterable(value: Any) -> bool:\n    \"\"\"Checks if a value is iterable.\"\"\"\n    try:\n        iter(value)\n        return True\n    except TypeError:\n        return False\n\ndef _count_recursive(seq: Iterable[Any], include_bools: bool = False) -> int:\n    \"\"\"Recursively counts integers in nested list/tuple instances.\"\"\"\n    count = 0\n    for elem in seq:\n        if _is_int(elem, include_bools):\n            count += 1\n        elif isinstance(elem, (list, tuple)):\n            count += _count_recursive(elem, include_bools)\n    return count\n\ndef count_integer(seq, include_bools: bool = False, recursive: bool = False) -> int:\n    \"\"\"Counts the number of integer elements in a given iterable.\n\n    Args:\n        seq: An iterable (e.g., list, tuple) to examine for integers.\n        include_bools: If True, boolean values (True/False) are counted as integers. Defaults to False.\n        recursive: If True, recursively traverses nested list and tuple instances to count integers. Defaults to False.\n\n    Returns:\n        The total count of integer elements.\n\n    Raises:\n        TypeError: If `seq` is None or not an iterable.\n\n    Examples:\n        >>> count_integer([1, 2, 'abc', 1.2])\n        2\n        >>> count_integer([True, 1, False])\n        1\n        >>> count_integer([True, 1, False], include_bools=True)\n        3\n        >>> count_integer([1, [2, 3], (4, [5])], recursive=True)\n        5\n    \"\"\"\n    if seq is None:\n        raise TypeError(\"seq must be an iterable, not None\")\n    if not _is_iterable(seq):\n        raise TypeError(\"seq must be an iterable\")\n\n    if recursive:\n        return _count_recursive(seq, include_bools)\n    else:\n        count = 0\n        for elem in seq:\n            if _is_int(elem, include_bools):\n                count += 1\n        return count"}
{"task_id": "Mbpp/256", "solution": "import math\n\ndef count_Primes_nums(n: float) -> int:\n    \"\"\"\n    Count the number of prime numbers less than n using the Sieve of Eratosthenes.\n\n    Parameters:\n    - n (float): A non-negative number. Primes counted are integers p such that p < n.\n\n    Returns:\n    - int: The count of prime numbers less than n.\n\n    Raises:\n    - TypeError: if n is not an int or float, or if n is NaN or infinite.\n    - ValueError: if n is negative.\n\n    Complexity:\n    - Time: O(limit log log limit) where limit = int(n)\n    - Space: O(limit)\n    \"\"\"\n    # Validate input types and values\n    if not isinstance(n, (int, float)):\n        raise TypeError(\"n must be an int or float\")\n    if not math.isfinite(n):\n        raise TypeError(\"n must be a finite number (not NaN or infinity)\")\n    if n < 0:\n        raise ValueError(\"n must be non-negative\")\n\n    # Early return for values that have no primes below them\n    if n <= 2:\n        return 0\n\n    limit = int(n)  # we count integer primes p where p < n\n\n    # Allocate sieve: 1 means potentially prime, 0 means composite/non-prime\n    sieve_flags = bytearray(1 for _ in range(limit))\n\n    # 0 and 1 are not prime (if within range)\n    if limit > 0:\n        sieve_flags[0] = 0\n    if limit > 1:\n        sieve_flags[1] = 0\n\n    # Sieve of Eratosthenes: mark multiples of each prime as non-prime\n    upper = int(math.isqrt(limit - 1))\n    for p in range(2, upper + 1):\n        if sieve_flags[p]:\n            start = p * p\n            sieve_flags[start:limit:p] = bytearray(0 for _ in range((limit - 1 - start) // p + 1))\n\n    # Count primes (sum of flags for indices >= 2)\n    return sum(sieve_flags[2:limit])"}
{"task_id": "Mbpp/255", "solution": "from itertools import combinations_with_replacement\n\ndef combinations_colors(lst, n):\n    \"\"\"\n    Generates all combinations with repetition of length n from elements of lst, returning a list of tuples.\n    Combinatorial growth means large n or list length can produce very large outputs; time and space complexity are O(C(n+k-1, n) * n).\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n    if n < 0:\n        raise ValueError(\"n must be a non-negative integer\")\n    if n == 0:\n        return [()]\n    if not lst:  # Handles len(lst) == 0 when n > 0 (as n==0 is handled above)\n        return []\n\n    return list(combinations_with_replacement(lst, n))"}
