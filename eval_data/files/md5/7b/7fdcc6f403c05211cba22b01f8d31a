e a valid triangle when the sum of any two sides is greater\n    than the third side.\n    Example:\n    triangle_area(3, 4, 5) == 6.00\n    triangle_area(1, 2, 10) == -1\n    '''\n    try:\n        triangle = Triangle(a, b, c)\n    except ValueError:\n        return -1.0\n\n    if not triangle.is_valid():\n        return -1.0\n\n    raw_area = triangle.calculate_raw_area()\n    rounded_area = round(raw_area, 2)", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[3, 4, 5]], "plus_fail_tests": [[8, 9, 15]]}], "HumanEval/69": [{"task_id": "HumanEval/69", "solution": "def search(lst):\n    '''\n    You are given a non-empty list of positive integers. Return the greatest integer that is greater than\n    zero, and has a frequency greater than or equal to the value of the integer itself.\n    The frequency of an integer is the number of times it appears in the list.\n    If no such a value exist, return -1.\n    Examples:\n        search([4, 1, 2, 2, 3, 1]) == 2\n        search([1, 2, 2, 3, 3, 3, 4, 4, 4]) == 3\n        search([5, 5, 4, 4, 4]) == -1\n    '''\n    def _calculate_frequencies(lst):\n        # Calculates the frequency of each unique integer in the input list.\n        frequencies = {}\n        for x in lst:\n            frequencies[x] = frequencies.get(x, 0) + 1\n        return frequencies\n\n    def _find_candidates(frequencies):\n        # Filters integers based on the criteria: value > 0 and frequency >= value.\n        candidates = []\n        for val, freq in frequencies.items():\n            if val > 0 and freq >= val:\n                candidates.append(val)\n        return candidates\n\n    def _get_greatest_candidate(candidates):\n        # Finds the maximum value from a list of candidate integers, or returns -1 if empty.\n        if not candidates:\n            return -1\n        return max(candidates)\n\n    frequencies = _calculate_frequencies(lst)\n    candidates = _find_candidates(frequencies)\n    result = _get_greatest_candidate(candidates)\n    return result", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/70": [{"task_id": "HumanEval/70", "solution": "def strange_sort_list(lst):\n    '''\n    Given list of integers, return list in strange order.\n    Strange sorting, is when you start with the minimum value,\n    then maximum of the remaining integers, then minimum and so on.\n\n    Examples:\n    strange_sort_list([1, 2, 3, 4]) == [1, 4, 2, 3]\n    strange_sort_list([5, 5, 5, 5]) == [5, 5, 5, 5]\n    strange_sort_list([]) == []\n    '''\n    if not lst:\n        return []\n\n    remaining_list = sorted(lst)\n    result = []\n    is_min_turn = True\n\n    while remaining_list:\n        if is_min_turn:\n            val = remaining_list.pop(0)\n        else:\n            val = remaining_list.pop()\n        result.append(val)\n        is_min_turn = not is_min_turn\n\n    return result", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/68": [{"task_id": "HumanEval/68", "solution": "def pluck(arr):\n    \"\"\"\n    Finds the smallest even node in an array, returning its value and index.\n    Returns an empty list if the array is empty or contains no even values.\n    \"\"\"\n\n    class Node:\n        \"\"\"Represents an individual element with its value and original index.\"\"\"\n        def __init__(self, value: int, index: int):\n            self.value = value\n            self.index = index\n\n        def is_even(self) -> bool:\n            \"\"\"Checks if the node's value is even.\"\"\"\n            return self.value % 2 == 0\n\n    class NodeArray:\n        \"\"\"Manages a collection of Node objects to find the pluckable node.\"\"\"\n        def __init__(self, raw_array: list[int]):\n            self._nodes: list[Node] = [Node(val, idx) for idx, val in enumerate(raw_array)]\n\n        def find_pluckable_node(self) -> list[int] | None:\n            \"\"\"Iterates to find th