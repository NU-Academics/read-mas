l be given a string of words, and your task is to count the number\n    of boredoms. A boredom is a sentence that starts with the word \"I\".\n    Sentences are delimited by '.', '?' or '!'.\n\n    For example:\n    >>> is_bored(\"Hello world\")\n    0\n    >>> is_bored(\"The sky is blue. The sun is shining. I love this weather\")\n    1\n    \"\"\"\n    if not S:\n        return 0\n\n    # Define the fixed delimiters as per FR3 and BR1\n    sentence_delimiters = ['.', '?', '!']\n\n    # Step 1: Identify sentences\n    sentences = _split_into_sentences(S, sentence_delimiters)\n\n    # Step 2 & 3: Detect and count boredoms\n    boredom_count = 0\n    for sentence in sentences:\n        if _is_boredom_sentence(sentence):\n            boredom_count += 1\n\n    return boredom_count", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [["I"]]}], "HumanEval/89": [{"task_id": "HumanEval/89", "solution": "def encrypt(s):\n    \"\"\"Encrypts a string by rotating alphabetic characters down by 4 places.\n    Non-alphabetic characters are left unchanged. Case is preserved.\n    \"\"\"\n    _ALPHABET_LOWER = 'abcdefghijklmnopqrstuvwxyz'\n    _ALPHABET_UPPER = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'\n    _SHIFT_AMOUNT = 4\n\n    def _rotate_char(char: str, shift: int) -> str:\n        \"\"\"Rotates a single alphabetic character by the given shift amount.\"\"\"\n        if char.islower():\n            alphabet = _ALPHABET_LOWER\n        else:\n            alphabet = _ALPHABET_UPPER\n\n        original_index = alphabet.find(char)\n        if original_index == -1: # Should not happen if char is alphabetic\n            return char\n\n        new_index = (original_index + shift) % 26\n        return alphabet[new_index]\n\n    result_chars = []\n    for char in s:\n        if char.isalpha():\n            result_chars.append(_rotate_char(char, _SHIFT_AMOUNT))\n        else:\n            result_chars.append(char)\n\n    return \"\".join(result_chars)", "base_sta