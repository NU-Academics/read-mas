m = 0\n    for index, value in enumerate(lst):\n        if index % 3 == 0:\n            total_sum += value ** 2\n        elif index % 4 == 0:  # Implies index is not a multiple of 3 due to the previous condition\n            total_sum += value ** 3\n        else:\n            total_sum += value\n    return total_sum", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/140": [{"task_id": "HumanEval/140", "solution": "import re\ndef fix_spaces(text):\n    \"\"\"\n    Given a string text, replace all spaces in it with underscores,\n    and if a string has more than 2 consecutive spaces,\n    then replace all consecutive spaces with -\n    \"\"\"\n    # First, replace sequences of three or more consecutive spaces with a single hyphen.\n    # This prevents shorter rules from incorrectly transforming parts of a longer sequence.\n    text = re.sub(r' {3,}', '-', text)\n\n    # Next, replace sequences of exactly two consecutive spaces with two underscore characters.\n    text = re.sub(r' {2}', '__', text)\n\n    # Finally, replace single space characters with a single underscore character.\n    text = text.replace(' ', '_')\n\n    return text", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/141": [{"task_id": "HumanEval/141", "solution": "import re\nclass FileName:\n    \"\"\"Represents a file name and its parsed components.\"\"\"\n    def __init__(self, full_name: str):\n        self.full_name = full_name\n        self.prefix = \"\"\n        self.suffix = \"\"\n        self.digit_count = 0\n        self.dot_count = 0\n        self.starts_with_letter = False\n\n        self._parse_file_name()\n\n    def _parse_file_name(self):\n        # Count digits\n        self.digit_count = sum(1 for char in self.full_name if char.isdigit())\n\n        # Count dots\n        self.dot_count = self.full_name.count('.')\n\n        # Extract prefix and suffix if exactly one dot\n        if self.dot_count == 1:\n            parts = self.full_name.rsplit('.', 1)\n            self.prefix = parts[0]\n            self.suffix = parts[1]\n\n            # Check if prefix starts with a Latin letter\n            if self.prefix and self.prefix[0].isalpha():\n                self.starts_with_letter = True\nclass Validator:\n    \"\"\"Applies all specified business rules to a FileName object.\"\"\"\n    VALID_EXTENSIONS = {'txt', 'exe', 'dll'}\n\n    def is_valid(self, file_name_obj: FileName) -> bool:\n        # BR1: The file name must not contain more than three digits.\n        if file_name_obj.digit_count > 3:\n            return False\n\n        # BR2: The file name must contain exactly one dot.\n        if file_name_obj.dot_count != 1:\n            return False\n\n        # BR3: The substring before the dot must not be empty.\n        if not file_name_obj.prefix:\n            return False\n\n        # BR4: The substring before the dot must start with a Latin letter.\n        if not file_name_obj.starts_with_letter:\n            return False\n\n        # BR5: The substring after the dot must be one of ['txt', 'exe', 'dll'].\n        if file_name_obj.suffix not in self.VALID_EXTENSIONS:\n            return False\n\n        return True\ndef file_name_check(file_name: str) -> str:\n    \"\"\"Checks if the given file_name string is valid according to predefined rules.\"\"\"\n    file_obj = FileName(file_name)\n    validator = Validator()\n\n    if validator.is_valid(file_obj):\n        return 'Yes'\n    else:\n        return 'No'", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/145": [{"task_id": "HumanEval/145", "solution": "def order_by_points(nums):\n    \"\"\"\n    Sorts the given list of integers by the sum of their digits,\n    and then by their original index for stability.\n    \"\"\"\n\n    def _calculate_digit_sum(number: int) -> int:\n        \"\"\"Calculates the sum of the absolute values of the digits of a given integer.\"\"\"\n        s = 0\n        number_abs = abs(number)\n        while number_abs > 0:\n            s += number_abs % 10\n            number_abs //= 10\n        return s\n\n    # Create a list of tuples: (digit_sum, original_index, original_value)\n    # The original_index is included to ensure stable sorting.\n    decorated_list = []\n    for i, num in enumerate(nums):\n        digit_sum = _calculate_digit_sum(num)\n        decorated_list.append((digit_sum, i, num))\n\n    # Sort the decorated list.\n    # Primary key: digit_sum (ascending)\n    # Secondary key: original_index (ascending, for stability)\n    decorated_list.sort()\n\n    # Extract the original values from the sorted decorated list\n    # to form the final sorted list.\n    sorted_nums = [item[2] for item in decorated_list]\n\n    return sorted_nums", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[[1, 11, -1, -11, -12]]], "plus_fail_tests": [[[-5, -12, 9, 15]]]}], "HumanEval/146": [{"task_id": "HumanEval/146", "solution": "def specialFilter(nums):\n    \"\"\"\n    Filters numbers based on multiple criteria: greater than 10,\n    and having both an odd first digit and an odd last digit.\n    \"\"\"\n    def _is_odd(digit):\n        return digit % 2 != 0\n\n    def _get_first_digit(number):\n        number_str = str(abs(number))\n        return int(number_str[0])\n\n    def _get_last_digit(number):\n        return abs(number) % 10\n\n    def _is_greater_than_ten(number):\n        return number > 10\n\n    def _is_first_digit_odd(number):\n        first_digit = _get_first_digit(number)\n        return _is_odd(first_digit)\n\n    def _is_last_digit_odd(number):\n        last_digit = _get_last_digit(number)\n        return _is_odd(last_digit)\n\n    count = 0\n    for num in nums:\n        if _is_greater_than_ten(num) and _is_first_digit_odd(num) and _is_last_digit_odd(num):\n            count += 1\n    return count", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/143": [{"task_id": "HumanEval/143", "solution": "def words_in_sentence(sentence):\n    \"\"\"\n    Filters words from a sentence, keeping only those with prime lengths.\n    Orchestrates validation, parsing, and filtering using helper classes and a utility.\n    \"\"\"\n\n    def _is_prime(n):\n        \"\"\"Checks if a given integer n is a prime number.\"\"\"\n        if n < 2:\n            return False\n        for i in range(2, int(n**0.5) + 1):\n            if n % i == 0:\n                return False\n        return True\n\n    class Word:\n        \"\"\"Represents a single word, storing its text and length, and checking if its length is prime.\"\"\"\n        def __init__(self, text):\n            self.text = text\n            self.length = len(text)\n\n        def is_length_prime(self):\n            return _is_prime(self.length)\n\n    class Sentence:\n        \"\"\"Represents the input sentence, handling validation and splitting into Word objects.\"\"\"\n        def __init__(self, text):\n            self.text = text\n            # Validation (as per design context constraints)\n            # 1 <= len(sentence) <= 100\n            # sentence contains only letters (implicit from problem statement, no explicit check needed based on 'only letters' and 'words separated by a space')\n\n        def split_into_words(self):\n            return [Word(word_text) for word_text in self.text.split(' ')]\n\n    sentence_obj = Sentence(sentence)\n    word_objects = sentence_obj.split_into_words()\n\n    prime_words = []\n    for word_obj in word_objects:\n        if word_obj.is_length_prime():\n            prime_words.append(word_obj.text)\n\n    return \" \".join(prime_words)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/144": [{"task_id": "HumanEval/144", "solution": "def simplify(x, n):\n    \"\"\"Your task is to implement a function that will simplify the expression\n    x * n. The function returns True if x * n evaluates to a whole number and False\n    otherwise. Both x and n, are string representation of a fraction, and have the following format,\n    <numerator>/<denominator> where both numerator and denominator are positive whole numbers.\n\n    You can assume that x, and n are valid fractions, and do not have zero as denominator.\n\n    simplify(\"1/5\", \"5/1\") = True\n    simplify(\"1/6\", \"2/1\") = False\n    simplify(\"7/10\", \"10/2\") = False\n    \"\"\"\n\n    class Fraction:\n        \"\"\"Represents a fraction and parses its string representation.\"\"\"\n        def __init__(self, fraction_string: str):\n            numerator_str, denominator_str = fraction_string.split('/')\n            self.numerator = int(numerator_str)\n            self.denominator = int(denominator_str)\n\n    class CalculationResult:\n        \"\"\"Stores the product components and determines if the result is a whole number.\"\"\"\n        def __init__(self, product_numerator: int, product_denominator: int):\n            self.product_numerator = product_numerator\n            self.product_denominator = product_denominator\n\n        def is_whole_number(self) -> bool:\n            return self.product_numerator % self.product_denominator == 0\n\n    fraction_x = Fraction(x)\n    fraction_n = Fraction(n)\n\n    product_numerator = fraction_x.numerator * fraction_n.numerator\n    product_denominator = fraction_x.denominator * fraction_n.denominator\n\n    result = CalculationResult(product_numerator, product_denominator)\n    return result.is_whole_number()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/148": [{"task_id": "HumanEval/148", "solution": "class Planet:\n    def __init__(self, name: str, orbit_order: int):\n        self.name = name\n        self.orbit_order = orbit_order\n_PLANETS_DATA_LIST = [\n    Planet(\"Mercury\", 0),\n    Planet(\"Venus