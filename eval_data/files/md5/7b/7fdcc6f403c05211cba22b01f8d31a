ged\n            # Store the previous segment\n            if is_word_segment:\n                parts.append(Word(\"\".join(current_part_content)))\n            else:\n                parts.append(Space(\"\".join(current_part_content)))\n            # Start new segment\n            current_part_content = [char]\n            is_word_segment = not char_is_space\n        else: # Same segment type\n            current_part_content.append(char)\n\n    # Add the last segment if any content remains\n    if current_part_content:\n        if is_word_segment:\n            parts.append(Word(\"\".join(current_part_content)))\n        else:\n            parts.append(Space(\"\".join(current_part_content)))\n\n    return parts\ndef anti_shuffle(s):\n    \"\"\"\n    Write a function that takes a string and returns an ordered version of it.\n    Ordered version of string, is a string where all words (separated by space)\n    are replaced by a new word where all the characters arranged in\n    ascending order based on ascii value.\n    Note: You should keep the order of words and blank spaces in the sentence.\n\n    For example:\n    anti_shuffle('Hi') returns 'Hi'\n    anti_shuffle('hello') returns 'ehllo'\n    anti_shuffle('Hello World!!!') returns 'Hello !!!Wdlor'\n    \"\"\"\n    processed_parts = []\n    parts = _split_into_parts(s)\n    for part in parts:\n        processed_parts.append(part.to_string())\n    return \"\".join(processed_parts)", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [["\n\n123 456\n789\n"]]}], "HumanEval/87": [{"task_id": "HumanEval/87", "solution": "def get_row(lst, x):\n    \"\"\"\n    Finds integers x in the nested list lst and returns a list of (row, column) coordinates.\n    Coordinates are 0-indexed and sorted primarily by row (ascending) and then by column (descending).\n    \"\"\"\n    found_coordinates = []\n    for row_idx, row in enumerate(lst):\n        for col_idx, item in enumerate(row):\n            if item == x:\n                found_coordinates.append((row_idx, col_idx))\n\n    # Sort primarily by row in ascending order, and secondarily by column in descending order.\n    found_coordinates.sort(key=lambda coord: (coord[0], -coord[1]))\n    return found_coordinates", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/84": [{"task_id": "HumanEval/84", "solution": "def solve(N):\n    \"\"\"Given a positive integer N, return the total sum of its digits in binary.\"\"\"\n\n    class IntegerInput:\n        \"\"\"Encapsulates the input integer N and provides validation for its range.\"\"\"\n        def __init__(self, value: int, min_val: int = 0, max_val: int = 10000):\n            self._value = value\n            self._min_constraint = min_val\n            self._max_constraint = max_val\n\n        def get_value(self) -> int:\n            return self._value\n\n        def validate_range(self) -> bool:\n            \"\"\"Checks if the encapsulated value is within the specified min and max values.\"\"\"\n            return self._min_constraint <= self._value <= self._max_constraint\n\n\n    class DigitSumCalculator:\n        \"\"\"Calculates the sum of the decimal digits of a given integer.\"\"\"\n        def calculate(self, input_value: int) -> int:\n            \"\"\"Computes the sum of decimal digits for input_value.\"\"\"\n            total_sum = 0\n            for digit_char in str(input_value):\n                total_sum += int(digit_char)\n            return total_sum\n\n\n    class BinaryConverter:\n        \"\"\"Converts a decimal integer into its binary string representation.\"\"\"\n        def convert(self, decimal_sum: int) -> str:\n            \"\"\"Converts decimal_sum to its binary string representation.\"\"\"\n            if decimal_sum == 0:\n                return \"0\"\n            return bin(decimal_sum)[2:]\n\n\n    class BinaryOutput:\n        \"\"\"Stores and provides the final binary string output.\"\"\"\n        def __init__(self, binary_string: str):\n            self._binary_string = binary_string\n\n        def get_binary_string(self) -> str:\n            return self._binary_string\n\n\n    integer_input = IntegerInput(N, 0, 10000)\n    if not integer_input.validate_range():\n        raise ValueError(f\"Input N out of range [{integer_input._min_constraint}, {integer_input._max_constraint}]\")\n\n    digit_sum_calculator = DigitSumCalculator()\n    decimal_sum = digit_sum_calculator.calculate(integer_input.get_value())\n\n    binary_converter = BinaryConverter()\n    binary_string_result = binary_converter.convert(decimal_sum)\n\n    binary_output = BinaryOutput(binary_string_result)\n    return binary_output.get_binary_string()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/88": [{"task_id": "HumanEval/88", "solution": "def sort_array(array):\n    \"\"\"\n    Given an array of non-negative integers, return a copy of the given array after sorting.\n    The sorting order depends on the parity of the sum of the first and last elements.\n    \"\"\"\n    n = len(array)\n\n    # Handle empty or single-element arrays by returning a copy.\n    if n <= 1:\n        return array.copy()\n\n    # Determine sorting order based on sum of first and last elements.\n    first_element = array[0]\n    last_element = array[n - 1]\n    sum_elements = first_element + last_element\n\n    # Create a new array to avoid modifying the original.\n    new_array = array.copy()\n\n    if sum_elements % 2 != 0:  # Sum is odd, sort ascending.\n        new_array.sort()\n    else:  # Sum is even, sort descending.\n        new_array.sort(reverse=True)\n\n    return new_array", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/90": [{"task_id": "HumanEval/90", "solution": "def next_smallest(lst):\n    \"\"\"\n    Returns the 2nd smallest unique element from the list, or