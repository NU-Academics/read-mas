 the cells that the minimum path go through.\n\n    Examples:\n\n        Input: grid = [ [1,2,3], [4,5,6], [7,8,9]], k = 3\n        Output: [1, 2, 1]\n\n        Input: grid = [ [5,9,3], [4,1,6], [7,8,2]], k = 1\n        Output: [1]\n    \"\"\"\n\n    # Custom Exceptions\n    class InvalidGridDimensionsError(ValueError):\n        def __init__(self, message: str = \"Invalid grid dimensions: Must be N x N with N >= 2.\"):\n            super().__init__(message)\n\n    class InvalidGridValuesError(ValueError):\n        def __init__(self, message: str = \"Invalid grid values: Must contain unique integers from 1 to N*N.\"):\n            super().__init__(message)\n\n    class InvalidPathLengthError(ValueError):\n        def __init__(self, message: str = \"Invalid path length k: Must be a positive integer.\"):\n            super().__init__(message)\n\n    # Cell class\n    class Cell:\n        def __init__(self, row: int, col: int, value: int):\n            self._row = row\n            self._col = col\n            self._value = value\n\n        def get_row(self) -> int:\n            return self._row\n\n        def get_col(self) -> int:\n            return self._col\n\n        def get_value(self) -> int:\n            return self._value\n\n        def get_neighbors(self, grid_instance: 'Grid') -> list['Cell']:\n            neighbors = []\n            moves = [(-1, 0), (1, 0), (0, -1), (0, 1)] # Up, Down, Left, Right\n\n            for dr, dc in moves:\n                new_row, new_col = self._row + dr, self._col + dc\n                if grid_instance.is_valid_coordinate(new_row, new_col):\n                    neighbors.append(grid_instance.get_cell(new_row, new_col))\n            return neighbors\n\n    # Grid class\n    class Grid:\n        def __init__(self, grid_data: list[list[int]]):\n            self._N = self._validate_dimensions(grid_data)\n            self._cells: list[list[Cell]] = []\n            self._initialize_cells(grid_data)\n            self._validate_values(grid_data, self._N)\n\n        def _validate_dimensions(self, grid_data: list[list[int]]) -> int:\n            if not grid_data or not isinstance(grid_data, list):\n                raise InvalidGridDimensionsError(\"Grid cannot be empty or non-list.\")\n            N = len(grid_data)\n            if N < 2:\n                raise InvalidGridDimensionsError(f\"Grid dimension N must be >= 2, got {N}.\")\n            for row in grid_data:\n                if not isinstance(row, list) or len(row) != N:\n                    raise InvalidGridDimensionsError(f\"Grid must be N x N, found irregular row length or non-list row.\")\n            return N\n\n        def _initialize_cells(self, grid_data: list[list[int]]):\n            for r in range(self._N):\n                row_cells = []\n                for c in range(self._N):\n                    row_cells.append(Cell(r, c, grid_data[r][c]))\n                self._cells.append(row_cells)\n\n        def _validate_values(self, grid_data: list[list[int]], N: int):\n            expected_values = set(range(1, N * N + 1))\n            actual_values = set()\n            for r in range(N):\n                for c in range(N):\n                    value = grid_data[r][c]\n                    if not isinstance(value, int):\n                        raise InvalidGridValuesError(f\"Grid values must be integers, found {type(value)}.\")\n                    if value in actual_values:\n                        raise InvalidGridValuesError(f\"Duplicate value {value} found in grid.\")\n                    if value not in expected_values:\n                        raise InvalidGridValuesError(f\"Value {value} out of range [1, {N*N}].\")\n                    actual_values.add(value)\n            if actual_values != expected_values:\n                raise InvalidGridValuesError(f\"Missing values in grid. Expected {expected_values}, got {actual_values}.\")\n\n        def get_N(self) -> int:\n            return self._N\n\n        def get_cell(self, row: int, col: int) -> Cell:\n            if not self.is_valid_coordinate(row, col):\\\n                raise IndexError(f\"Coordinates ({row}, {col}) are out of grid bounds.\")\n            return self._cells[row][col]\n\n        def is_valid_coordinate(self, row: int, col: int) -> bool:\n            return 0 <= row < self._N and 0 <= col < self._N\n\n    # Path class", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[[[1, 2, 3], [4, 5, 6], [7, 8, 9]], 3]], "plus_fail_tests": [[[[1, 2, 3], [4, 5, 6], [7, 8, 9]], 1]]}], "HumanEval/135": [{"task_id": "HumanEval/135", "solution": "def can_arrange(arr):\n    \"\"\"Finds the largest index where an element is strictly less than its predecessor.\n    Returns -1 if no such element exists.\"\"\"\n    largest_decreasing_index = -1\n\n    if len(arr) < 2:\n        return -1\n\n    for i in range(1, len(arr)):\n        if arr[i] < arr[i-1]:\n            largest_decreasing_index = i\n\n    return largest_decreasing_index", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/136": [{"task_id": "HumanEval/136", "solution": "def largest_smallest_integers(lst):\n    '''\n    Finds the largest negative integer and the smallest positive integer in a list.\n    Returns them as a tuple (largest_negative, smallest_positive), using None if a category is missing.\n    '''\n    largest_neg = None\n    smallest_pos = None\n\n    for num in lst:\n        if num < 0:\n            if largest_neg is None or num > largest_neg:\n                largest_neg = num\n        elif num > 0:\n            if smallest_pos is None or num < smallest_pos:\n                smallest_pos = num\n\n    return (largest_neg, smallest_pos)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/138": [{"task_id": "HumanEval/138", "solution": "def is_equal_to_sum_even(n):\n    \"\"\"Evaluate whether the given number n can be written as the sum of ex