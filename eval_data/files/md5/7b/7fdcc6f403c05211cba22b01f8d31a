es.\n    A difference of 0 indicates a correct guess.\"\"\"\n\n    comparison_results = []\n    for i in range(len(game)):\n        if game[i] == guess[i]:\n            comparison_results.append(0)\n        else:\n            comparison_results.append(abs(game[i] - guess[i]))\n\n    return comparison_results", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/147": [{"task_id": "HumanEval/147", "solution": "def get_max_triples(n):\n    \"\"\"\n    You are given a positive integer n. You have to create an integer array a of length n.\n        For each i (1 \u2264 i \u2264 n), the value of a[i] = i * i - i + 1.\n        Return the number of triples (a[i], a[j], a[k]) of a where i < j < k,\n    and a[i] + a[j] + a[k] is a multiple of 3.\n\n    Example :\n        Input: n = 5\n        Output: 1\n        Explanation:\n        a = [1, 3, 7, 13, 21]\n        The only valid triple is (1, 7, 13).\n    \"\"\"\n\n    # We need to find triples (a[i], a[j], a[k]) such that i < j < k\n    # and (a[i] + a[j] + a[k]) % 3 == 0.\n    # This is equivalent to ((a[i] % 3) + (a[j] % 3) + (a[k] % 3)) % 3 == 0.\n\n    # Let's analyze the remainder of a[x] when divided by 3:\n    # a[x] = x * x - x + 1\n\n    # If x % 3 == 0: a[x] % 3 = (0*0 - 0 + 1) % 3 = 1\n    # If x % 3 == 1: a[x] % 3 = (1*1 - 1 + 1) % 3 = 1\n    # If x % 3 == 2: a[x] % 3 = (2*2 - 2 + 1) % 3 = (4 - 2 + 1) % 3 = 3 % 3 = 0\n\n    # So, a[x] % 3 is 0 if x % 3 == 2.\n    # And a[x] % 3 is 1 if x % 3 == 0 or x % 3 == 1.\n\n    # We need the sum of three remainders to be a multiple of 3.\n    # Given that the possible remainders for a[x] are only 0 and 1:\n    # 1. (0 + 0 + 0) % 3 = 0  (Choose 3 numbers where a[x] % 3 == 0)\n    # 2. (1 + 1 + 1) % 3 = 0  (Choose 3 numbers where a[x] % 3 == 1)\n    # No other combination of 0s and 1s sums to a multiple of 3 (e.g., 0+0+1=1, 0+1+1=2).\n\n    # Count how many numbers a[x] fall into each remainder category (0 or 1).\n    count_rem_0 = 0  # Count of a[x] where a[x] % 3 == 0 (i.e., x % 3 == 2)\n    count_rem_1 = 0  # Count of a[x] where a[x] % 3 == 1 (i.e., x % 3 == 0 or x % 3 == 1)\n\n    for i in range(1, n + 1):\n        if (i % 3) == 2:\n            count_rem_0 += 1\n        else:\n            count_rem_1 += 1\n\n    total_triples = 0\n\n    # Calculate combinations for triples where all three a[x] % 3 == 0\n    # Number of ways to choose 3 items from N is N * (N-1) * (N-2) / 6\n    if count_rem_0 >= 3:\n        total_triples += (count_rem_0 * (count_rem_0 - 1) * (count_rem_0 - 2)) // 6\n\n    # Calculate combinations for triples where all three a[x] % 3 == 1\n    if count_rem_1 >= 3:\n        total_triples += (count_rem_1 * (count_rem_1 - 1) * (count_rem_1 - 2)) // 6\n\n    return total_triples", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/158": [{"task_id": "HumanEval/158", "solution": "def find_max(words):\n    \"\"\"Write a function that accepts a list of strings.\n    The list contains different words. Return the word with maximum number\n    of unique characters. If multiple strings have maximum number of unique\n    characters, return the one which comes first in lexicographical order.\n    \"\"\"\n    def _calculate_unique_char_count(word: str) -> int:\n        \"\"\"Calculates the number of unique characters in a given string.\"\"\"\n        return len(set(word))\n\n    if not words:\n        return \"\"\n\n    best_word = \"\"\n    max_unique_count = -1\n\n    for current_word in words:\n        current_unique_count = _calculate_unique_char_count(current_word)\n\n        if current_unique_count > max_unique_count:\n            max_unique_count = current_unique_count\n            best_word = current_word\n        elif current_unique_count == max_unique_count:\n            # Tie-breaking: return the one which comes first in lexicographical order.\n            if current_word < best_word:\n                best_word = current_word\n\n    return best_word", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/157": [{"task_id": "HumanEval/157", "solution": "def right_angle_triangle(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle. Return True if the three\n    sides form a right-angled triangle, False otherwise.\n    A right-angled triangle is a triangle in which one angle is right angle or\n    90 degree.\n    Example:\n    right_angle_triangle(3, 4, 5) == True\n    right_angle_triangle(1, 2, 3) == False\n    '''\n    class Triangle:\n        def __init__(self, side_a: float, side_b: float, side_c: float):\n            self._side_a = side_a\n            self._side_b = side_b\n            self._side_c = side_c\n\n        def _is_valid_triangle_sides(self) -> bool:\n            \"\"\"Checks if all side lengths are positive.\"\"\"\n            return self._side_a > 0 and self._side_b > 0 and self._side_c > 0\n\n        def _satisfies_triangle_inequality(self) -> bool:\n            \"\"\"Checks if the side lengths satisfy the Triangle Inequality Theorem.\"\"\"\n            return (self._side_a + self._side_b > self._side_c and\n                    self._side_a + self._side_c > self._side_b and\n                    self._side_b + self._side_c > self._side_a)\n\n        def is_right_angled(self) -> bool:\n            \"\"\"Determines if the triangle is right-angled, including validity checks.\"\"\"\n            if not self._is_valid_triangle_sides():\n                return False\n            if not self._satisfies_triangle_inequality():\n                return False\n\n            # Apply Pythagorean theorem using a small epsilon for floating-point comparison.\n            sides = sorted([self._side_a, self._side_b, self._side_c])\n            s1, s2, s3 = sides[0], sides[1], sides[2]\n\n            epsilon = 1e-9\n            return abs(s1*s1 + s2*s2 - s3*s3) < epsilon\n\n    triangle_obj = Triangle(a, b, c)\n    return triangle_obj.is_right_angled()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/161": [{"task_id": "HumanEval/161", "solution": "def solve(s):\n    \"\"\"You are given a string s.\n    if s[i] is a letter, reverse its case from lower to upper or vise versa,\n    otherwise keep it as it is.\n    If the string contains no letters, reverse the string.\n    The function should return the resulted string.\n    \"\"\"\n    has_letters = False\n    for char in s:\n        if char.isalpha():\n            has_letters = True\n            break\n\n    if not has_letters:\n        return s[::-1]\n    else:\n        result_chars = []\n        for char in s:\n            if char.isalpha():\n                if char.islower():\n                    result_chars.append(char.upper())\n                else:  # char.isupper()\n                    result_chars.append(char.lower())\n            else:\n                result_chars.append(char)\n        return \"\".join(result_chars)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/154": [{"task_id": "HumanEval/154", "solution": "class Rotation:\n    \"\"\"Represents a single cyclic rotation of a word.\"\"\"\n    def __init__(self, rotated_value: str):\n        self._rotated_value = rotated_value\n\n    def get_rotated_value(self) -> str:\n        \"\"\"Returns the rotated string value.\"\"\"\n        return self._rotated_value\nclass Word:\n    \"\"\"Encapsulates a string value and provides methods for string operations.\"\"\"\n    def __init__(self, value: str):\n        self._value = value\n\n    def get_value(self) -> str:\n        \"\"\"Returns the encapsulated string value.\"\"\"\n        return self._value\n\n    def get_rotations(self) -> list['Rotation']:\n        \"\"\"Generates and returns a list of unique cyclic Rotation objects.\"\"\"\n        rotations = []\n        seen_rotations = set()\n        n = len(self._value)\n        if n == 0:\n            return []\n        for i in range(n):\n            rotated_str = self._value[i:] + self._value[:i]\n            if rotated_str not in seen_rotations:\n                rotations.append(Rotation(rotated_str))\n                seen_rotations.add(rotated_str)\n        return rotations\n\n    def is_substring_of(self, other_word: 'Word') -> bool:\n        \"\"\"Checks if this word's value is a substring of other_word's value.\"\"\"\n        return self._value in other_word.get_value()\ndef cycpattern_check(a , b):\n    \"\"\"You are given 2 words. You need to return True if the second word or any of its rotations is a substring in the first word.\"\"\"\n    word_a = Word(a)\n    word_b = Word(b)\n\n    # First, check if word_b itself is a substring of word_a\n    if word_b.is_substring_of(word_a):\n        return True\n\n    # Get all rotations of word_b and check if any is a substring of word_a\n    rotations_of_b = word_b.get_rotations()\n    for rotation_obj in rotations_of_b:\n        rotated_word_value = rotation_obj.get_rotated_value()\n        current_rotated_word = Word(rotated_word_value)\n        if current_rotated_word.is_substring_of(word_a):\n            return True\n\n    return False", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/159": [{"task_id": "HumanEval/159", "solution": "def eat(number, need, remaining):\n    \"\"\"\n    Calculates the total number of carrots eaten and the remaining carrots after a meal.\n    The rabbit eats as many carrots as needed, or all remaining carrots if stock is insufficient.\n    \"\"\"\n    carrots_eaten_in_meal = min(need, remaining)\n\n    total_eaten_carrots = number + carrots_eaten_in_meal\n    carrots_left_in_stock = remaining - carrots_eaten_in_meal\n\n    return [total_eaten_carrots, carrots_left_in_stock]", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/160": [{"task_id": "HumanEval/160", "solution": "def do_algebra(operator, operand):\n    \"\"\"\n    Constructs and evaluates an algebraic expression from lists of operators and operands.\n    \"\"\"\n    expression_parts = []\n    expression_parts.append(str(operand[0]))\n\n    for i in range(len(operator)):\n        expression_parts.append(operator[i])\n        expression_parts.append(str(operand[i+1]))\n\n    expression_string = \" \".join(expression_parts)\n    result = eval(expression_string)\n    return result", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/162": [{"task_id": "HumanEval/162", "solution": "import hashlib\ndef string_to_md5(text):\n    \"\"\"\n    Given a string 'text', return its md5 hash equivalent string.\n    If 'text' is an empty string, return None.\n    \"\"\"\n    if not text:\n        return None\n    md5_hash = hashlib.md5(text.encode('utf-8'))\n    return md5_hash.hexdigest()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/163": [{"task_id": "HumanEval/163", "solution": "def generate_integers(a, b):\n    \"\"\"\n    Given two positive integers a and b, return the even digits between a\n    and b, in ascending order.\n\n    For example:\n    generate_integers(2, 8) => [2, 4, 6, 8]\n    generate_integers(8, 2) => [2, 4, 6, 8]\n    generate_integers(10, 14) => []\n    \"\"\"\n    min_val = min(a, b)\n    max_val = max(a, b)\n\n    result_list = []\n    for i in range(min_val, max_val + 1):\n        # Check if 'i' is an even single-digit number (0, 2, 4, 6, 8).\n        if 0 <= i <= 8 and i % 2 == 0:\n            result_list.append(i)\n\n    return result_list", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[987654321, 123456789]]}], "HumanEval/94": [{"task_id": "HumanEval/94", "solution": "def skjkasdkd(lst):\n    \"\"\"Finds the largest prime in a list of integers and returns the sum of its digits.\n    Returns 0 if no prime numbers are found in the list.\n    \"\"\"\n\n    # Helper function to check if a number is prime.\n    def _is_prime(n):\n        if n < 2:\n            return False\n        if n == 2:\n            return True\n        if n % 2 == 0:\n            return False\n        # Check for factors from 3 up to sqrt(n), only odd numbers.\n        # Using i*i <= n instead of math.sqrt(n) to avoid external modules.\n        i = 3\n        while i * i <= n:\n            if n % i == 0:\n                return False\n            i += 2\n        return True\n\n    # Helper function to calculate the sum of digits of a number.\n    def _sum_digits(n):\n        s = 0\n        while n > 0:\n            s += n % 10\n            n //= 10\n        return s\n\n    largest_prime = 0\n\n    for num in lst:\n        if _is_prime(num):\n            if num > largest_prime:\n                largest_prime = num\n\n    # If largest_prime is still 0, it means no prime numbers were found in the list.\n    if largest_prime == 0:\n        return 0\n    else:\n        return _sum_digits(largest_prime)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/15": [{"task_id": "HumanEval/15", "solution": "def string_sequence(n: int) -> str:\n    \"\"\" Return a string containing space-delimited numbers starting from 0 upto n inclusive.\n    \"\"\"\n    return ' '.join(str(i) for i in range(n + 1))", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/130": [{"task_id": "HumanEval/130", "solution": "def tri(n):\n    \"\"\"Everyone knows Fibonacci sequence, it was studied deeply by mathematicians in\n    the last couple centuries. However, what people don't know is Tribonacci sequence.\n    Tribonacci sequence is defined by the recurrence:\n    tri(1) = 3\n    tri(n) = 1 + n / 2, if n is even.\n    tri(n) =  tri(n - 1) + tri(n - 2) + tri(n + 1), if n is odd.\n    For example:\n    tri(2) = 1 + (2 / 2) = 2\n    tri(4) = 3\n    tri(3) = tri(2) + tri(1) + tri(4)\n           = 2 + 3 + 3 = 8\n    You are given a non-negative integer number n, you have to a return a list of the\n    first n + 1 numbers of the Tribonacci sequence.\n    Examples:\n    tri(3) = [1, 3, 2, 8]\n    \"\"\"\n    _memo = {0: 1, 1: 3}  # Initial base cases for tri(0) and tri(1).\n\n    def _get_term(k):\n        \"\"\"Helper function to calculate a single Tribonacci term tri(k) using memoization.\"\"\"\n        if k in _memo:\n            return _memo[k]\n\n        if k % 2 == 0:  # If k is an even number (and k > 0, as k=0 is in _memo)\n            # tri(k) = 1 + k / 2, if k is even. Integer division is used as per examples.\n            result = 1 + k // 2\n        else:  # If k is an odd number (and k > 1, as k=1 is in _memo)\n            # tri(k) = tri(k - 1) + tri(k - 2) + tri(k + 1), if k is odd.\n            # This handles the forward dependency by recursively calculating tri(k + 1).\n            term_k_minus_1 = _get_term(k - 1)\n            term_k_minus_2 = _get_term(k - 2)\n            term_k_plus_1 = _get_term(k + 1)\n            result = term_k_minus_1 + term_k_minus_2 + term_k_plus_1\n\n        _memo[k] = result\n        return result\n\n    sequence = []\n    # Generate the sequence from tri(0) up to tri(n) (inclusive).\n    for i in range(n + 1):\n        sequence.append(_get_term(i))\n\n    return sequence", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/139": [{"task_id": "HumanEval/139", "solution": "def special_factorial(n):\n    \"\"\"The Brazilian factorial is defined as:\n    brazilian_factorial(n) = n! * (n-1)! * (n-2)! * ... * 1!\n    where n > 0\n\n    For example:\n    >>> special_factorial(4)\n    288\n\n    The function will receive an integer as input and should return the special\n    factorial of this integer.\n    \"\"\"\n    if n <= 0:\n        raise ValueError(\"n must be > 0\")\n\n    def _factorial(k):\n        \"\"\"Helper function to compute k!.\"\"\"\n        if k == 0:\n            return 1\n        res = 1\n        for i in range(1, k + 1):\n            res *= i\n        return res\n\n    special_fact_result = 1\n    for i in range(n, 0, -1):\n        special_fact_result *= _factorial(i)\n\n    return special_fact_result", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}]}}