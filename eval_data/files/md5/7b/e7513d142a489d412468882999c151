{"task_id": "Mbpp/69", "solution": "def is_sublist(sequence, sub_sequence):\n    \"\"\"\n    Checks if a list contains the given sublist contiguously.\n    \"\"\"\n    n = len(sequence)\n    m = len(sub_sequence)\n\n    if m == 0:\n        return True  # An empty sublist is always considered a sublist.\n    if m > n:\n        return False  # A sublist cannot be longer than the main list.\n\n    for i in range(n - m + 1):\n        if sequence[i:i + m] == sub_sequence:\n            return True\n\n    return False"}
{"task_id": "Mbpp/70", "solution": "import typing\n\ndef get_equal(collection: typing.Iterable[typing.Tuple]) -> bool:\n    \"\"\"\n    Checks if all tuples in the given collection have the same length.\n    Returns True if the collection is empty or all tuples have equal length, False otherwise.\n    \"\"\"\n    iterator = iter(collection)\n\n    try:\n        # Attempt to get the first tuple and its length from the iterator.\n        first_tuple = next(iterator)\n        first_len = len(first_tuple)\n    except StopIteration:\n        # If the iterator is empty, the collection was empty, which is considered equal.\n        return True\n\n    # Check if all remaining tuples in the collection have the same length as the first one.\n    return all(len(t) == first_len for t in iterator)"}
{"task_id": "Mbpp/74", "solution": "def is_samepatterns(seq1, seq2):\n    \"\"\"\n    Checks if two sequences follow the same pattern mapping, ensuring consistency and injectivity.\n    \"\"\"\n    if len(seq1) != len(seq2):\n        return False\n\n    map1 = {}\n    map2 = {}\n\n    for i in range(len(seq1)):\n        item1 = seq1[i]\n        item2 = seq2[i]\n\n        if item1 not in map1:\n            map1[item1] = item2\n        elif map1[item1] != item2:\n            return False\n\n        if item2 not in map2:\n            map2[item2] = item1\n        elif map2[item2] != item1:\n            return False\n\n    return True"}
{"task_id": "Mbpp/71", "solution": "from typing import List, TypeVar\n\nT = TypeVar(\"T\")\n\nclass CombSortAlgorithm:\n    \"\"\"Implements the Comb Sort algorithm.\"\"\"\n    DEFAULT_GAP_SHRINK: float = 1.3\n\n    def sort(self, elements: List[T]) -> List[T]:\n        \"\"\"\n        Sorts a list using the comb sort algorithm in non-decreasing order.\n        Returns a new sorted list, leaving the original list unchanged.\n        \"\"\"\n        arr = list(elements)  # Create a copy to be non-destructive\n        n = len(arr)\n        gap = n\n        swapped = True\n\n        while gap > 1 or swapped:\n            gap = self._next_gap(gap)\n            swapped = False\n            for i in range(n - gap):\n                if arr[i] > arr[i + gap]:\n                    arr[i], arr[i + gap] = arr[i + gap], arr[i]\n                    swapped = True\n        return arr\n\n    def _next_gap(self, gap: int) -> int:\n        \"\"\"\n        Calculates the next gap value for the comb sort.\n        The gap shrinks by DEFAULT_GAP_SHRINK factor, ensuring it's at least 1.\n        \"\"\"\n        new_gap = int(gap / self.DEFAULT_GAP_SHRINK)\n        if new_gap < 1:\n            return 1\n        return new_gap\n\ndef comb_sort(elements: List[T]) -> List[T]:\n    \"\"\"\n    A convenience wrapper function that sorts a list using the Comb Sort algorithm.\n    It creates an instance of CombSortAlgorithm and calls its sort method.\n    \"\"\"\n    return CombSortAlgorithm().sort(elements)"}
{"task_id": "Mbpp/72", "solution": "from typing import Any\n\nclass InvalidInputError(Exception):\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\nclass Validator:\n    def validate_int(self, value: Any) -> int:\n        if isinstance(value, int):\n            return value\n        if isinstance(value, str):\n            # Check if the string represents an integer (handles signs)\n            # lstrip(\"+-\") removes leading plus or minus signs\n            if value.strip().lstrip(\"+-\").isdigit():\n                return int(value)\n        raise InvalidInputError(f\"Value {value!r} is not a valid integer\")\n\nclass DifferenceOfSquaresService:\n    def can_be_expressed(self, n: int) -> bool:\n        # An integer n can be expressed as a difference of two integer squares\n        # if and only if n is not congruent to 2 modulo 4 (i.e., n % 4 != 2).\n        return (n % 4) != 2\n\nclass NumberModel:\n    def __init__(self, value: int) -> None:\n        self.value = value\n\n    def __repr__(self) -> str:\n        return f\"NumberModel(value={self.value})\"\n\nclass CLIController:\n    def __init__(self, service: DifferenceOfSquaresService, validator: Validator) -> None:\n        self.service = service\n        self.validator = validator\n\n    def check(self, n: Any) -> bool:\n        # Validates input, constructs a model, and delegates to the service for computation.\n        int_value = self.validator.validate_int(n)\n        model = NumberModel(int_value) # Encapsulates the validated integer.\n        return self.service.can_be_expressed(model.value)\n\ndef dif_Square(n: Any) -> bool:\n    \"\"\"\n    Checks if the given number can be represented as the difference of two squares.\n    \"\"\"\n    validator = Validator()\n    service = DifferenceOfSquaresService()\n    controller = CLIController(service=service, validator=validator)\n    return controller.check(n)"}
{"task_id": "Mbpp/75", "solution": "def find_tuples(list_of_tuples: list[tuple[int, ...]], k: int) -> list[tuple[int, ...]]:\n    \"\"\"\n    Finds tuples from a list where all elements in the tuple are divisible by k.\n    Assumes k is a non-zero integer and tuple elements are integers.\n    \"\"\"\n    if not isinstance(k, int):\n        raise ValueError(\"k must be an integer\")\n    if k == 0:\n        raise ValueError(\"k must not be zero\")\n\n    matching_tuples: list[tuple[int, ...]] = []\n    for tup in list_of_tuples:\n        if not isinstance(tup, tuple):\n            raise ValueError(\"All items in list_of_tuples must be tuples\")\n        if all(isinstance(element, int) and element % k == 0 for element in tup):\n            matching_tuples.append(tup)\n    return matching_tuples"}
