rted) and (i, j + 1) not in visited:\n                heapq.heappush(heap, (-(a_sorted[i] * b_sorted[j+1]), i, j + 1))\n                visited.add((i, j + 1))\n\n        return results\n\n    def _compute_top_k_selector(algo_list_a, algo_list_b, algo_k):\n        \"\"\"Selects between brute-force and heap algorithm based on list sizes.\"\"\"\n        total_combinations = len(algo_list_a) * len(algo_list_b)\n        if total_combinations == 0:\n            return []\n        if total_combinations <= MAX_BRUTE_FORCE_SIZE:\n            return _brute_force_top_k(algo_list_a, algo_list_b, algo_k)\n        else:\n            return _heap_top_k(algo_list_a, algo_list_b, algo_k)\n\n    def _get_top_k_service(service_list_a, service_list_b, service_k, service_deduplicate):\n        \"\"\"Orchestrates caching and product computation.\"\"\"\n        cache_key = _fingerprint(service_list_a, service_list_b, service_k, service_deduplicate)\n        cached_result = large_product._cache_repo.get(cache_key)\n        if cached_result is not None:\n            return cached_result\n\n        float_a = [float(x) for x in service_list_a]\n        float_b = [float(x) for x in service_list_b]\n\n        result_raw = _compute_top_k_selector(float_a, float_b, service_k)\n\n        final_result = []\n        if service_deduplicate:\n            seen = set()\n            for prod in result_raw:\n                if prod not in seen:\n                    final_result.append(prod)\n                    seen.add(prod)\n        else:\n            final_result = result_raw\n\n        # Ensure the final result count does not exceed k (after potential deduplication).\n        if len(final_result) > service_k:\n            final_result = final_result[:service_k]\n\n        large_product._cache_repo.set(cache_key, final_result)\n        return final_result\n\n    # Main controller logic for the large_product function.\n    if not _validate_list_numbers(list_a) or not _validate_list_numbers(list_b):\n        raise ValueError(\"Both inputs must be non-empty iterables of numbers.\")\n    if not isinstance(k, int) or k <= 0:\n        raise ValueError(\"k must be a positive integer.\")\n\n    # Convert inputs to floats for consistent arithmetic operations.\n    float_list_a = [float(x) for x in list_a]\n    float_list_b = [float(x) for x in list_b]\n\n    return _get_top_k_service(float_list_a, float_list_b, k, deduplicate)"}
{"task_id": "Mbpp/312", "solution": "import math\n\ndef volume_cone(radius: float, height: float) -> float:\n    \"\"\"\n    Calculates the volume of a cone given its radius and height.\n    The formula used is V = (1/3) * \u03c0 * r^2 * h.\n    \"\"\"\n    return (1.0 / 3.0) * math.pi * (radius ** 2) * height"}
{"task_id": "Mbpp/388", "solution": "def highest_Power_of_2(n):\n    \"\"\"\n    Finds the highest power of 2 that is less than or equal to n.\n    Returns 0 if n is less than or equal to 0.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n    if n <= 0:\n        return 0\n\n    # The highest power of two <= n is 1 shifted left by (bit_length - 1)\n    return 1 << (n.bit_length() - 1)"}
{"task_id": "Mbpp/389", "solution": "def find_lucas(n: int) -> int:\n    class LucasError(Exception):\n        def __init__(self, message: str):\n            super().__init__(message)\n            self.message = message\n\n    class InvalidInputError(LucasError):\n        pass\n\n    class LucasNumber:\n        def __init__(self, value: int) -> None:\n            if not isinstance(value, int) or value < 0:\n                raise InvalidInputError(\"LucasNumber value must be a non-negative integer\")\n            self.value: int = value\n\n        def to_int(self) -> int:\n            return self.value\n\n    DEFAULT_MAX_SIZE = 10000\n\n    class SimpleCache:\n        def __init__(self, max_size: int = DEFAULT_MAX_SIZE) -> None:\n            self._store: dict[int, int] = {}\n            self._max_size = max_size\n\n        def get(self, key: int) -> int | None:\n            return self._store.get(key)\n\n        def set(self, key: int, value: int) -> None:\n            if len(self._store) >= self._max_size:\n                self._store.pop(next(iter(self._store)))\n            self._store[key] = value\n\n        def clear(self) -> None:\n            self._store.clear()\n\n    class InputValidator:\n        def validate_n(self, n: object) -> int:\n            try:\n                if isinstance(n, str):\n                    n_int = int(n.strip())\n                elif isinstance(n, float):\n                    if not n.is_integer():\n                        raise InvalidInputError(\"n must be an integer\")\n                    n_int = int(n)\n                else:\n                    n_int = int(n)\n            except (ValueError, TypeError):\n                raise InvalidInputError(f\"Invalid n: {n!r}\")\n            if n_int < 0:\n                raise InvalidInputError(\"n must be non-negative\")\n            return n_int\n\n    class LucasService:\n        def __init__(self, cache: SimpleCache | None = None) -> None:\n            self.cache = cache or SimpleCache()\n            self.cache.set(0, 2)\n            self.cache.set(1, 1)\n\n        def compute(self, n: int) -> LucasNumber:\n            cached = self.cache.get(n)\n            if cached is not None:\n                return LucasNumber(cached)\n            value = self._compute_iterative(n)\n            self.cache.set(n, value)\n            return LucasNumber(value)\n\n        def _compute_iterative(self, n: int) -> int:\n            if n == 0:\n                return 2\n            if n == 1:\n                return 1\n            a, b = 2, 1\n            for _ in range(2, n + 1):\n                a, b = b, a + b\n            return b\n\n    validator = InputValidator()\n    service = LucasService()\n\n    validated_n = validator.validate_n(n)\n    lucas_number = service.compute(validated_n)\n    return lucas_number.to_int()"}
{"task_id": "Mbpp/390", "solution": "def add_string(items, format_str):\n    \"\"\"\n    Applies a given format string to all elements in a list.\n    \"\"\"\n    formatted_elements = []\n    for item in items:\n        # Convert each item to its string representation before formatting.\n        item_as_str = str(item)\n        # Apply the format string to the string representation of the item.\n        formatted_elements.append(format_str.format(item_as_str))\n    return formatted_elements"}
{"task_id": "Mbpp/391", "solution": "def convert_list_dictionary(*lists):\n    \"\"\"Converts multiple lists into a list of nested dictionaries based on a specific nesting logic.\"\"\"\n    result = []\n    for row in zip(*lists):\n        num_elements = len(row)\n        if num_elements == 2:\n            result.append({row[0]: row[1]})\n        elif num_elements >= 3:\n            nested_value = row[-1]\n            for i in range(num_elements - 2, 0, -1):\n                key = row[i]\n                nested_value = {key: nested_value}\n            result.append({row[0]: nested_value})\n    return result"}
{"task_id": "Mbpp/394", "solution": "def check_distinct(values: tuple) -> bool:\n    \"\"\"\n    Checks if the given tuple contains no duplicate elements.\n    Handles both hashable and unhashable elements correctly.\n    \"\"\"\n    seen_hashable = set()\n    seen_unhashable = []\n\n    for item in values:\n        try:\n            # Attempt to hash the item. If successful, it's hashable.\n            hash(item)\n            if item in seen_hashable:\n                return False\n            seen_hashable.add(item)\n        except TypeError:\n            # Item is unhashable; check against the list of unhashable items seen so far.\n            if item in seen_unhashable:\n                return False\n            seen_unhashable.append(item)\n    return True"}
{"task_id": "Mbpp/392", "solution": "def get_max_sum(n: int) -> int:\n    \"\"\"\n    Computes the maximum sum for f(n) = max((f(n/2) + f(n/3) + f(n/4) + f(n/5)), n) using memoization.\n    Assumes n is a non-negative integer.\n    \"\"\"\n    memo = {}\n\n    def _compute_recursive(k: int) -> int:\n        if k == 0:\n            return 0\n        if k in memo:\n            return memo[k]\n\n        sum_of_parts = (\n            _compute_recursive(k // 2)\n            + _compute_recursive(k // 3)\n            + _compute_recursive(k // 4)\n            + _compute_recursive(k // 5)\n        )\n        result = max(k, sum_of_parts)\n        memo[k] = result\n        return result\n\n    return _compute_recursive(n)"}
{"task_id": "Mbpp/404", "solution": "def minimum(a, b):\n    \"\"\"\n    Return the smaller of two real numbers.\n\n    Raises TypeError if either argument is not a real number (int/float).\n    \"\"\"\n    import numbers\n\n    if not isinstance(a, numbers.Real) or not isinstance(b, numbers.Real):\n        raise TypeError(\"minimum() arguments must be real numbers (int or float)\")\n\n    return a if a <= b else b"}
{"task_id": "Mbpp/395", "solution": "def first_non_repeating_character(s):\n    \"\"\"\n    Return the first non-repeated character in the string s, or None if none exists.\n    \"\"\"\n    counts = {}\n    order = []\n    for ch in s:\n        if ch not in counts:\n            counts[ch] = 1\n            order.append(ch)\n        else:\n            counts[ch] += 1\n    for ch in order:\n        if counts[ch] == 1:\n            return ch\n    return None"}
{"task_id": "Mbpp/397", "solution": "def median_numbers(a, b, c):\n    \"\"\"Calculates the median of three numbers.\"\"\"\n    numbers = [a, b, c]\n    numbers.sort()\n    return float(numbers[1])"}
{"task_id": "Mbpp/398", "solution": "def sum_of_digits(numbers):\n    \"\"\"\n    Computes the total sum of digits for each number in the given list.\n    Negative numbers are treated as their absolute values for digit summing.\n    \"\"\"\n    total_sum_of_all_digits = 0\n    for num in numbers:\n        # Get the absolute integer value for digit summation.\n        current_number = abs(int(num))\n\n        # Calculate the sum of digits for the current number.\n        current_number_digit_sum = 0\n        if current_number == 0:\n            current_number_digit_sum = 0\n        else:\n            temp_num_for_digits = current_number\n            while temp_num_for_digits > 0:\n                current_number_digit_sum += temp_num_for_digits % 10\n                temp_num_for_digits //= 10\n\n        total_sum_of_all_digits += current_number_digit_sum\n\n    return total_sum_of_all_digits"}
