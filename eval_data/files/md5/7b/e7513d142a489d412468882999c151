{"task_id": "Mbpp/743", "solution": "def rotate_right(items, k):\n    \"\"\"\n    Rotates a list to the right by k positions, returning a new list.\n    Handles positive, zero, and negative k values.\n    \"\"\"\n    n = len(items)\n    if n == 0:\n        return []\n\n    # Normalize k to be within [0, n-1] range, handling large or negative k.\n    k_norm = k % n\n\n    if k_norm == 0:\n        # No effective rotation, return a shallow copy to ensure a new list is always returned.\n        return list(items)\n\n    # Perform the rotation by slicing: move the last k_norm elements to the front.\n    return items[-k_norm:] + items[:-k_norm]"}
{"task_id": "Mbpp/745", "solution": "def divisible_by_digits(startnum: int, endnum: int) -> list[int]:\n    \"\"\"\n    Finds numbers within a given range where every number is divisible by every digit it contains.\n    Numbers containing the digit 0 are excluded.\n    \"\"\"\n    def _digits_of(n: int) -> list[int]:\n        \"\"\"Extracts the digits of a number, handling its absolute value.\"\"\"\n        n_abs = abs(n)\n        if n_abs == 0:\n            return [0]\n        return [int(ch) for ch in str(n_abs)]\n\n    def _is_divisible_by_its_digits(n: int) -> bool:\n        \"\"\"Checks if a number is divisible by each of its non-zero digits.\"\"\"\n        current_digits = _digits_of(n)\n        for d in current_digits:\n            if d == 0:\n                return False  # Numbers containing zero are excluded.\n            if n % d != 0:\n                return False  # The number is not divisible by one of its digits.\n        return True\n\n    results = []\n    for num in range(startnum, endnum + 1):\n        if _is_divisible_by_its_digits(num):\n            results.append(num)\n    return results"}
{"task_id": "Mbpp/748", "solution": "def capital_words_spaces(text: str) -> str:\n    import re\n\n    # Split between a lowercase letter/digit and an uppercase letter (e.g., \"camelCase\" -> \"camel Case\")\n    lower_to_upper_pattern = re.compile(r'(?<=[a-z0-9])(?=[A-Z])')\n\n    # Split between an uppercase letter (part of an acronym) and another uppercase letter followed by a lowercase letter\n    # (e.g., \"PDFLoader\" -> \"PDF Loader\", ensures acronyms are not split)\n    upper_to_lower_pattern = re.compile(r'(?<=[A-Z])(?=[A-Z][a-z])')\n\n    # First pass: insert spaces for lower/digit to upper transitions\n    intermediate = lower_to_upper_pattern.sub(r' ', text)\n\n    # Second pass: insert spaces for acronym-to-word transitions\n    result = upper_to_lower_pattern.sub(r' ', intermediate)\n\n    # Normalize multiple spaces into single spaces and remove leading/trailing spaces\n    return ' '.join(result.split())"}
{"task_id": "Mbpp/749", "solution": "from typing import List, Union, Iterable, Optional\n\nclass ParseError(Exception):\n    \"\"\"Raised when failing to parse an element into a number.\"\"\"\n    pass\n\nclass StringNumberParser:\n    \"\"\"Parses string representations of numbers, handling integers and floats.\"\"\"\n    def parse(self, s: str) -> Union[int, float]:\n        \"\"\"Parses a single string to an int or float, preferring int where possible.\"\"\"\n        s_stripped = str(s).strip()\n        if not s_stripped:\n            raise ParseError(f\"Empty string cannot be parsed as a number\")\n        try:\n            return int(s_stripped)\n        except ValueError:\n            try:\n                v = float(s_stripped)\n                if v.is_integer():\n                    return int(v)\n                return v\n            except ValueError:\n                raise ParseError(f\"Cannot parse '{s}' as a number\")\n\n    def parse_list(self, strings: Iterable[str], skip_invalid: bool=False) -> List[Union[int,float]]:\n        \"\"\"Parses a list of strings into a list of numbers, optionally skipping invalid entries.\"\"\"\n        parsed_numbers: List[Union[int, float]] = []\n        for s in strings:\n            try:\n                parsed_numbers.append(self.parse(s))\n            except ParseError:\n                if not skip_invalid:\n                    raise\n        return parsed_numbers\n\nclass SortService:\n    \"\"\"Provides the core business logic for parsing and sorting numeric strings.\"\"\"\n    def __init__(self, parser: Optional[StringNumberParser] = None):\n        \"\"\"Initializes SortService, optionally with a custom StringNumberParser.\"\"\"\n        self._parser = parser or StringNumberParser()\n\n    def sort_numeric_strings(self, strings: Iterable[str], skip_invalid: bool=False) -> List[Union[int,float]]:\n        \"\"\"Parses a list of numeric strings and returns them numerically sorted.\"\"\"\n        nums = self._parser.parse_list(strings, skip_invalid=skip_invalid)\n        return sorted(nums)\n\ndef sort_numeric_strings(strings: List[str], skip_invalid: bool = False) -> List[Union[int, float]]:\n    \"\"\"Sorts a list of numeric strings numerically, returning a list of numbers.\"\"\"\n    parser = StringNumberParser()\n    service = SortService(parser=parser)\n    return service.sort_numeric_strings(strings, skip_invalid=skip_invalid)"}
{"task_id": "Mbpp/750", "solution": "from typing import List, Tuple, Any, Type, Optional\n\nclass InvalidInputError(Exception):\n    \"\"\"Custom exception raised for invalid input scenarios.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n\nclass AppConfig:\n    \"\"\"Application configuration settings, defaulting to strict type checking and no persistence.\"\"\"\n    def __init__(self, allow_mixed_types: bool = False, persist: bool = False, persist_path: Optional[str] = None) -> None:\n        self.allow_mixed_types = allow_mixed_types\n        self.persist = persist\n        self.persist_path = persist_path\n\ndef parse_csv_str(s: str, element_type: Type = int) -> List[int]:\n    \"\"\"Parses a comma-separated string into a list of elements of the specified type.\"\"\"\n    if not isinstance(s, str):\n        raise InvalidInputError(\"Input for CSV string parsing must be a string.\")\n\n    parsed_items = []\n    for item_str in s.split(','):\n        stripped_item = item_str.strip()\n        if not stripped_item:\n            continue\n        try:\n            parsed_items.append(element_type(stripped_item))\n        except ValueError as e:\n            raise InvalidInputError(f\"Could not convert '{stripped_item}' to {element_type.__name__}: {e}\")\n    return parsed_items\n\ndef validate_list(value: Any, expected_type: Type = int, allow_empty: bool = True) -> List[int]:\n    \"\"\"Validates if the value is a list and all its elements match the expected type.\"\"\"\n    if not isinstance(value, list):\n        raise InvalidInputError(f\"Input must be a list, but got {type(value).__name__}\")\n    if not value and not allow_empty:\n        raise InvalidInputError(\"List cannot be empty.\")\n\n    for item in value:\n        if not isinstance(item, expected_type):\n            raise InvalidInputError(f\"List element '{item}' (type {type(item).__name__}) does not match expected type {expected_type.__name__}\")\n    return value # Return the original list after validation\n\ndef validate_tuple(value: Any, expected_type: Type = int) -> Tuple[int, ...]:\n    \"\"\"Validates if the value is a tuple and all its elements match the expected type.\"\"\"\n    if not isinstance(value, tuple):\n        raise InvalidInputError(f\"Input must be a tuple, but got {type(value).__name__}\")\n\n    for item in value:\n        if not isinstance(item, expected_type):\n            raise InvalidInputError(f\"Tuple element '{item}' (type {type(item).__name__}) does not match expected type {expected_type.__name__}\")\n    return value # Return the original tuple after validation\n\nclass ListDTO:\n    \"\"\"Data Transfer Object for list inputs, ensuring items are of integer type.\"\"\"\n    def __init__(self, items: List[int]) -> None:\n        self.items = items\n\n    @classmethod\n    def from_any(cls, value: Any) -> 'ListDTO':\n        if isinstance(value, list):\n            return cls(validate_list(value, expected_type=int))\n        elif isinstance(value, tuple):\n            return cls(list(validate_tuple(value, expected_type=int)))\n        elif isinstance(value, str):\n            return cls(parse_csv_str(value, element_type=int))\n        else:\n            raise InvalidInputError(f\"Unsupported type for ListDTO: {type(value).__name__}\")\n\nclass TupleDTO:\n    \"\"\"Data Transfer Object for tuple inputs, ensuring items are of integer type.\"\"\"\n    def __init__(self, items: Tuple[int, ...]) -> None:\n        self.items = items\n\n    @classmethod\n    def from_any(cls, value: Any) -> 'TupleDTO':\n        if isinstance(value, tuple):\n            return cls(validate_tuple(value, expected_type=int))\n        elif isinstance(value, list):\n            return cls(tuple(validate_list(value, expected_type=int)))\n        elif isinstance(value, str):\n            return cls(tuple(parse_csv_str(value, element_type=int)))\n        else:\n            raise InvalidInputError(f\"Unsupported type for TupleDTO: {type(value).__name__}\")\n\nclass TupleListService:\n    \"\"\"Provides business logic for adding tuple elements to a list with validation and optional persistence.\"\"\"\n    def __init__(self, config: AppConfig, repo: Optional[Any] = None) -> None:\n        self.config = config\n        self.repo = repo\n\n    def add_tuple(self, list_: List[int], tpl: Tuple[int, ...]) -> List[int]:\n        \"\"\"Appends elements from a tuple to an existing list, enforcing type rules.\"\"\"\n        validated_list = validate_list(list_, expected_type=int, allow_empty=True)\n        validated_tuple = validate_tuple(tpl, expected_type=int)\n\n        if validated_list and not self.config.allow_mixed_types:\n            base_type = type(validated_list[0])\n            for item in validated_tuple:\n                if not isinstance(item, base_type):\n                    raise InvalidInputError(\n                        f\"Tuple item type {type(item).__name__} does not match list item base type {base_type.__name__} \"\n                        \"(when mixed types are disallowed).\"\n                    )\n\n        for item in validated_tuple:\n            validated_list.append(item)\n\n        if self.config.persist and self.repo:\n            self.repo.save(\"default\", validated_list) # Assumes repo has a save method\n\n        return validated_list\n\nclass TupleListController:\n    \"\"\"Handles input parsing and delegates the core logic to the TupleListService.\"\"\"\n    def __init__(self, service: TupleListService) -> None:\n        self.service = service\n\n    def add_tuple(self, input_list: Any, input_tuple: Any) -> List[int]:\n        \"\"\"Processes raw inputs, converts them to DTOs, and calls the service layer.\"\"\"\n        list_dto = ListDTO.from_any(input_list)\n        tuple_dto = TupleDTO.from_any(input_tuple)\n\n        return self.service.add_tuple(list_dto.items, tuple_dto.items)\n\ndef add_tuple(list_: List[int], tpl: Tuple[int, ...]) -> List[int]:\n    \"\"\"\n    Convenience wrapper to add elements of a tuple to a list.\n    It constructs the necessary service and controller components using default settings.\n    \"\"\"\n    config = AppConfig()  # Default: allow_mixed_types=False, persist=False\n    service = TupleListService(config)\n    controller = TupleListController(service)\n    return controller.add_tuple(list_, tpl)"}
{"task_id": "Mbpp/751", "solution": "class InvalidArrayError(Exception):\n    \"\"\"Exception raised for invalid array input.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\ndef check_min_heap(arr):\n    \"\"\"\n    Checks if a given array represents a binary min-heap.\n    Raises InvalidArrayError if input is not a comparable sequence.\n    \"\"\"\n    if arr is None:\n        raise InvalidArrayError(\"Input array is None\")\n\n    try:\n        elements = list(arr)\n    except TypeError:\n        raise InvalidArrayError(\"Input is not a sequence\")\n\n    n = len(elements)\n\n    if n > 0:\n        # Quick comparability check for elements\n        try:\n            _ = elements[0] <= elements[0]\n        except Exception as e:\n            raise InvalidArrayError(\"Elements are not comparable\") from e\n\n    # Only need to check non-leaf nodes: indices 0 to n//2 - 1\n    for i in range(n // 2):\n        left_child_idx = 2 * i + 1\n        right_child_idx = 2 * i + 2\n\n        # Check left child\n        if left_child_idx < n:\n            try:\n                if elements[i] > elements[left_child_idx]:\n                    return False\n            except TypeError as e:\n                raise InvalidArrayError(\"Cannot compare elements\") from e\n\n        # Check right child\n        if right_child_idx < n:\n            try:\n                if elements[i] > elements[right_child_idx]:\n                    return False\n            except TypeError as e:\n                raise InvalidArrayError(\"Cannot compare elements\") from e\n\n    return True"}
{"task_id": "Mbpp/752", "solution": "def jacobsthal_num(n: int) -> int:\n    \"\"\"\n    Calculates the nth Jacobsthal number using its closed-form formula.\n    J(n) = (2^n - (-1)^n) // 3\n    \"\"\"\n    # The term (-1)**n is equivalent to 1 if n is even, and -1 if n is odd.\n    # Python's pow(base, exp) handles large integers automatically.\n    return (pow(2, n) - (-1 if n % 2 else 1)) // 3"}
{"task_id": "Mbpp/754", "solution": "from typing import List, Sequence, TypeVar\n\nT = TypeVar(\"T\")\n\ndef extract_index_list(l1: Sequence[T], l2: Sequence[T], l3: Sequence[T]) -> List[T]:\n    \"\"\"\n    Finds elements that are common across three sequences at the same index.\n    Returns a list of such common elements in increasing index order.\n    \"\"\"\n    n = min(len(l1), len(l2), len(l3))\n    result: List[T] = []\n    for i in range(n):\n        if l1[i] == l2[i] and l1[i] == l3[i]:\n            result.append(l1[i])\n    return result"}
{"task_id": "Mbpp/753", "solution": "def min_k(records, k):\n    \"\"\"\n    Finds the minimum k records from a list of (name, value) tuples.\n    Uses sorting to ensure stability for equal values.\n    \"\"\"\n    if not (isinstance(k, int) and k >= 0):\n        # This case is technically caught by the more robust validation in the full design.\n        # For this simplified response, we handle the most immediate aspect.\n        raise ValueError(\"k must be a non-negative integer.\")\n\n    if k == 0:\n        return []\n\n    # Attach original index for stable sorting\n    indexed_records = []\n    for i, record_tuple in enumerate(records):\n        # Assuming record_tuple is (name, value) based on the problem description\n        # and test case. No robust validation here per instructions.\n        indexed_records.append((record_tuple[0], record_tuple[1], i))\n\n    # Sort based on value, then original index for stability\n    # The key function returns (value, original_index)\n    sorted_records = sorted(indexed_records, key=lambda x: (x[1], x[2]))\n\n    # Slice the first k elements and convert back to (name, value) tuples\n    result = [(name, value) for name, value, _ in sorted_records[:k]]\n\n    return result"}
{"task_id": "Mbpp/755", "solution": "def second_smallest(numbers):\n    \"\"\"\n    Finds the second smallest number in a list in a single pass.\n    Assumes the input list contains at least two numeric elements.\n    \"\"\"\n    smallest = float('inf')\n    second = float('inf')\n    for n in numbers:\n        if n <= smallest:\n            second = smallest\n            smallest = n\n        elif n < second:\n            second = n\n    return second"}
{"task_id": "Mbpp/757", "solution": "import collections\n\ndef _normalize_string(s: str, lower: bool = True) -> str:\n    \"\"\"Normalizes string by stripping whitespace and optionally lowercasing.\"\"\"\n    s = str(s).strip()\n    return s.lower() if lower else s\n\ndef _reverse_string(s: str) -> str:\n    \"\"\"Reverses a string.\"\"\"\n    return str(s)[::-1]\n\ndef count_reverse_pairs(string_list: list[str], normalize: bool = True) -> int:\n    \"\"\"Counts pairs of strings in a list where one is the reverse of the other.\"\"\"\n    if normalize:\n        processed_strings = [_normalize_string(s) for s in string_list]\n    else:\n        processed_strings = [str(s) for s in string_list]\n\n    string_counts = collections.Counter(processed_strings)\n    pairs = 0\n    seen = set()\n\n    for s, count_s in string_counts.items():\n        if s in seen:\n            continue\n\n        r = _reverse_string(s)\n\n        if r not in string_counts:\n            seen.add(s)\n            continue\n\n        count_r = string_counts[r]\n\n        if s == r:\n            pairs += count_s * (count_s - 1) // 2\n        else:\n            pairs += count_s * count_r\n\n        seen.add(s)\n        seen.add(r)\n\n    return pairs"}
{"task_id": "Mbpp/759", "solution": "import re\n\n# Compile the regex pattern once for efficiency.\n# The pattern ^[+-]?\\d+\\.\\d{2}$ matches:\n# - ^: start of the string\n# - [+-]?: an optional leading plus or minus sign\n# - \\d+: one or more digits before the decimal point\n# - \\.: a literal decimal point\n# - \\d{2}: exactly two digits after the decimal point\n# - $: end of the string\n_DECIMAL_PATTERN = re.compile(r'^[+-]?\\d+\\.\\d{2}$')\n\ndef is_decimal(s: str) -> bool:\n    \"\"\"\n    Checks if a given string is a decimal number with exactly two digits of precision.\n    Handles optional leading signs and trims surrounding whitespace.\n    \"\"\"\n    if not isinstance(s, str):\n        return False\n\n    stripped_s = s.strip()\n    return bool(_DECIMAL_PATTERN.fullmatch(stripped_s))"}
{"task_id": "Mbpp/758", "solution": "def unique_sublists(items):\n    \"\"\"\n    Counts occurrences of sublists within a list, converting each sublist to a tuple key.\n    Returns a dictionary mapping each unique tuple to its count.\n    \"\"\"\n    counts = {}\n    for sublist in items:\n        # Convert the sublist to an immutable tuple to be used as a dictionary key.\n        # This assumes sublist elements are iterable and their elements are hashable.\n        key = tuple(sublist)\n        counts[key] = counts.get(key, 0) + 1\n    return counts"}
{"task_id": "Mbpp/760", "solution": "from typing import List, Union\n\ndef unique_Element(lst: List[Union[int, float]]) -> bool:\n    \"\"\"\n    Checks if a list of numbers contains only one distinct element.\n    Returns False for an empty list.\n    \"\"\"\n    distinct_elements = set(lst)\n    return len(distinct_elements) == 1"}
