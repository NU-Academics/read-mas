{"task_id": "Mbpp/57", "solution": "def find_Max_Num(digits):\n    \"\"\"\n    Forms the largest number possible from a list of digits by sorting them in descending order.\n    Assumes all elements in 'digits' are valid integers between 0 and 9.\n    \"\"\"\n    digit_strings = [str(d) for d in digits]\n    digit_strings.sort(reverse=True)\n    return int(\"\".join(digit_strings))"}
{"task_id": "Mbpp/20", "solution": "def is_woodall(number: int) -> bool:\n    \"\"\"\n    Checks if the given number is a Woodall number (n * 2^n - 1).\n\n    Returns True if there exists an integer n >= 1 such that number == n * 2**n - 1.\n    \"\"\"\n    if not isinstance(number, int):\n        raise TypeError(\"number must be an integer\")\n\n    if number < 1:\n        return False\n\n    # Pragmatic upper bound for 'n' to search. Woodall numbers grow quickly.\n    MAX_N_SEARCH_LIMIT = 64\n\n    for n in range(1, MAX_N_SEARCH_LIMIT + 1):\n        candidate = n * (1 << n) - 1  # n * 2^n - 1\n        if candidate == number:\n            return True\n        if candidate > number:\n            return False\n\n    return False"}
{"task_id": "Mbpp/56", "solution": "def check(num):\n    \"\"\"Checks if a number is one less than twice its reverse.\"\"\"\n\n    def _reverse_number(n: int) -> int:\n        \"\"\"Reverses the digits of an integer, preserving its sign.\"\"\"\n        if n == 0:\n            return 0\n\n        sign = -1 if n < 0 else 1\n        n_abs = abs(n)\n        reversed_abs = 0\n\n        while n_abs > 0:\n            digit = n_abs % 10\n            reversed_abs = reversed_abs * 10 + digit\n            n_abs //= 10\n\n        return sign * reversed_abs\n\n    reversed_num = _reverse_number(num)\n    return num == (2 * reversed_num - 1)"}
