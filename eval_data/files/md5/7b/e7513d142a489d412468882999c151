{"task_id": "Mbpp/409", "solution": "from typing import Iterable, Tuple, Any, List\n\ndef min_product_tuple(pairs: Iterable[Tuple[Any, Any]]) -> float:\n    \"\"\"Computes the minimum product from pairs of numbers in a list.\n    Raises ValueError for malformed or empty input.\n    \"\"\"\n\n    class InvalidInputError(ValueError):\n        \"\"\"Custom exception for invalid input data.\"\"\"\n        def __init__(self, message: str) -> None:\n            super().__init__(message)\n            self.message = message\n\n    def _is_number(value: Any) -> bool:\n        \"\"\"Checks if a value is an int or float, explicitly excluding boolean types.\"\"\"\n        return isinstance(value, (int, float)) and not isinstance(value, bool)\n\n    def _validate_single_pair(pair_item: Any, idx: int) -> Tuple[float, float]:\n        \"\"\"Validates a single pair, ensuring it's a 2-element numeric tuple or list.\"\"\"\n        if not isinstance(pair_item, (tuple, list)):\n            raise InvalidInputError(f\"Item at index {idx} is not a tuple or list: {pair_item}\")\n        if len(pair_item) != 2:\n            raise InvalidInputError(f\"Item at index {idx} must have exactly 2 elements, got {len(pair_item)}: {pair_item}\")\n        if not _is_number(pair_item[0]) or not _is_number(pair_item[1]):\n            raise InvalidInputError(f\"Elements of pair at index {idx} must be numbers, got ({type(pair_item[0]).__name__}, {type(pair_item[1]).__name__}) for {pair_item}\")\n        return (float(pair_item[0]), float(pair_item[1]))\n\n    def _validate_all_pairs(input_pairs: Iterable[Tuple[Any, Any]]) -> List[Tuple[float, float]]:\n        \"\"\"Validates the entire collection of pairs and normalizes them to a list of floats.\"\"\"\n        if not isinstance(input_pairs, (list, tuple)) and not hasattr(input_pairs, '__iter__'):\n            raise InvalidInputError(\"Input must be an iterable of pairs.\")\n\n        normalized_pairs_list = []\n        for idx, pair in enumerate(input_pairs):\n            normalized_pairs_list.append(_validate_single_pair(pair, idx))\n\n        if not normalized_pairs_list:\n            raise InvalidInputError(\"Input list of pairs cannot be empty.\")\n\n        return normalized_pairs_list\n\n    # Step 1: Validate and normalize the input pairs.\n    validated_and_normalized_pairs = _validate_all_pairs(pairs)\n\n    # Step 2: Compute the minimum product from the validated and non-empty list.\n    min_product_value = validated_and_normalized_pairs[0][0] * validated_and_normalized_pairs[0][1]\n\n    for i in range(1, len(validated_and_normalized_pairs)):\n        a, b = validated_and_normalized_pairs[i]\n        current_product = a * b\n        if current_product < min_product_value:\n            min_product_value = current_product\n\n    return min_product_value"}
