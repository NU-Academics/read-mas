{"task_id": "Mbpp/764", "solution": "def number_ctr(s: str) -> int:\n    \"\"\"Counts the number of digit characters in the given string.\n\n    Treats None input as an empty string and coerces other non-string inputs to string.\n    \"\"\"\n    if s is None:\n        return 0\n    s_str = str(s)\n    count = 0\n    for ch in s_str:\n        if ch.isdigit():\n            count += 1\n    return count"}
{"task_id": "Mbpp/763", "solution": "from typing import Sequence, Any\n\ndef find_min_diff(array: Sequence[Any], n: int) -> int:\n    \"\"\"Finds the minimum absolute difference between any two elements in an array.\n    Assumes 'array' contains elements convertible to integers and 'n' is the correct length, with n >= 2.\n    \"\"\"\n    if n < 2:\n        raise ValueError(\"At least two elements are required to compute a difference.\")\n    if len(array) != n:\n        raise ValueError(f\"Declared length n={n} does not match actual length {len(array)}.\")\n\n    # Normalize items to ints to handle inputs like \"5\" if present\n    try:\n        normalized = [int(x) for x in array]\n    except Exception as e:\n        raise ValueError(f\"All elements must be integers or convertible to int: {e}\")\n\n    sorted_array = sorted(normalized)\n\n    min_diff = abs(sorted_array[1] - sorted_array[0])\n\n    for i in range(2, n):\n        current_diff = abs(sorted_array[i] - sorted_array[i - 1])\n        if current_diff < min_diff:\n            min_diff = current_diff\n            if min_diff == 0:\n                break\n\n    return min_diff"}
{"task_id": "Mbpp/765", "solution": "def is_polite(n: int) -> int:\n    \"\"\"\n    Finds the nth polite number.\n    A polite number is a positive integer greater than 1 that can be expressed\n    as a sum of two or more consecutive positive integers \u2014 equivalently,\n    it's any integer > 1 that is not a power of two.\n\n    n is 1-based: is_polite(1) == 3, is_polite(7) == 11.\n    \"\"\"\n    if not isinstance(n, int) or n < 1:\n        raise ValueError(\"n must be an integer >= 1\")\n\n    polite_count = 0\n    current_num = 3  # start from 3, since 1 and 2 are not polite\n\n    while True:\n        # current_num is a power of two iff (current_num & (current_num - 1)) == 0\n        if (current_num & (current_num - 1)) != 0:\n            polite_count += 1\n            if polite_count == n:\n                return current_num\n        current_num += 1"}
{"task_id": "Mbpp/766", "solution": "from typing import List, Tuple, Any\n\ndef pair_wise(items: list) -> List[Tuple[Any, Any]]:\n    \"\"\"\n    Returns a list of all pairs of consecutive items in a given list.\n    Empty or single-element lists result in an empty list of pairs.\n    \"\"\"\n    if len(items) > 1:\n        return [(items[i], items[i+1]) for i in range(len(items) - 1)]\n    else:\n        return []"}
{"task_id": "Mbpp/767", "solution": "def get_pairs_count(numbers, sum):\n    \"\"\"\n    Counts pairs in a list that sum to a target value using a hash map.\n    This handles duplicate numbers correctly and has O(n) time complexity.\n    \"\"\"\n    counts = {}\n    total_pairs = 0\n    for num in numbers:\n        needed = sum - num\n        total_pairs += counts.get(needed, 0)\n        counts[num] = counts.get(num, 0) + 1\n    return total_pairs"}
{"task_id": "Mbpp/769", "solution": "def Diff(list1, list2):\n    \"\"\"\n    Return elements from list1 that are not present in list2.\n    Default ordering: elements at even indices (0-based) from list1 first,\n    then elements at odd indices, preserving relative order within each group.\n    \"\"\"\n    try:\n        iter(list1)\n        iter(list2)\n    except TypeError:\n        raise TypeError(\"Both arguments must be iterable\")\n\n    # Try to convert list2 to a set for efficient membership testing.\n    # If elements in list2 are unhashable, fall back to list membership.\n    list2_list = None\n    try:\n        set2 = set(list2)\n    except TypeError:\n        set2 = None\n        list2_list = list(list2)\n\n    remaining = []\n    for i, v in enumerate(list1):\n        if set2 is not None:\n            try:\n                in_second = v in set2\n            except TypeError:\n                # v is unhashable; fall back to list membership\n                if list2_list is None:\n                    list2_list = list(list2)\n                in_second = v in list2_list\n        else:\n            in_second = v in list2_list\n        if not in_second:\n            remaining.append((i, v))\n\n    evens = [v for i, v in remaining if i % 2 == 0]\n    odds = [v for i, v in remaining if i % 2 == 1]\n    return evens + odds"}
{"task_id": "Mbpp/770", "solution": "def odd_num_sum(n: int) -> int:\n    \"\"\"\n    Calculates the sum of the fourth powers of the first n odd natural numbers using a closed-form formula.\n    Assumes n is a non-negative integer.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an int\")\n    if n < 0:\n        raise ValueError(\"n must be non-negative\")\n    if n == 0:\n        return 0\n\n    # The sum is for k=0 to n-1 of (2k+1)^4.\n    # Expand (2k+1)^4 = 16k^4 + 32k^3 + 24k^2 + 8k + 1.\n    # Use known formulas for sums of powers for k = 0..n-1.\n    m = n - 1\n\n    # Sum of k from 0 to n-1\n    S1 = n * m // 2\n    # Sum of k^2 from 0 to n-1\n    S2 = m * n * (2 * n - 1) // 6\n    # Sum of k^3 from 0 to n-1\n    S3 = (n * m // 2) ** 2\n    # Sum of k^4 from 0 to n-1\n    S4 = m * (m + 1) * (2 * m + 1) * (3 * m * m + 3 * m - 1) // 30\n\n    # Combine the sums according to the expanded polynomial\n    result = 16 * S4 + 32 * S3 + 24 * S2 + 8 * S1 + n\n    return result"}
{"task_id": "Mbpp/771", "solution": "def check_expression(expression: str) -> bool:\n    \"\"\"\n    Checks if the given expression has balanced brackets using a stack.\n    Only considers parentheses '()', square brackets '[]', and curly braces '{}'.\n    \"\"\"\n    # Internal Stack implementation for the core logic\n    class Stack:\n        def __init__(self) -> None:\n            self._items: list[str] = []\n\n        def push(self, item: str) -> None:\n            self._items.append(item)\n\n        def pop(self) -> str | None:\n            return self._items.pop() if self._items else None\n\n        def is_empty(self) -> bool:\n            return len(self._items) == 0\n\n    # Bracket definitions\n    BRACKETS: dict[str, str] = {\"(\": \")\", \"[\": \"]\", \"{\": \"}\"}\n    OPENING = set(BRACKETS.keys())\n    CLOSING = set(BRACKETS.values())\n\n    stack = Stack()\n\n    if not isinstance(expression, str):\n        raise TypeError(\"expression must be a str\")\n\n    for ch in expression:\n        if ch in OPENING:\n            stack.push(ch)\n        elif ch in CLOSING:\n            if stack.is_empty():\n                return False\n            top = stack.pop()\n            # Check if the popped opening bracket matches the current closing bracket\n            if BRACKETS.get(top) != ch:\n                return False\n\n    # If the stack is empty, all brackets were balanced\n    return stack.is_empty()"}
{"task_id": "Mbpp/772", "solution": "def remove_length(text: str, k: int) -> str:\n    \"\"\"\n    Remove all words of length k from the given string.\n\n    Words are split on whitespace. Length is measured after stripping leading/trailing punctuation.\n    Remaining tokens (including their original punctuation) are rejoined with single spaces.\n\n    Raises:\n        ValueError: if text is not a str or k is not an int >= 0.\n    \"\"\"\n    if not isinstance(text, str):\n        raise ValueError(\"text must be a str\")\n    if not isinstance(k, int) or k < 0:\n        raise ValueError(\"k must be an int >= 0\")\n\n    import string\n\n    def _core_length(token: str) -> int:\n        # strip leading/trailing punctuation characters for length check\n        return len(token.strip(string.punctuation))\n\n    tokens = text.split()\n    kept = [t for t in tokens if _core_length(t) != k]\n    return \" \".join(kept)"}
{"task_id": "Mbpp/775", "solution": "def odd_position(lst: list[int]) -> bool:\n    \"\"\"\n    Checks if every number at an odd index in the list is an odd number.\n    Assumes the input list contains only integers.\n    \"\"\"\n    for i in range(1, len(lst), 2):\n        if lst[i] % 2 == 0:\n            return False\n    return True"}
{"task_id": "Mbpp/773", "solution": "from typing import Optional, Tuple\n\ndef occurance_substring(haystack: str, needle: str) -> Optional[Tuple[str, int, int]]:\n    \"\"\"\n    Finds the first occurrence of a substring within a string.\n    Returns a tuple (substring, start_index, end_index) or None if no match is found.\n    \"\"\"\n    if not isinstance(haystack, str) or not isinstance(needle, str):\n        raise ValueError(\"haystack and needle must be strings\")\n    if needle == \"\":\n        raise ValueError(\"needle must be a non-empty string\")\n\n    idx = haystack.find(needle)\n    if idx == -1:\n        return None\n    end_idx = idx + len(needle)\n    return (needle, idx, end_idx)"}
{"task_id": "Mbpp/777", "solution": "import collections\n\ndef find_sum(numbers):\n    \"\"\"\n    Calculates the sum of elements that appear exactly once in the input list.\n    \"\"\"\n    counts = collections.Counter(numbers)\n    total_sum = 0\n    for num, count in counts.items():\n        if count == 1:\n            total_sum += num\n    return total_sum"}
{"task_id": "Mbpp/778", "solution": "def pack_consecutive_duplicates(lst: list) -> list:\n    \"\"\"\n    Packs consecutive duplicates of list elements into sublists.\n    \"\"\"\n    if not lst:\n        return []\n\n    result = []\n    current_group = []\n\n    for item in lst:\n        if not current_group or item == current_group[-1]:\n            current_group.append(item)\n        else:\n            result.append(current_group)\n            current_group = [item]\n\n    if current_group:\n        result.append(current_group)\n\n    return result"}
{"task_id": "Mbpp/780", "solution": "def find_combinations(pairs: list[tuple[int, int]]) -> list[tuple[int, int]]:\n    \"\"\"\n    Computes element-wise sums for every unique unordered pair of 2-element integer tuples.\n    \"\"\"\n    n = len(pairs)\n    if n < 2:\n        return []\n\n    results: list[tuple[int, int]] = []\n    for i in range(n):\n        for j in range(i + 1, n):\n            tuple1 = pairs[i]\n            tuple2 = pairs[j]\n            sum_tuple = (tuple1[0] + tuple2[0], tuple1[1] + tuple2[1])\n            results.append(sum_tuple)\n    return results"}
{"task_id": "Mbpp/782", "solution": "from typing import List\n\ndef odd_length_sum(arr: List[int]) -> int:\n    \"\"\"Calculates the sum of all odd-length subarrays for a given integer array.\"\"\"\n    n = len(arr)\n    total = 0\n    for i, v in enumerate(arr):\n        total_subarrays = (i + 1) * (n - i)\n        odd_count = (total_subarrays + 1) // 2\n        total += v * odd_count\n    return total"}
{"task_id": "Mbpp/781", "solution": "import math\n\ndef count_divisors(n: int) -> bool:\n    \"\"\"\n    Checks if the count of positive divisors for a given positive integer n is even.\n    \"\"\"\n    if not isinstance(n, int) or n <= 0:\n        raise ValueError(\"n must be a positive integer\")\n\n    divisors_count = 0\n    root = int(math.isqrt(n))\n    for i in range(1, root + 1):\n        if n % i == 0:\n            divisors_count += 2  # i and n // i\n            if i * i == n:\n                divisors_count -= 1  # correct double count for perfect square\n    return (divisors_count % 2) == 0"}
{"task_id": "Mbpp/784", "solution": "def mul_even_odd(nums):\n    \"\"\"\n    Finds the product of the first odd and first even number in a list.\n\n    Example:\n        mul_even_odd([1,3,5,7,4,1,6,8]) == 4\n    \"\"\"\n    first_odd = None\n    first_even = None\n\n    for n in nums:\n        # allow numeric strings and ensure ints if needed\n        try:\n            val = int(n)\n        except Exception:\n            raise TypeError(f\"List contains non-integer-convertible element: {n!r}\")\n\n        if first_odd is None and val % 2 != 0:\n            first_odd = val\n        if first_even is None and val % 2 == 0:\n            first_even = val\n        if first_odd is not None and first_even is not None:\n            break\n\n    if first_odd is None:\n        raise ValueError(\"No odd number found in input list.\")\n    if first_even is None:\n        raise ValueError(\"No even number found in input list.\")\n\n    return first_odd * first_even"}
{"task_id": "Mbpp/786", "solution": "from typing import Sequence, Any, Optional\nfrom dataclasses import dataclass\n\nclass RightInsertionError(Exception):\n    \"\"\"Domain error for right insertion operations.\"\"\"\n    pass\n\n@dataclass\nclass InsertionRequest:\n    list: Sequence[Any]\n    value: Any\n    validate: bool = True\n    reverse: bool = False\n\n@dataclass\nclass InsertionResponse:\n    index: int\n\nclass BinarySearchAlgorithm:\n    @staticmethod\n    def right_insertion(lst: Sequence[Any], value: Any, reverse: bool=False) -> int:\n        \"\"\"Return the right insertion index for a value in a sorted sequence.\"\"\"\n        lo, hi = 0, len(lst)\n        try:\n            while lo < hi:\n                mid = (lo + hi) // 2\n                mid_val = lst[mid]\n                if BinarySearchAlgorithm._compare(mid_val, value, reverse) <= 0:\n                    lo = mid + 1\n                else:\n                    hi = mid\n            return lo\n        except TypeError as e:\n            raise RightInsertionError(\"Incomparable types in list or value\") from e\n\n    @staticmethod\n    def _compare(a: Any, b: Any, reverse: bool=False) -> int:\n        \"\"\"Helper to compare two values, adjusting for reverse flag.\"\"\"\n        if a < b:\n            return -1 if not reverse else 1\n        if a > b:\n            return 1 if not reverse else -1\n        return 0\n\nclass ListValidator:\n    @staticmethod\n    def validate_sequence(lst: Any) -> None:\n        \"\"\"Ensures the input is a list or tuple.\"\"\"\n        if not isinstance(lst, (list, tuple)):\n            raise RightInsertionError(\"Input must be a list or tuple\")\n\n    @staticmethod\n    def validate_sorted(lst: Sequence[Any], reverse: bool=False) -> None:\n        \"\"\"Verifies monotonic non-decreasing (asc) or non-increasing (desc) order.\"\"\"\n        try:\n            it = iter(lst)\n            prev = next(it, None)\n            for cur in it:\n                if not reverse:\n                    if prev is not None and prev > cur:\n                        raise RightInsertionError(\"Input list not sorted ascending\")\n                else:\n                    if prev is not None and prev < cur:\n                        raise RightInsertionError(\"Input list not sorted descending\")\n                prev = cur\n        except TypeError as e:\n            raise RightInsertionError(\"Incomparable elements when validating sorted order\") from e\n\nclass RightInsertionService:\n    def __init__(self, algorithm: Optional[BinarySearchAlgorithm] = None, validator: Optional[ListValidator] = None):\n        self._algorithm = algorithm or BinarySearchAlgorithm()\n        self._validator = validator or ListValidator()\n\n    def get_insertion_index(self, request: InsertionRequest) -> InsertionResponse:\n        \"\"\"Validates input and computes the insertion index using binary search.\"\"\"\n        self._validator.validate_sequence(request.list)\n        if request.validate:\n            self._validator.validate_sorted(request.list, request.reverse)\n        try:\n            idx = self._algorithm.right_insertion(request.list, request.value, request.reverse)\n            return InsertionResponse(index=idx)\n        except RightInsertionError:\n            raise\n        except Exception as e:\n            raise RightInsertionError(\"Failed to compute insertion index\") from e\n\n_service = RightInsertionService()\n\ndef right_insertion(lst: Sequence[Any], value: Any, validate: bool=True, reverse: bool=False) -> int:\n    \"\"\"Locate the right insertion point for a specified value in sorted order.\"\"\"\n    req = InsertionRequest(list=lst, value=value, validate=validate, reverse=reverse)\n    return _service.get_insertion_index(req).index"}
