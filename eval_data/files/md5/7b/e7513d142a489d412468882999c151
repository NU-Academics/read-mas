{"task_id": "Mbpp/427", "solution": "def change_date_format(date: str) -> str:\n    \"\"\"\n    Converts a date string from yyyy-mm-dd format to dd-mm-yyyy format.\n\n    Example:\n        change_date_format(\"2026-01-02\") -> \"02-01-2026\"\n    \"\"\"\n    parts = date.split('-')\n    year = parts[0]\n    month = parts[1]\n    day = parts[2]\n    return f\"{day}-{month}-{year}\""}
{"task_id": "Mbpp/429", "solution": "def and_tuples(a: tuple[int, ...], b: tuple[int, ...]) -> tuple[int, ...]:\n    \"\"\"\n    Computes the elementwise bitwise-AND of two tuples of integers.\n\n    Assumes input tuples are of equal length and contain only integers.\n    \"\"\"\n    result = [val_a & val_b for val_a, val_b in zip(a, b)]\n    return tuple(result)"}
{"task_id": "Mbpp/428", "solution": "from typing import List\n\ndef shell_sort(arr: List[int]) -> List[int]:\n    \"\"\"Sorts a list of integers using the Shell sort algorithm with Knuth's gap sequence.\"\"\"\n\n    def _generate_gaps_knuth(n: int) -> List[int]:\n        \"\"\"Generates the Knuth gap sequence for Shell sort up to n.\"\"\"\n        gaps = []\n        h = 1\n        while h < n:\n            gaps.append(h)\n            h = 3 * h + 1\n        return list(reversed(gaps))\n\n    # Create a mutable copy to avoid modifying the original list\n    a = list(arr)\n    n = len(a)\n\n    if n <= 1:\n        return a\n\n    gaps = _generate_gaps_knuth(n)\n\n    for gap in gaps:\n        # Perform gapped insertion sort for the current gap size\n        for i in range(gap, n):\n            temp = a[i]\n            j = i\n            # Shift elements of the gap-sorted sublist\n            while j >= gap and a[j - gap] > temp:\n                a[j] = a[j - gap]\n                j -= gap\n            a[j] = temp\n\n    return a"}
