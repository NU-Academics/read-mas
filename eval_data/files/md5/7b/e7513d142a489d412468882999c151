{"task_id": "Mbpp/108", "solution": "from typing import List, Iterable\n\n# This MergeService class is provided inline as a helper\n# to satisfy the design context's delegation while adhering\n# to the constraint of defining all called helpers inline.\nclass MergeService:\n    @staticmethod\n    def merge_sorted_list(list_a: Iterable[int], list_b: Iterable[int], list_c: Iterable[int]) -> List[int]:\n        \"\"\"\n        Merges three iterables of integers into a single sorted list.\n        This implementation concatenates all elements and then sorts them.\n        \"\"\"\n        all_items: List[int] = []\n        all_items.extend(list_a)\n        all_items.extend(list_b)\n        all_items.extend(list_c)\n        all_items.sort()\n        return all_items\n\ndef merge_sorted_list(list_a: Iterable[int], list_b: Iterable[int], list_c: Iterable[int]) -> List[int]:\n    \"\"\"\n    Public API to merge three iterables of ints into a single sorted list.\n    Delegates the core logic to MergeService.\n    \"\"\"\n    return MergeService.merge_sorted_list(list_a, list_b, list_c)"}
{"task_id": "Mbpp/109", "solution": "from .controllers import OddEquivalentController\nfrom .services import RotationService\nfrom .validators import Validator\n\n__version__ = \"0.1.0\"\n\ndef odd_equivalent(binary: str, rotations: int) -> int:\n    \"\"\"\n    Computes the number of distinct rotated interpretations of a binary string\n    that represent an odd integer, up to the specified number of rotations.\n    \"\"\"\n    controller = OddEquivalentController(RotationService(), Validator())\n    return controller.compute(binary, rotations)"}
{"task_id": "Mbpp/113", "solution": "class ValidationError(Exception):\n    \"\"\"Custom exception for validation errors during configuration.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\nclass StringValidator:\n    \"\"\"Provides static methods for string normalization and digit sequence checks.\"\"\"\n    @staticmethod\n    def normalize(s: str, strip_whitespace: bool) -> str:\n        \"\"\"Strips leading/trailing whitespace if strip_whitespace is True.\"\"\"\n        return s.strip() if strip_whitespace else s\n\n    @staticmethod\n    def split_sign(s: str, allow_sign: bool) -> tuple[str, str]:\n        \"\"\"Splits an optional leading sign (+/-) from the string.\"\"\"\n        if allow_sign and s and s[0] in \"+-\":\n            return (s[0], s[1:])\n        return (\"\", s)\n\n    @staticmethod\n    def is_digit_sequence(s: str, base: int) -> bool:\n        \"\"\"Checks if all characters in the string are valid digits for the given base.\"\"\"\n        if s == \"\":\n            return False\n        digits_map = \"0123456789abcdefghijklmnopqrstuvwxyz\"\n        valid_digits = digits_map[:base]\n        s_lower = s.lower()\n        return all(ch in valid_digits for ch in s_lower)\n\nclass CheckIntegerService:\n    \"\"\"Orchestrates integer validation based on configurable options.\"\"\"\n    def __init__(self, allow_sign: bool = True, strip_whitespace: bool = True, base: int = 10) -> None:\n        \"\"\"Initializes the service with validation rules, raising ValidationError for invalid base.\"\"\"\n        if not (2 <= base <= 36):\n            raise ValidationError(f\"base must be 2..36, got {base}\")\n        self._allow_sign = allow_sign\n        self._strip_whitespace = strip_whitespace\n        self._base = base\n\n    def is_integer(self, s: str) -> bool:\n        \"\"\"Determines if the given string represents an integer according to service rules.\"\"\"\n        normalized = StringValidator.normalize(s, self._strip_whitespace)\n        sign, unsigned = StringValidator.split_sign(normalized, self._allow_sign)\n        return StringValidator.is_digit_sequence(unsigned, self._base)\n\ndef check_integer(s: str, allow_sign: bool = True, strip_whitespace: bool = True, base: int = 10) -> bool:\n    \"\"\"\n    Checks if a string represents an integer based on specified rules.\n    This function acts as a convenience wrapper for CheckIntegerService.\n    \"\"\"\n    svc = CheckIntegerService(allow_sign=allow_sign, strip_whitespace=strip_whitespace, base=base)\n    return svc.is_integer(s)"}
{"task_id": "Mbpp/111", "solution": "def common_in_nested_lists(lists):\n    \"\"\"\n    Finds the common elements across a list of nested lists.\n    Converts each sublist to a set and computes their intersection.\n    \"\"\"\n    if not lists or len(lists) < 2:\n        return []\n\n    # Initialize common_elements with the set of the first sublist\n    common_elements = set(lists[0])\n\n    # Intersect with subsequent sublists\n    for i in range(1, len(lists)):\n        common_elements.intersection_update(set(lists[i]))\n        # If common_elements becomes empty, no more intersections are possible\n        if not common_elements:\n            break\n\n    return list(common_elements)"}
{"task_id": "Mbpp/116", "solution": "def tuple_to_int(values: tuple[int, ...]) -> int:\n    \"\"\"\n    Converts a tuple of positive integers into a single integer by concatenating their decimal representations.\n    An empty tuple returns 0.\n    \"\"\"\n    if not values:\n        return 0\n    # Convert each integer to its string representation and join them.\n    concatenated_string = \"\".join(str(v) for v in values)\n    # Convert the resulting string to an integer.\n    return int(concatenated_string)"}
