{"task_id": "Mbpp/77", "solution": "class InvalidInputError(ValueError):\n    \"\"\"Custom exception for invalid input values.\"\"\"\n    pass\n\nclass Number:\n    \"\"\"Value object representing an integer, handling absolute value.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value: int = abs(int(value))\n\n    @classmethod\n    def from_int(cls, value: int) -> \"Number\":\n        return cls(value)\n\nBASE_DIVISOR: int = 11\n\ndef alternating_sum(value: int) -> int:\n    \"\"\"Computes the alternating sum of digits for divisibility by 11.\"\"\"\n    v = abs(int(value))\n    sign = 1\n    total = 0\n    while v:\n        digit = v % 10\n        total += sign * digit\n        sign *= -1\n        v //= 10\n    return total\n\ndef compute_divisibility_from_alternating_sum(value: int) -> bool:\n    \"\"\"Determines divisibility by 11 based on the alternating sum.\"\"\"\n    return (abs(value) % BASE_DIVISOR) == 0\n\nclass InputParser:\n    \"\"\"Parses and validates input values into a Number object.\"\"\"\n    def parse(self, value: int | str) -> Number:\n        if isinstance(value, int):\n            return Number.from_int(value)\n        if isinstance(value, str):\n            s = value.strip()\n            if s == \"\":\n                raise InvalidInputError(\"Empty string is not a valid integer\")\n            try:\n                iv = int(s)\n            except ValueError as e:\n                raise InvalidInputError(f\"Invalid integer string: {s}\") from e\n            return Number.from_int(iv)\n        raise InvalidInputError(f\"Unsupported input type: {type(value)}\")\n\nclass DivisibilityService:\n    \"\"\"Provides the business logic for checking divisibility by 11.\"\"\"\n    def __init__(self, utils_module=None) -> None:\n        # In a single-file context, if utils_module is None, we refer to the globally defined utility functions.\n        if utils_module:\n            self._alternating_sum = utils_module.alternating_sum\n            self._compute_divisibility = utils_module.compute_divisibility_from_alternating_sum\n        else:\n            self._alternating_sum = alternating_sum\n            self._compute_divisibility = compute_divisibility_from_alternating_sum\n\n    def is_divisible_by_11(self, number: Number) -> bool:\n        alt = self._alternating_sum(number.value)\n        return self._compute_divisibility(alt)\n\ndef is_Diff(value: int | str) -> bool:\n    \"\"\"\n    Checks if an integer is divisible by 11 using the alternating sum algorithm.\n    Accepts both integer and string representations.\n    \"\"\"\n    parser = InputParser()\n    number = parser.parse(value)\n    service = DivisibilityService()\n    return service.is_divisible_by_11(number)"}
{"task_id": "Mbpp/82", "solution": "import math\n\ndef volume_sphere(radius: float) -> float:\n    \"\"\"Calculate the volume of a sphere given its radius.\"\"\"\n    if not isinstance(radius, (int, float)):\n        raise ValueError(\"Radius must be a numeric value.\")\n    if radius < 0:\n        raise ValueError(\"Radius cannot be negative.\")\n    return (4/3) * math.pi * (radius ** 3)"}
{"task_id": "Mbpp/80", "solution": "from collections import deque\nfrom typing import Optional\n\n\nDEFAULT_MIN_N = 1\nDEFAULT_MAX_CACHE_SIZE = 1000\n\n\nclass InvalidInputError(ValueError):\n    \"\"\"Raised when the input for tetrahedral computation is invalid.\"\"\"\n\n\nclass MathUtils:\n    @staticmethod\n    def tetrahedral_formula(n: int) -> int:\n        \"\"\"\n        Compute the nth tetrahedral number using the closed-form formula:\n        T(n) = n * (n + 1) * (n + 2) // 6\n\n        Assumes n is an integer >= 1.\n        \"\"\"\n        if not isinstance(n, int):\n            raise ValueError(\"n must be an integer\")\n        if n < DEFAULT_MIN_N:\n            raise ValueError(f\"n must be >= {DEFAULT_MIN_N}\")\n        return n * (n + 1) * (n + 2) // 6\n\n\nclass CacheRepository:\n    \"\"\"\n    Simple in-memory FIFO cache for storing computed tetrahedral numbers.\n    \"\"\"\n\n    def __init__(self, max_size: int = DEFAULT_MAX_CACHE_SIZE) -> None:\n        if not isinstance(max_size, int) or max_size <= 0:\n            raise ValueError(\"max_size must be a positive integer\")\n        self._store: dict[int, int] = {}\n        self._order: deque[int] = deque()\n        self._max_size = max_size\n\n    def get(self, n: int) -> Optional[int]:\n        \"\"\"Return cached value for n or None if not present.\"\"\"\n        return self._store.get(n)\n\n    def set(self, n: int, value: int) -> None:\n        \"\"\"Store value for n, evict oldest if exceeding max_size.\"\"\"\n        if n in self._store:\n            # Already cached; keep existing order\n            self._store[n] = value\n            return\n        self._store[n] = value\n        self._order.append(n)\n        if len(self._order) > self._max_size:\n            oldest = self._order.popleft()\n            self._store.pop(oldest, None)\n\n    def clear(self) -> None:\n        \"\"\"Clear the cache (useful for tests).\"\"\"\n        self._store.clear()\n        self._order.clear()\n\n\nclass NumberInput:\n    \"\"\"DTO for validated input.\"\"\"\n\n    def __init__(self, n: int) -> None:\n        self.n = n\n\n    @classmethod\n    def from_raw(cls, raw) -> \"NumberInput\":\n        \"\"\"Validate and convert raw input to NumberInput.\"\"\"\n        try:\n            if isinstance(raw, str):\n                raw = raw.strip()\n                n = int(raw)\n            elif isinstance(raw, int):\n                n = raw\n            else:\n                # Try to convert numeric-like objects\n                n = int(raw)\n        except Exception:\n            raise InvalidInputError(\"n must be an integer\") from None\n\n        if n < DEFAULT_MIN_N:\n            raise InvalidInputError(f\"n must be >= {DEFAULT_MIN_N}\")\n        return cls(n)\n\n\nclass TetrahedralService:\n    \"\"\"Service orchestrating validation, caching and computation.\"\"\"\n\n    def __init__(self, cache_repo: CacheRepository, math_utils: MathUtils) -> None:\n        self._cache = cache_repo\n        self._math = math_utils\n\n    def compute(self, n) -> int:\n        \"\"\"\n        Compute the tetrahedral number for n. Accepts raw input (int or str),\n        validates it, checks cache, computes if needed, caches result, and returns it.\n        \"\"\"\n        num = NumberInput.from_raw(n)\n        cached = self._cache.get(num.n)\n        if cached is not None:\n            return cached\n        value = self._math.tetrahedral_formula(num.n)\n        try:\n            self._cache.set(num.n, value)\n        except Exception:\n            # Cache failures should not break the computation; ignore caching errors.\n            pass\n        return value\n\n\ndef get_service() -> TetrahedralService:\n    \"\"\"\n    Factory function to create a default TetrahedralService instance.\n    Initializes CacheRepository and MathUtils and injects them into the service.\n    \"\"\"\n    cache = CacheRepository()\n    math_utils = MathUtils()\n    return TetrahedralService(cache, math_utils)\n\n\ndef tetrahedral_number(n: int) -> int:\n    \"\"\"\n    Computes the nth tetrahedral number using the default service.\n    Input validation and caching are handled by the service layer.\n    \"\"\"\n    return get_service().compute(n)"}
{"task_id": "Mbpp/85", "solution": "import math\n\ndef surfacearea_sphere(radius):\n    \"\"\"Calculates the surface area of a sphere given its radius.\n    The formula used is A = 4 * pi * r^2.\n    \"\"\"\n    return 4 * math.pi * (radius ** 2)"}
{"task_id": "Mbpp/84", "solution": "def sequence(n: int) -> int:\n    \"\"\"\n    Calculates the nth number in the Newman-Conway sequence using memoization.\n    The sequence is defined as a(1)=1, a(2)=1, a(n) = a(a(n-1)) + a(n - a(n-1)) for n > 2.\n    \"\"\"\n    if not isinstance(n, int) or n < 1:\n        raise ValueError(\"n must be an integer >= 1\")\n\n    # Use a list for memoization, 1-indexed. _values[0] is unused.\n    _values = [None, 1, 1]\n\n    if n < len(_values):\n        return _values[n]\n\n    for i in range(len(_values), n + 1):\n        # Calculate a(i) using the recurrence relation\n        # a(i) = a(a(i-1)) + a(i - a(i-1))\n        val_a_n_minus_1 = _values[i - 1]\n        term1_index = val_a_n_minus_1\n        term2_index = i - val_a_n_minus_1\n\n        a_i = _values[term1_index] + _values[term2_index]\n        _values.append(a_i)\n\n    return _values[n]"}
{"task_id": "Mbpp/87", "solution": "def merge_dictionaries_three(a: dict, b: dict, c: dict) -> dict:\n    \"\"\"\n    Merges three dictionaries into a single dictionary following a 'left-most wins' policy.\n    Keys from earlier dictionaries take precedence over keys in later dictionaries if duplicates exist.\n    \"\"\"\n    merged = {}\n    for src_dict in (a, b, c):\n        for k, v in src_dict.items():\n            if k not in merged:\n                merged[k] = v\n    return merged"}
