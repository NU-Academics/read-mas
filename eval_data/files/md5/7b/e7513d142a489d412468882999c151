{"task_id": "Mbpp/785", "solution": "def tuple_str_int(tuple_str: str) -> tuple[int, ...]:\n    \"\"\"Converts a string representation of an integer tuple to a Python tuple of integers.\"\"\"\n    s = tuple_str.strip()\n    if not s.startswith(\"(\") or not s.endswith(\")\"):\n        raise ValueError(\"Input must start with '(' and end with ')'\")\n\n    content = s[1:-1]\n    if content.strip() == \"\":\n        return ()\n\n    tokens = [part.strip() for part in content.split(\",\")]\n    try:\n        ints = [int(token) for token in tokens]\n    except ValueError as e:\n        raise ValueError(f\"Invalid integer token: {e}\") from e\n\n    return tuple(ints)"}
{"task_id": "Mbpp/788", "solution": "def new_tuple(items: list[str], extra: str) -> tuple[str, ...]:\n    \"\"\"\n    Creates a new tuple by combining elements from the given list and appending a string.\n    This function delegates the actual logic to an internal TupleController for input handling and tuple construction.\n    \"\"\"\n    from typing import Union, List, Tuple, Any\n\n    class InvalidInputError(Exception):\n        \"\"\"Custom exception for input validation errors.\"\"\"\n        def __init__(self, message: str) -> None:\n            super().__init__(message)\n\n    class ValidationUtils:\n        \"\"\"Utility class for validating different input types, ensuring data integrity.\"\"\"\n        @staticmethod\n        def validate_items(items_input: Any) -> List[str]:\n            if isinstance(items_input, str):\n                raise InvalidInputError(\"items must be a list/tuple of strings, not a single string\")\n            try:\n                seq = list(items_input)\n            except TypeError:\n                raise InvalidInputError(\"items must be iterable\")\n            for i, v in enumerate(seq):\n                if not isinstance(v, str):\n                    raise InvalidInputError(f\"item at index {i} is not a string: {v!r}\")\n            return seq\n\n        @staticmethod\n        def validate_extra(extra_input: Any) -> str:\n            if not isinstance(extra_input, str):\n                raise InvalidInputError(\"extra must be a string\")\n            return extra_input\n\n    class TupleInput:\n        \"\"\"Data Transfer Object (DTO) to encapsulate validated inputs.\"\"\"\n        def __init__(self, items_list: List[str], extra_string: str) -> None:\n            self._items = list(items_list)\n            self._extra = extra_string\n\n        def as_tuple(self) -> Tuple[str, ...]:\n            return tuple(self._items + [self._extra])\n\n    class TupleBuilderService:\n        \"\"\"Service class containing the core business logic for tuple creation.\"\"\"\n        def __init__(self, validator_instance: Union['ValidationUtils', None] = None) -> None:\n            self._validator = validator_instance or ValidationUtils()\n\n        def build_tuple(self, items_arg: List[str], extra_arg: str) -> Tuple[str, ...]:\n            valid_items = self._validator.validate_items(items_arg)\n            valid_extra = self._validator.validate_extra(extra_arg)\n            dto = TupleInput(valid_items, valid_extra)\n            return dto.as_tuple()\n\n    class TupleController:\n        \"\"\"Controller class acting as the public API entry point, normalizing inputs.\"\"\"\n        def __init__(self, service_instance: Union['TupleBuilderService', None] = None) -> None:\n            self._service = service_instance or TupleBuilderService()\n\n        def new_tuple(self, items_seq: Union[List, Tuple], extra_str: str) -> Tuple[str, ...]:\n            normalized_items = self._to_list(items_seq)\n            return self._service.build_tuple(normalized_items, extra_str)\n\n        def _to_list(self, items_seq: Union[List, Tuple]) -> List[str]:\n            return list(items_seq)\n\n    controller = TupleController()\n    return controller.new_tuple(items, extra)"}
{"task_id": "Mbpp/790", "solution": "def even_position(items):\n    \"\"\"\n    Check whether every even index in the sequence contains an even integer.\n\n    Returns True if all elements at indices 0, 2, 4, ... are integers (excluding bool)\n    and even; otherwise returns False.\n    \"\"\"\n    for i in range(0, len(items), 2):\n        v = items[i]\n        if not isinstance(v, int) or isinstance(v, bool) or v % 2 != 0:\n            return False\n    return True"}
{"task_id": "Mbpp/791", "solution": "from typing import Any, Tuple\n\ndef remove_nested(t: Tuple[Any, ...]) -> Tuple[Any, ...]:\n    \"\"\"Removes any top-level elements from a tuple that are themselves tuples.\n\n    Preserves the order of non-tuple elements.\n    \"\"\"\n    return tuple(elem for elem in t if not isinstance(elem, tuple))"}
{"task_id": "Mbpp/793", "solution": "def last(arr, target):\n    \"\"\"\n    Finds the last (rightmost) position of an element in a sorted array using binary search.\n    Returns the index if found, otherwise returns -1.\n    \"\"\"\n    low, high = 0, len(arr) - 1\n    result = -1\n    while low <= high:\n        mid = (low + high) // 2\n        if arr[mid] == target:\n            result = mid\n            low = mid + 1  # Search in the right half for further occurrences\n        elif arr[mid] < target:\n            low = mid + 1\n        else:\n            high = mid - 1\n    return result"}
{"task_id": "Mbpp/792", "solution": "from typing import Any, List\nimport collections.abc\n\nclass ListCounterError(Exception):\n    pass\n\nclass InvalidInputError(ListCounterError):\n    pass\n\nclass ListContainer:\n    def __init__(self, items: List[Any]) -> None:\n        self._items: List[Any] = items\n\n    def get_items(self) -> List[Any]:\n        return self._items\n\n    def get_count_of_lists(self) -> int:\n        return sum(1 for item in self._items if isinstance(item, list))\n\nclass ListCounterService:\n    def __init__(self) -> None:\n        pass\n\n    def count(self, container: \"ListContainer\") -> int:\n        return container.get_count_of_lists()\n\n    def _is_list(self, obj: Any) -> bool:\n        return isinstance(obj, list)\n\nclass ListValidator:\n    MAX_TOP_LEVEL_ITEMS: int = 100_000\n\n    def __init__(self) -> None:\n        pass\n\n    def validate(self, value: Any) -> None:\n        if value is None:\n            raise InvalidInputError(\"Input is None.\")\n        if not self._is_iterable_but_not_str(value):\n            raise InvalidInputError(\"Input must be an iterable container (not a string).\")\n        try:\n            length = len(value)\n            if length > self.MAX_TOP_LEVEL_ITEMS:\n                raise InvalidInputError(f\"Input too large: {length} items (max {self.MAX_TOP_LEVEL_ITEMS}).\")\n        except TypeError:\n            pass\n\n    def _is_iterable_but_not_str(self, value: Any) -> bool:\n        return isinstance(value, collections.abc.Iterable) and not isinstance(value, (str, bytes))\n\nclass ListController:\n    def __init__(self, validator: ListValidator=None, service: ListCounterService=None) -> None:\n        self.validator = validator or ListValidator()\n        self.service = service or ListCounterService()\n\n    def count_list(self, lists: Any) -> int:\n        self.validator.validate(lists)\n        container = ListContainer(list(lists))\n        return self.service.count(container)\n\n_default_controller = ListController()\n\ndef count_list(lists: Any) -> int:\n    \"\"\"Counts the number of lists in the top-level of the given iterable.\"\"\"\n    return _default_controller.count_list(lists)"}
