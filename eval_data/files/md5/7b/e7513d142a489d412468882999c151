{"task_id": "Mbpp/235", "solution": "def even_bit_set_number(n: int) -> int:\n    \"\"\"Sets all even-positioned bits (1-based index) of a non-negative integer n.\n\n    Even positions are 2,4,6,... (1-based). For example, 10 (0b1010) already has even bits set\n    and the function returns 10.\n\n    Args:\n        n: non-negative integer\n\n    Returns:\n        int: integer with all even-positioned bits set\n\n    Raises:\n        TypeError: if n is not an int\n        ValueError: if n is negative\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an int\")\n    if n < 0:\n        raise ValueError(\"n must be non-negative\")\n\n    if n == 0:\n        return 0\n\n    current_bit_length = n.bit_length()\n\n    # Cap bit length to avoid unbounded mask generation for extremely large integers.\n    DEFAULT_MAX_BITS = 1024\n    effective_bit_length = min(current_bit_length, DEFAULT_MAX_BITS)\n\n    mask = 0\n    # Set bits at zero-indexed positions 1,3,5,... which correspond to 1-based positions 2,4,6,...\n    for pos in range(1, effective_bit_length, 2):\n        mask |= (1 << pos)\n\n    return n | mask"}
{"task_id": "Mbpp/244", "solution": "import math\n\nclass MathUtils:\n    \"\"\"\n    Provides low-level mathematical utility functions.\n    \"\"\"\n    def isqrt(self, n: int) -> int:\n        \"\"\"\n        Returns the integer square root (floor) of a non-negative number.\n        Returns 0 for negative inputs as per design.\n        \"\"\"\n        if n < 0:\n            return 0\n        return math.isqrt(n)\n\n    def next_square_after(self, n: int) -> int:\n        \"\"\"\n        Computes the smallest perfect square strictly greater than n.\n        For negative inputs, the next perfect square is 0.\n        \"\"\"\n        if n < 0:\n            return 0\n\n        r = self.isqrt(n)\n        # For any non-negative n, the next perfect square strictly greater than n\n        # is (floor(sqrt(n)) + 1)^2.\n        return (r + 1) * (r + 1)\n\nclass NextSquareService:\n    \"\"\"\n    Encapsulates the core business logic for finding the next perfect square.\n    \"\"\"\n    def __init__(self, utils: 'MathUtils' = None):\n        self.utils = utils or MathUtils()\n\n    def next_perfect_square(self, n: int) -> int:\n        \"\"\"\n        Delegates the calculation to MathUtils.\n        \"\"\"\n        return self.utils.next_square_after(n)\n\ndef next_Perfect_Square(n: int) -> int:\n    \"\"\"\n    Finds the next perfect square strictly greater than a given number.\n    It returns 0 for negative inputs.\n    \"\"\"\n    service = NextSquareService()\n    return service.next_perfect_square(n)"}
{"task_id": "Mbpp/250", "solution": "from typing import Any, Tuple, Iterable\n\nclass CountError(Exception):\n    \"\"\"Domain-specific exception for counting errors.\"\"\"\n    def __init__(self, message: str = \"\") -> None:\n        self.message = message\n        super().__init__(message)\n\nclass CountResult:\n    \"\"\"DTO for returning count results.\"\"\"\n    def __init__(self, count: int) -> None:\n        self.count = count\n\n    def to_dict(self) -> dict:\n        return {\"count\": self.count}\n\nclass TupleValidator:\n    \"\"\"Validates tuple inputs.\"\"\"\n    def __init__(self, allow_tuple_subclass: bool = True) -> None:\n        self._allow_tuple_subclass = allow_tuple_subclass\n\n    def validate_tuple(self, data: Any) -> Tuple[Any, ...]:\n        if not isinstance(data, tuple):\n            raise CountError(\"data must be a tuple\")\n        return data\n\n    def validate_element(self, element: Any) -> Any:\n        return element\n\nclass TupleCounter:\n    \"\"\"Core logic for counting element occurrences in a tuple.\"\"\"\n    def __init__(self) -> None:\n        pass\n\n    def count(self, data: Tuple[Any, ...], element: Any) -> int:\n        cnt = 0\n        for x in data:\n            if x == element:\n                cnt += 1\n        return cnt\n\nclass CountController:\n    \"\"\"Coordinates validation and counting services.\"\"\"\n    def __init__(self, validator: TupleValidator, counter: TupleCounter) -> None:\n        self.validator = validator\n        self.counter = counter\n\n    def count_from_tuple(self, data: Tuple[Any, ...], element: Any) -> CountResult:\n        validated_data = self.validator.validate_tuple(data)\n        validated_element = self.validator.validate_element(element)\n        count_int = self.counter.count(validated_data, validated_element)\n        return CountResult(count_int)\n\n    def count_from_iterable(self, iterable: Iterable[Any], element: Any) -> CountResult:\n        data_tuple = tuple(iterable)\n        return self.count_from_tuple(data_tuple, element)\n\n_validator = TupleValidator()\n_counter = TupleCounter()\n_controller = CountController(_validator, _counter)\n\ndef count_X(data: Tuple[Any, ...], element: Any) -> int:\n    \"\"\"\n    Counts the occurrences of an element in a tuple.\n    Delegates to the internal controller for validation and counting logic.\n    \"\"\"\n    result = _controller.count_from_tuple(data, element)\n    return result.count"}
{"task_id": "Mbpp/245", "solution": "def max_sum(arr: list[int]) -> int:\n    \"\"\"\n    Finds the maximum sum of a bitonic subsequence for the given array.\n    A sequence is bitonic if it is first strictly increasing and then strictly decreasing.\n    \"\"\"\n    n = len(arr)\n    if n == 0:\n        return 0\n\n    # Calculate LIS (increasing subsequence) sums ending at each index\n    inc = list(arr)\n    for i in range(n):\n        for j in range(i):\n            if arr[j] < arr[i]:\n                inc[i] = max(inc[i], inc[j] + arr[i])\n\n    # Calculate LDS (decreasing subsequence) sums starting at each index\n    dec = list(arr)\n    for i in range(n - 1, -1, -1):\n        for j in range(n - 1, i, -1):\n            if arr[j] < arr[i]:\n                dec[i] = max(dec[i], dec[j] + arr[i])\n\n    # Combine results: for each index as peak, inc[i] + dec[i] - arr[i]\n    max_bitonic_sum = 0\n    for i in range(n):\n        max_bitonic_sum = max(max_bitonic_sum, inc[i] + dec[i] - arr[i])\n\n    return max_bitonic_sum"}
{"task_id": "Mbpp/251", "solution": "from typing import Any, List\n\ndef insert_element(items: List[Any], element: Any) -> List[Any]:\n    \"\"\"Inserts an element before each item in a list, returning a new list.\"\"\"\n    result: List[Any] = []\n    for item in items:\n        result.append(element)\n        result.append(item)\n    return result"}
{"task_id": "Mbpp/252", "solution": "import math\n\ndef convert(value: object, save: bool = False) -> tuple[float, float]:\n    \"\"\"\n    Converts a complex number or numeric input to polar coordinates (r, theta).\n    Handles int, float, complex, and string representations of complex numbers.\n    \"\"\"\n    real: float\n    imag: float\n\n    if isinstance(value, complex):\n        real = value.real\n        imag = value.imag\n    elif isinstance(value, (int, float)):\n        real = float(value)\n        imag = 0.0\n    elif isinstance(value, str):\n        s = value.strip()\n        try:\n            c = complex(s)\n            real = c.real\n            imag = c.imag\n        except ValueError as e:\n            raise ValueError(f\"Cannot parse input string to complex number: '{s}'\") from e\n    else:\n        raise TypeError(f\"Unsupported input type for conversion: {type(value).__name__}\")\n\n    r = math.hypot(real, imag)\n    theta = math.atan2(imag, real)\n\n    # The 'save' parameter is part of the API signature but its persistence logic\n    # depends on external components (ConverterService, HistoryRepository)\n    # not defined inline here, so it is currently ignored.\n\n    return (r, theta)"}
{"task_id": "Mbpp/247", "solution": "def lps(s: str, method: str = \"dp\") -> int:\n    \"\"\"\n    Finds the length of the longest palindromic subsequence in the given string.\n    This function acts as a high-level API wrapper, coordinating normalization, caching, and algorithm selection.\n    \"\"\"\n    import json\n    from typing import Optional, Dict, Tuple\n\n    class ValidationError(Exception):\n        \"\"\"Custom exception for input validation errors.\"\"\"\n        def __init__(self, message: str):\n            self.message = message\n        def __str__(self) -> str:\n            return f\"ValidationError: {self.message}\"\n\n    class PalindromeRequest:\n        \"\"\"Data Transfer Object for input string requests.\"\"\"\n        def __init__(self, raw: str):\n            self.raw: str = raw\n            self.normalized: Optional[str] = None\n\n    class PalindromeResult:\n        \"\"\"Data Transfer Object for palindromic subsequence results.\"\"\"\n        def __init__(self, input_raw: str, normalized: str, lps_length: int):\n            self.input_raw: str = input_raw\n            self.normalized: str = normalized\n            self.lps_length: int = lps_length\n\n    class StringNormalizer:\n        \"\"\"Utility class for normalizing input strings.\"\"\"\n        def __init__(self, remove_spaces: bool = True, case_fold: bool = True):\n            self.remove_spaces = remove_spaces\n            self.case_fold = case_fold\n\n        def normalize(self, s: str) -> str:\n            \"\"\"Applies filtering rules (space removal, case folding) to the input string.\"\"\"\n            if s is None or not isinstance(s, str):\n                raise ValidationError(\"Input must be a string.\")\n\n            if self.case_fold:\n                s = s.lower()\n            if self.remove_spaces:\n                return \"\".join(ch for ch in s if ch != \" \")\n            return s\n\n        def _default_filter(self, ch: str) -> bool:\n            \"\"\"Internal filter deciding which characters are retained during normalization.\"\"\"\n            if self.remove_spaces and ch == \" \":\n                return False\n            return True\n\n    class CacheRepository:\n        \"\"\"Abstracts an in-memory or file-backed cache for LPS results.\"\"\"\n        def __init__(self, persist_path: Optional[str] = None):\n            self.store: Dict[str,int] = {}\n            self.persist_path = persist_path\n            if self.persist_path:\n                try:\n                    self._load()\n                except Exception: # Logs and ignores any loading errors, starting with an empty cache.\n                    self.store = {}\n\n        def get(self, key: str) -> Optional[int]:\n            \"\"\"Retrieves a cached value by key.\"\"\"\n            return self.store.get(key)\n\n        def set(self, key: str, value: int) -> None:\n            \"\"\"Stores a key-value pair and attempts to persist it if a path is configured.\"\"\"\n            self.store[key] = value\n            if self.persist_path:\n                try:\n                    self._save()\n                except Exception: # Logs and ignores any saving errors.\n                    pass\n\n        def _load(self) -> None:\n            \"\"\"Loads cached data from the configured persistence path.\"\"\"\n            with open(self.persist_path, \"r\", encoding=\"utf-8\") as f:\n                data = json.load(f)\n                if isinstance(data, dict):\n                    self.store = {k:int(v) for k,v in data.items()}\n\n        def _save(self) -> None:\n            \"\"\"Saves the current cache store to the configured persistence path.\"\"\"\n            with open(self.persist_path, \"w\", encoding=\"utf-8\") as f:\n                json.dump(self.store, f)\n\n        def size(self) -> int:\n            \"\"\"Returns the number of entries in the cache.\"\"\"\n            return len(self.store)\n\n    class LPSService:\n        \"\"\"Implements the core algorithms for computing the Longest Palindromic Subsequence length.\"\"\"\n        def __init__(self, cache: Optional[CacheRepository] = None, recursion_threshold: int = 50):\n            self.cache = cache\n            self.recursion_threshold = recursion_threshold\n\n        def compute_lps(self, s: str, method: str = \"dp\") -> int:\n            \"\"\"Chooses between DP and memoized recursion based on method and string length.\"\"\"\n            n = len(s)\n            if method == \"memo\" and n > self.recursion_threshold:\n                raise ValueError(\n                    f\"Input string length {n} exceeds recursion threshold {self.recursion_threshold} for 'memo' method.\"\n                )\n\n            if method == \"memo\":\n                return self.compute_lps_memo(s)\n\n            return self.compute_lps_dp(s)\n\n        def compute_lps_dp(self, s: str) -> int:\n            \"\"\"Computes LPS length using a bottom-up dynamic programming approach.\"\"\"\n            n = len(s)\n            if n == 0:\n                return 0\n\n            dp = [[0]*n for _ in range(n)]\n            for i in range(n):\n                dp[i][i] = 1 # Single characters are palindromes of length 1\n\n            for cl in range(2, n + 1): # cl is current length of subsequence\n                for i in range(n - cl + 1):\n                    j = i + cl - 1 # j is ending index of current subsequence\n                    if s[i] == s[j] and cl == 2:\n                        dp[i][j] = 2\n                    elif s[i] == s[j]:\n                        dp[i][j] = dp[i+1][j-1] + 2\n                    else:\n                        dp[i][j] = max(dp[i][j-1], dp[i+1][j])\n            return dp[0][n-1]\n\n        def compute_lps_memo(self, s: str) -> int:\n            \"\"\"Computes LPS length using top-down recursion with memoization.\"\"\"\n            memo: Dict[Tuple[int,int], int] = {}\n            n = len(s)\n\n            def helper(i: int, j: int) -> int:\n                if i > j: return 0\n                if i == j: return 1\n\n                if (i,j) in memo: return memo[(i,j)]\n\n                if s[i] == s[j]:\n                    memo[(i,j)] = 2 + helper(i+1, j-1)\n                else:\n                    memo[(i,j)] = max(helper(i, j-1), helper(i+1, j))\n                return memo[(i,j)]\n\n            return helper(0, n-1)\n\n    class CLIController:\n        \"\"\"Orchestrates request validation, normalization, caching, and LPS computation.\"\"\"\n        def __init__(self, service: LPSService, normalizer: StringNormalizer, cache: CacheRepository):\n            self.service = service\n            self.normalizer = normalizer\n            self.cache = cache\n\n        def handle_compute(self, request: PalindromeRequest, method: str = \"dp\") -> PalindromeResult:\n            \"\"\"Validates, normalizes, checks cache, computes LPS, and returns result.\"\"\"\n            if request.raw is None or not isinstance(request.raw, str):\n                raise ValidationError(\"Input must be a string.\")\n\n            normalized = self.normalizer.normalize(request.raw)\n            cached = self.cache.get(normalized)\n            if cached is not None:\n                return PalindromeResult(request.raw, normalized, cached)\n\n            value = self.service.compute_lps(normalized, method=method)\n            try:\n                self.cache.set(normalized, value)\n            except Exception: # Cache errors are swallowed and computation proceeds.\n                pass\n            return PalindromeResult(request.raw, normalized, value)\n\n    # Initialize default components for the public API wrapper.\n    _default_cache = CacheRepository()\n    _default_normalizer = StringNormalizer()\n    _default_service = LPSService(cache=_default_cache)\n\n    # Main logic of the lps function, delegating to the controller.\n    controller = CLIController(service=_default_service, normalizer=_default_normalizer, cache=_default_cache)\n    req = PalindromeRequest(raw=s)\n    return controller.handle_compute(req, method=method).lps_length"}
