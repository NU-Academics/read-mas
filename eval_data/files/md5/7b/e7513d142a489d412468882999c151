{"task_id": "Mbpp/611", "solution": "from typing import List, Any\nimport numbers\n\ndef max_of_nth(matrix: List[List[Any]], n: int) -> numbers.Number:\n    \"\"\"\n    Returns the maximum value in the n'th column of a given matrix.\n    Includes robust validation for matrix structure, column index, and element types.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an int (0-based column index)\")\n\n    if not isinstance(matrix, list):\n        raise TypeError(\"matrix must be a list of rows (list of lists)\")\n    if len(matrix) == 0:\n        raise ValueError(\"matrix is empty; at least one row is required\")\n\n    current_max = None\n    for row_idx, row in enumerate(matrix):\n        if not isinstance(row, (list, tuple)):\n            raise TypeError(f\"row {row_idx} must be a list or tuple\")\n\n        if n < 0 or len(row) <= n:\n            raise IndexError(f\"row {row_idx} length {len(row)} does not contain index {n}\")\n\n        val = row[n]\n\n        # Exclude boolean values which are subclasses of int but usually not intended as numeric.\n        if not (isinstance(val, numbers.Number) and not isinstance(val, bool)):\n            raise TypeError(f\"non-numeric element at row {row_idx}, col {n}: {repr(val)}\")\n\n        if current_max is None:\n            current_max = val\n        else:\n            if val > current_max:\n                current_max = val\n\n    return current_max"}
{"task_id": "Mbpp/614", "solution": "def cummulative_sum(tuple_list):\n    \"\"\"\n    Calculates the cumulative sum of all integers in a list of tuples.\n    Assumes the input is a list/tuple of tuple/list containing integers.\n    \"\"\"\n    total_sum = 0\n    for inner_sequence in tuple_list:\n        for value in inner_sequence:\n            total_sum += value\n    return total_sum"}
