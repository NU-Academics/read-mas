{"task_id": "Mbpp/479", "solution": "def first_Digit(value):\n    \"\"\"\n    Return the first digit of the given value.\n\n    Works with ints, floats and strings. Ignores leading sign and whitespace.\n    For values like 0.0456 returns 4. If the value contains only zeros (e.g. \"0\", \"0.0\", \"000\")\n    returns 0. Raises ValueError if no digit is present.\n    \"\"\"\n    s = str(value).strip()\n    if not s:\n        raise ValueError(f\"No digit found in input: {value!r}\")\n\n    # Remove a leading sign if present\n    if s[0] in \"+-\":\n        s = s[1:]\n        if not s:\n            raise ValueError(f\"No digit found in input: {value!r}\")\n\n    found_zero = False\n    for ch in s:\n        if ch.isdigit():\n            if ch != \"0\":\n                return int(ch)\n            found_zero = True\n        # ignore other characters (decimal points, letters, etc.) until a digit is found\n\n    if found_zero:\n        return 0\n\n    raise ValueError(f\"No digit found in input: {value!r}\")"}
{"task_id": "Mbpp/556", "solution": "def find_Odd_Pair(arr, n):\n    \"\"\"\n    Counts the number of pairs in an array whose bitwise XOR value is odd.\n    An XOR of two integers is odd iff one is odd and the other is even.\n    \"\"\"\n    odd_count = 0\n    even_count = 0\n\n    # Validate basic assumptions minimally\n    if not isinstance(arr, (list, tuple)):\n        raise TypeError(\"arr must be a list or tuple of integers\")\n    if not isinstance(n, int) or n < 0:\n        raise ValueError(\"n must be a non-negative integer\")\n    if n > len(arr):\n        raise ValueError(\"n cannot be greater than len(arr)\")\n\n    # Iterate through the first 'n' elements of the array\n    for i in range(n):\n        x = arr[i]\n        if not isinstance(x, int):\n            raise TypeError(f\"element at index {i} is not an int: {x}\")\n        if (x & 1) == 1:  # odd\n            odd_count += 1\n        else:\n            even_count += 1\n\n    # Each odd-even pair produces an odd XOR; unordered pairs count = odd_count * even_count\n    return odd_count * even_count"}
{"task_id": "Mbpp/557", "solution": "def toggle_string(text: str) -> str:\n    if not isinstance(text, str):\n        raise TypeError(\"text must be a str\")\n    return \"\".join(\n        c.lower() if c.isupper() else c.upper() if c.islower() else c\n        for c in text\n    )"}
{"task_id": "Mbpp/555", "solution": "def difference(n):\n    \"\"\"\n    Calculates the difference between the sum of cubes of the first n natural numbers\n    and the sum of the first n natural numbers using formulas.\n    \"\"\"\n    sum_of_numbers = n * (n + 1) // 2\n    sum_of_cubes = sum_of_numbers * sum_of_numbers\n    return sum_of_cubes - sum_of_numbers"}
{"task_id": "Mbpp/564", "solution": "from typing import List\n\ndef count_Pairs(arr: List[int], n: int) -> int:\n    \"\"\"\n    Counts the number of possible unordered pairs from a list of integers\n    where both elements in the pair are unequal.\n    \"\"\"\n    # Calculate frequencies of each number.\n    hist = {}\n    for v in arr:\n        hist[v] = hist.get(v, 0) + 1\n\n    # Compute total possible unordered pairs and subtract pairs with equal elements.\n    total_pairs = n * (n - 1) // 2\n    equal_pairs = sum(c * (c - 1) // 2 for c in hist.values())\n    unequal_pairs = total_pairs - equal_pairs\n\n    return unequal_pairs"}
{"task_id": "Mbpp/562", "solution": "def Find_Max_Length(lists):\n    \"\"\"\n    Return the length of the longest sublist in `lists`.\n    Example: Find_Max_Length([[1],[1,4],[5,6,7,8]]) -> 4\n    \"\"\"\n    if lists is None:\n        raise TypeError(\"lists must be an iterable of iterables\")\n    max_len = 0\n    for idx, sub in enumerate(lists):\n        try:\n            length = len(sub)\n        except TypeError:\n            raise TypeError(f\"Element at index {idx} does not support len()\")\n        if length > max_len:\n            max_len = length\n    return max_len"}
{"task_id": "Mbpp/563", "solution": "import re\n\nQUOTE_REGEX = re.compile(r'(?P<q>[\"\\'])(?P<body>(?:\\\\.|(?!\\1).)*?)\\1')\n\ndef _unescape(s: str) -> str:\n    \"\"\"Unescapes backslash-escaped characters in a string.\"\"\"\n    return s.encode('utf-8').decode('unicode_escape')\n\ndef extract_values(text: str) -> list[str]:\n    \"\"\"\n    Extracts values enclosed in quotation marks from a string.\n    Supports both single and double quotes and backslash-escaped internal quotes.\n    \"\"\"\n    values = []\n    for m in QUOTE_REGEX.finditer(text):\n        body = m.group('body')\n        content = _unescape(body)\n        if content != \"\":  # Skip empty matches as per design's default allow_empty=False\n            values.append(content)\n    return values"}
{"task_id": "Mbpp/558", "solution": "def digit_distance_nums(a, b):\n    \"\"\"\n    Calculates the sum of per-digit absolute differences between two integers.\n    Shorter numbers are left-padded with zeros for alignment.\n    \"\"\"\n    s_a = str(abs(int(a)))\n    s_b = str(abs(int(b)))\n\n    max_len = max(len(s_a), len(s_b))\n\n    s_a = s_a.zfill(max_len)\n    s_b = s_b.zfill(max_len)\n\n    total_diff = 0\n    for digit_a, digit_b in zip(s_a, s_b):\n        total_diff += abs(int(digit_a) - int(digit_b))\n\n    return total_diff"}
{"task_id": "Mbpp/559", "solution": "def max_sub_array_sum(nums: list[int], _context_length: int) -> int:\n    \"\"\"\n    Finds the sum of the largest contiguous sublist using Kadane's algorithm.\n    The _context_length parameter is ignored as it is not used by the algorithm.\n    \"\"\"\n    if not nums:\n        return 0\n\n    max_ending = nums[0]\n    max_so_far = nums[0]\n\n    for i in range(1, len(nums)):\n        max_ending = max(nums[i], max_ending + nums[i])\n        max_so_far = max(max_so_far, max_ending)\n\n    return max_so_far"}
{"task_id": "Mbpp/560", "solution": "from typing import Tuple, Iterable, Any, Optional, List\nimport datetime\nimport uuid\nimport json\nimport os\nimport shutil\n\n# --- Exceptions ---\nclass InvalidTupleError(Exception):\n    \"\"\"Custom exception for invalid tuple inputs.\n    It carries a message describing the validation failure.\"\"\"\n    def __init__(self, message: str) -> None:\n        self.message = message\n        super().__init__(self.message)\n\n# --- Utils ---\ndef sort_unique_tuple(items: Iterable[int]) -> Tuple[int, ...]:\n    \"\"\"Converts an iterable of integers into a sorted tuple of unique integers.\n    This helper performs the core sorting and deduplication.\"\"\"\n    unique = set(items)\n    sorted_list = sorted(unique)\n    return tuple(sorted_list)\n\ndef to_tuple(iterable: Iterable[Any]) -> Tuple[Any, ...]:\n    \"\"\"Converts any iterable into a tuple.\n    Used for type coercion.\"\"\"\n    return tuple(iterable)\n\n# --- Config (minimal for default values) ---\nclass AppConfig:\n    \"\"\"Provides default configuration values for the application.\n    Persistence is off by default, and a default path is provided.\"\"\"\n    DEFAULT_PERSIST: bool = False\n    DEFAULT_RESULTS_PATH: str = \"results.json\"\n\n    def __init__(self, persist: Optional[bool] = None, results_path: Optional[str] = None) -> None:\n        self.persist = persist if persist is not None else self.DEFAULT_PERSIST\n        self.results_path = results_path if results_path is not None else self.DEFAULT_RESULTS_PATH\n\n# --- Models (Minimal, only what TupleUnionService might interact with if persistence was active) ---\nclass TupleResult:\n    \"\"\"Data Transfer Object for storing computation results.\n    Includes the resulting tuple and a timestamp.\"\"\"\n    def __init__(self, result: Tuple[int, ...], timestamp: str) -> None:\n        self.result = result\n        self.timestamp = timestamp\n\n# --- Validators ---\nclass InputValidator:\n    \"\"\"Validates if sequences are composed solely of integers.\n    It converts numeric-like values to integers if possible.\"\"\"\n    def validate_sequence(self, seq: Any) -> Tuple[int, ...]:\n        \"\"\"Validates input as a sequence of integers, attempting conversion if needed.\n        Raises InvalidTupleError for non-sequences or non-convertible elements.\"\"\"\n        if not isinstance(seq, (tuple, list)):\n            raise InvalidTupleError(\"Input must be a sequence (tuple or list).\")\n\n        processed_elements = []\n        for item in seq:\n            if isinstance(item, int):\n                processed_elements.append(item)\n            elif isinstance(item, float):\n                # Allow floats that are effectively integers (e.g., 3.0)\n                if item.is_integer():\n                    processed_elements.append(int(item))\n                else:\n                    raise InvalidTupleError(f\"Sequence contains non-integer float: {item}\")\n            elif isinstance(item, str):\n                try:\n                    # Attempt to convert string to integer\n                    processed_elements.append(int(item))\n                except ValueError:\n                    raise InvalidTupleError(f\"Sequence contains non-integer string: '{item}'\")\n            else:\n                raise InvalidTupleError(f\"Sequence contains unsupported type {type(item).__name__}: {item}\")\n\n        return to_tuple(processed_elements)\n\n# --- Repositories (Mocked/No-op for the public API function, as persistence is optional and off by default) ---\nclass TupleRepository:\n    \"\"\"A repository for persisting tuple union results to a JSON file.\n    For this public API function, persistence is not enabled, so operations are no-ops.\"\"\"\n    def __init__(self, path: str) -> None:\n        self.path = path\n\n    def save(self, record: dict) -> None:\n        \"\"\"Saves a record to the repository.\n        This method is a no-op when persistence is disabled.\"\"\"\n        pass\n\n    def get_all(self) -> List[dict]:\n        \"\"\"Retrieves all records from the repository.\n        Returns an empty list as persistence is disabled.\"\"\"\n        return []\n\n    def _ensure_file(self) -> None:\n        \"\"\"Ensures the persistence file exists.\n        This is not actively used by the public API function.\"\"\"\n        pass\n\n# --- Services ---\nclass TupleUnionService:\n    \"\"\"Orchestrates validation, union computation, and optional persistence.\n    It encapsulates the core business logic.\"\"\"\n    def __init__(self, validator: InputValidator, repository: Optional[TupleRepository] = None) -> None:\n        self.validator = validator\n        self.repository = repository\n\n    def compute(self, a: Tuple[int, ...], b: Tuple[int, ...]) -> Tuple[int, ...]:\n        \"\"\"Computes the union of two *already validated* integer tuples.\n        It uses `sort_unique_tuple` for final formatting.\"\"\"\n        union_set = set(a) | set(b)\n        return sort_unique_tuple(union_set)\n\n    def union_elements(self, a_raw: Any, b_raw: Any) -> Tuple[int, ...]:\n        \"\"\"Validates raw inputs, computes their union, and handles optional persistence.\n        The persistence step is bypassed if no repository is provided.\"\"\"\n        validated_a = self.validator.validate_sequence(a_raw)\n        validated_b = self.validator.validate_sequence(b_raw)\n\n        result = self.compute(validated_a, validated_b)\n        return result\n\n# --- Public API function ---\ndef union_elements(a, b):\n    \"\"\"\n    Computes the union of elements from two input tuples, returning unique elements sorted.\n    This function initializes necessary components and calls the core service logic.\n    \"\"\"\n    validator = InputValidator()\n    # As per design, the public API proxies to the service with default dependencies.\n    # Default persistence is off, so no repository is passed to the service.\n    service = TupleUnionService(validator=validator, repository=None)\n    return service.union_elements(a, b)"}
{"task_id": "Mbpp/566", "solution": "def sum_digits(n: int) -> int:\n    \"\"\"\n    Calculates the sum of the digits of a non-negative integer.\n\n    Args:\n        n: non-negative integer\n\n    Returns:\n        Sum of decimal digits of n.\n\n    Raises:\n        ValueError: if n is negative or not an integer.\n    \"\"\"\n    if not isinstance(n, int):\n        raise ValueError(\"Input must be an integer\")\n    if n < 0:\n        raise ValueError(\"Input must be a non-negative integer\")\n    return sum(int(digit) for digit in str(n))"}
