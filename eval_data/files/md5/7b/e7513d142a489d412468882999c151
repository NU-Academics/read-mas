{"task_id": "Mbpp/430", "solution": "from dataclasses import dataclass\n\nclass ParabolaError(Exception):\n    \"\"\"Base exception for the parabola directrix library.\"\"\"\n    pass\n\nclass InvalidTypeError(ParabolaError):\n    \"\"\"Raised when coefficients are not numeric.\"\"\"\n    pass\n\nclass InvalidCoefficientError(ParabolaError):\n    \"\"\"Raised when a coefficient violates a rule, e.g., 'a' is zero.\"\"\"\n    pass\n\n@dataclass(frozen=True)\nclass ParabolaCoefficients:\n    \"\"\"Represents the coefficients (a, b, c) of a parabola y = ax^2 + bx + c.\"\"\"\n    a: float\n    b: float\n    c: float\n\ndef is_numeric(value: object) -> bool:\n    \"\"\"Checks if a value is an int or float.\"\"\"\n    return isinstance(value, (int, float))\n\ndef safe_div(n: float, d: float) -> float:\n    \"\"\"Performs division, raising an error if the divisor is zero.\"\"\"\n    if d == 0.0:\n        raise InvalidCoefficientError(\"Division by zero encountered in numeric helper.\")\n    return n / d\n\ndef validate_coefficients(a, b, c) -> ParabolaCoefficients:\n    \"\"\"Validates and coerces parabola coefficients, raising errors for invalid inputs.\"\"\"\n    if not is_numeric(a) or not is_numeric(b) or not is_numeric(c):\n        raise InvalidTypeError(\"Coefficients must be numeric (int or float).\")\n    a_f, b_f, c_f = float(a), float(b), float(c)\n    if a_f == 0.0:\n        raise InvalidCoefficientError(\"Coefficient 'a' must be non-zero for a parabola.\")\n    return ParabolaCoefficients(a=a_f, b=b_f, c=c_f)\n\nclass DirectrixService:\n    \"\"\"Provides methods to compute the directrix of a parabola.\"\"\"\n    @staticmethod\n    def compute_directrix(coeffs: ParabolaCoefficients) -> float:\n        \"\"\"Calculates the y-coordinate of the directrix for y = ax^2 + bx + c.\"\"\"\n        a, b, c = coeffs.a, coeffs.b, coeffs.c\n        # Formula for directrix y = d: d = c - (b^2 + 1) / (4 * a)\n        numerator = b * b + 1.0\n        denominator = 4.0 * a\n        directrix = c - safe_div(numerator, denominator)\n        return directrix\n\ndef parabola_directrix(a, b, c) -> float:\n    \"\"\"\n    Computes the y-coordinate of the directrix for a parabola y = ax^2 + bx + c.\n    Raises InvalidTypeError if inputs are non-numeric, or InvalidCoefficientError if 'a' is zero.\n    \"\"\"\n    coeffs = validate_coefficients(a, b, c)\n    return DirectrixService.compute_directrix(coeffs)"}
