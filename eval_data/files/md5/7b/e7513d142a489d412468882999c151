{"task_id": "Mbpp/418", "solution": "def Find_Max(lst):\n    \"\"\"Return the element from `lst` that has the maximum length (using len()).\n\n    Raises:\n        TypeError: if `lst` is not iterable or elements do not support len().\n        ValueError: if `lst` is an empty iterable.\n    \"\"\"\n    # Validate iterable\n    try:\n        iterator = iter(lst)\n    except TypeError:\n        raise TypeError(\"Find_Max expects an iterable\")\n\n    # Fast path: use built-in max with key=len (raises ValueError on empty iterable)\n    try:\n        return max(lst, key=len)\n    except ValueError:\n        raise ValueError(\"Find_Max requires a non-empty iterable\")\n    except TypeError:\n        # Some elements may not support len(); compute lengths manually with explicit checks\n        max_element = None\n        max_length = -1\n        found = False\n        for el in lst:\n            found = True\n            try:\n                l = len(el)\n            except TypeError:\n                raise TypeError(\"All elements must support len() for length comparison\")\n            if l > max_length:\n                max_length = l\n                max_element = el\n        if not found:\n            raise ValueError(\"Find_Max requires a non-empty iterable\")\n        return max_element"}
{"task_id": "Mbpp/415", "solution": "def max_Product(numbers: list) -> tuple:\n    \"\"\"\n    Finds a pair of numbers with the highest product from a given array of integers.\n    Assumes 'numbers' contains at least two integers and all elements are integers.\n    \"\"\"\n    if not hasattr(numbers, '__iter__') or isinstance(numbers, (str, bytes)):\n        raise ValueError(\"Input must be an iterable of integers (not a string).\")\n    nums = list(numbers)\n    if len(nums) < 2:\n        raise ValueError(\"At least two integers are required.\")\n\n    max1 = -float('inf')  # Largest number\n    max2 = -float('inf')  # Second largest number\n    min1 = float('inf')   # Smallest number\n    min2 = float('inf')   # Second smallest number\n\n    for x in nums:\n        if not isinstance(x, int):\n            raise ValueError(\"All elements must be integers.\")\n        # Update max1 and max2\n        if x >= max1:\n            max2 = max1\n            max1 = x\n        elif x > max2:\n            max2 = x\n\n        # Update min1 and min2\n        if x <= min1:\n            min2 = min1\n            min1 = x\n        elif x < min2:\n            min2 = x\n\n    # Candidate pairs\n    candidate_positive = (max1, max2)\n    candidate_negative = (min1, min2)\n\n    prod_positive = candidate_positive[0] * candidate_positive[1]\n    prod_negative = candidate_negative[0] * candidate_negative[1]\n\n    if prod_positive > prod_negative:\n        chosen_pair_values = candidate_positive\n    elif prod_negative > prod_positive:\n        chosen_pair_values = candidate_negative\n    else:  # Products are equal, apply tie-breaking rules\n        # Sort candidates for consistent comparison (min, max)\n        p1_sorted = tuple(sorted(candidate_positive))\n        p2_sorted = tuple(sorted(candidate_negative))\n\n        # Tie-break by largest individual value (max element of the pair)\n        max_val_p1 = p1_sorted[1]\n        max_val_p2 = p2_sorted[1]\n\n        if max_val_p1 > max_val_p2:\n            chosen_pair_values = p1_sorted\n        elif max_val_p2 > max_val_p1:\n            chosen_pair_values = p2_sorted\n        else:  # Max values are also equal\n            # Tie-break by lowest-min value\n            min_val_p1 = p1_sorted[0]\n            min_val_p2 = p2_sorted[0]\n            if min_val_p1 < min_val_p2:\n                chosen_pair_values = p1_sorted\n            else:  # Covers min_val_p1 >= min_val_p2\n                chosen_pair_values = p2_sorted\n\n    # Return the chosen pair as a sorted tuple (min, max)\n    return tuple(sorted(chosen_pair_values))"}
{"task_id": "Mbpp/414", "solution": "def overlapping(seq1, seq2):\n    \"\"\"\n    Checks if any element from the first sequence exists in the second sequence.\n    It uses a set for efficiency if elements are hashable, falling back to nested loops otherwise.\n    \"\"\"\n    try:\n        # Determine which sequence is shorter to optimize set creation, if lengths are available.\n        len_seq1_available = hasattr(seq1, '__len__')\n        len_seq2_available = hasattr(seq2, '__len__')\n\n        if len_seq1_available and len_seq2_available:\n            if len(seq1) <= len(seq2):\n                set_candidate = seq1\n                iterable_to_check = seq2\n            else:\n                set_candidate = seq2\n                iterable_to_check = seq1\n        else:\n            # If lengths aren't readily available for both, try creating a set from seq1 by default.\n            set_candidate = seq1\n            iterable_to_check = seq2\n\n        # Attempt to create a set for efficient lookups. This will raise TypeError for unhashable elements.\n        lookup_set = set(set_candidate)\n\n        for item in iterable_to_check:\n            if item in lookup_set:\n                return True\n        return False\n\n    except TypeError:\n        # Fallback for when elements are unhashable (e.g., lists of lists).\n        # To ensure all items are checked even if `seq2` is a single-pass iterator (like a generator),\n        # convert `seq2` to a list for multiple iterations.\n        list_seq2 = list(seq2)\n        for item1 in seq1:\n            for item2 in list_seq2:\n                if item1 == item2:\n                    return True\n        return False"}
{"task_id": "Mbpp/420", "solution": "def cube_Sum(n):\n    \"\"\"\n    Calculates the cube sum of the first n even natural numbers using a closed-form formula.\n    The formula is 2 * n^2 * (n+1)^2.\n    \"\"\"\n    return 2 * (n * n) * ((n + 1) * (n + 1))"}
{"task_id": "Mbpp/419", "solution": "def round_and_sum(numbers):\n    \"\"\"\n    Round every number in the given iterable, print the total sum multiplied\n    by the length of the list, and return the integer result.\n\n    Example:\n        assert round_and_sum([22.4, 4.0, -16.22, -9.10, 11.00, -12.22, 14.20, -5.20, 17.50]) == 243\n    \"\"\"\n    # Convert to list to support repeated passes and to get length\n    try:\n        nums = list(numbers)\n    except TypeError:\n        raise TypeError(\"The argument must be an iterable of numbers.\")\n\n    rounded = []\n    for v in nums:\n        try:\n            f = float(v)\n        except Exception:\n            raise TypeError(f\"Non-numeric value: {v!r}\")\n        rounded.append(int(round(f)))\n\n    total = sum(rounded)\n    length = len(nums)\n    result = total * length if length > 0 else 0\n    print(result)\n    return result"}
