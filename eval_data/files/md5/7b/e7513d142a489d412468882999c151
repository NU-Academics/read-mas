{"task_id": "Mbpp/592", "solution": "import math\n\ndef sum_Of_product(n):\n    \"\"\"\n    Finds the sum of the product of consecutive binomial coefficients using the identity C(2n, n-1).\n    For n=0, the sum is 0.\n    \"\"\"\n    if n == 0:\n        return 0\n\n    N = 2 * n\n    K = n - 1\n\n    # Define multiplicative_comb inline as a fallback if math.comb is not available.\n    def _multiplicative_comb_inline(n_val: int, k_val: int) -> int:\n        if k_val < 0 or k_val > n_val:\n            return 0\n        if k_val == 0 or k_val == n_val:\n            return 1\n        if k_val > n_val // 2:\n            k_val = n_val - k_val # C(n, k) == C(n, n-k)\n\n        res = 1\n        for i in range(k_val):\n            res = res * (n_val - i) // (i + 1)\n        return res\n\n    # Use math.comb for efficiency if available (Python 3.8+), otherwise use the inline fallback.\n    if hasattr(math, 'comb'):\n        return math.comb(N, K)\n    else:\n        return _multiplicative_comb_inline(N, K)"}
{"task_id": "Mbpp/594", "solution": "def diff_even_odd(lst) -> int:\n    \"\"\"\n    Return the difference between the first even and the first odd number\n    encountered when scanning the iterable `lst` from left to right:\n        result = first_even - first_odd\n\n    Raises:\n        TypeError: if `lst` is not iterable or contains non-int elements.\n        ValueError: if `lst` contains no even or no odd numbers.\n    \"\"\"\n    if not hasattr(lst, \"__iter__\"):\n        raise TypeError(\"lst must be an iterable of integers\")\n\n    first_even = None\n    first_odd = None\n\n    for idx, n in enumerate(lst):\n        if not isinstance(n, int):\n            raise TypeError(f\"element at index {idx} is not an int: {n!r}\")\n        if first_odd is None and (n % 2 != 0):\n            first_odd = n\n        if first_even is None and (n % 2 == 0):\n            first_even = n\n        if first_even is not None and first_odd is not None:\n            break\n\n    missing = []\n    if first_even is None:\n        missing.append(\"even\")\n    if first_odd is None:\n        missing.append(\"odd\")\n    if missing:\n        raise ValueError(f\"list does not contain {' and '.join(missing)} number(s)\")\n\n    return first_even - first_odd"}
{"task_id": "Mbpp/590", "solution": "import math\n\ndef polar_rect(r: float, theta: float) -> tuple[tuple[float, float], complex]:\n    \"\"\"Converts polar coordinates (radius, angle) to normalized polar and rectangular coordinates.\"\"\"\n\n    # Convert inputs to float to ensure consistency.\n    r_val = float(r)\n    theta_val = float(theta)\n\n    # Helper function to normalize the angle to the range (-pi, pi].\n    def _normalize_theta(angle: float) -> float:\n        return math.atan2(math.sin(angle), math.cos(angle))\n\n    # Calculate the normalized polar angle.\n    normalized_theta = _normalize_theta(theta_val)\n\n    # Calculate rectangular coordinates using the original input angle.\n    x = r_val * math.cos(theta_val)\n    y = r_val * math.sin(theta_val)\n\n    # Return the tuple ((r, normalized_theta), complex(x, y)).\n    return (r_val, normalized_theta), complex(x, y)"}
{"task_id": "Mbpp/598", "solution": "def armstrong_number(n: int) -> bool:\n    \"\"\"\n    Determines if an integer is an Armstrong number.\n    This function internally defines helper classes to perform the computation.\n    \"\"\"\n\n    class Number:\n        \"\"\"Domain model representing an integer for Armstrong computations.\"\"\"\n        def __init__(self, value: int) -> None:\n            self.value: int = value\n\n        def digit_count(self) -> int:\n            \"\"\"Returns the number of digits for the absolute value (0 -> 1).\"\"\"\n            # For 0, len(str(abs(0))) is len(\"0\") which is 1. This is correct.\n            return len(str(abs(self.value)))\n\n        def digits(self) -> list[int]:\n            \"\"\"Returns a list of decimal digits for the absolute value in MSD->LSD order.\"\"\"\n            s = str(abs(self.value))\n            return [int(ch) for ch in s]\n\n    class DigitUtils:\n        \"\"\"Pure helper functions for digit operations and safe integer exponentiation.\"\"\"\n        @staticmethod\n        def split_digits(num: int) -> list[int]:\n            \"\"\"Returns digits of abs(num) in most-significant-first order.\"\"\"\n            return [int(ch) for ch in str(abs(num))]\n\n        @staticmethod\n        def pow_int(base: int, exp: int) -> int:\n            \"\"\"Computes base ** exp using the built-in pow function.\"\"\"\n            return pow(base, exp)\n\n    class NumberRepository:\n        \"\"\"A no-op repository implementation to satisfy the repository pattern.\"\"\"\n        def __init__(self) -> None:\n            pass\n\n        def save(self, number_obj: Number) -> None:\n            \"\"\"Placeholder for saving a number, currently does nothing.\"\"\"\n            pass\n\n        def get(self, value: int) -> Number | None:\n            \"\"\"Placeholder for retrieving a number, currently always returns None.\"\"\"\n            return None\n\n    class ArmstrongService:\n        \"\"\"Core business logic for determining whether a number is an Armstrong number.\"\"\"\n        def __init__(self, repo: NumberRepository) -> None:\n            self._repo = repo\n\n        def is_armstrong(self, num: int) -> bool:\n            \"\"\"Determines if the given integer is an Armstrong number.\"\"\"\n            # Negative numbers are not considered Armstrong numbers.\n            if num < 0:\n                return False\n\n            number_obj = Number(num)\n\n            # Get the count of digits and the individual digits.\n            d = number_obj.digit_count()\n            digits = DigitUtils.split_digits(num)\n\n            # Calculate the sum of each digit raised to the power of the digit count.\n            total = sum(DigitUtils.pow_int(digit, d) for digit in digits)\n\n            # Save the number via the repository (no-op in this implementation).\n            self._repo.save(number_obj)\n\n            return total == num\n\n    # Instantiate the repository and service to perform the check.\n    repo_instance = NumberRepository()\n    service = ArmstrongService(repo_instance)\n\n    # Delegate the call to the ArmstrongService.\n    return service.is_armstrong(n)"}
{"task_id": "Mbpp/597", "solution": "def find_kth(arr1: list[int], arr2: list[int], k: int) -> int:\n    \"\"\"\n    Finds the k-th smallest element from two sorted arrays using a divide and conquer approach.\n    k is 1-based.\n    \"\"\"\n    # Basic validation\n    if not isinstance(arr1, (list, tuple)) or not isinstance(arr2, (list, tuple)):\n        raise TypeError(\"arr1 and arr2 must be list or tuple\")\n    if not isinstance(k, int):\n        raise TypeError(\"k must be an integer\")\n    total = len(arr1) + len(arr2)\n    if k < 1 or k > total:\n        raise IndexError(f\"k={k} is out of bounds for total elements {total}\")\n\n    # Ensure arr1 is the shorter array to optimize partitioning\n    if len(arr1) > len(arr2):\n        arr1, arr2 = arr2, arr1\n\n    # Base cases\n    if not arr1:\n        return arr2[k - 1]\n    if k == 1:\n        return arr1[0] if arr1[0] <= arr2[0] else arr2[0]\n\n    # Partition k into two parts\n    i = min(len(arr1), k // 2)\n    j = k - i\n\n    # Compare elements at the partition points and recurse\n    if arr1[i - 1] <= arr2[j - 1]:\n        return find_kth(arr1[i:], arr2, k - i)\n    else:\n        return find_kth(arr1, arr2[j:], k - j)"}
{"task_id": "Mbpp/599", "solution": "def sum_average(n):\n    \"\"\"\n    Calculates the sum and average of the first n natural numbers.\n    \"\"\"\n    s = n * (n + 1) // 2\n    a = s / n\n    return (s, a)"}
{"task_id": "Mbpp/602", "solution": "def first_repeated_char(s: str, case_sensitive: bool = True) -> str | None:\n    \"\"\"\n    Finds the first character that is repeated in the given string.\n    Returns the character if found, otherwise None.\n    \"\"\"\n    if not isinstance(s, str):\n        raise TypeError(\"s must be a str\")\n\n    if not case_sensitive:\n        s = s.lower()\n\n    seen_chars = set()\n    for char in s:\n        if char in seen_chars:\n            return char\n        seen_chars.add(char)\n    return None"}
