{"task_id": "Mbpp/440", "solution": "import re\nimport string\nfrom typing import Optional, Iterable, Set\n\nclass Token:\n    \"\"\"Represents a lexical token with its text and character offsets.\"\"\"\n    def __init__(self, text: str, start: int, end: int):\n        self.text = text\n        self.start = start\n        self.end = end\n\n    def __repr__(self) -> str:\n        return f\"Token(text='{self.text}', start={self.start}, end={self.end})\"\n\nclass AdverbMatch:\n    \"\"\"Represents a found adverb match with its positions and normalized text.\"\"\"\n    def __init__(self, start: int, end: int, text: str):\n        self.start = start\n        self.end = end\n        self.text = text\n\n    def __repr__(self) -> str:\n        return f\"AdverbMatch(start={self.start}, end={self.end}, text='{self.text}')\"\n\nPUNCTUATION_CHARS = string.punctuation\n\ndef is_punctuation(char: str) -> bool:\n    \"\"\"Checks if a character is a punctuation mark.\"\"\"\n    return char in PUNCTUATION_CHARS\n\ndef strip_punctuation_bounds(word: str) -> str:\n    \"\"\"Removes leading and trailing punctuation from a word.\"\"\"\n    start_index = 0\n    end_index = len(word)\n\n    while start_index < end_index and is_punctuation(word[start_index]):\n        start_index += 1\n\n    while end_index > start_index and is_punctuation(word[end_index - 1]):\n        end_index -= 1\n\n    return word[start_index:end_index]\n\ndef normalize_word(word: str) -> str:\n    \"\"\"Normalizes a word by lowercasing and stripping surrounding punctuation.\"\"\"\n    return strip_punctuation_bounds(word).lower()\n\nDEFAULT_WORD_REGEX = r\"[A-Za-z]+(?:['-][A-Za-z]+)*\"\n\nclass Tokenizer:\n    \"\"\"Splits a sentence into word tokens with character offsets.\"\"\"\n    def __init__(self, pattern: str = DEFAULT_WORD_REGEX):\n        self._word_regex = re.compile(pattern)\n\n    def tokenize(self, sentence: str) -> list[Token]:\n        if sentence is None:\n            sentence = \"\"\n        tokens = []\n        for m in self._word_regex.finditer(sentence):\n            tokens.append(Token(text=m.group(0), start=m.start(), end=m.end()))\n        return tokens\n\nclass LexiconRepository:\n    \"\"\"Abstract interface for providing a lexicon of adverbs.\"\"\"\n    def get_adverbs(self) -> Set[str]:\n        raise NotImplementedError\n\nclass InMemoryLexiconRepository(LexiconRepository):\n    \"\"\"An in-memory implementation of the LexiconRepository.\"\"\"\n    def __init__(self, adverbs: Optional[Iterable[str]] = None):\n        self._adverbs: Set[str] = set()\n        if adverbs:\n            self._adverbs.update(a.lower() for a in adverbs)\n\n    def get_adverbs(self) -> Set[str]:\n        return self._adverbs\n\nclass AdverbFinderService:\n    \"\"\"Core logic for finding the first adverb in a sentence.\"\"\"\n    HEURISTIC_SUFFIX = \"ly\"\n    BUILT_IN_EXCEPTIONS = {\"sly\"}\n\n    def __init__(self, tokenizer: Tokenizer, lexicon_repo: LexiconRepository, strict: bool = False):\n        self._tokenizer = tokenizer\n        self._lexicon_repo = lexicon_repo\n        self._strict = strict\n\n    def find_first_adverb(self, sentence: str) -> Optional[AdverbMatch]:\n        if sentence is None or not sentence:\n            return None\n\n        tokens = self._tokenizer.tokenize(sentence)\n        adverbs_from_lexicon = self._lexicon_repo.get_adverbs()\n\n        for token in tokens:\n            normalized_token_text = normalize_word(token.text)\n            if normalized_token_text:\n                if self._is_adverb(normalized_token_text, adverbs_from_lexicon):\n                    stripped_original_text = strip_punctuation_bounds(token.text)\n                    return AdverbMatch(token.start, token.start + len(stripped_original_text), normalized_token_text)\n        return None\n\n    def _is_adverb(self, normalized_token_text: str, adverbs_from_lexicon: Set[str]) -> bool:\n        is_heuristic_adverb = normalized_token_text.endswith(self.HEURISTIC_SUFFIX) and \\\n                              normalized_token_text not in self.BUILT_IN_EXCEPTIONS\n\n        is_lexicon_adverb = normalized_token_text in adverbs_from_lexicon\n\n        return is_heuristic_adverb or is_lexicon_adverb\n\ndef create_service(strict: bool = False, extra_adverbs: Optional[Iterable[str]] = None) -> AdverbFinderService:\n    \"\"\"Creates a configured AdverbFinderService instance.\"\"\"\n    tokenizer = Tokenizer()\n    repo = InMemoryLexiconRepository(extra_adverbs)\n    return AdverbFinderService(tokenizer, repo, strict=strict)\n\ndef find_adverb_position(sentence: str, strict: bool = False, extra_adverbs: Optional[Iterable[str]] = None) -> Optional[tuple[int, int, str]]:\n    \"\"\"\n    Finds the first adverb and its positions in a given sentence.\n    Returns (start_index, end_index, adverb_text) or None if no adverb is found.\n    \"\"\"\n    service = create_service(strict=strict, extra_adverbs=extra_adverbs)\n    match = service.find_first_adverb(sentence)\n    if match is None:\n        return None\n    return (match.start, match.end, match.text)"}
{"task_id": "Mbpp/445", "solution": "def index_multiplication(a, b):\n    \"\"\"\n    Performs index-wise multiplication of elements in two tuples of tuples.\n    \"\"\"\n    # Basic validation for shapes\n    if not (isinstance(a, tuple) and isinstance(b, tuple)):\n        raise TypeError(\"Both inputs must be tuples of tuples.\")\n    if len(a) != len(b):\n        raise ValueError(\"Outer tuples must have the same length.\")\n\n    result_outer = []\n    for i, (ia, ib) in enumerate(zip(a, b)):\n        if not (isinstance(ia, tuple) and isinstance(ib, tuple)):\n            raise TypeError(f\"Inner elements at index {i} must be tuples.\")\n        if len(ia) != len(ib):\n            raise ValueError(f\"Inner tuples at index {i} must have the same length.\")\n        inner_result = []\n        for j, (x, y) in enumerate(zip(ia, ib)):\n            if not (isinstance(x, int) and isinstance(y, int)):\n                raise TypeError(f\"Elements must be integers (found at outer index {i}, inner index {j}).\")\n            inner_result.append(x * y)\n        result_outer.append(tuple(inner_result))\n\n    return tuple(result_outer)"}
{"task_id": "Mbpp/446", "solution": "def count_Occurrence(sequence: tuple, targets: list) -> int:\n    \"\"\"Counts the occurrences of elements from the targets list within the sequence tuple.\n    Each unique target element is considered for counting.\n    \"\"\"\n    target_set = set(targets)\n    occurrence_count = 0\n    for item in sequence:\n        if item in target_set:\n            occurrence_count += 1\n    return occurrence_count"}
{"task_id": "Mbpp/448", "solution": "def cal_sum(n: int) -> int:\n    \"\"\"\n    Calculates the sum of Perrin numbers from P(0) to P(n) iteratively.\n    Perrin sequence is P(0)=3, P(1)=0, P(2)=2, and P(k)=P(k-2)+P(k-3) for k > 2.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n    if n < 0:\n        raise ValueError(\"n must be >= 0\")\n\n    if n == 0:\n        return 3\n\n    # Initialize Perrin numbers for P(0), P(1), P(2)\n    p0, p1, p2 = 3, 0, 2\n\n    # Calculate initial sum based on n\n    total = p0 + p1 + p2 if n >= 2 else (p0 + p1 if n == 1 else p0)\n\n    # Iterate from k=3 up to n to compute subsequent Perrin numbers and accumulate sum\n    for k in range(3, n + 1):\n        p_next = p1 + p0  # P(k) = P(k-2) + P(k-3)\n        total += p_next\n        p0, p1, p2 = p1, p2, p_next\n\n    return total"}
