{"task_id": "Mbpp/131", "solution": "def reverse_vowels(s: str) -> str:\n    \"\"\"Reverses only the vowels in a given string. 'y' is not considered a vowel.\"\"\"\n    vowels = frozenset({'a', 'e', 'i', 'o', 'u', 'A', 'E', 'I', 'O', 'U'})\n\n    chars = list(s)\n    left, right = 0, len(chars) - 1\n\n    while left < right:\n        # Move left pointer until a vowel is found\n        while left < right and chars[left] not in vowels:\n            left += 1\n        # Move right pointer until a vowel is found\n        while left < right and chars[right] not in vowels:\n            right -= 1\n\n        # If both pointers found vowels and haven't crossed, swap them\n        if left < right:\n            chars[left], chars[right] = chars[right], chars[left]\n            left += 1\n            right -= 1\n\n    return ''.join(chars)"}
{"task_id": "Mbpp/129", "solution": "from typing import List, Tuple, Any, Set, Dict\n\nclass MagicSquareError(Exception):\n    \"\"\"Base exception for magic square validation errors.\"\"\"\n    pass\n\nclass InvalidMatrixError(MagicSquareError):\n    \"\"\"Raised when the input matrix has an invalid structure.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n\nclass NonIntegerValueError(MagicSquareError):\n    \"\"\"Raised when the matrix contains non-integer values.\"\"\"\n    def __init__(self, positions: List[Tuple[int, int]], message: str) -> None:\n        super().__init__(message)\n        self.positions = positions\n\nclass DuplicateValueError(MagicSquareError):\n    \"\"\"Raised when the matrix contains duplicate numbers.\"\"\"\n    def __init__(self, duplicates: Dict[int, List[Tuple[int, int]]], message: str) -> None:\n        super().__init__(message)\n        self.duplicates = duplicates\n\nclass MissingValueError(DuplicateValueError):\n    \"\"\"Raised when numbers from 1 to n^2 are missing from the matrix.\"\"\"\n    def __init__(self, missing: Set[int], message: str) -> None:\n        super().__init__(message)\n        self.missing = missing\n\ndef flatten(rows: List[List[int]]) -> List[int]:\n    \"\"\"Flattens a 2D list into a 1D list.\"\"\"\n    return [v for row in rows for v in row]\n\ndef magic_constant(n: int) -> int:\n    \"\"\"Calculates the magic constant for an n x n magic square.\"\"\"\n    return n * (n * n + 1) // 2\n\ndef is_int_like(value: Any) -> bool:\n    \"\"\"Checks if a value is strictly an integer type.\"\"\"\n    return isinstance(value, int)\n\nclass Matrix:\n    \"\"\"Represents a validated square matrix.\"\"\"\n    def __init__(self, rows: List[List[int]]) -> None:\n        self.rows: List[List[int]] = rows\n        self.n: int = len(rows)\n        self._flattened: List[int] | None = None\n\n    def get_flattened(self) -> List[int]:\n        \"\"\"Returns a cached flattened list of matrix values.\"\"\"\n        if self._flattened is None:\n            self._flattened = flatten(self.rows)\n        return self._flattened\n\n    def get_row(self, i: int) -> List[int]:\n        \"\"\"Returns the i-th row of the matrix.\"\"\"\n        return self.rows[i]\n\n    def get_col(self, j: int) -> List[int]:\n        \"\"\"Returns the j-th column of the matrix.\"\"\"\n        return [self.rows[i][j] for i in range(self.n)]\n\n    def get_main_diagonal(self) -> List[int]:\n        \"\"\"Returns the main diagonal elements.\"\"\"\n        return [self.rows[i][i] for i in range(self.n)]\n\n    def get_anti_diagonal(self) -> List[int]:\n        \"\"\"Returns the anti-diagonal elements.\"\"\"\n        return [self.rows[i][self.n - 1 - i] for i in range(self.n)]\n\nclass MatrixValidator:\n    \"\"\"Validates the structure and element types of a raw matrix input.\"\"\"\n    def validate(self, raw: Any) -> Matrix:\n        \"\"\"Performs structural and integer validation on the raw input.\"\"\"\n        rows_any = self._validate_structure(raw)\n        rows_int = self._validate_integers(rows_any)\n        return Matrix(rows_int)\n\n    def _validate_structure(self, raw: Any) -> List[List[Any]]:\n        \"\"\"Checks if the input is a non-empty square matrix of list-like objects.\"\"\"\n        if not isinstance(raw, (list, tuple)):\n            raise InvalidMatrixError(\"Input must be a list or tuple of rows.\")\n        if not raw:\n            raise InvalidMatrixError(\"Matrix cannot be empty.\")\n\n        n = len(raw)\n        rows_processed: List[List[Any]] = []\n        for i, row in enumerate(raw):\n            if not isinstance(row, (list, tuple)):\n                raise InvalidMatrixError(f\"Row {i} must be a list or tuple.\")\n            if len(row) != n:\n                raise InvalidMatrixError(f\"Row {i} has length {len(row)}, expected {n} for a square matrix.\")\n            rows_processed.append(list(row))\n        return rows_processed\n\n    def _validate_integers(self, rows: List[List[Any]]) -> List[List[int]]:\n        \"\"\"Checks if all matrix elements are strict integers.\"\"\"\n        non_int_positions: List[Tuple[int, int]] = []\n        for r_idx, row in enumerate(rows):\n            for c_idx, val in enumerate(row):\n                if not is_int_like(val):\n                    non_int_positions.append((r_idx, c_idx))\n\n        if non_int_positions:\n            pos_str = \", \".join([f\"({r},{c})\" for r, c in non_int_positions])\n            raise NonIntegerValueError(non_int_positions,\n                                       f\"Non-integer values found at positions: {pos_str}.\")\n        return rows # type: ignore\n\nclass NumberSetChecker:\n    \"\"\"Checks if the matrix contains numbers from 1 to n^2 exactly once.\"\"\"\n    def validate_numbers(self, matrix: Matrix) -> None:\n        \"\"\"Validates the presence and uniqueness of numbers 1..n^2.\"\"\"\n        n_squared = matrix.n * matrix.n\n        expected_set = set(range(1, n_squared + 1))\n\n        value_positions: Dict[int, List[Tuple[int, int]]] = {}\n        for r_idx in range(matrix.n):\n            for c_idx in range(matrix.n):\n                val = matrix.rows[r_idx][c_idx]\n                if val not in value_positions:\n                    value_positions[val] = []\n                value_positions[val].append((r_idx, c_idx))\n\n        duplicates: Dict[int, List[Tuple[int, int]]] = {}\n        actual_set = set()\n        for val, positions in value_positions.items():\n            actual_set.add(val)\n            if len(positions) > 1:\n                duplicates[val] = positions\n\n        missing = expected_set - actual_set\n\n        if duplicates:\n            msg = \"Duplicate values found: \"\n            dups_str = []\n            for val in sorted(duplicates.keys()):\n                pos_list = duplicates[val]\n                pos_str = \", \".join([f\"({r},{c})\" for r, c in pos_list])\n                dups_str.append(f\"{val} at {pos_str}\")\n            msg += \"; \".join(dups_str)\n\n            if missing:\n                msg += f\". Also missing values: {sorted(list(missing))}.\"\n                raise MissingValueError(missing=missing, message=msg)\n            raise DuplicateValueError(duplicates=duplicates, message=msg)\n        elif missing:\n            raise MissingValueError(missing=missing, message=f\"Missing values: {sorted(list(missing))}.\")\n\nclass SumChecker:\n    \"\"\"Checks if all rows, columns, and diagonals sum to the magic constant.\"\"\"\n    def check_sums(self, matrix: Matrix) -> bool:\n        \"\"\"Verifies that all required sums equal the magic constant.\"\"\"\n        n = matrix.n\n        target_sum = magic_constant(n)\n\n        for i in range(n):\n            if sum(matrix.get_row(i)) != target_sum:\n                return False\n\n        for j in range(n):\n            if sum(matrix.get_col(j)) != target_sum:\n                return False\n\n        if sum(matrix.get_main_diagonal()) != target_sum:\n            return False\n\n        if sum(matrix.get_anti_diagonal()) != target_sum:\n            return False\n\n        return True\n\nclass MagicSquareService:\n    \"\"\"Orchestrates the validation and checking process for magic squares.\"\"\"\n    def __init__(self, validator: MatrixValidator | None = None,\n                 number_checker: NumberSetChecker | None = None,\n                 sum_checker: SumChecker | None = None) -> None:\n        \"\"\"Initializes the service with optional injected dependencies.\"\"\"\n        self.validator = validator or MatrixValidator()\n        self.number_checker = number_checker or NumberSetChecker()\n        self.sum_checker = sum_checker or SumChecker()\n\n    def magic_square_test(self, raw: Any) -> bool:\n        \"\"\"Tests if the given raw matrix is a magic square.\"\"\"\n        matrix = self.validator.validate(raw)\n        self.number_checker.validate_numbers(matrix)\n        return self.sum_checker.check_sums(matrix)\n\n_magic_square_service = MagicSquareService()\n\ndef magic_square_test(matrix: List[List[int]]) -> bool:\n    \"\"\"\n    Calculates whether the given matrix is a magic square.\n    This function validates the matrix structure, element types, and value uniqueness (1..n^2),\n    then checks if all row, column, and diagonal sums are equal to the magic constant.\n    \"\"\"\n    return _magic_square_service.magic_square_test(matrix)"}
{"task_id": "Mbpp/133", "solution": "def sum_negativenum(numbers):\n    \"\"\"Calculates the sum of negative numbers in a given list.\"\"\"\n    negatives = (n for n in numbers if n < 0)\n    return sum(negatives)"}
{"task_id": "Mbpp/135", "solution": "def hexagonal_num(n):\n    \"\"\"\n    Calculates the nth hexagonal number using the formula n * (2n - 1).\n    Assumes n is a positive integer.\n    \"\"\"\n    return n * (2 * n - 1)"}
{"task_id": "Mbpp/137", "solution": "import math\n\ndef zero_count(arr):\n    \"\"\"\n    Calculates the ratio of zeroes to non-zeroes in an array of integers.\n    Returns 0.0 for an empty array, or math.inf if all elements are zero.\n    \"\"\"\n    zeros = 0\n    non_zeros = 0\n\n    for x in arr:\n        if x == 0:\n            zeros += 1\n        else:\n            non_zeros += 1\n\n    if non_zeros == 0:\n        if zeros == 0:\n            return 0.0\n        else:  # zeros > 0 and non_zeros == 0\n            return math.inf\n    else:\n        return float(zeros) / non_zeros"}
{"task_id": "Mbpp/138", "solution": "def is_Sum_Of_Powers_Of_Two(n):\n    \"\"\"\n    Checks if the given number can be represented as a sum of distinct non-zero powers of 2.\n    Non-zero powers mean exponents >= 1 (i.e., allowed terms are 2, 4, 8, ...).\n    Returns True iff n is an integer >= 2 and even.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n    return n >= 2 and (n & 1) == 0"}
{"task_id": "Mbpp/142", "solution": "def count_samepair(a, b, c):\n    \"\"\"\n    Counts the number of items that are identical in the same position of three given lists.\n    Compares elements up to the minimum length of the three lists.\n    \"\"\"\n    min_len = min(len(a), len(b), len(c))\n    count = 0\n    for i in range(min_len):\n        if a[i] == b[i] == c[i]:\n            count += 1\n    return count"}
{"task_id": "Mbpp/140", "solution": "def extract_singly(sequences: 'Iterable[Iterable[Any]]') -> 'Set[int]':\n    \"\"\"Extracts unique integers from a collection of nested sequences.\n    Non-integer values are converted if safe, otherwise raising an error.\"\"\"\n\n    from typing import Any, Iterable, Set, Callable, Iterator\n\n    class ValidationError(Exception):\n        def __init__(self, message: str) -> None:\n            super().__init__(message)\n            self.message = message\n\n    class ExtractionError(ValidationError):\n        def __init__(self, message: str) -> None:\n            super().__init__(message)\n            self.message = message\n\n    def is_iterable(obj: Any) -> bool:\n        try:\n            iter(obj)\n        except TypeError:\n            return False\n        return not isinstance(obj, (str, bytes))\n\n    def to_int(value: Any) -> int:\n        if isinstance(value, int):\n            return value\n        if isinstance(value, float):\n            if value.is_integer():\n                return int(value)\n            raise ValueError(f\"float has fractional part: {value}\")\n        try:\n            coerced = int(value)\n        except Exception as e:\n            raise ValueError(f\"cannot convert {value!r} to int\") from e\n        return coerced\n\n    class ListFlattener:\n        def __init__(self, validator: Callable[[Any], int]) -> None:\n            self._validator = validator\n\n        def flatten(self, sequences: Iterable[Iterable[Any]]) -> Iterator[int]:\n            if not is_iterable(sequences):\n                raise ValidationError(\"Top-level object is not iterable\")\n            for seq in sequences:\n                if not is_iterable(seq):\n                    raise ValidationError(\"Nested element is not iterable\")\n                for v in seq:\n                    yield self._validate_and_convert(v)\n\n        def _validate_and_convert(self, value: Any) -> int:\n            try:\n                return self._validator(value)\n            except ValueError:\n                raise\n\n    class ExtractorService:\n        def __init__(self, flattener: ListFlattener) -> None:\n            self._flattener = flattener\n\n        def extract(self, sequences: Iterable[Iterable[Any]]) -> Set[int]:\n            unique_numbers = set()\n            try:\n                for num in self._flattener.flatten(sequences):\n                    unique_numbers.add(num)\n            except ValueError as e:\n                raise ExtractionError(f\"Failed to extract number: {e}\") from e\n            except ValidationError as e:\n                raise ExtractionError(f\"Input validation error: {e.message}\") from e\n            return unique_numbers\n\n    flattener = ListFlattener(validator=to_int)\n    service = ExtractorService(flattener=flattener)\n    return service.extract(sequences)"}
{"task_id": "Mbpp/139", "solution": "import math\nfrom typing import Any\n\nclass InvalidRadiusError(Exception):\n    \"\"\"Custom exception for invalid radius values.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\ndef validate_radius(value: Any) -> float:\n    \"\"\"Validates and converts a value to a non-negative float radius.\"\"\"\n    try:\n        r = float(value)\n    except (TypeError, ValueError):\n        raise InvalidRadiusError(f\"Radius must be numeric; got {value!r}\")\n    if r < 0:\n        raise InvalidRadiusError(\"Radius must be non-negative\")\n    return r\n\ndef circle_circumference(radius: float) -> float:\n    \"\"\"\n    Calculates the circumference of a circle for a given radius.\n    It validates the radius and uses math.pi for precision.\n    \"\"\"\n    validated_radius = validate_radius(radius)\n    return 2.0 * math.pi * validated_radius"}
{"task_id": "Mbpp/141", "solution": "from typing import TypeVar, Sequence, MutableSequence, Callable, Optional, List, Any, Generic\nimport time\nfrom dataclasses import dataclass, field\n\n# Define TypeVar for generic types\nT = TypeVar('T')\n\n# --- Exceptions ---\nclass ValidationError(Exception):\n    \"\"\"\n    Exception raised for invalid input or runtime precondition violations.\n    \"\"\"\n    message: str\n\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\n\n    def __str__(self) -> str:\n        return self.message\n\n# --- Models ---\n@dataclass\nclass SortMetrics:\n    \"\"\"Metrics collected during a sort operation.\"\"\"\n    flips: int = 0\n    comparisons: int = 0\n    elapsed_seconds: float = 0.0\n    truncated: bool = False\n\n@dataclass\nclass SortResult(Generic[T]):\n    \"\"\"The result of a sort operation, including the sorted list and metrics.\"\"\"\n    sorted_list: List[T] = field(default_factory=list)\n    metrics: SortMetrics = field(default_factory=SortMetrics)\n\n# --- Adapters ---\nclass ComparatorAdapter(object):\n    \"\"\"Adapts user-defined or native comparisons into a uniform interface.\"\"\"\n    def __init__(self, user_comparator: Optional[Callable[[Any, Any], int]] = None) -> None:\n        self.user_comparator = user_comparator\n\n    def compare(self, a: Any, b: Any) -> int:\n        \"\"\"\n        Compares two elements. Returns -1 if a < b, 0 if a == b, 1 if a > b.\n        Raises ValidationError if elements are not comparable and no custom comparator is provided.\n        \"\"\"\n        if self.user_comparator is not None:\n            result = self.user_comparator(a, b)\n            if result < 0:\n                return -1\n            elif result > 0:\n                return 1\n            else:\n                return 0\n        try:\n            if a < b: return -1\n            if a == b: return 0\n            return 1\n        except TypeError:\n            raise ValidationError(\"Elements are not mutually comparable; provide a comparator\")\n\n# --- Utilities ---\nclass Flipper(object):\n    \"\"\"Performs in-place prefix reversal on a mutable sequence.\"\"\"\n    def flip(self, data: MutableSequence[T], k: int) -> None:\n        \"\"\"\n        Reverses the prefix of `data` of length `k`.\n        Raises ValidationError if `k` is out of bounds.\n        \"\"\"\n        if k <= 0 or k > len(data):\n            raise ValidationError(f\"Invalid flip size: {k}. Must be between 1 and {len(data)} (inclusive).\")\n        i, j = 0, k - 1\n        while i < j:\n            data[i], data[j] = data[j], data[i]\n            i += 1\n            j -= 1\n\n# --- Services ---\nclass PancakeSorter(object):\n    \"\"\"Implements the pancake sorting algorithm with metrics tracking.\"\"\"\n    def __init__(self, comparator_adapter: ComparatorAdapter, flipper: Flipper, max_flips: Optional[int] = None) -> None:\n        self._comparator = comparator_adapter\n        self._flipper = flipper\n        self._max_flips = max_flips\n        self._flips_count = 0\n        self._comparisons_count = 0\n        self._truncated = False\n\n    def _find_max_index(self, data: MutableSequence[T], end: int) -> int:\n        \"\"\"Finds the index of the maximum element in the prefix data[0:end).\"\"\"\n        max_idx = 0\n        for i in range(1, end):\n            self._comparisons_count += 1\n            if self._comparator.compare(data[i], data[max_idx]) > 0:\n                max_idx = i\n        return max_idx\n\n    def _flip_prefix(self, data: MutableSequence[T], k: int) -> None:\n        \"\"\"Performs a prefix flip and updates the flips count.\"\"\"\n        self._flipper.flip(data, k)\n        self._flips_count += 1\n\n    def sort(self, items: Sequence[T], in_place: bool = False) -> SortResult[T]:\n        \"\"\"\n        Sorts the given sequence using the pancake sort algorithm.\n        Tracks metrics like flips, comparisons, and elapsed time.\n        \"\"\"\n        start_time = time.perf_counter()\n\n        if self._max_flips is not None and (not isinstance(self._max_flips, int) or self._max_flips <= 0):\n             raise ValidationError(f\"Invalid max_flips value: {self._max_flips}. Must be a positive integer or None.\")\n\n        if in_place:\n            if not isinstance(items, MutableSequence):\n                raise ValidationError(\"In-place sorting requires a mutable sequence (e.g., list). Immutable type provided.\")\n            data: MutableSequence[T] = items  # type: ignore\n        else:\n            data = list(items)\n\n        n = len(data)\n        if n <= 1:\n            end_time = time.perf_counter()\n            metrics = SortMetrics(flips=0, comparisons=0,\n                                  elapsed_seconds=end_time - start_time, truncated=False)\n            return SortResult(sorted_list=data, metrics=metrics)\n\n        self._flips_count = 0\n        self._comparisons_count = 0\n        self._truncated = False\n\n        for curr_size in range(n, 1, -1):\n            if self._max_flips is not None and self._flips_count >= self._max_flips:\n                self._truncated = True\n                break\n\n            max_index = self._find_max_index(data, curr_size)\n\n            if max_index != curr_size - 1:\n                if max_index != 0:\n                    self._flip_prefix(data, max_index + 1)\n                    if self._max_flips is not None and self._flips_count >= self._max_flips:\n                        self._truncated = True\n                        break\n\n                self._flip_prefix(data, curr_size)\n                if self._max_flips is not None and self._flips_count >= self._max_flips:\n                    self._truncated = True\n                    break\n\n        end_time = time.perf_counter()\n        metrics = SortMetrics(flips=self._flips_count, comparisons=self._comparisons_count,\n                              elapsed_seconds=end_time - start_time, truncated=self._truncated)\n        return SortResult(sorted_list=data, metrics=metrics)\n\ndef pancake_sort(items: Sequence[T], comparator: Optional[Callable[[T,T], int]] = None, in_place: bool = False, max_flips: Optional[int] = None) -> SortResult[T]:\n    \"\"\"\n    Sorts a list of elements using the pancake sort algorithm, returning a SortResult object.\n    \"\"\"\n    adapter = ComparatorAdapter(comparator)\n    flipper = Flipper()\n    sorter = PancakeSorter(comparator_adapter=adapter, flipper=flipper, max_flips=max_flips)\n    return sorter.sort(items, in_place=in_place)"}
{"task_id": "Mbpp/145", "solution": "def max_Abs_Diff(arr):\n    \"\"\"\n    Return the maximum difference between any two numeric elements in arr.\n\n    Raises:\n        TypeError: if arr is not iterable or contains non-numeric elements (bools are treated as non-numeric).\n        ValueError: if arr contains fewer than two numeric elements.\n    \"\"\"\n    import numbers\n\n    try:\n        it = iter(arr)\n    except TypeError:\n        raise TypeError(\"arr must be an iterable\") from None\n\n    # Find first numeric element\n    for first in it:\n        if isinstance(first, numbers.Real) and not isinstance(first, bool):\n            min_val = max_val = first\n            count = 1\n            break\n        else:\n            raise TypeError(\"all elements must be numeric (int/float); bool is not allowed\")\n    else:\n        # iterable exhausted without any element\n        raise ValueError(\"arr must contain at least two numeric elements\")\n\n    for x in it:\n        if not (isinstance(x, numbers.Real) and not isinstance(x, bool)):\n            raise TypeError(\"all elements must be numeric (int/float); bool is not allowed\")\n        count += 1\n        if x < min_val:\n            min_val = x\n        elif x > max_val:\n            max_val = x\n\n    if count < 2:\n        raise ValueError(\"arr must contain at least two numeric elements\")\n\n    return max_val - min_val"}
{"task_id": "Mbpp/161", "solution": "from typing import List, TypeVar, Any\n\nT = TypeVar('T')\n\ndef remove_elements(base: List[T], to_remove: List[T]) -> List[T]:\n    \"\"\"\n    Removes all elements from the base list that are present in the to_remove list,\n    preserving the order of the remaining elements.\n    Optimizes for hashable elements using a set for faster lookups.\n    \"\"\"\n\n    def _is_hashable(obj: Any) -> bool:\n        \"\"\"Checks if an object is hashable for set operations.\"\"\"\n        try:\n            hash(obj)\n            return True\n        except TypeError:\n            return False\n\n    # Check if all elements in to_remove are hashable to use a set for efficiency.\n    if all(_is_hashable(x) for x in to_remove):\n        to_remove_set = set(to_remove)\n        result = [x for x in base if x not in to_remove_set]\n    else:\n        # Fallback for unhashable elements, which requires a linear scan for each element in base.\n        result = [x for x in base if all(x != r for r in to_remove)]\n\n    return result"}
{"task_id": "Mbpp/162", "solution": "class InvalidInputError(Exception):\n    \"\"\"Custom exception for invalid input values.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\nclass InputValidator:\n    \"\"\"Provides static methods for validating function inputs.\"\"\"\n    @staticmethod\n    def validate_non_negative_int(n: object) -> None:\n        \"\"\"Validates that n is a non-negative integer and not a boolean.\"\"\"\n        if isinstance(n, bool):\n            raise InvalidInputError(\"Boolean values are not accepted as integers.\")\n        if not isinstance(n, int):\n            raise InvalidInputError(f\"Expected int, got {type(n).__name__}.\")\n        if n < 0:\n            raise InvalidInputError(\"n must be non-negative.\")\n\nclass FormulaCalculator:\n    \"\"\"Encapsulates the arithmetic formula and term computations for the series.\"\"\"\n    @staticmethod\n    def compute_term_count(n: int) -> int:\n        \"\"\"Calculates the number of terms in the series.\"\"\"\n        return n // 2 + 1\n\n    @staticmethod\n    def compute_last_term(n: int) -> int:\n        \"\"\"Determines the value of the last term in the series.\"\"\"\n        t = FormulaCalculator.compute_term_count(n)\n        return n - 2 * (t - 1)\n\n    @staticmethod\n    def compute_sum_formula(n: int) -> int:\n        \"\"\"Computes the sum of the series using a closed-form formula.\"\"\"\n        t = FormulaCalculator.compute_term_count(n)\n        last = FormulaCalculator.compute_last_term(n)\n        return t * (n + last) // 2\n\nclass SumResult:\n    \"\"\"A data transfer object to hold the result and metadata of a series computation.\"\"\"\n    def __init__(self, value: int, term_count: int, last_term: int) -> None:\n        self.value = value\n        self.term_count = term_count\n        self.last_term = last_term\n\n    def to_dict(self) -> dict:\n        \"\"\"Converts the SumResult object to a dictionary.\"\"\"\n        return {\"value\": self.value, \"term_count\": self.term_count, \"last_term\": self.last_term}\n\nclass SumSeriesService:\n    \"\"\"Provides business logic orchestration and offers both formula and iterative sum methods.\"\"\"\n    def __init__(self, validator: InputValidator = None, calculator: FormulaCalculator = None) -> None:\n        self.validator = validator or InputValidator()\n        self.calculator = calculator or FormulaCalculator()\n\n    def sum(self, n: int, method: str = \"formula\") -> SumResult:\n        \"\"\"Dispatches to the chosen sum computation method after input validation.\"\"\"\n        self.validator.validate_non_negative_int(n)\n        if method == \"formula\":\n            value = self.calculator.compute_sum_formula(n)\n            term_count = self.calculator.compute_term_count(n)\n            last_term = self.calculator.compute_last_term(n)\n            return SumResult(value=value, term_count=term_count, last_term=last_term)\n        elif method == \"iterative\":\n            return self.sum_iterative(n)\n        else:\n            raise ValueError(f\"Unsupported method: {method}\")\n\n    def sum_iterative(self, n: int) -> SumResult:\n        \"\"\"Computes the sum of the series using an iterative approach.\"\"\"\n        self.validator.validate_non_negative_int(n)\n        total = 0\n        term_count = self.calculator.compute_term_count(n)\n        last_term = self.calculator.compute_last_term(n) # Calculate for SumResult\n        for i in range(term_count):\n            total += n - 2 * i\n        return SumResult(value=total, term_count=term_count, last_term=last_term)\n\nclass SumSeriesController:\n    \"\"\"Handles public entry points, orchestrating validation and service calls.\"\"\"\n    def __init__(self, validator: InputValidator = None, service: SumSeriesService = None) -> None:\n        self.validator = validator or InputValidator()\n        self.service = service or SumSeriesService()\n\n    def compute(self, n: int, method: str = \"formula\") -> int:\n        \"\"\"Validates input and delegates to SumSeriesService to return the integer result.\"\"\"\n        self.validator.validate_non_negative_int(n) # Redundant but as per design sequence\n        result = self.service.sum(n, method)\n        return result.value\n\ndef sum_series(n: int, method: str = \"formula\") -> int:\n    \"\"\"Calculates the sum of the series (n - 2*i) from i=0 to n // 2.\"\"\"\n    return SumSeriesController().compute(n, method)"}
{"task_id": "Mbpp/166", "solution": "def find_even_pair(nums):\n    \"\"\"\n    Counts the number of pairs of integers in a list that XOR to an even number.\n    This occurs when both integers in a pair have the same parity.\n    \"\"\"\n    evens = 0\n    odds = 0\n    for x in nums:\n        if x % 2 == 0:\n            evens += 1\n        else:\n            odds += 1\n\n    # C(n, 2) = n * (n - 1) // 2\n    pairs = (evens * (evens - 1) // 2) + (odds * (odds - 1) // 2)\n    return pairs"}
{"task_id": "Mbpp/165", "solution": "def count_char_position(s: str) -> int:\n    \"\"\"\n    Counts characters in a string that occur at the same position as in the English alphabet (case insensitive).\n    Alphabet positions are 1-indexed (a=1, b=2, ... z=26).\n    \"\"\"\n    alphabet_map = {chr(ord('a') + i): i + 1 for i in range(26)}\n\n    count = 0\n    for idx, char_in_string in enumerate(s, start=1):\n        lower_char = char_in_string.lower()\n        # Check if the character is an alphabet letter and its position matches the index\n        if lower_char in alphabet_map and alphabet_map[lower_char] == idx:\n            count += 1\n    return count"}
{"task_id": "Mbpp/167", "solution": "def next_power_of_2(n):\n    \"\"\"\n    Finds the smallest power of 2 greater than or equal to n.\n    Handles n == 0 by returning 1.\n\n    Note: This function expects n to be a non-negative integer.\n    \"\"\"\n    if not isinstance(n, int):\n        # allow objects implementing __index__\n        if hasattr(n, \"__index__\"):\n            n = n.__index__()\n        else:\n            raise TypeError(f\"Expected integer-like input, got {type(n).__name__}\")\n    if n < 0:\n        raise ValueError(\"n must be non-negative\")\n    if n == 0:\n        return 1\n    # For n > 0, smallest power of 2 >= n is 1 << (n-1).bit_length()\n    return 1 << (n - 1).bit_length()"}
{"task_id": "Mbpp/160", "solution": "def find_solution(a: int, b: int, n: int) -> tuple[int, int] | None:\n    # Handle the special case where both coefficients are zero.\n    if a == 0 and b == 0:\n        return (0, 0) if n == 0 else None\n\n    # Extended Euclidean Algorithm to find g = gcd(a, b) and coefficients xg, yg such that a*xg + b*yg = g.\n    old_r, r = abs(a), abs(b)\n    old_s, s = (1 if a >= 0 else -1), 0\n    old_t, t = 0, (1 if b >= 0 else -1)\n\n    while r != 0:\n        q = old_r // r\n        old_r, r = r, old_r - q * r\n        old_s, s = s, old_s - q * s\n        old_t, t = t, old_t - q * t\n\n    g = old_r  # gcd(a, b)\n    xg_raw = old_s\n    yg_raw = old_t\n\n    # If n is not divisible by g, no integer solution exists.\n    if n % g != 0:\n        return None\n\n    # Scale the particular solution by n/g.\n    mult = n // g\n    x_particular = xg_raw * mult\n    y_particular = yg_raw * mult\n\n    # If b != 0, adjust x to a representative modulo (b/g) to produce a small or canonical solution.\n    if b != 0:\n        b_over_g = b // g\n        # Choose x in the range 0..|b_over_g|-1 (or minimal positive representative).\n        # Using modulo yields a value congruent to x_particular mod (b/g).\n        x_final = x_particular % b_over_g\n        y_final = (n - a * x_final) // b\n        return (x_final, y_final)\n    elif a != 0:\n        # If b == 0, then the equation is a*x = n; return the unique solution if it exists.\n        return (x_particular, y_particular)\n    else:\n        return None"}
{"task_id": "Mbpp/170", "solution": "def sum_range_list(nums: list, start: int, end: int) -> int:\n    \"\"\"\n    Return the inclusive sum of integers in `nums` from index `start` to `end`.\n    Supports Python-style negative indices. Raises:\n      - TypeError for invalid types,\n      - IndexError for out-of-range indices or empty list,\n      - ValueError if start > end (after normalization).\n    \"\"\"\n    # Type checks\n    if not isinstance(nums, (list, tuple)):\n        raise TypeError(\"nums must be a list or tuple of integers\")\n    if not all(isinstance(x, int) for x in nums):\n        raise TypeError(\"all elements of nums must be integers\")\n    if not isinstance(start, int) or not isinstance(end, int):\n        raise TypeError(\"start and end must be integers\")\n\n    n = len(nums)\n    if n == 0:\n        raise IndexError(\"nums is empty\")\n\n    # Normalize negative indices to Python-style positions\n    start_idx = start if start >= 0 else n + start\n    end_idx = end if end >= 0 else n + end\n\n    # Validate bounds after normalization\n    if start_idx < 0 or start_idx >= n or end_idx < 0 or end_idx >= n:\n        raise IndexError(\"start or end index out of range\")\n    if start_idx > end_idx:\n        raise ValueError(\"start index is greater than end index\")\n\n    return sum(nums[start_idx : end_idx + 1])"}
{"task_id": "Mbpp/168", "solution": "def frequency(lst, item) -> int:\n    \"\"\"\n    Counts the occurrences of an item in a list using equality comparison.\n    Iterates through the list and increments a counter for each match.\n    \"\"\"\n    count = 0\n    for element in lst:\n        if element == item:\n            count += 1\n    return count"}
