{"task_id": "Mbpp/425", "solution": "from typing import Any, List, Optional, Dict\n\nclass CountError(Exception):\n    \"\"\"Base exception for counting operations.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\nclass InvalidInputError(CountError):\n    \"\"\"Exception raised for invalid input data.\"\"\"\n    pass\n\nclass CountRequest:\n    \"\"\"Data transfer object for count requests.\"\"\"\n    def __init__(self, list_of_lists: List[List[Any]], element: Any) -> None:\n        self.list_of_lists = list_of_lists\n        self.element = element\n\nclass CountResult:\n    \"\"\"Data transfer object for count results.\"\"\"\n    def __init__(self, count: int, request: Optional[CountRequest] = None) -> None:\n        self.count = count\n        self.request = request\n\n    def to_dict(self) -> Dict[str, Any]:\n        \"\"\"Converts the result to a dictionary.\"\"\"\n        return {\"count\": self.count}\n\nclass InputValidator:\n    \"\"\"Validates and normalizes input data structures.\"\"\"\n    def validate_list_of_lists(self, list_of_lists: Any) -> List[List[Any]]:\n        \"\"\"Ensures input is an iterable of iterables.\"\"\"\n        if not hasattr(list_of_lists, \"__iter__\") or isinstance(list_of_lists, (str, bytes)):\n            raise InvalidInputError(\"list_of_lists must be an iterable of iterables\")\n        result = []\n        for idx, sub in enumerate(list_of_lists):\n            if not hasattr(sub, \"__iter__\") or isinstance(sub, (str, bytes)):\n                raise InvalidInputError(f\"sublist at index {idx} is not an iterable\")\n            result.append(list(sub))\n        return result\n\n    def validate_element(self, element: Any) -> Any:\n        \"\"\"Validates or normalizes the element.\"\"\"\n        return element\n\nclass CountService:\n    \"\"\"Core counting logic for sublists.\"\"\"\n    def __init__(self) -> None:\n        pass\n\n    def count(self, request: CountRequest) -> CountResult:\n        \"\"\"Computes the count based on the request.\"\"\"\n        if not isinstance(request, CountRequest):\n            raise TypeError(\"request must be CountRequest\")\n        cnt = self._count_in_sublists(request.list_of_lists, request.element)\n        return CountResult(count=cnt, request=request)\n\n    def _count_in_sublists(self, list_of_lists: List[List[Any]], element: Any) -> int:\n        \"\"\"Iterates sublists and checks for element membership.\"\"\"\n        count = 0\n        for sub in list_of_lists:\n            if element in sub:\n                count += 1\n        return count\n\nclass CountController:\n    \"\"\"Orchestrates validation and service calls.\"\"\"\n    def __init__(self, validator: InputValidator, service: CountService) -> None:\n        self.validator = validator\n        self.service = service\n\n    def handle_count(self, list_of_lists: Any, element: Any) -> CountResult:\n        \"\"\"Handles a count request, validating input and calling the service.\"\"\"\n        normalized = self.validator.validate_list_of_lists(list_of_lists)\n        elem = self.validator.validate_element(element)\n        request = CountRequest(normalized, elem)\n        return self.service.count(request)\n\ndef count_element_in_list(list_of_lists: List[List[Any]], element: Any) -> int:\n    \"\"\"\n    Counts the number of sublists containing a particular element.\n    This function wraps the core counting logic through a controller, validator, and service pattern.\n    \"\"\"\n    validator = InputValidator()\n    service = CountService()\n    controller = CountController(validator, service)\n    result = controller.handle_count(list_of_lists, element)\n    return result.count"}
