{"task_id": "Mbpp/61", "solution": "def count_Substrings(s: str) -> int:\n    \"\"\"\n    Counts the number of substrings where the sum of digits equals the substring's length.\n    Uses a prefix sum approach to achieve O(n) time complexity.\n    \"\"\"\n    if not isinstance(s, str):\n        raise TypeError(\"Input must be a string.\")\n    if s and not s.isdigit():\n        raise ValueError(\"Input string must contain only digits.\")\n\n    n = len(s)\n    prefix_sum = [0] * (n + 1)\n    for i in range(n):\n        prefix_sum[i + 1] = prefix_sum[i] + (ord(s[i]) - 48)\n\n    # Frequencies of (prefix_sum[i] - i) values\n    transformed_counts = {}\n    for i in range(n + 1):\n        key = prefix_sum[i] - i\n        transformed_counts[key] = transformed_counts.get(key, 0) + 1\n\n    total_substrings = 0\n    for count in transformed_counts.values():\n        # number of pairs = nC2 = count * (count - 1) // 2\n        total_substrings += count * (count - 1) // 2\n\n    return total_substrings"}
{"task_id": "Mbpp/65", "solution": "def recursive_list_sum(data):\n    \"\"\"\n    Flattens a list, summing all numeric elements recursively.\n    Handles nested lists and tuples containing integers or floats.\n    \"\"\"\n    total_sum = 0.0\n    stack = [data]\n\n    while stack:\n        current_element = stack.pop()\n\n        if isinstance(current_element, (list, tuple)):\n            # Extend the stack with elements in reverse order to process them correctly\n            for item in reversed(current_element):\n                stack.append(item)\n        elif isinstance(current_element, (int, float)):\n            total_sum += float(current_element)\n        # Other types are ignored for this simple implementation.\n\n    return total_sum"}
{"task_id": "Mbpp/67", "solution": "def bell_number(n: int) -> int:\n    \"\"\"\n    Computes the nth Bell number using the Bell triangle method.\n    The Bell number B_n represents the number of partitions of a set with n elements.\n    \"\"\"\n    if not isinstance(n, int) or n < 0:\n        raise ValueError(\"n must be a non-negative integer\")\n\n    if n == 0:\n        return 1\n\n    # Initialize the Bell triangle. bell_triangle[i] will store the i-th row.\n    # The first element of each row (bell_triangle[i][0]) will be the i-th Bell number, B_i.\n    bell_triangle = [[1]]  # Represents T[0][0] which is B_0\n\n    for i in range(1, n + 1):\n        current_row = [0] * (i + 1)\n        # The first element of the current row is the last element of the previous row.\n        current_row[0] = bell_triangle[i - 1][-1]\n\n        # Compute remaining elements in the current row.\n        for j in range(1, i + 1):\n            current_row[j] = current_row[j - 1] + bell_triangle[i - 1][j - 1]\n\n        bell_triangle.append(current_row)\n\n    # The nth Bell number is the first element of the nth row (0-indexed).\n    return bell_triangle[n][0]"}
{"task_id": "Mbpp/68", "solution": "def is_Monotonic(arr):\n    \"\"\"Checks if an array is monotonic (non-increasing or non-decreasing).\"\"\"\n    if len(arr) <= 1:\n        return True\n\n    is_non_decreasing = True\n    is_non_increasing = True\n\n    for i in range(len(arr) - 1):\n        if arr[i] > arr[i+1]:\n            is_non_decreasing = False\n        if arr[i] < arr[i+1]:\n            is_non_increasing = False\n\n    return is_non_decreasing or is_non_increasing"}
