{"task_id": "Mbpp/255", "solution": "import itertools\nfrom typing import List, Tuple, Any, Sequence\n\ndef combinations_colors(elements: Sequence[Any], n: int) -> List[Tuple[Any, ...]]:\n    \"\"\"\n    Generates all combinations (with repetition) of the elements of the list for a given length n.\n    Returns a list with a tuple for each combination.\n    \"\"\"\n    # Validate n\n    n_int = int(n)\n    if n_int < 0:\n        raise ValueError(\"n must be non-negative\")\n    # Ensure elements is iterable\n    try:\n        _ = iter(elements)\n    except TypeError:\n        raise TypeError(\"elements must be an iterable\")\n    return [tuple(combo) for combo in itertools.product(elements, repeat=n_int)]"}
{"task_id": "Mbpp/259", "solution": "def maximize_elements(t1, t2):\n    tup1 = tuple(tuple(inner) for inner in t1)\n    tup2 = tuple(tuple(inner) for inner in t2)\n\n    if len(tup1) != len(tup2):\n        raise ValueError(f\"Top-level lengths differ: len(t1)={len(tup1)}, len(t2)={len(tup2)}\")\n\n    for i, (inner1, inner2) in enumerate(zip(tup1, tup2)):\n        if len(inner1) != len(inner2):\n            raise ValueError(\n                f\"Inner lengths differ at index {i}: len(t1[{i}])={len(inner1)}, len(t2[{i}])={len(inner2)}\"\n            )\n\n    return tuple(\n        tuple(max(a, b) for a, b in zip(inner1, inner2))\n        for inner1, inner2 in zip(tup1, tup2)\n    )"}
{"task_id": "Mbpp/260", "solution": "def newman_prime(n: int) -> int:\n    \"\"\"\n    Computes the nth Newman\u2013Shanks\u2013Williams (NSW) number S(n).\n    Uses matrix exponentiation for O(log n) time complexity.\n    \"\"\"\n    if n == 0:\n        return 1\n    if n == 1:\n        return 1\n\n    # Helper function to multiply two 2x2 matrices\n    def multiply_matrices(A, B):\n        return [[A[0][0]*B[0][0] + A[0][1]*B[1][0], A[0][0]*B[0][1] + A[0][1]*B[1][1]],\n                [A[1][0]*B[0][0] + A[1][1]*B[1][0], A[1][0]*B[0][1] + A[1][1]*B[1][1]]]\n\n    # Helper function to compute matrix M^p using binary exponentiation\n    def matrix_power(M, p):\n        result = [[1, 0], [0, 1]]  # Identity matrix\n        base = M\n        while p > 0:\n            if p % 2 == 1:\n                result = multiply_matrices(result, base)\n            base = multiply_matrices(base, base)\n            p //= 2\n        return result\n\n    # The recurrence S(n) = 2*S(n-1) + S(n-2) with S(0)=1, S(1)=1\n    # Can be represented by the matrix:\n    # [S(k+1)]   = [[2, 1]] * [S(k)]\n    # [S(k)]       [[1, 0]]   [S(k-1)]\n    # So, [S(n), S(n-1)]^T = M^(n-1) * [S(1), S(0)]^T\n    # M = [[2, 1], [1, 0]]\n    # Initial vector [S(1), S(0)]^T = [1, 1]^T\n\n    M = [[2, 1], [1, 0]]\n\n    # Compute M^(n-1)\n    powered_matrix = matrix_power(M, n - 1)\n\n    # S(n) = powered_matrix[0][0] * S(1) + powered_matrix[0][1] * S(0)\n    # Since S(1)=1 and S(0)=1:\n    return powered_matrix[0][0] + powered_matrix[0][1]"}
{"task_id": "Mbpp/261", "solution": "def division_elements(left_tuple: tuple, right_tuple: tuple) -> tuple:\n    \"\"\"\n    Performs element-wise division on two tuples of equal length.\n    If both operands are integers, uses integer division; otherwise, uses float division.\n\n    Raises:\n        TypeError: if inputs are not tuples or elements are not int/float.\n        ValueError: if tuples have different lengths.\n        ZeroDivisionError: if any denominator is zero.\n    \"\"\"\n    if not isinstance(left_tuple, tuple) or not isinstance(right_tuple, tuple):\n        raise TypeError(\"Both inputs must be tuples.\")\n    if len(left_tuple) != len(right_tuple):\n        raise ValueError(\"Tuples must be of the same length.\")\n\n    result = []\n    for i, (a, b) in enumerate(zip(left_tuple, right_tuple)):\n        if not isinstance(a, (int, float)) or not isinstance(b, (int, float)):\n            raise TypeError(f\"Elements must be numeric (int or float). Invalid element at index {i}.\")\n        if b == 0:\n            raise ZeroDivisionError(f\"Division by zero at index {i}.\")\n        if isinstance(a, int) and isinstance(b, int):\n            result.append(a // b)\n        else:\n            result.append(a / b)\n    return tuple(result)"}
{"task_id": "Mbpp/265", "solution": "def list_split(items, n):\n    \"\"\"\n    Splits a list into n sublists where each sublist contains elements at a stride of n.\n    The i-th sublist contains elements items[i], items[i+n], items[i+2n], etc.\n    \"\"\"\n    if n <= 0:\n        return []\n\n    result = [[] for _ in range(n)]\n    for i, item in enumerate(items):\n        sublist_index = i % n\n        result[sublist_index].append(item)\n    return result"}
{"task_id": "Mbpp/264", "solution": "def dog_age(human_age_years: float) -> int:\n    \"\"\"Calculates a dog's age in dog years using the AVMA-like formula.\"\"\"\n    if human_age_years <= 0:\n        dog_years_float = 0.0\n    elif human_age_years <= 2:\n        dog_years_float = human_age_years * 10.5\n    else:\n        dog_years_float = 21.0 + (human_age_years - 2.0) * 4.0\n\n    return int(round(dog_years_float))"}
{"task_id": "Mbpp/262", "solution": "from typing import List, Tuple, TypeVar, Sequence, Any\nfrom collections.abc import Sequence as ABCSequence\n\nT = TypeVar(\"T\")\n\nclass InvalidInputError(Exception):\n    def __init__(self, message: str):\n        super().__init__(message)\n\nclass TypeMismatchError(InvalidInputError):\n    pass\n\nclass ValueRangeError(InvalidInputError):\n    pass\n\ndef is_sequence(obj: Any) -> bool:\n    \"\"\"Checks if an object is a sequence but not a string or bytes.\"\"\"\n    return isinstance(obj, ABCSequence) and not isinstance(obj, (str, bytes))\n\ndef to_list(seq: Sequence[T]) -> List[T]:\n    \"\"\"Converts a sequence to a new list (shallow copy).\"\"\"\n    return list(seq)\n\nclass SplitResult:\n    def __init__(self, first: List[T], second: List[T]) -> None:\n        self.first = first\n        self.second = second\n\n    def as_tuple(self) -> Tuple[List[T], List[T]]:\n        return (self.first, self.second)\n\nclass InputValidator:\n    def validate(self, lst: Any, L: Any) -> None:\n        \"\"\"Validates inputs and raises errors if invalid.\"\"\"\n        if not is_sequence(lst):\n            raise TypeMismatchError(\"lst must be a sequence (list/tuple) and not a string/bytes\")\n        if not isinstance(L, int):\n            raise TypeMismatchError(\"L must be an int\")\n        if L < 0:\n            raise ValueRangeError(\"L must be non-negative\")\n\nclass Splitter:\n    def split(self, lst: Sequence[T], L: int) -> SplitResult:\n        \"\"\"Splits the list into two parts and returns a SplitResult.\"\"\"\n        first = to_list(lst[:L])\n        second = to_list(lst[L:])\n        return SplitResult(first, second)\n\n_validator = InputValidator()\n_splitter = Splitter()\n\ndef split_two_parts(lst: Sequence[T], L: int) -> Tuple[List[T], List[T]]:\n    \"\"\"Splits a list into two parts: the first L elements and the rest.\"\"\"\n    _validator.validate(lst, L)\n    result = _splitter.split(lst, L)\n    return result.as_tuple()"}
{"task_id": "Mbpp/266", "solution": "def lateralsurface_cube(side: float) -> float:\n    \"\"\"Calculates the lateral surface area of a cube.\n\n    The lateral surface area is the sum of the areas of its four side faces.\n    \"\"\"\n    return 4.0 * side * side"}
{"task_id": "Mbpp/267", "solution": "def square_Sum(n: int) -> int:\n    \"\"\"\n    Return the sum of the squares of the first n odd natural numbers.\n\n    Formula: sum_{k=1..n} (2k-1)^2 = n * (4*n^2 - 1) / 3\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n    if n < 0:\n        raise ValueError(\"n must be non-negative\")\n    return n * (4 * n * n - 1) // 3"}
