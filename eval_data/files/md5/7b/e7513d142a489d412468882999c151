{"task_id": "Mbpp/629", "solution": "def Split(numbers: list) -> list:\n    from typing import List, Any, Optional, Dict\n\n    class Config:\n        DEFAULT_PERSIST = False\n        PERSIST_PATH = \"splitter_last_run.json\"\n        LOG_LEVEL = \"INFO\"\n\n    class InvalidInputError(Exception):\n        def __init__(self, message: str, bad_item: Optional[Any] = None) -> None:\n            super().__init__(message)\n            self.bad_item = bad_item\n\n    class InputValidator:\n        def is_iterable(self, value: Any) -> bool:\n            return hasattr(value, \"__iter__\") and not isinstance(value, (str, bytes))\n\n        def _ensure_int(self, item: Any, index: int) -> int:\n            if not isinstance(item, int):\n                raise InvalidInputError(f\"Item at index {index} is not an int\", bad_item=item)\n            return item\n\n        def validate_numbers(self, numbers: Any) -> List[int]:\n            if not self.is_iterable(numbers):\n                raise InvalidInputError(\"Input is not iterable\", bad_item=numbers)\n            result = []\n            for i, item in enumerate(numbers):\n                result.append(self._ensure_int(item, i))\n            return result\n\n    def is_even(n: int) -> bool:\n        return n % 2 == 0\n\n    class EvenFilterService:\n        def __init__(self) -> None:\n            pass\n\n        def filter_even(self, numbers: List[int]) -> List[int]:\n            return [n for n in numbers if is_even(n)]\n\n    class InMemoryRepository:\n        def __init__(self) -> None:\n            self._last_input: Optional[List[int]] = None\n            self._last_output: Optional[List[int]] = None\n\n        def save(self, input_numbers: List[int], output_numbers: List[int]) -> None:\n            self._last_input = list(input_numbers)\n            self._last_output = list(output_numbers)\n\n        def get_last_run(self) -> Dict[str, List[int]]:\n            return {\n                \"input\": self._last_input if self._last_input is not None else [],\n                \"output\": self._last_output if self._last_output is not None else [],\n            }\n\n    class SplitController:\n        def __init__(self, service: EvenFilterService, validator: InputValidator, repository: Optional[InMemoryRepository]=None) -> None:\n            self._service = service\n            self._validator = validator\n            self._repository = repository\n\n        def split(self, numbers: Any) -> List[int]:\n            validated = self._validator.validate_numbers(numbers)\n            output = self._service.filter_even(validated)\n            if self._repository:\n                try:\n                    self._repository.save(validated, output)\n                except Exception:\n                    # Log and ignore persistence failures as per design.\n                    pass\n            return output\n\n    validator = InputValidator()\n    service = EvenFilterService()\n    repository = InMemoryRepository() if Config.DEFAULT_PERSIST else None\n    controller = SplitController(service=service, validator=validator, repository=repository)\n    return controller.split(numbers)"}
{"task_id": "Mbpp/626", "solution": "import math\nfrom typing import Any, Optional\n\ndef triangle_area(radius: Any) -> Optional[float]:\n    \"\"\"\n    Calculates the area of the largest triangle inscribed in a semicircle.\n    Returns the area as a float, or None for invalid inputs.\n    \"\"\"\n\n    def _is_finite_number(x: Any) -> bool:\n        \"\"\"Checks if a value is a finite float or integer.\"\"\"\n        if isinstance(x, (int, float)):\n            return math.isfinite(float(x))\n        return False\n\n    MIN_RADIUS: float = 0.0\n\n    try:\n        r_float = float(radius)\n    except (TypeError, ValueError):\n        return None\n\n    if not _is_finite_number(r_float):\n        return None\n\n    if r_float < MIN_RADIUS:\n        return None\n\n    # The maximum area of a triangle inscribed in a semicircle of radius R is R^2.\n    area = r_float * r_float\n\n    return area"}
{"task_id": "Mbpp/632", "solution": "def move_zero(nums: list) -> list:\n    \"\"\"\n    Moves all zeroes to the end of the given list while preserving the relative order of non-zero elements.\n    Returns a new list with the transformation.\n    \"\"\"\n    nonzeros = [x for x in nums if x != 0]\n    zeros = [0] * (len(nums) - len(nonzeros))\n    return nonzeros + zeros"}
{"task_id": "Mbpp/633", "solution": "def pair_xor_Sum(nums, n):\n    \"\"\"\n    Calculates the sum of XOR of all unique pairs of numbers in the given list using bitwise operations.\n    For each bit position, it counts numbers with that bit set and sums their contribution.\n    \"\"\"\n    if n < 2:\n        return 0\n\n    max_val = max(abs(x) for x in nums) if nums else 0\n    # Determine the maximum number of bits to check.\n    # Adding 1 to account for potential edge cases or the most significant bit itself.\n    max_bits = max_val.bit_length() + 1 if max_val > 0 else 1\n\n    total_xor_sum = 0\n\n    for bit_pos in range(max_bits):\n        set_bit_count = 0\n        mask = 1 << bit_pos\n        for num in nums:\n            if num & mask:\n                set_bit_count += 1\n\n        # The number of pairs (x, y) where the `bit_pos`-th bit of x ^ y is 1\n        # is `set_bit_count * (n - set_bit_count)`.\n        # This is because one number must have the bit set and the other must not.\n        total_xor_sum += (set_bit_count * (n - set_bit_count)) * mask\n\n    return total_xor_sum"}
{"task_id": "Mbpp/635", "solution": "def heap_sort(data):\n    \"\"\"Sorts a list in ascending order using the heap sort algorithm.\n    Returns a new sorted list, leaving the original unchanged.\n    \"\"\"\n    arr = list(data)  # Create a working copy to avoid mutating the original list\n    n = len(arr)\n\n    def _sift_down(root_idx, end_idx):\n        \"\"\"Sifts the element at root_idx down in the heap to maintain the heap property.\"\"\"\n        while True:\n            left_child_idx = 2 * root_idx + 1\n            right_child_idx = 2 * root_idx + 2\n            max_idx = root_idx\n\n            # Find the largest among root, left child, and right child\n            if left_child_idx <= end_idx and arr[left_child_idx] > arr[max_idx]:\n                max_idx = left_child_idx\n            if right_child_idx <= end_idx and arr[right_child_idx] > arr[max_idx]:\n                max_idx = right_child_idx\n\n            if max_idx != root_idx:\n                # Swap if the root is not the largest\n                arr[root_idx], arr[max_idx] = arr[max_idx], arr[root_idx]\n                root_idx = max_idx  # Continue sifting down from the swapped position\n            else:\n                break  # Root is in its correct place\n\n    # Build the initial max-heap\n    # Iterate from the last non-leaf node up to the root\n    for i in range(n // 2 - 1, -1, -1):\n        _sift_down(i, n - 1)\n\n    # Extract elements one by one from the heap\n    # Place the largest element at the end of the array, effectively sorting it in place\n    for i in range(n - 1, 0, -1):\n        # Swap current root (maximum element) with the last element of the unsorted part\n        arr[0], arr[i] = arr[i], arr[0]\n        # Reduce the heap size and sift down the new root\n        _sift_down(0, i - 1)\n\n    return arr"}
{"task_id": "Mbpp/637", "solution": "def noprofit_noloss(sp, cp):\n    \"\"\"\n    Checks if the selling price (sp) is equal to the cost price (cp)\n    within a small tolerance, indicating no profit and no loss.\n    \"\"\"\n    epsilon = 1e-9  # Default tolerance for float comparison as per design\n    return abs(sp - cp) <= epsilon"}
{"task_id": "Mbpp/638", "solution": "from decimal import Decimal, ROUND_HALF_UP\n\ndef wind_chill(velocity_kmh: float, temp_c: float) -> int:\n    \"\"\"\n    Calculates the wind chill index using the Canadian formula, rounded to the nearest integer.\n    \"\"\"\n    # Canadian wind chill formula: W = 13.12 + 0.6215*T - 11.37*V^0.16 + 0.3965*T*V^0.16\n    # where T is temperature in Celsius and V is wind velocity in km/h.\n\n    v_power = velocity_kmh ** 0.16\n\n    raw_wind_chill = (13.12 +\n                      0.6215 * temp_c -\n                      11.37 * v_power +\n                      0.3965 * temp_c * v_power)\n\n    # Round to the nearest integer using half-up rounding.\n    rounded_wind_chill = int(Decimal(raw_wind_chill).quantize(Decimal('1'), rounding=ROUND_HALF_UP))\n\n    return rounded_wind_chill"}
{"task_id": "Mbpp/639", "solution": "def sample_nam(names):\n    \"\"\"\n    Sums the length of names that do not start with a lowercase ASCII letter,\n    after normalizing each name by stripping whitespace.\n    \"\"\"\n    total_length = 0\n    for name in names:\n        # Normalize the name by stripping leading/trailing whitespace\n        normalized_name = name.strip()\n\n        # Determine if the normalized name starts with a lowercase ASCII letter ('a' through 'z').\n        # An empty string does not start with a lowercase letter.\n        starts_with_lowercase = False\n        if normalized_name:\n            first_char = normalized_name[0]\n            if 'a' <= first_char <= 'z':\n                starts_with_lowercase = True\n\n        # If the name does not start with a lowercase letter, add its length to the total.\n        if not starts_with_lowercase:\n            total_length += len(normalized_name)\n\n    return total_length"}
{"task_id": "Mbpp/641", "solution": "def is_nonagonal(n: int) -> int:\n    \"\"\"\n    Calculates the nth nonagonal number using the closed-form formula.\n    The formula for the nth nonagonal number is P_9(n) = (7*n*n - 5*n) // 2.\n    \"\"\"\n    return (7 * n * n - 5 * n) // 2"}
{"task_id": "Mbpp/643", "solution": "import re\n\ndef text_match_wordz_middle(text: str) -> bool:\n    \"\"\"\n    Checks if the text contains any word with 'z' (case-insensitive) in a middle position.\n    A middle position is any index greater than 0 and less than len(word)-1.\n    \"\"\"\n    WORD_REGEX = r\"\\b\\w+\\b\"\n    MIN_WORD_LENGTH_FOR_MIDDLE = 3\n\n    def _find_middle_z_index(word: str) -> int | None:\n        \"\"\"Helper to find the first middle 'z' index in a word, or None if not found.\"\"\"\n        n = len(word)\n        if n < MIN_WORD_LENGTH_FOR_MIDDLE:\n            return None\n        for i in range(1, n - 1): # Check characters from index 1 up to (n-2)\n            if word[i].lower() == 'z':\n                return i\n        return None\n\n    # Treat None as an empty string and convert other types to string.\n    processed_text = str(text) if text is not None else \"\"\n\n    words = re.findall(WORD_REGEX, processed_text)\n\n    for word in words:\n        if _find_middle_z_index(word) is not None:\n            return True\n\n    return False"}
{"task_id": "Mbpp/723", "solution": "def count_same_pair(list1, list2):\n    \"\"\"\n    Counts the number of indices where values in two lists of the same length are identical.\n    \"\"\"\n    count = 0\n    for i in range(len(list1)):\n        if list1[i] == list2[i]:\n            count += 1\n    return count"}
{"task_id": "Mbpp/644", "solution": "from typing import Any, List\n\ndef reverse_Array_Upto_K(arr: List[Any], k: int) -> List[Any]:\n    \"\"\"Reverses the first k elements of an array, returning a new array without mutating the original.\"\"\"\n    items = list(arr)\n    n = len(items)\n\n    if k <= 0:\n        return items\n    elif k >= n:\n        return items[::-1]\n    else:\n        return items[:k][::-1] + items[k:]"}
