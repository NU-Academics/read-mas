{"task_id": "Mbpp/450", "solution": "def extract_string(values: list[str], size: int) -> list[str]:\n    \"\"\"\n    Extracts strings of an exact specified length from a list of strings.\n    Returns a new list containing only strings whose length equals `size`.\n    \"\"\"\n    return [s for s in values if len(s) == size]"}
{"task_id": "Mbpp/454", "solution": "import re\n\ndef text_match_wordz(text: str) -> bool:\n    \"\"\"\n    Checks if the given text contains at least one word that includes the letter 'z' (case-insensitive).\n    A word is defined as a sequence of word characters bounded by word boundaries.\n    \"\"\"\n    pattern = re.compile(r'\\b\\w*z\\w*\\b', re.IGNORECASE)\n    return bool(pattern.search(text))"}
{"task_id": "Mbpp/453", "solution": "import math\n\ndef sumofFactors(n: int) -> int:\n    \"\"\"\n    Calculates the sum of even factors of a given number.\n    Handles negative numbers by using their absolute value.\n    \"\"\"\n    num = abs(n)\n    if num == 0:\n        return 0\n\n    total = 0\n    limit = int(math.isqrt(num))\n\n    for i in range(1, limit + 1):\n        if num % i == 0:\n            d1 = i\n            d2 = num // i\n\n            if d1 % 2 == 0:\n                total += d1\n            if d2 != d1 and d2 % 2 == 0:\n                total += d2\n    return total"}
{"task_id": "Mbpp/456", "solution": "def reverse_string_list(values: list[str]) -> list[str]:\n    \"\"\"\n    Reverses each string in a given list of string values.\n    Assumes valid input as a list of strings.\n    \"\"\"\n    return [s[::-1] for s in values]"}
{"task_id": "Mbpp/459", "solution": "def remove_uppercase(s: str) -> str:\n    \"\"\"\n    Removes all contiguous uppercase substrings from the given string.\n    \"\"\"\n    result_chars = []\n    i = 0\n    n = len(s)\n    while i < n:\n        c = s[i]\n        if c.isupper():\n            # Skip the full uppercase run\n            j = i + 1\n            while j < n and s[j].isupper():\n                j += 1\n            i = j\n            continue\n        result_chars.append(c)\n        i += 1\n    return ''.join(result_chars)"}
{"task_id": "Mbpp/457", "solution": "def Find_Min(lists):\n    \"\"\"\n    Find and return the first sublist with the minimum length from a list of sublists.\n\n    Raises:\n        TypeError: if 'lists' is not a list or any element is not a list.\n        ValueError: if 'lists' is empty.\n    \"\"\"\n    if not isinstance(lists, list):\n        raise TypeError(\"lists must be a list of lists\")\n    if len(lists) == 0:\n        raise ValueError(\"lists must not be empty\")\n\n    min_sublist = lists[0]\n    min_len = len(min_sublist)\n\n    for i, sub in enumerate(lists):\n        if not isinstance(sub, list):\n            raise TypeError(f\"element at index {i} is not a list\")\n        l = len(sub)\n        if l < min_len:\n            min_len = l\n            min_sublist = sub\n\n    return min_sublist"}
{"task_id": "Mbpp/455", "solution": "def check_monthnumb_number(month: int) -> bool:\n    \"\"\"\n    Determines if a given month number (1-12) has 31 days.\n    It validates input and delegates to a service layer.\n    \"\"\"\n    from dataclasses import dataclass\n    from abc import ABC, abstractmethod\n\n    # Exceptions (from src/month_checker/exceptions.py)\n    class MonthError(Exception):\n        \"\"\"Base exception for month-related errors.\"\"\"\n        pass\n\n    class InvalidMonthError(MonthError):\n        \"\"\"Raised when a month number is invalid.\"\"\"\n        def __init__(self, message: str | None = None) -> None:\n            super().__init__(message if message is not None else \"Invalid month number provided.\")\n\n    # Models (from src/month_checker/models.py)\n    @dataclass(frozen=True)\n    class MonthModel:\n        \"\"\"Represents month metadata including number, name, and days.\"\"\"\n        number: int\n        name: str\n        days: int\n\n    # Constants mapping month numbers to MonthModel instances.\n    MONTHS_DEF = {\n        1: MonthModel(1, \"January\", 31),\n        2: MonthModel(2, \"February\", 28),\n        3: MonthModel(3, \"March\", 31),\n        4: MonthModel(4, \"April\", 30),\n        5: MonthModel(5, \"May\", 31),\n        6: MonthModel(6, \"June\", 30),\n        7: MonthModel(7, \"July\", 31),\n        8: MonthModel(8, \"August\", 31),\n        9: MonthModel(9, \"September\", 30),\n        10: MonthModel(10, \"October\", 31),\n        11: MonthModel(11, \"November\", 30),\n        12: MonthModel(12, \"December\", 31),\n    }\n\n    # Utils (from src/month_checker/utils.py)\n    def is_int_like(value: any) -> bool:\n        \"\"\"Checks if a value can be safely converted to an integer.\"\"\"\n        try:\n            int(value)\n            return True\n        except (ValueError, TypeError):\n            return False\n\n    def validate_month(month: any) -> int:\n        \"\"\"Validates if the input is an integer month number within 1-12, raising InvalidMonthError if not.\"\"\"\n        if not is_int_like(month):\n            raise InvalidMonthError(f\"Month must be an integer, got {type(month).__name__}.\")\n\n        m = int(month)\n        if not (1 <= m <= 12):\n            raise InvalidMonthError(f\"Month number must be between 1 and 12, got {m}.\")\n        return m\n\n    # Repository (from src/month_checker/repository.py)\n    class MonthRepository(ABC):\n        \"\"\"Abstract base class for month data repositories.\"\"\"\n        @abstractmethod\n        def get_days(self, month: int) -> int:\n            \"\"\"Retrieves the number of days for a given month.\"\"\"\n            pass\n\n    class InMemoryMonthRepository(MonthRepository):\n        \"\"\"An in-memory implementation of MonthRepository using a dictionary mapping.\"\"\"\n        def __init__(self, mapping: dict[int, int] | None = None) -> None:\n            self._mapping = mapping or {m: mm.days for m, mm in MONTHS_DEF.items()}\n\n        def get_days(self, month: int) -> int:\n            \"\"\"Returns the number of days for the specified month.\"\"\"\n            if month not in self._mapping:\n                raise InvalidMonthError(f\"Unknown month: {month}\")\n            return self._mapping[month]\n\n    # Service (from src/month_checker/services.py)\n    class MonthService:\n        \"\"\"Business logic to determine if a month has 31 days.\"\"\"\n        def __init__(self, repo: MonthRepository) -> None:\n            self._repo = repo\n\n        def has_31_days(self, month: int) -> bool:\n            \"\"\"Queries the repository for days and checks if it equals 31.\"\"\"\n            days = self._repo.get_days(month)\n            return days == 31\n\n    # Controller (from src/month_checker/controllers.py)\n    class MonthController:\n        \"\"\"Handles input validation and orchestrates service calls.\"\"\"\n        def __init__(self, service: MonthService) -> None:\n            self._service = service\n\n        def check_month(self, month: any) -> bool:\n            \"\"\"Validates the month input and delegates the check to the service.\"\"\"\n            m = validate_month(month)\n            return self._service.has_31_days(m)\n\n    # API helper (from src/month_checker/api.py)\n    def _default_service() -> MonthService:\n        \"\"\"Creates a default MonthService instance with an InMemoryMonthRepository.\"\"\"\n        repo = InMemoryMonthRepository()\n        return MonthService(repo)\n\n    # Main logic for check_monthnumb_number\n    service = _default_service()\n    controller = MonthController(service)\n    return controller.check_month(month)"}
{"task_id": "Mbpp/458", "solution": "def rectangle_area(width, height):\n    \"\"\"\n    Calculate and return the area of a rectangle.\n\n    Parameters:\n    - width: int or float (or convertible to float)\n    - height: int or float (or convertible to float)\n\n    Returns:\n    - float: area = width * height\n\n    Raises:\n    - TypeError: if width or height cannot be converted to a number\n    - ValueError: if width or height is not a finite number\n    \"\"\"\n    import math\n\n    try:\n        w = float(width)\n        h = float(height)\n    except (TypeError, ValueError):\n        raise TypeError(\"width and height must be numeric (int or float)\") from None\n\n    if not math.isfinite(w) or not math.isfinite(h):\n        raise ValueError(\"width and height must be finite numbers\")\n\n    return w * h"}
{"task_id": "Mbpp/460", "solution": "def Extract(lst):\n    \"\"\"\n    Extracts the first element from each sublist in a given list of lists.\n\n    Args:\n        lst: Iterable of sublists (each sublist must be indexable and non-empty).\n\n    Returns:\n        List of first elements from each sublist.\n\n    Raises:\n        IndexError: if any sublist is empty.\n        TypeError: if lst or its elements are not subscriptable.\n    \"\"\"\n    return [sublist[0] for sublist in lst]"}
{"task_id": "Mbpp/463", "solution": "def max_subarray_product(nums):\n    \"\"\"\n    Find the maximum product of a contiguous subarray within the given array.\n    Raises ValueError for empty input.\n    \"\"\"\n    if not nums:\n        raise ValueError(\"nums must be a non-empty list\")\n\n    curr_max = curr_min = global_max = nums[0]\n\n    for x in nums[1:]:\n        if x < 0:\n            curr_max, curr_min = curr_min, curr_max\n\n        curr_max = max(x, curr_max * x)\n        curr_min = min(x, curr_min * x)\n\n        global_max = max(global_max, curr_max)\n\n    return global_max"}
{"task_id": "Mbpp/470", "solution": "def add_pairwise(t: tuple[int | float, ...]) -> tuple[int | float, ...]:\n    \"\"\"\n    Computes the pairwise addition of neighboring elements in the given tuple.\n    Returns an empty tuple if the input tuple has fewer than two elements.\n    \"\"\"\n    if len(t) < 2:\n        return tuple()\n\n    return tuple(t[i] + t[i+1] for i in range(len(t) - 1))"}
{"task_id": "Mbpp/468", "solution": "def max_product(nums: list) -> float:\n    \"\"\"\n    Finds the maximum product formed by multiplying numbers of an increasing subsequence.\n    The subsequence must be strictly increasing.\n    \"\"\"\n    if not nums:\n        raise ValueError(\"Input list must not be empty\")\n\n    arr = [float(x) for x in nums]\n    n = len(arr)\n\n    # max_prod[i] stores the maximum product of an increasing subsequence ending at index i.\n    # Initialize each with the element itself, as a single element can be a subsequence.\n    max_prod = arr.copy()\n\n    for i in range(n):\n        for j in range(i):\n            # If arr[j] can precede arr[i] in a strictly increasing subsequence\n            if arr[j] < arr[i]:\n                candidate_product = max_prod[j] * arr[i]\n                # Update max_prod[i] if a larger product is found\n                if candidate_product > max_prod[i]:\n                    max_prod[i] = candidate_product\n\n    # The maximum value in max_prod array is the overall maximum product.\n    return max(max_prod)"}
{"task_id": "Mbpp/471", "solution": "import collections.abc\nfrom typing import Sequence\n\nclass InvalidInputError(Exception):\n    \"\"\"Raised when an input is invalid (e.g., non-integer array elements).\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\nclass ModulusZeroError(Exception):\n    \"\"\"Raised when the modulus 'n' is zero.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\nclass ProductRequest:\n    \"\"\"DTO for encapsulating the input array and modulus.\"\"\"\n    def __init__(self, array: Sequence[int], modulus: int) -> None:\n        self.array = array\n        self.modulus = modulus\n\nclass ProductResult:\n    \"\"\"DTO for encapsulating the computation result.\"\"\"\n    def __init__(self, result: int) -> None:\n        self.result = result\n\nclass ModularArithmetic:\n    \"\"\"Provides efficient and correct modular arithmetic operations.\"\"\"\n    DEFAULT_EMPTY_PRODUCT: int = 1\n\n    @staticmethod\n    def reduce_mod(x: int, n: int) -> int:\n        \"\"\"Computes x % n, normalizing n to be positive for the modulo operation.\"\"\"\n        if n == 0:\n            # This case should ideally be caught by InputValidator, returning 0 for robustness.\n            return 0\n        effective_n = abs(n)\n        return x % effective_n\n\n    @staticmethod\n    def multiply_mod(a: int, b: int, n: int) -> int:\n        \"\"\"Computes (a * b) % n, reducing operands first to minimize intermediate size.\"\"\"\n        if n == 0:\n            # This case should ideally be caught by InputValidator, returning 0 for robustness.\n            return 0\n\n        effective_n = abs(n)\n        # Reduce operands first to keep numbers small.\n        a_red = ModularArithmetic.reduce_mod(a, effective_n)\n        b_red = ModularArithmetic.reduce_mod(b, effective_n)\n        return (a_red * b_red) % effective_n\n\nclass InputValidator:\n    \"\"\"Validates ProductRequest contents, raising specific errors for invalid inputs.\"\"\"\n    def validate_request(self, request: ProductRequest) -> None:\n        \"\"\"Validates the entire ProductRequest object.\"\"\"\n        self._validate_modulus(request.modulus)\n        self._validate_array(request.array)\n\n    def _validate_array(self, array: Sequence[int]) -> None:\n        \"\"\"Validates that the array is an iterable of integers.\"\"\"\n        if not isinstance(array, collections.abc.Sequence):\n            raise InvalidInputError(\"Input 'array' must be a sequence (e.g., list or tuple).\")\n        for i, item in enumerate(array):\n            if not isinstance(item, int):\n                raise InvalidInputError(f\"Array element at index {i} must be an integer, got {type(item).__name__}.\")\n\n    def _validate_modulus(self, n: int) -> None:\n        \"\"\"Validates that the modulus 'n' is an integer and not zero.\"\"\"\n        if not isinstance(n, int):\n            raise InvalidInputError(\"Modulus 'n' must be an integer.\")\n        if n == 0:\n            raise ModulusZeroError(\"Modulus 'n' cannot be zero.\")\n\nclass ProductCalculator:\n    \"\"\"Computes the product of array elements modulo n after validation.\"\"\"\n    def __init__(self, validator: InputValidator = None) -> None:\n        # Use a default validator if none is provided.\n        self._validator = validator if validator is not None else InputValidator()\n\n    def calculate(self, request: ProductRequest) -> ProductResult:\n        \"\"\"Performs validation and computes the product modulo n.\"\"\"\n        self._validator.validate_request(request)\n\n        n = request.modulus\n        # The design states 'empty array: product defined as 1 modulo n'.\n        # Ensure the initial accumulator is correct based on n.\n        effective_n_for_mod = abs(n) if n != 0 else 1 # Used for the initial % operation, avoids ZeroDivisionError\n\n        acc = ModularArithmetic.DEFAULT_EMPTY_PRODUCT % effective_n_for_mod\n\n        for item in request.array:\n            acc = ModularArithmetic.multiply_mod(acc, item, n)\n\n        return ProductResult(acc)\n\ndef find_remainder(array: Sequence[int], n: int) -> int:\n    \"\"\"\n    Finds the product of the array elements modulo n.\n    Raises InvalidInputError or ModulusZeroError for invalid inputs.\n    \"\"\"\n    req = ProductRequest(array=array, modulus=n)\n    calc = ProductCalculator()\n    result = calc.calculate(req)\n    return result.result"}
{"task_id": "Mbpp/462", "solution": "def combinations_list(lst):\n    \"\"\"\n    Finds all possible combinations (power set) of the elements in a list.\n    The combinations are ordered deterministically by binary-count of elements,\n    with elements within each combination ordered by descending index from the original list.\n    \"\"\"\n    n = len(lst)\n    total_combinations = 1 << n\n\n    all_combinations = []\n\n    for mask in range(total_combinations):\n        current_combination = []\n        # Build combination by iterating elements from highest index to lowest\n        for i in range(n - 1, -1, -1):\n            if (mask >> i) & 1:  # Check if the i-th bit is set\n                current_combination.append(lst[i])\n        all_combinations.append(current_combination)\n\n    return all_combinations"}
{"task_id": "Mbpp/465", "solution": "from typing import Any, Dict, List, Tuple, Mapping, Iterable\n\n\ndef drop_empty(input_dict: dict, *, deep: bool = False, drop_values: tuple = (None,), inplace: bool = False) -> dict:\n    \"\"\"\n    Removes items with specified \"empty\" values from a dictionary.\n    Supports shallow or deep removal and configurable empty values.\n    \"\"\"\n\n    class DropEmptyRequest:\n        def __init__(self, input_dict: Dict[str, Any], deep: bool = False, drop_values: Tuple[Any, ...] = (None,), inplace: bool = False) -> None:\n            self.input_dict = input_dict\n            self.deep = deep\n            self.drop_values = drop_values\n            self.inplace = inplace\n\n    class DropEmptyResult:\n        def __init__(self, cleaned: Dict[str, Any], removed_keys: List[str]) -> None:\n            self.cleaned = cleaned\n            self.removed_keys = removed_keys\n\n    class Validator:\n        def validate_input(self, input_dict: Mapping[str, Any]) -> None:\n            pass  # Validation checks are omitted as per constraint.\n\n        def normalize_drop_values(self, drop_values: Iterable[Any]) -> Tuple[Any, ...]:\n            return tuple(drop_values)\n\n    class Utils:\n        DEFAULT_DROP_VALUES = (None,)\n\n        @staticmethod\n        def is_empty(value: Any, drop_values: Tuple[Any, ...]) -> bool:\n            if value in drop_values:\n                return True\n            # Consider empty containers as empty if () is in drop_values.\n            if isinstance(value, (list, tuple, dict, set)) and len(value) == 0 and () in drop_values:\n                return True\n            return False\n\n        @staticmethod\n        def drop_empty_shallow(input_dict: Dict[str, Any], drop_values: Tuple[Any, ...], inplace: bool = False) -> Dict[str, Any]:\n            target_dict = input_dict if inplace else input_dict.copy()\n            keys_to_remove = [key for key, value in target_dict.items() if Utils.is_empty(value, drop_values)]\n            for key in keys_to_remove:\n                del target_dict[key]\n            return target_dict\n\n        @staticmethod\n        def drop_empty_deep(input_obj: Any, drop_values: Tuple[Any, ...], inplace: bool = False) -> Any:\n            if isinstance(input_obj, dict):\n                current_dict = input_obj if inplace else input_obj.copy()\n                keys_to_remove = []\n                for key, value in list(current_dict.items()):\n                    if Utils.is_empty(value, drop_values):\n                        keys_to_remove.append(key)\n                    else:\n                        cleaned_value = Utils.drop_empty_deep(value, drop_values, inplace=inplace)\n                        current_dict[key] = cleaned_value\n                for key in keys_to_remove:\n                    del current_dict[key]\n                return current_dict\n            elif isinstance(input_obj, list):\n                if inplace:\n                    i = 0\n                    while i < len(input_obj):\n                        item = input_obj[i]\n                        if Utils.is_empty(item, drop_values):\n                            input_obj.pop(i)\n                        else:\n                            input_obj[i] = Utils.drop_empty_deep(item, drop_values, inplace=True)\n                            i += 1\n                    return input_obj\n                else:\n                    cleaned_list = []\n                    for item in input_obj:\n                        if not Utils.is_empty(item, drop_values):\n                            cleaned_item = Utils.drop_empty_deep(item, drop_values, inplace=False)\n                            cleaned_list.append(cleaned_item)\n                    return cleaned_list\n            elif isinstance(input_obj, tuple):\n                # Tuples are immutable, always creates a new one.\n                cleaned_tuple_items = []\n                for item in input_obj:\n                    if not Utils.is_empty(item, drop_values):\n                        cleaned_item = Utils.drop_empty_deep(item, drop_values, inplace=False)\n                        cleaned_tuple_items.append(cleaned_item)\n                return tuple(cleaned_tuple_items)\n            else:\n                return input_obj\n\n    class DropEmptyService:\n        def __init__(self, validator: 'Validator', repository: Any = None) -> None:\n            self._validator = validator\n            self._repository = repository\n\n        def drop(self, request: 'DropEmptyRequest') -> 'DropEmptyResult':\n            self._validator.validate_input(request.input_dict)\n            drop_values = self._validator.normalize_drop_values(request.drop_values)\n\n            if request.deep:\n                cleaned = Utils.drop_empty_deep(request.input_dict, drop_values, inplace=request.inplace)\n            else:\n                cleaned = Utils.drop_empty_shallow(request.input_dict, drop_values, inplace=request.inplace)\n\n            removed_keys = []  # The top-level function only returns the cleaned dictionary.\n            return DropEmptyResult(cleaned=cleaned, removed_keys=removed_keys)\n\n    validator = Validator()\n    service = DropEmptyService(validator)\n    req = DropEmptyRequest(input_dict=input_dict, deep=deep, drop_values=drop_values, inplace=inplace)\n    return service.drop(req).cleaned"}
