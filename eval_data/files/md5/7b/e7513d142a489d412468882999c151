{"task_id": "Mbpp/276", "solution": "import math\nfrom numbers import Real\n\ndef volume_cylinder(radius: Real, height: Real) -> float:\n    \"\"\"\n    Compute the volume of a cylinder.\n\n    Parameters:\n        radius (Real): radius of the base\n        height (Real): height of the cylinder\n\n    Returns:\n        float: the volume (pi * radius**2 * height)\n    \"\"\"\n    # Basic validation\n    if not (isinstance(radius, Real) and not isinstance(radius, bool)):\n        raise TypeError(\"radius must be a numeric type (int or float)\")\n    if not (isinstance(height, Real) and not isinstance(height, bool)):\n        raise TypeError(\"height must be a numeric type (int or float)\")\n    if radius < 0:\n        raise ValueError(\"radius must be non-negative\")\n    if height < 0:\n        raise ValueError(\"height must be non-negative\")\n\n    area = math.pi * float(radius) ** 2\n    volume = area * float(height)\n    return float(volume)"}
{"task_id": "Mbpp/274", "solution": "def even_binomial_Coeff_Sum(n: int) -> int:\n    \"\"\"Return the sum of binomial coefficients C(n, k) for even k.\n\n    For positive integer n, sum_{k even} C(n, k) = 2^(n-1).\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n    if n <= 0:\n        raise ValueError(\"n must be a positive integer\")\n    return 1 << (n - 1)"}
