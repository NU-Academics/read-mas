{"task_id": "Mbpp/801", "solution": "def test_three_equal(a, b, c):\n    \"\"\"\n    Return how many of the three given values are equal.\n    Possible returns:\n      - 3 if all three are equal\n      - 2 if exactly two are equal\n      - 0 if none are equal\n    \"\"\"\n    if a == b == c:\n        return 3\n    if a == b or a == c or b == c:\n        return 2\n    return 0"}
{"task_id": "Mbpp/799", "solution": "def left_rotate(value: int, d: int) -> int:\n    \"\"\"\n    Rotate a 32-bit integer 'value' left by 'd' bits and return the result\n    as a 32-bit masked integer.\n\n    Examples:\n        assert left_rotate(16, 2) == 64\n    \"\"\"\n    if not isinstance(value, int):\n        raise TypeError(\"value must be an integer\")\n    if not isinstance(d, int):\n        raise TypeError(\"d (shift distance) must be an integer\")\n    if d < 0:\n        raise ValueError(\"d (shift distance) must be non-negative\")\n\n    MASK_32 = 0xFFFFFFFF\n    BIT_WIDTH = 32\n\n    v = value & MASK_32\n    d = d % BIT_WIDTH\n    if d == 0:\n        return v\n    return ((v << d) | (v >> (BIT_WIDTH - d))) & MASK_32"}
{"task_id": "Mbpp/804", "solution": "def is_product_even(numbers):\n    \"\"\"\n    Checks if the product of numbers in a list is even.\n    An empty list's product is considered 1 (odd).\n    \"\"\"\n    if not numbers:\n        return False  # Product of an empty list is 1, which is odd.\n\n    for num in numbers:\n        if num % 2 == 0:\n            return True  # If any number is even, the product is even.\n    return False"}
{"task_id": "Mbpp/805", "solution": "def max_sum_list(lists):\n    \"\"\"\n    Returns the sublist from a list of lists whose sum of elements is the highest.\n    In case of a tie, the first encountered sublist with the highest sum is returned.\n    \"\"\"\n    highest_sum = float('-inf')\n    max_list_found = []\n\n    for sublist in lists:\n        current_sum = sum(sublist)\n        if current_sum > highest_sum:\n            highest_sum = current_sum\n            max_list_found = sublist\n\n    return max_list_found"}
{"task_id": "Mbpp/809", "solution": "def check_smaller(first: tuple, second: tuple) -> bool:\n    \"\"\"\n    Determines if each element in the second tuple is strictly smaller than the corresponding element in the first tuple.\n    Assumes inputs are tuples of equal length containing comparable elements.\n    \"\"\"\n    for i in range(len(first)):\n        if not (second[i] < first[i]):\n            return False\n    return True"}
{"task_id": "Mbpp/806", "solution": "def max_run_uppercase(s: str) -> int:\n    \"\"\"\n    Computes the maximum consecutive run of uppercase characters in the given string.\n    Returns 0 for an empty string or if no uppercase characters are found.\n    \"\"\"\n    max_run = 0\n    current_run = 0\n    for char in s:\n        if char.isupper():\n            current_run += 1\n            if current_run > max_run:\n                max_run = current_run\n        else:\n            current_run = 0\n    return max_run"}
