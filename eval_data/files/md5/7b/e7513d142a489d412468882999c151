{"task_id": "Mbpp/567", "solution": "from typing import Sequence, Any\n\ndef issort_list(seq: Sequence[Any], strict: bool = False) -> bool:\n    \"\"\"\n    Checks if a sequence is sorted.\n    By default, it checks for non-decreasing order. If 'strict' is True, it checks for strictly increasing order.\n    \"\"\"\n    it = iter(seq)\n    try:\n        prev = next(it)\n    except StopIteration:\n        return True\n\n    if strict:\n        for cur in it:\n            if prev >= cur:\n                return False\n            prev = cur\n    else:\n        for cur in it:\n            if prev > cur:\n                return False\n            prev = cur\n    return True"}
{"task_id": "Mbpp/573", "solution": "def unique_product(numbers):\n    \"\"\"\n    Calculates the product of the unique numbers in a given list.\n    An empty list of numbers will result in a product of 1.\n    \"\"\"\n    if not numbers:\n        return 1\n\n    unique_nums = set(numbers)\n    product = 1\n    for num in unique_nums:\n        product *= num\n    return product"}
{"task_id": "Mbpp/580", "solution": "def extract_even(nested_tuple):\n    \"\"\"\n    Recursively extracts even integers from a nested mixed tuple.\n    Non-even integers are removed, and empty resulting sub-tuples are also excluded.\n    \"\"\"\n    result = []\n    for item in nested_tuple:\n        if isinstance(item, int):\n            if item % 2 == 0:\n                result.append(item)\n        elif isinstance(item, tuple):\n            sub_tuple_result = extract_even(item)\n            if sub_tuple_result:\n                result.append(sub_tuple_result)\n    return tuple(result)"}
{"task_id": "Mbpp/576", "solution": "def is_Sub_Array(haystack: list, needle: list) -> bool:\n    \"\"\"\n    Checks if needle is a contiguous sublist of haystack using a KMP-like algorithm.\n    Returns True if found, False otherwise.\n    \"\"\"\n    def compute_lps(pattern: list) -> list:\n        m = len(pattern)\n        lps = [0] * m\n        length = 0  # length of the previous longest prefix suffix\n        i = 1\n        while i < m:\n            if pattern[i] == pattern[length]:\n                length += 1\n                lps[i] = length\n                i += 1\n            else:\n                if length != 0:\n                    length = lps[length - 1]\n                else:\n                    lps[i] = 0\n                    i += 1\n        return lps\n\n    if not needle:\n        return True\n    if len(needle) > len(haystack):\n        return False\n\n    lps = compute_lps(needle)\n\n    i = 0  # index for haystack\n    j = 0  # index for needle\n\n    while i < len(haystack):\n        if haystack[i] == needle[j]:\n            i += 1\n            j += 1\n            if j == len(needle):\n                return True\n        else:\n            if j != 0:\n                j = lps[j - 1]\n            else:\n                i += 1\n    return False"}
{"task_id": "Mbpp/577", "solution": "def last_Digit_Factorial(n: int) -> int:\n    \"\"\"\n    Finds the last digit of the factorial of a given number n.\n    For n >= 5, the last digit of n! is 0.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n    if n < 0:\n        raise ValueError(\"n must be non-negative\")\n\n    if n >= 5:\n        return 0\n\n    result = 1\n    for i in range(2, n + 1):\n        result = (result * i) % 10\n\n    return result"}
{"task_id": "Mbpp/578", "solution": "def interleave_lists(list1: list, list2: list, list3: list) -> list:\n    n = len(list1)\n    result = [None] * (3 * n)\n    for i in range(n):\n        result[3 * i] = list1[i]\n        result[3 * i + 1] = list2[i]\n        result[3 * i + 2] = list3[i]\n    return result"}
{"task_id": "Mbpp/581", "solution": "def surface_Area(base_edge, height):\n    \"\"\"Calculates the surface area of a square pyramid given its base edge and slant height.\n    The 'height' parameter is interpreted as the slant height.\"\"\"\n    base_area = base_edge * base_edge\n    lateral_surface_area = 2 * base_edge * height\n    total_surface_area = base_area + lateral_surface_area\n    return total_surface_area"}
{"task_id": "Mbpp/579", "solution": "def find_dissimilar(a, b):\n    \"\"\"\n    Finds elements that are present in exactly one of the two input tuples.\n    Duplicates within each input tuple are handled by considering only their first occurrence.\n    \"\"\"\n    # Normalize input 'a': remove duplicates while preserving first-occurrence order.\n    seen_a = set()\n    a_normalized = []\n    for item in a:\n        if item not in seen_a:\n            seen_a.add(item)\n            a_normalized.append(item)\n\n    # Normalize input 'b': remove duplicates while preserving first-occurrence order.\n    seen_b = set()\n    b_normalized = []\n    for item in b:\n        if item not in seen_b:\n            seen_b.add(item)\n            b_normalized.append(item)\n\n    # Convert normalized lists to sets for efficient lookup.\n    set_a_unique = set(a_normalized)\n    set_b_unique = set(b_normalized)\n\n    # Find elements in a_normalized that are not in set_b.\n    res_a_only = [x for x in a_normalized if x not in set_b_unique]\n\n    # Find elements in b_normalized that are not in set_a.\n    res_b_only = [x for x in b_normalized if x not in set_a_unique]\n\n    # Combine results and return as a tuple, maintaining the specified order.\n    return tuple(res_a_only + res_b_only)"}
{"task_id": "Mbpp/583", "solution": "from math import comb, factorial\n\n# Module-level cache for factorial values, used by the factorial fallback path\n# when `use_cache` is True. This serves as an inline replacement for FactorialCache\n# as described in the design context.\n_catalan_factorial_memo = {0: 1, 1: 1}\n\ndef _get_factorial_cached_helper(n_val: int) -> int:\n    \"\"\"Computes and caches factorials up to n_val in _catalan_factorial_memo.\"\"\"\n    # `math.factorial` would raise a ValueError for negative input,\n    # and we rely on standard library error handling as per constraints.\n    if n_val in _catalan_factorial_memo:\n        return _catalan_factorial_memo[n_val]\n\n    # Compute factorials from the largest cached value up to n_val.\n    current_max_cached = max(_catalan_factorial_memo.keys())\n    for i in range(current_max_cached + 1, n_val + 1):\n        _catalan_factorial_memo[i] = _catalan_factorial_memo[i - 1] * i\n    return _catalan_factorial_memo[n_val]\n\ndef catalan_number(n: int, use_cache: bool = True) -> int:\n    \"\"\"\n    Computes the nth Catalan number.\n    It prefers `math.comb` for efficiency and falls back to a factorial-based computation,\n    optionally using an inline cache.\n    \"\"\"\n    # Adhering to the constraint \"Do NOT add isinstance() checks or raise exceptions for edge cases\":\n    # Custom validation for `n` (e.g., negative, non-integer) is omitted.\n    # `math.comb` and `math.factorial` will raise standard `ValueError` for invalid `n`.\n\n    try:\n        # Preferred method as per design: using math.comb (C_n = comb(2n, n) // (n + 1)).\n        # This path is generally faster and does not directly utilize the factorial cache.\n        return comb(2 * n, n) // (n + 1)\n    except (TypeError, ValueError):\n        # Fallback to factorial-based computation: C_n = (2n)! / (n! * n! * (n + 1)).\n        # This path is typically taken if `math.comb` raises an exception for invalid inputs\n        # (e.g., negative n) or extremely large values which might exceed internal limits.\n        if use_cache:\n            fact_2n = _get_factorial_cached_helper(2 * n)\n            fact_n = _get_factorial_cached_helper(n)\n        else:\n            # If caching is disabled, use `math.factorial` directly.\n            fact_2n = factorial(2 * n)\n            fact_n = factorial(n)\n\n        return fact_2n // (fact_n * fact_n * (n + 1))"}
{"task_id": "Mbpp/585", "solution": "import heapq\n\ndef expensive_items(items, n):\n    \"\"\"\n    Finds the n most expensive items from a list of dictionaries based on their 'price' key.\n    The items are returned in descending order of price.\n    \"\"\"\n    return heapq.nlargest(n, items, key=lambda item: item['price'])"}
{"task_id": "Mbpp/587", "solution": "class ValidationError(Exception):\n    \"\"\"Exception raised for invalid input values.\"\"\"\n    def __init__(self, message: str) -> None:\n        self.message = message\n        super().__init__(message)\n\nclass ListConversionError(Exception):\n    \"\"\"Exception raised for unexpected failures during conversion.\"\"\"\n    def __init__(self, message: str) -> None:\n        self.message = message\n        super().__init__(message)\n\nfrom typing import Any, Sequence, Tuple\n\ndef list_tuple(lst: Sequence[Any]) -> Tuple[Any, ...]:\n    \"\"\"Converts a list-like sequence to a tuple, performing input validation and handling conversion errors.\"\"\"\n\n    value_to_convert: Sequence[Any]\n\n    # Validate the input as a list-like sequence, excluding strings and bytes.\n    if isinstance(lst, (list, tuple)):\n        value_to_convert = lst\n    else:\n        try:\n            iter(lst)\n            if isinstance(lst, (str, bytes)):\n                raise ValidationError(\"Strings and bytes are not accepted as list-like inputs.\")\n            value_to_convert = list(lst)\n        except TypeError:\n            raise ValidationError(f\"Value of type {type(lst).__name__} is not an iterable.\")\n\n    # Convert the validated sequence to a tuple.\n    try:\n        return tuple(value_to_convert)\n    except Exception as exc:\n        raise ListConversionError(f\"Failed to convert to tuple: {exc}\") from exc"}
{"task_id": "Mbpp/586", "solution": "def split_Arr(items, n):\n    \"\"\"\n    Splits a list at the nth element and appends the first part to the end.\n    This effectively rotates the list by n positions.\n    \"\"\"\n    return items[n:] + items[:n]"}
{"task_id": "Mbpp/589", "solution": "def perfect_squares(start: int, end: int) -> list[int]:\n    \"\"\"Finds all perfect squares between two given integers (inclusive).\"\"\"\n\n    def _to_int(value):\n        \"\"\"Converts a value to an integer, raising ValueError if not possible.\"\"\"\n        try:\n            return int(value)\n        except (ValueError, TypeError):\n            raise ValueError(f\"Invalid input: '{value}' cannot be converted to integer.\")\n\n    s = _to_int(start)\n    e = _to_int(end)\n\n    if s > e:\n        raise ValueError(\"Start value cannot be greater than end value.\")\n\n    def _integer_sqrt_floor(n: int) -> int:\n        \"\"\"Returns the floor of the square root of a non-negative integer.\"\"\"\n        if n < 0:\n            raise ValueError(\"n must be >= 0 for integer_sqrt_floor.\")\n        lo, hi = 0, n\n        while lo <= hi:\n            mid = (lo + hi) // 2\n            if mid * mid <= n:\n                lo = mid + 1\n            else:\n                hi = mid - 1\n        return hi\n\n    def _integer_sqrt_ceil(n: int) -> int:\n        \"\"\"Returns the ceiling of the square root of a non-negative integer.\"\"\"\n        f = _integer_sqrt_floor(n)\n        return f if f * f == n else f + 1\n\n    kmin = _integer_sqrt_ceil(max(0, s))\n    kmax = _integer_sqrt_floor(e) if e >= 0 else -1\n\n    squares = []\n    for k in range(kmin, kmax + 1):\n        squares.append(k * k)\n    return squares"}
{"task_id": "Mbpp/588", "solution": "def big_diff(nums):\n    \"\"\"\n    Return the difference between the largest and smallest value in a given list.\n\n    Raises:\n        TypeError: if nums is not a list/tuple or contains non-numeric elements.\n        ValueError: if nums is empty.\n    \"\"\"\n    if not isinstance(nums, (list, tuple)):\n        raise TypeError(\"Input must be a list or tuple.\")\n    if len(nums) == 0:\n        raise ValueError(\"Input list must not be empty.\")\n    for i, x in enumerate(nums):\n        if not isinstance(x, (int, float)):\n            raise TypeError(f\"Element at index {i} is not a number: {x!r}\")\n    return max(nums) - min(nums)"}
{"task_id": "Mbpp/591", "solution": "from typing import List, Any\n\ndef swap_List(lst: List[Any]) -> List[Any]:\n    \"\"\"\n    Interchanges the first and last elements in a list.\n    Returns a new list with the elements swapped, or a shallow copy if the list has fewer than 2 elements.\n    \"\"\"\n    if not isinstance(lst, list):\n        raise TypeError(\"Input must be a list.\")\n    if len(lst) < 2:\n        return lst.copy()\n\n    new_list = lst.copy()\n    new_list[0], new_list[-1] = new_list[-1], new_list[0]\n    return new_list"}
