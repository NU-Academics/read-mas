{"task_id": "Mbpp/731", "solution": "import math\nfrom typing import Optional\n\nclass GeometryError(Exception):\n    \"\"\"Exception for geometry-related errors, typically invalid inputs.\"\"\"\n    def __init__(self, message: str) -> None:\n        self.message = message\n        super().__init__(self.message)\n\nclass Validator:\n    \"\"\"Utility for validating numeric and non-negative values.\"\"\"\n    @staticmethod\n    def validate_numeric_nonnegative(value: object, name: str) -> float:\n        try:\n            v = float(value)\n        except (TypeError, ValueError):\n            raise GeometryError(f\"{name} must be numeric\")\n        if v < 0:\n            raise GeometryError(f\"{name} must be non-negative\")\n        return v\n\nclass Cone:\n    \"\"\"Represents a right circular cone with radius, height, and slant height.\"\"\"\n    def __init__(self, r: float, h: float) -> None:\n        self._r: float = r\n        self._h: float = h\n        self._s: Optional[float] = None\n\n    def compute_slant_height(self) -> float:\n        \"\"\"Computes and caches the slant height of the cone.\"\"\"\n        if self._s is None:\n            self._s = math.sqrt(self._r ** 2 + self._h ** 2)\n        return self._s\n\n    def as_tuple(self) -> tuple[float, float, float]:\n        \"\"\"Returns the cone's dimensions as a tuple (radius, height, slant_height).\"\"\"\n        s = self.compute_slant_height()\n        return (self._r, self._h, s)\n\nclass ConeFactory:\n    \"\"\"Factory for creating validated Cone instances.\"\"\"\n    def __init__(self, validator: Validator = None) -> None:\n        self._validator: Validator = validator if validator is not None else Validator()\n\n    def create(self, r: object, h: object) -> Cone:\n        \"\"\"Validates inputs and creates a new Cone object.\"\"\"\n        valid_r = self._validator.validate_numeric_nonnegative(r, \"r\")\n        valid_h = self._validator.validate_numeric_nonnegative(h, \"h\")\n        return Cone(valid_r, valid_h)\n\nclass GeometryService:\n    \"\"\"Provides methods for geometric computations.\"\"\"\n    @staticmethod\n    def lateral_surface_area(cone: Cone) -> float:\n        \"\"\"Calculates the lateral surface area of a cone.\"\"\"\n        s = cone.compute_slant_height()\n        return math.pi * cone._r * s\n\ndef lateralsurface_cone(r: float, h: float) -> float:\n    \"\"\"\n    Calculates the lateral surface area of a cone given radius r and height h.\n    The formula used is L = pi * r * sqrt(r^2 + h^2).\n    \"\"\"\n    validator = Validator()\n    factory = ConeFactory(validator=validator)\n    cone = factory.create(r, h)\n    service = GeometryService()\n    return service.lateral_surface_area(cone)"}
{"task_id": "Mbpp/734", "solution": "def sum_Of_Subarray_Prod(arr):\n    \"\"\"\n    Finds the sum of products of all possible contiguous sublists (subarrays) of a given list.\n    Uses an O(n) dynamic programming approach.\n    \"\"\"\n    if not arr:\n        return 0\n\n    dp_prev = 0\n    total_sum_of_products = 0\n\n    for x in arr:\n        # dp_curr represents the sum of products of all subarrays ending at x\n        # This includes x itself (product x * 1)\n        # and x multiplied by the sum of products of all subarrays ending at the previous element (dp_prev * x)\n        dp_curr = x * (1 + dp_prev)\n        total_sum_of_products += dp_curr\n        dp_prev = dp_curr\n\n    return total_sum_of_products"}
{"task_id": "Mbpp/735", "solution": "def toggle_middle_bits(n: int) -> int:\n    \"\"\"Toggles all bits of the number except the most significant and least significant bits.\"\"\"\n    bitlen = n.bit_length()\n\n    if bitlen <= 2:\n        return n\n\n    # Create a mask with ones for bit positions 1 up to (bitlen-2).\n    # ((1 << (bitlen - 1)) - 1) generates 'bitlen-1' trailing ones from bit 0.\n    # & ~1 clears the 0th bit, leaving ones from bit 1 to bitlen-2.\n    mask = ((1 << (bitlen - 1)) - 1) & ~1\n\n    return n ^ mask"}
{"task_id": "Mbpp/733", "solution": "from typing import List, Any, Sequence, Callable\n\ndef find_first_occurrence(arr: List[int], target: int) -> int:\n    \"\"\"Finds the index of the first occurrence of a target in a sorted array.\"\"\"\n\n    class InvalidInputError(ValueError):\n        \"\"\"Exception raised for invalid input parameters.\"\"\"\n        pass\n\n    class LibraryError(Exception):\n        \"\"\"Generic exception for unexpected internal library errors.\"\"\"\n        pass\n\n    class ValidationUtils:\n        \"\"\"Utility class for input validation and type conversion.\"\"\"\n        @staticmethod\n        def validate_array(arr_input: Any) -> List[int]:\n            \"\"\"Validates and converts input array-like or string to List[int].\"\"\"\n            if isinstance(arr_input, str):\n                try:\n                    parts = [p.strip() for p in arr_input.split(\",\") if p.strip() != \"\"]\n                    return [int(p) for p in parts]\n                except Exception:\n                    raise InvalidInputError(\"Array string must be comma separated integers\")\n            if hasattr(arr_input, \"__iter__\"):\n                try:\n                    converted_list = []\n                    for x in arr_input:\n                        converted_list.append(int(x))\n                    return converted_list\n                except Exception:\n                    raise InvalidInputError(\"Array elements must be integers\")\n            raise InvalidInputError(\"Array must be a sequence or comma-separated string\")\n\n        @staticmethod\n        def validate_target(target_input: Any) -> int:\n            \"\"\"Validates and converts target to an integer.\"\"\"\n            try:\n                return int(target_input)\n            except Exception:\n                raise InvalidInputError(\"Target must be an integer\")\n\n    class ArrayRepository:\n        \"\"\"Provides an interface to access array elements by index.\"\"\"\n        def __init__(self, array: Sequence[int]) -> None:\n            self._array = array\n\n        def get(self, index: int) -> int:\n            \"\"\"Returns the element at the given index.\"\"\"\n            return self._array[index]\n\n        def length(self) -> int:\n            \"\"\"Returns the length of the array.\"\"\"\n            return len(self._array)\n\n    class SearchService:\n        \"\"\"Implements the core binary search algorithm.\"\"\"\n        def __init__(self, repository_factory: Callable[[Sequence[int]], 'ArrayRepository']) -> None:\n            self._repo_factory = repository_factory\n\n        def find_first(self, array: Sequence[int], target_val: int) -> int:\n            \"\"\"Performs a binary search to find the first occurrence of target_val.\"\"\"\n            repo = self._repo_factory(array)\n            n = repo.length()\n            l, r = 0, n - 1\n            result = -1\n            try:\n                while l <= r:\n                    mid = (l + r) // 2\n                    val = repo.get(mid)\n                    if val == target_val:\n                        result = mid\n                        r = mid - 1\n                    elif val < target_val:\n                        l = mid + 1\n                    else:\n                        r = mid - 1\n                return result\n            except Exception as e:\n                raise LibraryError(f\"Internal error during search: {e}\") from e\n\n    class ArraySearchRequest:\n        \"\"\"Data transfer object for search requests.\"\"\"\n        def __init__(self, array: List[int], target: int) -> None:\n            self.array = array\n            self.target = target\n\n    class ArraySearchResult:\n        \"\"\"Data transfer object for search results.\"\"\"\n        def __init__(self, index: int) -> None:\n            self.index = index\n\n    class SearchController:\n        \"\"\"Orchestrates search requests and results.\"\"\"\n        def __init__(self, service: 'SearchService') -> None:\n            self._service = service\n\n        def handle(self, request: 'ArraySearchRequest') -> 'ArraySearchResult':\n            \"\"\"Handles a search request by delegating to the search service.\"\"\"\n            idx = self._service.find_first(request.array, request.target)\n            return ArraySearchResult(index=idx)\n\n    _default_service = SearchService(repository_factory=lambda arr_repo_param: ArrayRepository(arr_repo_param))\n    _default_controller = SearchController(_default_service)\n\n    validated_arr = ValidationUtils.validate_array(arr)\n    validated_target = ValidationUtils.validate_target(target)\n\n    request_dto = ArraySearchRequest(validated_arr, validated_target)\n    return _default_controller.handle(request_dto).index"}
