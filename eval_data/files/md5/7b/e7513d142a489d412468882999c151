{"task_id": "Mbpp/3", "solution": "def is_not_prime(n: int) -> bool:\n    \"\"\"Checks if a number is non-prime. Returns True if non-prime, False if prime.\"\"\"\n    if n < 2:\n        return True\n    if n == 2:\n        return False\n    if n % 2 == 0:\n        return True\n\n    # Check for odd divisors from 3 up to the square root of n\n    limit = int(n**0.5)\n    for i in range(3, limit + 1, 2):\n        if n % i == 0:\n            return True\n\n    return False"}
{"task_id": "Mbpp/4", "solution": "import heapq\nfrom typing import List, Sequence\n\ndef heap_queue_largest(items: Sequence[int], n: int) -> List[int]:\n    \"\"\"\n    Finds the n largest integers from a list and returns them in descending order using a min-heap.\n    Handles edge cases for n being zero or larger than the list length.\n    \"\"\"\n    if n <= 0:\n        return []\n\n    # Convert items to a list to ensure consistent behavior with slicing and mutability for heapq.\n    items_list = list(items)\n\n    if n >= len(items_list):\n        return sorted(items_list, reverse=True)\n\n    # Initialize a min-heap with the first 'n' elements.\n    # For each of the first 'n' items, push it onto the heap. This makes the heap of size 'n'.\n    heap = []\n    for x in items_list[:n]:\n        heapq.heappush(heap, x)\n\n    # For the remaining elements, compare with the smallest element in the heap (root).\n    # If a new element is larger than the root, replace the root with the new element,\n    # effectively keeping the 'n' largest elements seen so far in the heap.\n    for x in items_list[n:]:\n        # heap[0] is the smallest element in the min-heap.\n        if x > heap[0]:\n            heapq.heapreplace(heap, x) # Removes heap[0], adds x, and maintains the heap property.\n\n    # The heap now contains the n largest elements.\n    # Sort them in descending order for the final result.\n    return sorted(heap, reverse=True)"}
{"task_id": "Mbpp/7", "solution": "import re\n\ndef find_char_long(s: str) -> list[str]:\n    \"\"\"\n    Finds all words in a string that are at least 4 characters long.\n    Words are defined as sequences of alphanumeric characters and underscores (\\w+).\n    \"\"\"\n    word_pattern = r'\\w+'\n    all_words = re.findall(word_pattern, s)\n    long_words = [word for word in all_words if len(word) >= 4]\n    return long_words"}
{"task_id": "Mbpp/6", "solution": "def differ_At_One_Bit_Pos(a, b):\n    \"\"\"\n    Checks if two integers differ at exactly one bit position.\n    This is true if their XOR result is a power of two and not zero.\n    \"\"\"\n    xor_result = a ^ b\n    # A number is a power of two if it's greater than 0 and (n & (n - 1)) is 0.\n    # This also correctly handles the case where a == b (xor_result would be 0),\n    # as 0 is not greater than 0.\n    return xor_result > 0 and (xor_result & (xor_result - 1)) == 0"}
{"task_id": "Mbpp/2", "solution": "def similar_elements(a, b):\n    \"\"\"\n    Return a list of unique elements present in both iterables a and b.\n    Order of elements is preserved from the first iterable (a).\n    Elements must be hashable.\n    \"\"\"\n    b_set = set(b)\n    seen = set()\n    result = []\n    for item in a:\n        if item in b_set and item not in seen:\n            result.append(item)\n            seen.add(item)\n    return result"}
{"task_id": "Mbpp/9", "solution": "def find_Rotations(s: str) -> int:\n    \"\"\"\n    Finds the minimum number of rotations (greater than 0) required to get the same string.\n    This uses the KMP prefix function to find the smallest period of the string.\n    \"\"\"\n    n = len(s)\n    if n == 0:\n        # According to design, this case should raise InvalidInputError,\n        # but prompt preconditions imply s will be non-empty. Return 0 for empty input.\n        return 0\n\n    # Compute the Longest Proper Prefix Suffix (LPS) array for string s (KMP algorithm)\n    lps = [0] * n\n    length = 0  # Length of the previous longest prefix suffix\n    i = 1       # Index for traversing the string\n\n    while i < n:\n        if s[i] == s[length]:\n            length += 1\n            lps[i] = length\n            i += 1\n        else:\n            if length != 0:\n                length = lps[length - 1]\n            else:\n                lps[i] = 0\n                i += 1\n\n    # The length of the repeating pattern (periodicity) is n - lps[n-1]\n    potential_period = n - lps[n - 1]\n\n    if n % potential_period == 0:\n        return potential_period\n    else:\n        return n"}
{"task_id": "Mbpp/11", "solution": "def remove_Occ(s, ch):\n    \"\"\"\n    Removes the first and last occurrence of a given character from the string.\n    If the character appears only once, it removes that single occurrence.\n    \"\"\"\n    if not isinstance(s, str):\n        raise TypeError(\"s must be a string\")\n    if not isinstance(ch, str) or len(ch) != 1:\n        raise ValueError(\"ch must be a single character string\")\n\n    first_idx = s.find(ch)\n    if first_idx == -1:\n        return s\n\n    last_idx = s.rfind(ch)\n\n    if first_idx == last_idx:\n        return s[:first_idx] + s[first_idx+1:]\n    else:\n        return s[:first_idx] + s[first_idx+1:last_idx] + s[last_idx+1:]"}
{"task_id": "Mbpp/14", "solution": "def find_Volume(base, height, length):\n    \"\"\"Calculates the volume of a triangular prism.\n\n    The volume is found by multiplying the area of the triangular base (0.5 * base * height) by its length.\n    \"\"\"\n    triangle_area = 0.5 * base * height\n    volume = triangle_area * length\n    return volume"}
{"task_id": "Mbpp/12", "solution": "def sort_matrix(matrix):\n    \"\"\"\n    Sorts a given matrix in ascending order based on the sum of its rows.\n    Uses a stable sort, preserving original order for rows with identical sums.\n    \"\"\"\n    if not matrix:\n        return []\n\n    # Pair each row with its original index to ensure stable sorting\n    indexed_rows = [(i, row) for i, row in enumerate(matrix)]\n\n    # Sort based on the sum of each row. The original index acts as a tie-breaker for stability.\n    indexed_rows.sort(key=lambda item: (sum(item[1]), item[0]))\n\n    # Extract the sorted rows\n    sorted_matrix = [row for index, row in indexed_rows]\n    return sorted_matrix"}
{"task_id": "Mbpp/16", "solution": "import re\n\ndef text_lowercase_underscore(text: str) -> bool:\n    \"\"\"\n    Checks if the input string contains sequences of lowercase letters\n    joined by at least one underscore.\n    \"\"\"\n    # The regex pattern matches one or more lowercase letters,\n    # followed by one or more sequences of an underscore and one or more lowercase letters.\n    # This ensures at least two groups of lowercase letters separated by at least one underscore.\n    pattern = r'^[a-z]+(?:_[a-z]+)+$'\n\n    # Compile the regex pattern for efficient repeated use.\n    compiled_pattern = re.compile(pattern)\n\n    # Use re.fullmatch to check if the entire string matches the pattern.\n    # bool() converts the match object (or None) to a boolean.\n    return bool(compiled_pattern.fullmatch(text))"}
