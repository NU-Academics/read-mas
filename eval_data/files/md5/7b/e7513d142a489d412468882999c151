{"task_id": "Mbpp/96", "solution": "def divisor(n: int) -> int:\n    \"\"\"Calculates the number of positive divisors for a given integer.\n    It performs prime factorization and then applies the divisor counting formula.\"\"\"\n    if not isinstance(n, int) or n < 1:\n        raise ValueError(\"n must be a positive integer (n >= 1)\")\n\n    if n == 1:\n        return 1\n\n    prime_factors = {}\n    temp_n = n\n\n    # Count factors of 2\n    while temp_n % 2 == 0:\n        prime_factors[2] = prime_factors.get(2, 0) + 1\n        temp_n //= 2\n\n    # Count factors of odd numbers\n    i = 3\n    while i * i <= temp_n:\n        while temp_n % i == 0:\n            prime_factors[i] = prime_factors.get(i, 0) + 1\n            temp_n //= i\n        i += 2\n\n    # If temp_n is still greater than 1, it must be a prime factor itself\n    if temp_n > 1:\n        prime_factors[temp_n] = prime_factors.get(temp_n, 0) + 1\n\n    # Calculate the total number of divisors\n    num_divisors = 1\n    for exponent in prime_factors.values():\n        num_divisors *= (exponent + 1)\n\n    return num_divisors"}
{"task_id": "Mbpp/98", "solution": "def multiply_num(numbers):\n    \"\"\"\n    Multiplies all numbers in a sequence and divides the product by the sequence's length.\n    Assumes the input sequence is not empty.\n    \"\"\"\n    product = 1.0\n    for num in numbers:\n        product *= float(num)\n\n    length = len(numbers)\n    # Division by zero will occur if the sequence is empty, adhering to the prompt's\n    # instruction not to add explicit checks or raise exceptions for edge cases.\n    return product / length"}
{"task_id": "Mbpp/100", "solution": "def next_smallest_palindrome(n: int) -> int:\n    \"\"\"\n    Finds the next smallest palindrome of a specified integer, returned as an integer.\n    The next palindrome must be strictly greater than n.\n    For negative n, the smallest non-negative palindrome (0) is returned.\n    \"\"\"\n\n    def _is_all_nines(s: str) -> bool:\n        \"\"\"Checks if all characters in a string are '9'.\"\"\"\n        return all(ch == '9' for ch in s)\n\n    def _mirror_left_to_right(s: str) -> str:\n        \"\"\"Mirrors the left half of a string to its right half to form a palindrome.\"\"\"\n        length = len(s)\n        mid = length // 2\n        left_half = s[:mid]\n        right_half_reversed = left_half[::-1]\n        if length % 2 == 1:  # Odd length, include middle character\n            middle_char = s[mid]\n            return left_half + middle_char + right_half_reversed\n        else:  # Even length\n            return left_half + right_half_reversed\n\n    def _increment_middle(s: str) -> str:\n        \"\"\"Increments the middle part of a string representation of a number with carry propagation.\"\"\"\n        s_list = list(s)\n        length = len(s)\n        # Start incrementing from the middle-most digit(s) of the left half\n        left_mid_idx = (length - 1) // 2\n\n        carry = 1\n        for i in range(left_mid_idx, -1, -1):\n            digit = int(s_list[i]) + carry\n            s_list[i] = str(digit % 10)\n            carry = digit // 10\n            if carry == 0:\n                break\n\n        return \"\".join(s_list)\n\n    # For any negative integer n, the smallest palindrome strictly greater than n is 0.\n    if n < 0:\n        return 0\n\n    s = str(n)\n    length = len(s)\n\n    # Special case: If n consists of all '9's (e.g., 9, 99, 999)\n    # The next palindrome will be 1 followed by (length-1) zeros, then 1 (e.g., 11, 101, 1001).\n    if _is_all_nines(s):\n        return int('1' + '0' * (length - 1) + '1')\n\n    # General case:\n    # 1. Create a potential palindrome by mirroring the left half of 's' to its right.\n    mirrored_s = _mirror_left_to_right(s)\n\n    # 2. Compare the newly formed palindrome (as an integer) with the original number n.\n    # If the mirrored palindrome is already strictly greater than n, it is the answer.\n    if int(mirrored_s) > n:\n        return int(mirrored_s)\n    else:\n        # 3. If not, the mirrored palindrome is less than or equal to n.\n        # This implies we need to increment the middle part of the number and then mirror again.\n        # This handles cases where n is already a palindrome (e.g., 121 -> increment middle, then mirror)\n        # or where initial mirroring results in a smaller number (e.g., 123 -> 121, need to increment).\n\n        # Increment the left half (including the middle digit for odd length)\n        incremented_s = _increment_middle(s)\n\n        # Mirror the incremented string to get the final palindrome.\n        final_pal_str = _mirror_left_to_right(incremented_s)\n\n        return int(final_pal_str)"}
{"task_id": "Mbpp/99", "solution": "def decimal_to_binary(n: int) -> str:\n    \"\"\"Converts a non-negative decimal integer to its binary string representation.\"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an int\")\n    if n < 0:\n        raise ValueError(\"n must be non-negative\")\n    if n == 0:\n        return \"0\"\n\n    bits = []\n    while n > 0:\n        bits.append(\"1\" if (n & 1) else \"0\")\n        n >>= 1\n\n    bits.reverse()\n    return \"\".join(bits)"}
{"task_id": "Mbpp/101", "solution": "def kth_element(array, k):\n    \"\"\"\n    Finds the kth element in the given array using 1-based indexing.\n    \"\"\"\n    return array[k - 1]"}
{"task_id": "Mbpp/104", "solution": "def sort_sublists(input_data):\n    \"\"\"\n    Sort each sublist of strings in the given sequence of sequences.\n\n    Args:\n        input_data: A sequence (e.g., list or tuple) of sequences of strings.\n\n    Returns:\n        A new list of lists where each inner list is the lexicographically sorted\n        version of the corresponding input sublist.\n\n    Raises:\n        TypeError: If input_data is not a sequence of sequences of strings.\n    \"\"\"\n    if not isinstance(input_data, (list, tuple)):\n        raise TypeError(\"input_data must be a sequence (list or tuple) of sequences of strings\")\n\n    result = []\n    for i, sub in enumerate(input_data):\n        if not isinstance(sub, (list, tuple)):\n            raise TypeError(f\"element at index {i} is not a sequence (list/tuple)\")\n\n        # Validate elements are strings\n        for j, item in enumerate(sub):\n            if not isinstance(item, str):\n                raise TypeError(f\"element at index {i}[{j}] is not a str: {item!r}\")\n\n        # sorted() returns a new list; convert sub to list to avoid mutating input if it's a list subclass\n        result.append(sorted(list(sub)))\n\n    return result"}
{"task_id": "Mbpp/102", "solution": "def snake_to_camel(value: str, lower_first: bool = False) -> str:\n    \"\"\"Converts a snake_case string to CamelCase.\n    Optionally converts the first letter of the result to lowercase for lowerCamelCase.\n    \"\"\"\n    if not isinstance(value, str):\n        raise TypeError(\"value must be a string\")\n\n    tokens = [t for t in value.split('_') if t]\n\n    if not tokens:\n        # No meaningful segments to convert; follow design: raise ValueError\n        raise ValueError(\"no valid segments to convert\")\n\n    segments = []\n    for t in tokens:\n        # Capitalize first character, lowercase the rest\n        first_char = t[0].upper()\n        rest_of_segment = t[1:].lower() if len(t) > 1 else \"\"\n        segments.append(first_char + rest_of_segment)\n\n    if lower_first and segments:\n        segments[0] = segments[0][0].lower() + segments[0][1:]\n\n    return \"\".join(segments)"}
{"task_id": "Mbpp/103", "solution": "def eulerian_num(n: int, m: int) -> int:\n    \"\"\"\n    Compute the Eulerian number a(n, m).\n\n    Eulerian numbers are defined for integers n >= 0 and 0 <= m <= n-1 (with a(0,0)=1).\n    Uses the recurrence:\n        a(n,m) = (n - m) * a(n-1, m-1) + (m + 1) * a(n-1, m)\n\n    Raises:\n        ValueError: if inputs are not integers or outside the valid ranges.\n    \"\"\"\n    # Validate types\n    if not isinstance(n, int) or not isinstance(m, int):\n        raise ValueError(\"n and m must be integers\")\n    # Validate ranges\n    if n < 0:\n        raise ValueError(\"n must be >= 0\")\n    if n == 0:\n        if m == 0:\n            return 1\n        raise ValueError(\"for n=0 only m=0 is valid\")\n    if m < 0 or m > n - 1:\n        raise ValueError(\"m must satisfy 0 <= m <= n-1\")\n\n    # DP base: row 0\n    prev = [1]  # a(0,0) = 1\n\n    # Build rows 1..n\n    for i in range(1, n + 1):\n        cur = [0] * i  # row i has i entries for m=0..i-1\n        for j in range(i):  # j represents m in row i\n            val = 0\n            # term (m+1) * a(n-1, m) -> prev[m] if exists\n            if j < len(prev):\n                val += (j + 1) * prev[j]\n            # term (n-m) * a(n-1, m-1) -> prev[m-1] if m-1 >= 0\n            if j - 1 >= 0:\n                val += (i - j) * prev[j - 1]\n            cur[j] = val\n        prev = cur\n\n    return prev[m]"}
