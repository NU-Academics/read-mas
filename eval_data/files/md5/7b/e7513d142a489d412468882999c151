{"task_id": "Mbpp/90", "solution": "def len_log(words):\n    \"\"\"\n    Return the length of the longest word in the iterable `words`.\n    Returns 0 for an empty iterable.\n\n    Raises:\n        TypeError: if `words` is None, not iterable, is a str (not an iterable of words),\n                   or contains non-str elements.\n    \"\"\"\n    if words is None:\n        raise TypeError(\"words must be an iterable of strings, got None\")\n    if isinstance(words, str):\n        # A plain str is iterable but not a valid sequence-of-words input.\n        raise TypeError(\"words must be an iterable of strings (e.g. list/tuple), not a str\")\n    try:\n        iterator = iter(words)\n    except TypeError:\n        raise TypeError(\"words must be an iterable of strings\")\n\n    max_length = 0\n    for i, w in enumerate(iterator):\n        if not isinstance(w, str):\n            raise TypeError(f\"element at index {i} is not str (found {type(w).__name__})\")\n        lw = len(w)\n        if lw > max_length:\n            max_length = lw\n    return max_length"}
{"task_id": "Mbpp/92", "solution": "def is_undulating(number: int) -> bool:\n    \"\"\"Checks if a number is undulating (alternating digits like ABAB... with A != B).\"\"\"\n    # Use absolute value to handle negative numbers.\n    num_abs = abs(number)\n\n    # Convert the number to a list of its digits.\n    # This handles num_abs == 0 by converting it to [0].\n    digits = [int(d) for d in str(num_abs)]\n\n    # Undulating numbers must have at least 3 digits.\n    MIN_DIGITS = 3\n    if len(digits) < MIN_DIGITS:\n        return False\n\n    # Identify the first two distinct digits (A and B).\n    first_digit = digits[0]\n    second_digit = digits[1]\n\n    # If the first two digits are the same, it cannot be undulating.\n    if first_digit == second_digit:\n        return False\n\n    # Check the alternating pattern: A, B, A, B...\n    for i in range(len(digits)):\n        # Even-indexed digits must match the first digit.\n        if i % 2 == 0:\n            if digits[i] != first_digit:\n                return False\n        # Odd-indexed digits must match the second digit.\n        else:\n            if digits[i] != second_digit:\n                return False\n\n    # If the loop completes, the number is undulating.\n    return True"}
{"task_id": "Mbpp/89", "solution": "def closest_num(n) -> int:\n    \"\"\"\n    Return the closest smaller integer strictly less than n.\n\n    - If n is an integer (e.g., 11 or 11.0), returns n - 1.\n    - If n is a non-integer float, returns floor(n).\n    Raises:\n    - TypeError: if n cannot be interpreted as a number.\n    - ValueError: if n is NaN or infinite.\n    \"\"\"\n    import math\n\n    try:\n        val = float(n)\n    except (TypeError, ValueError):\n        raise TypeError(\"n must be a number\") from None\n\n    if math.isnan(val) or math.isinf(val):\n        raise ValueError(\"n must be a finite number\")\n\n    if val.is_integer():\n        return int(val) - 1\n\n    return math.floor(val)"}
