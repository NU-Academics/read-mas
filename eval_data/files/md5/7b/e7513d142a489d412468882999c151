{"task_id": "Mbpp/796", "solution": "from typing import Any, Dict\n\ndef return_sum(data: Dict[str, Any]) -> float:\n    \"\"\"\n    Calculates the sum of all numeric values in the given dictionary.\n    Validates input to ensure it's a dictionary with only numeric values (int or float).\n    \"\"\"\n\n    class InvalidInputError(Exception):\n        \"\"\"Custom exception for invalid inputs.\"\"\"\n        def __init__(self, message: str, invalid_value: Any = None) -> None:\n            self.message = message\n            self.invalid_value = invalid_value\n            super().__init__(message)\n\n        def __str__(self) -> str:\n            return f\"{self.message}: {self.invalid_value!r}\"\n\n    class DictDTO:\n        \"\"\"Data Transfer Object for the input dictionary.\"\"\"\n        def __init__(self, data: Dict[str, Any]) -> None:\n            self.data: Dict[str, Any] = data\n\n        @staticmethod\n        def from_raw(data: Dict[str, Any]) -> \"DictDTO\":\n            return DictDTO(data)\n\n    # --- Input Validation Logic (flattened from InputValidator) ---\n    NUMBER_TYPES = (int, float)\n\n    def _is_number(value: Any) -> bool:\n        \"\"\"Helper to check if a value is a number (int or float) but not a boolean.\"\"\"\n        return isinstance(value, NUMBER_TYPES) and not isinstance(value, bool)\n\n    if not isinstance(data, dict):\n        raise InvalidInputError(\"Input must be a dict\", data)\n\n    for k, v in data.items():\n        if not _is_number(v):\n            raise InvalidInputError(f\"Value for key {k} is not numeric\", v)\n\n    # Create DTO after validation\n    dto = DictDTO.from_raw(data)\n\n    # --- Summation Logic (flattened from SumService) ---\n    # Convert all values to float and sum them.\n    values = [float(v) for v in dto.data.values()]\n    return sum(values)"}
{"task_id": "Mbpp/797", "solution": "from dataclasses import dataclass\n\nNATURAL_MIN = 1\n\n@dataclass(frozen=True)\nclass Range:\n    start: int\n    end: int\n\n    def normalized(self) -> \"Range\":\n        s, e = self.start, self.end\n        if s > e:\n            s, e = e, s\n        s = max(s, NATURAL_MIN)\n        return Range(s, e)\n\nclass Utils:\n    @staticmethod\n    def to_int_checked(value) -> int:\n        # As per strict requirements, type checks and explicit error handling are omitted.\n        return int(value)\n\n    @staticmethod\n    def next_odd(n: int) -> int:\n        return n if n % 2 == 1 else n + 1\n\n    @staticmethod\n    def prev_odd(n: int) -> int:\n        return n if n % 2 == 1 else n - 1\n\n    @staticmethod\n    def sum_arithmetic_sequence(first: int, last: int, count: int) -> int:\n        return count * (first + last) // 2\n\nclass RangeValidator:\n    def _ensure_int_like(self, value: object) -> int:\n        # As per strict requirements, type checks and explicit error handling are omitted.\n        return Utils.to_int_checked(value)\n\n    def validate_and_normalize(self, l: object, r: object) -> Range:\n        _l = self._ensure_int_like(l)\n        _r = self._ensure_int_like(r)\n        # The Range.normalized() method will handle swapping and clipping to NATURAL_MIN.\n        return Range(_l, _r)\n\nclass InMemoryRepository:\n    def __init__(self):\n        self._calls = 0\n\n    def log_call(self, method: str, params: dict) -> None:\n        self._calls += 1\n\n    def get_calls(self) -> int:\n        return self._calls\n\nclass SumService:\n    def __init__(self, validator, repo=None):\n        self._validator = validator\n        self._repo = repo\n\n    def sum_odds_in_range(self, range_obj) -> int:\n        r = range_obj.normalized()\n        first = Utils.next_odd(r.start)\n        last = Utils.prev_odd(r.end)\n\n        if first > last:\n            return 0\n\n        count = ((last - first) // 2) + 1\n        total = Utils.sum_arithmetic_sequence(first, last, count)\n\n        if self._repo:\n            self._repo.log_call(\"sum_odds_in_range\", {\"start\": r.start, \"end\": r.end, \"result\": total})\n        return total\n\nclass RangeController:\n    def __init__(self, service=None, validator=None, repo=None) -> None:\n        self._validator = validator if validator is not None else RangeValidator()\n        self._repo = repo if repo is not None else InMemoryRepository()\n        self._service = service if service is not None else SumService(self._validator, self._repo)\n\n    def sum_in_range(self, l: object, r: object) -> int:\n        # The validator converts inputs to integers.\n        range_obj = self._validator.validate_and_normalize(l, r)\n        # The service calculates the sum based on the normalized range.\n        return self._service.sum_odds_in_range(range_obj)\n\n_default_controller = RangeController()\n\ndef sum_in_range(l, r) -> int:\n    \"\"\"\n    Calculates the sum of all odd natural numbers within the inclusive range l and r.\n    The function handles swapped bounds and clips the lower bound to 1.\n    \"\"\"\n    return _default_controller.sum_in_range(l, r)"}
{"task_id": "Mbpp/803", "solution": "import math\n\ndef is_perfect_square(n: int) -> bool:\n    \"\"\"\n    Checks if an integer `n` is a perfect square.\n\n    Returns True if n is a non-negative integer whose square root is also an integer.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n    if n < 0:\n        return False\n    root = math.isqrt(n)\n    return root * root == n"}
