{"task_id": "Mbpp/620", "solution": "def largest_subset(numbers):\n    \"\"\"\n    Finds the size of the largest subset of a list of numbers where every pair is divisible.\n    A pair (a, b) is divisible if 'a divides b' (b % a == 0) or 'b divides a' (a % b == 0).\n    \"\"\"\n    def is_divisible(a: int, b: int) -> bool:\n        \"\"\"Checks if a divides b, handling zero cases as per design context.\"\"\"\n        if a == 0:\n            return b == 0  # 0 divides 0. 0 does not divide any non-zero number.\n        return b % a == 0\n\n    if not numbers:\n        return 0\n\n    # Sort numbers by their absolute values. This allows dynamic programming\n    # to efficiently build divisible chains from smaller absolute values to larger ones.\n    nums = sorted(numbers, key=abs)\n    n = len(nums)\n\n    # dp[i] stores the length of the largest divisible subset ending with nums[i]\n    dp = [1] * n\n\n    # Initialize max_size with 1, as a single element forms a subset of size 1\n    # for any non-empty list.\n    max_size = 1\n\n    for i in range(n):\n        for j in range(i):\n            # Check if nums[j] and nums[i] form a divisible pair (either nums[j] divides nums[i]\n            # or nums[i] divides nums[j]). If they do, nums[i] can extend the subset ending at nums[j].\n            if is_divisible(nums[j], nums[i]) or is_divisible(nums[i], nums[j]):\n                dp[i] = max(dp[i], dp[j] + 1)\n        # Update the overall maximum size found so far.\n        max_size = max(max_size, dp[i])\n\n    return max_size"}
{"task_id": "Mbpp/630", "solution": "def get_coordinates(coordinate):\n    \"\"\"\n    Extracts all 3x3 adjacent coordinates of the given coordinate tuple, including itself.\n    Returns coordinates in row-major order: x from x-1 to x+1, then y from y-1 to y+1.\n    \"\"\"\n    x, y = coordinate\n    result = []\n    for dx in [-1, 0, 1]:\n        for dy in [-1, 0, 1]:\n            result.append([x + dx, y + dy])\n    return result"}
{"task_id": "Mbpp/628", "solution": "def replace_spaces(s: str) -> str:\n    \"\"\"\n    Replaces all spaces in the given string with '%20'.\n    \"\"\"\n    from dataclasses import dataclass\n\n    class InvalidInputError(Exception):\n        def __init__(self, message: str) -> None:\n            super().__init__(message)\n            self.message = message\n\n    @dataclass(frozen=True)\n    class StringDTO:\n        original: str\n        transformed: str\n\n        def to_dict(self) -> dict:\n            return {\"original\": self.original, \"transformed\": self.transformed}\n\n    class Validator:\n        def is_valid_string(self, s: object) -> bool:\n            return isinstance(s, str)\n\n    class SpaceEncoderAdapter:\n        def __init__(self, token: str = \"%20\") -> None:\n            self._token = token\n\n        def encode(self, s: str) -> str:\n            return s.replace(\" \", self._token)\n\n    class ReplaceService:\n        def __init__(self, encoder: SpaceEncoderAdapter) -> None:\n            self._encoder = encoder\n            self._validator = Validator()\n\n        def replace(self, s: str) -> StringDTO:\n            if not self._validator.is_valid_string(s):\n                raise InvalidInputError(\"Input must be a string.\")\n            transformed = self._encoder.encode(s)\n            return StringDTO(original=s, transformed=transformed)\n\n    encoder = SpaceEncoderAdapter(token=\"%20\")\n    service = ReplaceService(encoder=encoder)\n    dto = service.replace(s)\n    return dto.transformed"}
