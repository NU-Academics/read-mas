{"task_id": "Mbpp/172", "solution": "def count_occurance(s: str) -> int:\n    \"\"\"Counts the non-overlapping occurrences of 'std' in the given string.\"\"\"\n    target = \"std\"\n    count = 0\n    i = 0\n    while True:\n        idx = s.find(target, i)\n        if idx == -1:\n            break\n        count += 1\n        i = idx + len(target)\n    return count"}
{"task_id": "Mbpp/222", "solution": "def check_type(t: tuple) -> bool:\n    \"\"\"Checks if all elements in a tuple have the same data type.\n    An empty or single-element tuple is considered homogeneous.\n    \"\"\"\n    if len(t) <= 1:\n        return True\n\n    first_type = type(t[0])\n    return all(type(element) is first_type for element in t)"}
{"task_id": "Mbpp/223", "solution": "def is_majority(arr, n, x):\n    \"\"\"\n    Checks if an element x is the majority element in a sorted array arr of length n.\n    A majority element occurs more than n/2 times.\n    \"\"\"\n    if arr is None:\n        raise ValueError(\"arr must not be None\")\n    if n != len(arr):\n        raise ValueError(\"n must equal len(arr)\")\n    if n == 0:\n        return False\n\n    # Binary search to find the first occurrence of x\n    lo, hi = 0, n - 1\n    first_occurrence_idx = -1\n\n    while lo <= hi:\n        mid = (lo + hi) // 2\n        if arr[mid] == x:\n            first_occurrence_idx = mid\n            hi = mid - 1  # Try to find an earlier occurrence in the left half\n        elif arr[mid] < x:\n            lo = mid + 1\n        else:  # arr[mid] > x\n            hi = mid - 1\n\n    # If x was not found, it cannot be the majority element\n    if first_occurrence_idx == -1:\n        return False\n\n    # Calculate the index for the element that would be (n//2) positions after the first occurrence.\n    # If this element is still x and within array bounds, then x occurs more than n/2 times.\n    majority_check_idx = first_occurrence_idx + (n // 2)\n\n    return majority_check_idx < n and arr[majority_check_idx] == x"}
{"task_id": "Mbpp/224", "solution": "def count_Set_Bits(n):\n    \"\"\"\n    Count the number of set bits (1s) in the binary representation of a non-negative integer.\n\n    Accepts integers or values convertible to int. Raises TypeError for non-convertible inputs\n    and ValueError for negative values.\n    \"\"\"\n    try:\n        if not isinstance(n, int):\n            n = int(n)\n    except Exception:\n        raise TypeError(f\"Invalid input; expected integer or convertible value, got: {n!r}\")\n\n    if n < 0:\n        raise ValueError(\"Input must be a non-negative integer\")\n\n    # Prefer built-in bit_count (Python 3.8+), fallback to Kernighan's algorithm\n    try:\n        return n.bit_count()\n    except AttributeError:\n        count = 0\n        while n:\n            n &= n - 1\n            count += 1\n        return count"}
