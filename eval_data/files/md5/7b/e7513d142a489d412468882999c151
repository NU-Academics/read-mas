{"task_id": "Mbpp/294", "solution": "import math\nfrom typing import Sequence, Iterator, Union, Any\n\nclass MaxFinderError(Exception):\n    \"\"\"Base exception for the MaxFinder library.\"\"\"\n    pass\n\nclass InvalidInputError(MaxFinderError):\n    \"\"\"Raised when the input provided is not valid (e.g., not iterable).\"\"\"\n    pass\n\nclass NoNumericValuesError(MaxFinderError):\n    \"\"\"Raised when no numeric values are found in the input list.\"\"\"\n    pass\n\ndef is_numeric(value: Any) -> bool:\n    \"\"\"Returns True if the value is an int or float, but not a bool or NaN.\"\"\"\n    if isinstance(value, bool):\n        return False\n    if isinstance(value, (int, float)):\n        if isinstance(value, float) and math.isnan(value):\n            return False\n        return True\n    return False\n\ndef safe_max(iterator: Iterator[Union[int, float]]) -> Union[int, float]:\n    \"\"\"Finds the maximum value in an iterator, raising an error if empty.\"\"\"\n    found = False\n    current_max = None\n    for v in iterator:\n        if not found:\n            current_max = v\n            found = True\n        else:\n            if v > current_max:\n                current_max = v\n    if not found:\n        raise NoNumericValuesError(\"No numeric values found\")\n    return current_max\n\nclass TypeFilter:\n    \"\"\"Filters an iterable to yield only valid numeric (int/float) values.\"\"\"\n    def filter_numeric(self, values: Sequence[Any]) -> Iterator[Union[int, float]]:\n        for v in values:\n            if is_numeric(v):\n                yield v\n\nclass MaxService:\n    \"\"\"Provides the core business logic for finding the maximum numeric value.\"\"\"\n    def __init__(self, type_filter: TypeFilter = None) -> None:\n        self._type_filter = type_filter or TypeFilter()\n\n    def find_max(self, values: Sequence[Any]) -> Union[int, float]:\n        self._validate_input(values)\n        numeric_iter = self._type_filter.filter_numeric(values)\n        return safe_max(numeric_iter)\n\n    def _validate_input(self, values: Sequence[Any]) -> None:\n        try:\n            iter(values)\n        except TypeError as e:\n            raise InvalidInputError(\"Provided values is not iterable\") from e\n\n_default_service = MaxService()\n\ndef max_val(values: Sequence[Any]) -> Union[int, float]:\n    \"\"\"\n    Finds the maximum numeric value in a heterogeneous list.\n    Only considers int and float types, ignoring booleans and NaNs.\n    \"\"\"\n    return _default_service.find_max(values)"}
{"task_id": "Mbpp/296", "solution": "def get_Inv_Count(arr):\n    \"\"\"\n    Counts inversions in an array using a merge sort-based approach.\n    An inversion is a pair (i, j) such that i < j and a[i] > a[j].\n    \"\"\"\n    n = len(arr)\n    # Create a mutable copy of the input array to sort in-place\n    arr_copy = list(arr)\n    # Auxiliary array used during merging to avoid repeated allocations\n    temp_arr = [0] * n\n\n    def _merge_sort_and_count(array_slice, temp, left, right):\n        \"\"\"\n        Recursively sorts the subarray array_slice[left...right-1] and counts inversions.\n        \"\"\"\n        inv_count = 0\n        if right - left > 1:  # If there's more than one element\n            mid = (left + right) // 2\n            inv_count += _merge_sort_and_count(array_slice, temp, left, mid)\n            inv_count += _merge_sort_and_count(array_slice, temp, mid, right)\n            inv_count += _merge_count_halves(array_slice, temp, left, mid, right)\n        return inv_count\n\n    def _merge_count_halves(array_slice, temp, left, mid, right):\n        \"\"\"\n        Merges two sorted subarrays array_slice[left...mid-1] and array_slice[mid...right-1]\n        and counts inversions during the merge.\n        \"\"\"\n        i = left  # Starting index for left subarray\n        j = mid   # Starting index for right subarray\n        k = left  # Starting index for merged subarray in temp\n        count = 0\n\n        while i < mid and j < right:\n            if array_slice[i] <= array_slice[j]:\n                temp[k] = array_slice[i]\n                i += 1\n            else:\n                # If array_slice[i] > array_slice[j], then all remaining elements\n                # in the left subarray (from i to mid-1) are also greater than array_slice[j].\n                temp[k] = array_slice[j]\n                count += (mid - i)\n                j += 1\n            k += 1\n\n        # Copy the remaining elements of the left subarray, if any\n        while i < mid:\n            temp[k] = array_slice[i]\n            i += 1\n            k += 1\n\n        # Copy the remaining elements of the right subarray, if any\n        while j < right:\n            temp[k] = array_slice[j]\n            j += 1\n            k += 1\n\n        # Copy the merged elements back to the original array_slice\n        for x in range(left, right):\n            array_slice[x] = temp[x]\n\n        return count\n\n    return _merge_sort_and_count(arr_copy, temp_arr, 0, n)"}
{"task_id": "Mbpp/297", "solution": "from typing import Any, List, Optional, Iterator\n\ndef flatten_list(input_list: List[Any], options: Optional[Any] = None) -> List[Any]:\n    \"\"\"Flattens a given nested list structure into a single-level list.\n    It supports configurable behavior for flattening other iterables and using a generator.\n    \"\"\"\n\n    # Define a minimal FlattenOptions class inline to satisfy the type hint and configuration.\n    class FlattenOptions:\n        def __init__(self, allow_iterables: bool = False, use_generator: bool = False, max_depth: Optional[int] = None) -> None:\n            self.allow_iterables = allow_iterables\n            self.use_generator = use_generator\n            self.max_depth = max_depth\n\n    # Determine the effective options, using defaults if none are provided.\n    current_options = options if options is not None else FlattenOptions()\n\n    def _is_sequence(obj: Any, allow_iterables: bool) -> bool:\n        \"\"\"Checks if an object should be treated as a sequence to flatten, excluding strings.\"\"\"\n        if isinstance(obj, list):\n            return True\n        if not allow_iterables:\n            return False\n        return isinstance(obj, (tuple, set))\n\n    def _flatten_recursive(data: List[Any], opts: FlattenOptions, _depth: int = 0) -> List[Any]:\n        \"\"\"Recursively flattens a list using a depth-first approach.\"\"\"\n        out = []\n        for item in data:\n            if _is_sequence(item, opts.allow_iterables):\n                # Convert other iterables to list for consistent recursion if allowed.\n                out.extend(_flatten_recursive(list(item), opts, _depth + 1))\n            else:\n                out.append(item)\n        return out\n\n    def _flatten_generator(data: List[Any], opts: FlattenOptions, _depth: int = 0) -> Iterator[Any]:\n        \"\"\"Flattens a list using a generator for lazy evaluation.\"\"\"\n        for item in data:\n            if _is_sequence(item, opts.allow_iterables):\n                for sub in _flatten_generator(list(item), opts, _depth + 1):\n                    yield sub\n            else:\n                yield item\n\n    # Choose flattening strategy based on the 'use_generator' option.\n    if current_options.use_generator:\n        return list(_flatten_generator(input_list, current_options))\n    else:\n        return _flatten_recursive(input_list, current_options)"}
{"task_id": "Mbpp/300", "solution": "def count_binary_seq(n):\n    \"\"\"\n    Counts binary sequences of length 2n where the sum of the first n bits\n    equals the sum of the last n bits. This count is the central binomial coefficient C(2n, n).\n    \"\"\"\n    import math  # Required for math.comb\n\n    # Validate input\n    if not isinstance(n, int) or n < 0:\n        raise ValueError(\"n must be a non-negative integer\")\n\n    # The number of such sequences is given by the central binomial coefficient C(2n, n).\n    return math.comb(2 * n, n)"}
{"task_id": "Mbpp/299", "solution": "def max_aggregate(data):\n    \"\"\"\n    Calculates the maximum aggregate from a list of (name, value) tuples.\n    In case of a tie in aggregate values, the name that is lexicographically\n    smaller is chosen.\n    \"\"\"\n    aggregates = {}\n    for name, value in data:\n        aggregates[name] = aggregates.get(name, 0) + value\n\n    # Assume non-empty input as per the provided example.\n    sorted_items = sorted(aggregates.items(), key=lambda kv: kv[0])\n    max_name, max_total = max(sorted_items, key=lambda kv: kv[1])\n\n    return (max_name, max_total)"}
{"task_id": "Mbpp/301", "solution": "def dict_depth(d: dict) -> int:\n    \"\"\"\n    Calculates the maximum nesting depth of dictionaries within a given dictionary.\n    The outermost dictionary counts as depth 1.\n    \"\"\"\n    stack = [(d, 1)]\n    max_depth_val = 0\n\n    while stack:\n        current_obj, current_level = stack.pop()\n\n        if isinstance(current_obj, dict):\n            # If the current object is a dictionary, its level contributes to the maximum depth.\n            max_depth_val = max(max_depth_val, current_level)\n            # Add its values to the stack; dictionaries found here will be at current_level + 1.\n            for value in current_obj.values():\n                if isinstance(value, (dict, list, tuple, set)):\n                    stack.append((value, current_level + 1))\n        elif isinstance(current_obj, (list, tuple, set)):\n            # If the current object is a list/tuple/set, it does not increase the depth itself.\n            # However, its elements can contain dictionaries, which are considered at the current_level.\n            for item in current_obj:\n                if isinstance(item, (dict, list, tuple, set)):\n                    stack.append((item, current_level))\n\n    return max_depth_val"}
{"task_id": "Mbpp/305", "solution": "import re\n\ndef start_withp(words_list: list) -> tuple:\n    \"\"\"\n    Returns two words from a list of words starting with letter 'p' (case-insensitive),\n    preserving original capitalization and stripping surrounding punctuation.\n    \"\"\"\n    p_words = []\n\n    # Regex to strip leading/trailing non-alphanumeric characters.\n    # Compiled once for efficiency within the function scope.\n    _strip_re = re.compile(r\"^[^A-Za-z0-9]+|[^A-Za-z0-9]+$\")\n\n    def _strip_punctuation_preserve_case(word: str) -> str:\n        \"\"\"Strips leading/trailing non-alphanumeric characters from a word.\"\"\"\n        return _strip_re.sub(\"\", word)\n\n    for line in words_list:\n        for token in line.split():\n            # Process the token by stripping punctuation, preserving original case.\n            processed_token = _strip_punctuation_preserve_case(token)\n\n            # Check if the processed token is not empty and starts with 'p' (case-insensitive).\n            if processed_token and processed_token[0].lower() == 'p':\n                p_words.append(processed_token) # Append the processed token to results.\n\n                # Return the collected words as a tuple once two matches are found.\n                if len(p_words) == 2:\n                    return tuple(p_words)\n\n    # If fewer than two matches are found, return the collected words.\n    return tuple(p_words)"}
{"task_id": "Mbpp/306", "solution": "def max_sum_increasing_subseq(arr: list[int], n: int, i: int, k: int) -> int:\n    \"\"\"\n    Finds the maximum sum of an increasing subsequence from arr[0..i]\n    that also includes arr[k], where k > i.\n    \"\"\"\n    # Basic validation\n    if not isinstance(arr, list):\n        raise TypeError(\"arr must be a list of integers\")\n    if n != len(arr):\n        raise ValueError(\"n must be the length of arr\")\n    if not (0 <= i < n):\n        raise IndexError(\"i out of bounds\")\n    if not (0 <= k < n):\n        raise IndexError(\"k out of bounds\")\n    if k <= i:\n        raise ValueError(\"k must be greater than i\")\n    if any(not isinstance(x, int) for x in arr):\n        raise TypeError(\"all elements of arr must be integers\")\n\n    # compute_prefix_max_sums(arr, upto=i) to find max sum of increasing subsequence ending at each index j in 0..i\n    prefix_max_sums = [arr[j] for j in range(i + 1)]\n    for j in range(i + 1):\n        for p in range(j):\n            if arr[p] < arr[j]:\n                candidate = prefix_max_sums[p] + arr[j]\n                if candidate > prefix_max_sums[j]:\n                    prefix_max_sums[j] = candidate\n\n    # Initialize best sum with arr[k] itself, as it can form a subsequence of one element.\n    best_sum = arr[k]\n\n    # Iterate through the prefix elements to find combinations with arr[k]\n    for j in range(i + 1):\n        if arr[j] < arr[k]:\n            candidate = prefix_max_sums[j] + arr[k]\n            if candidate > best_sum:\n                best_sum = candidate\n\n    return best_sum"}
{"task_id": "Mbpp/310", "solution": "def string_to_tuple(s):\n    \"\"\"Converts a string into a tuple of characters, excluding whitespace characters.\"\"\"\n    return tuple(ch for ch in s if not ch.isspace())"}
{"task_id": "Mbpp/309", "solution": "def maximum(a, b):\n    \"\"\"\n    Finds the maximum of two numbers using an internal service-oriented structure.\n    \"\"\"\n    class ComparatorAdapter:\n        def compare(self, val_a, val_b):\n            # Compares two values and returns the greater one.\n            return val_a if val_a >= val_b else val_b\n\n    class MaxService:\n        def __init__(self, adapter: ComparatorAdapter):\n            self._adapter = adapter\n\n        def get_max(self, val_a, val_b):\n            # Delegates the comparison to the injected adapter.\n            return self._adapter.compare(val_a, val_b)\n\n    class MaxController:\n        def __init__(self, service: MaxService):\n            self._service = service\n\n        def compute_max(self, val_a, val_b):\n            # Orchestrates the max computation through the service layer.\n            return self._service.get_max(val_a, val_b)\n\n    adapter = ComparatorAdapter()\n    service = MaxService(adapter)\n    controller = MaxController(service)\n\n    return controller.compute_max(a, b)"}
{"task_id": "Mbpp/311", "solution": "def set_left_most_unset_bit(n: int) -> int:\n    \"\"\"\n    Sets the left-most (most-significant) unset bit in the binary representation of n.\n    For example, for n=10 (0b1010), the left-most unset bit is at position 2, yielding 14 (0b1110).\n    If all bits up to the most significant bit are set, the next higher bit is set.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an int\")\n    if n < 0:\n        raise ValueError(\"n must be non-negative\")\n\n    if n == 0:\n        return 1\n\n    # Find the bit-length of n\n    bitlen = n.bit_length()\n\n    # Iterate from the most-significant bit position down to 0\n    for pos in range(bitlen - 1, -1, -1):\n        # Check if the bit at the current position is 0 (unset)\n        if not (n >> pos) & 1:\n            # If unset, set this bit and return the new number\n            return n | (1 << pos)\n\n    # If all bits up to bitlen-1 are set, set the bit at position bitlen\n    return n | (1 << bitlen)"}
{"task_id": "Mbpp/308", "solution": "import heapq\nimport hashlib\nimport json\n\ndef large_product(list_a, list_b, k: int, deduplicate: bool = False):\n    # Ensure cache is initialized once and stored on the function object for persistence across calls.\n    if not hasattr(large_product, \"_cache_repo\"):\n        large_product._cache_repo = _ResultCacheRepo()\n\n    class InvalidInputError(Exception):\n        \"\"\"Custom exception for invalid function inputs.\"\"\"\n        pass\n\n    class NotEnoughProductsError(Exception):\n        \"\"\"Custom exception for when 'k' cannot be satisfied.\"\"\"\n        pass\n\n    def _validate_list_numbers(lst):\n        \"\"\"Checks if a list contains only numbers and is not empty.\"\"\"\n        if not isinstance(lst, (list, tuple)):\n            return False\n        if not lst:\n            return False\n        for x in lst:\n            if not isinstance(x, (int, float)):\n                return False\n        return True\n\n    def _fingerprint(lst_a, lst_b, num_k, dedup):\n        \"\"\"Generates a consistent hash for cache key creation.\"\"\"\n        normalized_a = sorted(map(float, lst_a))\n        normalized_b = sorted(map(float, lst_b))\n        data = {\n            \"a\": normalized_a,\n            \"b\": normalized_b,\n            \"k\": num_k,\n            \"dedup\": dedup\n        }\n        return hashlib.sha256(json.dumps(data, separators=(\",\", \":\"), ensure_ascii=False).encode()).hexdigest()\n\n    class _ResultCacheRepo:\n        \"\"\"In-memory cache for computed results with a basic LRU eviction strategy.\"\"\"\n        def __init__(self, max_size=1024):\n            self._store = {}\n            self._max_size = max_size\n            self._order = []\n\n        def get(self, key):\n            if key in self._store:\n                # Move key to end to simulate LRU on access.\n                self._order.remove(key)\n                self._order.append(key)\n                return self._store[key