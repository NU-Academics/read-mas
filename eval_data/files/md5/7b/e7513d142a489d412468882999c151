{"task_id": "Mbpp/119", "solution": "from typing import Sequence\n\ndef search(nums: Sequence[int]) -> int:\n    \"\"\"\n    Find the element that appears only once in a sorted array where every other element appears exactly twice.\n    Time complexity: O(log n), space complexity: O(1).\n    \"\"\"\n    if not nums:\n        raise ValueError(\"nums must be a non-empty sequence\")\n\n    low, high = 0, len(nums) - 1\n    while low < high:\n        mid = (low + high) // 2\n        # Ensure mid is the first index of a pair (make it even)\n        if mid % 2 == 1:\n            mid -= 1\n        if nums[mid] == nums[mid + 1]:\n            low = mid + 2\n        else:\n            high = mid\n    return nums[low]"}
{"task_id": "Mbpp/120", "solution": "def max_product_tuple(pairs: Sequence[Tuple[float, float]]) -> float:\n    \"\"\"\n    Computes the maximum absolute product of numbers within each 2-element tuple in a list.\n    Raises InvalidInputError for invalid input types, shapes, or an empty list.\n    \"\"\"\n\n    class InvalidInputError(Exception):\n        \"\"\"Custom exception for invalid input scenarios.\"\"\"\n        pass\n\n    if not isinstance(pairs, Sequence):\n        raise InvalidInputError(\"Input 'pairs' must be a sequence (e.g., list or tuple).\")\n    if not pairs:\n        raise InvalidInputError(\"Empty list: at least one pair required.\")\n\n    max_absolute_product_found = None\n\n    for i, p in enumerate(pairs):\n        if not (isinstance(p, (tuple, list)) and len(p) == 2):\n            raise InvalidInputError(f\"Element at index {i} is not a 2-element tuple or list: {p}\")\n        try:\n            a = float(p[0])\n            b = float(p[1])\n        except (ValueError, TypeError):\n            raise InvalidInputError(f\"Elements in pair at index {i} must be numeric: {p}\")\n\n        current_absolute_product = abs(a * b)\n\n        if max_absolute_product_found is None or current_absolute_product > max_absolute_product_found:\n            max_absolute_product_found = current_absolute_product\n\n    return float(max_absolute_product_found)"}
{"task_id": "Mbpp/123", "solution": "def amicable_numbers_sum(limit: int) -> int:\n    \"\"\"Sums all amicable numbers from 1 to a specified limit, inclusive.\"\"\"\n    if not isinstance(limit, int) or limit < 1:\n        raise ValueError(\"limit must be an int >= 1\")\n\n    # Pre-calculate the sum of proper divisors for all numbers up to limit using a sieve.\n    sums_of_proper_divisors = [0] * (limit + 1)\n    for i in range(1, (limit // 2) + 1):\n        for j in range(i * 2, limit + 1, i):\n            sums_of_proper_divisors[j] += i\n\n    total_amicable_sum = 0\n    seen_amicable_numbers = set()\n\n    # Iterate to find amicable pairs (a, b) and sum them, ensuring each number is counted once.\n    for a in range(2, limit + 1):\n        b = sums_of_proper_divisors[a]\n        if b != a and 1 <= b <= limit and sums_of_proper_divisors[b] == a:\n            if a not in seen_amicable_numbers:\n                total_amicable_sum += a\n                seen_amicable_numbers.add(a)\n            if b not in seen_amicable_numbers:\n                total_amicable_sum += b\n                seen_amicable_numbers.add(b)\n\n    return total_amicable_sum"}
{"task_id": "Mbpp/124", "solution": "import math\nfrom typing import Any\n\nclass InvalidComplexInput(ValueError):\n    \"\"\"Exception raised for invalid complex number inputs.\"\"\"\n\ndef parse_number(value: object) -> float:\n    \"\"\"Converts an object to a float, primarily for real parts of complex numbers or simple numerics.\"\"\"\n    if isinstance(value, (int, float)):\n        return float(value)\n    if isinstance(value, complex):\n        return float(value.real)\n    if isinstance(value, str):\n        try:\n            c = complex(value)\n            return float(c.real)\n        except ValueError as e:\n            raise InvalidComplexInput(f\"Could not parse string '{value}' as a complex number.\") from e\n    raise InvalidComplexInput(f\"Unsupported input type for number parsing: {type(value)}\")\n\nclass ComplexNumber:\n    \"\"\"Represents a complex number with explicit real and imaginary parts.\"\"\"\n    def __init__(self, real: float, imag: float) -> None:\n        self.real: float = float(real)\n        self.imag: float = float(imag)\n\n    @classmethod\n    def from_args(cls, *args: Any) -> \"ComplexNumber\":\n        \"\"\"Creates a ComplexNumber instance from 1 or 2 arguments.\"\"\"\n        if len(args) == 1:\n            v = args[0]\n            if isinstance(v, complex):\n                return cls(v.real, v.imag)\n            if isinstance(v, (int, float)):\n                return cls(float(v), 0.0)\n            if isinstance(v, str):\n                try:\n                    c = complex(v)\n                    return cls(c.real, c.imag)\n                except ValueError as e:\n                    raise InvalidComplexInput(f\"Could not parse single string argument '{v}' as complex number.\") from e\n            raise InvalidComplexInput(f\"Unsupported single argument type: {type(v)}\")\n        elif len(args) == 2:\n            real = parse_number(args[0])\n            imag_raw = args[1]\n            if isinstance(imag_raw, complex):\n                imag = float(imag_raw.imag)\n            else:\n                imag = parse_number(imag_raw)\n            return cls(real, imag)\n        raise InvalidComplexInput(\"angle_complex accepts 1 or 2 arguments (complex number, or real and imaginary parts).\")\n\n    def to_complex(self) -> complex:\n        \"\"\"Converts the DTO to a built-in complex number.\"\"\"\n        return complex(self.real, self.imag)\n\nclass AngleService:\n    \"\"\"Provides the core logic for calculating the angle of a complex number.\"\"\"\n    def calculate_angle(self, cn: ComplexNumber) -> float:\n        \"\"\"Computes the angle (argument) in radians for a given ComplexNumber.\"\"\"\n        if cn.real == 0.0 and cn.imag == 0.0:\n            return 0.0\n        return float(math.atan2(cn.imag, cn.real))\n\ndef angle_complex(*args: Any) -> float:\n    \"\"\"Calculates the angle (argument) of a complex number in radians.\"\"\"\n    cn = ComplexNumber.from_args(*args)\n    service = AngleService()\n    return service.calculate_angle(cn)"}
{"task_id": "Mbpp/126", "solution": "def sum_common_divisors(a, b):\n    \"\"\"\n    Finds the sum of common divisors of two given numbers.\n    \"\"\"\n    def get_divisors_for_number(n):\n        if not isinstance(n, int):\n            raise TypeError(\"Inputs must be integers\")\n        if n <= 0:\n            raise ValueError(\"Inputs must be positive integers\")\n        divisors = set()\n        i = 1\n        while i * i <= n:\n            if n % i == 0:\n                divisors.add(i)\n                divisors.add(n // i)\n            i += 1\n        return divisors\n\n    divisors_a = get_divisors_for_number(a)\n    divisors_b = get_divisors_for_number(b)\n\n    common_divisors = divisors_a.intersection(divisors_b)\n    return sum(common_divisors)"}
{"task_id": "Mbpp/125", "solution": "def find_length(s: str) -> int:\n    \"\"\"\n    Finds the maximum difference between the number of 0s and number of 1s in any substring.\n    This is achieved by mapping '0' to 1 and '1' to -1, then applying Kadane's algorithm.\n    \"\"\"\n\n    def map_char(c: str) -> int:\n        \"\"\"Maps a character '0' to 1 and '1' to -1.\"\"\"\n        return 1 if c == \"0\" else -1\n\n    def kadane(arr: list[int]) -> tuple[int, int, int]:\n        \"\"\"\n        Implements Kadane's algorithm to find the maximum sum of a contiguous subarray.\n        It also tracks the start and end indices of that subarray.\n        Returns (max_sum, start_index, end_index).\n        \"\"\"\n        if not arr:\n            # For an empty array, the max_sum is conceptually negative infinity.\n            # The outer logic will convert non-positive sums to 0.\n            return -float('inf'), 0, 0\n\n        max_so_far = -float('inf')\n        current_max = 0\n        start_index = 0\n        best_start = 0\n        best_end = 0\n\n        for i, value in enumerate(arr):\n            # If adding the current value makes current_max smaller than just the value itself,\n            # start a new subarray from the current value.\n            if current_max + value < value:\n                current_max = value\n                start_index = i\n            else:\n                current_max += value\n\n            # Update the maximum sum found so far and its corresponding indices.\n            if current_max > max_so_far:\n                max_so_far = current_max\n                best_start = start_index\n                best_end = i\n\n        return max_so_far, best_start, best_end\n\n    # Convert the binary string into an array of integers using the mapping.\n    # '0' becomes 1 (counts as a positive difference for zeros)\n    # '1' becomes -1 (counts as a negative difference for ones)\n    mapped_array = [map_char(char) for char in s]\n\n    # Apply Kadane's algorithm to find the maximum sum of any contiguous subarray.\n    # The start and end indices are not strictly needed for `find_length` but are returned by Kadane.\n    max_subarray_sum, _, _ = kadane(mapped_array)\n\n    # According to the problem statement and design context, if no substring yields\n    # a positive difference (i.e., max_subarray_sum is 0 or negative), the result is 0.\n    if max_subarray_sum <= 0:\n        return 0\n    else:\n        return max_subarray_sum"}
