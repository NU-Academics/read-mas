{"task_id": "HumanEval/151", "solution": "def double_the_difference(lst):\n    '''\n    Given a list of numbers, return the sum of squares of the numbers\n    in the list that are odd. Ignore numbers that are negative or not integers.\n    \n    double_the_difference([1, 3, 2, 0]) == 1 + 9 + 0 + 0 = 10\n    double_the_difference([-1, -2, 0]) == 0\n    double_the_difference([9, -2]) == 81\n    double_the_difference([0]) == 0  \n   \n    If the input list is empty, return 0.\n    '''\n    total_sum_of_squares = 0\n    for num in lst:\n        # Check if the number is an integer or a float representing an exact integer.\n        is_integer_like = False\n        if isinstance(num, int):\n            is_integer_like = True\n        elif isinstance(num, float) and num.is_integer():\n            is_integer_like = True\n        \n        if not is_integer_like:\n            continue\n\n        # Convert to integer and check if non-negative.\n        integer_value = int(num)\n        if integer_value < 0:\n            continue\n\n        # Check if the non-negative integer is odd.\n        if integer_value % 2 == 1:\n            total_sum_of_squares += integer_value * integer_value\n            \n    return total_sum_of_squares"}
{"task_id": "HumanEval/153", "solution": "def Strongest_Extension(class_name, extensions):\n    \"\"\"\n    Finds the strongest extension based on the CAP - SM formula and returns\n    the class name concatenated with the strongest extension name.\n    \"\"\"\n    \n    # Initialize with the first extension's strength and name\n    strongest_extension_name = extensions[0]\n    \n    initial_caps = 0\n    initial_small = 0\n    for char in strongest_extension_name:\n        if 'A' <= char <= 'Z':\n            initial_caps += 1\n        elif 'a' <= char <= 'z':\n            initial_small += 1\n    \n    max_strength = initial_caps - initial_small\n\n    # Iterate through the rest of the extensions\n    for ext_name in extensions[1:]:\n        current_caps = 0\n        current_small = 0\n        for char in ext_name:\n            if 'A' <= char <= 'Z':\n                current_caps += 1\n            elif 'a' <= char <= 'z':\n                current_small += 1\n        \n        current_strength = current_caps - current_small\n\n        # If a stronger extension is found, update the strongest_extension_name and max_strength.\n        # If strengths are equal, the one that came first in the list is kept\n        # because we only update when current_strength is strictly greater.\n        if current_strength > max_strength:\n            max_strength = current_strength\n            strongest_extension_name = ext_name\n            \n    return f\"{class_name}.{strongest_extension_name}\""}
{"task_id": "HumanEval/156", "solution": "ROMAN_MAP = [\n    (1000, \"M\"), (900, \"CM\"), (500, \"D\"), (400, \"CD\"),\n    (100, \"C\"), (90, \"XC\"), (50, \"L\"), (40, \"XL\"),\n    (10, \"X\"), (9, \"IX\"), (5, \"V\"), (4, \"IV\"), (1, \"I\"),\n]\n\ndef int_to_mini_roman(number):\n    \"\"\"\n    Given a positive integer, obtain its roman numeral equivalent as a string,\n    and return it in lowercase.\n    Restrictions: 1 <= num <= 1000\n    \"\"\"\n    result = []\n    n = number\n    for value, symbol in ROMAN_MAP:\n        while n >= value:\n            result.append(symbol)\n            n -= value\n        if n == 0:\n            break\n    return \"\".join(result).lower()"}
{"task_id": "HumanEval/154", "solution": "from typing import Iterator, Optional, Any\nfrom dataclasses import dataclass\n\nclass CycPatternError(Exception):\n    \"\"\"Base exception for the cycpattern package.\"\"\"\n    def __init__(self, message: str) -> None:\n        self.message = message\n        super().__init__(self.message)\n\nclass ValidationError(CycPatternError):\n    \"\"\"Exception raised for invalid input parameters.\"\"\"\n    pass\n\n@dataclass\nclass CycPatternResult:\n    \"\"\"DTO to carry result metadata.\"\"\"\n    matched: bool\n    matched_rotation: Optional[str]\n\nclass RotationGenerator:\n    \"\"\"Generates rotations of a string.\"\"\"\n    def __init__(self) -> None:\n        pass\n\n    def generate_rotations(self, s: str) -> Iterator[str]:\n        \"\"\"Yields all rotations of the input string.\"\"\"\n        n = len(s)\n        for i in range(n):\n            yield s[i:] + s[:i]\n\n    def generate_rotations_unique(self, s: str) -> Iterator[str]:\n        \"\"\"Yields unique rotations of the input string, avoiding duplicates.\"\"\"\n        seen = set()\n        for r in self.generate_rotations(s):\n            if r not in seen:\n                seen.add(r)\n                yield r\n\nclass CycPatternService:\n    \"\"\"Core business logic for checking cyclic patterns.\"\"\"\n    def __init__(self, rotation_generator: RotationGenerator) -> None:\n        self.rotation_generator = rotation_generator\n\n    def check(self, a: str, b: str) -> CycPatternResult:\n        \"\"\"Determines if b or any of its rotations is a substring in a.\"\"\"\n        if not b:\n            return CycPatternResult(matched=False, matched_rotation=None)\n        if b in a:\n            return CycPatternResult(matched=True, matched_rotation=b)\n        for r in self.rotation_generator.generate_rotations_unique(b):\n            if r in a:\n                return CycPatternResult(matched=True, matched_rotation=r)\n        return CycPatternResult(matched=False, matched_rotation=None)\n\nclass Validator:\n    \"\"\"Validates input arguments for type and length.\"\"\"\n    MAX_INPUT_LENGTH = 1_000_000\n\n    def validate(self, a: Any, b: Any) -> None:\n        \"\"\"Ensures inputs are valid strings within length limits.\"\"\"\n        if not isinstance(a, str) or not isinstance(b, str):\n            raise ValidationError(\"Inputs 'a' and 'b' must be strings.\")\n        if len(a) > self.MAX_INPUT_LENGTH or len(b) > self.MAX_INPUT_LENGTH:\n            raise ValidationError(f\"Inputs exceed max allowed length ({self.MAX_INPUT_LENGTH}).\")\n\nclass CycPatternController:\n    \"\"\"Orchestrates validation and service invocation for pattern checking.\"\"\"\n    def __init__(self, service: CycPatternService, validator: Validator) -> None:\n        self.service = service\n        self.validator = validator\n\n    def run_check(self, a: str, b: str) -> bool:\n        \"\"\"Validates inputs and returns boolean result from service.\"\"\"\n        self.validator.validate(a, b)\n        result = self.service.check(a, b)\n        return result.matched\n\n_default_controller = CycPatternController(\n    service=CycPatternService(rotation_generator=RotationGenerator()),\n    validator=Validator()\n)\n\ndef cycpattern_check(a , b):\n    \"\"\"You are given 2 words. You need to return True if the second word or any of its rotations is a substring in the first word\n    cycpattern_check(\"abcd\",\"abd\") => False\n    cycpattern_check(\"hello\",\"ell\") => True\n    cycpattern_check(\"whassup\",\"psus\") => False\n    cycpattern_check(\"abab\",\"baa\") => True\n    cycpattern_check(\"efef\",\"eeff\") => False\n    cycpattern_check(\"himenss\",\"simen\") => True\n\n    \"\"\"\n    return _default_controller.run_check(a, b)"}
{"task_id": "HumanEval/155", "solution": "from dataclasses import dataclass\n\n\nclass InvalidInputError(ValueError):\n    \"\"\"Raised when input cannot be parsed as an integer.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\n\n\n@dataclass(frozen=True)\nclass EvenOddResult:\n    \"\"\"Represents the count of even and odd digits.\"\"\"\n    even_count: int\n    odd_count: int\n\n    def to_tuple(self) -> tuple[int, int]:\n        \"\"\"Returns the counts as a tuple (even_count, odd_count).\"\"\"\n        return (self.even_count, self.odd_count)\n\n    def total(self) -> int:\n        \"\"\"Returns the total number of digits.\"\"\"\n        return self.even_count + self.odd_count\n\n    def __str__(self) -> str:\n        \"\"\"Returns a human-readable string representation.\"\"\"\n        return f\"Even: {self.even_count}, Odd: {self.odd_count}\"\n\n\nclass NumberParser:\n    \"\"\"Parses and validates integer inputs.\"\"\"\n    def parse_int(self, value: int | str) -> int:\n        \"\"\"Converts an int or string to an int, raising InvalidInputError on failure.\"\"\"\n        if isinstance(value, int):\n            return value\n        if isinstance(value, str):\n            s = value.strip()\n            if s == \"\":\n                raise InvalidInputError(\"Empty string is not a valid integer\")\n            try:\n                return int(s)\n            except ValueError:\n                raise InvalidInputError(f\"Cannot parse '{value}' as integer\")\n        raise InvalidInputError(f\"Unsupported input type: {type(value).__name__}\")\n\n\nclass Utils:\n    \"\"\"Provides low-level utilities for digit extraction and classification.\"\"\"\n    def iter_digits(self, number: int):\n        \"\"\"Yields each digit of the absolute value of the number.\"\"\"\n        n = abs(int(number))\n        if n == 0:\n            yield 0\n            return\n        while n:\n            n, digit = divmod(n, 10)\n            yield digit\n\n    def is_even(self, digit: int) -> bool:\n        \"\"\"Checks if a digit is even.\"\"\"\n        return (digit % 2) == 0\n\n\nclass EvenOddService:\n    \"\"\"Core business logic for counting even and odd digits in a number.\"\"\"\n    def __init__(self, parser: NumberParser, utils: Utils):\n        \"\"\"Initializes the service with necessary dependencies.\"\"\"\n        self.parser = parser\n        self.utils = utils\n\n    def count(self, number: int | str) -> EvenOddResult:\n        \"\"\"Counts even and odd digits in the given number.\"\"\"\n        parsed_num = self.parser.parse_int(number)\n        even = 0\n        odd = 0\n        for d in self.utils.iter_digits(parsed_num):\n            if self.utils.is_even(d):\n                even += 1\n            else:\n                odd += 1\n        return EvenOddResult(even_count=even, odd_count=odd)\n\n\ndef even_odd_count(num):\n    \"\"\"Given an integer. return a tuple that has the number of even and odd digits respectively.\n\n     Example:\n        even_odd_count(-12) ==> (1, 1)\n        even_odd_count(123) ==> (1, 2)\n    \"\"\"\n    parser = NumberParser()\n    utils = Utils()\n    service = EvenOddService(parser, utils)\n    result = service.count(num)\n    return result.to_tuple()"}
{"task_id": "HumanEval/158", "solution": "import collections\n\ndef find_max(words):\n    \"\"\"\n    Returns the word with the maximum number of unique characters.\n    If multiple strings have the maximum, returns the one that comes first lexicographically.\n    \"\"\"\n    if not words:\n        return \"\"\n\n    max_unique_chars = -1\n    result_word = \"\"\n\n    for word in words:\n        unique_chars_count = len(collections.Counter(word))\n\n        if unique_chars_count > max_unique_chars:\n            max_unique_chars = unique_chars_count\n            result_word = word\n        elif unique_chars_count == max_unique_chars:\n            # Tie-breaking: return the one which comes first in lexicographical order\n            if result_word == \"\" or word < result_word:\n                result_word = word\n\n    return result_word"}
{"task_id": "HumanEval/157", "solution": "import math\n\ndef is_close(x: float, y: float, tol: float) -> bool:\n    \"\"\"Checks if two floating point numbers are close within a given tolerance.\"\"\"\n    return abs(x - y) <= tol\n\ndef sort_sides(a: float, b: float, c: float) -> tuple[float, float, float]:\n    \"\"\"Sorts three numbers in ascending order.\"\"\"\n    return tuple(sorted((a, b, c)))\n\ndef right_angle_triangle(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle. Return True if the three\n    sides form a right-angled triangle, False otherwise.\n    A right-angled triangle is a triangle in which one angle is right angle or \n    90 degree.\n    Example:\n    right_angle_triangle(3, 4, 5) == True\n    right_angle_triangle(1, 2, 3) == False\n    '''\n    # Default tolerance for floating point comparisons as per design context\n    DEFAULT_TOLERANCE = 1e-9\n\n    # Sort the sides to identify the two shorter sides (legs) and the longest side (hypotenuse).\n    s1, s2, s3 = sort_sides(a, b, c)\n\n    # Check if the square of the two shorter sides approximately equals the square of the longest side.\n    return is_close(s1*s1 + s2*s2, s3*s3, DEFAULT_TOLERANCE)"}
{"task_id": "HumanEval/159", "solution": "def eat(number, need, remaining):\n    \"\"\"\n    Calculates the total carrots eaten and remaining after a rabbit's meal.\n    If there are not enough remaining carrots, the rabbit eats all available carrots.\n    \"\"\"\n    carrots_to_eat = min(need, remaining)\n    total_eaten = number + carrots_to_eat\n    carrots_left = remaining - carrots_to_eat\n    return [total_eaten, carrots_left]"}
{"task_id": "HumanEval/160", "solution": "from typing import List, Any, Callable, Dict\n\n\ndef do_algebra(operator: List[str], operand: List[int]) -> int:\n    \"\"\"\n    Given two lists operator, and operand. The first list has basic algebra operations, and \n    the second list is a list of integers. Use the two given lists to build the algebric \n    expression and return the evaluation of this expression.\n    \"\"\"\n\n    class Token:\n        def __init__(self, kind: str, value: Any):\n            self.kind = kind\n            self.value = value\n\n    # Define config constants for operators, precedence, associativity, and functions.\n    OPERATOR_PRECEDENCE: Dict[str, int] = {\"**\": 4, \"*\": 3, \"//\": 3, \"+\": 2, \"-\": 2}\n    OPERATOR_ASSOCIATIVITY: Dict[str, str] = {\"**\": \"right\", \"*\": \"left\", \"//\": \"left\", \"+\": \"left\", \"-\": \"left\"}\n    OPERATOR_FUNCTIONS: Dict[str, Callable[[int, int], int]] = {\n        \"+\": lambda a, b: a + b,\n        \"-\": lambda a, b: a - b,\n        \"*\": lambda a, b: a * b,\n        \"//\": lambda a, b: a // b,\n        \"**\": lambda a, b: a ** b,\n    }\n\n    # Step 1: Build infix tokens\n    infix_tokens: List[Token] = []\n    for i in range(len(operand)):\n        infix_tokens.append(Token(kind=\"NUMBER\", value=operand[i]))\n        if i < len(operator):\n            infix_tokens.append(Token(kind=\"OPERATOR\", value=operator[i]))\n\n    # Step 2: Convert infix to RPN using Shunting-Yard algorithm\n    output_queue: List[Token] = []\n    operator_stack: List[Token] = []\n\n    for token in infix_tokens:\n        if token.kind == \"NUMBER\":\n            output_queue.append(token)\n        elif token.kind == \"OPERATOR\":\n            op1_symbol = token.value\n            while (operator_stack and operator_stack[-1].kind == \"OPERATOR\"):\n                op2_symbol = operator_stack[-1].value\n                # If op1 has lower precedence than op2, or equal precedence and op1 is left-associative\n                if (OPERATOR_PRECEDENCE[op1_symbol] < OPERATOR_PRECEDENCE[op2_symbol]) or \\\n                   (OPERATOR_PRECEDENCE[op1_symbol] == OPERATOR_PRECEDENCE[op2_symbol] and OPERATOR_ASSOCIATIVITY[op1_symbol] == \"left\"):\n                    output_queue.append(operator_stack.pop())\n                else:\n                    break\n            operator_stack.append(token)\n\n    while operator_stack:\n        output_queue.append(operator_stack.pop())\n\n    rpn_tokens = output_queue\n\n    # Step 3: Evaluate the RPN expression\n    value_stack: List[int] = []\n    for token in rpn_tokens:\n        if token.kind == \"NUMBER\":\n            value_stack.append(token.value)\n        elif token.kind == \"OPERATOR\":\n            b = value_stack.pop()\n            a = value_stack.pop()\n            op_func = OPERATOR_FUNCTIONS[token.value]\n            result = op_func(a, b)\n            value_stack.append(result)\n\n    return value_stack[0]"}
{"task_id": "HumanEval/161", "solution": "def solve(s):\n    \"\"\"You are given a string s.\n    if s[i] is a letter, reverse its case from lower to upper or vise versa, \n    otherwise keep it as it is.\n    If the string contains no letters, reverse the string.\n    The function should return the resulted string.\n    Examples\n    solve(\"1234\") = \"4321\"\n    solve(\"ab\") = \"AB\"\n    solve(\"#a@C\") = \"#A@c\"\n    \"\"\"\n\n    def _has_letter(text: str) -> bool:\n        \"\"\"Checks if the string contains any alphabetic character.\"\"\"\n        return any(ch.isalpha() for ch in text)\n\n    def _toggle_case_char(char: str) -> str:\n        \"\"\"Toggles the case of a single character if it's a letter, otherwise returns it unchanged.\"\"\"\n        if char.isalpha():\n            return char.swapcase()\n        return char\n\n    if _has_letter(s):\n        transformed_chars = [_toggle_case_char(c) for c in s]\n        return \"\".join(transformed_chars)\n    else:\n        return s[::-1]"}
{"task_id": "HumanEval/163", "solution": "import json\nimport os\nimport datetime\nfrom typing import Any, List, Optional, Tuple, Dict\n\nclass InputValidationError(Exception):\n    \"\"\"Exception raised for invalid input values.\"\"\"\n    pass\n\nclass Utils:\n    \"\"\"Lightweight helper methods.\"\"\"\n    @staticmethod\n    def now_iso8601() -> str:\n        \"\"\"Returns the current UTC time in ISO 8601 format.\"\"\"\n        return datetime.datetime.now(datetime.timezone.utc).isoformat(timespec='seconds') + 'Z'\n\n    @staticmethod\n    def to_int(value: Any) -> int:\n        \"\"\"\n        Attempts to convert a value to an integer.\n        Raises InputValidationError if conversion fails or value is not int/str.\n        \"\"\"\n        if isinstance(value, int):\n            return value\n        if isinstance(value, str):\n            try:\n                return int(value.strip())\n            except ValueError:\n                raise InputValidationError(f\"Cannot convert '{value}' to an integer.\")\n        raise InputValidationError(f\"Value '{value}' must be an integer or a string representing an integer.\")\n\nclass RangeModel:\n    \"\"\"Represents a range of integers with min/max access.\"\"\"\n    def __init__(self, a: int, b: int) -> None:\n        self._a = a\n        self._b = b\n\n    @property\n    def a(self) -> int:\n        return self._a\n\n    @property\n    def b(self) -> int:\n        return self._b\n\n    def min_value(self) -> int:\n        return min(self._a, self._b)\n\n    def max_value(self) -> int:\n        return max(self._a, self._b)\n\nclass InputValidator:\n    \"\"\"Validates and coerces inputs to a RangeModel.\"\"\"\n    def validate(self, a: Any, b: Any) -> RangeModel:\n        ai = Utils.to_int(a)\n        bi = Utils.to_int(b)\n        if ai < 0 or bi < 0:\n            raise InputValidationError(\"Inputs must be non-negative integers.\")\n        return RangeModel(ai, bi)\n\nEVEN_DIGITS: Tuple[int, ...] = (0, 2, 4, 6, 8)\n\nclass ResultDTO:\n    \"\"\"Data Transfer Object for computation results.\"\"\"\n    def __init__(self, a: int, b: int, result: List[int], timestamp: str) -> None:\n        self._a = a\n        self._b = b\n        self._result = result\n        self._timestamp = timestamp\n\n    @property\n    def a(self) -> int:\n        return self._a\n\n    @property\n    def b(self) -> int:\n        return self._b\n\n    @property\n    def result(self) -> List[int]:\n        return self._result\n\n    @property\n    def timestamp(self) -> str:\n        return self._timestamp\n\n    def to_dict(self) -> Dict[str, Any]:\n        \"\"\"Returns a serializable dictionary representation of the DTO.\"\"\"\n        return {\n            \"timestamp\": self._timestamp,\n            \"a\": self._a,\n            \"b\": self._b,\n            \"result\": self._result,\n        }\n\nclass ResultRepository:\n    \"\"\"Handles optional persistence of results to a JSON file.\"\"\"\n    def __init__(self, path: str = \"even_digits_last.json\", append: bool = False) -> None:\n        self._path = path\n        self._append = append\n\n    def _write_json(self, data: Dict[str, Any]) -> None:\n        \"\"\"Internal helper to write JSON data to file.\"\"\"\n        mode = 'a' if self._append else 'w'\n        try:\n            with open(self._path, mode, encoding='utf-8') as f:\n                if self._append:\n                    f.write(json.dumps(data) + '\\n')\n                else:\n                    json.dump(data, f, indent=2)\n        except IOError:\n            # As per design, IO errors are logged and do not break the main flow.\n            pass\n\n    def persist(self, dto: ResultDTO) -> None:\n        \"\"\"Persists a ResultDTO to the configured file.\"\"\"\n        if not self._path:\n            return\n        self._write_json(dto.to_dict())\n\n    def load_last(self) -> Optional[ResultDTO]:\n        \"\"\"Loads the last persisted DTO (not used in this wrapper function).\"\"\"\n        return None\n\nclass EvenDigitService:\n    \"\"\"Core business logic for computing even digits.\"\"\"\n    def __init__(self, validator: InputValidator, repository: Optional[ResultRepository] = None) -> None:\n        self.validator = validator\n        self.repository = repository\n\n    def compute(self, range_model: RangeModel, persist: bool = False) -> ResultDTO:\n        \"\"\"Computes the even digits within the given range and optionally persists the result.\"\"\"\n        mn = range_model.min_value()\n        mx = range_model.max_value()\n        result = [d for d in EVEN_DIGITS if mn <= d <= mx]\n        \n        dto = ResultDTO(range_model.a, range_model.b, result, Utils.now_iso8601())\n        \n        if persist and self.repository:\n            try:\n                self.repository.persist(dto)\n            except Exception:\n                # Log and continue as per design context.\n                pass\n        return dto\n\nclass ApiController:\n    \"\"\"Provides a programmatic API layer, handling input validation and service calls.\"\"\"\n    def __init__(self, service: EvenDigitService) -> None:\n        self.service = service\n\n    def generate_integers(self, a: Any, b: Any, persist: bool = False) -> List[int]:\n        \"\"\"\n        Generates even digits between a and b, handling validation and service invocation.\n        Raises ValueError for invalid inputs.\n        \"\"\"\n        try:\n            range_model = self.service.validator.validate(a, b)\n            dto = self.service.compute(range_model, persist)\n            return dto.result\n        except InputValidationError as e:\n            # Translate internal InputValidationError to public ValueError.\n            raise ValueError(str(e))\n\ndef generate_integers(a, b):\n    \"\"\"\n    Given two positive integers a and b, return the even digits between a\n    and b, in ascending order.\n    \"\"\"\n    validator = InputValidator()\n    repo = ResultRepository()\n    service = EvenDigitService(validator, repository=repo)\n    controller = ApiController(service)\n    return controller.generate_integers(a, b, persist=False)"}
{"task_id": "HumanEval/162", "solution": "import hashlib\nfrom typing import Optional\n\n# These are mock/placeholder imports based on the design document's proposed structure.\n# In a real project, these would be proper imports from the 'md5util' package.\n\n# --- Mock/Placeholder classes and functions based on the design context ---\n\nclass StringDTO:\n    \"\"\"Mock StringDTO as described in design.\"\"\"\n    def __init__(self, text: str, md5: Optional[str], computed_at: Optional[str]):\n        self.text = text\n        self.md5 = md5\n        self.computed_at = computed_at\n\nclass Config:\n    \"\"\"Mock Config as described in design.\"\"\"\n    def __init__(self, cache_path: str, persist: bool):\n        self.cache_path = cache_path\n        self.persist = persist\n\ndef load_config():\n    \"\"\"Mock load_config to return a default config.\"\"\"\n    # This mock config assumes persistence is enabled and uses a dummy path.\n    # In a real implementation, this would read from environment variables or a config file.\n    return Config(cache_path=\"/tmp/md5util_cache.json\", persist=True)\n\nclass InvalidInputError(ValueError):\n    \"\"\"Mock InvalidInputError as described in design.\"\"\"\n    pass\n\nclass PersistenceError(Exception):\n    \"\"\"Mock PersistenceError as described in design.\"\"\"\n    pass\n\nclass HashRepository:\n    \"\"\"Mock HashRepository protocol.\"\"\"\n    def get(self, text: str) -> Optional[StringDTO]:\n        raise NotImplementedError\n    def save(self, dto: StringDTO) -> None:\n        raise NotImplementedError\n\nclass InMemoryHashRepository(HashRepository):\n    \"\"\"Mock InMemoryHashRepository as described in design.\"\"\"\n    def __init__(self):\n        self._store = {}\n\n    def get(self, text: str) -> Optional[StringDTO]:\n        data = self._store.get(text)\n        if data:\n            return StringDTO(text=text, md5=data['md5'], computed_at=data['computed_at'])\n        return None\n\n    def save(self, dto: StringDTO) -> None:\n        self._store[dto.text] = {'md5': dto.md5, 'computed_at': dto.computed_at}\n\nclass FileHashRepository(HashRepository):\n    \"\"\"Mock FileHashRepository as described in design. Omits actual file IO for brevity.\"\"\"\n    def __init__(self, path: str):\n        self._path = path\n        # In a real implementation, this would involve file locking and atomic writes.\n        self._store = {} # Simplified in-memory store for this mock\n\n    def get(self, text: str) -> Optional[StringDTO]:\n        # Simulate loading from file\n        return InMemoryHashRepository.get(self, text) # Reuse in-memory logic\n\n    def save(self, dto: StringDTO) -> None:\n        # Simulate saving to file\n        InMemoryHashRepository.save(self, dto) # Reuse in-memory logic\n\ndef validate_text(text: any) -> None:\n    \"\"\"Mock validate_text: raises TypeError if not a string.\"\"\"\n    if not isinstance(text, str):\n        raise TypeError(\"Input must be a string.\")\n\ndef compute_md5(text: str) -> str:\n    \"\"\"Mock compute_md5: computes the actual MD5 hash.\"\"\"\n    return hashlib.md5(text.encode(\"utf-8\")).hexdigest()\n\nfrom datetime import datetime\n\nclass MD5HasherService:\n    \"\"\"Mock MD5HasherService as described in design.\"\"\"\n    def __init__(self, repo: HashRepository):\n        self._repo = repo\n\n    def compute(self, text: str) -> Optional[str]:\n        if text == \"\":\n            return None\n        validate_text(text) # This will raise TypeError for non-str\n\n        dto = self._repo.get(text)\n        if dto and dto.md5:\n            return dto.md5\n\n        md5 = compute_md5(text)\n        computed_at = datetime.utcnow().isoformat(timespec='microseconds') + \"Z\"\n        new_dto = StringDTO(text=text, md5=md5, computed_at=computed_at)\n        try:\n            self._repo.save(new_dto)\n        except PersistenceError:\n            # Log the error and continue, returning the computed MD5.\n            pass\n        return md5\n\n# --- End of Mock/Placeholder classes and functions ---\n\n\ndef string_to_md5(text):\n    \"\"\"\n    Given a string 'text', return its md5 hash equivalent string.\n    If 'text' is an empty string, return None.\n    \"\"\"\n    cfg = load_config()\n    repo = FileHashRepository(cfg.cache_path) if cfg.persist else InMemoryHashRepository()\n    svc = MD5HasherService(repo)\n    return svc.compute(text)"}
