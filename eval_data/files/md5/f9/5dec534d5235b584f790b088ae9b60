{"task_id": "HumanEval/31", "solution": "import random\nimport math\n\n# Constants from design context\nSIEVE_LIMIT = 1000\nMR_ROUNDS = 5\n\n# Cache for small primes to avoid recomputing the sieve on every call.\n_small_primes_cache = None\n_sieve_limit_for_cache = 0\n\ndef _get_small_primes(limit: int) -> list[int]:\n    \"\"\"Generates and caches primes up to a given limit using the Sieve of Eratosthenes.\"\"\"\n    global _small_primes_cache, _sieve_limit_for_cache\n\n    # If the cache already covers the requested limit, return the relevant subset.\n    if _small_primes_cache is not None and _sieve_limit_for_cache >= limit:\n        return [p for p in _small_primes_cache if p <= limit]\n\n    current_limit = max(2, limit)\n    sieve = bytearray(b\"\\x01\") * (current_limit + 1)\n    sieve[0:2] = b\"\\x00\\x00\"  # 0 and 1 are not prime\n\n    for p in range(2, math.isqrt(current_limit) + 1):\n        if sieve[p]:\n            for multiple in range(p * p, current_limit + 1, p):\n                sieve[multiple] = 0\n    \n    _small_primes_cache = [i for i, is_prime_flag in enumerate(sieve) if is_prime_flag]\n    _sieve_limit_for_cache = current_limit\n    return _small_primes_cache\n\ndef _miller_rabin_test(n: int, rounds: int) -> bool:\n    \"\"\"Performs the Miller-Rabin probabilistic primality test.\"\"\"\n    # Write n-1 as d * 2^s\n    d = n - 1\n    s = 0\n    while d % 2 == 0:\n        d //= 2\n        s += 1\n\n    # Inner witness function\n    def _witness(a: int, d: int, s: int, n: int) -> bool:\n        x = pow(a, d, n)\n        if x == 1 or x == n - 1:\n            return False\n        for _ in range(s - 1):\n            x = pow(x, 2, n)\n            if x == n - 1:\n                return False\n        return True # n is composite if a is a witness\n\n    for _ in range(rounds):\n        # Choose a random 'a' in [2, n-2]\n        a = random.randrange(2, n - 1)\n        if _witness(a, d, s, n):\n            return False # n is composite\n    return True # n is probably prime\n\ndef is_prime(n):\n    \"\"\"Return true if a given number is prime, and false otherwise.\n    >>> is_prime(6)\n    False\n    >>> is_prime(101)\n    True\n    >>> is_prime(11)\n    True\n    >>> is_prime(13441)\n    True\n    >>> is_prime(61)\n    True\n    >>> is_prime(4)\n    False\n    >>> is_prime(1)\n    False\n    \"\"\"\n    if n <= 1:\n        return False\n    if n == 2 or n == 3:\n        return True\n    if n % 2 == 0:\n        return False\n\n    # Perform trial division with small primes\n    small_primes = _get_small_primes(SIEVE_LIMIT)\n    for p in small_primes:\n        if p * p > n: # Optimization: if p*p > n, and n not divisible by any p, then n must be prime\n            break\n        if n % p == 0:\n            return False\n    \n    # If n is smaller than or equal to SIEVE_LIMIT, and passed trial division by all primes up to sqrt(n)\n    # (which are covered by small_primes), then it is prime.\n    if n <= SIEVE_LIMIT:\n        return True\n\n    # For larger numbers not caught by trial division, use Miller-Rabin\n    return _miller_rabin_test(n, MR_ROUNDS)"}
{"task_id": "HumanEval/34", "solution": "def unique(l: list):\n    \"\"\"Return sorted unique elements in a list\n    >>> unique([5, 3, 5, 2, 3, 3, 9, 0, 123])\n    [0, 2, 3, 5, 9, 123]\n    \"\"\"\n    # Convert the list to a set to get unique elements, then sort them.\n    unique_elements = set(l)\n    return sorted(unique_elements)"}
{"task_id": "HumanEval/35", "solution": "import collections\nfrom typing import Any, Iterable, TypeVar\n\nT = TypeVar(\"T\")\n\ndef max_element(l: list) -> Any:\n    \"\"\"Return maximum element in the list.\n    >>> max_element([1, 2, 3])\n    3\n    >>> max_element([5, 3, -5, 2, -3, 3, 9, 0, 123, 1, -10])\n    123\n    \"\"\"\n    if not isinstance(l, collections.abc.Iterable):\n        raise TypeError(\"items must be an iterable\")\n    \n    it = iter(l)\n    try:\n        current = next(it)\n    except StopIteration:\n        raise ValueError(\"sequence is empty\")\n\n    for item in it:\n        if item > current:\n            current = item\n    return current"}
{"task_id": "HumanEval/36", "solution": "from typing import Iterator\n\ndef fizz_buzz(n: int):\n    \"\"\"Return the number of times the digit 7 appears in integers less than n which are divisible by 11 or 13.\n    \"\"\"\n\n    def _count_in_number(num: int, digit: str) -> int:\n        \"\"\"Counts occurrences of a digit in the decimal string representation of a number.\"\"\"\n        return str(num).count(digit)\n\n    def _generate_divisible(limit: int, divisors: list[int]) -> Iterator[int]:\n        \"\"\"Yields numbers less than limit that are divisible by any of the given divisors.\"\"\"\n        for i in range(limit):\n            for d in divisors:\n                if i % d == 0:\n                    yield i\n                    break\n\n    DEFAULT_DIVISORS = [11, 13]\n    DEFAULT_DIGIT = '7'\n\n    total_occurrences = 0\n    divisible_numbers_iterator = _generate_divisible(n, DEFAULT_DIVISORS)\n\n    for number in divisible_numbers_iterator:\n        total_occurrences += _count_in_number(number, DEFAULT_DIGIT)\n\n    return total_occurrences"}
{"task_id": "HumanEval/37", "solution": "def sort_even(l: list):\n    \"\"\"\n    Sorts elements at even indices of a list while preserving odd-indexed elements.\n    Returns a new list with even-indexed values sorted.\n    \"\"\"\n    l_prime = l.copy()\n    \n    even_elements = []\n    for i in range(0, len(l), 2):\n        even_elements.append(l[i])\n        \n    even_elements.sort()\n    \n    even_idx_counter = 0\n    for i in range(0, len(l_prime), 2):\n        l_prime[i] = even_elements[even_idx_counter]\n        even_idx_counter += 1\n        \n    return l_prime"}
{"task_id": "HumanEval/33", "solution": "def sort_third(l: list):\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the indicies that are not divisible by three, while its values at the indicies that are divisible by three are equal\n    to the values of the corresponding indicies of l, but sorted.\n    >>> sort_third([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_third([5, 6, 3, 4, 8, 9, 2])\n    [2, 6, 3, 4, 8, 9, 5]\n    \"\"\"\n    if not l:\n        return []\n\n    third_indices = []\n    values_to_sort = []\n\n    # Extract values at indices divisible by three and store their original indices\n    for i in range(len(l)):\n        if i % 3 == 0:\n            third_indices.append(i)\n            values_to_sort.append(l[i])\n\n    # Sort the extracted values\n    sorted_values = sorted(values_to_sort)\n\n    # Create a new list based on the original\n    result_list = list(l)\n\n    # Merge the sorted values back into the corresponding indices\n    for i, idx in enumerate(third_indices):\n        result_list[idx] = sorted_values[i]\n\n    return result_list"}
{"task_id": "HumanEval/38", "solution": "def decode_cyclic(s: str):\n    \"\"\"\n    takes as input string encoded with encode_cyclic function. Returns decoded string.\n    \"\"\"\n    # split string to groups. Each of length 3.\n    groups = [s[(3 * i):min((3 * i + 3), len(s))] for i in range((len(s) + 2) // 3)]\n    # inverse cycle elements in each group. Unless group has fewer elements than 3.\n    groups = [(group[-1] + group[:-1]) if len(group) == 3 else group for group in groups]\n    return \"\".join(groups)"}
{"task_id": "HumanEval/32", "solution": "import math\n\n\ndef poly(xs: list, x: float):\n    \"\"\"\n    Evaluates polynomial with coefficients xs at point x.\n    return xs[0] + xs[1] * x + xs[1] * x^2 + .... xs[n] * x^n\n    \"\"\"\n    return sum([coeff * math.pow(x, i) for i, coeff in enumerate(xs)])\n\n\ndef find_zero(xs: list):\n    \"\"\" xs are coefficients of a polynomial.\n    find_zero find x such that poly(x) = 0.\n    find_zero returns only only zero point, even if there are many.\n    Moreover, find_zero only takes list xs having even number of coefficients\n    and largest non zero coefficient as it guarantees\n    a solution.\n    >>> round(find_zero([1, 2]), 2) # f(x) = 1 + 2x\n    -0.5\n    >>> round(find_zero([-6, 11, -6, 1]), 2) # (x - 1) * (x - 2) * (x - 3) = -6 + 11x - 6x^2 + x^3\n    1.0\n    \"\"\"\n    TOLERANCE = 1e-9\n    MAX_NEWTON_ITERATIONS = 1000\n    BRACKET_SCAN_RANGE = 20.0  # Search range for bracketing (e.g., from -20 to 20)\n    BRACKET_SCAN_STEP = 0.1  # Step size for bracketing\n\n    # The problem guarantees xs has an even number of coefficients and a non-zero leading coefficient.\n    # An empty list is not an even number of coefficients, so we implicitly assume xs is not empty.\n    # The degree of the polynomial is len(xs) - 1. If len(xs) is even, the degree is odd,\n    # which guarantees at least one real root.\n\n    def _derivative_coeffs(coeffs: list) -> list:\n        \"\"\"Calculates coefficients of the derivative polynomial.\"\"\"\n        if len(coeffs) <= 1:\n            return [0.0]\n        # f(x) = c0 + c1*x + c2*x^2 + ... + cn*x^n\n        # f'(x) = c1 + 2*c2*x + ... + n*cn*x^(n-1)\n        deriv_coeffs = [i * coeffs[i] for i in range(1, len(coeffs))]\n        return deriv_coeffs\n\n    def _newton_method(coeffs: list, x0: float) -> float:\n        \"\"\"Applies Newton-Raphson method to find a root.\"\"\"\n        x = x0\n        deriv_coeffs = _derivative_coeffs(coeffs)\n\n        for _ in range(MAX_NEWTON_ITERATIONS):\n            fx = poly(coeffs, x)\n            if abs(fx) < TOLERANCE:\n                return x\n\n            fpx = poly(deriv_coeffs, x)\n            \n            # Handle near-zero derivative. If fx is also near zero, we found a root.\n            # Otherwise, Newton's method is unstable. Given problem constraints,\n            # this implies fx must be near zero in this case or Newton will converge.\n            if abs(fpx) < 1e-12:  # Check for near-zero derivative\n                if abs(fx) < TOLERANCE:\n                    return x\n                else:\n                    # If derivative is zero but f(x) is not, Newton's method fails.\n                    # Per instructions \"Do NOT add ... raise exceptions for edge cases\",\n                    # return the current best estimate.\n                    return x \n            \n            x -= fx / fpx\n        \n        return x  # Return best estimate after max_iterations\n\n    # --- Bracketing Search ---\n    # Find an interval [a, b] where poly(a) and poly(b) have different signs.\n    # Since the polynomial has an odd degree (len(xs) is even -> degree is odd),\n    # a real root is guaranteed, so a bracket will always be found if the search range is wide enough.\n\n    x_current = -BRACKET_SCAN_RANGE\n    f_current = poly(xs, x_current)\n\n    bracket_found = False\n    a, b = x_current, x_current # Default to a small interval if no bracket found\n\n    # Scan the range to find a sign change\n    while x_current <= BRACKET_SCAN_RANGE:\n        if abs(f_current) < TOLERANCE: # Found a root at x_current\n            return x_current\n        \n        x_next = x_current + BRACKET_SCAN_STEP\n        # Ensure x_next doesn't overshoot the maximum range\n        if x_next > BRACKET_SCAN_RANGE:\n            x_next = BRACKET_SCAN_RANGE\n            if x_next == x_current: # Prevent infinite loop if step size is too small for range\n                break\n\n        f_next = poly(xs, x_next)\n\n        if f_current * f_next < 0: # Strict inequality for sign change\n            a, b = x_current, x_next\n            bracket_found = True\n            break\n        \n        x_current = x_next\n        f_current = f_next\n    \n    # If a bracket was found, use its midpoint as the initial guess for Newton's method.\n    # If not found (e.g., due to numerical issues or a root outside the scan range,\n    # though unlikely for guaranteed odd degree), use 0.0 as a default initial guess.\n    if bracket_found:\n        initial_guess = (a + b) / 2.0\n    else:\n        initial_guess = 0.0\n    \n    return _newton_method(xs, initial_guess)"}
{"task_id": "HumanEval/39", "solution": "import random\nfrom typing import Iterator, List, Optional, Dict, Any\nimport json\nimport os\n\nclass InvalidInputError(Exception):\n    pass\n\nclass ComputationError(Exception):\n    pass\n\nclass FibonacciGenerator:\n    START_INDEX_DEFAULT = 1\n\n    def __init__(self, start_index: int = START_INDEX_DEFAULT) -> None:\n        self._start_index = start_index\n\n    def generate(self) -> Iterator[int]:\n        a, b = 1, 1\n        idx = 1\n        while True:\n            if idx >= self._start_index:\n                yield a\n            a, b = b, a + b\n            idx += 1\n\nclass PrimalityTester:\n    SMALL_PRIMES: List[int] = [2,3,5,7,11,13,17,19,23]\n\n    def __init__(self, k: int = 5) -> None:\n        self._k = k\n\n    def is_prime(self, n: int) -> bool:\n        if n <= 1:\n            return False\n        if n in self.SMALL_PRIMES:\n            return True\n        for p in self.SMALL_PRIMES:\n            if n % p == 0:\n                return False\n        return self._miller_rabin(n)\n\n    def _miller_rabin(self, n: int) -> bool:\n        d = n - 1\n        s = 0\n        while d % 2 == 0:\n            d //= 2\n            s += 1\n        for _ in range(self._k):\n            a = random.randrange(2, n - 1)\n            x = pow(a, d, n)\n            if x == 1 or x == n - 1:\n                continue\n            for _ in range(s - 1):\n                x = pow(x, 2, n)\n                if x == n - 1:\n                    break\n            else:\n                return False\n        return True\n\nclass CacheRepository:\n    def __init__(self, cache_file: Optional[str] = None) -> None:\n        self._cache: Dict[int, int] = {}\n        self.cache_file = cache_file\n        if self.cache_file:\n            self.load()\n\n    def get(self, n: int) -> Optional[int]:\n        return self._cache.get(n)\n\n    def set(self, n: int, value: int) -> None:\n        self._cache[n] = value\n        if self.cache_file:\n            self.persist()\n\n    def load(self) -> None:\n        if self.cache_file and os.path.exists(self.cache_file):\n            try:\n                with open(self.cache_file, 'r') as f:\n                    data = json.load(f)\n                    self._cache = {int(k): v for k, v in data.items()}\n            except (IOError, json.JSONDecodeError):\n                pass # Log error but continue with empty cache\n\n    def persist(self) -> None:\n        if self.cache_file:\n            try:\n                temp_file = self.cache_file + \".tmp\"\n                with open(temp_file, 'w') as f:\n                    json.dump({str(k): v for k, v in self._cache.items()}, f)\n                os.replace(temp_file, self.cache_file)\n            except IOError:\n                pass # Log error but continue\n\nclass PrimeFibService:\n    def __init__(self, generator: FibonacciGenerator, tester: PrimalityTester, cache: Optional[CacheRepository] = None, max_iterations: Optional[int] = None) -> None:\n        self.generator = generator\n        self.tester = tester\n        self.cache = cache\n        self.max_iterations = max_iterations\n\n    def find_nth_prime_fib(self, n: int) -> int:\n        if self.cache:\n            v = self.cache.get(n)\n            if v is not None:\n                return v\n\n        found_primes_count = 0\n        iterations = 0\n        for fib in self.generator.generate():\n            iterations += 1\n            if self.max_iterations is not None and iterations > self.max_iterations:\n                raise ComputationError(\"Iteration cap reached while searching for prime Fibonacci number.\")\n            \n            # The design context states \"Implementation will use standard Fibonacci generation and skip F=1 because 1 is not prime.\"\n            # F(1)=1, F(2)=1. The first unique Fibonacci number greater than 1 is F(3)=2.\n            # So we check for prime numbers among (2, 3, 5, 8, 13, ...)\n            if fib > 1 and self.tester.is_prime(fib):\n                found_primes_count += 1\n                if self.cache:\n                    self.cache.set(found_primes_count, fib)\n                if found_primes_count == n:\n                    return fib\n        \n        raise ComputationError(\"Failed to find the n-th prime Fibonacci number within limits.\")\n\n_prime_fib_service: Optional[PrimeFibService] = None\n\ndef prime_fib(n: int):\n    \"\"\"\n    prime_fib returns n-th number that is a Fibonacci number and it's also prime.\n    \"\"\"\n    global _prime_fib_service\n    if _prime_fib_service is None:\n        generator = FibonacciGenerator(start_index=1)\n        tester = PrimalityTester(k=5)\n        # No caching for standalone function as per example/stub context\n        _prime_fib_service = PrimeFibService(generator, tester, cache=None)\n    \n    return _prime_fib_service.find_nth_prime_fib(n)"}
{"task_id": "HumanEval/40", "solution": "def triples_sum_to_zero(l: list):\n    \"\"\"\n    triples_sum_to_zero takes a list of integers as an input.\n    it returns True if there are three distinct elements in the list that\n    sum to zero, and False otherwise.\n    \"\"\"\n    n = len(l)\n    if n < 3:\n        return False\n\n    # Sort the list to use the two-pointer technique.\n    # This also helps in skipping duplicate numbers for the first element.\n    sorted_l = sorted(l)\n\n    for i in range(n - 2):\n        # Skip duplicate elements for the first number to avoid redundant calculations.\n        if i > 0 and sorted_l[i] == sorted_l[i - 1]:\n            continue\n\n        # Use two pointers for the remaining sub-array\n        target_sum = -sorted_l[i]\n        left, right = i + 1, n - 1\n\n        while left < right:\n            current_sum = sorted_l[left] + sorted_l[right]\n\n            if current_sum == target_sum:\n                return True\n            elif current_sum < target_sum:\n                left += 1\n            else:\n                right -= 1\n    return False"}
{"task_id": "HumanEval/44", "solution": "def change_base(x: int, base: int):\n    \"\"\"Change numerical base of input number x to base.\n    return string representation after the conversion.\n    base numbers are less than 10.\n    >>> change_base(8, 3)\n    '22'\n    >>> change_base(8, 2)\n    '1000'\n    >>> change_base(7, 2)\n    '111'\n    \"\"\"\n    if x == 0:\n        return \"0\"\n\n    digits = []\n    n = x\n    while n > 0:\n        digits.append(str(n % base))\n        n //= base\n    return \"\".join(reversed(digits))"}
{"task_id": "HumanEval/43", "solution": "def pairs_sum_to_zero(l):\n    \"\"\"\n    pairs_sum_to_zero takes a list of integers as an input.\n    it returns True if there are two distinct elements in the list that\n    sum to zero, and False otherwise.\n    >>> pairs_sum_to_zero([1, 3, 5, 0])\n    False\n    >>> pairs_sum_to_zero([1, 3, -2, 1])\n    False\n    >>> pairs_sum_to_zero([1, 2, 3, 7])\n    False\n    >>> pairs_sum_to_zero([2, 4, -5, 3, 5, 7])\n    True\n    >>> pairs_sum_to_zero([1])\n    False\n    \"\"\"\n    if len(l) < 2:\n        return False\n\n    seen = set()\n    zero_count = 0\n\n    for x in l:\n        if x == 0:\n            zero_count += 1\n            if zero_count >= 2:\n                return True\n        elif -x in seen:\n            return True\n        seen.add(x)\n\n    return False"}
