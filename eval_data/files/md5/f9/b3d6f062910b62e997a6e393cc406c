irs in the input list whose bitwise XOR is an even number.\n    This leverages the property that a ^ b is even if and only if a and b have the same parity.\n    \"\"\"\n    even_count = 0\n    odd_count = 0\n\n    for num in numbers:\n        if num % 2 == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n\n    # Calculate pairs of even numbers (E * (E - 1) / 2)\n    even_even_pairs = even_count * (even_count - 1) // 2\n\n    # Calculate pairs of odd numbers (O * (O - 1) / 2)\n    odd_odd_pairs = odd_count * (odd_count - 1) // 2\n\n    return even_even_pairs + odd_odd_pairs", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "Mbpp/166", "solution": "def find_even_pair(numbers: list[int]) -> int:\n    \"\"\"Counts pairs in a list that XOR to an even number.\n    Pairs XOR to an even number if both elements are even or both are odd.\"\"\"\n    even_count = 0\n    odd_count = 0\n\n    for num in numbers:\n        if num % 2 == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n\n    # Calculate pairs of even numbers and pairs of odd numbers.\n    return (even_count * (even_count - 1) // 2) + \\\n           (odd_count * (odd_count - 1) // 2)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/167": [{"task_id": "Mbpp/167", "solution": "def next_power_of_2(n: int) -> int:\n    \"\"\"\n    Calculates the smallest power of two greater than or equal to n.\n    Assumes n is a non-negative integer.\n    \"\"\"\n    if n == 0:\n        return 1\n\n    # If n is already a power of 2, return n.\n    if (n & (n - 1)) == 0:\n        return n\n\n    # Find the next power of 2 using bit manipulation.\n    n -= 1\n    n |= n >> 1\n    n |= n >> 2\n    n |= n >> 4\n    n |= n >> 8\n    n |= n >> 16\n    n |= n >> 32\n    n += 1\n    return n", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": [