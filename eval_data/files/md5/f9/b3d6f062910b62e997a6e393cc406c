the index of the first occurrence of a number in a sorted array.\n    Returns -1 if the number is not found.\n    \"\"\"\n    low = 0\n    high = len(arr) - 1\n    result = -1\n\n    while low <= high:\n        mid = low + (high - low) // 2\n        if arr[mid] == num:\n            result = mid\n            high = mid - 1  # Try to find an earlier occurrence\n        elif arr[mid] < num:\n            low = mid + 1\n        else:  # arr[mid] > num\n            high = mid - 1\n    return result", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "Mbpp/733", "solution": "def find_first_occurrence(arr: list[int], num: int) -> int:\n    \"\"\"\n    Finds the index of the first occurrence of a given number in a sorted array.\n    Returns the index of the first occurrence of num, or -1 if not found.\n    \"\"\"\n    low = 0\n    high = len(arr) - 1\n    result = -1\n\n    while low <= high:\n        mid = low + (high - low) // 2\n        if arr[mid] == num:\n            result = mid\n            high = mid - 1  # Try to find an earlier occurrence\n        elif arr[mid] < num:\n            low = mid + 1\n        else:\n            high = mid - 1\n    return result", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/736": [{"task_id": "Mbpp/736", "solution": "from typing import Any, List\ndef left_insertion(sorted_list: List[Any], value: Any) -> int:\n    \"\"\"Locates the left-most insertion point for a value in a sorted list, maintaining ascending order. This uses a binary search algorithm for O(log n) performance.\"\"\"\n    low = 0\n    high = len(sorted_list)\n\n    while low < high:\n        mid = (low + high) // 2\n        if sorted_list[mid] < value:\n            low = mid + 1\n        else:\n            high = mid\n    return low", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "Mbpp/736", "solution": "def