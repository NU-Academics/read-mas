base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/130", "solution": "def tri(n: int) -> list[float]:\n    \"\"\"Calculates the first n + 1 numbers of the Tribonacci sequence.\n\n    Uses memoization to efficiently compute values based on given recurrence relations.\n    \"\"\"\n    memo = {}\n\n    def _calculate_tri_internal(k: int) -> float:\n        \"\"\"Helper to compute individual Tribonacci numbers with memoization.\"\"\"\n        if k in memo:\n            return memo[k]\n\n        if k == 0:\n            result = 1.0\n        elif k == 1:\n            result = 3.0\n        elif k > 0 and k % 2 == 0:  # Even n > 0\n            result = 1.0 + float(k) / 2.0\n        else:  # Odd n\n            # Recurrence: tri(n) = tri(n - 1) + tri(n - 2) + tri(n + 1)\n            val_k_minus_1 = _calculate_tri_internal(k - 1)\n            val_k_minus_2 = _calculate_tri_internal(k - 2)\n            val_k_plus_1 = _calculate_tri_internal(k + 1)\n            result = val_k_minus_1 + val_k_minus_2 + val_k_plus_1\n\n        memo[k] = result\n        return result\n\n    # Generate the sequence from 0 to n\n    tribonacci_sequence = []\n    for i in range(n + 1):\n        tribonacci_sequence.append(_calculate_tri_internal(i))\n\n    return tribonacci_sequence", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/140": [{"task_id": "HumanEval/140", "solution": "import re\ndef fix_spaces(text):\n    \"\"\"\n    Standardize spaces in a string: replace multiple spaces with a hyphen, and single spaces with an underscore.\n    If no spaces are present, the string is returned unmodified.\n    \"\"\"\n    # FR3: Return the input string without modification if it contains no space characters.\n    if ' ' not in text:\n        return text\n\n    # FR2: Replace each sequence of two or more consecutive space characters with a single hyphen character.\n    # This step must pre