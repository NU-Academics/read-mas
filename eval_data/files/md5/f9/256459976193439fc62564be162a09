it sum then original index.\"\"\"\n        if self.digit_sum != other.digit_sum:\n            return self.digit_sum < other.digit_sum\n        return self.original_index < other.original_index\ndef order_by_points(nums: list[int]) -> list[int]:\n    \"\"\"\n    Sorts a list of integers based on the sum of their digits,\n    then by their original index for ties.\n    \"\"\"\n    if not nums:\n        return []\n\n    metadata_objects = []\n    for i, num in enumerate(nums):\n        metadata_objects.append(IntegerWithMetadata(num, i))\n\n    sorted_metadata = sorted(metadata_objects)\n\n    return [obj.value for obj in sorted_metadata]", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[[1, 11, -1, -11, -12]]], "plus_fail_tests": [[[-5, -12, 9, 15]]]}], "HumanEval/146": [{"task_id": "HumanEval/146", "solution": "def _is_greater_than_ten(num: int) -> bool:\n    \"\"\"Checks if a number is strictly greater than 10.\"\"\"\n    return num > 10\ndef _is_first_digit_odd(num: int) -> bool:\n    \"\"\"Checks if the first digit of a number (absolute value) is odd.\"\"\"\n    str_num = str(abs(num))\n    first_digit = int(str_num[0])\n    return first_digit % 2 != 0\ndef _is_last_digit_odd(num: int) -> bool:\n    \"\"\"Checks if the last digit of a number (absolute value) is odd.\"\"\"\n    last_digit = abs(num) % 10\n    return last_digit % 2 != 0\ndef _is_special(num: int) -> bool:\n    \"\"\"Determines if a number meets all three special conditions.\"\"\"\n    return _is_greater_than_ten(num) and _is_first_digit_odd(num) and _is_last_digit_odd(num)\ndef specialFilter(nums: list[int]) -> int:\n    \"\"\"\n    Counts elements in an array that are greater than 10 with both first and last digits being odd.\n    \"\"\"\n    count = 0\n    for num in nums:\n        if _is_special(num):\n            count += 1\n    return count", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/146", "solution": "def _is_greater_than_10(number: int) -> bool:\n    \"\"\"Checks if a number is strictly greater than 10.\"\"\"\n    return number > 10\ndef _get_first_digit(number: int) -> int:\n    \"\"\"Extracts the first digit of a number (absolute value).\"\"\"\n    return int(str(abs(number))[0])\ndef _get_last_digit(number: int) -> int:\n    \"\"\"Extracts the last digit of a number (absolute value).\"\"\"\n    return abs(number) % 10\ndef _is_odd(digit: int) -> bool:\n    \"\"\"Checks if a digit is odd.\"\"\"\n    return digit % 2 != 0\ndef specialFilter(nums: list[int]) -> int:\n    \"\"\"Counts numbers in an array that meet specific filtering criteria.\"\"\"\n    count = 0\n    for number in nums:\n        if _is_greater_than_10(number):\n            first_digit = _get_first_digit(number)\n            last_digit = _get_last_digit(number)\n            if _is_odd(first_digit) and _is_odd(last_digit):\n                count += 1\n    return count", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/129": [{"task_id": "HumanEval/129", "solution": "def minPath(grid, k):\n    \"\"\"\n    Finds the lexicographically smallest path of length k in the grid.\n    Explores all paths from every cell and compares them to find the minimum.\n    \"\"\"\n\n    class Cell:\n        \"\"\"Represents a single cell in the grid with its coordinates and value.\"\"\"\n        def __init__(self, row, col, value):\n            self.row = row\n            self.col = col\n            self.value = value\n\n    class Grid:\n        \"\"\"Represents the N x N grid and provides utility methods for interactions.\"\"\"\n        def __init__(self, grid_data):\n            self.N = len(grid_data)\n            self.cells = []\n            for r in range(self.N):\n                row_cells = []\n                for c in range(self.N):\n                    row_cells.append(Cell(r, c, grid_data[r][c]))\n                self.cells.append(row_cells)\n\n        def get_value(self, row, col):\n            \"\"\"Retrieves the value of a cell at given coordinates.\"\"\"\n            return self.cells[row][col].value\n\n        def is_valid_coordinate(self, row, col):\n            \"\"\"Checks if coordinates are within grid boundaries.\"\"\"\n            return 0 <= row < self.N and 0 <= col < self.N\n\n        def get_neighbors(self, row, col):\n            \"\"\"Returns coordinates of valid adjacent neighbors (up, down, left, right).\"\"\"\n            neighbors = []\n            moves = [(-1, 0), (1, 0), (0, -1), (0, 1)] # Up, Down, Left, Right\n            for dr, dc in moves:\n                nr, nc = row + dr, col + dc\n                if self.is_valid_coordinate(nr, nc):\n                    neighbors.append((nr, nc))\n            return neighbors\n\n    class Path:\n        \"\"\"Represents a path as an ordered list of cell values and supports comparison.\"\"\"\n        def __init__(self, values=None):\n            self.values = values if values is not None else []\n            self.length = len(self.values)\n\n        def add_value(self, value):\n            \"\"\"Adds a cell value to the path.\"\"\"\n            self.values.append(value)\n            self.length += 1\n\n        def get_values(self):\n            \"\"\"Returns the list of values in the path.\"\"\"\n            return self.values\n\n        def __lt__(self, other):\n            \"\"\"Implements lexicographical comparison for Path objects.\"\"\"\n            return self.values < other.values\n\n    class PathGenerator:\n        \"\"\"Encapsulates logic for recursively generating all paths of length k.\"\"\"\n        def generate_paths(self, grid, k):\n            \"\"\"Initiates the path generation process from every cell in the grid.\"\"\"\n            all_paths = []\n            for r in range(grid.N):\n                for c in range(grid.N):\n                    self.dfs(grid, k, r, c, [], all_paths)\n            return all_paths\n\n        def dfs(self, grid, k, current_row, current_col, current_path_values, all_paths):\n            \"\"\"\n            Recursive Depth-First Search to explore paths of length k.\n            It adds the current cell's value and recurses for neighbors if the path is not yet complete.\n            \"\"\"\n            new_path_values = current_path_values + [grid.get_value(current_row, current_col)]\n\n            if len(new_path_values) == k:\n                all_paths.append(Path(new_path_values))\n                return\n\n            if len(new_path_values) < k:\n                for nr, nc in grid.get_neighbors(current_row, current_col):\n                    self.dfs(grid, k, nr, nc, new_path_values, all_paths)\n\n    # MinPathSolver Logic: Orchestrates grid initialization, path generation, and finding the minimum path.\n\n    grid_obj = Grid(grid)\n    path_generator = PathGenerator()\n    all_candidate_paths = path_generator.generate_paths(grid_obj, k)\n\n    if not all_candidate_paths:\n        return []\n\n    min_path_obj = all_candidate_paths[0]\n    for path_obj in all_candidate_paths[1:]:\n        if path_obj < min_path_obj:\n            min_path_obj = path_obj\n\n    return min_path_obj.get_values()", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[[[12, 13, 10, 1], [9, 3, 15, 6], [5, 16, 14, 4], [11, 8, 7, 2]], 12]], "plus_fail_tests": [[[[1, 2, 3], [4, 5, 6], [7, 8, 9]], 15]]}, {"task_id": "HumanEval/129", "solution": "from typing import List\ndef minPath(grid: List[List[int]], k: int) -> List[int]:\n    \"\"\"\n    Finds the lexicographically smallest path of length k in the grid.\n    Orchestrates DFS from all starting cells and manages the best path found.\n    \"\"\"\n    N = len(grid)\n    # Initialize min_path with values larger than any possible cell value (1 to N*N).\n    min_path = [N * N + 1] * k\n\n    def _is_valid(r: int, c: int, N: int) -> bool:\n        \"\"\"\n        Checks if coordinates (r, c) are within grid boundaries [0, N-1].\n        \"\"\"\n        return 0 <= r < N and 0 <= c < N\n\n    def _dfs(r: int, c: int, current_path: List[int], grid: List[List[int]], k: int, N: int, min_path_ref: List[int]) -> None:\n        \"\"\"\n        Recursively explores paths, prunes branches, and updates min_path_ref.\n        Modifies current_path for backtracking and min_path_ref for best path.\n        \"\"\"\n        current_path.append(grid[r][c])\n\n        # Base Case: Path of length k found.\n        if len(current_path) == k:\n            if current_path < min_path_ref:\n                min_path_ref[:] = current_path  # Update min_path_ref in place.\n            current_path.pop()  # Backtrack: remove current cell from path.\n            return\n\n        # Pruning Step: If current_path's prefix is already lexicographically greater than min_path_ref's prefix.\n        for i in range(len(current_path)):\n            if current_path[i] > min_path_ref[i]:\n                current_path.pop()  # Backtrack: prune this branch.\n                return\n            if current_path[i] < min_path_ref[i]:\n                # This path is still potentially better; continue exploration.\n                break\n\n        # Recursive Step: Explore neighbors (Up, Down, Left, Right).\n        dr = [-1, 1, 0, 0]\n        dc = [0, 0, -1, 1]\n\n        for i in range(4):\n            nr, nc = r + dr[i], c + dc[i]\n            if _is_valid(nr, nc, N):\n                _dfs(nr, nc, current_path, grid, k, N, min_path_ref)\n\n        current_path.pop()  # Backtrack: remove current cell after all neighbors are explored.\n\n    # Iterate through all possible starting cells in the grid.\n    for r_start in range(N):\n        for c_start in range(N):\n            _dfs(r_start, c_start, [], grid, k, N, min_path)\n\n    return min_path", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[[[10, 5, 20, 14, 16], [7, 11, 12, 17, 9], [13, 19, 1, 15, 8], [3, 18, 4, 6, 2], [22, 21, 23, 24, 25]], 25]]}], "HumanEval/147": [{"task_id": "HumanEval/147", "solution": "def get_max_triples(n: int) -> int:\n    \"\"\"\n    Calculates the number of triples (a[i], a[j], a[k]) where i < j < k\n    and their sum is a multiple of 3.\n    \"\"\"\n    a = []\n    # Populate 'a' with values a[i] = i*i - i + 1 for i from 1 to n.\n    for current_val_for_i in range(1, n + 1):\n        a.append(current_val_for_i * current_val_for_i - current_val_for_i + 1)\n\n    valid_triples_count = 0\n    # Iterate through all unique combinations of indices (i, j, k) such that 0 <= i < j < k < n.\n    for i in range(n - 2):\n        for j in range(i + 1, n - 1):\n            for k in range(j + 1, n):\n                current_sum = a[i] + a[j] + a[k]\n                if current_sum % 3 == 0:\n                    valid_triples_count += 1\n\n    return valid_triples_count", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/147", "solution": "def get_max_triples(n):\n    \"\"\"\n    You are given a positive integer n. You have to create an integer array a of length n.\n        For each i (1 \u2264 i \u2264 n), the value of a[i] = i * i - i + 1.\n        Return the number of triples (a[i], a[j], a[k]) of a where i < j < k,\n    and a[i] + a[j] + a[k] is a multiple of 3.\n\n    Example :\n        Input: n = 5\n        Output: 1\n        Explanation:\n        a = [1, 3, 7, 13, 21]\n        The only valid triple is (1, 7, 13).\n    \"\"\"\n\n    def _calculate_element_value(i: int) -> int:\n        \"\"\"Computes a[i] using the formula i * i - i + 1.\"\"\"\n        return i * i - i + 1\n\n    def _get_remainder_counts(n: int) -> dict:\n        \"\"\"Calculates element remainders modulo 3 and counts their frequencies.\"\"\"\n        counts = {0: 0, 1: 0, 2: 0}\n        for i in range(1, n + 1):\n            a_i = _calculate_element_value(i)\n            remainder = a_i % 3\n            counts[remainder] += 1\n        return counts\n\n    remainder_counts = _get_remainder_counts(n)\n    c0 = remainder_counts[0]\n    c1 = remainder_counts[1]\n    c2 = remainder_counts[2]\n\n    total_valid_triples_count = 0\n\n    # Case 1: Three elements with remainder 0 (r0, r0, r0)\n    if c0 >= 3:\n        total_valid_triples_count += c0 * (c0 - 1) * (c0 - 2) // 6\n\n    # Case 2: Three elements with remainder 1 (r1, r1, r1)\n    if c1 >= 3:\n        total_valid_triples_count += c1 * (c1 - 1) * (c1 - 2) // 6\n\n    # Case 3: Three elements with remainder 2 (r2, r2, r2)\n    if c2 >= 3:\n        total_valid_triples_count += c2 * (c2 - 1) * (c2 - 2) // 6\n\n    # Case 4: One element from each remainder group (r0, r1, r2)\n    total_valid_triples_count += c0 * c1 * c2\n\n    return total_valid_triples_count", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/148": [{"task_id": "HumanEval/148", "solution": "from typing import Optional, Dict, List, Tuple\nclass Planet:\n    \"\"\"Represents a single planet with its name and orbital order.\"\"\"\n    def __init__(self, name: str, order_from_sun: int):\n        self.name = name\n        self.order_from_sun = order_from_sun\nclass SolarSystem:\n    \"\"\"Manages the collection of all planets and provides methods for lookup and filtering.\"\"\"\n    def __init__(self):\n        # The eight planets in our solar system, ordered by proximity to the Sun.\n        planet_data = [\n            (\"Mercury\", 1), (\"Venus\", 2), (\"Earth\", 3), (\"Mars\", 4),\n            (\"Jupiter\", 5), (\"Saturn\", 6), (\"Uranus\", 7), (\"Neptune\", 8)\n        ]\n        self._planets_ordered: List[Planet] = [Planet(name, order) for name, order in planet_data]\n        self._planets_by_name: Dict[str, Planet] = {p.name.lower(): p for p in self._planets_ordered}\n\n    def get_planet_by_name(self, name: str) -> Optional[Planet]:\n        \"\"\"Retrieves a Planet object by its name (case-insensitive).\"\"\"\n        return self._planets_by_name.get(name.lower())\n\n    def get_planets_between(self, planet1_name: str, planet2_name: str) -> Tuple[str, ...]:\n        \"\"\"Returns a tuple of planet names between the two specified planets, sorted.\"\"\"\n        p1 = self.get_planet_by_name(planet1_name)\n        p2 = self.get_planet_by_name(planet2_name)\n\n        if not p1 or not p2:\n            return ()\n\n        # Determine the min and max order to find planets between them.\n        min_order = min(p1.order_from_sun, p2.order_from_sun)\n        max_order = max(p1.order_from_sun, p2.order_from_sun)\n\n        intermediate_planets: List[str] = []\n        for planet in self._planets_ordered:\n            # Collect planets strictly between the two specified planets.\n            if min_order < planet.order_from_sun < max_order:\n                intermediate_planets.append(planet.name)\n\n        return tuple(intermediate_planets)\ndef bf(planet1: str, planet2: str) -> Tuple[str, ...]:\n    \"\"\"Finds planets located between two specified planets in our solar system.\"\"\"\n    solar_system = SolarSystem()\n    return solar_system.get_planets_between(planet1, planet2)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/148", "solution": "def bf(planet1, planet2):\n    '''\n    Returns a tuple of planets located between planet1 and planet2, sorted by proximity to the sun.\n    Returns an empty tuple if either input planet name is invalid.\n    '''\n    planets_ordered = [\"Mercury\", \"Venus\", \"Earth\", \"Mars\", \"Jupiter\", \"Saturn\", \"Uranus\", \"Neptune\"]\n\n    p1_title = planet1.title()\n    p2_title = planet2.title()\n\n    if p1_title not in planets_ordered or p2_title not in planets_ordered:\n        return ()\n\n    index1 = planets_ordered.index(p1_title)\n    index2 = planets_ordered.index(p2_title)\n\n    start_index = min(index1, index2)\n    end_index = max(index1, index2)\n\n    intermediate_planets = planets_ordered[start_index + 1:end_index]\n    return tuple(intermediate_planets)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/150": [{"task_id": "HumanEval/150", "solution": "def is_prime(num: int) -> bool:\n    \"\"\"Checks if a given integer is a prime number.\n    Numbers <= 1 are not prime, 2 is prime, and even numbers greater than 2 are not prime.\"\"\"\n    if num <= 1:\n        return False\n    if num == 2:\n        return True\n    if num % 2 == 0:\n        return False\n\n    i = 3\n    while i * i <= num:\n        if num % i == 0:\n            return False\n        i += 2\n    return True\ndef x_or_y(n: int, x: any, y: any) -> any:\n    \"\"\"Returns the value of x if n is a prime number and returns the value of y otherwise.\n    This function orchestrates the primality check by calling is_prime.\"\"\"\n    if is_prime(n):\n        return x\n    else:\n        return y", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/150", "solution": "def is_prime(n):\n    \"\"\"Determines if a given integer n is a prime number.\n    It returns True if n is prime, False otherwise.\n    \"\"\"\n    if n <= 1:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n    i = 3\n    while i * i <= n:\n        if n % i == 0:\n            return False\n        i += 2\n    return True\ndef x_or_y(n, x, y):\n    \"\"\"Returns x if n is a prime number, otherwise returns y.\n    This function orchestrates a primality check and conditional value selection.\n    \"\"\"\n    if is_prime(n):\n        return x\n    else:\n        return y", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/149": [{"task_id": "HumanEval/149", "solution": "def sorted_list_sum(lst):\n    \"\"\"Filters a list of strings to include only even-length strings,\n    then sorts them by length and alphabetically for ties.\"\"\"\n    even_length_strings = [s for s in lst if len(s) % 2 == 0]\n    sorted_result = sorted(even_length_strings, key=lambda s: (len(s), s))\n    return sorted_result", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/149", "solution": "def _filter_even_length(strings: list[str]) -> list[str]:\n    \"\"\"Filters a list of strings, returning only those with an even length.\"\"\"\n    return [s for s in strings if len(s) % 2 == 0]\ndef _sort_by_length_and_alphabetically(strings: list[str]) -> list[str]:\n    \"\"\"Sorts a list of strings first by length (ascending), then alphabetically (ascending).\"\"\"\n    return sorted(strings, key=lambda s: (len(s), s))\ndef sorted_list_sum(lst: list[str]) -> list[str]:\n    \"\"\"Processes a list of strings, filtering by even length and then sorting by length and alphabetically.\"\"\"\n    filtered_strings = _filter_even_length(lst)\n    return _sort_by_length_and_alphabetically(filtered_strings)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/151": [{"task_id": "HumanEval/151", "solution": "from typing import Union\ndef _is_integer(num: any) -> bool:\n    \"\"\"\n    Checks if a given value is an integer.\n    \"\"\"\n    return isinstance(num, int)\ndef _is_positive(num: Union[int, float]) -> bool:\n    \"\"\"\n    Checks if a given number is positive.\n    \"\"\"\n    return num > 0\ndef _is_odd(num: int) -> bool:\n    \"\"\"\n    Checks if a given integer is odd.\n    \"\"\"\n    return num % 2 != 0\ndef _get_square(num: Union[int, float]) -> int:\n    \"\"\"\n    Calculates the square of a given number.\n    \"\"\"\n    return num * num\ndef double_the_difference(lst: list) -> int:\n    \"\"\"\n    Given a list of numbers, return the sum of squares of the numbers\n    in the list that are positive, odd, and integers.\n    Returns 0 if the input list is empty.\n    \"\"\"\n    if not lst:\n        return 0\n\n    running_sum = 0\n    for item in lst:\n        if _is_integer(item):\n            if _is_positive(item):\n                if _is_odd(item):\n                    running_sum += _get_square(item)\n    return running_sum", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/151", "solution": "class Number:\n    \"\"\"\n    Encapsulates a numerical value for validation and calculation.\n    Provides methods to check its properties and compute its square.\n    \"\"\"\n    def __init__(self, value: any):\n        self.value = value\n\n    def is_positive(self) -> bool:\n        \"\"\"Checks if the stored value is positive. Assumes the value is numeric.\"\"\"\n        return self.value > 0\n\n    def is_integer(self) -> bool:\n        \"\"\"Checks if the stored value is an integer type (Python's int).\"\"\"\n        # This uses isinstance to strictly identify Python's `int` type, crucial for differentiating from `float`.\n        return isinstance(self.value, int)\n\n    def is_odd(self) -> bool:\n        \"\"\"Checks if the stored value is odd. This method is called only if the value is a confirmed integer.\"\"\"\n        return self.value % 2 != 0\n\n    def square(self) -> int:\n        \"\"\"Calculates the square of the stored value. This method is called only if the value is a positive, odd integer.\"\"\"\n        return self.value * self.value\ndef double_the_difference(lst):\n    \"\"\"\n    Given a list of numbers, return the sum of squares of the numbers\n    in the list that are positive, odd integers.\n    \"\"\"\n    if not lst:\n        return 0\n\n    total_sum_of_squares = 0\n    for element in lst:\n        num_obj = Number(element)\n        # Sequence of checks to filter for positive, odd integers.\n        if num_obj.is_positive() and num_obj.is_integer() and num_obj.is_odd():\n            total_sum_of_squares += num_obj.square()\n\n    return total_sum_of_squares", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/152": [{"task_id": "HumanEval/152", "solution": "def compare(game, guess):\n    \"\"\"Compares game scores and guesses, returning absolute differences.\n    A difference of 0 indicates a correct guess.\n    \"\"\"\n    results = []\n    for g_score, g_guess in zip(game, guess):\n        if g_score == g_guess:\n            results.append(0)\n        else:\n            results.append(abs(g_score - g_guess))\n    return results", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/152", "solution": "class Match:\n    def __init__(self, actualScore: int, guessedScore: int):\n        \"\"\"Initializes a Match with actual and guessed scores, calculating the difference.\"\"\"\n        self.actualScore = actualScore\n        self.guessedScore = guessedScore\n        self.difference = self.calculate_difference()\n\n    def calculate_difference(self) -> int:\n        \"\"\"Computes the difference: 0 if correct, absolute difference otherwise.\"\"\"\n        if self.guessedScore == self.actualScore:\n            return 0\n        else:\n            return abs(self.guessedScore - self.actualScore)\nclass ComparisonService:\n    def __init__(self):\n        \"\"\"Initializes the service with no specific attributes required for its stateless operation.\"\"\"\n        pass\n\n    def compare_all_matches(self, gameScores: list[int], guessScores: list[int]) -> list[int]:\n        \"\"\"Compares all corresponding game and guess scores, returning a list of differences.\"\"\"\n        results_list = []\n        for actual, guessed in zip(gameScores, guessScores):\n            match_obj = Match(actual, guessed)\n            results_list.append(match_obj.difference)\n        return results_list\ndef compare(game: list[int], guess: list[int]) -> list[int]:\n    \"\"\"Compares actual game scores against user guesses, returning an array of absolute differences.\"\"\"\n    service = ComparisonService()\n    return service.compare_all_matches(game, guess)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/153": [{"task_id": "HumanEval/153", "solution": "def Strongest_Extension(class_name, extensions):\n    \"\"\"Calculates the strongest extension for a class based on character case count.\n    It resolves ties by selecting the extension appearing earliest in the list.\"\"\"\n\n    def _calculate_strength(extension_name):\n        \"\"\"Calculates the strength of an extension name as (uppercase count - lowercase count).\"\"\"\n        CAP = 0\n        SM = 0\n        for char in extension_name:\n            if 'A' <= char <= 'Z':\n                CAP += 1\n            elif 'a' <= char <= 'z':\n                SM += 1\n        return CAP - SM\n\n    # Assuming the extensions list is not empty, as implied by the problem context.\n    # Initialize with the first extension to establish initial max_strength and strongest_extension_name.\n    strongest_extension_name = extensions[0]\n    max_strength = _calculate_strength(extensions[0])\n\n    # Iterate through the remaining extensions (from the second one)\n    for i in range(1, len(extensions)):\n        current_extension_name = extensions[i]\n        current_strength = _calculate_strength(current_extension_name)\n\n        # If a new extension has greater strength, update the strongest.\n        # If strengths are equal, the existing 'strongest_extension_name' (encountered earlier) is kept.\n        if current_strength > max_strength:\n            max_strength = current_strength\n            strongest_extension_name = current_extension_name\n\n    # Format the result string as \"ClassName.StrongestExtensionName\".\n    return f\"{class_name}.{strongest_extension_name}\"", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/153", "solution": "class Extension:\n    \"\"\"Encapsulates an extension's name and its strength calculation logic.\"\"\"\n    def __init__(self, name: str):\n        self.name = name\n        self._cap_count = 0\n        self._sm_count = 0\n        self.strength = 0\n        self._calculate_strength()\n\n    def _calculate_strength(self):\n        \"\"\"Calculates the strength (CAP - SM) and stores it in the strength attribute.\"\"\"\n        for char in self.name:\n            if 'A' <= char <= 'Z':\n                self._cap_count += 1\n            elif 'a' <= char <= 'z':\n                self._sm_count += 1\n        self.strength = self._cap_count - self._sm_count\nclass ExtensionProcessor:\n    \"\"\"Processes a list of extensions to find the strongest one.\"\"\"\n    def find_strongest_extension(self, class_name: str, extensions: list[str]) -> str:\n        \"\"\"Finds the strongest extension based on strength and tie-breaking rules, then formats the output.\"\"\"\n        strongest_extension_name = \"\"\n        max_strength = float('-inf')\n\n        for ext_name in extensions:\n            ext = Extension(ext_name)\n            current_strength = ext.strength\n\n            if current_strength > max_strength:\n                max_strength = current_strength\n                strongest_extension_name = ext.name\n            # The tie-breaking rule states to keep the first encountered, so no action is needed if current_strength == max_strength.\n\n        return f\"{class_name}.{strongest_extension_name}\"\ndef Strongest_Extension(class_name, extensions):\n    \"\"\"Finds the strongest extension for a given class, based on a strength calculation.\n    It returns the class name concatenated with the strongest extension name.\n    \"\"\"\n    processor = ExtensionProcessor()\n    result = processor.find_strongest_extension(class_name, extensions)\n    return result", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "