llest_pos_result)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/136", "solution": "def largest_smallest_integers(lst: list) -> tuple:\n    \"\"\"\n    Returns a tuple `(a, b)`, where `a` is the largest negative integer and `b` is the smallest positive integer in the list.\n    Returns `None` for `a` or `b` if no such integers exist.\n    \"\"\"\n    largest_negative = None\n    smallest_positive = None\n\n    # Handle empty list as per FR8.\n    if not lst:\n        return (None, None)\n\n    # Filter numbers into negative and positive categories.\n    negative_numbers = [x for x in lst if x < 0]\n    positive_numbers = [x for x in lst if x > 0]\n\n    # Determine the largest negative integer (FR4, FR6).\n    if negative_numbers:\n        largest_negative = max(negative_numbers)\n\n    # Determine the smallest positive integer (FR5, FR7).\n    if positive_numbers:\n        smallest_positive = min(positive_numbers)\n\n    # Return the result tuple (a, b) (FR3).\n    # FR9 (list with only 0s) is implicitly handled here, as both lists would be empty.\n    return (largest_negative, smallest_positive)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/83": [{"task_id": "HumanEval/83", "solution": "def starts_one_ends(n):\n    \"\"\"\n    Calculates the count of n-digit positive integers that start or end with 1.\n    Handles the edge case n=1 and uses inclusion-exclusion for n > 1.\n    \"\"\"\n    if n == 1:\n        return 1\n    else:\n        # For n > 1, the count is 10^(n-1) + 8 * 10^(n-2)\n        return (10**(n - 1)) + (8 * (10**(n - 2)))", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/83", "solution": "def starts_one_ends(n):\n    \"\"\"Calculates the count of n-digit positive integers that start or end with 1.\n    This function applies the inclusion-exclusion principle based on the specified business rules.\n    \"\"\"\n    # BR3: Calculate count of n-digit numbers starting with 1.\n    # These numbers range from 10...0 (n-digits) to 19...9 (n-digits), totaling 10^(n-1) numbers.\n    count_starting_with_1 = 10**(n - 1)\n\n    # BR4: Calculate count of n-digit numbers ending with 1.\n    if n == 1:\n        # For n=1, only the number '1' ends with 1.\n        count_ending_with_1 = 1\n    else:\n        # For n > 1, the first digit can be 1-9 (9 options), the last digit is 1,\n        # and the middle (n-2) digits can be any from 0-9 (10^(n-2) options).\n        count_ending_with_1 = 9 * (10**(n - 2))\n\n    # BR5: Calculate count of n-digit numbers starting AND ending with 1.\n    # This can be simplified by considering the number of choices for the middle (n-2) digits.\n    # For n=1 ('1') or n=2 ('11'), there is only 1 such number.\n    # For n > 2, the first and last digits are fixed as 1, and the (n-2) middle digits\n    # can be any from 0-9, giving 10^(n-2) options.\n    count_starting_and_ending_with_1 = 10**(max(0, n - 2))\n\n    # BR6: Apply the Inclusion-Exclusion Principle to find the total count.\n    # Total = (Starts with 1) + (Ends with 1) - (Starts and ends with 1).\n    total_count = count_starting_with_1 + count_ending_with_1 - count_starting_and_ending_with_1\n\n    return total_count", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/137": [{"task_id": "HumanEval/137", "solution": "def _to_numeric(value):\n    \"\"\"Converts a value to a float, standardizing decimal separators for strings.\"\"\"\n    return float(str(value).replace(',', '.'))\ndef compare_one(a, b):\n    \"\"\"\n    Create a function that takes integers, floats, or strings representing\n    real numbers, and returns the larger variable in its given variable type.\n    Return None if the values are equal.\n    Note: If a real number is represented as a string, the floating point might be