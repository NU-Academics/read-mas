d character.\n    for i in range(n - 2, 0, -1):\n        current_char = word[i]\n        left_char = word[i-1]\n        right_char = word[i+1]\n\n        if _is_vowel(current_char) and \\\n           _is_consonant(left_char) and \\\n           _is_consonant(right_char):\n            return current_char\n\n    return \"\"", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/119": [{"task_id": "HumanEval/119", "solution": "def is_balanced(s: str) -> bool:\n    \"\"\"Checks if a string of parentheses is balanced using a stack.\n    It returns True if balanced, False otherwise.\n    \"\"\"\n    stack = []\n    for char in s:\n        if char == '(':\n            stack.append(char)\n        elif char == ')':\n            if not stack:\n                return False\n            stack.pop()\n    return not stack\ndef match_parens(lst):\n    \"\"\"Checks if two strings can form a balanced parentheses string by concatenation.\n    It returns 'Yes' if a balanced string can be formed, 'No' otherwise.\n    \"\"\"\n    s1, s2 = lst[0], lst[1]\n\n    # Check the first concatenation: s1 + s2\n    if is_balanced(s1 + s2):\n        return 'Yes'\n\n    # Check the second concatenation: s2 + s1\n    if is_balanced(s2 + s1):\n        return 'Yes'\n\n    return 'No'", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/119", "solution": "def _is_valid_parenthesis_string(s: str) -> bool:\n    \"\"\"Checks if a string contains only '(' and ')' characters.\"\"\"\n    for char in s:\n        if char not in '()':\n            return False\n    return True\ndef _is_good_string(s: str) -> bool:\n    \"\"\"Checks if a string has balanced parentheses.\"\"\"\n    balance = 0\n    for char in s:\n        if char == '(':\n            balance += 1\n        elif char == ')':\n            balance -= 1\n        if balance < 0:\n            return False\n    return balance == 0\ndef match_parens(lst):\n    \"\"\"\n    Checks if two parenthesis strings can be concatenated in any order\n    to form a balanced string.\n    \"\"\"\n    s1, s2 = lst[0], lst[1]\n\n    if not _is_valid_parenthesis_string(s1):\n        return 'No'\n    if not _is_valid_parenthesis_string(s2):\n        return 'No'\n\n    concat1 = s1 + s2\n    if _is_good_string(concat1):\n        return 'Yes'\n\n    concat2 = s2 + s1\n    if _is_good_string(concat2):\n        return 'Yes'\n\n    return 'No'", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/120": [{"task_id": "HumanEval/120", "solution": "def maximum(arr: list[int], k: int) -> list[int]:\n    \"\"\"\n    Given an array arr of integers and an integer k, return a sorted list\n    of length k with the maximum k numbers in arr.\n    \"\"\"\n    # Helper function for input validation, defined internally for self-containment\n    def _validate_input(arr: list[int], k: int) -> None:\n        \"\"\"\n        Validates the input array arr and integer k against non-functional requirements.\n        Raises ValueError on invalid input according to the specified constraints.\n        \"\"\"\n        if not (1 <= len(arr) <= 1000):\n            raise ValueError(\"Array length must be between 1 and 1000 (inclusive).\")\n\n        for x in arr:\n            if not (-1000 <= x <= 1000):\n                raise ValueError(\"Array elements must be between -1000 and 1000 (inclusive).\")\n\n        if not (0 <= k <= len(arr)):\n            raise ValueError(f\"Value of k must be between 0 and {len(arr)} (inclusive).\")\n\n    _validate_input(arr, k)\n\n    # Sort the array in ascending order.\n    arr.sort()\n\n    # Return the last k elements, which are the k largest.\n    # Slicing arr[len(arr) - k:] correctly handles k=0 by returning an empty list.\n    return arr[len(arr) - k:]", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "Hu