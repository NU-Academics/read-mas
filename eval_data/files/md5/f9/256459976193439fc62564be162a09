licPattern(word_a, pattern_b)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/154", "solution": "def cycpattern_check(a , b):\n    \"\"\"You are given 2 words. You need to return True if the second word or any of its rotations is a substring in the first word.\"\"\"\n\n    if not b:\n        return True\n    if not a:\n        return False\n    if len(b) > len(a):\n        return False\n\n    b_doubled = b + b\n    for i in range(len(b)):\n        rotation = b_doubled[i : i + len(b)]\n        if rotation in a:\n            return True\n\n    return False", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/155": [{"task_id": "HumanEval/155", "solution": "def even_odd_count(num):\n    \"\"\"Given an integer. return a tuple that has the number of even and odd digits respectively.\"\"\"\n    even_count = 0\n    odd_count = 0\n    abs_num_str = str(abs(num)) # Convert absolute value of number to string to iterate digits.\n\n    for digit_char in abs_num_str:\n        digit = int(digit_char)\n        if digit % 2 == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n    return (even_count, odd_count)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/155", "solution": "def even_odd_count(num: int) -> tuple[int, int]:\n    \"\"\"Given an integer, returns a tuple that has the number of even and odd digits respectively.\n    Negative numbers are processed by considering their absolute value.\n    \"\"\"\n    abs_num = abs(num)\n    even_count = 0\n    odd_count = 0\n\n    if abs_num == 0:\n        return (1, 0) # Special case: 0 is considered an even digit.\n\n    while abs_num > 0:\n        digit = abs_num % 10\n        if digit % 2 == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n        abs_num //= 10\n\n    return (even_count, o