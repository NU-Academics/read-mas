{"task_id": "Mbpp/448", "solution": "_perrin_value_cache = {}\n_perrin_sum_cache = {}\ndef _get_perrin_value(k: int) -> int:\n    \"\"\"Calculates the k-th Perrin number, caching results.\"\"\"\n    if k in _perrin_value_cache:\n        return _perrin_value_cache[k]\n\n    if k == 0:\n        val = 3\n    elif k == 1:\n        val = 0\n    elif k == 2:\n        val = 2\n    else:\n        # P(k) = P(k-2) + P(k-3)\n        # a, b, c represent P(i-3), P(i-2), P(i-1) respectively.\n        a, b, c = 3, 0, 2\n        for _ in range(3, k + 1):\n            a, b, c = b, c, a + b\n        val = c\n\n    _perrin_value_cache[k] = val\n    return val\ndef cal_sum(n: int) -> int:\n    \"\"\"Calculates the sum of Perrin numbers from P(0) to P(n) inclusive, using caching.\"\"\"\n    if n in _perrin_sum_cache:\n        return _perrin_sum_cache[n]\n\n    total_sum = 0\n    for i in range(n + 1):\n        total_sum += _get_perrin_value(i)\n\n    _perrin_sum_cache[n] = total_sum\n    return total_sum"}
