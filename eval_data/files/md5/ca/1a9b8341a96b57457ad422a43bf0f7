{"task_id": "Mbpp/465", "solution": "from collections.abc import Mapping, Iterable\nfrom typing import Any, Dict, Optional, Callable\ndef drop_empty(items: Mapping[str, Any], remove_values: Optional[Iterable[Any]] = None, predicate: Optional[Callable[[Any], bool]] = None) -> Dict[str, Any]:\n    \"\"\"\n    Drops empty items from a dictionary based on specified criteria.\n    By default, only None values are considered empty.\n    \"\"\"\n    result = {}\n\n    # Define an inline helper for the emptiness check, prioritizing predicate, then remove_values, then default None check.\n    def _is_empty(value: Any) -> bool:\n        if predicate is not None:\n            return predicate(value)\n        elif remove_values is not None:\n            return any(rv == value for rv in remove_values)\n        else:\n            return value is None\n\n    # Iterate through the input dictionary and build a new dictionary with non-empty items.\n    for key, value in items.items():\n        if not _is_empty(value):\n            result[key] = value\n\n    return result"}
{"task_id": "Mbpp/468", "solution": "def max_product(arr: list[int]) -> int:\n    \"\"\"\n    Computes the maximum product of a strictly increasing contiguous subsequence.\n    Assumes the input array is non-empty and contains only integers.\n    \"\"\"\n    if not arr:\n        raise ValueError(\"Input list must not be empty\")\n\n    n = len(arr)\n    if n == 1:\n        return arr[0]\n\n    max_overall_product = arr[0]\n    current_run_product = arr[0]\n\n    for i in range(1, n):\n        # Check if the current element extends the strictly increasing run.\n        if arr[i] > arr[i - 1]:\n            current_run_product *= arr[i]\n        else:\n            # If not strictly increasing, reset the current run product to the current element.\n            current_run_product = arr[i]\n\n        # Update the maximum product found so far.\n        if current_run_product > max_overall_product:\n            max_overall_product = current_run_product\n\n    return max_overall_product"}
{"task_id": "Mbpp/472", "solution": "def check_Consecutive(numbers):\n    \"\"\"\n    Checks if a list of numbers contains consecutive integers, regardless of order.\n    Duplicates are not allowed.\n    \"\"\"\n    if not numbers:\n        return False\n    if len(numbers) == 1:\n        return True\n\n    unique_numbers = set(numbers)\n\n    # If there are duplicates, it's not consecutive.\n    if len(unique_numbers) != len(numbers):\n        return False\n\n    min_val = min(unique_numbers)\n    max_val = max(unique_numbers)\n\n    # A sequence is consecutive if the difference between max and min\n    # plus one equals the count of unique numbers.\n    return (max_val - min_val + 1) == len(unique_numbers)"}
{"task_id": "Mbpp/471", "solution": "def find_remainder(numbers, modulus):\n    \"\"\"\n    Compute the product of the given numbers modulo modulus.\n\n    numbers: an iterable of integers (or values convertible to int).\n    modulus: positive integer > 0.\n\n    Returns an int in range [0, modulus-1].\n    \"\"\"\n    # Validate modulus\n    try:\n        m = int(modulus)\n    except Exception:\n        raise TypeError(\"modulus must be an integer\")\n    if m <= 0:\n        raise ValueError(\"modulus must be > 0\")\n\n    # Validate numbers is iterable\n    try:\n        iterator = iter(numbers)\n    except TypeError:\n        raise TypeError(\"numbers must be an iterable of integers\")\n\n    product = 1 % m  # multiplicative identity reduced modulo m\n    for item in iterator:\n        try:\n            val = int(item)\n        except Exception:\n            raise TypeError(\"all elements in numbers must be integers or convertible to int\")\n        product = (product * (val % m)) % m\n\n    return product"}
