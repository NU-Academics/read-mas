{"task_id": "Mbpp/264", "solution": "def dog_age(human_years: int) -> float:\n    \"\"\"\n    Calculates a dog's age in dog years based on human years.\n    Uses the mapping: first two years = 10.5 each, subsequent years = 4 each.\n    \"\"\"\n    if not isinstance(human_years, int):\n        raise TypeError(\"human_years must be an integer\")\n    if human_years <= 0:\n        raise ValueError(\"human_years must be a positive integer\")\n\n    if human_years == 1:\n        return 10.5\n    if human_years == 2:\n        return 21.0\n    return 21.0 + 4.0 * (human_years - 2)"}
{"task_id": "Mbpp/259", "solution": "def maximize_elements(a, b):\n    \"\"\"\n    Compute the element-wise maximum of two sequences of 2-element tuples.\n\n    Example:\n        maximize_elements(((1, 3), (4, 5)), ((6, 7), (3, 9))) -> ((6, 7), (4, 9))\n    \"\"\"\n    # Basic shape checks\n    if not hasattr(a, \"__len__\") or not hasattr(b, \"__len__\"):\n        raise TypeError(\"Both inputs must be sequences (e.g. tuple or list).\")\n    if len(a) != len(b):\n        raise ValueError(\"Input sequences must have the same length.\")\n\n    result = []\n    for i, (pa, pb) in enumerate(zip(a, b)):\n        # Ensure each element is a 2-element sequence\n        try:\n            if len(pa) != 2 or len(pb) != 2:\n                raise ValueError(f\"Elements at index {i} must be length-2 sequences.\")\n        except TypeError:\n            raise TypeError(f\"Elements at index {i} must be sequences (e.g. tuple/list) of length 2.\")\n\n        # Compute element-wise maxima, raising a clear error if values are not comparable\n        try:\n            first_max = pa[0] if pa[0] >= pb[0] else pb[0]\n            second_max = pa[1] if pa[1] >= pb[1] else pb[1]\n        except Exception as exc:\n            raise TypeError(f\"Values at index {i} are not comparable: {exc}\")\n\n        result.append((first_max, second_max))\n\n    return tuple(result)"}
{"task_id": "Mbpp/260", "solution": "def newman_prime(n: int) -> int:\n    \"\"\"\n    Returns the nth Newman\u2013Shanks\u2013Williams number for a zero-based index n.\n    Computes NSW(n) using the recurrence relation: NSW(n) = 2*NSW(n-1) + NSW(n-2)\n    with base cases NSW(0)=1, NSW(1)=1.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n    if n < 0:\n        raise ValueError(\"n must be >= 0\")\n\n    if n <= 1:\n        return 1\n\n    a, b = 1, 1  # NSW(0), NSW(1)\n    for _ in range(2, n + 1):\n        a, b = b, 2 * b + a\n\n    return b"}
{"task_id": "Mbpp/265", "solution": "def list_split(items: list, n: int) -> list[list]:\n    \"\"\"Splits a list into n sublists, distributing elements by index modulo n.\"\"\"\n    groups: list[list] = [[] for _ in range(n)]\n    for idx, item in enumerate(items):\n        groups[idx % n].append(item)\n    return groups"}
{"task_id": "Mbpp/270", "solution": "def sum_even_and_even_index(numbers: list) -> int:\n    \"\"\"\n    Calculates the sum of even numbers found at even positions (0-indexed) within a list.\n\n    Parameters:\n    - numbers: list of integers\n\n    Returns:\n    - int: sum of elements that are even and located at even indices\n\n    Raises:\n    - TypeError: if numbers is not a list\n    - ValueError: if any element in numbers is not an int\n    \"\"\"\n    if not isinstance(numbers, list):\n        raise TypeError(\"Input must be a list of integers.\")\n    total_sum = 0\n    for index, number in enumerate(numbers):\n        if not isinstance(number, int):\n            raise ValueError(f\"All elements must be integers. Found {type(number).__name__} at index {index}.\")\n        if index % 2 == 0 and number % 2 == 0:\n            total_sum += number\n    return total_sum"}
