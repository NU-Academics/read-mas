{"task_id": "Mbpp/128", "solution": "import re\ndef long_words(n: int, text: str, lower: bool = False) -> list[str]:\n    \"\"\"\n    Finds words longer than n characters from a given text.\n    Words are separated by whitespace and stripped of common leading/trailing punctuation.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n    if n < 0:\n        raise ValueError(\"n must be non-negative\")\n    if not isinstance(text, str):\n        raise TypeError(\"text must be a string\")\n\n    DEFAULT_PUNCT_CHARS = '.,;:\"\\\\\\'()[]{}<>!?'\n\n    raw_tokens = re.split(r'\\s+', text.strip())\n\n    tokens = []\n    for raw_token in raw_tokens:\n        stripped_token = raw_token.strip(DEFAULT_PUNCT_CHARS)\n        if stripped_token:\n            tokens.append(stripped_token)\n\n    result = []\n    for token in tokens:\n        comparison_token = token.lower() if lower else token\n        if len(comparison_token) > n:\n            result.append(comparison_token if lower else token)\n\n    return result"}
{"task_id": "Mbpp/130", "solution": "def max_occurrences(items):\n    \"\"\"\n    Finds the item with the maximum frequency in a given list.\n    In case of ties for maximum frequency, the first item with that frequency encountered\n    in the list iteration order wins.\n\n    Returns None for empty input.\n    \"\"\"\n    if not items:\n        return None\n\n    counts = {}\n    try:\n        # Attempt to count frequencies using a dictionary (requires hashable items)\n        for item in items:\n            counts[item] = counts.get(item, 0) + 1\n\n        # Determine max, tie-break by first occurrence\n        max_count = -1\n        max_item = None\n        seen_items_for_tie_breaking = set()\n\n        for item in items:\n            if item in seen_items_for_tie_breaking:\n                continue\n            seen_items_for_tie_breaking.add(item)\n\n            c = counts[item]\n            if c > max_count:\n                max_count = c\n                max_item = item\n\n        return max_item\n\n    except TypeError:\n        # Fallback for unhashable items using an O(N^2) comparison approach.\n        # This preserves the \"first encountered\" tie-breaking rule.\n        max_count = -1\n        max_item = None\n\n        for i in range(len(items)):\n            current_candidate = items[i]\n            current_candidate_count = 0\n\n            for j in range(len(items)):\n                if items[j] == current_candidate:\n                    current_candidate_count += 1\n\n            if current_candidate_count > max_count:\n                max_count = current_candidate_count\n                max_item = current_candidate\n\n        return max_item"}
{"task_id": "Mbpp/129", "solution": "from collections.abc import Iterable\nclass MagicSquareError(Exception):\n    \"\"\"Base exception for magic square operations.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\nclass ValidationError(MagicSquareError):\n    \"\"\"Exception raised for invalid input matrices.\"\"\"\n    pass\nclass ServiceError(MagicSquareError):\n    \"\"\"Exception raised for internal service failures.\"\"\"\n    pass\nclass MatrixModel:\n    \"\"\"Encapsulates matrix data and provides accessors for rows, columns, and diagonals.\"\"\"\n    def __init__(self, matrix: list):\n        self._matrix = [list(row) for row in matrix]\n\n    def size(self) -> int:\n        \"\"\"Returns the dimension n of the n x n matrix.\"\"\"\n        return len(self._matrix)\n\n    def flattened(self) -> list:\n        \"\"\"Returns a single list of all elements in row-major order.\"\"\"\n        return [val for row in self._matrix for val in row]\n\n    def row(self, i: int) -> list:\n        \"\"\"Returns the i-th row (0-indexed) as a new list.\"\"\"\n        return list(self._matrix[i])\n\n    def col(self, j: int) -> list:\n        \"\"\"Returns the j-th column (0-indexed) as a new list.\"\"\"\n        return [row[j] for row in self._matrix]\n\n    def diag(self, primary: bool = True) -> list:\n        \"\"\"Returns elements of the primary (top-left to bottom-right) or secondary diagonal.\"\"\"\n        n = self.size()\n        if primary:\n            return [self._matrix[i][i] for i in range(n)]\n        return [self._matrix[i][n - 1 - i] for i in range(n)]\n\n    def get_matrix(self) -> list:\n        \"\"\"Returns a deep copy of the underlying matrix.\"\"\"\n        return [list(row) for row in self._matrix]\nclass MatrixValidator:\n    \"\"\"Validates input matrix for shape and element types.\"\"\"\n    def validate(self, matrix) -> MatrixModel:\n        \"\"\"Validates the matrix and returns a MatrixModel if valid.\"\"\"\n        if not isinstance(matrix, list):\n            raise ValidationError(\"matrix must be a list of lists\")\n        if not matrix:\n            raise ValidationError(\"matrix must not be empty\")\n\n        row_lengths = []\n        for row_index, row in enumerate(matrix):\n            if not isinstance(row, list):\n                raise ValidationError(\"each row must be a list\")\n            if not row:\n                raise ValidationError(\"rows must not be empty\")\n            row_lengths.append(len(row))\n\n        if len(set(row_lengths)) != 1:\n            raise ValidationError(\"all rows must have the same length\")\n\n        if len(matrix) != row_lengths[0]:\n            raise ValidationError(\"matrix must be square (n x n)\")\n\n        flat_elements = [x for row in matrix for x in row]\n        if not all(isinstance(x, int) for x in flat_elements):\n            raise ValidationError(\"all elements must be integers\")\n\n        return MatrixModel(matrix)\nclass MathUtils:\n    \"\"\"Utility class for mathematical operations.\"\"\"\n    @staticmethod\n    def safe_sum(values: Iterable[int]) -> int:\n        \"\"\"Sums iterable of integers, raising an error if non-integers are found.\"\"\"\n        total = 0\n        for v in values:\n            if not isinstance(v, int):\n                raise ServiceError(f\"non-integer element '{v}' encountered during sum calculation\")\n            total += v\n        return total\n\n    @staticmethod\n    def expected_consecutive_set(n: int) -> set:\n        \"\"\"Generates the set of integers from 1 to n*n.\"\"\"\n        return set(range(1, n * n + 1))\nclass MagicSquareService:\n    \"\"\"Implements the core logic to determine if a matrix is a magic square.\"\"\"\n    def is_magic_square(self, matrix_model: MatrixModel, require_consecutive: bool = True) -> bool:\n        \"\"\"Checks if the given MatrixModel represents a magic square.\"\"\"\n        n = matrix_model.size()\n        if n == 0:\n            raise ServiceError(\"Matrix model represents an empty matrix\")\n\n        magic_const = MathUtils.safe_sum(matrix_model.row(0))\n\n        for i in range(n):\n            if MathUtils.safe_sum(matrix_model.row(i)) != magic_const:\n                return False\n\n        for j in range(n):\n            if MathUtils.safe_sum(matrix_model.col(j)) != magic_const:\n                return False\n\n        if MathUtils.safe_sum(matrix_model.diag(True)) != magic_const:\n            return False\n        if MathUtils.safe_sum(matrix_model.diag(False)) != magic_const:\n            return False\n\n        if require_consecutive:\n            expected_set = MathUtils.expected_consecutive_set(n)\n            actual_set = set(matrix_model.flattened())\n            if actual_set != expected_set:\n                return False\n\n        return True\nDEFAULT_REQUIRE_CONSECUTIVE = True\nclass MagicSquareAPI:\n    \"\"\"Public API for magic square testing, orchestrating validation and service logic.\"\"\"\n    @staticmethod\n    def check(matrix, require_consecutive: bool = DEFAULT_REQUIRE_CONSECUTIVE) -> bool:\n        \"\"\"Validates the input and determines if it's a magic square.\"\"\"\n        validator = MatrixValidator()\n        matrix_model = validator.validate(matrix)\n        service = MagicSquareService()\n        return service.is_magic_square(matrix_model, require_consecutive=require_consecutive)\ndef magic_square_test(matrix):\n    \"\"\"Calculates whether the given matrix is a magic square.\"\"\"\n    return MagicSquareAPI.check(matrix)"}
{"task_id": "Mbpp/131", "solution": "from typing import Iterable, Optional, FrozenSet, Set\n_DEFAULT_VOWELS: FrozenSet[str] = frozenset({'a', 'e', 'i', 'o', 'u', 'A', 'E', 'I', 'O', 'U'})\nclass _VowelConfig:\n    \"\"\"Configuration for identifying vowels, including custom vowel sets and case sensitivity.\"\"\"\n    def __init__(self, vowels: Optional[Iterable[str]] = None, case_insensitive: bool = True) -> None:\n        self.case_insensitive = case_insensitive\n        if vowels is None:\n            self._vowels = _DEFAULT_VOWELS\n        else:\n            # Assumes valid input (iterable of single-character strings) as per prompt's constraints.\n            self._vowels = frozenset(vowels)\n        self._effective_vowel_set: Optional[FrozenSet[str]] = None\n\n    def get_vowel_set(self) -> FrozenSet[str]:\n        \"\"\"Returns the effective vowel set, expanded for case-insensitivity if configured.\"\"\"\n        if self._effective_vowel_set is None:\n            if self.case_insensitive:\n                expanded_vowels = set()\n                for v in self._vowels:\n                    expanded_vowels.add(v.lower())\n                    expanded_vowels.add(v.upper())\n                self._effective_vowel_set = frozenset(expanded_vowels)\n            else:\n                self._effective_vowel_set = self._vowels\n        return self._effective_vowel_set\ndef _swap_vowels_internal(s: str, config: _VowelConfig) -> str:\n    \"\"\"Reverses the positions of vowels within a string using a two-pointer approach.\"\"\"\n    chars = list(s)\n    i, j = 0, len(chars) - 1\n    vowel_set = config.get_vowel_set()\n\n    while i < j:\n        # Move i pointer to the right until a vowel is found.\n        while i < j and chars[i] not in vowel_set:\n            i += 1\n        # Move j pointer to the left until a vowel is found.\n        while i < j and chars[j] not in vowel_set:\n            j -= 1\n\n        # If both pointers found vowels and i < j, swap them.\n        if i < j:\n            chars[i], chars[j] = chars[j], chars[i]\n            i += 1\n            j -= 1\n    return ''.join(chars)\ndef reverse_vowels(s: str) -> str:\n    \"\"\"\n    Reverses only the vowels of a given string (where 'y' is not a vowel).\n    Vowel detection is case-insensitive by default.\n    \"\"\"\n    default_config = _VowelConfig()\n    return _swap_vowels_internal(s, default_config)"}
