{"task_id": "Mbpp/141", "solution": "from typing import List, TypeVar\nT = TypeVar('T')\ndef pancake_sort(data: List[T]) -> List[T]:\n    \"\"\"Sorts a list using the pancake sort algorithm.\n    It returns a new sorted list without mutating the original input.\n    \"\"\"\n\n    def _flip(arr: List[T], i: int) -> None:\n        \"\"\"Reverses the order of elements from index 0 to i in the given list.\"\"\"\n        arr[:i + 1] = reversed(arr[:i + 1])\n\n    def _find_max_index(arr: List[T], n: int) -> int:\n        \"\"\"Finds the index of the maximum element in the first n elements of the list.\"\"\"\n        max_idx = 0\n        for k in range(1, n):\n            if arr[k] > arr[max_idx]:\n                max_idx = k\n        return max_idx\n\n    arr = list(data)  # Create a mutable copy to avoid modifying the original list.\n    n = len(arr)\n\n    # One by one reduce the current size of the array and find the maximum element\n    # in the unsorted part, move it to the end of the unsorted part.\n    for curr_size in range(n, 1, -1):\n        # Find index of the maximum element in arr[0...curr_size-1]\n        max_idx = _find_max_index(arr, curr_size)\n\n        # If max element is not already at the desired position\n        if max_idx != curr_size - 1:\n            # Move the maximum element to the beginning\n            _flip(arr, max_idx)\n            # Move the maximum element to its correct position (end of unsorted part)\n            _flip(arr, curr_size - 1)\n    return arr"}
{"task_id": "Mbpp/160", "solution": "def find_solution(a: int, b: int, n: int) -> tuple[int, int] | None:\n    \"\"\"\n    Finds integer solutions (x, y) to the linear Diophantine equation ax + by = n.\n    Returns (x, y) as a tuple, or None if no solution exists.\n    \"\"\"\n\n    # Helper function for Extended Euclidean Algorithm\n    # Returns (g, x, y) such that a_val*x + b_val*y = g = gcd(a_val, b_val)\n    def _extended_gcd(a_val: int, b_val: int) -> tuple[int, int, int]:\n        if a_val == 0:\n            return b_val, 0, 1\n\n        # Recursive call: g = gcd(b_val % a_val, a_val)\n        g, x_prime, y_prime = _extended_gcd(b_val % a_val, a_val)\n\n        # Back-substitute to find coefficients for a_val and b_val\n        x = y_prime - (b_val // a_val) * x_prime\n        y = x_prime\n\n        return g, x, y\n\n    # Validate not both zero (ambiguous/invalid equation)\n    if a == 0 and b == 0:\n        return None\n\n    # Handle simple zero-coefficient cases directly\n    if a == 0:\n        # Equation becomes b*y = n\n        if b == 0:\n            return None\n        if n % b != 0:\n            return None\n        return (0, n // b)\n    if b == 0:\n        # Equation becomes a*x = n\n        if n % a != 0:\n            return None\n        return (n // a, 0)\n\n    # Compute extended gcd on absolute values\n    g, x_coeff, y_coeff = _extended_gcd(abs(a), abs(b))\n\n    # Adjust the Bezout coefficients based on the original signs of a and b.\n    x0 = x_coeff if a >= 0 else -x_coeff\n    y0 = y_coeff if b >= 0 else -y_coeff\n\n    # If n is not divisible by g, no integer solution exists.\n    if n % g != 0:\n        return None\n\n    # Calculate a particular solution (x_p, y_p) by scaling x0 and y0.\n    scale = n // g\n    x_p = x0 * scale\n    y_p = y0 * scale\n\n    # Canonicalize for consistency: shift x into [0, |b'|-1] where b' = b/g\n    b_prime = b // g\n    abs_b_prime = abs(b_prime)\n\n    # Compute canonical target for x (smallest non-negative representative)\n    x_canonical_target = (x_p % abs_b_prime + abs_b_prime) % abs_b_prime\n\n    # Compute k to shift x_p to x_canonical_target: k = (x_canonical_target - x_p) / b_prime\n    # Use integer division; b_prime divides the difference by construction of modulo above\n    k = (x_canonical_target - x_p) // b_prime\n\n    final_x = x_p + k * b_prime\n    final_y = y_p - k * (a // g)\n\n    return (final_x, final_y)"}
{"task_id": "Mbpp/161", "solution": "from typing import List, Any, Iterable, Set\ndef remove_elements(source: Iterable[Any], to_remove: Iterable[Any]) -> List[Any]:\n    \"\"\"\n    Removes all elements from the source iterable that are present in the to_remove iterable.\n    Preserves the original order of elements from the source using a new list.\n    \"\"\"\n    source_list = list(source)\n    to_remove_list = list(to_remove)\n\n    result: List[Any] = []\n\n    try:\n        # Attempt the efficient O(N+M) path using a set for lookups.\n        # This may raise TypeError if elements in to_remove_list are unhashable.\n        lookup_set: Set[Any] = set(to_remove_list)\n        for element in source_list:\n            if element not in lookup_set:\n                result.append(element)\n        return result\n    except TypeError:\n        # Fallback to the O(N*M) path for unhashable elements using direct equality comparison.\n        result = []\n        for s_element in source_list:\n            found_in_remove = False\n            for r_element in to_remove_list:\n                if s_element == r_element:\n                    found_in_remove = True\n                    break\n            if not found_in_remove:\n                result.append(s_element)\n        return result"}
{"task_id": "Mbpp/145", "solution": "def max_Abs_Diff(seq):\n    \"\"\"\n    Finds the maximum absolute difference between any two elements in the given sequence.\n    This is computed by subtracting the minimum element from the maximum element.\n    \"\"\"\n    min_val = min(seq)\n    max_val = max(seq)\n    return abs(max_val - min_val)"}
{"task_id": "Mbpp/142", "solution": "def count_samepair(l1, l2, l3):\n    \"\"\"\n    Counts how many items are identical at the same index across three lists.\n    Compares elements up to the length of the shortest input list.\n    \"\"\"\n    count = 0\n    for a, b, c in zip(l1, l2, l3):\n        if a == b == c:\n            count += 1\n    return count"}
{"task_id": "Mbpp/162", "solution": "def sum_series(n: int) -> int:\n    \"\"\"\n    Calculates the sum (n - 2*i) from i=0 to n // 2 using an arithmetic series formula.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n    if n < 0:\n        raise ValueError(\"n must be non-negative\")\n\n    num_terms = (n // 2) + 1\n    first_term = n\n    last_term = n - 2 * (n // 2)\n\n    # Sum of an arithmetic series = num_terms * (first_term + last_term) // 2\n    return num_terms * (first_term + last_term) // 2"}
{"task_id": "Mbpp/165", "solution": "def count_char_position(s: str) -> int:\n    \"\"\"\n    Counts characters in a string that occur at the same position in the string\n    as in the English alphabet (case insensitive).\n    \"\"\"\n    if s is None:\n        raise ValueError(\"Input cannot be None\")\n    if not isinstance(s, str):\n        raise TypeError(\"Input must be a string\")\n\n    count = 0\n    alphabet = \"abcdefghijklmnopqrstuvwxyz\"\n\n    for i, char_in_string in enumerate(s):\n        lower_char = char_in_string.lower()\n        if 'a' <= lower_char <= 'z':\n            alphabet_index = alphabet.find(lower_char) + 1\n            string_position = i + 1\n            if alphabet_index == string_position:\n                count += 1\n    return count"}
{"task_id": "Mbpp/166", "solution": "from typing import Sequence\ndef find_even_pair(nums: Sequence[int]) -> int:\n    \"\"\"Counts pairs of integers in a list whose XOR is even.\"\"\"\n    def n_choose_2(n: int) -> int:\n        return (n * (n - 1)) // 2 if n >= 2 else 0\n\n    evens = 0\n    odds = 0\n    for x in nums:\n        if x & 1:\n            odds += 1\n        else:\n            evens += 1\n\n    return n_choose_2(evens) + n_choose_2(odds)"}
{"task_id": "Mbpp/167", "solution": "def next_power_of_2(n: int) -> int:\n    \"\"\"\n    Computes the smallest power of two greater than or equal to n.\n    Delegates to the NextPowerService for validation and calculation.\n    \"\"\"\n    from .service import NextPowerService\n    from .calculator import NextPowerCalculator\n    from .validator import InputValidator\n\n    service = NextPowerService(NextPowerCalculator(), InputValidator())\n    return service.compute(n)"}
