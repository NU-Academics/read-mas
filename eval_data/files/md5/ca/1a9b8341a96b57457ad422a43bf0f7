{"task_id": "Mbpp/391", "solution": "from typing import List, Dict, Any\ndef convert_list_dictionary(keys: List[str], names: List[str], values: List[Any]) -> List[Dict[str, Dict[str, Any]]]:\n    \"\"\"\n    Converts three parallel lists into a list of nested dictionaries.\n    Each element from 'keys' becomes an outer key, mapping to a dictionary with 'name' as key and 'value' as its value.\n    \"\"\"\n    result = []\n    for key, name, value in zip(keys, names, values):\n        result.append({key: {name: value}})\n    return result"}
{"task_id": "Mbpp/392", "solution": "def get_max_sum(n: int) -> int:\n    \"\"\"\n    Computes the maximum sum f(n) using the equation\n    f(n) = max(f(n//2) + f(n//3) + f(n//4) + f(n//5), n)\n\n    Uses memoization for efficiency.\n    \"\"\"\n    if not isinstance(n, int):\n        raise ValueError(\"n must be an integer\")\n    if n < 0:\n        raise ValueError(\"n must be non-negative\")\n\n    memo: dict[int, int] = {}\n\n    def _memoized_max_sum(current_n: int) -> int:\n        if current_n <= 1:\n            return current_n\n\n        if current_n in memo:\n            return memo[current_n]\n\n        sum_of_parts = (\n            _memoized_max_sum(current_n // 2)\n            + _memoized_max_sum(current_n // 3)\n            + _memoized_max_sum(current_n // 4)\n            + _memoized_max_sum(current_n // 5)\n        )\n\n        result = max(current_n, sum_of_parts)\n        memo[current_n] = result\n        return result\n\n    return _memoized_max_sum(n)"}
{"task_id": "Mbpp/395", "solution": "def first_non_repeating_character(s: str) -> str | None:\n    \"\"\"\n    Finds the first non-repeated character in a given string.\n    Returns None if no non-repeated character is found.\n    \"\"\"\n    counts = {}\n    for char in s:\n        counts[char] = counts.get(char, 0) + 1\n\n    for char in s:\n        if counts[char] == 1:\n            return char\n\n    return None"}
{"task_id": "Mbpp/394", "solution": "def check_distinct(values: tuple) -> bool:\n    \"\"\"\n    Checks if the given tuple contains no duplicate elements.\n    It uses a hash-based approach for hashable elements, falling back to pairwise comparison otherwise.\n    \"\"\"\n\n    # First, determine if all elements in the tuple are hashable.\n    # This avoids a TypeError if a set is created with unhashable items.\n    all_elements_hashable = True\n    for val in values:\n        try:\n            hash(val)\n        except TypeError:\n            all_elements_hashable = False\n            break\n\n    if all_elements_hashable:\n        # If all elements are hashable, use a set for an efficient O(N) check.\n        # A tuple has no duplicates if the size of its set representation equals its original length.\n        return len(set(values)) == len(values)\n    else:\n        # If any element is unhashable, fall back to an O(N^2) pairwise comparison.\n        # Iterate through all unique pairs to check for equality.\n        n = len(values)\n        for i in range(n):\n            for j in range(i + 1, n):\n                if values[i] == values[j]:\n                    return False  # A duplicate is found\n        return True  # No duplicates were found"}
