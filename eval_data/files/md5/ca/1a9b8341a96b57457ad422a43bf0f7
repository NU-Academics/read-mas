{"task_id": "Mbpp/425", "solution": "def count_element_in_list(lists, element) -> int:\n    \"\"\"\n    Counts the number of sublists containing a particular element.\n    Uses a layered architecture as per design specifications.\n    \"\"\"\n    import collections.abc\n\n    class InvalidInputError(Exception):\n        \"\"\"Exception raised for invalid input data.\"\"\"\n        pass\n\n    class DomainError(Exception):\n        \"\"\"Generic exception for service-level domain errors.\"\"\"\n        pass\n\n    def is_iterable(obj):\n        \"\"\"Checks if an object is iterable but not a string.\"\"\"\n        return isinstance(obj, collections.abc.Iterable) and not isinstance(obj, str)\n\n    class CountRequest:\n        \"\"\"Data Transfer Object for counting requests.\"\"\"\n        def __init__(self, lists: collections.abc.Iterable[collections.abc.Iterable], element):\n            self.lists = lists\n            self.element = element\n\n    class CountResult:\n        \"\"\"Data Transfer Object for counting results.\"\"\"\n        def __init__(self, count: int):\n            self.count = count\n\n    class ListValidator:\n        \"\"\"Validates the structure and types of the CountRequest.\"\"\"\n        def validate_request(self, request: 'CountRequest') -> None:\n            if not is_iterable(request.lists):\n                raise InvalidInputError(\"Outer 'lists' must be an iterable of iterables.\")\n            for idx, sub in enumerate(request.lists):\n                if not is_iterable(sub):\n                    raise InvalidInputError(f\"Sublist at index {idx} is not iterable.\")\n\n    class ListService:\n        \"\"\"Implements the core business logic for counting elements in lists.\"\"\"\n        def __init__(self, validator: 'ListValidator', repository=None):\n            self._validator = validator\n            self._repository = repository\n\n        def _count_from_iterable(self, sublists: collections.abc.Iterable[collections.abc.Iterable], search_element) -> int:\n            \"\"\"Core algorithm to count sublists containing the element.\"\"\"\n            count = 0\n            for sub in sublists:\n                if search_element in sub:\n                    count += 1\n            return count\n\n        def count(self, request: 'CountRequest') -> 'CountResult':\n            \"\"\"Validates the request and performs the counting operation.\"\"\"\n            try:\n                self._validator.validate_request(request)\n\n                lists_to_process = request.lists\n\n                total_count = self._count_from_iterable(lists_to_process, request.element)\n                return CountResult(total_count)\n            except InvalidInputError as e:\n                raise DomainError(f\"Validation failed: {e}\") from e\n            except Exception as e:\n                raise DomainError(f\"An unexpected error occurred during counting: {e}\") from e\n\n\n    class ListController:\n        \"\"\"Coordinates between the API layer and the service layer.\"\"\"\n        def __init__(self, service: 'ListService'):\n            self._service = service\n\n        def count(self, request: 'CountRequest') -> 'CountResult':\n            \"\"\"Delegates the counting request to the ListService.\"\"\"\n            return self._service.count(request)\n\n    # Main logic of the count_element_in_list function\n    req = CountRequest(lists=lists, element=element)\n    validator = ListValidator()\n    service = ListService(validator=validator)\n    controller = ListController(service=service)\n    result = controller.count(req)\n    return result.count"}
{"task_id": "Mbpp/427", "solution": "def change_date_format(date_iso: str) -> str:\n    \"\"\"\n    Converts a date string from yyyy-mm-dd format to dd-mm-yyyy format.\n    \"\"\"\n    year_str, month_str, day_str = date_iso.split('-')\n    year = int(year_str)\n    month = int(month_str)\n    day = int(day_str)\n    return f\"{day:02d}-{month:02d}-{year:04d}\""}
