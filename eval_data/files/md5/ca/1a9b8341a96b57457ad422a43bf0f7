{"task_id": "Mbpp/445", "solution": "from typing import Tuple, Union, Any, Iterable, Sequence, Optional\nNumber = Union[int, float]\nTuple1D = Tuple[Number, ...]\nTuple2D = Tuple[Tuple1D, ...]\nclass InvalidTupleError(Exception):\n    \"\"\"Custom exception for invalid tuple shapes or element types.\"\"\"\n    def __init__(self, message: str, details: Optional[dict] = None) -> None:\n        super().__init__(message)\n        self.message = message\n        self.details = details if details is not None else {}\ndef is_number(obj: Any) -> bool:\n    \"\"\"Checks if an object is an integer or a float.\"\"\"\n    return isinstance(obj, (int, float))\ndef to_tuple_recursive(obj: Any) -> Any:\n    \"\"\"Converts nested lists/tuples to a tuple of tuples.\"\"\"\n    if isinstance(obj, (list, tuple)):\n        return tuple(to_tuple_recursive(item) for item in obj)\n    return obj\ndef elementwise_product(a: Iterable[Number], b: Iterable[Number]) -> Tuple[Number, ...]:\n    \"\"\"Performs element-wise multiplication of two iterables.\"\"\"\n    return tuple(x * y for x, y in zip(a, b))\nclass TupleValidator:\n    \"\"\"Validates the shape and element types of nested tuple inputs.\"\"\"\n    def validate(self, a: Any, b: Any) -> Tuple[Tuple2D, Tuple2D]:\n        \"\"\"Validates and converts inputs to Tuple2D, raising InvalidTupleError on failure.\"\"\"\n        at = to_tuple_recursive(a)\n        bt = to_tuple_recursive(b)\n\n        self._validate_outer(at, bt)\n\n        for idx, (ai, bi) in enumerate(zip(at, bt)):\n            self._validate_inner(ai, bi, idx)\n        return at, bt\n\n    def _validate_outer(self, a: Sequence[Any], b: Sequence[Any]) -> None:\n        \"\"\"Validates the outer structure of the two input sequences.\"\"\"\n        if not isinstance(a, tuple) or not isinstance(b, tuple):\n            raise InvalidTupleError(\"Input must be a nested sequence (outer layer)\", details={\"type_a\": type(a), \"type_b\": type(b)})\n        if len(a) != len(b):\n            raise InvalidTupleError(\"Outer tuple lengths differ\", {\"len_a\": len(a), \"len_b\": len(b)})\n\n    def _validate_inner(self, a_item: Any, b_item: Any, idx: int) -> None:\n        \"\"\"Validates the inner structures and elements at a given index.\"\"\"\n        if not isinstance(a_item, tuple) or not isinstance(b_item, tuple):\n            raise InvalidTupleError(f\"Inner element at index {idx} is not a sequence\", {\"index\": idx, \"type_a_item\": type(a_item), \"type_b_item\": type(b_item)})\n\n        if len(a_item) != len(b_item):\n            raise InvalidTupleError(\"Inner tuple lengths differ\", {\"index\": idx, \"len_a_inner\": len(a_item), \"len_b_inner\": len(b_item)})\n\n        for j, val_a in enumerate(a_item):\n            val_b = b_item[j]\n            if not is_number(val_a) or not is_number(val_b):\n                raise InvalidTupleError(\"Non-numeric element found\", {\"outer_index\": idx, \"inner_index\": j, \"value_a\": val_a, \"value_b\": val_b})\nclass IndexMultiplierService:\n    \"\"\"Core business logic for index-wise tuple multiplication.\"\"\"\n    def __init__(self, validator: TupleValidator) -> None:\n        self._validator = validator\n\n    def multiply(self, a: Any, b: Any) -> Tuple2D:\n        \"\"\"Validates inputs and computes the element-wise product of inner tuples.\"\"\"\n        a_t, b_t = self._validator.validate(a, b)\n        results = tuple(\n            elementwise_product(ai, bi)\n            for ai, bi in zip(a_t, b_t)\n        )\n        return results\ndef index_multiplication(a: Tuple[Tuple[Number,...], ...], b: Tuple[Tuple[Number,...], ...]) -> Tuple[Tuple[Number,...], ...]:\n    \"\"\"\n    Performs index-wise multiplication of tuple elements in two given tuples of tuples.\n    Raises InvalidTupleError for shape mismatches or non-numeric elements.\n    \"\"\"\n    validator = TupleValidator()\n    service = IndexMultiplierService(validator)\n    return service.multiply(a, b)"}
{"task_id": "Mbpp/440", "solution": "import re\nimport string\nfrom dataclasses import dataclass\nfrom typing import List, Optional, Set, Tuple\nWORD_RE = re.compile(r\"[A-Za-z0-9'\\-]+\")\nclass Tokenizer:\n    \"\"\"Tokenizes text into word-like units, preserving original indices.\"\"\"\n    def tokenize(self, text: str) -> List[Token]:\n        tokens = []\n        for m in WORD_RE.finditer(text):\n            tokens.append(Token(text=m.group(0), start=m.start(), end=m.end()))\n        return tokens\nclass Normalizer:\n    \"\"\"Normalizes token text by lowercasing and stripping punctuation.\"\"\"\n    def strip_punctuation(self, s: str) -> str:\n        return s.strip(string.punctuation + \"\u201c\u201d\u2018\u2019\")\n\n    def normalize(self, token_text: str) -> str:\n        if not token_text:\n            raise ValueError(\"empty token\")\n        return self.strip_punctuation(token_text).lower()\nDEFAULT_EXCEPTIONS = {\"sly\", \"fly\", \"apply\"}\nclass AdverbRepository:\n    \"\"\"Determines if a word is an adverb based on suffix patterns and exceptions.\"\"\"\n    def __init__(self, exceptions: Optional[Set[str]] = None, suffix_patterns: Optional[List[str]] = None):\n        self.exceptions = exceptions or DEFAULT_EXCEPTIONS\n        self.suffix_patterns = [re.compile(pat + r\"$\", re.I) for pat in (suffix_patterns or [r\".*ly\"])]\n\n    def is_adverb(self, word: str) -> bool:\n        if not word:\n            return False\n        w = word.lower()\n        if w in self.exceptions:\n            return False\n        for pat in self.suffix_patterns:\n            if pat.match(w):\n                return True\n        return False\nclass AdverbService:\n    \"\"\"Orchestrates tokenization, normalization, and adverb detection.\"\"\"\n    def __init__(self, tokenizer: Tokenizer, normalizer: Normalizer, repo: AdverbRepository):\n        self.tokenizer = tokenizer\n        self.normalizer = normalizer\n        self.repo = repo\n\n    def find_first_adverb(self, text: str) -> AdverbMatch:\n        if not isinstance(text, str):\n            raise TypeError(\"text must be str\")\n        tokens = self.tokenizer.tokenize(text)\n        for t in tokens:\n            norm = self.normalizer.normalize(t.text)\n            if self.repo.is_adverb(norm):\n                return AdverbMatch(start=t.start, end=t.end, token=norm)\n        raise ValueError(\"No adverb found\")\nclass AdverbController:\n    \"\"\"Provides the public API for finding adverbs.\"\"\"\n    def __init__(self, service: AdverbService):\n        self.service = service\n\n    def find_adverb_position(self, text: str) -> Tuple[int, int, str]:\n        match = self.service.find_first_adverb(text)\n        return match.to_tuple()\ndef find_adverb_position(text: str) -> Tuple[int, int, str]:\n    \"\"\"Finds the first adverb and its positions in a given sentence.\"\"\"\n    service = AdverbService(Tokenizer(), Normalizer(), AdverbRepository())\n    controller = AdverbController(service)\n    return controller.find_adverb_position(text)"}
