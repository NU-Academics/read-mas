{"task_id": "Mbpp/641", "solution": "import json\nimport os\nimport logging\nfrom typing import Optional, Any, Dict\n_logger = logging.getLogger(__name__)\nclass NonagonalError(Exception):\n    \"\"\"Custom exception for nonagonal number related errors.\"\"\"\n    def __init__(self, code: str, message: Optional[str] = None) -> None:\n        self.code = code\n        self.message = message if message is not None else code\n        super().__init__(self.message)\n\n    def __str__(self) -> str:\n        return f\"[{self.code}] {self.message}\"\ndef parse_int(value: Any) -> int:\n    \"\"\"Parses an input value into an integer.\"\"\"\n    if isinstance(value, int):\n        return value\n    if isinstance(value, str):\n        if value.strip().lstrip(\"+-\").isdigit():\n            return int(value)\n    raise NonagonalError(\"InvalidInput\", f\"Cannot parse {value!r} as integer\")\nclass NonagonalCalculator:\n    \"\"\"Calculates nonagonal numbers.\"\"\"\n    def compute(self, n: int) -> int:\n        \"\"\"Computes the nth nonagonal number using the formula (7n^2 - 5n) / 2.\"\"\"\n        result = (7 * n * n - 5 * n) // 2\n        return int(result)\nCACHE_PATH: str = \"data/cache.json\"\nCACHE_ENABLED: bool = True\nclass NonagonalRepository:\n    \"\"\"Manages caching of nonagonal numbers, including optional persistence to a JSON file.\"\"\"\n    def __init__(self, path: str = CACHE_PATH, enabled: bool = CACHE_ENABLED) -> None:\n        self._cache: Dict[str, int] = {}\n        self._path = path\n        self._enabled = enabled\n        if self._enabled:\n            self.load_cache()\n\n    def get(self, n: int) -> Optional[int]:\n        \"\"\"Returns the cached nonagonal number for n, or None if not found.\"\"\"\n        return self._cache.get(str(n))\n\n    def set(self, n: int, value: int) -> None:\n        \"\"\"Stores the nonagonal number in cache and attempts to persist it.\"\"\"\n        self._cache[str(n)] = value\n        if self._enabled:\n            self.save_cache()\n\n    def load_cache(self) -> None:\n        \"\"\"Loads the cache from the JSON file.\"\"\"\n        if not os.path.exists(self._path):\n            return\n\n        try:\n            with open(self._path, 'r', encoding='utf-8') as f:\n                data = json.load(f)\n                self._cache = {k: int(v) for k, v in data.items()}\n        except (IOError, json.JSONDecodeError) as e:\n            _logger.warning(f\"Failed to load cache from {self._path}: {e}\")\n            self._cache = {}\n\n    def save_cache(self) -> None:\n        \"\"\"Saves the current cache to the JSON file.\"\"\"\n        os.makedirs(os.path.dirname(self._path), exist_ok=True)\n        try:\n            with open(self._path, 'w', encoding='utf-8') as f:\n                json.dump(self._cache, f)\n        except IOError as e:\n            _logger.warning(f\"Failed to save cache to {self._path}: {e}\")\nclass NonagonalController:\n    \"\"\"Orchestrates parsing, validation, caching, and computation of nonagonal numbers.\"\"\"\n    def __init__(self, calculator: Optional[NonagonalCalculator] = None,\n                 repository: Optional[NonagonalRepository] = None) -> None:\n        self.calculator = calculator if calculator is not None else NonagonalCalculator()\n        self.repository = repository if repository is not None else NonagonalRepository()\n\n    def compute(self, n_input: Any) -> int:\n        \"\"\"Accepts any input, parses, validates, checks cache, computes if needed, and returns the result.\"\"\"\n        n = parse_int(n_input)\n        validate_n(n)\n\n        cached_value = self.repository.get(n)\n        if cached_value is not None:\n            return cached_value\n\n        result = self.calculator.compute(n)\n        self.repository.set(n, result)\n        return result\n_controller = NonagonalController()\ndef is_nonagonal(n: int) -> int:\n    \"\"\"\n    Public API: returns the nth nonagonal number.\n    Raises NonagonalError for invalid input.\n    \"\"\"\n    return _controller.compute(n)"}
{"task_id": "Mbpp/644", "solution": "def reverse_Array_Upto_K(arr, k):\n    \"\"\"\n    Reverses the first 'k' elements of an array and returns a new list.\n    The original array remains unchanged.\n    \"\"\"\n    result = list(arr)  # Create a shallow copy to avoid modifying the original array.\n\n    start = 0\n    end = k - 1\n\n    while start < end:\n        result[start], result[end] = result[end], result[start]\n        start += 1\n        end -= 1\n\n    return result"}
{"task_id": "Mbpp/722", "solution": "def filter_data(data: dict[str, tuple[float, float]], min_height: float, min_weight: float) -> dict[str, tuple[float, float]]:\n    \"\"\"Filters students whose height and weight are strictly above the given minimums.\"\"\"\n    filtered_students = {}\n    for student_name, (student_height, student_weight) in data.items():\n        if student_height > min_height and student_weight > min_weight:\n            filtered_students[student_name] = (student_height, student_weight)\n    return filtered_students"}
{"task_id": "Mbpp/720", "solution": "def add_dict_to_tuple(input_tuple: tuple, input_dict: dict) -> tuple:\n    \"\"\"Appends a dictionary as a single element to a tuple and returns a new tuple.\n\n    The returned tuple preserves the original elements and adds the dictionary at the end.\n    \"\"\"\n    result = input_tuple + (input_dict,)\n    return result"}
{"task_id": "Mbpp/721", "solution": "def maxAverageOfPath(matrix: list[list[int]]) -> float:\n    \"\"\"\n    Calculates the maximum average cost of a path from the top-left to the bottom-right cell\n    of a square matrix, moving only right or down.\n    \"\"\"\n    n = len(matrix)\n\n    # Handle edge case for an empty matrix, though N*N implies N >= 1\n    if n == 0:\n        return 0.0\n\n    # Initialize a DP table to store the maximum sum to reach each cell.\n    # dp_sum[r][c] will hold the maximum sum path from (0,0) to (r,c).\n    dp_sum = [[0.0 for _ in range(n)] for _ in range(n)]\n\n    # Base case: The cost to reach the starting cell (0,0) is its own value.\n    dp_sum[0][0] = float(matrix[0][0])\n\n    # Fill the first row of the DP table.\n    # Cells in the first row can only be reached by moving right from the previous cell.\n    for c in range(1, n):\n        dp_sum[0][c] = dp_sum[0][c-1] + float(matrix[0][c])\n\n    # Fill the first column of the DP table.\n    # Cells in the first column can only be reached by moving down from the previous cell.\n    for r in range(1, n):\n        dp_sum[r][0] = dp_sum[r-1][0] + float(matrix[r][0])\n\n    # Fill the rest of the DP table.\n    # For any other cell (r,c), the maximum sum path to it comes either from the cell above (r-1,c)\n    # or from the cell to the left (r,c-1), plus the current cell's cost.\n    for r in range(1, n):\n        for c in range(1, n):\n            dp_sum[r][c] = max(dp_sum[r-1][c], dp_sum[r][c-1]) + float(matrix[r][c])\n\n    # The total cost of the path with the maximum sum is at the bottom-right cell.\n    total_cost = dp_sum[n-1][n-1]\n\n    # The number of cells visited in any path from top-left to bottom-right in an N*N grid\n    # by moving only right or down is always fixed: 2*N - 1.\n    path_length = (2 * n) - 1\n\n    # Calculate the maximum average.\n    max_average = total_cost / path_length\n\n    return max_average"}
{"task_id": "Mbpp/724", "solution": "def power_base_sum(base: int, power: int) -> int:\n    \"\"\"\n    Computes the sum of the decimal digits of base raised to the power.\n    Handles non-negative power, uses absolute value of the result for digit summing.\n    \"\"\"\n    result = base ** power\n    return sum(int(digit) for digit in str(abs(result)))"}
{"task_id": "Mbpp/725", "solution": "from typing import List\nimport re\ndef extract_quotation(text: str) -> List[str]:\n    \"\"\"\n    Extract all substrings enclosed in double quotation marks from the given text.\n\n    Example:\n        extract_quotation('Cortex \"A53\" Based \"multi\" tasking \"Processor\"')\n        -> ['A53', 'multi', 'Processor']\n    \"\"\"\n    if not isinstance(text, str):\n        raise ValueError(\"text must be a str\")\n\n    pattern = re.compile(r'\"([^\"]*)\"')\n    return [m.group(1) for m in pattern.finditer(text)]"}
{"task_id": "Mbpp/723", "solution": "def count_same_pair(list_a, list_b):\n    \"\"\"Counts indices where two lists of the same length have identical values.\"\"\"\n    count = 0\n    # Iterate through the lists and compare elements at each corresponding index.\n    for i in range(len(list_a)):\n        if list_a[i] == list_b[i]:\n            count += 1\n    return count"}
{"task_id": "Mbpp/726", "solution": "def multiply_elements(numbers_tuple: tuple) -> tuple:\n    \"\"\"\n    Calculates the product of adjacent elements in the input tuple.\n    Returns a new tuple where the i-th element is numbers_tuple[i] * numbers_tuple[i+1].\n    \"\"\"\n    return tuple(numbers_tuple[i] * numbers_tuple[i+1] for i in range(len(numbers_tuple) - 1))"}
{"task_id": "Mbpp/728", "solution": "def sum_list(a, b):\n    \"\"\"Calculates the element-wise sum of two lists.\n    Assumes inputs are lists of numbers of equal length.\n    \"\"\"\n    return [x + y for x, y in zip(a, b)]"}
{"task_id": "Mbpp/730", "solution": "def consecutive_duplicates(lst):\n    \"\"\"Removes consecutive duplicate elements from a list, preserving order.\n    Returns a new list with the duplicates removed.\n    \"\"\"\n    result = []\n    if not lst:\n        return result\n\n    iterator = iter(lst)\n    prev = next(iterator)\n    result.append(prev)\n\n    for item in iterator:\n        if item != prev:\n            result.append(item)\n        prev = item\n    return result"}
{"task_id": "Mbpp/732", "solution": "def replace_specialchar(text):\n    \"\"\"Replaces spaces, commas, and dots with colons using a translation table.\"\"\"\n    trans = str.maketrans({\" \": \":\", \",\": \":\", \".\": \":\"})\n    return text.translate(trans)"}
{"task_id": "Mbpp/731", "solution": "import math\ndef lateralsurface_cone(r, h):\n    \"\"\"\n    Calculates the lateral surface area of a cone.\n    Validates that radius and height are non-negative numeric values.\n    \"\"\"\n    try:\n        radius_float = float(r)\n    except (TypeError, ValueError):\n        raise ValueError(\"radius must be a numeric value\")\n    if radius_float < 0:\n        raise ValueError(\"radius must be non-negative\")\n\n    try:\n        height_float = float(h)\n    except (TypeError, ValueError):\n        raise ValueError(\"height must be a numeric value\")\n    if height_float < 0:\n        raise ValueError(\"height must be non-negative\")\n\n    if radius_float == 0:\n        return 0.0\n\n    slant_height = math.sqrt(radius_float**2 + height_float**2)\n    lateral_surface_area = math.pi * radius_float * slant_height\n\n    return lateral_surface_area"}
{"task_id": "Mbpp/733", "solution": "def find_first_occurrence(array: list[int], target: int) -> int:\n    \"\"\"\n    Return the index of the first occurrence of target in a sorted array.\n    If target is not found, return -1.\n    \"\"\"\n    low, high = 0, len(array) - 1\n    result = -1\n\n    while low <= high:\n        mid = (low + high) // 2\n        val = array[mid]\n        if val == target:\n            result = mid\n            high = mid - 1  # continue search on left half for earlier occurrence\n        elif val < target:\n            low = mid + 1\n        else:\n            high = mid - 1\n    return result"}
{"task_id": "Mbpp/736", "solution": "from typing import Sequence, Callable, Optional, TypeVar, Any\nT = TypeVar(\"T\")\nK = TypeVar(\"K\")\ndef left_insertion(seq: Sequence[T], value: T, key: Optional[Callable[[T], K]] = None) -> int:\n    \"\"\"\n    Locates the left insertion point for a specified value in a sorted sequence using binary search.\n    The returned index 'i' is such that inserting value at 'i' preserves sorted order (i.e., it's the\n    first index where seq[i] >= value, considering the key if provided).\n    \"\"\"\n    target_key = key(value) if key else value\n    low = 0\n    high = len(seq)\n\n    while low < high:\n        mid = (low + high) // 2\n        mid_val_effective = key(seq[mid]) if key else seq[mid]\n\n        if mid_val_effective < target_key:\n            low = mid + 1\n        else:\n            high = mid\n\n    return low"}
{"task_id": "Mbpp/734", "solution": "def sum_Of_Subarray_Prod(nums: list) -> int:\n    \"\"\"\n    Calculates the sum of products of all contiguous sublists (subarrays) of a given list.\n    Uses a linear-time dynamic programming approach.\n    \"\"\"\n    total = 0\n    last_sum = 0\n    for x in nums:\n        # last_sum accumulates the sum of products for all sublists ending at x\n        # x itself is a sublist product\n        # x * last_sum extends previous sublists ending at previous element with x\n        last_sum = x + x * last_sum\n        total += last_sum\n    return total"}
{"task_id": "Mbpp/735", "solution": "def toggle_middle_bits(n: int) -> int:\n    \"\"\"Toggles bits of the number except the first (MSB) and the last (LSB) bit.\"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an int\")\n    if n < 0:\n        raise ValueError(\"n must be non-negative\")\n\n    bit_len = n.bit_length()\n    if bit_len == 0:  # for n == 0, treat as single bit\n        bit_len = 1\n\n    # If the number has 2 or fewer bits, there are no middle bits to toggle.\n    if bit_len <= 2:\n        return n\n\n    # Create a mask with 1s for all bits except the MSB and LSB.\n    # Lower (bit_len - 1) bits set: (1 << (bit_len - 1)) - 1\n    # Clear LSB from that: ^ 1\n    mask = ((1 << (bit_len - 1)) - 1) ^ 1\n\n    # XOR the original number with the mask to invert only the middle bits.\n    return n ^ mask"}
{"task_id": "Mbpp/737", "solution": "def check_str(text: str) -> bool:\n    \"\"\"\n    Checks if a given string starts with a vowel (a, e, i, o, u, case-insensitive).\n    This function orchestrates validation and regex matching through internal components.\n    \"\"\"\n    import re\n    from dataclasses import dataclass\n    from typing import Optional\n\n    class VowelCheckerError(Exception):\n        \"\"\"Custom exception for VowelChecker related errors.\"\"\"\n        def __init__(self, message: str, cause: Optional[Exception] = None) -> None:\n            super().__init__(message)\n            self.message = message\n            self.cause = cause\n\n    VOWEL_PATTERN: str = r'^[aeiou]'\n\n    def normalize_text(text: str) -> str:\n        \"\"\"Trims leading and trailing whitespace from the text.\"\"\"\n        return text.strip()\n\n    class StringValidator:\n        \"\"\"Validates and normalizes input strings.\"\"\"\n        def validate(self, text: str) -> str:\n            if not isinstance(text, str):\n                raise VowelCheckerError(\"Input must be a string\")\n            normalized = normalize_text(text)\n            if not normalized:\n                raise VowelCheckerError(\"Input must not be empty or whitespace only\")\n            return normalized\n\n    class RegexAdapter:\n        \"\"\"Encapsulates regular expression matching logic.\"\"\"\n        def match_start(self, pattern: str, text: str) -> bool:\n            try:\n                return re.match(pattern, text, re.IGNORECASE) is not None\n            except re.error as e:\n                raise VowelCheckerError(\"Invalid regex pattern\", cause=e)\n\n    @dataclass\n    class CheckRequest:\n        \"\"\"Data transfer object for checking a string.\"\"\"\n        text: str\n\n    @dataclass\n    class CheckResult:\n        \"\"\"Data transfer object for the result of a string check.\"\"\"\n        is_vowel_start: bool\n        input_text: str\n\n    class VowelCheckerService:\n        \"\"\"Handles the core business logic for vowel checking.\"\"\"\n        def __init__(self, regex_adapter: RegexAdapter, validator: StringValidator) -> None:\n            self._regex_adapter = regex_adapter\n            self._validator = validator\n\n        def check(self, req: CheckRequest) -> CheckResult:\n            text = self._validator.validate(req.text)\n            is_vowel = self._regex_adapter.match_start(VOWEL_PATTERN, text)\n            return CheckResult(is_vowel_start=is_vowel, input_text=text)\n\n    class VowelCheckerController:\n        \"\"\"Provides a thin API layer to the VowelCheckerService.\"\"\"\n        def __init__(self, service: VowelCheckerService) -> None:\n            self.service = service\n\n        def handle_check(self, text: str) -> bool:\n            req = CheckRequest(text=text)\n            result = self.service.check(req)\n            return result.is_vowel_start\n\n    # Orchestrate the components to perform the check\n    adapter = RegexAdapter()\n    validator = StringValidator()\n    service = VowelCheckerService(adapter, validator)\n    controller = VowelCheckerController(service)\n    return controller.handle_check(text)"}
{"task_id": "Mbpp/739", "solution": "import math\ndef find_Index(n: int) -> int:\n    \"\"\"\n    Finds the index k of the smallest triangular number T_k that has exactly n digits.\n    This uses a direct mathematical formula derived from T_k >= 10^(n-1).\n    \"\"\"\n    if not isinstance(n, int) or n < 1:\n        raise ValueError(\"n must be a positive integer\")\n\n    base_power_of_10 = 10 ** (n - 1)\n    discriminant = 1 + 8 * base_power_of_10\n\n    s_floor = math.isqrt(discriminant)\n    sqrt_ceil_value = s_floor if s_floor * s_floor == discriminant else s_floor + 1\n\n    k = sqrt_ceil_value // 2\n    return k"}
{"task_id": "Mbpp/740", "solution": "def tuple_to_dict(tuple_input: tuple) -> dict:\n    \"\"\"Converts a tuple of adjacent elements into a key-value dictionary.\n\n    Example:\n        tuple_to_dict((1, 5, 7, 10, 13, 5)) -> {1: 5, 7: 10, 13: 5}\n\n    Note:\n        - If tuple length is odd, this will raise an IndexError.\n        - Keys must be hashable or a TypeError will be raised when assigning to dict.\n    \"\"\"\n    result_dict = {}\n    for i in range(0, len(tuple_input), 2):\n        key = tuple_input[i]\n        value = tuple_input[i + 1]\n        result_dict[key] = value\n    return result_dict"}
{"task_id": "Mbpp/742", "solution": "import math\ndef area_tetrahedron(side: float) -> float:\n    \"\"\"\n    Computes the surface area of a regular tetrahedron with the given edge length.\n    It is assumed that the input 'side' is a positive float.\n    \"\"\"\n    return math.sqrt(3) * (side ** 2)"}
{"task_id": "Mbpp/741", "solution": "def all_Characters_Same(s):\n    \"\"\"\n    Checks if all characters in the given string are identical.\n    Returns True for empty strings or strings with a single character.\n    \"\"\"\n    if len(s) <= 1:\n        return True\n    first_char = s[0]\n    for char in s[1:]:\n        if char != first_char:\n            return False\n    return True"}
{"task_id": "Mbpp/743", "solution": "def rotate_right(lst, k):\n    \"\"\"\n    Rotates a list to the right by a specified number of items.\n    Handles positive, negative, and large k values, and empty lists, returning a new list.\n    \"\"\"\n    if not lst:\n        return []\n\n    n = len(lst)\n    k_norm = k % n\n\n    # The slice operation correctly handles k_norm = 0 as well,\n    # resulting in a list that is functionally identical to the original, but a new object.\n    return list(lst[-k_norm:] + lst[:-k_norm])"}
{"task_id": "Mbpp/744", "solution": "def check_none(tup):\n    \"\"\"\n    Return True if any element in the given tuple is None, otherwise False.\n    \"\"\"\n    for item in tup:\n        if item is None:\n            return True\n    return False"}
{"task_id": "Mbpp/745", "solution": "from typing import List, Iterator, Optional, Tuple, Dict, Any\nfrom abc import ABC, abstractmethod\nfrom dataclasses import dataclass\nclass Config:\n    MAX_RANGE: int = 1_000_000\n    ALLOW_NEGATIVE: bool = False\n\n    def validate_range(self, start: int, end: int) -> None:\n        if start > end:\n            raise ValueError(\"start must be <= end\")\n        if (end - start + 1) > self.MAX_RANGE:\n            raise ValueError(f\"Range too large (max {self.MAX_RANGE})\")\n        if not self.ALLOW_NEGATIVE and (start < 0 or end < 0):\n            raise ValueError(\"Negative ranges are not allowed by config\")\nclass DigitUtils:\n    @staticmethod\n    def digits_of(n: int) -> list:\n        return [int(c) for c in str(abs(n))]\n\n    @staticmethod\n    def contains_zero(n: int) -> bool:\n        return 0 in DigitUtils.digits_of(n)\n\n    @staticmethod\n    def is_divisible_by_digits(n: int) -> bool:\n        if n == 0:\n            return False\n        for d in DigitUtils.digits_of(n):\n            if d == 0 or (n % d) != 0:\n                return False\n        return True\n\n    @staticmethod\n    def safe_int(value: Any) -> int:\n        try:\n            return int(value)\n        except Exception as e:\n            raise ValueError(f\"Expected integer value, got {value!r}\") from e\nclass NumberRepository(ABC):\n    @abstractmethod\n    def get(self, start: int, end: int) -> Optional[NumberResult]:\n        pass\n    @abstractmethod\n    def save(self, result: NumberResult) -> None:\n        pass\nclass DivisibilityService:\n    def __init__(self, repo: Optional[NumberRepository]=None, config: Optional[Config]=None):\n        self.repo = repo\n        self.config = config or Config()\n\n    def _range_generator(self, start: int, end: int) -> Iterator[int]:\n        for n in range(start, end + 1):\n            yield n\n\n    def divisible_by_digits(self, start: int, end: int) -> List[int]:\n        self.config.validate_range(start, end)\n        if self.repo:\n            cached = self.repo.get(start, end)\n            if cached:\n                return list(cached.results)\n        results = []\n        for n in self._range_generator(start, end):\n            if DigitUtils.is_divisible_by_digits(n):\n                results.append(n)\n        if self.repo:\n            self.repo.save(NumberResult(start=start, end=end, results=results))\n        return results\ndef divisible_by_digits(startnum: int, endnum: int) -> List[int]:\n    svc = DivisibilityService(config=Config(), repo=None)\n    return svc.divisible_by_digits(startnum, endnum)"}
{"task_id": "Mbpp/751", "solution": "def check_min_heap(arr):\n    \"\"\"\n    Checks if the given array represents a min-heap.\n    An empty or single-element array is considered a valid min-heap.\n    \"\"\"\n    if arr is None:\n        raise TypeError(\"arr must be a sequence, not None\")\n\n    n = len(arr)\n    if n <= 1:\n        return True\n\n    for i in range(n // 2):\n        left = 2 * i + 1\n        right = 2 * i + 2\n\n        if left < n and arr[i] > arr[left]:\n            return False\n        if right < n and arr[i] > arr[right]:\n            return False\n\n    return True"}
{"task_id": "Mbpp/750", "solution": "from typing import Any, List, Tuple\ndef add_tuple(list_: List[Any], tuple_: Tuple[Any, ...], in_place: bool = False) -> List[Any]:\n    \"\"\"Adds elements of a tuple to a list, either in-place or returning a new list.\n\n    If `in_place` is True, the original list is modified. Otherwise, a new list is returned.\n    \"\"\"\n    if in_place:\n        list_.extend(tuple_)\n        return list_\n    else:\n        return list_ + list(tuple_)"}
{"task_id": "Mbpp/749", "solution": "from typing import List, Union, Optional, Tuple\nimport re\nNUMERIC_REGEX = r'^[+-]?(?:\\d+|\\d+\\.\\d+|\\d+\\.\\d+[eE][+-]?\\d+|\\d+[eE][+-]?\\d+)$'\nclass InvalidNumericStringError(Exception):\n    \"\"\"Exception raised when numeric strings cannot be parsed. It stores the invalid entries.\"\"\"\n    def __init__(self, invalids: List[Tuple[int,str]], message: str = None) -> None:\n        self.invalids = invalids\n        msg = message or f\"Invalid numeric strings at indices: {invalids}\"\n        super().__init__(msg)\nclass NumericParseResult:\n    \"\"\"A data transfer object to encapsulate parsed numeric values and any encountered invalid entries.\"\"\"\n    def __init__(self, parsed_values: List[Union[int,float]], invalids: List[Tuple[int,str]]) -> None:\n        self.parsed_values = parsed_values\n        self.invalids = invalids\nclass Validator:\n    \"\"\"Provides static methods to validate the type and structure of input data.\"\"\"\n    @staticmethod\n    def validate_input(input_list: List[str]) -> None:\n        if input_list is None:\n            raise TypeError(\"input_list must be an iterable of strings\")\n        try:\n            iter(input_list)\n        except TypeError:\n            raise TypeError(\"input_list must be iterable\")\n        for i, v in enumerate(input_list):\n            if not isinstance(v, str):\n                raise TypeError(f\"Element at index {i} is not a string: {type(v).__name__}\")\nclass Parser:\n    \"\"\"Handles the conversion of individual string tokens to numeric types.\"\"\"\n    numeric_regex = re.compile(NUMERIC_REGEX)\n\n    def parse(self, value: str, allow_floats: bool=True) -> Union[int,float]:\n        s = value.strip()\n        if not s:\n            raise ValueError(\"Empty string\")\n        if not self.numeric_regex.match(s):\n            raise ValueError(f\"Not numeric: {value!r}\")\n        if any(ch in s for ch in '.eE'):\n            if not allow_floats:\n                raise ValueError(\"Floats not allowed\")\n            return float(s)\n        return int(s)\n\n    def safe_parse(self, value: str, allow_floats: bool=True) -> Tuple[Optional[Union[int,float]], Optional[str]]:\n        try:\n            return self.parse(value, allow_floats), None\n        except Exception as e:\n            return None, str(e)\nclass SortService:\n    \"\"\"Manages the numeric sorting of values and the normalization process.\"\"\"\n    def sort_values(self, values: List[Union[int,float]]) -> List[Union[int,float]]:\n        return sorted(values)\n\n    def normalize_and_sort(self, values: List[str], allow_floats: bool=True, ignore_invalid: bool=False, parser: Parser=None) -> NumericParseResult:\n        parser = parser or Parser()\n        parsed = []\n        invalids = []\n        for i, tok in enumerate(values):\n            val, err = parser.safe_parse(tok, allow_floats=allow_floats)\n            if err:\n                invalids.append((i, tok))\n            else:\n                parsed.append(val)\n        parsed_sorted = self.sort_values(parsed)\n        return NumericParseResult(parsed_sorted, invalids)\nclass APIController:\n    \"\"\"Orchestrates the overall numeric string sorting process, including validation, parsing, and error handling.\"\"\"\n    def sort_numeric_strings(self, input_list: List[str], allow_floats: bool=True, ignore_invalid: bool=False) -> List[Union[int,float]]:\n        Validator.validate_input(input_list)\n        parser = Parser()\n        result = SortService().normalize_and_sort(input_list, allow_floats=allow_floats, ignore_invalid=ignore_invalid, parser=parser)\n        if result.invalids and not ignore_invalid:\n            raise InvalidNumericStringError(result.invalids)\n        return result.parsed_values\ndef sort_numeric_strings(input_list: List[str], allow_floats: bool=True, ignore_invalid: bool=False) -> List[Union[int,float]]:\n    \"\"\"Sorts a list of strings of numbers numerically.\n    It supports integers, floats, and scientific notation based on configuration.\n    \"\"\"\n    return APIController().sort_numeric_strings(input_list, allow_floats=allow_floats, ignore_invalid=ignore_invalid)"}
{"task_id": "Mbpp/748", "solution": "import re\ndef capital_words_spaces(text: str) -> str:\n    \"\"\"Inserts spaces between words starting with capital letters, handling CamelCase and acronyms.\n    Existing spaces are preserved and punctuation is kept without added spaces around it.\n    \"\"\"\n    if not isinstance(text, str):\n        raise TypeError(\"text must be a string\")\n\n    # Token pattern:\n    # - [A-Z]+[0-9]*(?=[A-Z][a-z]|\\b): Acronyms or consecutive uppers possibly followed by digits,\n    #   when followed by another Upper+lower sequence or word boundary.\n    # - [A-Z]?[a-z]+: Normal capitalized or lowercase words\n    # - [0-9]+: numbers\n    # - [^A-Za-z0-9\\s]+: punctuation / symbols (kept as separate tokens)\n    TOKEN_PATTERN = r\"[A-Z]+[0-9]*(?=[A-Z][a-z]|\\b)|[A-Z]?[a-z]+|[0-9]+|[^A-Za-z0-9\\s]+\"\n\n    tokens = re.findall(TOKEN_PATTERN, text)\n\n    parts = []\n    for tok in tokens:\n        if parts:\n            prev = parts[-1]\n            # If both previous and current are alphanumeric, insert a space.\n            if prev and prev[-1].isalnum() and tok and tok[0].isalnum():\n                parts.append(\" \" + tok)\n            else:\n                parts.append(tok)\n        else:\n            parts.append(tok)\n\n    return \"\".join(parts)"}
{"task_id": "Mbpp/752", "solution": "class JacobsthalError(Exception):\n    pass\nclass InvalidInputError(JacobsthalError):\n    pass\nclass Validator:\n    \"\"\"Provides utility methods for validating inputs.\"\"\"\n    @staticmethod\n    def validate_n(n_val: int) -> None:\n        \"\"\"Validates if n is a non-negative integer.\"\"\"\n        if not isinstance(n_val, int):\n            raise InvalidInputError(\"n must be an integer\")\n        if n_val < 0:\n            raise InvalidInputError(\"n must be non-negative\")\nclass CacheRepository:\n    \"\"\"Manages in-memory caching for computed Jacobsthal numbers.\"\"\"\n    def __init__(self) -> None:\n        self._store: dict[int, int] = {0: 0, 1: 1}\n\n    def get(self, n_val: int) -> int | None:\n        \"\"\"Retrieves a cached value for a given n.\"\"\"\n        return self._store.get(n_val)\n\n    def set(self, n_val: int, value: int) -> None:\n        \"\"\"Stores a computed value in the cache.\"\"\"\n        self._store[n_val] = value\n\n    def clear(self) -> None:\n        \"\"\"Clears all entries from the cache.\"\"\"\n        self._store.clear()\nclass Algorithms:\n    \"\"\"Implements various algorithms to compute Jacobsthal numbers.\"\"\"\n    @staticmethod\n    def iterative(n_val: int) -> int:\n        \"\"\"Computes J(n) using an iterative approach based on the recurrence relation.\"\"\"\n        if n_val == 0:\n            return 0\n        if n_val == 1:\n            return 1\n        a, b = 0, 1\n        for _ in range(2, n_val + 1):\n            a, b = b, b + 2 * a\n        return b\n\n    @staticmethod\n    def recursive_memo(n_val: int, cache: dict[int, int] = None) -> int:\n        \"\"\"Computes J(n) using recursion with memoization.\"\"\"\n        if cache is None:\n            cache = {0: 0, 1: 1}\n        if n_val in cache:\n            return cache[n_val]\n        cache[n_val] = Algorithms.recursive_memo(n_val - 1, cache) + 2 * Algorithms.recursive_memo(n_val - 2, cache)\n        return cache[n_val]\n\n    @staticmethod\n    def matrix_power(n_val: int) -> int:\n        \"\"\"Computes J(n) using matrix exponentiation for O(log n) time complexity.\"\"\"\n        if n_val == 0:\n            return 0\n        if n_val == 1:\n            return 1\n\n        def _mat_mult(A, B):\n            return [\n                [A[0][0]*B[0][0] + A[0][1]*B[1][0], A[0][0]*B[0][1] + A[0][1]*B[1][1]],\n                [A[1][0]*B[0][0] + A[1][1]*B[1][0], A[1][0]*B[0][1] + A[1][1]*B[1][1]],\n            ]\n\n        def _mat_pow(M, p):\n            result = [[1,0],[0,1]]\n            while p > 0:\n                if p & 1:\n                    result = _mat_mult(result, M)\n                M = _mat_mult(M, M)\n                p >>= 1\n            return result\n\n        # Base matrix M = [[1,2],[1,0]] for J(n) = J(n-1) + 2*J(n-2)\n        # We need M^(n-1) to transform [J(1), J(0)]^T to [J(n), J(n-1)]^T\n        # J(1) = 1, J(0) = 0. So J(n) = (M^(n-1))[0][0] * J(1) + (M^(n-1))[0][1] * J(0) = (M^(n-1))[0][0]\n        M = [[1,2],[1,0]]\n        Mp = _mat_pow(M, n_val - 1)\n        return Mp[0][0]\n\n    @staticmethod\n    def closed_form(n_val: int) -> int:\n        \"\"\"Computes J(n) using the closed-form formula J(n) = (2^n - (-1)^n) / 3.\"\"\"\n        return (2**n_val - (-1)**n_val) // 3\nclass JacobsthalService:\n    \"\"\"Provides the core service to compute Jacobsthal numbers, handling caching and algorithm selection.\"\"\"\n    CLOSED_FORM_THRESHOLD = 1_000_000\n\n    def __init__(self, cache: CacheRepository, algorithms: Algorithms) -> None:\n        self.cache = cache\n        self.algorithms = algorithms\n\n    def compute(self, n_val: int, method_hint: str = 'auto') -> int:\n        \"\"\"Computes the nth Jacobsthal number using the specified or auto-selected method.\"\"\"\n        Validator.validate_n(n_val)\n\n        cached = self.cache.get(n_val)\n        if cached is not None:\n            return cached\n\n        chosen = self._select_method(n_val, method_hint)\n\n        if chosen == 'closed_form':\n            value = self.algorithms.closed_form(n_val)\n        elif chosen == 'iterative':\n            value = self.algorithms.iterative(n_val)\n        elif chosen == 'recursive':\n            value = self.algorithms.recursive_memo(n_val, cache={0: 0, 1: 1}) # Isolated cache for recursive calls\n        elif chosen == 'matrix':\n            value = self.algorithms.matrix_power(n_val)\n        else:\n            value = self.algorithms.iterative(n_val)\n\n        self.cache.set(n_val, value)\n        return value\n\n    def _select_method(self, n_val: int, method_hint: str) -> str:\n        \"\"\"Determines the best algorithm based on hint and input size.\"\"\"\n        if method_hint in ('iterative', 'recursive', 'matrix', 'closed_form'):\n            return method_hint\n\n        if n_val <= self.CLOSED_FORM_THRESHOLD:\n            return 'closed_form'\n        return 'matrix'\n_default_service = JacobsthalService(cache=CacheRepository(), algorithms=Algorithms())\ndef jacobsthal_num(n: int, method: str = 'auto') -> int:\n    \"\"\"\n    Finds the nth Jacobsthal number using a selected or auto-determined algorithm.\n    The sequence starts with J(0)=0, J(1)=1, and follows J(n) = J(n-1) + 2*J(n-2).\n    \"\"\"\n    return _default_service.compute(n, method=method)"}
{"task_id": "Mbpp/754", "solution": "def extract_index_list(l1, l2, l3):\n    \"\"\"\n    Finds elements that appear in all three lists under the same index.\n    \"\"\"\n    min_len = min(len(l1), len(l2), len(l3))\n    result = []\n    for i in range(min_len):\n        if l1[i] == l2[i] == l3[i]:\n            result.append(l1[i])\n    return result"}
{"task_id": "Mbpp/753", "solution": "def min_k(records, k):\n    \"\"\"\n    Finds the minimum k records from a list of (name, value) tuples.\n    Records are ordered by value ascending, then by name ascending for ties.\n    \"\"\"\n    import heapq\n    from typing import List, Tuple, Any, Iterable\n\n    class Record:\n        \"\"\"Represents a domain record with comparison support.\"\"\"\n        def __init__(self, name: str, value: int) -> None:\n            self.name: str = name\n            self.value: int = int(value)\n\n        def to_tuple(self) -> Tuple[str, int]:\n            \"\"\"Returns the record as a (name, value) tuple.\"\"\"\n            return (self.name, self.value)\n\n        def __lt__(self, other: \"Record\") -> bool:\n            \"\"\"Compares records: first by value (ascending), then by name (ascending).\"\"\"\n            return (self.value, self.name) < (other.value, other.name)\n\n    class MaxHeapRecord:\n        \"\"\"\n        A wrapper for Record objects to enable max-heap behavior with heapq (a min-heap).\n        Comparison is reversed so that the 'largest' Record (by Record.__lt__) is considered\n        'smallest' by MaxHeapRecord.__lt__, making it rise to the top of a min-heap.\n        \"\"\"\n        def __init__(self, record: Record):\n            self.record = record\n\n        def __lt__(self, other: \"MaxHeapRecord\") -> bool:\n            \"\"\"Reverses the natural comparison of Record for max-heap behavior.\"\"\"\n            return other.record < self.record\n\n    def _load_records(raw_records: Iterable[Tuple[Any, Any]]) -> List[Record]:\n        \"\"\"Converts raw input tuples into Record objects, assuming valid input.\"\"\"\n        return [Record(item[0], item[1]) for item in raw_records]\n\n    def _stable_sort_records(records_list: Iterable[Record]) -> List[Record]:\n        \"\"\"Stably sorts a list of Record objects using their __lt__ method.\"\"\"\n        return sorted(records_list)\n\n    def _heap_select_min_k(domain_records: Iterable[Record], num_k: int) -> List[Record]:\n        \"\"\"\n        Efficiently selects the num_k smallest records using a max-heap of size num_k.\n        This approach ensures O(N log K) performance.\n        \"\"\"\n        if num_k == 0:\n            return []\n\n        max_heap: List[MaxHeapRecord] = []\n\n        for r in domain_records:\n            wrapped_record = MaxHeapRecord(r)\n            if len(max_heap) < num_k:\n                heapq.heappush(max_heap, wrapped_record)\n            else:\n                # If the current record is smaller than the largest in the heap (heap[0] due to MaxHeapRecord.__lt__)\n                if r < max_heap[0].record:\n                    heapq.heapreplace(max_heap, wrapped_record)\n\n        return [mh_record.record for mh_record in max_heap]\n\n    # Main logic\n    domain_records = _load_records(records)\n    selected_records = _heap_select_min_k(domain_records, k)\n    ordered_records = _stable_sort_records(selected_records)\n    return [r.to_tuple() for r in ordered_records]"}
{"task_id": "Mbpp/757", "solution": "from typing import List\ndef count_reverse_pairs(strings: List[str]) -> int:\n    \"\"\"\n    Counts pairs of strings in the list that are reverses of each other.\n    Each unordered pair of positions (i, j) with i < j and strings[i] == reverse(strings[j])\n    is counted exactly once.\n    \"\"\"\n    seen_counts: dict[str, int] = {}\n    pairs = 0\n\n    for s in strings:\n        reversed_s = s[::-1]\n        pairs += seen_counts.get(reversed_s, 0)\n        seen_counts[s] = seen_counts.get(s, 0) + 1\n\n    return pairs"}
{"task_id": "Mbpp/755", "solution": "def second_smallest(numbers):\n    \"\"\"\n    Finds the second smallest number in a list using a single pass.\n    Assumes the input list contains at least two numeric elements.\n    \"\"\"\n    min1 = float('inf')\n    min2 = float('inf')\n\n    for x in numbers:\n        if x <= min1:\n            min2 = min1\n            min1 = x\n        elif x < min2:\n            min2 = x\n\n    return min2"}
{"task_id": "Mbpp/759", "solution": "def is_decimal(value: str) -> bool:\n    \"\"\"\n    Checks if a string represents a decimal number with exactly two digits after the decimal point.\n    Handles an optional leading sign and trims surrounding whitespace.\n    \"\"\"\n    if not isinstance(value, str):\n        return False\n\n    s = value.strip()\n    if not s:\n        return False\n\n    # Handle optional leading sign\n    if s[0] in \"+-\":\n        if len(s) == 1:\n            return False\n        s = s[1:]\n\n    # A valid decimal with precision must contain exactly one decimal point\n    parts = s.split('.')\n    if len(parts) != 2:\n        return False\n\n    integer_part, fractional_part = parts\n\n    # Integer part must have at least one digit and all digits\n    if not integer_part or not integer_part.isdigit():\n        return False\n\n    # Fractional part must have exactly 2 digits and all digits\n    if len(fractional_part) != 2 or not fractional_part.isdigit():\n        return False\n\n    return True"}
{"task_id": "Mbpp/758", "solution": "def unique_sublists(input_list):\n    \"\"\"Return a dict counting occurrences of sublists in input_list.\n    Each sublist is converted to a tuple and used as a dictionary key.\n    \"\"\"\n    if not hasattr(input_list, \"__iter__\") or isinstance(input_list, (str, bytes)):\n        raise TypeError(\"input_list must be an iterable of iterables\")\n\n    counts = {}\n    for idx, sub in enumerate(input_list):\n        try:\n            tup = tuple(sub)\n        except TypeError:\n            raise TypeError(f\"Element at index {idx} is not iterable: {sub!r}\")\n        try:\n            hash(tup)\n        except TypeError:\n            raise TypeError(f\"Elements in sublist at index {idx} are not hashable: {sub!r}\")\n        counts[tup] = counts.get(tup, 0) + 1\n    return counts"}
{"task_id": "Mbpp/760", "solution": "def unique_Element(list_of_numbers):\n    \"\"\"\n    Checks if a list of numbers contains only one distinct element.\n    An empty list is considered not to contain a single distinct element.\n    \"\"\"\n    if not list_of_numbers:\n        return False\n\n    first_element = list_of_numbers[0]\n    for element in list_of_numbers[1:]:\n        if element != first_element:\n            return False\n    return True"}
{"task_id": "Mbpp/762", "solution": "def check_monthnumber_number(month: int) -> bool:\n    \"\"\"\n    Checks if the given month number (1-12) has exactly 30 days.\n    Raises InvalidMonthError if the month number is out of range or not an integer.\n    \"\"\"\n    # Constants\n    THIRTY_DAY_MONTHS = frozenset({4, 6, 9, 11})\n    MIN_MONTH = 1\n    MAX_MONTH = 12\n\n    # Exception\n    class InvalidMonthError(ValueError):\n        def __init__(self, message: str) -> None:\n            super().__init__(message)\n            self.message = message\n\n    # Validator\n    class MonthValidator:\n        def validate(self, m: int) -> None:\n            if not isinstance(m, int):\n                raise InvalidMonthError(\"month must be an integer\")\n            if m < MIN_MONTH or m > MAX_MONTH:\n                raise InvalidMonthError(f\"month must be between {MIN_MONTH} and {MAX_MONTH}\")\n\n    # Model\n    class MonthModel:\n        def __init__(self, m: int) -> None:\n            self._month = m\n\n        def is_30_days(self, known_30_months: set[int]) -> bool:\n            return self._month in known_30_months\n\n    # Repository\n    class MonthRepository:\n        def get_30_day_months(self) -> set[int]:\n            return set(THIRTY_DAY_MONTHS)\n\n    # Service\n    class MonthService:\n        def __init__(self, repository: MonthRepository) -> None:\n            self._repository = repository\n\n        def has_30_days(self, m: int) -> bool:\n            known = self._repository.get_30_day_months()\n            model = MonthModel(m)\n            return model.is_30_days(known)\n\n    # Controller\n    class MonthController:\n        def __init__(self, service: MonthService, validator: MonthValidator) -> None:\n            self._service = service\n            self._validator = validator\n\n        def check_month(self, m: int) -> bool:\n            self._validator.validate(m)\n            return self._service.has_30_days(m)\n\n    controller = MonthController(service=MonthService(MonthRepository()), validator=MonthValidator())\n    return controller.check_month(month)"}
{"task_id": "Mbpp/764", "solution": "def number_ctr(s: str) -> int:\n    \"\"\"Counts the number of ASCII digit characters in a string.\"\"\"\n    count = 0\n    for char in s:\n        if '0' <= char <= '9':  # Equivalent to char.isdigit() for ASCII digits\n            count += 1\n    return count"}
{"task_id": "Mbpp/763", "solution": "def find_min_diff(arr, n):\n    \"\"\"\n    Return the minimum absolute difference between any two elements in `arr`.\n    Preconditions:\n      - `arr` is a sequence of numeric values (ints or floats).\n      - `n` is an int equal to len(arr) and n >= 2.\n    Raises:\n      - TypeError or ValueError for invalid inputs.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n    if not hasattr(arr, \"__len__\"):\n        raise TypeError(\"arr must be a sequence with a length\")\n    if len(arr) != n:\n        raise ValueError(\"n does not match length of arr\")\n    if n < 2:\n        raise ValueError(\"need at least two elements to compute a difference\")\n\n    nums = list(arr)  # copy to allow sorting\n    for i, v in enumerate(nums):\n        if not isinstance(v, (int, float)):\n            raise TypeError(f\"element at index {i} is not numeric: {v!r}\")\n\n    nums.sort()\n    min_diff = float(\"inf\")\n    for i in range(1, n):\n        diff = abs(nums[i] - nums[i - 1])\n        if diff < min_diff:\n            min_diff = diff\n            if min_diff == 0:\n                break\n\n    # If all inputs were ints, return an int; otherwise return a float\n    if all(isinstance(x, int) for x in nums):\n        return int(min_diff)\n    return min_diff"}
{"task_id": "Mbpp/766", "solution": "from typing import List, Tuple, Sequence, TypeVar\n_T = TypeVar('_T')\ndef pair_wise(lst: Sequence[_T]) -> List[Tuple[_T, _T]]:\n    \"\"\"Returns a list of all pairs of consecutive items in the given list.\n    Handles lists with less than two items by returning an empty list.\n    \"\"\"\n    if len(lst) < 2:\n        return []\n\n    result: List[Tuple[_T, _T]] = []\n    for i in range(len(lst) - 1):\n        result.append((lst[i], lst[i+1]))\n    return result"}
{"task_id": "Mbpp/765", "solution": "def nth_polite(n: int) -> int:\n    \"\"\"\n    Return the nth polite number (1-indexed).\n\n    A polite number is a positive integer that is NOT a power of two.\n    This function finds the smallest integer m such that the count of\n    non-powers-of-two <= m equals n.\n\n    Raises:\n        ValueError: if n is not an integer >= 1.\n    \"\"\"\n    if not isinstance(n, int):\n        raise ValueError(\"n must be an integer\")\n    if n < 1:\n        raise ValueError(\"n must be >= 1\")\n\n    # Helper: number of powers of two <= x for x >= 1 is floor(log2(x)) + 1,\n    # which equals x.bit_length() for x >= 1. For x == 0 it's 0.\n    def non_powers_count(x: int) -> int:\n        if x <= 0:\n            return 0\n        return x - x.bit_length()\n\n    # Find an upper bound 'high' such that non_powers_count(high) >= n.\n    # Start with a conservative estimate and grow exponentially if needed.\n    high = n + max(1, n.bit_length()) + 5\n    while non_powers_count(high) < n:\n        high = max(high * 2, high + 1)\n\n    low = 1\n    # Binary search for minimal m with non_powers_count(m) >= n\n    while low < high:\n        mid = (low + high) // 2\n        if non_powers_count(mid) >= n:\n            high = mid\n        else:\n            low = mid + 1\n\n    # low is the minimal integer with at least n non-powers <= low.\n    # By construction this will be a non-power-of-two (polite number).\n    return low"}
{"task_id": "Mbpp/769", "solution": "def Diff(a, b):\n    \"\"\"\n    Computes the difference between two lists, returning elements from `a` that are not present in `b`.\n    The result is ordered by original index parity: even-indexed elements first, then odd-indexed elements.\n    \"\"\"\n    b_set = set(b)\n    even_indexed_retained = []\n    odd_indexed_retained = []\n\n    for i, item_a in enumerate(a):\n        if item_a not in b_set:\n            if i % 2 == 0:\n                even_indexed_retained.append(item_a)\n            else:\n                odd_indexed_retained.append(item_a)\n\n    return even_indexed_retained + odd_indexed_retained"}
{"task_id": "Mbpp/767", "solution": "from typing import List, Iterable, Dict, Tuple\nfrom dataclasses import dataclass\nclass InvalidInputError(Exception):\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\nDEFAULT_MAX_INPUT_SIZE = 1_000_000\nclass FrequencyRepository:\n    \"\"\"Abstract base class for frequency repositories.\"\"\"\n    def add(self, value: int) -> None:\n        raise NotImplementedError\n    def get_count(self, value: int) -> int:\n        raise NotImplementedError\n    def items(self) -> Iterable[Tuple[int,int]]:\n        raise NotImplementedError\n    def clear(self) -> None:\n        raise NotImplementedError\nclass InMemoryFrequencyRepository(FrequencyRepository):\n    \"\"\"In-memory implementation using a dictionary to store frequencies.\"\"\"\n    def __init__(self):\n        self._freq: Dict[int,int] = {}\n    def add(self, value: int) -> None:\n        self._freq[value] = self._freq.get(value, 0) + 1\n    def get_count(self, value: int) -> int:\n        return self._freq.get(value, 0)\n    def items(self) -> Iterable[Tuple[int,int]]:\n        return self._freq.items()\n    def clear(self) -> None:\n        self._freq.clear()\nclass InputValidator:\n    \"\"\"Validates input numbers and enforces collection size limits.\"\"\"\n    def __init__(self, max_input_size: int = DEFAULT_MAX_INPUT_SIZE):\n        self.max_input_size = max_input_size\n\n    def validate_numbers(self, numbers: Iterable[int]) -> List[int]:\n        if not isinstance(numbers, Iterable):\n            raise InvalidInputError(\"Input 'numbers' must be an iterable.\")\n\n        numbers_list = list(numbers) # Convert to list for consistent length check and iteration.\n\n        if len(numbers_list) > self.max_input_size:\n            raise InvalidInputError(f\"Input size ({len(numbers_list)}) exceeds maximum allowed size ({self.max_input_size}).\")\n\n        for i, num in enumerate(numbers_list):\n            if not isinstance(num, int):\n                raise InvalidInputError(f\"All elements in 'numbers' must be integers. Found non-integer at index {i}: {type(num).__name__}\")\n        return numbers_list\nclass PairCounterService:\n    \"\"\"Provides the core business logic to count pairs summing to a target.\"\"\"\n    def __init__(self, repository: FrequencyRepository, validator: InputValidator):\n        self.repository = repository\n        self.validator = validator\n\n    def count_pairs(self, numbers: Iterable[int], target: int) -> PairResult:\n        nums = self.validator.validate_numbers(numbers)\n\n        if hasattr(self.repository, \"clear\"):\n            self.repository.clear() # Clear repository for reusability if it supports it.\n\n        for v in nums:\n            self.repository.add(v)\n\n        count = 0\n        for value, freq in self.repository.items():\n            complement = target - value\n\n            if complement == value:\n                count += freq * (freq - 1) // 2 # Handles combinations for self-pairs.\n            elif complement > value:\n                count += freq * self.repository.get_count(complement) # Ensures each unordered pair is counted once.\n\n        return PairResult(count=count, target=target, input_length=len(nums))\ndef get_pairs_count(numbers: List[int], sum_: int) -> int:\n    \"\"\"\n    Counts the number of unordered pairs in a list whose sum equals 'sum_'.\n    Uses a frequency map approach for optimal O(N) time complexity.\n    \"\"\"\n    repo = InMemoryFrequencyRepository()\n    validator = InputValidator()\n    service = PairCounterService(repository=repo, validator=validator)\n    result = service.count_pairs(numbers, sum_)\n    return result.count"}
{"task_id": "Mbpp/770", "solution": "def odd_num_sum(n: int) -> int:\n    # Calculates the sum of the fourth power of the first n odd natural numbers\n    # using a closed-form formula.\n    if not isinstance(n, int) or n < 0:\n        raise ValueError(\"n must be a non-negative integer\")\n    if n == 0:\n        return 0\n\n    # Formulas for sums of powers of first n natural numbers\n    # sum_k = sum_{i=1 to n} i\n    sum_k = n * (n + 1) // 2\n\n    # sum_k2 = sum_{i=1 to n} i^2\n    sum_k2 = n * (n + 1) * (2 * n + 1) // 6\n\n    # sum_k3 = sum_{i=1 to n} i^3\n    sum_k3 = sum_k * sum_k  # (n * (n + 1) // 2)**2\n\n    # sum_k4 = sum_{i=1 to n} i^4\n    sum_k4 = n * (n + 1) * (2 * n + 1) * (3 * n * n + 3 * n - 1) // 30\n\n    # The sum of (2k - 1)^4 for k=1 to n is given by:\n    # sum_{k=1 to n} (16k^4 - 32k^3 + 24k^2 - 8k + 1)\n    # = 16 * sum_k4 - 32 * sum_k3 + 24 * sum_k2 - 8 * sum_k + n * 1\n    result = (\n        16 * sum_k4\n        - 32 * sum_k3\n        + 24 * sum_k2\n        - 8 * sum_k\n        + n\n    )\n    return result"}
{"task_id": "Mbpp/773", "solution": "def occurance_substring(text: str, substring: str):\n    \"\"\"\n    Finds the first occurrence and position of a substring within a string.\n    Returns None if there is no match.\n    \"\"\"\n    start_index = text.find(substring)\n    if start_index == -1:\n        return None\n    end_index = start_index + len(substring)\n    return (substring, start_index, end_index)"}
{"task_id": "Mbpp/771", "solution": "from typing import Any, List, Optional, Dict\nclass InvalidExpressionError(ValueError):\n    \"\"\"Exception raised for invalid expression input types.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\nclass Stack:\n    \"\"\"A simple LIFO stack implementation.\"\"\"\n    def __init__(self) -> None:\n        self._items: List[Any] = []\n\n    def push(self, item: Any) -> None:\n        self._items.append(item)\n\n    def pop(self) -> Any:\n        return self._items.pop()\n\n    def peek(self) -> Optional[Any]:\n        return self._items[-1] if self._items else None\n\n    def is_empty(self) -> bool:\n        return not self._items\n\n    def __len__(self) -> int:\n        return len(self._items)\nDEFAULT_BRACKET_PAIRS: Dict[str, str] = {\"(\": \")\", \"{\": \"}\", \"[\": \"]\"}\ndef default_bracket_map() -> Dict[str, str]:\n    \"\"\"Returns a copy of the default bracket mapping.\"\"\"\n    return dict(DEFAULT_BRACKET_PAIRS)\ndef is_opening(char: str, bracket_map: Dict[str, str]) -> bool:\n    \"\"\"Checks if a character is an opening bracket.\"\"\"\n    return char in bracket_map\nclass ExpressionChecker:\n    \"\"\"Checks if an expression has balanced brackets.\"\"\"\n    def __init__(self, bracket_map: Optional[Dict[str, str]] = None, ignore_non_brackets: bool = True) -> None:\n        self.bracket_map = bracket_map or default_bracket_map()\n        self.ignore_non_brackets = ignore_non_brackets\n\n    def is_balanced(self, expression: str) -> bool:\n        \"\"\"Determines if the given expression string has balanced brackets.\"\"\"\n        if not isinstance(expression, str):\n            raise InvalidExpressionError(\"Expression must be a string\")\n\n        stack = Stack()\n        inverse = {v: k for k, v in self.bracket_map.items()}\n        for ch in expression:\n            if is_opening(ch, self.bracket_map):\n                stack.push(ch)\n            elif ch in inverse: # It's a closing bracket\n                if stack.is_empty() or stack.pop() != inverse[ch]:\n                    return False\n            else: # It's a non-bracket character\n                if not self.ignore_non_brackets:\n                    return False\n        return stack.is_empty()\ndef check_expression(expression: str) -> bool:\n    \"\"\"Checks if the given expression has balanced brackets.\"\"\"\n    return ExpressionChecker().is_balanced(expression)"}
{"task_id": "Mbpp/772", "solution": "class Tokenizer:\n    \"\"\"Handles tokenization and joining of text.\"\"\"\n    def __init__(self) -> None:\n        pass\n\n    def tokenize(self, text: str):\n        return text.split()\n\n    def join(self, tokens):\n        return \" \".join(tokens)\nclass WordRemoverService:\n    \"\"\"Provides business logic to remove words of a specific length.\"\"\"\n    def __init__(self, tokenizer: Tokenizer) -> None:\n        self._tokenizer = tokenizer\n\n    def remove_words(self, text: str, k: int) -> str:\n        tokens = self._tokenizer.tokenize(text)\n        filtered = self._filter_words(tokens, k)\n        return self._tokenizer.join(filtered)\n\n    def _filter_words(self, tokens, k: int):\n        return [t for t in tokens if len(t) != k]\ndef remove_length(text: str, k: int) -> str:\n    \"\"\"\n    Removes all words with k length from the given string.\n    Words are split by whitespace, and punctuation is considered part of the word.\n    \"\"\"\n    tokenizer = Tokenizer()\n    service = WordRemoverService(tokenizer)\n    return service.remove_words(text, k)"}
{"task_id": "Mbpp/775", "solution": "def odd_position(lst):\n    \"\"\"\n    Checks if every odd-indexed element in the list is an odd number.\n    Returns True if all odd-indexed elements are odd, or if the list is empty/has no odd indices.\n    \"\"\"\n    for i in range(1, len(lst), 2):\n        if lst[i] % 2 == 0:\n            return False\n    return True"}
{"task_id": "Mbpp/777", "solution": "def find_sum(lst):\n    \"\"\"\n    Return the sum of elements that appear exactly once in the given list.\n\n    Args:\n        lst: A list (or tuple) of integers.\n\n    Returns:\n        int: Sum of elements that occur exactly once.\n\n    Raises:\n        TypeError: If lst is not a list/tuple or any element is not an int.\n    \"\"\"\n    if not isinstance(lst, (list, tuple)):\n        raise TypeError(\"lst must be a list or tuple of integers\")\n\n    counts = {}\n    for i, v in enumerate(lst):\n        if not isinstance(v, int):\n            raise TypeError(f\"element at index {i} is not an int: {v!r}\")\n        counts[v] = counts.get(v, 0) + 1\n\n    return sum(value for value, cnt in counts.items() if cnt == 1)"}
{"task_id": "Mbpp/778", "solution": "from typing import Iterable, List, TypeVar\nT = TypeVar(\"T\")\ndef pack_consecutive_duplicates(list_elements: Iterable[T]) -> List[List[T]]:\n    \"\"\"\n    Packs consecutive duplicates of list elements into sublists.\n    \"\"\"\n    iterator = iter(list_elements)\n    result: List[List[T]] = []\n\n    try:\n        current_group = [next(iterator)]\n    except StopIteration:\n        return []\n\n    for item in iterator:\n        if item == current_group[-1]:\n            current_group.append(item)\n        else:\n            result.append(current_group)\n            current_group = [item]\n\n    result.append(current_group)\n    return result"}
{"task_id": "Mbpp/781", "solution": "def count_divisors(n: int) -> bool:\n    \"\"\"\n    Checks whether the count of positive divisors for an integer n is even.\n\n    Returns True if the number of divisors is even, False if odd.\n\n    Note:\n    - Only valid for positive integers n >= 1.\n    - A positive integer has an odd number of divisors iff it is a perfect square.\n      Therefore this returns False for perfect squares and True otherwise.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n    if n < 1:\n        raise ValueError(\"n must be a positive integer (>= 1)\")\n\n    sqrt_n = int(n**0.5)\n    return (sqrt_n * sqrt_n) != n"}
{"task_id": "Mbpp/780", "solution": "from typing import List, Tuple, Union\nNumber = Union[int, float]\ndef find_combinations(tuple_list: List[Tuple[Number, Number]]) -> List[Tuple[Number, Number]]:\n    \"\"\"\n    Finds element-wise sums of all unique unordered pairs of 2-element numeric tuples.\n    \"\"\"\n    n = len(tuple_list)\n    if n < 2:\n        return []\n\n    results: List[Tuple[Number, Number]] = []\n    for i in range(n - 1):\n        for j in range(i + 1, n):\n            tuple1 = tuple_list[i]\n            tuple2 = tuple_list[j]\n            sum_tuple = (tuple1[0] + tuple2[0], tuple1[1] + tuple2[1])\n            results.append(sum_tuple)\n    return results"}
{"task_id": "Mbpp/782", "solution": "from typing import Sequence, List, Union\nfrom abc import ABC, abstractmethod\nNumber = Union[int, float]\nclass ValidationError(Exception):\n    \"\"\"Exception raised for invalid input data.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\ndef validate_input(arr: Sequence) -> List[Number]:\n    \"\"\"Validates input sequence and its elements, converting to a list of numbers.\"\"\"\n    if not isinstance(arr, (list, tuple)):\n        raise ValidationError(\"Input must be a list or tuple\")\n    out: List[Number] = []\n    for i, v in enumerate(arr):\n        if not isinstance(v, (int, float)):\n            raise ValidationError(f\"Element at index {i} is not numeric: {v!r}\")\n        out.append(v)\n    return out\nclass AlgorithmStrategy(ABC):\n    \"\"\"Abstract base class for sum computation algorithms.\"\"\"\n    @abstractmethod\n    def compute(self, values: List[Number]) -> Number:\n        pass\nclass CountingStrategy(AlgorithmStrategy):\n    \"\"\"Computes the sum of odd-length subarrays in O(n) time.\"\"\"\n    def compute(self, values: List[Number]) -> Number:\n        n = len(values)\n        total = 0\n        for i, val in enumerate(values):\n            starts = i + 1\n            ends = n - i\n            total_subs = starts * ends\n            odd_count = (total_subs + 1) // 2\n            total += val * odd_count\n        return total\nclass OddLengthSumService:\n    \"\"\"Orchestrates validation and sum computation using a strategy.\"\"\"\n    def __init__(self, strategy: AlgorithmStrategy | None = None) -> None:\n        self._strategy = strategy or CountingStrategy()\n\n    def compute(self, values: Sequence[Number]) -> Number:\n        normalized = validate_input(values)\n        return self._strategy.compute(normalized)\ndef odd_length_sum(arr: Sequence[Number]) -> Number:\n    \"\"\"Computes the sum of all odd-length subarrays for a given list of numbers.\"\"\"\n    service = OddLengthSumService()\n    return service.compute(arr)"}
{"task_id": "Mbpp/784", "solution": "class NoOddFoundError(ValueError):\n    \"\"\"Exception raised when no odd number is found in the list.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\nclass NoEvenFoundError(ValueError):\n    \"\"\"Exception raised when no even number is found in the list.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\ndef is_even(n: int) -> bool:\n    \"\"\"Checks if a number is even.\"\"\"\n    return n % 2 == 0\ndef is_odd(n: int) -> bool:\n    \"\"\"Checks if a number is odd.\"\"\"\n    return n % 2 != 0\nclass InputList:\n    \"\"\"A wrapper for the input list, providing iteration and length.\"\"\"\n    def __init__(self, numbers: list) -> None:\n        self.numbers: list = numbers\n\n    def __iter__(self):\n        return iter(self.numbers)\n\n    def __len__(self) -> int:\n        return len(self.numbers)\n\n    def as_list(self) -> list:\n        return list(self.numbers)\nclass ListScanner:\n    \"\"\"Scans a list to find the first odd and first even numbers.\"\"\"\n    def scan_firsts(self, numbers: InputList) -> tuple[int | None, int | None]:\n        first_odd: int | None = None\n        first_even: int | None = None\n        for v in numbers:\n            if first_odd is None and is_odd(v):\n                first_odd = v\n            if first_even is None and is_even(v):\n                first_even = v\n            if first_odd is not None and first_even is not None:\n                break\n        return first_odd, first_even\nclass MulService:\n    \"\"\"Business logic for multiplying the first odd and even numbers.\"\"\"\n    def __init__(self, scanner: ListScanner) -> None:\n        self._scanner = scanner\n\n    def multiply_first_odd_even(self, numbers: InputList) -> int:\n        \"\"\"Finds first odd and even, then returns their product.\"\"\"\n        first_odd, first_even = self._scanner.scan_firsts(numbers)\n        if first_odd is None:\n            raise NoOddFoundError(\"No odd number found in list\")\n        if first_even is None:\n            raise NoEvenFoundError(\"No even number found in list\")\n        return first_odd * first_even\nclass CLIController:\n    \"\"\"Controller for the public API, handling input validation and orchestration.\"\"\"\n    def __init__(self, service: MulService) -> None:\n        self._service = service\n\n    def mul_even_odd(self, numbers: list) -> int:\n        \"\"\"Validates input, processes list, and returns product of first even and odd.\"\"\"\n        validate_list(numbers)\n        inp = InputList(numbers)\n        return self._service.multiply_first_odd_even(inp)\n_default_service = MulService(ListScanner())\ndef mul_even_odd(numbers: list) -> int:\n    \"\"\"\n    Finds the product of the first even and first odd number of a given list.\n    Handles input validation and raises specific errors if numbers are missing.\n    \"\"\"\n    return CLIController(_default_service).mul_even_odd(numbers)"}
{"task_id": "Mbpp/786", "solution": "def right_insertion(sorted_list, value):\n    \"\"\"\n    Locates the rightmost insertion point for a value in a sorted list.\n    This is equivalent to `bisect.bisect_right`.\n    \"\"\"\n    lo, hi = 0, len(sorted_list)\n    while lo < hi:\n        mid = (lo + hi) // 2\n        if sorted_list[mid] <= value:\n            lo = mid + 1\n        else:\n            hi = mid\n    return lo"}
{"task_id": "Mbpp/785", "solution": "def tuple_str_int(tuple_str: str) -> tuple[int, ...]:\n    \"\"\"\n    Converts a string representation of an integer tuple to an actual Python tuple of integers.\n    \"\"\"\n    s = tuple_str.strip()\n\n    # Basic validation: must start with '(' and end with ')'\n    if not (s.startswith(\"(\") and s.endswith(\")\")):\n        raise ValueError(\"Input must be a tuple string wrapped in parentheses, e.g. '(1, 2, 3)'\")\n\n    # Remove the outer parentheses. Handles cases like \"(7, 8, 9)\" -> \"7, 8, 9\" and \"()\" -> \"\"\n    body = s[1:-1].strip()\n\n    if body == \"\":\n        return ()\n\n    # Split by comma and strip whitespace from each element.\n    # Keep empty tokens to detect malformed inputs like \"(1,,2)\" or \"(1, )\" which should raise.\n    raw_elements = [element for element in body.split(\",\")]\n\n    elements = []\n    for elem in raw_elements:\n        token = elem.strip()\n        if token == \"\":\n            # Empty element (e.g., trailing comma produces \"\" in split; \"(1,)\" should be treated as (1,))\n            # Accept a single trailing empty element only if input had exactly one non-empty element and a trailing comma.\n            # For simplicity and safety, treat empty tokens as an error unless the whole tuple was a single-element with trailing comma.\n            raise ValueError(f\"Empty tuple element in input: {tuple_str!r}\")\n        try:\n            elements.append(int(token))\n        except ValueError as exc:\n            raise ValueError(f\"Invalid integer value: {token!r}\") from exc\n\n    return tuple(elements)"}
