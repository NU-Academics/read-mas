{"task_id": "Mbpp/414", "solution": "def overlapping(a, b):\n    \"\"\"\n    Return True if any element from iterable `a` exists in iterable `b`, otherwise False.\n\n    The function prefers an O(n + m) approach by building a set from the smaller sequence\n    when possible. If elements are unhashable, it falls back to an O(n * m) equality check.\n    \"\"\"\n    # Materialize inputs to handle arbitrary iterables (lists, tuples, generators, etc.)\n    try:\n        a_list = list(a)\n        b_list = list(b)\n    except TypeError:\n        raise TypeError(\"Both arguments must be iterable\")\n\n    if not a_list or not b_list:\n        return False\n\n    # Use the smaller list for set construction (less memory + faster)\n    if len(a_list) <= len(b_list):\n        small, other = a_list, b_list\n    else:\n        small, other = b_list, a_list\n\n    # Try using a set for fast membership checks\n    try:\n        small_set = set(small)\n    except TypeError:\n        # Elements in `small` are unhashable -> fallback nested comparison\n        for x in small:\n            for y in other:\n                if x == y:\n                    return True\n        return False\n\n    # Use set membership; handle the unlikely case where some items in `other` are unhashable\n    for y in other:\n        try:\n            if y in small_set:\n                return True\n        except TypeError:\n            # y is unhashable; fallback to equality checks against `small`\n            for x in small:\n                if x == y:\n                    return True\n\n    return False"}
{"task_id": "Mbpp/415", "solution": "def max_Product(arr):\n    \"\"\"\n    Finds a pair with the highest product from a given array of integers.\n    The algorithm runs in O(N) time and O(1) space.\n    \"\"\"\n    max1 = float('-inf')  # Largest number\n    max2 = float('-inf')  # Second largest number\n    min1 = float('inf')   # Smallest number\n    min2 = float('inf')   # Second smallest number\n\n    for x in arr:\n        # Update largest and second largest\n        if x >= max1:\n            max2 = max1\n            max1 = x\n        elif x > max2:\n            max2 = x\n\n        # Update smallest and second smallest\n        if x <= min1:\n            min2 = min1\n            min1 = x\n        elif x < min2:\n            min2 = x\n\n    # Calculate the products of the two largest and two smallest numbers\n    prod_max_positives = max1 * max2\n    prod_max_negatives = min1 * min2\n\n    # Return the pair whose product is highest\n    if prod_max_positives >= prod_max_negatives:\n        # Return the pair with larger element first, to match assert style\n        # (Though not explicitly required by design, but common for canonical representation)\n        return (max2, max1) if max2 <= max1 else (max1, max2)\n    else:\n        # Return the pair with smaller element first\n        return (min1, min2) if min1 <= min2 else (min2, min1)"}
{"task_id": "Mbpp/418", "solution": "def Find_Max(input_list):\n    \"\"\"\n    Finds the element in a list that has the maximum length.\n    If multiple elements have the same maximum length, the first one encountered is returned.\n    \"\"\"\n    if not input_list:\n        return None\n\n    max_element = input_list[0]\n    try:\n        max_length = len(max_element)\n    except TypeError:\n        raise TypeError(f\"Element {max_element!r} does not support len()\")\n\n    for element in input_list[1:]:\n        try:\n            current_length = len(element)\n        except TypeError:\n            raise TypeError(f\"Element {element!r} does not support len()\")\n        if current_length > max_length:\n            max_length = current_length\n            max_element = element\n\n    return max_element"}
{"task_id": "Mbpp/419", "solution": "from typing import Sequence\ndef round_and_sum(numbers: Sequence[float]) -> int:\n    \"\"\"\n    Rounds every number in a list, sums the rounded values, and multiplies the sum\n    by the length of the original list.\n    \"\"\"\n    rounded_values_sum = sum(round(num) for num in numbers)\n    total_sum_multiplied_by_length = rounded_values_sum * len(numbers)\n    return total_sum_multiplied_by_length"}
{"task_id": "Mbpp/420", "solution": "def cube_Sum(n: int) -> int:\n    # Calculates the sum of cubes of the first n even natural numbers using a closed-form formula.\n    # The formula is: sum_{k=1..n} (2k)^3 = 8 * (n(n+1)/2)^2 = 2 * n^2 * (n+1)^2\n    return 2 * (n ** 2) * ((n + 1) ** 2)"}
{"task_id": "Mbpp/422", "solution": "def find_Average_Of_Cube(n):\n    \"\"\"Calculates the average of the cubes of the first n natural numbers.\"\"\"\n    # Validate input\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n    if n <= 0:\n        raise ValueError(\"n must be a positive integer\")\n    # Formula: average = n * (n + 1)^2 / 4\n    return (n * (n + 1) * (n + 1)) / 4.0"}
