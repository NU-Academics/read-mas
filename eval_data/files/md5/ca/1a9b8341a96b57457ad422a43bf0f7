{"task_id": "Mbpp/559", "solution": "def max_sub_array_sum(arr):\n    \"\"\"\n    Finds the sum of the largest contiguous sublist using Kadane's algorithm.\n    Returns 0 for an empty list, and the largest element for an all-negative list.\n    \"\"\"\n    if not arr:\n        return 0\n\n    max_so_far = arr[0]\n    current_max = arr[0]\n\n    for i in range(1, len(arr)):\n        current_max = max(arr[i], current_max + arr[i])\n        max_so_far = max(max_so_far, current_max)\n\n    return max_so_far"}
{"task_id": "Mbpp/558", "solution": "def digit_distance_nums(a: int, b: int) -> int:\n    \"\"\"\n    Calculates the sum of per-digit absolute differences between two integers.\n    Digits are aligned from the least significant side, and shorter numbers are padded with zeros.\n    \"\"\"\n    abs_a = abs(a)\n    abs_b = abs(b)\n\n    a_digits = []\n    if abs_a == 0:\n        a_digits.append(0)\n    else:\n        temp_a = abs_a\n        while temp_a > 0:\n            a_digits.append(temp_a % 10)\n            temp_a //= 10\n\n    b_digits = []\n    if abs_b == 0:\n        b_digits.append(0)\n    else:\n        temp_b = abs_b\n        while temp_b > 0:\n            b_digits.append(temp_b % 10)\n            temp_b //= 10\n\n    len_a = len(a_digits)\n    len_b = len(b_digits)\n\n    if len_a < len_b:\n        a_digits.extend([0] * (len_b - len_a))\n    elif len_b < len_a:\n        b_digits.extend([0] * (len_a - len_b))\n\n    total_distance = 0\n    for x, y in zip(a_digits, b_digits):\n        total_distance += abs(x - y)\n\n    return total_distance"}
{"task_id": "Mbpp/560", "solution": "from typing import Tuple, Any, Callable, Optional\ndef union_elements(t1: Tuple[Any, ...], t2: Tuple[Any, ...], key: Optional[Callable[[Any], Any]] = None) -> Tuple[Any, ...]:\n    \"\"\"\n    Finds the union of elements from two tuples and returns them in sorted order as a new tuple.\n    Duplicates are removed and elements are sorted using Python's default ordering or an optional key.\n    \"\"\"\n    combined_elements = set(t1) | set(t2)\n    sorted_elements = sorted(combined_elements, key=key)\n    return tuple(sorted_elements)"}
{"task_id": "Mbpp/562", "solution": "def Find_Max_Length(seq):\n    \"\"\"\n    Finds the length of the longest sublist within a list of lists.\n    Assumes `seq` is a list (or iterable) of sublists.\n    \"\"\"\n    max_len = 0\n    for sublist in seq:\n        current_len = len(sublist)\n        if current_len > max_len:\n            max_len = current_len\n    return max_len"}
{"task_id": "Mbpp/564", "solution": "import collections\ndef count_Pairs(values: list[int], n: int) -> int:\n    \"\"\"\n    Calculates the number of unordered pairs (i, j) where `i < j` and `values[i] != values[j]`.\n    This is computed by subtracting the count of equal-element pairs from the total possible unordered pairs.\n    \"\"\"\n    N = len(values)\n\n    if N < 2:\n        return 0\n\n    # Total possible unordered pairs of indices (i, j) where i < j.\n    total_pairs = N * (N - 1) // 2\n\n    # Count frequencies of each number in the list.\n    counts = collections.Counter(values)\n\n    # Calculate the number of unordered pairs of indices (i, j) where i < j\n    # and values[i] == values[j]. For each number appearing 'c' times, it forms\n    # c * (c - 1) / 2 such pairs.\n    equal_pairs_count = 0\n    for count in counts.values():\n        equal_pairs_count += count * (count - 1) // 2\n\n    # The result is the total pairs minus the pairs with equal elements.\n    return total_pairs - equal_pairs_count"}
{"task_id": "Mbpp/563", "solution": "import re\ndef extract_values(s: str) -> list[str]:\n    \"\"\"\n    Extracts values enclosed in double quotation marks from a string.\n    Handles escaped double quotes and backslashes within the values.\n    \"\"\"\n    # Regex to find double-quoted strings, capturing content within.\n    # It allows for escaped quotes (\\\") and escaped backslashes (\\\\) inside.\n    QUOTE_PATTERN = r'\\\"((?:\\\\.|[^\"\\\\])*)\\\"'\n\n    # Find all captured groups (the content within quotes)\n    raw_matches = re.findall(QUOTE_PATTERN, s)\n\n    # Unescape common escaped sequences for quotes and backslashes.\n    # Replace escaped backslash first to avoid double-unescaping sequences like \\\\\\\".\n    unescaped_values = [\n        match.replace(r'\\\\', '\\\\').replace(r'\\\"', '\"')\n        for match in raw_matches\n    ]\n\n    return unescaped_values"}
{"task_id": "Mbpp/567", "solution": "def issort_list(lst):\n    \"\"\"Checks if a list is sorted in non-decreasing order.\n\n    Returns True for empty or single-element lists.\n    \"\"\"\n    if lst is None:\n        raise TypeError(\"lst must be a sequence, got None\")\n    if len(lst) < 2:\n        return True\n\n    for i in range(len(lst) - 1):\n        if lst[i] > lst[i + 1]:\n            return False\n\n    return True"}
