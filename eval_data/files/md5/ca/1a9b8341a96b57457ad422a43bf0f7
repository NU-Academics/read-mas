{"task_id": "Mbpp/622", "solution": "from typing import List\ndef get_median(list1: List[float], list2: List[float], n: int) -> float:\n    \"\"\"\n    Finds the median of two sorted lists of the same size using a divide-and-conquer approach.\n    \"\"\"\n    if n == 0:\n        return 0.0  # undefined for empty lists; keeping safe return per prompt assumptions\n\n    if n == 1:\n        return (list1[0] + list2[0]) / 2.0\n\n    if n == 2:\n        # The median of 4 elements (two from each list) is the average of the two middle elements.\n        return (max(list1[0], list2[0]) + min(list1[1], list2[1])) / 2.0\n\n    # Find medians of the current sub-arrays\n    m1_idx = (n - 1) // 2\n    m1 = list1[m1_idx]\n\n    m2_idx = (n - 1) // 2\n    m2 = list2[m2_idx]\n\n    # k is the number of elements to discard from the beginning/end of each list.\n    k = n // 2\n\n    if m1 == m2:\n        return float(m1)\n    elif m1 < m2:\n        # The median must lie in list1[k:] and list2[:n-k].\n        # Discard first k elements from list1 and last k elements from list2.\n        return get_median(list1[k:], list2[:n - k], n - k)\n    else:  # m1 > m2\n        # The median must lie in list1[:n-k] and list2[k:].\n        # Discard last k elements from list1 and first k elements from list2.\n        return get_median(list1[:n - k], list2[k:], n - k)"}
{"task_id": "Mbpp/620", "solution": "def largest_subset(nums: list[int]) -> int:\n    \"\"\"\n    Return the size of the largest subset in which every pair (a, b) satisfies\n    either a % b == 0 or b % a == 0.\n    \"\"\"\n    if not nums:\n        return 0\n\n    def compatible(a: int, b: int) -> bool:\n        # Returns True if a and b satisfy the divisibility condition, handling zeros safely.\n        if a == 0 and b == 0:\n            return True\n        if b != 0 and a % b == 0:\n            return True\n        if a != 0 and b % a == 0:\n            return True\n        return False\n\n    # Deterministic ordering: sort by absolute value then by sign (non-negative before negative)\n    nums_sorted = sorted(nums, key=lambda n: (abs(n), 0 if n >= 0 else 1))\n\n    n = len(nums_sorted)\n    dp = [1] * n  # dp[i] = length of largest valid subset ending at i\n    max_len = 1\n\n    for i in range(n):\n        for j in range(i):\n            if compatible(nums_sorted[i], nums_sorted[j]) and dp[j] + 1 > dp[i]:\n                dp[i] = dp[j] + 1\n        if dp[i] > max_len:\n            max_len = dp[i]\n\n    return max_len"}
