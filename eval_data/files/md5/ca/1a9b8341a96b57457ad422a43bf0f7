{"task_id": "Mbpp/793", "solution": "def last(array, target):\n    \"\"\"\n    Finds the last position of a target element in a sorted array.\n    Returns the index or -1 if the target is not found.\n    \"\"\"\n    low = 0\n    high = len(array) - 1\n    result = -1\n\n    while low <= high:\n        mid = (low + high) // 2\n        if array[mid] == target:\n            result = mid\n            low = mid + 1  # Continue searching in the right half for further occurrences\n        elif array[mid] < target:\n            low = mid + 1\n        else:\n            high = mid - 1\n\n    return result"}
{"task_id": "Mbpp/794", "solution": "import re\ndef text_starta_endb(text: str) -> bool:\n    \"\"\"\n    Determines if a string starts with 'a' and ends with 'b', with any content in between.\n    Uses a regular expression for case-sensitive matching.\n    \"\"\"\n    pattern = r\"^a.*b$\"\n    return bool(re.match(pattern, text))"}
{"task_id": "Mbpp/797", "solution": "def sum_in_range(l, r):\n    \"\"\"\n    Calculates the sum of all odd natural numbers within the inclusive range [l, r].\n    Natural numbers are considered integers >= 1.\n    \"\"\"\n    # Helper to calculate the sum of odd natural numbers up to a given number 'n'.\n    # The count of odd numbers up to 'n' is (n + 1) // 2. The sum of the first 'k' odd numbers is k*k.\n    def _calculate_sum_of_odds_up_to(n_val):\n        if n_val < 1:\n            return 0\n        count_of_odds = (n_val + 1) // 2\n        return count_of_odds * count_of_odds\n\n    # Normalize the lower bound: natural numbers start from 1.\n    normalized_l = max(l, 1)\n\n    # If the normalized lower bound is greater than the upper bound, the range is empty.\n    if normalized_l > r:\n        return 0\n\n    # Calculate the sum of odd numbers from 1 up to 'r'.\n    sum_up_to_r = _calculate_sum_of_odds_up_to(r)\n\n    # Calculate the sum of odd numbers from 1 up to 'normalized_l - 1'.\n    # This value will be subtracted to exclude numbers below the range's start.\n    sum_up_to_l_minus_1 = _calculate_sum_of_odds_up_to(normalized_l - 1)\n\n    return sum_up_to_r - sum_up_to_l_minus_1"}
