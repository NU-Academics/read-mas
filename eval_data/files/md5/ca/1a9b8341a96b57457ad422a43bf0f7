{"task_id": "Mbpp/572", "solution": "from typing import Any, Iterable, Iterator, List\nfrom collections import Counter\nclass InvalidInputError(ValueError):\n    \"\"\"Custom exception for invalid input values or formats.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\ndef is_iterable_but_not_str(obj: Any) -> bool:\n    \"\"\"Checks if an object is iterable but not a string or bytes.\"\"\"\n    try:\n        iter(obj)\n    except TypeError:\n        return False\n    return not isinstance(obj, (str, bytes))\ndef validate_and_convert(value: Any) -> int:\n    \"\"\"Converts a value to an integer, raising an error for invalid types.\"\"\"\n    if isinstance(value, int):\n        return value\n    if isinstance(value, float):\n        if value.is_integer():\n            return int(value)\n        raise InvalidInputError(f\"Float {value} is not an integer\")\n    try:\n        return int(value)\n    except Exception:\n        raise InvalidInputError(f\"Cannot convert {value!r} to int\")\ndef two_unique_nums(*inputs: Any) -> List[int]:\n    \"\"\"\n    Removes duplicate numbers from a given number of lists, returning only those\n    that appear exactly once, preserving their first-seen order.\n    \"\"\"\n\n    # Inlined ListRepository.flatten_inputs logic\n    def _flatten_inputs(inputs_args: Iterable[Any]) -> Iterator[int]:\n        if len(inputs_args) == 0:\n            raise InvalidInputError(\"No inputs provided\")\n\n        is_single_arg_iterable = len(inputs_args) == 1 and is_iterable_but_not_str(inputs_args[0])\n\n        if is_single_arg_iterable:\n            # Buffer the first argument to ensure re-iterability for checks and loops.\n            buffered_arg = list(inputs_args[0])\n\n            # Heuristic: if the single argument is an iterable containing other iterables,\n            # treat it as a list-of-lists.\n            if any(is_iterable_but_not_str(x) for x in buffered_arg):\n                for sub_iterable in buffered_arg:\n                    if not is_iterable_but_not_str(sub_iterable):\n                        raise InvalidInputError(\"Expected nested iterables when input is a list-of-lists structure\")\n                    for item in sub_iterable:\n                        yield validate_and_convert(item)\n                return\n\n        # Otherwise, treat each positional argument as an independent iterable.\n        for arg in inputs_args:\n            if not is_iterable_but_not_str(arg):\n                raise InvalidInputError(\"Each input must be an iterable of integers\")\n            for item in arg:\n                yield validate_and_convert(item)\n\n    # Inlined UniqueNumberService.find_uniques logic\n    def _find_uniques(values_iterable: Iterable[int]) -> List[int]:\n        counts = Counter()\n        order = []\n        seen = set()\n        for v in values_iterable:\n            counts[v] += 1\n            if v not in seen:\n                order.append(v)\n                seen.add(v)\n        return [v for v in order if counts[v] == 1]\n\n    # Main logic flow, coordinating flattening and uniqueness finding\n    flattened_values = _flatten_inputs(inputs)\n    result = _find_uniques(flattened_values)\n    return result"}
{"task_id": "Mbpp/577", "solution": "def last_Digit_Factorial(n: int) -> int:\n    \"\"\"\n    Return the last decimal digit of n! for a non-negative integer n.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n    if n < 0:\n        raise ValueError(\"n must be non-negative\")\n\n    # For n >= 10, n! contains at least one factor 10 (2*5) so last digit is 0.\n    if n >= 10:\n        return 0\n\n    acc = 1\n    for i in range(2, n + 1):\n        acc = (acc * i) % 10\n    return acc"}
{"task_id": "Mbpp/576", "solution": "def is_Sub_Array(haystack, needle):\n    \"\"\"\n    Return True if `needle` is a contiguous sublist of `haystack`, else False.\n\n    Both arguments should be lists or tuples. An empty `needle` is considered a sublist\n    of any `haystack` (returns True).\n    \"\"\"\n    # Basic validation\n    if not isinstance(haystack, (list, tuple)):\n        raise TypeError(\"haystack must be a list or tuple\")\n    if not isinstance(needle, (list, tuple)):\n        raise TypeError(\"needle must be a list or tuple\")\n\n    # Empty needle is always a sublist\n    if len(needle) == 0:\n        return True\n    # Needle longer than haystack cannot be a sublist\n    if len(needle) > len(haystack):\n        return False\n\n    # Build LPS (longest proper prefix which is also suffix) for KMP\n    def _build_lps(pattern):\n        lps = [0] * len(pattern)\n        length = 0  # length of the previous longest prefix suffix\n        i = 1\n        while i < len(pattern):\n            if pattern[i] == pattern[length]:\n                length += 1\n                lps[i] = length\n                i += 1\n            else:\n                if length != 0:\n                    length = lps[length - 1]\n                else:\n                    lps[i] = 0\n                    i += 1\n        return lps\n\n    lps = _build_lps(needle)\n\n    # KMP search\n    i = 0  # index for haystack\n    j = 0  # index for needle (pattern)\n    while i < len(haystack):\n        if haystack[i] == needle[j]:\n            i += 1\n            j += 1\n            if j == len(needle):\n                return True\n        else:\n            if j != 0:\n                j = lps[j - 1]\n            else:\n                i += 1\n\n    return False"}
{"task_id": "Mbpp/578", "solution": "def interleave_lists(a, b, c):\n    \"\"\"\n    Interleaves three lists of the same length into a single flat list.\n    Elements are taken sequentially from each list (a[i], b[i], c[i]).\n    \"\"\"\n    n = len(a)\n    result = []\n    for i in range(n):\n        result.append(a[i])\n        result.append(b[i])\n        result.append(c[i])\n    return result"}
{"task_id": "Mbpp/579", "solution": "def find_dissimilar(a, b):\n    \"\"\"\n    Finds elements that are present in exactly one of the two input tuples,\n    preserving their original order from the respective input tuple.\n    \"\"\"\n    set_a = set(a)\n    set_b = set(b)\n\n    result_list = []\n    # Tracks elements already added to the result to prevent duplicates in output\n    seen_in_result = set()\n\n    # Add elements unique to 'a' in their original order\n    for item in a:\n        if item not in set_b and item not in seen_in_result:\n            result_list.append(item)\n            seen_in_result.add(item)\n\n    # Add elements unique to 'b' in their original order\n    for item in b:\n        if item not in set_a and item not in seen_in_result:\n            result_list.append(item)\n            seen_in_result.add(item)\n\n    return tuple(result_list)"}
{"task_id": "Mbpp/580", "solution": "def extract_even(input_tuple: Tuple[Any, ...]) -> Tuple[Any, ...]:\n    \"\"\"Recursively removes odd integer elements from a nested mixed tuple.\n    Preserves even integers, non-integer elements, and tuple structure.\"\"\"\n    from typing import Any, Tuple, Set, List\n\n    def _is_int(obj: Any) -> bool:\n        # Helper function for robustly checking if an object is an integer (excluding booleans).\n        return isinstance(obj, int) and not isinstance(obj, bool)\n\n    def _is_tuple(obj: Any) -> bool:\n        # Helper function for checking if an object is a tuple.\n        return isinstance(obj, tuple)\n\n    def _process(element: Any, seen: Set[int]) -> Any:\n        if _is_int(element):\n            return element if element % 2 == 0 else None\n\n        elif _is_tuple(element):\n            if id(element) in seen:\n                # Handle cyclic tuples by returning an empty tuple to prevent infinite recursion.\n                return ()\n            seen.add(id(element))\n\n            processed_children: List[Any] = []\n            for child in element:\n                result = _process(child, seen)\n                if result is not None:\n                    processed_children.append(result)\n\n            # Backtrack: remove ID from set as processing of this tuple is complete.\n            seen.remove(id(element))\n            return tuple(processed_children)\n\n        else:\n            # Preserve non-int, non-tuple elements as per design.\n            return element\n\n    initial_seen: Set[int] = set()\n    final_elements: List[Any] = []\n    for item in input_tuple:\n        processed_item = _process(item, initial_seen)\n        if processed_item is not None:\n            final_elements.append(processed_item)\n\n    return tuple(final_elements)"}
{"task_id": "Mbpp/585", "solution": "def expensive_items(items, n):\n    \"\"\"\n    Finds the n most expensive items in a list of dictionaries.\n    Items are sorted by 'price' in descending order.\n    \"\"\"\n    # Basic validation\n    if not isinstance(items, (list, tuple)):\n        raise TypeError(\"items must be a list or tuple of dicts\")\n    try:\n        n_val = int(n)\n    except Exception:\n        raise TypeError(\"n must be an integer or convertible to int\")\n    if n_val < 0:\n        raise ValueError(\"n must be non-negative\")\n\n    if n_val == 0:\n        return []\n\n    # Validate each item has a numeric 'price' key and is a dict\n    validated = []\n    for idx, it in enumerate(items):\n        if not isinstance(it, dict):\n            raise TypeError(f\"item at index {idx} is not a dict\")\n        if 'price' not in it:\n            raise KeyError(f\"item at index {idx} is missing 'price'\")\n        price = it['price']\n        if not isinstance(price, (int, float)):\n            raise TypeError(f\"'price' for item at index {idx} must be a number\")\n        validated.append((idx, it))\n\n    # Stable sort by price descending; use original index to break ties deterministically\n    sorted_items = sorted(\n        validated,\n        key=lambda pair: (-pair[1]['price'], pair[0])\n    )\n\n    # Return original dicts for top n\n    top = [pair[1] for pair in sorted_items[:n_val]]\n    return top"}
{"task_id": "Mbpp/586", "solution": "def split_Arr(items, n):\n    \"\"\"\n    Splits a list at the nth element and moves the first part to the end.\n    Handles negative indices and indices beyond list length by wrapping around.\n    \"\"\"\n    if not items:\n        return []\n\n    length = len(items)\n    split_point = n % length\n\n    return items[split_point:] + items[:split_point]"}
