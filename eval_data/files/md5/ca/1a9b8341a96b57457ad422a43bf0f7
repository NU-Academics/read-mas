{"task_id": "Mbpp/113", "solution": "import unicodedata\ndef _is_ascii_digit(ch: str) -> bool:\n    \"\"\"Checks if a character is an ASCII digit ('0'-'9').\"\"\"\n    return '0' <= ch <= '9'\ndef _strip_sign(s: str) -> tuple[str, str | None]:\n    \"\"\"Removes a leading '+' or '-' if present, returning the remainder and the sign.\"\"\"\n    SIGN_CHARS = \"+-\"\n    if not s:\n        return s, None\n    if s[0] in SIGN_CHARS:\n        return s[1:], s[0]\n    return s, None\ndef _unicode_to_ascii_digits(s: str) -> tuple[str, bool]:\n    \"\"\"Converts Unicode digits to ASCII '0'-'9' where possible. Returns converted string and a flag indicating conversion.\"\"\"\n    converted_chars = []\n    converted = False\n    for char in s:\n        try:\n            numeric_value = unicodedata.numeric(char)\n            if numeric_value == int(numeric_value) and 0 <= int(numeric_value) <= 9:\n                ascii_digit = str(int(numeric_value))\n                if ascii_digit != char:\n                    converted = True\n                converted_chars.append(ascii_digit)\n            else:\n                converted_chars.append(char)\n        except ValueError:\n            converted_chars.append(char)\n    return \"\".join(converted_chars), converted\ndef check_integer(s: str) -> bool:\n    \"\"\"Checks if a string represents a base-10 integer, supporting Unicode digits and optional sign.\"\"\"\n\n    processed_s = s.strip()\n\n    if not processed_s:\n        return False\n\n    processed_s, _ = _strip_sign(processed_s)\n\n    if not processed_s: # Empty after stripping sign (e.g., \"+\", \"-\")\n        return False\n\n    # The design specifies allow_unicode=True by default for the public API.\n    allow_unicode = True\n    if allow_unicode:\n        processed_s, _ = _unicode_to_ascii_digits(processed_s)\n\n    return all(_is_ascii_digit(ch) for ch in processed_s)"}
{"task_id": "Mbpp/120", "solution": "def max_product_tuple(pairs):\n    \"\"\"\n    Compute the maximum absolute product obtainable by taking one number from each\n    of two distinct 2-element tuples in the input list `pairs`.\n\n    Example:\n        assert max_product_tuple([(2, 7), (2, 6), (1, 8), (4, 9)]) == 36\n    \"\"\"\n    if not isinstance(pairs, (list, tuple)):\n        raise ValueError(\"pairs must be a list or tuple of 2-element tuples/lists\")\n\n    n = len(pairs)\n    if n < 2:\n        raise ValueError(\"At least two pairs are required to compute a product\")\n\n    max_abs_product = 0.0\n\n    for i in range(n):\n        p1 = pairs[i]\n        if not (isinstance(p1, (list, tuple)) and len(p1) == 2):\n            raise ValueError(f\"Each item in pairs must be a 2-element tuple/list; item at index {i} is invalid\")\n        try:\n            a0 = float(p1[0])\n            a1 = float(p1[1])\n        except Exception as exc:\n            raise ValueError(f\"Non-numeric element in pair at index {i}: {exc}\") from exc\n\n        for j in range(i + 1, n):\n            p2 = pairs[j]\n            if not (isinstance(p2, (list, tuple)) and len(p2) == 2):\n                raise ValueError(f\"Each item in pairs must be a 2-element tuple/list; item at index {j} is invalid\")\n            try:\n                b0 = float(p2[0])\n                b1 = float(p2[1])\n            except Exception as exc:\n                raise ValueError(f\"Non-numeric element in pair at index {j}: {exc}\") from exc\n\n            cur = max(\n                abs(a0 * b0),\n                abs(a0 * b1),\n                abs(a1 * b0),\n                abs(a1 * b1),\n            )\n            if cur > max_abs_product:\n                max_abs_product = cur\n\n    return max_abs_product"}
{"task_id": "Mbpp/123", "solution": "class NumberUtils:\n    \"\"\"Provides number theory utility functions.\"\"\"\n    def sum_proper_divisors(self, n: int) -> int:\n        if n <= 1:\n            return 0\n        s = 1\n        i = 2\n        while i * i <= n:\n            if n % i == 0:\n                s += i\n                j = n // i\n                if j != i:\n                    s += j\n            i += 1\n        return s\nclass CacheRepository:\n    \"\"\"In-memory cache for divisor sums.\"\"\"\n    def __init__(self) -> None:\n        self._store: dict[int,int] = {}\n\n    def get(self, n: int) -> int | None:\n        return self._store.get(n)\n\n    def set(self, n: int, value: int) -> None:\n        self._store[n] = value\n\n    def clear(self) -> None:\n        self._store.clear()\nclass AmicableFinder:\n    \"\"\"Finds amicable pairs up to a given limit.\"\"\"\n    def __init__(self, repo: CacheRepository, utils: NumberUtils) -> None:\n        self.repo = repo\n        self.utils = utils\n\n    def _amicable_candidate(self, a: int) -> int:\n        \"\"\"Gets sum of proper divisors for 'a', using cache or computing.\"\"\"\n        v = self.repo.get(a)\n        if v is None:\n            v = self.utils.sum_proper_divisors(a)\n            self.repo.set(a, v)\n        return v\n\n    def find_amicable_pairs(self, limit: int) -> list[tuple[int,int]]:\n        \"\"\"Finds all amicable pairs where both numbers are <= limit.\"\"\"\n        seen = set()\n        pairs = []\n        for a in range(2, limit + 1):\n            b = self._amicable_candidate(a)\n            if b == a:\n                continue\n            if b > limit:\n                continue\n\n            d_b = self._amicable_candidate(b)\n            if d_b == a:\n                pair = tuple(sorted((a, b)))\n                if pair not in seen:\n                    seen.add(pair)\n                    pairs.append(pair)\n        return pairs\nclass AmicableService:\n    \"\"\"Orchestrates finding and summing amicable numbers.\"\"\"\n    def __init__(self, finder: AmicableFinder, repo: CacheRepository) -> None:\n        self.finder = finder\n        self.repo = repo\n\n    def compute_sum(self, limit: int) -> int:\n        \"\"\"Computes the sum of amicable numbers up to the limit.\"\"\"\n        pairs = self.finder.find_amicable_pairs(limit)\n        return sum(set(x for p in pairs for x in p))\nclass AmicableController:\n    \"\"\"API wrapper for amicable number computation.\"\"\"\n    def __init__(self, service: AmicableService) -> None:\n        self.service = service\n\n    def handle(self, limit: int) -> int:\n        \"\"\"Handles the request to compute the sum of amicable numbers.\"\"\"\n        return self.service.compute_sum(limit)\n_repo = CacheRepository()\n_utils = NumberUtils()\n_finder = AmicableFinder(repo=_repo, utils=_utils)\n_service = AmicableService(finder=_finder, repo=_repo)\n_controller = AmicableController(service=_service)\ndef amicable_numbers_sum(limit: int) -> int:\n    \"\"\"Sums all amicable numbers from 1 to the specified limit.\"\"\"\n    return _controller.handle(limit)"}
