{"task_id": "Mbpp/170", "solution": "def sum_range_list(list_obj, start_index, end_index):\n    \"\"\"\n    Calculates the sum of numbers in a list within a specified range, inclusive of both indices.\n    If the start index is greater than the end index, they are swapped.\n    \"\"\"\n    if start_index > end_index:\n        start_index, end_index = end_index, start_index\n\n    # Python slicing is exclusive of the end index, so we add 1 to include the end_index element.\n    # Python slicing naturally handles negative indices and out-of-bounds indices by clamping them.\n    return sum(list_obj[start_index : end_index + 1])"}
{"task_id": "Mbpp/168", "solution": "def frequency(items, target):\n    \"\"\"\n    Counts the number of occurrences of a target number in a given list.\n    \"\"\"\n    count = 0\n    for item in items:\n        if item == target:\n            count += 1\n    return count"}
{"task_id": "Mbpp/224", "solution": "def count_Set_Bits(n: int) -> int:\n    \"\"\"\n    Counts the number of set bits (1s) in the binary representation of an integer using Brian Kernighan's algorithm.\n    Negative input integers are treated as their absolute values.\n    \"\"\"\n    if not isinstance(n, int):\n        raise ValueError(\"Input must be an integer\")\n\n    if n < 0:\n        n = abs(n)\n\n    count = 0\n    while n:\n        n &= n - 1\n        count += 1\n    return count"}
{"task_id": "Mbpp/172", "solution": "def count_occurance(text: str) -> int:\n    \"\"\"\n    Counts the non-overlapping occurrences of the string 'std' in the given text.\n    \"\"\"\n    count = 0\n    start = 0\n    pattern = 'std'\n    while True:\n        idx = text.find(pattern, start)\n        if idx == -1:\n            break\n        count += 1\n        start = idx + len(pattern)\n    return count"}
{"task_id": "Mbpp/222", "solution": "def check_type(items):\n    \"\"\"\n    Checks if all elements in the given tuple have the same data type.\n    An empty tuple is considered to have all elements of the same type (vacuously true).\n    \"\"\"\n    if not items:\n        return True\n\n    first_type = type(items[0])\n    for item in items[1:]:\n        if type(item) is not first_type:\n            return False\n    return True"}
{"task_id": "Mbpp/223", "solution": "def is_majority(arr, n, x):\n    \"\"\"\n    Checks if an element x is the majority element in a sorted array.\n    A majority element occurs more than n/2 times.\n    \"\"\"\n    if n == 0:\n        return False\n\n    # Validate provided length matches actual array length when possible\n    if len(arr) != n:\n        raise ValueError(\"Provided length n does not match length of arr\")\n\n    # Find the first occurrence of x using binary search.\n    low, high = 0, n - 1\n    first_occurrence_idx = -1\n\n    while low <= high:\n        mid = (low + high) // 2\n        if arr[mid] == x:\n            first_occurrence_idx = mid\n            high = mid - 1  # Search in the left half for an earlier occurrence\n        elif arr[mid] < x:\n            low = mid + 1\n        else:  # arr[mid] > x\n            high = mid - 1\n\n    # If x is not found, it cannot be a majority element.\n    if first_occurrence_idx == -1:\n        return False\n\n    # The majority element must occur more than n/2 times.\n    # This means if x starts at first_occurrence_idx, the element at\n    # (first_occurrence_idx + n // 2) must also be x and within bounds.\n    check_idx = first_occurrence_idx + n // 2\n\n    return check_idx < n and arr[check_idx] == x"}
