{"task_id": "Mbpp/787", "solution": "import re\nfrom typing import Optional, Dict, Any, List\nclass Config:\n    DEFAULT_PATTERN: str = r\"abbb\"\n    DEFAULT_REGEX_FLAGS: int = 0\n    PACKAGE_NAME: str = \"single_agent\"\nclass TextMatchError(Exception):\n    def __init__(self, message: str, original: Optional[Exception] = None) -> None:\n        super().__init__(message)\n        self.message = message\n        self.original = original\nclass Utils:\n    @staticmethod\n    def validate_text(text: Any) -> str:\n        if isinstance(text, str):\n            return text\n        if isinstance(text, bytes):\n            try:\n                return text.decode('utf-8')\n            except UnicodeDecodeError as e:\n                raise TextMatchError(f\"Cannot decode bytes input to UTF-8: {Utils.safe_str(text)}\", e)\n        raise TextMatchError(f\"Invalid input type. Expected str or bytes, got {type(text).__name__}.\")\n\n    @staticmethod\n    def safe_str(obj: Any) -> str:\n        try:\n            return str(obj)\n        except Exception:\n            return \"<unrepresentable object>\"\nclass TextMatchRequest:\n    def __init__(self, text: str) -> None:\n        self.text = text\nclass TextMatchResult:\n    def __init__(self, matched: bool, match_text: Optional[str] = None) -> None:\n        self.matched = matched\n        self.match_text = match_text\nclass RegexRepository:\n    def __init__(self) -> None:\n        self._cache: Dict[str, re.Pattern] = {}\n\n    def get_compiled(self, pattern: str, flags: int = Config.DEFAULT_REGEX_FLAGS) -> re.Pattern:\n        key = f\"{pattern}::{flags}\"\n        if key in self._cache:\n            return self._cache[key]\n        try:\n            compiled = re.compile(pattern, flags)\n        except re.error as e:\n            raise TextMatchError(f\"Invalid regex pattern: {pattern}\", e)\n        self._cache[key] = compiled\n        return compiled\n\n    def clear_cache(self) -> None:\n        self._cache.clear()\nclass TextMatchService:\n    def __init__(self, regex_repo: RegexRepository, pattern: Optional[str] = None) -> None:\n        self._regex_repo = regex_repo\n        self._pattern = pattern or Config.DEFAULT_PATTERN\n\n    def match(self, request: TextMatchRequest) -> TextMatchResult:\n        text_to_search = request.text\n\n        try:\n            compiled_pattern = self._regex_repo.get_compiled(self._pattern, Config.DEFAULT_REGEX_FLAGS)\n            match_obj = compiled_pattern.search(text_to_search)\n            if match_obj:\n                return TextMatchResult(matched=True, match_text=match_obj.group(0))\n            else:\n                return TextMatchResult(matched=False)\n        except TextMatchError:\n            raise\n        except Exception as e:\n            raise TextMatchError(f\"An unexpected error occurred during text matching: {e}\", e)\n\n    def text_match(self, text: Any) -> bool:\n        validated_text = Utils.validate_text(text)\n        request = TextMatchRequest(validated_text)\n        result = self.match(request)\n        return result.matched\n_default_repo = RegexRepository()\n_default_service = TextMatchService(_default_repo)\ndef text_match_three(text: str) -> bool:\n    \"\"\"\n    Checks if the input string contains the substring \"abbb\".\n    \"\"\"\n    return _default_service.text_match(text)"}
