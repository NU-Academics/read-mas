{"task_id": "Mbpp/632", "solution": "def move_zero(lst: list) -> list:\n    \"\"\"Moves all zeroes to the end of the list, preserving the order of non-zero elements.\"\"\"\n    result = []\n    zero_count = 0\n    for v in lst:\n        if v == 0:\n            zero_count += 1\n        else:\n            result.append(v)\n    result.extend([0] * zero_count)\n    return result"}
{"task_id": "Mbpp/633", "solution": "from typing import Sequence, List, Optional\ndef bit_width(value: int) -> int:\n    \"\"\"Returns the minimum number of bits to represent a non-negative integer.\"\"\"\n    if value == 0:\n        return 0\n    if value < 0:\n        value = abs(value)\n    return value.bit_length()\ndef infer_bit_limit(arr: Sequence[int], default_limit: int = 31) -> int:\n    \"\"\"Infers an appropriate bit limit based on the maximum value in the array.\"\"\"\n    max_bits = 0\n    for v in arr:\n        bw = bit_width(v)\n        if bw > max_bits:\n            max_bits = bw\n    return max(max_bits, default_limit)\nclass PairXorCalculator:\n    \"\"\"Calculates the sum of XOR of all pairs using a bit-counting approach.\"\"\"\n    DEFAULT_BIT_LIMIT = 31\n\n    def compute(self, arr: Sequence[int], bit_limit: Optional[int] = None) -> int:\n        \"\"\"Computes the sum of XORs for all unique unordered pairs.\"\"\"\n        if bit_limit is None:\n            bit_limit = infer_bit_limit(arr, self.DEFAULT_BIT_LIMIT)\n        n = len(arr)\n\n        # Handle cases with fewer than 2 elements, where no pairs can be formed.\n        if n < 2:\n            return 0\n\n        bit_counts: List[int] = [0] * bit_limit\n        for v in arr:\n            for b in range(bit_limit):\n                if (v >> b) & 1:\n                    bit_counts[b] += 1\n        return self._compute_for_bit_counts(bit_counts, n)\n\n    def _compute_for_bit_counts(self, bit_counts: List[int], n: int) -> int:\n        \"\"\"Calculates the total XOR sum from bit counts per position.\"\"\"\n        total = 0\n        for b, cnt in enumerate(bit_counts):\n            # The contribution for each bit position is (count of set bits) * (count of unset bits) * (2^bit_position).\n            total += cnt * (n - cnt) * (1 << b)\n        return total\ndef pair_xor_Sum(arr, n):\n    \"\"\"Finds the sum of xor of all pairs of numbers in the given list.\"\"\"\n    # The 'n' parameter from the stub is not explicitly used by the calculator,\n    # as it derives array length internally. Input validation is omitted based on constraints.\n    calc = PairXorCalculator()\n    return calc.compute(list(arr))"}
{"task_id": "Mbpp/635", "solution": "from typing import Sequence, List, Union, Any, Optional\nNumber = Union[int, float]\nclass ValidationError(Exception):\n    \"\"\"Exception raised for invalid input data.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\nclass SortRequest:\n    \"\"\"DTO for sort requests.\"\"\"\n    def __init__(self, data: List[Number]) -> None:\n        self.data = data\nclass SortResult:\n    \"\"\"DTO for sort results.\"\"\"\n    def __init__(self, sorted_data: List[Number]) -> None:\n        self.sorted_data = sorted_data\nclass ListAdapter:\n    \"\"\"Adapts various sequences to a List[Number].\"\"\"\n    def to_list(self, input_seq: Sequence[Any]) -> List[Number]:\n        return list(input_seq)\nclass Validator:\n    \"\"\"Provides validation for sequences and their elements.\"\"\"\n    def validate_sequence(self, seq: Any) -> None:\n        try:\n            iter(seq)\n        except TypeError:\n            raise ValidationError(\"Input is not iterable\")\n\n    def validate_elements_numeric(self, seq: Sequence[Any]) -> None:\n        for i, v in enumerate(seq):\n            if not isinstance(v, (int, float)):\n                raise ValidationError(f\"Element at index {i} not numeric: {v}\")\n\n    def validate_length(self, seq: Sequence[Any], max_length: Optional[int] = None) -> None:\n        if max_length is not None and len(seq) > max_length:\n            raise ValidationError(f\"Input sequence exceeds maximum allowed length of {max_length}\")\nclass HeapSorter:\n    \"\"\"Implements the heap sort algorithm.\"\"\"\n    def __init__(self):\n        self._name = \"HeapSorter\"\n\n    def _sift_down(self, data: List[Number], start: int, end: int) -> None:\n        \"\"\"Helper to maintain heap property by sifting an element down.\"\"\"\n        root = start\n        while True:\n            child = 2 * root + 1\n            if child > end:\n                break\n            if child + 1 <= end and data[child] < data[child + 1]:\n                child += 1\n            if data[root] < data[child]:\n                data[root], data[child] = data[child], data[root]\n                root = child\n            else:\n                break\n\n    def _build_max_heap(self, data: List[Number]) -> None:\n        \"\"\"Converts a list into a max-heap in-place.\"\"\"\n        n = len(data)\n        for i in range(n // 2 - 1, -1, -1):\n            self._sift_down(data, i, n - 1)\n\n    def sort(self, data: List[Number]) -> List[Number]:\n        \"\"\"Sorts a list of numbers using heap sort, returning a new sorted list.\"\"\"\n        arr = list(data)\n        n = len(arr)\n        if n <= 1:\n            return arr\n        self._build_max_heap(arr)\n        for end in range(n - 1, 0, -1):\n            arr[0], arr[end] = arr[end], arr[0]\n            self._sift_down(arr, 0, end - 1)\n        return arr\nclass SortService:\n    \"\"\"Orchestrates validation, adaptation, and algorithm invocation.\"\"\"\n    def __init__(self, adapter: ListAdapter, validator: Validator, algorithm: HeapSorter) -> None:\n        self._adapter = adapter\n        self._validator = validator\n        self._algorithm = algorithm\n\n    def sort(self, request: SortRequest) -> SortResult:\n        \"\"\"Validates request data, sorts it, and returns a SortResult.\"\"\"\n        self._validator.validate_sequence(request.data)\n        self._validator.validate_elements_numeric(request.data)\n        sorted_list = self._algorithm.sort(request.data)\n        return SortResult(sorted_list)\ndef heap_sort(data: Sequence[Number]) -> List[Number]:\n    \"\"\"\n    Sorts a sequence of numbers using the heap sort algorithm.\n    Returns a new list with elements sorted in ascending order.\n    \"\"\"\n    adapter = ListAdapter()\n    validator = Validator()\n    algorithm = HeapSorter()\n    service = SortService(adapter, validator, algorithm)\n\n    normalized_data = adapter.to_list(data)\n    validator.validate_sequence(normalized_data)\n    validator.validate_elements_numeric(normalized_data)\n\n    request = SortRequest(normalized_data)\n    result = service.sort(request)\n\n    return result.sorted_data"}
{"task_id": "Mbpp/637", "solution": "def noprofit_noloss(amount, loss):\n    \"\"\"\n    Checks if the given amount has no profit and no loss.\n    This means the selling price (amount) equals the cost price (loss) within a small tolerance.\n\n    Args:\n        amount: numeric selling price\n        loss: numeric cost price\n\n    Returns:\n        bool: True if no profit and no loss, False otherwise\n\n    Raises:\n        ValueError: if inputs are not numeric or are NaN/Infinite\n    \"\"\"\n    import math\n\n    DEFAULT_TOLERANCE = 1e-9\n\n    try:\n        a = float(amount)\n        b = float(loss)\n    except (TypeError, ValueError):\n        raise ValueError(\"Both amount and loss must be numeric\") from None\n\n    if math.isinf(a) or math.isinf(b) or math.isnan(a) or math.isnan(b):\n        raise ValueError(\"Both amount and loss must be finite numbers\")\n\n    return abs(a - b) <= DEFAULT_TOLERANCE"}
{"task_id": "Mbpp/639", "solution": "def sample_nam(names: list[str]) -> int:\n    \"\"\"\n    Sums the length of names from a list, excluding those that start with a lowercase ASCII letter.\n    Empty strings are included with a length of 0.\n    \"\"\"\n    total_length = 0\n    for name in names:\n        if not name or not ('a' <= name[0] <= 'z'):\n            total_length += len(name)\n    return total_length"}
{"task_id": "Mbpp/638", "solution": "import math\ndef wind_chill(velocity_kmh, temp_c):\n    \"\"\"\n    Calculates the wind chill index using the Canadian/Environment Canada formula,\n    rounded to the nearest integer (half-up).\n    \"\"\"\n    FORMULA_COEF_A = 13.12\n    FORMULA_COEF_B = 0.6215\n    FORMULA_COEF_C = 11.37\n    FORMULA_COEF_D = 0.3965\n\n    def round_half_up(value: float) -> int:\n        # Rounds a float to the nearest integer using half-up strategy (e.g., 1.5 -> 2, -1.5 -> -2).\n        if value >= 0:\n            return int(math.floor(value + 0.5))\n        else:\n            return int(math.ceil(value - 0.5))\n\n    v_pow_0_16 = velocity_kmh ** 0.16\n\n    raw_wind_chill = (\n        FORMULA_COEF_A\n        + FORMULA_COEF_B * temp_c\n        - FORMULA_COEF_C * v_pow_0_16\n        + FORMULA_COEF_D * temp_c * v_pow_0_16\n    )\n\n    return round_half_up(raw_wind_chill)"}
