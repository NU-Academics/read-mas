{"task_id": "Mbpp/133", "solution": "def sum_negativenum(numbers):\n    \"\"\"\n    Calculates the sum of all negative numbers in a given list.\n    Uses math.fsum for accurate floating-point summation.\n    \"\"\"\n    import math\n    negative_numbers = [num for num in numbers if num < 0]\n    return math.fsum(negative_numbers)"}
{"task_id": "Mbpp/137", "solution": "def zero_count(values):\n    \"\"\"\n    Return the ratio of zero elements to non-zero elements in `values`.\n\n    - `values` must be a list or tuple of integers (bools are rejected).\n    - Returns a float: zero_count / nonzero_count.\n    - If there are no non-zero elements (nonzero_count == 0), returns math.inf.\n    \"\"\"\n    import math\n\n    if not isinstance(values, (list, tuple)):\n        raise TypeError(\"values must be a list or tuple of integers\")\n\n    zero = 0\n    nonzero = 0\n\n    for v in values:\n        # reject bool because bool is a subclass of int in Python\n        if isinstance(v, bool) or not isinstance(v, int):\n            raise TypeError(\"all elements must be int (bool is not allowed)\")\n        if v == 0:\n            zero += 1\n        else:\n            nonzero += 1\n\n    if nonzero == 0:\n        return math.inf\n\n    return zero / nonzero"}
{"task_id": "Mbpp/140", "solution": "def extract_singly(items):\n    \"\"\"\n    Flattens a list (or iterable) of iterables into a set of unique integers.\n\n    Behavior:\n    - Accepts ints, floats, and numeric strings.\n    - Floats are accepted only if they represent whole numbers (e.g., 2.0 -> 2).\n    - Numeric strings like \"3\" or \"3.0\" are accepted.\n    - Non-numeric or non-whole values are skipped.\n    \"\"\"\n    result_set = set()\n    for inner_iterable in items:\n        # If inner_iterable is not actually iterable, this will raise TypeError naturally.\n        for item in inner_iterable:\n            try:\n                # Convert numeric strings and numeric types via float, then ensure whole number.\n                float_value = float(item)\n            except (ValueError, TypeError):\n                # Skip non-numeric values\n                continue\n            # Accept only whole-number floats (including ints)\n            if float_value == int(float_value):\n                result_set.add(int(float_value))\n    return result_set"}
