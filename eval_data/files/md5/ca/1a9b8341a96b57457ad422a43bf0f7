{"task_id": "Mbpp/77", "solution": "def is_Diff(value):\n    \"\"\"\n    Checks if a number is divisible by 11 using the alternating-sum-of-digits rule.\n    Accepts ints and numeric strings (with optional leading + or -). Returns bool.\n    \"\"\"\n    # Normalize input: accept int or numeric string\n    if isinstance(value, int):\n        digits = str(abs(value))\n    elif isinstance(value, str):\n        s = value.strip()\n        if not s:\n            raise ValueError(\"empty string is not a valid integer\")\n        # Allow optional leading + or -\n        if s[0] in \"+-\":\n            s = s[1:]\n        if not s.isdigit():\n            raise ValueError(f\"invalid numeric string: {value!r}\")\n        # preserve leading zeros\n        digits = s\n    else:\n        # Try to coerce numeric-like inputs (e.g., numpy int) via int(), but reject floats/decimals\n        try:\n            iv = int(value)\n        except Exception:\n            raise ValueError(f\"unsupported type for is_Diff: {type(value).__name__}\")\n        digits = str(abs(iv))\n\n    # Edge case: after normalization, ensure we have digits (shouldn't be empty)\n    if digits == \"\":\n        raise ValueError(\"no digits to evaluate\")\n\n    sum_odd = 0\n    sum_even = 0\n    # Count positions from right (units digit is position 1)\n    for pos, ch in enumerate(reversed(digits), start=1):\n        d = ord(ch) - ord('0')\n        if pos % 2 == 1:\n            sum_odd += d\n        else:\n            sum_even += d\n\n    return (sum_odd - sum_even) % 11 == 0"}
{"task_id": "Mbpp/75", "solution": "def find_tuples(tuples, k):\n    \"\"\"\n    Filters a list of tuples, returning only those where all elements are divisible by k.\n    \"\"\"\n    return [t for t in tuples if all(item % k == 0 for item in t)]"}
{"task_id": "Mbpp/82", "solution": "import math\ndef volume_sphere(radius: float) -> float:\n    \"\"\"\n    Calculates the volume of a sphere given its radius.\n    The volume is computed using the formula V = 4/3 * \u03c0 * r^3.\n    \"\"\"\n    return (4.0 / 3.0) * math.pi * (radius ** 3)"}
{"task_id": "Mbpp/84", "solution": "def sequence(n: int) -> int:\n    \"\"\"Finds the nth number in the Newman-Conway sequence (1-based index).\"\"\"\n    # Validate input\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n    if n < 1:\n        raise ValueError(\"n must be >= 1\")\n\n    # The sequence is defined by a(1)=1, a(2)=1, a(n)=a(a(n-1)) + a(n - a(n-1)) for n>2.\n    # Use a 0-indexed list where seq[i] == a(i+1).\n    seq = [1, 1]\n\n    while len(seq) < n:\n        a_k_val = seq[-1]  # a(k) where k == len(seq)\n        # a(k+1) = a(a(k)) + a((k+1) - a(k))\n        next_val = seq[a_k_val - 1] + seq[len(seq) - a_k_val]\n        seq.append(next_val)\n\n    return seq[n - 1]"}
{"task_id": "Mbpp/85", "solution": "import math\nclass InvalidRadiusError(ValueError):\n    \"\"\"Custom exception for invalid sphere radius values.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\ndef surfacearea_sphere(radius: float) -> float:\n    \"\"\"\n    Calculates the surface area of a sphere given its radius.\n\n    Raises InvalidRadiusError if the radius is negative, non-numeric, or non-finite.\n    \"\"\"\n    try:\n        r = float(radius)\n    except (TypeError, ValueError):\n        raise InvalidRadiusError(f\"Invalid radius: {radius!r} must be a number.\")\n\n    if not math.isfinite(r) or r < 0.0:\n        raise InvalidRadiusError(f\"Invalid radius: {radius!r}. Radius must be a non-negative, finite number.\")\n\n    return 4.0 * math.pi * (r * r)"}
{"task_id": "Mbpp/86", "solution": "def centered_hexagonal_number(n):\n    \"\"\"\n    Calculates the nth centered hexagonal number using the formula H(n) = 3*n*(n-1) + 1.\n    Assumes n is a positive integer.\n    \"\"\"\n    return 3 * n * (n - 1) + 1"}
{"task_id": "Mbpp/87", "solution": "def merge_dictionaries_three(d1: dict, d2: dict, d3: dict) -> dict:\n    \"\"\"\n    Merges three dictionaries into a single dictionary.\n    Keys from later dictionaries override keys from earlier dictionaries, with d3 having the highest precedence.\n    \"\"\"\n    merged_dict = {}\n    merged_dict.update(d1)\n    merged_dict.update(d2)\n    merged_dict.update(d3)\n    return merged_dict"}
{"task_id": "Mbpp/88", "solution": "from typing import Any, Dict, Sequence\ndef freq_count(items: Sequence[Any]) -> Dict[Any, int]:\n    \"\"\"\n    Computes the frequency of each element in a sequence.\n\n    Returns a dictionary where keys are elements from the input sequence\n    and values are their corresponding counts.\n    \"\"\"\n    counts: Dict[Any, int] = {}\n    for element in items:\n        counts[element] = counts.get(element, 0) + 1\n    return counts"}
{"task_id": "Mbpp/89", "solution": "class InputValidator:\n    @staticmethod\n    def validate_int(value) -> int:\n        # Per \"DO NOT add isinstance() checks or raise exceptions\",\n        # this assumes 'value' is convertible to an integer.\n        return int(value)\nclass MathUtils:\n    @staticmethod\n    def safe_decrement(n: int) -> int:\n        # Per \"DO NOT add isinstance() checks or raise exceptions\",\n        # this assumes 'n' is an integer.\n        return n - 1\nclass ClosestNumberService:\n    def closest_smaller(self, n: int) -> int:\n        return MathUtils.safe_decrement(n)\nclass ClosestNumberController:\n    def __init__(self, validator, service) -> None:\n        self._validator = validator\n        self._service = service\n\n    def closest_num(self, value) -> int:\n        n = self._validator.validate_int(value)\n        return self._service.closest_smaller(n)\ndef create_default_controller():\n    # Factory to create controller with its default dependencies.\n    return ClosestNumberController(InputValidator(), ClosestNumberService())\ndef closest_num(n: int) -> int:\n    \"\"\"\n    Finds the closest integer strictly smaller than n.\n    This function delegates the task through a controller and service layer.\n    \"\"\"\n    controller = create_default_controller()\n    return controller.closest_num(n)"}
{"task_id": "Mbpp/90", "solution": "def len_log(words):\n    \"\"\"\n    Return the length of the longest word in the iterable `words`.\n    Whitespace is trimmed from each word before measuring. Empty input returns 0.\n\n    Raises:\n        TypeError: if `words` is not an iterable of str or if any element is not a str.\n    \"\"\"\n    if words is None:\n        raise TypeError(\"words must be an iterable of strings, not None\")\n\n    try:\n        iterator = iter(words)\n    except TypeError:\n        raise TypeError(f\"words must be an iterable of strings, got {type(words).__name__}\")\n\n    max_len = 0\n    for idx, w in enumerate(iterator):\n        if not isinstance(w, str):\n            raise TypeError(f\"element at index {idx} is not a string (type={type(w).__name__})\")\n        current_len = len(w.strip())\n        if current_len > max_len:\n            max_len = current_len\n\n    return max_len"}
{"task_id": "Mbpp/91", "solution": "def find_substring(values, query):\n    \"\"\"\n    Return True if `query` is present as a substring in any string of `values`.\n    Raises TypeError on invalid inputs.\n    \"\"\"\n    if not isinstance(query, str):\n        raise TypeError(\"query must be a string\")\n\n    try:\n        vals = list(values)\n    except TypeError:\n        raise TypeError(\"values must be an iterable of strings\")\n\n    for idx, v in enumerate(vals):\n        if not isinstance(v, str):\n            raise TypeError(f\"all items in values must be strings; item at index {idx} is {type(v).__name__}\")\n        if query in v:\n            return True\n    return False"}
{"task_id": "Mbpp/93", "solution": "import math\ndef power(a, b):\n    \"\"\"\n    Calculates the value of 'a' to the power 'b', handling integer and float exponents efficiently.\n    It uses exponentiation by squaring for integer exponents and math.pow for fractional exponents.\n    \"\"\"\n\n    EPSILON = 1e-12\n\n    def _int_pow(base: float, exp: int) -> float:\n        \"\"\"Helper for integer exponents using exponentiation by squaring.\"\"\"\n        if exp == 0:\n            return 1.0\n\n        if exp < 0:\n            if base == 0:\n                raise ZeroDivisionError(\"0 cannot be raised to a negative power\")\n            base = 1.0 / base\n            exp = -exp\n\n        res = 1.0\n        while exp > 0:\n            if exp % 2 == 1:\n                res *= base\n            base *= base\n            exp //= 2\n        return res\n\n    def _float_pow(base: float, exp: float) -> float:\n        \"\"\"Helper for fractional exponents, using math.pow for robust calculation.\"\"\"\n        # math.pow will raise ValueError for negative base with fractional exponent in Python\n        return math.pow(base, exp)\n\n    # Validate numeric inputs\n    if not (isinstance(a, (int, float)) and isinstance(b, (int, float))):\n        raise TypeError(\"a and b must be numbers\")\n    if math.isnan(a) or math.isnan(b) or math.isinf(a) or math.isinf(b):\n        raise ValueError(\"a and b must be finite numbers\")\n\n    # Check if the exponent 'b' is effectively an integer within a small tolerance.\n    is_integer_exponent = abs(b - round(b)) < EPSILON\n\n    if is_integer_exponent:\n        return _int_pow(float(a), int(round(b)))\n    else:\n        return _float_pow(float(a), float(b))"}
{"task_id": "Mbpp/94", "solution": "from typing import Any, Iterable, Tuple\ndef index_minimum(items: Iterable[Tuple[Any, Any]]) -> Any:\n    \"\"\"Returns the first value of the tuple with the smallest second value.\n    This function processes an iterable of 2-element tuples.\n    \"\"\"\n    iterator = iter(items)\n\n    # Initialize with the first item to establish a baseline.\n    # If `items` is empty, `next(iterator)` will raise StopIteration.\n    first_item = next(iterator)\n    min_first, min_second = first_item[0], first_item[1]\n\n    # Iterate through the remaining items to find the minimum second value.\n    for current_item in iterator:\n        current_first, current_second = current_item[0], current_item[1]\n        if current_second < min_second:\n            min_second = current_second\n            min_first = current_first\n\n    return min_first"}
{"task_id": "Mbpp/92", "solution": "def is_undulating(n: int | str) -> bool:\n    \"\"\"\n    Checks if a number is undulating, meaning its digits alternate between two distinct digits\n    and its length is at least 3.\n    \"\"\"\n    # Parse the input number into a canonical digit string.\n    # Ignores the sign for integers and handles optional leading signs for strings.\n    digits_str: str\n    if isinstance(n, int):\n        digits_str = str(abs(n))\n    else:  # Assumes n is of type str based on the type hint.\n        s = str(n).strip()\n        if s.startswith(('-', '+')):\n            s = s[1:]\n        digits_str = s\n\n    # An undulating number must have at least 3 digits.\n    # Per requirements, inputs leading to an empty string (e.g., '-', '+') will return False here.\n    MIN_LENGTH = 3\n    if len(digits_str) < MIN_LENGTH:\n        return False\n\n    # Check for the alternating pattern.\n    # It must alternate between two *distinct* digits.\n    first_digit = digits_str[0]\n    second_digit = digits_str[1]\n\n    # The two alternating digits must be different.\n    if first_digit == second_digit:\n        return False\n\n    # Verify that all subsequent digits follow the A, B, A, B... pattern.\n    for i in range(len(digits_str)):\n        expected_digit = first_digit if i % 2 == 0 else second_digit\n        if digits_str[i] != expected_digit:\n            return False\n\n    return True"}
{"task_id": "Mbpp/95", "solution": "from typing import Any, List, Optional, Iterable\nclass MinLengthError(Exception):\n    \"\"\"Custom exception for validation and domain errors in min length computation.\"\"\"\n    def __init__(self, message: str, error_code: Optional[int] = None) -> None:\n        self.message = message\n        self.error_code = error_code\n        super().__init__(self.message)\n\n    def __str__(self) -> str:\n        return self.message\ndef is_iterable(obj: Any, allow_strings: bool = False) -> bool:\n    \"\"\"Checks if an object is iterable, with an option to include/exclude strings.\"\"\"\n    if obj is None:\n        return False\n    if isinstance(obj, str):\n        return allow_strings\n    try:\n        iter(obj)\n        return True\n    except TypeError:\n        return False\ndef safe_len(obj: Any) -> int:\n    \"\"\"Returns the length of an object, raising MinLengthError if not supported.\"\"\"\n    try:\n        return len(obj)\n    except TypeError:\n        raise MinLengthError(f\"Object of type {type(obj).__name__} has no length.\", error_code=3001)\nclass InputValidator:\n    \"\"\"Validates and normalizes incoming data for min length computation.\"\"\"\n    def validate_collection(self, data: Any, allow_strings: bool = False) -> List[List[Any]]:\n        if data is None:\n            raise MinLengthError(\"Input is None.\", error_code=1001)\n        if not is_iterable(data, allow_strings=True):\n            raise MinLengthError(\"Top-level input must be an iterable of iterables.\", error_code=1002)\n\n        items = list(data)\n        if len(items) == 0:\n            raise MinLengthError(\"Empty collection.\", error_code=1003)\n\n        normalized = []\n        for idx, item in enumerate(items):\n            if not self._is_valid_subcollection(item, allow_strings=allow_strings):\n                raise MinLengthError(f\"Element at index {idx} is not an acceptable sub-collection (type: {type(item).__name__}).\", error_code=1004)\n            normalized.append(list(item))\n\n        return normalized\n\n    def _is_valid_subcollection(self, obj: Any, allow_strings: bool = False) -> bool:\n        \"\"\"Helper to check if an object is a valid sub-collection (iterable and not None).\"\"\"\n        return is_iterable(obj, allow_strings=allow_strings)\nclass MinLengthService:\n    \"\"\"Computes the length of the smallest list in a collection of lists.\"\"\"\n    def compute_min_length(self, collection: List[List[Any]]) -> int:\n        if not collection:\n            raise MinLengthError(\"Empty collection provided to service.\", error_code=2001)\n\n        min_len: Optional[int] = None\n        for sub in collection:\n            current_len = safe_len(sub)\n            if min_len is None or current_len < min_len:\n                min_len = current_len\n                if min_len == 0:\n                    return 0\n        return int(min_len)\nclass APILayer:\n    \"\"\"Provides the public API for finding the minimum length, orchestrating validation and service.\"\"\"\n    def find_min_length(self, data: Any, allow_strings: bool = False) -> int:\n        validator = InputValidator()\n        validated_collection = validator.validate_collection(data, allow_strings)\n\n        service = MinLengthService()\n        return service.compute_min_length(validated_collection)\ndef Find_Min_Length(list_of_lists: object, allow_strings: bool = False) -> int:\n    \"\"\"\n    Finds the length of the smallest list in a list of lists.\n    It validates input and raises MinLengthError for invalid cases.\n    \"\"\"\n    return APILayer().find_min_length(list_of_lists, allow_strings)"}
{"task_id": "Mbpp/96", "solution": "def divisor(n: int) -> int:\n    \"\"\"Calculates the number of positive divisors for a given integer.\n    Negative inputs are handled by using their absolute value.\n    \"\"\"\n    n = abs(n)\n    if n == 0:\n        return 0\n\n    factors = {}\n\n    # Inlined trial_division logic for prime factorization\n    temp_n = n\n\n    # Handle factor 2\n    while temp_n % 2 == 0:\n        factors[2] = factors.get(2, 0) + 1\n        temp_n //= 2\n\n    # Handle odd factors\n    d = 3\n    while d * d <= temp_n:\n        while temp_n % d == 0:\n            factors[d] = factors.get(d, 0) + 1\n            temp_n //= d\n        d += 2\n\n    # If temp_n is still greater than 1, it is a prime factor itself\n    if temp_n > 1:\n        factors[temp_n] = factors.get(temp_n, 0) + 1\n\n    # Calculate the number of divisors from prime factor counts\n    count = 1\n    for exp in factors.values():\n        count *= (exp + 1)\n\n    return count"}
{"task_id": "Mbpp/97", "solution": "import collections\ndef frequency_lists(lists):\n    \"\"\"\n    Calculates the frequency of each element in a flattened list of lists.\n    Returns a dictionary where keys are elements and values are their counts.\n    \"\"\"\n    flattened_elements = [item for sublist in lists for item in sublist]\n    return collections.Counter(flattened_elements)"}
{"task_id": "Mbpp/100", "solution": "def next_smallest_palindrome(n: int) -> int:\n    \"\"\"\n    Finds the next smallest palindrome strictly greater than the given integer n.\n    The algorithm converts the number to a string and operates on its string representation.\n    \"\"\"\n    s = str(n)\n    length = len(s)\n    half_len = (length + 1) // 2\n\n    # Construct candidate palindrome by mirroring the left half\n    left_half = s[:half_len]\n    candidate_str = left_half + left_half[::-1][length % 2:]\n\n    candidate_num = int(candidate_str)\n\n    # If the mirrored candidate is already greater, it's the next palindrome\n    if candidate_num > n:\n        return candidate_num\n\n    # Otherwise, increment the left half and mirror again\n    left_half_int = int(left_half)\n    incremented_left_half_int = left_half_int + 1\n\n    # Handle carry over for all 9s scenario (e.g., 9 -> 10, 99 -> 100)\n    # This might increase the length of the left_half\n    incremented_left_half = str(incremented_left_half_int)\n\n    # If incrementing the left half resulted in a longer string (e.g., 99 -> 100),\n    # it means the new palindrome will have length + 1 (e.g. 99 -> 101, 9 -> 11)\n    if len(incremented_left_half) > half_len:\n        # Example: n=9, half_len=1. incremented_left_half becomes '10'.\n        # New palindrome will be '1' + ('0' * (length - 1)) + '1'.\n        # For n=9, length=1, it's '1' + '1' = '11'\n        # For n=99, length=2, it's '1' + '0' + '1' = '101'\n        return int('1' + '0' * (length - 1) + '1')\n\n    # Construct the final palindrome by mirroring the incremented left half\n    final_palindrome_str = incremented_left_half + incremented_left_half[::-1][length % 2:]\n    return int(final_palindrome_str)"}
{"task_id": "Mbpp/98", "solution": "def multiply_num(numbers):\n    \"\"\"\n    Multiplies all numbers in a sequence and divides the product by the sequence's length.\n    Assumes the input sequence is non-empty and contains only numeric types.\n    \"\"\"\n    product = 1.0\n    for num in numbers:\n        product *= float(num)\n\n    length = len(numbers)\n    return product / length"}
{"task_id": "Mbpp/99", "solution": "def decimal_to_binary(n: int) -> str:\n    \"\"\"Converts a decimal integer to its binary string representation.\"\"\"\n    if n == 0:\n        return \"0\"\n\n    sign = \"-\" if n < 0 else \"\"\n    x = abs(n)\n    bits = []\n\n    while x:\n        bits.append(\"1\" if (x & 1) else \"0\")\n        x >>= 1\n\n    return sign + \"\".join(reversed(bits))"}
{"task_id": "Mbpp/101", "solution": "def kth_element(arr, k):\n    \"\"\"Return the k-th element (1-based) from arr.\n\n    Args:\n        arr: A sequence or iterable of elements.\n        k: 1-based index (int).\n\n    Returns:\n        The element at position k (1-based).\n\n    Raises:\n        TypeError: If k is not an integer.\n        IndexError: If k is out of range for the provided array.\n    \"\"\"\n    if not isinstance(k, int):\n        raise TypeError(\"k must be an integer\")\n\n    seq = list(arr)\n    if k < 1 or k > len(seq):\n        raise IndexError(\"k is out of range\")\n\n    return seq[k - 1]"}
{"task_id": "Mbpp/102", "solution": "def snake_to_camel(s: str) -> str:\n    \"\"\"\n    Converts a snake_case string to CamelCase (PascalCase).\n    Empty segments from underscores are ignored.\n    \"\"\"\n    parts = [p for p in s.split('_') if p]\n    return ''.join(p[:1].upper() + p[1:].lower() if p else '' for p in parts)"}
