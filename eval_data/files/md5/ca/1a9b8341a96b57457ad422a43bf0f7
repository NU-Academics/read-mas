{"task_id": "Mbpp/428", "solution": "def shell_sort(array):\n    \"\"\"\n    Sorts a list of integers using the Shell Sort algorithm.\n    It uses the halving gap sequence and performs an in-place sort on a copy of the input array.\n    \"\"\"\n    arr = list(array)  # Create a copy to avoid mutating the original input list\n    n = len(arr)\n\n    # Generate gaps using the halving sequence\n    gap = n // 2\n    while gap > 0:\n        # Perform insertion sort for elements at current gap\n        for i in range(gap, n):\n            temp = arr[i]\n            j = i\n            while j >= gap and arr[j - gap] > temp:\n                arr[j] = arr[j - gap]\n                j -= gap\n            arr[j] = temp\n        gap //= 2\n    return arr"}
{"task_id": "Mbpp/433", "solution": "def check_greater(array, number):\n    \"\"\"\n    Checks if the given number is strictly greater than all elements in the array.\n    Returns False if the array is empty.\n    \"\"\"\n    if not isinstance(array, (list, tuple)):\n        raise TypeError(\"array must be a list or tuple of numbers\")\n    if not array:\n        return False\n    try:\n        max_val = max(array)\n    except TypeError:\n        # elements not comparable / not numeric\n        raise TypeError(\"array elements must be comparable (numbers)\")\n    try:\n        # ensure number is numeric-comparable\n        _ = number > max_val\n    except TypeError:\n        raise TypeError(\"number must be comparable to array elements\")\n    return number > max_val"}
{"task_id": "Mbpp/432", "solution": "import math\nfrom typing import Any, Optional\ndef median_trapezium(base1: float, base2: float, *others: float) -> float:\n    \"\"\"\n    Computes the median length of a trapezium given its two parallel bases.\n    Additional arguments are ignored for the median calculation.\n    \"\"\"\n\n    class TrapeziumError(Exception):\n        \"\"\"Custom exception for trapezium-related errors.\"\"\"\n        def __init__(self, message: str) -> None:\n            super().__init__(message)\n            self.message = message\n\n    class TrapeziumValidator:\n        \"\"\"Validates inputs for trapezium properties.\"\"\"\n        def validate_bases(self, base1_val: Any, base2_val: Any) -> None:\n            if not self._is_finite_number(base1_val):\n                raise TrapeziumError(f\"Base1 '{base1_val}' is not a finite number.\")\n            if not self._is_finite_number(base2_val):\n                raise TrapeziumError(f\"Base2 '{base2_val}' is not a finite number.\")\n            if not isinstance(base1_val, (int, float)):\n                raise TrapeziumError(f\"Base1 '{base1_val}' is not a number.\")\n            if not isinstance(base2_val, (int, float)):\n                raise TrapeziumError(f\"Base2 '{base2_val}' is not a number.\")\n            if base1_val < 0:\n                raise TrapeziumError(f\"Base1 '{base1_val}' cannot be negative.\")\n            if base2_val < 0:\n                raise TrapeziumError(f\"Base2 '{base2_val}' cannot be negative.\")\n\n        def _is_finite_number(self, value: Any) -> bool:\n            return isinstance(value, (int, float)) and not (math.isinf(value) or math.isnan(value))\n\n    class TrapeziumModel:\n        \"\"\"Represents a trapezium with its bases and optional sides/height.\"\"\"\n        def __init__(self, base1_m: float, base2_m: float, side_c_m: Optional[float] = None, side_d_m: Optional[float] = None, height_m: Optional[float] = None) -> None:\n            self.base1 = base1_m\n            self.base2 = base2_m\n            self.side_c = side_c_m\n            self.side_d = side_d_m\n            self.height = height_m\n\n    class MedianService:\n        \"\"\"Provides methods to compute the median of a trapezium.\"\"\"\n        def __init__(self, precision: int | None = None) -> None:\n            self._precision = precision\n\n        def compute_median(self, trap: TrapeziumModel) -> float:\n            median = (trap.base1 + trap.base2) / 2.0\n            return round(median, self._precision) if self._precision is not None else median\n\n    _validator = TrapeziumValidator()\n    _service = MedianService()\n\n    _validator.validate_bases(base1, base2)\n\n    # Construct TrapeziumModel from bases and up to two extra 'others' arguments\n    trap = TrapeziumModel(base1, base2, *(list(others)[:2] if others else []))\n\n    return _service.compute_median(trap)"}
