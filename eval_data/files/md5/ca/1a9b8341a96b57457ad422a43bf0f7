{"task_id": "Mbpp/610", "solution": "from typing import Any, List, Optional\nclass RemoveError(ValueError):\n    \"\"\"Domain-specific exception for invalid removal operations.\"\"\"\n    def __init__(self, message: str, code: Optional[str] = None):\n        super().__init__(message)\n        self.message = message\n        self.code = code\nclass RemoveRequest:\n    \"\"\"DTO for carrying list and k (1-based index) for removal.\"\"\"\n    def __init__(self, lst: List[Any], k: int) -> None:\n        self.lst = lst\n        self.k = k\nclass ValidationUtils:\n    \"\"\"Static utility methods for input validation.\"\"\"\n    @staticmethod\n    def ensure_sequence(obj: Any) -> List[Any]:\n        if isinstance(obj, list):\n            return obj\n        try:\n            return list(obj)\n        except TypeError:\n            raise RemoveError(\"Provided object is not iterable\", code=\"NOT_ITERABLE\")\n\n    @staticmethod\n    def ensure_positive_int(value: Any) -> int:\n        try:\n            v = int(value)\n        except (TypeError, ValueError):\n            raise RemoveError(\"k must be an integer\", code=\"K_NOT_INT\")\n        if v < 1:\n            raise RemoveError(\"k must be >= 1\", code=\"K_NOT_POSITIVE\")\n        return v\nclass ListRepository:\n    \"\"\"Performs the actual list manipulation (element removal).\"\"\"\n    def remove_kth(self, lst: List[Any], k: int) -> List[Any]:\n        idx = k - 1  # Convert 1-based k to 0-based index\n        if idx < 0 or idx >= len(lst):\n            raise RemoveError(f\"k ({k}) out of range for list of length {len(lst)}\", code=\"K_OUT_OF_RANGE\")\n        return lst[:idx] + lst[idx+1:]\nclass RemoveService:\n    \"\"\"Core business logic for removing an element, ensuring immutability.\"\"\"\n    def __init__(self, repository: ListRepository):\n        self._repository = repository\n\n    def remove(self, request: RemoveRequest) -> List[Any]:\n        source = list(request.lst)  # Create a shallow copy to ensure immutability\n        return self._repository.remove_kth(source, request.k)\nclass RemoveController:\n    \"\"\"Validates request inputs and delegates to the removal service.\"\"\"\n    def __init__(self, service: RemoveService, validator: ValidationUtils):\n        self._service = service\n        self._validator = validator\n\n    def handle(self, request: RemoveRequest) -> List[Any]:\n        request.lst = self._validator.ensure_sequence(request.lst)\n        request.k = self._validator.ensure_positive_int(request.k)\n        return self._service.remove(request)\n_api_controller = RemoveController(service=RemoveService(repository=ListRepository()),\n                                   validator=ValidationUtils())\ndef remove_kth_element(lst: List[Any], k: int) -> List[Any]:\n    \"\"\"\n    Returns a new list with the k'th element removed (k is 1-based index).\n    The original list is not modified.\n    \"\"\"\n    req = RemoveRequest(lst=lst, k=k)\n    return _api_controller.handle(req)"}
{"task_id": "Mbpp/608", "solution": "def bell_Number(n: int) -> int:\n    \"\"\"\n    Calculates the nth Bell number using the Bell triangle (Aitken's array) dynamic programming algorithm.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n    if n < 0:\n        raise ValueError(\"n must be non-negative\")\n\n    if n == 0:\n        return 1\n\n    # Initialize the first row of the Bell triangle (A[0][0] = 1)\n    row = [1]\n\n    # Build triangle rows iteratively up to n\n    for i in range(1, n + 1):\n        # First element of the new row is the last element of the previous row\n        new_row = [row[-1]]\n\n        # Fill the current row using A[i][j] = A[i][j-1] + A[i-1][j-1]\n        for j in range(1, i + 1):\n            new_row.append(new_row[-1] + row[j - 1])\n\n        row = new_row\n\n    # The nth Bell number is the first element of the nth row\n    return row[0]"}
{"task_id": "Mbpp/611", "solution": "def max_of_nth(matrix, n):\n    \"\"\"\n    Returns the maximum value found in the n'th column of a matrix.\n    Assumes matrix is a list of lists and n is a valid column index.\n    \"\"\"\n    column_values = []\n    for row in matrix:\n        column_values.append(row[n])\n    return max(column_values)"}
{"task_id": "Mbpp/614", "solution": "import uuid\nfrom typing import Iterable, Iterator, Any, Optional, Union\nfrom datetime import datetime\nimport json\nfrom pathlib import Path\nclass CumulativeSumError(Exception):\n    \"\"\"Custom exception for cumulative sum errors.\"\"\"\n    pass\ndef generate_id() -> str:\n    \"\"\"Generates a UUID4 string.\"\"\"\n    return str(uuid.uuid4())\ndef is_valid_input(values: Any) -> bool:\n    \"\"\"Validates if the input is an iterable of iterables containing only integers.\"\"\"\n    try:\n        iter(values)\n    except TypeError:\n        return False\n    for item in values:\n        try:\n            iter(item)\n        except TypeError:\n            return False\n        for v in item:\n            if not isinstance(v, int):\n                return False\n    return True\nclass ResultRecord:\n    \"\"\"Represents a record of computation for persistence.\"\"\"\n    def __init__(self, id: str, timestamp: str, input: list[list[int]], result: int):\n        self.id = id\n        self.timestamp = timestamp\n        self.input = input\n        self.result = result\n\n    def to_dict(self) -> dict:\n        \"\"\"Converts the record to a dictionary.\"\"\"\n        return {\n            \"id\": self.id,\n            \"timestamp\": self.timestamp,\n            \"input\": self.input,\n            \"result\": self.result,\n        }\nclass JSONResultRepository:\n    \"\"\"Handles persistence of result records to a JSON file.\"\"\"\n    def __init__(self, file_path: Path):\n        self.file_path = file_path\n        self._ensure_file()\n\n    def _ensure_file(self):\n        \"\"\"Ensures the persistence file and its parent directories exist.\"\"\"\n        self.file_path.parent.mkdir(parents=True, exist_ok=True)\n        if not self.file_path.exists():\n            self.file_path.write_text(\"[]\")\n\n    def save(self, record: ResultRecord) -> None:\n        \"\"\"Appends a result record to the JSON file.\"\"\"\n        data = json.loads(self.file_path.read_text())\n        data.append(record.to_dict())\n        tmp = self.file_path.with_suffix(\".tmp\")\n        tmp.write_text(json.dumps(data, ensure_ascii=False))\n        tmp.replace(self.file_path)\nclass CumulativeSumService:\n    \"\"\"Provides the core logic for calculating and optionally persisting cumulative sums.\"\"\"\n    def __init__(self, repository: Optional[JSONResultRepository] = None):\n        self.repository = repository\n\n    def calculate(self, values: Iterable[Iterable[int]]) -> int:\n        \"\"\"Computes the cumulative sum and handles persistence.\"\"\"\n        if not is_valid_input(values):\n            raise CumulativeSumError(\"Invalid input: expected iterable of iterables of ints\")\n        result = self._compute_sum(values)\n        if self.repository:\n            try:\n                self._persist(values, result)\n            except Exception:\n                pass\n        return result\n\n    def _compute_sum(self, values: Iterable[Iterable[int]]) -> int:\n        \"\"\"Helper to sum flattened integer values.\"\"\"\n        total = 0\n        for v in flatten_iterables(values):\n            total += v\n        return total\n\n    def _persist(self, values: Iterable[Iterable[int]], result: int) -> None:\n        \"\"\"Persists the input and result using the configured repository.\"\"\"\n        record = ResultRecord(\n            id=generate_id(),\n            timestamp=datetime.utcnow().isoformat(timespec='seconds') + 'Z',\n            input=[list(i) for i in values],\n            result=result\n        )\n        self.repository.save(record)\ndef cummulative_sum(values: Iterable[Iterable[int]], persist_to: Optional[Union[str, Path]] = None) -> int:\n    \"\"\"\n    Calculates the cumulative sum of all integers in a list of tuples.\n    Optionally persists the input and result to a JSON file.\n    \"\"\"\n    repo = JSONResultRepository(Path(persist_to)) if persist_to else None\n    svc = CumulativeSumService(repository=repo)\n    return svc.calculate(values)"}
{"task_id": "Mbpp/615", "solution": "def average_tuple(tuple_of_tuples):\n    \"\"\"\n    Calculates the average value for each inner tuple in a tuple of tuples.\n    Assumes valid input where all inner tuples contain numbers and are not empty.\n    \"\"\"\n    averages = []\n    for inner_tuple in tuple_of_tuples:\n        # Calculate the sum and count of elements in the inner tuple, then compute the average.\n        avg = sum(inner_tuple) / len(inner_tuple)\n        averages.append(avg)\n    return averages"}
