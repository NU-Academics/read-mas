{"task_id": "Mbpp/589", "solution": "def perfect_squares(start, end):\n    \"\"\"\n    Return a list of perfect square integers between start and end (inclusive).\n\n    Acceptable input types:\n    - int\n    - float (only if it represents an integer, e.g. 4.0)\n    - str containing an integer or integer-form float (e.g. \"9\", \"16.0\")\n\n    Raises:\n    - TypeError if start or end cannot be interpreted as integers\n    - ValueError if start > end\n    \"\"\"\n    import math\n\n    def _coerce_to_int(value, name):\n        if isinstance(value, int):\n            return value\n        if isinstance(value, float):\n            if value.is_integer():\n                return int(value)\n            raise TypeError(f\"{name} must be an integer (got non-integer float: {value!r})\")\n        if isinstance(value, str):\n            # try integer string first, then float string that is integral\n            try:\n                return int(value)\n            except ValueError:\n                try:\n                    f = float(value)\n                except ValueError:\n                    raise TypeError(f\"{name} must be an integer (got non-numeric string: {value!r})\")\n                if f.is_integer():\n                    return int(f)\n                raise TypeError(f\"{name} must be an integer (got non-integer float string: {value!r})\")\n        raise TypeError(f\"{name} must be an integer (got {type(value).__name__})\")\n\n    s = _coerce_to_int(start, \"start\")\n    e = _coerce_to_int(end, \"end\")\n\n    if s > e:\n        raise ValueError(f\"start must be <= end (got start={s}, end={e})\")\n\n    # No positive perfect squares exist below 0. If end < 0, result is empty.\n    if e < 0:\n        return []\n\n    low = max(s, 0)\n    first_root = math.isqrt(low)\n    if first_root * first_root < low:\n        first_root += 1\n    last_root = math.isqrt(e)\n\n    if first_root > last_root:\n        return []\n\n    return [r * r for r in range(first_root, last_root + 1)]"}
{"task_id": "Mbpp/588", "solution": "def big_diff(values):\n    \"\"\"\n    Calculates the difference between the largest and smallest value in a list.\n    Assumes the input list contains comparable numeric types.\n    \"\"\"\n    return max(values) - min(values)"}
{"task_id": "Mbpp/583", "solution": "def catalan_number(n: int) -> int:\n    \"\"\"\n    Computes the nth Catalan number using dynamic programming.\n\n    Args:\n        n: non-negative integer index of the Catalan sequence.\n\n    Returns:\n        The nth Catalan number as an int.\n\n    Raises:\n        TypeError: if n is not an integer.\n        ValueError: if n is negative.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n    if n < 0:\n        raise ValueError(\"n must be non-negative\")\n\n    if n == 0:\n        return 1\n\n    catalan = [0] * (n + 1)\n    catalan[0] = 1\n\n    for i in range(1, n + 1):\n        total = 0\n        for j in range(i):\n            total += catalan[j] * catalan[i - 1 - j]\n        catalan[i] = total\n\n    return catalan[n]"}
{"task_id": "Mbpp/594", "solution": "def diff_even_odd(numbers: list[int]) -> int:\n    \"\"\"\n    Computes the difference between the first even and first odd integer in a list.\n    Assumes valid input will contain at least one even and one odd integer.\n    \"\"\"\n    first_even = None\n    first_odd = None\n\n    for num in numbers:\n        if first_even is None and num % 2 == 0:\n            first_even = num\n        if first_odd is None and num % 2 != 0:\n            first_odd = num\n        if first_even is not None and first_odd is not None:\n            break\n\n    return first_even - first_odd"}
{"task_id": "Mbpp/591", "solution": "from typing import TypeVar, Sequence, MutableSequence, List\nT = TypeVar(\"T\")\ndef swap_List(lst: Sequence[T], inplace: bool = False) -> Sequence[T]:\n    \"\"\"Interchange the first and last elements of a sequence.\n\n    If inplace is True, the function attempts to modify the sequence in place\n    (the sequence must support item assignment, e.g., a list). If inplace is False,\n    a new list with the swapped elements is returned, leaving the original unchanged.\n\n    For sequences with length < 2, the original sequence is returned unchanged.\n    \"\"\"\n    if len(lst) < 2:\n        return lst\n\n    if inplace:\n        # Assume caller provided a mutable sequence (like list). Let Python raise\n        # a TypeError if the object is immutable (e.g., tuple).\n        mutable_lst: MutableSequence[T] = lst  # type: ignore[assignment]\n        mutable_lst[0], mutable_lst[-1] = mutable_lst[-1], mutable_lst[0]\n        return lst\n    else:\n        new_list: List[T] = list(lst)\n        new_list[0], new_list[-1] = new_list[-1], new_list[0]\n        return new_list"}
{"task_id": "Mbpp/592", "solution": "def sum_Of_product(n: int) -> int:\n    \"\"\"Return sum_{k=0}^{n-1} C(n,k) * C(n,k+1).\n    Uses the identity: sum = C(2n, n-1).\"\"\"\n    if not isinstance(n, int) or n < 0:\n        raise ValueError(\"n must be a non-negative integer\")\n    if n == 0:\n        return 0\n    import math\n    return math.comb(2 * n, n - 1)"}
{"task_id": "Mbpp/596", "solution": "import sys\nclass TupleSizeError(Exception):\n    \"\"\"Custom exception for tuple size related errors.\"\"\"\n    def __init__(self, message: str):\n        self.message = message\n        super().__init__(message)\nclass SysAdapter:\n    \"\"\"Adapts sys.getsizeof for testability.\"\"\"\n    def getsizeof(self, obj: object) -> int:\n        return sys.getsizeof(obj)\nclass TupleSizeCalculator:\n    \"\"\"Calculates the size of a tuple using a SysAdapter.\"\"\"\n    def __init__(self, _sys: SysAdapter):\n        self._sys = _sys\n    def calculate_size(self, t: tuple) -> int:\n        try:\n            return int(self._sys.getsizeof(t))\n        except Exception as e:\n            raise TupleSizeError(f\"Failed to get size: {e}\")\nclass Validators:\n    \"\"\"Provides utility methods for validating objects.\"\"\"\n    def is_tuple(self, obj: object) -> bool:\n        return isinstance(obj, tuple)\nclass TupleSizeService:\n    \"\"\"Service to validate input and compute tuple size.\"\"\"\n    def __init__(self, _calculator: TupleSizeCalculator, _validators: Validators):\n        self._calculator = _calculator\n        self._validators = _validators\n    def get_size(self, t: tuple) -> int:\n        if not self._validators.is_tuple(t):\n            raise TupleSizeError(\"Input must be a tuple\")\n        return self._calculator.calculate_size(t)\ndef tuple_size(t: tuple) -> int:\n    \"\"\"\n    Calculates the size in bytes of a given tuple object.\n    This includes the tuple object's overhead, similar to sys.getsizeof.\n    \"\"\"\n    service = TupleSizeService(TupleSizeCalculator(SysAdapter()), Validators())\n    return service.get_size(t)"}
{"task_id": "Mbpp/590", "solution": "import math\nimport cmath\ndef polar_rect(a, b, mode='rect'):\n    \"\"\"\n    Converts between polar and rectangular coordinates based on mode.\n    If mode is 'rect', (a,b) are x,y. If mode is 'polar', (a,b) are r,theta.\n    \"\"\"\n    if mode == 'rect':\n        # Convert rectangular (x, y) to polar (r, theta) and return the original rectangular as complex.\n        x_in, y_in = a, b\n        r_out = math.hypot(x_in, y_in)\n        theta_out = math.atan2(y_in, x_in)\n        return ((r_out, theta_out), complex(x_in, y_in))\n    elif mode == 'polar':\n        # Convert polar (r, theta) to rectangular (x, y) and return the original polar coordinates.\n        r_in, theta_in = a, b\n\n        # Apply business rule: If negative r, transform r' = abs(r) and theta' = theta + pi.\n        r_effective = abs(r_in)\n        theta_effective = theta_in\n        if r_in < 0:\n            theta_effective += math.pi\n\n        x_out = r_effective * math.cos(theta_effective)\n        y_out = r_effective * math.sin(theta_effective)\n\n        return ((r_in, theta_in), complex(x_out, y_out))\n    else:\n        raise ValueError(\"mode must be 'rect' or 'polar'\")"}
{"task_id": "Mbpp/593", "solution": "def removezero_ip(ip: str) -> str:\n    \"\"\"\n    Remove leading zeros from each octet of an IPv4 address string.\n    Example: \"216.08.094.196\" -> \"216.8.94.196\"\n    Raises:\n      TypeError if ip is not a string\n      ValueError if ip is not a valid IPv4 dotted-quad\n    \"\"\"\n    if not isinstance(ip, str):\n        raise TypeError(\"ip must be a string\")\n\n    s = ip.strip()\n    parts = s.split(\".\")\n    if len(parts) != 4:\n        raise ValueError(f\"Invalid IPv4 address: '{ip}'\")\n\n    cleaned = []\n    for part in parts:\n        if part == \"\":\n            raise ValueError(f\"Invalid IPv4 address: empty octet in '{ip}'\")\n        if not part.isdigit():\n            raise ValueError(f\"Invalid IPv4 address: non-numeric octet '{part}' in '{ip}'\")\n        num = int(part)\n        if not (0 <= num <= 255):\n            raise ValueError(f\"Invalid IPv4 address: octet '{part}' out of range in '{ip}'\")\n        cleaned.append(str(num))\n\n    return \".\".join(cleaned)"}
{"task_id": "Mbpp/599", "solution": "def sum_average(n):\n    \"\"\"\n    Calculates the sum and average of the first n natural numbers.\n    Assumes n is a positive integer for calculation.\n    \"\"\"\n    sum_n = n * (n + 1) // 2\n    average_n = sum_n / n\n    return (sum_n, average_n)"}
{"task_id": "Mbpp/598", "solution": "def armstrong_number(n: int) -> bool:\n    \"\"\"\n    Checks if the given number is an Armstrong number.\n    An Armstrong number is a number that is the sum of its own digits each raised to the power\n    of the number of digits.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"Input must be an integer\")\n\n    if n < 0:\n        return False\n\n    num_str = str(n)\n    num_digits = len(num_str)\n\n    armstrong_sum = 0\n    for char_digit in num_str:\n        digit = int(char_digit)\n        armstrong_sum += digit ** num_digits\n\n    return armstrong_sum == n"}
{"task_id": "Mbpp/597", "solution": "def find_kth(arr1, arr2, k):\n    \"\"\"\n    Find the k-th smallest element from two sorted arrays.\n    k is 1-based.\n    \"\"\"\n    m, n = len(arr1), len(arr2)\n    total = m + n\n    if k <= 0 or k > total:\n        raise IndexError(\"k is out of bounds\")\n\n    # Ensure arr1 is the smaller array to optimize binary search\n    if m > n:\n        arr1, arr2 = arr2, arr1\n        m, n = n, m\n\n    # Convert k to 0-based index\n    k -= 1\n\n    low = max(0, k - n)\n    high = min(m, k)\n\n    while low <= high:\n        mid1 = (low + high) // 2  # number taken from arr1\n        mid2 = k - mid1          # number taken from arr2\n\n        l1 = arr1[mid1 - 1] if mid1 > 0 else float(\"-inf\")\n        l2 = arr2[mid2 - 1] if mid2 > 0 else float(\"-inf\")\n        r1 = arr1[mid1] if mid1 < m else float(\"inf\")\n        r2 = arr2[mid2] if mid2 < n else float(\"inf\")\n\n        if l1 <= r2 and l2 <= r1:\n            return max(l1, l2)\n        elif l1 > r2:\n            high = mid1 - 1\n        else:\n            low = mid1 + 1\n\n    # Should not reach here for valid inputs\n    raise IndexError(\"Unable to find k-th element\")"}
