{"task_id": "Mbpp/796", "solution": "from typing import Dict, Any\nclass InvalidInputError(Exception):\n    def __init__(self, message: str):\n        self.message = message\n    def __str__(self) -> str:\n        return self.message\nclass DictValidator:\n    def __init__(self, allow_string_coercion: bool = False):\n        self._allow_string_coercion = allow_string_coercion\n\n    def validate(self, payload: Dict[str, Any]) -> Dict[str, float]:\n        if not isinstance(payload, dict):\n            raise InvalidInputError(\"Payload must be a dictionary\")\n        result = {}\n        for k, v in payload.items():\n            try:\n                result[k] = self._coerce_value(v)\n            except InvalidInputError as e:\n                raise InvalidInputError(f\"Key '{k}': {e}\")\n        return result\n\n    def _coerce_value(self, v: Any) -> float:\n        if isinstance(v, (int, float, bool)):\n            return float(v)\n        if self._allow_string_coercion and isinstance(v, str):\n            try:\n                return float(v)\n            except ValueError:\n                raise InvalidInputError(\"String value is not numeric\")\n        raise InvalidInputError(f\"Unsupported value type: {type(v).__name__}\")\nclass SumService:\n    def __init__(self, validator: DictValidator):\n        self.validator = validator\n\n    def compute_sum(self, values: Dict[str, float]) -> float:\n        return float(sum(values.values()))\n\n    def compute_from_payload(self, payload: Dict[str, Any]) -> float:\n        validated = self.validator.validate(payload)\n        return self.compute_sum(validated)\n_default_validator = DictValidator(allow_string_coercion=False)\n_default_service = SumService(_default_validator)\ndef return_sum(payload: dict) -> float:\n    \"\"\"Return sum of numeric values in payload.\"\"\"\n    return _default_service.compute_from_payload(payload)"}
