{"task_id": "Mbpp/290", "solution": "def max_length(lists):\n    \"\"\"\n    Find the list of maximum length in a list of lists.\n\n    Returns:\n        tuple: (max_length: int, list_with_max_length: list)\n\n    Raises:\n        TypeError: if the outer object is not a list or any inner element is not a list.\n    \"\"\"\n    if not isinstance(lists, list):\n        raise TypeError(\"Expected a list of lists for 'lists' parameter\")\n\n    if not lists:\n        return (0, [])\n\n    # Initialize with the first element (assume it's a list)\n    first = lists[0]\n    if not isinstance(first, list):\n        raise TypeError(\"All elements of the outer list must be lists\")\n    best_list = first\n    best_len = len(first)\n\n    for idx in range(1, len(lists)):\n        lst = lists[idx]\n        if not isinstance(lst, list):\n            raise TypeError(f\"Element at index {idx} is not a list\")\n        curr_len = len(lst)\n        if curr_len > best_len:\n            best_len = curr_len\n            best_list = lst\n\n    return (best_len, best_list)"}
{"task_id": "Mbpp/294", "solution": "from typing import Sequence, Any, Union, Tuple\nclass MaxFinderError(Exception):\n    pass\nclass InvalidInputError(MaxFinderError):\n    pass\nclass NonNumericError(MaxFinderError):\n    pass\nclass _TypeUtils:\n    NUMERIC_TYPES = (int, float)\n\n    def is_numeric(self, value: Any) -> bool:\n        return isinstance(value, self.NUMERIC_TYPES) and not isinstance(value, bool)\n\n    def to_numeric(self, value: Any) -> Union[int, float]:\n        if self.is_numeric(value):\n            return value\n        raise TypeError(\"Value not numeric\")\nclass _InputList:\n    def __init__(self, items: Sequence[Any]) -> None:\n        try:\n            self._items: Tuple[Any, ...] = tuple(items)\n        except TypeError:\n            raise InvalidInputError(\"Input must be an iterable/sequence.\")\n\n    def as_sequence(self) -> Sequence[Any]:\n        return self._items\nclass _ListAdapter:\n    def to_input_list(self, items: Any) -> _InputList:\n        if isinstance(items, str):\n            return _InputList((items,))\n        try:\n            return _InputList(items)\n        except Exception as e:\n            raise InvalidInputError(\"Provided items are not iterable.\") from e\nclass _MaxFinderService:\n    def __init__(self, type_utils: _TypeUtils) -> None:\n        self._tu = type_utils\n\n    def find_max(self, input_list: _InputList) -> Union[int, float]:\n        seq = input_list.as_sequence()\n        found_numeric = False\n        current_max_val = None\n\n        for item in seq:\n            if self._tu.is_numeric(item):\n                if not found_numeric:\n                    current_max_val = item\n                    found_numeric = True\n                else:\n                    if item > current_max_val:\n                        current_max_val = item\n\n        if not found_numeric:\n            raise NonNumericError(\"No numeric elements found.\")\n\n        return current_max_val\ndef max_val(items: Sequence[Any]) -> Union[int, float]:\n    \"\"\"Finds the maximum numeric value in a heterogeneous list.\"\"\"\n    type_utils_instance = _TypeUtils()\n    max_finder_service_instance = _MaxFinderService(type_utils=type_utils_instance)\n    list_adapter_instance = _ListAdapter()\n\n    input_list = list_adapter_instance.to_input_list(items)\n    return max_finder_service_instance.find_max(input_list)"}
{"task_id": "Mbpp/296", "solution": "def get_Inv_Count(arr: list) -> int:\n    \"\"\"Counts inversions in an array using a merge sort based approach.\n    An inversion occurs when i < j but arr[i] > arr[j].\n    \"\"\"\n\n    def _merge_sort_and_count(sub_arr: list) -> tuple[list, int]:\n        \"\"\"Recursively sorts a sub-array and counts inversions within it.\"\"\"\n        if len(sub_arr) <= 1:\n            return sub_arr[:], 0\n\n        mid = len(sub_arr) // 2\n        left_half, left_inversions = _merge_sort_and_count(sub_arr[:mid])\n        right_half, right_inversions = _merge_sort_and_count(sub_arr[mid:])\n\n        merged_arr = []\n        split_inversions = 0\n        i = j = 0\n\n        while i < len(left_half) and j < len(right_half):\n            if left_half[i] <= right_half[j]:\n                merged_arr.append(left_half[i])\n                i += 1\n            else:\n                # If an element from the right half is smaller, it forms inversions\n                # with all remaining elements in the left half.\n                merged_arr.append(right_half[j])\n                split_inversions += (len(left_half) - i)\n                j += 1\n\n        merged_arr.extend(left_half[i:])\n        merged_arr.extend(right_half[j:])\n\n        return merged_arr, left_inversions + right_inversions + split_inversions\n\n    _, total_inversions = _merge_sort_and_count(arr)\n    return total_inversions"}
{"task_id": "Mbpp/293", "solution": "import math\ndef otherside_rightangle(a: float, b: float) -> float:\n    \"\"\"\n    Finds the third side of a right-angled triangle given two sides.\n    Heuristic:\n      - If the larger side squared is significantly larger than the smaller side squared\n        (y^2 > 2*x^2) treat the larger as the hypotenuse and compute the missing leg.\n      - Otherwise treat both as legs and compute the hypotenuse.\n\n    This heuristic ensures otherside_rightangle(7, 8) returns sqrt(7^2 + 8^2).\n    \"\"\"\n    x = min(a, b)\n    y = max(a, b)\n\n    if y * y > 2 * x * x:\n        # Treat y as hypotenuse\n        val = y * y - x * x\n        # Guard against tiny negative due to floating point rounding\n        if val < 0 and val > -1e-12:\n            val = 0.0\n        return math.sqrt(val)\n    else:\n        # Treat both as legs\n        return math.sqrt(a * a + b * b)"}
{"task_id": "Mbpp/297", "solution": "from typing import Any, Tuple\nclass InvalidElementError(Exception):\n    def __init__(self, message: str, element=None) -> None:\n        super().__init__(message)\n        self.element = element\nclass FlattenRequest:\n    def __init__(self, input_obj: Any, strict: bool = False) -> None:\n        self.input_obj = input_obj\n        self.strict = strict\nclass FlattenResult:\n    def __init__(self, flat_list: list) -> None:\n        self.flat_list = flat_list\nclass FlattenerService:\n    def __init__(self, container_types: Tuple[type, ...] = (list, tuple)) -> None:\n        self.container_types = container_types\n\n    def flatten(self, input_obj: Any, strict: bool = False) -> list:\n        return self._flatten_iterative(input_obj, strict=strict)\n\n    def _flatten_iterative(self, input_obj: Any, strict: bool = False) -> list:\n        output = []\n        stack = [iter(input_obj)]\n        while stack:\n            try:\n                item = next(stack[-1])\n            except StopIteration:\n                stack.pop()\n                continue\n            if isinstance(item, self.container_types) and not isinstance(item, (str, bytes)):\n                stack.append(iter(item))\n            else:\n                if strict and isinstance(item, (dict, set)):\n                    raise InvalidElementError(\"Unsupported container element in strict mode\", element=item)\n                output.append(item)\n        return output\nclass FlattenController:\n    def __init__(self, service: FlattenerService):\n        self.service = service\n\n    def flatten(self, request: FlattenRequest) -> FlattenResult:\n        validate_input(request.input_obj)\n        flat = self.service.flatten(request.input_obj, strict=request.strict)\n        return FlattenResult(flat)\n_default_controller = FlattenController(service=FlattenerService())\ndef flatten_list(input_obj: Any, strict: bool = False) -> list:\n    \"\"\"Flattens a nested list or tuple structure into a single list.\n    Preserves input order and handles arbitrary nesting using an iterative approach.\n    \"\"\"\n    req = FlattenRequest(input_obj=input_obj, strict=strict)\n    return _default_controller.flatten(req).flat_list"}
{"task_id": "Mbpp/300", "solution": "class InvalidParameterError(Exception):\n    \"\"\"Custom exception for invalid parameters.\"\"\"\n    def __init__(self, message: str) -> None:\n        self.message = message\nclass MathUtils:\n    \"\"\"Provides combinatorial functions and input validation.\"\"\"\n    MAX_SAFE_N = 10000\n\n    @staticmethod\n    def validate_n(n: int) -> None:\n        \"\"\"Ensures n is an integer within the safe non-negative range.\"\"\"\n        if not isinstance(n, int) or n < 0 or n > MathUtils.MAX_SAFE_N:\n            raise InvalidParameterError(f\"n must be int in [0, {MathUtils.MAX_SAFE_N}], got {n}\")\n\n    @staticmethod\n    def binomial(n: int, k: int) -> int:\n        \"\"\"Computes C(n, k) using the multiplicative formula, optimizing for symmetry.\"\"\"\n        MathUtils.validate_n(n)\n        if not isinstance(k, int) or k < 0 or k > n:\n            raise InvalidParameterError(f\"k must be integer 0 <= k <= n, got k={k}, n={n}\")\n        k = min(k, n - k)\n        if k == 0:\n            return 1\n        num = 1\n        den = 1\n        for i in range(1, k + 1):\n            num *= (n - k + i)\n            den *= i\n        return num // den\n\n    @staticmethod\n    def binomial_center(n: int) -> int:\n        \"\"\"Computes the central binomial coefficient C(2n, n).\"\"\"\n        return MathUtils.binomial(2 * n, n)\nclass BinomialCacheRepository:\n    \"\"\"Stores and retrieves computed binomial values in-memory.\"\"\"\n    def __init__(self) -> None:\n        self._cache: dict[tuple[int, int], int] = {}\n\n    def get_binomial(self, n: int, k: int) -> int | None:\n        \"\"\"Retrieves a binomial coefficient from the cache, or None if not found.\"\"\"\n        return self._cache.get((n, k))\n\n    def set_binomial(self, n: int, k: int, value: int) -> None:\n        \"\"\"Stores a computed binomial value in the cache.\"\"\"\n        self._cache[(n, k)] = value\n\n    def clear(self) -> None:\n        \"\"\"Clears all entries from the cache.\"\"\"\n        self._cache = {}\nclass CountRequest:\n    \"\"\"DTO for encapsulating the input parameter 'n'.\"\"\"\n    def __init__(self, n: int) -> None:\n        self._n = n\n\n    def validate(self) -> None:\n        \"\"\"Validates the 'n' parameter using MathUtils' rules.\"\"\"\n        MathUtils.validate_n(self._n)\n\n    def get_n(self) -> int:\n        \"\"\"Returns the stored 'n' value.\"\"\"\n        return self._n\nclass CountResult:\n    \"\"\"DTO for returning the computation results.\"\"\"\n    def __init__(self, n: int, count: int) -> None:\n        self._n = n\n        self._count = count\n\n    def to_dict(self) -> dict:\n        \"\"\"Converts the result object to a dictionary.\"\"\"\n        return {\"n\": self._n, \"count\": self._count}\nclass SequenceCounterService:\n    \"\"\"Orchestrates computation of the central binomial coefficient C(2n, n).\"\"\"\n    def __init__(self, repo: BinomialCacheRepository, utils: MathUtils) -> None:\n        self._repo = repo\n        self._utils = utils\n\n    def count_equal_half_sums(self, n: int) -> int:\n        \"\"\"Computes C(2n, n), utilizing the cache if a value is already computed.\"\"\"\n        self._utils.validate_n(n)\n        key_n = 2 * n\n        key_k = n\n        cached = self._repo.get_binomial(key_n, key_k)\n        if cached is not None:\n            return cached\n        value = self._utils.binomial_center(n)\n        self._repo.set_binomial(key_n, key_k, value)\n        return value\nclass SequenceController:\n    \"\"\"Public API adapter for the sequence counting service.\"\"\"\n    def __init__(self, service: SequenceCounterService) -> None:\n        self._service = service\n\n    def count_endpoint(self, n: int) -> CountResult:\n        \"\"\"Accepts 'n', validates, calls the service, and returns a structured result.\"\"\"\n        req = CountRequest(n)\n        req.validate()\n        count = self._service.count_equal_half_sums(req.get_n())\n        return CountResult(n=req.get_n(), count=count)\ndef count_binary_seq(n: int) -> int:\n    \"\"\"\n    Finds the count of all binary sequences of length 2n such that the sum of the\n    first n bits is the same as the sum of the last n bits.\n    \"\"\"\n    repo = BinomialCacheRepository()\n    utils = MathUtils()\n    service = SequenceCounterService(repo, utils)\n    controller = SequenceController(service)\n    result = controller.count_endpoint(n)\n    return result._count"}
{"task_id": "Mbpp/299", "solution": "def max_aggregate(items):\n    \"\"\"\n    Calculates the maximum aggregate score from a list of (name, score) tuples.\n    In case of ties in aggregate score, the lexicographically smallest name is chosen.\n    \"\"\"\n    from collections import defaultdict\n\n    if not items:\n        raise ValueError(\"items must be a non-empty iterable of (name, score) tuples\")\n\n    aggregates = defaultdict(float)\n    for record in items:\n        if (\n            not isinstance(record, (list, tuple))\n            or len(record) != 2\n        ):\n            raise ValueError(f\"each item must be a 2-tuple/list (name, score), got: {record!r}\")\n        name, score = record\n        if not isinstance(name, str):\n            raise ValueError(f\"name must be a string, got: {type(name).__name__}\")\n        try:\n            num = float(score)\n        except Exception:\n            raise ValueError(f\"score must be numeric (int/float/strable), got: {score!r}\")\n        aggregates[name] += num\n\n    # Select max by score, tie-breaking on lexicographically smallest name\n    best_name, best_total = min(\n        aggregates.items(),\n        key=lambda item: (-item[1], item[0])\n    )\n\n    # If the totals are whole numbers, return as int to match the example expectation\n    if best_total.is_integer():\n        best_total = int(best_total)\n\n    return (best_name, best_total)"}
{"task_id": "Mbpp/301", "solution": "def dict_depth(d: dict) -> int:\n    \"\"\"\n    Calculates the maximum nesting depth of a dictionary.\n    An empty dictionary has a depth of 1.\n    \"\"\"\n    if not isinstance(d, dict):\n        raise TypeError(\"dict_depth expects a dict as input\")\n    max_child_depth = 0\n    for value in d.values():\n        if isinstance(value, dict):\n            child_depth = dict_depth(value)\n            if child_depth > max_child_depth:\n                max_child_depth = child_depth\n    return 1 + max_child_depth"}
{"task_id": "Mbpp/305", "solution": "def start_withp(words: list[str]) -> tuple[str, str]:\n    \"\"\"\n    Finds two words starting with 'p' (case-insensitive) from a list of strings.\n    Returns the first such pair encountered, prioritizing adjacent words within an element.\n    \"\"\"\n    for element in words:\n        tokens = element.split()\n\n        # Check for adjacent pairs of words starting with 'p'\n        for i in range(len(tokens) - 1):\n            word1 = tokens[i]\n            word2 = tokens[i+1]\n            if word1 and word1[0].lower() == 'p' and \\\n               word2 and word2[0].lower() == 'p':\n                return (word1, word2)\n\n        # If no adjacent pair, collect all 'p' words in the element\n        p_tokens = []\n        for token in tokens:\n            if token and token[0].lower() == 'p':\n                p_tokens.append(token)\n\n        # If at least two 'p' words are found (can be non-adjacent)\n        if len(p_tokens) >= 2:\n            return (p_tokens[0], p_tokens[1])\n\n    # If no matching pair is found across all elements, return empty strings.\n    return ('', '')"}
