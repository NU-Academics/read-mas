{"task_id": "Mbpp/276", "solution": "def volume_cylinder(radius: float, height: float) -> float:\n    \"\"\"\n    Calculates the volume of a right circular cylinder.\n\n    Raises:\n        ValueError: If radius or height are non-numeric or negative.\n    \"\"\"\n    import math\n    from dataclasses import dataclass\n\n    class ValidationError(ValueError):\n        def __init__(self, message: str) -> None:\n            super().__init__(message)\n            self.message = message\n\n    class InputValidator:\n        def validate(self, radius: float, height: float) -> None:\n            if not isinstance(radius, (int, float)) or not isinstance(height, (int, float)):\n                raise ValidationError(\"radius and height must be numeric\")\n            if radius < 0 or height < 0:\n                raise ValidationError(\"radius and height must be non-negative\")\n\n    class MathUtils:\n        pi: float = math.pi\n\n        def compute_cylinder_volume(self, radius: float, height: float) -> float:\n            return self.pi * (radius ** 2) * height\n\n    @dataclass(frozen=True)\n    class Cylinder:\n        radius: float\n        height: float\n\n        def volume_formula(self) -> float:\n            return self.radius ** 2 * self.height\n\n    class VolumeCalculator:\n        def __init__(self, math_utils: MathUtils, validator: InputValidator) -> None:\n            self._math_utils = math_utils\n            self._validator = validator\n\n        def volume(self, cylinder: Cylinder) -> float:\n            self._validator.validate(cylinder.radius, cylinder.height)\n            return self._math_utils.compute_cylinder_volume(cylinder.radius, cylinder.height)\n\n    validator = InputValidator()\n    math_utils = MathUtils()\n    calc = VolumeCalculator(math_utils, validator)\n    cyl = Cylinder(radius=radius, height=height)\n    return calc.volume(cyl)"}
{"task_id": "Mbpp/279", "solution": "def is_num_decagonal(n: int) -> int:\n    \"\"\"Calculates the nth decagonal number using the formula D(n) = 4*n^2 - 3*n.\"\"\"\n    return 4 * n**2 - 3 * n"}
{"task_id": "Mbpp/278", "solution": "def count_first_elements(t: tuple) -> int:\n    \"\"\"\n    Counts the number of elements before the first nested tuple in the given tuple.\n    Returns -1 if no nested tuple is found.\n    \"\"\"\n    for idx, elem in enumerate(t):\n        if isinstance(elem, tuple):\n            return idx\n    return -1"}
{"task_id": "Mbpp/280", "solution": "def sequential_search(arr, element):\n    \"\"\"\n    Performs a sequential search on an array for a given element.\n    Returns a tuple (found_boolean, index) where index is -1 if not found.\n    \"\"\"\n    for i, item in enumerate(arr):\n        if item == element:\n            return True, i\n    return False, -1"}
{"task_id": "Mbpp/282", "solution": "def sub_list(a, b):\n    \"\"\"\n    Subtracts elements of list `b` from list `a` element-wise.\n    Assumes `a` and `b` are lists or sequences of numbers (int or float) and have the same length.\n    \"\"\"\n    result = []\n    for i in range(len(a)):\n        result.append(float(a[i]) - float(b[i]))\n    return result"}
{"task_id": "Mbpp/281", "solution": "def all_unique(items):\n    \"\"\"\n    Checks if all elements in a given list are unique.\n    It attempts a fast hash-based check and falls back to pairwise comparison if unhashable items are present.\n    \"\"\"\n    if not items:\n        return True\n\n    try:\n        # Attempt to use a set for O(N) average time complexity for hashable items.\n        return len(set(items)) == len(items)\n    except TypeError:\n        # If any item is unhashable, fall back to O(N^2) pairwise comparison.\n        n = len(items)\n        for i in range(n):\n            for j in range(i + 1, n):\n                if items[i] == items[j]:\n                    return False\n        return True"}
{"task_id": "Mbpp/283", "solution": "def validate(n: int) -> bool:\n    \"\"\"\n    Checks if the frequency of each digit in an integer is less than or equal to the digit itself.\n    The absolute value of the input integer is used for digit extraction.\n    \"\"\"\n    s = str(abs(n))\n    counts = {}\n    for char_digit in s:\n        digit = int(char_digit)\n        counts[digit] = counts.get(digit, 0) + 1\n\n    for digit, count in counts.items():\n        if count > digit:\n            return False\n    return True"}
