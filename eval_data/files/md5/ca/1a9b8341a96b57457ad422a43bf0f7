{"task_id": "Mbpp/436", "solution": "from typing import Sequence, List\nclass InvalidInputError(Exception):\n    pass\nclass PersistenceError(Exception):\n    pass\nclass NumberRepository:\n    def save(self, input_numbers: Sequence[float|int], output_numbers: Sequence[float|int]) -> None:\n        \"\"\"Saves the input and output numbers for audit or storage.\"\"\"\n        raise NotImplementedError\nclass InMemoryNumberRepository(NumberRepository):\n    \"\"\"An in-memory repository for storing the last processed input and output.\"\"\"\n    def __init__(self) -> None:\n        self._last_entry: tuple[List[float|int], List[float|int]] | None = None\n\n    def save(self, input_numbers: Sequence[float|int], output_numbers: Sequence[float|int]) -> None:\n        \"\"\"Stores the given input and output numbers in memory.\"\"\"\n        self._last_entry = (list(input_numbers), list(output_numbers))\n\n    def get_last(self) -> tuple[List[float|int], List[float|int]] | None:\n        \"\"\"Returns the last stored input/output pair.\"\"\"\n        return self._last_entry\nclass NegativeNumberService:\n    \"\"\"Service to extract negative numbers and optionally persist audit logs.\"\"\"\n    def __init__(self, repository: NumberRepository | None = None) -> None:\n        self._repository = repository or InMemoryNumberRepository()\n\n    def get_negatives(self, numbers: Sequence[float|int]) -> List[float|int]:\n        \"\"\"\n        Extracts negative numbers from the input sequence.\n        Validates input and persists results via the configured repository.\n        \"\"\"\n        if numbers is None:\n            raise InvalidInputError(\"numbers cannot be None\")\n        if not isinstance(numbers, Sequence):\n            raise InvalidInputError(\"numbers must be a sequence of ints/floats\")\n\n        negatives = self._filter_negatives(numbers)\n\n        try:\n            self._repository.save(list(numbers), negatives)\n        except Exception as exc:\n            raise PersistenceError(\"Failed to persist audit log\") from exc\n\n        return negatives\n\n    def _filter_negatives(self, numbers: Sequence[float|int]) -> List[float|int]:\n        \"\"\"Filters a sequence of numbers, returning only the negative ones while preserving order.\"\"\"\n        return [x for x in numbers if isinstance(x, (int, float)) and x < 0]\ndef neg_nos(numbers: Sequence[float|int]) -> List[float|int]:\n    \"\"\"\n    Convenience function to extract negative numbers using a default in-memory service.\n    \"\"\"\n    svc = NegativeNumberService()\n    return svc.get_negatives(numbers)"}
{"task_id": "Mbpp/439", "solution": "from typing import List, Any, Iterator, Optional\nclass ConversionError(Exception):\n    \"\"\"Base exception for conversion errors.\"\"\"\n    def __init__(self, message: str, field: Optional[str]=None, index: Optional[int]=None) -> None:\n        super().__init__(message)\n        self.message = message\n        self.field = field\n        self.index = index\nclass IntegerListValidationError(ConversionError):\n    \"\"\"Exception raised for invalid integer list inputs.\"\"\"\n    pass\nclass IntegerList:\n    \"\"\"A validated list of integers used for conversion.\"\"\"\n    def __init__(self, values: List[int]) -> None:\n        self.values: List[int] = list(values)\n\n    def __iter__(self) -> Iterator[int]:\n        return iter(self.values)\n\n    def __len__(self) -> int:\n        return len(self.values)\n\n    def __repr__(self) -> str:\n        return f\"IntegerList({self.values!r})\"\ndef _safe_str(n: int) -> str:\n    \"\"\"Converts an integer to its string representation.\"\"\"\n    return str(n)\ndef _join_strings_to_int(parts: List[str]) -> int:\n    \"\"\"Joins a list of string parts into a single integer.\"\"\"\n    if not parts:\n        raise IntegerListValidationError(\"No parts to join\") # This should be prevented by validator's MIN_LENGTH.\n    all_s = \"\".join(parts)\n    return int(all_s)\nclass _IntegerListValidator:\n    \"\"\"Validates raw input and produces an IntegerList.\"\"\"\n    MIN_LENGTH = 1\n\n    def validate(self, raw: Any) -> IntegerList:\n        if not isinstance(raw, (list, tuple)):\n            raise IntegerListValidationError(\"Input must be a list or tuple\", field=\"root\")\n        if len(raw) < self.MIN_LENGTH:\n            raise IntegerListValidationError(\"List must contain at least one element\", field=\"root\")\n        validated: List[int] = []\n        for i, el in enumerate(raw):\n            validated.append(self._validate_element(i, el))\n        return IntegerList(validated)\n\n    def _validate_element(self, idx: int, element: Any) -> int:\n        if isinstance(element, bool):\n            raise IntegerListValidationError(\"Boolean is not allowed\", index=idx)\n        if not isinstance(element, int):\n            raise IntegerListValidationError(\"Element must be an int\", index=idx)\n        return element\nclass _ConverterService:\n    \"\"\"Core logic to join integer strings into a single integer.\"\"\"\n    def __init__(self, validator: _IntegerListValidator) -> None:\n        self._validator = validator\n\n    def join(self, integer_list: IntegerList) -> int:\n        parts = [_safe_str(n) for n in integer_list]\n        return _join_strings_to_int(parts)\ndef multiple_to_single(nums: List[int]) -> int:\n    \"\"\"\n    Convert a list of integers into a single integer by concatenation.\n    Example: [11, 33, 50] becomes 113350.\n    \"\"\"\n    _validator_instance = _IntegerListValidator()\n    _service_instance = _ConverterService(_validator_instance)\n\n    integer_list = _validator_instance.validate(nums)\n    return _service_instance.join(integer_list)"}
