{"task_id": "Mbpp/271", "solution": "def even_Power_Sum(n: int) -> int:\n    \"\"\"\n    Calculates the sum of the first n even natural numbers raised to the fifth power.\n    \"\"\"\n    total_sum = 0\n    for i in range(1, n + 1):\n        even_num = 2 * i\n        total_sum += even_num ** 5\n    return total_sum"}
{"task_id": "Mbpp/274", "solution": "def even_binomial_Coeff_Sum(n: int) -> int:\n    \"\"\"\n    Calculates the sum of even-indexed binomial coefficients for a positive integer n.\n    This uses the closed-form formula 2^(n-1) for n >= 1.\n    \"\"\"\n    # Validate input type and value\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n    if n < 1:\n        raise ValueError(\"n must be a positive integer (>= 1)\")\n\n    # For n >= 1, the sum of binomial coefficients at even indices equals 2^(n-1)\n    return 1 << (n - 1)"}
{"task_id": "Mbpp/277", "solution": "def dict_filter(data: dict, n: int) -> dict:\n    \"\"\"\n    Filters a dictionary to include only entries with values greater than or equal to n.\n    Returns a new dictionary with the filtered key-value pairs.\n    \"\"\"\n    return {key: value for key, value in data.items() if value >= n}"}
