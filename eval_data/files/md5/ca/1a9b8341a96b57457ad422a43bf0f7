{"task_id": "Mbpp/306", "solution": "def max_sum_increasing_subseq(arr, n, i, k):\n    # dp[j] stores the maximum sum of an increasing subsequence ending at arr[j] within the prefix arr[0...i].\n    dp = [0] * (i + 1)\n\n    # Compute maximum sum increasing subsequence for the prefix arr[0...i].\n    for j in range(i + 1):\n        dp[j] = arr[j]  # Each element itself is an increasing subsequence sum.\n        for t in range(j):\n            if arr[t] < arr[j] and dp[t] + arr[j] > dp[j]:\n                dp[j] = dp[t] + arr[j]\n\n    # Find the maximum sum from the computed dp array such that its corresponding element arr[j]\n    # is strictly less than arr[k].\n    best_prefix_sum = 0\n    for j in range(i + 1):\n        if arr[j] < arr[k]:\n            best_prefix_sum = max(best_prefix_sum, dp[j])\n\n    # The final result is the maximum prefix sum found (or 0 if none) plus the element at index k.\n    return arr[k] + best_prefix_sum"}
{"task_id": "Mbpp/310", "solution": "def string_to_tuple(s: str) -> tuple:\n    \"\"\"\n    Convert a string to a tuple of characters excluding whitespace.\n\n    Example:\n        assert string_to_tuple(\"python 3.0\") == ('p', 'y', 't', 'h', 'o', 'n', '3', '.', '0')\n    \"\"\"\n    if not isinstance(s, str):\n        raise TypeError(\"input must be a str\")\n    return tuple(ch for ch in s if not ch.isspace())"}
{"task_id": "Mbpp/308", "solution": "import heapq\ndef large_product(a: list[int], b: list[int], k: int) -> list[int]:\n    \"\"\"Finds the specified number of largest products from two lists.\n    Selects one factor from each list, using a max-heap based algorithm.\n    \"\"\"\n    a_sorted = sorted(a, reverse=True)\n    b_sorted = sorted(b, reverse=True)\n\n    if not a_sorted or not b_sorted or k <= 0:\n        return []\n\n    h = []  # Min-heap stores (-product, i, j) to simulate a max-heap\n    visited = set()  # Tracks (i, j) index pairs already added to the heap\n    result_products = []\n\n    # Start with the product of the largest elements from both sorted lists\n    initial_product = a_sorted[0] * b_sorted[0]\n    heapq.heappush(h, (-initial_product, 0, 0))\n    visited.add((0, 0))\n\n    while h and len(result_products) < k:\n        neg_prod, i, j = heapq.heappop(h)\n        current_product = -neg_prod\n        result_products.append(current_product)\n\n        # Explore neighbor by moving down in 'a_sorted'\n        if i + 1 < len(a_sorted) and (i + 1, j) not in visited:\n            next_product = a_sorted[i+1] * b_sorted[j]\n            heapq.heappush(h, (-next_product, i + 1, j))\n            visited.add((i + 1, j))\n\n        # Explore neighbor by moving down in 'b_sorted'\n        if j + 1 < len(b_sorted) and (i, j + 1) not in visited:\n            next_product = a_sorted[i] * b_sorted[j+1]\n            heapq.heappush(h, (-next_product, i, j + 1))\n            visited.add((i, j + 1))\n\n    return result_products"}
{"task_id": "Mbpp/312", "solution": "def volume_cone(radius, height):\n    \"\"\"Return the volume of a right circular cone with given radius and height.\"\"\"\n    import math\n    return (1.0 / 3.0) * math.pi * (radius ** 2) * height"}
{"task_id": "Mbpp/311", "solution": "def set_left_most_unset_bit(n: int) -> int:\n    \"\"\"Sets the left-most unset bit in a non-negative integer.\n\n    If all bits up to the current most significant bit are set, a new most significant bit is added.\n    \"\"\"\n    if not isinstance(n, int) or n < 0:\n        raise ValueError(\"Input must be a non-negative integer\")\n\n    if n == 0:\n        return 1\n\n    msb_index = n.bit_length() - 1\n\n    # Scan from the most significant bit downwards\n    for pos in range(msb_index, -1, -1):\n        # Check if the bit at 'pos' is unset\n        if not ((n >> pos) & 1):\n            return n | (1 << pos)\n\n    # If all bits from 0 to msb_index are set, set the next bit\n    return n | (1 << (msb_index + 1))"}
{"task_id": "Mbpp/389", "solution": "def find_lucas(n: int) -> int:\n    \"\"\"Calculates the n'th Lucas number using an iterative approach.\"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n    if n < 0:\n        raise ValueError(\"n must be non-negative\")\n\n    if n == 0:\n        return 2\n    if n == 1:\n        return 1\n\n    a, b = 2, 1  # L0, L1\n    for _ in range(2, n + 1):\n        a, b = b, a + b\n    return b"}
{"task_id": "Mbpp/388", "solution": "def highest_Power_of_2(n: int) -> int:\n    \"\"\"Finds the highest power of 2 less than or equal to n using bit manipulation.\n\n    Args:\n        n: A positive integer (n >= 1).\n\n    Returns:\n        The largest power of two <= n.\n\n    Raises:\n        ValueError: If n is not an int or is less than 1.\n    \"\"\"\n    if not isinstance(n, int):\n        raise ValueError(f\"Input must be an integer, got {type(n).__name__}\")\n    if n < 1:\n        raise ValueError(\"Input must be >= 1\")\n\n    v = n\n    v |= v >> 1\n    v |= v >> 2\n    v |= v >> 4\n    v |= v >> 8\n    v |= v >> 16\n    v |= v >> 32  # covers integers up to 64 bits and beyond safely for Python's arbitrary precision\n    return (v + 1) >> 1"}
