{"task_id": "Mbpp/69", "solution": "from typing import List, Any, Optional, Tuple\nfrom collections import OrderedDict\nclass CacheRepository:\n    \"\"\"In-memory LRU cache for sublist check results.\"\"\"\n    def __init__(self, max_size: int = 128):\n        self.max_size = max_size\n        self._store: OrderedDict[Tuple[int, int], bool] = OrderedDict()\n\n    def get(self, key: Tuple[int, int]) -> Optional[bool]:\n        val = self._store.get(key)\n        if val is not None:\n            self._store.move_to_end(key)\n        return val\n\n    def set(self, key: Tuple[int, int], value: bool) -> None:\n        self._store[key] = value\n        self._store.move_to_end(key)\n        if len(self._store) > self.max_size:\n            self._store.popitem(last=False)\n\n    def _hash_list(self, lst: List[Any]) -> int:\n        \"\"\"Generates a stable hash for a list, handling unhashable elements.\"\"\"\n        try:\n            return hash(tuple(lst))\n        except TypeError:\n            # Fallback rolling hash for unhashable elements, using repr for stability.\n            h = 0\n            for el in lst:\n                h = (h * 31 + hash(repr(el))) & 0xFFFFFFFFFFFFFFFF\n            return h\nclass SublistChecker:\n    \"\"\"Core class for detecting contiguous sublists using KMP algorithm.\"\"\"\n    def __init__(self, cache: Optional[CacheRepository] = None) -> None:\n        self._cache = cache\n\n    def has_sublist(self, haystack: List[Any], needle: List[Any]) -> bool:\n        # Validate inputs, which raises SublistError if conditions are not met.\n        validate_inputs(haystack, needle)\n        if len(needle) == 0:\n            return True\n\n        key = None\n        if self._cache:\n            key = (self._cache._hash_list(haystack), self._cache._hash_list(needle))\n            cached = self._cache.get(key)\n            if cached is not None:\n                return cached\n\n        idx = self._kmp_search(haystack, needle)\n        result = idx is not None\n\n        if self._cache and key is not None:\n            self._cache.set(key, result)\n        return result\n\n    def _build_lps(self, pattern: List[Any]) -> List[int]:\n        \"\"\"Computes the Longest Prefix Suffix (LPS) array for the KMP algorithm.\"\"\"\n        m = len(pattern)\n        lps = [0] * m\n        length = 0\n        i = 1\n        while i < m:\n            if pattern[i] == pattern[length]:\n                length += 1\n                lps[i] = length\n                i += 1\n            else:\n                if length != 0:\n                    length = lps[length - 1]\n                else:\n                    lps[i] = 0\n                    i += 1\n        return lps\n\n    def _kmp_search(self, haystack: List[Any], needle: List[Any]) -> Optional[int]:\n        \"\"\"Performs KMP search to find the first occurrence of needle in haystack.\"\"\"\n        n = len(haystack)\n        m = len(needle)\n\n        if m == 0:\n            return 0  # An empty needle is always found at index 0.\n        if m > n:\n            return None # Needle cannot be longer than haystack.\n\n        lps = self._build_lps(needle)\n\n        i = 0  # index for haystack\n        j = 0  # index for needle\n        while i < n:\n            if needle[j] == haystack[i]:\n                i += 1\n                j += 1\n\n            if j == m:\n                return i - j  # Match found.\n            elif i < n and needle[j] != haystack[i]:\n                if j != 0:\n                    j = lps[j - 1]\n                else:\n                    i += 1\n        return None\ndef is_sublist(haystack: list, needle: list) -> bool:\n    \"\"\"Checks if a list (needle) exists as a contiguous sublist within another list (haystack).\"\"\"\n    # This convenience function delegates the core logic to a SublistChecker instance.\n    checker = SublistChecker()\n    return checker.has_sublist(haystack, needle)"}
{"task_id": "Mbpp/70", "solution": "def get_equal(items):\n    \"\"\"\n    Checks if all tuples in the given iterable have the same length.\n    Returns True for an empty iterable.\n    \"\"\"\n    if not items:\n        return True\n\n    first_length = len(items[0])\n\n    for i in range(1, len(items)):\n        if len(items[i]) != first_length:\n            return False\n\n    return True"}
{"task_id": "Mbpp/71", "solution": "def comb_sort(items):\n    \"\"\"Sorts a list of elements using the Comb Sort algorithm.\"\"\"\n    n = len(items)\n    working_list = list(items)  # Create a copy to avoid mutating the original list\n    gap = n\n    shrink_factor = 1.3\n    swapped = True\n\n    while gap > 1 or swapped:\n        gap = int(gap / shrink_factor)\n        if gap < 1:\n            gap = 1\n\n        swapped = False\n        for i in range(n - gap):\n            if working_list[i] > working_list[i + gap]:\n                working_list[i], working_list[i + gap] = working_list[i + gap], working_list[i]\n                swapped = True\n    return working_list"}
{"task_id": "Mbpp/74", "solution": "def is_samepatterns(seq, pattern):\n    \"\"\"\n    Checks if two sequences follow the same pattern using bijective mapping.\n    Assumes inputs are lists of hashable elements.\n    \"\"\"\n    if len(seq) != len(pattern):\n        return False\n\n    fwd_map = {}  # Map from sequence element to pattern element\n    rev_map = {}  # Map from pattern element to sequence element\n\n    for s_elem, p_elem in zip(seq, pattern):\n        # Check forward mapping consistency\n        if s_elem in fwd_map:\n            if fwd_map[s_elem] != p_elem:\n                return False\n        else:\n            fwd_map[s_elem] = p_elem\n\n        # Check reverse mapping consistency\n        if p_elem in rev_map:\n            if rev_map[p_elem] != s_elem:\n                return False\n        else:\n            rev_map[p_elem] = s_elem\n\n    return True"}
{"task_id": "Mbpp/72", "solution": "def dif_Square(n: int) -> bool:\n    \"\"\"\n    Checks if an integer can be represented as the difference of two squares.\n    An integer n can be represented as a^2 - b^2 if and only if n is not congruent to 2 modulo 4.\n    \"\"\"\n    return (n % 4) != 2"}
{"task_id": "Mbpp/80", "solution": "def tetrahedral_number(n: int) -> int:\n    \"\"\"\n    Calculates the nth tetrahedral number using the direct formula T(n) = n*(n+1)*(n+2)//6.\n    Assumes n is a non-negative integer.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n    if n < 0:\n        raise ValueError(\"n must be non-negative\")\n    return n * (n + 1) * (n + 2) // 6"}
