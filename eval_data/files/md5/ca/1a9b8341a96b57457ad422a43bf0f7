{"task_id": "Mbpp/409", "solution": "from typing import List, Tuple\ndef min_product_tuple(pairs: List[Tuple[int, int]]) -> int:\n    \"\"\"\n    Finds the minimum product of elements within each 2-element tuple in a list.\n\n    Args:\n        pairs: List of 2-element tuples of integers.\n\n    Returns:\n        The minimum product (int) among the products of each tuple.\n\n    Raises:\n        ValueError: If pairs is empty.\n        TypeError: If elements are not tuples/lists of length 2 or not integers.\n    \"\"\"\n    if not pairs:\n        raise ValueError(\"pairs must contain at least one tuple\")\n\n    min_prod = None\n    for item in pairs:\n        if not (isinstance(item, (list, tuple)) and len(item) == 2):\n            raise TypeError(f\"Each item must be a 2-element tuple or list, got: {item!r}\")\n        a, b = item\n        if not isinstance(a, int) or not isinstance(b, int):\n            raise TypeError(f\"Tuple elements must be integers, got: {item!r}\")\n        prod = a * b\n        if min_prod is None or prod < min_prod:\n            min_prod = prod\n\n    return min_prod"}
{"task_id": "Mbpp/412", "solution": "def remove_odd(numbers: list) -> list:\n    \"\"\"\n    Removes odd numbers from a list, converting elements to int where possible and skipping others.\n    Non-integer convertible items and boolean values are skipped to ensure only numeric integers are processed.\n    \"\"\"\n    even_numbers = []\n    for item in numbers:\n        converted_value = None\n        # As per design guidance for safe_int_convert, booleans are specifically skipped.\n        if isinstance(item, bool):\n            continue\n        try:\n            converted_value = int(item)\n        except (ValueError, TypeError):\n            # If an item cannot be converted to an integer, it is skipped.\n            continue\n\n        # If conversion was successful and the number is even, add it to the result.\n        if converted_value is not None and (converted_value % 2) == 0:\n            even_numbers.append(converted_value)\n    return even_numbers"}
{"task_id": "Mbpp/410", "solution": "import numbers\nfrom decimal import Decimal\nfrom typing import Any, Sequence, Optional, Iterator, Union\nclass NoNumericValuesError(ValueError):\n    \"\"\"Exception raised when no numeric values are found in the input list.\"\"\"\n    def __init__(self, message: Union[str, None] = None) -> None:\n        super().__init__(message if message is not None else \"No numeric values found in input.\")\n        self.message = message if message is not None else \"No numeric values found in input.\"\nclass LoggerAdapter:\n    \"\"\"A minimal logger adapter for debug and info messages.\"\"\"\n    def __init__(self, level: str = \"INFO\") -> None:\n        self.level = level\n\n    def log_debug(self, msg: str) -> None:\n        pass\n\n    def log_info(self, msg: str) -> None:\n        pass\nclass InputData:\n    \"\"\"Validates and holds the input values, ensuring it's list-like and stored as a list.\"\"\"\n    def __init__(self, values: Any) -> None:\n        self.values = values\n\n    def validate(self) -> None:\n        \"\"\"Ensures the input is a list or tuple, converting tuples to lists. Raises TypeError for invalid types.\"\"\"\n        if not isinstance(self.values, (list, tuple)):\n            raise TypeError(\"Input 'values' must be a list or tuple.\")\n        if isinstance(self.values, tuple):\n            self.values = list(self.values)\nclass Converter:\n    \"\"\"Provides utilities for identifying and converting numeric values.\"\"\"\n    ACCEPTED_TYPES = (int, float, Decimal)\n\n    def __init__(self) -> None:\n        pass\n\n    def is_numeric(self, value: Any) -> bool:\n        \"\"\"Checks if a value is an instance of a numeric type.\"\"\"\n        return isinstance(value, numbers.Real) or isinstance(value, Decimal)\n\n    def to_numeric(self, value: Any) -> Optional[numbers.Real]:\n        \"\"\"Converts a value to a numeric type if possible, otherwise returns None.\"\"\"\n        if isinstance(value, numbers.Real):\n            return value\n        if isinstance(value, Decimal):\n            return float(value)\n        return None\n\n    def iter_numeric(self, values: Sequence[Any]) -> Iterator[numbers.Real]:\n        \"\"\"Yields numeric values from a sequence, skipping non-numeric entries.\"\"\"\n        for v in values:\n            num = self.to_numeric(v)\n            if num is not None:\n                yield num\nclass MinFinder:\n    \"\"\"Encapsulates the algorithm to compute the minimum numeric value.\"\"\"\n    def __init__(self, converter: Optional[Converter] = None, logger: Optional[LoggerAdapter] = None) -> None:\n        self.converter = converter or Converter()\n        self.logger = logger\n\n    def find_min(self, values: Sequence[Any]) -> numbers.Real:\n        \"\"\"Iterates through numeric values to find the minimum, raising an error if none are found.\"\"\"\n        it = self.converter.iter_numeric(values)\n        try:\n            current_min = next(it)\n        except StopIteration:\n            if self.logger:\n                self.logger.log_debug(\"No numeric values found after filtering.\")\n            raise NoNumericValuesError(\"No numeric values found in input.\")\n\n        for v in it:\n            if v < current_min:\n                current_min = v\n\n        if self.logger:\n            self.logger.log_debug(f\"Found minimum numeric value: {current_min}\")\n        return current_min\nclass MinController:\n    \"\"\"Provides the public-facing API and orchestrates input validation and minimum finding.\"\"\"\n    def __init__(self, finder: MinFinder, logger: Optional[LoggerAdapter] = None) -> None:\n        self.finder = finder\n        self.logger = logger\n\n    def min_val(self, values: list) -> numbers.Real:\n        \"\"\"Processes the input list to find its minimum numeric value.\"\"\"\n        if self.logger:\n            self.logger.log_debug(f\"MinController received values for processing: {values}\")\n\n        input_data = InputData(values)\n        input_data.validate()\n\n        return self.finder.find_min(input_data.values)\ndef min_val(values: list) -> numbers.Real:\n    \"\"\"\n    Finds the minimum numeric value in a heterogeneous list.\n    Ignores non-numeric items and raises NoNumericValuesError if no numeric values are found.\n    \"\"\"\n    controller = MinController(MinFinder(), LoggerAdapter())\n    return controller.min_val(values)"}
