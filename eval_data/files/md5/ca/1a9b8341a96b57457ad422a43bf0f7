{"task_id": "Mbpp/104", "solution": "from typing import Iterable, List, Optional, Callable, Any\nimport collections.abc\nclass InvalidInputError(Exception):\n    \"\"\"Custom exception for invalid input with optional path context.\"\"\"\n    def __init__(self, message: str, path: Optional[List[int]] = None) -> None:\n        super().__init__(message)\n        self.message = message\n        self.path = path\ndef is_iterable(obj: Any) -> bool:\n    \"\"\"Checks if an object is an iterable.\"\"\"\n    return isinstance(obj, collections.abc.Iterable)\nclass Validator:\n    \"\"\"Validates the structure and types of the input iterable.\"\"\"\n    def validate_iterable_of_iterables(self, input_iterable: Any) -> None:\n        if not is_iterable(input_iterable):\n            raise InvalidInputError(\"Top-level object is not iterable\")\n\n    def validate_elements_are_strings(self, input_iterable: Iterable[Iterable[Any]]) -> None:\n        for i, inner in enumerate(input_iterable):\n            if not is_iterable(inner):\n                raise InvalidInputError(f\"Element at index {i} is not iterable\", path=[i])\n            for j, item in enumerate(inner):\n                if not isinstance(item, str):\n                    raise InvalidInputError(\"Non-string element found\", path=[i, j])\nclass InputAdapter:\n    \"\"\"Normalizes input iterables into a List[List[str]] structure.\"\"\"\n    def normalize(self, input_iterable: Iterable[Iterable[str]]) -> List[List[str]]:\n        # Assumes validation has already ensured inner items are iterables.\n        return [list(inner) for inner in input_iterable]\nclass SortService:\n    \"\"\"Provides the core business logic for sorting sublists.\"\"\"\n    def __init__(self, key: Optional[Callable[[str], Any]] = None, reverse: bool = False):\n        self.key = key\n        self.reverse = reverse\n\n    def sort_sublists(self, sublists: List[List[str]]) -> List[List[str]]:\n        # Creates new sorted lists without mutating the original input sublists.\n        return [sorted(list(sub), key=self.key, reverse=self.reverse) for sub in sublists]\nclass SortController:\n    \"\"\"Orchestrates validation, normalization, and sorting services.\"\"\"\n    def __init__(self, service: SortService, validator: Validator, adapter: InputAdapter) -> None:\n        self.service = service\n        self.validator = validator\n        self.adapter = adapter\n\n    def sort_request(self, input_iterable: Iterable[Iterable[str]]) -> List[List[str]]:\n        self.validator.validate_iterable_of_iterables(input_iterable)\n        self.validator.validate_elements_are_strings(input_iterable)\n        normalized_input = self.adapter.normalize(input_iterable)\n        sorted_result = self.service.sort_sublists(normalized_input)\n        return sorted_result\ndef sort_sublists(input_iterable: Iterable[Iterable[str]]) -> List[List[str]]:\n    \"\"\"\n    Sorts each sublist lexicographically within a collection of lists/tuples.\n    Validates input and returns a new list of lists with sorted inner lists.\n    \"\"\"\n    service = SortService()\n    validator = Validator()\n    adapter = InputAdapter()\n    controller = SortController(service, validator, adapter)\n    return controller.sort_request(input_iterable)"}
{"task_id": "Mbpp/108", "solution": "def merge_sorted_list(list1: list, list2: list, list3: list) -> list:\n    \"\"\"\n    Merges three lists into a single sorted list.\n    It sorts each input list individually, then merges them using a three-pointer approach.\n    \"\"\"\n    # Sort each list individually using Python's built-in sorted function.\n    sorted1 = sorted(list1)\n    sorted2 = sorted(list2)\n    sorted3 = sorted(list3)\n\n    merged = []\n    i = j = k = 0  # Pointers for sorted1, sorted2, sorted3 respectively\n\n    # Merge the three sorted lists using a three-pointer approach to build the final sorted list.\n    while i < len(sorted1) or j < len(sorted2) or k < len(sorted3):\n        candidates = []\n        if i < len(sorted1):\n            candidates.append((sorted1[i], 'list1'))\n        if j < len(sorted2):\n            candidates.append((sorted2[j], 'list2'))\n        if k < len(sorted3):\n            candidates.append((sorted3[k], 'list3'))\n\n        if not candidates:\n            break  # All lists exhausted\n\n        # Find the minimum among the current elements of the lists\n        min_val_info = min(candidates, key=lambda x: x[0])\n        min_val = min_val_info[0]\n        source_list = min_val_info[1]\n\n        merged.append(min_val)\n\n        # Advance the pointer for the list from which the minimum element was taken\n        if source_list == 'list1':\n            i += 1\n        elif source_list == 'list2':\n            j += 1\n        else:  # source_list == 'list3'\n            k += 1\n\n    return merged"}
{"task_id": "Mbpp/109", "solution": "def odd_Equivalent(s: str, k: int) -> int:\n    \"\"\"\n    Return the number of rotations (0..k-1) of the binary string s that represent an odd integer.\n    A rotation is odd iff the least-significant bit (last character) of the rotated string is '1'.\n    \"\"\"\n    if not isinstance(s, str) or not s:\n        raise ValueError(\"s must be a non-empty string of '0' and '1'\")\n    if any(c not in '01' for c in s):\n        raise ValueError(\"s must contain only '0' and '1'\")\n    if not isinstance(k, int) or k < 0:\n        raise ValueError(\"k must be a non-negative integer\")\n\n    n = len(s)\n    if k == 0:\n        return 0\n\n    # In one full cycle of n rotations, each position of s appears exactly once\n    ones_per_cycle = s.count('1')\n    full_cycles = k // n\n    rem = k % n\n\n    count = full_cycles * ones_per_cycle\n\n    # For the remaining rem rotations (i = 0..rem-1), the last bit after left-rotate by i\n    # is at index (i + n - 1) % n\n    for i in range(rem):\n        if s[(i + n - 1) % n] == '1':\n            count += 1\n\n    return count"}
{"task_id": "Mbpp/111", "solution": "from typing import Iterable, List, Any, Set\nfrom abc import ABC, abstractmethod\nclass InvalidInputError(ValueError):\n    \"\"\"Custom exception for invalid input types or structures.\"\"\"\n    pass\nclass UnhashableElementError(TypeError):\n    \"\"\"Custom exception for elements that cannot be hashed.\"\"\"\n    pass\ndef normalize_element(el: Any) -> Any:\n    \"\"\"Converts unhashable elements (like lists) to hashable alternatives (tuples) if possible.\"\"\"\n    try:\n        hash(el)\n        return el\n    except TypeError:\n        if isinstance(el, list):\n            # Recursively normalize elements within the list to handle nested unhashable types\n            return tuple(normalize_element(sub_el) for sub_el in el)\n        raise UnhashableElementError(f\"Cannot normalize unhashable element: {el}\")\ndef validate_nested_lists(value: Any) -> List[List[Any]]:\n    \"\"\"Validates and normalizes nested lists, ensuring elements are hashable.\"\"\"\n    if value is None:\n        return []\n    try:\n        # Convert outer iterable to a list, and each inner iterable to a list\n        outer = [list(inner) for inner in value]\n    except TypeError:\n        raise InvalidInputError(\"Input must be an iterable of iterables.\")\n\n    normalized_outer = []\n    for inner_list in outer:\n        normalized_inner = []\n        for el in inner_list:\n            normalized_inner.append(normalize_element(el))\n        normalized_outer.append(normalized_inner)\n    return normalized_outer\nclass ListCollection:\n    \"\"\"A domain model representing a collection of nested lists with validation and normalization.\"\"\"\n    def __init__(self, lists: Iterable[Iterable[Any]]) -> None:\n        self.lists = validate_nested_lists(lists)\n\n    def validate(self) -> None:\n        \"\"\"Performs structural validation on the internal lists attribute.\"\"\"\n        if not isinstance(self.lists, list):\n            raise InvalidInputError(\"Lists must be a list of lists.\")\n        # Further checks could go here, but validate_nested_lists already covers most\n\n    def normalized(self) -> List[List[Any]]:\n        \"\"\"Returns a defensive copy of the normalized nested lists.\"\"\"\n        return [list(inner) for inner in self.lists] # Returns copy for immutability\n\n    def first_list(self) -> List[Any]:\n        \"\"\"Returns the first inner list, or an empty list if none exist.\"\"\"\n        return self.lists[0] if self.lists else []\nclass ListRepository(ABC):\n    \"\"\"Abstract base class for repositories that provide nested lists.\"\"\"\n    @abstractmethod\n    def get_lists(self) -> List[List[Any]]:\n        \"\"\"Retrieves the nested lists from the repository's source.\"\"\"\n        pass\nclass InMemoryListRepository(ListRepository):\n    \"\"\"An implementation of ListRepository that provides lists from memory.\"\"\"\n    def __init__(self, lists: Iterable[Iterable[Any]]) -> None:\n        self._lists = lists # Stores the initial iterable, validation occurs in ListCollection\n\n    def get_lists(self) -> List[List[Any]]:\n        \"\"\"Returns the stored lists.\"\"\"\n        # This will be validated and normalized by ListCollection upon creation\n        return self._lists # type: ignore\nclass CommonElementsService:\n    \"\"\"Provides the core algorithm to compute common elements across nested lists.\"\"\"\n    def __init__(self, repo: ListRepository) -> None:\n        self._repo = repo\n\n    def compute_common(self, collection: ListCollection) -> List[Any]:\n        \"\"\"\n        Computes the common elements present in all lists within the collection.\n        The result order is determined by their first occurrence in the first input list.\n        \"\"\"\n        lists = collection.normalized()\n        if not lists:\n            return []\n\n        intersection_set = self._intersect_sets(lists)\n\n        # Preserve order based on the first list\n        ordered_result = [x for x in collection.first_list() if x in intersection_set]\n        return ordered_result\n\n    def _intersect_sets(self, list_of_lists: List[List[Any]]) -> Set[Any]:\n        \"\"\"Calculates the intersection of elements across multiple lists using sets.\"\"\"\n        if not list_of_lists:\n            return set()\n\n        # Convert each inner list to a set for efficient intersection\n        sets = [set(lst) for lst in list_of_lists]\n\n        # Compute the intersection of all sets\n        # If there's only one set, its intersection with itself is itself.\n        # If multiple, use set.intersection(*other_sets).\n        result = sets[0].intersection(*sets[1:])\n        return result\ndef common_in_nested_lists(lists: Iterable[Iterable[Any]]) -> List[Any]:\n    \"\"\"\n    Finds the common elements in given nested lists.\n    The result is ordered based on the first occurrence in the first input list.\n    \"\"\"\n    repo = InMemoryListRepository(lists)\n    collection = ListCollection(repo.get_lists())\n    service = CommonElementsService(repo) # The repo isn't strictly needed by service here, but matches design\n    return service.compute_common(collection)"}
{"task_id": "Mbpp/119", "solution": "def search(nums: list) -> int:\n    \"\"\"\n    Finds the element that appears only once in a sorted array where all other elements appear twice.\n    Uses a binary search approach with O(log n) time complexity.\n    \"\"\"\n    low = 0\n    high = len(nums) - 1\n\n    while low < high:\n        mid = (low + high) // 2\n\n        # Check if mid is part of a pair\n        if nums[mid] == nums[mid ^ 1]:  # mid ^ 1 efficiently gives the other index of the pair\n            low = mid + 1\n        else:\n            high = mid\n\n    return nums[low]"}
