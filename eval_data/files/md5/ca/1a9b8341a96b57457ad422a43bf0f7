{"task_id": "Mbpp/67", "solution": "def bell_number(n: int, algorithm: str = 'bell_triangle', use_cache: bool = True, _cache: dict = {}) -> int:\n    \"\"\"\n    Computes the Bell number for a given non-negative integer n.\n    Bell numbers count the number of partitions of a set with n elements.\n\n    Parameters:\n    - n: non-negative integer\n    - algorithm: 'bell_triangle' (default) or 'stirling_dp'\n    - use_cache: whether to use an internal simple cache (default True)\n\n    Returns:\n    - int: Bell number B(n)\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n    if n < 0:\n        raise ValueError(\"n must be non-negative\")\n\n    if n == 0:\n        return 1\n\n    if use_cache and n in _cache:\n        return _cache[n]\n\n    result = 0\n    if algorithm == 'bell_triangle':\n        # Bell triangle method: B_n is the first element of the n-th row.\n        # Each new row starts with the last element of the previous row.\n        current_row = [1]\n        for _ in range(1, n + 1):\n            next_row = [current_row[-1]]  # First element of the new row\n            for j in range(len(current_row)):\n                next_row.append(next_row[-1] + current_row[j])\n            current_row = next_row\n        result = current_row[0]\n\n    elif algorithm == 'stirling_dp':\n        # Stirling numbers of the second kind DP: B(n) = sum_{k=0..n} S(n,k).\n        # S(i,k) = k * S(i-1,k) + S(i-1,k-1) with S(0,0)=1 and S(i,0)=0 for i>0.\n        stirling_table = [[0 for _ in range(n + 1)] for _ in range(n + 1)]\n        stirling_table[0][0] = 1\n\n        for i in range(1, n + 1):\n            for k in range(1, i + 1):\n                stirling_table[i][k] = k * stirling_table[i - 1][k] + stirling_table[i - 1][k - 1]\n\n        result = sum(stirling_table[n][k] for k in range(n + 1))\n\n    else:\n        raise ValueError(f\"Unknown algorithm '{algorithm}'. Supported: 'bell_triangle', 'stirling_dp'\")\n\n    if use_cache:\n        _cache[n] = result\n\n    return result"}
{"task_id": "Mbpp/65", "solution": "import types\nfrom typing import Any, Iterator, Optional, Set, Union\ndef recursive_list_sum(data: Any, ignore_non_numeric: bool = False) -> Union[int, float]:\n    \"\"\"\n    Flattens a list and sums all of its numeric elements.\n    Optionally ignores non-numeric elements.\n    \"\"\"\n\n    class InvalidInputError(Exception):\n        def __init__(self, message: str):\n            super().__init__(message)\n\n    class InvalidElementError(Exception):\n        def __init__(self, message: str, element=None):\n            super().__init__(message)\n            self.element = element\n\n    class ListFlattener:\n        def __init__(self):\n            pass\n\n        def flatten(self, obj: Any, _seen: Optional[Set[int]] = None) -> Iterator[Any]:\n            \"\"\"\n            Recursively flattens nested iterables, yielding all scalar values.\n            Protects against circular references.\n            \"\"\"\n            if _seen is None:\n                _seen = set()\n            oid = id(obj)\n            if oid in _seen:\n                return\n            _seen.add(oid)\n\n            # Yield scalar types directly (including non-numeric ones like strings)\n            if not hasattr(obj, \"__iter__\") or isinstance(obj, (str, bytes)):\n                yield obj\n                return\n\n            # If it's an iterable (but not a string/bytes), recurse\n            for item in obj:\n                yield from self.flatten(item, _seen)\n\n    class SumService:\n        def __init__(self):\n            pass\n\n        def compute_sum(self, data: Any, ignore_non_numeric: bool = False) -> Union[int, float]:\n            \"\"\"\n            Computes the sum of numeric elements in 'data'. If 'data' is a scalar, returns it.\n            This method assumes `data` is already a flat iterable (or scalar).\n            \"\"\"\n            if isinstance(data, (int, float)):\n                return data\n            if hasattr(data, \"__iter__\") and not isinstance(data, (str, bytes)):\n                return self._sum_iterable(iter(data), ignore_non_numeric)\n            if ignore_non_numeric:\n                return 0\n            raise InvalidInputError(\"Unsupported top-level data type for direct summation (must be numeric or iterable)\")\n\n        def _sum_iterable(self, values: Iterator[Any], ignore_non_numeric: bool = False) -> Union[int, float]:\n            \"\"\"\n            Helper to iterate and sum numbers from an iterator of potentially mixed types.\n            Tries to preserve integer type if all elements are integers.\n            \"\"\"\n            total = 0\n            all_ints = True\n            for v in values:\n                if isinstance(v, (int, float)):\n                    if isinstance(v, float):\n                        all_ints = False\n                    total += v\n                else:\n                    if not ignore_non_numeric:\n                        raise InvalidElementError(f\"Non-numeric element: {v}\", element=v)\n            return int(total) if all_ints else float(total)\n\n    class RecursiveListSumController:\n        def __init__(self, flattener: 'ListFlattener' = None, service: 'SumService' = None):\n            self.flattener = flattener or ListFlattener()\n            self.service = service or SumService()\n\n        def sum_from_object(self, obj: Any, ignore_non_numeric: bool = False) -> Union[int, float]:\n            \"\"\"\n            Orchestrates flattening and summation of a potentially nested object.\n            \"\"\"\n            try:\n                flat_iter = self.flattener.flatten(obj)\n                return self.service._sum_iterable(flat_iter, ignore_non_numeric)\n            except TypeError as e:\n                # Catch potential TypeErrors from issues during iteration of malformed objects\n                raise InvalidElementError(f\"Error during flattening: {e}\")\n            except (InvalidInputError, InvalidElementError) as e:\n                # Re-raise specific domain errors\n                raise e\n            except Exception as e:\n                # Catch any other unexpected errors\n                raise InvalidInputError(f\"An unexpected error occurred: {e}\")\n\n    controller = RecursiveListSumController()\n    return controller.sum_from_object(data, ignore_non_numeric=ignore_non_numeric)"}
{"task_id": "Mbpp/68", "solution": "def is_Monotonic(array):\n    try:\n        seq = list(array)\n    except TypeError:\n        raise TypeError(\"Provided input is not iterable\")\n    if len(seq) <= 1:\n        return True\n    non_decreasing = True\n    non_increasing = True\n    for i in range(len(seq) - 1):\n        if seq[i] < seq[i + 1]:\n            non_increasing = False\n        if seq[i] > seq[i + 1]:\n            non_decreasing = False\n        if not non_decreasing and not non_increasing:\n            return False\n    return True"}
