{"task_id": "Mbpp/252", "solution": "def convert(value):\n    import math\n\n    # Parse input into a complex number\n    if isinstance(value, complex):\n        c = value\n    elif isinstance(value, (int, float)):\n        c = complex(float(value), 0.0)\n    elif isinstance(value, str):\n        s = value.strip()\n        # Try direct complex parsing; allow spaces by removing them if necessary\n        try:\n            c = complex(s)\n        except Exception:\n            try:\n                c = complex(s.replace(\" \", \"\"))\n            except Exception:\n                raise ValueError(f\"cannot parse string to complex: {value!r}\")\n    else:\n        raise TypeError(f\"unsupported input type: {type(value)!r}\")\n\n    x = float(c.real)\n    y = float(c.imag)\n\n    r = math.hypot(x, y)\n    theta = math.atan2(y, x)\n\n    if not (math.isfinite(r) and math.isfinite(theta)):\n        raise ValueError(\"non-finite result for input\")\n\n    return (r, theta)"}
