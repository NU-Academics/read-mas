{"task_id": "Mbpp/453", "solution": "def sumofFactors(n: int) -> int:\n    \"\"\"\n    Calculates the sum of even factors of a given positive integer n.\n    Factors are enumerated up to sqrt(n) for efficiency.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"Input must be an integer\")\n    if n < 1:\n        raise ValueError(\"Input must be a positive integer\")\n\n    total_sum = 0\n    i = 1\n    while i * i <= n:\n        if n % i == 0:\n            # Check factor i\n            if i % 2 == 0:\n                total_sum += i\n            # Check paired factor n // i\n            if i * i != n:\n                other_factor = n // i\n                if other_factor % 2 == 0:\n                    total_sum += other_factor\n        i += 1\n    return total_sum"}
{"task_id": "Mbpp/454", "solution": "import re\ndef text_match_wordz(text: str) -> bool:\n    \"\"\"\n    Checks if the input text contains any word with the letter 'z' (case-insensitive).\n    A word is defined as a sequence of alphanumeric characters or underscores.\n    \"\"\"\n    pattern = r\"\\b\\w*z\\w*\\b\"\n    return bool(re.search(pattern, text, re.IGNORECASE))"}
{"task_id": "Mbpp/455", "solution": "def check_monthnumb_number(month: int) -> bool:\n    \"\"\"\n    Check whether the given month number contains 31 days.\n\n    Accepts an int or a value convertible to int (e.g., a numeric string).\n    Raises ValueError for invalid or out-of-range inputs.\n    \"\"\"\n    try:\n        m = int(month)\n    except (TypeError, ValueError):\n        raise ValueError(\"month must be an integer between 1 and 12\")\n\n    if not 1 <= m <= 12:\n        raise ValueError(\"month must be between 1 and 12\")\n\n    return m in {1, 3, 5, 7, 8, 10, 12}"}
{"task_id": "Mbpp/457", "solution": "def Find_Min(lists):\n    if not lists:\n        return None\n    min_sublist = lists[0]\n    try:\n        min_len = len(min_sublist)\n    except TypeError:\n        raise TypeError(\"All elements must be sequences with a length\")\n    for sublist in lists[1:]:\n        try:\n            current_length = len(sublist)\n        except TypeError:\n            raise TypeError(\"All elements must be sequences with a length\")\n        if current_length < min_len:\n            min_len = current_length\n            min_sublist = sublist\n    return min_sublist"}
{"task_id": "Mbpp/456", "solution": "def reverse_string_list(values: list[str]) -> list[str]:\n    \"\"\"\n    Reverse each string in the input list and return a new list with reversed strings.\n\n    Raises:\n        TypeError: if `values` is not a list or any element is not a string.\n    \"\"\"\n    if not isinstance(values, list):\n        raise TypeError(\"values must be a list of strings\")\n    result: list[str] = []\n    for i, v in enumerate(values):\n        if not isinstance(v, str):\n            raise TypeError(f\"element at index {i} is not a string\")\n        result.append(v[::-1])\n    return result"}
