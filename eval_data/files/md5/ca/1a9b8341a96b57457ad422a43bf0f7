{"task_id": "Mbpp/239", "solution": "def get_total_number_of_sequences(m: int, n: int) -> int:\n    \"\"\"\n    Calculates the number of sequences of length n with elements up to m,\n    where each element is at least twice the previous one.\n    Uses a memoized recursive approach.\n    \"\"\"\n    if not isinstance(m, int) or not isinstance(n, int):\n        raise ValueError(\"m and n must be integers\")\n    if m <= 0 or n <= 0:\n        raise ValueError(\"m and n must be positive integers\")\n\n    memo = {}\n\n    def _count_from(current_val: int, remaining_len: int) -> int:\n        \"\"\"\n        Recursively counts valid sequences of a given remaining length\n        starting with the specified current value.\n        \"\"\"\n        key = (current_val, remaining_len)\n        if key in memo:\n            return memo[key]\n\n        if remaining_len == 1:\n            memo[key] = 1\n            return 1\n\n        min_next_val = 2 * current_val\n        if min_next_val > m:\n            memo[key] = 0\n            return 0\n\n        total = 0\n        for next_val in range(min_next_val, m + 1):\n            total += _count_from(next_val, remaining_len - 1)\n\n        memo[key] = total\n        return total\n\n    total_sequences = 0\n    for start_val in range(1, m + 1):\n        total_sequences += _count_from(start_val, n)\n\n    return total_sequences"}
{"task_id": "Mbpp/244", "solution": "import math\ndef next_Perfect_Square(n: int) -> int:\n    \"\"\"\n    Finds the next perfect square strictly greater than the given integer n.\n    For negative n, the smallest perfect square greater than n is 0.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"Input must be an integer\")\n\n    if n < 0:\n        return 0\n\n    k = math.isqrt(n)\n    return (k + 1) ** 2"}
{"task_id": "Mbpp/247", "solution": "import collections\nfrom typing import Optional, Tuple, Dict, Any\nclass TextNormalizer:\n    \"\"\"Normalizes input text based on specified options.\"\"\"\n    DEFAULT_IGNORE_SPACES = True\n    DEFAULT_CASE_INSENSITIVE = True\n\n    def normalize(self, text: str, ignore_spaces: bool = DEFAULT_IGNORE_SPACES, case_insensitive: bool = DEFAULT_CASE_INSENSITIVE) -> str:\n        \"\"\"Removes spaces and/or converts case as requested.\"\"\"\n        s = text\n        if ignore_spaces:\n            s = \"\".join(ch for ch in s if ch != \" \")\n        if case_insensitive:\n            s = s.upper()\n        return s\nclass InMemoryCacheRepository:\n    \"\"\"An in-memory key-value cache for LPS lengths.\"\"\"\n    def __init__(self):\n        self._store: Dict[str, int] = collections.defaultdict(int)\n\n    def get(self, key: str) -> Optional[int]:\n        \"\"\"Retrieves a cached value by key.\"\"\"\n        return self._store.get(key)\n\n    def set(self, key: str, value: int) -> None:\n        \"\"\"Stores a value in the cache with the given key.\"\"\"\n        self._store[key] = value\n\n    def clear(self) -> None:\n        \"\"\"Clears all entries from the cache.\"\"\"\n        self._store.clear()\nclass LPSResponse:\n    \"\"\"Data transfer object for LPS computation results.\"\"\"\n    def __init__(self, length: int, subsequence: Optional[str]):\n        self.length = length\n        self.subsequence = subsequence\n\n    def to_dict(self) -> Dict[str, Any]:\n        \"\"\"Converts the response to a dictionary.\"\"\"\n        return {\"length\": self.length, \"subsequence\": self.subsequence}\nclass LPSService:\n    \"\"\"Core service for computing the Longest Palindromic Subsequence length.\"\"\"\n    def __init__(self, normalizer: TextNormalizer, cache: Optional[InMemoryCacheRepository] = None):\n        self._normalizer = normalizer\n        self._cache = cache\n\n    def _cache_key(self, text: str, ignore_spaces: bool, case_insensitive: bool) -> str:\n        \"\"\"Generates a deterministic cache key based on text and normalization options.\"\"\"\n        return f\"{ignore_spaces}:{case_insensitive}:{text}\"\n\n    def _compute_dp(self, s: str, reconstruct: bool = False) -> Tuple[int, Optional[str]]:\n        \"\"\"\n        Computes the length of the longest palindromic subsequence using dynamic programming.\n        Subsequence reconstruction is currently not implemented for this function.\n        \"\"\"\n        n = len(s)\n        if n == 0:\n            return 0, None\n\n        dp = [[0] * n for _ in range(n)]\n\n        # All single characters are palindromes of length 1\n        for i in range(n):\n            dp[i][i] = 1\n\n        # Fill the DP table for substrings of length L from 2 to n\n        for i in range(n - 1, -1, -1):\n            for j in range(i + 1, n):\n                if s[i] == s[j]:\n                    # If characters match, add 2 to the LPS of the inner substring s[i+1...j-1]\n                    dp[i][j] = 2 + (dp[i+1][j-1] if i + 1 <= j - 1 else 0)\n                else:\n                    # If characters don't match, take the maximum of excluding s[i] or s[j]\n                    dp[i][j] = max(dp[i+1][j], dp[i][j-1])\n\n        return dp[0][n-1], None # Always return None for subsequence as reconstruct is not handled here\n\n    def compute(self, text: str, ignore_spaces: bool = True, case_insensitive: bool = True, reconstruct: bool = False) -> LPSResponse:\n        \"\"\"\n        Computes the LPS length for the given text, with optional normalization and caching.\n        It orchestrates normalization, cache lookup, and DP computation.\n        \"\"\"\n\n        normalized_text = self._normalizer.normalize(text, ignore_spaces, case_insensitive)\n\n        cache_key = self._cache_key(normalized_text, ignore_spaces, case_insensitive)\n\n        if self._cache:\n            cached_length = self._cache.get(cache_key)\n            if cached_length is not None:\n                return LPSResponse(cached_length, None) # reconstruct is always False for the lps convenience function\n\n        length, subsequence = self._compute_dp(normalized_text, reconstruct=reconstruct)\n\n        if self._cache:\n            self._cache.set(cache_key, length)\n\n        return LPSResponse(length, subsequence)\ndef lps(text: str, ignore_spaces: bool = True, case_insensitive: bool = True) -> int:\n    \"\"\"\n    Convenience function to find the length of the longest palindromic subsequence.\n    It uses a TextNormalizer, an InMemoryCacheRepository, and an LPSService internally.\n    \"\"\"\n    normalizer = TextNormalizer()\n    cache = InMemoryCacheRepository()\n    svc = LPSService(normalizer=normalizer, cache=cache)\n    resp = svc.compute(text, ignore_spaces=ignore_spaces, case_insensitive=case_insensitive, reconstruct=False)\n    return resp.length"}
{"task_id": "Mbpp/245", "solution": "def max_sum(array: list) -> int:\n    \"\"\"\n    Finds the maximum sum of a bitonic subsequence in the given array.\n    A sequence is bitonic if it is first increasing and then decreasing.\n    \"\"\"\n    n = len(array)\n\n    if n == 0:\n        return 0\n\n    # inc[i] stores the maximum sum of an increasing subsequence ending at array[i]\n    inc = [val for val in array]\n\n    # dec[i] stores the maximum sum of a decreasing subsequence starting at array[i]\n    dec = [val for val in array]\n\n    # Calculate max sum of increasing subsequence ending at each index\n    for i in range(n):\n        for j in range(i):\n            if array[j] < array[i]:\n                inc[i] = max(inc[i], inc[j] + array[i])\n\n    # Calculate max sum of decreasing subsequence starting at each index (processing from right to left)\n    for i in range(n - 1, -1, -1):\n        for j in range(n - 1, i, -1):\n            if array[j] < array[i]:\n                dec[i] = max(dec[i], dec[j] + array[i])\n\n    # Combine increasing and decreasing sums to find the maximum bitonic sum.\n    # The peak element array[i] is included in both inc[i] and dec[i], so subtract it once.\n    # Initialize max_bitonic_sum to 0 as per design context (if all sums are negative, return 0).\n    max_bitonic_sum = 0\n\n    for i in range(n):\n        current_bitonic_sum = inc[i] + dec[i] - array[i]\n        if current_bitonic_sum > max_bitonic_sum:\n            max_bitonic_sum = current_bitonic_sum\n\n    return max_bitonic_sum"}
