{"task_id": "Mbpp/801", "solution": "def test_three_equal(a, b, c):\n    \"\"\"Counts the number of equal integers among three given values.\"\"\"\n    if a == b == c:\n        return 3\n    if a == b or b == c or a == c:\n        return 2\n    return 0"}
{"task_id": "Mbpp/804", "solution": "def is_product_even(numbers: list) -> bool:\n    \"\"\"Checks if the product of numbers in a list is even.\"\"\"\n    # An empty list's product is 1, which is odd.\n    if not numbers:\n        return False\n\n    # The product is even if at least one number in the list is even.\n    for n in numbers:\n        if n % 2 == 0:\n            return True\n\n    # If no even numbers were found, all numbers are odd, so their product is odd.\n    return False"}
{"task_id": "Mbpp/805", "solution": "def max_sum_list(lists: list[list[int]]) -> list[int]:\n    \"\"\"\n    Returns the sublist in a list of lists whose sum of elements is the highest.\n    In case of a tie, the first sublist encountered with the highest sum is returned.\n    \"\"\"\n    return max(lists, key=sum)"}
{"task_id": "Mbpp/806", "solution": "def max_run_uppercase(s: str) -> int:\n    \"\"\"\n    Finds the maximum run of consecutive ASCII uppercase characters in the given string.\n    Returns 0 if the string is empty or contains no uppercase characters.\n    \"\"\"\n    max_count = 0\n    current_count = 0\n    for char in s:\n        if 'A' <= char <= 'Z':\n            current_count += 1\n            if current_count > max_count:\n                max_count = current_count\n        else:\n            current_count = 0\n    return max_count"}
{"task_id": "Mbpp/807", "solution": "def first_odd(numbers):\n    \"\"\"Finds the first odd number in a given list of numbers.\"\"\"\n    for n in numbers:\n        if n % 2 != 0:\n            return n"}
{"task_id": "Mbpp/809", "solution": "def check_smaller(first, second):\n    \"\"\"\n    Checks if each element of the second tuple is strictly smaller than\n    its corresponding element in the first tuple.\n    \"\"\"\n    for a, b in zip(first, second):\n        if not (b < a):\n            return False\n    return True"}
{"task_id": "Mbpp/808", "solution": "def check_K(input_tuple: tuple, k: object) -> bool:\n    \"\"\"Checks if the given tuple contains the specified element k.\"\"\"\n    return k in input_tuple"}
