{"task_id": "Mbpp/7", "solution": "import re\nfrom typing import Set, Iterator, Optional, Callable, Any\nclass TokenizerError(Exception):\n    \"\"\"Base exception for tokenizer-related issues.\"\"\"\n    pass\nclass AdapterNotImplementedError(TokenizerError):\n    \"\"\"Raised when an adapter's abstract method is not implemented.\"\"\"\n    pass\nclass WordMatch:\n    \"\"\"Represents a single word token found in text.\"\"\"\n    def __init__(self, token: str, start: int, end: int):\n        self.token = token\n        self.start = start\n        self.end = end\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the token string.\"\"\"\n        return len(self.token)\n\n    def normalized(self, normalize_fn: Callable[[str], str]) -> str:\n        \"\"\"Returns the token normalized using the provided function.\"\"\"\n        return normalize_fn(self.token)\nclass TokenizerAdapter:\n    \"\"\"Abstract base class for word tokenizers.\"\"\"\n    def tokenize(self, text: str) -> Iterator[WordMatch]:\n        raise AdapterNotImplementedError(\"tokenize must be implemented by adapter\")\nDEFAULT_PATTERN = r\"\\w+\"\nclass RegexTokenizerAdapter(TokenizerAdapter):\n    \"\"\"A tokenizer that uses regular expressions to find words.\"\"\"\n    def __init__(self, pattern: Optional[str] = None):\n        self._pattern = pattern or DEFAULT_PATTERN\n        try:\n            self._re = re.compile(self._pattern, flags=re.UNICODE)\n        except re.error as e:\n            raise TokenizerError(str(e))\n\n    def tokenize(self, text: str) -> Iterator[WordMatch]:\n        for m in self._re.finditer(text):\n            yield WordMatch(m.group(0), m.start(), m.end())\ndef normalize_token(token: str, method: str = \"lower\") -> str:\n    \"\"\"Normalizes a token based on the specified method.\"\"\"\n    if method == \"lower\":\n        return token.lower()\n    elif method == \"upper\":\n        return token.upper()\n    elif method == \"casefold\":\n        return token.casefold()\n    return token\nclass WordFilterService:\n    \"\"\"Provides application logic to filter words from text.\"\"\"\n    def __init__(self, tokenizer: TokenizerAdapter):\n        self._tokenizer = tokenizer\n\n    def find_words(self, text: str, min_length: int = 4, normalize: bool = False) -> Set[str]:\n        validate_text_input(text)\n        if min_length < 1:\n            raise ValueError(\"min_length must be >= 1\")\n        results = set()\n        for wm in self._tokenizer.tokenize(text):\n            if wm.length() >= min_length:\n                token = wm.token\n                if normalize:\n                    token = normalize_token(token)\n                results.add(token)\n        return results\ndef find_char_long(text: str, min_length: int = 4) -> Set[str]:\n    \"\"\"Finds words in a string that are at least min_length characters long.\"\"\"\n    tokenizer = RegexTokenizerAdapter()\n    service = WordFilterService(tokenizer)\n    return service.find_words(text, min_length=min_length, normalize=False)"}
{"task_id": "Mbpp/4", "solution": "import heapq\ndef heap_queue_largest(numbers, n):\n    \"\"\"\n    Finds the n largest integers from a list and returns them in descending order using a min-heap.\n    Handles n=0 or n > len(numbers) cases correctly.\n    \"\"\"\n    if n == 0 or not numbers:\n        return []\n\n    heap = []\n    for x in numbers:\n        if len(heap) < n:\n            heapq.heappush(heap, x)\n        else:\n            if x > heap[0]:\n                heapq.heapreplace(heap, x)\n\n    # The heap now contains the n largest elements (unsorted ascending).\n    # Sort them in descending order for the final result.\n    return sorted(heap, reverse=True)"}
{"task_id": "Mbpp/3", "solution": "def is_not_prime(n: int) -> bool:\n    \"\"\"\n    Identifies if a given integer is a non-prime number.\n    Negative numbers, 0, and 1 are considered non-prime.\n    \"\"\"\n    import math\n\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an int\")\n\n    if n <= 1:\n        return True  # Numbers less than or equal to 1 are non-prime.\n\n    if n <= 3:\n        return False  # 2 and 3 are prime, thus not non-prime.\n\n    if n % 2 == 0:\n        return True  # Even numbers greater than 2 are non-prime.\n\n    # Check for odd divisors from 3 up to the square root of n.\n    # If any divisor is found, n is non-prime.\n    r = int(math.isqrt(n))\n    i = 3\n    while i <= r:\n        if n % i == 0:\n            return True\n        i += 2\n\n    return False  # If no divisors are found, n is prime, thus not non-prime."}
{"task_id": "Mbpp/9", "solution": "from typing import List\ndef find_Rotations(s: str) -> int:\n    \"\"\"\n    Finds the minimum number of rotations (greater than 0) required to get the same string.\n    Uses the KMP LPS array property to determine the smallest period of the string.\n    \"\"\"\n    if not isinstance(s, str) or len(s) == 0:\n        raise ValueError(\"s must be a non-empty str\")\n\n    n = len(s)\n\n    # A string of length 1 always requires 1 rotation to return to itself.\n    if n == 1:\n        return 1\n\n    def _compute_lps(text: str) -> List[int]:\n        \"\"\"\n        Computes the Longest Proper Prefix which is also Suffix (LPS) array for a given string.\n        This array is used in the KMP algorithm to find periods in strings.\n        \"\"\"\n        lps: List[int] = [0] * n\n        length = 0  # length of the previous longest prefix suffix\n        i = 1\n        while i < n:\n            if text[i] == text[length]:\n                length += 1\n                lps[i] = length\n                i += 1\n            else:\n                if length != 0:\n                    length = lps[length - 1]\n                else:\n                    lps[i] = 0\n                    i += 1\n        return lps\n\n    lps = _compute_lps(s)\n\n    # The length of the smallest repeating unit (period) is n - lps[-1].\n    # If the string length is a multiple of this period, then the period itself is the answer.\n    # Otherwise, the string itself is the smallest period (n rotations).\n    period = n - lps[-1]\n    if period != n and n % period == 0:\n        return period\n    return n"}
{"task_id": "Mbpp/12", "solution": "def sort_matrix(matrix):\n    \"\"\"\n    Sorts a matrix (list of lists) based on the sum of its rows in ascending order.\n    Rows with equal sums maintain their original relative order.\n    \"\"\"\n    if not matrix:\n        return []\n\n    # Pair each row with its original index and sum\n    rows_with_sums = []\n    for i, row in enumerate(matrix):\n        rows_with_sums.append((sum(row), i, row))\n\n    # Sort based on row sum, then original index for stability\n    rows_with_sums.sort(key=lambda x: (x[0], x[1]))\n\n    # Extract the sorted rows\n    sorted_matrix = [row_tuple[2] for row_tuple in rows_with_sums]\n\n    return sorted_matrix"}
{"task_id": "Mbpp/11", "solution": "def remove_Occ(s: str, ch: str) -> str:\n    \"\"\"Removes the first and last occurrence of a character from a string.\n\n    If the character appears only once, that single occurrence is removed.\n    If the character does not appear, the original string is returned.\n    \"\"\"\n    first_idx = s.find(ch)\n\n    if first_idx == -1:\n        # Character not found, return the original string\n        return s\n\n    last_idx = s.rfind(ch)\n\n    if first_idx == last_idx:\n        # Character appears exactly once, remove that single occurrence\n        return s[:first_idx] + s[first_idx + 1:]\n    else:\n        # Character appears multiple times, remove both the first and last occurrences\n        return s[:first_idx] + s[first_idx + 1:last_idx] + s[last_idx + 1:]"}
{"task_id": "Mbpp/14", "solution": "def find_Volume(base, triangle_height, length):\n    \"\"\"\n    Calculates the volume of a triangular prism.\n    The volume is derived from the area of its triangular base multiplied by its length.\n    \"\"\"\n    triangle_area = 0.5 * base * triangle_height\n    volume = triangle_area * length\n    return volume"}
