{"task_id": "HumanEval/31", "solution": "def is_prime(n):\n    \"\"\"Return true if a given number is prime, and false otherwise.\n    >>> is_prime(6)\n    False\n    >>> is_prime(101)\n    True\n    >>> is_prime(11)\n    True\n    >>> is_prime(13441)\n    True\n    >>> is_prime(61)\n    True\n    >>> is_prime(4)\n    False\n    >>> is_prime(1)\n    False\n    \"\"\"\n    if n <= 1:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n    \n    # Check for odd divisors from 3 up to the square root of n\n    i = 3\n    while i * i <= n:\n        if n % i == 0:\n            return False\n        i += 2\n    return True"}
{"task_id": "HumanEval/29", "solution": "def filter_by_prefix(strings: List[str], prefix: str) -> List[str]:\n    \"\"\" Filter an input list of strings only for ones that start with a given prefix.\n    >>> filter_by_prefix([], 'a')\n    []\n    >>> filter_by_prefix(['abc', 'bcd', 'cde', 'array'], 'a')\n    ['abc', 'array']\n    \"\"\"\n    if not strings:\n        return []\n\n    filtered_list = []\n    for s in strings:\n        if s.startswith(prefix):\n            filtered_list.append(s)\n    return filtered_list"}
{"task_id": "HumanEval/33", "solution": "def sort_third(l: list):\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the indicies that are not divisible by three, while its values at the indicies that are divisible by three are equal\n    to the values of the corresponding indicies of l, but sorted.\n    >>> sort_third([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_third([5, 6, 3, 4, 8, 9, 2])\n    [2, 6, 3, 4, 8, 9, 5]\n    \"\"\"\n    l_prime = l[:]\n    elements_to_sort = []\n    indices_to_replace = []\n\n    for i in range(len(l)):\n        if i % 3 == 0:\n            elements_to_sort.append(l[i])\n            indices_to_replace.append(i)\n    \n    elements_to_sort.sort()\n\n    for i, original_index in enumerate(indices_to_replace):\n        l_prime[original_index] = elements_to_sort[i]\n        \n    return l_prime"}
{"task_id": "HumanEval/32", "solution": "import math\n\n\ndef poly(xs: list, x: float):\n    \"\"\"\n    Evaluates polynomial with coefficients xs at point x.\n    return xs[0] + xs[1] * x + xs[1] * x^2 + .... xs[n] * x^n\n    \"\"\"\n    return sum([coeff * math.pow(x, i) for i, coeff in enumerate(xs)])\n\n\ndef find_zero(xs: list):\n    \"\"\"\n    Finds a single zero point x such that poly(x) = 0.\n    Assumes xs has an even number of coefficients and the largest coefficient is non-zero.\n    \"\"\"\n    derivative_coeffs = [i * coeff for i, coeff in enumerate(xs)][1:]\n\n    x_current = 0.0  # Initial guess for Newton-Raphson\n    tolerance = 1e-7\n    max_iterations = 1000\n\n    for _ in range(max_iterations):\n        y = poly(xs, x_current)\n\n        if abs(y) < tolerance:\n            return x_current\n\n        dy = poly(derivative_coeffs, x_current)\n\n        # Handle cases where the derivative is very close to zero to prevent ZeroDivisionError\n        # or extremely large steps.\n        if abs(dy) < 1e-10:\n            break\n\n        x_current = x_current - y / dy\n\n    return x_current"}
{"task_id": "HumanEval/34", "solution": "def unique(l: list):\n    \"\"\"Return sorted unique elements in a list\n    >>> unique([5, 3, 5, 2, 3, 3, 9, 0, 123])\n    [0, 2, 3, 5, 9, 123]\n    \"\"\"\n    unique_elements = set(l)\n    sorted_unique_elements = sorted(list(unique_elements))\n    return sorted_unique_elements"}
{"task_id": "HumanEval/36", "solution": "```python\ndef fizz_buzz(n: int):\n    \"\"\"Return the number of times the digit 7 appears in integers less than n which are divisible by 11 or 13.\n    >>> fizz_buzz(50)\n    0\n    >>> fizz_buzz(78)\n    2\n    >>> fizz_buzz(79)\n    3\n    \"\"\"\n\n    def _is_divisible_by_11_or_13(x: int) -> bool:\n        \"\"\"Determines if an integer x is divisible by 11 or 13.\"\"\"\n        return x % 11 == 0 or x % 13 == 0\n\n    def _count_digit_7(x: int) -> int:\n        \"\"\"Counts the occurrences of the digit '7' in an integer x.\"\"\"\n        count = 0\n        s = str(x)\n        for digit in s:\n            if digit == '7':\n                count += 1\n        return count\n\n    total_sevens = 0\n    for x in range(1, n):\n        if _is_divisible_by_11_or_13(x):\n            total_sevens += _count_digit_7(x)\n    return total_sevens\n```"}
{"task_id": "HumanEval/37", "solution": "def sort_even(l: list):\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the odd indicies, while its values at the even indicies are equal\n    to the values of the even indicies of l, but sorted.\n    \"\"\"\n    \n    # Create a new list to store the result, initially a copy of the input list.\n    result_list = list(l)\n\n    # Extract elements at even indices from the original list.\n    even_indexed_elements = []\n    for i in range(0, len(l), 2):\n        even_indexed_elements.append(l[i])\n    \n    # Sort the extracted even-indexed elements.\n    even_indexed_elements.sort()\n    \n    # Place the sorted even-indexed elements back into the result list at their original even positions.\n    sorted_even_idx = 0\n    for i in range(0, len(result_list), 2):\n        result_list[i] = even_indexed_elements[sorted_even_idx]\n        sorted_even_idx += 1\n        \n    return result_list"}
{"task_id": "HumanEval/35", "solution": "def max_element(l: list):\n    \"\"\"Return maximum element in the list.\n    >>> max_element([1, 2, 3])\n    3\n    >>> max_element([5, 3, -5, 2, -3, 3, 9, 0, 123, 1, -10])\n    123\n    \"\"\"\n    if not l:\n        raise ValueError(\"max_element() arg is an empty sequence\")\n\n    max_val = l[0]\n    for element in l:\n        if element > max_val:\n            max_val = element\n    return max_val"}
{"task_id": "HumanEval/38", "solution": "def decode_cyclic(s: str):\n    \"\"\"\n    takes as input string encoded with encode_cyclic function. Returns decoded string.\n    \"\"\"\n    # split string to groups. Each of length 3.\n    groups = [s[(3 * i):min((3 * i + 3), len(s))] for i in range((len(s) + 2) // 3)]\n    # reverse cycle elements in each group. Unless group has fewer elements than 3.\n    groups = [(group[2] + group[0:2]) if len(group) == 3 else group for group in groups]\n    return \"\".join(groups)"}
{"task_id": "HumanEval/39", "solution": "def _is_prime(num: int) -> bool:\n    \"\"\"Determines if a given integer is a prime number.\n    Uses an optimized primality test by checking divisors up to the square root.\"\"\"\n    if num < 2:\n        return False\n    if num == 2 or num == 3:\n        return True\n    if num % 2 == 0 or num % 3 == 0:\n        return False\n    i = 5\n    while i * i <= num:\n        if num % i == 0 or num % (i + 2) == 0:\n            return False\n        i += 6\n    return True\n\ndef prime_fib(n: int):\n    \"\"\"\n    prime_fib returns n-th number that is a Fibonacci number and it's also prime.\n    >>> prime_fib(1)\n    2\n    >>> prime_fib(2)\n    3\n    >>> prime_fib(3)\n    5\n    >>> prime_fib(4)\n    13\n    >>> prime_fib(5)\n    89\n    \"\"\"\n    count = 0\n    a, b = 0, 1 # Initialize Fibonacci sequence F0, F1\n\n    while True:\n        next_fib = a + b # Calculate the next Fibonacci number\n        a = b\n        b = next_fib\n\n        if _is_prime(next_fib):\n            count += 1\n            if count == n:\n                return next_fib"}
{"task_id": "HumanEval/40", "solution": "def triples_sum_to_zero(l: list):\n    \"\"\"\n    Checks if there are three distinct elements in the list that sum to zero.\n    Returns True if such a triplet exists, False otherwise.\n    \"\"\"\n    n = len(l)\n    if n < 3:\n        return False\n\n    for i in range(n - 2):\n        for j in range(i + 1, n - 1):\n            for k in range(j + 1, n):\n                if l[i] + l[j] + l[k] == 0:\n                    return True\n    return False"}
