{"task_id": "HumanEval/47", "solution": "def median(l: list):\n    \"\"\"Return median of elements in the list l.\n    >>> median([3, 1, 2, 4, 5])\n    3\n    >>> median([-10, 4, 6, 1000, 10, 20])\n    15.0\n    \"\"\"\n    if not l:\n        # An empty list is an invalid input for median calculation.\n        raise ValueError(\"Input list cannot be empty.\")\n\n    sorted_l = sorted(l)\n    n = len(sorted_l)\n\n    if n % 2 == 1:\n        # For an odd number of elements, the median is the middle element.\n        middle_element = sorted_l[n // 2]\n        return int(middle_element) if middle_element == int(middle_element) else float(middle_element)\n    else:\n        # For an even number of elements, the median is the average of the two middle elements.\n        mid1 = sorted_l[n // 2 - 1]\n        mid2 = sorted_l[n // 2]\n        calculated_median = (mid1 + mid2) / 2.0\n        return int(calculated_median) if calculated_median == int(calculated_median) else float(calculated_median)"}
{"task_id": "HumanEval/49", "solution": "def modp(n: int, p: int):\n    \"\"\"Return 2^n modulo p (be aware of numerics).\"\"\"\n    res = 1\n    base = 2\n    while n > 0:\n        if n % 2 == 1:\n            res = (res * base) % p\n        base = (base * base) % p\n        n //= 2\n    return res"}
{"task_id": "HumanEval/50", "solution": "def decode_shift(s: str):\n    \"\"\"\n    takes as input string encoded with encode_shift function. Returns decoded string.\n    \"\"\"\n    def _shift_char(char: str, shift_amount: int) -> str:\n        \"\"\"\n        Shifts a single character by a given amount, handling lowercase English alphabet\n        constraints and wrapping. Non-alphabet characters are returned unchanged.\n        \"\"\"\n        if 'a' <= char <= 'z':\n            start_ord = ord('a')\n            shifted_ord = ((ord(char) - start_ord + shift_amount) % 26) + start_ord\n            return chr(shifted_ord)\n        return char\n\n    return \"\".join([_shift_char(ch, -5) for ch in s])"}
