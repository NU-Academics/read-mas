{"task_id": "HumanEval/55", "solution": "def fib(n: int):\n    \"\"\"Return n-th Fibonacci number.\n    >>> fib(10)\n    55\n    >>> fib(1)\n    1\n    >>> fib(8)\n    21\n    \"\"\"\n    if n <= 1:\n        return n\n    \n    a, b = 1, 1\n    for _ in range(n - 2):\n        a, b = b, a + b\n    return b"}
{"task_id": "HumanEval/56", "solution": "def correct_bracketing(brackets: str):\n    \"\"\" brackets is a string of \"<\" and \">\".\n    return True if every opening bracket has a corresponding closing bracket.\n    \"\"\"\n    balance = 0\n    for char in brackets:\n        if char == '<':\n            balance += 1\n        elif char == '>':\n            balance -= 1\n        \n        # If balance ever goes negative, a closing bracket appeared without a preceding open one.\n        if balance < 0:\n            return False\n            \n    # After checking all characters, a correct bracketing requires the balance to be zero.\n    return balance == 0"}
{"task_id": "HumanEval/57", "solution": "def monotonic(l: list):\n    \"\"\"Return True is list elements are monotonically increasing or decreasing.\n    >>> monotonic([1, 2, 4, 20])\n    True\n    >>> monotonic([1, 20, 4, 10])\n    False\n    >>> monotonic([4, 1, 0, -10])\n    True\n    \"\"\"\n    def _is_increasing(l: list) -> bool:\n        \"\"\"Checks if a list is monotonically increasing.\"\"\"\n        if len(l) <= 1:\n            return True\n        for i in range(len(l) - 1):\n            if l[i] > l[i+1]:\n                return False\n        return True\n\n    def _is_decreasing(l: list) -> bool:\n        \"\"\"Checks if a list is monotonically decreasing.\"\"\"\n        if len(l) <= 1:\n            return True\n        for i in range(len(l) - 1):\n            if l[i] < l[i+1]:\n                return False\n        return True\n\n    return _is_increasing(l) or _is_decreasing(l)"}
{"task_id": "HumanEval/59", "solution": "def largest_prime_factor(n: int):\n    \"\"\"Return the largest prime factor of n. Assume n > 1 and is not a prime.\n    \"\"\"\n    largest_factor = 1\n\n    # Divide by 2 until n is odd\n    while n % 2 == 0:\n        largest_factor = 2\n        n //= 2\n\n    # Iterate through odd numbers starting from 3\n    i = 3\n    while i * i <= n:\n        while n % i == 0:\n            largest_factor = i\n            n //= i\n        i += 2\n\n    # If n is still greater than 2, it means n itself is a prime factor\n    if n > 2:\n        largest_factor = n\n\n    return largest_factor"}
{"task_id": "HumanEval/58", "solution": "def common(l1: list, l2: list):\n    \"\"\"Return sorted unique common elements for two lists.\n    >>> common([1, 4, 3, 34, 653, 2, 5], [5, 7, 1, 5, 9, 653, 121])\n    [1, 5, 653]\n    >>> common([5, 3, 2, 8], [3, 2])\n    [2, 3]\n\n    \"\"\"\n    set1 = set(l1)\n    set2 = set(l2)\n\n    common_elements_set = set1.intersection(set2)\n\n    result_list = list(common_elements_set)\n\n    result_list.sort()\n\n    return result_list"}
