{"task_id": "Mbpp/580", "solution": "```python\ndef extract_even(input_tuple: tuple) -> tuple:\n    \"\"\"\n    Recursively extracts even integers from a nested tuple, preserving its structure.\n    Non-integer and non-tuple elements are ignored.\n    \"\"\"\n    result = []\n    for item in input_tuple:\n        if isinstance(item, int):\n            if item % 2 == 0:\n                result.append(item)\n        elif isinstance(item, tuple):\n            nested_result = extract_even(item)\n            result.append(nested_result)\n        # Other types (e.g., str, float) are implicitly ignored.\n    return tuple(result)\n```"}
{"task_id": "Mbpp/580", "solution": "```python\ndef extract_even(input_tuple: tuple) -> tuple:\n    \"\"\"Recursively extracts even integers from a nested tuple, preserving structure.\n    Non-even numbers and non-integer elements are filtered out.\n    \"\"\"\n    result = []\n    for item in input_tuple:\n        if isinstance(item, tuple):\n            # Recursively process nested tuples.\n            processed_nested_tuple = extract_even(item)\n            # If the processed nested tuple contains elements, or if the original item was an empty tuple,\n            # append it to preserve nesting. Otherwise, effectively remove it.\n            if processed_nested_tuple or not item:\n                result.append(processed_nested_tuple)\n        elif isinstance(item, int) and item % 2 == 0:\n            # Include even integers.\n            result.append(item)\n        # Odd integers and non-integer types are implicitly skipped/excluded.\n    return tuple(result)\n```"}
{"task_id": "Mbpp/581", "solution": "```python\ndef surface_Area(base_edge, height):\n    \"\"\"\n    Calculates the total surface area of a square pyramid.\n    It uses the perpendicular height and base edge as input.\n    \"\"\"\n    # Calculate slant height (s) using h and base_edge/2\n    slant_height = (height**2 + (base_edge / 2)**2)**0.5\n\n    # Calculate base area (BA)\n    base_area = base_edge**2\n\n    # Calculate lateral surface area (LSA = 4 * (1/2 * base_edge * slant_height))\n    lateral_surface_area = 2 * base_edge * slant_height\n\n    # Total surface area (TSA = BA + LSA)\n    total_surface_area = base_area + lateral_surface_area\n\n    return total_surface_area\n```\n"}
{"task_id": "Mbpp/581", "solution": "```python\nimport math\n\ndef surface_Area(base: float, height: float) -> float:\n    \"\"\"\n    Calculates the total surface area of a square pyramid.\n    'base' is the base edge, 'height' is the perpendicular height of the pyramid.\n    \"\"\"\n    \n    # Calculate slant height (s) using the formula: s = sqrt(h^2 + (a/2)^2)\n    slant_height = math.sqrt(height**2 + (base / 2)**2)\n    \n    # Calculate base area (A_base) using the formula: A_base = a^2\n    base_area = base**2\n    \n    # Calculate lateral surface area (A_lateral) using the formula: A_lateral = 2 * a * s\n    lateral_surface_area = 2 * base * slant_height\n    \n    # Calculate total surface area (A_total) using the formula: A_total = A_base + A_lateral\n    total_surface_area = base_area + lateral_surface_area\n    \n    return total_surface_area\n```\n"}
{"task_id": "Mbpp/583", "solution": "def catalan_number(n: int) -> int:\n    \"\"\"Calculates the Nth Catalan number C(n) using the formula C(n) = (1 / (n + 1)) * (2n choose n).\n    The input n is trusted to be a non-negative integer.\n    \"\"\"\n\n    def _binomial_coefficient_local(n_val: int, k_val: int) -> int:\n        \"\"\"Helper to calculate the binomial coefficient (n_val choose k_val).\"\"\"\n        if k_val < 0 or k_val > n_val:\n            return 0\n        if k_val == 0 or k_val == n_val:\n            return 1\n        if k_val > n_val // 2:\n            k_val = n_val - k_val\n        \n        res = 1\n        for i in range(k_val):\n            res = res * (n_val - i) // (i + 1)\n        return res\n\n    binomial_coeff = _binomial_coefficient_local(2 * n, n)\n    catalan_num = binomial_coeff // (n + 1)\n    return catalan_num"}
{"task_id": "Mbpp/585", "solution": "```python\nfrom dataclasses import dataclass\nfrom typing import List, Dict, Any\n\n@dataclass\nclass Item:\n    name: str\n    price: float\n\n    def to_dict(self) -> dict:\n        \"\"\"Converts the Item object to a dictionary.\"\"\"\n        return {\"name\": self.name, \"price\": self.price}\n\n    def __lt__(self, other: 'Item') -> bool:\n        \"\"\"\n        Enables comparison for sorting.\n        For descending order, we want 'greater' items to appear 'less' for default sort.\n        \"\"\"\n        return self.price < other.price\n\nclass ItemFinderService:\n    def find_n_most_expensive_items(self, items_data: List[Dict[str, Any]], n: int) -> List[Dict[str, Any]]:\n        \"\"\"\n        Finds the n most expensive items from a list of item dictionaries.\n\n        Args:\n            items_data: A list of dictionaries, each with 'name' (str) and 'price' (float/int).\n            n: The number of most expensive items to return.\n\n        Returns:\n            A list of dictionaries representing the n most expensive items,\n            sorted by price in descending order.\n\n        Raises:\n            TypeError: If items_data is not a list or n is not an integer.\n            ValueError: If any item in items_data is invalid (missing keys, non-numeric price).\n        \"\"\"\n        self._validate_inputs(items_data, n)\n        if n == 0:\n            return []\n\n        items: List[Item] = self._parse_items(items_data)\n\n        # Sort items by price in descending order\n        items.sort(key=lambda item: item.price, reverse=True)\n\n        # Select the top n items\n        top_n_items = items[:n]\n\n        # Convert back to list of dictionaries\n        return [item.to_dict() for item in top_n_items]\n\n    def _validate_inputs(self, items_data: List[Dict[str, Any]], n: int):\n        \"\"\"Internal method to validate input types and structure.\"\"\"\n        if not isinstance(items_data, list):\n            raise TypeError(\"Input 'items_data' must be a list.\")\n        if not isinstance(n, int):\n            raise TypeError(\"Input 'n' must be an integer.\")\n        if n < 0:\n            raise ValueError(\"Input 'n' cannot be negative.\")\n\n        for i, item_dict in enumerate(items_data):\n            if not isinstance(item_dict, dict):\n                raise ValueError(f\"Item at index {i} is not a dictionary.\")\n            if 'name' not in item_dict or 'price' not in item_dict:\n                raise ValueError(f\"Item at index {i} is missing 'name' or 'price' key.\")\n            if not isinstance(item_dict['name'], str):\n                raise ValueError(f\"Item at index {i}: 'name' must be a string.\")\n            if not isinstance(item_dict['price'], (int, float)):\n                raise ValueError(f\"Item at index {i}: 'price' must be a numeric value.\")\n\n    def _parse_items(self, items_data: List[Dict[str, Any]]) -> List[Item]:\n        \"\"\"Internal method to convert raw dictionaries to Item objects.\"\"\"\n        return [Item(name=item_dict['name'], price=float(item_dict['price'])) for item_dict in items_data]\n\ndef expensive_items(items: List[Dict[str, Any]], n: int) -> List[Dict[str, Any]]:\n    \"\"\"\n    Finds the n most expensive items in a given dataset.\n\n    Args:\n        items: A list of dictionaries, where each dictionary represents an item\n               with 'name' (str) and 'price' (float/int) keys.\n        n: The number of most expensive items to return.\n\n    Returns:\n        A list of dictionaries representing the n most expensive items,\n        sorted by price in descending order.\n\n    Raises:\n        TypeError: If 'items' is not a list or 'n' is not an integer.\n        ValueError: If any item in 'items' is invalid (missing keys, non-numeric price, etc.).\n    \"\"\"\n    finder_service = ItemFinderService()\n    return finder_service.find_n_most_expensive_items(items, n)\n```"}
{"task_id": "Mbpp/583", "solution": "```python\ndef catalan_number(n: int) -> int:\n    \"\"\"Calculates the nth Catalan number.\n\n    Args:\n        n: The non-negative integer for which to calculate the Catalan number.\n\n    Returns:\n        The nth Catalan number.\n\n    Raises:\n        ValueError: If n is a negative integer.\n    \"\"\"\n\n    # Custom exception class for invalid input, defined locally to keep the function self-contained.\n    class InvalidInputError(ValueError):\n        pass\n\n    if n < 0:\n        raise InvalidInputError(\"Input 'n' must be a non-negative integer.\")\n\n    def _combinations(N: int, K: int) -> int:\n        \"\"\"Calculates 'N choose K' (binomial coefficient) efficiently using an iterative method.\n        It assumes 0 <= K <= N for valid binomial coefficients.\"\"\"\n        if K < 0 or K > N:\n            return 0\n        if K == 0 or K == N:\n            return 1\n        # Take advantage of symmetry C(N, K) = C(N, N-K)\n        if K > N // 2:\n            K = N - K\n\n        res = 1\n        for i in range(K):\n            res = res * (N - i) // (i + 1)\n        return res\n\n    # Catalan number C_n = C(2n, n) / (n + 1)\n    combinations_2n_n = _combinations(2 * n, n)\n    \n    # The division by (n + 1) is guaranteed to be an integer for Catalan numbers\n    return combinations_2n_n // (n + 1)\n```\n"}
{"task_id": "Mbpp/585", "solution": "def expensive_items(items, n):\n    \"\"\"\n    Finds the n most expensive items in a given dataset.\n\n    Args:\n        items: A list of dictionaries, where each dictionary represents an item\n               and is expected to have a 'price' key with a numeric value.\n        n: An integer representing the number of most expensive items to retrieve.\n\n    Returns:\n        A list of dictionaries, each representing an expensive item,\n        sorted by price in descending order.\n\n    Raises:\n        ValueError: If n is not a positive integer.\n        KeyError: If an item dictionary is missing the 'price' key.\n        TypeError: If an item's 'price' value is not numeric.\n    \"\"\"\n    if not isinstance(n, int) or n <= 0:\n        raise ValueError(\"n must be a positive integer.\")\n\n    validated_items = []\n    for item in items:\n        if 'price' not in item:\n            raise KeyError(f\"Item is missing 'price' key: {item}\")\n        if not isinstance(item['price'], (int, float)):\n            raise TypeError(f\"Item price must be numeric (int or float): {item}\")\n        validated_items.append(item)\n\n    sorted_items = sorted(validated_items, key=lambda x: x['price'], reverse=True)\n    return sorted_items[:n]"}
