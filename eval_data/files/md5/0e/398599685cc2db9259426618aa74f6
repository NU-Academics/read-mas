{"task_id": "Mbpp/273", "solution": "```python\nclass TupleOperationError(Exception):\n    \"\"\"Custom exception for errors during tuple operations.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\n\ndef is_numeric_tuple(t: tuple) -> bool:\n    \"\"\"Checks if all elements in the given tuple are numeric (int or float).\"\"\"\n    return all(isinstance(x, (int, float)) for x in t)\n\ndef are_same_length(t1: tuple, t2: tuple) -> bool:\n    \"\"\"Checks if two tuples have the same length.\"\"\"\n    return len(t1) == len(t2)\n\ndef substract_elements(tuple1: tuple, tuple2: tuple) -> tuple:\n    \"\"\"\n    Subtracts the elements of the first tuple by the elements of the second tuple\n    with the same index.\n\n    Args:\n        tuple1: The first tuple (minuend).\n        tuple2: The second tuple (subtrahend).\n\n    Returns:\n        A new tuple containing the results of the subtractions.\n\n    Raises:\n        TypeError: If inputs are not tuples.\n        TupleOperationError: If tuples have different lengths or contain non-numeric elements.\n    \"\"\"\n    if not isinstance(tuple1, tuple) or not isinstance(tuple2, tuple):\n        raise TypeError(\"Both inputs must be tuples.\")\n\n    if not are_same_length(tuple1, tuple2):\n        raise TupleOperationError(\"Tuples must have the same length.\")\n\n    if not is_numeric_tuple(tuple1) or not is_numeric_tuple(tuple2):\n        raise TupleOperationError(\"All tuple elements must be numeric (int or float).\")\n\n    return tuple(a - b for a, b in zip(tuple1, tuple2))\n```\n"}
{"task_id": "Mbpp/273", "solution": "```python\nclass TupleOperationError(Exception):\n    \"\"\"Base exception for errors in tuple operations.\"\"\"\n    def __init__(self, message: str):\n        self.message = message\n        super().__init__(self.message)\n\nclass InvalidInputTypeError(TupleOperationError):\n    \"\"\"Raised when an input is not of the expected tuple type.\"\"\"\n    pass\n\nclass MismatchedLengthError(TupleOperationError):\n    \"\"\"Raised when input tuples have different lengths.\"\"\"\n    pass\n\ndef substract_elements(tuple1: tuple, tuple2: tuple) -> tuple:\n    \"\"\"\n    Subtracts elements of the second tuple from the first tuple at corresponding indices.\n\n    Args:\n        tuple1: The first tuple (minuend).\n        tuple2: The second tuple (subtrahend).\n\n    Returns:\n        A new tuple containing the results of the element-wise subtraction.\n\n    Raises:\n        InvalidInputTypeError: If either input is not a tuple.\n        MismatchedLengthError: If the input tuples have different lengths.\n        TypeError: If elements within the tuples are not numeric.\n    \"\"\"\n    if not isinstance(tuple1, tuple) or not isinstance(tuple2, tuple):\n        raise InvalidInputTypeError(\"Both inputs must be tuples.\")\n\n    if len(tuple1) != len(tuple2):\n        raise MismatchedLengthError(\"Input tuples must have the same length.\")\n\n    result = tuple(a - b for a, b in zip(tuple1, tuple2))\n    return result\n```"}
