{"task_id": "Mbpp/161", "solution": "```python\ndef remove_elements(list1: list, list2: list) -> list:\n    \"\"\"\n    Removes all elements from list1 that are present in list2.\n\n    Args:\n        list1: The source list from which elements will be removed.\n        list2: The list containing elements to be removed from list1.\n\n    Returns:\n        A new list containing only the elements from list1 that were not present in list2.\n    \"\"\"\n    # Convert list2 to a set for O(1) average time complexity lookups.\n    removal_set = set(list2)\n    \n    result_list = []\n    for element in list1:\n        if element not in removal_set:\n            result_list.append(element)\n    return result_list\n```"}
{"task_id": "Mbpp/162", "solution": "def sum_series(n):\n    \"\"\"\n    Calculates the sum of (n - 2*i) for i from 0 up to n // 2.\n    Terms are included only if they are greater than 0.\n    \"\"\"\n    total_sum = 0\n    # Iterate i from 0 up to n // 2.\n    # Add term (n - 2 * i) only if it's positive.\n    for i in range(n // 2 + 1):\n        term = n - (2 * i)\n        if term > 0:\n            total_sum += term\n        else:\n            break\n    return total_sum"}
{"task_id": "Mbpp/160", "solution": "```python\ndef extended_gcd(a: int, b: int) -> tuple[int, int, int]:\n    \"\"\"Implements the Extended Euclidean Algorithm to find gcd(a, b) and Bezout coefficients x, y.\"\"\"\n    if a == 0 and b == 0:\n        return 0, 0, 0\n    if b == 0:\n        return a, 1, 0\n    \n    gcd, x1, y1 = extended_gcd(b, a % b)\n    x = y1\n    y = x1 - (a // b) * y1\n    return gcd, x, y\n\ndef find_solution(a: int, b: int, n: int) -> tuple[int, int] | None:\n    \"\"\"Finds a particular integer solution (x, y) to the linear Diophantine equation ax + by = n.\"\"\"\n    # Handle edge cases where a or b is zero as per FR3.\n    if a == 0 and b == 0:\n        return (0, 0) if n == 0 else None\n    if a == 0:\n        return (0, n // b) if n % b == 0 else None\n    if b == 0:\n        return (n // a, 0) if n % a == 0 else None\n\n    # For a != 0 and b != 0, or one is zero and handled by extended_gcd's base cases.\n    g, x0, y0 = extended_gcd(a, b)\n\n    # Check if a solution exists (n must be divisible by gcd(a, b)).\n    if n % g != 0:\n        return None\n    \n    # Calculate the particular solution.\n    k = n // g\n    x = x0 * k\n    y = y0 * k\n    return x, y\n```"}
{"task_id": "Mbpp/165", "solution": "```python\nALPHABET_MAP = {\n    'a': 1, 'b': 2, 'c': 3, 'd': 4, 'e': 5, 'f': 6, 'g': 7, 'h': 8, 'i': 9,\n    'j': 10, 'k': 11, 'l': 12, 'm': 13, 'n': 14, 'o': 15, 'p': 16, 'q': 17,\n    'r': 18, 's': 19, 't': 20, 'u': 21, 'v': 22, 'w': 23, 'x': 24, 'y': 25, 'z': 26\n}\n\ndef count_char_position(text: str) -> int:\n    \"\"\"Counts characters matching their 1-indexed alphabetical position in a string.\n    Non-alphabetic characters are ignored, and comparison is case-insensitive.\n    \"\"\"\n    count = 0\n    lower_text = text.lower()\n    for i, char in enumerate(lower_text, 1):\n        if char in ALPHABET_MAP and ALPHABET_MAP[char] == i:\n            count += 1\n    return count\n```"}
{"task_id": "Mbpp/165", "solution": "```python\ndef count_char_position(text: str) -> int:\n    \"\"\"\n    Counts characters where their 1-based string position matches their 1-based alphabetical position (case-insensitive).\n    Non-alphabetic characters are ignored.\n    \"\"\"\n    count = 0\n    for i, char in enumerate(text):\n        string_position = i + 1\n\n        char_lower = char.lower()\n        alphabet_position = 0\n        if 'a' <= char_lower <= 'z':\n            alphabet_position = ord(char_lower) - ord('a') + 1\n\n        if alphabet_position > 0 and string_position == alphabet_position:\n            count += 1\n    return count\n```"}
{"task_id": "Mbpp/166", "solution": "```python\ndef find_even_pair(numbers: list[int]) -> int:\n    \"\"\"\n    Counts unique pairs of integers in a list whose bitwise XOR sum is an even number.\n    This occurs when both numbers are even or both numbers are odd.\n    \"\"\"\n    num_even = 0\n    num_odd = 0\n\n    for num in numbers:\n        if num % 2 == 0:\n            num_even += 1\n        else:\n            num_odd += 1\n\n    # Number of pairs of even numbers (n C 2)\n    even_even_pairs = (num_even * (num_even - 1)) // 2\n\n    # Number of pairs of odd numbers (n C 2)\n    odd_odd_pairs = (num_odd * (num_odd - 1)) // 2\n\n    return even_even_pairs + odd_odd_pairs\n```"}
{"task_id": "Mbpp/166", "solution": "```python\ndef find_even_pair(numbers: list[int]) -> int:\n    \"\"\"\n    Counts pairs of integers in a list whose bitwise XOR operation results in an even number.\n    This occurs when both integers in a pair have the same parity.\n    \"\"\"\n    even_count = 0\n    odd_count = 0\n\n    for num in numbers:\n        if num % 2 == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n\n    # Calculate combinations of even-even pairs and odd-odd pairs\n    even_even_pairs = even_count * (even_count - 1) // 2\n    odd_odd_pairs = odd_count * (odd_count - 1) // 2\n\n    return even_even_pairs + odd_odd_pairs\n```"}
{"task_id": "Mbpp/167", "solution": "```python\ndef next_power_of_2(n: int) -> int:\n    \"\"\"Calculates the smallest power of 2 greater than or equal to n.\n    Handles n=0 and positive integers, returning 1 for n=0.\n    \"\"\"\n    if n == 0:\n        return 1\n\n    # If n is already a power of 2, return n.\n    if (n & (n - 1)) == 0:\n        return n\n\n    # Find the next power of 2 using bit shifting.\n    p = 1\n    while p < n:\n        p <<= 1\n    return p\n```"}
