{"task_id": "Mbpp/780", "solution": "import itertools\n\ndef find_combinations(tuple_list: list[tuple[int, int]]) -> list[tuple[int, int]]:\n    \"\"\"Calculates element-wise sums for all unique pairs of tuples in the input list.\n    It returns a list of the resulting sum tuples.\"\"\"\n    if not isinstance(tuple_list, list):\n        raise ValueError(\"Input must be a list.\")\n\n    result = []\n    for t1, t2 in itertools.combinations(tuple_list, 2):\n        if not (isinstance(t1, tuple) and len(t1) == 2 and\n                isinstance(t2, tuple) and len(t2) == 2):\n            raise ValueError(\"All elements in the list must be 2-element tuples.\")\n        if not (isinstance(t1[0], int) and isinstance(t1[1], int) and\n                isinstance(t2[0], int) and isinstance(t2[1], int)):\n            raise ValueError(\"All tuple elements must be integers.\")\n\n        sum_tuple = (t1[0] + t2[0], t1[1] + t2[1])\n        result.append(sum_tuple)\n    return result"}
{"task_id": "Mbpp/780", "solution": "```python\nfrom itertools import combinations\n\ndef find_combinations(tuple_list: list[tuple]) -> list[tuple]:\n    \"\"\"\n    Calculates the element-wise sum of every unique pair of distinct tuples from the input list.\n\n    Args:\n        tuple_list: A list of tuples, where each tuple contains numeric elements.\n\n    Returns:\n        A list of tuples, where each tuple is the sum of two distinct tuples\n        from the input list.\n\n    Raises:\n        ValueError: If two tuples selected for summation have different lengths.\n    \"\"\"\n    if len(tuple_list) < 2:\n        return []\n\n    result_sums = []\n    for t1, t2 in combinations(tuple_list, 2):\n        if len(t1) != len(t2):\n            raise ValueError(f\"Tuples {t1} and {t2} have different lengths and cannot be summed element-wise.\")\n        \n        sum_tuple = tuple(x + y for x, y in zip(t1, t2))\n        result_sums.append(sum_tuple)\n    \n    return result_sums\n```\n"}
{"task_id": "Mbpp/781", "solution": "```python\nimport math\n\ndef count_divisors(n: int) -> bool:\n    \"\"\"\n    Checks whether the count of divisors for a given positive integer is even.\n\n    Args:\n        n: The positive integer to check.\n\n    Returns:\n        True if the count of divisors is even, False otherwise.\n\n    Raises:\n        ValueError: If n is not a positive integer.\n    \"\"\"\n    if n <= 0:\n        raise ValueError(\"Input must be a positive integer.\")\n\n    count = 0\n    # Iterate from 1 up to the square root of n to find divisors efficiently.\n    sqrt_n = int(math.sqrt(n))\n\n    for i in range(1, sqrt_n + 1):\n        if n % i == 0:\n            # If i*i == n, then i is a perfect square root, and we count it once.\n            if i * i == n:\n                count += 1\n            # Otherwise, i and n/i are two distinct divisors.\n            else:\n                count += 2\n    \n    # Return True if the total count of divisors is even, False otherwise.\n    return count % 2 == 0\n```"}
{"task_id": "Mbpp/781", "solution": "```python\nimport math\n\ndef count_divisors(n: int) -> bool:\n    \"\"\"\n    Checks whether the count of divisors for a given positive integer is even.\n\n    Args:\n        n: A positive integer.\n\n    Returns:\n        True if the count of divisors is even, False otherwise.\n\n    Raises:\n        ValueError: If n is not a positive integer.\n    \"\"\"\n    if not isinstance(n, int) or n <= 0:\n        raise ValueError(\"Input must be a positive integer.\")\n\n    divisor_count = 0\n    # Iterate from 1 up to the square root of n.\n    # Divisors come in pairs (i, n/i).\n    # If i*i == n, then i is a single divisor (perfect square case).\n    for i in range(1, int(math.sqrt(n)) + 1):\n        if n % i == 0:\n            if i * i == n:\n                divisor_count += 1\n            else:\n                divisor_count += 2\n    \n    return divisor_count % 2 == 0\n```"}
{"task_id": "Mbpp/782", "solution": "```python\nfrom typing import List\n\ndef odd_length_sum(arr: List[int]) -> int:\n    \"\"\"\n    Calculates the sum of all odd-length subarrays within a given array.\n    This optimized solution determines each element's contribution to the total sum.\n    \"\"\"\n    total_sum = 0\n    n = len(arr)\n\n    for i in range(n):\n        # Calculate the number of odd-length subarrays that include arr[i].\n        # There are (i + 1) choices for the left endpoint and (n - i) for the right.\n        occurrences = ((i + 1) * (n - i) + 1) // 2\n        total_sum += arr[i] * occurrences\n\n    return total_sum\n```"}
