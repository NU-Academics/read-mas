{"task_id": "Mbpp/255", "solution": "from typing import Any, List, Tuple\n\ndef combinations_colors(elements: List[Any], n: int) -> List[Tuple[Any, ...]]:\n    \"\"\"Generates all combinations with repetition from elements for a specified length n.\n    Each combination is a tuple, and all are collected into a list.\"\"\"\n\n    result: List[Tuple[Any, ...]] = []\n    current_combination: List[Any] = []\n\n    def _recursive_generate(start_index: int, remaining_n: int) -> None:\n        if remaining_n == 0:\n            result.append(tuple(current_combination))\n            return\n\n        # Iterate from start_index to allow repetition and ensure combinations\n        # are generated in a non-decreasing order of indices.\n        for i in range(start_index, len(elements)):\n            current_combination.append(elements[i])\n            _recursive_generate(i, remaining_n - 1)\n            current_combination.pop() # Backtrack to explore other combinations\n\n    _recursive_generate(0, n)\n    return result"}
{"task_id": "Mbpp/255", "solution": "```python\ndef combinations_colors(elements: list, n: int) -> list[tuple]:\n    \"\"\"\n    Generates all combinations (with repetition) of elements from a list for a specified length n.\n    Returns a list of tuples, where each tuple is a combination.\n    \"\"\"\n    result = []\n\n    def _generate_recursive(current_combination: list, start_index: int) -> None:\n        \"\"\"\n        Recursive helper to build combinations with repetition.\n        Appends completed combinations to the outer 'result' list.\n        \"\"\"\n        if len(current_combination) == n:\n            result.append(tuple(current_combination))\n            return\n\n        for i in range(start_index, len(elements)):\n            current_combination.append(elements[i])\n            _generate_recursive(current_combination, i)\n            current_combination.pop()\n\n    _generate_recursive([], 0)\n    return result\n```"}
{"task_id": "Mbpp/256", "solution": "def _is_prime(num: int) -> bool:\n    \"\"\"Checks if a number is prime using trial division up to its square root.\n    Assumes input 'num' is a non-negative integer.\"\"\"\n    if num < 2:\n        return False\n    for i in range(2, int(num**0.5) + 1):\n        if num % i == 0:\n            return False\n    return True\n\ndef count_Primes_nums(n: int) -> int:\n    \"\"\"Counts the number of prime numbers strictly less than n.\n    Assumes input 'n' is a non-negative integer.\"\"\"\n    if n <= 2:\n        return 0\n\n    prime_count = 0\n    for num in range(2, n):\n        if _is_prime(num):\n            prime_count += 1\n    return prime_count"}
{"task_id": "Mbpp/256", "solution": "```python\ndef count_Primes_nums(num: int) -> int:\n    \"\"\"Counts prime numbers strictly less than a given non-negative number.\n    Uses the Sieve of Eratosthenes for efficient computation.\n    \"\"\"\n    if num <= 2:\n        return 0\n\n    is_prime = [True] * num\n    is_prime[0] = is_prime[1] = False\n\n    p = 2\n    while (p * p) < num:\n        if is_prime[p]:\n            for multiple in range(p * p, num, p):\n                is_prime[multiple] = False\n        p += 1\n\n    count = 0\n    for i in range(2, num):\n        if is_prime[i]:\n            count += 1\n    return count\n```"}
