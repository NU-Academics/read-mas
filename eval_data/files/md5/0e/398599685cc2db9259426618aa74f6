{"task_id": "Mbpp/67", "solution": "# Module-level memoization for Stirling numbers of the second kind.\n_stirling_memo = {}\n\ndef _stirling_second_kind(n: int, k: int) -> int:\n    \"\"\"\n    Calculates the Stirling number of the second kind S(n, k) using memoization.\n    This function finds ways to partition a set of n objects into k non-empty subsets.\n    \"\"\"\n    if (n, k) in _stirling_memo:\n        return _stirling_memo[(n, k)]\n\n    if k < 0 or k > n:\n        return 0\n    if k == 0:\n        return 1 if n == 0 else 0\n    if k == n:\n        return 1\n    if k == 1:\n        return 1\n\n    result = k * _stirling_second_kind(n - 1, k) + _stirling_second_kind(n - 1, k - 1)\n    _stirling_memo[(n, k)] = result\n    return result\n\n# Module-level memoization for Bell numbers.\n_bell_memo = {}\n\ndef bell_number(n: int) -> int:\n    \"\"\"\n    Calculates the Bell number B_n, representing the number of partitions of a set of size n.\n    It sums Stirling numbers of the second kind S(n, k) for k from 0 to n.\n    \"\"\"\n    if n in _bell_memo:\n        return _bell_memo[n]\n\n    if n == 0:\n        return 1\n\n    total_partitions = 0\n    for k in range(n + 1):\n        total_partitions += _stirling_second_kind(n, k)\n    \n    _bell_memo[n] = total_partitions\n    return total_partitions\n"}
{"task_id": "Mbpp/67", "solution": "from typing import Dict, Tuple\n\n# Global memoization dictionaries to store computed Stirling and Bell numbers.\n# These dictionaries persist across function calls, optimizing performance.\n_stirling_memo: Dict[Tuple[int, int], int] = {}\n_bell_memo: Dict[int, int] = {}\n\ndef _stirling_second_kind(n: int, k: int) -> int:\n    \"\"\"\n    Computes the Stirling number of the second kind S(n, k) using memoization.\n    This helper function follows the standard recurrence relation and base cases.\n    \"\"\"\n    if (n, k) in _stirling_memo:\n        return _stirling_memo[(n, k)]\n\n    if k < 0 or k > n:\n        return 0\n    if k == 0:\n        # S(0, 0) = 1, S(n, 0) = 0 for n > 0\n        return 1 if n == 0 else 0\n    if k == n:\n        # S(n, n) = 1\n        return 1\n    \n    # Special cases for optimization\n    if k == 1:\n        # S(n, 1) = 1\n        return 1\n    if k == n - 1:\n        # S(n, n-1) = nC2 = n * (n - 1) // 2\n        return n * (n - 1) // 2\n\n    # Recurrence relation: S(n, k) = k * S(n-1, k) + S(n-1, k-1)\n    result = k * _stirling_second_kind(n - 1, k) + _stirling_second_kind(n - 1, k - 1)\n    _stirling_memo[(n, k)] = result\n    return result\n\ndef bell_number(n: int) -> int:\n    \"\"\"\n    Calculates the nth Bell number, representing the number of partitions of a set of n elements.\n    It uses Stirling numbers of the second kind and memoization for efficiency.\n    \n    Args:\n        n (int): The non-negative integer for which to calculate the Bell number.\n\n    Returns:\n        int: The nth Bell number.\n\n    Raises:\n        TypeError: If 'n' is not an integer.\n        ValueError: If 'n' is negative.\n    \"\"\"\n    # Input Validation as per design document\n    if not isinstance(n, int):\n        raise TypeError(\"Input 'n' must be an integer.\")\n    if n < 0:\n        raise ValueError(\"Input 'n' must be a non-negative integer.\")\n\n    # Check memoization for Bell numbers\n    if n in _bell_memo:\n        return _bell_memo[n]\n\n    # Base case for B(0) = 1 as per design document\n    if n == 0:\n        _bell_memo[0] = 1\n        return 1\n\n    bell_n = 0\n    # Bell numbers B_n are defined as the sum of Stirling numbers of the second kind:\n    # B_n = sum(S(n, k) for k=0 to n)\n    for k in range(n + 1):\n        bell_n += _stirling_second_kind(n, k)\n\n    # Store the computed Bell number in memoization for future use\n    _bell_memo[n] = bell_n\n    return bell_n"}
{"task_id": "Mbpp/68", "solution": "```python\ndef is_Monotonic(array: list[int | float]) -> bool:\n    \"\"\"Checks if an array is monotonic (non-decreasing or non-increasing).\"\"\"\n    if len(array) <= 1:\n        return True\n\n    is_non_decreasing = True\n    is_non_increasing = True\n\n    for i in range(len(array) - 1):\n        if array[i] > array[i+1]:\n            is_non_decreasing = False\n        if array[i] < array[i+1]:\n            is_non_increasing = False\n        \n        # Optimization: if both are false, it's not monotonic\n        if not is_non_decreasing and not is_non_increasing:\n            return False\n\n    return is_non_decreasing or is_non_increasing\n```"}
{"task_id": "Mbpp/68", "solution": "```python\ndef is_Monotonic(arr):\n    \"\"\"\n    Checks if the given array is monotonic (either increasing or decreasing).\n    Empty or single-element arrays are considered monotonic.\n    \"\"\"\n    if len(arr) <= 1:\n        return True\n\n    is_increasing = True\n    is_decreasing = True\n\n    for i in range(len(arr) - 1):\n        if arr[i] > arr[i+1]:\n            is_increasing = False\n        if arr[i] < arr[i+1]:\n            is_decreasing = False\n        \n        # Optimization: If it's neither increasing nor decreasing, we can stop early.\n        if not is_increasing and not is_decreasing:\n            return False\n\n    return is_increasing or is_decreasing\n```"}
{"task_id": "Mbpp/69", "solution": "```python\ndef is_sublist(main_list, sub_list):\n    \"\"\"\n    Checks if a sublist is present as a contiguous sequence in a main list.\n    An empty sublist is always considered present.\n    \"\"\"\n    n = len(main_list)\n    m = len(sub_list)\n\n    if m == 0:\n        return True\n\n    if n < m:\n        return False\n\n    for i in range(n - m + 1):\n        if main_list[i : i + m] == sub_list:\n            return True\n\n    return False\n```"}
{"task_id": "Mbpp/70", "solution": "```python\ndef get_equal(tuple_list: list[tuple]) -> bool:\n    \"\"\"\n    Checks if all tuples in the given list have the same length.\n\n    Raises TypeError if tuple_list is not a list or if any element within\n    tuple_list is not a tuple.\n\n    Returns True if the list is empty or all tuples have equal length;\n    False otherwise.\n    \"\"\"\n    if not isinstance(tuple_list, list):\n        raise TypeError(\"Input must be a list.\")\n\n    if not tuple_list:\n        return True\n\n    # Validate the first element and get its length\n    if not isinstance(tuple_list[0], tuple):\n        raise TypeError(f\"Element at index 0 is not a tuple: {type(tuple_list[0])}\")\n    \n    first_tuple_length = len(tuple_list[0])\n\n    # Iterate from the second element (index 1) to compare lengths\n    for i, item in enumerate(tuple_list):\n        if not isinstance(item, tuple):\n            raise TypeError(f\"Element at index {i} is not a tuple: {type(item)}\")\n        \n        if len(item) != first_tuple_length:\n            return False\n            \n    return True\n```"}
{"task_id": "Mbpp/69", "solution": "```python\ndef is_sublist(main_list: list, sub_list: list) -> bool:\n    \"\"\"\n    Checks if a given sublist exists as a contiguous sequence within a main list.\n    Returns True if the sublist is found, False otherwise.\n    \"\"\"\n    n = len(main_list)\n    m = len(sub_list)\n\n    if m == 0:\n        return True\n\n    if m > n:\n        return False\n\n    for i in range(n - m + 1):\n        if main_list[i:i + m] == sub_list:\n            return True\n    return False\n```"}
