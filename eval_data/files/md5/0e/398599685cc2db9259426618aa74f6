{"task_id": "Mbpp/286", "solution": "```python\nimport math\n\n\ndef max_sub_array_sum_repeated(arr, k, _): # The third parameter '_' is present as per the original problem statement example.\n    \"\"\"\n    Calculates the largest sum of a contiguous subarray within an array repeated k times.\n    This function uses an optimized approach suitable for large k values.\n    \"\"\"\n\n    def kadane(current_arr: list[int]) -> int:\n        \"\"\"\n        Implements Kadane's algorithm to find the maximum contiguous subarray sum.\n        It returns 0 if all numbers are negative (representing an empty subarray sum).\n        \"\"\"\n        max_so_far = float('-inf')\n        current_max = 0\n        for x in current_arr:\n            current_max += x\n            max_so_far = max(max_so_far, current_max)\n            if current_max < 0:\n                current_max = 0\n        return max(0, max_so_far)\n\n    # If k is 1, simply apply Kadane's algorithm to the original array.\n    if k == 1:\n        return kadane(arr)\n\n    # Calculate Kadane's sum for the original array.\n    single_kadane_sum = kadane(arr)\n\n    # Calculate the total sum of all elements in the original array.\n    total_sum = sum(arr)\n\n    # Create an array by repeating the original array twice.\n    # This helps find maximum subarrays that span across the boundary of two repetitions.\n    doubled_arr = arr + arr\n    doubled_kadane_sum = kadane(doubled_arr)\n\n    # If the total sum of the array is positive, repeating it more times can increase the maximum sum.\n    # The maximum sum could be from two repetitions plus (k-2) times the total sum of the array.\n    if total_sum > 0:\n        return max(single_kadane_sum, doubled_kadane_sum + (k - 2) * total_sum)\n    else:\n        # If the total sum is non-positive, additional repetitions will not increase the maximum sum\n        # beyond what can be found in at most two repetitions.\n        return max(single_kadane_sum, doubled_kadane_sum)\n\n```"}
{"task_id": "Mbpp/286", "solution": "```python\nimport math\n\ndef kadanes_algorithm(sub_arr: list[int]) -> int:\n    \"\"\"\n    Finds the maximum subarray sum for a given array.\n    It handles cases where all numbers are negative by returning the largest single element.\n    \"\"\"\n    # Initialize max_so_far and current_max with the first element,\n    # to correctly handle arrays with all negative numbers.\n    max_so_far = sub_arr[0]\n    current_max = sub_arr[0]\n\n    for i in range(1, len(sub_arr)):\n        # For each element, decide to either start a new subarray or extend the current one.\n        current_max = max(sub_arr[i], current_max + sub_arr[i])\n        # Update the overall maximum sum found so far.\n        max_so_far = max(max_so_far, current_max)\n    return max_so_far\n\n\ndef max_sub_array_sum_repeated(arr: list[int], n: int, k: int) -> int:\n    \"\"\"\n    Calculates the maximum subarray sum in an array repeated k times.\n    It extends Kadane's algorithm to cover scenarios across multiple repetitions.\n    \"\"\"\n    # a. Calculate total_sum of the original array.\n    total_sum = sum(arr)\n\n    # b. Calculate max_kadane_sum for a single instance of arr.\n    max_kadane_sum = kadanes_algorithm(arr)\n\n    # c. Handle k = 1 as a base case.\n    if k == 1:\n        return max_kadane_sum\n\n    # d. Calculate max_prefix_sum of the original array.\n    max_prefix_sum = -math.inf\n    current_prefix_sum = 0\n    for x in arr:\n        current_prefix_sum += x\n        max_prefix_sum = max(max_prefix_sum, current_prefix_sum)\n\n    # e. Calculate max_suffix_sum of the original array.\n    max_suffix_sum = -math.inf\n    current_suffix_sum = 0\n    for x in reversed(arr):\n        current_suffix_sum += x\n        max_suffix_sum = max(max_suffix_sum, current_suffix_sum)\n\n    # f. Conditional Logic based on total_sum.\n    if total_sum > 0:\n        # If total_sum is positive, repeating the array further can increase the sum.\n        # The max sum can be within one arr, or span with (k-2) full positive total_sum arrays.\n        return max(max_kadane_sum, max_prefix_sum + max_suffix_sum + (k - 2) * total_sum)\n    else:  # total_sum <= 0\n        # If total_sum is non-positive, including more than two full arrays won't improve the sum.\n        # The max sum is either within one arr or spans at most two concatenated arrays.\n        return max(max_kadane_sum, kadanes_algorithm(arr + arr))\n\n```"}
{"task_id": "Mbpp/287", "solution": "def square_Sum(n: int) -> int:\n    \"\"\"\n    Calculates the sum of squares of the first n even natural numbers.\n    Assumes n is a non-negative integer.\n    \"\"\"\n    # Sum of squares = 4 * (1^2 + 2^2 + ... + n^2)\n    # Using the formula for sum of first n squares: n*(n+1)*(2n+1)/6\n    # So, sum_of_squares = 4 * n * (n + 1) * (2 * n + 1) // 6\n    return 2 * n * (n + 1) * (2 * n + 1) // 3"}
{"task_id": "Mbpp/287", "solution": "```python\ndef square_Sum(n: int) -> int:\n    \"\"\"Calculates the sum of squares of the first n even natural numbers.\n    Assumes n is a non-negative integer.\n    \"\"\"\n    total_sum = 0\n    for i in range(1, n + 1):\n        even_num = 2 * i\n        total_sum += even_num * even_num\n    return total_sum\n```"}
