{"task_id": "Mbpp/296", "solution": "```python\ndef _merge_and_count(arr: list[int], temp_arr: list[int], left: int, mid: int, right: int) -> int:\n    \"\"\"\n    Merges two sorted sub-arrays and counts inversions formed between them.\n    It updates the original array `arr` with the sorted elements from `temp_arr`.\n    \"\"\"\n    i = left\n    j = mid + 1\n    k = left\n    inv_count = 0\n\n    while i <= mid and j <= right:\n        if arr[i] <= arr[j]:\n            temp_arr[k] = arr[i]\n            i += 1\n        else:\n            temp_arr[k] = arr[j]\n            inv_count += (mid - i + 1)\n            j += 1\n        k += 1\n\n    while i <= mid:\n        temp_arr[k] = arr[i]\n        i += 1\n        k += 1\n\n    while j <= right:\n        temp_arr[k] = arr[j]\n        j += 1\n        k += 1\n\n    for l in range(left, right + 1):\n        arr[l] = temp_arr[l]\n\n    return inv_count\n\ndef _merge_sort_and_count(arr: list[int], temp_arr: list[int], left: int, right: int) -> int:\n    \"\"\"\n    Recursively divides the array, sorts sub-arrays, and counts inversions.\n    It orchestrates the merge sort process to accumulate the total inversions.\n    \"\"\"\n    inv_count = 0\n    if left < right:\n        mid = (left + right) // 2\n        inv_count += _merge_sort_and_count(arr, temp_arr, left, mid)\n        inv_count += _merge_sort_and_count(arr, temp_arr, mid + 1, right)\n        inv_count += _merge_and_count(arr, temp_arr, left, mid, right)\n    return inv_count\n\ndef get_Inv_Count(arr: list[int]) -> int:\n    \"\"\"\n    Counts the total inversions in the given array using a merge sort approach.\n    An inversion is a pair (arr[i], arr[j]) where i < j and arr[i] > arr[j].\n    \"\"\"\n    n = len(arr)\n    temp_arr = [0] * n\n    return _merge_sort_and_count(arr, temp_arr, 0, n - 1)\n```"}
{"task_id": "Mbpp/296", "solution": "```python\nimport copy\n\ndef _merge_and_count_split_inversions(arr: list[int], left: int, mid: int, right: int) -> tuple[list[int], int]:\n    \"\"\"\n    Merges two sorted sub-arrays into one and counts inversions between them.\n    This helper identifies pairs (arr[i], arr[j]) where i < j and arr[i] > arr[j] across the merge point.\n    \"\"\"\n    left_half = arr[left : mid + 1]\n    right_half = arr[mid + 1 : right + 1]\n\n    i, j, k = 0, 0, 0\n    split_inv_count = 0\n    merged_result = [0] * (right - left + 1)\n\n    while i < len(left_half) and j < len(right_half):\n        if left_half[i] <= right_half[j]:\n            merged_result[k] = left_half[i]\n            i += 1\n        else:\n            merged_result[k] = right_half[j]\n            split_inv_count += (len(left_half) - i)\n            j += 1\n        k += 1\n\n    while i < len(left_half):\n        merged_result[k] = left_half[i]\n        i += 1\n        k += 1\n\n    while j < len(right_half):\\\n        merged_result[k] = right_half[j]\n        j += 1\n        k += 1\n    \n    return merged_result, split_inv_count\n\ndef _merge_sort_and_count(arr: list[int], left: int, right: int) -> tuple[list[int], int]:\n    \"\"\"\n    Recursively sorts a sub-array in place and counts inversions within it.\n    It sums inversions from the left and right halves, plus split inversions during merge.\n    \"\"\"\n    inv_count = 0\n    if left < right:\n        mid = (left + right) // 2\n        _, inv_count_left = _merge_sort_and_count(arr, left, mid)\n        _, inv_count_right = _merge_sort_and_count(arr, mid + 1, right)\n        merged_arr, inv_count_split = _merge_and_count_split_inversions(arr, left, mid, right)\n        \n        for i in range(left, right + 1):\n            arr[i] = merged_arr[i - left]\n\n        inv_count = inv_count_left + inv_count_right + inv_count_split\n    return arr, inv_count\n\ndef get_Inv_Count(arr: list[int]) -> int:\n    \"\"\"\n    Calculates the total number of inversions in an array using a modified merge sort.\n    An inversion is a pair (i, j) such that i < j and arr[i] > arr[j].\n    \"\"\"\n    temp_arr = copy.deepcopy(arr)\n    _, inv_count = _merge_sort_and_count(temp_arr, 0, len(temp_arr) - 1)\n    return inv_count\n```"}
