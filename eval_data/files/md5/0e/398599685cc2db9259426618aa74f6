{"task_id": "Mbpp/721", "solution": "```python\nfrom typing import List\n\ndef maxAverageOfPath(grid: List[List[int]]) -> float:\n    \"\"\"\n    Calculates the maximum average cost of a path from the top-left to the bottom-right cell.\n    Movement is restricted to only right or down.\n    \"\"\"\n    n = len(grid)\n\n    # For an N*N matrix, any valid path from (0,0) to (N-1,N-1) always has 2*N - 1 cells.\n    path_length = 2 * n - 1\n\n    # dp[i][j] will store the maximum sum to reach cell (i, j) from (0,0).\n    dp = [[0] * n for _ in range(n)]\n\n    # Initialize the top-left cell.\n    dp[0][0] = grid[0][0]\n\n    # Initialize the first row (only movement from left is possible).\n    for j in range(1, n):\n        dp[0][j] = dp[0][j-1] + grid[0][j]\n\n    # Initialize the first column (only movement from above is possible).\n    for i in range(1, n):\n        dp[i][0] = dp[i-1][0] + grid[i][0]\n\n    # Fill the rest of the DP table using the max of paths from above or left.\n    for i in range(1, n):\n        for j in range(1, n):\n            dp[i][j] = grid[i][j] + max(dp[i-1][j], dp[i][j-1])\n\n    max_sum = dp[n-1][n-1]\n    \n    return float(max_sum) / path_length\n```"}
{"task_id": "Mbpp/721", "solution": "```python\nfrom typing import List\n\nclass InvalidMatrixError(ValueError):\n    \"\"\"Custom exception for invalid matrix inputs.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n\nclass MatrixValidator:\n    \"\"\"Provides utility methods for validating the input matrix.\"\"\"\n\n    @staticmethod\n    def is_square_matrix(matrix: List[List[int]]) -> bool:\n        \"\"\"Checks if the input is a square matrix.\"\"\"\n        if not matrix:\n            return False\n        n = len(matrix)\n        for row in matrix:\n            if not isinstance(row, list) or len(row) != n:\n                return False\n        return True\n\n    @staticmethod\n    def contains_only_integers(matrix: List[List[int]]) -> bool:\n        \"\"\"Checks if all elements in the matrix are integers.\"\"\"\n        if not matrix:\n            return True\n        for row in matrix:\n            for item in row:\n                if not isinstance(item, int):\n                    return False\n        return True\n\nclass Cell:\n    \"\"\"Represents a single cell in the matrix with its coordinates and cost.\"\"\"\n    def __init__(self, row: int, col: int, cost: int):\n        self.row = row\n        self.col = col\n        self.cost = cost\n\n    def __repr__(self):\n        return f\"Cell({self.row},{self.col},{self.cost})\"\n\nclass Path:\n    \"\"\"Represents a complete path from start to end with its properties.\"\"\"\n    def __init__(self, cells: List[Cell]):\n        self.cells = cells\n        self.total_cost = sum(cell.cost for cell in cells)\n        self.num_cells = len(cells)\n        self.average_cost = self.calculate_average()\n\n    def calculate_average(self) -> float:\n        \"\"\"Calculates and returns the average cost of the path.\"\"\"\n        if self.num_cells == 0:\n            return 0.0\n        return self.total_cost / self.num_cells\n\n    def __repr__(self):\n        return f\"Path(avg={self.average_cost:.2f}, cells={self.cells})\"\n\nclass PathFinderService:\n    \"\"\"Contains the core logic for finding all valid paths and determining the maximum average cost.\"\"\"\n    def __init__(self):\n        self._matrix: List[List[int]] = []\n        self._N: int = 0\n\n    def find_max_average_path(self, matrix: List[List[int]]) -> float:\n        \"\"\"Public interface to initiate the pathfinding process.\"\"\"\n        self._matrix = matrix\n        self._N = len(matrix)\n        if self._N == 0:\n            return 0.0\n\n        max_avg_ref = [0.0] # Use a list to pass float by reference for updating max_average.\n\n        # Start recursion from (0,0) with initial state.\n        self._find_all_paths_recursive(0, 0, [], 0, 0, max_avg_ref)\n        return max_avg_ref[0]\n\n    def _find_all_paths_recursive(self, r: int, c: int,\n                                  current_path_cells: List[Cell],\n                                  current_path_cost: int,\n                                  current_path_length: int,\n                                  max_avg_ref: List[float]) -> None:\n        \"\"\"Recursive helper method to explore paths.\"\"\"\n        current_cell = Cell(r, c, self._matrix[r][c])\n        current_path_cells.append(current_cell)\n        current_path_cost += current_cell.cost\n        current_path_length += 1\n\n        # Base case: Reached the bottom-right cell.\n        if r == self._N - 1 and c == self._N - 1:\n            if current_path_length > 0:\n                current_average = current_path_cost / current_path_length\n                if current_average > max_avg_ref[0]:\n                    max_avg_ref[0] = current_average\n        else:\n            # Move right.\n            if c + 1 < self._N:\n                self._find_all_paths_recursive(r, c + 1, current_path_cells,\n                                               current_path_cost, current_path_length, max_avg_ref)\n            # Move down.\n            if r + 1 < self._N:\n                self._find_all_paths_recursive(r + 1, c, current_path_cells,\n                                               current_path_cost, current_path_length, max_avg_ref)\n\n        # Backtrack: Remove current cell for other paths.\n        current_path_cells.pop()\n\ndef find_max_average_path_controller(matrix_data: List[List[int]]) -> float:\n    \"\"\"\n    Controller function to find the path with the maximum average cost.\n    It validates input and delegates to the PathFinderService.\n    \"\"\"\n    if not MatrixValidator.is_square_matrix(matrix_data):\n        raise InvalidMatrixError(\"Input matrix must be square.\")\n    if not MatrixValidator.contains_only_integers(matrix_data):\n        raise InvalidMatrixError(\"Input matrix must contain only integer values.\")\n\n    service = PathFinderService()\n    max_average = service.find_max_average_path(matrix_data)\n    return max_average\n\ndef maxAverageOfPath(matrix: List[List[int]]) -> float:\n    \"\"\"\n    Calculates the path with the maximum average cost from top-left to bottom-right.\n    Movement is restricted to only \\\"right\\\" or \\\"down\\\".\n    \"\"\"\n    return find_max_average_path_controller(matrix)\n```"}
