{"task_id": "Mbpp/409", "solution": "def min_product_tuple(list_of_tuples):\n    \"\"\"\n    Calculates the minimum product from a list of 2-element integer tuples.\n\n    Args:\n        list_of_tuples: A list where each element is a tuple containing two integers.\n\n    Returns:\n        The minimum product found.\n\n    Raises:\n        ValueError: If the input is not a list, is empty, contains non-tuple elements,\n                    tuples with incorrect number of elements, or non-integer elements.\n    \"\"\"\n    if not isinstance(list_of_tuples, list):\n        raise ValueError(\"Input must be a list.\")\n    if not list_of_tuples:\n        raise ValueError(\"Input list cannot be empty.\")\n\n    products = []\n    for item in list_of_tuples:\n        if not isinstance(item, tuple):\n            raise ValueError(f\"All elements in the list must be tuples, found: {type(item)}\")\n        if len(item) != 2:\n            raise ValueError(f\"Each tuple must contain exactly two elements, found {len(item)} in {item}\")\n        if not all(isinstance(x, int) for x in item):\n            raise ValueError(f\"All elements within tuples must be integers, found non-integer in {item}\")\n\n        products.append(item[0] * item[1])\n\n    return min(products)"}
{"task_id": "Mbpp/410", "solution": "```python\nfrom typing import List, Union\n\nclass NoNumericValueError(ValueError):\n    \"\"\"\n    Custom exception raised when no numeric values are found in a list.\n    It inherits from ValueError and provides a default message.\n    \"\"\"\n    def __init__(self, message: str = \"No numeric values found in the list.\"):\n        super().__init__(message)\n\ndef min_val(data_list: List[any]) -> Union[int, float]:\n    \"\"\"\n    Finds the minimum numeric value in a given list, ignoring non-numeric elements.\n    Raises TypeError if input is not a list, or NoNumericValueError if no numeric values are found.\n    \"\"\"\n    if not isinstance(data_list, list):\n        raise TypeError(\"Input must be a list.\")\n\n    numeric_values = [item for item in data_list if isinstance(item, (int, float))]\n\n    if not numeric_values:\n        raise NoNumericValueError(\"The list contains no numeric values to compare.\")\n\n    return min(numeric_values)\n```"}
{"task_id": "Mbpp/410", "solution": "```python\nclass NoNumericalValueError(Exception):\n    \"\"\"\n    Custom exception raised when no numerical values (int or float) are found in a list.\n    \"\"\"\n    def __init__(self, message: str = \"No numerical values found in the list.\"):\n        super().__init__(message)\n\nfrom typing import Union\n\ndef min_val(data_list: list) -> Union[int, float]:\n    \"\"\"\n    Finds the minimum numerical value (int or float) in a heterogeneous list.\n    Raises TypeError if input is not a list, or NoNumericalValueError if no numbers are found.\n    \"\"\"\n    if not isinstance(data_list, list):\n        raise TypeError(\"Input must be a list.\")\n\n    min_value: Union[int, float, None] = None\n\n    for item in data_list:\n        if isinstance(item, (int, float)):\n            if min_value is None or item < min_value:\n                min_value = item\n\n    if min_value is None:\n        raise NoNumericalValueError()\n\n    return min_value\n```"}
