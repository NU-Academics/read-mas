{"task_id": "Mbpp/165", "solution": "def count_char_position(input_string: str) -> int:\n    \"\"\"\n    Counts characters in a string that match their English alphabet position (case-insensitive).\n    \"\"\"\n    count = 0\n    for i, char in enumerate(input_string):\n        char_lower = char.lower()\n        if 'a' <= char_lower <= 'z':\n            # Calculate 1-based alphabet position (a=1, b=2, ...)\n            alpha_pos = ord(char_lower) - ord('a') + 1\n            # Compare with 1-based string position\n            if alpha_pos == i + 1:\n                count += 1\n    return count"}
{"task_id": "Mbpp/166", "solution": "from typing import List\n\ndef find_even_pair(numbers: List[int]) -> int:\n    \"\"\"\n    Counts the number of pairs of integers in a list that XOR to an even number.\n    \"\"\"\n    count = 0\n    n = len(numbers)\n\n    if n < 2:\n        return 0\n\n    # Iterate over all unordered index pairs (i, j) with i < j.\n    for i in range(n):\n        for j in range(i + 1, n):\n            # Compute the bitwise XOR of the pair and check if it's even.\n            if (numbers[i] ^ numbers[j]) % 2 == 0:\n                count += 1\n    return count"}
