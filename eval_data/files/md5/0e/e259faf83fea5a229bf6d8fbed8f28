{"task_id": "Mbpp/130", "solution": "from typing import List, Optional, Dict\n\ndef max_occurrences(items: List[int]) -> Optional[int]:\n    \"\"\"\n    Return the integer that appears most frequently in `items`.\n    For an empty list, None is returned.\n    \"\"\"\n    if not items:\n        return None\n\n    frequency: Dict[int, int] = {}\n    max_freq = 0\n    max_item: Optional[int] = None\n\n    for item in items:\n        frequency[item] = frequency.get(item, 0) + 1\n        if frequency[item] > max_freq:\n            max_freq = frequency[item]\n            max_item = item\n\n    return max_item"}
{"task_id": "Mbpp/131", "solution": "VOWELS = \"aeiouAEIOU\"\n\ndef _is_vowel(char: str) -> bool:\n    \"\"\"Helper function to determine if a character is a vowel.\"\"\"\n    return char in VOWELS\n\ndef reverse_vowels(input_string: str) -> str:\n    \"\"\"\n    Reverse the order of vowels in the input string, leaving all\n    non\u2011vowel characters in their original positions.\n    \"\"\"\n    vowel_indices = []\n    vowel_chars = []\n\n    for idx, ch in enumerate(input_string):\n        if _is_vowel(ch):\n            vowel_indices.append(idx)\n            vowel_chars.append(ch)\n\n    vowel_chars.reverse()\n\n    result = list(input_string)\n    for idx, ch in zip(vowel_indices, vowel_chars):\n        result[idx] = ch\n\n    return \"\".join(result)"}
