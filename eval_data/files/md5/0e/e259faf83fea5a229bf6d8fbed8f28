{"task_id": "Mbpp/440", "solution": "import re\nfrom typing import Tuple, Optional\nfrom dataclasses import dataclass\n\n@dataclass\nclass Sentence:\n    text: str\n\n@dataclass\nclass Adverb:\n    text: str\n    startIndex: int\n    endIndex: int\n\ndef find_adverb_position(sentence: str) -> Optional[Tuple[int, int, str]]:\n    \"\"\"\n    Finds the first adverb and its positions in a given sentence.\n    Returns a tuple (start_index, end_index, adverb_text) or None if no adverb is found.\n    \"\"\"\n    sentence_obj = Sentence(text=sentence)\n    \n    # A simple regex to detect adverbs, typically ending in -ly.\n    # This is a simplification and may not catch all adverbs or might catch non-adverbs.\n    # The regex also accounts for trailing punctuation/spaces.\n    adverb_pattern = re.compile(r'\\b(\\w+ly)\\b(?=\\W|\\s|$)', re.IGNORECASE)\n    \n    match = adverb_pattern.search(sentence_obj.text)\n    \n    if match:\n        adverb_text = match.group(1)\n        start_index = match.start(1)\n        end_index = match.end(1)\n        return (start_index, end_index, adverb_text)\n    \n    return None"}
