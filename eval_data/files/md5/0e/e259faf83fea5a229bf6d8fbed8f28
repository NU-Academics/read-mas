{"task_id": "Mbpp/731", "solution": "import math\n\ndef lateralsurface_cone(r, h):\n    \"\"\"\n    Calculates the lateral surface area of a cone given its radius and height.\n    Uses the formula A = \u03c0 * r * sqrt(r\u00b2 + h\u00b2).\n    \"\"\"\n    slant_height = math.sqrt(r**2 + h**2)\n    area = math.pi * r * slant_height\n    return area"}
{"task_id": "Mbpp/733", "solution": "def find_first_occurrence(array, target):\n    \"\"\"\n    Returns the index of the first occurrence of target in a sorted array.\n    If target is not present, returns -1.\n    \"\"\"\n    if not array:\n        return -1\n\n    low, high = 0, len(array) - 1\n    result = -1\n\n    while low <= high:\n        mid = (low + high) // 2\n        if array[mid] == target:\n            result = mid\n            high = mid - 1  # continue searching left half\n        elif array[mid] < target:\n            low = mid + 1\n        else:\n            high = mid - 1\n\n    return result"}
{"task_id": "Mbpp/734", "solution": "from typing import List\n\ndef sum_Of_Subarray_Prod(elements: List[int]) -> int:\n    \"\"\"\n    Compute the sum of the products of all contiguous sublists of the input list.\n    Returns 0 for an empty list.\n    \"\"\"\n    if not elements:\n        return 0\n\n    total = 0\n    n = len(elements)\n\n    for start in range(n):\n        prod = 1\n        for end in range(start, n):\n            prod *= elements[end]\n            total += prod\n\n    return total"}
{"task_id": "Mbpp/735", "solution": "def toggle_middle_bits(value: int) -> int:\n    \"\"\"\n    Toggles all bits of the number except the first (most significant) and the last (least significant) bit.\n    Returns the modified integer.\n    \"\"\"\n    bit_length = value.bit_length()\n\n    if bit_length <= 2:\n        return value\n\n    # Create a mask with 1s in all middle bit positions.\n    # ((1 << (bit_length - 2)) - 1) creates a sequence of (bit_length - 2) ones.\n    # Then shift it left by 1 to align with middle bits, leaving first and last bit as 0.\n    middle_mask = ((1 << (bit_length - 2)) - 1) << 1\n\n    return value ^ middle_mask"}
{"task_id": "Mbpp/736", "solution": "from typing import List\n\ndef left_insertion(elements: List[int], value: int) -> int:\n    \"\"\"\n    Locates the left insertion point for a specified value in a sorted list.\n    Raises ValueError if the input list is not sorted.\n    \"\"\"\n    # 1. Validate sortedness of the input list.\n    for i in range(len(elements) - 1):\n        if elements[i] > elements[i + 1]:\n            raise ValueError(\"Input list must be sorted in ascending order.\")\n\n    # 2. Perform binary search to find the leftmost insertion point.\n    low, high = 0, len(elements)\n    while low < high:\n        mid = (low + high) // 2\n        if elements[mid] < value:\n            low = mid + 1\n        else:\n            high = mid\n    return low"}
