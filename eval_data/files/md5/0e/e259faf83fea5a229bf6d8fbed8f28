{"task_id": "Mbpp/414", "solution": "from typing import Iterable, Any\n\ndef overlapping(seq1: Iterable[Any], seq2: Iterable[Any]) -> bool:\n    \"\"\"\n    Return True if any element in seq1 is also present in seq2, otherwise False.\n    Uses set conversion for efficiency when elements are hashable.\n    \"\"\"\n    try:\n        set_seq1 = set(seq1)\n    except TypeError:\n        # Fallback for unhashable elements, resulting in O(N*M) worst case.\n        set_seq1 = list(seq1)\n\n    for item in seq2:\n        if item in set_seq1:\n            return True\n    return False"}
{"task_id": "Mbpp/418", "solution": "def Find_Max(input_list):\n    \"\"\"\n    Finds the element (sub-list) in a list with the maximum length.\n    Returns the first such element encountered.\n    \"\"\"\n    max_sublist = None\n    max_len = -1 \n\n    for sub in input_list:\n        current_len = len(sub)\n        if current_len > max_len:\n            max_len = current_len\n            max_sublist = sub\n            \n    return max_sublist"}
{"task_id": "Mbpp/415", "solution": "import math\nfrom typing import List, Tuple\n\ndef max_Product(arr: List[int]) -> Tuple[int, int]:\n    \"\"\"\n    Finds a pair of integers from a given array that yields the highest product.\n    Raises ValueError if the array contains fewer than two elements.\n    \"\"\"\n    if len(arr) < 2:\n        raise ValueError(\"Input array must contain at least two elements.\")\n\n    # Initialize variables to store the two largest and two smallest numbers encountered\n    max1 = -math.inf  # Largest number\n    max2 = -math.inf  # Second largest number\n    min1 = math.inf   # Smallest number\n    min2 = math.inf   # Second smallest number\n\n    for num in arr:\n        # Update largest numbers, handling duplicates correctly\n        if num >= max1:\n            max2 = max1\n            max1 = num\n        elif num > max2:\n            max2 = num\n\n        # Update smallest numbers, handling duplicates correctly\n        if num <= min1:\n            min2 = min1\n            min1 = num\n        elif num < min2:\n            min2 = num\n            \n    # Calculate products of the two largest and two smallest numbers\n    prod_max = max1 * max2\n    prod_min = min1 * min2\n\n    # Compare products and return the pair with the highest product.\n    # If products are equal, prioritize the pair that appears first lexicographically (e.g., negative pair).\n    if prod_min >= prod_max:\n        return (min1, min2)\n    else:\n        return (max2, max1)"}
{"task_id": "Mbpp/419", "solution": "def round_and_sum(numbers: list[float]) -> int:\n    \"\"\"\n    Rounds each number in a list to the nearest integer, sums them, and\n    multiplies the total sum by the length of the original list.\n    \"\"\"\n    list_length = len(numbers)\n    rounded_sum = sum(round(num) for num in numbers)\n    return rounded_sum * list_length"}
