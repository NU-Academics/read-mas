{"task_id": "Mbpp/557", "solution": "def toggle_string(input_str: str) -> str:\n    \"\"\"Toggles the case of all alphabetic characters in the input string, preserving others.\"\"\"\n    result = []\n    for ch in input_str:\n        if ch.isupper():\n            result.append(ch.lower())\n        elif ch.islower():\n            result.append(ch.upper())\n        else:\n            result.append(ch)\n    return ''.join(result)"}
{"task_id": "Mbpp/558", "solution": "def digit_distance_nums(a: int, b: int) -> int:\n    \"\"\"\n    Calculates the sum of per-digit absolute differences between two non-negative integers.\n    Digits are aligned from the least significant side, and missing digits are treated as zero.\n    \"\"\"\n    if a < 0 or b < 0:\n        raise ValueError(\"Input integers must be non-negative.\")\n\n    total_distance = 0\n    while a > 0 or b > 0:\n        digit_a = a % 10\n        digit_b = b % 10\n        total_distance += abs(digit_a - digit_b)\n        a //= 10\n        b //= 10\n    return total_distance"}
{"task_id": "Mbpp/556", "solution": "from typing import List, Optional\n\ndef find_Odd_Pair(numbers: List[int], length: Optional[int] = None) -> int:\n    \"\"\"\n    Counts the number of unordered pairs of integers in a list whose bitwise XOR is odd.\n    Pairs are considered (numbers[i], numbers[j]) where i < j.\n    \"\"\"\n    n = len(numbers) if length is None else length\n\n    if n < 2:\n        return 0\n\n    count = 0\n    for i in range(n - 1):\n        for j in range(i + 1, n):\n            # The XOR of two numbers is odd if and only if one number is even and the other is odd.\n            # This is equivalent to checking if the least significant bit of the XOR result is 1.\n            if (numbers[i] ^ numbers[j]) & 1:\n                count += 1\n    return count"}
{"task_id": "Mbpp/559", "solution": "def max_sub_array_sum(values, length):\n    \"\"\"\n    Finds the sum of the largest contiguous sublist (subarray) using Kadane's algorithm.\n    Handles empty lists and lists with all negative numbers.\n    \"\"\"\n    if length == 0:\n        return 0\n\n    max_so_far = values[0]\n    current_max = values[0]\n\n    for i in range(1, length):\n        value = values[i]\n        # Determine if the current element extends the current subarray or starts a new one\n        current_max = max(value, current_max + value)\n        # Update the overall maximum sum found\n        max_so_far = max(max_so_far, current_max)\n\n    return max_so_far"}
{"task_id": "Mbpp/562", "solution": "from typing import List\n\ndef Find_Max_Length(list_of_lists: List[List[int]]) -> int:\n    \"\"\"\n    Return the length of the longest sublist in `list_of_lists`.\n    If `list_of_lists` is empty or all sublists are empty, returns 0.\n    \"\"\"\n    max_length = 0\n    for sublist in list_of_lists:\n        sub_len = len(sublist)\n        if sub_len > max_length:\n            max_length = sub_len\n    return max_length"}
