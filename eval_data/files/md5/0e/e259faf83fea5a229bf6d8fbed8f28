{"task_id": "Mbpp/64", "solution": "from typing import List, Tuple\n\ndef subject_marks(input_list: List[Tuple[str, int]]) -> List[Tuple[str, int]]:\n    \"\"\"\n    Sorts a list of (subject, mark) tuples by the mark value in ascending order.\n    Raises ValueError if any mark is not an integer in the range 0-100.\n    \"\"\"\n    for idx, item in enumerate(input_list):\n        if not isinstance(item, tuple) or len(item) != 2:\n            raise ValueError(f\"Item at index {idx} is not a valid (subject, mark) tuple.\")\n        subject, mark = item\n        if not isinstance(subject, str):\n            raise ValueError(f\"Subject at index {idx} must be a string.\")\n        if not isinstance(mark, int) or not (0 <= mark <= 100):\n            raise ValueError(f\"Mark at index {idx} must be an integer between 0 and 100, got {mark}.\")\n\n    return sorted(input_list, key=lambda x: x[1])"}
{"task_id": "Mbpp/65", "solution": "def recursive_list_sum(nested_list: list) -> int:\n    \"\"\"Flattens a list and sums all of its integer elements recursively.\"\"\"\n    total_sum = 0\n    for element in nested_list:\n        if isinstance(element, int):\n            total_sum += element\n        elif isinstance(element, list):\n            total_sum += recursive_list_sum(element)\n    return total_sum"}
{"task_id": "Mbpp/68", "solution": "def is_Monotonic(array):\n    \"\"\"\n    Checks if a given array is monotonic (non-increasing or non-decreasing).\n    \"\"\"\n    if len(array) <= 1:\n        return True\n\n    is_increasing = True\n    is_decreasing = True\n\n    for i in range(1, len(array)):\n        if array[i] > array[i - 1]:\n            is_decreasing = False\n        elif array[i] < array[i - 1]:\n            is_increasing = False\n    \n    return is_increasing or is_decreasing"}
{"task_id": "Mbpp/67", "solution": "_bell_cache = {\n    0: 1,\n    1: 1,\n    2: 2\n}\n\n_combinations_cache = {}\n\ndef _combinations(n_val, k_val):\n    \"\"\"\n    Calculates binomial coefficient nCk with memoization.\n    \"\"\"\n    if k_val < 0 or k_val > n_val:\n        return 0\n    if k_val == 0 or k_val == n_val:\n        return 1\n    if k_val > n_val // 2:\n        k_val = n_val - k_val\n\n    if (n_val, k_val) in _combinations_cache:\n        return _combinations_cache[(n_val, k_val)]\n\n    res = 1\n    for i in range(k_val):\n        res = res * (n_val - i) // (i + 1)\n    _combinations_cache[(n_val, k_val)] = res\n    return res\n\ndef bell_number(n):\n    \"\"\"\n    Calculates the nth Bell number using the recurrence relation B_n = sum_{k=0 to n-1} (n-1 choose k) * B_k.\n    Results are cached to optimize repeated calls.\n    \"\"\"\n    if n < 0:\n        raise ValueError(\"Bell number is not defined for negative n\")\n\n    if n in _bell_cache:\n        return _bell_cache[n]\n\n    # Find the largest n for which the Bell number is already cached\n    max_cached_n = max(_bell_cache.keys())\n\n    # Compute Bell numbers iteratively from max_cached_n + 1 up to n\n    for i in range(max_cached_n + 1, n + 1):\n        current_bell_val = 0\n        # B_i = sum_{k=0 to i-1} (i-1 choose k) * B_k\n        for k in range(i):\n            current_bell_val += _combinations(i - 1, k) * _bell_cache[k]\n        _bell_cache[i] = current_bell_val\n\n    return _bell_cache[n]"}
