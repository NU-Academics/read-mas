{"task_id": "Mbpp/11", "solution": "def remove_Occ(input: str, target: str) -> str:\n    \"\"\"\n    Remove the first and last occurrence of `target` from `input`.\n\n    If the character occurs fewer than twice, all occurrences are removed.\n    \"\"\"\n    if not isinstance(target, str) or len(target) != 1:\n        raise ValueError(\"target must be a single character string\")\n\n    indices = [i for i, ch in enumerate(input) if ch == target]\n\n    if not indices:\n        return input\n\n    if len(indices) < 2:\n        return input.replace(target, \"\")\n\n    first, last = indices[0], indices[-1]\n    result = [\n        ch for i, ch in enumerate(input)\n        if i != first and i != last\n    ]\n    return \"\".join(result)"}
{"task_id": "Mbpp/12", "solution": "import collections\nfrom typing import List\n\ndef sort_matrix(matrix: List[List[int]]) -> List[List[int]]:\n    \"\"\"\n    Sorts a given matrix in ascending order according to the sum of its rows.\n    The sorting is stable, preserving the original order of rows with equal sums.\n    \"\"\"\n    if not matrix:\n        return []\n\n    # Sort the matrix using the sum of each row as the key for comparison.\n    # The `sorted()` function provides a stable sort by default.\n    sorted_matrix = sorted(matrix, key=sum)\n\n    return sorted_matrix"}
{"task_id": "Mbpp/14", "solution": "class TriangularPrism:\n    \"\"\"Represents a triangular prism and computes its volume.\"\"\"\n    def __init__(self, base: float, height: float, length: float):\n        if not all(isinstance(v, (int, float)) and v > 0 for v in (base, height, length)):\n            raise ValueError(\"All dimensions must be positive numbers.\")\n        self.base = base\n        self.height = height\n        self.length = length\n\n    def computeVolume(self) -> float:\n        \"\"\"Calculates the volume of the triangular prism.\"\"\"\n        return 0.5 * self.base * self.height * self.length\n\ndef find_Volume(base: float, height: float, length: float) -> float:\n    \"\"\"\n    Finds the volume of a triangular prism given its base, height, and length.\n    All dimensions must be positive numbers.\n    \"\"\"\n    prism = TriangularPrism(base, height, length)\n    return prism.computeVolume()"}
