{"task_id": "Mbpp/271", "solution": "from typing import List\n\nclass EvenNumber:\n    \"\"\"Represents an even natural number and can compute its fifth power.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def power_fifth(self) -> int:\n        \"\"\"Computes the fifth power of the even number.\"\"\"\n        return self.value ** 5\n\nclass SumCalculator:\n    \"\"\"Aggregates a list of integer powers into a single sum.\"\"\"\n    @staticmethod\n    def sum_of_powers(powers: List[int]) -> int:\n        \"\"\"Calculates the sum of a list of integer powers.\"\"\"\n        return sum(powers)\n\nclass EvenPowerSumCalculator:\n    \"\"\"Orchestrates the calculation of the sum of even natural numbers raised to the fifth power.\"\"\"\n    def compute(self, n: int) -> int:\n        \"\"\"Computes the sum of the first n even natural numbers raised to the fifth power.\"\"\"\n        even_numbers = []\n        for i in range(1, n + 1):\n            even_numbers.append(EvenNumber(2 * i))\n\n        powered_values = [en.power_fifth() for en in even_numbers]\n\n        return SumCalculator.sum_of_powers(powered_values)\n\ndef even_Power_Sum(n: int) -> int:\n    \"\"\"\n    Finds the sum of the first n even natural numbers that are raised to the fifth power.\n    \"\"\"\n    calculator = EvenPowerSumCalculator()\n    return calculator.compute(n)"}
{"task_id": "Mbpp/273", "solution": "def substract_elements(tuple1: tuple[int], tuple2: tuple[int]) -> tuple[int]:\n    \"\"\"\n    Return a new tuple containing the element\u2011wise differences of tuple1 and tuple2.\n    Raises TypeError if inputs are not tuples.\n    Raises ValueError if tuples have different lengths.\n    \"\"\"\n    if not isinstance(tuple1, tuple) or not isinstance(tuple2, tuple):\n        raise TypeError(\"Both inputs must be tuples.\")\n    if len(tuple1) != len(tuple2):\n        raise ValueError(\"Tuples must have the same length.\")\n    return tuple(a - b for a, b in zip(tuple1, tuple2))"}
{"task_id": "Mbpp/272", "solution": "from typing import List, Tuple, Any\n\nclass TupleExtractor:\n    \"\"\"\n    Encapsulates the logic for extracting rear elements from a list of tuples.\n    \"\"\"\n    def extractRearElements(self, tuples: List[Tuple]) -> List[Any]:\n        \"\"\"\n        Extracts the last element from each tuple in the provided list.\n        \"\"\"\n        return [t[-1] for t in tuples]\n\ndef rear_extract(tuples: List[Tuple]) -> List[Any]:\n    \"\"\"\n    Takes a list of tuples and returns a list containing the rear element of each tuple.\n    \"\"\"\n    extractor = TupleExtractor()\n    return extractor.extractRearElements(tuples)"}
