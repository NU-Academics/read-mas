{"task_id": "Mbpp/406", "solution": "from dataclasses import dataclass\n\n@dataclass\nclass Number:\n    \"\"\"Value object to encapsulate an integer.\"\"\"\n    value: int\n\nclass ParityService:\n    \"\"\"Service to compute the parity of a number.\"\"\"\n    def find_Parity(self, number: int) -> bool:\n        \"\"\"\n        Determines if a given number is odd.\n        It instantiates a Number object and performs the parity check.\n        \"\"\"\n        num_obj = Number(value=number)\n        return num_obj.value % 2 != 0\n\ndef find_Parity(number: int) -> bool:\n    \"\"\"\n    Finds whether the parity of a given number is odd.\n    It delegates the parity check to an instance of ParityService.\n    \"\"\"\n    service = ParityService()\n    return service.find_Parity(number)"}
{"task_id": "Mbpp/409", "solution": "from typing import List, Tuple, Union\n\nclass TuplePair:\n    \"\"\"Represents a pair of numbers and can compute their product.\"\"\"\n    def __init__(self, first: Union[int, float], second: Union[int, float]):\n        self.first = first\n        self.second = second\n\n    def product(self) -> Union[int, float]:\n        \"\"\"Computes the product of the two elements.\"\"\"\n        return self.first * self.second\n\nclass ProductCalculator:\n    \"\"\"Calculates the minimum product from a list of TuplePair objects.\"\"\"\n    def __init__(self, tuple_pairs: List[TuplePair]):\n        self.tuples = tuple_pairs\n\n    def compute_min_product(self) -> Union[int, float]:\n        \"\"\"Finds the minimum product among all stored tuple pairs.\"\"\"\n        if not self.tuples:\n            return float('inf') # Returns infinity if no tuples to compute product from.\n\n        min_prod = self.tuples[0].product()\n        for i in range(1, len(self.tuples)):\n            current_prod = self.tuples[i].product()\n            if current_prod < min_prod:\n                min_prod = current_prod\n        return min_prod\n\n\ndef min_product_tuple(tuples: List[Tuple[Union[int, float], Union[int, float]]]) -> Union[int, float]:\n    \"\"\"\n    Finds the minimum product from the pairs of tuples within a given list.\n    Processes each tuple to calculate its product and then determines the minimum.\n    \"\"\"\n    # The prompt explicitly forbids error handling or type checks for edge cases.\n    # Therefore, we assume 'tuples' is a list of 2-element tuples containing numeric values.\n\n    tuple_pair_objects = []\n    for t in tuples:\n        tuple_pair_objects.append(TuplePair(t[0], t[1]))\n\n    calculator = ProductCalculator(tuple_pair_objects)\n    min_prod = calculator.compute_min_product()\n\n    return min_prod"}
{"task_id": "Mbpp/410", "solution": "from typing import Any, Iterable, Optional, Union\n\ndef min_val(elements: Iterable[Any]) -> Optional[Union[int, float]]:\n    \"\"\"\n    Finds the minimum numeric value in a heterogeneous iterable.\n    Non-numeric elements are ignored.\n    \"\"\"\n    min_so_far: Optional[Union[int, float]] = None\n\n    for element in elements:\n        if isinstance(element, (int, float)):\n            if min_so_far is None or element < min_so_far:\n                min_so_far = element\n    return min_so_far"}
