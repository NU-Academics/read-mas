{"task_id": "Mbpp/7", "solution": "def find_char_long(text):\n    \"\"\"\n    Finds all words in a string that are at least 4 characters long.\n    \"\"\"\n    words = text.split()\n    long_words = [word for word in words if len(word) >= 4]\n    return long_words"}
{"task_id": "Mbpp/9", "solution": "def find_Rotations(s: str) -> int:\n    \"\"\"\n    Finds the minimum number of positive rotations required to get the same string.\n    The algorithm leverages string doubling to find the smallest period.\n    \"\"\"\n    n = len(s)\n    if n == 0:\n        # Per completion instructions, do not raise exceptions.\n        # However, for 0-length strings, no positive rotation is possible.\n        # Returning 0 or 1 doesn't fit the \"positive rotations\" constraint.\n        # Assuming non-empty string input based on typical problem context.\n        return 0 \n\n    # Concatenate the string with itself.\n    # The original string 's' will appear again in 's2' starting at an index\n    # that corresponds to its smallest positive rotation that yields 's'.\n    s2 = s + s\n    \n    # Find the first occurrence of 's' in 's2', starting the search from index 1.\n    # The index returned will be the minimum number of rotations.\n    # For example, if s=\"abc\", s2=\"abcabc\". s2.find(\"abc\", 1) is 3.\n    # If s=\"aaaa\", s2=\"aaaaaaaa\". s2.find(\"aaaa\", 1) is 1.\n    return s2.find(s, 1)"}
{"task_id": "Mbpp/3", "solution": "def is_not_prime(number: int) -> bool:\n    \"\"\"\n    Identifies if a number is not prime.\n    Handles edge cases for numbers less than 2.\n    \"\"\"\n    if number < 2:\n        return True\n    if number == 2:\n        return False\n    if number % 2 == 0:\n        return True\n    i = 3\n    while i * i <= number:\n        if number % i == 0:\n            return True\n        i += 2\n    return False"}
{"task_id": "Mbpp/6", "solution": "def differ_At_One_Bit_Pos(a: int, b: int) -> bool:\n    \"\"\"\n    Checks if two integers differ at exactly one bit position.\n    This is determined by XORing the numbers and counting the set bits in the result.\n    \"\"\"\n    xor_result = a ^ b\n    return bin(xor_result).count('1') == 1"}
