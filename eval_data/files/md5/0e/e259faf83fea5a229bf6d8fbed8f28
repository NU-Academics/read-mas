{"task_id": "Mbpp/119", "solution": "from typing import List\n\ndef search(array: List[int]) -> int:\n    \"\"\"\n    Finds the element that appears only once in a sorted array where every\n    other element appears exactly twice.\n    It uses a binary search approach with O(log n) time complexity.\n    \"\"\"\n    left, right = 0, len(array) - 1\n\n    while left < right:\n        mid = (left + right) // 2\n        # Ensure mid points to an even index for pair comparison.\n        if mid % 2 == 1:\n            mid -= 1\n\n        # If elements at mid and mid+1 form a pair, the unique element is to the right.\n        if array[mid] == array[mid + 1]:\n            left = mid + 2\n        # Otherwise, the unique element is at or before mid.\n        else:\n            right = mid\n\n    return array[left]"}
{"task_id": "Mbpp/120", "solution": "import math\nfrom typing import List, Tuple\n\ndef max_product_tuple(pairs: List[Tuple[int, int]]) -> int:\n    \"\"\"\n    Computes the maximum absolute product of integer pairs within a list of tuples.\n    Returns 0 for an empty list, assuming valid input types.\n    \"\"\"\n    max_abs_product = 0\n    for a, b in pairs:\n        current_abs_product = abs(a * b)\n        if current_abs_product > max_abs_product:\n            max_abs_product = current_abs_product\n    return max_abs_product"}
