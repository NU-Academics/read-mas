{"task_id": "Mbpp/778", "solution": "def pack_consecutive_duplicates(lst):\n    \"\"\"\n    Groups consecutive duplicate elements of a list into sublists.\n    \"\"\"\n    if not lst:\n        return []\n\n    result = []\n    current_group = [lst[0]]\n\n    for element in lst[1:]:\n        if element == current_group[-1]:\n            current_group.append(element)\n        else:\n            result.append(current_group)\n            current_group = [element]\n\n    result.append(current_group)\n    return result"}
{"task_id": "Mbpp/780", "solution": "from typing import List, Tuple\n\ndef find_combinations(input_tuples: List[Tuple[int, ...]]) -> List[Tuple[int, ...]]:\n    \"\"\"\n    Finds combinations of element-wise sums from unique pairs of input tuples.\n    This function generates all unique pairwise sums of tuples from the given list.\n    \"\"\"\n    result = []\n    n = len(input_tuples)\n\n    for i in range(n):\n        for j in range(i + 1, n):\n            tuple1 = input_tuples[i]\n            tuple2 = input_tuples[j]\n            sum_tuple = tuple(a + b for a, b in zip(tuple1, tuple2))\n            result.append(sum_tuple)\n\n    return result"}
{"task_id": "Mbpp/781", "solution": "class DivisorCounter:\n    \"\"\"Internal helper class for counting divisors.\"\"\"\n\n    def count_divisors(self, n: int) -> int:\n        \"\"\"Returns the total number of positive divisors for `n`. Handles `n=0` by returning 0 divisors.\"\"\"\n        if n == 0:\n            return 0\n        if n < 0: # Ensure positive for divisor calculation\n            n = -n\n        \n        count = 0\n        limit = int(n ** 0.5)\n        for i in range(1, limit + 1):\n            if n % i == 0:\n                count += 2  # i and n//i are divisors\n        if limit * limit == n:\n            count -= 1  # Perfect square, its root was counted twice\n        return count\n\n    def is_even_divisor_count(self, n: int) -> bool:\n        \"\"\"Checks if the count of divisors for `n` is even. Returns `True` if even, `False` otherwise.\"\"\"\n        return self.count_divisors(n) % 2 == 0\n\ndef count_divisors(n: int) -> bool:\n    \"\"\"Checks if the count of positive divisors for `n` is even. Returns `True` if even, `False` otherwise.\"\"\"\n    return DivisorCounter().is_even_divisor_count(n)"}
{"task_id": "Mbpp/782", "solution": "import math\n\ndef odd_length_sum(nums: list) -> int:\n    \"\"\"\n    Calculate the sum of all subarrays of odd length.\n    \"\"\"\n    total_sum = 0\n    n = len(nums)\n    for i in range(n):\n        # Calculate frequency of nums[i] appearing in odd-length subarrays\n        # Number of choices for left part: i + 1\n        # Number of choices for right part: n - i\n        # Each index nums[i] contributes ceil((i + 1) * (n - i) / 2.0) times to odd-length subarrays\n        count = math.ceil(((i + 1) * (n - i)) / 2.0)\n        total_sum += nums[i] * int(count)\n    return total_sum"}
{"task_id": "Mbpp/784", "solution": "from typing import List, Optional\n\ndef mul_even_odd(numbers: List[int]) -> Optional[int]:\n    \"\"\"\n    Finds the product of the first even and first odd number in a list.\n    Returns None if either an even or an odd number is not found.\n    \"\"\"\n    first_even = None\n    first_odd = None\n\n    for num in numbers:\n        if first_even is None and num % 2 == 0:\n            first_even = num\n        if first_odd is None and num % 2 != 0:\n            first_odd = num\n        \n        if first_even is not None and first_odd is not None:\n            break\n            \n    if first_even is not None and first_odd is not None:\n        return first_even * first_odd\n    else:\n        return None"}
{"task_id": "Mbpp/785", "solution": "import ast\n\ndef tuple_str_int(tuple_string: str) -> tuple[int, ...]:\n    \"\"\"Converts a string representation of an integer tuple to a tuple of integers.\n\n    Raises ValueError for invalid input string formats or non-integer tuple elements.\n    \"\"\"\n    try:\n        parsed_value = ast.literal_eval(tuple_string)\n        if not isinstance(parsed_value, tuple):\n            raise ValueError(\"Input string must represent a tuple.\")\n        for item in parsed_value:\n            if not isinstance(item, int):\n                raise ValueError(\"All elements in the tuple must be integers.\")\n        return parsed_value\n    except (ValueError, SyntaxError) as e:\n        raise ValueError(f\"Invalid tuple string format: {e}\") from e"}
{"task_id": "Mbpp/786", "solution": "from typing import List\n\ndef right_insertion(sorted_list: List[int], value: int) -> int:\n    \"\"\"\n    Locates the right insertion point for a specified value in a sorted list.\n    This is equivalent to Python's bisect_right.\n    \"\"\"\n    low = 0\n    high = len(sorted_list)\n\n    while low < high:\n        mid = (low + high) // 2\n        if sorted_list[mid] <= value:\n            low = mid + 1\n        else:\n            high = mid\n    return low"}
