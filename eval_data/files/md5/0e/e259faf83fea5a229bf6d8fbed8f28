{"task_id": "Mbpp/573", "solution": "from typing import List\n\ndef unique_product(numbers: List[int]) -> int:\n    \"\"\"\n    Compute the product of unique integers in the given list.\n    Returns 1 for an empty list and raises ValueError for non-integer elements.\n    \"\"\"\n    if not all(isinstance(n, int) for n in numbers):\n        raise ValueError(\"All elements must be integers.\")\n\n    unique_vals = set(numbers)\n\n    if not unique_vals:\n        return 1\n\n    product = 1\n    for val in unique_vals:\n        product *= val\n\n    return product"}
{"task_id": "Mbpp/576", "solution": "from typing import List, Any\n\ndef is_Sub_Array(first: List[Any], second: List[Any]) -> bool:\n    \"\"\"\n    Determine whether `second` is a contiguous sublist of `first`.\n    It handles empty lists and compares elements using equality.\n    \"\"\"\n    if not second:\n        return True\n    if len(first) < len(second):\n        return False\n\n    for i in range(len(first) - len(second) + 1):\n        if first[i:i + len(second)] == second:\n            return True\n    return False"}
{"task_id": "Mbpp/578", "solution": "def interleave_lists(list1, list2, list3):\n    \"\"\"Interleaves three lists of the same length into a single flat list.\"\"\"\n    interleaved_list = []\n    for i in range(len(list1)):\n        interleaved_list.append(list1[i])\n        interleaved_list.append(list2[i])\n        interleaved_list.append(list3[i])\n    return interleaved_list"}
{"task_id": "Mbpp/577", "solution": "from __future__ import annotations\n\ndef last_Digit_Factorial(n: int) -> int:\n    \"\"\"\n    Computes the last digit of the factorial of a given non-negative integer.\n    The calculation uses modular arithmetic to prevent large intermediate numbers.\n    \"\"\"\n    if n < 0:\n        raise ValueError(\"Input must be a non-negative integer\")\n\n    if n == 0:\n        return 1\n\n    result = 1\n    for i in range(1, n + 1):\n        result = (result * i) % 10\n    return result"}
{"task_id": "Mbpp/580", "solution": "def extract_even(input_tuple):\n    \"\"\"\n    Recursively extracts even integers from a nested tuple structure.\n    Non-integer, non-tuple elements are skipped.\n    \"\"\"\n    result = []\n    for item in input_tuple:\n        if isinstance(item, int):\n            if item % 2 == 0:\n                result.append(item)\n        elif isinstance(item, tuple):\n            extracted_nested = extract_even(item)\n            # Only append if the nested tuple is not empty, to match example behavior\n            # where (7,...) became nothing, so (6, (2,4)) became (6, (2,4))\n            # not (6, (), (2,4)) for example.\n            if extracted_nested:\n                result.append(extracted_nested)\n    return tuple(result)"}
{"task_id": "Mbpp/581", "solution": "import math\n\ndef surface_Area(base_edge, height):\n    \"\"\"\n    Calculates the surface area of a square pyramid.\n    Assumes base_edge and height are positive numbers.\n    \"\"\"\n    base_area = base_edge ** 2\n    slant_height = math.sqrt((base_edge / 2) ** 2 + height ** 2)\n    lateral_area = 2 * base_edge * slant_height\n    surface_area = base_area + lateral_area\n    return surface_area"}
{"task_id": "Mbpp/579", "solution": "def find_dissimilar(tuple1: tuple, tuple2: tuple) -> tuple:\n    \"\"\"\n    Return a tuple of elements that appear in exactly one of the input tuples.\n    Order is preserved from the original tuples.\n    \"\"\"\n    set2 = set(tuple2)\n    result = [x for x in tuple1 if x not in set2]\n    set1 = set(tuple1)\n    result.extend([x for x in tuple2 if x not in set1])\n    return tuple(result)"}
{"task_id": "Mbpp/583", "solution": "import math\n\ndef catalan_number(n: int) -> int:\n    \"\"\"\n    Calculates the nth Catalan number using the binomial coefficient formula: C_n = (1 / (n + 1)) * C(2n, n).\n    The function assumes n is a non-negative integer.\n    \"\"\"\n    if n == 0:\n        return 1\n    \n    # C(2n, n)\n    binomial_coeff = math.comb(2 * n, n)\n    \n    # C_n = C(2n, n) / (n + 1)\n    result = binomial_coeff // (n + 1)\n    \n    return result"}
{"task_id": "Mbpp/585", "solution": "from typing import List, Dict, Any\n\ndef expensive_items(items: List[Dict[str, Any]], n: int) -> List[Dict[str, Any]]:\n    \"\"\"\n    Finds the n most expensive items in a list of dictionaries.\n    Items are sorted by price in descending order.\n    \"\"\"\n    sorted_items = sorted(items, key=lambda x: x['price'], reverse=True)\n    return sorted_items[:n]"}
