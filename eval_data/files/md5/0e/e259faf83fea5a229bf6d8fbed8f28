{"task_id": "Mbpp/294", "solution": "from typing import Iterable, Any, Union\n\ndef max_val(elements: Iterable[Any]) -> Union[int, float]:\n    \"\"\"\n    Return the maximum numeric value from a heterogeneous iterable, ignoring non-numeric elements.\n    Raises ValueError if no numeric elements are found.\n    \"\"\"\n    if not hasattr(elements, \"__iter__\"):\n        raise TypeError(\"Input must be an iterable\")\n\n    max_value = None\n    for item in elements:\n        if isinstance(item, (int, float)):\n            if max_value is None or item > max_value:\n                max_value = item\n\n    if max_value is None:\n        raise ValueError(\"No numeric elements found in the input iterable\")\n\n    return max_value"}
{"task_id": "Mbpp/296", "solution": "def get_Inv_Count(arr):\n    n = len(arr)\n    if n <= 1:\n        return 0\n\n    # A temporary array to assist in the merge operation, preventing repeated allocations.\n    temp_arr = [0] * n\n\n    def _merge(arr_local, temp_local, left, mid, right):\n        \"\"\"Merges two sorted subarrays and counts inversions during the merge.\"\"\"\n        i = left      # Starting index for left subarray\n        j = mid + 1   # Starting index for right subarray\n        k = left      # Starting index to store merged subarray\n        inv_count = 0\n\n        while i <= mid and j <= right:\n            if arr_local[i] <= arr_local[j]:\n                temp_local[k] = arr_local[i]\n                i += 1\n            else:\n                # If arr_local[i] > arr_local[j], it means arr_local[j] forms inversions\n                # with all remaining elements in the left subarray (from arr_local[i] to arr_local[mid]).\n                temp_local[k] = arr_local[j]\n                inv_count += (mid - i + 1)\n                j += 1\n            k += 1\n\n        # Copy the remaining elements of the left subarray, if any.\n        while i <= mid:\n            temp_local[k] = arr_local[i]\n            i += 1\n            k += 1\n\n        # Copy the remaining elements of the right subarray, if any.\n        while j <= right:\n            temp_local[k] = arr_local[j]\n            j += 1\n            k += 1\n\n        # Copy the merged elements back to the original array segment.\n        for idx in range(left, right + 1):\n            arr_local[idx] = temp_local[idx]\n\n        return inv_count\n\n    def _merge_sort_and_count(arr_local, temp_local, left, right):\n        \"\"\"Recursively sorts the array segment and counts inversions.\"\"\"\n        inv_count = 0\n        if left < right:\n            mid = (left + right) // 2\n\n            # Total inversions are the sum of inversions in left half, right half,\n            # and inversions formed during the merge of the two halves.\n            inv_count += _merge_sort_and_count(arr_local, temp_local, left, mid)\n            inv_count += _merge_sort_and_count(arr_local, temp_local, mid + 1, right)\n            inv_count += _merge(arr_local, temp_local, left, mid, right)\n        return inv_count\n\n    return _merge_sort_and_count(arr, temp_arr, 0, n - 1)"}
{"task_id": "Mbpp/297", "solution": "import collections\n\ndef flatten_list(nested_list):\n    \"\"\"Flattens a given nested list structure into a single list.\"\"\"\n    flattened = []\n    stack = [nested_list]\n    while stack:\n        current_list = stack.pop()\n        # Process elements in reverse to maintain original order when popping from stack\n        for item in reversed(current_list):\n            if isinstance(item, collections.abc.Iterable) and not isinstance(item, (str, bytes)):\n                stack.append(item)\n            else:\n                flattened.append(item)\n    return list(reversed(flattened))"}
{"task_id": "Mbpp/300", "solution": "import math\n\ndef count_binary_seq(n: int) -> float:\n    \"\"\"\n    Calculates the count of binary sequences of length 2n where the sum of the first n bits equals the sum of the last n bits.\n    This is equivalent to summing squares of binomial coefficients: sum(C(n, k)^2 for k=0 to n).\n    \"\"\"\n    if n <= 0:\n        raise ValueError(\"n must be a positive integer.\")\n\n    # The problem can be rephrased as:\n    # Choose k bits for the first n positions to be 1 (sum = k).\n    # Choose k bits for the last n positions to be 1 (sum = k).\n    # The number of ways to do this is C(n, k) * C(n, k) = C(n, k)^2.\n    # We sum this over all possible values of k (from 0 to n).\n    # This sum is a known identity equal to C(2n, n).\n    \n    # Calculate C(2n, n)\n    return float(math.comb(2 * n, n))"}
{"task_id": "Mbpp/299", "solution": "from typing import List, Tuple, Dict\nfrom collections import defaultdict\n\ndef max_aggregate(input_list: List[Tuple[str, int]]) -> Tuple[str, int]:\n    \"\"\"\n    Calculates the maximum aggregate score from a list of (name, score) tuples.\n    Aggregates scores by name and returns the name with the highest total score.\n    \"\"\"\n    if not input_list:\n        raise ValueError(\"Input list cannot be empty.\")\n\n    aggregates: Dict[str, int] = defaultdict(int)\n    for name, score in input_list:\n        if not isinstance(score, int):\n            raise TypeError(f\"Score for '{name}' must be an integer, but got {type(score).__name__}.\")\n        aggregates[name] += score\n\n    max_name, max_total = max(aggregates.items(), key=lambda item: item[1])\n\n    return (max_name, max_total)"}
{"task_id": "Mbpp/301", "solution": "def dict_depth(d: dict) -> int:\n    \"\"\"\n    Finds the maximum depth of a nested dictionary.\n    Uses an iterative approach to handle deep nesting without recursion limits.\n    \"\"\"\n    max_depth = 0\n    stack = [(d, 1)]  # Stack stores (current_dict, current_depth)\n\n    while stack:\n        current_dict, current_depth = stack.pop()\n        max_depth = max(max_depth, current_depth)\n\n        for value in current_dict.values():\n            if isinstance(value, dict):\n                stack.append((value, current_depth + 1))\n    return max_depth"}
