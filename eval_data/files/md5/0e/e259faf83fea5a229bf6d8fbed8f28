{"task_id": "Mbpp/57", "solution": "def find_Max_Num(digits):\n    \"\"\"\n    Finds the largest number that can be formed with the given list of digits.\n    Digits are sorted in descending order and concatenated to form the number.\n    \"\"\"\n    if not digits:\n        return 0\n\n    str_digits = [str(d) for d in digits]\n    str_digits.sort(reverse=True)\n    \n    return int(\"\".join(str_digits))"}
{"task_id": "Mbpp/61", "solution": "from typing import List\n\nclass Substring:\n    \"\"\"Represents a contiguous substring with its properties.\"\"\"\n    def __init__(self, start: int, end: int, length: int, sum_digits: int):\n        self.start = start\n        self.end = end\n        self.length = length\n        self.sum = sum_digits\n\nclass DigitString:\n    \"\"\"Encapsulates a string of digits and provides methods for substring extraction.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n\n    def get_substrings(self) -> List[Substring]:\n        \"\"\"Generates all contiguous substrings with their digit sum and length.\"\"\"\n        substrings: List[Substring] = []\n        n = len(self.value)\n        for i in range(n):\n            current_sum = 0\n            for j in range(i, n):\n                current_sum += int(self.value[j])\n                current_length = j - i + 1\n                substrings.append(Substring(i, j, current_length, current_sum))\n        return substrings\n\nclass SubstringCounter:\n    \"\"\"Counts substrings that meet the criteria (digit sum equals length).\"\"\"\n    def count(self, digit_string_obj: DigitString) -> int:\n        \"\"\"Counts qualifying substrings within the provided DigitString object.\"\"\"\n        count = 0\n        all_substrings = digit_string_obj.get_substrings()\n        for sub in all_substrings:\n            if sub.sum == sub.length:\n                count += 1\n        return count\n\ndef count_Substrings(digit_string: str) -> int:\n    \"\"\"\n    Counts the number of substrings where the sum of digits equals the substring's length.\n    Raises ValueError if the input string contains non-digit characters.\n    \"\"\"\n    if not digit_string:\n        return 0\n\n    for char in digit_string:\n        if not char.isdigit():\n            raise ValueError(\"Input string must contain only digits.\")\n\n    digit_string_obj = DigitString(digit_string)\n    counter = SubstringCounter()\n    return counter.count(digit_string_obj)"}
