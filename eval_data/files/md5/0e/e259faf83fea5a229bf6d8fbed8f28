{"task_id": "Mbpp/751", "solution": "def check_min_heap(arr: list[int]) -> bool:\n    \"\"\"\n    Checks if the given array represents a min-heap.\n    A min-heap satisfies the property that the value of each node is less than or equal to the value of its children.\n    \"\"\"\n    n = len(arr)\n\n    # An empty array or a single-element array is considered a valid min-heap.\n    if n <= 1:\n        return True\n\n    # Iterate through all parent nodes\n    # A node at index i has children at 2*i + 1 (left) and 2*i + 2 (right).\n    # We only need to check nodes that can have children.\n    # The last parent node is at index (n // 2) - 1.\n    for i in range(n // 2):\n        left_child_idx = 2 * i + 1\n        right_child_idx = 2 * i + 2\n\n        # Check left child\n        if left_child_idx < n and arr[i] > arr[left_child_idx]:\n            return False\n\n        # Check right child (if it exists)\n        if right_child_idx < n and arr[i] > arr[right_child_idx]:\n            return False\n\n    return True"}
{"task_id": "Mbpp/752", "solution": "def jacobsthal_num(n):\n    \"\"\"\n    Calculates the nth Jacobsthal number using an iterative approach.\n    Handles base cases J(0)=0 and J(1)=1.\n    \"\"\"\n    if n == 0:\n        return 0\n    if n == 1:\n        return 1\n\n    a, b = 0, 1  # Corresponds to J(0) and J(1)\n    for _ in range(2, n + 1):\n        # Calculate J(k) = J(k-1) + 2 * J(k-2)\n        # new_b = b + 2 * a\n        # a = b\n        # b = new_b\n        a, b = b, b + 2 * a\n    return b"}
{"task_id": "Mbpp/753", "solution": "import heapq\n\ndef min_k(records, k):\n    \"\"\"\n    Finds the minimum k records from a list of tuples based on their second element.\n    Uses heapq.nsmallest for efficient selection and ensures the result is sorted.\n    \"\"\"\n    if not (0 <= k <= len(records)):\n        raise ValueError(\"k must be between 0 and the number of records (inclusive).\")\n\n    # heapq.nsmallest returns the k smallest elements in sorted order.\n    # The key specifies that comparison should be based on the second element of the tuple.\n    return heapq.nsmallest(k, records, key=lambda x: x[1])"}
{"task_id": "Mbpp/755", "solution": "from typing import List\n\ndef second_smallest(lst: List[int]) -> int:\n    \"\"\"\n    Finds the second smallest number in a list of integers.\n    Raises ValueError if the list contains fewer than two elements.\n    \"\"\"\n    if len(lst) < 2:\n        raise ValueError(\"List must contain at least two elements to find the second smallest.\")\n\n    smallest = float('inf')\n    second_smallest = float('inf')\n\n    for num in lst:\n        if num < smallest:\n            second_smallest = smallest\n            smallest = num\n        elif num < second_smallest and num != smallest:\n            second_smallest = num\n            \n    return second_smallest"}
{"task_id": "Mbpp/754", "solution": "def extract_index_list(l1, l2, l3):\n    \"\"\"\n    Finds elements that appear at the same index in all three input lists.\n    Returns a new list of these common elements.\n    \"\"\"\n    common_elements = []\n    min_len = min(len(l1), len(l2), len(l3))\n    for i in range(min_len):\n        if l1[i] == l2[i] == l3[i]:\n            common_elements.append(l1[i])\n    return common_elements"}
