{"task_id": "Mbpp/801", "solution": "class TestThreeEqualFunction:\n    \"\"\"Internal class to encapsulate the logic for counting equal numbers.\"\"\"\n    \n    def countEqual(self, a: int, b: int, c: int) -> int:\n        \"\"\"Counts the number of equal integers among three inputs.\"\"\"\n        if a == b and b == c:\n            return 3\n        elif a == b or a == c or b == c:\n            return 2\n        else:\n            return 0\n\ndef test_three_equal(a: int, b: int, c: int) -> int:\n    \"\"\"\n    Counts the number of equal numbers from three given integers.\n    \"\"\"\n    counter_logic = TestThreeEqualFunction()\n    return counter_logic.countEqual(a, b, c)"}
{"task_id": "Mbpp/803", "solution": "def is_perfect_square(n: int) -> bool:\n    \"\"\"Checks if the given number is a perfect square using binary search.\"\"\"\n    if n < 0:\n        return False\n    if n == 0:\n        return True\n\n    low, high = 1, n\n    while low <= high:\n        mid = (low + high) // 2\n        sq = mid * mid\n        if sq == n:\n            return True\n        elif sq < n:\n            low = mid + 1\n        else:\n            high = mid - 1\n    return False"}
{"task_id": "Mbpp/804", "solution": "from typing import List\n\ndef is_product_even(numbers: List[int]) -> bool:\n    \"\"\"\n    Checks if the product of numbers in a list is even.\n    An empty list's product is considered 1 (odd).\n    \"\"\"\n    if not numbers:\n        return False  # Product of empty list is 1, which is odd\n    \n    for num in numbers:\n        if num % 2 == 0:\n            return True  # If any number is even, the product is even\n            \n    return False  # All numbers are odd, so their product is odd"}
{"task_id": "Mbpp/805", "solution": "from typing import List\nfrom dataclasses import dataclass\n\n@dataclass\nclass Element:\n    value: int\n\n@dataclass\nclass Sublist:\n    elements: List[int]\n\n    def sum(self) -> int:\n        return sum(self.elements)\n\n@dataclass\nclass ListCollection:\n    sublists: List[Sublist]\n\n    def __init__(self, lists: List[List[int]]):\n        self.sublists = [Sublist(elements=l) for l in lists]\n\ndef max_sum_list(lists: List[List[int]]) -> List[int]:\n    \"\"\"\n    Returns the sublist with the highest sum.\n    If multiple sublists have the same sum, the first is returned.\n    \"\"\"\n    collection = ListCollection(lists)\n    max_sublist = None\n    max_sum = float('-inf')\n\n    for sublist in collection.sublists:\n        current_sum = sublist.sum()\n        if current_sum > max_sum:\n            max_sum = current_sum\n            max_sublist = sublist\n\n    return max_sublist.elements if max_sublist else []"}
