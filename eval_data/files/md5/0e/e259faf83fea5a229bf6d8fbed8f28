{"task_id": "Mbpp/587", "solution": "from typing import Any, List, Tuple\n\ndef list_tuple(input_list: List[Any]) -> Tuple[Any, ...]:\n    \"\"\"\n    Convert a list to a tuple without modifying the original list.\n\n    Parameters\n    ----------\n    input_list : List[Any]\n        The list to convert.\n\n    Returns\n    -------\n    Tuple[Any, ...]\n        A tuple containing the same elements in the same order as input_list.\n    \"\"\"\n    if not isinstance(input_list, list):\n        raise TypeError(\"input_list must be a list\")\n    # Return a new tuple; input_list remains unchanged\n    return tuple(input_list)"}
{"task_id": "Mbpp/588", "solution": "def big_diff(nums: list[int]) -> int:\n    \"\"\"\n    Return the difference between the largest and smallest values in the input list.\n    Assumes the input list is non-empty and contains only integers.\n    \"\"\"\n    max_val = max(nums)\n    min_val = min(nums)\n    return max_val - min_val"}
{"task_id": "Mbpp/589", "solution": "import math\n\ndef perfect_squares(lowerBound: int, upperBound: int) -> list[int]:\n    \"\"\"\n    Finds perfect squares within an inclusive integer range.\n    \"\"\"\n    start_root = math.isqrt(lowerBound)\n    if start_root * start_root < lowerBound:\n        start_root += 1\n\n    end_root = math.isqrt(upperBound)\n\n    squares = []\n    for i in range(start_root, end_root + 1):\n        square = i * i\n        squares.append(square)\n\n    return squares"}
{"task_id": "Mbpp/591", "solution": "def swap_List(lst):\n    \"\"\"\n    Interchanges the first and last elements in a list.\n    Returns a new list with the elements swapped, leaving the original list unmodified.\n    \"\"\"\n    n = len(lst)\n    if n < 2:\n        return list(lst)  # Return a copy if less than 2 elements\n\n    # Create a new list to avoid modifying the original\n    new_list = list(lst)\n\n    # Swap the first and last elements\n    new_list[0], new_list[n - 1] = new_list[n - 1], new_list[0]\n\n    return new_list"}
{"task_id": "Mbpp/590", "solution": "import math\n\ndef polar_rect(radius: float, angle: float) -> tuple[tuple[float, float], complex]:\n    \"\"\"\n    Converts polar coordinates (radius, angle) to rectangular coordinates.\n    Returns a tuple containing the input polar coordinates and the resulting complex number.\n    \"\"\"\n    x = radius * math.cos(angle)\n    y = radius * math.sin(angle)\n    return ((radius, angle), complex(x, y))"}
{"task_id": "Mbpp/592", "solution": "import math\n\ndef sum_Of_product(n):\n    \"\"\"\n    Finds the sum of the product of consecutive binomial coefficients.\n    It calculates \u03a3\u2096\u208c\u2080\u207f\u207b\u00b9 C(n,k) \u00d7 C(n,k+1).\n    \"\"\"\n    if n < 1:\n        return 0\n\n    def binomial_coefficient(n_val, k_val):\n        \"\"\"Calculates the binomial coefficient C(n_val, k_val).\"\"\"\n        if k_val < 0 or k_val > n_val:\n            return 0\n        return math.factorial(n_val) // (math.factorial(k_val) * math.factorial(n_val - k_val))\n\n    total_sum = 0\n    for k in range(n): # Iterate k from 0 to n-1\n        coeff_k = binomial_coefficient(n, k)\n        coeff_k_plus_1 = binomial_coefficient(n, k + 1)\n        total_sum += coeff_k * coeff_k_plus_1\n    \n    return total_sum"}
{"task_id": "Mbpp/593", "solution": "import typing\n\ndef removezero_ip(ip_address: str) -> typing.Tuple[str]:\n    \"\"\"\n    Removes leading zeroes from each octet of an IPv4 address string.\n    Raises ValueError for invalid IP address formats or octet values.\n    \"\"\"\n    octets = ip_address.split('.')\n    if len(octets) != 4:\n        raise ValueError(\"Invalid IP address format: must contain four octets separated by dots.\")\n\n    cleaned_octets = []\n    for octet_str in octets:\n        try:\n            # Attempt to convert to int. This handles non-numeric strings and removes leading zeros implicitly.\n            octet_val = int(octet_str)\n        except ValueError:\n            raise ValueError(f\"Invalid octet '{octet_str}': must be a numeric value.\")\n        \n        # Validate octet value is within the IPv4 range [0, 255]\n        if not (0 <= octet_val <= 255):\n            raise ValueError(f\"Invalid octet value '{octet_val}': must be between 0 and 255.\")\n        \n        # Convert back to string; this naturally removes any leading zeros (e.g., 8 instead of 08, 0 instead of 00).\n        cleaned_octets.append(str(octet_val))\n    \n    # Join the cleaned octets with dots and return as a single-element tuple.\n    return (\".\".join(cleaned_octets),)"}
{"task_id": "Mbpp/594", "solution": "def diff_even_odd(numbers):\n    \"\"\"\n    Finds the difference between the first even and first odd number in a list.\n    Returns the difference (first_even - first_odd) or None if either is not found.\n    \"\"\"\n    first_even = None\n    first_odd = None\n\n    for num in numbers:\n        if first_even is None and num % 2 == 0:\n            first_even = num\n        if first_odd is None and num % 2 != 0:\n            first_odd = num\n        if first_even is not None and first_odd is not None:\n            break\n\n    if first_even is not None and first_odd is not None:\n        return first_even - first_odd\n    else:\n        return None"}
