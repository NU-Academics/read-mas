{"task_id": "Mbpp/721", "solution": "from dataclasses import dataclass\nfrom typing import List\n\ndef maxAverageOfPath(matrix: List[List[int]]) -> float:\n    \"\"\"\n    Given a square matrix, finds the path from top-left to bottom-right\n    moving only right or down, with the maximum average cost.\n    \"\"\"\n\n    N = len(matrix)\n\n    @dataclass\n    class Cell:\n        row: int\n        col: int\n        cost: int\n\n    @dataclass\n    class Path:\n        cells: List[Cell]\n\n        @property\n        def length(self) -> int:\n            return len(self.cells)\n\n        @property\n        def sum(self) -> int:\n            return sum(cell.cost for cell in self.cells)\n\n        def average(self) -> float:\n            if self.length == 0:\n                return 0.0\n            return self.sum / self.length\n\n    all_paths: List[Path] = []\n\n    def generate_paths_dfs(r: int, c: int, current_path_cells: List[Cell]):\n        \"\"\"\n        Recursively generates all valid paths from (r, c) to (N-1, N-1).\n        \"\"\"\n        current_path_cells.append(Cell(r, c, matrix[r][c]))\n\n        if r == N - 1 and c == N - 1:\n            all_paths.append(Path(list(current_path_cells)))\n            current_path_cells.pop()\n            return\n\n        if c + 1 < N:\n            generate_paths_dfs(r, c + 1, current_path_cells)\n\n        if r + 1 < N:\n            generate_paths_dfs(r + 1, c, current_path_cells)\n\n        current_path_cells.pop()\n\n    if N == 0:\n        return 0.0\n        \n    generate_paths_dfs(0, 0, [])\n\n    max_avg = -float('inf')\n\n    for path in all_paths:\n        current_avg = path.average()\n        if current_avg > max_avg:\n            max_avg = current_avg\n\n    # In case no paths were found (e.g., N=0, handled above), though not expected for valid N.\n    if not all_paths: \n        return 0.0\n\n    return max_avg"}
