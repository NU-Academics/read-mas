{"task_id": "Mbpp/74", "solution": "def is_samepatterns(words, patterns):\n    \"\"\"\n    Checks if two sequences follow the same pattern of element occurrences.\n    It maps elements to canonical indices based on their first appearance order.\n    \"\"\"\n    if len(words) != len(patterns):\n        return False\n\n    # Generate canonical indices for the 'words' sequence\n    word_map = {}\n    word_indices = []\n    current_word_idx = 0\n    for word in words:\n        if word not in word_map:\n            word_map[word] = current_word_idx\n            current_word_idx += 1\n        word_indices.append(word_map[word])\n\n    # Generate canonical indices for the 'patterns' sequence\n    pattern_map = {}\n    pattern_indices = []\n    current_pattern_idx = 0\n    for char_pattern in patterns:\n        if char_pattern not in pattern_map:\n            pattern_map[char_pattern] = current_pattern_idx\n            current_pattern_idx += 1\n        pattern_indices.append(pattern_map[char_pattern])\n\n    # Compare the two generated index sequences\n    return word_indices == pattern_indices"}
{"task_id": "Mbpp/75", "solution": "import collections\n\ndef find_tuples(tuples: list[tuple[int, ...]], k: int) -> list[tuple[int, ...]]:\n    \"\"\"\n    Finds tuples where all elements are divisible by k from the given list of tuples.\n    Raises ValueError if k is zero.\n    \"\"\"\n    if k == 0:\n        raise ValueError(\"Divisor k cannot be zero.\")\n\n    result_tuples = []\n    for tup in tuples:\n        if all(element % k == 0 for element in tup):\n            result_tuples.append(tup)\n    return result_tuples"}
{"task_id": "Mbpp/77", "solution": "def is_Diff(number: int) -> bool:\n    \"\"\"\n    Checks if a number is divisible by 11 using the alternating sum of digits rule.\n    \"\"\"\n    s = str(number)\n    sum_odd_positions = 0\n    sum_even_positions = 0\n\n    for i, digit_char in enumerate(reversed(s)):\n        digit = int(digit_char)\n        # Positions are 1-indexed from the right\n        if (i + 1) % 2 == 1:  # Odd position\n            sum_odd_positions += digit\n        else:  # Even position\n            sum_even_positions += digit\n\n    return abs(sum_odd_positions - sum_even_positions) % 11 == 0"}
