{"task_id": "Mbpp/615", "solution": "def average_tuple(tuples: tuple[tuple[int | float, ...], ...]) -> list[float]:\n    \"\"\"\n    Calculates the average of elements at corresponding positions across all inner tuples.\n    Returns a list of these averages.\n    \"\"\"\n    if not tuples:\n        return []\n\n    # Assuming all inner tuples have the same length, based on the provided assert example.\n    num_columns = len(tuples[0])\n    num_rows = len(tuples)\n    \n    averages = []\n    for col_idx in range(num_columns):\n        col_sum = 0.0\n        for row_idx in range(num_rows):\n            col_sum += tuples[row_idx][col_idx]\n        \n        # num_rows will be greater than 0 if we reached this point\n        averages.append(col_sum / num_rows)\n            \n    return averages"}
{"task_id": "Mbpp/618", "solution": "def div_list(list1, list2):\n    if len(list1) != len(list2):\n        raise ValueError(\"Input lists must have the same length.\")\n\n    result = []\n    for a, b in zip(list1, list2):\n        if b == 0:\n            raise ZeroDivisionError(\"Division by zero encountered in list2.\")\n        result.append(float(a) / float(b))\n    return result"}
{"task_id": "Mbpp/619", "solution": "def move_num(s: str) -> str:\n    \"\"\"\n    Moves all numeric characters to the end of the given string,\n    preserving the relative order of both non\u2011numeric and numeric characters.\n    \"\"\"\n    non_digits = []\n    digits = []\n    for char in s:\n        if char.isdigit():\n            digits.append(char)\n        else:\n            non_digits.append(char)\n    return ''.join(non_digits + digits)"}
{"task_id": "Mbpp/620", "solution": "def largest_subset(numbers):\n    \"\"\"\n    Finds the size of the largest subset of numbers where every pair is divisible.\n    Uses dynamic programming after sorting the input list.\n    \"\"\"\n    if not numbers:\n        return 0\n    if len(numbers) == 1:\n        return 1\n\n    numbers.sort()\n    n = len(numbers)\n    dp = [1] * n\n\n    for i in range(n):\n        for j in range(i):\n            if numbers[i] % numbers[j] == 0:\n                dp[i] = max(dp[i], dp[j] + 1)\n    \n    return max(dp)"}
{"task_id": "Mbpp/622", "solution": "def get_median(list1, list2, n):\n    \"\"\"\n    Finds the median of two sorted lists of the same size n.\n    It merges the lists, sorts them, and calculates the average of the two middle elements.\n    \"\"\"\n    merged_list = list1 + list2\n    sorted_merged_list = sorted(merged_list)\n    \n    # For 2n elements, the two middle elements are at indices n-1 and n.\n    median = (sorted_merged_list[n - 1] + sorted_merged_list[n]) / 2.0\n    \n    return median"}
