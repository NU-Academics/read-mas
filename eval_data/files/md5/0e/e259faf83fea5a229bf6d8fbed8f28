{"task_id": "Mbpp/770", "solution": "class OddNumberSequence:\n    \"\"\"Iterates over the first n odd natural numbers.\n    Generates numbers 1, 3, 5, ... up to the specified count.\n    \"\"\"\n    def __init__(self, count: int):\n        self.start = 1\n        self.step = 2\n        self.count = count\n        self.current = 0\n\n    def __iter__(self):\n        return self\n\n    def __next__(self) -> int:\n        if self.current >= self.count:\n            raise StopIteration\n        value = self.start + self.current * self.step\n        self.current += 1\n        return value\n\n\nclass PowerCalculator:\n    \"\"\"Utility class to compute the fourth power of an integer.\"\"\"\n    @staticmethod\n    def fourth_power(x: int) -> int:\n        return x ** 4\n\n\nclass SumCalculator:\n    \"\"\"Calculates the sum of fourth powers of the first n odd numbers.\"\"\"\n    def __init__(self):\n        self.power_calc = PowerCalculator()\n\n    def calculate_sum(self, n: int) -> int:\n        if n == 0:\n            return 0\n        seq = OddNumberSequence(n)\n        total = 0\n        for num in seq:\n            total += self.power_calc.fourth_power(num)\n        return total\n\n\ndef odd_num_sum(n: int) -> int:\n    \"\"\"\n    Return the sum of the fourth powers of the first n odd natural numbers.\n    This function uses helper classes for sequence generation and power calculation.\n    \"\"\"\n    calculator = SumCalculator()\n    return calculator.calculate_sum(n)"}
{"task_id": "Mbpp/771", "solution": "class Expression:\n    \"\"\"Represents an expression string to be checked for balance.\"\"\"\n    def __init__(self, expr: str):\n        self.expr = expr\n\n    def is_balanced(self) -> bool:\n        \"\"\"Checks if the expression contained in the instance is balanced using a stack.\"\"\"\n        stack = []\n        mapping = {\")\": \"(\", \"}\": \"{\", \"]\": \"[\"}\n        opening_brackets = set(mapping.values())\n        closing_brackets = set(mapping.keys())\n\n        for char in self.expr:\n            if char in opening_brackets:\n                stack.append(char)\n            elif char in closing_brackets:\n                if not stack:\n                    return False\n                top_element = stack.pop()\n                if mapping[char] != top_element:\n                    return False\n        return not stack\n\nclass BalancedChecker:\n    \"\"\"Provides the service to check an Expression for balance.\"\"\"\n    def check(self, expr_obj: Expression) -> bool:\n        \"\"\"Delegates to the Expression object's method to check if it is balanced.\"\"\"\n        return expr_obj.is_balanced()\n\ndef check_expression(expr: str) -> bool:\n    \"\"\"Checks if the given expression string has balanced brackets.\"\"\"\n    expression_instance = Expression(expr)\n    checker_instance = BalancedChecker()\n    return checker_instance.check(expression_instance)"}
