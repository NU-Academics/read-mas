{"task_id": "Mbpp/93", "solution": "def power(a, b):\n    \"\"\"\n    Calculates the value of 'a' to the power of 'b' using exponentiation by squaring.\n    Assumes 'b' is a non-negative integer.\n    \"\"\"\n    result = 1\n    base = a\n    exp = b\n    while exp > 0:\n        if exp % 2 == 1:\n            result *= base\n        base *= base\n        exp //= 2\n    return result"}
{"task_id": "Mbpp/94", "solution": "def index_minimum(tuples):\n    \"\"\"\n    Returns the first value of the tuple with the smallest second value.\n    Assumes the input list of tuples is not empty.\n    \"\"\"\n    min_value_tuple = tuples[0]\n    for current_tuple in tuples[1:]:\n        if current_tuple[1] < min_value_tuple[1]:\n            min_value_tuple = current_tuple\n    return min_value_tuple[0]"}
{"task_id": "Mbpp/95", "solution": "from typing import List\n\ndef Find_Min_Length(list_of_lists: List[List[int]]) -> int:\n    \"\"\"\n    Finds the length of the smallest sub-list in a list of lists.\n    Returns 0 if the input list or any sub-list is empty.\n    \"\"\"\n    if not list_of_lists:\n        return 0\n\n    min_length = float('inf')\n    for sublist in list_of_lists:\n        current_length = len(sublist)\n        if current_length == 0:\n            return 0  # Per design, return 0 if any sub-list is empty\n        if current_length < min_length:\n            min_length = current_length\n            \n    return int(min_length)"}
{"task_id": "Mbpp/96", "solution": "import math\n\ndef divisor(n: int) -> int:\n    \"\"\"\n    Finds the number of positive divisors for a given integer n.\n    The function counts 1 and n itself as divisors.\n    \"\"\"\n    count = 0\n    # Iterate from 1 up to the square root of n\n    for i in range(1, int(math.sqrt(n)) + 1):\n        if n % i == 0:\n            if i * i == n:\n                count += 1  # i is a perfect square root, count once\n            else:\n                count += 2  # i and n/i are two distinct divisors\n    return count"}
{"task_id": "Mbpp/99", "solution": "def decimal_to_binary(number: int) -> str:\n    \"\"\"\n    Convert a non-negative integer to its binary string representation\n    without leading zeros.\n    \"\"\"\n    if number == 0:\n        return '0'\n\n    bits = []\n    while number > 0:\n        bits.append(str(number % 2))\n        number //= 2\n    return ''.join(reversed(bits))"}
{"task_id": "Mbpp/100", "solution": "def next_smallest_palindrome(n: int) -> int:\n    \"\"\"\n    Finds the next smallest palindrome strictly greater than the input integer.\n    \"\"\"\n    s = str(n)\n    length = len(s)\n    mid = length // 2\n    left_half = list(s[:mid]) if length % 2 == 0 else list(s[:mid+1])\n\n    # Try to form a palindrome by mirroring the left half\n    def make_palindrome(current_left_half, is_odd_length):\n        if is_odd_length:\n            return \"\".join(current_left_half) + \"\".join(current_left_half[:-1][::-1])\n        else:\n            return \"\".join(current_left_half) + \"\".join(current_left_half[::-1])\n\n    is_odd = (length % 2 != 0)\n    \n    # First, try to make a palindrome with the current left_half\n    candidate_str = make_palindrome(left_half, is_odd)\n    candidate_int = int(candidate_str)\n\n    if candidate_int > n:\n        return candidate_int\n\n    # If not greater, or if the initial input was already a palindrome\n    # We need to increment the left half and propagate carry\n    i = len(left_half) - 1\n    carry = 1\n    while i >= 0 and carry > 0:\n        digit = int(left_half[i]) + carry\n        left_half[i] = str(digit % 10)\n        carry = digit // 10\n        i -= 1\n\n    if carry > 0:\n        # This means all 9s in the left half, e.g., 99 -> 101, 9 -> 11\n        # The new number will have an extra digit\n        if is_odd: # e.g., 9 -> 11 (left_half becomes '1'), 999 -> 1001 (left_half becomes '10')\n            return int('1' + '0' * (length - 1) + '1')\n        else: # e.g., 99 -> 101 (left_half becomes '10')\n            return int('1' + '0' * (length - 1) + '1')\n            \n    # Re-make the palindrome with the incremented left half\n    return int(make_palindrome(left_half, is_odd))"}
{"task_id": "Mbpp/98", "solution": "from typing import Iterable, Union\nimport math\n\nNumber = Union[int, float]\n\ndef multiply_num(sequence: Iterable[Number]) -> float:\n    \"\"\"\n    Multiplies all numbers in a list and divides the product by the list's length.\n    Raises ValueError if the input sequence is empty.\n    \"\"\"\n    seq_list = list(sequence)\n    if not seq_list:\n        raise ValueError(\"Input sequence must contain at least one number.\")\n    \n    product = math.prod(seq_list)\n    return product / len(seq_list)"}
