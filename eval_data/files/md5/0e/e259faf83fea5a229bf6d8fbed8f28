{"task_id": "Mbpp/111", "solution": "from typing import List, Set, Any\n\ndef common_in_nested_lists(nested_lists: List[List[Any]]) -> Set[Any]:\n    \"\"\"\n    Finds elements common to all lists within a nested list structure.\n    Returns an empty set if no common elements or if the input is empty.\n    \"\"\"\n    if not nested_lists:\n        return set()\n\n    # Initialize common_set with the elements of the first list\n    common_set = set(nested_lists[0])\n\n    # Intersect with subsequent lists\n    for inner_list in nested_lists[1:]:\n        common_set.intersection_update(set(inner_list))\n        if not common_set:  # Early exit if the common set becomes empty\n            break\n\n    return common_set"}
{"task_id": "Mbpp/109", "solution": "class BinaryString:\n    def __init__(self, value: str):\n        self.value = value\n        self.length = len(value)\n\n    def rotate(self, steps: int = 1) -> 'BinaryString':\n        \"\"\"Rotates the binary string to the left by the given number of steps.\"\"\"\n        steps %= self.length\n        rotated = self.value[steps:] + self.value[:steps]\n        return BinaryString(rotated)\n\n    def to_int(self) -> int:\n        \"\"\"Converts the binary string to its integer equivalent.\"\"\"\n        return int(self.value, 2)\n\n    def is_odd(self) -> bool:\n        \"\"\"Checks if the integer equivalent of the binary string is odd.\"\"\"\n        return self.to_int() % 2 == 1\n\n\ndef odd_Equivalent(binary_str: str, rotation_count: int) -> int:\n    \"\"\"\n    Counts how many left\u2011rotations of `binary_str` (up to `rotation_count`)\n    evaluate to odd integers.\n    \"\"\"\n    bs = BinaryString(binary_str)\n    odd_count = 0\n\n    for _ in range(rotation_count):\n        bs = bs.rotate(1)\n        if bs.is_odd():\n            odd_count += 1\n\n    return odd_count"}
{"task_id": "Mbpp/116", "solution": "def tuple_to_int(values: tuple[int, ...]) -> int:\n    \"\"\"Converts a tuple of positive integers into a single concatenated integer.\"\"\"\n    if not isinstance(values, tuple):\n        raise ValueError(\"Input must be a tuple.\")\n\n    result_str = []\n    for num in values:\n        if not isinstance(num, int) or num < 0:\n            raise ValueError(\"Tuple must contain only positive integers.\")\n        result_str.append(str(num))\n\n    if not result_str:\n        return 0 # Or handle as per specific requirement for empty tuple\n\n    return int(\"\".join(result_str))"}
