{"task_id": "Mbpp/635", "solution": "from typing import List\n\ndef heap_sort(input_list: List[int]) -> List[int]:\n    \"\"\"\n    Sorts a list of integers in ascending order using a heap sort algorithm.\n    The original input list is left unchanged.\n    \"\"\"\n    # Create a copy to avoid modifying the original list\n    data = input_list.copy()\n    n = len(data)\n\n    # Build a max-heap\n    for i in range(n // 2 - 1, -1, -1):\n        heapify(data, n, i)\n\n    # Extract elements from the heap one by one\n    for i in range(n - 1, 0, -1):\n        data[0], data[i] = data[i], data[0]  # swap\n        heapify(data, i, 0)\n\n    # The list is now in descending order; reverse it\n    return data[::-1]\n\ndef heapify(arr: List[int], n: int, i: int) -> None:\n    \"\"\"\n    Helper function to maintain the max-heap property.\n    \"\"\"\n    largest = i\n    left = 2 * i + 1\n    right = 2 * i + 2\n\n    if left < n and arr[left] > arr[largest]:\n        largest = left\n    if right < n and arr[right] > arr[largest]:\n        largest = right\n    if largest != i:\n        arr[i], arr[largest] = arr[largest], arr[i]\n        heapify(arr, n, largest)"}
{"task_id": "Mbpp/633", "solution": "from typing import List\n\ndef pair_xor_Sum(nums: List[int], size: int) -> int:\n    \"\"\"\n    Calculates the sum of XORs of all unique pairs of numbers in the given list.\n    The 'size' parameter is provided for context but not used for validation per specific constraints.\n    \"\"\"\n    n = len(nums)\n    if n < 2:\n        return 0\n\n    total_xor_sum = 0\n    for i in range(n):\n        for j in range(i + 1, n):\n            total_xor_sum += nums[i] ^ nums[j]\n\n    return total_xor_sum"}
{"task_id": "Mbpp/638", "solution": "import math\n\ndef wind_chill(velocity, temperature):\n    \"\"\"\n    Calculates the wind chill index rounded to the next integer using the Canadian Wind Chill Index formula.\n    The formula uses wind velocity in km/h and temperature in Celsius.\n    \"\"\"\n    # Calculate V^(1/6) term, which is crucial for the wind chill formula.\n    # For velocity = 0, math.pow(0, 1/6) is 0.0, which works correctly in the formula.\n    v_power_one_sixth = math.pow(velocity, 1/6)\n\n    # Apply the wind chill formula\n    wind_chill_raw = (13.12 +\n                      (0.6215 * temperature) -\n                      (11.37 * v_power_one_sixth) +\n                      (0.3965 * temperature * v_power_one_sixth))\n    \n    # Round the result up to the next integer\n    return math.ceil(wind_chill_raw)"}
{"task_id": "Mbpp/641", "solution": "def is_nonagonal(n: int) -> int:\n    \"\"\"\n    Calculates the nth nonagonal number.\n    Raises ValueError if n is less than 1.\n    \"\"\"\n    if n < 1:\n        raise ValueError(\"n must be a positive integer (n >= 1)\")\n    return n * (7 * n - 5) // 2"}
{"task_id": "Mbpp/639", "solution": "from typing import List\n\nclass Name:\n    \"\"\"Encapsulates a single name string and provides capitalization checks.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n\n    def starts_with_uppercase(self) -> bool:\n        \"\"\"Checks if the name starts with an uppercase letter.\"\"\"\n        return bool(self.value) and self.value[0].isupper()\n\nclass NameList:\n    \"\"\"Manages a collection of Name objects.\"\"\"\n    def __init__(self, names: List[str]):\n        \"\"\"Initializes NameList by converting input strings to Name objects.\"\"\"\n        self.names: List[Name] = [Name(name_str) for name_str in names]\n\nclass NameProcessor:\n    \"\"\"Processes a NameList to compute the sum of lengths based on capitalization.\"\"\"\n    def sum_lengths(self, name_list: NameList) -> int:\n        \"\"\"Sums the lengths of names that start with an uppercase letter from the given NameList.\"\"\"\n        total_length = 0\n        for name_obj in name_list.names:\n            if name_obj.starts_with_uppercase():\n                total_length += len(name_obj.value)\n        return total_length\n\ndef sample_nam(names: List[str]) -> int:\n    \"\"\"\n    Sums the lengths of names that start with an uppercase letter from a given list,\n    after removing names that start with a lowercase letter.\n    \"\"\"\n    name_list_instance = NameList(names)\n    name_processor = NameProcessor()\n    return name_processor.sum_lengths(name_list_instance)"}
