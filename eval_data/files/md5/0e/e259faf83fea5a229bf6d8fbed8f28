{"task_id": "Mbpp/757", "solution": "def count_reverse_pairs(strings: list[str]) -> int:\n    \"\"\"\n    Counts the unique pairs of reverse strings in the given list.\n    A pair is counted only once, regardless of order or duplicates in the input list.\n    \"\"\"\n    seen_strings = set(strings)\n    counted_pairs = set()\n    pairs_count = 0\n\n    for s in strings:\n        reverse_s = s[::-1]\n        \n        # Check if the reverse string exists and is not the same string (to avoid self-pairing palindromes)\n        if reverse_s in seen_strings and s != reverse_s:\n            # Create a canonical representation for the pair to ensure uniqueness (e.g., (\"a\", \"b\") is same as (\"b\", \"a\"))\n            canonical_pair = tuple(sorted((s, reverse_s)))\n            \n            if canonical_pair not in counted_pairs:\n                pairs_count += 1\n                counted_pairs.add(canonical_pair)\n                \n    return pairs_count"}
{"task_id": "Mbpp/758", "solution": "from typing import Any, Dict, List, Tuple\n\ndef unique_sublists(input_list: List[List[Any]]) -> Dict[Tuple[Any, ...], int]:\n    \"\"\"\n    Counts occurrences of each unique sublist within a list of lists, returning a dictionary of tuple-counts.\n    Each sublist is converted to a tuple to serve as a dictionary key.\n    \"\"\"\n    count_map: Dict[Tuple[Any, ...], int] = {}\n    for sublist in input_list:\n        key = tuple(sublist)\n        count_map[key] = count_map.get(key, 0) + 1\n    return count_map"}
