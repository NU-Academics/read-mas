{"task_id": "Mbpp/141", "solution": "from typing import List\n\ndef pancake_sort(list: List) -> List:\n    \"\"\"Sorts a list of comparable elements using the pancake sorting algorithm.\"\"\"\n    n = len(list)\n    if n <= 1:\n        return list(list)\n\n    arr = list(list) # Create a mutable copy of the input list for in-place sorting\n\n    def _flip(sub_arr, k):\n        \"\"\"Reverses the order of elements in sub_arr from index 0 up to k (inclusive).\"\"\"\n        left = 0\n        right = k\n        while left < right:\n            sub_arr[left], sub_arr[right] = sub_arr[right], sub_arr[left]\n            left += 1\n            right -= 1\n\n    # Iterate from the full list size down to 2\n    for curr_size in range(n, 1, -1):\n        # Find the index of the maximum element in the current unsorted portion (arr[0...curr_size-1])\n        max_idx = 0\n        for i in range(1, curr_size):\n            if arr[i] > arr[max_idx]:\n                max_idx = i\n\n        # If the maximum element is not already at the end of the current unsorted portion\n        if max_idx != curr_size - 1:\n            # First flip: bring the maximum element to the front of the unsorted portion\n            _flip(arr, max_idx)\n            # Second flip: move the maximum element to its correct final sorted position\n            _flip(arr, curr_size - 1)\n\n    return arr"}
{"task_id": "Mbpp/142", "solution": "def count_samepair(list1, list2, list3):\n    \"\"\"\n    Counts the number of positions where all three input lists contain identical items.\n    Raises ValueError if the input lists are not of equal length.\n    \"\"\"\n    if not (len(list1) == len(list2) == len(list3)):\n        raise ValueError(\"All input lists must have the same length.\")\n\n    count = 0\n    for a, b, c in zip(list1, list2, list3):\n        if a == b == c:\n            count += 1\n    return count"}
{"task_id": "Mbpp/160", "solution": "from typing import Optional, Tuple\n\ndef find_solution(a: int, b: int, n: int) -> Optional[Tuple[int, int]]:\n    \"\"\"Return (x, y) solving a*x + b*y = n or None if impossible.\"\"\"\n    def _extended_gcd(a_val: int, b_val: int) -> Tuple[int, int, int]:\n        \"\"\"Return (gcd, x, y) such that a_val*x + b_val*y == gcd.\"\"\"\n        if b_val == 0:\n            return (a_val, 1, 0)\n        gcd, x1, y1 = _extended_gcd(b_val, a_val % b_val)\n        return (gcd, y1, x1 - (a_val // b_val) * y1)\n\n    gcd, x0, y0 = _extended_gcd(a, b)\n    if n % gcd != 0:\n        return None\n    factor = n // gcd\n    return (x0 * factor, y0 * factor)"}
{"task_id": "Mbpp/145", "solution": "def max_Abs_Diff(data):\n    \"\"\"\n    Calculates the maximum difference between any two elements in a given tuple.\n    This is achieved by finding the maximum and minimum elements and subtracting them.\n    \"\"\"\n    if not data:\n        return 0  # Or handle as an error, but for this problem context, 0 might be acceptable for an empty set.\n\n    max_val = data[0]\n    min_val = data[0]\n\n    for x in data:\n        if x > max_val:\n            max_val = x\n        if x < min_val:\n            min_val = x\n            \n    return max_val - min_val"}
{"task_id": "Mbpp/162", "solution": "def sum_series(n: int) -> int:\n    \"\"\"\n    Calculates the sum of the series (n - 2*i) for i from 0 to n // 2.\n    For instance, sum_series(6) calculates 6 + 4 + 2 + 0, which equals 12.\n    \"\"\"\n    total_sum = 0\n    # The loop iterates for i from 0 up to n // 2, inclusive.\n    # range(stop) generates numbers up to stop-1, so we use n // 2 + 1.\n    for i in range(n // 2 + 1):\n        term = n - 2 * i\n        total_sum += term\n    return total_sum"}
