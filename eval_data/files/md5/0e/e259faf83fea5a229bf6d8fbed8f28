{"task_id": "Mbpp/743", "solution": "from typing import List\n\ndef rotate_right(lst: List[int], n: int) -> List[int]:\n    \"\"\"\n    Rotates a list to the right by n positions, returning a new list.\n    Handles n values greater than the list length by using modulo.\n    \"\"\"\n    if not lst:\n        return []\n    \n    length = len(lst)\n    # Calculate effective rotation amount to handle n > length\n    effective_n = n % length\n    \n    # Split the list into two parts and concatenate them in reverse order\n    return lst[length - effective_n:] + lst[:length - effective_n]"}
{"task_id": "Mbpp/748", "solution": "def capital_words_spaces(input_str: str) -> str:\n    \"\"\"\n    Inserts spaces before words starting with capital letters in a given string.\n    \"\"\"\n    if not input_str:\n        return \"\"\n\n    result_chars = []\n    for i, char in enumerate(input_str):\n        if i > 0 and char.isupper():\n            if input_str[i-1].islower():\n                result_chars.append(' ')\n            elif i + 1 < len(input_str) and input_str[i-1].isupper() and input_str[i+1].islower():\n                result_chars.append(' ')\n        result_chars.append(char)\n    return \"\".join(result_chars)"}
{"task_id": "Mbpp/745", "solution": "from __future__ import annotations\nfrom typing import List\n\ndef divisible_by_digits(startnum: int, endnum: int) -> List[int]:\n    \"\"\"\n    Return a sorted list of integers within [startnum, endnum] that are divisible\n    by each of their non\u2011zero digits and contain no zero digit.\n    \"\"\"\n    _validate_inputs(startnum, endnum)\n    result: List[int] = []\n\n    for n in range(startnum, endnum + 1):\n        digits = _extract_digits(n)\n        if 0 in digits:\n            continue\n        if _is_divisible_by_all_digits(n, digits):\n            result.append(n)\n\n    return sorted(result)\n\n\ndef _validate_inputs(startnum: int, endnum: int) -> None:\n    \"\"\"Validate input range and values.\"\"\"\n    if startnum <= 0 or endnum <= 0:\n        raise ValueError(\"Both startnum and endnum must be positive integers.\")\n    if startnum > endnum:\n        raise ValueError(\"startnum must be less than or equal to endnum.\")\n\n\ndef _extract_digits(n: int) -> List[int]:\n    \"\"\"Return a list of decimal digits of n.\"\"\"\n    return [int(d) for d in str(n)]\n\n\ndef _is_divisible_by_all_digits(n: int, digits: List[int]) -> bool:\n    \"\"\"Check that n is divisible by each non\u2011zero digit in digits.\"\"\"\n    return all(n % d == 0 for d in digits if d != 0)"}
