{"task_id": "Mbpp/784", "solution": "def _is_even(number: int) -> bool:\n    \"\"\"Checks if a number is even.\"\"\"\n    return number % 2 == 0\n\ndef _is_odd(number: int) -> bool:\n    \"\"\"Checks if a number is odd.\"\"\"\n    return number % 2 != 0\n\ndef _find_first_even(numbers: list[int]) -> int | None:\n    \"\"\"Finds the first even number in a list, returning None if not found.\"\"\"\n    for num in numbers:\n        if _is_even(num):\n            return num\n    return None\n\ndef _find_first_odd(numbers: list[int]) -> int | None:\n    \"\"\"Finds the first odd number in a list, returning None if not found.\"\"\"\n    for num in numbers:\n        if _is_odd(num):\n            return num\n    return None\n\ndef mul_even_odd(numbers: list[int]) -> int | None:\n    \"\"\"\n    Finds the product of the first even and first odd number in a given list.\n    Returns None if either number is not found in the list.\n    \"\"\"\n    first_odd = _find_first_odd(numbers)\n    if first_odd is None:\n        return None\n\n    first_even = _find_first_even(numbers)\n    if first_even is None:\n        return None\n\n    return first_odd * first_even"}
{"task_id": "Mbpp/790", "solution": "def even_position(numbers: list) -> bool:\n    \"\"\"\n    Checks if every number at an even index in the input list is an even number.\n    Returns False immediately if an odd number is found at an even index.\n    \"\"\"\n    for i in range(0, len(numbers), 2):\n        if numbers[i] % 2 != 0:\n            return False\n    return True"}
{"task_id": "Mbpp/786", "solution": "def right_insertion(sorted_list: list[float | int], value: float | int) -> int:\n    \"\"\"\n    Locates the right insertion point for a specified value in sorted order.\n    Returns the index where the value should be inserted to maintain sorted order.\n    \"\"\"\n    low = 0\n    high = len(sorted_list)\n\n    while low < high:\n        mid = (low + high) // 2\n        if sorted_list[mid] <= value:\n            low = mid + 1\n        else:\n            high = mid\n    return low"}
{"task_id": "Mbpp/785", "solution": "def tuple_str_int(tuple_str: str) -> tuple[int, ...]:\n    \"\"\"\n    Converts a string representation of an integer tuple to an actual integer tuple.\n\n    Args:\n        tuple_str: The input string representing a tuple of integers (e.g., \"(7, 8, 9)\").\n    \"\"\"\n    cleaned_str = tuple_str.strip().strip('()')\n    if not cleaned_str:\n        return ()\n\n    str_elements = [s.strip() for s in cleaned_str.split(',')]\n\n    int_elements = []\n    for s_elem in str_elements:\n        try:\n            int_elements.append(int(s_elem))\n        except ValueError as e:\n            raise ValueError(f\"Invalid integer element '{s_elem}' in tuple string: {tuple_str}\") from e\n\n    return tuple(int_elements)"}
{"task_id": "Mbpp/793", "solution": "def last(array: list, element: any) -> int:\n    \"\"\"\n    Finds the last (highest) position of an element in a sorted array using binary search.\n    Returns -1 if the element is not found.\n    \"\"\"\n    low = 0\n    high = len(array) - 1\n    result = -1\n\n    while low <= high:\n        mid = low + (high - low) // 2\n        if array[mid] == element:\n            result = mid\n            low = mid + 1  # Try to find a further occurrence in the right half\n        elif array[mid] < element:\n            low = mid + 1\n        else:\n            high = mid - 1\n    return result"}
