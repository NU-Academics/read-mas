{"task_id": "Mbpp/305", "solution": "def start_withp(input_list: list[str]) -> tuple[str, str]:\n    \"\"\"Takes a list of strings, extracts words, filters for 'p'/'P' words,\n    and returns the first two identified words as a tuple.\n    \"\"\"\n    \n    def _extract_words_from_string(text: str) -> list[str]:\n        \"\"\"Splits a string into a list of words based on whitespace.\"\"\"\n        return text.split()\n\n    def _is_p_word(word: str) -> bool:\n        \"\"\"Checks if a word starts with 'p' or 'P' case-insensitively.\"\"\"\n        return word.lower().startswith('p')\n\n    found_p_words = []\n    for text_string in input_list:\n        words = _extract_words_from_string(text_string)\n        for word in words:\n            if _is_p_word(word):\n                found_p_words.append(word)\n                if len(found_p_words) == 2:\n                    return tuple(found_p_words)\n    # The requirement and test case imply exactly two words are expected.\n    # If fewer than two are found, this part of the code would be reached.\n    # Based on the assert, we always expect two.\n    return tuple(found_p_words)"}
{"task_id": "Mbpp/306", "solution": "from typing import List\n\ndef max_sum_increasing_subseq(arr: List[int], n: int, i: int, k: int) -> int:\n    \"\"\"\n    Calculates the maximum sum of an increasing subsequence from arr[0...i]\n    that includes arr[k], where k > i.\n    \"\"\"\n    if not (0 <= i < n and 0 <= k < n):\n        raise ValueError(\"Indices i or k are out of array bounds.\")\n    if k <= i:\n        raise ValueError(\"Index k must be strictly greater than index i.\")\n\n    # dp[j] stores the maximum sum of an increasing subsequence ending at arr[j]\n    # using elements from arr[0...j].\n    dp = [0] * (i + 1)\n\n    for current_idx in range(i + 1):\n        dp[current_idx] = arr[current_idx]\n        for prev_idx in range(current_idx):\n            if arr[current_idx] > arr[prev_idx]:\n                dp[current_idx] = max(dp[current_idx], dp[prev_idx] + arr[current_idx])\n\n    # Find the maximum sum of an increasing subsequence from arr[0...i] that can precede arr[k].\n    max_prefix_sum_before_k = 0\n    for j in range(i + 1):\n        if arr[j] < arr[k]:\n            max_prefix_sum_before_k = max(max_prefix_sum_before_k, dp[j])\n\n    return max_prefix_sum_before_k + arr[k]"}
{"task_id": "Mbpp/308", "solution": "from typing import List, Union\n\ndef large_product(list1: List[Union[int, float]], list2: List[Union[int, float]], k: int) -> List[Union[int, float]]:\n    \"\"\"\n    Finds the specified number of largest products from two given lists.\n    It selects one factor from each list and returns the top k products.\n    \"\"\"\n    all_products = []\n    for num1 in list1:\n        for num2 in list2:\n            all_products.append(num1 * num2)\n\n    all_products.sort(reverse=True)\n    return all_products[:k]"}
