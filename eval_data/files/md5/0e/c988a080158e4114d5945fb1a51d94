{"task_id": "Mbpp/65", "solution": "def recursive_list_sum(input_list: list) -> int | float:\n    \"\"\"\n    Recursively flattens a nested list and sums all numerical elements.\n    \"\"\"\n    total_sum = 0\n    for element in input_list:\n        if isinstance(element, list):\n            total_sum += recursive_list_sum(element)\n        elif isinstance(element, (int, float)):\n            total_sum += element\n    return total_sum"}
{"task_id": "Mbpp/68", "solution": "def is_Monotonic(array: list) -> bool:\n    \"\"\"\n    Checks if an array is monotonic (either non-decreasing or non-increasing).\n    Handles empty or single-element arrays as monotonic.\n    \"\"\"\n\n    def _is_non_decreasing(arr: list) -> bool:\n        \"\"\"Checks if the array is non-decreasing.\"\"\"\n        for i in range(len(arr) - 1):\n            if arr[i] > arr[i+1]:\n                return False\n        return True\n\n    def _is_non_increasing(arr: list) -> bool:\n        \"\"\"Checks if the array is non-increasing.\"\"\"\n        for i in range(len(arr) - 1):\n            if arr[i] < arr[i+1]:\n                return False\n        return True\n\n    if len(array) <= 1:\n        return True\n\n    return _is_non_decreasing(array) or _is_non_increasing(array)"}
