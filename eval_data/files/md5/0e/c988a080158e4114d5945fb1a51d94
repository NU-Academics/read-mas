{"task_id": "Mbpp/724", "solution": "def power_base_sum(base: int, power: int) -> int:\n    \"\"\"\n    Calculates the sum of all digits of the base to the specified power.\n    It orchestrates the exponentiation and subsequent digit summation.\n    \"\"\"\n    def _calculate_power(base: int, power: int) -> str:\n        \"\"\"\n        Computes base^power and returns the result as a string.\n        This handles arbitrarily large numbers generated by exponentiation.\n        \"\"\"\n        return str(base ** power)\n\n    def _sum_digits(number_str: str) -> int:\n        \"\"\"\n        Takes a string representation of a number and sums its individual digits.\n        \"\"\"\n        total_sum = 0\n        for digit_char in number_str:\n            total_sum += int(digit_char)\n        return total_sum\n\n    # Orchestrate the calculation\n    result_number_str = _calculate_power(base, power)\n    sum_of_digits = _sum_digits(result_number_str)\n    return sum_of_digits"}
{"task_id": "Mbpp/721", "solution": "from typing import List\n\ndef maxAverageOfPath(matrix_data: List[List[float]]) -> float:\n    \"\"\"\n    Finds a path from top-left to bottom-right with the maximum average cost,\n    moving only right or down.\n    \"\"\"\n\n    class Cell:\n        \"\"\"Represents a single cell in the matrix with its coordinates and cost.\"\"\"\n        def __init__(self, row: int, col: int, cost: float):\n            self.row = row\n            self.col = col\n            self.cost = cost\n\n    class Matrix:\n        \"\"\"Manages the grid of cells and provides access to them.\"\"\"\n        def __init__(self, data: List[List[float]]):\n            self.N = len(data)\n            self._cells: List[List[Cell]] = []\n            for r_idx, row_data in enumerate(data):\n                cell_row = []\n                for c_idx, cost_val in enumerate(row_data):\n                    cell_row.append(Cell(r_idx, c_idx, float(cost_val)))\n                self._cells.append(cell_row)\n\n        def get_cell(self, row: int, col: int) -> Cell:\n            \"\"\"Returns the Cell at the specified coordinates.\"\"\"\n            return self._cells[row][col]\n\n    class Path:\n        \"\"\"Represents a sequence of cells forming a valid path and calculates its metrics.\"\"\"\n        def __init__(self, cells: List[Cell]):\n            self.cells = cells\n            self.total_cost = sum(cell.cost for cell in cells)\n            self.number_of_cells = len(cells)\n            self.average_cost = self.calculate_average()\n\n        def calculate_average(self) -> float:\n            \"\"\"Computes and returns the average cost.\"\"\"\n            if self.number_of_cells == 0:\n                return 0.0\n            return self.total_cost / self.number_of_cells\n\n    matrix_obj = Matrix(matrix_data)\n    all_paths: List[Path] = []\n\n    def _find_all_paths_recursive(\n        row: int,\n        col: int,\n        current_path_cells: List[Cell]\n    ) -> None:\n        \"\"\"Recursively explores all valid paths from a given cell to the bottom-right.\"\"\"\n        current_path_cells.append(matrix_obj.get_cell(row, col))\n\n        if row == matrix_obj.N - 1 and col == matrix_obj.N - 1:\n            all_paths.append(Path(list(current_path_cells)))\n            current_path_cells.pop()\n            return\n\n        if col + 1 < matrix_obj.N:\n            _find_all_paths_recursive(row, col + 1, current_path_cells)\n\n        if row + 1 < matrix_obj.N:\n            _find_all_paths_recursive(row + 1, col, current_path_cells)\n\n        current_path_cells.pop()\n\n    _find_all_paths_recursive(0, 0, [])\n\n    if not all_paths:\n        return 0.0\n\n    max_average = -float('inf')\n    for path in all_paths:\n        if path.average_cost > max_average:\n            max_average = path.average_cost\n\n    return max_average"}
