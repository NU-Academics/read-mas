{"task_id": "Mbpp/140", "solution": "from typing import Iterable, Set, Union\n\ndef extract_singly(nested_collections: Iterable[Iterable[Union[int, float]]]) -> Set[Union[int, float]]:\n    \"\"\"\n    Flattens a collection of nested iterables into a set of unique numbers.\n\n    Args:\n        nested_collections: An iterable where each element is itself an iterable\n                            containing numbers (int or float).\n\n    Returns:\n        A set containing all unique numbers extracted from the input.\n    \"\"\"\n    unique_numbers = set()\n    for inner_collection in nested_collections:\n        for number in inner_collection:\n            unique_numbers.add(number)\n    return unique_numbers"}
{"task_id": "Mbpp/141", "solution": "def pancake_sort(arr: list) -> list:\n    \"\"\"\n    Sorts a list of comparable elements in ascending order using the pancake sort algorithm.\n    The original list is not modified.\n    \"\"\"\n    n = len(arr)\n    if n <= 1:\n        return list(arr)\n\n    current_arr = list(arr)\n\n    for curr_size in range(n, 1, -1):\n        max_idx = current_arr.index(max(current_arr[:curr_size]))\n\n        if max_idx != curr_size - 1:\n            current_arr[:max_idx+1] = current_arr[:max_idx+1][::-1]\n            current_arr[:curr_size] = current_arr[:curr_size][::-1]\n\n    return current_arr"}
{"task_id": "Mbpp/142", "solution": "def count_samepair(list1: list, list2: list, list3: list) -> int:\n    \"\"\"\n    Counts the number of positions where elements are identical across three input lists.\n    Compares elements up to the length of the shortest list.\n    \"\"\"\n    min_length = min(len(list1), len(list2), len(list3))\n    identical_count = 0\n    for i in range(min_length):\n        if list1[i] == list2[i] and list2[i] == list3[i]:\n            identical_count += 1\n    return identical_count"}
{"task_id": "Mbpp/145", "solution": "def max_Abs_Diff(arr: tuple) -> int:\n    \"\"\"\n    Calculates the maximum absolute difference between any two elements in the input array.\n    Returns 0 if the array has less than two elements.\n    \"\"\"\n    if not arr or len(arr) < 2:\n        return 0\n    min_val = min(arr)\n    max_val = max(arr)\n    return abs(max_val - min_val)"}
{"task_id": "Mbpp/160", "solution": "import math\nfrom typing import Optional, Tuple\n\ndef find_solution(a: int, b: int, n: int) -> Optional[Tuple[int, int]]:\n    \"\"\"\n    Returns integers x and y that satisfy ax + by = n as a tuple, or None if no solution exists.\n    Uses the Extended Euclidean Algorithm to find a particular solution.\n    \"\"\"\n    def extended_gcd(a: int, b: int) -> Tuple[int, int, int]:\n        \"\"\"\n        Implements the Extended Euclidean Algorithm: returns (g, x, y) such that ax + by = g = gcd(a, b).\n        \"\"\"\n        if a == 0:\n            return (b, 0, 1)\n        \n        g, x1, y1 = extended_gcd(b % a, a)\n        x = y1 - (b // a) * x1\n        y = x1\n        return (g, x, y)\n\n    # Handle special cases where a or b are zero\n    if a == 0 and b == 0:\n        if n == 0:\n            return (0, 0) # Any (x, y) works, (0,0) is a simple one\n        else:\n            return None # 0x + 0y = n, where n != 0, has no solution\n\n    # If only one coefficient is zero\n    if a == 0:\n        if n % b == 0:\n            return (0, n // b)\n        else:\n            return None\n    if b == 0:\n        if n % a == 0:\n            return (n // a, 0)\n        else:\n            return None\n\n    # General case using Extended Euclidean Algorithm\n    g, x_p, y_p = extended_gcd(a, b)\n\n    if n % g != 0:\n        return None # No integer solution exists if n is not divisible by gcd(a, b)\n\n    # Calculate particular solution\n    factor = n // g\n    x0 = x_p * factor\n    y0 = y_p * factor\n\n    return (x0, y0)"}
{"task_id": "Mbpp/161", "solution": "def remove_elements(primary_list: list, elements_to_remove_list: list) -> list:\n    \"\"\"\n    Removes all elements from primary_list that are present in elements_to_remove_list.\n    Returns a new list, preserving the order of remaining elements.\n    \"\"\"\n    removal_set = set(elements_to_remove_list)\n    resultant_list = []\n    for element in primary_list:\n        if element not in removal_set:\n            resultant_list.append(element)\n    return resultant_list"}
{"task_id": "Mbpp/166", "solution": "```python\ndef find_even_pair(integer_list: list[int]) -> int:\n    \"\"\"\n    Counts the number of unique pairs of integers in the input list\n    that XOR to an even number.\n    \"\"\"\n    count_even = 0\n    count_odd = 0\n\n    for num in integer_list:\n        if num % 2 == 0:\n            count_even += 1\n        else:\n            count_odd += 1\n\n    # XOR of two integers is even if both have the same parity.\n    # Calculate combinations for (even, even) and (odd, odd) pairs.\n    pairs_even_xor = (count_even * (count_even - 1) // 2) + \\\n                     (count_odd * (count_odd - 1) // 2)\n\n    return pairs_even_xor\n```"}
{"task_id": "Mbpp/167", "solution": "def next_power_of_2(n: int) -> int:\n    \"\"\"\n    Finds the smallest power of 2 greater than or equal to n.\n    Handles the special case where n is 0 by returning 1.\n    \"\"\"\n    if n == 0:\n        return 1\n\n    power = 1\n    # Repeatedly double 'power' until it is greater than or equal to n.\n    while power < n:\n        power *= 2\n    return power"}
{"task_id": "Mbpp/162", "solution": "class SeriesCalculator:\n    \"\"\"Encapsulates the logic for calculating the sum of a specific series.\"\"\"\n\n    def calculateSum(self, n: int) -> int:\n        \"\"\"\n        Calculates the sum of the series (n - 2*i) for i from 0 to n // 2.\n        \"\"\"\n        total_sum = 0\n        for i in range((n // 2) + 1):\n            term = n - (2 * i)\n            total_sum += term\n        return total_sum\n\ndef sum_series(n: int) -> int:\n    \"\"\"\n    Calculates the sum of the series (n - 2*i) from i=0 to n // 2.\n    \"\"\"\n    calculator = SeriesCalculator()\n    return calculator.calculateSum(n)"}
{"task_id": "Mbpp/165", "solution": "def count_char_position(input_string: str) -> int:\n    \"\"\"\n    Counts characters whose 0-based string index matches their 0-based alphabet position (case-insensitive).\n    Non-alphabetic characters are ignored.\n    \"\"\"\n    def _is_alphabetic(char: str) -> bool:\n        \"\"\"Determines if a given character is an English alphabetic character.\"\"\"\n        return char.isalpha()\n\n    def _get_alphabet_position(char: str) -> int:\n        \"\"\"Calculates the 0-based alphabet position of a lowercase alphabetic character.\"\"\"\n        return ord(char) - ord('a')\n\n    count = 0\n    for index, char in enumerate(input_string):\n        if _is_alphabetic(char):\n            lower_char = char.lower()\n            alphabet_position = _get_alphabet_position(lower_char)\n            if index == alphabet_position:\n                count += 1\n    return count"}
