{"task_id": "Mbpp/726", "solution": "def multiply_elements(input_tuple: tuple) -> tuple:\n    \"\"\"\n    Takes a tuple of numbers (t_1,...,t_{N+1}) and returns a tuple of length N\n    where the i-th element of the tuple is equal to t_i * t_{i+1}.\n    \"\"\"\n    if len(input_tuple) < 2:\n        return ()\n\n    results = []\n    for i in range(len(input_tuple) - 1):\n        results.append(input_tuple[i] * input_tuple[i+1])\n    return tuple(results)"}
{"task_id": "Mbpp/728", "solution": "def sum_list(list_a: list[float | int], list_b: list[float | int]) -> list[float | int]:\n    \"\"\"\n    Calculates the element-wise sum of two input lists of numbers and returns a new list.\n    Performs validation for argument types, element types, and list lengths.\n    \"\"\"\n    if not isinstance(list_a, list) or not isinstance(list_b, list):\n        raise ValueError(\"Inputs must be lists\")\n\n    if len(list_a) != len(list_b):\n        raise ValueError(\"Input lists must have the same length\")\n\n    result_list = []\n    for i in range(len(list_a)):\n        val_a = list_a[i]\n        val_b = list_b[i]\n\n        if not isinstance(val_a, (int, float)) or not isinstance(val_b, (int, float)):\n            raise ValueError(\"List elements must be numbers\")\n            \n        result_list.append(val_a + val_b)\n    return result_list"}
{"task_id": "Mbpp/730", "solution": "def consecutive_duplicates(input_list):\n    \"\"\"\n    Removes consecutive duplicates from a list, preserving the order of unique elements.\n    Returns a new list with no consecutive duplicates.\n    \"\"\"\n    if not input_list:\n        return []\n\n    result = [input_list[0]]\n    for item in input_list[1:]:\n        if item != result[-1]:\n            result.append(item)\n    return result"}
{"task_id": "Mbpp/734", "solution": "from typing import List\n\ndef sum_Of_Subarray_Prod(input_list: List[int]) -> int:\n    \"\"\"\n    Calculates the sum of products of all possible contiguous sublists for a given list of integers.\n    The final result is the sum of products of all possible sublists.\n    \"\"\"\n    total_sum_of_products = 0\n    n = len(input_list)\n\n    if n == 0:\n        return 0\n\n    for i in range(n):\n        current_product = 1\n        for j in range(i, n):\n            current_product *= input_list[j]\n            total_sum_of_products += current_product\n\n    return total_sum_of_products"}
{"task_id": "Mbpp/731", "solution": "import math\n\ndef lateralsurface_cone(r, h):\n    \"\"\"Calculates the lateral surface area of a cone.\n    Uses the formulas for slant height (l = sqrt(r^2 + h^2)) and lateral surface area (\u03c0 * r * l).\"\"\"\n    slant_height = math.sqrt(r**2 + h**2)\n    lateral_surface_area = math.pi * r * slant_height\n    return lateral_surface_area"}
{"task_id": "Mbpp/732", "solution": "def replace_special_char(input_string: str) -> str:\n    \"\"\"\n    Replaces all occurrences of spaces, commas, or dots with a colon in the input string.\n    This uses a simple iterative replacement, which is clear and efficient for a small, fixed set of characters.\n    \"\"\"\n    modified_string = input_string.replace(' ', ':')\n    modified_string = modified_string.replace(',', ':')\n    modified_string = modified_string.replace('.', ':')\n    return modified_string"}
{"task_id": "Mbpp/736", "solution": "def left_insertion(sorted_list: list[float | int], value: float | int) -> int:\n    \"\"\"\n    Locates the left insertion point for a specified value in a sorted list using binary search.\n    This function returns the index 'i' where 'value' could be inserted to maintain sorted order,\n    such that all elements before 'i' are strictly less than 'value'.\n    \"\"\"\n    low = 0\n    high = len(sorted_list)\n    while low < high:\n        mid = (low + high) // 2\n        if sorted_list[mid] < value:\n            low = mid + 1\n        else:\n            high = mid\n    return low"}
{"task_id": "Mbpp/733", "solution": "def find_first_occurrence(arr: list[int], target: int) -> int:\n    \"\"\"\n    Finds the index of the first occurrence of a target number in a sorted array using binary search.\n    Returns -1 if the target is not found.\n    \"\"\"\n    low = 0\n    high = len(arr) - 1\n    result = -1\n\n    while low <= high:\n        mid = low + (high - low) // 2\n        if arr[mid] == target:\n            result = mid\n            high = mid - 1  # Move left to find the first occurrence\n        elif arr[mid] < target:\n            low = mid + 1\n        else:\n            high = mid - 1\n    return result"}
{"task_id": "Mbpp/735", "solution": "def toggle_middle_bits(number: int) -> int:\n    \"\"\"Toggles all bits of the number except the first and the last set bit.\n    Handles positive integers; returns 0 if the input is 0.\n    \"\"\"\n    if number == 0:\n        return 0\n\n    # Determine the position of the Most Significant Bit (MSB)\n    # bit_length() returns the number of bits required to represent the integer,\n    # so msb_pos is (bit_length - 1) for 0-indexed positions.\n    msb_pos = number.bit_length() - 1\n\n    # Determine the position of the Least Significant Bit (LSB)\n    # The expression (number & -number) isolates the LSB.\n    # For example, if number = 9 (0b1001), then -number in 2's complement implies its lowest bit is 1.\n    # 9 & -9 results in 1 (0b0001). Then bit_length() - 1 gives 0.\n    lsb_isolated = number & -number\n    lsb_pos = lsb_isolated.bit_length() - 1\n\n    # Initialize mask for bits to toggle\n    mask = 0\n\n    # There are middle bits to toggle only if msb_pos is at least 2 positions\n    # greater than lsb_pos (e.g., if LSB=0, MSB=2, then bit 1 is in the middle).\n    if msb_pos > lsb_pos + 1:\n        # The range of bits to toggle is from (lsb_pos + 1) to (msb_pos - 1) inclusive.\n        start_bit_for_mask = lsb_pos + 1\n        end_bit_for_mask = msb_pos - 1\n\n        # Construct a mask with '1's in the middle bit range.\n        # (1 << (end_bit_for_mask + 1)) - 1 creates a sequence of ones from bit 0 to end_bit_for_mask.\n        # (1 << start_bit_for_mask) - 1 creates a sequence of ones from bit 0 to (start_bit_for_mask - 1).\n        # XORing them leaves '1's only in the range [start_bit_for_mask, end_bit_for_mask].\n        mask = ((1 << (end_bit_for_mask + 1)) - 1) ^ ((1 << start_bit_for_mask) - 1)\n\n    # Apply the mask using XOR to toggle the middle bits.\n    return number ^ mask"}
{"task_id": "Mbpp/737", "solution": "import re\n\ndef check_str(input_string: str) -> bool:\n    \"\"\"\n    Checks if the given string starts with a vowel (a, e, i, o, u), case-insensitive, using regex.\n    Returns True if the string starts with a vowel, False otherwise.\n    \"\"\"\n    if not input_string:\n        return False\n\n    pattern = r\"^[aeiou]\"\n    return bool(re.match(pattern, input_string, re.IGNORECASE))"}
{"task_id": "Mbpp/740", "solution": "def tuple_to_dict(input_tuple: tuple) -> dict:\n    \"\"\"Converts a tuple to a key-value dictionary using adjacent elements.\n\n    Initializes an empty dictionary and populates it by taking elements at even indices as keys\n    and elements at odd indices as their corresponding values from the input tuple.\n    \"\"\"\n    result_dict = {}\n    for i in range(0, len(input_tuple) - 1, 2):\n        result_dict[input_tuple[i]] = input_tuple[i + 1]\n    return result_dict"}
{"task_id": "Mbpp/739", "solution": "import math\n\nclass TriangularNumber:\n    \"\"\"Represents a triangular number, its index, value, and number of digits.\"\"\"\n\n    def __init__(self, k: int):\n        \"\"\"\n        Initializes a TriangularNumber object for a given index k.\n        Calculates its value and number of digits upon creation.\n        \"\"\"\n        if not isinstance(k, int) or k <= 0:\n            raise ValueError(\"Index k must be a positive integer.\")\n\n        self._index = k\n        self._value = self._calculate_value(k)\n        self._number_of_digits = self._get_number_of_digits(self._value)\n\n    def _calculate_value(self, k: int) -> int:\n        \"\"\"Calculates the triangular number T_k = k * (k + 1) / 2.\"\"\"\n        return k * (k + 1) // 2\n\n    def _get_number_of_digits(self, value: int) -> int:\n        \"\"\"Determines the number of digits of a positive integer X.\"\"\"\n        if value <= 0:\n            return 1 if value == 0 else 0\n        return int(math.floor(math.log10(value))) + 1\n\n    def get_index(self) -> int:\n        \"\"\"Returns the index k of the triangular number.\"\"\"\n        return self._index\n\n    def get_value(self) -> int:\n        \"\"\"Returns the calculated value T_k of the triangular number.\"\"\"\n        return self._value\n\n    def get_number_of_digits(self) -> int:\n        \"\"\"Returns the number of digits of the triangular number's value.\"\"\"\n        return self._number_of_digits\n\ndef find_Index(n: int) -> int:\n    \"\"\"\n    Finds the index of the smallest triangular number with exactly n digits.\n    The loop iteratively calculates triangular numbers until one with 'n' digits is found.\n    \"\"\"\n    k = 1\n    current_triangular = TriangularNumber(k)\n    current_digits = current_triangular.get_number_of_digits()\n\n    while current_digits < n:\n        k += 1\n        current_triangular = TriangularNumber(k)\n        current_digits = current_triangular.get_number_of_digits()\n\n    return k"}
{"task_id": "Mbpp/741", "solution": "def all_Characters_Same(input_string: str) -> bool:\n    \"\"\"\n    Checks if all characters in the input string are identical.\n    Handles empty and single-character strings as uniformly identical.\n    \"\"\"\n    if len(input_string) <= 1:\n        return True\n    \n    first_char = input_string[0]\n    for char in input_string[1:]:\n        if char != first_char:\n            return False\n    return True"}
{"task_id": "Mbpp/742", "solution": "import math\n\nclass RegularTetrahedron:\n    \"\"\"Represents a regular tetrahedron and provides methods for its properties.\"\"\"\n    def __init__(self, side_length: float):\n        self.side_length = side_length\n\n    def calculate_surface_area(self) -> float:\n        \"\"\"Computes and returns the total surface area of the tetrahedron.\"\"\"\n        return math.sqrt(3) * (self.side_length ** 2)\n\ndef area_tetrahedron(side_length: float) -> float:\n    \"\"\"\n    Calculates the total surface area of a regular tetrahedron given its side length.\n    This function acts as a facade, internally utilizing the RegularTetrahedron class.\n    \"\"\"\n    tetrahedron = RegularTetrahedron(side_length)\n    return tetrahedron.calculate_surface_area()"}
