{"task_id": "Mbpp/247", "solution": "def lps(input_string: str) -> int:\n    \"\"\"Calculates the length of the longest palindromic subsequence in the given string.\"\"\"\n    n = len(input_string)\n\n    # dp[i][j] stores the length of the longest palindromic subsequence of input_string[i...j]\n    dp = [[0] * n for _ in range(n)]\n\n    # All single characters are palindromes of length 1\n    for i in range(n):\n        dp[i][i] = 1\n\n    # Fill the table for lengths from 2 to n\n    for length in range(2, n + 1):\n        for i in range(n - length + 1):\n            j = i + length - 1\n            if input_string[i] == input_string[j]:\n                if length == 2:\n                    dp[i][j] = 2\n                else:\n                    dp[i][j] = 2 + dp[i + 1][j - 1]\n            else:\n                dp[i][j] = max(dp[i + 1][j], dp[i][j - 1])\n\n    return dp[0][n - 1]"}
{"task_id": "Mbpp/256", "solution": "class InputNumber:\n    \"\"\"Encapsulates and validates the input number.\"\"\"\n    def __init__(self, value: int):\n        self._value = value\n\n    def is_non_negative(self) -> bool:\n        \"\"\"Checks if the encapsulated value is non-negative.\"\"\"\n        return self._value >= 0\n\n    def get_value(self) -> int:\n        \"\"\"Returns the encapsulated integer value.\"\"\"\n        return self._value\n\nclass PrimeNumber:\n    \"\"\"Determines if a given integer is a prime number.\"\"\"\n    def __init__(self, value: int):\n        self._value = value\n\n    def is_prime(self) -> bool:\n        \"\"\"Checks if the encapsulated value is a prime number.\"\"\"\n        if self._value < 2:\n            return False\n        for i in range(2, int(self._value**0.5) + 1):\n            if self._value % i == 0:\n                return False\n        return True\n\nclass PrimeCountResult:\n    \"\"\"Stores the final count of prime numbers.\"\"\"\n    def __init__(self, count: int):\n        self._count = count\n\n    def get_count(self) -> int:\n        \"\"\"Returns the encapsulated prime count.\"\"\"\n        return self._count\n\nclass PrimeCounter:\n    \"\"\"Calculates the count of prime numbers strictly less than a specified limit.\"\"\"\n    def count_primes_less_than(self, limit: InputNumber) -> 'PrimeCountResult':\n        \"\"\"Calculates and returns the count of prime numbers less than the limit.\"\"\"\n        count = 0\n        limit_value = limit.get_value()\n        for i in range(2, limit_value):\n            prime_num_obj = PrimeNumber(i)\n            if prime_num_obj.is_prime():\n                count += 1\n        return PrimeCountResult(count)\n\ndef count_Primes_nums(num: int) -> int:\n    \"\"\"\n    Serves as the main entry point for the prime number counting system, orchestrating input validation,\n    prime counting, and result retrieval.\n    \"\"\"\n    input_num_obj = InputNumber(num)\n    if not input_num_obj.is_non_negative():\n        raise ValueError(\"Input number must be non-negative.\")\n\n    prime_counter_obj = PrimeCounter()\n    result_obj = prime_counter_obj.count_primes_less_than(input_num_obj)\n    return result_obj.get_count()"}
{"task_id": "Mbpp/259", "solution": "def maximize_elements(\n    tuple1: tuple[tuple[int | float, int | float], ...],\n    tuple2: tuple[tuple[int | float, int | float], ...]\n) -> tuple[tuple[int | float, int | float], ...]:\n    \"\"\"\n    Maximizes elements of two input tuples element-wise.\n    Raises ValueError if input tuples have different lengths.\n    \"\"\"\n    if len(tuple1) != len(tuple2):\n        raise ValueError(\"Input tuples must have the same number of two-element tuples.\")\n\n    maximized_tuples = []\n    for (a, b), (c, d) in zip(tuple1, tuple2):\n        max_first = max(a, c)\n        max_second = max(b, d)\n        maximized_tuples.append((max_first, max_second))\n\n    return tuple(maximized_tuples)"}
{"task_id": "Mbpp/261", "solution": "def division_elements(tuple1: tuple[float | int, ...], tuple2: tuple[float | int, ...]) -> tuple[float, ...]:\n    \"\"\"\n    Performs element-wise division of two tuples, handling length mismatch and division by zero.\n    Returns a new tuple with the float results.\n    \"\"\"\n    if len(tuple1) != len(tuple2):\n        raise ValueError(\"Tuples must have the same length\")\n\n    results = []\n    for i in range(len(tuple1)):\n        numerator = tuple1[i]\n        divisor = tuple2[i]\n\n        if divisor == 0:\n            raise ZeroDivisionError(\"Division by zero encountered\")\n        \n        results.append(numerator / divisor)\n        \n    return tuple(results)"}
{"task_id": "Mbpp/262", "solution": "def split_two_parts(input_list: list, L: int) -> tuple[list, list]:\n    \"\"\"\n    Splits a list into two parts based on an integer L, returning them in a tuple.\n    The first part has length L, and the second part contains the remaining elements.\n    \"\"\"\n    first_part = input_list[:L]\n    second_part = input_list[L:]\n    return (first_part, second_part)"}
