{"task_id": "Mbpp/620", "solution": "from typing import List\n\nclass Number:\n    \"\"\"Represents an integer number with divisibility checking capabilities.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def is_divisible_by(self, other: 'Number') -> bool:\n        \"\"\"Checks if self is divisible by other, or other is divisible by self.\"\"\"\n        return (self.value % other.value == 0) or (other.value % self.value == 0)\n\n    def __eq__(self, other):\n        if not isinstance(other, Number):\n            return NotImplemented\n        return self.value == other.value\n\n    def __hash__(self):\n        return hash(self.value)\n\n    def __repr__(self):\n        return f\"Number({self.value})\"\n\nclass DivisibleSubsetFinder:\n    \"\"\"Encapsulates the algorithm to find the size of the largest divisible subset.\"\"\"\n\n    @staticmethod\n    def find_largest_subset_size(numbers: List[int]) -> int:\n        \"\"\"\n        Finds the size of the largest subset of numbers where every pair is divisible\n        using a dynamic programming approach.\n        \"\"\"\n        if not numbers:\n            return 0\n\n        sorted_numbers = sorted([Number(n) for n in numbers], key=lambda x: x.value)\n        n = len(sorted_numbers)\n\n        dp = [1] * n\n        max_size = 1\n\n        for i in range(n):\n            for j in range(i):\n                if sorted_numbers[i].value % sorted_numbers[j].value == 0:\n                    dp[i] = max(dp[i], dp[j] + 1)\n            max_size = max(max_size, dp[i])\n\n        return max_size\n\ndef largest_subset(numbers: List[int]) -> int:\n    \"\"\"\n    Finds the size of the largest subset of a list of numbers so that every pair is divisible.\n    \"\"\"\n    return DivisibleSubsetFinder.find_largest_subset_size(numbers)"}
{"task_id": "Mbpp/629", "solution": "def find_even_numbers(listOfNumbers: list) -> list:\n    \"\"\"\n    Identifies and returns all even numbers from a given list of numbers.\n\n    Args:\n        listOfNumbers (list): A list of numerical values (e.g., integers).\n\n    Returns:\n        list: A new list containing only the even numbers from the input list.\n    \"\"\"\n    even_numbers_list = []\n    for number in listOfNumbers:\n        if number % 2 == 0:\n            even_numbers_list.append(number)\n    return even_numbers_list"}
{"task_id": "Mbpp/630", "solution": "def get_coordinates(input_coordinate: tuple[int, int]) -> list[list[int]]:\n    \"\"\"\n    Extracts all adjacent coordinates of the given coordinate tuple.\n\n    Args:\n        input_coordinate: A tuple (x, y) representing the center coordinate.\n\n    Returns:\n        A list of lists, where each inner list [x', y'] is an adjacent coordinate.\n        Includes the input coordinate itself.\n    \"\"\"\n    x, y = input_coordinate\n    adjacent = []\n    for dx in [-1, 0, 1]:\n        for dy in [-1, 0, 1]:\n            adjacent.append([x + dx, y + dy])\n    return adjacent"}
{"task_id": "Mbpp/631", "solution": "def replace_spaces(input_string: str) -> str:\n    \"\"\"\n    Replaces whitespaces with underscores and vice versa in the given string.\n    Spaces become underscores, and underscores become spaces.\n    \"\"\"\n    # Use a temporary placeholder unlikely to appear in the input string\n    temp_placeholder = \"___TEMP_SPACE_REPLACEMENT___\"\n\n    # Step 1: Replace all spaces with the temporary placeholder\n    interim_string = input_string.replace(' ', temp_placeholder)\n\n    # Step 2: Replace all underscores with actual spaces\n    final_string = interim_string.replace('_', ' ')\n\n    # Step 3: Replace the temporary placeholder with underscores\n    final_string = final_string.replace(temp_placeholder, '_')\n\n    return final_string"}
{"task_id": "Mbpp/632", "solution": "def move_zero(input_list):\n    # This function moves all zero elements to the end of the list while preserving the relative order of non-zero elements.\n    # It achieves this by building a new list with non-zero elements first, then appending the necessary number of zeroes.\n    non_zero_elements = []\n    zero_count = 0\n\n    for element in input_list:\n        if element != 0:\n            non_zero_elements.append(element)\n        else:\n            zero_count += 1\n\n    non_zero_elements.extend([0] * zero_count)\n    return non_zero_elements"}
