{"task_id": "Mbpp/94", "solution": "from typing import List, Tuple, Any\n\ndef index_minimum(data: List[Tuple[Any, Any]]) -> Any:\n    \"\"\"\n    Returns the first value of the tuple with the smallest second value.\n    Assumes the input list 'data' is non-empty.\n    \"\"\"\n    min_second_value = data[0][1]\n    result_first_value = data[0][0]\n\n    for first_value, second_value in data[1:]:\n        if second_value < min_second_value:\n            min_second_value = second_value\n            result_first_value = first_value\n            \n    return result_first_value"}
{"task_id": "Mbpp/99", "solution": "def decimal_to_binary(decimal_number: int) -> str:\n    \"\"\"\n    Converts a non-negative decimal integer to its binary string equivalent.\n    Ensures no leading zeros, except for the number zero itself which returns '0'.\n    \"\"\"\n    if decimal_number == 0:\n        return '0'\n\n    binary_digits = []\n    while decimal_number > 0:\n        binary_digits.append(str(decimal_number % 2))\n        decimal_number //= 2\n\n    return \"\".join(reversed(binary_digits))"}
{"task_id": "Mbpp/95", "solution": "def Find_Min_Length(list_of_lists: list[list]) -> int:\n    \"\"\"\n    Calculates the length of the smallest list in a list of lists.\n    Returns the minimum length, or 0 if `list_of_lists` is empty.\n    \"\"\"\n    if not list_of_lists:\n        return 0\n\n    min_length = float('inf')\n    for sub_list in list_of_lists:\n        min_length = min(min_length, len(sub_list))\n\n    # If the input was not empty, min_length will be a non-negative integer.\n    # The initial check handles empty `list_of_lists` gracefully.\n    return int(min_length) if min_length != float('inf') else 0"}
{"task_id": "Mbpp/96", "solution": "def divisor(number: int) -> int:\n    \"\"\"Calculates the number of positive divisors for a given integer.\"\"\"\n    count = 0\n    i = 1\n    while i * i <= number:\n        if number % i == 0:\n            if i * i == number:\n                count += 1\n            else:\n                count += 2\n        i += 1\n    return count"}
