{"task_id": "Mbpp/599", "solution": "def sum_average(n: int) -> tuple[int, float]:\n    \"\"\"\n    Calculates the sum and average of the first n natural numbers.\n    Assumes n is a positive integer.\n    \"\"\"\n    total_sum = n * (n + 1) // 2\n    average = total_sum / n\n    return (total_sum, average)"}
{"task_id": "Mbpp/604", "solution": "def reverse_words(input_string: str) -> str:\n    \"\"\"\n    Reverses the order of space-separated words in the input string.\n    Splits the string by spaces, reverses the word list, then joins them with a single space.\n    \"\"\"\n    words = input_string.split(' ')\n    words.reverse()\n    return ' '.join(words)"}
{"task_id": "Mbpp/602", "solution": "def first_repeated_char(input_string: str) -> str | None:\n    \"\"\"\n    Finds the first character that appears more than once in the input string.\n    Returns the first repeated character, or None if no character is repeated.\n    \"\"\"\n    seen_characters = set()\n    for char in input_string:\n        if char in seen_characters:\n            return char\n        seen_characters.add(char)\n    return None"}
{"task_id": "Mbpp/605", "solution": "def prime_num(number: int) -> bool:\n    \"\"\"\n    Checks if the given integer is a prime number.\n    A prime number is an integer greater than 1 that has no positive divisors other than 1 and itself.\n    \"\"\"\n    if number <= 1:\n        return False\n    if number <= 3:\n        return True\n    if number % 2 == 0 or number % 3 == 0:\n        return False\n    i = 5\n    while i * i <= number:\n        if number % i == 0 or number % (i + 2) == 0:\n            return False\n        i += 6\n    return True"}
{"task_id": "Mbpp/603", "solution": "def get_ludic(n: int) -> list[int]:\n    \"\"\"Returns a sorted list of lucid numbers (1 and primes) up to n.\n    Lucid numbers include 1 and all prime numbers.\n    \"\"\"\n    def is_prime(num: int) -> bool:\n        \"\"\"Checks if a number is prime.\"\"\"\n        if num < 2:\n            return False\n        for i in range(2, int(num**0.5) + 1):\n            if num % i == 0:\n                return False\n        return True\n\n    lucid_numbers = []\n    if n >= 1:\n        lucid_numbers.append(1)\n\n    for num in range(2, n + 1):\n        if is_prime(num):\n            lucid_numbers.append(num)\n\n    return lucid_numbers"}
{"task_id": "Mbpp/612", "solution": "def merge(input_list: list[list[any]]) -> list[list[any]]:\n    \"\"\"\n    Separates the first and second elements from a list of two-element sublists into two new lists.\n    \"\"\"\n    first_elements = []\n    second_elements = []\n    for sublist in input_list:\n        first_elements.append(sublist[0])\n        second_elements.append(sublist[1])\n    return [first_elements, second_elements]"}
{"task_id": "Mbpp/607", "solution": "import re\n\ndef find_literals(source_string: str, regex_pattern: str) -> tuple[str, int, int]:\n    \"\"\"\n    Searches a source string for the first occurrence of a regex pattern.\n    Returns a tuple (matched_substring, start_index, end_index) or ('', -1, -1) if no match.\n    \"\"\"\n    match = re.search(regex_pattern, source_string)\n    if match:\n        return (match.group(0), match.start(), match.end())\n    else:\n        return ('', -1, -1)"}
{"task_id": "Mbpp/608", "solution": "def bell_Number(n: int) -> int:\n    \"\"\"\n    Calculates the nth Bell number using the Bell triangle method.\n    Raises ValueError if n is negative.\n    \"\"\"\n    if n < 0:\n        raise ValueError(\"Input 'n' must be a non-negative integer.\")\n\n    if n == 0:\n        return 1\n    if n == 1:\n        return 1\n\n    # Initialize Bell triangle (or a 2D array to store values)\n    # The (i, j) element stores B(i, j)\n    # The Bell triangle is:\n    # B(0,0) = 1\n    # B(i,0) = B(i-1, i-1) for i > 0 (first element of each row is last element of prev row)\n    # B(i,j) = B(i-1, j-1) + B(i, j-1) for i, j > 0 (elements after first are sum of element above and element to the left)\n    \n    # We only need the previous row to calculate the current row,\n    # so we can optimize space by using a 1D array (or list)\n    # 'bell_triangle_row' will store the current row being computed.\n    \n    bell_triangle_row = [0] * (n + 1)\n    \n    # Base case: B(0) = 1, which means the first element of the first row is 1\n    bell_triangle_row[0] = 1\n\n    for i in range(1, n + 1):\n        # The first element of the current row B(i,0) is the last element of the previous row B(i-1, i-1)\n        # In our 1D array, this means bell_triangle_row[0] becomes the previous last element.\n        # This is already handled by the first loop iteration's bell_triangle_row[i-1]\n        \n        # This is where the Bell triangle logic unfolds:\n        # A(i, 0) = A(i-1, i-1)  (The value of previous row's last element)\n        # A(i, j) = A(i-1, j-1) + A(i, j-1)\n        \n        # We need to compute the i-th Bell number, which is the (n)-th Bell number.\n        # The 0-th Bell number is B(0,0) = 1.\n        # The 1-th Bell number is B(1,0) = B(0,0) = 1.\n        # The 2-th Bell number is B(2,0) = B(1,1) = 2.\n        \n        # This implementation uses a 1D list to represent the \"current row\" of the Bell triangle\n        # where bell_triangle_row[j] corresponds to B(current_row_index, j).\n        # When moving to a new row 'i', the first element B(i,0) is B(i-1, i-1)\n        \n        # For current row 'i':\n        # B(i,0) = B(i-1, i-1) (This corresponds to bell_triangle_row[i-1] after previous iteration)\n        # We store B(i-1, i-1) in a temporary variable to set B(i,0)\n        \n        prev_last_element = bell_triangle_row[i-1] # This is B(i-1, i-1)\n        \n        # For the first element of the current row 'i', it is equal to the last element of the previous row.\n        # This value effectively becomes bell_triangle_row[0] for the new iteration.\n        \n        # The actual update rule for the Bell triangle is:\n        # B[i][0] = B[i-1][i-1]\n        # B[i][j] = B[i-1][j-1] + B[i][j-1]\n        \n        # Let's adjust the indices to reflect the design context.\n        # We need a 2D array or simulate it carefully with a 1D array.\n        \n        # For an array `bell_values` where `bell_values[j]` is A(i, j)\n        # To compute A(i, j):\n        # Current A(i, j-1) is `bell_values[j-1]` (value computed in current row 'i')\n        # Previous A(i-1, j-1) is `bell_values[j-1]` (value from previous row stored as current row's B(j-1) before modification)\n        \n        # A more straightforward Bell triangle using a list 'bell' representing a single row:\n        \n        # Initial state: bell = [1] (represents B_0)\n        # For B_1:\n        #   new_bell = [bell[-1]] = [1]\n        #   new_bell.append(new_bell[-1] + bell[0]) = [1, 1+1] = [1, 2] -> NO, B_1 is 1.\n        # The algorithm is:\n        # bell_triangle[row][0] = bell_triangle[row-1][row-1]\n        # bell_triangle[row][col] = bell_triangle[row-1][col-1] + bell_triangle[row][col-1]\n        \n        # Let's use a 1D list `bell_row` to represent `bell_triangle[i]`\n        \n        new_bell_row = [0] * (i + 1)\n        \n        # First element of the current row `i` is the last element of the previous row `i-1`.\n        # The last element of previous row `i-1` is `bell_triangle_row[i-1]` (from the *previous* iteration).\n        new_bell_row[0] = bell_triangle_row[i-1] \n        \n        # Fill the rest of the current row `i`.\n        # `new_bell_row[j]` = `bell_triangle_row[j-1]` (from previous row) + `new_bell_row[j-1]` (from current row)\n        for j in range(1, i + 1):\n            new_bell_row[j] = bell_triangle_row[j-1] + new_bell_row[j-1]\n        \n        # The n-th Bell number is the first element of the (n)-th row of the triangle (0-indexed)\n        # which is `new_bell_row[0]`.\n        # After computing a full row, update `bell_triangle_row` to `new_bell_row` for the next iteration.\n        bell_triangle_row = new_bell_row\n\n    # After 'n' iterations, the first element of the last computed row `n` will be B_n.\n    return bell_triangle_row[0]"}
