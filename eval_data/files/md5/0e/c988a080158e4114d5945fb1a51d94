{"task_id": "Mbpp/70", "solution": "from typing import List, Tuple, Any\n\ndef get_equal(tuples: List[Tuple[Any, ...]]) -> bool:\n    \"\"\"\n    Determines if all given tuples in a collection have equal length.\n\n    Returns True if all tuples have equal length, or if the collection is empty/contains one tuple.\n    \"\"\"\n    if not tuples or len(tuples) == 1:\n        return True\n\n    first_tuple_length = len(tuples[0])\n    for tpl in tuples:\n        if len(tpl) != first_tuple_length:\n            return False\n    return True"}
{"task_id": "Mbpp/71", "solution": "def comb_sort(list_of_elements: list) -> list:\n    \"\"\"Sorts a list of comparable elements in ascending order using the Comb Sort algorithm.\n    It returns a new list containing the sorted elements.\n    \"\"\"\n    n = len(list_of_elements)\n    if n <= 1:\n        return list_of_elements[:] # Return a copy for consistency with \"new list\"\n        \n    arr = list_of_elements[:]  # Create a mutable copy to sort\n    gap = n\n    shrink_factor = 1.3\n    swapped = True\n\n    while gap > 1 or swapped:\n        gap = max(1, int(gap / shrink_factor))\n        swapped = False\n\n        for i in range(n - gap):\n            if arr[i] > arr[i + gap]:\n                arr[i], arr[i + gap] = arr[i + gap], arr[i]\n                swapped = True\n    return arr"}
{"task_id": "Mbpp/67", "solution": "import math\n\nclass BellNumberCalculator:\n    \"\"\"Calculates Bell numbers using memoization for efficiency.\"\"\"\n    def __init__(self):\n        \"\"\"Initializes the calculator with base cases for Bell numbers.\"\"\"\n        self._memo: dict[int, int] = {0: 1, 1: 1, 2: 2}\n\n    def calculate_partitions(self, n: int) -> int:\n        \"\"\"\n        Calculates the Bell number B_n for a non-negative integer 'n'.\n        Uses a recurrence relation and memoization.\n        \"\"\"\n        if n < 0:\n            raise ValueError(\"Bell number is not defined for negative integers.\")\n\n        if n in self._memo:\n            return self._memo[n]\n\n        # B_n = sum_{k=0}^{n-1} C(n-1, k) * B_k\n        result = 0\n        for k in range(n):\n            result += math.comb(n - 1, k) * self.calculate_partitions(k)\n\n        self._memo[n] = result\n        return result\n\ndef bell_number(n: int) -> int:\n    \"\"\"\n    Calculates the number of ways to partition a set of 'n' elements (Bell number B_n).\n    Uses an internal BellNumberCalculator for computation.\n    \"\"\"\n    calculator = BellNumberCalculator()\n    return calculator.calculate_partitions(n)"}
{"task_id": "Mbpp/69", "solution": "def is_sublist(main_list, sublist):\n    \"\"\"\n    Checks if `sublist` is a contiguous subsequence of `main_list`.\n    Returns True if found, False otherwise.\n    \"\"\"\n    if not sublist:\n        return True\n    if len(sublist) > len(main_list):\n        return False\n\n    n = len(main_list)\n    m = len(sublist)\n\n    for i in range(n - m + 1):\n        if main_list[i : i + m] == sublist:\n            return True\n    return False"}
