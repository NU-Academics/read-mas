{"task_id": "Mbpp/119", "solution": "def search(arr: list[int]) -> int:\n    \"\"\"\n    Finds the element that appears only once in a sorted array.\n    All other elements appear exactly twice.\n    \"\"\"\n    low = 0\n    high = len(arr) - 1\n\n    while low <= high:\n        mid = (low + high) // 2\n\n        # Ensure mid points to the start of a potential pair\n        # If mid is odd, make it even by decrementing\n        if mid % 2 == 1:\n            mid -= 1\n\n        # Check if the unique element is to the right\n        # This implies arr[mid] and arr[mid+1] are a pair\n        if mid + 1 < len(arr) and arr[mid] == arr[mid + 1]:\n            low = mid + 2\n        # Otherwise, the unique element is either arr[mid] itself or to the left\n        else:\n            high = mid - 1\n    \n    # After the loop, low will be the index of the single element\n    return arr[low]"}
{"task_id": "Mbpp/120", "solution": "import math\n\ndef max_product_tuple(input_list: list) -> float:\n    \"\"\"\n    Calculates the maximum absolute product between numbers in pairs of tuples within a given list.\n    Returns 0.0 if the input list is empty or contains no valid number pairs.\n    \"\"\"\n    max_absolute_product = 0.0\n\n    for item in input_list:\n        if isinstance(item, tuple) and len(item) == 2:\n            num1, num2 = item\n            if isinstance(num1, (int, float)) and isinstance(num2, (int, float)):\n                product = num1 * num2\n                current_absolute_product = math.fabs(product)\n\n                if current_absolute_product > max_absolute_product:\n                    max_absolute_product = current_absolute_product\n\n    return max_absolute_product"}
{"task_id": "Mbpp/125", "solution": "```python\ndef find_length(binary_string: str) -> int:\n    \"\"\"\n    Calculates the maximum difference between the count of '0's and '1's\n    in any substring of the given binary string.\n    \"\"\"\n    if not binary_string:\n        return 0\n\n    for char in binary_string:\n        if char not in ('0', '1'):\n            raise ValueError(\"Input string must contain only '0's and '1's.\")\n\n    def kadanes_algorithm(arr):\n        max_so_far = 0\n        current_max = 0\n        for x in arr:\n            current_max += x\n            if current_max < 0:\n                current_max = 0\n            max_so_far = max(max_so_far, current_max)\n        return max_so_far\n\n    # First pass: '0's as 1, '1's as -1 (maximize 0s - 1s)\n    arr_0_minus_1 = [1 if char == '0' else -1 for char in binary_string]\n    max_diff_0_minus_1 = kadanes_algorithm(arr_0_minus_1)\n\n    # Second pass: '1's as 1, '0's as -1 (maximize 1s - 0s)\n    arr_1_minus_0 = [1 if char == '1' else -1 for char in binary_string]\n    max_diff_1_minus_0 = kadanes_algorithm(arr_1_minus_0)\n\n    return max(max_diff_0_minus_1, max_diff_1_minus_0)\n```"}
{"task_id": "Mbpp/126", "solution": "def sum_common_divisors(number1: int, number2: int) -> int:\n    \"\"\"Calculates the sum of all positive common divisors for two given positive integers.\"\"\"\n    common_divisor_sum = 0\n    min_num = min(number1, number2)\n\n    for i in range(1, min_num + 1):\n        if number1 % i == 0 and number2 % i == 0:\n            common_divisor_sum += i\n            \n    return common_divisor_sum"}
{"task_id": "Mbpp/123", "solution": "import math\n\ndef get_proper_divisors(n: int) -> list[int]:\n    \"\"\"\n    Computes and returns a list of all positive proper divisors for a given integer n.\n    Proper divisors exclude the number n itself.\n    \"\"\"\n    if n <= 1:\n        return []\n    divisors = {1}\n    for i in range(2, int(math.sqrt(n)) + 1):\n        if n % i == 0:\n            divisors.add(i)\n            divisors.add(n // i)\n    return sorted(list(divisors))\n\ndef sum_proper_divisors(n: int) -> int:\n    \"\"\"\n    Calculates the sum of the proper divisors for a given integer n.\n    This function will internally call get_proper_divisors.\n    \"\"\"\n    if n <= 1:\n        return 0\n    return sum(get_proper_divisors(n))\n\ndef is_amicable_pair(a: int, b: int) -> bool:\n    \"\"\"\n    Determines if two distinct numbers, a and b, form an amicable pair.\n    This involves checking if the sum of proper divisors of a equals b,\n    and the sum of proper divisors of b equals a.\n    \"\"\"\n    if a == b:\n        return False\n    return sum_proper_divisors(a) == b and sum_proper_divisors(b) == a\n\ndef amicable_numbers_sum(limit: int) -> int:\n    \"\"\"\n    Orchestrates the calculation of the sum of all amicable numbers up to the given limit.\n    It iterates through numbers, uses helper functions to find proper divisor sums, and identifies amicable pairs.\n    \"\"\"\n    total_sum = 0\n    found_amicable_numbers = set()\n\n    for a in range(1, limit + 1):\n        if a in found_amicable_numbers:\n            continue\n\n        sum_a = sum_proper_divisors(a)\n\n        # Check conditions for a potential amicable pair (a, sum_a)\n        # The second number (sum_a) must be distinct from 'a' and within the limit.\n        if sum_a > a and sum_a <= limit:\n            if is_amicable_pair(a, sum_a):\n                # If they form an amicable pair, add both numbers to the total sum\n                total_sum += a\n                total_sum += sum_a\n                found_amicable_numbers.add(a)\n                found_amicable_numbers.add(sum_a)\n    return total_sum"}
{"task_id": "Mbpp/124", "solution": "import math\n\ndef angle_complex(real_part: float, imaginary_part: float) -> float:\n    \"\"\"\n    Calculates the angle (argument) of a complex number.\n    It uses math.atan2 to correctly handle all quadrants.\n    \"\"\"\n    return math.atan2(imaginary_part, real_part)"}
{"task_id": "Mbpp/127", "solution": "class MultiplicationOperation:\n    \"\"\"Encapsulates the operation of multiplying two integers.\"\"\"\n\n    def __init__(self, operand1: int, operand2: int):\n        self._operand1 = operand1\n        self._operand2 = operand2\n\n    def perform(self) -> int:\n        \"\"\"Executes the multiplication and returns the product.\"\"\"\n        return self._operand1 * self._operand2\n\ndef multiply_int(operand1: int, operand2: int) -> int:\n    \"\"\"\n    Multiplies two integers using a dedicated operation class.\n    This function delegates the core multiplication logic to MultiplicationOperation.\n    \"\"\"\n    operation = MultiplicationOperation(operand1, operand2)\n    return operation.perform()"}
{"task_id": "Mbpp/128", "solution": "from typing import List\n\nclass LengthThreshold:\n    \"\"\"Encapsulates the integer threshold n.\"\"\"\n    def __init__(self, n: int):\n        self.value = n\n\nclass Word:\n    \"\"\"Encapsulates a word's string value and its calculated length, and provides comparison logic.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n        self.length = len(value)\n\n    def is_longer_than(self, threshold: 'LengthThreshold') -> bool:\n        \"\"\"Compares the word's length to a given threshold.\"\"\"\n        return self.length > threshold.value\n\nclass WordList:\n    \"\"\"Manages a collection of Word objects, parsing input text and providing methods to filter words.\"\"\"\n    def __init__(self, text: str):\n        self._words: List[Word] = [Word(word_str) for word_str in text.split()]\n\n    def get_long_words_values(self, threshold: 'LengthThreshold') -> List[str]:\n        \"\"\"Filters words based on the threshold and returns their string values.\"\"\"\n        result_list: List[str] = []\n        for word_obj in self._words:\n            if word_obj.is_longer_than(threshold):\n                result_list.append(word_obj.value)\n        return result_list\n\ndef long_words(n: int, text: str) -> List[str]:\n    \"\"\"\n    Finds words that are longer than n characters from a given list of words.\n    \"\"\"\n    threshold_obj = LengthThreshold(n)\n    wordlist_obj = WordList(text)\n    return wordlist_obj.get_long_words_values(threshold_obj)"}
{"task_id": "Mbpp/130", "solution": "from collections import Counter\nfrom typing import List, Any, Optional\n\ndef max_occurrences(input_list: List[Any]) -> Optional[Any]:\n    \"\"\"\n    Finds the item with the maximum frequency in a given list.\n    Returns None if the input list is empty.\n    \"\"\"\n    if not input_list:\n        return None\n\n    item_counts = Counter(input_list)\n    most_common_items = item_counts.most_common(1)\n\n    if most_common_items:\n        return most_common_items[0][0]\n    return None # Should not be reached if input_list is not empty"}
{"task_id": "Mbpp/129", "solution": "from typing import List\n\nclass Matrix:\n    \"\"\"\n    Encapsulates a 2D list of integers and provides methods for matrix properties and sum calculations.\n    \"\"\"\n    def __init__(self, elements: List[List[int]]):\n        self.elements = elements\n        self.row_count = len(elements)\n        self.col_count = 0\n        if self.row_count > 0:\n            self.col_count = len(elements[0])\n\n    def isSquare(self) -> bool:\n        \"\"\"Determines if the matrix is square by comparing row_count and col_count, and checking for ragged rows.\"\"\"\n        if self.row_count == 0:\n            return False  # An empty matrix cannot be a magic square.\n\n        # Check if all rows have the same number of columns as the first row\n        for row in self.elements:\n            if len(row) != self.col_count:\n                return False\n\n        return self.row_count == self.col_count\n\n    def getRowCount(self) -> int:\n        \"\"\"Returns the number of rows.\"\"\"\n        return self.row_count\n\n    def getColumnCount(self) -> int:\n        \"\"\"Returns the number of columns.\"\"\"\n        return self.col_count\n\n    def calculateRowSum(self, rowIndex: int) -> int:\n        \"\"\"Calculates the sum of elements in the specified rowIndex.\"\"\"\n        return sum(self.elements[rowIndex])\n\n    def calculateColumnSum(self, colIndex: int) -> int:\n        \"\"\"Calculates the sum of elements in the specified colIndex.\"\"\"\n        col_sum = 0\n        for i in range(self.row_count):\n            col_sum += self.elements[i][colIndex]\n        return col_sum\n\n    def calculateMainDiagonalSum(self) -> int:\n        \"\"\"Calculates the sum of elements along the main diagonal (top-left to bottom-right).\"\"\"\n        main_diag_sum = 0\n        for i in range(self.row_count):\n            main_diag_sum += self.elements[i][i]\n        return main_diag_sum\n\n    def calculateAntiDiagonalSum(self) -> int:\n        \"\"\"Calculates the sum of elements along the anti-diagonal (top-right to bottom-left).\"\"\"\n        anti_diag_sum = 0\n        for i in range(self.row_count):\n            anti_diag_sum += self.elements[i][self.row_count - 1 - i]\n        return anti_diag_sum\n\ndef magic_square_test(matrix_data: List[List[int]]) -> bool:\n    \"\"\"\n    Orchestrates the process of determining if a given matrix is a magic square.\n    \"\"\"\n    matrix_obj = Matrix(matrix_data)\n\n    if not matrix_obj.isSquare():\n        return False\n\n    n = matrix_obj.getRowCount()\n    if n == 0:  # Handle the case of an empty square matrix (e.g., [[]] after isSquare check)\n        return False\n\n    # Calculate the sum for the first row, which will be the target sum for all others\n    target_sum = matrix_obj.calculateRowSum(0)\n\n    # Check all row sums\n    for i in range(n):\n        if matrix_obj.calculateRowSum(i) != target_sum:\n            return False\n\n    # Check all column sums\n    for i in range(n):\n        if matrix_obj.calculateColumnSum(i) != target_sum:\n            return False\n\n    # Check main diagonal sum\n    if matrix_obj.calculateMainDiagonalSum() != target_sum:\n        return False\n\n    # Check anti-diagonal sum\n    if matrix_obj.calculateAntiDiagonalSum() != target_sum:\n        return False\n\n    return True"}
