{"task_id": "Mbpp/133", "solution": "def sum_negativenum(numbers: list) -> float:\n    \"\"\"\n    Calculates the sum of negative numbers in a list.\n\n    Args:\n        numbers: A list of numerical values (int or float).\n\n    Returns:\n        The sum of all negative numbers in the list as a float.\n    \"\"\"\n    total_sum = 0.0\n    for num in numbers:\n        if num < 0:\n            total_sum += num\n    return total_sum"}
{"task_id": "Mbpp/131", "solution": "def _is_vowel(char: str) -> bool:\n    \"\"\"\n    Checks if a character is a vowel (a, e, i, o, u, case-insensitive, 'y' excluded).\n    \"\"\"\n    return char.lower() in 'aeiou'\n\ndef reverse_vowels(s: str) -> str:\n    \"\"\"\n    Reverses only the vowels of a given string, maintaining the original positions of non-vowel characters.\n    \"\"\"\n    chars = list(s)\n    left = 0\n    right = len(chars) - 1\n\n    while left < right:\n        while left < right and not _is_vowel(chars[left]):\n            left += 1\n        while left < right and not _is_vowel(chars[right]):\n            right -= 1\n\n        if left < right:\n            chars[left], chars[right] = chars[right], chars[left]\n            left += 1\n            right -= 1\n\n    return \"\".join(chars)"}
