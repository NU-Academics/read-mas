{"task_id": "Mbpp/448", "solution": "def _generate_perrin_sequence(n: int) -> list[int]:\n    \"\"\"Generates the Perrin sequence up to index n, assuming n is non-negative.\"\"\"\n    if n == 0:\n        return [3]\n    if n == 1:\n        return [3, 0]\n    \n    # Initialize with the first three Perrin numbers\n    perrin_numbers = [3, 0, 2]\n    \n    # Calculate subsequent Perrin numbers using the recurrence relation\n    for i in range(3, n + 1):\n        next_perrin = perrin_numbers[i-2] + perrin_numbers[i-3]\n        perrin_numbers.append(next_perrin)\n            \n    return perrin_numbers\n\ndef cal_sum(n: int) -> int:\n    \"\"\"Calculates the sum of Perrin numbers from P(0) to P(n).\"\"\"\n    perrin_sequence = _generate_perrin_sequence(n)\n    return sum(perrin_sequence)"}
{"task_id": "Mbpp/453", "solution": "def sumofFactors(number: int) -> int:\n    \"\"\"\n    Calculates the sum of all even factors for a given integer.\n    Iterates from 1 up to the input number, checking each for factor and evenness.\n    \"\"\"\n\n    def _is_factor(potential_factor: int, num: int) -> bool:\n        \"\"\"Checks if a potential_factor divides the num exactly.\"\"\"\n        if potential_factor == 0:\n            return False # Division by zero is not allowed, 0 is not a factor\n        return num % potential_factor == 0\n\n    def _is_even(num: int) -> bool:\n        \"\"\"Checks if a num is even.\"\"\"\n        return num % 2 == 0\n\n    total_sum = 0\n    if number <= 0:\n        return 0 # Factors are typically defined for positive integers; no even factors for non-positive or zero\n\n    for i in range(1, number + 1):\n        if _is_factor(i, number):\n            if _is_even(i):\n                total_sum += i\n    return total_sum"}
