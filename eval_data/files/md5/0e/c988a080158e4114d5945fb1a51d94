{"task_id": "Mbpp/74", "solution": "class ElementMapping:\n    \"\"\"Manages bidirectional one-to-one mapping between pattern and string elements.\"\"\"\n    def __init__(self):\n        self._pattern_to_string_map = {}\n        self._string_to_pattern_map = {}\n\n    def add_or_check_mapping(self, pattern: str, string: str) -> bool:\n        \"\"\"Attempts to add a new mapping or checks consistency against existing ones.\"\"\"\n        # Check pattern to string consistency\n        if pattern in self._pattern_to_string_map:\n            if self._pattern_to_string_map[pattern] != string:\n                return False\n        \n        # Check string to pattern consistency (reverse mapping)\n        if string in self._string_to_pattern_map:\n            if self._string_to_pattern_map[string] != pattern:\n                return False\n        \n        # If no conflicts, establish the mapping\n        self._pattern_to_string_map[pattern] = string\n        self._string_to_pattern_map[string] = pattern\n        \n        return True\n\ndef is_samepatterns(strings: list[str], patterns: list[str]) -> bool:\n    \"\"\"Checks if the strings array follows the pattern defined by the patterns array with a consistent one-to-one mapping.\"\"\"\n    if len(strings) != len(patterns):\n        return False\n\n    mapper = ElementMapping()\n    for i in range(len(strings)):\n        if not mapper.add_or_check_mapping(patterns[i], strings[i]):\n            return False\n            \n    return True"}
{"task_id": "Mbpp/75", "solution": "def find_tuples(list_of_tuples: list[tuple[int, ...]], k: int) -> list[tuple[int, ...]]:\n    \"\"\"\n    Finds tuples where all elements are divisible by k from the given list of tuples.\n    \"\"\"\n    if k == 0:\n        raise ValueError(\"Divisor 'k' cannot be zero.\")\n\n    def _is_tuple_divisible(t: tuple[int, ...], divisor: int) -> bool:\n        \"\"\"\n        Checks if all elements within a single tuple are perfectly divisible by the divisor.\n        \"\"\"\n        for num in t:\n            if num % divisor != 0:\n                return False\n        return True\n\n    result_list = []\n    for current_tuple in list_of_tuples:\n        if _is_tuple_divisible(current_tuple, k):\n            result_list.append(current_tuple)\n    return result_list"}
