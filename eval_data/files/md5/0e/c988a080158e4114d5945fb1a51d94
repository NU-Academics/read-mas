{"task_id": "Mbpp/745", "solution": "def divisible_by_digits(startnum: int, endnum: int) -> list[int]:\n    \"\"\"\n    Finds numbers within a given range where every number is divisible by every digit it contains.\n    \"\"\"\n    \n    def _get_non_zero_digits(number: int) -> list[int]:\n        \"\"\"\n        Extracts all individual non-zero digits from a given integer.\n        \"\"\"\n        digits = []\n        if number == 0:\n            return []\n        \n        for char_digit in str(number):\n            digit = int(char_digit)\n            if digit != 0:\n                digits.append(digit)\n        return digits\n\n    def _is_self_divisible(number: int) -> bool:\n        \"\"\"\n        Determines if a number is divisible by all its non-zero digits and contains no zero digit.\n        \"\"\"\n        if number == 0:\n            return False # Zero is not considered self-divisible.\n        \n        # A number containing '0' is not self-divisible as division by zero is undefined.\n        if '0' in str(number):\n            return False\n            \n        digits_to_check = _get_non_zero_digits(number)\n        \n        # If the number is positive and contains no '0' digit, digits_to_check will not be empty.\n        for digit in digits_to_check:\n            if number % digit != 0:\n                return False\n                \n        return True\n\n    results = []\n    for number in range(startnum, endnum + 1):\n        if _is_self_divisible(number):\n            results.append(number)\n            \n    return results"}
{"task_id": "Mbpp/749", "solution": "def sort_numeric_strings(numeric_strings: list[str]) -> list[int]:\n    \"\"\"\n    Converts a list of string numbers to integers and sorts them numerically.\n    Returns a new list of integers sorted in ascending order.\n    \"\"\"\n    converted_numbers = [int(s) for s in numeric_strings]\n    converted_numbers.sort()\n    return converted_numbers"}
{"task_id": "Mbpp/751", "solution": "from typing import List\n\ndef check_min_heap(array: List[int]) -> bool:\n    \"\"\"\n    Checks if the given array represents a min-heap.\n    A min-heap's parent node value must be less than or equal to its children's values.\n    \"\"\"\n    n = len(array)\n\n    if n <= 1:\n        return True\n\n    # Iterate only through non-leaf nodes. The last parent node is at index (n // 2) - 1.\n    for parent_idx in range(n // 2):\n        left_child_idx = 2 * parent_idx + 1\n        right_child_idx = 2 * parent_idx + 2\n\n        # Check left child\n        if left_child_idx < n and array[parent_idx] > array[left_child_idx]:\n            return False\n\n        # Check right child\n        if right_child_idx < n and array[parent_idx] > array[right_child_idx]:\n            return False\n\n    return True"}
{"task_id": "Mbpp/752", "solution": "def jacobsthal_num(n: int) -> int:\n    \"\"\"\n    Calculates the nth Jacobsthal number using iteration.\n    Handles base cases J(0)=0, J(1)=1 and uses the recurrence J(n) = J(n-1) + 2*J(n-2).\n    \"\"\"\n    if n == 0:\n        return 0\n    elif n == 1:\n        return 1\n    \n    a, b = 0, 1\n    for _ in range(2, n + 1):\n        a, b = b, b + 2 * a\n    return b"}
{"task_id": "Mbpp/755", "solution": "def second_smallest(numbers: list) -> int | float:\n    \"\"\"\n    Finds the second smallest number in a list of numbers.\n    Raises ValueError if the list contains fewer than two elements.\n    \"\"\"\n    if len(numbers) < 2:\n        raise ValueError(\"List must contain at least two elements\")\n\n    numbers.sort()\n    return numbers[1]"}
{"task_id": "Mbpp/754", "solution": "def extract_index_list(l1: list, l2: list, l3: list) -> list:\n    \"\"\"\n    Finds elements that appear at the same index in all three input lists.\n    An element is common if it exists at the same index in list1, list2, and list3, and the values are identical.\n    \"\"\"\n    common_elements_list = []\n    min_length = min(len(l1), len(l2), len(l3))\n\n    for i in range(min_length):\n        if l1[i] == l2[i] == l3[i]:\n            common_elements_list.append(l1[i])\n\n    return common_elements_list"}
{"task_id": "Mbpp/753", "solution": "def find_minimum_k_records(tuple_list: list[tuple], k: int) -> list[tuple]:\n    \"\"\"\n    Finds the k records with the minimum numerical value in their second element from a list of tuples.\n    The function sorts the list and returns the first k elements.\n    \"\"\"\n    sorted_list = sorted(tuple_list, key=lambda x: x[1])\n    return sorted_list[:k]"}
{"task_id": "Mbpp/759", "solution": "import re\n\ndef is_decimal(input_string: str) -> bool:\n    \"\"\"\n    Checks if a given string represents a decimal number with exactly two digits after the decimal point\n    or is a whole number (implying .00 precision).\n    \"\"\"\n    # Regex pattern: starts with one or more digits, optionally followed by a literal dot and exactly two digits.\n    pattern = r\"^\\d+(\\.\\d{2})?$\"\n    return re.fullmatch(pattern, input_string) is not None"}
{"task_id": "Mbpp/760", "solution": "def unique_Element(list_of_numbers: list) -> bool:\n    \"\"\"\n    Checks if a list of numbers contains only one distinct element.\n    \"\"\"\n    if not list_of_numbers:\n        return True\n\n    distinct_elements = set(list_of_numbers)\n    return len(distinct_elements) == 1"}
{"task_id": "Mbpp/758", "solution": "import collections\nfrom typing import Any, List, Dict, Tuple\n\ndef unique_sublists(input_list: List[List[Any]]) -> Dict[Tuple[Any, ...], int]:\n    \"\"\"\n    Counts the occurrences of unique sublists within a list of lists.\n    Returns a dictionary mapping unique tuples (converted from sublists) to their counts.\n    \"\"\"\n    tuple_representations = [tuple(sublist) for sublist in input_list]\n    return dict(collections.Counter(tuple_representations))"}
{"task_id": "Mbpp/762", "solution": "class Month:\n    \"\"\"Represents a month and encapsulates the logic for determining if it has 30 days.\"\"\"\n    def __init__(self, month_number: int):\n        \"\"\"Initializes a Month object with the given number.\"\"\"\n        self.number = month_number\n\n    def has30Days(self) -> bool:\n        \"\"\"Determines if the month has 30 days.\"\"\"\n        return self.number in {4, 6, 9, 11}\n\ndef check_monthnumber_number(month_number: int) -> bool:\n    \"\"\"Checks if the given month number (1-12) corresponds to a month with 30 days.\"\"\"\n    month = Month(month_number)\n    return month.has30Days()"}
{"task_id": "Mbpp/757", "solution": "def _reverse_string(s: str) -> str:\n    \"\"\"Reverses a given string.\"\"\"\n    return s[::-1]\n\ndef _normalize_pair(s1: str, s2: str) -> tuple[str, str]:\n    \"\"\"Ensures a consistent representation of a string pair by sorting them lexicographically.\"\"\"\n    return tuple(sorted((s1, s2)))\n\ndef count_reverse_pairs(string_list: list[str]) -> int:\n    \"\"\"Counts the total number of unique reverse string pairs in the input list.\"\"\"\n    unique_pairs = set()\n    n = len(string_list)\n\n    for i in range(n):\n        s1 = string_list[i]\n        for j in range(i + 1, n):\n            s2 = string_list[j]\n            \n            if s1 == _reverse_string(s2):\n                normalized_pair = _normalize_pair(s1, s2)\n                unique_pairs.add(normalized_pair)\n    \n    return len(unique_pairs)"}
{"task_id": "Mbpp/763", "solution": "import math\n\ndef find_min_diff(numbers: tuple, count: int) -> int:\n    # Sort the input numbers to easily find minimum difference between adjacent elements.\n    sorted_numbers = sorted(numbers)\n    min_diff = math.inf\n\n    # Iterate through adjacent pairs and update min_diff.\n    for i in range(count - 1):\n        current_diff = abs(sorted_numbers[i] - sorted_numbers[i+1])\n        min_diff = min(min_diff, current_diff)\n        \n    return int(min_diff)"}
{"task_id": "Mbpp/764", "solution": "def number_ctr(input_string: str) -> int:\n    \"\"\"\n    Counts the number of numeric digits (0-9) in the given string.\n    Returns the total count of digits in the string.\n    \"\"\"\n    digit_count = 0\n    for char in input_string:\n        if char.isdigit():\n            digit_count += 1\n    return digit_count"}
{"task_id": "Mbpp/766", "solution": "def pair_wise(input_list: list) -> list[tuple]:\n    \"\"\"\n    Generates a list of all consecutive pairs from the input list.\n    Each pair is a tuple containing two adjacent items.\n    \"\"\"\n    pairs = []\n    for i in range(len(input_list) - 1):\n        pairs.append((input_list[i], input_list[i+1]))\n    return pairs"}
{"task_id": "Mbpp/765", "solution": "def is_power_of_two(num: int) -> bool:\n    \"\"\"\n    Determines if a given positive integer is a power of 2.\n    A positive integer `num` is a power of two if `num > 0` and `(num & (num - 1)) == 0`.\n    \"\"\"\n    return num > 0 and (num & (num - 1)) == 0\n\ndef is_polite(num: int) -> bool:\n    \"\"\"\n    Determines if a given positive integer is a polite number.\n    A number `num` is polite if `num` is a positive integer and is not a power of two.\n    \"\"\"\n    return num > 0 and not is_power_of_two(num)\n\ndef find_nth_polite_number(n: int) -> int:\n    \"\"\"\n    Calculates the nth polite number.\n    It iterates through positive integers, counting polite numbers until the nth is found.\n    \"\"\"\n    polite_count = 0\n    current_num = 0\n    while True:\n        current_num += 1\n        if is_polite(current_num):\n            polite_count += 1\n        if polite_count == n:\n            return current_num"}
{"task_id": "Mbpp/767", "solution": "def get_pairs_count(numbers: list[int], target_sum: int) -> int:\n    \"\"\"\n    Counts the number of pairs in a list of integers whose sum equals a specified target sum.\n    Each occurrence of a number in the input list is considered distinct.\n    \"\"\"\n    pair_count = 0\n    n = len(numbers)\n    for i in range(n):\n        for j in range(i + 1, n):\n            if numbers[i] + numbers[j] == target_sum:\n                pair_count += 1\n    return pair_count"}
{"task_id": "Mbpp/771", "solution": "class _Expression:\n    \"\"\"Encapsulates an expression string and provides bracket balance checking logic.\"\"\"\n\n    _OPENING_BRACKETS = {'(': ')', '{': '}', '[': ']'}\n    _CLOSING_BRACKETS = {')', '}', ']'}\n\n    def __init__(self, content: str):\n        \"\"\"Initializes the expression with the given string.\"\"\"\n        self._content = content\n\n    def is_balanced(self) -> bool:\n        \"\"\"Checks if the brackets in the expression content are balanced.\"\"\"\n        stack = []\n        for char in self._content:\n            if char in self._OPENING_BRACKETS:\n                stack.append(char)\n            elif char in self._CLOSING_BRACKETS:\n                if not stack:\n                    return False\n                last_opening = stack.pop()\n                if self._OPENING_BRACKETS[last_opening] != char:\n                    return False\n        return not stack\n\ndef check_expression(expression_string: str) -> bool:\n    \"\"\"Determines if the given expression string contains balanced brackets.\"\"\"\n    expression = _Expression(expression_string)\n    return expression.is_balanced()"}
{"task_id": "Mbpp/770", "solution": "def odd_num_sum(n: int) -> int:\n    \"\"\"Calculates the sum of the fourth power of the first 'n' odd natural numbers.\n\n    Args:\n        n: An integer representing the count of odd natural numbers.\n\n    Returns:\n        An integer representing the calculated sum.\n    \"\"\"\n    current_odd_num = 1\n    total_sum = 0\n    for _ in range(n):\n        total_sum += current_odd_num ** 4\n        current_odd_num += 2\n    return total_sum"}
{"task_id": "Mbpp/769", "solution": "def Diff(list1: list, list2: list) -> list:\n    \"\"\"\n    Calculates the difference between two lists, returning elements from list1 not in list2.\n    The order of elements from list1 is preserved in the result.\n    \"\"\"\n    set2 = set(list2)\n    result = []\n    for item in list1:\n        if item not in set2:\n            result.append(item)\n    return result"}
{"task_id": "Mbpp/775", "solution": "def odd_position(input_list: list) -> bool:\n    \"\"\"\n    Checks if every odd index in the input_list contains an odd number.\n    Returns True if all numbers at odd indices are odd, False otherwise.\n    \"\"\"\n    for index, value in enumerate(input_list):\n        if index % 2 != 0:  # Check if the current index is odd\n            if value % 2 == 0:  # If an odd index contains an even number, return False\n                return False\n    return True  # All numbers at odd indices were odd"}
{"task_id": "Mbpp/778", "solution": "from typing import List, Any\n\ndef pack_consecutive_duplicates(list_elements: List[Any]) -> List[List[Any]]:\n    \"\"\"\n    Packs consecutive duplicates of list elements into sublists.\n\n    Returns:\n        A list of sublists, where each sublist contains consecutive identical elements.\n    \"\"\"\n    if not list_elements:\n        return []\n\n    packed_list = []\n    current_sublist = [list_elements[0]]\n\n    for i in range(1, len(list_elements)):\n        if list_elements[i] == current_sublist[0]:\n            current_sublist.append(list_elements[i])\n        else:\n            packed_list.append(current_sublist)\n            current_sublist = [list_elements[i]]\n\n    packed_list.append(current_sublist)\n    return packed_list"}
{"task_id": "Mbpp/772", "solution": "def remove_length(input_string: str, k: int) -> str:\n    \"\"\"\n    Removes all words with length k from the given string.\n    Returns a new string with words of length k removed.\n    \"\"\"\n    words = input_string.split(' ')\n    filtered_words = [word for word in words if len(word) != k]\n    return ' '.join(filtered_words)"}
{"task_id": "Mbpp/773", "solution": "def occurance_substring(main_string: str, sub_string: str) -> tuple[str, int, int] | None:\n    \"\"\"\n    Finds the first occurrence and position of a substring within a main string.\n    Returns (matched_substring, start_index, end_index) if found, otherwise None.\n    \"\"\"\n    start_index = main_string.find(sub_string)\n    if start_index != -1:\n        end_index = start_index + len(sub_string)\n        return (sub_string, start_index, end_index)\n    return None"}
{"task_id": "Mbpp/777", "solution": "import collections\n\ndef find_sum(input_list: list) -> int:\n    # Count occurrences of each element in the list.\n    counts = collections.Counter(input_list)\n    \n    # Sum elements that appear exactly once.\n    total_sum = 0\n    for element, count in counts.items():\n        if count == 1:\n            total_sum += element\n    return total_sum"}
{"task_id": "Mbpp/781", "solution": "import math\n\ndef _calculate_divisor_count(number: int) -> int:\n    \"\"\"Calculates the total number of positive divisors for a given integer.\"\"\"\n    count = 0\n    limit = int(math.sqrt(number))\n    for i in range(1, limit + 1):\n        if number % i == 0:\n            count += 1\n            if i * i != number:\n                count += 1\n    return count\n\ndef _is_count_even(count: int) -> bool:\n    \"\"\"Determines if a given integer count is an even number.\"\"\"\n    return count % 2 == 0\n\ndef count_divisors(number: int) -> bool:\n    \"\"\"Checks whether the count of positive divisors for an integer is even.\"\"\"\n    divisor_count = _calculate_divisor_count(number)\n    return _is_count_even(divisor_count)"}
{"task_id": "Mbpp/780", "solution": "import itertools\n\ndef find_combinations(tuple_list: list[tuple[int, int]]) -> list[tuple[int, int]]:\n    \"\"\"\n    Calculates all unique element-wise sums of distinct 2-element tuple pairs\n    from the input list.\n    \"\"\"\n    results = []\n    for t1, t2 in itertools.combinations(tuple_list, 2):\n        sum_tuple = (t1[0] + t2[0], t1[1] + t2[1])\n        results.append(sum_tuple)\n    return results"}
{"task_id": "Mbpp/782", "solution": "def odd_length_sum(arr: list[int]) -> int:\n    \"\"\"\n    Calculates the total sum of all elements from all odd-length subarrays of the input array.\n    This function iterates through all possible subarrays, checks their length, and sums elements of odd-length ones.\n    \"\"\"\n    total_sum = 0\n    n = len(arr)\n\n    # Iterate through all possible starting indices\n    for i in range(n):\n        # Iterate through all possible ending indices\n        for j in range(i, n):\n            # Extract the current subarray\n            subarray = arr[i : j + 1]\n            # Check if the subarray's length is odd\n            if len(subarray) % 2 != 0:\n                # Add the sum of the subarray's elements to the total sum\n                total_sum += sum(subarray)\n\n    return total_sum"}
