{"task_id": "Mbpp/797", "solution": "def sum_in_range(l: int, r: int) -> int:\n    \"\"\"\n    Calculates the sum of all odd natural numbers within the inclusive range [l, r].\n\n    A natural number is a positive integer (greater than 0).\n    \"\"\"\n    total_sum = 0\n    # Ensure l is at least 1, as natural numbers are positive integers.\n    start = max(1, l)\n\n    for num in range(start, r + 1):\n        # A number is considered odd if it is not divisible by 2.\n        if num % 2 != 0:\n            total_sum += num\n    return total_sum"}
{"task_id": "Mbpp/800", "solution": "def remove_all_spaces(input_string: str) -> str:\n    \"\"\"Removes all whitespace characters from the input string.\n\n    Returns a new string with non-whitespace characters in their original order.\n    \"\"\"\n    return \"\".join(char for char in input_string if not char.isspace())"}
{"task_id": "Mbpp/799", "solution": "def left_rotate(value: int, shift_count: int) -> int:\n    \"\"\"Performs a left bit rotation on a 32-bit integer.\n\n    The result is masked to ensure it remains within 32 bits.\n    \"\"\"\n    BIT_LENGTH = 32\n    actual_shift = shift_count % BIT_LENGTH\n\n    # Combine left-shifted bits with bits that wrap around from the right,\n    # then mask the result to ensure it fits within 32 bits.\n    return ((value << actual_shift) | (value >> (BIT_LENGTH - actual_shift))) & ((1 << BIT_LENGTH) - 1)"}
{"task_id": "Mbpp/803", "solution": "import math\n\ndef is_perfect_square(number: int) -> bool:\n    \"\"\"Checks if the given number is a perfect square. It returns True if the number is a perfect square, False otherwise.\"\"\"\n    if number < 0:\n        return False\n    \n    sqrt_val = math.sqrt(number)\n    return sqrt_val.is_integer()"}
{"task_id": "Mbpp/804", "solution": "def is_product_even(numbers: list) -> bool:\n    \"\"\"\n    Checks if the product of numbers in a list is even.\n    Returns True if the product is even, False otherwise.\n    \"\"\"\n    if not numbers:\n        return False  # Empty list product is 1 (odd)\n\n    for num in numbers:\n        # Check for non-numeric values and raise ValueError.\n        if not isinstance(num, (int, float)):\n            raise ValueError(\"Non-numeric input detected\")\n        # If any number is exactly 0, the product is 0, which is even.\n        if num == 0:\n            return True\n        # If any integer is even, the product is even.\n        if isinstance(num, int) and num % 2 == 0:\n            return True\n        # If a float is effectively an even integer (e.g., 4.0), the product is even.\n        # This handles cases like [1.0, 2.0, 3.0] -> product 6.0 (even).\n        if isinstance(num, float) and num.is_integer() and int(num) % 2 == 0:\n            return True\n\n    # If no even number was found (or 0), calculate the full product.\n    # This path is reached if all numbers are odd integers or non-integer floats.\n    product = 1\n    for num in numbers:\n        product *= num\n\n    # An even number must be an integer (or a float with no fractional part)\n    # and its integer part must be divisible by 2.\n    # Floats with non-zero fractional parts cannot be 'even' in this context.\n    return product.is_integer() and int(product) % 2 == 0"}
{"task_id": "Mbpp/805", "solution": "def max_sum_list(list_of_lists: list[list[int | float]]) -> list[int | float]:\n    \"\"\"\n    Returns the sub-list with the highest sum of elements from a given list of lists.\n    If the input list is empty, an empty list is returned.\n    \"\"\"\n    if not list_of_lists:\n        return []\n\n    max_sum = float('-inf')\n    best_sublist = []\n\n    for sublist in list_of_lists:\n        current_sum = sum(sublist)\n        if current_sum > max_sum:\n            max_sum = current_sum\n            best_sublist = sublist\n\n    return best_sublist"}
{"task_id": "Mbpp/807", "solution": "def first_odd(numbers_list: list[int]) -> int | None:\n    \"\"\"\n    Finds the first odd number in a given list of integers.\n    Returns the first odd number found, or None if no odd numbers are present or the list is empty.\n    \"\"\"\n    for number in numbers_list:\n        if number % 2 != 0:\n            return number\n    return None"}
{"task_id": "Mbpp/806", "solution": "def max_run_uppercase(input_string: str) -> int:\n    \"\"\"\n    Finds the maximum consecutive run of uppercase characters in a string.\n    Returns 0 if the string is empty or contains no uppercase characters.\n    \"\"\"\n    max_run = 0\n    current_run = 0\n    for char in input_string:\n        if char.isupper():\n            current_run += 1\n        else:\n            current_run = 0\n        max_run = max(max_run, current_run)\n    return max_run"}
{"task_id": "Mbpp/808", "solution": "from typing import Any\n\ndef check_K(input_tuple: tuple, k: Any) -> bool:\n    \"\"\"\n    Checks if an element 'k' is present in the 'input_tuple'.\n    \"\"\"\n    return k in input_tuple"}
{"task_id": "Mbpp/809", "solution": "def check_smaller(tuple1: tuple[float | int, ...], tuple2: tuple[float | int, ...]) -> bool:\n    \"\"\"\n    Checks if each element of the second tuple is strictly smaller than its corresponding element in the first tuple.\n    Returns True if every element in tuple2 is strictly smaller than its corresponding element in tuple1, False otherwise.\n    \"\"\"\n    for element1, element2 in zip(tuple1, tuple2):\n        if not (element2 < element1):\n            return False\n    return True"}
{"task_id": "Mbpp/801", "solution": "def test_three_equal(int1: int, int2: int, int3: int) -> int:\n    \"\"\"\n    Counts the number of equal integers among three provided inputs.\n    Returns 3 if all three are equal, 2 if exactly two are equal, or 0 if none are equal.\n    \"\"\"\n    if int1 == int2 == int3:\n        return 3\n    elif int1 == int2 or int1 == int3 or int2 == int3:\n        return 2\n    else:\n        return 0"}
