{"task_id": "Mbpp/410", "solution": "def min_val(input_list: list):\n    \"\"\"\n    Finds the minimum numeric value in a heterogeneous list, ignoring non-numeric elements.\n    Returns None if no numeric elements are found.\n    \"\"\"\n    min_numeric_value = None\n\n    for element in input_list:\n        if isinstance(element, (int, float)):\n            if min_numeric_value is None or element < min_numeric_value:\n                min_numeric_value = element\n    return min_numeric_value"}
{"task_id": "Mbpp/409", "solution": "def _calculate_product_for_tuple(t: tuple[int, int]) -> int:\n    \"\"\"Calculates the product of the two elements in the given tuple.\"\"\"\n    return t[0] * t[1]\n\ndef min_product_tuple(list_of_tuples: list[tuple[int, int]]) -> int:\n    \"\"\"Finds the minimum product from the pairs of tuples within a given list.\"\"\"\n    min_product = float('inf')\n    for current_tuple in list_of_tuples:\n        product_value = _calculate_product_for_tuple(current_tuple)\n        if product_value < min_product:\n            min_product = product_value\n    return min_product"}
{"task_id": "Mbpp/414", "solution": "from typing import Iterable, Any\n\ndef overlapping(sequence1: Iterable[Any], sequence2: Iterable[Any]) -> bool:\n    \"\"\"\n    Checks if any element from sequence1 exists in sequence2.\n    Returns True if at least one common element is found, False otherwise.\n    \"\"\"\n    # Convert sequence2 to a set for efficient O(1) average time complexity lookups.\n    set_sequence2 = set(sequence2)\n    for item in sequence1:\n        if item in set_sequence2:\n            return True\n    return False"}
{"task_id": "Mbpp/418", "solution": "def Find_Max(input_list: list[list]) -> list:\n    \"\"\"\n    Finds the sublist with the maximum length from a given list of lists.\n\n    Args:\n        input_list: A list of lists. Each inner list can contain any elements.\n\n    Returns:\n        The sublist with the maximum length. If the input_list is empty,\n        or contains only empty sublists, an empty list is returned.\n        If multiple sublists share the same maximum length, any one of them\n        may be returned (as per BR4).\n    \"\"\"\n    if not input_list:\n        return []\n\n    max_sublist = []\n    max_length = -1\n\n    for sublist in input_list:\n        current_length = len(sublist)\n        if current_length > max_length:\n            max_length = current_length\n            max_sublist = sublist\n\n    return max_sublist"}
{"task_id": "Mbpp/413", "solution": "def extract_nth_element(list_of_tuples: list[tuple], n: int) -> list:\n    \"\"\"\n    Extracts the nth element from each tuple in a list of tuples.\n    Raises TypeError or IndexError for invalid inputs or data.\n    \"\"\"\n    if not isinstance(list_of_tuples, list):\n        raise TypeError(\"Input 'list_of_tuples' must be a list.\")\n    if not isinstance(n, int):\n        raise TypeError(\"Input 'n' must be an integer.\")\n    if n < 0:\n        raise IndexError(\"Input 'n' must be a non-negative integer.\")\n\n    result_list = []\n    for i, current_tuple in enumerate(list_of_tuples):\n        if not isinstance(current_tuple, tuple):\n            raise TypeError(f\"Element at index {i} in 'list_of_tuples' is not a tuple.\")\n        if len(current_tuple) <= n:\n            raise IndexError(\n                f\"Tuple at index {i} does not have an element at index {n}. \"\n                f\"Tuple: {current_tuple}, Length: {len(current_tuple)}\"\n            )\n        result_list.append(current_tuple[n])\n    return result_list"}
{"task_id": "Mbpp/415", "solution": "def max_Product(arr: list[int]) -> tuple[int, int]:\n    # Finds a pair with the highest product from an array of integers.\n    # Handles positive, negative, and mixed integers efficiently.\n    if len(arr) < 2:\n        raise ValueError(\"Input array must contain at least two integers.\")\n\n    # Sort the array to easily find the largest and smallest numbers.\n    arr.sort()\n\n    # The highest product can be either:\n    # 1. Product of the two largest positive numbers.\n    # 2. Product of the two smallest (most negative) numbers.\n    \n    # Candidate 1: Product of the two largest numbers\n    product1 = arr[-1] * arr[-2]\n    pair1 = (arr[-1], arr[-2])\n\n    # Candidate 2: Product of the two smallest numbers\n    product2 = arr[0] * arr[1]\n    pair2 = (arr[0], arr[1])\n\n    if product1 > product2:\n        return pair1\n    else:\n        # Return pair2, maintaining the order from the input if multiple pairs have the same max product.\n        # The assert example (7,8) implies order doesn't matter, but for consistency with sorted pairs,\n        # we return the pair that corresponds to the higher product.\n        return pair2"}
{"task_id": "Mbpp/420", "solution": "def cube_Sum(n: int) -> int:\n    \"\"\"\n    Calculates the sum of the cubes of the first n even natural numbers.\n    For n=1, sum is (2*1)^3. For n=2, sum is (2*1)^3 + (2*2)^3.\n    \"\"\"\n    total_sum = 0\n    for i in range(1, n + 1):\n        even_num = 2 * i\n        total_sum += even_num ** 3\n    return total_sum"}
{"task_id": "Mbpp/419", "solution": "def round_and_sum(numbers: list[float]) -> float:\n    \"\"\"\n    Rounds every number in a given list, sums the rounded values,\n    then multiplies this sum by the length of the original list.\n    \"\"\"\n    list_length = len(numbers)\n\n    if list_length == 0:\n        return 0.0\n\n    rounded_sum = 0.0\n    for number in numbers:\n        rounded_sum += round(number)\n\n    return rounded_sum * list_length"}
{"task_id": "Mbpp/427", "solution": "class DateComponent:\n    \"\"\"Encapsulates the individual year, month, and day components of a date.\"\"\"\n    def __init__(self, year: str, month: str, day: str):\n        self._year = year\n        self._month = month\n        self._day = day\n\n    def get_year(self) -> str:\n        \"\"\"Returns the year component.\"\"\"\n        return self._year\n\n    def get_month(self) -> str:\n        \"\"\"Returns the month component.\"\"\"\n        return self._month\n\n    def get_day(self) -> str:\n        \"\"\"Returns the day component.\"\"\"\n        return self._day\n\nclass DateString:\n    \"\"\"Represents a date string and provides methods to parse it into components and format components back into a string.\"\"\"\n    def __init__(self, value: str):\n        self._value = value\n        self._date_component = None\n\n    def parse(self, format_str: str):\n        \"\"\"Parses the internal _value into _date_component based on the given format string.\"\"\"\n        if format_str == \"yyyy-mm-dd\":\n            parts = self._value.split('-')\n            self._date_component = DateComponent(parts[0], parts[1], parts[2])\n        # Add other formats if needed based on design.\n\n    def format(self, target_format: str) -> str:\n        \"\"\"Formats the _date_component into a string conforming to the target_format.\"\"\"\n        if self._date_component is None:\n            raise ValueError(\"Date components have not been parsed yet.\")\n\n        if target_format == \"dd-mm-yyyy\":\n            return f\"{self._date_component.get_day()}-{self._date_component.get_month()}-{self._date_component.get_year()}\"\n        # Add other target formats if needed based on design.\n        return \"\" # Default or error handling as per design.\n\ndef change_date_format(date_string: str) -> str:\n    \"\"\"Converts a date of yyyy-mm-dd format to dd-mm-yyyy format.\"\"\"\n    date_obj = DateString(date_string)\n    date_obj.parse(\"yyyy-mm-dd\")\n    formatted_date = date_obj.format(\"dd-mm-yyyy\")\n    return formatted_date"}
{"task_id": "Mbpp/422", "solution": "def find_Average_Of_Cube(n: int) -> float:\n    \"\"\"Calculates the average of the cubes of the first 'n' natural numbers.\n    It sums the cubes of numbers from 1 to n and divides by n.\n    \"\"\"\n    sum_of_cubes = 0.0\n    for i in range(1, n + 1):\n        sum_of_cubes += float(i * i * i)\n\n    average = sum_of_cubes / n\n    return average"}
