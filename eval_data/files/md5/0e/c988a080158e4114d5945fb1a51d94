{"task_id": "Mbpp/97", "solution": "import collections\n\ndef frequency_lists(list_of_lists: list[list]) -> dict:\n    \"\"\"\n    Flattens a list of lists and calculates the frequency of each element.\n    Returns a dictionary where keys are unique elements and values are their frequencies.\n    \"\"\"\n    flattened_list = []\n    for inner_list in list_of_lists:\n        flattened_list.extend(inner_list)\n    return collections.Counter(flattened_list)"}
{"task_id": "Mbpp/100", "solution": "def _is_palindrome(n: int) -> bool:\n    \"\"\"Checks if an integer is a palindrome by comparing its string representation with its reverse.\n    Negative numbers are not considered palindromes in this context.\n    \"\"\"\n    if n < 0:\n        return False\n    s = str(n)\n    return s == s[::-1]\n\ndef next_smallest_palindrome(n: int) -> int:\n    \"\"\"Computes the smallest palindrome that is strictly greater than the input integer.\n\n    It increments the input number until a palindrome is found.\n    \"\"\"\n    current_number = n + 1\n    while True:\n        if _is_palindrome(current_number):\n            return current_number\n        current_number += 1"}
{"task_id": "Mbpp/98", "solution": "def multiply_num(numbers: tuple) -> float:\n    \"\"\"\n    Calculates the product of all numbers in a tuple and divides it by the tuple's length.\n    Returns 0.0 if the input tuple is empty to prevent division by zero.\n    \"\"\"\n    if not numbers:\n        return 0.0\n\n    product = 1.0\n    for num in numbers:\n        product *= num\n\n    length = len(numbers)\n    quotient = product / length\n    return quotient"}
{"task_id": "Mbpp/103", "solution": "def eulerian_num(n: int, m: int) -> int:\n    \"\"\"Calculates the Eulerian number a(n, m) using its recurrence relation.\"\"\"\n    # Handle base cases for the Eulerian number definition.\n    if n == 0 and m == 0:\n        return 1\n    if m < 0 or m >= n:\n        return 0\n    if m == 0:\n        return 1\n\n    # Apply the recurrence relation: a(n, m) = (n - m) * a(n - 1, m - 1) + (m + 1) * a(n - 1, m)\n    return (n - m) * eulerian_num(n - 1, m - 1) + (m + 1) * eulerian_num(n - 1, m)"}
{"task_id": "Mbpp/102", "solution": "def snake_to_camel(snake_case_string: str) -> str:\n    \"\"\"\n    Converts a snake_case string to PascalCase.\n    Example: snake_to_camel('python_program') == 'PythonProgram'\n    \"\"\"\n    if not snake_case_string:\n        return \"\"\n\n    words = snake_case_string.split('_')\n    capitalized_words = [word.capitalize() for word in words]\n    return \"\".join(capitalized_words)"}
