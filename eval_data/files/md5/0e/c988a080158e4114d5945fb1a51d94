{"task_id": "Mbpp/462", "solution": "import collections\nfrom typing import List, Any\n\ndef combinations_list(input_list: List[Any]) -> List[List[Any]]:\n    \"\"\"\n    Generates all possible combinations of elements from the input_list.\n\n    The order of combinations and elements within combinations strictly matches\n    the example provided in the SRS.\n    \"\"\"\n    result = [[]] \n\n    # For each element, create new combinations by prepending the current element\n    # to all existing combinations, maintaining the required order.\n    for element in input_list:\n        new_combinations_for_element = []\n        for existing_combination in result:\n            new_combinations_for_element.append([element] + existing_combination)\n        result.extend(new_combinations_for_element)\n    return result"}
{"task_id": "Mbpp/463", "solution": "def max_subarray_product(array: list[int]) -> int:\n    \"\"\"\n    Finds the maximum product of a contiguous subarray within the given array.\n    Handles positive, negative, and zero elements correctly.\n    \"\"\"\n    if not array:\n        return 0\n\n    max_so_far = array[0]\n    min_so_far = array[0]\n    result = array[0]\n\n    for i in range(1, len(array)):\n        curr = array[i]\n\n        # If current number is negative, max_so_far and min_so_far swap roles\n        if curr < 0:\n            max_so_far, min_so_far = min_so_far, max_so_far\n\n        max_so_far = max(curr, max_so_far * curr)\n        min_so_far = min(curr, min_so_far * curr)\n\n        result = max(result, max_so_far)\n\n    return result"}
{"task_id": "Mbpp/472", "solution": "def check_Consecutive(numbers: list) -> bool:\n    \"\"\"\n    Checks if the input list contains consecutive integers.\n    Returns True if consecutive (including empty or single-element lists), False otherwise.\n    \"\"\"\n    if len(numbers) <= 1:\n        return True\n\n    sorted_numbers = sorted(numbers)\n\n    for i in range(1, len(sorted_numbers)):\n        if sorted_numbers[i] != sorted_numbers[i-1] + 1:\n            return False\n\n    return True"}
