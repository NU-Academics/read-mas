{"task_id": "Mbpp/391", "solution": "def convert_list_dictionary(list1: list[str], list2: list[str], list3: list[int]) -> list[dict[str, dict[str, int]]]:\n    \"\"\"\n    Converts three input lists into a list of nested dictionaries.\n    Raises: ValueError if input lists have unequal lengths.\n    \"\"\"\n    if not (len(list1) == len(list2) == len(list3)):\n        raise ValueError(\"All input lists must have the same number of elements.\")\n\n    result = []\n    for i in range(len(list1)):\n        outer_key = list1[i]\n        inner_key = list2[i]\n        inner_value = list3[i]\n        nested_dict = {inner_key: inner_value}\n        outer_dict = {outer_key: nested_dict}\n        result.append(outer_dict)\n    return result"}
{"task_id": "Mbpp/398", "solution": "def _calculate_individual_digit_sum(number: int) -> int:\n    \"\"\"Calculates the sum of digits for a single integer.\n    Handles positive and negative integers by summing digits of their absolute value.\n    \"\"\"\n    s = 0\n    abs_number = abs(number)\n    for digit_char in str(abs_number):\n        s += int(digit_char)\n    return s\n\ndef sum_of_digits(list_of_numbers: list[int]) -> int:\n    \"\"\"Computes the total sum of digits for each number in a given list.\n    It aggregates the sums of digits of each individual number.\n    \"\"\"\n    total_sum = 0\n    for number in list_of_numbers:\n        individual_sum = _calculate_individual_digit_sum(number)\n        total_sum += individual_sum\n    return total_sum"}
{"task_id": "Mbpp/395", "solution": "import collections\nfrom typing import Optional\n\ndef first_non_repeating_character(input_string: str) -> Optional[str]:\n    \"\"\"Finds the first non-repeated character in a string.\n\n    Args:\n        input_string: The string to analyze.\n\n    Returns:\n        The first non-repeated character (str) or None if no such character exists.\n    \"\"\"\n    char_counts = collections.OrderedDict()\n\n    for char in input_string:\n        char_counts[char] = char_counts.get(char, 0) + 1\n\n    for char, count in char_counts.items():\n        if count == 1:\n            return char\n            \n    return None"}
