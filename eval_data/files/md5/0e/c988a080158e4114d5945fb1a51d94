{"task_id": "Mbpp/470", "solution": "def add_pairwise(input_tuple: tuple) -> tuple:\n    \"\"\"\n    Calculates the pairwise addition of neighboring elements in the given tuple.\n    Returns a new tuple containing the sums of adjacent pairs.\n    \"\"\"\n    if len(input_tuple) < 2:\n        return ()\n\n    sums = [input_tuple[i] + input_tuple[i+1] for i in range(len(input_tuple) - 1)]\n\n    return tuple(sums)"}
{"task_id": "Mbpp/468", "solution": "def max_product(numbers: list[int]) -> int:\n    \"\"\"\n    Calculates the maximum product formed by multiplying numbers of an increasing subsequence.\n\n    Args:\n        numbers: A list of integers.\n\n    Returns:\n        The maximum product found, or 0 if the input list is empty or contains only non-positive numbers\n        such that no increasing subsequence yields a positive product.\n    \"\"\"\n    if not numbers:\n        return 0\n\n    n = len(numbers)\n    # dp[i] stores the maximum product of an increasing subsequence ending at index i\n    dp = [num for num in numbers]\n\n    max_overall_product = 0\n    # Initialize max_overall_product with the largest single number if available.\n    if numbers:\n        max_overall_product = max(numbers)\n\n    for i in range(n):\n        for j in range(i):\n            if numbers[i] > numbers[j]:\n                # Only update if multiplying by numbers[i] results in a larger product,\n                # and the previous product dp[j] was positive.\n                if dp[j] > 0:\n                    dp[i] = max(dp[i], dp[j] * numbers[i])\n        max_overall_product = max(max_overall_product, dp[i])\n\n    return max_overall_product"}
{"task_id": "Mbpp/471", "solution": "def find_remainder(arr: list[int], n: int) -> int:\n    \"\"\"\n    Calculates the product of all integers in the given array modulo n.\n\n    Args:\n        arr: A list of integers.\n        n: The modulus value.\n\n    Returns:\n        The remainder of the product when divided by n.\n    \"\"\"\n    product = 1\n    for x in arr:\n        product = (product * x) % n\n    return product"}
{"task_id": "Mbpp/473", "solution": "from typing import List, Tuple, Set, Any\n\ndef _get_canonical_tuple(t: Tuple[Any, ...]) -> Tuple[Any, ...]:\n    \"\"\"Sorts elements of a tuple to create a canonical representation for order-agnostic comparison.\"\"\"\n    return tuple(sorted(t))\n\ndef tuple_intersection(list1: List[Tuple[Any, ...]], list2: List[Tuple[Any, ...]]) -> Set[Tuple[Any, ...]]:\n    \"\"\"\n    Finds the intersection of two lists of tuples, ignoring element order.\n    Returns a set of unique canonical tuples.\n    \"\"\"\n    canonical_set1 = {_get_canonical_tuple(t) for t in list1}\n    canonical_set2 = {_get_canonical_tuple(t) for t in list2}\n    return canonical_set1.intersection(canonical_set2)"}
