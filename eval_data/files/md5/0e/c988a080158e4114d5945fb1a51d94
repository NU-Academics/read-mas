{"task_id": "Mbpp/286", "solution": "import math\n\ndef _kadane(arr_input: list[int]) -> int:\n    \"\"\"\n    Finds the maximum contiguous subarray sum using Kadane's algorithm.\n    This handles arrays with all negative numbers correctly by returning the largest single element.\n    \"\"\"\n    if not arr_input:\n        # Based on problem constraints, arr is not empty (n is length of arr).\n        # This case is a safeguard, but generally not reached for valid inputs.\n        return 0 \n    \n    max_so_far = arr_input[0]\n    current_max = arr_input[0]\n\n    for i in range(1, len(arr_input)):\n        current_max = max(arr_input[i], current_max + arr_input[i])\n        max_so_far = max(max_so_far, current_max)\n    \n    return max_so_far\n\ndef _max_prefix_sum(arr_input: list[int]) -> int:\n    \"\"\"\n    Calculates the maximum prefix sum of an array, including sums of single elements and cumulative sums from the beginning.\n    \"\"\"\n    if not arr_input:\n        return -math.inf \n\n    max_p_sum = -math.inf\n    current_p_sum = 0\n\n    for num in arr_input:\n        current_p_sum += num\n        max_p_sum = max(max_p_sum, current_p_sum)\n    \n    return max_p_sum\n\ndef _max_suffix_sum(arr_input: list[int]) -> int:\n    \"\"\"\n    Calculates the maximum suffix sum of an array, including sums of single elements and cumulative sums from the end.\n    \"\"\"\n    if not arr_input:\n        return -math.inf\n\n    max_s_sum = -math.inf\n    current_s_sum = 0\n\n    for num in reversed(arr_input):\n        current_s_sum += num\n        max_s_sum = max(max_s_sum, current_s_sum)\n    \n    return max_s_sum\n\ndef max_sub_array_sum_repeated(arr: list[int], n: int, k: int) -> int:\n    \"\"\"\n    Finds the largest sum of a contiguous array in the modified array which is formed by\n    repeating the given array k times.\n    \"\"\"\n    if k == 1:\n        return _kadane(arr)\n    \n    total_sum = sum(arr)\n    max_p_sum = _max_prefix_sum(arr)\n    max_s_sum = _max_suffix_sum(arr)\n\n    # Calculate max subarray sum within `arr + arr` to cover subarrays\n    # that span across one boundary of the original array.\n    max_sum_double_arr = _kadane(arr + arr)\n    \n    if total_sum > 0:\n        # If the total sum of the array is positive, repeating it multiple times\n        # can potentially increase the maximum subarray sum.\n        # The maximum sum could be a combination of a max suffix from the first part,\n        # (k-2) full repetitions of the array, and a max prefix from the last part.\n        max_sum_across_multiple_blocks = max_p_sum + max_s_sum + (k - 2) * total_sum\n        return max(max_sum_double_arr, max_sum_across_multiple_blocks)\n    else:\n        # If the total sum of the array is non-positive, repeating it more times\n        # will not help or might decrease the sum.\n        # In this case, the maximum sum will always be contained within the first two repetitions.\n        return max_sum_double_arr"}
