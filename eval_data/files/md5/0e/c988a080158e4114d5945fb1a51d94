{"task_id": "Mbpp/593", "solution": "def removezero_ip(ip_address_string: str) -> str:\n    \"\"\"\n    Removes leading zeroes from each octet of an IP address string.\n    Converts each octet to an integer and then back to a string to achieve this.\n    \"\"\"\n    def _remove_leading_zeroes_from_octet(octet_string: str) -> str:\n        \"\"\"\n        Helper to remove leading zeroes from a single octet string.\n        It converts the string to an integer and then back to a string.\n        \"\"\"\n        return str(int(octet_string))\n\n    octets = ip_address_string.split('.')\n    processed_octets = [_remove_leading_zeroes_from_octet(octet) for octet in octets]\n    return \".\".join(processed_octets)"}
{"task_id": "Mbpp/594", "solution": "def diff_even_odd(numbers: list) -> int:\n    \"\"\"\n    Calculates the difference between the first even and first odd number\n    found in the input list. (first_even - first_odd)\n    \"\"\"\n    first_even = None\n    first_odd = None\n\n    for number in numbers:\n        if first_even is None and number % 2 == 0:\n            first_even = number\n        if first_odd is None and number % 2 != 0:\n            first_odd = number\n        \n        if first_even is not None and first_odd is not None:\n            break\n\n    if first_even is None:\n        raise ValueError(\"No even number found in the list.\")\n    if first_odd is None:\n        raise ValueError(\"No odd number found in the list.\")\n        \n    return first_even - first_odd"}
{"task_id": "Mbpp/590", "solution": "import math\n\ndef polar_rect(r: float, theta: float) -> tuple[float, float]:\n    \"\"\"\n    Converts polar coordinates (r, theta) to rectangular coordinates (x, y).\n    \"\"\"\n    x = r * math.cos(theta)\n    y = r * math.sin(theta)\n    return (x, y)"}
{"task_id": "Mbpp/592", "solution": "import math\n\ndef factorial(num: int) -> int:\n    \"\"\"Calculates the factorial of a non-negative integer.\"\"\"\n    return math.factorial(num)\n\ndef binomial_coefficient(n: int, k: int) -> int:\n    \"\"\"Calculates the binomial coefficient C(n, k).\"\"\"\n    if k < 0 or k > n:\n        return 0\n    return math.comb(n, k)\n\ndef sum_Of_product(n: int) -> int:\n    \"\"\"\n    Finds the sum of the product of consecutive binomial coefficients for a given 'n'.\n    The sum is calculated for k from 0 to n-1.\n    \"\"\"\n    if n == 0:\n        return 0\n\n    total_sum = 0\n    for k in range(n):\n        product = binomial_coefficient(n, k) * binomial_coefficient(n, k + 1)\n        total_sum += product\n    return total_sum"}
