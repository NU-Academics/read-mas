{"task_id": "Mbpp/285", "solution": "import re\n\nclass Pattern:\n    \"\"\"Encapsulates a regular expression pattern and provides a method to match it against a string.\"\"\"\n    def __init__(self, regex: str):\n        self._regex = regex\n\n    def match(self, input_string: str) -> bool:\n        \"\"\"Checks if the input_string contains this pattern using regular expression search.\"\"\"\n        return re.search(self._regex, input_string) is not None\n\nclass PatternMatcher:\n    \"\"\"Orchestrates the matching process for a given string against a specific pattern.\"\"\"\n    def check(self, input_string: str, target_pattern: Pattern) -> bool:\n        \"\"\"Determines if the input_string contains the target_pattern.\"\"\"\n        return target_pattern.match(input_string)\n\ndef text_match_two_three(input_string: str) -> bool:\n    \"\"\"Checks if an input string contains 'abb' or 'abbb' using a modular pattern matching system.\"\"\"\n    pattern_matcher = PatternMatcher()\n    pattern_abb = Pattern(\"abb\")\n    pattern_abbb = Pattern(\"abbb\")\n\n    match_abb = pattern_matcher.check(input_string, pattern_abb)\n    match_abbb = pattern_matcher.check(input_string, pattern_abbb)\n\n    return match_abb or match_abbb"}
{"task_id": "Mbpp/283", "solution": "def validate(integer: int) -> bool:\n    \"\"\"\n    Checks if the frequency of each digit in the integer is less than or equal to the digit itself.\n    \"\"\"\n    s_integer = str(integer)\n    digit_counts = {}\n\n    for char_digit in s_integer:\n        digit_counts[char_digit] = digit_counts.get(char_digit, 0) + 1\n\n    for char_digit, count in digit_counts.items():\n        digit_value = int(char_digit)\n        if count > digit_value:\n            return False\n            \n    return True"}
