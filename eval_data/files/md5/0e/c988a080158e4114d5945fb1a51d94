{"task_id": "Mbpp/2", "solution": "from typing import Iterable, Any\n\ndef similar_elements(list1: Iterable[Any], list2: Iterable[Any]) -> Set[Any]:\n    \"\"\"\n    Finds and returns the shared elements between two given iterables.\n    It converts inputs to sets for efficient intersection.\n    \"\"\"\n    set1 = set(list1)\n    set2 = set(list2)\n    return set1.intersection(set2)"}
{"task_id": "Mbpp/6", "solution": "def differ_At_One_Bit_Pos(num1: int, num2: int) -> bool:\n    \"\"\"\n    Evaluates if the binary representations of two input numbers differ at exactly one bit position.\n    This function calculates the XOR of the numbers and counts set bits.\n    \"\"\"\n    xor_result = num1 ^ num2\n\n    set_bits_count = 0\n    while xor_result > 0:\n        xor_result &= (xor_result - 1)\n        set_bits_count += 1\n\n    return set_bits_count == 1"}
{"task_id": "Mbpp/9", "solution": "def find_Rotations(input_string: str) -> int:\n    \"\"\"Calculates the minimum number of rotations (greater than 0) required to get the same string.\n\n    A rotation moves the first character of the string to its end.\n    \"\"\"\n    original_string = input_string\n    current_string = input_string\n    rotation_count = 0\n\n    # According to business rules (BR1, BR5), rotations must be greater than 0.\n    # An empty string is considered to require 1 rotation.\n    if not input_string:\n        return 1\n\n    # Loop indefinitely until the original string is found again.\n    # This loop ensures at least one rotation for any non-empty string.\n    while True:\n        # Perform one rotation: move the first character to the end.\n        current_string = current_string[1:] + current_string[0]\n        rotation_count += 1\n\n        # Break if the string has returned to its original state.\n        if current_string == original_string:\n            break\n            \n    return rotation_count"}
{"task_id": "Mbpp/8", "solution": "def square_nums(numbers: list[int | float]) -> list[int | float]:\n    \"\"\"Calculates the square of each individual element in a list.\n\n    Returns a new list containing the squares of the individual elements.\n    \"\"\"\n    return [num * num for num in numbers]"}
{"task_id": "Mbpp/3", "solution": "import math\n\ndef is_not_prime(n: int) -> bool:\n    \"\"\"Evaluates whether a given integer 'n' is a non-prime number.\n    Returns True if 'n' is non-prime, False if 'n' is prime.\n    \"\"\"\n    if n <= 1:\n        return True\n    if n == 2:\n        return False\n    if n % 2 == 0:  # Even numbers greater than 2 are non-prime\n        return True\n\n    # Check for divisors from 3 up to sqrt(n), skipping even numbers\n    for i in range(3, int(math.sqrt(n)) + 1, 2):\n        if n % i == 0:\n            return True\n    return False"}
{"task_id": "Mbpp/7", "solution": "def find_char_long(input_string: str) -> set[str]:\n    \"\"\"\n    Finds all unique words in a string that are at least 4 characters long.\n    Splits the input string into words, filters by length, and collects unique words into a set.\n    \"\"\"\n    filtered_words = set()\n    words = input_string.split(' ')\n    for word in words:\n        if len(word) >= 4:\n            filtered_words.add(word)\n    return filtered_words"}
{"task_id": "Mbpp/4", "solution": "import heapq\n\ndef heap_queue_largest(numbers: list[int], n: int) -> list[int]:\n    \"\"\"\n    Finds the n largest integers from a given list of numbers, returned in descending order.\n    Handles edge cases for n (e.g., n=0, n greater than list length).\n    \"\"\"\n    if n <= 0 or not numbers:\n        return []\n\n    if n >= len(numbers):\n        return sorted(numbers, reverse=True)\n\n    # heapq.nlargest efficiently finds the n largest elements and returns them in descending order.\n    return heapq.nlargest(n, numbers)"}
{"task_id": "Mbpp/11", "solution": "def remove_Occ(input_string: str, char_to_remove: str) -> str:\n    \"\"\"\n    Removes the first and last occurrences of a given character from the string.\n    If the character is not found, the original string is returned.\n    If the character occurs only once, that single occurrence is removed.\n    \"\"\"\n    first_idx = input_string.find(char_to_remove)\n\n    if first_idx == -1:\n        return input_string\n\n    last_idx = input_string.rfind(char_to_remove)\n\n    if first_idx == last_idx:\n        # Character appears only once, remove it\n        return input_string[:first_idx] + input_string[first_idx+1:]\n    else:\n        # Character appears multiple times\n        # Remove the first occurrence\n        temp_string = input_string[:first_idx] + input_string[first_idx+1:]\n        \n        # Find the last occurrence in the temporary string and remove it\n        last_idx_in_temp = temp_string.rfind(char_to_remove)\n        return temp_string[:last_idx_in_temp] + temp_string[last_idx_in_temp+1:]"}
{"task_id": "Mbpp/17", "solution": "def square_perimeter(side_length: float) -> float:\n    \"\"\"Calculates the perimeter of a square.\n    It takes the side length as input and returns the total length of its boundaries.\n    \"\"\"\n    return 4 * side_length"}
{"task_id": "Mbpp/12", "solution": "def sort_matrix(matrix: list[list[int | float]]) -> list[list[int | float]]:\n    \"\"\"\n    Sorts a given matrix in ascending order according to the sum of its rows.\n    Uses a helper function to calculate the sum of individual rows.\n    \"\"\"\n    def _get_row_sum(row: list[int | float]) -> int | float:\n        \"\"\"Calculates and returns the sum of elements in a given row.\"\"\"\n        return sum(row)\n\n    # Sort the matrix using a lambda function that calls the helper for the key\n    return sorted(matrix, key=_get_row_sum)"}
{"task_id": "Mbpp/14", "solution": "def find_Volume(base: float, height: float, length: float) -> float:\n    \"\"\"\n    Calculates the volume of a triangular prism.\n\n    Raises:\n        ValueError: If any dimension (base, height, length) is not a positive number.\n    \"\"\"\n    if not (base > 0 and height > 0 and length > 0):\n        raise ValueError(\"All dimensions (base, height, length) must be positive numbers.\")\n\n    volume = 0.5 * base * height * length\n    return volume"}
{"task_id": "Mbpp/16", "solution": "import re\n\n_PATTERN_REGEX = r'[a-z]+_[a-z]+'\n\ndef text_lowercase_underscore(input_string: str) -> bool:\n    \"\"\"Returns true if the input string contains sequences of lowercase letters\n    joined with an underscore and false otherwise.\n    \"\"\"\n    return re.search(_PATTERN_REGEX, input_string) is not None"}
{"task_id": "Mbpp/20", "solution": "def is_woodall(number: int) -> bool:\n    \"\"\"\n    Checks if the given number is a Woodall number.\n    A number N is a Woodall number if it can be expressed in the form n * 2^n - 1 for some integer n >= 1.\n    \"\"\"\n    if number < 1:\n        return False\n\n    n = 1\n    while True:\n        woodall_candidate = n * (2**n) - 1\n        if woodall_candidate == number:\n            return True\n        elif woodall_candidate > number:\n            return False\n        n += 1"}
{"task_id": "Mbpp/18", "solution": "def remove_dirty_chars(primary_string: str, chars_to_remove_string: str) -> str:\n    # Create a set of characters to be removed for efficient lookup.\n    chars_to_remove_set = set(chars_to_remove_string)\n    \n    # Build the result string by appending characters not in the removal set.\n    result_chars = []\n    for char in primary_string:\n        if char not in chars_to_remove_set:\n            result_chars.append(char)\n            \n    return \"\".join(result_chars)"}
{"task_id": "Mbpp/19", "solution": "def test_duplicate(arr: list[int]) -> bool:\n    \"\"\"\n    Checks if a list of integers contains any duplicate elements.\n    It uses a set to keep track of seen elements for efficient lookup.\n    \"\"\"\n    seen_elements = set()\n    for element in arr:\n        if element in seen_elements:\n            return True\n        seen_elements.add(element)\n    return False"}
{"task_id": "Mbpp/56", "solution": "def _reverse_number(number: int) -> int:\n    \"\"\"Helper function to reverse the digits of an integer.\"\"\"\n    reversed_num = 0\n    original_num = number # store original for loop\n    while original_num > 0:\n        digit = original_num % 10\n        reversed_num = reversed_num * 10 + digit\n        original_num //= 10\n    return reversed_num\n\ndef check(number: int) -> bool:\n    \"\"\"Checks if a given number is one less than twice its reverse.\"\"\"\n    reversed_num = _reverse_number(number)\n    return number == (2 * reversed_num) - 1"}
{"task_id": "Mbpp/59", "solution": "def is_octagonal(n: int) -> int:\n    \"\"\"\n    Calculates the nth octagonal number using the formula O_n = n * (3n - 2).\n    \"\"\"\n    return n * (3 * n - 2)"}
{"task_id": "Mbpp/58", "solution": "def opposite_Signs(integer1: int, integer2: int) -> bool:\n    \"\"\"\n    Checks if two integers have opposite signs.\n    Returns True if one integer is positive and the other is negative, False otherwise.\n    \"\"\"\n    if integer1 == 0 or integer2 == 0:\n        return False\n    \n    return (integer1 > 0 and integer2 < 0) or (integer1 < 0 and integer2 > 0)"}
{"task_id": "Mbpp/57", "solution": "import functools\n\ndef find_Max_Num(digits: list[int]) -> int:\n    \"\"\"\n    Finds the largest number that can be formed by concatenating the given list of digits.\n    Handles an empty input list by returning 0.\n    \"\"\"\n    if not digits:\n        return 0\n\n    str_digits = [str(d) for d in digits]\n\n    def compare_strings(a_str, b_str):\n        # Compare numbers formed by concatenating a_str and b_str in both orders.\n        # Return -1 if a_str should precede b_str, 1 if it should follow.\n        if int(a_str + b_str) > int(b_str + a_str):\n            return -1\n        elif int(a_str + b_str) < int(b_str + a_str):\n            return 1\n        else:\n            return 0\n\n    sorted_str_digits = sorted(str_digits, key=functools.cmp_to_key(compare_strings))\n\n    largest_num_str = \"\".join(sorted_str_digits)\n\n    return int(largest_num_str)"}
{"task_id": "Mbpp/61", "solution": "class Substring:\n    \"\"\"Represents a contiguous substring and calculates its sum of digits and length.\"\"\"\n    def __init__(self, value: str):\n        self._value = value\n        self._length = len(value)\n        self._sum_of_digits = sum(int(digit) for digit in value)\n\n    def get_length(self) -> int:\n        \"\"\"Returns the length of the substring.\"\"\"\n        return self._length\n\n    def get_sum_of_digits(self) -> int:\n        \"\"\"Returns the sum of digits of the substring.\"\"\"\n        return self._sum_of_digits\n\n    def is_valid(self) -> bool:\n        \"\"\"Checks if the sum of digits equals the length.\"\"\"\n        return self._sum_of_digits == self._length\n\nclass SubstringCounter:\n    \"\"\"Manages the process of generating substrings and counting valid ones.\"\"\"\n    def __init__(self):\n        self._total_count = 0\n\n    def count_valid_substrings(self, input_string_value: str) -> int:\n        \"\"\"Generates all substrings, evaluates them, and returns the total count.\"\"\"\n        n = len(input_string_value)\n        for i in range(n):\n            for j in range(i + 1, n + 1):\n                substring_value = input_string_value[i:j]\n                substring_entity = Substring(substring_value)\n                if substring_entity.is_valid():\n                    self._total_count += 1\n        return self._total_count\n\ndef count_Substrings(input_string: str) -> int:\n    \"\"\"Provides the public API for initiating the substring counting process.\"\"\"\n    counter = SubstringCounter()\n    return counter.count_valid_substrings(input_string)"}
{"task_id": "Mbpp/63", "solution": "import math\nfrom typing import List, Tuple, Union\n\nNumber = Union[int, float]\n\ndef max_difference(tuple_list: List[Tuple[Number, Number]]) -> Number:\n    \"\"\"\n    Calculates the maximum absolute difference between available pairs in the given tuple list.\n    Returns 0.0 if the input list is empty.\n    \"\"\"\n    if not tuple_list:\n        return 0.0\n\n    max_diff = 0.0\n    for val1, val2 in tuple_list:\n        current_diff = math.fabs(val1 - val2)\n        if current_diff > max_diff:\n            max_diff = current_diff\n\n    return max_diff"}
{"task_id": "Mbpp/62", "solution": "from typing import List, Union\n\ndef smallest_num(numbers: List[Union[int, float]]) -> Union[int, float]:\n    \"\"\"\n    Identifies and returns the smallest numeric value from a given list of numbers.\n    Raises ValueError if the input list is empty or TypeError for non-numeric elements.\n    \"\"\"\n    if not numbers:\n        raise ValueError(\"Input list cannot be empty.\")\n    return min(numbers)"}
