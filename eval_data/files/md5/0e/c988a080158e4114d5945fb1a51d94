{"task_id": "Mbpp/614", "solution": "def cummulative_sum(list_of_tuples: list[tuple[int | float, ...]]) -> int | float:\n    \"\"\"Calculates the cumulative sum of all numeric values in a list of tuples.\"\"\"\n    total_sum = 0\n    for current_tuple in list_of_tuples:\n        for value in current_tuple:\n            total_sum += value\n    return total_sum"}
{"task_id": "Mbpp/610", "solution": "def remove_kth_element(input_list: list, k: int) -> list:\n    \"\"\"\n    Returns a new list with the k'th element (1-based index) removed.\n\n    Args:\n        input_list: The list from which an element is to be removed.\n        k: An integer representing the 1-based index of the element to remove.\n\n    Returns:\n        A new list with the k-th element removed.\n\n    Raises:\n        TypeError: If input_list is not a list or k is not an integer.\n        IndexError: If k is out of the valid 1-based index range for input_list.\n    \"\"\"\n    if not isinstance(input_list, list):\n        raise TypeError(\"input_list must be a list\")\n    if not isinstance(k, int):\n        raise TypeError(\"k must be an integer\")\n    if not input_list:\n        raise IndexError(\"Cannot remove element from an empty list.\")\n    if not (1 <= k <= len(input_list)):\n        raise IndexError(f\"k ({k}) is out of bounds for list of length {len(input_list)}. Must be between 1 and {len(input_list)} (inclusive).\")\n\n    # Convert 1-based k to 0-based index\n    zero_based_k = k - 1\n\n    # Create a new list by slicing, excluding the element at zero_based_k\n    new_list = input_list[:zero_based_k] + input_list[zero_based_k + 1:]\n    return new_list"}
{"task_id": "Mbpp/588", "solution": "def big_diff(input_list: list) -> int | float:\n    \"\"\"Calculates the difference between the largest and smallest numeric values in a list.\n    Raises ValueError if the input list is empty.\n    \"\"\"\n    if not input_list:\n        raise ValueError(\"Input list cannot be empty.\")\n\n    largest_value = max(input_list)\n    smallest_value = min(input_list)\n    calculated_difference = largest_value - smallest_value\n\n    return calculated_difference"}
{"task_id": "Mbpp/611", "solution": "import math\n\ndef max_of_nth(matrix, n):\n    \"\"\"\n    Given a matrix (list of lists) and a column index n, returns the maximum value in that column.\n    Assumes valid input: matrix is non-empty, n is within bounds, and all elements are comparable.\n    \"\"\"\n    max_val = -math.inf\n    for row in matrix:\n        if n < len(row):\n            max_val = max(max_val, row[n])\n    return max_val"}
{"task_id": "Mbpp/615", "solution": "def average_tuple(data: tuple[tuple[int | float, ...], ...]) -> list[float]:\n    \"\"\"\n    Calculates the average value for each inner tuple within a tuple of tuples.\n    Returns a list of floats, where each float is the average of a corresponding inner tuple.\n    \"\"\"\n    averages = []\n    for inner_tuple in data:\n        averages.append(sum(inner_tuple) / len(inner_tuple))\n    return averages"}
{"task_id": "Mbpp/619", "solution": "def move_num(input_string: str) -> str:\n    # Separates a string into non-numeric and numeric characters,\n    # then concatenates them with numbers at the end.\n    non_numeric_chars = []\n    numeric_chars = []\n    for char in input_string:\n        if '0' <= char <= '9':  # Check if character is a digit\n            numeric_chars.append(char)\n        else:\n            non_numeric_chars.append(char)\n    return \"\".join(non_numeric_chars) + \"\".join(numeric_chars)"}
{"task_id": "Mbpp/618", "solution": "def div_list(list1: list, list2: list) -> list:\n    \"\"\"Performs element-wise division of two lists, returning a new list of float results.\"\"\"\n    if len(list1) != len(list2):\n        raise ValueError(\"Lists must have the same length\")\n\n    results = []\n    for i in range(len(list1)):\n        numerator = list1[i]\n        divisor = list2[i]\n        if divisor == 0:\n            raise ZeroDivisionError(\"Cannot divide by zero\")\n        results.append(float(numerator) / divisor)\n    return results"}
{"task_id": "Mbpp/616", "solution": "def tuple_modulo(tuple1: tuple[int | float], tuple2: tuple[int | float]) -> tuple[int | float]:\n    \"\"\"\n    Performs element-wise modulo operation on two tuples of equal length.\n    Returns a new tuple with the results.\n    \"\"\"\n    result = []\n    for i in range(len(tuple1)):\n        val1 = tuple1[i]\n        val2 = tuple2[i]\n        result.append(val1 % val2)\n    return tuple(result)"}
{"task_id": "Mbpp/623", "solution": "class PowerCalculator:\n    \"\"\"\n    Encapsulates the stateless logic for computing the n-th power of numbers in a list.\n    \"\"\"\n    def compute_nth_power(self, input_list: list, n: int) -> list:\n        \"\"\"\n        Iterates through the input_list, calculates the n-th power for each number,\n        and returns a new list of results.\n        \"\"\"\n        result = [num ** n for num in input_list]\n        return result\n\ndef nth_nums(input_list: list, n: int) -> list:\n    \"\"\"\n    Computes the n-th power for each number in the input_list and returns a new list of the results.\n    Delegates the core computation to a PowerCalculator instance.\n    \"\"\"\n    calculator = PowerCalculator()\n    return calculator.compute_nth_power(input_list, n)"}
{"task_id": "Mbpp/622", "solution": "def get_median(list1: list[int | float], list2: list[int | float], size: int) -> float:\n    \"\"\"\n    Finds the median of two sorted lists of the same size.\n    It simulates merging the lists and finds the two middle elements.\n    \"\"\"\n    i = 0  # Current index for list1\n    j = 0  # Current index for list2\n    m1 = 0.0  # Stores the (size-1)-th element\n    m2 = 0.0  # Stores the size-th element\n\n    # Iterate size + 1 times to find the two middle elements\n    for count in range(size + 1):\n        m1 = m2  # Update m1 to the previous m2 value\n\n        if i == size:  # If list1 is exhausted, take from list2\n            m2 = float(list2[j])\n            j += 1\n        elif j == size:  # If list2 is exhausted, take from list1\n            m2 = float(list1[i])\n            i += 1\n        elif list1[i] < list2[j]:  # Compare elements and take the smaller one\n            m2 = float(list1[i])\n            i += 1\n        else:  # If list2[j] is smaller or equal, take from list2\n            m2 = float(list2[j])\n            j += 1\n            \n    return (m1 + m2) / 2.0"}
