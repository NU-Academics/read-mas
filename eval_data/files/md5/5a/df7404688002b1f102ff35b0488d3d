{"task_id": "HumanEval/99", "solution": "def closest_integer(value):\n    \"\"\"\n    Finds the closest integer to a numeric string, rounding away from zero for equidistant values.\n    \"\"\"\n    import math\n\n    f = float(value)\n\n    floor_val = math.floor(f)\n    ceil_val = math.ceil(f)\n\n    diff_to_floor = f - floor_val\n    diff_to_ceil = ceil_val - f\n\n    if diff_to_floor < diff_to_ceil:\n        return int(floor_val)\n    elif diff_to_ceil < diff_to_floor:\n        return int(ceil_val)\n    else:  # The number is equidistant from two integers (e.g., X.5)\n        if f >= 0:\n            return int(ceil_val)  # Round up for positive numbers (away from zero)\n        else:\n            return int(floor_val) # Round down for negative numbers (away from zero)"}
{"task_id": "HumanEval/100", "solution": "```python\ndef make_a_pile(n):\n    \"\"\"\n    Given a positive integer n, you have to make a pile of n levels of stones.\n    The first level has n stones.\n    The number of stones in the next level is:\n        - the next odd number if n is odd.\n        - the next even number if n is even.\n    Return the number of stones in each level in a list, where element at index\n    i represents the number of stones in the level (i+1).\n    \"\"\"\n    pile = []\n    current_stones = n\n    for _ in range(n):\n        pile.append(current_stones)\n        current_stones += 2\n    return pile\n```"}
{"task_id": "HumanEval/101", "solution": "def words_string(s):\n    \"\"\"\n    Splits a string into words using commas and spaces as delimiters, returning an array of the words.\n    Empty tokens resulting from multiple delimiters or leading/trailing separators are ignored.\n    \"\"\"\n    # Replace all commas with spaces to unify delimiters.\n    s_modified = s.replace(',', ' ')\n    # Split the string by whitespace. The split() method (without arguments)\n    # automatically handles multiple spaces and trims leading/trailing whitespace,\n    # effectively ignoring empty tokens.\n    words = s_modified.split()\n    return words"}
{"task_id": "HumanEval/102", "solution": "```python\ndef choose_num(x, y):\n    \"\"\"This function finds the biggest even integer within the range [x, y].\n    Returns -1 if no such even integer exists or if the range is invalid.\n    \"\"\"\n    if x <= 0 or y <= 0:\n        return -1\n\n    # Ensure x is the lower bound and y is the upper bound for iteration\n    # Although the problem statement implies x and y define a range, \n    # the example choose_num(13, 12) = -1 shows that a swapped range is considered invalid\n    # for finding a number *in* [x,y].\n    if x > y:\n        return -1\n\n    # Start checking from y downwards, as we need the biggest even number\n    # If y is even, then y itself is a candidate.\n    # If y is odd, then y-1 is the next candidate (if y-1 >= x).\n    \n    # Calculate the largest even number less than or equal to y\n    candidate = y - (y % 2)\n\n    # Check if this candidate is within the given range [x, y]\n    if candidate >= x:\n        return candidate\n    else:\n        # If the largest even number less than or equal to y is smaller than x,\n        # then no even number exists in the range [x, y].\n        return -1\n```"}
{"task_id": "HumanEval/104", "solution": "def unique_digits(x):\n    \"\"\"Given a list of positive integers x. return a sorted list of all \n    elements that hasn't any even digit.\n    \"\"\"\n\n    def _has_even_digit(n):\n        \"\"\"Checks if an integer n contains any even digits.\"\"\"\n        s = str(n)\n        for digit_char in s:\n            digit = int(digit_char)\n            if digit % 2 == 0:\n                return True\n        return False\n\n    result = []\n    for num in x:\n        if not _has_even_digit(num):\n            result.append(num)\n            \n    result.sort()\n    return result"}
{"task_id": "HumanEval/103", "solution": "def rounded_avg(n, m):\n    \"\"\"You are given two positive integers n and m, and your task is to compute the\n    average of the integers from n through m (including n and m). \n    Round the answer to the nearest integer and convert that to binary.\n    If n is greater than m, return -1.\n    \"\"\"\n    if n > m:\n        return -1\n    \n    # Calculate the average of integers from n to m.\n    # The average of an arithmetic series is (first + last) / 2.\n    average = (n + m) / 2.0\n    \n    # Round the average to the nearest integer. Python's round() handles .5 by rounding to the nearest even number.\n    rounded_value = round(average)\n    \n    # Convert the rounded integer to a binary string.\n    binary_string = bin(rounded_value)\n    \n    return binary_string"}
{"task_id": "HumanEval/106", "solution": "def f(n):\n    \"\"\" Implement the function f that takes n as a parameter,\n    and returns a list of size n, such that the value of the element at index i is the factorial of i if i is even\n    or the sum of numbers from 1 to i otherwise.\n    i starts from 1.\n    the factorial of i is the multiplication of the numbers from 1 to i (1 * 2 * ... * i).\n    Example:\n    f(5) == [1, 2, 6, 24, 15]\n    \"\"\"\n    result = []\n    for i in range(1, n + 1):\n        if i % 2 == 0:  # i is even\n            # Calculate factorial of i\n            factorial_val = 1\n            for j in range(1, i + 1):\n                factorial_val *= j\n            result.append(factorial_val)\n        else:  # i is odd\n            # Calculate sum of numbers from 1 to i\n            sum_val = i * (i + 1) // 2\n            result.append(sum_val)\n    return result"}
{"task_id": "HumanEval/105", "solution": "def by_length(arr):\n    \"\"\"\n    Processes an array of integers by filtering, sorting, reversing, and converting valid digits to names.\n    \"\"\"\n    digit_names = {\n        1: \"One\", 2: \"Two\", 3: \"Three\", 4: \"Four\", 5: \"Five\",\n        6: \"Six\", 7: \"Seven\", 8: \"Eight\", 9: \"Nine\"\n    }\n\n    # Filter integers between 1 and 9 inclusive\n    filtered_arr = [num for num in arr if 1 <= num <= 9]\n\n    # Sort the filtered integers in ascending order\n    filtered_arr.sort()\n\n    # Reverse the sorted array\n    filtered_arr.reverse()\n\n    # Replace each digit by its corresponding name\n    result = [digit_names[num] for num in filtered_arr]\n\n    return result"}
{"task_id": "HumanEval/108", "solution": "def count_nums(arr):\n    \"\"\"\n    Counts elements in an array whose digit sum (with specific negative number rule) is > 0.\n    \"\"\"\n    def _digit_sum(n):\n        \"\"\"Calculates the sum of digits, treating the first digit of a negative number as negative.\"\"\"\n        if n == 0:\n            return 0\n\n        s_abs = str(abs(n))\n        current_sum = 0\n\n        # Handle the first digit: it's negative if the original number was negative, otherwise positive.\n        if n < 0:\n            current_sum -= int(s_abs[0])\n        else:\n            current_sum += int(s_abs[0])\n\n        # Sum the remaining digits, which are always treated as positive.\n        for digit_char in s_abs[1:]:\n            current_sum += int(digit_char)\n\n        return current_sum\n\n    count = 0\n    for num in arr:\n        if _digit_sum(num) > 0:\n            count += 1\n    return count"}
{"task_id": "HumanEval/107", "solution": "from typing import Tuple\n\nclass InputValidator:\n    def __init__(self, n: int):\n        self.n = n\n\n    def is_valid(self) -> bool:\n        \"\"\"Checks if n is a valid integer between 1 and 1000.\"\"\"\n        return isinstance(self.n, int) and 1 <= self.n <= 1000\n\nclass Palindrome:\n    def __init__(self, number: int):\n        \"\"\"Initializes a Palindrome object, determining its parity.\"\"\"\n        self.number = number\n        self.is_even = number % 2 == 0\n        self.is_odd = number % 2 != 0\n\nclass PalindromeCounter:\n    def __init__(self, n: int):\n        \"\"\"Initializes counter with the upper bound n and sets counts to zero.\"\"\"\n        self.n = n\n        self.even_count = 0\n        self.odd_count = 0\n\n    def is_palindrome(self, number: int) -> bool:\n        \"\"\"Checks if a given number is a palindrome.\"\"\"\n        s = str(number)\n        return s == s[::-1]\n\n    def count_palindromes(self) -> Tuple[int, int]:\n        \"\"\"Iterates from 1 to n, counting even and odd palindromes.\"\"\"\n        for num in range(1, self.n + 1):\n            if self.is_palindrome(num):\n                p = Palindrome(num)\n                if p.is_even:\n                    self.even_count += 1\n                else:\n                    self.odd_count += 1\n        return self.even_count, self.odd_count\n\ndef even_odd_palindrome(n: int) -> Tuple[int, int]:\n    \"\"\"\n    Given a positive integer n, return a tuple that has the number of even and odd\n    integer palindromes that fall within the range(1, n), inclusive.\n    \"\"\"\n    validator = InputValidator(n)\n    if not validator.is_valid():\n        raise ValueError(\"n must be an integer between 1 and 1000 inclusive.\")\n    counter = PalindromeCounter(n)\n    return counter.count_palindromes()"}
{"task_id": "HumanEval/109", "solution": "def move_one_ball(arr):\n    \"\"\"Determines if an array can be sorted by right-shift operations.\"\"\"\n    n = len(arr)\n    if n <= 1:\n        return True\n\n    descent_count = 0\n    for i in range(n - 1):\n        if arr[i] > arr[i+1]:\n            descent_count += 1\n\n    if descent_count == 0:\n        return True\n    elif descent_count == 1:\n        # Check if the array is a single rotation of a sorted array\n        # This means the last element must be less than or equal to the first element\n        # to complete the sorted cycle.\n        return arr[n-1] <= arr[0]\n    else:\n        # More than one descent means it cannot be sorted by a single rotation.\n        return False"}
{"task_id": "HumanEval/111", "solution": "def histogram(test):\n    \"\"\"Given a string representing a space separated lowercase letters, return a dictionary\n    of the letter with the most repetition and containing the corresponding count.\n    If several letters have the same occurrence, return all of them.\n    \"\"\"\n    if not test:\n        return {}\n\n    letters = test.split(' ')\n    \n    counts = {}\n    for letter in letters:\n        counts[letter] = counts.get(letter, 0) + 1\n\n    if not counts:\n        return {}\n\n    max_count = 0\n    for count in counts.values():\n        if count > max_count:\n            max_count = count\n\n    result = {}\n    for letter, count in counts.items():\n        if count == max_count:\n            result[letter] = count\n            \n    return result"}
{"task_id": "HumanEval/110", "solution": "def exchange(lst1, lst2):\n    \"\"\"Determines if elements can be exchanged between lst1 and lst2 to make lst1 contain only even numbers.\n    It counts odd numbers in lst1 and even numbers in lst2 to check feasibility.\"\"\"\n    \n    # Count the number of odd elements in lst1\n    odd_count_lst1 = sum(1 for x in lst1 if x % 2 != 0)\n    \n    # Count the number of even elements in lst2\n    even_count_lst2 = sum(1 for x in lst2 if x % 2 == 0)\n    \n    # If the number of odd elements in lst1 is less than or equal to the number of even elements in lst2,\n    # it's possible to exchange them to make lst1 all even.\n    if odd_count_lst1 <= even_count_lst2:\n        return \"YES\"\n    else:\n        return \"NO\""}
{"task_id": "HumanEval/112", "solution": "def reverse_delete(s, c):\n    \"\"\"We are given two strings s and c, you have to deleted all the characters in s that are equal to any character in c\n    then check if the result string is palindrome.\n    A string is called palindrome if it reads the same backward as forward.\n    You should return a tuple containing the result string and True/False for the check.\n    \"\"\"\n    from typing import Tuple\n\n    class ReverseDeleteProcessor:\n        def __init__(self, s: str, c: str):\n            self.s = s\n            self.c = c\n\n        def deleteCharacters(self) -> str:\n            delete_set = set(self.c)\n            return ''.join(ch for ch in self.s if ch not in delete_set)\n\n        def isPalindrome(self, cleaned: str) -> bool:\n            return cleaned == cleaned[::-1]\n\n        def execute(self) -> Tuple[str, bool]:\n            cleaned = self.deleteCharacters()\n            return cleaned, self.isPalindrome(cleaned)\n\n    processor = ReverseDeleteProcessor(s, c)\n    return processor.execute()"}
{"task_id": "HumanEval/114", "solution": "def minSubArraySum(nums):\n    \"\"\"\n    Given an array of integers nums, find the minimum sum of any non-empty sub-array\n    of nums.\n    Example\n    minSubArraySum([2, 3, 4, 1, 2, 4]) == 1\n    minSubArraySum([-1, -2, -3]) == -6\n    \"\"\"\n    current_min = nums[0]\n    global_min = nums[0]\n\n    for num in nums[1:]:\n        current_min = min(num, current_min + num)\n        global_min = min(global_min, current_min)\n        \n    return global_min"}
{"task_id": "HumanEval/117", "solution": "def select_words(s, n):\n    \"\"\"Given a string s and a natural number n, returns a list of all words from string s that \n    contain exactly n consonants, in order these words appear.\n    \"\"\"\n    def _count_consonants(word):\n        \"\"\"Counts the number of consonants in a given word.\"\"\"\n        vowels = {'a', 'e', 'i', 'o', 'u'}\n        consonant_count = 0\n        for char in word:\n            if char.isalpha() and char.lower() not in vowels:\n                consonant_count += 1\n        return consonant_count\n\n    if not s:\n        return []\n\n    result = []\n    words = s.split()\n    for word in words:\n        if _count_consonants(word) == n:\n            result.append(word)\n    return result"}
{"task_id": "HumanEval/116", "solution": "def sort_array(arr):\n    \"\"\"\n    Sorts an array of non-negative integers by the number of ones in their\n    binary representation (ascending), then by decimal value (ascending).\n    \"\"\"\n    return sorted(arr, key=lambda x: (bin(x).count('1'), x))"}
{"task_id": "HumanEval/113", "solution": "from typing import List\n\ndef odd_count(lst: List[str]) -> List[str]:\n    \"\"\"Counts odd digits in each string and returns formatted strings.\"\"\"\n    result: List[str] = []\n    for s in lst:\n        odd_digits = sum(1 for ch in s if int(ch) % 2 == 1)\n        formatted = f\"the number of odd elements {odd_digits}n the str{odd_digits}ng {odd_digits} of the {odd_digits}nput.\"\n        result.append(formatted)\n    return result"}
{"task_id": "HumanEval/115", "solution": "def max_fill(grid, capacity):\n    \"\"\"\n    Calculates the total number of times buckets need to be lowered to empty all wells.\n    Each well is a row, and each '1' represents a unit of water.\n    \"\"\"\n    total_lowerings = 0\n    for well_row in grid:\n        water_in_well = sum(well_row)\n        if water_in_well > 0:\n            lowerings_for_well = math.ceil(water_in_well / capacity)\n            total_lowerings += lowerings_for_well\n    return total_lowerings"}
{"task_id": "HumanEval/118", "solution": "def get_closest_vowel(word):\n    \"\"\"Finds the closest vowel surrounded by two consonants from the right side of the word.\"\"\"\n    vowels = \"aeiouAEIOU\"\n    \n    # Iterate from the second to last character down to the second character (index 1)\n    # This range ensures that the vowel is not at the beginning or end,\n    # and always has at least one character on its left and right.\n    for i in range(len(word) - 2, 0, -1):\n        char = word[i]\n        if char in vowels:\n            # Check if the character to the left and right are consonants\n            left_char = word[i - 1]\n            right_char = word[i + 1]\n            \n            if left_char not in vowels and right_char not in vowels:\n                return char\n                \n    return \"\""}
{"task_id": "HumanEval/119", "solution": "def match_parens(lst):\n    '''\n    You are given a list of two strings, both strings consist of open\n    parentheses '(' or close parentheses ')' only.\n    Your job is to check if it is possible to concatenate the two strings in\n    some order, that the resulting string will be good.\n    A string S is considered to be good if and only if all parentheses in S\n    are balanced. For example: the string '(())()' is good, while the string\n    '())' is not.\n    Return 'Yes' if there's a way to make a good string, and return 'No' otherwise.\n\n    Examples:\n    match_parens(['()(', ')']) == 'Yes'\n    match_parens([')', ')']) == 'No'\n    '''\n    # This helper function checks if a string of parentheses is balanced.\n    def is_balanced(s):\n        balance = 0\n        for char in s:\n            if char == '(':\n                balance += 1\n            elif char == ')':\n                balance -= 1\n            if balance < 0:\n                return False\n        return balance == 0\n\n    s1 = lst[0]\n    s2 = lst[1]\n\n    # Check the first concatenation order: s1 + s2\n    if is_balanced(s1 + s2):\n        return 'Yes'\n\n    # Check the second concatenation order: s2 + s1\n    if is_balanced(s2 + s1):\n        return 'Yes'\n\n    # If neither concatenation results in a balanced string\n    return 'No'"}
{"task_id": "HumanEval/120", "solution": "def maximum(arr, k):\n    \"\"\"\n    Given an array arr of integers and a positive integer k, return a sorted list \n    of length k with the maximum k numbers in arr.\n    \"\"\"\n    if k == 0:\n        return []\n    \n    # Sort the array in ascending order.\n    # The k largest elements will be at the end of the sorted array.\n    arr.sort()\n    \n    # Return the last k elements, which are already sorted in ascending order.\n    return arr[len(arr) - k:]"}
{"task_id": "HumanEval/121", "solution": "def solution(lst):\n    \"\"\"Given a non-empty list of integers, return the sum of all of the odd elements that are in even positions.\"\"\"\n    total_sum = 0\n    for i, num in enumerate(lst):\n        # Check if the index is even and the number is odd.\n        if i % 2 == 0 and num % 2 != 0:\n            total_sum += num\n    return total_sum"}
{"task_id": "HumanEval/123", "solution": "def get_odd_collatz(n):\n    \"\"\"\n    Given a positive integer n, return a sorted list that has the odd numbers in collatz sequence.\n    \"\"\"\n    odd_terms = set()\n    current_n = n\n\n    while current_n != 1:\n        if current_n % 2 != 0:\n            odd_terms.add(current_n)\n        \n        if current_n % 2 == 0:\n            current_n = current_n // 2\n        else:\n            current_n = 3 * current_n + 1\n    \n    odd_terms.add(1) # The sequence always reaches 1, which is odd.\n    \n    return sorted(list(odd_terms))"}
{"task_id": "HumanEval/122", "solution": "def add_elements(arr, k):\n    \"\"\"\n    Given a non-empty array of integers arr and an integer k, return\n    the sum of the elements with at most two digits from the first k elements of arr.\n    \"\"\"\n\n    def _digit_count(value):\n        \"\"\"Helper to return the number of decimal digits in an integer.\"\"\"\n        return len(str(abs(value)))\n\n    total = 0\n    # Iterate through the first k elements of the array.\n    for value in arr[:k]:\n        # Check if the absolute value of the element has at most two digits.\n        if _digit_count(value) <= 2:\n            total += value\n    return total"}
{"task_id": "HumanEval/124", "solution": "import re\n\ndef valid_date(date):\n    \"\"\"You have to write a function which validates a given date string and\n    returns True if the date is valid otherwise False.\n    The date is valid if all of the following rules are satisfied:\n    1. The date string is not empty.\n    2. The number of days is not less than 1 or higher than 31 days for months 1,3,5,7,8,10,12. And the number of days is not less than 1 or higher than 30 days for months 4,6,9,11. And, the number of days is not less than 1 or higher than 29 for the month 2.\n    3. The months should not be less than 1 or higher than 12.\n    4. The date should be in the format: mm-dd-yyyy\n\n    for example: \n    valid_date('03-11-2000') => True\n\n    valid_date('15-01-2012') => False\n\n    valid_date('04-0-2040') => False\n\n    valid_date('06-04-2020') => True\n\n    valid_date('06/04/2020') => False\n    \"\"\"\n    if not date:\n        return False\n\n    # Rule 4: The date should be in the format: mm-dd-yyyy\n    match = re.match(r\"^\\d{2}-\\d{2}-\\d{4}$\", date)\n    if not match:\n        return False\n\n    try:\n        month_str, day_str, year_str = date.split('-')\n        month = int(month_str)\n        day = int(day_str)\n        year = int(year_str) # Year is not used for validation rules, but parsed for completeness.\n    except ValueError:\n        return False # Should not happen with regex, but good practice.\n\n    # Rule 3: The months should not be less than 1 or higher than 12.\n    if not (1 <= month <= 12):\n        return False\n\n    # Rule 2: Validate number of days based on month.\n    months_31_days = {1, 3, 5, 7, 8, 10, 12}\n    months_30_days = {4, 6, 9, 11}\n\n    if month in months_31_days:\n        if not (1 <= day <= 31):\n            return False\n    elif month in months_30_days:\n        if not (1 <= day <= 30):\n            return False\n    elif month == 2: # February\n        # Rule explicitly states up to 29 days for month 2, ignoring leap years.\n        if not (1 <= day <= 29):\n            return False\n    else:\n        # This case should ideally not be reached if month is already validated 1-12\n        return False \n\n    return True"}
{"task_id": "HumanEval/125", "solution": "def split_words(txt):\n    '''\n    Given a string of words, return a list of words split on whitespace, if no whitespaces exists in the text you\n    should split on commas ',' if no commas exists you should return the number of lower-case letters with odd order in the\n    alphabet, ord('a') = 0, ord('b') = 1, ... ord('z') = 25\n    Examples\n    split_words(\"Hello world!\") \u279e [\"Hello\", \"world!\"]\n    split_words(\"Hello,world!\") \u279e [\"Hello\", \"world!\"]\n    split_words(\"abcdef\") == 3 \n    '''\n    \n    # Check for whitespace\n    contains_whitespace = False\n    for char in txt:\n        if char.isspace():\n            contains_whitespace = True\n            break\n    \n    if contains_whitespace:\n        return txt.split()\n\n    # Check for commas\n    if ',' in txt:\n        return txt.split(',')\n\n    # Count odd-order lowercase letters\n    count = 0\n    for char in txt:\n        if 'a' <= char <= 'z':\n            # Calculate the 0-indexed order in the alphabet\n            order = ord(char) - ord('a')\n            if order % 2 == 1:\n                count += 1\n    return count"}
{"task_id": "HumanEval/126", "solution": "def is_sorted(lst):\n    '''\n    Given a list of numbers, return whether or not they are sorted\n    in ascending order. If list has more than 1 duplicate of the same\n    number, return False. Assume no negative numbers and only integers.\n    '''\n    \n    # Using a dictionary to keep track of the count of each number.\n    # defaultdict simplifies incrementing counts for new numbers.\n    counts = {}\n    \n    # Initialize previous number to a value that is guaranteed to be less than\n    # or equal to any valid number in the list (since numbers are non-negative).\n    prev_num = -1 \n\n    for num in lst:\n        # Check if the list is sorted in ascending order.\n        if num < prev_num:\n            return False\n\n        # Update the count for the current number.\n        counts[num] = counts.get(num, 0) + 1\n\n        # Check the duplicate rule: return False if a number appears more than twice.\n        # \"more than 1 duplicate\" means 2 or more duplicates, implying 3 or more total occurrences.\n        if counts[num] > 2:\n            return False\n        \n        # Update prev_num for the next iteration.\n        prev_num = num\n\n    # If the loop completes, all conditions are met.\n    return True"}
{"task_id": "HumanEval/127", "solution": "def intersection(interval1, interval2):\n    \"\"\"You are given two intervals,\n    where each interval is a pair of integers. For example, interval = (start, end) = (1, 2).\n    The given intervals are closed which means that the interval (start, end)\n    includes both start and end.\n    For each given interval, it is assumed that its start is less or equal its end.\n    Your task is to determine whether the length of intersection of these two \n    intervals is a prime number.\n    Example, the intersection of the intervals (1, 3), (2, 4) is (2, 3)\n    which its length is 1, which not a prime number.\n    If the length of the intersection is a prime number, return \"YES\",\n    otherwise, return \"NO\".\n    If the two intervals don't intersect, return \"NO\".\n    \"\"\"\n\n    def is_prime(n):\n        \"\"\"Checks if a given number n is a prime number.\"\"\"\n        if n < 2:\n            return False\n        i = 2\n        while i * i <= n:\n            if n % i == 0:\n                return False\n            i += 1\n        return True\n\n    start1, end1 = interval1\n    start2, end2 = interval2\n\n    int_start = max(start1, start2)\n    int_end = min(end1, end2)\n\n    if int_start > int_end:\n        # No intersection, so length is effectively 0, which is not prime.\n        return \"NO\"\n\n    # Calculate length as (end - start), aligning with the provided examples where (2,3) length is 1.\n    length = int_end - int_start\n\n    if is_prime(length):\n        return \"YES\"\n    else:\n        return \"NO\""}
{"task_id": "HumanEval/128", "solution": "def prod_signs(arr):\n    \"\"\"\n    Calculates the sum of magnitudes multiplied by the product of signs.\n    Returns None for an empty input array.\n    \"\"\"\n    if not arr:\n        return None\n\n    product_of_signs = 1\n    sum_of_magnitudes = 0\n    has_zero_sign = False\n\n    for x in arr:\n        # Determine sign of each integer\n        sign_val = 0\n        if x > 0:\n            sign_val = 1\n        elif x < 0:\n            sign_val = -1\n        \n        # If any sign is 0, the overall product of signs will be 0\n        if sign_val == 0:\n            has_zero_sign = True\n            # No need to multiply further for product of signs if 0 is found\n        \n        # Compute product of all signs\n        # This multiplication only matters if no zero sign has been found yet\n        # If has_zero_sign is True, product_of_signs will ultimately be 0\n        # If not, it accumulates the product of 1s and -1s.\n        product_of_signs *= sign_val\n\n        # Compute sum of magnitudes\n        sum_of_magnitudes += abs(x)\n\n    # If any number was zero, the total product of signs is zero\n    if has_zero_sign:\n        final_product_of_signs = 0\n    else:\n        final_product_of_signs = product_of_signs\n\n    # Compute final result\n    return sum_of_magnitudes * final_product_of_signs"}
{"task_id": "HumanEval/130", "solution": "def tri(n):\n    \"\"\"\n    Calculates the first n + 1 numbers of the Tribonacci sequence.\n    The sequence is defined by tri(1)=3, tri(n)=1+n/2 for even n,\n    and tri(n)=tri(n-1)+tri(n-2)+tri(n+1) for odd n.\n    \"\"\"\n    # The sequence calculation might require values up to tri(n+1) if n is odd.\n    # So, we create a list large enough to store values from tri(0) to tri(n+1).\n    # This means the list size should be (n + 1) + 1 = n + 2.\n    trib_sequence = [0] * (n + 2)\n\n    # Initialize the base values tri(0) and tri(1).\n    # tri(0) is derived from the even rule: 1 + 0/2 = 1.\n    # tri(1) is explicitly given as 3.\n    trib_sequence[0] = 1\n    trib_sequence[1] = 3\n\n    # Calculate the remaining Tribonacci numbers iteratively.\n    # The loop runs from index 2 up to n+1 (inclusive).\n    for i in range(2, n + 2):\n        if i % 2 == 0:  # If i is an even number\n            trib_sequence[i] = 1 + i // 2\n        else:  # If i is an odd number\n            # For odd i, tri(i) depends on tri(i-1), tri(i-2), and tri(i+1).\n            # tri(i-1) and tri(i-2) are already computed as they are smaller indices.\n            # tri(i+1) can be computed directly using the even rule, as (i+1) is even.\n            val_i_plus_1 = 1 + (i + 1) // 2\n            trib_sequence[i] = trib_sequence[i - 1] + trib_sequence[i - 2] + val_i_plus_1\n\n    # The function is requested to return the first n + 1 numbers, i.e., tri(0) to tri(n).\n    return trib_sequence[0:n + 1]"}
{"task_id": "HumanEval/131", "solution": "def digits(n):\n    \"\"\"Given a positive integer n, return the product of the odd digits.\n    Return 0 if all digits are even.\n    \"\"\"\n    product_of_odd_digits = 1\n    found_odd_digit = False\n\n    # Iterate through the digits of the number\n    for digit_char in str(n):\n        digit = int(digit_char)\n        if digit % 2 != 0:  # Check if the digit is odd\n            product_of_odd_digits *= digit\n            found_odd_digit = True\n    \n    # Return 0 if no odd digits were found, otherwise return the calculated product\n    if not found_odd_digit:\n        return 0\n    else:\n        return product_of_odd_digits"}
{"task_id": "HumanEval/129", "solution": "def minPath(grid, k):\n    \"\"\"\n    Given a grid with N rows and N columns (N >= 2) and a positive integer k, \n    each cell of the grid contains a value. Every integer in the range [1, N * N]\n    inclusive appears exactly once on the cells of the grid.\n\n    You have to find the minimum path of length k in the grid. You can start\n    from any cell, and in each step you can move to any of the neighbor cells,\n    in other words, you can go to cells which share an edge with you current\n    cell.\n    Please note that a path of length k means visiting exactly k cells (not\n    necessarily distinct).\n    You CANNOT go off the grid.\n    A path A (of length k) is considered less than a path B (of length k) if\n    after making the ordered lists of the values on the cells that A and B go\n    through (let's call them lst_A and lst_B), lst_A is lexicographically less\n    than lst_B, in other words, there exist an integer index i (1 <= i <= k)\n    such that lst_A[i] < lst_B[i] and for any j (1 <= j < i) we have\n    lst_A[j] = lst_B[j].\n    It is guaranteed that the answer is unique.\n    Return an ordered list of the values on the cells that the minimum path go through.\n\n    Examples:\n\n        Input: grid = [ [1,2,3], [4,5,6], [7,8,9]], k = 3\n        Output: [1, 2, 1]\n\n        Input: grid = [ [5,9,3], [4,1,6], [7,8,2]], k = 1\n        Output: [1]\n    \"\"\"\n    N = len(grid)\n\n    # Helper function to get valid orthogonal neighbors for a given cell (r, c).\n    def get_neighbors(r, c):\n        neighbors = []\n        if r > 0:\n            neighbors.append((r - 1, c))  # Up\n        if r < N - 1:\n            neighbors.append((r + 1, c))  # Down\n        if c > 0:\n            neighbors.append((r, c - 1))  # Left\n        if c < N - 1:\n            neighbors.append((r, c + 1))  # Right\n        return neighbors\n\n    # dp[length_idx][row][col] stores the lexicographically smallest path\n    # of length (length_idx + 1) ending at (row, col).\n    # Initialize with None to signify no path found yet for that state.\n    dp = [[ [None for _ in range(N)] for _ in range(N)] for _ in range(k)]\n\n    # --- Step 1: Initialize for paths of length 1 (length_idx = 0) ---\n    # Each cell can be a path of length 1, starting and ending at itself.\n    for r in range(N):\n        for c in range(N):\n            dp[0][r][c] = [grid[r][c]]\n\n    # --- Step 2: Build paths for lengths 2 to k (length_idx = 1 to k-1) ---\n    # For each path length from 2 up to k.\n    for length_idx in range(1, k):\n        # Iterate through each cell in the grid.\n        for r in range(N):\n            for c in range(N):\n                current_cell_value = grid[r][c]\n                min_prev_path_segment = None # Stores the best path of length `length_idx` ending at a neighbor\n\n                # Consider all neighbors of the current cell (r, c).\n                # A path ending at (r, c) of length (length_idx + 1) must have come from a neighbor\n                # with a path of length (length_idx).\n                for nr, nc in get_neighbors(r, c):\n                    prev_path_segment = dp[length_idx - 1][nr][nc]\n                    \n                    # If a valid path of the previous length exists from this neighbor.\n                    if prev_path_segment is not None:\n                        # Compare to find the lexicographically smallest prefix path.\n                        if min_prev_path_segment is None or prev_path_segment < min_prev_path_segment:\n                            min_prev_path_segment = prev_path_segment\n                \n                # If a minimal previous path segment was found from any neighbor,\n                # extend it with the current cell's value.\n                if min_prev_path_segment is not None:\n                    dp[length_idx][r][c] = min_prev_path_segment + [current_cell_value]\n\n    # --- Step 3: Find the overall lexicographically smallest path of length k ---\n    overall_min_path = None\n\n    # Iterate through all cells, considering the paths of length k ending at each.\n    for r in range(N):\n        for c in range(N):\n            path_ending_at_rc = dp[k - 1][r][c]\n            \n            # If a valid path of length k ends at (r, c).\n            if path_ending_at_rc is not None:\n                # Update the overall minimum path if this one is lexicographically smaller.\n                if overall_min_path is None or path_ending_at_rc < overall_min_path:\n                    overall_min_path = path_ending_at_rc\n    \n    return overall_min_path"}
