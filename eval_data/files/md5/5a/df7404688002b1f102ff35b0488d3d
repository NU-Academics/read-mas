{"task_id": "HumanEval/132", "solution": "def is_nested(string):\n    \"\"\"\n    Checks if there is a valid subsequence of brackets where at least one bracket is nested.\n    \"\"\"\n    current_depth = 0\n    seen_depth_two = False\n    \n    for char in string:\n        if char == '[':\n            current_depth += 1\n            if current_depth >= 2:\n                seen_depth_two = True\n        elif char == ']':\n            if current_depth > 0:\n                # If we were at depth 2 and now close a bracket, it implies [[...]] structure\n                # where the inner ']' reduces depth to 1.\n                if current_depth == 2 and seen_depth_two:\n                    return True\n                current_depth -= 1\n            else:\n                # If ']' is encountered when depth is 0, it's an unmatched closing bracket.\n                # This segment cannot form a valid nested subsequence with preceding brackets.\n                # Reset state to search for a new potential subsequence starting later.\n                current_depth = 0\n                seen_depth_two = False\n    \n    return False"}
{"task_id": "HumanEval/135", "solution": "def can_arrange(arr):\n    \"\"\"Returns the largest index of an element that is less than its preceding element.\n    If no such element exists, it returns -1.\"\"\"\n    if len(arr) < 2:\n        return -1\n\n    # Iterate from the second-to-last element down to the second element (index 1)\n    # to find the largest index i where arr[i] < arr[i-1].\n    for i in range(len(arr) - 1, 0, -1):\n        if arr[i] < arr[i-1]:\n            return i\n\n    # If no such element is found, return -1.\n    return -1"}
{"task_id": "HumanEval/134", "solution": "def check_if_last_char_is_a_letter(txt):\n    \"\"\"\n    Checks if the last character of a string is an alphabetical character\n    and forms a single-character word.\n    \"\"\"\n    if not txt:\n        return False\n\n    last_char = txt[-1]\n\n    # The very last character of the given string must be a letter.\n    # This handles cases like \"apple pi e \" where the last char is a space.\n    if not last_char.isalpha():\n        return False\n\n    # If the last character is a letter, check if it forms a single-character word.\n    # A \"word\" is defined as a group of characters separated by space.\n    # This means the last sequence of non-space characters must be just this single letter.\n    words = txt.split(' ')\n\n    # After splitting, if the string wasn't empty, there will be at least one 'word' or empty string from split.\n    # The last 'word' in the list should match our `last_char` and have a length of 1.\n    if not words: # This case is unlikely to be hit if txt is not empty and last_char.isalpha() is True.\n        return False\n\n    last_word_token = words[-1]\n\n    return len(last_word_token) == 1 and last_word_token == last_char"}
{"task_id": "HumanEval/137", "solution": "def compare_one(a, b):\n    \"\"\"\n    Create a function that takes integers, floats, or strings representing\n    real numbers, and returns the larger variable in its given variable type.\n    Return None if the values are equal.\n    Note: If a real number is represented as a string, the floating point might be . or ,\n    \"\"\"\n    \n    # Process input 'a' to get its numeric value and retain its original form.\n    if isinstance(a, (int, float)):\n        a_numeric_value = float(a)\n        a_original_value = a\n    elif isinstance(a, str):\n        a_numeric_value = float(a.replace(',', '.'))\n        a_original_value = a\n    \n    # Process input 'b' to get its numeric value and retain its original form.\n    if isinstance(b, (int, float)):\n        b_numeric_value = float(b)\n        b_original_value = b\n    elif isinstance(b, str):\n        b_numeric_value = float(b.replace(',', '.'))\n        b_original_value = b\n        \n    # Compare the numeric values and return the larger original value or None if equal.\n    if a_numeric_value > b_numeric_value:\n        return a_original_value\n    elif b_numeric_value > a_numeric_value:\n        return b_original_value\n    else:\n        return None"}
{"task_id": "HumanEval/136", "solution": "def largest_smallest_integers(lst):\n    \"\"\"\n    Finds the largest negative integer and the smallest positive integer in a list.\n    Returns (largest_negative, smallest_positive) or None for missing categories.\n    \"\"\"\n    largest_neg = None\n    smallest_pos = None\n\n    for num in lst:\n        if num < 0:\n            if largest_neg is None or num > largest_neg:\n                largest_neg = num\n        elif num > 0:\n            if smallest_pos is None or num < smallest_pos:\n                smallest_pos = num\n\n    return (largest_neg, smallest_pos)"}
{"task_id": "HumanEval/139", "solution": "def special_factorial(n):\n    \"\"\"Calculates the Brazilian factorial of a positive integer n.\n    The Brazilian factorial is n! * (n-1)! * ... * 1!.\n    \"\"\"\n    from math import factorial\n\n    result = 1\n    for i in range(n, 0, -1):\n        result *= factorial(i)\n    return result"}
{"task_id": "HumanEval/138", "solution": "def is_equal_to_sum_even(n):\n    \"\"\"Evaluate whether the given number n can be written as the sum of exactly 4 positive even numbers\n    Example\n    is_equal_to_sum_even(4) == False\n    is_equal_to_sum_even(6) == False\n    is_equal_to_sum_even(8) == True\n    \"\"\"\n    if n < 8:\n        return False\n    if n % 2 != 0:\n        return False\n    return True"}
{"task_id": "HumanEval/140", "solution": "def fix_spaces(text):\n    \"\"\"\n    Given a string text, replace all spaces in it with underscores, \n    and if a string has more than 2 consecutive spaces, \n    then replace all consecutive spaces with - \n    \"\"\"\n    import re\n    # First, replace sequences of 3 or more spaces with a hyphen.\n    text = re.sub(r\" {3,}\", \"-\", text)\n    # Then, replace any remaining single spaces (or pairs of spaces which became single) with an underscore.\n    text = text.replace(\" \", \"_\")\n    return text"}
{"task_id": "HumanEval/141", "solution": "def file_name_check(file_name):\n    \"\"\"Checks if a file name is valid based on specific rules.\"\"\"\n    \n    # Condition 2: The file's name contains exactly one dot '.'\n    if file_name.count('.') != 1:\n        return 'No'\n\n    parts = file_name.split('.')\n    base_name = parts[0]\n    extension = parts[1]\n\n    # Condition 3: The substring before the dot should not be empty\n    if not base_name:\n        return 'No'\n    \n    # Condition 3: and it starts with a letter from the latin alphabet ('a'-'z' and 'A'-'Z').\n    if not (base_name[0].isalpha()):\n        return 'No'\n\n    # Condition 4: The substring after the dot should be one of these: ['txt', 'exe', 'dll']\n    valid_extensions = ['txt', 'exe', 'dll']\n    if extension not in valid_extensions:\n        return 'No'\n\n    # Condition 1: There should not be more than three digits ('0'-'9') in the file's name.\n    digit_count = 0\n    for char in file_name:\n        if char.isdigit():\n            digit_count += 1\n    \n    if digit_count > 3:\n        return 'No'\n        \n    return 'Yes'"}
{"task_id": "HumanEval/143", "solution": "def words_in_sentence(sentence):\n    \"\"\"\n    Returns a string containing words from the original sentence whose lengths are prime numbers.\n    \"\"\"\n\n    def is_prime(n):\n        \"\"\"Checks if a number is prime using trial division up to its square root.\"\"\"\n        if n < 2:\n            return False\n        i = 2\n        while i * i <= n:\n            if n % i == 0:\n                return False\n            i += 1\n        return True\n\n    words = sentence.split()\n    prime_length_words = []\n\n    for word in words:\n        if is_prime(len(word)):\n            prime_length_words.append(word)\n\n    return \" \".join(prime_length_words)"}
{"task_id": "HumanEval/142", "solution": "def sum_squares(lst):\n    \"\"\"\"\n    This function will take a list of integers. For all entries in the list, the function shall square the integer entry if its index is a\n    multiple of 3 and will cube the integer entry if its index is a multiple of 4 and not a multiple of 3. The function will not\n    change the entries in the list whose indexes are not a multiple of 3 or 4. The function shall then return the sum of all entries.\n\n    Examples:\n    For lst = [1,2,3] the output should be 6\n    For lst = []  the output should be 0\n    For lst = [-1,-5,2,-1,-5]  the output should be -126\n    \"\"\"\n    from dataclasses import dataclass\n    from typing import List\n\n    @dataclass\n    class IntegerElement:\n        \"\"\"Represents an element in the input list.\"\"\"\n        index: int\n        original_value: int\n        processed_value: int = 0\n\n    class SumSquaresProcessor:\n        \"\"\"Processes a list of IntegerElement objects according to business rules.\"\"\"\n\n        def __init__(self, elements: List[IntegerElement]) -> None:\n            self.elements = elements\n\n        def process(self) -> int:\n            \"\"\"Applies the business rules and returns the sum of processed values.\"\"\"\n            total = 0\n            for elem in self.elements:\n                if elem.index % 3 == 0:\n                    elem.processed_value = elem.original_value ** 2\n                elif elem.index % 4 == 0:\n                    elem.processed_value = elem.original_value ** 3\n                else:\n                    elem.processed_value = elem.original_value\n                total += elem.processed_value\n            return total\n\n    if not lst:\n        return 0\n\n    elements = [IntegerElement(idx, val) for idx, val in enumerate(lst)]\n    processor = SumSquaresProcessor(elements)\n    return processor.process()"}
{"task_id": "HumanEval/145", "solution": "def order_by_points(nums):\n    \"\"\"\n    Sorts the given list of integers in ascending order according to the sum of their digits.\n    If several items have similar sum of their digits, order them based on their index in original list.\n    \"\"\"\n    if not nums:\n        return []\n\n    def get_digit_sum(n):\n        \"\"\"Calculates the sum of the absolute digits of a number.\"\"\"\n        s = 0\n        num_abs = abs(n)\n        if num_abs == 0:\n            return 0\n        while num_abs > 0:\n            s += num_abs % 10\n            num_abs //= 10\n        return s\n\n    # Create a list of tuples: (digit_sum, original_index, original_value)\n    items_with_metadata = []\n    for i, num in enumerate(nums):\n        digit_sum = get_digit_sum(num)\n        items_with_metadata.append((digit_sum, i, num))\n\n    # Sort the list of tuples. Python's sorted function sorts tuples lexicographically,\n    # first by digit_sum, then by original_index, achieving the desired order.\n    sorted_items = sorted(items_with_metadata)\n\n    # Extract the original values from the sorted list of tuples\n    result = [item[2] for item in sorted_items]\n\n    return result"}
{"task_id": "HumanEval/144", "solution": "def simplify(x, n):\n    \"\"\"Checks if the product of two fraction strings is a whole number.\n\n    x and n are strings in \"numerator/denominator\" format.\n    \"\"\"\n    num_x_str, den_x_str = x.split('/')\n    num_n_str, den_n_str = n.split('/')\n\n    num_x = int(num_x_str)\n    den_x = int(den_x_str)\n    num_n = int(num_n_str)\n    den_n = int(den_n_str)\n\n    # Multiply the numerators and denominators\n    product_numerator = num_x * num_n\n    product_denominator = den_x * den_n\n\n    # Check if the product is a whole number\n    # This is true if the product_numerator is perfectly divisible by product_denominator\n    return product_numerator % product_denominator == 0"}
{"task_id": "HumanEval/146", "solution": "def specialFilter(nums):\n    \"\"\"Counts numbers in the array that are greater than 10 and have both first and last digits as odd.\n    Digits are considered odd if they are 1, 3, 5, 7, or 9.\n    \"\"\"\n    count = 0\n    for num in nums:\n        if num > 10:\n            num_str = str(num)\n            first_digit = int(num_str[0])\n            last_digit = int(num_str[-1])\n\n            if first_digit % 2 != 0 and last_digit % 2 != 0:\n                count += 1\n    return count"}
{"task_id": "HumanEval/147", "solution": "def get_max_triples(n):\n    # If n is less than 3, no triples (i, j, k) with i < j < k can be formed.\n    if n < 3:\n        return 0\n\n    # We analyze the remainder of a[x] when divided by 3 based on x % 3:\n    # a[x] = x*x - x + 1\n    # If x % 3 == 0: a[x] % 3 = (0*0 - 0 + 1) % 3 = 1\n    # If x % 3 == 1: a[x] % 3 = (1*1 - 1 + 1) % 3 = 1\n    # If x % 3 == 2: a[x] % 3 = (2*2 - 2 + 1) % 3 = (4 - 2 + 1) % 3 = 3 % 3 = 0\n\n    # count_val_mod0 stores the count of x in [1, n] such that a[x] % 3 == 0.\n    # This happens when x % 3 == 2.\n    count_val_mod0 = 0\n    # count_val_mod1 stores the count of x in [1, n] such that a[x] % 3 == 1.\n    # This happens when x % 3 == 0 or x % 3 == 1.\n    count_val_mod1 = 0\n\n    for x in range(1, n + 1):\n        if x % 3 == 2:\n            count_val_mod0 += 1\n        else: # x % 3 == 0 or x % 3 == 1\n            count_val_mod1 += 1\n\n    # Helper function to calculate combinations C(N, 3).\n    # Returns 0 if N < 3, as no distinct triples can be chosen.\n    def combinations_3(N):\n        if N < 3:\n            return 0\n        return N * (N - 1) * (N - 2) // 6\n\n    # A triple (a[i], a[j], a[k]) sums to a multiple of 3 if:\n    # 1. All three a[i], a[j], a[k] are multiples of 3 (0+0+0 = 0 mod 3).\n    #    These elements must come from the 'count_val_mod0' group.\n    # 2. All three a[i], a[j], a[k] have a remainder of 1 when divided by 3 (1+1+1 = 3 mod 3 = 0 mod 3).\n    #    These elements must come from the 'count_val_mod1' group.\n    \n    triples_from_mod0 = combinations_3(count_val_mod0)\n    triples_from_mod1 = combinations_3(count_val_mod1)\n\n    return triples_from_mod0 + triples_from_mod1"}
{"task_id": "HumanEval/148", "solution": "def bf(planet1, planet2):\n    \"\"\"\n    Returns a tuple of planets between planet1 and planet2, sorted by proximity to the Sun.\n    Returns an empty tuple if planet1 or planet2 are not valid planet names.\n    \"\"\"\n    planets_order = {\n        \"Mercury\": 1, \"Venus\": 2, \"Earth\": 3, \"Mars\": 4,\n        \"Jupiter\": 5, \"Saturn\": 6, \"Uranus\": 7, \"Neptune\": 8\n    }\n    \n    planets_list = [\n        \"Mercury\", \"Venus\", \"Earth\", \"Mars\",\n        \"Jupiter\", \"Saturn\", \"Uranus\", \"Neptune\"\n    ]\n\n    if planet1 not in planets_order or planet2 not in planets_order:\n        return ()\n\n    order1 = planets_order[planet1]\n    order2 = planets_order[planet2]\n\n    min_order = min(order1, order2)\n    max_order = max(order1, order2)\n\n    result_planets = []\n    for planet_name in planets_list:\n        current_order = planets_order[planet_name]\n        if min_order < current_order < max_order:\n            result_planets.append(planet_name)\n    \n    return tuple(result_planets)"}
{"task_id": "HumanEval/149", "solution": "def sorted_list_sum(lst):\n    \"\"\"Write a function that accepts a list of strings as a parameter,\n    deletes the strings that have odd lengths from it,\n    and returns the resulted list with a sorted order,\n    The list is always a list of strings and never an array of numbers,\n    and it may contain duplicates.\n    The order of the list should be ascending by length of each word, and you\n    should return the list sorted by that rule.\n    If two words have the same length, sort the list alphabetically.\n    The function should return a list of strings in sorted order.\n    You may assume that all words will have the same length.\n    For example:\n    assert list_sort([\"aa\", \"a\", \"aaa\"]) => [\"aa\"]\n    assert list_sort([\"ab\", \"a\", \"aaa\", \"cd\"]) => [\"ab\", \"cd\"]\n    \"\"\"\n\n    class StringItem:\n        def __init__(self, value: str):\n            self.value = value\n\n    class StringList:\n        def __init__(self, strings: list[str]):\n            self.items = [StringItem(s) for s in strings]\n\n    class StringListProcessor:\n        def __init__(self):\n            self._string_list = None\n            self._result_strings = []\n\n        def accept_input(self, input_list: list[str]):\n            self._string_list = StringList(input_list)\n            self._result_strings = [item.value for item in self._string_list.items]\n\n        def filter_odd_length(self):\n            self._result_strings = [s for s in self._result_strings if len(s) % 2 == 0]\n\n        def sort_strings(self):\n            self._result_strings.sort(key=lambda s: (len(s), s))\n\n        def get_result(self) -> list[str]:\n            return self._result_strings\n\n    processor = StringListProcessor()\n    processor.accept_input(lst)\n    processor.filter_odd_length()\n    processor.sort_strings()\n    return processor.get_result()"}
{"task_id": "HumanEval/150", "solution": "class Number:\n    \"\"\"Represents an integer and provides primality testing.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def is_prime(self) -> bool:\n        \"\"\"Return True if self.value is a prime number.\"\"\"\n        n = self.value\n        if n <= 1:\n            return False\n        if n <= 3:\n            return True\n        if n % 2 == 0 or n % 3 == 0:\n            return False\n        i = 5\n        while i * i <= n:\n            if n % i == 0 or n % (i + 2) == 0:\n                return False\n            i += 6\n        return True\n\n\nclass Result:\n    \"\"\"Container for the function result.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n\ndef x_or_y(n, x, y):\n    \"\"\"A simple program which should return the value of x if n is \n    a prime number and should return the value of y otherwise.\n\n    Examples:\n    for x_or_y(7, 34, 12) == 34\n    for x_or_y(15, 8, 5) == 5\n    \n    \"\"\"\n    number = Number(n)\n    selected = x if number.is_prime() else y\n    result = Result(selected)\n    return result.value"}
{"task_id": "HumanEval/151", "solution": "def double_the_difference(lst):\n    \"\"\"\n    Given a list of numbers, return the sum of squares of the numbers\n    in the list that are odd. Ignore numbers that are negative or not integers.\n    \"\"\"\n    total_sum_of_squares = 0\n    for num in lst:\n        # Check if the number is an integer, positive, and odd.\n        if isinstance(num, int) and num > 0 and num % 2 != 0:\n            total_sum_of_squares += num * num\n    return total_sum_of_squares"}
{"task_id": "HumanEval/152", "solution": "def compare(game,guess):\n    \"\"\"Compares two arrays of scores and guesses to determine how far off each guess was.\n    Returns an array of absolute differences, with 0 for correct guesses.\"\"\"\n    \n    result = []\n    for i in range(len(game)):\n        if game[i] == guess[i]:\n            result.append(0)\n        else:\n            result.append(abs(game[i] - guess[i]))\n    return result"}
{"task_id": "HumanEval/153", "solution": "def Strongest_Extension(class_name, extensions):\n    \"\"\"Finds the strongest extension based on the count of uppercase and lowercase letters, returning\n    the class name concatenated with the strongest extension name.\"\"\"\n    \n    max_strength = -float('inf')\n    strongest_extension_name = \"\"\n\n    for extension_name in extensions:\n        cap_count = 0\n        sm_count = 0\n        for char in extension_name:\n            if 'A' <= char <= 'Z':\n                cap_count += 1\n            elif 'a' <= char <= 'z':\n                sm_count += 1\n        \n        current_strength = cap_count - sm_count\n\n        if current_strength > max_strength:\n            max_strength = current_strength\n            strongest_extension_name = extension_name\n    \n    return f\"{class_name}.{strongest_extension_name}\""}
{"task_id": "HumanEval/154", "solution": "def cycpattern_check(a , b):\n    \"\"\"Checks if the second word or any of its rotations is a substring in the first word.\"\"\"\n    len_b = len(b)\n    if len_b == 0:\n        return True # An empty string is considered a substring of any string.\n    \n    # If the second word is longer than the first, no rotation can be a substring.\n    # This check is implicitly handled by the 'in' operator, but an early exit is efficient.\n    # However, to strictly follow \"no isinstance() checks or raise exceptions for edge cases\"\n    # and avoiding adding \"new info\", we let the 'in' operator handle it.\n    # The current problem statement's implied constraints mean we should avoid explicit length comparison checks.\n    \n    b_doubled = b + b\n    \n    for i in range(len_b):\n        rotation = b_doubled[i : i + len_b]\n        if rotation in a:\n            return True\n            \n    return False"}
{"task_id": "HumanEval/156", "solution": "def int_to_mini_roman(number):\n    \"\"\"\n    Given a positive integer, obtain its roman numeral equivalent as a string,\n    and return it in lowercase.\n    \"\"\"\n    _ROMAN_MAP = [\n        (1000, 'M'), (900, 'CM'), (500, 'D'), (400, 'CD'),\n        (100, 'C'), (90, 'XC'), (50, 'L'), (40, 'XL'),\n        (10, 'X'), (9, 'IX'), (5, 'V'), (4, 'IV'), (1, 'I')\n    ]\n\n    result = []\n    for value, symbol in _ROMAN_MAP:\n        while number >= value:\n            result.append(symbol)\n            number -= value\n    return ''.join(result).lower()"}
{"task_id": "HumanEval/157", "solution": "def right_angle_triangle(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle. Return True if the three\n    sides form a right-angled triangle, False otherwise.\n    A right-angled triangle is a triangle in which one angle is right angle or \n    90 degree.\n    Example:\n    right_angle_triangle(3, 4, 5) == True\n    right_angle_triangle(1, 2, 3) == False\n    '''\n    sides = sorted([a, b, c])\n    # Check if the Pythagorean theorem holds true, accounting for float precision.\n    return abs(sides[0] ** 2 + sides[1] ** 2 - sides[2] ** 2) < 1e-9"}
{"task_id": "HumanEval/155", "solution": "def even_odd_count(num):\n    \"\"\"Given an integer. return a tuple that has the number of even and odd digits respectively.\n\n     Example:\n        even_odd_count(-12) ==> (1, 1)\n        even_odd_count(123) ==> (1, 2)\n    \"\"\"\n    even_count = 0\n    odd_count = 0\n    # Take absolute value to handle negative numbers, then convert to string for digit iteration.\n    num_str = str(abs(num))\n\n    for digit_char in num_str:\n        digit = int(digit_char)\n        if digit % 2 == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n\n    return (even_count, odd_count)"}
{"task_id": "HumanEval/158", "solution": "def find_max(words):\n    \"\"\"Returns the word with the maximum number of unique characters,\n    breaking ties by lexicographical order.\n    \"\"\"\n    if not words:\n        return \"\"\n\n    max_unique_chars_count = -1\n    result_word = \"\"\n\n    for word in words:\n        current_unique_chars_count = len(set(word))\n\n        if current_unique_chars_count > max_unique_chars_count:\n            max_unique_chars_count = current_unique_chars_count\n            result_word = word\n        elif current_unique_chars_count == max_unique_chars_count:\n            # Tie-breaking: return the one which comes first in lexicographical order\n            if word < result_word:\n                result_word = word\n    \n    return result_word"}
{"task_id": "HumanEval/160", "solution": "def do_algebra(operator, operand):\n    \"\"\"\n    Given two lists operator, and operand. The first list has basic algebra operations, and \n    the second list is a list of integers. Use the two given lists to build the algebric \n    expression and return the evaluation of this expression.\n\n    The basic algebra operations:\n    Addition ( + ) \n    Subtraction ( - ) \n    Multiplication ( * ) \n    Floor division ( // ) \n    Exponentiation ( ** ) \n\n    Example:\n    operator['+', '*', '-']\n    array = [2, 3, 4, 5]\n    result = 2 + 3 * 4 - 5\n    => result = 9\n\n    Note:\n        The length of operator list is equal to the length of operand list minus one.\n        Operand is a list of of non-negative integers.\n        Operator list has at least one operator, and operand list has at least two operands.\n\n    \"\"\"\n    expression_str = str(operand[0])\n\n    for i in range(len(operator)):\n        expression_str += operator[i]\n        expression_str += str(operand[i+1])\n\n    return eval(expression_str)"}
{"task_id": "HumanEval/161", "solution": "def solve(s):\n    \"\"\"Reverses the case of letters in a string, or reverses the entire string if no letters are present.\"\"\"\n    \n    has_letters = False\n    for char in s:\n        if char.isalpha():\n            has_letters = True\n            break\n            \n    if not has_letters:\n        return s[::-1]\n    else:\n        result_chars = []\n        for char in s:\n            if char.isalpha():\n                if char.islower():\n                    result_chars.append(char.upper())\n                else: # char.isupper()\n                    result_chars.append(char.lower())\n            else:\n                result_chars.append(char)\n        return \"\".join(result_chars)"}
{"task_id": "HumanEval/163", "solution": "def generate_integers(a, b):\n    \"\"\"\n    Given two positive integers a and b, return the even digits between a\n    and b, in ascending order.\n    \"\"\"\n    start = min(a, b)\n    end = max(a, b)\n    even_digits = [2, 4, 6, 8]\n    result = []\n    for digit in even_digits:\n        if start <= digit <= end:\n            result.append(digit)\n    return result"}
{"task_id": "HumanEval/162", "solution": "import hashlib\n\ndef string_to_md5(text):\n    \"\"\"\n    Given a string 'text', return its md5 hash equivalent string.\n    If 'text' is an empty string, return None.\n    \"\"\"\n    if not text:\n        return None\n    return hashlib.md5(text.encode('utf-8')).hexdigest()"}
{"task_id": "HumanEval/159", "solution": "def eat(number, need, remaining):\n    \"\"\"\n    Calculates the total carrots eaten and remaining after a rabbit's meal.\n    \"\"\"\n    actual_eaten_from_stock = min(need, remaining)\n    total_eaten = number + actual_eaten_from_stock\n    remaining_after_meal = remaining - actual_eaten_from_stock\n    return [total_eaten, remaining_after_meal]"}
