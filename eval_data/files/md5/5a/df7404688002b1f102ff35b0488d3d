{"task_id": "HumanEval/81", "solution": "def numerical_letter_grade(grades: list[float]) -> list[str]:\n    \"\"\"It is the last week of the semester and the teacher has to give the grades\n    to students. The teacher has been making her own algorithm for grading.\n    The only problem is, she has lost the code she used for grading.\n    She has given you a list of GPAs for some students and you have to write \n    a function that can output a list of letter grades using the following table:\n             GPA       |    Letter grade\n              4.0                A+\n            > 3.7                A \n            > 3.3                A- \n            > 3.0                B+\n            > 2.7                B \n            > 2.3                B-\n            > 2.0                C+\n            > 1.7                C\n            > 1.3                C-\n            > 1.0                D+ \n            > 0.7                D \n            > 0.0                D-\n              0.0                E\n    \n\n    Example:\n    grade_equation([4.0, 3, 1.7, 2, 3.5]) ==> ['A+', 'B', 'C-', 'C', 'A-']\n    \"\"\"\n    \n    # Validation\n    for g in grades:\n        if not 0.0 <= g <= 4.0:\n            raise ValueError(f\"GPA {g} out of range [0.0, 4.0]\")\n\n    # Mapping table (ordered from highest to lowest)\n    mapping = [\n        (4.0, 4.0, \"A+\"),\n        (3.7, 4.0, \"A\"),\n        (3.3, 3.7, \"A-\"),\n        (3.0, 3.3, \"B+\"),\n        (2.7, 3.0, \"B\"),\n        (2.3, 2.7, \"B-\"),\n        (2.0, 2.3, \"C+\"),\n        (1.7, 2.0, \"C\"),\n        (1.3, 1.7, \"C-\"),\n        (1.0, 1.3, \"D+\"),\n        (0.7, 1.0, \"D\"),\n        (0.0, 0.7, \"D-\"),\n        (0.0, 0.0, \"E\"),\n    ]\n\n    def map_grade(gpa: float) -> str:\n        for lower, upper, letter in mapping:\n            if lower <= gpa <= upper:\n                return letter\n        # Should never reach here due to validation\n        raise RuntimeError(f\"Unhandled GPA value: {gpa}\")\n\n    return [map_grade(g) for g in grades]"}
{"task_id": "HumanEval/82", "solution": "def prime_length(string):\n    \"\"\"Write a function that takes a string and returns True if the string\n    length is a prime number or False otherwise\n    \"\"\"\n    length = len(string)\n\n    if length <= 1:\n        return False\n    if length == 2:\n        return True\n    if length % 2 == 0:\n        return False\n\n    i = 3\n    while i * i <= length:\n        if length % i == 0:\n            return False\n        i += 2\n    return True"}
{"task_id": "HumanEval/83", "solution": "def starts_one_ends(n):\n    \"\"\"\n    Given a positive integer n, return the count of the numbers of n-digit\n    positive integers that start or end with 1.\n    \"\"\"\n    if n == 1:\n        return 1\n    # For n > 1, the count of n-digit numbers that start or end with 1\n    # is given by the formula 18 * 10^(n-2).\n    return 18 * (10**(n - 2))"}
{"task_id": "HumanEval/85", "solution": "def add(lst):\n    \"\"\"Given a non-empty list of integers lst. add the even elements that are at odd indices.\"\"\"\n    total_sum = 0\n    for i, num in enumerate(lst):\n        # Check if the current index is odd (0-based)\n        # and if the element at that index is even.\n        if i % 2 != 0 and num % 2 == 0:\n            total_sum += num\n    return total_sum"}
{"task_id": "HumanEval/84", "solution": "def solve(N):\n    \"\"\"Given a positive integer N, return the total sum of its digits in binary.\n    \n    The function calculates the sum of the decimal digits of N, then converts this sum to its binary string representation.\n    \"\"\"\n    s_N = str(N)\n    decimal_digit_sum = 0\n    for digit_char in s_N:\n        decimal_digit_sum += int(digit_char)\n    \n    # Convert the decimal sum to its binary string representation\n    binary_sum_string = bin(decimal_digit_sum)\n    \n    # Remove the \"0b\" prefix from the binary string\n    return binary_sum_string[2:]"}
{"task_id": "HumanEval/88", "solution": "def sort_array(array):\n    \"\"\"\n    Given an array of non-negative integers, return a copy of the given array after sorting,\n    you will sort the given array in ascending order if the sum( first index value, last index value) is odd,\n    or sort it in descending order if the sum( first index value, last index value) is even.\n    \"\"\"\n    if not array:\n        return []\n\n    copied_array = list(array)\n\n    if len(array) == 1:\n        return copied_array\n\n    first_val = array[0]\n    last_val = array[-1]\n    \n    # Calculate sum of first and last elements\n    s = first_val + last_val\n\n    # Sort based on parity of the sum\n    if s % 2 != 0:  # Odd sum, sort ascending\n        copied_array.sort()\n    else:  # Even sum, sort descending\n        copied_array.sort(reverse=True)\n        \n    return copied_array"}
{"task_id": "HumanEval/86", "solution": "def anti_shuffle(s):\n    \"\"\"\n    Returns an ordered version of a string where all words (separated by space)\n    are replaced by a new word where all characters are arranged in\n    ascending order based on ASCII value. Keeps word order and blank spaces.\n    \"\"\"\n    if not s:\n        return \"\"\n\n    result_parts = []\n    current_segment = []\n    \n    # Determine the type of the first character to start the initial segment\n    is_space_segment = s[0].isspace()\n\n    for char in s:\n        if char.isspace() == is_space_segment:\n            # Current character matches the current segment type, extend segment\n            current_segment.append(char)\n        else:\n            # Segment type changed, process the previous segment\n            segment_str = \"\".join(current_segment)\n            if is_space_segment:\n                result_parts.append(segment_str)  # Keep space segments as they are\n            else:\n                result_parts.append(\"\".join(sorted(segment_str)))  # Sort non-space characters\n            \n            # Start a new segment with the current character\n            current_segment = [char]\n            is_space_segment = char.isspace()\n    \n    # Process the very last segment after the loop finishes\n    segment_str = \"\".join(current_segment)\n    if is_space_segment:\n        result_parts.append(segment_str)\n    else:\n        result_parts.append(\"\".join(sorted(segment_str)))\n            \n    return \"\".join(result_parts)"}
{"task_id": "HumanEval/87", "solution": "def get_row(lst, x):\n    \"\"\"\n    Finds integer x in a 2D list and returns a list of coordinates (row, column).\n    Coordinates are sorted by row ascending, then by column descending.\n    \"\"\"\n    coordinates = []\n    for r_idx, row in enumerate(lst):\n        for c_idx, item in enumerate(row):\n            if item == x:\n                coordinates.append((r_idx, c_idx))\n\n    # Sort primarily by row in ascending order (coord[0])\n    # Secondarily by column in descending order (negating coord[1] achieves this)\n    coordinates.sort(key=lambda coord: (coord[0], -coord[1]))\n\n    return coordinates"}
{"task_id": "HumanEval/89", "solution": "def encrypt(s):\n    \"\"\"Encrypts a string by rotating the alphabet by a shift of 4.\n    Non-alphabetic characters are preserved.\n    \"\"\"\n    result = []\n    shift = 4\n    for char in s:\n        if 'a' <= char <= 'z':\n            # Calculate the shifted character, wrapping around from 'z' to 'a'\n            shifted_char_code = ord('a') + (ord(char) - ord('a') + shift) % 26\n            result.append(chr(shifted_char_code))\n        else:\n            # Preserve non-alphabetic characters\n            result.append(char)\n    return \"\".join(result)"}
{"task_id": "HumanEval/90", "solution": "\nclass IntegerList:\n    def __init__(self, elements):\n        self.elements = elements\n\nclass SecondSmallestFinder:\n    def find(self, integer_list):\n        # Extract distinct integers and sort them.\n        distinct_elements = sorted(list(set(integer_list.elements)))\n\n        # Return None if there are fewer than two distinct elements.\n        if len(distinct_elements) < 2:\n            return None\n        else:\n            # Otherwise, return the second element (2nd smallest).\n            return distinct_elements[1]\n\ndef next_smallest(lst):\n    \"\"\"\n    Returns the 2nd smallest distinct element of the list.\n    Returns None if there is no such element.\n    \"\"\"\n    integer_list_obj = IntegerList(lst)\n    finder = SecondSmallestFinder()\n    return finder.find(integer_list_obj)"}
{"task_id": "HumanEval/91", "solution": "def is_bored(S):\n    \"\"\"\n    Counts sentences starting with 'I'.\n    Sentences are delimited by '.', '?' or '!'.\n    \"\"\"\n    import re\n    from typing import List\n\n    class StringInput:\n        def __init__(self, text: str):\n            self.text = text\n\n    class Sentence:\n        def __init__(self, text: str):\n            self.text = text.strip()\n            self.is_boredom = self.text.startswith(\"I\")\n\n    class Parser:\n        DELIMITERS = r'[.!?]'\n\n        @staticmethod\n        def parse_sentences(text: str) -> List[Sentence]:\n            raw_sentences = re.split(Parser.DELIMITERS, text)\n            return [Sentence(s) for s in raw_sentences if s.strip()]\n\n    class BoredomCounter:\n        @staticmethod\n        def count_boredoms(input_obj: StringInput) -> int:\n            sentences: List[Sentence] = Parser.parse_sentences(input_obj.text)\n            return sum(1 for s in sentences if s.is_boredom)\n\n    input_obj = StringInput(S)\n    return BoredomCounter.count_boredoms(input_obj)"}
{"task_id": "HumanEval/92", "solution": "def any_int(x, y, z):\n    '''\n    Create a function that takes 3 numbers.\n    Returns true if one of the numbers is equal to the sum of the other two, and all numbers are integers.\n    Returns false in any other cases.\n    '''\n    if not (isinstance(x, int) and isinstance(y, int) and isinstance(z, int)):\n        return False\n\n    if x == y + z or y == x + z or z == x + y:\n        return True\n    \n    return False"}
{"task_id": "HumanEval/93", "solution": "def encode(message):\n    \"\"\"\n    Encodes a message by swapping case of letters and replacing vowels.\n    Non-letter characters are passed through unchanged.\n    \"\"\"\n    vowel_mapping = {\n        'a': 'c', 'e': 'g', 'i': 'k', 'o': 'q', 'u': 'w',\n        'A': 'C', 'E': 'G', 'I': 'K', 'O': 'Q', 'U': 'W'\n    }\n\n    encoded_chars = []\n    for char in message:\n        if char.isalpha():\n            swapped_case_char = char.swapcase()\n            mapped_char = vowel_mapping.get(swapped_case_char, swapped_case_char)\n            encoded_chars.append(mapped_char)\n        else:\n            encoded_chars.append(char)\n\n    return ''.join(encoded_chars)"}
{"task_id": "HumanEval/94", "solution": "def skjkasdkd(lst):\n    \"\"\"You are given a list of integers.\n    You need to find the largest prime value and return the sum of its digits.\n    \"\"\"\n\n    def is_prime(n):\n        \"\"\"Checks if a number is prime.\"\"\"\n        if n < 2:\n            return False\n        if n == 2:\n            return True\n        if n % 2 == 0:\n            return False\n        i = 3\n        while i * i <= n:\n            if n % i == 0:\n                return False\n            i += 2\n        return True\n\n    def sum_digits(n):\n        \"\"\"Calculates the sum of the digits of a number.\"\"\"\n        digit_sum = 0\n        # Handle negative numbers if they could be input to sum_digits\n        # based on context, largest_prime will be positive or -1\n        n_abs = abs(n) \n        while n_abs > 0:\n            digit_sum += n_abs % 10\n            n_abs //= 10\n        return digit_sum\n\n    largest_prime = -1  # Initialize with a value smaller than any possible prime\n\n    for num in lst:\n        if is_prime(num) and num > largest_prime:\n            largest_prime = num\n            \n    # Per example context, there will always be a prime found.\n    # If no primes were found, largest_prime would remain -1.\n    return sum_digits(largest_prime)"}
{"task_id": "HumanEval/95", "solution": "def check_dict_case(dict):\n    \"\"\"\n    Given a dictionary, return True if all keys are strings in lower \n    case or all keys are strings in upper case, else return False.\n    The function should return False is the given dictionary is empty.\n    \"\"\"\n    if not dict:\n        return False\n\n    keys = list(dict.keys())\n\n    # Ensure all keys are strings.\n    if not all(isinstance(key, str) for key in keys):\n        return False\n\n    first_key = keys[0]\n    is_first_key_lower = first_key.islower()\n    is_first_key_upper = first_key.isupper()\n\n    # If the first key is neither all lower nor all upper, it's immediately False.\n    if not is_first_key_lower and not is_first_key_upper:\n        return False\n\n    if is_first_key_lower:\n        return all(key.islower() for key in keys)\n    elif is_first_key_upper:\n        return all(key.isupper() for key in keys)\n    \n    return False"}
{"task_id": "HumanEval/96", "solution": "import math\n\ndef count_up_to(n):\n    \"\"\"Implement a function that takes a non-negative integer and returns an array of the first n\n    integers that are prime numbers and less than n.\n    \"\"\"\n    primes = []\n    # Iterate from 2 up to n-1 to find prime numbers strictly less than n.\n    for num in range(2, n):\n        is_prime = True\n        # Handle special cases for primality testing.\n        if num < 2 or (num % 2 == 0 and num != 2):\n            is_prime = False\n        else:\n            # Check for divisibility by odd numbers up to the square root of num.\n            # This optimizes the primality test.\n            limit = int(math.sqrt(num)) + 1\n            for i in range(3, limit, 2):\n                if num % i == 0:\n                    is_prime = False\n                    break\n        if is_prime:\n            primes.append(num)\n    return primes"}
{"task_id": "HumanEval/97", "solution": "def multiply(a, b):\n    \"\"\"Complete the function that takes two integers and returns \n    the product of their unit digits.\n    Assume the input is always valid.\n    Examples:\n    multiply(148, 412) should return 16.\n    multiply(19, 28) should return 72.\n    multiply(2020, 1851) should return 0.\n    multiply(14,-15) should return 20.\n    \"\"\"\n    unit_a = abs(a) % 10\n    unit_b = abs(b) % 10\n    return unit_a * unit_b"}
