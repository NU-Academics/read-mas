{"task_id": "HumanEval/47", "solution": "def median(l: list):\n    \"\"\"Return median of elements in the list l.\n    >>> median([3, 1, 2, 4, 5])\n    3\n    >>> median([-10, 4, 6, 1000, 10, 20])\n    15.0\n    \"\"\"\n    sorted_l = sorted(l)\n    n = len(sorted_l)\n    if n % 2 == 1:\n        # Odd length list, return the middle element\n        return sorted_l[n // 2]\n    else:\n        # Even length list, return the average of the two middle elements\n        mid1 = sorted_l[n // 2 - 1]\n        mid2 = sorted_l[n // 2]\n        return (mid1 + mid2) / 2.0"}
{"task_id": "HumanEval/46", "solution": "def fib4(n: int):\n    \"\"\"Computes the n-th Fib4 number iteratively, using O(1) space.\"\"\"\n    if n == 0:\n        return 0\n    if n == 1:\n        return 0\n    if n == 2:\n        return 2\n    if n == 3:\n        return 0\n\n    # Initialize the list with the first four Fib4 numbers\n    # fib_sequence[0] is fib4(k-4), fib_sequence[1] is fib4(k-3), etc.\n    fib_sequence = [0, 0, 2, 0] # Represents fib4(0), fib4(1), fib4(2), fib4(3)\n\n    for i in range(4, n + 1):\n        # Calculate the next Fib4 number\n        next_fib = sum(fib_sequence)\n        # Shift the window: remove the oldest value and add the new one\n        fib_sequence.pop(0)\n        fib_sequence.append(next_fib)\n        \n    # The last element in the sequence list is fib4(n)\n    return fib_sequence[3]"}
{"task_id": "HumanEval/49", "solution": "def modp(n: int, p: int):\n    \"\"\"Return 2^n modulo p (be aware of numerics).\n    >>> modp(3, 5)\n    3\n    >>> modp(1101, 101)\n    2\n    >>> modp(0, 101)\n    1\n    >>> modp(3, 11)\n    8\n    >>> modp(100, 101)\n    1\n    \"\"\"\n    if n < 0:\n        raise ValueError(\"Exponent n must be non\u2011negative.\")\n    if p <= 0:\n        raise ValueError(\"Modulus p must be positive.\")\n\n    # Handle specific edge cases.\n    if p == 1:\n        return 0\n    if n == 0:\n        return 1 % p\n\n    # Implement binary exponentiation (exponentiation by squaring).\n    result = 1\n    base = 2 % p\n    exp = n\n    while exp > 0:\n        if exp & 1:  # If exp is odd\n            result = (result * base) % p\n        base = (base * base) % p\n        exp >>= 1  # Divide exp by 2\n    return result"}
