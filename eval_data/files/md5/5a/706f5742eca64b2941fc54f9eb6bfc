{"task_id": "Mbpp/141", "solution": "def pancake_sort(elements):\n    \"\"\"\n    Sorts a list of elements using the pancake sort algorithm.\n    Returns a new sorted list without modifying the original.\n    \"\"\"\n    arr = list(elements) # Create a mutable copy to perform in-place sorting.\n    n = len(arr)\n\n    # Loop from the largest unsorted sublist down to a sublist of size 2.\n    # 'current_size' represents the end index of the unsorted part (inclusive).\n    for current_size in range(n - 1, 0, -1):\n        # Find the index of the maximum element in the unsorted part (arr[0...current_size]).\n        max_idx = 0\n        for i in range(1, current_size + 1):\n            if arr[i] > arr[max_idx]:\n                max_idx = i\n\n        # If the maximum element is not already at its correct position, perform flips.\n        if max_idx != current_size:\n            # First flip: bring the maximum element to the front of the list.\n            # This reverses the sublist from index 0 to max_idx.\n            start, end = 0, max_idx\n            while start < end:\n                arr[start], arr[end] = arr[end], arr[start]\n                start += 1\n                end -= 1\n\n            # Second flip: bring the maximum element from the front to its sorted position.\n            # This reverses the sublist from index 0 to current_size.\n            start, end = 0, current_size\n            while start < end:\n                arr[start], arr[end] = arr[end], arr[start]\n                start += 1\n                end -= 1\n    return arr"}
{"task_id": "Mbpp/145", "solution": "def max_Abs_Diff(sequence: Iterable[int]) -> int:\n    \"\"\"\n    Computes the maximum absolute difference between any two integers in the input sequence.\n    Returns 0 if the sequence contains fewer than two elements.\n    \"\"\"\n    min_val = None\n    max_val = None\n    count = 0\n\n    for value in sequence:\n        if min_val is None or value < min_val:\n            min_val = value\n        if max_val is None or value > max_val:\n            max_val = value\n        count += 1\n\n    if count < 2:\n        return 0\n\n    return max_val - min_val"}
{"task_id": "Mbpp/160", "solution": "from typing import Optional, Tuple\ndef find_solution(a: int, b: int, n: int) -> Optional[Tuple[int, int]]:\n    \"\"\"\n    Find integers x and y satisfying ax + by = n.\n    Returns (x, y) or None if no solution exists.\n    \"\"\"\n\n    def _extended_gcd(a_val: int, b_val: int) -> Tuple[int, int, int]:\n        \"\"\"\n        Computes (g, x, y) such that a_val*x + b_val*y = g = gcd(a_val, b_val).\n        This implements the extended Euclidean algorithm.\n        \"\"\"\n        if b_val == 0:\n            return a_val, 1, 0\n        g, x1, y1 = _extended_gcd(b_val, a_val % b_val)\n        x, y = y1, x1 - (a_val // b_val) * y1\n        return g, x, y\n\n    g, x0, y0 = _extended_gcd(a, b)\n\n    if n % g != 0:\n        return None\n\n    # Scale the particular solution (x0, y0) for g to satisfy n.\n    factor = n // g\n    return (x0 * factor, y0 * factor)"}
