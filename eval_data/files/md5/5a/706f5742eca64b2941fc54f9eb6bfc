{"task_id": "Mbpp/261", "solution": "def division_elements(t1, t2):\n    \"\"\"\n    Performs element-wise division of two tuples, validating input lengths and non-zero divisors.\n    Returns a new tuple with the results or raises ValueError for invalid inputs.\n    \"\"\"\n    if len(t1) != len(t2):\n        raise ValueError(\"Tuples must be of equal length.\")\n\n    results = []\n    for i in range(len(t1)):\n        if t2[i] == 0:\n            raise ValueError(\"Division by zero is not allowed.\")\n        results.append(t1[i] / t2[i])\n        \n    return tuple(results)"}
{"task_id": "Mbpp/259", "solution": "def _compute_maxima(a, b):\n    \"\"\"This helper computes the element-wise maximum of two tuples of pairs.\n    It assumes inputs are valid and of the same length and structure.\"\"\"\n    result = []\n    for i in range(len(a)):\n        pair_a = a[i]\n        pair_b = b[i]\n        max_pair = (max(pair_a[0], pair_b[0]), max(pair_a[1], pair_b[1]))\n        result.append(max_pair)\n    return tuple(result)\ndef maximize_elements(a, b):\n    \"\"\"Maximizes corresponding elements from two tuples of integer pairs.\n    It performs (dummy) validation and then computes the maxima.\"\"\"\n    _validate_inputs(a, b)\n    return _compute_maxima(a, b)"}
{"task_id": "Mbpp/260", "solution": "def newman_prime(n: int) -> int:\n    \"\"\"\n    Finds the nth Newman\u2013Shanks\u2013Williams prime number.\n    \"\"\"\n\n    class InputValidator:\n        \"\"\"Validates input parameters.\"\"\"\n        def validate(self, n_val: int) -> None:\n            if not isinstance(n_val, int) or n_val <= 0:\n                raise ValueError(\"n must be a positive integer.\")\n\n    class PrimeChecker:\n        \"\"\"Determines if a number is prime.\"\"\"\n        def isPrime(self, num: int) -> bool:\n            if num < 2:\n                return False\n            if num == 2:\n                return True\n            if num % 2 == 0:\n                return False\n            i = 3\n            while i * i <= num:\n                if num % i == 0:\n                    return False\n                i += 2\n            return True\n\n    class SequenceGenerator:\n        \"\"\"Generates terms of the Newman\u2013Shanks\u2013Williams sequence.\"\"\"\n        def __init__(self):\n            self.s_n_minus_2 = 1 # Corresponds to S(0)\n            self.s_n_minus_1 = 1 # Corresponds to S(1)\n            self.current_index = 0\n\n        def next(self) -> int:\n            if self.current_index == 0:\n                self.current_index = 1\n                return 1\n            elif self.current_index == 1:\n                self.current_index = 2\n                return 1\n            else:\n                s_n = self.s_n_minus_1 + 2 * self.s_n_minus_2\n                self.s_n_minus_2 = self.s_n_minus_1\n                self.s_n_minus_1 = s_n\n                self.current_index += 1\n                return s_n\n\n    class PrimeFinder:\n        \"\"\"Orchestrates sequence generation and prime detection.\"\"\"\n        def __init__(self, seq_gen: 'SequenceGenerator', prime_chk: 'PrimeChecker'):\n            self.seq_gen = seq_gen\n            self.prime_chk = prime_chk\n\n        def findNthPrime(self, n_val: int) -> int:\n            primes_found = 0\n            while True:\n                current_nsw_term = self.seq_gen.next()\n                if self.prime_chk.isPrime(current_nsw_term):\n                    primes_found += 1\n                    if primes_found == n_val:\n                        return current_nsw_term\n\n    # Interface Layer\n    validator = InputValidator()\n    validator.validate(n)\n\n    # Application Layer and Domain Layer instantiation\n    sequence_generator = SequenceGenerator()\n    prime_checker = PrimeChecker()\n    prime_finder = PrimeFinder(sequence_generator, prime_checker)\n\n    return prime_finder.findNthPrime(n)"}
