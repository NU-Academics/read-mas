{"task_id": "Mbpp/632", "solution": "from typing import List\nclass ListProcessor:\n    \"\"\"Domain service that processes lists of integers.\"\"\"\n    @staticmethod\n    def move_zero(lst: List[int]) -> List[int]:\n        \"\"\"Move all zeros to the end of the list, preserving non-zero order.\"\"\"\n        result: List[int] = []\n        zero_count = 0\n        for num in lst:\n            if num == 0:\n                zero_count += 1\n            else:\n                result.append(num)\n        result.extend([0] * zero_count)\n        return result\ndef move_zero(lst: List[int]) -> List[int]:\n    \"\"\"Moves all zeroes to the end of the given list, preserving order of other elements.\"\"\"\n    return ListProcessor.move_zero(lst)"}
{"task_id": "Mbpp/633", "solution": "def pair_xor_Sum(numbers, n):\n    \"\"\"\n    Calculates the sum of XOR of all unique pairs of numbers in the given list.\n    The parameter 'n' is ignored as the length of the list can be obtained directly.\n    \"\"\"\n    total_xor_sum = 0\n    list_length = len(numbers)\n    for i in range(list_length):\n        for j in range(i + 1, list_length):\n            total_xor_sum += numbers[i] ^ numbers[j]\n    return total_xor_sum"}
{"task_id": "Mbpp/635", "solution": "def heap_sort(input_list):\n    \"\"\"Sorts a list of integers using the heap sort algorithm.\"\"\"\n    n = len(input_list)\n    # Create a copy to avoid modifying the original list, as per design.\n    arr = list(input_list)\n\n    # Helper function to heapify a subtree rooted with node i\n    # n is size of heap\n    def _heapify(arr, n, i):\n        largest = i  # Initialize largest as root\n        left = 2 * i + 1  # left child\n        right = 2 * i + 2  # right child\n\n        # See if left child of root exists and is greater than root\n        if left < n and arr[left] > arr[largest]:\n            largest = left\n\n        # See if right child of root exists and is greater than root\n        if right < n and arr[right] > arr[largest]:\n            largest = right\n\n        # Change root, if needed\n        if largest != i:\n            arr[i], arr[largest] = arr[largest], arr[i]  # swap\n            # Heapify the root.\n            _heapify(arr, n, largest)\n\n    # Build a maxheap.\n    # Since last parent will be at ((n//2)-1) we can start there.\n    for i in range(n // 2 - 1, -1, -1):\n        _heapify(arr, n, i)\n\n    # One by one extract elements\n    for i in range(n - 1, 0, -1):\n        arr[i], arr[0] = arr[0], arr[i]  # swap\n        _heapify(arr, i, 0)\n    return arr"}
