{"task_id": "Mbpp/763", "solution": "def find_min_diff(arr, n):\n    \"\"\"\n    Finds the minimum difference between any two elements in the given array.\n    Assumes n is the length of arr and arr contains at least two integers.\n    \"\"\"\n    sorted_arr = sorted(arr)\n    min_diff = float('inf')\n\n    for i in range(n - 1):\n        diff = sorted_arr[i+1] - sorted_arr[i]\n        min_diff = min(min_diff, diff)\n        \n    return min_diff"}
{"task_id": "Mbpp/764", "solution": "def number_ctr(input_string: str) -> int:\n    \"\"\"Counts the number of digit characters in a given string.\n    It iterates through the string, checking each character.\n    \"\"\"\n    count = 0\n    for char in input_string:\n        if '0' <= char <= '9':\n            count += 1\n    return count"}
{"task_id": "Mbpp/767", "solution": "def get_pairs_count(numbers: list[int], target: int) -> int:\n    \"\"\"\n    Counts unordered pairs of integers in `numbers` that sum to `target`.\n    Uses a frequency map to achieve O(n) time complexity.\n    \"\"\"\n    freq_map = {}\n    for num in numbers:\n        freq_map[num] = freq_map.get(num, 0) + 1\n\n    pair_count = 0\n    for num in freq_map:\n        complement = target - num\n        if complement in freq_map:\n            if num == complement:\n                # If num is its own complement, count combinations of num with itself\n                pair_count += freq_map[num] * (freq_map[num] - 1) // 2\n            elif num < complement:\n                # If num and complement are different, count all combinations\n                pair_count += freq_map[num] * freq_map[complement]\n    return pair_count"}
{"task_id": "Mbpp/766", "solution": "from typing import List, Tuple, Any\ndef pair_wise(items: List[Any]) -> List[Tuple[Any, Any]]:\n    \"\"\"\n    Return a list of tuples containing each pair of consecutive items from the input list.\n    If `items` has fewer than two elements, an empty list is returned.\n    \"\"\"\n    if len(items) < 2:\n        return []\n    return [(items[i], items[i + 1]) for i in range(len(items) - 1)]"}
{"task_id": "Mbpp/765", "solution": "def nth_polite(n: int) -> int:\n    \"\"\"\n    Calculates the nth polite number.\n    A polite number is a positive integer that is not a power of two.\n    \"\"\"\n    # The formula for the nth polite number P(n) is n + floor(log2(n+1)) + 1.\n    # Using the bit_length method, floor(log2(x)) for x > 0 can be expressed as x.bit_length() - 1.\n    # Substituting this, the formula simplifies to n + (n+1).bit_length().\n    return n + (n + 1).bit_length()"}
{"task_id": "Mbpp/770", "solution": "def odd_num_sum(n: int) -> int:\n    \"\"\"\n    Calculates the sum of the fourth power of the first n odd natural numbers.\n    \"\"\"\n    if n < 0:\n        raise ValueError(\"Input n must be a non-negative integer.\")\n\n    total_sum = 0\n    for i in range(n):\n        odd_number = 2 * i + 1\n        total_sum += odd_number ** 4\n    return total_sum"}
{"task_id": "Mbpp/771", "solution": "def check_expression(expression: str) -> bool:\n    \"\"\"\n    Checks if the given expression has balanced brackets using a stack.\n    Only considers '()', '{}', and '[]' for balancing.\n    \"\"\"\n    stack = []\n    mapping = {\")\": \"(\", \"}\": \"{\", \"]\": \"[\"}\n    open_brackets = set(mapping.values())\n    close_brackets = set(mapping.keys())\n\n    for char in expression:\n        if char in open_brackets:\n            stack.append(char)\n        elif char in close_brackets:\n            if not stack:\n                return False\n            top_element = stack.pop()\n            if mapping[char] != top_element:\n                return False\n        # Ignore any non-bracket characters as per FR1 implicitly (focus on brackets)\n\n    return not stack"}
{"task_id": "Mbpp/769", "solution": "def Diff(list1, list2):\n    \"\"\"\n    Calculates the difference between two lists, preserving order and applying a special rule for the number 15.\n    Elements present in list1 but not in list2 are included, with 15 appended at the end if it qualifies.\n    \"\"\"\n    set2 = set(list2)\n    result = []\n    fifteen_qualified = False\n\n    for item in list1:\n        if item == 15:\n            if 15 not in set2:\n                fifteen_qualified = True\n            # Do not add 15 here, it will be added at the end if qualified\n        elif item not in set2:\n            result.append(item)\n    \n    if fifteen_qualified:\n        result.append(15)\n        \n    return result"}
{"task_id": "Mbpp/772", "solution": "def remove_length(inputString: str, k: int) -> str:\n    \"\"\"Removes all words of a specified length k from the input string.\"\"\"\n    words = inputString.split()\n    filtered_words = [word for word in words if len(word) != k]\n    return ' '.join(filtered_words)"}
{"task_id": "Mbpp/773", "solution": "def occurance_substring(text: str, substring: str) -> tuple[str, int, int] | None:\n    \"\"\"\n    Finds the first occurrence of a substring within a string.\n    Returns a tuple (substring, start_index, end_index) or None if no match.\n    \"\"\"\n    start_index = text.find(substring)\n    if start_index == -1:\n        return None\n    end_index = start_index + len(substring)\n    return (substring, start_index, end_index)"}
{"task_id": "Mbpp/777", "solution": "def find_sum(values):\n    \"\"\"\n    Calculates the sum of non-repeated elements in a given list of integers.\n    It counts element frequencies and then sums elements that appear exactly once.\n    \"\"\"\n    frequency_map = {}\n    for element in values:\n        frequency_map[element] = frequency_map.get(element, 0) + 1\n\n    total_sum = 0\n    for element, count in frequency_map.items():\n        if count == 1:\n            total_sum += element\n            \n    return total_sum"}
{"task_id": "Mbpp/775", "solution": "from typing import List\ndef odd_position(lst: List[int]) -> bool:\n    \"\"\"\n    Checks if every element at an odd index in a list is an odd number.\n    Returns True if all odd-indexed elements are odd, False otherwise.\n    \"\"\"\n    return all(num % 2 != 0 for i, num in enumerate(lst) if i % 2 == 1)"}
{"task_id": "Mbpp/778", "solution": "def pack_consecutive_duplicates(elements):\n    \"\"\"Packs consecutive duplicate elements into sublists.\"\"\"\n    if not elements:\n        return []\n\n    packed_list = []\n    current_group = [elements[0]]\n\n    for i in range(1, len(elements)):\n        if elements[i] == current_group[-1]:\n            current_group.append(elements[i])\n        else:\n            packed_list.append(current_group)\n            current_group = [elements[i]]\n            \n    packed_list.append(current_group) # Append the last group\n    return packed_list"}
{"task_id": "Mbpp/781", "solution": "import math\ndef count_divisors(n: int) -> bool:\n    \"\"\"\n    Checks if the count of positive divisors for a given integer n is even.\n    The function counts divisors in O(sqrt(n)) time.\n    \"\"\"\n    count = 0\n    # Calculate the integer square root to optimize divisor counting.\n    limit = math.isqrt(n)\n\n    for i in range(1, limit + 1):\n        if n % i == 0:\n            if i * i == n:\n                # If i is the square root, it's a single divisor\n                count += 1\n            else:\n                # Otherwise, i and n // i are two distinct divisors\n                count += 2\n    \n    # Return True if the total count of divisors is even, False otherwise.\n    return count % 2 == 0"}
{"task_id": "Mbpp/780", "solution": "import collections\nfrom typing import List, Tuple\ndef find_combinations(tuples: List[Tuple[int, ...]]) -> List[Tuple[int, ...]]:\n    \"\"\"\n    Calculates element-wise sums of all unique pairs of distinct tuples in the given list.\n    Raises ValueError if tuples in the input list have different lengths.\n    \"\"\"\n    if len(tuples) < 2:\n        return []\n\n    # Validate that all tuples have the same length\n    first_tuple_length = len(tuples[0])\n    for t in tuples:\n        if len(t) != first_tuple_length:\n            raise ValueError(\"All tuples must have the same length\")\n\n    result_combinations = []\n    num_tuples = len(tuples)\n\n    # Iterate over all unique pairs (i, j) where i < j\n    for i in range(num_tuples):\n        for j in range(i + 1, num_tuples):\n            # Compute the element-wise sum of the two tuples\n            sum_tuple = tuple(a + b for a, b in zip(tuples[i], tuples[j]))\n            result_combinations.append(sum_tuple)\n\n    return result_combinations"}
{"task_id": "Mbpp/782", "solution": "def odd_length_sum(arr):\n    \"\"\"\n    Calculates the sum of all odd-length contiguous subarrays in the given list.\n    \"\"\"\n    total_sum = 0\n    n = len(arr)\n\n    # Iterate over all possible starting indices\n    for i in range(n):\n        # Iterate over all possible ending indices\n        for j in range(i, n):\n            # Calculate the length of the current subarray\n            length = j - i + 1\n            \n            # If the length is odd, sum its elements and add to total_sum\n            if length % 2 != 0:\n                for k in range(i, j + 1):\n                    total_sum += arr[k]\n    return total_sum"}
{"task_id": "Mbpp/785", "solution": "def tuple_str_int(tuple_string: str) -> tuple[int]:\n    \"\"\"\n    Converts a string representation of an integer tuple to an actual integer tuple.\n    Raises ValueError for invalid input format or non-integer elements.\n    \"\"\"\n    if not (tuple_string.startswith('(') and tuple_string.endswith(')')):\n        raise ValueError(\"Input string must start with '(' and end with ')'\")\n\n    inner_content = tuple_string[1:-1]\n\n    if not inner_content.strip(): # Handles \"()\" and \"( )\"\n        return ()\n\n    elements_str = inner_content.split(',')\n    result_list = []\n\n    for element_str in elements_str:\n        stripped_element = element_str.strip()\n        try:\n            integer_value = int(stripped_element)\n            result_list.append(integer_value)\n        except ValueError:\n            raise ValueError(f\"Invalid integer literal found: '{stripped_element}'\")\n\n    return tuple(result_list)"}
{"task_id": "Mbpp/784", "solution": "def mul_even_odd(numbers):\n    # Finds the product of the first even and odd numbers in the list.\n    # Assumes valid input list will contain at least one even and one odd number.\n    first_even = None\n    first_odd = None\n\n    for number in numbers:\n        if number % 2 == 0 and first_even is None:\n            first_even = number\n        elif number % 2 != 0 and first_odd is None:\n            first_odd = number\n        \n        if first_even is not None and first_odd is not None:\n            break\n            \n    return first_even * first_odd"}
