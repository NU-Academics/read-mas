{"task_id": "Mbpp/603", "solution": "def get_ludic(limit: int) -> list[int]:\n    \"\"\"\n    Returns a list of 'lucid' numbers up to the given limit.\n    This sequence includes 1 and prime numbers.\n    \"\"\"\n    if limit < 1:\n        return []\n    \n    # Initialize a boolean list for sieve, where is_ludic[i] is True if i is a candidate.\n    # Index 0 is unused, index i corresponds to number i.\n    is_ludic = [True] * (limit + 1)\n    is_ludic[0] = False # 0 is not a lucid number\n\n    ludic_numbers = [1] # 1 is always the first lucid number\n\n    # Iterate from 2 up to the limit using a sieve-like process\n    for p in range(2, limit + 1):\n        if is_ludic[p]:\n            ludic_numbers.append(p)\n            # Mark all multiples of p (starting from p*p) as not lucid\n            for multiple in range(p * p, limit + 1, p):\n                is_ludic[multiple] = False\n                \n    return ludic_numbers"}
{"task_id": "Mbpp/604", "solution": "def reverse_words(text: str) -> str:\n    \"\"\"\n    Reverses the order of words in a given string.\n    Words are delimited by any whitespace, and multiple spaces are treated as a single delimiter.\n    \"\"\"\n    class ReverseWordsService:\n        \"\"\"\n        Domain service for reversing words, following the specified algorithm.\n        \"\"\"\n        def reverse_words(self, text: str) -> str:\n            \"\"\"Splits the text into words, reverses their order, and joins them with single spaces.\"\"\"\n            words = text.split()\n            words.reverse()\n            return ' '.join(words)\n\n    service = ReverseWordsService()\n    return service.reverse_words(text)"}
{"task_id": "Mbpp/605", "solution": "def prime_num(n):\n    \"\"\"\n    Checks if the given integer n is a prime number.\n    Uses trial division up to the square root of n.\n    \"\"\"\n    if n <= 1:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n    \n    i = 3\n    while i * i <= n:\n        if n % i == 0:\n            return False\n        i += 2\n            \n    return True"}
