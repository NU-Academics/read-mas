{"task_id": "Mbpp/7", "solution": "def find_char_long(text):\n    \"\"\"\n    Finds all words in a string that are at least 4 characters long.\n    Words are separated by whitespace, and their original case is preserved.\n    \"\"\"\n    long_words = []\n    words = text.split()\n    for word in words:\n        if len(word) >= 4:\n            long_words.append(word)\n    return long_words"}
{"task_id": "Mbpp/11", "solution": "def remove_Occ(inputString: str, targetChar: str) -> str:\n    \"\"\"\n    Removes the first and last occurrence of a given character from the string.\n    \"\"\"\n    first_occurrence_index = inputString.find(targetChar)\n    if first_occurrence_index == -1:\n        return inputString\n\n    temp_string = inputString[:first_occurrence_index] + inputString[first_occurrence_index+1:]\n\n    last_occurrence_index_temp = temp_string.rfind(targetChar)\n    if last_occurrence_index_temp == -1:\n        return temp_string\n    \n    return temp_string[:last_occurrence_index_temp] + temp_string[last_occurrence_index_temp+1:]"}
{"task_id": "Mbpp/6", "solution": "def differ_At_One_Bit_Pos(a, b):\n    \"\"\"\n    Checks if two non-negative integers differ at exactly one bit position.\n    This is true if their XOR result has exactly one set bit.\n    \"\"\"\n    xor_result = a ^ b\n    # A number has exactly one set bit if it's positive and (num & (num - 1)) is zero.\n    return xor_result > 0 and (xor_result & (xor_result - 1)) == 0"}
{"task_id": "Mbpp/9", "solution": "def find_Rotations(s: str) -> int:\n    \"\"\"\n    Finds the minimum number of rotations (greater than 0) required to get the same string.\n    The string must be formed by repeating a prefix of that length.\n    \"\"\"\n    n = len(s)\n    # Iterate through all possible lengths k of the repeating unit.\n    # The length of the repeating unit must be a divisor of the string's total length.\n    for k in range(1, n + 1):\n        if n % k == 0:\n            # Check if the string can be formed by repeating its prefix of length k.\n            if s == s[:k] * (n // k):\n                return k\n    # This line should theoretically not be reached for non-empty strings,\n    # as k=n will always satisfy the condition (s == s[:n] * 1)."}
{"task_id": "Mbpp/3", "solution": "def is_not_prime(n: int) -> bool:\n    \"\"\"\n    Determines if a given integer is not a prime number.\n    Returns True if the number is not prime, False if it is prime.\n    \"\"\"\n    if n <= 1:\n        return True\n    if n == 2:\n        return False\n    if n % 2 == 0:\n        return True\n\n    i = 3\n    while i * i <= n:\n        if n % i == 0:\n            return True\n        i += 2\n    return False"}
