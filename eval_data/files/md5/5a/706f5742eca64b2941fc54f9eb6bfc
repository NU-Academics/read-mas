{"task_id": "Mbpp/588", "solution": "def big_diff(values: List[Union[int, float]]) -> Union[int, float]:\n    \"\"\"\n    Compute the difference between the largest and smallest numeric values in a list.\n    Handles validation for empty or non-numeric lists and returns 0 for single-element lists.\n    \"\"\"\n    if not values:\n        raise ValueError(\"Input list must not be empty\")\n\n    for v in values:\n        if not isinstance(v, (int, float)):\n            raise TypeError(f\"Non-numeric value encountered: {v!r}\")\n\n    if len(values) == 1:\n        return 0\n\n    max_val = max(values)\n    min_val = min(values)\n    diff = max_val - min_val\n\n    if all(isinstance(v, int) for v in values):\n        return int(diff)\n    return float(diff)"}
{"task_id": "Mbpp/589", "solution": "import math\nfrom typing import List\ndef perfect_squares(lowerBound: int, upperBound: int) -> List[int]:\n    \"\"\"\n    Finds perfect squares within the given inclusive range, sorted in ascending order.\n    \"\"\"\n    start = math.ceil(math.sqrt(lowerBound))\n    end = math.floor(math.sqrt(upperBound))\n\n    if start > end:\n        return []\n\n    return [i * i for i in range(start, end + 1)]"}
