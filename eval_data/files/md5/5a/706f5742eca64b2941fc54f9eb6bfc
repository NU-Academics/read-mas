{"task_id": "Mbpp/638", "solution": "import math\nclass WindSpeed:\n    \"\"\"Represents wind velocity with its value and unit.\"\"\"\n    def __init__(self, value: float, unit: str):\n        self.value = value\n        self.unit = unit\nclass Temperature:\n    \"\"\"Represents temperature with its value and unit.\"\"\"\n    def __init__(self, value: float, unit: str):\n        self.value = value\n        self.unit = unit\nclass WindChillIndex:\n    \"\"\"Represents the calculated wind chill index with its value and unit.\"\"\"\n    def __init__(self, value: int, unit: str):\n        self.value = value\n        self.unit = unit\nclass WindChillCalculator:\n    \"\"\"Calculates the wind chill index based on wind speed and temperature.\"\"\"\n    def calculate(self, wind_speed: WindSpeed, temperature: Temperature) -> WindChillIndex:\n        T = temperature.value\n        V = wind_speed.value\n\n        # Apply the standard wind chill formula (Environment Canada/USA).\n        # This formula is applied universally as per the provided assertion.\n        v_pow_0_16 = V**0.16\n        raw_wind_chill = 13.12 + (0.6215 * T) - (11.37 * v_pow_0_16) + (0.3965 * T * v_pow_0_16)\n\n        # \"rounded to the next integer\" is interpreted as rounding to the nearest integer\n        # to satisfy the given assertion: assert wind_chill(120,35)==40.\n        rounded_wind_chill = int(round(raw_wind_chill))\n\n        return WindChillIndex(rounded_wind_chill, \"\u00b0C\")\ndef wind_chill(wind_speed_kmh: float, temperature_c: float) -> int:\n    \"\"\"\n    Calculates the wind chill index rounded to the nearest integer.\n    \"\"\"\n    ws = WindSpeed(wind_speed_kmh, \"km/h\")\n    temp = Temperature(temperature_c, \"\u00b0C\")\n\n    calculator = WindChillCalculator()\n    wind_chill_index_obj = calculator.calculate(ws, temp)\n\n    return wind_chill_index_obj.value"}
