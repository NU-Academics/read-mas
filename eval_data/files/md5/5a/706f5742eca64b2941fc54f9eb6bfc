{"task_id": "Mbpp/580", "solution": "from typing import Tuple\ndef extract_even(input_tuple: Tuple) -> Tuple:\n    \"\"\"Removes odd integers from a nested tuple, preserving the original nesting structure.\n    A new tuple is constructed and returned without modifying the input.\n    \"\"\"\n    if not isinstance(input_tuple, tuple):\n        raise TypeError(\"input_tuple must be a tuple\")\n\n    def _filter(t: Tuple) -> Tuple:\n        result = []\n        for element in t:\n            if isinstance(element, tuple):\n                filtered = _filter(element)\n                if filtered:\n                    result.append(filtered)\n            elif isinstance(element, int) and element % 2 == 0:\n                result.append(element)\n        return tuple(result)\n\n    return _filter(input_tuple)"}
{"task_id": "Mbpp/583", "solution": "class CatalanNumber:\n    \"\"\"Encapsulates a Catalan number value.\"\"\"\n    def __init__(self, value: int):\n        self._value = value\n\n    def get_value(self) -> int:\n        \"\"\"Returns the integer value of the Catalan number.\"\"\"\n        return self._value\nclass CatalanCalculator:\n    \"\"\"Computes Catalan numbers using an iterative approach.\"\"\"\n    def compute(self, n: int) -> CatalanNumber:\n        \"\"\"Calculates the nth Catalan number based on its recurrence relation.\"\"\"\n        if n == 0:\n            return CatalanNumber(1)\n\n        # Initialize an array to store Catalan numbers up to n\n        catalan_series = [0] * (n + 1)\n        catalan_series[0] = 1\n\n        # Compute C(i) using the recurrence C(i) = (C(i-1) * (4*i - 2)) // (i + 1)\n        for i in range(1, n + 1):\n            catalan_series[i] = (catalan_series[i-1] * (4 * i - 2)) // (i + 1)\n\n        return CatalanNumber(catalan_series[n])\ndef catalan_number(n: int) -> int:\n    \"\"\"\n    Returns the nth Catalan number.\n    This function delegates the computation to an internal CatalanCalculator.\n    \"\"\"\n    calculator = CatalanCalculator()\n    result_catalan_obj = calculator.compute(n)\n    return result_catalan_obj.get_value()"}
{"task_id": "Mbpp/581", "solution": "import math\ndef surface_Area(baseEdge, height):\n    base_area = baseEdge ** 2\n    lateral_area = 2 * baseEdge * height\n    surface_area = base_area + lateral_area\n    if isinstance(baseEdge, int) and isinstance(height, int) and surface_area.is_integer():\n        return int(surface_area)\n    return surface_area"}
{"task_id": "Mbpp/585", "solution": "from typing import Any, Dict, List\ndef expensive_items(items: List[Dict[str, Any]], n: int) -> List[Dict[str, Any]]:\n    \"\"\"\n    Returns the n items with the highest price from the input list.\n    The output list is sorted by price in descending order.\n    \"\"\"\n    # Create a shallow copy to ensure the original list is not modified.\n    items_copy = list(items)\n\n    # Sort the items by their 'price' in descending order.\n    sorted_items = sorted(items_copy, key=lambda item: item['price'], reverse=True)\n\n    # Return the first n items from the sorted list.\n    return sorted_items[:n]"}
