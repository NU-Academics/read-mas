{"task_id": "Mbpp/239", "solution": "class SequenceGenerator:\n    \"\"\"\n    Orchestrates the counting logic for sequences.\n    \"\"\"\n    def __init__(self, m: int, n: int):\n        self.m = m\n        self.n = n\n\n    def count_sequences(self) -> int:\n        \"\"\"\n        Calculates the number of valid sequences using dynamic programming.\n        \"\"\"\n        # dp_current_len[j] stores the number of sequences of current_length ending with j\n        # prefix_sum_current_len[j] stores sum(dp_current_len[x] for x=1 to j)\n\n        # Base case for sequences of length 1: any number from 1 to m is a valid sequence.\n        # prev_dp and prev_prefix_sum store values for length (current_length - 1)\n        prev_dp = [0] * (self.m + 1)\n        prev_prefix_sum = [0] * (self.m + 1)\n\n        for j in range(1, self.m + 1):\n            prev_dp[j] = 1\n            prev_prefix_sum[j] = prev_prefix_sum[j-1] + prev_dp[j]\n            \n        # Iterate for lengths from 2 up to n\n        for current_length in range(2, self.n + 1):\n            current_dp = [0] * (self.m + 1)\n            current_prefix_sum = [0] * (self.m + 1)\n            for j in range(1, self.m + 1):\n                # The previous element must be <= j // 2 and >= 1\n                max_prev_val_idx = j // 2\n                \n                if max_prev_val_idx >= 1:\n                    # Sum of valid previous elements is prefix_sum_prev_len[max_prev_val_idx]\n                    current_dp[j] = prev_prefix_sum[max_prev_val_idx]\n                # else current_dp[j] remains 0 as no valid previous element exists\n                \n                current_prefix_sum[j] = current_prefix_sum[j-1] + current_dp[j]\n            \n            # Update previous results for the next iteration\n            prev_dp = current_dp\n            prev_prefix_sum = current_prefix_sum\n            \n        # The total count of sequences of length n is the sum of all sequences ending at any value up to m\n        return prev_prefix_sum[self.m]\ndef get_total_number_of_sequences(m: int, n: int) -> int:\n    \"\"\"\n    Finds the number of possible sequences of length n, such that each element is a positive\n    integer and is greater than or equal to twice the previous element but less than or equal to m.\n    \"\"\"\n    generator = SequenceGenerator(m, n)\n    count = generator.count_sequences()\n    return count"}
