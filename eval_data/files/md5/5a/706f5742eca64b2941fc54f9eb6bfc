{"task_id": "Mbpp/116", "solution": "def tuple_to_int(numbers):\n    \"\"\"\n    Converts a tuple of positive integers into a single concatenated integer.\n    Each number is converted to a string and then joined.\n    \"\"\"\n    if not numbers:\n        raise ValueError(\"Input tuple cannot be empty.\")\n\n    string_parts = []\n    for num in numbers:\n        if not isinstance(num, int) or num <= 0:\n            raise ValueError(\"All elements in the tuple must be positive integers.\")\n        string_parts.append(str(num))\n\n    return int(\"\".join(string_parts))"}
{"task_id": "Mbpp/119", "solution": "from typing import List\ndef search(arr: List[int]) -> int:\n    \"\"\"\n    Find the element that appears only once in a sorted array where other elements appear twice.\n    Uses a binary search approach to achieve O(log n) time complexity.\n    \"\"\"\n    left, right = 0, len(arr) - 1\n\n    while left < right:\n        mid = (left + right) // 2\n        # Ensure mid points to an even index for pair comparison\n        if mid % 2 == 1:\n            mid -= 1\n\n        # If elements at mid and mid+1 are the same, the unique element is to the right\n        if arr[mid] == arr[mid + 1]:\n            left = mid + 2\n        # Otherwise, the unique element is at or to the left of mid\n        else:\n            right = mid\n\n    return arr[left]"}
{"task_id": "Mbpp/109", "solution": "def odd_Equivalent(binary_str: str, rotations: int) -> int:\n    \"\"\"\n    Count how many left-rotations of a binary string produce an odd integer.\n    Raises ValueError for invalid input.\n    \"\"\"\n    if not all(c in '01' for c in binary_str):\n        raise ValueError(\"binary_str must contain only '0' or '1'\")\n\n    if rotations < 0:\n        raise ValueError(\"rotations must be non-negative\")\n\n    n = len(binary_str)\n    if n == 0 or rotations == 0:\n        return 0\n\n    odd_count = 0\n    full_cycle_odd_count = 0\n\n    # Calculate the number of odd values in one full cycle of 'n' rotations.\n    # For 'i' left rotations, the LSB is the character originally at index ((n-1) + i) % n.\n    for i_cycle in range(n):\n        lsb_original_idx = ((n - 1) + i_cycle) % n\n        if binary_str[lsb_original_idx] == '1':\n            full_cycle_odd_count += 1\n\n    # Add counts from full cycles\n    num_full_cycles = rotations // n\n    odd_count += num_full_cycles * full_cycle_odd_count\n\n    # Add counts from remaining rotations\n    remaining_rotations = rotations % n\n    for i_rem in range(remaining_rotations):\n        lsb_original_idx = ((n - 1) + i_rem) % n\n        if binary_str[lsb_original_idx] == '1':\n            odd_count += 1\n\n    return odd_count"}
{"task_id": "Mbpp/123", "solution": "def amicable_numbers_sum(limit):\n    \"\"\"\n    Sums all amicable numbers from 1 up to a specified limit.\n    Uses memoization to efficiently calculate sums of proper divisors.\n    \"\"\"\n    s_cache = {}\n\n    def get_sum_proper_divisors(num):\n        if num in s_cache:\n            return s_cache[num]\n\n        if num == 1:\n            s_cache[num] = 0\n            return 0\n\n        current_sum = 1  # 1 is always a proper divisor for num > 1\n        sqrt_num = int(num**0.5)\n        for i in range(2, sqrt_num + 1):\n            if num % i == 0:\n                current_sum += i\n                if i * i != num:\n                    current_sum += num // i\n        \n        s_cache[num] = current_sum\n        return current_sum\n\n    total_amicable_sum = 0\n    for n in range(1, limit + 1):\n        sum_n_divisors = get_sum_proper_divisors(n)\n\n        # Check for amicable pair (n, sum_n_divisors)\n        # We ensure sum_n_divisors > n to count each pair only once (e.g., 220, 284 but not 284, 220)\n        # And both numbers of the pair must be within the limit\n        if sum_n_divisors > n and sum_n_divisors <= limit:\n            sum_b_divisors = get_sum_proper_divisors(sum_n_divisors)\n            \n            if sum_b_divisors == n:\n                total_amicable_sum += n\n                total_amicable_sum += sum_n_divisors \n                \n    return total_amicable_sum"}
{"task_id": "Mbpp/120", "solution": "def max_product_tuple(tuples):\n    \"\"\"\n    Finds the maximum absolute product between numbers in pairs of tuples within a given list.\n    Returns 0 if the input list is empty.\n    \"\"\"\n    max_prod = 0\n    for a, b in tuples:\n        current_prod = abs(a * b)\n        if current_prod > max_prod:\n            max_prod = current_prod\n    return max_prod"}
{"task_id": "Mbpp/125", "solution": "def find_length(binary_string: str) -> int:\n    \"\"\"\n    Finds the maximum difference between the count of 0s and 1s in any substring.\n    This uses Kadane's algorithm to find the maximum subarray sum for two scenarios:\n    (0s as +1, 1s as -1) and (0s as -1, 1s as +1).\n    \"\"\"\n    n = len(binary_string)\n    if n == 0:\n        return 0\n\n    # Helper function for Kadane's algorithm, finding the maximum sum of a contiguous subarray.\n    def _kadane(arr):\n        max_so_far = arr[0]\n        current_max = arr[0]\n        for x in arr[1:]:\n            current_max = max(x, current_max + x)\n            max_so_far = max(max_so_far, current_max)\n        return max_so_far\n\n    # Scenario 1: Maximize (count_0 - count_1)\n    # Treat '0' as +1 and '1' as -1.\n    arr1 = [1 if char == '0' else -1 for char in binary_string]\n    max_zeros_minus_ones = _kadane(arr1)\n\n    # Scenario 2: Maximize (count_1 - count_0)\n    # Treat '0' as -1 and '1' as +1.\n    arr2 = [-1 if char == '0' else 1 for char in binary_string]\n    max_ones_minus_zeros = _kadane(arr2)\n\n    # The maximum difference is the greater of the two scenarios, as it effectively captures abs(diff).\n    return max(max_zeros_minus_ones, max_ones_minus_zeros)"}
