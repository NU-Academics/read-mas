{"task_id": "Mbpp/96", "solution": "import math\nclass Number:\n    \"\"\"\n    Domain entity encapsulating an integer and providing its divisor count.\n    \"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def get_divisors_count(self) -> int:\n        \"\"\"\n        Computes the number of positive divisors for the encapsulated integer value.\n        \"\"\"\n        n_abs = abs(self.value)\n\n        if n_abs == 0:\n            return 0  # Zero has no positive divisors in this context.\n        if n_abs == 1:\n            return 1  # One has a single positive divisor (itself).\n\n        count = 0\n        # Iterate up to the square root to find divisors efficiently.\n        for i in range(1, int(math.sqrt(n_abs)) + 1):\n            if n_abs % i == 0:\n                if i * i == n_abs:\n                    count += 1\n                else:\n                    count += 2\n        return count\nclass DivisorCalculator:\n    \"\"\"\n    Domain service for calculating divisors, delegating the core logic to the Number entity.\n    \"\"\"\n    @staticmethod\n    def divisor(n: int) -> int:\n        \"\"\"\n        Calculates the number of positive divisors for a given integer.\n        \"\"\"\n        number_entity = Number(n)\n        return number_entity.get_divisors_count()\ndef divisor(n: int) -> int:\n    \"\"\"\n    Finds the number of positive divisors of a given integer.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"Input must be an integer.\")\n    return DivisorCalculator.divisor(n)"}
{"task_id": "Mbpp/95", "solution": "from typing import List, Any\ndef Find_Min_Length(lists: List[List[Any]]) -> int:\n    \"\"\"\n    Return the length of the shortest sub-list in `lists`.\n\n    Returns 0 if the input list is empty or contains any empty sub-list.\n    \"\"\"\n    if not lists:\n        return 0\n\n    min_length = float('inf')\n    for sublist in lists:\n        current_length = len(sublist)\n        if current_length == 0:\n            return 0  # Per requirement, return 0 if any sub-list is empty\n        min_length = min(min_length, current_length)\n\n    return int(min_length)"}
{"task_id": "Mbpp/97", "solution": "def frequency_lists(list_of_lists: list[list[int]]) -> dict[int, int]:\n    \"\"\"\n    Calculates the frequency of each element in a flattened list of lists.\n    A nested FrequencyCounter class is used to perform the counting logic.\n    \"\"\"\n    class FrequencyCounter:\n        \"\"\"\n        Helper class to encapsulate the frequency counting logic.\n        \"\"\"\n        def count_frequencies(self, data: list[list[int]]) -> dict[int, int]:\n            \"\"\"\n            Flattens a list of lists and counts the frequency of each element.\n            \"\"\"\n            frequency_map = {}\n            for sublist in data:\n                for item in sublist:\n                    frequency_map[item] = frequency_map.get(item, 0) + 1\n            return frequency_map\n\n    counter_instance = FrequencyCounter()\n    return counter_instance.count_frequencies(list_of_lists)"}
{"task_id": "Mbpp/98", "solution": "def multiply_num(numbers: list[float]) -> float:\n    \"\"\"Multiplies all numbers in a list and divides the product by the list's length.\"\"\"\n    if not numbers:\n        raise ZeroDivisionError(\"Cannot divide by zero: the input list is empty.\")\n\n    product = 1.0\n    for num in numbers:\n        product *= num\n\n    return product / len(numbers)"}
{"task_id": "Mbpp/99", "solution": "def decimal_to_binary(decimal: int) -> str:\n    \"\"\"\n    Converts a non-negative decimal integer to its binary string representation.\n    The output string has no leading zeros, except for the value 0 itself.\n    \"\"\"\n    if decimal == 0:\n        return \"0\"\n\n    bits = []\n    while decimal > 0:\n        bits.append(str(decimal & 1))\n        decimal >>= 1\n\n    return ''.join(reversed(bits))"}
