{"task_id": "Mbpp/103", "solution": "class EulerianNumberCalculator:\n    \"\"\"Calculates Eulerian numbers using memoized recursion.\"\"\"\n    def __init__(self):\n        self._memo = {}\n\n    def compute(self, n: int, m: int) -> int:\n        \"\"\"\n        Computes the Eulerian number a(n, m) using recurrence and memoization.\n        Handles base cases where a(n,m) is 0 or 1.\n        \"\"\"\n        if (n, m) in self._memo:\n            return self._memo[(n, m)]\n\n        # Base cases for the recurrence\n        # a(n,m) = 0 if m < 0 or m >= n (for n > 0)\n        # a(0,m) = 0 if m != 0\n        if m < 0 or m >= n:\n            return 0\n        if n == 0 and m == 0:\n            return 1\n        \n        # Recurrence relation: a(n,m) = (n-m)*a(n-1,m-1) + (m+1)*a(n-1,m)\n        term1 = (n - m) * self.compute(n - 1, m - 1)\n        term2 = (m + 1) * self.compute(n - 1, m)\n        result = term1 + term2\n\n        self._memo[(n, m)] = result\n        return result\n_eulerian_calculator = EulerianNumberCalculator()\ndef eulerian_num(n: int, m: int) -> int:\n    \"\"\"\n    Calculates the Eulerian number a(n, m).\n    Validates inputs and uses a memoized recursive calculator.\n    \"\"\"\n    # Input validation as per FR-002 and System Implementation\n    if not isinstance(n, int) or not isinstance(m, int):\n        raise ValueError(\"n and m must be integers.\")\n    if n < 0 or m < 0:\n        raise ValueError(\"n and m must be non-negative integers.\")\n    # For a(n,m), m must be in range [0, n-1]. The only exception is a(0,0)=1.\n    if m >= n and not (n == 0 and m == 0):\n        raise ValueError(\"m must be less than n, unless n and m are both 0.\")\n    \n    # Delegate computation to the global memoized calculator instance.\n    return _eulerian_calculator.compute(n, m)"}
