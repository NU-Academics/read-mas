{"task_id": "Mbpp/745", "solution": "from typing import List\nclass Number:\n    def __init__(self, value: int):\n        self.value = value\n        self.digits: List[int] = [int(d) for d in str(value)]\n\n    def is_valid(self) -> bool:\n        \"\"\"Return True if the number is divisible by each of its digits and contains no zero.\"\"\"\n        if 0 in self.digits:\n            return False\n        return all(self.value % d == 0 for d in self.digits)\nclass Range:\n    def __init__(self, start: int, end: int):\n        self.start = start\n        self.end = end\n\n    def validate(self) -> None:\n        \"\"\"Validate that start and end are positive integers and start <= end.\"\"\"\n        if not (isinstance(self.start, int) and isinstance(self.end, int)):\n            raise TypeError(\"Start and end must be integers.\")\n        if self.start <= 0 or self.end <= 0:\n            raise ValueError(\"Start and end must be positive.\")\n        if self.start > self.end:\n            raise ValueError(\"Start must be less than or equal to end.\")\ndef divisible_by_digits(startnum: int, endnum: int) -> List[int]:\n    \"\"\"\n    Return a sorted list of integers within [startnum, endnum] that are divisible by each of their digits.\n    Numbers containing the digit zero are excluded.\n    \"\"\"\n    rng = Range(startnum, endnum)\n    rng.validate()\n\n    result: List[int] = []\n    for n in range(rng.start, rng.end + 1):\n        num = Number(n)\n        if num.is_valid():\n            result.append(n)\n\n    result.sort()\n    return result"}
{"task_id": "Mbpp/748", "solution": "def capital_words_spaces(input_string: str) -> str:\n    \"\"\"\n    Inserts spaces before words starting with capital letters, except for the very first character.\n    Processes the string in linear time.\n    \"\"\"\n    if not input_string:\n        return \"\"\n    \n    result_chars = [input_string[0]]\n    for char in input_string[1:]:\n        if char.isupper():\n            result_chars.append(' ')\n        result_chars.append(char)\n        \n    return \"\".join(result_chars)"}
