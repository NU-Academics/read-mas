{"task_id": "Mbpp/751", "solution": "def check_min_heap(arr):\n    \"\"\"\n    Checks if the given array represents a min heap.\n    An empty array is considered a valid min-heap.\n    \"\"\"\n    n = len(arr)\n    if n == 0:\n        return True\n\n    # Iterate only through parent nodes\n    # The last parent node is at index n // 2 - 1\n    for i in range(n // 2):\n        left_child_idx = 2 * i + 1\n        right_child_idx = 2 * i + 2\n\n        # Check left child\n        if left_child_idx < n and arr[i] > arr[left_child_idx]:\n            return False\n\n        # Check right child\n        if right_child_idx < n and arr[i] > arr[right_child_idx]:\n            return False\n\n    return True"}
{"task_id": "Mbpp/752", "solution": "def jacobsthal_num(n: int) -> int:\n    \"\"\"Calculates the nth Jacobsthal number using an iterative approach.\"\"\"\n    if n == 0:\n        return 0\n    elif n == 1:\n        return 1\n    \n    a, b = 0, 1\n    for _ in range(2, n + 1):\n        a, b = b, a + 2 * b\n    return b"}
{"task_id": "Mbpp/753", "solution": "import heapq\nfrom dataclasses import dataclass\nclass MinKFunction:\n    \"\"\"Encapsulates the algorithm to select the smallest k records.\"\"\"\n    def execute(self, records_data: list[Record], k_val: int) -> list[Record]:\n        if k_val <= 0:\n            return []\n        \n        # Uses heapq.nsmallest for O(N log k) performance and stable sorting.\n        # It handles k > len(records_data) by returning all records sorted.\n        result = heapq.nsmallest(k_val, records_data, key=lambda x: x.value)\n        return result\ndef min_k(records, k):\n    \"\"\"Finds the minimum k records from a list of (name, value) tuples.\"\"\"\n    # Convert input tuples to Record objects for internal processing.\n    record_objects = [Record(name=r[0], value=r[1]) for r in records]\n\n    # Use the MinKFunction service to execute the core logic.\n    min_k_service = MinKFunction()\n    min_records = min_k_service.execute(record_objects, k)\n\n    # Convert the resulting Record objects back to tuples for the output.\n    result_tuples = [(r.name, r.value) for r in min_records]\n\n    return result_tuples"}
{"task_id": "Mbpp/754", "solution": "def extract_index_list(l1, l2, l3):\n    \"\"\"\n    Finds elements that appear at the same index in all three lists.\n    Compares elements up to the length of the shortest input list.\n    \"\"\"\n    result = []\n    min_length = min(len(l1), len(l2), len(l3))\n\n    for i in range(min_length):\n        if l1[i] == l2[i] and l2[i] == l3[i]:\n            result.append(l1[i])\n    return result"}
{"task_id": "Mbpp/759", "solution": "import re\ndef is_decimal(s: str) -> bool:\n    \"\"\"\n    Checks if a string represents a decimal number with exactly two digits after the decimal point.\n    Uses regex pattern ^\\d+\\.\\d{2}$.\n    \"\"\"\n    pattern = r\"^\\d+\\.\\d{2}$\"\n    return re.fullmatch(pattern, s) is not None"}
{"task_id": "Mbpp/757", "solution": "def count_reverse_pairs(strings: list[str]) -> int:\n    \"\"\"Counts unique pairs of strings where one is the reverse of the other.\n    Each string can participate in at most one pair.\n    \"\"\"\n    pair_count = 0\n    # Stores strings encountered that haven't yet formed a pair.\n    unmatched_strings = set()\n\n    for s in strings:\n        reversed_s = s[::-1]\n        \n        # If the reverse of the current string is found in unmatched_strings, increment count.\n        if reversed_s in unmatched_strings:\n            pair_count += 1\n            # Remove the matched string to prevent reuse.\n            unmatched_strings.remove(reversed_s)\n        else:\n            # Add the current string to the set for future matching.\n            unmatched_strings.add(s)\n            \n    return pair_count"}
{"task_id": "Mbpp/760", "solution": "def unique_Element(list_of_numbers):\n    \"\"\"Checks if a list of numbers contains only one distinct element.\n    Returns True for empty lists or lists with identical elements, False otherwise.\"\"\"\n    if not list_of_numbers:\n        return True\n    \n    # Store the first element as a reference.\n    first_element = list_of_numbers[0]\n    \n    # Iterate through the list; if any element differs from the reference, return False.\n    for element in list_of_numbers:\n        if element != first_element:\n            return False\n            \n    # If the loop completes, all elements were identical to the first.\n    return True"}
{"task_id": "Mbpp/758", "solution": "def unique_sublists(inputList):\n    \"\"\"\n    Counts occurrences of sub-lists, converting them to tuples, and returns a dictionary of counts.\n    \"\"\"\n    counts = {}\n    for sublist in inputList:\n        # Convert each sublist to a tuple to use as a hashable dictionary key.\n        sublist_tuple = tuple(sublist)\n        counts[sublist_tuple] = counts.get(sublist_tuple, 0) + 1\n    return counts"}
{"task_id": "Mbpp/755", "solution": "def second_smallest(numbers):\n    \"\"\"\n    Finds the second smallest distinct number in a list of integers.\n    Assumes the list contains at least two distinct integers and valid input types.\n    \"\"\"\n    first_min = float('inf')\n    second_min = float('inf')\n\n    for num in numbers:\n        if num < first_min:\n            second_min = first_min\n            first_min = num\n        elif num < second_min and num != first_min:\n            second_min = num\n            \n    return second_min"}
