{"task_id": "Mbpp/556", "solution": "def find_Odd_Pair(arr: List[int], n: int) -> int:\n    \"\"\"\n    Count unordered pairs in `arr` whose XOR value is odd.\n    \"\"\"\n    if len(arr) != n:\n        raise ValueError(f\"Array length {len(arr)} does not match provided n={n}\")\n\n    even_count = 0\n    odd_count = 0\n    for num in arr:\n        if num % 2 == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n\n    return even_count * odd_count"}
{"task_id": "Mbpp/555", "solution": "def difference(n: int) -> int:\n    \"\"\"\n    Write a python function to find the difference between the sum of cubes of the first n natural numbers and the sum of the first n natural numbers.\n    \"\"\"\n    class NumberSequence:\n        \"\"\"\n        Domain entity representing the first n natural numbers.\n        Provides closed\u2011form calculations for sum_of_numbers, sum_of_cubes, and their difference.\n        \"\"\"\n\n        def __init__(self, n_val: int) -> None:\n            if n_val <= 0:\n                raise ValueError(\"n must be a positive integer\")\n            self.n = n_val\n\n        def sum_of_numbers(self) -> int:\n            \"\"\"Return n(n+1)/2.\"\"\"\n            return self.n * (self.n + 1) // 2\n\n        def sum_of_cubes(self) -> int:\n            \"\"\"Return (n(n+1)/2)^2.\"\"\"\n            s = self.sum_of_numbers()\n            return s * s\n\n        def difference(self) -> int:\n            \"\"\"Return sum_of_cubes - sum_of_numbers.\"\"\"\n            return self.sum_of_cubes() - self.sum_of_numbers()\n\n    seq = NumberSequence(n)\n    return seq.difference()"}
{"task_id": "Mbpp/557", "solution": "def toggle_string(input_string: str) -> str:\n    \"\"\"Toggles the case of all ASCII alphabetic characters in a string.\"\"\"\n    toggled_chars = []\n    for char in input_string:\n        if char.isascii() and char.isalpha():\n            if char.islower():\n                toggled_chars.append(char.upper())\n            else:  # char.isupper()\n                toggled_chars.append(char.lower())\n        else:\n            toggled_chars.append(char)\n    return \"\".join(toggled_chars)"}
{"task_id": "Mbpp/558", "solution": "def digit_distance_nums(a: int, b: int) -> int:\n    \"\"\"\n    Calculates the sum of per-digit absolute differences between two integers.\n    Pads the shorter number with leading zeros for alignment.\n    \"\"\"\n    s_a = str(a)\n    s_b = str(b)\n\n    max_len = max(len(s_a), len(s_b))\n\n    s_a = s_a.zfill(max_len)\n    s_b = s_b.zfill(max_len)\n\n    total_distance = 0\n    for digit_a, digit_b in zip(s_a, s_b):\n        total_distance += abs(int(digit_a) - int(digit_b))\n\n    return total_distance"}
{"task_id": "Mbpp/559", "solution": "from typing import List\ndef max_sub_array_sum(inputList: List[int]) -> int:\n    \"\"\"Finds the maximum sum of a contiguous sub-array using Kadane's algorithm.\"\"\"\n    \n    max_so_far = inputList[0]\n    current_max = inputList[0]\n\n    for i in range(1, len(inputList)):\n        current_max = max(inputList[i], current_max + inputList[i])\n        max_so_far = max(max_so_far, current_max)\n        \n    return max_so_far"}
