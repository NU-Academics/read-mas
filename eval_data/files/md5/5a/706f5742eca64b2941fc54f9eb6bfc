{"task_id": "Mbpp/723", "solution": "class ListPair:\n    \"\"\"Holds two lists for comparison.\"\"\"\n    def __init__(self, list1, list2):\n        self.list1 = list1\n        self.list2 = list2\nclass CountCalculator:\n    \"\"\"Calculates the count of matching elements at the same indices.\"\"\"\n    def count_same_pair(self, pair: ListPair) -> int:\n        count = 0\n        for i in range(len(pair.list1)):\n            if pair.list1[i] == pair.list2[i]:\n                count += 1\n        return count\ndef count_same_pair(list1, list2):\n    \"\"\"\n    Counts indices where two lists have the same values.\n    This function orchestrates ListPair and CountCalculator for the operation.\n    \"\"\"\n    pair_instance = ListPair(list1, list2)\n    calculator = CountCalculator()\n    return calculator.count_same_pair(pair_instance)"}
{"task_id": "Mbpp/721", "solution": "def maxAverageOfPath(matrix):\n    \"\"\"\n    Finds the path from top-left to bottom-right in a square matrix,\n    moving only right or down, that yields the maximum average cost.\n    \"\"\"\n    N = len(matrix)\n    # For an N*N matrix, any valid path from (0,0) to (N-1,N-1) always visits 2*N - 1 cells.\n    # Therefore, maximizing the average (total_cost / num_cells) is equivalent to maximizing the total_cost.\n    num_cells_in_path = 2 * N - 1\n\n    all_path_sums = []\n\n    def dfs(r, c, current_path_sum):\n        # Add the cost of the current cell to the path sum\n        current_path_sum += matrix[r][c]\n\n        # Base case: If we've reached the bottom-right cell\n        if r == N - 1 and c == N - 1:\n            all_path_sums.append(current_path_sum)\n            return\n\n        # Recursive step: Explore moving right\n        if c + 1 < N:\n            dfs(r, c + 1, current_path_sum)\n\n        # Recursive step: Explore moving down\n        if r + 1 < N:\n            dfs(r + 1, c, current_path_sum)\n\n    # Start the depth-first search from the top-left cell (0, 0)\n    # The initial current_path_sum is 0 before adding the cost of matrix[0][0].\n    dfs(0, 0, 0)\n\n    # Find the maximum total cost among all generated paths\n    max_total_cost = max(all_path_sums)\n\n    # Calculate the maximum average\n    max_average = max_total_cost / num_cells_in_path\n\n    return max_average"}
