{"task_id": "Mbpp/733", "solution": "def find_first_occurrence(array: List[int], target: int) -> int:\n    \"\"\"\n    Finds the index of the first occurrence of a target number in a sorted array using binary search.\n    Raises ValueError if the input array is not sorted.\n    \"\"\"\n    for i in range(len(array) - 1):\n        if array[i] > array[i+1]:\n            raise ValueError(\"Input array must be sorted in non-decreasing order.\")\n\n    low = 0\n    high = len(array) - 1\n    result = -1\n\n    while low <= high:\n        mid = low + (high - low) // 2\n        if array[mid] == target:\n            result = mid  # Found a potential first occurrence\n            high = mid - 1 # Continue searching in the left half for an earlier occurrence\n        elif array[mid] < target:\n            low = mid + 1\n        else: # array[mid] > target\n            high = mid - 1\n\n    return result"}
{"task_id": "Mbpp/734", "solution": "def sum_Of_Subarray_Prod(lst: list[int]) -> int:\n    \"\"\"Calculates the sum of products of all possible contiguous sublists of the given list.\n    Returns 0 for an empty list.\"\"\"\n    total_sum = 0\n    n = len(lst)\n\n    for i in range(n):\n        current_product = 1\n        for j in range(i, n):\n            current_product *= lst[j]\n            total_sum += current_product\n            \n    return total_sum"}
{"task_id": "Mbpp/735", "solution": "def toggle_middle_bits(value: int) -> int:\n    \"\"\"Toggles all bits of the number except the first (MSB) and the last (LSB) bit.\"\"\"\n    if value == 0 or value == 1:\n        return value\n\n    # Find the position of the MSB\n    msb_pos = value.bit_length() - 1\n    \n    # Create a mask that covers all bits from MSB to LSB (inclusive)\n    # e.g., for 9 (1001), msb_pos=3. (1 << 4) - 1 = 1111b\n    full_mask = (1 << (msb_pos + 1)) - 1\n    \n    # Create a mask to preserve the MSB\n    msb_mask = 1 << msb_pos\n    \n    # Create a mask to preserve the LSB\n    lsb_mask = 1\n    \n    # The middle_bits_mask needs to flip bits between MSB and LSB\n    # It should be 1s from (msb_pos - 1) down to 1\n    # For 9 (1001), msb_pos=3, lsb_pos=0. We want to toggle bits at position 1 and 2.\n    # The mask should be 0110b.\n    \n    # Start with a mask of all ones for the relevant length.\n    # Remove the MSB and LSB from this full mask.\n    middle_bits_mask = full_mask ^ msb_mask ^ lsb_mask\n    \n    # XOR the original value with the middle_bits_mask to toggle only those bits.\n    return value ^ middle_bits_mask"}
{"task_id": "Mbpp/736", "solution": "def left_insertion(sorted_list, value):\n    \"\"\"\n    Locates the left insertion point for a specified value in a sorted list using binary search.\n    \"\"\"\n    low = 0\n    high = len(sorted_list)\n\n    while low < high:\n        mid = (low + high) // 2\n        if sorted_list[mid] < value:\n            low = mid + 1\n        else:\n            high = mid\n    return low"}
{"task_id": "Mbpp/737", "solution": "import re\nVOWEL_PATTERN = re.compile(r\"^[aeiou]\", re.IGNORECASE)\ndef check_str(s):\n    \"\"\"Checks if the given string starts with a vowel using regex.\"\"\"\n    trimmed_s = s.lstrip()\n    if not trimmed_s:\n        return False\n    return bool(VOWEL_PATTERN.match(trimmed_s))"}
{"task_id": "Mbpp/739", "solution": "import math\ndef _triangular_value(k: int) -> int:\n    \"\"\"Return the k-th triangular number.\"\"\"\n    return k * (k + 1) // 2\ndef _digit_count(num: int) -> int:\n    \"\"\"Return the number of decimal digits of num.\"\"\"\n    return math.floor(math.log10(num)) + 1\ndef find_Index(n: int) -> int:\n    \"\"\"\n    Return the smallest index k such that the k-th triangular number\n    has exactly n decimal digits.\n    \"\"\"\n    low, high = 1, 1\n    # Expand high until T_high has at least n digits\n    while _digit_count(_triangular_value(high)) < n:\n        high *= 2\n\n    # Binary search between low and high to find the first k with at least n digits\n    while low < high:\n        mid = (low + high) // 2\n        if _digit_count(_triangular_value(mid)) < n:\n            low = mid + 1\n        else:\n            high = mid\n\n    return low"}
{"task_id": "Mbpp/740", "solution": "def tuple_to_dict(t: tuple) -> dict:\n    \"\"\"\n    Convert a tuple into a dictionary by pairing adjacent elements.\n    Duplicate keys are overwritten by the last occurrence.\n    \"\"\"\n    if len(t) % 2 != 0:\n        raise ValueError(\"Tuple length must be even to form key-value pairs.\")\n\n    result = {}\n    for i in range(0, len(t), 2):\n        key = t[i]\n        value = t[i + 1]\n        result[key] = value\n\n    return result"}
{"task_id": "Mbpp/741", "solution": "def all_Characters_Same(input: str) -> bool:\n    \"\"\"\n    Return True if all characters in 'input' are the same, else False.\n    Handles empty and single-character strings by returning True.\n    \"\"\"\n    if len(input) <= 1:\n        return True\n    first_char = input[0]\n    for char in input[1:]:\n        if char != first_char:\n            return False\n    return True"}
{"task_id": "Mbpp/742", "solution": "import math\ndef area_tetrahedron(sideLength):\n    \"\"\"\n    Calculates the surface area of a regular tetrahedron given its side length.\n    Raises TypeError if sideLength is not numeric, ValueError if sideLength is not positive.\n    \"\"\"\n    if not isinstance(sideLength, (int, float)):\n        raise TypeError(\"sideLength must be a numeric value.\")\n    if sideLength <= 0:\n        raise ValueError(\"sideLength must be a positive number.\")\n\n    # Surface area formula for a regular tetrahedron: sqrt(3) * sideLength^2\n    area = math.sqrt(3) * (sideLength ** 2)\n    return area"}
