{"task_id": "Mbpp/296", "solution": "def get_Inv_Count(arr: List[int]) -> int:\n    \"\"\"\n    Count the number of inversions in an integer array using a modified merge-sort.\n    An inversion is a pair (i, j) such that i < j and arr[i] > arr[j].\n    \"\"\"\n    if not arr:\n        return 0\n\n    def merge_sort(nums: List[int]) -> (List[int], int):\n        \"\"\"Recursively sorts and counts inversions.\"\"\"\n        n = len(nums)\n        if n <= 1:\n            return nums, 0\n        mid = n // 2\n        left, inv_left = merge_sort(nums[:mid])\n        right, inv_right = merge_sort(nums[mid:])\n        merged, inv_split = merge(left, right)\n        return merged, inv_left + inv_right + inv_split\n\n    def merge(left: List[int], right: List[int]) -> (List[int], int):\n        \"\"\"Merges two sorted arrays and counts split inversions.\"\"\"\n        merged = []\n        i = j = inv_count = 0\n        while i < len(left) and j < len(right):\n            if left[i] <= right[j]:\n                merged.append(left[i])\n                i += 1\n            else:\n                merged.append(right[j])\n                inv_count += len(left) - i\n                j += 1\n        merged.extend(left[i:])\n        merged.extend(right[j:])\n        return merged, inv_count\n\n    _, total_inversions = merge_sort(arr)\n    return total_inversions"}
{"task_id": "Mbpp/297", "solution": "def flatten_list(lst: List[Any]) -> List[Any]:\n    \"\"\"\n    Flattens a given nested list structure.\n    \"\"\"\n    result: List[Any] = []\n    stack: List[Any] = [lst]\n    while stack:\n        current = stack.pop()\n        if isinstance(current, list):\n            stack.extend(reversed(current))\n        else:\n            result.append(current)\n    return result"}
{"task_id": "Mbpp/299", "solution": "def max_aggregate(data):\n    \"\"\"\n    Calculates the maximum aggregate score from a list of (name, score) tuples.\n    It sums scores for duplicate names and returns the name with the highest total.\n    \"\"\"\n    aggregates = {}\n    for name, score in data:\n        aggregates[name] = aggregates.get(name, 0) + score\n\n    max_name, max_score = max(aggregates.items(), key=lambda item: item[1])\n\n    return (max_name, max_score)"}
{"task_id": "Mbpp/300", "solution": "import math\ndef count_binary_seq(n: int) -> int:\n    \"\"\"\n    Calculates the count of binary sequences of length 2n where the sum of the first n bits\n    is the same as the sum of the last n bits.\n    \"\"\"\n    total_count = 0\n    for k in range(n + 1):\n        # Number of ways to choose k ones in n bits for the first half\n        ways_first_half = math.comb(n, k)\n        # Number of ways to choose k ones in n bits for the second half\n        ways_second_half = math.comb(n, k)\n        total_count += ways_first_half * ways_second_half\n    return total_count"}
{"task_id": "Mbpp/301", "solution": "def dict_depth(d):\n    \"\"\"\n    Calculates the maximum depth of a nested dictionary.\n    The depth is 1 for a dictionary with no nested dictionaries.\n    \"\"\"\n    if not isinstance(d, dict):\n        return 0 # Or handle non-dict as depth 0, or raise error. For this problem, assume input is a dict.\n\n    max_depth = 1\n    for value in d.values():\n        if isinstance(value, dict):\n            max_depth = max(max_depth, 1 + dict_depth(value))\n    return max_depth"}
{"task_id": "Mbpp/305", "solution": "def start_withp(word_list: list[str]) -> tuple[str, str]:\n    \"\"\"\n    Returns the first two words from a list of strings that start with 'p' (case-insensitive).\n    Raises ValueError if fewer than two such words are found.\n    \"\"\"\n    found_p_words = []\n    for s in word_list:\n        words = s.split()\n        for word in words:\n            if word.lower().startswith('p'):\n                found_p_words.append(word)\n                if len(found_p_words) == 2:\n                    return (found_p_words[0], found_p_words[1])\n    \n    raise ValueError(\"Fewer than two words starting with 'p' were found.\")"}
{"task_id": "Mbpp/306", "solution": "def max_sum_increasing_subseq(arr, n, i, k):\n    \"\"\"\n    Finds the maximum sum of an increasing subsequence that includes elements\n    from the prefix until the i-th index (1-based) and the k-th element (1-based).\n    \"\"\"\n    # Convert 1-based indices to 0-based\n    i0 = i - 1\n    k0 = k - 1\n\n    # Extract relevant elements (from prefix arr[0...i0] and the k-th element arr[k0])\n    # and maintain their original indices for sorting\n    combined_elements_with_indices = []\n    \n    # Add prefix elements\n    for idx in range(i0 + 1):\n        combined_elements_with_indices.append((arr[idx], idx))\n    \n    # Add the k-th element. Since k > i, k0 will not be a duplicate index from the prefix.\n    combined_elements_with_indices.append((arr[k0], k0))\n\n    # Sort by original index to preserve the relative order of elements as they appear in the array\n    combined_elements_with_indices.sort(key=lambda x: x[1])\n\n    # Extract just the values for DP calculations\n    temp_arr_values = [item[0] for item in combined_elements_with_indices]\n    target_val = arr[k0] # The value of the k-th element\n    \n    # Find the index of the k-th element's value within the new temp_arr_values list\n    target_idx_in_temp_arr = -1\n    for idx, (val, original_idx) in enumerate(combined_elements_with_indices):\n        if original_idx == k0:\n            target_idx_in_temp_arr = idx\n            break\n\n    n_temp = len(temp_arr_values)\n    if n_temp == 0:\n        return 0\n\n    # dp_ending[j] stores the maximum increasing subsequence sum ending at temp_arr_values[j]\n    dp_ending = [temp_arr_values[x] for x in range(n_temp)]\n    for j in range(n_temp):\n        for p in range(j):\n            if temp_arr_values[p] < temp_arr_values[j]:\n                dp_ending[j] = max(dp_ending[j], dp_ending[p] + temp_arr_values[j])\n\n    # dp_starting[j] stores the maximum increasing subsequence sum starting at temp_arr_values[j]\n    dp_starting = [temp_arr_values[x] for x in range(n_temp)]\n    for j in range(n_temp - 1, -1, -1):\n        for p in range(j + 1, n_temp):\n            if temp_arr_values[p] > temp_arr_values[j]:\n                dp_starting[j] = max(dp_starting[j], dp_starting[p] + temp_arr_values[j])\n\n    max_overall_sum = 0\n\n    # The subsequence must include target_val.\n    # The total sum can be formed by:\n    # 1. Just target_val itself.\n    # 2. An IS ending at target_val (using elements before it in temp_arr_values). This is dp_ending[target_idx_in_temp_arr].\n    # 3. An IS starting at target_val (using elements after it in temp_arr_values). This is dp_starting[target_idx_in_temp_arr].\n    # 4. An IS consisting of a part ending before target_val, target_val itself, and a part starting after target_val.\n\n    max_overall_sum = target_val # Case 1: Subsequence is just the target_val\n\n    # Update max_overall_sum with cases 2 and 3\n    max_overall_sum = max(max_overall_sum, dp_ending[target_idx_in_temp_arr])\n    max_overall_sum = max(max_overall_sum, dp_starting[target_idx_in_temp_arr])\n\n    # Case 4: Combine a subsequence ending before target_val with one starting after it\n    for j in range(target_idx_in_temp_arr): # `j` is an index for an element before target_val\n        if temp_arr_values[j] < target_val:\n            for p in range(target_idx_in_temp_arr + 1, n_temp): # `p` is an index for an element after target_val\n                if temp_arr_values[p] > target_val:\n                    # Combined sum = (IS ending at temp_arr_values[j]) + target_val + (IS starting at temp_arr_values[p] - temp_arr_values[p])\n                    # We subtract temp_arr_values[p] from dp_starting[p] to avoid double counting\n                    current_combined_sum = dp_ending[j] + target_val + (dp_starting[p] - temp_arr_values[p])\n                    max_overall_sum = max(max_overall_sum, current_combined_sum)\n\n    return max_overall_sum"}
