{"task_id": "Mbpp/131", "solution": "def reverse_vowels(s: str) -> str:\n    \"\"\"\n    Reverses only the vowels of a given string (where y is not a vowel).\n    \"\"\"\n    VOWELS = {'a', 'e', 'i', 'o', 'u', 'A', 'E', 'I', 'O', 'U'}\n\n    found_vowels = [char for char in s if char in VOWELS]\n    reversed_vowels_iter = iter(found_vowels[::-1])\n\n    result_chars = []\n    for char in s:\n        if char in VOWELS:\n            result_chars.append(next(reversed_vowels_iter))\n        else:\n            result_chars.append(char)\n\n    return \"\".join(result_chars)"}
