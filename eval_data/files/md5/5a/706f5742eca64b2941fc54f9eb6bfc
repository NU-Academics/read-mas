{"task_id": "Mbpp/68", "solution": "from typing import List\ndef is_Monotonic(arr: List[int]) -> bool:\n    \"\"\"\n    Checks if the given array is monotonic (either non-decreasing or non-increasing).\n    An empty or single-element array is considered monotonic.\n    \"\"\"\n    n = len(arr)\n    if n <= 1:\n        return True\n\n    is_increasing = True\n    is_decreasing = True\n\n    for i in range(n - 1):\n        if arr[i] > arr[i+1]:\n            is_increasing = False\n        if arr[i] < arr[i+1]:\n            is_decreasing = False\n\n    return is_increasing or is_decreasing"}
{"task_id": "Mbpp/67", "solution": "import collections\nimport sqlite3\nclass BellNumberError(Exception):\n    \"\"\"Custom exception for invalid Bell number input.\"\"\"\n    pass\n_bell_cache = collections.OrderedDict()\n_MAX_CACHE_SIZE = 100\n_conn = None\ndef _db_get(n):\n    \"\"\"Retrieves a Bell number from the database by n.\"\"\"\n    _init_db()\n    cursor = _conn.cursor()\n    cursor.execute('SELECT value FROM bell_numbers WHERE n = ?', (n,))\n    result = cursor.fetchone()\n    return result[0] if result else None\ndef bell_number(n):\n    \"\"\"\n    Computes the nth Bell number using dynamic programming, with caching and persistence.\n    Raises BellNumberError for invalid input (non-negative integer required).\n    \"\"\"\n    if not isinstance(n, int) or n < 0:\n        raise BellNumberError(\"Invalid input: n must be a non-negative integer.\")\n\n    if n in _bell_cache:\n        _bell_cache.move_to_end(n)\n        return _bell_cache[n]\n\n    db_value = _db_get(n)\n    if db_value is not None:\n        if len(_bell_cache) >= _MAX_CACHE_SIZE:\n            _bell_cache.popitem(last=False)\n        _bell_cache[n] = db_value\n        return db_value\n\n    # Compute using Bell triangle dynamic programming.\n    bell_triangle = [[0] * (n + 1) for _ in range(n + 1)]\n    bell_triangle[0][0] = 1\n\n    for i in range(1, n + 1):\n        bell_triangle[i][0] = bell_triangle[i-1][i-1]\n        for j in range(1, i + 1):\n            bell_triangle[i][j] = bell_triangle[i][j-1] + bell_triangle[i-1][j-1]\n\n    computed_value = bell_triangle[n][0]\n\n    if len(_bell_cache) >= _MAX_CACHE_SIZE:\n        _bell_cache.popitem(last=False)\n    _bell_cache[n] = computed_value\n\n    _db_insert(n, computed_value)\n\n    return computed_value"}
{"task_id": "Mbpp/70", "solution": "from typing import List, Tuple\nclass TupleSet:\n    \"\"\"\n    Domain entity representing a collection of tuples.\n    \"\"\"\n\n    def __init__(self, tuples: List[Tuple]):\n        self.tuples = tuples\n\n    def hasEqualLength(self) -> bool:\n        \"\"\"\n        Check whether all tuples in the collection have the same length.\n        \"\"\"\n        if not self.tuples:\n            return True\n        first_length = len(self.tuples[0])\n        return all(len(t) == first_length for t in self.tuples)\ndef get_equal(tuples: List[Tuple]) -> bool:\n    \"\"\"\n    Determine if all tuples in the input list have equal length.\n    \"\"\"\n    return TupleSet(tuples).hasEqualLength()"}
{"task_id": "Mbpp/69", "solution": "def is_sublist(lst, sub):\n    \"\"\"\n    Determine whether `sub` appears in `lst` in the same order with exact matches.\n    An empty sublist is considered present.\n    \"\"\"\n    if not sub:\n        return True\n\n    sub_len = len(sub)\n    for i in range(len(lst) - sub_len + 1):\n        if lst[i:i + sub_len] == sub:\n            return True\n    return False"}
{"task_id": "Mbpp/71", "solution": "def comb_sort(list_of_elements):\n    \"\"\"\n    Sorts a list of elements using the comb sort algorithm.\n    Returns a new sorted list without modifying the original.\n    \"\"\"\n    arr = list(list_of_elements)  # Create a mutable copy to avoid modifying the original list\n    n = len(arr)\n\n    gap = n\n    shrink_factor = 1.3\n    swapped = True\n\n    while gap > 1 or swapped:\n        # Calculate the new gap value\n        gap = int(gap / shrink_factor)\n        if gap < 1:\n            gap = 1\n\n        swapped = False\n\n        # Perform a modified bubble sort pass with the current gap\n        for i in range(n - gap):\n            if arr[i] > arr[i + gap]:\n                arr[i], arr[i + gap] = arr[i + gap], arr[i]\n                swapped = True\n    return arr"}
