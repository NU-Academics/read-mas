{"task_id": "Mbpp/162", "solution": "def sum_series(n: int) -> int:\n    \"\"\"\n    Calculates the sum of the series (n - 2*i) for i from 0 to n // 2.\n    For example, for n=6, the series is 6 + 4 + 2 + 0, summing to 12.\n    \"\"\"\n    total_sum = 0\n    # Iterate from i=0 up to and including n // 2\n    for i in range((n // 2) + 1):\n        total_sum += (n - 2 * i)\n    return total_sum"}
{"task_id": "Mbpp/165", "solution": "def count_char_position(input_str: str) -> int:\n    \"\"\"\n    Counts characters in `input_str` that occupy the same 1\u2011indexed position\n    as their corresponding letter in the English alphabet.\n    \"\"\"\n    alphabet_pos = {chr(ord('a') + i): i + 1 for i in range(26)}\n    count = 0\n    for idx, ch in enumerate(input_str.lower()):\n        pos = alphabet_pos.get(ch)\n        if pos and pos == idx + 1:\n            count += 1\n    return count"}
{"task_id": "Mbpp/166", "solution": "from typing import List\nclass ListWrapper:\n    \"\"\"Wraps a list of integers.\"\"\"\n    def __init__(self, elements: List[int]):\n        self.elements = elements\nclass Pair:\n    \"\"\"Represents a pair of integers.\"\"\"\n    def __init__(self, first: int, second: int):\n        self.first = first\n        self.second = second\nclass XOROperation:\n    \"\"\"Performs XOR computation.\"\"\"\n    def compute(self, a: int, b: int) -> int:\n        \"\"\"Computes the bitwise XOR of two integers.\"\"\"\n        return a ^ b\ndef find_even_pair(elements: List[int]) -> int:\n    \"\"\"Count unordered pairs with even XOR.\"\"\"\n    lst = ListWrapper(elements)\n    count = 0\n    xor_op = XOROperation()\n    n = len(lst.elements)\n    for i in range(n):\n        for j in range(i + 1, n):\n            pair = Pair(lst.elements[i], lst.elements[j])\n            xor_val = xor_op.compute(pair.first, pair.second)\n            if xor_val % 2 == 0:\n                count += 1\n    return count"}
