{"task_id": "HumanEval/7", "solution": "def filter_by_substring(strings: List[str], substring: str) -> List[str]:\n    \"\"\" Filter an input list of strings only for ones that contain given substring\n    >>> filter_by_substring([], 'a')\n    []\n    >>> filter_by_substring(['abc', 'bacd', 'cde', 'array'], 'a')\n    ['abc', 'bacd', 'array']\n    \"\"\"\n    if not strings:\n        return []\n\n    filtered_list: List[str] = []\n    for s in strings:\n        if substring in s:\n            filtered_list.append(s)\n\n    return filtered_list"}
{"task_id": "HumanEval/4", "solution": "def mean_absolute_deviation(numbers: List[float]) -> float:\n    \"\"\" For a given list of input numbers, calculate Mean Absolute Deviation\n    around the mean of this dataset.\n    \"\"\"\n    data_mean = sum(numbers) / len(numbers)\n    absolute_differences = [abs(x - data_mean) for x in numbers]\n    mad = sum(absolute_differences) / len(absolute_differences)\n    return mad"}
{"task_id": "HumanEval/3", "solution": "def below_zero(operations: List[int]) -> bool:\n    \"\"\"Detects if a bank account balance, starting at zero, ever falls below zero after a series of operations.\n    Returns True if the balance drops below zero at any point, False otherwise.\n    \"\"\"\n    balance = 0\n    has_fallen_below_zero = False\n    for operation in operations:\n        balance += operation\n        if balance < 0:\n            has_fallen_below_zero = True\n    return has_fallen_below_zero"}
{"task_id": "HumanEval/6", "solution": "def parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\" Input to this function is a string represented multiple groups for nested parentheses separated by spaces.\n    For each of the group, output the deepest level of nesting of parentheses.\n    E.g. (()()) has maximum two levels of nesting while ((())) has three.\n\n    >>> parse_nested_parens('(()()) ((())) () ((())()())')\n    [2, 3, 1, 3]\n    \"\"\"\n    def _calculate_group_nesting(group_string: str) -> int:\n        \"\"\"Calculates the deepest nesting level for a single group of parentheses.\"\"\"\n        current_nesting = 0\n        max_nesting = 0\n        for char in group_string:\n            if char == '(':\n                current_nesting += 1\n                max_nesting = max(max_nesting, current_nesting)\n            elif char == ')':\n                current_nesting -= 1\n        return max_nesting\n\n    groups = paren_string.split(' ')\n    results = []\n    for group in groups:\n        if group:\n            results.append(_calculate_group_nesting(group))\n    return results"}
{"task_id": "HumanEval/0", "solution": "def has_close_elements(numbers: List[float], threshold: float) -> bool:\n    \"\"\" Check if in given list of numbers, are any two numbers closer to each other than\n    given threshold.\n    >>> has_close_elements([1.0, 2.0, 3.0], 0.5)\n    False\n    >>> has_close_elements([1.0, 2.8, 3.0, 4.0, 5.0, 2.0], 0.3)\n    True\n    \"\"\"\n    n = len(numbers)\n    for i in range(n):\n        for j in range(i + 1, n):  # Compare each element with distinct subsequent elements\n            if abs(numbers[i] - numbers[j]) < threshold:\n                return True\n    return False"}
{"task_id": "HumanEval/1", "solution": "def separate_paren_groups(paren_string: str) -> List[str]:\n    \"\"\" Input to this function is a string containing multiple groups of nested parentheses. Your goal is to\n    separate those group into separate strings and return the list of those.\n    Separate groups are balanced (each open brace is properly closed) and not nested within each other\n    Ignore any spaces in the input string.\n    >>> separate_paren_groups('( ) (( )) (( )( ))')\n    ['()', '(())', '(()())']\n    \"\"\"\n    class ParenthesisGroup:\n        \"\"\"\n        Represents a single, distinct, and balanced parenthesis group.\n        Provides a method to validate its balance.\n        \"\"\"\n        def __init__(self, group_content: str):\n            self.content = group_content\n\n        def isBalanced(self) -> bool:\n            \"\"\"Checks if the group's content has properly matched and nested parentheses.\"\"\"\n            balance = 0\n            for char in self.content:\n                if char == '(':\n                    balance += 1\n                elif char == ')':\n                    balance -= 1\n                if balance < 0:\n                    return False\n            return balance == 0\n\n    class ParenthesisString:\n        \"\"\"\n        Manages the lifecycle of the input string from raw to processed,\n        and orchestrates group separation.\n        \"\"\"\n        def __init__(self, raw_string: str):\n            self.raw_input = raw_string\n            self.processed_input = raw_string.replace(' ', '')\n            self.separated_groups: List[ParenthesisGroup] = []\n\n        def process_and_separate(self) -> None:\n            \"\"\"\n            Iterates through processed_input to identify top-level, non-nested,\n            and balanced parenthesis groups, populating separated_groups.\n            \"\"\"\n            balance = 0\n            start_index = -1\n\n            for i, char in enumerate(self.processed_input):\n                if char == '(':\n                    if balance == 0:\n                        start_index = i\n                    balance += 1\n                elif char == ')':\n                    balance -= 1\n                \n                if balance == 0 and start_index != -1:\n                    group_content = self.processed_input[start_index : i + 1]\n                    group = ParenthesisGroup(group_content)\n                    # The design includes an explicit balance check here.\n                    if group.isBalanced():\n                        self.separated_groups.append(group)\n                    start_index = -1\n\n    paren_obj = ParenthesisString(paren_string)\n    paren_obj.process_and_separate()\n    \n    return [group.content for group in paren_obj.separated_groups]"}
{"task_id": "HumanEval/5", "solution": "def intersperse(numbers: List[int], delimeter: int) -> List[int]:\n    \"\"\" Insert a number 'delimeter' between every two consecutive elements of input list `numbers'\n    >>> intersperse([], 4)\n    []\n    >>> intersperse([1, 2, 3], 4)\n    [1, 4, 2, 4, 3]\n    \"\"\"\n    if not numbers:\n        return []\n\n    result = []\n    for i, num in enumerate(numbers):\n        result.append(num)\n        if i < len(numbers) - 1:\n            result.append(delimeter)\n    return result"}
{"task_id": "HumanEval/2", "solution": "def truncate_number(number: float) -> float:\n    \"\"\" Given a positive floating point number, it can be decomposed into\n    and integer part (largest integer smaller than given number) and decimals\n    (leftover part always smaller than 1).\n\n    Return the decimal part of the number.\n    >>> truncate_number(3.5)\n    0.5\n    \"\"\"\n    integer_part = int(number)\n    decimal_part = number - integer_part\n    return decimal_part"}
{"task_id": "HumanEval/8", "solution": "def sum_product(numbers: List[int]) -> Tuple[int, int]:\n    \"\"\" For a given list of integers, return a tuple consisting of a sum and a product of all the integers in a list.\n    Empty sum should be equal to 0 and empty product should be equal to 1.\n    >>> sum_product([])\n    (0, 1)\n    >>> sum_product([1, 2, 3, 4])\n    (10, 24)\n    \"\"\"\n    current_sum = 0\n    current_product = 1\n\n    if not numbers:\n        return (current_sum, current_product)\n\n    for number in numbers:\n        current_sum += number\n        current_product *= number\n\n    return (current_sum, current_product)"}
{"task_id": "HumanEval/13", "solution": "def greatest_common_divisor(a: int, b: int) -> int:\n    \"\"\" Return a greatest common divisor of two integers a and b\n    >>> greatest_common_divisor(3, 5)\n    1\n    >>> greatest_common_divisor(25, 15)\n    5\n    \"\"\"\n    while b:\n        a, b = b, a % b\n    return a"}
{"task_id": "HumanEval/15", "solution": "def string_sequence(n: int) -> str:\n    \"\"\" Return a string containing space-delimited numbers starting from 0 upto n inclusive.\n    The numbers are generated and then joined into a single string.\n    \"\"\"\n    numbers_as_strings = [str(i) for i in range(n + 1)]\n    return ' '.join(numbers_as_strings)"}
{"task_id": "HumanEval/9", "solution": "def rolling_max(numbers: List[int]) -> List[int]:\n    \"\"\" From a given list of integers, generate a list of rolling maximum element found until given moment\n    in the sequence.\n    >>> rolling_max([1, 2, 3, 2, 3, 4, 2])\n    [1, 2, 3, 3, 3, 4, 4]\n    \"\"\"\n    if not numbers:\n        return []\n\n    result = []\n    current_max = float('-inf')  # Initialize with negative infinity to correctly handle any integer input.\n\n    for num in numbers:\n        current_max = max(current_max, num)\n        result.append(current_max)\n    return result"}
{"task_id": "HumanEval/12", "solution": "def longest(strings: List[str]) -> Optional[str]:\n    \"\"\" Out of list of strings, return the longest one. Return the first one in case of multiple\n    strings of the same length. Return None in case the input list is empty.\n    \"\"\"\n    if not strings:\n        return None\n\n    current_longest_string = strings[0]\n    current_max_length = len(strings[0])\n\n    for s in strings[1:]:\n        if len(s) > current_max_length:\n            current_max_length = len(s)\n            current_longest_string = s\n\n    return current_longest_string"}
{"task_id": "HumanEval/11", "solution": "from typing import List\ndef string_xor(a: str, b: str) -> str:\n    \"\"\" Input are two strings a and b consisting only of 1s and 0s.\n    Perform binary XOR on these inputs and return result also as a string.\n    >>> string_xor('010', '110')\n    '100'\n    \"\"\"\n\n    def _validate_binary_string(s: str) -> None:\n        \"\"\"Checks if a string consists only of '0's and '1's.\"\"\"\n        for char in s:\n            if char not in ('0', '1'):\n                raise ValueError(\"Input strings must contain only '0's and '1's.\")\n\n    _validate_binary_string(a)\n    _validate_binary_string(b)\n\n    if len(a) != len(b):\n        raise ValueError(\"Input strings must be of equal length.\")\n\n    result_list = []\n    for i in range(len(a)):\n        if a[i] != b[i]:\n            result_list.append('1')\n        else:\n            result_list.append('0')\n\n    return \"\".join(result_list)"}
{"task_id": "HumanEval/10", "solution": "def make_palindrome(string: str) -> str:\n    \"\"\" Find the shortest palindrome that begins with a supplied string.\n    Algorithm idea is simple:\n    - Find the longest postfix of supplied string that is a palindrome.\n    - Append to the end of the string reverse of a string prefix that comes before the palindromic suffix.\n    >>> make_palindrome('')\n    ''\n    >>> make_palindrome('cat')\n    'catac'\n    >>> make_palindrome('cata')\n    'catac'\n    \"\"\"\n    if not string:\n        return \"\"\n\n    longest_palindromic_postfix_len = 0\n    for i in range(len(string)):\n        suffix = string[i:]\n        if is_palindrome(suffix):\n            longest_palindromic_postfix_len = len(suffix)\n            break\n\n    prefix_to_reverse = string[:-longest_palindromic_postfix_len]\n    return string + prefix_to_reverse[::-1]"}
{"task_id": "HumanEval/14", "solution": "def all_prefixes(string: str) -> List[str]:\n    \"\"\" Return list of all prefixes from shortest to longest of the input string \"\"\"\n    prefixes = []\n    for i in range(len(string)):\n        prefixes.append(string[:i+1])\n    return prefixes"}
