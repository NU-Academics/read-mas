{"task_id": "HumanEval/40", "solution": "def triples_sum_to_zero(l: list):\n    \"\"\"\n    triples_sum_to_zero takes a list of integers as an input.\n    it returns True if there are three distinct elements in the list that\n    sum to zero, and False otherwise.\n    \"\"\"\n    n = len(l)\n    if n < 3:\n        return False\n\n    # Iterate through all combinations of three distinct elements\n    for i in range(n - 2):\n        for j in range(i + 1, n - 1):\n            for k in range(j + 1, n):\n                if l[i] + l[j] + l[k] == 0:\n                    return True\n    return False"}
{"task_id": "HumanEval/43", "solution": "def pairs_sum_to_zero(l):\n    \"\"\"\n    pairs_sum_to_zero takes a list of integers as an input.\n    it returns True if there are two distinct elements in the list that\n    sum to zero, and False otherwise.\n    >>> pairs_sum_to_zero([1, 3, 5, 0])\n    False\n    >>> pairs_sum_to_zero([1, 3, -2, 1])\n    False\n    >>> pairs_sum_to_zero([1, 2, 3, 7])\n    False\n    >>> pairs_sum_to_zero([2, 4, -5, 3, 5, 7])\n    True\n    >>> pairs_sum_to_zero([1])\n    False\n    \"\"\"\n    seen_elements = set()\n    for num in l:\n        complement = -num\n        if complement in seen_elements:\n            return True\n        seen_elements.add(num)\n    return False"}
{"task_id": "HumanEval/45", "solution": "def triangle_area(a, h):\n    \"\"\"Given length of a side and high return area for a triangle.\n    >>> triangle_area(5, 3)\n    7.5\n    \"\"\"\n    # Calculate the area using the standard formula for a triangle.\n    # 'a' represents the base and 'h' represents the height.\n    return (a * h) / 2"}
{"task_id": "HumanEval/44", "solution": "def change_base(x: int, base: int):\n    \"\"\"Change numerical base of input number x to base.\n    return string representation after the conversion.\n    base numbers are less than 10.\n    >>> change_base(8, 3)\n    '22'\n    >>> change_base(8, 2)\n    '1000'\n    >>> change_base(7, 2)\n    '111'\n    \"\"\"\n    if x == 0:\n        return '0'\n\n    res = []\n    current_x = x\n    while current_x > 0:\n        remainder = current_x % base\n        res.append(str(remainder))\n        current_x //= base\n\n    return ''.join(res[::-1])"}
{"task_id": "HumanEval/46", "solution": "def fib4(n: int):\n    \"\"\"Computes the n-th element of the Fib4 number sequence efficiently without recursion.\n    The sequence is defined by fib4(0)=0, fib4(1)=0, fib4(2)=2, fib4(3)=0, and fib4(n) = fib4(n-1) + fib4(n-2) + fib4(n-3) + fib4(n-4) for n > 3.\n    \"\"\"\n    if n == 0:\n        return 0\n    elif n == 1:\n        return 0\n    elif n == 2:\n        return 2\n    elif n == 3:\n        return 0\n\n    # Initialize variables for fib4(i-4), fib4(i-3), fib4(i-2), fib4(i-1)\n    # These correspond to fib4(0), fib4(1), fib4(2), fib4(3) respectively, when i=4\n    a = 0  # Represents fib4(k-4)\n    b = 0  # Represents fib4(k-3)\n    c = 2  # Represents fib4(k-2)\n    d = 0  # Represents fib4(k-1)\n\n    for _ in range(4, n + 1):\n        next_fib = a + b + c + d\n        a = b\n        b = c\n        c = d\n        d = next_fib\n    \n    return d"}
{"task_id": "HumanEval/48", "solution": "def is_palindrome(text: str):\n    \"\"\"\n    Checks if given string is a palindrome\n    >>> is_palindrome('')\n    True\n    >>> is_palindrome('aba')\n    True\n    >>> is_palindrome('aaaaa')\n    True\n    >>> is_palindrome('zbcd')\n    False\n    \"\"\"\n    return text == text[::-1]"}
{"task_id": "HumanEval/49", "solution": "def modp(n: int, p: int):\n    \"\"\"Return 2^n modulo p (be aware of numerics).\n    This function implements binary exponentiation (exponentiation by squaring) to efficiently compute 2^n mod p.\n    It handles large exponents 'n' by reducing intermediate results modulo 'p'.\n    \"\"\"\n    if n == 0:\n        return 1 % p  # 2^0 = 1, so 1 mod p\n\n    result = 1\n    base = 2 % p  # The base is 2. Reduce it modulo p initially.\n\n    while n > 0:\n        # If n is odd, multiply result by base\n        if n % 2 == 1:\n            result = (result * base) % p\n        \n        # Square the base and reduce it modulo p\n        base = (base * base) % p\n        \n        # Divide n by 2 (integer division)\n        n //= 2\n        \n    return result"}
{"task_id": "HumanEval/47", "solution": "def median(l: list):\n    \"\"\"Return median of elements in the list l.\n    >>> median([3, 1, 2, 4, 5])\n    3\n    >>> median([-10, 4, 6, 1000, 10, 20])\n    15.0\n    \"\"\"\n    # Sort the list to determine the middle element(s).\n    sorted_l = sorted(l)\n    n = len(sorted_l)\n\n    if n % 2 == 1:\n        # If the list has an odd number of elements, the median is the middle element.\n        return sorted_l[n // 2]\n    else:\n        # If the list has an even number of elements, the median is the average of the two middle elements.\n        # The result of division will be a float.\n        mid1 = sorted_l[n // 2 - 1]\n        mid2 = sorted_l[n // 2]\n        return (mid1 + mid2) / 2"}
