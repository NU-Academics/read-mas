arr: List[int]) -> List[int]:\n        \"\"\"\n        Retains only integers between 1 and 9 inclusive from the input list.\n        \"\"\"\n        return [n for n in arr if isinstance(n, int) and 1 <= n <= 9]\n\n    def _sort_and_reverse(self, numbers: List[int]) -> List[int]:\n        \"\"\"\n        Sorts numbers in ascending order and then reverses them to descending.\n        \"\"\"\n        numbers.sort()\n        numbers.reverse()\n        return numbers\n\n    def _convert_to_words(self, numbers: List[int]) -> List[str]:\n        \"\"\"\n        Converts each integer in the list to its English word representation.\n        \"\"\"\n        return [DIGIT_WORDS[n] for n in numbers]\ndef by_length(arr: List[int]) -> List[str]:\n    \"\"\"\n    Given an array of integers, sort the integers that are between 1 and 9 inclusive,\n    reverse the resulting array, and then replace each digit by its corresponding name from\n    \"One\", \"Two\", \"Three\", \"Four\", \"Five\", \"Six\", \"Seven\", \"Eight\", \"Nine\".\n\n    For example:\n      arr = [2, 1, 1, 4, 5, 8, 2, 3]   \n            -> sort arr -> [1, 1, 2, 2, 3, 4, 5, 8] \n            -> reverse arr -> [8, 5, 4, 3, 2, 2, 1, 1]\n      return [\"Eight\", \"Five\", \"Four\", \"Three\", \"Two\", \"Two\", \"One\", \"One\"]\n    \n      If the array is empty, return an empty array:\n      arr = []\n      return []\n    \n      If the array has any strange number ignore it:\n      arr = [1, -1 , 55] \n            -> sort arr -> [-1, 1, 55]\n            -> reverse arr -> [55, 1, -1]\n      return = ['One']\n    \"\"\"\n    processor = NumberProcessorService()\n    return processor.process_numbers(arr)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/105", "solution": "class NumberWordMapper:\n    \"\"\"Maps integers from 1-9 to their English word representations.\"\"\"\n    def __init__(self):\n        self._NUMBER_WORDS = {\n            1: \"One\", 2: \"Two\", 3: \"Three\", 4: \"Four\", 5: \"Five\",\n            6: \"Six\", 7: \"Seven\", 8: \"Eight\", 9: \"Nine\"\n        }\n\n    def to_word(self, number: int) -> str:\n        \"\"\"Converts an integer to its word, or an empty string if not found.\"\"\"\n        return self._NUMBER_WORDS.get(number, \"\")\nclass NumberArrayProcessor:\n    \"\"\"Orchestrates array transformations: filtering, sorting, reversing, and word conversion.\"\"\"\n    def __init__(self, mapper: NumberWordMapper):\n        self._mapper = mapper\n\n    def process_array(self, arr: list[int]) -> list[str]:\n        \"\"\"Processes an array of integers into a reversed, word-converted list.\"\"\"\n        if not arr:\n            return []\n\n        filtered_sorted = self._filter_and_sort(arr)\n        if not filtered_sorted:\n            return []\n\n        reversed_arr = self._reverse_array(filtered_sorted)\n        words_arr = self._convert_to_words(reversed_arr)\n        return words_arr\n\n    def _filter_and_sort(self, arr: list[int]) -> list[int]:\n        \"\"\"Filters input to numbers 1-9 and sorts them ascending.\"\"\"\n        # This handles filtering for valid integers as per FR1 and BR1.\n        valid_numbers = [n for n in arr if isinstance(n, int) and 1 <= n <= 9]\n        return sorted(valid_numbers)\n\n    def _reverse_array(self, arr: list[int]) -> list[int]:\n        \"\"\"Reverses the order of elements in an array.\"\"\"\n        return arr[::-1]\n\n    def _convert_to_words(self, arr: list[int]) -> list[str]:\n        \"\"\"Converts each integer in the array to its word representation.\"\"\"\n        return [self._mapper.to_word(n) for n in arr]\ndef by_length(arr):\n    \"\"\"\n    Filters, sorts, reverses, and converts specific integers in an array to their word representations.\n    Only numbers between 1 and 9 inclusive are processed.\n    \"\"\"\n    mapper = NumberWordMapper()\n    processor = NumberArrayProcessor(mapper)\n    return processor.process_array(arr)",