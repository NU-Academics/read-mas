  else:  # Odd index\n            result.append(_sum_up_to_n(i))\n\n    return result", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/107": [{"task_id": "HumanEval/107", "solution": "class InvalidInputError(ValueError):\n    \"\"\"Custom exception for invalid input values.\"\"\"\n    pass\nclass PalindromeChecker:\n    \"\"\"Utility class to check if an integer is a palindrome.\"\"\"\n\n    def is_palindrome(self, num: int) -> bool:\n        \"\"\"\n        Checks if an integer is a palindrome by comparing its string representation with its reverse.\n        Negative numbers are not considered palindromes.\n        \"\"\"\n        if num < 0:\n            return False\n        return str(num) == str(num)[::-1]\nclass PalindromeCounter:\n    \"\"\"Counts even and odd integer palindromes within a specified range.\"\"\"\n\n    def __init__(self, checker: PalindromeChecker):\n        \"\"\"Initializes the counter with a palindrome checker.\"\"\"\n        self.checker = checker\n\n    def count_palindromes(self, n: int) -> tuple[int, int]:\n        \"\"\"\n        Counts even and odd palindromes from 1 to n, inclusive, validating n's range.\n        Raises InvalidInputError if n is not an integer or is out of the allowed range.\n        \"\"\"\n        if not isinstance(n, int) or not (1 <= n <= 1000):\n            raise InvalidInputError(\"Input 'n' must be an integer between 1 and 1000, inclusive.\")\n\n        even_count = 0\n        odd_count = 0\n\n        for i in range(1, n + 1):\n            if self.checker.is_palindrome(i):\n                if i % 2 == 0:\n                    even_count += 1\n                else:\n                    odd_count += 1\n        return (even_count, odd_count)\ndef even_odd_palindrome(n: int) -> tuple[int, int]:\n    \"\"\"\n    Given a positive integer n, return a tuple that has the number of even and odd\n    integer palindromes that fall within the range(1, n), inclusive.\