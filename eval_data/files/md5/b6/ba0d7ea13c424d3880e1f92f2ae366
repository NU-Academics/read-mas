 for an integer, preserving its sign.\n        For example: calculate_digit_sum(-123) == -6.\n        \"\"\"\n        if n == 0:\n            return 0\n\n        sign = -1 if n < 0 else 1\n        abs_n = abs(n)\n        digit_sum = 0\n        for digit_char in str(abs_n):\n            digit_sum += int(digit_char)\n\n        return sign * digit_sum\n\n    if not nums:\n        return []\n\n    # Create a list of (sum_of_digits, original_index, original_number) tuples.\n    # Python's Timsort (used by .sort()) stably sorts tuples lexicographically.\n    decorated_list = []\n    for i, num in enumerate(nums):\n        digit_sum = calculate_digit_sum(num)\n        decorated_list.append((digit_sum, i, num))\n\n    decorated_list.sort()\n\n    # Extract the original numbers from the sorted list.\n    sorted_nums = [item[2] for item in decorated_list]\n    return sorted_nums", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[[1, 11, -1, -11, -12]]], "plus_fail_tests": [[[-1000, -99, 0, 99, 1000]]]}], "HumanEval/146": [{"task_id": "HumanEval/146", "solution": "def _is_odd(digit: int) -> bool:\n    \"\"\"Checks if a single digit is odd.\n    Digits 1, 3, 5, 7, 9 are considered odd.\"\"\"\n    return digit % 2 != 0\ndef _get_first_digit(num: int) -> int:\n    \"\"\"Extracts the first digit of a number's absolute value.\n    Converts the absolute number to a string and takes the first character.\"\"\"\n    abs_num_str = str(abs(num))\n    return int(abs_num_str[0])\ndef _get_last_digit(num: int) -> int:\n    \"\"\"Extracts the last digit of a number's absolute value.\n    Converts the absolute number to a string and takes the last character.\"\"\"\n    abs_num_str = str(abs(num))\n    return int(abs_num_str[-1])\ndef specialFilter(nums: list[int]) -> int:\n    \"\"\"Counts numbers in an array that are greater than 10 and have both\n    first and last digits odd. Input validation ensures type safety.\"\"\"\n    if not isinstance(nums, list):\n        raise TypeError(\"Input must be a list.\")\n    \n    count = 0\n    for num in nums:\n        if not isinstance(num, int):\n            raise TypeError(\"All elements in the list must be integers.\")\n\n        if num > 10:\n            first_digit = _get_first_digit(num)\n            last_digit = _get_last_digit(num)\n            if _is_odd(first_digit) and _is_odd(last_digit):\n                count += 1\n    return count", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/146", "solution": "def specialFilter(nums):\n    \"\"\"\n    Filters a list of numbers, counting those greater than 10 with odd first and last digits.\n    Uses absolute value for digit extraction, but not for the \"greater than 10\" condition.\n    \"\"\"\n    count = 0\n\n    def _get_first_digit(number: int) -> int:\n        \"\"\"Extracts the first digit of an integer, considering its absolute value.\"\"\"\n        s = str(abs(number))\n        return int(s[0])\n\n    def _get_last_digit(number: int) -> int:\n        \"\"\"Extracts the last digit of an integer, considering its absolute value.\"\"\"\n        s = str(abs(number))\n        return int(s[-1])\n\n    def _is_odd(digit: int) -> bool:\n        \"\"\"Checks if a given digit is odd.\"\"\"\n        return digit % 2 != 0\n\n    for number in nums:\n        # Condition 1: Number must be strictly greater than 10.\n        if number <= 10:\n            continue\n\n        first_digit = _get_first_digit(number)\n        last_digit = _get_last_digit(number)\n\n        # Conditions 2 & 3: First and last digits must both be odd.\n        if _is_odd(first_digit) and _is_odd(last_digit):\n            count += 1\n\n    return count", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/147": [{"task_id": "HumanEval/147", "solution": "import math\ndef get_max_triples(n: int) -> int:\n    \"\"\"\n    Calculates the number of triples (a[i],