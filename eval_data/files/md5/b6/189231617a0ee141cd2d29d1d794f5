{"task_id": "HumanEval/139", "solution": "def special_factorial(n):\n    \"\"\"The Brazilian factorial is defined as:\n    brazilian_factorial(n) = n! * (n-1)! * (n-2)! * ... * 1!\n    where n > 0\n\n    For example:\n    >>> special_factorial(4)\n    288\n\n    The function will receive an integer as input and should return the special\n    factorial of this integer.\n    \"\"\"\n    special_fact_result = 1\n    current_factorial = 1\n    for i in range(1, n + 1):\n        # Calculate i! iteratively by multiplying the previous factorial (i-1)! by i\n        current_factorial *= i\n        # Multiply the special factorial result by the current factorial i!\n        special_fact_result *= current_factorial\n    return special_fact_result"}
{"task_id": "HumanEval/140", "solution": "import re\ndef fix_spaces(text):\n    \"\"\"\n    Given a string text, replace all spaces in it with underscores, \n    and if a string has more than 2 consecutive spaces, \n    then replace all consecutive spaces with - \n    \"\"\"\n    # First, replace runs of 3 or more consecutive spaces with a single hyphen.\n    text = re.sub(r' {3,}', '-', text)\n    # Then, replace any remaining runs of 1 or 2 spaces with a single underscore.\n    text = re.sub(r' {1,2}', '_', text)\n    return text"}
{"task_id": "HumanEval/143", "solution": "def is_prime(n: int) -> bool:\n    \"\"\"\n    Checks if a given non-negative integer is a prime number.\n    Helper for words_in_sentence.\n    \"\"\"\n    if n < 2:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n    i = 3\n    while i * i <= n:\n        if n % i == 0:\n            return False\n        i += 2\n    return True\ndef words_in_sentence(sentence: str) -> str:\n    \"\"\"\n    Returns a string containing words from the original sentence\n    whose lengths are prime numbers, preserving order.\n    \"\"\"\n    words = sentence.split()\n    prime_length_words = []\n    for word in words:\n        if is_prime(len(word)):\n            prime_length_words.append(word)\n    return \" \".join(prime_length_words)"}
{"task_id": "HumanEval/142", "solution": "def sum_squares(lst):\n    \"\"\"\"\n    This function will take a list of integers. For all entries in the list, the function shall square the integer entry if its index is a \n    multiple of 3 and will cube the integer entry if its index is a multiple of 4 and not a multiple of 3. The function will not \n    change the entries in the list whose indexes are not a multiple of 3 or 4. The function shall then return the sum of all entries. \n    \n    Examples:\n    For lst = [1,2,3] the output should be 6\n    For lst = []  the output should be 0\n    For lst = [-1,-5,2,-1,-5]  the output should be -126\n    \"\"\"\n    total_sum = 0\n    for i, num in enumerate(lst):\n        transformed_num = num\n        if i % 3 == 0:\n            transformed_num = num ** 2\n        elif i % 4 == 0:\n            transformed_num = num ** 3\n        \n        total_sum += transformed_num\n    return total_sum"}
{"task_id": "HumanEval/141", "solution": "def file_name_check(file_name):\n    \"\"\"Create a function which takes a string representing a file's name, and returns\n    'Yes' if the the file's name is valid, and returns 'No' otherwise.\n    A file's name is considered to be valid if and only if all the following conditions \n    are met:\n    - There should not be more than three digits ('0'-'9') in the file's name.\n    - The file's name contains exactly one dot '.'\n    - The substring before the dot should not be empty, and it starts with a letter from \n    the latin alphapet ('a'-'z' and 'A'-'Z').\n    - The substring after the dot should be one of these: ['txt', 'exe', 'dll']\n    Examples:\n    file_name_check(\"example.txt\") # => 'Yes'\n    file_name_check(\"1example.dll\") # => 'No' (the name should start with a latin alphapet letter)\n    \"\"\"\n    \n    # Condition 1: There should not be more than three digits ('0'-'9')\n    digit_count = sum(1 for char in file_name if '0' <= char <= '9')\n    if digit_count > 3:\n        return 'No'\n\n    # Condition 2: The file's name contains exactly one dot '.'\n    if file_name.count('.') != 1:\n        return 'No'\n\n    # Split the file name into name and extension parts\n    parts = file_name.split('.')\n    name_part = parts[0]\n    ext_part = parts[1]\n\n    # Condition 3: The substring before the dot should not be empty, and it starts with a letter\n    if not name_part:  # Check if empty\n        return 'No'\n    \n    first_char = name_part[0]\n    if not ('a' <= first_char <= 'z' or 'A' <= first_char <= 'Z'): # Check if starts with a letter\n        return 'No'\n\n    # Condition 4: The substring after the dot should be one of these: ['txt', 'exe', 'dll']\n    allowed_extensions = ['txt', 'exe', 'dll']\n    if ext_part not in allowed_extensions:\n        return 'No'\n\n    # If all conditions are met\n    return 'Yes'"}
{"task_id": "HumanEval/146", "solution": "import math\ndef specialFilter(nums):\n    \"\"\"\n    Filters numbers in an array based on two criteria:\n    1. The number must be greater than 10.\n    2. Both the first and last digits (absolute value) must be odd.\n    \"\"\"\n    count = 0\n    for num in nums:\n        if num > 10:\n            abs_num = abs(num)\n            if abs_num == 0:\n                continue\n\n            last_digit = abs_num % 10\n            if last_digit % 2 == 0:\n                continue\n\n            # Find the first digit\n            # For 0, first_digit is 0 (even), but it's already handled by >10 check.\n            # For positive numbers, log10 gives the number of digits - 1\n            # For 123, log10(123) is ~2.08, int(log10(123)) is 2.\n            # 10**2 is 100. 123 // 100 is 1.\n            num_digits = int(math.log10(abs_num)) + 1\n            divisor = 10**(num_digits - 1)\n            first_digit = abs_num // divisor\n\n            if first_digit % 2 != 0:\n                count += 1\n    return count"}
{"task_id": "HumanEval/144", "solution": "import math\nclass Fraction:\n    \"\"\"Represents a rational number with integer numerator/denominator.\"\"\"\n    def __init__(self, numerator: int, denominator: int) -> None:\n        self._numerator = numerator\n        self._denominator = denominator\n        self.reduce()\n\n    def reduce(self) -> None:\n        \"\"\"Reduces the fraction to its simplest form.\"\"\"\n        common_divisor = math.gcd(self._numerator, self._denominator)\n        self._numerator //= common_divisor\n        self._denominator //= common_divisor\n        if self._denominator < 0:\n            self._numerator = -self._numerator\n            self._denominator = -self._denominator\n\n    def __mul__(self, other: \"Fraction\") -> \"Fraction\":\n        \"\"\"Multiplies this fraction by another fraction.\"\"\"\n        return Fraction(self._numerator * other._numerator,\n                        self._denominator * other._denominator)\n\n    def is_whole(self) -> bool:\n        \"\"\"Checks if the fraction represents a whole number.\"\"\"\n        return self._numerator % self._denominator == 0\ndef _parse_fraction(s: str) -> Fraction:\n    \"\"\"Parses a string 'numerator/denominator' into a Fraction object.\"\"\"\n    numerator_str, denominator_str = s.split('/')\n    return Fraction(int(numerator_str), int(denominator_str))\ndef simplify(x, n):\n    \"\"\"Your task is to implement a function that will simplify the expression\n    x * n. The function returns True if x * n evaluates to a whole number and False\n    otherwise. Both x and n, are string representation of a fraction, and have the following format,\n    <numerator>/<denominator> where both numerator and denominator are positive whole numbers.\n\n    You can assume that x, and n are valid fractions, and do not have zero as denominator.\n\n    simplify(\"1/5\", \"5/1\") = True\n    simplify(\"1/6\", \"2/1\") = False\n    simplify(\"7/10\", \"10/2\") = False\n    \"\"\"\n    fraction_x = _parse_fraction(x)\n    fraction_n = _parse_fraction(n)\n    product_fraction = fraction_x * fraction_n\n    return product_fraction.is_whole()"}
{"task_id": "HumanEval/145", "solution": "import collections\ndef order_by_points(nums):\n    \"\"\"\n    Sorts the given list of integers in ascending order according to the sum of their digits.\n    If there are several items with similar sum of their digits, order them based on their index in original list.\n    \"\"\"\n\n    def _sum_of_digits(n: int) -> int:\n        \"\"\"Calculates the sum of the absolute value's digits.\"\"\"\n        return sum(int(d) for d in str(abs(n)))\n\n    # A local class to store number details for sorting, mirroring the NumberItem dataclass from design.\n    class NumberItem:\n        __slots__ = ('value', 'original_index', 'digit_sum')\n\n        def __init__(self, value: int, original_index: int, digit_sum: int):\n            self.value = value\n            self.original_index = original_index\n            self.digit_sum = digit_sum\n\n    # Create NumberItem objects for each number with its value, original index, and calculated digit sum.\n    items = []\n    for i, v in enumerate(nums):\n        s = _sum_of_digits(v)\n        items.append(NumberItem(value=v, original_index=i, digit_sum=s))\n\n    # Sort the NumberItem objects.\n    # Primary sort key is `digit_sum` (ascending), secondary tie-breaker is `original_index` (ascending).\n    items.sort(key=lambda item: (item.digit_sum, item.original_index))\n\n    # Extract the original integer values from the sorted NumberItem objects.\n    result = [item.value for item in items]\n\n    return result"}
{"task_id": "HumanEval/147", "solution": "def get_max_triples(n):\n    \"\"\"\n    You are given a positive integer n. You have to create an integer array a of length n.\n        For each i (1 \u2264 i \u2264 n), the value of a[i] = i * i - i + 1.\n        Return the number of triples (a[i], a[j], a[k]) of a where i < j < k, \n    and a[i] + a[j] + a[k] is a multiple of 3.\n    \"\"\"\n    def combinations3(x: int) -> int:\n        \"\"\"Calculates C(x, 3), returning 0 if x is less than 3.\"\"\"\n        if x < 3:\n            return 0\n        return (x * (x - 1) * (x - 2)) // 6\n\n    # Analyze a[i] = i*i - i + 1 modulo 3:\n    # If i % 3 == 0, a[i] % 3 == 1\n    # If i % 3 == 1, a[i] % 3 == 1\n    # If i % 3 == 2, a[i] % 3 == 0\n    #\n    # So, a[i] % 3 == 0 if and only if i % 3 == 2.\n    # Otherwise, a[i] % 3 == 1.\n\n    # Count elements whose value modulo 3 is 0 (i.e., a[i] % 3 == 0).\n    # These correspond to indices i where i % 3 == 2.\n    # The indices are 2, 5, 8, ..., up to n.\n    # The count of such 'i' in 1..n is (n + 1) // 3.\n    count_mod_0 = (n + 1) // 3\n\n    # Count elements whose value modulo 3 is 1 (i.e., a[i] % 3 == 1).\n    # These correspond to indices i where i % 3 == 0 or i % 3 == 1.\n    # This is simply the total number of elements minus those that are 0 mod 3.\n    count_mod_1 = n - count_mod_0\n\n    # For a[i] + a[j] + a[k] to be a multiple of 3, the sum of their remainders modulo 3\n    # must be a multiple of 3.\n    # The only possible combinations of remainders (0 or 1) that sum to 0 mod 3 are:\n    # 1. 0 + 0 + 0\n    # 2. 1 + 1 + 1\n    #\n    # We sum the number of ways to choose 3 elements from count_mod_0 and 3 elements from count_mod_1.\n    result = combinations3(count_mod_0) + combinations3(count_mod_1)\n\n    return result"}
{"task_id": "HumanEval/151", "solution": "def double_the_difference(lst):\n    '''\n    Given a list of numbers, return the sum of squares of the numbers\n    in the list that are odd. Ignore numbers that are negative or not integers.\n    '''\n    total_sum_of_squares = 0\n    for item in lst:\n        # Determine if the item is an integer or an integral float\n        normalized_value = None\n        if isinstance(item, int):\n            normalized_value = item\n        elif isinstance(item, float) and item.is_integer():\n            normalized_value = int(item)\n        \n        # If it's a valid integral number\n        if normalized_value is not None:\n            # Ignore negative numbers\n            if normalized_value >= 0:\n                # Square and sum only odd numbers\n                if normalized_value % 2 != 0:\n                    total_sum_of_squares += normalized_value * normalized_value\n    \n    return total_sum_of_squares"}
{"task_id": "HumanEval/149", "solution": "def sorted_list_sum(lst):\n    \"\"\"Filters a list of strings to include only even-length words,\n    then sorts them by length ascending and alphabetically.\n    \"\"\"\n    even_length_strings = [s for s in lst if len(s) % 2 == 0]\n    even_length_strings.sort(key=lambda x: (len(x), x))\n    return even_length_strings"}
{"task_id": "HumanEval/148", "solution": "from typing import Tuple, Optional\nclass _PlanetModel:\n    \"\"\"Provides the canonical order of planets and methods to query them.\"\"\"\n    CANONICAL_ORDER: Tuple[str, ...] = (\n        \"Mercury\", \"Venus\", \"Earth\", \"Mars\",\n        \"Jupiter\", \"Saturn\", \"Uranus\", \"Neptune\"\n    )\n\n    @classmethod\n    def get_index(cls, name: str) -> Optional[int]:\n        \"\"\"Returns the zero-based index of a planet name or None if not found.\"\"\"\n        try:\n            return cls.CANONICAL_ORDER.index(name)\n        except ValueError:\n            return None\n\n    @classmethod\n    def all_planets(cls) -> Tuple[str, ...]:\n        \"\"\"Returns the complete tuple of canonical planet names.\"\"\"\n        return cls.CANONICAL_ORDER\nclass _PlanetRepository:\n    \"\"\"Provides read-only access to the canonical planet list and index lookup.\"\"\"\n    def __init__(self, planets: Optional[Tuple[str, ...]] = None) -> None:\n        self._planets = planets if planets is not None else _PlanetModel.all_planets()\n        self._index_map = {name: i for i, name in enumerate(self._planets)}\n\n    def get_planets(self) -> Tuple[str, ...]:\n        \"\"\"Returns the tuple of planet names managed by the repository.\"\"\"\n        return self._planets\n\n    def index_of(self, name: str) -> Optional[int]:\n        \"\"\"Returns the index of a planet by its exact name, or None.\"\"\"\n        return self._index_map.get(name)\nclass _InputValidator:\n    \"\"\"Normalizes input planet names and validates them against the repository.\"\"\"\n    def __init__(self, repository: _PlanetRepository) -> None:\n        self._repo = repository\n\n    def normalize(self, name: str) -> str:\n        \"\"\"Strips whitespace and converts the name to Title case.\"\"\"\n        return name.strip().title()\n\n    def is_valid(self, normalized_name: str) -> bool:\n        \"\"\"Checks if a normalized planet name exists in the repository.\"\"\"\n        return self._repo.index_of(normalized_name) is not None\n\n    def validate_pair(self, a: str, b: str) -> Tuple[bool, Optional[str]]:\n        \"\"\"Validates two planet names, checking for equality and existence.\"\"\"\n        na, nb = self.normalize(a), self.normalize(b)\n        if na == nb:\n            return False, \"Identical planets\"\n        if not self.is_valid(na) or not self.is_valid(nb):\n            return False, \"One or both planet names are invalid\"\n        return True, None\nclass _PlanetService:\n    \"\"\"Implements the core logic to find planets between two orbits.\"\"\"\n    def __init__(self, repository: _PlanetRepository) -> None:\n        self._repo = repository\n\n    def planets_between(self, a: str, b: str) -> Tuple[str, ...]:\n        \"\"\"\n        Returns a tuple of planets strictly between planet 'a' and planet 'b',\n        assuming 'a' and 'b' are valid and normalized planet names.\n        \"\"\"\n        ia = self._repo.index_of(a)\n        ib = self._repo.index_of(b)\n        \n        # If indices are invalid or identical, return an empty tuple.\n        # This should ideally be caught by validation earlier, but ensures robustness.\n        if ia is None or ib is None or ia == ib:\n            return ()\n        \n        low_idx = min(ia, ib) + 1\n        high_idx = max(ia, ib) - 1\n        \n        # If the range is invalid (e.g., adjacent planets), return an empty tuple.\n        if low_idx > high_idx:\n            return ()\n            \n        return tuple(self._repo.get_planets()[low_idx : high_idx + 1])\nclass _PlanetController:\n    \"\"\"Coordinates validation and service calls for the public API.\"\"\"\n    def __init__(self, validator: _InputValidator, service: _PlanetService) -> None:\n        self._validator = validator\n        self._service = service\n\n    def get_between(self, planet1: str, planet2: str) -> Tuple[str, ...]:\n        \"\"\"\n        Retrieves planets between two given planet names. Returns an empty tuple\n        if inputs are invalid or no planets are found between them.\n        \"\"\"\n        valid, _ = self._validator.validate_pair(planet1, planet2)\n        if not valid:\n            return ()\n        \n        # Normalize inputs before passing to the service, as service expects normalized names.\n        norm_planet1 = self._validator.normalize(planet1)\n        norm_planet2 = self._validator.normalize(planet2)\n        \n        return self._service.planets_between(norm_planet1, norm_planet2)\n_repo_instance = _PlanetRepository()\n_validator_instance = _InputValidator(_repo_instance)\n_service_instance = _PlanetService(_repo_instance)\n_controller_instance = _PlanetController(_validator_instance, _service_instance)\ndef bf(planet1, planet2):\n    '''\n    Returns a tuple of planets whose orbits are located between planet1 and planet2,\n    sorted by proximity to the sun. Returns an empty tuple if inputs are invalid.\n    '''\n    return _controller_instance.get_between(planet1, planet2)"}
{"task_id": "HumanEval/153", "solution": "def Strongest_Extension(class_name, extensions):\n    \"\"\"Finds the strongest extension based on CAP - SM strength and returns it in \"ClassName.ExtensionName\" format.\n    The earliest extension in the list wins in case of a tie in strength.\n    \"\"\"\n\n    def _compute_strength(extension_name: str) -> int:\n        \"\"\"Calculates the strength of an extension: (uppercase count) - (lowercase count) for ASCII letters.\"\"\"\n        cap = 0\n        sml = 0\n        for char in extension_name:\n            if 'A' <= char <= 'Z':  # ASCII uppercase\n                cap += 1\n            elif 'a' <= char <= 'z':  # ASCII lowercase\n                sml += 1\n        return cap - sml\n\n    max_strength = float('-inf')\n    strongest_extension_name = \"\"\n\n    for ext_name in extensions:\n        current_strength = _compute_strength(ext_name)\n\n        if current_strength > max_strength:\n            max_strength = current_strength\n            strongest_extension_name = ext_name\n\n    return f\"{class_name}.{strongest_extension_name}\""}
{"task_id": "HumanEval/150", "solution": "import math\nclass PrimeChecker:\n    \"\"\"Helper class to determine if an integer is prime.\"\"\"\n    def __init__(self, max_n: int = 1_000_000_000_000):\n        self.max_n = max_n\n\n    def is_prime(self, n: int) -> bool:\n        \"\"\"Determines if the given integer n is a prime number.\"\"\"\n        if n <= 1:\n            return False\n        if n <= 3:\n            return True\n        if n % 2 == 0 or n % 3 == 0:\n            return False\n        i = 5\n        limit = int(math.isqrt(n))\n        while i <= limit:\n            if n % i == 0 or n % (i + 2) == 0:\n                return False\n            i += 6\n        return True\ndef x_or_y(n, x, y):\n    \"\"\"A simple program which should return the value of x if n is \n    a prime number and should return the value of y otherwise.\n\n    Examples:\n    for x_or_y(7, 34, 12) == 34\n    for x_or_y(15, 8, 5) == 5\n    \n    \"\"\"\n    checker = PrimeChecker()\n    if checker.is_prime(n):\n        return x\n    else:\n        return y"}
{"task_id": "HumanEval/152", "solution": "def compare(game,guess):\n    \"\"\"I think we all remember that feeling when the result of some long-awaited\n    event is finally known. The feelings and thoughts you have at that moment are\n    definitely worth noting down and comparing.\n    Your task is to determine if a person correctly guessed the results of a number of matches.\n    You are given two arrays of scores and guesses of equal length, where each index shows a match. \n    Return an array of the same length denoting how far off each guess was. If they have guessed correctly,\n    the value is 0, and if not, the value is the absolute difference between the guess and the score.\n    \n    \n    example:\n\n    compare([1,2,3,4,5,1],[1,2,3,4,2,-2]) -> [0,0,0,0,3,3]\n    compare([0,5,0,0,0,4],[4,1,1,0,0,-2]) -> [4,4,1,0,0,6]\n    \"\"\"\n    return [abs(s - g) for s, g in zip(game, guess)]"}
{"task_id": "HumanEval/154", "solution": "def cycpattern_check(a , b):\n    \"\"\"You are given 2 words. You need to return True if the second word or any of its rotations is a substring in the first word\n    cycpattern_check(\"abcd\",\"abd\") => False\n    cycpattern_check(\"hello\",\"ell\") => True\n    cycpattern_check(\"whassup\",\"psus\") => False\n    cycpattern_check(\"abab\",\"baa\") => True\n    cycpattern_check(\"efef\",\"eeff\") => False\n    cycpattern_check(\"himenss\",\"simen\") => True\n\n    \"\"\"\n    len_a = len(a)\n    len_b = len(b)\n\n    if len_b == 0:\n        return False\n    if len_b > len_a:\n        return False\n\n    # Create the doubled string of b. Any cyclic rotation of b will be a substring of b + b.\n    b_doubled = b + b\n\n    # Iterate through all possible rotations of b\n    # A string of length len_b can have len_b unique rotations.\n    # These rotations can be found as substrings of b_doubled of length len_b.\n    for i in range(len_b):\n        rotated_b = b_doubled[i : i + len_b]\n        if rotated_b in a:\n            return True\n\n    return False"}
{"task_id": "HumanEval/156", "solution": "def int_to_mini_roman(number):\n    \"\"\"\n    Given a positive integer, obtain its roman numeral equivalent as a string,\n    and return it in lowercase.\n    Restrictions: 1 <= num <= 1000\n    \"\"\"\n    roman_map = [\n        (1000, \"M\"), (900, \"CM\"), (500, \"D\"), (400, \"CD\"),\n        (100, \"C\"), (90, \"XC\"), (50, \"L\"), (40, \"XL\"),\n        (10, \"X\"), (9, \"IX\"), (5, \"V\"), (4, \"IV\"), (1, \"I\"),\n    ]\n\n    result = []\n    for value, numeral in roman_map:\n        while number >= value:\n            result.append(numeral)\n            number -= value\n    return \"\".join(result).lower()"}
{"task_id": "HumanEval/155", "solution": "def even_odd_count(num):\n    \"\"\"Given an integer. return a tuple that has the number of even and odd digits respectively.\n\n     Example:\n        even_odd_count(-12) ==> (1, 1)\n        even_odd_count(123) ==> (1, 2)\n    \"\"\"\n    n = abs(num)\n    if n == 0:\n        return (1, 0) # 0 is considered an even digit\n    \n    even_count = 0\n    odd_count = 0\n    \n    while n > 0:\n        digit = n % 10\n        if digit % 2 == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n        n //= 10\n        \n    return (even_count, odd_count)"}
{"task_id": "HumanEval/158", "solution": "def find_max(words):\n    \"\"\"Write a function that accepts a list of strings.\n    The list contains different words. Return the word with maximum number\n    of unique characters. If multiple strings have maximum number of unique\n    characters, return the one which comes first in lexicographical order.\n\n    find_max([\"name\", \"of\", \"string\"]) == \"string\"\n    find_max([\"name\", \"enam\", \"game\"]) == \"enam\"\n    find_max([\"aaaaaaa\", \"bb\" ,\"cc\"]) == \"\"aaaaaaa\"\n    \"\"\"\n    if not words:\n        # Per the completion instructions, we do not add checks or raise exceptions.\n        # Assuming `words` is guaranteed to be non-empty based on typical problem constraints.\n        pass\n\n    max_unique_chars = -1\n    result_word = \"\"\n\n    for i, word in enumerate(words):\n        current_unique_chars = len(set(word))\n\n        if i == 0:  # Initialize with the first word\n            max_unique_chars = current_unique_chars\n            result_word = word\n        elif current_unique_chars > max_unique_chars:\n            max_unique_chars = current_unique_chars\n            result_word = word\n        elif current_unique_chars == max_unique_chars:\n            # Tie-breaking: if counts are equal, choose the one that comes first lexicographically\n            if word < result_word:\n                result_word = word\n                \n    return result_word"}
{"task_id": "HumanEval/159", "solution": "def eat(number, need, remaining):\n    \"\"\"\n    Calculates the total carrots eaten and remaining after a rabbit attempts to eat more.\n    Consumes carrots up to the 'need' amount or until 'remaining' carrots are gone.\n    \"\"\"\n    carrots_eaten_now = min(need, remaining)\n    total_eaten = number + carrots_eaten_now\n    carrots_left = remaining - carrots_eaten_now\n    \n    return [total_eaten, carrots_left]"}
{"task_id": "HumanEval/157", "solution": "import math\nfrom dataclasses import dataclass\nfrom typing import Tuple, Any\n_DEFAULT_EPSILON = 1e-9\nclass _RightAngleChecker:\n    \"\"\"Determines if a Triangle is right-angled using a tolerance epsilon.\"\"\"\n\n    def is_right_angle(self, triangle: _Triangle) -> bool:\n        \"\"\"Checks if the given triangle is right-angled.\"\"\"\n        # Sort sides to ensure x, y are legs and z is hypotenuse.\n        x, y, z = triangle.as_sorted_tuple()\n        return self._pythagorean_holds(x, y, z)\n\n    def _pythagorean_holds(self, x: float, y: float, z: float) -> bool:\n        \"\"\"Internal helper to check Pythagorean theorem with tolerance.\"\"\"\n        return math.isclose(x * x + y * y, z * z, rel_tol=_DEFAULT_EPSILON)\ndef right_angle_triangle(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle. Return True if the three\n    sides form a right-angled triangle, False otherwise.\n    A right-angled triangle is a triangle in which one angle is right angle or\n    90 degree.\n    Example:\n    right_angle_triangle(3, 4, 5) == True\n    right_angle_triangle(1, 2, 3) == False\n    '''\n    # Convert inputs to floats.\n    a_f = float(a)\n    b_f = float(b)\n    c_f = float(c)\n\n    # Validate triangle properties: positivity and triangle inequality.\n    # Return False for logically invalid triangles.\n    if not (a_f > 0 and b_f > 0 and c_f > 0):\n        return False\n    if not (a_f + b_f > c_f and a_f + c_f > b_f and b_f + c_f > a_f):\n        return False\n\n    # Create Triangle object and use RightAngleChecker.\n    triangle = _Triangle(a_f, b_f, c_f)\n    checker = _RightAngleChecker()\n    return checker.is_right_angle(triangle)"}
{"task_id": "HumanEval/161", "solution": "def solve(s):\n    \"\"\"You are given a string s.\n    if s[i] is a letter, reverse its case from lower to upper or vise versa, \n    otherwise keep it as it is.\n    If the string contains no letters, reverse the string.\n    The function should return the resulted string.\n    Examples\n    solve(\"1234\") = \"4321\"\n    solve(\"ab\") = \"AB\"\n    solve(\"#a@C\") = \"#A@c\"\n    \"\"\"\n    has_letters = False\n    for char in s:\n        if char.isalpha():\n            has_letters = True\n            break\n\n    if has_letters:\n        transformed_chars = []\n        for char in s:\n            if char.isalpha():\n                transformed_chars.append(char.swapcase())\n            else:\n                transformed_chars.append(char)\n        return \"\".join(transformed_chars)\n    else:\n        return s[::-1]"}
{"task_id": "HumanEval/160", "solution": "import operator\ndef do_algebra(operator_list, operand_list):\n    \"\"\"\n    Given two lists operator_list, and operand_list. The first list has basic algebra operations, and \n    the second list is a list of integers. Use the two given lists to build the algebric \n    expression and return the evaluation of this expression.\n    \"\"\"\n\n    class _Literal:\n        def __init__(self, value: int):\n            self.value = value\n\n    class _BinaryOperation:\n        def __init__(self, op_str: str, left, right):\n            self.op_str = op_str\n            self.left = left\n            self.right = right\n\n    def _precedence(op: str) -> int:\n        if op == '**': return 3\n        if op in ('*', '//'): return 2\n        if op in ('+', '-'): return 1\n        return 0\n\n    def _is_right_associative(op: str) -> bool:\n        return op == \"**\"\n\n    def _to_rpn(ops: list, nums: list) -> list:\n        output = []\n        op_stack = []\n        \n        tokens = []\n        for i in range(len(nums)):\n            tokens.append(nums[i])\n            if i < len(ops):\n                tokens.append(ops[i])\n\n        for token in tokens:\n            if isinstance(token, int):\n                output.append(token)\n            else: # Operator string\n                while (op_stack and\n                       _precedence(op_stack[-1]) > _precedence(token) or\n                       (_precedence(op_stack[-1]) == _precedence(token) and not _is_right_associative(token))):\n                    output.append(op_stack.pop())\n                op_stack.append(token)\n\n        while op_stack:\n            output.append(op_stack.pop())\n        return output\n\n    def _build_ast_from_rpn(rpn_tokens: list):\n        stack = []\n        for token in rpn_tokens:\n            if isinstance(token, int):\n                stack.append(_Literal(token))\n            else: # Operator string\n                right = stack.pop()\n                left = stack.pop()\n                stack.append(_BinaryOperation(token, left, right))\n        return stack[0]\n\n    def _evaluate_node(node) -> int:\n        if isinstance(node, _Literal):\n            return node.value\n        elif isinstance(node, _BinaryOperation):\n            l_val = _evaluate_node(node.left)\n            r_val = _evaluate_node(node.right)\n\n            if node.op_str == \"+\":\n                return l_val + r_val\n            elif node.op_str == \"-\":\n                return l_val - r_val\n            elif node.op_str == \"*\":\n                return l_val * r_val\n            elif node.op_str == \"//\":\n                return l_val // r_val\n            elif node.op_str == \"**\":\n                return l_val ** r_val\n        return 0\n\n    rpn_expression = _to_rpn(operator_list, operand_list)\n    ast_root = _build_ast_from_rpn(rpn_expression)\n    result = _evaluate_node(ast_root)\n    return result"}
{"task_id": "HumanEval/162", "solution": "import hashlib\ndef string_to_md5(text):\n    \"\"\"\n    Given a string 'text', return its md5 hash equivalent string.\n    If 'text' is an empty string, return None.\n    \"\"\"\n    if not text:\n        return None\n    \n    return hashlib.md5(text.encode('utf-8')).hexdigest()"}
{"task_id": "HumanEval/163", "solution": "def generate_integers(a, b):\n    \"\"\"\n    Given two positive integers a and b, return the even digits between a\n    and b, in ascending order.\n    \"\"\"\n    # Determine the effective range by finding the minimum and maximum of a and b.\n    min_val = min(a, b)\n    max_val = max(a, b)\n\n    # The canonical list of single-digit even integers.\n    canonical_even_digits = [0, 2, 4, 6, 8]\n\n    # Filter for digits that fall within the specified range [min_val, max_val].\n    result = [d for d in canonical_even_digits if min_val <= d <= max_val]\n\n    return result"}
