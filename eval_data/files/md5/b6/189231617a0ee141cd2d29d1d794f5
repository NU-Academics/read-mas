{"task_id": "HumanEval/54", "solution": "def same_chars(s0: str, s1: str):\n    \"\"\"\n    Check if two words have the same characters.\n    >>> same_chars('eabcdzzzz', 'dddzzzzzzzddeddabc')\n    True\n    >>> same_chars('abcd', 'dddddddabc')\n    True\n    >>> same_chars('dddddddabc', 'abcd')\n    True\n    >>> same_chars('eabcd', 'dddddddabc')\n    False\n    >>> same_chars('abcd', 'dddddddabce')\n    False\n    >>> same_chars('eabcdzzzz', 'dddzzzzzzzddddabc')\n    False\n    \"\"\"\n    return set(s0) == set(s1)"}
{"task_id": "HumanEval/57", "solution": "def monotonic(l: list):\n    \"\"\"Return True is list elements are monotonically increasing or decreasing.\"\"\"\n    if len(l) <= 1:\n        return True\n\n    # Check for non-decreasing\n    non_decreasing = True\n    for i in range(len(l) - 1):\n        if l[i] > l[i+1]:\n            non_decreasing = False\n            break\n\n    # Check for non-increasing\n    non_increasing = True\n    for i in range(len(l) - 1):\n        if l[i] < l[i+1]:\n            non_increasing = False\n            break\n\n    return non_decreasing or non_increasing"}
{"task_id": "HumanEval/56", "solution": "def correct_bracketing(brackets: str):\n    \"\"\" brackets is a string of \"<\" and \">\".\n    return True if every opening bracket has a corresponding closing bracket.\n    \"\"\"\n    counter = 0\n    for ch in brackets:\n        if ch == '<':\n            counter += 1\n        elif ch == '>':\n            counter -= 1\n            if counter < 0:\n                return False\n        else:\n            # Any character other than '<' or '>' makes the bracketing incorrect\n            return False\n    return counter == 0"}
{"task_id": "HumanEval/59", "solution": "def largest_prime_factor(n: int):\n    \"\"\"Return the largest prime factor of n. Assume n > 1 and is not a prime.\n    >>> largest_prime_factor(13195)\n    29\n    >>> largest_prime_factor(2048)\n    2\n    \"\"\"\n    largest_factor = 1\n\n    # Handle factor 2\n    while n % 2 == 0:\n        largest_factor = 2\n        n //= 2\n\n    # Handle odd factors\n    p = 3\n    while p * p <= n:\n        while n % p == 0:\n            largest_factor = p\n            n //= p\n        p += 2\n\n    # If n is still greater than 1, it must be the largest prime factor\n    if n > 1:\n        largest_factor = n\n\n    return largest_factor"}
{"task_id": "HumanEval/58", "solution": "from typing import Any, Iterable\nclass CommonError(Exception):\n    \"\"\"Base exception for common_pkg errors.\"\"\"\n    pass\nclass InvalidInputError(CommonError):\n    \"\"\"Raised when input to a function is invalid.\"\"\"\n    pass\ndef _to_set(iterable: Iterable[Any]) -> set[Any]:\n    \"\"\"Converts an iterable to a set, allowing TypeError to propagate for unhashable elements.\"\"\"\n    try:\n        return set(iterable)\n    except TypeError as e:\n        # Propagate TypeError for unhashable elements; the 'common' function will wrap it.\n        raise e\ndef common(l1: list, l2: list):\n    \"\"\"Return sorted unique common elements for two lists.\"\"\"\n    try:\n        set1 = _to_set(l1)\n        set2 = _to_set(l2)\n    except TypeError as e:\n        # Wrap TypeError from _to_set (due to unhashable elements) into InvalidInputError.\n        raise InvalidInputError(f\"Input lists contain unhashable elements: {e}\")\n\n    intersect = set1.intersection(set2)\n\n    try:\n        return sorted(list(intersect))\n    except TypeError:\n        # If elements are not mutually comparable, sort by their string representation for deterministic order.\n        return sorted(list(intersect), key=lambda x: repr(x))"}
{"task_id": "HumanEval/55", "solution": "import time\nfrom datetime import datetime\nfrom collections import OrderedDict\nfrom typing import Optional, Any, Dict, Tuple, Callable, TypeVar\nimport concurrent.futures\nclass _Config:\n    \"\"\"Simplified configuration for the inline components.\"\"\"\n    CACHE_SIZE: int = 1024\n    DB_URL: str = \"sqlite:///:memory:\" # Use in-memory DB for self-contained example\n    ENABLE_PERSISTENCE: bool = False # Disable persistence for this self-contained example\n    DEFAULT_ALGORITHM: str = \"fast_doubling\"\nclass InvalidInputError(Exception):\n    \"\"\"Exception raised for invalid input parameters.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\nclass ComputationError(Exception):\n    \"\"\"Exception raised for errors during Fibonacci computation.\"\"\"\n    def __init__(self, message: str, cause: Optional[Exception] = None) -> None:\n        super().__init__(message)\n        self.cause = cause\nclass Algorithm:\n    \"\"\"Simple class mimicking an Enum for algorithm names.\"\"\"\n    ITERATIVE = \"iterative\"\n    FAST_DOUBLING = \"fast_doubling\"\n    MATRIX = \"matrix\"\nclass FibonacciResult:\n    \"\"\"Data model for a computed Fibonacci number result.\"\"\"\n    def __init__(self, n: int, value: int, algorithm: str, duration_ms: float, created_at: datetime):\n        self.n = n\n        self.value = value\n        self.algorithm = algorithm\n        self.duration_ms = duration_ms\n        self.created_at = created_at\nclass InputValidator:\n    \"\"\"Validates input 'n' and algorithm names.\"\"\"\n    @staticmethod\n    def validate_n(n: Any) -> int:\n        if not isinstance(n, int):\n            raise InvalidInputError(\"Input 'n' must be an integer.\")\n        if n < 0:\n            raise InvalidInputError(\"Input 'n' must be non-negative.\")\n        return n\n\n    @staticmethod\n    def validate_algorithm(alg: Optional[str]) -> str:\n        if alg is None:\n            return _Config.DEFAULT_ALGORITHM\n        alg_lower = alg.lower()\n        if alg_lower in [Algorithm.ITERATIVE, Algorithm.FAST_DOUBLING, Algorithm.MATRIX]:\n            return alg_lower\n        raise InvalidInputError(f\"Invalid algorithm '{alg}'. Choose from 'iterative', 'fast_doubling', 'matrix'.\")\nclass _IterativeAlgorithm:\n    \"\"\"Implements Fibonacci computation using an iterative approach.\"\"\"\n    def compute(self, n: int) -> int:\n        if n < 0:\n            raise InvalidInputError(\"Input 'n' must be non-negative for Fibonacci calculation.\")\n        if n == 0:\n            return 0\n        if n == 1:\n            return 1\n        a, b = 0, 1\n        for _ in range(n - 1):\n            a, b = b, a + b\n        return b\nclass FastDoublingAlgorithm:\n    \"\"\"Implements Fibonacci computation using the fast doubling method.\"\"\"\n    def compute(self, n: int) -> int:\n        if n < 0:\n            raise InvalidInputError(\"Input 'n' must be non-negative for Fibonacci calculation.\")\n        if n == 0:\n            return 0\n        \n        # Returns (F_k, F_k+1)\n        def _fd(k: int) -> Tuple[int, int]:\n            if k == 0:\n                return (0, 1) # (F_0, F_1)\n            \n            a, b = _fd(k // 2)  # (F_{k/2}, F_{k/2 + 1})\n            \n            # F(2m) = F(m) * (2*F(m+1) - F(m))\n            # F(2m+1) = F(m+1)^2 + F(m)^2\n            c = a * (2 * b - a)\n            d = a*a + b*b\n            \n            if k % 2 == 0: # k is even, k = 2m\n                return (c, d) # (F_{2m}, F_{2m+1})\n            else: # k is odd, k = 2m + 1\n                return (d, c + d) # (F_{2m+1}, F_{2m+2})\n\n        return _fd(n)[0]\nclass _MatrixExponentiationAlgorithm:\n    \"\"\"Implements Fibonacci computation using matrix exponentiation.\"\"\"\n    def _multiply_matrices(self, A, B):\n        a, b = A[0][0], A[0][1]\n        c, d = A[1][0], A[1][1]\n        e, f = B[0][0], B[0][1]\n        g, h = B[1][0], B[1][1]\n        return [[a*e + b*g, a*f + b*h],\n                [c*e + d*g, c*f + d*h]]\n\n    def _power_matrix(self, M, p):\n        if p == 0:\n            return [[1, 0], [0, 1]] # Identity matrix\n        if p == 1:\n            return M\n        \n        if p % 2 == 0:\n            half_power = self._power_matrix(M, p // 2)\n            return self._multiply_matrices(half_power, half_power)\n        else:\n            return self._multiply_matrices(M, self._power_matrix(M, p - 1))\n\n    def compute(self, n: int) -> int:\n        if n < 0:\n            raise InvalidInputError(\"Input 'n' must be non-negative for Fibonacci calculation.\")\n        if n == 0:\n            return 0\n        if n == 1:\n            return 1\n\n        F_matrix = [[1, 1], [1, 0]]\n        result_matrix = self._power_matrix(F_matrix, n)\n        return result_matrix[0][1]\nclass LRUCache:\n    \"\"\"In-memory LRU cache for storing computed Fibonacci values.\"\"\"\n    def __init__(self, max_size: int):\n        self._max_size = max_size\n        self._store = OrderedDict()\n        self._hits = 0\n        self._misses = 0\n\n    def get(self, key: str) -> Optional[int]:\n        if key in self._store:\n            self._store.move_to_end(key)\n            self._hits += 1\n            return self._store[key]\n        self._misses += 1\n        return None\n\n    def set(self, key: str, value: int) -> None:\n        self._store[key] = value\n        self._store.move_to_end(key)\n        if len(self._store) > self._max_size:\n            self._store.popitem(last=False)\nclass ResultRepository:\n    \"\"\"Abstract persistence adapter (simplified for inline use).\"\"\"\n    def __init__(self, db_url: str):\n        self._db_url = db_url\n        # In a real scenario, this would manage a DB connection.\n        # For this inline solution, it's mostly a placeholder if persistence is disabled.\n\n    def save(self, result: FibonacciResult) -> None:\n        # Placeholder for saving results.\n        # In this self-contained setup, persistence is disabled by default.\n        pass\n\n    def get(self, n: int, algorithm: str) -> Optional[FibonacciResult]:\n        return None\n\n    def close(self) -> None:\n        pass\n_T = TypeVar('_T')\ndef _timeit(func: Callable[..., _T], *args: Any, **kwargs: Any) -> Tuple[_T, float]:\n    \"\"\"Helper to measure execution time of a function.\"\"\"\n    start_time = time.perf_counter()\n    result = func(*args, **kwargs)\n    end_time = time.perf_counter()\n    duration_ms = (end_time - start_time) * 1000\n    return result, duration_ms\ndef _make_key(n: int, algorithm: str) -> str:\n    \"\"\"Generates a cache key from n and algorithm.\"\"\"\n    return f\"{algorithm}:{n}\"\nclass FibonacciService:\n    \"\"\"Orchestrates Fibonacci computation, caching, and optional persistence.\"\"\"\n    def __init__(self, cache: LRUCache, repo: Optional[ResultRepository], config_module: Any):\n        self._cache = cache\n        self._repo = repo\n        self._config = config_module\n        self._algorithms = {\n            Algorithm.ITERATIVE: _IterativeAlgorithm(),\n            Algorithm.FAST_DOUBLING: FastDoublingAlgorithm(),\n            Algorithm.MATRIX: _MatrixExponentiationAlgorithm()\n        }\n        # Use ThreadPoolExecutor for async persistence to avoid blocking main thread\n        self._executor = concurrent.futures.ThreadPoolExecutor(max_workers=1)\n\n    def compute(self, n: int, algorithm: str = \"fast_doubling\") -> FibonacciResult:\n        \"\"\"Computes the n-th Fibonacci number using the specified algorithm.\"\"\"\n        n_validated = InputValidator.validate_n(n)\n        alg_validated = InputValidator.validate_algorithm(algorithm)\n\n        key = _make_key(n_validated, alg_validated)\n        cached_val = self._cache.get(key)\n\n        if cached_val is not None:\n            return FibonacciResult(n=n_validated, value=cached_val,\n                                 algorithm=alg_validated, duration_ms=0.0,\n                                 created_at=datetime.utcnow())\n        \n        impl = self._select_algorithm(alg_validated)\n        try:\n            value, duration_ms = _timeit(impl.compute, n_validated)\n        except Exception as e:\n            raise ComputationError(f\"Algorithm '{alg_validated}' failed for n={n_validated}\", cause=e)\n\n        result = FibonacciResult(n=n_validated, value=value,\n                                 algorithm=alg_validated, duration_ms=duration_ms,\n                                 created_at=datetime.utcnow())\n        self._cache.set(key, value)\n\n        if self._repo and self._config.ENABLE_PERSISTENCE:\n            self._persist_async(result)\n            \n        return result\n\n    def _select_algorithm(self, algorithm: str) -> Any:\n        algo_impl = self._algorithms.get(algorithm)\n        if algo_impl is None:\n            raise ComputationError(f\"Algorithm '{algorithm}' not found or implemented.\")\n        return algo_impl\n\n    def _persist_async(self, result: FibonacciResult) -> None:\n        if self._repo:\n            try:\n                self._executor.submit(self._repo.save, result)\n            except Exception as e:\n                # Log the error but don't block the main flow\n                print(f\"Warning: Asynchronous persistence failed for {result.n}: {e}\")\n_global_config_instance = _Config()\n_global_cache_instance: LRUCache = LRUCache(_global_config_instance.CACHE_SIZE)\n_global_repo_instance: Optional[ResultRepository] = None\n_global_fib_service_instance: FibonacciService = FibonacciService(\n    cache=_global_cache_instance,\n    repo=_global_repo_instance,\n    config_module=_global_config_instance\n)\ndef fib(n: int) -> int:\n    \"\"\"Return n-th Fibonacci number using the default algorithm.\n    Propagates InvalidInputError for invalid n.\n    \"\"\"\n    fib_result: FibonacciResult = _global_fib_service_instance.compute(n, algorithm=_global_config_instance.DEFAULT_ALGORITHM)\n    return fib_result.value"}
