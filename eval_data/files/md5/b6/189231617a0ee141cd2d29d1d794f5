{"task_id": "HumanEval/44", "solution": "def change_base(x: int, base: int):\n    \"\"\"Change numerical base of input number x to base.\n    return string representation after the conversion.\n    base numbers are less than 10.\n    >>> change_base(8, 3)\n    '22'\n    >>> change_base(8, 2)\n    '1000'\n    >>> change_base(7, 2)\n    '111'\n    \"\"\"\n    if x == 0:\n        return \"0\"\n    \n    digits = []\n    while x > 0:\n        x, remainder = divmod(x, base)\n        digits.append(str(remainder))\n    \n    return \"\".join(reversed(digits))"}
{"task_id": "HumanEval/47", "solution": "import math\ndef median(l: list):\n    \"\"\"Return median of elements in the list l.\n    >>> median([3, 1, 2, 4, 5])\n    3\n    >>> median([-10, 4, 6, 1000, 10, 20])\n    15.0\n    \"\"\"\n    sorted_l = sorted(l)\n    n = len(sorted_l)\n    \n    if n % 2 == 1:\n        return sorted_l[n // 2]\n    else:\n        mid1 = sorted_l[n // 2 - 1]\n        mid2 = sorted_l[n // 2]\n        return (mid1 + mid2) / 2.0"}
{"task_id": "HumanEval/46", "solution": "def fib4(n: int):\n    \"\"\"Computes the n-th Fib4 number using an iterative approach.\n    Handles base cases and uses a sliding window for n > 3.\n    \"\"\"\n    if n == 0:\n        return 0\n    if n == 1:\n        return 0\n    if n == 2:\n        return 2\n    if n == 3:\n        return 0\n\n    # These variables hold fib4(k-4), fib4(k-3), fib4(k-2), fib4(k-1) respectively\n    # for the calculation of fib4(k).\n    f_n_minus_4 = 0  # Represents fib4(0) initially\n    f_n_minus_3 = 0  # Represents fib4(1) initially\n    f_n_minus_2 = 2  # Represents fib4(2) initially\n    f_n_minus_1 = 0  # Represents fib4(3) initially\n\n    for _ in range(4, n + 1):\n        current_fib4 = f_n_minus_1 + f_n_minus_2 + f_n_minus_3 + f_n_minus_4\n        \n        # Shift the window for the next iteration\n        f_n_minus_4 = f_n_minus_3\n        f_n_minus_3 = f_n_minus_2\n        f_n_minus_2 = f_n_minus_1\n        f_n_minus_1 = current_fib4\n        \n    return f_n_minus_1"}
{"task_id": "HumanEval/48", "solution": "from unicodedata import normalize as u_normalize\nfrom collections import OrderedDict\nfrom dataclasses import dataclass\nfrom typing import Optional\nclass InvalidTextError(ValueError):\n    \"\"\"Raised when input text is invalid (e.g., None, too long).\"\"\"\n    pass\nDEFAULT_MAX_INPUT_LENGTH = 100000\nDEFAULT_CACHE_SIZE = 1024\nclass Normalizer:\n    \"\"\"Applies a sequence of normalization steps to a string.\"\"\"\n    def __init__(self, policy: NormalizationPolicy) -> None:\n        self.policy = policy\n\n    def normalize(self, text: str) -> str:\n        \"\"\"Normalizes the input text according to the set policy.\"\"\"\n        if text is None:\n            raise InvalidTextError(\"text is None\")\n        \n        # Apply unicode normalization\n        s = u_normalize(self.policy.unicode_form, text)\n\n        # Apply case folding\n        if self.policy.case_fold:\n            s = s.casefold()\n\n        # Remove non-alphanumeric characters\n        if self.policy.remove_non_alnum:\n            s = ''.join(ch for ch in s if ch.isalnum())\n        \n        # Strip leading/trailing whitespace\n        return s.strip()\nclass PalindromeChecker:\n    \"\"\"Provides algorithms to check if a string is a palindrome.\"\"\"\n    def __init__(self) -> None:\n        pass\n\n    def is_palindrome(self, text: str) -> bool:\n        \"\"\"Checks if the given text is a palindrome using a two-pointer approach.\"\"\"\n        if text is None:\n            raise InvalidTextError(\"text is None\")\n        i, j = 0, len(text) - 1\n        while i < j:\n            if text[i] != text[j]:\n                return False\n            i += 1\n            j -= 1\n        return True\nclass LRUCache:\n    \"\"\"An in-memory Least-Recently-Used cache for storing boolean results.\"\"\"\n    def __init__(self, capacity: int = DEFAULT_CACHE_SIZE) -> None:\n        self.capacity = capacity\n        self.store = OrderedDict()\n\n    def get(self, key: str) -> Optional[bool]:\n        \"\"\"Retrieves a value from the cache and updates its recency.\"\"\"\n        val = self.store.get(key)\n        if val is not None:\n            self.store.move_to_end(key)\n        return val\n\n    def set(self, key: str, value: bool) -> None:\n        \"\"\"Adds or updates a value in the cache, managing capacity.\"\"\"\n        self.store[key] = value\n        self.store.move_to_end(key)\n        if len(self.store) > self.capacity:\n            self.store.popitem(last=False)\n            \n    def clear(self) -> None:\n        \"\"\"Clears all entries from the cache.\"\"\"\n        self.store.clear()\nclass PalindromeService:\n    \"\"\"Orchestrates palindrome checks, including normalization and caching.\"\"\"\n    def __init__(self, normalizer: Normalizer, checker: PalindromeChecker, cache: LRUCache) -> None:\n        self.normalizer = normalizer\n        self.checker = checker\n        self.cache = cache\n\n    def check(self, text: str, normalize: bool = True) -> bool:\n        \"\"\"Checks if the given text is a palindrome, optionally normalizing and using cache.\"\"\"\n        validate_input_size(text, self.normalizer.policy.max_length)\n        key = self.normalizer.normalize(text) if normalize else text\n        \n        cached = self.cache.get(key)\n        if cached is not None:\n            return cached\n        \n        result = self.checker.is_palindrome(key)\n        self.cache.set(key, result)\n        return result\n    \n    def set_policy(self, policy: NormalizationPolicy) -> None:\n        \"\"\"Updates the normalization policy for the service.\"\"\"\n        self.normalizer.policy = policy\n_default_normalization_policy = NormalizationPolicy(\n    case_fold=True,\n    remove_non_alnum=True,\n    unicode_form='NFC',\n    max_length=DEFAULT_MAX_INPUT_LENGTH\n)\n_default_normalizer = Normalizer(_default_normalization_policy)\n_default_palindrome_checker = PalindromeChecker()\n_default_lru_cache = LRUCache(DEFAULT_CACHE_SIZE)\n_default_palindrome_service = PalindromeService(\n    _default_normalizer,\n    _default_palindrome_checker,\n    _default_lru_cache\n)\ndef is_palindrome(text: str):\n    \"\"\"\n    Checks if given string is a palindrome\n    >>> is_palindrome('')\n    True\n    >>> is_palindrome('aba')\n    True\n    >>> is_palindrome('aaaaa')\n    True\n    >>> is_palindrome('zbcd')\n    False\n    \"\"\"\n    return _default_palindrome_service.check(text, normalize=True)"}
{"task_id": "HumanEval/49", "solution": "import abc\nclass ValidationError(Exception):\n    \"\"\"Represents input validation failures.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\nclass ComputationError(Exception):\n    \"\"\"Represents problems during computation.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\nclass ExponentiationAlgorithm(abc.ABC):\n    \"\"\"Abstract interface for exponentiation algorithms.\"\"\"\n    @abc.abstractmethod\n    def compute(self, base: int, exponent: int, modulus: int) -> int:\n        pass\nclass FastExponentiationAlgorithm(ExponentiationAlgorithm):\n    \"\"\"Efficiently compute base^exponent mod modulus using square-and-multiply algorithm (binary exponentiation).\"\"\"\n    NAME = \"fast\"\n\n    def compute(self, base: int, exponent: int, modulus: int) -> int:\n        if modulus <= 0:\n            raise ComputationError(\"modulus must be > 0 for modular exponentiation.\")\n        # Use builtin pow which is optimized for CRT/big ints.\n        return pow(base, exponent, modulus)\nclass InputValidator:\n    \"\"\"Validates and coerces inputs (n, p) from strings or other types into correct ints, enforcing business rules.\"\"\"\n    def validate_n(self, n: int | str) -> int:\n        try:\n            ni = int(n)\n        except (ValueError, TypeError):\n            raise ValidationError(f\"n must be an integer, got {n!r}\")\n        if ni < 0:\n            raise ValidationError(\"n must be >= 0\")\n        return ni\n\n    def validate_p(self, p: int | str) -> int:\n        try:\n            pi = int(p)\n        except (ValueError, TypeError):\n            raise ValidationError(f\"p must be an integer, got {p!r}\")\n        if pi <= 0:\n            raise ValidationError(\"p must be > 0\")\n        return pi\nclass ModPService:\n    \"\"\"Public library API that validates inputs and orchestrates computation, choosing the correct algorithm.\"\"\"\n    def __init__(self, algorithm: ExponentiationAlgorithm, validator: InputValidator) -> None:\n        self.algorithm = algorithm\n        self.validator = validator\n\n    def modp(self, n: int | str, p: int | str) -> int:\n        ni = self.validator.validate_n(n)\n        pi = self.validator.validate_p(p)\n        try:\n            # The design context indicates that choose_algorithm would be a policy,\n            # but for this specific function, it defaults to the injected algorithm.\n            # In the current simple setup, we just use the pre-selected algorithm.\n            # If dynamic algorithm selection were implemented, it would be here.\n            return self.algorithm.compute(2, ni, pi)\n        except Exception as exc:\n            raise ComputationError(f\"An error occurred during computation: {exc}\") from exc\n_default_service = ModPService(FastExponentiationAlgorithm(), InputValidator())\ndef modp(n: int, p: int) -> int:\n    \"\"\"Return 2^n modulo p (be aware of numerics).\"\"\"\n    # This function uses a pre-configured service instance to perform the computation.\n    return _default_service.modp(n, p)"}
