{"task_id": "HumanEval/32", "solution": "def find_zero(xs: list):\n    \"\"\" xs are coefficients of a polynomial.\n    find_zero find x such that poly(x) = 0.\n    find_zero returns only only zero point, even if there are many.\n    Moreover, find_zero only takes list xs having even number of coefficients\n    and largest non zero coefficient as it guarantees\n    a solution.\n    >>> round(find_zero([1, 2]), 2) # f(x) = 1 + 2x\n    -0.5\n    >>> round(find_zero([-6, 11, -6, 1]), 2) # (x - 1) * (x - 2) * (x - 3) = -6 + 11x - 6x^2 + x^3\n    1.0\n    \"\"\"\n    if len(xs) == 2:\n        # Handle linear polynomial: xs[0] + xs[1]*x = 0 => x = -xs[0]/xs[1]\n        return -xs[0] / xs[1]\n\n    # For higher-order polynomials, use the bisection method.\n    tolerance = 1e-6\n    low = -1.0\n    high = 1.0\n    f_low = poly(xs, low)\n    f_high = poly(xs, high)\n\n    # Expand the search interval until a sign change is found or a root is hit.\n    # This assumes the problem constraints guarantee a root will be bracketed.\n    for _ in range(50):\n        if abs(f_low) < tolerance:\n            return low\n        if abs(f_high) < tolerance:\n            return high\n        \n        if f_low * f_high < 0:\n            break # Bracket found, proceed to bisection\n        \n        low *= 2.0\n        high *= 2.0\n        f_low = poly(xs, low)\n        f_high = poly(xs, high)\n    \n    # Apply the bisection method within the found (or default) interval.\n    for _ in range(100):\n        mid = (low + high) / 2.0\n        f_mid = poly(xs, mid)\n\n        if abs(f_mid) < tolerance or (high - low) / 2.0 < tolerance:\n            return mid\n\n        if f_low * f_mid < 0:\n            high = mid\n            f_high = f_mid\n        else:\n            low = mid\n            f_low = f_mid\n            \n    # Return the midpoint as the best estimate if max iterations reached.\n    return (low + high) / 2.0"}
{"task_id": "HumanEval/38", "solution": "def decode_cyclic(s: str):\n    \"\"\"\n    takes as input string encoded with encode_cyclic function. Returns decoded string.\n    \"\"\"\n    # split string to groups. Each of length 3.\n    groups = [s[(3 * i):min((3 * i + 3), len(s))] for i in range((len(s) + 2) // 3)]\n    # reverse cycle elements in each group. Unless group has fewer elements than 3.\n    groups = [(group[-1] + group[:-1]) if len(group) == 3 else group for group in groups]\n    return \"\".join(groups)"}
{"task_id": "HumanEval/36", "solution": "def fizz_buzz(n: int):\n    \"\"\"Return the number of times the digit 7 appears in integers less than n which are divisible by 11 or 13.\n    >>> fizz_buzz(50)\n    0\n    >>> fizz_buzz(78)\n    2\n    >>> fizz_buzz(79)\n    3\n    \"\"\"\n\n    class DivisibleNumber:\n        \"\"\"A helper class to check if a number is divisible by 11 or 13.\"\"\"\n        def __init__(self, number: int):\n            self.number = number\n\n        def is_divisible_by_11(self) -> bool:\n            return self.number % 11 == 0\n\n        def is_divisible_by_13(self) -> bool:\n            return self.number % 13 == 0\n\n    class DigitCounter:\n        \"\"\"A helper class to count specific digits within a number.\"\"\"\n        @staticmethod\n        def count_sevens(number: int) -> int:\n            \"\"\"Counts the occurrences of the digit '7' in the given integer.\"\"\"\n            return str(number).count('7')\n\n    total_sevens_count = 0\n    # Iterate through numbers from 1 up to n-1.\n    for i in range(1, n):\n        current_number = DivisibleNumber(i)\n        if current_number.is_divisible_by_11() or current_number.is_divisible_by_13():\n            total_sevens_count += DigitCounter.count_sevens(i)\n\n    return total_sevens_count"}
{"task_id": "HumanEval/37", "solution": "def sort_even(l: list):\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the odd indicies, while its values at the even indicies are equal\n    to the values of the even indicies of l, but sorted.\n    >>> sort_even([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_even([5, 6, 3, 4])\n    [3, 6, 5, 4]\n    \"\"\"\n    if not l:\n        return []\n\n    # Extract elements from even indices and sort them.\n    even_elements = [l[i] for i in range(0, len(l), 2)]\n    even_elements.sort()\n\n    # Create a new list for the result, preserving odd-indexed elements and inserting sorted even ones.\n    result = [0] * len(l)\n    even_sorted_idx = 0\n    for i in range(len(l)):\n        if i % 2 == 0:\n            result[i] = even_elements[even_sorted_idx]\n            even_sorted_idx += 1\n        else:\n            result[i] = l[i]\n\n    return result"}
{"task_id": "HumanEval/39", "solution": "```python\ndef prime_fib(n: int):\n    \"\"\"\n    prime_fib returns n-th number that is a Fibonacci number and it's also prime.\n    >>> prime_fib(1)\n    2\n    >>> prime_fib(2)\n    3\n    >>> prime_fib(3)\n    5\n    >>> prime_fib(4)\n    13\n    >>> prime_fib(5)\n    89\n    \"\"\"\n\n    if n <= 0:\n        raise ValueError(\"n must be a positive integer\")\n\n    class FibonacciGenerator:\n        \"\"\"Generates successive Fibonacci numbers.\"\"\"\n        def __init__(self):\n            self.a = 0\n            self.b = 1\n\n        def next(self):\n            fib = self.a\n            self.a, self.b = self.b, self.a + self.b\n            return fib\n\n    class PrimeChecker:\n        \"\"\"Checks if a number is prime.\"\"\"\n        def is_prime(self, number: int) -> bool:\n            if number < 2:\n                return False\n            for i in range(2, int(number**0.5) + 1):\n                if number % i == 0:\n                    return False\n            return True\n\n    class PrimeFibonacciSequence:\n        \"\"\"Finds the n-th prime Fibonacci number.\"\"\"\n        def __init__(self):\n            self.fib_gen = FibonacciGenerator()\n            self.prime_checker = PrimeChecker()\n\n        def get_nth_prime_fibonacci(self, n: int) -> int:\n            count = 0\n            # Skip the initial 0 and 1 which are not prime in this context\n            self.fib_gen.next() # Skip 0\n            self.fib_gen.next() # Get 1, which is not prime\n\n            while True:\n                fib_num = self.fib_gen.next()\n                if self.prime_checker.is_prime(fib_num):\n                    count += 1\n                    if count == n:\n                        return fib_num\n\n    prime_fib_seq = PrimeFibonacciSequence()\n    return prime_fib_seq.get_nth_prime_fibonacci(n)\n```"}
