portable and has a 'run' method\nfrom .cli import CLIController\nfrom .service import PairsService\nfrom .validator import InputValidator\n\nclass CLIUser:\n    \"\"\"\n    A simulated CLI user for testing the CLIController's behavior.\n    Captures stdout and stderr to verify output and exit codes.\n    \"\"\"\n    def __init__(self):\n        self.controller = CLIController(PairsService(), InputValidator())\n\n    def invoke(self, argv: Sequence[str]) -> Tuple[int, str, str]:\n        \"\"\"\n        Invokes the CLIController.run method with the given arguments,\n        capturing stdout and stderr.\n        Returns a tuple of (exit_code, stdout_output, stderr_output).\n        \"\"\"\n        original_stdout = sys.stdout\n        original_stderr = sys.stderr\n        sys.stdout = stdout_capture = StringIO()\n        sys.stderr = stderr_capture = StringIO()\n\n        try:\n            exit_code = self.controller.run(argv)\n            stdout_output = stdout_capture.getvalue()\n            stderr_output = stderr_capture.getvalue()\n            return exit_code, stdout_output, stderr_output\n        finally:\n            sys.stdout = original_stdout\n            sys.stderr = original_stderr\n\n```\n\n#### `src/pairs_zero/__init__.py`\n```python\nfrom typing import List, Optional, Tuple, Any\n\nfrom .service import PairsService\nfrom .validator import InputValidator\nfrom .exceptions import InvalidInputError\n\n__version__ = \"0.1.0\"\n\n# Initialize singletons for internal use to follow stateless design and re-use.\n_service = PairsService()\n_validator = InputValidator()\n\ndef pairs_sum_to_zero(numbers: Any) -> bool:\n    \"\"\"\n    Determines if a list of integers contains two distinct elements that sum to zero.\n    \n    Args:\n        numbers: A list-like object or string containing integer-compatible values.\n\n    Returns:\n        True if a distinct pair exists; otherwise False.\n\n    Raises:\n        InvalidInputError: If the input is not iterable, contains non-integer elements,\n                           or exceeds length limits.\n    \"\"\"\n    dto = _validator.validate_list(numbers)\n    return _service.pairs_sum_to_zero(dto.items)\n\ndef find_pair(numbers: Any) -> Optional[Tuple[int, int]]:\n    \"\"\"\n    Finds and returns one example pair (a, b) from the input list such that a + b == 0,\n    where a and b are distinct elements (different indices).\n\n    Args:\n        numbers: A list-like object or string containing integer-compatible values.\n\n    Returns:\n        A tuple (a, b) if a distinct pair summing to zero is found; otherwise None.\n\n    Raises:\n        InvalidInputError: If the input is not iterable, contains non-integer elements,\n                           or exceeds length limits.\n    \"\"\"\n    dto = _validator.validate_list(numbers)\n    return _service.find_pair(dto.items)\n\n```\n\n#### `pyproject.toml`\n```toml\n[project]\nname = \"pairs-zero\"\nversion = \"0.1.0\"\ndescription = \"A Python library and CLI to find if two distinct integers in a list sum to zero.\"\nauthors = [{ name = \"Your Name\", email = \"your.email@example.com\" }]\nlicense = \"MIT\"\nreadme = \"README.md\"\nrequires-python = \">=3.8\"\nkeywords = [\"sum\", \"zero\", \"pairs\", \"cli\", \"library\"]\nclassifiers = [\n    \"Programming Language :: Python :: 3\",\n    \"License :: OSI Approved :: MIT License\",\n    \"Operating System :: OS Independent\",\n    \"Intended Audience :: Developers\",\n    \"Topic :: Utilities\",\n]\n\n[project.urls]\nHomepage = \"https://github.com/yourusername/pairs-zero\"\nRepository = \"https://github.com/yourusername/pairs-zero\"\n\n[project.scripts]\npairs-zero = \"pairs_zero.cli:console_entrypoint\"\n\n[tool.setuptools.packages.find]\nwhere = [\"src\"]\n\n[build-system]\nrequires = [\"setuptools>=61.0\"]\nbuild-backend = \"setuptools.build_meta\"\n\n[tool.pytest.ini_options]\npythonpath = [\"src\"]\naddopts = \"--doctest-modules\" # Enable doctests for service.py\n\n[project.optional-dependencies]\ndev = [\"pytest>=7.0.0\"]\n\n```\n\n#### `README.md`\n```markdown\n# Pairs Zero\n\nA small, well-documented Python library and CLI utility that determines whether a list of integers contains two distinct elements that sum to zero.\n\n## Features\n\n- **Library API**: `pairs_sum_to_zero(numbers: List[int]) -> bool` and `find_pair(numbers: List[int]) -> Optional[Tuple[int, int]]` for use in other Python applications.\n- **CLI Utility**: `pairs-zero` command-line tool for quick checks.\n- **Robust Input Validation**: Handles various input formats and provides clear error messages.\n- **Efficient Algorithm**: O(n) average time complexity using hash sets.\n- **Testable**: Designed with clear separation of concerns, unit, and integration tests.\n\n## Installation\n\n```bash\npip install pairs-zero\n# Or if installing from source:\n# git clone https://github.com/yourusername/pairs-zero.git\n# cd pairs-zero\n# pip install .\n```\n\n## Usage\n\n### Library\n\n```python\nfrom pairs_zero import pairs_sum_to_zero, find_pair, InvalidInputError\n\n# Basic usage\nprint(pairs_sum_to_zero([2, 4, -5, 3, 5, 7]))  # Output: True\nprint(pairs_sum_to_zero([1, 3, 5, 0]))      # Output: False\nprint(pairs_sum_to_zero([0, 0, 5]))         # Output: True (two distinct zeros)\nprint(pairs_sum_to_zero([0, 5]))            # Output: False (only one zero)\n\n# Find an example pair\nprint(find_pair([2, 4, -5, 3, 5, 7]))      # Output: (5, -5) or (-5, 5)\nprint(find_pair([1, 3, 5, 0]))           # Output: None\nprint(find_pair([0, 0, 5]))              # Output: (0, 0)\n\n# Input validation\ntry:\n    pairs_sum_to_zero(\"hello world\")\nexcept InvalidInputError as e:\n    print(f\"Error: {e.message}\") # Output: Error: Invalid integer token found: 'hello'\n\ntry:\n    pairs_sum_to_zero([1, 2.5, 3])\nexcept InvalidInputError as e:\n    print(f\"Error: {e.message}\") # Output: Error: Element at index 1 is a float: 2.5. Only integers are allowed.\n\n```\n\n### Command-Line Interface (CLI)\n\n```bash\n# Pass integers as separate arguments\npairs-zero 1 2 -3 4\n# Output: False\n\npairs-zero 2 4 -5 3 5 7\n# Output: True\n\n# Pass integers as a single comma-separated string\npairs-zero \"1,2,-3,4\"\n# Output: False\n\n# Pass integers as a single whitespace-separated string\npairs-zero \"1 2 -3 4\"\n# Output: False\n\n# With two zeros\npairs-zero 0 0 5\n# Output: True\n\n# With only one zero\npairs-zero 0 5\n# Output: False\n\n# Invalid input (non-integer token)\npairs-zero 1 2 hello 4\n# Output: Error: Invalid integer token found: 'hello'\n# Exit code: 2\n\n# No arguments\npairs-zero\n# Output: Usage: pairs-zero <list_of_integers> ...\n# Exit code: 1\n```\n\n## Development\n\n### Setup\n```bash\ngit clone https://github.com/yourusername/pairs-zero.git\ncd pairs-zero\npip install --editable '.[dev]'\n```\n\n### Running Tests\n```bash\npytest\n```\nUnit tests cover `PairsService`, `InputValidator`, and integration tests validate the `CLIController`.\n\n### Code Style\nFollows PEP 8 with type hints.\n\n## License\n\nThis project is licensed under the MIT License - see the [LICENSE](LICENSE) file for details.\n\n```\n\n#### `LICENSE`\n```\nMIT License\n\nCopyright (c) 2023 Your Name\n\nPermission is hereby granted, free of charge, to any person obtaining a copy\nof this software and associated documentation files (the \"Software\"), to deal\nin the Software without restriction, including without limitation the rights\nto use, copy, modify, merge, publish, distribute, sublicense, and/or sell\ncopies of the Software, and to permit persons to whom the Software is\nfurnished to do so, subject to the following conditions:\n\nThe above copyright notice and this permission notice shall be included in all\ncopies or substantial portions of the Software.\n\nTHE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR\nIMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,\nFITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT.