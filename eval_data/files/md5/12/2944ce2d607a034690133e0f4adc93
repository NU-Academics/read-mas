{"task_id": "HumanEval/114", "solution": "def minSubArraySum(nums):\n    \"\"\"\n    Given an array of integers nums, find the minimum sum of any non-empty sub-array.\n    This uses a modified Kadane's algorithm to track current and global minimums.\n    \"\"\"\n    current_min = nums[0]\n    global_min = nums[0]\n\n    for x in nums[1:]:\n        current_min = min(x, current_min + x)\n        global_min = min(global_min, current_min)\n        \n    return global_min"}
{"task_id": "HumanEval/115", "solution": "import math\n\ndef max_fill(grid, capacity):\n    \"\"\"\n    Computes the total number of bucket-lower operations to empty all wells in the grid.\n    Each 1 in a cell represents a unit of water, and capacity is the bucket's fill limit per lower.\n    \"\"\"\n    total_lowers = 0\n    for row in grid:\n        water_in_well = sum(row)\n        if water_in_well > 0:\n            total_lowers += math.ceil(water_in_well / capacity)\n    return total_lowers"}
{"task_id": "HumanEval/114", "solution": "def minSubArraySum(nums):\n    \"\"\"\n    Given an array of integers nums, find the minimum sum of any non-empty sub-array\n    of nums.\n    \"\"\"\n    current_min_sum = nums[0]\n    overall_min_sum = nums[0]\n\n    for i in range(1, len(nums)):\n        current_min_sum = min(nums[i], current_min_sum + nums[i])\n        overall_min_sum = min(overall_min_sum, current_min_sum)\n        \n    return overall_min_sum"}
{"task_id": "HumanEval/115", "solution": "import math\n\ndef max_fill(grid, capacity):\n    \"\"\"\n    Computes the minimum number of times buckets must be lowered to empty all wells.\n    Each row is an independent well; lowerings are summed across wells.\n    \"\"\"\n    total_lowers = 0\n    for row in grid:\n        ones_in_row = sum(row)\n        # Compute ceiling division: ceil(ones_in_row / capacity)\n        lowers_for_row = math.ceil(ones_in_row / capacity)\n        total_lowers += lowers_for_row\n    return total_lowers"}
{"task_id": "HumanEval/116", "solution": "```python\ndef sort_array(arr):\n    \"\"\"\n    This function sorts an array of integers primarily by the number of 1-bits\n    in their binary representation, and secondarily by numeric value.\n    Negative numbers are sorted purely by their numeric value, placed after non-negative numbers.\n    \"\"\"\n    \n    processed_items = []\n    # Using float('inf') as a sentinel ensures negative numbers (without bit counts)\n    # are grouped and sorted after all non-negative numbers with computed bits.\n    SENTINEL_BITS = float('inf') \n\n    for value in arr:\n        if value >= 0:\n            # Python's int.bit_count() efficiently counts set bits.\n            bits = value.bit_count()\n            # Store (primary_sort_key, secondary_sort_key, original_value)\n            processed_items.append((bits, value, value))\n        else:\n            # For negative numbers, bit count is not applied; only sort by numeric value.\n            # Use the sentinel for the bits key to place them after positives.\n            processed_items.append((SENTINEL_BITS, value, value))\n\n    # Sort the items using the generated keys. Python's list.sort() is stable.\n    # The sort key is a tuple: (bit_count, numeric_value).\n    processed_items.sort(key=lambda x: (x[0], x[1]))\n\n    # Extract the original values from the sorted items.\n    return [item[2] for item in processed_items]\n```"}
{"task_id": "HumanEval/116", "solution": "```python\ndef sort_array(arr):\n    \"\"\"Sorts an array of integers by the number of 1-bits in their binary representation. Ties are broken by sorting based on decimal value.\"\"\"\n\n    def _count_bits_inline(n: int) -> int:\n        \"\"\"Counts the number of set bits in an integer.\"\"\"\n        if n >= 0:\n            return bin(n).count(\"1\")\n        # For negatives, use 32-bit two's complement representation.\n        return bin(n & 0xffffffff).count(\"1\")\n\n    # The sort key is a tuple: (number of 1-bits, the original number's value).\n    arr.sort(key=lambda x: (_count_bits_inline(x), x))\n    return arr\n```"}
{"task_id": "HumanEval/117", "solution": "def select_words(s, n):\n    \"\"\"Selects words from a string that contain exactly n consonants.\n    Vowels are a, e, i, o, u (case-insensitive); 'y' is a consonant.\n    \"\"\"\n    if not s:\n        return []\n\n    VOWELS = {\"a\", \"e\", \"i\", \"o\", \"u\"}\n    \n    result = []\n    words = s.split()\n\n    for word in words:\n        consonant_count = 0\n        for char in word:\n            lower_char = char.lower()\n            if lower_char.isalpha() and lower_char not in VOWELS:\n                consonant_count += 1\n        \n        if consonant_count == n:\n            result.append(word)\n            \n    return result"}
{"task_id": "HumanEval/117", "solution": "```python\ndef select_words(s, n):\n    \"\"\"Given a string s and a natural number n, returns a list of words from s\n    that contain exactly n consonants, preserving original order and case.\n    Consonants are all letters except a,e,i,o,u (case-insensitive); 'y' is a consonant.\n    \"\"\"\n    VOWELS = {\"a\", \"e\", \"i\", \"o\", \"u\"}\n    \n    words_with_n_consonants = []\n    \n    # Tokenize the string by splitting on spaces. This handles multiple spaces\n    # and returns an empty list for an empty input string s.\n    tokens = s.split() \n    \n    for word in tokens:\n        consonant_count = 0\n        # Iterate through characters to count consonants based on the assumption\n        # that input string contains only letters and spaces.\n        for char in word.lower():\n            if char not in VOWELS:\n                consonant_count += 1\n        \n        if consonant_count == n:\n            words_with_n_consonants.append(word)\n            \n    return words_with_n_consonants\n```"}
{"task_id": "HumanEval/119", "solution": "```python\ndef match_parens(lst):\n    \"\"\"Checks if two parenthesis-only strings can be concatenated to form a balanced string. Returns 'Yes' if possible, 'No' otherwise.\"\"\"\n\n    # Computes net balance and minimum prefix balance for a string.\n    def _metrics(s):\n        balance = 0\n        min_prefix = 0\n        for ch in s:\n            if ch == '(':\n                balance += 1\n            else:\n                balance -= 1\n            if balance < min_prefix:\n                min_prefix = balance\n        return balance, min_prefix\n\n    a, b = lst\n\n    a_net, a_min = _metrics(a)\n    b_net, b_min = _metrics(b)\n\n    # Check if A followed by B forms a balanced string.\n    ok_ab = (a_min >= 0) and (a_net + b_min >= 0) and (a_net + b_net == 0)\n\n    # Check if B followed by A forms a balanced string.\n    ok_ba = (b_min >= 0) and (b_net + a_min >= 0) and (b_net + a_net == 0)\n\n    if ok_ab or ok_ba:\n        return 'Yes'\n    else:\n        return 'No'\n```"}
{"task_id": "HumanEval/118", "solution": "def get_closest_vowel(word):\n    \"\"\"Finds the closest vowel that stands between two consonants from the right side of the word.\n    Vowels at the first and last characters are excluded; 'y' is a consonant.\n    \"\"\"\n    VOWELS = \"aeiouAEIOU\"\n    \n    n = len(word)\n    # Iterate from second to last character down to second character.\n    for i in range(n - 2, 0, -1):\n        char = word[i]\n        \n        # Check if the current character is a vowel.\n        if char in VOWELS:\n            # Check if the characters to its left and right are consonants.\n            # Assume 'word' contains only English letters as per problem statement.\n            left_char = word[i - 1]\n            right_char = word[i + 1]\n            \n            is_left_consonant = left_char.isalpha() and left_char not in VOWELS\n            is_right_consonant = right_char.isalpha() and right_char not in VOWELS\n            \n            if is_left_consonant and is_right_consonant:\n                return char\n                \n    return \"\""}
{"task_id": "HumanEval/118", "solution": "def get_closest_vowel(word):\n    \"\"\"Finds the closest vowel that stands between two consonants from the right side of the word (case sensitive).\n    Vowels in the beginning and ending do not count. Returns an empty string if no such vowel is found.\n    \"\"\"\n    VOWELS = {\"a\", \"e\", \"i\", \"o\", \"u\", \"A\", \"E\", \"I\", \"O\", \"U\"}\n\n    def _is_vowel(ch: str) -> bool:\n        \"\"\"Checks if a character is a vowel (case-sensitive).\"\"\"\n        return ch in VOWELS\n\n    def _is_consonant(ch: str) -> bool:\n        \"\"\"Checks if a character is an English consonant.\"\"\"\n        return ch.isalpha() and not _is_vowel(ch)\n\n    n = len(word)\n    # A word must have at least 3 characters to contain a vowel between two consonants,\n    # excluding the first and last positions.\n    if n < 3:\n        return \"\"\n\n    # Scan from the second-to-last character down to the second character (index 1),\n    # to find the rightmost vowel satisfying the condition.\n    for i in range(n - 2, 0, -1):\n        current_char = word[i]\n        prev_char = word[i - 1]\n        next_char = word[i + 1]\n\n        if _is_vowel(current_char) and \\\n           _is_consonant(prev_char) and \\\n           _is_consonant(next_char):\n            return current_char\n    \n    return \"\""}
{"task_id": "HumanEval/119", "solution": "def _get_balance_metrics(s: str) -> tuple[int, int]:\n    \"\"\"Computes the minimum prefix balance and total balance for a given string.\"\"\"\n    balance = 0\n    min_balance = 0\n    for char in s:\n        balance += 1 if char == '(' else -1\n        min_balance = min(min_balance, balance)\n    return min_balance, balance\n\ndef _is_balanced_concat(s1: str, s2: str) -> bool:\n    \"\"\"Checks if concatenating s1 and s2 results in a balanced string.\"\"\"\n    s1_min_balance, s1_total_balance = _get_balance_metrics(s1)\n    s2_min_balance, s2_total_balance = _get_balance_metrics(s2)\n\n    if s1_min_balance < 0:\n        return False\n    if s1_total_balance + s2_min_balance < 0:\n        return False\n    return (s1_total_balance + s2_total_balance) == 0\n\ndef match_parens(lst):\n    s1, s2 = lst[0], lst[1]\n\n    if _is_balanced_concat(s1, s2) or _is_balanced_concat(s2, s1):\n        return 'Yes'\n    else:\n        return 'No'"}
{"task_id": "HumanEval/120", "solution": "def maximum(arr, k):\n    \"\"\"\n    Given an array arr of integers and a positive integer k, return a sorted list \n    of length k with the maximum k numbers in arr.\n    \"\"\"\n    if k == 0:\n        return []\n    # Sort the array in descending order, take the top k elements, then sort them ascending.\n    top_k_elements = sorted(arr, reverse=True)[:k]\n    return sorted(top_k_elements)"}
