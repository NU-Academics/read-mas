 formatter = OutputFormatter()\n    return BaseConverter(validator, formatter)\n\nclass TestBaseConverter:\n    \"\"\"Tests for BaseConverter's conversion logic and error handling.\"\"\"\n\n    def test_convert_examples(self, default_converter):\n        \"\"\"Test conversion for specified examples.\"\"\"\n        assert default_converter.convert(8, 3) == '22'\n        assert default_converter.convert(8, 2) == '1000'\n        assert default_converter.convert(7, 2) == '111'\n        assert default_converter.convert(10, 3) == '101'\n        assert default_converter.convert(15, 8) == '17'\n\n    def test_zero_conversion(self, default_converter):\n        \"\"\"Test conversion of zero.\"\"\"\n        assert default_converter.convert(0, 2) == '0'\n        assert default_converter.convert(0, 9) == '0'\n\n    def test_large_number_conversion(self, default_converter):\n        \"\"\"Test conversion for a larger number.\"\"\"\n        assert default_converter.convert(12345, 9) == '18883'\n        assert default_converter.convert(1000, 2) == '1111101000'\n\n    def test_invalid_base_raises(self, default_converter):\n        \"\"\"Ensure InvalidBaseError is raised for out-of-range bases.\"\"\"\n        with pytest.raises(InvalidBaseError, match=\"Base must be between 2 and 9\"):\n            default_converter.convert(10, 1)\n        with pytest.raises(InvalidBaseError, match=\"Base must be between 2 and 9\"):\n            default_converter.convert(10, 10)\n\n    def test_negative_number_raises(self, default_converter):\n        \"\"\"Ensure NegativeNumberError is raised for negative numbers.\"\"\"\n        with pytest.raises(NegativeNumberError, match=\"Input number must be non-negative.\"):\n            default_converter.convert(-1, 2)\n        with pytest.raises(NegativeNumberError, match=\"Input number must be non-negative.\"):\n            default_converter.convert(-100, 9)\n\n    def test_type_error_for_non_int_x(self, default_converter):\n        \"\"\"Ensure TypeError is raised for non-integer x.\"\"\"\n        with pytest.raises(TypeError, match=\"x must be an integer\"):\n            default_converter.convert(\"8\", 3)\n        with pytest.raises(TypeError, match=\"x must be an integer\"):\n            default_converter.convert(8.0, 3)\n\n    def test_type_error_for_non_int_base(self, default_converter):\n        \"\"\"Ensure TypeError is raised for non-integer base.\"\"\"\n        with pytest.raises(TypeError, match=\"base must be an integer\"):\n            default_converter.convert(8, \"3\")\n        with pytest.raises(TypeError, match=\"base must be an integer\"):\n            default_converter.convert(8, 3.0)\n\n    def test_internal_conversion_error(self, default_converter, mocker):\n        \"\"\"Test that a ConversionError is raised for unexpected internal failures.\"\"\"\n        mocker.patch.object(default_converter.formatter, 'format', side_effect=ValueError(\"Test format error\"))\n        with pytest.raises(ConversionError, match=\"Failed to convert\"):\n            default_converter.convert(8, 3)\n\n```\n```python\n# tests/test_api.py\n\"\"\"Unit tests for the public API function change_base.\"\"\"\n\nimport pytest\nfrom src.baseconv.api import change_base\nfrom src.baseconv.errors import InvalidBaseError, NegativeNumberError, ConversionError\n\nclass TestAPI:\n    \"\"\"Tests for the public change_base API function.\"\"\"\n\n    def test_change_base_wrapper_success(self):\n        \"\"\"Tests that change_base correctly delegates and returns results.\"\"\"\n        assert change_base(8, 3) == '22'\n        assert change_base(0, 5) == '0'\n        assert change_base(123, 8) == '173'\n\n    def test_change_base_invalid_number_raises(self):\n        \"\"\"Tests that change_base propagates NegativeNumberError.\"\"\"\n        with pytest.raises(NegativeNumberError, match=\"Input number must be non-negative.\"):\n            change_base(-1, 2)\n\n    def test_change_base_invalid_base_raises(self):\n        \"\"\"Tests that change_base propagates InvalidBaseError.\"\"\"\n        with pytest.raises(InvalidBaseError, match=\"Base must be between 2 and 9 inclusive.\"):\n            change_base(10, 1)\n        with pytest.raises(InvalidBaseError, match=\"Base must be between 2 and 9 inclusive.\"):\n            change_base(10, 10)\n\n    def test_change_base_type_error_for_x(self):\n        \"\"\"Tests that change_base propagates TypeError for non-int x.\"\"\"\n        with pytest.raises(TypeError, match=\"x must be an integer\"):\n            change_base(\"10\", 3)\n\n    def test_change_base_type_error_for_base(self):\n        \"\"\"Tests that change_base propagates TypeError for non-int base.\"\"\"\n        with pytest.raises(TypeError, match=\"base must be an integer\"):\n            change_base(10, \"3\")\n\n    def test_change_base_general_conversion_error(self, mocker):\n        \"\"\"Tests propagation of generic ConversionError from service.\"\"\"\n        # Mock the internal service's convert method to raise a ConversionError\n        mocker.patch('src.baseconv.services.BaseConverter.convert', side_effect=ConversionError(\"Mocked error\"))\n        with pytest.raises(ConversionError, match=\"Mocked error\"):\n            change_base(8, 3)\n\n```\n```python\n# tests/test_cli.py\n\"\"\"Integration tests for the CLI controller and entry point.\"\"\"\n\nimport pytest\nfrom unittest.mock import patch\nfrom src.baseconv.cli import main\nfrom src.baseconv.errors import InvalidBaseError, NegativeNumberError\n\nclass TestCLI:\n    \"\"\"Tests for the baseconv CLI tool's behavior.\"\"\"\n\n    @patch('sys.exit')\n    def test_cli_success_output(self, mock_exit, capfd):\n        \"\"\"Test successful CLI execution and output.\"\"\"\n        with patch('sys.argv', ['baseconv', '8', '3']):\n            main()\n        captured = capfd.readouterr()\n        assert captured.out.strip() == '22'\n        assert captured.err == ''\n        mock_exit.assert_not_called() # main returns exit code, sys.exit not called directly\n\n        with patch('sys.argv', ['baseconv', '0', '2']):\n            main()\n        captured = capfd.readouterr()\n        assert captured.out.strip() == '0'\n        mock_exit.assert_not_called()\n\n\n    @pytest.mark.parametrize(\"args, error_message_part\", [\n        (['-1', '2'], \"Negative number\"),\n        (['10', '1'], \"Invalid base\"),\n        (['10', '10'], \"Invalid base\"),\n        (['foo', '2'], \"invalid int value: 'foo'\"),\n        (['10', 'bar'], \"invalid int value: 'bar'\"),\n        (['10'], \"the following arguments are required: base\"), # argparse error\n        ([], \"the following arguments are required: number, base\"), # argparse error\n    ])\n    @patch('sys.exit') # Mock sys.exit to prevent actual exit in test\n    def test_cli_error_output_and_exit_code(self, mock_exit, capfd, args, error_message_part):\n        \"\"\"Test CLI error cases: output to stderr and exit code 2.\"\"\"\n        with patch('sys.argv', ['baseconv'] + args):\n            # CLIController.run returns the exit code directly\n            exit_code = main()\n\n        captured = capfd.readouterr()\n        assert error_message_part in captured.err\n        assert captured.out == ''\n        assert exit_code == 2 # FR2: exit code 2 on error\n\n    @patch('sys.exit')\n    @patch('src.baseconv.services.BaseConverter.convert', side_effect=Exception(\"Unexpected service error\"))\n    def test_cli_unexpected_error_exit_code(self, mock_convert, mock_exit, capfd):\n        \"\"\"Test CLI behavior for an unexpected internal error.\"\"\"\n        with patch('sys.argv', ['baseconv', '8', '3']):\n            exit_code = main()\n        captured = capfd.readouterr()\n        assert \"An unexpected error occurred\" in captured.err\n        assert exit_code == 1 # CLIController returns 1 for unexpected errors, 2 for user errors\n\n```"}
{"task_id": "HumanEval/44", "solution": "def change_base(x: int, base: int) -> str:\n    \"\"\"Change numerical base of input number x to base.\n    Returns string representation after the conversion.\n    \"\"\"\n    if x == 0:\n        return \"0\"\n\n    digits = []\n    while x > 0:\n        remainder = x % base\n        digits.append(str(remainder))\n        x //= base\n\n    return \"\".join(digits[::-1])"}
