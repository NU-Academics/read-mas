{"task_id": "HumanEval/55", "solution": "def _fast_doubling(n: int) -> tuple[int, int]:\n    \"\"\"Internal helper to compute (F_n, F_{n+1}) using fast doubling.\n    Base case for n=0 returns (0, 1), corresponding to F_0=0, F_1=1.\n    \"\"\"\n    if n == 0:\n        return (0, 1)\n    \n    (a, b) = _fast_doubling(n >> 1) # Recursively compute F_k and F_{k+1} where k = n // 2\n    \n    c = a * (2 * b - a)             # F_{2k} = F_k * (2 * F_{k+1} - F_k)\n    d = a * a + b * b               # F_{2k+1} = F_k^2 + F_{k+1}^2\n    \n    if n & 1:                       # If n is odd (n = 2k + 1)\n        return (d, c + d)           # Returns (F_{2k+1}, F_{2k+2})\n    else:                           # If n is even (n = 2k)\n        return (c, d)               # Returns (F_{2k}, F_{2k+1})\n\ndef fib(n: int) -> int:\n    \"\"\"Return n-th Fibonacci number (1-indexed).\n    Uses the fast doubling method for O(log n) performance.\n    \"\"\"\n    return _fast_doubling(n)[0]"}
{"task_id": "HumanEval/56", "solution": "def correct_bracketing(brackets: str):\n    \"\"\"Checks if a string of '<' and '>' characters is properly balanced.\n    Returns True if every opening bracket has a corresponding closing bracket, False otherwise.\n    \"\"\"\n    counter = 0\n    for char in brackets:\n        if char == \"<\":\n            counter += 1\n        else:\n            counter -= 1\n        if counter < 0:\n            return False\n    return counter == 0"}
{"task_id": "HumanEval/55", "solution": "```python\ndef fib(n: int):\n    \"\"\"Return n-th Fibonacci number using a fast-doubling algorithm.\"\"\"\n\n    def _fd(k: int) -> tuple[int, int]:\n        if k == 0:\n            return (0, 1)\n        \n        a, b = _fd(k // 2)\n        c = a * (2 * b - a)  # F(2k) = F(k) * (2*F(k+1) - F(k))\n        d = a * a + b * b    # F(2k+1) = F(k)^2 + F(k+1)^2\n        \n        if k % 2 == 0:\n            return (c, d)\n        else:\n            return (d, c + d) # F(2k+1), F(2k+2)\n\n    return _fd(n)[0]\n```"}
