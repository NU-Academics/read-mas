{"task_id": "HumanEval/7", "solution": "```\n## File: src/stringfilter/__init__.py\n```python\n\"\"\"\nStringFilter: A library and service for filtering lists of strings by substring.\n\"\"\"\n\nfrom .exceptions import InvalidInputError, PersistenceError\nfrom .models import FilterCriteria, FilterResult\nfrom .utils import filter_by_substring\nfrom .services import FilterService\nfrom .api_app import create_app\n\n__version__ = \"0.1.0\"\n\n__all__ = [\n    \"__version__\",\n    \"filter_by_substring\",\n    \"FilterCriteria\",\n    \"FilterResult\",\n    \"FilterService\",\n    \"create_app\",\n    \"InvalidInputError\",\n    \"PersistenceError\",\n]\n```\n\n## File: src/stringfilter/exceptions.py\n```python\n\"\"\"\nDomain-specific exceptions for the StringFilter application.\n\"\"\"\n\nclass InvalidInputError(Exception):\n    \"\"\"\n    Raised when input validation fails.\n    This includes incorrect types, sizes, or other business rule violations.\n    \"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\nclass PersistenceError(Exception):\n    \"\"\"\n    Raised when there's an issue with data persistence operations.\n    For example, errors during file writing for audit logs.\n    \"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n```\n\n## File: src/stringfilter/models.py\n```python\n\"\"\"\nDomain DTOs for data transfer within the StringFilter application.\n\"\"\"\nfrom typing import List\n\nclass FilterCriteria:\n    \"\"\"\n    Encapsulates the criteria for a filtering operation.\n    It holds the list of strings to be filtered and the substring to match.\n    \"\"\"\n    def __init__(self, strings: List[str], substring: str) -> None:\n        self.strings = strings\n        self.substring = substring\n\nclass FilterResult:\n    \"\"\"\n    Represents the outcome of a filtering operation,\n    including the filtered list and counts.\n    \"\"\"\n    def __init__(self, filtered: List[str], original_count: int) -> None:\n        self.filtered = filtered\n        self.original_count = original_count\n        self.filtered_count = len(filtered)\n```\n\n## File: src/stringfilter/config.py\n```python\n\"\"\"\nConfiguration values for the StringFilter application.\n\"\"\"\nimport os\nfrom typing import Optional\n\n# Default limits for input validation\nDEFAULT_MAX_ITEMS: int = 10000\nDEFAULT_MAX_STRING_LENGTH: int = 4096\n\n# Default path for audit logs\nDEFAULT_AUDIT_PATH: str = \"audit.log\"\n\n# Environment variable name for API key\nAPI_KEY_ENV: str = \"STRINGFILTER_API_KEY\"\n\ndef get_api_key_from_env() -> Optional[str]:\n    \"\"\"Retrieves the API key from environment variables.\"\"\"\n    return os.getenv(API_KEY_ENV)\n```\n\n## File: src/stringfilter/utils.py\n```python\n\"\"\"\nPure utility functions for string filtering and validation.\n\"\"\"\nfrom typing import List\nimport sys\n\nfrom .exceptions import InvalidInputError\n\nCHUNK_SIZE: int = 1024\n\ndef filter_by_substring(strings: List[str], substring: str) -> List[str]:\n    \"\"\" Filter an input list of strings only for ones that contain given substring\n    >>> filter_by_substring([], 'a')\n    []\n    >>> filter_by_substring(['abc', 'bacd', 'cde', 'array'], 'a')\n    ['abc', 'bacd', 'array']\n    \"\"\"\n    # As per FR1, raise InvalidInputError for invalid types.\n    if not isinstance(strings, list) or not all(isinstance(s, str) for s in strings):\n        raise InvalidInputError(\"Input 'strings' must be a List[str].\")\n    if not isinstance(substring, str):\n        raise InvalidInputError(\"Input 'substring' must be a str.\")\n\n    if substring == \"\":\n        return list(strings) # Return a shallow copy if empty substring\n    return [s for s in strings if substring in s]\n\ndef validate_strings(strings: List[str], max_items: int, max_length: int) -> None:\n    \"\"\"\n    Validates the list of strings against maximum item count and string length.\n    Raises InvalidInputError if any validation rule is violated.\n    \"\"\"\n    if not isinstance(strings, list):\n        raise InvalidInputError(\"Input 'strings' must be a list.\")\n    if len(strings) > max_items:\n        raise InvalidInputError(f\"Input list exceeds maximum allowed items: {max_items}\")\n    for i, s in enumerate(strings):\n        if not isinstance(s, str):\n            raise InvalidInputError(f\"Item at index {i} is not a string.\")\n        if len(s) > max_length:\n            raise InvalidInputError(f\"String at index {i} exceeds maximum allowed length: {max_length}\")\n\ndef read_lines_from_file(path: str) -> List[str]:\n    \"\"\"\n    Reads lines from a file or stdin, stripping newline characters.\n    Handles UTF-8 decoding.\n    \"\"\"\n    if path == \"-\":\n        # Read from stdin\n        lines = [line.strip() for line in sys.stdin]\n    else:\n        # Read from file\n        with open(path, 'r', encoding='utf-8') as f:\n            lines = [line.strip() for line in f]\n    return lines\n```\n\n## File: src/stringfilter/repositories.py\n```python\n\"\"\"\nPersistence adapter for auditing requests and responses.\nUses a file-based NDJSON format.\n\"\"\"\nimport json\nimport tempfile\nimport os\nimport datetime\nimport logging\n\nfrom .exceptions import PersistenceError\n\nlogger = logging.getLogger(__name__)\n\nclass PersistenceRepository:\n    \"\"\"\n    Handles appending audit entries to a newline-delimited JSON file.\n    It ensures atomicity using a temporary file and rename strategy.\n    \"\"\"\n    DEFAULT_AUDIT_PATH = \"audit.log\"\n\n    def __init__(self, path: str = None) -> None:\n        self.path = path if path is not None else self.DEFAULT_AUDIT_PATH\n        # Ensure the directory for the audit log exists\n        audit_dir = os.path.dirname(self.path)\n        if audit_dir: # Only create if path includes a directory\n            os.makedirs(audit_dir, exist_ok=True)\n\n    def append_audit(self, entry: dict) -> None:\n        \"\"\"\n        Appends a JSON-serialized entry to the audit file.\n        Uses a tempfile and os.replace for atomic writes.\n        \"\"\"\n        try:\n            # Get the directory of the target file for the temporary file\n            folder = os.path.dirname(self.path) or \".\"\n            with tempfile.NamedTemporaryFile(\"w\", dir=folder, delete=False, encoding='utf-8') as tf:\n                # Use default=str for non-JSON serializable types like datetime\n                json_line = json.dumps(entry, default=str, ensure_ascii=False) + \"\\n\"\n                tf.write(json_line)\n            # Atomically replace the old file with the new one\n            os.replace(tf.name, self.path)\n        except OSError as e:\n            logger.error(f\"Failed to append audit entry to {self.path}: {e}\")\n            raise PersistenceError(f\"Failed to write audit log: {e}\")\n        except TypeError as e:\n            logger.error(f\"Failed to serialize audit entry: {e}\")\n            raise PersistenceError(f\"Failed to serialize audit log entry: {e}\")\n```\n\n## File: src/stringfilter/schemas.py\n```python\n\"\"\"\nPydantic models for API request and response validation/serialization.\n\"\"\"\nfrom typing import List\nfrom pydantic import BaseModel, Field\n\nclass FilterRequest(BaseModel):\n    \"\"\"\n    Schema for the HTTP POST /filter request body.\n    \"\"\"\n    strings: List[str] = Field(..., description=\"List of strings to filter.\")\n    substring: str = Field(..., description=\"Substring to search for in the list of strings.\")\n\nclass FilterResponse(BaseModel):\n    \"\"\"\n    Schema for the HTTP POST /filter success response body.\n    \"\"\"\n    filtered: List[str] = Field(..., description=\"The list of strings that contain the substring, in original order.\")\n    original_count: int = Field(..., description=\"The total number of strings in the original input list.\")\n    filtered_count: int = Field(..., description=\"The number of strings returned in the filtered list.\")\n\nclass ErrorResponse(BaseModel):\n    \"\"\"\n    Schema for HTTP error responses.\n    \"\"\"\n    error: str = Field(..., description=\"A descriptive error message.\")\n    code: int = Field(..., description=\"A numeric error code, typically HTTP status code.\")\n```\n\n## File: src/stringfilter/services.py\n```python\n\"\"\"\nBusiness logic and orchestration layer for string filtering.\nHandles validation, applies business rules, and integrates with persistence.\n\"\"\"\nimport datetime\nimport logging\nfrom typing import Optional, Dict, Any, List\n\nfrom .models import FilterCriteria, FilterResult\nfrom . import utils\nfrom .exceptions import InvalidInputError, PersistenceError\nfrom .repositories import PersistenceRepository\nfrom .config import DEFAULT_MAX_ITEMS, DEFAULT_MAX_STRING_LENGTH\n\nlogger = logging.getLogger(__name__)\n\nclass FilterService:\n    \"\"\"\n    The core service providing business logic for filtering strings.\n    It performs validation, executes filtering, and optionally audits operations.\n    \"\"\"\n    def __init__(\n        self,\n        max_items: int = DEFAULT_MAX_ITEMS,\n        max_length: int = DEFAULT_MAX_STRING_LENGTH,\n        repository: Optional[PersistenceRepository] = None\n    ) -> None:\n        self.max_items = max_items\n        self.max_length = max_length\n        self.repository = repository\n\n    def validate_and_filter(self, criteria: FilterCriteria) -> FilterResult:\n        \"\"\"\n        Validates input criteria, applies business rules, and filters the strings.\n        Optionally logs the operation through a persistence repository.\n        \"\"\"\n        start_time = datetime.datetime.now(datetime.timezone.utc)\n        try:\n            # Validate business rules using utils.validate_strings\n            utils.validate_strings(criteria.strings, self.max_items, self.max_length)\n\n            # Perform the core filtering\n            filtered = utils.filter_by_substring(criteria.strings, criteria.substring)\n\n            result = FilterResult(filtered=filtered, original_count=len(criteria.strings))\n\n            if self.repository:\n                end_time = datetime.datetime.now(datetime.timezone.utc)\n                duration_ms = (end_time - start_time).total_seconds() * 1000\n                self._audit(criteria, result, duration_ms)\n\n            return result\n        except InvalidInputError as e:\n            logger.warning(f\"Validation failed: {e.message}\")\n            raise # Re-raise to be handled by controller/CLI\n        except Exception as e:\n            logger.exception(f\"An unexpected error occurred during filtering: {e}\")\n            raise # Re-raise for general error handling\n\n    def _audit(self, criteria: FilterCriteria, result: FilterResult, duration_ms: float) -> None:\n        \"\"\"\n        Internal method to log the filtering operation using the configured repository.\n        Audit failures are logged but do not prevent the filtering result from being returned.\n        \"\"\"\n        if self.repository is None:\n            return\n\n        # Define sampling logic for audit logs\n        SAMPLE_SIZE = 5 # Number of initial items to include in audit\n        sample_input: Optional[List[str]] = None\n        if criteria.strings and len(criteria.strings) > 0:\n            sample_input = criteria.strings[:SAMPLE_SIZE] if len(criteria.strings) > SAMPLE_SIZE else criteria.strings\n\n        sample_output: Optional[List[str]] = None\n        if result.filtered and len(result.filtered) > 0:\n            sample_output = result.filtered[:SAMPLE_SIZE] if len(result.filtered) > SAMPLE_SIZE else result.filtered\n\n        audit_entry: Dict[str, Any] = {\n            \"timestamp\": datetime.datetime.now(datetime.timezone.utc),\n            \"request\": {\n                \"strings_count\": len(criteria.strings),\n                \"substring\": criteria.substring,\n                \"sample_input\": sample_input,\n            },\n            \"response\": {\n                \"filtered_count\": result.filtered_count,\n                \"original_count\": result.original_count,\n                \"sample_output\": sample_output,\n            },\n            \"duration_ms\": round(duration_ms, 2)\n        }\n        try:\n            self.repository.append_audit(audit_entry)\n            logger.debug(\"Audit entry successfully appended.\")\n        except PersistenceError as e:\n            logger.error(f\"Audit log persistence failed: {e.message}. Filtering operation continued.\")\n        except Exception as e:\n            logger.error(f\"An unexpected error occurred during auditing: {e}. Filtering operation continued.\")\n```\n\n## File: src/stringfilter/controllers.py\n```python\n\"\"\"\nFastAPI controller for handling HTTP requests and mapping them to the FilterService.\nManages API routes, request/response schemas, and authentication.\n\"\"\"\nimport logging\nfrom typing import Optional\n\nfrom fastapi import FastAPI, Header, HTTPException, status\nfrom fastapi.responses import JSONResponse\nfrom pydantic import ValidationError\n\nfrom .schemas import FilterRequest, FilterResponse, ErrorResponse\nfrom .models import FilterCriteria\nfrom .services import FilterService\nfrom .exceptions import InvalidInputError, PersistenceError # Import PersistenceError for logging\n\nlogger = logging.getLogger(__name__)\n\nclass APIController:\n    \"\"\"\n    Registers API routes for a FastAPI application, handling request parsing,\n    service calls, authentication, and response formatting.\n    \"\"\"\n    def __init__(self, app: FastAPI, service: FilterService, api_key: Optional[str] = None) -> None:\n        self.app = app\n        self.service = service\n        self.api_key = api_key\n        self.register_routes()\n\n    def _auth(self, x_api_key: Optional[str]) -> None:\n        \"\"\"\n        Authenticates requests using an optional API key header.\n        Raises HTTPException 401 if authentication fails.\n        \"\"\"\n        if self.api_key: # API key authentication is enabled\n            if x_api_key is None:\n                logger.warning(\"API key required but not provided.\")\n                raise HTTPException(\n                    status_code=status.HTTP_401_UNAUTHORIZED,\n                    detail=\"API key required\",\n                    headers={\"WWW-Authenticate\": \"Bearer\"},\n                )\n            if x_api_key != self.api_key:\n                logger.warning(\"Invalid API key provided.\")\n                raise HTTPException(\n                    status_code=status.HTTP_401_UNAUTHORIZED,\n                    detail=\"Invalid API key\",\n                    headers={\"WWW-Authenticate\": \"Bearer\"},\n                )\n\n    def register_routes(self) -> None:\n        \"\"\"\n        Registers the `/filter` endpoint with the FastAPI application.\n        \"\"\"\n        @self.app.post(\n            \"/filter\",\n            response_model=FilterResponse,\n            responses={\n                status.HTTP_400_BAD_REQUEST: {\"model\": ErrorResponse, \"description\": \"Invalid input provided\"},\n                status.HTTP_401_UNAUTHORIZED: {\"model\": ErrorResponse, \"description\": \"Authentication required/failed\"},\n                status.HTTP_500_INTERNAL_SERVER_ERROR: {\"model\": ErrorResponse, \"description\": \"Server error\"},\n            },\n            summary=\"Filter a list of strings by substring\",\n            description=\"Accepts a list of strings and a substring, returning only matching strings.\",\n        )\n        async def filter_endpoint(\n            payload: FilterRequest,\n            x_api_key: Optional[str] = Header(None, description=\"Optional API key for authentication\")\n        ) -> JSONResponse:\n            \"\"\"\n            HTTP POST endpoint for filtering strings.\n            \"\"\"\n            try:\n                self._auth(x_api_key)\n\n                criteria = FilterCriteria(strings=payload.strings, substring=payload.substring)\n                result = self.service.validate_and_filter(criteria)\n\n                return JSONResponse(\n                    status_code=status.HTTP_200_OK,\n                    content=FilterResponse(\n                        filtered=result.filtered,\n                        original_count=result.original_count,\n                        filtered_count=result.filtered_count\n                    ).model_dump()\n                )\n            except InvalidInputError as e:\n                logger.info(f\"Bad request: {e.message}\")\n                return JSONResponse(\n                    status_code=status.HTTP_400_BAD_REQUEST,\n                    content=ErrorResponse(error=e.message, code=status.HTTP_400_BAD_REQUEST).model_dump()\n                )\n            except HTTPException as e:\n                # FastAPI HTTPExceptions are already structured for response\n                raise e\n            except ValidationError as e:\n                # Pydantic validation errors are typically handled by FastAPI automatically as 422,\n                # but explicit handling ensures consistent error response structure if needed.\n                logger.warning(f\"Pydantic validation error: {e.errors()}\")\n                return JSONResponse(\n                    status_code=status.HTTP_422_UNPROCESSABLE_ENTITY,\n                    content=ErrorResponse(error=\"Validation Error\", code=status.HTTP_422_UNPROCESSABLE_ENTITY).model_dump()\n                )\n            except Exception as e:\n                logger.exception(f\"An unexpected internal server error occurred: {e}\")\n                return JSONResponse(\n                    status_code=status.HTTP_500_INTERNAL_SERVER_ERROR,\n                    content=ErrorResponse(error=\"Internal Server Error\", code=status.HTTP_500_INTERNAL_SERVER_ERROR).model_dump()\n                )\n\n        # Basic health check endpoint\n        @self.app.get(\"/health\", status_code=status.HTTP_200_OK, summary=\"Health check\")\n        async def health_check():\n            return {\"status\": \"ok\", \"version\": self.app.version}\n```\n\n## File: src/stringfilter/cli.py\n```python\n\"\"\"\nCLI adapter for the StringFilter application.\nParses command-line arguments and interfaces with the FilterService.\n\"\"\"\nimport argparse\nimport json\nimport sys\nimport logging\nfrom typing import List, Optional\n\nfrom .models import FilterCriteria\nfrom .services import FilterService\nfrom .utils import read_lines_from_file\nfrom .exceptions import InvalidInputError, PersistenceError\nfrom .config import (\n    DEFAULT_MAX_ITEMS,\n    DEFAULT_MAX_STRING_LENGTH,\n    DEFAULT_AUDIT_PATH\n)\n\nlogger = logging.getLogger(__name__)\n\nclass CLI:\n    \"\"\"\n    Command Line Interface for the StringFilter.\n    It handles argument parsing, input reading, service interaction, and output formatting.\n    \"\"\"\n    def __init__(self, service: FilterService) -> None:\n        self.service = service\n\n    def run(self, args: Optional[List[str]] = None) -> int:\n        \"\"\"\n        Parses command-line arguments and executes the filtering logic.\n        Returns an exit code (0 for success, non-zero for errors).\n        \"\"\"\n        parser = argparse.ArgumentParser(\n            prog=\"stringfilter\",\n            description=\"Filter a list of strings by substring from file or stdin.\",\n            epilog=\"Example: echo 'apple\\\\nbanana' | stringfilter filter --input - --substring app\"\n        )\n        subparsers = parser.add_subparsers(dest=\"command\", help=\"Available commands\")\n\n        # 'filter' command parser\n        filter_parser = subparsers.add_parser(\n            \"filter\",\n            help=\"Filter strings by a substring.\",\n            description=\"Reads strings from a file or stdin, filters them, and prints JSON result to stdout.\"\n        )\n        filter_parser.add_argument(\n            \"--input\",\n            \"-i\",\n            required=True,\n            help=\"Path to the input file (UTF-8). Use '-' to read from stdin.\"\n        )\n        filter_parser.add_argument(\n            \"--substring\",\n            \"-s\",\n            required=True,\n            help=\"The substring to filter by. Empty string matches all lines.\"\n        )\n        filter_parser.add_argument(\n            \"--max-items\",\n            type=int,\n            default=DEFAULT_MAX_ITEMS,\n            help=f\"Maximum number of strings allowed in the input list (default: {DEFAULT_MAX_ITEMS}).\"\n        )\n        filter_parser.add_argument(\n            \"--max-length\",\n            type=int,\n            default=DEFAULT_MAX_STRING_LENGTH,\n            help=f\"Maximum length of individual strings allowed (default: {DEFAULT_MAX_STRING_LENGTH}).\"\n        )\n        filter_parser.add_argument(\n            \"--audit-path\",\n            type=str,\n            default=DEFAULT_AUDIT_PATH,\n            help=f\"Path for the audit log file (default: {DEFAULT_AUDIT_PATH}). Set to '' to disable audit.\"\n        )\n\n        ns = parser.parse_args(args)\n\n        if ns.command == \"filter\":\n            try:\n                # Update service configuration if CLI args provided\n                self.service.max_items = ns.max_items\n                self.service.max_length = ns.max_length\n                if ns.audit_path != '':\n                    # Ensure repository is configured if audit_path is set\n                    if not self.service.repository or self.service.repository.path != ns.audit_path:\n                        self.service.repository = PersistenceRepository(ns.audit_path)\n                else:\n                    self.service.repository = None # Disable audit if empty path\n\n                lines = read_lines_from_file(ns.input)\n                criteria = FilterCriteria(strings=lines, substring=ns.substring)\n                result = self.service.validate_and_filter(criteria)\n\n                output_json = {\n                    \"filtered\": result.filtered,\n                    \"original_count\": result.original_count,\n                    \"filtered_count\": result.filtered_count\n                }\n                print(json.dumps(output_json, indent=2))\n                return 0\n            except InvalidInputError as e:\n                logger.error(f\"Validation Error: {e.message}\")\n                print(json.dumps({\"error\": e.message, \"code\": 2}), file=sys.stderr)\n                return 2 # Exit code for validation error\n            except FileNotFoundError:\n                logger.error(f\"Input file not found: {ns.input}\")\n                print(json.dumps({\"error\": f\"Input file not found: {ns.input}\", \"code\": 1}), file=sys.stderr)\n                return 1 # Exit code for file error\n            except UnicodeDecodeError:\n                logger.error(f\"Error decoding file {ns.input}. Ensure it is UTF-8 encoded.\")\n                print(json.dumps({\"error\": f\"Error decoding file {ns.input}. Ensure it is UTF-8 encoded.\", \"code\": 1}), file=sys.stderr)\n                return 1 # Exit code for file error\n            except Exception as e:\n                logger.exception(f\"An unexpected error occurred: {e}\")\n                print(json.dumps({\"error\": f\"An unexpected error occurred: {e}\", \"code\": 1}), file=sys.stderr)\n                return 1 # Generic error code\n        else:\n            parser.print_help()\n            return 1 # No command given or unknown command\n\ndef main():\n    \"\"\"\n    Main entry point for the CLI.\n    Initializes the service and runs the CLI.\n    \"\"\"\n    # Configure basic logging for CLI errors\n    logging.basicConfig(level=logging.INFO, format='%(levelname)s: %(message)s')\n\n    # CLI uses the service, optionally with persistence\n    service = FilterService() # Repository will be set/unset based on --audit-path\n    cli = CLI(service)\n    sys.exit(cli.run())\n\nif __name__ == \"__main__\":\n    main()\n```\n\n## File: src/stringfilter/api_app.py\n```python\n\"\"\"\nFactory function to create and configure the FastAPI application.\nHandles dependency injection and wiring up components.\n\"\"\"\nimport logging\nfrom typing import Optional, Dict, Any\n\nfrom fastapi import FastAPI\nfrom starlette.middleware.cors import CORSMiddleware\n\nfrom .controllers import APIController\nfrom .services import FilterService\nfrom .repositories import PersistenceRepository\nfrom .config import (\n    DEFAULT_MAX_ITEMS,\n    DEFAULT_MAX_STRING_LENGTH,\n    DEFAULT_AUDIT_PATH,\n    get_api_key_from_env,\n)\nfrom . import __version__ as app_version\n\nlogger = logging.getLogger(__name__)\n\ndef create_app(config: Optional[Dict[str, Any]] = None) -> FastAPI:\n    \"\"\"\n    Creates and configures the FastAPI application instance.\n    Injects dependencies like FilterService and PersistenceRepository based on configuration.\n    \"\"\"\n    if config is None:\n        config = {}\n\n    app = FastAPI(\n        title=\"StringFilter API\",\n        description=\"API for filtering lists of strings by substring.\",\n        version=app_version,\n        docs_url=\"/docs\",\n        redoc_url=\"/redoc\",\n        openapi_url=\"/openapi.json\",\n    )\n\n    # Configure logging for the application\n    logging.basicConfig(level=logging.INFO, format='%(asctime)s - %(name)s - %(levelname)s - %(message)s')\n    logger.info(\"Initializing StringFilter API application...\")\n\n    # Optional CORS middleware for browser-based clients\n    app.add_middleware(\n        CORSMiddleware,\n        allow_origins=[\"*\"],  # Adjust this in production!\n        allow_credentials=True,\n        allow_methods=[\"*\"],\n        allow_headers=[\"*\"],\n    )\n\n    # Initialize PersistenceRepository if audit is enabled\n    audit_path = config.get(\"AUDIT_PATH\", DEFAULT_AUDIT_PATH)\n    repository: Optional[PersistenceRepository] = None\n    if audit_path:\n        try:\n            repository = PersistenceRepository(path=audit_path)\n            logger.info(f\"Audit logging enabled to: {audit_path}\")\n        except Exception as e:\n            logger.error(f\"Failed to initialize PersistenceRepository at {audit_path}: {e}\")\n            repository = None # Disable audit if initialization fails\n\n    # Initialize FilterService with configuration and repository\n    service = FilterService(\n        max_items=config.get(\"MAX_ITEMS\", DEFAULT_MAX_ITEMS),\n        max_length=config.get(\"MAX_STRING_LENGTH\", DEFAULT_MAX_STRING_LENGTH),\n        repository=repository\n    )\n    logger.info(f\"FilterService initialized with max_items={service.max_items}, max_length={service.max_length}\")\n\n    # Get API key from environment for the controller\n    api_key = config.get(\"API_KEY\", get_api_key_from_env())\n    if api_key:\n        logger.info(\"API key authentication is enabled.\")\n    else:\n        logger.info(\"API key authentication is disabled.\")\n\n    # Initialize and register APIController routes\n    APIController(app=app, service=service, api_key=api_key)\n\n    logger.info(\"StringFilter API application initialized successfully.\")\n    return app\n\n# This allows 'uvicorn stringfilter.api_app:create_app --factory' to work\nif __name__ == \"__main__\":\n    import uvicorn\n    # Example usage for local development:\n    # Uvicorn will call create_app() to get the app instance\n    uvicorn.run(\"stringfilter.api_app:create_app\", host=\"0.0.0.0\", port=8000, reload=True, factory=True)\n```\n\n## File: pyproject.toml\n```toml\n[project]\nname = \"stringfilter\"\nversion = \"0.1.0\"\ndescription = \"A Python library and lightweight service for filtering lists of strings by substring.\"\nreadme = \"README.md\"\nauthors = [\n    { name = \"Your Name\", email = \"you@example.com\" },\n]\nlicense = { text = \"MIT\" }\nrequires-python = \">=3.9\"\nclassifiers = [\n    \"Programming Language :: Python :: 3\",\n    \"License :: OSI Approved :: MIT License\",\n    \"Operating System :: OS Independent\",\n    \"Development Status :: 3 - Alpha\",\n    \"Intended Audience :: Developers\",\n]\ndependencies = [\n    \"fastapi>=0.110.0\",\n    \"pydantic>=2.0.0\",\n    \"uvicorn[standard]>=0.27.0\", # [standard] includes httptools and watchgod for reload\n]\n\n[project.urls]\nHomepage = \"https://github.com/yourusername/stringfilter\"\n\"Bug Tracker\" = \"https://github.com/yourusername/stringfilter/issues\"\n\n[project.scripts]\nstringfilter = \"stringfilter.cli:main\"\n\n[tool.setuptools.packages.find]\nwhere = [\"src\"]\n\n[build-system]\nrequires = [\"setuptools>=61.0\"]\nbuild-backend = \"setuptools.build_meta\"\n\n[tool.pytest.ini_options]\npythonpath = [\"src\"]\n```\n\n## File: README.md\n```markdown\n# StringFilter\n\nA reliable, well-tested Python library and lightweight service for filtering lists of strings by substring.\n\n## Table of Contents\n\n- [Features](#features)\n- [Installation](#installation)\n- [Usage](#usage)\n  - [As a Library](#as-a-library)\n  - [CLI](#cli)\n  - [HTTP API](#http-api)\n- [Configuration](#configuration)\n- [Development](#development)\n- [Contributing](#contributing)\n- [License](#license)\n\n## Features\n\n- **Core Library**: `filter_by_substring` function for efficient string filtering.\n- **Service Layer**: `FilterService` with validation, business rules (e.g., max list size, string length), and optional audit logging.\n- **CLI Tool**: `stringfilter` command to filter strings from files or stdin, outputting JSON.\n- **HTTP API**: A minimal FastAPI service (`POST /filter`) for programmatic access.\n- **Extensible**: Designed for easy addition of other filters, persistence options.\n- **Production-Ready**: Includes configuration, logging, and a project structure ready for CI/CD.\n\n## Installation\n\n### Using pip\n\n```bash\npip install stringfilter\n```\n(Replace `stringfilter` with your actual package name if different, or build from source)\n\n### From source\n\n1. Clone the repository:\n   ```bash\n   git clone https://github.com/yourusername/stringfilter.git\n   cd stringfilter\n   ```\n2. Install in editable mode (for development) or as a package:\n   ```bash\n   pip install -e .\n   # or for production deployment\n   pip install .\n   ```\n\n## Usage\n\n### As a Library\n\nYou can directly import and use the `filter_by_substring` function or the `FilterService` in your Python code.\n\n```python\nfrom stringfilter import filter_by_substring, FilterService, FilterCriteria, InvalidInputError\n\n# Using the pure function\nstrings = [\"apple\", \"banana\", \"grape\", \"pineapple\"]\nsubstring = \"ap\"\nfiltered_list = filter_by_substring(strings, substring)\nprint(f\"Filtered (pure function): {filtered_list}\")\n# Expected: ['apple', 'grape', 'pineapple']\n\n# Using the service with validation and business rules\nservice = FilterService(max_items=100, max_length=50)\ncriteria = FilterCriteria(strings=strings, substring=substring)\n\ntry:\n    result = service.validate_and_filter(criteria)\n    print(f\"Filtered (service): {result.filtered}\")\n    print(f\"Original count: {result.original_count}, Filtered count: {result.filtered_count}\")\n    # Expected: ['apple', 'grape', 'pineapple']\nexcept InvalidInputError as e:\n    print(f\"Error: {e.message}\")\n\n# Example with audit logging\n# Create a temporary audit file\n# from stringfilter.repositories import PersistenceRepository\n# repo = PersistenceRepository(path=\"my_audit.log\")\n# service_with_audit = FilterService(repository=repo)\n# result_audited = service_with_filter.validate_and_filter(criteria)\n# print(f\"Audit log written to my_audit.log\")\n```\n\n### CLI\n\nThe `stringfilter` command is installed when you install the package.\n\n**Read from a file:**\n\nCreate a file `my_strings.txt`:\n```\napple\nbanana\ngrape\npineapple\n```\n\n```bash\nstringfilter filter --input my_strings.txt --substring \"ap\"\n```\nOutput:\n```json\n{\n  \"filtered\": [\n    \"apple\",\n    \"grape\",\n    \"pineapple\"\n  ],\n  \"original_count\": 4,\n  \"filtered_count\": 3\n}\n```\n\n**Read from stdin:**\n\n```bash\necho -e \"apple\\nbanana\\ngrape\\npineapple\" | stringfilter filter --input - --substring \"ap\"\n```\nOutput:\n```json\n{\n  \"filtered\": [\n    \"apple\",\n    \"grape\",\n    \"pineapple\"\n  ],\n  \"original_count\": 4,\n  \"filtered_count\": 3\n}\n```\n\n**CLI with validation errors:**\n\n```bash\nstringfilter filter --input my_strings.txt --substring \"ap\" --max-items 2\n```\nOutput (to stderr):\n```json\n{\n  \"error\": \"Input list exceeds maximum allowed items: 2\",\n  \"code\": 2\n}\n```\n\n### HTTP API\n\nThe HTTP API is a FastAPI application.\n\n1. **Run the service:**\n   ```bash\n   uvicorn stringfilter.api_app:create_app --host 0.0.0.0 --port 8000 --reload --factory\n   ```\n   The `--factory` flag tells Uvicorn to call `create_app()` to get the application instance.\n\n2. **Access the API:**\n   You can interact with the API using `curl` or any HTTP client.\n   By default, API documentation is available at `http://127.0.0.1:8000/docs` (Swagger UI) and `http://127.0.0.1:8000/redoc`.\n\n   **Example Request:**\n   ```bash\n   curl -X POST \"http://127.0.0.1:8000/filter\" \\\n        -H \"Content-Type: application/json\" \\\n        -d '{\n              \"strings\": [\"apple\", \"banana\", \"grape\", \"pineapple\"],\n              \"substring\": \"ap\"\n            }'\n   ```\n\n   **Example Response (200 OK):**\n   ```json\n   {\n     \"filtered\": [\"apple\", \"grape\", \"pineapple\"],\n     \"original_count\": 4,\n     \"filtered_count\": 3\n   }\n   ```\n\n   **With API Key (if configured):**\n   Set the `STRINGFILTER_API_KEY` environment variable before starting Uvicorn:\n   ```bash\n   export STRINGFILTER_API_KEY=\"mysecretkey\"\n   uvicorn stringfilter.api_app:create_app --host 0.0.0.0 --port 8000 --reload --factory\n   ```\n   Then include the `X-API-Key` header in your request:\n   ```bash\n   curl -X POST \"http://127.0.0.1:8000/filter\" \\\n        -H \"Content-Type: application/json\" \\\n        -H \"X-API-Key: mysecretkey\" \\\n        -d '{\n              \"strings\": [\"apple\", \"banana\"],\n              \"substring\": \"a\"\n            }'\n   ```\n\n## Configuration\n\nConfiguration values can be adjusted via code, CLI arguments, or environment variables.\n\n- **`DEFAULT_MAX_ITEMS`**: Maximum allowed items in the input list (default: 10000).\n- **`DEFAULT_MAX_STRING_LENGTH`**: Maximum allowed length of individual strings (default: 4096).\n- **`DEFAULT_AUDIT_PATH`**: Path for the audit log file (default: `audit.log`). Set to empty string `\"\"` to disable audit.\n- **`STRINGFILTER_API_KEY`**: Environment variable to set the API key for the HTTP API.\n\nFor the HTTP API, you can override defaults by passing a `config` dictionary to `create_app()`:\n\n```python\n# In api_app.py or a wrapper script\nfrom stringfilter.api_app import create_app\n\ncustom_config = {\n    \"MAX_ITEMS\": 5000,\n    \"MAX_STRING_LENGTH\": 2048,\n    \"AUDIT_PATH\": \"/var/log/stringfilter/api_audit.log\",\n    \"API_KEY\": \"another_secret\", # Overrides env var if present\n}\n\napp = create_app(config=custom_config)\n# Then run with uvicorn app:app\n```\n\n## Development\n\n### Setup\n\n```bash\ngit clone https://github.com/yourusername/stringfilter.git\ncd stringfilter\npip install -e .[dev] # Install editable and dev dependencies (e.g., pytest)\n```\n\n### Running Tests\n\nUnit and integration tests are located in the `tests/` directory.\n(Note: Test files are not generated in this response, but described in the design.)\n\n```bash\npytest\n```\n\n### CI/CD\n\nA GitHub Actions workflow example (`.github/workflows/ci.yml`) is provided for continuous integration. It typically runs tests and linting on pushes and pull requests.\n\n## Contributing\n\nContributions are welcome! Please open an issue or submit a pull request.\n\n## License\n\nThis project is licensed under the MIT License.\n```\n\n## File: .github/workflows/ci.yml\n```yaml\nname: CI/CD\n\non:\n  push:\n    branches:\n      - main\n      - develop\n  pull_request:\n    branches:\n      - main\n      - develop\n\njobs:\n  build-and-test:\n    runs-on: ubuntu-latest\n    strategy:\n      matrix:\n        python-version: [\"3.9\", \"3.10\", \"3.11\", \"3.12\"]\n\n    steps:\n      - name: Checkout code\n        uses: actions/checkout@v4\n\n      - name: Set up Python ${{ matrix.python-version }}\n        uses: actions/setup-python@v5\n        with:\n          python-version: ${{ matrix.python-version }}\n\n      - name: Install dependencies\n        run: |\n          python -m pip install --upgrade pip\n          pip install poetry  # Or setuptools if you prefer\n          poetry install --with dev --no-root # For poetry projects, use pip install .[dev] for setuptools\n\n      - name: Lint with Flake8\n        run: |\n          poetry run flake8 src/\n\n      - name: Run tests with pytest\n        run: |\n          poetry run pytest --cov=stringfilter --cov-report=xml\n\n      - name: Upload coverage reports to Codecov\n        uses: codecov/codecov-action@v4\n        with:\n          token: ${{ secrets.CODECOV_TOKEN }} # Required for private repos\n          # directory: ./coverage\n          fail_ci_if_error: true # Optional: fail CI if Codecov upload fails\n```"}
{"task_id": "HumanEval/8", "solution": "from typing import List, Tuple\nimport math\n\n\ndef sum_product(numbers: List[int]) -> Tuple[int, int]:\n    \"\"\" For a given list of integers, return a tuple consisting of a sum and a product of all the integers in a list.\n    Empty sum should be equal to 0 and empty product should be equal to 1.\n    >>> sum_product([])\n    (0, 1)\n    >>> sum_product([1, 2, 3, 4])\n    (10, 24)\n    \"\"\"\n    if not numbers:\n        return (0, 1)\n\n    total = sum(numbers)\n\n    # Use math.prod for Python 3.8+ if available, otherwise fallback to a loop.\n    try:\n        prod = math.prod(numbers)\n    except AttributeError:\n        prod = 1\n        for n in numbers:\n            prod *= n\n\n    return (total, prod)"}
{"task_id": "HumanEval/9", "solution": "```python\nfrom typing import List\n\n\ndef rolling_max(numbers: List[int]) -> List[int]:\n    \"\"\" From a given list of integers, generate a list of rolling maximum element found until given moment\n    in the sequence.\n    >>> rolling_max([1, 2, 3, 2, 3, 4, 2])\n    [1, 2, 3, 3, 3, 4, 4]\n    \"\"\"\n    result: List[int] = []\n    max_so_far = None\n    for x in numbers:\n        if max_so_far is None or x > max_so_far:\n            max_so_far = x\n        result.append(max_so_far)\n    return result\n```"}
{"task_id": "HumanEval/11", "solution": "def string_xor(a: str, b: str) -> str:\n    \"\"\"\n    Perform binary XOR on two strings of 1s and 0s.\n    Assumes inputs are valid binary strings of equal length.\n    \"\"\"\n    result_bits = []\n    for i in range(len(a)):\n        if a[i] != b[i]:\n            result_bits.append('1')\n        else:\n            result_bits.append('0')\n    return ''.join(result_bits)"}
{"task_id": "HumanEval/10", "solution": "def is_palindrome(string: str) -> bool:\n    \"\"\" Test if given string is a palindrome. \"\"\"\n    return string == string[::-1]\n\n\ndef make_palindrome(string: str) -> str:\n    \"\"\" Finds the shortest palindrome beginning with the string.\n    It identifies the longest palindromic suffix and appends the reversed prefix.\n    \"\"\"\n    n = len(string)\n    if n == 0:\n        return \"\"\n    for i in range(n):\n        suffix = string[i:]\n        if suffix == suffix[::-1]:\n            return string + string[:i][::-1]"}
{"task_id": "HumanEval/8", "solution": "```python\n# File: pyproject.toml\n[tool.poetry]\nname = \"sumprod\"\nversion = \"0.1.0\"\ndescription = \"A library to compute sum and product of a list of integers.\"\nauthors = [\"Your Name <you@example.com>\"]\nreadme = \"README.md\"\npackages = [{include = \"sumprod\", from = \"src\"}]\n\n[tool.poetry.dependencies]\npython = \">=3.8,<4.0\"\nfastapi = {version = \"^0.111.0\", optional = true} # For API example\nuvicorn = {version = \"^0.30.1\", optional = true} # For API example\n\n[tool.poetry.group.dev.dependencies]\npytest = \"^8.2.2\"\nblack = \"^24.4.2\"\nisort = \"^5.13.2\"\nflake8 = \"^7.1.0\"\n\n[tool.poetry.extras]\napi = [\"fastapi\", \"uvicorn\"]\n\n[tool.poetry.scripts]\nsum-product = \"sumprod.controllers:cli_entry\"\n\n[build-system]\nrequires = [\"poetry-core\"]\nbuild-backend = \"poetry.core.masononry.api\"\n\n---\n# File: README.md\n# SumProd Library\n\nA simple Python library to compute the sum and product of a list of integers. It provides a core library function, a command-line interface (CLI), and a minimal HTTP JSON API.\n\n## Features\n\n-   **Core Library Function**: `compute(numbers: List[int]) -> Tuple[int, int]`\n-   **CLI**: `sum-product <int1> <int2> ...`\n-   **HTTP API**: `POST /sum-product` with JSON payload.\n-   Robust input validation and error handling.\n-   Automated unit tests.\n\n## Installation\n\n```bash\n# Clone the repository (if applicable)\n# git clone <repo-url>\n# cd sumprod-repo\n\n# Install with Poetry\npoetry install\n\n# If you want to enable the HTTP API example, install with the 'api' extra:\npoetry install --with api\n```\n\n## Usage\n\n### Library Function\n\n```python\nfrom sumprod import compute\n\n# Basic usage\nresult_sum, result_product = compute([1, 2, 3, 4])\nprint(f\"Sum: {result_sum}, Product: {result_product}\") # Output: Sum: 10, Product: 24\n\n# Empty list\nresult_sum, result_product = compute([])\nprint(f\"Sum: {result_sum}, Product: {result_product}\") # Output: Sum: 0, Product: 1\n\n# List with strings (will be validated and converted)\nresult_sum, result_product = compute([\"10\", \"20\", \"30\"])\nprint(f\"Sum: {result_sum}, Product: {result_product}\") # Output: Sum: 60, Product: 6000\n\n# Invalid input (will raise sumprod.errors.ValidationError)\ntry:\n    compute([1, 2, \"three\"])\nexcept Exception as e:\n    print(f\"Error: {e}\")\n```\n\n### Command-Line Interface (CLI)\n\nThe `sum-product` command will be available after installation (e.g., `poetry run sum-product` or if installed globally).\n\n```bash\n# Compute sum and product for a list of numbers\npoetry run sum-product 1 2 3 4\n# Output: {\"sum\": 10, \"product\": 24}\n\n# With an empty list (no arguments)\npoetry run sum-product\n# Output: {\"sum\": 0, \"product\": 1}\n\n# With negative numbers and zero\npoetry run sum-product 5 -2 0 3\n# Output: {\"sum\": 6, \"product\": 0}\n\n# With invalid input\npoetry run sum-product 1 2 abc\n# Output to stderr: Error: Element not an integer string: 'abc'\n# Exit code: 2\n```\n\n### HTTP JSON API\n\nThe HTTP API can be integrated into any WSGI/ASGI framework. An example using FastAPI:\n\n1.  **Create an `app.py` file:**\n\n    ```python\n    from fastapi import FastAPI, HTTPException, Request\n    from fastapi.responses import JSONResponse\n    from sumprod.controllers import APIController\n    from sumprod.calculator import SumProductService\n    from sumprod.utils import InputValidator\n    from sumprod.errors import ValidationError\n\n    app = FastAPI(title=\"SumProduct API\")\n\n    # Initialize dependencies (can be done with proper DI framework in larger apps)\n    service = SumProductService()\n    validator = InputValidator()\n    api_controller = APIController(service, validator)\n\n    @app.exception_handler(ValidationError)\n    async def validation_exception_handler(request: Request, exc: ValidationError):\n        return JSONResponse(\n            status_code=400,\n            content={\"message\": exc.message},\n        )\n\n    @app.post(\"/sum-product\")\n    async def sum_product_endpoint(payload: dict):\n        try:\n            result_dict = api_controller.handle_post(payload)\n            return JSONResponse(content=result_dict, status_code=200)\n        except ValidationError:\n            raise # Let the custom exception handler catch it\n        except Exception as e:\n            raise HTTPException(status_code=500, detail=f\"Internal server error: {e}\")\n\n    # To run this example:\n    # uvicorn app:app --reload --port 8000\n    ```\n\n2.  **Run the API (make sure `uvicorn` is installed: `poetry install --with api`)**\n\n    ```bash\n    poetry run uvicorn app:app --reload --port 8000\n    ```\n\n3.  **Make a request (e.g., using `curl` or Postman):**\n\n    ```bash\n    curl -X POST http://127.0.0.1:8000/sum-product \\\n         -H \"Content-Type: application/json\" \\\n         -d '{\"numbers\": [1, 2, 3, 4]}'\n    # Output: {\"sum\": 10, \"product\": 24}\n\n    curl -X POST http://127.0.0.1:8000/sum-product \\\n         -H \"Content-Type: application/json\" \\\n         -d '{\"numbers\": []}'\n    # Output: {\"sum\": 0, \"product\": 1}\n\n    curl -X POST http://127.0.0.1:8000/sum-product \\\n         -H \"Content-Type: application/json\" \\\n         -d '{\"numbers\": [1, \"foo\"]}'\n    # Output: {\"message\": \"Elements must be integers or integer strings, got type str\"} (Status 400)\n    ```\n\n## Development\n\n### Running Tests\n\n```bash\npoetry run pytest\n```\n\n### Linting and Formatting\n\n```bash\npoetry run black src tests\npoetry run isort src tests\npoetry run flake8 src tests\n```\n\n## Project Structure\n\n```\n.\n\u251c\u2500\u2500 pyproject.toml\n\u251c\u2500\u2500 README.md\n\u251c\u2500\u2500 src/\n\u2502   \u2514\u2500\u2500 sumprod/\n\u2502       \u251c\u2500\u2500 __init__.py\n\u2502       \u251c\u2500\u2500 calculator.py\n\u2502       \u251c\u2500\u2500 dto.py\n\u2502       \u251c\u2500\u2500 utils.py\n\u2502       \u251c\u2500\u2500 errors.py\n\u2502       \u2514\u2500\u2500 controllers.py\n\u2514\u2500\u2500 tests/\n    \u251c\u2500\u2500 test_calculator.py\n    \u251c\u2500\u2500 test_utils.py\n    \u2514\u2500\u2500 test_cli.py\n```\n\n## License\n\nMIT License (or your chosen license).\n\n---\n# File: src/sumprod/__init__.py\n\"\"\"Sumprod package exports; exposes convenience function.\"\"\"\nfrom typing import Any, Tuple\n\nfrom .calculator import SumProductService\nfrom .errors import ValidationError\nfrom .utils import InputValidator\n\n\ndef compute(numbers: Any) -> Tuple[int, int]:\n    \"\"\"\n    Computes the sum and product of a list of numbers after validation.\n    Raises ValidationError if inputs are not valid.\n    \"\"\"\n    validator = InputValidator()\n    nums = validator.validate_numbers(numbers)\n    return SumProductService().compute(nums).to_tuple()\n\n---\n# File: src/sumprod/calculator.py\n\"\"\"Core computation logic for sum and product.\"\"\"\nfrom typing import List\n\nfrom .dto import SumProductResult\n\n\nclass SumProductService:\n    \"\"\"\n    Service to compute the sum and product of a list of integers.\n    Handles empty lists by returning 0 for sum and 1 for product.\n    \"\"\"\n\n    def __init__(self) -> None:\n        pass\n\n    def compute(self, numbers: List[int]) -> SumProductResult:\n        \"\"\"\n        Computes the sum and product of the given list of integers.\n        Assumes numbers is already validated as List[int].\n        \"\"\"\n        total = self._compute_sum(numbers)\n        product = self._compute_product(numbers)\n        return SumProductResult(total=total, product=product)\n\n    def _compute_sum(self, numbers: List[int]) -> int:\n        \"\"\"Returns the sum of all numbers in the list.\"\"\"\n        return sum(numbers)\n\n    def _compute_product(self, numbers: List[int]) -> int:\n        \"\"\"Returns the product of all numbers, 1 for an empty list.\"\"\"\n        prod = 1\n        for n in numbers:\n            prod *= n\n        return prod\n\n---\n# File: src/sumprod/dto.py\n\"\"\"Data models for computation results.\"\"\"\nfrom dataclasses import dataclass\nfrom typing import Dict, Tuple\n\n\n@dataclass(frozen=True)\nclass SumProductResult:\n    \"\"\"\n    Immutable Data Transfer Object for sum and product results.\n    Provides convenience methods for tuple and dictionary representation.\n    \"\"\"\n\n    total: int\n    product: int\n\n    def to_tuple(self) -> Tuple[int, int]:\n        \"\"\"Returns the result as an (sum, product) tuple.\"\"\"\n        return (self.total, self.product)\n\n    def to_dict(self) -> Dict[str, int]:\n        \"\"\"Returns the result as a dictionary suitable for JSON serialization.\"\"\"\n        return {\"sum\": self.total, \"product\": self.product}\n\n---\n# File: src/sumprod/utils.py\n\"\"\"Input validation and parsing helpers.\"\"\"\nfrom typing import Any, List\n\nfrom .errors import ValidationError\n\n\nclass InputValidator:\n    \"\"\"\n    Validates various input types into a consistent List[int].\n    Handles conversion of string representations of integers.\n    \"\"\"\n\n    def __init__(self) -> None:\n        pass\n\n    def validate_numbers(self, obj: Any) -> List[int]:\n        \"\"\"\n        Validates an object to ensure it's a list of integers or integer-like strings.\n        Returns a list of integers or raises ValidationError.\n        \"\"\"\n        if obj is None:\n            return []\n        if isinstance(obj, (list, tuple)):\n            result = []\n            for el in obj:\n                if isinstance(el, int):\n                    result.append(el)\n                elif isinstance(el, str):\n                    try:\n                        parsed_int = int(el)\n                        result.append(parsed_int)\n                    except ValueError as e:\n                        raise ValidationError(f\"Element not an integer string: '{el}'\") from e\n                else:\n                    raise ValidationError(f\"Elements must be integers or integer strings, got type {type(el).__name__}\")\n            return result\n        # Special case for CLI where single non-list arg might be passed initially\n        if isinstance(obj, str):\n            try:\n                return [int(obj)]\n            except ValueError as e:\n                raise ValidationError(f\"Input is not an integer string: '{obj}'\") from e\n        \n        raise ValidationError(f\"Expected a list-like object, got type {type(obj).__name__}\")\n\n---\n# File: src/sumprod/errors.py\n\"\"\"Domain-specific exceptions.\"\"\"\n\n\nclass ValidationError(Exception):\n    \"\"\"\n    Exception raised for invalid input or contract violations.\n    Contains a message detailing the validation failure.\n    \"\"\"\n\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\n---\n# File: src/sumprod/controllers.py\n\"\"\"Adapters for CLI and HTTP interfaces.\"\"\"\nimport json\nimport sys\nfrom typing import Any, Dict, List, NoReturn\n\nfrom .calculator import SumProductService\nfrom .errors import ValidationError\nfrom .utils import InputValidator\n\n\nclass CLIController:\n    \"\"\"\n    Controller for the command-line interface.\n    Parses arguments, performs computation, and prints JSON output or errors.\n    \"\"\"\n\n    def __init__(self, service: SumProductService, validator: InputValidator) -> None:\n        self.service = service\n        self.validator = validator\n\n    def run(self, argv: List[str]) -> int:\n        \"\"\"\n        Executes the CLI logic.\n        Parses `argv` (excluding script name), computes, and prints result.\n        Returns an exit code: 0 for success, 2 for validation error, 1 for unexpected error.\n        \"\"\"\n        try:\n            # argv contains string tokens from command line, validate them as numbers\n            nums = self.validator.validate_numbers(argv)\n            result = self.service.compute(nums)\n            self._print_result(result)\n            return 0\n        except ValidationError as e:\n            print(f\"Error: {e.message}\", file=sys.stderr)\n            return 2\n        except Exception as e:\n            print(f\"An unexpected error occurred: {e}\", file=sys.stderr)\n            return 1\n\n    def _print_result(self, result: Any) -> None: # Using Any for result, assuming it has to_dict()\n        \"\"\"Prints the computation result as a JSON object to stdout.\"\"\"\n        print(json.dumps(result.to_dict()))\n\n\nclass APIController:\n    \"\"\"\n    Controller for the HTTP API endpoint.\n    Handles POST requests, validates payload, and returns JSON response.\n    \"\"\"\n\n    def __init__(self, service: SumProductService, validator: InputValidator) -> None:\n        self.service = service\n        self.validator = validator\n\n    def handle_post(self, payload: Dict[str, Any]) -> Dict[str, Any]:\n        \"\"\"\n        Handles an HTTP POST request payload for sum-product calculation.\n        Expects payload = {\"numbers\": List[Any]}.\n        Raises ValidationError for invalid inputs.\n        \"\"\"\n        if not isinstance(payload, dict) or \"numbers\" not in payload:\n            raise ValidationError(\"Invalid payload: Missing 'numbers' key or not a dictionary.\")\n\n        numbers_data = payload[\"numbers\"]\n        nums = self.validator.validate_numbers(numbers_data)\n        result = self.service.compute(nums)\n        return result.to_dict()\n\n\ndef cli_entry() -> NoReturn:\n    \"\"\"\n    Entry point for the console script 'sum-product'.\n    Initializes CLIController and runs it with sys.argv.\n    \"\"\"\n    service = SumProductService()\n    validator = InputValidator()\n    controller = CLIController(service, validator)\n    sys.exit(controller.run(sys.argv[1:]))\n\n---\n# File: tests/test_calculator.py\n\"\"\"Unit tests for SumProductService.\"\"\"\nimport pytest\n\nfrom src.sumprod.calculator import SumProductService\nfrom src.sumprod.dto import SumProductResult\n\n\n@pytest.fixture\ndef calculator_service():\n    \"\"\"Provides a SumProductService instance for tests.\"\"\"\n    return SumProductService()\n\n\ndef test_compute_empty_list(calculator_service):\n    \"\"\"Test computation with an empty list.\"\"\"\n    result = calculator_service.compute([])\n    assert result == SumProductResult(total=0, product=1)\n\n\ndef test_compute_positive_numbers(calculator_service):\n    \"\"\"Test computation with a list of positive integers.\"\"\"\n    result = calculator_service.compute([1, 2, 3, 4])\n    assert result == SumProductResult(total=10, product=24)\n\n\ndef test_compute_with_zero(calculator_service):\n    \"\"\"Test computation when the list contains zero.\"\"\"\n    result = calculator_service.compute([1, 2, 0, 4])\n    assert result == SumProductResult(total=7, product=0)\n\n\ndef test_compute_negative_numbers(calculator_service):\n    \"\"\"Test computation with negative numbers.\"\"\"\n    result = calculator_service.compute([1, -2, 3, -4])\n    assert result == SumProductResult(total=-2, product=24)\n\n\ndef test_compute_mixed_numbers(calculator_service):\n    \"\"\"Test computation with a mix of positive, negative, and zero.\"\"\"\n    result = calculator_service.compute([-1, 0, 5, -2])\n    assert result == SumProductResult(total=2, product=0)\n\n\ndef test_compute_single_number(calculator_service):\n    \"\"\"Test computation with a single number.\"\"\"\n    result = calculator_service.compute([7])\n    assert result == SumProductResult(total=7, product=7)\n\n\ndef test_compute_large_numbers(calculator_service):\n    \"\"\"Test computation with larger numbers.\"\"\"\n    result = calculator_service.compute([100, 200])\n    assert result == SumProductResult(total=300, product=20000)\n\n---\n# File: tests/test_utils.py\n\"\"\"Unit tests for InputValidator.\"\"\"\nimport pytest\n\nfrom src.sumprod.errors import ValidationError\nfrom src.sumprod.utils import InputValidator\n\n\n@pytest.fixture\ndef validator():\n    \"\"\"Provides an InputValidator instance for tests.\"\"\"\n    return InputValidator()\n\n\ndef test_validate_numbers_empty_list(validator):\n    \"\"\"Test validation with an empty list.\"\"\"\n    assert validator.validate_numbers([]) == []\n\n\ndef test_validate_numbers_none(validator):\n    \"\"\"Test validation with None input.\"\"\"\n    assert validator.validate_numbers(None) == []\n\n\ndef test_validate_numbers_list_of_ints(validator):\n    \"\"\"Test validation with a list of valid integers.\"\"\"\n    input_list = [1, 2, 3]\n    assert validator.validate_numbers(input_list) == [1, 2, 3]\n\n\ndef test_validate_numbers_list_of_str_ints(validator):\n    \"\"\"Test validation with a list of integer strings.\"\"\"\n    input_list = [\"1\", \"2\", \"3\"]\n    assert validator.validate_numbers(input_list) == [1, 2, 3]\n\n\ndef test_validate_numbers_mixed_list(validator):\n    \"\"\"Test validation with a mixed list of ints and integer strings.\"\"\"\n    input_list = [1, \"2\", 3, \"-4\"]\n    assert validator.validate_numbers(input_list) == [1, 2, 3, -4]\n\n\ndef test_validate_numbers_single_int_str(validator):\n    \"\"\"Test validation with a single integer string (e.g., from CLI).\"\"\"\n    assert validator.validate_numbers(\"123\") == [123]\n\n\ndef test_validate_numbers_invalid_element_type(validator):\n    \"\"\"Test validation with an element that is not an int or int-like string.\"\"\"\n    with pytest.raises(ValidationError, match=\"Element not an integer string: 'abc'\"):\n        validator.validate_numbers([1, 2, \"abc\"])\n\n    with pytest.raises(ValidationError, match=\"Elements must be integers or integer strings, got type float\"):\n        validator.validate_numbers([1, 2, 3.5])\n\n    with pytest.raises(ValidationError, match=\"Elements must be integers or integer strings, got type NoneType\"):\n        validator.validate_numbers([1, 2, None]) # None is handled by outer 'obj is None' or list iteration\n\n    with pytest.raises(ValidationError, match=\"Elements must be integers or integer strings, got type dict\"):\n        validator.validate_numbers([1, {'a':1}])\n\n\ndef test_validate_numbers_invalid_obj_type(validator):\n    \"\"\"Test validation with an object that is not list-like or int-like string.\"\"\"\n    with pytest.raises(ValidationError, match=\"Expected a list-like object, got type int\"):\n        validator.validate_numbers(123)\n\n    with pytest.raises(ValidationError, match=\"Expected a list-like object, got type dict\"):\n        validator.validate_numbers({\"key\": \"value\"})\n\n\ndef test_validate_numbers_non_int_string(validator):\n    \"\"\"Test validation with a single non-integer string.\"\"\"\n    with pytest.raises(ValidationError, match=\"Input is not an integer string: 'hello'\"):\n        validator.validate_numbers(\"hello\")\n\n---\n# File: tests/test_cli.py\n\"\"\"Integration tests for the CLI controller.\"\"\"\nimport json\nimport subprocess\nimport sys\n\nimport pytest\n\n# Helper to get the CLI entry point\ndef run_cli(args: list) -> subprocess.CompletedProcess:\n    \"\"\"Runs the sum-product CLI command with given arguments.\"\"\"\n    # Using sys.executable and -m src.sumprod.controllers to ensure correct module execution\n    command = [sys.executable, \"-m\", \"src.sumprod.controllers\"] + args\n    return subprocess.run(command, capture_output=True, text=True, check=False)\n\n\ndef test_cli_success_with_numbers():\n    \"\"\"Test CLI with valid numbers, expecting successful JSON output.\"\"\"\n    result = run_cli([\"1\", \"2\", \"3\", \"4\"])\n    assert result.returncode == 0\n    assert json.loads(result.stdout) == {\"sum\": 10, \"product\": 24}\n    assert result.stderr == \"\"\n\n\ndef test_cli_success_empty_args():\n    \"\"\"Test CLI with no arguments, expecting (0, 1) result.\"\"\"\n    result = run_cli([])\n    assert result.returncode == 0\n    assert json.loads(result.stdout) == {\"sum\": 0, \"product\": 1}\n    assert result.stderr == \"\"\n\n\ndef test_cli_success_negative_numbers():\n    \"\"\"Test CLI with negative numbers and zero.\"\"\"\n    result = run_cli([\"-1\", \"0\", \"5\", \"-2\"])\n    assert result.returncode == 0\n    assert json.loads(result.stdout) == {\"sum\": 2, \"product\": 0}\n    assert result.stderr == \"\"\n\n\ndef test_cli_invalid_input_type():\n    \"\"\"Test CLI with non-integer string arguments, expecting error and exit code 2.\"\"\"\n    result = run_cli([\"1\", \"2\", \"abc\", \"4\"])\n    assert result.returncode == 2\n    assert \"Error: Element not an integer string: 'abc'\" in result.stderr\n    assert result.stdout == \"\"\n\n\ndef test_cli_invalid_input_type_float_like():\n    \"\"\"Test CLI with float-like string arguments, expecting error and exit code 2.\"\"\"\n    result = run_cli([\"1\", \"2.5\", \"3\"])\n    assert result.returncode == 2\n    assert \"Error: Element not an integer string: '2.5'\" in result.stderr\n    assert result.stdout == \"\"\n\n\ndef test_cli_invalid_single_argument():\n    \"\"\"Test CLI with a single non-integer string argument.\"\"\"\n    result = run_cli([\"hello\"])\n    assert result.returncode == 2\n    assert \"Error: Input is not an integer string: 'hello'\" in result.stderr\n    assert result.stdout == \"\"\n\n---\n# File: .github/workflows/ci.yml\nname: CI/CD Pipeline\n\non:\n  push:\n    branches:\n      - main\n      - develop\n  pull_request:\n    branches:\n      - main\n      - develop\n\njobs:\n  build_and_test:\n    runs-on: ubuntu-latest\n    strategy:\n      matrix:\n        python-version: [\"3.8\", \"3.9\", \"3.10\", \"3.11\", \"3.12\"]\n\n    steps:\n    - name: Checkout code\n      uses: actions/checkout@v4\n\n    - name: Set up Python ${{ matrix.python-version }}\n      uses: actions/setup-python@v5\n      with:\n        python-version: ${{ matrix.python-version }}\n        cache: 'poetry'\n\n    - name: Install Poetry\n      run: pip install poetry\n\n    - name: Install dependencies\n      run: poetry install --no-root\n\n    - name: Run tests\n      run: poetry run pytest\n\n    - name: Run linting (optional, consider adding linting tools like black, flake8, isort)\n      run: |\n        # poetry run black --check src tests\n        # poetry run isort --check-only src tests\n        # poetry run flake8 src tests\n        echo \"Linting steps are optional and commented out. Uncomment to enable.\"\n```"}
{"task_id": "HumanEval/9", "solution": "To implement the software design specification, I will generate the required files and their contents, adhering to the architecture, classes, and methods outlined in the design. I will respect the docstring and comment length limits. I will skip generating unit tests as explicitly forbidden by the \"CRITICAL REQUIREMENTS\".\n\n```python\n# src/rollingmax/Exceptions.py\nclass RollingMaxError(Exception):\n    \"\"\"Base exception for the rollingmax library.\"\"\"\n    pass\n\nclass ValidationError(RollingMaxError):\n    \"\"\"Exception raised for invalid input data.\"\"\"\n    pass\n\n```\n```python\n# src/rollingmax/Client.py\nclass Client:\n    \"\"\"Represents a client actor in diagrams.\"\"\"\n    def __init__(self, id: str) -> None:\n        self.id = id\n\n```\n```python\n# src/rollingmax/InputSequence.py\nfrom typing import List, Iterator\n\nclass InputSequence:\n    \"\"\"DTO for a validated input sequence of integers.\"\"\"\n    def __init__(self, numbers: List[int]) -> None:\n        self.numbers = numbers\n\n    def __len__(self) -> int:\n        \"\"\"Returns the number of elements in the sequence.\"\"\"\n        return len(self.numbers)\n\n    def __iter__(self) -> Iterator[int]:\n        \"\"\"Returns an iterator over the numbers.\"\"\"\n        return iter(self.numbers)\n\n```\n```python\n# src/rollingmax/RollingMaxResult.py\nfrom typing import List\n\nclass RollingMaxResult:\n    \"\"\"DTO for the computed rolling maximum result.\"\"\"\n    def __init__(self, result: List[int]) -> None:\n        self.result = result\n\n    def as_list(self) -> List[int]:\n        \"\"\"Returns the computed result as a list (shallow copy).\"\"\"\n        return list(self.result)\n\n```\n```python\n# src/rollingmax/Validator.py\nfrom typing import Any, List, Sequence\nfrom .InputSequence import InputSequence\nfrom .Exceptions import ValidationError\n\nclass Validator:\n    \"\"\"Validates raw input data for the rolling maximum computation.\"\"\"\n    def validate_numbers(self, numbers: Any) -> InputSequence:\n        \"\"\"Validates input, converting it to an InputSequence or raising ValidationError.\"\"\"\n        if numbers is None:\n            raise ValidationError(\"Input is None, a list of integers is required.\")\n\n        if isinstance(numbers, str):\n            # For CLI convenience, split string by whitespace and try to parse ints\n            tokens = numbers.strip().split()\n            return InputSequence(self._convert_and_check_items(tokens))\n        \n        if isinstance(numbers, Sequence):\n            # For sequences, ensure all items are integers or convertible strings\n            return InputSequence(self._convert_and_check_items(numbers))\n        \n        raise ValidationError(f\"Unsupported input type: {type(numbers)}. Expected a sequence of integers.\")\n\n    def _convert_and_check_items(self, seq: Sequence) -> List[int]:\n        \"\"\"Internal helper to convert sequence items to integers and validate.\"\"\"\n        out: List[int] = []\n        for i, v in enumerate(seq):\n            try:\n                if isinstance(v, int):\n                    out.append(v)\n                elif isinstance(v, str):\n                    out.append(int(v)) # Allow string parsing for CLI\n                else:\n                    raise ValueError(\"Item is not an integer or integer-like string.\")\n            except (ValueError, TypeError):\n                raise ValidationError(f\"Invalid item at index {i}: {v!r}. Expected an integer.\")\n        return out\n\n```\n```python\n# src/rollingmax/RollingMaxService.py\nfrom typing import List\nfrom .InputSequence import InputSequence\nfrom .RollingMaxResult import RollingMaxResult\nfrom .Exceptions import RollingMaxError # Potentially for internal, unexpected errors\n\nclass RollingMaxService:\n    \"\"\"Provides the core algorithm for computing rolling maximums.\"\"\"\n    def compute(self, input_seq: InputSequence) -> RollingMaxResult:\n        \"\"\"Computes the rolling maximum for a given sequence of integers.\"\"\"\n        numbers = input_seq.numbers\n        if not numbers:\n            return RollingMaxResult([])\n        \n        result: List[int] = []\n        current_max = numbers[0] # Initialize with the first element\n        \n        for x in numbers:\n            if x > current_max:\n                current_max = x\n            result.append(current_max)\n            \n        return RollingMaxResult(result)\n\n    def _compute_iter(self, numbers: List[int]) -> List[int]:\n        \"\"\"Internal helper to compute and return a raw list, primarily for internal use.\"\"\"\n        # This method is primarily for internal usage/testing flexibility, delegating to compute.\n        return self.compute(InputSequence(numbers)).result\n\n```\n```python\n# src/rollingmax/CLIController.py\nimport sys\nimport json\nfrom typing import List\nfrom .Validator import Validator\nfrom .RollingMaxService import RollingMaxService\nfrom .Exceptions import ValidationError, RollingMaxError\n\nclass CLIController:\n    \"\"\"Manages command-line interface parsing and execution.\"\"\"\n    def run(self, argv: List[str]) -> int:\n        \"\"\"Entry point for the command-line interface, parsing arguments or stdin.\"\"\"\n        try:\n            if argv:\n                # CLI arguments are passed as strings, Validator handles conversion\n                validated = Validator().validate_numbers(\" \".join(argv))\n            else:\n                # No arguments, read from stdin (whitespace-separated)\n                data = sys.stdin.read()\n                validated = Validator().validate_numbers(data)\n            \n            result = RollingMaxService().compute(validated)\n            print(json.dumps(result.as_list()))\n            return 0\n        except ValidationError as e:\n            print(f\"Validation error: {e}\", file=sys.stderr)\n            return 2\n        except RollingMaxError as e:\n            # Catching generic RollingMaxError for any service-level internal errors\n            print(f\"Application error: {e}\", file=sys.stderr)\n            return 1\n        except Exception as e:\n            # Catch all other unexpected errors\n            print(f\"An unexpected error occurred: {e}\", file=sys.stderr)\n            return 1\n\n```\n```python\n# src/rollingmax/__init__.py\nfrom typing import List\nfrom .Validator import Validator\nfrom .RollingMaxService import RollingMaxService\nfrom .Exceptions import ValidationError, RollingMaxError\n\n__version__ = \"0.1.0\"\n\ndef rolling_max(numbers: List[int]) -> List[int]:\n    \"\"\"\n    Computes the rolling (running) maximum for an integer sequence.\n    This is the public API entry point.\n    \"\"\"\n    # Use the Validator to ensure input correctness and transform into DTO.\n    input_seq = Validator().validate_numbers(numbers)\n    # Delegate the actual computation to the service layer.\n    result = RollingMaxService().compute(input_seq)\n    # Return the raw list from the result DTO.\n    return result.as_list()\n\n```\n```toml\n# pyproject.toml\n[project]\nname = \"rollingmax\"\nversion = \"0.1.0\"\ndescription = \"A Python library and CLI for computing rolling maximums of integer sequences.\"\nauthors = [{ name = \"Your Name\", email = \"your.email@example.com\" }]\nlicense = { text = \"MIT\" }\nreadme = \"README.md\"\nrequires-python = \">=3.9\"\ndependencies = [] # Core logic uses only standard library\n\n[project.scripts]\nrollingmax = \"rollingmax.CLIController:CLIController.run\"\n\n[project.urls]\nHomepage = \"https://github.com/yourusername/rollingmax\" # Placeholder\nRepository = \"https://github.com/yourusername/rollingmax\" # Placeholder\n\n[build-system]\nrequires = [\"setuptools>=61.0\"]\nbuild-backend = \"setuptools.build_meta\"\n\n[tool.setuptools.packages.find]\nwhere = [\"src\"]\n\n[tool.pytest.ini_options]\npythonpath = [\"src\"] # For running tests against the 'src' directory\n\n[tool.black]\nline-length = 99\n\n[tool.isort]\nprofile = \"black\"\n\n```\n```yaml\n# .github/workflows/ci.yml\nname: CI\n\non:\n  push:\n    branches:\n      - main\n      - develop\n  pull_request:\n    branches:\n      - main\n      - develop\n\njobs:\n  build:\n    runs-on: ubuntu-latest\n    strategy:\n      matrix:\n        python-version: [\"3.9\", \"3.10\", \"3.11\"]\n\n    steps:\n      - uses: actions/checkout@v4\n      - name: Set up Python ${{ matrix.python-version }}\n        uses: actions/setup-python@v5\n        with:\n          python-version: ${{ matrix.python-version }}\n      - name: Install dependencies\n        run: |\n          python -m pip install --upgrade pip\n          pip install -e \".[dev]\" # Install editable mode and dev dependencies\n          pip install pytest coverage # Explicitly install test tools\n      - name: Run tests with pytest\n        run: |\n          pytest\n      - name: Lint with Flake8 (Optional, but good practice)\n        run: |\n          pip install flake8\n          flake8 src/rollingmax/\n```\n```markdown\n# README.md\n# Rolling Max\n\nA Python library and command-line interface (CLI) for computing the rolling (running) maximum of an integer sequence.\n\n## Features\n\n- **Library API**: Easily import and use the `rolling_max` function in your Python programs.\n- **CLI**: Compute rolling maxima from command-line arguments or standard input.\n- **Validation**: Robust input validation with helpful error messages.\n- **Performance**: Efficient O(n) time complexity with O(1) additional space.\n\n## Installation\n\n```bash\npip install rollingmax\n```\n*(Note: Replace `rollingmax` with `.` if installing directly from source for development: `pip install .`)*\n\n## Usage\n\n### Library\n\nImport the `rolling_max` function into your Python code:\n\n```python\nfrom rollingmax import rolling_max\n\n# Basic usage\nresult = rolling_max([1, 2, 3, 2, 3, 4, 2])\nprint(result) # Output: [1, 2, 3, 3, 3, 4, 4]\n\n# With negative numbers\nresult = rolling_max([-1, -5, -2, 0])\nprint(result) # Output: [-1, -1, -1, 0]\n\n# Empty input\nresult = rolling_max([])\nprint(result) # Output: []\n\n# Invalid input raises ValidationError\ntry:\n    rolling_max([1, 2, \"three\", 4])\nexcept ValueError as e:\n    print(e) # Output: Validation error: Invalid item at index 2: 'three'. Expected an integer.\n```\n\n### Command-Line Interface (CLI)\n\nUse the `python -m rollingmax` command with numbers passed as arguments or via stdin.\n\n**Numbers as arguments:**\n\n```bash\npython -m rollingmax 1 2 3 2 3 4 2\n# Output: [1, 2, 3, 3, 3, 4, 4]\n\npython -m rollingmax -10 5 0 -100 20\n# Output: [-10, 5, 5, 5, 20]\n```\n\n**Numbers via stdin:**\n\n```bash\necho \"1 2 3 2 3 4 2\" | python -m rollingmax\n# Output: [1, 2, 3, 3, 3, 4, 4]\n\necho -e \"1\\n2\\n3 2\\n3 4 2\" | python -m rollingmax\n# Output: [1, 2, 3, 3, 3, 4, 4]\n\n# Error handling via CLI\npython -m rollingmax 1 2 foo 4\n# Output (to stderr): Validation error: Invalid item at index 2: 'foo'. Expected an integer.\n# Exit code: 2\n```\n```\n```python\n# LICENSE\nMIT License\n\nCopyright (c) 2023 Your Name\n\nPermission is hereby granted, free of charge, to any person obtaining a copy\nof this software and associated documentation files (the \"Software\"), to deal\nin the Software without restriction, including without limitation the rights\nto use, copy, modify, merge, publish, distribute, sublicense, and/or sell\ncopies of the Software, and to permit persons to whom the Software is\nfurnished to do so, subject to the following conditions:\n\nThe above copyright notice and this permission notice shall be included in all\ncopies or substantial portions of the Software.\n\nTHE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR\nIMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,\nFITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE\nAUTHORS OR COPYRIGHT HOLDERS BE L