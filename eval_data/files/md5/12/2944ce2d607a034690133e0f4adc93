{"task_id": "HumanEval/17", "solution": "from typing import List\n\n\ndef parse_music(music_string: str) -> List[int]:\n    \"\"\"Parses a string of musical notes into a list of beat durations.\n    Notes are 'o' (4 beats), 'o|' (2 beats), '.|' (1 beat), separated by whitespace.\n    \"\"\"\n    token_to_beats = {\n        'o': 4,\n        'o|': 2,\n        '.|': 1\n    }\n\n    # Split the input string by whitespace; this naturally handles leading/trailing whitespace\n    # and results in an empty list if music_string is empty or only whitespace.\n    tokens = music_string.split()\n\n    beats = []\n    for token in tokens:\n        # As per critical requirements, assume valid input and do not raise exceptions\n        # for edge cases or invalid tokens; trust the caller's input for mapping.\n        beats.append(token_to_beats[token])\n\n    return beats"}
{"task_id": "HumanEval/18", "solution": "```python\n# pyproject.toml\n# Build metadata and dependencies\n[project]\nname = \"substring-counter\"\nversion = \"0.1.0\"\nauthors = [\n  { name=\"Your Name\", email=\"your.email@example.com\" },\n]\ndescription = \"A reliable, testable library and CLI for counting substring occurrences, including overlaps.\"\nreadme = \"README.md\"\nrequires-python = \">=3.8\"\nlicense = { text = \"MIT\" }\nkeywords = [\"substring\", \"count\", \"cli\", \"utility\"]\nclassifiers = [\n    \"Programming Language :: Python :: 3\",\n    \"License :: OSI Approved :: MIT License\",\n    \"Operating System :: OS Independent\",\n    \"Topic :: Text Processing\",\n    \"Intended Audience :: Developers\",\n    \"Development Status :: 3 - Alpha\",\n]\n\ndependencies = [] # NFR5: std lib only, so no external dependencies\n\n[project.scripts]\nhowmany = \"substring_counter.__main__:main\"\n\n[project.optional-dependencies]\ndev = [\"pytest>=7.0.0\"]\n\n[build-system]\nrequires = [\"setuptools>=61.0\"]\nbuild-backend = \"setuptools.build_meta\"\n\n[tool.setuptools.packages.find]\nwhere = [\"src\"]\n\n```\n```python\n# src/substring_counter/exceptions.py\nclass InvalidInputError(ValueError):\n    \"\"\"\n    Exception raised for invalid input according to business rules.\n    This includes non-string types or an empty substring.\n    \"\"\"\n    pass\n\n```\n```python\n# src/substring_counter/core.py\nclass SubstringCounter:\n    \"\"\"\n    Provides the core algorithm to count occurrences of a substring, allowing overlaps.\n    This class is stateless and does not perform input validation.\n    \"\"\"\n    def __init__(self) -> None:\n        pass\n\n    def count(self, string: str, substring: str) -> int:\n        \"\"\"\n        Counts how many times a substring appears in a string, including overlapping occurrences.\n        Returns 0 if the substring is longer than the string or the string is empty.\n        \"\"\"\n        n, m = len(string), len(substring)\n        if m == 0 or m > n:\n            return 0\n        \n        count = 0\n        for i in range(n - m + 1):\n            if string[i:i+m] == substring:\n                count += 1\n        return count\n\n```\n```python\n# src/substring_counter/validator.py\nfrom .exceptions import InvalidInputError\n\nclass InputValidator:\n    \"\"\"\n    Validates input strings and substrings according to business rules.\n    Raises InvalidInputError for invalid inputs.\n    \"\"\"\n    def __init__(self) -> None:\n        pass\n\n    def validate_string(self, string: str) -> None:\n        \"\"\"\n        Ensures the provided string is an instance of str.\n        Raises InvalidInputError if validation fails.\n        \"\"\"\n        if not isinstance(string, str):\n            raise InvalidInputError(\"source string must be a str\")\n\n    def validate_substring(self, substring: str) -> None:\n        \"\"\"\n        Ensures the provided substring is an instance of str and is not empty.\n        Raises InvalidInputError if validation fails.\n        \"\"\"\n        if not isinstance(substring, str):\n            raise InvalidInputError(\"substring must be a str\")\n        if not substring:  # Check for empty string\n            raise InvalidInputError(\"substring must not be empty\")\n\n```\n```python\n# src/substring_counter/service.py\nfrom typing import TYPE_CHECKING\n\n# To avoid potential circular imports and enable type checking for injected dependencies\nif TYPE_CHECKING:\n    from .validator import InputValidator\n    from .core import SubstringCounter\n\nclass CountService:\n    \"\"\"\n    Application service that coordinates input validation and substring counting.\n    It injects dependencies for testability and modularity.\n    \"\"\"\n    validator: 'InputValidator'\n    counter: 'SubstringCounter'\n\n    def __init__(self, validator: 'InputValidator', counter: 'SubstringCounter') -> None:\n        \"\"\"\n        Initializes CountService with injected validator and counter instances.\n        \"\"\"\n        self.validator = validator\n        self.counter = counter\n\n    def count_with_validation(self, string: str, substring: str) -> int:\n        \"\"\"\n        Validates the input strings and then counts substring occurrences.\n        Raises InvalidInputError on validation failure.\n        \"\"\"\n        self.validator.validate_string(string)\n        self.validator.validate_substring(substring)\n        return self.counter.count(string, substring)\n\n```\n```python\n# src/substring_counter/cli.py\nimport sys\nfrom typing import Sequence, Tuple\n\nfrom .exceptions import InvalidInputError\nfrom .service import CountService \n\nclass CLIController:\n    \"\"\"\n    Handles command-line interface logic: parsing arguments, invoking the service,\n    and printing results or error messages with appropriate exit codes.\n    \"\"\"\n    def __init__(self, service: CountService, argv: Sequence[str]) -> None:\n        \"\"\"\n        Initializes the CLIController with an injected CountService and command-line arguments.\n        \"\"\"\n        self.service = service\n        self.argv = argv\n\n    def parse_args(self) -> Tuple[str, str]:\n        \"\"\"\n        Parses command-line arguments to extract the source string and substring.\n        Raises InvalidInputError if arguments are missing or incorrect.\n        \"\"\"\n        if len(self.argv) != 2:\n            raise InvalidInputError(\"requires exactly two positional arguments: <string> <substring>\")\n        return self.argv[0], self.argv[1]\n\n    def run(self) -> int:\n        \"\"\"\n        Executes the CLI logic, including argument parsing, calling the service,\n        printing the result, and handling errors with appropriate exit codes.\n        \"\"\"\n        try:\n            string, substring = self.parse_args()\n            count = self.service.count_with_validation(string, substring)\n            print(count)\n            return 0\n        except InvalidInputError as e:\n            print(f\"Error: {e}\", file=sys.stderr)\n            return 2\n        except Exception as e:\n            print(f\"An unexpected error occurred: {e}\", file=sys.stderr)\n            return 1\n\n```\n```python\n# src/substring_counter/__init__.py\nfrom .validator import InputValidator\nfrom .core import SubstringCounter\nfrom .service import CountService\nfrom .exceptions import InvalidInputError\n\n__all__ = [\"count\", \"InvalidInputError\"]\n\ndef count(string: str, substring: str) -> int:\n    \"\"\"\n    Counts how many times a substring appears in a string, allowing overlaps.\n    Provides the primary programmatic interface for the library.\n    \"\"\"\n    validator = InputValidator()\n    counter = SubstringCounter()\n    service = CountService(validator, counter)\n    return service.count_with_validation(string, substring)\n\n```\n```python\n# src/substring_counter/__main__.py\nimport sys\nfrom typing import Sequence\n\nfrom .validator import InputValidator\nfrom .core import SubstringCounter\nfrom .service import CountService\nfrom .cli import CLIController\n\ndef main(argv: Sequence[str] = None) -> int:\n    \"\"\"\n    Main entry point for the CLI. Sets up dependencies and runs the CLIController.\n    \"\"\"\n    if argv is None:\n        argv = sys.argv[1:]  # Use sys.argv by default if not provided\n\n    validator = InputValidator()\n    counter = SubstringCounter()\n    service = CountService(validator, counter)\n    cli_controller = CLIController(service, argv)\n    return cli_controller.run()\n\nif __name__ == \"__main__\":\n    sys.exit(main())\n\n```"}
