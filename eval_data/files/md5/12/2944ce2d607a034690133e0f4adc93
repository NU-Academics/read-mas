{"task_id": "HumanEval/19", "solution": "```python\n# src/numsort/constants.py\nVALID_WORDS = [\"zero\", \"one\", \"two\", \"three\", \"four\", \"five\", \"six\", \"seven\", \"eight\", \"nine\"]\nWORD_TO_VALUE = {\n    \"zero\": 0, \"one\": 1, \"two\": 2, \"three\": 3, \"four\": 4,\n    \"five\": 5, \"six\": 6, \"seven\": 7, \"eight\": 8, \"nine\": 9\n}\nVALUE_TO_WORD = {v: k for k, v in WORD_TO_VALUE.items()}\n```\n\n```python\n# src/numsort/exceptions.py\nfrom typing import List\n\nclass InvalidTokenError(Exception):\n    \"\"\"Exception raised for invalid number words in the input.\"\"\"\n    def __init__(self, invalid_tokens: List[str]):\n        self.invalid_tokens = invalid_tokens\n        super().__init__(f\"Invalid tokens found: {', '.join(invalid_tokens)}\")\n```\n\n```python\n# src/numsort/models/number_word.py\nfrom ..exceptions import InvalidTokenError\nfrom ..constants import WORD_TO_VALUE\n\nclass NumberWord:\n    \"\"\"Represents a number word with its string and numeric value.\"\"\"\n    def __init__(self, word: str, value: int):\n        self.word = word\n        self.value = value\n\n    @classmethod\n    def from_word(cls, word: str) -> 'NumberWord':\n        \"\"\"Factory method to create NumberWord from a string word.\"\"\"\n        try:\n            value = WORD_TO_VALUE[word]\n        except KeyError:\n            raise InvalidTokenError([word])\n        return cls(word, value)\n\n    def to_word(self) -> str:\n        \"\"\"Returns the canonical string representation of the word.\"\"\"\n        return self.word\n\n    def __lt__(self, other: 'NumberWord') -> bool:\n        \"\"\"Compares two NumberWord instances based on their numeric value.\"\"\"\n        return self.value < other.value\n\n    def __repr__(self) -> str:\n        return f\"NumberWord(word='{self.word}', value={self.value})\"\n\n    def __eq__(self, other: object) -> bool:\n        if not isinstance(other, NumberWord):\n            return NotImplemented\n        return self.value == other.value\n\n    def __hash__(self) -> int:\n        return hash(self.value)\n```\n\n```python\n# src/numsort/utils/validator.py\nfrom typing import List\nfrom ..constants import VALID_WORDS\nfrom ..exceptions import InvalidTokenError\n\nclass Validator:\n    \"\"\"Validates input string for allowed number words.\"\"\"\n    def validate_input(self, s: str) -> None:\n        \"\"\"Raises InvalidTokenError if any token is not a valid number word.\"\"\"\n        tokens = s.split()\n        invalid = [t for t in tokens if t not in VALID_WORDS]\n        if invalid:\n            raise InvalidTokenError(invalid)\n```\n\n```python\n# src/numsort/adapters/mapper.py\nfrom typing import List\nfrom ..models.number_word import NumberWord\nfrom ..exceptions import InvalidTokenError\n\nclass NumberMapper:\n    \"\"\"Converts a list of string tokens into a list of NumberWord objects.\"\"\"\n    def parse(self, tokens: List[str]) -> List[NumberWord]:\n        \"\"\"Maps each token to a NumberWord, collecting any invalid ones.\"\"\"\n        words = []\n        invalid_tokens_found = []\n        for t in tokens:\n            try:\n                words.append(NumberWord.from_word(t))\n            except InvalidTokenError as e:\n                invalid_tokens_found.extend(e.invalid_tokens)\n        \n        if invalid_tokens_found:\n            raise InvalidTokenError(invalid_tokens_found)\n        return words\n```\n\n```python\n# src/numsort/adapters/formatter.py\nfrom typing import List\nfrom ..models.number_word import NumberWord\n\nclass Formatter:\n    \"\"\"Formats a list of NumberWord objects into a space-delimited string.\"\"\"\n    def format(self, words: List[NumberWord]) -> str:\n        \"\"\"Joins NumberWord objects' string representations with single spaces.\"\"\"\n        return \" \".join(w.to_word() for w in words)\n```\n\n```python\n# src/numsort/services/sorter_service.py\nfrom typing import List\nfrom ..adapters.mapper import NumberMapper\nfrom ..adapters.formatter import Formatter\nfrom ..utils.validator import Validator\nfrom ..exceptions import InvalidTokenError\n\nclass NumberSorterService:\n    \"\"\"Orchestrates number word sorting: validates, maps, sorts, and formats.\"\"\"\n    def __init__(self, mapper: NumberMapper, formatter: Formatter, validator: Validator):\n        \"\"\"Initializes the service with its dependencies.\"\"\"\n        self.mapper = mapper\n        self.formatter = formatter\n        self.validator = validator\n\n    def sort(self, numbers: str) -> str:\n        \"\"\"Sorts a space-delimited string of number words.\"\"\"\n        self.validator.validate_input(numbers)\n        tokens = numbers.split()\n        words = self.mapper.parse(tokens)\n        words.sort()\n        return self.formatter.format(words)\n```\n\n```python\n# src/numsort/controllers/cli.py\nimport sys\nfrom typing import List\nfrom ..services.sorter_service import NumberSorterService\nfrom ..adapters.mapper import NumberMapper\nfrom ..adapters.formatter import Formatter\nfrom ..utils.validator import Validator\nfrom ..exceptions import InvalidTokenError\n\nclass CLIController:\n    \"\"\"Handles command-line interface interactions for numsort.\"\"\"\n    def __init__(self, service: NumberSorterService):\n        \"\"\"Initializes the CLI controller with a sorting service.\"\"\"\n        self.service = service\n\n    def run(self, argv: List[str]) -> int:\n        \"\"\"Executes the CLI command, parses arguments, and prints output.\"\"\"\n        if not argv or len(argv) != 1:\n            print(\"Usage: numsort \\\"<space-delimited-number-words>\\\"\", file=sys.stderr)\n            return 1\n\n        input_string = argv[0]\n        try:\n            result = self.service.sort(input_string)\n            print(result)\n            return 0\n        except InvalidTokenError as e:\n            print(f\"Error: {e}\", file=sys.stderr)\n            return 2\n        except Exception as e:\n            print(f\"An unexpected error occurred: {e}\", file=sys.stderr)\n            return 2\n\ndef main():\n    \"\"\"Main entry point for the numsort CLI.\"\"\"\n    default_service = NumberSorterService(\n        mapper=NumberMapper(),\n        formatter=Formatter(),\n        validator=Validator()\n    )\n    controller = CLIController(service=default_service)\n    sys.exit(controller.run(sys.argv[1:]))\n```\n\n```python\n# src/numsort/__init__.py\nfrom .services.sorter_service import NumberSorterService\nfrom .adapters.mapper import NumberMapper\nfrom .adapters.formatter import Formatter\nfrom .utils.validator import Validator\n\n# Public API function\ndef sort_numbers(numbers: str) -> str:\n    \"\"\"Converts and sorts a space-delimited string of number words (zero..nine).\"\"\"\n    service = NumberSorterService(mapper=NumberMapper(), formatter=Formatter(), validator=Validator())\n    return service.sort(numbers)\n\n# Helper for internal use, e.g., by CLI, to create a default service.\ndef _make_default_service() -> NumberSorterService:\n    \"\"\"Helper to create a default configured NumberSorterService instance.\"\"\"\n    return NumberSorterService(mapper=NumberMapper(), formatter=Formatter(), validator=Validator())\n```\n\n```toml\n# pyproject.toml\n[build-system]\nrequires = [\"poetry-core>=1.0.0\"]\nbuild-backend = \"poetry.core.masonry.api\"\n\n[tool.poetry]\nname = \"numsort\"\nversion = \"0.1.0\"\ndescription = \"A library and CLI to sort English number words (zero..nine).\"\nauthors = [\"Your Name <you@example.com>\"]\nlicense = \"MIT\"\nreadme = \"README.md\"\npackages = [{include = \"numsort\", from = \"src\"}]\n\n[tool.poetry.dependencies]\npython = \">=3.9,<4.0\"\n\n[tool.poetry.group.dev.dependencies]\npytest = \"^7.0\"\n\n[tool.poetry.scripts]\nnumsort = \"numsort.controllers.cli:main\"\n```\n\n```markdown\n# README.md\n\n`numsort` is a Python library and command-line tool that sorts space-delimited English number words (zero to nine) in ascending order.\n\n## Installation\n\n```bash\n# Using pip\npip install numsort\n\n# Using poetry (for development)\ngit clone https://github.com/your-username/numsort.git # Replace with actual repo\ncd numsort\npoetry install\n```\n\n## Library Usage\n\nThe core sorting functionality is available via the `sort_numbers` function:\n\n```python\nfrom numsort import sort_numbers\n\n# Example 1: Basic sorting\ninput_str = \"three one five\"\nsorted_str = sort_numbers(input_str)\nprint(sorted_str)\n# Output: one three five\n\n# Example 2: With duplicates\ninput_str = \"nine eight nine\"\nsorted_str = sort_numbers(input_str)\nprint(sorted_str)\n# Output: eight nine nine\n\n# Example 3: Empty input\ninput_str = \"\"\nsorted_str = sort_numbers(input_str)\nprint(sorted_str)\n# Output:\n\n# Example 4: Invalid input (raises InvalidTokenError)\ntry:\n    sort_numbers(\"one two eleven\")\nexcept Exception as e:\n    print(f\"Error: {e}\")\n# Output: Error: Invalid tokens found: eleven\n```\n\n## Command-Line Interface (CLI) Usage\n\nThe `numsort` command provides a convenient way to sort number words from your terminal.\n\n```bash\n# Sort number words\nnumsort \"three one five\"\n# Output: one three five\n\n# Handle duplicates\nnumsort \"nine eight nine\"\n# Output: eight nine nine\n\n# Empty input\nnumsort \"\"\n# Output:\n\n# Invalid input\nnumsort \"one two eleven\"\n# Output: Error: Invalid tokens found: eleven (and exits with code 2)\n\n# Incorrect usage\nnumsort\n# Output: Usage: numsort \"<space-delimited-number-words>\" (and exits with code 1)\n```\n\n## Development\n\n### Project Structure\n```\nsrc/\n\u2514\u2500\u2500 numsort/\n    \u251c\u2500\u2500 __init__.py         # Package exports, sort_numbers API\n    \u251c\u2500\u2500 models/\n    \u2502   \u2514\u2500\u2500 number_word.py  # NumberWord domain model\n    \u251c\u2500\u2500 services/\n    \u2502   \u2514\u2500\u2500 sorter_service.py # Core business logic\n    \u251c\u2500\u2500 adapters/\n    \u2502   \u251c\u2500\u2500 mapper.py       # Converts tokens to NumberWord\n    \u2502   \u2514\u2500\u2500 formatter.py    # Converts NumberWord list to string\n    \u251c\u2500\u2500 controllers/\n    \u2502   \u2514\u2500\u2500 cli.py          # CLI entrypoint\n    \u251c\u2500\u2500 utils/\n    \u2502   \u2514\u2500\u2500 validator.py    # Input validation\n    \u251c\u2500\u2500 exceptions.py       # Custom exceptions\n    \u2514\u2500\u2500 constants.py        # Shared constants\n```\n\n### Running Tests\n\nUnit tests are located in the `tests/` directory.\n\n```bash\npoetry run pytest\n```\n\n## Contributing\n\nContributions are welcome! Please open an issue or submit a pull request.\n```\n\n```yaml\n# .github/workflows/ci.yml\nname: CI\n\non:\n  push:\n    branches:\n      - main\n      - develop\n  pull_request:\n    branches:\n      - main\n      - develop\n\njobs:\n  build:\n    runs-on: ubuntu-latest\n    strategy:\n      matrix:\n        python-version: [\"3.9\", \"3.10\", \"3.11\", \"3.12\"]\n\n    steps:\n    - uses: actions/checkout@v4\n    - name: Set up Python ${{ matrix.python-version }}\n      uses: actions/setup-python@v5\n      with:\n        python-version: ${{ matrix.python-version }}\n        cache: 'poetry'\n\n    - name: Install Poetry\n      run: pip install poetry\n\n    - name: Install dependencies\n      run: poetry install --no-root\n\n    - name: Run tests\n      run: poetry run pytest\n```\n\n```python\n# tests/test_sorter_service.py\n# Unit tests for NumberSorterService will go here.\n# (Content intentionally left blank as per instructions)\n```\n\n```python\n# tests/test_mapper.py\n# Unit tests for NumberMapper will go here.\n# (Content intentionally left blank as per instructions)\n```\n\n```python\n# tests/test_validator.py\n# Unit tests for Validator will go here.\n# (Content intentionally left blank as per instructions)\n```"}
{"task_id": "HumanEval/19", "solution": "```python\nimport uuid\nimport datetime\nfrom typing import List, Dict, Tuple, Optional\n\n# Domain-specific exceptions as per the design specification\nclass InvalidInputError(Exception):\n    \"\"\"Raised when the input string itself is invalid (e.g., None).\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n\nclass InvalidTokenError(Exception):\n    \"\"\"Raised when a specific token in the input string is not a recognized numeral word.\"\"\"\n    def __init__(self, token: str, message: str = None):\n        super().__init__(message or f\"Invalid numeral token: '{token}'\")\n        self.token = token\n\n# Configuration constants, derived from src/numeral_sorter/config.py\nVALID_NUMERALS: Dict[str, int] = {\n    \"zero\": 0, \"one\": 1, \"two\": 2, \"three\": 3, \"four\": 4,\n    \"five\": 5, \"six\": 6, \"seven\": 7, \"eight\": 8, \"nine\": 9\n}\n\n# Data Transfer Objects (DTOs) as per src/numeral_sorter/dtos.py\nclass SortRequest:\n    \"\"\"DTO for incoming sort requests.\"\"\"\n    def __init__(self, numbers: str):\n        self.numbers = numbers\n\nclass SortResponse:\n    \"\"\"DTO for outgoing sort responses.\"\"\"\n    def __init__(self, sorted_str: str):\n        self.sorted = sorted_str\n\n# Component for tokenizing input strings, from src/numeral_sorter/string_parser.py\nclass StringParser:\n    \"\"\"Handles parsing a space-delimited string into a list of tokens.\"\"\"\n    def parse(self, numbers: Optional[str]) -> List[str]:\n        \"\"\"Parses the input string into tokens, validating for None. Returns an empty list for empty strings.\"\"\"\n        if numbers is None:\n            raise InvalidInputError(\"Input must be a string, got None\")\n        s = numbers.strip()\n        if not s:\n            return []\n        return s.split()\n\n# Component for mapping numeral words to integers, from src/numeral_sorter/numeral_mapper.py\nclass NumeralMapper:\n    \"\"\"Provides functionality to map numeral words to their integer values and vice-versa.\"\"\"\n    def __init__(self, mapping: Dict[str, int] = VALID_NUMERALS):\n        \"\"\"Initializes the mapper with a dictionary of supported numeral words.\"\"\"\n        self._mapping = {k.lower(): v for k, v in mapping.items()}\n        self._reverse_mapping = {v: k for k, v in self._mapping.items()}\n\n    def canonical(self, word: str) -> str:\n        \"\"\"Returns the lowercase, stripped form of a word for consistent lookup.\"\"\"\n        return word.strip().lower()\n\n    def word_to_int(self, word: str) -> int:\n        \"\"\"Converts a numeral word to its integer value, raising InvalidTokenError if unknown.\"\"\"\n        cw = self.canonical(word)\n        if cw not in self._mapping:\n            raise InvalidTokenError(token=word)\n        return self._mapping[cw]\n\n    def int_to_word(self, i: int) -> str:\n        \"\"\"Converts an integer (0-9) to its canonical numeral word, raising ValueError if out of range.\"\"\"\n        if i not in self._reverse_mapping:\n            raise ValueError(f\"Integer {i} out of bounds for numeral mapping (0-9)\")\n        return self._reverse_mapping[i]\n\n# In-memory repository for storing history, from src/numeral_sorter/repository.py (simplified)\nclass InMemoryRepository:\n    \"\"\"Stores request and result history in memory.\"\"\"\n    def __init__(self):\n        \"\"\"Initializes an empty list to hold historical records.\"\"\"\n        self._data: List[Dict] = []\n\n    def save(self, record: Dict) -> str:\n        \"\"\"Adds a new record, assigning a unique ID and timestamp.\"\"\"\n        record_id = str(uuid.uuid4())\n        record[\"id\"] = record_id\n        record[\"timestamp\"] = datetime.datetime.now(datetime.timezone.utc).isoformat()\n        self._data.append(record)\n        return record_id\n\n    def list_all(self) -> List[Dict]:\n        \"\"\"Returns a copy of all stored history records.\"\"\"\n        return list(self._data)\n\n# Core service orchestrating the sorting logic, from src/numeral_sorter/sort_service.py\nclass SortService:\n    \"\"\"Orchestrates the process of parsing, mapping, sorting, and optionally persisting numeral requests.\"\"\"\n    def __init__(self, parser: StringParser, mapper: NumeralMapper, repository: Optional[InMemoryRepository] = None):\n        \"\"\"Initializes the service with required parser and mapper components, and an optional repository.\"\"\"\n        self.parser = parser\n        self.mapper = mapper\n        self.repo = repository\n\n    def _sort_pairs(self, pairs: List[Tuple[int, str]]) -> List[str]:\n        \"\"\"Sorts a list of (numeric_value, original_word) tuples, maintaining stable order for ties.\"\"\"\n        # Python's `sorted()` function provides a stable sort, preserving original relative order for equal keys.\n        return [word for _, word in sorted(pairs, key=lambda p: p[0])]\n\n    def sort_numbers(self, request: SortRequest) -> SortResponse:\n        \"\"\"Executes the full sorting workflow from a request to a sorted response.\"\"\"\n        tokens = self.parser.parse(request.numbers)\n        \n        mapped_pairs: List[Tuple[int, str]] = []\n        for tok in tokens:\n            num_value = self.mapper.word_to_int(tok) # Validates token and gets its numeric value\n            mapped_pairs.append((num_value, tok)) # Stores original token casing for output\n\n        sorted_original_words = self._sort_pairs(mapped_pairs)\n        result_string = \" \".join(sorted_original_words)\n\n        if self.repo:\n            record = {\"input\": request.numbers, \"output\": result_string}\n            try:\n                self.repo.save(record)\n            except Exception:\n                # Log any repository persistence failures but allow the main request to succeed.\n                pass \n        return SortResponse(result_string)\n\ndef sort_numbers(numbers: str) -> str:\n    \"\"\" Input is a space-delimited string of English numeral words from 'zero' to 'nine'.\n    Return the string with numbers sorted from smallest to largest by numeric value.\n    \"\"\"\n    # Instantiate the core components (dependencies) as required by the design.\n    parser = StringParser()\n    mapper = NumeralMapper()\n    # The 'sort_numbers' function signature does not provide configuration for history.\n    # Therefore, the repository is set to None, disabling history persistence for this entry point.\n    service = SortService(parser=parser, mapper=mapper, repository=None)\n\n    # Wrap the input string in a DTO and call the service.\n    request = SortRequest(numbers)\n    response = service.sort_numbers(request)\n    return response.sorted\n```"}
