odd_collatz_app/config.py\n\"\"\"\nCentralized configuration for the odd_collatz_app.\nManages cache settings and logging level.\n\"\"\"\n\nimport os\n\nclass AppConfig:\n    \"\"\"Application configuration settings.\"\"\"\n    CACHE_ENABLED: bool = True\n    CACHE_PATH: str = \"~/.cache/odd_collatz/cache.json\"\n    LOG_LEVEL: str = \"INFO\"\n\n    @staticmethod\n    def expand_cache_path(path: str) -> str:\n        \"\"\"Expands user and environment variables in a path string.\"\"\"\n        return os.path.abspath(os.path.expanduser(os.path.expandvars(path)))\n\n# src/odd_collatz_app/exceptions.py\n\"\"\"\nCustom exception classes for the odd_collatz_app.\nProvides specific error types for input and computation issues.\n\"\"\"\n\nclass InvalidInputError(Exception):\n    \"\"\"Raised when an input value is invalid according to business rules.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\nclass CollatzComputationError(Exception):\n    \"\"\"Raised when an error occurs during the Collatz sequence computation.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\n# src/odd_collatz_app/models.py\n\"\"\"\nDomain models for the odd_collatz_app.\nDefines the CollatzResult dataclass for computation outcomes.\n\"\"\"\n\nfrom dataclasses import dataclass\nfrom datetime import datetime\nfrom typing import List, Dict, Any\n\n@dataclass\nclass CollatzResult:\n    \"\"\"Represents the result of a Collatz sequence computation.\"\"\"\n    n: int\n    odd_numbers: List[int]\n    computed_at: datetime\n\n    def to_dict(self) -> Dict[str, Any]:\n        \"\"\"Serializes the CollatzResult to a dictionary.\"\"\"\n        return {\n            \"n\": self.n,\n            \"odd_numbers\": self.odd_numbers,\n            \"computed_at\": self.computed_at.isoformat() + 'Z',\n        }\n\n    @staticmethod\n    def from_dict(data: Dict[str, Any]) -> \"CollatzResult\":\n        \"\"\"Creates a CollatzResult instance from a dictionary.\"\"\"\n        try:\n            return CollatzResult(\n                n=data[\"n\"],\n                odd_numbers=data[\"odd_numbers\"],\n                computed_at=datetime.fromisoformat(data[\"computed_at\"].replace('Z', '+00:00'))\n            )\n        except (KeyError, TypeError, ValueError) as e:\n            raise ValueError(f\"Malformed CollatzResult data: {e}\") from e\n\n# src/odd_collatz_app/utils.py\n\"\"\"\nSmall helper functions for file I/O and time formatting.\nIncludes safe JSON read/write operations.\n\"\"\"\n\nimport json\nimport os\nimport shutil\nimport logging\nfrom datetime import datetime, timezone\nfrom typing import Any, Optional, Dict\n\nlogger = logging.getLogger(__name__)\n\ndef safe_write_json(path: str, data: Any) -> None:\n    \"\"\"Atomically writes data to a JSON file, creating parent directories if needed.\"\"\"\n    try:\n        os.makedirs(os.path.dirname(path), exist_ok=True)\n        temp_path = f\"{path}.tmp\"\n        with open(temp_path, \"w\", encoding=\"utf-8\") as f:\n            json.dump(data, f, indent=2)\n        shutil.move(temp_path, path)\n    except IOError as e:\n        logger.error(f\"Failed to write JSON to {path}: {e}\")\n    except Exception as e:\n        logger.error(f\"An unexpected error occurred during JSON write to {path}: {e}\")\n\ndef safe_read_json(path: str) -> Optional[Dict[str, Any]]:\n    \"\"\"Safely reads and parses JSON from a file, returning None on error or missing file.\"\"\"\n    if not os.path.exists(path):\n        return None\n    try:\n        with open(path, \"r\", encoding=\"utf-8\") as f:\n            return json.load(f)\n    except json.JSONDecodeError as e:\n        logger.warning(f\"Failed to decode JSON from {path}. Backing up corrupted file. Error: {e}\")\n        # Backup corrupted file\n        timestamp = datetime.now().strftime(\"%Y%m%d%H%M%S\")\n        corrupt_path = f\"{path}.corrupt.{timestamp}\"\n        try:\n            shutil.move(path, corrupt_path)\n            logger.info(f\"Corrupted cache file moved to {corrupt_path}\")\n        except IOError as move_e:\n            logger.error(f\"Could not move corrupted cache file {path}: {move_e}\")\n        return None\n    except IOError as e:\n        logger.error(f\"Failed to read JSON from {path}: {e}\")\n        return None\n    except Exception as e:\n        logger.error(f\"An unexpected error occurred during JSON read from {path}: {e}\")\n        return None\n\ndef now_iso() -> str:\n    \"\"\"Returns the current UTC time as an ISO 8601 string with 'Z' suffix.\"\"\"\n    return datetime.now(timezone.utc).isoformat(timespec='seconds').replace('+00:00', 'Z')\n\n# src/odd_collatz_app/validators.py\n\"\"\"\nInput validation utilities for the odd_collatz_app.\nEnsures inputs conform to required types and constraints.\n\"\"\"\n\nfrom typing import Any\nfrom .exceptions import InvalidInputError\n\nclass InputValidator:\n    \"\"\"A utility class for validating various types of inputs.\"\"\"\n\n    def validate_positive_int(self, value: Any) -> int:\n        \"\"\"Validates if a value is a positive integer (>0).\"\"\"\n        try:\n            validated_int = int(value)\n        except (TypeError, ValueError) as e:\n            raise InvalidInputError(f\"Input '{value}' is not a valid integer.\") from e\n        \n        if validated_int <= 0:\n            raise InvalidInputError(\"Input must be a positive integer greater than 0.\")\n        \n        return validated_int\n\n# src/odd_collatz_app/repositories.py\n\"\"\"\nRepository for managing cached Collatz sequence results.\nHandles persistence to a local JSON file.\n\"\"\"\n\nimport logging\nimport os\nfrom typing import Optional, Dict, Any\nfrom odd_collatz_app.models import CollatzResult\nfrom odd_collatz_app.utils import safe_read_json, safe_write_json\n\nlogger = logging.getLogger(__name__)\n\nclass FileCacheRepository:\n    \"\"\"Manages reading and writing Collatz results to a JSON cache file.\"\"\"\n    def __init__(self, path: str, enabled: bool = True) -> None:\n        self._path = path\n        self._enabled = enabled\n        self._cache: Optional[Dict[str, Any]] = None # In-memory cache\n\n    @property\n    def enabled(self) -> bool:\n        \"\"\"Checks if caching is enabled.\"\"\"\n        return self._enabled\n\n    def get(self, n: int) -> Optional[CollatzResult]:\n        \"\"\"Retrieves a cached CollatzResult for a given integer n.\"\"\"\n        if not self._enabled:\n            return None\n        \n        cache_data = self._load_cache()\n        entry = cache_data.get(str(n))\n        if entry:\n            try:\n                return CollatzResult.from_dict(entry)\n            except ValueError as e:\n                logger.warning(f\"Corrupted cache entry for {n} in {self._path}: {e}. Ignoring entry.\")\n                self._remove_entry_and_save(str(n)) # Remove bad entry\n        return None\n\n    def set(self, n: int, result: CollatzResult) -> None:\n        \"\"\"Stores a CollatzResult in the cache for integer n.\"\"\"\n        if not self._enabled:\n            return\n        \n        cache_data = self._load_cache()\n        cache_data[str(n)] = result.to_dict()\n        self._write_cache(cache_data)\n\n    def _load_cache(self) -> Dict[str, Any]:\n        \"\"\"Loads the cache from the file or returns an empty dictionary.\"\"\"\n        if self._cache is None:\n            data = safe_read_json(self._path)\n            # Basic migration: if old schema (list) is detected, clear and log\n            if isinstance(data, list):\n                logger.warning(f\"Detected old cache schema in {self._path}. Recreating cache.\")\n                self._cache = {}\n                self._write_cache(self._cache) # Write empty cache\n            else:\n                self._cache = data if data is not None else {}\n        return self._cache\n\n    def _write_cache(self, cache: Dict[str, Any]) -> None:\n        \"\"\"Writes the current cache state to the file.\"\"\"\n        safe_write_json(self._path, cache)\n        self._cache = cache # Update in-memory cache\n\n    def _remove_entry_and_save(self, key: str) -> None:\n        \"\"\"Removes a specific entry from the cache and saves the updated cache.\"\"\"\n        if self._cache and key in self._cache:\n            del self._cache[key]\n            self._write_cache(self._cache)\n\n\n# src/odd_collatz_app/services.py\n\"\"\"\nCore business logic and orchestration for the odd_collatz_app.\nManages Collatz sequence computation, validation, and caching.\n\"\"\"\n\nimport logging\nfrom datetime import datetime, timezone\nfrom typing import List, Optional\n\nfrom odd_collatz_app.exceptions import InvalidInputError, CollatzComputationError\nfrom odd_collatz_app.models import CollatzResult\nfrom odd_collatz_app.repositories import FileCacheRepository\nfrom odd_collatz_app.validators import InputValidator\n\nlogger = logging.getLogger(__name__)\n\nclass CollatzService:\n    \"\"\"Provides Collatz sequence computation and caching functionalities.\"\"\"\n    MAX_STEPS = 10_000_000 # Safety threshold for Collatz computation\n\n    def __init__(self, repository: Optional[FileCacheRepository] = None,\n                 validator: Optional[InputValidator] = None) -> None:\n        self.repository = repository\n        self.validator = validator or InputValidator()\n\n    def get_odd_collatz(self, n: int) -> List[int]:\n        \"\"\"\n        Computes or retrieves sorted odd numbers from the Collatz sequence for n.\n        Validates input, checks cache, computes if necessary, and updates cache.\n        \"\"\"\n        n_valid = self.validator.validate_positive_int(n)\n\n        if self.repository and self.repository.enabled:\n            cached_result = self.repository.get(n_valid)\n            if cached_result:\n                logger.info(f\"Cache hit for n={n_valid}\")\n                return list(cached_result.odd_numbers) # Return a copy\n\n        logger.info(f\"Computing Collatz sequence for n={n_valid}\")\n        odd_numbers = self._compute_collatz_odds(n_valid)\n        result = CollatzResult(n=n_valid, odd_numbers=odd_numbers, computed_at=datetime.now(timezone.utc))\n\n        if self.repository and self.repository.enabled:\n            self.repository.set(n_valid, result)\n            logger.info(f\"Cache updated for n={n_valid}\")\n\n        return result.odd_numbers\n\n    def _compute_collatz_odds(self, n: int) -> List[int]:\n        \"\"\"\n        Calculates the Collatz sequence for n and collects all unique odd numbers.\n        Includes a safety break for extremely long sequences.\n        \"\"\"\n        current = n\n        odd_set: set[int] = set()\n        steps = 0\n\n        while True:\n            if current % 2 == 1:\n                odd_set.add(current)\n            \n            if current == 1:\n                break\n            \n            if current % 2 == 0:\n                current //= 2\n            else:\n                current = 3 * current + 1\n            \n            steps += 1\n            if steps > self.MAX_STEPS:\n                raise CollatzComputationError(\n                    f\"Collatz sequence computation for {n} exceeded maximum steps ({self.MAX_STEPS}). \"\n                    \"This might indicate an extremely long sequence or a problem.\"\n                )\n        return sorted(list(odd_set))\n\n# src/odd_collatz_app/controllers.py\n\"\"\"\nCLI controller logic for the odd_collatz_app.\nHandles command-line argument parsing and interacts with the CollatzService.\n\"\"\"\n\nimport json\nimport sys\nimport logging\nfrom typing import List\n\nfrom odd_collatz_app.exceptions import InvalidInputError, CollatzComputationError\nfrom odd_collatz_app.services import CollatzService\n\nlogger = logging.getLogger(__name__)\n\nclass CLIController:\n    \"\"\"Manages the command-line interface interactions for the application.\"\"\"\n    def __init__(self, service: CollatzService) -> None:\n        self.service = service\n\n    def run(self, argv: List[str]) -> int:\n        \"\"\"\n        Executes the CLI command based on provided arguments.\n        Parses arguments, calls the service, and prints results or errors.\n        \"\"\"\n        if len(argv) < 2:\n            print(\"Usage: odd-collatz <positive_integer>\", file=sys.stderr)\n            return 2 # Exit code for invalid arguments\n        \n        try:\n            n_arg = argv[1]\n            # The validator in CollatzService.get_odd_collatz handles string conversion\n            odd_collatz_numbers = self.service.get_odd_collatz(n_arg)\n            print(self._format_result(odd_collatz_numbers))\n            return 0 # Success exit code\n        except InvalidInputError as e:\n            print(f\"Error: Invalid input: {e}\", file=sys.stderr)\n            return 2 # Exit code for invalid input\n        except CollatzComputationError as e:\n            print(f\"Error: Computation failed: {e}\", file=sys.stderr)\n            return 3 # Exit code for computation error\n        except Exception as e:\n            logger.exception(\"An unexpected error occurred during CLI execution.\")\n            print(f\"An unexpected error occurred: {e}\", file=sys.stderr)\n            return 1 # Generic error code\n\n    def _format_result(self, result: List[int]) -> str:\n        \"\"\"Formats the list of integers as a JSON array string.\"\"\"\n        return json.dumps(result)\n\n# src/odd_collatz_app/__main__.py\n\"\"\"\nMain entry point for the odd_collatz_app CLI.\nSets up the application and runs the CLI controller.\n\"\"\"\n\nimport sys\nimport logging\nfrom typing import List, Optional\n\nfrom odd_collatz_app.config import AppConfig\nfrom odd_collatz_app.repositories import FileCacheRepository\nfrom odd_collatz_app.services import CollatzService\nfrom odd_collatz_app.controllers import CLIController\n\n# Setup basic logging\nlogging.basicConfig(level=getattr(logging, AppConfig.LOG_LEVEL.upper()),\n                    format='%(asctime)s - %(name)s - %(levelname)s - %(message)s')\nlogger = logging.getLogger(__name__)\n\ndef main(argv: Optional[List[str]] = None) -> int:\n    \"\"\"\n    The main entry point function for the CLI.\n    Initializes dependencies and delegates to CLIController.\n    \"\"\"\n    if argv is None:\n        argv = sys.argv\n    \n    # Initialize dependencies\n    cache_path = AppConfig.expand_cache_path(AppConfig.CACHE_PATH)\n    file_cache_repo = FileCacheRepository(path=cache_path, enabled=AppConfig.CACHE_ENABLED)\n    collatz_service = CollatzService(repository=file_cache_repo)\n    cli_controller = CLIController(service=collatz_service)\n\n    return cli_controller.run(argv)\n\nif __name__ == \"__main__\":\n    sys.exit(main())\n```"}
{"task_id": "HumanEval/124", "solution": "import re\n\ndef valid_date(date):\n    \"\"\"Validates a date string in 'mm-dd-yyyy' format, checking month and day ranges.\n    February is allowed up to 29 days, regardless of the year.\n    \"\"\"\n    if not date:\n        return False\n\n    # Regex to match mm-dd-yyyy format, allowing single-digit months/days or with leading zero\n    DATE_REGEX = r\"^(0[1-9]|1[0-2]|[1-9])-(0[1-9]|[12][0-9]|3[01]|[1-9])-([0-9]{4})$\"\n    \n    match = re.match(DATE_REGEX, date)\n    if not match:\n        return False\n\n    month_str, day_str, year_str = match.groups()\n\n    try:\n        month = int(month_str)\n        day = int(day_str)\n        # Year is not used for day validation logic as per spec, but parsed\n        # for completeness from the pattern.\n        # year = int(year_str) \n    except ValueError:\n        return False # Should not happen if regex passed, but for robustness\n\n    # Month validation (1-12)\n    if not (1 <= month <= 12):\n        return False\n\n    # Day limits per month, February allows up to 29 days (per spec)\n    MONTH_MAX_DAYS = {\n        1: 31, 2: 29, 3: 31, 4: 30, 5: 31, 6: 30,\n        7: 31, 8: 31, 9: 30, 10: 31, 11: 30, 12: 31\n    }\n    \n    max_day = MONTH_MAX_DAYS.get(month)\n    if not (1 <= day <= max_day):\n        return False\n\n    return True"}
{"task_id": "HumanEval/125", "solution": "```python\ndef split_words(txt):\n    '''\n    Given a string of words, return a list of words split on whitespace, if no whitespaces exists in the text you\n    should split on commas ',' if no commas exists you should return the number of lower-case letters with odd order in the\n    alphabet, ord('a') = 0, ord('b') = 1, ... ord('z') = 25\n    Examples\n    split_words(\"Hello world!\") \u279e [\"Hello\", \"world!\"]\n    split_words(\"Hello,world!\") \u279e [\"Hello\", \"world!\"]\n    split_words(\"abcdef\") == 3\n    '''\n    if txt == \"\":\n        return []\n\n    if any(c.isspace() for c in txt):\n        return txt.split()\n\n    if ',' in txt:\n        return [part.strip() for part in txt.split(',')]\n\n    count = 0\n    alphabet_start_code = ord('a')\n    alphabet_end_code = ord('z')\n    for ch in txt:\n        char_code = ord(ch)\n        if alphabet_start_code <= char_code <= alphabet_end_code:\n            if ((char_code - alphabet_start_code) % 2) == 1:\n                count += 1\n    return count\n```"}
{"task_id": "HumanEval/124", "solution": "def valid_date(date):\n    \"\"\"Validates a date string in mm-dd-yyyy format according to specific rules.\"\"\"\n\n    # Rule 1: The date string is not empty.\n    if len(date) == 0:\n        return False\n\n    parts = date.split('-')\n\n    # Rule 4: The date should be in the format: mm-dd-yyyy\n    if len(parts) != 3:\n        return False\n\n    month_str, day_str, year_str = parts[0], parts[1], parts[2]\n\n    # Check if all parts are numeric\n    if not (month_str.isdigit() and day_str.isdigit() and year_str.isdigit()):\n        return False\n\n    # Check length constraints as per mm-dd-yyyy format (e.g., no '001-01-2000')\n    if not (1 <= len(month_str) <= 2 and 1 <= len(day_str) <= 2 and 1 <= len(year_str) <= 4):\n        return False\n\n    month = int(month_str)\n    day = int(day_str)\n    year = int(year_str)\n\n    # Rule 3: The months should not be less than 1 or higher than 12.\n    if not (1 <= month <= 12):\n        return False\n\n    # Rule 2: The number of days is not less than 1.\n    if day < 1:\n        return False\n\n    # Rule 2: Check day bounds per month type.\n    months_31 = {1, 3, 5, 7, 8, 10, 12}\n    months_30 = {4, 6, 9, 11}\n\n    if month in months_31:\n        if day > 31:\n            return False\n    elif month in months_30:\n        if day > 30:\n            return False\n    elif month == 2:\n        # Rule 2: February allows up to 29 days (leap year not considered).\n        if day > 29:\n            return False\n\n    return True"}
{"task_id": "HumanEval/125", "solution": "```python\ndef split_words(txt):\n    '''\n    Given a string of words, return a list of words split on whitespace, if no whitespaces exists in the text you\n    should split on commas ',' if no commas exists you should return the number of lower-case letters with odd order in the\n    alphabet, ord('a') = 0, ord('b') = 1, ... ord('z') = 25\n    Examples\n    split_words(\"Hello world!\") \u279e [\"Hello\", \"world!\"]\n    split_words(\"Hello,world!\") \u279e [\"Hello\", \"world!\"]\n    split_words(\"abcdef\") == 3 \n    '''\n    # Rule 1: Split on any Unicode whitespace if present.\n    # The `str.isspace()` method is used to detect whitespace characters.\n    if any(char.isspace() for char in txt):\n        # `txt.split()` with no arguments splits on any contiguous whitespace\n        # and automatically discards empty strings. Tokens are then stripped\n        # to ensure consistency with the normalization requirement.\n        return [token.strip() for token in txt.split() if token.strip()]\n\n    # Rule 2: If no whitespace, split on commas (',') if present.\n    # The ASCII comma character is used for splitting.\n    elif ',' in txt:\n        # `txt.split(',')` creates tokens around commas. Each token is then\n        # stripped of surrounding whitespace and empty tokens are filtered out.\n        return [token.strip() for token in txt.split(',') if token.strip()]\n\n    # Rule 3: If no whitespace and no commas, count lowercase English letters\n    # with an odd alphabet index (a=0, b=1, ... z=25).\n    else:\n        count = 0\n        # Iterate through each character in the string.\n        for char in txt:\n            # Check if the character is a lowercase English letter.\n            if 'a' <= char <= 'z':\n                # Calculate its alphabet index and check if it's odd.\n                if (ord(char) - ord('a')) % 2 == 1:\n                    count += 1\n        return count\n```"}
{"task_id": "HumanEval/126", "solution": "```python\ndef is_sorted(lst):\n    \"\"\"\n    Checks if a list of non-negative integers is sorted ascendingly and allows at most two occurrences per number.\n    Assumes input contains only non-negative integers.\n    \"\"\"\n    \n    # Check duplicate count: no number may appear more than twice.\n    counts = {}\n    for num in lst:\n        counts[num] = counts.get(num, 0) + 1\n        if counts[num] > 2:  # An occurrence count of 3 or more means \"more than 1 duplicate\"\n            return False\n\n    # Check ascending order (non-decreasing).\n    for i in range(1, len(lst)):\n        if lst[i] < lst[i-1]:\n            return False\n\n    return True\n```"}
{"task_id": "HumanEval/126", "solution": "def is_sorted(lst):\n    \"\"\"\n    Checks if a list of integers is sorted non-decreasingly and doesn't have too many duplicates.\n    Returns False if any integer appears three or more times.\n    \"\"\"\n    counts = {}\n    for num in lst:\n        counts[num] = counts.get(num, 0) + 1\n        if counts[num] >= 3:\n            return False\n\n    for i in range(1, len(lst)):\n        if lst[i] < lst[i-1]:\n            return False\n\n    return True"}
{"task_id": "HumanEval/127", "solution": "```python\nimport math\n\nclass PrimeChecker:\n    \"\"\"Checks if a non-negative integer is prime.\"\"\"\n    def is_prime(self, n: int) -> bool:\n        \"\"\"Determines if the given integer n is a prime number.\"\"\"\n        if n < 2:\n            return False\n        if n % 2 == 0:\n            return n == 2\n        \n        # Calculate the integer square root of n.\n        r = int(math.isqrt(n))\n        f = 3\n        while f <= r:\n            if n % f == 0:\n                return False\n            f += 2  # Check only odd factors\n        return True\n\ndef intersection(interval1, interval2):\n    \"\"\"Determines if the length of the closed intersection of two integer intervals is a prime number.\"\"\"\n    start1, end1 = interval1\n    start2, end2 = interval2\n\n    # Calculate the start and end points of the intersection interval.\n    intersection_start = max(start1, start2)\n    intersection_end = min(end1, end2)\n\n    # The length of the intersection is calculated as end - start.\n    # If there is no overlap (intersection_end < intersection_start), the length is 0.\n    intersection_length = max(0, intersection_end - intersection_start)\n\n    # Use the PrimeChecker to determine if the calculated length is a prime number.\n    prime_checker = PrimeChecker()\n    if prime_checker.is_prime(intersection_length):\n        return \"YES\"\n    else:\n        return \"NO\"\n```"}
