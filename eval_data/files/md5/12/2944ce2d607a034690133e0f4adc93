1:\n            continue\n        if _is_prime(current_num):\n            factors.append(current_num)\n            continue\n        \n        temp_val = current_num\n        \n        while temp_val % 2 == 0:\n            factors.append(2)\n            temp_val //= 2\n        \n        d = 3\n        while d * d <= temp_val and d <= TRIAL_DIVISION_BOUND:\n            while temp_val % d == 0:\n                factors.append(d)\n                temp_val //= d\n            d += 2\n        \n        if temp_val == 1:\n            continue\n        \n        if _is_prime(temp_val):\n            factors.append(temp_val)\n            continue\n        \n        rho_factor = _pollard_rho_factor_finder(temp_val)\n\n        if rho_factor == temp_val:\n            factors.append(temp_val)\n        else:\n            stack.append(rho_factor)\n            stack.append(temp_val // rho_factor)\n\n    return sorted(factors)"}
{"task_id": "HumanEval/26", "solution": "```python\n# pyproject.toml\n[project]\nname = \"dupremover\"\nversion = \"0.1.0\"\ndescription = \"A library and tools to remove duplicate-occurrence integers from lists.\"\nauthors = [{ name = \"Your Name\", email = \"your.email@example.com\" }]\nrequires-python = \">=3.10\"\nlicense = { text = \"MIT\" }\nkeywords = [\"duplicate\", \"remover\", \"list\", \"integers\", \"cli\", \"wsgi\"]\nclassifiers = [\n    \"Programming Language :: Python :: 3\",\n    \"Programming Language :: Python :: 3.10\",\n    \"License :: OSI Approved :: MIT License\",\n    \"Operating System :: OS Independent\",\n    \"Development Status :: 3 - Alpha\",\n]\n\n[project.readme]\nfile = \"README.md\"\ncontent-type = \"text/markdown\"\n\n[project.urls]\nHomepage = \"https://github.com/yourusername/dupremover\"\nRepository = \"https://github.com/yourusername/dupremover\"\n\n[project.scripts]\ndupremover = \"dupremover.cli:main\"\n\n[build-system]\nrequires = [\"setuptools>=61.0\"]\nbuild-backend = \"setuptools.build_meta\"\n```\n\n```markdown\n# dupremover\n\n`dupremover` is a Python library and set of tools for removing integers that occur more than once from a list, while preserving the original order of the remaining unique elements. It provides a core function, a command-line interface (CLI), and an optional WSGI HTTP adapter.\n\n## Features\n\n- **Core Library**: `remove_duplicates(numbers: List[int]) -> List[int]` function.\n- **CLI**: Filter lists of numbers via command line or stdin.\n- **HTTP Adapter**: A simple WSGI application for HTTP integration.\n- **Observability**: Records lightweight runtime stats (invocation counts, last run time).\n\n## Installation\n\n```bash\npip install dupremover\n```\n\n(Note: Replace `pip install dupremover` with your package's actual installation command if published to PyPI, or instructions for local installation.)\n\n## Usage\n\n### Library\n\n```python\nfrom dupremover import DuplicateRemoverService\n\nservice = DuplicateRemoverService()\nresult = service.remove_duplicates([1, 2, 3, 2, 4])\nprint(result) # Output: [1, 3, 4]\n```\n\n### CLI\n\nPass numbers as space- or comma-separated strings:\n\n```bash\ndupremover --nums \"1 2 3 2 4\"\n# Output: [1, 3, 4]\n\ndupremover --nums \"1,1,2,3,3,4\"\n# Output: [2, 4]\n```\n\nOr pipe numbers via stdin:\n\n```bash\necho \"1 2 3 2 4\" | dupremover\n# Output: [1, 3, 4]\n```\n\n### HTTP Adapter (WSGI)\n\nThe `HTTPServerAdapter` provides a WSGI callable. You can run it with any WSGI server, for example `wsgiref` for development:\n\n```python\n# app.py\nfrom wsgiref.simple_server import make_server\nfrom dupremover import DuplicateRemoverService, StatsRepository, RemoveDuplicatesController, HTTPServerAdapter, DEFAULT_STATS_PATH\n\nservice = DuplicateRemoverService()\nstats_repo = StatsRepository(path=DEFAULT_STATS_PATH)\ncontroller = RemoveDuplicatesController(service=service, stats_repo=stats_repo)\napplication = HTTPServerAdapter.make_app(controller)\n\nif __name__ == '__main__':\n    httpd = make_server('', 8000, application)\n    print(\"Serving on port 8000...\")\n    httpd.serve_forever()\n```\n\nThen, run `python app.py` and make a POST request:\n\n```bash\ncurl -X POST -H \"Content-Type: application/json\" -d '{\"numbers\": [1, 2, 3, 2, 4]}' http://localhost:8000/remove\n# Output: {\"result\": [1, 3, 4]}\n```\n\n### Stats File\n\nRuntime statistics are stored in a JSON file, by default at `~/.dupremover/stats.json`.\n\n```json\n{\n  \"total_invocations\": 42,\n  \"last_run_iso\": \"2026-04-12T15:03:22+00:00\"\n}\n```\n```python\n# src/dupremover/__init__.py\n\"\"\"Package for removing duplicate-occurrence integers and related tools.\"\"\"\n\nimport os\n\n# Default path for statistics file.\nDEFAULT_STATS_PATH = os.path.join(os.path.expanduser(\"~\"), \".dupremover\", \"stats.json\")\n\n# Expose core components for easy import.\nfrom .exceptions import DuplicateRemoverError\nfrom .models import NumbersInput, NumbersOutput\nfrom .utils import ValidatorUtils\nfrom .repository import StatsRepository\nfrom .services import DuplicateRemoverService\nfrom .controllers import RemoveDuplicatesController\nfrom .cli import CLIApp, main as cli_main\nfrom .http import HTTPServerAdapter\n```\n\n```python\n# src/dupremover/models.py\n\"\"\"Data Transfer Objects (DTOs) for input and output.\"\"\"\n\nfrom typing import List\nfrom .exceptions import DuplicateRemoverError\n\nclass NumbersInput:\n    \"\"\"DTO for input numbers list.\"\"\"\n    def __init__(self, numbers: List[int]) -> None:\n        self.numbers: List[int] = numbers\n\n    def validate(self) -> None:\n        \"\"\"Validates that 'numbers' is a list of integers.\"\"\"\n        if not isinstance(self.numbers, list):\n            raise DuplicateRemoverError(\"Input 'numbers' must be a list.\", code=400)\n        for i, v in enumerate(self.numbers):\n            if not isinstance(v, int):\n                raise DuplicateRemoverError(\n                    f\"Element at index {i} ('{v}') is not an integer.\", code=400\n                )\n\nclass NumbersOutput:\n    \"\"\"DTO for output result list.\"\"\"\n    def __init__(self, result: List[int]) -> None:\n        self.result: List[int] = result\n```\n\n```python\n# src/dupremover/exceptions.py\n\"\"\"Custom exceptions for the duplicate remover application.\"\"\"\n\nclass DuplicateRemoverError(Exception):\n    \"\"\"Base exception for application-specific errors.\"\"\"\n    def __init__(self, message: str, code: int = 400) -> None:\n        super().__init__(message)\n        self.message = message\n        self.code = code\n```\n\n```python\n# src/dupremover/services.py\n\"\"\"Core business logic for removing duplicate-occurrence integers.\"\"\"\n\nfrom typing import List\nfrom collections import Counter\nfrom .utils import ValidatorUtils # This import is specified by the design.\n\nclass DuplicateRemoverService:\n    \"\"\"Service for removing integers that occur more than once from a list.\"\"\"\n    def remove_duplicates(self, numbers: List[int]) -> List[int]:\n        \"\"\"Removes numbers that appear more than once, preserving order.\n\n        It uses a two-pass approach for O(N) time and O(N) space complexity.\n        \"\"\"\n        ValidatorUtils.validate_numbers(numbers) # Defensive validation as per design.\n        counts = Counter(numbers)\n        return [x for x in numbers if counts[x] == 1]\n```\n\n```python\n# src/dupremover/repository.py\n\"\"\"Persistence layer for lightweight runtime statistics.\"\"\"\n\nimport json\nimport os\nimport tempfile\nimport logging\nfrom datetime import datetime\nfrom threading import Lock\nfrom typing import Dict, Any\n\n# Configure logging for repository operations.\nlogger = logging.getLogger(__name__)\nlogger.addHandler(logging.NullHandler()) # Prevent \"No handlers could be found\" message.\n\nclass StatsRepository:\n    \"\"\"Manages persistence of runtime statistics to a JSON file.\"\"\"\n    def __init__(self, path: str) -> None:\n        self._path = os.path.expanduser(path)\n        self._lock = Lock() # For thread-safe file access.\n\n    def load_stats(self) -> Dict[str, Any]:\n        \"\"\"Loads statistics from the JSON file or returns default values.\"\"\"\n        if not os.path.exists(self._path):\n            return {\"total_invocations\": 0, \"last_run_iso\": None}\n        try:\n            with open(self._path, \"r\", encoding=\"utf-8\") as f:\n                return json.load(f)\n        except (IOError, json.JSONDecodeError) as e:\n            logger.warning(f\"Failed to load stats from {self._path}: {e}\")\n            return {\"total_invocations\": 0, \"last_run_iso\": None}\n\n    def increment_invocation(self) -> None:\n        \"\"\"Increments invocation count and updates last run timestamp.\"\"\"\n        with self._lock:\n            stats = self.load_stats()\n            stats[\"total_invocations\"] = int(stats.get(\"total_invocations\", 0)) + 1\n            stats[\"last_run_iso\"] = datetime.utcnow().isoformat(timespec=\"seconds\") + \"Z\"\n            self.save_stats(stats)\n\n    def save_stats(self, stats: Dict[str, Any]) -> None:\n        \"\"\"Saves statistics atomically to the JSON file.\"\"\"\n        dirpath = os.path.dirname(self._path)\n        os.makedirs(dirpath, exist_ok=True)\n        \n        # Use a temporary file and os.replace for atomic write.\n        fd, tmp_path = tempfile.mkstemp(dir=dirpath, prefix=\"stats_\")\n        try:\n            with os.fdopen(fd, \"w\", encoding=\"utf-8\") as f:\n                json.dump(stats, f, indent=2)\n            os.replace(tmp_path, self._path) # Atomically replace the original file.\n        except IOError as e:\n            logger.warning(f\"Failed to save stats to {self._path}: {e}\")\n        finally:\n            if os.path.exists(tmp_path):\n                try:\n                    os.remove(tmp_path)\n                except OSError as e:\n                    logger.warning(f\"Failed to clean up temporary stats file {tmp_path}: {e}\")\n```\n\n```python\n# src/dupremover/controllers.py\n\"\"\"Application layer controller orchestrating services and repositories.\"\"\"\n\nimport logging\nfrom .models import NumbersInput, NumbersOutput\nfrom .services import DuplicateRemoverService\nfrom .repository import StatsRepository\nfrom .exceptions import DuplicateRemoverError\n\n# Configure logging for controller operations.\nlogger = logging.getLogger(__name__)\nlogger.addHandler(logging.NullHandler()) # Prevent \"No handlers could be found\" message.\n\nclass RemoveDuplicatesController:\n    \"\"\"Controller to manage the removal of duplicate-occurrence numbers.\"\"\"\n    def __init__(self, service: DuplicateRemoverService, stats_repo: StatsRepository) -> None:\n        self._service = service\n        self._stats_repo = stats_repo\n\n    def process(self, input_dto: NumbersInput) -> NumbersOutput:\n        \"\"\"Processes the input DTO, invokes the service, and updates stats.\"\"\"\n        try:\n            input_dto.validate() # Validate DTO as per design.\n            result = self._service.remove_duplicates(input_dto.numbers)\n            return NumbersOutput(result)\n        except DuplicateRemoverError:\n            raise # Re-raise domain-specific errors.\n        finally:\n            # Stats persistence is best-effort and should not fail the main flow.\n            try:\n                self._stats_repo.increment_invocation()\n            except Exception as e:\n                logger.warning(f\"Failed to increment invocation stats: {e}\")\n```\n\n```python\n# src/dupremover/utils.py\n\"\"\"Utility functions for parsing and validating input.\"\"\"\n\nfrom typing import List\nfrom .exceptions import DuplicateRemoverError\n\nclass ValidatorUtils:\n    \"\"\"Provides static utility methods for parsing and validating inputs.\"\"\"\n    @staticmethod\n    def parse_numbers(text: str) -> List[int]:\n        \"\"\"Parses a string into a list of integers, handling space or comma separation.\n\n        Raises DuplicateRemoverError if parsing fails for any number.\n        \"\"\"\n        if not text or not text.strip():\n            return []\n        \n        # Replace commas with spaces and then split by whitespace.\n        cleaned_text = text.replace(\",\", \" \").strip()\n        parts = cleaned_text.split()\n        \n        try:\n            return [int(p) for p in parts]\n        except ValueError as e:\n            raise DuplicateRemoverError(f\"Failed to parse numbers: {e}\") from e\n\n    @staticmethod\n    def validate_numbers(numbers: List[int]) -> None:\n        \"\"\"Validates that the input is a list containing only integers.\n\n        Raises DuplicateRemoverError if the list is invalid or contains non-integers.\n        \"\"\"\n        if not isinstance(numbers, list):\n            raise DuplicateRemoverError(\"Input must be a list.\", code=400)\n        for i, v in enumerate(numbers):\n            if not isinstance(v, int):\n                raise DuplicateRemoverError(\n                    f\"Element at index {i} ('{v}') is not an integer.\", code=400\n                )\n```\n\n```python\n# src/dupremover/cli.py\n\"\"\"Command-Line Interface (CLI) for the duplicate remover.\"\"\"\n\nimport sys\nimport json\nimport argparse\nfrom typing import List\nfrom .models import NumbersInput\nfrom .exceptions import DuplicateRemoverError\nfrom .controllers import RemoveDuplicatesController\nfrom .services import DuplicateRemoverService\nfrom .repository import StatsRepository\nfrom . import DEFAULT_STATS_PATH\nfrom .utils import ValidatorUtils # Needed for parsing logic in CLI.\n\nclass CLIApp:\n    \"\"\"Encapsulates the command-line application logic.\"\"\"\n    def __init__(self, controller: RemoveDuplicatesController) -> None:\n        self._controller = controller\n\n    def run(self, argv: List[str]) -> int:\n        \"\"\"Executes the CLI application based on provided arguments.\"\"\"\n        parser = argparse.ArgumentParser(\n            description=\"Remove integers that occur more than once from a list.\",\n            epilog=\"Example: dupremover --nums '1 2 3 2 4' or echo '1,2,3' | dupremover\"\n        )\n        parser.add_argument(\n            \"--nums\",\n            type=str,\n            help=\"Space- or comma-separated list of integers. If not provided, reads from stdin.\"\n        )\n        \n        args = parser.parse_args(argv[1:])\n        \n        input_text: str\n        if args.nums:\n            input_text = args.nums\n        else:\n            # Read from stdin if --nums is not provided.\n            input_text = sys.stdin.read()\n        \n        try:\n            numbers = ValidatorUtils.parse_numbers(input_text) # Use utils for parsing.\n            output_dto = self._controller.process(NumbersInput(numbers))\n            print(json.dumps(output_dto.result))\n            return 0\n        except DuplicateRemoverError as e:\n            print(f\"Error: {e.message}\", file=sys.stderr)\n            return 1\n        except Exception as e:\n            print(f\"An unexpected error occurred: {e}\", file=sys.stderr)\n            return 1\n\ndef main() -> None:\n    \"\"\"Entry point for the command-line application.\"\"\"\n    # Initialize dependencies for the CLI.\n    service = DuplicateRemoverService()\n    stats_repo = StatsRepository(path=DEFAULT_STATS_PATH)\n    controller = RemoveDuplicatesController(service=service, stats_repo=stats_repo)\n    \n    app = CLIApp(controller)\n    sys.exit(app.run(sys.argv))\n\nif __name__ == \"__main__\":\n    main()\n```\n\n```python\n# src/dupremover/http.py\n\"\"\"WSGI HTTP adapter for the duplicate remover service.\"\"\"\n\nimport json\nfrom typing import Callable, Dict, Any, List\nfrom .models import NumbersInput\nfrom .exceptions import DuplicateRemoverError\nfrom .controllers import RemoveDuplicatesController\n\nclass HTTPServerAdapter:\n    \"\"\"Provides a WSGI application factory for the duplicate remover.\"\"\"\n    @staticmethod\n    def make_app(controller: RemoveDuplicatesController) -> Callable[[Dict[str, Any], Callable], List[bytes]]:\n        \"\"\"Creates a WSGI application function that processes HTTP requests.\n\n        The application handles POST requests to /remove with JSON payload {\"numbers\": [...]}.\n        \"\"\"\n        def app(environ: Dict[str, Any], start_response: Callable) -> List[bytes]:\n            try:\n                # Validate request method and path.\n                if environ.get(\"REQUEST_METHOD\") != \"POST\" or environ.get(\"PATH_INFO\") != \"/remove\":\n                    start_response(\"404 Not Found\", [(\"Content-Type\", \"application/json\")])\n                    return [json.dumps({\"error\": \"Not Found\"}).encode(\"utf-8\")]\n\n                # Read and decode request body.\n                try:\n                    content_length = int(environ.get(\"CONTENT_LENGTH\", \"0\") or \"0\")\n                except ValueError:\n                    content_length = 0\n                \n                body = environ[\"wsgi.input\"].read(content_length) if content_length > 0 else b\"{}\"\n                \n                try:\n                    payload = json.loads(body.decode(\"utf-8\"))\n                except json.JSONDecodeError:\n                    raise DuplicateRemoverError(\"Invalid JSON payload.\", code=400)\n\n                numbers = payload.get(\"numbers\")\n                if numbers is None:\n                    raise DuplicateRemoverError(\"Missing 'numbers' field in JSON payload.\", code=400)\n\n                # Process using the controller.\n                input_dto = NumbersInput(numbers)\n                output_dto = controller.process(input_dto)\n                \n                # Return successful response.\n                start_response(\"200 OK\", [(\"Content-Type\", \"application/json\")])\n                return [json.dumps({\"result\": output_dto.result}).encode(\"utf-8\")]\n\n            except DuplicateRemoverError as e:\n                # Handle domain-specific errors.\n                status_code = e.code\n                start_response(f\"{status_code} Bad Request\", [(\"Content-Type\", \"application/json\")])\n                return [json.dumps({\"error\": e.message}).encode(\"utf-8\")]\n            except Exception:\n                # Catch all other unexpected errors.\n                start_response(\"500 Internal Server Error\", [(\"Content-Type\", \"application/json\")])\n                return [json.dumps({\"error\": \"Internal Server Error\"}).encode(\"utf-8\")]\n        return app\n```"}
{"task_id": "HumanEval/27", "solution": "def flip_case(string: str) -> str:\n    \"\"\" For a given string, flip lowercase characters to uppercase and uppercase to lowercase.\n    Other characters remain unchanged.\n    \"\"\"\n    flipped_chars = []\n    for char in string:\n        if char.islower():\n            flipped_chars.append(char.upper())\n        elif char.isupper():\n            flipped_chars.append(char.lower())\n        else:\n            flipped_chars.append(char)\n    return \"\".join(flipped_chars)"}
{"task_id": "HumanEval/26", "solution": "```python\nfrom typing import List\n\n\ndef remove_duplicates(numbers: List[int]) -> List[int]:\n    \"\"\" From a list of integers, remove all elements that occur more than once.\n    Keep order of elements left the same as in the input.\n    \"\"\"\n    counts = {}\n    for n in numbers:\n        counts[n] = counts.get(n, 0) + 1\n\n    result = []\n    for n in numbers:\n        if counts[n] == 1:\n            result.append(n)\n            \n    return result\n```"}
