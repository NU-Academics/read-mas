{"task_id": "HumanEval/88", "solution": "```python\ndef sort_array(array):\n    \"\"\"\n    Sorts a copy of the given array based on the parity of the sum of its first and last elements.\n    Ascending if sum is odd, descending if sum is even.\n    \"\"\"\n    if not array:\n        return []\n\n    first_val = array[0]\n    last_val = array[-1]\n    sum_parity = (first_val + last_val) % 2\n\n    return sorted(array, reverse=(sum_parity == 0))\n```"}
{"task_id": "HumanEval/87", "solution": "def get_row(lst, x):\n    \"\"\"\n    Finds coordinates of integer x in a ragged 2D list.\n    Returns coordinates as (row, col) tuples, sorted by row ascending, then column descending.\n    \"\"\"\n    matches = []\n    for r, row in enumerate(lst):\n        for c, value in enumerate(row):\n            if value == x:\n                matches.append((r, c))\n\n    # Sort coordinates: primary by row ascending, secondary by column descending.\n    return sorted(matches, key=lambda coord: (coord[0], -coord[1]))"}
{"task_id": "HumanEval/87", "solution": "def get_row(lst, x):\n    \"\"\"Finds all occurrences of integer x in a jagged 2D list lst.\n    Returns coordinates (row, column) sorted by row ascending and column descending within each row.\n    \"\"\"\n    all_coordinates = []\n    for row_idx, row_data in enumerate(lst):\n        current_row_matches = []\n        for col_idx, value in enumerate(row_data):\n            if value == x:\n                current_row_matches.append((row_idx, col_idx))\n        \n        # Sort current row's matches by column in descending order\n        current_row_matches.sort(key=lambda coord: coord[1], reverse=True)\n        all_coordinates.extend(current_row_matches)\n        \n    return all_coordinates"}
{"task_id": "HumanEval/88", "solution": "```python\nfrom typing import Sequence, List\n\ndef sort_array(array: Sequence[int]) -> List[int]:\n    \"\"\"\n    Sorts a copy of the given array based on the parity of the sum of its first and last elements.\n    Ascending if sum is odd, descending if sum is even; the original array remains unchanged.\n    \"\"\"\n    # Create a copy to ensure immutability of the input array.\n    arr_copy = list(array)\n\n    if not arr_copy:\n        return []\n    if len(arr_copy) == 1:\n        return arr_copy\n\n    # Determine sorting order based on the sum of the first and last elements.\n    first_element = arr_copy[0]\n    last_element = arr_copy[-1]\n    total_sum = first_element + last_element\n\n    # If sum is odd, sort ascending; otherwise (even sum), sort descending.\n    if total_sum % 2 == 1:\n        arr_copy.sort(reverse=False)  # Ascending order\n    else:\n        arr_copy.sort(reverse=True)   # Descending order\n\n    return arr_copy\n```"}
{"task_id": "HumanEval/89", "solution": "def encrypt(s):\n    \"\"\"Encrypts a string by shifting alphabetic characters down by 4 places, wrapping around the alphabet.\n    Non-alphabetic characters and original case are preserved.\"\"\"\n    \n    result = []\n    shift_amount = 4\n\n    for char in s:\n        if 'a' <= char <= 'z':\n            start = ord('a')\n            shifted_char = chr(((ord(char) - start + shift_amount) % 26) + start)\n            result.append(shifted_char)\n        elif 'A' <= char <= 'Z':\n            start = ord('A')\n            shifted_char = chr(((ord(char) - start + shift_amount) % 26) + start)\n            result.append(shifted_char)\n        else:\n            result.append(char)\n            \n    return ''.join(result)"}
{"task_id": "HumanEval/89", "solution": "def encrypt(s):\n    \"\"\"Encrypts a string by rotating ASCII letters down by 4 positions.\n    Non-alphabetic characters are left unchanged, and case is preserved.\n    \"\"\"\n    shift_amount = 4\n    result_chars = []\n\n    for ch in s:\n        if 'a' <= ch <= 'z':\n            # Handle lowercase letters\n            shifted_ch_code = (ord(ch) - ord('a') + shift_amount) % 26 + ord('a')\n            result_chars.append(chr(shifted_ch_code))\n        elif 'A' <= ch <= 'Z':\n            # Handle uppercase letters\n            shifted_ch_code = (ord(ch) - ord('A') + shift_amount) % 26 + ord('A')\n            result_chars.append(chr(shifted_ch_code))\n        else:\n            # Leave non-alphabetic characters unchanged\n            result_chars.append(ch)\n\n    return ''.join(result_chars)"}
