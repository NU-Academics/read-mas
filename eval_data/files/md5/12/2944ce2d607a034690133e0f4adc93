{"task_id": "HumanEval/160", "solution": "```python\nclass Token:\n    \"\"\"Represents a token with a kind (e.g., 'NUMBER', 'OP') and a value.\"\"\"\n    def __init__(self, kind: str, value):\n        self.kind = kind\n        self.value = value\n\nclass ASTNode:\n    \"\"\"Base class for Abstract Syntax Tree nodes.\"\"\"\n    def accept(self, visitor):\n        \"\"\"Allows a visitor to process this node type.\"\"\"\n        raise NotImplementedError\n\nclass NumberNode(ASTNode):\n    \"\"\"Represents a numeric literal in the AST.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def accept(self, visitor):\n        \"\"\"Allows a visitor to process this number node.\"\"\"\n        return visitor._visit_number_node(self)\n\nclass BinaryOpNode(ASTNode):\n    \"\"\"Represents a binary operation in the AST.\"\"\"\n    def __init__(self, op: str, left: ASTNode, right: ASTNode):\n        self.op = op\n        self.left = left\n        self.right = right\n\n    def accept(self, visitor):\n        \"\"\"Allows a visitor to process this binary operation node.\"\"\"\n        return visitor._visit_binary_op_node(self)\n\nclass Tokenizer:\n    \"\"\"Converts operator and operand lists into a linear token stream.\"\"\"\n    @staticmethod\n    def build_tokens(operators: list[str], operands: list[int]) -> list[Token]:\n        \"\"\"Builds a list of tokens from operators and operands.\"\"\"\n        tokens = []\n        for i, num in enumerate(operands):\n            tokens.append(Token('NUMBER', num))\n            if i < len(operators):\n                tokens.append(Token('OP', operators[i]))\n        return tokens\n\nclass Parser:\n    \"\"\"Parses a list of tokens into an Abstract Syntax Tree (AST) respecting precedence.\"\"\"\n    def __init__(self, tokens: list[Token]):\n        self.tokens = tokens\n        self.pos = 0\n\n    def _current(self) -> Token | None:\n        \"\"\"Returns the current token or None if end of stream.\"\"\"\n        if self.pos < len(self.tokens):\n            return self.tokens[self.pos]\n        return None\n\n    def _advance(self) -> None:\n        \"\"\"Moves to the next token in the stream.\"\"\"\n        self.pos += 1\n\n    def parse(self) -> ASTNode:\n        \"\"\"Entry point for parsing, builds the entire AST.\"\"\"\n        node = self._parse_expression()\n        return node\n\n    def _parse_expression(self) -> ASTNode:\n        \"\"\"Handles '+' and '-' operations (lowest precedence, left-associative).\"\"\"\n        node = self._parse_term()\n        while self._current() and self._current().kind == 'OP' and self._current().value in ('+', '-'):\n            op = self._current().value\n            self._advance()\n            right = self._parse_term()\n            node = BinaryOpNode(op, node, right)\n        return node\n\n    def _parse_term(self) -> ASTNode:\n        \"\"\"Handles '*' and '//' operations (medium precedence, left-associative).\"\"\"\n        node = self._parse_factor()\n        while self._current() and self._current().kind == 'OP' and self._current().value in ('*', '//'):\n            op = self._current().value\n            self._advance()\n            right = self._parse_factor()\n            node = BinaryOpNode(op, node, right)\n        return node\n\n    def _parse_factor(self) -> ASTNode:\n        \"\"\"Handles '**' operations (highest precedence, right-associative) and numbers.\"\"\"\n        current_token = self._current()\n        self._advance()\n        node = NumberNode(current_token.value)\n        \n        if self._current() and self._current().kind == 'OP' and self._current().value == '**':\n            op = self._current().value\n            self._advance()\n            right = self._parse_factor()\n            node = BinaryOpNode(op, node, right)\n        return node\n\nclass Evaluator:\n    \"\"\"Evaluates an Abstract Syntax Tree (AST) to produce an integer result.\"\"\"\n    def evaluate(self, node: ASTNode) -> int:\n        \"\"\"Delegates evaluation to the appropriate visitor method for the node type.\"\"\"\n        return node.accept(self)\n\n    def _visit_number_node(self, node: NumberNode) -> int:\n        \"\"\"Evaluates a NumberNode by returning its integer value.\"\"\"\n        return node.value\n\n    def _visit_binary_op_node(self, node: BinaryOpNode) -> int:\n        \"\"\"Evaluates a BinaryOpNode by performing the specified operation.\"\"\"\n        left = self.evaluate(node.left)\n        right = self.evaluate(node.right)\n\n        if node.op == '+':\n            return left + right\n        elif node.op == '-':\n            return left - right\n        elif node.op == '*':\n            return left * right\n        elif node.op == '//':\n            return left // right\n        elif node.op == '**':\n            return left ** right\n        return 0\n\nclass AlgebraService:\n    \"\"\"Orchestrates tokenization, parsing, and evaluation of an expression.\"\"\"\n    def evaluate(self, operators: list[str], operands: list[int]) -> int:\n        \"\"\"Builds tokens, parses AST, and evaluates it.\"\"\"\n        tokens = Tokenizer.build_tokens(operators, operands)\n        ast = Parser(tokens).parse()\n        return Evaluator().evaluate(ast)\n\ndef do_algebra(operator: list[str], operand: list[int]) -> int:\n    \"\"\"\n    Evaluates an algebraic expression from operator and operand lists.\n    Builds an expression honoring operator precedence and associativity.\n    \"\"\"\n    service = AlgebraService()\n    return service.evaluate(operator, operand)\n```"}
{"task_id": "HumanEval/161", "solution": "def solve(s):\n    \"\"\"Reverses letter case or reverses the string if it contains no letters.\n\n    Letters are identified by str.isalpha(); non-letters remain unchanged.\n    \"\"\"\n    has_letters = False\n    for char in s:\n        if char.isalpha():\n            has_letters = True\n            break\n\n    if has_letters:\n        result_chars = []\n        for char in s:\n            if char.islower():\n                result_chars.append(char.upper())\n            elif char.isupper():\n                result_chars.append(char.lower())\n            else:\n                result_chars.append(char)\n        return \"\".join(result_chars)\n    else:\n        return s[::-1]"}
