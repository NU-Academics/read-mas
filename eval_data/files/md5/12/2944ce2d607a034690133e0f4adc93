{"task_id": "HumanEval/1", "solution": "from typing import List, Iterator, Optional\nimport json\nimport tempfile\nimport os\nimport argparse\nimport sys\n\nclass ParenSplitterError(Exception):\n    \"\"\"Base exception for the paren_splitter library.\"\"\"\n    def __init__(self, message: str):\n        self.message = message\n        super().__init__(message)\n\nclass ParseError(ParenSplitterError):\n    \"\"\"Raised when input string is malformed or unbalanced during parsing.\"\"\"\n    pass\n\nclass ValidationError(ParenSplitterError):\n    \"\"\"Raised when a successfully parsed group fails validation.\"\"\"\n    pass\n\nclass RepositoryError(ParenSplitterError):\n    \"\"\"Raised for issues during file repository operations.\"\"\"\n    pass\n\nclass ParenGroups:\n    \"\"\"Data transfer object for parsed parenthesis groups.\"\"\"\n    def __init__(self, groups: List[str]):\n        self.groups = groups\n\n    def to_json(self) -> str:\n        \"\"\"Serializes the groups to a JSON array string.\"\"\"\n        return json.dumps(self.groups, separators=(',', ':'))\n\n    @classmethod\n    def from_list(cls, groups: List[str]) -> 'ParenGroups':\n        \"\"\"Creates a ParenGroups instance from a list of strings.\"\"\"\n        return cls(groups)\n\nclass Tokenizer:\n    \"\"\"Streams characters, ignoring whitespace and validating allowed characters.\"\"\"\n    WHITESPACE = set(' \\t\\n\\r')\n    VALID_CHARS = set(['(', ')']) | WHITESPACE\n\n    def tokenize(self, s: str) -> Iterator[str]:\n        \"\"\"Yields meaningful tokens '(' or ')' from the input string.\"\"\"\n        for ch in s:\n            if ch in self.WHITESPACE:\n                continue\n            if ch == '(' or ch == ')':\n                yield ch\n            else:\n                raise ParseError(f\"Invalid character: {ch!r}\")\n\nclass Validator:\n    \"\"\"Ensures a given parenthesis group string is balanced.\"\"\"\n    def validate_group(self, group: str) -> bool:\n        \"\"\"Checks if the input string contains balanced parentheses.\"\"\"\n        bal = 0\n        for ch in group:\n            if ch == '(':\n                bal += 1\n            elif ch == ')':\n                bal -= 1\n                if bal < 0:\n                    return False\n            else: # Should ideally be filtered by tokenizer, but validates for safety.\n                return False\n        return bal == 0\n\nclass Parser:\n    \"\"\"Core algorithm to separate top-level balanced parenthesis groups.\"\"\"\n    def __init__(self, tokenizer: Tokenizer, validator: Validator) -> None:\n        self.tokenizer = tokenizer\n        self.validator = validator\n\n    def separate(self, paren_string: str) -> List[str]:\n        \"\"\"Returns a list of balanced top-level group strings.\"\"\"\n        token_iter = self.tokenizer.tokenize(paren_string)\n        groups = self._accumulate_groups(token_iter)\n        for g in groups:\n            if not self.validator.validate_group(g):\n                raise ValidationError(f\"Group failed validation: {g!r}\")\n        return groups\n\n    def _accumulate_groups(self, token_iter: Iterator[str]) -> List[str]:\n        \"\"\"Accumulates top-level balanced groups from a token stream.\"\"\"\n        groups: List[str] = []\n        balance = 0\n        current_chars: List[str] = []\n\n        for token in token_iter:\n            if token == '(':\n                if balance == 0:  # Start of a new top-level group\n                    current_chars = []\n                current_chars.append('(')\n                balance += 1\n            elif token == ')':\n                balance -= 1\n                if balance < 0:\n                    raise ParseError(\"Unexpected ')' - balance went negative\")\n                current_chars.append(')')\n                if balance == 0:  # End of a top-level group\n                    groups.append(\"\".join(current_chars))\n                    current_chars = []\n\n        if balance != 0:\n            raise ParseError(\"Unbalanced parentheses - end of input with non-zero balance\")\n\n        return groups\n\nclass FileRepository:\n    \"\"\"Persists and loads JSON array of strings to/from files.\"\"\"\n    DEFAULT_ENCODING = 'utf-8'\n\n    def save(self, groups: List[str], path: str) -> None:\n        \"\"\"Writes a JSON array of groups to the specified file path.\"\"\"\n        dirpath = os.path.dirname(path)\n        if dirpath:\n            os.makedirs(dirpath, exist_ok=True)\n        \n        with tempfile.NamedTemporaryFile('w', delete=False, dir=dirpath or None, encoding=self.DEFAULT_ENCODING) as tf:\n            try:\n                json.dump(groups, tf, separators=(',', ':'))\n                tf.flush()\n                os.fsync(tf.fileno())\n            except Exception as e:\n                os.remove(tf.name)\n                raise RepositoryError(f\"Failed to write to temporary file {tf.name}: {e}\")\n\n        try:\n            os.replace(tf.name, path)\n        except OSError as e:\n            os.remove(tf.name)\n            raise RepositoryError(f\"Failed to move temporary file {tf.name} to {path}: {e}\")\n\n    def load(self, path: str) -> List[str]:\n        \"\"\"Reads and returns a JSON array of groups from the specified file path.\"\"\"\n        try:\n            with open(path, 'r', encoding=self.DEFAULT_ENCODING) as f:\n                data = json.load(f)\n            if not isinstance(data, list) or not all(isinstance(item, str) for item in data):\n                raise RepositoryError(f\"Invalid JSON format: expected a list of strings, got {type(data)}\")\n            return data\n        except FileNotFoundError:\n            raise RepositoryError(f\"File not found: {path}\")\n        except json.JSONDecodeError as e:\n            raise RepositoryError(f\"Invalid JSON in file {path}: {e}\")\n        except IOError as e:\n            raise RepositoryError(f\"Error reading file {path}: {e}\")\n\nclass ParenController:\n    \"\"\"Orchestrates parsing and optional persistence of parenthesis groups.\"\"\"\n    def __init__(self, parser: Parser, repo: Optional[FileRepository] = None) -> None:\n        self.parser = parser\n        self.repo = repo\n\n    def separate_and_optionally_save(self, input_str: str, save_path: Optional[str] = None) -> List[str]:\n        \"\"\"Parses the input string and optionally saves the results.\"\"\"\n        groups = self.parser.separate(input_str)\n        if save_path:\n            if self.repo is None:\n                raise RepositoryError(\"FileRepository not initialized for saving.\")\n            self.repo.save(groups, save_path)\n        return groups\n\nEXIT_SUCCESS = 0\nEXIT_IO_ERROR = 2\nEXIT_PARSE_ERROR = 3\n\ndef main(argv: Optional[List[str]] = None) -> int:\n    \"\"\"CLI entry point to parse input and print/save results.\"\"\"\n    parser = argparse.ArgumentParser(\n        description=\"Extracts separate balanced parenthesis groups from a string or file.\"\n    )\n    group = parser.add_mutually_exclusive_group(required=True)\n    group.add_argument('--string', type=str, help='Input string containing parentheses.')\n    group.add_argument('--file', type=str, help='Path to an input file containing parentheses.')\n    parser.add_argument('--save', type=str, help='Optional path to save results to a JSON file.')\n    \n    args = parser.parse_args(argv)\n\n    tokenizer = Tokenizer()\n    validator = Validator()\n    parser_service = Parser(tokenizer, validator)\n    repo = FileRepository()\n\n    controller = ParenController(parser_service, repo)\n\n    try:\n        input_content = \"\"\n        if args.string:\n            input_content = args.string\n        elif args.file:\n            try:\n                with open(args.file, 'r', encoding='utf-8') as f:\n                    input_content = f.read()\n            except FileNotFoundError:\n                print(f\"Error: Input file not found: {args.file}\", file=sys.stderr)\n                return EXIT_IO_ERROR\n            except IOError as e:\n                print(f\"Error reading input file {args.file}: {e}\", file=sys.stderr)\n                return EXIT_IO_ERROR\n        \n        if not input_content.strip():\n            groups: List[str] = []\n        else:\n            groups = controller.separate_and_optionally_save(input_content, args.save)\n        \n        print(json.dumps(groups, separators=(',', ':')))\n        return EXIT_SUCCESS\n    except (ParseError, ValidationError) as e:\n        print(f\"Error: {e.message}\", file=sys.stderr)\n        return EXIT_PARSE_ERROR\n    except RepositoryError as e:\n        print(f\"Error: {e.message}\", file=sys.stderr)\n        return EXIT_IO_ERROR\n    except Exception as e:\n        print(f\"An unexpected error occurred: {e}\", file=sys.stderr)\n        return 1\n\ndef separate_paren_groups(paren_string: str) -> List[str]:\n    \"\"\"Separates an input string into a list of top-level balanced parenthesis groups.\n    Spaces are ignored, and groups are returned in their original order.\n    \"\"\"\n    tokenizer = Tokenizer()\n    validator = Validator()\n    parser_service = Parser(tokenizer, validator)\n\n    if not paren_string.strip():\n        return []\n        \n    return parser_service.separate(paren_string)"}
{"task_id": "HumanEval/4", "solution": "from typing import List\n\n\ndef mean_absolute_deviation(numbers: List[float]) -> float:\n    \"\"\"Calculates the Mean Absolute Deviation (MAD) around the mean for a list of numbers.\n    MAD is the average absolute difference between each element and the dataset's mean.\n    \"\"\"\n    data_sum = sum(numbers)\n    data_count = len(numbers)\n    mean = data_sum / data_count\n    \n    sum_abs_deviations = sum(abs(x - mean) for x in numbers)\n    return sum_abs_deviations / data_count"}
{"task_id": "HumanEval/5", "solution": "```python\nfrom typing import List\n\ndef intersperse(numbers: List[int], delimeter: int) -> List[int]:\n    \"\"\" Insert a number 'delimeter' between every two consecutive elements of input list `numbers'\n    >>> intersperse([], 4)\n    []\n    >>> intersperse([1, 2, 3], 4)\n    [1, 4, 2, 4, 3]\n    \"\"\"\n    if not numbers:\n        return []\n    out: List[int] = []\n    for i, val in enumerate(numbers):\n        out.append(val)\n        if i != len(numbers) - 1:\n            out.append(delimeter)\n    return out\n```"}
{"task_id": "HumanEval/4", "solution": "```python\nfrom typing import List\n\ndef mean_absolute_deviation(numbers: List[float]) -> float:\n    \"\"\"For a given list of input numbers, calculate Mean Absolute Deviation\n    around the mean of this dataset. MAD is the average absolute difference\n    between each element and the mean.\n    \"\"\"\n    mean_val = sum(numbers) / len(numbers)\n    absolute_differences_sum = sum(abs(x - mean_val) for x in numbers)\n    mad_val = absolute_differences_sum / len(numbers)\n    return mad_val\n```"}
{"task_id": "HumanEval/5", "solution": "```python\nfrom typing import List\n\n\ndef intersperse(numbers: List[int], delimeter: int) -> List[int]:\n    \"\"\"\n    Inserts an integer delimeter between consecutive elements of an integer list.\n    Returns a new list with the delimeter interspersed.\n    \"\"\"\n    n = len(numbers)\n    if n <= 1:\n        return list(numbers)\n\n    result: List[int] = []\n    for i, v in enumerate(numbers):\n        result.append(v)\n        if i < n - 1:\n            result.append(delimeter)\n    return result\n```"}
{"task_id": "HumanEval/6", "solution": "```python\nfrom typing import List\n\n\ndef parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\" Input to this function is a string represented multiple groups for nested parentheses separated by spaces.\n    For each of the group, output the deepest level of nesting of parentheses.\n    \"\"\"\n    groups = paren_string.split()\n    results = []\n\n    for group in groups:\n        current_depth = 0\n        max_depth_for_group = 0\n\n        for char in group:\n            if char == '(':\n                current_depth += 1\n                if current_depth > max_depth_for_group:\n                    max_depth_for_group = current_depth\n            elif char == ')':\n                current_depth -= 1\n            # Per critical requirements, no error handling for invalid characters or unbalanced state.\n\n        results.append(max_depth_for_group)\n\n    return results\n```"}
{"task_id": "HumanEval/6", "solution": "from typing import List\n\ndef parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\"Input to this function is a string represented multiple groups for nested parentheses separated by spaces.\n    For each group, output the deepest level of nesting of parentheses.\n    \"\"\"\n    results: List[int] = []\n    # Split the input string by whitespace, automatically ignoring empty groups.\n    groups = paren_string.split()\n\n    for group_str in groups:\n        max_depth = 0\n        current_depth = 0\n        for char in group_str:\n            if char == '(':\n                current_depth += 1\n                if current_depth > max_depth:\n                    max_depth = current_depth\n            else:  # Assumes char is ')' due to \"trust the caller's inputs\" rule.\n                current_depth -= 1\n        results.append(max_depth)\n    return results"}
