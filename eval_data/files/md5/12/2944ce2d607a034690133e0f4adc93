estamp: datetime) -> None:\n        self.id = id\n        self.input_value = input_value\n        self.odd_digits = odd_digits\n        self.product = product\n        self.timestamp = timestamp\n\n    def to_dict(self) -> Dict[str, Any]:\n        \"\"\"Serializes the object to a JSON-friendly dictionary.\"\"\"\n        return {\n            \"id\": self.id,\n            \"input_value\": self.input_value,\n            \"odd_digits\": self.odd_digits,\n            \"product\": self.product,\n            \"timestamp\": self.timestamp.isoformat(timespec='seconds') + 'Z' # ISO8601 UTC\n        }\n\n    @staticmethod\n    def from_dict(d: Dict[str, Any]) -> 'DigitResult':\n        \"\"\"Deserializes a dictionary to a DigitResult object.\"\"\"\n        timestamp_str = d[\"timestamp\"]\n        # Handle optional 'Z' for UTC and ensure it's removed for datetime.fromisoformat\n        if timestamp_str.endswith('Z'):\n            timestamp_str = timestamp_str[:-1]\n        return DigitResult(\n            id=d[\"id\"],\n            input_value=d[\"input_value\"],\n            odd_digits=d[\"odd_digits\"],\n            product=d[\"product\"],\n            timestamp=datetime.fromisoformat(timestamp_str).replace(tzinfo=None) # Assume UTC if not specified\n        )\n\n```\n```python\n# src/digits_pkg/utils.py\nfrom typing import List\n\ndef digits_of(n: int) -> List[int]:\n    \"\"\"Extracts and returns a list of digits from a non-negative integer.\"\"\"\n    if n == 0:\n        return [0]\n    return [int(c) for c in str(abs(n))]\n\ndef is_odd(d: int) -> bool:\n    \"\"\"Checks if a given digit is odd.\"\"\"\n    return (d % 2) == 1\n\n```\n```python\n# src/digits_pkg/validators.py\nfrom typing import Any\nfrom .exceptions import InvalidInputError\n\nclass DigitValidator:\n    \"\"\"Validates and normalizes various forms of input for digit processing.\"\"\"\n    def validate_positive_integer(self, value: Any) -> int:\n        \"\"\"Validates if the input is a positive integer, allowing int or string types.\"\"\"\n        if isinstance(value, int):\n            if value <= 0:\n                raise InvalidInputError(\"Input integer must be positive.\")\n            return value\n        if isinstance(value, str):\n            try:\n                # Use parse_int_strict to ensure string contains only digits and no sign\n                return self.parse_int_strict(value)\n            except InvalidInputError as e:\n                # Re-raise with a more generic message if needed, or keep specific\n                raise InvalidInputError(f\"Invalid string input for positive integer: {e.args[0]}\") from e\n        raise InvalidInputError(f\"Unsupported input type for n: {type(value).__name__}. Expected int or str.\")\n\n    def parse_int_strict(self, value: str) -> int:\n        \"\"\"Parses a string into an integer, strictly disallowing non-digit characters and signs.\"\"\"\n        s = value.strip()\n        if not s.isdigit(): # This checks for only digits, no leading signs or decimal points\n            raise InvalidInputError(\"String must contain only digits (0-9).\")\n        v = int(s)\n        if v <= 0: # Ensure the resulting integer is positive\n            raise InvalidInputError(\"Parsed integer must be positive.\")\n        return v\n\n```\n```python\n# src/digits_pkg/repository.py\nimport json\nimport os\nimport tempfile\nimport shutil\nimport logging\nfrom typing import List, Any\nfrom pathlib import Path\n\nfrom .models import DigitResult\nfrom .exceptions import PersistenceError\n\nlogger = logging.getLogger(__name__)\n\nclass DigitRepository:\n    \"\"\"Manages persistence of DigitResult objects to a JSON history file.\"\"\"\n    def __init__(self, path: str) -> None:\n        self.path = Path(path)\n        # Ensure parent directory exists and set file permissions\n        self.path.parent.mkdir(parents=True, exist_ok=True)\n        # Attempt to set permissions for the directory, best effort\n        try:\n            os.chmod(self.path.parent, 0o700) # User rwx only for the cache directory\n        except OSError as e:\n            logger.warning(f\"Could not set permissions for {self.path.parent}: {e}\")\n\n    def _atomic_write_json(self, path: Path, data: Any) -> None:\n        \"\"\"Writes data to a JSON file using an atomic write pattern.\"\"\"\n        temp_filepath: Optional[Path] = None\n        try:\n            # Create a temporary file in the same directory for atomicity\n            with tempfile.NamedTemporaryFile(mode='w', delete=False, dir=path.parent, encoding=\"utf-8\") as tmp_file:\n                json.dump(data, tmp_file, indent=2, ensure_ascii=False)\n            temp_filepath = Path(tmp_file.name)\n            \n            # Set permissions for the temporary file before renaming\n            os.chmod(temp_filepath, 0o600) # User rw only\n            \n            # Atomically replace the target file with the temporary file\n            shutil.move(temp_filepath, path)\n        except Exception as e:\n            # Clean up temp file if something goes wrong before move\n            if temp_filepath and temp_filepath.exists():\n                os.remove(temp_filepath)\n            raise PersistenceError(f\"Failed to atomically write JSON to {path}: {e}\") from e\n\n    def save(self, result: DigitResult) -> None:\n        \"\"\"Appends a DigitResult to the JSON history file.\"\"\"\n        data = []\n        if self.path.exists():\n            try:\n                with open(self.path, \"r\", encoding=\"utf-8\") as f:\n                    data = json.load(f)\n                if not isinstance(data, list):\n                    logger.warning(f\"History file {self.path} is not a JSON array. Overwriting.\")\n                    data = []\n            except json.JSONDecodeError as e:\n                logger.warning(f\"History file {self.path} is corrupted. Overwriting. Error: {e}\")\n                data = []\n            except Exception as e:\n                raise PersistenceError(f\"Failed to read existing history from {self.path}: {e}\") from e\n\n        data.append(result.to_dict())\n        try:\n            self._atomic_write_json(self.path, data)\n        except PersistenceError:\n            raise # _atomic_write_json already wraps the error\n\n    def list_all(self) -> List[DigitResult]:\n        \"\"\"Loads and returns all DigitResult objects from the history file.\"\"\"\n        if not self.path.exists():\n            return []\n        \n        try:\n            with open(self.path, \"r\", encoding=\"utf-8\") as f:\n                data = json.load(f)\n            if not isinstance(data, list):\n                raise PersistenceError(f\"History file {self.path} content is not a JSON array.\")\n            return [DigitResult.from_dict(d) for d in data]\n        except (json.JSONDecodeError, FileNotFoundError, TypeError) as e:\n            raise PersistenceError(f\"Failed to load history from {self.path}: {e}\") from e\n        except Exception as e:\n            raise PersistenceError(f\"An unexpected error occurred while listing history from {self.path}: {e}\") from e\n\n```\n```python\n# src/digits_pkg/services.py\nimport logging\nfrom functools import reduce\nfrom operator import mul\nfrom datetime import datetime\nfrom uuid import uuid4\nfrom typing import List, Optional\n\nfrom . import utils\nfrom .models import DigitResult\nfrom .validators import DigitValidator\nfrom .repository import DigitRepository\nfrom .exceptions import InvalidInputError, PersistenceError\nfrom . import config\n\nlogger = logging.getLogger(__name__)\n\nclass DigitService:\n    \"\"\"Core business logic for computing the product of odd digits and coordinating persistence.\"\"\"\n    def __init__(self, repository: Optional[DigitRepository]=None, validator: Optional[DigitValidator]=None) -> None:\n        self.repository = repository\n        self.validator = validator if validator is not None else DigitValidator()\n\n    def compute_product(self, n: int, persist: Optional[bool]=None) -> DigitResult:\n        \"\"\"Computes the product of odd digits in a positive integer and optionally persists the result.\"\"\"\n        # 1. Use validator.validate_positive_integer(n) to normalize input.\n        n_norm = self.validator.validate_positive_integer(n)\n\n        # 2. digits = utils.digits_of(n)\n        digits: List[int] = utils.digits_of(n_norm)\n\n        # 3. odd_digits = [d for d in digits if utils.is_odd(d)]\n        odd_digits: List[int] = [d for d in digits if utils.is_odd(d)]\n\n        # 4. product = 0 if len(odd_digits)==0 else reduce(mul, odd_digits, 1)\n        product: int = 0\n        if odd_digits:\n            product = reduce(mul, odd_digits, 1) # Start product with 1 for non-empty list\n\n        # 5. result = DigitResult(...)\n        result = DigitResult(\n            id=str(uuid4()),\n            input_value=n_norm,\n            odd_digits=odd_digits,\n            product=product,\n            timestamp=datetime.utcnow()\n        )\n\n        # 6. If persist True and repository provided: call repository.save(result)\n        #    persist is True if explicitly set, or if None and config.PERSIST_DEFAULT is True\n        should_persist = persist if persist is not None else config.PERSIST_DEFAULT\n        if should_persist:\n            if self.repository:\n                try:\n                    self.repository.save(result)\n                except PersistenceError as e:\n                    # default: log and continue as per FR4\n                    logger.error(\"Failed to save computation history for input %s: %s\", n_norm, e)\n            else:\n                logger.debug(\"Persistence requested but no repository configured for DigitService.\")\n        \n        # 7. Return result.\n        return result\n\n```\n```python\n# src/digits_pkg/controllers.py\nimport argparse\nimport sys\nimport logging\nfrom typing import List, Optional\n\nfrom . import config\nfrom .services import DigitService\nfrom .validators import DigitValidator\nfrom .repository import DigitRepository\nfrom .exceptions import InvalidInputError, PersistenceError\n\nlogger = logging.getLogger(__name__)\n\nclass CLIController:\n    \"\"\"Handles command-line interface interactions, parsing arguments, and orchestrating service calls.\"\"\"\n    def __init__(self, service: Optional[DigitService]=None) -> None:\n        self.service = service\n        # If service is not provided, create a default one\n        if self.service is None:\n            repository = DigitRepository(config.expand_path(config.HISTORY_PATH))\n            validator = DigitValidator()\n            self.service = DigitService(repository=repository, validator=validator)\n            \n    def run(self, argv: List[str]) -> int:\n        \"\"\"Parses CLI arguments, executes the computation, prints the result, and returns an exit code.\"\"\"\n        parser = argparse.ArgumentParser(\n            prog=\"digits-cli\",\n            description=\"Computes the product of odd digits in a positive integer.\"\n        )\n        parser.add_argument(\n            \"n\", \n            type=str, # Parse as string initially for custom validation\n            help=\"The positive integer to process.\"\n        )\n        parser.add_argument(\n            \"--no-persist\", \n            action=\"store_true\", \n            help=\"Do not save the computation result to history.\"\n        )\n        parser.add_argument(\n            \"--history\", \n            type=str, \n            default=None, \n            help=f\"Specify an alternative path for the history JSON file (default: {config.HISTORY_PATH}).\"\n        )\n        \n        args = parser.parse_args(argv[1:])\n\n        try:\n            # Override repository path if --history flag is used\n            if args.history:\n                # Re-initialize the service's repository with the new path\n                self.service.repository = DigitRepository(config.expand_path(args.history))\n            \n            # Determine persistence flag for the service call\n            persist_flag = not args.no_persist\n\n            # Call the service to compute the product\n            result = self.service.compute_product(args.n, persist=persist_flag)\n            \n            # Print the product to stdout\n            print(result.product)\n            return 0\n        except InvalidInputError as e:\n            logger.error(f\"Invalid input provided: {e}\")\n            print(f\"Error: Invalid input: {e}\", file=sys.stderr)\n            return 2 # Exit code for usage/input errors\n        except PersistenceError as e:\n            # Persistence errors are logged by service and should not block result output\n            # If the service itself did not catch it (e.g., config for strict persistence),\n            # we'd catch it here. But by default, service logs and continues.\n            # So this block might only be hit if strict persistence is enabled, or if\n            # the _init_ of the repository failed earlier (e.g., bad path).\n            logger.error(f\"Persistence operation failed: {e}\")\n            print(f\"Warning: Failed to persist history. {e.args[0]}\", file=sys.stderr)\n            return 0 # Still return 0 as computation was successful\n        except Exception as e:\n            logger.exception(\"An unexpected error occurred during CLI execution.\")\n            print(f\"Error: An unexpected error occurred: {e}\", file=sys.stderr)\n            return 1 # Exit code for general runtime errors\n\n```\n```python\n# src/digits_pkg/main.py\nimport sys\nimport logging\nfrom typing import List, Optional\n\nfrom . import config\nfrom .controllers import CLIController\nfrom .services import DigitService\nfrom .repository import DigitRepository\nfrom .validators import DigitValidator\n\ndef main(argv: Optional[List[str]] = None) -> int:\n    \"\"\"Main entry point for the CLI application.\"\"\"\n    # Configure logging\n    logging.basicConfig(level=config.LOG_LEVEL, stream=sys.stderr,\n                        format='%(asctime)s - %(name)s - %(levelname)s - %(message)s')\n    \n    # If argv is None, sys.argv is used by argparse.\n    # If not None, it's used for testing.\n    \n    # Instantiate dependencies\n    # Repository path is expanded and parent dirs ensured on init\n    repository = DigitRepository(config.expand_path(config.HISTORY_PATH))\n    validator = DigitValidator()\n    service = DigitService(repository=repository, validator=validator)\n    controller = CLIController(service=service)\n\n    return controller.run(argv if argv is not None else sys.argv)\n\nif __name__ == \"__main__\":\n    # This block is not typically executed when installed as a console_script\n    # but serves for direct script execution during development.\n    sys.exit(main())\n\n```\n```toml\n# pyproject.toml\n[build-system]\nrequires = [\"setuptools>=61.0\"]\nbuild-backend = \"setuptools.build_meta\"\n\n[project]\nname = \"digits-pkg\"\nversion = \"0.1.0\"\nauthors = [\n  { name=\"Your Name\", email=\"your.email@example.com\" }, # Replace with actual author info\n]\ndescription = \"A library and CLI to compute the product of odd digits in an integer.\"\nreadme = \"README.md\"\nrequires-python = \">=3.9\"\nclassifiers = [\n    \"Programming Language :: Python :: 3\",\n    \"License :: OSI Approved :: MIT License\", # Assuming MIT License based on common practice\n    \"Operating System :: OS Independent\",\n]\ndependencies = [\n    # No external dependencies beyond stdlib as per NFR\n]\n\n[project.urls]\n\"Homepage\" = \"https://github.com/your-username/digits-pkg\" # Replace with actual URL\n\"Bug Tracker\" = \"https://github.com/your-username/digits-pkg/issues\" # Replace with actual URL\n\n[project.scripts]\ndigits-cli = \"digits_pkg.main:main\"\n\n[project.optional-dependencies]\ntest = [\n    \"pytest>=7.0\",\n]\n\n```"}
{"task_id": "HumanEval/130", "solution": "```python\nimport sys\nimport os\nimport json\nfrom typing import List, Optional, Any, Dict\n\n# --- src/tribonacci/exceptions.py ---\nclass ApplicationError(Exception):\n    \"\"\"Base exception for application-specific errors.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\nclass ValidationError(ApplicationError):\n    \"\"\"Indicates invalid client input.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n\nclass ComputationError(ApplicationError):\n    \"\"\"Errors during sequence computation.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n\n# --- src/tribonacci/models.py ---\nclass SequenceModel:\n    \"\"\"DTO representing Tribonacci sequence values.\"\"\"\n    def __init__(self, items: List[int]) -> None:\n        if not all(isinstance(x, int) for x in items):\n            raise ValidationError(\"Sequence items must be integers.\")\n        self.items = list(items)\n\n    def to_list(self) -> List[int]:\n        \"\"\"Returns a copy of the sequence items.\"\"\"\n        return list(self.items)\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the sequence.\"\"\"\n        return len(self.items)\n\n# --- src/tribonacci/utils.py ---\ndef safe_int_div(n: int, d: int) -> int:\n    \"\"\"Performs integer division, ensuring integer result.\"\"\"\n    return n // d\n\ndef to_json(obj: Any) -> str:\n    \"\"\"Serializes an object to a JSON string.\"\"\"\n    if isinstance(obj, SequenceModel):\n        return json.dumps(obj.to_list())\n    return json.dumps(obj)\n\ndef load_json_file(path: str) -> Dict[str, Any]:\n    \"\"\"Loads a JSON file from the given path.\"\"\"\n    if not os.path.exists(path):\n        return {}\n    try:\n        with open(path, 'r') as f:\n            return json.load(f)\n    except (json.JSONDecodeError, IOError) as e:\n        print(f\"Warning: Could not load cache from {path}: {e}\")\n        return {}\n\ndef save_json_file(path: str, data: Any) -> None:\n    \"\"\"Saves data to a JSON file at the given path.\"\"\"\n    try:\n        with open(path, 'w') as f:\n            json.dump(data, f, indent=2)\n    except IOError as e:\n        print(f\"Warning: Could not persist cache to {path}: {e}\")\n\n# --- src/tribonacci/validators.py ---\nMAX_N = 10000\n\ndef validate_non_negative_int(value: Any) -> int:\n    \"\"\"Validates if a value is a non-negative integer within MAX_N.\"\"\"\n    try:\n        n = int(value)\n    except (ValueError, TypeError):\n        raise ValidationError(\"n must be an integer.\")\n    if n < 0:\n        raise ValidationError(\"n must be non-negative.\")\n    if n > MAX_N:\n        raise ValidationError(f\"n is too large (max {MAX_N}).\")\n    return n\n\n# --- src/tribonacci/repositories.py ---\nclass CacheRepository:\n    \"\"\"Abstract base class for a cache repository.\"\"\"\n    def get(self, key: int) -> Optional[int]:\n        raise NotImplementedError\n\n    def set(self, key: int, value: int) -> None:\n        raise NotImplementedError\n\n    def bulk_set(self, data: Dict[int, int]) -> None:\n        raise NotImplementedError\n\n    def to_dict(self) -> Dict[int, int]:\n        raise NotImplementedError\n\nclass MemoryCacheRepository(CacheRepository):\n    \"\"\"In-memory implementation of CacheRepository.\"\"\"\n    def __init__(self) -> None:\n        self._store: Dict[int, int] = {}\n\n    def get(self, key: int) -> Optional[int]:\n        \"\"\"Retrieves a value from the cache by key.\"\"\"\n        return self._store.get(key)\n\n    def set(self, key: int, value: int) -> None:\n        \"\"\"Stores a value in the cache.\"\"\"\n        self._store[key] = value\n\n    def bulk_set(self, data: Dict[int, int]) -> None:\n        \"\"\"Stores multiple key-value pairs in the cache.\"\"\"\n        self._store.update(data)\n\n    def to_dict(self) -> Dict[int, int]:\n        \"\"\"Returns the entire cache as a dictionary.\"\"\"\n        return dict(self._store)\n\nclass FileCacheRepository(MemoryCacheRepository):\n    \"\"\"CacheRepository that persists to a JSON file.\"\"\"\n    DEFAULT_CACHE_FILE = \"cache.json\"\n\n    def __init__(self, file_path: str) -> None:\n        super().__init__()\n        self.file_path = file_path\n        self.load_from_file()\n\n    def load_from_file(self) -> None:\n        \"\"\"Loads cache data from the specified JSON file.\"\"\"\n        data = load_json_file(self.file_path)\n        # Convert string keys to integers\n        self._store = {int(k): v for k, v in data.items() if k.isdigit() and isinstance(v, int)}\n\n    def persist_to_file(self) -> None:\n        \"\"\"Persists the current cache to the specified JSON file.\"\"\"\n        # Convert integer keys to strings for JSON serialization\n        data_to_save = {str(k): v for k, v in self._store.items()}\n        save_json_file(self.file_path, data_to_save)\n\n# --- src/tribonacci/services.py ---\nclass TribonacciService:\n    \"\"\"Computes Tribonacci sequences and manages caching.\"\"\"\n    def __init__(self, cache: CacheRepository) -> None:\n        self._cache = cache\n        # Seed base values if missing in cache (tri(0) is an assumption)\n        if self._cache.get(0) is None:\n            self._cache.set(0, 1) # Assumption: tri(0) = 1 + 0/2 = 1\n        if self._cache.get(1) is None:\n            self._cache.set(1, 3) # Defined: tri(1) = 3\n\n    def compute_sequence(self, n: int) -> List[int]:\n        \"\"\"Returns a list of tri(0) through tri(n).\"\"\"\n        # Validate n here to ensure the core service doesn't receive invalid input.\n        # Controllers should also validate.\n        n = validate_non_negative_int(n)\n\n        self._compute_iterative(n)\n        \n        # Ensure values from 0 to n are retrieved.\n        sequence = [self._cache.get(i) for i in range(n + 1)]\n        if any(val is None for val in sequence):\n            raise ComputationError(\"Failed to compute full sequence for n={n}.\")\n        return [val for val in sequence if val is not None]\n\n    def _compute_iterative(self, n: int) -> None:\n        \"\"\"Iteratively computes and caches Tribonacci values up to n (or n+1).\"\"\"\n        # We need values up to n. If n is odd, tri(n) depends on tri(n+1).\n        # So, compute up to max_k_needed.\n        max_k_needed = n\n        if n % 2 != 0: # If n is odd, tri(n) needs tri(n+1)\n            max_k_needed = n + 1\n\n        for k in range(max_k_needed + 1):\n            if self._cache.get(k) is not None:\n                continue\n\n            value: int\n            if k == 0:\n                value = 1\n            elif k == 1:\n                value = 3\n            elif k % 2 == 0:  # k is even, k >= 2\n                value = 1 + safe_int_div(k, 2)\n            else:  # k is odd, k >= 3\n                # tri(k) = tri(k-1) + tri(k-2) + tri(k+1)\n                # k-1 and k-2 should already be in cache from previous iterations.\n                # k+1 is even, so tri(k+1) can be computed directly.\n                tri_k_minus_1 = self._cache.get(k - 1)\n                tri_k_minus_2 = self._cache.get(k - 2)\n\n                if tri_k_minus_1 is None or tri_k_minus_2 is None:\n                    # This indicates an unexpected state if the loop is correct.\n                    raise ComputationError(f\"Missing prior values for tri({k}) during iterative computation.\")\n\n                # Ensure tri(k+1) is computed and cached if not already present\n                tri_k_plus_1 = self._cache.get(k + 1)\n                if tri_k_plus_1 is None:\n                    # k+1 is always even here.\n                    tri_k_plus_1 = 1 + safe_int_div(k + 1, 2)\n                    self._cache.set(k + 1, tri_k_plus_1)\n                \n                value = tri_k_minus_1 + tri_k_minus_2 + tri_k_plus_1\n            \n            self._cache.set(k, value)\n\n# --- src/tribonacci/controllers.py ---\nclass CLIController:\n    \"\"\"Handles CLI requests and orchestrates service calls.\"\"\"\n    def __init__(self, service: TribonacciService, cache_repo: Optional[FileCacheRepository] = None) -> None:\n        self._service = service\n        self._cache_repo = cache_repo\n\n    def run(self, argv: List[str]) -> int:\n        \"\"\"Executes the CLI command based on argv.\"\"\"\n        if len(argv) != 2:\n            print(\"Usage: tri <n>\")\n            return 1\n\n        try:\n            n_str = argv[1]\n            n = validate_non_negative_int(n_str)\n            \n            sequence = self._service.compute_sequence(n)\n            print(to_json(sequence))\n            \n            if self._cache_repo:\n                self._cache_repo.persist_to_file()\n            return 0\n        except ValidationError as e:\n            print(f\"Error: {e.message}\")\n            return 2\n        except ComputationError as e:\n            print(f\"Computation error: {e.message}\")\n            return 3\n        except Exception as e:\n            print(f\"An unexpected error occurred: {e}\")\n            return 1\n\nclass APIController:\n    \"\"\"Handles API requests and orchestrates service calls.\"\"\"\n    def __init__(self, service: TribonacciService) -> None:\n        self._service = service\n\n    def get_sequence(self, n: int) -> SequenceModel:\n        \"\"\"Fetches the Tribonacci sequence for n.\"\"\"\n        # Validation is handled by FastAPI path parameter type hint and FR1.\n        # Service also re-validates to be safe.\n        sequence_list = self._service.compute_sequence(n)\n        return SequenceModel(sequence_list)\n\n# --- src/tribonacci/__init__.py ---\n# High-level library function for direct programmatic use.\n_default_memory_cache = MemoryCacheRepository()\n_default_service = TribonacciService(_default_memory_cache)\n\ndef compute_sequence(n: int) -> List[int]:\n    \"\"\"\n    Computes the Tribonacci sequence up to n using a default in-memory cache.\n    This is the primary programmatic API for the library.\n    \"\"\"\n    return _default_service.compute_sequence(n)\n\n# --- src/tribonacci/api_server.py ---\n# This part assumes FastAPI and uvicorn are installed.\n# To run: uvicorn tribonacci.api_server:create_app --factory --host 0.0.0.0 --port 8000\ntry:\n    from fastapi import FastAPI, HTTPException, Request, Response, status\n    from fastapi.responses import JSONResponse\n    from fastapi.routing import APIRoute\n    from contextlib import asynccontextmanager\n    import uvicorn\nexcept ImportError:\n    FastAPI = None\n    HTTPException = None\n    Request = None\n    Response = None\n    status = None\n    JSONResponse = None\n    APIRoute = None\n    asynccontextmanager = None\n    uvicorn = None\n    print(\"FastAPI and Uvicorn are not installed. HTTP API will not be available.\")\n\nif FastAPI:\n    _api_cache_repo: Optional[FileCacheRepository] = None\n\n    @asynccontextmanager\n    async def lifespan(app: FastAPI):\n        \"\"\"Context manager for FastAPI application lifecycle.\"\"\"\n        global _api_cache_repo\n        # Startup: cache already loaded in FileCacheRepository constructor if applicable\n        yield\n        # Shutdown: persist cache if it's a FileCacheRepository\n        if _api_cache_repo and isinstance(_api_cache_repo, FileCacheRepository):\n            print(\"Persisting cache on shutdown...\")\n            _api_cache_repo.persist_to_file()\n\n    def create_app(cache_file: Optional[str] = None) -> FastAPI:\n        \"\"\"Creates and configures the FastAPI application.\"\"\"\n        global _api_cache_repo\n\n        app = FastAPI(lifespan=lifespan, title=\"Tribonacci API\")\n\n        # Initialize cache and service based on cache_file\n        if cache_file:\n            _api_cache_repo = FileCacheRepository(cache_file)\n        else:\n            _api_cache_repo = MemoryCacheRepository()\n\n        service = TribonacciService(_api_cache_repo)\n        controller = APIController(service)\n\n        @app.get(\"/tri/{n}\", response_model=List[int], summary=\"Get Tribonacci sequence\")\n        async def get_tri(n: int = Path(..., description=\"Non-negative integer n\")) -> List[int]:\n            \"\"\"\n            Returns the first n+1 values of the Tribonacci sequence.\n            Example: /tri/3 returns [1, 3, 2, 8].\n            \"\"\"\n            try:\n                model = controller.get_sequence(n)\n                return model.to_list()\n            except ValidationError as e:\n                raise HTTPException(status_code=status.HTTP_400_BAD_REQUEST, detail=e.message)\n            except ComputationError as e:\n                raise HTTPException(status_code=status.HTTP_500_INTERNAL_SERVER_ERROR, detail=f\"Computation failed: {e.message}\")\n            except Exception as e:\n                raise HTTPException(status_code=status.HTTP_500_INTERNAL_SERVER_ERROR, detail=f\"An unexpected error occurred: {e}\")\n        \n        return app\n\n# Placeholder for Path if FastAPI is not imported\nif FastAPI is None:\n    class Path:\n        def __init__(self, default, description):\n            self.default = default\n            self.description = description\n        def __call__(self, value):\n            return value\n\n# --- src/tribonacci/app.py ---\n# This file provides the CLI entrypoint.\nclass CLIApp:\n    \"\"\"Command-line interface application entry point.\"\"\"\n    def main(self, argv: Optional[List[str]] = None) -> int:\n        \"\"\"Main entry point for the CLI application.\"\"\"\n        argv = argv if argv is not None else sys.argv\n\n        # Determine cache file path from environment or default\n        cache_file_path = os.environ.get(\"TRIBO_CACHE_FILE\", FileCacheRepository.DEFAULT_CACHE_FILE)\n        \n        # Instantiate cache and service\n        cache_repo = FileCacheRepository(cache_file_path)\n        service = TribonacciService(cache_repo)\n        controller = CLIController(service, cache_repo=cache_repo) # Pass cache_repo for explicit persistence\n\n        # CLI expects arguments after the script name (e.g., 'python -m tribonacci.app tri 3')\n        # We need to skip the script name and the 'tri' command itself.\n        if len(argv) > 1 and argv[1] == \"tri\":\n            return controller.run(argv[1:]) # Pass ['tri', <n>]\n        else:\n            print(\"Usage: python -m tribonacci.app tri <n>\")\n            return 1\n\n# If this script is run directly, provide a simple way to execute the CLI.\n# This __name__ == \"__main__\" block is for the CLI entry point defined in the design.\nif __name__ == \"__main__\":\n    cli_app = CLIApp()\n    sys.exit(cli_app.main(sys.argv))\n\n```"}
{"task_id": "HumanEval/132", "solution": "```python\ndef is_nested(string):\n    \"\"\"Checks if a string of brackets contains a nested subsequence.\n    A nested subsequence has depth >= 2, meaning it forms '[[]]' or deeper.\n    \"\"\"\n    n = len(string)\n    # suffix_close[i] stores the count of ']' characters from index i to n-1.\n    suffix_close = [0] * n\n    cnt = 0\n    for i in range(n - 1, -1, -1):\n        if string[i] == ']':\n            cnt += 1\n        suffix_close[i] = cnt\n\n    # seen_open tracks if at least one '[' has been encountered.\n    seen_open = False\n    for i, ch in enumerate(string):\n        if ch == '[':\n            # If a previous '[' was seen and there are at least two ']' characters\n            # appearing later in the string, then a nested subsequence '[ [ ] ]' exists.\n            if seen_open and suffix_close[i] >= 2:\n                return True\n            seen_open = True\n    return False\n```"}
{"task_id": "HumanEval/132", "solution": "def is_nested(string):\n    \"\"\"\n    Checks if a string containing only square brackets has a nested subsequence like '[[]]'.\n    This involves finding four brackets in sequence: an opening, an opening, a closing, then a closing.\n    \"\"\"\n    n = len(string)\n    \n    first_open_idx = -1\n    for i in range(n):\n        if string[i] == '[':\n            first_open_idx = i\n            break\n    if first_open_idx == -1:\n        return False\n\n    second_open_idx = -1\n    for j in range(first_open_idx + 1, n):\n        if string[j] == '[':\n            second_open_idx = j\n            break\n    if second_open_idx == -1:\n        return False\n\n    first_close_idx = -1\n    for k in range(second_open_idx + 1, n):\n        if string[k] == ']':\n            first_close_idx = k\n            break\n    if first_close_idx == -1:\n        return False\n\n    for l in range(first_close_idx + 1, n):\n        if string[l] == ']':\n            return True\n            \n    return False"}
{"task_id": "HumanEval/133", "solution": "import math\n\ndef sum_squares(lst):\n    \"\"\"\n    Computes the sum of squared numbers in a list after rounding each element up (ceiling).\n    Each number is first rounded up to the nearest integer, then squared, and finally summed.\n    \"\"\"\n    total_sum = 0\n    for num in lst:\n        # Round the number up to the nearest integer.\n        ceiled_num = math.ceil(num)\n        # Square the ceiled number and add to the total.\n        total_sum += ceiled_num ** 2\n    return total_sum"}
{"task_id": "HumanEval/133", "solution": "import math\n\ndef sum_squares(lst):\n    \"\"\"Calculates the sum of squared numbers in a list after rounding each element up to the nearest integer. The result is an integer.\"\"\"\n    total = 0\n    for x in lst:\n        rounded_up = int(math.ceil(x))\n        total += rounded_up * rounded_up\n    return total"}
