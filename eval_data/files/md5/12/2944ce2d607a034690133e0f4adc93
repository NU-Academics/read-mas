{"task_id": "HumanEval/91", "solution": "import re\n\ndef is_bored(S):\n    \"\"\"Counts sentences starting with 'I' in a string.\n    Sentences are split by '.', '?', or '!'.\n    \"\"\"\n\n    boredom_count = 0\n\n    # Compile regex for normalizing whitespace (replacing runs of any whitespace with a single space).\n    _WHITESPACE_NORMALIZER_RE = re.compile(r\"\\s+\")\n    normalized_text = _WHITESPACE_NORMALIZER_RE.sub(\" \", S).strip()\n\n    # Compile regex for splitting sentences based on contiguous runs of specified delimiters.\n    _SENTENCE_SPLITTER_RE = re.compile(r\"[.?!]+\")\n    # Split the normalized text into potential sentence fragments.\n    fragments = _SENTENCE_SPLITTER_RE.split(normalized_text)\n\n    # Compile regex for extracting the first token from a sentence fragment.\n    # It ignores leading non-alphanumeric or non-apostrophe characters and captures the first word.\n    _FIRST_TOKEN_EXTRACTOR_RE = re.compile(r\"^[^A-Za-z0-9']*([A-Za-z']+)\", re.U)\n\n    for frag in fragments:\n        # Clean up leading/trailing whitespace for the current fragment.\n        frag = frag.strip()\n\n        # Skip fragments that are empty after stripping whitespace.\n        if not frag:\n            continue\n\n        # Attempt to extract the first token from the cleaned fragment.\n        match = _FIRST_TOKEN_EXTRACTOR_RE.match(frag)\n        first_token = match.group(1) if match else None\n\n        # Check if the extracted first token is exactly the uppercase \"I\".\n        if first_token == \"I\":\n            boredom_count += 1\n\n    return boredom_count"}
{"task_id": "HumanEval/92", "solution": "```python\ndef any_int(x, y, z):\n    '''\n    Returns true if one of the numbers is equal to the sum of the other two, and all numbers are integers.\n    Returns false in any other cases.\n    '''\n    # Convert all inputs to float to uniformly check for integer-ness and perform comparisons.\n    fx = float(x)\n    fy = float(y)\n    fz = float(z)\n\n    # Check if all numbers are integer-equivalent (e.g., 5, 2, 7 or 5.0, 2.0, 7.0).\n    if not (fx.is_integer() and fy.is_integer() and fz.is_integer()):\n        return False\n    \n    # Check if one of the numbers is equal to the sum of the other two.\n    return (fx == fy + fz) or \\\n           (fy == fx + fz) or \\\n           (fz == fx + fy)\n\n```"}
{"task_id": "HumanEval/91", "solution": "```python\nimport re\n\ndef is_bored(S):\n    \"\"\"\n    Counts sentences starting with \"I\", delimited by '.', '?' or '!'.\n    Leading and trailing punctuation are ignored for the first token.\n    \"\"\"\n\n    def _clean_first_token_internal(token_str: str) -> str:\n        \"\"\"Removes leading/trailing quotes, parentheses, and other specific punctuation from a token.\"\"\"\n        token_str = token_str.strip()\n        # Remove leading punctuation (quotes, parentheses, brackets)\n        token_str = token_str.lstrip('\"\\u201c\\u201d\\'(`[')\n        # Remove trailing punctuation (quotes, parentheses, brackets, comma, dot)\n        token_str = token_str.rstrip('\"\\u201c\\u201d\\'`)],.')\n        return token_str\n\n    def _extract_cleaned_first_token_internal(sentence_text: str) -> str | None:\n        \"\"\"Extracts and cleans the first word-like token from a sentence.\"\"\"\n        # Split by whitespace to get words\n        tokens = sentence_text.split()\n        if not tokens:\n            return None\n        # Clean the very first token found\n        return _clean_first_token_internal(tokens[0])\n\n    boredom_count = 0\n    # Split the input text into potential sentences using '.', '?', '!' as delimiters.\n    # The split method discards the delimiters themselves.\n    # Any final segment without a delimiter is treated as a sentence.\n    raw_sentence_parts = re.split(r'[.?!]', S)\n\n    for part in raw_sentence_parts:\n        # Trim leading/trailing whitespace from each potential sentence part.\n        trimmed_sentence = part.strip()\n        \n        # Ignore empty strings or strings that were purely whitespace after trimming.\n        if not trimmed_sentence:\n            continue\n\n        # Extract and clean the first token of the trimmed sentence.\n        first_token = _extract_cleaned_first_token_internal(trimmed_sentence)\n        \n        # Check if the cleaned first token is exactly \"I\" (case-sensitive).\n        if first_token == \"I\":\n            boredom_count += 1\n            \n    return boredom_count\n```"}
{"task_id": "HumanEval/92", "solution": "```python\n# pyproject.toml\n[project]\nname = \"any-int-checker\"\nversion = \"0.1.0\"\ndescription = \"A Python library and CLI to check if one of three numbers equals the sum of the other two, given all are integers.\"\nauthors = [{ name = \"Your Name\", email = \"your.email@example.com\" }]\nreadme = \"README.md\"\nrequires-python = \">=3.9\"\nkeywords = [\"any_int\", \"integer\", \"checker\"]\nclassifiers = [\n    \"Programming Language :: Python :: 3\",\n    \"License :: OSI Approved :: MIT License\",\n    \"Operating System :: OS Independent\",\n    \"Topic :: Software Development :: Libraries :: Python Modules\",\n]\n\n[project.scripts]\nany-int = \"any_int_checker.controllers:cli_main\"\n\n[project.urls]\nHomepage = \"https://github.com/yourusername/any-int-checker\" # Placeholder\nRepository = \"https://github.com/yourusername/any-int-checker\" # Placeholder\n\n[build-system]\nrequires = [\"setuptools>=61.0\"]\nbuild-backend = \"setuptools.build_meta\"\n\n[tool.setuptools.packages.find]\nwhere = [\"src\"]\n```\n\n```markdown\n# README.md\n# any-int-checker\n\nA Python library and CLI tool to determine if one of three supplied numbers equals the sum of the other two, only when all three inputs are strictly integers.\n\n## Installation\n\n```bash\npip install any-int-checker\n```\n\n## Usage\n\n### Library API\n\n```python\nfrom any_int_checker import any_int\n# or: from any_int_checker.api import any_int\n\nprint(any_int(5, 2, 7))     # True\nprint(any_int(3, 2, 2))     # False\nprint(any_int(3, -2, 1))    # True\n\ntry:\n    print(any_int(3.6, -2.2, 2)) # Raises InvalidTypeError\nexcept Exception as e:\n    print(e)\n```\n\n### Command Line Interface (CLI)\n\n```bash\nany-int 5 2 7\n# Output: True\n\nany-int 3 2 2\n# Output: False\n\nany-int 3.6 -2.2 2\n# Output: Error: All three arguments must be strictly integers.\n# Exit code: 2\n\nany-int 1 2\n# Output: Error: Expected three numeric arguments, but received 2.\n# Exit code: 2\n```\n```\n\n```python\n# src/any_int_checker/__init__.py\n\"\"\"\nany-int-checker package.\nExposes the primary API function `any_int`.\n\"\"\"\nfrom ._version import __version__\nfrom .api import any_int\n\n__all__ = [\"any_int\", \"__version__\"]\n```\n\n```python\n# src/any_int_checker/api.py\nfrom typing import Any\nfrom .controllers import library_any_int\n\ndef any_int(x: Any, y: Any, z: Any) -> bool:\n    \"\"\"\n    Public API: returns True if one of x, y, z equals the sum of the other two,\n    AND all inputs are strictly integers. Raises InvalidTypeError for non-integer inputs.\n    \"\"\"\n    return library_any_int(x, y, z)\n```\n\n```python\n# src/any_int_checker/controllers.py\nimport sys\nfrom typing import List, Any\nfrom .models import NumberTriple\nfrom .services import AnyIntService\nfrom .validators import are_all_integers\nfrom .utils import parse_cli_args\nfrom .exceptions import InvalidArgumentError, InvalidTypeError\n\ndef library_any_int(x: Any, y: Any, z: Any) -> bool:\n    \"\"\"\n    Controller function for the public library API.\n    Validates inputs, calls the service, and returns a boolean result.\n    Raises InvalidTypeError if any input is not a strict integer.\n    \"\"\"\n    input_triple = NumberTriple(x, y, z)\n    if not are_all_integers(input_triple):\n        raise InvalidTypeError(\"All three arguments must be strictly integers.\")\n    \n    service = AnyIntService()\n    result = service.check(input_triple)\n    return result.to_bool()\n\ndef cli_main(argv: List[str]) -> int:\n    \"\"\"\n    Main entry point for the command-line interface.\n    Parses arguments, handles errors, prints results, and returns an exit code.\n    \"\"\"\n    try:\n        # parse_cli_args handles stripping program name if present in argv.\n        triple = parse_cli_args(argv) \n    except InvalidArgumentError as e:\n        print(f\"Error: {e}\", file=sys.stderr)\n        return 2 # Exit code for invalid arguments\n    \n    try:\n        val = library_any_int(triple.x, triple.y, triple.z)\n        print(str(val))\n        return 0 # Success exit code\n    except InvalidTypeError as e:\n        print(f\"Error: {e}\", file=sys.stderr)\n        return 2 # Exit code for invalid input type (non-int)\n    except Exception:\n        # Catch any unexpected errors from the internal logic.\n        print(\"Error: An unexpected internal error occurred.\", file=sys.stderr)\n        return 1 # Generic internal error exit code\n\n```\n\n```python\n# src/any_int_checker/services.py\nfrom .models import NumberTriple, Result\nfrom .validators import are_all_integers\nfrom .exceptions import InvalidTypeError\nfrom typing import Any, Tuple\n\nclass AnyIntService:\n    \"\"\"\n    Core service that implements the business logic: checking if one number\n    is the sum of the other two, given they are all integers.\n    \"\"\"\n    def __init__(self) -> None:\n        pass\n\n    def check(self, triple: NumberTriple) -> Result:\n        \"\"\"\n        Determines if one value in the triple equals the sum of the other two.\n        Raises InvalidTypeError if the triple's values are not all strictly integers.\n        \"\"\"\n        # Service level validation ensures correct types for arithmetic operations.\n        if not are_all_integers(triple):\n            raise InvalidTypeError(\"All values must be strictly integers for the sum check.\")\n\n        # Type checking has confirmed x, y, z are int at this point.\n        # We can safely use them in integer arithmetic.\n        x_val: int = triple.x \n        y_val: int = triple.y\n        z_val: int = triple.z\n\n        if self._check_equality(x_val, y_val, z_val):\n            return Result(True, x_val, (y_val, z_val))\n        if self._check_equality(y_val, x_val, z_val):\n            return Result(True, y_val, (x_val, z_val))\n        if self._check_equality(z_val, x_val, y_val):\n            return Result(True, z_val, (x_val, y_val))\n        \n        return Result(False, None, None)\n\n    def _check_equality(self, a: int, b: int, c: int) -> bool:\n        \"\"\"Internal helper to check if a equals the sum of b and c.\"\"\"\n        return a == (b + c)\n```\n\n```python\n# src/any_int_checker/validators.py\nfrom .models import NumberTriple\nfrom typing import Any\n\ndef is_integer(value: Any) -> bool:\n    \"\"\"\n    Checks if a given value is a strict Python integer (type int).\n    Floats, even if mathematically whole numbers, return False.\n    \"\"\"\n    return isinstance(value, int)\n\ndef are_all_integers(triple: NumberTriple) -> bool:\n    \"\"\"\n    Checks if all three values in a NumberTriple are strict Python integers.\n    Returns True if all are integers, False otherwise.\n    \"\"\"\n    return is_integer(triple.x) and is_integer(triple.y) and is_integer(triple.z)\n```\n\n```python\n# src/any_int_checker/models.py\nfrom typing import Optional, Tuple, Any\n\nclass NumberTriple:\n    \"\"\"\n    Data Transfer Object for holding three potential numbers.\n    It accepts any object type during initialization, with type validation\n    expected to occur in a separate validation layer.\n    \"\"\"\n    def __init__(self, x: Any, y: Any, z: Any) -> None:\n        self.x: Any = x\n        self.y: Any = y\n        self.z: Any = z\n\n    def as_tuple(self) -> Tuple[Any, Any, Any]:\n        \"\"\"Returns the values as a tuple.\"\"\"\n        return (self.x, self.y, self.z)\n\nclass Result:\n    \"\"\"\n    Data Transfer Object for carrying the outcome of the sum-check.\n    It stores whether a match was found and, if so, the matched values.\n    \"\"\"\n    def __init__(self, matched: bool, matched_value: Optional[Any], matched_pair: Optional[Tuple[Any, Any]]) -> None:\n        self.matched: bool = matched\n        self.matched_value: Optional[Any] = matched_value\n        self.matched_pair: Optional[Tuple[Any, Any]] = matched_pair\n\n    def to_bool(self) -> bool:\n        \"\"\"Returns the boolean matched status.\"\"\"\n        return self.matched\n```\n\n```python\n# src/any_int_checker/exceptions.py\nclass InvalidTypeError(ValueError):\n    \"\"\"\n    Exception raised when one or more inputs are not strictly integers.\n    This signifies a violation of the type precondition for the core logic.\n    \"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n\nclass InvalidArgumentError(ValueError):\n    \"\"\"\n    Exception raised when CLI arguments are malformed (wrong count, unparsable).\n    Indicates issues with command-line input parsing or arity.\n    \"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n```\n\n```python\n# src/any_int_checker/utils.py\nfrom typing import List, Any\nfrom .models import NumberTriple\nfrom .exceptions import InvalidArgumentError\n\ndef parse_cli_args(argv: List[str]) -> NumberTriple:\n    \"\"\"\n    Parses command-line arguments, converting the first three numeric tokens to integers.\n    Raises InvalidArgumentError for incorrect argument count or non-integer values.\n    \"\"\"\n    args_to_parse = argv \n    # Heuristically check if the first argument is likely the program name and strip it.\n    if len(argv) >= 4 and isinstance(argv[0], str) and (\"any-int\" in argv[0] or argv[0].endswith(\"python\")):\n        args_to_parse = argv[1:]\n    \n    if len(args_to_parse) < 3:\n        raise InvalidArgumentError(f\"Expected three numeric arguments, but received {len(args_to_parse)}.\")\n    \n    try:\n        x = int(args_to_parse[0])\n        y = int(args_to_parse[1])\n        z = int(args_to_parse[2])\n    except ValueError as e:\n        raise InvalidArgumentError(\"Arguments must be strictly integers (e.g., '3' not '3.0').\") from e\n    except IndexError: # Defensive, though typically caught by len check.\n        raise InvalidArgumentError(\"Insufficient arguments provided after parsing.\")\n\n    return NumberTriple(x, y, z)\n```\n\n```python\n# src/any_int_checker/_version.py\n\"\"\"\nPackage version constant.\n\"\"\"\n__version__ = \"0.1.0\"\n```"}
{"task_id": "HumanEval/93", "solution": "def encode(message):\n    \"\"\"\n    Encodes a message by swapping case of letters and replacing vowels.\n    Vowels are replaced by the letter 2 places ahead in the alphabet.\n    \"\"\"\n    VOWELS = \"aeiou\"\n    ALPHABET = \"abcdefghijklmnopqrstuvwxyz\"\n    transformed_chars = []\n\n    for char in message:\n        if char == ' ':\n            transformed_chars.append(' ')\n            continue\n\n        is_char_upper = char.isupper()\n        original_lower = char.lower()\n\n        processed_lower_char = original_lower\n        if original_lower in VOWELS:\n            idx = ALPHABET.index(original_lower)\n            processed_lower_char = ALPHABET[(idx + 2) % len(ALPHABET)]\n\n        # Apply case swap: if original was upper, final is lower; if original was lower, final is upper.\n        if is_char_upper:\n            transformed_chars.append(processed_lower_char.lower())\n        else:\n            transformed_chars.append(processed_lower_char.upper())\n\n    return \"\".join(transformed_chars)"}
{"task_id": "HumanEval/94", "solution": "def skjkasdkd(lst):\n    \"\"\"Finds the largest prime in a list of integers and returns the sum of its digits.\n    If no prime is found, it returns 0.\n    \"\"\"\n\n    def sum_of_digits(n: int) -> int:\n        \"\"\"Computes the sum of the absolute value of an integer's digits.\"\"\"\n        n_abs = abs(n)\n        total = 0\n        while n_abs > 0:\n            total += n_abs % 10\n            n_abs //= 10\n        return total\n\n    def is_prime(n: int) -> bool:\n        \"\"\"Checks if a number is prime using a deterministic Miller-Rabin test.\"\"\"\n        if n < 2:\n            return False\n        if n == 2 or n == 3:\n            return True\n        if n % 2 == 0:\n            return False\n\n        # Determine d and s such that n-1 = d * 2^s, where d is odd\n        s = 0\n        d = n - 1\n        while d % 2 == 0:\n            d //= 2\n            s += 1\n\n        # Bases for deterministic Miller-Rabin for n < 2^64\n        bases = [2, 325, 9375, 28178, 450775, 9780504, 179526502]\n\n        for a in bases:\n            if a >= n: # Skip bases larger than or equal to n, as pow(a, d, n) would be trivial.\n                continue\n\n            x = pow(a, d, n)\n            if x == 1 or x == n - 1:\n                continue\n\n            composite = True\n            for _ in range(s - 1):\n                x = pow(x, 2, n)\n                if x == n - 1:\n                    composite = False\n                    break\n            if composite:\n                return False\n        return True\n\n    largest_prime = 0\n\n    for num in lst:\n        if is_prime(num):\n            if num > largest_prime:\n                largest_prime = num\n\n    if largest_prime == 0:\n        return 0\n    else:\n        return sum_of_digits(largest_prime)"}
{"task_id": "HumanEval/93", "solution": "def encode(message):\n    \"\"\"Encodes a message by swapping case and replacing vowels.\n    Vowels are replaced by the letter 2 positions ahead, preserving swapped case.\n    \"\"\"\n    encoded_chars = []\n    vowel_map = {'a': 'c', 'e': 'g', 'i': 'k', 'o': 'q', 'u': 'w'}\n    vowels = {'a', 'e', 'i', 'o', 'u'}\n\n    for char in message:\n        if char.isspace():\n            encoded_chars.append(char)\n        else:\n            original_char_lower = char.lower()\n            swapped_char = char.swapcase()\n\n            if original_char_lower in vowels:\n                base_replacement = vowel_map[original_char_lower]\n                if swapped_char.isupper():\n                    final_char = base_replacement.upper()\n                else:\n                    final_char = base_replacement.lower()\n                encoded_chars.append(final_char)\n            else:\n                encoded_chars.append(swapped_char)\n    \n    return \"\".join(encoded_chars)"}
{"task_id": "HumanEval/94", "solution": "def skjkasdkd(lst):\n    \"\"\"Finds the largest prime in a list and returns the sum of its digits.\n    If no prime is found, it returns 0.\n    \"\"\"\n\n    def is_prime(n: int) -> bool:\n        \"\"\"Checks if a number is prime using trial division.\"\"\"\n        if n < 2:\n            return False\n        if n == 2 or n == 3:\n            return True\n        if n % 2 == 0 or n % 3 == 0:\n            return False\n        i = 5\n        while i * i <= n:\n            if n % i == 0 or n % (i + 2) == 0:\n                return False\n            i += 6\n        return True\n\n    def digit_sum(n: int) -> int:\n        \"\"\"Calculates the sum of the digits of a number.\"\"\"\n        return sum(int(digit) for digit in str(abs(n)))\n\n    largest_prime = None\n    for number in lst:\n        # Negative numbers, 0, and 1 are not considered prime.\n        # The is_prime function handles numbers < 2 correctly.\n        if is_prime(number):\n            if largest_prime is None or number > largest_prime:\n                largest_prime = number\n\n    if largest_prime is None:\n        return 0\n    else:\n        return digit_sum(largest_prime)"}
{"task_id": "HumanEval/95", "solution": "```python\ndef check_dict_case(dict):\n    \"\"\"\n    Checks if all dictionary keys are uniformly lowercase or uniformly uppercase strings.\n    Returns False if the dictionary is empty or contains non-string keys.\n    \"\"\"\n    if not dict:\n        return False\n\n    string_keys = []\n    for key in dict.keys():\n        if not isinstance(key, str):\n            return False\n        string_keys.append(key)\n\n    all_are_lower_cased = True\n    for key in string_keys:\n        if key != key.lower():\n            all_are_lower_cased = False\n            break\n\n    all_are_upper_cased = True\n    for key in string_keys:\n        if key != key.upper():\n            all_are_upper_cased = False\n            break\n\n    # The dictionary is uniformly cased if all keys are lower-cased but not all upper-cased,\n    # or if all keys are upper-cased but not all lower-cased.\n    return (all_are_lower_cased and not all_are_upper_cased) or \\\n           (all_are_upper_cased and not all_are_lower_cased)\n\n```"}
{"task_id": "HumanEval/96", "solution": "import math\n\ndef count_up_to(n):\n    \"\"\"\n    Finds all prime numbers strictly less than n using the Sieve of Eratosthenes algorithm.\n    Returns an empty list for any input n less than or equal to 2.\n    \"\"\"\n    if n <= 2:\n        return []\n\n    # Initialize a boolean array 'sieve' where sieve[i] is true if i is potentially prime.\n    sieve = bytearray(b'\\x01') * n\n    sieve[0:2] = b'\\x00\\x00'  # 0 and 1 are not prime numbers.\n\n    # Iterate from 2 up to the square root of n to mark multiples.\n    for p in range(2, int(math.isqrt(n)) + 1):\n        if sieve[p]:\n            # If p is prime, mark all its multiples as not prime.\n            step = p\n            start = p * p\n            # Efficiently set a slice of the bytearray to zeros.\n            sieve[start:n:step] = b'\\x00' * ((n - 1 - start) // step + 1)\n\n    # Collect all numbers that remain marked as prime.\n    return [i for i, isprime in enumerate(sieve) if isprime]"}
{"task_id": "HumanEval/95", "solution": "```python\ndef check_dict_case(dictionary):\n    \"\"\"\n    Given a dictionary, return True if all keys are strings in lower\n    case or all keys are strings in upper case, else return False.\n    The function returns False if the given dictionary is empty.\n    \"\"\"\n    if not dictionary:\n        return False\n\n    all_keys = list(dictionary.keys())\n\n    if not all(isinstance(k, str) for k in all_keys):\n        return False\n\n    is_all_lower = True\n    is_all_upper = True\n\n    for key in all_keys:\n        if key != key.lower():\n            is_all_lower = False\n        if key != key.upper():\n            is_all_upper = False\n        if not is_all_lower and not is_all_upper:\n            return False\n\n    return is_all_lower or is_all_upper\n```"}
{"task_id": "HumanEval/96", "solution": "def count_up_to(n: int) -> list[int]:\n    \"\"\"Computes prime numbers less than n using the Sieve of Eratosthenes.\n    Returns an empty list for n less than or equal to 2.\"\"\"\n    if n <= 2:\n        return []\n\n    # Initialize a boolean array 'sieve' where sieve[i] is true if i is potentially prime.\n    # We use bytearray for memory efficiency and direct manipulation.\n    sieve = bytearray(b'\\x01') * n\n    sieve[0:2] = b'\\x00\\x00'  # 0 and 1 are not prime\n\n    # Iterate from 2 up to the square root of n.\n    # Mark multiples of each prime number as not prime.\n    for i in range(2, int(n**0.5) + 1):\n        if sieve[i]:  # If i is prime\n            # Mark all multiples of i (starting from i*i) as not prime.\n            # Using slice assignment for efficiency.\n            step = i\n            start = i * i\n            # Calculate count of elements to mark from 'start' up to 'n' with 'step'\n            count = (n - 1 - start) // step + 1 if start < n else 0\n            if count > 0:\n                sieve[start:n:step] = b'\\x00' * count\n\n    # Collect all numbers that are marked as prime.\n    return [i for i, is_prime in enumerate(sieve) if is_prime]"}
{"task_id": "HumanEval/98", "solution": "def count_upper(s):\n    \"\"\"\n    Given a string s, count the number of uppercase vowels in even indices.\n    Only 'A', 'E', 'I', 'O', 'U' are considered uppercase vowels.\n    \"\"\"\n    count = 0\n    uppercase_vowels = {'A', 'E', 'I', 'O', 'U'}\n    for i, char in enumerate(s):\n        if i % 2 == 0 and char in uppercase_vowels:\n            count += 1\n    return count"}
