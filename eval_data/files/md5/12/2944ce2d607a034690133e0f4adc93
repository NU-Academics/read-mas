{"task_id": "HumanEval/32", "solution": "import math\n\n\ndef poly(xs: list, x: float):\n    \"\"\"\n    Evaluates polynomial with coefficients xs at point x.\n    return xs[0] + xs[1] * x + xs[1] * x^2 + .... xs[n] * x^n\n    \"\"\"\n    return sum([coeff * math.pow(x, i) for i, coeff in enumerate(xs)])\n\n\ndef find_zero(xs: list):\n    \"\"\" xs are coefficients of a polynomial.\n    find_zero find x such that poly(x) = 0.\n    find_zero returns only only zero point, even if there are many.\n    Moreover, find_zero only takes list xs having even number of coefficients\n    and largest non zero coefficient as it guarantees\n    a solution.\n    >>> round(find_zero([1, 2]), 2) # f(x) = 1 + 2x\n    -0.5\n    >>> round(find_zero([-6, 11, -6, 1]), 2) # (x - 1) * (x - 2) * (x - 3) = -6 + 11x - 6x^2 + x^3\n    1.0\n    \"\"\"\n\n    # Helper to evaluate derivative of polynomial, defined inline as required.\n    # This computes the derivative coefficients and evaluates at a given value.\n    def _derivative_eval(coeffs: list, val: float) -> float:\n        return sum([i * c * math.pow(val, i - 1) for i, c in enumerate(coeffs) if i > 0])\n\n    tol = 1e-10\n    max_iter = 1000\n\n    # Attempt Newton-Raphson method from several heuristic initial guesses for efficiency.\n    # This method iterates to find a root where the function's value is close to zero.\n    initial_guesses = [0.0, 1.0, -1.0, 0.5, -0.5, 10.0, -10.0, float(len(xs) - 1)]\n\n    for x0 in initial_guesses:\n        x_current = x0\n        for _iter in range(max_iter):\n            fx = poly(xs, x_current)\n            dfx = _derivative_eval(xs, x_current)\n\n            if abs(fx) < tol:\n                return x_current\n\n            # If derivative is near zero, Newton's method struggles, so try another seed.\n            if abs(dfx) < 1e-12:\n                break\n\n            x_next = x_current - fx / dfx\n            if abs(x_next - x_current) < tol:\n                return x_next\n            x_current = x_next\n    \n    # If Newton-Raphson fails to converge from all seeds, fall back to bisection.\n    # For odd-degree polynomials (implied by 'even number of coefficients'), a root is guaranteed.\n\n    # Step 1: Find a suitable initial bracket [a, b] where poly(a) and poly(b) have opposite signs.\n    # This loop expands the search range until a sign change (or a root) is found.\n    a_bracket, b_bracket = -1.0, 1.0\n    for _ in range(max_iter):\n        fa_b = poly(xs, a_bracket)\n        fb_b = poly(xs, b_bracket)\n\n        if abs(fa_b) < tol: return a_bracket\n        if abs(fb_b) < tol: return b_bracket\n\n        if fa_b * fb_b < 0:\n            break\n        \n        # Expand the interval to find a wider range for bracketing.\n        a_bracket *= 2\n        b_bracket *= 2\n        if a_bracket == 0: a_bracket = -0.1\n        if b_bracket == 0: b_bracket = 0.1\n\n        if abs(a_bracket) > 1e12 or abs(b_bracket) > 1e12:\n            break\n\n    # Step 2: Apply bisection method on the found bracket [a_bracket, b_bracket].\n    # This iteratively narrows the interval, approaching the root.\n    low, high = a_bracket, b_bracket\n    \n    y_low = poly(xs, low)\n    y_high = poly(xs, high)\n\n    if abs(y_low) < tol: return low\n    if abs(y_high) < tol: return high\n    \n    for _bisect_iter in range(max_iter):\n        mid = (low + high) / 2\n        ymid = poly(xs, mid)\n        \n        if abs(ymid) < tol:\n            return mid\n        \n        # Determine which half of the interval contains the root.\n        # This relies on the Intermediate Value Theorem.\n        current_y_low = poly(xs, low)\n        if current_y_low * ymid < 0:\n            high = mid\n        else:\n            low = mid\n        \n        if abs(high - low) < tol:\n            return (low + high) / 2\n\n    # If both Newton-Raphson and bisection reach max_iter without perfect convergence,\n    # return the best estimate from the final bisection interval.\n    return (low + high) / 2"}
{"task_id": "HumanEval/34", "solution": "import json\nimport hashlib\nimport os\nimport pathlib\nimport logging\nfrom typing import Any, Optional, List\n\n# Configure basic logging for cache operations as per design spec.\nlogging.basicConfig(level=logging.INFO, format='%(asctime)s - %(levelname)s - %(message)s')\n_logger = logging.getLogger(__name__)\n\n# --- Models & DTOs (src/uniqlist/models.py) ---\nclass ListInput:\n    \"\"\"DTO for incoming list data.\"\"\"\n    def __init__(self, items: list):\n        self.items = items\n\nclass ListOutput:\n    \"\"\"DTO for outgoing unique list data.\"\"\"\n    def __init__(self, unique: list):\n        self.unique = unique\n\n# --- Exceptions (src/uniqlist/exceptions.py) ---\nclass UniqueError(Exception):\n    \"\"\"Base exception for unique list operations.\"\"\"\n    pass\n\nclass InvalidInputError(UniqueError):\n    \"\"\"Exception raised for invalid input data.\"\"\"\n    pass\n\nclass CacheError(UniqueError):\n    \"\"\"Exception raised for cache related errors.\"\"\"\n    pass\n\n# --- Utilities (src/uniqlist/utils.py) ---\ndef validate_items(items: Any) -> None:\n    \"\"\"Validate that input items is a list-like object.\"\"\"\n    if not isinstance(items, (list, tuple)):\n        raise InvalidInputError(\"Input must be a list or tuple.\")\n\ndef normalize_items(items: list) -> list:\n    \"\"\"Normalize input items to a list.\"\"\"\n    # Convert tuples to list for consistent processing.\n    return list(items)\n\n# --- Adapters (src/uniqlist/adapters/) ---\nclass SetAdapter:\n    \"\"\"Adapter for set-based unique computation.\"\"\"\n    def compute_unique(self, items: list) -> list:\n        \"\"\"Compute unique elements using a set, then sort.\"\"\"\n        try:\n            uniq = set(items)\n        except TypeError as e:\n            raise UniqueError(\"Items not hashable for set strategy.\") from e\n        return sorted(uniq)\n\nclass SortAdapter:\n    \"\"\"Adapter for sort-based unique computation.\"\"\"\n    def compute_unique(self, items: list) -> list:\n        \"\"\"Compute unique elements by sorting and scanning.\"\"\"\n        try:\n            sorted_items = sorted(items)\n        except TypeError as e:\n            raise UniqueError(\"Items not comparable for sort strategy.\") from e\n        result = []\n        # Use an object to ensure the first item is always added.\n        prev = object() \n        for it in sorted_items:\n            if it != prev:\n                result.append(it)\n                prev = it\n        return result\n\n# --- Repositories (src/uniqlist/repositories.py) ---\nclass CacheRepository:\n    \"\"\"Manages in-memory cache with optional file persistence.\"\"\"\n    def __init__(self, persist_path: Optional[str] = None):\n        self._store: dict[str, list] = {}\n        self._persist_path = persist_path\n        if self._persist_path:\n            self._persist_path = os.path.expanduser(self._persist_path)\n            self.load()\n\n    def get(self, key: str) -> Optional[list]:\n        \"\"\"Retrieve a cached value by key.\"\"\"\n        return self._store.get(key)\n\n    def set(self, key: str, value: list) -> None:\n        \"\"\"Store a value in the cache.\"\"\"\n        self._store[key] = value\n        # Persist on every set operation for simplicity, as per design.\n        self.persist()\n\n    def persist(self) -> None:\n        \"\"\"Persist the current cache to disk.\"\"\"\n        if not self._persist_path:\n            return\n        try:\n            path = pathlib.Path(self._persist_path)\n            path.parent.mkdir(parents=True, exist_ok=True)\n            with open(path, 'w', encoding='utf-8') as f:\n                json.dump(self._store, f, ensure_ascii=False)\n            _logger.info(f\"Cache persisted to {self._persist_path}\")\n        except (IOError, OSError, json.JSONDecodeError) as e:\n            _logger.warning(f\"Failed to persist cache to {self._persist_path}: {e}\")\n\n    def load(self) -> None:\n        \"\"\"Load cache from disk.\"\"\"\n        if not self._persist_path or not os.path.exists(self._persist_path):\n            return\n        try:\n            with open(self._persist_path, 'r', encoding='utf-8') as f:\n                self._store = json.load(f)\n            _logger.info(f\"Cache loaded from {self._persist_path}\")\n        except (IOError, OSError, json.JSONDecodeError) as e:\n            _logger.warning(f\"Failed to load cache from {self._persist_path}: {e}\")\n            self._store = {} # Reset cache if loading fails\n\n# --- Services (src/uniqlist/services.py) ---\nclass UniqueService:\n    \"\"\"Core logic for unique element computation, strategy selection, and caching.\"\"\"\n    def __init__(self, cache_repo: CacheRepository, set_adapter: SetAdapter, sort_adapter: SortAdapter):\n        self._cache = cache_repo\n        self._set_adapter = set_adapter\n        self._sort_adapter = sort_adapter\n\n    def unique(self, items: list, strategy: Optional[str] = None) -> list:\n        \"\"\"Returns sorted unique elements from a list, using caching and strategy.\"\"\"\n        key = self._cache_key(items)\n        cached = self._cache.get(key)\n        if cached is not None:\n            _logger.info(f\"Cache hit for key: {key}\")\n            return cached\n        \n        _logger.info(f\"Cache miss for key: {key}. Computing result.\")\n        chosen = self._choose_strategy(items, strategy)\n        \n        # Delegate to the chosen adapter based on strategy.\n        if chosen == \"set\":\n            res = self._set_adapter.compute_unique(items)\n        else: # 'sort' is the default and fallback strategy\n            res = self._sort_adapter.compute_unique(items)\n        \n        self._cache.set(key, res)\n        return res\n\n    def _choose_strategy(self, items: list, strategy: Optional[str]) -> str:\n        \"\"\"Choose computation strategy based on input characteristics and preference.\"\"\"\n        if strategy == \"set\":\n            return \"set\"\n        if strategy == \"sort\":\n            return \"sort\"\n        \n        # Automatic strategy: try set for performance if hashable.\n        if strategy is None or strategy == \"auto\":\n            try:\n                # Attempt to create a set from a sample or the whole list to check hashability.\n                # If it succeeds, the set strategy can be used.\n                set(items[:min(len(items), 100)]) # Check a subset to quickly infer hashability\n                return \"set\"\n            except TypeError:\n                pass # Not all items are hashable, fallback to 'sort'.\n\n        return \"sort\" # Default strategy if 'auto' fails or no strategy specified.\n\n    def _cache_key(self, items: list) -> str:\n        \"\"\"Generate a deterministic cache key for the given list of items.\"\"\"\n        # JSON serialization ensures deterministic order and handling of various types.\n        serialized_items = json.dumps(items, separators=(',', ':'), ensure_ascii=False, default=str).encode('utf-8')\n        return hashlib.sha256(serialized_items).hexdigest()\n\n# --- Controllers (src/uniqlist/controllers.py) ---\nclass UniqueController:\n    \"\"\"Handles input validation, normalization, and delegates to the UniqueService.\"\"\"\n    def __init__(self, service: UniqueService):\n        self._service = service\n\n    def process(self, items: Any, strategy: Optional[str] = None) -> list:\n        \"\"\"Process input to get unique sorted elements.\"\"\"\n        validate_items(items) # Validate input type.\n        normalized_items = normalize_items(items) # Normalize to list.\n        return self._service.unique(normalized_items, strategy)\n\n# --- Global instances for the public API facade (similar to src/uniqlist/__init__.py) ---\n# Default cache path based on assumptions in the design document.\n_default_cache_path = os.path.join(pathlib.Path.home(), \".cache\", \"uniqlist\", \"cache.json\")\n_cache = CacheRepository(persist_path=_default_cache_path)\n_set_adapter = SetAdapter()\n_sort_adapter = SortAdapter()\n_service = UniqueService(_cache, _set_adapter, _sort_adapter)\n_controller = UniqueController(_service)\n\n# --- The public `unique` function as specified in the original problem statement ---\ndef unique(l: list) -> list:\n    \"\"\"Return sorted unique elements in a list.\n    Delegates to the configured UniqueController for processing, with auto strategy selection.\n    \"\"\"\n    # The original problem statement signature unique(l: list) does not include 'strategy'.\n    # We call the controller with strategy=None, allowing the service to auto-select.\n    return _controller.process(l, strategy=None)"}
