{"task_id": "HumanEval/60", "solution": "```python\nfrom typing import Any, Dict, Optional\n\n# --- Exceptions (from src/summation_app/utils.py) ---\nclass InvalidInputError(ValueError):\n    \"\"\"Exception raised for invalid input values.\"\"\"\n    pass\n\nclass CacheError(Exception):\n    \"\"\"Exception raised for issues with the cache repository.\"\"\"\n    pass\n\n# --- Config (from src/summation_app/config.py) ---\nclass Config:\n    \"\"\"Provides run-time configuration for the application.\"\"\"\n    DEFAULT_MAX_N = 10_000_000\n\n    def __init__(self, max_n: int = DEFAULT_MAX_N, cache_enabled: bool = True,\n                 sqlite_path: Optional[str] = None, api_key: Optional[str] = None):\n        self.max_n = max_n\n        self.cache_enabled = cache_enabled\n        self.sqlite_path = sqlite_path\n        self.api_key = api_key\n\n# --- Models (from src/summation_app/models.py) ---\nclass SummationRequest:\n    \"\"\"DTO for summation requests.\"\"\"\n    def __init__(self, n: int):\n        self.n = n\n\nclass SummationResult:\n    \"\"\"DTO for summation results.\"\"\"\n    def __init__(self, n: int, sum_val: int):\n        self.n = n\n        self.sum = sum_val\n\n    def to_dict(self) -> Dict[str, int]:\n        \"\"\"Returns the result as a dictionary.\"\"\"\n        return {\"n\": self.n, \"sum\": self.sum}\n\n# --- Validators (from src/summation_app/validators.py) ---\nclass InputValidator:\n    \"\"\"Handles validation of input values.\"\"\"\n    def validate_positive_int(self, value: Any, max_n: int) -> int:\n        \"\"\"Ensures value is a positive integer within bounds.\"\"\"\n        try:\n            if isinstance(value, float) and value.is_integer():\n                value = int(value)\n            n = int(value)\n        except (ValueError, TypeError):\n            raise InvalidInputError(f\"Invalid integer value: {value!r}\")\n        if n < 1 or n > max_n:\n            raise InvalidInputError(f\"n must be between 1 and {max_n}, got {n}\")\n        return n\n\n# --- Services (from src/summation_app/services.py) ---\nclass SummationService:\n    \"\"\"Core arithmetic logic for summation.\"\"\"\n    def sum_formula(self, n: int) -> int:\n        \"\"\"Computes sum using Gauss's formula (O(1)).\"\"\"\n        return n * (n + 1) // 2\n\n    def sum_iterative(self, n: int) -> int:\n        \"\"\"Computes sum using an iterative loop (O(n)).\"\"\"\n        total = 0\n        for i in range(1, n + 1):\n            total += i\n        return total\n\n    def compute(self, n: int, use_formula: bool = True) -> int:\n        \"\"\"Public method to compute the sum.\"\"\"\n        return self.sum_formula(n) if use_formula else self.sum_iterative(n)\n\n# --- Repository (from src/summation_app/repository.py) ---\nclass CacheRepository:\n    \"\"\"Abstract base class for cache repositories.\"\"\"\n    def get(self, n: int) -> Optional[int]:\n        \"\"\"Retrieves a cached sum for n.\"\"\"\n        raise NotImplementedError\n\n    def set(self, n: int, value: int) -> None:\n        \"\"\"Stores a sum in the cache for n.\"\"\"\n        raise NotImplementedError\n\n\nclass InMemoryCacheRepository(CacheRepository):\n    \"\"\"In-memory implementation of CacheRepository.\"\"\"\n    def __init__(self) -> None:\n        self._store: Dict[int, int] = {}\n\n    def get(self, n: int) -> Optional[int]:\n        \"\"\"Retrieves a cached sum for n.\"\"\"\n        return self._store.get(n)\n\n    def set(self, n: int, value: int) -> None:\n        \"\"\"Stores a sum in the cache for n.\"\"\"\n        self._store[n] = value\n\n# --- Controllers (from src/summation_app/controllers.py) ---\nclass SummationController:\n    \"\"\"Orchestrates validation, caching, and computation.\"\"\"\n    def __init__(self, service: SummationService, validator: InputValidator,\n                 repo: CacheRepository, config: Config):\n        self.service = service\n        self.validator = validator\n        self.repo = repo\n        self.config = config\n\n    def compute_sum(self, n_raw: Any) -> SummationResult:\n        \"\"\"Validates input, attempts cache lookup, computes if needed.\"\"\"\n        n = self.validator.validate_positive_int(n_raw, self.config.max_n)\n\n        if self.config.cache_enabled:\n            try:\n                cached = self.repo.get(n)\n                if cached is not None:\n                    return SummationResult(n, cached)\n            except CacheError:\n                # A cache error occurred, proceed with computation.\n                pass\n            except Exception: # Catch any other unexpected errors from cache\n                pass\n\n        total = self.service.compute(n)\n\n        if self.config.cache_enabled:\n            try:\n                self.repo.set(n, total)\n            except CacheError:\n                # A cache error occurred on set, ignore and return result.\n                pass\n            except Exception: # Catch any other unexpected errors on cache set\n                pass\n\n        return SummationResult(n, total)\n\n# --- Public API (from src/summation_app/__init__.py) ---\ndef sum_to_n(n: int) -> int:\n    \"\"\"sum_to_n is a function that sums numbers from 1 to n.\n    It delegates to a SummationController with default in-memory caching.\n    \"\"\"\n    config = Config()\n    validator = InputValidator()\n    service = SummationService()\n    repo = InMemoryCacheRepository()\n    controller = SummationController(service=service, validator=validator, repo=repo, config=config)\n    result = controller.compute_sum(n)\n    return result.sum\n```"}
{"task_id": "HumanEval/61", "solution": "```python\nimport argparse\nimport json\nimport logging\nimport os\nimport sqlite3\nimport sys\nfrom datetime import datetime\nfrom pathlib import Path\nfrom typing import List, Optional, Protocol, Dict\n\n# --- File: pyproject.toml ---\n# [tool.poetry]\n# name = \"bracket-validator\"\n# version = \"0.1.0\"\n# description = \"A utility to validate bracket sequences.\"\n# authors = [\"Your Name <you@example.com>\"]\n# readme = \"README.md\"\n#\n# [tool.poetry.dependencies]\n# python = \"^3.9\"\n# fastapi = \"^0.111.0\"\n# uvicorn = {extras = [\"standard\"], version = \"^0.30.1\"}\n#\n# [tool.poetry.group.dev.dependencies]\n# pytest = \"^8.2.2\"\n# httpx = \"^0.27.0\"\n#\n# [tool.poetry.scripts]\n# bracket-validator = \"bracket_validator.cli:run\"\n#\n# [build-system]\n# requires = [\"poetry-core\"]\n# build-backend = \"poetry.core.masonry.api\"\n#\n# --- File: README.md ---\n# # Bracket Validator\n#\n# This project provides a utility to validate if a string of parentheses is correctly balanced.\n# It exposes the functionality as a library, a command-line interface (CLI), and a simple HTTP API.\n# Validation history can be persisted to a SQLite database.\n#\n# ## Installation\n#\n# Using [Poetry](https://python-poetry.org/):\n#\n# ```bash\n# poetry install\n# poetry shell\n# ```\n#\n# ## CLI Usage\n#\n# ```bash\n# bracket-validator validate \"(()())\"\n# bracket-validator validate \"())\" --persist\n# bracket-validator --help\n# ```\n#\n# ## HTTP API Usage\n#\n# To start the server:\n# ```bash\n# uvicorn bracket_validator.controllers.api:app --reload\n# ```\n#\n# ### POST /validate\n#\n# Request:\n# ```json\n# POST /validate HTTP/1.1\n# Content-Type: application/json\n#\n# {\n#   \"sequence\": \"(()())\",\n#   \"persist\": true\n# }\n# ```\n#\n# Response:\n# ```json\n# HTTP/1.1 200 OK\n# Content-Type: application/json\n#\n# {\n#   \"valid\": true,\n#   \"error\": null,\n#   \"sequence\": \"(()())\",\n#   \"source\": \"API\",\n#   \"timestamp\": \"2023-10-27T10:00:00.123456\"\n# }\n# ```\n#\n# ### GET /history\n#\n# Request:\n# ```\n# GET /history?page=1&page_size=10 HTTP/1.1\n# ```\n#\n# Response:\n# ```json\n# HTTP/1.1 200 OK\n# Content-Type: application/json\n#\n# {\n#   \"items\": [\n#     {\n#       \"id\": 1,\n#       \"sequence\": \"(()())\",\n#       \"valid\": true,\n#       \"source\": \"API\",\n#       \"persisted_at\": \"2023-10-27T10:00:00.123456\"\n#     }\n#   ],\n#   \"page\": 1,\n#   \"page_size\": 10,\n#   \"count\": 1\n# }\n# ```\n#\n# ## Library Usage\n#\n# ```python\n# from bracket_validator.services import BracketValidatorService\n#\n# svc = BracketValidatorService()\n# result = svc.validate(\"()\", source=\"MY_APP\", persist=True)\n# print(result.to_dict())\n# # {'valid': True, 'error': None, 'sequence': '()', 'source': 'MY_APP', 'timestamp': '...'}\n# ```\n\n# --- File: src/bracket_validator/__init__.py ---\n# This file marks the directory as a Python package.\n\n# --- File: src/bracket_validator/config.py ---\nimport os\n\nLOG = logging.getLogger(__name__)\n\nclass Config:\n    \"\"\"Centralized configuration values and defaults.\"\"\"\n    DB_DIR: str = \"data\"\n    DB_PATH: str = os.path.join(DB_DIR, \"validations.db\")\n    DEFAULT_PAGE_SIZE: int = 50\n    API_KEY: Optional[str] = os.getenv(\"BRACKET_VALIDATOR_API_KEY\")\n\n    @staticmethod\n    def get_db_path() -> str:\n        \"\"\"Returns the configured database path, ensuring its directory exists.\"\"\"\n        db_dir = Path(Config.DB_DIR)\n        db_dir.mkdir(parents=True, exist_ok=True)\n        return Config.DB_PATH\n\n# --- File: src/bracket_validator/exceptions.py ---\nclass ValidationError(Exception):\n    \"\"\"Exception for invalid input or validation preconditions.\"\"\"\n    def __init__(self, message: str) -> None:\n        self.message = message\n        super().__init__(self.message)\n\n    def __str__(self) -> str:\n        return f\"ValidationError: {self.message}\"\n\nclass PersistenceError(Exception):\n    \"\"\"Exception to wrap persistence errors.\"\"\"\n    def __init__(self, message: str) -> None:\n        self.message = message\n        super().__init__(self.message)\n\n    def __str__(self) -> str:\n        return f\"PersistenceError: {self.message}\"\n\n# --- File: src/bracket_validator/utils.py ---\ndef is_parentheses_only(s: str) -> bool:\n    \"\"\"Checks if a string contains only '(' and ')' characters.\"\"\"\n    return all(ch in (\"(\", \")\") for ch in s)\n\ndef now_iso() -> str:\n    \"\"\"Returns the current UTC time in ISO format.\"\"\"\n    return datetime.utcnow().isoformat()\n\n# --- File: src/bracket_validator/models.py ---\nclass BracketSequence:\n    \"\"\"Domain model encapsulating a bracket sequence and its preconditions.\"\"\"\n    def __init__(self, sequence: str) -> None:\n        self.sequence = sequence\n\n    def validate_preconditions(self) -> None:\n        \"\"\"Ensures the sequence is a string and contains only parentheses.\"\"\"\n        if not isinstance(self.sequence, str):\n            raise ValidationError(\"Sequence must be a string\")\n        if not is_parentheses_only(self.sequence):\n            raise ValidationError(\"Sequence contains invalid characters\")\n        # NFR1: Max length check could be added here if needed, e.g., if len(self.sequence) > 1_000_000: ...\n\nclass ValidationRecord:\n    \"\"\"Persistence model representing a stored validation attempt.\"\"\"\n    def __init__(self, id: Optional[int], sequence: str, valid: bool, source: str, persisted_at: str) -> None:\n        self.id = id\n        self.sequence = sequence\n        self.valid = valid\n        self.source = source\n        self.persisted_at = persisted_at\n\n    def to_tuple(self) -> tuple:\n        \"\"\"Converts the record attributes into a tuple for database insertion.\"\"\"\n        return (self.sequence, int(self.valid), self.source, self.persisted_at)\n\n# --- File: src/bracket_validator/dtos.py ---\nclass ValidationResultDTO:\n    \"\"\"Data Transfer Object for validation results across layers.\"\"\"\n    def __init__(self, valid: bool, error: Optional[str], sequence: str, source: str, timestamp: str) -> None:\n        self.valid = valid\n        self.error = error\n        self.sequence = sequence\n        self.source = source\n        self.timestamp = timestamp\n\n    def to_dict(self) -> Dict:\n        \"\"\"Converts the DTO into a dictionary for serialization.\"\"\"\n        return {\n            \"valid\": self.valid,\n            \"error\": self.error,\n            \"sequence\": self.sequence,\n            \"source\": self.source,\n            \"timestamp\": self.timestamp,\n        }\n\n# --- File: src/bracket_validator/repositories.py ---\nclass ValidationRepository(Protocol):\n    \"\"\"Interface for storing and retrieving ValidationRecord objects.\"\"\"\n    def persist(self, record: ValidationRecord) -> int:\n        \"\"\"Persists a ValidationRecord and returns its generated ID.\"\"\"\n        ...\n\n    def list_recent(self, limit: int, offset: int) -> List[ValidationRecord]:\n        \"\"\"Retrieves a paginated list of recent ValidationRecord objects.\"\"\"\n        ...\n\n    def count_total(self) -> int:\n        \"\"\"Counts the total number of validation records.\"\"\"\n        ...\n\n# --- File: migrations/0001_create_validations_table.sql ---\nCREATE TABLE IF NOT EXISTS validations (\n  id INTEGER PRIMARY KEY AUTOINCREMENT,\n  sequence TEXT NOT NULL,\n  valid INTEGER NOT NULL, -- 0/1\n  source TEXT NOT NULL,\n  persisted_at TEXT NOT NULL\n);\n\nCREATE INDEX IF NOT EXISTS idx_validations_persisted_at ON validations(persisted_at DESC);\n\n# --- File: src/bracket_validator/adapters/sqlite_adapter.py ---\nclass SQLiteAdapter:\n    \"\"\"Concrete adapter for ValidationRepository using SQLite.\"\"\"\n    def __init__(self, db_path: str) -> None:\n        self.db_path = db_path\n        self._create_table()\n\n    def _connect(self) -> sqlite3.Connection:\n        \"\"\"Helper to establish a connection to the SQLite database.\"\"\"\n        conn = sqlite3.connect(self.db_path)\n        conn.row_factory = sqlite3.Row  # Access columns by name\n        return conn\n\n    def _create_table(self) -> None:\n        \"\"\"Ensures the validations table exists by executing migration SQL.\"\"\"\n        try:\n            conn = self._connect()\n            cursor = conn.cursor()\n            migrations_dir = Path(__file__).parent.parent.parent / \"migrations\"\n            migration_file = migrations_dir / \"0001_create_validations_table.sql\"\n            with open(migration_file, \"r\") as f:\n                sql_script = f.read()\n            cursor.executescript(sql_script)\n            conn.commit()\n        except sqlite3.Error as e:\n            LOG.error(f\"Error creating SQLite table: {e}\")\n            raise PersistenceError(f\"Failed to initialize database: {e}\")\n        finally:\n            if conn:\n                conn.close()\n\n    def persist(self, record: ValidationRecord) -> int:\n        \"\"\"Persists a ValidationRecord to the SQLite database.\"\"\"\n        conn = None\n        try:\n            conn = self._connect()\n            cursor = conn.cursor()\n            cursor.execute(\"INSERT INTO validations (sequence, valid, source, persisted_at) VALUES (?, ?, ?, ?)\",\n                           record.to_tuple())\n            conn.commit()\n            return cursor.lastrowid\n        except sqlite3.Error as e:\n            LOG.error(f\"Error persisting record {record.sequence}: {e}\")\n            raise PersistenceError(f\"Failed to persist record: {e}\")\n        finally:\n            if conn:\n                conn.close()\n\n    def list_recent(self, limit: int, offset: int) -> List[ValidationRecord]:\n        \"\"\"Retrieves recent ValidationRecord objects from the SQLite database.\"\"\"\n        conn = None\n        try:\n            conn = self._connect()\n            cursor = conn.cursor()\n            cursor.execute(\"SELECT id, sequence, valid, source, persisted_at FROM validations ORDER BY persisted_at DESC LIMIT ? OFFSET ?\",\n                           (limit, offset))\n            records = []\n            for row in cursor.fetchall():\n                records.append(ValidationRecord(\n                    id=row['id'],\n                    sequence=row['sequence'],\n                    valid=bool(row['valid']),\n                    source=row['source'],\n                    persisted_at=row['persisted_at']\n                ))\n            return records\n        except sqlite3.Error as e:\n            LOG.error(f\"Error listing recent records: {e}\")\n            raise PersistenceError(f\"Failed to retrieve history: {e}\")\n        finally:\n            if conn:\n                conn.close()\n\n    def count_total(self) -> int:\n        \"\"\"Counts the total number of validation records in the SQLite database.\"\"\"\n        conn = None\n        try:\n            conn = self._connect()\n            cursor = conn.cursor()\n            cursor.execute(\"SELECT COUNT(*) FROM validations\")\n            return cursor.fetchone()[0]\n        except sqlite3.Error as e:\n            LOG.error(f\"Error counting total records: {e}\")\n            raise PersistenceError(f\"Failed to count total records: {e}\")\n        finally:\n            if conn:\n                conn.close()\n\n# --- File: src/bracket_validator/services.py ---\nclass BracketValidatorService:\n    \"\"\"Core business logic for validating bracket sequences and coordinating persistence.\"\"\"\n    def __init__(self, repo: Optional[ValidationRepository] = None) -> None:\n        self.repo = repo if repo is not None else SQLiteAdapter(Config.get_db_path())\n\n    def _is_balanced(self, sequence: str) -> bool:\n        \"\"\"Determines if a string of parentheses is correctly balanced using a counter.\"\"\"\n        counter = 0\n        for ch in sequence:\n            if ch == \"(\":\n                counter += 1\n            else:  # ch == \")\"\n                counter -= 1\n            if counter < 0:\n                return False\n        return counter == 0\n\n    def validate(self, sequence: str, source: str = \"LIB\", persist: bool = False) -> ValidationResultDTO:\n        \"\"\"Validates a bracket sequence and optionally persists the result.\"\"\"\n        error_message: Optional[str] = None\n        is_valid: bool = False\n        current_timestamp = now_iso()\n\n        try:\n            bracket_seq = BracketSequence(sequence)\n            bracket_seq.validate_preconditions()\n            is_valid = self._is_balanced(sequence)\n        except ValidationError as e:\n            error_message = str(e)\n            is_valid = False # Explicitly set to False if validation preconditions fail\n\n        dto = ValidationResultDTO(\n            valid=is_valid,\n            error=error_message,\n            sequence=sequence,\n            source=source,\n            timestamp=current_timestamp\n        )\n\n        if persist and self.repo:\n            if not dto.error: # Only attempt to persist if no validation error\n                record = ValidationRecord(\n                    id=None,\n                    sequence=sequence,\n                    valid=is_valid,\n                    source=source,\n                    persisted_at=current_timestamp\n                )\n                try:\n                    self.repo.persist(record)\n                except PersistenceError as e:\n                    LOG.warning(f\"Failed to persist validation record for '{sequence}': {e}\")\n                    # Non-fatal: augment DTO with persistence warning if no prior error\n                    if not dto.error:\n                        dto.error = f\"Validation successful, but failed to persist history: {e.message}\"\n                    else:\n                        dto.error += f\" (Persistence failed: {e.message})\"\n        return dto\n\n# --- File: src/bracket_validator/controllers/cli.py ---\nimport logging\n\nlogging.basicConfig(level=os.getenv(\"LOG_LEVEL\", \"INFO\"), stream=sys.stdout,\n                    format='%(asctime)s - %(name)s - %(levelname)s - %(message)s')\nLOG = logging.getLogger(__name__)\n\ndef _print_result(dto: ValidationResultDTO) -> None:\n    \"\"\"Prints the ValidationResultDTO as a JSON string to stdout.\"\"\"\n    print(json.dumps(dto.to_dict(), indent=2))\n\ndef main(argv: Optional[List[str]] = None) -> int:\n    \"\"\"CLI entrypoint for the bracket validator utility.\"\"\"\n    parser = argparse.ArgumentParser(\n        description=\"Bracket Validator CLI: Validate parenthesis sequences.\"\n    )\n    subparsers = parser.add_subparsers(dest=\"command\", help=\"Available commands\")\n\n    # Validate subcommand\n    validate_parser = subparsers.add_parser(\"validate\", help=\"Validate a bracket sequence.\")\n    validate_parser.add_argument(\"sequence\", type=str, help=\"The bracket sequence to validate.\")\n    validate_parser.add_argument(\"--persist\", action=\"store_true\", help=\"Persist the validation result to history.\")\n\n    # History subcommand\n    history_parser = subparsers.add_parser(\"history\", help=\"List recent validation history.\")\n    history_parser.add_argument(\"--page\", type=int, default=1, help=\"Page number (default: 1).\")\n    history_parser.add_argument(\"--page-size\", type=int, default=Config.DEFAULT_PAGE_SIZE, help=\"Items per page (default: 50).\")\n\n\n    args = parser.parse_args(argv)\n\n    service = BracketValidatorService()\n\n    if args.command == \"validate\":\n        try:\n            result_dto = service.validate(args.sequence, source=\"CLI\", persist=args.persist)\n            _print_result(result_dto)\n            if result_dto.error and \"Persistence failed\" in result_dto.error:\n                # Indicate a warning but successful validation via exit code 0\n                return 0 if result_dto.valid else 2\n            return 0 if result_dto.valid else 2 # FR1: exit code 2 for validation error\n        except ValidationError as e:\n            LOG.error(f\"Input error: {e}\")\n            print(json.dumps({\"valid\": False, \"error\": str(e), \"sequence\": args.sequence, \"source\": \"CLI\", \"timestamp\": now_iso()}, indent=2), file=sys.stderr)\n            return 2 # CLI exit code 2 for validation error\n        except Exception as e:\n            LOG.exception(\"An unexpected error occurred during validation.\")\n            print(json.dumps({\"valid\": False, \"error\": f\"Internal CLI error: {e}\", \"sequence\": args.sequence, \"source\": \"CLI\", \"timestamp\": now_iso()}, indent=2), file=sys.stderr)\n            return 1 # General error\n    elif args.command == \"history\":\n        repo = SQLiteAdapter(Config.get_db_path()) # Re-instantiate repo for history command\n        try:\n            offset = (args.page - 1) * args.page_size\n            records = repo.list_recent(limit=args.page_size, offset=offset)\n            total_count = repo.count_total() # For pagination metadata\n            items = []\n            for rec in records:\n                items.append({\n                    \"id\": rec.id,\n                    \"sequence\": rec.sequence,\n                    \"valid\": rec.valid,\n                    \"source\": rec.source,\n                    \"persisted_at\": rec.persisted_at\n                })\n            print(json.dumps({\"items\": items, \"page\": args.page, \"page_size\": args.page_size, \"count\": total_count}, indent=2))\n            return 0\n        except PersistenceError as e:\n            LOG.error(f\"Database error: {e}\")\n            print(json.dumps({\"error\": f\"Failed to retrieve history: {e.message}\"}, indent=2), file=sys.stderr)\n            return 1\n        except Exception as e:\n            LOG.exception(\"An unexpected error occurred during history retrieval.\")\n            print(json.dumps({\"error\": f\"Internal CLI error: {e}\"}, indent=2), file=sys.stderr)\n            return 1\n    else:\n        parser.print_help()\n        return 1\n\n# --- File: src/bracket_validator/controllers/api.py ---\nfrom fastapi import FastAPI, HTTPException, Depends, Header, status\nfrom pydantic import BaseModel, Field\nimport uvicorn\n\nLOG = logging.getLogger(__name__)\n\napp = FastAPI(\n    title=\"Bracket Validator API\",\n    description=\"API for validating bracket sequences and retrieving history.\",\n    version=\"0.1.0\"\n)\n\n# Initialize service globally for reuse\nbracket_validator_service = BracketValidatorService()\n\nclass ValidateRequest(BaseModel):\n    \"\"\"Request schema for the /validate endpoint.\"\"\"\n    sequence: str = Field(..., example=\"(()())\")\n    persist: bool = Field(False, example=True, description=\"Whether to persist the validation result to history.\")\n\nclass HistoryResponseItem(BaseModel):\n    \"\"\"Schema for a single item in the history response.\"\"\"\n    id: int = Field(..., example=1)\n    sequence: str = Field(..., example=\"(()())\")\n    valid: bool = Field(..., example=True)\n    source: str = Field(..., example=\"API\")\n    persisted_at: str = Field(..., example=\"2023-10-27T10:00:00.123456\")\n\nclass HistoryResponse(BaseModel):\n    \"\"\"Response schema for the /history endpoint.\"\"\"\n    items: List[HistoryResponseItem]\n    page: int = Field(..., example=1)\n    page_size: int = Field(..., example=50)\n    count: int = Field(..., example=100)\n\nasync def verify_api_key(x_api_key: Optional[str] = Header(None)) -> None:\n    \"\"\"Dependency to verify the API key if configured.\"\"\"\n    if Config.API_KEY:\n        if x_api_key is None or x_api_key != Config.API_KEY:\n            LOG.warning(\"Unauthorized access attempt: Missing or invalid API key.\")\n            raise HTTPException(\n                status_code=status.HTTP_401_UNAUTHORIZED,\n                detail=\"Unauthorized: Invalid or missing X-API-KEY\"\n            )\n\n@app.post(\"/validate\", summary=\"Validate a bracket sequence\", response_model=ValidationResultDTO)\nasync def post_validate(\n    request: ValidateRequest,\n    api_key_status: None = Depends(verify_api_key)\n) -> Dict:\n    \"\"\"\n    Validates a given string of parentheses and returns whether it is balanced.\n    Optionally, the result can be persisted to the validation history.\n    \"\"\"\n    try:\n        dto = bracket_validator_service.validate(request.sequence, source=\"API\", persist=request.persist)\n        # HTTP 200 is always returned for validation attempts.\n        # Errors in DTO indicate input validation failure or non-fatal persistence issues.\n        return dto.to_dict()\n    except ValidationError as e:\n        LOG.warning(f\"Bad Request: {e}\")\n        raise HTTPException(status_code=status.HTTP_400_BAD_REQUEST, detail=str(e))\n    except Exception as e:\n        LOG.exception(\"An unexpected error occurred during API validation.\")\n        raise HTTPException(status_code=status.HTTP_500_INTERNAL_SERVER_ERROR, detail=\"Internal server error\")\n\n@app.get(\"/history\", summary=\"Retrieve recent validation history\", response_model=HistoryResponse)\nasync def get_history(\n    page: int = 1,\n    page_size: int = Config.DEFAULT_PAGE_SIZE,\n    api_key_status: None = Depends(verify_api_key)\n) -> Dict:\n    \"\"\"\n    Retrieves a paginated list of recent validation records.\n    \"\"\"\n    if page < 1:\n        raise HTTPException(status_code=status.HTTP_400_BAD_REQUEST, detail=\"Page number must be 1 or greater.\")\n    if page_size < 1:\n        raise HTTPException(status_code=status.HTTP_400_BAD_REQUEST, detail=\"Page size must be 1 or greater.\")\n\n    try:\n        # The service's repo is an adapter, we can use it directly for history as well\n        offset = (page - 1) * page_size\n        records = bracket_validator_service.repo.list_recent(limit=page_size, offset=offset)\n        total_count = bracket_validator_service.repo.count_total()\n\n        items = []\n        for rec in records:\n            items.append(HistoryResponseItem(\n                id=rec.id,\n                sequence=rec.sequence,\n                valid=rec.valid,\n                source=rec.source,\n                persisted_at=rec.persisted_at\n            ))\n\n        return HistoryResponse(items=items, page=page, page_size=page_size, count=total_count).model_dump()\n    except PersistenceError as e:\n        LOG.error(f\"Database error during history retrieval: {e}\")\n        raise HTTPException(status_code=status.HTTP_500_INTERNAL_SERVER_ERROR, detail=f\"Database error: {e.message}\")\n    except Exception as e:\n        LOG.exception(\"An unexpected error occurred during API history retrieval.\")\n        raise HTTPException(status_code=status.HTTP_500_INTERNAL_SERVER_ERROR, detail=\"Internal server error\")\n\n# --- File: src/bracket_validator/cli.py ---\ndef run() -> int:\n    \"\"\"Console script entry point for 'bracket-validator'.\"\"\"\n    return main()\n\nif __name__ == \"__main__\":\n    sys.exit(run())\n```"}
