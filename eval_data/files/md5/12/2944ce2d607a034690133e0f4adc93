{"task_id": "HumanEval/81", "solution": "def numerical_letter_grade(grades):\n    \"\"\"Converts a list of numerical GPAs into corresponding letter grades based on a predefined mapping table.\n    Handles special cases for 4.0 (A+) and 0.0 (E), and uses strict greater-than logic for other thresholds.\n    \"\"\"\n\n    def _map_single_gpa_to_letter(gpa: float) -> str:\n        \"\"\"Maps a single GPA to its letter grade according to the teacher's algorithm.\"\"\"\n        if gpa == 4.0:\n            return 'A+'\n        elif gpa == 0.0:\n            return 'E'\n        elif gpa > 3.7:\n            return 'A'\n        elif gpa > 3.3:\n            return 'A-'\n        elif gpa > 3.0:\n            return 'B+'\n        elif gpa > 2.7:\n            return 'B'\n        elif gpa > 2.3:\n            return 'B-'\n        elif gpa > 2.0:\n            return 'C+'\n        elif gpa > 1.7:\n            return 'C'\n        elif gpa > 1.3:\n            return 'C-'\n        elif gpa > 1.0:\n            return 'D+'\n        elif gpa > 0.7:\n            return 'D'\n        elif gpa > 0.0:\n            return 'D-'\n        else:\n            return 'E' # Default for any non-positive GPA not exactly 0.0\n\n    letter_grades = []\n    for gpa in grades:\n        letter_grades.append(_map_single_gpa_to_letter(gpa))\n    return letter_grades"}
{"task_id": "HumanEval/82", "solution": "def _is_prime_basic(n: int) -> bool:\n    \"\"\"Checks if a number is prime using trial division up to its square root.\n    Handles special cases for numbers less than 2, and even numbers.\n    \"\"\"\n    if n < 2:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n    # Check for odd divisors from 3 up to sqrt(n)\n    i = 3\n    while i * i <= n:\n        if n % i == 0:\n            return False\n        i += 2\n    return True\n\ndef prime_length(string):\n    \"\"\"Checks if the length of a string is a prime number.\n    Returns True if the length is prime, False otherwise.\n    \"\"\"\n    length = len(string)\n    return _is_prime_basic(length)"}
