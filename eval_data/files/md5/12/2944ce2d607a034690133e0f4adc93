{"task_id": "HumanEval/152", "solution": "def compare(game,guess):\n    \"\"\"I think we all remember that feeling when the result of some long-awaited\n    event is finally known. The feelings and thoughts you have at that moment are\n    definitely worth noting down and comparing.\n    Your task is to determine if a person correctly guessed the results of a number of matches.\n    You are given two arrays of scores and guesses of equal length, where each index shows a match. \n    Return an array of the same length denoting how far off each guess was. If they have guessed correctly,\n    the value is 0, and if not, the value is the absolute difference between the guess and the score.\n    \n    \n    example:\n\n    compare([1,2,3,4,5,1],[1,2,3,4,2,-2]) -> [0,0,0,0,3,3]\n    compare([0,5,0,0,0,4],[4,1,1,0,0,-2]) -> [4,4,1,0,0,6]\n    \"\"\"\n    \n    return [0 if actual == predicted else abs(actual - predicted) for actual, predicted in zip(game, guess)]"}
{"task_id": "HumanEval/153", "solution": "def Strongest_Extension(class_name, extensions):\n    \"\"\"Computes the 'strongest extension' for a given class name and list of extensions. Strength is (uppercase count - lowercase count); ties are broken by first occurrence.\"\"\"\n    \n    strongest_ext_name = None\n    max_strength = -float('inf')\n\n    for ext_name in extensions:\n        cap_count = 0\n        sm_count = 0\n        for char in ext_name:\n            if 'A' <= char <= 'Z':\n                cap_count += 1\n            elif 'a' <= char <= 'z':\n                sm_count += 1\n        \n        current_strength = cap_count - sm_count\n\n        if strongest_ext_name is None or current_strength > max_strength:\n            max_strength = current_strength\n            strongest_ext_name = ext_name\n            \n    return f\"{class_name}.{strongest_ext_name}\""}
{"task_id": "HumanEval/153", "solution": "```python\ndef Strongest_Extension(class_name, extensions):\n    \"\"\"Calculates the strength of extensions (CAP-SM) and returns the class name\n    with the strongest extension, breaking ties by first occurrence.\n    \"\"\"\n    strongest_extension_name = None\n    max_strength = -float('inf')\n\n    for ext in extensions:\n        cap = 0\n        sm = 0\n        for char in ext:\n            if 'A' <= char <= 'Z':\n                cap += 1\n            elif 'a' <= char <= 'z':\n                sm += 1\n        \n        current_strength = cap - sm\n        \n        if current_strength > max_strength:\n            max_strength = current_strength\n            strongest_extension_name = ext\n            \n    return f\"{class_name}.{strongest_extension_name}\"\n```"}
{"task_id": "HumanEval/154", "solution": "def cycpattern_check(a, b):\n    \"\"\"Checks if any rotation of 'b' is a substring of 'a'.\n    'a' is the haystack, 'b' is the needle.\n    \"\"\"\n\n    haystack = a\n    needle = b\n\n    def _generate_rotations_set(s: str) -> set[str]:\n        \"\"\"Generates all unique cyclic rotations of a string.\"\"\"\n        L = len(s)\n        if L == 0:\n            return {\"\"}\n        rotations = set()\n        for i in range(L):\n            rotations.add(s[i:] + s[:i])\n        return rotations\n\n    if needle == \"\":\n        return True\n    if len(needle) > len(haystack):\n        return False\n\n    if len(needle) == len(haystack):\n        return needle in (haystack + haystack)\n\n    for rot in _generate_rotations_set(needle):\n        if rot in haystack:\n            return True\n\n    return False"}
{"task_id": "HumanEval/154", "solution": "def cycpattern_check(a , b):\n    \"\"\"Checks if the second word or any of its cyclic rotations is a substring in the first word.\"\"\"\n    \n    n = len(b)\n    # Generate and check each cyclic rotation of 'b' in 'a'.\n    for i in range(n):\n        rotation = b[i:] + b[:i]\n        if rotation in a:\n            return True\n    \n    return False"}
{"task_id": "HumanEval/155", "solution": "def even_odd_count(num):\n    \"\"\"Given an integer, return a tuple with the count of even and odd digits.\n    Ignores the sign of the input number.\n    \"\"\"\n    s_num = str(abs(num))\n    even_count = 0\n    odd_count = 0\n\n    for digit_char in s_num:\n        digit = int(digit_char)\n        if digit % 2 == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n            \n    return (even_count, odd_count)"}
{"task_id": "HumanEval/155", "solution": "```python\ndef even_odd_count(num):\n    \"\"\"Given an integer, return a tuple that has the number of even and odd digits respectively.\n\n    Handles string or integer input by converting to string and ignoring any leading sign.\n    \"\"\"\n    s_num = str(num)\n    if s_num.startswith('-') or s_num.startswith('+'):\n        s_num = s_num[1:]\n\n    even_count = 0\n    odd_count = 0\n\n    for digit_char in s_num:\n        digit_val = int(digit_char)\n        if digit_val % 2 == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n\n    return (even_count, odd_count)\n```"}
{"task_id": "HumanEval/156", "solution": "def int_to_mini_roman(number):\n    \"\"\"\n    Given a positive integer, obtain its roman numeral equivalent as a string,\n    and return it in lowercase. Restrictions: 1 <= num <= 1000.\n    \"\"\"\n    roman_map = [\n        (1000, \"M\"), (900, \"CM\"), (500, \"D\"), (400, \"CD\"),\n        (100, \"C\"), (90, \"XC\"), (50, \"L\"), (40, \"XL\"),\n        (10, \"X\"), (9, \"IX\"), (5, \"V\"), (4, \"IV\"), (1, \"I\"),\n    ]\n    \n    result = []\n    for value, numeral in roman_map:\n        while number >= value:\n            result.append(numeral)\n            number -= value\n    return \"\".join(result).lower()"}
{"task_id": "HumanEval/156", "solution": "def int_to_mini_roman(number):\n    \"\"\"\n    Given a positive integer, obtain its roman numeral equivalent as a string,\n    and return it in lowercase.\n    Restrictions: 1 <= num <= 1000\n\n    Examples:\n    >>> int_to_mini_roman(19) == 'xix'\n    >>> int_to_mini_roman(152) == 'clii'\n    >>> int_to_mini_roman(426) == 'cdxxvi'\n    \"\"\"\n    roman_map = [\n        (1000, \"M\"), (900, \"CM\"), (500, \"D\"), (400, \"CD\"),\n        (100, \"C\"), (90, \"XC\"), (50, \"L\"), (40, \"XL\"),\n        (10, \"X\"), (9, \"IX\"), (5, \"V\"), (4, \"IV\"), (1, \"I\")\n    ]\n\n    result = []\n    n = number\n    for val, sym in roman_map:\n        while n >= val:\n            result.append(sym)\n            n -= val\n    \n    return \"\".join(result).lower()"}
{"task_id": "HumanEval/157", "solution": "def right_angle_triangle(a, b, c):\n    \"\"\"\n    Determines if three side lengths form a right-angled triangle using the Pythagorean theorem.\n    It uses a floating-point tolerance for accuracy and assumes valid numeric inputs.\n    \"\"\"\n    TOLERANCE = 1e-9\n\n    # Sort sides to identify the potential hypotenuse (largest side).\n    sides = sorted([a, b, c])\n    s1, s2, hyp = sides[0], sides[1], sides[2]\n\n    # Calculate squares of sides.\n    lhs = s1*s1 + s2*s2\n    rhs = hyp*hyp\n\n    # Compare with tolerance to account for floating-point inaccuracies.\n    # Scale tolerance by the magnitude of the numbers, including a minimum of 1.0 for robustness.\n    diff = abs(rhs - lhs)\n    scale = max(abs(rhs), abs(lhs), 1.0)\n    return diff <= TOLERANCE * scale"}
{"task_id": "HumanEval/157", "solution": "```python\ndef right_angle_triangle(a, b, c):\n    '''\n    Given three side lengths, determine if they form a right-angled triangle.\n    It applies the Pythagorean theorem with a floating-point tolerance.\n    '''\n    def almost_equal(val1, val2, tolerance=1e-9):\n        # Compares two floats using a combined relative and absolute tolerance.\n        return abs(val1 - val2) <= max(tolerance, tolerance * max(abs(val1), abs(val2), 1.0))\n\n    # Convert inputs to float, assuming they are convertible as per requirements.\n    side1 = float(a)\n    side2 = float(b)\n    side3 = float(c)\n\n    # Sort the sides to identify the potential legs and hypotenuse.\n    sides = sorted([side1, side2, side3])\n    leg1, leg2, hypotenuse = sides[0], sides[1], sides[2]\n\n    # Apply the Pythagorean theorem: leg1^2 + leg2^2 = hypotenuse^2\n    # Use almost_equal for robust floating-point comparison.\n    return almost_equal(leg1*leg1 + leg2*leg2, hypotenuse*hypotenuse)\n```"}
{"task_id": "HumanEval/158", "solution": "def find_max(words):\n    \"\"\"Finds the word in a list with the maximum number of unique characters.\n    In case of a tie, the lexicographically smallest word is returned.\n    \"\"\"\n    word_unique_counts = {}\n    for word in words:\n        unique_char_count = len(set(word))\n        word_unique_counts[word] = unique_char_count\n\n    max_unique_count = max(word_unique_counts.values())\n\n    candidate_words = [\n        word for word, count in word_unique_counts.items()\n        if count == max_unique_count\n    ]\n\n    return min(candidate_words)"}
{"task_id": "HumanEval/158", "solution": "def find_max(words):\n    \"\"\"Finds the word with the maximum unique characters, using lexicographical order for ties.\"\"\"\n    if not words:\n        return \"\" # Returns an empty string for empty input, as error handling is forbidden.\n\n    best_word = words[0]\n    max_unique_count = len(set(words[0]))\n\n    for i in range(1, len(words)):\n        current_word = words[i]\n        current_unique_count = len(set(current_word))\n\n        if current_unique_count > max_unique_count:\n            max_unique_count = current_unique_count\n            best_word = current_word\n        elif current_unique_count == max_unique_count:\n            # Apply tie-breaker: choose lexicographically smaller word\n            if current_word < best_word:\n                best_word = current_word\n    \n    return best_word"}
