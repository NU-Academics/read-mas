rror\n\ndef tokens_from_argv(argv: Sequence[str]) -> Sequence[str]:\n    \"\"\"\n    Parses a sequence of command-line arguments into individual tokens.\n    Handles splitting by whitespace and commas within arguments.\n    \"\"\"\n    all_parts = []\n    for arg in argv:\n        # First split by commas to handle \"1,2,-3\"\n        comma_separated = arg.split(',')\n        for part in comma_separated:\n            # Then split each part by whitespace to handle \"1 2\"\n            whitespace_separated = part.split()\n            all_parts.extend(whitespace_separated)\n    # Filter out any empty strings that might result from multiple delimiters\n    return [p for p in all_parts if p]\n\ndef parse_cli_numbers(tokens: Sequence[str]) -> List[int]:\n    \"\"\"\n    Converts a sequence of string tokens into a list of integers.\n    Raises InvalidInputError if any token cannot be converted.\n    \"\"\"\n    numbers = []\n    for token in tokens:\n        try:\n            num = int(token)\n            numbers.append(num)\n        except ValueError:\n            raise InvalidInputError(f\"Invalid integer token found: '{token}'.\")\n    return numbers\n\n```\n\n#### `src/pairs_zero/validator.py`\n```python\nfrom typing import Any, List, Sequence\nfrom .dto import ListDTO\nfrom .exceptions import InvalidInputError\nfrom .utils import parse_cli_numbers, tokens_from_argv\n\nclass InputValidator:\n    \"\"\"\n    Validates and normalizes various input types into a ListDTO containing integers.\n    Ensures inputs adhere to defined type and length constraints.\n    \"\"\"\n    MAX_LENGTH: int = 10_000_000\n\n    def validate_list(self, obj: Any) -> ListDTO:\n        \"\"\"\n        Accepts various input types (e.g., list of ints, list of strings, single string)\n        and returns a validated ListDTO.\n        \"\"\"\n        if obj is None:\n            raise InvalidInputError(\"Input cannot be None.\")\n\n        int_items: List[int]\n        if isinstance(obj, str):\n            # Treat a single string as if it came from a CLI argument.\n            # It might contain multiple numbers separated by spaces or commas.\n            tokens = tokens_from_argv([obj])\n            int_items = parse_cli_numbers(tokens)\n        elif isinstance(obj, (list, tuple, set)) or (isinstance(obj, Sequence) and not isinstance(obj, (str, bytes, bytearray))):\n            # If it's a sequence of strings (e.g., from CLI args), parse them.\n            if obj and all(isinstance(item, str) for item in obj):\n                int_items = parse_cli_numbers(obj)\n            else:\n                # Otherwise, it's expected to be a sequence of numeric types.\n                int_items = self._ensure_integers(obj)\n        else:\n            raise InvalidInputError(f\"Input type {type(obj).__name__} is not supported. Expected a sequence of numbers or a string.\")\n\n        if len(int_items) > self.MAX_LENGTH:\n            raise InvalidInputError(f\"Input list exceeds maximum allowed length of {self.MAX_LENGTH}.\")\n\n        return ListDTO(int_items)\n\n    def _ensure_integers(self, items: Sequence[Any]) -> List[int]:\n        \"\"\"\n        Internal method to convert/validate elements in a sequence to integers.\n        Rejects floats and non-integer types explicitly.\n        \"\"\"\n        result = []\n        for i, item in enumerate(items):\n            if isinstance(item, int):\n                result.append(item)\n            elif isinstance(item, float):\n                # Business rule: floats are not accepted to avoid ambiguity.\n                raise InvalidInputError(f\"Element at index {i} is a float: {item}. Only integers are allowed.\")\n            else:\n                raise InvalidInputError(f\"Element at index {i} is not an integer: '{item}' (type: {type(item).__name__}).\")\n        return result\n\n```\n\n#### `src/pairs_zero/service.py`\n```python\nfrom typing import List, Optional, Tuple\n\nclass PairsService:\n    \"\"\"\n    Provides the core algorithm to determine if two distinct elements in a list\n    sum to zero, and can optionally find such a pair.\n    \"\"\"\n    def pairs_sum_to_zero(self, l: List[int]) -> bool:\n        \"\"\"\n        Checks if two distinct elements in the list sum to zero.\n        Handles zero specially, requiring two zeros for a sum of zero.\n        >>> pairs_sum_to_zero([1, 3, 5, 0])\n        False\n        >>> pairs_sum_to_zero([1, 3, -2, 1])\n        False\n        >>> pairs_sum_to_zero([1, 2, 3, 7])\n        False\n        >>> pairs_sum_to_zero([2, 4, -5, 3, 5, 7])\n        True\n        >>> pairs_sum_to_zero([1])\n        False\n        \"\"\"\n        seen = set()\n        zero_count = 0\n        for x in l:\n            if x == 0:\n                zero_count += 1\n                if zero_count >= 2:\n                    return True\n            # Check for -x, ensuring x and -x are distinct elements (implicitly by set).\n            if -x in seen:\n                return True\n            seen.add(x)\n        return False\n\n    def find_pair(self, l: List[int]) -> Optional[Tuple[int, int]]:\n        \"\"\"\n        Finds and returns one pair of distinct elements (a, b) such that a + b == 0.\n        Returns None if no such pair exists.\n        \"\"\"\n        seen = set()\n        zero_found = False\n        for x in l:\n            if x == 0:\n                if zero_found: # Found a second zero\n                    return (0, 0)\n                zero_found = True\n            elif -x in seen:\n                return (x, -x)\n            seen.add(x)\n        return None\n\n```\n\n#### `src/pairs_zero/cli.py`\n```python\nimport sys\nfrom typing import Sequence\nfrom .service import PairsService\nfrom .validator import InputValidator\nfrom .exceptions import InvalidInputError\nfrom .utils import tokens_from_argv\n\nclass CLIController:\n    \"\"\"\n    Handles command-line argument parsing, orchestrates validation and service calls,\n    and manages output