above copyright notice and this permission notice shall be included in all\ncopies or substantial portions of the Software.\n\nTHE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR\nIMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,\nFITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE\nAUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER\nLIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,\nOUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE\nSOFTWARE.\n```\n\n```python\n# .github/workflows/ci.yml\nname: CI\n\non:\n  push:\n    branches: [ main ]\n  pull_request:\n    branches: [ main ]\n\njobs:\n  build:\n    runs-on: ubuntu-latest\n    strategy:\n      matrix:\n        python-version: [\"3.8\", \"3.9\", \"3.10\", \"3.11\"]\n\n    steps:\n    - uses: actions/checkout@v3\n    - name: Set up Python ${{ matrix.python-version }}\n      uses: actions/setup-python@v4\n      with:\n        python-version: ${{ matrix.python-version }}\n    - name: Install dependencies\n      run: |\n        python -m pip install --upgrade pip\n        pip install -e .[dev] # Install the package in editable mode and its dev dependencies\n    - name: Run tests\n      run: |\n        pytest -q src/choosenum/tests/\n```\n\n```python\n# src/choosenum/__init__.py\n\"\"\"\nPackage exports the main choose_num function and core classes.\nThis module provides a convenient entry point for the library.\n\"\"\"\n\nfrom .services import ChooseNumService\nfrom .controllers import CLIController\nfrom .models import InputRange, ResultRecord\nfrom .repository import ResultRepository\nfrom .exceptions import InvalidInputError, PersistenceError\n\ndef choose_num(x: float, y: float) -> int:\n    \"\"\"\n    Finds the largest even integer in the inclusive range [x, y].\n    Returns -1 if no such even integer exists or if inputs are invalid.\n    \"\"\"\n    service = ChooseNumService()\n    return service.choose_num(x, y)\n\n__all__ = [\n    \"choose_num\",\n    \"ChooseNumService\",\n    \"CLIController\",\n    \"InputRange\",\n    \"ResultRecord\",\n    \"ResultRepository\",\n    \"InvalidInputError\",\n    \"PersistenceError\",\n]\n```\n\n```python\n# src/choosenum/__main__.py\n\"\"\"\nCLI entrypoint for the choosenum application.\nIt parses command-line arguments and orchestrates the service call.\n\"\"\"\n\nimport sys\nfrom typing import List\n\nfrom .controllers import CLIController\nfrom .services import ChooseNumService\nfrom .repository import ResultRepository\n\ndef main(argv: List[str] = None) -> int:\n    \"\"\"\n    Main function for the CLI entrypoint.\n    It initializes the necessary components and runs the CLI controller.\n    \"\"\"\n    if argv is None:\n        argv = sys.argv[1:]\n\n    repository = ResultRepository()\n    service = ChooseNumService(repository=repository)\n    controller = CLIController(service=service)\n    return controller.run(argv)\n\nif __name__ == \"__main__\":\n    sys.exit(main())\n```\n\n```python\n# src/choosenum/models.py\n\"\"\"\nDefines domain models for input ranges and result records.\nThese dataclasses encapsulate data structures used throughout the application.\n\"\"\"\n\nimport math\nfrom dataclasses import dataclass\nfrom typing import TYPE_CHECKING\n\nif TYPE_CHECKING:\n    from .exceptions import InvalidInputError # Avoid circular import at runtime\n\n@dataclass(frozen=True)\nclass InputRange:\n    \"\"\"\n    Represents an inclusive numeric interval [x, y].\n    It ensures that the bounds are valid finite numbers.\n    \"\"\"\n    x: float\n    y: float\n\n    def validate(self) -> None:\n        \"\"\"\n        Validates that x and y are finite numbers.\n        Raises InvalidInputError if any input is NaN or infinite.\n        \"\"\"\n        if math.isnan(self.x) or math.isinf(self.x) or \\\n           math.isnan(self.y) or math.isinf(self.y):\n            from .exceptions import InvalidInputError\n            raise InvalidInputError(\"Input values x and y must be finite numbers.\")\n\n@dataclass(frozen=True)\nclass ResultRecord:\n    \"\"\"\n    A data transfer object (DTO) for storing computation results.\n    It captures the input, the computed result, and a timestamp.\n    \"\"\"\n    x: float\n    y: float\n    result: int\n    timestamp: str\n```\n\n```python\n# src/choosenum/services.py\n\"\"\"\nImplements the core business logic for finding the largest even integer.\nIt coordinates between input validation, numeric utilities, and optional persistence.\n\"\"\"\n\nimport datetime\nfrom typing import Optional, TYPE_CHECKING\n\nfrom .models import InputRange, ResultRecord\nfrom .utils import Utils\n\nif TYPE_CHECKING:\n    from .repository import ResultRepository # Avoid circular import at runtime\n\nclass ChooseNumService:\n    \"\"\"\n    Service responsible for the choose_num algorithm and result persistence.\n    It takes an optional repository for storing computation results.\n    \"\"\"\n    def __init__(self, repository: Optional['ResultRepository'] = None) -> None:\n        \"\"\"\n        Initializes the ChooseNumService with an optional ResultRepository.\n        The repository is used for saving computed results.\n        \"\"\"\n        self._repository = repository\n\n    def choose_num(self, x: float, y: float) -> int:\n        \"\"\"\n        Public entry point to find the largest even integer in [x, y].\n        It validates inputs, performs the calculation, and optionally persists the result.\n        \"\"\"\n        r = InputRange(x=x, y=y)\n        r.validate() # Validate inputs for NaN/Inf\n        \n        result = self.choose_num_range(r)\n\n        if self._repository:\n            try:\n                rec = ResultRecord(\n                    x=x, y=y, result=result, timestamp=datetime.datetime.utcnow().isoformat()\n                )\n                self._repository.save_result(rec)\n            except Exception:\n                # Log persistence errors silently or re-raise as PersistenceError if critical.\n                pass # Persistence is optional and failures should not block core logic.\n        return result\n\n    def choose_num_range(self, r: InputRange) -> int:\n        \"\"\"\n        Core algorithm to find the largest even integer within the InputRange.\n        It uses utility functions for floor, ceil, and evenness checks.\n        \"\"\"\n        # If x > y, the interval is empty or invalid in this context.\n        if r.x > r.y:\n            return -1\n        \n        # Convert float bounds to integer bounds.\n        lo = Utils.ceil_to_int(r.x)\n        hi = Utils.floor_to_int(r.y)\n\n        # If the integer interval is empty after ceiling and flooring.\n        if hi < lo:\n            return -1\n        \n        # Determine the largest even number <= hi.\n        candidate = hi if Utils.is_even(hi) else hi - 1\n\n        # Check if the candidate even number is within the [lo, hi] integer range.\n        if candidate >= lo:\n            return candidate\n        else:\n            return -1\n```\n\n```python\n# src/choosenum/controllers.py\n\"\"\"\nHandles command-line interface (CLI) interactions.\nIt parses arguments, calls the service, and manages output and error reporting.\n\"\"\"\n\nimport sys\nfrom typing import List, TYPE_CHECKING\n\nfrom .exceptions import InvalidInputError\n\nif TYPE_CHECKING:\n    from .services import ChooseNumService # Avoid circular import at runtime\n\nclass CLIController:\n    \"\"\"\n    Manages the command-line interface for the choosenum application.\n    It takes a ChooseNumService instance to perform the core logic.\n    \"\"\"\n    def __init__(self, service: 'ChooseNumService') -> None:\n        \"\"\"\n        Initializes the CLIController with a ChooseNumService instance.\n        The service is responsible for the actual computation.\n        \"\"\"\n        self._service = service\n\n    def run(self, argv: List[str]) -> int:\n        \"\"\"\n        Parses command-line arguments, calls the service, and prints the result.\n        Returns an exit code: 0 for success, 2 for usage errors, 1 for runtime errors.\n        \"\"\"\n        if len(argv) != 2:\n            print(\"Usage: choosenum <x> <y>\", file=sys.stderr)\n            return 2  # Exit code for incorrect usage\n\n        try:\n            x = float(argv[0])\n            y = float(argv[1])\n        except ValueError:\n            print(\"Error: Both x and y must be numbers.\", file=sys.stderr)\n            return 2  # Exit code for invalid argument format\n\n        try:\n            result = self._service.choose_num(x, y)\n            print(result)\n            return 0  # Success exit code\n        except InvalidInputError as e:\n            print(f\"Error: Invalid input: {e}\", file=sys.stderr)\n            return 1  # General runtime error for invalid input values\n        except Exception as e:\n            print(f\"An unexpected error occurred: {e}\", file=sys.stderr)\n            return 1  # Catch all for other unexpected errors\n```\n\n```python\n# src/choosenum/repository.py\n\"\"\"\nProvides a simple persistence layer for ResultRecord objects.\nIt uses a local JSON file to store a list of results.\n\"\"\"\n\nimport json\nimport os\nfrom typing import List, TYPE_CHECKING\n\nif TYPE_CHECKING:\n    from .models import ResultRecord # Avoid circular import at runtime\n    from .exceptions import PersistenceError # Avoid circular import at runtime\n\nclass ResultRepository:\n    \"\"\"\n    Manages persistence of ResultRecord objects to a local JSON file.\n    It supports saving new records and loading all existing ones.\n    \"\"\"\n    def __init__(self, path: str = \"results.json\") -> None:\n        \"\"\"\n        Initializes the repository with the path to the JSON file.\n        The file will be created if it does not exist upon saving.\n        \"\"\"\n        self._path = path\n\n    def save_result(self, record: 'ResultRecord') -> None:\n        \"\"\"\n        Appends a new ResultRecord to the JSON file.\n        Errors during file operations are wrapped in PersistenceError.\n        \"\"\"\n        from .exceptions import PersistenceError\n        all_records = []\n        if os.path.exists(self._path):\n            try:\n                with open(self._path, 'r', encoding='utf-8') as f:\n                    all_records = json.load(f)\n            except json.JSONDecodeError as e:\n                # If the file is corrupted, start fresh, but log/warn.\n                print(f\"Warning: JSON file '{self._path}' corrupted. Starting fresh. Error: {e}\", file=os.stderr)\n            except IOError as e:\n                raise PersistenceError(f\"Error reading results file {self._path}: {e}\") from e\n\n        all_records.append(record.__dict__) # Convert dataclass to dict for JSON\n\n        try:\n            with open(self._path, 'w', encoding='utf-8') as f:\n                json.dump(all_records, f, indent=2)\n        except IOError as e:\n            raise PersistenceError(f\"Error writing results file {self._path}: {e}\") from e\n\n    def load_all(self) -> List['ResultRecord']:\n        \"\"\"\n        Loads all ResultRecord objects from the JSON file.\n        Returns an empty list if the file does not exist or is empty/corrupted.\n        \"\"\"\n        from .exceptions import PersistenceError\n        from .models import ResultRecord # Import here to avoid circular dependency at module level\n        if not os.path.exists(self._path):\n            return []\n        \n        try:\n            with open(self._path, 'r', encoding='utf-8') as f:\n                data = json.load(f)\n                return [ResultRecord(**rec_dict) for rec_dict in data]\n        except json.JSONDecodeError as e:\n            print(f\"Warning: JSON file '{self._path}' corrupted. Returning empty list. Error: {e}\", file=os.stderr)\n            return [] # Return empty list if file is not valid JSON\n        except IOError as e:\n            raise PersistenceError(f\"Error reading results file {self._path}: {e}\") from e\n```\n\n```python\n# src/choosenum/utils.py\n\"\"\"\nProvides static utility methods for numeric operations.\nThese include ceiling, floor, and evenness checks for numbers.\n\"\"\"\n\nimport math\nfrom typing import TYPE_CHECKING\n\nif TYPE_CHECKING:\n    from .exceptions import InvalidInputError # Avoid circular import at runtime\n\nclass Utils:\n    \"\"\"\n    A collection of static utility methods for common numeric operations.\n    These methods help with type conversions and mathematical checks.\n    \"\"\"\n    @staticmethod\n    def _validate_finite_number(val: float) -> None:\n        \"\"\"\n        Internal helper to validate if a value is a finite number.\n        Raises InvalidInputError if the value is NaN or infinite.\n        \"\"\"\n        from .exceptions import InvalidInputError\n        if not (isinstance(val, (int, float)) and not (math.isnan(val) or math.isinf(val))):\n            raise InvalidInputError(\"Value must be a finite number.\")\n\n    @staticmethod\n    def ceil_to_int(val: float) -> int:\n        \"\"\"\n        Returns the ceiling of a float value, converted to an integer.\n        Raises InvalidInputError if the input is not a finite number.\n        \"\"\"\n        Utils._validate_finite_number(val)\n        return math.ceil(val)\n\n    @staticmethod\n    def floor_to_int(val: float) -> int:\n        \"\"\"\n        Returns the floor of a float value, converted to an integer.\n        Raises InvalidInputError if the input is not a finite number.\n        \"\"\"\n        Utils._validate_finite_number(val)\n        return math.floor(val)\n\n    @staticmethod\n    def is_even(n: int) -> bool:\n        \"\"\"\n        Checks if an integer is even.\n        Returns True if the number is even, False otherwise.\n        \"\"\"\n        return (n % 2) == 0\n```\n\n```python\n# src/choosenum/exceptions.py\n\"\"\"\nCustom exception definitions for the choosenum application.\nThese exceptions provide specific error handling contexts.\n\"\"\"\n\nclass InvalidInputError(Exception):\n    \"\"\"\n    Raised when input values are invalid, e.g., non-numeric, NaN, or infinite.\n    This helps in distinguishing input validation failures.\n    \"\"\"\n    pass\n\nclass PersistenceError(Exception):\n    \"\"\"\n    Raised when an error occurs during data persistence operations.\n    This includes file I/O errors or issues with data serialization.\n    \"\"\"\n    pass\n```\n\n```python\n# src/choosenum/tests/__init__.py\n# This file marks the directory as a Python package.\n# No tests are included as per the critical requirement.\n```\n```"}
{"task_id": "HumanEval/102", "solution": "def choose_num(x, y):\n    \"\"\"Returns the largest even integer in [x, y] (inclusive) for positive numbers x and y.\n    Returns -1 if no such even integer exists in the range.\n    \"\"\"\n    if x > y:\n        return -1\n\n    # Calculate the largest integer N such that N <= y.\n    # For positive y, int(y) performs a floor operation.\n    largest_even_candidate = int(y)\n\n    # Adjust to ensure it's an even number.\n    if largest_even_candidate % 2 != 0:\n        largest_even_candidate -= 1\n\n    # Calculate the smallest integer M such that M >= x.\n    # For positive x, int(x) is floor(x). If x is a float, we need ceil(x).\n    smallest_int_lower_bound = int(x)\n    if x > smallest_int_lower_bound: # This means x is a non-integer float, so we need to round up.\n        smallest_int_lower_bound += 1\n\n    # If the largest even candidate is less than the smallest integer allowed by x,\n    # then no even integer exists in the range.\n    if largest_even_candidate < smallest_int_lower_bound:\n        return -1\n    else:\n        return largest_even_candidate"}
