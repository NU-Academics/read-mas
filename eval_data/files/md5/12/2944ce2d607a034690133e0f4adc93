{"task_id": "HumanEval/86", "solution": "def anti_shuffle(s):\n    \"\"\"\n    Returns an ordered version of a sentence where each word's characters\n    are sorted in ascending ASCII order. Spaces are preserved.\n    \"\"\"\n    \n    if not s:\n        return \"\"\n\n    tokens = []\n    buffer = s[0]\n    for ch_idx in range(1, len(s)):\n        ch = s[ch_idx]\n        is_ch_space = (ch == ' ')\n        is_buffer_last_space = (buffer[-1] == ' ')\n        \n        if is_ch_space == is_buffer_last_space:\n            buffer += ch\n        else:\n            tokens.append(buffer)\n            buffer = ch\n    tokens.append(buffer)\n    \n    out_parts = []\n    for token in tokens:\n        is_space_token = True\n        for char_in_token in token:\n            if char_in_token != ' ':\n                is_space_token = False\n                break\n        \n        if is_space_token:\n            out_parts.append(token)\n        else:\n            out_parts.append(\"\".join(sorted(token)))\n            \n    return \"\".join(out_parts)"}
{"task_id": "HumanEval/86", "solution": "def anti_shuffle(s):\n    \"\"\"\n    Sorts characters within each word of a string, preserving whitespace and word order.\n    Words are non-whitespace sequences, characters are sorted by ASCII value.\n    \"\"\"\n\n    def _tokenize(text):\n        \"\"\"Splits a string into alternating segments of whitespace and non-whitespace.\"\"\"\n        tokens = []\n        if not text:\n            return tokens\n\n        current_token_chars = []\n        is_current_segment_whitespace = text[0].isspace()\n\n        for char in text:\n            char_is_whitespace = char.isspace()\n\n            if char_is_whitespace == is_current_segment_whitespace:\n                current_token_chars.append(char)\n            else:\n                tokens.append(\"\".join(current_token_chars))\n                current_token_chars = [char]\n                is_current_segment_whitespace = char_is_whitespace\n        \n        if current_token_chars:\n            tokens.append(\"\".join(current_token_chars))\n            \n        return tokens\n\n    tokens = _tokenize(s)\n    \n    result_tokens = []\n    for token in tokens:\n        if token.isspace():\n            result_tokens.append(token)\n        else:\n            sorted_chars = sorted(token)\n            result_tokens.append(\"\".join(sorted_chars))\n\n    return \"\".join(result_tokens)"}
