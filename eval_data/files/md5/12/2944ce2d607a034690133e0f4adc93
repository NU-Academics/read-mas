{"task_id": "HumanEval/141", "solution": "def file_name_check(file_name):\n    \"\"\"Checks if a file's name is valid based on specific rules.\n    Returns 'Yes' if valid, 'No' otherwise.\"\"\"\n\n    # FR1: If string empty, return 'No'.\n    if not file_name:\n        return 'No'\n\n    # FR2: Count digits in the entire file name.\n    digit_count = 0\n    for char in file_name:\n        if '0' <= char <= '9':\n            digit_count += 1\n    if digit_count > 3:  # Reject names with more than 3 digits.\n        return 'No'\n\n    # FR3: Ensure exactly one '.' exists in file name.\n    parts = file_name.split('.')\n    if len(parts) != 2:\n        return 'No'\n\n    base = parts[0]\n    extension = parts[1]\n\n    # FR4: Substring before '.' is non-empty and starts with ASCII latin letter.\n    if not base:  # Check if base is non-empty.\n        return 'No'\n    \n    first_char = base[0]\n    # Check if first character is an ASCII latin letter.\n    if not ('a' <= first_char <= 'z' or 'A' <= first_char <= 'Z'):\n        return 'No'\n\n    # FR5: Extension is one of ['txt','exe','dll'] (case-insensitive).\n    allowed_extensions = {'txt', 'exe', 'dll'}\n    if extension.lower() not in allowed_extensions:\n        return 'No'\n\n    # All conditions met.\n    return 'Yes'"}
{"task_id": "HumanEval/142", "solution": "def sum_squares(lst):\n    \"\"\"\n    Computes a transformed sum of integer lists based on index-based rules.\n    Indices multiple of 3 are squared; indices multiple of 4 but not 3 are cubed; others unchanged.\n    \"\"\"\n    total = 0\n    for i, x in enumerate(lst):\n        if i % 3 == 0:\n            total += x * x\n        elif i % 4 == 0:  # i % 3 != 0 is implicitly handled by the 'elif'\n            total += x * x * x\n        else:\n            total += x\n    return total"}
{"task_id": "HumanEval/143", "solution": "def words_in_sentence(sentence):\n    \"\"\"\n    Extracts words from a sentence whose lengths are prime numbers.\n    Preserves the original order of the words.\n    \"\"\"\n\n    def is_prime(n: int) -> bool:\n        \"\"\"\n        Checks if a given integer is a prime number.\n        Returns True for primes, False otherwise.\n        \"\"\"\n        if n < 2:\n            return False\n        if n == 2:\n            return True\n        if n % 2 == 0:\n            return False\n        i = 3\n        while i * i <= n:\n            if n % i == 0:\n                return False\n            i += 2\n        return True\n\n    words = sentence.split(\" \")\n    filtered_words = [word for word in words if is_prime(len(word))]\n    return \" \".join(filtered_words)"}
{"task_id": "HumanEval/142", "solution": "def sum_squares(lst):\n    \"\"\"\n    Computes a derived sum from a list of integers based on index-based transformation rules.\n    Squares elements at indices multiple of 3, cubes elements at indices multiple of 4 (but not 3), otherwise unchanged.\n    \"\"\"\n    total_sum = 0\n    for i, value in enumerate(lst):\n        if i % 3 == 0:\n            total_sum += value ** 2\n        elif i % 4 == 0:  # This condition implies i % 3 != 0 due to the 'if-elif' structure\n            total_sum += value ** 3\n        else:\n            total_sum += value\n    return total_sum"}
{"task_id": "HumanEval/143", "solution": "import math\n\ndef words_in_sentence(sentence):\n    \"\"\"\n    Extracts words from a sentence whose lengths are prime numbers.\n    The order of words is preserved.\n    \"\"\"\n\n    def is_prime(n: int) -> bool:\n        \"\"\"Determines if a non-negative integer is a prime number.\"\"\"\n        if n < 2:\n            return False\n        if n == 2:\n            return True\n        if n % 2 == 0:\n            return False\n        limit = int(math.sqrt(n)) + 1\n        for i in range(3, limit, 2):\n            if n % i == 0:\n                return False\n        return True\n\n    words = sentence.split()\n    prime_length_words = [word for word in words if is_prime(len(word))]\n    return \" \".join(prime_length_words)"}
{"task_id": "HumanEval/144", "solution": "def simplify(x, n):\n    \"\"\"Evaluates if the product of two fractions, x and n, is a whole number.\n    Returns True if the product is a whole number, False otherwise.\"\"\"\n\n    def _gcd(a, b):\n        \"\"\"Computes the greatest common divisor of two integers using Euclid's algorithm.\"\"\"\n        while b:\n            a, b = b, a % b\n        return a\n\n    # Parse fraction x\n    num1_str, den1_str = x.split('/')\n    num1 = int(num1_str)\n    den1 = int(den1_str)\n\n    # Parse fraction n\n    num2_str, den2_str = n.split('/')\n    num2 = int(num2_str)\n    den2 = int(den2_str)\n\n    # Multiply fractions\n    product_numerator = num1 * num2\n    product_denominator = den1 * den2\n\n    # Simplify the product fraction\n    common_divisor = _gcd(product_numerator, product_denominator)\n    \n    # After simplification, check if the denominator is 1\n    return (product_denominator // common_divisor) == 1"}
{"task_id": "HumanEval/144", "solution": "import math\n\ndef simplify(x, n):\n    \"\"\"Your task is to implement a function that will simplify the expression\n    x * n. The function returns True if x * n evaluates to a whole number and False\n    otherwise. Both x and n, are string representation of a fraction, and have the following format,\n    <numerator>/<denominator> where both numerator and denominator are positive whole numbers.\n\n    You can assume that x, and n are valid fractions, and do not have zero as denominator.\n\n    simplify(\"1/5\", \"5/1\") = True\n    simplify(\"1/6\", \"2/1\") = False\n    simplify(\"7/10\", \"10/2\") = False\n    \"\"\"\n    # Parse the first fraction string x into numerator and denominator integers.\n    num_x_str, den_x_str = x.split('/')\n    num_x = int(num_x_str)\n    den_x = int(den_x_str)\n\n    # Parse the second fraction string n into numerator and denominator integers.\n    num_n_str, den_n_str = n.split('/')\n    num_n = int(num_n_str)\n    den_n = int(den_n_str)\n\n    # Calculate the product of the two fractions: (num_x * num_n) / (den_x * den_n).\n    product_numerator = num_x * num_n\n    product_denominator = den_x * den_n\n\n    # Reduce the resulting fraction to its lowest terms using the greatest common divisor.\n    common_divisor = math.gcd(product_numerator, product_denominator)\n    reduced_numerator = product_numerator // common_divisor\n    reduced_denominator = product_denominator // common_divisor\n\n    # A fraction is a whole number if its denominator in reduced form is 1.\n    return reduced_denominator == 1"}
{"task_id": "HumanEval/145", "solution": "def order_by_points(nums):\n    \"\"\"\n    Sorts a list of integers in ascending order by the sum of their digits.\n    Ties are broken by the original index of the numbers in the input list.\n    \"\"\"\n    def _digit_sum(n):\n        \"\"\"Calculates the sum of the absolute digits of an integer.\"\"\"\n        s = 0\n        v = abs(n)\n        while v:\n            s += v % 10\n            v //= 10\n        return s\n\n    # Create a list of tuples: (digit_sum, original_index, original_value)\n    # Python's Timsort is stable, so sorting by (digit_sum, original_index)\n    # naturally handles the tie-breaking requirement.\n    decorated_list = [(_digit_sum(num), i, num) for i, num in enumerate(nums)]\n\n    # Sort the decorated list\n    decorated_list.sort()\n\n    # Extract the original values from the sorted list\n    return [item[2] for item in decorated_list]"}
{"task_id": "HumanEval/145", "solution": "```python\ndef order_by_points(nums):\n    \"\"\"\n    Sorts a list of integers by the sum of their digits (absolute value),\n    then by sign (negative numbers before non-negative), then by original index.\n    \"\"\"\n\n    def _calculate_digit_sum(n: int) -> int:\n        \"\"\"Calculates the sum of digits for the absolute value of an integer.\"\"\"\n        s = 0\n        n = abs(n)\n        while n:\n            s += n % 10\n            n //= 10\n        return s\n\n    # Prepare items for sorting, capturing digit sum, sign priority, original index, and value.\n    # Sign priority: 0 for negative numbers, 1 for non-negative numbers.\n    sortable_items = []\n    for i, num in enumerate(nums):\n        digit_sum_val = _calculate_digit_sum(num)\n        sign_priority_val = 0 if num < 0 else 1\n        sortable_items.append((digit_sum_val, sign_priority_val, i, num))\n\n    # Sort the items based on the tuple keys. Python's tuple comparison handles the sort order.\n    sortable_items.sort()\n\n    # Extract the original values from the sorted items to form the final list.\n    sorted_values = [item[3] for item in sortable_items]\n\n    return sorted_values\n```"}
{"task_id": "HumanEval/146", "solution": "def specialFilter(nums):\n    \"\"\"Counts numbers strictly greater than 10 where the first and last digits of their absolute integer part are odd.\"\"\"\n    count = 0\n    for v in nums:\n        # Check if the original value is strictly greater than 10.\n        if v <= 10:\n            continue\n\n        # Get the absolute integer part for digit extraction.\n        # Per design spec, this handles floats and negative numbers.\n        iv = abs(int(v))\n\n        # Extract the last decimal digit.\n        last_digit = iv % 10\n\n        # Extract the first decimal digit.\n        # Since v > 10, iv will be at least 11, so this loop will execute correctly.\n        first_digit = iv\n        while first_digit >= 10:\n            first_digit //= 10\n\n        # Check if both first and last digits are odd.\n        if (first_digit % 2 == 1) and (last_digit % 2 == 1):\n            count += 1\n    return count"}
{"task_id": "HumanEval/146", "solution": "def get_first_digit(n):\n    \"\"\"Returns the first decimal digit of the absolute value of n.\"\"\"\n    n = abs(n)\n    while n >= 10:\n        n //= 10\n    return n\n\ndef get_last_digit(n):\n    \"\"\"Returns the last decimal digit of the absolute value of n.\"\"\"\n    return abs(n) % 10\n\ndef is_digit_odd(d):\n    \"\"\"Checks if a given digit is odd.\"\"\"\n    return d % 2 == 1\n\ndef specialFilter(nums):\n    \"\"\"Counts numbers in the input list that are greater than 10 and\n    have both their first and last decimal digits odd.\"\"\"\n    count = 0\n    for num in nums:\n        if num > 10:\n            first_digit = get_first_digit(num)\n            last_digit = get_last_digit(num)\n            if is_digit_odd(first_digit) and is_digit_odd(last_digit):\n                count += 1\n    return count"}
{"task_id": "HumanEval/147", "solution": "def get_max_triples(n):\n    \"\"\"\n    Computes the number of ordered triples (a[i], a[j], a[k]) with i < j < k from a sequence\n    a[i] = i*i - i + 1, whose sum is divisible by 3.\n    \"\"\"\n    def nCk(n_val: int, k_val: int) -> int:\n        \"\"\"Calculates n choose k for small k values.\"\"\"\n        if k_val < 0 or n_val < 0:\n            return 0 # Per \"simplest, most direct logic\" for cases like nCk(negative, k)\n        if k_val > n_val:\n            return 0\n        if k_val == 0:\n            return 1\n        if k_val == 1:\n            return n_val\n        if k_val == 2:\n            return n_val * (n_val - 1) // 2\n        if k_val == 3:\n            return n_val * (n_val - 1) * (n_val - 2) // 6\n        return 0 # For k > 3, nCk will be 0 as we only consider k=0,1,2,3 for combinations.\n\n    # Step 1: Count indices i (1 to n) by their remainder modulo 3.\n    base = n // 3\n    rem = n % 3\n    counts_by_mod_i = {\n        0: base, # Count of i such that i % 3 == 0\n        1: base, # Count of i such that i % 3 == 1\n        2: base  # Count of i such that i % 3 == 2\n    }\n    # Indices are 1-based, so the remainders 1..rem get an additional count.\n    for i_rem in range(1, rem + 1):\n        counts_by_mod_i[i_rem] += 1\n\n    # Step 2: Map counts of i%3 to counts of a[i]%3.\n    # Derivation:\n    # i % 3 == 0 => a[i] = 9k^2 - 3k + 1 => a[i] % 3 == 1\n    # i % 3 == 1 => a[i] = 9k^2 + 3k + 1 => a[i] % 3 == 1\n    # i % 3 == 2 => a[i] = 9k^2 + 9k + 3 => a[i] % 3 == 0\n\n    c0_a = counts_by_mod_i[2] # Count of a[i] where a[i] % 3 == 0\n    c1_a = counts_by_mod_i[0] + counts_by_mod_i[1] # Count of a[i] where a[i] % 3 == 1\n    c2_a = 0 # Count of a[i] where a[i] % 3 == 2 (always 0)\n\n    # Step 3: Compute triples based on residue counts.\n    # Sum (x + y + z) is divisible by 3 if (x%3 + y%3 + z%3) % 3 == 0.\n    # Possible residue combinations that sum to 0 mod 3:\n    # (0, 0, 0): nCk(c0_a, 3)\n    # (1, 1, 1): nCk(c1_a, 3)\n    # (2, 2, 2): nCk(c2_a, 3)\n    # (0, 1, 2): c0_a * c1_a * c2_a\n\n    total_triples = (\n        nCk(c0_a, 3) +\n        nCk(c1_a, 3) +\n        nCk(c2_a, 3) +\n        c0_a * c1_a * c2_a\n    )\n\n    return total_triples"}
{"task_id": "HumanEval/147", "solution": "def get_max_triples(n):\n    \"\"\"\n    Computes the number of index triples (i < j < k) such that a[i] + a[j] + a[k] is divisible by 3.\n    The array elements a[i] are defined by a[i] = i*i - i + 1 for i = 1..n.\n    \"\"\"\n    \n    # Calculate counts of elements that are 0 (mod 3) and 1 (mod 3).\n    # a[i] % 3 == 0 when i % 3 == 2.\n    # a[i] % 3 == 1 otherwise (i % 3 == 0 or i % 3 == 1).\n    count_zero = (n + 1) // 3\n    count_one = n - count_zero\n\n    # Function to compute combinations C(x, 3).\n    # Returns 0 if x is less than 3, otherwise computes x * (x - 1) * (x - 2) // 6.\n    def safe_combinations3(x):\n        if x < 3:\n            return 0\n        return (x * (x - 1) * (x - 2)) // 6\n\n    # The sum a[i] + a[j] + a[k] is divisible by 3 if:\n    # 1. All three elements are 0 (mod 3)\n    # 2. All three elements are 1 (mod 3)\n    # Other combinations like (0,0,1) or (0,1,1) do not sum to 0 (mod 3).\n    triples_from_zeros = safe_combinations3(count_zero)\n    triples_from_ones = safe_combinations3(count_one)\n\n    return triples_from_zeros + triples_from_ones"}
{"task_id": "HumanEval/148", "solution": "PLANETS_ORDER = (\n    \"Mercury\", \"Venus\", \"Earth\", \"Mars\",\n    \"Jupiter\", \"Saturn\", \"Uranus\", \"Neptune\"\n)\nPLANET_MAP = {name.lower(): (name, i) for i, name in enumerate(PLANETS_ORDER)}\n\ndef bf(planet1, planet2):\n    \"\"\"\n    Returns a tuple of planets whose orbits lie strictly between two given planets,\n    sorted by proximity to the Sun. Returns an empty tuple for invalid planet names.\n    \"\"\"\n    def _get_planet_info(name_input):\n        normalized_name = name_input.strip().lower()\n        return PLANET_MAP.get(normalized_name)\n\n    info1 = _get_planet_info(planet1)\n    info2 = _get_planet_info(planet2)\n\n    if info1 is None or info2 is None:\n        return ()\n\n    _, index1 = info1\n    _, index2 = info2\n\n    if index1 == index2 or abs(index1 - index2) <= 1:\n        return ()\n\n    start_index = min(index1, index2)\n    end_index = max(index1, index2)\n\n    result = PLANETS_ORDER[start_index + 1:end_index]\n\n    return tuple(result)"}
{"task_id": "HumanEval/148", "solution": "def bf(planet1, planet2):\n    \"\"\"\n    Returns planets whose orbits are between planet1 and planet2, sorted by proximity to the Sun.\n    Returns an empty tuple if planet names are incorrect or no planets are found between them.\n    \"\"\"\n    CANONICAL_PLANETS = (\n        \"Mercury\", \"Venus\", \"Earth\", \"Mars\", \"Jupiter\", \"Saturn\", \"Uranus\", \"Neptune\"\n    )\n\n    # Precompute a lookup map for normalized planet names to their indices for O(1) access.\n    # This emulates the PlanetRepository's internal _index_by_normalized map.\n    _index_by_normalized = {p.lower(): i for i, p in enumerate(CANONICAL_PLANETS)}\n\n    def _get_index_for_bf(name: str) -> int | None:\n        \"\"\"Looks up the index of a planet by its normalized name, returning None if not found.\"\"\"\n        # As per design, normalize input name by stripping whitespace and converting to lowercase.\n        # This matches the lookup keys in _index_by_normalized.\n        normalized_name = name.strip().lower()\n        return _index_by_normalized.get(normalized_name)\n\n    # Get the indices for both input planets. If a planet name is invalid, its index will be None.\n    index1 = _get_index_for_bf(planet1)\n    index2 = _get_index_for_bf(planet2)\n\n    # If either planet name was not found (index is None), return an empty tuple as specified.\n    if index1 is None or index2 is None:\n        return ()\n\n    # Sort the two indices to establish a consistent 'lower' and 'higher' bound for slicing.\n    # The slice should capture planets *strictly* between them, closest to the Sun first.\n    lo, hi = sorted((index1, index2))\n\n    # Slice CANONICAL_PLANETS from one position after the 'lower' index up to (but not including)\n    # the 'higher' index. This naturally handles cases where no planets are between (e.g., adjacent or same planets),\n    # resulting in an empty tuple.\n    return CANONICAL_PLANETS[lo + 1 : hi]"}
