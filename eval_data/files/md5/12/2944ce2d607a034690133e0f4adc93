{"task_id": "HumanEval/97", "solution": "```toml\n[project]\nname = \"unitmul\"\nversion = \"0.1.0\"\ndescription = \"A simple Python library and CLI tool to compute the product of two integer unit digits.\"\nauthors = [\"Your Name <you@example.com>\"]\nlicense = \"MIT\"\nreadme = \"README.md\"\nrequires-python = \">=3.9\"\n\n[project.dependencies]\n# No external dependencies beyond standard library for the core logic.\n\n[project.scripts]\nunitmul = \"unitmul.cli:main\"\n\n[build-system]\nrequires = [\"setuptools>=61.0\"]\nbuild-backend = \"setuptools.build_meta\"\n```\n\n```markdown\n# Unitmul - Unit Digit Multiplier\n\nA simple Python library and CLI tool to compute the product of two integer unit (ones) digits.\n\n## Installation\n\n```bash\npip install .\n```\n\n## Usage\n\n### Library\n\n```python\nfrom unitmul import multiply\n\n# Compute product of unit digits\nresult = multiply(148, 412)  # Returns 16\nprint(f\"Product: {result}\")\n\nresult = multiply(19, 28)    # Returns 72\nprint(f\"Product: {result}\")\n\nresult = multiply(2020, 1851) # Returns 0\nprint(f\"Product: {result}\")\n\nresult = multiply(14, -15)   # Returns 20\nprint(f\"Product: {result}\")\n\n# Error handling\ntry:\n    multiply(10, \"abc\")\nexcept ValueError as e:\n    print(f\"Error: {e}\")\n```\n\n### Command Line Interface (CLI)\n\n```bash\n# Compute product of unit digits\nunitmul 148 412\n# Output: 16\n\nunitmul 19 28\n# Output: 72\n\nunitmul 2020 1851\n# Output: 0\n\nunitmul 14 -15\n# Output: 20\n\n# Error handling\nunitmul 10 abc\n# Output to stderr: Error: Invalid input 'abc'. Both arguments must be integers.\n\n# Optional Persistence (using an environment variable)\n# This will create/append to unitmul_records.jsonl in the current directory\nUNITMUL_PERSIST_PATH=unitmul_records.jsonl unitmul 123 456\n# Output: 18\n# And unitmul_records.jsonl will contain a new entry.\n```\n```\n\n```python\n# src/unitmul/__init__.py\nfrom .api import multiply\n\n__all__ = [\"multiply\"]\n```\n\n```python\n# src/unitmul/logging_config.py\nimport logging\n\ndef configure_logging(level: str = \"INFO\") -> None:\n    \"\"\"Configures basic logging for the application.\"\"\"\n    logging.basicConfig(\n        level=getattr(logging, level.upper(), logging.INFO),\n        format='%(asctime)s - %(name)s - %(levelname)s - %(message)s'\n    )\n```\n\n```python\n# src/unitmul/exceptions.py\nclass ValidationError(ValueError):\n    \"\"\"Custom exception for invalid input parameters.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n```\n\n```python\n# src/unitmul/utils.py\nimport datetime\nimport uuid\nfrom .exceptions import ValidationError\n\nDEFAULT_PERSISTENCE_PATH: str = \"unitmul_records.jsonl\"\n\ndef parse_int(s: str) -> int:\n    \"\"\"Converts a string to an integer, raising ValidationError on failure.\"\"\"\n    try:\n        return int(s)\n    except ValueError:\n        raise ValidationError(f\"Invalid input '{s}'. Argument must be an integer.\")\n\ndef now_iso() -> str:\n    \"\"\"Returns the current UTC time as an ISO 8601 string.\"\"\"\n    return datetime.datetime.now(datetime.timezone.utc).isoformat(timespec='seconds') + 'Z'\n\ndef generate_uuid() -> str:\n    \"\"\"Generates a UUID4 as a string.\"\"\"\n    return str(uuid.uuid4())\n```\n\n```python\n# src/unitmul/dto.py\nfrom typing import NamedTuple\n\nclass InputDTO(NamedTuple):\n    \"\"\"A data transfer object for input integers.\"\"\"\n    a: int\n    b: int\n\nclass ResultDTO(NamedTuple):\n    \"\"\"A data transfer object for computation results.\"\"\"\n    id: str\n    a: int\n    b: int\n    result: int\n    timestamp: str\n```\n\n```python\n# src/unitmul/repository.py\nimport abc\nimport json\nimport logging\nfrom typing import Dict, List, Any\n\nlogger = logging.getLogger(__name__)\n\nclass CalculationRepository(abc.ABC):\n    \"\"\"Abstract base class defining the interface for calculation persistence.\"\"\"\n    @abc.abstractmethod\n    def save(self, record: Dict[str, Any]) -> None:\n        \"\"\"Saves a calculation record.\"\"\"\n        pass\n\nclass InMemoryCalculationRepository(CalculationRepository):\n    \"\"\"An in-memory implementation of CalculationRepository for testing.\"\"\"\n    def __init__(self) -> None:\n        self._records: List[Dict[str, Any]] = []\n\n    def save(self, record: Dict[str, Any]) -> None:\n        \"\"\"Stores the record in an in-memory list.\"\"\"\n        self._records.append(record)\n\n    def all(self) -> List[Dict[str, Any]]:\n        \"\"\"Returns all stored records.\"\"\"\n        return list(self._records)\n\nclass FileCalculationRepository(CalculationRepository):\n    \"\"\"A file-based implementation of CalculationRepository using JSON Lines.\"\"\"\n    def __init__(self, path: str) -> None:\n        self.path = path\n\n    def save(self, record: Dict[str, Any]) -> None:\n        \"\"\"Appends a JSON line to the configured file path.\"\"\"\n        try:\n            with open(self.path, \"a\", encoding=\"utf-8\") as f:\n                f.write(json.dumps(record, ensure_ascii=False) + \"\\n\")\n        except IOError as e:\n            logger.error(f\"Failed to write record to file {self.path}: {e}\")\n            raise # Re-raise for specific error handling if needed, though controller catches broadly.\n```\n\n```python\n# src/unitmul/services.py\nclass UnitDigitService:\n    \"\"\"Provides core business logic for unit digit operations.\"\"\"\n    def __init__(self) -> None:\n        \"\"\"Initializes the UnitDigitService.\"\"\"\n        pass\n\n    def get_unit_digit(self, value: int) -> int:\n        \"\"\"Extracts the unit (ones) digit of an integer, ignoring its sign.\"\"\"\n        return abs(value) % 10\n\n    def multiply_digits(self, a: int, b: int) -> int:\n        \"\"\"Multiplies the unit digits of two integers.\"\"\"\n        return self.get_unit_digit(a) * self.get_unit_digit(b)\n```\n\n```python\n# src/unitmul/controllers.py\nimport logging\nfrom typing import Optional\nfrom .services import UnitDigitService\nfrom .repository import CalculationRepository\nfrom .dto import ResultDTO\nfrom .exceptions import ValidationError\nfrom .utils import now_iso, generate_uuid\n\nlogger = logging.getLogger(__name__)\n\nclass MultiplyController:\n    \"\"\"Coordinates input validation, service calls, and optional persistence.\"\"\"\n    def __init__(self, service: UnitDigitService, repo: Optional[CalculationRepository] = None) -> None:\n        \"\"\"Initializes the controller with a service and an optional repository.\"\"\"\n        self.service = service\n        self.repo = repo\n\n    def compute(self, a: int, b: int) -> ResultDTO:\n        \"\"\"Validates inputs, computes the product, and returns a ResultDTO.\"\"\"\n        if not isinstance(a, int) or not isinstance(b, int):\n            raise ValidationError(\"Inputs must be integers.\")\n\n        result = self.service.multiply_digits(a, b)\n        return ResultDTO(\n            id=generate_uuid(),\n            a=a,\n            b=b,\n            result=result,\n            timestamp=now_iso()\n        )\n\n    def compute_and_persist(self, a: int, b: int) -> ResultDTO:\n        \"\"\"Computes the product and optionally persists the record.\"\"\"\n        result_dto = self.compute(a, b)\n        if self.repo:\n            try:\n                # Convert ResultDTO to dict for generic repository save method\n                self.repo.save(result_dto._asdict())\n            except Exception as e:\n                logger.exception(\"Failed to persist calculation record.\")\n        return result_dto\n```\n\n```python\n# src/unitmul/api.py\nfrom .services import UnitDigitService\nfrom .controllers import MultiplyController\nfrom .exceptions import ValidationError\n\ndef multiply(a: int, b: int) -> int:\n    \"\"\"\n    Computes the product of the unit digits of two integers.\n    The sign of the input integers is ignored for digit extraction.\n    Raises ValidationError if inputs are not integers.\n    \"\"\"\n    service = UnitDigitService()\n    controller = MultiplyController(service)\n    try:\n        # compute validates inputs and returns ResultDTO, we only need the result.\n        return controller.compute(a, b).result\n    except ValidationError as e:\n        # Re-raise ValidationError (which is a subclass of ValueError) for API callers.\n        raise e\n    except TypeError as e:\n        # Catch potential type errors from internal Python operations if not caught by isinstance.\n        raise ValidationError(f\"Invalid input type: {e}\")\n```\n\n```python\n# src/unitmul/cli.py\nimport sys\nimport os\nimport logging\nfrom typing import List, NoReturn\n\nfrom .services import UnitDigitService\nfrom .controllers import MultiplyController\nfrom .repository import CalculationRepository, FileCalculationRepository\nfrom .exceptions import ValidationError\nfrom .utils import parse_int, DEFAULT_PERSISTENCE_PATH\nfrom .logging_config import configure_logging\nfrom .dto import ResultDTO\n\nlogger = logging.getLogger(__name__)\n\nclass CLI:\n    \"\"\"Command Line Interface for the unitmul application.\"\"\"\n    def __init__(self, controller: MultiplyController) -> None:\n        \"\"\"Initializes the CLI with a MultiplyController.\"\"\"\n        self.controller = controller\n\n    def _format_output(self, result: ResultDTO) -> str:\n        \"\"\"Formats the computation result for standard output.\"\"\"\n        return str(result.result)\n\n    def run(self, argv: List[str]) -> int:\n        \"\"\"Parses arguments, executes computation, and handles output/errors.\"\"\"\n        if len(argv) != 2:\n            print(\"Usage: unitmul <a> <b>\", file=sys.stderr)\n            return 2 # Exit code for incorrect usage\n\n        try:\n            a_str, b_str = argv[0], argv[1]\n            a = parse_int(a_str)\n            b = parse_int(b_str)\n\n            result_dto = self.controller.compute_and_persist(a, b)\n            print(self._format_output(result_dto))\n            return 0 # Success exit code\n        except ValidationError as e:\n            print(f\"Error: {e}. Both arguments must be integers.\", file=sys.stderr)\n            return 2 # Exit code for validation errors\n        except Exception as e:\n            logger.exception(\"An unexpected error occurred during CLI execution.\")\n            print(f\"An unexpected error occurred: {e}\", file=sys.stderr)\n            return 1 # Generic error exit code\n\ndef main() -> NoReturn:\n    \"\"\"Main entry point for the CLI console script.\"\"\"\n    configure_logging(level=os.getenv(\"UNITMUL_LOG_LEVEL\", \"INFO\"))\n\n    service = UnitDigitService()\n    repository: Optional[CalculationRepository] = None\n\n    persistence_path = os.getenv(\"UNITMUL_PERSIST_PATH\", DEFAULT_PERSISTENCE_PATH)\n    if persistence_path:\n        # Only initialize file repo if path is explicitly set or default path exists/is implied.\n        # For CLI, we can assume if env var is set, persistence is desired.\n        logger.info(f\"Persistence enabled to: {persistence_path}\")\n        repository = FileCalculationRepository(persistence_path)\n    else:\n        logger.info(\"Persistence disabled.\")\n\n    controller = MultiplyController(service, repository)\n    cli_app = CLI(controller)\n\n    # sys.argv[0] is the script name, we need actual arguments.\n    exit_code = cli_app.run(sys.argv[1:])\n    sys.exit(exit_code)\n\nif __name__ == \"__main__\":\n    main()\n```"}
{"task_id": "HumanEval/98", "solution": "```python\n# pyproject.toml\n\"\"\"\n[tool.poetry]\nname = \"countupper\"\nversion = \"0.1.0\"\ndescription = \"A library and tool to count uppercase vowels at even indices.\"\nauthors = [\"Your Name <you@example.com>\"]\nreadme = \"README.md\"\n\n[tool.poetry.dependencies]\npython = \"^3.9\"\n\n[tool.poetry.group.api.dependencies]\nflask = \"^2.0.0\"\n\n[tool.poetry.scripts]\ncountupper = \"countupper.cli:main\"\n\n[build-system]\nrequires = [\"poetry-core\"]\nbuild-backend = \"poetry.core.masonry.api\"\n\"\"\"\n```\n\n```python\n# README.md\n\"\"\"\n# Count Upper Vowels at Even Indices\n\nThis project provides a Python library, a command-line interface (CLI) tool, and an optional HTTP API to count uppercase vowels located at even indices in a given string.\n\n## Installation\n\n```bash\n# Basic library and CLI\npip install countupper\n\n# With HTTP API support\npip install \"countupper[api]\"\n```\n\n## Usage\n\n### Library\n\n```python\nfrom countupper import count_upper\n\ncount = count_upper(\"MyString\")\nprint(count) # Output: 2 (M, y, S, t, r, i, n, g; A at 0, 4)\n# (Correction based on spec: A, E, I, O, U are vowels. So 'MyString': M(0), y(1), S(2), t(3), r(4), i(5), n(6), g(7).\n#  M is not a vowel. S is not a vowel.\n#  The example in the problem description was count_upper('aBCdEf') returns 1 (C is not a vowel, E is a vowel at index 4)\n#  Let's re-evaluate \"MyString\":\n#  M (idx 0) - not a vowel.\n#  y (idx 1)\n#  S (idx 2) - not a vowel.\n#  t (idx 3)\n#  r (idx 4) - not a vowel.\n#  i (idx 5)\n#  n (idx 6) - not a vowel.\n#  g (idx 7)\n#  So count_upper(\"MyString\") would be 0.\n#  Let's use a better example. `count_upper(\"AbCdEfGHI\")` -> A(0), C(2), E(4), G(6), I(8).\n#  A, E, I are uppercase vowels at even indices. So 3.\n#  Example in spec was 'aBCdEf' -> 'E' at index 4. This matches.\n#  Example `count_upper('AaA')` -> A(0), A(2). Should be 2.\n```\n\n### CLI\n\n```bash\ncountupper \"MyStringExample\"\n# Output: 0\n\ncountupper \"AbCdEfGHI\"\n# Output: 3\n```\n\n### HTTP API (requires `[api]` extra)\n\n```bash\n# Run the API (e.g., with Flask's development server)\nFLASK_APP=countupper.api_controller:create_app FLASK_ENV=development flask run\n\n# Then, in another terminal:\ncurl -X POST -H \"Content-Type: application/json\" -d '{\"s\": \"AbCdEfGHI\"}' http://127.0.0.1:5000/count_upper\n# Output: {\"count\":3}\n```\n\"\"\"\n```\n\n```python\n# src/countupper/__init__.py\nfrom .validator import InputValidator\nfrom .string_analyzer import StringAnalyzer\nfrom .exceptions import CountUpperError\n\n# Initialize components for the top-level function.\n_validator = InputValidator()\n_analyzer = StringAnalyzer()\n\ndef count_upper(s: str) -> int:\n    \"\"\"\n    Counts uppercase vowels at even indices in a string.\n    This function delegates validation and analysis to internal components.\n    \"\"\"\n    _validator.validate(s)\n    return _analyzer.count_upper(s)\n```\n\n```python\n# src/countupper/string_analyzer.py\nclass StringAnalyzer:\n    \"\"\"\n    Implements the core algorithm for counting uppercase vowels at even indices.\n    This class performs the actual computation without input validation.\n    \"\"\"\n    UPPER_VOWELS = frozenset({\"A\", \"E\", \"I\", \"O\", \"U\"})\n\n    def __init__(self) -> None:\n        pass\n\n    def count_upper(self, s: str) -> int:\n        \"\"\"\n        Counts uppercase vowels (A, E, I, O, U) located at even indices (0-based) in the input string.\n        Assumes input 's' is a valid string.\n        \"\"\"\n        count = 0\n        for i, ch in enumerate(s):\n            if i % 2 == 0 and ch in self.UPPER_VOWELS:\n                count += 1\n        return count\n```\n\n```python\n# src/countupper/validator.py\nfrom typing import Any\nfrom .exceptions import CountUpperError\n\nclass InputValidator:\n    \"\"\"\n    Validates input for public APIs, ensuring type correctness.\n    It raises a specific error for invalid inputs.\n    \"\"\"\n    def __init__(self) -> None:\n        pass\n\n    def validate(self, s: Any) -> None:\n        \"\"\"\n        Checks if the input 's' is a string.\n        Raises CountUpperError if 's' is not a string.\n        \"\"\"\n        if not isinstance(s, str):\n            raise CountUpperError(\"Input must be a string\", code=400)\n```\n\n```python\n# src/countupper/dto.py\nclass InputDTO:\n    \"\"\"\n    Data Transfer Object for input string.\n    Holds the string 's' for clarity in data flow.\n    \"\"\"\n    def __init__(self, s: str) -> None:\n        self.s = s\n\nclass ResultDTO:\n    \"\"\"\n    Data Transfer Object for the computed count.\n    Holds the integer 'count' result.\n    \"\"\"\n    def __init__(self, count: int) -> None:\n        self.count = count\n```\n\n```python\n# src/countupper/exceptions.py\nclass CountUpperError(Exception):\n    \"\"\"\n    Custom exception for application-specific errors.\n    Includes a message and an optional HTTP-like status code.\n    \"\"\"\n    def __init__(self, message: str, code: int = 400) -> None:\n        super().__init__(message)\n        self.message = message\n        self.code = code\n```\n\n```python\n# src/countupper/cli_controller.py\nimport sys\nfrom .validator import InputValidator\nfrom .string_analyzer import StringAnalyzer\nfrom .exceptions import CountUpperError\nfrom .utils import parse_args\n\nclass CLIController:\n    \"\"\"\n    Orchestrates CLI operations: argument parsing, validation, computation, and output.\n    Returns appropriate exit codes based on success or error.\n    \"\"\"\n    def __init__(self, validator: InputValidator, analyzer: StringAnalyzer) -> None:\n        self._validator = validator\n        self._analyzer = analyzer\n\n    def run(self, argv: list[str]) -> int:\n        \"\"\"\n        Executes the CLI command using provided arguments.\n        Parses input, validates, computes, prints result, and handles errors.\n        \"\"\"\n        try:\n            opts = parse_args(argv)\n            s = opts[\"s\"]\n            self._validator.validate(s)\n            count = self._analyzer.count_upper(s)\n            print(count)\n            return 0\n        except CountUpperError as e:\n            print(f\"Error: {e.message}\", file=sys.stderr)\n            return 2\n        except Exception as e:\n            print(f\"Unexpected error: {e}\", file=sys.stderr)\n            # Potentially log stack trace here in a real app\n            return 1\n```\n\n```python\n# src/countupper/api_controller.py\nfrom flask import Flask, request, jsonify\nfrom .validator import InputValidator\nfrom .string_analyzer import StringAnalyzer\nfrom .exceptions import CountUpperError\n\nclass APIController:\n    \"\"\"\n    Manages the HTTP API, creating a Flask application.\n    It sets up endpoints to expose the counting functionality over HTTP.\n    \"\"\"\n    def __init__(self, validator: InputValidator, analyzer: StringAnalyzer) -> None:\n        self._validator = validator\n        self._analyzer = analyzer\n\n    def create_app(self) -> Flask:\n        \"\"\"\n        Creates and configures a Flask application instance.\n        Defines the /count_upper POST endpoint for counting.\n        \"\"\"\n        app = Flask(__name__)\n\n        @app.route(\"/count_upper\", methods=[\"POST\"])\n        def count_upper_route():\n            data = request.get_json(force=True, silent=True)\n            if not data or \"s\" not in data:\n                return jsonify({\"error\": \"missing 's' field in JSON body\"}), 400\n            try:\n                s = data[\"s\"]\n                self._validator.validate(s)\n                result = self._analyzer.count_upper(s)\n                return jsonify({\"count\": result}), 200\n            except CountUpperError as e:\n                return jsonify({\"error\": e.message}), 400\n            except Exception:\n                # Log the exception for internal debugging\n                return jsonify({\"error\": \"internal error\"}), 500\n        return app\n```\n\n```python\n# src/countupper/cli.py\nimport sys\nfrom .cli_controller import CLIController\nfrom .validator import InputValidator\nfrom .string_analyzer import StringAnalyzer\n\ndef main(argv: list[str] | None = None) -> int:\n    \"\"\"\n    Entrypoint for the command-line interface.\n    Initializes components and runs the CLI controller.\n    \"\"\"\n    argv = argv if argv is not None else sys.argv\n    controller = CLIController(InputValidator(), StringAnalyzer())\n    rc = controller.run(argv)\n    sys.exit(rc) # Exit with the return code from the controller\n```\n\n```python\n# src/countupper/utils.py\nfrom .exceptions import CountUpperError\n\ndef parse_args(argv: list[str]) -> dict[str, str]:\n    \"\"\"\n    Parses command-line arguments expecting a single string.\n    The program name is expected at argv[0], and the input string at argv[1].\n    \"\"\"\n    # Expects argv like [\"program_name\", \"input_string\"]\n    if len(argv) < 2:\n        raise CountUpperError(\"Missing required input string argument\", code=400)\n    return {\"s\": argv[1]}\n```\n\n```python\n# tools/ci/python-app.yml\n\"\"\"\n# .github/workflows/python-app.yml\nname: Python application\n\non:\n  push:\n    branches: [ \"main\" ]\n  pull_request:\n    branches: [ \"main\" ]\n\njobs:\n  build:\n    runs-on: ubuntu-latest\n\n    steps:\n    - uses: actions/checkout@v3\n    - name: Set up Python 3.9\n      uses: actions/setup-python@v3\n      with:\n        python-version: \"3.9\"\n    - name: Install dependencies\n      run: |\n        python -m pip install poetry\n        poetry install --with api\n    - name: Lint with flake8\n      run: |\n        # poetry run flake8 . --count --select=E9,F63,F7,F82 --show-source --statistics\n        # poetry run flake8 . --count --exit-zero --max-complexity=10 --max-line-length=127 --statistics\n        echo \"Flake8 linting skipped for this example, add your linting commands here.\"\n    - name: Run tests\n      run: |\n        # This step is commented out as per \"DO NOT write unit tests\" instruction,\n        # but would typically be `poetry run pytest`.\n        echo \"Tests are not run as per instructions.\"\n\"\"\"\n```"}
{"task_id": "HumanEval/99", "solution": "```python\nfrom decimal import Decimal, ROUND_FLOOR, ROUND_CEILING\n\ndef closest_integer(value):\n    \"\"\"\n    Returns the closest integer to a numeric string, rounding away from zero for half values.\n    Uses Decimal for precise calculations to handle fractional parts correctly.\n    \"\"\"\n    s = value.strip()\n    dec_value = Decimal(s)\n\n    if dec_value == 0:\n        return 0\n\n    floor_val = dec_value.to_integral_value(rounding=ROUND_FLOOR)\n    ceil_val = dec_value.to_integral_value(rounding=ROUND_CEILING)\n\n    dist_floor = abs(dec_value - floor_val)\n    dist_ceil = abs(ceil_val - dec_value)\n\n    if dist_floor < dist_ceil:\n        return int(floor_val)\n    elif dist_ceil < dist_floor:\n        return int(ceil_val)\n    else:  # Equidistant, round away from zero\n        return int(ceil_val) if dec_value > 0 else int(floor_val)\n\n```"}
{"task_id": "HumanEval/99", "solution": "```python\ndef closest_integer(value):\n    '''\n    Create a function that takes a value (string) representing a number\n    and returns the closest integer to it. If the number is equidistant\n    from two integers, round it away from zero.\n    '''\n    from decimal import Decimal, getcontext, ROUND_HALF_UP, ROUND_HALF_DOWN\n\n    # Set Decimal context precision to ensure accurate parsing and calculations.\n    getcontext().prec = 50\n\n    # Parse the input string into a Decimal, first stripping any leading/trailing whitespace.\n    decimal_value = Decimal(value.strip())\n\n    # Apply the rounding rule: ties (.5) are rounded away from zero.\n    if decimal_value >= 0:\n        # For positive numbers, ROUND_HALF_UP rounds .5 ties upwards, which is away from zero.\n        rounded_decimal = decimal_value.quantize(Decimal('1'), rounding=ROUND_HALF_UP)\n    else:\n        # For negative numbers, ROUND_HALF_DOWN rounds .5 ties downwards, which is away from zero.\n        rounded_decimal = decimal_value.quantize(Decimal('1'), rounding=ROUND_HALF_DOWN)\n\n    return int(rounded_decimal)\n\n```"}
