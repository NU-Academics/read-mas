{"task_id": "HumanEval/134", "solution": "def check_if_last_char_is_a_letter(txt):\n    \"\"\"\n    Checks if the last character of a string is an alphabetical character\n    and is not part of a word, after trimming trailing newlines.\n    \"\"\"\n    # Trim trailing newline characters as specified in FR1.\n    processed_txt = txt.rstrip('\\n')\n\n    if not processed_txt:\n        return False\n\n    last_char = processed_txt[-1]\n\n    # The last character must be an alphabetical letter.\n    if not last_char.isalpha():\n        return False\n\n    # If the string has only one character and it's a letter, it stands alone.\n    if len(processed_txt) == 1:\n        return True\n\n    # Check the character immediately preceding the last character.\n    # If it's a space, the last letter is separated and thus not part of a word.\n    second_last_char = processed_txt[-2]\n    return second_last_char == ' '"}
{"task_id": "HumanEval/135", "solution": "def can_arrange(arr: list[int]) -> int:\n    \"\"\"Returns the largest index of an element where arr[i] < arr[i-1].\n    Returns -1 if no such element exists, as per the problem description.\n    \"\"\"\n    if len(arr) < 2:\n        return -1\n    # Scan from right to left to find the largest index i where arr[i] < arr[i-1].\n    for i in range(len(arr) - 1, 0, -1):\n        if arr[i] < arr[i - 1]:\n            return i\n    return -1"}
{"task_id": "HumanEval/134", "solution": "def check_if_last_char_is_a_letter(txt):\n    \"\"\"\n    Returns True if the last character is an alphabetic char and not part of a word.\n    Words are space-separated; trailing spaces result in False.\n    \"\"\"\n    if not txt:\n        return False\n    if txt[-1].isspace():\n        return False\n\n    # Helper function to check if a character is an ASCII letter.\n    def _is_alpha_char(char):\n        return 'a' <= char <= 'z' or 'A' <= char <= 'Z'\n\n    # Find the last token (characters after the last space, or the whole string if no space).\n    last_space_idx = txt.rfind(' ')\n    if last_space_idx == -1:\n        token = txt\n    else:\n        token = txt[last_space_idx + 1:]\n\n    # Check if the token is a single character and that character is alphabetic.\n    return len(token) == 1 and _is_alpha_char(token[0])"}
{"task_id": "HumanEval/136", "solution": "def largest_smallest_integers(lst):\n    '''\n    Create a function that returns a tuple (a, b), where 'a' is\n    the largest of negative integers, and 'b' is the smallest\n    of positive integers in a list. If there is no negative or positive integers, return them as None.\n    '''\n    largest_neg = None\n    smallest_pos = None\n\n    for n in lst:\n        if n < 0:\n            if largest_neg is None or n > largest_neg:\n                largest_neg = n\n        elif n > 0:\n            if smallest_pos is None or n < smallest_pos:\n                smallest_pos = n\n\n    return (largest_neg, smallest_pos)"}
{"task_id": "HumanEval/137", "solution": "def compare_one(a, b):\n    \"\"\"\n    Compares two values (int, float, or numeric string) and returns the larger,\n    preserving original type and formatting. Returns None if values are numerically equal.\n    \"\"\"\n\n    DEFAULT_EPSILON = 1e-12\n\n    def _normalize_and_convert_to_float(value_item):\n        \"\"\"Internal helper to convert a single value to its float representation for comparison.\"\"\"\n        if isinstance(value_item, (int, float)):\n            return float(value_item)\n        elif isinstance(value_item, str):\n            # Normalize decimal separator: replace comma with dot.\n            s_normalized = value_item.strip().replace(',', '.')\n            return float(s_normalized)\n        return float(value_item) # Fallback attempt for other types, letting float() handle errors.\n\n    val_a_numeric = _normalize_and_convert_to_float(a)\n    val_b_numeric = _normalize_and_convert_to_float(b)\n\n    if abs(val_a_numeric - val_b_numeric) <= DEFAULT_EPSILON:\n        return None\n\n    if val_a_numeric > val_b_numeric:\n        return a\n    else:\n        return b"}
{"task_id": "HumanEval/137", "solution": "```python\nfrom decimal import Decimal\n\ndef compare_one(a, b):\n    \"\"\"\n    Compares two numbers (int, float, or string representations) and returns the larger\n    operand preserving its original type, or None if they are numerically equal.\n    \"\"\"\n    # Helper function defined inline within the main function, as per critical requirement.\n    # It converts the input value to its original form and a Decimal for comparison.\n    def _parse_single_value(value):\n        if isinstance(value, int):\n            return value, Decimal(value)\n        elif isinstance(value, float):\n            # Floats are converted via str() to Decimal for deterministic precision.\n            return value, Decimal(str(value))\n        elif isinstance(value, str):\n            # String normalization: strip whitespace and replace comma with dot.\n            s_normalized = value.strip().replace(\",\", \".\")\n            return value, Decimal(s_normalized)\n        # Per critical requirements, explicit type guards or error raising for unsupported\n        # types or invalid string formats are omitted; standard library exceptions may propagate.\n\n    original_a, numeric_a = _parse_single_value(a)\n    original_b, numeric_b = _parse_single_value(b)\n\n    if numeric_a > numeric_b:\n        return original_a\n    elif numeric_b > numeric_a:\n        return original_b\n    else: # numeric_a == numeric_b\n        return None\n```"}
{"task_id": "HumanEval/136", "solution": "```\n.\n\u251c\u2500\u2500 src/\n\u2502   \u2514\u2500\u2500 numutils/\n\u2502       \u251c\u2500\u2500 __init__.py\n\u2502       \u251c\u2500\u2500 config.py\n\u2502       \u251c\u2500\u2500 models.py\n\u2502       \u251c\u2500\u2500 exceptions.py\n\u2502       \u251c\u2500\u2500 validators.py\n\u2502       \u251c\u2500\u2500 services.py\n\u2502       \u251c\u2500\u2500 controllers.py\n\u2502       \u251c\u2500\u2500 cli.py\n\u2502       \u2514\u2500\u2500 client.py\n\u251c\u2500\u2500 pyproject.toml\n\u251c\u2500\u2500 README.md\n\u251c\u2500\u2500 LICENSE\n\u2514\u2500\u2500 .gitignore\n```\n\n**`src/numutils/__init__.py`**\n```python\n\"\"\"\nnumutils package: Provides utilities for numerical analysis.\nExposes the largest_smallest_integers function at the package root.\n\"\"\"\n\nfrom .controllers import APIController\nfrom .exceptions import NumUtilsError, InvalidInputError\nfrom typing import Sequence, Tuple, Optional\n\n# Initialize a default controller for direct package usage\n_default_controller = APIController()\n\ndef largest_smallest_integers(numbers: Sequence[object]) -> Tuple[Optional[int], Optional[int]]:\n    \"\"\"\n    Computes the largest negative and smallest positive integers from a sequence.\n    Raises InvalidInputError for non-sequence input or non-integer elements.\n    \"\"\"\n    return _default_controller.largest_smallest_integers(numbers)\n```\n\n**`src/numutils/config.py`**\n```python\n\"\"\"\nConfiguration constants for the numutils package.\nIncludes package metadata and CLI exit codes.\n\"\"\"\n\nPACKAGE_NAME: str = \"numutils\"\nVERSION: str = \"0.1.0\"\nEXIT_SUCCESS: int = 0\nEXIT_FAILURE: int = 2\n```\n\n**`src/numutils/models.py`**\n```python\n\"\"\"\nDomain models for numerical analysis results.\nDefines IntegerAnalysisResult to structure the computed output.\n\"\"\"\n\nfrom dataclasses import dataclass\nfrom typing import Optional, Tuple\n\n@dataclass(frozen=True)\nclass IntegerAnalysisResult:\n    \"\"\"\n    Represents the result of an integer analysis, holding the largest negative\n    and smallest positive integers found.\n    \"\"\"\n    largest_negative: Optional[int]\n    smallest_positive: Optional[int]\n\n    def as_tuple(self) -> Tuple[Optional[int], Optional[int]]:\n        \"\"\"\n        Returns the analysis results as a simple tuple (largest_negative, smallest_positive).\n        \"\"\"\n        return (self.largest_negative, self.smallest_positive)\n```\n\n**`src/numutils/exceptions.py`**\n```python\n\"\"\"\nCustom exception types for the numutils package.\nProvides structured errors for invalid inputs.\n\"\"\"\n\nfrom typing import Any, Optional\n\nclass NumUtilsError(Exception):\n    \"\"\"Base exception for all errors in the numutils package.\"\"\"\n    pass\n\nclass InvalidInputError(NumUtilsError):\n    \"\"\"\n    Raised when input validation fails, providing details about the invalid value.\n    Contains the original invalid value and a descriptive message.\n    \"\"\"\n    def __init__(self, value: Any, message: Optional[str] = None) -> None:\n        self.value = value\n        self.message = message if message is not None else f\"Invalid input: {value!r}\"\n        super().__init__(self.message)\n\n    def __str__(self) -> str:\n        \"\"\"Returns a string representation including the message and invalid value.\"\"\"\n        return f\"{self.message} (Value: {self.value!r})\"\n```\n\n**`src/numutils/validators.py`**\n```python\n\"\"\"\nInput validation utilities for the numutils package.\nEnsures inputs conform to expected types and structures.\n\"\"\"\n\nfrom typing import Sequence, Any\nfrom collections.abc import Sequence as SeqABC\nfrom .exceptions import InvalidInputError\n\nclass InputValidator:\n    \"\"\"\n    Provides methods to validate various types of inputs, specifically sequences of integers.\n    This class is stateless and focuses solely on input integrity checks.\n    \"\"\"\n    def validate_sequence(self, numbers: Sequence[Any]) -> Sequence[int]:\n        \"\"\"\n        Validates that the input is a sequence and all its elements are integers.\n        Raises InvalidInputError if the input is not a sequence or contains non-integer elements.\n        \"\"\"\n        if not isinstance(numbers, SeqABC):\n            raise InvalidInputError(numbers, \"Input must be a sequence (e.g., list or tuple).\")\n\n        for i, v in enumerate(numbers):\n            if not isinstance(v, int):\n                # Specific error for non-integer elements, even if convertible from string\n                raise InvalidInputError(v, f\"Element at index {i} is not an integer: {v!r}. \"\n                                           \"Only strict integers are accepted.\")\n        return numbers  # type: ignore[return-value] # Validated elements are ints, so this cast is safe.\n```\n\n**`src/numutils/services.py`**\n```python\n\"\"\"\nCore business logic services for numerical analysis.\nContains IntegerAnalyzer to perform the main computation.\n\"\"\"\n\nfrom typing import Sequence, Optional\nfrom .models import IntegerAnalysisResult\n\nclass IntegerAnalyzer:\n    \"\"\"\n    Performs the core algorithm to find the largest negative and smallest positive\n    integers within a given sequence.\n    \"\"\"\n    def find_largest_negative_smallest_positive(self, numbers: Sequence[int]) -> IntegerAnalysisResult:\n        \"\"\"\n        Implements a single-pass O(n) algorithm to identify the largest negative\n        and smallest positive integers in a sequence. Zeros are ignored.\n        \"\"\"\n        largest_negative: Optional[int] = None\n        smallest_positive: Optional[int] = None\n\n        for x in numbers:\n            if x < 0:\n                if (largest_negative is None) or (x > largest_negative):\n                    largest_negative = x\n            elif x > 0:\n                if (smallest_positive is None) or (x < smallest_positive):\n                    smallest_positive = x\n        \n        return IntegerAnalysisResult(largest_negative, smallest_positive)\n```\n\n**`src/numutils/controllers.py`**\n```python\n\"\"\"\nAPI layer for the numutils package.\nExposes the public function and orchestrates validation and service calls.\n\"\"\"\n\nfrom typing import Sequence, Tuple, Optional, Any\nfrom .validators import InputValidator\nfrom .services import IntegerAnalyzer\nfrom .exceptions import InvalidInputError\n\nclass APIController:\n    \"\"\"\n    Provides the public API function largest_smallest_integers.\n    It orchestrates input validation and delegates the core computation to IntegerAnalyzer.\n    \"\"\"\n    def __init__(self, validator: Optional[InputValidator] = None, analyzer: Optional[IntegerAnalyzer] = None):\n        \"\"\"\n        Initializes the APIController with optional dependencies for validation and analysis.\n        Uses default implementations if none are provided, facilitating dependency injection.\n        \"\"\"\n        self._validator = validator or InputValidator()\n        self._analyzer = analyzer or IntegerAnalyzer()\n\n    def largest_smallest_integers(self, numbers: Sequence[Any]) -> Tuple[Optional[int], Optional[int]]:\n        \"\"\"\n        Finds the largest negative and smallest positive integers in the given sequence.\n        Validates the input and uses the IntegerAnalyzer service for computation.\n        \"\"\"\n        # 1. Validate input sequence and its elements\n        validated_numbers = self._validator.validate_sequence(numbers)\n\n        # 2. Compute the result using the analyzer service\n        result = self._analyzer.find_largest_negative_smallest_positive(validated_numbers)\n\n        # 3. Return the result as a tuple\n        return result.as_tuple()\n```\n\n**`src/numutils/cli.py`**\n```python\n\"\"\"\nCommand-Line Interface (CLI) for the numutils package.\nParses arguments, calls the API, and prints results or error messages.\n\"\"\"\n\nimport argparse\nimport sys\nfrom typing import List, Optional\n\nfrom .controllers import APIController\nfrom .exceptions import InvalidInputError\nfrom .config import PACKAGE_NAME, EXIT_SUCCESS, EXIT_FAILURE\n\nclass CLI:\n    \"\"\"\n    CLI interface for the numutils package.\n    Handles command-line argument parsing, calls the API, and manages output/exit codes.\n    \"\"\"\n    def __init__(self, controller: Optional[APIController] = None) -> None:\n        \"\"\"\n        Initializes the CLI with an optional APIController instance for dependency injection.\n        \"\"\"\n        self._controller = controller or APIController()\n\n    def _parse_args(self, argv: Optional[List[str]]) -> argparse.Namespace:\n        \"\"\"\n        Parses command-line arguments using argparse.\n        Sets up argument parsing for space-separated integers.\n        \"\"\"\n        parser = argparse.ArgumentParser(\n            prog=f\"{PACKAGE_NAME}-largest-smallest\",\n            description=\"Finds the largest negative and smallest positive integers in a list.\"\n        )\n        parser.add_argument(\n            \"integers\",\n            metavar=\"INT\",\n            type=str,  # Read as string, validation happens in APIController\n            nargs=\"*\",\n            help=\"Space-separated integers to analyze.\"\n        )\n        return parser.parse_args(argv)\n\n    def run(self, argv: Optional[List[str]] = None) -> int:\n        \"\"\"\n        Main entry point for the CLI.\n        Parses arguments, invokes the API, and prints results or error messages.\n        \"\"\"\n        args = self._parse_args(argv)\n\n        try:\n            # Attempt to convert CLI string arguments to integers.\n            # This step *must* happen here as the APIController's validator\n            # expects actual int types, not string representations of ints.\n            # If conversion fails, it's an InvalidInputError, handled below.\n            numbers_as_int = []\n            for i, s_val in enumerate(args.integers):\n                try:\n                    numbers_as_int.append(int(s_val))\n                except ValueError:\n                    raise InvalidInputError(s_val, f\"CLI argument at position {i} is not a valid integer: {s_val!r}.\")\n\n            largest_negative, smallest_positive = self._controller.largest_smallest_integers(numbers_as_int)\n            print(f\"({largest_negative}, {smallest_positive})\")\n            return EXIT_SUCCESS\n        except InvalidInputError as e:\n            print(f\"Error: {e.message}\", file=sys.stderr)\n            return EXIT_FAILURE\n        except Exception as e:\n            print(f\"An unexpected error occurred: {e}\", file=sys.stderr)\n            return EXIT_FAILURE\n\ndef main_cli_entrypoint():\n    \"\"\"Entry point for the numutils-largest-smallest CLI command.\"\"\"\n    sys.exit(CLI().run())\n\nif __name__ == \"__main__\":\n    main_cli_entrypoint()\n```\n\n**`src/numutils/client.py`**\n```python\n\"\"\"\nExample client helper for the numutils package.\nDemonstrates programmatic usage of the API.\n\"\"\"\n\nfrom typing import Sequence, Tuple, Optional\nfrom .controllers import APIController\n\nclass Client:\n    \"\"\"\n    A simple client class to demonstrate how to programmatically interact\n    with the numutils APIController.\n    \"\"\"\n    def __init__(self, controller: Optional[APIController] = None) -> None:\n        \"\"\"\n        Initializes the client, optionally with a pre-configured APIController.\n        \"\"\"\n        self._controller = controller or APIController()\n\n    def call_api(self, numbers: Sequence[int]) -> Tuple[Optional[int], Optional[int]]:\n        \"\"\"\n        Calls the largest_smallest_integers method from the APIController.\n        Returns a tuple of (largest_negative, smallest_positive).\n        \"\"\"\n        return self._controller.largest_smallest_integers(numbers)\n\n```\n\n**`pyproject.toml`**\n```toml\n[build-system]\nrequires = [\"setuptools>=61.0\"]\nbuild-backend = \"setuptools.build_meta\"\n\n[project]\nname = \"numutils\"\nversion = \"0.1.0\"\ndescription = \"A small Python library to find largest negative and smallest positive integers.\"\nreadme = \"README.md\"\nauthors = [{ name = \"Your Name\", email = \"your.email@example.com\" }]\nlicense = { file = \"LICENSE\" }\nrequires-python = \">=3.8\"\nkeywords = [\"utility\", \"integers\", \"math\"]\nclassifiers = [\n    \"Programming Language :: Python :: 3\",\n    \"License :: OSI Approved :: MIT License\",\n    \"Operating System :: OS Independent\",\n    \"Development Status :: 3 - Alpha\",\n    \"Intended Audience :: Developers\",\n    \"Topic :: Software Development :: Libraries :: Python Modules\",\n    \"Topic :: Utilities\",\n]\n\n[project.urls]\nHomepage = \"https://github.com/yourusername/numutils\"\n\"Bug Tracker\" = \"https://github.com/yourusername/numutils/issues\"\n\n[project.scripts]\nnumutils-largest-smallest = \"numutils.cli:main_cli_entrypoint\"\n\n[tool.setuptools.packages.find]\nwhere = [\"src\"]\n```\n\n**`README.md`**\n```markdown\n# NumUtils\n\nA small Python library that provides a utility function to compute the largest negative\nand smallest positive integers from a list of numbers.\n\n## Features\n\n- **Programmatic API**: A simple Python function `largest_smallest_integers(lst)` for easy integration.\n- **Command-Line Interface (CLI)**: Quickly run the utility from your terminal.\n- **Robust Input Validation**: Helpful errors for invalid input types.\n- **Efficient**: O(n) time complexity and O(1) space complexity.\n\n## Installation\n\n```bash\npip install numutils\n```\n(Note: This package name might be taken on PyPI. For local development, you can use `pip install .` in the project root.)\n\n## Usage\n\n### Programmatic API\n\n```python\nfrom numutils import largest_smallest_integers, InvalidInputError\n\n# Example 1: Mixed numbers\nresult = largest_smallest_integers([3, -1, 0, 5, -2, 10, -7])\nprint(f\"Mixed list: {result}\")  # Output: Mixed list: (-1, 3)\n\n# Example 2: Only positive numbers\nresult = largest_smallest_integers([2, 4, 1, 3, 5, 7])\nprint(f\"All positive: {result}\") # Output: All positive: (None, 1)\n\n# Example 3: Only negative numbers\nresult = largest_smallest_integers([-5, -1, -3])\nprint(f\"All negative: {result}\") # Output: All negative: (-1, None)\n\n# Example 4: Empty list\nresult = largest_smallest_integers([])\nprint(f\"Empty list: {result}\")   # Output: Empty list: (None, None)\n\n# Example 5: List with only zeros\nresult = largest_smallest_integers([0, 0, 0])\nprint(f\"Only zeros: {result}\")   # Output: Only zeros: (None, None)\n\n# Example 6: Input validation\ntry:\n    largest_smallest_integers([1, \"a\", 3])\nexcept InvalidInputError as e:\n    print(f\"Error: {e}\") # Output: Error: Element at index 1 is not an integer: 'a'. Only strict integers are accepted. (Value: 'a')\n\ntry:\n    largest_smallest_integers(\"not a list\")\nexcept InvalidInputError as e:\n    print(f\"Error: {e}\") # Output: Error: Input must be a sequence (e.g., list or tuple). (Value: 'not a list')\n```\n\n### Command-Line Interface (CLI)\n\nInstall the package, then use the `numutils-largest-smallest` command:\n\n```bash\n# Example 1: Mixed numbers\nnumutils-largest-smallest 3 -1 0 5 -2 10 -7\n# Output: (-1, 3)\n\n# Example 2: Only positive numbers\nnumutils-largest-smallest 2 4 1 3 5 7\n# Output: (None, 1)\n\n# Example 3: Invalid input (non-integer argument)\nnumutils-largest-smallest 1 a 3\n# Output (to stderr): Error: CLI argument at position 1 is not a valid integer: 'a'.\n# Exit code: 2\n\n# Example 4: No arguments\nnumutils-largest-smallest\n# Output: (None, None)\n```\n\n## Development\n\nTo set up the project for development:\n\n1. Clone the repository:\n   ```bash\n   git clone https://github.com/yourusername/numutils.git\n   cd numutils\n   ```\n2. Create and activate a virtual environment:\n   ```bash\n   python -m venv .venv\n   source .venv/bin/activate  # On Windows: .