{"task_id": "HumanEval/75", "solution": "```python\ndef is_multiply_prime(a):\n    \"\"\"Checks if a number is the product of exactly three prime numbers, counting multiplicity.\n    Assumes input 'a' is an integer in the range [0, 100).\n    \"\"\"\n\n    if a < 2:\n        return False\n\n    factors = []\n    n = a\n    d = 2\n    while d * d <= n:\n        while n % d == 0:\n            factors.append(d)\n            n //= d\n        d += 1 if d == 2 else 2\n    if n > 1:\n        factors.append(n)\n\n    return len(factors) == 3\n```"}
{"task_id": "HumanEval/75", "solution": "def is_multiply_prime(a):\n    \"\"\"Checks if a number is the product of exactly three prime numbers.\n    Assumes a is an integer between 1 and 99, inclusive.\n    \"\"\"\n\n    def _factorize(n):\n        \"\"\"Returns a list of prime factors for a given number, including multiplicity.\n        This helper is suitable for small n.\n        \"\"\"\n        factors = []\n        d = 2\n        temp_n = n\n        while d * d <= temp_n:\n            while temp_n % d == 0:\n                factors.append(d)\n                temp_n //= d\n            d += 1\n        if temp_n > 1:\n            factors.append(temp_n)\n        return factors\n\n    prime_factors = _factorize(a)\n    return len(prime_factors) == 3"}
{"task_id": "HumanEval/76", "solution": "def is_simple_power(x, n):\n    \"\"\"Checks if x is a simple power of n (n**k == x for k >= 0).\n    Handles edge cases for n=0, n=1, x=1, and negative bases as specified.\"\"\"\n    # Handle n = 0\n    if n == 0:\n        return x == 0\n    \n    # Handle n = 1\n    if n == 1:\n        return x == 1\n    \n    # Handle x = 1 (n**0 is 1 for any n != 0)\n    if x == 1:\n        return True\n\n    # If x is 0 at this point, it cannot be a power of n (since n is not 0 or 1).\n    if x == 0:\n        return False\n\n    # Handle negative base n\n    if n < 0:\n        temp_x = x\n        abs_n = -n\n        k_count = 0\n        \n        # Check if abs(x) is a power of abs(n)\n        if abs(temp_x) < abs_n and abs(temp_x) != 1: # Optimization: if x is smaller than n, it can only be 1 (already handled)\n            return False\n            \n        if abs(temp_x) == 0: # Already handled x==0 above\n            return False\n\n        while abs(temp_x) > 1 and abs(temp_x) % abs_n == 0:\n            temp_x //= abs_n\n            k_count += 1\n            \n        if abs(temp_x) != 1:\n            return False # abs(x) is not a power of abs(n)\n        \n        # Check parity of k for sign matching\n        if x > 0: # x must be positive if k is even\n            return k_count % 2 == 0\n        else: # x must be negative if k is odd\n            return k_count % 2 == 1\n\n    # Handle positive base n > 1\n    # For n > 1, n**k is always positive for k >= 0. So x must be positive.\n    if x < 0:\n        return False\n\n    # Repeated division for positive x and positive n > 1\n    while x > 1 and x % n == 0:\n        x //= n\n    return x == 1\n\n```"}
{"task_id": "HumanEval/76", "solution": "```python\ndef is_simple_power(x, n):\n    \"\"\"Checks if x is a simple power of n (n**k == x for some integer k >= 0).\n    Assumes integer inputs for x and n.\n    \"\"\"\n    if x == 1:\n        # Any non-zero n raised to the power of 0 is 1. Python's pow(0, 0) also evaluates to 1.\n        return True\n\n    if n == 0:\n        # If n is 0, only 0**k (k > 0) can be 0. x=1 is handled above (0**0 = 1).\n        return x == 0\n\n    if n == 1:\n        # If n is 1, 1**k is always 1. x=1 is handled above. If x != 1, it's not a power.\n        return x == 1\n\n    if n == -1:\n        # If n is -1, then (-1)**k can only be 1 or -1. x=1 is handled above.\n        return x == -1\n\n    # For other bases n (n >= 2 or n <= -2), repeatedly divide x by n.\n    current_x = x\n    \n    if n > 0: # n is 2 or greater\n        while current_x > 1 and current_x % n == 0:\n            current_x //= n\n        return current_x == 1\n    \n    else: # n is -2 or smaller\n        # For negative bases, the sign of current_x will alternate.\n        # The loop continues as long as the absolute value is greater than 1 and divisible by n.\n        while abs(current_x) > 1 and current_x % n == 0:\n            current_x //= n\n        return current_x == 1\n\n```"}
{"task_id": "HumanEval/77", "solution": "def iscube(a):\n    \"\"\"\n    Checks if an integer 'a' is a perfect cube.\n    Uses binary search for the integer cube root.\n    \"\"\"\n    if a == 0:\n        return True\n\n    sign = 1 if a >= 0 else -1\n    n = abs(a)\n\n    lo = 0\n    hi = max(1, int(n.bit_length() // 3 + 2) * 2)\n    while hi * hi * hi < n:\n        hi *= 2\n\n    while lo <= hi:\n        mid = (lo + hi) // 2\n        cube = mid * mid * mid\n        if cube == n:\n            return True\n        if cube < n:\n            lo = mid + 1\n        else:\n            hi = mid - 1\n    \n    # After loop, hi is the largest integer whose cube is <= n.\n    # Check if this hi's cube perfectly matches n.\n    return hi * hi * hi == n"}
{"task_id": "HumanEval/77", "solution": "```python\ndef iscube(a):\n    \"\"\"\n    Checks if an integer is a perfect cube.\n    Uses integer cube root calculation to avoid float inaccuracies.\n    \"\"\"\n\n    def _integer_cube_root(n: int) -> int:\n        \"\"\"Computes the integer cube root of n, preserving its sign.\n        Uses binary search for efficient and accurate integer arithmetic.\n        \"\"\"\n        if n == 0:\n            return 0\n        \n        sign = 1 if n > 0 else -1\n        abs_n = abs(n)\n        \n        # Binary search for the integer cube root of abs_n\n        low, high = 0, abs_n\n        while low <= high:\n            mid = (low + high) // 2\n            mid_cubed = mid * mid * mid\n            \n            if mid_cubed == abs_n:\n                return sign * mid\n            elif mid_cubed < abs_n:\n                low = mid + 1\n            else:\n                high = mid - 1\n        \n        # After loop, 'high' will be the integer floor of the cube root of abs_n\n        # (or ceil towards zero for negative numbers when sign is applied).\n        return sign * high\n\n    # Get the integer cube root of 'a'\n    root = _integer_cube_root(a)\n    \n    # Check if the cube of this integer root exactly matches the original number.\n    return root * root * root == a\n```"}
