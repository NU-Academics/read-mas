{"task_id": "Mbpp/589", "solution": "import math\n\nclass InvalidRangeError(ValueError):\n    \"\"\"Custom exception raised for invalid input ranges.\"\"\"\n    pass\n\ndef perfect_squares(lower: int, upper: int) -> list[int]:\n    \"\"\"\n    Finds all perfect squares within an inclusive integer range [lower, upper].\n    Raises InvalidRangeError if the range is invalid (lower > upper or negative bounds).\n    \"\"\"\n    if lower > upper:\n        raise InvalidRangeError(\"Lower bound cannot be greater than upper bound.\")\n    if lower < 0 or upper < 0:\n        raise InvalidRangeError(\"Both lower and upper bounds must be non-negative.\")\n\n    squares = []\n    # Iterate through potential roots from 0 up to the integer square root of the upper bound.\n    for i in range(math.isqrt(upper) + 1):\n        square = i * i\n        if square >= lower:\n            squares.append(square)\n    return squares"}
{"task_id": "Mbpp/591", "solution": "from typing import List\n\ndef swap_List(input_list: List) -> List:\n    \"\"\"\n    Returns a new list with the first and last elements interchanged.\n    The original list remains unchanged.\n    \"\"\"\n    if len(input_list) < 2:\n        return input_list[:]  # Return a shallow copy for lists with less than two elements\n\n    new_list = input_list[:]  # Create a shallow copy to avoid modifying the original list\n    new_list[0], new_list[-1] = new_list[-1], new_list[0]\n    return new_list"}
{"task_id": "Mbpp/592", "solution": "class BinomialCoefficientCalculator:\n    @staticmethod\n    def binomial(n: int, k: int) -> int:\n        \"\"\"Compute C(n, k) without external libraries.\"\"\"\n        if k < 0 or k > n:\n            return 0\n        if k == 0 or k == n:\n            return 1\n        k = min(k, n - k)\n        result = 1\n        for i in range(1, k + 1):\n            result = result * (n - k + i) // i\n        return result\n\n\nclass SumOfProductCalculator:\n    def compute(self, n: int) -> int:\n        \"\"\"Compute \u03a3_{k=0}^{n-1} C(n,k) * C(n,k+1).\"\"\"\n        if n == 0:\n            return 0\n        total = 0\n        for k in range(n):\n            c1 = BinomialCoefficientCalculator.binomial(n, k)\n            c2 = BinomialCoefficientCalculator.binomial(n, k + 1)\n            total += c1 * c2\n        return total\n\n\ndef sum_Of_product(n: int) -> int:\n    \"\"\"Public API to find the sum of the product of consecutive binomial co-efficients.\"\"\"\n    if not isinstance(n, int):\n        raise ValueError(\"n must be an integer\")\n    if n < 0:\n        raise ValueError(\"n must be non\u2011negative\")\n    calculator = SumOfProductCalculator()\n    return calculator.compute(n)"}
{"task_id": "Mbpp/593", "solution": "from dataclasses import dataclass\nfrom typing import List\n\n@dataclass\nclass Octet:\n    \"\"\"Represents a single octet of an IPv4 address.\"\"\"\n    original_value: str\n    numeric_value: int\n\n    def __post_init__(self):\n        \"\"\"Validates that the numeric value is within the 0-255 range.\"\"\"\n        if not (0 <= self.numeric_value <= 255):\n            raise ValueError(f\"Octet value '{self.original_value}' out of range (0-255).\")\n\n    def cleaned_value(self) -> str:\n        \"\"\"Returns the octet's numeric value as a string without leading zeros.\"\"\"\n        return str(self.numeric_value)\n\n@dataclass\nclass IPAddress:\n    \"\"\"Represents an IPv4 address composed of four Octet objects.\"\"\"\n    address: str\n    octets: List[Octet]\n\n    def cleaned_address(self) -> str:\n        \"\"\"Returns the IP address string with leading zeros removed from each octet.\"\"\"\n        return \".\".join(octet.cleaned_value() for octet in self.octets)\n\ndef removezero_ip(ip_address: str) -> str:\n    \"\"\"Removes leading zeros from each octet of an IPv4 address string.\"\"\"\n    parts = ip_address.split('.')\n    if len(parts) != 4:\n        raise ValueError(\"Invalid IPv4 address format: must have 4 octets.\")\n\n    octet_objects = []\n    for part in parts:\n        try:\n            numeric_part = int(part)\n        except ValueError:\n            raise ValueError(f\"Invalid octet '{part}': not an integer.\")\n        octet_objects.append(Octet(original_value=part, numeric_value=numeric_part))\n\n    ip_obj = IPAddress(address=ip_address, octets=octet_objects)\n    return ip_obj.cleaned_address()"}
{"task_id": "Mbpp/594", "solution": "import collections\nfrom typing import List, Optional\n\ndef diff_even_odd(numbers: List[int]) -> Optional[int]:\n    \"\"\"\n    Finds the difference of the first even and first odd number in a given list.\n    Returns the difference (first_even - first_odd) or None if either number is not found.\n    \"\"\"\n    if not numbers:\n        raise ValueError(\"Input list cannot be empty.\")\n\n    first_even: Optional[int] = None\n    first_odd: Optional[int] = None\n\n    for num in numbers:\n        if first_even is None and num % 2 == 0:\n            first_even = num\n        if first_odd is None and num % 2 != 0:\n            first_odd = num\n        \n        # If both are found, we can stop early\n        if first_even is not None and first_odd is not None:\n            break\n\n    if first_even is not None and first_odd is not None:\n        return first_even - first_odd\n    else:\n        return None"}
{"task_id": "Mbpp/590", "solution": "import math\nfrom typing import Tuple\n\ndef polar_rect(r: float, theta: float) -> Tuple[Tuple[float, float], complex]:\n    \"\"\"\n    Convert polar coordinates to rectangular coordinates.\n    The function returns a tuple containing the magnitude and angle, and the complex number.\n    \"\"\"\n    magnitude = float(r)\n    angle = float(theta)\n    real = magnitude * math.cos(angle)\n    imag = magnitude * math.sin(angle)\n    complex_number = complex(real, imag)\n    return ((magnitude, angle), complex_number)"}
