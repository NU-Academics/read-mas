{"task_id": "Mbpp/731", "solution": "import math\n\ndef lateralsurface_cone(r, h):\n    \"\"\"\n    Calculates the lateral surface area of a cone.\n    The formula is \u03c0 * r * l, where l is the slant height sqrt(r^2 + h^2).\n    \"\"\"\n    slant_height = math.sqrt(r**2 + h**2)\n    area = math.pi * r * slant_height\n    return area"}
{"task_id": "Mbpp/733", "solution": "def find_first_occurrence(array, number):\n    \"\"\"\n    Finds the index of the first occurrence of a given number in a sorted array using binary search.\n    Returns -1 if the number is not found.\n    \"\"\"\n    low = 0\n    high = len(array) - 1\n    result = -1\n\n    while low <= high:\n        mid = low + (high - low) // 2\n        if array[mid] == number:\n            result = mid\n            high = mid - 1  # Continue searching in the left half for the first occurrence\n        elif array[mid] < number:\n            low = mid + 1\n        else:  # array[mid] > number\n            high = mid - 1\n    return result"}
{"task_id": "Mbpp/734", "solution": "def sum_Of_Subarray_Prod(lst):\n    \"\"\"\n    Calculates the sum of products of all possible contiguous sublists of a given list.\n    It iterates through all sublists, computes their product, and sums them up.\n    \"\"\"\n    total_sum = 0\n    n = len(lst)\n\n    for i in range(n):\n        current_product = 1\n        for j in range(i, n):\n            current_product *= lst[j]\n            total_sum += current_product\n    return total_sum"}
{"task_id": "Mbpp/736", "solution": "def left_insertion(elements: list[int], value: int) -> int:\n    \"\"\"\n    Locates the left insertion point for a specified value in a sorted list.\n    Uses an iterative binary search algorithm to achieve O(log n) time complexity.\n    \"\"\"\n    low = 0\n    high = len(elements)\n\n    while low < high:\n        mid = low + (high - low) // 2\n        if elements[mid] < value:\n            low = mid + 1\n        else:\n            high = mid\n    return low"}
{"task_id": "Mbpp/737", "solution": "import re\n\ndef check_str(input_string: str) -> bool:\n    \"\"\"\n    Checks if the given string starts with a vowel (case-insensitive) using regex.\n    Returns False for empty strings.\n    \"\"\"\n    if not input_string:\n        return False\n    return bool(re.match(r'^[aeiou]', input_string, re.IGNORECASE))"}
{"task_id": "Mbpp/735", "solution": "def toggle_middle_bits(number: int) -> int:\n    \"\"\"Toggles bits of the number except the first (MSB) and the last (LSB) bit.\n    For numbers with fewer than 3 bits, the number is returned unchanged.\n    \"\"\"\n    if number < 4:  # Handles 0, 1, 2, 3 which have fewer than 3 bits for toggling\n        return number\n\n    n_bits = number.bit_length()\n    # Create a mask with 1s in all middle bit positions\n    # (1 << (n_bits - 2)) creates a 1 at the (n_bits - 2)-th position (from right, 0-indexed)\n    # - 1 fills all bits below it with 1s\n    # << 1 shifts these 1s to align with the middle bits (excluding LSB)\n    mask = ((1 << (n_bits - 2)) - 1) << 1\n\n    return number ^ mask"}
{"task_id": "Mbpp/739", "solution": "import math\n\ndef find_Index(n: int) -> int:\n    \"\"\"\n    Finds the index of the smallest triangular number with n digits.\n    Iteratively calculates triangular numbers and checks their digit count.\n    \"\"\"\n    k = 1\n    while True:\n        triangular_number = k * (k + 1) // 2\n        \n        # Calculate the number of digits using logarithm\n        if triangular_number == 0: # Handle T_0 case, although k starts from 1\n            num_digits = 1\n        else:\n            num_digits = int(math.log10(triangular_number)) + 1\n        \n        if num_digits == n:\n            return k\n        \n        # Optimization: if current triangular number has too many digits\n        # and we are looking for a smaller digit count (which should not happen\n        # if the loop condition is correct and n is positive),\n        # or if the number of digits has exceeded n,\n        # it implies we've passed the target, but given the problem,\n        # number of digits is non-decreasing.\n        # This part is mostly for robustness, standard iteration is sufficient.\n        if num_digits > n:\n            # This should technically not be reached if we're looking for\n            # the *smallest* index where digits == n and digits grow with k.\n            # But in case of an unusual 'n', this might prevent infinite loops\n            # if n was smaller than expected.\n            # However, for this problem's constraints, it's not strictly needed.\n            pass\n            \n        k += 1"}
{"task_id": "Mbpp/740", "solution": "def tuple_to_dict(input_tuple):\n    \"\"\"\n    Converts a tuple of adjacent elements into a key-value dictionary.\n    Raises ValueError if the tuple length is odd.\n    \"\"\"\n    if len(input_tuple) % 2 != 0:\n        raise ValueError(\"Tuple length must be even.\")\n\n    result_dict = {}\n    for i in range(0, len(input_tuple), 2):\n        key = input_tuple[i]\n        value = input_tuple[i+1]\n        result_dict[key] = value\n    return result_dict"}
