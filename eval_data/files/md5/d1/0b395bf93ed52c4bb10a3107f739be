{"task_id": "Mbpp/777", "solution": "import collections\nfrom typing import List, Union\n\ndef find_sum(input_list: List[Union[int, float]]) -> Union[int, float]:\n    \"\"\"\n    Calculates the sum of elements that appear exactly once in the input list.\n    \"\"\"\n    counts = collections.Counter(input_list)\n    total_sum = 0\n    for element, count in counts.items():\n        if count == 1:\n            total_sum += element\n    return total_sum"}
{"task_id": "Mbpp/797", "solution": "def sum_in_range(l, r):\n    \"\"\"\n    Finds the sum of all odd natural numbers within the inclusive range l and r.\n    Returns 0 if l > r or if no odd numbers are found.\n    \"\"\"\n    if l > r:\n        return 0\n\n    total_sum = 0\n    for num in range(l, r + 1):\n        if num % 2 != 0:\n            total_sum += num\n    return total_sum"}
{"task_id": "Mbpp/419", "solution": "def round_and_sum(numbers):\n    \"\"\"\n    Rounds each number in the input list to the nearest integer,\n    sums the rounded values, multiplies the sum by the length of the list,\n    and returns the final integer result.\n    \"\"\"\n    rounded_numbers = [round(num) for num in numbers]\n    total_sum = sum(rounded_numbers)\n    result = total_sum * len(numbers)\n    return result"}
