{"task_id": "Mbpp/414", "solution": "def overlapping(seq1, seq2):\n    \"\"\"\n    Checks if any value in seq1 exists in seq2.\n    Optimizes lookup by converting the smaller sequence to a set.\n    \"\"\"\n    if not hasattr(seq1, '__iter__') or not hasattr(seq2, '__iter__'):\n        raise TypeError(\"Both arguments must be iterable.\")\n\n    # Convert the smaller sequence to a set for efficient lookup\n    if len(seq1) <= len(seq2):\n        lookup_set = set(seq1)\n        target_seq = seq2\n    else:\n        lookup_set = set(seq2)\n        target_seq = seq1\n\n    for item in target_seq:\n        if item in lookup_set:\n            return True\n    return False"}
{"task_id": "Mbpp/415", "solution": "import math\n\ndef max_Product(arr):\n    \"\"\"\n    Finds a pair of numbers with the highest product from a given array of integers.\n    The algorithm scans the array once to find the two largest positive and two smallest negative numbers.\n    \"\"\"\n    if len(arr) < 2:\n        raise ValueError(\"Input array must contain at least two elements.\")\n\n    max1 = -math.inf  # Largest number\n    max2 = -math.inf  # Second largest number\n    min1 = math.inf   # Smallest number (most negative)\n    min2 = math.inf   # Second smallest number\n\n    for x in arr:\n        if x > max1:\n            max2 = max1\n            max1 = x\n        elif x > max2:\n            max2 = x\n\n        if x < min1:\n            min2 = min1\n            min1 = x\n        elif x < min2:\n            min2 = x\n\n    # Calculate products of candidate pairs\n    product_positives = -math.inf\n    if max1 != -math.inf and max2 != -math.inf:\n        product_positives = max1 * max2\n\n    product_negatives = -math.inf\n    if min1 != math.inf and min2 != math.inf:\n        product_negatives = min1 * min2\n\n    # Determine which product is higher and return the corresponding pair\n    if product_positives >= product_negatives:\n        return tuple(sorted((max2, max1)))\n    else:\n        return tuple(sorted((min1, min2)))"}
{"task_id": "Mbpp/420", "solution": "def cube_Sum(n):\n    \"\"\"\n    Calculates the cube sum of the first n even natural numbers using a direct formula.\n    Raises ValueError if n is not a positive integer.\n    \"\"\"\n    if not isinstance(n, int) or n <= 0:\n        raise ValueError(\"n must be a positive integer\")\n\n    # The sum of the first n even natural numbers is n*(n+1)\n    # The sum of the cubes of the first n even natural numbers is 8 * (sum of first n natural numbers)^2\n    # Sum of first n natural numbers is n*(n+1)/2\n    # So, the formula is 8 * ( (n * (n + 1)) / 2 )^2\n    sum_of_first_n_naturals = (n * (n + 1)) // 2\n    cube_sum = 8 * (sum_of_first_n_naturals ** 2)\n    return cube_sum"}
{"task_id": "Mbpp/418", "solution": "from typing import List, Any\n\ndef Find_Max(input_list: List[List[Any]]) -> List[Any]:\n    \"\"\"\n    Return the sub-list with the greatest length from a list of lists.\n    If the input_list is empty, an empty list is returned.\n    \"\"\"\n    if not input_list:\n        return []\n\n    max_sub = input_list[0]\n    for sub in input_list[1:]:\n        if len(sub) > len(max_sub):\n            max_sub = sub\n    return max_sub"}
