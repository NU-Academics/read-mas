{"task_id": "Mbpp/572", "solution": "from typing import List\n\ndef two_unique_nums(input_list: List[int]) -> List[int]:\n    \"\"\"\n    Removes duplicate numbers from a list, returning only those that appear exactly once,\n    while preserving their original order of first appearance.\n    \"\"\"\n    counts = {}\n    for num in input_list:\n        counts[num] = counts.get(num, 0) + 1\n\n    result = []\n    for num in input_list:\n        if counts[num] == 1:\n            result.append(num)\n\n    return result"}
{"task_id": "Mbpp/573", "solution": "from typing import List\n\ndef unique_product(numbers: List[int]) -> int:\n    \"\"\"\n    Calculates the product of unique numbers in the given list.\n    \"\"\"\n    unique_numbers = set(numbers)\n    product = 1\n    for n in unique_numbers:\n        product *= n\n    return product"}
{"task_id": "Mbpp/576", "solution": "from typing import List, Any\n\ndef is_Sub_Array(list1: List[Any], list2: List[Any]) -> bool:\n    \"\"\"Checks if list2 is a contiguous sub-sequence of list1.\"\"\"\n    if not list2:\n        return True\n    if len(list2) > len(list1):\n        return False\n\n    n, m = len(list1), len(list2)\n    for i in range(n - m + 1):\n        if list1[i : i + m] == list2:\n            return True\n    return False"}
{"task_id": "Mbpp/577", "solution": "def last_Digit_Factorial(n: int) -> int:\n    \"\"\"\n    Finds the last digit in the factorial of a given non-negative number n.\n    Computes iteratively, taking modulo 10 at each step to manage size.\n    \"\"\"\n    if n < 0:\n        raise ValueError(\"n must be non-negative\")\n    \n    # Factorials for n >= 5 always end in 0 (2*5 = 10)\n    # The last digit of 0! is 1, 1! is 1, 2! is 2, 3! is 6, 4! is 24 (last digit 4)\n    # For n >= 5, the last digit will be 0.\n    if n >= 5:\n        return 0\n\n    # Calculate factorial for n < 5\n    result = 1\n    for i in range(1, n + 1):\n        result *= i\n    return result % 10"}
{"task_id": "Mbpp/578", "solution": "def interleave_lists(list1, list2, list3):\n    \"\"\"Interleaves elements from three lists of the same length into a single flat list.\"\"\"\n    if not (len(list1) == len(list2) == len(list3)):\n        raise ValueError(\"Input lists must have the same length.\")\n\n    result = []\n    for i in range(len(list1)):\n        result.append(list1[i])\n        result.append(list2[i])\n        result.append(list3[i])\n    return result"}
{"task_id": "Mbpp/579", "solution": "from typing import Tuple\n\ndef find_dissimilar(tuple1: Tuple, tuple2: Tuple) -> Tuple:\n    \"\"\"\n    Finds elements present in exactly one of the two input tuples, preserving order.\n    Elements unique to tuple1 appear first, followed by elements unique to tuple2.\n    \"\"\"\n    set1 = set(tuple1)\n    set2 = set(tuple2)\n\n    unique_to_1 = [item for item in tuple1 if item not in set2]\n    unique_to_2 = [item for item in tuple2 if item not in set1]\n\n    return tuple(unique_to_1 + unique_to_2)"}
{"task_id": "Mbpp/580", "solution": "from typing import Any, Tuple\n\ndef extract_even(t: Tuple[Any, ...]) -> Tuple[Any, ...]:\n    \"\"\"\n    Recursively extracts even integers from a nested tuple.\n\n    Returns a new tuple containing only the even integers from the input,\n    preserving the original order and nesting.\n    \"\"\"\n    result = []\n    for item in t:\n        if isinstance(item, tuple):\n            nested = extract_even(item)\n            if nested:\n                result.append(nested)\n        elif isinstance(item, int) and item % 2 == 0:\n            result.append(item)\n    return tuple(result)"}
{"task_id": "Mbpp/581", "solution": "import math\n\ndef surface_Area(baseEdge, height):\n    \"\"\"\n    Calculates the total surface area of a square pyramid.\n    It sums the base area and the area of the four triangular faces.\n    \"\"\"\n    half_base = baseEdge / 2\n    # Calculate the slant height using Pythagorean theorem\n    slant_height = math.sqrt(half_base**2 + height**2)\n    \n    # Calculate the area of one triangular face\n    triangular_face_area = 0.5 * baseEdge * slant_height\n    \n    # Calculate the base area\n    base_area = baseEdge**2\n    \n    # Total surface area is the base area plus the area of four triangular faces\n    total_surface_area = base_area + (4 * triangular_face_area)\n    \n    return int(total_surface_area)"}
{"task_id": "Mbpp/583", "solution": "def catalan_number(n):\n    # Calculates the nth Catalan number using the closed-form formula C_n = (1/(n+1)) * binomial(2n, n).\n    # The binomial coefficient is computed iteratively to maintain integer precision.\n    binom_2n_n = 1\n    for i in range(n):\n        binom_2n_n = binom_2n_n * (2 * n - i) // (i + 1)\n\n    return binom_2n_n // (n + 1)"}
{"task_id": "Mbpp/585", "solution": "from typing import List, Dict, Any\n\ndef expensive_items(items: List[Dict[str, Any]], n: int) -> List[Dict[str, Any]]:\n    \"\"\"\n    Return the top `n` items with the highest price, sorted in descending order.\n    The function is pure: it does not modify the input list or its dictionaries.\n    \"\"\"\n    for idx, item in enumerate(items):\n        if 'price' not in item:\n            raise ValueError(f\"Item at index {idx} missing 'price' key.\")\n        if not isinstance(item['price'], (int, float)):\n            raise ValueError(f\"Item at index {idx} has non-numeric price: {item['price']}\")\n\n    if n <= 0:\n        return []\n\n    items_copy = list(items)\n\n    items_copy.sort(key=lambda x: x['price'], reverse=True)\n\n    return items_copy[:n]"}
