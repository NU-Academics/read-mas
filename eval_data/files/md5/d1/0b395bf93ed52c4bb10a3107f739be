{"task_id": "Mbpp/256", "solution": "def count_Primes_nums(num):\n    \"\"\"\n    Counts the number of prime numbers strictly less than the given non-negative integer.\n    Uses the Sieve of Eratosthenes algorithm for efficient prime finding.\n    \"\"\"\n    if num <= 2:\n        return 0\n\n    is_prime = [True] * num\n    is_prime[0] = False\n    is_prime[1] = False\n\n    p = 2\n    while p * p < num:\n        if is_prime[p]:\n            for multiple in range(p * p, num, p):\n                is_prime[multiple] = False\n        p += 1\n\n    count = 0\n    for i in range(num):\n        if is_prime[i]:\n            count += 1\n    return count"}
{"task_id": "Mbpp/259", "solution": "def maximize_elements(tup1: tuple[tuple[int, ...], ...], tup2: tuple[tuple[int, ...], ...]) -> tuple[tuple[int, ...], ...]:\n    \"\"\"\n    Maximizes elements of two tuples of tuples by returning the element-wise maximum.\n    Assumes inputs are of identical shape and contain only integers.\n    \"\"\"\n    result = []\n    for sub_tup1, sub_tup2 in zip(tup1, tup2):\n        maximized_sub_tup = tuple(max(a, b) for a, b in zip(sub_tup1, sub_tup2))\n        result.append(maximized_sub_tup)\n    return tuple(result)"}
{"task_id": "Mbpp/262", "solution": "def split_two_parts(input_list, L):\n    \"\"\"\n    Splits a list into two parts: the first part has length L, and the second part contains the remainder.\n    Returns a tuple of the two resulting lists.\n    \"\"\"\n    first_part = input_list[:L]\n    second_part = input_list[L:]\n    return (first_part, second_part)"}
{"task_id": "Mbpp/261", "solution": "from typing import Tuple\n\ndef division_elements(tuple1: Tuple[int], tuple2: Tuple[int]) -> Tuple[int]:\n    \"\"\"\n    Performs element-wise integer division of tuple1 by tuple2.\n    Raises ValueError if tuple lengths differ or ZeroDivisionError for division by zero.\n    \"\"\"\n    if len(tuple1) != len(tuple2):\n        raise ValueError(\"Input tuples must have equal length.\")\n\n    for idx, divisor in enumerate(tuple2):\n        if divisor == 0:\n            raise ZeroDivisionError(f\"Division by zero at index {idx}.\")\n\n    result = tuple(a // b for a, b in zip(tuple1, tuple2))\n    return result"}
