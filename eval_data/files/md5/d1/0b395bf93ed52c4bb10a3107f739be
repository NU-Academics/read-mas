{"task_id": "Mbpp/471", "solution": "import collections\nfrom typing import List\n\ndef find_remainder(numbers: List[int], n: int) -> int:\n    \"\"\"\n    Finds the product of the array multiplication modulo n.\n    If the list is empty, returns 0.\n    \"\"\"\n    if not numbers:\n        return 0\n\n    product = 1\n    for num in numbers:\n        product = (product * num) % n\n    return product"}
{"task_id": "Mbpp/472", "solution": "def check_Consecutive(numbers: list[int]) -> bool:\n    \"\"\"\n    Checks if a list of integers contains consecutive numbers.\n    Returns True if every adjacent pair differs by exactly 1, or if the list has fewer than two elements.\n    \"\"\"\n    if len(numbers) < 2:\n        return True\n\n    for i in range(len(numbers) - 1):\n        if abs(numbers[i+1] - numbers[i]) != 1:\n            return False\n            \n    return True"}
{"task_id": "Mbpp/474", "solution": "def replace_char(input_string: str, old_char: str, new_char: str) -> str:\n    \"\"\"\n    Replaces all occurrences of `old_char` in `input_string` with `new_char`.\n    The function iterates through the string, building a new one with replacements.\n    \"\"\"\n    return ''.join(new_char if char == old_char else char for char in input_string)"}
{"task_id": "Mbpp/473", "solution": "from typing import List, Tuple, Set\n\ndef tuple_intersection(\n    list1: List[Tuple[int, int]],\n    list2: List[Tuple[int, int]]\n) -> Set[Tuple[int, int]]:\n    \"\"\"\n    Finds the intersection of elements in two tuple lists, irrespective of tuple order.\n    Tuples are normalized by sorting their elements before comparison.\n    \"\"\"\n    norm1 = {tuple(sorted(t)) for t in list1}\n    norm2 = {tuple(sorted(t)) for t in list2}\n    return norm1 & norm2"}
