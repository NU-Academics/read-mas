{"task_id": "Mbpp/615", "solution": "def average_tuple(tuple_of_tuples):\n    \"\"\"\n    Calculates the average value for each inner tuple in a tuple of tuples.\n    Returns a list of these averages.\n    \"\"\"\n    averages = []\n    for inner_tuple in tuple_of_tuples:\n        if inner_tuple: # Ensure the inner tuple is not empty to avoid ZeroDivisionError\n            averages.append(sum(inner_tuple) / len(inner_tuple))\n        # Per instructions, do not raise exceptions for edge cases like empty inner tuples.\n        # Assuming valid input per requirements.\n    return averages"}
{"task_id": "Mbpp/616", "solution": "def tuple_modulo(tuple1: tuple[int], tuple2: tuple[int]) -> tuple[int]:\n    \"\"\"\n    Compute the element\u2011wise modulo of two tuples of equal length.\n\n    Raises:\n        ValueError: If the input tuples have different lengths.\n    \"\"\"\n    if len(tuple1) != len(tuple2):\n        raise ValueError(\"Input tuples must have the same length.\")\n    return tuple(a % b for a, b in zip(tuple1, tuple2))"}
{"task_id": "Mbpp/618", "solution": "from typing import List, Union\n\nNumber = Union[int, float]\nFloat = float\n\ndef div_list(list1: List[Number], list2: List[Number]) -> List[Float]:\n    \"\"\"\n    Divides two lists element-wise, returning a new list of floating-point results.\n    Raises ValueError if lengths differ or ZeroDivisionError if any denominator is zero.\n    \"\"\"\n    if len(list1) != len(list2):\n        raise ValueError(\"Input lists must have the same length.\")\n\n    result: List[Float] = []\n    for a, b in zip(list1, list2):\n        # Explicit float conversion ensures floating-point division.\n        result.append(float(a) / float(b))\n    return result"}
{"task_id": "Mbpp/620", "solution": "from typing import List\n\ndef largest_subset(numbers: List[int]) -> int:\n    \"\"\"\n    Finds the size of the largest subset of numbers where every pair is divisible.\n    The problem is solved using dynamic programming by finding the longest divisible chain.\n    \"\"\"\n    if not numbers:\n        return 0\n\n    sorted_numbers = sorted(numbers)\n    n = len(sorted_numbers)\n    dp = [1] * n  # dp[i] stores the size of the largest divisible subset ending with sorted_numbers[i]\n\n    for i in range(n):\n        for j in range(i):\n            # If the current number is divisible by a previous number, it can extend that subset.\n            if sorted_numbers[i] % sorted_numbers[j] == 0:\n                dp[i] = max(dp[i], dp[j] + 1)\n\n    return max(dp)"}
{"task_id": "Mbpp/619", "solution": "def move_num(s: str) -> str:\n    \"\"\"\n    Moves all numeric substrings to the end of the given string, preserving relative order.\n    \"\"\"\n    non_numeric_parts = []\n    numeric_parts = []\n    current_numeric_segment = []\n\n    for char in s:\n        if '0' <= char <= '9':\n            current_numeric_segment.append(char)\n        else:\n            if current_numeric_segment:\n                numeric_parts.append(\"\".join(current_numeric_segment))\n                current_numeric_segment = []\n            non_numeric_parts.append(char)\n    \n    # Append any remaining numeric segment\n    if current_numeric_segment:\n        numeric_parts.append(\"\".join(current_numeric_segment))\n\n    return \"\".join(non_numeric_parts) + \"\".join(numeric_parts)"}
{"task_id": "Mbpp/622", "solution": "import math\n\ndef get_median(list1, list2, size):\n    \"\"\"\n    Finds the median of two sorted lists of the same size.\n    The median is the average of the two middle elements of the combined list.\n    \"\"\"\n    # Create a merged list from the two sorted input lists.\n    # Since both lists are already sorted, we can merge them efficiently.\n    # The problem implies we can use standard library functions for sorting/merging.\n    merged_list = sorted(list1 + list2)\n\n    # For two lists of size 'size', the combined list has 2 * size elements.\n    # The median for an even number of elements is the average of the two middle elements.\n    # These elements are at indices (2 * size / 2) - 1 and (2 * size / 2).\n    # Which simplifies to index (size - 1) and index (size).\n    median_index1 = size - 1\n    median_index2 = size\n\n    median = (merged_list[median_index1] + merged_list[median_index2]) / 2.0\n    return median"}
