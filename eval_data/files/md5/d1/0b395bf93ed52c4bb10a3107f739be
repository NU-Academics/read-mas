{"task_id": "Mbpp/109", "solution": "import collections\nimport dataclasses\n\n@dataclasses.dataclass\nclass BinaryString:\n    value: str\n    length: int\n\n@dataclasses.dataclass\nclass Rotation:\n    index: int\n    rotated_value: str\n    is_odd: bool\n\n@dataclasses.dataclass\nclass Result:\n    rotation_count: int\n    odd_count: int\n\ndef odd_Equivalent(binary_string: str, rotation_count: int) -> int:\n    \"\"\"\n    Calculates the number of times a binary string, when rotated, results in an odd integer.\n    Rotations are cyclic right shifts.\n    \"\"\"\n    n = len(binary_string)\n    if n == 0:\n        return 0\n\n    odd_count = 0\n    # For rotation_index from 0 up to rotation_count (inclusive)\n    for i in range(rotation_count + 1):\n        # Calculate the actual shift amount for the right cyclic shift\n        # A right shift by `i` positions means the character at `n - (i % n)` becomes the first\n        # and the character at `n - 1 - (i % n)` becomes the last.\n        # Alternatively, the last `i % n` characters move to the front.\n        # Example: \"011001\", i=1 -> \"101100\" (last char '1' moves to front)\n        # Shift index calculation: new_start = (n - i) % n\n        # This gives the index in the original string that will become the first character of the rotated string.\n        actual_shift = i % n\n        \n        # Determine if the rotated string represents an odd number.\n        # An odd number in binary has its least significant bit (rightmost character) as '1'.\n        # The character that will be at the rightmost position after `i` right shifts\n        # is the character that was originally at index `(n - 1 - i) % n`.\n        # For a right shift of `i` positions, the new last character is the character\n        # originally at index `(n - 1 - i) % n`.\n        # E.g., for \"011001\" (n=6), i=0, last char is \"1\" at (6-1-0)%6 = 5.\n        #       i=1, last char is \"0\" at (6-1-1)%6 = 4.\n        #       i=2, last char is \"0\" at (6-1-2)%6 = 3.\n        #       i=3, last char is \"1\" at (6-1-3)%6 = 2.\n        #       i=4, last char is \"1\" at (6-1-4)%6 = 1.\n        #       i=5, last char is \"0\" at (6-1-5)%6 = 0.\n        #       i=6, last char is \"1\" at (6-1-6)%6 = 5.\n        \n        if binary_string[(n - 1 - actual_shift + n) % n] == '1':\n            odd_count += 1\n\n    return odd_count"}
{"task_id": "Mbpp/111", "solution": "from typing import List, Set\n\ndef common_in_nested_lists(lists: List[List[int]]) -> Set[int]:\n    \"\"\"\n    Return the set of integers that appear in every sub\u2011list of `lists`.\n    The function is pure: it does not modify the input lists.\n    \"\"\"\n    if not lists:\n        return set()\n\n    common = set(lists[0])\n    for sublist in lists[1:]:\n        common.intersection_update(sublist)\n        if not common:\n            break\n    return common"}
{"task_id": "Mbpp/113", "solution": "def check_integer(s: str) -> bool:\n    \"\"\"Checks if a string represents an integer.\n    Handles an optional leading sign and ensures all remaining characters are digits, disallowing any whitespace.\n    \"\"\"\n    if not s or s != s.strip():\n        return False\n\n    start_idx = 0\n    if s[0] == '+' or s[0] == '-':\n        start_idx = 1\n\n    # After processing the sign, there must be at least one digit remaining.\n    if start_idx == len(s):\n        return False\n\n    return s[start_idx:].isdigit()"}
