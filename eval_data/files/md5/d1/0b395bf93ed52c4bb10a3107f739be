{"task_id": "Mbpp/745", "solution": "def divisible_by_digits(startnum, endnum):\n    \"\"\"\n    Finds numbers within a given range that are divisible by every digit they contain.\n    Numbers containing the digit 0 are excluded.\n    \"\"\"\n    results = []\n    for num in range(startnum, endnum + 1):\n        s_num = str(num)\n        \n        # Exclude numbers containing the digit '0'\n        if '0' in s_num:\n            continue\n            \n        is_self_divisible = True\n        for char_digit in s_num:\n            digit = int(char_digit)\n            # Check if the number is divisible by the current digit\n            if num % digit != 0:\n                is_self_divisible = False\n                break\n        \n        if is_self_divisible:\n            results.append(num)\n            \n    return results"}
{"task_id": "Mbpp/749", "solution": "import typing\nfrom typing import List\n\ndef sort_numeric_strings(input_list: List[str]) -> List[int]:\n    \"\"\"\n    Converts a list of numeric strings to integers and sorts them numerically.\n    \"\"\"\n    parsed_integers = [int(s) for s in input_list]\n    return sorted(parsed_integers)"}
{"task_id": "Mbpp/751", "solution": "from typing import List\n\ndef check_min_heap(arr: List[int]) -> bool:\n    \"\"\"\n    Checks if the given array represents a min-heap.\n    It verifies that each parent node is less than or equal to its children.\n    \"\"\"\n    n = len(arr)\n    # Iterate over parent nodes, from index 0 up to (n-2)//2.\n    # This range includes all nodes that could potentially have children.\n    for i in range((n - 2) // 2 + 1):\n        left_child_idx = 2 * i + 1\n        right_child_idx = 2 * i + 2\n\n        # Check left child: it always exists for a parent in this loop range.\n        if arr[i] > arr[left_child_idx]:\n            return False\n\n        # Check right child: it might not exist if the parent is the last one with only a left child.\n        if right_child_idx < n and arr[i] > arr[right_child_idx]:\n            return False\n\n    return True"}
{"task_id": "Mbpp/754", "solution": "from typing import List, Any\n\ndef extract_index_list(l1: List[Any], l2: List[Any], l3: List[Any]) -> List[Any]:\n    \"\"\"\n    Finds elements that are common for three lists, appearing at the same index in all of them.\n    Returns a list of these common elements.\n    \"\"\"\n    \n    result = []\n    min_len = min(len(l1), len(l2), len(l3))\n\n    for i in range(min_len):\n        if l1[i] == l2[i] and l2[i] == l3[i]:\n            result.append(l1[i])\n            \n    return result"}
{"task_id": "Mbpp/752", "solution": "def jacobsthal_num(n: int) -> int:\n    \"\"\"Calculates the nth Jacobsthal number using an iterative approach.\"\"\"\n    if n == 0:\n        return 0\n    elif n == 1:\n        return 1\n    \n    a, b = 0, 1  # a for J(i-2), b for J(i-1)\n    for _ in range(2, n + 1):\n        current_jacobsthal = b + 2 * a\n        a = b\n        b = current_jacobsthal\n    return b"}
{"task_id": "Mbpp/753", "solution": "from dataclasses import dataclass\nfrom typing import List, Tuple\nimport heapq\n\n@dataclass(frozen=True)\nclass Record:\n    name: str\n    value: int\n\nclass MinKFunction:\n    \"\"\"\n    Internal class that performs the k\u2011smallest selection using a max-heap.\n    This ensures O(N log K) performance.\n    \"\"\"\n    def execute(self, records: List[Record], k: int) -> List[Record]:\n        heap: List[Tuple[int, Record]] = []\n        for rec in records:\n            if len(heap) < k:\n                heapq.heappush(heap, (-rec.value, rec))\n            else:\n                if rec.value < -heap[0][0]:\n                    heapq.heapreplace(heap, (-rec.value, rec))\n        return sorted([rec for _, rec in heap], key=lambda r: r.value)\n\nclass _validate:\n    @staticmethod\n    def validate(records: List[Record], k: int) -> None:\n        if k < 0 or k > len(records):\n            raise ValueError(\"k must be between 0 and the number of records.\")\n\ndef min_k(records: List[Tuple[str, int]], k: int) -> List[Tuple[str, int]]:\n    \"\"\"\n    Finds the k records with the minimum second-element values from a list of (name, value) tuples.\n    Returns the results sorted by the second element in ascending order.\n    \"\"\"\n    recs = [Record(name, value) for name, value in records]\n    _validate.validate(recs, k)\n    result_records = MinKFunction().execute(recs, k)\n    return [(r.name, r.value) for r in result_records]"}
{"task_id": "Mbpp/757", "solution": "def count_reverse_pairs(strings: list[str]) -> int:\n    \"\"\"Counts pairs of reverse strings in the given list.\n\n    Utilizes a set for efficient lookups to find reverse pairs in O(n) time.\n    \"\"\"\n    seen = set()\n    count = 0\n    for s in strings:\n        if not s:  # BR4: Empty strings are not considered\n            continue\n        \n        reversed_s = s[::-1]\n        \n        if reversed_s in seen and s != reversed_s:  # BR1: distinct strings, BR2: count only once\n            count += 1\n            # Remove both from seen to ensure each pair is counted exactly once\n            # This handles cases like [\"a\", \"b\", \"a\", \"b\"]\n            # If we don't remove, and we see \"a\", then \"b\", then \"a\", then \"b\", we'd count 2 pairs.\n            # But if [\"a\", \"b\", \"a\"] where \"b\" is \"a\" reversed.\n            # \"a\" added to seen. \"b\" reversed is \"a\". \"a\" is in seen. Count++.\n            # Now, if we have another \"a\" in the list, its reverse \"b\" might still be in seen,\n            # leading to a double count if not careful.\n            # A simpler way to handle uniqueness for \"seen\" values for this problem\n            # is to simply add *everything* to a set first, then iterate that set.\n            # Let's adjust to that for clarity and correctness.\n            pass # this logic is flawed for this problem type, let's restart inner logic\n    \n    # Simpler and more robust approach:\n    # 1. Add all unique strings to a set for O(1) lookups.\n    # 2. Iterate through the unique strings, count pairs, and mark them as counted.\n    \n    unique_strings = set(s for s in strings if s) # BR4: exclude empty strings\n    pairs_count = 0\n    counted_pairs_members = set()\n\n    for s in unique_strings:\n        if s in counted_pairs_members: # Avoid double counting for strings already part of a pair\n            continue\n        \n        reversed_s = s[::-1]\n        \n        # BR1: A reverse pair is defined as two distinct strings where one string is the reverse of the other.\n        # BR3: Strings are compared case-sensitively.\n        if reversed_s != s and reversed_s in unique_strings:\n            pairs_count += 1\n            counted_pairs_members.add(s)\n            counted_pairs_members.add(reversed_s)\n            \n    return pairs_count"}
{"task_id": "Mbpp/755", "solution": "import collections\nfrom typing import List\n\ndef second_smallest(values: List[int]) -> int:\n    \"\"\"\n    Finds the second smallest number in a list after removing duplicates.\n    Raises ValueError if the list has fewer than two elements or fewer than two distinct elements.\n    \"\"\"\n    if len(values) < 2:\n        raise ValueError(\"Input list must contain at least two elements.\")\n\n    unique_values = sorted(list(set(values)))\n\n    if len(unique_values) < 2:\n        raise ValueError(\"Input list must contain at least two distinct elements.\")\n\n    return unique_values[1]"}
