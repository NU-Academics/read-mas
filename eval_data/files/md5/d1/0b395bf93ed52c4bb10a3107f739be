{"task_id": "Mbpp/721", "solution": "def maxAverageOfPath(matrix):\n    \"\"\"\n    Calculates the maximum average cost of a path from the top-left to the bottom-right cell\n    in a square matrix, moving only right or down.\n    \"\"\"\n    N = len(matrix)\n    if N == 0:\n        return 0.0\n\n    all_paths_data = [] # Stores (total_sum, total_length) for each valid path\n\n    def _find_paths_recursive(r, c, current_sum, current_length):\n        # Add the current cell's value and increment path length\n        current_sum += matrix[r][c]\n        current_length += 1\n\n        # Base case: If we've reached the bottom-right cell\n        if r == N - 1 and c == N - 1:\n            all_paths_data.append((current_sum, current_length))\n            return\n\n        # Recursive step: Explore moving right\n        if c + 1 < N:\n            _find_paths_recursive(r, c + 1, current_sum, current_length)\n\n        # Recursive step: Explore moving down\n        if r + 1 < N:\n            _find_paths_recursive(r + 1, c, current_sum, current_length)\n\n    # Start the recursive search from the top-left cell (0, 0)\n    _find_paths_recursive(0, 0, 0, 0)\n\n    max_avg = 0.0\n    for total_sum, total_length in all_paths_data:\n        max_avg = max(max_avg, total_sum / total_length)\n\n    return max_avg"}
{"task_id": "Mbpp/724", "solution": "class BaseNumber:\n    \"\"\"Represents the base number.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\nclass Power:\n    \"\"\"Represents the power/exponent.\"\"\"\n    def __init__(self, exponent: int):\n        self.exponent = exponent\n\nclass DigitSum:\n    \"\"\"Provides a service to calculate the sum of digits of an integer.\"\"\"\n    @staticmethod\n    def sum_digits(n: int) -> int:\n        return sum(int(digit) for digit in str(n))\n\ndef power_base_sum(base: int, power: int) -> int:\n    \"\"\"\n    Calculates the sum of all digits of the base to the specified power.\n    \"\"\"\n    base_number_entity = BaseNumber(base)\n    power_entity = Power(power)\n\n    # Compute the power using the values from domain entities\n    result_power = base_number_entity.value ** power_entity.exponent\n\n    # Delegate digit summation to the DigitSum service\n    return DigitSum.sum_digits(result_power)"}
{"task_id": "Mbpp/725", "solution": "def extract_quotation(text):\n    \"\"\"\n    Extracts values between double quotation marks from a given string.\n    Processes the string character by character to identify quoted segments.\n    \"\"\"\n    extracted_values = []\n    in_quote = False\n    current_quote = []\n\n    for char in text:\n        if char == '\"':\n            if in_quote:\n                extracted_values.append(\"\".join(current_quote))\n                current_quote = []\n                in_quote = False\n            else:\n                in_quote = True\n        elif in_quote:\n            current_quote.append(char)\n    return extracted_values"}
