{"task_id": "Mbpp/392", "solution": "def get_max_sum(n, memo={}):\n    \"\"\"\n    Calculates the maximum sum for n using the recurrence f(n) = max( (f(n/2) + f(n/3) + f(n/4) + f(n/5)), n).\n    Uses memoization to store previously computed results and optimize performance.\n    \"\"\"\n    if n <= 0:\n        return 0\n    if n in memo:\n        return memo[n]\n\n    # Calculate the sum of recursive calls for n/2, n/3, n/4, and n/5 (integer division)\n    sum_of_parts = get_max_sum(n // 2, memo) + \\\n                   get_max_sum(n // 3, memo) + \\\n                   get_max_sum(n // 4, memo) + \\\n                   get_max_sum(n // 5, memo)\n\n    # The result is the maximum of n itself or the sum of its parts\n    result = max(n, sum_of_parts)\n    memo[n] = result\n    return result"}
{"task_id": "Mbpp/397", "solution": "```python\ndef median_numbers(a, b, c):\n    \"\"\"\n    Finds the median of three numbers using conditional comparisons.\n    This implementation avoids sorting for constant-time performance.\n    \"\"\"\n    if a < b:\n        if b < c:\n            return float(b)\n        elif a < c:\n            return float(c)\n        else:\n            return float(a)\n    else:  # b <= a\n        if a < c:\n            return float(a)\n        elif b < c:\n            return float(c)\n        else:\n            return float(b)\n```"}
{"task_id": "Mbpp/395", "solution": "import collections\n\ndef first_non_repeating_character(s: str) -> str | None:\n    \"\"\"\n    Finds the first non-repeated character in a given string.\n    Uses a two-pass approach for O(n) time complexity and O(1) additional space\n    (relative to the bounded size of the character set).\n    \"\"\"\n    char_counts = collections.Counter(s)\n\n    for char in s:\n        if char_counts[char] == 1:\n            return char\n\n    return None"}
{"task_id": "Mbpp/398", "solution": "from typing import List\n\ndef sum_of_digits(numbers: List[int]) -> int:\n    \"\"\"\n    Computes the sum of digits of each number in a given list, then sums these individual sums.\n    Assumes all numbers in the list are non-negative integers.\n    \"\"\"\n    total_aggregate_sum = 0\n    for num in numbers:\n        # Convert the number to a string to easily iterate over its digits.\n        # Then convert each digit character back to an integer and sum them.\n        current_num_sum = sum(int(digit_char) for digit_char in str(num))\n        total_aggregate_sum += current_num_sum\n    return total_aggregate_sum"}
