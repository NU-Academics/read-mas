{"task_id": "Mbpp/607", "solution": "import re\nfrom typing import Tuple\n\nclass NoMatchError(Exception):\n    \"\"\"Raised when no regex match is found.\"\"\"\n    pass\n\ndef find_literals(target: str, pattern: str) -> Tuple[str, int, int]:\n    \"\"\"\n    Searches the target string for the first occurrence of the regex pattern.\n    Returns the matched substring, its start, and end indices, or raises NoMatchError if no match.\n    \"\"\"\n    match = re.search(pattern, target)\n    if match:\n        return (match.group(0), match.start(), match.end())\n    else:\n        raise NoMatchError(\"No match found for the given pattern in the target string.\")"}
{"task_id": "Mbpp/611", "solution": "def max_of_nth(matrix: list[list[int]], n: int) -> int:\n    \"\"\"\n    Return the maximum integer in the nth column of a matrix.\n\n    Raises:\n        ValueError: If matrix is empty, non-rectangular, or n is out of bounds.\n    \"\"\"\n    if not matrix:\n        raise ValueError(\"Matrix must not be empty.\")\n\n    num_cols = len(matrix[0])\n    if any(len(row) != num_cols for row in matrix):\n        raise ValueError(\"Matrix rows must all have the same length.\")\n\n    if not (0 <= n < num_cols):\n        raise ValueError(f\"Column index {n} out of bounds for matrix with {num_cols} columns.\")\n\n    return max(row[n] for row in matrix)"}
{"task_id": "Mbpp/608", "solution": "import math\n\n_bell_numbers_cache = [1] # Cache for Bell numbers: _bell_numbers_cache[k] stores B(k)\n\ndef bell_Number(n: int) -> int:\n    \"\"\"\n    Computes the nth Bell number using a dynamic programming approach with memoization.\n    The Bell numbers B(n) count the number of partitions of a set with n elements.\n    \"\"\"\n    while n >= len(_bell_numbers_cache):\n        current_length = len(_bell_numbers_cache)\n        next_bell_number = 0\n        for k in range(current_length):\n            next_bell_number += math.comb(current_length - 1, k) * _bell_numbers_cache[k]\n        _bell_numbers_cache.append(next_bell_number)\n    \n    return _bell_numbers_cache[n]"}
{"task_id": "Mbpp/610", "solution": "from typing import List, Any\n\ndef remove_kth_element(lst: List[Any], k: int) -> List[Any]:\n    \"\"\"\n    Returns a new list with the k'th element removed (1-based index).\n    The original list remains unchanged.\n    \"\"\"\n    if k < 1 or k > len(lst):\n        raise IndexError(\"Index out of range\")\n    return lst[: k - 1] + lst[k :]"}
