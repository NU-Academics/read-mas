{"task_id": "Mbpp/598", "solution": "class ArmstrongNumber:\n    \"\"\"\n    Domain class representing a number and its Armstrong status.\n    \"\"\"\n    def __init__(self, value: int):\n        if value < 0:\n            raise ValueError(\"Number must be non\u2011negative\")\n        self.value = value\n\n    def isArmstrong(self) -> bool:\n        \"\"\"\n        Determine if the stored number is an Armstrong number.\n        \"\"\"\n        if self.value < 0:\n            return False # Should be handled by __init__ but defensive for internal calls\n        \n        # Special case for 0 and single-digit numbers as they are Armstrong numbers by definition (n^1 = n)\n        if self.value < 10:\n            return True\n\n        digits = [int(d) for d in str(self.value)]\n        power = len(digits)\n        return sum(d ** power for d in digits) == self.value\n\n\ndef armstrong_number(number: int) -> bool:\n    \"\"\"\n    Public function that validates input and returns the Armstrong status.\n    \"\"\"\n    armstrong = ArmstrongNumber(number)\n    return armstrong.isArmstrong()"}
{"task_id": "Mbpp/597", "solution": "class KthElementFinder:\n    def find(self, arr1: list, arr2: list, k: int) -> int:\n        \"\"\"\n        Finds the kth element from two sorted arrays using a recursive binary search approach.\n        \"\"\"\n        len1 = len(arr1)\n        len2 = len(arr2)\n\n        def _find_recursive(idx1, idx2, k_val):\n            # Base cases: if one array is exhausted, return from the other\n            if idx1 >= len1:\n                return arr2[idx2 + k_val - 1]\n            if idx2 >= len2:\n                return arr1[idx1 + k_val - 1]\n            \n            # Base case: if k is 1, return the minimum of the current elements\n            if k_val == 1:\n                return min(arr1[idx1], arr2[idx2])\n\n            # Determine the number of elements to advance in each array\n            # We want to skip approximately k_val / 2 elements\n            k_step = k_val // 2\n\n            # Calculate how many elements we can actually take from each array\n            # ensuring we don't go out of bounds\n            count1 = min(k_step, len1 - idx1)\n            count2 = min(k_step, len2 - idx2)\n            \n            # Compare the elements at the (current_index + count - 1) position\n            val1 = arr1[idx1 + count1 - 1]\n            val2 = arr2[idx2 + count2 - 1]\n\n            if val1 <= val2:\n                # If val1 is smaller or equal, discard count1 elements from arr1\n                # and search for the (k_val - count1)-th element\n                return _find_recursive(idx1 + count1, idx2, k_val - count1)\n            else:\n                # If val2 is smaller, discard count2 elements from arr2\n                # and search for the (k_val - count2)-th element\n                return _find_recursive(idx1, idx2 + count2, k_val - count2)\n        \n        return _find_recursive(0, 0, k)\n\n\ndef find_kth(array1: list, array2: list, k: int) -> int:\n    \"\"\"\n    Finds the kth element from the given two sorted arrays.\n    \"\"\"\n    total_length = len(array1) + len(array2)\n    if not (1 <= k <= total_length):\n        raise IndexError(f\"k is out of bounds. k must be between 1 and {total_length}, but got {k}.\")\n\n    finder = KthElementFinder()\n    return finder.find(array1, array2, k)"}
{"task_id": "Mbpp/599", "solution": "import math\n\ndef sum_average(n: int) -> tuple[int, float]:\n    \"\"\"\n    Calculates the sum and average of the first n natural numbers.\n    Raises ValueError if n is not a positive integer.\n    \"\"\"\n    if n <= 0:\n        raise ValueError(\"n must be a positive integer.\")\n\n    s = n * (n + 1) // 2\n    a = float(s) / n\n    return (s, a)"}
