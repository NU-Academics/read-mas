{"task_id": "Mbpp/604", "solution": "class StringEntity:\n    \"\"\"Represents a string for processing within the word reversal system.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n\nclass WordReverser:\n    \"\"\"Handles the core logic for reversing the order of words in a string.\"\"\"\n    def reverse_words(self, input_str: str) -> str:\n        string_entity = StringEntity(input_str)\n        words = string_entity.value.split(' ')\n        words.reverse()\n        return ' '.join(words)\n\ndef reverse_words(input: str) -> str:\n    \"\"\"Reverses the order of words in a string, preserving individual words and punctuation.\"\"\"\n    reverser = WordReverser()\n    return reverser.reverse_words(input)"}
{"task_id": "Mbpp/603", "solution": "def get_ludic(n: int) -> list[int]:\n    \"\"\"\n    Calculates all Ludic numbers less than or equal to n using a sieve method.\n    Ludic numbers are generated by iteratively removing elements from a sequence\n    based on the value of the current Ludic number.\n    \"\"\"\n    if n < 1:\n        return []\n\n    # Initialize a boolean array, where is_ludic[k] is True if k is a candidate Ludic number.\n    # Index 0 is unused. All numbers from 1 to n are initially candidates.\n    is_ludic = [True] * (n + 1)\n    is_ludic[0] = False  # 0 is not a Ludic number and not used for calculation\n\n    ludic_numbers = []\n\n    # Iterate through numbers from 1 to n\n    for i in range(1, n + 1):\n        if is_ludic[i]:\n            # If i is still marked as Ludic, it is the next Ludic number.\n            ludic_numbers.append(i)\n\n            # Sieve out numbers based on the value of i (the current Ludic number)\n            # We need to count 'active' (True) numbers and mark every i-th one as False.\n            skip_step = i\n            if skip_step == 1:\n                # For Ludic number 1, no numbers are removed by this step.\n                continue\n\n            count = 0\n            for j in range(i + 1, n + 1):\n                if is_ludic[j]:\n                    count += 1\n                    if count == skip_step:\n                        is_ludic[j] = False\n                        count = 0 # Reset count after marking one number for removal\n    \n    return ludic_numbers"}
{"task_id": "Mbpp/605", "solution": "import math\n\ndef prime_num(n):\n    \"\"\"\n    Checks if the given integer is a prime number.\n    Returns True if n is prime, False otherwise.\n    \"\"\"\n    if n < 2:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n    \n    # Check for divisibility from 3 up to sqrt(n)\n    # Optimized to check only odd numbers\n    for i in range(3, int(math.sqrt(n)) + 1, 2):\n        if n % i == 0:\n            return False\n            \n    return True"}
