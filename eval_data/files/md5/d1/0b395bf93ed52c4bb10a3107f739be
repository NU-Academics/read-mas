{"task_id": "Mbpp/800", "solution": "class WhitespaceRemover:\n    \"\"\"\n    Encapsulates the logic for removing all whitespace characters from a string.\n    Processes the input character by character to build a new string.\n    \"\"\"\n    def remove_all_spaces(self, input: str) -> str:\n        \"\"\"\n        Removes all Unicode whitespace characters from the input string.\n        It iterates through the string and appends non-whitespace characters.\n        \"\"\"\n        result_chars = []\n        for char in input:\n            if not char.isspace():\n                result_chars.append(char)\n        return \"\".join(result_chars)\n\ndef remove_all_spaces(input: str) -> str:\n    \"\"\"\n    Removes all whitespace characters from a string.\n    This function delegates the core logic to an instance of WhitespaceRemover.\n    \"\"\"\n    remover = WhitespaceRemover()\n    return remover.remove_all_spaces(input)"}
{"task_id": "Mbpp/799", "solution": "def left_rotate(number, d):\n    \"\"\"\n    Rotates the bits of a 32-bit number to the left by d positions.\n    The number is treated as an unsigned 32-bit integer.\n    \"\"\"\n    BIT_WIDTH = 32\n    # Ensure number is treated as a 32-bit unsigned integer\n    number = number & ((1 << BIT_WIDTH) - 1)\n    # Normalize the shift amount\n    d = d % BIT_WIDTH\n\n    # Perform the left rotation\n    # (number << d) shifts bits to the left, potentially exceeding 32 bits\n    # (number >> (BIT_WIDTH - d)) gets the bits that wrap around from the most significant end\n    rotated = (number << d) | (number >> (BIT_WIDTH - d))\n\n    # Mask the result to ensure it stays within 32 bits\n    return rotated & ((1 << BIT_WIDTH) - 1)"}
{"task_id": "Mbpp/801", "solution": "def test_three_equal(a, b, c):\n    \"\"\"\n    Counts the number of equal integers among a, b, and c.\n    Returns 3 if all are equal, 2 if exactly two are equal, or 0 if all are distinct.\n    \"\"\"\n    if a == b == c:\n        return 3\n    elif a == b or a == c or b == c:\n        return 2\n    else:\n        return 0"}
{"task_id": "Mbpp/803", "solution": "import math\n\ndef is_perfect_square(number: int) -> bool:\n    \"\"\"\n    Checks if the given number is a perfect square.\n    Returns False for negative inputs.\n    \"\"\"\n    if number < 0:\n        return False\n    # Calculate the integer square root.\n    root = math.isqrt(number)\n    return root * root == number"}
{"task_id": "Mbpp/804", "solution": "def is_product_even(numbers: list) -> bool:\n    \"\"\"\n    Checks if the product of numbers in a list is even.\n    Returns True if any number in the list is even; otherwise, returns False.\n    \"\"\"\n    if not numbers:\n        return False\n    \n    for num in numbers:\n        if num % 2 == 0:\n            return True\n            \n    return False"}
{"task_id": "Mbpp/805", "solution": "from typing import List\n\ndef max_sum_list(input_list: List[List[int]]) -> List[int]:\n    \"\"\"\n    Returns the sublist in a list of lists whose sum of elements is the highest.\n    Raises ValueError if any element in the sublists is not an integer.\n    \"\"\"\n    if not input_list:\n        return []\n\n    max_sum_val = -float('inf')\n    max_sublist_result = []\n\n    for sublist in input_list:\n        for element in sublist:\n            if not isinstance(element, int):\n                raise ValueError(\"All elements in sublists must be integers.\")\n        \n        current_sum = sum(sublist)\n        \n        if current_sum > max_sum_val:\n            max_sum_val = current_sum\n            max_sublist_result = sublist\n            \n    return max_sublist_result"}
{"task_id": "Mbpp/806", "solution": "def max_run_uppercase(input_string: str) -> int:\n    \"\"\"\n    Finds the maximum run of uppercase characters in the given string.\n    The algorithm iterates once, tracking current and maximum run lengths.\n    \"\"\"\n    max_len = 0\n    current_len = 0\n    for char_code in map(ord, input_string):\n        if 65 <= char_code <= 90:  # ASCII 'A' to 'Z'\n            current_len += 1\n        else:\n            max_len = max(max_len, current_len)\n            current_len = 0\n    return max(max_len, current_len)"}
{"task_id": "Mbpp/807", "solution": "from typing import List, Optional\n\ndef first_odd(numbers: List[int]) -> Optional[int]:\n    \"\"\"\n    Finds the first odd number in a given list of numbers.\n    Returns None if no odd number is found.\n    \"\"\"\n    for num in numbers:\n        if num % 2 != 0:\n            return num\n    return None"}
{"task_id": "Mbpp/809", "solution": "def check_smaller(tuple1, tuple2):\n    \"\"\"\n    Return True if every element in tuple2 is strictly smaller than the\n    corresponding element in tuple1. Raises ValueError if tuples differ in length.\n    \"\"\"\n    if len(tuple1) != len(tuple2):\n        raise ValueError(f\"Tuple lengths differ: len(tuple1)={len(tuple1)}, len(tuple2)={len(tuple2)}\")\n    return all(a > b for a, b in zip(tuple1, tuple2))"}
