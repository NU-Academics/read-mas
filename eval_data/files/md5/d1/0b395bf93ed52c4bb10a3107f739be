{"task_id": "Mbpp/765", "solution": "def find_nth_polite_number(n: int) -> int:\n    \"\"\"\n    Finds the nth polite number. A polite number is a positive integer that is not a power of two.\n    The function iterates through integers, counting polite numbers until the nth one is found.\n    \"\"\"\n    count = 0\n    num = 0\n    while count < n:\n        num += 1\n        # Check if 'num' is not a power of two using bitwise operations:\n        # A positive integer x is a power of two if (x & (x - 1)) == 0.\n        # So, if (num & (num - 1)) != 0, it means 'num' is not a power of two.\n        if (num & (num - 1)) != 0:\n            count += 1\n    return num"}
{"task_id": "Mbpp/766", "solution": "from typing import Any, List, Tuple\n\ndef pair_wise(items: List[Any]) -> List[Tuple[Any, Any]]:\n    \"\"\"Return a list of consecutive pairs from *items*. If *items* has fewer than two elements, an empty list is returned.\"\"\"\n    length = len(items)\n    if length < 2:\n        return []\n\n    result: List[Tuple[Any, Any]] = [] # Preallocate output list for O(n) memory usage\n    for i in range(length - 1):\n        result.append((items[i], items[i + 1]))\n    return result"}
{"task_id": "Mbpp/767", "solution": "```python\nfrom typing import List\n\ndef get_pairs_count(numbers: List[int], target_sum: int) -> int:\n    \"\"\"\n    Counts the number of unordered pairs in `numbers` whose sum equals `target_sum`.\n    This implementation uses a nested loop for an O(n^2) time complexity.\n    \"\"\"\n    count = 0\n    n = len(numbers)\n    for i in range(n):\n        for j in range(i + 1, n):\n            if numbers[i] + numbers[j] == target_sum:\n                count += 1\n    return count\n```"}
{"task_id": "Mbpp/769", "solution": "def Diff(list1: list, list2: list) -> list:\n    \"\"\"\n    Returns elements from list1 that are not in list2, preserving order.\n    Uses a set for efficient lookup of elements from list2.\n    \"\"\"\n    exclusion_set = set(list2)\n    result = [item for item in list1 if item not in exclusion_set]\n    return result"}
{"task_id": "Mbpp/770", "solution": "class OddNumberSequence:\n    \"\"\"\n    Provides the k-th odd natural number.\n    \"\"\"\n\n    @staticmethod\n    def get_nth_odd(k: int) -> int:\n        \"\"\"\n        Return the k-th odd natural number, where k is a 1-based index.\n        \"\"\"\n        return 2 * k - 1\n\n\nclass SumCalculator:\n    \"\"\"\n    Computes the sum of fourth powers of odd numbers.\n    \"\"\"\n\n    def compute_sum(self, n: int) -> int:\n        \"\"\"\n        Compute the sum of the fourth powers of the first n odd natural numbers.\n        \"\"\"\n        total = 0\n        for k in range(1, n + 1):\n            odd = OddNumberSequence.get_nth_odd(k)\n            total += odd ** 4\n        return total\n\n\ndef odd_num_sum(n: int) -> int:\n    \"\"\"\n    Return the sum of the fourth powers of the first n odd natural numbers.\n    Raises ValueError if n is negative.\n    \"\"\"\n    if n < 0:\n        raise ValueError(\"n must be a non\u2011negative integer.\")\n    calculator = SumCalculator()\n    return calculator.compute_sum(n)"}
{"task_id": "Mbpp/771", "solution": "def check_expression(expression: str) -> bool:\n    \"\"\"\n    Checks if the given expression has balanced brackets.\n    Returns True if balanced, False otherwise.\n    \"\"\"\n    stack = []\n    \n    # Mappings for opening and closing brackets\n    opening_brackets = \"([{\"\n    closing_brackets = \")]}\"\n    bracket_map = {')': '(', ']': '[', '}': '{'}\n    \n    # All characters considered valid in the expression for balancing purposes\n    all_valid_chars = set(opening_brackets + closing_brackets)\n\n    for char in expression:\n        if char not in all_valid_chars:\n            # As per FR3, any character not a bracket makes the expression invalid\n            return False\n            \n        if char in opening_brackets:\n            stack.append(char)\n        elif char in closing_brackets:\n            if not stack:\n                return False  # Unmatched closing bracket\n            \n            last_open = stack.pop()\n            if last_open != bracket_map[char]:\n                return False  # Mismatched bracket type\n\n    return not stack # If stack is empty, all brackets were matched"}
{"task_id": "Mbpp/772", "solution": "def remove_length(text: str, k: int) -> str:\n    \"\"\"Removes all words of a specified length k from an input string.\"\"\"\n    words = text.split()\n    filtered_words = [word for word in words if len(word) != k]\n    return ' '.join(filtered_words)"}
{"task_id": "Mbpp/773", "solution": "from typing import Optional, Tuple\n\ndef occurance_substring(text: str, sub: str) -> Optional[Tuple[str, int, int]]:\n    \"\"\"\n    Finds the first occurrence of a substring within a string.\n    Returns a tuple (substring, start_index, end_index) or None if not found.\n    \"\"\"\n    start_index = text.find(sub)\n    if start_index == -1:\n        return None\n    \n    end_index = start_index + len(sub)\n    return (sub, start_index, end_index)"}
