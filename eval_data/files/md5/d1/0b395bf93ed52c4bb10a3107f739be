{"task_id": "Mbpp/633", "solution": "import itertools\n\ndef _generate_pairs(numbers):\n    \"\"\"Yield all unique unordered pairs from the list.\"\"\"\n    return itertools.combinations(numbers, 2)\n\ndef _xor_pair(a, b):\n    \"\"\"Return the bitwise XOR of two integers.\"\"\"\n    return a ^ b\n\ndef pair_xor_Sum(numbers):\n    \"\"\"Compute the sum of XOR of all unique unordered pairs in the list.\"\"\"\n    if len(numbers) < 2:\n        return 0\n    total = 0\n    for a, b in _generate_pairs(numbers):\n        total += _xor_pair(a, b)\n    return total"}
{"task_id": "Mbpp/635", "solution": "from typing import List\n\ndef heap_sort(lst: List[int]) -> List[int]:\n    \"\"\"\n    Sorts a list of integers in ascending order using the heap sort algorithm.\n    Returns a new list with the sorted elements.\n    \"\"\"\n    n = len(lst)\n    heap = list(lst) # Create a mutable copy of the list to perform sorting in-place on the copy.\n\n    def _sift_down(current_heap: List[int], start_idx: int, end_idx: int) -> None:\n        \"\"\"Helper function to maintain the max-heap property for a sub-tree.\"\"\"\n        root = start_idx\n        while True:\n            child = 2 * root + 1\n            if child >= end_idx:\n                break\n            if child + 1 < end_idx and current_heap[child] < current_heap[child + 1]:\n                child += 1\n            if current_heap[root] < current_heap[child]:\n                current_heap[root], current_heap[child] = current_heap[child], current_heap[root]\n                root = child\n            else:\n                break\n\n    # Build max-heap (rearrange array)\n    for i in range(n // 2 - 1, -1, -1):\n        _sift_down(heap, i, n)\n\n    # One by one extract elements from heap\n    for end_idx in range(n - 1, 0, -1):\n        # Move current root to end_idx\n        heap[0], heap[end_idx] = heap[end_idx], heap[0]\n        # Call _sift_down on the reduced heap\n        _sift_down(heap, 0, end_idx)\n\n    return heap"}
