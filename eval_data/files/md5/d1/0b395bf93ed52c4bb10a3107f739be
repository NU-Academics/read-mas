{"task_id": "Mbpp/260", "solution": "import math\n\nclass PrimeChecker:\n    \"\"\"Checks if a given number is prime.\"\"\"\n    def is_prime(self, value: int) -> bool:\n        if value < 2:\n            return False\n        if value == 2:\n            return True\n        if value % 2 == 0:\n            return False\n        i = 3\n        while i * i <= value:\n            if value % i == 0:\n                return False\n            i += 2\n        return True\n\nclass Sequence:\n    \"\"\"Generates numbers in the Newman-Shanks-Williams sequence using W_0=1, W_1=1, W_n=3W_{n-1}+W_{n-2}.\"\"\"\n    def __init__(self):\n        self._w_n_minus_2 = 1  # Corresponds to W_0\n        self._w_n_minus_1 = 1  # Corresponds to W_1\n        self._index = 0\n\n    def next(self) -> int:\n        if self._index == 0:\n            self._index = 1\n            return self._w_n_minus_2 # Returns W_0 = 1\n        elif self._index == 1:\n            self._index = 2\n            return self._w_n_minus_1 # Returns W_1 = 1\n        else:\n            w_n = 3 * self._w_n_minus_1 + self._w_n_minus_2\n            self._w_n_minus_2 = self._w_n_minus_1\n            self._w_n_minus_1 = w_n\n            self._index += 1\n            return w_n\n\nclass NSWPrimeGenerator:\n    \"\"\"Orchestrates the generation and checking of NSW primes.\"\"\"\n    def __init__(self):\n        self._sequence = Sequence()\n        self._prime_checker = PrimeChecker()\n\n    def newman_prime(self, n: int) -> int:\n        if not isinstance(n, int) or n <= 0:\n            raise ValueError(\"Input 'n' must be a positive integer.\")\n\n        # Handle specific initial cases as per FR4\n        if n == 1:\n            return 2\n        if n == 2:\n            return 3\n        if n == 3:\n            return 7\n\n        # For n > 3, we have already accounted for 3 primes (2, 3, 7).\n        # We now need to find the (n-3)th prime from the W_k sequence defined by FR2.\n        primes_found = 3\n        current_prime_value = None\n\n        # Iterate through the W_k sequence starting from W_0, W_1, W_2, ...\n        # W_0=1, W_1=1, W_2=4, W_3=13, W_4=43, ...\n        while primes_found < n:\n            current_nsw_value = self._sequence.next()\n            if self._prime_checker.is_prime(current_nsw_value):\n                primes_found += 1\n                current_prime_value = current_nsw_value\n        \n        return current_prime_value\n\ndef newman_prime(n: int) -> int:\n    \"\"\"\n    Finds the nth Newman\u2013Shanks\u2013Williams prime number.\n    Handles specific initial primes and then uses the defined\n    recurrence relation for subsequent primes.\n    \"\"\"\n    generator = NSWPrimeGenerator()\n    return generator.newman_prime(n)"}
{"task_id": "Mbpp/265", "solution": "def list_split(lst, n):\n    \"\"\"\n    Splits a list into n sublists, where each element is placed in a sublist\n    based on its original index modulo n.\n    \"\"\"\n    result = [[] for _ in range(n)]\n    for i, item in enumerate(lst):\n        result[i % n].append(item)\n    return result"}
