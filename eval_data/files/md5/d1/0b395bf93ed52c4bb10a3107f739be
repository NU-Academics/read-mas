{"task_id": "Mbpp/778", "solution": "from typing import List, Any\n\ndef pack_consecutive_duplicates(input_list: List[Any]) -> List[List[Any]]:\n    \"\"\"\n    Groups consecutive duplicate elements of a list into sub-lists.\n    The order of elements is preserved.\n    \"\"\"\n    if not input_list:\n        return []\n\n    result: List[List[Any]] = []\n    current_group: List[Any] = [input_list[0]]\n\n    for element in input_list[1:]:\n        if element == current_group[-1]:\n            current_group.append(element)\n        else:\n            result.append(current_group)\n            current_group = [element]\n\n    result.append(current_group)\n    return result"}
{"task_id": "Mbpp/780", "solution": "import typing\n\ndef find_combinations(input_tuples: typing.List[typing.Tuple[int, int]]) -> typing.List[typing.Tuple[int, int]]:\n    \"\"\"\n    Finds combinations of sums of corresponding elements from unique pairs of tuples in a list.\n    Generates all unique pairwise combinations and sums their elements.\n    \"\"\"\n    results = []\n    n = len(input_tuples)\n\n    for i in range(n):\n        for j in range(i + 1, n):\n            tuple1 = input_tuples[i]\n            tuple2 = input_tuples[j]\n            sum_tuple = (tuple1[0] + tuple2[0], tuple1[1] + tuple2[1])\n            results.append(sum_tuple)\n\n    return results"}
{"task_id": "Mbpp/781", "solution": "def count_divisors(n: int) -> bool:\n    \"\"\"\n    Checks if the count of divisors for a positive integer n is even.\n    Returns True if the divisor count is even, False otherwise.\n    \"\"\"\n    count = 0\n    i = 1\n    while i * i <= n:\n        if n % i == 0:\n            if i * i == n:\n                count += 1\n            else:\n                count += 2\n        i += 1\n    return count % 2 == 0"}
{"task_id": "Mbpp/782", "solution": "from typing import List\n\ndef odd_length_sum(arr: List[int]) -> int:\n    \"\"\"Calculates the sum of all sub-arrays with odd lengths from a given list.\"\"\"\n    total = 0\n    n = len(arr)\n    for start in range(n):\n        current_sum = 0\n        for end in range(start, n):\n            current_sum += arr[end]\n            if (end - start + 1) % 2 == 1:\n                total += current_sum\n    return total"}
{"task_id": "Mbpp/784", "solution": "def mul_even_odd(numbers: list[int]) -> int | None:\n    \"\"\"Finds the product of the first even and first odd number in a list.\n    Returns None if either number is not found.\"\"\"\n    first_even = None\n    first_odd = None\n\n    for num in numbers:\n        if first_even is None and num % 2 == 0:\n            first_even = num\n        if first_odd is None and num % 2 != 0:\n            first_odd = num\n\n        if first_even is not None and first_odd is not None:\n            return first_even * first_odd\n\n    return None"}
{"task_id": "Mbpp/785", "solution": "def tuple_str_int(tuple_string: str) -> tuple[int, ...]:\n    \"\"\"Converts a string representation of an integer tuple to an actual integer tuple.\"\"\"\n    # Remove parentheses, split by comma, strip whitespace, and convert to int\n    elements_str = tuple_string[1:-1].split(',')\n    integer_elements = [int(s.strip()) for s in elements_str]\n    return tuple(integer_elements)"}
