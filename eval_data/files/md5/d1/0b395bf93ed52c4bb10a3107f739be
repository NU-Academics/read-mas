{"task_id": "Mbpp/388", "solution": "def highest_Power_of_2(n: int) -> int:\n    if not isinstance(n, int):\n        raise TypeError(\"Input must be an integer\")\n    if n < 0:\n        raise ValueError(\"Input must be non\u2011negative\")\n    if n == 0:\n        return 0\n    # Clear all bits except the most significant one.\n    # This effectively finds the largest power of 2 less than or equal to n.\n    return 1 << (n.bit_length() - 1)"}
{"task_id": "Mbpp/389", "solution": "def find_lucas(n: int) -> int:\n    \"\"\"\n    Finds the n'th Lucas number using an iterative approach.\n    Assumes n is a non-negative integer.\n    \"\"\"\n    if n == 0:\n        return 2\n    if n == 1:\n        return 1\n\n    a, b = 2, 1  # L0 = 2, L1 = 1\n    for _ in range(2, n + 1):\n        a, b = b, a + b\n    return b"}
{"task_id": "Mbpp/391", "solution": "from typing import Any, Dict, List\n\n\ndef convert_list_dictionary(\n    list1: List[Any], list2: List[Any], list3: List[Any]\n) -> List[Dict[Any, Dict[Any, Any]]]:\n    \"\"\"\n    Convert three parallel lists into a list of nested dictionaries.\n    Raises ValueError if input lists are not of equal length.\n    \"\"\"\n    if not (len(list1) == len(list2) == len(list3)):\n        raise ValueError(\"All input lists must have the same length.\")\n\n    result: List[Dict[Any, Dict[Any, Any]]] = []\n\n    for outer_key, inner_key, value in zip(list1, list2, list3):\n        nested_dict: Dict[Any, Any] = {inner_key: value}\n        outer_dict: Dict[Any, Dict[Any, Any]] = {outer_key: nested_dict}\n        result.append(outer_dict)\n\n    return result"}
{"task_id": "Mbpp/390", "solution": "from typing import List, Any\n\ndef add_string(elements: List[Any], format_string: str) -> List[str]:\n    \"\"\"\n    Apply a format string to each element in a list.\n    Returns a new list containing each element formatted by `format_string`.\n    \"\"\"\n    if not elements:\n        return []\n\n    try:\n        # Pre-compile the format string for efficiency\n        formatter = format_string.format\n        # Apply formatting to each element after converting to string\n        return [formatter(str(el)) for el in elements]\n    except Exception as exc:\n        raise ValueError(f\"Invalid format string: {format_string}\") from exc"}
