{"task_id": "Mbpp/479", "solution": "class Digit:\n    \"\"\"Represents a single decimal digit.\"\"\"\n    def __init__(self, value: int):\n        if not 0 <= value <= 9:\n            raise ValueError(\"Digit value must be between 0 and 9.\")\n        self.value = value\n\nclass Number:\n    \"\"\"Domain entity that encapsulates an integer and can compute its first digit.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def getFirstDigit(self) -> Digit:\n        \"\"\"Return the first digit of the integer's decimal representation.\"\"\"\n        abs_value = abs(self.value)\n        if abs_value == 0:\n            return Digit(0)\n        first_digit = int(str(abs_value)[0])\n        return Digit(first_digit)\n\ndef first_Digit(number: int) -> int:\n    \"\"\"Public API that returns the first digit of an integer.\"\"\"\n    num = Number(number)\n    return num.getFirstDigit().value"}
{"task_id": "Mbpp/478", "solution": "def remove_lowercase(s: str) -> str:\n    \"\"\"Removes all lowercase characters from the input string, preserving the order of uppercase characters.\"\"\"\n    return ''.join(char for char in s if char.isupper())"}
{"task_id": "Mbpp/554", "solution": "def Split(numbers: list[int]) -> list[int]:\n    \"\"\"\n    Returns a new list containing only the odd integers from the input list.\n    The function is pure and does not modify the input list.\n    \"\"\"\n    return [num for num in numbers if num % 2 != 0]"}
{"task_id": "Mbpp/556", "solution": "def find_Odd_Pair(numbers: list[int], n: int) -> int:\n    \"\"\"\n    Count unordered pairs in `numbers` whose XOR value is odd.\n    An odd XOR results from pairing an even number with an odd number.\n    \"\"\"\n    if not numbers:\n        return 0\n\n    # The parameter 'n' is ignored as per design, actual length is used.\n    even_count = 0\n    for num in numbers:\n        if num % 2 == 0:\n            even_count += 1\n    \n    odd_count = len(numbers) - even_count\n\n    return even_count * odd_count"}
{"task_id": "Mbpp/555", "solution": "def difference(n: int) -> int:\n    \"\"\"\n    Calculates the difference between the sum of cubes of the first n natural numbers\n    and the sum of the first n natural numbers using optimized formulas.\n    \"\"\"\n    sum_of_numbers = n * (n + 1) // 2\n    sum_of_cubes = sum_of_numbers ** 2\n    return sum_of_cubes - sum_of_numbers"}
{"task_id": "Mbpp/557", "solution": "def toggle_string(input: str) -> str:\n    \"\"\"Toggles the case of all characters in a string.\n    Alphabetic characters have their case inverted, others remain unchanged.\n    \"\"\"\n    toggled_chars = []\n    for char in input:\n        if char.islower():\n            toggled_chars.append(char.upper())\n        elif char.isupper():\n            toggled_chars.append(char.lower())\n        else:\n            toggled_chars.append(char)\n    return \"\".join(toggled_chars)"}
{"task_id": "Mbpp/558", "solution": "def digit_distance_nums(a: int, b: int) -> int:\n    \"\"\"\n    Calculates the sum of absolute per-digit differences between two non-negative integers.\n    Digits are aligned from the least significant digit, padding with zeros where necessary.\n    \"\"\"\n    str_a = str(a)\n    str_b = str(b)\n    \n    # Reverse strings to easily process digits from LSB to MSB\n    rev_str_a = str_a[::-1]\n    rev_str_b = str_b[::-1]\n    \n    max_len = max(len(rev_str_a), len(rev_str_b))\n    total_difference = 0\n    \n    for i in range(max_len):\n        digit_a = int(rev_str_a[i]) if i < len(rev_str_a) else 0\n        digit_b = int(rev_str_b[i]) if i < len(rev_str_b) else 0\n        \n        total_difference += abs(digit_a - digit_b)\n        \n    return total_difference"}
{"task_id": "Mbpp/559", "solution": "def max_sub_array_sum(arr, n):\n    \"\"\"\n    Finds the sum of the largest contiguous sublist in the given list using Kadane's algorithm.\n    The parameter 'n' is not used as the algorithm processes the input list directly.\n    \"\"\"\n    max_so_far = arr[0]\n    current_max = arr[0]\n\n    for i in range(1, len(arr)):\n        current_max = max(arr[i], current_max + arr[i])\n        max_so_far = max(max_so_far, current_max)\n\n    return max_so_far"}
{"task_id": "Mbpp/560", "solution": "def union_elements(a: tuple[int], b: tuple[int]) -> tuple[int]:\n    \"\"\"\n    Return a tuple containing the sorted union of the elements of two input tuples.\n    \"\"\"\n    union_set = set(a) | set(b)\n    sorted_list = sorted(union_set)\n    return tuple(sorted_list)"}
{"task_id": "Mbpp/562", "solution": "from typing import List, Any\n\ndef Find_Max_Length(list_of_lists: List[List[Any]]) -> int:\n    \"\"\"\n    Returns the length of the longest sublist in list_of_lists.\n    If list_of_lists is empty, returns 0.\n    \"\"\"\n    if not list_of_lists:\n        return 0\n    max_len = 0\n    for sublist in list_of_lists:\n        sub_len = len(sublist)\n        if sub_len > max_len:\n            max_len = sub_len\n    return max_len"}
{"task_id": "Mbpp/563", "solution": "```python\nimport re\nfrom typing import List\n\ndef extract_values(input_string: str) -> List[str]:\n    \"\"\"\n    Extracts values enclosed in double quotation marks from a string.\n    Ignores escaped quotation marks.\n    \"\"\"\n    # Use re.findall to find all non-escaped quoted strings.\n    # The pattern finds a double quote, then captures any characters\n    # that are not a backslash or a double quote, or an escaped double quote.\n    return re.findall(r'\"((?:[^\"\\\\]|\\\\.)*)\"', input_string)\n```"}
