 return True\n\n    current_arr = list(arr) # Work on a copy to avoid modifying the original input if desired, though not strictly required by problem.\n\n    # Iterate through all possible N rotations (0 to N-1 shifts)\n    for _ in range(n):\n        if is_rotation_sorted(current_arr):\n            return True\n        current_arr = right_shift(current_arr)\n\n    return False", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/111": [{"task_id": "HumanEval/111", "solution": "class LetterToken:\n    \"\"\"Represents a single token (single lowercase letter).\"\"\"\n    def __init__(self, char: str):\n        self.char = char\nclass InputString:\n    \"\"\"Holds the raw test string and provides utility methods.\"\"\"\n    def __init__(self, raw: str):\n        self.raw = raw\n\n    def is_empty(self) -> bool:\n        \"\"\"Checks if the raw string is empty.\"\"\"\n        return self.raw == ''\n\n    def validate(self) -> bool:\n        \"\"\"Validates the raw string. Behavior on invalid tokens is unspecified.\"\"\"\n        # Per design, this method is called but its return value's effect is unspecified.\n        # For the given SRS, we assume valid input or handle via tokenization logic.\n        return True\n\n    def tokenize(self) -> list[LetterToken]:\n        \"\"\"Splits raw string into LetterToken objects.\"\"\"\n        if self.is_empty():\n            return []\n        \n        tokens = []\n        for char_str in self.raw.split(' '):\n            if char_str: # Filter out empty strings that might result from multiple spaces\n                tokens.append(LetterToken(char_str))\n        return tokens\nclass FrequencyMap:\n    \"\"\"Maintains counts per letter and provides maxima queries.\"\"\"\n    def __init__(self):\n        self.counts = {}\n\n    def increment(self, letter: str) -> None:\n        \"\"\"Increments the count for a given letter.\"\"\"\n        self.counts[letter] = self.counts.get(letter, 0) + 1\n\n    def get(self, letter: str) -> int:\n        \"\"\"Returns the count for a given letter.\"\"\"\n        return self.counts.get(letter, 0)\n\n    def max_count(self) -> int:\n        \"\"\"Returns the maximum occurrence count.\"\"\"\n        if not self.counts:\n            return 0\n        return max(self.counts.values())\n\n    def max_letters(self) -> list[str]:\n        \"\"\"Returns a list of letters with the maximum occurrence count.\"\"\"\n        if not self.counts:\n            return []\n        \n        max_c = self.max_count()\n        letters_with_max = []\n        for letter, count in self.counts.items():\n            if count == max_c:\n                letters_with_max.append(letter)\n        return letters_with_max\nclass ResultDictionary:\n    \"\"\"Builds and exposes the final result dictionary.\"\"\"\n    def __init__(self):\n        self.result = {}\n\n    def to_dict(self) -> dict[str, int]:\n        \"\"\"Returns the constructed dictionary.\"\"\"\n        return self.result\ndef histogram(test):\n    \"\"\"Given a string representing a space separated lowercase letters, return a dictionary\n    of the letter with the most repetition and containing the corresponding count.\n    If several letters have the same occurrence, return all of them.\n    \n    Example:\n    histogram('a b c') == {'a': 1, 'b': 1, 'c': 1}\n    histogram('a b b a') == {'a': 2, 'b': 2}\n    histogram('a b c a b') == {'a': 2, 'b': 2}\n    histogram('b b b b a') == {'b': 4}\n    histogram('') == {}\n\n    \"\"\"\n    input_obj = InputString(test)\n    if input_obj.is_empty():\n        return {}\n\n    # As per design, call validate method, but its return value's effect is unspecified.\n    _ = input_obj.validate()\n\n    tokens = input_obj.tokenize()\n    freq = FrequencyMap()\n    for token in tokens:\n        freq.increment(token.char)\n    \n    max_letters = freq.max_letters()\n    \n    result = ResultDictionary()\n    for letter in max_letters:\n        result.result[letter] = freq.get(letter)\n        \n    return result.to_dict()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/112": [{"task_id": "HumanEval/112", "solution": "class InputStrings:\n    \"\"\"Encapsulates input strings s and c.\"\"\"\n    def __init__(self, s: str, c: str):\n        self.s = s\n        self.c = c\n\n    def get_chars(self) -> str:\n        \"\"\"Returns the character set string c.\"\"\"\n        return self.c\nclass CharacterSet:\n    \"\"\"Represents a set of characters for efficient containment checks.\"\"\"\n    def __init__(self, chars: set[str]):\n        self.chars = chars\n\n    @staticmethod\n    def from_string(s: str) -> 'CharacterSet':\n        \"\"\"Creates a CharacterSet from a string.\"\"\"\n        return CharacterSet(set(s))\n\n    def contains(self, ch: str) -> bool:\n        \"\"\"Checks if a character is in the set.\"\"\"\n        return ch in self.chars\nclass FilteredString:\n    \"\"\"Maintains the filtered result string.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the filtered string.\"\"\"\n        return len(self.value)\n\n    def to_string(self) -> str:\n        \"\"\"Returns the filtered string.\"\"\"\n        return self.value\nclass PalindromeChecker:\n    \"\"\"Evaluates if a string is a palindrome.\"\"\"\n    @staticmethod\n    def is_palindrome(s: str) -> bool:\n        \"\"\"Checks if the given string is a palindrome.\"\"\"\n        return s == s[::-1]\ndef reverse_delete(s, c):\n    \"\"\"Deletes characters from s present in c and checks if the result is a palindrome.\n    Returns a tuple (filtered_string, is_palindrome_status).\n    \"\"\"\n    inputs = InputStrings(s, c)\n    char_set = CharacterSet.from_string(inputs.c)\n\n    filtered_chars_list = []\n    for ch in inputs.s:\n        if not char_set.contains(ch):\n            filtered_chars_list.append(ch)\n\n    result_str_value = \"\".join(filtered_chars_list)\n    filt = FilteredString(result_str_value)\n\n    is_pal = PalindromeChecker.is_palindrome(filt.value)\n\n    return (filt.value, is_pal)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/114": [{"task_id": "HumanEval/114", "solution": "def minSubArraySum(nums):\n    \"\"\"\n    Given an array of integers nums, find the minimum sum of any non-empty sub-array\n    of nums.\n    Example\n    minSubArraySum([2, 3, 4, 1, 2, 4]) == 1\n    minSubArraySum([-1, -2, -3]) == -6\n    \"\"\"\n    # Kadane's algorithm for minimum subarray sum.\n    # Initialize min_ending_here and min_so_far with the first element.\n    # Assumes nums is non-empty as per design context for InputArray validation.\n    min_ending_here = nums[0]\n    min_so_far = nums[0]\n\n    for i in range(1, len(nums)):\n        # For the current number, the minimum sum ending here is either the number itself\n        # or the number added to the minimum sum ending at the previous position.\n        min_ending_here = min(nums[i], min_ending_here + nums[i])\n        \n        # The overall minimum sum found so far is the minimum of the current min_so_far\n        # and the min_ending_here for the current position.\n        min_so_far = min(min_so_far, min_ending_here)\n\n    return min_so_far", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/110": [{"task_id": "HumanEval/110", "solution": "from typing import List, Tuple, Union\nclass Element:\n    \"\"\"Domain value object for a single element.\"\"\"\n    def __init__(self, value: Union[int, float], index: int):\n        self.value = value\n        self.index = index\n\n    def isEven(self) -> bool:\n        \"\"\"Checks if the element's value is an integer divisible by 2 with no remainder.\"\"\"\n        return isinstance(self.value, int) and self.value % 2 == 0\nclass InputList:\n    \"\"\"Domain container for list of Element instances.\"\"\"\n    def __init__(self, id: str, raw_list: List[Union[int, float]]):\n        self.id = id\n        self.elements = [Element(value, i) for i, value in enumerate(raw_list)]\n\n    def length(self) -> int:\n        return len(self.elements)\n\n    def get(self, index: int) -> Element:\n        return self.elements[index]\n\n    def __copy__(self) -> 'InputList':\n        \"\"\"Returns a new InputList instance with copied elements.\"\"\"\n        raw_values = [e.value for e in self.elements]\n        return InputList(self.id + \"_copy\", raw_values)\nclass ParityEvaluator:\n    \"\"\"Encapsulate parity rules and list-level parity checks.\"\"\"\n    def isEven(self, value: Union[int, float]) -> bool:\n        \"\"\"Returns True only if value is an integer divisible by 2 with zero remainder; non-integers return False.\"\"\"\n        return isinstance(value, int) and value % 2 == 0\n\n    def allEven(self, lst: InputList) -> bool:\n        \"\"\"Checks if all elements in the given InputList are even.\"\"\"\n        for element in lst.elements:\n            if not self.isEven(element.value):\n                return False\n        return True\nclass ExchangeOperation:\n    \"\"\"Represent a single conceptual swap between lst1 and lst2.\"\"\"\n    def __init__(self, indexInList1: int, indexInList2: int):\n        self.indexInList1 = indexInList1\n        self.indexInList2 = indexInList2\n\n    def apply(self, list1: InputList, list2: InputList) -> None:\n        \"\"\"Swaps elements at specified indices in the given InputList instances.\"\"\"\n        temp_value = list1.elements[self.indexInList1].value\n        list1.elements[self.indexInList1].value = list2.elements[self.indexInList2].value\n        list2.elements[self.indexInList2].value = temp_value\nclass ExchangeEngine:\n    \"\"\"Generate candidate swaps and simulate applying them.\"\"\"\n    def __init__(self, parity_evaluator: ParityEvaluator):\n        self.parity_evaluator = parity_evaluator\n\n    def generate_candidate_swaps(self, lst1: InputList, lst2: InputList) -> List[ExchangeOperation]:\n        \"\"\"Identify swaps where odd elements in lst1 can be swapped with even elements in lst2.\"\"\"\n        odd_indices_lst1 = [i for i, e in enumerate(lst1.elements) if not self.parity_evaluator.isEven(e.value)]\n        even_indices_lst2 = [i for i, e in enumerate(lst2.elements) if self.parity_evaluator.isEven(e.value)]\n\n        candidate_swaps = []\n        for i1 in odd_indices_lst1:\n            for i2 in even_indices_lst2:\n                candidate_swaps.append(ExchangeOperation(i1, i2))\n        return candidate_swaps\n\n    def simulate_apply(self, op: ExchangeOperation, lst1: InputList, lst2: InputList) -> Tuple[InputList, InputList]:\n        \"\"\"Returns new InputList instances representing result of applying op.\"\"\"\n        new_lst1 = lst1.__copy__()\n        new_lst2 = lst2.__copy__()\n        op.apply(new_lst1, new_lst2)\n        return new_lst1, new_lst2\nclass DecisionResult:\n    \"\"\"Encapsulate final decision string; must be exact literal \"YES\" or \"NO\".\"\"\"\n    def __init__(self, result: str):\n        self.result = result\n\n    def get(self) -> str:\n        return self.result\nclass DecisionEngine:\n    \"\"\"Determine feasibility of swap sequences and produce DecisionResult.\"\"\"\n    def __init__(self, parity_evaluator: ParityEvaluator, exchange_engine: ExchangeEngine):\n        self.parity_evaluator = parity_evaluator\n        self.exchange_engine = exchange_engine\n\n    def determine(self, lst1: InputList, lst2: InputList) -> DecisionResult:\n        \"\"\"Determines if lst1 can become all even by exchanging elements with lst2.\"\"\"\n        # Given \"no limit on the number of exchanged elements\", the problem simplifies\n        # to a counting problem: are there enough even numbers in lst2\n        # to replace all odd numbers in lst1?\n\n        needed_evens_for_lst1 = 0\n        for element in lst1.elements:\n            if not self.parity_evaluator.isEven(element.value):\n                needed_evens_for_lst1 += 1\n\n        available_evens_in_lst2 = 0\n        for element in lst2.elements:\n            if self.parity_evaluator.isEven(element.value):\n                available_evens_in_lst2 += 1\n\n        if available_evens_in_lst2 >= needed_evens_for_lst1:\n            return DecisionResult(\"YES\")\n        else:\n            return DecisionResult(\"NO\")\ndef exchange(lst1: list, lst2: list) -> str:\n    \"\"\"In this problem, you will implement a function that takes two lists of numbers,\n    and determines whether it is possible to perform an exchange of elements\n    between them to make lst1 a list of only even numbers.\n    There is no limit on the number of exchanged elements between lst1 and lst2.\n    If it is possible to exchange elements between the lst1 and lst2 to make\n    all the elements of lst1 to be even, return \"YES\".\n    Otherwise, return \"NO\".\n    For example:\n    exchange([1, 2, 3, 4], [1, 2, 3, 4]) => \"YES\"\n    exchange([1, 2, 3, 4], [1, 5, 3, 4]) => \"NO\"\n    It is assumed that the input lists will be non-empty.\n    \"\"\"\n    input_list1 = InputList(\"list1\", lst1)\n    input_list2 = InputList(\"list2\", lst2)\n\n    parity_evaluator = ParityEvaluator()\n\n    # Short-circuit if lst1 is already all even\n    if parity_evaluator.allEven(input_list1):\n        return DecisionResult(\"YES\").get()\n\n    exchange_engine = ExchangeEngine(parity_evaluator)\n    decision_engine = DecisionEngine(parity_evaluator, exchange_engine)\n\n    decision_result = decision_engine.determine(input_list1, input_list2)\n    return decision_result.get()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/113": [{"task_id": "HumanEval/113", "solution": "_TEMPLATE = \"the number of odd elements in the string i of the input.\"\n_ODD_DIGITS = {'1','3','5','7','9'}\ndef odd_count(lst):\n    \"\"\"Given a list of strings, where each string consists of only digits, return a list.\n    Each element i of the output should be \"the number of odd elements in the\n    string i of the input.\" where all the i's should be replaced by the number\n    of odd digits in the i'th string of the input.\n\n    >>> odd_count(['1234567'])\n    [\"the number of odd elements 4n the str4ng 4 of the 4nput.\"]\n    >>> odd_count(['3',\"11111111\"])\n    [\"the number of odd elements 1n the str1ng 1 of the 1nput.\",\n     \"the number of odd elements 8n the str8ng 8 of the 8nput.\"]\n    \"\"\"\n    results = []\n    for s in lst:\n        odd_digit_count = 0\n        for char in s:\n            if char in _ODD_DIGITS:\n                odd_digit_count += 1\n        \n        output_string = _TEMPLATE.replace('i', str(odd_digit_count))\n        results.append(output_string)\n    \n    return results", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/115": [{"task_id": "HumanEval/115", "solution": "import math\nclass InputValidator:\n    \"\"\"Validates incoming parameters to max_fill.\"\"\"\n\n    def __init__(self):\n        self.max_rows = 100\n        self.max_cols = 100\n        self.min_capacity = 1\n        self.max_capacity = 10\n\n    def validate_grid(self, grid):\n        \"\"\"\n        Validates the grid structure and content.\n        Raises ValueError on invalid input.\n        \"\"\"\n        if not isinstance(grid, list):\n            raise ValueError(\"Grid must be a list of lists.\")\n        if not grid:\n            raise ValueError(\"Grid cannot be empty.\")\n\n        rows = len(grid)\n        if not (1 <= rows <= self.max_rows):\n            raise ValueError(f\"Number of rows must be between 1 and {self.max_rows}, got {rows}.\")\n\n        first_row = grid[0]\n        if not isinstance(first_row, list):\n            raise ValueError(\"Each row in the grid must be a list.\")\n        if not first_row:\n            raise ValueError(\"Grid rows cannot be empty.\")\n\n        cols = len(first_row)\n        if not (1 <= cols <= self.max_cols):\n            raise ValueError(f\"Number of columns must be between 1 and {self.max_cols}, got {cols}.\")\n\n        for r_idx, row in enumerate(grid):\n            if not isinstance(row, list):\n                raise ValueError(f\"Row {r_idx} is not a list.\")\n            if len(row) != cols:\n                raise ValueError(f\"Row {r_idx} has length {len(row)}, expected {cols} for a rectangular grid.\")\n            for c_idx, cell in enumerate(row):\n                if not isinstance(cell, int) or cell not in (0, 1):\n                    raise ValueError(f\"Cell at ({r_idx}, {c_idx}) must be 0 or 1, got {cell}.\")\n\n    def validate_capacity(self, capacity):\n        \"\"\"\n        Validates the bucket capacity.\n        Raises ValueError on invalid input.\n        \"\"\"\n        if not isinstance(capacity, int):\n            raise ValueError(\"Capacity must be an integer.\")\n        if not (self.min_capacity <= capacity <= self.max_capacity):\n            raise ValueError(f\"Capacity must be between {self.min_capacity} and {self.max_capacity}, got {capacity}.\")\nclass Grid:\n    \"\"\"Represents the rectangular grid of wells.\"\"\"\n\n    def __init__(self, raw_grid):\n        self.wells = raw_grid\n        self.rows = len(raw_grid)\n        self.cols = len(raw_grid[0]) if raw_grid else 0 \n        self.validate() # Enforce internal invariants after construction\n\n    def validate(self):\n        \"\"\"\n        Verifies internal consistency of the grid (non-empty, rectangular, cell values 0 or 1).\n        Raises ValueError on failure.\n        \"\"\"\n        if self.rows == 0:\n            raise ValueError(\"Internal Grid error: Grid unexpectedly empty.\")\n        if self.cols == 0:\n             raise ValueError(\"Internal Grid error: Grid rows unexpectedly empty.\")\n\n        for r_idx, well_row in enumerate(self.wells):\n            if len(well_row) != self.cols:\n                raise ValueError(f\"Internal Grid error: Row {r_idx} length mismatch during Grid validation.\")\n            for c_idx, cell in enumerate(well_row):\n                if not isinstance(cell, int) or cell not in (0, 1):\n                    raise ValueError(f\"Internal Grid error: Cell at ({r_idx}, {c_idx}) is not 0 or 1 during Grid validation.\")\n\n    def get_well(self, rowIndex):\n        \"\"\"Returns the raw list of cells for a given row index.\"\"\"\n        if not (0 <= rowIndex < self.rows):\n            raise IndexError(f\"Row index {rowIndex} out of bounds for grid with {self.rows} rows.\")\n        return self.wells[rowIndex]\nclass Well:\n    \"\"\"Represents a single well (row) and provides per-well computations.\"\"\"\n\n    def __init__(self, rowIndex, cells):\n        self.rowIndex = rowIndex\n        self.cells = cells\n\n    def count_units(self):\n        \"\"\"Returns the count of water units (1s) in the well.\"\"\"\n        return sum(self.cells)\n\n    def required_lowerings(self, capacity):\n        \"\"\"\n        Calculates the minimum number of bucket lowerings for this well.\n        Uses integer arithmetic for ceil(units / capacity).\n        \"\"\"\n        units = self.count_units()\n        if units == 0:\n            return 0\n        return (units + capacity - 1) // capacity\nclass MaxFillFunction:\n    \"\"\"Encapsulates the algorithm for computing minimal total lowerings.\"\"\"\n\n    def __init__(self, validator):\n        self.validator = validator\n\n    def max_fill(self, grid_data, capacity):\n        \"\"\"\n        Computes the minimal total number of bucket-lowering operations.\n        Validates inputs, processes each well, and accumulates lowerings.\n        \"\"\"\n        self.validator.validate_grid(grid_data)\n        self.validator.validate_capacity(capacity)\n\n        grid_obj = Grid(grid_data)\n        total_lowerings = 0\n\n        for i in range(grid_obj.rows):\n            raw_well_cells = grid_obj.get_well(i)\n            well = Well(i, raw_well_cells)\n            total_lowerings += well.required_lowerings(capacity)\n\n        return total_lowerings\ndef max_fill(grid, capacity):\n    \"\"\"\n    Calculates the minimum number of bucket lowerings needed to empty all wells.\n    Validates input grid and capacity, then processes each well to sum up required lowerings.\n    \"\"\"\n    validator = InputValidator()\n    max_fill_algo = MaxFillFunction(validator=validator)\n    return max_fill_algo.max_fill(grid, capacity)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/117": [{"task_id": "HumanEval/117", "solution": "from typing import List, Set\nclass Word:\n    \"\"\"Represents a token (word) from the input string.\"\"\"\n    def __init__(self, text: str):\n        self.text = text\nclass ConsonantCounter:\n    \"\"\"Counts consonants in a word.\"\"\"\n    vowels: Set[str] = {'a', 'e', 'i', 'o', 'u'}\n\n    def count(self, word: Word) -> int:\n        consonant_count = 0\n        for char in word.text.lower():\n            if char.isalpha() and char not in self.vowels:\n                consonant_count += 1\n        return consonant_count\nclass Tokenizer:\n    \"\"\"Splits a string into Word objects, ignoring empty tokens.\"\"\"\n    def split(self, s: str) -> List[Word]:\n        raw_words = s.split() # Splits by any whitespace and handles multiple spaces correctly\n        return [Word(w) for w in raw_words]\nclass ResultList:\n    \"\"\"Collects Word objects that match selection criteria.\"\"\"\n    def __init__(self):\n        self.words: List[Word] = []\n\n    def add(self, word: Word) -> None:\n        self.words.append(word)\n\n    def to_string_list(self) -> List[str]:\n        return [word.text for word in self.words]\nclass Validator:\n    \"\"\"Validates input parameters for initial checks.\"\"\"\n    def validate_inputs(self, s: str, n: int) -> bool:\n        # Returns True if the string is non-empty, False otherwise.\n        return bool(s)\ndef select_words(s, n):\n    \"\"\"Given a string s and a natural number n, this function returns a list of all words from string s that contain exactly n consonants.\"\"\"\n\n    validator = Validator()\n    tokenizer = Tokenizer()\n    consonant_counter = ConsonantCounter()\n    result_list = ResultList()\n\n    # Early return for empty string as per requirements\n    if not validator.validate_inputs(s, n):\n        return []\n\n    words = tokenizer.split(s)\n\n    for word_obj in words:\n        consonant_count = consonant_counter.count(word_obj)\n        if consonant_count == n:\n            result_list.add(word_obj)\n\n    return result_list.to_string_list()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/116": [{"task_id": "HumanEval/116", "solution": "from typing import List\nclass BinaryRepresentation:\n    \"\"\"Encapsulates standard binary representation and computes ones-count.\"\"\"\n    def __init__(self, value: int) -> None:\n        # For non-negative values, `bin(value)[2:]` gives the standard binary string.\n        # E.g., bin(0) -> '0b0' -> '0', bin(5) -> '0b101' -> '101'.\n        self.bits = bin(value)[2:]\n\n    def computeOnes(self) -> int:\n        \"\"\"Returns the number of '1' bits in the standard binary representation.\"\"\"\n        return self.bits.count('1')\nclass IntegerElement:\n    \"\"\"Represents an integer element and provides properties like negativity and bit count.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\n    def isNegative(self) -> bool:\n        \"\"\"Returns True if the element's value is negative.\"\"\"\n        return self.value < 0\n\n    def binaryRepr(self) -> str:\n        \"\"\"Returns the standard binary representation string for non-negative values.\"\"\"\n        if self.value < 0:\n            # As per design, binaryRepr is not used for negative values in the sorting path.\n            return \"\" \n        return BinaryRepresentation(self.value).bits\n\n    def bitCount(self) -> int:\n        \"\"\"\n        Returns the count of '1' bits for non-negative values using standard binary representation.\n        For negative values in a mixed array, it returns -1 to ensure they sort\n        before any non-negative numbers based on ones-count.\n        \"\"\"\n        if self.value < 0:\n            # Assigning -1 ensures negative numbers in mixed arrays\n            # sort before any non-negative numbers (which have onesCount >= 0)\n            # when using a (onesCount, decimalValue) key.\n            return -1\n        return BinaryRepresentation(self.value).computeOnes()\nclass SortResult:\n    \"\"\"DTO holding the sorted array.\"\"\"\n    def __init__(self, sortedArray: List[int]) -> None:\n        self.sortedArray = sortedArray\nclass SortArrayFunction:\n    \"\"\"Orchestrates sorting based on whether the input array contains only negative numbers or not.\"\"\"\n    def __init__(self, arr: List[int]) -> None:\n        self.arr = arr\n\n    def execute(self) -> SortResult:\n        \"\"\"\n        Performs the sorting operation.\n        If all elements are negative, sorts numerically ascending.\n        Otherwise (mixed or all non-negative), sorts by (ones_count, decimal_value).\n        \"\"\"\n        if not self.arr:\n            return SortResult([])\n\n        # Determine if all elements are negative for special sorting rule (FR4)\n        all_negative = all(IntegerElement(x).isNegative() for x in self.arr)\n\n        if all_negative:\n            # FR4: Negative-only arrays sort by numeric (decimal) ascending.\n            sorted_arr = sorted(self.arr)\n        else:\n            # FR2, FR3, FR5: Non-negative primary path (for mixed or all non-negative arrays).\n            # Sort elements by a composite key (ones_count, decimal_value).\n            elements_with_keys = []\n            for item in self.arr:\n                ie = IntegerElement(item)\n                # bitCount handles non-negative values correctly and assigns -1 for negative values\n                # in a mixed array to ensure correct relative sorting.\n                ones_count = ie.bitCount()\n                \n                # The sort key is a tuple (ones_count, decimal_value) as specified in the design.\n                key_tuple = (ones_count, item) \n                elements_with_keys.append((key_tuple, item))\n            \n            # Use Python's built-in stable sort with the generated tuple key.\n            elements_with_keys.sort(key=lambda x: x[0])\n            \n            # Extract the original values in their new sorted order.\n            sorted_arr = [item for _, item in elements_with_keys]\n\n        return SortResult(sorted_arr)\ndef sort_array(arr: List[int]) -> List[int]:\n    \"\"\"\n    Sorts an array of integers based on the number of ones in their binary representation.\n    For non-negative numbers or mixed arrays, elements are primarily sorted by the count\n    of '1' bits in ascending order. For ties in '1' bit count, they are sorted by\n    decimal value in ascending order. Negative-only arrays are sorted purely by\n    decimal value in ascending order.\n    \"\"\"\n    sorter = SortArrayFunction(arr)\n    result = sorter.execute()\n    return result.sortedArray", "base_status": "fail", "plus_status": "pass", "base_fail_tests": [[[-2, -3, -4, -5, -6]]], "plus_fail_tests": []}], "HumanEval/120": [{"task_id": "HumanEval/120", "solution": "from typing import List, Optional\nclass ValidationError(Exception):\n    \"\"\"Exception for array-level validation failures.\"\"\"\n    def __init__(self, message: str, type: Optional[str] = None) -> None:\n        super().__init__(message)\n        self.message = message\n        self.type = type\nclass ArrayInput:\n    \"\"\"Lightweight wrapper for input array with basic properties.\"\"\"\n    def __init__(self, arr: List[int]) -> None:\n        self.arr = arr\n        self.length = len(arr)\n\n    def validate_elements(self) -> bool:\n        \"\"\"Placeholder for element validation, delegated to Validator.\"\"\"\n        return True\nclass Validator:\n    \"\"\"Encapsulates validation rules for array and k.\"\"\"\n    def validate_k(self, k: int, arr: List[int]) -> None:\n        \"\"\"Enforce 0 <= k <= len(arr), raising ValueError if violated.\"\"\"\n        if not (0 <= k <= len(arr)):\n            raise ValueError(f\"k must be between 0 and len(arr) inclusive. Got k={k}, len(arr)={len(arr)}\")\n\n    def validate_range(self, arr: List[int]) -> None:\n        \"\"\"Enforce array length and element value ranges, raising ValidationError if violated.\"\"\"\n        if not (1 <= len(arr) <= 1000):\n            raise ValidationError(f\"Array length must be between 1 and 1000. Got {len(arr)}.\", type=\"ARRAY_LENGTH_VIOLATION\")\n        \n        for element in arr:\n            if not (-1000 <= element <= 1000):\n                raise ValidationError(f\"Array elements must be between -1000 and 1000. Got {element}.\", type=\"ELEMENT_RANGE_VIOLATION\")\nclass MaximumSelector:\n    \"\"\"Selects the k largest elements from an array.\"\"\"\n    def select_k_max(self, arr: List[int], k: int) -> List[int]:\n        \"\"\"Returns a list of the top-k values, preserving duplicates.\"\"\"\n        # Sort in descending order to easily pick the top k\n        arr_sorted_desc = sorted(arr, reverse=True)\n        # Take the first k elements\n        return arr_sorted_desc[:k]\nclass Sorter:\n    \"\"\"Sorts integer lists in non-decreasing order.\"\"\"\n    def sort_ascending(self, int_list: List[int]) -> List[int]:\n        \"\"\"Returns a new list sorted in ascending order.\"\"\"\n        return sorted(int_list)\nclass ResultList:\n    \"\"\"Container for the final sorted list.\"\"\"\n    def __init__(self, values: List[int]) -> None:\n        self.values = values\n        self.length = len(values)\ndef maximum(arr, k):\n    \"\"\"\n    Given an array arr of integers and a positive integer k, return a sorted list \n    of length k with the maximum k numbers in arr.\n    \"\"\"\n    input_obj = ArrayInput(arr)\n    validator = Validator()\n    validator.validate_range(input_obj.arr)\n    validator.validate_k(k, input_obj.arr)\n\n    if k == 0:\n        return []\n\n    selector = MaximumSelector()\n    selected = selector.select_k_max(input_obj.arr, k)\n\n    sorter = Sorter()\n    sorted_result = sorter.sort_ascending(selected)\n\n    result = ResultList(sorted_result)\n    return result.values", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/119": [{"task_id": "HumanEval/119", "solution": "class InputList:\n    def __init__(self, strings: list[str]):\n        self.strings = strings\nclass ParenthesesString:\n    def __init__(self, value: str):\n        self.value = value\n        self.length = len(value)\n        self.netBalance = 0\n        self.minPrefixBalance = 0\nclass Result:\n    def __init__(self, value: str):\n        self.value = value\ndef get_concatenation_metrics(a: ParenthesesString, b: ParenthesesString) -> tuple[int, int]:\n    \"\"\"Calculates combined metrics for a+b concatenation without materializing the string.\"\"\"\n    combined_net_balance = a.netBalance + b.netBalance\n    combined_min_prefix_balance = min(a.minPrefixBalance, a.netBalance + b.minPrefixBalance)\n    return combined_net_balance, combined_min_prefix_balance\ndef isBalanced(net_balance: int, min_prefix_balance: int) -> bool:\n    \"\"\"Checks if a string (by its metrics) is balanced.\"\"\"\n    return net_balance == 0 and min_prefix_balance >= 0\ndef isBalancedByMetrics(a: ParenthesesString, b: ParenthesesString) -> bool:\n    \"\"\"Checks if a+b or b+a forms a balanced parentheses string.\"\"\"\n    net_ab, min_ab = get_concatenation_metrics(a, b)\n    if isBalanced(net_ab, min_ab):\n        return True\n\n    net_ba, min_ba = get_concatenation_metrics(b, a)\n    if isBalanced(net_ba, min_ba):\n        return True\n\n    return False\ndef match_parens(lst):\n    '''\n    You are given a list of two strings, both strings consist of open\n    parentheses '(' or close parentheses ')' only.\n    Your job is to check if it is possible to concatenate the two strings in\n    some order, that the resulting string will be good.\n    A string S is considered to be good if and only if all parentheses in S\n    are balanced. For example: the string '(())()' is good, while the string\n    '())' is not.\n    Return 'Yes' if there's a way to make a good string, and return 'No' otherwise.\n    '''\n    input_list_obj = InputList(lst)\n    validateCount(input_list_obj)\n\n    s1_obj = ParenthesesString(input_list_obj.strings[0])\n    s2_obj = ParenthesesString(input_list_obj.strings[1])\n\n    validateChars(s1_obj)\n    validateChars(s2_obj)\n\n    computeNetAndMin(s1_obj)\n    computeNetAndMin(s2_obj)\n\n    ok = isBalancedByMetrics(s1_obj, s2_obj)\n\n    return Result('Yes' if ok else 'No').value", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[["()(", ")"]]], "plus_fail_tests": [[["(", "("]]]}], "HumanEval/118": [{"task_id": "HumanEval/118", "solution": "VOWELS = {'a', 'e', 'i', 'o', 'u', 'A', 'E', 'I', 'O', 'U'}\ndef _is_letter(ch):\n    \"\"\"Checks if a character is an English letter.\"\"\"\n    return 'a' <= ch <= 'z' or 'A' <= ch <= 'Z'\ndef _is_vowel(ch):\n    \"\"\"Checks if a character is a vowel (case-sensitive).\"\"\"\n    return ch in VOWELS\ndef get_closest_vowel(word):\n    \"\"\"Finds the closest vowel between two consonants from the right side of the word.\"\"\"\n    if not word or len(word) < 3:\n        return \"\"\n\n    for char_code in word:\n        if not _is_letter(char_code):\n            return \"\"\n\n    # Iterate from right to left, excluding the first and last characters (indices 0 and len-1)\n    # So the range is from len(word) - 2 down to 1 (inclusive)\n    for i in range(len(word) - 2, 0, -1):\n        current_char = word[i]\n        left_neighbor = word[i-1]\n        right_neighbor = word[i+1]\n\n        if _is_vowel(current_char) and not _is_vowel(left_neighbor) and not _is_vowel(right_neighbor):\n            return current_char\n            \n    return \"\"", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/121": [{"task_id": "HumanEval/121", "solution": "import collections\nclass InputList:\n    \"\"\"Represents the input list and provides validation.\"\"\"\n    def __init__(self, elements: list) -> None:\n        self.elements = elements\n        self._elements_with_index = None # Lazy loaded property for iteration\n\n    def _build_elements_from_list(self):\n        \"\"\"Helper to create Element objects from the raw list.\"\"\"\n        if self._elements_with_index is None:\n            self._elements_with_index = [Element(idx, val) for idx, val in enumerate(self.elements)]\n        return self._elements_with_index\n\n    def __iter__(self):\n        \"\"\"Allows iteration over Element objects.\"\"\"\n        return iter(self._build_elements_from_list())\n\n    def validateNonEmpty(self) -> bool:\n        \"\"\"Validates that the input list is not empty.\"\"\"\n        return bool(self.elements)\n\n    def validateAllIntegers(self) -> bool:\n        \"\"\"Validates that all elements in the list are integers.\"\"\"\n        return all(isinstance(e, int) for e in self.elements)\nclass Element:\n    \"\"\"Represents a single element with its index and value.\"\"\"\n    def __init__(self, index: int, value: int) -> None:\n        self.index = index\n        self.value = value\n\n    def isOdd(self) -> bool:\n        \"\"\"Checks if the element's value is odd.\"\"\"\n        return self.value % 2 != 0\n\n    def isEvenPosition(self) -> bool:\n        \"\"\"Checks if the element's position (index) is even.\"\"\"\n        return self.index % 2 == 0\nclass SumCalculator:\n    \"\"\"Calculates the sum of odd elements at even positions.\"\"\"\n    def computeSum(self, input_list: InputList) -> int:\n        \"\"\"Iterates through the input_list and sums qualifying elements.\"\"\"\n        current_sum = 0\n        for element in input_list:\n            if element.isEvenPosition() and element.isOdd():\n                current_sum += element.value\n        return current_sum\ndef solution(lst) -> int:\n    \"\"\"Given a non-empty list of integers, return the sum of all of the odd elements that are in even positions.\"\"\"\n    input_list = InputList(lst)\n    if not input_list.validateNonEmpty():\n        raise ValueError('Input list must be non-empty')\n    if not input_list.validateAllIntegers():\n        raise ValueError('All elements must be integers')\n    calculator = SumCalculator()\n    return calculator.computeSum(input_list)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/124": [{"task_id": "HumanEval/124", "solution": "import re\nclass DateString:\n    \"\"\"Encapsulates a raw date string.\"\"\"\n    def __init__(self, raw: str):\n        self.raw = raw\n\n    def isEmpty(self) -> bool:\n        \"\"\"Checks if the raw string is empty.\"\"\"\n        return not self.raw\n\n    def trimmed(self) -> str:\n        \"\"\"Returns the raw string with leading/trailing whitespace removed.\"\"\"\n        return self.raw.strip()\nclass DateComponents:\n    \"\"\"Holds parsed integer components of a date.\"\"\"\n    def __init__(self, month: int, day: int, year: int):\n        self.month = month\n        self.day = day\n        self.year = year\n\n    @staticmethod\n    def fromString(s: str) -> 'DateComponents':\n        \"\"\"Parses a 'mm-dd-yyyy' string into DateComponents.\"\"\"\n        parts = s.split('-')\n        if len(parts) != 3:\n            raise ValueError(\"Date string must have exactly three parts separated by hyphens.\")\n        month_str, day_str, year_str = parts\n        month = int(month_str)\n        day = int(day_str)\n        year = int(year_str)\n        return DateComponents(month, day, year)\nclass DateValidator:\n    \"\"\"Orchestrates date validation based on defined rules.\"\"\"\n    def validate(self, date_str: str) -> bool:\n        \"\"\"Validates a date string against all rules.\"\"\"\n        date_obj = DateString(date_str)\n        if date_obj.isEmpty():\n            return False\n\n        if not self.validateFormat(date_str):\n            return False\n\n        components = self.parse(date_str)\n        if components is None:\n            return False\n\n        if not self.validateMonth(components.month):\n            return False\n\n        if not self.validateDay(components.day, components.month):\n            return False\n\n        return True\n\n    def validateFormat(self, date_str: str) -> bool:\n        \"\"\"Checks if the date string matches the 'mm-dd-yyyy' format.\"\"\"\n        return re.match(r'^\\d{2}-\\d{2}-\\d{4}$', date_str) is not None\n\n    def parse(self, date_str: str) -> DateComponents | None:\n        \"\"\"Parses a date string into DateComponents, returning None on failure.\"\"\"\n        try:\n            return DateComponents.fromString(date_str)\n        except ValueError:\n            return None\n\n    def validateMonth(self, month: int) -> bool:\n        \"\"\"Validates the month component is within 1 to 12.\"\"\"\n        return 1 <= month <= 12\n\n    def validateDay(self, day: int, month: int) -> bool:\n        \"\"\"Validates the day component based on the month-specific limits.\"\"\"\n        if day < 1:\n            return False\n\n        if month in {1, 3, 5, 7, 8, 10, 12}:\n            return day <= 31\n        elif month in {4, 6, 9, 11}:\n            return day <= 30\n        elif month == 2:\n            return day <= 29\n        else:\n            # Should not be reached if validateMonth passed\n            return False\ndef valid_date(date):\n    \"\"\"Validates a given date string and returns True if valid, otherwise False.\"\"\"\n    validator = DateValidator()\n    return validator.validate(date)", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [["06-04-2020\n"]]}], "HumanEval/122": [{"task_id": "HumanEval/122", "solution": "class Array:\n    \"\"\"Represents the input integer array and provides first-k access.\"\"\"\n    def __init__(self, values: list[int]):\n        self.values = values\n        self.length = len(values)\n\n    def getFirstK(self, k: int) -> list[int]:\n        \"\"\"Returns the first k elements of the array.\"\"\"\n        return self.values[:k]\nclass Element:\n    \"\"\"Represents a single integer and its qualification rule.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def isTwoDigits(self) -> bool:\n        \"\"\"Checks if the absolute value has at most two digits.\"\"\"\n        return -99 <= self.value <= 99\nclass K:\n    \"\"\"Encapsulates k and its validation rule.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def isValidFor(self, arr_length: int) -> bool:\n        \"\"\"Validates if k is within the bounds of the array length.\"\"\"\n        return 1 <= self.value <= arr_length\nclass Result:\n    \"\"\"Holds the resulting sum.\"\"\"\n    def __init__(self, sum_val: int):\n        self.sum = sum_val\nclass Validator:\n    \"\"\"Input validation logic for array and k.\"\"\"\n    def validateArray(self, arr: list[int]) -> bool:\n        \"\"\"Validates if the array is non-empty and its length is within [1, 100].\"\"\"\n        return 1 <= len(arr) <= 100\n\n    def validateK(self, k_val: int, arr: list[int]) -> bool:\n        \"\"\"Validates if k is within the bounds [1, len(arr)].\"\"\"\n        k_obj = K(k_val)\n        return k_obj.isValidFor(len(arr))\nclass Selector:\n    \"\"\"Selects the first k elements and wraps them as Element instances.\"\"\"\n    def selectFirstK(self, arr: list[int], k: int) -> list[Element]:\n        \"\"\"Returns a list of Element objects for the first k elements.\"\"\"\n        array_obj = Array(arr)\n        first_k_values = array_obj.getFirstK(k)\n        return [Element(value) for value in first_k_values]\nclass Qualifier:\n    \"\"\"Filters a list of Elements to those satisfying the two-digit rule.\"\"\"\n    def filterTwoDigitElements(self, elements: list[Element]) -> list[Element]:\n        \"\"\"Filters elements where the absolute value has at most two digits.\"\"\"\n        return [element for element in elements if element.isTwoDigits()]\nclass SumCalculator:\n    \"\"\"Sums the values of qualifying elements and produces a Result.\"\"\"\n    def sum(self, elements: list[Element]) -> Result:\n        \"\"\"Calculates the sum of values from a list of Element objects.\"\"\"\n        total_sum = sum(element.value for element in elements)\n        return Result(total_sum)\ndef add_elements(arr: list[int], k: int) -> int:\n    \"\"\"\n    Given a non-empty array of integers arr and an integer k, return\n    the sum of the elements with at most two digits from the first k elements of arr.\n    \"\"\"\n    validator = Validator()\n    # Design context states \"behavior for invalid inputs is unspecified by SRS;\n    # implementation may raise ValueError\". Given the prompt\n    # \"DO NOT add isinstance() checks or raise exceptions for edge cases\",\n    # we assume inputs are valid according to constraints or silently proceed.\n    # The orchestration logic continues as if validation passes.\n    _ = validator.validateArray(arr)\n    _ = validator.validateK(k, arr)\n\n    selector = Selector()\n    elements = selector.selectFirstK(arr, k)\n\n    qualifier = Qualifier()\n    qualifying_elements = qualifier.filterTwoDigitElements(elements)\n\n    calculator = SumCalculator()\n    result = calculator.sum(qualifying_elements)\n\n    return result.sum", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/125": [{"task_id": "HumanEval/125", "solution": "class InputText:\n    def __init__(self, raw_text: str):\n        self.raw_text = raw_text\n\n    def length(self) -> int:\n        return len(self.raw_text)\n\n    def containsWhitespace(self) -> bool:\n        return any(c.isspace() for c in self.raw_text)\n\n    def containsComma(self) -> bool:\n        return ',' in self.raw_text\nclass WordList:\n    def __init__(self, words: list):\n        self.words = words\n\n    def as_list(self) -> list:\n        return self.words\nclass CharacterCounter:\n    @staticmethod\n    def countOddLowercase(txt: str) -> int:\n        count = 0\n        ord_a = ord('a')\n        for char in txt:\n            # Check if char is an ASCII lowercase letter and its 0-based alphabetical index is odd.\n            if 'a' <= char <= 'z' and (ord(char) - ord_a) % 2 != 0:\n                count += 1\n        return count\nclass SplitWords:\n    def split(self, txt: str):\n        input_text_analyzer = InputText(txt)\n\n        if input_text_analyzer.containsWhitespace():\n            # Splits on any whitespace and discards empty strings.\n            words = txt.split()\n            return WordList(words).as_list()\n        elif input_text_analyzer.containsComma():\n            # Splits on commas; may produce empty strings for adjacent/leading/trailing commas.\n            words = txt.split(',')\n            return WordList(words).as_list()\n        else:\n            return CharacterCounter.countOddLowercase(txt)\ndef split_words(txt):\n    '''\n    Given a string of words, return a list of words split on whitespace, if no whitespaces exists in the text you\n    should split on commas ',' if no commas exists you should return the number of lower-case letters with odd order in the\n    alphabet, ord('a') = 0, ord('b') = 1, ... ord('z') = 25\n    Examples\n    split_words(\"Hello world!\") \u279e [\"Hello\", \"world!\"]\n    split_words(\"Hello,world!\") \u279e [\"Hello\", \"world!\"]\n    split_words(\"abcdef\") == 3\n    '''\n    splitter = SplitWords()\n    return splitter.split(txt)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/123": [{"task_id": "HumanEval/123", "solution": "from typing import List, Set, Iterator\nclass InputValidator:\n    \"\"\"\n    Validates if a given input n is a positive integer.\n    \"\"\"\n    @staticmethod\n    def is_positive_integer(n) -> bool:\n        \"\"\"\n        Checks if n is an integer and greater than 0.\n        \"\"\"\n        return isinstance(n, int) and n > 0\nclass CollatzSequence:\n    \"\"\"\n    Generates terms of the Collatz sequence starting from a given value until it reaches 1.\n    \"\"\"\n    def __init__(self, start_value: int):\n        self.start_value = start_value\n\n    def generate(self) -> Iterator[int]:\n        \"\"\"\n        Yields each term in the Collatz sequence.\n        \"\"\"\n        current = self.start_value\n        while True:\n            yield current\n            if current == 1:\n                break\n            if current % 2 == 0:\n                current //= 2\n            else:\n                current = 3 * current + 1\nclass OddNumberCollector:\n    \"\"\"\n    Collects unique odd numbers from a sequence and provides them as a sorted list.\n    \"\"\"\n    def __init__(self):\n        self._odd_numbers: Set[int] = set()\n\n    def collect(self, term: int) -> None:\n        \"\"\"\n        Adds the term to the collection if it is odd.\n        \"\"\"\n        if term % 2 != 0:\n            self._odd_numbers.add(term)\n\n    def get_sorted_list(self) -> List[int]:\n        \"\"\"\n        Returns the collected unique odd numbers as a sorted list.\n        \"\"\"\n        return sorted(list(self._odd_numbers))\nclass Result:\n    \"\"\"\n    Encapsulates the final list of odd numbers.\n    \"\"\"\n    def __init__(self, odd_list: List[int]):\n        self.odd_list = odd_list\n\n    def as_list(self) -> List[int]:\n        \"\"\"\n        Returns the encapsulated list.\n        \"\"\"\n        return self.odd_list\nclass CollatzService:\n    \"\"\"\n    Orchestrates the generation and collection of odd Collatz numbers.\n    \"\"\"\n    def get_odd_collatz(self, n) -> List[int]:\n        \"\"\"\n        Validates input, generates the Collatz sequence, collects odd numbers, and returns them sorted.\n        \"\"\"\n        if not InputValidator.is_positive_integer(n):\n            raise ValueError(\"Input must be a positive integer.\")\n\n        collector = OddNumberCollector()\n        sequence_generator = CollatzSequence(n)\n\n        for term in sequence_generator.generate():\n            collector.collect(term)\n\n        final_list = collector.get_sorted_list()\n        result = Result(final_list)\n        return result.as_list()\ndef get_odd_collatz(n):\n    \"\"\"\n    Given a positive integer n, return a sorted list that has the odd numbers in collatz sequence.\n    \"\"\"\n    service = CollatzService()\n    return service.get_odd_collatz(n)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/126": [{"task_id": "HumanEval/126", "solution": "class OccurrenceCounter:\n    \"\"\"\n    Internal helper class to count occurrences of numbers in a list.\n    \"\"\"\n    def __init__(self):\n        self._counts = {}\n\n    def count(self, lst):\n        \"\"\"\n        Calculates and returns a dictionary of number occurrences.\n        \"\"\"\n        for x in lst:\n            self._counts[x] = self._counts.get(x, 0) + 1\n        return self._counts\ndef is_sorted(lst):\n    '''\n    Given a list of numbers, return whether or not they are sorted\n    in ascending order. If list has more than 1 duplicate of the same\n    number, return False. Assume no negative numbers and only integers.\n\n    Examples\n    is_sorted([5]) \u279e True\n    is_sorted([1, 2, 3, 4, 5]) \u279e True\n    is_sorted([1, 3, 2, 4, 5]) \u279e False\n    is_sorted([1, 2, 3, 4, 5, 6]) \u279e True\n    is_sorted([1, 2, 3, 4, 5, 6, 7]) \u279e True\n    is_sorted([1, 3, 2, 4, 5, 6, 7]) \u279e False\n    is_sorted([1, 2, 2, 3, 3, 4]) \u279e True\n    is_sorted([1, 2, 2, 2, 3, 4]) \u279e False\n    '''\n    # Return True for empty or single-element lists.\n    if len(lst) <= 1:\n        return True\n\n    # Check for non-decreasing order.\n    for i in range(1, len(lst)):\n        if lst[i] < lst[i-1]:\n            return False\n\n    # Count occurrences of each number.\n    counter = OccurrenceCounter()\n    counts = counter.count(lst)\n\n    # Check if any number appears more than twice.\n    for count_val in counts.values():\n        if count_val > 2:\n            return False\n\n    # If all checks pass, the list is sorted and meets duplicate criteria.\n    return True", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/128": [{"task_id": "HumanEval/128", "solution": "def prod_signs(arr: list[int]) -> int | None:\n    \"\"\"\n    Calculates the sum of magnitudes of integers multiplied by the product of their signs.\n    Returns None for an empty array.\n    \"\"\"\n\n    if not arr:\n        return None\n\n    def _sign(value: int) -> int:\n        \"\"\"Determines the sign of an integer.\"\"\"\n        if value > 0:\n            return 1\n        elif value < 0:\n            return -1\n        else:\n            return 0\n\n    def _sum_of_magnitudes(inner_arr: list[int]) -> int:\n        \"\"\"Calculates the sum of absolute values of integers.\"\"\"\n        total_magnitude = 0\n        for num in inner_arr:\n            total_magnitude += abs(num)\n        return total_magnitude\n\n    def _product_of_signs(inner_arr: list[int]) -> int:\n        \"\"\"Calculates the product of signs, short-circuiting to 0 if any number is zero.\"\"\"\n        product = 1\n        for num in inner_arr:\n            s = _sign(num)\n            if s == 0:\n                return 0\n            product *= s\n        return product\n\n    sum_mag = _sum_of_magnitudes(arr)\n    prod_sig = _product_of_signs(arr)\n\n    return prod_sig * sum_mag", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/127": [{"task_id": "HumanEval/127", "solution": "def _is_prime(n: int) -> bool:\n    \"\"\"Checks if a number is prime using an optimized trial division method.\"\"\"\n    if n <= 1:\n        return False\n    if n <= 3:  # 2 and 3 are prime\n        return True\n    if n % 2 == 0 or n % 3 == 0: # Exclude multiples of 2 or 3\n        return False\n    i = 5\n    # All primes greater than 3 are of the form 6k \u00b1 1.\n    # We check divisibility by i and i + 2.\n    while i * i <= n:\n        if n % i == 0 or n % (i + 2) == 0:\n            return False\n        i += 6\n    return True\ndef intersection(interval1, interval2):\n    \"\"\"You are given two intervals,\n    where each interval is a pair of integers. For example, interval = (start, end) = (1, 2).\n    The given intervals are closed which means that the interval (start, end)\n    includes both start and end.\n    For each given interval, it is assumed that its start is less or equal its end.\n    Your task is to determine whether the length of intersection of these two \n    intervals is a prime number.\n    Example, the intersection of the intervals (1, 3), (2, 4) is (2, 3)\n    which its length is 1, which not a prime number.\n    If the length of the intersection is a prime number, return \"YES\",\n    otherwise, return \"NO\".\n    If the two intervals don't intersect, return \"NO\".\n\n\n    [input/output] samples:\n    intersection((1, 2), (2, 3)) ==> \"NO\"\n    intersection((-1, 1), (0, 4)) ==> \"NO\"\n    intersection((-3, -1), (-5, 5)) ==> \"YES\"\n    \"\"\"\n    # Extract start and end for interval1, assuming it's a tuple (start, end).\n    start1, end1 = interval1[0], interval1[1]\n\n    # Extract start and end for interval2, assuming it's a tuple (start, end).\n    start2, end2 = interval2[0], interval2[1]\n\n    # Validate interval bounds as per design: start must be <= end.\n    # If either interval is invalid (start > end), the function returns \"NO\".\n    if start1 > end1 or start2 > end2:\n        return \"NO\"\n\n    # Calculate the start and end points of the intersection interval.\n    # The intersection is defined as [max(start1, start2), min(end1, end2)].\n    intersection_start = max(start1, start2)\n    intersection_end = min(end1, end2)\n\n    # If the calculated intersection_start is greater than intersection_end,\n    # the intervals do not overlap. In this case, return \"NO\".\n    if intersection_start > intersection_end:\n        return \"NO\"\n\n    # Calculate the length of the intersection interval.\n    # For closed intervals, the length is (end - start).\n    length = intersection_end - intersection_start\n\n    # Check if this calculated length is a prime number using the helper function.\n    if _is_prime(length):\n        return \"YES\"\n    else:\n        return \"NO\"", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/129": [{"task_id": "HumanEval/129", "solution": "import heapq\nclass Position:\n    \"\"\"Represents a (row, col) coordinate.\"\"\"\n    def __init__(self, row: int, col: int):\n        self.row = row\n        self.col = col\n\n    def __eq__(self, other):\n        if not isinstance(other, Position):\n            return NotImplemented\n        return self.row == other.row and self.col == other.col\n\n    def __hash__(self):\n        return hash((self.row, self.col))\n\n    def __repr__(self):\n        return f\"Position({self.row}, {self.col})\"\nclass Cell:\n    \"\"\"Represents a cell in the grid with its value and position.\"\"\"\n    def __init__(self, value: int, row: int, col: int, grid_ref):\n        self.value = value\n        self.row = row\n        self.col = col\n        self._grid_ref = grid_ref # Reference to the parent Grid to check bounds\n\n    def getNeighbors(self) -> list[Position]:\n        \"\"\"Returns a list of valid orthogonal neighbor Positions within grid bounds.\"\"\"\n        neighbors = []\n        N = self._grid_ref.N\n        moves = [(-1, 0), (1, 0), (0, -1), (0, 1)] # Up, Down, Left, Right\n\n        for dr, dc in moves:\n            new_row, new_col = self.row + dr, self.col + dc\n            if 0 <= new_row < N and 0 <= new_col < N:\n                neighbors.append(Position(new_row, new_col))\n        return neighbors\n\n    def __eq__(self, other):\n        if not isinstance(other, Cell):\n            return NotImplemented\n        return self.row == other.row and self.col == other.col\n\n    def __hash__(self):\n        return hash((self.row, self.col))\n\n    def __repr__(self):\n        return f\"Cell(value={self.value}, pos=({self.row},{self.col}))\"\nclass Grid:\n    \"\"\"Represents the N x N grid of integer values.\"\"\"\n    def __init__(self, N: int, values: list[list[int]]):\n        self.N = N\n        self.values = values\n        self._cells_cache = {} # Cache Cell objects to avoid re-creation\n\n    def getCell(self, row: int, col: int) -> Cell:\n        \"\"\"Returns the Cell object at the given row and column.\"\"\"\n        if (row, col) not in self._cells_cache:\n            value = self.values[row][col]\n            self._cells_cache[(row, col)] = Cell(value, row, col, self)\n        return self._cells_cache[(row, col)]\n\n    def size(self) -> int:\n        \"\"\"Returns the dimension N of the N x N grid.\"\"\"\n        return self.N\nclass Path:\n    \"\"\"Represents an ordered sequence of visited cells.\"\"\"\n    def __init__(self, sequence: list[Cell]):\n        self.sequence = sequence\n\n    def length(self) -> int:\n        \"\"\"Returns the number of cells in the path.\"\"\"\n        return len(self.sequence)\n\n    def getValues(self) -> list[int]:\n        \"\"\"Returns the ordered list of values on the cells of the path.\"\"\"\n        return [cell.value for cell in self.sequence]\n\n    def __eq__(self, other):\n        if not isinstance(other, Path):\n            return NotImplemented\n        return self.getValues() == other.getValues()\n\n    def __hash__(self):\n        return hash(tuple(self.getValues()))\n\n    def __repr__(self):\n        return f\"Path({self.getValues()})\"\ndef build_grid(raw_grid: list[list[int]]) -> Grid:\n    \"\"\"Converts a raw list-of-lists into a domain Grid object.\"\"\"\n    N = len(raw_grid)\n    return Grid(N, raw_grid)\nclass Validator:\n    \"\"\"Validates the input grid according to problem constraints.\"\"\"\n    @staticmethod\n    def validateGrid(grid: Grid) -> None:\n        \"\"\"\n        Validates the grid structure and contents, raising ValueError on failure.\n        Checks N x N shape, N >= 2, and permutation of 1 to N*N.\n        \"\"\"\n        N = grid.size()\n        if N < 2:\n            raise ValueError(\"Grid dimension N must be at least 2.\")\n\n        for row in grid.values:\n            if len(row) != N:\n                raise ValueError(\"Grid is not square (N x N).\")\n\n        expected_values = set(range(1, N * N + 1))\n        actual_values = set()\n        for r in range(N):\n            for c in range(N):\n                actual_values.add(grid.values[r][c])\n        \n        if actual_values != expected_values:\n            raise ValueError(\"Grid does not contain a permutation of integers from 1 to N*N.\")\nclass PathFinder:\n    \"\"\"Finds the lexicographically minimal path in the grid.\"\"\"\n\n    @staticmethod\n    def compareLex(a: Path, b: Path) -> int:\n        \"\"\"\n        Compares two paths lexicographically, returning -1 if a < b, 0 if a == b, 1 if a > b.\n        This comparison is based on the ordered lists of values from the paths.\n        \"\"\"\n        values_a = a.getValues()\n        values_b = b.getValues()\n        \n        for i in range(min(len(values_a), len(values_b))):\n            if values_a[i] < values_b[i]:\n                return -1\n            elif values_a[i] > values_b[i]:\n                return 1\n        \n        if len(values_a) < len(values_b):\n            return -1\n        elif len(values_a) > len(values_b):\n            return 1\n        else:\n            return 0\n\n    @staticmethod\n    def findMinimalPath(grid: Grid, k: int) -> Path:\n        \"\"\"\n        Searches and returns the unique lexicographically minimal path of length k in the grid.\n        It uses a priority queue to explore paths, prioritizing lexicographically smaller sequences.\n        \"\"\"\n        min_heap = [] # Stores (path_values_tuple, current_length, last_cell, path_cells_list)\n\n        N = grid.size()\n\n        for r in range(N):\n            for c in range(N):\n                start_cell = grid.getCell(r, c)\n                heapq.heappush(min_heap, ((start_cell.value,), 1, start_cell, [start_cell]))\n\n        best_path_values_tuple = (float('inf'),) * k\n        final_best_path_cells = None\n\n        while min_heap:\n            current_values_tuple, current_length, last_cell, current_cells_list = heapq.heappop(min_heap)\n\n            if current_values_tuple >= best_path_values_tuple[:current_length]:\n                 continue\n            \n            if current_length == k:\n                if current_values_tuple < best_path_values_tuple:\n                    best_path_values_tuple = current_values_tuple\n                    final_best_path_cells = current_cells_list\n                continue\n\n            for neighbor_pos in last_cell.getNeighbors():\n                neighbor_cell = grid.getCell(neighbor_pos.row, neighbor_pos.col)\n                new_values_tuple = current_values_tuple + (neighbor_cell.value,)\n                new_length = current_length + 1\n                new_cells_list = current_cells_list + [neighbor_cell]\n\n                heapq.heappush(min_heap, (new_values_tuple, new_length, neighbor_cell, new_cells_list))\n        \n        return Path(final_best_path_cells)\ndef path_to_values(path: Path) -> list[int]:\n    \"\"\"Converts a Path object into a list of its cell values for the final output.\"\"\"\n    return path.getValues()\ndef minPath(grid: list[list[int]], k: int) -> list[int]:\n    \"\"\"\n    Given a grid with N rows and N columns (N >= 2) and a positive integer k, \n    each cell of the grid contains a value. Every integer in the range [1, N * N]\n    inclusive appears exactly once on the cells of the grid.\n\n    You have to find the minimum path of length k in the grid. You can start\n    from any cell, and in each step you can move to any of the neighbor cells,\n    in other words, you can go to cells which share an edge with you current\n    cell.\n    Please note that a path of length k means visiting exactly k cells (not\n    necessarily distinct).\n    You CANNOT go off the grid.\n    A path A (of length k) is considered less than a path B (of length k) if\n    after making the ordered lists of the values on the cells that A and B go\n    through (let's call them lst_A and lst_B), lst_A is lexicographically less\n    than lst_B, in other words, there exist an integer index i (1 <= i <= k)\n    such that lst_A[i] < lst_B[i] and for any j (1 <= j < i) we have\n    lst_A[j] = lst_B[j].\n    It is guaranteed that the answer is unique.\n    Return an ordered list of the values on the cells that the minimum path go through.\n\n    Examples:\n\n        Input: grid = [ [1,2,3], [4,5,6], [7,8,9]], k = 3\n        Output: [1, 2, 1]\n\n        Input: grid = [ [5,9,3], [4,1,6], [7,8,2]], k = 1\n        Output: [1]\n    \"\"\"\n    grid_obj = build_grid(grid)\n    Validator.validateGrid(grid_obj)\n\n    if not isinstance(k, int) or k < 1:\n        raise ValueError(\"Path length k must be a positive integer.\")\n\n    minimal_path = PathFinder.findMinimalPath(grid_obj, k)\n    result_values = path_to_values(minimal_path)\n\n    return result_values", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/132": [{"task_id": "HumanEval/132", "solution": "class InputString:\n    def __init__(self, value: str) -> None:\n        self.value = value\n        self.length = len(value)\nclass Validator:\n    def __init__(self, input_string: InputString) -> None:\n        self._input_string = input_string\n\n    def validateCharacters(self) -> bool:\n        \"\"\"Returns True if the input string contains only '[' and ']'.\"\"\"\n        for char in self._input_string.value:\n            if char not in ['[', ']']:\n                return False\n        return True\n\n    def isEmpty(self) -> bool:\n        \"\"\"Returns True if the input string is empty.\"\"\"\n        return self._input_string.length == 0\nclass BracketPair:\n    def __init__(self, openIndex: int, closeIndex: int) -> None:\n        self.openIndex = openIndex\n        self.closeIndex = closeIndex\n\n    def contains(self, other: 'BracketPair') -> bool:\n        \"\"\"Returns True if this bracket pair contains the other pair.\"\"\"\n        # A pair (i,j) contains (k,l) if i < k < l < j.\n        return (self.openIndex < other.openIndex and\n                other.closeIndex < self.closeIndex)\nclass Subsequence:\n    def __init__(self, indices: list[int], input_string: InputString) -> None:\n        self._input_string = input_string\n        self._original_indices = indices\n        self.content = \"\".join(input_string.value[i] for i in indices)\n        self.startIndex = indices[0] if indices else -1\n        self.endIndex = indices[-1] if indices else -1\n\n    def isBalanced(self) -> bool:\n        \"\"\"Checks if the subsequence content forms a balanced bracket sequence.\"\"\"\n        stack = []\n        for char in self.content:\n            if char == '[':\n                stack.append(char)\n            elif char == ']':\n                if not stack:\n                    return False\n                stack.pop()\n        return not stack\n\n    def bracketPairs(self) -> list[BracketPair]:\n        \"\"\"Extracts matched pairs (openIndex, closeIndex) relative to original string indices.\"\"\"\n        pairs = []\n        stack = [] # Stores (bracket_char, original_index)\n\n        for relative_idx, char in enumerate(self.content):\n            original_idx = self._original_indices[relative_idx]\n            if char == '[':\n                stack.append((char, original_idx))\n            elif char == ']':\n                if stack: # Assumes subsequence is balanced or handles unpoppable closes\n                    _, open_orig_idx = stack.pop()\n                    pairs.append(BracketPair(open_orig_idx, original_idx))\n        return pairs\nclass NestedDetector:\n    def hasNestedPair(self, sub: Subsequence) -> bool:\n        \"\"\"Detects if a balanced subsequence contains at least one nested pair.\"\"\"\n        pairs = sub.bracketPairs()\n        n = len(pairs)\n        for i in range(n):\n            for j in range(n):\n                if i == j:\n                    continue\n                if pairs[i].contains(pairs[j]):\n                    return True\n        return False\nclass SubsequenceFinder:\n    def __init__(self, input_string: InputString) -> None:\n        self._input_string = input_string\n\n    def enumerateIncreasingIndexSubsequences(self): # -> iterable[Subsequence]\n        \"\"\"\n        Yields candidate Subsequence objects.\n        Optimized to find the minimal '[[]]' subsequence if it exists.\n        \"\"\"\n        s = self._input_string.value\n        n = self._input_string.length\n\n        # Search for four indices i < k < l < j such that s[i]='[', s[k]='[', s[l]=']', s[j]=']'.\n        # If found, the subsequence formed by these indices ([i, k, l, j]) is balanced ('[[]]')\n        # and contains a nested pair, satisfying the problem's condition.\n        for i in range(n):\n            if s[i] == '[':\n                for k in range(i + 1, n):\n                    if s[k] == '[':\n                        for l in range(k + 1, n):\n                            if s[l] == ']':\n                                for j in range(l + 1, n):\n                                    if s[j] == ']':\n                                        yield Subsequence([i, k, l, j], self._input_string)\n                                        return # Yield the first valid subsequence and stop.\ndef is_nested(string):\n    '''\n    Create a function that takes a string as input which contains only square brackets.\n    The function should return True if and only if there is a valid subsequence of brackets \n    where at least one bracket in the subsequence is nested.\n    '''\n    input_obj = InputString(string)\n    validator = Validator(input_obj)\n\n    if validator.isEmpty():\n        return False\n    if not validator.validateCharacters():\n        # As per design, invalid characters result in False.\n        return False\n\n    finder = SubsequenceFinder(input_obj)\n    detector = NestedDetector()\n\n    for sub in finder.enumerateIncreasingIndexSubsequences():\n        # The specific implementation of enumerateIncreasingIndexSubsequences\n        # is designed to yield a minimal, balanced, and nested subsequence if one exists.\n        # Thus, additional checks for sub.isBalanced() and detector.hasNestedPair(sub)\n        # might be redundant for the specific subsequence yielded, but are included\n        # to strictly adhere to the general orchestrator logic from the design.\n        if sub.isBalanced() and detector.hasNestedPair(sub):\n            return True\n\n    return False", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [["[][][]"]]}], "HumanEval/131": [{"task_id": "HumanEval/131", "solution": "class Digit:\n    \"\"\"Represents a single decimal digit with position and provides odd classification.\"\"\"\n    def __init__(self, value: int, position: int) -> None:\n        self.value = value\n        self.position = position\n\n    def isOdd(self) -> bool:\n        \"\"\"Returns True if the digit is odd, False otherwise.\"\"\"\n        return self.value % 2 == 1\nclass InputNumber:\n    \"\"\"Represents a positive integer input and provides digit parsing.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n        self.digits: list[Digit] = []\n\n    def isValid(self) -> bool:\n        \"\"\"Validates that the input number is a positive integer.\"\"\"\n        return self.value > 0\n\n    def parseDigits(self) -> None:\n        \"\"\"Parses the base-10 digits into Digit objects (most-significant-to-least-significant order).\"\"\"\n        s_value = str(self.value)\n        self.digits = []\n        for i, char_digit in enumerate(s_value):\n            self.digits.append(Digit(int(char_digit), i))\nclass ComputationResult:\n    \"\"\"Represents the outcome of the odd digit product computation.\"\"\"\n    def __init__(self, product: int, has_odd: bool) -> None:\n        self.product = product\n        self.has_odd = has_odd\nclass OddDigitProductCalculator:\n    \"\"\"Computes the product of odd digits in an InputNumber.\"\"\"\n    def compute(self, input_number: InputNumber) -> ComputationResult:\n        \"\"\"Iterates through digits, filters for odd ones, and computes their product.\"\"\"\n        product = 1\n        has_odd = False\n        for digit in input_number.digits:\n            if digit.isOdd():\n                product *= digit.value\n                has_odd = True\n        \n        if not has_odd:\n            product = 0 # As per requirement: return 0 if all digits are even.\n            \n        return ComputationResult(product, has_odd)\ndef digits(n: int) -> int:\n    \"\"\"Given a positive integer n, return the product of the odd digits.\n    Return 0 if all digits are even.\n    For example:\n    digits(1)  == 1\n    digits(4)  == 0\n    digits(235) == 15\n    \"\"\"\n    input_num = InputNumber(n)\n    if not input_num.isValid():\n        raise ValueError(\"n must be a positive integer\")\n    \n    input_num.parseDigits()\n    \n    calculator = OddDigitProductCalculator()\n    result = calculator.compute(input_num)\n    \n    return result.product", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/133": [{"task_id": "HumanEval/133", "solution": "from math import ceil\ndef sum_squares(lst):\n    \"\"\"Calculates the sum of squared numbers in the list after rounding each element up to the nearest integer.\n    \"\"\"\n    total_sum = 0\n    for num in lst:\n        ceiled_num = ceil(num)\n        total_sum += ceiled_num * ceiled_num\n    return total_sum", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/135": [{"task_id": "HumanEval/135", "solution": "def can_arrange(arr):\n    \"\"\"\n    Returns the largest index of an element that is not greater than or equal\n    to the element immediately preceding it. Returns -1 if no such element exists.\n    \"\"\"\n    largest_invalid_index = -1\n    for i in range(1, len(arr)):\n        if arr[i] < arr[i-1]:\n            largest_invalid_index = i\n    return largest_invalid_index", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/136": [{"task_id": "HumanEval/136", "solution": "from dataclasses import dataclass\nfrom typing import List, Optional, Tuple\ndef largest_smallest_integers(lst):\n    '''\n    Create a function that returns a tuple (a, b), where 'a' is\n    the largest of negative integers, and 'b' is the smallest\n    of positive integers in a list.\n    If there is no negative or positive integers, retu