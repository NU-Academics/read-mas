2x\n    -0.5\n    >>> round(find_zero([-6, 11, -6, 1]), 2) # (x - 1) * (x - 2) * (x - 3) = -6 + 11x - 6x^2 + x^3\n    1.0\n    \"\"\"\n    rf = RootFinder()\n    return rf.find_zero(xs)", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[[5, 10, -3, 1]]]}], "HumanEval/37": [{"task_id": "HumanEval/37", "solution": "class EvenIndexCollector:\n    def collect(self, l: list) -> list:\n        \"\"\"Returns a new list containing values from l at even indices.\"\"\"\n        even_values = []\n        for i in range(0, len(l), 2):\n            even_values.append(l[i])\n        return even_values\nclass Sorter:\n    def sort(self, values: list) -> list:\n        \"\"\"Returns a new list sorted in ascending order.\"\"\"\n        return sorted(values)\nclass Assembler:\n    def assemble(self, original: list, sorted_even_values: list) -> list:\n        \"\"\"Constructs a new list from original and sorted_even_values.\"\"\"\n        result = list(original)\n        even_values_idx = 0\n        for i in range(len(result)):\n            if i % 2 == 0:\n                result[i] = sorted_even_values[even_values_idx]\n                even_values_idx += 1\n        return result\ndef sort_even(l: list):\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the odd indicies, while its values at the even indicies are equal\n    to the values of the even indicies of l, but sorted.\n    >>> sort_even([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_even([5, 6, 3, 4])\n    [3, 6, 5, 4]\n    \"\"\"\n    collector = EvenIndexCollector()\n    sorter = Sorter()\n    assembler = Assembler()\n\n    even_values = collector.collect(l)\n    sorted_even_values = sorter.sort(even_values)\n    result_list = assembler.assemble(l, sorted_even_values)\n\n    return result_list", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/41": [{"task_id": "HumanEval/41", "solution": "class Input:\n    \"\"\"Encapsulates provided value n and provides validation facade.\"\"\"\n    def __init__(self, n: object) -> None:\n        self.n = n\n\n    def validate(self, validator: 'Validator') -> bool:\n        \"\"\"Validates the input n using the provided validator.\"\"\"\n        return validator.is_integer(self.n) and validator.is_non_negative(self.n)\nclass Validator:\n    \"\"\"Validates that value is Python int and non-negative; raises exception.\"\"\"\n    def is_integer(self, value: object) -> bool:\n        \"\"\"Checks if the value is an integer.\"\"\"\n        return isinstance(value, int)\n\n    def is_non_negative(self, value: int) -> bool:\n        \"\"\"Checks if the integer value is non-negative.\"\"\"\n        return value >= 0\n\n    def raise_invalid_input_error(self) -> None:\n        \"\"\"Raises a ValueError for invalid input.\"\"\"\n        raise ValueError(\"n must be a non-negative int\")\nclass CollisionCalculator:\n    \"\"\"Computes collisions equal to n * n.\"\"\"\n    def compute(self, n: int) -> int:\n        \"\"\"Calculates the total number of collisions.\"\"\"\n        return n * n\nclass CollisionResult:\n    \"\"\"Represents the computed collision count.\"\"\"\n    def __init__(self, count: int) -> None:\n        self.count = count\ndef car_race_collision(n: int) -> int:\n    \"\"\"\n    Imagine a road that's a perfectly straight infinitely long line.\n    n cars are driving left to right;  simultaneously, a different set of n cars\n    are driving right to left.   The two sets of cars start out being very far from\n    each other.  All cars move in the same speed.  Two cars are said to collide\n    when a car that's moving left to right hits a car that's moving right to left.\n    However, the cars are infinitely sturdy and strong; as a result, they continue moving\n    in their trajectory as if they did not collide.\n\n    This function outputs the number of such collisions.\n    \"\"\"\n    input_obj = Input(n)\