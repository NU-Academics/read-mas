    raise ValueError(\"Input integer must be 2 or greater.\")\n\n        factors = []\n        temp_n = n\n\n        # Handle factor 2\n        while temp_n % 2 == 0:\n            factors.append(2)\n            temp_n //= 2\n\n        # Handle odd factors\n        d = 3\n        while d * d <= temp_n:\n            while temp_n % d == 0:\n                factors.append(d)\n                temp_n //= d\n            d += 2\n\n        # If temp_n is still greater than 1, it must be a prime factor itself\n        if temp_n > 1:\n            factors.append(temp_n)\n        \n        result = FactorizationResult(factors)\n        result.verify_product_equals(n) # Verification as per design, internal check for consistency.\n\n        return result.factors\ndef factorize(n: int) -> List[int]:\n    \"\"\" Return list of prime factors of given integer in the order from smallest to largest.\n    Each of the factors should be listed number of times corresponding to how many times it appeares in factorization.\n    Input number should be equal to the product of all factors\n    >>> factorize(8)\n    [2, 2, 2]\n    >>> factorize(25)\n    [5, 5]\n    >>> factorize(70)\n    [2, 5, 7]\n    \"\"\"\n    return FactorizationFunction.factorize(n)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/30": [{"task_id": "HumanEval/30", "solution": "def get_positive(l: list):\n    \"\"\"Return only positive numbers in the list.\n    >>> get_positive([-1, 2, -4, 5, 6])\n    [2, 5, 6]\n    >>> get_positive([5, 3, -5, 2, -3, 3, 9, 0, 123, 1, -10])\n    [5, 3, 2, 3, 9, 123, 1]\n    \"\"\"\n    positive_numbers = []\n    for number in l:\n        if number > 0:\n            positive_numbers.append(number)\n    return positive_numbers", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/34": [{"task_id": "HumanEval/34", "solution": "def unique(l: list):\n    \"\"\"Return sorted unique elements in a list.\"\"\"\n    if len(l) == 0:\n        return []\n\n    _validate_comparable(l)\n    unique_values = _deduplicate(l)\n    sorted_values = _sort_elements(unique_values)\n    return sorted_values\ndef _validate_comparable(elements: list) -> None:\n    \"\"\"Verify all elements are mutually comparable. Raises TypeError if incompatibility is found.\"\"\"\n    if len(elements) <= 1:\n        return\n\n    # Attempt to sort a copy to ensure all elements are mutually comparable.\n    try:\n        sorted(list(elements))\n    except TypeError as e:\n        raise TypeError(f\"Elements in the list are not mutually comparable: {e}\") from None\ndef _deduplicate(elements: list) -> list:\n    \"\"\"Produce a list of distinct values according to language equality semantics.\"\"\"\n    # Using a set to efficiently get unique elements.\n    return list(set(elements))\ndef _sort_elements(elements: list) -> list:\n    \"\"\"Sort given elements in ascending order using language natural ordering.\"\"\"\n    # Python's built-in sorted() function provides deterministic natural ordering.\n    return sorted(elements)", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[[null, null, null, null]]]}], "HumanEval/35": [{"task_id": "HumanEval/35", "solution": "def max_element(l: list):\n    \"\"\"Return maximum element in the list.\n    >>> max_element([1, 2, 3])\n    3\n    >>> max_element([5, 3, -5, 2, -3, 3, 9, 0, 123, 1, -10])\n    123\n    \"\"\"\n    current_max = l[0]  # Initialize with the first element; list is non-empty per precondition.\n    for element in l[1:]:  # Iterate through the rest of the list.\n        if element > current_max:\n            current_max = element\n    return current_max", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/32": [{"task_id": "HumanEval/32", "solution": "import math\nfrom typing import List, Union\nclass ValidationError(Exception):\n    \"\"\"Raise and represent validation errors for malformed inputs or precondition failures.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self._message = message\n\n    def __str__(self) -> str:\n        return self._message\nclass CoefficientList:\n    \"\"\"Internal wrapper for input coefficient list; performs numeric coercion/validation.\"\"\"\n    def __init__(self, xs: list) -> None:\n        if not isinstance(xs, list):\n            raise ValidationError(\"Coefficients must be a list.\")\n        if not xs:\n            raise ValidationError(\"Coefficient list cannot be empty.\")\n\n        self.values: List[float] = []\n        for i, val in enumerate(xs):\n            if not isinstance(val, (int, float)):\n                raise ValidationError(f\"Coefficient at index {i} is not a number: {val}\")\n            self.values.append(float(val))\n\n    def is_list(self) -> bool:\n        \"\"\"Checks if the wrapped value is a list (always true after successful init).\"\"\"\n        return True\n\n    def is_even_length(self) -> bool:\n        \"\"\"Checks if the coefficient list has an even number of elements.\"\"\"\n        return len(self.values) % 2 == 0\n\n    def highest_coefficient(self) -> float:\n        \"\"\"Returns the highest-degree coefficient.\"\"\"\n        return self.values[-1]\n\n    def length(self) -> int:\n        \"\"\"Returns the number of coefficients.\"\"\"\n        return len(self.values)\nclass MathUtil:\n    \"\"\"Thin wrapper delegating power and absolute value operations to Python's math functions.\"\"\"\n    @staticmethod\n    def pow(x: float, i: int) -> float:\n        \"\"\"Calculates x raised to the power of i.\"\"\"\n        return math.pow(x, i)\n\n    @staticmethod\n    def abs(x: float) -> float:\n        \"\"\"Returns the absolute value of x.\"\"\"\n        return abs(x)\nclass Polynomial:\n    \"\"\"Holds coefficients and provides deterministic evaluation and derivative coefficient computation.\"\"\"\n    def __init__(self, coefficients: List[float]) -> None:\n        if not coefficients:\n            raise ValidationError(\"Polynomial coefficients cannot be empty.\")\n        self.coefficients = coefficients\n\n    def evaluate(self, x: float) -> float:\n        \"\"\"Evaluates the polynomial at point x using MathUtil.pow for terms.\"\"\"\n        return sum([coeff * MathUtil.pow(x, i) for i, coeff in enumerate(self.coefficients)])\n\n    def derivative_coefficients(self) -> List[float]:\n        \"\"\"Returns the coefficients for the derivative polynomial.\"\"\"\n        if len(self.coefficients) <= 1:\n            return [0.0] # Derivative of constant or empty is 0\n\n        # The derivative of c_i * x^i is i * c_i * x^(i-1).\n        # So, the new coefficients are i * c_i for i from 1 to n.\n        return [i * coeff for i, coeff in enumerate(self.coefficients) if i > 0]\ndef poly(xs: list, x: float) -> float:\n    \"\"\"\n    Evaluates polynomial with coefficients xs at point x.\n    This public function validates inputs and delegates computation to internal Polynomial class.\n    \"\"\"\n    coefs = CoefficientList(xs).values\n    p = Polynomial(coefs)\n    return p.evaluate(x)\nclass RootFinder:\n    \"\"\"Implements root-finding (Newton-Raphson) and input validation for find_zero.\"\"\"\n    def __init__(self, tolerance: float = 1e-8, max_iterations: int = 100) -> None:\n        self.tolerance = tolerance\n        self.max_iterations = max_iterations\n\n    def validate(self, xs: list) -> None:\n        \"\"\"Validates that xs is a list, has even length, and has a non-zero highest-degree coefficient.\"\"\"\n        coef_list = CoefficientList(xs)\n\n        if not coef_list.is_even_length():\n            raise ValidationError(\"Coefficient list length must be even for find_zero.\")\n\n        if MathUtil.abs(coef_list.highest_coefficient()) == 0.0:\n            raise ValidationError(\"Highest degree coefficient cannot be zero for find_zero