odd. Ignore numbers that are negative or not integers.\n    \n    double_the_difference([1, 3, 2, 0]) == 1 + 9 + 0 + 0 = 10\n    double_the_difference([-1, -2, 0]) == 0\n    double_the_difference([9, -2]) == 81\n    double_the_difference([0]) == 0  \n   \n    If the input list is empty, return 0.\n    '''\n    input_list = InputList(lst)\n    if input_list.isEmpty():\n        return 0\n\n    total_sum = 0\n    for raw_value in input_list.values:\n        n = Number(raw_value)\n        if n.isInteger() and n.isNonNegative() and n.isOdd():\n            fi = FilteredInteger(int(n.value))\n            total_sum += fi.square()\n\n    if total_sum == 0:\n        return 0\n        \n    result = Result(sumOfSquares=total_sum)\n    return result.asInteger()", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[[1.0, 3.5, -4.6]]]}], "HumanEval/150": [{"task_id": "HumanEval/150", "solution": "import math\nclass PrimalityTest:\n    method: str = \"trial_division\"\n\n    @staticmethod\n    def is_prime(n):\n        \"\"\"Checks if a number n is prime using trial division.\"\"\"\n        if n <= 1:\n            return False\n        if n == 2:\n            return True\n        if n % 2 == 0:\n            return False\n        \n        i = 3\n        while i * i <= n:\n            if n % i == 0:\n                return False\n            i += 2\n        return True\ndef x_or_y(n, x, y):\n    \"\"\"A simple program which should return the value of x if n is \n    a prime number and should return the value of y otherwise.\n\n    Examples:\n    for x_or_y(7, 34, 12) == 34\n    for x_or_y(15, 8, 5) == 5\n    \n    \"\"\"\n    if PrimalityTest.is_prime(n):\n        return x\n    else:\n        return y", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/149": [{"task_id": "HumanEval/149", "solution": "def sorted_list_sum(lst):\n    \"\"\"Filters a list of strings, keeping only those with even lengths,\n    then sorts them by length (ascending) and alphabetically for ties.\n    \"\"\"\n    \n    # Filter out strings with odd lengths\n    filtered_list = [s for s in lst if len(s) % 2 == 0]\n    \n    # Sort the filtered list by length, then alphabetically for ties\n    sorted_list = sorted(filtered_list, key=lambda s: (len(s), s))\n    \n    return sorted_list", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/152": [{"task_id": "HumanEval/152", "solution": "class LengthMismatchError(Exception):\n    \"\"\"Raised when the game and guess arrays have different lengths.\"\"\"\n    pass\nclass NonNumericElementError(Exception):\n    \"\"\"Raised when an element in the game or guess array is non-numeric.\"\"\"\n    pass\nclass Match:\n    def __init__(self, actualScore, guessedScore):\n        self.actualScore = actualScore\n        self.guessedScore = guessedScore\n        self.difference = None\n\n    def computeDifference(self):\n        if self.actualScore == self.guessedScore:\n            self.difference = 0\n        else:\n            self.difference = abs(self.guessedScore - self.actualScore)\n        return self.difference\nclass MatchCollection:\n    def __init__(self, game, guess):\n        self.game = game\n        self.guess = guess\n\n    def validate(self):\n        if len(self.game) != len(self.guess):\n            raise LengthMismatchError(\"Input arrays 'game' and 'guess' must have the same length.\")\n\n        for score in self.game:\n            if not isinstance(score, (int, float)):\n                raise NonNumericElementError(f\"Non-numeric element found in 'game': {score}\")\n        \n        for score in self.guess:\n            if not isinstance(score, (int, float)):\n                raise NonNumericElementError(f\"Non-numeric element found in 'guess': {score}\")\n        \n        return True\nclass ResultArray:\n    def __init__(self):\n        self.values = []\n\n    def append(self, value):\n        self.values.append(value)\n\n    def length(self):\n        return len(self.values)\nclass Comparator:\n    def compare(self, game, guess):\n        match_collection = MatchCollection(game, guess)\n        match_collection.validate()\n\n        result_array = ResultArray()\n        for i in range(len(game)):\n            match = Match(game[i], guess[i])\n            difference = match.computeDifference()\n            result_array.append(difference)\n        \n        return result_array.values\ndef compare(game,guess):\n    \"\"\"Compares game scores against guesses and returns the absolute differences.\"\"\"\n    comparator_instance = Comparator()\n    return comparator_instance.compare(game, guess)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/153": [{"task_id": "HumanEval/153", "solution": "from typing import List, Tuple\nfrom dataclasses import dataclass\ndef _select_strongest_extension(exts: List[Extension]) -> Extension:\n    \"\"\"Selects the extension with the highest strength, breaking ties by earliest occurrence.\"\"\"\n    strongest_ext = exts[0]\n    max_strength = exts[0].strength\n\n    for i in range(1, len(exts)):\n        current_ext = exts[i]\n        if current_ext.strength > max_strength:\n            max_strength = current_ext.strength\n            strongest_ext = current_ext\n    return strongest_ext\ndef Strongest_Extension(class_name, extensions):\n    \"\"\"Finds the strongest extension based on (CAP - SM) and returns it in \"ClassName.ExtensionName\" format.\"\"\"\n    extension_objects: List[Extension] = []\n    for ext_name in extensions:\n        ext = Extension(name=ext_name)\n        ext.compute_metrics()\n        extension_objects.append(ext)\n\n    strongest_extension = _select_strongest_extension(extension_objects)\n\n    return f\"{class_name}.{strongest_extension.name}\"", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "