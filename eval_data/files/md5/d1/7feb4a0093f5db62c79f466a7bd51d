alized numeric form.\"\"\"\n    def __init__(self, value):\n        self.original_value = value\n        self.original_type = type(value).__name__\n        self.normalized_value = None\n        self.is_valid = True # Default for int/float; updated for str after normalization\n\n    def normalize(self, normalizer: StringNormalizer) -> None:\n        \"\"\"Normalizes the input value to a float for comparison.\"\"\"\n        if self.original_type == 'str':\n            self.normalized_value = normalizer.normalize(self.original_value)\n            self.is_valid = True # Assuming normalizer.normalize succeeds for valid inputs\n        elif self.original_type in ('int', 'float'):\n            self.normalized_value = float(self.original_value)\n            self.is_valid = True\n        # For types not covered by FR1, is_valid remains True and normalized_value remains None\n        # This behavior is consistent with the constraint \"Do NOT add ... raise exceptions for edge cases\".\nclass Comparator:\n    \"\"\"Compares two InputValue instances by their normalized_value and produces a ComparisonResult.\"\"\"\n    def compare(self, a: InputValue, b: InputValue) -> ComparisonResult:\n        # Comparison relies on normalized_value being a float.\n        # Per constraints, no explicit checks for is_valid or exceptions for invalid inputs.\n        \n        if a.normalized_value == b.normalized_value:\n            return ComparisonResult(winner_original_value=None, are_equal=True)\n        elif a.normalized_value > b.normalized_value:\n            return ComparisonResult(winner_original_value=a.original_value, are_equal=False)\n        else: # b.normalized_value > a.normalized_value\n            return ComparisonResult(winner_original_value=b.original_value, are_equal=False)\ndef compare_one(a, b):\n    \"\"\"\n    Create a function that takes integers, floats, or strings representing\n    real numbers, and returns the larger variable in its given variable type.\n    Return None if the values are equal.\n    Note: If a real number is represented as a string, the floating point might be . or ,\n    \"\"\"\n    a_iv = InputValue(a)\n    b_iv = InputValue(b)\n\n    normalizer = StringNormalizer()\n\n    a_iv.normalize(normalizer)\n    b_iv.normalize(normalizer)\n\n    comparator = Comparator()\n    comparison_result = comparator.compare(a_iv, b_iv)\n\n    return comparison_result.winner_original_value", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/140": [{"task_id": "HumanEval/140", "solution": "class InputString:\n    def __init__(self, raw: str):\n        self.raw: str = raw\n\n    def length(self) -> int:\n        return len(self.raw)\n\n    def char_at(self, index: int) -> str:\n        return self.raw[index]\nclass OutputString:\n    def __init__(self, value: str):\n        self.value: str = value\nclass SpaceRun:\n    def __init__(self, length: int):\n        self.length: int = length\n\n    def replacement(self) -> str:\n        if self.length >= 3:\n            return '-'\n        else:\n            return '_' * self.length\nclass FixSpacesFunction:\n    def fix(self, text: str) -> str:\n        input_obj = InputString(text)\n        out_obj = self.applyReplacementRules(input_obj)\n        return out_obj.value\n\n    def applyReplacementRules(self, input_obj: InputString) -> OutputString:\n        parts: list[str] = []\n        i = 0\n        while i < input_obj.length():\n            ch = input_obj.char_at(i)\n            if ch != ' ':\n                parts.append(ch)\n                i += 1\n            else:\n                count = 0\n                while i < input_obj.length() and input_obj.char_at(i) == ' ':\n                    count += 1\n                    i += 1\n                parts.append(SpaceRun(count).replacement())\n        return OutputString(''.join(parts))\ndef fix_spaces(text):\n    \"\"\"\n    Given a string text, replace all spaces in it with underscores, \n    and if a string has more than 2 consecutive spaces, \n    then replace all consecutive spaces with - \n    \n    fix_spaces(\"Example\") == \"Example\"\n    fix_spaces(\"Example 1\") == \"Example_1\"\n    fix_spaces(\" Example 2\") == \"_Example_2\"\n    fix_spaces(\" Example   3\") == \"_Example-3\"\n    \"\"\"\n    f = FixSpacesFunction()\n    return f.fix(text)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/141": [{"task_id": "HumanEval/141", "solution": "class FileName:\n    \"\"\"Represents a file name, its parsed components, and digit count.\"\"\"\n    def __init__(self, raw_name: str) -> None:\n        self.raw_name = raw_name\n        self.prefix = \"\"\n        self.extension = \"\"\n        self.digit_count = 0\n\n    def parse(self) -> None:\n        \"\"\"Splits raw_name into prefix and extension if exactly one dot exists.\"\"\"\n        parts = self.raw_name.split('.')\n        if len(parts) == 2:\n            self.prefix = parts[0]\n            self.extension = parts[1]\n\n    def count_digits(self) -> None:\n        \"\"\"Counts digits (0-9) anywhere in the raw_name and stores the count.\"\"\"\n        self.digit_count = sum(1 for char in self.raw_name if char.isdigit())\nclass ValidationResult:\n    \"\"\"Represents the outcome of a validation operation.\"\"\"\n    def __init__(self, valid: bool, reason: str = \"\") -> None:\n        self.valid = valid\n        self.reason = reason\nallowed_extensions = {\"txt\", \"exe\", \"dll\"}\nclass FileNameValidator:\n    \"\"\"Validates a FileName object against a set of business rules.\"\"\"\n    def __init__(self) -> None:\n        pass\n\n    def validate(self, file: FileName) -> ValidationResult:\n        \"\"\"Performs all validation checks on the given FileName object.\"\"\"\n        if not self._check_dot(file):\n            return ValidationResult(valid=False, reason=\"Incorrect dot count\")\n        if not self._check_prefix(file):\n            return ValidationResult(valid=False, reason=\"Invalid prefix\")\n        if not self._check_extension(file):\n            return ValidationResult(valid=False, reason=\"Invalid extension\")\n        if not self._check_digit_count(file):\n            return ValidationResult(valid=False, reason=\"Too many digits\")\n        \n        return ValidationResult(valid=True)\n\n    def _check_dot(self, file: FileName) -> bool:\n        \"\"\"Verifies exactly one dot in the raw file name.\"\"\"\n        return file.raw_name.count('.') == 1\n\n    def _check_prefix(self, file: FileName) -> bool:\n        \"\"\"Verifies prefix is non-empty and starts with an alphabet letter.\"\"\"\n        if not file.prefix:\n            return False\n        return file.prefix[0].isalpha()\n\n    def _check_extension(self, file: FileName) -> bool:\n        \"\"\"Verifies the extension is one of the allowed types.\"\"\"\n        return file.extension in allowed_extensions\n\n    def _check_digit_count(self, file: FileName) -> bool:\n        \"\"\"Verifies the total digit count is not more than three.\"\"\"\n        return file.digit_count <= 3\ndef file_name_check(file_name):\n    \"\"\"Create a function which takes a string representing a file's name, and returns\n    'Yes' if the the file's name is valid, and returns 'No' otherwise.\n    A file's name is considered to be valid if and only if all the following conditions \n    are met:\n    - There should not be more than three digits ('0'-'9') in the file's name.\n    - The file's name contains exactly one dot '.'\n    - The substring before the dot should not be empty, and it starts with a letter from \n    the latin alphapet ('a'-'z' and 'A'-'Z').\n    - The substring after the dot should be one of these: ['txt', 'exe', 'dll']\n    Examples:\n    file_name_check(\"example.txt\") # => 'Yes'\n    file_name_check(\"1example.dll\") # => 'No' (the name should start with a latin alphapet letter)\n    \"\"\"\n    if not isinstance(file_name, str):\n        return 'No'\n\n    file = FileName(raw_name=file_name)\n    file.parse()\n    file.count_digits()\n\n    validator = FileNameValidator()\n    result = validator.validate(file)\n\n    if result.valid:\n        return 'Yes'\n    else:\n        return 'No'", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/143": [{"task_id": "HumanEval/143", "solution": "import math\nclass PrimeChecker:\n    \"\"\"\n    Encapsulates primality logic.\n    \"\"\"\n    @staticmethod\n    def isPrime(n: int) -> bool:\n        \"\"\"\n        Returns True for prime numbers n >= 2, False otherwise.\n        \"\"\"\n        if n < 2:\n            return False\n        for i in range(2, int(math.sqrt(n)) + 1):\n            if n % i == 0:\n                return False\n        return True\nclass Word:\n    \"\"\"\n    Domain data class representing a word.\n    \"\"\"\n    def __init__(self, text: str, position: int):\n        self.text: str = text\n        self.length: int = len(text)\n        self.position: int = position\nclass Sentence:\n    \"\"\"\n    Domain data class representing a sentence, with methods for splitting.\n    \"\"\"\n    def __init__(self, text: str):\n        self.text: str = text\n\n    def totalLength(self) -> int:\n        \"\"\"Returns the total length of the sentence text.\"\"\"\n        return len(self.text)\n\n    def split(self) -> list[Word]:\n        \"\"\"\n        Splits the sentence into Word objects by single spaces.\n        \"\"\"\n        words = []\n        parts = self.text.split(' ')\n        for i, part in enumerate(parts):\n            if part: # Ensure no empty strings from split if there were multiple spaces, though validation should prevent\n                words.append(Word(part, i + 1))\n        return words\nclass Result:\n    \"\"\"\n    Domain data class for the operation's output.\n    \"\"\"\n    def __init__(self, output_text: str):\n        self.outputText: str = output_text\ndef words_in_sentence(sentence: str) -> str:\n    \"\"\"\n    Returns a string containing words from the original sentence whose lengths are prime numbers.\n    The order of the words in the new string is preserved.\n    Raises ValueError for invalid input sentences.\n    \"\"\"\n    _validate_input(sentence)\n\n    sentence_obj = Sentence(sentence)\n    words = sentence_obj.split()\n\n    selected_words = []\n    for word in words:\n        if PrimeChecker.isPrime(word.length):\n            selected_words.append(word.text)\n\n    result_text = ' '.join(selected_words)\n    return Result(result_text).outputText", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [["This is a test"]], "plus_fail_tests": [["cats and dogs"]]}], "HumanEval/142": [{"task_id": "HumanEval/142", "solution": "import math\nclass ListInput:\n    \"\"\"Validates input list and builds Element instances.\"\"\"\n    def __init__(self, raw):\n        self._raw = raw\n        self.elements = []\n\n    def validate(self) -> bool:\n        \"\"\"Validates raw input is a list of integers, raising exceptions on failure.\"\"\"\n        if not isinstance(self._raw, list):\n            raise TypeError(\"Input must be a list.\")\n        for item in self._raw:\n            if not isinstance(item, int):\n                raise ValueError(\"All elements in the list must be integers.\")\n        return True\n\n    def build_elements(self) -> list:\n        \"\"\"Creates Element(index, value) for each item in the validated list.\"\"\"\n        self.elements = [Element(i, v) for i, v in enumerate(self._raw)]\n        return self.elements\nclass Element:\n    \"\"\"Represents a single list element and performs its index-based transformation.\"\"\"\n    def __init__(self, index: int, value: int):\n        self.index = index\n        self.value = value\n        self.transformed_value = None\n        self.transform_type = None\n\n    def applyTransformation(self, rule_engine, transformer) -> None:\n        \"\"\"Uses rule_engine to select transformation and applies it via transformer.\"\"\"\n        self.transform_type = rule_engine.selectTransformation(self.index)\n        if self.transform_type == 'square':\n            self.transformed_value = transformer.square(self.value)\n        elif self.transform_type == 'cube':\n            self.transformed_value = transformer.cube(self.value)\n        else: # 'identity'\n            self.transformed_value = transformer.identity(self.value)\n\n    def get_transformed(self) -> int:\n        \"\"\"Returns the transformed value of the element.\"\"\"\n        return self.transformed_value\nclass RuleEngine:\n    \"\"\"Encapsulates business-rule logic for index multiples and transformation selection.\"\"\"\n    def isMultipleOf(self, index: int, n: int) -> bool:\n        \"\"\"Checks if an index is a multiple of n.\"\"\"\n        return (index % n) == 0\n\n    def selectTransformation(self, index: int) -> str:\n        \"\"\"Selects the transformation type based on index, with precedence for multiple of 3.\"\"\"\n        if self.isMultipleOf(index, 3):\n            return 'square'\n        elif self.isMultipleOf(index, 4):\n            return 'cube'\n        else:\n            return 'identity'\nclass Transformer:\n    \"\"\"Provides concrete arithmetic transformations on integers.\"\"\"\n    def square(self, v: int) -> int:\n        \"\"\"Returns the square of an integer.\"\"\"\n        return v * v\n\n    def cube(self, v: int) -> int:\n        \"\"\"Returns the cube of an integer.\"\"\"\n        return v * v * v\n\n    def identity(self, v: int) -> int:\n        \"\"\"Returns the integer itself.\"\"\"\n        return v\nclass SumCalculator:\n    \"\"\"Aggregates transformed element values into a single integer sum.\"\"\"\n    def aggregate(self, elements: list) -> int:\n        \"\"\"Sums the transformed values of all elements, returning 0 for an empty list.\"\"\"\n        if not elements:\n            return 0\n        total_sum = sum(el.get_transformed() for el in elements)\n        return total_sum\ndef sum_squares(lst):\n    \"\"\"\"\n    This function will take a list of integers. For all entries in the list, the function shall square the integer entry if its index is a \n    multiple of 3 and will cube the integer entry if its index is a multiple of 4 and not a multiple of 3. The function will not \n    change the entries in the list whose indexes are not a multiple of 3 or 4. The function shall then return the sum of all entries. \n    \n    Examples:\n    For lst = [1,2,3] the output should be 6\n    For lst = []  the output should be 0\n    For lst = [-1,-5,2,-1,-5]  the output should be -126\n    \"\"\"\n    li = ListInput(lst)\n    li.validate()\n    elements = li.build_elements()\n    rule_engine = RuleEngine()\n    transformer = Transformer()\n    for el in elements:\n        el.applyTransformation(rule_engine, transformer)\n    calculator = SumCalculator()\n    return calculator.aggregate(elements)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/144": [{"task_id": "HumanEval/144", "solution": "class Fraction:\n    \"\"\"Represents a fraction with a numerator and a denominator.\"\"\"\n    def __init__(self, numerator: int, denominator: int):\n        self.numerator = numerator\n        self.denominator = denominator\n\n    @staticmethod\n    def fromString(s: str) -> 'Fraction':\n        \"\"\"Parses a string 'numerator/denominator' into a Fraction object.\"\"\"\n        parts = s.split('/')\n        numerator = int(parts[0])\n        denominator = int(parts[1])\n        return Fraction(numerator, denominator)\nclass Product:\n    \"\"\"Represents the product of two fractions and can check if it's an integer.\"\"\"\n    def __init__(self, numerator: int, denominator: int):\n        self.numerator = numerator\n        self.denominator = denominator\n\n    def isInteger(self) -> bool:\n        \"\"\"Returns True if the product is a whole number, False otherwise.\"\"\"\n        return self.numerator % self.denominator == 0\nclass Simplifier:\n    \"\"\"Orchestrates parsing fractions, multiplying them, and checking if the product is an integer.\"\"\"\n    def simplify(self, x: str, n: str) -> bool:\n        \"\"\"Parses two fraction strings, multiplies them, and checks if the result is an integer.\"\"\"\n        frac_x = self.parse(x)\n        frac_n = self.parse(n)\n        product = self.multiply(frac_x, frac_n)\n        return self.isProductInteger(product)\n\n    def parse(self, s: str) -> Fraction:\n        \"\"\"Delegates string parsing to the Fraction class.\"\"\"\n        return Fraction.fromString(s)\n\n    def multiply(self, a: Fraction, b: Fraction) -> Product:\n        \"\"\"Multiplies two Fraction objects to produce a Product object.\"\"\"\n        product_numerator = a.numerator * b.numerator\n        product_denominator = a.denominator * b.denominator\n        return Product(product_numerator, product_denominator)\n\n    def isProductInteger(self, p: Product) -> bool:\n        \"\"\"Delegates integer check to the Product object.\"\"\"\n        return p.isInteger()\ndef simplify(x, n):\n    \"\"\"Your task is to implement a function that will simplify the expression\n    x * n. The function returns True if x * n evaluates to a whole number and False\n    otherwise. Both x and n, are string representation of a fraction, and have the following format,\n    <numerator>/<denominator> where both numerator and denominator are positive whole numbers.\n\n    You can assume that x, and n are valid fractions, and do not have zero as denominator.\n    \"\"\"\n    return Simplifier().simplify(x, n)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/39": [{"task_id": "HumanEval/39", "solution": "class InputParameter:\n    def __init__(self, n: int) -> None:\n        self.n = n\n\n    def validate(self) -> bool:\n        \"\"\"Validates if n is an integer greater than or equal to 1.\"\"\"\n        return isinstance(self.n, int) and self.n >= 1\nclass FibonacciGenerator:\n    def __init__(self) -> None:\n        \"\"\"Initializes the generator for the Fibonacci sequence (F1=1, F2=1).\"\"\"\n        self._a = 0\n        self._b = 1\n\n    def reset(self) -> None:\n        \"\"\"Resets the generator to its initial state.\"\"\"\n        self._a = 0\n        self._b = 1\n\n    def next(self) -> int:\n        \"\"\"Generates the next Fibonacci number in the sequence.\"\"\"\n        current_fib = self._b\n        self._a, self._b = self._b, self._a + self._b\n        return current_fib\n\n    def get_by_index(self, index: int) -> int:\n        \"\"\"Returns the Fibonacci number at the specified 1-based index.\"\"\"\n        if index < 1:\n            raise ValueError(\"Fibonacci index must be >= 1\")\n        \n        a, b = 0, 1\n        for _ in range(index):\n            a, b = b, a + b\n        return a\nclass PrimeChecker:\n    def __init__(self) -> None:\n        \"\"\"Initializes the prime checker.\"\"\"\n        pass\n\n    def is_prime(self, x: int) -> bool:\n        \"\"\"Checks if a given integer x is a prime number (canonical definition).\"\"\"\n        if x < 2:\n            return False\n        for i in range(2, int(x**0.5) + 1):\n            if x % i == 0:\n                return False\n        return True\nclass PrimeFibFunction:\n    def __init__(self, generator: 'FibonacciGenerator', checker: 'PrimeChecker') -> None:\n        \"\"\"Initializes the coordinator with FibonacciGenerator and PrimeChecker dependencies.\"\"\"\n        self._generator = generator\n        self._checker = checker\n\n    def prime_fib(self, n: int) -> int:\n        \"\"\"Finds the n-th Fibonacci number that is also prime.\"\"\"\n        self._generator.reset()\n        prime_count = 0\n        \n        while True:\n            fib_value = self._generator.next()\n            if self._checker.is_prime(fib_value):\n                prime_count += 1\n                if prime_count == n:\n                    return fib_value\ndef prime_fib(n: int):\n    \"\"\"\n    prime_fib returns n-th number that is a Fibonacci number and it's also prime.\n    >>> prime_fib(1)\n    2\n    >>> prime_fib(2)\n    3\n    >>> prime_fib(3)\n    5\n    >>> prime_fib(4)\n    13\n    >>> prime_fib(5)\n    89\n    \"\"\"\n    ip = InputParameter(n)\n    if not ip.validate():\n        raise ValueError('n must be an integer >= 1')\n    \n    generator = FibonacciGenerator()\n    checker = PrimeChecker()\n    coordinator = PrimeFibFunction(generator, checker)\n    \n    result_value = coordinator.prime_fib(n)\n    return result_value", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[12]]}], "HumanEval/146": [{"task_id": "HumanEval/146", "solution": "class _FilterCriteria:\n    \"\"\"Configuration carrier for filter conditions.\"\"\"\n    def __init__(self):\n        self.greaterThan10 = True\n        self.oddDigits = [1, 3, 5, 7, 9]\n        self.digitsDerivedFromAbsoluteValue = True\nclass _NumberElement:\n    \"\"\"Encapsulates a numeric value and provides digit-related methods.\"\"\"\n    def __init__(self, value, criteria):\n        self.value = value\n        self._criteria = criteria\n\n    def _to_integer_abs(self, value):\n        \"\"\"Converts to integer decimal representation of absolute value.\"\"\"\n        return int(abs(value))\n\n    def firstDigit(self):\n        \"\"\"Extracts the most significant digit of the absolute integer part.\"\"\"\n        n = self._to_integer_abs(self.value)\n        if n == 0:\n            return 0\n        while n >= 10:\n            n //= 10\n        return n\n\n    def lastDigit(self):\n        \"\"\"Extracts the least significant digit of the absolute integer part.\"\"\"\n        n = self._to_integer_abs(self.value)\n        return n % 10\n\n    def isFirstAndLastDigitOdd(self):\n        \"\"\"Checks if both first and last digits are odd.\"\"\"\n        return self.firstDigit() in self._criteria.oddDigits and self.lastDigit() in self._criteria.oddDigits\n\n    def isGreaterThan10(self):\n        \"\"\"Checks if the value is strictly greater than 10.\"\"\"\n        return self.value > 10\ndef _is_numeric(value):\n    \"\"\"Checks if the value is numeric (int or float) and not boolean.\"\"\"\n    return isinstance(value, (int, float)) and not isinstance(value, bool)\ndef specialFilter(nums):\n    \"\"\"\n    Counts elements in an array that are greater than 10 and have both \n    first and last digits odd (1, 3, 5, 7, 9).\n    \"\"\"\n    if not isinstance(nums, list):\n        raise TypeError(\"Input 'nums' must be a list.\")\n\n    count = 0\n    criteria = _FilterCriteria()\n\n    for element in nums:\n        if _is_numeric(element):\n            num_element = _NumberElement(element, criteria)\n            if num_element.isGreaterThan10() and num_element.isFirstAndLastDigitOdd():\n                count += 1\n    return count", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/147": [{"task_id": "HumanEval/147", "solution": "from typing import List\nclass ArrayElement:\n    \"\"\"\n    Represents one array element with index, computed value, and residue (value mod 3).\n    \"\"\"\n    def __init__(self, index: int, value: int, residue: int) -> None:\n        self.index = index\n        self.value = value\n        self.residue = residue\nclass Array:\n    \"\"\"\n    Builds and holds the array metadata according to a[i] = i*i - i + 1.\n    \"\"\"\n    def __init__(self, length: int) -> None:\n        self.length = length\n        self.elements: List[ArrayElement] = []\n\n    def build(self) -> None:\n        \"\"\"\n        Populates elements for i = 1..length.\n        \"\"\"\n        for i in range(1, self.length + 1):\n            value = i * i - i + 1\n            # Residue pattern: a[i] mod 3 == 0 iff i mod 3 == 2; else residue == 1.\n            residue = 0 if i % 3 == 2 else 1\n            self.elements.append(ArrayElement(i, value, residue))\nclass TripleCounter:\n    \"\"\"\n    Computes the number of valid triples using residues and combinatorial formulas.\n    \"\"\"\n    def __init__(self) -> None:\n        self.count: int = 0\n\n    def _combinations(self, n: int, k: int) -> int:\n        \"\"\"\n        Calculates n choose k. Specifically for k=3.\n        \"\"\"\n        if k < 0 or k > n:\n            return 0\n        if k == 3:\n            return n * (n - 1) * (n - 2) // 6\n        return 0 # Only k=3 is needed for this problem\n\n    def computeCount(self, array: Array) -> int:\n        \"\"\"\n        Computes the number of triples (a[i], a[j], a[k]) such that their sum is a multiple of 3.\n        \"\"\"\n        c0 = 0  # Count of elements with residue 0 (a[i] % 3 == 0)\n        c1 = 0  # Count of elements with residue 1 (a[i] % 3 == 1)\n\n        for element in array.elements:\n            if element.residue == 0:\n                c0 += 1\n            elif element.residue == 1:\n                c1 += 1\n        \n        # A sum a[i] + a[j] + a[k] is a multiple of 3 if:\n        # 1. All three elements have residue 0 (0 + 0 + 0 = 0 mod 3)\n        # 2. All three elements have residue 1 (1 + 1 + 1 = 3 = 0 mod 3)\n        self.count = self._combinations(c0, 3) + self._combinations(c1, 3)\n        return self.count\ndef get_max_triples(n: int) -> int:\n    \"\"\"\n    You are given a positive integer n. You have to create an integer array a of length n.\n        For each i (1 \u2264 i \u2264 n), the value of a[i] = i * i - i + 1.\n        Return the number of triples (a[i], a[j], a[k]) of a where i < j < k, \n    and a[i] + a[j] + a[k] is a multiple of 3.\n    \"\"\"\n    # Validate input n using the Input class (though n is guaranteed positive by problem context)\n    # input_validator = Input(n)\n    # input_validator.validate() # Assuming valid n as per problem constraints\n\n    # If n < 3, no triples can be formed\n    if n < 3:\n        return 0\n\n    # Build the array and compute residues\n    array = Array(n)\n    array.build()\n\n    # Compute the number of valid triples\n    triple_counter = TripleCounter()\n    result = triple_counter.computeCount(array)\n\n    return result", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/145": [{"task_id": "HumanEval/145", "solution": "class DigitSumCalculator:\n    \"\"\"Calculates the sum of decimal digits of an integer (absolute value).\"\"\"\n    def compute(self, value: int) -> int:\n        s = 0\n        abs_value = abs(value)\n        if abs_value == 0:\n            return 0\n        while abs_value > 0:\n            s += abs_value % 10\n            abs_value //= 10\n        return s\nclass IntegerItem:\n    \"\"\"Holds integer value, original index, and computed digit sum.\"\"\"\n    def __init__(self, value: int, originalIndex: int) -> None:\n        self.value = value\n        self.originalIndex = originalIndex\n        self.digitSum: int = 0 \n\n    def computeDigitSum(self, calc: 'DigitSumCalculator') -> None:\n        \"\"\"Computes and stores the digit sum using the provided calculator.\"\"\"\n        self.digitSum = calc.compute(self.value)\nclass InputList:\n    \"\"\"Container representing the input sequence and creating IntegerItem objects.\"\"\"\n    def __init__(self, nums: list[int]) -> None:\n        self.items = [IntegerItem(value, i) for i, value in enumerate(nums)]\n\n    def __len__(self) -> int:\n        return len(self.items)\n\n    def get(self, index: int) -> 'IntegerItem':\n        return self.items[index]\nclass OutputList:\n    \"\"\"Container for sorted IntegerItem objects and conversion to plain list of integer values.\"\"\"\n    def __init__(self, items: list['IntegerItem']) -> None:\n        self.items = items\n\n    def asValues(self) -> list[int]:\n        \"\"\"Returns a plain list of integer values from the sorted items.\"\"\"\n        return [item.value for item in self.items]\nclass OrderByPointsSorter:\n    \"\"\"Sorts IntegerItems by digit sum, then original index.\"\"\"\n    def __init__(self, calculator: DigitSumCalculator = None) -> None:\n        self.calculator = calculator if calculator is not None else DigitSumCalculator()\n\n    def sort(self, input_list: InputList) -> OutputList:\n        \"\"\"Computes digit sums, then performs a stable sort.\"\"\"\n        for item in input_list.items:\n            item.computeDigitSum(self.calculator)\n\n        sorted_items = sorted(input_list.items, key=lambda item: (item.digitSum, item.originalIndex))\n\n        return OutputList(sorted_items)\ndef order_by_points(nums):\n    \"\"\"\n    Sorts the given list of integers in ascending order according to the sum of their digits.\n    If there are several items with similar sum of their digits, order them based on their original index.\n    \"\"\"\n    input_list = InputList(nums)\n    calculator = DigitSumCalculator()\n    sorter = OrderByPointsSorter(calculator)\n    output_list = sorter.sort(input_list)\n    return output_list.asValues()", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[[1, 11, -1, -11, -12]]], "plus_fail_tests": [[[-5, -12, 9, 15]]]}], "HumanEval/148": [{"task_id": "HumanEval/148", "solution": "from dataclasses import dataclass\nfrom typing import List, Optional, Dict, Tuple\nclass SolarSystem:\n    def __init__(self) -> None:\n        planet_names = [\"Mercury\", \"Venus\", \"Earth\", \"Mars\", \"Jupiter\", \"Saturn\", \"Uranus\", \"Neptune\"]\n        self._planets: List[Planet] = [Planet(name, i + 1) for i, name in enumerate(planet_names)]\n        self._name_to_index: Dict[str, int] = {planet.name: planet.index for planet in self._planets}\n\n    def get_index(self, name: str) -> Optional[int]:\n        \"\"\"Return 1-based index for a canonical planet name, or None if not found.\"\"\"\n        return self._name_to_index.get(name)\n\n    def get_planets_between(self, idx1: int, idx2: int) -> List[Planet]:\n        \"\"\"Return list of Planet strictly between idx1 and idx2, sorted by increasing index.\"\"\"\n        min_idx = min(idx1, idx2)\n        max_idx = max(idx1, idx2)\n        \n        result = [p for p in self._planets if min_idx < p.index < max_idx]\n        return result\nclass Validator:\n    def __init__(self, solar_system: SolarSystem) -> None:\n        self._solar_system = solar_system\n\n    def is_valid_planet(self, name: str) -> bool:\n        \"\"\"Return True if SolarSystem.get_index(name) is not None; False otherwise.\"\"\"\n        return self._solar_system.get_index(name) is not None\nclass BFService:\n    def __init__(self, solar_system: SolarSystem = None, validator: Validator = None) -> None:\n        self._solar_system = solar_system if solar_system is not None else SolarSystem()\n        self._validator = validator if validator is not None else Validator(self._solar_system)\n\n    def bf(self, planet1: str, planet2: str) -> Tuple[str, ...]:\n        \"\"\"Find planets whose orbits are located between planet1 and planet2.\"\"\"\n        if not self._validator.is_valid_planet(planet1) or not self._validator.is_valid_planet(planet2):\n            return ()\n\n        idx1 = self._solar_system.get_index(planet1)\n        idx2 = self._solar_system.get_index(planet2)\n\n        if abs(idx1 - idx2) <= 1:\n            return ()\n\n        intermediate_planets = self._solar_system.get_planets_between(idx1, idx2)\n        return tuple(planet.name for planet in intermediate_planets)\ndef bf(planet1, planet2):\n    \"\"\"\n    There are eight planets in our solar system: the closerst to the Sun \n    is Mercury, the next one is Venus, then Earth, Mars, Jupiter, Saturn, \n    Uranus, Neptune.\n    Write a function that takes two planet names as strings planet1 and planet2. \n    The function should return 