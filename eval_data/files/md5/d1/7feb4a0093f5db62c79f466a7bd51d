{"date": "2026-05-08 21:24", "hash": "fe585eb4df8c88d844eeb463ea4d0302", "eval": {"HumanEval/7": [{"task_id": "HumanEval/7", "solution": "def filter_by_substring(strings: List[str], substring: str) -> List[str]:\n    \"\"\" Filter an input list of strings only for ones that contain given substring\n    >>> filter_by_substring([], 'a')\n    []\n    >>> filter_by_substring(['abc', 'bacd', 'cde', 'array'], 'a')\n    ['abc', 'bacd', 'array']\n    \"\"\"\n    filtered_strings = []\n    for s in strings:\n        if substring in s:\n            filtered_strings.append(s)\n    return filtered_strings", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/6": [{"task_id": "HumanEval/6", "solution": "from typing import List\nclass Group:\n    \"\"\"Represents one contiguous parenthesis group and provides validation helpers.\"\"\"\n\n    def __init__(self, index: int, text: str) -> None:\n        self.index = index\n        self.text = text\n\n    def contains_only_parens(self) -> bool:\n        \"\"\"Checks if the group text contains only '(' and ')' characters.\"\"\"\n        return set(self.text) <= {'(', ')'}\n\n    def is_balanced(self) -> bool:\n        \"\"\"Checks if the parentheses in the group text are balanced.\"\"\"\n        open_counter = 0\n        for char in self.text:\n            if char == '(':\n                open_counter += 1\n            elif char == ')':\n                open_counter -= 1\n            if open_counter < 0:\n                return False\n        return open_counter == 0\nclass DepthCalculator:\n    \"\"\"Computes maximum nesting depth for a Group using the left-to-right open-counter algorithm.\"\"\"\n\n    def compute_max_depth(self, group: Group) -> int:\n        \"\"\"Calculates the maximum nesting depth for a given parenthesis group.\"\"\"\n        open_counter = 0\n        max_open = 0\n        for char in group.text:\n            if char == '(':\n                open_counter += 1\n                if open_counter > max_open:\n                    max_open = open_counter\n            elif char == ')':\n                open_counter -= 1\n        return max_open\nclass ResultList:\n    \"\"\"Collects computed depths in order and produces the final list.\"\"\"\n\n    def __init__(self) -> None:\n        self.depths: List[int] = []\n\n    def append(self, depth: int) -> None:\n        \"\"\"Appends a calculated depth to the internal list.\"\"\"\n        self.depths.append(depth)\n\n    def to_list(self) -> List[int]:\n        \"\"\"Returns a shallow copy of the collected depths.\"\"\"\n        return list(self.depths)\nclass Parser:\n    \"\"\"Coordinates the processing pipeline: split input, create Groups, validate groups, compute depths, and aggregate results.\"\"\"\n\n    def __init__(self, paren_string: str) -> None:\n        self.paren_string = paren_string\n\n    def parse(self) -> List[int]:\n        \"\"\"Parses the input string, validates groups, calculates depths, and returns a list of results.\"\"\"\n        segments = self.paren_string.split()\n        result_list = ResultList()\n\n        for i, segment_text in enumerate(segments):\n            group = Group(i, segment_text)\n\n            if not group.contains_only_parens():\n                raise ValueError(f\"Invalid characters in group {group.index}: '{group.text}'\")\n\n            if not group.is_balanced():\n                raise ValueError(f\"Unbalanced parentheses in group {group.index}: '{group.text}'\")\n\n            depth = DepthCalculator().compute_max_depth(group)\n            result_list.append(depth)\n\n        return result_list.to_list()\ndef parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\" Input to this function is a string represented multiple groups for nested parentheses separated by spaces.\n    For each of the group, output the deepest level of nesting of parentheses.\n    E.g. (()()) has maximum two levels of nesting while ((())) has three.\n\n    >>> parse_nested_parens('(()()) ((())) () ((())()())')\n    [2, 3, 1, 3]\n    \"\"\"\n    parser = Parser(paren_string)\n    return parser.parse()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/1": [{"task_id": "HumanEval/1", "solution": "from typing import List\nclass ParenString:\n    \"\"\"Represents the input string and its normalized form.\"\"\"\n    def __init__(self, raw: str) -> None:\n        self.raw: str = raw\n        self.normalized: str = \"\" # To be set by ParenParser.normalize\nclass ParenthesisGroup:\n    \"\"\"Represents a contiguous top-level balanced parenthesis group.\"\"\"\n    def __init__(self, id: int, start_index: int, end_index: int, content: str, max_depth: int) -> None:\n        self.id: int = id\n        self.start_index: int = start_index\n        self.end_index: int = end_index\n        self.content: str = content\n        self.max_depth: int = max_depth\nclass ParenParser:\n    \"\"\"Provides normalization, parsing, validation, and formatting of ParenString.\"\"\"\n\n    def normalize(self, ps: ParenString) -> ParenString:\n        \"\"\"Removes all space characters from ps.raw and sets ps.normalized.\"\"\"\n        ps.normalized = ps.raw.replace(\" \", \"\")\n        return ps\n\n    def parse(self, ps: ParenString) -> List[ParenthesisGroup]:\n        \"\"\"Scans ps.normalized to detect top-level balanced parenthesis groups and their nesting depth.\"\"\"\n        result_groups: List[ParenthesisGroup] = []\n        current_depth: int = 0\n        group_id_counter: int = 0\n        group_start_index: int = -1\n        local_max_depth_for_current_group: int = 0\n\n        for i, char in enumerate(ps.normalized):\n            if char == '(':\n                current_depth += 1\n                if current_depth == 1:  # A new top-level group starts\n                    group_start_index = i\n                    local_max_depth_for_current_group = 0 # Reset max depth for this new group\n                \n                # Update max depth for the current active group\n                if group_start_index != -1: \n                    local_max_depth_for_current_group = max(local_max_depth_for_current_group, current_depth)\n\n            elif char == ')':\n                current_depth -= 1\n                \n                # Update max depth for the current active group before potentially ending it\n                if group_start_index != -1:\n                    local_max_depth_for_current_group = max(local_max_depth_for_current_group, current_depth)\n\n                if current_depth == 0 and group_start_index != -1:  # A top-level group ends\n                    group_id_counter += 1\n                    group_content = ps.normalized[group_start_index : i + 1]\n                    result_groups.append(\n                        ParenthesisGroup(\n                            id=group_id_counter,\n                            start_index=group_start_index,\n                            end_index=i + 1,\n                            content=group_content,\n                            max_depth=local_max_depth_for_current_group\n                        )\n                    )\n                    group_start_index = -1  # Reset for discovery of the next group\n                    local_max_depth_for_current_group = 0 # Reset max depth tracking\n\n        return result_groups\n\n    def is_balanced(self, ps: ParenString) -> bool:\n        \"\"\"Determines if the entire normalized string has properly balanced parentheses.\"\"\"\n        balance = 0\n        for char in ps.normalized:\n            if char == '(':\n                balance += 1\n            elif char == ')':\n                balance -= 1\n            if balance < 0:\n                return False\n        return balance == 0\n\n    def format_output(self, groups: List[ParenthesisGroup]) -> List[str]:\n        \"\"\"Converts ParenthesisGroup objects into an ordered List[str] of their content.\"\"\"\n        return [group.content for group in groups]\ndef separate_paren_groups(paren_string: str) -> List[str]:\n    \"\"\" Input to this function is a string containing multiple groups of nested parentheses. Your goal is to\n    separate those group into separate strings and return the list of those.\n    Separate groups are balanced (each open brace is properly closed) and not nested within each other\n    Ignore any spaces in the input string.\n    >>> separate_paren_groups('( ) (( )) (( )( ))')\n    ['()', '(())', '(()())']\n    \"\"\"\n    paren_str_obj = ParenString(raw=paren_string)\n    parser = ParenParser()\n\n    parser.normalize(paren_str_obj)\n    \n    # The parsing logic intrinsically extracts balanced top-level groups.\n    # The `is_balanced` method, though part of the parser API, is not required for this specific orchestration\n    # as per the provided sequence diagrams and problem context focusing on extraction.\n    groups = parser.parse(paren_str_obj)\n    \n    return parser.format_output(groups)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/5": [{"task_id": "HumanEval/5", "solution": "from typing import List\ndef intersperse(numbers: List[int], delimeter: int) -> List[int]:\n    \"\"\" Insert a number 'delimeter' between every two consecutive elements of input list `numbers'\n    >>> intersperse([], 4)\n    []\n    >>> intersperse([1, 2, 3], 4)\n    [1, 4, 2, 4, 3]\n    \"\"\"\n    if not numbers:\n        return []\n\n    result = []\n    for i, num in enumerate(numbers):\n        result.append(num)\n        if i < len(numbers) - 1:\n            result.append(delimeter)\n    return result", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/3": [{"task_id": "HumanEval/3", "solution": "from typing import List\nclass Account:\n    \"\"\"A simple domain entity representing a bank account balance.\"\"\"\n    def __init__(self) -> None:\n        self.balance: int = 0\nclass Result:\n    \"\"\"A carrier for boolean outcome.\"\"\"\n    def __init__(self, value: bool) -> None:\n        self.value = value\nclass TransactionProcessor:\n    \"\"\"Processes bank account operations and detects if balance falls below zero.\"\"\"\n    def __init__(self) -> None:\n        self.account = Account()\n        self.last_result = Result(False) # Adhering to design for internal state tracking.\n\n    def process(self, operations: List[int]) -> bool:\n        \"\"\"Applies operations and returns True if balance drops below zero, False otherwise.\"\"\"\n        for amount in operations:\n            self.updateBalance(amount)\n            if self.account.balance < 0:\n                self.last_result.value = True # Update the internal result object.\n                return True # Return immediately upon detection as per requirement.\n        return False # All operations processed, balance never fell below zero.\n\n    def updateBalance(self, amount: int) -> None:\n        \"\"\"Updates the account balance with the given amount.\"\"\"\n        self.account.balance += amount\ndef below_zero(operations: List[int]) -> bool:\n    \"\"\" You're given a list of deposit and withdrawal operations on a bank account that starts with\n    zero balance. Your task is to detect if at any point the balance of account fallls below zero, and\n    at that point function should return True. Otherwise it should be False.\n    >>> below_zero([1, 2, 3])\n    False\n    >>> below_zero([1, 2, -4, 5])\n    True\n    \"\"\"\n    processor = TransactionProcessor()\n    return processor.process(operations)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/4": [{"task_id": "HumanEval/4", "solution": "from typing import List\nclass MeanCalculator:\n    \"\"\"Calculates the arithmetic mean of a list of numbers.\"\"\"\n    def compute_mean(self, numbers: List[float]) -> float:\n        return sum(numbers) / len(numbers)\nclass DeviationCalculator:\n    \"\"\"Computes absolute differences and the Mean Absolute Deviation.\"\"\"\n    def compute_abs_differences(self, numbers: List[float], mean: float) -> List[float]:\n        return [abs(x - mean) for x in numbers]\n\n    def compute_mad(self, diffs: List[float]) -> float:\n        return sum(diffs) / len(diffs)\nclass MADFunction:\n    \"\"\"Orchestrates the Mean Absolute Deviation calculation process.\"\"\"\n    def mean_absolute_deviation(self, numbers: List[float]) -> float:\n        # Compute the mean of the dataset.\n        x_mean = MeanCalculator().compute_mean(numbers)\n        \n        # Calculate the absolute differences from the mean for each number.\n        diffs = DeviationCalculator().compute_abs_differences(numbers, x_mean)\n        \n        # Compute the Mean Absolute Deviation from these differences.\n        mad = DeviationCalculator().compute_mad(diffs)\n        \n        return mad\ndef mean_absolute_deviation(numbers: List[float]) -> float:\n    \"\"\" For a given list of input numbers, calculate Mean Absolute Deviation\n    around the mean of this dataset.\n    Mean Absolute Deviation is the average absolute difference between each\n    element and a centerpoint (mean in this case):\n    MAD = average | x - x_mean |\n    >>> mean_absolute_deviation([1.0, 2.0, 3.0, 4.0])\n    1.0\n    \"\"\"\n    # Delegate the actual computation to the orchestrator class.\n    return MADFunction().mean_absolute_deviation(numbers)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/2": [{"task_id": "HumanEval/2", "solution": "from math import floor\nclass TruncateService:\n    \"\"\"Service to compute the floor and fractional part of a number.\"\"\"\n    def compute_floor(self, number: float) -> int:\n        \"\"\"Returns the floor of the given number using math.floor.\"\"\"\n        return floor(number)\n\n    def truncate_number(self, number: float) -> float:\n        \"\"\"Computes and returns the fractional part of the number.\"\"\"\n        floor_value = self.compute_floor(number)\n        fractional = number - floor_value\n        return float(fractional)\ndef truncate_number(number: float) -> float:\n    \"\"\" Given a positive floating point number, it can be decomposed into\n    and integer part (largest integer smaller than given number) and decimals\n    (leftover part always smaller than 1).\n\n    Return the decimal part of the number.\n    >>> truncate_number(3.5)\n    0.5\n    \"\"\"\n    return TruncateService().truncate_number(number)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/0": [{"task_id": "HumanEval/0", "solution": "from typing import List\ndef has_close_elements(numbers: List[float], threshold: float) -> bool:\n    \"\"\" Check if in given list of numbers, are any two numbers closer to each other than\n    given threshold.\n    >>> has_close_elements([1.0, 2.0, 3.0], 0.5)\n    False\n    >>> has_close_elements([1.0, 2.8, 3.0, 4.0, 5.0, 2.0], 0.3)\n    True\n    \"\"\"\n    if len(numbers) < 2:\n        return False\n\n    sorted_numbers = sorted(numbers)\n\n    for i in range(1, len(sorted_numbers)):\n        # Since the list is sorted, diff is always non-negative,\n        # so abs() is not needed here.\n        if sorted_numbers[i] - sorted_numbers[i-1] < threshold:\n            return True\n\n    return False", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/8": [{"task_id": "HumanEval/8", "solution": "from typing import List, Tuple\ndef sum_product(numbers: List[int]) -> Tuple[int, int]:\n    \"\"\" For a given list of integers, return a tuple consisting of a sum and a product of all the integers in a list.\n    Empty sum should be equal to 0 and empty product should be equal to 1.\n    >>> sum_product([])\n    (0, 1)\n    >>> sum_product([1, 2, 3, 4])\n    (10, 24)\n    \"\"\"\n    if not numbers:\n        return (0, 1)\n\n    sum_value = sum(numbers)\n    product_value = 1\n    for num in numbers:\n        product_value *= num\n\n    return (sum_value, product_value)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/11": [{"task_id": "HumanEval/11", "solution": "def string_xor(a: str, b: str) -> str:\n    \"\"\" Input are two strings a and b consisting only of 1s and 0s.\n    Perform binary XOR on these inputs and return result also as a string.\n    >>> string_xor('010', '110')\n    '100'\n    \"\"\"\n\n    def _validate_binary_string(s: str) -> bool:\n        \"\"\"Returns True if s contains only '0' or '1' characters.\"\"\"\n        return all(char in ('0', '1') for char in s)\n\n    def _xor_bits(s1: str, s2: str) -> str:\n        \"\"\"Performs character-wise XOR on two equal-length binary strings.\"\"\"\n        result_chars = []\n        for i in range(len(s1)):\n            if s1[i] == s2[i]:\n                result_chars.append('0')\n            else:\n                result_chars.append('1')\n        return \"\".join(result_chars)\n\n    if not _validate_binary_string(a):\n        raise ValueError(\"Input 'a' must contain only '0's and '1's.\")\n    if not _validate_binary_string(b):\n        raise ValueError(\"Input 'b' must contain only '0's and '1's.\")\n    if len(a) != len(b):\n        raise ValueError(\"Inputs 'a' and 'b' must be of equal length.\")\n\n    return _xor_bits(a, b)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/13": [{"task_id": "HumanEval/13", "solution": "def greatest_common_divisor(a: int, b: int) -> int:\n    \"\"\" Return a greatest common divisor of two integers a and b\n    >>> greatest_common_divisor(3, 5)\n    1\n    >>> greatest_common_divisor(25, 15)\n    5\n    \"\"\"\n    # Use absolute values to ensure the GCD result is non-negative.\n    a = abs(a)\n    b = abs(b)\n\n    while b:\n        a, b = b, a % b\n    return a", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/12": [{"task_id": "HumanEval/12", "solution": "from typing import List, Optional\ndef longest(strings: List[str]) -> Optional[str]:\n    \"\"\" Out of list of strings, return the longest one. Return the first one in case of multiple\n    strings of the same length. Return None in case the input list is empty.\n    >>> longest([])\n\n    >>> longest(['a', 'b', 'c'])\n    'a'\n    >>> longest(['a', 'bb', 'ccc'])\n    'ccc'\n    \"\"\"\n    if not strings:\n        return None\n\n    max_len = -1\n    max_value = None\n\n    for s in strings:\n        current_len = len(s)\n        if current_len > max_len:\n            max_len = current_len\n            max_value = s\n            \n    return max_value", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/10": [{"task_id": "HumanEval/10", "solution": "def make_palindrome(string: str) -> str:\n    \"\"\" Find the shortest palindrome that begins with a supplied string.\n    Algorithm idea is simple:\n    - Find the longest postfix of supplied string that is a palindrome.\n    - Append to the end of the string reverse of a string prefix that comes before the palindromic suffix.\n    >>> make_palindrome('')\n    ''\n    >>> make_palindrome('cat')\n    'catac'\n    >>> make_palindrome('cata')\n    'catac'\n    \"\"\"\n    def _longest_palindromic_suffix(s: str) -> tuple[int, str]:\n        \"\"\" Identifies the longest suffix of 's' that is a palindrome, returning its start index and value. \"\"\"\n        if not s:\n            return 0, \"\"\n\n        # Iterate from the start to find the longest suffix that is a palindrome.\n        # The first suffix (smallest 'i') that is a palindrome will be the longest.\n        for i in range(len(s)):\n            suffix = s[i:]\n            if is_palindrome(suffix):\n                return i, suffix\n        # This point is unreachable for non-empty strings because a single character is a palindrome.\n\n    # Get the starting index of the longest palindromic suffix.\n    # We only need the start_index for calculating the prefix.\n    start_index, _ = _longest_palindromic_suffix(string)\n\n    # The prefix that comes before the palindromic suffix needs to be reversed.\n    prefix_to_reverse = string[:start_index]\n\n    # Construct the shortest palindrome by appending the reversed prefix to the original string.\n    return string + prefix_to_reverse[::-1]", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [["x"]], "plus_fail_tests": [["race"]]}], "HumanEval/9": [{"task_id": "HumanEval/9", "solution": "from typing import List, Tuple\ndef rolling_max(numbers: List[int]) -> List[int]:\n    \"\"\" From a given list of integers, generate a list of rolling maximum element found until given moment\n    in the sequence.\n    >>> rolling_max([1, 2, 3, 2, 3, 4, 2])\n    [1, 2, 3, 3, 3, 4, 4]\n    \"\"\"\n    if not numbers:\n        return []\n\n    results = []\n    current_max = numbers[0]\n\n    for number in numbers:\n        if number > current_max:\n            current_max = number\n        results.append(current_max)\n\n    return results", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/19": [{"task_id": "HumanEval/19", "solution": "import collections\nfrom typing import List, Dict, Set, Optional\nclass InputString:\n    \"\"\"Hold raw input string and provide minimal normalization utilities.\"\"\"\n    def __init__(self, raw: str):\n        self.raw = raw\n\n    def trimmed(self) -> str:\n        return self.raw.strip()\nclass Token:\n    \"\"\"Represent single token word and its mapped numeric value (value None until mapped).\"\"\"\n    def __init__(self, word: str, value: Optional[int] = None):\n        self.word = word\n        self.value = value\nclass TokenList:\n    \"\"\"Hold ordered list of Token objects and provide creation from word strings.\"\"\"\n    def __init__(self, tokens: List[Token]):\n        self.tokens = tokens\n\n    @classmethod\n    def from_words(cls, words: List[str]) -> 'TokenList':\n        return cls([Token(word) for word in words])\n\n    def words(self) -> List[str]:\n        return [token.word for token in self.tokens]\nclass Parser:\n    \"\"\"Parses InputString into TokenList by splitting on whitespace.\"\"\"\n    def parse(self, input_obj: InputString) -> TokenList:\n        words = input_obj.trimmed().split()\n        return TokenList.from_words(words)\nclass Validator:\n    \"\"\"Validates that each token word is in the allowed set; raises ValueError on invalid tokens.\"\"\"\n    def __init__(self):\n        self.valid_words: Set[str] = {\n            'zero', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight', 'nine'\n        }\n\n    def validate_words(self, words: List[str]) -> None:\n        for word in words:\n            if word not in self.valid_words:\n                raise ValueError(f\"invalid token: {word}\")\nclass Mapper:\n    \"\"\"Maps word tokens to deterministic integer values 0..9.\"\"\"\n    def __init__(self):\n        self.word_to_value: Dict[str, int] = {\n            'zero': 0, 'one': 1, 'two': 2, 'three': 3, 'four': 4,\n            'five': 5, 'six': 6, 'seven': 7, 'eight': 8, 'nine': 9\n        }\n\n    def map_word(self, word: str) -> int:\n        return self.word_to_value[word]\n\n    def map_words(self, words: List[str]) -> List[int]:\n        return [self.map_word(word) for word in words]\nclass Sorter:\n    \"\"\"Sorts TokenList by Token.value ascending; preserves duplicates.\"\"\"\n    def sort_tokens(self, tokens: List[Token]) -> List[Token]:\n        return sorted(tokens, key=lambda token: token.value)\nclass Formatter:\n    \"\"\"Formats sorted Token list into single-space-joined string.\"\"\"\n    def format_tokens(self, tokens: List[Token]) -> str:\n        return ' '.join([token.word for token in tokens])\nclass SortService:\n    \"\"\"Orchestrates parsing, validation, mapping, sorting, formatting.\"\"\"\n    def __init__(\n        self,\n        parser: Optional[Parser] = None,\n        validator: Optional[Validator] = None,\n        mapper: Optional[Mapper] = None,\n        sorter: Optional[Sorter] = None,\n        formatter: Optional[Formatter] = None\n    ):\n        self.parser = parser if parser is not None else Parser()\n        self.validator = validator if validator is not None else Validator()\n        self.mapper = mapper if mapper is not None else Mapper()\n        self.sorter = sorter if sorter is not None else Sorter()\n        self.formatter = formatter if formatter is not None else Formatter()\n\n    def sort_numbers(self, input_obj: InputString) -> str:\n        token_list = self.parser.parse(input_obj)\n        self.validator.validate_words(token_list.words())\n        \n        # Map values to tokens\n        for token in token_list.tokens:\n            token.value = self.mapper.map_word(token.word)\n        \n        sorted_tokens = self.sorter.sort_tokens(token_list.tokens)\n        return self.formatter.format_tokens(sorted_tokens)\ndef sort_numbers(numbers: str) -> str:\n    \"\"\" Input is a space-delimited string of numberals from 'zero' to 'nine'.\n    Valid choices are 'zero', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight' and 'nine'.\n    Return the string with numbers sorted from smallest to largest\n    Raises ValueError on invalid tokens.\n    >>> sort_numbers('three one five')\n    'one three five'\n    \"\"\"\n    input_obj = InputString(numbers)\n    service = SortService()\n    return service.sort_numbers(input_obj)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/17": [{"task_id": "HumanEval/17", "solution": "from typing import List\nclass NoteToken:\n    \"\"\"Va