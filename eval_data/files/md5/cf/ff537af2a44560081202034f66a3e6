{"task_id": "HumanEval/68", "solution": "def pluck(arr):\n    \"\"\"\n    Finds the smallest even value and its index in an array.\n    Returns [value, index] or [] if no even values or the array is empty.\n    \"\"\"\n    smallest_even_value = float('inf')\n    smallest_even_index = -1\n\n    for i, value in enumerate(arr):\n        if value % 2 == 0:  # Check if the value is even\n            if value < smallest_even_value:\n                smallest_even_value = value\n                smallest_even_index = i\n            # If value == smallest_even_value, the current smallest_even_index (which came first) is retained.\n\n    if smallest_even_index == -1:\n        return []\n    else:\n        return [smallest_even_value, smallest_even_index]"}
{"task_id": "HumanEval/67", "solution": "```python\nimport re\n\ndef fruit_distribution(s,n):\n    \"\"\"\n    In this task, you will be given a string that represents a number of apples and oranges\n    that are distributed in a basket of fruit this basket contains\n    apples, oranges, and mango fruits. Given the string that represents the total number of\n    the oranges and apples and an integer that represent the total number of the fruits\n    in the basket return the number of the mango fruits in the basket.\n    for examble:\n    fruit_distribution(\"5 apples and 6 oranges\", 19) ->19 - 5 - 6 = 8\n    fruit_distribution(\"0 apples and 1 oranges\",3) -> 3 - 0 - 1 = 2\n    fruit_distribution(\"2 apples and 3 oranges\", 100) -> 100 - 2 - 3 = 95\n    fruit_distribution(\"100 apples and 1 oranges\",120) -> 120 - 100 - 1 = 19\n    \"\"\"\n    match = re.match(r\"(\\d+) apples and (\\d+) oranges\", s)\n    apple_count = int(match.group(1))\n    orange_count = int(match.group(2))\n\n    return n - apple_count - orange_count\n```"}
{"task_id": "HumanEval/69", "solution": "```python\ndef search(lst):\n    \"\"\"\n    Given a non-empty list of positive integers, returns the greatest integer\n    that is greater than zero and has a frequency greater than or equal to\n    the value of the integer itself. If no such value exists, returns -1.\n    \"\"\"\n    frequency_map = {}\n    for x in lst:\n        frequency_map[x] = frequency_map.get(x, 0) + 1\n\n    candidate_integers = []\n    for integer_value, frequency in frequency_map.items():\n        if frequency >= integer_value:\n            candidate_integers.append(integer_value)\n\n    if candidate_integers:\n        return max(candidate_integers)\n    else:\n        return -1\n```"}
{"task_id": "HumanEval/70", "solution": "```python\ndef strange_sort_list(lst):\n    '''\n    Given list of integers, return list in strange order.\n    Strange sorting, is when you start with the minimum value,\n    then maximum of the remaining integers, then minimum and so on.\n    '''\n    if not lst:\n        return []\n\n    sorted_copy = sorted(lst)\n    result = []\n    is_min_turn = True\n\n    while sorted_copy:\n        if is_min_turn:\n            result.append(sorted_copy.pop(0))\n        else:\n            result.append(sorted_copy.pop(-1))\n        is_min_turn = not is_min_turn\n\n    return result\n```"}
{"task_id": "HumanEval/72", "solution": "def will_it_fly(q,w):\n    def _is_palindrome(lst):\n        \"\"\"\n        Determines if a list is a palindrome.\n        \"\"\"\n        return lst == lst[::-1]\n\n    def _calculate_sum(lst):\n        \"\"\"\n        Calculates the sum of all elements in a list.\n        \"\"\"\n        return sum(lst)\n\n    is_balanced = _is_palindrome(q)\n    total_sum = _calculate_sum(q)\n\n    if is_balanced and total_sum <= w:\n        return True\n    else:\n        return False"}
{"task_id": "HumanEval/71", "solution": "import math\n\nclass Triangle:\n    \"\"\"\n    Represents a triangle with three side lengths and provides methods\n    for validation and area calculation.\n    \"\"\"\n    def __init__(self, a: float, b: float, c: float):\n        self._side_a = a\n        self._side_b = b\n        self._side_c = c\n        self._area = -1.0 # Default invalid area\n\n    def is_valid(self) -> bool:\n        \"\"\"\n        Determines if the three sides form a valid triangle.\n        A triangle is valid if the sum of any two sides is strictly greater\n        than the third side.\n        \"\"\"\n        if not (self._side_a > 0 and self._side_b > 0 and self._side_c > 0):\n            return False\n        if (self._side_a + self._side_b > self._side_c) and \\\n           (self._side_a + self._side_c > self._side_b) and \\\n           (self._side_b + self._side_c > self._side_a):\n            return True\n        return False\n\n    def calculate_area(self) -> None:\n        \"\"\"\n        Calculates the area of the triangle using Heron's formula.\n        The calculated area is stored internally.\n        \"\"\"\n        if not self.is_valid():\n            self._area = -1.0\n            return\n\n        s = (self._side_a + self._side_b + self._side_c) / 2\n        area_squared = s * (s - self._side_a) * (s - self._side_b) * (s - self._side_c)\n        self._area = math.sqrt(max(0, area_squared))\n\n    def get_rounded_area(self) -> float:\n        \"\"\"\n        Returns the calculated area rounded to two decimal points.\n        \"\"\"\n        if self._area == -1.0:\n            return -1.0\n        return round(self._area, 2)\n\ndef triangle_area(a: float, b: float, c: float) -> float:\n    \"\"\"\n    Given the lengths of the three sides of a triangle. Return the area of\n    the triangle rounded to 2 decimal points if the three sides form a valid triangle.\n    Otherwise return -1\n    Three sides make a valid triangle when the sum of any two sides is greater\n    than the third side.\n    Example:\n    triangle_area(3, 4, 5) == 6.00\n    triangle_area(1, 2, 10) == -1\n    \"\"\"\n    triangle = Triangle(a, b, c)\n\n    if not triangle.is_valid():\n        return -1.0\n\n    triangle.calculate_area()\n    return triangle.get_rounded_area()"}
{"task_id": "HumanEval/73", "solution": "def smallest_change(arr):\n    \"\"\"\n    Given an array arr of integers, find the minimum number of elements that\n    need to be changed to make the array palindromic. A palindromic array is an array that\n    is read the same backwards and forwards. In one change, you can change one element to any other element.\n\n    For example:\n    smallest_change([1,2,3,5,4,7,9,6]) == 4\n    smallest_change([1, 2, 3, 4, 3, 2, 2]) == 1\n    smallest_change([1, 2, 3, 2, 1]) == 0\n    \"\"\"\n    n = len(arr)\n    if n <= 1:\n        return 0\n\n    changes_count = 0\n    for i in range(n // 2):\n        if arr[i] != arr[n - 1 - i]:\n            changes_count += 1\n\n    return changes_count"}
{"task_id": "HumanEval/74", "solution": "```python\ndef total_match(lst1, lst2):\n    \"\"\"\n    Compares two lists of strings by total character count and returns the appropriate list.\n    Returns the list with fewer total characters, or the first list if counts are equal.\n    \"\"\"\n\n    total_chars_lst1 = sum(len(s) for s in lst1)\n    total_chars_lst2 = sum(len(s) for s in lst2)\n\n    if total_chars_lst1 < total_chars_lst2:\n        return lst1\n    elif total_chars_lst2 < total_chars_lst1:\n        return lst2\n    else: # total_chars_lst1 == total_chars_lst2\n        return lst1\n```"}
{"task_id": "HumanEval/75", "solution": "```python\nimport math\n\ndef is_prime(n):\n    \"\"\"Checks if a number is prime. Helper function for is_multiply_prime.\"\"\"\n    if n <= 1:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n    i = 3\n    while i * i <= n:\n        if n % i == 0:\n            return False\n        i += 2\n    return True\n\ndef is_multiply_prime(a):\n    \"\"\"Write a function that returns true if the given number is the multiplication of 3 prime numbers\n    and false otherwise.\n    Knowing that (a) is less then 100.\n    Example:\n    is_multiply_prime(30) == True\n    30 = 2 * 3 * 5\n    \"\"\"\n    if a <= 1:\n        return False\n\n    prime_factors_count = 0\n    current_a = a\n    d = 2\n\n    # Factorize current_a by trial division.\n    # The loop runs until d*d exceeds current_a or current_a becomes 1.\n    while d * d <= current_a:\n        # According to design, explicitly check if d is prime.\n        # For a correctly implemented trial division, 'd' will always be prime if it divides 'current_a'.\n        if is_prime(d):\n            while current_a % d == 0:\n                prime_factors_count += 1\n                current_a //= d\n        d += 1\n\n    # If current_a is greater than 1 after the loop, it means the remaining current_a is a prime factor itself.\n    if current_a > 1:\n        # According to design, explicitly check if this remaining factor is prime.\n        if is_prime(current_a):\n            prime_factors_count += 1\n\n    return prime_factors_count == 3\n```"}
{"task_id": "HumanEval/76", "solution": "```python\ndef is_simple_power(x, n):\n    \"\"\"Checks if x is a simple power of n, meaning x = n**k for some integer k.\"\"\"\n    # If x is 1, it's n**0 for any n (even 0 in Python).\n    if x == 1:\n        return True\n\n    # If x is 0: it must be 0**k for k >= 1.\n    if x == 0:\n        return n == 0\n\n    # If x is negative and n is positive, n**k (for non-negative integer k) is always positive.\n    if x < 0 and n > 0:\n        return False\n\n    # Handle specific values of n:\n    # If n is 1, 1**k is always 1. Since x != 1 (handled), it's false.\n    if n == 1:\n        return False\n    # If n is 0, 0**k (k>=1) is 0. Since x != 0 and x != 1, it's false.\n    if n == 0:\n        return False\n    # If n is -1, (-1)**k is either 1 or -1. Since x != 1, it must be -1.\n    if n == -1:\n        return x == -1\n\n    # For all other cases, repeatedly divide x by n.\n    # If x is a power of n, it must eventually reduce to 1 by exact division.\n    current_x = x\n    while current_x != 1:\n        # If current_x is not exactly divisible by n, it's not a power.\n        if current_x % n != 0:\n            return False\n\n        current_x //= n # Use integer division\n\n    # If the loop finishes, current_x must have become 1.\n    return True\n```"}
{"task_id": "HumanEval/78", "solution": "```python\ndef hex_key(num):\n    \"\"\"Counts the number of prime hexadecimal digits in the input string.\n    Prime hexadecimal digits are 2, 3, 5, 7, B (11), D (13).\n    \"\"\"\n    prime_hex_digits = {'2', '3', '5', '7', 'B', 'D'}\n    count = 0\n    for digit in num:\n        if digit in prime_hex_digits:\n            count += 1\n    return count\n```"}
{"task_id": "HumanEval/77", "solution": "```python\ndef iscube(a):\n    '''\n    Checks if the given integer 'a' is a perfect cube.\n    This is achieved by computing the cube root and checking if it's an integer.\n    '''\n    if a == 0:\n        return True\n\n    # Handle negative numbers by taking the absolute value, then reapply sign later\n    # This prevents issues with cube root of negative numbers using math.pow or ** operator\n    sign = 1 if a >= 0 else -1\n    abs_a = abs(a)\n\n    # Calculate the cube root. Using ** (1/3) can sometimes lead to floating point inaccuracies.\n    # A more robust way is to use round(abs_a**(1/3.0)) and then check its cube.\n    # Alternatively, for integers, we can use integer cube root approximation.\n\n    # Calculate an approximate integer cube root\n    # Using `round` to handle potential floating point inaccuracies near integer cube roots.\n    cuberoot = round(abs_a**(1/3.0))\n\n    # Check if the cube of the (signed) integer root equals the original number\n    return (sign * cuberoot)**3 == a\n```"}
{"task_id": "HumanEval/80", "solution": "```python\ndef is_happy(s):\n    \"\"\"Checks if the given string s is happy. A string is happy if its length is at least 3 and every 3 consecutive letters are distinct.\"\"\"\n    if len(s) < 3:\n        return False\n\n    for i in range(len(s) - 2):\n        char1 = s[i]\n        char2 = s[i+1]\n        char3 = s[i+2]\n\n        if char1 == char2 or char1 == char3 or char2 == char3:\n            return False\n\n    return True\n```"}
{"task_id": "HumanEval/82", "solution": "```python\ndef prime_length(string):\n    \"\"\"Returns True if the string length is a prime number, False otherwise.\"\"\"\n    length = len(string)\n\n    if length <= 1:\n        return False\n    if length == 2:\n        return True\n    if length % 2 == 0:\n        return False\n\n    i = 3\n    while i * i <= length:\n        if length % i == 0:\n            return False\n        i += 2\n    return True\n```"}
{"task_id": "HumanEval/79", "solution": "```python\ndef decimal_to_binary(decimal):\n    \"\"\"Converts a decimal number to its binary string representation, formatted with 'db' prefix and suffix.\"\"\"\n\n    PREFIX = \"db\"\n    SUFFIX = \"db\"\n\n    def _convert_to_raw_binary_string(number):\n        \"\"\"Converts an integer to its raw binary string representation.\"\"\"\n        return bin(number)[2:]\n\n    def _format_binary_string(raw_binary_str):\n        \"\"\"Adds the 'db' prefix and suffix to a raw binary string.\"\"\"\n        return PREFIX + raw_binary_str + SUFFIX\n\n    raw_binary_representation = _convert_to_raw_binary_string(decimal)\n    formatted_binary_string = _format_binary_string(raw_binary_representation)\n    return formatted_binary_string\n```"}
{"task_id": "HumanEval/81", "solution": "def numerical_letter_grade(grades):\n    \"\"\"Converts a list of numerical GPA values to a list of letter grades based on a predefined grading scale.\"\"\"\n    letter_grades = []\n    for gpa in grades:\n        if gpa == 4.0:\n            letter_grades.append('A+')\n        elif gpa > 3.7:\n            letter_grades.append('A')\n        elif gpa > 3.3:\n            letter_grades.append('A-')\n        elif gpa > 3.0:\n            letter_grades.append('B+')\n        elif gpa > 2.7:\n            letter_grades.append('B')\n        elif gpa > 2.3:\n            letter_grades.append('B-')\n        elif gpa > 2.0:\n            letter_grades.append('C+')\n        elif gpa > 1.7:\n            letter_grades.append('C')\n        elif gpa > 1.3:\n            letter_grades.append('C-')\n        elif gpa > 1.0:\n            letter_grades.append('D+')\n        elif gpa > 0.7:\n            letter_grades.append('D')\n        elif gpa > 0.0:\n            letter_grades.append('D-')\n        else: # gpa == 0.0\n            letter_grades.append('E')\n    return letter_grades"}
{"task_id": "HumanEval/84", "solution": "```python\ndef solve(N):\n    \"\"\"Given a positive integer N, return the total sum of its digits in binary.\n\n    Example\n        For N = 1000, the sum of digits will be 1 the output should be \"1\".\n        For N = 150, the sum of digits will be 6 the output should be \"110\".\n        For N = 147, the sum of digits will be 12 the output should be \"1100\".\n\n    Variables:\n        @N integer\n             Constraints: 0 \u2264 N \u2264 10000.\n    Output:\n         a string of binary number\n    \"\"\"\n    def _calculate_digit_sum(number: int) -> int:\n        \"\"\"Calculates the sum of the decimal digits of a given integer.\"\"\"\n        total_sum = 0\n        for digit_char in str(number):\n            total_sum += int(digit_char)\n        return total_sum\n\n    def _convert_to_binary(decimal_sum: int) -> str:\n        \"\"\"Converts a non-negative integer into its binary string representation.\"\"\"\n        if decimal_sum == 0:\n            return \"0\"\n        return bin(decimal_sum)[2:]\n\n    sum_of_digits = _calculate_digit_sum(N)\n    binary_string = _convert_to_binary(sum_of_digits)\n    return binary_string\n```"}
{"task_id": "HumanEval/83", "solution": "```python\ndef starts_one_ends(n):\n    \"\"\"\n    Given a positive integer n, return the count of the numbers of n-digit\n    positive integers that start or end with 1.\n    \"\"\"\n    # Calculate the count of n-digit numbers that start with 1.\n    # The first digit is fixed as 1. The remaining (n-1) digits can be any of 0-9.\n    count_starts_with_1 = 10**(n - 1)\n\n    # Calculate the count of n-digit numbers that end with 1.\n    if n == 1:\n        # For n=1, the only number is '1', which ends with 1.\n        count_ends_with_1 = 1\n    else:\n        # For n > 1, the last digit is fixed as 1. The first digit can be 1-9 (9 choices).\n        # The (n-2) middle digits can be any of 0-9 (10 choices each).\n        count_ends_with_1 = 9 * (10**(n - 2))\n\n    # Calculate the count of n-digit numbers that start AND end with 1.\n    if n == 1:\n        # For n=1, the only number is '1', which starts and ends with 1.\n        count_starts_and_ends_with_1 = 1\n    else:\n        # For n > 1, the first digit is 1 and the last digit is 1.\n        # The (n-2) middle digits can be any of 0-9 (10 choices each).\n        count_starts_and_ends_with_1 = 10**(n - 2)\n\n    # Apply the inclusion-exclusion principle: P(A or B) = P(A) + P(B) - P(A and B).\n    return count_starts_with_1 + count_ends_with_1 - count_starts_and_ends_with_1\n```"}
{"task_id": "HumanEval/85", "solution": "```python\ndef add(lst):\n    \"\"\"Given a non-empty list of integers lst. add the even elements that are at odd indices..\n\n\n    Examples:\n        add([4, 2, 6, 7]) ==> 2\n    \"\"\"\n    total = 0\n    for i in range(len(lst)):\n        if i % 2 != 0:\n            if lst[i] % 2 == 0:\n                total += lst[i]\n    return total\n```"}
{"task_id": "HumanEval/86", "solution": "def anti_shuffle(s):\n    \"\"\"\n    Write a function that takes a string and returns an ordered version of it.\n    Ordered version of string, is a string where all words (separated by space)\n    are replaced by a new word where all the characters arranged in\n    ascending order based on ascii value.\n    Note: You should keep the order of words and blank spaces in the sentence.\n\n    For example:\n    anti_shuffle('Hi') returns 'Hi'\n    anti_shuffle('hello') returns 'ehllo'\n    anti_shuffle('Hello World!!!') returns 'Hello !!!Wdlor'\n    \"\"\"\n\n    def _is_whitespace(char: str) -> bool:\n        \"\"\"Checks if a character is a whitespace character.\"\"\"\n        return char.isspace()\n\n    def _sort_word_characters(word: str) -> str:\n        \"\"\"Sorts characters within a given word string based on ASCII values.\"\"\"\n        return ''.join(sorted(word))\n\n    def _split_into_tokens(s: str) -> list[str]:\n        \"\"\"Splits the input string into a list of word and space tokens, preserving order.\"\"\"\n        if not s:\n            return []\n\n        tokens = []\n        current_token = []\n        is_current_token_whitespace = _is_whitespace(s[0])\n\n        for char in s:\n            char_is_whitespace = _is_whitespace(char)\n\n            if char_is_whitespace == is_current_token_whitespace:\n                current_token.append(char)\n            else:\n                tokens.append(''.join(current_token))\n                current_token = [char]\n                is_current_token_whitespace = char_is_whitespace\n\n        if current_token:\n            tokens.append(''.join(current_token))\n\n        return tokens\n\n    if not isinstance(s, str):\n        raise TypeError(\"Input 's' must be a string.\")\n\n    if not s:\n        return \"\"\n\n    tokens = _split_into_tokens(s)\n    result_parts = []\n\n    for token in tokens:\n        # If the token starts with a non-whitespace character, it's a 'word' to be sorted.\n        if not _is_whitespace(token[0]):\n            result_parts.append(_sort_word_characters(token))\n        else:\n            result_parts.append(token) # Preserve spaces as is\n\n    return ''.join(result_parts)"}
{"task_id": "HumanEval/88", "solution": "```python\ndef sort_array(array):\n    \"\"\"\n    Sorts an array of non-negative integers based on the parity of the sum of its first and last elements.\n    Returns a new sorted array, leaving the original array unchanged.\n    \"\"\"\n    copied_array = list(array)\n\n    if not copied_array:\n        return []\n\n    if len(copied_array) == 1:\n        return copied_array\n\n    first_element = copied_array[0]\n    last_element = copied_array[-1]\n    sum_elements = first_element + last_element\n\n    if sum_elements % 2 != 0:  # Odd sum, sort ascending\n        return sorted(copied_array, reverse=False)\n    else:  # Even sum, sort descending\n        return sorted(copied_array, reverse=True)\n```"}
{"task_id": "HumanEval/87", "solution": "```python\ndef get_row(lst, x):\n    \"\"\"\n    You are given a 2 dimensional data, as a nested lists,\n    which is similar to matrix, however, unlike matrices,\n    each row may contain a different number of columns.\n    Given lst, and integer x, find integers x in the list,\n    and return list of tuples, [(x1, y1), (x2, y2) ...] such that\n    each tuple is a coordinate - (row, columns), starting with 0.\n    Sort coordinates initially by rows in ascending order.\n    Also, sort coordinates of the row by columns in descending order.\n\n    Examples:\n    get_row([\n      [1,2,3,4,5,6],\n      [1,2,3,4,1,6],\n      [1,2,3,4,5,1]\n    ], 1) == [(0, 0), (1, 4), (1, 0), (2, 5), (2, 0)]\n    get_row([], 1) == []\n    get_row([[], [1], [1, 2, 3]], 3) == [(2, 2)]\n    \"\"\"\n    class Coordinate:\n        \"\"\"Helper class to store coordinates and define custom sorting logic.\"\"\"\n        def __init__(self, r, c):\n            self.row_index = r\n            self.column_index = c\n\n        def to_tuple(self):\n            \"\"\"Converts the Coordinate object to a (row, column) tuple.\"\"\"\n            return (self.row_index, self.column_index)\n\n        def __lt__(self, other):\n            # Sort primarily by row in ascending order.\n            if self.row_index < other.row_index:\n                return True\n            if self.row_index == other.row_index:\n                # For the same row, sort by column in descending order.\n                return self.column_index > other.column_index\n            return False\n\n    found_coordinates_objects = []\n    for r_idx, row in enumerate(lst):\n        for c_idx, val in enumerate(row):\n            if val == x:\n                found_coordinates_objects.append(Coordinate(r_idx, c_idx))\n\n    # Sort the list of Coordinate objects using the custom __lt__ method.\n    found_coordinates_objects.sort()\n\n    # Convert sorted Coordinate objects to a list of tuples.\n    result_tuples = [coord.to_tuple() for coord in found_coordinates_objects]\n\n    return result_tuples\n```"}
{"task_id": "HumanEval/89", "solution": "```python\ndef encrypt(s):\n    \"\"\"Encrypts a string by rotating lowercase English letters by four places, leaving other characters unchanged.\"\"\"\n    result = []\n    for char in s:\n        if 'a' <= char <= 'z':\n            # Shift character by 4 positions, wrapping around the alphabet\n            shifted_char_code = (ord(char) - ord('a') + 4) % 26 + ord('a')\n            result.append(chr(shifted_char_code))\n        else:\n            # Append non-lowercase letters unchanged\n            result.append(char)\n    return \"\".join(result)\n```"}
