{"task_id": "HumanEval/3", "solution": "```python\ndef below_zero(operations: List[int]) -> bool:\n    \"\"\" You're given a list of deposit and withdrawal operations on a bank account that starts with\n    zero balance. Your task is to detect if at any point the balance of account fallls below zero, and\n    at that point function should return True. Otherwise it should return False.\n    >>> below_zero([1, 2, 3])\n    False\n    >>> below_zero([1, 2, -4, 5])\n    True\n    \"\"\"\n    balance = 0\n\n    for operation_amount in operations:\n        balance += operation_amount\n\n        if balance < 0:\n            return True\n\n    return False\n```"}
{"task_id": "HumanEval/1", "solution": "```python\ndef separate_paren_groups(paren_string: str) -> List[str]:\n    \"\"\" Input to this function is a string containing multiple groups of nested parentheses. Your goal is to\n    separate those group into separate strings and return the list of those.\n    Separate groups are balanced (each open brace is properly closed) and not nested within each other\n    Ignore any spaces in the input string.\n    >>> separate_paren_groups('( ) (( )) (( )( ))')\n    ['()', '(())', '(()())']\n    \"\"\"\n\n    def _clean_input(input_string: str) -> str:\n        \"\"\"Removes all space characters from the input string.\"\"\"\n        return input_string.replace(' ', '')\n\n    def _extract_top_level_groups(cleaned_string: str) -> List[str]:\n        \"\"\"Identifies and extracts top-level, balanced parentheses groups.\"\"\"\n        groups = []\n        balance = 0\n        current_group_start = 0\n\n        for i, char in enumerate(cleaned_string):\n            if char == '(':\n                balance += 1\n            elif char == ')':\n                balance -= 1\n\n            if balance == 0 and current_group_start <= i:\n                # A top-level balanced group is found\n                groups.append(cleaned_string[current_group_start : i + 1])\n                current_group_start = i + 1\n        return groups\n\n    cleaned_string = _clean_input(paren_string)\n    result = _extract_top_level_groups(cleaned_string)\n    return result\n```"}
{"task_id": "HumanEval/0", "solution": "```python\ndef has_close_elements(numbers: List[float], threshold: float) -> bool:\n    \"\"\" Check if in given list of numbers, are any two numbers closer to each other than\n    given threshold.\n    >>> has_close_elements([1.0, 2.0, 3.0], 0.5)\n    False\n    >>> has_close_elements([1.0, 2.8, 3.0, 4.0, 5.0, 2.0], 0.3)\n    True\n    \"\"\"\n    if len(numbers) < 2:\n        return False\n\n    sorted_numbers = sorted(numbers)\n    n = len(sorted_numbers)\n\n    for i in range(n):\n        for j in range(i + 1, n):\n            diff = sorted_numbers[j] - sorted_numbers[i] # numbers are sorted, so diff is always non-negative\n            if diff < threshold:\n                return True\n            # Optimization: since the list is sorted, if current diff is already >= threshold,\n            # subsequent differences for this sorted_numbers[i] with larger sorted_numbers[j]\n            # will also be >= threshold.\n            if diff >= threshold:\n                break\n    return False\n```"}
{"task_id": "HumanEval/2", "solution": "```python\ndef truncate_number(number: float) -> float:\n    \"\"\" Given a positive floating point number, it can be decomposed into\n    and integer part (largest integer smaller than given number) and decimals\n    (leftover part always smaller than 1).\n\n    Return the decimal part of the number.\n    >>> truncate_number(3.5)\n    0.5\n    \"\"\"\n    import math\n\n    # Calculate the integer part based on the rule: \"largest integer smaller than the given number.\"\n    # For exact integers (e.g., 5.0), the integer part is floor(number) - 1 (e.g., 4 for 5.0).\n    # For non-exact integers (e.g., 3.5), the integer part is floor(number) (e.g., 3 for 3.5).\n    if number == math.floor(number):\n        integer_part = int(math.floor(number) - 1)\n    else:\n        integer_part = int(math.floor(number))\n\n    # Calculate the decimal part as the leftover after subtracting the integer part.\n    decimal_part = number - integer_part\n\n    return decimal_part\n```\n"}
{"task_id": "HumanEval/5", "solution": "from typing import List\n\n\ndef intersperse(numbers: List[int], delimeter: int) -> List[int]:\n    \"\"\" Insert a number 'delimeter' between every two consecutive elements of input list `numbers'.\n    >>> intersperse([], 4)\n    []\n    >>> intersperse([1, 2, 3], 4)\n    [1, 4, 2, 4, 3]\n    \"\"\"\n    if not numbers:\n        return []\n    if len(numbers) == 1:\n        return numbers\n\n    result_list: List[int] = []\n    for i in range(len(numbers) - 1):\n        result_list.append(numbers[i])\n        result_list.append(delimeter)\n    result_list.append(numbers[-1])\n    return result_list"}
{"task_id": "HumanEval/4", "solution": "```python\ndef mean_absolute_deviation(numbers: List[float]) -> float:\n    \"\"\" For a given list of input numbers, calculate Mean Absolute Deviation\n    around the mean of this dataset.\n    Mean Absolute Deviation is the average absolute difference between each\n    element and a centerpoint (mean in this case):\n    MAD = average | x - x_mean |\n    >>> mean_absolute_deviation([1.0, 2.0, 3.0, 4.0])\n    1.0\n    \"\"\"\n    if not numbers:\n        return 0.0\n\n    # Calculate the mean of the dataset\n    data_mean = sum(numbers) / len(numbers)\n\n    # Calculate the absolute differences from the mean\n    absolute_differences = [abs(x - data_mean) for x in numbers]\n\n    # Calculate the average of these absolute differences\n    mad = sum(absolute_differences) / len(absolute_differences)\n\n    return mad\n```"}
{"task_id": "HumanEval/7", "solution": "```python\nfrom typing import List\n\n\ndef filter_by_substring(strings: List[str], substring: str) -> List[str]:\n    \"\"\" Filter an input list of strings only for ones that contain given substring\n    >>> filter_by_substring([], 'a')\n    []\n    >>> filter_by_substring(['abc', 'bacd', 'cde', 'array'], 'a')\n    ['abc', 'bacd', 'array']\n    \"\"\"\n    filtered_strings = []\n    for s in strings:\n        if substring in s:\n            filtered_strings.append(s)\n    return filtered_strings\n```"}
{"task_id": "HumanEval/6", "solution": "```python\nfrom typing import List\n\n\nclass ParenGroup:\n    \"\"\"Represents a single group of parentheses and calculates its maximum nesting level.\"\"\"\n\n    def __init__(self, group_string: str):\n        self.value: str = group_string\n        self.max_nesting_level: int = 0\n        self.calculate_nesting_level() # Calculate on initialization\n\n    def calculate_nesting_level(self) -> None:\n        \"\"\"Calculates the maximum nesting level for the group_string and stores it in max_nesting_level.\"\"\"\n        current_level = 0\n        max_level = 0\n        for char in self.value:\n            if char == '(':\n                current_level += 1\n                max_level = max(max_level, current_level)\n            elif char == ')':\n                current_level -= 1\n        self.max_nesting_level = max_level\n\ndef parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\" Input to this function is a string represented multiple groups for nested parentheses separated by spaces.\n    For each of the group, output the deepest level of nesting of parentheses.\n    E.g. (()()) has maximum two levels of nesting while ((())) has three.\n\n    >>> parse_nested_parens('(()()) ((())) () ((())()())')\n    [2, 3, 1, 3]\n    \"\"\"\n    group_strings = paren_string.split(' ')\n\n    nesting_levels: List[int] = []\n    for group_str in group_strings:\n        if not group_str:\n            continue\n        paren_group = ParenGroup(group_str)\n        nesting_levels.append(paren_group.max_nesting_level)\n\n    return nesting_levels\n```"}
{"task_id": "HumanEval/8", "solution": "from typing import List, Tuple\n\n\ndef sum_product(numbers: List[int]) -> Tuple[int, int]:\n    \"\"\" For a given list of integers, return a tuple consisting of a sum and a product of all the integers in a list.\n    Empty sum should be equal to 0 and empty product should be equal to 1.\n    >>> sum_product([])\n    (0, 1)\n    >>> sum_product([1, 2, 3, 4])\n    (10, 24)\n    \"\"\"\n    current_sum: int = 0\n    current_product: int = 1\n\n    if not numbers:\n        return (current_sum, current_product)\n\n    for number in numbers:\n        current_sum += number\n        current_product *= number\n\n    return (current_sum, current_product)"}
{"task_id": "HumanEval/9", "solution": "```python\ndef rolling_max(numbers: List[int]) -> List[int]:\n    \"\"\" From a given list of integers, generate a list of rolling maximum element found until given moment\n    in the sequence.\n    >>> rolling_max([1, 2, 3, 2, 3, 4, 2])\n    [1, 2, 3, 3, 3, 4, 4]\n    \"\"\"\n    result = []\n    current_max = float('-inf')\n    for num in numbers:\n        current_max = max(current_max, num)\n        result.append(current_max)\n    return result\n```"}
{"task_id": "HumanEval/10", "solution": "```python\ndef is_palindrome(string: str) -> bool:\n    \"\"\" Test if given string is a palindrome \"\"\"\n    return string == string[::-1]\n\ndef _find_longest_palindromic_postfix(s: str) -> str:\n    \"\"\" Finds the longest postfix of 's' that is a palindrome. \"\"\"\n    for i in range(len(s)):\n        postfix = s[i:]\n        if is_palindrome(postfix):\n            return postfix\n    return \"\" # Should not be reached for non-empty string as single char is palindrome\n\ndef make_palindrome(string: str) -> str:\n    \"\"\" Find the shortest palindrome that begins with a supplied string.\n    Algorithm idea is simple:\n    - Find the longest postfix of supplied string that is a palindrome.\n    - Append to the end of the string reverse of a string prefix that comes before the palindromic suffix.\n    >>> make_palindrome('')\n    ''\n    >>> make_palindrome('cat')\n    'catac'\n    >>> make_palindrome('cata')\n    'catac'\n    \"\"\"\n    if not string:\n        return \"\"\n\n    # Find the longest palindromic postfix\n    longest_pal_postfix = _find_longest_palindromic_postfix(string)\n\n    # The prefix is the part of the string before the longest palindromic postfix\n    prefix_length = len(string) - len(longest_pal_postfix)\n    prefix = string[:prefix_length]\n\n    # Reverse the prefix and append it to the original string\n    return string + prefix[::-1]\n```"}
{"task_id": "HumanEval/12", "solution": "from typing import List, Optional\n\n\ndef longest(strings: List[str]) -> Optional[str]:\n    \"\"\" Out of list of strings, return the longest one. Return the first one in case of multiple\n    strings of the same length. Return None in case the input list is empty.\n    >>> longest([])\n\n    >>> longest(['a', 'b', 'c'])\n    'a'\n    >>> longest(['a', 'bb', 'ccc'])\n    'ccc'\n    \"\"\"\n    if not strings:\n        return None\n\n    # Initialize with the first string as the longest\n    current_longest = strings[0]\n\n    # Iterate through the rest of the strings\n    for s in strings[1:]:\n        if len(s) > len(current_longest):\n            current_longest = s\n\n    return current_longest"}
{"task_id": "HumanEval/13", "solution": "```python\ndef greatest_common_divisor(a: int, b: int) -> int:\n    \"\"\" Return a greatest common divisor of two integers a and b\n    >>> greatest_common_divisor(3, 5)\n    1\n    >>> greatest_common_divisor(25, 15)\n    5\n    \"\"\"\n    a = abs(a)\n    b = abs(b)\n\n    while b:\n        a, b = b, a % b\n    return a\n```"}
{"task_id": "HumanEval/11", "solution": "def string_xor(a: str, b: str) -> str:\n    \"\"\" Input are two strings a and b consisting only of 1s and 0s.\n    Perform binary XOR on these inputs and return result also as a string.\n    >>> string_xor('010', '110')\n    '100'\n    \"\"\"\n\n    class BinaryString:\n        \"\"\"Encapsulates a binary string and provides length access.\"\"\"\n        def __init__(self, value: str):\n            # Validation for string type and binary content is omitted per constraints.\n            self._value = value\n\n        def length(self) -> int:\n            \"\"\"Returns the length of the binary string.\"\"\"\n            return len(self._value)\n\n        def get_value(self) -> str:\n            \"\"\"Returns the encapsulated string value.\"\"\"\n            return self._value\n\n        def __str__(self) -> str:\n            return self._value\n\n        def __repr__(self) -> str:\n            return f\"BinaryString('{self._value}')\"\n\n        def __eq__(self, other: object) -> bool:\n            if not isinstance(other, BinaryString):\n                return NotImplemented\n            return self._value == other._value\n\n        def __hash__(self) -> int:\n            return hash(self._value)\n\n    class XORProcessor:\n        \"\"\"Performs the character-by-character binary XOR operation.\"\"\"\n        def perform_xor(self, a: BinaryString, b: BinaryString) -> BinaryString:\n            \"\"\"Performs XOR on two BinaryString objects, assuming valid and equal length inputs.\"\"\"\n            result_chars = []\n            for char_a, char_b in zip(a.get_value(), b.get_value()):\n                if char_a == char_b:\n                    result_chars.append('0')\n                else:\n                    result_chars.append('1')\n            return BinaryString(\"\".join(result_chars))\n\n    # Input validation (type check, content check, length check) and error raising\n    # are omitted per given constraints (\"Do NOT add isinstance() checks or raise exceptions for edge cases\").\n    binary_a = BinaryString(a)\n    binary_b = BinaryString(b)\n\n    xor_processor = XORProcessor()\n    result_binary_string = xor_processor.perform_xor(binary_a, binary_b)\n\n    return result_binary_string.get_value()"}
