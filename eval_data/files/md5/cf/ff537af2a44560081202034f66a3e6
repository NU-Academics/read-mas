{"task_id": "HumanEval/36", "solution": "```python\ndef fizz_buzz(n: int):\n    \"\"\"Return the number of times the digit 7 appears in integers less than n which are divisible by 11 or 13.\n    >>> fizz_buzz(50)\n    0\n    >>> fizz_buzz(78)\n    2\n    >>> fizz_buzz(79)\n    3\n    \"\"\"\n    def _is_divisible(number: int, divisor1: int, divisor2: int) -> bool:\n        \"\"\"Determines if a number is divisible by either of the two divisors.\"\"\"\n        return number % divisor1 == 0 or number % divisor2 == 0\n\n    def _count_digit(number: int, digit: str) -> int:\n        \"\"\"Counts occurrences of a specific digit in a number.\"\"\"\n        return str(number).count(digit)\n\n    total_count = 0\n    for i in range(1, n):\n        if _is_divisible(i, 11, 13):\n            total_count += _count_digit(i, '7')\n    return total_count\n```"}
{"task_id": "HumanEval/37", "solution": "```python\ndef sort_even(l: list):\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the odd indicies, while its values at the even indicies are equal\n    to the values of the even indicies of l, but sorted.\n    >>> sort_even([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_even([5, 6, 3, 4])\n    [3, 6, 5, 4]\n    \"\"\"\n    result_list = list(l)\n    even_indexed_values = []\n\n    # Extract values from even indices\n    for i in range(0, len(l), 2):\n        even_indexed_values.append(l[i])\n\n    # Sort the extracted values\n    even_indexed_values.sort()\n\n    # Place sorted values back into even indices of the result list\n    for i in range(len(even_indexed_values)):\n        result_list[2 * i] = even_indexed_values[i]\n\n    return result_list\n```"}
{"task_id": "HumanEval/38", "solution": "```python\ndef decode_cyclic(s: str):\n    \"\"\"\n    takes as input string encoded with encode_cyclic function. Returns decoded string.\n    \"\"\"\n    # split string to groups of three characters.\n    groups = [s[(3 * i):min((3 * i + 3), len(s))] for i in range((len(s) + 2) // 3)]\n    # reverse the cyclic shift for groups of three characters.\n    groups = [(group[-1] + group[0] + group[1]) if len(group) == 3 else group for group in groups]\n    return \"\".join(groups)\n```"}
{"task_id": "HumanEval/40", "solution": "```python\ndef triples_sum_to_zero(l: list):\n    \"\"\"\n    triples_sum_to_zero takes a list of integers as an input.\n    it returns True if there are three distinct elements in the list that\n    sum to zero, and False otherwise.\n    \"\"\"\n    if len(l) < 3:\n        return False\n\n    n = len(l)\n    for i in range(n - 2):\n        for j in range(i + 1, n - 1):\n            for k in range(j + 1, n):\n                if l[i] + l[j] + l[k] == 0:\n                    return True\n    return False\n```"}
{"task_id": "HumanEval/39", "solution": "import math\n\ndef prime_fib(n: int):\n    \"\"\"\n    prime_fib returns n-th number that is a Fibonacci number and it's also prime.\n    >>> prime_fib(1)\n    2\n    >>> prime_fib(2)\n    3\n    >>> prime_fib(3)\n    5\n    >>> prime_fib(4)\n    13\n    >>> prime_fib(5)\n    89\n    \"\"\"\n    def _is_prime(num: int) -> bool:\n        \"\"\"Checks if a given number is prime. Optimizes by checking divisors up to square root and skipping even numbers.\"\"\"\n        if num < 2:\n            return False\n        if num == 2:\n            return True\n        if num % 2 == 0:\n            return False\n        for i in range(3, int(math.sqrt(num)) + 1, 2):\n            if num % i == 0:\n                return False\n        return True\n\n    def _generate_fibonacci_numbers():\n        \"\"\"Generates Fibonacci numbers starting from 1, 1, 2, 3, 5... as an infinite sequence.\"\"\"\n        a, b = 1, 1\n        yield a\n        yield b\n        while True:\n            a, b = b, a + b\n            yield b\n\n    if not isinstance(n, int) or n <= 0:\n        raise ValueError(\"Input 'n' must be a positive integer.\")\n\n    prime_fib_count = 0\n    fib_generator = _generate_fibonacci_numbers()\n\n    for fib_num in fib_generator:\n        if fib_num == 1: # 1 is not prime.\n            continue\n        if _is_prime(fib_num):\n            prime_fib_count += 1\n            if prime_fib_count == n:\n                return fib_num"}
