{"task_id": "HumanEval/91", "solution": "def is_bored(S):\n    \"\"\"\n    You'll be given a string of words, and your task is to count the number\n    of boredoms. A boredom is a sentence that starts with the word \"I\".\n    Sentences are delimited by '.', '?' or '!'.\n\n    For example:\n    >>> is_bored(\"Hello world\")\n    0\n    >>> is_bored(\"The sky is blue. The sun is shining. I love this weather\")\n    1\n    \"\"\"\n\n    def _split_into_sentences(text: str, delimiters: str) -> list[str]:\n        \"\"\"Splits the input text into a list of sentences using the provided delimiters.\"\"\"\n        sentences = []\n        current_sentence = []\n        for char in text:\n            current_sentence.append(char)\n            if char in delimiters:\n                sentence = \"\".join(current_sentence).strip()\n                if sentence: # Only add non-empty sentences\n                    sentences.append(sentence)\n                current_sentence = []\n\n        # Add any remaining text as a sentence if no delimiter at the end\n        remaining_text = \"\".join(current_sentence).strip()\n        if remaining_text:\n            sentences.append(remaining_text)\n\n        return sentences\n\n    def _starts_with_i(sentence: str) -> bool:\n        \"\"\"Determines if a sentence starts with the case-sensitive word 'I'.\"\"\"\n        cleaned_sentence = sentence.strip()\n        return cleaned_sentence.startswith(\"I \") or cleaned_sentence == \"I\"\n\n    boredom_count = 0\n    sentences = _split_into_sentences(S, \".!?\")\n    for sentence in sentences:\n        if _starts_with_i(sentence):\n            boredom_count += 1\n    return boredom_count"}
{"task_id": "HumanEval/92", "solution": "```python\ndef any_int(x, y, z):\n    '''\n    Create a function that takes 3 numbers.\n    Returns true if one of the numbers is equal to the sum of the other two, and all numbers are integers.\n    Returns false in any other cases.\n\n    Examples\n    any_int(5, 2, 7) \u279e True\n\n    any_int(3, 2, 2) \u279e False\n\n    any_int(3, -2, 1) \u279e True\n\n    any_int(3.6, -2.2, 2) \u279e False\n\n\n\n    '''\n    # First, check if all numbers are effectively integers (i.e., have no fractional part).\n    # This handles both int types (e.g., 5) and float types that are whole numbers (e.g., 5.0),\n    # while rejecting floats with fractional parts (e.g., 3.6).\n    if not (x % 1 == 0 and y % 1 == 0 and z % 1 == 0):\n        return False\n\n    # If all numbers are integers, then check if one is the sum of the other two.\n    return (x == y + z) or (y == x + z) or (z == x + y)\n```"}
{"task_id": "HumanEval/93", "solution": "```python\n_LOWER_ALPHABET = \"abcdefghijklmnopqrstuvwxyz\"\n_UPPER_ALPHABET = \"ABCDEFGHIJKLMNOPQRSTUVWXYZ\"\n_VOWELS = \"aeiouAEIOU\"\n\ndef _is_alphabetic(char: str) -> bool:\n    \"\"\"Checks if a character is an English alphabetic letter.\"\"\"\n    return char.isalpha()\n\ndef _is_vowel(char: str) -> bool:\n    \"\"\"Checks if a character is an English vowel.\"\"\"\n    return char in _VOWELS\n\ndef _swap_case(char: str) -> str:\n    \"\"\"Swaps the case of an alphabetic character.\"\"\"\n    return char.swapcase()\n\ndef _replace_vowel(vowel_char: str) -> str:\n    \"\"\"Replaces a vowel with the letter two places ahead in the alphabet, maintaining case.\"\"\"\n    if vowel_char.isupper():\n        alphabet = _UPPER_ALPHABET\n    else:\n        alphabet = _LOWER_ALPHABET\n\n    current_index = alphabet.find(vowel_char)\n    new_index = current_index + 2 # For vowels 'a'/'A' through 'u'/'U', this won't exceed alphabet length.\n\n    return alphabet[new_index]\n\ndef encode(message):\n    \"\"\"\n    Encodes a message by swapping letter cases and replacing vowels.\n    \"\"\"\n    encoded_chars = []\n    for char in message:\n        processed_char = char\n        if _is_alphabetic(char):\n            processed_char = _swap_case(char)\n            if _is_vowel(processed_char):\n                processed_char = _replace_vowel(processed_char)\n        encoded_chars.append(processed_char)\n    return \"\".join(encoded_chars)\n```\n"}
{"task_id": "HumanEval/94", "solution": "def skjkasdkd(lst):\n    \"\"\"You are given a list of integers.\n    You need to find the largest prime value and return the sum of its digits.\n    \"\"\"\n\n    def is_prime(n):\n        \"\"\"Checks if a number is prime.\"\"\"\n        if n <= 1:\n            return False\n        if n <= 3:\n            return True\n        if n % 2 == 0 or n % 3 == 0:\n            return False\n        i = 5\n        while i * i <= n:\n            if n % i == 0 or n % (i + 2) == 0:\n                return False\n            i += 6\n        return True\n\n    def sum_digits(n):\n        \"\"\"Calculates the sum of digits of a number.\"\"\"\n        digit_sum = 0\n        for digit_char in str(n):\n            digit_sum += int(digit_char)\n        return digit_sum\n\n    largest_prime = -1\n\n    for number in lst:\n        if is_prime(number):\n            if number > largest_prime:\n                largest_prime = number\n\n    if largest_prime != -1:\n        return sum_digits(largest_prime)\n    else:\n        # According to the problem examples, there is always at least one prime.\n        # If no prime is found (e.g., empty list or no primes), return 0.\n        return 0"}
{"task_id": "HumanEval/95", "solution": "```python\ndef check_dict_case(dict):\n    \"\"\"\n    Given a dictionary, return True if all keys are strings in lower\n    case or all keys are strings in upper case, else return False.\n    The function should return False is the given dictionary is empty.\n    \"\"\"\n    if not dict:\n        return False\n\n    has_lower = False\n    has_upper = False\n\n    for key in dict.keys():\n        if not isinstance(key, str):\n            return False\n\n        is_key_lower = key.islower()\n        is_key_upper = key.isupper()\n\n        if is_key_lower:\n            has_lower = True\n        if is_key_upper:\n            has_upper = True\n\n        # If both lower and upper case string keys are found, it's a mix.\n        if has_lower and has_upper:\n            return False\n\n    # Return True if keys are exclusively lower case (has_lower True, has_upper False)\n    # or exclusively upper case (has_upper True, has_lower False).\n    return has_lower != has_upper\n```"}
{"task_id": "HumanEval/96", "solution": "```python\ndef count_up_to(n):\n    \"\"\"Implement a function that takes a non-negative integer and returns an array of the first n\n    integers that are prime numbers and less than n.\n    for example:\n    count_up_to(5) => [2,3]\n    count_up_to(11) => [2,3,5,7]\n    count_up_to(0) => []\n    count_up_to(20) => [2,3,5,7,11,13,17,19]\n    count_up_to(1) => []\n    count_up_to(18) => [2,3,5,7,11,13,17]\n    \"\"\"\n    def _is_prime(num):\n        \"\"\"Helper function to check if a number is prime.\"\"\"\n        if num < 2:\n            return False\n        if num == 2:\n            return True\n        if num % 2 == 0:\n            return False\n        i = 3\n        while i * i <= num:\n            if num % i == 0:\n                return False\n            i += 2\n        return True\n\n    primes_list = []\n    if n <= 2:\n        return []\n\n    for num in range(2, n):\n        if _is_prime(num):\n            primes_list.append(num)\n    return primes_list\n```"}
{"task_id": "HumanEval/97", "solution": "```python\ndef multiply(a, b):\n    \"\"\"Complete the function that takes two integers and returns\n    the product of their unit digits.\n    Assume the input is always valid.\n    Examples:\n    multiply(148, 412) should return 16.\n    multiply(19, 28) should return 72.\n    multiply(2020, 1851) should return 0.\n    multiply(14,-15) should return 20.\n    \"\"\"\n    unit_digit_a = abs(a) % 10\n    unit_digit_b = abs(b) % 10\n    return unit_digit_a * unit_digit_b\n```"}
{"task_id": "HumanEval/98", "solution": "def count_upper(s):\n    \"\"\"\n    Given a string s, count the number of uppercase vowels in even indices.\n\n    For example:\n    count_upper('aBCdEf') returns 1\n    count_upper('abcdefg') returns 0\n    count_upper('dBBE') returns 0\n    \"\"\"\n    count = 0\n    uppercase_vowels = {'A', 'E', 'I', 'O', 'U'}\n    for i, char in enumerate(s):\n        if i % 2 == 0 and char in uppercase_vowels:\n            count += 1\n    return count"}
