 \"\"\"\n    import math\n\n    epsilon = 1e-9 # Tolerance for floating-point comparisons\n\n    # Case 1: x is 1. Any non-zero n to the power of 0 is 1.\n    if x == 1:\n        return True\n\n    # Case 2: n is 1. 1 to any power is 1. Since x != 1, it cannot be a power of 1.\n    if n == 1:\n        return False\n\n    # Case 3: n is 0. 0 to any positive power is 0. Since x != 1, only x=0 is possible.\n    if n == 0:\n        return x == 0\n\n    # Case 4: x is 0. Since n is not 0 (from above), n**k can never be 0.\n    if x == 0:\n        return False\n\n    # From this point: x != 0, x != 1, n != 0, n != 1.\n\n    # Case 5: n is positive.\n    if n > 0:\n        # If x is negative, and n is positive, n**k will always be positive.\n        if x < 0:\n            return False\n        \n        # Both x and n are positive. Use logarithm to find k.\n        try:\n            k_val = math.log(x) / math.log(n)\n            return abs(k_val - round(k_val)) < epsilon\n        except ValueError: # math.log can raise ValueError for non-positive arguments, but these are handled.\n            return False\n        except ZeroDivisionError: # math.log(n) can be 0 if n=1, but n=1 is handled.\n            return False\n\n    # Case 6: n is negative.\n    # x can be positive or negative. n**k's sign depends on k's parity.\n    # We find k for abs(x) and abs(n), then check sign consistency.\n    abs_n = abs(n)\n    abs_x = abs(x)\n\n    try:\n        k_val_abs = math.log(abs_x) / math.log(abs_n)\n        \n        if abs(k_val_abs - round(k_val_abs)) < epsilon:\n            k_int = round(k_val_abs)\n            \n            # Check sign based on k's parity:\n            if k_int % 2 == 0: # Even exponent, result must be positive.\n                return x > 0 \n            else: # Odd exponent, result must have same sign as base n (negative).\n                return x < 0 \n        else:\n            return False # k is not an integer.\n    except ValueError: # math.log for no