of words, return a list of words split on whitespace, if no whitespaces exists in the text you\n    should split on commas ',' if no commas exists you should return the number of lower-case letters with odd order in the\n    alphabet, ord('a') = 0, ord('b') = 1, ... ord('z') = 25\n    Examples\n    split_words(\"Hello world!\") \u279e [\"Hello\", \"world!\"]\n    split_words(\"Hello,world!\") \u279e [\"Hello\", \"world!\"]\n    split_words(\"abcdef\") == 3 \n    '''\n    def _contains_whitespace(text: str) -> bool:\n        \"\"\"Checks if a string contains any whitespace characters.\"\"\"\n        for char in text:\n            if char.isspace():\n                return True\n        return False\n\n    def _contains_comma(text: str) -> bool:\n        \"\"\"Checks if a string contains any comma characters.\"\"\"\n        return ',' in text\n\n    def _split_by_whitespace(text: str) -> list[str]:\n        \"\"\"Splits a string by whitespace.\"\"\"\n        return text.split()\n\n    def _split_by_comma(text: str) -> list[str]:\n        \"\"\"Splits a string by commas.\"\"\"\n        return text.split(',')\n\n    def _get_alphabet_order(char: str) -> int:\n        \"\"\"Calculates the 0-indexed alphabetical order for a given lowercase character.\"\"\"\n        return ord(char) - ord('a')\n\n    def _is_odd_order(order: int) -> bool:\n        \"\"\"Determines if a given alphabetical order is odd.\"\"\"\n        return order % 2 != 0\n\n    def _count_odd_ordered_lowercase_letters(text: str) -> int:\n        \"\"\"Counts lowercase letters with an odd alphabetical order in a string.\"\"\"\n        count = 0\n        for char in text:\n            if 'a' <= char <= 'z': # Check for ASCII lowercase letters\n                order = _get_alphabet_order(char)\n                if _is_odd_order(order):\n                    count += 1\n        return count\n\n    if _contains_whitespace(txt):\n        return _split_by_whitespace(txt)\n    elif _contains_comma(txt):\n        return _split_by_comma(txt)\n    else:\n        return _count_odd_ordered_lowercase_letters(txt)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/119": [{"task_id": "HumanEval/119", "solution": "def match_parens(lst):\n    '''\n    Checks if two parenthesis strings can be concatenated to form a balanced string.\n    Returns 'Yes' if possible, 'No' otherwise.\n    '''\n\n    def _is_balanced(s):\n        balance = 0\n        for char in s:\n            if char == '(':\n                balance += 1\n            elif char == ')':\n                balance -= 1\n            if balance < 0:\n                return False\n        return balance == 0\n\n    def _validate_input(lst_input):\n        if not isinstance(lst_input, list) or len(lst_input) != 2:\n            return False\n        for item in lst_input:\n            if not isinstance(item, str):\n                return False\n            if not all(char in '()' for char in item):\n                return False\n        return True\n\n    if not _validate_input(lst):\n        return 'No'\n\n    s0, s1 = lst[0], lst[1]\n\n    candidate1 = s0 + s1\n    if _is_balanced(candidate1):\n        return 'Yes'\n\n    candidate2 = s1 + s0\n    if _is_balanced(candidate2):\n        return 'Yes'\n\n    return 'No'", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/127": [{"task_id": "HumanEval/127", "solution": "import math\nclass Interval:\n    def __init__(self, start: int, end: int):\n        self.start = start\n        self.end = end\n\n    def get_length(self) -> int:\n        return self.end - self.start + 1\nclass IntersectionCalculator:\n    @staticmethod\n    def calculate_intersection(interval1_tuple: tuple[int, int], interval2_tuple: tuple[int, int]) -> tuple[int, int] | None:\n        start1, end1 = interval1_tuple\n        start2, end2 = interval2_tuple\n\n        max_start = max(start1, start2)\n        min_end = min(end1, end2)\n\n        if max_start <= min_end:\n            return (max_start, min_end)\n        else:\n            return None\n\n    @staticmethod\n    def get_intersection_length(intersection_interval_tuple: tuple[int, int] | None) -> int:\n        if intersection_interval_tuple is None:\n            return 0\n        \n        start, end = intersection_interval_tuple\n        interval_obj = Interval(start, end)\n        return interval_obj.get_length()\nclass PrimeChecker:\n    @staticmethod\n    def is_prime(number: int) -> bool:\n        if number <= 1:\n            return False\n        if number == 2:\n            return True\n        if number % 2 == 0:\n            return False\n        \n        limit = int(math.sqrt(number))\n        for i in range(3, limit + 1, 2):\n            if number % i == 0:\n                return False\n        return True\ndef intersection(interval1, interval2):\n    \"\"\"\n    Determines if the length of the intersection of two intervals is a prime number.\n    Returns \"YES\" if prime, \"NO\" otherwise or if intervals don't intersect.\n    \"\"\"\n    \n    intersection_tuple = IntersectionCalculator.calculate_intersection(interval1, interval2)\n    \n    if intersection_tuple is None:\n        return \"NO\"\n    \n    intersection_length = IntersectionCalculator.get_intersection_length(intersection_tuple)\n    \n    if PrimeChecker.is_prime(intersection_length):\n        return \"YES\"\n    else:\n        return \"NO\"", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[[-1, 1], [0, 4]]], "plus_fail_tests": [[[10, 20], [15, 25]]]}], "HumanEval/124": [{"task_id": "HumanEval/124", "solution": "def valid_date(date):\n    \"\"\"You have to write a function which validates a given date string and\n    returns True if the date is valid otherwise False.\n    The date is valid if all of the following rules are satisfied:\n    1. The date string is not empty.\n    2. The number of days is not less than 1 or higher than 31 days for months 1,3,5,7,8,10,12. And the number of days is not less than 1 or higher than 30 days for months 4,6,9,11. And, the number of days is not less than 1 or higher than 29 for the month 2.\n    3. The months should not be less than 1 or higher than 12.\n    4. The date should be in the format: mm-dd-yyyy\n\n    for example:\n    valid_date('03-11-2000') => True\n\n    valid_date('15-01-2012') => False\n\n    valid_date('04-0-2040') => False\n\n    valid_date('06-04-2020') => True\n\n    valid_date('06/04/2020') => False\n    \"\"\"\n    if not date:\n        return False\n\n    # Assuming 're' module is imported at the module level.\n    # Check for 'mm-dd-yyyy' format and extract components.\n    import re\n    match = re.match(r'^(\\d{2})-(\\d{2})-(\\d{4})$', date)\n    if not match:\n        return False\n\n    try:\n        month = int(match.group(1))\n        day = int(match.group(2))\n        year = int(match.group(3))\n    except ValueError:\n        return False\n\n    # Validate month range (1-12).\n    if not (1 <= month <= 12):\n        return False\n\n    # Validate day minimum (>=1).\n    if day < 1:\n        return False\n\n    # Validate day maximum based on month.\n    if month in [1, 3, 5, 7, 8, 10, 12]:\n        if day > 31:\n            return False\n    elif month in [4, 6, 9, 11]:\n        if day > 30:\n            return False\n    elif month == 2:\n        # For February, allow up to 29 days.\n        if day > 29:\n            return False\n\n    return True", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [["06-04-2020\n"]]}], "HumanEval/129": [{"task_id": "HumanEval/129", "solution": "def minPath(grid, k):\n    \"\"\"\n    Finds the lexicographically minimum path of length k in the grid.\n    This uses a recursive depth-first search (DFS) with backtracking,\n    and two nested helper classes for grid operations and path comparison.\n    \"\"\"\n    N = len(grid)\n\n    class Grid:\n        \"\"\"Represents the N x N grid and provides access to cell values and neighbors.\"\"\"\n        def __init__(self, grid_data):\n            self._grid_data = grid_data\n            self._N = len(grid_data)\n\n        def get_value(self, row, col):\n            \"\"\"Returns the integer value at the specified grid coordinates.\"\"\"\n            return self._grid_data[row][col]\n\n        def is_valid_coord(self, row, col):\n            \"\"\"Checks if the given coordinates are within the grid boundaries.\"\"\"\n            return 0 <= row < self._N and 0 <= col < self._N\n\n        def get_neighbors(self, row, col):\n            \"\"\"Returns a list of valid (row, col) tuples for adjacent cells (up, down, left, right).\"\"\"\n            neighbors = []\n            # Define possible moves: (row_offset, col_offset)\n            directions = [(0, 1), (0, -1), (1, 0), (-1, 0)]  # Right, Left, Down, Up\n            for dr, dc in directions:\n                nr, nc = row + dr, col + dc\n                if self.is_valid_coord(nr, nc):\n                    neighbors.append((nr, nc))\n            return neighbors\n\n    class Path:\n        \"\"\"Represents a sequence of cell values forming a path and supports lexicographical comparison.\"\"\"\n        def __init__(self, initial_value=None):\n            \"\"\"Initializes a new path, optionally with an initial cell value.\"\"\"\n            self._values = []\n            if initial_value is not None:\n                self._values.append(initial_value)\n\n        def add_cell(self, value):\n            \"\"\"Appends a cell value to the path.\"\"\"\n            self._values.append(value)\n\n        def get_values(self):\n            \"\"\"Returns the ordered list of values in the path.\"\"\"\n            return self._values\n\n        def get_length(self):\n            \"\"\"Returns the current length of the path.\"\"\"\n            return len(self._values)\n\n        def __lt__(self, other_path):\n            \"\"\"Implements lexicographical comparison for paths.\"\"\"\n            return self._values < other_path._values\n\n    grid_obj = Grid(grid)\n    min_path_found = None  # Stores the lexicographically smallest path found so far (List[int])\n\n    def _find_min_path_recursive(current_path_values_so_far, current_row, current_col, steps_taken):\n        \"\"\"\n        Recursively explores paths of length k, updating the global minimum path found.\n        'min_path_found' is updated as a nonlocal variable.\n        \"\"\"\n        nonlocal min_path_found\n\n        # Add the current cell's value to the path\n        current_path_values_extended = current_path_values_so_far + [grid_obj.get_value(current_row, current_col)]\n\n        if steps_taken + 1 == k:  # If a path of length k is formed\n            current_path_obj = Path()\n            current_path_obj._values = current_path_values_extended # Efficiently assign the list\n\n            # Compare with the minimum path found so far\n            if min_path_found is None or current_path_obj < Path(min_path_found):\n                min_path_found = current_path_values_extended[:]  # Store a copy of the path\n\n        else:  # Path not yet complete, continue exploring neighbors\n            neighbors = grid_obj.get_neighbors(current_row, current_col)\n            for nr, nc in neighbors:\n                _find_min_path_recursive(current_path_values_extended, nr, nc, steps_taken + 1)\n\n    # Start the DFS from each cell in the grid\n    for r in range(N):\n        for c in range(N):\n            # For each starting cell, begin a new path exploration\n            _find_min_path_recursive([], r, c, 0)\n\n    return min_path_found", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[[[1, 2, 3], [4, 5, 6], [7, 8, 9]], 3]], "plus_fail_tests": [[[[1, 2, 3], [4, 5, 6], [7, 8, 9]], 1]]}], "HumanEval/128": [{"task_id": "HumanEval/128", "solution": "def prod_signs(arr):\n    \"\"\"\n    Returns the sum of magnitudes of integers multiplied by the product of all signs.\n    Returns None for an empty array.\n    \"\"\"\n\n    def _get_sign(number: int) -> int:\n        \"\"\"Determines the sign (1, -1, or 0) of a single integer.\"\"\"\n        if number > 0:\n            return 1\n        elif number < 0:\n            return -1\n        else:\n            return 0\n\n    def _get_magnitude(number: int) -> int:\n        \"\"\"Determines the magnitude (absolute value) of a single integer.\"\"\"\n        return abs(number)\n\n    def _calculate_product_of_signs(arr: list[int]) -> int:\n        \"\"\"Calculates the product of signs for all integers in an array.\"\"\"\n        product = 1\n        for num in arr:\n            sign = _get_sign(num)\n            if sign == 0:\n                return 0\n            product *= sign\n        return product\n\n    def _calculate_sum_of_magnitudes(arr: list[int]) -> int:\n        \"\"\"Calculates the sum of magnitudes for all integers in an array.\"\"\"\n        total_magnitude = 0\n        for num in arr:\n            total_magnitude += _get_magnitude(num)\n        return total_magnitude\n\n    if not arr:\n        return None\n\n    product_of_signs = _calculate_product_of_signs(arr)\n    sum_of_magnitudes = _calculate_sum_of_magnitudes(arr)\n\n    return sum_of_magnitudes * product_of_signs", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/36": [{"task_id": "HumanEval/36", "solution": "def fizz_buzz(n: int):\n    \"\"\"Return the number of times the digit 7 appears in integers less than n which are divisible by 11 or 13.\n    >>> fizz_buzz(50)\n    0\n    >>> fizz_buzz(78)\n    2\n    >>> fizz_buzz(79)\n    3\n    \"\"\"\n\n    def _is_divisible_by_11_or_13(num: int) -> bool:\n        \"\"\"Checks if a number is divisible by 11 or 13.\"\"\"\n        return (num % 11 == 0) or (num % 13 == 0)\n\n    def _count_digit(num: int, digit: int) -> int:\n        \"\"\"Counts occurrences of a specific digit within an integer.\"\"\"\n        return str(num).count(str(digit))\n\n    total_sevens = 0\n    for i in range(1, n):\n        if _is_divisible_by_11_or_13(i):\n            total_sevens += _count_digit(i, 7)\n    return total_sevens", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/134": [{"task_id": "HumanEval/134", "solution": "def check_if_last_char_is_a_letter(txt):\n    \"\"\"\n    Returns True if the last character of a given string is an alphabetical character\n    and is not part of a word, and False otherwise.\n    \"\"\"\n    if not txt:\n        return False\n\n    last_char = txt[-1]\n\n    if not last_char.isalpha():\n        return False\n\n    if len(txt) == 1:\n        return True\n    else:\n        char_before_last = txt[-2]\n        if char_before_last.isspace():\n            return True\n        else:\n            return False", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [["apple pi\ne"]]}], "HumanEval/131": [{"task_id": "HumanEval/131", "solution": "def digits(n):\n    \"\"\"Given a positive integer n, return the product of the odd digits.\n    Return 0 if all digits are even.\n    \"\"\"\n\n    def _is_odd(digit):\n        # Checks if a given digit is odd.\n        return digit % 2 != 0\n\n    def _extract_digits(number):\n        # Extracts individual digits from a positive integer.\n        return [int(d) for d in str(number)]\n\n    product = 1\n    found_odd_digit = False\n    \n    # Iterate through the extracted digits and multiply odd ones.\n    for digit in _extract_digits(n):\n        if _is_odd(digit):\n            product *= digit\n            found_odd_digit = True\n            \n    # Return 0 if no odd digits were found, otherwise return the product.\n    if not found_odd_digit:\n        return 0\n    else:\n        return product", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus