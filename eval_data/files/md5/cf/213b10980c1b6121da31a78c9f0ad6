e if planet1 or planet2\n    are not correct planet names. \n    Examples\n    bf(\"Jupiter\", \"Neptune\") ==> (\"Saturn\", \"Uranus\")\n    bf(\"Earth\", \"Mercury\") ==> (\"Venus\")\n    bf(\"Mercury\", \"Uranus\") ==> (\"Venus\", \"Earth\", \"Mars\", \"Jupiter\", \"Saturn\")\n    '''\n    if planet1 not in _PLANETS or planet2 not in _PLANETS:\n        return ()\n\n    idx1 = _PLANETS.index(planet1)\n    idx2 = _PLANETS.index(planet2)\n\n    start_idx = min(idx1, idx2) + 1\n    end_idx = max(idx1, idx2)\n    \n    # Return an empty tuple if start_idx is greater than or equal to end_idx,\n    # meaning there are no planets strictly between the two inputs.\n    if start_idx >= end_idx:\n        return ()\n    \n    return _PLANETS[start_idx:end_idx]", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/152": [{"task_id": "HumanEval/152", "solution": "def compare(game,guess):\n    \"\"\"Compares two arrays of scores and guesses to determine how far off each guess was.\n    Returns an array of the same length denoting the absolute difference for each match.\n    \"\"\"\n    result = []\n    for i in range(len(game)):\n        if game[i] == guess[i]:\n            result.append(0)\n        else:\n            result.append(abs(game[i] - guess[i]))\n    return result", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/144": [{"task_id": "HumanEval/144", "solution": "def simplify(x, n):\n    \"\"\"Your task is to implement a function that will simplify the expression\n    x * n. The function returns True if x * n evaluates to a whole number and False\n    otherwise. Both x and n, are string representation of a fraction, and have the following format,\n    <numerator>/<denominator> where both numerator and denominator are positive whole numbers.\n\n    You can assume that x, and n are valid fractions, and do not have zero as denominator.\n\n    simplify(\"1/5\", \"5/1\") = True\n    simplify(\"1/6\", \"2/1\") = False\n    simplify(\"7/10\", \"10/2\") = False\n    \"\"\"\n\n    class Fraction:\n        \"\"\"Represents a mathematical fraction and provides operations.\"\"\"\n        def __init__(self, numerator: int, denominator: int):\n            self.numerator = numerator\n            self.denominator = denominator\n\n        @classmethod\n        def from_string(cls, fraction_string: str) -> 'Fraction':\n            \"\"\"Parses a string (e.g., \"1/2\") into a Fraction object.\"\"\"\n            num_str, den_str = fraction_string.split('/')\n            return cls(int(num_str), int(den_str))\n\n        def multiply(self, other: 'Fraction') -> 'Fraction':\n            \"\"\"Multiplies this fraction by another, returning a new Fraction object.\"\"\"\n            new_numerator = self.numerator * other.numerator\n            new_denominator = self.denominator * other.denominator\n            return Fraction(new_numerator, new_denominator)\n\n        def is_whole_number(self) -> bool:\n            \"\"\"Determines if the fraction represents a whole number.\"\"\"\n            return self.numerator % self.denominator == 0\n\n    fraction_x = Fraction.from_string(x)\n    fraction_n = Fraction.from_string(n)\n\n    product_fraction = fraction_x.multiply(fraction_n)\n\n    return product_fraction.is_whole_number()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/151": [{"task_id": "HumanEval/151", "solution": "def double_the_difference(lst):\n    '''\n    Given a list of numbers, return the sum of squares of the numbers\n    in the list that are odd. Ignore numbers that are negative or not integers.\n    '''\n    total_sum_of_squares = 0\n    for num in lst:\n        if isinstance(num, int):\n            if num >= 0:\n                if num % 2 != 0:\n                    total_sum_of_squares += num * num\n    return total_sum_of_squares", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/150": [{"task_id": "HumanEval/150", "solution": "def x_or_y(n, x, y):\n    \"\"\"A simple program which should return the value of x if n is \n    a prime number and should return the value of y otherwise.\n    \"\"\"\n    def is_prime(num):\n        if num <= 1:\n            return False\n        if num == 2:\n            return True\n        if num % 2 == 0:\n            return False\n        i = 3\n        while i * i <= num:\n            if num % i == 0:\n                return False\n            i += 2\n        return True\n\n    if is_prime(n):\n        return x\n    else:\n        return y", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/147": [{"task_id": "HumanEval/147", "solution": "def get_max_triples(n):\n    \"\"\"\n    Calculates the number of triples (a[i], a[j], a[k]) such that i < j < k\n    and a[i] + a[j] + a[k] is a multiple of 3.\n    \"\"\"\n    import math\n\n    def _combinations(n_items: int, k_chosen: int) -> int:\n        \"\"\"Calculates n choose k combinations.\"\"\"\n        if k_chosen < 0 or k_chosen > n_items:\n            return 0\n        return math.comb(n_items, k_chosen)\n\n    def _calculate_modulo_counts(limit: int) -> tuple[int, int]:\n        \"\"\"Calculates counts of a[i] % 3 == 0 and a[i] % 3 == 1.\"\"\"\n        count_mod_0 = 0\n        count_mod_1 = 0\n        for i_val in range(1, limit + 1):\n            # a[i_val] = i_val*i_val - i_val + 1\n            # If i_val % 3 == 0: a[i_val] % 3 = (0 - 0 + 1) % 3 = 1\n            # If i_val % 3 == 1: a[i_val] % 3 = (1 - 1 + 1) % 3 = 1\n            # If i_val % 3 == 2: a[i_val] % 3 = (4 - 2 + 1) % 3 = 3 % 3 = 0\n            if i_val % 3 == 2:\n                count_mod_0 += 1\n            else: # i_val % 3 == 0 or i_val % 3 == 1\n                count_mod_1 += 1\n        return count_mod_0, count_mod_1\n\n    count_mod_0, count_mod_1 = _calculate_modulo_counts(n)\n\n    # A triple (r1, r2, r3) sums to a multiple of 3 if (r1 + r2 + r3) % 3 == 0.\n    # Given a[i] % 3 can only be 0 or 1, the only valid combinations of remainders are:\n    # (0, 0, 0) -> sum 0 % 3 == 0\n    # (1, 1, 1) -> sum 3 % 3 == 0\n    triples_from_mod_0 = _combinations(count_mod_0, 3)\n    triples_from_mod_1 = _combinations(count_mod_1, 3)\n\n    return triples_from_mod_0 + triples_from_mod_1", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/153": [{"task_id": "HumanEval/153", "solution": "def Strongest_Extension(class_name, extensions):\n    \"\"\"You will be given the name of a class (a string) and a list of extensions.\n    The extensions are to be used to load additional classes to the class. The\n    strength of the extension is as follows: Let CAP be the number of the uppercase\n    letters in the extension's name, and let SM be the number of lowercase letters \n    in the extension's name, the strength is given by the fraction CAP - SM. \n    You should find the strongest extension and return a string in this \n    format: ClassName.StrongestExtensionName.\n    If there are two or more extensions with the same strength, you should\n    choose the one that comes first in the list.\n    For example, if you are given \"Slices\" as the class and a list of the\n    extensions: ['SErviNGSliCes', 'Cheese', 'StuFfed'] then you should\n    return 'Slices.SErviNGSliCes' since 'SErviNGSliCes' is the strongest extension \n    (its strength is -1).\n    Example:\n    for Strongest_Extension('my_class', ['AA', 'Be', 'CC']) == 'my_class.AA'\n    \"\"\"\n    from collections import namedtuple\n\n    # Internal data structure to hold extension details during processing.\n    ExtensionData = namedtuple('ExtensionData', ['name', 'strength', 'original_index'])\n\n    def _calculate_strength(extension_name: str) -> int:\n        \"\"\"Calculates strength as (uppercase letters - lowercase letters).\"\"\"\n        cap_count = sum(1 for char in extension_name if char.isupper())\n        sm_count = sum(1 for char in extension_name if char.islower())\n        return cap_count - sm_count\n\n    if not extensions:\n        return f\"{class_name}.\"\n\n    processed_extensions = []\n    for i, ext_name in enumerate(extensions):\n        strength = _calculate_strength(ext_name)\n        processed_extensions.append(ExtensionData(name=ext_name, strength=strength, original_index=i))\n\n    # Sort by strength in descending order, then by original_index in ascending order for tie-breaking.\n    processed_extensions.sort(key=lambda x: (-x.strength, x.original_index))\n\n    strongest_ext_data = processed_extensions[0]\n\n    return f\"{class_name}.{strongest_ext_data.name}\"", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/154": [{"task_id": "HumanEval/154", "solution": "def cycpattern_check(a , b):\n    \"\"\"\n    Checks if the second word or any of its rotations is a substring in the first word.\n    This function utilizes nested helper functions for rotation generation and substring checking.\n    \"\"\"\n\n    def _generate_rotations(s: str) -> set[str]:\n        \"\"\"Generates all unique cyclic rotations of a given string s.\"\"\"\n        n = len(s)\n        if n == 0:\n            return {\"\"}\n        rotations = set()\n        current_s = s\n        for _ in range(n):\n            rotations.add(current_s)\n            current_s = current_s[1:] + current_s[0]\n        return rotations\n\n    def _is_substring(sub: str, main: str) -> bool:\n        \"\"\"Checks if the string 'sub' is a substring of the string 'main'.\"\"\"\n        return sub in main\n\n    # Optimization: if the second string (b) is longer than the first (a),\n    # no rotation of b can be a substring of a, unless b is an empty string.\n    if len(b) > len(a):\n        # If b is not empty and longer than a, it cannot be a substring.\n        if b:\n            return False\n        # If b is empty, it's a substring of any string a, including an empty a.\n        return True # Handled by general case for b=\"\" below as well.\n\n    # If b is an empty string, it is always considered a substring of any string a.\n    if not b:\n        return True\n\n    rotations_of_b = _generate_rotations(b)\n\n    for rotation in rotations_of_b:\n        if _is_substring(rotation, a):\n            return True\n\n    return False", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/155": [{"task_id": "HumanEval/155", "solution": "def even_odd_count(num):\n    \"\"\"Given an integer. return a tuple that has the number of even and odd digits respectively.\n\n     Example:\n        even_odd_count(-12) ==> (1, 1)\n        even_odd_count(123) ==> (1, 2)\n    \"\"\"\n    even_count = 0\n    odd_count = 0\n\n    if num == 0:\n        return (1, 0)\n\n    abs_num = abs(num)\n    num_str = str(abs_num)\n\n    for digit_char in num_str:\n        digit = int(digit_char)\n        if digit % 2 == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n\n    return (even_count, odd_count)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/156": [{"task_id": "HumanEval/156", "solution": "def int_to_mini_roman(number):\n    \"\"\"\n    Given a positive integer, obtain its roman numeral equivalent as a string,\n    and return it in lowercase.\n    Restrictions: 1 <= num <= 1000\n\n    Examples:\n    >>> int_to_mini_roman(19) == 'xix'\n    >>> int_to_mini_roman(152) == 'clii'\n    >>> int_to_mini_roman(426) == 'cdxxvi'\n    \"\"\"\n    # Mapping of integer values to Roman numeral symbols, including subtractive combinations.\n    roman_map = [\n        (1000, 'M'), (900, 'CM'), (500, 'D'), (400, 'CD'),\n        (100, 'C'), (90, 'XC'), (50, 'L'), (40, 'XL'),\n        (10, 'X'), (9, 'IX'), (5, 'V'), (4, 'IV'),\n        (1, 'I')\n    ]\n\n    result_roman = []\n    temp_number = number\n\n    # Iterate through the map from largest to smallest values.\n    for value, symbol in roman_map:\n        while temp_number >= value:\n            result_roman.append(symbol)\n            temp_number -= value\n\n    # Join the symbols and convert to lowercase.\n    return \"\".join(result_roman).lower()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/149": [{"task_id": "HumanEval/149", "solution": "def sorted_list_sum(lst):\n    \"\"\"Write a function that accepts a list of strings as a parameter,\n    deletes the strings that have odd lengths from it,\n    and returns the resulted list with a sorted order,\n    The list is always a list of strings and never an array of numbers,\n    and it may contain duplicates.\n    The order of the list should be ascending by length of each word, and you\n    should return the list sorted by that rule.\n    If two words have the same length, sort the list alphabetically.\n    The function should return a list of strings in sorted order.\n    You may assume that all words will have the same length.\n    For example:\n    assert list_sort([\"aa\", \"a\", \"aaa\"]) => [\"aa\"]\n    assert list_sort([\"ab\", \"a\", \"aaa\", \"cd\"]) => [\"ab\", \"cd\"]\n    \"\"\"\n    \n    def _is_odd_length(s: str) -> bool:\n        \"\"\"Checks if a string has an odd length.\"\"\"\n        return len(s) % 2 != 0\n\n    def _sort_key(s: str) -> tuple[int, str]:\n        \"\"\"Returns a tuple for custom sorting: (length, string_value).\"\"\"\n        return (len(s), s)\n\n    filtered_list = [s for s in lst if not _is_odd_length(s)]\n    return sorted(filtered_list, key=_sort_key)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/157": [{"task_id": "HumanEval/157", "solution": "def right_angle_triangle(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle. Return True if the three\n    sides form a right-angled triangle, False otherwise.\n    A right-angled triangle is a triangle in which one angle is right angle or \n    90 degree.\n    '''\n    sides = sorted([a, b, c])\n    \n    # Define a small epsilon for floating-point comparison to account for precision issues.\n    EPSILON = 1e-9\n    \n    # Check if the square of the longest side (sides[2]) equals the sum of the\n    # squares of the other two sides (sides[0] and sides[1]) using the Pythagorean theorem.\n    return abs(sides[0]**2 + sides[1]**2 - sides[2]**2) < EPSILON", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/162": [{"task_id": "HumanEval/162", "solution": "import hashlib\ndef string_to_md5(text):\n    \"\"\"\n    Given a string 'text', return its md5 hash equivalent string.\n    If 'text' is an empty string, return None.\n    \"\"\"\n    if not text:\n        return None\n    \n    # Encode the string to bytes before hashing\n    md5_hash = hashlib.md5(text.encode('utf-8'))\n    return md5_hash.hexdigest()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/160": [{"task_id": "HumanEval/160", "solution": "def do_algebra(operator, operand):\n    \"\"\"\n    Given two lists operator, and operand. The first list has basic algebra operations, and \n    the second list is a list of integers. Use the two given lists to build the algebric \n    expression and return the evaluation of this expression.\n    \"\"\"\n\n    expression = str(operand[0])\n    for i in range(len(operator)):\n        expression += \" \" + operator[i] + \" \" + str(operand[i+1])\n    \n    return eval(expression)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/158": [{"task_id": "HumanEval/158", "solution": "def _count_unique_chars(word):\n    \"\"\"Calculates the number of unique characters in a given string.\"\"\"\n    return len(set(word))\ndef find_max(words):\n    \"\"\"Write a function that accepts a list of strings.\n    The list contains different words. Return the word with maximum number\n    of unique characters. If multiple strings have maximum number of unique\n    characters, return the one which comes first in lexicographical order.\n    \"\"\"\n    if not words:\n        return \"\"\n\n    max_unique_count = -1\n    result_word = \"\"\n\n    for word in words:\n        current_unique_count = _count_unique_chars(word)\n\n        if current_unique_count > max_unique_count:\n            max_unique_count = current_unique_count\n            result_word = word\n        elif current_unique_count == max_unique_count:\n            # If tie in unique count, return the lexicographically smaller word\n            if word < result_word:\n                result_word = word\n\n    return result_word", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/163": [{"task_id": "HumanEval/163", "solution": "def generate_integers(a, b):\n    \"\"\"\n    Given two positive integers a and b, return the even digits between a\n    and b, in ascending order.\n\n    For example:\n    generate_integers(2, 8) => [2, 4, 6, 8]\n    generate_integers(8, 2) => [2, 4, 6, 8]\n    generate_integers(10, 14) => []\n    \"\"\"\n    start = min(a, b)\n    end = max(a, b)\n\n    even_numbers = []\n    # Determine the first even number greater than or equal to 'start'.\n    current = start if start % 2 == 0 else start + 1\n\n    while current <= end:\n        even_numbers.append(current)\n        current += 2\n\n    return even_numbers", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[2, 10]], "plus_fail_tests": [[6, 12]]}], "HumanEval/161": [{"task_id": "HumanEval/161", "solution": "def solve(s):\n    \"\"\"You are given a string s.\n    if s[i] is a letter, reverse its case from lower to upper or vise versa, \n    otherwise keep it as it is.\n    If the string contains no letters, reverse the string.\n    The function should return the resulted string.\n    Examples\n    solve(\"1234\") = \"4321\"\n    solve(\"ab\") = \"AB\"\n    solve(\"#a@C\") = \"#A@c\"\n    \"\"\"\n\n    def _has_letters(s):\n        \"\"\"Checks if the string contains any alphabetic characters.\"\"\"\n        return any(c.isalpha() for c in s)\n\n    def _process_character(char):\n        \"\"\"Reverses the case of a letter or returns the character unchanged.\"\"\"\n        if char.isalpha():\n            return char.lower() if char.isupper() else char.upper()\n        return char\n\n    def _reverse_string(s):\n        \"\"\"Reverses the order of characters in the entire string.\"\"\"\n        return s[::-1]\n\n    if not _has_letters(s):\n        return _reverse_string(s)\n    else:\n        processed_chars = [_process_character(char) for char in s]\n        return \"\".join(processed_chars)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/159": [{"task_id": "HumanEval/159", "solution": "def eat(number, need, remaining):\n    \"\"\"\n    You're a hungry rabbit, and you already have eaten a certain number of carrots,\n    but now you need to eat more carrots to complete the day's meals.\n    you should return an array of [ total number of eaten carrots after your meals,\n                                    the number of carrots left after your meals ]\n    if there are not enough remaining carrots, you will eat all remaining carrots, but will still be hungry.\n    \"\"\"\n\n    class CarrotMealCalculation:\n        \"\"\"\n        Encapsulates the state and logic for a single carrot meal calculation.\n        This helper class performs the core arithmetic for carrots eaten and remaining.\n        \"\"\"\n        def __init__(self, initial_eaten, needed_to_eat, stock_remaining):\n            self._initial_eaten = initial_eaten\n            self._needed_to_eat = needed_to_eat\n            self._stock_remaining = stock_remaining\n            self._total_eaten_after_meal = None\n            self._stock_left_after_meal = None\n\n        def calculate_outcome(self):\n            \"\"\"\n            Calculates the total carrots eaten and the carrots left based on meal requirements.\n            It determines the consumed carrots by taking the minimum of what's needed and what's available.\n            \"\"\"\n            consumed_carrots = min(self._needed_to_eat, self._stock_remaining)\n            self._total_eaten_after_meal = self._initial_eaten + consumed_carrots\n            self._stock_left_after_meal = self._stock_remaining - consumed_carrots\n\n        def get_total_eaten(self):\n            return self._total_eaten_after_meal\n\n        def get_carrots_left(self):\n            return self._stock_left_after_meal\n\n    calculator = CarrotMealCalculation(number, need, remaining)\n    calculator.calculate_outcome()\n    return [calculator.get_total_eaten(), calculator.get_carrots_left()]", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/83": [{"task_id": "HumanEval/83", "solution": "def starts_one_ends(n):\n    \"\"\"\n    Given a positive integer n, return the count of the numbers of n-digit\n    positive integers that start or end with 1.\n    \"\"\"\n    # For n=1, the only 1-digit positive integer is '1', which starts and ends with 1.\n    if n == 1:\n        return 1\n    # For n > 1, we use the Principle of Inclusion-Exclusion.\n    # Count of numbers starting with 1: 1 * 10^(n-1)\n    # Count of numbers ending with 1: 9 * 10^(n-2) (first digit cannot be 0)\n    # Count of numbers starting AND ending with 1: 1 * 10^(n-2)\n    # Total = (10**(n-1)) + (9 * 10**(n-2)) - (1 * 10**(n-2))\n    # Total = 10**(n-1) + 8 * 10**(n-2)\n    # Total = 10 * 10**(n-2) + 8 * 10**(n-2)\n    # Total = 18 * 10**(n-2)\n    else:\n        return 18 * (10**(n - 2))", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/15": [{"task_id": "HumanEval/15", "solution": "def string_sequence(n: int) -> str:\n    \"\"\" Return a string containing space-delimited numbers starting from 0 upto n inclusive.\n    \"\"\"\n    return ' '.join(str(i) for i in range(n + 1))", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/94": [{"task_id": "HumanEval/94", "solution": "def skjkasdkd(lst):\n    \"\"\"You are given a list of integers.\n    You need to find the largest prime value and return the sum of its digits.\n    \"\"\"\n\n    def is_prime(n):\n        \"\"\"Checks if a number is prime.\"\"\"\n        if n < 2:\n            return False\n        if n == 2:\n            return True\n        if n % 2 == 0:\n            return False\n        i = 3\n        while i * i <= n:\n            if n % i == 0:\n                return False\n            i += 2\n        return True\n\n    def sum_digits(n):\n        \"\"\"Calculates the sum of the digits of a number.\"\"\"\n        s = 0\n        # Handle negative numbers by taking absolute value if needed, but per problem integers are likely positive.\n        # Assuming positive integers based on examples.\n        n_abs = abs(n)\n        while n_abs > 0:\n            s += n_abs % 10\n            n_abs //= 10\n        return s\n\n    def find_largest_prime(numbers):\n        \"\"\"Finds the largest prime number in a list.\"\"\"\n        largest_prime = None\n        for num in numbers:\n            if is_prime(num):\n                if largest_prime is None or num > largest_prime:\n                    largest_prime = num\n        return largest_prime\n\n    largest_prime_val = find_largest_prime(lst)\n\n    if largest_prime_val is not None:\n        return sum_digits(largest_prime_val)\n    else:\n        # As per the design context, if no primes are found, return 0.\n        return 0", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/130": [{"task_id": "HumanEval/130", "solution": "def tri(n):\n    \"\"\"Calculates the Tribonacci sequence up to the n-th term.\n    It uses memoization to efficiently compute terms, including forward dependencies.\n    \"\"\"\n    memo = {}\n\n    def _calculate_single_tribonacci(k_val):\n        if k_val in memo:\n            return memo[k_val]\n\n        if k_val == 0:\n            value = 1\n        elif k_val == 1:\n            value = 3\n        elif k_val % 2 == 0:  # k_val is even and k_val > 0\n            value = 1 + k_val // 2\n        else:  # k_val is odd and k_val > 1\n            # Recurrence: tri(n - 1) + tri(n - 2) + tri(n + 1)\n            value = _calculate_single_tribonacci(k_val - 1) + \\\n                    _calculate_single_tribonacci(k_val - 2) + \\\n                    _calculate_single_tribonacci(k_val + 1)\n        \n        memo[k_val] = value\n        return value\n\n    results = []\n    for i in range(n + 1):\n        results.append(_calculate_single_tribonacci(i))\n\n    return results", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/139": [{"task_id": "HumanEval/139", "solution": "def special_factorial(n):\n    \"\"\"The Brazilian factorial is defined as:\n    brazilian_factorial(n) = n! * (n-1)! * (n-2)! * ... * 1!\n    where n > 0\n\n    For example:\n    >>> special_factorial(4)\n    288\n\n    The function will receive an integer as input and should return the special\n    factorial of this integer.\n    \"\"\"\n    \n    def _calculate_factorial(k):\n        \"\"\"Computes the factorial of a given positive integer k.\"\"\"\n        res = 1\n        for i in range(1, k + 1):\n            res *= i\n        return res\n\n    # Input validation (as per design, assumed to be handled before core logic or integrated)\n    # The design context states input validation should be performed.\n    # For this specific problem, based on previous completions, we integrate basic validation.\n    if not isinstance(n, int):\n        raise TypeError(\"Input 'n' must be an integer.\")\n    if n <= 0:\n        raise ValueError(\"Input 'n' must be greater than 0.\")\n\n    total_product = 1\n    for i in range(1, n + 1):\n        total_product *= _calculate_factorial(i)\n    return total_product", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}]}}