{"task_id": "HumanEval/40", "solution": "def triples_sum_to_zero(l: list):\n    \"\"\"\n    triples_sum_to_zero takes a list of integers as an input.\n    it returns True if there are three distinct elements in the list that\n    sum to zero, and False otherwise.\n    \"\"\"\n    n = len(l)\n    if n < 3:\n        return False\n\n    # Iterate through all unique combinations of three distinct indices (i, j, k).\n    # The nested loops ensure i < j < k, guaranteeing distinct indices.\n    for i in range(n):\n        for j in range(i + 1, n):\n            for k in range(j + 1, n):\n                if l[i] + l[j] + l[k] == 0:\n                    return True\n    return False"}
{"task_id": "HumanEval/43", "solution": "def pairs_sum_to_zero(l):\n    \"\"\"\n    pairs_sum_to_zero takes a list of integers as an input.\n    it returns True if there are two distinct elements in the list that\n    sum to zero, and False otherwise.\n    >>> pairs_sum_to_zero([1, 3, 5, 0])\n    False\n    >>> pairs_sum_to_zero([1, 3, -2, 1])\n    False\n    >>> pairs_sum_to_zero([1, 2, 3, 7])\n    False\n    >>> pairs_sum_to_zero([2, 4, -5, 3, 5, 7])\n    True\n    >>> pairs_sum_to_zero([1])\n    False\n    \"\"\"\n    if len(l) < 2:\n        return False\n\n    seen_numbers = set()\n    for num in l:\n        complement = -num\n        if complement in seen_numbers:\n            return True\n        seen_numbers.add(num)\n    return False"}
{"task_id": "HumanEval/45", "solution": "def triangle_area(a, h):\n    \"\"\"Given length of a side and high return area for a triangle.\n    >>> triangle_area(5, 3)\n    7.5\n    \"\"\"\n    class Triangle:\n        def __init__(self, base: float, height: float):\n            self._validate_dimension(base, \"base\")\n            self._validate_dimension(height, \"height\")\n            self._base = base\n            self._height = height\n\n        def _validate_dimension(self, dimension: float, name: str):\n            if not isinstance(dimension, (int, float)):\n                raise ValueError(f\"{name} must be a number.\")\n            if dimension <= 0:\n                raise ValueError(f\"{name} must be positive.\")\n\n        def get_base(self) -> float:\n            return self._base\n\n        def get_height(self) -> float:\n            return self._height\n\n    class AreaCalculator:\n        def calculate_area(self, triangle: Triangle) -> float:\n            return 0.5 * triangle.get_base() * triangle.get_height()\n\n    try:\n        triangle = Triangle(a, h)\n        calculator = AreaCalculator()\n        return calculator.calculate_area(triangle)\n    except ValueError as e:\n        raise e"}
{"task_id": "HumanEval/44", "solution": "def change_base(x: int, base: int):\n    \"\"\"Change numerical base of input number x to base.\n    return string representation after the conversion.\n    base numbers are less than 10.\n    >>> change_base(8, 3)\n    '22'\n    >>> change_base(8, 2)\n    '1000'\n    >>> change_base(7, 2)\n    '111'\n    \"\"\"\n    if x == 0:\n        return \"0\"\n\n    result_digits = []\n    current_x = x\n    while current_x > 0:\n        remainder = current_x % base\n        result_digits.append(str(remainder))\n        current_x //= base\n    \n    return \"\".join(reversed(result_digits))"}
{"task_id": "HumanEval/41", "solution": "class RaceParameters:\n    \"\"\"\n    Data model for the parameters of the car race collision calculation.\n    \"\"\"\n    def __init__(self, n: int):\n        if not isinstance(n, int):\n            raise ValueError(\"n must be an integer.\")\n        if n < 0:\n            raise ValueError(\"n must be a non-negative integer.\")\n        self.n = n\nclass CollisionCalculator:\n    \"\"\"\n    Service class responsible for calculating the number of collisions\n    in the car race scenario.\n    \"\"\"\n    def calculate_collisions(self, params: RaceParameters) -> int:\n        \"\"\"\n        Calculates the total number of collisions.\n        \"\"\"\n        if params.n <= 0:\n            raise ValueError(\"The number of cars (n) must be a positive integer for collisions to occur.\")\n        return params.n * params.n\ndef car_race_collision(n: int) -> int:\n    \"\"\"\n    Calculates the number of collisions in a simplified car race.\n    \"\"\"\n    params = RaceParameters(n)\n    calculator = CollisionCalculator()\n    return calculator.calculate_collisions(params)"}
{"task_id": "HumanEval/48", "solution": "def is_palindrome(text: str):\n    \"\"\"\n    Checks if given string is a palindrome\n    >>> is_palindrome('')\n    True\n    >>> is_palindrome('aba')\n    True\n    >>> is_palindrome('aaaaa')\n    True\n    >>> is_palindrome('zbcd')\n    False\n    \"\"\"\n    return text == text[::-1]"}
{"task_id": "HumanEval/47", "solution": "class EmptyListError(ValueError):\n    \"\"\"Custom exception raised when an empty list is provided where a non-empty list is required.\"\"\"\n    def __init__(self, message: str = \"Input list cannot be empty.\"):\n        super().__init__(message)\ndef median(l: list):\n    \"\"\"Return median of elements in the list l.\n    >>> median([3, 1, 2, 4, 5])\n    3\n    >>> median([-10, 4, 6, 1000, 10, 20])\n    15.0\n    \"\"\"\n    if not l:\n        raise EmptyListError(\"Input list cannot be empty.\")\n\n    sorted_list = sorted(l)\n    n = len(sorted_list)\n\n    if n % 2 == 1:\n        return sorted_list[n // 2]\n    else:\n        mid1 = sorted_list[n // 2 - 1]\n        mid2 = sorted_list[n // 2]\n        return (mid1 + mid2) / 2.0"}
{"task_id": "HumanEval/46", "solution": "def fib4(n: int):\n    \"\"\"Computes the n-th element of the Fib4 number sequence efficiently without recursion.\n    Handles base cases for n=0, 1, 2, 3 and iteratively calculates for n > 3.\n    \"\"\"\n    if n == 0:\n        return 0\n    if n == 1:\n        return 0\n    if n == 2:\n        return 2\n    if n == 3:\n        return 0\n\n    # Initialize the first four terms of the sequence: fib4(0), fib4(1), fib4(2), fib4(3)\n    a, b, c, d = 0, 0, 2, 0\n\n    # Iterate from n=4 up to the desired n\n    for _ in range(4, n + 1):\n        next_fib = a + b + c + d\n        # Shift the values to prepare for the next iteration\n        a, b, c, d = b, c, d, next_fib\n    return d"}
