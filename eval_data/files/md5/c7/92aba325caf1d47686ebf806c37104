{"task_id": "HumanEval/56", "solution": "def correct_bracketing(brackets: str):\n    \"\"\" brackets is a string of \"<\" and \">\".\n    return True if every opening bracket has a corresponding closing bracket.\n    \"\"\"\n    balance = 0\n    for char in brackets:\n        if char == '<':\n            balance += 1\n        elif char == '>':\n            balance -= 1\n        else:\n            raise ValueError(f\"Invalid character '{char}' in bracket string. Only '<' and '>' are allowed.\")\n        if balance < 0:\n            return False  # Closing bracket without a corresponding opening bracket\n    return balance == 0  # True if all brackets are matched, False if unclosed opening brackets remain"}
{"task_id": "HumanEval/58", "solution": "def common(l1: list, l2: list):\n    \"\"\"Return sorted unique common elements for two lists.\"\"\"\n    set1 = set(l1)\n    set2 = set(l2)\n    common_elements_set = set1.intersection(set2)\n    result_list = sorted(list(common_elements_set))\n    return result_list"}
{"task_id": "HumanEval/55", "solution": "def fib(n: int):\n    \"\"\"Return n-th Fibonacci number.\n    >>> fib(10)\n    55\n    >>> fib(1)\n    1\n    >>> fib(8)\n    21\n    \"\"\"\n    if n == 0:\n        return 0\n    elif n == 1:\n        return 1\n    else:\n        a, b = 0, 1\n        # Iterate from the 2nd number up to n to calculate the Nth Fibonacci number.\n        for _ in range(2, n + 1):\n            a, b = b, a + b\n        return b"}
{"task_id": "HumanEval/59", "solution": "def largest_prime_factor(n: int):\n    \"\"\"Return the largest prime factor of n. Assume n > 1 and is not a prime.\"\"\"\n    largest_factor = 1\n    temp_n = n\n\n    # Divide by 2 until temp_n is odd\n    while temp_n % 2 == 0:\n        largest_factor = 2\n        temp_n //= 2\n\n    # Iterate for odd factors starting from 3\n    i = 3\n    while i * i <= temp_n:\n        while temp_n % i == 0:\n            largest_factor = i\n            temp_n //= i\n        i += 2\n\n    # If temp_n is still greater than 1, it must be a prime factor itself\n    if temp_n > 1:\n        largest_factor = temp_n\n\n    return largest_factor"}
{"task_id": "HumanEval/61", "solution": "def correct_bracketing(brackets: str):\n    \"\"\" brackets is a string of \"(\" and \")\".\n    return True if every opening bracket has a corresponding closing bracket.\n    \"\"\"\n    open_brackets_count = 0\n    for char in brackets:\n        if char == '(':\n            open_brackets_count += 1\n        elif char == ')':\n            open_brackets_count -= 1\n        # If open_brackets_count becomes negative, it means a closing bracket appeared without a corresponding opening one.\n        if open_brackets_count < 0:\n            return False\n    # After iterating, if open_brackets_count is 0, all brackets are correctly matched.\n    return open_brackets_count == 0"}
{"task_id": "HumanEval/57", "solution": "def monotonic(l: list):\n    \"\"\"Return True is list elements are monotonically increasing or decreasing.\n    >>> monotonic([1, 2, 4, 20])\n    True\n    >>> monotonic([1, 20, 4, 10])\n    False\n    >>> monotonic([4, 1, 0, -10])\n    True\n    \"\"\"\n    if len(l) <= 1:\n        return True\n\n    is_increasing = True\n    is_decreasing = True\n\n    for i in range(len(l) - 1):\n        if l[i] >= l[i+1]: # If current is not strictly less than next\n            is_increasing = False\n        if l[i] <= l[i+1]: # If current is not strictly greater than next\n            is_decreasing = False\n\n        # Early exit if neither increasing nor decreasing is possible\n        if not is_increasing and not is_decreasing:\n            return False\n\n    return is_increasing or is_decreasing"}
{"task_id": "HumanEval/62", "solution": "def derivative(xs: list):\n    \"\"\" xs represent coefficients of a polynomial.\n    xs[0] + xs[1] * x + xs[2] * x^2 + ....\n     Return derivative of this polynomial in the same form.\n    >>> derivative([3, 1, 2, 4, 5])\n    [1, 4, 12, 20]\n    >>> derivative([1, 2, 3])\n    [2, 6]\n    \"\"\"\n    if not xs or len(xs) == 1:\n        return []\n\n    # The derivative of a_i * x^i is i * a_i * x^(i-1).\n    # The constant term xs[0] differentiates to zero and is dropped.\n    # So, we iterate from index 1.\n    # xs[i] becomes the (i-1)-th coefficient in the derivative list.\n    return [coeff * i for i, coeff in enumerate(xs[1:], start=1)]"}
{"task_id": "HumanEval/60", "solution": "def sum_to_n(n: int) -> int:\n    \"\"\"sum_to_n is a function that sums numbers from 1 to n.\n    >>> sum_to_n(30)\n    465\n    >>> sum_to_n(100)\n    5050\n    >>> sum_to_n(5)\n    15\n    >>> sum_to_n(10)\n    55\n    >>> sum_to_n(1)\n    1\n    \"\"\"\n    return n * (n + 1) // 2"}
{"task_id": "HumanEval/64", "solution": "def vowels_count(s):\n    \"\"\"Write a function vowels_count which takes a string representing\n    a word as input and returns the number of vowels in the string.\n    Vowels in this case are 'a', 'e', 'i', 'o', 'u'. Here, 'y' is also a\n    vowel, but only when it is at the end of the given word.\n\n    Example:\n    >>> vowels_count(\"abcde\")\n    2\n    >>> vowels_count(\"ACEDY\")\n    3\n    \"\"\"\n    vowel_count = 0\n    standard_vowels = {'a', 'e', 'i', 'o', 'u'}\n    lower_s = s.lower()\n\n    for char in lower_s:\n        if char in standard_vowels:\n            vowel_count += 1\n\n    if lower_s and lower_s[-1] == 'y':\n        vowel_count += 1\n\n    return vowel_count"}
{"task_id": "HumanEval/63", "solution": "def fibfib(n: int):\n    \"\"\"Computes the n-th FibFib number efficiently using memoization.\n    It stores previously computed values as a function attribute.\n    \"\"\"\n    if not hasattr(fibfib, \"memo\"):\n        fibfib.memo = {\n            0: 0,\n            1: 0,\n            2: 1\n        }\n\n    if n in fibfib.memo:\n        return fibfib.memo[n]\n\n    # Calculate using the recurrence relation\n    result = fibfib(n - 1) + fibfib(n - 2) + fibfib(n - 3)\n\n    # Store result in memo and return\n    fibfib.memo[n] = result\n    return result"}
