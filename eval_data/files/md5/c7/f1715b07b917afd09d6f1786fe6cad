{"task_id": "HumanEval/65", "solution": "def circular_shift(x, shift):\n    \"\"\"Circular shift the digits of the integer x, shift the digits right by shift\n    and return the result as a string.\n    If shift > number of digits, return digits reversed.\n    \"\"\"\n    digits_str = str(x)\n    length = len(digits_str)\n\n    # Determine the effective shift based on rules.\n    effective_shift_value = shift\n    if effective_shift_value > length:\n        # Business rule: If shift is greater than the number of digits, reverse the digits.\n        return digits_str[::-1]\n    else:\n        # Handle negative shifts by converting to an equivalent right shift.\n        if effective_shift_value < 0:\n            effective_shift_value = (length - (abs(effective_shift_value) % length)) % length\n        # Normalize the shift to be within the range [0, length-1].\n        else:\n            effective_shift_value = effective_shift_value % length\n\n    # Perform the right circular shift.\n    if effective_shift_value == 0:\n        return digits_str\n    return digits_str[-effective_shift_value:] + digits_str[:-effective_shift_value]"}
{"task_id": "HumanEval/63", "solution": "def fibfib(n: int):\n    \"\"\"The FibFib number sequence is a sequence similar to the Fibbonacci sequnece that's defined as follows:\n    fibfib(0) == 0\n    fibfib(1) == 0\n    fibfib(2) == 1\n    fibfib(n) == fibfib(n-1) + fibfib(n-2) + fibfib(n-3).\n    Please write a function to efficiently compute the n-th element of the fibfib number sequence.\n    >>> fibfib(1)\n    0\n    >>> fibfib(5)\n    4\n    >>> fibfib(8)\n    24\n    \"\"\"\n\n    class Matrix3x3:\n        \"\"\"Represents a 3x3 integer matrix and provides matrix operations.\"\"\"\n        def __init__(self, rows: tuple[tuple[int, int, int], ...]) -> None:\n            self.m = rows\n\n        @classmethod\n        def identity(cls) -> \"Matrix3x3\":\n            \"\"\"Returns the 3x3 identity matrix.\"\"\"\n            return cls(((1, 0, 0), (0, 1, 0), (0, 0, 1)))\n\n        def __mul__(self, other: \"Matrix3x3\") -> \"Matrix3x3\":\n            \"\"\"Multiplies this matrix by another 3x3 matrix.\"\"\"\n            a, b = self.m, other.m\n            result_rows = []\n            for i in range(3):\n                row = []\n                for j in range(3):\n                    val = a[i][0] * b[0][j] + a[i][1] * b[1][j] + a[i][2] * b[2][j]\n                    row.append(val)\n                result_rows.append(tuple(row))\n            return Matrix3x3(tuple(result_rows))\n\n        def pow(self, exp: int) -> \"Matrix3x3\":\n            \"\"\"Computes this matrix raised to the power of exp using binary exponentiation.\"\"\"\n            if exp < 0:\n                raise ValueError(\"Negative exponent not supported for matrix power.\")\n            result = Matrix3x3.identity()\n            base = self\n            while exp > 0:\n                if exp % 2 == 1:\n                    result = result * base\n                base = base * base\n                exp //= 2\n            return result\n\n    # Handle base cases for n < 3\n    if n == 0:\n        return 0\n    if n == 1:\n        return 0\n    if n == 2:\n        return 1\n\n    # The transformation matrix for the FibFib sequence is used to calculate\n    # [f(k), f(k-1), f(k-2)] from [f(k-1), f(k-2), f(k-3)].\n    # The matrix is defined as: [[1, 1, 1], [1, 0, 0], [0, 1, 0]].\n    TRANSFORMATION_MATRIX = Matrix3x3(((1, 1, 1), (1, 0, 0), (0, 1, 0)))\n\n    # To find f(n), we raise the transformation matrix to the power of (n-2).\n    # The base vector is [f(2), f(1), f(0)]^T = [1, 0, 0]^T.\n    # [f(n), f(n-1), f(n-2)]^T = (TRANSFORMATION_MATRIX)^(n-2) * [1, 0, 0]^T.\n    # The value f(n) is then the top-left element of the resulting matrix product.\n    m_pow = TRANSFORMATION_MATRIX.pow(n - 2)\n    return m_pow.m[0][0]"}
{"task_id": "HumanEval/70", "solution": "import collections\n\ndef strange_sort_list(lst):\n    '''\n    Given list of integers, return list in strange order.\n    Strange sorting, is when you start with the minimum value,\n    then maximum of the remaining integers, then minimum and so on.\n\n    Examples:\n    strange_sort_list([1, 2, 3, 4]) == [1, 4, 2, 3]\n    strange_sort_list([5, 5, 5, 5]) == [5, 5, 5, 5]\n    strange_sort_list([]) == []\n    '''\n    if not lst:\n        return []\n\n    sorted_lst = sorted(lst)\n    d = collections.deque(sorted_lst)\n    \n    result = []\n    \n    while d:\n        result.append(d.popleft()) \n        if d:\n            result.append(d.pop())\n            \n    return result"}
{"task_id": "HumanEval/68", "solution": "def pluck(arr):\n    \"\"\"\n    Finds the smallest even-valued node and its index in the array.\n    If multiple such nodes exist, the one with the smallest index is chosen.\n    \"\"\"\n    smallest_even_value = None\n    smallest_even_index = -1\n\n    for i, value in enumerate(arr):\n        if value % 2 == 0:  # Check if the value is even\n            if smallest_even_value is None or value < smallest_even_value:\n                smallest_even_value = value\n                smallest_even_index = i\n    \n    if smallest_even_value is None:\n        return []\n    else:\n        return [smallest_even_value, smallest_even_index]"}
{"task_id": "HumanEval/69", "solution": "from collections import Counter\n\ndef search(lst):\n    \"\"\"\n    You are given a non-empty list of positive integers. Return the greatest integer that is greater than \n    zero, and has a frequency greater than or equal to the value of the integer itself. \n    The frequency of an integer is the number of times it appears in the list.\n    If no such a value exist, return -1.\n    \"\"\"\n    freq_map = Counter(lst)\n    \n    candidates = []\n    for value, frequency in freq_map.items():\n        if frequency >= value:  # Check if frequency is greater than or equal to the value itself\n            candidates.append(value)\n            \n    if candidates:\n        return max(candidates)\n    else:\n        return -1"}
{"task_id": "HumanEval/67", "solution": "import re\n\nclass FruitCounts:\n    \"\"\"A data transfer object for fruit counts.\"\"\"\n    def __init__(self, apples: int, oranges: int):\n        self.apples = apples\n        self.oranges = oranges\n\nclass FruitStringParser:\n    \"\"\"Parses a string to extract apple and orange counts.\"\"\"\n    def parse(self, desc: str) -> FruitCounts:\n        apples_match = re.search(r'(\\d+)\\s*apples?', desc, re.IGNORECASE)\n        oranges_match = re.search(r'(\\d+)\\s*oranges?', desc, re.IGNORECASE)\n\n        # Assuming well-formed input as per problem statement and examples.\n        apples = int(apples_match.group(1))\n        oranges = int(oranges_match.group(1))\n\n        return FruitCounts(apples=apples, oranges=oranges)\n\ndef fruit_distribution(s,n):\n    \"\"\"\n    In this task, you will be given a string that represents a number of apples and oranges \n    that are distributed in a basket of fruit this basket contains \n    apples, oranges, and mango fruits. Given the string that represents the total number of \n    the oranges and apples and an integer that represent the total number of the fruits \n    in the basket return the number of the mango fruits in the basket.\n    for examble:\n    fruit_distribution(\"5 apples and 6 oranges\", 19) ->19 - 5 - 6 = 8\n    fruit_distribution(\"0 apples and 1 oranges\",3) -> 3 - 0 - 1 = 2\n    fruit_distribution(\"2 apples and 3 oranges\", 100) -> 100 - 2 - 3 = 95\n    fruit_distribution(\"100 apples and 1 oranges\",120) -> 120 - 100 - 1 = 19\n    \"\"\"\n    parser = FruitStringParser()\n    fruit_counts = parser.parse(s)\n    \n    total_apples_oranges = fruit_counts.apples + fruit_counts.oranges\n    mango_fruits = n - total_apples_oranges\n    \n    return mango_fruits"}
{"task_id": "HumanEval/66", "solution": "def digitSum(s):\n    \"\"\"Task\n    Write a function that takes a string as input and returns the sum of the upper characters only'\n    ASCII codes.\n\n    Examples:\n        digitSum(\"\") => 0\n        digitSum(\"abAB\") => 131\n        digitSum(\"abcCd\") => 67\n        digitSum(\"helloE\") => 69\n        digitSum(\"woArBld\") => 131\n        digitSum(\"aAaaaXa\") => 153\n    \"\"\"\n    total_sum = 0\n    for char in s:\n        # Check if the character's ASCII value is within the range for uppercase letters (A-Z).\n        char_code = ord(char)\n        if 65 <= char_code <= 90:\n            total_sum += char_code\n    return total_sum"}
{"task_id": "HumanEval/64", "solution": "def vowels_count(s):\n    \"\"\"Counts the number of vowels in a word, including 'y' at the end.\n    Vowels are 'a', 'e', 'i', 'o', 'u', case-insensitive.\n    \"\"\"\n    from unicodedata import normalize\n\n    VOWELS = frozenset({'a', 'e', 'i', 'o', 'u'})\n\n    normalized_s = normalize(\"NFC\", s).strip()\n    lower_s = normalized_s.lower()\n    count = 0\n\n    for i, char in enumerate(lower_s):\n        if char in VOWELS:\n            count += 1\n        elif char == 'y' and i == len(lower_s) - 1:\n            count += 1\n    return count"}
{"task_id": "HumanEval/71", "solution": "import math\n\ndef triangle_area(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle. Return the area of\n    the triangle rounded to 2 decimal points if the three sides form a valid triangle. \n    Otherwise return -1\n    Three sides make a valid triangle when the sum of any two sides is greater \n    than the third side.\n    Example:\n    triangle_area(3, 4, 5) == 6.00\n    triangle_area(1, 2, 10) == -1\n    '''\n    \n    try:\n        a_f = float(a)\n        b_f = float(b)\n        c_f = float(c)\n    except (TypeError, ValueError):\n        return -1\n\n    if a_f <= 0 or b_f <= 0 or c_f <= 0:\n        return -1\n\n    if not ((a_f + b_f > c_f) and (a_f + c_f > b_f) and (b_f + c_f > a_f)):\n        return -1\n\n    s = (a_f + b_f + c_f) / 2.0\n    val = s * (s - a_f) * (s - b_f) * (s - c_f)\n\n    # Use EPSILON to handle potential floating point inaccuracies for 'val'.\n    # If val is significantly negative, it indicates an invalid triangle.\n    EPSILON = 1e-12\n    if val < -EPSILON:\n        return -1\n\n    # Calculate area, ensuring the value under the square root is non-negative.\n    area = math.sqrt(max(val, 0.0))\n\n    return round(area, 2)"}
{"task_id": "HumanEval/72", "solution": "def will_it_fly(q,w):\n    '''\n    Checks if object q will fly. It flies if balanced (palindromic list) and\n    the sum of its elements is less than or equal to the maximum weight w.\n    '''\n    is_balanced = (q == q[::-1])\n    total_weight = sum(q)\n    weight_ok = (total_weight <= w)\n    \n    return is_balanced and weight_ok"}
{"task_id": "HumanEval/75", "solution": "def is_multiply_prime(a):\n    \"\"\"Write a function that returns true if the given number is the multiplication of 3 prime numbers\n    and false otherwise.\n    Knowing that (a) is less then 100.\n    Example:\n    is_multiply_prime(30) == True\n    30 = 2 * 3 * 5\n    \"\"\"\n    factors = []\n    temp_a = a\n    d = 2\n    while d * d <= temp_a:\n        while temp_a % d == 0:\n            factors.append(d)\n            temp_a //= d\n        if d == 2:\n            d = 3\n        else:\n            d += 2\n    if temp_a > 1:\n        factors.append(temp_a)\n\n    return len(factors) == 3"}
{"task_id": "HumanEval/73", "solution": "def smallest_change(arr):\n    \"\"\"\n    Calculates the minimum number of elements that need to be changed to make the array palindromic.\n    This is determined by counting mismatches between symmetric pairs of elements.\n    \"\"\"\n    n = len(arr)\n    mismatches = 0\n    for i in range(n // 2):\n        if arr[i] != arr[n - 1 - i]:\n            mismatches += 1\n    return mismatches"}
{"task_id": "HumanEval/78", "solution": "def hex_key(num):\n    \"\"\"Counts the number of hexadecimal digits in a string that are prime numbers.\n    Prime hexadecimal digits are 2, 3, 5, 7, B (decimal 11), and D (decimal 13).\n    \"\"\"\n    prime_values = {2, 3, 5, 7, 11, 13}\n    count = 0\n    for char in num:\n        if '0' <= char <= '9':\n            val = ord(char) - ord('0')\n        else: # Assumed to be 'A' through 'F' due to input constraints\n            val = 10 + (ord(char) - ord('A'))\n        \n        if val in prime_values:\n            count += 1\n    return count"}
