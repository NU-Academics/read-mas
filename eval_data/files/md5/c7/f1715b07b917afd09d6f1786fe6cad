{"task_id": "HumanEval/91", "solution": "import re\n\ndef is_bored(S):\n    \"\"\"\n    You'll be given a string of words, and your task is to count the number\n    of boredoms. A boredom is a sentence that starts with the word \"I\".\n    Sentences are delimited by '.', '?' or '!'.\n   \n    For example:\n    >>> is_bored(\"Hello world\")\n    0\n    >>> is_bored(\"The sky is blue. The sun is shining. I love this weather\")\n    1\n    \"\"\"\n    boredom_count = 0\n    \n    # Split the input string into potential sentences using one or more sentence delimiters.\n    # re.split handles multiple delimiters in a row and captures the text segments between them.\n    sentences_raw = re.split(r'[.?!]+', S)\n    \n    for sentence_str in sentences_raw:\n        # Trim leading/trailing whitespace from the potential sentence.\n        trimmed_sentence = sentence_str.strip()\n        \n        # An empty string after trimming means it was just whitespace or a series of delimiters,\n        # so it's not a valid sentence to check.\n        if not trimmed_sentence:\n            continue\n            \n        # Split the trimmed sentence by whitespace to get individual words.\n        # str.split() without arguments handles multiple spaces correctly.\n        words = trimmed_sentence.split()\n        \n        # If there are words in the sentence, check the first one.\n        if words:\n            first_word = words[0]\n            # A \"boredom\" is a sentence that starts with the exact word \"I\" (case-sensitive).\n            if first_word == \"I\":\n                boredom_count += 1\n                \n    return boredom_count"}
{"task_id": "HumanEval/93", "solution": "def encode(message):\n    \"\"\"\n    Encodes a message by swapping case of all letters and replacing vowels with the letter 2 places ahead.\n    Assumes only letters and spaces in the message.\n    \"\"\"\n    VOWELS_LOWER = \"aeiou\"\n    ALPHABET_LOWER = \"abcdefghijklmnopqrstuvwxyz\"\n\n    def is_vowel(ch: str) -> bool:\n        \"\"\"Checks if a character is a vowel (a, e, i, o, u) case-insensitively.\"\"\"\n        return ch.lower() in VOWELS_LOWER\n\n    def shift_char(ch: str, offset: int) -> str:\n        \"\"\"Shifts an alphabetic character by an offset, wrapping around and preserving case.\"\"\"\n        is_upper = ch.isupper()\n        lower_ch = ch.lower()\n        idx = ALPHABET_LOWER.index(lower_ch)\n        new_idx = (idx + offset) % 26\n        shifted_lower_ch = ALPHABET_LOWER[new_idx]\n        return shifted_lower_ch.upper() if is_upper else shifted_lower_ch\n\n    result_chars = []\n    for char in message:\n        if char == ' ':\n            result_chars.append(' ')\n            continue\n\n        # Determine if the original character was a vowel\n        is_original_vowel = is_vowel(char)\n\n        # Swap case of the current letter\n        swapped_char = char.swapcase()\n\n        if is_original_vowel:\n            # If original was a vowel, shift the swapped-case character 2 places ahead\n            transformed_char = shift_char(swapped_char, 2)\n            result_chars.append(transformed_char)\n        else:\n            # If not a vowel, just append the swapped-case character\n            result_chars.append(swapped_char)\n\n    return \"\".join(result_chars)"}
{"task_id": "HumanEval/94", "solution": "def skjkasdkd(lst):\n    \"\"\"You are given a list of integers.\n    You need to find the largest prime value and return the sum of its digits.\n    \"\"\"\n    def is_prime(n):\n        if n < 2:\n            return False\n        if n == 2:\n            return True\n        if n % 2 == 0:\n            return False\n        i = 3\n        while i * i <= n:\n            if n % i == 0:\n                return False\n            i += 2\n        return True\n\n    def sum_digits(n):\n        return sum(int(d) for d in str(abs(n)))\n\n    largest_prime = None\n\n    for num in lst:\n        if is_prime(num):\n            if largest_prime is None or num > largest_prime:\n                largest_prime = num\n\n    if largest_prime is None:\n        return 0\n    else:\n        return sum_digits(largest_prime)"}
{"task_id": "HumanEval/95", "solution": "def check_dict_case(dict):\n    \"\"\"\n    Given a dictionary, return True if all keys are strings in lower \n    case or all keys are strings in upper case, else return False.\n    \"\"\"\n    if not dict:\n        return False\n\n    is_all_lower = True\n    is_all_upper = True\n    \n    for key in dict.keys():\n        if not isinstance(key, str):\n            return False\n        \n        if key != key.lower():\n            is_all_lower = False\n        \n        if key != key.upper():\n            is_all_upper = False\n            \n    return is_all_lower or is_all_upper"}
