{"task_id": "HumanEval/44", "solution": "def change_base(x: int, base: int):\n    \"\"\"Change numerical base of input number x to base.\n    return string representation after the conversion.\n    base numbers are less than 10.\n    >>> change_base(8, 3)\n    '22'\n    >>> change_base(8, 2)\n    '1000'\n    >>> change_base(7, 2)\n    '111'\n    \"\"\"\n    if x == 0:\n        return \"0\"\n\n    digits = []\n    while x > 0:\n        remainder = x % base\n        digits.append(str(remainder))\n        x //= base\n    \n    return ''.join(reversed(digits))"}
{"task_id": "HumanEval/47", "solution": "def median(l: list):\n    \"\"\"Return median of elements in the list l.\n    >>> median([3, 1, 2, 4, 5])\n    3\n    >>> median([-10, 4, 6, 1000, 10, 20])\n    15.0\n    \"\"\"\n    sorted_l = sorted(l)\n    n = len(sorted_l)\n\n    # For an odd number of elements, the median is the middle element.\n    if n % 2 == 1:\n        return sorted_l[n // 2]\n    # For an even number of elements, the median is the average of the two middle elements.\n    else:\n        mid1 = sorted_l[n // 2 - 1]\n        mid2 = sorted_l[n // 2]\n        return (mid1 + mid2) / 2"}
{"task_id": "HumanEval/45", "solution": "def triangle_area(a, h):\n    \"\"\"Given length of a side and high return area for a triangle.\n    >>> triangle_area(5, 3)\n    7.5\n    \"\"\"\n    class AppError(Exception):\n        def __init__(self, message: str) -> None:\n            self.message = message\n            super().__init__(message)\n\n    class ValidationError(AppError):\n        def __init__(self, message: str, field_errors: dict | None = None) -> None:\n            super().__init__(message)\n            self.field_errors = field_errors if field_errors is not None else {}\n\n    MAX_VALUE = 1e12 # Safety cap for inputs\n\n    errors = {}\n    a_f = None\n    h_f = None\n\n    try:\n        a_f = float(a)\n    except (ValueError, TypeError):\n        errors['a'] = \"must be a number\"\n    \n    try:\n        h_f = float(h)\n    except (ValueError, TypeError):\n        errors['h'] = \"must be a number\"\n\n    if 'a' not in errors:\n        # Check non-negative, finite (not NaN, not too large/infinite)\n        if a_f < 0 or not (a_f == a_f) or abs(a_f) > MAX_VALUE:\n            errors['a'] = \"must be finite, non-negative, and less than MAX_VALUE\"\n    \n    if 'h' not in errors:\n        # Check non-negative, finite (not NaN, not too large/infinite)\n        if h_f < 0 or not (h_f == h_f) or abs(h_f) > MAX_VALUE:\n            errors['h'] = \"must be finite, non-negative, and less than MAX_VALUE\"\n            \n    if errors:\n        raise ValidationError(\"Invalid triangle inputs\", field_errors=errors)\n\n    # Perform the area calculation after successful validation\n    area = 0.5 * a_f * h_f\n    return area"}
{"task_id": "HumanEval/46", "solution": "def fib4(n: int):\n    \"\"\"The Fib4 number sequence is a sequence similar to the Fibbonacci sequnece that's defined as follows:\n    fib4(0) -> 0\n    fib4(1) -> 0\n    fib4(2) -> 2\n    fib4(3) -> 0\n    fib4(n) -> fib4(n-1) + fib4(n-2) + fib4(n-3) + fib4(n-4).\n    Please write a function to efficiently compute the n-th element of the fib4 number sequence.  Do not use recursion.\n    >>> fib4(5)\n    4\n    >>> fib4(6)\n    8\n    >>> fib4(7)\n    14\n    \"\"\"\n    if n == 0:\n        return 0\n    if n == 1:\n        return 0\n    if n == 2:\n        return 2\n    if n == 3:\n        return 0\n\n    # Initialize the four most recent Fib4 numbers needed for the recurrence.\n    # a, b, c, d correspond to fib4(i-4), fib4(i-3), fib4(i-2), fib4(i-1) respectively.\n    # For the first iteration (i=4), these are fib4(0), fib4(1), fib4(2), fib4(3).\n    a, b, c, d = 0, 0, 2, 0\n\n    # Iterate from n=4 up to the target n, updating the window of values.\n    for i in range(4, n + 1):\n        next_fib = d + c + b + a\n        # Shift the window to prepare for the next iteration:\n        # The oldest value 'a' is dropped, and 'next_fib' becomes the newest.\n        a, b, c, d = b, c, d, next_fib\n    \n    # At the end of the loop, 'd' holds the value of fib4(n).\n    return d"}
