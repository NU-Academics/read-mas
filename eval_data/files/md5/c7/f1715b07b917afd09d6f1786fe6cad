{"task_id": "HumanEval/84", "solution": "def solve(N):\n    \"\"\"Given a positive integer N, return the total sum of its digits in binary.\n    \"\"\"\n    \n    # Calculate the sum of decimal digits of N\n    digit_sum = 0\n    if N == 0:\n        digit_sum = 0\n    else:\n        temp_N = N\n        while temp_N > 0:\n            digit_sum += temp_N % 10\n            temp_N //= 10\n            \n    # Convert the digit_sum to its binary string representation.\n    # The `bin()` function returns a string with a \"0b\" prefix, which is sliced off.\n    # If the digit_sum is 0, return \"0\" as per requirements.\n    if digit_sum == 0:\n        return \"0\"\n    else:\n        return bin(digit_sum)[2:]"}
{"task_id": "HumanEval/86", "solution": "def anti_shuffle(s):\n    \"\"\"\n    Write a function that takes a string and returns an ordered version of it.\n    Ordered version of string, is a string where all words (separated by space)\n    are replaced by a new word where all the characters arranged in\n    ascending order based on ascii value.\n    Note: You should keep the order of words and blank spaces in the sentence.\n    \"\"\"\n    import re\n\n    class Tokenizer:\n        def __init__(self) -> None:\n            # Regex pattern to split by whitespace and keep the whitespace itself as a token.\n            self._whitespace_pattern = r'(\\s+)'\n\n        def tokenize(self, text: str) -> list[str]:\n            # Use re.split with a capturing group to include delimiters in the result.\n            # Filter out any empty strings that might result from leading/trailing or consecutive delimiters.\n            return [t for t in re.split(self._whitespace_pattern, text) if t]\n\n        def is_whitespace_token(self, token: str) -> bool:\n            # Checks if a token consists entirely of whitespace characters.\n            return token.isspace()\n\n    class Sorter:\n        def __init__(self) -> None:\n            # The key function for sorting characters based on their Unicode ordinal value.\n            self._key_function = lambda ch: ord(ch)\n\n        def sort_token(self, token: str) -> str:\n            # Sorts the characters of a given token and joins them back into a string.\n            return ''.join(sorted(token, key=self._key_function))\n\n    class AntiShuffleService:\n        def __init__(self, tokenizer: Tokenizer, sorter: Sorter) -> None:\n            self._tokenizer = tokenizer\n            self._sorter = sorter\n\n        def transform(self, text: str) -> str:\n            # Orchestrates the tokenization, sorting, and reassembly of the string.\n            tokens = self._tokenizer.tokenize(text)\n            out_tokens = []\n            for t in tokens:\n                if self._tokenizer.is_whitespace_token(t):\n                    out_tokens.append(t)\n                else:\n                    out_tokens.append(self._sorter.sort_token(t))\n            return ''.join(out_tokens)\n\n    # Instantiate the necessary components and perform the string transformation.\n    tokenizer_instance = Tokenizer()\n    sorter_instance = Sorter()\n    service = AntiShuffleService(tokenizer_instance, sorter_instance)\n    return service.transform(s)"}
{"task_id": "HumanEval/87", "solution": "def get_row(lst, x):\n    \"\"\"\n    Finds integer x in the 2D list and returns coordinates (row, column).\n    Coordinates are sorted by row ascending, then by column descending.\n    \"\"\"\n    matches_by_row = {}\n    for r_idx, row_list in enumerate(lst):\n        for c_idx, value in enumerate(row_list):\n            if value == x:\n                matches_by_row.setdefault(r_idx, []).append(c_idx)\n\n    result_coordinates = []\n    for r_idx in sorted(matches_by_row.keys()):\n        # Sort columns in descending order for the current row\n        sorted_cols = sorted(matches_by_row[r_idx], reverse=True)\n        for c_idx in sorted_cols:\n            result_coordinates.append((r_idx, c_idx))\n\n    return result_coordinates"}
{"task_id": "HumanEval/89", "solution": "def encrypt(s):\n    \"\"\"Encrypts a string by rotating the alphabet by a shift of 4 positions, preserving case and non-alphabetic characters.\"\"\"\n    encrypted_chars = []\n    shift_amount = 4 \n    for char in s:\n        if 'A' <= char <= 'Z':\n            base = ord('A')\n            encrypted_char_code = (ord(char) - base + shift_amount) % 26 + base\n            encrypted_chars.append(chr(encrypted_char_code))\n        elif 'a' <= char <= 'z':\n            base = ord('a')\n            encrypted_char_code = (ord(char) - base + shift_amount) % 26 + base\n            encrypted_chars.append(chr(encrypted_char_code))\n        else:\n            encrypted_chars.append(char)\n    return \"\".join(encrypted_chars)"}
{"task_id": "HumanEval/88", "solution": "def sort_array(array):\n    \"\"\"\n    Given an array of non-negative integers, return a copy of the given array after sorting,\n    you will sort the given array in ascending order if the sum( first index value, last index value) is odd,\n    or sort it in descending order if the sum( first index value, last index value) is even.\n    \"\"\"\n    if not array:\n        return []\n\n    # Create a copy to ensure the original array is not modified\n    array_copy = list(array)\n\n    # Determine the sorting order based on the sum of the first and last elements\n    # This correctly handles single-element arrays where first_element == last_element\n    first_element = array[0]\n    last_element = array[-1]\n    total_sum = first_element + last_element\n\n    if total_sum % 2 != 0:  # Sum is odd, sort in ascending order\n        array_copy.sort()\n    else:  # Sum is even, sort in descending order\n        array_copy.sort(reverse=True)\n\n    return array_copy"}
