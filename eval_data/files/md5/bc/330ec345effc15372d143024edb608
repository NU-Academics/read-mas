()\n\n    result_words = []\n    for word_obj in words:\n        consonant_count = word_obj.count_consonants(consonant_checker)\n        if consonant_count == n:\n            result_words.append(word_obj.value)\n\n    return result_words", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/118": [{"task_id": "HumanEval/118", "solution": "def get_closest_vowel(word):\n    \"\"\"You are given a word. Your task is to find the closest vowel that stands between \n    two consonants from the right side of the word (case sensitive).\n    \n    Vowels in the beginning and ending doesn't count. Return empty string if you didn't\n    find any vowel met the above condition. \n\n    You may assume that the given string contains English letter only.\n\n    Example:\n    get_closest_vowel(\"yogurt\") ==> \"u\"\n    get_closest_vowel(\"FULL\") ==> \"U\"\n    get_closest_vowel(\"quick\") ==> \"\"\n    get_closest_vowel(\"ab\") ==> \"\"\n    \"\"\"\n    \n    def _is_vowel(char):\n        \"\"\"Checks if a character is an English vowel, case-sensitively.\"\"\"\n        return char in \"aeiouAEIOU\"\n\n    def _is_consonant(char):\n        \"\"\"Checks if a character is an English consonant, case-sensitively.\"\"\"\n        return char.isalpha() and not _is_vowel(char)\n\n    n = len(word)\n    if n < 3:  # Need at least three characters: consonant, vowel, consonant\n        return \"\"\n\n    # Iterate from right to left, excluding the first and last characters\n    for i in range(n - 2, 0, -1):\n        current_char = word[i]\n        \n        if _is_vowel(current_char):\n            left_char = word[i-1]\n            right_char = word[i+1]\n            \n            if _is_consonant(left_char) and _is_consonant(right_char):\n                return current_char\n                \n    return \"\"", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/119": [{"task_id": "HumanEval/119", "solution": "def match_parens(lst):\n    '''\n    Checks if two strings of parentheses can be concatenated to form a balanced string.\n    Returns 'Yes' if possible, 'No' otherwise.\n    '''\n\n    def _is_balanced(s: str) -> bool:\n        \"\"\"Checks if a given string of parentheses is balanced.\"\"\"\n        balance = 0\n        for char in s:\n            if char == '(':\n                balance += 1\n            else:  # char == ')'\n                balance -= 1\n            if balance < 0:\n                return False\n        return balance == 0\n\n    def _validate_input(input_list: list) -> tuple[str, str]:\n        \"\"\"Validates the input list structure and content.\"\"\"\n        if not isinstance(input_list, list) or len(input_list) != 2:\n            raise ValueError(\"Input must be a list of exactly two strings.\")\n        \n        s1, s2 = input_list[0], input_list[1]\n\n        if not isinstance(s1, str) or not isinstance(s2, str):\n            raise ValueError(\"All elements in the list must be strings.\")\n\n        valid_chars = {'(', ')'}\n        for char in s1:\n            if char not in valid_chars:\n                raise ValueError(f\"Invalid character '{char}' in the first string.\")\n        for char in s2:\n            if char not in valid_chars:\n                raise ValueError(f\"Invalid character '{char}' in the second string.\")\n                \n        return s1, s2\n\n    str1, str2 = _validate_input(lst)\n\n    # Check concatenation order 1: str1 + str2\n    if _is_balanced(str1 + str2):\n        return 'Yes'\n    \n    # Check concatenation order 2: str2 + str1\n    if _is_balanced(str2 + str1):\n        return 'Yes'\n    \n    return 'No'", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/121": [{"task_id": "HumanEval/121", "solution": "def solution(lst):\n    \"\"\"Given a non-empty list of integers, return the sum of all of the odd elements that are in e