ers.\n    '''\n    def _check_ascending_order(numbers):\n        \"\"\"Checks if a list of numbers is sorted in ascending order.\"\"\"\n        for i in range(len(numbers) - 1):\n            if numbers[i] > numbers[i+1]:\n                return False\n        return True\n\n    def _check_excessive_duplicates(numbers):\n        \"\"\"Checks if any number in a list appears more than twice.\"\"\"\n        counts = Counter(numbers)\n        for count in counts.values():\n            if count > 2:  # More than 1 duplicate means 3 or more occurrences\n                return True\n        return False\n\n    if not _check_ascending_order(lst):\n        return False\n\n    if _check_excessive_duplicates(lst):\n        return False\n\n    return True", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/123": [{"task_id": "HumanEval/123", "solution": "def get_odd_collatz(n):\n    \"\"\"\n    Given a positive integer n, return a sorted list that has the odd numbers in collatz sequence.\n    \"\"\"\n\n    class _CollatzSequenceGenerator:\n        \"\"\"Generates the Collatz sequence for a given positive integer.\"\"\"\n        def __init__(self, initial_value: int):\n            self._initial_value = initial_value\n            self._sequence = []\n\n        def generate(self) -> list[int]:\n            \"\"\"Applies Collatz rules to build and return the complete sequence.\"\"\"\n            current_num = self._initial_value\n            self._sequence.append(current_num)\n\n            while current_num != 1:\n                if current_num % 2 == 0:\n                    current_num //= 2\n                else:\n                    current_num = 3 * current_num + 1\n                self._sequence.append(current_num)\n            return self._sequence\n\n    class _OddNumberCollector:\n        \"\"\"Collects odd numbers and provides them in sorted increasing order.\"\"\"\n        def __init__(self):\n            self._odd_numbers = set()\n\n        def add_if_odd(self, number: int):\n            \"\"\"Checks if a number is odd and adds it to the collection.\"\"\"\n            if number % 2 != 0:\n                self._odd_numbers.add(number)\n\n        def get_sorted_odd_numbers(self) -> list[int]:\n            \"\"\"Sorts the collected odd numbers and returns them as a new list.\"\"\"\n            return sorted(list(self._odd_numbers))\n\n    if n == 1:\n        return [1]\n\n    generator = _CollatzSequenceGenerator(n)\n    collatz_sequence = generator.generate()\n\n    collector = _OddNumberCollector()\n    for number in collatz_sequence:\n        collector.add_if_odd(number)\n\n    return collector.get_sorted_odd_numbers()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/36": [{"task_id": "HumanEval/36", "solution": "def fizz_buzz(n: int):\n    \"\"\"Return the number of times the digit 7 appears in integers less than n which are divisible by 11 or 13.\n    >>> fizz_buzz(50)\n    0\n    >>> fizz_buzz(78)\n    2\n    >>> fizz_buzz(79)\n    3\n    \"\"\"\n\n    def _is_divisible_by_11_or_13(number: int) -> bool:\n        \"\"\"Determines if a number is divisible by 11 or 13.\"\"\"\n        return number % 11 == 0 or number % 13 == 0\n\n    def _count_digit_in_number(number: int, digit: str) -> int:\n        \"\"\"Counts occurrences of a specific digit in the string representation of a number.\"\"\"\n        return str(number).count(digit)\n\n    total_count = 0\n    for i in range(n):\n        if _is_divisible_by_11_or_13(i):\n            total_count += _count_digit_in_number(i, '7')\n    return total_count", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/127": [{"task_id": "HumanEval/127", "solution": "class Interval:\n    \"\"\"Represents a closed integer interval (start, end).\"\"\"\n    def __init__(self, start: int, end: int):\n        self._start = start\n        self._end = end\n\n    def get_start(self) -> int:\n        return self._start\n\n    def get_end(self) -> int:\n        return self._end\n\n    def get_length(self) -> int:\n        return self._end - self._start + 1\nclass PrimeChecker:\n    \"\"\"Provides functionality to check if a number is prime.\"\"\"\n\n    @staticmethod\n    def is_prime(number: int) -> bool:\n        if number <= 1:\n            return False\n        if number <= 3:\n            return True\n        if number % 2 == 0 or number % 3 == 0:\n            return False\n        i = 5\n        while i * i <= number:\n            if number % i == 0 or number % (i + 2) == 0:\n                return False\n            i += 6\n        return True\ndef intersection(interval1, interval2):\n    \"\"\"You are given two intervals,\n    where each interval is a pair of integers. For example, interval = (start, end) = (1, 2).\n    The given intervals are closed which means that the interval (start, end)\n    includes both start and end.\n    For each given interval, it is assumed that its start is less or equal its end.\n    Your task is to determine whether the length of intersection of these two \n    intervals is a prime number.\n    Example, the intersection of the intervals (1, 3), (2, 4) is (2, 3)\n    which its length is 1, which not a prime number.\n    If the length of the intersection is a prime number, return \"YES\",\n    otherwise, return \"NO\".\n    If the two intervals don't intersect, return \"NO\".\n\n\n    [input/output] samples:\n    intersection((1, 2), (2, 3)) ==> \"NO\"\n    intersection((-1, 1), (0, 4)) ==> \"NO\"\n    intersection((-3, -1), (-5, 5)) ==> \"YES\"\n    \"\"\"\n    s1, e1 = interval1\n    s2, e2 = interval2\n\n    intersection_start = max(s1, s2)\n    intersection_end = min(e1, e2)\n\n    if intersection_start > intersection_end:\n        return \"NO\"\n\n    intersection_interval = Interval(intersection_start, intersection_end)\n    length = intersection_interval.get_length()\n\n    is_prime_result = PrimeChecker.is_prime(length)\n\n    if is_prime_result:\n        return \"YES\"\n    else:\n        return \"NO\"", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[[-1, 1], [0, 4]]], "plus_fail_tests": [[[10, 20], [15, 25]]]}], "HumanEval/125": [{"task_id": "HumanEval/125", "solution": "def split_words(txt):\n    '''\n    Given a string of words, return a list of words split on whitespace, if no whitespaces exists in the text you\n    should split on commas ',' if no commas exists you should return the number of lower-case letters with odd order in the\n    alphabet, ord('a') = 0, ord('b') = 1, ... ord('z') = 25\n    Examples\n    split_words(\"Hello world!\") \u279e [\"Hello\", \"world!\"]\n    split_words(\"Hello,world!\") \u279e [\"Hello\", \"world!\"]\n    split_words(\"abcdef\") == 3 \n    '''\n\n    def _contains_whitespace(text):\n        \"\"\"Checks if the input string contains any whitespace characters.\"\"\"\n        return any(c.isspace() for c in text)\n\n    def _contains_comma(text):\n        \"\"\"Checks if the input string contains any comma characters.\"\"\"\n        return ',' in text\n\n    def _split_by_whitespace(text):\n        \"\"\"Splits the input string into a list of words using whitespace.\"\"\"\n        return text.split()\n\n    def _split_by_comma(text):\n        \"\"\"Splits the input string into a list of words using commas.\"\"\"\n        return text.split(',')\n\n    def _count_odd_ordered_lowercase_letters(text):\n        \"\"\"Counts lowercase letters with an odd 0-indexed alphabetical order.\"\"\"\n        count = 0\n        for char in text:\n            if 'a' <= char <= 'z':\n                order = ord(char) - ord('a')\n                if order % 2 != 0:\n                    count += 1\n        return count\n\n    if _contains_whitespace(txt):\n        return _split_by_whitespace(txt)\n    elif _contains_comma(txt):\n        return _split_by_comma(txt)\n    else:\n        return _count_odd_ordered_lowercase_letters(txt)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/131": [{"task_id": "HumanEval/131", "solution": "def digits(n):\n    \"\"\"Given a positive integer n, return the product of the odd digits.\n    Return 0 if all digits are even.\n    For example:\n    digits(1)  == 1\n    digits(4)  == 0\n    digits(235) == 15\n    \"\"\"\n    product_of_odd_digits = 1\n    found_odd_digit = False\n\n    # Convert the number to a string to easily iterate through its digits.\n    for char_digit in str(n):\n        digit = int(char_digit)\n        if digit % 2 != 0:  # Check if the digit is odd.\n            product_of_odd_digits *= digit\n            found_odd_digit = True\n\n    if not found_odd_digit:\n        return 0\n    else:\n        return product_of_odd_digits", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/133": [{"task_id": "HumanEval/133", "solution": "import math\ndef sum_squares(lst):\n    \"\"\"You are given a list of numbers.\n    You need to return the sum of squared numbers in the given list,\n    round each element in the list to the upper int(Ceiling) first.\n    \"\"\"\n    total_sum = 0\n    for number in lst:\n        rounded_number = math.ceil(number)\n        squared_number = rounded_number * rounded_number\n        total_sum += squared_number\n    return total_sum", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/128": [{"task_id": "HumanEval/128", "solution": "def prod_signs(arr):\n    \"\"\"\n    Calculates the sum of magnitudes multiplied by the product of signs for an array of integers.\n    Returns None for an empty array.\n    \"\"\"\n    if not arr:\n        return None\n\n    sum_magnitudes = 0\n    product_signs = 1\n\n    for num in arr:\n        sum_magnitudes += abs(num)\n\n        if num > 0:\n            current_sign = 1\n   