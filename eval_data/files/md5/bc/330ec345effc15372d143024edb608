erty\n    def length(self) -> int:\n        return len(self._value)\n\n    def get_characters(self) -> list[str]:\n        \"\"\"Returns a list of individual characters within the substring.\"\"\"\n        return list(self._value)\n\n    def are_characters_distinct(self) -> bool:\n        \"\"\"Checks if all characters in the substring are unique.\"\"\"\n        return len(set(self._value)) == self.length\ndef is_happy(s):\n    \"\"\"Checks if the input string s is \"happy\" according to the defined rules.\n    A string is happy if its length is at least 3 and every 3 consecutive letters are distinct.\n    \"\"\"\n    string_obj = String(s)\n\n    if string_obj.length < 3:\n        return False\n\n    for i in range(string_obj.length - 2):\n        substring_obj = string_obj.get_substring(i, i + 3)\n        if not substring_obj.are_characters_distinct():\n            return False\n\n    return True", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/82": [{"task_id": "HumanEval/82", "solution": "def prime_length(string):\n    \"\"\"Write a function that takes a string and returns True if the string\n    length is a prime number or False otherwise\n    Examples\n    prime_length('Hello') == True\n    prime_length('abcdcba') == True\n    prime_length('kittens') == True\n    prime_length('orange') == False\n    \"\"\"\n    def _is_prime(number):\n        \"\"\"Checks if a given number is prime.\"\"\"\n        if number < 2:\n            return False\n        if number == 2:\n            return True\n        if number % 2 == 0:\n            return False\n        i = 3\n        while i * i <= number:\n            if number % i == 0:\n                return False\n            i += 2\n        return True\n\n    return _is_prime(len(string))", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/84": [{"task_id": "HumanEval/84", "solution": "def _calculate_digit_sum(number: int) -> int:\n    \"\"\"Calculates the sum of decimal digits of a given number.\"\"\"\n    s = 0\n    if number == 0:\n        return 0\n    while number > 0:\n        s += number % 10\n        number //= 10\n    return s\ndef _to_binary_string(decimal_value: int) -> str:\n    \"\"\"Converts a decimal integer to its binary string representation.\"\"\"\n    if decimal_value == 0:\n        return \"0\"\n    return bin(decimal_value)[2:]\ndef solve(N):\n    \"\"\"Given a positive integer N, return the total sum of its digits in binary.\n    \n    Constraints: 0 <= N <= 10000.\n    Output: a string of binary number.\n    \"\"\"\n    digit_sum = _calculate_digit_sum(N)\n    binary_representation = _to_binary_string(digit_sum)\n    return binary_representation", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/87": [{"task_id": "HumanEval/87", "solution": "def get_row(lst, x):\n    \"\"\"\n    Finds integer x in the nested list and returns a list of coordinates (row, column).\n    Coordinates are sorted by row in ascending order, then by column in descending order.\n    \"\"\"\n    coordinates = []\n    for row_index, current_row in enumerate(lst):\n        for col_index, element in enumerate(current_row):\n            if element == x:\n                coordinates.append((row_index, col_index))\n\n    # Sort primarily by row (ascending) and secondarily by column (descending)\n    coordinates.sort(key=lambda coord: (coord[0], -coord[1]))\n\n    return coordinates", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/81": [{"task_id": "HumanEval/81", "solution": "_GRADING_SCALE = [\n    (4.0, 'A+'),\n    (3.7, 'A'),\n    (3.3, 'A-'),\n    (3.0, 'B+'),\n    (2.7, 'B'),\n    (2.3, 'B-'),\n    (2.0, 'C+'),\n    (1.7, 'C'),\n    (1.3, 'C-'),\n    (1.0, 'D+'),\n    (0.7, 'D'),\n    (0.0, 'D-'),\n]\ndef _convert_single_gpa(gpa: float) -> str:\n    \"\"\"Converts a single numerical GPA to its corresponding letter grade based on the grading scale.\"\"\"\n    if gpa == 4.0:\n        return 'A+'\n    \n    # Iterate through the thresholds from highest to lowest for '>' comparisons.\n    for threshold, grade in _GRADING_SCALE[1:]:\n        if gpa > threshold:\n            return grade\n            \n    # If no 'greater than' condition matched, the GPA is 0.0 or less, which maps to 'E'.\n    return 'E'\ndef numerical_letter_grade(grades):\n    \"\"\"It is the last week of the semester and the teacher has to give the grades\n    to students. The teacher has been making her own algorithm for grading.\n    The only problem is, she has lost the code she used for grading.\n    She has given you a list of GPAs for some students and you have to write \n    a function that can output a list of letter grades using the following table:\n             GPA       |    Letter grade\n              4.0                A+\n            > 3.7                A \n            > 3.3                A- \n            > 3.0                B+\n            > 2.7                B \n            > 2.3                B-\n            > 2.0                C+\n            > 1.7                C\n            > 1.3                C-\n            > 1.0                D+ \n            > 0.7                D \n            > 0.0                D-\n              0.0                E\n    \n\n    Example:\n    grade_equation([4.0, 3, 1.7, 2, 3.5]) ==> ['A+', 'B', 'C-', 'C', 'A-']\n    \"\"\"\n    \n    # Converts each GPA in the input list to its corresponding letter grade.\n    letter_grades = [_convert_single_gpa(gpa) for gpa in grades]\n    return letter_grades", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/85": [{"task_id": "HumanEval/85", "solution": "def add(lst):\n    \"\"\"Given a non-empty list of integers lst. add the even elements that are at odd indices..\n\n\n    Examples:\n        add([4, 2, 6, 7]) ==> 2 \n    \"\"\"\n    total_sum = 0\n    # Iterate through the list with indices to check for odd positions and even elements.\n    for index, element in enumerate(lst):\n        # Check if the current index is odd and the element at that index is even.\n        if index % 2 != 0 and element % 2 == 0:\n            total_sum += element\n    return total_sum", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/86": [{"task_id": "HumanEval/86", "solution": "def anti_shuffle(s):\n    \"\"\"\n    Write a function that takes a string and returns an ordered version of it.\n    Ordered version of string, is a string where all words (separated by space)\n    are replaced by a new word where all the characters arranged in\n    ascending order based on ascii value.\n    Note: You should keep the order of words and blank spaces in the sentence.\n    \"\"\"\n\n    import abc\n\n    class Character:\n        \"\"\"Represents a single character with its string and ASCII integer value.\"\"\"\n        def __init__(self, value: str):\n            self._value = value\n            self._ascii_value = ord(value)\n        def get_value(self) -> str:\n            \"\"\"Returns the character string.\"\"\"\n            return self._value\n        def get_ascii_value(self) -> int:\n            \"\"\"Returns the ASCII integer value of the character.\"\"\"\n            return self._ascii_value\n\n    class Token(abc.ABC):\n        \"\"\"Base class for all tokens, providing common properties.\"\"\"\n        def __init__(self, original_value: str):\n            self._original_value = original_value\n            self._processed_value = original_value\n        def get_processed_value(self) -> str:\n            \"\"\"Returns the processed value of the token.\"\"\"\n            return self._processed_value\n\n    class Word(Token):\n        \"\"\"Represents a word token; its characters are sorted in ascending ASCII order.\"\"\"\n        def __init__(self, original_value: str):\n            super().__init__(original_value)\n            self.sort_characters()\n        def sort_characters(self) -> None:\n            \"\"\"Sorts the characters of the word and updates its processed value.\"\"\"\n            self._processed_value = \"\".join(sorted(list(self._original_value)))\n\n    class SpaceSequence(Token):\n        \"\"\"Represents a sequence of space characters; its value remains unchanged.\"\"\"\n        def __init__(self, original_value: str):\n            super().__init__(original_value)\n\n    class InputString:\n        \"\"\"Manages the input string and provides functionality to tokenize it.\"\"\"\n        def __init__(self, value: str):\n            self._value = value\n        def tokenize(self) -> list[Token]:\n            \"\"\"Splits the input string into a list of Word and SpaceSequence tokens.\"\"\"\n            tokens = []\n            i = 0\n            n = len(self._value)\n            while i < n:\n                if self._value[i].isspace():\n                    start = i\n                    while i < n and self._value[i].isspace():\n                        i += 1\n                    tokens.append(SpaceSequence(self._value[start:i]))\n                else:\n                    start = i\n                    while i < n and not self._value[i].isspace():\n                        i += 1\n                    tokens.append(Word(self._value[start:i]))\n            return tokens\n\n    class OutputString:\n        \"\"\"Reconstructs the final output string from a list of processed tokens.\"\"\"\n        def __init__(self):\n            self._value: list[str] = []\n        def build_from_tokens(self, tokens: list[Token]) -> None:\n            \"\"\"Appends processed token values to build the output string.\"\"\"\n            for token in tokens:\n                self._value.append(token.get_processed_value())\n        def get_value(self) -> str:\n            \"\"\"Returns the complete reconstructed output string.\"\"\"\n            return \"\".join(self._value)\n\n    input_string_obj = InputString(s)\n    tokens = input_string_obj.tokenize()\n\n    output_string_obj = OutputString()\n    output_string_obj.build_from_tokens(tokens)\n\n    return output_string_obj.get_value()", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [["\n\n123 456\n789\n"]]}], "HumanEval/90": [{"task_id": "HumanEval/90", "solution": "def next_smallest(lst):\n    \"\"\"\n    Returns the 2nd smallest distinct element of the list.\n    Returns None if there is no such element.\n    \"\"\"\n    if not lst:\n        return None\n\n    distinct_elements = sorted(list(set(lst)))\n\n    if len(distinct_elements) < 2:\n        return None\n\n    return distinct_elements[1]", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/89": [{"task_id": "HumanEval/89", "solution": "def encrypt(s):\n    \"\"\"Create a function encrypt that takes a string as an argument and\n    returns a string encrypted with the alphabet being rotated. \n    The alphabet should be rotated in a manner such that the letters \n    shift down by two multiplied to two places.\n    \"\"\"\n    ALPHABET_LOWERCASE = 'abcdefghijklmnopqrstuvwxyz'\n    SHIFT_VALUE = 4\n    encrypted_chars = []\n    for char in s:\n        if 'a' <= char <= 'z':\n            original_index = ALPHABET_LOWERCASE.index(char)\n            new_index = (original_index + SHIFT_VALUE) % len(ALPHABET_LOWERCASE)\n            encrypted_chars.append(ALPHABET_LOWERCASE[new_index])\n        else:\n            encrypted_chars.append(char)\n    return \"\".join(encrypted_chars)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/76": [{"task_id": "HumanEval/76", "solution": "def is_simple_power(x, n):\n    \"\"\"Your task is to write a function that returns true if a number x is a simple\n    power of n and false in other cases.\n    x is a simple power of n if n**int=x\n    For example:\n    is_simple_power(1, 4) => true\n    is_simple_power(2, 2) => true\n    is_simple_power(8, 2) => true\n    is_simple_power(3, 2) => false\n    is_simple_power(3, 1) => false\n    is_simple_power(5, 3) => false\n    \"\"\"\n    # If x is 1, it is n raised to the power of 0 (n**0 = 1).\n    if x == 1:\n        return True\n\n    # At this point, x is not 1.\n\n    # If n is 1, 1 raised to any integer power is always 1.\n    # Since x is not 1, it cannot be a simple power of 1.\n    if n == 1:\n        return False\n\n    # If n is 0, 0 raised to a positive integer power is 0.\n    # Since x is not 1, it must be 0 for it to be a simple power of 0 (e.g., 0**1 = 0).\n    if n == 0:\n        return x == 0\n\n    # At this point: x != 1, n != 0, n != 1.\n\n    # Handle negative base (n)\n    if n < 0:\n        # If x is 0, it cannot be a power of a negative number.\n        if x == 0:\n            return False\n\n        abs_n = abs(n)\n        current_x_abs = abs(x)\n        power_count = 0\n\n        # Special case for n == -1 (abs_n == 1)\n        if abs_n == 1: # implies n == -1\n            # (-1)**even_power = 1, (-1)**odd_power = -1.\n            # Since x!=1 is already checked, we only need to check if x is -1.\n            return x == -1\n\n        # Repeatedly divide absolute x by absolute n to find the exponent.\n        while current_x_abs >= abs_n and current_x_abs % abs_n == 0:\n            current_x_abs //= abs_n\n            power_count += 1\n        \n        # If after divisions current_x_abs is 1, then abs(x) was a power of abs(n).\n        if current_x_abs == 1:\n            # Check the sign of x based on the parity of the exponent.\n            if power_count % 2 == 0: # Even power results in a positive number.\n                return x > 0\n            else: # Odd power results in a negative number.\n                return x < 0\n        else:\n            return False\n\n    # At this point: x != 1, n != 0, n != 1, and n is positive (n > 1).\n\n    # If x is non-positive (0 or negative) and n is positive (>1), it cannot be a power.\n    if x <= 0:\n        return False\n        \n    # Now, n > 1 and x > 1.\n    # Repeatedly divide x by n.\n    current_x = x\n    while current_x > 1:\n        # If x is not perfectly divisible by n, it's not an integer power.\n        if current_x % n != 0:\n            return False\n        current_x //= n # Use integer division.\n    \n    # If the loop finishes, current_x must be 1, indicating x was a power of n.\n    return current_x == 1", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/91": [{"task_id": "HumanEval/91", "solution": "import re\ndef is_bored(S):\n    \"\"\"\n    Counts the number of boredom sentences in a given string S.\n    A boredom is a sentence that starts with the word \"I\" (case-sensitive).\n    \"\"\"\n    boredom_count = 0\n    # Split the string by sentence delimiters '.', '?', or '!'.\n    # The regex r\"[.?!]\" removes the delimiters themselves from the resulting fragments.\n    sentences = re.split(r\"[.?!]\", S)\n\n    for sentence_fragment in sentences:\n        # Strip leading/trailing whitespace from the potential sentence fragment.\n        cleaned_sentence = sentence_fragment.strip()\n        \n        # Check if the cleaned fragment is not empty.\n        # A sentence is a \"boredom\" if it starts with \"I \" or is exactly \"I\".\n        if cleaned_sentence and (cleaned_sentence.startswith(\"I \") or cleaned_sentence == \"I\"):\n            boredom_count += 1\n                \n    return boredom_count", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [["I"]]}], "HumanEval/88": [{"task_id": "HumanEval/88", "solution": "def sort_array(array):\n    \"\"\"\n    Given an array of non-negative integers, return a copy of the given array after sorting,\n    you will sort the given array in ascending order if the sum( first index value, last index value) is odd,\n    or sort it in descending order if the sum( first index value, last index value) is even.\n    \"\"\"\n    if not array:\n        return []\n\n    if len(array) == 1:\n        return list(array) # Return a copy for single-element arrays\n\n    first_element = array[0]\n    last_element = array[-1]\n    \n    elements_sum = first_element + last_element\n    \n    if elements_sum % 2 != 0: # Odd sum, sort in ascending order\n        return sorted(array)\n    else: # Even sum, sort in descending order\n        return sorted(array, reverse=True)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/92": [{"task_id": "HumanEval/92", "solution": "def any_int(x, y, z):\n    '''\n    Create a function that takes 3 numbers.\n    Returns true if one of the numbers is equal to the sum of the other two, and all numbers are integers.\n    Returns false in any other cases.\n    '''\n    # Check if all three numbers are integers.\n    # A number is considered an integer if its remainder when divided by 1 is 0.\n    if not (x % 1 == 0 and y % 1 == 0 and z % 1 == 0):\n        return False\n    \n    # If all numbers are integers, check if one is the sum of the other two.\n    return x == y + z or y == x + z or z == x + y", "base_status": "fail", "plus_status": "pass", "base_fail_tests": [[3.0, 4, 7]], "plus_fail_tests": []}], "HumanEval/97": [{"task_id": "HumanEval/97", "solution": "def multiply(a, b):\n    \"\"\"Complete the function that takes two integers and returns \n    the product of their unit digits.\n    Assume the input is always valid.\n    Examples:\n    multiply(148, 412) should return 16.\n    multiply(19, 28) should return 72.\n    multiply(2020, 1851) should return 0.\n    multiply(14,-15) should return 20.\n    \"\"\"\n    def _get_unit_digit(number: int) -> int:\n        \"\"\"Extracts the unit digit of a given integer, handling negative numbers by taking the absolute value.\"\"\"\n        return abs(number) % 10\n\n    unit_digit_a = _get_unit_digit(a)\n    unit_digit_b = _get_unit_digit(b)\n\n    return unit_digit_a * unit_digit_b", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/93": [{"task_id": "HumanEval/93", "solution": "def encode(message):\n    \"\"\"\n    Encodes a message by swapping case of letters and replacing vowels with a letter two places ahead.\n    Assumes only letters in the message.\n    \"\"\"\n    \n    def _is_english_alphabet_letter(char):\n        return 'a' <= char.lower() <= 'z'\n\n    def _is_vowel(char):\n        return char.lower() in 'aeiou'\n\n    def _swap_case(char):\n        if char.islower():\n            return char.upper()\n        else:\n            return char.lower()\n\n    def _get_two_places_ahead_letter(char, original_case_is_upper):\n        if not _is_english_alphabet_letter(char):\n            return char\n        \n        base = ord('A') if original_case_is_upper else ord('a')\n        offset = (ord(char.upper() if original_case_is_upper else char.lower()) - base + 2) % 26\n        return chr(base + offset)\n\n    def _process_character(original_char):\n        if not _is_english_alphabet_letter(original_char):\n            return original_char\n\n        is_original_char_upper = original_char.isupper()\n\n        # Step 1: Swap case\n        case_swapped_char = _swap_case(original_char)\n        \n        # Determine the case for the 'two places ahead' calculation based on the *swapped* character's case.\n        # The design context implies that the final letter (after vowel replacement) should match the case\n        # of the *case-swapped* letter.\n        # Example 'e' -> 'E' (swapped) -> 'G' (2 places ahead, maintaining 'E's case)\n        final_char_case_is_upper = case_swapped_char.isupper()\n\n        # Step 2: Replace vowels\n        if _is_vowel(original_char): # Check