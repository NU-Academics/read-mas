\n    \"\"\"\n    Given two positive integers a and b, return the even digits between a\n    and b, in ascending order.\n\n    For example:\n    generate_integers(2, 8) => [2, 4, 6, 8]\n    generate_integers(8, 2) => [2, 4, 6, 8]\n    generate_integers(10, 14) => []\n    \"\"\"\n    min_val = min(a, b)\n    max_val = max(a, b)\n    result = []\n\n    for num in range(min_val, max_val + 1):\n        if num % 2 == 0:\n            result.append(num)\n    return result", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[2, 10]], "plus_fail_tests": [[6, 12]]}], "HumanEval/159": [{"task_id": "HumanEval/159", "solution": "def eat(number, need, remaining):\n    \"\"\"\n    Calculates the total carrots eaten and remaining carrots after a meal.\n    Returns an array of [total eaten carrots, carrots left].\n    \"\"\"\n    carrots_eaten_current_meal = min(need, remaining)\n    total_eaten_carrots = number + carrots_eaten_current_meal\n    carrots_left = remaining - carrots_eaten_current_meal\n    return [total_eaten_carrots, carrots_left]", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/83": [{"task_id": "HumanEval/83", "solution": "def starts_one_ends(n):\n    if n == 1:\n        return 1\n    else: # n > 1 based on upstream validation\n        return 18 * (10**(n - 2))", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/15": [{"task_id": "HumanEval/15", "solution": "def string_sequence(n: int) -> str:\n    \"\"\" Return a string containing space-delimited numbers starting from 0 upto n inclusive.\n    >>> string_sequence(0)\n    '0'\n    >>> string_sequence(5)\n    '0 1 2 3 4 5'\n    \"\"\"\n    numbers_as_strings = [str(i) for i in range(n + 1)]\n    return \" \".join(numbers_as_strings)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/147": [{"task_id": "HumanEval/147", "solution": "def get_max_triples(n):\n    \"\"\"\n    You are given a positive integer n. You have to create an integer array a of length n.\n        For each i (1 \u2264 i \u2264 n), the value of a[i] = i * i - i + 1.\n        Return the number of triples (a[i], a[j], a[k]) of a where i < j < k, \n    and a[i] + a[j] + a[k] is a multiple of 3.\n\n    Example :\n        Input: n = 5\n        Output: 1\n        Explanation: \n        a = [1, 3, 7, 13, 21]\n        The only valid triple is (1, 7, 13).\n    \"\"\"\n    a = [0] * n\n    for i in range(1, n + 1):\n        a[i-1] = i * i - i + 1\n\n    valid_triples_count = 0\n\n    for i_idx in range(n):\n        for j_idx in range(i_idx + 1, n):\n            for k_idx in range(j_idx + 1, n):\n                val_i = a[i_idx]\n                val_j = a[j_idx]\n                val_k = a[k_idx]\n\n                current_sum = val_i + val_j + val_k\n\n                if current_sum % 3 == 0:\n                    valid_triples_count += 1\n\n    return valid_triples_count", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/130": [{"task_id": "HumanEval/130", "solution": "def tri(n):\n    \"\"\"Computes the first `n + 1` Tribonacci numbers.\n    The sequence is defined by specific recurrence relations for even and odd `n`.\n    \"\"\"\n    # Determine the maximum index we might need to compute.\n    # If n is odd, tri(n) depends on tri(n+1), so we compute up to n+1.\n    # Otherwise, we only need to compute up to n.\n    max_compute_idx = n + 1 if n % 2 != 0 else n\n\n    # Initialize a memoization list to store computed values.\n    # Use None to indicate values that have not yet been computed.\n    memo = [None] * (max_compute_idx + 1)\n\n    # Define a helper function to calculate tri(k) using memoization.\n    def _calculate_tri_value(k_idx):\n        if k_idx < 0: # Should not happen with valid inputs and recurrence relations.\n            return 0 # Or raise an error, but problem implies valid inputs.\n\n        if memo[k_idx] is not None:\n            return memo[k_idx]\n\n        # Base cases explicitly defined or inferred from examples\n        if k_idx == 0:\n            memo[k_idx] = 1\n        elif k_idx == 1:\n            memo[k_idx] = 3\n        elif k_idx % 2 == 0:  # k_idx is even and k_idx > 0\n            # tri(k_idx) = 1 + k_idx / 2. Use integer division for integer results.\n            memo[k_idx] = 1 + k_idx // 2\n        else:  # k_idx is odd and k_idx > 1\n            # tri(k_idx) = tri(k_idx - 1) + tri(k_idx - 2) + tri(k_idx + 1)\n            val_k_minus_1 = _calculate_tri_value(k_idx - 1)\n            val_k_minus_2 = _calculate_tri_value(k_idx - 2)\n            val_k_plus_1 = _calculate_tri_value(k_idx + 1)\n\n            memo[k_idx] = val_k_minus_1 + val_k_minus_2 + val_k_plus_1\n        \n        return memo[k_idx]\n\n    # Populate the memoization list by iterating from 0 up to max_compute_idx.\n    # The recursive calls will handle forward dependencies (like tri(k+1)).\n    for i in range(max_compute_idx + 1):\n        _calculate_tri_value(i)\n\n    # Return the list of Tribonacci numbers from tri(0) up to tri(n).\n    return [memo[i] for i in range(n + 1)]", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/129": [{"task_id": "HumanEval/129", "solution": "def minPath(grid, k):\n    \"\"\"\n    Given a grid with N rows and N columns (N >= 2) and a positive integer k, \n    each cell of the grid contains a value. Every integer in the range [1, N * N]\n    inclusive appears exactly once on the cells of the grid.\n\n    You have to find the minimum path of length k in the grid. You can start\n    from any cell, and in each step you can move to any of the neighbor cells,\n    in other words, you can go to cells which share an edge with you current\n    cell.\n    Please note that a path of length k means visiting exactly k cells (not\n    necessarily distinct).\n    You CANNOT go off the grid.\n    A path A (of length k) is considered less than a path B (of length k) if\n    after making the ordered lists of the values on the cells that A and B go\n    through (let's call them lst_A and lst_B), lst_A is lexicographically less\n    than lst_B, in other words, there exist an integer index i (1 <= i <= k)\n    such that lst_A[i] < lst_B[i] and for any j (1 <= j < i) we have\n    lst_A[j] = lst_B[j].\n    It is guaranteed that the answer is unique.\n    Return an ordered list of the values on the cells that the minimum path go through.\n\n    Examples:\n\n        Input: grid = [ [1,2,3], [4,5,6], [7,8,9]], k = 3\n        Output: [1, 2, 1]\n\n        Input: grid = [ [5,9,3], [4,1,6], [7,8,2]], k = 1\n        Output: [1]\n    \"\"\"\n\n    # --- input_validator functions ---\n    def validate_grid(grid_data: list[list[int]]) -> None:\n        \"\"\"Performs basic validation for grid dimensions, as per problem guarantees.\"\"\"\n        N = len(grid_data)\n        # N >= 2 is guaranteed by problem statement.\n        # Square matrix, unique values [1, N*N] are also guaranteed.\n\n    def validate_k(k_val: int) -> None:\n        \"\"\"Performs basic validation for path length k, as per problem guarantees.\"\"\"\n        # k >= 1 is guaranteed by problem statement.\n\n    # --- Cell class ---\n    class Cell:\n        \"\"\"Represents an immutable grid cell with its coordinates and value.\"\"\"\n        def __init__(self, row: int, col: int, value: int):\n            self.row = row\n            self.col = col\n            self.value = value\n\n    # --- Grid class ---\n    class Grid:\n        \"\"\"Manages the grid structure, provides access to cells and their neighbors.\"\"\"\n        def __init__(self, grid_values: list[list[int]]):\n            self._N = len(grid_values)\n            self._cells = [[None for _ in range(self._N)] for _ in range(self._N)]\n            for r in range(self._N):\n                for c in range(self._N):\n                    self._cells[r][c] = Cell(r, c, grid_values[r][c])\n\n        def get_N(self) -> int:\n            \"\"\"Returns the dimension N of the grid.\"\"\"\n            return self._N\n\n        def get_cell(self, row: int, col: int) -> 'Cell':\n            \"\"\"Returns the Cell object at specified coordinates.\"\"\"\n            return self._cells[row][col]\n\n        def get_neighbors(self, cell: 'Cell') -> list['Cell']:\n            \"\"\"Returns a list of valid neighboring cells for a given cell.\"\"\"\n            neighbors = []\n            r, c = cell.row, cell.col\n            moves = [(0, 1), (0, -1), (1, 0), (-1, 0)]  # Right, Left, Down, Up\n            for dr, dc in moves:\n                nr, nc = r + dr, c + dc\n                if self.is_valid_coordinate(nr, nc):\n                    neighbors.append(self.get_cell(nr, nc))\n            return neighbors\n\n        def is_valid_coordinate(self, row: int, col: int) -> bool:\n            \"\"\"Checks if coordinates are within grid boundaries.\"\"\"\n            return 0 <= row < self._N and 0 <= col < self._N\n\n    # --- Path class ---\n    class Path:\n        \"\"\"Represents a sequence of visited cells, supports adding cells and comparison.\"\"\"\n        def __init__(self, initial_cell: 'Cell'):\n            self._cells_visited = [initial_cell]\n\n        def add_cell(self, cell: 'Cell') -> None:\n            \"\"\"Appends a cell to the path.\"\"\"\n            self._cells_visited.append(cell)\n\n        def get_values(self) -> list[int]:\n            \"\"\"Returns an ordered list of values from cells in the path.\"\"\"\n            return [cell.value for cell in self._cells_visited]\n\n        def __len__(self) -> int:\n            \"\"\"Returns the current length of the path.\"\"\"\n            return len(self._cells_visited)\n\n        def __lt__(self, other: 'Path') -> bool:\n            \"\"\"Implements lexicographical comparison for paths.\"\"\"\n            return self.get_values() < other.get_values()\n\n    # --- path_solver functions ---\n    def find_minimum_path(grid_obj: 'Grid', k_val: int) -> 'Path':\n        \"\"\"Initiates the pathfinding process and returns the minimum path.\"\"\"\n        min_path_container = [None]  # A list to hold the single best path found (by reference)\n\n        def _dfs(current_path: 'Path', current_cell: 'Cell', grid_obj: 'Grid', k_val: int, min_path_container: list['Path']) -> None:\n            \"\"\"Recursive Depth-First Search function to explore paths.\"\"\"\n            if len(current_path) == k_val:\n                # Path has reached desired length, compare and update min_path_container.\n                if min_path_container[0] is None or current_path < min_path_container[0]:\n                    # Create a deep copy of the current_path to store, preventing backtracking modifications.\n                    new_min_path = Path(current_path._cells_visited[0])\n                    for cell in current_path._cells_visited[1:]:\n                        new_min_path.add_cell(cell)\n                    min_path_container[0] = new_min_path\n                return\n\n            # Explore neighbors\n            for neighbor_cell in grid_obj.get_neighbors(current_cell):\n                current_path.add_cell(neighbor_cell)\n                _dfs(current_path, neighbor_cell, grid_obj, k_val, min_path_container)\n                current_path._cells_visited.pop()  # Backtrack: remove last added cell for next path exploration\n\n        # Iterate through all possible starting cells in the grid.\n        N = grid_obj.get_N()\n        for r in range(N):\n            for c in range(N):\n                initial_cell = grid_obj.get_cell(r, c)\n                initial_path = Path(initial_cell)\n                _dfs(initial_path, initial_cell, grid_obj, k_val, min_path_container)\n        \n        return min_path_container[0]\n\n    # --- Main orchestration logic for minPath function ---\n\n    # 1. Input Validation (based on guarantees, no explicit error handling needed).\n    validate_grid(grid)\n    validate_k(k)\n\n    # 2. Grid Model Creation.\n    grid_obj = Grid(grid)\n\n    # 3. Path Solving Logic.\n    min_path_obj = find_minimum_path(grid_obj, k)\n\n    # 4. Extract Path Values for the result.\n    return min_path_obj.get_values()", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[[[12, 13, 10, 1], [9, 3, 15, 6], [5, 16, 14, 4], [11, 8, 7, 2]], 12]], "plus_fail_tests": [[[[1, 2, 3], [4, 5, 6], [7, 8, 9]], 15]]}], "HumanEval/139": [{"task_id": "HumanEval/139", "solution": "def special_factorial(n):\n    \"\"\"The Brazilian factorial is defined as:\n    brazilian_factorial(n) = n! * (n-1)! * (n-2)! * ... * 1!\n    where n > 0\n\n    For example:\n    >>> special_factorial(4)\n    288\n\n    The function will receive an integer as input and should return the special\n    factorial of this integer.\n    \"\"\"\n    def _factorial(k):\n        \"\"\"Calculates the factorial of a non-negative integer k.\"\"\"\n        if k == 0:\n            return 1\n        res = 1\n        for i in range(1, k + 1):\n            res *= i\n        return res\n\n    special_fact_result = 1\n    for i in range(1, n + 1):\n        current_factorial = _factorial(i)\n        special_fact_result *= current_factorial\n    return special_fact_result", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}]}}