{"task_id": "Mbpp/731", "solution": "import math\n\nPI: float = math.pi\n\nclass Cone:\n    \"\"\"Represents a cone and encapsulates its lateral surface area calculation.\"\"\"\n\n    def __init__(self, radius: float, height: float):\n        self._radius: float = float(radius)\n        self._height: float = float(height)\n        self._slant_height: float = 0.0\n        self._lateral_surface_area: float = 0.0\n\n    def calculate_slant_height(self) -> float:\n        \"\"\"Calculates the slant height (l) using l = sqrt(r^2 + h^2).\"\"\"\n        self._slant_height = math.sqrt(self._radius**2 + self._height**2)\n        return self._slant_height\n\n    def calculate_lateral_surface_area(self) -> float:\n        \"\"\"Calculates the lateral surface area (A) using A = pi * r * l.\"\"\"\n        if self._slant_height == 0.0:\n            self.calculate_slant_height()\n        self._lateral_surface_area = PI * self._radius * self._slant_height\n        return self._lateral_surface_area\n\n    def get_lateral_surface_area(self) -> float:\n        \"\"\"Returns the calculated lateral surface area.\"\"\"\n        return self._lateral_surface_area\n\ndef lateralsurface_cone(radius: float, height: float) -> float:\n    \"\"\"Calculates the lateral surface area of a cone given radius r and height h.\n    It creates a Cone object, calculates slant height and lateral surface area.\n    \"\"\"\n    cone = Cone(radius, height)\n    cone.calculate_slant_height()\n    cone.calculate_lateral_surface_area()\n    return cone.get_lateral_surface_area()"}
{"task_id": "Mbpp/735", "solution": "def toggle_middle_bits(number: int) -> int:\n    \"\"\"\n    Toggles all bits of the number except the first (MSB) and the last (LSB) bit.\n    Numbers with 0, 1, or 2 bits are returned unchanged.\n    \"\"\"\n    n_bits = number.bit_length()\n\n    # If the number has 0, 1, or 2 bits, there are no \"middle\" bits to toggle.\n    if n_bits <= 2:\n        return number\n\n    # Calculate the number of middle bits to toggle.\n    # These are all bits excluding the MSB and LSB.\n    num_middle_bits = n_bits - 2\n\n    # Create a mask with '1's for all the middle bit positions.\n    # The mask will have 'num_middle_bits' ones, starting from the second bit (index 1).\n    # ((1 << num_middle_bits) - 1) creates a sequence of 'num_middle_bits' ones.\n    # Shifting it left by 1 places these ones correctly between the MSB and LSB.\n    middle_bits_mask = ((1 << num_middle_bits) - 1) << 1\n\n    # XOR the number with the mask to toggle only the middle bits.\n    # MSB and LSB are preserved because the mask has '0's at those positions.\n    result = number ^ middle_bits_mask\n    return result"}
{"task_id": "Mbpp/736", "solution": "def left_insertion(sorted_list, value):\n    \"\"\"\n    Locates the left insertion point for a specified value in a sorted list using binary search.\n    This function finds the smallest index `i` such that `sorted_list[i] >= value`.\n    \"\"\"\n    low = 0\n    high = len(sorted_list)\n\n    while low < high:\n        mid = (low + high) // 2\n        if sorted_list[mid] < value:\n            low = mid + 1\n        else:\n            high = mid\n    return low"}
