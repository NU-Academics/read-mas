{"task_id": "Mbpp/752", "solution": "def jacobsthal_num(n: int) -> int:\n    \"\"\"Calculates the nth Jacobsthal number using an iterative approach.\n    It follows the recurrence J(n) = J(n-1) + 2 * J(n-2) with base cases J(0)=0 and J(1)=1.\n    \"\"\"\n    if n == 0:\n        return 0\n    elif n == 1:\n        return 1\n    \n    a, b = 0, 1  # J(i-2), J(i-1)\n    for _ in range(2, n + 1):\n        a, b = b, b + 2 * a  # J(i-1), J(i)\n    return b"}
{"task_id": "Mbpp/751", "solution": "def check_min_heap(arr: list) -> bool:\n    \"\"\"Checks if the given array represents a min-heap.\"\"\"\n    n = len(arr)\n    # Iterate only through potential parent nodes (elements with at least one child)\n    for i in range(n // 2):\n        left_child_idx = 2 * i + 1\n        right_child_idx = 2 * i + 2\n\n        # Check left child\n        if left_child_idx < n and arr[i] > arr[left_child_idx]:\n            return False\n\n        # Check right child\n        if right_child_idx < n and arr[i] > arr[right_child_idx]:\n            return False\n\n    return True"}
{"task_id": "Mbpp/754", "solution": "def extract_index_list(list1: list, list2: list, list3: list) -> list:\n    \"\"\"\n    Finds common elements from three lists where an element is common\n    if it appears in all three lists at the same index.\n    \"\"\"\n    common_elements = []\n    min_length = min(len(list1), len(list2), len(list3))\n\n    for i in range(min_length):\n        if list1[i] == list2[i] and list2[i] == list3[i]:\n            common_elements.append(list1[i])\n    return common_elements"}
{"task_id": "Mbpp/753", "solution": "def min_k(tuple_list: list[tuple[str, int]], k: int) -> list[tuple[str, int]]:\n    \"\"\"\n    Finds the minimum k records from a list of tuples, sorted by their second element.\n    Returns an empty list if k is non-positive or the input list is empty.\n    \"\"\"\n    if k <= 0 or not tuple_list:\n        return []\n\n    # Sort the list of tuples based on the second element in ascending order.\n    sorted_records = sorted(tuple_list, key=lambda record: record[1])\n\n    # Return the first k elements from the sorted list.\n    # Python's slice [start:end] handles cases where k is greater than list length gracefully.\n    return sorted_records[:k]"}
{"task_id": "Mbpp/755", "solution": "def second_smallest(numbers: list) -> float:\n    \"\"\"\n    Finds the second smallest number in a list of numbers.\n    Raises ValueError if the list contains fewer than two elements.\n    \"\"\"\n    if len(numbers) < 2:\n        raise ValueError(\"List must contain at least two elements to find the second smallest.\")\n    \n    sorted_numbers = sorted(numbers)\n    return float(sorted_numbers[1])"}
{"task_id": "Mbpp/759", "solution": "import re\n\ndef is_decimal(s: str) -> bool:\n    \"\"\"\n    Checks if the given string represents a decimal number with exactly two digits of precision.\n    This includes numbers with an optional sign, one or more digits, and optionally a decimal point followed by exactly two digits.\n    \"\"\"\n    # The regex matches:\n    # ^[+-]?   -> Optional sign (+ or -) at the start of the string\n    # \\d+      -> One or more digits\n    # (?:\\.\\d{2})? -> An optional non-capturing group for the decimal part:\n    #               \\.   -> A literal decimal point\n    #               \\d{2} -> Exactly two digits\n    # $        -> End of the string\n    pattern = r\"^[+-]?\\d+(?:\\.\\d{2})?$\"\n    return re.fullmatch(pattern, s) is not None"}
{"task_id": "Mbpp/758", "solution": "import collections\nfrom typing import Any, List, Dict, Tuple\n\ndef unique_sublists(input_list: List[List[Any]]) -> Dict[Tuple[Any], int]:\n    \"\"\"\n    Counts occurrences of sublists within a list, converting them to tuples.\n    Returns a dictionary where keys are unique tuples (converted sublists) and values are their respective counts.\n    \"\"\"\n    counts = collections.Counter()\n    for item in input_list:\n        if isinstance(item, list):\n            sublist_as_tuple = tuple(item)\n            counts[sublist_as_tuple] += 1\n    return dict(counts)"}
{"task_id": "Mbpp/757", "solution": "def count_reverse_pairs(string_list: list[str]) -> int:\n    \"\"\"\n    Counts unique pairs of strings where one is the reverse of the other.\n    Each string can be part of at most one pair, and pairs are case-sensitive.\n    \"\"\"\n    processed_strings = set()\n    pairs_found = set()\n\n    for s1 in string_list:\n        if s1 in processed_strings:\n            continue\n\n        s2_reverse = s1[::-1]\n\n        # Check for self-reverse (palindrome)\n        if s1 == s2_reverse:\n            # A palindrome can only form a pair with itself.\n            # If it's already processed, it means we already counted it or it was part of another pair (which it can't be).\n            # If it's not processed, and it's a palindrome, it means it forms a pair with itself.\n            # We add it to processed_strings to avoid double counting it if it appears again.\n            if s1 not in processed_strings:\n                processed_strings.add(s1)\n                # Use a frozenset to store the pair, ensuring uniqueness regardless of order {s1, s2_reverse}\n                pairs_found.add(frozenset({s1, s2_reverse}))\n            continue\n        \n        # Check if its reverse exists in the remaining unprocessed strings\n        # We need to find if s2_reverse exists in the original list *and* hasn't been processed yet\n        if s2_reverse in string_list and s2_reverse not in processed_strings:\n            processed_strings.add(s1)\n            processed_strings.add(s2_reverse)\n            pairs_found.add(frozenset({s1, s2_reverse}))\n\n    return len(pairs_found)"}
