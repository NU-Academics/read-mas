{"task_id": "Mbpp/786", "solution": "def right_insertion(sorted_list: list, value: object) -> int:\n    \"\"\"\n    Locates the right insertion point for a specified value in a sorted list.\n    The new value is placed after any existing equal values.\n    \"\"\"\n    low = 0\n    high = len(sorted_list)\n    while low < high:\n        mid = (low + high) // 2\n        if sorted_list[mid] <= value:\n            low = mid + 1\n        else:\n            high = mid\n    return low"}
{"task_id": "Mbpp/784", "solution": "def mul_even_odd(numbers_list: list[int]) -> int | None:\n    \"\"\"\n    Finds the product of the first even and first odd number in a list.\n    Returns None if either number is not found.\n    \"\"\"\n    first_even = None\n    first_odd = None\n\n    for num in numbers_list:\n        if first_even is None and num % 2 == 0:\n            first_even = num\n        elif first_odd is None and num % 2 != 0:\n            first_odd = num\n\n        if first_even is not None and first_odd is not None:\n            break\n\n    if first_even is not None and first_odd is not None:\n        return first_even * first_odd\n    else:\n        return None"}
