{"task_id": "Mbpp/67", "solution": "_bell_cache = {0: 1, 1: 1} # Initialize with base cases B(0)=1, B(1)=1\n_binom_cache = {}\n\ndef _binomial_coefficient(n: int, k: int) -> int:\n    \"\"\"Calculates the binomial coefficient C(n, k).\"\"\"\n    if k < 0 or k > n:\n        return 0\n    if k == 0 or k == n:\n        return 1\n    if k > n // 2:\n        k = n - k\n\n    if (n, k) in _binom_cache:\n        return _binom_cache[(n, k)]\n\n    res = 1\n    for i in range(k):\n        res = res * (n - i) // (i + 1)\n    _binom_cache[(n, k)] = res\n    return res\n\ndef bell_number(n: int) -> int:\n    \"\"\"Calculates the Bell number B(n) for a given non-negative integer n.\"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"Input 'n' must be an integer.\")\n    if n < 0:\n        raise ValueError(\"Input 'n' must be a non-negative integer.\")\n\n    if n in _bell_cache:\n        return _bell_cache[n]\n\n    current_bell_n = 0\n    for k in range(n):\n        current_bell_n += _binomial_coefficient(n - 1, k) * bell_number(k)\n\n    _bell_cache[n] = current_bell_n\n    return current_bell_n"}
