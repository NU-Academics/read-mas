{"task_id": "Mbpp/721", "solution": "class Cell:\n    \"\"\"Represents a single cell within the matrix, holding its coordinates and cost.\"\"\"\n    def __init__(self, row: int, col: int, cost: int):\n        self.row = row\n        self.col = col\n        self.cost = cost\n\nclass Matrix:\n    \"\"\"Encapsulates the square matrix data, providing methods for accessing individual cells and its dimension.\"\"\"\n    def __init__(self, matrix_data: list[list[int]]):\n        self._N = len(matrix_data)\n        self._cells = [[None for _ in range(self._N)] for _ in range(self._N)]\n        for r in range(self._N):\n            for c in range(self._N):\n                self._cells[r][c] = Cell(r, c, matrix_data[r][c])\n\n    def get_cell(self, row: int, col: int) -> Cell:\n        \"\"\"Returns the Cell object at the specified row and column.\"\"\"\n        return self._cells[row][col]\n\n    def get_dimension(self) -> int:\n        \"\"\"Returns the dimension N of the matrix.\"\"\"\n        return self._N\n\nclass Path:\n    \"\"\"Stores a sequence of Cell objects that form a valid path and calculates its metrics.\"\"\"\n    def __init__(self, sequence_of_cells: list[Cell]):\n        self.sequence_of_cells = sequence_of_cells\n        self.total_cost = sum(cell.cost for cell in sequence_of_cells)\n        self.number_of_cells = len(sequence_of_cells)\n        self.average_cost = self.total_cost / self.number_of_cells if self.number_of_cells > 0 else 0.0\n\ndef _find_paths_recursive(matrix: Matrix, current_row: int, current_col: int, current_path_cells: list[Cell], all_paths: list[Path]) -> None:\n    \"\"\"Recursively explores all valid paths from a given cell to the bottom-right, appending completed Path objects.\"\"\"\n    N = matrix.get_dimension()\n\n    # Add current cell to the path\n    current_path_cells.append(matrix.get_cell(current_row, current_col))\n\n    # Base case: Reached the bottom-right cell\n    if current_row == N - 1 and current_col == N - 1:\n        all_paths.append(Path(list(current_path_cells))) # Create a new Path object with a copy of the current sequence\n        current_path_cells.pop() # Backtrack\n        return\n\n    # Recursive step: Move right\n    if current_col + 1 < N:\n        _find_paths_recursive(matrix, current_row, current_col + 1, current_path_cells, all_paths)\n\n    # Recursive step: Move down\n    if current_row + 1 < N:\n        _find_paths_recursive(matrix, current_row + 1, current_col, current_path_cells, all_paths)\n\n    # Backtrack: Remove current cell for other path explorations\n    current_path_cells.pop()\n\ndef find_max_average_path(matrix_obj: Matrix) -> float:\n    \"\"\"Orchestrates the path finding process, identifies all valid paths, and determines the maximum average.\"\"\"\n    N = matrix_obj.get_dimension()\n    if N == 0:\n        return 0.0\n    \n    all_paths: list[Path] = []\n    _find_paths_recursive(matrix_obj, 0, 0, [], all_paths)\n\n    if not all_paths:\n        return 0.0\n\n    max_avg = 0.0\n    for path in all_paths:\n        if path.average_cost > max_avg:\n            max_avg = path.average_cost\n            \n    return max_avg\n\ndef maxAverageOfPath(matrix_data: list[list[int]]) -> float:\n    \"\"\"Accepts a list of lists of integers representing a matrix and returns the maximum average path cost.\"\"\"\n    if not matrix_data or not matrix_data[0]:\n        return 0.0\n\n    matrix_obj = Matrix(matrix_data)\n    return find_max_average_path(matrix_obj)"}
