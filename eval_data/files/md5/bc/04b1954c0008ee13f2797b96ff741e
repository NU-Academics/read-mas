{"task_id": "Mbpp/558", "solution": "def digit_distance_nums(num1: int, num2: int) -> int:\n    \"\"\"\n    Calculates the sum of absolute differences between corresponding digits of two integers.\n    Shorter numbers are conceptually padded with leading zeros for comparison.\n    \"\"\"\n    str_num1 = str(num1)\n    str_num2 = str(num2)\n\n    max_length = max(len(str_num1), len(str_num2))\n\n    padded_num1 = str_num1.zfill(max_length)\n    padded_num2 = str_num2.zfill(max_length)\n\n    total_difference = 0\n    for i in range(max_length):\n        digit1 = int(padded_num1[i])\n        digit2 = int(padded_num2[i])\n        total_difference += abs(digit1 - digit2)\n\n    return total_difference"}
{"task_id": "Mbpp/555", "solution": "def difference(n: int) -> int:\n    \"\"\"\n    Calculates the difference between the sum of cubes of the first n natural numbers\n    and the sum of the first n natural numbers.\n    \"\"\"\n\n    class NaturalNumber:\n        \"\"\"Encapsulates the natural number input 'n'.\"\"\"\n        def __init__(self, n_value: int):\n            self._value = n_value\n\n        def get_value(self) -> int:\n            \"\"\"Returns the stored natural number value.\"\"\"\n            return self._value\n\n    class SumOfCubesCalculator:\n        \"\"\"Calculates the sum of cubes for the first 'n' natural numbers using a formula.\"\"\"\n        def calculate(self, n_obj: NaturalNumber) -> int:\n            n_val = n_obj.get_value()\n            sum_of_n = n_val * (n_val + 1) // 2\n            return sum_of_n * sum_of_n\n\n    class SumOfNumbersCalculator:\n        \"\"\"Calculates the sum of the first 'n' natural numbers using a formula.\"\"\"\n        def calculate(self, n_obj: NaturalNumber) -> int:\n            n_val = n_obj.get_value()\n            return n_val * (n_val + 1) // 2\n\n    class DifferenceCalculator:\n        \"\"\"Orchestrates sum calculations and computes their difference.\"\"\"\n        def compute(self, n_obj: NaturalNumber) -> int:\n            sum_cubes_calc = SumOfCubesCalculator()\n            sum_cubes = sum_cubes_calc.calculate(n_obj)\n\n            sum_numbers_calc = SumOfNumbersCalculator()\n            sum_numbers = sum_numbers_calc.calculate(n_obj)\n\n            return sum_cubes - sum_numbers\n\n    natural_num_obj = NaturalNumber(n)\n    calculator = DifferenceCalculator()\n    return calculator.compute(natural_num_obj)"}
