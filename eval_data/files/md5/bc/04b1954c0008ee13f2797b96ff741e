{"task_id": "Mbpp/237", "solution": "def check_occurences(tuple_list: list[tuple]) -> dict[tuple, int]:\n    \"\"\"\n    Counts occurrences of normalized tuples in a list, mapping each unique tuple\n    (after sorting its elements) to its frequency.\n    \"\"\"\n    def _normalize_tuple(input_tuple: tuple) -> tuple:\n        \"\"\"Sorts elements within a tuple to create a normalized, comparable tuple.\"\"\"\n        return tuple(sorted(input_tuple))\n\n    counts = {}\n    for current_tuple in tuple_list:\n        normalized_tuple = _normalize_tuple(current_tuple)\n        counts[normalized_tuple] = counts.get(normalized_tuple, 0) + 1\n    return counts"}
{"task_id": "Mbpp/240", "solution": "def replace_list(list1: list, list2: list) -> list:\n    \"\"\"\n    Replaces the last element of list1 with the elements of list2.\n    Returns a new list with the modified structure.\n    \"\"\"\n    if not list1:\n        # AF1: If list1 is empty, return list2 as per the design context.\n        return list2\n\n    # Create a new list containing all elements of list1 except the last one.\n    result_list = list1[:-1]\n\n    # Append all elements from list2 to this new list.\n    result_list.extend(list2)\n\n    return result_list"}
{"task_id": "Mbpp/239", "solution": "def get_total_number_of_sequences(m: int, n: int) -> int:\n    \"\"\"\n    Calculates the total number of possible sequences of length n,\n    where each element is a positive integer and meets the specified criteria.\n    \"\"\"\n    # Base case: If the desired sequence length is 1, any integer from 1 to m is valid.\n    if n == 1:\n        return m\n\n    # Initialize a memoization table to store results of subproblems.\n    # Keys are tuples (current_length, prev_element) and values are counts of sequences.\n    memo: dict[tuple[int, int], int] = {}\n\n    def _calculate_recursive(current_length: int, prev_element: int, m: int, n: int, memo: dict[tuple[int, int], int]) -> int:\n        \"\"\"\n        Recursively calculates the number of valid sequences that can be formed\n        starting from the current state (current_length, prev_element).\n        \"\"\"\n        # Base case 1: A sequence of the desired length 'n' has been successfully formed.\n        if current_length == n:\n            return 1\n\n        # Base case 2: If twice the previous element already exceeds 'm',\n        # no valid next element can be chosen, so no sequences can be formed from this point.\n        if 2 * prev_element > m:\n            memo[(current_length, prev_element)] = 0\n            return 0\n\n        # Check if the result for this subproblem has already been computed and stored in memo.\n        if (current_length, prev_element) in memo:\n            return memo[(current_length, prev_element)]\n\n        count = 0\n        # The next element must be at least twice the previous element.\n        start_next_element = 2 * prev_element\n\n        # Iterate through all possible values for the next element.\n        for next_element in range(start_next_element, m + 1):\n            # Recursively call to find the number of sequences from the next state.\n            count += _calculate_recursive(current_length + 1, next_element, m, n, memo)\n\n        # Store the computed result in the memoization table before returning.\n        memo[(current_length, prev_element)] = count\n        return count\n\n    total_sequences_count = 0\n    # For the first element of any sequence, it can be any positive integer from 1 to m.\n    for first_element in range(1, m + 1):\n        # Initiate the recursive calculation to find sequences starting with 'first_element'.\n        # The recursion starts seeking the second element (current_length = 2).\n        total_sequences_count += _calculate_recursive(2, first_element, m, n, memo)\n\n    return total_sequences_count"}
{"task_id": "Mbpp/235", "solution": "def even_bit_set_number(input_number: int) -> int:\n    \"\"\"\n    Sets all even-indexed bits (0, 2, 4, ...) of the input number to 1, changing 0s to 1s while leaving 1s as 1s.\n    It returns the integer with these bits set, strictly following the 'set bit' operation.\n    \"\"\"\n    dynamic_mask = 0\n    # Determine max bits for mask, covering input_number's length and a minimum of 64 bits.\n    # Adding +2 ensures the next even bit position after the input's highest bit is covered.\n    max_bits_to_check = max(64, input_number.bit_length() + 2)\n\n    for i in range(max_bits_to_check):\n        if i % 2 == 0:  # If it's an even-indexed bit position\n            dynamic_mask |= (1 << i) # Set that bit in the mask\n\n    return input_number | dynamic_mask"}
