{"task_id": "Mbpp/103", "solution": "def eulerian_num(n: int, m: int) -> int:\n    \"\"\"Calculates the Eulerian number a(n, m) using its combinatorial definition.\"\"\"\n\n    def _factorial(x: int) -> int:\n        \"\"\"Computes the factorial of a non-negative integer.\"\"\"\n        if x < 0:\n            return 0  # Should not happen with valid inputs for combinations\n        res = 1\n        for i in range(1, x + 1):\n            res *= i\n        return res\n\n    def _combinations(n_val: int, k_val: int) -> int:\n        \"\"\"Computes the binomial coefficient C(n_val, k_val).\"\"\"\n        if k_val < 0 or k_val > n_val:\n            return 0\n        if k_val == 0 or k_val == n_val:\n            return 1\n        if k_val > n_val // 2:\n            k_val = n_val - k_val\n        \n        # Calculate C(n_val, k_val) using iterative multiplication/division for efficiency\n        res = 1\n        for i in range(k_val):\n            res = res * (n_val - i) // (i + 1)\n        return res\n\n    # The Eulerian number A(n, m) is given by the formula:\n    # A(n, m) = sum_{k=0 to m} (-1)^k * C(n + 1, k) * (m - k + 1)^n\n    \n    result = 0\n    for k in range(m + 1):\n        term = ((-1)**k) * _combinations(n + 1, k) * ((m - k + 1)**n)\n        result += term\n    \n    return result"}
