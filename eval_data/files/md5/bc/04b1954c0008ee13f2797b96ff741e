{"task_id": "Mbpp/2", "solution": "from typing import Iterable, Any, Set\n\ndef similar_elements(list1: Iterable[Any], list2: Iterable[Any]) -> Set[Any]:\n    \"\"\"\n    Finds and returns elements that are present in both input iterables.\n    Converts inputs to sets for efficient intersection.\n    \"\"\"\n    set1 = set(list1)\n    set2 = set(list2)\n    return set1.intersection(set2)"}
{"task_id": "Mbpp/9", "solution": "def find_Rotations(input_string: str) -> int:\n    \"\"\"Calculates the minimum positive number of rotations for a string to return to its original state.\"\"\"\n    n = len(input_string)\n    if n == 0:\n        return 0  # Or handle as per specific requirements, but typically not expected for \"greater than 0\" rotations.\n\n    for rotations_count in range(1, n + 1):\n        rotated_string = input_string[rotations_count:] + input_string[:rotations_count]\n        if rotated_string == input_string:\n            return rotations_count\n    return n # Should not be reached if n > 0, as the string will always match itself after n rotations."}
{"task_id": "Mbpp/7", "solution": "import re\n\nclass Word:\n    \"\"\"Represents a single word with its string value and length.\"\"\"\n    def __init__(self, value: str):\n        self._value = value\n        self._length = len(value)\n\n    def get_value(self) -> str:\n        \"\"\"Returns the string value of the word.\"\"\"\n        return self._value\n\n    def get_length(self) -> int:\n        \"\"\"Returns the character length of the word.\"\"\"\n        return self._length\n\n    def __eq__(self, other: object) -> bool:\n        \"\"\"Compares Word objects based on their string value.\"\"\"\n        if not isinstance(other, Word):\n            return NotImplemented\n        return self._value == other._value\n\n    def __hash__(self) -> int:\n        \"\"\"Enables Word objects to be used in sets/dictionaries based on their string value.\"\"\"\n        return hash(self._value)\n\n    def __repr__(self) -> str:\n        \"\"\"Provides a string representation for debugging.\"\"\"\n        return f\"Word(value='{self._value}', length={self._length})\"\n\n\nclass CollectionOfWords:\n    \"\"\"Manages a unique collection of Word objects.\"\"\"\n    def __init__(self):\n        self._words: set[Word] = set()\n\n    def add_word(self, word: Word):\n        \"\"\"Adds a Word object to the collection.\"\"\"\n        self._words.add(word)\n\n    def get_words(self) -> set[str]:\n        \"\"\"Returns a set of string values from the contained Word objects.\"\"\"\n        return {word.get_value() for word in self._words}\n\n    def __len__(self) -> int:\n        \"\"\"Returns the number of words in the collection.\"\"\"\n        return len(self._words)\n\n    def __repr__(self) -> str:\n        \"\"\"Provides a string representation for debugging.\"\"\"\n        return f\"CollectionOfWords(count={len(self)}, words={{'{', '.join(sorted([w.get_value() for w in self._words]))}'}}})\"\n\n\ndef find_char_long(input_string: str) -> set[str]:\n    \"\"\"\n    Finds all words which are at least 4 characters long in a string.\n    Processes the input string to identify, filter, and return long words.\n    \"\"\"\n    word_strings = re.findall(r'\\S+', input_string)\n\n    long_words_collection = CollectionOfWords()\n\n    for word_str in word_strings:\n        word_obj = Word(word_str)\n\n        if word_obj.get_length() >= 4:\n            long_words_collection.add_word(word_obj)\n\n    return long_words_collection.get_words()"}
{"task_id": "Mbpp/4", "solution": "import heapq\n\ndef heap_queue_largest(numbers: list[int], n: int) -> list[int]:\n    \"\"\"\n    Finds the n largest integers from a given list of numbers, returned in descending order.\n    Leverages `heapq.nlargest` for efficient retrieval.\n    \"\"\"\n    if not numbers or n <= 0:\n        return []\n\n    return heapq.nlargest(n, numbers)"}
