{"task_id": "Mbpp/6", "solution": "def differ_At_One_Bit_Pos(num1: int, num2: int) -> bool:\n    \"\"\"\n    Checks if two numbers differ at exactly one bit position.\n    This is true if their XOR result is a power of two (and not zero).\n    \"\"\"\n    xor_result = num1 ^ num2\n    # A number has exactly one bit set if it's not zero AND (number & (number - 1)) is zero.\n    return xor_result != 0 and (xor_result & (xor_result - 1)) == 0"}
{"task_id": "Mbpp/11", "solution": "def remove_Occ(input_string: str, char_to_remove: str) -> str:\n    \"\"\"\n    Removes the first and last occurrences of a given character from a string.\n    Returns the original string if the character is not found, or removes only one instance if it appears once.\n    \"\"\"\n    if char_to_remove not in input_string:\n        return input_string\n\n    first_idx = input_string.find(char_to_remove)\n    last_idx = input_string.rfind(char_to_remove)\n\n    if first_idx == last_idx:\n        return input_string[:first_idx] + input_string[first_idx+1:]\n\n    temp_string = input_string[:first_idx] + input_string[first_idx+1:]\n    adjusted_last_idx = temp_string.rfind(char_to_remove)\n    \n    result_string = temp_string[:adjusted_last_idx] + temp_string[adjusted_last_idx+1:]\n\n    return result_string"}
{"task_id": "Mbpp/3", "solution": "import math\n\ndef is_not_prime(number: int) -> bool:\n    \"\"\"Checks if a number is not prime based on specific primality rules.\n    Returns True for composite numbers greater than 2, and False for primes, 0, 1, and negative numbers.\"\"\"\n    if number <= 1:\n        return False\n\n    if number == 2:\n        return False\n\n    # Iterate from 2 up to the square root of the number to find any divisors.\n    limit = math.isqrt(number)\n    for i in range(2, limit + 1):\n        if number % i == 0:\n            return True\n\n    return False"}
{"task_id": "Mbpp/14", "solution": "class TriangularPrism:\n    \"\"\"Represents a triangular prism with its dimensions.\"\"\"\n    def __init__(self, base: float, height: float, length: float):\n        self.base = base\n        self.height = height\n        self.length = length\n\n    def calculate_volume(self) -> float:\n        \"\"\"Calculates and returns the volume of the prism.\"\"\"\n        return 0.5 * self.base * self.height * self.length\n\ndef find_Volume(base: float, height: float, length: float) -> float:\n    \"\"\"\n    Calculates the volume of a triangular prism given its base, height, and length.\n    \"\"\"\n    prism = TriangularPrism(base, height, length)\n    return prism.calculate_volume()"}
