{"task_id": "Mbpp/453", "solution": "from typing import List\n\nclass Number:\n    \"\"\"Encapsulates a positive integer and operations to find its factors, filter even factors, and calculate their sum.\"\"\"\n\n    def __init__(self, value: int):\n        self._value = value\n        self._factors: List[int] = []\n        self._evenFactors: List[int] = []\n        self._sumOfEvenFactors: int = 0\n\n    def getFactors(self) -> List[int]:\n        \"\"\"Identifies all positive integer factors of the encapsulated value.\"\"\"\n        self._factors = []\n        for i in range(1, self._value + 1):\n            if self._value % i == 0:\n                self._factors.append(i)\n        return self._factors\n\n    def filterEvenFactors(self) -> List[int]:\n        \"\"\"Filters the identified factors to include only even numbers.\"\"\"\n        self._evenFactors = [factor for factor in self._factors if factor % 2 == 0]\n        return self._evenFactors\n\n    def calculateSum(self) -> int:\n        \"\"\"Calculates the sum of the filtered even factors.\"\"\"\n        self._sumOfEvenFactors = sum(self._evenFactors)\n        return self._sumOfEvenFactors\n\ndef sumofFactors(number: int) -> int:\n    \"\"\"Calculates the sum of even factors for a given positive integer.\"\"\"\n    num_obj = Number(number)\n    num_obj.getFactors()\n    num_obj.filterEvenFactors()\n    return num_obj.calculateSum()"}
