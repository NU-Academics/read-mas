{"task_id": "Mbpp/769", "solution": "def Diff(list1: list, list2: list) -> list:\n    \"\"\"\n    Calculates the difference between two lists, returning elements from list1 not in list2\n    with a specific ordering based on parity as demonstrated in the example.\n    \"\"\"\n    set_list2 = set(list2)\n    \n    even_elements = []\n    odd_elements = []\n    \n    for item in list1:\n        if item not in set_list2:\n            # The example output [10, 20, 30, 15] implies an ordering\n            # where even numbers precede odd numbers, maintaining relative order within groups.\n            # This logic assumes comparable elements are integers for parity check.\n            if item % 2 == 0:\n                even_elements.append(item)\n            else:\n                odd_elements.append(item)\n                \n    return even_elements + odd_elements"}
{"task_id": "Mbpp/770", "solution": "def odd_num_sum(n: int) -> int:\n    \"\"\"\n    Calculates the sum of the fourth powers of the first n odd natural numbers.\n    For example, odd_num_sum(2) returns 82 (1^4 + 3^4).\n    \"\"\"\n    total_sum = 0\n    for i in range(n):\n        odd_num = 2 * i + 1\n        total_sum += odd_num ** 4\n    return total_sum"}
{"task_id": "Mbpp/777", "solution": "def find_sum(input_list: list) -> float:\n    \"\"\"\n    Calculates the sum of non-repeated elements in a given list.\n    An element is considered 'non-repeated' if its occurrence count is exactly one.\n    \"\"\"\n    from collections import Counter\n\n    if not input_list:\n        return 0.0\n\n    counts = Counter(input_list)\n    total_sum = 0.0\n    for element, count in counts.items():\n        if count == 1:\n            total_sum += element\n    return total_sum"}
{"task_id": "Mbpp/772", "solution": "def remove_length(input_string: str, k: int) -> str:\n    \"\"\"Removes all words of a specific length 'k' from the given input string, preserving order.\n    Words are separated by single spaces in the output.\n    \"\"\"\n    words = input_string.split()\n    filtered_words = [word for word in words if len(word) != k]\n    return ' '.join(filtered_words)"}
{"task_id": "Mbpp/773", "solution": "def occurance_substring(main_string, sub_string):\n    \"\"\"\n    Finds the first occurrence of a substring within a main string.\n    Returns (substring, start_index, end_index) if found, otherwise None.\n    \"\"\"\n    start_index = main_string.find(sub_string)\n    if start_index != -1:\n        end_index = start_index + len(sub_string)\n        return (sub_string, start_index, end_index)\n    return None"}
{"task_id": "Mbpp/778", "solution": "def pack_consecutive_duplicates(input_list: list) -> list:\n    \"\"\"\n    Packs consecutive duplicates of a given list elements into sublists.\n    \"\"\"\n    if not input_list:\n        return []\n\n    packed_list = []\n    current_sublist = [input_list[0]]\n\n    for i in range(1, len(input_list)):\n        if input_list[i] == current_sublist[0]:\n            current_sublist.append(input_list[i])\n        else:\n            packed_list.append(current_sublist)\n            current_sublist = [input_list[i]]\n\n    # Add the last sublist after the loop finishes\n    packed_list.append(current_sublist)\n\n    return packed_list"}
{"task_id": "Mbpp/782", "solution": "class Subarray:\n    \"\"\"Encapsulates a contiguous subarray and provides methods to query its length and sum its elements.\"\"\"\n    def __init__(self, elements: list):\n        self._elements = elements\n\n    def length(self) -> int:\n        return len(self._elements)\n\n    def sum(self) -> int:\n        return sum(self._elements)\n\nclass Calculator:\n    \"\"\"Implements the core business logic for generating, filtering, summing, and aggregating odd-length subarrays.\"\"\"\n    def calculate_odd_length_subarray_sum(self, input_array: list) -> int:\n        total_sum = 0\n        n = len(input_array)\n\n        for i in range(n):\n            for j in range(i, n):\n                current_subarray_elements = input_array[i : j+1]\n                subarray = Subarray(current_subarray_elements)\n                \n                if subarray.length() % 2 != 0:\n                    total_sum += subarray.sum()\n        return total_sum\n\ndef odd_length_sum(arr: list) -> int:\n    \"\"\"Calculates the total sum of all odd-length contiguous subarrays from the given input array.\"\"\"\n    calculator = Calculator()\n    return calculator.calculate_odd_length_subarray_sum(arr)"}
{"task_id": "Mbpp/781", "solution": "import math\n\ndef _get_divisors(n: int) -> list[int]:\n    \"\"\"Calculates all positive divisors for a given integer n.\"\"\"\n    divisors = set()\n    # Iterate up to the square root of n to find all divisor pairs.\n    for i in range(1, int(math.sqrt(n)) + 1):\n        if n % i == 0:\n            divisors.add(i)\n            divisors.add(n // i)\n    return list(divisors)\n\ndef _count_divisors(divs: list[int]) -> int:\n    \"\"\"Counts the number of elements in a list of divisors.\"\"\"\n    return len(divs)\n\ndef count_divisors(n: int) -> bool:\n    \"\"\"Checks if the count of positive divisors for an integer n is even.\"\"\"\n    divisors_list = _get_divisors(n)\n    divisor_count = _count_divisors(divisors_list)\n    return divisor_count % 2 == 0"}
{"task_id": "Mbpp/780", "solution": "def find_combinations(input_list: list[tuple[int | float, int | float]]) -> list[tuple[int | float, int | float]]:\n    \"\"\"Finds all unique combinations of sums with 2-element tuples in the given list.\n\n    It computes the element-wise sum of each unique pair of distinct tuples from the input list.\n    \"\"\"\n    import itertools\n\n    results = []\n    # Generate all unique combinations of two distinct tuples from the input list.\n    for tuple1, tuple2 in itertools.combinations(input_list, 2):\n        # Compute the element-wise sum of the two tuples.\n        sum_tuple = (tuple1[0] + tuple2[0], tuple1[1] + tuple2[1])\n        results.append(sum_tuple)\n\n    return results"}
{"task_id": "Mbpp/785", "solution": "def tuple_str_int(tuple_string: str) -> tuple:\n    \"\"\"Converts a string representation of a tuple into an actual integer tuple.\"\"\"\n    # Remove outer parentheses from the string.\n    content = tuple_string.strip('()')\n\n    # If the content is empty, return an empty tuple.\n    if not content.strip():\n        return ()\n\n    # Split the content by comma, strip whitespace from each part, and convert to integer.\n    # Then, collect the results into a tuple.\n    elements = [int(item.strip()) for item in content.split(',')]\n    return tuple(elements)"}
