{"task_id": "Mbpp/305", "solution": "class Word:\n    \"\"\"Helper class to encapsulate word text and check if it starts with 'p'.\"\"\"\n    def __init__(self, text: str):\n        self._text = text\n\n    def starts_with_p(self) -> bool:\n        \"\"\"Returns True if the word starts with 'p' or 'P', False otherwise.\"\"\"\n        if not self._text:\n            return False\n        return self._text[0].lower() == 'p'\n\ndef start_withp(word_list: list[str]) -> tuple[str, str]:\n    \"\"\"\n    Processes a list of strings to find and return the first two words starting with 'p' or 'P'.\n    If fewer than two 'p' words are found, the tuple is padded with empty strings.\n    \"\"\"\n    found_p_words_texts = []\n    for input_string in word_list:\n        # Simple split, assumes words are space-separated.\n        # This will handle cases like \"Python PHP\" correctly.\n        raw_words = input_string.split()\n        for raw_word in raw_words:\n            word_obj = Word(raw_word)\n            if word_obj.starts_with_p():\n                found_p_words_texts.append(raw_word)\n                if len(found_p_words_texts) == 2:\n                    return tuple(found_p_words_texts) # Return immediately if two are found\n    \n    # Pad if fewer than two words were found\n    while len(found_p_words_texts) < 2:\n        found_p_words_texts.append('')\n        \n    return tuple(found_p_words_texts)"}
{"task_id": "Mbpp/306", "solution": "def max_sum_increasing_subseq(array: list[int], length: int, i_index: int, k_index: int) -> int:\n    \"\"\"\n    Finds the maximum sum of an increasing subsequence from the prefix of `array` up to `i_index` (inclusive),\n    which also includes the element at `k_index`.\n    \"\"\"\n    \n    # dp_sums[j] stores the maximum sum of an increasing subsequence ending at index j\n    # within the prefix 0...i_index.\n    dp_sums = [0] * (i_index + 1)\n\n    # Initialize dp_sums for the prefix 0 to i_index\n    for j in range(i_index + 1):\n        dp_sums[j] = array[j]\n\n    # Populate dp_sums using dynamic programming\n    # For each element current_idx in the prefix, find if it can extend a previous increasing subsequence\n    for current_idx in range(i_index + 1):\n        for prev_idx in range(current_idx):\n            if array[prev_idx] < array[current_idx]:\n                dp_sums[current_idx] = max(dp_sums[current_idx], dp_sums[prev_idx] + array[current_idx])\n\n    # Get the value of the k-th element which must be included\n    k_val = array[k_index]\n\n    # Find the maximum sum of an increasing subsequence from the prefix (0 to i_index)\n    # that is strictly less than k_val. This will be the prefix that precedes k_val.\n    max_prefix_sum = 0\n    for j in range(i_index + 1):\n        if array[j] < k_val:\n            max_prefix_sum = max(max_prefix_sum, dp_sums[j])\n\n    # The final maximum sum is the best prefix sum found plus the mandatory k_val\n    final_max_sum = max_prefix_sum + k_val\n\n    return final_max_sum"}
{"task_id": "Mbpp/308", "solution": "from typing import List, Union\n\nNumeric = Union[int, float]\n\ndef _validate_inputs(list1: List[Numeric], list2: List[Numeric], k: int) -> bool:\n    \"\"\"Validates the input lists and k to determine if a meaningful result can be produced.\n    Returns False if k is not positive or if any input list is empty.\n    \"\"\"\n    if k <= 0:\n        return False\n    if not list1 or not list2:\n        return False\n    return True\n\ndef _generate_all_products(list1: List[Numeric], list2: List[Numeric]) -> List[Numeric]:\n    \"\"\"Generates all possible products from two lists by pairing one factor from each.\"\"\"\n    products = []\n    for num1 in list1:\n        for num2 in list2:\n            products.append(num1 * num2)\n    return products\n\ndef _get_k_largest_and_sort(all_products: List[Numeric], k: int) -> List[Numeric]:\n    \"\"\"Identifies the k largest products from a list and sorts them in descending order.\"\"\"\n    if not all_products:\n        return []\n    all_products.sort(reverse=True)\n    return all_products[:k]\n\ndef large_product(list1: List[Numeric], list2: List[Numeric], k: int) -> List[Numeric]:\n    \"\"\"Finds the k largest products from two lists, selecting one factor from each list.\"\"\"\n    if not _validate_inputs(list1, list2, k):\n        return []\n\n    all_products = _generate_all_products(list1, list2)\n    return _get_k_largest_and_sort(all_products, k)"}
