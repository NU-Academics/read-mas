{"task_id": "Mbpp/61", "solution": "def count_Substrings(input_string: str) -> int:\n    \"\"\"\n    Counts the number of substrings in the input_string where the sum of their digits equals their length.\n    \"\"\"\n    total_count = 0\n    n = len(input_string)\n\n    for i in range(n):\n        current_sum_of_digits = 0\n        for j in range(i, n):\n            # Extract substring character by character to calculate sum and length\n            current_sum_of_digits += int(input_string[j])\n            current_length = j - i + 1\n\n            if current_sum_of_digits == current_length:\n                total_count += 1\n    return total_count"}
{"task_id": "Mbpp/58", "solution": "import enum\n\nclass Sign(enum.Enum):\n    \"\"\"Enumeration for the possible sign states of an integer.\"\"\"\n    POSITIVE = 1\n    NEGATIVE = -1\n    ZERO = 0\n\ndef _get_sign(number: int) -> Sign:\n    \"\"\"Determines the sign of a single integer.\"\"\"\n    if number > 0:\n        return Sign.POSITIVE\n    elif number < 0:\n        return Sign.NEGATIVE\n    else:\n        return Sign.ZERO\n\ndef opposite_Signs(int1: int, int2: int) -> bool:\n    \"\"\"\n    Checks whether two given integers have opposite signs.\n    It determines the sign of each integer and compares them based on specific rules.\n    \"\"\"\n    sign1 = _get_sign(int1)\n    sign2 = _get_sign(int2)\n\n    # Business Rule BR4: one positive and the other negative\n    if (sign1 == Sign.POSITIVE and sign2 == Sign.NEGATIVE) or \\\n       (sign1 == Sign.NEGATIVE and sign2 == Sign.POSITIVE):\n        return True\n    else:\n        return False"}
{"task_id": "Mbpp/63", "solution": "def max_difference(tuple_list: list[tuple[int | float, int | float]]) -> int | float:\n    \"\"\"\n    Calculates the maximum absolute difference between numerical pairs in a list of tuples.\n    It iterates through each tuple, computes the absolute difference, and keeps track of the maximum found.\n    \"\"\"\n    max_diff = 0.0\n\n    for val1, val2 in tuple_list:\n        current_diff = abs(val1 - val2)\n        max_diff = max(max_diff, current_diff)\n\n    return max_diff"}
