{"task_id": "Mbpp/20", "solution": "def is_woodall(number: int) -> bool:\n    \"\"\"\n    Checks if a given positive integer is a Woodall number.\n    A Woodall number is of the form n * 2^n - 1 for some positive integer n.\n    \"\"\"\n    n = 1\n    while True:\n        candidate_woodall_number = n * (2**n) - 1\n        if candidate_woodall_number == number:\n            return True\n        if candidate_woodall_number > number:\n            return False\n        n += 1"}
{"task_id": "Mbpp/12", "solution": "from typing import List\n\nclass Row:\n    \"\"\"Encapsulates a list of integers representing a matrix row and calculates its sum.\"\"\"\n    def __init__(self, elements: List[int]):\n        self._elements = elements\n\n    def get_sum(self) -> int:\n        \"\"\"Calculates and returns the sum of all elements in the row.\"\"\"\n        return sum(self._elements)\n\n    def get_elements(self) -> List[int]:\n        \"\"\"Returns the raw list of elements in the row.\"\"\"\n        return self._elements\n\nclass Matrix:\n    \"\"\"Manages a collection of Row objects and provides functionality to sort them based on their sums.\"\"\"\n    def __init__(self, data: List[List[int]]):\n        self._rows = [Row(row_data) for row_data in data]\n\n    def sort_rows_by_sum(self) -> List[List[int]]:\n        \"\"\"Sorts the internal Row objects by their sums in ascending order and returns the sorted matrix.\"\"\"\n        self._rows.sort(key=lambda row_obj: row_obj.get_sum())\n        return [row_obj.get_elements() for row_obj in self._rows]\n\ndef sort_matrix(matrix_data: List[List[int]]) -> List[List[int]]:\n    \"\"\"Sorts a given matrix in ascending order according to the sum of its rows.\"\"\"\n    matrix_obj = Matrix(matrix_data)\n    return matrix_obj.sort_rows_by_sum()"}
