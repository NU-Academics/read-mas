{"task_id": "Mbpp/75", "solution": "def find_tuples(list_of_tuples: list[tuple[int, ...]], k: int) -> list[tuple[int, ...]]:\n    \"\"\"\n    Filters a list of tuples, returning only those where all elements are divisible by k.\n    Assumes valid input types and handles k=0 as per design.\n    \"\"\"\n    if k == 0:\n        raise ZeroDivisionError(\"Divisor k cannot be zero.\")\n\n    result_tuples = []\n    for current_tuple in list_of_tuples:\n        is_tuple_divisible = True\n        for element in current_tuple:\n            if element % k != 0:\n                is_tuple_divisible = False\n                break\n        if is_tuple_divisible:\n            result_tuples.append(current_tuple)\n    return result_tuples"}
{"task_id": "Mbpp/74", "solution": "def is_samepatterns(string_list: list[str], pattern_list: list[str]) -> bool:\n    \"\"\"\n    Checks if a string_list follows the sequence given in a pattern_list based on\n    length, consistent one-to-one mapping, order, and repetition.\n    \"\"\"\n    if len(string_list) != len(pattern_list):\n        return False\n\n    string_to_pattern_map: dict[str, str] = {}\n    pattern_to_string_map: dict[str, str] = {}\n\n    for i in range(len(string_list)):\n        s = string_list[i]\n        p = pattern_list[i]\n\n        if s in string_to_pattern_map:\n            if string_to_pattern_map[s] != p:\n                return False\n        else:\n            if p in pattern_to_string_map:\n                if pattern_to_string_map[p] != s:\n                    return False\n            else:\n                string_to_pattern_map[s] = p\n                pattern_to_string_map[p] = s\n    return True"}
{"task_id": "Mbpp/77", "solution": "def is_Diff(number: int) -> bool:\n    \"\"\"Checks if a number is divisible by 11 using the alternating digit sum rule.\n    Returns True if the alternating sum of digits is divisible by 11, False otherwise.\n    \"\"\"\n    # Handle negative numbers by checking their absolute value, as divisibility applies to magnitude.\n    num_str = str(abs(number))\n    alternating_sum = 0\n    for i, digit_char in enumerate(reversed(num_str)):\n        digit = int(digit_char)\n        if i % 2 == 0:  # Rightmost digit is added, then every other digit\n            alternating_sum += digit\n        else:  # Second rightmost digit is subtracted, then every other digit\n            alternating_sum -= digit\n\n    return alternating_sum % 11 == 0"}
