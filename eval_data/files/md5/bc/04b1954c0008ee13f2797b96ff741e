{"task_id": "Mbpp/610", "solution": "def remove_kth_element(input_list: list, k: int) -> list:\n    \"\"\"\n    Returns a new list with the element at the k'th position (1-based index) removed.\n    The original input_list remains unchanged.\n    \"\"\"\n    # Create the first part of the new list, containing elements before the k'th position.\n    part1 = input_list[0 : k - 1]\n    # Create the second part of the new list, containing elements after the k'th position.\n    part2 = input_list[k : ]\n    \n    # Concatenate the two parts to form the new list without the k'th element.\n    return part1 + part2"}
{"task_id": "Mbpp/611", "solution": "def max_of_nth(matrix: list[list[int]], n: int) -> int:\n    \"\"\"\n    Finds the maximum value in the n'th column of a given matrix.\n    Raises ValueError for empty or malformed matrices, or if the specified column is empty.\n    \"\"\"\n    if not matrix:\n        raise ValueError(\"Matrix cannot be empty or malformed.\")\n\n    if n < 0:\n        raise IndexError(\"Column index out of bounds.\")\n\n    column_values = []\n    for row in matrix:\n        if n < len(row):\n            column_values.append(row[n])\n\n    if not column_values:\n        raise ValueError(\"Specified column is empty.\")\n\n    return max(column_values)"}
{"task_id": "Mbpp/614", "solution": "def cummulative_sum(tuple_list: list) -> (int | float):\n    \"\"\"\n    Calculates the cumulative sum of all numeric values within a list of tuples.\n\n    Args:\n        tuple_list: A list where each element is a tuple.\n\n    Returns:\n        The total sum of all numeric values encountered (int or float).\n    \"\"\"\n    total_sum = 0\n    for tpl in tuple_list:\n        for value in tpl:\n            if isinstance(value, (int, float)):\n                total_sum += value\n    return total_sum"}
{"task_id": "Mbpp/615", "solution": "def average_tuple(data: tuple[tuple[int | float, ...], ...]) -> list[float]:\n    \"\"\"\n    Calculates the average value for each inner tuple in a tuple of tuples.\n    Each inner tuple is assumed to contain numerical values and not be empty.\n    \"\"\"\n    results: list[float] = []\n    for inner_tuple in data:\n        current_sum = sum(inner_tuple)\n        current_count = len(inner_tuple)\n        average = current_sum / current_count\n        results.append(average)\n    return results"}
{"task_id": "Mbpp/616", "solution": "def tuple_modulo(tuple_a: tuple, tuple_b: tuple) -> tuple:\n    \"\"\"Performs element-wise modulo on two tuples of the same length, returning a new tuple.\"\"\"\n    if len(tuple_a) != len(tuple_b):\n        raise ValueError(\"Tuples must be of the same length\")\n\n    result = []\n    for i in range(len(tuple_a)):\n        result.append(tuple_a[i] % tuple_b[i])\n    return tuple(result)"}
{"task_id": "Mbpp/605", "solution": "def prime_num(n: int) -> bool:\n    \"\"\"Checks if an integer is a prime number. Returns True if prime, False otherwise.\"\"\"\n    import math\n\n    # Numbers less than or equal to 1 are not prime by definition.\n    if n <= 1:\n        return False\n\n    # Check for divisors from 2 up to the square root of n.\n    # If a number has a divisor greater than its square root, it must also have one smaller than its square root.\n    for i in range(2, int(math.sqrt(n)) + 1):\n        if n % i == 0:\n            return False\n\n    # If no divisors were found, the number is prime.\n    return True"}
