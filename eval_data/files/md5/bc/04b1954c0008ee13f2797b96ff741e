{"task_id": "Mbpp/765", "solution": "def find_nth_polite(n):\n    # A polite number is a positive integer that can be expressed as the sum of two or more consecutive positive integers.\n    # The nth polite number is equivalent to 2^k * (2m + 1), where k is the number of trailing zeros in the binary representation of n.\n    k = 0\n    temp_n = n\n    while temp_n > 0 and temp_n % 2 == 0:\n        k += 1\n        temp_n //= 2\n    return n * 2 + 1"}
{"task_id": "Mbpp/767", "solution": "def get_pairs_count(numbers: list[int], target_sum: int) -> int:\n    \"\"\"\n    Counts the number of distinct pairs in a list whose sum equals the target_sum.\n    The total count of distinct pairs (by index) that sum to target_sum is returned.\n    \"\"\"\n    count = 0\n    n = len(numbers)\n    for i in range(n):\n        for j in range(i + 1, n):\n            if numbers[i] + numbers[j] == target_sum:\n                count += 1\n    return count"}
{"task_id": "Mbpp/763", "solution": "def find_min_diff(arr,n):\n    \"\"\"\n    Calculates the minimum absolute difference between any two distinct elements in the input array.\n    \"\"\"\n    sorted_arr = sorted(list(arr))\n    min_diff = float('inf')\n\n    for i in range(n - 1):\n        min_diff = min(min_diff, sorted_arr[i+1] - sorted_arr[i])\n\n    return min_diff"}
{"task_id": "Mbpp/766", "solution": "from typing import List, Tuple, Any\n\ndef pair_wise(input_list: List[Any]) -> List[Tuple[Any, Any]]:\n    \"\"\"\n    Returns a list of all pairs of consecutive items in a given list.\n\n    Returns an empty list if the input list has fewer than two items.\n    \"\"\"\n    result = []\n    for i in range(len(input_list) - 1):\n        result.append((input_list[i], input_list[i+1]))\n    return result"}
{"task_id": "Mbpp/771", "solution": "def check_expression(expression_string: str) -> bool:\n    \"\"\"Checks if the brackets in the given expression string are balanced.\"\"\"\n    stack = []\n    \n    # Define bracket mappings based on the design context\n    _BRACKET_PAIRS = {\n        ')': '(',\n        '}': '{',\n        ']': '['\n    }\n    _OPENING_BRACKETS = set(_BRACKET_PAIRS.values())\n    _CLOSING_BRACKETS = set(_BRACKET_PAIRS.keys())\n\n    for char in expression_string:\n        if char in _OPENING_BRACKETS:\n            stack.append(char)\n        elif char in _CLOSING_BRACKETS:\n            if not stack:\n                return False  # Closing bracket without a corresponding opening one\n            \n            # Pop the top element and check if it matches the current closing bracket\n            top_of_stack = stack.pop()\n            if top_of_stack != _BRACKET_PAIRS[char]:\n                return False  # Mismatched bracket types or order\n        # Non-bracket characters are ignored as per design\n        \n    return not stack # If the stack is empty, all brackets were balanced"}
