{"task_id": "Mbpp/123", "solution": "def amicable_numbers_sum(N: int) -> int:\n    \"\"\"\n    Calculates the sum of all amicable numbers from 1 up to N.\n    It uses a helper function for proper divisor sums and a class for orchestration.\n    \"\"\"\n\n    if N < 220:\n        return 0\n\n    # Helper function definition (inline as per instructions)\n    def _calculate_proper_divisor_sum(num: int) -> int:\n        \"\"\"Calculates the sum of proper divisors for a given positive integer.\"\"\"\n        if num <= 1:\n            return 0\n        divisor_sum = 1\n        for i in range(2, int(num**0.5) + 1):\n            if num % i == 0:\n                divisor_sum += i\n                if i * i != num:\n                    divisor_sum += num // i\n        return divisor_sum\n\n    # Class definition (inline as per instructions)\n    class AmicableNumberCalculator:\n        \"\"\"Manages the process of finding and summing amicable numbers within a given limit.\"\"\"\n        def __init__(self, limit: int):\n            self._limit = limit\n            self._amicable_numbers_found: set[int] = set()\n\n        def findAmicableNumbers(self) -> set[int]:\n            \"\"\"Identifies all unique amicable numbers up to _limit.\"\"\"\n            for a in range(1, self._limit + 1):\n                if a in self._amicable_numbers_found:\n                    continue\n\n                sum_a = _calculate_proper_divisor_sum(a)\n\n                if sum_a <= 1 or sum_a == a:\n                    continue\n\n                sum_b = _calculate_proper_divisor_sum(sum_a)\n\n                if sum_b == a:\n                    if a <= self._limit:\n                        self._amicable_numbers_found.add(a)\n                    if sum_a <= self._limit:\n                        self._amicable_numbers_found.add(sum_a)\n            return self._amicable_numbers_found\n\n        def sumAmicableNumbers(self) -> int:\n            \"\"\"Calculates the sum of the unique amicable numbers found.\"\"\"\n            return sum(self._amicable_numbers_found)\n\n    calculator = AmicableNumberCalculator(N)\n    calculator.findAmicableNumbers()\n    return calculator.sumAmicableNumbers()"}
{"task_id": "Mbpp/125", "solution": "def find_length(binary_string: str) -> int:\n    \"\"\"\n    Finds the maximum difference between the number of 0s and number of 1s in any sub-string of the given binary string.\n    This function orchestrates input validation, conversion, and maximum difference calculation using Kadane's algorithm.\n    \"\"\"\n\n    def _validate_binary_string(s: str) -> bool:\n        \"\"\"Checks if the input string is non-empty and contains only '0's and '1's.\"\"\"\n        if not s:\n            return False\n        for char in s:\n            if char not in ('0', '1'):\n                return False\n        return True\n\n    def _convert_to_numeric_array(s: str) -> list[int]:\n        \"\"\"Converts a binary string into a list of integers (0->1, 1->-1).\"\"\"\n        numeric_array = []\n        for char in s:\n            if char == '0':\n                numeric_array.append(1)\n            else:  # char == '1'\n                numeric_array.append(-1)\n        return numeric_array\n\n    def _kadane_algorithm(arr: list[int]) -> int:\n        \"\"\"\n        Applies Kadane's algorithm to find the maximum subarray sum, returning 0 if all sums are negative.\n        This handles cases where choosing an empty substring (difference 0) is optimal.\n        \"\"\"\n        max_so_far = 0\n        current_max = 0\n        for x in arr:\n            current_max += x\n            if current_max < 0:\n                current_max = 0\n            max_so_far = max(max_so_far, current_max)\n        return max_so_far\n\n    if not _validate_binary_string(binary_string):\n        return 0\n\n    numeric_array = _convert_to_numeric_array(binary_string)\n    max_diff = _kadane_algorithm(numeric_array)\n\n    return max_diff"}
