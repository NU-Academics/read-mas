{"task_id": "Mbpp/137", "solution": "def zero_count(numbers: list[int]) -> float:\n    \"\"\"\n    Calculates the ratio of zero elements to non-zero elements in a list of integers.\n    Returns 0.0 if there are no non-zero elements to avoid division by zero.\n    \"\"\"\n    zero_count = 0\n    non_zero_count = 0\n\n    for number in numbers:\n        if number == 0:\n            zero_count += 1\n        else:\n            non_zero_count += 1\n\n    if non_zero_count == 0:\n        return 0.0\n    else:\n        return float(zero_count) / non_zero_count"}
{"task_id": "Mbpp/139", "solution": "import math\n\ndef circle_circumference(radius: float) -> float:\n    \"\"\"\n    Calculates the circumference of a circle given its radius.\n    Raises ValueError if the radius is negative.\n    \"\"\"\n    if radius < 0:\n        raise ValueError(\"Radius cannot be negative.\")\n    circumference = 2 * math.pi * radius\n    return circumference"}
{"task_id": "Mbpp/138", "solution": "def is_Sum_Of_Powers_Of_Two(number: int) -> bool:\n    \"\"\"\n    Checks if a number can be represented as a sum of non-zero powers of 2.\n    This implies the number must be positive, even, and have at least two '1' bits in its binary representation.\n    \"\"\"\n    if number <= 0:\n        return False\n\n    # A number composed of non-zero powers of 2 (i.e., 2^1, 2^2, ...) must be even.\n    # If the number is odd, it must include 2^0 = 1, which is not a non-zero power of 2.\n    if number % 2 != 0:\n        return False\n\n    # Convert to binary and count '1' bits.\n    # The '0b' prefix does not contain '1's, so we can directly count.\n    binary_representation = bin(number)\n    count_ones = binary_representation.count('1')\n\n    # For the number to be a \"sum\" of powers of 2, it must have at least two distinct powers.\n    return count_ones >= 2"}
{"task_id": "Mbpp/140", "solution": "def extract_singly(list_of_tuples: list[tuple[int, ...]]) -> set[int]:\n    \"\"\"\n    Flattens a list of tuples into a single set of unique numbers.\n    \"\"\"\n    result_set = set()\n    for tpl in list_of_tuples:\n        for num in tpl:\n            result_set.add(num)\n    return result_set"}
{"task_id": "Mbpp/141", "solution": "def pancake_sort(input_list: list) -> list:\n    \"\"\"Sorts a list of comparable elements in ascending order using the pancake sort algorithm.\n    Returns a new sorted list without modifying the original input.\n    \"\"\"\n    arr = list(input_list)\n    n = len(arr)\n\n    # This helper function reverses the sub-array from index 0 up to k (inclusive).\n    def _flip(sub_arr: list, k: int):\n        left = 0\n        while left < k:\n            sub_arr[left], sub_arr[k] = sub_arr[k], sub_arr[left]\n            left += 1\n            k -= 1\n\n    # Iterate from the last element down to the second, placing the largest unsorted element at its correct position.\n    for current_size in range(n, 1, -1):\n        # Find the index of the maximum element in the unsorted part (arr[0...current_size-1]).\n        max_idx = 0\n        for i in range(1, current_size):\n            if arr[i] > arr[max_idx]:\n                max_idx = i\n\n        # If the maximum element is not already at the end of the unsorted part, perform flips.\n        if max_idx != current_size - 1:\n            # First flip: Move the maximum element to the front of the array.\n            _flip(arr, max_idx)\n            # Second flip: Move the maximum element from the front to its correct sorted position.\n            _flip(arr, current_size - 1)\n    \n    return arr"}
{"task_id": "Mbpp/142", "solution": "def count_samepair(list1: list, list2: list, list3: list) -> int:\n    \"\"\"\n    Counts the number of positions where elements are identical in three given lists.\n    The comparison iterates up to the length of the shortest list.\n    \"\"\"\n    min_length = min(len(list1), len(list2), len(list3))\n    count = 0\n    for i in range(min_length):\n        if list1[i] == list2[i] == list3[i]:\n            count += 1\n    return count"}
{"task_id": "Mbpp/161", "solution": "def remove_elements(list1: list, list2: list) -> list:\n    \"\"\"Removes all elements from list1 that are present in list2.\n\n    Returns a new list containing elements from list1 not found in list2.\n    \"\"\"\n    elements_to_remove = set(list2)\n    result_list = []\n    for element in list1:\n        if element not in elements_to_remove:\n            result_list.append(element)\n    return result_list"}
{"task_id": "Mbpp/145", "solution": "def max_Abs_Diff(array: tuple) -> int:\n    \"\"\"\n    Calculates the maximum absolute difference between any two elements in a given array.\n    Returns 0 if the input array contains fewer than two elements.\n    \"\"\"\n    if len(array) < 2:\n        return 0\n\n    min_val = array[0]\n    max_val = array[0]\n\n    for element in array:\n        if element < min_val:\n            min_val = element\n        if element > max_val:\n            max_val = element\n\n    return max_val - min_val"}
{"task_id": "Mbpp/160", "solution": "def find_solution(a: int, b: int, n: int) -> tuple[int, int] | None:\n    \"\"\"\n    Returns integers x and y that satisfy ax + by = n as a tuple (x, y),\n    or returns None if no solution exists.\n    \"\"\"\n\n    # Helper function for Extended Euclidean Algorithm\n    # Computes g = gcd(a_val, b_val) and integers x, y such that a_val*x + b_val*y = g.\n    # Ensures g is always non-negative.\n    def _extended_gcd(a_val, b_val):\n        if b_val == 0:\n            return abs(a_val), (1 if a_val >= 0 else -1), 0\n        else:\n            g, x_prev, y_prev = _extended_gcd(b_val, a_val % b_val)\n            x = y_prev\n            y = x_prev - (a_val // b_val) * y_prev\n            return g, x, y\n\n    # Handle special case where both a and b are zero\n    if a == 0 and b == 0:\n        return (0, 0) if n == 0 else None\n\n    # Handle special case where a is zero (and b is non-zero)\n    if a == 0:\n        if n % b == 0:\n            return (0, n // b)\n        else:\n            return None\n\n    # Handle special case where b is zero (and a is non-zero)\n    if b == 0:\n        if n % a == 0:\n            return (n // a, 0)\n        else:\n            return None\n\n    # General case: a and b are both non-zero\n    g, x_particular, y_particular = _extended_gcd(a, b)\n\n    # If n is not divisible by g (gcd(a, b)), no integer solution exists\n    if n % g != 0:\n        return None\n\n    # Scale the particular solution (x_prime, y_prime) to solve ax + by = n\n    scale_factor = n // g\n    x_s = x_particular * scale_factor\n    y_s = y_particular * scale_factor\n\n    # Adjust to find a canonical solution (e.g., smallest non-negative x)\n    # The general solution is x = x_s + k * (b/g), y = y_s - k * (a/g)\n    # We find k to make x the smallest non-negative solution.\n    # The step for x is (b // g).\n    b_step = b // g\n    \n    # Calculate x in the range [0, abs(b_step) - 1]\n    # Python's % operator works for positive modulus: x_s % b_step\n    # if b_step could be negative, we use abs() to get the correct range size.\n    x_canonical = x_s % abs(b_step)\n\n    # Re-calculate y based on the canonical x\n    # ax + by = n  =>  by = n - ax  =>  y = (n - ax) / b\n    y_canonical = (n - a * x_canonical) // b\n\n    return (x_canonical, y_canonical)"}
{"task_id": "Mbpp/162", "solution": "def sum_series(n: int) -> int:\n    \"\"\"\n    Calculates the sum of the series (n - 2*i) for 'i' ranging from 0 to n // 2.\n    The loop goes from i=0 up to n // 2 (inclusive).\n    \"\"\"\n    current_sum = 0\n    for i in range(n // 2 + 1):\n        term = n - (2 * i)\n        current_sum += term\n    return current_sum"}
{"task_id": "Mbpp/165", "solution": "def count_char_position(input_string: str) -> int:\n    \"\"\"\n    Counts characters in a string where their 0-indexed position in the string\n    matches their 0-indexed position in the English alphabet (case-insensitive).\n    \"\"\"\n    count = 0\n    for index, char in enumerate(input_string):\n        lower_char = char.lower()\n        if 'a' <= lower_char <= 'z':\n            alphabet_position = ord(lower_char) - ord('a')\n            if index == alphabet_position:\n                count += 1\n    return count"}
{"task_id": "Mbpp/167", "solution": "def next_power_of_2(n: int) -> int:\n    \"\"\"\n    Calculates the smallest power of 2 that is greater than or equal to n.\n    Returns 1 if n is 0.\n    \"\"\"\n    if n == 0:\n        return 1\n\n    n -= 1\n    n |= n >> 1\n    n |= n >> 2\n    n |= n >> 4\n    n |= n >> 8\n    n |= n >> 16\n    return n + 1"}
{"task_id": "Mbpp/166", "solution": "def find_even_pair(integer_list: list[int]) -> int:\n    \"\"\"Counts pairs of integers in a list that XOR to an even number.\"\"\"\n    even_pair_count = 0\n    n = len(integer_list)\n\n    for i in range(n):\n        for j in range(i + 1, n):\n            num1 = integer_list[i]\n            num2 = integer_list[j]\n            xor_result = num1 ^ num2\n            # An XOR result is even if its least significant bit is 0.\n            # This is equivalent to checking if the number is divisible by 2.\n            if xor_result % 2 == 0:\n                even_pair_count += 1\n    return even_pair_count"}
