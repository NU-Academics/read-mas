{"task_id": "Mbpp/261", "solution": "def division_elements(tuple1: tuple, tuple2: tuple) -> tuple:\n    \"\"\"\n    Performs element-wise mathematical division on two input tuples.\n\n    Args:\n        tuple1: The first input tuple containing numbers.\n        tuple2: The second input tuple containing numbers (divisors).\n\n    Returns:\n        A new tuple containing the results of the element-wise division.\n\n    Raises:\n        ValueError: If the input tuples have different lengths.\n        ZeroDivisionError: If any element in tuple2 is zero.\n        TypeError: If non-numeric elements are encountered (implicitly by division operation).\n    \"\"\"\n    if len(tuple1) != len(tuple2):\n        raise ValueError(\"Input tuples must have the same length for element-wise division.\")\n\n    result = []\n    for i in range(len(tuple1)):\n        divisor = tuple2[i]\n        if divisor == 0:\n            raise ZeroDivisionError(f\"Division by zero encountered at index {i}.\")\n        result.append(tuple1[i] / divisor)\n\n    return tuple(result)"}
{"task_id": "Mbpp/260", "solution": "import math\n\ndef _is_prime(num: int) -> bool:\n    \"\"\"\n    Determines if a given integer is a prime number.\n    Checks for divisibility up to the square root of the number.\n    \"\"\"\n    if num < 2:\n        return False\n    if num == 2:\n        return True\n    if num % 2 == 0:\n        return False\n    for i in range(3, int(math.sqrt(num)) + 1, 2):\n        if num % i == 0:\n            return False\n    return True\n\ndef _generate_nsw_sequence_term(n: int) -> int:\n    \"\"\"\n    Calculates the nth Newman-Shanks-Williams (NSW) number.\n    Uses the recurrence relation: S_0 = 1, S_1 = 1, S_k = 2 * S_{k-1} + S_{k-2} for k >= 2.\n    \"\"\"\n    if n == 0:\n        return 1\n    if n == 1:\n        return 1\n    \n    s_k_minus_2 = 1  # Represents S_{k-2}\n    s_k_minus_1 = 1  # Represents S_{k-1}\n\n    for _ in range(2, n + 1):\n        s_k = 2 * s_k_minus_1 + s_k_minus_2\n        s_k_minus_2 = s_k_minus_1\n        s_k_minus_1 = s_k\n    \n    return s_k_minus_1\n\ndef newman_prime(n: int) -> int:\n    \"\"\"\n    Finds the nth Newman-Shanks-Williams (NSW) prime number.\n    It iterates through the NSW sequence, checks each term for primality, and counts the primes found.\n    \"\"\"\n    prime_count = 0\n    current_nsw_index = 0\n\n    while True:\n        nsw_number_value = _generate_nsw_sequence_term(current_nsw_index)\n        \n        if _is_prime(nsw_number_value):\n            prime_count += 1\n            if prime_count == n:\n                return nsw_number_value\n        \n        current_nsw_index += 1"}
