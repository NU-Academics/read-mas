{"task_id": "Mbpp/301", "solution": "```python\ndef dict_depth(dictionary: dict) -> int:\n    \"\"\"\n    Calculates the maximum nesting depth of a given dictionary.\n    The depth is 1 plus the maximum depth of any nested dictionary.\n    \"\"\"\n    max_nested_depth = 0\n    for value in dictionary.values():\n        if isinstance(value, dict):\n            max_nested_depth = max(max_nested_depth, dict_depth(value))\n\n    return 1 + max_nested_depth\n```"}
{"task_id": "Mbpp/299", "solution": "def max_aggregate(input_list: list[tuple[str, int]]) -> tuple[str, int]:\n    \"\"\"Calculates the maximum aggregate score from a list of (name, score) tuples.\n    Returns the name with the highest total score and their total score, or ('', 0) if the list is empty.\"\"\"\n    aggregated_scores = {}\n    for name, score in input_list:\n        aggregated_scores[name] = aggregated_scores.get(name, 0) + score\n\n    if not aggregated_scores:\n        return ('', 0)\n\n    winning_name = ''\n    max_aggregate_score = -1 \n\n    for name, total_score in aggregated_scores.items():\n        if total_score > max_aggregate_score:\n            max_aggregate_score = total_score\n            winning_name = name\n\n    return (winning_name, max_aggregate_score)"}
{"task_id": "Mbpp/297", "solution": "def flatten_list(input_list: list[Any]) -> list[Any]:\n    \"\"\"\n    Flattens a given nested list structure into a single-level list.\n    Returns a new list containing all elements from the input list and its\n    nested sub-lists, preserving their original order.\n    \"\"\"\n    flattened = []\n    for item in input_list:\n        if isinstance(item, list):\n            # Recursively flatten sub-lists and extend the result\n            flattened.extend(flatten_list(item))\n        else:\n            # Add primitive elements directly\n            flattened.append(item)\n    return flattened"}
