{"task_id": "Mbpp/131", "solution": "_VOWELS = {'a', 'e', 'i', 'o', 'u'}\n\ndef reverse_vowels(s: str) -> str:\n    \"\"\"Reverses only the vowels in the input string s (case-insensitive, 'y' is not a vowel).\"\"\"\n    char_list = list(s)\n    vowels_in_order = []\n    vowel_indices = []\n\n    for i, char in enumerate(char_list):\n        if char.lower() in _VOWELS:\n            vowels_in_order.append(char)\n            vowel_indices.append(i)\n\n    vowels_in_order.reverse()\n\n    for i, original_vowel_index in enumerate(vowel_indices):\n        char_list[original_vowel_index] = vowels_in_order[i]\n\n    return \"\".join(char_list)"}
