{"task_id": "Mbpp/793", "solution": "def last(array: list[int], element: int) -> int:\n    \"\"\"\n    Finds the last position (index) of an element in a sorted array.\n    Returns -1 if the element is not found.\n    \"\"\"\n    for i in range(len(array) - 1, -1, -1):\n        if array[i] == element:\n            return i\n    return -1"}
{"task_id": "Mbpp/796", "solution": "def return_sum(input_dict: dict) -> int | float:\n    \"\"\"\n    Calculates the sum of all numeric values in the given dictionary.\n    Non-numeric values are ignored.\n    \"\"\"\n    total_sum = 0\n    for value in input_dict.values():\n        if isinstance(value, (int, float)):\n            total_sum += value\n    return total_sum"}
{"task_id": "Mbpp/798", "solution": "def _sum(numbers: list):\n    \"\"\"Calculates the sum of all numeric elements in 'numbers'.\"\"\"\n    total = 0\n    for num in numbers:\n        total += num\n    return total"}
{"task_id": "Mbpp/797", "solution": "def sum_in_range(l,r):\n    \"\"\"\n    Calculates the sum of all odd natural numbers within the inclusive range [l, r].\n    Assumes valid integer inputs where l and r are positive, and l <= r.\n    \"\"\"\n    current_sum = 0\n    start = l\n    if start % 2 == 0:\n        start += 1\n\n    for num in range(start, r + 1, 2):\n        current_sum += num\n\n    return current_sum"}
{"task_id": "Mbpp/800", "solution": "def remove_all_spaces(input_string: str) -> str:\n    \"\"\"Removes all whitespace characters from the input string.\n\n    Args:\n        input_string: The string from which to remove whitespaces.\n\n    Returns:\n        A new string with all whitespace characters removed.\n    \"\"\"\n    return input_string.replace(\" \", \"\").replace(\"\\t\", \"\").replace(\"\\n\", \"\").replace(\"\\r\", \"\").replace(\"\\f\", \"\").replace(\"\\v\", \"\")"}
{"task_id": "Mbpp/804", "solution": "def is_product_even(numbers: list) -> bool:\n    \"\"\"\n    Checks if the product of numbers in a list is even.\n    The product is even if at least one number in the list is even.\n    \"\"\"\n    def _is_even(number: int) -> bool:\n        \"\"\"Helper to determine if a single integer is even.\"\"\"\n        return number % 2 == 0\n\n    if not numbers:\n        # The product of an empty set of numbers is 1 (multiplicative identity), which is odd.\n        return False\n\n    for num in numbers:\n        if _is_even(num):\n            return True  # If any number is even, the product will be even.\n\n    # If no even numbers were found, all numbers must be odd, so their product is odd.\n    return False"}
{"task_id": "Mbpp/799", "solution": "def left_rotate(value: int, d: int) -> int:\n    # Performs a 32-bit circular left bit rotation on the given value.\n    # The rotation count d is normalized, and bits wrapping around are handled.\n    BIT_LENGTH = 32\n    MASK = (1 << BIT_LENGTH) - 1\n\n    d_norm = d % BIT_LENGTH\n    \n    # Calculate the part that remains within the 32 bits after shifting.\n    left_shifted_part = (value << d_norm) & MASK\n    \n    # Calculate the part that wraps around from the most significant bits to the least significant.\n    wrapped_around_part = value >> (BIT_LENGTH - d_norm)\n    \n    return left_shifted_part | wrapped_around_part"}
{"task_id": "Mbpp/803", "solution": "def is_perfect_square(number: int) -> bool:\n    \"\"\"\n    Checks if the given number is a perfect square.\n    Negative numbers are not considered perfect squares; zero is.\n    \"\"\"\n    if number < 0:\n        return False\n    if number == 0:\n        return True\n\n    root = int(number**0.5)\n    return root * root == number"}
{"task_id": "Mbpp/809", "solution": "def check_smaller(tuple1: tuple, tuple2: tuple) -> bool:\n    \"\"\"\n    Checks if each element of the second tuple is strictly smaller than its corresponding element in the first tuple.\n    Returns False if tuples have different lengths or if any element in tuple2 is not strictly smaller.\n    \"\"\"\n    if len(tuple1) != len(tuple2):\n        return False\n\n    for i in range(len(tuple1)):\n        if tuple2[i] >= tuple1[i]:\n            return False\n\n    return True"}
{"task_id": "Mbpp/806", "solution": "def max_run_uppercase(input_string: str) -> int:\n    \"\"\"\n    Finds the maximum run of consecutive uppercase characters in the given string.\n    Tracks current and maximum run lengths during iteration.\n    \"\"\"\n    max_run_length = 0\n    current_run_length = 0\n\n    for char in input_string:\n        if char.isupper():\n            current_run_length += 1\n            max_run_length = max(max_run_length, current_run_length)\n        else:\n            current_run_length = 0\n            \n    return max_run_length"}
{"task_id": "Mbpp/805", "solution": "from typing import List, Union\n\ndef max_sum_list(input_list_of_lists: List[List[Union[int, float]]]) -> List[Union[int, float]]:\n    \"\"\"\n    Returns the list in a list of lists whose sum of elements is the highest.\n    If the input list is empty, an empty list is returned.\n    \"\"\"\n    if not input_list_of_lists:\n        return []\n\n    max_sum = -float('inf')\n    highest_sum_list = []\n\n    for inner_list in input_list_of_lists:\n        current_sum = 0\n        for element in inner_list:\n            current_sum += element\n\n        if current_sum > max_sum:\n            max_sum = current_sum\n            highest_sum_list = inner_list\n\n    return highest_sum_list"}
{"task_id": "Mbpp/807", "solution": "def first_odd(numbers: list[int]) -> int | None:\n    \"\"\"\n    Finds the first odd number in a given list of integers.\n    Returns the first odd integer found in the list, or None if the list is empty or contains no odd numbers.\n    \"\"\"\n    for number in numbers:\n        if number % 2 != 0:\n            return number\n    return None"}
{"task_id": "Mbpp/808", "solution": "def check_K(input_tuple: tuple, k: any) -> bool:\n    \"\"\"\n    Checks if a value 'k' is present within the given 'input_tuple'.\n    Returns True if 'k' is found in 'input_tuple', False otherwise.\n    \"\"\"\n    return k in input_tuple"}
{"task_id": "Mbpp/801", "solution": "def test_three_equal(a, b, c):\n    \"\"\"\n    Counts the number of equal numbers among three given integers.\n    Returns 3 if all are equal, 2 if exactly two are equal, and 0 otherwise.\n    \"\"\"\n    if a == b and b == c:\n        return 3\n    elif a == b or a == c or b == c:\n        return 2\n    else:\n        return 0"}
{"task_id": "Mbpp/733", "solution": "def find_first_occurrence(array, target):\n    \"\"\"\n    Finds the index of the first occurrence of a target number in a sorted array using binary search.\n    Returns -1 if the target is not found.\n    \"\"\"\n    low = 0\n    high = len(array) - 1\n    result = -1\n\n    while low <= high:\n        mid = low + (high - low) // 2\n        if array[mid] == target:\n            result = mid\n            high = mid - 1  # Try to find an earlier occurrence in the left half\n        elif array[mid] < target:\n            low = mid + 1\n        else:  # array[mid] > target\n            high = mid - 1\n    return result"}
